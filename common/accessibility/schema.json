{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clusterflick.com/schemas/venue-accessibility.json",
  "title": "Venue accessibility record",
  "description": "One venue's building and screen accessibility. Shape only: the rules about tiers, quotes and conflicts are checked by common/accessibility/validate.js.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "access_page_url",
    "access_contact",
    "coverage",
    "verified",
    "researched_on",
    "notes",
    "entrance_step_free",
    "alt_accessible_entrance",
    "lift",
    "accessible_toilet",
    "changing_places",
    "assistance_dogs",
    "quiet_space",
    "hearing_assist_counters",
    "screens"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "access_page_url": { "type": ["string", "null"], "format": "uri" },
    "access_contact": { "type": ["string", "null"], "minLength": 1 },
    "coverage": { "enum": ["not_started", "researched"] },
    "verified": { "type": "boolean" },
    "researched_on": { "type": ["string", "null"], "format": "date" },
    "notes": { "type": ["string", "null"], "minLength": 1 },
    "entrance_step_free": { "$ref": "#/definitions/field" },
    "alt_accessible_entrance": { "$ref": "#/definitions/field" },
    "lift": { "$ref": "#/definitions/field" },
    "accessible_toilet": { "$ref": "#/definitions/field" },
    "changing_places": { "$ref": "#/definitions/field" },
    "assistance_dogs": { "$ref": "#/definitions/field" },
    "quiet_space": { "$ref": "#/definitions/field" },
    "hearing_assist_counters": { "$ref": "#/definitions/field" },
    "screens": {
      "type": "array",
      "items": { "$ref": "#/definitions/screen" }
    }
  },
  "definitions": {
    "status": {
      "enum": ["yes", "no", "partial", "unknown", "not_applicable"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "tier", "source_last_updated", "checked_on", "quote"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "tier": { "enum": [1, 2] },
        "source_last_updated": { "type": ["string", "null"], "format": "date" },
        "checked_on": { "type": "string", "format": "date" },
        "quote": { "type": ["string", "null"], "minLength": 1 },
        "chain_wide": {
          "description": "The source states a policy for every venue in the chain rather than this venue. Allowed for venue fields, never for screen fields.",
          "type": "boolean"
        }
      }
    },
    "lastFound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "url", "tier", "found_on"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "tier": { "const": 3 },
        "found_on": { "type": "string", "format": "date" }
      }
    },
    "fieldProperties": {
      "status": { "$ref": "#/definitions/status" },
      "note": { "type": ["string", "null"], "minLength": 1 },
      "sources": {
        "type": "array",
        "items": { "$ref": "#/definitions/source" }
      },
      "conflict": { "type": ["string", "null"], "minLength": 1 },
      "last_found": {
        "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/lastFound" }]
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note", "sources", "conflict", "last_found"],
      "properties": {
        "status": { "$ref": "#/definitions/fieldProperties/status" },
        "note": { "$ref": "#/definitions/fieldProperties/note" },
        "sources": { "$ref": "#/definitions/fieldProperties/sources" },
        "conflict": { "$ref": "#/definitions/fieldProperties/conflict" },
        "last_found": { "$ref": "#/definitions/fieldProperties/last_found" }
      }
    },
    "countField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "note",
        "sources",
        "conflict",
        "last_found",
        "count"
      ],
      "properties": {
        "status": { "$ref": "#/definitions/fieldProperties/status" },
        "note": { "$ref": "#/definitions/fieldProperties/note" },
        "sources": { "$ref": "#/definitions/fieldProperties/sources" },
        "conflict": { "$ref": "#/definitions/fieldProperties/conflict" },
        "last_found": { "$ref": "#/definitions/fieldProperties/last_found" },
        "count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "positionField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "note",
        "sources",
        "conflict",
        "last_found",
        "value"
      ],
      "properties": {
        "status": { "$ref": "#/definitions/fieldProperties/status" },
        "note": { "$ref": "#/definitions/fieldProperties/note" },
        "sources": { "$ref": "#/definitions/fieldProperties/sources" },
        "conflict": { "$ref": "#/definitions/fieldProperties/conflict" },
        "last_found": { "$ref": "#/definitions/fieldProperties/last_found" },
        "value": { "enum": ["front", "middle", "rear", "mixed", "unknown"] }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "step_free",
        "wheelchair_spaces",
        "space_position",
        "transfer_seating",
        "hearing_assist",
        "notes"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "aliases": {
          "description": "Other names the venue's listings use for this screen, where getScreen doesn't already reduce both to the same value.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "step_free": { "$ref": "#/definitions/field" },
        "wheelchair_spaces": { "$ref": "#/definitions/countField" },
        "space_position": { "$ref": "#/definitions/positionField" },
        "transfer_seating": { "$ref": "#/definitions/field" },
        "hearing_assist": { "$ref": "#/definitions/field" },
        "notes": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
