\">\n                                                            <span class=\"hover\">Book</span>\n                                                            <span class=\"time\">12:00 pm</span>\n                                                        </a>                                                    <div class=\"movietag\"><span class=\"tag 4k\">4K</span><span class=\"tag sub\">SUB</span>                                                    </div>\n                                                </li><div class=\"heading\">Thursday 22nd October</div>                                                <li class=\"4k sub\">\n                                                    \n                                                                                                           <a href=\"https://princecharlescinema.com/prince-charles-cinema/booknow/31627618\" class=\"film_book_button\">\n                                                            <span class=\"hover\">Book</span>\n                                                            <span class=\"time\">3:30 pm</span>\n                                                        </a>                                                    <div class=\"movietag\"><span class=\"tag 4k\">4K</span><span class=\"tag sub\">SUB</span>                                                    </div>\n                                                </li><div class=\"heading\">Saturday 24th October</div>                                                <li class=\"4k sub\">\n                                                    \n                                                                                                           <a href=\"https://princecharlescinema.com/prince-charles-cinema/booknow/31627638\" class=\"film_book_button\">\n                                                            <span class=\"hover\">Book</span>\n                                                            <span class=\"time\">5:30 pm</span>\n