class=\"movietag\">                                                    </div>\n                                                </li><div class=\"heading\">Sunday 18th October</div>                                                <li class=\"\">\n                                                    \n                                                                                                           <a href=\"https://princecharlescinema.com/prince-charles-cinema/booknow/31627594\" class=\"film_book_button\">\n                                                            <span class=\"hover\">Book</span>\n                                                            <span class=\"time\">8:15 pm</span>\n                                                        </a>                                                    <div class=\"movietag\">                                                    </div>\n                                                </li><div class=\"heading\">Tuesday 20th October</div>                                                <li class=\"\">\n                                                    \n                                                                                                           <a href=\"https://princecharlescinema.com/prince-charles-cinema/booknow/31627605\" class=\"film_book_button\">\n                                                            <span class=\"hover\">Book</span>\n                                                            <span class=\"time\">3:30 pm</span>\n                                                        </a>                                                    <div class=\"movietag\">                                                    </div>\n                                                </li><div class=\"heading\">Sunday 25th October</div>                                                <li class=\"4k\">\n                                                    \n                                            