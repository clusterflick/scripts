            <a href=\"https://princecharlescinema.com/prince-charles-cinema/booknow/31626768\" class=\"film_book_button\">\n                                                            <span class=\"hover\">Book</span>\n                                                            <span class=\"time\">6:20 pm</span>\n                                                        </a>                                                    <div class=\"movietag\">                                                    </div>\n                                                </li><div class=\"heading\">Saturday 1st August</div>                                                <li class=\"\">\n                                                    \n                                                                                                           <a href=\"https://princecharlescinema.com/prince-charles-cinema/booknow/31626786\" class=\"film_book_button\">\n                                                            <span class=\"hover\">Book</span>\n                                                            <span class=\"time\">8:45 pm</span>\n                                                        </a>                                                    <div class=\"movietag\">                                                    </div>\n                                                </li><div class=\"heading\">Wednesday 5th August</div>                                                <li class=\"\">\n                                                    \n                                                                                                           <a href=\"https://princecharlescinema.com/prince-charles-cinema/booknow/31627225\" class=\"film_book_button\">\n                                                            <span class=\"hover\">Book</span>\n                                                            <span class=\"time\">3:40 pm</span>\n                             