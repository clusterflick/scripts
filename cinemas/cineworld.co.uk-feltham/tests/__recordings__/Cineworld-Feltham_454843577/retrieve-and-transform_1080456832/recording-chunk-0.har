          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014873\",\"name\":\"£2 Family Films : Charlie The Wonderdog\",\"originalName\":\"£2 Family Films : Charlie The Wonderdog\",\"length\":92,\"posterLink\":\"https://regalcdn.azureedge.net/CW/2FamilyFilmsCharlieTheWonderdog/HO00014873/TV_SmallPosterImage/20260630-112511566.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/2FamilyFilmsCharlieTheWonderdog/HO00014873/TV_LargePosterImage/20260630-112511566.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/2-family-films-charlie-the-wonderdog/ho00014873\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Owen Wilson, Tabitha St. Germain, Dawson Littman, Ruairi MacDonald, Zac Bennett-McPhee, Elishia Perosa\",\"directors\":\"Shea Wageman\",\"synopsis\":\"The all-new animated family adventure, Charlie the Wonderdog: features Owen Wilson (the voice of Lightning McQueen from CARS) as the voice of Charlie, a lovable dog with superpowers!\\n\\nWhen Danny’s loyal, four-legged best friend is mysteriously abducted by aliens, Charlie returns home with incredible new abilities and a mission to protect the people he loves. As his nemesis neighbourhood cat Puddy sets out to take over the world, it’s up to Charlie the Wonderdog to discover the true meaning of heroism and save the day!\\n\\nFunny, heartfelt, and packed with adventure, Charlie the Wonderdog is a story for everyone who has ever loved a dog — and for every dog who has ever loved them back.\",\"dateStarted\":\"2026-07-03T00:00:00\",\"eventCount\":24,\"categoriesAttributes\":[\"action\",\"animation\",\"movies-for-juniors\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"laser\",\"movies-for-juniors\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/PG.png\",\"ageRestrictionName\":\"pg\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/2FamilyFilmsCharlieTheWonderdog/HO00014873/TV_TopShelfPosterImage/20260630-112511566.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/2FamilyFilmsCharlieTheWonderdog/HO00014873/TV_SmallPosterImage/20260630-112511566.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/2FamilyFilmsCharlieTheWonderdog/HO00014873/Mobile_MovieThumbnail/20260630-112511566.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/2FamilyFilmsCharlieTheWonderdog/HO00014873/TV_LargePosterImage/20260630-112511566.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/2FamilyFilmsCharlieTheWonderdog/HO00014873/Mobile_MovieFeed/20260630-112539901.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"ALTITUDE FILM ENTERTAINMENT LTD\"}}}",
