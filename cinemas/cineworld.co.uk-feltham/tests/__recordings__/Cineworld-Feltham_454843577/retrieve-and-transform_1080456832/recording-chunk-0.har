          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014765\",\"name\":\"Evil Dead Burn\",\"originalName\":\"Evil Dead Burn\",\"length\":102,\"posterLink\":\"https://regalcdn.azureedge.net/CW/EvilDeadBurn/HO00014765/TV_SmallPosterImage/20260603-081818595.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/EvilDeadBurn/HO00014765/TV_LargePosterImage/20260603-081741363.jpg\",\"videoLink\":\"https://youtu.be/YYkUkyfjUKg\",\"link\":\"https://www.cineworld.co.uk/films/evil-dead-burn/ho00014765\",\"weight\":-16,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Tandi Wright, Souheila Yacoub, Luciane Buchanan, Hunter Doohan\",\"directors\":\"Sébastien Vaniček\",\"synopsis\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. After the loss of her husband, a woman seeks solace with her in-laws in their secluded family home. As one by one they are transformed into Deadites—turning the gathering into a family reunion from hell—she comes to discover that the vows she took in life... live on even in death.\",\"dateStarted\":\"2026-07-09T00:00:00\",\"eventCount\":2479,\"categoriesAttributes\":[\"horror\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"4dx\",\"audio-described\",\"laser\",\"recliner\",\"reserved-selected\",\"subbed\",\"superscreen\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/18.png\",\"ageRestrictionName\":\"18\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/EvilDeadBurn/HO00014765/TV_TopShelfPosterImage/20260603-081741363.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/EvilDeadBurn/HO00014765/TV_SmallPosterImage/20260603-081818595.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/EvilDeadBurn/HO00014765/Mobile_MovieThumbnail/20260603-081741363.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/EvilDeadBurn/HO00014765/TV_LargePosterImage/20260603-081741363.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/EvilDeadBurn/HO00014765/Mobile_MovieFeed/20260603-081847355.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"},{\"type\":\"Video\",\"subType\":\"Trailer_Youtube\",\"url\":\"https://youtu.be/YYkUkyfjUKg\",\"dimensionHeight\":null,\"dimensionWidth\":null}],\"specialMessage\":null,\"distributorName\":\"STUDIOCANAL\"}}}",
