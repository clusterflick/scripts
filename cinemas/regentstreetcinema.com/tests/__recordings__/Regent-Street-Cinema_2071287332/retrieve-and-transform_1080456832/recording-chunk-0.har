          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"data\":{\"movies\":{\"data\":[{\"id\":\"37212\",\"name\":\"Rosebush Pruning\",\"showingStatus\":\"Now Playing\",\"urlSlug\":\"rosebush-pruning\",\"posterImage\":\"7mrodw2ziqfvp0ikthlk0q85fzj2\",\"bannerImage\":\"ep7lxrtwfg5bb5frah4cufej4ilu\",\"synopsis\":\"Underneath the Catalonian sun, a rich white American family lives in hedonistic isolation, seeking love and validation through one another, their designer wardrobes and pop music. When an outsider infiltrates the family, buried tensions surface and blood ties are severed.\",\"starring\":\"Callum Turner, Riley Keough, Jamie Bell\",\"directedBy\":\"Karim Aïnouz\",\"producedBy\":\"Viola Fügen, Michael Weber, Simone Gattoni\",\"searchTerms\":\"\",\"duration\":95,\"genre\":\"Drama\",\"allGenres\":\"Drama, Thriller, Comedy\",\"rating\":\"18\",\"trailerYoutubeId\":\"rmHD9gZbF7A\",\"trailerVideo\":null,\"releaseDate\":\"2026-07-10\",\"dateOfFirstShowing\":\"2026-07-10\",\"tmdbPopularityScore\":5.0759,\"tmdbId\":\"1130948\",\"dcmEdiMovieId\":\"499395\",\"dcmEdiMovieName\":\"Rosebush Pruning [Unknown]\",\"siteId\":\"85\",\"titleClassId\":\"179\",\"showings\":[{\"id\":\"458825\",\"time\":\"2026-07-10T15:00:00Z\",\"ticketsSold\":4,\"screenId\":\"117\",\"seatsRemaining\":184,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"458826\",\"time\":\"2026-07-11T19:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"458827\",\"time\":\"2026-07-12T18:30:00Z\",\"ticketsSold\":3,\"screenId\":\"117\",\"seatsRemaining\":185,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"458828\",\"time\":\"2026-07-13T14:30:00Z\",\"ticketsSold\":2,\"screenId\":\"117\",\"seatsRemaining\":186,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"458829\",\"time\":\"2026-07-14T15:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"458831\",\"time\":\"2026-07-15T18:45:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating oc subtitled-wednesdays\\\"}\"},{\"id\":\"458830\",\"time\":\"2026-07-16T18:15:00Z\",\"ticketsSold\":2,\"screenId\":\"117\",\"seatsRemaining\":186,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"}]},{\"id\":\"36804\",\"name\":\"The Invite\",\"showingStatus\":\"Now Playing\",\"urlSlug\":\"the-invite\",\"posterImage\":\"wqyuqnj86ut2nc1c7joyz8cddi4w\",\"bannerImage\":\"wmfdmgqxgla1ot9jfefkvf40hdf5\",\"synopsis\":\"A couple invites the neighbours over for cocktails, igniting an evening full of unexpected twists and turns, revealing deeply repressed emotions and unexplored sexuality.\",\"starring\":\"Seth Rogen, Olivia Wilde, Penélope Cruz\",\"directedBy\":\"Olivia Wilde\",\"producedBy\":\"Megan Ellison, Ben Browning, David Permut\",\"searchTerms\":\"\",\"duration\":107,\"genre\":\"Drama\",\"allGenres\":\"Drama, Comedy\",\"rating\":\"15\",\"trailerYoutubeId\":\"7YIHRhRMn94\",\"trailerVideo\":null,\"releaseDate\":\"2026-07-03\",\"dateOfFirstShowing\":\"2026-07-03\",\"tmdbPopularityScore\":24.0815,\"tmdbId\":\"950028\",\"dcmEdiMovieId\":\"488731\",\"dcmEdiMovieName\":\"Invite, The [Unknown]\",\"siteId\":\"85\",\"titleClassId\":\"179\",\"showings\":[{\"id\":\"458815\",\"time\":\"2026-07-03T15:20:00Z\",\"ticketsSold\":7,\"screenId\":\"117\",\"seatsRemaining\":181,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"458809\",\"time\":\"2026-07-04T16:30:00Z\",\"ticketsSold\":15,\"screenId\":\"117\",\"seatsRemaining\":173,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"458810\",\"time\":\"2026-07-05T15:30:00Z\",\"ticketsSold\":46,\"screenId\":\"117\",\"seatsRemaining\":142,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"458811\",\"time\":\"2026-07-06T15:00:00Z\",\"ticketsSold\":13,\"screenId\":\"117\",\"seatsRemaining\":175,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"458812\",\"time\":\"2026-07-07T16:20:00Z\",\"ticketsSold\":19,\"screenId\":\"117\",\"seatsRemaining\":169,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"458813\",\"time\":\"2026-07-08T15:15:00Z\",\"ticketsSold\":10,\"screenId\":\"117\",\"seatsRemaining\":178,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating oc subtitled-wednesdays\\\"}\"},{\"id\":\"458834\",\"time\":\"2026-07-11T16:15:00Z\",\"ticketsSold\":12,\"screenId\":\"117\",\"seatsRemaining\":176,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"458835\",\"time\":\"2026-07-15T16:20:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating oc\\\"}\"}]},{\"id\":\"38571\",\"name\":\"A Mosquito in the Ear + Q\\u0026A\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"a-mosquito-in-the-ear-qa\",\"posterImage\":\"s1hcopdnorbo00gbl7b6qsvu3p3v\",\"bannerImage\":\"exya1lor2hytus4n4idvglhdwd9r\",\"synopsis\":\"\\u003cp style=\\\"margin-bottom:12.0pt;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 11pt; font-family: Arial, sans-serif;\\\"\\u003eUK Premiere\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\n\\n\\u003cp style=\\\"margin-bottom:12.0pt;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 11pt; font-family: Arial, sans-serif;\\\"\\u003eBased on Andrea Ferraris’ acclaimed\\ngraphic novel by the same title, itself inspired by a true story, this moving\\ndrama follows a couple who travel to India to bring home their newly adopted\\nfour-year-old daughter. Their hopes are complicated when the child refuses to\\nleave the familiarity of her orphanage and the people she knows. What begins as\\na journey of adoption gradually becomes a sensitive exploration of belonging,\\nidentity, and emotional connection across cultural divides. With empathy and\\nnuance, the film examines the challenges of forming a family and the fragile,\\noften uncertain process through which intimacy and trust are built.\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\n\\n\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 11pt; font-family: Arial, sans-serif;\\\"\\u003eBased on\\na true story, this poignant drama follows a couple’s adoption journey to India,\\nwhere a child’s reluctance to leave her orphanage transforms their homecoming\\ninto a profound exploration of identity, belonging, and family.\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 11pt; font-family: Arial, sans-serif;\\\"\\u003eEnglish, Hindi with English\\nsubtitles\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003c/div\\u003e\",\"starring\":\"Jake Lacy, Nazanin Boniadi, Ruhi Pal\",\"directedBy\":\"Nicola Rinciari\",\"producedBy\":\"Laurens C. Postma, Emily Dillard, Darren Dean, Frank Hall Green, Jomon Thomas, Stephen Stanley, Sunitha Ram\",\"searchTerms\":\"\",\"duration\":90,\"genre\":\"Drama\",\"allGenres\":\"Drama\",\"rating\":\"18\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-06-11\",\"dateOfFirstShowing\":\"2026-07-12\",\"tmdbPopularityScore\":1.2106,\"tmdbId\":\"1288220\",\"dcmEdiMovieId\":\"\",\"dcmEdiMovieName\":null,\"siteId\":\"85\",\"titleClassId\":\"169\",\"showings\":[{\"id\":\"447935\",\"time\":\"2026-07-12T15:00:00Z\",\"ticketsSold\":66,\"screenId\":\"117\",\"seatsRemaining\":122,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating london-indian-film-festival\\\"}\"}]},{\"id\":\"37282\",\"name\":\"The Fallen Idol\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-fallen-idol\",\"posterImage\":\"n56q5b0rfedkaco2jhthmfxrekwt\",\"bannerImage\":\"lrp6dz090hz45k2he3jexha88zwp\",\"synopsis\":\"Phillipe, the son of an ambassador in London, hero-worships his father's butler Baines. His perception of the man changes when he accidentally discovers the secret that Baines keeps and witnesses the consequences that adults' lies can cause.\",\"starring\":\"Ralph Richardson, Michèle Morgan, Sonia Dresdel\",\"directedBy\":\"Carol Reed\",\"producedBy\":\"Carol Reed\",\"searchTerms\":\"\",\"duration\":96,\"genre\":\"Drama\",\"allGenres\":\"Drama, Thriller\",\"rating\":\"PG\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"1948-09-30\",\"dateOfFirstShowing\":\"2026-07-13\",\"tmdbPopularityScore\":1.2575,\"tmdbId\":\"21631\",\"dcmEdiMovieId\":\"25180\",\"dcmEdiMovieName\":\"Fallen Idol (Re: 2006), The (2D) [PG]\",\"siteId\":\"85\",\"titleClassId\":\"224\",\"showings\":[{\"id\":\"458866\",\"time\":\"2026-07-13T12:00:00Z\",\"ticketsSold\":28,\"screenId\":\"117\",\"seatsRemaining\":160,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating monday-classic-matine\\\"}\"},{\"id\":\"432932\",\"time\":\"2026-09-21T12:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating monday-classic-matine\\\"}\"}]},{\"id\":\"38610\",\"name\":\"Satyajit Ray Short Film Competition Part 1\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"satyajit-ray-short-film-competition-part-1\",\"posterImage\":\"bibbowuqjl4akvwcz3dtbxfslill\",\"bannerImage\":\"zsitkyqq05cv8djtolbxc6ojsoz2\",\"synopsis\":\"\\u003cp class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt:auto;margin-bottom:12.0pt\\\"\\u003e\\u003cspan style=\\\"font-size:11.0pt;font-family:\\u0026quot;Arial\\u0026quot;,sans-serif;color:#414042\\\"\\u003eThe\\nfestival’s internationally-renowned competition selects emerging filmmakers’\\nworks from South Asia and around the world. All the selected films are, in\\ndifferent ways, felt to enshrine the legendary director Satyajit Ray’s humanist\\nvision and subtlety of story and eye.\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 11pt; font-family: Arial, sans-serif;\\\"\\u003eMultiple languages with English\\nsubtitles.\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 11pt; font-family: Arial, sans-serif;\\\"\\u003e\\u003cbr\\u003e\\u003c/span\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cb\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003eMoti\\u003c/span\\u003e\\u003c/b\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003eDir: Yash Saraf | 16 mins | Bengali\\nwith English subtitles\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003eAt the start of the pandemic, a\\nfamily in Kolkata discovers that their pet dog Moti has turned into a boy –\\nleading to a journey of ridiculous science and absurd evolution, all in search\\nof a new normal.\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003co:p\\u003e\\u0026nbsp;\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cb\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003eAbracadabra\\u003cspan class=\\\"gmail-apple-tab-span\\\"\\u003e \\u003c/span\\u003e\\u003c/span\\u003e\\u003c/b\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003eDir: Amay Mehrishi | 20 mins |\\nHindi, English with English subtitles\\u0026nbsp;\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003eOn a school bus ride that feels\\nboth endless and fleeting, 12-year old Agastya wrestles with identity, guilt,\\nand unspoken emotions when his best friend chooses to sit elsewhere.\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003co:p\\u003e\\u0026nbsp;\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cb\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003e11:11\\u003c/span\\u003e\\u003c/b\\u003e\\u003cspan class=\\\"gmail-apple-tab-span\\\"\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003e \\u003c/span\\u003e\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003eDir: Mahnoor Eupoch | 15 mins |\\nEnglish\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003eWhen 16-year-old Pakistani-American\\nNoori’s wish at 11:11 to be her crush’s type goes awry, she’s magically\\ntransformed into a white, blonde, blue-eyed girl — and she must undo the wish\\nbefore losing herself completely.\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003co:p\\u003e\\u0026nbsp;\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cb\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003ePermanent Guest\\u003c/span\\u003e\\u003c/b\\u003e\\u003cspan class=\\\"gmail-apple-tab-span\\\"\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003e \\u003c/span\\u003e\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003eDir: Sana Jafari | 15 mins | Urdu\\nwith English subtitles\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003eA young woman’s world is rattled by\\nthe arrival of a relative who forces her to weigh family obligations against\\ngrowing discomfort.\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003co:p\\u003e\\u0026nbsp;\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cb\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003eBarber of the Gods\\u003c/span\\u003e\\u003c/b\\u003e\\u003cspan class=\\\"gmail-apple-tab-span\\\"\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003e \\u003c/span\\u003e\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003eDir: Sushant Nagpal | 20 mins |\\nHindi with English subtitles\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003eIn an unnamed town in 2000s India,\\na barber and his son possess a strange gift – they can regrow people’s hair in\\nexchange for years from their lives. In a parallel realm rooted in Hindu\\ncosmology, a divine barber and his curious apprentice tend to the gods\\nthemselves.\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003co:p\\u003e\\u0026nbsp;\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cb\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003eKuchar (The Itch)\\u003c/span\\u003e\\u003c/b\\u003e\\u003cspan class=\\\"gmail-apple-tab-span\\\"\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003e \\u003c/span\\u003e\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003eDir: Vaidaangi Sharma | 20 mins |\\nHindi with English subtitles\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\u003c/p\\u003e\\u003cp style=\\\"margin:0cm;text-align:justify\\\"\\u003e\\u003cspan style=\\\"font-size: 10pt; font-family: Arial, sans-serif;\\\"\\u003eAfter the whirl of a washing\\nmachine unexpectedly introduces her to new sensations, teenage Chanda struggles\\nto conceal her new discovery within the household. Meanwhile, her strict and\\ncomposed mother is keeping secrets of her own.\\u003c/span\\u003e\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\",\"starring\":null,\"directedBy\":\"Various\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":90,\"genre\":null,\"allGenres\":null,\"rating\":\"18\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-07-13\",\"dateOfFirstShowing\":\"2026-07-13\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":null,\"dcmEdiMovieName\":\"No Match Found\",\"siteId\":\"85\",\"titleClassId\":\"169\",\"showings\":[{\"id\":\"448059\",\"time\":\"2026-07-13T17:30:00Z\",\"ticketsSold\":49,\"screenId\":\"117\",\"seatsRemaining\":139,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating event-cinema\\\"}\"}]},{\"id\":\"36323\",\"name\":\"The Epic of Everest with an Introduction, Prologue, and a mark of respect by the Monks\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-epic-of-everest-with-an-introduction-prologue-and-a-mark-of-respect-by-the-monks\",\"posterImage\":\"uo9eqy8k36spxjneod1b5h3p65ib\",\"bannerImage\":\"te92p1hljkcryq1575nztu4yeezc\",\"synopsis\":\"\\u003cspan id=\\\"docs-internal-guid-cf1ba3b1-7fff-61b5-5d1f-de724d8e3f5b\\\"\\u003e\\u003cp dir=\\\"ltr\\\" style=\\\"line-height:1.38;margin-top:0pt;margin-bottom:0pt;\\\"\\u003e\\u003cspan style=\\\"font-size:11pt;font-family:Arial,sans-serif;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;\\\"\\u003ePreceding the film will be a recreation of the original introduction. It will consist of a series of Tibetan chants and music performed by the monks of the Tashi Lhunpo Monastery.\\u0026nbsp;\\u003c/span\\u003e\\u003c/p\\u003e\\u003cp dir=\\\"ltr\\\" style=\\\"line-height:1.38;margin-top:0pt;margin-bottom:0pt;\\\"\\u003e\\u003cspan style=\\\"font-size:11pt;font-family:Arial,sans-serif;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;\\\"\\u003e\\u003cbr\\u003e\\u003c/span\\u003e\\u003c/p\\u003e\\u003cp dir=\\\"ltr\\\" style=\\\"line-height:1.38;margin-top:0pt;margin-bottom:0pt;\\\"\\u003e\\u003cspan style=\\\"font-size:11pt;font-family:Arial,sans-serif;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;\\\"\\u003eThe Epic of Everest (1924) is a documentary film by Captain John Noel chronicling the third British expedition to Mount Everest. It captures the expedition's journey through Tibet, the team's gruelling ascent, and the final, tragic loss of the pair near the summit\\u003c/span\\u003e\\u003c/p\\u003e\\u003cp dir=\\\"ltr\\\" style=\\\"line-height:1.38;margin-top:0pt;margin-bottom:0pt;\\\"\\u003e\\u003cspan id=\\\"docs-internal-guid-fbd3aa40-7fff-54d4-d4a2-e3b59c6ea899\\\"\\u003e\\u003cbr\\u003e\\u003c/span\\u003e\\u003c/p\\u003e\\u003cp dir=\\\"ltr\\\" style=\\\"line-height:1.38;margin-top:0pt;margin-bottom:0pt;\\\"\\u003e\\u003cbr\\u003e\\u003c/p\\u003e\\u003c/span\\u003e\",\"starring\":\"Andrew Irvine, George Mallory\",\"directedBy\":\"J.B.L. Noel\",\"producedBy\":\"\",\"searchTerms\":\"\",\"duration\":87,\"genre\":\"Documentary\",\"allGenres\":\"Documentary\",\"rating\":\"U\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"1924-12-01\",\"dateOfFirstShowing\":\"2026-07-14\",\"tmdbPopularityScore\":0.1449,\"tmdbId\":\"217268\",\"dcmEdiMovieId\":\"480990\",\"dcmEdiMovieName\":\"Baahubali: The Epic [15]\",\"siteId\":\"85\",\"titleClassId\":\"169\",\"showings\":[{\"id\":\"428757\",\"time\":\"2026-07-14T18:00:00Z\",\"ticketsSold\":18,\"screenId\":\"117\",\"seatsRemaining\":170,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"}]},{\"id\":\"33278\",\"name\":\"The Odyssey\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-odyssey\",\"posterImage\":\"h905ddoz5u4het8qovdl98wci2nj\",\"bannerImage\":\"4u7i64jcgnxby6inwml55s44s22o\",\"synopsis\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. The film brings 