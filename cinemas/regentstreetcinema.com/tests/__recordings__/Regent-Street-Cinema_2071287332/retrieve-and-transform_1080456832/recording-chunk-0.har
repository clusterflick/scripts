Id\":\"224\",\"showings\":[{\"id\":\"458893\",\"time\":\"2026-07-20T12:00:00Z\",\"ticketsSold\":20,\"screenId\":\"117\",\"seatsRemaining\":168,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating monday-classic-matine\\\"}\"},{\"id\":\"432933\",\"time\":\"2026-09-28T12:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating monday-classic-matine\\\"}\"}]},{\"id\":\"37286\",\"name\":\"Room At the Top\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"room-at-the-top\",\"posterImage\":\"ujp04056usa4hwj0mi5awrxbs0sa\",\"bannerImage\":\"1kvuon3c3fh349mctijc8erm6tm1\",\"synopsis\":\"An ambitious young accountant schemes to wed a wealthy factory owner's daughter, despite falling in love with a married older woman.\",\"starring\":\"Laurence Harvey, Simone Signoret, Heather Sears\",\"directedBy\":\"Jack Clayton\",\"producedBy\":\"John Woolf, James Woolf\",\"searchTerms\":\"\",\"duration\":117,\"genre\":\"Drama\",\"allGenres\":\"Drama, Romance\",\"rating\":\"12A\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"1958-12-29\",\"dateOfFirstShowing\":\"2026-07-27\",\"tmdbPopularityScore\":2.0526,\"tmdbId\":\"43103\",\"dcmEdiMovieId\":\"\",\"dcmEdiMovieName\":null,\"siteId\":\"85\",\"titleClassId\":\"224\",\"showings\":[{\"id\":\"459674\",\"time\":\"2026-07-27T12:00:00Z\",\"ticketsSold\":14,\"screenId\":\"117\",\"seatsRemaining\":174,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"}]},{\"id\":\"38343\",\"name\":\"Up In Smoke + Q\\u0026A with Michael Hands, Adam Wakeling and Friends\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"up-in-smoke-qa-with-michael-hands-and-adam-wakeling\",\"posterImage\":\"m2znmkhizr3zxw8hl2crp6lcklc4\",\"bannerImage\":\"0iolgffl1ajhr3xnbdkg8w5xx1qj\",\"synopsis\":\"\\u003cp data-start=\\\"0\\\" data-end=\\\"224\\\"\\u003eSlash and burn farming generates more carbon annually than all air travel put together. It sits at the crossroads of two of the greatest threats to global stability: accelerating climate change and diminishing food security.\\u003c/p\\u003e\\n\\u003cp data-start=\\\"226\\\" data-end=\\\"389\\\"\\u003eUp In Smoke follows British scientist Mike Hands, who has laboured for 25 years to find a solution to replacing slash \\u0026amp; burn agriculture in equatorial rainforests.\\u003c/p\\u003e\\n\\u003cp data-start=\\\"391\\\" data-end=\\\"409\\\"\\u003eAnd he's found it.\\u003c/p\\u003e\\n\\u003cp data-start=\\\"411\\\" data-end=\\\"815\\\"\\u003eFilmed over 4 years in Honduras and the UK, the this fascinating film presents a historic opportunity to address one of the most urgent issues of the present day. It parallels the farmer's struggles with Mike Hands attempts to get heavyweight political backing, as he tries to get the Inga Tree and alley-cropping technique onto the agenda at the 2009 Copenhagen Summit. But is the world ready to listen?\\u003c/p\\u003e\\n\\u003cp data-start=\\\"817\\\" data-end=\\\"950\\\" data-is-last-node=\\\"\\\" data-is-only-node=\\\"\\\"\\u003eThe screening will be preceded by three student films: Artificial Ignorance, Fairytales of the Future, and Engineers of the Wildwood.\\u003c/p\\u003e\\u003cp data-start=\\\"817\\\" data-end=\\\"950\\\" data-is-last-node=\\\"\\\" data-is-only-node=\\\"\\\"\\u003eThis event is organised in collaboration with the University of Westminster Sustainability Team.\\u003c/p\\u003e\",\"starring\":\"Mike Hands\",\"directedBy\":\"Adam Wakeling\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":70,\"genre\":null,\"allGenres\":null,\"rating\":\"18\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-07-29\",\"dateOfFirstShowing\":\"2026-07-29\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"19871\",\"dcmEdiMovieName\":\"Adventures Of Arsene Lupin, The (2D) [15]\",\"siteId\":\"85\",\"titleClassId\":\"169\",\"showings\":[{\"id\":\"446183\",\"time\":\"2026-07-29T12:40:00Z\",\"ticketsSold\":24,\"screenId\":\"117\",\"seatsRemaining\":164,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating event-cinema bringing-the-rainforest-home---a-day-of-film-and-discussion-about-restoring-nature-both-at-home-and-abroad\\\"}\"}]},{\"id\":\"38395\",\"name\":\"No Trees No Seas + Q\\u0026A with Carl Rowlinson\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"no-trees-no-sees-qa-with-carl-rowlinson\",\"posterImage\":\"i0p70zgks62a0bqh784k32wjpu59\",\"bannerImage\":\"d5hgouxx2rv2p22709jm0bbh01x9\",\"synopsis\":\"\\u003cp class=\\\"MsoNormal\\\"\\u003eA surfer's search for what is killing our seas leads him\\ndeep into the forest – and to an ancient truth: that the key to healing our\\nseas lies on the land.\\u003cbr\\u003e\\n\\u003cbr\\u003e\\nNo Trees No Seas is a feature-length documentary revealing the hidden\\nconnections between trees and seas, and how bringing back our woodlands could\\nbe one of the most powerful things we can do to restore nature, both on land\\nand at sea. \\u003cbr\\u003e\\n\\u003cbr\\u003e\\nPresented by surfer and environmentalist Sam Bleakley, and directed by Lightbox\\nFilm Co. the film is part of the No Trees No Seas campaign. Driven by Plant One\\nCIC, the campaign aims to create 500 hectares of ‘fish forests’ across Cornwall\\n– species-rich, biodiverse woodlands that will feed and protect our oceans for\\ngenerations to come.\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/p\\u003e\\u003cp class=\\\"MsoNormal\\\"\\u003eThe screening will be preceded by three student films: Save our Seas, Monster , You Told Us To Talk About The\\nWeather\\u003c/p\\u003e\\u003cp class=\\\"isSelectedEnd\\\"\\u003eFollowing the screening, audiences will have the opportunity to hear from a distinguished panel of experts and advocates whose work spans marine conservation, forestry, ecology, and the arts:\\u003c/p\\u003e\\u003cp\\u003e• Dr Ian Hendy – Senior Lecturer at the University of Portsmouth and expert in coastal habitats\\u003cbr\\u003e• Georgina Miller – Six-time National Freediving Champion\\u003cbr\\u003e• Carl Rowlinson – Woodland creator, co-founder of Plant One, and founder of the No Trees No Seas campaign\\u003cbr\\u003e• Sam Manning – Forest Ecologist at The Woodland Trust\\u003cbr\\u003e• Matthew Shaw – Composer, musician, artist, and founder of Stone Club\\u003c/p\\u003e\\u003cp class=\\\"MsoNormal\\\"\\u003eThis event is organised in collaboration with the University of Westminster Sustainability Team.\\u003c/p\\u003e\",\"starring\":\"Sam Bleakley, Sam Manning, Carl Rowlinson, Lissa Batey, Ian Hendy, Chris Hines, Sue Hill\",\"directedBy\":\"James Stuart\",\"producedBy\":\"Carl Rowlinson\",\"searchTerms\":\"\",\"duration\":60,\"genre\":null,\"allGenres\":null,\"rating\":\"18\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-07-29\",\"dateOfFirstShowing\":\"2026-07-29\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"463547\",\"dcmEdiMovieName\":\"#RUNSEOKJIN_EP.TOUR IN AMSTERDAM: LIVE VIEWING (CONCERT) [Unknown]\",\"siteId\":\"85\",\"titleClassId\":\"169\",\"showings\":[{\"id\":\"446184\",\"time\":\"2026-07-29T17:45:00Z\",\"ticketsSold\":150,\"screenId\":\"117\",\"seatsRemaining\":38,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating event-cinema bringing-the-rainforest-home---a-day-of-film-and-discussion-about-restoring-nature-both-at-home-and-abroad\\\"}\"}]}]}}}",
