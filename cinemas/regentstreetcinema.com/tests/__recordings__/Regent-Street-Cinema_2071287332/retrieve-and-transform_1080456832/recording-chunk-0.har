            "text": "{\"data\":{\"movies\":{\"data\":[{\"id\":\"33278\",\"name\":\"The Odyssey\",\"showingStatus\":\"Now Playing\",\"urlSlug\":\"the-odyssey\",\"posterImage\":\"h905ddoz5u4het8qovdl98wci2nj\",\"bannerImage\":\"4u7i64jcgnxby6inwml55s44s22o\",\"synopsis\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world. After the Trojan War, Odysseus faces a dangerous voyage back\\nto Ithaca, meeting creatures like the Cyclops Polyphemus, Sirens, and Calypso\\nalong the way.\",\"starring\":\"Matt Damon, Tom Holland, Anne Hathaway\",\"directedBy\":\"Christopher Nolan\",\"producedBy\":\"Christopher Nolan, Emma Thomas\",\"searchTerms\":\"\",\"duration\":173,\"genre\":\"Adventure\",\"allGenres\":\"Adventure, Drama, Fantasy\",\"rating\":\"15\",\"trailerYoutubeId\":\"Sk6LZrA2JSQ\",\"trailerVideo\":null,\"releaseDate\":\"2026-07-17\",\"dateOfFirstShowing\":\"2026-07-17\",\"tmdbPopularityScore\":801.957,\"tmdbId\":\"1368337\",\"dcmEdiMovieId\":\"412037\",\"dcmEdiMovieName\":\"ODYSSEY, THE [Unknown]\",\"siteId\":\"85\",\"titleClassId\":\"180\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99100599992,\\\"daysShown\\\":8,\\\"nowPlayingOrHasPlayed\\\":true,\\\"someShowingsBadges\\\":[\\\"Reserved Seating\\\",\\\"OC\\\",\\\"Subtitled Wednesdays\\\"],\\\"everyShowingsBadges\\\":[\\\"Reserved Seating\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-film some-showings-reserved-seating some-showings-oc some-showings-subtitled-wednesdays every-showings-reserved-seating showing-status-now-playing showing-status-now-playing-or-has-played\\\"}\",\"showings\":[{\"id\":\"449128\",\"time\":\"2026-07-17T15:00:00Z\",\"ticketsSold\":36,\"screenId\":\"117\",\"seatsRemaining\":152,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"449127\",\"time\":\"2026-07-17T18:45:00Z\",\"ticketsSold\":143,\"screenId\":\"117\",\"seatsRemaining\":45,\"displayMetaData\":\"{