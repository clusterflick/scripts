},{\"id\":\"385794\",\"time\":\"2026-02-21T20:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"385797\",\"time\":\"2026-02-22T19:30:00Z\",\"ticketsSold\":4,\"screenId\":\"117\",\"seatsRemaining\":184,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"385800\",\"time\":\"2026-02-23T19:00:00Z\",\"ticketsSold\":6,\"screenId\":\"117\",\"seatsRemaining\":182,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating tix-for-six\\\"}\"},{\"id\":\"385801\",\"time\":\"2026-02-24T14:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"385802\",\"time\":\"2026-02-24T17:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"385803\",\"time\":\"2026-02-24T20:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"385804\",\"time\":\"2026-02-25T13:40:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"385805\",\"time\":\"2026-02-25T17:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"385806\",\"time\":\"2026-02-25T20:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"385807\",\"time\":\"2026-02-26T13:45:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"385808\",\"time\":\"2026-02-26T17:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"385809\",\"time\":\"2026-02-26T20:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"}]},{\"id\":\"34267\",\"name\":\"Hamnet  - Celebrating The Oscars®\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"hamnet---celebrating-the-oscars\",\"posterImage\":\"6tivfzq6st58pngdxaa69aultejj\",\"bannerImage\":\"t94lp6yio9gvxtfq4k2k4vb77wyt\",\"synopsis\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful story of love and loss that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet\",\"starring\":\"Jessie Buckley, Paul Mescal, Emily Watson\",\"directedBy\":\"Chloé Zhao\",\"producedBy\":\"Steven Spielberg, Sam Mendes, Nicolas Gonda, Pippa Harris, Liza Marshall\",\"searchTerms\":\"\",\"duration\":126,\"genre\":\"Drama\",\"allGenres\":\"Drama, History, Romance\",\"rating\":\"12A\",\"trailerYoutubeId\":\"Y9Tv9wGPxIw\",\"trailerVideo\":null,\"releaseDate\":\"2026-01-09\",\"dateOfFirstShowing\":\"2026-01-09\",\"tmdbPopularityScore\":48.3736,\"tmdbId\":\"858024\",\"dcmEdiMovieId\":\"468539\",\"dcmEdiMovieName\":\"Hamnet [12A]\",\"siteId\":\"85\",\"titleClassId\":\"224\",\"showings\":[{\"id\":\"394856\",\"time\":\"2026-01-30T19:30:00Z\",\"ticketsSold\":6,\"screenId\":\"117\",\"seatsRemaining\":182,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating celebrating-the-oscars\\\"}\"},{\"id\":\"394849\",\"time\":\"2026-02-04T20:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating celebrating-the-oscars\\\"}\"},{\"id\":\"394857\",\"time\":\"2026-02-05T20:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating celebrating-the-oscars\\\"}\"},{\"id\":\"393412\",\"time\":\"2026-03-14T17:30:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating celebrating-the-oscars\\\"}\"}]},{\"id\":\"34026\",\"name\":\"Casablanca\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"casablanca\",\"posterImage\":\"6f60idm87pggginucdr8py6pb60n\",\"bannerImage\":\"z3k1pueqdji2qt6y9das8iwnpgq6\",\"synopsis\":\"In Casablanca, Morocco in December 1941, a cynical American expatriate meets a former lover, with unforeseen complications.\",\"starring\":\"Humphrey Bogart, Ingrid Bergman, Paul Henreid\",\"directedBy\":\"Michael Curtiz\",\"producedBy\":\"Hal B. Wallis\",\"searchTerms\":\"\",\"duration\":103,\"genre\":\"Drama\",\"allGenres\":\"Drama, Romance\",\"rating\":\"U\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"1943-01-15\",\"dateOfFirstShowing\":\"2026-02-16\",\"tmdbPopularityScore\":8.4186,\"tmdbId\":\"289\",\"dcmEdiMovieId\":\"8889065\",\"dcmEdiMovieName\":\"Casablanca (2019) (2D) [18]\",\"siteId\":\"85\",\"titleClassId\":\"224\",\"showings\":[{\"id\":\"391416\",\"time\":\"2026-02-16T13:00:00Z\",\"ticketsSold\":14,\"screenId\":\"117\",\"seatsRemaining\":174,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating monday-classic-matine\\\"}\"}]},{\"id\":\"33943\",\"name\":\"Wuthering Heights + A Panel Discussion on the Future of Film Criticism\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"wuthering-heights-a-panel-discussion-on-the-future-of-film-criticism\",\"posterImage\":\"8k8xv0uvfe4ffhnoj1lar72n5sxs\",\"bannerImage\":\"jwoekxeq5egll094by2frncrw55u\",\"synopsis\":\"As part of Regent Street Cinema’s 130th anniversary celebrations, we are delighted to present a special screening of Wuthering Heights on 20 February, followed by a panel discussion exploring the future of film criticism.\\n\\nThe discussion will be moderated by Jane Crowther, Chair of the London Critics’ Circle and author of Silver Screens, and features leading film critics Helen O’Hara (Empire, author of Women Vs Hollywood), Clarisse Loughrey (The Independent, author of Wes Anderson: A Retrospective), and Barry Levitt (Time, Rolling Stone, Empire).\\n\\nInspired by Regent Street Cinema’s Young Film Critics Mentoring Programme, delivered in partnership with the University of Westminster, the event connects established critical voices with emerging talent. The programme offers students mentoring, guidance and insight into the evolving practice of film criticism today.\\n\\nFollowing the screening, audiences will hear from both mentors and mentees as they reflect on their experiences of the programme, how film criticism is changing, and what the future may hold for the next generation of critics. The conversation will also consider the role of criticism in contemporary cinema culture and how new voices can shape its direction.\\n\\nRooted in Regent Street Cinema’s unique place in film history — where the Lumière brothers first presented moving pictures to a paying UK audience in 1896 — this evening celebrates not only 130 years of cinema, but the ongoing dialogue, discovery and critical thinking that continue to define it.\\n\\nPanel\\n\\nJane Crowther (Moderator)\\nFilm journalist since 2000, Jane has worked for numerous outlets including Flicks, The Sunday Times, Glamour and Total Film. She became Editor-in-Chief of Total Film in 2012, where she also hosted the Inside Total Film podcast. Jane is currently Chair of the London Critics’ Circle and Editor-in-Chief of Hollywood Authentic magazine. She is the author of two books: the non-fiction cinema book Silver Screens and the novel Gatsby.\\n\\nHelen O’Hara\\nEditor-at-Large at Empire, co-host of the Empire Podcast, and author of Women Vs Hollywood: The Fall and Rise of Women in Film. With over 20 years’ experience in film journalism, Helen has written for The Guardian, The Telegraph, Grazia, IGN and Time Out, among others. She hosts three podcasts: Women Vs Hollywood and Bah Humbug with Stripped Media, and Pop Culture: The Soft Drinks Podcast with Kat Brown.\\n\\nClarisse Loughrey\\nChief Film Critic at The Independent and a columnist for Flicks. Clarisse has previously written for Total Film, BAFTA, Curzon, Wireframe, Little White Lies and Second Sight Films. She is co-host of The Fade to Black and The Big Screen Book Club podcasts. Her debut book, Wes Anderson: A Retrospective, was published last year.\\n\\nBarry Levitt\\nUK-based freelance writer, podcaster and entertainment critic specialising in film and television. Barry’s work has appeared in major publications on both sides of the Atlantic, including The Daily Beast, Time Magazine, Vulture, Rolling Stone and Empire. He is a strong advocate for LGBTQ+ representation in media and uses his platform to highlight both emerging queer voices and influential classics.\",\"starring\":\"Margot Robbie, Jacob Elordi, Hong Chau\",\"directedBy\":\"Emerald Fennell\",\"producedBy\":\"Margot Robbie, Tom Ackerley, Emerald Fennell, Josey McNamara\",\"searchTerms\":\"\",\"duration\":136,\"genre\":\"Drama\",\"allGenres\":\"Drama, Romance\",\"rating\":\"15\",\"trailerYoutubeId\":\"i39w-wDZZuU\",\"trailerVideo\":null,\"releaseDate\":\"2026-02-13\",\"dateOfFirstShowing\":\"2026-02-20\",\"tmdbPopularityScore\":14.3307,\"tmdbId\":\"1316092\",\"dcmEdiMovieId\":\"8889447\",\"dcmEdiMovieName\":\"Wuthering Heights (1939) (2D) [U]\",\"siteId\":\"85\",\"titleClassId\":\"169\",\"showings\":[{\"id\":\"390267\",\"time\":\"2026-02-20T19:30:00Z\",\"ticketsSold\":27,\"screenId\":\"117\",\"seatsRemaining\":161,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating event-cinema 130th-anniversary-celebrations\\\"}\"}]},{\"id\":\"34070\",\"name\":\"The Lady Vanishes\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-lady-vanishes-\",\"posterImage\":\"ujsflrn439kl8yxxa5hidyyldix2\",\"bannerImage\":\"7iy4qu9navs0j6z9bzi6aw7myhbg\",\"synopsis\":\"During a journey aboard a Trans-Bonded Continental Express, a young woman strikes up an acquaintance with a middle-aged English governess. Later, the governess mysteriously disappears from her compartment. Seeking an explanation, the girl is accused of hallucinating to the extent that she begins to doubt her own state of mind. But as further enquiries are made among the passengers, the curious behaviour of a group of foreign government agents is revealed.\",\"starring\":\"Margaret Lockwood, Michael Redgrave\",\"directedBy\":\"Alfred Hitchcock\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":93,\"genre\":null,\"allGenres\":null,\"rating\":\"U\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-02-23\",\"dateOfFirstShowing\":\"2026-02-23\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"\",\"dcmEdiMovieName\":null,\"siteId\":\"85\",\"titleClassId\":\"224\",\"showings\":[{\"id\":\"391428\",\"time\":\"2026-02-23T13:00:00Z\",\"ticketsSold\":10,\"screenId\":\"117\",\"seatsRemaining\":178,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating monday-classic-matine\\\"}\"}]},{\"id\":\"34265\",\"name\":\"Marty Supreme  - Celebrating The Oscars®\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"marty-supreme---celebrating-the-oscars\",\"posterImage\":\"5x8ql389fokpjj256pjxxg5hszmw\",\"bannerImage\":\"7bwnyqf00gfc509xh9ijweka3c6p\",\"synopsis\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"starring\":\"Timothée Chalamet, Gwyneth Paltrow, Odessa A'zion\",\"directedBy\":\"Josh Safdie\",\"producedBy\":\"Timothée Chalamet, Josh Safdie, Ronald Bronstein, Eli Bush, Anthony Katagas\",\"searchTerms\":\"\",\"duration\":150,\"genre\":\"Comedy\",\"allGenres\":\"Comedy, Drama\",\"rating\":\"15\",\"trailerYoutubeId\":\"BDhdQtB0PWM\",\"trailerVideo\":null,\"releaseDate\":\"2025-12-26\",\"dateOfFirstShowing\":\"2025-12-26\",\"tmdbPopularityScore\":84.6194,\"tmdbId\":\"1317288\",\"dcmEdiMovieId\":\"456813\",\"dcmEdiMovieName\":\"MARTY SUPREME [Unknown]\",\"siteId\":\"85\",\"titleClassId\":\"224\",\"showings\":[{\"id\":\"394850\",\"time\":\"2026-01-30T16:20:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating celebrating-the-oscars\\\"}\"},{\"id\":\"394858\",\"time\":\"2026-02-04T16:50:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating celebrating-the-oscars\\\"}\"},{\"id\":\"393399\",\"time\":\"2026-03-13T17:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating celebrating-the-oscars\\\"}\"}]},{\"id\":\"34266\",\"name\":\"Sentimental Value  - Celebrating The Oscars®\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"sentimental-value---celebrating-the-oscars\",\"posterImage\":\"rqjmpuef9zog7bmn2he70zt0bed1\",\"bannerImage\":\"j0e1t31mg5r407jedgo9wg2ga809\",\"synopsis\":\"Joachim Trier's SENTIMENTAL VALUE. A rewarding and profoundly moving experience that intimately explores sisterhood, father-daughter relationships and the evocative power of childhood memories.\",\"starring\":\"Renate Reinsve, Stellan Skarsgård, Inga Ibsdotter Lilleaas, Elle Fanning\",\"directedBy\":\"Joachim Trier\",\"producedBy\":\"Maria Ekerhovd, Andrea Berentsen Ottmar\",\"searchTerms\":\"\",\"duration\":133,\"genre\":\"Drama\",\"allGenres\":\"Drama, Comedy\",\"rating\":\"15\",\"trailerYoutubeId\":\"AkoX8Cnp68E\",\"trailerVideo\":null,\"releaseDate\":\"2025-12-26\",\"dateOfFirstShowing\":\"2025-12-26\",\"tmdbPopularityScore\":29.9721,\"tmdbId\":\"1124566\",\"dcmEdiMovieId\":\"467298\",\"dcmEdiMovieName\":\"Sentimental Value [15]\",\"siteId\":\"85\",\"titleClassId\":\"224\",\"showings\":[{\"id\":\"394853\",\"time\":\"2026-02-05T14:10:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating celebrating-the-oscars\\\"}\"},{\"id\":\"393400\",\"time\":\"2026-03-15T12:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating celebrating-the-oscars\\\"}\"}]},{\"id\":\"33517\",\"name\":\"National Theatre Live: All My Sons\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"national-theatre-live-all-my-sons\",\"posterImage\":\"tyhx6ade67c8pix0vpamu44h54vs\",\"bannerImage\":\"zpuuotih4ixgp4yroamzhyf9k33e\",\"synopsis\":\"Bryan Cranston (Breaking Bad) and Marianne Jean-Baptiste (Hard Truths) feature in a five-star, triumphantly acclaimed new production of Arthur Miller’s classic play, from visionary director Ivo Van Hove (A View from the Bridge).\\nOne family, the heart of the American dream. When wartime delivers profits for Joe, it comes at a price when his partner is charged with criminal manufacturing deals, and his eldest son goes missing in action. Will peacetime bring peace of mind, or will he be confronted by the consequence of his actions?\\nFilmed live from the West End, Paapa Essiedu (I May Destroy You), Tom Glynn-Carney\\n(House of the Dragon), and Hayley Squires (I, Daniel Blake) also feature in this disturbingly\\nprescient play.\",\"starring\":\"Bryan Cranston, Marianne Jean-Baptiste, Paapa Essiedu, Tom Glynn-Carney, Hayley Squires\",\"directedBy\":\"Ivo Van Hove\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":130,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"3HGScE2B1j4\",\"trailerVideo\":null,\"releaseDate\":\"2026-04-16\",\"dateOfFirstShowing\":\"2026-04-26\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"477670\",\"dcmEdiMovieName\":\"Untitled NT Live Event (16Th Apr 2026) [Unknown]\",\"siteId\":\"85\",\"titleClassId\":\"169\",\"showings\":[{\"id\":\"387284\",\"time\":\"2026-04-26T15:00:00Z\",\"ticketsSold\":6,\"screenId\":\"117\",\"seatsRemaining\":182,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"}]},{\"id\":\"34261\",\"name\":\"Bugonia  - Celebrating The Oscars®\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"bugonia---celebrating-the-oscars\",\"posterImage\":\"0sef19vfnhn6sraopfzrb9bdx2lv\",\"bannerImage\":\"wxpjqf7qz1gwgm60w0d62gxz83ai\",\"synopsis\":\"Two conspiracy obsessed young men kidnap the high-powered CEO of a major company, convinced that she is an alien intent on destroying planet Earth.\",\"starring\":\"Emma Stone, Jesse Plemons, Aidan Delbis\",\"directedBy\":\"Yorgos Lanthimos\",\"producedBy\":\"Emma Stone, Yorgos Lanthimos, Ari Aster, Miky Lee, Lars Knudsen, Ed Guiney, Andrew Lowe, Jerry Kyoungboum Ko\",\"searchTerms\":\"\",\"duration\":119,\"genre\":\"Comedy\",\"allGenres\":\"Comedy, Science Fiction\",\"rating\":\"15\",\"trailerYoutubeId\":\"SxcyHJOpOGo\",\"trailerVideo\":null,\"releaseDate\":\"2025-10-31\",\"dateOfFirstShowing\":\"2025-10-31\",\"tmdbPopularityScore\":41.2857,\"tmdbId\":\"701387\",\"dcmEdiMovieId\":\"423894\",\"dcmEdiMovieName\":\"BUGONIA [Unknown]\",\"siteId\":\"85\",\"titleClassId\":\"224\",\"showings\":[{\"id\":\"394852\",\"time\":\"2026-02-04T14:15:00Z\",\"ticketsSold\":2,\"screenId\":\"117\",\"seatsRemaining\":186,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating celebrating-the-oscars\\\"}\"},{\"id\":\"393394\",\"time\":\"2026-03-15T20:30:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating celebrating-the-oscars\\\"}\"}]},{\"id\":\"34264\",\"name\":\"One Battle After Another  - Celebrating The Oscars®\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"one-battle-after-another---celebrating-the-oscars\",\"posterImage\":\"13dnn0moeqs14p0iiinybyuivkn2\",\"bannerImage\":\"2vcujx8ilcj0hb0l40o57p34g3s3\",\"synopsis\":\"From Warner Bros. Pictures and Academy Award-nominated, BAFTA-winning filmmaker Paul Thomas Anderson comes “One Battle After Another,” starring Academy Award and BAFTA winner Leonardo DiCaprio.\\n\\nOscar and BAFTA winners Benicio del Toro and Sean Penn also star alongside Regina Hall, Teyana Taylor and Chase Infiniti, as well as Wood Harris and Alana Haim.\\n\\nFlickering Images - This may affect viewers who are susceptible to photosensitive epilepsy.\",\"starring\":\"Leonardo DiCaprio, Sean Penn, Chase Infiniti\",\"directedBy\":\"Paul Thomas Anderson\",\"producedBy\":\"Paul Thomas Anderson, Sara Murphy, Adam Somner\",\"searchTerms\":\"\",\"duration\":162,\"genre\":\"Crime\",\"allGenres\":\"Crime, Action, Comedy\",\"rating\":\"15\",\"trailerYoutubeId\":\"4rNLrWQ4HtY\",\"trailerVideo\":null,\"releaseDate\":\"2025-09-26\",\"dateOfFirstShowing\":\"2025-09-26\",\"tmdbPopularityScore\":73.2477,\"tmdbId\":\"1054867\",\"dcmEdiMovieId\":\"371795\",\"dcmEdiMovieName\":\"ONE BATTLE AFTER ANOTHER [Unknown]\",\"siteId\":\"85\",\"titleClassId\":\"224\",\"showings\":[{\"id\":\"394851\",\"time\":\"2026-01-30T13:00:00Z\",\"ticketsSold\":1,\"screenId\":\"117\",\"seatsRemaining\":187,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating celebrating-the-oscars\\\"}\"},{\"id\":\"393398\",\"time\":\"2026-03-14T20:15:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating celebrating-the-oscars\\\"}\"}]},{\"id\":\"25083\",\"name\":\"Turner \\u0026 Constable\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"turner-constable\",\"posterImage\":\"54w2l5luirz1aojj6lbzpwrue0m3\",\"bannerImage\":\"mkm90yrijwdlh3wg38vin21ed5ja\",\"synopsis\":\"The incredible story of Britain’s greatest landscape artists and their fierce rivalry, made in close collaboration with Tate Britain to celebrate the 250th anniversary of their births.\\n\\nTwo of Britain’s greatest painters, J.M.W. Turner and John Constable were also the greatest of rivals. Born within a year of each other, both used landscape painting to reflect the changing world around them. Tate Britain is bringing these two greats together for a groundbreaking exhibition, in London from November 2025 to April 2026, and Exhibition on Screen once again has exclusive and privileged access to bring their extraordinary art and remarkable stories to the big screen in February so that you can enjoy both together. Don’t miss this opportunity to see these greats side-by-side, as they so often were in life, on the big screen for the first time.\\n\\nTurner’s blazing sunsets and sublime scenes from his travels and Constable’s idealised depictions of beloved places from home whipped the public of the time into a frenzy of enthusiasm. Critics compared their starkly different styles to a clash of ‘fire and water’.\\n\\nMarking 250 years since their births, this unmissable new documentary explores Turner and Constable's intertwined lives and legacies alongside the groundbreaking Tate exhibition. Discover unexpected sides to both artists with intimate views of sketchbooks and personal items and insights from leading experts.\",\"starring\":null,\"directedBy\":\"David Bickerstaff\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":90,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-03-15\",\"dateOfFirstShowing\":null,\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"470745\",\"dcmEdiMovieName\":\"Exhibition On Screen: Turner \\u0026amp; Constable 2026 (Exhibition) [Unknown]\",\"siteId\":\"85\",\"titleClassId\":\"169\",\"showings\":[{\"id\":\"310010\",\"time\":\"2026-03-15T15:00:00Z\",\"ticketsSold\":14,\"screenId\":\"117\",\"seatsRemaining\":174,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"310012\",\"time\":\"2026-03-22T12:00:00Z\",\"ticketsSold\":3,\"screenId\":\"117\",\"seatsRemaining\":185,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"}]},{\"id\":\"25088\",\"name\":\"Frida Kahlo\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"frida-kahlo\",\"posterImage\":\"xjzl817ovxlevpqt4bvy28dn0l19\",\"bannerImage\":\"4g6byo4sfdy0xl65ogfl5adydswk\",\"synopsis\":\"Frida Kahlo is a phenomenon. She is arguably the world’s favourite female artist – beloved by young and old. Exhibition on Screen’s award-winning film – first released during covid to a restricted audience - is back by popular demand with an exciting new addition from the blockbuster transatlantic exhibition from Tate Britain and MFA Houston 'Frida Kahlo: the Making of an Icon'. Back in the cinemas in May 2026, one month before the Tate exhibition opens, allowing audiences to watch both the film and see the show.\\n\\nWho was Frida Kahlo? Everyone knows her face but who was the woman behind the bright colours, the big brows and the floral crowns? Take a journey through the life of a true icon, discover her art, and uncover the true story of her rebellious, passionate and turbulent life.\\n\\nMaking use of the latest technology to deliver previously unimaginable quality, we take an in-depth look at key works throughout her career. Using letters Kahlo wrote to guide us, this definitive film reveals her deepest emotions and unlocks the secrets and symbolism contained within her art.\\n\\nExhibition on Screen’s trademark combination of interviews with those who knew her and world experts, commentary and a detailed exploration of her art, combined with new special bonus footage from the 2026 Tate exhibition, delivers a treasure trove of colour and emotion. This personal and intimate film offers privileged access to her works, her home, her studio and highlights the source of her feverish creativity, her resilience and her unmatched lust for life, beauty and revolution.\\n\\nCreated in close collaboration with world experts and those who knew her.\\n\\nAdditional new material from the curators of the groundbreaking new Tate Britain and MFA Houston exhibition.\",\"starring\":null,\"directedBy\":\"Ali Ray\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":90,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-05-24\",\"dateOfFirstShowing\":null,\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"273803\",\"dcmEdiMovieName\":\"Exhibition On Screen: Frida Kahlo 2020 (Exhibition) (2D) [12A]\",\"siteId\":\"85\",\"titleClassId\":\"169\",\"showings\":[{\"id\":\"310025\",\"time\":\"2026-05-24T14:00:00Z\",\"ticketsSold\":3,\"screenId\":\"117\",\"seatsRemaining\":185,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating special-event\\\"}\"},{\"id\":\"310026\",\"time\":\"2026-05-31T11:00:00Z\",\"ticketsSold\":7,\"screenId\":\"117\",\"seatsRemaining\":181,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating special-event\\\"}\"}]}]}}}",
