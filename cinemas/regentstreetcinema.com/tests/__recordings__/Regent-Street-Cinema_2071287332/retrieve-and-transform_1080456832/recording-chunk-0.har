Id\":\"85\",\"titleClassId\":\"180\",\"showings\":[{\"id\":\"379729\",\"time\":\"2025-12-18T19:00:00Z\",\"ticketsSold\":188,\"screenId\":\"117\",\"seatsRemaining\":0,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"388632\",\"time\":\"2026-01-24T19:30:00Z\",\"ticketsSold\":188,\"screenId\":\"117\",\"seatsRemaining\":0,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"391414\",\"time\":\"2026-02-18T13:30:00Z\",\"ticketsSold\":39,\"screenId\":\"117\",\"seatsRemaining\":149,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"}]},{\"id\":\"34068\",\"name\":\"How To Steal A Million + Live Organ\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"how-to-steal-a-million-live-organ\",\"posterImage\":\"ai4zcu69kn9egc13k09qjj73u5kv\",\"bannerImage\":\"ffbybkoq5xhkjxqmj0iqstrbmq8n\",\"synopsis\":\"A woman must steal a statue from a Paris museum to help conceal her father's art forgeries.\",\"starring\":\"Audrey Hepburn, Peter O'Toole, Eli Wallach\",\"directedBy\":\"William Wyler\",\"producedBy\":\"Fred Kohlmar\",\"searchTerms\":\"\",\"duration\":123,\"genre\":\"Comedy\",\"allGenres\":\"Comedy, Crime, Romance\",\"rating\":\"U\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"1966-07-13\",\"dateOfFirstShowing\":\"2026-02-02\",\"tmdbPopularityScore\":2.1099,\"tmdbId\":\"3001\",\"dcmEdiMovieId\":\"8888247\",\"dcmEdiMovieName\":\"How To Steal Millions (2D) [U]\",\"siteId\":\"85\",\"titleClassId\":\"224\",\"showings\":[{\"id\":\"391419\",\"time\":\"2026-02-02T13:00:00Z\",\"ticketsSold\":30,\"screenId\":\"117\",\"seatsRemaining\":158,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating monday-classic-matine\\\"}\"}]},{\"id\":\"34263\",\"name\":\"Sinners  - Celebrating The Oscars®\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"sinners---celebrating-the-oscars\",\"posterImage\":\"qpr0n7frkmp9mlxsadkscxx0wtdk\",\"bannerImage\":\"r8zxlw81ebg87danzbjeimb8qwl9\",\"synopsis\":\"From Ryan Coogler—director of “Black Panther” and “Creed”—and starring Michael B. Jordan comes a new vision of fear: “Sinners.” \\n\\nTrying to leave their troubled lives behind, twin brothers (Jordan) return to their hometown to start again, only to discover that an even greater evil is waiting to welcome them back.\",\"starring\":\"Michael B. Jordan, Hailee Steinfeld, Miles Caton\",\"directedBy\":\"Ryan Coogler\",\"producedBy\":\"Ryan Coogler, Zinzi Coogler, Sev Ohanian\",\"searchTerms\":\"\",\"duration\":138,\"genre\":\"Horror\",\"allGenres\":\"Horror, Thriller\",\"rating\":\"15\",\"trailerYoutubeId\":\"4oqCwr_bzHI\",\"trailerVideo\":null,\"releaseDate\":\"2025-04-18\",\"dateOfFirstShowing\":\"2026-02-05\",\"tmdbPopularityScore\":110.694,\"tmdbId\":\"1233413\",\"dcmEdiMovieId\":\"381073\",\"dcmEdiMovieName\":\"Pray For Our Sinners (2D) [U]\",\"siteId\":\"85\",\"titleClassId\":\"224\",\"showings\":[{\"id\":\"394854\",\"time\":\"2026-02-05T17:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating celebrating-the-oscars\\\"}\"},{\"id\":\"393397\",\"time\":\"2026-03-13T20:10:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating celebrating-the-oscars\\\"}\"}]},{\"id\":\"34272\",\"name\":\"Aftersun - £4 All Tickets!\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"aftersun\",\"posterImage\":\"64odst2mcb5735tu04oln40h4mdh\",\"bannerImage\":\"w6eh0wj349i6ptlisngq9okyreg9\",\"synopsis\":\"Sophie reflects on the shared joy and private melancholy of a holiday she took with her father twenty years earlier. Memories real and imagined fill the gaps between miniDV footage as she tries to reconcile the father she knew with the man she didn’t.\",\"starring\":\"Paul Mescal, Frankie Corio, Brooklyn Toulson\",\"directedBy\":\"Charlotte Wells\",\"producedBy\":\"Amy Jackson, Barry Jenkins, Adele Romanski, Mark Ceryak\",\"searchTerms\":\"\",\"duration\":102,\"genre\":\"Drama\",\"allGenres\":\"Drama\",\"rating\":\"12A\",\"trailerYoutubeId\":\"vXKcWRu8K_U\",\"trailerVideo\":null,\"releaseDate\":\"2022-10-20\",\"dateOfFirstShowing\":\"2026-02-06\",\"tmdbPopularityScore\":7.8244,\"tmdbId\":\"965150\",\"dcmEdiMovieId\":\"364432\",\"dcmEdiMovieName\":\"Aftersun (2D) [12A]\",\"siteId\":\"85\",\"titleClassId\":\"224\",\"showings\":[{\"id\":\"393438\",\"time\":\"2026-02-06T17:40:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating 130th-anniversary-celebrations\\\"}\"}]},{\"id\":\"34271\",\"name\":\"Parasite - £4 All Tickets!\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"parasite\",\"posterImage\":\"mu60s1xnddj5euknt08n0dt7cqfx\",\"bannerImage\":\"0dvz459ltaf3j54l80l98ggtsp8p\",\"synopsis\":\"Meet the Park Family: the picture of aspirational wealth. And the Kim Family, rich in street smarts but not much else. Be it chance or fate, these two houses are brought together and the Kims sense a golden opportunity. Masterminded by college-aged Ki-woo, the Kim children expediently install themselves as tutor and art therapist to the Parks. Soon, a symbiotic relationship forms between the two families. The Kims provide 'indispensable' luxury services while the Parks give the Kims a way out of their shabby circumstances. But this new ecosystem is fragile, and soon enough greed and class prejudice threaten to upend the Kims' newfound comfort.\",\"starring\":\"Song Kang-ho, Lee Sun-kyun, Cho Yeo-jeong\",\"directedBy\":\"Bong Joon Ho\",\"producedBy\":\"Bong Joon Ho, Kwak Sin-ae, Moon Yang-kwon, Jang Young-hwan\",\"searchTerms\":\"\",\"duration\":133,\"genre\":\"Comedy\",\"allGenres\":\"Comedy, Thriller, Drama\",\"rating\":\"15\",\"trailerYoutubeId\":\"tBfgTZsBeFM\",\"trailerVideo\":null,\"releaseDate\":\"2019-02-07\",\"dateOfFirstShowing\":\"2026-02-08\",\"tmdbPopularityScore\":24.3313,\"tmdbId\":\"496243\",\"dcmEdiMovieId\":\"269558\",\"dcmEdiMovieName\":\"Parasite (2D) [15]\",\"siteId\":\"85\",\"titleClassId\":\"224\",\"showings\":[{\"id\":\"393437\",\"time\":\"2026-02-08T19:00:00Z\",\"ticketsSold\":0,\"screenId\":\"117\",\"seatsRemaining\":188,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating 130th-anniversary-celebrations\\\"}\"}]},{\"id\":\"25433\",\"name\":\"R.E.M. X Buster Keaton's Sherlock Jr.\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"rem-x-buster-keatons-sherlock-jr\",\"posterImage\":\"neoa0bkj0wnl6i9v2b5ybge15efb\",\"bannerImage\":\"0wpfqx5g2b3pn1nbt8t0woslrg58\",\"synopsis\":\"Keaton’s 1924 comedy classic is reimagined with R.E.M. 's alt-rock masterpieces Monster (1994) and New Adventures in\\nHi-Fi (1996).\\nIn this sublime comedy teetering between reality and illusion, Buster Keaton stars as a film projectionist who dreams of\\nbecoming a detective. He uses his limited skills when he is framed by a rival for stealing his girlfriend’s father’s pocket\\nwatch. Keaton reportedly broke his neck performing one of the many dangerous practical stunts in the film.\\nWhether you’re a movie lover or a rock music fan this is an experience you won’t want to miss!!\\nSherlock Jr. will be preceded by a special presentation of one of Keaton’s classic short film works, The Balloonatic (1923),\\nsoundtracked by a new composition by renowned Brazilian electronic artist, Amon Tobin.\\n\\nThis film contains flickering or flashing lights that may affect those with photosensitive epilepsy.\",\"starring\":\"Buster Keaton, Kathryn McGuire, Joe Keaton\",\"directedBy\":\"Buster Keaton, Josh Frank\",\"producedBy\":\"\",\"searchTerms\":\"\",\"duration\":74,\"genre\":\"Comedy\",\"allGenres\":\"Comedy\",\"rating\":\"12A\",\"trailerYoutubeId\":\"otwTXYFHmFc\",\"trailerVideo\":null,\"releaseDate\":\"2026-02-05\",\"dateOfFirstShowing\":\"2026-02-08\",\"tmdbPopularityScore\":0.1724,\"tmdbId\":\"1556179\",\"dcmEdiMovieId\":\"473041\",\"dcmEdiMovieName\":\"Lrc R.E.M. X Buster Keaton's Sherlock Jr. [Unknown]\",\"siteId\":\"85\",\"titleClassId\":\"169\",\"showings\":[{\"id\":\"316855\",\"time\":\"2026-02-08T17:00:00Z\",\"ticketsSold\":42,\"screenId\":\"117\",\"seatsRemaining\":146,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating special-event\\\"}\"}]},{\"id\":\"34067\",\"name\":\"Gone With The Wind\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"gone-with-the-wind\",\"posterImage\":\"ivb58g4obh9nqh2etevhyyfsfznk\",\"bannerImage\":\"ul18xgyp2220ugsxekigy7vu8che\",\"synopsis\":\"Gone with the Wind, lauded as one of the American cinema’s grandest, most ambitious and spectacular pieces of filmmaking, was helmed by Victor Fleming in 1939, the same year as the director’s The Wizard of Oz. It captured 10 Academy Awards®[ii] including Best Picture, Best Actress, and Best Supporting Actress for Hattie McDaniel, the first Oscar awarded to an African-American actor. Margaret Mitchell’s Pulitzer-prize winning novel, on which the film is based, has been translated into 16 languages, has sold hundreds of millions of copies worldwide, and even now, continues to sell 50,000 copies a year.\\n\\nClark Gable, Vivien Leigh, Olivia de Havilland, Leslie Howard and Hattie McDaniel star in this classic epic of the American South. On the eve of the Civil War, rich, beautiful and self-centered Scarlett O’Hara (Leigh) has everything she could want – except Ashley Wilkes (Leslie Howard). As the war devastates the South, Scarlett discovers the strength within herself to protect her family and rebuild her life. Through everything, she longs for Ashley, unaware that she is already married to the man she really loves (Gable) – and who truly loves her – until she finally drives him away. Only then does Scarlett realize what she has lost … and tries to win him back.\",\"starring\":\"Vivien Leigh, Clark Gable, Olivia de Havilland\",\"directedBy\":\"Victor Fleming\",\"producedBy\":\"David O. Selznick\",\"searchTerms\":\"\",\"duration\":233,\"genre\":\"Drama\",\"allGenres\":\"Drama, War, Romance\",\"rating\":\"PG\",\"trailerYoutubeId\":\"0dTsfsr6-X8\",\"trailerVideo\":null,\"releaseDate\":\"1939-12-15\",\"dateOfFirstShowing\":\"2026-02-09\",\"tmdbPopularityScore\":8.5748,\"tmdbId\":\"770\",\"dcmEdiMovieId\":\"932400\",\"dcmEdiMovieName\":\"Gone With The Wind (Re: 1989) (2D) [PG]\",\"siteId\":\"85\",\"titleClassId\":\"224\",\"showings\":[{\"id\":\"391418\",\"time\":\"2026-02-09T13:00:00Z\",\"ticketsSold\":24,\"screenId\":\"117\",\"seatsRemaining\":164,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"}]},{\"id\":\"33371\",\"name\":\"From Lumière to Lloyd: Silent Cinema with Live Organ and Paul Merton\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"from-lumire-to-speedy-silent-cinema-with-live-organ-and-paul-merton\",\"posterImage\":\"spctu0xl4duh6msc0rwwh4nm1hzt\",\"bannerImage\":\"uj9vaak7cbnhe21ja7wifobe7srh\",\"synopsis\":\"Join us for a special anniversary celebration of silent cinema, marking 130 years since film history began within these very walls.\\n\\nIn 1896, the Lumière brothers brought their cinematograph to Regent Street, presenting the first moving pictures ever screened to a paying audience in the UK. This unique event looks back to that extraordinary moment with an evening of silent film curated and presented live by Paul Merton, who will be in attendance to introduce and reflect on the films as they unfold.\\n\\nThe programme begins with a selection of pioneering early short films and classic silent comedies, capturing cinema in its infancy — playful, inventive, and full of wonder. These pre-interval films will be accompanied live on the cinema’s historic organ, with the renowned organist Donald MacKenzie providing the music for the evening, recreating the atmosphere of early film exhibition.\\n\\nPre-interval programme:\\n\\nSprinkler Sprinkled (1895, France) – Directed by Louis Lumière\\nOne of the earliest narrative films, this short comic scene features a mischievous boy playing a prank on a gardener, creating a simple yet enduring visual gag that helped establish screen comedy.\\n\\nDemolishing a Wall (1896, France) – Directed by Louis Lumière\\nA group of workers knock down a wall, only for it to magically reassemble in reverse motion. A playful experiment that reveals cinema’s early fascination with time, movement, and illusion.\\n\\nArrival of a Train at La Ciotat (1896, France) – Directed by Auguste and Louis Lumière\\nPerhaps the most famous of all early films, this strikingly realistic depiction of a train entering a station demonstrates the immersive power of moving images in cinema’s earliest days.\\n\\nCameo the Dog (1907, United Kingdom) – Director unknown\\nThis charming British short follows a clever dog who helps his owner recover stolen goods, showcasing early narrative storytelling and animal performance.\\n\\nTwo Tars (1928, USA) – Directed by James Parrott\\nLaurel and Hardy star as sailors whose shore leave spirals into escalating chaos. Renowned for its spectacular street brawl, the film is a masterclass in slapstick comedy.\\n\\nAfter a short interval, the evening culminates in a full screening of Speedy (1928, USA), directed by Ted Wilde — Harold Lloyd’s exuberant silent feature celebrating New York City in all its bustling energy. Lloyd stars as an optimistic young man fighting to save his girlfriend’s grandfather’s horse-drawn streetcar business, resulting in a joyous blend of romance, daring stunts, and large-scale urban comedy. The film will be shown with a score by the legendary composer Carl Davis.\\n\\nAn immersive journey from cinema’s earliest experiments to one of the great masterpieces of the silent era, this is a rare opportunity to experience silent film as it was originally intended — live, communal, and full of wonder.\",\"starring\":\"Harold Lloyd, Ann Christy, Bert Woodruff\",\"directedBy\":\"Ted Wilde\",\"producedBy\":\"Harold Lloyd\",\"searchTerms\":\"\",\"duration\":85,\"genre\":\"Comedy\",\"allGenres\":\"Comedy\",\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"1928-04-07\",\"dateOfFirstShowing\":\"2026-02-13\",\"tmdbPopularityScore\":2.3834,\"tmdbId\":\"22595\",\"dcmEdiMovieId\":\"147734\",\"dcmEdiMovieName\":\"20 Feet From Stardom (2D) [12A]\",\"siteId\":\"85\",\"titleClassId\":\"169\",\"showings\":[{\"id\":\"385770\",\"time\":\"2026-02-13T19:30:00Z\",\"ticketsSold\":132,\"screenId\":\"117\",\"seatsRemaining\":56,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating 130th-anniversary-celebrations\\\"}\"}]},{\"id\":\"33372\",\"name\":\"Wuthering Heights\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"wuthering-heights\",\"posterImage\":\"8k8xv0uvfe4ffhnoj1lar72n5sxs\",\"bannerImage\":\"jwoekxeq5egll094by2frncrw55u\",\"synopsis\":\"A bold and original imagining of one of the greatest love stories of all time, Emerald Fennell’s “WUTHERING HEIGHTS” stars Margot Robbie as Cathy and Jacob Elordi as Heathcliff, whose forbidden passion for one another turns from romantic to intoxicating in an epic tale of lust, love and madness.\",\"starring\":\"Margot Robbie, Jacob Elordi, Hong Chau\",\"directedBy\":\"Emerald Fennell\",\"producedBy\":\"Margot Robbie, Tom Ackerley, Emerald Fennell, Josey McNamara\",\"searchTerms\":\"\",\"duration\":136,\"genre\":\"Drama\",\"allGenres\":\"Drama, Romance\",\"rating\":\"15\",\"trailerYoutubeId\":\"i39w-wDZZuU\",\"trailerVideo\":null,\"releaseDate\":\"2026-02-13\",\"dateOfFirstShowing\":\"2026-02-13\",\"tmdbPopularityScore\":14.3307,\"tmdbId\":\"1316092\",\"dcmEdiMovieId\":\"455981\",\"dcmEdiMovieName\":\"WUTHERING HEIGHTS [Unknown]\",\"siteId\":\"85\",\"titleClassId\":\"180\",\"showings\":[{\"id\":\"385772\",\"time\":\"2026-02-13T13:00:00Z\",\"ticketsSold\":1,\"screenId\":\"117\",\"seatsRemaining\":187,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"385771\",\"time\":\"2026-02-13T16:00:00Z\",\"ticketsSold\":1,\"screenId\":\"117\",\"seatsRemaining\":187,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"},{\"id\":\"385774\",\"time\