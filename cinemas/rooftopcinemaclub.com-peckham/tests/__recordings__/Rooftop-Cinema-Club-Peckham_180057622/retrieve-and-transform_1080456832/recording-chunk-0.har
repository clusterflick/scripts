          "content": {
            "mimeType": "application/json",
            "text": "{\"id\":\"1805202e-cc28-44c2-941d-2ab4e2336777\",\"title\":\"The Great Gatsby - Rooftop Cinema Club's 15th Birthday Party\",\"url\":\"\\/uk\\/london\\/peckham\\/screenings\\/the-great-gatsby-2371\",\"date\":\"Sun, Jun 14\",\"time\":\"3:30 PM\",\"door_time\":\"2:30 PM\",\"minimum_age\":18,\"short_description\":\"Rooftop Cinema Club's 15th Birthday Party\",\"long_description\":\"<p>We&rsquo;re turning 15 - and we&rsquo;re celebrating by rewinding the clock.<\\/p>\\n<p>&nbsp;<\\/p>\\n<p>For one night only, tickets are back to the exact prices we charged on the very first day we opened in June 2011. Proper throwback pricing!<\\/p>\\n<p>&nbsp;<\\/p>\\n<p>There&rsquo;ll be free birthday cake, a few surprise treats throughout the night, and one lucky guest will win a limited 15th Anniversary Crystal Ring.<\\/p>\\n<p>&nbsp;<\\/p>\\n<p>Fifteen summers. Countless sunsets. One iconic rooftop.<\\/p>\",\"image_url\":\"https:\\/\\/res.cloudinary.com\\/dpgypjrov\\/image\\/fetch\\/f_auto,w_600,h_450,c_fill,q_80\\/https:\\/\\/d31ni94nh7toh0.cloudfront.net\\/PRODUCTION\\/films\\/06cd3a9b-6eb6-471b-a38f-2b7626c1fa7d\\/Birthday_web.jpg\",\"venue_title\":\"Peckham, London\",\"collections\":[],\"seasons\":[],\"tags\":[{\"title\":\"Event\"}],\"accessibility\":[],\"sold_out\":true}",
            "size": 1191
          },
