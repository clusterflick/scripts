            "mimeType": "text/html; charset=utf-8",
            "text": "<!doctype html>\n<html class=\"scroll-smooth antialiased\" lang=\"en\">\n    <head>\n        <meta charset=\"utf-8\">\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n        <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"theme-color\" content=\"#E95D40\">\n        \n        \n        <title>Almost Famous x Sofar Sounds at Peckham, London &mdash; August 13, 2026 | Rooftop Cinema Club</title>\n<meta name=\"description\" content=\"Watch Almost Famous x Sofar Sounds at Peckham, London on August 13, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:title\" content=\"Almost Famous x Sofar Sounds at Peckham, London &mdash; August 13, 2026\" />\n<meta property=\"og:description\" content=\"Watch Almost Famous x Sofar Sounds at Peckham, London on August 13, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:url\" content=\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/almost-famous-x-sofar-sounds-2842\" />\n<meta property=\"og:site_name\" content=\"Rooftop Cinema Club\" />\n<meta property=\"og:locale\" content=\"en_GB\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"Almost Famous x Sofar Sounds at Peckham, London &mdash; August 13, 2026\" />\n<meta name=\"twitter:description\" content=\"Watch Almost Famous x Sofar Sounds at Peckham, London on August 13, 2026. Outdoor rooftop cinema in London.\" />\n<link href=\"https://rooftopcinemaclub.com/uk\" rel=\"home\" />\n<link href=\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/almost-famous-x-sofar-sounds-2842\" rel=\"canonical\" />\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Global Home\",\"item\":\"https://rooftopcinemaclub.com/uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"London\",\"item\":\"https://rooftopcinemaclub.com/uk/london\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Peckham, London\",\"item\":\"https://rooftopcinemaclub.com/uk/london/peckham\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Almost Famous x Sofar Sounds\",\"item\":\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/almost-famous-x-sofar-sounds-2842\"}]}</script>\n<script type=\"application/ld+json\">{    \"@context\": \"https://schema.org\",    \"@type\": \"ScreeningEvent\",    \"@id\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/almost-famous-x-sofar-sounds-2842#event\",    \"name\": \"Almost Famous x Sofar Sounds\",    \"url\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/almost-famous-x-sofar-sounds-2842\",    \"startDate\": \"2026-08-13T19:45:00+00:00\",            \"endDate\": \"2026-08-13T22:20:00+00:00\",            \"eventStatus\": \"https://schema.org/EventScheduled\",    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",    \"inLanguage\": \"en-GB\",    \"isAccessibleForFree\": false,    \"offers\": {        \"@type\": \"Offer\",        \"url\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/almost-famous-x-sofar-sounds-2842\",        \"availability\": \"https://schema.org/InStock\"    },        \"description\": \"A very special screening of Almost Famous in partnership with Sofar Sounds, featuring a live performance inspired by the golden age of 70s rock. Expect classic rock, folk-rock and Americana influences, celebrating the era that inspired Cameron Crowe's coming-of-age masterpiece and its unforgettable soundtrack. &nbsp; Before the film begins, during golden hour, we&rsquo;re handing the rooftop over to the magical team at Sofar Sounds for an intimate live set under the Peckham sky. &nbsp; Expect stripped-back performances inspired by this classic movie, undiscovered talent and that unmistakable Sofar energy - the kind that makes you feel like you&rsquo;ve stumbled into something secret and special.&nbsp; &nbsp; Then, as the sun dips and the skyline glows, we roll straight into our movie. &nbsp; Rooftop Cinema Club is an 18+ venue after 5pm. &nbsp; Sofar Sounds shows are intimate, listening-focused experiences &nbsp;- this gig will be served to you via our state of the art headphones.&nbsp;\",            \"typicalAgeRange\": \"18+\",    \"audience\": {        \"@type\": \"Audience\",        \"audienceType\": \"18+\"    },                    \"image\": {        \"@type\": \"ImageObject\",        \"url\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/126e8435-5615-4ddf-803e-688cf03f487c/Sofar-almost-famous.png\",        \"width\": 1920,        \"height\": 1080    },            \"workFeatured\": {        \"@type\": \"Movie\",        \"name\": \"Almost Famous x Sofar Sounds\",                \"image\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/126e8435-5615-4ddf-803e-688cf03f487c/Sofar-almost-famous.png\",        \"duration\": \"PT155M\",        \"dateCreated\": \"2000\"    },            \"location\": {        \"@type\": \"MovieTheater\",        \"@id\": \"https://rooftopcinemaclub.com/uk/london/peckham#venue\",        \"name\": \"Peckham, London\",        \"address\": {            \"@type\": \"PostalAddress\",            \"streetAddress\": \"133 R