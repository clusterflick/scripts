font-bold text-brand-navy uppercase tracking-wide mb-1\">Duration</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">125 Minutes</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        \n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Door Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">60 mins</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n        \n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Date</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Fri, Aug 21</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">6:20 PM</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Year</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">2000</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n    </div>\n\n    <div class=\"rounded-2xl p-10 text-brand-navy/80\">\n        \n    </div>\n\n    <div class=\"mt-8\">\n\n        <div class=\"md:hidden relative\">\n            <div class=\"relative\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_400,h_300,c_fill,g_xy_center,x_800,y_450,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/f8d3595b-9be1-41bc-88a5-11676ed5e6f1/23weekend-watch-loveandbasketball-videoSixteenByNineJumbo1600.jpeg\" alt=\"Peckham, London outdoor screening of 23weekend-watch-loveandbasketball-videoSixteenByNineJumbo1600.jpeg in London\" class=\"w-[45%] aspect-[4/3] object-cover rounded-xl relative z-10 -ml-4 shadow-lg\">\n                \n                \n                \n            </div>\n\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-5 pt-10 -mt-6 relative z-0\">\n                <div class=\"prose prose-invert prose-sm leading-relaxed max-w-none\">\n                    ALL’S FAIR IN LOVE AND BASKETBALL.\n\nQuincy McCall and Monica Wright grew up in the same neighborhood and have known each other since childhood. As they grow into adulthood, they fall in love, but they also share another all-consuming passion: basketball. As Quincy and Monica struggle to make their relationship work, they follow separate career paths though high school and college basketball and, they hope, into stardom in big-league professional ball.\n                </div>\n            </div>\n            \n        </div>\n\n        <div class=\"hidden md:flex relative flex-row items-center gap-0 min-h-[350px]\">\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-10 w-1/2 z-10 relative -mr-12 shadow-2xl\">\n                <div class=\"prose prose-invert prose-lg leading-relaxed max-w-none\">\n                    ALL’S FAIR IN LOVE AND BASKETBALL.\n\nQuincy McCall and Monica Wright grew up in the same neighborhood and have known each other since childhood. As they grow into adulthood, they fall in love, but they also share another all-consuming passion: basketball. As Quincy and Monica struggle to make their relationship work, they follow separate career paths though high school and college basketball and, they hope, into stardom in big-league professional ball.\n                </div>\n            </div>\n            \n\n            <div class=\"w-1/2 z-0\">\n                \n                \n                \n                <img src=\"htt