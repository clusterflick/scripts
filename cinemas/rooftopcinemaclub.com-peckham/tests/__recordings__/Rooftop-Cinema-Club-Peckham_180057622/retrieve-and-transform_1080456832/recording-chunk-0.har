          "content": {
            "mimeType": "text/html; charset=utf-8",
            "text": "<!doctype html>\n<html class=\"scroll-smooth antialiased\" lang=\"en\">\n    <head>\n        <meta charset=\"utf-8\">\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n        <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"theme-color\" content=\"#E95D40\">\n        \n        \n        <title>Before Sunrise at Peckham, London &mdash; August 31, 2026 | Rooftop Cinema Club</title>\n<meta name=\"description\" content=\"Watch Before Sunrise at Peckham, London on August 31, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:title\" content=\"Before Sunrise at Peckham, London &mdash; August 31, 2026\" />\n<meta property=\"og:description\" content=\"Watch Before Sunrise at Peckham, London on August 31, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:url\" content=\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/before-sunrise-2881\" />\n<meta property=\"og:site_name\" content=\"Rooftop Cinema Club\" />\n<meta property=\"og:locale\" content=\"en_GB\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"Before Sunrise at Peckham, London &mdash; August 31, 2026\" />\n<meta name=\"twitter:description\" content=\"Watch Before Sunrise at Peckham, London on August 31, 2026. Outdoor rooftop cinema in London.\" />\n<link href=\"https://rooftopcinemaclub.com/uk\" rel=\"home\" />\n<link href=\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/before-sunrise-2881\" rel=\"canonical\" />\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Global Home\",\"item\":\"https://rooftopcinemaclub.com/uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"London\",\"item\":\"https://rooftopcinemaclub.com/uk/london\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Peckham, London\",\"item\":\"https://rooftopcinemaclub.com/uk/london/peckham\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Before Sunrise\",\"item\":\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/before-sunrise-2881\"}]}</script>\n<script type=\"application/ld+json\">{    \"@context\": \"https://schema.org\",    \"@type\": \"ScreeningEvent\",    \"@id\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/before-sunrise-2881#event\",    \"name\": \"Before Sunrise\",    \"url\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/before-sunrise-2881\",    \"startDate\": \"2026-08-31T18:15:00+00:00\",            \"endDate\": \"2026-08-31T19:56:00+00:00\",            \"eventStatus\": \"https://schema.org/EventScheduled\",    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",    \"inLanguage\": \"en-GB\",    \"isAccessibleForFree\": false,    \"offers\": {        \"@type\": \"Offer\",        \"url\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/before-sunrise-2881\",        \"availability\": \"https://schema.org/InStock\"    },        \"description\": \"Before Sunrise: The Last Day of Summer &nbsp; Some conversations stay with you forever. &nbsp; Join us on the final official day of summer for a special rooftop screening of Before Sunrise, Richard Linklater's beloved romance about chance encounters, missed opportunities and the people who change us in a single evening. &nbsp; As daylight fades and the city lights begin to glow, follow Jesse and C&eacute;line through the streets of Vienna in a film that captures the fleeting magic of summer better than almost any other. Thoughtful, romantic and endlessly rewatchable, Before Sunrise feels made for a warm evening under the stars. &nbsp; Whether you're bringing a date, a friend or simply spending the evening with your own thoughts, this is the perfect way to close out the season. &nbsp; One last sunset. One unforgettable film. One final summer night on the rooftop.\",            \"typicalAgeRange\": \"18+\",    \"audience\": {        \"@type\": \"Audience\",        \"audienceType\": \"18+\"    },                    \"image\": {        \"@type\": \"ImageObject\",        \"url\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_139,y_91,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/5d927eb3-d9d3-46cb-ba08-bbfca0c82ba7/before.jpeg\",        \"width\": 1920,        \"height\": 1080    },            \"workFeatured\": {        \"@type\": \"Movie\",        \"name\": \"Before Sunrise\",                \"image\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_139,y_91,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/5d927eb3-d9d3-46cb-ba08-bbfca0c82ba7/before.jpeg\",        \"duration\": \"PT101M\",        \"dateCreated\": \"1995\"    },            \"location\": {        \"@type\": \"MovieTheater\",        \"@id\": \"https://rooftopcinemaclub.com/uk/london/peckham#venue\",        \"name\": \"Peckham, London\",        \"address\": {            \"@type\": \"PostalAddress\",            \"streetAddress\": \"133 Rye Lane\",            \"postalCode\": \"SE15 4ST\",            \"addressLocality\": \"London\",            \"addressCountry\": \"GB\"        },        \"geo\": {            \"@type\": \"GeoCoordinates\",            \"latitude\": 51.4699171,            \"longitude\": -0.0675244        }    },        \"organizer\": {        \"@type\": \"Organization\",        \"@