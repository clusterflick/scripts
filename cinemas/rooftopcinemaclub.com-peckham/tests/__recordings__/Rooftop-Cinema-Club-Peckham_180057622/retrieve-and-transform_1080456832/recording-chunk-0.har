            "mimeType": "text/html; charset=utf-8",
            "text": "<!doctype html>\n<html class=\"scroll-smooth antialiased\" lang=\"en\">\n    <head>\n        <meta charset=\"utf-8\">\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n        <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"theme-color\" content=\"#E95D40\">\n        \n        \n        <title>Trainspotting x Sofar Sounds at Peckham, London &mdash; September 3, 2026 | Rooftop Cinema Club</title>\n<meta name=\"description\" content=\"Watch Trainspotting x Sofar Sounds at Peckham, London on September 3, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:title\" content=\"Trainspotting x Sofar Sounds at Peckham, London &mdash; September 3, 2026\" />\n<meta property=\"og:description\" content=\"Watch Trainspotting x Sofar Sounds at Peckham, London on September 3, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:url\" content=\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/trainspotting-x-sofar-sounds-3036\" />\n<meta property=\"og:site_name\" content=\"Rooftop Cinema Club\" />\n<meta property=\"og:locale\" content=\"en_GB\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"Trainspotting x Sofar Sounds at Peckham, London &mdash; September 3, 2026\" />\n<meta name=\"twitter:description\" content=\"Watch Trainspotting x Sofar Sounds at Peckham, London on September 3, 2026. Outdoor rooftop cinema in London.\" />\n<link href=\"https://rooftopcinemaclub.com/uk\" rel=\"home\" />\n<link href=\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/trainspotting-x-sofar-sounds-3036\" rel=\"canonical\" />\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Global Home\",\"item\":\"https://rooftopcinemaclub.com/uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"London\",\"item\":\"https://rooftopcinemaclub.com/uk/london\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Peckham, London\",\"item\":\"https://rooftopcinemaclub.com/uk/london/peckham\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Trainspotting x Sofar Sounds\",\"item\":\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/trainspotting-x-sofar-sounds-3036\"}]}</script>\n<script type=\"application/ld+json\">{    \"@context\": \"https://schema.org\",    \"@type\": \"ScreeningEvent\",    \"@id\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/trainspotting-x-sofar-sounds-3036#event\",    \"name\": \"Trainspotting x Sofar Sounds\",    \"url\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/trainspotting-x-sofar-sounds-3036\",    \"startDate\": \"2026-09-03T19:00:00+00:00\",            \"endDate\": \"2026-09-03T21:20:00+00:00\",            \"eventStatus\": \"https://schema.org/EventScheduled\",    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",    \"inLanguage\": \"en-GB\",    \"isAccessibleForFree\": false,    \"offers\": {        \"@type\": \"Offer\",        \"url\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/trainspotting-x-sofar-sounds-3036\",        \"availability\": \"https://schema.org/InStock\"    },        \"description\": \"A very special screening of Trainspotting in partnership with Sofar Sounds, featuring a live performance inspired by the film's iconic soundtrack of indie, Britpop and alternative rock. &nbsp; &nbsp; This isn't just a screening. Before the film begins, as golden hour settles over Peckham, we're handing the rooftop over to the incredible team at Sofar Sounds for an intimate live set beneath the skyline. &nbsp; &nbsp; Expect stripped-back performances inspired by the rebellious spirit and unforgettable soundtrack of this cult classic, alongside emerging artists and the unmistakable Sofar atmosphere &ndash; the kind that makes you feel like you've discovered something secret and special. &nbsp; &nbsp; Then, as the sun sets and the city lights begin to glow, we'll roll straight into Danny Boyle's iconic masterpiece. &nbsp; &nbsp; Rooftop Cinema Club is an 18+ venue after 5pm. &nbsp; &nbsp; Sofar Sounds shows are intimate, listening-focused experiences - this performance will be enjoyed through our state-of-the-art wireless headphones.\",            \"typicalAgeRange\": \"18+\",    \"audience\": {        \"@type\": \"Audience\",        \"audienceType\": \"18+\"    },                    \"image\": {        \"@type\": \"ImageObject\",        \"url\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_1920,y_1080,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/1dc26a13-1817-4e1f-bf02-cf450eab4bea/trainspotting-sofar-collab-uk.png\",        \"width\": 1920,        \"height\": 1080    },            \"workFeatured\": {        \"@type\": \"Movie\",        \"name\": \"Trainspotting x Sofar Sounds\",                \"image\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_1920,y_1080,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/1dc26a13-1817-4e1f-bf02-cf450eab4bea/trainspotting-sofar-collab-uk.png\",        \"duration\": \"PT140M\",        \"dateCreated\": \"1996\"    },            \"location\": {        \"@type\": \"MovieTheater\",        \"@id\": \"https://rooftopcinemaclub.com/uk/london/peckham#venue\",        \"name\": \"Peckham, London\",        \"address\":