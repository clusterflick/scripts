            "text": "\n    \n    <div class=\"screening-group mb-12 md:mb-16\">\n        <div class=\"mb-8\">\n            <h2 class=\"text-base md:text-lg font-bold text-brand-navy uppercase shrink-0 pb-3\">SUN, SEP 6</h2>\n            <hr class=\"border-brand-navy\">\n        </div>\n\n        <div class=\"space-y-14\">\n            \n            <div class=\"screening-card grid grid-cols-[10rem_1fr] md:grid-cols-[1fr_2fr_1fr] gap-x-4 gap-y-3 md:gap-6\">\n\n                <div class=\"col-start-1 row-start-1 md:row-span-2 space-y-2\">\n                    <div class=\"relative rounded-lg overflow-hidden aspect-[4/3] bg-brand-paleblue\">\n                        \n                        <img alt=\"Inception\" class=\"w-full h-full object-cover\" src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_600,h_450,c_fill,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/f3f1d15c-9296-4c09-8c11-bc7be4158d96/inception.jpg\">\n                        \n                        \n                        \n                    </div>\n                    <div class=\"space-y-1\">\n                        \n                        \n                        \n                        \n                    </div>\n                </div>\n\n                <div class=\"col-start-2 row-start-1 md:row-span-2\">\n                    <h3 class=\"text-sm md:text-lg text-brand-navy uppercase leading-tight mb-2\"><a href=\"/uk/london/peckham/screenings/inception-2891\" class=\"hover:underline\">Inception</a></h3>\n\n                    <div class=\"flex flex-wrap items-center gap-x-3 gap-y-1 mb-2 text-brand-navy/80\">\n                        <div class=\"flex items-center gap-1.5 text-xs font-medium\">\n                            <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/>\n                            </svg>\n                            <span>Sun, Sep 6</span>\n                        </div>\n                        \n                        <div class=\"flex items-center gap-1.5 text-xs font-medium\">\n                            <svg class=\"w-3.5 h-3.5 shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" viewBox=\"0 0 24 24\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3\"/>\n                            </svg>\n                            <span>Doors open at <span>4:00 PM</span></span>\n                        </div>\n                        \n                        \n                        <div class=\"flex items-center gap-1.5 text-xs font-medium\">\n                            <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z\"/>\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 11a3 3 0 11-6 0 3 3 0 016 0z\"/>\n                            </svg>\n                            <span>Peckham, London</span>\n                        </div>\n                        \n                    </div>\n\n                    \n                    <p class=\"text-xs md:text-sm text-brand-navy/70 italic line-clamp-1 mb-3\">A thief, who steals corporate secrets through use of dream-sharing technology, is given the inverse task of planting an idea into the mind of a CEO.</p>\n                    \n\n                    <button data-screening-details=\"d4898094-600f-4c07-bdaf-a74a5b2298c4\" class=\"inline-flex items-center gap-2 py-2 border-b border-brand-navy/40 cursor-pointer\">\n                        <span class=\"text-sm md:text-base text-brand-navy\">More Details</span>\n                        <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"none\" viewBox=\"0 0 32 32\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path d=\"M26.667 21.333C29.6124 21.3332 32 23.7216 32 26.667C31.9998 29.6123 29.6123 31.9998 26.667 32H5.33301C2.38774 31.9998 0.000173164 29.6123 0 26.667C0 23.7216 2.38764 21.3332 5.33301 21.333C2.38764 21.3328 0 18.9454 0 16C2.57701e-06 13.0546 2.38764 10.6672 5.33301 10.667C2.38764 10.6668 0 8.27842 0 5.33301C0.000178318 2.38775 2.38775 0.000178659 5.33301 0H26.667C29.6123 0.000176597 31.9998 2.38775 32 5.33301C32 8.27842 29.6124 10.6668 26.667 10.667C29.6124 10.6672 32 13.0546 32 16C32 18.9454 29.6124 21.3328 26.667 21.333Z\" fill=\"#5C9AC6\"/>\n                            <path d=\"M10.5 16H21.5\" stroke=\"#F9F4EE\" stroke-linecap=\"round\" stroke-width=\"2\"/>\n                            <path d=\"M16 10.5V21.5\" stroke=\"#F9F4EE\" stroke-linecap=\"round\" stroke-width=\"2\"/>\n                        </svg>\n                    </button>\n                </div>\n\n                <div class=\"col-span-2 md:col-span-1 md:col-start-3 md:row-start-1 md:row-span-2 flex items-start\">\n                    \n                    <button data-checkout-screening=\"d4898094-600f-4c07-bdaf-a74a5b2298c4\" class=\"flex items-center justify-between w-full px-5 py-3 md:py-2.5 bg-brand-navy text-brand-white text-sm font-bold rounded-full hover:bg-brand-navy/90 transition-colors cursor-pointer\">\n                        <span>BOOK</span>\n                        <span class=\"flex items-center gap-1.5 text-xs font-normal ml-4\">\n                            <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n                            <span>4:45 PM</span>\n                        </span>\n                    </button>\n                    \n                </div>\n            </div>\n            \n        </div>\n    </div>\n    \n    <div class=\"screening-group mb-12 md:mb-16\">\n        <div class=\"mb-8\">\n            <h2 class=\"text-base md:text-lg font-bold text-brand-navy uppercase shrink-0 pb-3\">FRI, SEP 18</h2>\n            <hr class=\"border-brand-navy\">\n        </div>\n\n        <div class=\"space-y-14\">\n            \n            <div class=\"screening-card grid grid-cols-[10rem_1fr] md:grid-cols-[1fr_2fr_1fr] gap-x-4 gap-y-3 md:gap-6\">\n\n                <div class=\"col-start-1 row-start-1 md:row-span-2 space-y-2\">\n                    <div class=\"relative rounded-lg overflow-hidden aspect-[4/3] bg-brand-paleblue\">\n                        \n                        <img alt=\"Ghost in the Shell\" class=\"w-full h-full object-cover\" src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_600,h_450,c_fill,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/0dc2eae1-f39c-4ef3-b7e3-d63e090f5bad/MV5BNzljMjA3MTQtMjM1OS00OGJjLWJiYzctZDRiMTk1NWI5YzQ5XkEyXkFqcGc@._V1_SX300.jpg\">\n                        \n                        \n                        \n                        <div class=\"absolute bottom-2 right-2 md:bottom-3 md:right-3\">\n                            <div class=\"flex items-center justify-center text-center w-10 h-10 md:w-12 md:h-12 rounded-full bg-brand-lightbeige text-brand-navy\">\n                                <h3 class=\"text-lg md:text-xl leading-none\">18+</h3>\n                            </div>\n                        </div>\n                        \n                    </div>\n                    <div class=\"space-y-1\">\n                        \n                        \n                        <div class=\"text-center py-1 px-2 text-xs font-medium rounded text-brand-white\" style=\"background-color: #3A55C9\">Anime</div>\n                        \n                        \n                        \n                    </div>\n                </div>\n\n                <div class=\"col-start-2 row-start-1 md:row-span-2\">\n                    <h3 class=\"text-sm md:text-lg text-brand-navy uppercase leading-tight mb-2\"><a href=\"/uk/london/peckham/screenings/ghost-in-the-shell-3031\" class=\"hover:underline\">Ghost in the Shell</a></h3>\n\n                    <div class=\"flex flex-wrap items-center gap-x-3 gap-y-1 mb-2 text-brand-navy/80\">\n                        <div class=\"flex items-center gap-1.5 text-xs font-medium\">\n                            <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/>\n                            </svg>\n                            <span>Fri, Sep 18</span>\n                        </div>\n                        \n                        <div class=\"flex items-center gap-1.5 text-xs font-medium\">\n                            <svg class=\"w-3.5 h-3.5 shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" viewBox=\"0 0 24 24\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3\"/>\n                            </svg>\n                            <span>Doors open at <span>5:15 PM</span></span>\n                        </div>\n                        \n                        \n                        <div class=\"flex items-center gap-1.5 text-xs font-medium\">\n                            <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z\"/>\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 11a3 3 0 11-6 0 3 3 0 016 0z\"/>\n                            </svg>\n                            <span>Peckham, London</span>\n                        </div>\n                        \n                    </div>\n\n                    \n                    <p class=\"text-xs md:text-sm text-brand-navy/70 italic line-clamp-1 mb-3\">A cyborg policewoman and her partner hunt a mysterious and powerful hacker called the Puppet Master.</p>\n                    \n\n                    <button data-screening-details=\"ef00aec5-53f0-4c05-bf02-2533781089b8\" class=\"inline-flex items-center gap-2 py-2 border-b border-brand-navy/40 cursor-pointer\">\n                        <span class=\"text-sm md:text-base text-brand-navy\">More Details</span>\n                        <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"none\" viewBox=\"0 0 32 32\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path d=\"M26.667 21.333C29.6124 21.3332 32 23.7216 32 26.667C31.9998 29.6123 29.6123 31.9998 26.667 32H5.33301C2.38774 31.9998 0.000173164 29.6123 0 26.667C0 23.7216 2.38764 21.3332 5.33301 21.333C2.38764 21.3328 0 18.9454 0 16C2.57701e-06 13.0546 2.38764 10.6672 5.33301 10.667C2.38764 10.6668 0 8.27842 0 5.33301C0.000178318 2.38775 2.38775 0.000178659 5.33301 0H26.667C29.6123 0.000176597 31.9998 2.38775 32 5.33301C32 8.27842 29.6124 10.6668 26.667 10.667C29.6124 10.6672 32 13.0546 32 16C32 18.9454 29.6124 21.3328 26.667 21.333Z\" fill=\"#5C9AC6\"/>\n                            <path d=\"M10.5 16H21.5\" stroke=\"#F9F4EE\" stroke-linecap=\"round\" stroke-width=\"2\"/>\n                            <path d=\"M16 10.5V21.5\" stroke=\"#F9F4EE\" stroke-linecap=\"round\" stroke-width=\"2\"/>\n                        </svg>\n                    </button>\n                </div>\n\n                <div class=\"col-span-2 md:col-span-1 md:col-start-3 md:row-start-1 md:row-span-2 flex items-start\">\n                    \n                    <button data-checkout-screening=\"ef00aec5-53f0-4c05-bf02-2533781089b8\" class=\"flex items-center justify-between w-full px-5 py-3 md:py-2.5 bg-brand-navy text-brand-white text-sm font-bold rounded-full hover:bg-brand-navy/90 transition-colors cursor-pointer\">\n                        <span>BOOK</span>\n                        <span class=\"flex items-center gap-1.5 text-xs font-normal ml-4\">\n                            <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n                            <span>6:15 PM</span>\n                        </span>\n                    </button>\n                    \n                </div>\n            </div>\n            \n        </div>\n    </div>\n    \n\n    \n\n",
