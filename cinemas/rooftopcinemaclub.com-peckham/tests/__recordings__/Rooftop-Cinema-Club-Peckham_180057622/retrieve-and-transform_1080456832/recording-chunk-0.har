          "content": {
            "mimeType": "text/html; charset=utf-8",
            "text": "<!doctype html>\n<html class=\"scroll-smooth antialiased\" lang=\"en\">\n    <head>\n        <meta charset=\"utf-8\">\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n        <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"theme-color\" content=\"#E95D40\">\n        \n        \n        <title>Princess Diaries Bedazzle Club at Peckham, London &mdash; August 30, 2026 | Rooftop Cinema Club</title>\n<meta name=\"description\" content=\"Watch Princess Diaries Bedazzle Club at Peckham, London on August 30, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:title\" content=\"Princess Diaries Bedazzle Club at Peckham, London &mdash; August 30, 2026\" />\n<meta property=\"og:description\" content=\"Watch Princess Diaries Bedazzle Club at Peckham, London on August 30, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:url\" content=\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/princess-diaries-bedazzle-club-3052\" />\n<meta property=\"og:site_name\" content=\"Rooftop Cinema Club\" />\n<meta property=\"og:locale\" content=\"en_GB\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"Princess Diaries Bedazzle Club at Peckham, London &mdash; August 30, 2026\" />\n<meta name=\"twitter:description\" content=\"Watch Princess Diaries Bedazzle Club at Peckham, London on August 30, 2026. Outdoor rooftop cinema in London.\" />\n<link href=\"https://rooftopcinemaclub.com/uk\" rel=\"home\" />\n<link href=\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/princess-diaries-bedazzle-club-3052\" rel=\"canonical\" />\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Global Home\",\"item\":\"https://rooftopcinemaclub.com/uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"London\",\"item\":\"https://rooftopcinemaclub.com/uk/london\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Peckham, London\",\"item\":\"https://rooftopcinemaclub.com/uk/london/peckham\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Princess Diaries Bedazzle Club\",\"item\":\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/princess-diaries-bedazzle-club-3052\"}]}</script>\n<script type=\"application/ld+json\">{    \"@context\": \"https://schema.org\",    \"@type\": \"ScreeningEvent\",    \"@id\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/princess-diaries-bedazzle-club-3052#event\",    \"name\": \"Princess Diaries Bedazzle Club\",    \"url\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/princess-diaries-bedazzle-club-3052\",    \"startDate\": \"2026-08-30T19:00:00+00:00\",            \"endDate\": \"2026-08-30T22:25:00+00:00\",            \"eventStatus\": \"https://schema.org/EventScheduled\",    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",    \"inLanguage\": \"en-GB\",    \"isAccessibleForFree\": false,    \"offers\": {        \"@type\": \"Offer\",        \"url\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/princess-diaries-bedazzle-club-3052\",        \"availability\": \"https://schema.org/SoldOut\"    },        \"description\": \"A royal makeover is calling. ✨ &nbsp; Before we press play on The Princess Diaries, join us for a sparkling bedazzling workshop inspired by Mia Thermopolis' iconic transformation. PLEASE NOTE - for those purchasing the workshop ticket - the start time for this is 7pm, and the screening of The Princess Diaries will begin at 8:30pm. &nbsp; We'll bring the rhinestones, glue and all the expertise you need to create your perfect Y2K masterpiece. You bring the canvas - whether that's a denim jacket, tote bag, baseball cap, trainers or even a tiara fit for Genovia. &nbsp; Leading the workshop is Fen Fitzgerald, a multidisciplinary creative maker with a degree in Textile Design specialising in hand embroidery and embellishment. Fen has worked on the costumes for Academy Award-winning films Wicked and Wicked: For Good, as well as 28 Years Later, and has collaborated with Arsenal WFC, Hackney Pride Fayre and Queer Creatives London. Alongside her work in film and fashion, Fen runs creative workshops teaching embellishment, embroidery and clothing mending.&nbsp; &nbsp; Come ready to add some sparkle, channel your inner princess and create something fit for royalty before enjoying The Princess Diaries under the stars. 👑💎\",            \"typicalAgeRange\": \"18+\",    \"audience\": {        \"@type\": \"Audience\",        \"audienceType\": \"18+\"    },                    \"image\": {        \"@type\": \"ImageObject\",        \"url\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/3d2a1e4f-f404-4292-a429-3513cb55db40/Charm-School-Hero.jpg\",        \"width\": 1920,        \"height\": 1080    },            \"workFeatured\": {        \"@type\": \"Movie\",        \"name\": \"Princess Diaries Bedazzle Club\",                \"image\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/3d2a1e4f-f404-4292-a429-3513cb55db40/Charm-School-Hero.jpg\",        \"duration\": \"PT205M\"    },            \"location\": {        \"@type\": \"MovieTheater\",        \"@id\": \"https://rooftopcinemaclub.com/uk/london/peckham#venue\",        \"name\": \"Peckham, London\",        \"address\": {            \"@type\": \"PostalAddress\",            \"streetAddress\": \"133 Rye Lane\",            \"postalCode\": \"SE15 4ST\",            \"addressLocality\": \"London\",            \"addressCountry\": \"GB\"        },        \"geo\": {            \"@type\": \"GeoCoordinates\",            \"latitude\": 51.4699171,            \"longitude\": -0.0675244        }    },        \"organizer\": {        \"@type\": \"Organization\",        \"@id\": \"https://rooftopcinemaclub.com/#organization\",        \"name\": \"Rooftop Cinema Club\",        \"url\": \"https://rooftopcinemaclub.com\"    },    \"performer\": {        \"@type\": \"Organization\",        \"@id\": \"https://rooftopcinemaclub.com/#organization\",        \"name\": \"Rooftop Cinema Club\",        \"url\": \"https://rooftopcinemaclub.com\"    }}</script>\n        <script type=\"application/ld+json\">\n        {\n            \"@context\": \"https://schema.org\",\n            \"@graph\": [\n                {\n                    \"@type\": \"Organization\",\n                    \"@id\": \"https://rooftopcinemaclub.com/#organization\",\n                    \"name\": \"Rooftop Cinema Club\",\n                    \"url\": \"https://rooftopcinemaclub.com\",\n                    \"logo\": {\n                        \"@type\": \"ImageObject\",\n                        \"url\": \"https://rooftopcinemaclub.com/images/Rooftop_Cinema_Logo_Cream.svg\",\n                        \"width\": 1600,\n                        \"height\": 450\n                    },\n                    \"sameAs\": [\n                        \"https://www.instagram.com/rooftopcinemaclub/\",\n                        \"https://www.facebook.com/RooftopCinemaClub/\",\n                        \"https://www.tiktok.com/@rooftopcinemaclub\",\n                        \"https://twitter.com/rooftopcinema\"\n              