          "content": {
            "mimeType": "application/json",
            "text": "{\"id\":\"535c43ff-e0a3-4001-932f-882889a195de\",\"title\":\"Sinners x Sofar Sounds\",\"url\":\"\\/uk\\/london\\/peckham\\/screenings\\/sinners-x-sofar-sounds-2796\",\"date\":\"Thu, Jul 23\",\"time\":\"8:15 PM\",\"door_time\":\"7:30 PM\",\"minimum_age\":18,\"short_description\":\"In partnership with Sofar Sounds\",\"long_description\":\"<p>A very special screening: SINNERS in partnership with Sofar Sounds Live Music<\\/p>\\n<p>&nbsp;<\\/p>\\n<p>This isn&rsquo;t just a screening. Before the film begins, we&rsquo;re handing the rooftop over to the magical team at Sofar Sounds for an intimate live set as the sun sets over Peckham.<\\/p>\\n<p>&nbsp;<\\/p>\\n<p>Expect a stripped back set, inspired by the musical roots at the heart of Sinners,&nbsp;and that unmistakable Sofar energy - the kind that makes you feel like you&rsquo;ve stumbled into something secret and special.<\\/p>\\n<p>&nbsp;<\\/p>\\n<p>Then, as the sun dips and the skyline glows, we roll straight into our movie..<\\/p>\\n<p>&nbsp;<\\/p>\\n<p>Join us atop Peckham&rsquo;s iconic Bussey Building for a night that blends live music and cinema the way it should be experienced: together.<\\/p>\\n<p>&nbsp;<\\/p>\\n<p>Please check door times carefully - the live music will begin promptly before the film, and we recommend arriving early to grab a drink, treat yourself to a slice of fresh pizza and settle in.<\\/p>\",\"image_url\":\"https:\\/\\/res.cloudinary.com\\/dpgypjrov\\/image\\/fetch\\/f_auto,w_600,h_450,c_fill,q_auto\\/https:\\/\\/d31ni94nh7toh0.cloudfront.net\\/PRODUCTION\\/films\\/6fd32ab5-2a5f-4100-ae69-a5a856d6f08f\\/Sofar-Sinners.png\",\"venue_title\":\"Peckham, London\",\"collections\":[{\"title\":\"Music\",\"bg_color\":\"#FF84DA\"}],\"seasons\":[],\"tags\":[{\"title\":\"Event\"},{\"title\":\"Alternative Events\"}],\"accessibility\":[],\"sold_out\":true}",
