            "text": "<!doctype html>\n<html class=\"scroll-smooth antialiased\" lang=\"en\">\n    <head>\n        <meta charset=\"utf-8\">\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n        <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"theme-color\" content=\"#E95D40\">\n        \n        \n        <title>101 Dalmatians at Peckham, London &mdash; August 16, 2026 | Rooftop Cinema Club</title>\n<meta name=\"description\" content=\"Watch 101 Dalmatians at Peckham, London on August 16, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:title\" content=\"101 Dalmatians at Peckham, London &mdash; August 16, 2026\" />\n<meta property=\"og:description\" content=\"Watch 101 Dalmatians at Peckham, London on August 16, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:url\" content=\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/101-dalmatians-2848\" />\n<meta property=\"og:site_name\" content=\"Rooftop Cinema Club\" />\n<meta property=\"og:locale\" content=\"en_GB\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"101 Dalmatians at Peckham, London &mdash; August 16, 2026\" />\n<meta name=\"twitter:description\" content=\"Watch 101 Dalmatians at Peckham, London on August 16, 2026. Outdoor rooftop cinema in London.\" />\n<link href=\"https://rooftopcinemaclub.com/uk\" rel=\"home\" />\n<link href=\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/101-dalmatians-2848\" rel=\"canonical\" />\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Global Home\",\"item\":\"https://rooftopcinemaclub.com/uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"London\",\"item\":\"https://rooftopcinemaclub.com/uk/london\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Peckham, London\",\"item\":\"https://rooftopcinemaclub.com/uk/london/peckham\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"101 Dalmatians\",\"item\":\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/101-dalmatians-2848\"}]}</script>\n<script type=\"application/ld+json\">{    \"@context\": \"https://schema.org\",    \"@type\": \"ScreeningEvent\",    \"@id\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/101-dalmatians-2848#event\",    \"name\": \"101 Dalmatians\",    \"url\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/101-dalmatians-2848\",    \"startDate\": \"2026-08-16T16:15:00+00:00\",            \"endDate\": \"2026-08-16T17:58:00+00:00\",            \"eventStatus\": \"https://schema.org/EventScheduled\",    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",    \"inLanguage\": \"en-GB\",    \"isAccessibleForFree\": false,    \"offers\": {        \"@type\": \"Offer\",        \"url\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/101-dalmatians-2848\",        \"availability\": \"https://schema.org/InStock\"    },        \"description\": \"We&rsquo;re turning the rooftop black and white to celebrate the 30th anniversary of the 1996 live-action remake of 101 Dalmations. &nbsp; We&rsquo;ve joined forces with the paw-some team at POP+BARK for a special woof-top Dalmatian meet-up and screening. &nbsp; Get your nostalgic Disney fix and bring your spotty best friend, with tasty dog popcorn, Pupuccinos and dog biscuits for your dog to enjoy, as well as delicious pizza and drinks from Bussey Rooftop Bar for the humans. &nbsp; Don&rsquo;t have a dalmatian? Grab a Dog Lovers ticket. Got another breed? We'll be hosting a screening of Best in Show with a dog meet-up early afternoon the same day, which is open for all breeds, with the same delicious doggy treats.\",                        \"image\": {        \"@type\": \"ImageObject\",        \"url\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_1920,y_1080,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/5bd1d203-7891-47d4-839f-5a413e96ad33/101-dalmations.webp\",        \"width\": 1920,        \"height\": 1080    },            \"workFeatured\": {        \"@type\": \"Movie\",        \"name\": \"101 Dalmatians\",                \"image\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_1920,y_1080,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/5bd1d203-7891-47d4-839f-5a413e96ad33/101-dalmations.webp\",        \"duration\": \"PT103M\",        \"dateCreated\": \"1996\"    },            \"location\": {        \"@type\": \"MovieTheater\",        \"@id\": \"https://rooftopcinemaclub.com/uk/london/peckham#venue\",        \"name\": \"Peckham, London\",        \"address\": {            \"@type\": \"PostalAddress\",            \"streetAddress\": \"133 Rye Lane\",            \"postalCode\": \"SE15 4ST\",            \"addressLocality\": \"London\",            \"addressCountry\": \"GB\"        },        \"geo\": {            \"@type\": \"GeoCoordinates\",            \"latitude\": 51.4699171,            \"longitude\": -0.0675244        }    },        \"organizer\": {        \"@type\": \"Organization\",        \"@id\": \"https://rooftopcinemaclub.com/#organization\",        \"name\": \"Rooftop Cinema Club\",        \"url\": \"https://rooftopcinemaclub.com\"    },    \"performer\": {        \"@type\": \"Organization\",        \"@id\": \"https://rooftopcinemaclub.co