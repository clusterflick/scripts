ttom-[20%] md:bottom-[28%]\">\n        <div class=\"text-brand-white\">\n            <p class=\"text-xs md:text-lg mb-2 md:mb-3 flex items-center gap-2\">\n                Sun, Aug 30\n                <span class=\"text-brand-lavenderpink text-sm md:text-lg\">\n                    <svg width=\"19\" height=\"19\" viewBox=\"0 0 19 19\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M18.5929 12.0172L15.8036 9.5L18.5929 6.98282C19.4486 6.21064 18.8604 4.79245 17.7097 4.85021L13.9583 5.04173L14.1498 1.29028C14.2091 0.139614 12.7894 -0.44864 12.0172 0.407141L9.5 3.19641L6.98282 0.407141C6.21064 -0.44864 4.79245 0.139614 4.85021 1.29028L5.04173 5.04173L1.29028 4.85021C0.139614 4.79093 -0.44864 6.21064 0.407141 6.98282L3.19641 9.5L0.407141 12.0172C-0.44864 12.7894 0.139614 14.2076 1.29028 14.1498L5.04173 13.9583L4.85021 17.7097C4.79093 18.8604 6.21064 19.4486 6.98282 18.5929L9.5 15.8036L12.0172 18.5929C12.7894 19.4486 14.2076 18.8604 14.1498 17.7097L13.9583 13.9583L17.7097 14.1498C18.8604 14.2091 19.4486 12.7894 18.5929 12.0172Z\" fill=\"currentColor\"/>\n                    </svg>\n                </span>\n                7:00 PM\n            </p>\n\n            <h1 class=\"text-2xl md:text-5xl lg:text-6xl font-black uppercase leading-tight mb-3 md:mb-5 tracking-tight\">\n                Princess Diaries Bedazzle Club\n            </h1>\n\n            <div class=\"flex items-center gap-3 md:gap-5\">\n                \n<button data-waitlist-screening=\"5ca4a5ae-d6b1-472c-8768-e6b07e750e4f\" class=\"group/notify inline-flex items-center justify-center gap-2 rounded-full px-4 py-2 text-xs sm:px-5 sm:py-2.5 sm:text-sm md:px-6 md:py-2.5 md:text-[16px] font-bold bg-brand-lightbeige text-brand-navy border-2 border-brand-navy hover:bg-brand-red hover:text-brand-white hover:border-brand-red transition-colors cursor-pointer\">\n    <span>Notify Me</span>\n    <svg class=\"shrink-0 w-4 h-4 sm:w-5 sm:h-5\" viewBox=\"0 0 20 19\" fill=\"none\">\n        <path class=\"fill-brand-red group-hover/notify:fill-brand-white transition-colors\" d=\"M19.4132 11.9839L16.5008 9.47369L19.4132 6.96348C20.3067 6.19344 19.6925 4.77917 18.4911 4.83677L14.5741 5.02777L14.7741 1.28671C14.836 0.139227 13.3536 -0.447397 12.5474 0.406013L9.91914 3.18755L7.2909 0.406013C6.48465 -0.447397 5.00389 0.139227 5.0642 1.28671L5.26417 5.02777L1.34721 4.83677C0.145774 4.77766 -0.468434 6.19344 0.425104 6.96348L3.33743 9.47369L0.425104 11.9839C-0.468434 12.7539 0.145774 14.1682 1.34721 14.1106L5.26417 13.9196L5.0642 17.6607C5.0023 18.8081 6.48465 19.3948 7.2909 18.5414L9.91914 15.7598L12.5474 18.5414C13.3536 19.3948 14.8344 18.8081 14.7741 17.6607L14.5741 13.9196L18.4911 14.1106C19.6925 14.1697 20.3067 12.7539 19.4132 11.9839Z\"/>\n        <path class=\"stroke-brand-white group-hover/notify:stroke-brand-navy transition-colors\" d=\"M5.92969 9.12109H13.2772\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        <path class=\"stroke-brand-white group-hover/notify:stroke-brand-navy transition-colors\" d=\"M10.3398 6.31641L13.2788 9.12342L10.3398 11.9304\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    </svg>\n</button>\n\n\n\n\n                \n                \n                \n            </div>\n\n            \n            <div class=\"flex flex-wrap gap-2 mt-4\">\n                \n                \n                \n                <span class=\"px-2 py-1 text-xs font-medium rounded bg-brand-red text-brand-white\">Sold Out</span>\n\n                \n            </div>\n            \n        </div>\n    </div>\n\n    <div class=\"absolute bottom-0 right-0 z-10 px-6 lg:px-12 pb-8 flex flex-col items-end gap-2\">\n        \n        <div class=\"flex items-center justify-center text-center w-12 h-12 rounded-full bg-brand-lightbeige text-brand-navy\">\n            <h3 class=\"text-xl leading-none\">18+</h3>\n        </div>\n        \n\n        \n\n        \n        <div class=\"flex flex-wrap gap-1 justify-end\">\n            \n            <span class=\"px-2 py-1 text-xs rounded bg-white text-brand-navy font-medium\">\n            Girls Gone Mild\n        </span>\n            \n            <span class=\"px-2 py-1 text-xs rounded bg-white text-brand-navy font-medium\">\n            Event\n        </span>\n            \n        </div>\n        \n    </div>\n</section>\n\n<section class=\"w-[90%] bg-brand-honey rounded-lg py-16 px-12 mx-auto space-y-12 my-16\">\n    <h2 class=\"text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-brand-navy leading-tight\">\n        Screening Details\n    </h2>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-6 md:gap-y-10 mb-20 px-0 md:px-8\">\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Film</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\"><a href=\"/uk/films/bedazzle-club\" class=\"underline\">Princess Diaries Bedazzle Club</a></div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Venue</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\"><a href=\"/uk/london/peckham\" class=\"underline\">Peckham, London</a></div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Screen</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Screen 1</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Duration</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">205 Minutes</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        \n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Door Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">30 mins</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n        \n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Date</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Sun, Aug 30</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">7:00 PM</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Year</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\"></div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n    </div>\n\n    <div class=\"rounded-2xl p-10 text-brand-navy/80\">\n        <p>A royal makeover is calling. ✨</p>\n<p>&nbsp;</p>\n<p>Before we press play on The Princess Diaries, join us for a sparkling bedazzling workshop inspired by Mia Thermopolis' iconic transformation. PLEASE NOTE - for those purchasing the workshop ticket - the start time for this is 7pm, and the screening of The Princess Diaries will begin at 8:30pm.</p>\n<p>&nbsp;</p>\n<p>We'll bring the rhinestones, glue and all the expertise you need to create your perfect Y2K masterpiece. You bring the canvas - whether that's a denim jacket, tote bag, baseball cap, trainers or even a tiara fit for Genovia.</p>\n<p>&nbsp;</p>\n<p>Leading the workshop is Fen Fitzgerald, a multidisciplinary creative maker with a degree in Textile Design specialising in hand embroidery and embellishment. Fen has worked on the costumes for Academy Award-winning films Wicked and Wicked: For Good, as well as 28 Years Later, and has collaborated with Arsenal WFC, Hackney Pride Fayre and Queer Creatives London. Alongside her work in film and fashion, Fen runs creative workshops teaching embellishment, embroidery and clothing mending.&nbsp;</p>\n<p>&nbsp;</p>\n<p>Come ready to add some sparkle, channel your inner princess and create something fit for royalty before enjoying The Princess Diaries under the stars. 👑💎</p>\n    </div>\n\n    <div class=\"mt-8\">\n\n        <div class=\"md:hidden relative\">\n            <div class=\"relative\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_400,h_300,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/3d2a1e4f-f404-4292-a429-3513cb55db40/Charm-School-Hero.jpg\" alt=\"Peckham, London outdoor screening of Charm-School-Hero.jpg in London\" class=\"w-[45%] aspect-[4/3] object-cover rounded-xl relative z-10 -ml-4 shadow-lg\">\n                \n                \n                \n            </div>\n\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-5 pt-10 -mt-6 relative z-0\">\n                <div class=\"prose prose-invert prose-sm leading-relaxed max-w-none\">\n                    <p>No outside food or drink allowed. This event is 18+ only. Tickets are not refundable.</p>\n                </div>\n            </div>\n            \n        </div>\n\n        <div class=\"hidden md:flex relative flex-row items-center gap-0 min-h-[350px]\">\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-10 w-1/2 z-10 relative -mr-12 shadow-2xl\">\n                <div class=\"prose prose-invert prose-lg leading-relaxed max-w-none\">\n                    <p>No outside food or drink allowed. This event is 18+ only. Tickets are not refundable.</p>\n                </div>\n            </div>\n            \n\n            <div class=\"w-1/2 z-0\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_900,h_450,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/3d2a1e4f-f404-4292-a429-3513cb55db40/Charm-School-Hero.jpg\" alt=\"Peckham, London outdoor screening of Charm-School-Hero.jpg in London\" class=\"w-full h-[450px] object-cover rounded-2xl shadow-inner\">\n                \n                \n                \n            </div>\n        </div>\n    </div>\n</section>\n\n\n\n\n</div>\n\n\n\n        </main>\n\n        <div id=\"tickets-checkout-root\"></div>\n        <div id=\"gift-card-checkout-root\"></div>\n\n        <div id=\"modals-root\"></div>\n\n        <footer class=\"w-full bg-brand-red text-brand-white px-4 md:px-12 py-12\">\n\n    <div class=\"flex flex-col gap-3 mb-12 items-start\">\n        \n            <div>\n                <div class=\"inline-flex justify-start items-center\">\n                    <a href=\"/uk/locations\">\n                        <img src=\"/images/Rooftop_Cinema_Logo_Cream.svg\" alt=\"Rooftop Cinema Club\" class=\"h-10 md:h-20\">\n                    </a>\n\n                    <div class=\"flex flex-col justify-start items-center gap-2 border-l border-l-white ml-4 pl-4\">\n                        <span class=\"text-white font-heading text-[10px] md:text-sm leading-none uppercase\">in partnership with</span>\n                        <svg class=\"w-28 md:w-32\" xml:space=\"preserve\" viewBox=\"0 0 1033.143 564.983\"><path fill=\"white\" d=\"m945.022 304.383-.004.004-4.762.004c-1.174 0-2.272.353-3.332 1.435-1.315 1.344-1.515 3.068-1.197 4.754 3.863 20.609 5.852 40.725 6.502 59.701h-59.77c-1.35 0-2.467.478-3.36 1.362-.94.93-1.521 2.114-1.52 4.058l.005 17.154c.002 3.414 2.352 5.32 5.