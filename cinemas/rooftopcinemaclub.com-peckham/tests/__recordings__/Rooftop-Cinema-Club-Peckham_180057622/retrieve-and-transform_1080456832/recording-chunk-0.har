          "content": {
            "mimeType": "application/json",
            "text": "{\"id\":\"78aa47d3-77fd-4963-979e-a6ada06349c1\",\"title\":\"First England World Cup Match\",\"url\":\"\\/uk\\/london\\/peckham\\/screenings\\/first-england-world-cup-match-2544\",\"date\":\"Wed, Jun 17\",\"time\":\"9:00 PM\",\"door_time\":\"8:15 PM\",\"minimum_age\":18,\"short_description\":\"The World Cup - England's First Group Game\",\"long_description\":\"<p>Watch England's first match on the big screen! Our state-of-the-art LED screen, theatre-style seating layout and skyline backdrop will make this the ultimate viewing experience!<\\/p>\\n<p>&nbsp;<\\/p>\\n<p>Come early and enjoy beers, cocktails and delicious Neapolitan stone baked pizza at our sister bar - Bussey Rooftop Bar!<\\/p>\\n<p>&nbsp;<\\/p>\\n<p>The full event schedule includes:<br>Cinema Doors Open: 8:30pm (bar from 5pm)<br>Kick Off: 9pm<br>Event will end when the game has finished.<\\/p>\\n<p>&nbsp;<\\/p>\\n<p>Seating availability will be limited and will be first come, first serve. Sound will be played out loud via speakers (as opposed to our usual headphones). No outside food or drink allowed. We highly encourage purchasing tickets in advance as space is limited.<\\/p>\",\"image_url\":\"https:\\/\\/res.cloudinary.com\\/dpgypjrov\\/image\\/fetch\\/f_auto,w_600,h_450,c_fill,q_80\\/https:\\/\\/d31ni94nh7toh0.cloudfront.net\\/PRODUCTION\\/films\\/4edbe02c-4852-49ff-93ff-68add9fddefb\\/WOLD-CUP-QUALIFIER.png\",\"venue_title\":\"Peckham, London\",\"collections\":[{\"title\":\"Sport\",\"bg_color\":\"#FF84DA\"}],\"seasons\":[],\"tags\":[{\"title\":\"Event\"}],\"accessibility\":[],\"sold_out\":true}",
            "size": 1493
          },
