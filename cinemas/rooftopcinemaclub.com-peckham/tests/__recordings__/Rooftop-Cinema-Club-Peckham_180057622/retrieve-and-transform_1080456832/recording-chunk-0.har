          "content": {
            "mimeType": "application/json",
            "text": "{\"id\":\"ba625d99-2904-482c-b7a9-753cbd52b2c9\",\"title\":\"SEMI FINALS WORLD CUP\",\"url\":\"\\/uk\\/london\\/peckham\\/screenings\\/semi-finals-world-cup-3012\",\"date\":\"Wed, Jul 15\",\"time\":\"8:00 PM\",\"door_time\":\"7:00 PM\",\"minimum_age\":18,\"short_description\":null,\"long_description\":\"<p>Join us on the rooftop for the World Cup Semi-Final as the world's best teams battle it out for a place in the final.<\\/p>\\n<p>&nbsp;<\\/p>\\n<p>Gather your mates, grab a drink from the bar and settle in for an unforgettable matchday atmosphere beneath the open sky.&nbsp;<\\/p>\\n<p>&nbsp;<\\/p>\\n<p>Whether you're backing a favourite or simply here for the spectacle, there's nowhere better to watch the action unfold than on the big screen with fellow fans.<\\/p>\\n<p>&nbsp;<\\/p>\\n<p>Football. Friends. Rooftop views. The World Cup Semi-Finals, live.<\\/p>\",\"image_url\":\"https:\\/\\/res.cloudinary.com\\/dpgypjrov\\/image\\/fetch\\/f_auto,w_600,h_450,c_fill,q_auto\\/https:\\/\\/d31ni94nh7toh0.cloudfront.net\\/PRODUCTION\\/films\\/fa8980a8-28f2-4313-b1ef-da0f7708c4a3\\/World-Cup-(1).png\",\"venue_title\":\"Peckham, London\",\"collections\":[{\"title\":\"Sport\",\"bg_color\":\"#FF84DA\"}],\"seasons\":[],\"tags\":[{\"title\":\"Event\"},{\"title\":\"Alternative Events\"}],\"accessibility\":[],\"sold_out\":true}",
