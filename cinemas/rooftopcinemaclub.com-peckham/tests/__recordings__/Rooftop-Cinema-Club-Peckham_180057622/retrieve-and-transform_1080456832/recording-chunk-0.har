          "content": {
            "mimeType": "text/html; charset=utf-8",
            "text": "<!doctype html>\n<html class=\"scroll-smooth antialiased\" lang=\"en\">\n    <head>\n        <meta charset=\"utf-8\">\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n        <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"theme-color\" content=\"#E95D40\">\n        \n        \n        <title>The Sopranos at Peckham, London &mdash; August 16, 2026 | Rooftop Cinema Club</title>\n<meta name=\"description\" content=\"Watch The Sopranos at Peckham, London on August 16, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:title\" content=\"The Sopranos at Peckham, London &mdash; August 16, 2026\" />\n<meta property=\"og:description\" content=\"Watch The Sopranos at Peckham, London on August 16, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:url\" content=\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/the-sopranos-3054\" />\n<meta property=\"og:site_name\" content=\"Rooftop Cinema Club\" />\n<meta property=\"og:locale\" content=\"en_GB\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"The Sopranos at Peckham, London &mdash; August 16, 2026\" />\n<meta name=\"twitter:description\" content=\"Watch The Sopranos at Peckham, London on August 16, 2026. Outdoor rooftop cinema in London.\" />\n<link href=\"https://rooftopcinemaclub.com/uk\" rel=\"home\" />\n<link href=\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/the-sopranos-3054\" rel=\"canonical\" />\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Global Home\",\"item\":\"https://rooftopcinemaclub.com/uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"London\",\"item\":\"https://rooftopcinemaclub.com/uk/london\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Peckham, London\",\"item\":\"https://rooftopcinemaclub.com/uk/london/peckham\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"The Sopranos\",\"item\":\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/the-sopranos-3054\"}]}</script>\n<script type=\"application/ld+json\">{    \"@context\": \"https://schema.org\",    \"@type\": \"ScreeningEvent\",    \"@id\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/the-sopranos-3054#event\",    \"name\": \"The Sopranos\",    \"url\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/the-sopranos-3054\",    \"startDate\": \"2026-08-16T19:15:00+00:00\",            \"endDate\": \"2026-08-16T21:55:00+00:00\",            \"eventStatus\": \"https://schema.org/EventScheduled\",    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",    \"inLanguage\": \"en-GB\",    \"isAccessibleForFree\": false,    \"offers\": {        \"@type\": \"Offer\",        \"url\": \"https://rooftopcinemaclub.com/uk/london/peckham/screenings/the-sopranos-3054\",        \"availability\": \"https://schema.org/SoldOut\"    },        \"description\": \"Join us on the rooftop as we revisit three of the most iconic episodes from the series that basically invented prestige television. Family drama, mafia politics, therapy sessions and some of the funniest accidental comedy ever put on screen? It's all here. &nbsp; Featuring College (S1, Ep5), Pine Barrens (S3, Ep11) and Long Term Parking (S5, Ep12), this mini marathon brings together some of the most talked-about episodes in TV history. From existential crises and disastrous road trips to moments that'll leave you staring into the distance afterwards, this is peak television. &nbsp; If you've somehow never watched The Sopranos, congratulations - you're about to discover why people won't stop talking about it nearly 30 years later. &nbsp; Grab a drink, settle in and spend a few hours with Tony, Carmela, Christopher, Paulie and the rest of the gang under the stars. &nbsp; This is character development.\",            \"typicalAgeRange\": \"18+\",    \"audience\": {        \"@type\": \"Audience\",        \"audienceType\": \"18+\"    },                    \"image\": {        \"@type\": \"ImageObject\",        \"url\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_2045,y_535,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/5bfb0190-1cd3-426c-8cea-5be64bd50cf1/The-Sopranos-(1).png\",        \"width\": 1920,        \"height\": 1080    },            \"workFeatured\": {        \"@type\": \"Movie\",        \"name\": \"The Sopranos\",                \"image\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_2045,y_535,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/5bfb0190-1cd3-426c-8cea-5be64bd50cf1/The-Sopranos-(1).png\",        \"duration\": \"PT160M\",        \"dateCreated\": \"1999\"    },            \"location\": {        \"@type\": \"MovieTheater\",        \"@id\": \"https://rooftopcinemaclub.com/uk/london/peckham#venue\",        \"name\": \"Peckham, London\",        \"address\": {            \"@type\": \"PostalAddress\",            \"streetAddress\": \"133 Rye Lane\",            \"postalCode\": \"SE15 4ST\",            \"addressLocality\": \"London\",            \"addressCountry\": \"GB\"        },        \"geo\": {            \"@type\": \"GeoCoordinates\",            \"latitude\": 51.4699171,            \"longitude\": -0.0675244        }    },        \"organizer\": {        \"@type\"