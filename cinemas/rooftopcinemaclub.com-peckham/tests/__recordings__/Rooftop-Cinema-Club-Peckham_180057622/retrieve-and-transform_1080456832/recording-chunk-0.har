          "content": {
            "mimeType": "application/json",
            "text": "{\"id\":\"9db52c51-dca7-4c34-a10a-db8172bd0027\",\"title\":\"Gilmore Girls\",\"url\":\"\\/uk\\/london\\/peckham\\/screenings\\/gilmore-girls-3083\",\"external_booking_url\":null,\"date\":\"Tue, Sep 22\",\"time\":\"7:00 PM\",\"door_time\":\"6:00 PM\",\"minimum_age\":18,\"short_description\":\"TV Mini-Marathon\",\"long_description\":\"<p>We're headed to Stars Hollow for a Gilmore Girls mini-marathon under the stars. Settle in for three season 6 episodes all about growing up and finding your way (and occasionally making things much worse before they get better).<\\/p>\\n<p>&nbsp;<\\/p>\\n<p>S6E09 &ndash; The Prodigal Daughter Returns<\\/p>\\n<p>S6E10 &ndash; He's Slippin' 'Em Bread... Dig<\\/p>\\n<p>S6E13 &ndash; Friday Night's Alright for Fighting<\\/p>\",\"image_url\":\"https:\\/\\/res.cloudinary.com\\/dpgypjrov\\/image\\/fetch\\/f_auto,w_600,h_450,c_fill,q_auto\\/https:\\/\\/d31ni94nh7toh0.cloudfront.net\\/PRODUCTION\\/films\\/ba3b6e71-69cf-4f42-892c-acc6ba4c21ea\\/610trio-(1).webp\",\"venue_title\":\"Peckham, London\",\"collections\":[],\"seasons\":[{\"title\":\"Mini Marathons\",\"bg_color\":\"#3156d2\",\"text_color\":\"#f9f4ee\"}],\"tags\":[],\"accessibility\":[],\"sold_out\":true}",
