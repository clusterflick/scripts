ion class=\"relative w-full h-screen overflow-hidden\">\n    \n    \n    \n    <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1600,h_900,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/aff6cc28-d320-48d5-9d74-30ef73b04757/Sinners_1920x10801.jpeg\" alt=\"Peckham, London outdoor screening of Sinners_1920x10801.jpeg in London\" fetchpriority=\"high\" class=\"absolute inset-0 w-full h-full object-cover\">\n    \n    \n    \n\n    <div class=\"absolute inset-0 bg-black/30\"></div>\n\n    <div class=\"absolute left-0 right-0 z-10 px-6 lg:px-12 bottom-[20%] md:bottom-[28%]\">\n        <div class=\"text-brand-white\">\n            <p class=\"text-xs md:text-lg mb-2 md:mb-3 flex items-center gap-2\">\n                Fri, Aug 21\n                <span class=\"text-brand-lavenderpink text-sm md:text-lg\">\n                    <svg width=\"19\" height=\"19\" viewBox=\"0 0 19 19\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M18.5929 12.0172L15.8036 9.5L18.5929 6.98282C19.4486 6.21064 18.8604 4.79245 17.7097 4.85021L13.9583 5.04173L14.1498 1.29028C14.2091 0.139614 12.7894 -0.44864 12.0172 0.407141L9.5 3.19641L6.98282 0.407141C6.21064 -0.44864 4.79245 0.139614 4.85021 1.29028L5.04173 5.04173L1.29028 4.85021C0.139614 4.79093 -0.44864 6.21064 0.407141 6.98282L3.19641 9.5L0.407141 12.0172C-0.44864 12.7894 0.139614 14.2076 1.29028 14.1498L5.04173 13.9583L4.85021 17.7097C4.79093 18.8604 6.21064 19.4486 6.98282 18.5929L9.5 15.8036L12.0172 18.5929C12.7894 19.4486 14.2076 18.8604 14.1498 17.7097L13.9583 13.9583L17.7097 14.1498C18.8604 14.2091 19.4486 12.7894 18.5929 12.0172Z\" fill=\"currentColor\"/>\n                    </svg>\n                </span>\n                9:10 PM\n            </p>\n\n            <h1 class=\"text-2xl md:text-5xl lg:text-6xl font-black uppercase leading-tight mb-3 md:mb-5 tracking-tight\">\n                Sinners\n            </h1>\n\n            <di