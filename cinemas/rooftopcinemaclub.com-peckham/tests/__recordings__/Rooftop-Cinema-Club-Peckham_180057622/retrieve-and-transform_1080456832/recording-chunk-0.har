            "text": "<!doctype html>\n<html class=\"scroll-smooth antialiased\" lang=\"en\">\n    <head>\n        <meta charset=\"utf-8\">\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n        <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"theme-color\" content=\"#E95D40\">\n        \n        \n        <title>Gilmore Girls at Peckham, London &mdash; September 22, 2026 | Rooftop Cinema Club</title>\n<meta name=\"description\" content=\"Watch Gilmore Girls at Peckham, London on September 22, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:title\" content=\"Gilmore Girls at Peckham, London &mdash; September 22, 2026\" />\n<meta property=\"og:description\" content=\"Watch Gilmore Girls at Peckham, London on September 22, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:url\" content=\"https://rooftopcinemaclub.com/uk/london/peckham/screenings/gilmore-girls-3083\" />\n<meta property=\"og:site_name\" content=\"Rooftop Cinema Club\" />\n<meta property=\"og:locale\" content=\"en_GB\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"Gilmore Girls at Peckham, London &mdash; September 22, 2026\" />\n<meta name=\"twitter:description\" content=\"Watch Gilmore Girls at Peckham, London on September 22, 2026. Outdoor rooftop cinema in London.\" />\n<link href=\"https://rooftopcinemaclub.com/uk\" rel=\"home\" />\n<link href=\"https://rooftopcinemaclub.com/uk/london/peckham/