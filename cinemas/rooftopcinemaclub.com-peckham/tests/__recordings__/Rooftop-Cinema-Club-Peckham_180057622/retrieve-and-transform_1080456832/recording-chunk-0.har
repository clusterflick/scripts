d\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\" /></svg>\n</button>\n\n            <div id=\"closest-venue-popover-root\" class=\"contents\"></div>\n        </div>\n\n        <nav class=\"flex items-center gap-2 md:gap-3 relative\">\n            \n\n            <div id=\"basket-button-root\"></div>\n\n            <button @click=\"menu_open = true\" type=\"button\" class=\"w-11 h-11 md:w-12 md:h-12 rounded-full bg-brand-lavenderpink flex items-center justify-center text-brand-navy hover:bg-brand-honey transition cursor-pointer\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 md:h-6 md:w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 6h16M4 12h16M4 18h16\" />\n                </svg>\n            </button>\n        </nav>\n    </div>\n</header>\n\n\n        <main id=\"content\" class=\"flex-1 flex flex-col\">\n            <div x-data=\"{\n    show_trailer: false,\n    get trailer_embed_url() {\n        let url = 'https://www.youtube.com/watch?v=aQXh_AaJXaM';\n        url = url.replace('watch?v=', 'embed/').replace('youtu.be/', 'www.youtube.com/embed/');\n        return url + (url.includes('?') ? '&' : '?') + 'autoplay=1';\n    }\n}\">\n<section class=\"relative w-full h-screen overflow-hidden\">\n    \n    \n    \n    <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1600,h_900,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/126e8435-5615-4ddf-803e-688cf03f487c/Sofar-almost-famous.png\" alt=\"Peckham, London outdoor screening of Sofar-almost-famous.png in London\" fetchpriority=\"high\" class=\"absolute inset-0 w-full h-full object-cover\">\n    \n    \n    \n\n    <div class=\"absolute inset-0 bg-black/30\"></div>\n\n    <div class=\"absolute left-0 right-0 z-10 px-6 lg:px-12 bottom-[20%] md:bottom-[28%]\">\n        <div class=\"text-brand-white\">\n            <p class=\"text-xs md:text-lg mb-2 md:mb-3 flex items-center gap-2\">\n                Thu, Aug 13\n                <span class=\"text-brand-lavenderpink text-sm md:text-lg\">\n                    <svg width=\"19\" height=\"19\" viewBox=\"0 0 19 19\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M18.5929 12.0172L15.8036 9.5L18.5929 6.98282C19.4486 6.21064 18.8604 4.79245 17.7097 4.85021L13.9583 5.04173L14.1498 1.29028C14.2091 0.139614 12.7894 -0.44864 12.0172 0.407141L9.5 3.19641L6.98282 0.407141C6.21064 -0.44864 4.79245 0.139614 4.85021 1.29028L5.04173 5.04173L1.29028 4.85021C0.139614 4.79093 -0.44864 6.21064 0.407141 6.98282L3.19641 9.5L0.407141 12.0172C-0.44864 12.7894 0.139614 14.2076 1.29028 14.1498L5.04173 13.9583L4.85021 17.7097C4.79093 18.8604 6.21064 19.4486 6.98282 18.5929L9.5 15.8036L12.0172 18.5929C12.7894 19.4486 14.2076 18.8604 14.1498 17.7097L13.9583 13.9583L17.7097 14.1498C18.8604 14.2091 19.4486 12.7894 18.5929 12.0172Z\" fill=\"currentColor\"/>\n                    </svg>\n                </span>\n                7:45 PM\n            </p>\n\n            <h1 class=\"text-2xl md:text-5xl lg:text-6xl font-black uppercase leading-tight mb-3 md:mb-5 tracking-tight\">\n                Almost Famous x Sofar Sounds\n            </h1>\n\n            <div class=\"flex items-center gap-3 md:gap-5\">\n                \n\n<button data-checkout-screening=\"bcc28576-efc0-4d7b-8a03-f31d0a0aa4fa\"\n        class=\"cursor-pointer inline-flex items-center justify-center rounded-full px-4 py-2 text-xs sm:px-5 sm:py-2.5 sm:text-sm md:px-6 md:py-2.5 md:text-[16px] font-bold border-2 border-transparent bg-brand-lavenderpink text-brand-navy transition-colors duration-150 hover:bg-brand-honey active:bg-brand-honey\">\n    Book\n</button>\n\n\n\n\n\n                \n                \n                <button @click=\"show_trailer = true\" class=\"flex items-center gap-1.5 md:gap-2 text-brand-white text-xs md:text-base font-medium hover:opacity-80 transition cursor-pointer\">\n                    <svg class=\"w-6 h-6 md:w-8 md:h-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" fill=\"none\"/>\n                        <path d=\"M10 8.5l6 3.5-6 3.5V8.5z\" fill=\"currentColor\" stroke=\"none\"/>\n                    </svg>\n                    Play Trailer\n                </button>\n                \n                \n            </div>\n\n            \n            <div class=\"flex flex-wrap gap-2 mt-4\">\n                \n                \n                <div class=\"text-center py-1 px-3 text-xs font-medium rounded\" style=\"background-color: #FF84DA; color: #f9f4ee;\">Music</div>\n                \n                \n                \n                \n            </div>\n            \n        </div>\n    </div>\n\n    <div class=\"absolute bottom-0 right-0 z-10 px-6 lg:px-12 pb-8 flex flex-col items-end gap-2\">\n        \n        <div class=\"flex items-center justify-center text-center w-12 h-12 rounded-full bg-brand-lightbeige text-brand-navy\">\n            <h3 class=\"text-xl leading-none\">18+</h3>\n        </div>\n        \n\n        \n\n        \n        <div class=\"flex flex-wrap gap-1 justify-end\">\n            \n            <span class=\"px-2 py-1 text-xs rounded bg-white text-brand-navy font-medium\">\n            Event\n        </span>\n            \n        </div>\n        \n    </div>\n</section>\n\n<section class=\"w-[90%] bg-brand-honey rounded-lg py-16 px-12 mx-auto space-y-12 my-16\">\n    <h2 class=\"text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-brand-navy leading-tight\">\n        Screening Details\n    </h2>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-6 md:gap-y-10 mb-20 px-0 md:px-8\">\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Film</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\"><a href=\"/uk/films/almost-famous-x-sofar-sounds\" class=\"underline\">Almost Famous x Sofar Sounds</a></div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Venue</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\"><a href=\"/uk/london/peckham\" class=\"underline\">Peckham, London</a></div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Screen</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Screen 1</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Duration</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">155 Minutes</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        \n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Door Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">30 mins</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n        \n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Date</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Thu, Aug 13</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">7:45 PM</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Year</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">2000</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n    </div>\n\n    <div class=\"rounded-2xl p-10 text-brand-navy/80\">\n        <p>A very special screening of Almost Famous in partnership with Sofar Sounds, featuring a live performance inspired by the golden age of 70s rock. Expect classic rock, folk-rock and Americana influences, celebrating the era that inspired Cameron Crowe's coming-of-age masterpiece and its unforgettable soundtrack.</p>\n<p>&nbsp;</p>\n<p>Before the film begins, during golden hour, we&rsquo;re handing the rooftop over to the magical team at Sofar Sounds for an intimate live set under the Peckham sky.</p>\n<p>&nbsp;</p>\n<p>Expect stripped-back performances inspired by this classic movie, undiscovered talent and that unmistakable Sofar energy - the kind that makes you feel like you&rsquo;ve stumbled into something secret and special.&nbsp;</p>\n<p>&nbsp;</p>\n<p>Then, as the sun dips and the skyline glows, we roll straight into our movie.</p>\n<p>&nbsp;</p>\n<p>Rooftop Cinema Club is an 18+ venue after 5pm.</p>\n<p>&nbsp;</p>\n<p>Sofar Sounds shows are intimate, listening-focused experiences &nbsp;- this gig will be served to you via our state of the art headphones.&nbsp;</p>\n    </div>\n\n    <div class=\"mt-8\">\n\n        <div class=\"md:hidden relative\">\n            <div class=\"relative\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_400,h_300,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/126e8435-5615-4ddf-803e-688cf03f487c/Sofar-almost-famous.png\" alt=\"Peckham, London outdoor screening of Sofar-almost-famous.png in London\" class=\"w-[45%] aspect-[4/3] object-cover rounded-xl relative z-10 -ml-4 shadow-lg\">\n                \n                \n                \n            </div>\n\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-5 pt-10 -mt-6 relative z-0\">\n                <div class=\"prose prose-invert prose-sm leading-relaxed max-w-none\">\n                    EXPERIENCE IT. ENJOY IT. JUST DON’T FALL FOR IT.\r\n\r\nIn 1973, 15-year-old William Miller’s unabashed love of music and aspiration to become a rock journalist lands him an assignment from Rolling Stone magazine to interview and tour with the up-and-coming band Stillwater—fronted by lead guitar Russell Hammond, and lead singer Jeff Bebe.\n                </div>\n            </div>\n            \n        </div>\n\n        <div class=\"hidden md:flex relative flex-row items-center gap-0 min-h-[350px]\">\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-10 w-1/2 z-10 relative -mr-12 shadow-2xl\">\n                <div class=\"prose prose-invert prose-lg leading-relaxed max-w-none\">\n                    EXPERIENCE IT. ENJOY IT. JUST DON’T FALL FOR IT.\r\n\r\nIn 1973, 15-year-old William Miller’s unabashed love of music and aspiration to become a rock journalist lands him an assignment from Rolling Stone magazine to interview and tour with the up-and-coming band Stillwater—fronted by lead guitar Russell Hammond, and lead singer Jeff Bebe.\n                </div>\n            </div>\n            \n\n            <div class=\"w-1/2 z-0\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_900,h_450,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/126e8435-5615-4ddf-803e-688cf03f487c/Sofar-almost-famous.png\" alt=\"Peckham, London outdoor screening of Sofar-almost-famous.png in London\" class=\"w-full h-[450px] object-cover rounded-2xl shadow-inner\">\n                \n                \n                \n            </div>\n        </div>\n    </div>\n</section>\n\n\n\n<div x-cloak x-show=\"show_trailer\" @keydown.escape.window=\"show_trailer = false\"\n     class=\"fixed inset-0 z-50 flex items-center justify-center p-4\">\n\n    <div class=\"absolute inset-0 bg-black/80\" @click=\"show_trailer = false\"></div>\n\n    <div class=\"relative w-full max-w-4xl z-10\" @click.stop>\n        <button @click=\"show_trailer = false\"\n                class=\"absolute -top-10 right-0 text-white hover:opacity-80 cursor-pointer\">\n            <svg class=\"w-8 h-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\"/>\n            </svg>\n        </button>\n\n        <div class=\"relative w-full\" style=\"padding-bottom: 56.25%\">\n            <template x-if=\"show_trailer\">\n                <iframe\n                    :src=\"trailer_embed_url\"\n                    class=\"absolute inset-0 w-full h-full rounded-xl\"\n                    frameborder=\"0\"\n                    allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n                    allowfullscreen>\n                </iframe>\n            </template>\n        </div>\n    </div>\n</div>\n\n\n\n</div>\n\n\n\n        </main>\n\n        <div id=\"tickets-checkout-root\"></div>\n        <div id=\"gift-card-checkout-root\"></div>\n\n        <div id=\"modals-root\"></div>\n\n        <footer class=\"w-full bg-brand-red text-brand-white px-4 md:px-12 py-12\">\n\n    <div class=\"flex flex-col gap-3 mb-12 items-start\">\n        \n            <div>\n                <div class=\"inline-flex justify-start items-center\">\n                    <a href=\"/uk/locations\">\n                      