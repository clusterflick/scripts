    </div>\n            </div>\n            \n        </div>\n    </div>\n    \n    <div class=\"screening-group mb-12 md:mb-16\">\n        <div class=\"mb-8\">\n            <h2 class=\"text-base md:text-lg font-bold text-brand-navy uppercase shrink-0 pb-3\">SUN, AUG 30</h2>\n            <hr class=\"border-brand-navy\">\n        </div>\n\n        <div class=\"space-y-14\">\n            \n            <div class=\"screening-card grid grid-cols-[10rem_1fr] md:grid-cols-[1fr_2fr_1fr] gap-x-4 gap-y-3 md:gap-6\">\n\n                <div class=\"col-start-1 row-start-1 md:row-span-2 space-y-2\">\n                    <div class=\"relative rounded-lg overflow-hidden aspect-[4/3] bg-brand-paleblue\">\n                        \n                        <img alt=\"Pride & Prejudice\" class=\"w-full h-full object-cover\" src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_600,h_450,c_fill,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/e6ad4b28-715c-4176-8437-4c95da01c204/pride-prejudice-1200x900.jpg\">\n                        \n                        \n                        \n                    </div>\n                    <div class=\"space-y-1\">\n                        \n                        \n                        \n                        \n                    </div>\n                </div>\n\n                <div class=\"col-start-2 row-start-1 md:row-span-2\">\n                    <h3 class=\"text-sm md:text-lg text-brand-navy uppercase leading-tight mb-2\"><a href=\"/uk/london/peckham/screenings/pride-prejudice-2878\" class=\"hover:underline\">Pride & Prejudice</a></h3>\n\n                    <div class=\"flex flex-wrap items-center gap-x-3 gap-y-1 mb-2 text-brand-navy/80\">\n                        <div class=\"flex items-center gap-1.5 text-xs font-medium\">\n                            <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <rect x=\"3\" y=\"4\" width=