rap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-35e42e61 elementor-widget elementor-widget-text-editor\" data-id=\"35e42e61\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<script type=\"text/javascript\" src=\"/wp-content/themes/hello-theme-child-master/js/vidoverlay.js\"></script>\n\n<div class=\"flex-wrapper\">\t\n\t<div class=\"prog-left\">\n\t\t<h1 class=\"prog-title\">Arthouse Short Film Showcase</h1>\n\t\t<div class=\"prog-meta\">\t\t\n\t\t\t<span class=\"prog-type\">Programme Type: Film</span><span class=\"divider\">|</span><span class=\"prog-length\">Length: 120 mins</span><span class=\"divider\">|</span><span class=\"prog-cert\"> Cert: <img decoding=\"async\"  width=\"30\" data-src=\"/wp-content/themes/hello-theme-child-master/bbfc/18.jpg\" class=\"lazyload\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" /><noscript><img decoding=\"async\" src=\"/wp-content/themes/hello-theme-child-master/bbfc/18.jpg\" width=\"30\"/></noscript></span>\t\t\n\t\t</div>\n\t\t<!--<img decoding=\"async\"    image data-rsVideo=\"\" data-src=\"https://images.savoysystems.co.uk/ACE/9361509.jpg\" class=\"rsImg lazyload\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" /><noscript><img decoding=\"async\" class=\"rsImg\" src=\"https://images.savoysystems.co.uk/ACE/9361509.jpg\"  image data-rsVideo=\"\" /></noscript>-->\n\t\t\n\t\t\n\t\t<div class=\"ytvideo\" data-video=\"\" style=\"width:100%; height:320px; background-image:url(https://images.savoysystems.co.uk/ACE/9361509.jpg)\">\n\t\t\t<span class=\"playbutton\"></span>\n\t\t</div>\n\t\t\n\t\t\n\t\t<div class=\"synopsis\"><p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">We're excited to be bringing back the </span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\">ArtHouse Short Film Showcase</span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">, an evening of incredible short films from both established and first-time filmmakers and curated by the ArtHouse staff!</span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">'Loss/Found' is a collection of short films from first-time and established filmmakers. Together these stories explore the tension between the pain of losing a loved one or ourselves, and the excitement and joy of discovering and welcoming something new in our lives.</span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">The programme:</span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">- </span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\">Sister Sister</span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">&nbsp;(2025), dir. </span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\">Kitty Parker</span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">: Two best friends run away from a funeral and spend the day exploring the Devon countryside, but when one of them vanishes, it is revealed everything is not as it seems.</span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">- </span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\">Gro&#223;mutti</span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">&nbsp;(2023), dir. </span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\">Ita Rot</span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">: In a meditative essay film that encircles themes of grief, post-memory and motherhood, the filmmaker recollects their grandmother&#8217;s passing in her native Vienna. Dwelling on the haunted space and possessions of the deceased, the malaise of grief and isolation is disrupted by the discovery of 8mm reels shot by her grandfather - a vivid projection into an idyllic past that brings her grandmother back to life.</span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">- </span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\">Sperm Donors Wanted!</span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">&nbsp;(2024), dir. </span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\">Logan Rea</span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">: this documentary follows a transgender performance artist as he interviews hundreds of potential sperm donors live on stage in a quest to find the perfect connection, one that will enable him and his partner to start their family.</span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">- </span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\">Tanner's Field </span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">(2024), dir. </span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\">Jemma Field</span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">: Nine-year-old Finbar lives quietly with his Dad in rural Dorset. Yet when new information about his mother&#8217;s death is revealed how can he continue to live this same quiet life?</span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">- </span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\">Rejoyce!</span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">&nbsp;(2024), dir. </span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\">David Ledger</span><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">: After the death of her husband, an elderly vicar&#8217;s wife unearths a book of erotic fiction that she wrote in her youth.</span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">The screenings will be followed by a Q&amp;A with the filmmakers and then networking in our bar.</span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">The total running time of the event will be 120 minutes which includes an interval and Q&amp;As with the filmmakers.</span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\">Please note: Prompt start as no ads/trailers.</span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\">Please also note: This event is excluded from membership discounts.</span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> <p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p> </div>\n\t</div>\t\n\t\n\t<div class=\"prog-right\">\n\t<div class=\"prog-background\">\n\t\t<h2>Tickets</h2>\n\t\t<h5>Click on a time to book tickets</h5>\n\t\t\n\t\t<div id=\"dates\" class=\"day-Tue\">\n\t\t\t<p class=\"bolder\">Tue 3 Jun</p>\n\t\t</div>\n\t\t\n\t\t<div class=\"times\">\n\t\t\t\n\t\t\t\n\t\t\t<a href=\"http://arthousecrouchend.savoysystems.co.uk/ArthouseCrouchEnd.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_12458.TcsWebTab_12459.TcsPerformance_9330986\"  title=\"Click to Book\" onClick=\"ga('send', 'event', 'button', 'click', 'booking programme page');\"><span class=\"prog-times\">20:15<span class=\"prog-notes\">SHORT FILM SHOWCASE</span><small class=\"OpenForSale\"></small></span></a>\n\t\t\t\t\n\t\t\t</div>\n\t\t\t\n\t\t\t\n\t\t</div>\t\n\t</div>\t\n\t</div>\t\n\t\n\t\n\t\n\t\n\t\t\t\t<code></code>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t</div>\n\t\t\t\t<div data-elementor-type=\"footer\" data-elementor-id=\"10060\" class=\"elementor elementor-10060 elementor-location-footer\" data-elementor-post-type=\"elementor_library\">\n\t\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-27a6ad77 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"27a6ad77\" data-element_type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-81d0fcb\" data-id=\"81d0fcb\" data-element_type=\"column\">\n\t\t\t<d