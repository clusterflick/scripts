h: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 2048 1055'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n        \n\n                                    \n                                </div>\n\n                        \n                            </div>\n\n                        \n\n                        \n                    \n                                                \n                        \n                            <div class=\"blockSlider__slide blockSlider__slide--gallery\" data-block-slide>\n\n                        \n                                <div class=\"gallerySlider__mediaWrap psBr ps-oh psBor--dark\" data-media-parallax-frame>\n\n                                    \n                                        \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/02/Gallery-Image-Sized-41-760x392.jpeg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/02/Gallery-Image-Sized-41.jpeg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://w