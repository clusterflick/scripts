9732 -0.122249 5.14631 1.51593 5.14631 1.51593L5.14614 1.51576Z\" />\n                </svg>    </span>\n    \n                    </div>\n\n                \n            </a>\n\n        \n        <div class=\"blockLinks__content psPd-base psBg--light psColor--dark\">\n            \n            <a href=\"https://adventurecinema.co.uk/event/mamma-mia-extrabbaganza-at-kew-gardens/\" class=\"psDb ps-no-td\">                                       \n                \n                <h4 class=\"ps-h-mobile-3 psMb-0 ps-rel psPr-7\">\n                    <span>Mamma Mia! ExtrABBAganza</span>\n                                            <span class=\"ps-abs ps-abs-b0 psMeta psMl-2\">(PG)</span>\n                                    </h4>  \n                                                  \n                                    <span class=\"ps-h ps-h-5\">Saturday, June 20</span>\n                \n            </a>\n        \n            <div class=\"psMt-3 psMb-3\">\n\n                <span class=\"psDb\">\n\n                    Gates 18:00\n                </span> \n\n            </div>\n\n                            <p>The ultimate ABBA and Mamma Mia experience! An all singing, all dancing ExtrABBAganza, where you can immerse yourself in the world of the hit movie musical, Mamma Mia!</p>\n                            \n            <div class=\"psFlex psGap-2 psMt-4\">\n\n                <a class=\"psButton psButton--primary psFlex--noShrink\" href=https://adventurecinema.co.uk/event/mamma-mia-extrabbaganza-at-kew-gardens/>   \n                    <span class=\"psButton__bg\"></span>\n                    <span class=\"psButton__labelWrapper\">\n                        <span class=\"psButton__label\">More Info</span>\n                        <span class=\"psButton__labelHover\">More Info</span>\n                    </span>\n                </a>\n\n                \n                    <span class=\"psButton psButton--disabled psFullWidth\">\n                        Sold Out\n                    </span>\n\n                \n            </div>   \n\n        </div>\n\n    </div>\n\n</div>\n\n                                                    \n                    \n<div data-block-slide class=\"blockSlider__slide psMr-5 ps-rel\">                      \n\n    <div class=\"blockLinks__card psBr psBor--dark ps-oh psDb ps-no-td\">\n\n        \n            <a href=\"https://adventurecinema.co.uk/event/pride-and-prejudice-at-kew-gardens/\" class=\"blockLinks__mediaWrap psDb\">\n\n                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/02/Pride-and-Prejudice-site-pic-760x506.jpg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/02/Pride-and-Prejudice-site-pic-1201x800.jpg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1201 800'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover blockLinks__media\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n      \n\n                \n                    <div class=\"psLabelWrap ps-abs\">\n                        \n\n    <span class=\"psLabel psLabel--alert\" data-alert-label>  \n        <svg class=\"psFill--none psHgt-1e\" viewBox=\"0 0 10 10\">\n                    <path class=\"psFill--dark\" d=\"M5.14614 1.51576C5.14614 1.51576 6.31703 -0.606754 7.76708 0.171535C9.22306 0.953101 8.83485 2.17215 7.76708 2.95371C7.76708 2.95371 9.96741 2.64109 9.99964 4.92319C10.032 7.2053 7.89648 7.01769 7.89648 7.01769C7.89648 7.01769 9.38553 8.53085 8.09067 9.51854C6.8611 10.4564 5.53452 9.61226 5.08153 8.36192C5.08153 8.36192 3.98136 10.8315 1.84581 9.70615C-0.174419 8.64161 1.81342 6.54875 1.81342 6.54875C1.81342 6.54875 -0.289742 6.73636 0.0338472 4.82947C0.357436 2.92258 2.49299 3.70415 2.49299 3.70415C2.49299 3.70415 0.551623 2.016 2.68717 0.796952C4.29732 -0.122249 5.14631 1.51593 5.14631 1.51593L5.14614 1.51576Z\" />\n                </svg>        SOLD OUT!        <svg class=\"psFill--none psHgt-1e\" viewBox=\"0 0 10 10\">\n                    <path class=\"psFill--dark\" d=\"M5.14614 1.51576C5.14614 1.51576 6.31703 -0.606754 7.76708 0.171535C9.22306 0.953101 8.83485 2.17215 7.76708 2.95371C7.76708 2.95371 9.96741 2.64109 9.99964 4.92319C10.032 7.2053 7.89648 7.01769 7.89648 7.01769C7.89648 7.01769 9.38553 8.53085 8.09067 9.51854C6.8611 10.4564 5.53452 9.61226 5.08153 8.36192C5.08153 8.36192 3.98136 10.8315 1.84581 9.70615C-0.174419 8.64161 1.81342 6.54875 1.81342 6.54875C1.81342 6.54875 -0.289742 6.73636 0.0338472 4.82947C0.357436 2.92258 2.49299 3.70415 2.49299 3.70415C2.49299 3.70415 0.551623 2.016 2.68717 0.796952C4.29732 -0.122249 5.14631 1.51593 5.14631 1.51593L5.14614 1.51576Z\" />\n                </svg>    </span>\n    \n                    </div>\n\n                \n            </a>\n\n        \n        <div class=\"blockLinks__content psPd-base psBg--light psColor--dark\">\n            \n            <a href=\"https://adventurecinema.co.uk/event/pride-and-prejudice-at-kew-gardens/\" class=\"psDb ps-no-td\">                                       \n                \n                <h4 class=\"ps-h-mobile-3 psMb-0 ps-rel psPr-7\">\n                    <span>Pride and Prejudice</span>\n                                            <span class=\"ps-abs ps-abs-b0 psMeta psMl-2\">(U)</span>\n                                    </h4>  \n                                                  \n                                    <span class=\"ps-h ps-h-5\">Sunday, June 21</span>\n                \n            </a>\n        \n            <div class=\"psMt-3 psMb-3\">\n\n                <span class=\"psDb\">\n\n                    Gates 13:30\n                </span> \n\n            </div>\n\n                            <p>Fall in love all over again with the timeless romance of Pride & Prejudice on an open-air screen, set against a stunning backdrop.</p>\n                            \n            <div class=\"psFlex psGap-2 psMt-4\">\n\n                <a class=\"psButton psButton--primary psFlex--noShrink\" href=https://adventurecinema.co.uk/event/pride-and-prejudice-at-kew-gardens/>   \n                    <span class=\"psButton__bg\"></span>\n                    <span class=\"psButton__labelWrapper\">\n                        <span class=\"psButton__label\">More Info</span>\n                        <span class=\"psButton__labelHover\">More Info</span>\n                    </span>\n                </a>\n\n                \n                    <span class=\"psButton psButton--disabled psFullWidth\">\n                        Sold Out\n                    </span>\n\n                \n            </div>   \n\n        </div>\n\n    </div>\n\n</div>\n\n                                                    \n                    \n<div data-block-slide class=\"blockSlider__slide psMr-5 ps-rel\">                      \n\n    <div class=\"blockLinks__card psBr psBor--dark ps-oh psDb ps-no-td\">\n\n        \n            <a href=\"https://adventurecinema.co.uk/event/jurassic-park-at-kew-gardens/\" class=\"blockLinks__mediaWrap psDb\">\n\n                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/02/Jurassic-Park-feature-image-760x456.png\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/02/Jurassic-Park-feature-image.png\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1100 660'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover blockLinks__media\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n      \n\n                \n                    <div class=\"psLabelWrap ps-abs\">\n                        \n\n    <span class=\"psLabel psLabel--alert\" data-alert-label>  \n        <svg class=\"psFill--none psHgt-1e\" viewBox=\"0 0 10 10\">\n                    <path class=\"psFill--dark\" d=\"M5.14614 1.51576C5.14614 1.51576 6.31703 -0.606754 7.76708 0.171535C9.22306 0.953101 8.83485 2.17215 7.76708 2.95371C7.76708 2.95371 9.96741 2.64109 9.99964 4.92319C10.032 7.2053 7.89648 7.01769 7.89648 7.01769C7.89648 7.01769 9.38553 8.53085 8.09067 9.51854C6.8611 10.4564 5.53452 9.61226 5.08153 8.36192C5.08153 8.36192 3.98136 10.8315 1.84581 9.70615C-0.174419 8.64161 1.81342 6.54875 1.81342 6.54875C1.81342 6.54875 -0.289742 6.73636 0.0338472 4.82947C0.357436 2.92258 2.49299 3.70415 2.49299 3.70415C2.49299 3.70415 0.551623 2.016 2.68717 0.796952C4.29732 -0.122249 5.14631 1.51593 5.14631 1.51593L5.14614 1.51576Z\" />\n                </svg>        SOLD OUT!        <svg class=\"psFill--none psHgt-1e\" viewBox=\"0 0 10 10\">\n                    <path class=\"psFill--dark\" d=\"M5.14614 1.51576C5.14614 1.51576 6.31703 -0.606754 7.76708 0.171535C9.22306 0.953101 8.83485 2.17215 7.76708 2.95371C7.76708 2.95371 9.96741 2.64109 9.99964 4.92319C10.032 7.2053 7.89648 7.01769 7.89648 7.01769C7.89648 7.01769 9.38553 8.53085 8.09067 9.51854C6.8611 10.4564 5.53452 9.61226 5.08153 8.36192C5.08153 8.36192 3.98136 10.8315 1.84581 9.70615C-0.174419 8.64161 1.81342 6.54875 1.81342 6.54875C1.81342 6.54875 -0.289742 6.73636 0.0338472 4.82947C0.357436 2.92258 2.49299 3.70415 2.49299 3.70415C2.49299 3.70415 0.551623 2.016 2.68717 0.796952C4.29732 -0.122249 5.14631 1.51593 5.14631 1.51593L5.14614 1.51576Z\" />\n                </svg>    </span>\n    \n                    </div>\n\n                \n            </a>\n\n        \n        <div class=\"blockLinks__content psPd-base psBg--light psColor--dark\">\n            \n            <a href=\"https://adventurecinema.co.uk/event/jurassic-park-at-kew-gardens/\" class=\"psDb ps-no-td\">                                       \n                \n                <h4 class=\"ps-h-mobile-3 psMb-0 ps-rel psPr-7\">\n                    <span>Jurassic Park</span>\n                                            <span class=\"ps-abs ps-abs-b0 psMeta psMl-2\">(PG)</span>\n                                    </h4>  \n                                                  \n                                    <span class=\"ps-h ps-h-5\">Sunday, June 21</span>\n                \n            </a>\n        \n            <div class=\"psMt-3 psMb-3\">\n\n                <span class=\"psDb\">\n\n                    Gates 18:00\n                </span> \n\n            </div>\n\n                            <p>Relive the epic adventure of Jurassic Park like never before on a huge open-air screen under the stars!</p>\n                            \n            <div class=\"psFlex psGap-2 psMt-4\">\n\n                <a class=\"psButton psButton--primary psFlex--noShrink\" href=https://adventurecinema.co.uk/event/jurassic-park-at-kew-gardens/>   \n                    <span class=\"psButton__bg\"></span>\n                    <span class=\"psButton__labelWrapper\">\n                        <span class=\"psButton__label\">More Info</span>\n                        <span class=\"psButton__labelHover\">More Info</span>\n                    </span>\n                </a>\n\n                \n                    <span class=\"psButton psButton--disabled psFullWidth\">\n                        Sold Out\n                    </span>\n\n                \n            </div>   \n\n        </div>\n\n    </div>\n\n</div>\n\n                \n            </div>            \n\n        </div>\n\n    </section>\n\n    \n    \n                    \n    <section class=\"flexiLayout flexiLayout--nt flexiLayout--nb freeText psTheme--transparent\">\n\n        <div class=\"maxWidth\">\n\n            <div class=\"freeText__inner psFlex--largeUp ps-rel ps-z-1\">\n                    \n                <div class=\"psMb-6\">\n                    <h3>Everything you need to know about screenings at Kew Gardens</h3>\n                </div>\n\n                <div class=\"freeText__contentCol ps-h ps-h-6 psMb-0 psDefaultContent\">\n                    <p>Screenings take place on the lawn, near the Pavilion Bar and Grill. Please follow directional signage and steward’s directions. See the event location on <a href=\"https://maps.app.goo.gl/AvnyWyaJNGccsY2Y8\" target=\"_blank\" rel=\"noopener\">Google Maps here</a>.</p>\n<p><strong>We recommend entering via <a href=\"https://maps.app.goo.gl/DpgDVVB6Fv6LmZgy5\" target=\"_blank\" rel=\"noopener\">Lion Gate</a> on Kew Road (TW9 2DF), opposite Lion Gate Gardens, for the easiest access.</strong></p>\n<p>For evening screenings, entrance must be via <a href=\"https://maps.app.goo.gl/DpgDVVB6Fv6LmZgy5\" target=\"_blank\" rel=\"noopener\">Lion Gate</a>, and the exit will be through <a href=\"https://maps.app.goo.gl/gGb2XwTzAfunb4n7A\" target=\"_blank\" rel=\"noopener\">Pavilion Gate</a> onto Kew Road (all other gates will be closed).</p>\n<p>You can only access the event location at the time of your screening, please check the gates opening time listed on your chosen show.</p>\n<p>We strongly recommend using public transport, taxi or travelling on foot where possible.</p>\n<p>There is no designated event car park available, guests can make use of nearby public car parks and pay and display options.</p>\n<p>Please note that Kew Gardens&#8217; car park near Brentford Gate will be closed during the evening screenings.</p>\n<p><em><strong>No access is permitted before the gates opening time listed on your chosen show.</strong></em></p>\n                </div>  \n\n            </div>\n            \n        </div>\n        \n    </section>\n\n    \n            \n     \n    \n    \n        \n        <section \n            data-flexi-layout         \n            class=\"flexiLayout flexiLayout--nt flexiLayout--nb map psTheme--transparent\"\n        >\n\n            <div class=\"maxWidth\">\n\n                <div class=\"map__inner ps-rel ps-z-5\">  \n                                        \n                    <div class=\"map__mapCol psBr--large psBor--dark ps-oh ps-rel\">\n                            \n                        <iframe \n                            width=\"100%\" \n                            height=\"100%\" \n                            class=\"map__embed\"\n                            frameborder=\"0\" \n                            style=\"border:0\"\n                            src=\"https://maps.google.com/maps?q=51.472352156498,-0.2947935461998&z=14&output=embed&t=k\" \n                            allowfullscreen \n                            loading=\"lazy\"\n                        ></iframe>                        \n                        \n                    </div>    \n                    \n                    <div class=\"map__textCol ps-oh psBr--large psBor--dark psBg--light psColor--dark psPd-6\">\n\n                        <div class=\"map__textWrap\">\n\n                            <span class=\"psTag psTag--yellow psMb-3\">Getting Here</span>\n\n                            <h3 class=\"ps-h-2 psMb-0\">\n                                Where is Kew Gardens?\n                            </h3>                                      \n                                  \n                            <span class=\"ps-h ps-h-5 psMb-0 psDb psMt-5\">\n                                <p>Richmond<br />\nLondon<br />\nTW9 2DF</p>\n                            </span> \n                            \n                            <a class=\"psMt-5 psButton psButton--secondary\" href=\"https://www.google.com/maps/dir/?api=1&destination=51.472352156498,-0.2947935461998\" target=\"_blank\" rel=\"noopener\">\n                                <span class=\"psButton__bg\"></span>\n                                <span class=\"psButton__labelWrapper\">\n                                    <span class=\"psButton__label\">Get Directions</span>\n                                    <span class=\"psButton__labelHover\">Get Directions</span>\n                                </span>\n                            </a>\n\n                        </div>                \n\n                    </div>                                       \n\n                </div>    \n\n            </div>    \n\n        </section>\n\n    \n\n            \n    \n    <section \n        data-flexi-layout \n                class=\"flexiLayout flexiLayout--nt flexiLayout--nb fiftyFifty psTheme--transparent\"\n    >\n\n        <div class=\"maxWidth\">\n\n            <div class=\"fiftyFifty__inner fiftyFifty__inner--reversed\">  \n                \n                <div class=\"fiftyFifty__mediaCol psBr psBor--dark ps-oh ps-rel\">\n\n                    <div class=\"fiftyFifty__mediaSlide\" >                  \n                                            \n                        \n                            <div class=\"fiftyFifty__mediaWrap ps-oh\" > \n\n                                \n                                                    \n                                    \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Kew-Gardens-1600-image-760x428.jpg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Kew-Gardens-1600-image.jpg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1600 900'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n      \n\n                                                  \n                                            \n                            </div>     \n                        \n                                             \n\n                    </div> \n\n                                        \n                </div>    \n\n                <div class=\"fiftyFifty__textCol ps-oh psBr psBor--dark psBg--light psColor--dark psPd-base psPd-6--large\">\n\n                    <div class=\"fiftyFifty__textWrap\">\n\n                        \n                            <span class=\"psTag psTag--yellow psMb-3\">Accessibility</span>\n                            \n                                                                                                                        \n                        <h3 class=\"ps-h-2 psMb-0\">Accessibility at Kew Gardens</h3>                                        \n                        \n                        \n                            <div class=\"psMt-4 ps-h ps-h-5\"><p>The event is held on flat ground with short grass and has accessible toilet facilities on-site. Please speak to our friendly stewards if you require any assistance. Please note that there is no parking available and no fixed drop-off point on-site.</p>\n<p>We offer WatchWord smart glasses that display subtitles for Deaf and hard of hearing guests. Availability is limited and glasses are allocated on a first-come, first-served basis. To reserve a pair, please email <a href=\"/cdn-cgi/l/email-protection#afc7cac3dfefcecbd9cac1dbdaddcaccc6c1cac2ce81ccc081dac490dcdacdc5caccdb92f8cedbccc7f8c0ddcb8ffcc2cedddb8fe8c3cedcdccadc\"><span class=\"__cf_email__\" data-cfemail=\"f49c919884b4959082919a80818691979d9a919995da979bda819f\">[email&#160;protected]</span></a> in advance of the event.</p>\n</div>\n\n                                                \n                        \n                           \n\n                    </div>                \n\n                </div>                                       \n\n            </div>    \n\n        </div>    \n\n    </section>\n\n\n        \n    \n    \n    <section \n        data-flexi-layout\n        data-block-slider-layout\n        class=\"flexiLayout flexiLayout--nt flexiLayout--nb gallerySlider psTheme--transparent\" >\n\n        <div class=\"maxWidth\">\n\n            \n            <div class=\"blockSlider__topSection\">\n\n                \n                \n         