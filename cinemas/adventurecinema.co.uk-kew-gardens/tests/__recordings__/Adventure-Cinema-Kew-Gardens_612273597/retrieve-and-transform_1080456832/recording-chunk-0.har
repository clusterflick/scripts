        \n                <div data-autoscale-heading-container>\n\n                    <h1 data-autoscale-heading class=\"psMb-0 psFont--uppercase\">Kew Gardens</h1>\n\n                </div>\n\n                \n                    <div class=\"psMt-7 ps-h ps-h-5\"><p>The UK’s No.1 outdoor cinema shows come to London's iconic Kew Gardens. Get ready for an experience like no other in this incredible setting.<br />\n<br /><b>Tickets are selling quickly for this venue!</b></p>\n</div>\n\n                           \n\n            </div>\n\n        </div>    \n\n        <div class=\"imageVideoBanner__mediaWrap psBr ps-oh\" data-media-parallax-frame>\n\n               \n\n                \n                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Kew-Gardens-Cover-Image-1140x570.jpg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Kew-Gardens-Cover-Image.jpg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 2000 1000'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n    \n             \n\n        </div>                           \n\n    </d