            </blockquote>\n\n                                    \n                                </div>\n\n                                \n                                    <div class=\"quoteCarousel__imageWrap quoteCarousel__imageWrap--right ps-rel\">\n\n                                        \n                                            <div class=\"ps-abs psBgShape quoteCarousel__bgShape quoteCarousel__bgShape--right\">\n\n                                                <svg width=\"667\" height=\"707\" viewBox=\"0 0 667 707\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                   <path fill=\"var(--violet-dk)\" d=\"M527.365 20.0405C476.985 8.81053 397.826 17.7406 328.965 71.5806C284.965 24.2506 231.445 -6.13946 178.445 1.05054C86.565 13.5105 2.54512 157.711 0.105124 263.531C-2.05488 357.261 29.1757 473.731 84.1657 537.591C135.176 596.831 193.435 620.581 247.865 621.171C278.665 664.551 321.415 693.76 374.425 703.38C507.745 727.57 571.756 598.471 627.916 448.411C684.076 298.351 699.435 58.4005 527.355 20.0305L527.365 20.0405Z\" />\n               </svg>\n                                            </div>\n\n                                                                                \n                                        <div class=\"quoteCarousel__imageInner psBor--large--light psBr ps-oh\">                                            \n\n                                            \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/12/Adventure-Cinema-29-1-760x507.jpg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/12/Adventure-Cinema-29-1-1199x800.jpg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1199 800'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n      \n\n                                        </div>\n\n                                    </div>\n\n                                                                \n\n                            </div>\n\n                        </article>                                                \n\n                    \n                                                        \n                        <article class=\"quoteCarousel__slide psFont--center psPb-2\" data-quote-carousel-slide>                            \n\n                            <div class=\"quoteCarousel__slideInner ps-rel psFullWidth\">\n\n                                \n                                    <div class=\"quoteCarousel__imageWrap quoteCarousel__imageWrap--left ps-rel\">\n                                        \n                                        \n                                            <div class=\"ps-abs psBgShape quoteCarousel__bgShape quoteCarousel__bgShape--left\">\n\n                                                <svg width=\"756\" height=\"623\" viewBox=\"0 0 756 623\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                   <path fill=\"var(--pink-dk)\" d=\"M649.933 80.5125C635.173 70.6325 562.353 21.9225 499.363 47.5725C470.143 22.2325 426.723 -5.08753 378.553 0.81247C347.313 4.64247 317.473 22.0325 291.053 4