            "mimeType": "text/html; charset=UTF-8",
            "text": "<!DOCTYPE html>\n\n<html lang=\"en\">\n\n    <head>\n        <meta charset=\"utf-8\">                        \n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n        <link rel=icon href=\"/favicon.ico?v=1.01\" />\n        <link rel=\"canonical\" href=\"\">        \n\n        <script>\n            (function () {\n                var endpoint = \"https:\\/\\/adventurecinema.co.uk\\/api\\/ps\\/v1\\/client-error\";\n                var sentCount = 0;\n                var sentKeys = {};\n                var maxEvents = 5;\n                var monitorVersion = 'head-monitor-2026-05-15.4';\n                var fontRevealDelay = 2500;\n                var visibilityCheckDelay = 4000;\n\n                function revealFonts() {\n                    try {\n                        if (document.body && document.body.classList) {\n                            document.body.classList.add('fontsLoaded');\n                            return;\n                        }\n\n                        document.addEventListener('DOMContentLoaded', revealFonts, { once: true });\n                    } catch (err) {}\n                }\n\n                window.setTimeout(revealFonts, fontRevealDelay);\n\n                function asString(value) {\n                    if (value === undefined || value === null) {\n                        return '';\n                    }\n\n                    if (typeof value === 'string') {\n                        return value;\n                    }\n\n                    try {\n                        return JSON.stringify(value);\n                    } catch (err) {\n                        return String(value);\n                    }\n                }\n\n                function getStorageState() {\n                    try {\n                        var key = 'ac_client_error_test';\n                        window.sessionStorage.setItem(key, '1');\n                        window.sessionStorage.removeItem(key);\n                        return 'ok';\n                    } catch (err) {\n                        return err && err.name ? err.name + ': ' + err.message : asString(err);\n                    }\n                }\n\n                function getBodyBackground() {\n                    if (!document.body || !window.getComputedStyle) {\n                        return '';\n                    }\n\n                    try {\n                        return window.getComputedStyle(document.body).backgroundColor;\n                    } catch (err) {\n                        return '';\n                    }\n                }\n\n                function getComputedValue(element, property) {\n                    if (!element || !window.getComputedStyle) {\n                        return '';\n                    }\n\n                    try {\n                        return window.getComputedStyle(element)[property] || '';\n                    } catch (err) {\n                        return '';\n                    }\n                }\n\n                function getMainCssState() {\n                    var state = {\n                        mainCssHref: '',\n                        mainCssLoaded: ''\n                    };\n\n                    if (!document.querySelectorAll) {\n                        return state;\n                    }\n\n                    try {\n                        var links = document.querySelectorAll('link[rel~=\"stylesheet\"]');\n\n                        for (var i = 0; i < links.length; i++) {\n                            var href = links[i].href || '';\n\n                            if (href.indexOf('/build-live/style-main.css') !== -1 || href.indexOf('/build-dev/style-main.css') !== -1) {\n                                state.mainCssHref = href;\n                                state.mainCssLoaded = links[i].sheet ? 'true' : 'false';\n                                break;\n                            }\n                        }\n                    } catch (err) {}\n\n                    return state;\n                }\n\n                function getPageState() {\n                    var body = document.body;\n                    var siteWrap = document.querySelector ? document.querySelector('[data-site-wrap], .siteWrap') : null;\n                    var pageTransition = document.querySelector ? document.querySelector('[data-page-transition-overlay]') : null;\n                    var cssState = getMainCssState();\n\n                    return {\n                        url: window.location.href,\n                        monitorVersion: monitorVersion,\n                        referrer: document.referrer || '',\n                        userAgent: window.navigator && window.navigator.userAgent ? window.navigator.userAgent : '',\n                        platform: window.navigator && window.navigator.platform ? window.navigator.platform : '',\n                        language: window.navigator && window.navigator.language ? window.navigator.language : '',\n                        viewport: (window.innerWidth || 0) + 'x' + (window.innerHeight || 0),\n                        screen: window.screen ? (window.screen.width || 0) + 'x' + (window.screen.height || 0) : '',\n                        readyState: document.readyState,\n                        bodyClass: body ? body.className : '',\n                        bodyBackground: getBodyBackground(),\n                        bodyOpacity: getComputedValue(body, 'opacity'),\n                        bodyVisibility: getComputedValue(body, 'visibility'),\n                        bodyDisplay: getComputedValue(body, 'display'),\n                        fontsLoaded: body && body.classList && body.classList.contains('fontsLoaded') ? 'true' : 'false',\n                        siteWrapFound: siteWrap ? 'true' : 'false',\n                        siteWrapOpacity: getComputedValue(siteWrap, 'opacity'),\n                        siteWrapVisibility: getComputedValue(siteWrap, 'visibility'),\n                        siteWrapDisplay: getComputedValue(siteWrap, 'display'),\n                        pageTransitionFound: pageTransition ? 'true' : 'false',\n                        pageTransitionActive: pageTransition && pageTransition.classList && pageTransition.classList.contains('psPageTransition--active') ? 'true' : 'false',\n                        pageTransitionTransform: getComputedValue(pageTransition, 'transform'),\n                        pageTransitionPointerEvents: getComputedValue(pageTransition, 'pointerEvents'),\n                        mainCssHref: cssState.mainCssHref,\n                        mainCssLoaded: cssState.mainCssLoaded,\n                        mainBundleLoaded: window.psMainBundleLoaded ? 'true' : 'false',\n                        mainInitComplete: window.psMainInitComplete ? 'true' : 'false',\n                        sessionStorage: getStorageState()\n                    };\n                }\n\n                function send(payload) {\n                    if (!endpoint || sentCount >= maxEvents) {\n                        return;\n                    }\n\n                    var state = getPageState();\n                    var fullPayload = {};\n                    var key;\n\n                    for (key in state) {\n                        if (Object.prototype.hasOwnProperty.call(state, key)) {\n                            fullPayload[key] = state[key];\n                        }\n                    }\n\n                    for (key in payload) {\n                        if (Object.prototype.hasOwnProperty.call(payload, key)) {\n                            fullPayload[key] = payload[key];\n                        }\n                    }\n\n                    var fingerprint = [\n                        fullPayload.type,\n                        fullPayload.message,\n                        fullPayload.source,\n                        fullPayload.line,\n                        fullPayload.column,\n                        fullPayload.resourceUrl\n                    ].join('|');\n\n                    if (sentKeys[fingerprint]) {\n                        return;\n                    }\n\n                    sentKeys[fingerprint] = true;\n                    sentCount++;\n\n                    try {\n                        var body = JSON.stringify(fullPayload);\n\n                        if (window.navigator && typeof window.navigator.sendBeacon === 'function' && typeof window.Blob === 'function') {\n                            try {\n                                var blob = new Blob([body], { type: 'application/json' });\n                                if (window.navigator.sendBeacon(endpoint, blob)) {\n                                    return;\n                                }\n                            } catch (err) {\n                                // Fall through to fetch/XHR.\n                            }\n                        }\n\n                        if (window.fetch) {\n                            try {\n                                window.fetch(endpoint, {\n                                    method: 'POST',\n                                    headers: { 'Content-Type': 'application/json' },\n                                    body: body,\n                                    credentials: 'same-origin',\n                                    keepalive: true\n                                });\n                                return;\n                            } catch (err) {\n                                // Fall through to XHR.\n                            }\n                        }\n\n                        var xhr = new XMLHttpRequest();\n                        xhr.open('POST', endpoint, true);\n                        xhr.setRequestHeader('Content-Type', 'application/json');\n                        xhr.send(body);\n                    } catch (err) {}\n                }\n\n                window.psReportClientIssue = function (payload) {\n                    send(payload || {});\n                };\n\n                function isBotUserAgent() {\n                    var userAgent = window.navigator && window.navigator.userAgent ? window.navigator.userAgent : '';\n                    return /bot|crawl|spider|facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp/i.test(userAgent);\n                }\n\n                function isSameOriginResource(url) {\n                    if (!url) {\n                        return false;\n                    }\n\n                    try {\n                        var parsed = document.createElement('a');\n                        parsed.href = url;\n                        return parsed.hostname === window.location.hostname;\n                    } catch (err) {\n                        return false;\n                    }\n                }\n\n                function checkPageVisibility() {\n                    if (isBotUserAgent() || !document.body || !window.getComputedStyle) {\n                        return;\n                    }\n\n                    var bodyOpacity = parseFloat(getComputedValue(document.body, 'opacity') || '1');\n                    var bodyVisibility = getComputedValue(document.body, 'visibility');\n                    var bodyDisplay = getComputedValue(document.body, 'display');\n                    var fontsLoaded = document.body.classList && document.body.classList.contains('fontsLoaded');\n\n                    if (\n                        !fontsLoaded\n                        || bodyDisplay === 'none'\n                        || bodyVisibility === 'hidden'\n                        || bodyOpacity < 0.5\n                    ) {\n                        send({\n                            type: 'page-hidden',\n                            message: 'Page still appears hidden after ' + (visibilityCheckDelay / 1000) + ' seconds'\n                        });\n\n                        revealFonts();\n                        document.body.style.opacity = '1';\n                        document.body.style.visibility = 'visible';\n                    }\n                }\n\n                window.setTimeout(checkPageVisibility, visibilityCheckDelay);\n\n                window.addEventListener('error', function (event) {\n                    if (isBotUserAgent()) {\n                        return;\n                    }\n\n                    var target = event.target || event.srcElement;\n\n                    if (target && target !== window && (target.src || target.href)) {\n                        var resourceUrl = target.src || target.href || '';\n\n                        if (!isSameOriginResource(resourceUrl)) {\n                            return;\n                        }\n\n                        send({\n                            type: 'resource-error',\n                            message: 'Resource failed to load',\n                            resourceUrl: resourceUrl,\n                            resourceTag: target.tagName || ''\n                        });\n                        return;\n                    }\n\n                    send({\n                        type: 'js-error',\n                        message: event.message || 'JavaScript error',\n                        source: event.filename || '',\n                        line: event.lineno || '',\n                        column: event.colno || '',\n                        stack: event.error && event.error.stack ? event.error.stack : ''\n                    });\n                }, true);\n\n                window.addEventListener('unhandledrejection', function (event) {\n                    if (isBotUserAgent()) {\n                        return;\n                    }\n\n                    var reason = event.reason || {};\n\n                    send({\n                        type: 'unhandled-rejection',\n                        message: reason.message || asString(reason) || 'Unhandled promise rejection',\n                        stack: reason.stack || ''\n                    });\n                });\n            }());\n        </script>\n\n        <noscript><style>body{opacity:1!important}</style></noscript>\n\n        <meta name=\"og:title\" content=\"Jurassic Park at Kew Gardens\" /><meta property=\"og:image\" content=\"https://adventurecinema.co.uk/wp-content/uploads/2026/02/Jurassic-Park-event-social-cover-1600x1600.jpeg\" /><meta name='robots' content='noindex, nofollow' />\n\n\t<!-- This site is optimized with the Yoast SEO plugin v26.9 - https://yoast.com/product/yoast-seo-wordpress/ -->\n\t<title>Jurassic Park Outdoor Cinema Experience at Kew Gardens</title>\n\t<meta name=\"description\" content=\"Welcome To Jurassic Park! A roarsome outdoor cinema experience at Kew Gardens with a screening of Spielberg&#039;s dinosaur classic!\" />\n\t<meta property=\"og:locale\" content=\"en_GB\" />\n\t<meta property=\"og:type\" content=\"article\" />\n\t<meta property=\"og:title\" content=\"Jurassic Park Outdoor Cinema Experience at Kew Gardens\" />\n\t<meta property=\"og:description\" content=\"Welcome To Jurassic Park! A roarsome outdoor cinema experience at Kew Gardens with a screening of Spielberg&#039;s dinosaur classic!\" />\n\t<meta property=\"og:url\" content=\"https://adventurecinema.co.uk/event/jurassic-park-at-kew-gardens/\" />\n\t<meta property=\"og:site_name\" content=\"Adventure Cinema\" />\n\t<meta property=\"article:publisher\" content=\"https://www.facebook.com/adventurecinemauk\" />\n\t<meta property=\"article:modified_time\" content=\"2026-05-26T11:09:39+00:00\" />\n\t<meta name=\"twitter:card\" content=\"summary_large_image\" />\n\t<script type=\"application/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://adventurecinema.co.uk/event/jurassic-park-at-kew-gardens/\",\"url\":\"https://adventurecinema.co.uk/event/jurassic-par