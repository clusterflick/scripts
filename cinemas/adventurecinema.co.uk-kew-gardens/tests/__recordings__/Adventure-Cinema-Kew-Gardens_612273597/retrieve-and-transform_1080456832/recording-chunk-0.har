                 <span>Dirty </span>\n\n                        \n                    \n                        \n                        \n                            <span class=\"psWs--nw psInlineFlex\">\n                                <span>Dancing</span>\n                                <span class=\"ps-h ps-h-5 psMb-0 psMt-a psLh--inherit psMl-5 psLh--1\" data-autoscale-heading-suffix>(12)</span>\n                            </span>\n\n                        \n                    \n                \n            </h1>            </div>             \n\n                                \n                <button class=\"psButton psButton--secondary psMt-6\" \n                        data-eb-widget-trigger\n                        data-eb-event-id=\"1983757948425\"                >   \n                    <span class=\"psButton__bg\"></span>\n                    <span class=\"psButton__labelWrapper\">\n                        <span class=\"psButton__label\">Get Tickets</span>\n                        <span class=\"psButton__labelHover\">Get Tickets</span>\n                    </span>\n                </button>                \n\n            \n        </div>                                     \n    \n    </div>\n\n</section>\n\n<section>\n\n    <div class=\"maxWidth\">\n        \n        \n<div class=\"eventInfoPanel psBg--light psBor--dark psBr ps-oh\">\n\n    <div class=\"eventInfoPanel__inner psFlex psFlex--column-mobile psGap-5--mobile psGap-9\">\n\n        <div>\n\n            <span class=\"psDb psMb-2\">Time</span>\n\n                            <span class=\"ps-h ps-h-4 psDb psMb-2\">Gates: 18:00</span>\n            \n                            <span class=\"ps-h ps-h-4 psDb psMb-0\">Showtime: 19:30 - 21:20</span>\n            \n        </div>\n\n        <div>\n        \n            <span class=\"psDb psMb-2\">Location</span>\n                        \n            <span class=\"ps-h ps-h-4 psMb-0 psDb\">\n                Kew Gardens,\n                <p>Richmond<br />\nLondon<br />\nTW9 2DF</p>\n            </span>            \n\n            \n\n    \n\n    <a \n        class=\"psButton psButton--primary psMt-base--mobile psMt-4 psFlex--noShrink\"  \n        href=\"https://adventurecinema.co.uk/venues/kew-gardens/\" \n                \n    >   \n        <span class=\"psButton__bg\"></span>\n\n        <span class=\"psButton__labelWrapper\">\n            <span class=\"psButton__label\">View Venue Page</span>\n            <span class=\"psButton__labelHover\">View Venue Page</span>\n        </span>\n    </a>\n\n   \n\n        </div>\n\n    </div>\n\n</div>        \n    </div>\n\n</section>\n\n\n        \n    <section class=\"flexiLayout flexiLayout--nt flexiLayout--nb statementText\">\n\n        <div class=\"maxWidth maxWidth--narrow\">\n                                \n            <div class=\"psFont--center\">\n\n                                    <h2 class=\"psMb-7\">What to expect at the Dirty Dancing outdoor cinema experience...</h2>\n                \n                <div class=\"ps-h ps-h-5\"><p>Nobody puts baby in the corner!</p>\n<p>Get ready for an unforgettable night of music, romance, and legendary dance moves as Dirty Dancing lights up the big screen under the stars. </p>\n<p>Sing along to the iconic soundtrack, soak up the atmosphere, and enjoy this classic movie, starring Patrick Swayze and Jennifer Grey, in a magical outdoor cinema setting.</p>\n<p>Plus music to enjoy before the movie with a soundtrack of specially curated songs.</p>\n</div>                \n\n            </div>             \n\n        </div>    \n        \n    </section>\n\n\n<div class=\"flexibleSections\">\n\n    \n            \n    <section class=\"flexiLayout flexiLayout--nt flexiLayout--nb freeText psTheme--pink-lt\">\n\n        <div class=\"maxWidth\">\n\n            <div class=\"freeText__inner psFlex--largeUp ps-rel ps-z-1\">\n                    \n                <div class=\"psMb-6\">\n                    <h3>The Summer Romance Returns</h3>\n                </div>\n\n                <div class=\"freeText__contentCol ps-h ps-h-6 psMb-0 psDefaultContent\">\n                    <p><iframe loading=\"lazy\" title=\"Dirty Dancing (1987 Movie) Official 35th Anniversary Trailer - Patrick Swayze, Jennifer Grey\" width=\"500\" height=\"281\" src=\"https://www.youtube.com/embed/0rzsa_KEoKs?start=1&#038;feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe></p>\n                </div>  \n\n            </div>\n            \n        </div>\n        \n    </section>\n\n\n                \n    <section class=\"flexiLayout flexiLayout--nt flexiLayout--nb facilityIcons psTheme--transparent\">\n\n        <div class=\"maxWidth psFont--center\">            \n            \n                        \n            <div class=\"facilityIcons__inner psBg--light psBor--dark psBr ps-oh\">\n\n                <div class=\"psFlex psFlex--center psFlex--top-align psFlex--wrap psGap-6\">\n\n                                        \n                        <div class=\"facilityIcons__block\">\n\n                            <div class=\"facilityIcons__iconWrap psMb-a\">\n\n                                                    \n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-food.svg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-food.svg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitContain facilityIcons__icon\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n     \n\n                            </div>\n\n                            <span class=\"psDb ps-h ps-h-6 psMt-4 psMb-0\">Hot food and snacks available</span>\n\n                        </div>\n\n                                        \n                        <div class=\"facilityIcons__block\">\n\n                            <div class=\"facilityIcons__iconWrap psMb-a\">\n\n                                                    \n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-drinks.svg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-drinks.svg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitContain facilityIcons__icon\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n     \n\n                            </div>\n\n                            <span class=\"psDb ps-h ps-h-6 psMt-4 psMb-0\">On-site bar</span>\n\n                        </div>\n\n                                        \n                        <div class=\"facilityIcons__block\">\n\n                            <div class=\"facilityIcons__iconWrap psMb-a\">\n\n                                                    \n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-picnics.svg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-picnics.svg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitContain facilityIcons__icon\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n     \n\n                            </div>\n\n                            <span class=\"psDb ps-h ps-h-6 psMt-4 psMb-0\">Picnics and drinks welcome</span>\n\n                        </div>\n\n                                        \n                        <div class=\"facilityIcons__block\">\n\n                            <div class=\"facilityIcons__iconWrap psMb-a\">\n\n                                                    \n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-dogs.svg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-dogs.svg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitContain facilityIcons__icon\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n     \n\n                            </div>\n\n                            <span class=\"psDb ps-h ps-h-6 psMt-4 psMb-0\">No dogs, except assistance or guide dogs</span>\n\n                        </div>\n\n                                        \n                        <div class=\"facilityIcons__block\">\n\n                            <div class=\"facilityIcons__iconWrap psMb-a\"