      <span class=\"psButton__label\">More Info</span>\n                        <span class=\"psButton__labelHover\">More Info</span>\n                    </span>\n                </a>\n\n                \n                    <span class=\"psButton psButton--disabled psFullWidth\">\n                        Sold Out\n                    </span>\n\n                \n            </div>   \n\n        </div>\n\n    </div>\n\n</div>\n\n                                                    \n                    \n<div data-block-slide class=\"blockSlider__slide psMr-5 ps-rel\">                      \n\n    <div class=\"blockLinks__card psBr psBor--dark ps-oh psDb ps-no-td\">\n\n        \n            <a href=\"https://adventurecinema.co.uk/event/pride-and-prejudice-at-kew-gardens/\" class=\"blockLinks__mediaWrap psDb\">\n\n                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/02/Pride-and-Prejudice-site-pic-760x506.jpg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/02/Pride-and-Prejudice-site-pic-1201x800.jpg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1201 800'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover blockLinks__media\"\n                                                loading=\"lazy\"\n     