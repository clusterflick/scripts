                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n    \n         \n\n    </div>  \n\n    <div class=\"fullscreenMediaBanner__content ps-abs ps-abs--center-bottom psColor--light ps-z-1 psPt-6 psPb-6\">           \n\n        <div class=\"maxWidth\">                                                                          \n\n                                     \n                <div class=\"psMb-base\">\n                    \n\n    <span class=\"psLabel psLabel--alert\" data-alert-label>  \n        <svg class=\"psFill--none psHgt-1e\" viewBox=\"0 0 10 10\">\n                    <path class=\"psFill--dark\" d=\"M5.14614 1.51576C5.14614 1.51576 6.31703 -0.606754 7.76708 0.171535C9.22306 0.953101 8.83485 2.17215 7.76708 2.95371C7.76708 2.95371 9.96741 2.64109 9.99964 4.92319C10.032 7.2053 7.89648 7.01769 7.89648 7.01769C7.89648 7.01769 9.38553 8.53085 8.09067 9.51854C6.8611 10.4564 5.53452 9.61226 5.08153 8.36192C5.08153 8.36192 3.98136 10.8315 1.84581 9.70615C-0.174419 8.64161 1.81342 6.54875 1.81342 6.54875C1.81342 6.54875 -0.289742 6.73636 0.0338472 4.82947C0.357436 2.92258 2.49299 3.70415 2.49299 3.70415C2.49299 3.70415 0.551623 2.016 2.68717 0.796952C4.29732 -0.122249 5.14631 1.51593 5.14631 1.51593L5.14614 1.51576Z\" />\n                </svg>        SOLD OUT!        <svg class=\"psFill--none psHgt-1e\" viewBox=\"0 0 10 10\">\n                    <path class=\"psFill--dark\" d=\"M5.14614 1.51576C5.14614 1.51576 6.31703 -0.606754 7.76708 0.171535C9.22306 0.953101 8.83485 2.17215 7.76708 2.95371C7.76708 2.95371 9.96741 2.64109 9.99964 4.92319C10.032 7.2053 7.89648 7.01769 7.89648 7.01769C7.89648 7.01769 9.38553 8.53085 8.09067 9.51854C6.8611 10.4564 5.53452 9.61226 5.08153 8.36192C5.08153 8.36192 3.98136 10.8315 1.84581 9.70615C-0.174419 8.64161 1.81342 6.54875 1.81342 6.54875C1.81342 6.54875 -0.289742 6.73636 0.0338472 4.82947C0.357436 2.92258 2.49299 3.70415 2.49299 3.70415C2.49299 3.70415 0.551623 2.016 2.68717 0.796952C4.29732 -0.122249 5.14631 1.51593 5.14631 1.51593L5.14614 1.51576Z\" />\n                </svg>    </span>\n    \n                </div>\n\n                        \n            <h3 class=\"psMb-2--mobile psMb-1\">\n                Sunday, June 21                <br>\n                <span class=\"psDb psIgnoreBr psMt-1\">\n                    Kew Gardens, London                </span>\n            </h3>\n\n            <div class=\"psFlex\" data-autoscale-heading-container>  \n                <h1 class=\"psMb-0 psFont--uppercase\" data-autoscale-heading>\n\n                \n                    \n                    \n                        \n                        \n                            <span>Pride </span>\n\n                        \n                    \n                        \n                        \n                            <span>&amp; </span>\n\n                        \n                    \n                        \n                        \n                            <span class=\"psWs--nw psInlineFlex\">\n                                <span>Prejudice</span>\n                                <span class=\"ps-h ps-h-5 psMb-0 psMt-a psLh--inherit psMl-5 psLh--1\" data-autoscale-heading-suffix>(U)</span>\n                            </span>\n\n                        \n                    \n                \n            </h1>            </div>             \n\n                                \n                <button class=\"psButton psButton--secondary psMt-6\" \n                        data-eb-widget-trigger\n                        data-eb-event-id=\"1983758376706\"                >   \n                    <span class=\"psButton__bg\"></span>\n                    <span class=\"psButton__labelWrapper\">\n                        <span class=\"psButton__label\">Get Tickets</span>\n                        <span class=\"psButton__labelHover\">Get Tickets</span>\n                    </span>\n                </button>                \n\n            \n        </div>                                     \n    \n    </div>\n\n</section>\n\n<section>\n\n    <div class=\"maxWidth\">\n        \n        \n<div class=\"eventInfoPanel psBg--light psBor--dark psBr ps-oh\">\n\n    <div class=\"eventInfoPanel__inner psFlex psFlex--column-mobile psGap-5--mobile psGap-9\">\n\n        <div>\n\n            <span class=\"psDb psMb-2\">Time</span>\n\n                            <span class=\"ps-h ps-h-4 psDb psMb-2\">Gates: 13:30</span>\n            \n                            <span class=\"ps-h ps-h-4 psDb psMb-0\">Showtime: 15:00 - 17:15</span>\n            \n        </div>\n\n        <div>\n        \n            <span class=\"psDb psMb-2\">Location</span>\n                        \n            <span class=\"ps-h ps-h-4 psMb-0 psDb\">\n                Kew Gardens,\n                <p>Richmond<br />\nLondon<br />\nTW9 2DF</p>\n            </span>            \n\n            \n\n    \n\n    <a \n        class=\"psButton psButton--primary psMt-base--mobile psMt-4 psFlex--noShrink\"  \n        href=\"https://adventurecinema.co.uk/venues/kew-gardens/\" \n                \n    >   \n        <span class=\"psButton__bg\"></span>\n\n        <span class=\"psButton__labelWrapper\">\n            <span class=\"psButton__label\">View Venue Page</span>\n            <span class=\"psButton__labelHover\">View Venue Page</span>\n        </span>\n    </a>\n\n   \n\n        </div>\n\n    </div>\n\n</div>        \n    </div>\n\n</section>\n\n\n        \n    <section class=\"flexiLayout flexiLayout--nt flexiLayout--nb statementText\">\n\n        <div class=\"maxWidth maxWidth--narrow\">\n                                \n            <div class=\"psFont--center\">\n\n                                    <h2 class=\"psMb-7\">What to expect at the Pride & Prejudice outdoor cinema experience...</h2>\n                \n                <div class=\"ps-h ps-h-5\"><p><I>“You have bewitched me, body and soul...”</I></p>\n<p>Join us for a magical open-air screening of Pride & Prejudice!</p>\n<p>This beloved adaptation of Jane Austen’s classic novel, starring Keira Knightley and Matthew Macfadyen is filled with wit, drama, and sweeping romance.</p>\n<p>Soak up the atmosphere, and enjoy this timeless love story on the big screen in a truly unforgettable setting.</p>\n<p>Plus music to enjoy before the movie with a soundtrack of specially curated songs.</p>\n</div>                \n\n            </div>             \n\n        </div>    \n        \n    </section>\n\n\n<div class=\"flexibleSections\">\n\n    \n            \n    <section class=\"flexiLayout flexiLayout--nt flexiLayout--nb freeText psTheme--pink-dk\">\n\n        <div class=\"maxWidth\">\n\n            <div class=\"freeText__inner psFlex--largeUp ps-rel ps-z-1\">\n                    \n                <div class=\"psMb-6\">\n                    <h3>The Story That Stole Hearts</h3>\n                </div>\n\n                <div class=\"freeText__contentCol ps-h ps-h-6 psMb-0 psDefaultContent\">\n                    <p><iframe loading=\"lazy\" title=\"Pride &amp; Prejudice (2005) Official Trailer\" width=\"500\" height=\"281\" src=\"https://www.youtube.com/embed/Ur_DIHs92NM?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe></p>\n                </div>  \n\n            </div>\n            \n        </div>\n        \n    </section>\n\n\n                \n    <section class=\"flexiLayout flexiLayout--nt flexiLayout--nb facilityIcons psTheme--transparent\">\n\n        <div class=\"maxWidth psFont--center\">            \n            \n                        \n            <div class=\"facilityIcons__inner psBg--light psBor--dark psBr ps-oh\">\n\n                <div class=\"psFlex psFlex--center psFlex--top-align psFlex--wrap psGap-6\">\n\n                                        \n                        <div class=\"facilityIcons__block\">\n\n                            <div class=\"facilityIcons__iconWrap psMb-a\">\n\n                                                    \n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-food.svg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-food.svg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitContain facilityIcons__icon\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n     \n\n                            </div>\n\n                            <span class=\"psDb ps-h ps-h-6 psMt-4 psMb-0\">Hot food and snacks available</span>\n\n                        </div>\n\n                                        \n                        <div class=\"facilityIcons__block\">\n\n                            <div class=\"facilityIcons__iconWrap psMb-a\">\n\n                                                    \n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-drinks.svg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-drinks.svg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitContain facilityIcons__icon\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n     \n\n                            </div>\n\n                            <span class=\"psDb ps-h ps-h-6 psMt-4 psMb-0\">On-site bar</span>\n\n                        </div>\n\n                                        \n                        <div class=\"facilityIcons__block\">\n\n                            <div class=\"facilityIcons__iconWrap psMb-a\">\n\n                                                    \n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-picnics.svg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-picnics.svg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitContain facilityIcons__icon\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n     \n\n                            </div>\n\n                            <span class=\"psDb ps-h ps-h-6 psMt-4 psMb-0\">Picnics and drinks welcome</span>\n\n                        </div>\n\n                                        \n                        <div class=\"facilityIcons__block\">\n\n                            <div class=\"facilityIcons__iconWrap psMb-a\">\n\n                                                    \n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-dogs.svg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-dogs.svg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitContain facilityIcons__icon\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n     \n\n                            </div>\n\n                            <span class=\"psDb ps-h ps-h-6 psMt-4 psMb-0\">No dogs, except assistance or guide dogs</span>\n\n                        </div>\n\n                                        \n                        <div class=\"facilityIcons__block\">\n\n                            <div class=\"facilityIcons__iconWrap psMb-a\">\n\n                                                    \n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-glass.svg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-glass.svg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitContain facilityIcons__icon\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n     \n\n                            </div>\n\n                            <span class=\"psDb ps-h ps-h-6 psMt-4 psMb-0\">No glass allowed in</span>\n\n                        </div>\n\n                    \n                </div>\n\n            </div>\n            \n        </div>\n        \n    </section>\n\n\n    \n\n        \n    <section \n        data-flexi-layout \n        class=\"upcomingEvents psPt-6 psPb-6 blockLinks ps-rel\"\n    >\n\n        <div class=\"maxWidth\">\n\n            <div class=\"blockSlider__topSection psFlex psFlex--spaceBetween--start psGap-5 ps-rel ps-z-1\">                           \n                \n                <h2 class=\"ps-h ps-h-5 psMb-0\">Other shows at this venue</h2>                                                 \n\n            </div>\n\n            <div class=\"ps-rel ps-z-1 psGrid--x1s-x2ml-x3l\">\n\n                                                    \n                    \n<div data-block-slide class=\"blockSlider__slide psMr-5 ps-rel\">                      \n\n    <div class=\"blockLinks__card psBr psBor--dark ps-oh psDb ps-no-td\">\n\n        \n            <a href=\"https://adventurecinema.co.uk/event/wicked-for-good-at-kew-gardens/\" class=\"blockLinks__mediaWrap psDb\">\n\n                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/02/Wicked-For-Good-site-pic-760x506.png\" \n                            media=\"(max-width: 1023px)\">\n                        \n                   