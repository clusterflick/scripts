          <div class=\"quoteCarousel__imageWrap quoteCarousel__imageWrap--left ps-rel\">\n                                        \n                                        \n                                            <div class=\"ps-abs psBgShape quoteCarousel__bgShape quoteCarousel__bgShape--left\">\n\n                                                <svg width=\"731\" height=\"640\" viewBox=\"0 0 731 640\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                   <path fill=\"var(--green-dk)\" d=\"M663.512 58.3169C616.742 34.1269 549.412 42.1269 475.612 107.257C412.822 20.6769 313.122 -18.9631 253.792 8.72692C179.612 43.3569 177.262 164.637 161.292 232.077C135.952 339.047 -19.3576 364.717 2.01239 494.987C19.8424 603.687 250.212 714.227 408.552 572.177C453.692 626.557 512.782 654.707 564.792 631.027C680.672 578.267 539.462 447.317 640.842 323.117C745.142 195.347 764.732 110.667 663.522 58.3169H663.512Z\" />\n               </svg>\n                                            </div>\n\n                                                                                \n                                        <div class=\"quoteCarousel__imageInner psBr psBor--large--light ps-oh\">                                            \n\n                                            \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/mamma-mia-quote-image-7-760x760.png\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/mamma-mia-quote-image-7.png\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 800 800'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n      \n\n                                        </div>\n\n                                    </div>\n\n                                \n                                <div class=\"quoteCarousel__textWrap ps-rel ps-z-1\">                                                    \n\n                                    \n                                        <h4 class=\"quoteCarousel__heading psMb-0\">What People Are Saying</h4>\n\n                                    \n                                    \n                                        <blockquote class=\"ps-rel pz-z-1 psPl-0 psMb-0 psBor--none\">\n\n                                            <p class=\"ps-h ps-h-5 psPt-4\">\"Such a fun night! Lots of singing and dancing and lots of food and drinks! It was such a lovely environment and all the staff were so lovely. The best way to spend my 20th birthday! Thank you so much!!\"</p>\n\n                                                                                            <cite class=\"psTag psTag--yellow psMt-3\">Niamh</cite>\n                                            \n                                        </blockquote>\n\n                                    \n                                </div>\n\n                                \n                                    <div class=\"quoteCarousel__imageWrap quoteCarousel__imageWrap--right ps-rel\">\n\n                                        \n                                            <div class=\"p