.9077 16.0171 23.8166 16.0506 23.7316C16.0842 23.6466 16.1333 23.5694 16.1953 23.5044Z\" />\n        </svg>\n        \n    </button>\n\n    <button class=\"psCarouselControls__control psUnstyledButton\" data-carousel-control-next type=\"button\" aria-label=\"Next\">\n         \n        <svg class=\"psCarouselControls__svg psFill--none psPe--none\" viewBox=\"0 0 48 48\">\n            <path class=\"psFill--light\" d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n            <path class=\"psStroke--dark\" d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n            <path class=\"psFill--dark psStroke--none\" d=\"M31.8047 24.4956L25.8049 30.7951C25.7116 30.8931 25.5928 30.9598 25.4634 30.9869C25.334 31.0139 25.1999 31.0001 25.078 30.9471C24.9562 30.894 24.852 30.8042 24.7788 30.689C24.7055 30.5738 24.6665 30.4384 24.6666 30.2999V24.7003H16.6668C16.49 24.7003 16.3205 24.6266 16.1955 24.4953C16.0704 24.364 16.0002 24.186 16.0002 24.0004C16.0002 23.8147 16.0704 23.6367 16.1955 23.5054C16.3205 23.3742 16.49 23.3004 16.6668 23.3004H24.6666V17.7009C24.6665 17.5623 24.7055 17.4269 24.7788 17.3117C24.852 17.1965 24.9562 17.1067 25.078 17.0537C25.1999 17.0007 25.334 16.9868 25.4634 17.0138C25.5928 17.0409 25.7116 17.1077 25.8049 17.2057L31.8047 23.5052C31.8667 23.5702 31.9158 23.6474 31.9494 23.7323C31.9829 23.8173 32.0002 23.9084 32.0002 24.0004C32.0002 24.0924 31.9829 24.1834 31.9494 24.2684C31.9158 24.3534 31.8667 24.4306 31.8047 24.4956Z\" />\n        </svg>\n\n    </button>\n\n</div>                     </div>\n\n                \n            </div>\n\n        </div>\n\n        <div class=\"maxWidth maxWidth--noPadSmlMed\">\n\n            <div class=\"gallerySlider__inner ps-rel ps-z-5\">\n            \n                <div data-block-s