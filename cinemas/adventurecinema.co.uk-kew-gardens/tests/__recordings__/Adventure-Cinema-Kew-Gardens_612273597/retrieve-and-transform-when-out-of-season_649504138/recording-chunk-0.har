8L21.8789 20.3788L27.8789 26.3788L26.3789 27.8788L20.3789 21.8788L14.3789 27.8788Z\" />\n                    </svg>\n\n\n                </button>   \n                \n            </div>\n\n        </div>\n\n    </div>\n\n</header>\n        \n            \n            <div class=\"siteWrap\" data-site-wrap>\n\n                <section class=\"imageVideoBanner psPt-7 psMb-6 ps-rel\">\n            \n    <div data-bg-shape class=\"ps-abs psBgShape psBgShape--1\"><svg width=\"590\" height=\"611\" viewBox=\"0 0 590 611\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                   <path fill=\"var(--pink-lt)\" d=\"M303.436 92.509C303.436 92.509 372.476 -37.031 457.976 10.469C543.826 58.169 520.936 132.569 457.976 180.269C457.976 180.269 587.716 161.189 589.616 300.469C591.526 439.749 465.606 428.299 465.606 428.299C465.606 428.299 553.406 520.649 477.056 580.929C404.556 638.169 326.336 586.649 299.626 510.339C299.626 510.339 234.756 661.059 108.836 592.379C-10.2844 527.409 106.926 399.679 106.926 399.679C106.926 399.679 -17.0842 411.129 1.99576 294.749C21.0758 178.369 146.996 226.069 146.996 226.069C146.996 226.069 32.5257 123.039 158.446 48.639C253.386 -7.46099 303.446 92.519 303.446 92.519L303.436 92.509Z\" />\n               </svg></div> \n\n    <div class=\"maxWidth ps-rel\">    \n        \n        \n\n    <a href=\"/venues\" class=\"psButton psButton--text psButton--text--dark psMb-4--mobile psMb-2\">\n\n        <span>Back to all Venues</span>\n\n        <svg class=\"psButton--text__line\" width=\"300%\" height=\"100%\" viewBox=\"0 0 1200 60\" preserveAspectRatio=\"none\">\n            <path d=\"M0,56.5c0,0,298.666,0,399.333,0C448.336,56.5,513.994,46,597,46c77.327,0,135,10.5,200.999,10.5c95.996,0,402.001,0,402.001,0\"></path>\n        </svg>\n    </a>\n\n        \n        <div class=\"imageVideoBanner__content\">                                \n        \n            <div class=\"imageVideoBanner__contentInner\">                                \n                \n                <div data-autoscale-heading-container>\n\n                    <h1 data-autoscale-heading class=\"psMb-0 psFont--uppercase\">Kew Gardens</h1>\n\n                </div>\n\n                \n                    <div class=\"psMt-7 ps-h ps-h-5\"><p>The UK’s No.1 outdoor cinema shows come to London's iconic Kew Gardens. Get ready for an experience like no other in this incredible setting.<br />\n<br /><b>Tickets are selling quickly for this venue!</b></p>\n</div>\n\n                           \n\n            </div>\n\n        </div>    \n\n        <div class=\"imageVideoBanner__mediaWrap psBr ps-oh\" data-media-parallax-frame>\n\n               \n\n                \n                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Kew-Gardens-Cover-Image-1140x570.jpg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Kew-Gardens-Cover-Image.jpg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 2000 1000'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n    \n             \n\n        </div>                           \n\n    </div> \n\n</section>\n\n\n\n\n\t<div class=\"flexibleSections ps-rel\">\n\n                \n                    \n    <section class=\"flexiLayout flexiLayout--nt flexiLayout--nb statementText psTheme--transparent\">\n\n        <div class=\"maxWidth maxWidth--narrow ps-rel ps-z-5\">\n                                \n            <div class=\"psFont--center\">\n\n                                    <h2 class=\"psMb-5--largeDown psMb-7\">Kew The Movies - Presented by Adventure Cinema</h2>\n                \n                <div class=\"ps-h ps-h-5 ps-h-mobile-6\"><p>A UNESCO World Heritage Site, Kew Gardens is home to one of the largest and most diverse plant collections anywhere in the world. Spanning vast landscapes filled with rare plants, historic glasshouses and beautifully curated gardens, it’s one of London’s most extraordinary destinations. Let the lush surroundings of this world-famous botanical paradise set the scene for a truly special cinematic experience.</p>\n<p><a href=\"https://www.kew.org/\" target=\"_blank\" rel=\"noopener noreferrer\">Learn more about Kew Gardens here.</a></p>\n</div>                \n\n            </div>             \n\n        </div>    \n        \n    </section>\n\n                \n                        \n    <section class=\"flexiLayout flexiLayout--nt flexiLayout--nb facilityIcons psTheme--transparent\">\n\n        <div class=\"maxWidth psFont--center\">            \n            \n                        \n            <div class=\"facilityIcons__inner psBg--light psBor--dark psBr ps-oh\">\n\n                <div class=\"psFlex psFlex--center psFlex--top-align psFlex--wrap psGap-6\">\n\n                                        \n                        <div class=\"facilityIcons__block\">\n\n                            <div class=\"facilityIcons__iconWrap psMb-a\">\n\n                                                    \n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-food.svg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-food.svg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitContain facilityIcons__icon\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n     \n\n                            </div>\n\n                            <span class=\"psDb ps-h ps-h-6 psMt-4 psMb-0\">Hot food and snacks available</span>\n\n                        </div>\n\n                                        \n                        <div class=\"facilityIcons__block\">\n\n                            <div class=\"facilityIcons__iconWrap psMb-a\">\n\n                                                    \n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-drinks.svg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-drinks.svg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitContain facilityIcons__icon\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n     \n\n                            </div>\n\n                            <span class=\"psDb ps-h ps-h-6 psMt-4 psMb-0\">On-site bar</span>\n\n                        </div>\n\n                                        \n                        <div class=\"facilityIcons__block\">\n\n                            <div class=\"facilityIcons__iconWrap psMb-a\">\n\n                                                    \n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-picnics.svg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-picnics.svg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitContain facilityIcons__icon\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n     \n\n                            </div>\n\n                            <span class=\"psDb ps-h ps-h-6 psMt-4 psMb-0\">Picnics and drinks welcome</span>\n\n                        </div>\n\n                                        \n                        <div class=\"facilityIcons__block\">\n\n                            <div class=\"facilityIcons__iconWrap psMb-a\">\n\n                                                    \n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-dogs.svg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-dogs.svg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitContain facilityIcons__icon\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n     \n\n                            </div>\n\n                            <span class=\"psDb ps-h ps-h-6 psMt-4 psMb-0\">No dogs, except assistance or guide dogs</span>\n\n                        </div>\n\n                                        \n                        <div class=\"facilityIcons__block\">\n\n                            <div class=\"facilityIcons__iconWrap psMb-a\">\n\n                                                    \n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-glass.svg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2025/11/facility-icon-glass.svg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitContain facilityIcons__icon\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n     \n\n                            </div>\n\n                            <span class=\"psDb ps-h ps-h-6 psMt-4 psMb-0\">No glass allowed in</span>\n\n                        </div>\n\n                    \n                </div>\n\n            </div>\n            \n        </div>\n        \n    </section>\n\n                \n                    \n    <section class=\"flexiLayout flexiLayout--nt flexiLayout--nb freeText psTheme--transparent\">\n\n        <div class=\"maxWidth\">\n\n            <div class=\"freeText__inner psFlex--largeUp ps-rel ps-z-1\">\n                    \n                <div class=\"psMb-6\">\n                    <h3>Everything you need to know about screenings at Kew Gardens</h3>\n                </div>\n\n                <div class=\"freeText__contentCol ps-h ps-h-6 psMb-0 psDefaultContent\">\n                    <p>Screenings take place on the lawn, near the Pavilion Bar and Grill. Please follow directional signage and steward’s directions. See the event location on <a href=\"https://maps.app.goo.gl/AvnyWyaJNGccsY2Y8\" target=\"_blank\" rel=\"noopener\">Google Maps here</a>.</p>\n<p><strong>We recommend entering via <a href=\"https://maps.app.goo.gl/DpgDVVB6Fv6LmZgy5\" target=\"_blank\" rel=\"noopener\">Lion Gate</a> on Kew Road (TW9 2DF), opposite Lion Gate Gardens, for the easiest access.</strong></p>\n<p>For evening screenings, entrance must be via <a href=\"https://maps.app.goo.gl/DpgDVVB6Fv6LmZgy5\" target=\"_blank\" rel=\"noopener\">Lion Gate</a>, and the exit will be through <a href=\"https://maps.app.goo.gl/gGb2XwTzAfunb4n7A\" target=\"_blank\" rel=\"noopener\">Pavilion Gate</a> onto Kew Road (all other gates will be closed).</p>\n<p>You can only access the event location at the time of your screening, please check the gates opening time listed on your chosen show.</p>\n<p>We strongly recommend using public transport, taxi or travelling on foot where possible.</p>\n<p>There is no designated event car park available, guests can make use of nearby public car parks and pay and display options.</p>\n<p>Please note that Kew Gardens&#8217; car park near Brentford Gate will be closed during the evening screenings.</p>\n<p><em><strong>No access is permitted before the gates opening time listed on your chosen show.</strong></em></p>\n                </div>  \n\n            </div>\n            \n        </div>\n        \n    </section>\n\n                \n                    \n    \n    <section \n        data-flexi-layout \n                class=\"flexiLayout flexiLayout--nt flexiLayout--nb fiftyFifty psTheme--transparent\"\n    >\n\n        <div class=\"maxWidth\">\n\n            <div class=\"fiftyFifty__inner fiftyFifty__inner--reversed\">  \n                \n                <div class=\"fiftyFifty__mediaCol psBr psBor--dark ps-oh ps-rel\">\n\n                    <div class=\"fiftyFifty__mediaSlide\" >                  \n                                            \n                        \n                            <div class=\"fiftyFifty__mediaWrap ps-oh\" > \n\n                                \n                                                    \n                                    \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Kew-Gardens-1600-image-760x428.jpg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Kew-Gardens-1600-image.jpg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 1600 900'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n      \n\n                                                  \n                                            \n                            </div>     \n                        \n                                             \n\n                    </div> \n\n                                        \n                </div>    \n\n                <div class=\"fiftyFifty__textCol ps-oh psBr psBor--dark psBg--light psColor--dark psPd-base psPd-6--large\">\n\n                    <div class=\"fiftyFifty__textWrap\">\n\n                        \n                            <span class=\"psTag psTag--yellow psMb-3\">Accessibility</span>\n                            \n                                                                                                                        \n                        <h3 class=\"ps-h-2 psMb-0\">Accessibility at Kew Gardens</h3>                                        \n                        \n                        \n                            <div class=\"psMt-4 ps-h ps-h-5\"><p>The event is held on flat ground with short grass and has accessible toilet facilities on-site. Please speak to our friendly stewards if you require any assistance. Please note that there is no parking available and no fixed drop-off point on-site.</p>\n<p>We offer WatchWord smart glasses that display subtitles for Deaf and hard of hearing guests. Availability is limited and glasses are allocated on a first-come, first-served basis. To reserve a pair, please email <a href=\"/cdn-cgi/l/email-protection#28404d445868494c5e4d465c5d5a4d4b41464d4549064b47065d43175b5d4a424d4b5c157f495c4b407f475a4c087b45495a5c086f44495b5b4d5b\"><span class=\"__cf_email__\" data-cfemail=\"c2aaa7aeb282a3a6b4a7acb6b7b0a7a1abaca7afa3eca1adecb7a9\">[email&#160;protected]</span></a> in advance of the event.</p>\n</div>\n\n                                                \n                        \n                           \n\n                    </div>                \n\n                </div>                                       \n\n            </div>    \n\n        </div>    \n\n    </section>\n\n                \n                    \n     \n    \n    \n        \n        <section \n            data-flexi-layout         \n            class=\"flexiLayout flexiLayout--nt flexiLayout--nb map psTheme--transparent\"\n        >\n\n            <div class=\"maxWidth\">\n\n                <div class=\"map__inner ps-rel ps-z-5\">  \n                                        \n                    <div class=\"map__mapCol psBr--large psBor--dark ps-oh ps-rel\">\n                            \n                        <iframe \n                            width=\"100%\" \n                            height=\"100%\" \n                            class=\"map__embed\"\n                            frameborder=\"0\" \n                            style=\"border:0\"\n                            src=\"https://maps.google.com/maps?q=51.472352156498,-0.2947935461998&z=14&output=embed&t=k\" \n                            allowfullscreen \n                            loading=\"lazy\"\n                        ></iframe>                        \n                        \n                    </div>    \n                    \n                    <div class=\"map__textCol ps-oh psBr--large psBor--dark psBg--light psColor--dark psPd-6\">\n\n                        <div class=\"map__textWrap\">\n\n                            <span class=\"psTag psTag--yellow psMb-3\">Getting Here</span>\n\n                            <h3 class=\"ps-h-2 psMb-0\">\n                                Where is Kew Gardens?\n                            </h3>                                      \n                                  \n                            <span class=\"ps-h ps-h-5 psMb-0 psDb psMt-5\">\n                                <p>Richmond<br />\nLondon<br />\nTW9 2DF</p>\n                            </span> \n                            \n                            <a class=\"psMt-5 psButton psButton--secondary\" href=\"https://www.google.com/maps/dir/?api=1&destination=51.472352156498,-0.2947935461998\" target=\"_blank\" rel=\"noopener\">\n                                <span class=\"psButton__bg\"></span>\n                                <span class=\"psButton__labelWrapper\">\n                                    <span class=\"psButton__label\">Get Directions</span>\n                                    <span class=\"psButton__labelHover\">Get Directions</span>\n                                </span>\n                            </a>\n\n                        </div>                \n\n                    </div>                                       \n\n                </div>    \n\n            </div>    \n\n        </section>\n\n    \n                \n            \n\n    \n    \n                \n                    \n                    \n    \n    <section \n        data-flexi-layout\n        class=\"flexiLayout flexiLayout--nt flexiLayout--nb galleryScroller psTheme--transparent\"\n    >\n\n        <div class=\"galleryScroller___inner ps-rel psPt-base\">\n\n            \n                <div class=\"galleryScroller__row psFlex psGap-4 psMb-4\" data-speed=\"-0.15\">\n\n                    \n                        <div class=\"galleryScroller__block\">\n\n                            <div class=\"galleryScroller__imageWrap ps-oh psBr psBor--dark\">\n\n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n              