ing=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n    \n                            </div>\n\n                        </div>\n\n                    \n                </div>\n\n            \n                <div class=\"galleryScroller__row psFlex psGap-4 psMb-4\" data-speed=\"-0.15\">\n\n                    \n                        <div class=\"galleryScroller__block\">\n\n                            <div class=\"galleryScroller__imageWrap ps-oh psBr psBor--dark\">\n\n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Gallery-Scroller-Image-Sized-18.jpeg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Gallery-Scroller-Image-Sized-18.jpeg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 600 600'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover galleryScroller__image\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n    \n                            </div>\n\n                        </div>\n\n                    \n                        <div class=\"galleryScroller__block\">\n\n                            <div class=\"galleryScroller__imageWrap ps-oh psBr psBor--dark\">\n\n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Gallery-Scroller-Image-Sized-12.jpeg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Gallery-Scroller-Image-Sized-12.jpeg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 600 600'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover galleryScroller__image\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n    \n                            </div>\n\n                        </div>\n\n                    \n                        <div class=\"galleryScroller__block\">\n\n                            <div class=\"galleryScroller__imageWrap ps-oh psBr psBor--dark\">\n\n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Gallery-Scroller-Image-Sized-14.jpeg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Gallery-Scroller-Image-Sized-14.jpeg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 600 600'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover galleryScroller__image\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n    \n                            </div>\n\n                        </div>\n\n                    \n                        <div class=\"galleryScroller__block\">\n\n                            <div class=\"galleryScroller__imageWrap ps-oh psBr psBor--dark\">\n\n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Gallery-Scroller-Image-Sized-13.jpeg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Gallery-Scroller-Image-Sized-13.jpeg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 600 600'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover galleryScroller__image\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n    \n                            </div>\n\n                        </div>\n\n                    \n                        <div class=\"galleryScroller__block\">\n\n                            <div class=\"galleryScroller__imageWrap ps-oh psBr psBor--dark\">\n\n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Gallery-Scroller-Image-Sized-18.jpeg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Gallery-Scroller-Image-Sized-18.jpeg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 600 600'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover galleryScroller__image\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n    \n                            </div>\n\n                        </div>\n\n                    \n                        <div class=\"galleryScroller__block\">\n\n                            <div class=\"galleryScroller__imageWrap ps-oh psBr psBor--dark\">\n\n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Gallery-Scroller-Image-Sized-12.jpeg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Gallery-Scroller-Image-Sized-12.jpeg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 600 600'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover galleryScroller__image\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n    \n                            </div>\n\n                        </div>\n\n                    \n                        <div class=\"galleryScroller__block\">\n\n                            <div class=\"galleryScroller__imageWrap ps-oh psBr psBor--dark\">\n\n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Gallery-Scroller-Image-Sized-14.jpeg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Gallery-Scroller-Image-Sized-14.jpeg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 600 600'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover galleryScroller__image\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n    \n                            </div>\n\n                        </div>\n\n                    \n                        <div class=\"galleryScroller__block\">\n\n                            <div class=\"galleryScroller__imageWrap ps-oh psBr psBor--dark\">\n\n                                \n    <div class=\"psLazyLoadFrame\" style=\"\n                --focal-x: 50%;\n        --focal-y: 50%;\n        --focal-x-small: 50%;\n        --focal-y-small: 50%;\n        \"> \n        <div class=\"opacityWrap\" style=\"opacity: 1\">\n                            <picture>\n                    \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Gallery-Scroller-Image-Sized-13.jpeg\" \n                            media=\"(max-width: 1023px)\">\n                        \n                        <source \n                            srcset=\"https://adventurecinema.co.uk/wp-content/uploads/2026/01/Gallery-Scroller-Image-Sized-13.jpeg\" \n                            media=\"(min-width: 1024px)\">\n\n                                        <img \n                        src=\"data:image/svg+xml&#44;%3Csvg xmlns='https://www.w3.org/2000/svg' viewBox='0 0 600 600'%3E%3C/svg%3E\"\n                        alt=\"\"\n                        class=\"JS--lazyLoad psFitCover galleryScroller__image\"\n                                                loading=\"lazy\"\n                    />\n                </picture>\n                    </div>\n    </div>\n\n    \n                            </div>\n\n                        </div>\n\n                    \n                </div>\n\n            \n        </div>\n\n    </section>\n\n\n        \n        \n    \n                \n            \n\n    \n    \n                \n                    \n            \n        \n    \n        <section \n            data-flexi-layout\n            class=\"flexiLayout flexiLayout--nt flexiLayout--nb multiQuote psTheme--transparent\">\n\n            <div class=\"maxWidth psFont--center\">\n\n                                    <h4 class=\"psMb-0 psMb-5--mediumLargeUp\">What our customers are saying...</h4>\n                \n                <div class=\"multiQuote__inner psPt-7 ps-oh\">\n\n                    <div class=\"psFlex psFlex--center-center psFlex--wrap psGap-5--mobile psGap-7\">\n\n                        \n                            \n                            <div class=\"multiQuote__block multiQuote__block--third ps-rel\">\n\n                                <div class=\"ps-abs psBgShape psBgShape--1\"><svg width=\"756\" height=\"623\" viewBox=\"0 0 756 623\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                    <path fill=\"var(--pink-lt)\" d=\"M684.544 411.822C722.304 407.212 749.044 372.712 744.594 334.932C739.714 293.512 726.804 242.372 695.784 191.482C602.604 38.6022 427.004 20.7923 398.674 18.4223C266.194 7.35226 69.5144 59.5723 21.4344 209.292C-19.2756 336.082 71.2244 456.072 86.4244 476.212C134.164 539.502 234.514 626.362 324.664 603.362C370.734 591.612 385.484 558.482 426.094 520.062C472.544 476.122 549.594 428.312 684.534 411.822H684.544Z\" />\n               </svg></div>\n                                \n                                    <blockquote class=\"ps-rel pz-z-1 psMb-0 psBor--none\">\n\n                                        <p class=\"ps-h ps-h-5 psPt-4 psPb-4\">\"Absolutely brilliant, we chose the premium seating, in order to not carry chairs. Great atmosphere! Food also being freshly cooked and served. All of the parking marshals and staff were very helpful and polite. We will definitely attend another event and more!\"</p>\n\n                                        <cite class=\"psTag psTag--yellow psMt-2\">C.Hartnup</cite>\n\n                                    </blockquote>\n\n                                \n                            </div>\n\n                        \n                            \n                            <div class=\"multiQuote__block multiQuote__block--third ps-rel\">\n\n                                <div class=\"ps-abs psBgShape psBgShape--1\"><svg width=\"590\" height=\"611\" viewBox=\"0 0 590 611\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                   <path fill=\"var(--violet-lt)\" d=\"M303.436 92.509C303.436 92.509 372.476 -37.031 457.976 10.469C543.826 58.169 520.936 132.569 457.976 180.269C457.976 180.269 587.716 161.189 589.616 300.469C591.526 439.749 465.606 428.299 465.606 428.299C465.606 428.299 553.406 520.649 477.056 580.929C404.556 638.169 326.336 586.649 299.626 510.339C299.626 510.339 234.756 661.059 108.836 592.379C-10.2844 527.409 106.926 399.679 106.926 399.679C106.926 399.679 -17.0842 411.129 1.99576 294.749C21.0758 178.369 146.996 226.069 146.996 226.069C146.996 226.069 32.5257 123.039 158.446 48.639C253.386 -7.46099 303.446 92.519 303.446 92.519L303.436 92.509Z\" />\n               </svg></div>\n                                \n                                    <blockquote class=\"ps-rel pz-z-1 psMb-0 psBor--none\">\n\n                                        <p class=\"ps-h ps-h-5 psPt-4 psPb-4\">\"The staff were all lovely welcoming and told us where to go. It was set up really nice, there was a lot of space for all the chairs. Me and my friends really enjoyed ourselves. Will definitely do more thank you\"</p>\n\n                                        <cite class=\"psTag psTag--yellow psMt-2\">K.Jackson</cite>\n\n                                    </blockquote>\n\n                                \n                            </div>\n\n                        \n                            \n                            <div class=\"multiQuote__block multiQuote__block--third ps-rel\">\n\n                                <div class=\"ps-abs psBgShape psBgShape--1\"><svg width=\"755\" height=\"736\" viewBox=\"0 0 755 736\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                   <path fill=\"var(--yellow-lt)\" d=\"M668.234 293.205C643.584 185.095 603.494 9.30517 525.304 0.365174C467.604 -6.22483 381.114 77.1752 336.814 186.015C243.244 123.445 125.784 106.635 78.9738 149.515C20.5738 202.995 73.3038 348.255 114.714 462.295C152.554 566.525 214.084 736.005 292.774 735.195C344.444 734.665 409.924 660.605 445.224 564.355C525.194 619.975 619.414 640.365 664.994 607.995C729.564 562.145 695.204 411.485 668.234 293.195V293.205Z\" />\n               </svg></div>\n                                \n                                    <blockquote class=\"ps-rel pz-z-1 psMb-0 psBor--none\">\n\n                                        <p class=\"ps-h ps-h-5 psPt-4 psPb-4\">\"Booked this having never done it before and the whole family thoroughly enjoyed it! Screen set up in front of a beautiful mansion food and drink available the kids really liked the candy floss stand! Will definitely be booking again highly recommended 👍\"</p>\n\n                                        <cite class=\"psTag psTag--yellow psMt-2\">L.Barnes</cite>\n\n                                    </blockquote>\n\n                                \n                            </div>\n\n                        \n                    </div>\n\n                </div>\n\n            </div>\n\n        </section>\n\n    \n\n        \n        \n    \n                \n            \n\n    \n    \n                \n                    \n                    \n    <section \n        class=\"flexiLayout flexiLayout--nt flexiLayout--nb faqs psTheme--transparent\"\n        data-flexi-layout \n        data-faqs-section\n    > \n                \n        <div class=\"maxWidth\">\n                            \n            <div class=\"psFlex psFlex--column-mediumLarge-down psGap-6 ps-rel ps-z-1\">\n\n                <div class=\"faqs__titleCol\">\n\n                    <h3 class=\"psMb-0\">Frequently Asked Questions</h3>\n\n                </div>\n\n                <div class=\"faqs__faqsCol\">\n\n                                        \n                        \n                        <div class=\"faq ps-rel psBor-b\" data-faq>\n\n                            <button class=\"faq__question psFlex psFlex--spaceBetween--center psBg--none psBor--none  psPb-4 psPl-0 psPr-0 psFont--left psFullWidth\" data-faq-trigger>\n\n                                <span class=\"psDb ps-h ps-h-4 psMb-0\">Can I bring my own food &#038; drink to this venue?</span>\n                           \n                                <svg class=\"faq__triggerSvg psFill--none psFlex--noShrink\" viewBox=\"0 0 48 48\">\n                                    <path class=\"faq__triggerSvgPath psFill--light\"  d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psStroke--dark\" d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psFill--dark\"   d=\"M34 25H14V23H34V25Z\" />\n                                    <path class=\"faq__triggerSvgPath psFill--dark\"   d=\"M23 34L23 14L25 14L25 34L23 34Z\" />\n                                </svg>\n                                               \n                                <svg class=\"faq__triggerSvg faq__triggerSvg--close psFill--none psFlex--noShrink\" viewBox=\"0 0 48 48\">\n                                    <path class=\"faq__triggerSvgPath psFill--pink-dk\" d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psStroke--dark\"  d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psFill--dark\"    d=\"M34 25H14V23H34V25Z\" />\n                                </svg>                 \n\n                            </button>\n\n                            <div class=\"faq__answer psDefaultContent\" data-faq-content>\n                                <p data-start=\"62\" data-end=\"260\">You are welcome to bring your own picnic, drinks and snacks to this venue. <strong data-start=\"146\" data-end=\"185\">Glass is not permitted</strong>, so please ensure all food and drink is brought in non-glass containers.</p>\n<p>Food, snacks, soft drinks and a bar will be available, and we recommend bringing cash as not all vendors will take card payments.</p>\n<p>We will always ask our traders to cater for all dietaries, but if you have specific requirements, it is advisable to bring a little something along with you, just in case there isn’t something suitable at the event.</p>\n<p>No BBQs are allowed on site.</p>\n                            </div>\n\n                        </div>\n\n                     \n                    \n                        \n                        <div class=\"faq ps-rel psBor-b\" data-faq>\n\n                            <button class=\"faq__question psFlex psFlex--spaceBetween--center psBg--none psBor--none psPt-base psPb-4 psPl-0 psPr-0 psFont--left psFullWidth\" data-faq-trigger>\n\n                                <span class=\"psDb ps-h ps-h-4 psMb-0\">Do I need a paper ticket?</span>\n                           \n                                <svg class=\"faq__triggerSvg psFill--none psFlex--noShrink\" viewBox=\"0 0 48 48\">\n                                    <path class=\"faq__triggerSvgPath psFill--light\"  d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psStroke--dark\" d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psFill--dark\"   d=\"M34 25H14V23H34V25Z\" />\n                                    <path class=\"faq__triggerSvgPath psFill--dark\"   d=\"M23 34L23 14L25 14L25 34L23 34Z\" />\n                                </svg>\n                                               \n                                <svg class=\"faq__triggerSvg faq__triggerSvg--close psFill--none psFlex--noShrink\" viewBox=\"0 0 48 48\">\n                                    <path class=\"faq__triggerSvgPath psFill--pink-dk\" d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psStroke--dark\"  d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psFill--dark\"    d=\"M34 25H14V23H34V25Z\" />\n                                </svg>                 \n\n                            </button>\n\n                            <div class=\"faq__answer psDefaultContent\" data-faq-content>\n                                <p>All of our ticketing is done electronically so you will not be sent a physical ticket. You can print out your e-tickets if you like but we advise saving the paper and loading the tickets on your phone or tablet to be scanned at the ticket tent on entrance.</p>\n                            </div>\n\n                        </div>\n\n                     \n                    \n                        \n                        <div class=\"faq ps-rel psBor-b\" data-faq>\n\n                            <button class=\"faq__question psFlex psFlex--spaceBetween--center psBg--none psBor--none psPt-base psPb-4 psPl-0 psPr-0 psFont--left psFullWidth\" data-faq-trigger>\n\n                                <span class=\"psDb ps-h ps-h-4 psMb-0\">Can I buy a ticket on the door?</span>\n                           \n                                <svg class=\"faq__triggerSvg psFill--none psFlex--noShrink\" viewBox=\"0 0 48 48\">\n                                    <path class=\"faq__triggerSvgPath psFill--light\"  d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psStroke--dark\" d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psFill--dark\"   d=\"M34 25H14V23H34V25Z\" />\n                                    <path class=\"faq__triggerSvgPath psFill--dark\"   d=\"M23 34L23 14L25 14L25 34L23 34Z\" />\n                                </svg>\n                                               \n                                <svg class=\"faq__triggerSvg faq__triggerSvg--close psFill--none psFlex--noShrink\" viewBox=\"0 0 48 48\">\n                                    <path class=\"faq__triggerSvgPath psFill--pink-dk\" d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psStroke--dark\"  d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psFill--dark\"    d=\"M34 25H14V23H34V25Z\" />\n                                </svg>                 \n\n                            </button>\n\n                            <div class=\"faq__answer psDefaultContent\" data-faq-content>\n                                <p>Tickets must be purchased in advance online only. Our events sell out quickly so book your tickets while you still can.</p>\n                            </div>\n\n                        </div>\n\n                     \n                    \n                        \n                        <div class=\"faq ps-rel psBor-b\" data-faq>\n\n                            <button class=\"faq__question psFlex psFlex--spaceBetween--center psBg--none psBor--none psPt-base psPb-4 psPl-0 psPr-0 psFont--left psFullWidth\" data-faq-trigger>\n\n                                <span class=\"psDb ps-h ps-h-4 psMb-0\">Is seating provided?</span>\n                           \n                                <svg class=\"faq__triggerSvg psFill--none psFlex--noShrink\" viewBox=\"0 0 48 48\">\n                                    <path class=\"faq__triggerSvgPath psFill--light\"  d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psStroke--dark\" d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psFill--dark\"   d=\"M34 25H14V23H34V25Z\" />\n                                    <path class=\"faq__triggerSvgPath psFill--dark\"   d=\"M23 34L23 14L25 14L25 34L23 34Z\" />\n                                </svg>\n                                               \n                                <svg class=\"faq__triggerSvg faq__triggerSvg--close psFill--none psFlex--noShrink\" viewBox=\"0 0 48 48\">\n                                    <path class=\"faq__triggerSvgPath psFill--pink-dk\" d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psStroke--dark\"  d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psFill--dark\"    d=\"M34 25H14V23H34V25Z\" />\n                                </svg>                 \n\n                            </button>\n\n                            <div class=\"faq__answer psDefaultContent\" data-faq-content>\n                                <p>Unless you have purchased a Premium or Director&#8217;s View ticket, you will need to bring your own seating.</p>\n<p>A Premium ticket includes a luxury deckchair in a prime position.</p>\n<p>Director&#8217;s View tickets include a front row director&#8217;s chair, and a blanket and Adventure Cinema treat bag.</p>\n<p>Please note that premium and director&#8217;s tickets are priced the same for adults and children.</p>\n                            </div>\n\n                        </div>\n\n                     \n                    \n                        \n                        <div class=\"faq ps-rel psBor-b\" data-faq>\n\n                            <button class=\"faq__question psFlex psFlex--spaceBetween--center psBg--none psBor--none psPt-base psPb-4 psPl-0 psPr-0 psFont--left psFullWidth\" data-faq-trigger>\n\n                                <span class=\"psDb ps-h ps-h-4 psMb-0\">More information</span>\n                           \n                                <svg class=\"faq__triggerSvg psFill--none psFlex--noShrink\" viewBox=\"0 0 48 48\">\n                                    <path class=\"faq__triggerSvgPath psFill--light\"  d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psStroke--dark\" d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psFill--dark\"   d=\"M34 25H14V23H34V25Z\" />\n                                    <path class=\"faq__triggerSvgPath psFill--dark\"   d=\"M23 34L23 14L25 14L25 34L23 34Z\" />\n                                </svg>\n                                               \n                                <svg class=\"faq__triggerSvg faq__triggerSvg--close psFill--none psFlex--noShrink\" viewBox=\"0 0 48 48\">\n                                    <path class=\"faq__triggerSvgPath psFill--pink-dk\" d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psStroke--dark\"  d=\"M47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.500001 24C0.500002 11.0213 11.0213 0.5 24 0.500001C36.9787 0.500002 47.5 11.0213 47.5 24Z\" />\n                                    <path class=\"faq__triggerSvgPath psFill--dark\"    d=\"M34 25H14V23H34V25Z\" />\n                                </svg>                 \n\n                            </button>\n\n                            <div class=\"faq__answer psDefaultContent\" data-faq-content>\n                                <p><a href=\"https://adventurecinema.co.uk/faqs/\">Please view our FAQs page</a></p>\n                            </div>\n\n                        </div>\n\n                     \n                    \n                </div>        \n\n            </div> \n            \n        </div>\n        \n    </section>\n\n\n        \n        \n    \n        \n    </div>\n\n \n            \n                                \n                <footer class=\"footer psBg--pink-lt psPt-6 psPb-6 ps-rel ps-oh psColor--dark\"> \n\n    <svg class=\"footer__svg psFill--none ps-abs\" viewBox=\"0 0 1162 1340\" preserveAspectRatio=\"none\">\n        <path class=\"psTheme--yellow-lt\" d=\"M470.554 56.6196C430.709 -2.38856 350.463 -17.5825 291.322 21.9992C226.484 65.3966 152.295 130.453 93.9492 225.479C-81.3346 510.937 38.5828 818.765 58.7678 867.999C153.181 1098.22 407.707 1381.56 698.059 1334.23C943.937 1294.13 1066.72 1041.14 1087.32 998.661C1152.08 865.211 1211.28 624.012 1096.17 493.344C1037.36 426.565 969.605 430.187 871.014 395.214C758.253 355.208 612.979 267.496 470.562 56.6362L470.554 56.6196Z\" />\n    </svg>\n\n    <div class=\"maxWidth ps-rel\">\n\n                        \n            <div class=\"footer__formSection psBg--light psBr--large psBor--dark\">\n\n                <div class=\"psFlex psFlex--column-mediumLarge-down psGap-7\">                \n\n                    <div>\n                                                    <h4 class=\"ps-h-2\">Sign up for our newsletter</h4>\n                        \n                                                    <div class=\"psMt-base psMb-0 ps-h ps-h-5\">Subscribe to our newsletter and stay up to date.</div>\n                                            </div>\n\n                    <div class=\"footer__formWrap psFlex--noShrink\">\n                        <div class=\"wpforms-container wpforms-render-modern\" id=\"wpforms-23\"><form id=\"wpforms-form-23\" class=\"wpforms-validate wpforms-form wpforms-ajax-form\" data-formid=\"23\" method=\"post\" enctype=\"multipart/form-data\" action=\"/venues/kew-gardens/\" data-token=\"7992182548f17db18d4fb8e5a37dfd45\" data-token-time=\"1782116305\"><noscript class=\"wpforms-error-noscript\">Please enable JavaScript in your browser to complete this form.</noscript><div id=\"wpforms-error-noscript\" style=\"display: none;\">Please enable JavaScript in your browser to complete this form.</div><div class=\"wpforms-field-container\"><div id=\"wpforms-23-field_4-container\" class=\"wpforms-field wpforms-field-text\" data-field-id=\"4\"><label class=\"wpforms-field-label\" for=\"wpforms-23-field_4\">Your Name <span class=\"wpforms-required-label\" aria-hidden=\"true\">*</span></label><input type=\"text\" id=\"wpforms-23-field_4\" class=\"wpforms-field-medium wpforms-field-required\" name=\"wpforms[fields][4]\" aria-errormessage=\"wpforms-23-field_4-error\" required></div><div id=\"wpforms-23-field_2-container\" class=\"wpforms-field wpforms-field-email\" data-field-id=\"2\"><label class=\"wpforms-field-label\" f