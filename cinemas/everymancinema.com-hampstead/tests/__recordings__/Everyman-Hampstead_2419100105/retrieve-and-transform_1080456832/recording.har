n\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Melonie\",\"lastName\":\"Diaz\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Uzo\",\"lastName\":\"Aduba\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Peter\",\"lastName\":\"Dinklage\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Molly\",\"lastName\":\"Price\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lily\",\"lastName\":\"Collias\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-17T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"13760\",\"name\":\"Paramount Pictures UK\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Roofman\",\"synopsis\":\"Based on a true story, a former Army Ranger and struggling father turns to robbing McDonald's restaurants by cutting holes in their roofs, earning him the nickname 'Roofman.' After escaping from prison, he starts a new life while hiding in a toy store, falling in love with a single mother and her two daughters. However, his criminal past and a final robbery threaten to destroy his chance at redemption.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/b7/19/b71928fc93dec6f29cc21fae5ee1cc39.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/679399ae235a0c32aac3fd9191c92308.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://all.web.img.acsta.net/img/a9/f1/a9f1e423b011877baf226e0451c2c268.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Roofman\",\"synopsis\":\"Based on a true story, a former Army Ranger and struggling father turns to robbing McDonald's restaurants by cutting holes in their roofs, earning him the nickname 'Roofman.' After escaping from prison, he starts a new life while hiding in a toy store, falling in love with a single mother and her two daughters. However, his criminal past and a final robbery threaten to destroy his chance at redemption.\",\"certificate\":null,\"casting\":[\"Channing Tatum\",\"Kirsten Dunst\",\"Ben Mendelsohn\",\"Lakeith Stanfield\",\"Juno Temple\",\"Melonie Diaz\",\"Uzo Aduba\",\"Peter Dinklage\",\"Molly Price\",\"Lily Collias\"],\"direction\":[\"Derek Cianfrance\"],\"coDirection\":[],\"pictures\":[\"img/89/60/89608c11e192847578138d8abd69a2f6.jpg\",\"img/4a/c1/4ac1c850938626521109c973d0e660cc.jpg\",\"img/f0/03/f0039f41b0627564bd037fd0305382af.jpg\",\"img/ba/26/ba26a2ed70e8d2562ee6e13e2fe1b976.jpg\",\"img/a9/f1/a9f1e423b011877baf226e0451c2c268.jpg\",\"img/60/29/6029f78d2247b54f76b362e615cc310a.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/679399ae235a0c32aac3fd9191c92308.jpg\"],\"release\":\"2025-10-17T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Paramount Pictures UK\"}},{\"id\":\"13804\",\"title\":\"Showgirls\",\"runtime\":7860,\"genres\":\"Drama, Erotic\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/e2963ac50a86c9ee35e9d41ea893c1e8.jpg\",\"__typename\":\"Movie\",\"altId\":[\"2009\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[{\"url\":\"https://all.web.img.acsta.net/pictures/14/03/12/10/47/373383.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319051.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319050.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319049.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319048.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319041.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319040.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/76/34/37/19779705.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/76/34/37/19779704.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/76/34/37/19779703.jpg\",\"__typename\":\"Image\"}],\"quadImages\":[\"https://all.web.img.acsta.net/img/7b/2a/7b2a81e5927a8c753b3ac9f36dfedbcf.jpg\"],\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elizabeth\",\"lastName\":\"Berkley\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kyle\",\"lastName\":\"MacLachlan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gina\",\"lastName\":\"Gershon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gina\",\"lastName\":\"Ravera\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Davi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Glenn\",\"lastName\":\"Plummer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alan\",\"lastName\":\"Rachins\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lin\",\"lastName\":\"Tucci\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michelle\",\"lastName\":\"Johnston\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Pamela\",\"lastName\":\"Anderson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Paul\",\"lastName\":\"Verhoeven\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"1995-12-20T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong sex, sexual violence\",\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[]},{\"releasedAt\":\"2025-11-20T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong sex, nudity, sexual violence\",\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[],\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}]},{\"releasedAt\":\"2025-06-06T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong sex, nudity, sexual violence\",\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[],\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Showgirls\",\"synopsis\":\"Las Vegas... Running from a troubled past and possessed of a raw and riveting dancing talent, Nomi Malone is soon introduced to the arena of the sensual, pulsating stage shows on the legendary Strip and the powerful men and women who run them. One of those drawn to Nomi's beauty and talent is Zack, the ambitious entertainment director at the Stardust. Another is Cristal, the glamorous, coke-snorting star of the stage show 'Goddess,' who may make her...or break her. As the complex bonds of passion, jealousy and love form between them, Nomi is drawn deeper into the world she so desperately desires and the allure of the spotlight she craves. It's a world of passion, power and personal moral choices where everything--and everyone--has a price.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/e1/fd/e1fd973d796f258f179a1aaa5d917444.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/e2963ac50a86c9ee35e9d41ea893c1e8.jpg\",\"synopsis\":\"Selected by the Marketing & Public Relations Branch, Everyman presents: Showgirls\\n\\nNomi (Elizabeth Berkley) arrives in Las Vegas with only a suitcase and a dream of becoming a top showgirl. She quickly befriends Molly (Gina Ravera), who works at the high-profile Stardust Hotel, and lands a job at a seedy strip club. A chance meeting with Cristal (Gina Gershon), the Stardust's marquee dancer, and her powerful boyfriend, Zack (Kyle MacLachlan), brings Nomi one step closer to realizing her dream. But, as she ascends to the top, Nomi begins to wonder if it's all worth it.\\n\\nSelected by the Marketing and Public Relations Branch. \\n\\nDirector Paul Verhoeven and screenwriter Joe Eszterhas followed up the international success of their 1992 thriller Basic Instinct with this lavish drama set against the glitzy and tawdry backdrop of the Las Vegas entertainment world. Elizabeth Berkley is Nomi, a fearless young woman determined to make it in show business at any cost, and Gina Gershon is Cristal Connors, the star whose throne Nomi is scheming to claim. Arguably Verhoeven’s most controversial film, and the rare studio film to be released with an NC-17 rating, it has found an enthusiastic cult following in the thirty years since its premiere. \\n\\nPresented in 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 20 November.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/8d789b354051e372c42588c2f81779e3.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Showgirls\",\"synopsis\":\"Selected by the Marketing & Public Relations Branch, Everyman presents: Showgirls\\n\\nNomi (Elizabeth Berkley) arrives in Las Vegas with only a suitcase and a dream of becoming a top showgirl. She quickly befriends Molly (Gina Ravera), who works at the high-profile Stardust Hotel, and lands a job at a seedy strip club. A chance meeting with Cristal (Gina Gershon), the Stardust's marquee dancer, and her powerful boyfriend, Zack (Kyle MacLachlan), brings Nomi one step closer to realizing her dream. But, as she ascends to the top, Nomi begins to wonder if it's all worth it.\\n\\nSelected by the Marketing and Public Relations Branch. \\n\\nDirector Paul Verhoeven and screenwriter Joe Eszterhas followed up the international success of their 1992 thriller Basic Instinct with this lavish drama set against the glitzy and tawdry backdrop of the Las Vegas entertainment world. Elizabeth Berkley is Nomi, a fearless young woman determined to make it in show business at any cost, and Gina Gershon is Cristal Connors, the star whose throne Nomi is scheming to claim. Arguably Verhoeven’s most controversial film, and the rare studio film to be released with an NC-17 rating, it has found an enthusiastic cult following in the thirty years since its premiere. \\n\\nPresented in 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 20 November.\",\"certificate\":\"18\",\"casting\":[\"Elizabeth Berkley\",\"Kyle MacLachlan\",\"Gina Gershon\",\"Gina Ravera\",\"Robert Davi\",\"Glenn Plummer\",\"Alan Rachins\",\"Lin Tucci\",\"Michelle Johnston\",\"Pamela Anderson\"],\"direction\":[\"Paul Verhoeven\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/8d789b354051e372c42588c2f81779e3.jpg\",\"pictures/14/03/12/10/47/373383.jpg\",\"medias/nmedia/18/94/31/47/20319051.jpg\",\"medias/nmedia/18/94/31/47/20319050.jpg\",\"medias/nmedia/18/94/31/47/20319049.jpg\",\"medias/nmedia/18/94/31/47/20319048.jpg\",\"medias/nmedia/18/94/31/47/20319041.jpg\",\"medias/nmedia/18/94/31/47/20319040.jpg\",\"medias/nmedia/18/76/34/37/19779705.jpg\",\"medias/nmedia/18/76/34/37/19779704.jpg\",\"medias/nmedia/18/76/34/37/19779703.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/8d789b354051e372c42588c2f81779e3.jpg\"],\"release\":\"1995-12-20T00:00:00.000Z\",\"advisory\":\"strong sex, sexual violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"315134\",\"title\":\"Solo\",\"runtime\":6060,\"genres\":\"Romance, Drama\",\"__typename\":\"Movie\",\"altId\":[\"349406\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"poster\":\"https://cms-assets.webediamovies.pro/production/279/68ff7a0790de9fafb102be8e676b5c8d.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/3d/96/3d9663759b8e894d260a285a89dac3e9.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e7/fa/e7fabdb6d76a7ccd70bc3b421bd02344.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/7d/4a/7d4a18a2f3c6191d7846b9048a174014.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/37/fa/37fa46067e63e2e2808f0f12f3c45244.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/9b/6f/9b6f6df54f8679215b33f5ffd08a241f.jpg\",\"__typename\":\"Image\"}],\"quadImages\":[\"https://all.web.img.acsta.net/img/ac/79/ac79719ab7a9ca84ee110b89de5bfcc7.jpg\"],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Sophie\",\"lastName\":\"Dupuis\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Théodore\",\"lastName\":\"Pellerin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Félix\",\"lastName\":\"Maritaud\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Vladimir\",\"lastName\":\"Alexis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anne-Marie\",\"lastName\":\"Cadieux\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jean\",\"lastName\":\"Marchand\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-19T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong language, sex, drug misuse, sexual violence, domestic abuse\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"12907\",\"name\":\"Peccadillo Pictures\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Solo\",\"synopsis\":\"The film tells the story of Simon, rising star of Montreal drag queen scene. It's love at first sight when he meets Olivier, the new recruit of the bar-show where he performs. While Simon believes he is living an electrifying love story, a toxic and destructive dynamic arises between them. At the same time, Claire, Simon's mother, a famous opera singer, returns to work in the country after 15 years of absence. Fascinated by this woman he hardly knows but whom he idealizes, Simon persists in trying to create a bond with her. Weakened by the failure of these two impossible loves, Simon will have no choice but to realize that he deserves better.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/349406_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/349406_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/3f/e2/3fe2e9e5df221750084984e993f93c96.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/68ff7a0790de9fafb102be8e676b5c8d.jpg\",\"synopsis\":\"The film tells the story of Simon, rising star of Montreal drag queen scene. It's love at first sight when he meets Olivier, the new recruit of the bar-show where he performs. While Simon believes he is living an electrifying love story, a toxic and destructive dynamic arises between them. At the same time, Claire, Simon's mother, a famous opera singer, returns to work in the country after 15 years of absence. \\n\\nFascinated by this woman he hardly knows but whom he idealizes, Simon persists in trying to create a bond with her. Weakened by the failure of these two impossible loves, Simon will have no choice but to realize that he deserves better.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/40e8cd2c7afd50fa18d36d31a986ae7f.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Solo\",\"synopsis\":\"The film tells the story of Simon, rising star of Montreal drag queen scene. It's love at first sight when he meets Olivier, the new recruit of the bar-show where he performs. While Simon believes he is living an electrifying love story, a toxic and destructive dynamic arises between them. At the same time, Claire, Simon's mother, a famous opera singer, returns to work in the country after 15 years of absence. \\n\\nFascinated by this woman he hardly knows but whom he idealizes, Simon persists in trying to create a bond with her. Weakened by the failure of these two impossible loves, Simon will have no choice but to realize that he deserves better.\",\"certificate\":\"15\",\"casting\":[\"Théodore Pellerin\",\"Félix Maritaud\",\"Vladimir Alexis\",\"Anne-Marie Cadieux\",\"Jean Marchand\"],\"direction\":[\"Sophie Dupuis\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/40e8cd2c7afd50fa18d36d31a986ae7f.jpg\",\"img/3d/96/3d9663759b8e894d260a285a89dac3e9.jpg\",\"img/e7/fa/e7fabdb6d76a7ccd70bc3b421bd02344.jpg\",\"img/7d/4a/7d4a18a2f3c6191d7846b9048a174014.jpg\",\"img/37/fa/37fa46067e63e2e2808f0f12f3c45244.jpg\",\"img/9b/6f/9b6f6df54f8679215b33f5ffd08a241f.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/40e8cd2c7afd50fa18d36d31a986ae7f.jpg\"],\"release\":\"2025-09-19T00:00:00.000Z\",\"advisory\":\"strong language, sex, drug misuse, sexual violence, domestic abuse\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/349406_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/349406_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Peccadillo Pictures\"}},{\"id\":\"1000029719\",\"title\":\"Soundtracking: Good Fortune with Aziz Ansari.\",\"runtime\":5880,\"genres\":\"Comedy\",\"__typename\":\"Movie\",\"altId\":[\"399061\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/52d202adfd8eeba90ec667fc34228775.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Aziz\",\"lastName\":\"Ansari\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Aziz\",\"lastName\":\"Ansari\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Seth\",\"lastName\":\"Rogen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Keanu\",\"lastName\":\"Reeves\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sandra\",\"lastName\":\"Oh\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Keke\",\"lastName\":\"Palmer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Stephen\",\"lastName\":\"McKinley Henderson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Blanca\",\"lastName\":\"Araceli\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joe\",\"lastName\":\"Mande\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-01T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong language, drug misuse\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13832\",\"name\":\"Lionsgate UK\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Soundtracking: Good Fortune with Aziz Ansari.\",\"synopsis\":\"In GOOD FORTUNE, a well-meaning but rather inept angel named Gabriel (Keanu Reeves) meddles in the lives of a struggling gig worker (Aziz Ansari) and a wealthy venture capitalist (Seth Rogen).\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/e6/90/e69026a25febba38fb940910cb10a0a8.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/cd5d6e8b24d989a61e974d259ee11b63.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/52d202adfd8eeba90ec667fc34228775.jpg\",\"synopsis\":\"Join us for a very special edition of Everyman Soundtracking as we welcome Emmy Award–winning comedian, writer, and filmmaker Aziz Ansari to celebrate his latest project, Good Fortune. In conversation with Soundtracking podcast host Edith Bowman, Aziz will take us behind the scenes of his creative journey, exploring the inspirations, challenges, and stories that shaped the film.\\n\\nGood Fortune is a film about a well-meaning but rather inept angel named Gabriel who meddles in the lives of a struggling gig worker and a wealthy venture capitalist.\\n\\nExpect laughter, insight, and an intimate look at one of today’s most distinctive voices in comedy and cinema.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/7b8285cbd48f0dce26ba1bfd1d3ac1be.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Soundtracking: Good Fortune with Aziz Ansari.\",\"synopsis\":\"Join us for a very special edition of Everyman Soundtracking as we welcome Emmy Award–winning comedian, writer, and filmmaker Aziz Ansari to celebrate his latest project, Good Fortune. In conversation with Soundtracking podcast host Edith Bowman, Aziz will take us behind the scenes of his creative journey, exploring the inspirations, challenges, and stories that shaped the film.\\n\\nGood Fortune is a film about a well-meaning but rather inept angel named Gabriel who meddles in the lives of a struggling gig worker and a wealthy venture capitalist.\\n\\nExpect laughter, insight, and an intimate look at one of today’s most distinctive voices in comedy and cinema.\",\"certificate\":\"15\",\"casting\":[\"Aziz Ansari\",\"Seth Rogen\",\"Keanu Reeves\",\"Sandra Oh\",\"Keke Palmer\",\"Stephen McKinley Henderson\",\"Blanca Araceli\",\"Joe Mande\"],\"direction\":[\"Aziz Ansari\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/7b8285cbd48f0dce26ba1bfd1d3ac1be.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/7b8285cbd48f0dce26ba1bfd1d3ac1be.jpg\",\"https://cms-assets.webediamovies.pro/production/2/cd5d6e8b24d989a61e974d259ee11b63.jpg\"],\"release\":\"2025-10-01T00:00:00.000Z\",\"advisory\":\"strong language, drug misuse\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Lionsgate UK\"}},{\"id\":\"304503\",\"title\":\"Spinal Tap II: The End Continues\",\"runtime\":4920,\"genres\":\"Comedy, Documentary, Music\",\"__typename\":\"Movie\",\"altId\":[\"359039\",\"393921\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/f8998f415b55ddc850845d2d7a13e070.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/81/88/81885db9db593d050bb1ca41ff9229f6.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/f6/45/f6455cda794c6fce24b78967f5d42daa.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/95/6b/956b8d4c01e57ec4ee391140e1918e62.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Rob\",\"lastName\":\"Reiner\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"McKean\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Harry\",\"lastName\":\"Shearer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christopher\",\"lastName\":\"Guest\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rob\",\"lastName\":\"Reiner\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elton\",\"lastName\":\"John\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Paul\",\"lastName\":\"McCartney\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":null,\"lastName\":\"Questlove\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Garth\",\"lastName\":\"Brooks\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Trisha\",\"lastName\":\"Yearwood\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Fran\",\"lastName\":\"Drescher\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-12T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong language\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Spinal Tap II:The End Continues\",\"synopsis\":\"Spinal Tap II:The End Continues follows England’s loudest and most punctual band, as they reunite after a 15-year hiatus for one final concert. Featuring appearances by Elton John, Paul McCartney, Questlove, Lars Ulrich, Garth Brooks, Trisha Yearwood, and more.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/359039_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/359039_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/1b/17/1b17fd71719cc5d4e498cedb5ccbefdc.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/78c862a9408d1b03f5525d61ecdc56f6.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":\"Spinal Tap II: The End Continues\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/f8998f415b55ddc850845d2d7a13e070.jpg\",\"synopsis\":\"Spinal Tap is back! After a 15-year hiatus, David St. Hubbins, Nigel Tufnel, and Derek Smalls are drawn back together for one last concert. Documentary filmmaker Marty DiBergi returns to explore what the band members have been up to and immortalise the concert reunion. \\n\\nThe film blends the same musical mayhem and satire that made the original a cult classic and features some fantastic rock cameos in the process. Will this concert be their triumphant return, or just another Stonehenge-sized catastrophe?\\n\\nFeaturing appearances by Elton John, Paul McCartney, Questlove, Lars Ulrich, Garth Brooks, Trisha Yearwood, and more.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/8010fe976b47918f854a7f126b9608ad.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Spinal Tap II: The End Continues\",\"synopsis\":\"Spinal Tap is back! After a 15-year hiatus, David St. Hubbins, Nigel Tufnel, and Derek Smalls are drawn back together for one last concert. Documentary filmmaker Marty DiBergi returns to explore what the band members have been up to and immortalise the concert reunion. \\n\\nThe film blends the same musical mayhem and satire that made the original a cult classic and features some fantastic rock cameos in the process. Will this concert be their triumphant return, or just another Stonehenge-sized catastrophe?\\n\\nFeaturing appearances by Elton John, Paul McCartney, Questlove, Lars Ulrich, Garth Brooks, Trisha Yearwood, and more.\",\"certificate\":\"15\",\"casting\":[\"Michael McKean\",\"Harry Shearer\",\"Christopher Guest\",\"Rob Reiner\",\"Elton John\",\"Paul McCartney\",\"Questlove\",\"Garth Brooks\",\"Trisha Yearwood\",\"Fran Drescher\"],\"direction\":[\"Rob Reiner\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/8010fe976b47918f854a7f126b9608ad.jpg\",\"img/81/88/81885db9db593d050bb1ca41ff9229f6.jpg\",\"img/f6/45/f6455cda794c6fce24b78967f5d42daa.jpg\",\"img/95/6b/956b8d4c01e57ec4ee391140e1918e62.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/8010fe976b47918f854a7f126b9608ad.jpg\",\"https://cms-assets.webediamovies.pro/production/2/78c862a9408d1b03f5525d61ecdc56f6.jpg\"],\"release\":\"2025-09-12T00:00:00.000Z\",\"advisory\":\"strong language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/359039_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/359039_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures UK\"}},{\"id\":\"1000000149\",\"title\":\"Springsteen: Deliver Me From Nowhere\",\"runtime\":null,\"genres\":\"Biopic, Drama, Music\",\"__typename\":\"Movie\",\"altId\":[\"359046\",\"401584\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/cec8a81544375ca126b90e7fb64679bd.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/3a/a4/3aa40acfb4af92aae87823a936c1e2c7.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e3/e5/e3e534639cb83cea93298bf2ec31dd21.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/41/e8/41e837fb33af45889fbd3752bec9b59f.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/7b/a8/7ba8ce5a52af81a59668ac0c1013a178.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c7/97/c7974bec35db6b60462538b77fb9a0ce.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e2/dc/e2dc7c264c30e986196efebc53afd183.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/1d/2d/1d2ddfec8ce6f174c29733c5b8d4d28a.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Scott\",\"lastName\":\"Cooper\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jeremy\",\"lastName\":\"Allen White\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jeremy\",\"lastName\":\"Strong\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Paul Walter\",\"lastName\":\"Hauser\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Stephen\",\"lastName\":\"Graham\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gaby\",\"lastName\":\"Hoffmann\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Odessa\",\"lastName\":\"Young\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marc\",\"lastName\":\"Maron\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Johnny\",\"lastName\":\"Cannizzaro\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"David\",\"lastName\":\"Krumholtz\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Arabella Olivia\",\"lastName\":\"Clark\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-24T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Springsteen: Deliver Me From Nowhere\",\"synopsis\":null,\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/de9f851c78d1b20abcfb4330086566ca.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/cec8a81544375ca126b90e7fb64679bd.jpg\",\"synopsis\":\"From 20th Century Studios, “Springsteen: Deliver Me from Nowhere” chronicles the making of Bruce Springsteen’s 1982 “Nebraska” album when he was a young musician on the cusp of global superstardom, struggling to reconcile the pressures of success with the ghosts of his past. Recorded on a 4-track recorder in Springsteen’s New Jersey bedroom, the album marked a pivotal time in his life and is considered one of his most enduring works—a raw, haunted acoustic record populated by lost souls searching for a reason to believe. \\n\\nStarring Jeremy Allen White as the Boss, the film is written for the screen and directed by Scott Cooper, based on the book “Deliver Me from Nowhere” by Warren Zanes. “Springsteen: Deliver Me from Nowhere” also features Jeremy Strong as Springsteen’s long-time confidant and manager, Jon Landau; Paul Walter Hauser as guitar tech Mike Batlan; Stephen Graham as Springsteen’s father, Doug; Odessa Young as love interest, Faye; Gaby Hoffman as Springsteen’s mom, Adele; Marc Maron as Chuck Plotkin and David Krumholtz as Columbia executive, Al Teller. Arriving only in theaters October 24, 2025, the film is produced by Cooper, Ellen Goldsmith-Vein, Eric Robinson, and Scott Stuber. Tracey Landon, Jon Vein, and Zanes executive produce. \",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/f70c1d7a473aa51e1020749cfec33846.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Springsteen: Deliver Me From Nowhere\",\"synopsis\":\"From 20th Century Studios, “Springsteen: Deliver Me from Nowhere” chronicles the making of Bruce Springsteen’s 1982 “Nebraska” album when he was a young musician on the cusp of global superstardom, struggling to reconcile the pressures of success with the ghosts of his past. Recorded on a 4-track recorder in Springsteen’s New Jersey bedroom, the album marked a pivotal time in his life and is considered one of his most enduring works—a raw, haunted acoustic record populated by lost souls searching for a reason to believe. \\n\\nStarring Jeremy Allen White as the Boss, the film is written for the screen and directed by Scott Cooper, based on the book “Deliver Me from Nowhere” by Warren Zanes. “Springsteen: Deliver Me from Nowhere” also features Jeremy Strong as Springsteen’s long-time confidant and manager, Jon Landau; Paul Walter Hauser as guitar tech Mike Batlan; Stephen Graham as Springsteen’s father, Doug; Odessa Young as love interest, Faye; Gaby Hoffman as Springsteen’s mom, Adele; Marc Maron as Chuck Plotkin and David Krumholtz as Columbia executive, Al Teller. Arriving only in theaters October 24, 2025, the film is produced by Cooper, Ellen Goldsmith-Vein, Eric Robinson, and Scott Stuber. Tracey Landon, Jon Vein, and Zanes executive produce. \",\"certificate\":null,\"casting\":[\"Jeremy Allen White\",\"Jeremy Strong\",\"Paul Walter Hauser\",\"Stephen Graham\",\"Gaby Hoffmann\",\"Odessa Young\",\"Marc Maron\",\"Johnny Cannizzaro\",\"David Krumholtz\",\"Arabella Olivia Clark\"],\"direction\":[\"Scott Cooper\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/f70c1d7a473aa51e1020749cfec33846.jpg\",\"img/3a/a4/3aa40acfb4af92aae87823a936c1e2c7.jpg\",\"img/e3/e5/e3e534639cb83cea93298bf2ec31dd21.jpg\",\"img/41/e8/41e837fb33af45889fbd3752bec9b59f.jpg\",\"img/7b/a8/7ba8ce5a52af81a59668ac0c1013a178.jpg\",\"img/c7/97/c7974bec35db6b60462538b77fb9a0ce.jpg\",\"img/e2/dc/e2dc7c264c30e986196efebc53afd183.jpg\",\"img/1d/2d/1d2ddfec8ce6f174c29733c5b8d4d28a.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/f70c1d7a473aa51e1020749cfec33846.jpg\",\"https://cms-assets.webediamovies.pro/production/2/de9f851c78d1b20abcfb4330086566ca.jpg\"],\"release\":\"2025-10-24T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Walt Disney\"}},{\"id\":\"326627\",\"title\":\"Steve\",\"runtime\":5580,\"genres\":\"Drama\",\"__typename\":\"Movie\",\"altId\":[\"368802\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/590a8b63f9fb05488cd3865d70b6bdbd.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/67/aa/67aaf1695853599be3214a616692db43.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/6a/a3/6aa30f3f6d0b252780f8716e822c9e63.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/77/47/774700dfebd2e88b4e8a75bef63fc772.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c9/b0/c9b02c0998b48a423fefa971e5b421e3.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/b1/5e/b15ecfaa261f0d4a3b1aff7320bd6bb4.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Tim\",\"lastName\":\"Mielants\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cillian\",\"lastName\":\"Murphy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jay\",\"lastName\":\"Lycurgo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emily\",\"lastName\":\"Watson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tracey\",\"lastName\":\"Ullman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":null,\"lastName\":\"Little Simz\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Douggie\",\"lastName\":\"McMeekin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Youssef\",\"lastName\":\"Kerkour\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Luke\",\"lastName\":\"Ayres\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joshua J.\",\"lastName\":\"Parker\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Araloyin\",\"lastName\":\"Oshunremi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-19T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"very strong language, drug misuse, suicide references\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"1000101511\",\"name\":\"Netflix\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Steve\",\"synopsis\":\"Set in the mid-90s, STEVE is a reimagining of Max Porter's Sunday Times bestseller Shy. The film follows a pivotal day in the life of headteacher Steve (Academy Award® winner Cillian Murphy) and his students at a last-chance reform school amidst a world that has forsaken them. As Steve fights to protect the school's integrity and impending closure, we witness him grappling with his own mental health. In parallel to Steve's struggles, we meet Shy (Jay Lycurgo), a troubled teen caught between his past and what lies ahead as he tries to reconcile his inner fragility with his impulse for self-destruction and violence.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/04/a7/04a79c527b75ed6563e0c03c0e7dfa84.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/af2109b8891a9c67adb8812803323f28.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/590a8b63f9fb05488cd3865d70b6bdbd.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/f6d75d44a954d894158a0af13b2b4e19.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Steve\",\"synopsis\":\"Set in the mid-90s, STEVE is a reimagining of Max Porter's Sunday Times bestseller Shy. The film follows a pivotal day in the life of headteacher Steve (Academy Award® winner Cillian Murphy) and his students at a last-chance reform school amidst a world that has forsaken them. As Steve fights to protect the school's integrity and impending closure, we witness him grappling with his own mental health. In parallel to Steve's struggles, we meet Shy (Jay Lycurgo), a troubled teen caught between his past and what lies ahead as he tries to reconcile his inner fragility with his impulse for self-destruction and violence.\",\"certificate\":\"15\",\"casting\":[\"Cillian Murphy\",\"Jay Lycurgo\",\"Emily Watson\",\"Tracey Ullman\",\"Little Simz\",\"Douggie McMeekin\",\"Youssef Kerkour\",\"Luke Ayres\",\"Joshua J. Parker\",\"Araloyin Oshunremi\"],\"direction\":[\"Tim Mielants\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/f6d75d44a954d894158a0af13b2b4e19.jpg\",\"img/67/aa/67aaf1695853599be3214a616692db43.jpg\",\"img/6a/a3/6aa30f3f6d0b252780f8716e822c9e63.jpg\",\"img/77/47/774700dfebd2e88b4e8a75bef63fc772.jpg\",\"img/c9/b0/c9b02c0998b48a423fefa971e5b421e3.jpg\",\"img/b1/5e/b15ecfaa261f0d4a3b1aff7320bd6bb4.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/f6d75d44a954d894158a0af13b2b4e19.jpg\",\"https://cms-assets.webediamovies.pro/production/2/af2109b8891a9c67adb8812803323f28.jpg\"],\"release\":\"2025-09-19T00:00:00.000Z\",\"advisory\":\"very strong language, drug misuse, suicide references\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Netflix\"}},{\"id\":\"1000030397\",\"title\":\"Stop Making Sense\",\"runtime\":5280,\"genres\":\"Documentary, Concert\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4b821dccc7a74624964d57a67ae2db31.jpg\",\"__typename\":\"Movie\",\"altId\":[\"400040\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jonathan\",\"lastName\":\"Demme\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bernie\",\"lastName\":\"Worrell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alex\",\"lastName\":\"Weir\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"David\",\"lastName\":\"Byrne\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-30T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Branch Selects: Stop Making Sense\",\"synopsis\":\"Universally acclaimed as one of the best concert films ever made, Stop Making Sense documents the groundbreaking Talking Heads at their peak and was directed by Jonathan Demme. In honor of its fifteenth anniversary, Stop Making Sense was digitally re-mixed and re-mastered by Palm with the newest state-of-the-art Dolby technology.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/af/97/af97ca83afde57788fd7d783c565c7d8.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Stop Making Sense\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/4b821dccc7a74624964d57a67ae2db31.jpg\",\"synopsis\":\"Selected by the Documentary Branch, Everyman presents: Stop Making Sense\\n\\nStop Making Sense documents the groundbreaking Talking Heads at their peak and was directed by Jonathan Demme. In honour of its fifteenth anniversary, Stop Making Sense was digitally remixed and remastered by Palm with the newest state-of-the-art Dolby technology.\\n\\nOscar-winner Jonathan Demme (The Silence of the Lambs) collaborated with cinematographer Jordan Cronenweth (Blade Runner) to make the quintessential concert film, documenting three nights of Talking Heads concerts at Hollywood’s Pantages Theatre in December 1983. David Byrne and his fellow Heads perform such modern classics as “Psycho Killer,” “Burning Down The House,” and “Once In A Lifetime,” while Demme’s direction, Cronenweth’s camerawork, and the sound recording make you feel as if you’re in the front row of the Pantages.  \\n\\nPresented in 4k with Dolby Atmos, the feature returns to the big screen at Everyman The Whiteley on Thursday, 30 October.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/7b59d2a4b8fd3dff0469fdf403dbe5bd.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Branch Selects: Stop Making Sense\",\"synopsis\":\"Selected by the Documentary Branch, Everyman presents: Stop Making Sense\\n\\nStop Making Sense documents the groundbreaking Talking Heads at their peak and was directed by Jonathan Demme. In honour of its fifteenth anniversary, Stop Making Sense was digitally remixed and remastered by Palm with the newest state-of-the-art Dolby technology.\\n\\nOscar-winner Jonathan Demme (The Silence of the Lambs) collaborated with cinematographer Jordan Cronenweth (Blade Runner) to make the quintessential concert film, documenting three nights of Talking Heads concerts at Hollywood’s Pantages Theatre in December 1983. David Byrne and his fellow Heads perform such modern classics as “Psycho Killer,” “Burning Down The House,” and “Once In A Lifetime,” while Demme’s direction, Cronenweth’s camerawork, and the sound recording make you feel as if you’re in the front row of the Pantages.  \\n\\nPresented in 4k with Dolby Atmos, the feature returns to the big screen at Everyman The Whiteley on Thursday, 30 October.\",\"certificate\":\"PG\",\"casting\":[\"Bernie Worrell\",\"Alex Weir\",\"David Byrne\"],\"direction\":[\"Jonathan Demme\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/7b59d2a4b8fd3dff0469fdf403dbe5bd.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/7b59d2a4b8fd3dff0469fdf403dbe5bd.jpg\"],\"release\":\"2025-10-30T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"229669\",\"title\":\"Superman\",\"runtime\":7740,\"genres\":\"Action, Science fiction, Adventure\",\"__typename\":\"Movie\",\"altId\":[\"343208\",\"382715\",\"390504\",\"390505\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/6ca9d80d2c2a1a753bf4a39b5823d0a5.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/e2/77/e277506377b1d54581d924ceb9d3b4b3.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e3/36/e336c4278fea4270fa9bb46239ef507e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c4/4b/c44b76b79afc65452f5ddc3f3ecf35b6.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"James\",\"lastName\":\"Gunn\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"David\",\"lastName\":\"Corenswet\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rachel\",\"lastName\":\"Brosnahan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nathan\",\"lastName\":\"Fillion\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Isabela\",\"lastName\":\"Merced\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Edi\",\"lastName\":\"Gathegi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anthony\",\"lastName\":\"Carrigan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maria Gabriela\",\"lastName\":\"de Faría\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nicholas\",\"lastName\":\"Hoult\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sara\",\"lastName\":\"Sampaio\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Frank\",\"lastName\":\"Grillo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-07-11T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"moderate violence, threat, injury detail, language\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Superman\",\"synopsis\":\"“Superman,” DC Studios’ first feature film to hit the big screen, is set to soar into theaters worldwide this summer from Warner Bros. Pictures. In his signature style, James Gunn takes on the original superhero in the newly imagined DC universe with a singular blend of epic action, humor and heart, delivering a Superman who’s driven by compassion and an inherent belief in the goodness of humankind.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/343208_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/343208_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/72/6d/726d9669a32ea98289301f0bb158b465.png\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/119f3ff2e7df3fa0178455970ff864f5.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":\"Superman\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/6ca9d80d2c2a1a753bf4a39b5823d0a5.jpg\",\"synopsis\":\"Follows the titular superhero as he reconciles his heritage with his human upbringing. He is the embodiment of truth, justice and the human way in a world that views this as old-fashioned.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/46bfcf48bb1760d8ecc1b9f64cffaa0f.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Superman\",\"synopsis\":\"Follows the titular superhero as he reconciles his heritage with his human upbringing. He is the embodiment of truth, justice and the human way in a world that views this as old-fashioned.\",\"certificate\":\"12A\",\"casting\":[\"David Corenswet\",\"Rachel Brosnahan\",\"Nathan Fillion\",\"Isabela Merced\",\"Edi Gathegi\",\"Anthony Carrigan\",\"Maria Gabriela de Faría\",\"Nicholas Hoult\",\"Sara Sampaio\",\"Frank Grillo\"],\"direction\":[\"James Gunn\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/46bfcf48bb1760d8ecc1b9f64cffaa0f.jpg\",\"img/e2/77/e277506377b1d54581d924ceb9d3b4b3.jpg\",\"img/e3/36/e336c4278fea4270fa9bb46239ef507e.jpg\",\"img/c4/4b/c44b76b79afc65452f5ddc3f3ecf35b6.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/46bfcf48bb1760d8ecc1b9f64cffaa0f.jpg\",\"https://cms-assets.webediamovies.pro/production/2/119f3ff2e7df3fa0178455970ff864f5.jpg\"],\"release\":\"2025-07-11T00:00:00.000Z\",\"advisory\":\"moderate violence, threat, injury detail, language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/343208_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/343208_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"}},{\"id\":\"308\",\"title\":\"Taxi Driver\",\"runtime\":6900,\"genres\":\"Drama, Detective, Thriller\",\"__typename\":\"Movie\",\"altId\":[\"287\"],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4c874a846412affb468924b04196bea6.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/22/64/19901669.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/22/64/19901662.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/22/64/19901660.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/22/64/19901658.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/22/64/19901655.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/91/08/18880499.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/91/08/18880498.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/91/08/18880494.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/91/08/18880492.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/91/08/18880490.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Martin\",\"lastName\":\"Scorsese\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"De Niro\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jodie\",\"lastName\":\"Foster\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Harvey\",\"lastName\":\"Keitel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cybill\",\"lastName\":\"Shepherd\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Albert\",\"lastName\":\"Brooks\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Leonard\",\"lastName\":\"Harris\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Peter\",\"lastName\":\"Boyle\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Norman\",\"lastName\":\"Matlock\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Diahnne\",\"lastName\":\"Abbott\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Franck\",\"lastName\":\"Adu\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2017-02-10T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"Contains very strong sex references and child prostitution theme\",\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[],\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"},{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}]},{\"releasedAt\":\"2026-01-22T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"Contains very strong sex references and child prostitution theme\",\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[],\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Taxi Driver\",\"synopsis\":\"Robert De Niro stars with Jodie Foster, Cybill Shepherd, Harvey Keitel, Peter Boyle, and Albert Brooks in the all-too-real story of a psychotic New York cabby who is driven to violence in an attempt to rescue a teenage prostitute.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/287_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/287_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/00/38/00384ea792b4f85786910fa27c89bd38.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/4c874a846412affb468924b04196bea6.jpg\",\"synopsis\":\"Selected by the Costume Designers Branch, Everyman presents: Taxi Driver\\n\\nSuffering from insomnia, disturbed loner Travis Bickle (Robert De Niro) takes a job as a New York City cabbie, haunting the streets nightly, growing increasingly detached from reality as he dreams of cleaning up the filthy city. When Travis meets pretty campaign worker Betsy (Cybill Shepherd), he becomes obsessed with the idea of saving the world, first plotting to assassinate a presidential candidate, then directing his attentions toward rescuing 12-year-old prostitute Iris (Jodie Foster).\\n\\nMartin Scorsese’s film of Paul Schrader’s original screenplay about a New York cab driver whose alienation from society leads to violence is one of the defining American films of the 1970s, and earned four Oscar nominations including Best Picture. Oscar-nominee Ruth Morley (The Miracle Worker) had an impressive career designing costumes for film, Broadway, and the opera, and Taxi Driver features some of her most iconic creations, with the unforgettable, Oscar-nominated performances of Robert De Niro and Jodie Foster aided immeasurably by Morley’s distinctive designs. \\n\\nPresented in 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 22 January.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/fef510e4aa640bc3b045a6f3ca7cbb94.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Taxi Driver\",\"synopsis\":\"Selected by the Costume Designers Branch, Everyman presents: Taxi Driver\\n\\nSuffering from insomnia, disturbed loner Travis Bickle (Robert De Niro) takes a job as a New York City cabbie, haunting the streets nightly, growing increasingly detached from reality as he dreams of cleaning up the filthy city. When Travis meets pretty campaign worker Betsy (Cybill Shepherd), he becomes obsessed with the idea of saving the world, first plotting to assassinate a presidential candidate, then directing his attentions toward rescuing 12-year-old prostitute Iris (Jodie Foster).\\n\\nMartin Scorsese’s film of Paul Schrader’s original screenplay about a New York cab driver whose alienation from society leads to violence is one of the defining American films of the 1970s, and earned four Oscar nominations including Best Picture. Oscar-nominee Ruth Morley (The Miracle Worker) had an impressive career designing costumes for film, Broadway, and the opera, and Taxi Driver features some of her most iconic creations, with the unforgettable, Oscar-nominated performances of Robert De Niro and Jodie Foster aided immeasurably by Morley’s distinctive designs. \\n\\nPresented in 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 22 January.\",\"certificate\":\"18\",\"casting\":[\"Robert De Niro\",\"Jodie Foster\",\"Harvey Keitel\",\"Cybill Shepherd\",\"Albert Brooks\",\"Leonard Harris\",\"Peter Boyle\",\"Norman Matlock\",\"Diahnne Abbott\",\"Franck Adu\"],\"direction\":[\"Martin Scorsese\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/fef510e4aa640bc3b045a6f3ca7cbb94.jpg\",\"medias/nmedia/18/87/22/64/19901669.jpg\",\"medias/nmedia/18/87/22/64/19901662.jpg\",\"medias/nmedia/18/87/22/64/19901660.jpg\",\"medias/nmedia/18/87/22/64/19901658.jpg\",\"medias/nmedia/18/87/22/64/19901655.jpg\",\"medias/nmedia/18/35/91/08/18880499.jpg\",\"medias/nmedia/18/35/91/08/18880498.jpg\",\"medias/nmedia/18/35/91/08/18880494.jpg\",\"medias/nmedia/18/35/91/08/18880492.jpg\",\"medias/nmedia/18/35/91/08/18880490.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/fef510e4aa640bc3b045a6f3ca7cbb94.jpg\"],\"release\":\"2017-02-10T00:00:00.000Z\",\"advisory\":\"Contains very strong sex references and child prostitution theme\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/287_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/287_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"1000031478\",\"title\":\"Taylor Swift / The Official Release Party of a Showgirl\",\"runtime\":5340,\"genres\":\"Music\",\"__typename\":\"Movie\",\"altId\":[\"401286\"],\"directors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/760cc600034d166a376f7a644c616a29.jpg\",\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Taylor\",\"lastName\":\"Swift\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-03T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"43134\",\"name\":\"Piece of Magic Entertainment\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Taylor Swift / The Official Release Party of a Showgirl\",\"synopsis\":\"Celebrate The Official Release Party of a Showgirl in theaters only October 3rd - 5th. See the exclusive world premiere of the music video, “The Fate of Ophelia”, along with behind-the-scenes footage from the music video shoot, brand new lyric videos, and Taylor’s never-before-seen personal reflections on songs from her 12th studio album, The Life of a Showgirl.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/b2/8d/b28d5dc22