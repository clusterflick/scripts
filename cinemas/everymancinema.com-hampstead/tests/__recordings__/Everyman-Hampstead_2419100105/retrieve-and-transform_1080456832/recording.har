MovieCredit\",\"actor\":{\"firstName\":\"Christopher\",\"lastName\":\"Lloyd\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Kathleen\",\"lastName\":\"Turner\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Amy\",\"lastName\":\"Irving\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joanna\",\"lastName\":\"Cassidy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Stubby\",\"lastName\":\"Kaye\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joel\",\"lastName\":\"Silver\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Wayne\",\"lastName\":\"Allwine\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Richard\",\"lastName\":\"LeParmentier\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"1988-07-18T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"Contains moderate violence, mild language, sex references and innuendo\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[],\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}]},{\"releasedAt\":\"2026-02-12T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"Contains moderate violence, mild language, sex references and innuendo\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[],\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Who Framed Roger Rabbit\",\"synopsis\":\"When Toontown's owner is found murdered, all fingers point to cartoon superstar Roger Rabbit. With nowhere else to turn—and the sinister, power-hungry Judge Doom hot on his tail—Roger begs the Toon-hating detective Eddie Valiant to find the real evildoer. But the plot thickens as Eddie uncovers scandal after scandal and realizes the very existence of Toontown is at stake!\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/9d/ea/9dea4f135af646883f1ec8c75375cca3.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/97e7268512da438282d363fde389b5dd.jpg\",\"synopsis\":\"Selected by the Production and Technology Branch, Everyman presents: Who Framed Roger Rabbit\\n\\nDown-on-his-luck private eye Eddie Valiant (Bob Hoskins) gets hired by cartoon producer R.K. Maroon (Alan Tilvern) to investigate an adultery scandal involving Jessica Rabbit (Kathleen Turner), the sultry wife of Maroon's biggest star, Roger Rabbit (Charles Fleischer). But when Marvin Acme (Stubby Kaye), Jessica's alleged paramour and the owner of Toontown, is found murdered, the villainous Judge Doom (Christopher Lloyd) vows to catch and destroy Roger.\\n\\nEddie Valiant (Bob Hoskins) is a private eye in 1930s Los Angeles who gains an unexpected client—Roger Rabbit, a cartoon film star, for Eddie lives in a world where cartoon characters are as real as humans. Director Robert Zemeckis’s witty comedy-mystery is a dazzling mix of live-action and animation that incorporates beloved cartoon characters from Disney and other studios. Nominated for its art direction, cinematography, and sound, it won for its film editing, sound effects editing, and visual effects. Richard Williams also received a Special Achievement Award from the Academy for his animation direction. \\n\\nPresented in 2k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 12 February.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/f4722a026013815366b0cb620465a47b.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Who Framed Roger Rabbit\",\"synopsis\":\"Selected by the Production and Technology Branch, Everyman presents: Who Framed Roger Rabbit\\n\\nDown-on-his-luck private eye Eddie Valiant (Bob Hoskins) gets hired by cartoon producer R.K. Maroon (Alan Tilvern) to investigate an adultery scandal involving Jessica Rabbit (Kathleen Turner), the sultry wife of Maroon's biggest star, Roger Rabbit (Charles Fleischer). But when Marvin Acme (Stubby Kaye), Jessica's alleged paramour and the owner of Toontown, is found murdered, the villainous Judge Doom (Christopher Lloyd) vows to catch and destroy Roger.\\n\\nEddie Valiant (Bob Hoskins) is a private eye in 1930s Los Angeles who gains an unexpected client—Roger Rabbit, a cartoon film star, for Eddie lives in a world where cartoon characters are as real as humans. Director Robert Zemeckis’s witty comedy-mystery is a dazzling mix of live-action and animation that incorporates beloved cartoon characters from Disney and other studios. Nominated for its art direction, cinematography, and sound, it won for its film editing, sound effects editing, and visual effects. Richard Williams also received a Special Achievement Award from the Academy for his animation direction. \\n\\nPresented in 2k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 12 February.\",\"certificate\":\"PG\",\"casting\":[\"Bob Hoskins\",\"Charles Fleischer\",\"Christopher Lloyd\",\"Kathleen Turner\",\"Amy Irving\",\"Joanna Cassidy\",\"Stubby Kaye\",\"Joel Silver\",\"Wayne Allwine\",\"Richard LeParmentier\"],\"direction\":[\"Robert Zemeckis\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/f4722a026013815366b0cb620465a47b.jpg\",\"medias/nmedia/18/87/77/09/19965145.jpg\",\"medias/nmedia/18/87/77/09/19965144.jpg\",\"medias/nmedia/18/87/77/09/19965142.jpg\",\"medias/nmedia/18/87/77/09/19965141.jpg\",\"medias/nmedia/18/87/77/09/19965140.jpg\",\"medias/nmedia/18/87/77/09/19965139.jpg\",\"medias/nmedia/18/87/77/09/19965138.jpg\",\"medias/nmedia/18/87/77/09/19965137.jpg\",\"medias/nmedia/18/87/77/09/19965136.jpg\",\"medias/nmedia/18/87/77/09/19965135.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/f4722a026013815366b0cb620465a47b.jpg\"],\"release\":\"1988-07-18T00:00:00.000Z\",\"advisory\":\"Contains moderate violence, mild language, sex references and innuendo\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Walt Disney\"}},{\"id\":\"303957\",\"title\":\"Wicked: For Good\",\"runtime\":8280,\"genres\":\"Fantasy, Adventure, Musical, Romance\",\"__typename\":\"Movie\",\"altId\":[\"331891\",\"393925\"],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"poster\":\"img/7d/a6/7da6e2d78e05ecbda12c9a41909b8196.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/a1/df/a1df83bfaa036431eb0aa6c44bd92d73.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/96/c5/96c53d84fba471cefdf77dff0b98e0d1.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/f9/88/f98868abbb563eb6af0e2836407afa3f.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jon M.\",\"lastName\":\"Chu\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ariana\",\"lastName\":\"Grande\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cynthia\",\"lastName\":\"Erivo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jonathan\",\"lastName\":\"Bailey\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ethan\",\"lastName\":\"Slater\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michelle\",\"lastName\":\"Yeoh\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jeff\",\"lastName\":\"Goldblum\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marissa\",\"lastName\":\"Bode\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Peter\",\"lastName\":\"Dinklage\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ryan\",\"lastName\":\"Mann\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Adam\",\"lastName\":\"James\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-21T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"26962\",\"name\":\"Universal Pictures International\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Wicked: For Good\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/7d/a6/7da6e2d78e05ecbda12c9a41909b8196.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/b755824ab3338fb49231a141005970cf.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":\"Wicked: For Good follows Elphaba, the future Wicked Witch of the West and her relationship with Glinda, the Good Witch of the North. The second of a two-part feature film adaptation of the Broadway musical.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Wicked: For Good\",\"synopsis\":\"Wicked: For Good follows Elphaba, the future Wicked Witch of the West and her relationship with Glinda, the Good Witch of the North. The second of a two-part feature film adaptation of the Broadway musical.\",\"certificate\":null,\"casting\":[\"Ariana Grande\",\"Cynthia Erivo\",\"Jonathan Bailey\",\"Ethan Slater\",\"Michelle Yeoh\",\"Jeff Goldblum\",\"Marissa Bode\",\"Peter Dinklage\",\"Ryan Mann\",\"Adam James\"],\"direction\":[\"Jon M. Chu\"],\"coDirection\":[],\"pictures\":[\"img/a1/df/a1df83bfaa036431eb0aa6c44bd92d73.jpg\",\"img/96/c5/96c53d84fba471cefdf77dff0b98e0d1.jpg\",\"img/f9/88/f98868abbb563eb6af0e2836407afa3f.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/b755824ab3338fb49231a141005970cf.jpg\"],\"release\":\"2025-11-21T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Universal Pictures International\"}},{\"id\":\"1000030394\",\"title\":\"Yi Yi\",\"runtime\":10380,\"genres\":\"Drama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/30d201121bedbe2e9af29cb442d1e270.jpg\",\"__typename\":\"Movie\",\"altId\":[\"400034\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Edward\",\"lastName\":\"Yang\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elaine\",\"lastName\":\"Jin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Chen\",\"lastName\":\"Xisheng\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Issey\",\"lastName\":\"Ogata\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-16T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"13079\",\"name\":\"ICA Films\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Branch Selects: Yi Yi\",\"synopsis\":\"NJ Jian, his wife Min-Min and their two kids are a typical middle-class family, sharing their Taipei apartment with Min-Min's elderly other.  Now in his mid-forties, NJ is a partner in a computer hardware firm which made big profits but will go bankrupt soon if it doesn't change direction.  NJ warms to the idea of teaming up with Ota, an innovative designer of games software in Japan, and enjoys spending time with the charming and urbane Japanese man.  Things start to go wrong for the Jians on the day that Min-Min's brother A-Di gets married - Min-Min's mother suffers a stroke and falls into a coma, and NJ bumps into Sherry, his first childhood sweetheart, a woman (now married to an American) he hasn't seen for twenty years.  In the following weeks, Min-Min will breakdown and disappear to a religious retreat, her daughter Ting-Ting will get her first rough lessons in love, her son Yang-Yang will get into trouble at school and her brother A-Di will have to deal with a clash between the bride he chose and the woman he spurned.  There will be an ugly murder in the apartment block where the Jians live; a young man will give in to his sense that life is inherently unfair and cruel and commit a crime which will ruin his own life.  NJ will go to Tokyo to negotiate with Ota - but also to secretly meet Sherry and find out if life can really give him a second chance.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/1c/c4/1cc463f50e413d503bd3f788fc0556a1.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Yi Yi\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/30d201121bedbe2e9af29cb442d1e270.jpg\",\"synopsis\":\"Selected by the Directors Branch, Everyman presents: Yi Yi.\\n\\nSet in Taiwan, the film follows the lives of the Jian family from the alternating perspectives of the three main family members: father N.J. (Nien-Jen Wu), teenage daughter Ting-Ting (Elaine Jin) and young son Yang-Yang (Issei Ogata). N.J., disgruntled with his current job, attempts to court the favor of a prominent video game company while Ting-Ting and Yang-Yang contend with the various trials of youth, all while caring for N.J.'s mother-in-law, who lies in a coma.\\n\\nWriter-director Edward Yang’s nearly three-hour comedy-drama earned the filmmaker the Best Director Award at the 2000 Cannes Film Festival. Focusing on three generations of one family during a hot Taipei summer, Yi-Yi tells an intimate yet expansive story that finds room to explore a variety of characters, from the father who questions his life after encountering a lost love to the young boy who chooses to photograph the backs of people’s heads. The final feature from the master filmmaker. It is widely considered one of the great films of the new century.  \\n\\nPresented in 4k, the feature returns to the big screen at Everyman The Whiteley on Thursday, 16 October.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/73dda4569c3f94cdc693ed210ec5a57e.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Branch Selects: Yi Yi\",\"synopsis\":\"Selected by the Directors Branch, Everyman presents: Yi Yi.\\n\\nSet in Taiwan, the film follows the lives of the Jian family from the alternating perspectives of the three main family members: father N.J. (Nien-Jen Wu), teenage daughter Ting-Ting (Elaine Jin) and young son Yang-Yang (Issei Ogata). N.J., disgruntled with his current job, attempts to court the favor of a prominent video game company while Ting-Ting and Yang-Yang contend with the various trials of youth, all while caring for N.J.'s mother-in-law, who lies in a coma.\\n\\nWriter-director Edward Yang’s nearly three-hour comedy-drama earned the filmmaker the Best Director Award at the 2000 Cannes Film Festival. Focusing on three generations of one family during a hot Taipei summer, Yi-Yi tells an intimate yet expansive story that finds room to explore a variety of characters, from the father who questions his life after encountering a lost love to the young boy who chooses to photograph the backs of people’s heads. The final feature from the master filmmaker. It is widely considered one of the great films of the new century.  \\n\\nPresented in 4k, the feature returns to the big screen at Everyman The Whiteley on Thursday, 16 October.\",\"certificate\":null,\"casting\":[\"Elaine Jin\",\"Chen Xisheng\",\"Issey Ogata\"],\"direction\":[\"Edward Yang\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/73dda4569c3f94cdc693ed210ec5a57e.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/73dda4569c3f94cdc693ed210ec5a57e.jpg\"],\"release\":\"2025-10-16T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"ICA Films\"}},{\"id\":\"25300\",\"title\":\"Yi Yi\",\"runtime\":10380,\"genres\":\"Drama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4c013f906e603d8e24f3b81fb958a650.jpg\",\"__typename\":\"Movie\",\"altId\":[\"27568\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"releases\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/78/82/19966963.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/78/82/19966962.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/78/82/19966961.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/78/82/19966960.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/78/82/19966959.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/78/82/19966958.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/78/82/19966957.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/78/82/19966956.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/78/82/19966955.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/78/82/19966954.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Edward\",\"lastName\":\"Yang\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elaine\",\"lastName\":\"Jin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Chen\",\"lastName\":\"Xisheng\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Issey\",\"lastName\":\"Ogata\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jonathan\",\"lastName\":\"Chang\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kelly\",\"lastName\":\"Lee\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Wu\",\"lastName\":\"Nianzhen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"A One and a Two... (Yi Yi)\",\"synopsis\":\"NJ Jian, his wife Min-Min and their two kids are a typical middle-class family, sharing their Taipei apartment with Min-Min's elderly other.  Now in his mid-forties, NJ is a partner in a computer hardware firm which made big profits but will go bankrupt soon if it doesn't change direction.  NJ warms to the idea of teaming up with Ota, an innovative designer of games software in Japan, and enjoys spending time with the charming and urbane Japanese man.  Things start to go wrong for the Jians on the day that Min-Min's brother A-Di gets married - Min-Min's mother suffers a stroke and falls into a coma, and NJ bumps into Sherry, his first childhood sweetheart, a woman (now married to an American) he hasn't seen for twenty years.  In the following weeks, Min-Min will breakdown and disappear to a religious retreat, her daughter Ting-Ting will get her first rough lessons in love, her son Yang-Yang will get into trouble at school and her brother A-Di will have to deal with a clash between the bride he chose and the woman he spurned.  There will be an ugly murder in the apartment block where the Jians live; a young man will give in to his sense that life is inherently unfair and cruel and commit a crime which will ruin his own life.  NJ will go to Tokyo to negotiate with Ota - but also to secretly meet Sherry and find out if life can really give him a second chance.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"embargoes\":[],\"exhibitor\":{\"title\":\"Yi Yi\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/4c013f906e603d8e24f3b81fb958a650.jpg\",\"synopsis\":\"Selected by the Directors Branch, Everyman presents: Yi Yi.\\n\\nSet in Taiwan, the film follows the lives of the Jian family from the alternating perspectives of the three main family members: father N.J. (Nien-Jen Wu), teenage daughter Ting-Ting (Elaine Jin) and young son Yang-Yang (Issei Ogata). N.J., disgruntled with his current job, attempts to court the favor of a prominent video game company while Ting-Ting and Yang-Yang contend with the various trials of youth, all while caring for N.J.'s mother-in-law, who lies in a coma.\\n\\nWriter-director Edward Yang’s nearly three-hour comedy-drama earned the filmmaker the Best Director Award at the 2000 Cannes Film Festival. Focusing on three generations of one family during a hot Taipei summer, Yi-Yi tells an intimate yet expansive story that finds room to explore a variety of characters, from the father who questions his life after encountering a lost love to the young boy who chooses to photograph the backs of people’s heads. The final feature from the master filmmaker. It is widely considered one of the great films of the new century.  \\n\\nPresented in 4k, the feature returns to the big screen at Everyman The Whiteley on Thursday, 16 October.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/082b3cff58ca88bfee3de60919e4c060.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Yi Yi\",\"synopsis\":\"Selected by the Directors Branch, Everyman presents: Yi Yi.\\n\\nSet in Taiwan, the film follows the lives of the Jian family from the alternating perspectives of the three main family members: father N.J. (Nien-Jen Wu), teenage daughter Ting-Ting (Elaine Jin) and young son Yang-Yang (Issei Ogata). N.J., disgruntled with his current job, attempts to court the favor of a prominent video game company while Ting-Ting and Yang-Yang contend with the various trials of youth, all while caring for N.J.'s mother-in-law, who lies in a coma.\\n\\nWriter-director Edward Yang’s nearly three-hour comedy-drama earned the filmmaker the Best Director Award at the 2000 Cannes Film Festival. Focusing on three generations of one family during a hot Taipei summer, Yi-Yi tells an intimate yet expansive story that finds room to explore a variety of characters, from the father who questions his life after encountering a lost love to the young boy who chooses to photograph the backs of people’s heads. The final feature from the master filmmaker. It is widely considered one of the great films of the new century.  \\n\\nPresented in 4k, the feature returns to the big screen at Everyman The Whiteley on Thursday, 16 October.\",\"casting\":[\"Elaine Jin\",\"Chen Xisheng\",\"Issey Ogata\",\"Jonathan Chang\",\"Kelly Lee\",\"Wu Nianzhen\"],\"direction\":[\"Edward Yang\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/082b3cff58ca88bfee3de60919e4c060.jpg\",\"medias/nmedia/18/87/78/82/19966963.jpg\",\"medias/nmedia/18/87/78/82/19966962.jpg\",\"medias/nmedia/18/87/78/82/19966961.jpg\",\"medias/nmedia/18/87/78/82/19966960.jpg\",\"medias/nmedia/18/87/78/82/19966959.jpg\",\"medias/nmedia/18/87/78/82/19966958.jpg\",\"medias/nmedia/18/87/78/82/19966957.jpg\",\"medias/nmedia/18/87/78/82/19966956.jpg\",\"medias/nmedia/18/87/78/82/19966955.jpg\",\"medias/nmedia/18/87/78/82/19966954.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/082b3cff58ca88bfee3de60919e4c060.jpg\"],\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000029693\",\"title\":\"You're Invited to Downton Abbey: The Grand Finale\",\"runtime\":null,\"genres\":\"Historical, Drama\",\"__typename\":\"Movie\",\"altId\":[\"399030\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c46e95b298660952302a574272c37834.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Simon\",\"lastName\":\"Curtis\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michelle\",\"lastName\":\"Dockery\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hugh\",\"lastName\":\"Bonneville\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Laura\",\"lastName\":\"Carmichael\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jim\",\"lastName\":\"Carter\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brendan\",\"lastName\":\"Coyle\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joanne\",\"lastName\":\"Froggatt\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rob\",\"lastName\":\"James-Collier\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Allen\",\"lastName\":\"Leech\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Phyllis\",\"lastName\":\"Logan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elizabeth\",\"lastName\":\"McGovern\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":null,\"__typename\":\"Release\",\"rating\":{\"advisory\":\"mild bad language, sex references\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[],\"distributors\":[{\"id\":\"26962\",\"name\":\"Universal Pictures International\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"You're Invited to Downton Abbey: The Grand Finale\",\"synopsis\":\"DOWNTON ABBEY: THE GRAND FINALE, the cinematic return of the global phenomenon, follows the Crawley family and their staff as they enter the 1930s. As the beloved cast of characters navigates how to lead Downton Abbey into the future, they must embrace change and welcome a new chapter.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/39/0a/390a228e24a495dabed0506e038f03ef.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/c46e95b298660952302a574272c37834.jpg\",\"synopsis\":\"On behalf of the Crawley Family, you’re cordially invited to raise a glass and celebrate the Grand Finale of the Downton Abbey saga.\\n\\nThe evening begins with a prosecco reception, accompanied by delectable canapés and music to set the tone. As is tradition at Downton, style is encouraged; pearls, tailored suits, and your finest attire, though it is by no means required.\\n\\nAfter the reception, we’ll then gather in the luxurious screening room, where refined comforts and indulgences await as the curtain rises on the silver screen, and the grand finale begins.\\n\\nSet in the summer of 1930, the Crawleys find themselves facing financial troubles and the threat of social disgrace, while Lady Mary is drawn into the heart of a public scandal…\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/30e00f3be9e868a9ea7b5b96c77137ec.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"You're Invited to Downton Abbey: The Grand Finale\",\"synopsis\":\"On behalf of the Crawley Family, you’re cordially invited to raise a glass and celebrate the Grand Finale of the Downton Abbey saga.\\n\\nThe evening begins with a prosecco reception, accompanied by delectable canapés and music to set the tone. As is tradition at Downton, style is encouraged; pearls, tailored suits, and your finest attire, though it is by no means required.\\n\\nAfter the reception, we’ll then gather in the luxurious screening room, where refined comforts and indulgences await as the curtain rises on the silver screen, and the grand finale begins.\\n\\nSet in the summer of 1930, the Crawleys find themselves facing financial troubles and the threat of social disgrace, while Lady Mary is drawn into the heart of a public scandal…\",\"certificate\":\"PG\",\"casting\":[\"Michelle Dockery\",\"Hugh Bonneville\",\"Laura Carmichael\",\"Jim Carter\",\"Brendan Coyle\",\"Joanne Froggatt\",\"Rob James-Collier\",\"Allen Leech\",\"Phyllis Logan\",\"Elizabeth McGovern\"],\"direction\":[\"Simon Curtis\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/30e00f3be9e868a9ea7b5b96c77137ec.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/30e00f3be9e868a9ea7b5b96c77137ec.jpg\"],\"release\":null,\"advisory\":\"mild bad language, sex references\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Universal Pictures International\"}},{\"id\":\"277428\",\"title\":\"Zootopia 2\",\"runtime\":null,\"genres\":\"Animation, Adventure, Family, Comedy\",\"__typename\":\"Movie\",\"altId\":[\"356969\",\"393926\",\"393927\",\"393928\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/115461a03694877466600f8a9a9a936e.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/50/91/5091aba659d3f77bdb94aa1fbf6f0fb5.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/4d/5c/4d5cc0ddcfd3cc14476c3ae21240340c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/8b/e0/8be05ff7cb817954bac3017219200e42.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/2b/4b/2b4be5e8fe733e7994b7fa5350136b5e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e2/dd/e2dd469c1159c135412c2b2ba0e35bec.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/fe/9f/fe9ff009d3f8527a04cec20b571c340c.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Byron\",\"lastName\":\"Howard\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jared\",\"lastName\":\"Bush\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Ginnifer\",\"lastName\":\"Goodwin\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Jason\",\"lastName\":\"Bateman\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Ke Huy\",\"lastName\":\"Quan\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":null,\"lastName\":\"Shakira\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Quinta\",\"lastName\":\"Brunson\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Fortune\",\"lastName\":\"Feimster\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Idris\",\"lastName\":\"Elba\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Jean\",\"lastName\":\"Reno\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Jenny\",\"lastName\":\"Slate\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Maurice\",\"lastName\":\"LaMarche\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2025-11-28T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Zootopia 2\",\"synopsis\":\"In Walt Disney Animation Studios’ “Zootopia 2,” detectives Judy Hopps (voiced by Ginnifer Goodwin) and Nick Wilde (voiced by Jason Bateman) find themselves on the twisting trail of a mysterious reptile who arrives in Zootopia and turns the mammal metropolis upside down. To crack the case, Judy and Nick must go undercover to unexpected new parts of town, where their growing partnership is tested like never before.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/88/90/88906f36e83439eb10db417a842337ae.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/7c78049f6775184faad761abd5764642.jpg\",\"__typename\":\"BOAppImage\"}]}},\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/115461a03694877466600f8a9a9a936e.jpg\",\"synopsis\":\"In Walt Disney Animation Studios’ “Zootopia 2,” detectives Judy Hopps (Ginnifer Goodwin) and Nick Wilde (Jason Bateman) find themselves on the twisting trail of a mysterious reptile who arrives in Zootopia and turns the mammal metropolis upside down. To crack the case, Judy and Nick must go undercover to unexpected new parts of town, where their growing partnership is tested like never before.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/6c3a1e9838c7b814bad3d27ccf12932f.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Zootopia 2\",\"synopsis\":\"In Walt Disney Animation Studios’ “Zootopia 2,” detectives Judy Hopps (Ginnifer Goodwin) and Nick Wilde (Jason Bateman) find themselves on the twisting trail of a mysterious reptile who arrives in Zootopia and turns the mammal metropolis upside down. To crack the case, Judy and Nick must go undercover to unexpected new parts of town, where their growing partnership is tested like never before.\",\"certificate\":null,\"casting\":[\"Ginnifer Goodwin\",\"Jason Bateman\",\"Ke Huy Quan\",\"Shakira\",\"Quinta Brunson\",\"Fortune Feimster\",\"Idris Elba\",\"Jean Reno\",