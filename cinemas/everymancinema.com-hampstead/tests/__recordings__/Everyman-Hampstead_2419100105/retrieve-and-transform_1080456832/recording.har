":[],\"distributors\":[{\"id\":\"24287\",\"name\":\"Independent\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"The Lost Bus\",\"synopsis\":\"From director Paul Greengrass and inspired by real events, “The Lost Bus” is a white-knuckle ride through one of America’s deadliest wildfires as a wayward school bus driver (Matthew McConaughey) and a dedicated school teacher (America Ferrera) battle to save 22 children from the terrifying inferno.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/cb/c0/cbc0bc0941a01ee9a0383cba6ee0be64.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/500430a39999e5ee4e7b9e047ecf4c75.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/1f744a2511e3b1d60ace33f8a842bf1c.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/7958c869b6734e8c47bbc14db19e37c6.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Lost Bus\",\"synopsis\":\"From director Paul Greengrass and inspired by real events, “The Lost Bus” is a white-knuckle ride through one of America’s deadliest wildfires as a wayward school bus driver (Matthew McConaughey) and a dedicated school teacher (America Ferrera) battle to save 22 children from the terrifying inferno.\",\"certificate\":\"15\",\"casting\":[\"Matthew McConaughey\",\"America Ferrera\",\"Yul Vazquez\",\"Ashlie Atkinson\",\"Spencer Watson\",\"Danny McCarthy\",\"Carrie Lazar\",\"Peter Diseth\",\"Christopher Hagen\",\"Mo Beatty\"],\"direction\":[\"Paul Greengrass\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/7958c869b6734e8c47bbc14db19e37c6.jpg\",\"img/24/d1/24d12f5f7ba30ac653abc0fa8555a5a8.jpg\",\"img/47/dc/47dc8f7fa852170940549b97acb7c1e9.jpg\",\"img/6b/f0/6bf080f897ecafd70b1b864ef027fe10.jpg\",\"img/ea/00/ea0091f66351ec28eb1247aaf62cfe4c.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/7958c869b6734e8c47bbc14db19e37c6.jpg\",\"https://cms-assets.webediamovies.pro/production/2/500430a39999e5ee4e7b9e047ecf4c75.jpg\"],\"release\":\"2025-09-26T00:00:00.000Z\",\"advisory\":\"strong language, sustained threat\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Independent\"}},{\"id\":\"1000021616\",\"title\":\"The MET Opera 2025-26 : El Último Sueño de Frida y Diego\",\"runtime\":10080,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"388908\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/12488f1932717fcea5b57f91d6c52b1c.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Deborah\",\"lastName\":\"Colker\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gabriella\",\"lastName\":\"Reyes\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Isabel\",\"lastName\":\"Leonard\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nils\",\"lastName\":\"Wanderer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Carlos\",\"lastName\":\"Alvarez\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-05-30T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Metropolitan Opera : El Último Sueño de Frida y Diego\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/1d/68/1d6878c942189268a7bc00a4730cefb1.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"The MET Opera 2025-26 : El Último Sueño de Frida y Diego\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/12488f1932717fcea5b57f91d6c52b1c.jpg\",\"synopsis\":\"On May 30, the Metropolitan Opera’s 2025–26 Live in HD season comes to a close with a live transmission of American composer Gabriela Lena Frank’s first opera, a magical-realist portrait of Mexico’s painterly power couple Frida Kahlo and Diego Rivera, with libretto by Pulitzer Prize–winning playwright Nilo Cruz. Fashioned as a reversal of the Orpheus and Euridice myth, the story depicts Frida, sung by leading mezzo-soprano Isabel Leonard, leaving the underworld on the Day of the Dead and reuniting with Diego, portrayed by baritone Carlos Álvarez. The famously feuding pair briefly relive their tumultuous love, embracing both the passion and the pain before bidding the land of the living a final farewell. Music Director Yannick Nézet-Séguin conducts the Met-premiere staging of Frank’s opera, a “confident, richly imagined score” (The New Yorker) that “bursts with color and fresh individuality” (Los Angeles Times). The vibrant new production, taking enthusiastic inspiration from Frida and Diego’s paintings, is directed and choreographed by Deborah Colker.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/52d8b7ca613f8311e54d725a38559cf9.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Metropolitan Opera: El Último Sueño de Frida y Diego\",\"synopsis\":\"On May 30, the Metropolitan Opera’s 2025–26 Live in HD season comes to a close with a live transmission of American composer Gabriela Lena Frank’s first opera, a magical-realist portrait of Mexico’s painterly power couple Frida Kahlo and Diego Rivera, with libretto by Pulitzer Prize–winning playwright Nilo Cruz. Fashioned as a reversal of the Orpheus and Euridice myth, the story depicts Frida, sung by leading mezzo-soprano Isabel Leonard, leaving the underworld on the Day of the Dead and reuniting with Diego, portrayed by baritone Carlos Álvarez. The famously feuding pair briefly relive their tumultuous love, embracing both the passion and the pain before bidding the land of the living a final farewell. Music Director Yannick Nézet-Séguin conducts the Met-premiere staging of Frank’s opera, a “confident, richly imagined score” (The New Yorker) that “bursts with color and fresh individuality” (Los Angeles Times). The vibrant new production, taking enthusiastic inspiration from Frida and Diego’s paintings, is directed and choreographed by Deborah Colker.\",\"certificate\":null,\"casting\":[\"Gabriella Reyes\",\"Isabel Leonard\",\"Nils Wanderer\",\"Carlos Alvarez\"],\"direction\":[\"Deborah Colker\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/52d8b7ca613f8311e54d725a38559cf9.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/52d8b7ca613f8311e54d725a38559cf9.jpg\"],\"release\":\"2026-05-30T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000000405\",\"title\":\"The Roses\",\"runtime\":6300,\"genres\":\"Comedydrama\",\"__typename\":\"Movie\",\"altId\":[\"359558\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/28eb8db0be95a1aa0a5b51dc5fd71556.jpg\",\"images\":[{\