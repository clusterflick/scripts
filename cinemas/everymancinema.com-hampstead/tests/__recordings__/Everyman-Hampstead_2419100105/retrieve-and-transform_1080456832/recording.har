8.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/c9/94/c9946bdc5ddab7d74b340b46e6030467.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/0d/fd/0dfd011c9452529aaf0832ba691ef050.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Daniel\",\"lastName\":\"Chong\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Piper\",\"lastName\":\"Curda\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Bobby\",\"lastName\":\"Moynihan\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Jon\",\"lastName\":\"Hamm\",\"__typename\":\"Person\"}}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2026-03-06T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Hoppers\",\"synopsis\":\"What if you could talk to animals and understand what they’re saying? In Disney and Pixar’s all-new feature film “Hoppers,” scientists have discovered how to “hop” human consciousness into lifelike robotic animals, allowing people to communicate with animals as animals! The adventure introduces Mabel, an animal lover who seizes an opportunity to use the technology, uncovering mysteries within the animal world that are beyond anything she could have imagined. Directed by Daniel Chong and produced by Nicole Paradis Grindle, “Hoppers” features the voices of Piper Curda, Bobby Moynihan and Jon Hamm. The film opens exclusively in theaters in 2026.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/da/c6/dac62f7c6783f303ae540c78c92cb1fc.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/972dea38635c0ef11600ab9cd8859c48.jpg\",\"synopsis\":\"What if you could talk to animals and understand what they’re saying? In Disney and Pixar’s all-new feature film “Hoppers,” scientists have discovered how to “hop” human consciousness into lifelike robotic animals, allowing people to communicate with animals as animals! \\n\\nThe adventure introduces Mabel, an animal lover who seizes an opportunity to use the technology, uncovering mysteries within the animal world that are beyond anything she could have imagined. \\n\\nDirected by Daniel Chong and produced by Nicole Paradis Grindle, “Hoppers” features the voices of Piper Curda, Bobby Moynihan and Jon Hamm.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/56969df0ab0ce2ce3c7917f28cb2dc4f.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Hoppers\",\"synopsis\":\"What if you could talk to animals and understand what they’re saying? In Disney and Pixar’s all-new feature film “Hoppers,” scientists have discovered how to “hop” human consciousness into lifelike robotic animals, allowing people to communicate with animals as animals! \\n\\nThe adventure introduces Mabel, an animal lover who seizes an opportunity to use the technology, uncovering mysteries within the animal world that are beyond anything she could have imagined. \\n\\nDirected by Daniel Chong and produced by Nicole Paradis Grindle, “Hoppers” features the voices of Piper Curda, Bobby Moynihan and Jon Hamm.\",\"certificate\":null,\"casting\":[\"Piper Curda\",\"Bobby Moynihan\",\"Jon Hamm\"],\"direction\":[\"Daniel Chong\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/56969df0ab0ce2ce3c7917f28cb2dc4f.jpg\",\"img/c9/94/c9946bdc5ddab7d74b340b46e6030467.jpg\",\"img/0d/fd/0dfd011c9452529aaf0832ba691ef050.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/56969df0ab0ce2ce3c7917f28cb2dc4f.jpg\"],\"release\":\"2026-03-06T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Walt Disney\"}},{\"id\":\"313481\",\"title\":\"How to Train Your Dragon\",\"runtime\":7500,\"genres\":\"Adventure, Fantasy, Action\",\"__typename\":\"Movie\",\"altId\":[\"343735\",\"380694\",\"380695\",\"380696\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/511d0c922eb7dac2652382da0bbb6e49.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/68/cc/68ccf1a8b1700da565437680a59c4c48.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/bf/d7/bfd70c215d7ef2e4cd8edf3a66b0aa82.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/7c/0d/7c0d28d27f269165983063580401f67c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/7b/1a/7b1ac6e1236e6f203462e648b496dc35.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/2d/9d/2d9d5c0407184fa787516c6ac5c416cd.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/cd/6c/cd6c95ec1a4ebfbce069bc7a22718f2f.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/5a/51/5a51ea97479fb73237d5291b1ed646c0.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/2a/a5/2aa59a080860eb34ac1aecccb3ff6208.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/36/d9/36d9208b8e50f7b2e72c26707a2e483d.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Dean\",\"lastName\":\"DeBlois\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mason\",\"lastName\":\"Thames\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gerard\",\"lastName\":\"Butler\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nico\",\"lastName\":\"Parker\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nick\",\"lastName\":\"Frost\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gabriel\",\"lastName\":\"Howell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Julian\",\"lastName\":\"Dennison\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bronwyn\",\"lastName\":\"James\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Harry\",\"lastName\":\"Trevaldwyn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ruth\",\"lastName\":\"Codd\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Peter\",\"lastName\":\"Serafinowicz\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-06-09T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"mild threat, scary scenes, violence, language\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[],\"distributors\":[{\"id\":\"26962\",\"name\":\"Universal Pictures International\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"How to Train Your Dragon\",\"synopsis\":\"On the rugged isle of Berk, where Vikings and dragons have been bitter enemies for generations, Hiccup (Mason Thames; The Black Phone, For All Mankind) stands apart. The inventive yet overlooked son of Chief Stoick the Vast (Gerard Butler, reprising his voice role from the animated franchise), Hiccup defies centuries of tradition when he befriends Toothless, a feared Night Fury dragon. Their unlikely bond reveals the true nature of dragons, challenging the very foundations of Viking society. \\n\\nWith the fierce and ambitious Astrid (BAFTA nominee Nico Parker; Dumbo, The Last of Us) and the village’s quirky blacksmith Gobber (Nick Frost; Snow White and the Huntsman, Shaun of the Dead) by his side, Hiccup confronts a world torn by fear and misunderstanding. \\nAs an ancient threat emerges, endangering both Vikings and dragons, Hiccup’s friendship with Toothless becomes the key to forging a new future. Together, they must navigate the delicate path toward peace, soaring beyond the boundaries of their worlds and redefining what it means to be a hero and a leader.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/343735_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/343735_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/8f/2b/8f2b04bbebc41d4156b78e331cd552d1.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/3832516832156bf5bab3cc4c9603c850.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/511d0c922eb7dac2652382da0bbb6e49.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/18e4fa0176a27fb242403c6376b4f7d2.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"How To Train Your Dragon\",\"synopsis\":\"On the rugged isle of Berk, where Vikings and dragons have been bitter enemies for generations, Hiccup (Mason Thames; The Black Phone, For All Mankind) stands apart. The inventive yet overlooked son of Chief Stoick the Vast (Gerard Butler, reprising his voice role from the animated franchise), Hiccup defies centuries of tradition when he befriends Toothless, a feared Night Fury dragon. Their unlikely bond reveals the true nature of dragons, challenging the very foundations of Viking society. \\n\\nWith the fierce and ambitious Astrid (BAFTA nominee Nico Parker; Dumbo, The Last of Us) and the village’s quirky blacksmith Gobber (Nick Frost; Snow White and the Huntsman, Shaun of the Dead) by his side, Hiccup confronts a world torn by fear and misunderstanding. \\nAs an ancient threat emerges, endangering both Vikings and dragons, Hiccup’s friendship with Toothless becomes the key to forging a new future. Together, they must navigate the delicate path toward peace, soaring beyond the boundaries of their worlds and redefining what it means to be a hero and a leader.\",\"certificate\":\"PG\",\"casting\":[\"Mason Thames\",\"Gerard Butler\",\"Nico Parker\",\"Nick Frost\",\"Gabriel Howell\",\"Julian Dennison\",\"Bronwyn James\",\"Harry Trevaldwyn\",\"Ruth Codd\",\"Peter Serafinowicz\"],\"direction\":[\"Dean DeBlois\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/18e4fa0176a27fb242403c6376b4f7d2.jpg\",\"img/68/cc/68ccf1a8b1700da565437680a59c4c48.jpg\",\"img/bf/d7/bfd70c215d7ef2e4cd8edf3a66b0aa82.jpg\",\"img/7c/0d/7c0d28d27f269165983063580401f67c.jpg\",\"img/7b/1a/7b1ac6e1236e6f203462e648b496dc35.jpg\",\"img/2d/9d/2d9d5c0407184fa787516c6ac5c416cd.jpg\",\"img/cd/6c/cd6c95ec1a4ebfbce069bc7a22718f2f.jpg\",\"img/5a/51/5a51ea97479fb73237d5291b1ed646c0.jpg\",\"img/2a/a5/2aa59a080860eb34ac1aecccb3ff6208.jpg\",\"img/36/d9/36d9208b8e50f7b2e72c26707a2e483d.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/18e4fa0176a27fb242403c6376b4f7d2.jpg\",\"https://cms-assets.webediamovies.pro/production/2/3832516832156bf5bab3cc4c9603c850.jpg\"],\"release\":\"2025-06-09T00:00:00.000Z\",\"advisory\":\"mild threat, scary scenes, violence, language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/343735_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/343735_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Universal Pictures International\"}},{\"id\":\"1000009982\",\"title\":\"I Swear\",\"runtime\":7200,\"genres\":\"Drama, Biopic\",\"__typename\":\"Movie\",\"altId\":[\"373300\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/40e218b2cfc04f2d0fbd3ef6a04a3002.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Kirk\",\"lastName\":\"Jones (II)\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Aramayo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Shirley\",\"lastName\":\"Henderson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maxine\",\"lastName\":\"Peake\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Peter\",\"lastName\":\"Mullan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sanjeev\",\"lastName\":\"Kohli\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Adam\",\"lastName\":\"McNamara\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Steven\",\"lastName\":\"Cree\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Paddy\",\"lastName\":\"Towers\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jason Alan\",\"lastName\":\"Staines\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Cooke\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-10-10T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"32481\",\"name\":\"Studio Canal\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"I Swear\",\"synopsis\":\"Scottish setting, true life story of John Davidson. Diagnosed with Tourette's at 15, targeted as 'insane' by his peers, he struggled with a condition few had witnessed. Campaigning for better understanding and acceptance of the condition of Tourette's as an adult, he finds his life's purpose and accepted his MBE from the Queen in 2019.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/cb/93/cb936aabe80af16f26f65254868bd303.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/40e218b2cfc04f2d0fbd3ef6a04a3002.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/af618b91620aee1571f347a28f733b47.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"I Swear\",\"synopsis\":\"Scottish setting, true life story of John Davidson. Diagnosed with Tourette's at 15, targeted as 'insane' by his peers, he struggled with a condition few had witnessed. Campaigning for better understanding and acceptance of the condition of Tourette's as an adult, he finds his life's purpose and accepted his MBE from the Queen in 2019.\",\"certificate\":null,\"casting\":[\"Robert Aramayo\",\"Shirley Henderson\",\"Maxine Peake\",\"Peter Mullan\",\"Sanjeev Kohli\",\"Adam McNamara\",\"Steven Cree\",\"Paddy Towers\",\"Jason Alan Staines\",\"Michael Cooke\"],\"direction\":[\"Kirk Jones (II)\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/af618b91620aee1571f347a28f733b47.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/af618b91620aee1571f347a28f733b47.jpg\"],\"release\":\"2025-10-10T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Studio Canal\"}},{\"id\":\"1000029002\",\"title\":\"I Swear + Live Q&A\",\"runtime\":9000,\"genres\":\"Drama, Biopic\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4559b7954d1b27a43e3d8fc01c25e187.jpg\",\"__typename\":\"Movie\",\"altId\":[\"398140\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Kirk\",\"lastName\":\"Jones (II)\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Aramayo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Shirley\",\"lastName\":\"Henderson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maxine\",\"lastName\":\"Peake\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Peter\",\"lastName\":\"Mullan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-09-25T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"32481\",\"name\":\"Studio Canal\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"I Swear + Live Q&A\",\"synopsis\":\"True life story of John Davidson. Diagnosed with Tourette's at 15, targeted as insane by his peers, he struggled with a condition few had witnessed. Campaigning for Tourette's as an adult, he accepted his MBE from the Queen in 2019.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/9f/93/9f9300d6d22b1cd455fa2553686126f3.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/4559b7954d1b27a43e3d8fc01c25e187.jpg\",\"synopsis\":\"Join us on Thursday, 25 September, for an early preview screening of I Swear, followed by live Q&A with director Kirk Jones.\\n\\nI Swear follows the true story of Tourette Syndrome campaigner John Davidson's journey with Tourette's through his troubled teens and early adulthood, having been diagnosed at 15 years old in 1980s Britain - a time when the condition was little known and entirely misunderstood. Initially alienated from his peers and his family, Davidson perseveres in his attempt to live a 'normal' life against the odds, finding some unlikely champions along the way.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/356d3e9dbe5b6f0c750c4e7f35eafb32.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"I Swear + Live Q&A\",\"synopsis\":\"Join us on Thursday, 25 September, for an early preview screening of I Swear, followed by live Q&A with director Kirk Jones.\\n\\nI Swear follows the true story of Tourette Syndrome campaigner John Davidson's journey with Tourette's through his troubled teens and early adulthood, having been diagnosed at 15 years old in 1980s Britain - a time when the condition was little known and entirely misunderstood. Initially alienated from his peers and his family, Davidson perseveres in his attempt to live a 'normal' life against the odds, finding some unlikely champions along the way.\",\"certificate\":null,\"casting\":[\"Robert Aramayo\",\"Shirley Henderson\",\"Maxine Peake\",\"Peter Mullan\"],\"direction\":[\"Kirk Jones (II)\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/356d3e9dbe5b6f0c750c4e7f35eafb32.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/356d3e9dbe5b6f0c750c4e7f35eafb32.jpg\"],\"release\":\"2025-09-25T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Studio Canal\"}},{\"id\":\"1000031607\",\"title\":\"Indian 101 Diwali Celebration: The Lunchbox\",\"runtime\":6300,\"genres\":\"Romance, Drama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/afbb73f00616ffd0324bb6cfaee9b9c2.jpg\",\"__typename\":\"Movie\",\"altId\":[\"401455\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Ritesh\",\"lastName\":\"Batra\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Irrfan\",\"lastName\":\"Khan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nimrat\",\"lastName\":\"Kaur\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nawazuddin\",\"lastName\":\"Siddiqui\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-14T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Indian 101 Diwali Celebration: The Lunchbox\",\"synopsis\":\"Saajan, a Mumbai office worker nearing retirement, is delivered the wrong lunch by a dabbawala. Young housewife Ila  had intended it for her emotionally indifferent husband. To Saajan's surprise, the food is a vast improvement on his usual meal. \\n\\nWhen he finds a note from Ila enclosed with another meal, he decides to write back.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/72/b9/72b945754fd9d0e60fce244baf9c8c91.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/afbb73f00616ffd0324bb6cfaee9b9c2.jpg\",\"synopsis\":\"This Diwali, join chef and food writer Karan Gokani and us for a one-night-only celebration at Everyman King’s Cross.\\n\\nWe are bringing the magic of the movies and the snacks from 90s India straight to London, served alongside \\\"The Lunchbox\\\", which will make you laugh, cry, and maybe even dance in the aisles. \\n\\nKaran will kick off the evening with a short introduction, then it's lights down, music up and hearts wide open. Come dressed to dazzle and ready to shake a leg; this is not your average movie night.\\n\\nEvery ticket includes a complimentary Masala Popcorn, a beverage (Mango Lassi, Nimbu Soda, or Chai), and a range of Indian snacks.\\n\\n- Film Synopsis -\\nA mistaken delivery in Mumbai's famously efficient lunchbox delivery system connects a young housewife to an older man in the dusk of his life as they build a fantasy world together through notes in the lunchbox.\\n\\n- Event Times -\\n7:00 pm - Doors open and arrivals.\\n7:30 pm - Live introduction by Karan Gokani.\\n7:40 pm - Film starts.\\n9:20 pm - Film ends, and the event comes to a close.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Indian 101 Diwali Celebration: The Lunchbox\",\"synopsis\":\"This Diwali, join chef and food writer Karan Gokani and us for a one-night-only celebration at Everyman King’s Cross.\\n\\nWe are bringing the magic of the movies and the snacks from 90s India straight to London, served alongside \\\"The Lunchbox\\\", which will make you laugh, cry, and maybe even dance in the aisles. \\n\\nKaran will kick off the evening with a short introduction, then it's lights down, music up and hearts wide open. Come dressed to dazzle and ready to shake a leg; this is not your average movie night.\\n\\nEvery ticket includes a complimentary Masala Popcorn, a beverage (Mango Lassi, Nimbu Soda, or Chai), and a range of Indian snacks.\\n\\n- Film Synopsis -\\nA mistaken delivery in Mumbai's famously efficient lunchbox delivery system connects a young housewife to an older man in the dusk of his life as they build a fantasy world together through notes in the lunchbox.\\n\\n- Event Times -\\n7:00 pm - Doors open and arrivals.\\n7:30 pm - Live introduction by Karan Gokani.\\n7:40 pm - Film starts.\\n9:20 pm - Film ends, and the event comes to a close.\",\"certificate\":\"PG\",\"casting\":[\"Irrfan Khan\",\"Nimrat Kaur\",\"Nawazuddin Siddiqui\"],\"direction\":[\"Ritesh Batra\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-10-14T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000027006\",\"title\":\"John Cleese Packs It In\",\"runtime\":5400,\"genres\":\"Comedy\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/e698df1859c9da9a3c5ca2cf9a4c1e99.jpg\",\"__typename\":\"Movie\",\"altId\":[\"395698\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Andy\",\"lastName\":\"Curd\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Cleese\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-11-13T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"41483\",\"name\":\"CinemaLive\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"John Cleese Packs It In\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/2e/7a/2e7af1e9e27c781388ffaf7834bfc8a6.png\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/e698df1859c9da9a3c5ca2cf9a4c1e99.jpg\",\"synopsis\":\"1 85-year-old Man, 5 Countries, 16 Cities, 23 shows, 6 weeks.\\n\\nWill he make it home … or is this the end of the road?\\n\\nOne of the most recognisable figures in British comedy, John Cleese’s career spans six decades - from his early days with the Cambridge Footlights to co-founding Monty Python, co-creating Fawlty Towers, and writing and starring in the Oscar-nominated “A Fish Called Wanda”. His unique brand of black humour has made him a global icon and intergalactic treasure.\\n\\nAt the age of eighty five, John Cleese sets off on what might be his final European tour - five countries, sixteen cities, twenty-three shows, and retaining just two original body parts. “John Cleese Packs It In” is a wry, behind-the-scenes portrait of a comedy legend on the road, battling various ailments, chaotic travel, and his own stubborn refusal to stop.\\n\\nSpanning six weeks on the road, the film captures Cleese unfiltered and on the move - riffing on life, fame, and the absurdity of getting old in front of thousands of fans. As he reflects on a stage career that began in 1963, the question lingers: is this the end of the road?\\n\\nWith unique and intimate access and showing unexpected tenderness, this is a documentary about legacy, laughter, and the dignity of bowing out… however reluctantly.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/b0165064e1f48d0cf3aa0a6e6ac81f1b.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"John Cleese Packs It In\",\"synopsis\":\"1 85-year-old Man, 5 Countries, 16 Cities, 23 shows, 6 weeks.\\n\\nWill he make it home … or is this the end of the road?\\n\\nOne of the most recognisable figures in British comedy, John Cleese’s career spans six decades - from his early days with the Cambridge Footlights to co-founding Monty Python, co-creating Fawlty Towers, and writing and starring in the Oscar-nominated “A Fish Called Wanda”. His unique brand of black humour has made him a global icon and intergalactic treasure.\\n\\nAt the age of eighty five, John Cleese sets off on what might be his final European tour - five countries, sixteen cities, twenty-three shows, and retaining just two original body parts. “John Cleese Packs It In” is a wry, behind-the-scenes portrait of a comedy legend on the road, battling various ailments, chaotic travel, and his own stubborn refusal to stop.\\n\\nSpanning six weeks on the road, the film captures Cleese unfiltered and on the move - riffing on life, fame, and the absurdity of getting old in front of thousands of fans. As he reflects on a stage career that began in 1963, the question lingers: is this the end of the road?\\n\\nWith unique and intimate access and showing unexpected tenderness, this is a documentary about legacy, laughter, and the dignity of bowing out… however reluctantly.\",\"certificate\":null,\"casting\":[\"John Cleese\"],\"direction\":[\"Andy Curd\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/b0165064e1f48d0cf3aa0a6e6ac81f1b.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/b0165064e1f48d0cf3aa0a6e6ac81f1b.jpg\"],\"release\":\"2025-11-13T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"CinemaLive\"}},{\"id\":\"325926\",\"title\":\"Jurassic World: Rebirth\",\"runtime\":7980,\"genres\":\"Action, Adventure\",\"__typename\":\"Movie\",\"altId\":[\"358861\",\"392911\"],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"poster\":\"https://cms-assets.webediamovies.pro/production/279/5047dbbe1c457169e9781cf57ca25c1b.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/46/16/46163020528ac61f35758dc57d7c3488.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/03/7a/037a2a885b5f2ba9dc411d953d382df6.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/56/21/56210d8c2e0e8fd119e5ae7cc3792b54.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/4f/67/4f67f5aaa38c950abac9677eda4cb155.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/9e/c9/9ec9750063896cdde50d6743e832e96a.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/94/92/94925149463e189e94bcd34b822f49ff.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/84/3a/843a8f802aff74fdcb87de5567e406db.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/66/28/66289dfa2479e0ab725bd0cfc42e51ab.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/27/18/271863eaf5ab5490132e2b41e201d4f6.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Gareth\",\"lastName\":\"Edwards\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Scarlett\",\"lastName\":\"Johansson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jonathan\",\"lastName\":\"Bailey\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mahershala\",\"lastName\":\"Ali\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rupert\",\"lastName\":\"Friend\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Manuel\",\"lastName\":\"Garcia-Rulfo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Luna\",\"lastName\":\"Blaise\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"David\",\"lastName\":\"Iacono\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Audrina\",\"lastName\":\"Miranda\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bechir\",\"lastName\":\"Sylvain\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ed\",\"lastName\":\"Skrein\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-07-02T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"moderate threat, violence, language\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Jurassic World: Rebirth\",\"synopsis\":\"Five years after the events of Jurassic World Dominion, the planet’s ecology has proven largely inhospitable to dinosaurs. Those remaining exist in isolated equatorial environments with climates resembling the one in which they once thrived. The three most colossal creatures within that tropical biosphere hold the key to a drug that will bring miraculous life-saving benefits to humankind.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/358861_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\