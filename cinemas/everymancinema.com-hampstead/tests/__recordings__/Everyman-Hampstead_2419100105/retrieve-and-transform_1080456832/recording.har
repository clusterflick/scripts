ull,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dan\",\"lastName\":\"Martin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John Lee\",\"lastName\":\"Ames\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-05T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong sex, language\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"On Swift Horses\",\"synopsis\":\"Muriel and her husband Lee are beginning a bright new life in California when he returns from the Korean War. But their newfound stability is upended by the arrival of Lee’s charismatic brother, Julius, a wayward gambler with a secret past. A dangerous love triangle quickly forms. When Julius takes off in search of the young card cheat he’s fallen for, Muriel’s longing for something more propels her into a secret life of her own, gambling on racehorses and exploring a love she never dreamed possible.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/386055_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/386055_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/ac/fb/acfb32e5275a32a2daf1a78eeed62ecc.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/f4c5891aa8d1fa2a6ff003dba4de93d6.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/a8c47d9ad04a55b635aaed821a89c551.jpg\",\"synopsis\":\"Muriel and her husband Lee are beginning a bright new life in California when he returns from the Korean War. But their newfound stability is upended by the arrival of Lee’s charismatic brother, Julius, a wayward gambler with a secret past.\\n\\nA dangerous love triangle quickly forms. When Julius takes off in search of the young card cheat he’s fallen for, Muriel’s longing for something more propels her into a secret life of her own, gambling on racehorses and exploring a love she never dreamed possible.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/e4625eebf8e8f2e0152a08f280f3efe2.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"On Swift Horses\",\"synopsis\":\"Muriel and her husband Lee are beginning a bright new life in California when he returns from the Korean War. But their newfound stability is upended by the arrival of Lee’s charismatic brother, Julius, a wayward gambler with a secret past.\\n\\nA dangerous love triangle quickly forms. When Julius takes off in search of the young card cheat he’s fallen for, Muriel’s longing for something more propels her into a secret life of her own, gambling on racehorses and exploring a love she never dreamed possible.\",\"certificate\":\"15\",\"casting\":[\"Daisy Edgar-Jones\",\"Jacob Elordi\",\"Will Poulter\",\"Sasha Calle\",\"Diego Calva\",\"Don Swayze\",\"Andrew Keenan-Bolger\",\"Jason Kravits\",\"Dan Martin\",\"John Lee Ames\"],\"direction\":[\"Daniel Minahan\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/e4625eebf8e8f2e0152a08f280f3efe2.jpg\",\"img/95/fb/95fbbafc7ab4216c83517b2f82b3e3ce.png\",\"img/e9/41/e941daf6bcbce89cfe8cf2b5cf9bec41.jpg\",\"img/1f/1f/1f1f85576d599c502585303090c9a1e5.jpg\",\"img/dd/6b/dd6b6cac501c5f7513cded48fa3818f7.jpg\",\"img/27/a1/27a13e81d9804672d8c3218d7b2f188a.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.