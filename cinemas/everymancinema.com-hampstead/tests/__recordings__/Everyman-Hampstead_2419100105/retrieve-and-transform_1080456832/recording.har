g\",\"certificate\":\"12A\"},\"localRatings\":[],\"distributors\":[{\"id\":\"40174\",\"name\":\"Netflix\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"The Thursday Murder Club\",\"synopsis\":\"Based on Richard Osman's international bestselling novel of the same name, THE THURSDAY MURDER CLUB follows four irrepressible retirees - Elizabeth (Helen Mirren), Ron (Pierce Brosnan), Ibrahim (Ben Kingsley) and Joyce (Celia Imrie) - who spend their time solving cold case murders for fun. When an unexplained death occurs on their own doorstep, their casual sleuthing takes a thrilling turn as they find themselves with a real whodunit on their hands. Directed by Chris Columbus, the film is the latest to be produced through the Netflix and Amblin Entertainment partnership.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/6e/95/6e95600d3d160d917400df5ea206c39e.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://all.web.img.acsta.net/img/bd/d8/bdd8b41a79d6c32e983a31c18e44a015.jpg\",\"synopsis\":\"Based on Richard Osman's international bestselling novel of the same name, THE THURSDAY MURDER CLUB follows four irrepressible retirees - Elizabeth (Helen Mirren), Ron (Pierce Brosnan), Ibrahim (Ben Kingsley) and Joyce (Celia Imrie) - who spend their time solving cold case murders for fun. \\n\\nWhen an unexplained death occurs on their own doorstep, their casual sleuthing takes a thrilling turn as they find themselves with a real whodunit on their hands. \\n\\nDirected by Chris Columbus, the film is the latest to be produced through the Netflix and Amblin Entertainment partnership.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/3240c30c06104b6ea126918ef8f0c8f2.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Thursday Murder Club\",\"synopsis\":\"Based on Richard Osman's international bestselling novel of the same name, THE THURSDAY MURDER CLUB follows four irrepressible retirees - Elizabeth (Helen Mirren), Ron (Pierce Brosnan), Ibrahim (Ben Kingsley) and Joyce (Celia Imrie) - who spend their time solving cold case murders for fun. \\n\\nWhen an unexplained death occurs on their own doorstep, their casual sleuthing takes a thrilling turn as they find themselves with a real whodunit on their hands. \\n\\nDirected by Chris Columbus, the film is the latest to be produced through the Netflix and Amblin Entertainment partnership.\",\"certificate\":\"12A\",\"casting\":[\"Pierce Brosnan\",\"Helen Mirren\",\"Ben Kingsley\",\"Celia Imrie\",\"Richard E. Grant\",\"Tom Ellis\",\"Naomi Ackie\",\"Geoff Bell\",\"Paul Freeman\",\"Sarah Niles\"],\"direction\":[\"Chris Columbus\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/3240c30c06104b6ea126918ef8f0c8f2.jpg\",\"img/df/3f/df3ff5acf71d2cd06b2ddc040c7fc6b5.jpg\",\"img/d2/07/d207d8743fc25a84d92fcf81b5315a0c.jpg\",\"img/bd/d8/bdd8b41a79d6c32e983a31c18e44a015.jpg\",\"img/43/05/4305d73061f53fe5b905456e734b22cf.jpg\",\"img/95/60/95604e7405a7842e67bda80f40cda748.jpg\",\"img/28/14/281431ee9f4ba06754a2298b9fc0a90b.jpg\",\"img/3d/17/3d1761626f9bfb4c1220df9f2e18124f.jpg\",\"img/b6/32/b63243400db4ce336b156b5a71281dfd.jpg\",\"img/de/42/de42cb8813c1e57fa537ba949b445153.jpg\",\"img/57/09/57090df6961710f3e50f809260a5030f.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/3240c30c06104b6ea126918ef8f0c8f2.jpg\"],\"release\":\"2025-08-22T00:00:00.000Z\",\"advisory\":\"infrequent strong language, moderate violence, injury detail\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Netflix\"}},{\"id\":\"6787\",\"title\":\"Thelma & Louise\",\"runtime\":7740,\"genres\":\"Comedydrama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/093ffe9326aacd692224d59bed88040c.jpg\",\"__typename\":\"Movie\",\"altId\":[\"11179\",\"234740\"],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/57/19976070.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881198.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881197.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881196.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881195.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881194.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881190.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881189.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881188.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881187.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Ridley\",\"lastName\":\"Scott\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Geena\",\"lastName\":\"Davis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Susan\",\"lastName\":\"Sarandon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Harvey\",\"lastName\":\"Keitel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Madsen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christopher\",\"lastName\":\"McDonald\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Stephen\",\"lastName\":\"Tobolowsky\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brad\",\"lastName\":\"Pitt\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Timothy\",\"lastName\":\"Carhart\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lucinda\",\"lastName\":\"Jenney\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jason\",\"lastName\":\"Beghe\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":null,\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong violence, sex, language, sexual assault\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]},{\"releasedAt\":\"2025-11-27T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong violence, sex, language, sexual assault\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Thelma & Louise\",\"synopsis\":\"Two best friends set out on an adventure, but it soon turns around to a terrifying escape from being hunted by the police, as these two girls escape for the crimes they committed.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/3f/5b/3f5b625d800571b638c446fb6f350175.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/093ffe9326aacd692224d59bed88040c.jpg\",\"synopsis\":\"Selected by the Writers Branch, Everyman presents: Thelma & Louise\\n\\nMeek housewife Thelma (Geena Davis) joins her friend Louise (Susan Sarandon), an independent waitress, on a short fishing trip. However, their trip becomes a flight from the law when Louise shoots and kills a man who tries to rape Thelma at a bar. Louise decides to flee to Mexico, and Thelma joins her. On the way, Thelma falls for sexy young thief J.D. (Brad Pitt) and the sympathetic Detective Slocumb (Harvey Keitel) tries to convince the two women to surrender before their fates are sealed.\\n\\nCallie Khouri’s original screenplay, which won the 1991 Academy Award, reinvented both the buddy film and the road movie as it told the story of its eponymous heroines, Geena Davis and Susan Sarandon, respectively, who find themselves on the run across the American desert. Davis and Sarandon were both nominated for Best Actress, the most recent instance in Academy Awards history that two actors from the same film have been nominated in the category. Ridley Scott was nominated for his typically stylish direction, and the ace supporting cast included Harvey Keitel as an unexpectedly sympathetic policeman and Brad Pitt as an especially exciting detour.\\n\\nPresented in 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 27 November.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/267512e125ecd306c2264d98ecb6098a.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Thelma & Louise\",\"synopsis\":\"Selected by the Writers Branch, Everyman presents: Thelma & Louise\\n\\nMeek housewife Thelma (Geena Davis) joins her friend Louise (Susan Sarandon), an independent waitress, on a short fishing trip. However, their trip becomes a flight from the law when Louise shoots and kills a man who tries to rape Thelma at a bar. Louise decides to flee to Mexico, and Thelma joins her. On the way, Thelma falls for sexy young thief J.D. (Brad Pitt) and the sympathetic Detective Slocumb (Harvey Keitel) tries to convince the two women to surrender before their fates are sealed.\\n\\nCallie Khouri’s original screenplay, which won the 1991 Academy Award, reinvented both the buddy film and the road movie as it told the story of its eponymous heroines, Geena Davis and Susan Sarandon, respectively, who find themselves on the run across the American desert. Davis and Sarandon were both nominated for Best Actress, the most recent instance in Academy Awards history that two actors from the same film have been nominated in the category. Ridley Scott was nominated for his typically stylish direction, and the ace supporting cast included Harvey Keitel as an unexpectedly sympathetic policeman and Brad Pitt as an especially exciting detour.\\n\\nPresented in 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 27 November.\",\"certificate\":\"15\",\"casting\":[\"Geena Davis\",\"Susan Sarandon\",\"Harvey Keitel\",\"Michael Madsen\",\"Christopher McDonald\",\"Stephen Tobolowsky\",\"Brad Pitt\",\"Timothy Carhart\",\"Lucinda Jenney\",\"Jason Beghe\"],\"direction\":[\"Ridley Scott\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/267512e125ecd306c2264d98ecb6098a.jpg\",\"medias/nmedia/18/87/88/57/19976070.jpg\",\"medias/nmedia/18/65/66/86/18881198.jpg\",\"medias/nmedia/18/65/66/86/18881197.jpg\",\"medias/nmedia/18/65/66/86/18881196.jpg\",\"medias/nmedia/18/65/66/86/18881195.jpg\",\"medias/nmedia/18/65/66/86/18881194.jpg\",\"medias/nmedia/18/65/66/86/18881190.jpg\",\"medias/nmedia/18/65/66/86/18881189.jpg\",\"medias/nmedia/18/65/66/86/18881188.jpg\",\"medias/nmedia/18/65/66/86/18881187.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/267512e125ecd306c2264d98ecb6098a.jpg\"],\"release\":\"2025-11-27T00:00:00.000Z\",\"advisory\":\"strong violence, sex, language, sexual assault\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"1000031417\",\"title\":\"Throwback: Back to the Future (40th Anniversary)\",\"runtime\":6960,\"genres\":\"Science fiction, Adventure\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/7554e7985250868c190b90a743372e6c.jpg\",\"__typename\":\"Movie\",\"altId\":[\"401216\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Robert\",\"lastName\":\"Zemeckis\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael J.\",\"lastName\":\"Fox\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christopher\",\"lastName\":\"Lloyd\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lea\",\"lastName\":\"Thompson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-31T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Throwback: Back to the Future (40th Anniversary)\",\"synopsis\":\"Head Back To The Future, again. Robert Zemeckis’ classic returns to theaters October 31. Get your tickets!\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/d1/c2/d1c2b253a17d5172bfaff5fd5629f337.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/7554e7985250868c190b90a743372e6c.jpg\",\"synopsis\":\"Head Back To The Future, again. Robert Zemeckis’ classic returns to Everyman for its 40th Anniversary!\\n\\nIn the 1980s, an experiment by a weird scientist turns out to be faulty. It leads to his teenaged pal going back in time to the 1950s, where he is forced to reunite the younger version of his parents.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Throwback: Back to the Future (40th Anniversary)\",\"synopsis\":\"Head Back To The Future, again. Robert Zemeckis’ classic returns to Everyman for its 40th Anniversary!\\n\\nIn the 1980s, an experiment by a weird scientist turns out to be faulty. It leads to his teenaged pal going back in time to the 1950s, where he is forced to reunite the younger version of his parents.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"certificate\":null,\"casting\":[\"Michael J. Fox\",\"Christopher Lloyd\",\"Lea Thompson\"],\"direction\":[\"Robert Zemeckis\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-10-31T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"327719\",\"title\":\"Throwback: Goldeneye\",\"runtime\":7680,\"genres\":\"Action\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/b9ff0cc53cbd85fd739f651c6cf586dd.jpg\",\"__typename\":\"Movie\",\"altId\":[\"358008\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Martin\",\"lastName\":\"Campbell\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Pierce\",\"lastName\":\"Brosnan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sean\",\"lastName\":\"Bean\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Izabella\",\"lastName\":\"Scorupco\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Famke\",\"lastName\":\"Janssen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joe Don\",\"lastName\":\"Baker\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2024-04-07T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"Contains strong violence\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Throwback: Goldeneye\",\"synopsis\":\"007 (Pierce Brosnan) takes on a Russian crime ring attempting to seize control of a space-based weapons program.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/b9ff0cc53cbd85fd739f651c6cf586dd.jpg\",\"synopsis\":\"When a powerful satellite system falls into the hands of Alec Trevelyan, AKA Agent 006 (Sean Bean), a former ally-turned-enemy, only James Bond (Pierce Brosnan) can save the world from an awesome space weapon that -- in one short pulse -- could destroy the earth! As Bond squares off against his former compatriot, he also battles Trevelyan's stunning ally, Xenia Onatopp (Famke Janssen), an assassin who uses pleasure as her ultimate weapon.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/a437d645f99088c2a88cd7af3c037be5.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Throwback: Goldeneye\",\"synopsis\":\"When a powerful satellite system falls into the hands of Alec Trevelyan, AKA Agent 006 (Sean Bean), a former ally-turned-enemy, only James Bond (Pierce Brosnan) can save the world from an awesome space weapon that -- in one short pulse -- could destroy the earth! As Bond squares off against his former compatriot, he also battles Trevelyan's stunning ally, Xenia Onatopp (Famke Janssen), an assassin who uses pleasure as her ultimate weapon.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"certificate\":\"15\",\"casting\":[\"Pierce Brosnan\",\"Sean Bean\",\"Izabella Scorupco\",\"Famke Janssen\",\"Joe Don Baker\"],\"direction\":[\"Martin Campbell\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.we