oiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2024-10-18T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"mild scary scenes, violence, sex references\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[],\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Throwback: Hocus Pocus\",\"synopsis\":\"During a Halloween in Salem, Mass., three witches are accidentally reincarnated as a young boy who tries to impress the girl of his dreams.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/3dc6d270649432206acf34b4c70fc7fd.jpg\",\"synopsis\":\"After moving to Salem, Mass., teenager Max Dennison explores an abandoned house with his sister Dani and their new friend, Allison. After dismissing a story Allison tells as superstitious, Max accidentally frees a coven of evil witches (who used to live in the house. Now, with the help of a magical cat, the kids must steal the witches' book of spells to stop them from becoming immortal.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/6dba9985c26258739ddda5f3b1b2dba9.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Throwback: Hocus Pocus\",\"synopsis\":\"After moving to Salem, Mass., teenager Max Dennison explores an abandoned house with his sister Dani and their new friend, Allison. After dismissing a story Allison tells as superstitious, Max accidentally frees a coven of evil witches (who used to live in the house. Now, with the help of a magical cat, the kids must steal the witches' book of spells to stop them from becoming immortal.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"certificate\":\"PG\",\"casting\":[\"Bette Midler\",\"Sarah Jessica Parker\",\"Kathy Najimy\",\"Omri Katz\",\"Thora Birch\",\"Vinessa Shaw\"],\"direction\":[\"Kenny Ortega\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/6dba9985c26258739ddda5f3b1b2dba9.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/6dba9985c26258739ddda5f3b1b2dba9.jpg\"],\"release\":\"2024-10-18T00:00:00.000Z\",\"advisory\":\"mild scary scenes, violence, sex references\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"1000029355\",\"title\":\"Throwback: La La Land\",\"runtime\":7680,\"genres\":\"Musical, Romance\",\"__typename\":\"Movie\",\"altId\":[\"398610\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/d0e7a6f687dd318af9fc1ec6405bff73.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Damien\",\"lastName\":\"Chazelle\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ryan\",\"lastName\":\"Gosling\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emma\",\"lastName\":\"Stone\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rosemarie\",\"lastName\":\"DeWitt\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"J.K.\",\"lastName\":\"Simmons\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Amiée\",\"lastName\":\"Conn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-26T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"infrequent strong language\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13832\",\"name\":\"Lionsgate UK\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Throwback: La La Land\",\"synopsis\":\"The story of Mia, an aspiring actress, and Sebastian, a dedicated jazz musician, struggling to make ends meet while pursuing their dreams in a city known for destroying hopes and breaking hearts. With modern day Los Angeles as the backdrop, this musical about everyday life explores what is more important: a once-in-a-lifetime love or the spotlight.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/af/ca/afcab03e8ef621c782886f03fe590f5b.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/d0e7a6f687dd318af9fc1ec6405bff73.jpg\",\"synopsis\":\"The story of Mia, an aspiring actress, and Sebastian, a dedicated jazz musician, struggling to make ends meet while pursuing their dreams in a city known for destroying hopes and breaking hearts. With modern-day Los Angeles as the backdrop, this musical about everyday life explores what is more important: a once-in-a-lifetime love or the spotlight.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/8369af64c7f0d6932d4b022d55d673f9.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Throwback: La La Land\",\"synopsis\":\"The story of Mia, an aspiring actress, and Sebastian, a dedicated jazz musician, struggling to make ends meet while pursuing their dreams in a city known for destroying hopes and breaking hearts. With modern-day Los Angeles as the backdrop, this musical about everyday life explores what is more important: a once-in-a-lifetime love or the spotlight.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"certificate\":\"12A\",\"casting\":[\"Ryan Gosling\",\"Emma Stone\",\"Rosemarie DeWitt\",\"J.K. Simmons\",\"Amiée Conn\"],\"direction\":[\"Damien Chazelle\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/8369af64c7f0d6932d4b022d55d673f9.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/8369af64c7f0d6932d4b022d55d673f9.jpg\"],\"release\":\"2025-09-26T00:00:00.000Z\",\"advisory\":\"infrequent strong language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Lionsgate UK\"}},{\"id\":\"1000031395\",\"title\":\"Throwback: Psycho\",\"runtime\":6000,\"genres\":\"Horror, Thriller\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/5de2d1cc613441ab97e0dbf8ac539891.jpg\",\"__typename\":\"Movie\",\"altId\":[\"401191\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Alfred\",\"lastName\":\"Hitchcock\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anthony\",\"lastName\":\"Perkins\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Janet\",\"lastName\":\"Leigh\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Gavin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-10T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"locale\":{\"title\":\"Throwback: Psycho\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/3d/cd/3dcd362b8bba3bedd879ebdc026d00de.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/5de2d1cc613441ab97e0dbf8ac539891.jpg\",\"synopsis\":\"Phoenix secretary Marion Crane (Janet Leigh), on the lam after stealing $40,000 from her employer in order to run away with her boyfriend, Sam Loomis (John Gavin), is overcome by exhaustion during a heavy rainstorm. Traveling on the back roads to avoid the police, she stops for the night at the ramshackle Bates Motel and meets the polite but highly strung proprietor Norman Bates (Anthony Perkins), a young man with an interest in taxidermy and a difficult relationship with his mother.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Throwback: Psycho\",\"synopsis\":\"Phoenix secretary Marion Crane (Janet Leigh), on the lam after stealing $40,000 from her employer in order to run away with her boyfriend, Sam Loomis (John Gavin), is overcome by exhaustion during a heavy rainstorm. Traveling on the back roads to avoid the police, she stops for the night at the ramshackle Bates Motel and meets the polite but highly strung proprietor Norman Bates (Anthony Perkins), a young man with an interest in taxidermy and a difficult relationship with his mother.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"certificate\":null,\"casting\":[\"Anthony Perkins\",\"Janet Leigh\",\"John Gavin\"],\"direction\":[\"Alfred Hitchcock\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-10-10T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"11091\",\"title\":\"Throwback: Scream\",\"runtime\":6600,\"genres\":\"Horror\",\"__typename\":\"Movie\",\"altId\":[\"7281\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4654cd8af43a4f1d98cb1b323fec9f8f.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/27/88/19906214.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/27/88/19906212.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/27/88/19906210.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/27/88/19906209.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/27/88/19906208.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/27/88/19906207.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictur