.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Simon\",\"lastName\":\"Curtis\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michelle\",\"lastName\":\"Dockery\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hugh\",\"lastName\":\"Bonneville\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Laura\",\"lastName\":\"Carmichael\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jim\",\"lastName\":\"Carter\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brendan\",\"lastName\":\"Coyle\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joanne\",\"lastName\":\"Froggatt\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lesley\",\"lastName\":\"Nicol\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rob\",\"lastName\":\"James-Collier\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Allen\",\"lastName\":\"Leech\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Phyllis\",\"lastName\":\"Logan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-09-12T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"mild bad language, sex references\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[],\"distributors\":[{\"id\":\"26962\",\"name\":\"Universal Pictures International\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Downton Abbey: The Grand Finale\",\"synopsis\":\"DOWNTON ABBEY: THE GRAND FINALE, the cinematic return of the global phenomenon, follows the Crawley family and their staff as they enter the 1930s. As the beloved cast of characters navigates how to lead Downton Abbey into the future, they must embrace change and welcome a new chapter.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/363320_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/363320_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/4a/e0/4ae09dd45af820cdb33e458c85b58ea1.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/9f5a59216163dcd50932aaedff1f9acb.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/3f1e3d4f00f69b82e087b37934138c00.jpg\",\"synopsis\":\"Follows the Crawley family and their staff as they enter the 1930s. As the beloved cast of characters navigates how to lead Downton Abbey into the future, they must embrace change and welcome a new chapter.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/1e0806823b7e07e7c6312e9a19c14dfd.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Downton Abbey: The Grand Finale\",\"synopsis\":\"Follows the Crawley family and their staff as they enter the 1930s. As the beloved cast of characters navigates how to lead Downton Abbey into the future, they must embrace change and welcome a new chapter.\",\"certificate\":\"PG\",\"casting\":[\"Michelle Dockery\",\"Hugh Bonneville\",\"Laura Carmichael\",\"Jim Carter\",\"Brendan Coyle\",\"Joanne Froggatt\",\"Lesley Nicol\",\"Rob James-Collier\",\"Allen Leech\",\"Phyllis Logan\"],\"direction\":[\"Simon Curtis\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/1e0806823b7e07e7c6312e9a19c14dfd.jpg\",\"img/9c/0b/9c0b82253c8faedb21fd431796dfd17c.jpg\",\"img/94/42/9442e9a5d9ea04f81e98498806039b6f.jpg\",\"img/b3/9b/b39b0c423afafd24b5354248178aa3de.jpg\",\"img/33/e8/33e835c34a551d70e5002daaa2b18348.jpg\",\"img/32/32/3232abd4cc84330bae27479c5b4e978b.jpg\",\"img/67/f7/67f783bdaec7778de62ee06655a7b823.jpg\",\"img/ec/50/ec50e7bac75c250dca8e59488ef384ec.jpg\",\"img/55/bf/55bfcb09a9839548bf8c0dd346aa2175.jpg\",\"img/8a/86/8a8674d941ca063dde63af31e1b2c12f.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/1e0806823b7e07e7c6312e9a19c14dfd.jpg\",\"https://cms-assets.webediamovies.pro/production/2/9f5a59216163dcd50932aaedff1f9acb.jpg\"],\"release\":\"2025-09-12T00:00:00.000Z\",\"advisory\":\"mild bad language, sex references\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/363320_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/363320_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Universal Pictures International\"}},{\"id\":\"323852\",\"title\":\"Ella McCay\",\"runtime\":null,\"genres\":\"Comedydrama, Drama\",\"__typename\":\"Movie\",\"altId\":[\"372956\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8c82a6db9012cc31365e0e76ede6eac8.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/9a/68/9a688ffecaf774a0cf9d6aa852cec37a.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/9d/1f/9d1f8cb17e8e062054a4794989ca00dc.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/a7/d8/a7d8ef4435ecf737acab1cea43592b9d.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/8c/81/8c815168721987f17783370f0e0d4719.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/06/00/0600d67feb12487be3b93b5024a17364.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/fc/dc/fcdc3598cc5ce560402170f4ce025def.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/87/44/87445566ef1e7cf06598e19f1aa091d9.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"James L.\",\"lastName\":\"Brooks\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emma\",\"lastName\":\"Mackey\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jamie Lee\",\"lastName\":\"Curtis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jack\",\"lastName\":\"Lowden\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kumail\",\"lastName\":\"Nanjiani\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ayo\",\"lastName\":\"Edebiri\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Spike\",\"lastName\":\"Fearn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rebecca\",\"lastName\":\"Hall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Julie\",\"lastName\":\"Kavner\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Becky Ann\",\"lastName\":\"Baker\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joey\",\"lastName\":\"Brooks\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-12T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Ella McCay\",\"synopsis\":null,\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/8c82a6db9012cc31365e0e76ede6eac8.jpg\",\"synopsis\":\"An idealistic young woman juggles her family and work life in a comedy about the people you love and how to survive them. “Ella McCay” features an all-star cast including Emma Mackey, Jamie Lee Curtis, Jack Lowden, Kumail Nanjiani, Ayo Edebiri, Spike Fearn, Rebecca Hall, Julie Kavner, Becky Ann Baker, Joey Brooks with Albert Brooks and Woody Harrelson. \",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/f46fcf9115a0e453e323142ab06fa054.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Ella McCay\",\"synopsis\":\"An idealistic young woman juggles her family and work life in a comedy about the people you love and how to survive them. “Ella McCay” features an all-star cast including Emma Mackey, Jamie Lee Curtis, Jack Lowden, Kumail Nanjiani, Ayo Edebiri, Spike Fearn, Rebecca Hall, Julie Kavner, Becky Ann Baker, Joey Brooks with Albert Brooks and Woody Harrelson. \",\"certificate\":null,\"casting\":[\"Emma Mackey\",\"Jamie Lee Curtis\",\"Jack Lowden\",\"Kumail Nanjiani\",\"Ayo Edebiri\",\"Spike Fearn\",\"Rebecca Hall\",\"Julie Kavner\",\"Becky Ann Baker\",\"Joey Brooks\"],\"direction\":[\"James L. Brooks\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/f46fcf9115a0e453e323142ab06fa054.jpg\",\"img/9a/68/9a688ffecaf774a0cf9d6aa852cec37a.jpg\",\"img/9d/1f/9d1f8cb17e8e062054a4794989ca00dc.jpg\",\"img/a7/d8/a7d8ef4435ecf737acab1cea43592b9d.jpg\",\"img/8c/81/8c815168721987f17783370f0e0d4719.jpg\",\"img/06/00/0600d67feb12487be3b93b5024a17364.jpg\",\"img/fc/dc/fcdc3598cc5ce560402170f4ce025def.jpg\",\"img/87/44/87445566ef1e7cf06598e19f1aa091d9.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/f46fcf9115a0e453e323142ab06fa054.jpg\"],\"release\":\"2025-12-12T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Walt Disney\"}},{\"id\":\"1000026518\",\"title\":\"Exhibition on Screen: Caravaggio\",\"runtime\":5400,\"genres\":\"Documentary\",\"__typename\":\"Movie\",\"altId\":[\"395026\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a63966fdba4816b0afe9d794ae0cdd6b.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Phil\",\"lastName\":\"Grabsky\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"David\",\"lastName\":\"Bickerstaff\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2025-11-07T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Exhibition on Screen: Caravaggio\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/3b/d1/3bd1e285b0309c36c3cf5d7eae4e6e36.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/a63966fdba4816b0afe9d794ae0cdd6b.jpg\",\"synopsis\":\"Mystery, intrigue, beauty, passion, murder – shine a new light on Caravaggio in this dramatic biography…\\n\\nFive years in production, this is the most extensive film ever made about one of the greatest artists of all time – Caravaggio. Featuring masterpiece after masterpiece and with first-hand testimony from the artist himself on the eve of his mysterious disappearance, this beautiful new film reveals Caravaggio as never before.\\n\\nMulti-award-winning filmmakers David Bickerstaff and Phil Grabsky delve into the hidden narratives of Caravaggio’s life, piecing together clues embedded within his incredible art. The intriguing self-depictions within his works — sometimes disguised, sometimes in plain sight — offer a rare window into his psyche and personal struggles. Join us as we unravel the story of one of history’s most brilliant, complex and controversial figures.\\n\\nCaravaggio’s masterpieces are some of art’s most instantly recognisable. No one else uses his signature blend of dramatic light, intense naturalism and bold, striking figures. His incredible paintings have captivated audiences for centuries. But there lies a deeper mystery — one that still beckons us to explore. What do these masterpieces reveal about the man behind the brush? Join us as we explore the intriguing clues that help us to finally understand the life – and death – of this remarkable man.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/434ca590db349eb5c2b7d94569e37337.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Exhibition on Screen : Caravaggio\",\"synopsis\":\"Mystery, intrigue, beauty, passion, murder – shine a new light on Caravaggio in this dramatic biography…\\n\\nFive years in production, this is the most extensive film ever made about one of the greatest artists of all time – Caravaggio. Featuring masterpiece after masterpiece and with first-hand testimony from the artist himself on the eve of his mysterious disappearance, this beautiful new film reveals Caravaggio as never before.\\n\\nMulti-award-winning filmmakers David Bickerstaff and Phil Grabsky delve into the hidden narratives of Caravaggio’s life, piecing together clues embedded within his incredible art. The intriguing self-depictions within his works — sometimes disguised, sometimes in plain sight — offer a rare window into his psyche and personal struggles. Join us as we unravel the story of one of history’s most brilliant, complex and controversial figures.\\n\\nCaravaggio’s masterpieces are some of art’s most instantly recognisable. No one else uses his signature blend of dramatic light, intense naturalism and bold, striking figures. His incredible paintings have captivated audiences for centuries. But there lies a deeper mystery — one that still beckons us to explore. What do these masterpieces reveal about the man behind the brush? Join us as we explore the intriguing clues that help us to finally understand the life – and death – of this remarkable man.\",\"certificate\":null,\"casting\":[],\"direction\":[\"Phil Grabsky\",\"David Bickerstaff\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/434ca590db349eb5c2b7d94569e37337.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/434ca590db349eb5c2b7d94569e37337.jpg\"],\"release\":\"2025-11-07T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000031214\",\"title\":\"Exhibition on Screen: Caravaggio + Live Q&A\",\"runtime\":7200,\"genres\":\"Documentary\",\"__typename\":\"Movie\",\"altId\":[\"400985\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"releases\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/e319ea0e9fd91ab68f9b0af25494fe62.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Phil\",\"lastName\":\"Grabsky\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"David\",\"lastName\":\"Bickerstaff\",\"__typename\":\"Person\"}}]},\"embargoes\":[],\"locale\":{\"title\":\"Exhibition on Screen: Caravaggio + Live Q&A\",\"synopsis\":\"The Q&A for this event screening is with Producer and Director (Phil Grabsky and David Bickerstaff)\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/8e/64/8e6420bd2b1225aafce199a3860a21eb.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/e319ea0e9fd91ab68f9b0af25494fe62.jpg\",\"synopsis\":\"The Q&A for this event screening is with Producer and Director (Phil Grabsky and David Bickerstaff)\\n\\nMystery, intrigue, beauty, passion, murder – shine a new light on Caravaggio in this dramatic biography…\\n\\nFive years in production, this is the most extensive film ever made about one of the greatest artists of all time – Caravaggio. Featuring masterpiece after masterpiece and with first-hand testimony from the artist himself on the eve of his mysterious disappearance, this beautiful new film reveals Caravaggio as never before.\\n\\nMulti-award-winning filmmakers David Bickerstaff and Phil Grabsky delve into the hidden narratives of Caravaggio’s life, piecing together clues embedded within his incredible art. The intriguing self-depictions within his works — sometimes disguised, sometimes in plain sight — offer a rare window into his psyche and personal struggles. Join us as we unravel the story of one of history’s most brilliant, complex and controversial figures.\\n\\nCaravaggio’s masterpieces are some of art’s most instantly recognisable. No one else uses his signature blend of dramatic light, intense naturalism and bold, striking figures. His incredible paintings have captivated audiences for centuries. But there lies a deeper mystery — one that still beckons us to explore. What do these masterpieces reveal about the man behind the brush? Join us as we explore the intriguing clues that help us to finally understand the life – and death – of this remarkable man.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/8857243a4aa741e7df4520b5f3a8305a.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Exhibition on Screen: Caravaggio + Live Q&A\",\"synopsis\":\"The Q&A for this event screening is with Producer and Director (Phil Grabsky and David Bickerstaff)\\n\\nMystery, intrigue, beauty, passion, murder – shine a new light on Caravaggio in this dramatic biography…\\n\\nFive years in production, this is the most extensive film ever made about one of the greatest artists of all time – Caravaggio. Featuring masterpiece after masterpiece and with first-hand testimony from the artist himself on the eve of his mysterious disappearance, this beautiful new film reveals Caravaggio as never before.\\n\\nMulti-award-winning filmmakers David Bickerstaff and Phil Grabsky delve into the hidden narratives of Caravaggio’s life, piecing together clues embedded within his incredible art. The intriguing self-depictions within his works — sometimes disguised, sometimes in plain sight — offer a rare window into his psyche and personal struggles. Join us as we unravel the story of one of history’s most brilliant, complex and controversial figures.\\n\\nCaravaggio’s masterpieces are some of art’s most instantly recognisable. No one else uses his signature blend of dramatic light, intense naturalism and bold, striking figures. His incredible paintings have captivated audiences for centuries. But there lies a deeper mystery — one that still beckons us to explore. What do these masterpieces reveal about the man behind the brush? Join us as we explore the intriguing clues that help us to finally understand the life – and death – of this remarkable man.\",\"casting\":[],\"direction\":[\"Phil Grabsky\",\"David Bickerstaff\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/8857243a4aa741e7df4520b5f3a8305a.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/8857243a4aa741e7df4520b5f3a8305a.jpg\"],\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000027396\",\"title\":\"Exhibition on Screen: Frida Kahlo\",\"runtime\":5400,\"genres\":\"Documentary\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a24e554c967d19b31c2202a6d13d2c0c.jpg\",\"__typename\":\"Movie\",\"altId\":[\"396193\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Ali\",\"lastName\":\"Ray\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2026-05-15T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"locale\":{\"title\":\"Exhibition on Screen: Frida Kahlo 2026 Encore\",\"synopsis\":null,\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"embargoes\":[],\"exhibitor\":{\"title\":\"Exhibition on Screen: Frida Kahlo\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/a24e554c967d19b31c2202a6d13d2c0c.jpg\",\"synopsis\":\"Frida Kahlo is a phenomenon. She is arguably the world’s favourite female artist – beloved by young and old. Exhibition on Screen’s award-winning film – first released during covid to a restricted audience - is back by popular demand with an exciting new addition from the blockbuster transatlantic exhibition from Tate Britain and MFA Houston 'Frida Kahlo: the Making of an Icon'. \\n  \\nWho was Frida Kahlo? Everyone knows her face but who was the woman behind the bright colours, the big brows and the floral crowns? Take a journey through the life of a true icon, discover her art, and uncover the true story of her rebellious, passionate and turbulent life. \\n  \\nMaking use of the latest technology to deliver previously unimaginable quality, we take an in-depth look at key works throughout her career. Using letters Kahlo wrote to guide us, this definitive film reveals her deepest emotions and unlocks the secrets and symbolism contained within her art. \\n  \\nExhibition on Screen’s trademark combination of interviews with those who knew her and world experts, commentary and a detailed exploration of her art, combined with new special bonus footage from the 2026 Tate exhibition, delivers a treasure trove of colour and emotion. This personal and intimate film offers privileged access to her works, her home, her studio and highlights the source of her feverish creativity, her resilience and her unmatched lust for life, beauty and revolution. \\n  \\nCreated in close collaboration with world experts and those who knew her. \\n  \\nAdditional new material from the curators of the groundbreaking new Tate Britain and MFA Houston exhibition. \",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/4bc3e6945560152e4f7003796aae6faa.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Exhibition on Screen: Frida Kahlo 2026 Encore\",\"synopsis\":\"Frida Kahlo is a phenomenon. She is arguably the world’s favourite female artist – beloved by young and old. Exhibition on Screen’s award-winning film – first released during covid to a restricted audience - is back by popular demand with an exciting new addition from the blockbuster transatlantic exhibition from Tate Britain and MFA Houston 'Frida Kahlo: the Making of an Icon'. \\n  \\nWho was Frida Kahlo? Everyone knows her face but who was the woman behind the bright colours, the big brows and the floral crowns? Take a journey through the life of a true icon, discover her art, and uncover the true story of her rebellious, passionate and turbulent life. \\n  \\nMaking use of the latest technology to deliver previously unimaginable quality, we take an in-depth look at key works throughout her career. Using letters Kahlo wrote to guide us, this definitive film reveals her deepest emotions and unlocks the secrets and symbolism contained within her art. \\n  \\nExhibition on Screen’s trademark combination of interviews with those who knew her and world experts, commentary and a detailed exploration of her art, combined with new special bonus footage from the 2026 Tate exhibition, delivers a treasure trove of colour and emotion. This personal and intimate film offers privileged access to her works, her home, her studio and highlights the source of her feverish creativity, her resilience and her unmatched lust for life, beauty and revolution. \\n  \\nCreated in close collaboration with world experts and those who knew her. \\n  \\nAdditional new material from the curators of the groundbreaking new Tate Britain and MFA Houston exhibition. \",\"certificate\":null,\"casting\":[],\"direction\":[\"Ali Ray\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/4bc3e6945560152e4f7003796aae6faa.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/4bc3e6945560152e4f7003796aae6faa.jpg\"],\"release\":\"2026-05-15T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000025863\",\"title\":\"Exhibition on Screen: Turner & Constable\",\"runtime\":5400,\"genres\":\"Documentary\",\"__typename\":\"Movie\",\"altId\":[\"394279\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/251d9bfc64f493c8d72c8c4e05453d1b.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"David\",\"lastName\":\"Bickerstaff\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2026-03-06T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"locale\":{\"title\":\"Exhibition on Screen: Turner & Constable\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/50/39/50393b5c8bbef9512301b14437336f28.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/251d9bfc64f493c8d72c8c4e05453d1b.jpg\",\"synopsis\":\"Celebrating the 250th anniversary of their births, this unmissable new documentary explores Turner and Constable’s intertwined lives and legacies alongside the groundbreaking Tate exhibition.\\nTwo of Britain’s greatest painters, J.M.W. Turner and John Constable were also the greatest of rivals. Born within a year of each other, both used landscape painting to reflect the changing world around them. Tate Britain is bringing these two greats together for a groundbreaking exhibition, in London from November 2025 to April 2026, and Exhibition on Screen once again has exclusive and privileged access to bring their extraordinary art and remarkable stories to the big screen in February so that you can enjoy both film and exhibition together. Discover unexpected sides to both artists with intimate views of sketchbooks and personal items and insights from leading experts.\\nTurner’s blazing sunsets and sublime scenes from his travels and Constable’s idealised depictions of beloved places from home whipped the public of the time into a frenzy of enthusiasm. Constable represents the very best of the old school of realism and pastoral nostalgia; Turner, an exciting new way of depicting emotion and dreamlike impressions. Critics compared their starkly different styles to a clash of ‘fire and water’. Don’t miss this opportunity to see these greats side-by-side, as they so often were in life, on the big screen for the first time.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/ee3751d515f699df5893ddd4516d2880.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Exhibition on Screen : Turner & Constable\",\"synopsis\":\"Celebrating the 250th anniversary of their births, this unmissable new documentary explores Turner and Constable’s intertwined lives and legacies alongside the groundbreaking Tate exhibition.\\nTwo of Britain’s greatest painters, J.M.W. Turner and John Constable were also the greatest of rivals. Born within a year of each other, both used landscape painting to reflect the changing world around them. Tate Britain is bringing these two greats together for a groundbreaking exhibition, in London from November 2025 to April 2026, and Exhibition on Screen once again has exclusive and privileged access to bring their extraordinary art and remarkable stories to the big screen in February so that you can enjoy both film and exhibition together. Discover unexpected sides to both artists with intimate views of sketchbooks and personal items and insights from leading experts.\\nTurner’s blazing sunsets and sublime scenes from his travels and Constable’s idealised depictions of beloved places from home whipped the public of the time into a frenzy of enthusiasm. Constable represents the very best of the old school of realism and pastoral nostalgia; Turner, an exciting new way of depicting emotion and dreamlike impressions. Critics compared their starkly different styles to a clash of ‘fire and water’. Don’t miss this opportunity to see these greats side-by-side, as they so often were in life, on the big screen for the first time.\",\"certificate\":null,\"casting\":[],\"direction\":[\"David Bickerstaff\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/ee3751d515f699df5893ddd4516d2880.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/ee3751d515f699df5893ddd4516d2880.jpg\"],\"release\":\"2026-03-06T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"299153\",\"title\":\"F1® The Movie\",\"runtime\":9300,\"genres\":\"Action\",\"__typename\":\"Movie\",\"altId\":[\"366911\",\"368168\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"img/59/34/5934c6817f1e8fc1407658b6ef63d36d.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/59/34/5934c6817f1e8fc1407658b6ef63d36d.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/8a/74/8a742634f5117d220815b80f91905e30.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Joseph\",\"lastName\":\"Kosinski\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brad\",\"lastName\":\"Pitt\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Damson\",\"lastName\":\"Idris\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Javier\",\"lastName\":\"Bardem\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kerry\",\"lastName\":\"Condon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tobias\",\"lastName\":\"Menzies\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Callie\",\"lastName\":\"Cooke\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joseph\",\"lastName\":\"Balderrama\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kim\",\"lastName\":\"Bodnia\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Shea\",\"lastName\":\"Whigham\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sarah\",\"lastName\":\"Niles\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-06-25T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"infrequent strong language, moderate threat\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"F1 The Movie\",\"synopsis\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career.  Thirty years later, he’s a nomadic racer-for-hire when he’s approached by his former teammate Ruben Cervantes (Javier Bardem), owner of a struggling FORMULA 1 team that is on the verge of collapse.  Ruben convinces Sonny to come back to FORMULA 1 for one last shot at saving the team and being the best in the world.  He’ll drive alongside Joshua Pearce (Damson Idris), the team's hotshot rookie intent on setting his own pace.  But as the engines roar, Sonny’s past catches up with him and he finds that in FORMULA 1, your teammate is your fiercest competition—and the road to redemption is not something you can travel alone.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/366911_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/366911_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/74/c0/74c006d022cdb9df8e60f334cf36ac6d.png\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/c3ee795337a363825aee2efa65b27eaa.jpg\",\"__typename\":\"BOAppImage\"}]}},\"embargoes\":[],\"exhibitor\":{\"title\":\"F1® The Movie\",\"poster\":\"https://all.web.img.acsta.net/img/59/34/5934c6817f1e8fc1407658b6ef63d36d.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"F1 The Movie\",\"synopsis\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career.  Thirty years later, he’s a nomadic racer-for-hire when he’s approached by his former teammate Ruben Cervantes (Javier Bardem), owner of a struggling FORMULA 1 team that is on the verge of collapse.  Ruben convinces Sonny to come back to FORMULA 1 for one last shot at saving the team and being the best in the world.  He’ll drive alongside Joshua Pearce (Damson Idris), the team's hotshot rookie intent on setting his own pace.  But as the engines roar, Sonny’s past catches up with him and he finds that in FORMULA 1, your teammate is your fiercest competition—and the road to redemption is not something you can travel alone.\",\"certificate\":\"12A\",\"casting\":[\"Brad Pitt\",\"Damson Idris\",\"Javier Bardem\",\"Kerry Condon\",\"Tobias Menzies\",\"Callie Cooke\",\"Joseph Balderrama\",\"Kim Bodnia\",\"Shea Whigham\",\"Sarah Niles\"],\"direction\":[\"Joseph Kosinski\"],\"coDirection\":[],\"pictures\":[\"img/59/34/5934c6817f1e8fc1407658b6ef63d36d.jpg\",\"img/8a/74/8a742634f5117d220815b80f91905e30.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/c3ee795337a363825aee2efa65b27eaa.jpg\"],\"release\":\"2025-06-25T00:00:00.000Z\",\"advisory\":\"infrequent strong language, moderate threat\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/366911_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/366911_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"}},{\"id\":\"206794\",\"title\":\"Frankenstein\",\"runtime\":9000,\"genres\":\"Drama, Science fiction, Horror\",\"__typename\":\"Movie\",\"altId\":[\"382659\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a1f69203b963abfbac928d7a44c93447.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/a6/3c/a63c6bc1605700de1024fd33f2581c66.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/43/0e/430e45e58e0f868477a192724d5a110e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e4/72/e472440f3c0bc9032468af40817839f0.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ab/46/ab46d36ff0fe16211126366a80225cf1.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Guillermo\",\"lastName\":\"del Toro\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Oscar\",\"lastName\":\"Isaac\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jacob\",\"lastName\":\"Elordi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mia\",\"lastName\":\"Goth\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christoph\",\"lastName\":\"Waltz\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Felix\",\"lastName\":\"Kammerer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lars\",\"lastName\":\"Mikkelsen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"David\",\"lastName\":\"Bradley (IV)\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christian\",\"lastName\":\"Convery\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sofia\",\"lastName\":\"Galasso\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Charles\",\"lastName\":\"Dance\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-17T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"40174\",\"name\":\"Netflix\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Frankenstein\",\"synopsis\":\"Oscar-winning director Guillermo del Toro adapts Mary Shelley's classic tale of Victor Frankenstein, a brilliant but egotistical scientist who brings a creature to life in a monstrous experiment that ultimately leads to the undoing of both the creator and his tragic creation.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/ea/a8/eaa845cf3e9036e0ac687d60c84ced64.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/2de2d61a78bc4917b0b40d56e998468a.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/a1f69203b963abfbac928d7a44c93447.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/98a6f4ef109802a2a31f281810493527.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Frankenstein\",\"synopsis\":\"Oscar-winning director Guillermo del Toro adapts Mary Shelley's classic tale of Victor Frankenstein, a brilliant but egotistical scientist who brings a creature to life in a monstrous experiment that ultimately leads to the undoing of both the creator and his tragic creation.\",\"certificate\":null,\"casting\":[\"Oscar Isaac\",\"Jacob Elordi\",\"Mia Goth\",\"Christoph Waltz\",\"Felix Kammerer\",\"Lars Mikkelsen\",\"David Bradley (IV)\",\"Christian Convery\",\"Sofia Galasso\",\"Charles Dance\"],\"direction\":[\"Guillermo del Toro\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/98a6f4ef109802a2a31f281810493527.jpg\",\"img/a6/3c/a63c6bc1605700de1024fd33f2581c66.jpg\",\"img/43/0e/430e45e58e0f868477a192724d5a110e.jpg\",\"img/e4/72/e472440f3c0bc9032468af40817839f0.jpg\",\"img/ab/46/ab46d36ff0fe16211126366a80225cf1.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/98a6f4ef109802a2a31f281810493527.jpg\",\"https://cms-assets.webediamovies.pro/production/2/2de2d61a78bc4917b0b40d56e998468a.jpg\"],\"release\":\"2025-10-17T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Netflix\"}},{\"id\":\"316125\",\"title\":\"Freakier Friday\",\"runtime\":6660,\"genres\":\"Comedy\",\"__typename\":\"Movie\",\"altId\":[\"359482\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/e7fb701fa40bc6925ba5b8f7c5aa5669.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/c1/f9/c1f9e26381806e70e83faf652376f6e3.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/fa/5c/fa5ce940b0d0d471af988028ac17beaf.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/b5/1f/b51fae408db8fc639889ffeb5eee9634.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e6/8b/e68bf5b913917fc9ef0265bb12c23525.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/d3/a7/d3a7d930fa72c5062b0f84356456feaf.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/eb/32/eb32138c757883531fde823182e11daf.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e6/a8/e6a8ac77d2e2c56a3d9c23526d125450.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/89/9e/899ec84c6341afa85270ce8975335ae8.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/42/14/4214013a682502662c00bd52522c4e8c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/79/13/7913d49633d267ac8b68f758cb959a56.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Nisha\",\"lastName\":\"Ganatra\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jamie Lee\",\"lastName\":\"Curtis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lindsay\",\"lastName\":\"Lohan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Julia\",\"lastName\":\"Butters\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Manny\",\"lastName\":\"Jacinto\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sophia\",\"lastName\":\"Hammons\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Chad Michael\",\"lastName\":\"Murray\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Stephen\",\"lastName\":\"Tobolowsky\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mark\",\"lastName\":\"Harmon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christina\",\"lastName\":\"Vidal\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Haley\",\"lastName\":\"Hudson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-08-08T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"mild bad language\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[],\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Freakier Friday\",\"synopsis\":\"“Freakier Friday,” a sequel to the beloved 2003 film with a multigenerational twist starring Jamie Lee Curtis and Lindsay Lohan, will be released in theaters nationwide August 8, 2025. In the film, Curtis and Lohan reprise their roles as Tess and Anna Coleman. The story picks up years after Tess (Curtis) and Anna (Lohan) endured an identity crisis. Anna now has a daughter of her own and a soon-to-be stepdaughter. As they navigate the myriad challenges that come when two families merge, Tess and Anna discover that lightning might indeed strike twice. “Freakier Friday” is directed by Nisha Ganatra and based on the book “Freaky Friday” by Mary Rodgers. The film, which also stars Julia Bu@ers, Sophia Hammons, Manny Jacinto, Maitreyi Ramakrishnan, Rosalind Chao, Chad Michael Murray, and Mark Harmon, is produced by Kristin Burr, Andrew Gunn, and Jamie Lee Curtis, with Nathan Kelly, Ann Marie Sanderlin, and Lindsay Lohan serving as executive producers.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/359482_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/359482_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/a9/aa/a9aa40a71b7d82aff798e925e7ce4aac.jpeg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/d4d517df95498b27da300ac9b7503e41.jpg\",\"__typename\":\"BOAppImage\"}]}},\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/e7fb701fa40bc6925ba5b8f7c5aa5669.jpg\",\"synopsis\":\"22 years after Tess (Jamie Lee Curtis) and Anna (Lindsay Lohan) endured an identity crisis, Anna now has a daughter and a soon-to-be stepdaughter. As they navigate the challenges that come when two families merge, Tess and Anna discover that lightning might strike twice.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/e70f99e9857e946d278a8b25cf1d8e6c.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Freakier Friday\",\"synopsis\":\"22 years after Tess (Jamie Lee Curtis) and Anna (Lindsay Lohan) endured an identity crisis, Anna now has a daughter and a soon-to-be stepdaughter. As they navigate the challenges that come when two families merge, Tess and Anna discover that lightning might strike twice.\",\"certificate\":\"PG\",\"casting\":[\"Jamie Lee Curtis\",\"Lindsay Lohan\",\"Julia Butters\",\"Manny Jacinto\",\"Sophia Hammons\",\"Chad Michael Murray\",\"Stephen Tobolowsky\",\"Mark Harmon\",\"Christina Vidal\",\"Haley Hudson\"],\"direction\":[\"Nisha Ganatra\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro