dVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cliff\",\"lastName\":\"Curtis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joel\",\"lastName\":\"David Moore\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Oona\",\"lastName\":\"Chaplin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Giovanni\",\"lastName\":\"Ribisi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"CCH\",\"lastName\":\"Pounder\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-12-19T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"12435\",\"name\":\"20th Century Studios\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Avatar: Fire and Ash\",\"synopsis\":null,\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/5b491185cf44783a0d2ff3cea1e3cba0.jpg\",\"synopsis\":\"The conflict on Pandora escalates as Jake and Neytiri's family encounter a new, aggressive Na'vi tribe. \\n\\nAvatar: Fire and Ash is the third instalment of James Cameron's five-film franchise.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/e6392ae6a0a1ff6ed6d80b2fc4a7a27d.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Avatar: Fire and Ash\",\"synopsis\":\"The conflict on Pandora escalates as Jake and Neytiri's family encounter a new, aggressive Na'vi tribe. \\n\\nAvatar: Fire and Ash is the third instalment of James Cameron's five-film franchise.\",\"certificate\":null,\"casting\":[\"Sam Worthington\",\"Zoe Saldana\",\"Sigourney Weaver\",\"Stephen Lang\",\"Kate Winslet\",\"Cliff Curtis\",\"Joel David Moore\",\"Oona Chaplin\",\"Giovanni Ribisi\",\"CCH Pounder\"],\"direction\":[\"James Cameron\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/e6392ae6a0a1ff6ed6d80b2fc4a7a27d.jpg\",\"img/46/d9/46d9a61464852503abc09ac176122b9b.jpg\",\"img/53/0e/530e8c422f2921771eb848526c9c412e.jpg\",\"img/fc/ff/fcff450656c40ef6beb46429a180eb62.jpg\",\"img/ba/ab/baab8e4d2f28403289ea05147a2b7f9d.jpg\",\"img/86/8c/868c52cbdd7b829a8dda0242c5b035bc.jpg\",\"img/f4/98/f498913ea354447e6bb908398c684148.jpg\",\"img/28/07/2807da269b5f9a98b87f7cde2c9df8d7.jpg\",\"img/ce/85/ce85a7e6bc30a2f0eba463af5d4db097.jpg\",\"img/4d/17/4d1728ae2058e8e7628e6fc2beed4543.jpg\",\"img/96/4c/964cb2c621023ba74f814a27492e8fdc.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/e6392ae6a0a1ff6ed6d80b2fc4a7a27d.jpg\"],\"release\":\"2025-12-19T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"20th Century Studios\"}},{\"id\":\"1000027004\",\"title\":\"Bat Out of Hell: The Musical\",\"runtime\":9600,\"genres\":\"Musical\",\"__typename\":\"Movie\",\"altId\":[\"395696\"],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a20cdceb4d26b07531bfc2d69f1241d7.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/16/56/1656a32a91af3185135a83ec7415e160.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/a8/ee/a8eeef119ab78021feda603cbeb44e63.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/bd/58/bd583e49c391efc712a98b65e60817ec.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/36/11/36110886fbd2cc52329f38253321a506.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jay\",\"lastName\":\"Scheib\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Glenn\",\"lastName\":\"Adamson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Katie\",\"lastName\":\"Tonkinson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rob\",\"lastName\":\"Fowler\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-10-30T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"41483\",\"name\":\"CinemaLive\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Bat Out of Hell: The Musical\",\"synopsis\":\"Get ready for the ultimate rock experience as Bat Out of Hell roars onto the big screen this Halloween! The cast of the West End production will bring Jim Steinman and Meat Loaf’s iconic anthems to life, including I’d Do Anything For Love (But I Won’t Do That), Paradise By The Dashboard Light, Two Out of Three Ain’t Bad, Dead Ringer For Love, and, of course, Bat Out of Hell. Bat out of Hell -The Musical promises a spectacle that will leave you breathless! This heart-pounding experience, with a powerhouse eight-piece live band on stage, delivers a new production with sprawling multi-level platforms to transport you from Raven’s bedroom to the underground world of the Lost in a visual feast that pushes the boundaries of live theatre.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/47/67/4767586d80ab473ba24d9b66f2575c06.png\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/a20cdceb4d26b07531bfc2d69f1241d7.jpg\",\"synopsis\":\"Get ready for the ultimate rock experience as Bat Out of Hell roars onto the big screen this Halloween!\\n\\nThe cast of the West End production will bring Jim Steinman and Meat Loaf’s iconic anthems to life, including I’d Do Anything For Love (But I Won’t Do That), Paradise By The Dashboard Light, Two Out of Three Ain’t Bad, Dead Ringer For Love, and, of course, Bat Out of Hell.\\n\\nBat out of Hell -The Musical promises a spectacle that will leave you breathless! This heart-pounding experience, with a powerhouse eight-piece live band on stage, delivers a new production with sprawling multi-level platforms to transport you from Raven’s bedroom to the underground world of the Lost in a visual feast that pushes the boundaries of live theatre.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/a846886b4703ab5b64b874a0fba16e5d.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Bat Out of Hell: The Musical\",\"synopsis\":\"Get ready for the ultimate rock experience as Bat Out of Hell roars onto the big screen this Halloween!\\n\\nThe cast of the West End production will bring Jim Steinman and Meat Loaf’s iconic anthems to life, including I’d Do Anything For Love (But I Won’t Do That), Paradise By The Dashboard Light, Two Out of Three Ain’t Bad, Dead Ringer For Love, and, of course, Bat Out of Hell.\\n\\nBat out of Hell -The Musical promises a spectacle that will leave you breathless! This heart-pounding experience, with a powerhouse eight-piece live band on stage, delivers a new production with sprawling multi-level platforms to transport you from Raven’s bedroom to the underground world of the Lost in a visual feast that pushes the boundaries of live theatre.\",\"certificate\":null,\"casting\":[\"Glenn Adamson\",\"Katie Tonkinson\",\"Rob Fowler\"],\"direction\":[\"Jay Scheib\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/a846886b4703ab5b64b874a0fba16e5d.jpg\",\"img/16/56/1656a32a91af3185135a83ec7415e160.jpg\",\"img/a8/ee/a8eeef119ab78021feda603cbeb44e63.jpg\",\"img/bd/58/bd583e49c391efc712a98b65e60817ec.jpg\",\"img/36/11/36110886fbd2cc52329f38253321a506.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/a846886b4703ab5b64b874a0fba16e5d.jpg\"],\"release\":\"2025-10-30T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"CinemaLive\"}},{\"id\":\"11295\",\"title\":\"Billy Elliot (25th Anniversary)\",\"runtime\":6600,\"genres\":\"Comedydrama\",\"__typename\":\"Movie\",\"altId\":[\"27172\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/e4e0ba6ba4bce5e5bbc4e10d59d2772b.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/86/95/74/19877497.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/86/95/74/19877493.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/86/95/74/19877491.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/86/95/74/19877490.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/03/06/17/030617_ph2.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/17/11/28/16/56/1588415.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/86/95/74/19877489.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/17/11/28/16/56/1602478.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/17/11/28/16/56/1616540.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/17/11/28/16/56/1630603.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Stephen\",\"lastName\":\"Daldry\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jamie\",\"lastName\":\"Bell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Julie\",\"lastName\":\"Walters\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gary\",\"lastName\":\"Lewis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jamie\",\"lastName\":\"Draven\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Adam\",\"lastName\":\"Cooper (II)\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Barbara\",\"lastName\":\"Leigh-Hunt\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Diana\",\"lastName\":\"Kent\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tracey\",\"lastName\":\"Wilkinson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Imogen\",\"lastName\":\"Claire\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Neil\",\"lastName\":\"North\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2020-08-14T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong language\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}]},{\"releasedAt\":\"2025-09-28T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong language\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Billy Elliot\",\"synopsis\":\"The life of a miner's son in Northern England is forever changed one day when he stumbles upon a ballet class on his way to boxing lessons. Joining the class and keeping it a secret from his widowed father and overbearing brother, 11-year-old Billy finds himself in dance, demonstrating the kind of raw talent seldom seen by the class's exacting instructor, Mrs. Wilkinson.  She encourages him to try out for the Royal Ballet.  But when his father and brother find out and forbid him to continue, Billy is torn between his responsibility to his family and to the gift with which he has been blessed.  His overwhelming desire to dance has become much more to him that simply a means of self-expression.  It is his passion and it is his destiny.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/3d/4c/3d4c532c5035545c604efaf7f563ffbb.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"embargoes\":[],\"exhibitor\":{\"title\":\"Billy Elliot (25th Anniversary)\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/e4e0ba6ba4bce5e5bbc4e10d59d2772b.jpg\",\"synopsis\":\"Back at Everyman for its 25th anniversary, BILLY ELLIOT is the heart-warming story of a young boy from a working-class family who discovers a passion that will change his life forever.\\n\\nEleven-year-old miner's son Billy Elliot (Jamie Bell) is on his way to boxing lessons when he stumbles upon a ballet class. Billy secretly joins the class, knowing that his working-class family would never understand. Under the guidance of his teacher, Mrs. Wilkinson (Julie Walters), Billy's raw talent takes flight. But when his father discovers his son's ambition, Billy must fight for his dreams and his destiny.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/76812f70da6c1c1646ea92eeabac8499.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Billy Elliot\",\"synopsis\":\"Back at Everyman for its 25th anniversary, BILLY ELLIOT is the heart-warming story of a young boy from a working-class family who discovers a passion that will change his life forever.\\n\\nEleven-year-old miner's son Billy Elliot (Jamie Bell) is on his way to boxing lessons when he stumbles upon a ballet class. Billy secretly joins the class, knowing that his working-class family would never understand. Under the guidance of his teacher, Mrs. Wilkinson (Julie Walters), Billy's raw talent takes flight. But when his father discovers his son's ambition, Billy must fight for his dreams and his destiny.\",\"certificate\":\"15\",\"casting\":[\"Jamie Bell\",\"Julie Walters\",\"Gary Lewis\",\"Jamie Draven\",\"Adam Cooper (II)\",\"Barbara Leigh-Hunt\",\"Diana Kent\",\"Tracey Wilkinson\",\"Imogen Claire\",\"Neil North\"],\"direction\":[\"Stephen Daldry\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/76812f70da6c1c1646ea92eeabac8499.jpg\",\"medias/nmedia/18/86/95/74/19877497.jpg\",\"medias/nmedia/18/86/95/74/19877493.jpg\",\"medias/nmedia/18/86/95/74/19877491.jpg\",\"medias/nmedia/18/86/95/74/19877490.jpg\",\"medias/03/06/17/030617_ph2.jpg\",\"pictures/17/11/28/16/56/1588415.jpg\",\"medias/nmedia/18/86/95/74/19877489.jpg\",\"pictures/17/11/28/16/56/1602478.jpg\",\"pictures/17/11/28/16/56/1616540.jpg\",\"pictures/17/11/28/16/56/1630603.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/76812f70da6c1c1646ea92eeabac8499.jpg\"],\"release\":\"2020-08-14T00:00:00.000Z\",\"advisory\":\"strong language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"1000031740\",\"title\":\"Black History Season: Horace Ové’s ‘Pressure’ + Live Q&A\",\"runtime\":null,\"genres\":\"Drama\",\"__typename\":\"Movie\",\"altId\":[\"401599\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4b871270c77c3bc75bf6fa7e6d87ab31.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Horace\",\"lastName\":\"Ové\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Herbert\",\"lastName\":\"Norville\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Oscar\",\"lastName\":\"James\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Frank\",\"lastName\":\"Singuineau\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lucita\",\"lastName\":\"Lijertwood\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sheila\",\"lastName\":\"Scott Wilkinson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-10-22T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"Contains strong language and drug use\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"24287\",\"name\":\"Independent\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Black History Season: Pressure + Live Q&A\",\"synopsis\":\"As London school-leaver Tony attempts to secure employment, he becomes entangled in boiling cultural tensions between the white establishment and his Jamaican background. Still the seminal portrait of the pressures faced by immigrants in Britain, this remains a caustic denouncement of institutional racism. Raw performances and confrontational politics power the first British film made by a black director ... do not miss out.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Black History Season: Horace Ové’s ‘Pressure’ + Live Q&A\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/4b871270c77c3bc75bf6fa7e6d87ab31.jpg\",\"synopsis\":\"Join us at Everyman to celebrate a cinematic milestone. The first Black British feature film, beautifully restored by the BFI National Archive and The Film Foundation in 4k, followed by a Q&A reflecting on the legacy and relevance today.\\n\\nA groundbreaking and authentic exploration of the anxieties of an emerging second generation of West Indians in Britain, Pressure (1975) is a significant title in the history of British Cinema, and remains as relevant now, almost 50 years on, as it ever was — with its themes of police corruption, discrimination, and employment on an individual and institutional level.\\n\\nAll proceeds from ticket sales will be donated to Black History Studies \\n\\n- Film Synopsis -\\nAs London school-leaver Tony attempts to secure employment, he becomes entangled in boiling cultural tensions between the white establishment and his Jamaican background. Still, the seminal portrait of the pressures faced by immigrants in Britain, this remains a caustic denunciation of institutional racism. Raw performances and confrontational politics power the first British film made by a black director ... do not miss out.\\n\\n- Event Timings -\\n7:00 pm - Doors open.\\n7:25 pm - Live Introduction begins.\\n7:30 pm - Film begins.\\n9:46 pm - Film ends, and Q&A begins.\\n10:15 pm - Q&A ends, and the event comes to a close.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Black History Season: Pressure + Live Q&A\",\"synopsis\":\"Join us at Everyman to celebrate a cinematic milestone. The first Black British feature film, beautifully restored by the BFI National Archive and The Film Foundation in 4k, followed by a Q&A reflecting on the legacy and relevance today.\\n\\nA groundbreaking and authentic exploration of the anxieties of an emerging second generation of West Indians in Britain, Pressure (1975) is a significant title in the history of British Cinema, and remains as relevant now, almost 50 years on, as it ever was — with its themes of police corruption, discrimination, and employment on an individual and institutional level.\\n\\nAll proceeds from ticket sales will be donated to Black History Studies \\n\\n- Film Synopsis -\\nAs London school-leaver Tony attempts to secure employment, he becomes entangled in boiling cultural tensions between the white establishment and his Jamaican background. Still, the seminal portrait of the pressures faced by immigrants in Britain, this remains a caustic denunciation of institutional racism. Raw performances and confrontational politics power the first British film made by a black director ... do not miss out.\\n\\n- Event Timings -\\n7:00 pm - Doors open.\\n7:25 pm - Live Introduction begins.\\n7:30 pm - Film begins.\\n9:46 pm - Film ends, and Q&A begins.\\n10:15 pm - Q&A ends, and the event comes to a close.\",\"certificate\":\"15\",\"casting\":[\"Herbert Norville\",\"Oscar James\",\"Frank Singuineau\",\"Lucita Lijertwood\",\"Sheila Scott Wilkinson\"],\"direction\":[\"Horace Ové\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-10-22T00:00:00.000Z\",\"advisory\":\"Contains strong language and drug use\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Independent\"}},{\"id\":\"1000030396\",\"title\":\"Blade Runner\",\"runtime\":7020,\"genres\":\"Science fiction\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/26f89dd91fb6e8b3b8fbbf2060b24e78.jpg\",\"__typename\":\"Movie\",\"altId\":[\"400039\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Ridley\",\"lastName\":\"Scott\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Harrison\",\"lastName\":\"Ford\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rutger\",\"lastName\":\"Hauer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sean\",\"lastName\":\"Young\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-10-23T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Branch Selects: Blade Runner\",\"synopsis\":\"In the year 2019, ex-detective Rick Deckard is called out of retirement to track down and eliminate a team of humanoid androids that have escaped from an outer space mining colony and have taken refuge here on Earth. During his search for the fugitives, he discovers some disturbing secrets about the future plans of the androids' manufacturer, the Tyrell Corporation.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/08/76/0876ae97eecb732a35503fd6071d8690.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/59f91205e3c99a5a19549357fd193d33.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":\"Blade Runner\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/26f89dd91fb6e8b3b8fbbf2060b24e78.jpg\",\"synopsis\":\"Selected by the Production Designers Branch, Everyman presents: Blade Runner\\n\\nIn the year 2019, ex-detective Rick Deckard is called out of retirement to track down and eliminate a team of humanoid androids that have escaped from an outer space mining colony and have taken refuge here on Earth. During his search for the fugitives, he discovers some disturbing secrets about the future plans of the androids' manufacturer, the Tyrell Corporation.\\n\\nThe design team of Lawrence G. Paull, David L. Snyder, and Linda DeScenna helped create one of cinema’s most indelible and imaginative visualizations of the city of the future (in this case, the Los Angeles of 2019) in this science-fiction noir, directed by Ridley Scott and adapted from the Philip K. Dick novel Do Androids Dream of Electric Sheep? which has become a classic in the forty years since its release. The film was nominated for Art Direction and for its Visual Effects, which are as seamlessly convincing as the day it premiered. \\n\\nPresented in 4k, the feature returns to the big screen at Everyman The Whiteley on Thursday, 23 October.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/418f122b65bb600f2b481f2eef388b7b.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Branch Selects: Blade Runner\",\"synopsis\":\"Selected by the Production Designers Branch, Everyman presents: Blade Runner\\n\\nIn the year 2019, ex-detective Rick Deckard is called out of retirement to track down and eliminate a team of humanoid androids that have escaped from an outer space mining colony and have taken refuge here on Earth. During his search for the fugitives, he discovers some disturbing secrets about the future plans of the androids' manufacturer, the Tyrell Corporation.\\n\\nThe design team of Lawrence G. Paull, David L. Snyder, and Linda DeScenna helped create one of cinema’s most indelible and imaginative visualizations of the city of the future (in this case, the Los Angeles of 2019) in this science-fiction noir, directed by Ridley Scott and adapted from the Philip K. Dick novel Do Androids Dream of Electric Sheep? which has become a classic in the forty years since its release. The film was nominated for Art Direction and for its Visual Effects, which are as seamlessly convincing as the day it premiered. \\n\\nPresented in 4k, the feature returns to the big screen at Everyman The Whiteley on Thursday, 23 October.\",\"certificate\":\"15\",\"casting\":[\"Harrison Ford\",\"Rutger Hauer\",\"Sean Young\"],\"direction\":[\"Ridley Scott\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/418f122b65bb600f2b481f2eef388b7b.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/418f122b65bb600f2b481f2eef388b7b.jpg\",\"https://cms-assets.webediamovies.pro/production/2/59f91205e3c99a5a19549357fd193d33.jpg\"],\"release\":\"2025-10-23T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"}},{\"id\":\"1975\",\"title\":\"Blade Runner\",\"runtime\":7020,\"genres\":\"Science fiction\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/57375104cbd83bf27dde7b6c1cd8e899.jpg\",\"__typename\":\"Movie\",\"altId\":[\"15042\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902250.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902249.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902235.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902234.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902233.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902231.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902228.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902219.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902216.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902213.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Ridley\",\"lastName\":\"Scott\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Harrison\",\"lastName\":\"Ford\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rutger\",\"lastName\":\"Hauer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sean\",\"lastName\":\"Young\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Daryl\",\"lastName\":\"Hannah\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"M. Emmet\",\"lastName\":\"Walsh\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"William\",\"lastName\":\"Sanderson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brion\",\"lastName\":\"James\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joe\",\"lastName\":\"Turkel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Edward James\",\"lastName\":\"Olmos\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joanna\",\"lastName\":\"Cassidy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"1986-04-10T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong violence\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Blade Runner\",\"synopsis\":\"In the year 2019, ex-detective Rick Deckard is called out of retirement to track down and eliminate a team of humanoid androids that have escaped from an outer space mining colony and have taken refuge here on Earth. During his search for the fugitives, he discovers some disturbing secrets about the future plans of the androids' manufacturer, the Tyrell Corporation.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/2a/a5/2aa53a45c3b5d7e38b79134a67af8a96.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/57375104cbd83bf27dde7b6c1cd8e899.jpg\",\"synopsis\":\"Selected by the Production Designers Branch, Everyman presents: Blade Runner\\n\\nIn the year 2019, ex-detective Rick Deckard is called out of retirement to track down and eliminate a team of humanoid androids that have escaped from an outer space mining colony and have taken refuge here on Earth. During his search for the fugitives, he discovers some disturbing secrets about the future plans of the androids' manufacturer, the Tyrell Corporation.\\n\\nThe design team of Lawrence G. Paull, David L. Snyder, and Linda DeScenna helped create one of cinema’s most indelible and imaginative visualizations of the city of the future (in this case, the Los Angeles of 2019) in this science-fiction noir, directed by Ridley Scott and adapted from the Philip K. Dick novel Do Androids Dream of Electric Sheep? which has become a classic in the forty years since its release. The film was nominated for Art Direction and for its Visual Effects, which are as seamlessly convincing as the day it premiered. \\n\\nPresented in 4k, the feature returns to the big screen at Everyman The Whiteley on Thursday, 23 October.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/a0d88e1dba1f39d72baf133ebaafef72.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Blade Runner\",\"synopsis\":\"Selected by the Production Designers Branch, Everyman presents: Blade Runner\\n\\nIn the year 2019, ex-detective Rick Deckard is called out of retirement to track down and eliminate a team of humanoid androids that have escaped from an outer space mining colony and have taken refuge here on Earth. During his search for the fugitives, he discovers some disturbing secrets about the future plans of the androids' manufacturer, the Tyrell Corporation.\\n\\nThe design team of Lawrence G. Paull, David L. Snyder, and Linda DeScenna helped create one of cinema’s most indelible and imaginative visualizations of the city of the future (in this case, the Los Angeles of 2019) in this science-fiction noir, directed by Ridley Scott and adapted from the Philip K. Dick novel Do Androids Dream of Electric Sheep? which has become a classic in the forty years since its release. The film was nominated for Art Direction and for its Visual Effects, which are as seamlessly convincing as the day it premiered. \\n\\nPresented in 4k, the feature returns to the big screen at Everyman The Whiteley on Thursday, 23 October.\",\"certificate\":\"15\",\"casting\":[\"Harrison Ford\",\"Rutger Hauer\",\"Sean Young\",\"Daryl Hannah\",\"M. Emmet Walsh\",\"William Sanderson\",\"Brion James\",\"Joe Turkel\",\"Edward James Olmos\",\"Joanna Cassidy\"],\"direction\":[\"Ridley Scott\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/a0d88e1dba1f39d72baf133ebaafef72.jpg\",\"medias/nmedia/18/66/01/66/18902250.jpg\",\"medias/nmedia/18/66/01/66/18902249.jpg\",\"medias/nmedia/18/66/01/66/18902235.jpg\",\"medias/nmedia/18/66/01/66/18902234.jpg\",\"medias/nmedia/18/66/01/66/18902233.jpg\",\"medias/nmedia/18/66/01/66/18902231.jpg\",\"medias/nmedia/18/66/01/66/18902228.jpg\",\"medias/nmedia/18/66/01/66/18902219.jpg\",\"medias/nmedia/18/66/01/66/18902216.jpg\",\"medias/nmedia/18/66/01/66/18902213.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/a0d88e1dba1f39d72baf133ebaafef72.jpg\"],\"release\":\"1986-04-10T00:00:00.000Z\",\"advisory\":\"strong violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"}},{\"id\":\"29\",\"title\":\"Breathless\",\"runtime\":5400,\"genres\":\"Detective, Drama, Romance\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/5ab21cba4f9f5a8a11d8ba95f3c18d49.jpg\",\"__typename\":\"Movie\",\"altId\":[\"6977\",\"92609\",\"184863\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jean-Luc\",\"lastName\":\"Godard\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jean\",\"lastName\":\"Seberg\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jean-Paul\",\"lastName\":\"Belmondo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Daniel\",\"lastName\":\"Boulanger\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Henri-Jacques\",\"lastName\":\"Huet\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Roger\",\"lastName\":\"Hanin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Van\",\"lastName\":\"Doude\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Claude\",\"lastName\":\"Mansard\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Liliane\",\"lastName\":\"Dreyfus\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michel\",\"lastName\":\"Fabre\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jean-Pierre\",\"lastName\":\"Melville\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2020-12-04T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"moderate sex references, brief nudity\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[],\"distributors\":[{\"id\":\"9447\",\"name\":\"StudioCanal UK\",\"__typename\":\"Company\"}]},{\"releasedAt\":\"2026-02-05T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"moderate sex references, brief nudity\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[],\"distributors\":[{\"id\":\"32481\",\"name\":\"Studio Canal\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Breathless\",\"synopsis\":\"Godard's jazzy riff on American Film Noir features iconic performances from Jean-Paul Belmondo, as the on-the-run Bogart-inspired small-time hood, and Jean Seberg as his American, Herald Tribune-hawking girlfriend, who ultimately betrays him. With a pace that's non-stop, thanks to its startling new editing techniques, BREATHLESS reinvented the grammar of movies and almost instantly changed the course of international filmmaking.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/6977_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/6977_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/83/7b/837b8a73b877e5841ae4e7a57510399e.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/5ab21cba4f9f5a8a11d8ba95f3c18d49.jpg\",\"synopsis\":\"Selected by the Film Editors Branch, Everyman presents: Breathless\\n\\nPetty thug Michel (Jean-Paul Belmondo) considers himself a suave bad guy in the manner of Humphrey Bogart, but panics and impulsively kills a policeman while driving a stolen car. On the lam, he turns to his aspiring journalist girlfriend, Patricia (Jean Seberg), hiding out in her Paris apartment while he tries to pull together enough money to get the pair to Italy. But when Patricia learns that her boyfriend is being investigated for murder, she begins to question her loyalties.\\n\\nJean-Luc Godard dedicated his game-changing thriller to the American B-movie studio Monogram Pictures, and this tale of an American student who falls for a Parisian thief is not only one of the defining films of the French New Wave but one of cinema’s most influential films. Jean Seberg and Jean-Paul Belmondo’s career-defining performances made them icons of cinematic cool, while Raoul Coutard’s striking black-and-white, hand-held cinematography captures the chaotic elegance of the city of lights. The film editing of Cécile Decugis—a filmmaker and activist in her own right—incorporated groundbreaking techniques, such as jump cuts, that forever changed the way cinematic stories are told.  \\n\\nPresented in restored 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 5 February.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/8c9dbb6ccaf86a9d7abe0449cd8a6eab.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"À bout de souffle\",\"synopsis\":\"Selected by the Film Editors Branch, Everyman presents: Breathless\\n\\nPetty thug Michel (Jean-Paul Belmondo) considers himself a suave bad guy in the manner of Humphrey Bogart, but panics and impulsively kills a policeman while driving a stolen car. On the lam, he turns to his aspiring journalist girlfriend, Patricia (Jean Seberg), hiding out in her Paris apartment while he tries to pull together enough money to get the pair to Italy. But when Patricia learns that her boyfriend is being investigated for murder, she begins to question her loyalties.\\n\\nJean-Luc Godard dedicated his game-changing thriller to the American B-movie studio Monogram Pictures, and this tale of an American student who falls for a Parisian thief is not only one of the defining films of the French New Wave but one of cinema’s most influential films. Jean Seberg and Jean-Paul Belmondo’s career-defining performances made them icons of cinematic cool, while Raoul Coutard’s striking black-and-white, hand-held cinematography captures the chaotic elegance of the city of lights. The film editing of Cécile Decugis—a filmmaker and activist in her own right—incorporated groundbreaking techniques, such as jump cuts, that forever changed the way cinematic stories are told.  \\n\\nPresented in restored 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 5 February.\",\"certificate\":\"12A\",\"casting\":[\"Jean Seberg\",\"Jean-Paul Belmondo\",\"Daniel Boulanger\",\"Henri-Jacques Huet\",\"Roger Hanin\",\"Van Doude\",\"Claude Mansard\",\"Liliane Dreyfus\",\"Michel Fabre\",\"Jean-Pierre Melville\"],\"direction\":[\"Jean-Luc Godard\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/8c9dbb6ccaf86a9d7abe0449cd8a6eab.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/8c9dbb6ccaf86a9d7abe0449cd8a6eab.jpg\"],\"release\":\"2020-12-04T00:00:00.000Z\",\"advisory\":\"moderate sex references, brief nudity\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/6977_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/6977_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"StudioCanal UK\"}},{\"id\":\"282613\",\"title\":\"Bugonia\",\"runtime\":7080,\"genres\":\"Science fiction, Comedy\",\"__typename\":\"Movie\",\"altId\":[\"363871\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/343efbf6d2f0d55344b5933a94ea88e5.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/8b/fd/8bfdb63a039ba5a439924fd2619fb0f2.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/69/bb/69bbcae9ab59d50737edfe17c55efc33.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/50/6f/506f4970fd8147c099a0fb539387bfc6.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/89/0f/890fb71cca68e9bf7bce5eea9947f7f3.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Yorgos\",\"lastName\":\"Lanthimos\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emma\",\"lastName\":\"Stone\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jesse\",\"lastName\":\"Plemons\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Aidan\",\"lastName\":\"Delbis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alicia\",\"lastName\":\"Silverstone\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Stavros\",\"lastName\":\"Halkias\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Parvinder\",\"lastName\":\"Shergill\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Vanessa\",\"lastName\":\"Eng\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Momma\",\"lastName\":\"Cherri\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cedric\",\"lastName\":\"Dumornay\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marc T.\",\"lastName\":\"Lewis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-10-31T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"26962\",\"name\":\"Universal Pictures International\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Bugonia\",\"synopsis\":\"Two conspiracy obsessed young men kidnap the high-powered CEO of a major company, convinced that she is an alien intent on destroying planet Earth. BUGONIA is based on the South Korean sci-fi comedy, SAVE THE GREEN PLANET (2003).\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/5330044dddea05bdfbabfcbb4e479ae1.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/343efbf6d2f0d55344b5933a94ea88e5.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/462f23d3c478122159a0612a5a73f5aa.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Bugonia\",\"synopsis\":\"Two conspiracy obsessed young men kidnap the high-powered CEO of a major company, convinced that she is an alien intent on destroying planet Earth. BUGONIA is based on the South Korean sci-fi comedy, SAVE THE GREEN PLANET (2003).\",\"certificate\":null,\"casting\":[\"Emma Stone\",\"Jesse Plemons\",\"Aidan Delbis\",\"Alicia Silverstone\",\"Stavros Halkias\",\"Parvinder Shergill\",\"Vanessa Eng\",\"Momma Cherri\",\"Cedric Dumornay\",\"Marc T. Lewis\"],\"direction\":[\"Yorgos Lanthimos\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/462f23d3c478122159a0612a5a73f5aa.jpg\",\"img/8b/fd/8bfdb63a039ba5a439924fd2619fb0f2.jpg\",\"img/69/bb/69bbcae9ab59d50737edfe17c55efc33.jpg\",\"img/50/6f/506f4970fd8147c099a0fb539387bfc6.jpg\",\"img/89/0f/890fb71cca68e9bf7bce5eea9947f7f3.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/462f23d3c478122159a0612a5a73f5aa.jpg\",\"https://cms-assets.webediamovies.pro/production/2/5330044dddea05bdfbabfcbb4e479ae1.jpg\"],\"release\":\"2025-10-31T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Universal Pictures International\"}},{\"id\":\"1000031305\",\"title\":\"CLOUT + Live Q&A Tour\",\"runtime\":null,\"genres\":\"Drama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c30d9e1d7988ca0a3df938163f680c28.jpeg\",\"__typename\":\"Movie\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jordan\",\"lastName\":\"Murphy Doidge\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anna\",\"lastName\":\"Wilson-Jones\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Archie\",\"lastName\":\"Yates\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nadine\",\"lastName\":\"Marshall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Samuel\",\"lastName\":\"Leakey\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"altId\":[],\"releases\":[{\"releasedAt\":\"2025-10-08T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"24287\",\"name\":\"Independent\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Clout + Live Q&A\",\"synopsis\":\"A haunting tale of youth and obsession, CLOUT follows 13-year-old Oskar (Archie Yates, Jojo Rabbit), whose desperate pursuit of attention spirals into something sinister. Often described as “Black Mirror meets Stand By Me”, the short also echoes themes explored in Netflix’s Adolescence, situating it firmly within a global conversation about identity, vulnerability, and the dark side of coming of age online.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"CLOUT + Live Q&A Tour\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/c30d9e1d7988ca0a3df938163f680c28.jpeg\",\"synopsis\":\"Join us at Everyman venues across the UK with a screening of the award-winning short film, CLOUT, followed by a Live Q&A with Director Jordan Murphy Doidge, Writer Tom Duthie, Actor Archie Yates and more of the cast! \\n\\nA haunting tale of youth and obsession, CLOUT follows 13-year-old Oskar (Archie Yates, Jojo Rabbit), whose desperate pursuit of attention spirals into something sinister. Often described as “Black Mirror meets Stand By Me”, the short also echoes themes explored in Netflix’s Adolescence, situating it firmly within a global conversation about identity, vulnerability, and the dark side of coming of age online.\\n\\nEach ticket includes a complimentary popcorn.\\n\\nVENUE TOUR DATES:\\n- The Whiteley | Wednesday 8th October\\n- King's Cross | Tuesday  4th November\\n- Hampstead | Wednesday 5th November\\n- Plymouth | Tuesday 11th November\\n- Chelsea | Thursday 13th November\\n- Cambridge | Monday 17th November\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/6207c4f78d2426f016f6f0cc8691efb6.jpeg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Clout + Live Q&A\",\"synopsis\":\"Join us at Everyman venues across the UK with a screening of the award-winning short film, CLOUT, followed by a Live Q&A with Director Jordan Murphy Doidge, Writer Tom Duthie, Actor Archie Yates and more of the cast! \\n\\nA haunting tale of youth and obsession, CLOUT follows 13-year-old Oskar (Archie Yates, Jojo Rabbit), whose desperate pursuit of attention spirals into something sinister. Often described as “Black Mirror meets Stand By Me”, the short also echoes themes explored in Netflix’s Adolescence, situating it firmly within a global conversation about identity, vulnerability, and the dark side of coming of age online.\\n\\nEach ticket includes a complimentary popcorn.\\n\\nVENUE TOUR DATES:\\n- The Whiteley | Wednesday 8th October\\n- King's Cross | Tuesday  4th November\\n- Hampstead | Wednesday 5th November\\n- Plymouth | Tuesday 11th November\\n- Chelsea | Thursday 13th November\\n- Cambridge | Monday 17th November\",\"certificate\":null,\"casting\":[\"Anna Wilson-Jones\",\"Archie Yates\",\"Nadine Marshall\",\"Samuel Leakey\"],\"direction\":[\"Jordan Murphy Doidge\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/6207c4f78d2426f016f6f0cc8691efb6.jpeg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/6207c4f78d2426f016f6f0cc8691efb6.jpeg\"],\"release\":\"2025-10-08T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Independent\"}},{\"id\":\"135530\",\"title\":\"Cars 2\",\"runtime\":6720,\"genres\":\"Animation\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c6fcc4eb2a9d052587863a69b90f6627.jpg\",\"__typename\":\"Movie\",\"altId\":[\"64624\",\"97521\",\"107661\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/91/50/19982603.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/91/50/19982602.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/91/50/19982601.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/91/50/19982600.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/91/50/19982599.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/91/50/19982598.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/91/50/19982597.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/91/50/19982596.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/91/50/19982595.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/91/50/19982594.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Brad\",\"lastName\":\"Lewis\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"John\",\"lastName\":\"Lasseter\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Owen\",\"lastName\":\"Wilson\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":null,\"lastName\":\"Larry The Cable Guy\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Michael\",\"lastName\":\"Caine\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Emily\",\"lastName\":\"Mortimer\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Jason\",\"lastName\":\"Isaacs\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Suzy Eddie\",\"lastName\":\"Izzard\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Joe\",\"lastName\":\"Mantegna\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Peter\",\"lastName\":\"Jacobson\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"John\",\"lastName\":\"Turturro\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Thomas\",\"lastName\":\"Kretschmann\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2011-07-22T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[],\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}]},{\"releasedAt\":\"2025-09-26T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"Contains mild violence\",\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[],\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Cars 2\",\"synopsis\":\"Star racecar Lightning McQueen and the incomparable tow truck Mater take their friendship to exciting new places in \\\"Cars 2\\\" when they compete in the first-ever World Grand Prix to determine the world's fastest car. But, the road to the championship is filled with plenty of potholes, detours and hilarious surprises when Mater gets caught up in an intriguing adventure of his own: international espionage.  Torn between assisting Lightning McQueen in the high-profile race and towing the line in a top-secret spy mission, Mater's action-packed journey leads him on an explosive chase through the streets of Japan and Europe, trailed by his friends and watched by the whole world.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/7d/59/7d597dfd7f0569d00b6163fad0e2e0c5.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/c6fcc4eb2a9d052587863a69b90f6627.jpg\",\"synopsis\":\"Star racecar Lightning McQueen and the incomparable tow truck Mater take their friendship to exciting new places in \\\"Cars 2\\\" when they compete in the first-ever World Grand Prix to determine the world's fastest car. But, the road to the championship is filled with plenty of potholes, detours and hilarious surprises when Mater gets caught up in an intriguing adventure of his own: international espionage.  \\n\\nTorn between assisting Lightning McQueen in the high-profile race and towing the line in a top-secret spy mission, Mater's action-packed journey leads him on an explosive chase through the streets of Japan and Europe, trailed by his friends and watched by the whole world.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/e2e51e67c878677e5af19446a479a1c1.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Cars 2\",\"synopsis\":\"Star racecar Lightning McQueen and the incomparable tow truck Mater take their friendship to exciting new places in \\\"Cars 2\\\" when they compete in the first-ever World Grand Prix to determine the world's fastest car. But, the road to the championship is filled with plenty of potholes, detours and hilarious surprises when Mater gets caught up in an intriguing adventure of his own: international espionage.  \\n\\nTorn between assisting Lightning McQueen in the high-profile race and towing the line in a top-secret spy mission, Mater's action-packed journey leads him on an explosive chase through the streets of Japan and Europe, trailed by his friends and watched by the whole world.\",\"certificate\":\"U\",\"casting\":[\"Owen Wilson\",\"Larry The Cable Guy\",\"Michael Caine\",\"Emily Mortimer\",\"Jason Isaacs\",\"Suzy Eddie Izzard\",\"Joe Mantegna\",\"Peter Jacobson\",\"John Turturro\",\"Thomas Kretschmann\"],\"direction\":[\"Brad Lewis\",\"John Lasseter\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/e2e51e67c878677e5af19446a479a1c1.jpg\",\"medias/nmedia/18/87/91/50/19982603.jpg\",\"medias/nmedia/18/87/91/50/19982602.jpg\",\"medias/nmedia/18/87/91/50/19982601.jpg\",\"medias/nmedia/18/87/91/50/19982600.jpg\",\"medias/nmedia/18/87/91/50/19982599.jpg\",\"medias/nmedia/18/87/91/50/19982598.jpg\",\"medias/nmedia/18/87/91/50/19982597.jpg\",\"medias/nmedia/18/87/91/50/19982596.jpg\",\"medias/nmedia/18/87/91/50/19982595.jpg\",\"medias/nmedia/18/87/91/50/19982594.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/e2e51e67c878677e5af19446a479a1c1.jpg\"],\"release\":\"2011-07-22T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Walt Disney\"}},{\"id\":\"1000030401\",\"title\":\"Casino\",\"runtime\":10680,\"genres\":\"Drama, Detective\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ea4e9e83d4adbf7c590a76cd0aa348a3.jpg\",\"__typename\":\"Movie\",\"altId\":[\"400044\"],\"images\":[],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"De Niro\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sharon\",\"lastName\":\"Stone\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joe\",\"lastName\":\"Pesci\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Martin\",\"lastName\":\"Scorsese\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2025-11-06T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Branch Selects: Casino\",\"synopsis\":\"Robert DeNiro, Sharon Stone and Joe Pesci star in director Martin Scorsese's riveting look at how blind ambition, white-hot passion and 24-karat greed toppled an empire. Las Vegas 1973 is the setting for this fact-based story about the Mob's multi-million dollar casino operation - where fortunes and lives were made and lost with a roll of the dice.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/af/5f/af5f4db8011b6ef1d78a4bae47a932a2.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Casino\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/ea4e9e83d4adbf7c590a76cd0aa348a3.jpg\",\"synopsis\":\"Selected by the Actors Branch, Everyman presents: Casino\\n\\nRobert De Niro, Sharon Stone and Joe Pesci star in director Martin Scorsese's riveting look at how blind ambition, white-hot passion and 24-karat greed toppled an empire. Las Vegas 1973 is the setting for this fact-based story about the Mob's multi-million dollar casino operation, where fortunes and lives were made and lost with a roll of the dice.\\n\\nAuthor Nicholas Pileggi teamed up with director Martin Scorsese to adapt his own non-fiction book about the influence of organised crime in Las Vegas gambling in the 1970s and ’80s for this thrilling true crime epic, showcasing the director’s dazzling style with the help of such key collaborators as cinematographer Robert Richardson and editor Thelma Schoonmaker. Casting director Ellen Lewis assembled an impressively eclectic ensemble including Oscar-winning Scorsese perennials Robert De Niro and Joe Pesci, several comedians in rare serious roles (including Don Rickles, Alan King, and Dick Smothers), and Sharon Stone, whose uncompromising performance as the troubled wife of De Niro’s casino boss earned her a Best Actress nomination.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman The Whiteley on Thursday, 6 November.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/28708f80294edd2422032928194a4744.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Branch Selects: Casino\",\"synopsis\":\"Selected by the Actors Branch, Everyman presents: Casino\\n\\nRobert De Niro, Sharon Stone and Joe Pesci star in director Martin Scorsese's riveting look at how blind ambition, white-hot passion and 24-karat greed toppled an empire. Las Vegas 1973 is the setting for this fact-based story about the Mob's multi-million dollar casino operation, where fortunes and lives were made and lost with a roll of the dice.\\n\\nAuthor Nicholas Pileggi teamed up with director Martin Scorsese to adapt his own non-fiction book about the influence of organised crime in Las Vegas gambling in the 1970s and ’80s for this thrilling true crime epic, showcasing the director’s dazzling style with the help of such key collaborators as cinematographer Robert Richardson and editor Thelma Schoonmaker. Casting director Ellen Lewis assembled an impressively eclectic ensemble including Oscar-winning Scorsese perennials Robert De Niro and Joe Pesci, several comedians in rare serious roles (including Don Rickles, Alan King, and Dick Smothers), and Sharon Stone, whose uncompromising performance as the troubled wife of De Niro’s casino boss earned her a Best Actress nomination.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman The Whiteley on Thursday, 6 November.\",\"certificate\":\"18\",\"casting\":[\"Robert De Niro\",\"Sharon Stone\",\"Joe Pesci\"],\"direction\":[\"Martin Scorsese\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/28708f80294edd2422032928194a4744.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/28708f80294edd2422032928194a4744.jpg\"],\"release\":\"2025-11-06T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Universal International Pictures\"}},{\"id\":\"14178\",\"title\":\"Casino\",\"runtime\":10680,\"genres\":\"Drama, Detective\",\"__typename\":\"Movie\",\"altId\":[\"3139\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/bc3522e54f7c571ca3b2a2acc57bde07.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840349.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840348.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840347.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840336.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840335.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840334.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18984810.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18462109.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18462108.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18462106.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Martin\",\"lastName\":\"Scorsese\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"De Niro\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sharon\",\"lastName\":\"Stone\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joe\",\"lastName\":\"Pesci\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Don\",\"lastName\":\"Rickles\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"James\",\"lastName\":\"Woods\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kevin\",\"lastName\":\"Pollak\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Frank\",\"lastName\":\"Vincent\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alan\",\"lastName\":\"King\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dick\",\"lastName\":\"Smothers\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Catherine\",\"lastName\":\"Scorsese\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2023-09-16T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong violence\",\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Casino\",\"synopsis\":\"Robert DeNiro, Sharon Stone and Joe Pesci star in director Martin Scorsese's riveting look at how blind ambition, white-hot passion and 24-karat greed toppled an empire. Las Vegas 1973 is the setting for this fact-based story about the Mob's multi-million dollar casino operation - where fortunes and lives were made and lost with a roll of the dice.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/0f/2b/0f2b617c052914f03487cf6906bc0257.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/bc3522e54f7c571ca3b2a2acc57bde07.jpg\",\"synopsis\":\"Selected by the Actors Branch, Everyman presents: Casino\\n\\nRobert De Niro, Sharon Stone and Joe Pesci star in director Martin Scorsese's riveting look at how blind ambition, white-hot passion and 24-karat greed toppled an empire. Las Vegas 1973 is the setting for this fact-based story about the Mob's multi-million dollar casino operation, where fortunes and lives were made and lost with a roll of the dice.\\n\\nAuthor Nicholas Pileggi teamed up with director Martin Scorsese to adapt his own non-fiction book about the influence of organised crime in Las Vegas gambling in the 1970s and ’80s for this thrilling true crime epic, showcasing the director’s dazzling style with the help of such key collaborators as cinematographer Robert Richardson and editor Thelma Schoonmaker. Casting director Ellen Lewis assembled an impressively eclectic ensemble including Oscar-winning Scorsese perennials Robert De Niro and Joe Pesci, several comedians in rare serious roles (including Don Rickles, Alan King, and Dick Smothers), and Sharon Stone, whose uncompromising performance as the troubled wife of De Niro’s casino boss earned her a Best Actress nomination.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman The Whiteley on Thursday, 6 November.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/38673aa35d60cdf741fbeb3bf89144dc.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Casino\",\"synopsis\":\"Selected by the Actors Branch, Everyman presents: Casino\\n\\nRobert De Niro, Sharon Stone and Joe Pesci star in director Martin Scorsese's riveting look at how blind ambition, white-hot passion and 24-karat greed toppled an empire. Las Vegas 1973 is the setting for this fact-based story about the Mob's multi-million dollar casino operation, where fortunes and lives were made and lost with a roll of the dice.\\n\\nAuthor Nicholas Pileggi teamed up with director Martin Scorsese to adapt his own non-fiction book about the influence of organised crime in Las Vegas gambling in the 1970s and ’80s for this thrilling true crime epic, showcasing the director’s dazzling style with the help of such key collaborators as cinematographer Robert Richardson and editor Thelma Schoonmaker. Casting director Ellen Lewis assembled an impressively eclectic ensemble including Oscar-winning Scorsese perennials Robert De Niro and Joe Pesci, several comedians in rare serious roles (including Don Rickles, Alan King, and Dick Smothers), and Sharon Stone, whose uncompromising performance as the troubled wife of De Niro’s casino boss earned her a Best Actress nomination.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman The Whiteley on Thursday, 6 November.\",\"certificate\":\"18\",\"casting\":[\"Robert De Niro\",\"Sharon Stone\",\"Joe Pesci\",\"Don Rickles\",\"James Woods\",\"Kevin Pollak\",\"Frank Vincent\",\"Alan King\",\"Dick Smothers\",\"Catherine Scorsese\"],\"direction\":[\"Martin Scorsese\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/38673aa35d60cdf741fbeb3bf89144dc.jpg\",\"medias/nmedia/18/36/21/14/18840349.jpg\",\"medias/nmedia/18/36/21/14/18840348.jpg\",\"medias/nmedia/18/36/21/14/18840347.jpg\",\"medias/nmedia/18/36/21/14/18840336.jpg\",\"medias/nmedia/18/36/21/14/18840335.jpg\",\"medias/nmedia/18/36/21/14/18840334.jpg\",\"medias/nmedia/18/36/21/14/18984810.jpg\",\"medias/nmedia/18/36/21/14/18462109.jpg\",\"medias/nmedia/18/36/21/14/18462108.jpg\",\"medias/nmedia/18/36/21/14/18462106.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/38673aa35d60cdf741fbeb3bf89144dc.jpg\"],\"release\":\"2023-09-16T00:00:00.000Z\",\"advisory\":\"strong violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Universal International Pictures\"}},{\"id\":\"58525\",\"title\":\"Casino Royale\",\"runtime\":8280,\"genres\":\"Spy, Action, Thriller\",\"__typename\":\"Movie\",\"altId\":[\"50371\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/e95e2767ed1cb24d02b4bce77a750f13.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/25/50/19904251.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/25/50/19904250.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/25/50/19904249.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/25/50/19904248.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/25/50/19904247.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/25/50/19904246.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/25/50/19904245.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/25/50/19904244.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/25/50/19904243.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/25/50/19904242.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Martin\",\"lastName\":\"Campbell\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Daniel\",\"lastName\":\"Craig\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Eva\",\"lastName\":\"Green\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mads\",\"lastName\":\"Mikkelsen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Judi\",\"lastName\":\"Dench\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jeffrey\",\"lastName\":\"Wright\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Giancarlo\",\"lastName\":\"Giannini\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Caterina\",\"lastName\":\"Murino\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Simon\",\"lastName\":\"Abkarian\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Isaach\",\"lastName\":\"de Bankolé\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jesper\",\"lastName\":\"Christensen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2006-10-30T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"Contains one scene of torture and strong action violence\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Casino Royale\",\"synopsis\":\"James Bond's first 007 mission takes him to Madagascar, where he is to spy on a terrorist Mollaka. Not everything goes as planned and Bond decides to investigate, independently of the MI6 agency, in order to track down the rest of the terrorist cell. Following a lead to the Bahamas, he encounters Dimitrios and his girlfriend, Solange. He learns that Dimitrios is involved with Le Chiffre, banker to the world's terrorist organizations. Secret Service intelligence reveals that Le Chiffre is planning to raise money in a high-stakes poker game in Montenegro at Le Casino Royale. MI6 assigns 007 to play against him, knowing that if Le Chiffre loses, it will destroy his organization. 'M' places Bond under the watchful eye of the beguiling Vesper Lynd. At first skeptical of what value Vesper can provide, Bond's interest in her deepens as they brave danger together--and even torture at the hands of Le Chiffre. In Montenegro, Bond allies himself with Matthis, MI6's local field agent, and Felix Leiter, who is representing the interests of the CIA. The marathon game proceeds with dirty tricks and violence, raising the stakes beyond blood money and reaching a terrifying climax.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/25/5a/255a5cf7fa293aeb6921417e5d5c18c6.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/e95e2767ed1cb24d02b4bce77a750f13.jpg\",\"synopsis\":\"After receiving a license to kill, British Secret Service agent James Bond (Daniel Craig) heads to Madagascar, where he uncovers a link to Le Chiffre (Mads Mikkelsen), a man who finances terrorist organizations. Learning that Le Chiffre plans to raise money in a high-stakes poker game, MI6 sends Bond to play against him, gambling that their newest \\\"00\\\" operative will topple the man's organization.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/df0a8fe6fbdc713ad593bfe687da0da0.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Casino Royale\",\"synopsis\":\"After receiving a license to kill, British Secret Service agent James Bond (Daniel Craig) heads to Madagascar, where he uncovers a link to Le Chiffre (Mads Mikkelsen), a man who finances terrorist organizations. Learning that Le Chiffre plans to raise money in a high-stakes poker game, MI6 sends Bond to play against him, gambling that their newest \\\"00\\\" operative will topple the man's organization.\",\"certificate\":\"15\",\"casting\":[\"Daniel Craig\",\"Eva Green\",\"Mads Mikkelsen\",\"Judi Dench\",\"Jeffrey Wright\",\"Giancarlo Giannini\",\"Caterina Murino\",\"Simon Abkarian\",\"Isaach de Bankolé\",\"Jesper Christensen\"],\"direction\":[\"Martin Campbell\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/df0a8fe6fbdc713ad593bfe687da0da0.jpg\",\"medias/nmedia/18/87/25/50/19904251.jpg\",\"medias/nmedia/18/87/25/50/19904250.jpg\",\"medias/nmedia/18/87/25/50/19904249.jpg\",\"medias/nmedia/18/87/25/50/19904248.jpg\",\"medias/nmedia/18/87/25/50/19904247.jpg\",\"medias/nmedia/18/87/25/50/19904246.jpg\",\"medias/nmedia/18/87/25/50/19904245.jpg\",\"medias/nmedia/18/87/25/50/19904244.jpg\",\"medias/nmedia/18/87/25/50/19904243.jpg\",\"medias/nmedia/18/87/25/50/19904242.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/df0a8fe6fbdc713ad593bfe687da0da0.jpg\"],\"release\":\"2006-10-30T00:00:00.000Z\",\"advisory\":\"Contains one scene of torture and strong action violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures UK\"}},{\"id\":\"1000000214\",\"title\":\"Caught Stealing\",\"runtime\":6420,\"genres\":\"Thriller, Comedy\",\"__typename\":\"Movie\",\"altId\":[\"359188\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/394ebe1f9ba7363e882a1d91a4745253.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/d0/e5/d0e5735f7d78681edce234936a2336fe.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/81/f5/81f5ccf9928fb564722b614a7cd8444a.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/d6/fd/d6fd0ec1fd35604682ba85416a820daf.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/80/48/804843159eac470079684b8de8f2a29d.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/0d/55/0d55409cfbaaf0fd6615cacc577751e9.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/38/95/38955a27ed704c2664e2c47c6d606814.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/65/65/6565555bc700de6d27727ea358a1056c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/6f/59/6f59ced06c6f4c2d20378d0631fafaf3.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Darren\",\"lastName\":\"Aronofsky\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Austin\",\"lastName\":\"Butler\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Regina\",\"lastName\":\"King\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Zoë\",\"lastName\":\"Kravitz\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Matt\",\"lastName\":\"Smith (XI)\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Liev\",\"lastName\":\"Schreiber\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Vincent\",\"lastName\":\"D'Onofrio\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Griffin\",\"lastName\":\"Dunne\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":null,\"lastName\":\"Bad Bunny\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Will\",\"lastName\":\"Brill\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"D'Pharaoh\",\"lastName\":\"Woon-A-Tai\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-08-29T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"very strong language, strong bloody violence, threat, drug misuse, sex\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Caught Stealing\",\"synopsis\":\"Hank Thompson (Austin Butler) was a high-school baseball phenom who can’t play anymore, but everything else is going okay. He’s got a great girl (Zoë Kravitz), tends bar at a New York dive, and his favorite team is making an underdog run at the pennant. When his punk-rock neighbor Russ (Matt Smith) asks him to take care of his cat for a few days, Hank suddenly finds himself caught in the middle of a motley crew of threatening gangsters. They all want a piece of him; the problem is he has no idea why. As Hank attempts to evade their ever-tightening grip, he’s got to use all his hustle to stay alive long enough to find out.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/359188_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/359188_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/07/33/073343ee73c55d721ba7aa0a15e1747e.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/d9f1b4430898a7d6d6218bfd07e1f503.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/394ebe1f9ba7363e882a1d91a4745253.jpg\",\"synopsis\":\"Burned-out ex-baseball player Hank Thompson (Austin Butler) unexpectedly finds himself embroiled in a dangerous struggle for survival amidst the criminal underbelly of 1990s New York City, forced to navigate a treacherous underworld he never imagined.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/b62677ed8b7072c3bfa3ca5718e9a9b9.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Caught Stealing\",\"synopsis\":\"Burned-out ex-baseball player Hank Thompson (Austin Butler) unexpectedly finds himself embroiled in a dangerous struggle for survival amidst the criminal underbelly of 1990s New York City, forced to navigate a treacherous underworld he never imagined.\",\"certificate\":\"15\",\"casting\":[\"Austin Butler\",\"Regina King\",\"Zoë Kravitz\",\"Matt Smith (XI)\",\"Liev Schreiber\",\"Vincent D'Onofrio\",\"Griffin Dunne\",\"Bad Bunny\",\"Will Brill\",\"D'Pharaoh Woon-A-Tai\"],\"direction\":[\"Darren Aronofsky\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/b62677ed8b7072c3bfa3ca5718e9a9b9.jpg\",\"img/d0/e5/d0e5735f7d78681edce234936a2336fe.jpg\",\"img/81/f5/81f5ccf9928fb564722b614a7cd8444a.jpg\",\"img/d6/fd/d6fd0ec1fd35604682ba85416a820daf.jpg\",\"img/80/48/804843159eac470079684b8de8f2a29d.jpg\",\"img/0d/55/0d55409cfbaaf0fd6615cacc577751e9.jpg\",\"img/38/95/38955a27ed704c2664e2c47c6d606814.jpg\",\"img/65/65/6565555bc700de6d27727ea358a1056c.jpg\",\"img/6f/59/6f59ced06c6f4c2d20378d0631fafaf3.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/b62677ed8b7072c3bfa3ca5718e9a9b9.jpg\",\"https://cms-assets.webediamovies.pro/production/2/d9f1b4430898a7d6d6218bfd07e1f503.jpg\"],\"release\":\"2025-08-29T00:00:00.000Z\",\"advisory\":\"very strong language, strong bloody violence, threat, drug misuse, sex\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/359188_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/359188_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures UK\"}},{\"id\":\"1000030969\",\"title\":\"Dali - UK Premiere\",\"runtime\":5460,\"genres\":\"Drama, Fantasy\",\"__typename\":\"Movie\",\"altId\":[\"400691\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/be42fedf5c2a2c2d3bfb824265214f06.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Mickey\",\"lastName\":\"Angelov\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nina\",\"lastName\":\"Singh\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Amanda\",\"lastName\":\"Vilanova\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ebony\",\"lastName\":\"Aboagye\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mickey\",\"lastName\":\"Angelov\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joseph\",\"lastName\":\"Bushell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-10-15T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"24287\",\"name\":\"Independent\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Dali - UK Premiere\",\"synopsis\":\"A Bulgarian-born, American-raised rapper dies and faces The Gatekeeper at the crossroads of the afterlife, where he must relive his tumultuous past - family struggles, lost love, and a life of excess - to determine whether he belongs Above or Below.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/fc/ef/fceff68ec1e69a30b9e55693e8e447d6.png\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/be42fedf5c2a2c2d3bfb824265214f06.jpg\",\"synopsis\":\"Join us at Everyman Muswell Hill for the UK Premiere of Mickey Angelov's debut film, Dali.\\n\\nWhere would you like to go? A Bulgarian-born, American-raised rapper dies and faces The Gatekeeper at the crossroads of the afterlife, where he must relive his tumultuous past - family struggles, lost love, and a life of excess - to determine whether he belongs Above or Below.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/60c30406af5293baf4b438ca8ba71e48.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Dali - UK Premiere\",\"synopsis\":\"Join us at Everyman Muswell Hill for the UK Premiere of Mickey Angelov's debut film, Dali.\\n\\nWhere would you like to go? A Bulgarian-born, American-raised rapper dies and faces The Gatekeeper at the crossroads of the afterlife, where he must relive his tumultuous past - family struggles, lost love, and a life of excess - to determine whether he belongs Above or Below.\",\"certificate\":null,\"casting\":[\"Nina Singh\",\"Amanda Vilanova\",\"Ebony Aboagye\",\"Mickey Angelov\",\"Joseph Bushell\"],\"direction\":[\"Mickey Angelov\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/60c30406af5293baf4b438ca8ba71e48.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/60c30406af5293baf4b438ca8ba71e48.jpg\"],\"release\":\"2025-10-15T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Independent\"}},{\"id\":\"1000025187\",\"title\":\"Dead of Winter\",\"runtime\":5820,\"genres\":\"Thriller, Action\",\"__typename\":\"Movie\",\"altId\":[\"393423\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/25aed9dd5a91c0251946c4beae99f04a.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/ff/aa/ffaac686b9438fd6c53a1998964f9a68.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/4e/2f/4e2faa2980c11819469d029489547b81.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/f3/be/f3bef2b8b7a6161ded63981081f9f566.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Brian\",\"lastName\":\"Kirk (II)\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emma\",\"lastName\":\"Thompson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Judy\",\"lastName\":\"Greer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marc\",\"lastName\":\"Menchaca\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Laurel\",\"lastName\":\"Marsden\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gaia\",\"lastName\":\"Wise\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lloyd\",\"lastName\":\"Hutchinson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brían F.\",\"lastName\":\"O'Byrne\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-26T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong language, threat, violence, injury detail\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13864\",\"name\":\"Vertigo Films\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Dead of Winter\",\"synopsis\":\"Hit by a blizzard, a grief-stricken loner (Emma Thompson) gets lost among backroads near a Minnesotan lake and stops for help at a remote cabin in the woods. Here she discovers a young woman (Laurel Marsden) kidnapped by a desperate couple (Judy Greer, Marc Menchaca) who are armed and intent on murder. Isolated and without cell service, this unlikely hero realizes she is the woman’s only hope of survival.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/df/0c/df0cc68068caed9e62ec3b6687d31275.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/b1a7eecb96d9727658b8c27347c98cbe.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/25aed9dd5a91c0251946c4beae99f04a.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/32c4153dd77b7b0933963b76de736052.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Dead Of Winter\",\"synopsis\":\"Hit by a blizzard, a grief-stricken loner (Emma Thompson) gets lost among backroads near a Minnesotan lake and stops for help at a remote cabin in the woods. Here she discovers a young woman (Laurel Marsden) kidnapped by a desperate couple (Judy Greer, Marc Menchaca) who are armed and intent on murder. Isolated and without cell service, this unlikely hero realizes she is the woman’s only hope of survival.\",\"certificate\":\"15\",\"casting\":[\"Emma Thompson\",\"Judy Greer\",\"Marc Menchaca\",\"Laurel Marsden\",\"Gaia Wise\",\"Lloyd Hutchinson\",\"Brían F. O'Byrne\"],\"direction\":[\"Brian Kirk (II)\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/32c4153dd77b7b0933963b76de736052.jpg\",\"img/ff/aa/ffaac686b9438fd6c53a1998964f9a68.jpg\",\"img/4e/2f/4e2faa2980c11819469d029489547b81.jpg\",\"img/f3/be/f3bef2b8b7a6161ded63981081f9f566.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/32c4153dd77b7b0933963b76de736052.jpg\",\"https://cms-assets.webediamovies.pro/production/2/b1a7eecb96d9727658b8c27347c98cbe.jpg\"],\"release\":\"2025-09-26T00:00:00.000Z\",\"advisory\":\"strong language, threat, violence, injury detail\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Vertigo Films\"}},{\"id\":\"1000004367\",\"title\":\"Deaf\",\"runtime\":6000,\"genres\":\"Drama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/7e753efa2af9b76c4289ebc01cf51176.jpg\",\"__typename\":\"Movie\",\"altId\":[\"365520\"],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/59/38/5938964a3133237133baf5968aef73a9.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/01/05/01055391fc01bbf1a4a6132819a09176.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c1/71/c1718e96803905b2c2e7e7813cd27afb.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Eva Libertad\",\"lastName\":\"García\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Miriam\",\"lastName\":\"Garlo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Álvaro\",\"lastName\":\"Cervantes\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elena\",\"lastName\":\"Irureta\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joaquín\",\"lastName\":\"Notario\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Erika\",\"lastName\":\"Rubia\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marc\",\"lastName\":\"Blauk\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marc\",\"lastName\":\"Tapia\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Agustín\",\"lastName\":\"Otón\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Oti\",\"lastName\":\"Manzano\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sofía\",\"lastName\":\"López\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-12T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"infrequent strong language, upsetting scenes\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[],\"distributors\":[{\"id\":\"679\",\"name\":\"Curzon\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Deaf\",\"synopsis\":\"Deaf follows a young deaf woman and her hearing partner, who are expecting a baby. Unable to know whether their child will be hearing or deaf until birth, it’s a beautiful, nuanced depiction of their journey. The clever use of sound and silence immerses us in Ángela's experience and explores the struggles she faces, given the inadequacies of the world for deaf people.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/365520_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/365520_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/d7/7d/d77d1aa7eafb4e8ba08b2806bb9e3dcc.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/7e753efa2af9b76c4289ebc01cf51176.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/cf4cc6aff7c9258ad268b2206591a449.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Sorda\",\"synopsis\":\"Deaf follows a young deaf woman and her hearing partner, who are expecting a baby. Unable to know whether their child will be hearing or deaf until birth, it’s a beautiful, nuanced depiction of their journey. The clever use of sound and silence immerses us in Ángela's experience and explores the struggles she faces, given the inadequacies of the world for deaf people.\",\"certificate\":\"12A\",\"casting\":[\"Miriam Garlo\",\"Álvaro Cervantes\",\"Elena Irureta\",\"Joaquín Notario\",\"Erika Rubia\",\"Marc Blauk\",\"Marc Tapia\",\"Agustín Otón\",\"Oti Manzano\",\"Sofía López\"],\"direction\":[\"Eva Libertad García\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/cf4cc6aff7c9258ad268b2206591a449.jpg\",\"img/59/38/5938964a3133237133baf5968aef73a9.jpg\",\"img/01/05/01055391fc01bbf1a4a6132819a09176.jpg\",\"img/c1/71/c1718e96803905b2c2e7e7813cd27afb.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/cf4cc6aff7c9258ad268b2206591a449.jpg\"],\"release\":\"2025-09-12T00:00:00.000Z\",\"advisory\":\"infrequent strong language, upsetting scenes\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/365520_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/365520_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Curzon\"}},{\"id\":\"1000028403\",\"title\":\"Deeper Into Movies: Ken Loach and Mike Leigh in Conversation\",\"runtime\":null,\"genres\":\"\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8797cfc3bee2f5776664b0e95d8fbdfa.jpg\",\"__typename\":\"Movie\",\"altId\":[\"397404\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"directors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"releases\":[{\"releasedAt\":\"2025-08-27T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Deeper Into Movies: A Passage Into England + Live Q&A\",\"synopsis\":\"Across decades, both directors have carved out uncompromising bodies of work rooted in working-class life — capturing the quiet dignity, frustrations, humour, and resilience of everyday people with rare authenticity. Whether through Leigh’s improvisational, actor-led explorations of character or Loach’s fierce political clarity and social realism, their films have shaped how we understand Britain on screen. This conversation offers a chance to witness two visionary directors reflect on their parallel careers and longstanding friendship.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Deeper Into Movies: Ken Loach and Mike Leigh in Conversation\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/8797cfc3bee2f5776664b0e95d8fbdfa.jpg\",\"synopsis\":\"Across decades, both directors (Ken Loach & Mike Leigh) have carved out uncompromising bodies of work rooted in working-class life — capturing the quiet dignity, frustrations, humour, and resilience of everyday people with rare authenticity. Whether through Leigh’s improvisational, actor-led explorations of character or Loach’s fierce political clarity and social realism, their films have shaped how we understand Britain on screen.\\n\\nThis conversation, hosted by Geoff Andrew, offers a chance to witness two visionary directors reflect on their parallel careers and longstanding friendship.\\n\\nAll ticket sales support the cinema charity 'Cinema For All'.\\n\\n5:00pm - Doors open \\n5:30pm - Event begins \\n6:30pm - Event ends \",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/0b0569a588d456a723b4dd2bcb83ecb4.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Deeper Into Movies: A Passage Into England + Live Q&A\",\"synopsis\":\"Across decades, both directors (Ken Loach & Mike Leigh) have carved out uncompromising bodies of work rooted in working-class life — capturing the quiet dignity, frustrations, humour, and resilience of everyday people with rare authenticity. Whether through Leigh’s improvisational, actor-led explorations of character or Loach’s fierce political clarity and social realism, their films have shaped how we understand Britain on screen.\\n\\nThis conversation, hosted by Geoff Andrew, offers a chance to witness two visionary directors reflect on their parallel careers and longstanding friendship.\\n\\nAll ticket sales support the cinema charity 'Cinema For All'.\\n\\n5:00pm - Doors open \\n5:30pm - Event begins \\n6:30pm - Event ends \",\"certificate\":null,\"casting\":[],\"direction\":[],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/0b0569a588d456a723b4dd2bcb83ecb4.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/0b0569a588d456a723b4dd2bcb83ecb4.jpg\"],\"release\":\"2025-08-27T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000029416\",\"title\":\"Demon Slayer: Kimetsu no Yaiba Infinity Castle (Dubbed)\",\"runtime\":9300,\"genres\":\"Animation\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/057589557c439497e1d0702a215399bb.jpg\",\"__typename\":\"Movie\",\"altId\":[\"398716\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Haruo\",\"lastName\":\"Sotozaki\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Natsuki\",\"lastName\":\"Hanae\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Yoshitsugu\",\"lastName\":\"Matsuoka\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Hiro\",\"lastName\":\"Shimono\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2025-09-12T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong violence, bloody images\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Demon Slayer: Kimetsu no Yaiba Infinity Castle (Dubbed)\",\"synopsis\":\"Tanjiro Kamado -- a boy who joined an organization dedicated to hunting down demons called the Demon Slayer Corps after his younger sister Nezuko was turned into a demon. While growing stronger and deepening his friendships and bonds with fellow corps members, Tanjiro has battled many demons with his comrades -- Zenitsu Agatsuma and Inosuke Hashibira. Along the way, his journey has led him to fight alongside the Demon Slayer Corps' highest-ranking swordsmen, the Hashira, including Flame Hashira Kyojuro Rengoku aboard the Mugen Train, Sound Hashira Tengen Uzui within the Entertainment District, as well as Mist Hashira Muichiro Tokito and Love Hashira Mitsuri Kanroji at the Swordsmith Village. As the Demon Slayer Corps members and Hashira engaged in a group strength training program, the Hashira Training, in preparation for the forthcoming battle against the demons, Muzan Kibutsuji appears at the Ubuyashiki Mansion. With the head of the Demon Corps in danger, Tanjiro and the Hashira rush to the headquarters but are plunged into a deep descent to a mysterious space by the hands of Muzan Kibutsuji. The destination of where Tanjiro and Demon Slayer Corps have fallen is the demons' stronghold -- the Infinity Castle. And so, the battleground is set as the final battle between the Demon Slayer Corps and the demons ignites.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/04/7c/047c3d5e7b8d2e66cee118bf562fcf8b.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/eb4468df1e0ce8ffa770bbb63578c65c.jpg\",\"__typename\":\"BOAppImage\"}]}},\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/057589557c439497e1d0702a215399bb.jpg\",\"synopsis\":\"Tanjiro Kamado -- a boy who joined an organisation dedicated to hunting down demons called the Demon Slayer Corps after his younger sister Nezuko was turned into a demon. \\n\\nWhile growing stronger and deepening his friendships and bonds with fellow corps members, Tanjiro has battled many demons with his comrades -- Zenitsu Agatsuma and Inosuke Hashibira. Along the way, his journey has led him to fight alongside the Demon Slayer Corps' highest-ranking swordsmen, the Hashira, including Flame Hashira Kyojuro Rengoku aboard the Mugen Train, Sound Hashira Tengen Uzui within the Entertainment District, as well as Mist Hashira Muichiro Tokito and Love Hashira Mitsuri Kanroji at the Swordsmith Village. \\n\\nAs the Demon Slayer Corps members and Hashira engaged in a group strength training program, the Hashira Training, in preparation for the forthcoming battle against the demons, Muzan Kibutsuji appears at the Ubuyashiki Mansion. With the head of the Demon Corps in danger, Tanjiro and the Hashira rush to the headquarters but are plunged into a deep descent to a mysterious space by the hands of Muzan Kibutsuji. \\n\\nThe destination where Tanjiro and Demon Slayer Corps have fallen is the demons' stronghold -- the Infinity Castle. And so, the battleground is set as the final battle between the Demon Slayer Corps and the demons ignites.\\n\\nThis screening of Demon Slayer: Kimetsu no Yaiba Infinity Castle is dubbed in English.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Demon Slayer: Kimetsu no Yaiba Infinity Castle (Dubbed)\",\"synopsis\":\"Tanjiro Kamado -- a boy who joined an organisation dedicated to hunting down demons called the Demon Slayer Corps after his younger sister Nezuko was turned into a demon. \\n\\nWhile growing stronger and deepening his friendships and bonds with fellow corps members, Tanjiro has battled many demons with his comrades -- Zenitsu Agatsuma and Inosuke Hashibira. Along the way, his journey has led him to fight alongside the Demon Slayer Corps' highest-ranking swordsmen, the Hashira, including Flame Hashira Kyojuro Rengoku aboard the Mugen Train, Sound Hashira Tengen Uzui within the Entertainment District, as well as Mist Hashira Muichiro Tokito and Love Hashira Mitsuri Kanroji at the Swordsmith Village. \\n\\nAs the Demon Slayer Corps members and Hashira engaged in a group strength training program, the Hashira Training, in preparation for the forthcoming battle against the demons, Muzan Kibutsuji appears at the Ubuyashiki Mansion. With the head of the Demon Corps in danger, Tanjiro and the Hashira rush to the headquarters but are plunged into a deep descent to a mysterious space by the hands of Muzan Kibutsuji. \\n\\nThe destination where Tanjiro and Demon Slayer Corps have fallen is the demons' stronghold -- the Infinity Castle. And so, the battleground is set as the final battle between the Demon Slayer Corps and the demons ignites.\\n\\nThis screening of Demon Slayer: Kimetsu no Yaiba Infinity Castle is dubbed in English.\",\"certificate\":\"15\",\"casting\":[\"Natsuki Hanae\",\"Yoshitsugu Matsuoka\",\"Hiro Shimono\"],\"direction\":[\"Haruo Sotozaki\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/eb4468df1e0ce8ffa770bbb63578c65c.jpg\"],\"release\":\"2025-09-12T00:00:00.000Z\",\"advisory\":\"strong violence, bloody images\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures UK\"}},{\"id\":\"1000017251\",\"title\":\"Demon Slayer: Kimetsu no Yaiba Infinity Castle (Subtitled)\",\"runtime\":9300,\"genres\":\"Animation\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/32c2124c3e243f33a8c172330209abfb.jpg\",\"__typename\":\"Movie\",\"altId\":[\"382960\",\"387956\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/fe/b6/feb68b57fa80cc7cf7ac7c634d8a3c2e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/a5/0f/a50f7351a3d7e2a9e85e55c09b1e3