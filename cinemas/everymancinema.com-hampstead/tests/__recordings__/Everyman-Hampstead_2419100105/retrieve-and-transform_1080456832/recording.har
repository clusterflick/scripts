\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Zazie\",\"lastName\":\"Beetz\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Danielle\",\"lastName\":\"Brooks\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Natasha\",\"lastName\":\"Lyonne\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Maria\",\"lastName\":\"Bakalova\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Alex\",\"lastName\":\"Borstein\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2025-07-25T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"very mild bad language, threat, rude humour\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[],\"distributors\":[{\"id\":\"26962\",\"name\":\"Universal Pictures International\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"The Bad Guys 2\",\"synopsis\":\"The Bad Guys are struggling to find trust and acceptance in their newly minted lives as Good Guys, when they are pulled out of retirement and forced to do 'one last job' by an all-female squad of criminals.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/359021_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/359021_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/52/4a/524afbd8129094004b4cf36c012fe58a.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/aab4abab8cd9daa74a4ffcee34e81477.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/34340f844b555915b17b52cc993f93b9.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/6ec3d98eb0ce981d4a971c5853a1822f.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Bad Guys 2\",\"synopsis\":\"The Bad Guys are struggling to find trust and acceptance in their newly minted lives as Good Guys, when they are pulled out of retirement and forced to do 'one last job' by an all-female squad of criminals.\",\"certificate\":\"PG\",\"casting\":[\"Sam Rockwell\",\"Craig Robinson\",\"Anthony Ramos\",\"Awkwafina\",\"Marc Maron\",\"Zazie Beetz\",\"Danielle Brooks\",\"Natasha Lyonne\",\"Maria Bakalova\",\"Alex Borstein\"],\"direction\":[\"Pierre Perifel\"],\"coDirection\":[\"Juan Pablo Sans\"],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/6ec3d98eb0ce981d4a971c5853a1822f.jpg\",\"img/eb/dd/ebddfd72b8a13cfa2e4d0aa713f6ed75.jpg\",\"img/04/b0/04b0c2ee5727672be86d7fe95354f061.jpg\",\"img/98/ac/98ac0103e32fb1f6beff8587b7d96c2a.jpg\",\"img/9f/79/9f79a0566b2ee82ef9b883031e797789.JPG\",\"img/d1/44/d144d2b83372307732c5c1895c88ff0a.JPG\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/6ec3d98eb0ce981d4a971c5853a1822f.jpg\",\"https://cms-assets.webediamovies.pro/production/2/aab4abab8cd9daa74a4ffcee34e81477.jpg\"],\"release\":\"2025-07-25T00:00:00.000Z\",\"advisory\":\"very mild bad language, threat, rude humour\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/359021_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/359021_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Universal Pictures International\"}},{\"id\":\"309613\",\"title\":\"The Conjuring: Last Rites\",\"runtime\":8100,\"genres\":\"Horror\",\"__typename\":\"Movie\",\"altId\":[\"369298\",\"388381\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c3e34458b3baef4388f0d5e4a08425e4.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/18/80/18808db779c8bc2d0aba491624ab4f88.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/f4/25/f4256f7fa2d31cf0abaf2df305ce4caa.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/61/32/61329d1938382320cc7e836d5f0b2dcf.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/8d/dc/8ddcb49f500cfccdb5c98603f7819370.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/57/3d/573dd2db1e1000605d04138aaf8cd069.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/85/31/853175d2e31b52c2bc08fba9a54ac15b.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/51/f9/51f9404534bc584afb0f49d256149754.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Michael\",\"lastName\":\"Chaves\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Vera\",\"lastName\":\"Farmiga\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Patrick\",\"lastName\":\"Wilson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mia\",\"lastName\":\"Tomlinson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ben\",\"lastName\":\"Hardy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Steve\",\"lastName\":\"Coulter\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rebecca\",\"lastName\":\"Calder\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elliot\",\"lastName\":\"Cowan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kila\",\"lastName\":\"Lord Cassidy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Beau\",\"lastName\":\"Gadsdon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tilly\",\"lastName\":\"Walker\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-05T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong horror, violence, injury detail\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"The Conjuring: Last Rites\",\"synopsis\":\"From New Line Cinema comes the ninth entry in the more than $2 billion theatrical Conjuring universe, The Conjuring: Last Rites, directed by franchise veteran Michael Chaves and produced by franchise architects James Wan and Peter Safran.\\n\\nThe Conjuring: Last Rites delivers another thrilling chapter of the iconic Conjuring cinematic universe, based on real events. Vera Farmiga and Patrick Wilson reunite for one last case as renowned, real-life paranormal investigators Ed and Lorraine Warren in a powerful and spine-chilling addition to the global box office-breaking franchise.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/369298_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/369298_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/9e/3f/9e3f56ca4fd1db0e31f626d54f88cf5f.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/7f84816006ffe1ad3a1eea88713eb0dd.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/c3e34458b3baef4388f0d5e4a08425e4.jpg\",\"synopsis\":\"In 1986, the Smurl family is terrorised by disembodied voices, violent attacks, and a dark presence that won’t relent. Desperate for help, Ed and Lorraine Warren are called in to confront the evil. What follows is a harrowing battle of courage, faith, and survival as darkness closes in.\\n\\nThe Conjuring: Last Rites delivers another thrilling chapter of the iconic Conjuring cinematic universe, based on real events. Vera Farmiga and Patrick Wilson reunite for one last case as renowned, real-life paranormal investigators Ed and Lorraine Warren in a powerful and spine-chilling addition to the global box office-breaking franchise.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/ee207abc7c40dd1ab2b4d50ea39926e3.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Conjuring: Last Rites\",\"synopsis\":\"In 1986, the Smurl family is terrorised by disembodied voices, violent attacks, and a dark presence that won’t relent. Desperate for help, Ed and Lorraine Warren are called in to confront the evil. What follows is a harrowing battle of courage, faith, and survival as darkness closes in.\\n\\nThe Conjuring: Last Rites delivers another thrilling chapter of the iconic Conjuring cinematic universe, based on real events. Vera Farmiga and Patrick Wilson reunite for one last case as renowned, real-life paranormal investigators Ed and Lorraine Warren in a powerful and spine-chilling addition to the global box office-breaking franchise.\",\"certificate\":\"15\",\"casting\":[\"Vera Farmiga\",\"Patrick Wilson\",\"Mia Tomlinson\",\"Ben Hardy\",\"Steve Coulter\",\"Rebecca Calder\",\"Elliot Cowan\",\"Kila Lord Cassidy\",\"Beau Gadsdon\",\"Tilly Walker\"],\"direction\":[\"Michael Chaves\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/ee207abc7c40dd1ab2b4d50ea39926e3.jpg\",\"img/18/80/18808db779c8bc2d0aba491624ab4f88.jpg\",\"img/f4/25/f4256f7fa2d31cf0abaf2df305ce4caa.jpg\",\"img/61/32/61329d1938382320cc7e836d5f0b2dcf.jpg\",\"img/8d/dc/8ddcb49f500cfccdb5c98603f7819370.jpg\",\"img/57/3d/573dd2db1e1000605d04138aaf8cd069.jpg\",\"img/85/31/853175d2e31b52c2bc08fba9a54ac15b.jpg\",\"img/51/f9/51f9404534bc584afb0f49d256149754.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/ee207abc7c40dd1ab2b4d50ea39926e3.jpg\",\"https://cms-assets.webediamovies.pro/production/2/7f84816006ffe1ad3a1eea88713eb0dd.jpg\"],\"release\":\"2025-09-05T00:00:00.000Z\",\"advisory\":\"strong horror, violence, injury detail\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/369298_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/369298_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"}},{\"id\":\"9955\",\"title\":\"The Conversation\",\"runtime\":6780,\"genres\":\"Thriller, Drama, Spy\",\"__typename\":\"Movie\",\"altId\":[\"26317\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4f59210f0769f314a59c8da7b878b9f0.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/03/14/19884209.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/03/14/19884208.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/03/14/19884207.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/65/17/63/18835399.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/02/75/93/027593_ph1.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/210/128/21012837_20130617122849567.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/210/128/21012838_20130617122850052.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/210/128/21012839_20130617122850286.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/210/128/21012840_20130617122850489.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/210/128/21012841_20130617122850645.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Francis Ford\",\"lastName\":\"Coppola\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gene\",\"lastName\":\"Hackman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Cazale\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Allen\",\"lastName\":\"Garfield\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Frederic\",\"lastName\":\"Forrest\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Harrison\",\"lastName\":\"Ford\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Teri\",\"lastName\":\"Garr\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cindy\",\"lastName\":\"Williams\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Duvall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Phoebe\",\"lastName\":\"Alexander\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Shields\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2011-10-31T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"Contains infrequent moderate violence and language\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[],\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}]},{\"releasedAt\":\"2025-12-04T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"moderate violence, language, discriminatory terms\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[],\"distributors\":[{\"id\":\"32481\",\"name\":\"Studio Canal\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"The Conversation\",\"synopsis\":\"Lonely wiretapping expert Harry Caul (Gene Hackman) is hired to record a seemingly innocuous conversation between two lovers (Frederick Forsythe and Cindy Williams). Upon re-hearing the tapes, however, Caul believes he may be putting the couple in danger if he turns the material over to his client (Robert Duvall). But what one hears can ultimately turn out to be quite different from what was actually recorded.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/08/02/0802000d870cdda6457fae83427cdd1e.png\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/4f59210f0769f314a59c8da7b878b9f0.jpg\",\"synopsis\":\"Selected by the Sound Branch, Everyman presents: The Conversation\\n\\nSurveillance expert Harry Caul (Gene Hackman) is hired by a mysterious client's brusque aide (Harrison Ford) to tail a young couple, Mark (Frederic Forrest) and Ann (Cindy Williams). Tracking the pair through San Francisco's Union Square, Caul and his associate Stan (John Cazale) manage to record a cryptic conversation between them. Tormented by memories of a previous case that ended badly, Caul becomes obsessed with the resulting tape, trying to determine if the couple are in danger.\\n\\nFrancis Ford Coppola wrote and directed this unnerving paranoid thriller between production of his two Godfather films, with Gene Hackman as a San Francisco surveillance expert who accidentally uncovers evidence of an imminent murder. Few films have featured sound as such a key component of their storyline, and three-time Oscar winner Walter Murch (Apocalypse Now, The English Patient) served as both supervising film editor and sound mixer, working in both capacities to build remarkable tension. The film earned\\n\\nOscar nominations for Best Picture, Coppola’s original screenplay, and Sound (Murch, Arthur Rochester).\\n\\nPresented in 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 4 December.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/becfaff7bd5cc42a41bb0d3486e86fbd.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Conversation\",\"synopsis\":\"Selected by the Sound Branch, Everyman presents: The Conversation\\n\\nSurveillance expert Harry Caul (Gene Hackman) is hired by a mysterious client's brusque aide (Harrison Ford) to tail a young couple, Mark (Frederic Forrest) and Ann (Cindy Williams). Tracking the pair through San Francisco's Union Square, Caul and his associate Stan (John Cazale) manage to record a cryptic conversation between them. Tormented by memories of a previous case that ended badly, Caul becomes obsessed with the resulting tape, trying to determine if the couple are in danger.\\n\\nFrancis Ford Coppola wrote and directed this unnerving paranoid thriller between production of his two Godfather films, with Gene Hackman as a San Francisco surveillance expert who accidentally uncovers evidence of an imminent murder. Few films have featured sound as such a key component of their storyline, and three-time Oscar winner Walter Murch (Apocalypse Now, The English Patient) served as both supervising film editor and sound mixer, working in both capacities to build remarkable tension. The film earned\\n\\nOscar nominations for Best Picture, Coppola’s original screenplay, and Sound (Murch, Arthur Rochester).\\n\\nPresented in 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 4 December.\",\"certificate\":\"12A\",\"casting\":[\"Gene Hackman\",\"John Cazale\",\"Allen Garfield\",\"Frederic Forrest\",\"Harrison Ford\",\"Teri Garr\",\"Cindy Williams\",\"Robert Duvall\",\"Phoebe Alexander\",\"Robert Shields\"],\"direction\":[\"Francis Ford Coppola\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/becfaff7bd5cc42a41bb0d3486e86fbd.jpg\",\"medias/nmedia/18/87/03/14/19884209.jpg\",\"medias/nmedia/18/87/03/14/19884208.jpg\",\"medias/nmedia/18/87/03/14/19884207.jpg\",\"medias/nmedia/18/65/17/63/18835399.jpg\",\"medias/02/75/93/027593_ph1.jpg\",\"pictures/210/128/21012837_20130617122849567.jpg\",\"pictures/210/128/21012838_20130617122850052.jpg\",\"pictures/210/128/21012839_20130617122850286.jpg\",\"pictures/210/128/21012840_20130617122850489.jpg\",\"pictures/210/128/21012841_20130617122850645.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/becfaff7bd5cc42a41bb0d3486e86fbd.jpg\"],\"release\":\"2011-10-31T00:00:00.000Z\",\"advisory\":\"Contains infrequent moderate violence and language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Walt Disney\"}},{\"id\":\"1000031406\",\"title\":\"The Descent (20th Anniversary)\",\"runtime\":5940,\"genres\":\"Horror\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c2842e21ecbfdb4be911467882374c3c.jpg\",\"__typename\":\"Movie\",\"altId\":[\"401202\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Neil\",\"lastName\":\"Marshall\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Molly\",\"lastName\":\"Kayll\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Natalie\",\"lastName\":\"Jackson Mendoza\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Shauna\",\"lastName\":\"Macdonald\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Myanna\",\"lastName\":\"Buring\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alex\",\"lastName\":\"Reid (II)\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Saskia\",\"lastName\":\"Mulder\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nora-Jane\",\"lastName\":\"Noone\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Craig\",\"lastName\":\"Conway\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Oliver\",\"lastName\":\"Milburn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Leslie\",\"lastName\":\"Simpson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-24T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Descent (20th Anniversary)\",\"synopsis\":\"In a remote mountain range, six girlfriends meet for their yearly adventure, a caving trip into the arteries of the earth. The group makes their way through the remote cave system, enjoying the hazardous but beautiful surroundings. Then, deep inside the cave, disaster strikes when their route back to the surface is blocked by a rock fall. When they learn that Juno, always pushing herself that little bit further, has brought them to an unexplored cave, and that no one is coming to rescue them, the group starts to splinter. Left with no other option, they push on through the cave, praying for another exit. The women battle through this harsh underground world, pitting their strength and determination against each new challenge. Unbeknownst to them, there is something else lurking under the earth, a race of monstrous creatures hidden from the light, evolved to live perfectly in the dark. As the friends realize they have become prey, they are forced to unleash their most primal instincts to face the creatures. As old wounds break open and loyalties disintegrate, the women realize the horrible truth-they have most to fear from one another.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/c2842e21ecbfdb4be911467882374c3c.jpg\",\"synopsis\":\"A year after a severe emotional trauma, Sarah (Shauna Macdonald) goes to North Carolina to spend some time exploring caves with her friends; after descending underground, the women find strange cave paintings and evidence of an earlier expedition, then learn they are not alone: Underground predators inhabit the crevasses, and they have a taste for human flesh.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/c3ffbe56017171788b5d5ced4a683aec.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Descent (20th Anniversary)\",\"synopsis\":\"A year after a severe emotional trauma, Sarah (Shauna Macdonald) goes to North Carolina to spend some time exploring caves with her friends; after descending underground, the women find strange cave paintings and evidence of an earlier expedition, then learn they are not alone: Underground predators inhabit the crevasses, and they have a taste for human flesh.\",\"certificate\":null,\"casting\":[\"Molly Kayll\",\"Natalie Jackson Mendoza\",\"Shauna Macdonald\",\"Myanna Buring\",\"Alex Reid (II)\",\"Saskia Mulder\",\"Nora-Jane Noone\",\"Craig Conway\",\"Oliver Milburn\",\"Leslie Simpson\"],\"direction\":[\"Neil Marshall\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/c3ffbe56017171788b5d5ced4a683aec.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/c3ffbe56017171788b5d5ced4a683aec.jpg\"],\"release\":\"2025-10-24T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"180\",\"title\":\"The Elephant Man\",\"runtime\":7500,\"genres\":\"Drama, Biopic\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/cd1392413580c7abd3facd6ad618ce95.jpg\",\"__typename\":\"Movie\",\"altId\":[\"27763\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887477.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887476.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887475.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887474.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887473.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/90/89/18835878.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/90/89/18835876.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887472.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887471.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887470.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"David\",\"lastName\":\"Lynch\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anthony\",\"lastName\":\"Hopkins\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Hurt\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anne\",\"lastName\":\"Bancroft\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Gielgud\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Wendy\",\"lastName\":\"Hiller\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Freddie\",\"lastName\":\"Jones\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hannah\",\"lastName\":\"Gordon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Elphick\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lesley\",\"lastName\":\"Dunlop\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Helen\",\"lastName\":\"Ryan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2020-03-13T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"Contains mild horror and violence\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[],\"distributors\":[{\"id\":\"9447\",\"name\":\"StudioCanal UK\",\"__typename\":\"Company\"}]},{\"releasedAt\":\"2026-01-15T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"moderate threat, upsetting scenes, injury detail\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[],\"distributors\":[{\"id\":\"32481\",\"name\":\"Studio Canal\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"The Elephant Man\",\"synopsis\":\"John Hunt starts as the elephant man, John Merrick, in this moving and unforgettable true story of cruelty, humanity and survival. Merrick, a man affected with a terrible disability, is shunned by Victorian Society. An ambitious young doctor (Hopkins) sets out to help him, and discovers a man of sensibility and kindness beneath the surface.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/cd1392413580c7abd3facd6ad618ce95.jpg\",\"synopsis\":\"Selected by the Makeup Artists and Hairstylists Branch, Everyman presents: The Elephant Man\\n\\nJohn Hunt stars as the Elephant Man, John Merrick, in this moving and unforgettable true story of cruelty, humanity, and survival. Merrick, a man affected with a terrible disability, is shunned by Victorian Society. An ambitious young doctor (Hopkins) sets out to help him and discovers a man of sensibility and kindness beneath the surface.\\n\\nJohn Hurt gave a heartrending, Oscar-nominated performance as the title character in The Elephant Man with the aid of elaborate prosthetic makeup by Christopher Tucker that accurately recreated the unusual features of the real-life Joseph Merrick. The film was the first “mainstream” effort from director David Lynch, who brought his distinctive sensibility and striking visual style to this moving biopic, which featured widescreen black-and-white cinematography by Freddie Francis (Glory). \\n\\nPresented in 2k.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/eee5e4cd6541f9a9282b974f2afb8832.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Elephant Man\",\"synopsis\":\"Selected by the Makeup Artists and Hairstylists Branch, Everyman presents: The Elephant Man\\n\\nJohn Hunt stars as the Elephant Man, John Merrick, in this moving and unforgettable true story of cruelty, humanity, and survival. Merrick, a man affected with a terrible disability, is shunned by Victorian Society. An ambitious young doctor (Hopkins) sets out to help him and discovers a man of sensibility and kindness beneath the surface.\\n\\nJohn Hurt gave a heartrending, Oscar-nominated performance as the title character in The Elephant Man with the aid of elaborate prosthetic makeup by Christopher Tucker that accurately recreated the unusual features of the real-life Joseph Merrick. The film was the first “mainstream” effort from director David Lynch, who brought his distinctive sensibility and striking visual style to this moving biopic, which featured widescreen black-and-white cinematography by Freddie Francis (Glory). \\n\\nPresented in 2k.\",\"certificate\":\"PG\",\"casting\":[\"Anthony Hopkins\",\"John Hurt\",\"Anne Bancroft\",\"John Gielgud\",\"Wendy Hiller\",\"Freddie Jones\",\"Hannah Gordon\",\"Michael Elphick\",\"Lesley Dunlop\",\"Helen Ryan\"],\"direction\":[\"David Lynch\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/eee5e4cd6541f9a9282b974f2afb8832.jpg\",\"medias/nmedia/18/87/06/76/19887477.jpg\",\"medias/nmedia/18/87/06/76/19887476.jpg\",\"medias/nmedia/18/87/06/76/19887475.jpg\",\"medias/nmedia/18/87/06/76/19887474.jpg\",\"medias/nmedia/18/87/06/76/19887473.jpg\",\"medias/nmedia/18/35/90/89/18835878.jpg\",\"medias/nmedia/18/35/90/89/18835876.jpg\",\"medias/nmedia/18/87/06/76/19887472.jpg\",\"medias/nmedia/18/87/06/76/19887471.jpg\",\"medias/nmedia/18/87/06/76/19887470.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/eee5e4cd6541f9a9282b974f2afb8832.jpg\"],\"release\":\"2020-03-13T00:00:00.000Z\",\"advisory\":\"Contains mild horror and violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"StudioCanal UK\"}},{\"id\":\"226116\",\"title\":\"The Fantastic Four: First Steps\",\"runtime\":6900,\"genres\":\"Fantasy, Action\",\"__typename\":\"Movie\",\"altId\":[\"338995\",\"388379\",\"393508\",\"393509\"],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"poster\":\"https://cms-assets.webediamovies.pro/production/279/de68e35d8034857ba5552833796c4fb0.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/24/e2/24e24803eb7560b7983d8c7efa16e120.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/fb/ea/fbea9ef86b737022fa4ac68a5be00076.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c1/92/c19206e76f634742408295f747779b5f.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/36/33/3633b5d6692d743da15b36129c54ac8d.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/4a/e2/4ae24d026dddf0854165eb563c512741.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/5a/6f/5a6f8b73c42b3b0a914a0cd6ce43825f.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/52/50/52508c51e2faac26fb63e8b89a03a50f.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/f4/1c/f41cefc095d7c850b7268969767b1478.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/48/22/48221f8b5685d9caa0276655ef359370.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/97/b9/97b9a4f4a3e50ce90786d8dc61d30f0a.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Matt\",\"lastName\":\"Shakman\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Pedro\",\"lastName\":\"Pascal\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Vanessa\",\"lastName\":\"Kirby\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joseph\",\"lastName\":\"Quinn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ebon\",\"lastName\":\"Moss-Bachrach\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ralph\",\"lastName\":\"Ineson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Julia\",\"lastName\":\"Garner\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Paul Walter\",\"lastName\":\"Hauser\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Natasha\",\"lastName\":\"Lyonne\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sarah\",\"lastName\":\"Niles\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Matthew\",\"lastName\":\"Wood\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2025-07-24T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"moderate threat, violence\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[],\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"The Fantastic Four: First Steps\",\"synopsis\":\"Set against the vibrant backdrop of a 1960s-inspired, retro-futuristic world, Marvel Studios' THE FANTASTIC FOUR: FIRST STEPS introduces Marvel's First Family--Reed Richards/Mister Fantastic (Pedro Pascal), Sue Storm/Invisible Woman (Vanessa Kirby), Johnny Storm/Human Torch (Joseph Quinn) and Ben Grimm/The Thing (Ebon Moss-Bachrach) as they face their most daunting challenge yet. Forced to balance their roles as heroes with the strength of their family bond, they must defend Earth from a ravenous space god called Galactus (Ralph Ineson) and his enigmatic Herald, Silver Surfer (Julia Garner). And if Galactus' plan to devour the entire planet and everyone on it weren't bad enough, it suddenly gets very personal.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/338995_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/338995_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/7d/b4/7db42c3024b0291294ec2681e7d7471b.jpeg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/77eeedffc675dc62cabcfa0fa633657b.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/de68e35d8034857ba5552833796c4fb0.jpg\",\"synopsis\":\"Forced to balance their roles as heroes with the strength of their family bond, the Fantastic Four must defend Earth from a ravenous space god called Galactus and his enigmatic Herald, Silver Surfer.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/8544d2cc234eb3b195b0b2e7d8ec4a85.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Fantastic Four: First Steps\",\"synopsis\":\"Forced to balance their roles as heroes with the strength of their family bond, the Fantastic Four must defend Earth from a ravenous space god called Galactus and his enigmatic Herald, Silver Surfer.\",\"certificate\":\"12A\",\"casting\":[\"Pedro Pascal\",\"Vanessa Kirby\",\"Joseph Quinn\",\"Ebon Moss-Bachrach\",\"Ralph Ineson\",\"Julia Garner\",\"Paul Walter Hauser\",\"Natasha Lyonne\",\"Sarah Niles\",\"Matthew Wood\"],\"direction\":[\"Matt Shakman\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/8544d2cc234eb3b195b0b2e7d8ec4a85.jpg\",\"img/24/e2/24e24803eb7560b7983d8c7efa16e120.jpg\",\"img/fb/ea/fbea9ef86b737022fa4ac68a5be00076.jpg\",\"img/c1/92/c19206e76f634742408295f747779b5f.jpg\",\"img/36/33/3633b5d6692d743da15b36129c54ac8d.jpg\",\"img/4a/e2/4ae24d026dddf0854165eb563c512741.jpg\",\"img/5a/6f/5a6f8b73c42b3b0a914a0cd6ce43825f.jpg\",\"img/52/50/52508c51e2faac26fb63e8b89a03a50f.jpg\",\"img/f4/1c/f41cefc095d7c850b7268969767b1478.jpg\",\"img/48/22/48221f8b5685d9caa0276655ef359370.jpg\",\"img/97/b9/97b9a4f4a3e50ce90786d8dc61d30f0a.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/8544d2cc234eb3b195b0b2e7d8ec4a85.jpg\",\"https://cms-assets.webediamovies.pro/production/2/77eeedffc675dc62cabcfa0fa633657b.jpg\"],\"release\":\"2025-07-24T00:00:00.000Z\",\"advisory\":\"moderate threat, violence\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/338995_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/338995_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Walt Disney\"}},{\"id\":\"28201\",\"title\":\"The Godfather: Part II\",\"runtime\":12000,\"genres\":\"Detective, Drama\",\"__typename\":\"Movie\",\"altId\":[\"71112\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/3d4397da893d04ba9614a4fa2667a2cc.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18861224.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18861223.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18861222.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18861221.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18861220.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18660527.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18660525.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18660524.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Francis Ford\",\"lastName\":\"Coppola\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Al\",\"lastName\":\"Pacino\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"De Niro\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Diane\",\"lastName\":\"Keaton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kathleen\",\"lastName\":\"Beller\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ignazio\",\"lastName\":\"Pappalardo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Roman\",\"lastName\":\"Coppola\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sofia\",\"lastName\":\"Coppola\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Megna\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gary\",\"lastName\":\"Kurtz\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sho\",\"lastName\":\"Kosugi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2022-03-04T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong bloody violence, language\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13760\",\"name\":\"Paramount Pictures UK\",\"__typename\":\"Company\"}]},{\"releasedAt\":\"2026-01-08T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong violence, bloody images, domestic abuse\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13760\",\"name\":\"Paramount Pictures UK\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"The Godfather: Part II\",\"synopsis\":\"Continuing saga of the Corleone family as they move to Nevada and make the casino business their major income source under the leadership of the increasingly paranoid and malevolent Michael, whose reign as the \\\"Don\\\" is juxtaposed against the parallel tale of his father's escape from Sicily as a young boy and his subsequent rise to power in New York's Lower East Side during the turn-of-the-century.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/24/7f/247f39bec2d5eb54c44eb870b1aec5a0.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/3d4397da893d04ba9614a4fa2667a2cc.jpg\",\"synopsis\":\"Selected by the Executives Branch, Everyman presents: The Godfather: Part II\\n\\nContinuing saga of the Corleone family as they move to Nevada and make the casino business their major income source under the leadership of the increasingly paranoid and malevolent Michael, whose reign as the \\\"Don\\\" is juxtaposed against the parallel tale of his father's escape from Sicily as a young boy and his subsequent rise to power in New York's Lower East Side during the turn-of-the-century.\\n\\nThe Godfather: Part II is often cited as the rare example of a sequel that equals or even surpasses the original. Both a sequel and a prequel, the film extends the tragic story of Michael Corleone and his family into the late 1950s while looking back at young Vito (Robert De Niro in an Oscar-winning performance) and his experience as an immigrant in New York, in a gorgeously crafted production rich with novelistic detail. \\n\\nPresented in 4k, the feature returns to the big screen at Everyman The Whiteley on Thursday, ? ?.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/425d9104a62854175d49ad9e7f0d4e42.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Godfather: Part II\",\"synopsis\":\"Selected by the Executives Branch, Everyman presents: The Godfather: Part II\\n\\nContinuing saga of the Corleone family as they move to Nevada and make the casino business their major income source under the leadership of the increasingly paranoid and malevolent Michael, whose reign as the \\\"Don\\\" is juxtaposed against the parallel tale of his father's escape from Sicily as a young boy and his subsequent rise to power in New York's Lower East Side during the turn-of-the-century.\\n\\nThe Godfather: Part II is often cited as the rare example of a sequel that equals or even surpasses the original. Both a sequel and a prequel, the film extends the tragic story of Michael Corleone and his family into the late 1950s while looking back at young Vito (Robert De Niro in an Oscar-winning performance) and his experience as an immigrant in New York, in a gorgeously crafted production rich with novelistic detail. \\n\\nPresented in 4k, the feature returns to the big screen at Everyman The Whiteley on Thursday, ? ?.\",\"certificate\":\"15\",\"casting\":[\"Al Pacino\",\"Robert De Niro\",\"Diane Keaton\",\"Kathleen Beller\",\"Ignazio Pappalardo\",\"Roman Coppola\",\"Sofia Coppola\",\"John Megna\",\"Gary Kurtz\",\"Sho Kosugi\"],\"direction\":[\"Francis Ford Coppola\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/425d9104a62854175d49ad9e7f0d4e42.jpg\",\"medias/nmedia/18/35/24/16/18861224.jpg\",\"medias/nmedia/18/35/24/16/18861223.jpg\",\"medias/nmedia/18/35/24/16/18861222.jpg\",\"medias/nmedia/18/35/24/16/18861221.jpg\",\"medias/nmedia/18/35/24/16/18861220.jpg\",\"medias/nmedia/18/35/24/16/18660527.jpg\",\"medias/nmedia/18/35/24/16/18660525.jpg\",\"medias/nmedia/18/35/24/16/18660524.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/425d9104a62854175d49ad9e7f0d4e42.jpg\"],\"release\":\"2022-03-04T00:00:00.000Z\",\"advisory\":\"strong bloody violence, language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Paramount Pictures UK\"}},{\"id\":\"38827\",\"title\":\"The Great Escape\",\"runtime\":10140,\"genres\":\"War movie, Drama\",\"__typename\":\"Movie\",\"altId\":[\"10650\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c80213a8c4133f18caf5b8dc548401fa.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3826355.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3751475.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3782675.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3767075.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3796715.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3812315.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/50/5622128.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/50/5608088.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/50/5594048.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/50/5580008.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"John\",\"lastName\":\"Sturges\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Steve\",\"lastName\":\"McQueen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Charles\",\"lastName\":\"Bronson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Donald\",\"lastName\":\"Pleasence\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"James\",\"lastName\":\"Donald\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"James\",\"lastName\":\"Coburn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hannes\",\"lastName\":\"Messemer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"David\",\"lastName\":\"McCallum\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gordon\",\"lastName\":\"Jackson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Leyton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Angus\",\"lastName\":\"Lennie\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2020-12-18T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[],\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}]},{\"releasedAt\":\"2025-11-13T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"mild violence, language, injury detail\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[],\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"The Great Escape\",\"synopsis\":\"John Sturges dramatisation of the true story of a group of British, American and Canadian POWs who successfully escaped from Stalag Luft III in Upper Silesia in March 1944 is arguably the best World War II adventure film ever made. A host of big-name stars meshes beautifully in this meticulous recreation of the legendary escape. Although this is a film about courage, Sturges wisely takes a low-key approach, leavened with humour, rather than allowing the cast to indulge in macho antics.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/5d/ef/5def2693c01c57164f6fe0e996ed806c.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/c80213a8c4133f18caf5b8dc548401fa.jpg\",\"synopsis\":\"Selected by the Music Branch, Everyman presents: The Great Escape\\n\\nImprisoned during World War II in a German POW camp, a group of Allied soldiers are intent on breaking out, not only to escape, but also to draw Nazi forces away from battle to search for fugitives. Outwitting their captors by digging a tunnel out of the prison grounds, the soldiers find the stakes much higher when escape becomes a reality.\\n\\nSteve McQueen leads a star-studded cast in this fact-based story about a group of Allied soldiers plotting a daring escape from a German POW camp. McQueen’s fellow prisoners include Richard Attenborough, James Garner, Charles Bronson, Donald Pleasence, and James Coburn. Director John Sturges manages to maintain a balance of humor and tension over the film’s epic runtime with the help of Oscar-nominated editing by Ferris Webster. For the film’s music, Sturges reunited with his The Magnificent Seven (1960) composer Elmer Bernstein, whose rousing score features a memorable march that is one of Bernstein’s most popular and enduring melodies. \\n\\nPresented in restored 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 13 November.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/c53bb85b0605dfd86cf460a08e57ee4f.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Great Escape\",\"synopsis\":\"Selected by the Music Branch, Everyman presents: The Great Escape\\n\\nImprisoned during World War II in a German POW camp, a group of Allied soldiers are intent on breaking out, not only to escape, but also to draw Nazi forces away from battle to search for fugitives. Outwitting their captors by digging a tunnel out of the prison grounds, the soldiers find the stakes much higher when escape becomes a reality.\\n\\nSteve McQueen leads a star-studded cast in this fact-based story about a group of Allied soldiers plotting a daring escape from a German POW camp. McQueen’s fellow prisoners include Richard Attenborough, James Garner, Charles Bronson, Donald Pleasence, and James Coburn. Director John Sturges manages to maintain a balance of humor and tension over the film’s epic runtime with the help of Oscar-nominated editing by Ferris Webster. For the film’s music, Sturges reunited with his The Magnificent Seven (1960) composer Elmer Bernstein, whose rousing score features a memorable march that is one of Bernstein’s most popular and enduring melodies. \\n\\nPresented in restored 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 13 November.\",\"certificate\":\"PG\",\"casting\":[\"Steve McQueen\",\"Charles Bronson\",\"Donald Pleasence\",\"James Donald\",\"James Coburn\",\"Hannes Messemer\",\"David McCallum\",\"Gordon Jackson\",\"John Leyton\",\"Angus Lennie\"],\"direction\":[\"John Sturges\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/c53bb85b0605dfd86cf460a08e57ee4f.jpg\",\"pictures/23/09/01/10/51/3826355.jpg\",\"pictures/23/09/01/10/51/3751475.jpg\",\"pictures/23/09/01/10/51/3782675.jpg\",\"pictures/23/09/01/10/51/3767075.jpg\",\"pictures/23/09/01/10/51/3796715.jpg\",\"pictures/23/09/01/10/51/3812315.jpg\",\"pictures/23/09/01/10/50/5622128.jpg\",\"pictures/23/09/01/10/50/5608088.jpg\",\"pictures/23/09/01/10/50/5594048.jpg\",\"pictures/23/09/01/10/50/5580008.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/c53bb85b0605dfd86cf460a08e57ee4f.jpg\"],\"release\":\"2020-12-18T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"1000005954\",\"title\":\"The Immortals: The Wonders Of The Museo Egizio\",\"runtime\":5700,\"genres\":\"Documentary\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/622f14617667040c538b51b4b0325a13.jpg\",\"__typename\":\"Movie\",\"altId\":[\"367911\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[\"https://all.web.img.acsta.net/img/1a/b2/1ab2879b4ff794e257fc25abf3e0975b.jpg\"],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Michele\",\"lastName\":\"Mally\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Jeremy\",\"lastName\":\"Irons\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2025-10-12T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"1000120866\",\"name\":\"Source Entertainment\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"The Immortals: The Wonders Of The Museo Egizio\",\"synopsis\":\"Kha, architect and builder of tombs for the pharaohs, has to undertake the journey to the Underworld, amid a thousand dangers. Eternal life is at stake, but the risk is ending up being dissolved into cosmic nothingness. Telling us the story of his adventure is Jeremy Irons. His words take us inside the secret world of Egyptian mythology, interweaving the story with the history of the Museo Egizio in Turin. Along the Nile, among the magnificent monuments of Giza, Luxor, Karnak, in the Valley of the Kings and the workers’ village of Deir el-Medina, the story told by Irons follows the tracks of Italian explorers and archaeologists in the places where they collected the most important pieces making up the Turin collection. From Ramesses II in Turin, to the treasure of Tutankhamun, the bust of Nefertiti, the Red Scribe in the Louvre, and the Rosetta Stone in London, this documentary is also a journey among the most beautiful archaeological finds Egypt has left us.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/34/54/34546300f5ce08fbbcc5f79993a577a2.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/622f14617667040c538b51b4b0325a13.jpg\",\"synopsis\":\"Kha, architect and builder of tombs for the pharaohs, has to undertake the journey to the Underworld, amid a thousand dangers. Eternal life is at stake, but the risk is ending up being dissolved into cosmic nothingness.  Telling us the story of his adventure is Jeremy Irons.\\n\\nHis words take us inside the secret world of Egyptian mythology, interweaving the story with the history of the Museo Egizio in Turin.  Along the Nile, among the magnificent monuments of Giza, Luxor, Karnak, in the Valley of the Kings and the workers’ village of Deir el-Medina, the story told by Irons follows the tracks of Italian explorers and archaeologists in the places where they collected the most important pieces making up the Turin collection.\\n\\nFrom Ramesses II in Turin, to the treasure of Tutankhamun, the bust of Nefertiti, the Red Scribe in the Louvre, and the Rosetta Stone in London, this documentary is also a journey among the most beautiful archaeological finds Egypt has left us.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/a9387e9276692b3f71e58fac52a25199.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Uomini e Dei: Le meraviglie del Museo Egizio\",\"synopsis\":\"Kha, architect and builder of tombs for the pharaohs, has to undertake the journey to the Underworld, amid a thousand dangers. Eternal life is at stake, but the risk is ending up being dissolved into cosmic nothingness.  Telling us the story of his adventure is Jeremy Irons.\\n\\nHis words take us inside the secret world of Egyptian mythology, interweaving the story with the history of the Museo Egizio in Turin.  Along the Nile, among the magnificent monuments of Giza, Luxor, Karnak, in the Valley of the Kings and the workers’ village of Deir el-Medina, the story told by Irons follows the tracks of Italian explorers and archaeologists in the places where they collected the most important pieces making up the Turin collection.\\n\\nFrom Ramesses II in Turin, to the treasure of Tutankhamun, the bust of Nefertiti, the Red Scribe in the Louvre, and the Rosetta Stone in London, this documentary is also a journey among the most beautiful archaeological finds Egypt has left us.\",\"certificate\":null,\"casting\":[\"Jeremy Irons\"],\"direction\":[\"Michele Mally\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/a9387e9276692b3f71e58fac52a25199.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/a9387e9276692b3f71e58fac52a25199.jpg\"],\"release\":\"2025-10-12T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Source Entertainment\"}},{\"id\":\"21709\",\"title\":\"The Iron Giant\",\"runtime\":5100,\"genres\":\"Animation, Action, Adventure, Science fiction\",\"__typename\":\"Movie\",\"altId\":[\"20682\",\"202598\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ed3239379df1498a4111a1654985a296.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975816.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975815.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975814.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975813.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975812.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975811.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975810.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975809.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975808.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975807.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Brad\",\"lastName\":\"Bird\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Eli\",\"lastName\":\"Marienthal\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Vin\",\"lastName\":\"Diesel\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Jennifer\",\"lastName\":\"Aniston\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Harry\",\"lastName\":\"Connick Jr\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Cloris\",\"lastName\":\"Leachman\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"John\",\"lastName\":\"Mahoney\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"M. Emmet\",\"lastName\":\"Walsh\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"James\",\"lastName\":\"Gammon\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Christopher\",\"lastName\":\"MacDonald\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"1999-12-17T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"mild fantasy action violence, infrequent mild bad language\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}]},{\"releasedAt\":\"2025-12-18T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"mild fantasy action violence, infrequent mild bad language\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"The Iron Giant\",\"synopsis\":\"\\\"Iron Giant\\\" is based upon the 1968 story,'Iron Man,' by the British poet laureate Ted Hughes. The film is about a giant metal machine that drops from the sky and frightens a small town in Maine in 1958, only to find a friend named, Hogarth, that ultimately finds its humanity and saving the towns people of their fears and prejudices.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/4a/ec/4aec12342e0956b6e97e1b70469d91c2.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/ed3239379df1498a4111a1654985a296.jpg\",\"synopsis\":\"Selected by the Animation Branch, Everyman presents: The Iron Giant\\n\\nBrad Bird (The Incredibles, Ratatouille) made his feature directing debut with this lively and moving animated adventure loosely inspired by an illustrated children’s novel by poet Ted Hughes. The life of a young boy (voiced by Eli Marienthal) in 1950s Maine is turned upside down when he finds a new friend in a 50-foot-tall alien robot. Bird evocatively recreates the visual iconography of ’50s genre cinema while presenting a humanist message, and his film has developed a devoted fandom in the near quarter-century since its release.  \\n\\nReleased in 1999, The Iron Giant went on to collect 18 award nominations and 20 wins, including the BAFTA Children’s Award for Best Feature Film. The film has since been celebrated for its artistry, earning recognition from the Annie Awards, the Hugo Awards, and the Saturn Awards.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 18 December.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/0e97150921cb575be79e3efdd7bdecd4.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Iron Giant\",\"synopsis\":\"Selected by the Animation Branch, Everyman presents: The Iron Giant\\n\\nBrad Bird (The Incredibles, Ratatouille) made his feature directing debut with this lively and moving animated adventure loosely inspired by an illustrated children’s novel by poet Ted Hughes. The life of a young boy (voiced by Eli Marienthal) in 1950s Maine is turned upside down when he finds a new friend in a 50-foot-tall alien robot. Bird evocatively recreates the visual iconography of ’50s genre cinema while presenting a humanist message, and his film has developed a devoted fandom in the near quarter-century since its release.  \\n\\nReleased in 1999, The Iron Giant went on to collect 18 award nominations and 20 wins, including the BAFTA Children’s Award for Best Feature Film. The film has since been celebrated for its artistry, earning recognition from the Annie Awards, the Hugo Awards, and the Saturn Awards.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 18 December.\",\"certificate\":\"PG\",\"casting\":[\"Eli Marienthal\",\"Vin Diesel\",\"Jennifer Aniston\",\"Harry Connick Jr\",\"Cloris Leachman\",\"John Mahoney\",\"M. Emmet Walsh\",\"James Gammon\",\"Christopher MacDonald\"],\"direction\":[\"Brad Bird\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/0e97150921cb575be79e3efdd7bdecd4.jpg\",\"medias/nmedia/18/87/88/11/19975816.jpg\",\"medias/nmedia/18/87/88/11/19975815.jpg\",\"medias/nmedia/18/87/88/11/19975814.jpg\",\"medias/nmedia/18/87/88/11/19975813.jpg\",\"medias/nmedia/18/87/88/11/19975812.jpg\",\"medias/nmedia/18/87/88/11/19975811.jpg\",\"medias/nmedia/18/87/88/11/19975810.jpg\",\"medias/nmedia/18/87/88/11/19975809.jpg\",\"medias/nmedia/18/87/88/11/19975808.jpg\",\"medias/nmedia/18/87/88/11/19975807.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/0e97150921cb575be79e3efdd7bdecd4.jpg\"],\"release\":\"1999-12-17T00:00:00.000Z\",\"advisory\":\"mild fantasy action violence, infrequent mild bad language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"}},{\"id\":\"130317\",\"title\":\"The Long Walk\",\"runtime\":6480,\"genres\":\"Thriller, Horror, Science fiction\",\"__typename\":\"Movie\",\"altId\":[\"365985\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/36e12abf54f6a4cd7f6aeb6e6b22cc88.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/8d/e7/8de7b5daa462502c13414086e7c9d739.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/15/dc/15dc9feaa679a6e710b08a330dbccbc9.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ec/6c/ec6c6e54ecbc4a6d04622fb27c28a2ee.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/18/35/183568c29e2f2c9b9dcb774fd7074505.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/8c/81/8c8120e4136b1e8b8f02efb268b5a1fd.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/db/fb/dbfb7435cc9402e76685101de4d35cff.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/24/0c/240c70459d43155e60c53809cea96517.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Francis\",\"lastName\":\"Lawrence\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cooper\",\"lastName\":\"Hoffman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"David\",\"lastName\":\"Jonsson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Garrett\",\"lastName\":\"Wareing\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tut\",\"lastName\":\"Nyuot\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Charlie\",\"lastName\":\"Plummer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ben\",\"lastName\":\"Wang\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Roman Griffin\",\"lastName\":\"Davis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mark\",\"lastName\":\"Hamill\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jordan\",\"lastName\":\"Gonzalez\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joshua\",\"lastName\":\"Odjick\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-12T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong violence, injury detail, language\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13832\",\"name\":\"Lionsgate UK\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"The Long Walk\",\"synopsis\":\"From the highly anticipated adaptation of master storyteller Stephen King’s first-written novel, and Francis Lawrence, the visionary director of The Hunger Games franchise films (Catching Fire, Mockingjay – Pts. 1 & 2, and The Ballad of Songbirds & Snakes), comes THE LONG WALK, an intense, chilling, and emotional thriller that challenges audiences to confront a haunting question: how far could you go?\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/365985_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/365985_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/30/b3/30b3331f7753dcb6aa46c69b61fdfcc3.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/8795d7f6e5c697cc57197129cbe41bce.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/36e12abf54f6a4cd7f6aeb6e6b22cc88.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/e71831b1236d979c6f813f57649dd67d.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Long Walk\",\"synopsis\":\"From the highly anticipated adaptation of master storyteller Stephen King’s first-written novel, and Francis Lawrence, the visionary director of The Hunger Games franchise films (Catching Fire, Mockingjay – Pts. 1 & 2, and The Ballad of Songbirds & Snakes), comes THE LONG WALK, an intense, chilling, and emotional thriller that challenges audiences to confront a haunting question: how far could you go?\",\"certificate\":\"15\",\"casting\":[\"Cooper Hoffman\",\"David Jonsson\",\"Garrett Wareing\",\"Tut Nyuot\",\"Charlie Plummer\",\"Ben Wang\",\"Roman Griffin Davis\",\"Mark Hamill\",\"Jordan Gonzalez\",\"Joshua Odjick\"],\"direction\":[\"Francis Lawrence\"],\"coDirection\":