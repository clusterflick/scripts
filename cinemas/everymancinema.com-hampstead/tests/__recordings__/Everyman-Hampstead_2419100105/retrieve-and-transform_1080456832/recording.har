izedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Zoë\",\"lastName\":\"Winters\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marin\",\"lastName\":\"Ireland\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lindsey\",\"lastName\":\"Broad\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sawyer\",\"lastName\":\"Spielberg\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Louisa\",\"lastName\":\"Jacobson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dasha\",\"lastName\":\"Nekrasova\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nedra Marie\",\"lastName\":\"Taylor\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-08-15T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong language, sex references\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"39732\",\"name\":\"Sony Pictures\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Materialists\",\"synopsis\":\"A young, ambitious New York City matchmaker finds herself torn between the perfect match and her imperfect ex.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/387869_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/387869_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/90/55/90557f90d33a8592995aa14195d681b3.png\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/613f71ce0bd052c94d139a9fbfcf795b.jpg\",\"synopsis\":\"Lucy (Dakota Johnson) is a successful matchmaker who believes love can be measured by status, wealth, and looks. But when two very different men - John (Chris Evans), her ex, and Harry (Pedro Pascal), a wealthy client - reenter her life, she’s forced to reconsider what really matters.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/f39aaf6d6672aee4991ef4028dd57698.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Materialists\",\"synopsis\":\"Lucy (Dakota Johnson) is a successful matchmaker who believes love can be measured by status, wealth, and looks. But when two very different men - John (Chris Evans), her ex, and Harry (Pedro Pascal), a wealthy client - reenter her life, she’s forced to reconsider what really matters.\",\"certificate\":\"15\",\"casting\":[\"Dakota Johnson\",\"Pedro Pascal\",\"Chris Evans\",\"Zoë Winters\",\"Marin Ireland\",\"Lindsey Broad\",\"Sawyer Spielberg\",\"Louisa Jacobson\",\"Dasha Nekrasova\",\"Nedra Marie Taylor\"],\"direction\":[\"Celine Song\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/f39aaf6d6672aee4991ef4028dd57698.jpg\",\"img/4f/33/4f33ba14c703b4192132da6887fc4fb6.jpg\",\"img/c4/ec/c4ec622583630bce21195da110dd1a62.jpg\",\"img/a1/69/a16922be69419afaa5af588a0b64eb1b.jpg\",\"img/ee/9e/ee9e4c259cd8d34299b2d8bd0cf3f033.jpg\",\"img/de/ac/deaca7a88039691114be203b8d3fcf4b.jpg\",\"img/13/2c/132cdc254f8c5e9eb20b61853951a8d4.jpg\",\"img/25/42/2542196b7106e5428bd3e6ba8b9a73fb.jpg\",\"img/45/c9/45c9f6ac46ab858374a1ae802580773c.jpg\",\"img/72/93/729375836553fab09289f662d4874d01.jpg\",\"img/4c/33/4c334caf3bf820cace05276b6e39afcd.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/f39aaf6d6672aee4991ef4028dd57698.jpg\"],\"release\":\"2025-08-15T00:00:00.000Z\",\"advisory\":\"strong language, sex references\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/387869_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/387869_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures\"}},{\"id\":\"1000028863\",\"title\":\"Members' Preview: I Swear\",\"runtime\":7200,\"genres\":\"Drama, Biopic\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/115a883709b8268628500bc328775220.jpg\",\"__typename\":\"Movie\",\"altId\":[\"397967\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Kirk\",\"lastName\":\"Jones (II)\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Aramayo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Shirley\",\"lastName\":\"Henderson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maxine\",\"lastName\":\"Peake\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Peter\",\"lastName\":\"Mullan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-10-02T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"32481\",\"name\":\"Studio Canal\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"I Swear\",\"synopsis\":\"True life story of John Davidson. Diagnosed with Tourette's at 15, targeted as insane by his peers, he struggled with a condition few had witnessed. Campaigning for Tourette's as an adult, he accepted his MBE from the Queen in 2019.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/9f/93/9f9300d6d22b1cd455fa2553686126f3.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Members' Preview: I Swear\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/115a883709b8268628500bc328775220.jpg\",\"synopsis\":\"Everyman members are invited to join us on Thursday, October 2, for a special preview screening of Kirk Jones' I Swear.\\n\\nI Swear follows the true story of Tourette Syndrome campaigner John Davidson's journey with Tourette's through his troubled teens and early adulthood, having been diagnosed at 15 years old in 1980s Britain - a time when the condition was little known and entirely misunderstood. Initially alienated from his peers and his family, Davidson perseveres in his attempt to live a 'normal' life against the odds, finding some unlikely champions along the way.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/ce371e43ae784a320f5e19e58a30c09a.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Members’ Preview: I Swear\",\"synopsis\":\"Everyman members are invited to join us on Thursday, October 2, for a special preview screening of Kirk Jones' I Swear.\\n\\nI Swear follows the true story of Tourette Syndrome campaigner John Davidson's journey with Tourette's through his troubled teens and early adulthood, having been diagnosed at 15 years old in 1980s Britain - a time when the condition was little known and entirely misunderstood. Initially alienated from his peers and his family, Davidson perseveres in his attempt to live a 'normal' life against the odds, finding some unlikely champions along the way.\",\"certificate\":null,\"casting\":[\"Robert Aramayo\",\"Shirley Henderson\",\"Maxine Peake\",\"Peter Mullan\"],\"direction\":[\"Kirk Jones (II)\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/ce371e43ae784a320f5e19e58a30c09a.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/ce371e43ae784a320f5e19e58a30c09a.jpg\"],\"release\":\"2025-10-02T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Studio Canal\"}},{\"id\":\"1000021573\",\"title\":\"Met Opera 2025-26: Andrea Chénier\",\"runtime\":12660,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"388844\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/904c2ea5271cd5be442198b5aa6f5343.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Nicolas\",\"lastName\":\"Joël\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sonya\",\"lastName\":\"Yoncheva\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Piotr\",\"lastName\":\"Beczala\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Igor\",\"lastName\":\"Golovatenko\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-13T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Met Opera 2025-26: Andrea Chénier\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/c6/5c/c65c59b93274602a15d1b702bb4b29fb.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/904c2ea5271cd5be442198b5aa6f5343.jpg\",\"synopsis\":\"Giordano’s passionate tragedy stars tenor Piotr Beczała as the virtuous poet who falls victim to the intrigue and violence of the French Revolution. Following their celebrated recent partnership in Giordano’s Fedora in the 2022–23 Live in HD season, Beczała reunites with soprano Sonya Yoncheva as Chénier’s aristocratic lover, Maddalena di Coigny, with baritone Igor Golovatenko as Carlo Gérard, the agent of the Reign of Terror who seals their fates. Met Principal Guest Conductor Daniele Rustioni takes the podium to lead Nicolas Joël’s gripping staging, which will be transmitted live from the Met stage to cinemas on December 13. \",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/84f664be160a9976fe4ca3346ebfbf6e.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Metropolitan Opera: Andrea Chénier\",\"synopsis\":\"Giordano’s passionate tragedy stars tenor Piotr Beczała as the virtuous poet who falls victim to the intrigue and violence of the French Revolution. Following their celebrated recent partnership in Giordano’s Fedora in the 2022–23 Live in HD season, Beczała reunites with soprano Sonya Yoncheva as Chénier’s aristocratic lover, Maddalena di Coigny, with baritone Igor Golovatenko as Carlo Gérard, the agent of the Reign of Terror who seals their fates. Met Principal Guest Conductor Daniele Rustioni takes the podium to lead Nicolas Joël’s gripping staging, which will be transmitted live from the Met stage to cinemas on December 13. \",\"certificate\":null,\"casting\":[\"Sonya Yoncheva\",\"Piotr Beczala\",\"Igor Golovatenko\"],\"direction\":[\"Nicolas Joël\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/84f664be160a9976fe4ca3346ebfbf6e.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/84f664be160a9976fe4ca3346ebfbf6e.jpg\"],\"release\":\"2025-12-13T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000021570\",\"title\":\"Met Opera 2025-26: Arabella\",\"runtime\":15120,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"388841\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/e4b0ab1203fe58923426c7d0a7b757c6.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Otto\",\"lastName\":\"Schenk\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rachel\",\"lastName\":\"Willis-Sørensen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Louise\",\"lastName\":\"Alder\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Pavol\",\"lastName\":\"Breslik\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tomasz\",\"lastName\":\"Konieczny\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brindley\",\"lastName\":\"Sherratt\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-22T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Met Opera 2025-26: Arabella\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/8e/3b/8e3b100c0a14fd13b2aaeb2773346091.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/e4b0ab1203fe58923426c7d0a7b757c6.jpg\",\"synopsis\":\"On November 22, Strauss’s elegant romance brings the glamour and enchantment of 19th-century Vienna to cinemas worldwide in a sumptuous production by legendary director Otto Schenk that “is as beautiful as one could hope” (The New York Times). Soprano Rachel Willis-Sørensen stars as the title heroine, a young noblewoman in search of love on her own terms. Radiant soprano Louise Alder is her sister, Zdenka, and bass-baritone Tomasz Konieczny is the dashing count who sweeps Arabella off her feet.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/518d0b19f974c028d5949cae2e417499.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Metropolitan Opera: Arabella\",\"synopsis\":\"On November 22, Strauss’s elegant romance brings the glamour and enchantment of 19th-century Vienna to cinemas worldwide in a sumptuous production by legendary director Otto Schenk that “is as beautiful as one could hope” (The New York Times). Soprano Rachel Willis-Sørensen stars as the title heroine, a young noblewoman in search of love on her own terms. Radiant soprano Louise Alder is her sister, Zdenka, and bass-baritone Tomasz Konieczny is the dashing count who sweeps Arabella off her feet.\",\"certificate\":null,\"casting\":[\"Rachel Willis-Sørensen\",\"Louise Alder\",\"Pavol Breslik\",\"Tomasz Konieczny\",\"Brindley Sherratt\"],\"direction\":[\"Otto Schenk\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/518d0b19f974c028d5949cae2e417499.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/518d0b19f974c028d5949cae2e417499.jpg\"],\"release\":\"2025-11-22T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000021612\",\"title\":\"Met Opera 2025-26: Eugene Onegin\",\"runtime\":14700,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"388904\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/1b4e9a52f34ffa8c0f55ba8b64dc0e3a.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Deborah\",\"lastName\":\"Warner\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Asmik\",\"lastName\":\"Grigorian\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maria\",\"lastName\":\"Barakova\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Stephanie\",\"lastName\":\"Blythe\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Stanislas\",\"lastName\":\"de Barbeyrac\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Igor\",\"lastName\":\"Golovatenko\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alexander\",\"lastName\":\"Tsymbalyuk\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-05-02T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Met Opera 2025-26: Eugene Onegin\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/ca/f6/caf6febc30f0e935550f2300dd3df93b.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/1b4e9a52f34ffa8c0f55ba8b64dc0e3a.jpg\",\"synopsis\":\"Following her acclaimed 2024 company debut in Puccini’s Madama Butterfly, soprano Asmik Grigorian returns to the Met as Tatiana, the lovestruck young heroine in this ardent operatic adaptation of Pushkin. Baritone Igor Golovatenko reprises his portrayal of the urbane Onegin, who realises his affection for her all too late. The Met’s evocative production, directed by Tony Award–winner Deborah Warner, “offers a beautifully detailed reading of … Tchaikovsky’s lyrical romance” (The Telegraph).\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/f12fbaa1d89b9f4bb038a4e5d357c3c7.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Metropolitan Opera: Eugene Onegin\",\"synopsis\":\"Following her acclaimed 2024 company debut in Puccini’s Madama Butterfly, soprano Asmik Grigorian returns to the Met as Tatiana, the lovestruck young heroine in this ardent operatic adaptation of Pushkin. Baritone Igor Golovatenko reprises his portrayal of the urbane Onegin, who realises his affection for her all too late. The Met’s evocative production, directed by Tony Award–winner Deborah Warner, “offers a beautifully detailed reading of … Tchaikovsky’s lyrical romance” (The Telegraph).\",\"certificate\":null,\"casting\":[\"Asmik Grigorian\",\"Maria Barakova\",\"Stephanie Blythe\",\"Stanislas de Barbeyrac\",\"Igor Golovatenko\",\"Alexander Tsymbalyuk\"],\"direction\":[\"Deborah Warner\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/f12fbaa1d89b9f4bb038a4e5d357c3c7.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/f12fbaa1d89b9f4bb038a4e5d357c3c7.jpg\"],\"release\":\"2026-05-02T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000021609\",\"title\":\"Met Opera 2025-26: I Puritani\",\"runtime\":13620,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"388901\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/40d330e126864c7218fd2328463d43e9.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Charles\",\"lastName\":\"Edwards (IV)\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lisette\",\"lastName\":\"Oropesa\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lawrence\",\"lastName\":\"Brownlee\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Artur\",\"lastName\":\"Rucinski\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christian\",\"lastName\":\"Van Horn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-01-10T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Met Opera 2025-26: I Puritani\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/25/fe/25fe22e76426f0e23379918f08260a03.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/40d330e126864c7218fd2328463d43e9.jpg\",\"synopsis\":\"For gorgeous melody, spellbinding coloratura, and virtuoso vocal fireworks, I Puritani has few equals. On January 10, the first new Met production of Bellini’s final masterpiece in nearly 50 years—a striking staging by Charles Edwards, who makes his company directorial debut after many successes as a set designer—arrives in cinemas worldwide. The Met has assembled a world-beating quartet of stars, conducted by Marco Armiliato, for the demanding principal roles. Soprano Lisette Oropesa and tenor Lawrence Brownlee are Elvira and Arturo, brought together by love and torn apart by the political rifts of the English Civil War, with baritone Artur Ruciński as Riccardo, betrothed to Elvira against her will, and bass-baritone Christian Van Horn as Elvira’s sympathetic uncle, Giorgio.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/0cf19008e493413769197c43742cee16.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Metropolitan Opera: I Puritani\",\"synopsis\":\"For gorgeous melody, spellbinding coloratura, and virtuoso vocal fireworks, I Puritani has few equals. On January 10, the first new Met production of Bellini’s final masterpiece in nearly 50 years—a striking staging by Charles Edwards, who makes his company directorial debut after many successes as a set designer—arrives in cinemas worldwide. The Met has assembled a world-beating quartet of stars, conducted by Marco Armiliato, for the demanding principal roles. Soprano Lisette Oropesa and tenor Lawrence Brownlee are Elvira and Arturo, brought together by love and torn apart by the political rifts of the English Civil War, with baritone Artur Ruciński as Riccardo, betrothed to Elvira against her will, and bass-baritone Christian Van Horn as Elvira’s sympathetic uncle, Giorgio.\",\"certificate\":null,\"casting\":[\"Lisette Oropesa\",\"Lawrence Brownlee\",\"Artur Rucinski\",\"Christian Van Horn\"],\"direction\":[\"Charles Edwards (IV)\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/0cf19008e493413769197c43742cee16.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/0cf19008e493413769197c43742cee16.jpg\"],\"release\":\"2026-01-10T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000021569\",\"title\":\"Met Opera 2025-26: La Bohème\",\"runtime\":12540,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"388840\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ca8e39dde699732743c72d2a364ab0bd.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Franco\",\"lastName\":\"Zeffirelli\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Juliana\",\"lastName\":\"Grigoryan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Heidi\",\"lastName\":\"Stober\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Freddie\",\"lastName\":\"De Tommaso\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lucas\",\"lastName\":\"Meachem\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sean Michael\",\"lastName\":\"Plumb\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jongmin\",\"lastName\":\"Park\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Donald\",\"lastName\":\"Maxwell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-08T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Metropolitan Opera: La Bohème\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/1a/62/1a6240a93e66c2a60e9f71d7d879b5e9.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Met Opera 2025-26: La Bohème\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/ca8e39dde699732743c72d2a364ab0bd.jpg\",\"synopsis\":\"With its enchanting setting and spellbinding score, the world’s most popular opera is as timeless as it is heartbreaking. Franco Zeffirelli’s picture-perfect production brings 19th-century Paris to the Met stage as Puccini’s young friends and lovers navigate the joy and struggle of bohemian life. Soprano Juliana Grigoryan is the feeble seamstress Mimì, opposite tenor Freddie De Tommaso as the ardent poet Rodolfo. Keri-Lynn Wilson conducts the November 8 performance, which will be transmitted live from the Met stage to cinemas worldwide. \",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/d1a0b9d459d32c3b10515af5f09b0314.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Metropolitan Opera: La Bohème\",\"synopsis\":\"With its enchanting setting and spellbinding score, the world’s most popular opera is as timeless as it is heartbreaking. Franco Zeffirelli’s picture-perfect production brings 19th-century Paris to the Met stage as Puccini’s young friends and lovers navigate the joy and struggle of bohemian life. Soprano Juliana Grigoryan is the feeble seamstress Mimì, opposite tenor Freddie De Tommaso as the ardent poet Rodolfo. Keri-Lynn Wilson conducts the November 8 performance, which will be transmitted live from the Met stage to cinemas worldwide. \",\"certificate\":null,\"casting\":[\"Juliana Grigoryan\",\"Heidi Stober\",\"Freddie De Tommaso\",\"Lucas Meachem\",\"Sean Michael Plumb\",\"Jongmin Park\",\"Donald Maxwell\"],\"direction\":[\"Franco Zeffirelli\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/d1a0b9d459d32c3b10515af5f09b0314.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/d1a0b9d459d32c3b10515af5f09b0314.jpg\"],\"release\":\"2025-11-08T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"143400\",\"title\":\"Met Opera 2025-26: La Sonnambula\",\"runtime\":11700,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"24116\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/fe10c6c685650b6184fb41a0aac75847.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Rolando\",\"lastName\":\"Villazón\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nadine\",\"lastName\":\"Sierra\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sydney\",\"lastName\":\"Mancasola\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Xabier\",\"lastName\":\"Anduaga\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alexander\",\"lastName\":\"Vinogradov\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-08T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Met Opera 2025-26: La Sonnambula\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/79/55/79554712edd27da3d41eabeffe27e66a.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/85f0963a9e5fa3b66143f169d4f37bee.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/fe10c6c685650b6184fb41a0aac75847.jpg\",\"synopsis\":\"Following triumphant Met turns in Roméo et Juliette, La Traviata, and Lucia di Lammermoor, Nadine Sierra summits another peak of the soprano repertoire as Amina, who sleepwalks her way into audiences’ hearts in Bellini’s poignant tale of love lost and found. In his new production, Rolando Villazón—the tenor who has embarked on a brilliant second career as a director—retains the opera’s original setting in the Swiss Alps but uses its somnambulant plot to explore the emotional and psychological valleys of the mind.\\n\\nTenor Xabier Anduaga returns after his acclaimed 2023 Met debut in L’Elisir d’Amore, co-starring as Amina’s fiancé Elvino, alongside soprano Sydney Mancasola as her rival, Lisa, and bass Alexander Vinogradov as Count Rodolfo. Riccardo Frizza takes the podium for one of opera’s most ravishing works.\\n\\nLa Sonnambula will be presented as part of RBO's 2025–26 season, with a live broadcast screening on Tuesday, October 21.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/08f8b1c7919e76407bbe25774d3c8988.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Metropolitan Opera: La Sonnambula\",\"synopsis\":\"Following triumphant Met turns in Roméo et Juliette, La Traviata, and Lucia di Lammermoor, Nadine Sierra summits another peak of the soprano repertoire as Amina, who sleepwalks her way into audiences’ hearts in Bellini’s poignant tale of love lost and found. In his new production, Rolando Villazón—the tenor who has embarked on a brilliant second career as a director—retains the opera’s original setting in the Swiss Alps but uses its somnambulant plot to explore the emotional and psychological valleys of the mind.\\n\\nTenor Xabier Anduaga returns after his acclaimed 2023 Met debut in L’Elisir d’Amore, co-starring as Amina’s fiancé Elvino, alongside soprano Sydney Mancasola as her rival, Lisa, and bass Alexander Vinogradov as Count Rodolfo. Riccardo Frizza takes the podium for one of opera’s most ravishing works.\\n\\nLa Sonnambula will be presented as part of RBO's 2025–26 season, with a live broadcast screening on Tuesday, October 21.\",\"certificate\":null,\"casting\":[\"Nadine Sierra\",\"Sydney Mancasola\",\"Xabier Anduaga\",\"Alexander Vinogradov\"],\"direction\":[\"Rolando Villazón\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/08f8b1c7919e76407bbe25774d3c8988.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/08f8b1c7919e76407bbe25774d3c8988.jpg\",\"https://cms-assets.webediamovies.pro/production/2/85f0963a9e5fa3b66143f169d4f37bee.jpg\"],\"release\":\"2025-11-08T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000021611\",\"title\":\"Met Opera 2025-26: Tristan und Isolde\",\"runtime\":18720,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"388903\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2de4e1e17135a6dcbf088b3911ea93c4.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Yuval\",\"lastName\":\"Sharon\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lise\",\"lastName\":\"Davidsen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ekaterina\",\"lastName\":\"Gubanova\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Spyres\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tomasz\",\"lastName\":\"Konieczny\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ryan Speedo\",\"lastName\":\"Green\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-03-21T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Met Opera 2025-26: Tristan und Isolde\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/a0/6f/a06f796aae3404f2caf5029e91fc685d.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/2de4e1e17135a6dcbf088b3911ea93c4.jpg\",\"synopsis\":\"After years of anticipation, a truly unmissable event arrives in cinemas worldwide on March 21 as the electrifying Lise Davidsen tackles one of the ultimate roles for dramatic soprano: the Irish princess Isolde in Wagner’s transcendent meditation on love and death. Heroic tenor Michael Spyres stars opposite Davidsen as the love-drunk Tristan. The momentous occasion also marks the advent of a new, Met-debut staging by Yuval Sharon—hailed by The New York Times as “the most visionary opera director of his generation” and the first American to direct an opera at the famed Wagner festival in Bayreuth—as well as Music Director Yannick Nézet-Séguin’s first time leading Tristan und Isolde at the Met. Mezzo-soprano Ekaterina Gubanova reprises her portrayal of Brangäne, alongside bass-baritone Tomasz Konieczny, who sings Kurwenal after celebrated Met appearances in Wagner’s Der Fliegende Holländer and Ring cycle. Bass-baritone Ryan Speedo Green makes an important role debut as King Marke.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/35240ed5c775e2e99106fff9663b351b.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Metropolitan Opera: Tristan und Isolde\",\"synopsis\":\"After years of anticipation, a truly unmissable event arrives in cinemas worldwide on March 21 as the electrifying Lise Davidsen tackles one of the ultimate roles for dramatic soprano: the Irish princess Isolde in Wagner’s transcendent meditation on love and death. Heroic tenor Michael Spyres stars opposite Davidsen as the love-drunk Tristan. The momentous occasion also marks the advent of a new, Met-debut staging by Yuval Sharon—hailed by The New York Times as “the most visionary opera director of his generation” and the first American to direct an opera at the famed Wagner festival in Bayreuth—as well as Music Director Yannick Nézet-Séguin’s first time leading Tristan und Isolde at the Met. Mezzo-soprano Ekaterina Gubanova reprises her portrayal of Brangäne, alongside bass-baritone Tomasz Konieczny, who sings Kurwenal after celebrated Met appearances in Wagner’s Der Fliegende Holländer and Ring cycle. Bass-baritone Ryan Speedo Green makes an important role debut as King Marke.\",\"certificate\":null,\"casting\":[\"Lise Davidsen\",\"Ekaterina Gubanova\",\"Michael Spyres\",\"Tomasz Konieczny\",\"Ryan Speedo Green\"],\"direction\":[\"Yuval Sharon\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/35240ed5c775e2e99106fff9663b351b.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/35240ed5c775e2e99106fff9663b351b.jpg\"],\"release\":\"2026-03-21T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"240\",\"title\":\"Metropolis\",\"runtime\":9180,\"genres\":\"Science fiction, Thriller\",\"__typename\":\"Movie\",\"altId\":[\"3359\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/14ca28556c1189355bbd26dfddc3bb15.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890932.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890917.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890916.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890915.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890914.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890913.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890912.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890911.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890910.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890909.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Fritz\",\"lastName\":\"Lang\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brigitte\",\"lastName\":\"Helm\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alfred\",\"lastName\":\"Abel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rudolf\",\"lastName\":\"Klein-Rogge\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Theodor\",\"lastName\":\"Loos\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Heinrich\",\"lastName\":\"George\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Olaf\",\"lastName\":\"Storm\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hanns Leo\",\"lastName\":\"Reich\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Heinrich\",\"lastName\":\"Gotho\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Margarete\",\"lastName\":\"Lanner\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Fritz\",\"lastName\":\"Alberti\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-02-19T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"Contains mild violence and nudity\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[],\"distributors\":[{\"id\":\"24287\",\"name\":\"Independent\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Metropolis\",\"synopsis\":\"In a futuristic city sharply divided between the working class and the city planners, the son of the city's mastermind falls in love with a working class prophet who predicts the coming of a savior to mediate their differences.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/44/a0/44a0114c1a08bbd76668a5c6661872b6.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/14ca28556c1189355bbd26dfddc3bb15.jpg\",\"synopsis\":\"Selected by the Visual Effects Branch, Everyman presents: Metropolis\\n\\nIn a futuristic city sharply divided between the working class and the city planners, the son of the city's mastermind falls in love with a working-class prophet who predicts the coming of a saviour to mediate their differences.\\n\\nThis visionary silent classic from director Fritz Lang created one of the most iconic imaginings of a city of the future while telling a compelling story about the conflict between the classes. When a young activist named Maria tries to enlighten the workers about their oppression, the evil scientist Rotwang replaces her with a robot double designed to foment chaos among the oppressed. Pioneering cinematographer Eugen Schüfftan received the credit for the film’s impressive effects, which include elaborate miniatures of the futuristic city as well as the costume for the robot Maria, one of the most memorable artificial humans in cinematic history.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 19 February.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/ca5e8474db58cbc53f644e1d4aa2b8e4.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Metropolis\",\"synopsis\":\"Selected by the Visual Effects Branch, Everyman presents: Metropolis\\n\\nIn a futuristic city sharply divided between the working class and the city planners, the son of the city's mastermind falls in love with a working-class prophet who predicts the coming of a saviour to mediate their differences.\\n\\nThis visionary silent classic from director Fritz Lang created one of the most iconic imaginings of a city of the future while telling a compelling story about the conflict between the classes. When a young activist named Maria tries to enlighten the workers about their oppression, the evil scientist Rotwang replaces her with a robot double designed to foment chaos among the oppressed. Pioneering cinematographer Eugen Schüfftan received the credit for the film’s impressive effects, which include elaborate miniatures of the futuristic city as well as the costume for the robot Maria, one of the most memorable artificial humans in cinematic history.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 19 February.\",\"certificate\":\"PG\",\"casting\":[\"Brigitte Helm\",\"Alfred Abel\",\"Rudolf Klein-Rogge\",\"Theodor Loos\",\"Heinrich George\",\"Olaf Storm\",\"Hanns Leo Reich\",\"Heinrich Gotho\",\"Margarete Lanner\",\"Fritz Alberti\"],\"direction\":[\"Fritz Lang\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/ca5e8474db58cbc53f644e1d4aa2b8e4.jpg\",\"medias/nmedia/18/87/10/42/19890932.jpg\",\"medias/nmedia/18/87/10/42/19890917.jpg\",\"medias/nmedia/18/87/10/42/19890916.jpg\",\"medias/nmedia/18/87/10/42/19890915.jpg\",\"medias/nmedia/18/87/10/42/19890914.jpg\",\"medias/nmedia/18/87/10/42/19890913.jpg\",\"medias/nmedia/18/87/10/42/19890912.jpg\",\"medias/nmedia/18/87/10/42/19890911.jpg\",\"medias/nmedia/18/87/10/42/19890910.jpg\",\"medias/nmedia/18/87/10/42/19890909.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/ca5e8474db58cbc53f644e1d4aa2b8e4.jpg\"],\"release\":\"2026-02-19T00:00:00.000Z\",\"advisory\":\"Contains mild violence and nudity\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Independent\"}},{\"id\":\"1000030010\",\"title\":\"Mitski: The Land\",\"runtime\":4680,\"genres\":\"Concert, Music\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/60b590c30f26aeef8a2f0ecd8a323744.jpg\",\"__typename\":\"Movie\",\"altId\":[\"399406\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/91/92/9192033a56c710a7f4a26821e5d952bb.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/96/b9/96b9e6ba3269e5b45dbfb17fc3587c1d.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/6f/ef/6fef46f90ce370996b1b5f9b0432ec2a.jpg\",\"__typename\":\"Image\"}],\"quadImages\":[\"https://all.web.img.acsta.net/img/e1/91/e1914074358542311cf5bffb440c3de2.jpg\"],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Grant\",\"lastName\":\"James\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":null,\"lastName\":\"Mitski\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-17T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Mitski: The Land\",\"synopsis\":\"Mitski: The Land converts the magic and majesty of witnessing Mitski live onto screen. Filmed over three nights at Atlanta’s Fox Theatre in 2024, this is a thrilling portrayal of what kept hundreds of thousands of fans rapt at venues across the globe.\\n\\nA phenomenal live performer, Mitski brought her acclaimed seventh album, The Land Is Inhospitable and So Are We, to the world’s stages in theatrical and daring fashion, presenting as much a spectacle as an expansive live show. Alongside a seven-piece band and with choreography by Monica Mirabile, Mitski uses every inch of the stage to her advantage, weaving in and out of the spotlight and shadows. Mitski: The Land captures an artist at the height of her musical powers, bringing a cinematic intimacy to the sweeping live experience, showcasing music from “The Land Is…” alongside reworkings and reimaginations of songs that color her expansive career.\\n\\nThe starkness of the stage design (created by Andi Watson) evokes the album’s themes of isolation, longing, and the wild beauty of human connection, with visual elements that shift from a striking minimalism to a lush, dreamlike tableau.\\n\\nDirected by Grant James and mixed by her long-standing producer Patrick Hyland, Mitski: The Land preserves the rich, raw aura of having experienced these shows first-hand, whilst offering fans the opportunity to remember together or witness Mitski’s magic for the very first time.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/1a/fd/1afdb9233781450a0d682bc11e3f7141.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/3e669656f5941d8ef38ed2a04460206c.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/60b590c30f26aeef8a2f0ecd8a323744.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/dd4651c5b45b30dbbb148c1e1ee163cf.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Mitski : The Land\",\"synopsis\":\"Mitski: The Land converts the magic and majesty of witnessing Mitski live onto screen. Filmed over three nights at Atlanta’s Fox Theatre in 2024, this is a thrilling portrayal of what kept hundreds of thousands of fans rapt at venues across the globe.\\n\\nA phenomenal live performer, Mitski brought her acclaimed seventh album, The Land Is Inhospitable and So Are We, to the world’s stages in theatrical and daring fashion, presenting as much a spectacle as an expansive live show. Alongside a seven-piece band and with choreography by Monica Mirabile, Mitski uses every inch of the stage to her advantage, weaving in and out of the spotlight and shadows. Mitski: The Land captures an artist at the height of her musical powers, bringing a cinematic intimacy to the sweeping live experience, showcasing music from “The Land Is…” alongside reworkings and reimaginations of songs that color her expansive career.\\n\\nThe starkness of the stage design (created by Andi Watson) evokes the album’s themes of isolation, longing, and the wild beauty of human connection, with visual elements that shift from a striking minimalism to a lush, dreamlike tableau.\\n\\nDirected by Grant James and mixed by her long-standing producer Patrick Hyland, Mitski: The Land preserves the rich, raw aura of having experienced these shows first-hand, whilst offering fans the opportunity to remember together or witness Mitski’s magic for the very first time.\",\"certificate\":\"12A\",\"casting\":[\"Mitski\"],\"direction\":[\"Grant James\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/dd4651c5b45b30dbbb148c1e1ee163cf.jpg\",\"img/91/92/9192033a56c710a7f4a26821e5d952bb.jpg\",\"img/96/b9/96b9e6ba3269e5b45dbfb17fc3587c1d.jpg\",\"img/6f/ef/6fef46f90ce370996b1b5f9b0432ec2a.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/dd4651c5b45b30dbbb148c1e1ee163cf.jpg\",\"https://cms-assets.webediamovies.pro/production/2/3e669656f5941d8ef38ed2a04460206c.jpg\"],\"release\":\"2025-10-17T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000026570\",\"title\":\"National Theatre Live: Hamlet\",\"runtime\":10800,\"genres\":\"Drama\",\"__typename\":\"Movie\",\"altId\":[\"395089\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/fd87d89a94a7ae7a33c1d166eb8a6321.jpg\",\"quadImages\":[\"https://all.web.img.acsta.net/img/d3/ae/d3ae1926dd05429ca581a8d3f8250168.png\"],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Robert\",\"lastName\":\"Hastie\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2026-01-22T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"7215\",\"name\":\"National Theatre\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"National Theatre Live: Hamlet\",\"synopsis\":\"Olivier Award-winner Hiran Abeysekera (Life of Pi) is Hamlet in this fearless, contemporary take on Shakespeare’s famous tragedy. \\nTrapped between duty and doubt, surrounded by power and privilege, young Prince Hamlet dares to ask the ultimate question – you know the one.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/1e/87/1e874e60f4054fd16a0f8b51c64e1b5b.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/fd87d89a94a7ae7a33c1d166eb8a6321.jpg\",\"synopsis\":\"Olivier Award-winner Hiran Abeysekera (Life of Pi) is Hamlet in this fearless, contemporary take on Shakespeare’s famous tragedy.\\n\\nTrapped between duty and doubt, surrounded by power and privilege, young Prince Hamlet dares to ask the ultimate question – you know the one.\\nNational Theatre Deputy Artistic Director, Robert Hastie (Standing at the Sky’s Edge, Operation Mincemeat) directs this sharp, stylish and darkly funny reimagining.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/dd059cb3657051bd46281dce9877fb8c.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"National Theatre Live: Hamlet\",\"synopsis\":\"Olivier Award-winner Hiran Abeysekera (Life of Pi) is Hamlet in this fearless, contemporary take on Shakespeare’s famous tragedy.\\n\\nTrapped between duty and doubt, surrounded by power and privilege, young Prince Hamlet dares to ask the ultimate question – you know the one.\\nNational Theatre Deputy Artistic Director, Robert Hastie (Standing at the Sky’s Edge, Operation Mincemeat) directs this sharp, stylish and darkly funny reimagining.\",\"certificate\":null,\"casting\":[],\"direction\":[\"Robert Hastie\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/dd059cb3657051bd46281dce9877fb8c.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/dd059cb3657051bd46281dce9877fb8c.jpg\"],\"release\":\"2026-01-22T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"National Theatre\"}},{\"id\":\"1000021371\",\"title\":\"National Theatre Live: Inter Alia\",\"runtime\":6300,\"genres\":\"Drama\",\"__typename\":\"Movie\",\"altId\":[\"388597\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2127c8317d7ffe94c58397574753bb4c.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Justin\",\"lastName\":\"Martin (II)\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jamie\",\"lastName\":\"Glover\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rosamund\",\"lastName\":\"Pike\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-05T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"7215\",\"name\":\"National Theatre\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"National Theatre Live: Inter Alia\",\"synopsis\":\"Oscar-nominated Rosamund Pike (Gone Girl, Saltburn) is Jessica in the much-anticipated next play from the team behind Prima Facie.\\n\\nJessica Parks is a smart Crown Court Judge at the top of her career. Behind the robe, she is a karaoke fiend, a loving wife and a supportive parent. When an event threatens to throw her life completely off balance, can she hold her family upright?\\n\\nWriter Suzie Miller and director Justin Martin reunite following their global phenomenon Prima Facie, with this searing examination of modern motherhood and masculinity.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/1c/6c/1c6c08a72287dcb990416b5a1e6865de.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/cff6833843d56eb8524d07a1dd6dba1f.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/2127c8317d7ffe94c58397574753bb4c.jpg\",\"synopsis\":\"Oscar-nominated Rosamund Pike (Gone Girl, Saltburn) is Jessica in the much-anticipated next play from the team behind Prima Facie. \\n\\nJessica Parks is a smart Crown Court Judge at the top of her career. Behind the robe, she is a karaoke fiend, a loving wife and a supportive parent. When an event threatens to throw her life completely off balance, can she hold her family upright?\\n\\nWriter Suzie Miller and director Justin Martin reunite following their global phenomenon Prima Facie with this searing examination of modern motherhood and masculinity.\\n\\nInter Alia is to be broadcast live on Thursday 4th September 2025, with any subsequent shows played as recorded encores.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/43adcf445d5e45109b7780c735cc4382.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"National Theatre Live: Inter Alia\",\"synopsis\":\"Oscar-nominated Rosamund Pike (Gone Girl, Saltburn) is Jessica in the much-anticipated next play from the team behind Prima Facie. \\n\\nJessica Parks is a smart Crown Court Judge at the top of her career. Behind the robe, she is a karaoke fiend, a loving wife and a supportive parent. When an event threatens to throw her life completely off balance, can she hold her family upright?\\n\\nWriter Suzie Miller and director Justin Martin reunite following their global phenomenon Prima Facie with this searing examination of modern motherhood and masculinity.\\n\\nInter Alia is to be broadcast live on Thursday 4th September 2025, with any subsequent shows played as recorded encores.\",\"certificate\":\"15\",\"casting\":[\"Jamie Glover\",\"Rosamund Pike\"],\"direction\":[\"Justin Martin (II)\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/43adcf445d5e45109b7780c735cc4382.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/43adcf445d5e45109b7780c735cc4382.jpg\",\"https://cms-assets.webediamovies.pro/production/2/cff6833843d56eb8524d07a1dd6dba1f.jpg\"],\"release\":\"2025-09-05T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"National Theatre\"}},{\"id\":\"1000026567\",\"title\":\"National Theatre Live: Mrs. Warren’s Profession\",\"runtime\":null,\"genres\":\"Musical\",\"__typename\":\"Movie\",\"altId\":[\"395086\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/cd667463170cde9cbfad8401f3bb0bb1.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Dominic\",\"lastName\":\"Cooke\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Imelda\",\"lastName\":\"Staunton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bessie\",\"lastName\":\"Carter\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-11T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"7215\",\"name\":\"National Theatre\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"National Theatre Live: Mrs. Warren’s Profession\",\"synopsis\":\"Vivie Warren is a woman ahead of her time. Her mother, however, is a product of that old patriarchal order. Exploiting it has earned Mrs. Warren a fortune – but at what cost?\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/58/fb/58fb3bd6ca45c39d12919ac326ab8f9f.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/cd667463170cde9cbfad8401f3bb0bb1.jpg\",\"synopsis\":\"Five-time Olivier Award winner Imelda Staunton (The Crown) joins forces with her real-life daughter Bessie Carter (Bridgerton) for the very first time, playing mother and daughter in Bernard Shaw’s incendiary moral classic.\\n\\nVivie Warren is a woman ahead of her time. Her mother, however, is a product of that old patriarchal order. Exploiting it has earned Mrs. Warren a fortune – but at what cost?\\n\\nFilmed live from the West End, this new production reunites Staunton with director Dominic Cooke (Follies, Good), exploring the clash between morality and independence, traditions and progress. \",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/b1d41776a25cd70aafd5e70ce5968893.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"National Theatre Live: Mrs. Warren’s Profession\",\"synopsis\":\"Five-time Olivier Award winner Imelda Staunton (The Crown) joins forces with her real-life daughter Bessie Carter (Bridgerton) for the very first time, playing mother and daughter in Bernard Shaw’s incendiary moral classic.\\n\\nVivie Warren is a woman ahead of her time. Her mother, however, is a product of that old patriarchal order. Exploiting it has earned Mrs. Warren a fortune – but at what cost?\\n\\nFilmed live from the West End, this new production reunites Staunton with director Dominic Cooke (Follies, Good), exploring the clash between morality and independence, traditions and progress. \",\"certificate\":null,\"casting\":[\"Imelda Staunton\",\"Bessie Carter\"],\"direction\":[\"Dominic Cooke\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/b1d41776a25cd70aafd5e70ce5968893.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/b1d41776a25cd70aafd5e70ce5968893.jpg\"],\"release\":\"2025-09-11T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"National Theatre\"}},{\"id\":\"1000026569\",\"title\":\"National Theatre Live: The Fifth Step\",\"runtime\":6000,\"genres\":\"Musical\",\"__typename\":\"Movie\",\"altId\":[\"395088\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/0faccf8b7ecd36340d228cfdc358f7a6.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Finn\",\"lastName\":\"Den Hertog\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jack\",\"lastName\":\"Lowden\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Martin\",\"lastName\":\"Freeman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-27T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"7215\",\"name\":\"National Theatre\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"National Theatre Live: The Fifth Step\",\"synopsis\":\"After years in the 12-step programme of Alcoholics Anonymous, James becomes a sponsor to newcomer Luka. The pair bond over black coffee, trade stories and build a fragile friendship out of their shared experiences. But as Luka approaches step five – the moment of confession – dangerous truths emerge, threatening the trust on which both of their recoveries depend.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/53/be/53beca41057ec0c84415ca266d74d67b.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/0faccf8b7ecd36340d228cfdc358f7a6.jpg\",\"synopsis\":\"Olivier Award-winner Jack Lowden (Slow Horses, Dunkirk) is joined by Emmy and BAFTA-winner Martin Freeman (The Hobbit, The Responder) in the critically acclaimed and subversively funny new play by David Ireland.\\n\\nAfter years in the 12-step programme of Alcoholics Anonymous, James becomes a sponsor to newcomer Luka. The pair bond over black coffee, trade stories and build a fragile friendship out of their shared experiences. But as Luka approaches step five – the moment of confession – dangerous truths emerge, threatening the trust on which both of their recoveries depend.\\n\\nFinn den Hertog directs the provocative and entertaining production filmed live from @sohoplace on London’s West End.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/1a6f11bf828f4642e39f3c2cab4aee81.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"National Theatre Live: The Fifth Step\",\"synopsis\":\"Olivier Award-winner Jack Lowden (Slow Horses, Dunkirk) is joined by Emmy and BAFTA-winner Martin Freeman (The Hobbit, The Responder) in the critically acclaimed and subversively funny new play by David Ireland.\\n\\nAfter years in the 12-step programme of Alcoholics Anonymous, James becomes a sponsor to newcomer Luka. The pair bond over black coffee, trade stories and build a fragile friendship out of their shared experiences. But as Luka approaches step five – the moment of confession – dangerous truths emerge, threatening the trust on which both of their recoveries depend.\\n\\nFinn den Hertog directs the provocative and entertaining production filmed live from @sohoplace on London’s West End.\",\"certificate\":null,\"casting\":[\"Jack Lowden\",\"Martin Freeman\"],\"direction\":[\"Finn Den Hertog\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/1a6f11bf828f4642e39f3c2cab4aee81.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/1a6f11bf828f4642e39f3c2cab4aee81.jpg\"],\"rele