dVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Wes\",\"lastName\":\"Craven\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Linda\",\"lastName\":\"Blair\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"1997-10-01T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"Contains strong bloody violence\",\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Scream\",\"synopsis\":\"After a series of mysterious deaths befalls their small town, an offbeat group of friends led by Sidney Prescott become the target of a masked killer. As the body count begins to rise, Sidney and her friends find themselves contemplating the \\\"Rules\\\" of horror films as they find themselves living in a real-life one.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/1e/eb/1eeb27e36de99970c1b2c63b6af02be8.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Throwback: Scream\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/4654cd8af43a4f1d98cb1b323fec9f8f.jpg\",\"synopsis\":\"After a series of mysterious deaths befalls their small town, an offbeat group of friends led by Sidney Prescott become the target of a masked killer. As the body count begins to rise, Sidney and her friends find themselves contemplating the \\\"Rules\\\" of horror films as they find themselves living in a real-life one.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/1ca8d6e3cf21a568d308a6263f2394ce.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Scream\",\"synopsis\":\"After a series of mysterious deaths befalls their small town, an offbeat group of friends led by Sidney Prescott become the target of a masked killer. As the body count begins to rise, Sidney and her friends find themselves contemplating the \\\"Rules\\\" of horror films as they find themselves living in a real-life one.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"certificate\":\"18\",\"casting\":[\"Neve Campbell\",\"Courteney Cox\",\"David Arquette\",\"Skeet Ulrich\",\"Matthew Lillard\",\"Rose McGowan\",\"Drew Barrymore\",\"Liev Schreiber\",\"Wes Craven\",\"Linda Blair\"],\"direction\":[\"Wes Craven\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/1ca8d6e3cf21a568d308a6263f2394ce.jpg\",\"medias/nmedia/18/87/27/88/19906214.jpg\",\"medias/nmedia/18/87/27/88/19906212.jpg\",\"medias/nmedia/18/87/27/88/19906210.jpg\",\"medias/nmedia/18/87/27/88/19906209.jpg\",\"medias/nmedia/18/87/27/88/19906208.jpg\",\"medias/nmedia/18/87/27/88/19906207.jpg\",\"pictures/15/11/16/12/32/514900.jpg\",\"pictures/15/11/16/12/21/022930.jpg\",\"pictures/15/11/16/12/33/442207.png\",\"pictures/15/11/16/12/34/033466.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/1ca8d6e3cf21a568d308a6263f2394ce.jpg\"],\"release\":\"1997-10-01T00:00:00.000Z\",\"advisory\":\"Contains strong bloody violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures UK\"}},{\"id\":\"1000029352\",\"title\":\"Throwback: The Sound of Music (60th Anniversary)\",\"runtime\":10740,\"genres\":\"Musical, Family\",\"__typename\":\"Movie\",\"altId\":[\"398607\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/7ad110c822b9008b60f2b925bc57cb35.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Robert\",\"lastName\":\"Wise\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Julie\",\"lastName\":\"Andrews\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christopher\",\"lastName\":\"Plummer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Eleanor\",\"lastName\":\"Parker\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Richard\",\"lastName\":\"Haydn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Peggy\",\"lastName\":\"Wood\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-19T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"no material likely to offend or harm\",\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Throwback: The Sound of Music (60th Anniversary)\",\"synopsis\":\"Experience the breathtaking theatrical presentation of Rodgers & Hammerstein's™ iconic\\nmusical film “The Sound of Music.” Meticulously restored and remastered in 4K for its 60th\\nanniversary, the beloved classic is more brilliant than ever with pristine picture and sound.\\nIn this true-life story, Julie Andrews lights up the screen as Maria, a spirited young woman who\\nleaves the convent and becomes a governess to the seven unruly children of Captain von Trapp\\n(Christopher Plummer). Her warmth, charm and songs soon win the hearts of the children and\\ntheir father. But when the threat of war rises, Maria is forced to attempt a daring escape with her\\nnew family.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/43/32/4332f967fc08da2c355497c671f00b7b.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/0ab295572e43dcad4c5ae40cb53eaa2c.jpg\",\"__typename\":\"BOAppImage\"}]}},\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/7ad110c822b9008b60f2b925bc57cb35.jpg\",\"synopsis\":\"Experience the breathtaking theatrical presentation of Rodgers & Hammerstein's™ iconic musical film “The Sound of Music.” Meticulously restored and remastered in 4K for its 60th anniversary, the beloved classic is more brilliant than ever with pristine picture and sound.\\n\\nIn this true-life story, Julie Andrews lights up the screen as Maria, a spirited young woman who leaves the convent and becomes a governess to the seven unruly children of Captain von Trapp (Christopher Plummer). Her warmth, charm and songs soon win the hearts of the children and their father. But when the threat of war rises, Maria is forced to attempt a daring escape with her new family.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/39ca2720f1d0cf82cadfb6f2c7c96eb6.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Throwback: The Sound of Music (60th Anniversary)\",\"synopsis\":\"Experience the breathtaking theatrical presentation of Rodgers & Hammerstein's™ iconic musical film “The Sound of Music.” Meticulously restored and remastered in 4K for its 60th anniversary, the beloved classic is more brilliant than ever with pristine picture and sound.\\n\\nIn this true-life story, Julie Andrews lights up the screen as Maria, a spirited young woman who leaves the convent and becomes a governess to the seven unruly children of Captain von Trapp (Christopher Plummer). Her warmth, charm and songs soon win the hearts of the children and their father. But when the threat of war rises, Maria is forced to attempt a daring escape with her new family.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"certificate\":\"U\",\"casting\":[\"Julie Andrews\",\"Christopher Plummer\",\"Eleanor Parker\",\"Richard Haydn\",\"Peggy Wood\"],\"direction\":[\"Robert Wise\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/39ca2720f1d0cf82cadfb6f2c7c96eb6.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/39ca2720f1d0cf82cadfb6f2c7c96eb6.jpg\",\"https://cms-assets.webediamovies.pro/production/2/0ab295572e43dcad4c5ae40cb53eaa2c.jpg\"],\"release\":\"2025-09-19T00:00:00.000Z\",\"advisory\":\"no material likely to offend or harm\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000031578\",\"title\":\"Times+ Preview - Stiller & Meara: Nothing is Lost\",\"runtime\":null,\"genres\":\"Documentary\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/168f0194084f63b409165e4cfe6c7a65.jpg\",\"__typename\":\"Movie\",\"altId\":[\"401428\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Ben\",\"lastName\":\"Stiller\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ben\",\"lastName\":\"Stiller\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jerry\",\"lastName\":\"Stiller\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anne\",\"lastName\":\"Meara\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-21T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"locale\":{\"title\":\"Times +: Stiller & Meara: Nothing Is Lost\",\"synopsis\":null,\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"embargoes\":[],\"exhibitor\":{\"title\":\"Times+ Preview - Stiller & Meara: Nothing is Lost\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/168f0194084f63b409165e4cfe6c7a65.jpg\",\"synopsis\":\"Times+ subscribers are invited to join us for the special preview of 'Stiller & Meara: Nothing is Lost', directed and produced by Hollywood legend Ben Stiller.\\n\\nBen Stiller tells the story of his parents, comedy icons Jerry Stiller and Anne Meara, exploring their impact on both popular culture and at home, where the lines between creativity, family, life and art often blurred. In the process, Stiller turns the camera on himself and his family to examine Jerry and Anne’s enormous influence on their lives, and the generational lessons that we can all learn from those we love.\\n\\nThe documentary is produced by Ben Stiller, Academy Award winner John Lesher (“Birdman or (The Unexpected Virtue of Ignorance),” “Severance”), Emmy Award nominee Geoffrey Richman (“Severance,” “Tiger King”) and Lizz Morhaim (“The Super Models,” “Rebuilding Paradise”). Academy Award nominee Bryn Mooser (“Lifeboat,” “They Call Me Magic”), Emmy Award nominee Justin Lacob (“Free Leonard Peltier,” “The Lionheart”) and Emmy Award winner and BAFTA Award nominee Kathryn Everett (“Daughters,” “Lakota Nation vs. United States”) executive produce, with Emmy Award nominee Matthew Cherchio (“Diane Warren: Relentless”) serving as supervising producer for XTR. Tony Hsieh and Andy Hsieh are also executive producers.\\n\\n\\\"Stiller & Meara: Nothing is Lost” features the inspiring story of comedy icons Jerry Stiller and Anne Meara, and is set to stream on Apple TV+ from 24 October 2025.\\n\\nEvery ticket includes a complimentary popcorn.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Times +: Stiller & Meara: Nothing Is Lost\",\"synopsis\":\"Times+ subscribers are invited to join us for the special preview of 'Stiller & Meara: Nothing is Lost', directed and produced by Hollywood legend Ben Stiller.\\n\\nBen Stiller tells the story of his parents, comedy icons Jerry Stiller and Anne Meara, exploring their impact on both popular culture and at home, where the lines between creativity, family, life and art often blurred. In the process, Stiller turns the camera on himself and his family to examine Jerry and Anne’s enormous influence on their lives, and the generational lessons that we can all learn from those we love.\\n\\nThe documentary is produced by Ben Stiller, Academy Award winner John Lesher (“Birdman or (The Unexpected Virtue of Ignorance),” “Severance”), Emmy Award nominee Geoffrey Richman (“Severance,” “Tiger King”) and Lizz Morhaim (“The Super Models,” “Rebuilding Paradise”). Academy Award nominee Bryn Mooser (“Lifeboat,” “They Call Me Magic”), Emmy Award nominee Justin Lacob (“Free Leonard Peltier,” “The Lionheart”) and Emmy Award winner and BAFTA Award nominee Kathryn Everett (“Daughters,” “Lakota Nation vs. United States”) executive produce, with Emmy Award nominee Matthew Cherchio (“Diane Warren: Relentless”) serving as supervising producer for XTR. Tony Hsieh and Andy Hsieh are also executive producers.\\n\\n\\\"Stiller & Meara: Nothing is Lost” features the inspiring story of comedy icons Jerry Stiller and Anne Meara, and is set to stream on Apple TV+ from 24 October 2025.\\n\\nEvery ticket includes a complimentary popcorn.\",\"certificate\":null,\"casting\":[\"Ben Stiller\",\"Jerry Stiller\",\"Anne Meara\"],\"direction\":[\"Ben Stiller\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-10-21T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000029354\",\"title\":\"Toddler Club: Cars 2\",\"runtime\":6720,\"genres\":\"Animation\",\"__typename\":\"Movie\",\"altId\":[\"398609\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/5c488abd0659225de419ce88d6c6d2e3.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"John\",\"lastName\":\"Lasseter\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Bradford\",\"lastName\":\"Lewis\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":null,\"lastName\":\"Larry The Cable Guy\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Owen\",\"lastName\":\"Wilson\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Michael\",\"lastName\":\"Caine\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Emily\",\"lastName\":\"Mortimer\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2025-09-26T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"Contains mild violence\",\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[],\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Toddler Club: Cars 2\",\"synopsis\":\"Star racecar Lightning McQueen and the incomparable tow truck Mater take their friendship to exciting new places in \\\"Cars 2\\\" when they compete in the first-ever World Grand Prix to determine the world's fastest car. But, the road to the championship is filled with plenty of potholes, detours and hilarious surprises when Mater gets caught up in an intriguing adventure of his own: international espionage.  Torn between assisting Lightning McQueen in the high-profile race and towing the line in a top-secret spy mission, Mater's action-packed journey leads him on an explosive chase through the streets of Japan and Europe, trailed by his friends and watched by the whole world.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/88/64/88643554220ab85886dd7e7a8dc551ae.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/5c488abd0659225de419ce88d6c6d2e3.jpg\",\"synopsis\":\"Star racecar Lightning McQueen and the incomparable tow truck Mater take their friendship to exciting new places in \\\"Cars 2\\\" when they compete in the first-ever World Grand Prix to determine the world's fastest car. But, the road to the championship is filled with plenty of potholes, detours and hilarious surprises when Mater gets caught up in an intriguing adventure of his own: international espionage.  \\n\\nTorn between assisting Lightning McQueen in the high-profile race and towing the line in a top-secret spy mission, Mater's action-packed journey leads him on an explosive chase through the streets of Japan and Europe, trailed by his friends and watched by the whole world.\\n\\nJoin us every Friday or Saturday for toddler-friendly cinema screenings. From ages 1 to 5, share your childhood favourites and the best new family film releases with your pre-schoolers, and we’ll bring you a warm drink and a slice of cake or a small popcorn, all included in the price of your ticket.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/d8b63d1b9ecc83333c81b0ffd2b3770b.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Toddler Club: Cars 2\",\"synopsis\":\"Star racecar Lightning McQueen and the incomparable tow truck Mater take their friendship to exciting new places in \\\"Cars 2\\\" when they compete in the first-ever World Grand Prix to determine the world's fastest car. But, the road to the championship is filled with plenty of potholes, detours and hilarious surprises when Mater gets caught up in an intriguing adventure of his own: international espionage.  \\n\\nTorn between assisting Lightning McQueen in the high-profile race and towing the line in a top-secret spy mission, Mater's action-packed journey leads him on an explosive chase through the streets of Japan and Europe, trailed by his friends and watched by the whole world.\\n\\nJoin us every Friday or Saturday for toddler-friendly cinema screenings. From ages 1 to 5, share your childhood favourites and the best new family film releases with your pre-schoolers, and we’ll bring you a warm drink and a slice of cake or a small popcorn, all included in the price of your ticket.\",\"certificate\":\"U\",\"casting\":[\"Larry The Cable Guy\",\"Owen Wilson\",\"Michael Caine\",\"Emily Mortimer\"],\"direction\":[\"John Lasseter\",\"Bradford Lewis\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/d8b63d1b9ecc83333c81b0ffd2b3770b.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/d8b63d1b9ecc83333c81b0ffd2b3770b.jpg\"],\"release\":\"2025-09-26T00:00:00.000Z\",\"advisory\":\"Contains mild violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Walt Disney\"}},{\"id\":\"1000011144\",\"title\":\"Toddler Club: Disney Junior Cinema Club\",\"runtime\":null,\"genres\":\"Family\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/cda97424a96ca8ca30e3bf6344cab336.jpg\",\"__typename\":\"Movie\",\"altId\":[\"374802\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"directors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"releases\":[{\"releasedAt\":\"2024-10-04T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[],\"distributors\":[{\"id\":\"24287\",\"name\":\"Independent\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Toddler Club: Disney Junior Cinema Club\",\"synopsis\":\"Audiences are invited to bring their little ones to enjoy the magic of Disney on the big screen, with a new fun-filled cinema experience featuring Mickey Mouse, Spidey and His Amazing Friends, Ariel, Bluey and more.\\nWhether it’s their first time in the cinema, or they regularly enjoy the movies, it’s one not to miss! DISNEY JUNIOR CINEMA CLUB 2024 brings together songs, interactive games, and episodes for pre-schoolers throughout the month of October.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/cda97424a96ca8ca30e3bf6344cab336.jpg\",\"synopsis\":\"Guests are invited to bring their little ones to enjoy the magic of Disney on the big screen, with a new fun-filled cinema experience featuring Mickey Mouse, Spidey and His Amazing Friends, Ariel, Bluey and more.\\n\\nJoin us every Friday or Saturday for toddler-friendly cinema screenings. From ages 1 to 5, share your childhood favourites and the best new family film releases with your pre-schoolers, and we’ll bring you a warm drink and a slice of cake or a small popcorn, all included in the price of your ticket.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/050739457cedce3fa93c13a3306c8f5f.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Toddler Club: Disney Junior Cinema Club\",\"synopsis\":\"Guests are invited to bring their little ones to enjoy the magic of Disney on the big screen, with a new fun-filled cinema experience featuring Mickey Mouse, Spidey and His Amazing Friends, Ariel, Bluey and more.\\n\\nJoin us every Friday or Saturday for toddler-friendly cinema screenings. From ages 1 to 5, share your childhood favourites and the best new family film releases with your pre-schoolers, and we’ll bring you a warm drink and a slice of cake or a small popcorn, all included in the price of your ticket.\",\"certificate\":\"U\",\"casting\":[],\"direction\":[],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/050739457cedce3fa93c13a3306c8f5f.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/050739457cedce3fa93c13a3306c8f5f.jpg\"],\"release\":\"2024-10-04T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Independent\"}},{\"id\":\"1000031381\",\"title\":\"Toddler Club: Dora: Magic Mermaid Adventures\",\"runtime\":3000,\"genres\":\"Animation, Family, Adventure, Comedy, Fantasy\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/bff4da3ed70f258c2a29562956641fb4.jpg\",\"__typename\":\"Movie\",\"altId\":[\"401176\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"directors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"releases\":[{\"releasedAt\":\"2025-10-03T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13760\",\"name\":\"Paramount Pictures UK\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Toddler Club: Dora: Magic Mermaid Adventures\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/bf/d4/bfd44d18fc2219817ca84a6c99456414.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/4065c40668ef7102fea46ca8eacc89ed.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/bff4da3ed70f258c2a29562956641fb4.jpg\",\"synopsis\":\"Dora and her best friend Boots are magically transformed into mermaids after playing a magical charango, leading them on an underwater adventure to help their new mermaid friend Marisol and her dolphin Rosa in the Mermaid Kingdom.\\n\\nJoin us every Friday or Saturday for toddler-friendly cinema screenings. From ages 1 to 5, share your childhood favourites and the best new family film releases with your pre-schoolers, and we’ll bring you a warm drink and a slice of cake or a small popcorn, all included in the price of your ticket.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Toddler Club: Dora: Magic Mermaid Adventures\",\"synopsis\":\"Dora and her best friend Boots are magically transformed into mermaids after playing a magical charango, leading them on an underwater adventure to help their new mermaid friend Marisol and her dolphin Rosa in the Mermaid Kingdom.\\n\\nJoin us every Friday or Saturday for toddler-friendly cinema screenings. From ages 1 to 5, share your childhood favourites and the best new family film releases with your pre-schoolers, and we’ll bring you a warm drink and a slice of cake or a small popcorn, all included in the price of your ticket.\",\"certificate\":\"U\",\"casting\":[],\"direction\":[],\"coDirection\":[],\"pictures\":[],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/4065c40668ef7102fea46ca8eacc89ed.jpg\"],\"release\":\"2025-10-03T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Paramount Pictures UK\"}},{\"id\":\"1000031413\",\"title\":\"Toddler Club: Tabby McTat + Room on the Broom\",\"runtime\":null,\"genres\":\"Animation\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/bb59b4db6613335040353355c490fd30.jpg\",\"__typename\":\"Movie\",\"altId\":[\"401212\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Various Directors\",\"lastName\":null,\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2025-10-31T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Toddler Club: Tabby McTat + Room on the Broom\",\"synopsis\":\"Tabby McTat is a purrr-fectly happy busker's cat, until one day he falls in love with Sock, a gorgeous green-eyed cat. But when his busker Fred is hurt and taken away to hospital, Tabby can't find him and misses him terribly.\\n\\nThe witch and her cat are happily flying through the sky on a broomstick when the wind picks up and blows away the witch's hat, then her bow, and then her wand!\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/28/bd/28bd2293e8f7a05e3140fec52edc8290.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/bb59b4db6613335040353355c490fd30.jpg\",\"synopsis\":\"Join us for a Toddler Club double-bill, featuring Julia Donaldson's famous children's tales on the big screen!\\n\\nTABBY MCTAT\\nTabby McTat is a purrr-fectly happy busker's cat, until one day he falls in love with Sock, a gorgeous green-eyed cat. But when his busker Fred is hurt and taken away to hospital, Tabby can't find him and misses him terribly.\\n\\nROOM ON THE BROOM\\nThe witch and her cat are happily flying through the sky on a broomstick when the wind picks up and blows away the witch's hat, then her bow, and then her wand!\\n\\nJoin us every Friday or Saturday for toddler-friendly cinema screenings. From ages 1 to 5, share your childhood favourites and the best new family film releases with your pre-schoolers, and we’ll bring you a warm drink and a slice of cake or a small popcorn, all included in the price of your ticket.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/c2af689a848d630f5e141cb687f38579.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Toddler Club: Tabby McTat + Room on the Broom\",\"synopsis\":\"Join us for a Toddler Club double-bill, featuring Julia Donaldson's famous children's tales on the big screen!\\n\\nTABBY MCTAT\\nTabby McTat is a purrr-fectly happy busker's cat, until one day he falls in love with Sock, a gorgeous green-eyed cat. But when his busker Fred is hurt and taken away to hospital, Tabby can't find him and misses him terribly.\\n\\nROOM ON THE BROOM\\nThe witch and her cat are happily flying through the sky on a broomstick when the wind picks up and blows away the witch's hat, then her bow, and then her wand!\\n\\nJoin us every Friday or Saturday for toddler-friendly cinema screenings. From ages 1 to 5, share your childhood favourites and the best new family film releases with your pre-schoolers, and we’ll bring you a warm drink and a slice of cake or a small popcorn, all included in the price of your ticket.\",\"certificate\":\"U\",\"casting\":[],\"direction\":[\"Various Directors\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/c2af689a848d630f5e141cb687f38579.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/c2af689a848d630f5e141cb687f38579.jpg\"],\"release\":\"2025-10-31T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000031399\",\"title\":\"Toddler Club: The Iron Giant\",\"runtime\":5100,\"genres\":\"Animation, Action, Adventure, Science fiction\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/7899e209510d5850b2ac213601050d3a.jpg\",\"__typename\":\"Movie\",\"altId\":[\"401195\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Brad\",\"lastName\":\"Bird\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Eli\",\"lastName\":\"Marienthal\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Vin\",\"lastName\":\"Diesel\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Jennifer\",\"lastName\":\"Aniston\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2025-10-17T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Toddler Club: The Iron Giant\",\"synopsis\":\"\\\"Iron Giant\\\" is based upon the 1968 story,'Iron Man,' by the British poet laureate Ted Hughes. The film is about a giant metal machine that drops from the sky and frightens a small town in Maine in 1958, only to find a friend named, Hogarth, that ultimately finds its humanity and saving the towns people of their fears and prejudices.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/28/93/2893b25cdbde32bdb48b90f310532f02.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/7899e209510d5850b2ac213601050d3a.jpg\",\"synopsis\":\"\\\"Iron Giant\\\" is based upon the 1968 story, 'Iron Man,' by the British poet laureate Ted Hughes. The film is about a giant metal machine that drops from the sky and frightens a small town in Maine in 1958, only to find a friend named, Hogarth, that ultimately finds its humanity and saving the towns people of their fears and prejudices.\\n\\nJoin us every Friday or Saturday for toddler-friendly cinema screenings. From ages 1 to 5, share your childhood favourites and the best new family film releases with your pre-schoolers, and we’ll bring you a warm drink and a slice of cake or a small popcorn, all included in the price of your ticket.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/b956fbd9bd21be794d65104025bd8262.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Toddler Club: The Iron Giant\",\"synopsis\":\"\\\"Iron Giant\\\" is based upon the 1968 story, 'Iron Man,' by the British poet laureate Ted Hughes. The film is about a giant metal machine that drops from the sky and frightens a small town in Maine in 1958, only to find a friend named, Hogarth, that ultimately finds its humanity and saving the towns people of their fears and prejudices.\\n\\nJoin us every Friday or Saturday for toddler-friendly cinema screenings. From ages 1 to 5, share your childhood favourites and the best new family film releases with your pre-schoolers, and we’ll bring you a warm drink and a slice of cake or a small popcorn, all included in the price of your ticket.\",\"certificate\":\"PG\",\"casting\":[\"Eli Marienthal\",\"Vin Diesel\",\"Jennifer Aniston\"],\"direction\":[\"Brad Bird\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/b956fbd9bd21be794d65104025bd8262.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/b956fbd9bd21be794d65104025bd8262.jpg\"],\"release\":\"2025-10-17T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"}},{\"id\":\"1000006784\",\"title\":\"Toddler Club: The Snail & the Whale + Zog and the Flying Doctors\",\"runtime\":3120,\"genres\":\"Animation, Adventure, Comedy\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/acc774aea87c6cc110b4ae71cb207a38.jpg\",\"__typename\":\"Movie\",\"altId\":[\"369049\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Max\",\"lastName\":\"Lang\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Daniel\",\"lastName\":\"Snaddon\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Diana\",\"lastName\":\"Rigg\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sally\",\"lastName\":\"Hawkins\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rob\",\"lastName\":\"Brydon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2024-08-16T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"very mild injury detail, threat, violence\",\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[],\"distributors\":[{\"id\":\"6209\",\"name\":\"Magic Light Pictures\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Toddler Club: Zog + Snail & the Whale\",\"synopsis\":\"THE SNAIL AND THE WHALE is a children's animation in which a snail with wanderlust goes on an adventure with a humpback whale.\\nZOG AND THE FLYING DOCTORS is a family animation in which a princess dreams of becoming a doctor.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/0f/37/0f3736e4294a797141975c312eab63a0.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"embargoes\":[],\"exhibitor\":{\"title\":\"Toddler Club: The Snail & the Whale + Zog and the Flying Doctors\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/acc774aea87c6cc110b4ae71cb207a38.jpg\",\"synopsis\":\"Join us for a Toddler Club double-bill, featuring Julia Donaldson's famous children's tales on the big screen!\\n\\nTHE SNAIL & THE WHALE\\nA tiny snail sets out to see the world and hitches a ride on the tail of a friendly humpback whale. A joyous, empowering story about the world's natural wonders and discovering that you can make a difference no matter how small you are.\\n\\nZOG & THE FLYING DOCTORS\\nZog and his friends are now a flying doctor trio, caring for creatures including a mermaid, a unicorn and a lion. However, when bad weather forces them to land at the palace, the princess is locked up by her uncle, the king.\\n\\nJoin us every Friday or Saturday for toddler-friendly cinema screenings. From ages 1 to 5, share your childhood favourites and the best new family film releases with your pre-schoolers, and we’ll bring you a warm drink and a slice of cake or a small popcorn, all included in the price of your ticket.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/d65898f376f8d0e5b0571477e153daa0.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Toddler Club: Snail and the Whale + Zog and the Flying Doctors\",\"synopsis\":\"Join us for a Toddler Club double-bill, featuring Julia Donaldson's famous children's tales on the big screen!\\n\\nTHE SNAIL & THE WHALE\\nA tiny snail sets out to see the world and hitches a ride on the tail of a friendly humpback whale. A joyous, empowering story about the world's natural wonders and discovering that you can make a difference no matter how small you are.\\n\\nZOG & THE FLYING DOCTORS\\nZog and his friends are now a flying doctor trio, caring for creatures including a mermaid, a unicorn and a lion. However, when bad weather forces them to land at the palace, the princess is locked up by her uncle, the king.\\n\\nJoin us every Friday or Saturday for toddler-friendly cinema screenings. From ages 1 to 5, share your childhood favourites and the best new family film releases with your pre-schoolers, and we’ll bring you a warm drink and a slice of cake or a small popcorn, all included in the price of your ticket.\",\"certificate\":\"U\",\"casting\":[\"Diana Rigg\",\"Sally Hawkins\",\"Rob Brydon\"],\"direction\":[\"Max Lang\",\"Daniel Snaddon\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/d65898f376f8d0e5b0571477e153daa0.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/d65898f376f8d0e5b0571477e153daa0.jpg\"],\"release\":\"2024-08-16T00:00:00.000Z\",\"advisory\":\"very mild injury detail, threat, violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Magic Light Pictures\"}},{\"id\":\"194887\",\"title\":\"Tron: Ares\",\"runtime\":7140,\"genres\":\"Science fiction, Action\",\"__typename\":\"Movie\",\"altId\":[\"357794\",\"388384\",\"393929\",\"393930\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/94505859ff3e460c63e36c3a49b97e98.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/86/b5/86b5538946f56a2414396143093a3bec.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/80/9b/809ba3cb6c1cbf9da5fc32ea1afdd86c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/31/58/3158bfee95e1b4334857a1675c1e3bb8.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/62/00/62007bd56d8debfd5170e51e6cf97ec5.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/0f/7c/0f7c9811e92e6b32c98e9c3f0d9d3a09.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/2a/9e/2a9e3b3c0d5dfdd14f57eea8bf072d2a.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/89/