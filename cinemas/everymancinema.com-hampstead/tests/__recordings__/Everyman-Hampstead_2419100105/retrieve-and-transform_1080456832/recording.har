ertificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Depeche Mode: M\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/43/fa/43fa0cb54eb5db633f6b854b08a33fc8.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/fd8f24d486e66bf6e82cf205c255b8ea.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/e8d62724a7ca2f551489658a804a1186.jpg\",\"synopsis\":\"Directed by award-winning filmmaker Fernando Frias, and making its debut at this year’s Tribeca Film Festival, DEPECHE MODE: M weaves footage from the three sold-out shows at Mexico’s City’s Foro Sol Stadium, and takes audiences on a profound musical journey using nearly 200,000 Mexican fans’ fervent connection with the band as a window into the band’s timeless global influence, and a powerful tribute to the unbreakable connection between music, tradition and the human spirit.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/f41efde7fec44cb8df94621db069ac5d.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Depeche Mode: M\",\"synopsis\":\"Directed by award-winning filmmaker Fernando Frias, and making its debut at this year’s Tribeca Film Festival, DEPECHE MODE: M weaves footage from the three sold-out shows at Mexico’s City’s Foro Sol Stadium, and takes audiences on a profound musical journey using nearly 200,000 Mexican fans’ fervent connection with the band as a window into the band’s timeless global influence, and a powerful tribute to the unbreakable connection between music, tradition and the 