n\",\"Oleksandr Usyk\",\"Ryan Bader\",\"Zoe Kosovic\",\"Bas Rutten\",\"Paul Cheng\",\"Yoko Hamamura\",\"Roberto \\\"Cyborg\\\" Abreu\"],\"direction\":[\"Benny Safdie\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/a4de6435531eb19df7877f75c4006f73.jpg\",\"img/07/af/07af61afd2b1d6b8e41f67213a035801.png\",\"img/3b/7e/3b7ebfdd556155c59e56aeca11f1e837.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/a4de6435531eb19df7877f75c4006f73.jpg\",\"https://cms-assets.webediamovies.pro/production/2/ea0d675eb0b530eecc15888e84a11eb7.jpg\"],\"release\":\"2025-10-03T00:00:00.000Z\",\"advisory\":\"Contains strong language, bloody violence and hard drug use\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Entertainment Film Distribution\"}},{\"id\":\"1000022508\",\"title\":\"The Sound of Music (60th Anniversary)\",\"runtime\":10740,\"genres\":\"Musical, Family\",\"__typename\":\"Movie\",\"altId\":[\"390056\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/1240f2c14bcced4737ec664d8be17a23.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Robert\",\"lastName\":\"Wise\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Julie\",\"lastName\":\"Andrews\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christopher\",\"lastName\":\"Plummer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Richard\",\"lastName\":\"Haydn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Peggy\",\"lastName\":\"Wood\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Eleanor\",\"lastName\":\"Parker\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-20T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"no material likely to offend or harm\",\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"The Sound of Music 60th Anniversary\",\"synopsis\":\"Experience the breathtaking theatrical presentation of Rodgers & Hammerstein's™ iconic\\nmusical film “The Sound of Music.” Meticulously restored and remastered in 4K for its 60th\\nanniversary, the beloved classic is more brilliant than ever with pristine picture and sound.\\nIn this true-life story, Julie Andrews lights up the screen as Maria, a spirited young woman who\\nleaves the convent and becomes a governess to the seven unruly children of Captain von Trapp\\n(Christopher Plummer). Her warmth, charm and songs soon win the hearts of the children and\\ntheir father. But when the threat of war rises, Maria is forced to attempt a daring escape with her\\nnew family.\\nOne of the most successful movie musicals of all time, “The Sound of Music” features\\nunforgettable treasures like “Edelweiss,” “My Favorite Things,” “Climb Ev’ry Mountain” and “Do-\\nRe-Mi.”\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/6c/c6/6cc668c6a63c7560315bc6c908c15fb5.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/454fdf4aca7cae76fe03af542c9b45af.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":\"The Sound of Music (60th Anniversary)\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/1240f2c14bcced4737ec664d8be17a23.jpg\",\"synopsis\":\"Experience the breathtaking theatrical presentation of Rodgers & Hammerstein's® iconic musical film The Sound of Music. Meticulously restored and remastered in 4K for its 60th anniversary, the beloved classic is more brilliant than ever with pristine picture and sound. \\n\\nIn this true-life story, Julie Andrews lights up the screen as Maria, a spirited young woman who leaves the convent and becomes a governess to the seven unruly children of Captain von Trapp (Christopher Plummer). Her warmth, charm and songs soon win the hearts of the children and their father. But when the threat of war rises, Maria is forced to attempt a daring escape with her new family. One of the most successful movie musicals of all time, The Sound of Music features unforgettable treasures like “Edelweiss,” “My Favorite Things,” “Climb Ev’ry Mountain” and “Do-Re-Mi.”\\n\\nThis Fathom’s Big Screen Classics release includes exclusive insights from Leonard Maltin.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/33e2f6df66dde4538d71884e091df9eb.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Sound of Music 60th Anniversary\",\"synopsis\":\"Experience the breathtaking theatrical presentation of Rodgers & Hammerstein's® iconic musical film The Sound of Music. Meticulously restored and remastered in 4K for its 60th anniversary, the beloved classic is more brilliant than ever with pristine picture and sound. \\n\\nIn this true-life story, Julie Andrews lights up the screen as Maria, a spirited young woman who leaves the convent and becomes a governess to the seven unruly children of Captain von Trapp (Christopher Plummer). Her warmth, charm and songs soon win the hearts of the children and their father. But when the threat of war rises, Maria is forced to attempt a daring escape with her new family. One of the most successful movie musicals of all time, The Sound of Music features unforgettable treasures like “Edelweiss,” “My Favorite Things,” “Climb Ev’ry Mountain” and “Do-Re-Mi.”\\n\\nThis Fathom’s Big Screen Classics release includes exclusive insights from Leonard Maltin.\",\"certificate\":\"U\",\"casting\":[\"Julie Andrews\",\"Christopher Plummer\",\"Richard Haydn\",\"Peggy Wood\",\"Eleanor Parker\"],\"direction\":[\"Robert Wise\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/33e2f6df66dde4538d71884e091df9eb.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/33e2f6df66dde4538d71884e091df9eb.jpg\",\"https://cms-assets.webediamovies.pro/production/2/454fdf4aca7cae76fe03af542c9b45af.jpg\"],\"release\":\"2025-09-20T00:00:00.000Z\",\"advisory\":\"no material likely to offend or harm\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"293331\",\"title\":\"The SpongeBob Movie: Search for SquarePants\",\"runtime\":null,\"genres\":\"Comedy, Family, Animation\",\"__typename\":\"Movie\",\"altId\":[\"352307\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/3d463af87fbf989147fb3bfe4178c609.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/f7/9e/f79e7d9fd4dc4dc4aa06128b5fee3be8.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/76/1a/761a7c86d4aa7e6dcb8b880ea0681e91.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/81/a4/81a4055cc8b0d2f4bec8da38c9f5855c.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Derek\",\"lastName\":\"Drymon\",\"__typename\":\"