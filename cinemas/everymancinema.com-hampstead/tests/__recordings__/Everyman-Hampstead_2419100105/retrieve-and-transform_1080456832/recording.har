\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/62/fa/62fafff80499a1021a6dfa8154ce2d26.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/74aaa9ef5c5af10d537ad8b323e8a2aa.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/6c1ec6c0f0490c0a922b6139aa4d66b4.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"La La Land\",\"synopsis\":\"The story of Mia, an aspiring actress, and Sebastian, a dedicated jazz musician, struggling to make ends meet while pursuing their dreams in a city known for destroying hopes and breaking hearts. With modern day Los Angeles as the backdrop, this musical about everyday life explores what is more important: a once-in-a-lifetime love or the spotlight.  \\n\\n\",\"certificate\":\"12A\",\"casting\":[\"Ryan Gosling\",\"Emma Stone\",\"John Legend\",\"J.K. Simmons\",\"Rosemarie DeWitt\",\"Finn Wittrock\",\"Callie Hernandez\",\"Sonoya Mizuno\",\"Jessica Rothe\",\"Tom Everett Scott\"],\"direction\":[\"Damien Chazelle\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/6c1ec6c0f0490c0a922b6139aa4d66b4.jpg\",\"pictures/16/08/24/15/06/075819.jpg\",\"pictures/16/08/16/14/59/514017.jpg\",\"pictures/16/08/24/15/06/388664.jpg\",\"pictures/16/08/24/15/07/152899.jpg\",\"pictures/16/09/21/15/19/540635.jpg\",\"pictures/16/09/23/10/09/287381.jpg\",\"pictures/16/11/01/09/28/321693.jpg\",\"pictures/16/11/11/10/13/159165.jpg\",\"pictures/16/11/16/11/10/488406.jpg\",\"pictures/16/11/16/11/10/489969.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/6c1ec6c0f0490c0a922b6139aa4d66b4.jpg\"],\"release\":\"2017-01-13T00:00:00.000Z\",\"advisory\":\"infrequent strong language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Lionsgate UK\"}},{\"id\":\"1000031386\",\"title\":\"Late Nights: After Hours\",\"runtime\":5880,\"genres\":\"Comedy\",\"__typename\":\"Movie\",\"altId\":[\"401181\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/b2fc69f6e867d15ba01f35210342212f.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Martin\",\"lastName\":\"Scorsese\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Griffin\",\"lastName\":\"Dunne\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rosanna\",\"lastName\":\"Arquette\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Verna\",\"lastName\":\"Bloom\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-10-03T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Late Nights: After Hours\",\"synopsis\":\"A slightly nerdy yuppie ends up going to SoHo one night for what he hopes will be a nice date, but ends up getting caught up in one weird turn of events after another with a menagerie of oddball characters. Soon, he finds himself the accused suspect in a string of burglaries in the neighborhood, becomes the object of a witch hunt by a posse of SoHo denizens, and can't find a way to get back uptown to where he lives.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/8e/d5/8ed56ed2caba8bdabe046e3e2555f5c2.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/b2fc69f6e867d15ba01f35210342212f.jpg\",\"synopsis\":\"A slightly nerdy yuppie ends up going to SoHo one night for what he hopes will be a nice date, but ends up getting caught up in one weird turn of events after another with a menagerie of oddball characters. Soon, he finds himself the accused suspect in a string of burglaries in the neighbourhood, becomes the object of a witch hunt by a posse of SoHo denizens, and can't find a way to get back uptown to where he lives.\\n\\nScreening as part of our Late Nights season.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/5891bc9efd7581123e9307d040a32a64.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Late Nights: After Hours\",\"synopsis\":\"A slightly nerdy yuppie ends up going to SoHo one night for what he hopes will be a nice date, but ends up getting caught up in one weird turn of events after another with a menagerie of oddball characters. Soon, he finds himself the accused suspect in a string of burglaries in the neighbourhood, becomes the object of a witch hunt by a posse of SoHo denizens, and can't find a way to get back uptown to where he lives.\\n\\nScreening as part of our Late Nights season.\",\"certificate\":\"15\",\"casting\":[\"Griffin Dunne\",\"Rosanna Arquette\",\"Verna Bloom\"],\"direction\":[\"Martin Scorsese\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/5891bc9efd7581123e9307d040a32a64.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/5891bc9efd7581123e9307d040a32a64.jpg\"],\"release\":\"2025-10-03T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"1000031401\",\"title\":\"Late Nights: Good Time\",\"runtime\":6060,\"genres\":\"Thriller, Detective\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/08e18d759e987ae96872bc1a75c71ec9.jpg\",\"__typename\":\"Movie\",\"altId\":[\"401197\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Benny\",\"lastName\":\"Safdie\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Pattinson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Benny\",\"lastName\":\"Safdie\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Buddy\",\"lastName\":\"Duress\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-10-17T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"679\",\"name\":\"Curzon\",\"__typename\":\"Company\"},{\"id\":\"1000107175\",\"name\":\"A24\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Late Nights: Good Time\",\"synopsis\":\"After a botched bank robbery lands his younger brother in prison, Constantine Nikas (Robert Pattinson) embarks on a twisted odyssey through New York City's underworld in an increasingly desperateand dangerousattempt to get his brother out of jail. Over the course of one adrenalized night, Constantine finds himself on a mad descent into violence and mayhem as he races against the clock to save his brother and himself, knowing their lives hang in the balance.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/98/87/9887d96e04012e3b5eb5db1b24a6c4a9.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/08e18d759e987ae96872bc1a75c71ec9.jpg\",\"synopsis\":\"After a botched bank robbery lands his younger brother in prison, Constantine Nikas (Robert Pattinson) embarks on a twisted odyssey through New York City's underworld in an increasingly desperateand dangerous attempt to get his brother out of jail. \\n\\nOver the course of one adrenalised night, Constantine finds himself on a mad descent into violence and mayhem as he races against the clock to save his brother and himself, knowing their lives hang in the balance.\\n\\nScreening as part of our Late Nights season.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/8a623f03ac0fb7d3055b233ad24356a3.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Late Nights: Good Time\",\"synopsis\":\"After a botched bank robbery lands his younger brother in prison, Constantine Nikas (Robert Pattinson) embarks on a twisted odyssey through New York City's underworld in an increasingly desperateand dangerous attempt to get his brother out of jail. \\n\\nOver the course of one adrenalised night, Constantine finds himself on a mad descent into violence and mayhem as he races against the clock to save his brother and himself, knowing their lives hang in the balance.\\n\\nScreening as part of our Late Nights season.\",\"certificate\":\"15\",\"casting\":[\"Robert Pattinson\",\"Benny Safdie\",\"Buddy Duress\"],\"direction\":[\"Benny Safdie\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/8a623f03ac0fb7d3055b233ad24356a3.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/8a623f03ac0fb7d3055b233ad24356a3.jpg\"],\"release\":\"2025-10-17T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Curzon\"}},{\"id\":\"324717\",\"title\":\"Late Nights: Reservoir Dogs\",\"runtime\":5940,\"genres\":\"Action, Adventure, Drama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/108753b00eeff3a75bddf0951b3e65d8.jpg\",\"__typename\":\"Movie\",\"altId\":[\"355298\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Quentin\",\"lastName\":\"Tarantino\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Harvey\",\"lastName\":\"Keitel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tim\",\"lastName\":\"Roth\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Chris\",\"lastName\":\"Penn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2024-01-12T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong bloody violence\",\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[],\"distributors\":[{\"id\":\"33730\",\"name\":\"J. Arthur Rank Film Distributors\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Late Nights: Reservoir Dogs\",\"synopsis\":\"\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/108753b00eeff3a75bddf0951b3e65d8.jpg\",\"synopsis\":\"Six criminals, hired to steal diamonds, do not know each other's true identity. While attempting the heist, the police ambushes them, leading them to believe that one of them is an undercover officer.\\n\\nScreening as part of our Late Nights Season.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/eb77ecdbbc5fada5d469d7b12db69afe.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Late Nights: Reservoir Dogs\",\"synopsis\":\"Six criminals, hired to steal diamonds, do not know each other's true identity. While attempting the heist, the police ambushes them, leading them to believe that one of them is an undercover officer.\\n\\nScreening as part of our Late Nights Season.\",\"certificate\":\"18\",\"casting\":[\"Harvey Keitel\",\"Tim Roth\",\"Chris Penn\"],\"direction\":[\"Quentin Tarantino\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/eb77ecdbbc5fada5d469d7b12db69afe.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/eb77ecdbbc5fada5d469d7b12db69afe.jpg\"],\"release\":\"2024-01-12T00:00:00.000Z\",\"advisory\":\"strong bloody violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"J. Arthur Rank Film Distributors\"}},{\"id\":\"1000001074\",\"title\":\"Late Nights: The Crow\",\"runtime\":null,\"genres\":\"Action, Drama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4b30d26dbeca65628efecd6f59639bd3.jpg\",\"__typename\":\"Movie\",\"altId\":[\"360664\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Alex\",\"lastName\":\"Proyas\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brandon\",\"lastName\":\"Lee\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Wincott\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rochelle\",\"lastName\":\"Davis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2024-05-31T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]},{\"releasedAt\":\"2025-09-26T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"Contains strong language and violence\",\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[],\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Late Nights: The Crow\",\"synopsis\":\"The Crow is the tale of a young musician Eric Draven who, along with his fiancé, is murdered on the eve of their Halloween wedding. Exactly one year after their deaths, Eric is risen from the grave by a mysterious crow to seek out his killers and force them to answer for their crimes.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/74/96/749635fd2c0186b49e4da1d65a9317e7.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/4b30d26dbeca65628efecd6f59639bd3.jpg\",\"synopsis\":\"Eric Draven and his fiancée are brutally murdered. When he mysteriously returns from the dead with the help of a crow, it begins to guide him to his killers.\\n\\nScreening as part of our Late Nights Season.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/09108f62e2a9aacd63b81000588355d8.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Late Nights: The Crow (1994)\",\"synopsis\":\"Eric Draven and his fiancée are brutally murdered. When he mysteriously returns from the dead with the help of a crow, it begins to guide him to his killers.\\n\\nScreening as part of our Late Nights Season.\",\"certificate\":null,\"casting\":[\"Brandon Lee\",\"Michael Wincott\",\"Rochelle Davis\"],\"direction\":[\"Alex Proyas\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/09108f62e2a9aacd63b81000588355d8.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/09108f62e2a9aacd63b81000588355d8.jpg\"],\"release\":\"2024-05-31T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000031412\",\"title\":\"Late Nights: The Descent (20th Anniversary)\",\"runtime\":5940,\"genres\":\"Horror\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/14efab659744d173d7ed0d52782b08f3.jpg\",\"__typename\":\"Movie\",\"altId\":[\"401211\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Neil\",\"lastName\":\"Marshall\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Molly\",\"lastName\":\"Kayll\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Natalie\",\"lastName\":\"Jackson Mendoza\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Shauna\",\"lastName\":\"Macdonald\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-24T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Late Nights: The Descent (20th Anniversary)\",\"synopsis\":\"In a remote mountain range, six girlfriends meet for their yearly adventure, a caving trip into the arteries of the earth. The group makes their way through the remote cave system, enjoying the hazardous but beautiful surroundings. Then, deep inside the cave, disaster strikes when their route back to the surface is blocked by a rock fall. When they learn that Juno, always pushing herself that little bit further, has brought them to an unexplored cave, and that no one is coming to rescue them, the group starts to splinter. Left with no other option, they push on through the cave, praying for another exit. The women battle through this harsh underground world, pitting their strength and determination against each new challenge. Unbeknownst to them, there is something else lurking under the earth, a race of monstrous creatures hidden from the light, evolved to live perfectly in the dark. As the friends realize they have become prey, they are forced to unleash their most primal instincts to face the creatures. As old wounds break open and loyalties disintegrate, the women realize the horrible truth-they have most to fear from one another.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/14efab659744d173d7ed0d52782b08f3.jpg\",\"synopsis\":\"One year following a horrendous and tragic accident, six girlfriends meet for their yearly adventure in a remote part of the Appalachians for a caving trip into the arteries of the earth.  Deep inside the caves, disaster strikes again when a rockfall blocks their route back to the surface.  The girls learn that Juno, the leader of the expedition who is always pushing herself that bit further, has brought them to an unexplored cave and that no one is coming to rescue them.  The group splinters and each push on, praying for another exit.  But, there is something else lurking under the earth - a race of monstrous humanoid creatures that are adapted perfectly to life in the dark. As the friends realise they are the prey, they unleash their most primal instincts in an all-out war against an unspeakable horror - one that attacks without warning, again and again and again. \\n\\nScreening as part of our Late Nights season.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/4bcb19542088a9eea1334659852bdcf3.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Late Nights: The Descent (20th Anniversary)\",\"synopsis\":\"One year following a horrendous and tragic accident, six girlfriends meet for their yearly adventure in a remote part of the Appalachians for a caving trip into the arteries of the earth.  Deep inside the caves, disaster strikes again when a rockfall blocks their route back to the surface.  The girls learn that Juno, the leader of the expedition who is always pushing herself that bit further, has brought them to an unexplored cave and that no one is coming to rescue them.  The group splinters and each push on, praying for another exit.  But, there is something else lurking under the earth - a race of monstrous humanoid creatures that are adapted perfectly to life in the dark. As the friends realise they are the prey, they unleash their most primal instincts in an all-out war against an unspeakable horror - one that attacks without warning, again and again and again. \\n\\nScreening as part of our Late Nights season.\",\"certificate\":null,\"casting\":[\"Molly Kayll\",\"Natalie Jackson Mendoza\",\"Shauna Macdonald\"],\"direction\":[\"Neil Marshall\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/4bcb19542088a9eea1334659852bdcf3.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/4bcb19542088a9eea1334659852bdcf3.jpg\"],\"release\":\"2025-10-24T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"268362\",\"title\":\"Lilo & Stitch\",\"runtime\":6480,\"genres\":\"Adventure, Science fiction, Comedy, Family\",\"__typename\":\"Movie\",\"altId\":[\"372073\",\"391927\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c14e1df6d14b0149841c2fb78929a4ce.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/66/d7/66d738930e29a2e90c8cfdb46d6e8301.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/00/51/0051b512804b7920d53fdbc7d6fcc1e1.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/6c/fa/6cfa028e53d4ddfda816a74a5a76bcaf.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/53/f1/53f11f55f969c86bab96aab3c370ee40.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/19/a1/19a15bdd3beeb8ea822b16e5b3961bd9.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/d9/d0/d9d03dfaec14cb1b8cf13476e9568193.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/47/d9/47d9afb0c90bedd85a87704775911479.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/83/93/83931afce397589f2c774e5058a242e8.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/6b/d0/6bd0947c119311665aee56a12e3dd1bc.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/b9/fc/b9fc0c1ef26e7935d9c966e30afcf818.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Dean\",\"lastName\":\"Fleischer Camp\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Chris\",\"lastName\":\"Sanders\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maia\",\"lastName\":\"Kealoha\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sydney Elizabeth\",\"lastName\":\"Agudong\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Courtney B.\",\"lastName\":\"Vance\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Zach\",\"lastName\":\"Galifianakis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Billy\",\"lastName\":\"Magnussen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tia\",\"lastName\":\"Carrere\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Amy\",\"lastName\":\"Hill\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jason\",\"lastName\":\"Scott Lee\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Hannah\",\"lastName\":\"Wadddingham\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2025-05-21T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"very mild threat, violence, upsetting scenes, rude humour, language\",\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[],\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Lilo & Stitch\",\"synopsis\":\"A live-action reimagining of Disney’s 2002 animated classic, “Lilo & Stitch” is the wildly funny and touching story of a lonely Hawaiian girl and the fugitive alien who helps to mend her broken family. Directed by Dean Fleischer Camp, the Oscar®-nominated filmmaker behind the animated feature film “Marcel the Shell with Shoes On,” the film stars Sydney Elizebeth Agudong, Billy Magnussen, Tia Carrere, Hannah Waddingham, Chris Sanders, with Courtney B. Vance, and Zach Galifianakis, introducing Maia Kealoha. “Lilo & Stitch” is produced by Jonathan Eirich, p.g.a. and Dan Lin, with Louie Provost, Tom Peitzman and Ryan Halprin serving as executive producers.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/372073_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/372073_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/73/46/73462e357cc15f90d1db15902ff4613f.jpeg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/c14e1df6d14b0149841c2fb78929a4ce.jpg\",\"synopsis\":\"A live-action reimagining of Disney’s 2002 animated classic, “Lilo & Stitch” stars Maia Kealoha as Lilo, with original “Lilo & Stitch” writer & director Chris Sanders reprising his voice role as Stitch.\\n\\nA wildly funny and heart touching story of a lonely orphaned Hawaiian girl, Lilo (Maia Kealoha) and her adopted new best friend, an unruly alien genetic experiment known as Experiment 626, or Stitch (Chris Sanders). Whilst Stitch destroys everything in his path, he may just help to mend a broken family.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/d0e3da9cfd9255300af928171e691376.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Lilo & Stitch\",\"synopsis\":\"A live-action reimagining of Disney’s 2002 animated classic, “Lilo & Stitch” stars Maia Kealoha as Lilo, with original “Lilo & Stitch” writer & director Chris Sanders reprising his voice role as Stitch.\\n\\nA wildly funny and heart touching story of a lonely orphaned Hawaiian girl, Lilo (Maia Kealoha) and her adopted new best friend, an unruly alien genetic experiment known as Experiment 626, or Stitch (Chris Sanders). Whilst Stitch destroys everything in his path, he may just help to mend a broken family.\",\"certificate\":\"U\",\"casting\":[\"Chris Sanders\",\"Maia Kealoha\",\"Sydney Elizabeth Agudong\",\"Courtney B. Vance\",\"Zach Galifianakis\",\"Billy Magnussen\",\"Tia Carrere\",\"Amy Hill\",\"Jason Scott Lee\",\"Hannah Wadddingham\"],\"direction\":[\"Dean Fleischer Camp\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/d0e3da9cfd9255300af928171e691376.jpg\",\"img/66/d7/66d738930e29a2e90c8cfdb46d6e8301.jpg\",\"img/00/51/0051b512804b7920d53fdbc7d6fcc1e1.jpg\",\"img/6c/fa/6cfa028e53d4ddfda816a74a5a76bcaf.jpg\",\"img/53/f1/53f11f55f969c86bab96aab3c370ee40.jpg\",\"img/19/a1/19a15bdd3beeb8ea822b16e5b3961bd9.jpg\",\"img/d9/d0/d9d03dfaec14cb1b8cf13476e9568193.jpg\",\"img/47/d9/47d9afb0c90bedd85a87704775911479.jpg\",\"img/83/93/83931afce397589f2c774e5058a242e8.jpg\",\"img/6b/d0/6bd0947c119311665aee56a12e3dd1bc.jpg\",\"img/b9/fc/b9fc0c1ef26e7935d9c966e30afcf818.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/d0e3da9cfd9255300af928171e691376.jpg\"],\"release\":\"2025-05-21T00:00:00.000Z\",\"advisory\":\"very mild threat, violence, upsetting scenes, rude humour, language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/372073_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/372073_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Walt Disney\"}},{\"id\":\"109815\",\"title\":\"Little Miss Sunshine\",\"runtime\":6000,\"genres\":\"Comedy, Drama\",\"__typename\":\"Movie\",\"altId\":[\"52559\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/468c9506a25d882d56f71a42e817eb88.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898283.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898282.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898281.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898280.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898279.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898278.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898277.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898276.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898275.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898274.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jonathan\",\"lastName\":\"Dayton\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Valerie\",\"lastName\":\"Faris\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Abigail\",\"lastName\":\"Breslin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Greg\",\"lastName\":\"Kinnear\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Paul\",\"lastName\":\"Dano\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alan\",\"lastName\":\"Arkin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Toni\",\"lastName\":\"Collette\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Steve\",\"lastName\":\"Carell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alissa\",\"lastName\":\"Anderegg\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cassandra\",\"lastName\":\"Ashe\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jerry\",\"lastName\":\"Giles\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Beth\",\"lastName\":\"Grant\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2006-06-28T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong language, drug use\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"12435\",\"name\":\"20th Century Studios\",\"__typename\":\"Company\"}]},{\"releasedAt\":\"2026-02-26T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong language, sex references, drug misuse\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"12435\",\"name\":\"20th Century Studios\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Little Miss Sunshine\",\"synopsis\":\"The Hoover family treks from Albuquerque to the Little Miss Sunshine pageant in Redondo Beach, California, to fulfill the deepest wish of 7-year-old Olive, an ordinary little girl with big dreams. Along the way the family must deal with crushed dreams, heartbreaks, and a broken-down VW bus, leading up to the surreal Little Miss Sunshine competition itself. On their travels through this bizarre landscape, the Hoovers learn to trust and support each other along the path of life, no matter what the challenge.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/e4/c1/e4c1d260d62f0a1603507c3aabbe9723.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/468c9506a25d882d56f71a42e817eb88.jpg\",\"synopsis\":\"Selected by the Producers Branch, Everyman presents: Little Miss Sunshine\\n\\nThe Hoover family -- a man (Greg Kinnear), his wife (Toni Collette), an uncle (Steve Carell), a brother (Paul Dano) and a grandfather (Alan Arkin) -- puts the fun back in dysfunctional by piling into a VW bus and heading to California to support a daughter (Abigail Breslin) in her bid to win the Little Miss Sunshine Contest. The sanity of everyone involved is stretched to the limit as the group's quirks cause epic problems as they travel along their interstate route.\\n\\nSeven-year-old Olive and her dysfunctional family pile into a trouble-plagued Volkswagen van and road-trip to a child beauty contest in this sleeper hit directed by the team of Jonathan Dayton and Valerie Faris and produced by David T. Friendly, Peter Saraf, Marc Turtletaub, Albert Berger, and Ron Yerxa. The film received four nominations including, Best Picture. Michael Arndt’s Oscar-winning original screenplay deftly blends comedy and drama and is headed by a stellar cast including newcomer Abigail Breslin (who was nominated for her performance), Greg Kinnear, Toni Collette, and Alan Arkin, who won Best Supporting Actor for playing the family’s cranky patriarch.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 26 February.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/b87b568f0d7932cc383adce6cc84a00a.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Little Miss Sunshine\",\"synopsis\":\"Selected by the Producers Branch, Everyman presents: Little Miss Sunshine\\n\\nThe Hoover family -- a man (Greg Kinnear), his wife (Toni Collette), an uncle (Steve Carell), a brother (Paul Dano) and a grandfather (Alan Arkin) -- puts the fun back in dysfunctional by piling into a VW bus and heading to California to support a daughter (Abigail Breslin) in her bid to win the Little Miss Sunshine Contest. The sanity of everyone involved is stretched to the limit as the group's quirks cause epic problems as they travel along their interstate route.\\n\\nSeven-year-old Olive and her dysfunctional family pile into a trouble-plagued Volkswagen van and road-trip to a child beauty contest in this sleeper hit directed by the team of Jonathan Dayton and Valerie Faris and produced by David T. Friendly, Peter Saraf, Marc Turtletaub, Albert Berger, and Ron Yerxa. The film received four nominations including, Best Picture. Michael Arndt’s Oscar-winning original screenplay deftly blends comedy and drama and is headed by a stellar cast including newcomer Abigail Breslin (who was nominated for her performance), Greg Kinnear, Toni Collette, and Alan Arkin, who won Best Supporting Actor for playing the family’s cranky patriarch.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 26 February.\",\"certificate\":\"15\",\"casting\":[\"Abigail Breslin\",\"Greg Kinnear\",\"Paul Dano\",\"Alan Arkin\",\"Toni Collette\",\"Steve Carell\",\"Alissa Anderegg\",\"Cassandra Ashe\",\"Jerry Giles\",\"Beth Grant\"],\"direction\":[\"Jonathan Dayton\",\"Valerie Faris\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/b87b568f0d7932cc383adce6cc84a00a.jpg\",\"medias/nmedia/18/87/18/90/19898283.jpg\",\"medias/nmedia/18/87/18/90/19898282.jpg\",\"medias/nmedia/18/87/18/90/19898281.jpg\",\"medias/nmedia/18/87/18/90/19898280.jpg\",\"medias/nmedia/18/87/18/90/19898279.jpg\",\"medias/nmedia/18/87/18/90/19898278.jpg\",\"medias/nmedia/18/87/18/90/19898277.jpg\",\"medias/nmedia/18/87/18/90/19898276.jpg\",\"medias/nmedia/18/87/18/90/19898275.jpg\",\"medias/nmedia/18/87/18/90/19898274.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/b87b568f0d7932cc383adce6cc84a00a.jpg\"],\"release\":\"2006-06-28T00:00:00.000Z\",\"advisory\":\"strong language, drug use\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"20th Century Studios\"}},{\"id\":\"1000029251\",\"title\":\"Luca  - Seeing Red + Q&A\",\"runtime\":null,\"genres\":\"Documentary\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4196e61bf2d4b296c23c30353686b72d.jpg\",\"__typename\":\"Movie\",\"altId\":[\"398439\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Christopher\",\"lastName\":\"M. Armstrong\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Manish\",\"lastName\":\"Pandey\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Chris\",\"lastName\":\"Harris\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Luca\",\"lastName\":\"Montezemolo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-09-25T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"24287\",\"name\":\"Independent\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Luca  - Seeing Red + Q&A\",\"synopsis\":\"Join us for a very special evening live from the premiere of 'Luca - Seeing Red'.\\nThis preview screening will be followed by a live streamed Q&A with Chris Harris, Luca di Montezemolo, and the film director, Manish Pandey\\n \\nIn 'Luca - Seeing Red', Chris Harris travels to Italy to spend a week with Ferrari legend Luca Montezemolo.\\n \\nThe documentary is ex-BBC Top Gear star, Chris Harris’s ‘love letter’ to a man whom he describes as ‘the greatest car boss ever’ – Luca Cordero di Montezemolo. \\nChris, one of the most knowledgeable and passionate car journalists on earth, spends two weeks with Luca on an odyssey through his native Italy and hears the story of his extraordinary life.\\nHandpicked by Enzo Ferrari, himself, Luca saved Ferrari, twice!  First, in the early 1970’s and then, again, in the 90’s.\\nLuca was the architect of the Lauda and Schumacher eras; he presided over the most beautiful and desirable road cars in history and, under him, Ferrari became a brand to rival Apple, Nike and Coca Cola.  But it was that exact brand value that led to Luca’s operatic corporate assassination as parent company Fiat floated Ferrari to save itself.\\nSet on location in Bologna, Maranello and Rome, and enhanced with evocative archive, Chris takes a thrilling, reminiscent and incredibly personal journey with the man of whom Bernie Ecclestone says, ‘After Mr Ferrari, Luca was Ferrari’.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/4196e61bf2d4b296c23c30353686b72d.jpg\",\"synopsis\":\"Join us on Thursday, 25 September, for a very special evening: the UK premiere of Luca – Seeing Red, previewing across the UK, live from the red carpet. A live-streamed Q&A with Chris Harris, Luca di Montezemolo, and director Manish Pandey will follow the screening.\\n\\nThe documentary is ex-Top Gear star Chris Harris’s ‘love letter’ to the man he calls ‘the greatest car boss ever’, Ferrari legend Luca di Montezemolo. Harris, one of the most passionate car journalists alive, follows Luca on a two-week odyssey through Italy and uncovers his extraordinary life.\\n\\nHandpicked by Enzo Ferrari, Luca saved Ferrari twice—first in the 1970s, then again in the 90s. He masterminded the Lauda and Schumacher eras, presided over Ferrari’s most beautiful road cars, and built a brand rivaling Apple, Nike, and Coca-Cola. But that very success led to his operatic ousting when Fiat floated Ferrari to save itself.\\n\\nSet in Bologna, Maranello and Rome, and enriched with evocative archive, Chris takes a thrilling, personal journey with the man Bernie Ecclestone said: ‘After Mr Ferrari, Luca was Ferrari\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/bb2b260054b7b3c6732541ac386d29aa.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Luca  - Seeing Red + Q&A\",\"synopsis\":\"Join us on Thursday, 25 September, for a very special evening: the UK premiere of Luca – Seeing Red, previewing across the UK, live from the red carpet. A live-streamed Q&A with Chris Harris, Luca di Montezemolo, and director Manish Pandey will follow the screening.\\n\\nThe documentary is ex-Top Gear star Chris Harris’s ‘love letter’ to the man he calls ‘the greatest car boss ever’, Ferrari legend Luca di Montezemolo. Harris, one of the most passionate car journalists alive, follows Luca on a two-week odyssey through Italy and uncovers his extraordinary life.\\n\\nHandpicked by Enzo Ferrari, Luca saved Ferrari twice—first in the 1970s, then again in the 90s. He masterminded the Lauda and Schumacher eras, presided over Ferrari’s most beautiful road cars, and built a brand rivaling Apple, Nike, and Coca-Cola. But that very success led to his operatic ousting when Fiat floated Ferrari to save itself.\\n\\nSet in Bologna, Maranello and Rome, and enriched with evocative archive, Chris takes a thrilling, personal journey with the man Bernie Ecclestone said: ‘After Mr Ferrari, Luca was Ferrari\",\"certificate\":null,\"casting\":[\"Chris Harris\",\"Luca Montezemolo\"],\"direction\":[\"Christopher M. Armstrong\",\"Manish Pandey\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/bb2b260054b7b3c6732541ac386d29aa.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/bb2b260054b7b3c6732541ac386d29aa.jpg\"],\"release\":\"2025-09-25T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Independent\"}},{\"id\":\"1000030161\",\"title\":\"Luca - Seeing Red\",\"runtime\":null,\"genres\":\"Documentary\",\"__typename\":\"Movie\",\"altId\":[\"399580\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"releases\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/6f2703b1dbc9de39135d921cd8931fdf.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Christopher\",\"lastName\":\"M. Armstrong\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Manish\",\"lastName\":\"Pandey\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Chris\",\"lastName\":\"Harris\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Luca\",\"lastName\":\"Montezemolo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"locale\":{\"title\":\"Luca - Seeing Red\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/37/f7/37f7b9da1f5c406e084496b54d725beb.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/6f2703b1dbc9de39135d921cd8931fdf.jpg\",\"synopsis\":\"The documentary is ex-Top Gear star Chris Harris’s ‘love letter’ to the man he calls ‘the greatest car boss ever’, Ferrari legend Luca di Montezemolo. Harris, one of the most passionate car journalists alive, follows Luca on a two-week odyssey through Italy and uncovers his extraordinary life.\\n\\nHandpicked by Enzo Ferrari, Luca saved Ferrari twice—first in the 1970s, then again in the 90s. He masterminded the Lauda and Schumacher eras, presided over Ferrari’s most beautiful road cars, and built a brand rivaling Apple, Nike, and Coca-Cola. But that very success led to his operatic ousting when Fiat floated Ferrari to save itself.\\n\\nSet in Bologna, Maranello and Rome, and enriched with evocative archive, Chris takes a thrilling, personal journey with the man Bernie Ecclestone said: ‘After Mr Ferrari, Luca was Ferrari\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/5eec54da11ae0eedb5b4579b39bc938e.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Luca - Seeing Red\",\"synopsis\":\"The documentary is ex-Top Gear star Chris Harris’s ‘love letter’ to the man he calls ‘the greatest car boss ever’, Ferrari legend Luca di Montezemolo. Harris, one of the most passionate car journalists alive, follows Luca on a two-week odyssey through Italy and uncovers his extraordinary life.\\n\\nHandpicked by Enzo Ferrari, Luca saved Ferrari twice—first in the 1970s, then again in the 90s. He masterminded the Lauda and Schumacher eras, presided over Ferrari’s most beautiful road cars, and built a brand rivaling Apple, Nike, and Coca-Cola. But that very success led to his operatic ousting when Fiat floated Ferrari to save itself.\\n\\nSet in Bologna, Maranello and Rome, and enriched with evocative archive, Chris takes a thrilling, personal journey with the man Bernie Ecclestone said: ‘After Mr Ferrari, Luca was Ferrari\",\"casting\":[\"Chris Harris\",\"Luca Montezemolo\"],\"direction\":[\"Christopher M. Armstrong\",\"Manish Pandey\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/5eec54da11ae0eedb5b4579b39bc938e.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/5eec54da11ae0eedb5b4579b39bc938e.jpg\"],\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000029479\",\"title\":\"Marnie: Everyman In Therapy\",\"runtime\":7800,\"genres\":\"Thriller, Drama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/b4d4a4896eccde112c33beb68ff3d3f5.jpg\",\"__typename\":\"Movie\",\"altId\":[\"398784\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Alfred\",\"lastName\":\"Hitchcock\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tippi\",\"lastName\":\"Hedren\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Martin\",\"lastName\":\"Gabel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sean\",\"lastName\":\"Connery\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-25T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Marnie: Everyman In Therapy\",\"synopsis\":null,\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/b4d4a4896eccde112c33beb68ff3d3f5.jpg\",\"synopsis\":\"Have you ever been curious about the motivation of a film’s protagonist? Ever wanted to understand the character from a professional point of view?\\n\\nIntroducing Everyman In Therapy; a new type of screening where after the film, a leading psychoanalyst will take to the stage to offer their analysis of the character and themes within the film. The talk will last for approximately 50 minutes.\\n\\nFor this Everyman in Therapy, we will be presenting Alfred Hitchcock's Marnie, with an analytical conversation between Rupert Tower and Louise Dymoke [SAP], moderated by Adam Reynolds [MBACP].\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/219ba8badfd2b0b5f75915752bdd9774.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Marnie: Everyman In Therapy\",\"synopsis\":\"Have you ever been curious about the motivation of a film’s protagonist? Ever wanted to understand the character from a professional point of view?\\n\\nIntroducing Everyman In Therapy; a new type of screening where after the film, a leading psychoanalyst will take to the stage to offer their analysis of the character and themes within the film. The talk will last for approximately 50 minutes.\\n\\nFor this Everyman in Therapy, we will be presenting Alfred Hitchcock's Marnie, with an analytical conversation between Rupert Tower and Louise Dymoke [SAP], moderated by Adam Reynolds [MBACP].\",\"certificate\":\"15\",\"casting\":[\"Tippi Hedren\",\"Martin Gabel\",\"Sean Connery\"],\"direction\":[\"Alfred Hitchcock\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/219ba8badfd2b0b5f75915752bdd9774.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/219ba8badfd2b0b5f75915752bdd9774.jpg\"],\"release\":\"2025-09-25T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000007317\",\"title\":\"Marty Supreme\",\"runtime\":null,\"genres\":\"Drama, Biopic\",\"__typename\":\"Movie\",\"altId\":[\"369701\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ea35dcd46ee4c8d0aa9eae9b9a572f37.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"n