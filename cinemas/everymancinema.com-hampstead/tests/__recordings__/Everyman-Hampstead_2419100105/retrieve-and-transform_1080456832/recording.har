        "response": {
          "bodySize": 688,
          "content": {
            "mimeType": "application/json",
            "size": 688,
            "text": "{\"data\":{\"allEvent\":{\"nodes\":[{\"title\":\"It's Not You, It's Us\",\"id\":\"RXh0ZXJuYWxFdmVudDo1MDYzMw==\",\"description\":\"<p>Heads up! There's currently no step-free access at Everyman Newcastle due to a broken lift. We hope to be up and running again soon!</p>\",\"theaters\":[{\"id\":\"X11KB\"}]},{\"title\":\"Up To 3 Hours Free Parking at Royal William Yard\",\"id\":\"RXh0ZXJuYWxFdmVudDo0MTAyMA==\",\"description\":\"<p>Heads up!&nbsp;Guests watching a film at Everyman Plymouth can claim 3 hours of free parking at the RWY car park. Once you've parked, head straight up to the venue and ask the team how to register your vehicle (no need to buy a parking ticket!)</p>\",\"theaters\":[{\"id\":\"G01RJ\"}]},{\"title\":\"Mermaid Quay Car Park Closure | March 2nd 2025\",\"id\":\"RXh0ZXJuYWxFdmVudDoyMzkxNA==\",\"description\":\"<p>Heads up! Mermaid Quay Car Park is closed from March 2nd 2025 until further notice. For more information on parking please view our venue information <span style=\\\"text-decoration: underline;\\\"><strong><a href=\\\"https://www.everymancinema.com/venues-list/x11nu-everyman-cardiff/#venue-info\\\">here</a></strong></span></p>\",\"theaters\":[{\"id\":\"X11NU\"}]},{\"title\":\"It's Not You, It's Us\",\"id\":\"RXh0ZXJuYWxFdmVudDo1MDkyNQ==\",\"description\":\"<p>Heads up! There is currently no step-free access at Everyman Stratford-upon-Avon due to a broken lift. We hope to be up and running again soon!</p>\",\"theaters\":[{\"id\":\"X0YZU\"}]}]}}}"
          },
