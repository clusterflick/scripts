            "text": "[{\"id\":\"27442\",\"title\":\"2001: A Space Odyssey\",\"runtime\":8460,\"genres\":\"Science fiction\",\"__typename\":\"Movie\",\"altId\":[\"5748\",\"272643\",\"276343\",\"276344\",\"143804\"],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a35f9a5065f45a6631a50cbb602bb1ce.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/2962340.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/2976402.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/2988902.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3017028.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3045153.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3059216.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3073278.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/37/0998482.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3087341.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3002965.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Stanley\",\"lastName\":\"Kubrick\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Keir\",\"lastName\":\"Dullea\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gary\",\"lastName\":\"Lockwood\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"William\",\"lastName\":\"Sylvester\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Douglas\",\"lastName\":\"Rain\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Leonard\",\"lastName\":\"Rossiter\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Margaret\",\"lastName\":\"Tyzack\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Beatty\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sean\",\"lastName\":\"Sullivan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Daniel\",\"lastName\":\"Richter\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Frank\",\"lastName\":\"Miller (II)\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2018-05-18T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}]},{\"releasedAt\":\"2025-12-11T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"mild violence, threat\",\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"2001: A Space Odyssey\",\"synopsis\":\"2001: A Space Odyssey spans from the dawn of man to its title year. Stone Age Earth: In the presence of a mysterious black obelisk, pre-humans discover the use of tools - and weapons - violently taking first steps toward intelligence. 1999: On Earth's moon astronauts uncover another mysterious black obelisk. 2001: Between Earth and Jupiter, the spacecraft's intelligent computer makes a mistake that kills most of the human crew - then continues to kill to hide its error. Beyond Time: The sole survivor of the journey to Jupiter ascends to the next level of humanity.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/41/78/4178078e2035e57fead7c99a783e140b.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/a35f9a5065f45a6631a50cbb602bb1ce.jpg\",\"synopsis\":\"Selected by the Cinematographers Branch, Everyman presents: 2001: A Space Odyssey\\n\\nAn imposing black structure provides a connection between the past and the future in this enigmatic adaptation of a short story by revered sci-fi author Arthur C. Clarke. When Dr. Dave Bowman (Keir Dullea) and other astronauts are sent on a mysterious mission, their ship's computer system, HAL, begins to display increasingly strange behavior, leading up to a tense showdown between man and machine that results in a mind-bending trek through space and time.\\n\\nStanley Kubrick’s groundbreaking space epic was one of the most influential films of its time, and a surprise counter-culture smash due to its psychedelic Stargate sequence. The film ushered in an era of ambitious and intelligent science-fiction cinema. While its visual effects set a new high standard (for which Kubrick received an Oscar), its eye-popping 70mm cinematography was an equal contributor to its visual grandeur, with Geoffrey Unsworth (Cabaret) serving as principal cinematographer and John Alcott (Barry Lyndon) shooting additional scenes, including the \\\"Dawn of Man\\\" prologue. \\n\\nPresented in restored 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 11 December.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/eb4adf05e0823dd2d7095bbe28dced47.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"2001: A Space Odyssey\",\"synopsis\":\"Selected by the Cinematographers Branch, Everyman presents: 2001: A Space Odyssey\\n\\nAn imposing black structure provides a connection between the past and the future in this enigmatic adaptation of a short story by revered sci-fi author Arthur C. Clarke. When Dr. Dave Bowman (Keir Dullea) and other astronauts are sent on a mysterious mission, their ship's computer system, HAL, begins to display increasingly strange behavior, leading up to a tense showdown between man and machine that results in a mind-bending trek through space and time.\\n\\nStanley Kubrick’s groundbreaking space epic was one of the most influential films of its time, and a surprise counter-culture smash due to its psychedelic Stargate sequence. The film ushered in an era of ambitious and intelligent science-fiction cinema. While its visual effects set a new high standard (for which Kubrick received an Oscar), its eye-popping 70mm cinematography was an equal contributor to its visual grandeur, with Geoffrey Unsworth (Cabaret) serving as principal cinematographer and John Alcott (Barry Lyndon) shooting additional scenes, including the \\\"Dawn of Man\\\" prologue. \\n\\nPresented in restored 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 11 December.\",\"certificate\":\"U\",\"casting\":[\"Keir Dullea\",\"Gary Lockwood\",\"William Sylvester\",\"Douglas Rain\",\"Leonard Rossiter\",\"Margaret Tyzack\",\"Robert Beatty\",\"Sean Sullivan\",\"Daniel Richter\",\"Frank Miller (II)\"],\"direction\":[\"Stanley Kubrick\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/eb4adf05e0823dd2d7095bbe28dced47.jpg\",\"pictures/18/05/17/12/34/2962340.jpg\",\"pictures/18/05/17/12/34/2976402.jpg\",\"pictures/18/05/17/12/34/2988902.jpg\",\"pictures/18/05/17/12/34/3017028.jpg\",\"pictures/18/05/17/12/34/3045153.jpg\",\"pictures/18/05/17/12/34/3059216.jpg\",\"pictures/18/05/17/12/34/3073278.jpg\",\"pictures/18/05/17/12/37/0998482.jpg\",\"pictures/18/05/17/12/34/3087341.jpg\",\"pictures/18/05/17/12/34/3002965.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/eb4adf05e0823dd2d7095bbe28dced47.jpg\"],\"release\":\"2018-05-18T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"}},{\"id\":\"139772\",\"title\":\"28 Years Later\",\"runtime\":6900,\"genres\":\"Horror, Thriller\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/968372a91a1acfd9c8659234aac152b1.jpg\",\"__typename\":\"Movie\",\"altId\":[\"356733\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/63/5d/635d5934c1ee76bb074402640cc08e7d.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/fd/1e/fd1e6c80658f68d26022cbb67305fdc4.jpeg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/50/57/50573e36cfb832f4045abc929369549c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/85/29/85294c93477d17b30fb331ecf7d4e334.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ff/13/ff139607f0056668e2195b26774b01d1.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/91/0a/910aa7ed02280e5515a2a745b0f3c8d9.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Danny\",\"lastName\":\"Boyle\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Aaron\",\"lastName\":\"Taylor-Johnson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jodie\",\"lastName\":\"Comer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alfie\",\"lastName\":\"Williams\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ralph\",\"lastName\":\"Fiennes\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jack\",\"lastName\":\"O'Connell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Erin\",\"lastName\":\"Kellyman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Edvin\",\"lastName\":\"Ryding\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Angus\",\"lastName\":\"Angus Neill\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christopher\",\"lastName\":\"Fulford\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gordon\",\"lastName\":\"Alexander\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-06-19T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong violence, gore, horror, language\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"39732\",\"name\":\"Sony Pictures\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"28 Years Later\",\"synopsis\":\"Academy Award®-winning director Danny Boyle and Academy Award®-nominated writer Alex Garland reunite for 28 Years Later, a terrifying new story set in the world created by 28 Days Later. It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine, some have found ways to exist amidst the infected. One such group of survivors lives on a small island connected to the mainland by a single, heavily-defended causeway. When one of the group leaves the island on a mission into the dark heart of the mainland, he discovers secrets, wonders, and horrors that have mutated not only the infected but other survivors as well.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/356733_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/356733_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/00/04/0004748ea2afc8820ac36cd58b688100.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/cddea8c9ead49ff3024d6bdecdaaf40d.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/968372a91a1acfd9c8659234aac152b1.jpg\",\"synopsis\":\"It's been almost three decades since the rage virus escaped from a biological weapons laboratory. Still living in a ruthlessly enforced quarantine, some have found ways to exist amid the infected. \\n\\nOne such group of survivors lives on a small island connected to the mainland by a single, heavily defended causeway. When one of them decides to venture into the dark heart of the mainland, he soon discovers a mutation that has spread to not only the infected, but other survivors as well.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/87417c260f31e198989d04a098c71b2f.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"28 Years Later\",\"synopsis\":\"It's been almost three decades since the rage virus escaped from a biological weapons laboratory. Still living in a ruthlessly enforced quarantine, some have found ways to exist amid the infected. \\n\\nOne such group of survivors lives on a small island connected to the mainland by a single, heavily defended causeway. When one of them decides to venture into the dark heart of the mainland, he soon discovers a mutation that has spread to not only the infected, but other survivors as well.\",\"certificate\":\"15\",\"casting\":[\"Aaron Taylor-Johnson\",\"Jodie Comer\",\"Alfie Williams\",\"Ralph Fiennes\",\"Jack O'Connell\",\"Erin Kellyman\",\"Edvin Ryding\",\"Angus Angus Neill\",\"Christopher Fulford\",\"Gordon Alexander\"],\"direction\":[\"Danny Boyle\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/87417c260f31e198989d04a098c71b2f.jpg\",\"img/63/5d/635d5934c1ee76bb074402640cc08e7d.jpg\",\"img/fd/1e/fd1e6c80658f68d26022cbb67305fdc4.jpeg\",\"img/50/57/50573e36cfb832f4045abc929369549c.jpg\",\"img/85/29/85294c93477d17b30fb331ecf7d4e334.jpg\",\"img/ff/13/ff139607f0056668e2195b26774b01d1.jpg\",\"img/91/0a/910aa7ed02280e5515a2a745b0f3c8d9.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/87417c260f31e198989d04a098c71b2f.jpg\",\"https://cms-assets.webediamovies.pro/production/2/cddea8c9ead49ff3024d6bdecdaaf40d.jpg\"],\"release\":\"2025-06-19T00:00:00.000Z\",\"advisory\":\"strong violence, gore, horror, language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/356733_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/356733_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures\"}},{\"id\":\"1000000966\",\"title\":\"28 Years Later: The Bone Temple\",\"runtime\":null,\"genres\":\"Horror\",\"__typename\":\"Movie\",\"altId\":[\"360489\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/969bc01a32aa4967cfe796051f95a94f.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Nia\",\"lastName\":\"DaCosta\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ralph\",\"lastName\":\"Fiennes\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alfie\",\"lastName\":\"Williams\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jack\",\"lastName\":\"O'Connell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emma\",\"lastName\":\"Laird\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Chi\",\"lastName\":\"Lewis-Parry\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Rhodes\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maura\",\"lastName\":\"Bird\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sam\",\"lastName\":\"Locke\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-01-06T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"28 Years Later: The Bone Temple\",\"synopsis\":null,\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/969bc01a32aa4967cfe796051f95a94f.jpg\",\"synopsis\":\"28 Years Later: The Bone Temple is an upcoming post-apocalyptic horror film directed by Nia DaCosta and written by Alex Garland. It was shot back-to-back with its predecessor, 28 Years Later, and will serve as the fourth instalment overall in the 28 Days Later film series.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/43153e096210cb210378cea22d1b1a90.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"28 Years Later: The Bone Temple\",\"synopsis\":\"28 Years Later: The Bone Temple is an upcoming post-apocalyptic horror film directed by Nia DaCosta and written by Alex Garland. It was shot back-to-back with its predecessor, 28 Years Later, and will serve as the fourth instalment overall in the 28 Days Later film series.\",\"certificate\":null,\"casting\":[\"Ralph Fiennes\",\"Alfie Williams\",\"Jack O'Connell\",\"Emma Laird\",\"Chi Lewis-Parry\",\"Robert Rhodes\",\"Maura Bird\",\"Sam Locke\"],\"direction\":[\"Nia DaCosta\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/43153e096210cb210378cea22d1b1a90.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/43153e096210cb210378cea22d1b1a90.jpg\"],\"release\":\"2026-01-06T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures UK\"}},{\"id\":\"326583\",\"title\":\"A Big Bold Beautiful Journey\",\"runtime\":6540,\"genres\":\"Drama\",\"__typename\":\"Movie\",\"altId\":[\"361585\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/d4574f24c75278d6e97a085a54a18846.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/60/76/607617f43a75a33d68cb81f09e5bd9f7.JPG\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ca/fc/cafc1ed27335c215b802bf356dfaa4c1.JPG\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/42/01/420157fe723e865269245a01732a716e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/b8/a0/b8a0e2f6b46c1408c7bf7675f9f452b2.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/61/ef/61efbbeb352db4c34eb010a9f5ac9138.JPG\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/76/36/7636779eb1a7b4b59edcd1e06f0f27eb.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e0/33/e033361e4dc05e03c84d606dc9c3bcdb.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":null,\"lastName\":\"Kogonada\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Margot\",\"lastName\":\"Robbie\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Colin\",\"lastName\":\"Farrell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kevin\",\"lastName\":\"Kline\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Phoebe\",\"lastName\":\"Waller-Bridge\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jennifer\",\"lastName\":\"Grant\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hamish\",\"lastName\":\"Linklater\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lily\",\"lastName\":\"Rabe\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Jodie\",\"lastName\":\"Turner-Smith\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Billy\",\"lastName\":\"Magnussen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sarah\",\"lastName\":\"Gadon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-09-19T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong language\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"A Big Bold Beautiful Journey\",\"synopsis\":\"Some doors bring you to your past. Some doors lead you to your future. And some doors change everything. Sarah (Margot Robbie) and David (Colin Farrell) are single strangers who meet at a mutual friend’s wedding and soon, through a surprising twist of fate, find themselves on A Big Bold Beautiful Journey – a funny, fantastical, sweeping adventure together where they get to re-live important moments from their respective pasts, illuminating how they got to where they are in the present...and possibly getting a chance to alter their futures.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/361585_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/361585_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/1e/0b/1e0b51ea6f831b9c307bcba2f7df282b.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/8ad31dcb12618001a7ee3bcab2dcaf59.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/d4574f24c75278d6e97a085a54a18846.jpg\",\"synopsis\":\"A Big Bold Beautiful Journey tells the story of two strangers David and Sarah (Colin Farrell and Margot Robbie) unimaginable journey that brings them into each other's lives and connects them.\\n\\nFrom director Kogonada and based on a screenplay by Seth Reiss. This romantic fantasy film stars Colin Farrell, Margot Robbie, Phoebe Waller-Bridge, Billy Magnussen, Jodie Turner-Smith, Hamish Linklater, and Lily Rabe.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/22ed7a0567732c23d38f68fd69249ed2.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"A Big Bold Beautiful Journey\",\"synopsis\":\"A Big Bold Beautiful Journey tells the story of two strangers David and Sarah (Colin Farrell and Margot Robbie) unimaginable journey that brings them into each other's lives and connects them.\\n\\nFrom director Kogonada and based on a screenplay by Seth Reiss. This romantic fantasy film stars Colin Farrell, Margot Robbie, Phoebe Waller-Bridge, Billy Magnussen, Jodie Turner-Smith, Hamish Linklater, and Lily Rabe.\",\"certificate\":\"15\",\"casting\":[\"Margot Robbie\",\"Colin Farrell\",\"Kevin Kline\",\"Phoebe Waller-Bridge\",\"Jennifer Grant\",\"Hamish Linklater\",\"Lily Rabe\",\"Jodie Turner-Smith\",\"Billy Magnussen\",\"Sarah Gadon\"],\"direction\":[\"Kogonada\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/22ed7a0567732c23d38f68fd69249ed2.jpg\",\"img/60/76/607617f43a75a33d68cb81f09e5bd9f7.JPG\",\"img/ca/fc/cafc1ed27335c215b802bf356dfaa4c1.JPG\",\"img/42/01/420157fe723e865269245a01732a716e.jpg\",\"img/b8/a0/b8a0e2f6b46c1408c7bf7675f9f452b2.jpg\",\"img/61/ef/61efbbeb352db4c34eb010a9f5ac9138.JPG\",\"img/76/36/7636779eb1a7b4b59edcd1e06f0f27eb.jpg\",\"img/e0/33/e033361e4dc05e03c84d606dc9c3bcdb.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/22ed7a0567732c23d38f68fd69249ed2.jpg\",\"https://cms-assets.webediamovies.pro/production/2/8ad31dcb12618001a7ee3bcab2dcaf59.jpg\"],\"release\":\"2025-09-19T00:00:00.000Z\",\"advisory\":\"strong language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/361585_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/361585_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures UK\"}},{\"id\":\"1000008318\",\"title\":\"All of You\",\"runtime\":5880,\"genres\":\"Drama, Romance\",\"poster\":\"img/fc/54/fc5442a1e16e1b5e66907aaf9af1858e.jpg\",\"__typename\":\"Movie\",\"altId\":[\"370997\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/9c/98/9c98c4ab2ea4f163f55fb7e950e131fe.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/fc/54/fc5442a1e16e1b5e66907aaf9af1858e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/68/04/68048300ff4f567ab3191a328cb7d154.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ab/45/ab45368bf716d08d8f3eced04d88da2f.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/99/bc/99bc971f2fdd7876fdae7016ca56f35a.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"William\",\"lastName\":\"Bridges\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brett\",\"lastName\":\"Goldstein (II)\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Imogen\",\"lastName\":\"Poots\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Zawe\",\"lastName\":\"Ashton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Steven\",\"lastName\":\"Cree\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Eva\",\"lastName\":\"Magyar\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jamie\",\"lastName\":\"Langlands\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tariq\",\"lastName\":\"Nasheed\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alara-Star\",\"lastName\":\"Khan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-26T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"very strong language, strong sex, drug misuse\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"33240\",\"name\":\"Altitude Films\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"All of You\",\"synopsis\":\"Best friends since college, Simon (Goldstein) and Laura (Poots) drift apart when she takes a test that finds her soulmate despite years of unspoken feelings between them. Over the years, as their paths cross and diverge, neither can deny the feeling that they’ve missed out on a life together. Faced with the uncertainty of changing the course of their lives, are Simon and Laura willing to risk everything to experience the love that had been between them all along, or should they accept their fate?\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/19/13/191366018929050f1bcb4c3b873a1eca.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://all.web.img.acsta.net/img/fc/54/fc5442a1e16e1b5e66907aaf9af1858e.jpg\",\"synopsis\":\"A stirring romance of two best friends who harbour an unspoken love for one another even after a test matches one of them up with their supposed soulmate.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"All Of You\",\"synopsis\":\"A stirring romance of two best friends who harbour an unspoken love for one another even after a test matches one of them up with their supposed soulmate.\",\"certificate\":\"15\",\"casting\":[\"Brett Goldstein (II)\",\"Imogen Poots\",\"Zawe Ashton\",\"Steven Cree\",\"Eva Magyar\",\"Jamie Langlands\",\"Tariq Nasheed\",\"Alara-Star Khan\"],\"direction\":[\"William Bridges\"],\"coDirection\":[],\"pictures\":[\"img/9c/98/9c98c4ab2ea4f163f55fb7e950e131fe.jpg\",\"img/fc/54/fc5442a1e16e1b5e66907aaf9af1858e.jpg\",\"img/68/04/68048300ff4f567ab3191a328cb7d154.jpg\",\"img/ab/45/ab45368bf716d08d8f3eced04d88da2f.jpg\",\"img/99/bc/99bc971f2fdd7876fdae7016ca56f35a.jpg\"],\"heroImages\":[],\"release\":\"2025-09-26T00:00:00.000Z\",\"advisory\":\"very strong language, strong sex, drug misuse\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Altitude Films\"}},{\"id\":\"1000030664\",\"title\":\"All of You + Live Q&A\",\"runtime\":null,\"genres\":\"\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/be014a38331c95589f68a34517ca912f.jpg\",\"__typename\":\"Movie\",\"altId\":[\"400373\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"William\",\"lastName\":\"Bridges\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Imogen\",\"lastName\":\"Poots\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brett\",\"lastName\":\"Goldstein (II)\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rebecca\",\"lastName\":\"Osias\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-09-24T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[],\"distributors\":[{\"id\":\"33240\",\"name\":\"Altitude Films\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"All of you + Live Q&A\",\"synopsis\":null,\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"All of You + Live Q&A\",\"poster\":\"//cms-assets.webediamovies.pro/production/279/be014a38331c95589f68a34517ca912f.jpg\",\"synopsis\":\"Join us at Everyman at The Whiteley on Wednesday, 24 September, for a special preview screening of All of You, followed by a live Q&A with lead actors Brett Goldstein and Imogen Poots, with director William Bridges.\\n \\nBest friends since college, Simon and Laura drift apart when she takes a test that finds her soulmate despite years of unspoken feelings between them. Over the years, as their paths cross and diverge, neither can deny the feeling that they’ve missed out on a life together. Faced with the uncertainty of changing the course of their lives, are Simon and Laura willing to risk everything to experience the love that had been between them all along, or should they accept their fate?\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/7030ee0bdddf154a5611231404810b8b.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"All of you + Live Q&A\",\"synopsis\":\"Join us at Everyman at The Whiteley on Wednesday, 24 September, for a special preview screening of All of You, followed by a live Q&A with lead actors Brett Goldstein and Imogen Poots, with director William Bridges.\\n \\nBest friends since college, Simon and Laura drift apart when she takes a test that finds her soulmate despite years of unspoken feelings between them. Over the years, as their paths cross and diverge, neither can deny the feeling that they’ve missed out on a life together. Faced with the uncertainty of changing the course of their lives, are Simon and Laura willing to risk everything to experience the love that had been between them all along, or should they accept their fate?\",\"certificate\":\"15\",\"casting\":[\"Imogen Poots\",\"Brett Goldstein (II)\",\"Rebecca Osias\"],\"direction\":[\"William Bridges\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/7030ee0bdddf154a5611231404810b8b.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/7030ee0bdddf154a5611231404810b8b.jpg\"],\"release\":\"2025-09-24T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Altitude Films\"}},{\"id\":\"319444\",\"title\":\"Andrea Bocelli: Because I Believe\",\"runtime\":6420,\"genres\":\"Documentary, Music\",\"__typename\":\"Movie\",\"altId\":[\"370457\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/453e362d9b20343f062aca822b13ee7d.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/e0/62/e062ba80a337de9c7445c7a47cbbda94.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/51/9c/519cd8bb766e3d21abafb358be051843.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/59/87/5987eb3de0d4ccdc51e046335e6f478c.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Cosima\",\"lastName\":\"Spender\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Andrea\",\"lastName\":\"Bocelli\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-21T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"very mild bad language, upsetting scenes\",\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"locale\":{\"title\":\"Andrea Bocelli: Because I Believe\",\"synopsis\":\"One of the world’s greatest singers, Andrea Bocelli has a voice that transcends genres and generations. In this intimate portrait of the acclaimed Italian tenor, Bocelli, for the first time, tells his story in his own words. Documentarian Cosima Spender follows Bocelli with unprecedented access beyond the footlights to reveal an uncompromising artist and devoted family man with a fearless passion for living. Despite losing his sight at age 12, Bocelli dedicated his life to music and, after years spent entertaining customers in piano bars, caught the attention of the legendary Luciano Pavarotti, who heard Bocelli’s voice on a demo tape. Bocelli’s life changed dramatically with the worldwide smash hit “Time to Say Goodbye,” his astonishing duet with Sarah Brightman that catapulted him to superstardom. With hard- fought technical mastery of his voice and his decades-long love of opera — “music’s heaven” — Bocelli would go on to perform on the world’s most prestigious stages and with diverse singing partners such as Céline Dion, Jennifer Lopez, and Dua Lipa. Through interviews, archival performance footage, and informal gatherings with family and friends, Andrea Bocelli: Because I Believe celebrates the voice — and man — who continues to touch the hearts of millions of listeners around the world.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/3d/24/3d24690715e3d261401561f8a7cc0afc.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/e6be80db083940b0a8871c66c8bf6494.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/453e362d9b20343f062aca822b13ee7d.jpg\",\"synopsis\":\"One of the world’s greatest singers, Andrea Bocelli has a voice that transcends genres and generations. In this intimate portrait of the acclaimed Italian tenor, Bocelli, for the first time, tells his story in his own words. \\n\\nDocumentarian Cosima Spender follows Bocelli with unprecedented access beyond the footlights to reveal an uncompromising artist and devoted family man with a fearless passion for living. Despite losing his sight at age 12, Bocelli dedicated his life to music and, after years spent entertaining customers in piano bars, caught the attention of the legendary Luciano Pavarotti, who heard Bocelli’s voice on a demo tape. \\n\\nBocelli’s life changed dramatically with the worldwide smash hit “Time to Say Goodbye,” his astonishing duet with Sarah Brightman that catapulted him to superstardom. With hard-fought technical mastery of his voice and his decades-long love of opera - “music’s heaven” - Bocelli would go on to perform on the world’s most prestigious stages and with diverse singing partners such as Céline Dion, Jennifer Lopez, and Dua Lipa.\\n\\nThrough interviews, archival performance footage, and informal gatherings with family and friends, Andrea Bocelli: Because I Believe celebrates the voice and man who continues to touch the hearts of millions of listeners around the world.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/d5c7ef85d052409244be305c8b058630.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Andrea Bocelli: Because I Believe\",\"synopsis\":\"One of the world’s greatest singers, Andrea Bocelli has a voice that transcends genres and generations. In this intimate portrait of the acclaimed Italian tenor, Bocelli, for the first time, tells his story in his own words. \\n\\nDocumentarian Cosima Spender follows Bocelli with unprecedented access beyond the footlights to reveal an uncompromising artist and devoted family man with a fearless passion for living. Despite losing his sight at age 12, Bocelli dedicated his life to music and, after years spent entertaining customers in piano bars, caught the attention of the legendary Luciano Pavarotti, who heard Bocelli’s voice on a demo tape. \\n\\nBocelli’s life changed dramatically with the worldwide smash hit “Time to Say Goodbye,” his astonishing duet with Sarah Brightman that catapulted him to superstardom. With hard-fought technical mastery of his voice and his decades-long love of opera - “music’s heaven” - Bocelli would go on to perform on the world’s most prestigious stages and with diverse singing partners such as Céline Dion, Jennifer Lopez, and Dua Lipa.\\n\\nThrough interviews, archival performance footage, and informal gatherings with family and friends, Andrea Bocelli: Because I Believe celebrates the voice and man who continues to touch the hearts of millions of listeners around the world.\",\"certificate\":\"U\",\"casting\":[\"Andrea Bocelli\"],\"direction\":[\"Cosima Spender\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/d5c7ef85d052409244be305c8b058630.jpg\",\"img/e0/62/e062ba80a337de9c7445c7a47cbbda94.jpg\",\"img/51/9c/519cd8bb766e3d21abafb358be051843.jpg\",\"img/59/87/5987eb3de0d4ccdc51e046335e6f478c.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/d5c7ef85d052409244be305c8b058630.jpg\",\"https://cms-assets.webediamovies.pro/production/2/e6be80db083940b0a8871c66c8bf6494.jpg\"],\"release\":\"2025-09-21T00:00:00.000Z\",\"advisory\":\"very mild bad language, upsetting scenes\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"206761\",\"title\":\"Andrew Lloyd Webber's Love Never Dies\",\"runtime\":7200,\"genres\":\"Drama, Musical, Romance\",\"__typename\":\"Movie\",\"altId\":[\"135126\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/bff488439b5bd9b726ba5fa953a2c02f.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Brett\",\"lastName\":\"Sullivan (II)\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Simon\",\"lastName\":\"Phillips (XI)\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ben\",\"lastName\":\"Lewis (XI)\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anna\",\"lastName\":\"O'Byrne\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"María\",\"lastName\":\"Mercedes\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Simon\",\"lastName\":\"Gleeson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"releases\":[{\"releasedAt\":\"2025-09-21T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":\"mild threat, suicide references, language\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[],\"distributors\":[{\"id\":\"41483\",\"name\":\"CinemaLive\",\"__typename\":\"Company\"}]}],\"locale\":{\"title\":\"Andrew Lloyd Webber's Love Never Dies\",\"synopsis\":\"It is 10 years after his disappearance from the Paris Opera House and the Phantom has escaped to a new life in New York where he lives amongst the screaming joy rides and freak-shows of Coney Island. In this new electrically-charged world, he has finally found a place for his music to soar. All that is missing is his love - Christine Daaé. Now one of the world's finest sopranos, She's struggling in an ailing marriage to Raoul. So, it is with excitement she accepts an invitation to travel to New York and perform at a renowned opera house. In a final bid to win back her love, the Phantom lures Christine, her husband, and their young son Gustave from Manhattan; to the glittering and glorious world of Coney Island, not knowing what is in store.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/135126_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/135126_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/34/5e/345e2f8a27129f36133479a0b05be8c6.png\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"//cms-assets.webediamovies.pro/production/279/bff488439b5bd9b726ba5fa953a2c02f.jpg\",\"synopsis\":\"Love Never Dies continues the story of The Phantom of the Opera. Featuring one of Andrew Lloyd Webber’s finest musical scores performed by a 21-piece orchestra, a stunning cast of 36 including Ben Lewis and Anna O'Byrne, over 300 incredible costumes and a magnificent set illuminated by over 5000 dazzling light bulbs.\\n\\nThe year is 1907. It is 10 years after his disappearance from the Paris Opera House and the Phantom has escaped to a new life in New York where he lives amongst the screaming joy rides and freak-shows of Coney Island. In this new electrically-charged world, he has finally found a place for his music to soar. All that is missing is his love - Christine Daaé.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/2feb7d404ccfd565b9954526311ddf69.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Love Never Dies\",\"synopsis\":\"Love Never Dies continues the story of The Phantom of the Opera. Featuring one of Andrew Lloyd Webber’s finest musical scores performed by a 21-piece orchestra, a stunning cast of 36 including Ben Lewis and Anna O'Byrne, over 300 incredible costumes and a magnificent set illuminated by over 5000 dazzling light bulbs.\\n\\nThe year is 1907. It is 10 years after his disappearance from the Paris Opera House and the Phantom has escaped to a new life in New York where he lives amongst the screaming joy rides and freak-shows of Coney Island. In this new electrically-charged world, he has finally found a place for his music to soar. All that is missing is his love - Christine Daaé.\",\"certificate\":\"PG\",\"casting\":[\"Ben Lewis (XI)\",\"Anna O'Byrne\",\"María Mercedes\",\"Simon Gleeson\"],\"direction\":[\"Brett Sullivan (II)\",\"Simon Phillips (XI)\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/2feb7d404ccfd565b9954526311ddf69.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/2feb7d404ccfd565b9954526311ddf69.jpg\"],\"release\":\"2025-09-21T00:00:00.000Z\",\"advisory\":\"mild threat, suicide references, language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/135126_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/135126_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"CinemaLive\"}},{\"id\":\"187247\",\"title\":\"Avatar: Fire and Ash\",\"runtime\":11520,\"genres\":\"Science fiction, Adventure, Animation\",\"__typename\":\"Movie\",\"altId\":[\"203455\",\"393931\",\"393932\",\"393933\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/5b491185cf44783a0d2ff3cea1e3cba0.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/46/d9/46d9a61464852503abc09ac176122b9b.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/53/0e/530e8c422f2921771eb848526c9c412e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.im