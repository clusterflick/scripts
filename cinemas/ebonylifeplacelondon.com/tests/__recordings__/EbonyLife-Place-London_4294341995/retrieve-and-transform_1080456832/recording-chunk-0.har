            "text": "{\"data\":{\"movies\":{\"data\":[{\"id\":\"42825\",\"name\":\"The Secret Lives of Baba Segi's Wives\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-secret-lives-of-baba-segis-wives\",\"posterImage\":\"1zk3rx5lk62q20ykgpu6vgjn6s5q\",\"bannerImage\":\"2h73y41yi5obroi1p63zk7x77dgb\",\"synopsis\":\"A rich patriarch's delicate family falls apart when his youngest of four wives cannot have a child.\",\"starring\":\"Omowunmi Dada, Bimbo Manuel, Odunlade Adekola\",\"directedBy\":\"Daniel Emeke Oriahi\",\"producedBy\":\"\",\"searchTerms\":\"\",\"duration\":116,\"genre\":\"Comedy\",\"allGenres\":\"Comedy, Drama, Romance\",\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-12-04\",\"dateOfFirstShowing\":\"2026-10-26\",\"tmdbPopularityScore\":1.41,\"tmdbId\":\"1744003\",\"dcmEdiMovieId\":\"\",\"dcmEdiMovieName\":null,\"siteId\":\"179\",\"titleClassId\":\"454\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99301599999,\\\"daysShown\\\":15,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"Reserved Seating\\\"],\\\"everyShowingsBadges\\\":[\\\"Reserved Seating\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-film some-showings-reserved-seating every-showings-reserved-seating showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"507189\",\"time\":\"2026-10-26T19:30:00Z\",\"ticketsSold\":4,\"screenId\":\"503\",\"seatsRemaining\":155,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"}]},{\"id\":\"42826\",\"name\":\"Chronicles from the Siege\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"chronicles-from-the-siege\",\"posterImage\":\"472xdrilp38mcenegiefut6f9k7w\",\"bannerImage\":\"x50evf80sx33qxluzqrnnfoimceh\",\"synopsis\":\"During the siege of their city, a group of ordinary people struggle to survive amid hunger, snipers, and bombardments, while clinging to human connection, love, and small daily pleasures. Faced with impossible moral choices and deep psychological strain, their lives become inseparable from the siege itself.\",\"starring\":\"Nadeem Rimawi, Saja Kilani, Ahmad Kontar\",\"directedBy\":\"Abdallah Al-Khatib\",\"producedBy\":\"Taqiyeddine Issaad\",\"searchTerms\":\"\",\"duration\":185,\"genre\":\"Drama\",\"allGenres\":\"Drama\",\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-08-28\",\"dateOfFirstShowing\":\"2026-10-27\",\"tmdbPopularityScore\":1.3112,\"tmdbId\":\"1400378\",\"dcmEdiMovieId\":\"\",\"dcmEdiMovieName\":null,\"siteId\":\"179\",\"titleClassId\":\"454\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99301699999,\\\"daysShown\\\":16,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"Reserved Seating\\\"],\\\"everyShowingsBadges\\\":[\\\"Reserved Seating\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-film some-showings-reserved-seating every-showings-reserved-seating showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"507190\",\"time\":\"2026-10-27T19:00:00Z\",\"ticketsSold\":0,\"screenId\":\"503\",\"seatsRemaining\":159,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"}]},{\"id\":\"42827\",\"name\":\"Her Daughters' Mother\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"her-daughters-mother\",\"posterImage\":\"ecytsxc8bxksod7qjw96wyx551dl\",\"bannerImage\":\"bs4w4qjn2xs7gr8a4yi0fg7h56av\",\"synopsis\":\"After getting married off at the tender age of 16, Ejiro returns home in her 30s, widowed and broken, with two daughters for whom she holds lofty dreams. She soon finds out that her future is not in her own hands as she is married off to Osato, who promises a better future for her and her kids. However, her inability to provide his needs, which includes a male heir, turns Osato into her nightmare, and Ejiro soon finds herself craving for a freedom that only felt possible when she was a child.\",\"starring\":\"Ejovwoke Obad Olikuntuyi, Osas Okonyon, Philip Asaya\",\"directedBy\":\"Chinàzaēkpērē Abigal Chukwu\",\"producedBy\":\"Joshua Tsotso, Mentong Minwo, Efosa Ogbomo\",\"searchTerms\":\"\",\"duration\":110,\"genre\":\"Drama\",\"allGenres\":\"Drama\",\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-10-28\",\"dateOfFirstShowing\":\"2026-10-28\",\"tmdbPopularityScore\":0.5266,\"tmdbId\":\"267721\",\"dcmEdiMovieId\":\"\",\"dcmEdiMovieName\":null,\"siteId\":\"179\",\"titleClassId\":\"454\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99301799999,\\\"daysShown\\\":17,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"Reserved Seating\\\"],\\\"everyShowingsBadges\\\":[\\\"Reserved Seating\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-film some-showings-reserved-seating every-showings-reserved-seating showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"507191\",\"time\":\"2026-10-28T19:00:00Z\",\"ticketsSold\":0,\"screenId\":\"503\",\"seatsRemaining\":159,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating\\\"}\"}]},{\"id\":\"42828\",\"name\":\"Variations on a Theme\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"variations-on-a-theme\",\"posterImage\":\"7wvgx50dlbc0v4fi9fcpx5o7a2r1\",\"bannerImage\":\"vwh17ndih2t76bchq3yzcm3q17ya\",\"synopsis\":\"The Tiger Award winner at this year's Rotterdam Film Festival is a gentle and enchanting portrait of an octogenarian goat herder in South Africa's Kamiesberge.\",\"starring\":\"Hettie Farmer, Audronaé Adams, Johanna Adams\",\"directedBy\":\"Jason Jacobs, Devon Delmar\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":65,\"genre\":\"Drama\",\"allGenres\":\"Drama\",\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-10-29\",\"dateOfFirstShowing\":\"2026-10-29\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"\",\"dcmEdiMovieName\":null,\"siteId\":\