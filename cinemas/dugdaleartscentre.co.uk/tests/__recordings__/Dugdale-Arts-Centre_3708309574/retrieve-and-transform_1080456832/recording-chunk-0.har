            "text": "<!DOCTYPE html>\n<html lang=\"en-US\">\n<head>\n      <script\n    type=\"text/javascript\"\n    src=\"https://tickets.dugdaleartscentre.co.uk/millfieldartscentre/website/scripts/integrate.js\"\n  ></script>\n    <!-- SEO PLUGIN -->\n        <!-- END SEO PLUGIN -->\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/assets/favicons/apple-touch-icon.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/assets/favicons/favicon-32x32.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/assets/favicons/favicon-16x16.png\">\n<link rel=\"manifest\" href=\"/assets/favicons/site.webmanifest\">\n<link rel=\"mask-icon\" href=\"/assets/favicons/safari-pinned-tab.svg\" color=\"#5bbad5\">\n<link rel=\"shortcut icon\" href=\"/assets/favicons/favicon.ico\">\n<meta name=\"msapplication-TileColor\" content=\"#da532c\">\n<meta name=\"msapplication-config\" content=\"/assets/favicons/browserconfig.xml\">\n<meta name=\"theme-color\" content=\"#ffffff\">\n    <link rel=\"stylesheet\" href=\"/assets/css/app.min.css\" />\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Talkies Community Cinema | Dugdale Arts Centre</title>\n<script>window.dataLayer = window.dataLayer || [];\nfunction gtag(){dataLayer.push(arguments)};\ngtag('js', new Date());\ngtag('config', 'UA-87477549-3', {'send_page_view': true,'anonymize_ip': false,'link_attribution': false,'allow_display_features': false});\n</script><meta name=\"generator\" content=\"SEOmatic\">\n<meta name=\"referrer\" content=\"no-referrer-when-downgrade\">\n<meta name=\"robots\" content=\"all\">\n<meta content=\"en_US\" property=\"og:locale\">\n<meta content=\"Dugdale Arts Centre\" property=\"og:site_name\">\n<meta content=\"website\" property=\"og:type\">\n<meta content=\"https://www.dugdaleartscentre.co.uk/whats-on/talkies-community-cinema\" property=\"og:url\">\n<meta content=\"Talkies Community Cinema\" property=\"og:title\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:creator\" content=\"@\">\n<meta name=\"twitter:title\" content=\"Talkies Community Cinema\">\n<link href=\"https://www.dugdaleartscentre.co.uk/whats-on/talkies-community-cinema\" rel=\"canonical\">\n<link href=\"https://www.dugdaleartscentre.co.uk\" rel=\"home\">\n<link type=\"text/plain\" href=\"https://www.dugdaleartscentre.co.uk/humans.txt\" rel=\"author\"></head>\n<body class=\"ltr\"><script async src=\"https://www.googletagmanager.com/gtag/js?id=UA-87477549-3\"></script>\n\n    <nav id=\"navigation\">\n    <div id=\"navbar\">\n        <div class=\"container\">\n            <div class=\"hamburger\" onclick=\"toggleNav();\">\n                <svg class=\"ham hamRotate\" viewBox=\"0 0 100 100\">\n                    <path class=\"line top\" d=\"m 30,33 h 40 c 3.722839,0 7.5,3.126468 7.5,8.578427 0,5.451959 -2.727029,8.421573 -7.5,8.421573 h -20\" />\n                    <path class=\"line middle\" d=\"m 30,50 h 40\" />\n                    <path class=\"line bottom\" d=\"m 70,67 h -40 c 0,0 -7.5,-0.802118 -7.5,-8.365747 0,-7.563629 7.5,-8.634253 7.5,-8.634253 h 20\" />\n                </svg>\n            </div>\n            <a href=\"/\" class=\"logo-wrapper\">\n                <lottie-player id=\"lottie-logo\" src=\"/assets/images/Dugdale_Arts_Centre_-_Animated_Logo.json\" background=\"transparent\" speed=\"1\"></lottie-player>\n            </a>\n            <div class=\"quick-links-group\">\n                                <a href=\"/checkout/\" class=\"cart quick-link\">\n                    <img class=\"cart\" alt=\"Cart\" src=\"/assets/images/icons/cart.svg\" />\n                </a>\n                <a href=\"/my-account/\" class=\"account quick-link\">\n                    <img class=\"account\" alt=\"My account\" src=\"/assets/images/icons/my-account.svg\" />\n                </a>\n            </div>\n        </div>\n    </div>\n    <div id=\"menu\">\n        <div class=\"container\">\n            <ul>\n                                <li>\n                    <h4>\n                        <a href=\"/about-us\">About us</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/whats-on\">What&#039;s on</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/plan-your-visit\">Plan your visit</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/museum\">Museum</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/food\">Food</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/community\">Community</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/hires\">Hires</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/jobs\">Jobs</a>\n                    </h4>\n                </li>\n                            </ul>\n        </div>\n    </div>\n    <script src=\"https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js\"></script> \n</nav>\n    <div class=\"page events\">\n  <div class=\"details\">\n    <div class=\"container\">\n      <div class=\"title-and-type\">\n        <h5>Film</h5>\n        <h2>Talkies Community Cinema</h2>\n      </div>\n            <div class=\"dates-and-times\">\n        <h5>Dates and times</h5>\n        <h4>Monthly</h4>\n      </div>\n          </div>\n  </div>\n    <div class=\"banner-wrapper\">\n    <picture>\n        <source srcset=\"https://d2gbygv6wnrxcy.cloudfront.net/new-dugdale-arts-centre/events/banner/_eventBanner/1345617/talkies_banner.webp\" type=\"image/webp\">\n        <img\n        class=\"event-banner\"\n        alt=\"Talkies banner\"\n        src=\"https://d2gbygv6wnrxcy.cloudfront.net/new-dugdale-arts-centre/events/banner/talkies_banner.png\"\n                type=\"image/png\"\n    />\n</picture>  </div>\n    <div class=\"content\">\n    <div class=\"container\">\n      <h4><a href=\"/whats-on\">< Back to events</a></h4>\n            <div class=\"cms-content\">\n          <p><strong>Talkies Community Cinema</strong> is a volunteer-led film organisation bringing inclusive, affordable cinema experiences to local audiences. </p>\n<p>Working in partnership DAC, Talkies screens a diverse mix of independent, classic and popular films, spanning genres from drama, comedy and documentary to world cinema and family favourites. </p>\n<p>Our programme is committed to widening access to film, keeping ticket prices low, and creating a welcoming, sociable atmosphere for all.</p>\n<p><strong>Upcoming Films</strong></p>\n<p><strong></strong><a href=\"https://www.dugdaleartscentre.co.uk/whats-on/the-presidents-cake\" target=\"_blank\" rel=\"noreferrer noopener\">The President's Cake (2025) | Wed 3 Sept</a><strong><br /></strong></p>\n<p><strong>Previous Films<br /></strong>Sirāt (2025)</p>\n      </div>\n          </div>\n  </div>\n</div>\n    <footer id=\"footer\">\n  <div class=\"container\">\n    <div class=\"logo\">\n      <h2>Dugdale<br/>Arts<br/>Centre</h2>\n    </div>\n    <div class=\"contact-details\">\n      <h3>Box office</h3>\n      <h2><a href=\"tel:08006403928\">0800 640 3928</a></h2>\n      <h6><a href=\"mailto:culture@enfield.gov.uk\">culture@enfield.gov.uk</a></h6>\n    </div>\n    <div class=\"address\">\n      <h6>Dugdale Arts Centre,<br/>39 London Road,<br />Enfield,<br />EN2 6DS</h6>\n    </div>\n    <div class=\"socials\">\n      <a target=\"_blank\" href=\"https://twitter.com/DAC_Enfield\"><img class=\"social-icon\" alt=\"Twitter\" src=\"/assets/images/icons/twitter.svg\" /></a>\n      <a target=\"_blank\" href=\"https://www.instagram.com/dugdaleartscentre/\"><img class=\"social-icon\" alt=\"Instagram\" src=\"/assets/images/icons/instagram.svg\" /></a>\n      <a target=\"_blank\" href=\"https://www.facebook.com/dugdaleartscentre\"><img class=\"social-icon\" alt=\"Facebook\" src=\"/assets/images/icons/facebook.svg\" /></a>\n            <a target=\"_blank\" href=\"https://www.tiktok.com/@dugdaleartscentre\"><img class=\"social-icon\" alt=\"TikTok\" src=\"/assets/images/icons/tiktok.svg\" /></a>\n    </div>\n    <div class=\"supported-by\">\n      <h3>Supported by</h3>\n      <img class=\"enfield-logo\" alt=\"Enfield Council logo\" src=\"/assets/images/enfield-council.png\" />\n    </div>\n    <div class=\"copyright\">\n      <p>&copy; Dugdale Arts Centre 2026</p>\n    </div>\n    <div class=\"links\">\n      <p><a href=\"/terms-conditions\">Terms & Conditions</a></p>\n      <p><a href=\"/privacy-policy-cookies\">Privacy Policy</a></p>\n      <p><a href=\"/plan-your-visit#accessibility\">Special access</a></p>\n    </div>\n  </div>\n</footer>\n    <script src=\"/assets/js/app.js\"></script>\n    <!--<svg></svg>-->\n<script type=\"application/ld+json\">{\"@context\":\"http://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"author\":{\"@id\":\"#identity\"},\"copyrightHolder\":{\"@id\":\"#identity\"},\"copyrightYear\":\"2026\",\"creator\":{\"@id\":\"#creator\"},\"dateModified\":\"2026-07-09T07:30:46-07:00\",\"datePublished\":\"2026-05-14T04:32:00-07:00\",\"headline\":\"Talkies Community Cinema\",\"inLanguage\":\"en-us\",\"mainEntityOfPage\":\"https://www.dugdaleartscentre.co.uk/whats-on/talkies-community-cinema\",\"name\":\"Talkies Community Cinema\",\"publisher\":{\"@id\":\"#creator\"},\"url\":\"https://www.dugdaleartscentre.co.uk/whats-on/talkies-community-cinema\"},{\"@id\":\"#identity\",\"@type\":\"Organization\"},{\"@id\":\"#creator\",\"@type\":\"Organization\"},{\"@type\":\"BreadcrumbList\",\"description\":\"Breadcrumbs list\",\"itemListElement\":[{\"@type\":\"ListItem\",\"item\":\"https://www.dugdaleartscentre.co.uk\",\"name\":\"Homepage\",\"position\":1},{\"@type\":\"ListItem\",\"item\":\"https://www.dugdaleartscentre.co.uk/whats-on\",\"name\":\"Whats On\",\"position\":2},{\"@type\":\"ListItem\",\"item\":\"https://www.dugdaleartscentre.co.uk/whats-on/talkies-community-cinema\",\"name\":\"Talkies Community Cinema\",\"position\":3}],\"name\":\"Breadcrumbs\"}]}</script></body>\n</html>",
