            "mimeType": "text/html; charset=UTF-8",
            "text": "<!DOCTYPE html>\n<html lang=\"en-US\">\n<head>\n      <script\n    type=\"text/javascript\"\n    src=\"https://tickets.dugdaleartscentre.co.uk/millfieldartscentre/website/scripts/integrate.js\"\n  ></script>\n    <!-- SEO PLUGIN -->\n        <!-- END SEO PLUGIN -->\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/assets/favicons/apple-touch-icon.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/assets/favicons/favicon-32x32.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/assets/favicons/favicon-16x16.png\">\n<link rel=\"manifest\" href=\"/assets/favicons/site.webmanifest\">\n<link rel=\"mask-icon\" href=\"/assets/favicons/safari-pinned-tab.svg\" color=\"#5bbad5\">\n<link rel=\"shortcut icon\" href=\"/assets/favicons/favicon.ico\">\n<meta name=\"msapplication-TileColor\" content=\"#da532c\">\n<meta name=\"msapplication-config\" content=\"/assets/favicons/browserconfig.xml\">\n<meta name=\"theme-color\" content=\"#ffffff\">\n    <link rel=\"stylesheet\" href=\"/assets/css/app.min.css\" />\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Black Film Club | Dugdale Arts Centre</title>\n<script>window.dataLayer = window.dataLayer || [];\nfunction gtag(){dataLayer.push(arguments)};\ngtag('js', new Date());\ngtag('config', 'UA-87477549-3', {'send_page_view': true,'anonymize_ip': false,'link_attribution': false,'allow_display_features': false});\n</script><meta name=\"generator\" content=\"SEOmatic\">\n<meta name=\"referrer\" content=\"no-referrer-when-downgrade\">\n<meta name=\"robots\" content=\"all\">\n<meta content=\"en_US\" property=\"og:locale\">\n<meta content=\"Dugdale Arts Centre\" property=\"og:site_name\">\n<meta content=\"website\" property=\"og:type\">\n<meta content=\"https://www.dugdaleartscentre.co.uk/whats-on/black-film-club\" property=\"og:url\">\n<meta content=\"Black Film Club\" property=\"og:title\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:creator\" content=\"@\">\n<meta name=\"twitter:title\" content=\"Black Film Club\">\n<link href=\"https://www.dugdaleartscentre.co.uk/whats-on/black-film-club\" rel=\"canonical\">\n<link href=\"https://www.dugdaleartscentre.co.uk\" rel=\"home\">\n<link type=\"text/plain\" href=\"https://www.dugdaleartscentre.co.uk/humans.txt\" rel=\"author\"></head>\n<body class=\"ltr\"><script async src=\"https://www.googletagmanager.com/gtag/js?id=UA-87477549-3\"></script>\n\n    <nav id=\"navigation\">\n    <div id=\"navbar\">\n        <div class=\"container\">\n            <div class=\"hamburger\" onclick=\"toggleNav();\">\n                <svg class=\"ham hamRotate\" viewBox=\"0 0 100 100\">\n                    <path class=\"line top\" d=\"m 30,33 h 40 c 3.722839,0 7.5,3.126468 7.5,8.578427 0,5.451959 -2.727029,8.421573 -7.5,8.421573 h -20\" />\n                    <path class=\"line middle\" d=\"m 30,50 h 40\" />\n                    <path class=\"line bottom\" d=\"m 70,67 h -40 c 0,0 -7.5,-0.802118 -7.5,-8.365747 0,-7.563629 7.5,-8.634253 7.5,-8.634253 h 20\" />\n                </svg>\n            </div>\n            <a href=\"/\" class=\"logo-wrapper\">\n                <lottie-player id=\"lottie-logo\" src=\"/assets/images/Dugdale_Arts_Centre_-_Animated_Logo.json\" background=\"transparent\" speed=\"1\"></lottie-player>\n            </a>\n            <div class=\"quick-links-group\">\n                                <a href=\"/checkout/\" class=\"cart quick-link\">\n                    <img class=\"cart\" alt=\"Cart\" src=\"/assets/images/icons/cart.svg\" />\n                </a>\n                <a href=\"/my-account/\" class=\"account quick-link\">\n                    <img class=\"account\" alt=\"My account\" src=\"/assets/images/icons/my-account.svg\" />\n                </a>\n            </div>\n        </div>\n    </div>\n    <div id=\"menu\">\n        <div class=\"container\">\n            <ul>\n                                <li>\n                    <h4>\n                        <a href=\"/about-us\">About us</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/whats-on\">What&#039;s on</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/plan-your-visit\">Plan your visit</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/museum\">Museum</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/food\">Food</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/community\">Community</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/hires\">Hires</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/jobs\">Jobs</a>\n                    </h4>\n                </li>\n                            </ul>\n        </div>\n    </div>\n    <script src=\"https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js\"></script> \n</nav>\n    <div class=\"page events\">\n  <div class=\"details\">\n    <div class=\"container\">\n      <div class=\"title-and-type\">\n        <h5>FILM</h5>\n        <h2>Black Film Club</h2>\n      </div>\n            <div class=\"dates-and-times\">\n        <h5>Dates and times</h5>\n        <h4>Monthly</h4>\n      </div>\n          </div>\n  </div>\n    <div class=\"banner-wrapper\">\n    <picture>\n        <source srcset=\"https://d2gbygv6wnrxcy.cloudfront.net/new-dugdale-arts-centre/events/banner/_eventBanner/1341356/DAC-BFC25-Web-Banner.webp\" type=\"image/webp\">\n        <img\n        class=\"event-banner\"\n        alt=\"DAC BFC25 Web Banner\"\n        src=\"https://d2gbygv6wnrxcy.cloudfront.net/new-dugdale-arts-centre/events/banner/DAC-BFC25-Web-Banner.png\"\n                type=\"image/png\"\n    />\n</picture>  </div>\n    <div class=\"content\">\n    <div class=\"container\">\n      <h4><a href=\"/whats-on\">< Back to events</a></h4>\n            <div class=\"cms-content\">\n          <figure><img src=\"https://d2gbygv6wnrxcy.cloudfront.net/new-dugdale-arts-centre/ECA-Logo_transparent-smaller.png\" alt=\"\" /></figure>\n<p><br />Enfield Caribbean Association, in partnership with Dugdale Arts Centre, presents the Black Film Club</p>\n<p><strong>The Black Film Club celebrates Black talent and stories through great films. From classics to new hits, we curate movies to inspire and bring people together and present post-show activities which give audiences the opportunity to dive deeper. Open to everyone, we share the beauty of Black cinema with the whole community. </strong><br /></p>\n<p>Come watch, connect, and enjoy with us! Please click on the title of the film you wish to see for booking.</p>\n<p><strong>2026 Season</strong><a href=\"https://www.dugdaleartscentre.co.uk/whats-on/fire-in-babylon-2010\" target=\"_blank\" rel=\"noreferrer noopener\"></a><a href=\"https://www.dugdaleartscentre.co.uk/whats-on/fire-in-babylon-2010\"></a><a href=\"https://www.dugdaleartscentre.co.uk/whats-on/fire-in-babylon-2010\" target=\"_blank\" rel=\"noreferrer noopener\"><strong> </strong></a><strong>2</strong><strong></strong><br /></p>\n<p><strong>My Fathers Shadow | Fri 15 May</strong></p>\n<p><em>A visually striking drama about two boys navigating Lagos with their estranged father during the 1993 election crisis, an emotional story of family and memory, followed by a discussion.</em></p>\n<p><strong>Windrush Voices | Wed 24 Jun<br /></strong></p>\n<p><em>A moving documentary sharing first hand stories of Caribbean and African migrants who came to Britain from 1948, tracing their journeys, struggles, and resilience as part of the Windrush Generation. Followed by a post film discussion.</em></p>\n<p><a href=\"https://www.dugdaleartscentre.co.uk/whats-on/sing-your-song-the-story-of-harry-belafonte-2011\"><strong>Sing Your Song: The Story of Harry Belafonte (2011) | Fri 24 Jul</strong></a></p>\n<p><em>Sing Your Song is an inspiring story of performance and protest, from a superstar singer and actor who was on the front lines of practically every progressive political battle in modern memory.</em><em><br /></em></p>\n<p><strong>Previous Films</strong><br /></p>\n<p><a href=\"https://www.dugdaleartscentre.co.uk/whats-on/fire-in-babylon-2010\" target=\"_blank\" rel=\"noreferrer noopener\"></a>Milestone: Streets Paved with Gold<br /></p>\n<p>Wicked</p>\n<p>Fire in Babylon</p>\n<p></p>\n<p><strong></strong></p>\n<p><br /></p>\n<pre></pre>\n<p><em>Supported by </em></p>\n<figure><img src=\"https://d2gbygv6wnrxcy.cloudfront.net/new-dugdale-arts-centre/tnb_filmcollective-small.png\" alt=\"\" /></figure>\n      </div>\n          </div>\n  </div>\n</div>\n    <footer id=\"footer\">\n  <div class=\"container\">\n    <div class=\"logo\">\n      <h2>Dugdale<br/>Arts<br/>Centre</h2>\n    </div>\n    <div class=\"contact-details\">\n      <h3>Box office</h3>\n      <h2><a href=\"tel:08006403928\">0800 640 3928</a></h2>\n      <h6><a href=\"mailto:culture@enfield.gov.uk\">culture@enfield.gov.uk</a></h6>\n    </div>\n    <div class=\"address\">\n      <h6>Dugdale Arts Centre,<br/>39 London Road,<br />Enfield,<br />EN2 6DS</h6>\n    </div>\n    <div class=\"socials\">\n      <a target=\"_blank\" href=\"https://twitter.com/DAC_Enfield\"><img class=\"social-icon\" alt=\"Twitter\" src=\"/assets/images/icons/twitter.svg\" /></a>\n      <a target=\"_blank\" href=\"https://www.instagram.com/dugdaleartscentre/\"><img class=\"social-icon\" alt=\"Instagram\" src=\"/assets/images/icons/instagram.svg\" /></a>\n      <a target=\"_blank\" href=\"https://www.facebook.com/dugdaleartscentre\"><img class=\"social-icon\" alt=\"Facebook\" src=\"/assets/images/icons/facebook.svg\" /></a>\n            <a target=\"_blank\" href=\"https://www.tiktok.com/@dugdaleartscentre\"><img class=\"social-icon\" alt=\"TikTok\" src=\"/assets/images/icons/tiktok.svg\" /></a>\n    </div>\n    <div class=\"supported-by\">\n      <h3>Supported by</h3>\n      <img class=\"enfield-logo\" alt=\"Enfield Council logo\" src=\"/assets/images/enfield-council.png\" />\n    </div>\n    <div class=\"copyright\">\n      <p>&copy; Dugdale Arts Centre 2026</p>\n    </div>\n    <div class=\"links\">\n      <p><a href=\"/terms-conditions\">Terms & Conditions</a></p>\n      <p><a href=\"/privacy-policy-cookies\">Privacy Policy</a></p>\n      <p><a href=\"/plan-your-visit#accessibility\">Special access</a></p>\n    </div>\n  </div>\n</footer>\n    <script src=\"/assets/js/app.js\"></script>\n    <!--<svg></svg>-->\n<script type=\"application/ld+json\">{\"@context\":\"http://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"author\":{\"@id\":\"#identity\"},\"copyrightHolder\":{\"@id\":\"#identity\"},\"copyrightYear\":\"2025\",\"creator\":{\"@id\":\"#creator\"},\"dateModified\":\"2026-06-24T04:02:10-07:00\",\"datePublished\":\"2025-01-13T02:09:00-08:00\",\"headline\":\"Black Film Club\",\"inLanguage\":\"en-us\",\"mainEntityOfPage\":\"https://www.dugdaleartscentre.co.uk/whats-on/black-film-club\",\"name\":\"Black Film Club\",\"publisher\":{\"@id\":\"#creator\"},\"url\":\"https://www.dugdaleartscentre.co.uk/whats-on/black-film-club\"},{\"@id\":\"#identity\",\"@type\":\"Organization\"},{\"@id\":\"#creator\",\"@type\":\"Organization\"},{\"@type\":\"BreadcrumbList\",\"description\":\"Breadcrumbs list\",\"itemListElement\":[{\"@type\":\"ListItem\",\"item\":\"https://www.dugdaleartscentre.co.uk\",\"name\":\"Homepage\",\"position\":1},{\"@t