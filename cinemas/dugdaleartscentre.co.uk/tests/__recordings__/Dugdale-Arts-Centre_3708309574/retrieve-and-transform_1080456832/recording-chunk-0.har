ry_large_image\">\n<meta name=\"twitter:creator\" content=\"@\">\n<meta name=\"twitter:title\" content=\"Black Film Club\">\n<link href=\"https://www.dugdaleartscentre.co.uk/whats-on/black-film-club\" rel=\"canonical\">\n<link href=\"https://www.dugdaleartscentre.co.uk\" rel=\"home\">\n<link type=\"text/plain\" href=\"https://www.dugdaleartscentre.co.uk/humans.txt\" rel=\"author\"></head>\n<body class=\"ltr\"><script async src=\"https://www.googletagmanager.com/gtag/js?id=UA-87477549-3\"></script>\n\n    <nav id=\"navigation\">\n    <div id=\"navbar\">\n        <div class=\"container\">\n            <div class=\"hamburger\" onclick=\"toggleNav();\">\n                <svg class=\"ham hamRotate\" viewBox=\"0 0 100 100\">\n                    <path class=\"line top\" d=\"m 30,33 h 40 c 3.722839,0 7.5,3.126468 7.5,8.578427 0,5.451959 -2.727029,8.421573 -7.5,8.421573 h -20\" />\n                    <path class=\"line middle\" d=\"m 30,50 h 40\" />\n                    <path class=\"line bottom\" d=\"m 70,67 h -40 c 0,0 -7.5,-0.802118 -7.5,-8.365747 0,-7.563629 7.5,-8.634253 7.5,-8.634253 h 20\" />\n                </svg>\n            </div>\n            <a href=\"/\" class=\"logo-wrapper\">\n                <lottie-player id=\"lottie-logo\" src=\"/assets/images/Dugdale_Arts_Centre_-_Animated_Logo.json\" background=\"transparent\" speed=\"1\"></lottie-player>\n            </a>\n            <div class=\"quick-links-group\">\n                                <a href=\"/checkout/\" class=\"cart quick-link\">\n                    <img class=\"cart\" alt=\"Cart\" src=\"/assets/images/icons/cart.svg\" />\n                </a>\n                <a href=\"/my-account/\" class=\"account quick-link\">\n                    <img class=\"account\" alt=\"My account\" src=\"/assets/images/icons/my-account.svg\" />\n                </a>\n            </div>\n        </div>\n    </div>\n    <div id=\"menu\">\n        <div class=\"container\">\n            <ul>\n                                <li>\n                    <h4>\n                        <a href=\"/about-us\">About us</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/whats-on\">What&#039;s on</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/plan-your-visit\">Plan your visit</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/museum\">Museum</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/food\">Food</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/community\">Community</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/hires\">Hires</a>\n                    </h4>\n                </li>\n                                <li>\n                    <h4>\n                        <a href=\"/jobs\">Jobs</a>\n                    </h4>\n                </li>\n                            </ul>\n        </div>\n    </div>\n    <script src=\"https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js\"></script> \n</nav>\n    <div class=\"page events\">\n  <div class=\"details\">\n    <div class=\"container\">\n      <div class=\"title-and-type\">\n        <h5>FILM</h5>\n        <h2>Black Film Club</h2>\n      </div>\n            <div class=\"dates-and-times\">\n        <h5>Dates and times</h5>\n        <h4>Monthly</h4>\n      </div>\n          </div>\n  </div>\n    <div class=\"banner-wrapper\">\n    <picture>\n        <source srcset=\"https://d2gbygv6wnrxcy.cloudfront.net/new-dugdale-arts-centre/events/banner/_eventBanner/1341356/DAC-BFC25-Web-Banner.webp\" type=\"image/webp\">\n        <img\n        class=\"event-banner\"\n        alt=\"DAC BFC25 Web Banner\"\n        src=\"https://d2gbygv6wnrxcy.cloudfront.net/new-dugdale-arts-centre/events/banner/DAC-BFC25-Web-Banner.png\"\n                type=\"image/png\"\n    />\n</picture>  </div>\n    <div class=\"content\">\n    <div class=\"container\">\n      <h4><a href=\"/whats-on\">< Back to events</a></h4>\n            <div class=\"cms-content\">\n          <figure><img src=\"https://d2gbygv6wnrxcy.cloudfront.net/new-dugdale-arts-centre/ECA-Logo_transparent-smaller.png\" alt=\"\" /></figure>\n<p><br />Enfield Caribbean Association, in partnership with Dugdale Arts Centre, presents the Black Film Club</p>\n<p><strong>The Black Film Club celebrates Black talent and stories through great films. From classics to new hits, we curate movies to inspire and bring people together and present post-show activities which give audiences the opportunity to dive deeper. Open to everyone, we share the beauty of Black cinema with the whole community. </strong><br /></p>\n<p>Come watch, connect, and enjoy with us!</p>\n<p><strong>2026 Season</strong><a href=\"https://www.dugdaleartscentre.co.uk/whats-on/fire-in-babylon-2010\" target=\"_blank\" rel=\"noreferrer noopener\"></a><a href=\"https://www.dugdaleartscentre.co.uk/whats-on/fire-in-babylon-2010\"></a><a href=\"https://www.dugdaleartscentre.co.uk/whats-on/fire-in-babylon-2010\" target=\"_blank\" rel=\"noreferrer noopener\"><strong></strong></a><a href=\"https://www.dugdaleartscentre.co.uk/whats-on/fire-in-babylon-2010\" target=\"_blank\" rel=\"noreferrer noopener\"><strong><strong><br /></strong><strong></strong></strong></a><strong><a href=\"https://www.dugdaleartscentre.co.uk/whats-on/fire-in-babylon-2010\"><strong><br /></strong>Fire in Babylon | Fri 30 Jan</a></strong><strong></strong><em><br /></em></p>\n<p><em>Critically acclaimed British documentary film on the West Indies cricket team's rise to being one of the greatest cricket teams the world has ever seen in the 1970s and 1980s, featuring stock footage and interviews with several former players and officials.</em><a href=\"https://www.dugdaleartscentre.co.uk/whats-on/summer-of-soul-2021\" target=\"_blank\" rel=\"noreferrer noopener\"><strong></strong></a><br /></p>\n<p><strong><a href=\"https://www.dugdaleartscentre.co.uk/whats-on/wicked-2024\" target=\"_blank\" rel=\"noreferrer noopener\">Wicked | Sat 21 Feb</a></strong></p>\n<p><em>This Academy Award winning film Wicked reimagines Oz through the electrifying friendship between Elphaba (Cynthia Erivo), a brilliant, misunderstood outsider, and Glinda (Ariana Grande), the kingdom’s golden girl.</em></p>\n<p><a href=\"https://www.dugdaleartscentre.co.uk/whats-on/stolen-dreams-redemption-2025\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Stolen Dreams: Redemption | Fri 27 Mar </strong></a></p>\n<p><em>A new film from British filmmaker Emeka Egbuonu, Stolen Dreams: Redemption is a gripping and emotionally charged film exploring youth violence, consequences, and redemption.</em></p>\n<p><br /></p>\n<pre></pre>\n<p><em>Supported by </em></p>\n<figure><img src=\"https://d2gbygv6wnrxcy.cloudfront.net/new-dugdale-arts-centre/tnb_filmcollective-small.png\" alt=\"\" /></figure>\n      </div>\n          </div>\n  </div>\n</div>\n    <footer id=\"footer\">\n  <div class=\"container\">\n    <div class=\"logo\">\n      <h2>Dugdale<br/>Arts<br/>Centre</h2>\n    </div>\n    <div class=\"contact-details\">\n      <h3>Box office</h3>\n      <h2><a href=\"tel:08006403928\">0800 640 3928</a></h2>\n      <h6><a href=\"mailto:culture@enfield.gov.uk\">culture@enfield.gov.uk</a></h6>\n    </div>\n    <div class=\"address\">\n      <h6>Dugdale Arts Centre,<br/>39 London Road,<br />Enfield,<br />EN2 6DS</h6>\n    </div>\n    <div class=\"socials\">\n      <a target=\"_blank\" href=\"https://twitter.com/DAC_Enfield\"><img class=\"social-icon\" alt=\"Twitter\" src=\"/assets/images/icons/twitter.svg\" /></a>\n      <a target=\"_blank\" href=\"https://www.instagram.com/dugdaleartscentre/\"><img class=\"social-icon\" alt=\"Instagram\" src=\"/assets/images/icons/instagram.svg\" /></a>\n      <a target=\"_blank\" href=\"https://www.facebook.com/dugdaleartscentre\"><img class=\"social-icon\" alt=\"Facebook\" src=\"/assets/images/icons/facebook.svg\" /></a>\n            <a target=\"_blank\" href=\"https://www.tiktok.com/@dugdaleartscentre\"><img class=\"social-icon\" alt=\"TikTok\" src=\"/assets/images/icons/tiktok.svg\" /></a>\n    </div>\n    <div class=\"supported-by\">\n      <h3>Supported by</h3>\n      <img class=\"enfield-logo\" alt=\"Enfield Council logo\" src=\"/assets/images/enfield-council.png\" />\n    </div>\n    <div class=\"copyright\">\n      <p>&copy; Dugdale Arts Centre 2026</p>\n    </div>\n    <div class=\"links\">\n      <p><a href=\"/terms-conditions\">Terms & Conditions</a></p>\n      <p><a href=\"/privacy-policy-cookies\">Privacy Policy</a></p>\n      <p><a href=\"/plan-your-visit#accessibility\">Special access</a></p>\n    </div>\n  </div>\n</footer>\n    <script src=\"/assets/js/app.js\"></script>\n    <!--<svg></svg>-->\n<script type=\"application/ld+json\">{\"@context\":\"http://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"author\":{\"@id\":\"#identity\"},\"copyrightHolder\":{\"@id\":\"#identity\"},\"copyrightYear\":\"2025\",\"creator\":{\"@id\":\"#creator\"},\"dateModified\":\"2025-12-30T04:39:11-08:00\",\"datePublished\":\"2025-01-13T02:09:00-08:00\",\"headline\":\"Black Film Club\",\"inLanguage\":\"en-us\",\"mainEntityOfPage\":\"https://www.dugdaleartscentre.co.uk/whats-on/black-film-club\",\"name\":\"Black Film Club\",\"publisher\":{\"@id\":\"#creator\"},\"url\":\"https://www.dugdaleartscentre.co.uk/whats-on/black-film-club\"},{\"@id\":\"#identity\",\"@type\":\"Organization\"},{\"@id\":\"#creator\",\"@type\":\"Organization\"},{\"@type\":\"BreadcrumbList