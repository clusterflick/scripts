__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Wallace\",\"lastName\":\"Shawn\",\"__typename\":\"Person\"}}]},\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/59528a155a906875ee1cdc3d27b09e93.jpg\",\"synopsis\":\"The toys are back in Disney and Pixar’s “Toy Story 5,” and this time around it’s Toy meets Tech. \\n\\nWith Woody helping abandoned toys find owners, Jessie is now the leader of Bonnie's room, with Buzz Lightyear as her second-in-command. But the gang’s jobs get exponentially harder when they go head to head with this all-new threat to playtime…a frog-like tablet named Lilypad.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/35b6bf49917721d8e48a3249ea164835.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Toy Story 5\",\"synopsis\":\"The toys are back in Disney and Pixar’s “Toy Story 5,” and this time around it’s Toy meets Tech. \\n\\nWith Woody helping abandoned toys find owners, Jessie is now the leader of Bonnie's room, with Buzz Lightyear as her second-in-command. But the gang’s jobs get exponentially harder when they go head to head with this all-new threat to playtime…a frog-like tablet named Lilypad.\",\"certificate\":\"PG\",\"casting\":[\"Tom Hanks\",\"Tim Allen\",\"Joan Cusack\",\"Greta Lee\",\"Craig Robinson\",\"Conan O'Brien\",\"Tony Hale\",\"Shelby Rabara\",\"Scarlett Spears\",\"Wallace Shawn\"],\"direction\":[\"Andrew Stanton\",\"McKenna Harris\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/35b6bf49917721d8e48a3249ea164835.jpg\",\"https://all.web.img.acsta.net/img/77/3d/773d1cbfbfaf5e010f9acaad9641ebc3.jpg\",\"https://all.web.img.acsta.net/img/84/f1/84f1520e1b0956cdca401679e3d1a78a.jpg\",\"https://all.web.img.acsta.net/img/bc/c6/bcc6ce117be3