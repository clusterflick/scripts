          "content": {
            "mimeType": "application/json",
            "text": "{\"data\":{\"allMovieComment\":{\"nodes\":[{\"id\":\"V2Vic2l0ZU1hbmFnZXJNb3ZpZUNvbW1lbnQ6ZDczZTUxMjctOWQzMC00ODk1LTlhNGMtNTk0MGViMDdhNzhl\",\"comment\":\"<p><strong>The Last Viking</strong> is presented in Danish and Swedish language with English subtitles.</p>\",\"movie\":\"1000047646\",\"theater\":null},{\"id\":\"V2Vic2l0ZU1hbmFnZXJNb3ZpZUNvbW1lbnQ6YjVlYjAzNGEtMmJlMi00OTQzLTgxODItZjc4NGQzMDNkZmRl\",\"comment\":\"<p><strong>The Ghost in the Shell</strong> is dubbed in English language.</p>\",\"movie\":\"1000047637\",\"theater\":null},{\"id\":\"V2Vic2l0ZU1hbmFnZXJNb3ZpZUNvbW1lbnQ6Y2VmNmYwNzctZTYzNC00NDJlLTk2ZWUtMTI3MTExZjQ1YjVh\",\"comment\":\"<p><strong>Angel's Egg</strong> is presented in Japanese language with English subtitles.</p>\",\"movie\":\"44305\",\"theater\":null},{\"id\":\"V2Vic2l0ZU1hbmFnZXJNb3ZpZUNvbW1lbnQ6OGY4YTkwM2UtMDc5Mi00OWU3LTgzYzEtNTQ0NDNlMDAxYmVm\",\"comment\":\"<p><strong>Angel's Egg</strong> is presented in Japanese language with English subtitles.</p>\",\"movie\":\"1000046200\",\"theater\":null},{\"id\":\"V2Vic2l0ZU1hbmFnZXJNb3ZpZUNvbW1lbnQ6Y2ViOTU4YWMtMjE1Yi00MjU4LThjODYtMWY3Mzc1NzY4MmQ0\",\"comment\":\"<p><strong>Effi o Blaenau</strong> is presented in Welsh language with English subtitles.</p>\",\"movie\":\"1000046831\",\"theater\":null},{\"id\":\"V2Vic2l0ZU1hbmFnZXJNb3ZpZUNvbW1lbnQ6MDYwN2ZkNDYtODAyNi00NzZhLThjZGMtNmEwODY1YWIzYTcz\",\"comment\":\"<p><strong>Effi o Blaenau</strong> is presented in Welsh language with English subtitles.</p>\",\"movie\":\"1000041000\",\"theater\":null},{\"id\":\"V2Vic2l0ZU1hbmFnZXJNb3ZpZUNvbW1lbnQ6ZTI3NGQ2NWItYWFmMS00ODdkLTgzZmUtNDU4MmQwZTliY2Ni\",\"comment\":\"<p><strong>Kapodistrias</strong> is presented in Greek language with English subtitles.</p>\",\"movie\":\"1000036008\",\"theater\":null},{\"id\":\"V2Vic2l0ZU1hbmFnZXJNb3ZpZUNvbW1lbnQ6ZjM1NmZjZDQtZGIwNC00ODg0LTllM2EtMWFjZDEyMTVhN2Rm\",\"comment\":\"<p><strong>Orphan </strong>is presented in Hungarian language with English subtitles.</p>\",\"movie\":\"326661\",\"theater\":null},{\"id\":\"V2Vic2l0ZU1hbmFnZXJNb3ZpZUNvbW1lbnQ6MDY0MDkzOTEtY2FmMy00YWJmLTg4MDEtOWRkY2Q0NTY3NTMw\",\"comment\":\"<p><strong>The Stranger</strong> is presented in French language with English subtitles.</p>\",\"movie\":\"1000019380\",\"theater\":null},{\"id\":\"V2Vic2l0ZU1hbmFnZXJNb3ZpZUNvbW1lbnQ6YjIxMzUwMzctNDI0MS00YjA0LWFmNjgtNWRkZGI4OWVhZDZj\",\"comment\":\"<p><strong>Primavera</strong> is presented in Italian language with English subtitles.</p>\",\"movie\":\"1000018672\",\"theater\":null},{\"id\":\"V2Vic2l0ZU1hbmFnZXJNb3ZpZUNvbW1lbnQ6MjQwMmI2YjktZDAxYi00OGY1LWI1NzEtMGJmZTEyMjAxMjg0\",\"comment\":\"<p><strong>Akira </strong>is presented in English language.</p>\",\"movie\":\"1000041872\",\"theater\":null},{\"id\":\"V2Vic2l0ZU1hbmFnZXJNb3ZpZUNvbW1lbnQ6Yzk0NDdmZmEtYTBlYy00OTg1LWE4ZDgtOGQyNWVlZmYxMDYz\",\"comment\":\"<p><strong>Akira</strong>&nbsp;is presented in Japanese language with English subtitles.</p>\",\"movie\":\"1000041871\",\"theater\":null},{\"id\":\"V2Vic2l0ZU1hbmFnZXJNb3ZpZUNvbW1lbnQ6YmY2MTQyZjMtOTBkMy00ZjM2LTk4YmYtNjczMTFmMmI2MzYz\",\"comment\":\"<p><strong>Am&eacute;lie </strong>is presented in French language with English subtitles.</p>\",\"movie\":\"1000040931\",\"theater\":null},{\"id\":\"V2Vic2l0ZU1hbmFnZXJNb3ZpZUNvbW1lbnQ6ZDIyM2M2YWItNWQ0Yi00Y2JmLTkxMzgtMzQ0OTU4NTQyYTQ5\",\"comment\":\"<p><strong>Sir&acirc;t</strong> is presented in Spanish and French language with English subtitles.</p>\",\"movie\":\"317783\",\"theater\":null},{\"id\":\"V2Vic2l0ZU1hbmFnZXJNb3ZpZUNvbW1lbnQ6YWE0NTNmNjQtNmY0My00YTc2LWFjMGEtNjk2ZDFiNzNmN2Y1\",\"comment\":\"<p><strong>Sir&acirc;t</strong> is presented in Spanish and French language with English subtitles.</p>\",\"movie\":\"1000040936\",\"theater\":null}]}}}",
