stName\":\"Valeriia\",\"lastName\":\"Karaman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Werwulf\",\"synopsis\":null,\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2027-01-01T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/eb86ca5dc222b2a6a3d5b12400668fce.jpg\",\"synopsis\":\"In medieval Britain, a mysterious creature stalks the foggy countryside, transforming local folklore into terrifying reality as villagers face an ancient supernatural threat.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Werwulf\",\"synopsis\":\"In medieval Britain, a mysterious creature stalks the foggy countryside, transforming local folklore into terrifying reality as villagers face an ancient supernatural threat.\",\"certificate\":null,\"casting\":[\"Aaron Taylor-Johnson\",\"Lily-Rose Depp\",\"Willem Dafoe\",\"Bodhi Rae Breathnach\",\"Ralph Ineson\",\"Jack Morris\",\"Vidal Arzoni\",\"Jan Bijvoet\",\"Ritchi Edwards\",\"Valeriia Karaman\"],\"direction\":[\"Robert Eggers\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/f4/d1/f4d16b53b4b8e7b3185327b749ec9aae.jpg\"],\"heroImages\":[],\"release\":\"2027-01-01T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Universal International Pictures\"}},{\"id\":\"298024\",\"title\":\"Wild Horse Nine\",\"runtime\":null,\"genres\":\"Thriller\",\"__typename\":\"Movie\",\"altId\":[\"367290\"],\"post