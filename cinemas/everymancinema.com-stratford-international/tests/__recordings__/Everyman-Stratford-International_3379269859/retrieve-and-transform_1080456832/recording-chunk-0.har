\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kenneth\",\"lastName\":\"Branagh\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Simone\",\"lastName\":\"Ashley\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lucy\",\"lastName\":\"Liu\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Justin\",\"lastName\":\"Theroux\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"B.J.\",\"lastName\":\"Novak\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Helen J.\",\"lastName\":\"Shen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"The Devil Wears Prada 2\",\"synopsis\":\"Almost twenty years after making their iconic turns as Miranda, Andy, Emily and Nigel—Meryl Streep, Anne Hathaway, Emily Blunt and Stanley Tucci return to the fashionable streets of New York City and the sleek offices of Runway Magazine in the eagerly awaited sequel to the 2006 phenomenon that defined a generation.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/5f/56/5f569a9a22dae2c405ff137917fb4074.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/369153_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/369153_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/f9835c1dbf40e8749c6fb9fa2587cf2a.jpg\",\"__typename\":\"BOAppImage\"}]}},\"releases\":[{\"releasedAt\":\"2026-05-01T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"infrequent strong language\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/68a0d2f65b041e3a8dc320c7457df605.jpg\",\"synopsis\":\"As Miranda Priestly (Meryl Streep) nears retirement, she reunites with Andy Sachs (Anne Hathaway) to face off against Emily Charlton (Emily Blunt), her former assistant turned rival, as they compete for advertising revenue amidst declining print media.\\n\\nTwenty years after making their iconic turns as Miranda, Andy, Emily and Nigel- Meryl Streep, Anne Hathaway, Emily Blunt and Stanley Tucci return to the fashionable streets of New York City and the sleek offices of Runway Magazine in 20th Century Studios’ “The Devil Wears Prada 2,” the eagerly awaited sequel to the 2006 phenomenon that defined a generation.\\n\\nThe Devil Wears Prada 2 reunites the original main cast of Meryl Streep, Anne Hathaway, Emily Blunt, and Stanley Tucci with director David Frankel and writer Aline Brosh McKenna. It also introduces an all-new runway of characters including Kenneth Branagh, Simone Ashley, Justin Theroux, Lucy Lui and more. The film also features an original song \\\"\\\"Runway\\\"\\\" performed by Lady Gaga and Doechii.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/c79258128e5b6f3d67174120a178c1d0.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Devil Wears Prada 2\",\"synopsis\":\"As Miranda Priestly (Meryl Streep) nears retirement, she reunites with Andy Sachs (Anne Hathaway) to face off against Emily Charlton (Emily Blunt), her former assistant turned rival, as they compete for advertising revenue amidst declining print media.\\n\\nTwenty years after making their iconic turns as Miranda, Andy, Emily and Nigel- Meryl Streep, Anne Hathaway, Emily Blunt and Stanley Tucci return to the fashionable streets of New York City and the sleek offices of Runway Magazine in 20th Century Studios’ “The Devil Wears Prada 2,” the eagerly awaited sequel to the 2006 phenomenon that defined a generation.\\n\\nThe Devil Wears Prada 2 reunites the original main cast of Meryl Streep, Anne Hathaway, Emily Blunt, and Stanley Tucci with director David Frankel and writer Aline Brosh McKenna. It also introduces an all-new runway of characters including Kenneth Branagh, Simone Ashley, Justin Theroux, Lucy Lui and more. The film also features an original song \\\"\\\"Runway\\\"\\\" performed by Lady Gaga and Doechii.\",\"certificate\":\"12A\",\"casting\":[\"Meryl Streep\",\"Anne Hathaway\",\"Emily Blunt\",\"Stanley Tucci\",\"Kenneth Branagh\",\"Simone Ashley\",\"Lucy Liu\",\"Justin Theroux\",\"B.J. Novak\",\"Helen J. Shen\"],\"direction\":[\"David Frankel\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/c79258128e5b6f3d67174120a178c1d0.jpg\",\"https://all.web.img.acsta.net/img/44/97/44978efc6a0d73d0d03d91d79fd054af.jpg\",\"https://all.web.img.acsta.net/img/80/cb/80cbcdcad040721b78b2cc10706d63e2.jpg\",\"https://all.web.img.acsta.net/img/04/4a/044a0598c27938b09409b2418b9f31a6.jpg\",\"https://all.web.img.acsta.net/img/c4/65/c46523e893ce478bfce792e0bb96449d.jpg\",\"https://all.web.img.acsta.net/img/d1/47/d147501bf94dea27b9a018db93a86051.jpg\",\"https://all.web.img.acsta.net/img/e9/23/e923cc84483137394afa84dd1dac93fd.jpg\",\"https://all.web.img.acsta.net/img/2a/bf/2abf29f2155742bb1e01bc849126d821.jpg\",\"https://all.web.img.acsta.net/img/e6/2c/e62cf5bd358042693cfb55d99a1d970b.jpg\",\"https://all.web.img.acsta.net/img/d9/e2/d9e23bd2046e96dd6