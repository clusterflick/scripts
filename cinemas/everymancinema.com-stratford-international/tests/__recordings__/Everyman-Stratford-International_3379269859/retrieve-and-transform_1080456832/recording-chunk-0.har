"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/eb/23/eb235a2275a008012de6fcda74441cae.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/fb/42/fb4252d958a4c9fa50de90d94ab21afe.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/1b/09/1b094d0fc0ca232c1f85b9187baaf153.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/5b/f0/5bf082fc30a0a03035b486df48c9ca47.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e3/4c/e34cf1c0f6924621f89d824002fb0958.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Daniel\",\"lastName\":\"Roher\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Leo\",\"lastName\":\"Woodall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dustin\",\"lastName\":\"Hoffman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Havana Rose\",\"lastName\":\"Liu\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lior\",\"lastName\":\"Raz\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jean\",\"lastName\":\"Reno\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tovah\",\"lastName\":\"Feldshuh\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"C.S.\",\"lastName\":\"Lee\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nissan\",\"lastName\":\"Sakira\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gil\",\"lastName\":\"Cohen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":null,\"lastName\":\"Rekstizzy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Tuner\",\"synopsis\":\"In Tuner, Academy Award-winning director Daniel Roher’s first narrative feature, Leo Woodall stars as a gifted young piano tuner whose heightened sense of hearing draws the attention of criminals, who see his talents as useful for opening safes as well as for tuning Steinways. With his once-promising musical career over, he works across New York with his mentor Harry Horowitz (Academy Award-winner Dustin Hoffman), encountering a range of characters, including composition student Ruthie (Havana Rose Liu), with whom he forges an unexpected connection. Niki’s safecracking work threatens his budding romance with Ruthie and pulls him into increasingly dangerous territory. Blending romance, drama, and the taut suspense of a heist thriller, Tuner also features performances from Tony Award-winner Tovah Feldshuh, Lior Raz, and Jean Reno.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/3c/91/3c91d18a0094e91ce71e588ab84673a9.jfif\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/373577_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/373577_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/646a4a912b233e2ec3aad282868da81e.jpg\",\"__typename\":\"BOAppImage\"}]}},\"releases\":[{\"releasedAt\":\"2026-05-29T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"1000110350\",\"name\":\"Black Bear Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong language, drug misuse, violence, brief sexual images\",\"__typename\":\"Rating\",\"certificate\":\"15\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8495d6833fc30ac9cb0e51e9f496c7c9.jpg\",\"synopsis\":\"Niki (Leo Woodall) is a gifted young piano tuner whose heightened sense of hearing draws the attention of criminals, who see his talents as useful for opening safes as for tuning Steinways. With his once-promising musical career over, he now works across New York under the guidance of his mentor Harry Horowitz (Academy Award-winner Dustin Hoffman), encountering a range of characters, including composition student Ruthie (Havana Rose Liu), with whom he forges an unexpected connection. Niki’s safecracking work threatens his budding romance with Ruthie and pulls him into increasingly dangerous territory.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/7119cb92757b1b1dad89d05fcc4043a4.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Tuner\",\"synopsis\":\"Niki (Leo Woodall) is a gifted young piano tuner whose heightened sense of hearing draws the attention of criminals, who see his talents as useful for opening safes as for tuning Steinways. With his once-promising musical career over, he now works across New York under the guidance of his mentor Harry Horowitz (Academy Award-winner Dustin Hoffman), encountering a range of characters, including composition student Ruthie (Havana Rose Liu), with whom he forges an unexpected connection. Niki’s safecracking work threatens his budding romance with Ruthie and pulls him into increasingly dangerous territory.\",\"certificate\":\"15\",\"casting\":[\"Leo Woodall\",\"Dustin Hoffman\",\"Havana Rose Liu\",\"Lior Raz\",\"Jean Reno\",\"Tovah Feldshuh\",\"C.S. Lee\",\"Nissan Sakira\",\"Gil Cohen\",\"Rekstizzy\"],\"direction\":[\"Daniel Roher\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/7119cb92757b1b1dad89d05fcc4043a4.jpg\",\"https://all.web.img.acsta.net/img/74/81/74817023520230ae1e6a227ef19139c4.jpg\",\"https://all.web.img.acsta.net/img/d4/7e/d47e400652207ecb89c4eef654933ba6.jpg\",\"https://all.web.img.acsta.net/img/83/02/8302b443efe0775d3031a6a5f6af87da.jpeg\",\"https://all.web.img.acsta.net/img/91/17/911701deb500338cc57866fbc52d797e.jpg\",\"https://all.web.img.acsta.net/img/61/3f/613ffe7bd175712746705e2710889a10.jpg\",\"https://all.web.img.acsta.net/img/eb/23/eb235a2275a008012de6fcda74441cae.jpg\",\"https://all.web.img.acsta.net/img/fb/42/fb4252d958a4c9fa50de90d94ab21afe.jpg\",\"https://all.web.img.acsta.net/img/1b/09/1b094d0fc0ca232c1f85b9187baaf153.jpg\",\"https://all.web.img.acsta.net/img/5b/f0/5bf082fc30a0a03035b486df48c9ca47.jpg\",\"https://all.web.img.acsta.net/img/e3/4c/e34cf1c0f6924621f89d824002fb0958.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/7119cb92757b1b1dad89d05fcc4043a4.jpg\",\"https://cms-assets.webediamovies.pro/production/2/646a4a912b233e2ec3aad282868da81e.jpg\"],\"release\":\"2026-05-29T00:00:00.000Z\",\"advisory\":\"strong language, drug misuse, violence, brief sexual images\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/373577_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/373577_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Black Bear Pictures\"},\"orderIndex\":14},{\"id\":\"1000044545\",\"title\":\"Twenty Years of the Met in Cinemas\",\"runtime\":null,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"416519\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2beee49a459647563c9e8743080bd700.jpg\",\"directors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Renée\",\"lastName\":\"Fleming\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Twenty Years of the Met in Cinemas\",\"synopsis\":\"Twenty Years of the Met in Cinemas is a celebration of the Met's two decades of onstage glory as experienced in movie theaters, featuring highlights from the company's collection of more than 185 extraordinary onscreen performances. With star soprano Renée Fleming as host, this special presentation will showcase unforgettable moments from some of opera's greatest stars, culled from the series' vast archive of transmissions.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/26/5c/265cec760bce8a605ca2768a6754f59b.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-09-19T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2beee49a459647563c9e8743080bd700.jpg\",\"synopsis\":\"\\nTwenty Years of the Met in Cinemas is a celebration of the Met’s two decades of onstage glory as experienced in cinemas, featuring highlights from the company’s collection of more than 185 extraordinary onscreen performances. Hosted by star soprano Renée Fleming, this special presentation will showcase unforgettable moments from some of opera’s greatest stars, selected from the series’ vast archive of broadcasts featuring such remarkable artists as Lise Davidsen, Natalie Dessay, Joyce DiDonato, Juan Diego Flórez, Elīna Garanča, Dmitri Hvorostovsky, Jonas Kaufmann, Peter Mattei, Matthew Polenzani, Sondra Radvanovsky, Nadine Sierra, and, of course, Fleming herself.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Twenty Years of the Met in Cinemas: An Anniversary Celebration\",\"synopsis\":\"\\nTwenty Years of the Met in Cinemas is a celebration of the Met’s two decades of onstage glory as experienced in cinemas, featuring highlights from the company’s collection of more than 185 extraordinary onscreen performances. Hosted by star soprano Renée Fleming, this special presentation will showcase unforgettable moments from some of opera’s greatest stars, selected from the series’ vast archive of broadcasts featuring such remarkable artists as Lise Davidsen, Natalie Dessay, Joyce DiDonato, Juan Diego Flórez, Elīna Garanča, Dmitri Hvorostovsky, Jonas Kaufmann, Peter Mattei, Matthew Polenzani, Sondra Radvanovsky, Nadine Sierra, and, of course, Fleming herself.\",\"certificate\":null,\"casting\":[\"Renée Fleming\"],\"direction\":[],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-09-19T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{},\"orderIndex\":40},{\"id\":\"305434\",\"title\":\"Virginia Woolf's Night & Day\",\"runtime\":5700,\"genres\":\"Comedy, Romance, Historical\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/f161a0718b8a0719291400041ce98e75.jpg\",\"__typename\":\"Movie\",\"altId\":[\"364297\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/4d/6e/4d6ef12e0dff8138d659cafaf26592b9.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/eb/94/eb94380fd0df0d037f19e6e3f601d305.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/23/e2/23e2dfea2a260b054cd36f9aa6077fb8.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/89/3b/893b258476ac3ca6bb27ea1387bbd99a.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/dc/54/dc544f2eb893c7295520f095b73fc519.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/23/a6/23a62b176756eeeb3807c18b2264daa6.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/02/9d/029da4de63cb5ab77e6e028788972e7a.jpg\",\"__typename\":\"Image\"}],\"quadImages\":[\"https://all.web.img.acsta.net/img/1d/a8/1da8c1f522b793aa9889385807bf79c1.webp\"],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Tina\",\"lastName\":\"Gharavi\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Haley\",\"lastName\":\"Bennett\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elyas\",\"lastName\":\"M'Barek\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Timothy\",\"lastName\":\"Spall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jennifer\",\"lastName\":\"Saunders\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lily\",\"lastName\":\"Allen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jack\",\"lastName\":\"Whitehall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elizabeth\",\"lastName\":\"Edmonds\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sally\",\"lastName\":\"Phillips\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Camilla\",\"lastName\":\"Borgezani\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Misia\",\"lastName\":\"Butler\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Virginia Woolf's Night & Day\",\"synopsis\":\"Based on Virginia Woolf’s funniest novel, Night & Day is an un-romantic comedy about the passionate astronomer, Katharine Hilbery who does everything she can to avoid romantic love and marriage. Her bold challenge to Edwardian patriarchy is set against the suffragette movement and advances in science and technology. Fun and contemporary in tone, this refreshing film showcases a star-studded ensemble of humorous performances.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/b1/d4/b1d4f5b2a723c97dae39aa04f810ba2c.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/364297_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/364297_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-06-19T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"40288\",\"name\":\"Vue Entertainment\",\"__typename\":\"Company\"}],\"localRatings\":[],\"rating\":{\"advisory\":\"discrimination, upsetting scenes\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/f161a0718b8a0719291400041ce98e75.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/0bfbdac0e38464edeea1ec31daeb5e68.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Night & Day\",\"synopsis\":\"Based on Virginia Woolf’s funniest novel, Night & Day is an un-romantic comedy about the passionate astronomer, Katharine Hilbery who does everything she can to avoid romantic love and marriage. Her bold challenge to Edwardian patriarchy is set against the suffragette movement and advances in science and technology. Fun and contemporary in tone, this refreshing film showcases a star-studded ensemble of humorous performances.\",\"certificate\":\"12A\",\"casting\":[\"Haley Bennett\",\"Elyas M'Barek\",\"Timothy Spall\",\"Jennifer Saunders\",\"Lily Allen\",\"Jack Whitehall\",\"Elizabeth Edmonds\",\"Sally Phillips\",\"Camilla Borgezani\",\"Misia Butler\"],\"direction\":[\"Tina Gharavi\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/0bfbdac0e38464edeea1ec31daeb5e68.jpg\",\"https://all.web.img.acsta.net/img/4d/6e/4d6ef12e0dff8138d659cafaf26592b9.jpg\",\"https://all.web.img.acsta.net/img/eb/94/eb94380fd0df0d037f19e6e3f601d305.jpg\",\"https://all.web.img.acsta.net/img/23/e2/23e2dfea2a260b054cd36f9aa6077fb8.jpg\",\"https://all.web.img.acsta.net/img/89/3b/893b258476ac3ca6bb27ea1387bbd99a.jpg\",\"https://all.web.img.acsta.net/img/dc/54/dc544f2eb893c7295520f095b73fc519.jpg\",\"https://all.web.img.acsta.net/img/23/a6/23a62b176756eeeb3807c18b2264daa6.jpg\",\"https://all.web.img.acsta.net/img/02/9d/029da4de63cb5ab77e6e028788972e7a.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/0bfbdac0e38464edeea1ec31daeb5e68.jpg\"],\"release\":\"2026-06-19T00:00:00.000Z\",\"advisory\":\"discrimination, upsetting scenes\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/364297_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/364297_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Vue Entertainment\"},\"orderIndex\":12},{\"id\":\"1000046374\",\"title\":\"WHAM! 10 Days In China\",\"runtime\":5400,\"genres\":\"Music, Documentary, Concert\",\"__typename\":\"Movie\",\"altId\":[\"418692\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/118f1a7a8e0f1820cdf6b1a76b104c9d.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/a4/14/a414d4027c53ce556d0c2c6da19e0f8b.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/d4/5b/d45b92ebcaada2e5f2309081e4465cf3.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/79/fb/79fbd11423d8d79ca6e8d275be79fe24.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/da/0a/da0a32b927e80f6054e2aa6e9c6d6125.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/5e/7d/5e7d9f2508e6b8762a1ef1da387fcc20.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Mike\",\"lastName\":\"Christie﻿\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"George\",\"lastName\":\"Michael\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Andrew\",\"lastName\":\"Ridgeley\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"WHAM! 10 Days In China\",\"synopsis\":\"In 1985, WHAM! made history as the first Western pop act to perform in communist China. George Michael and Andrew Ridgeley’s concerts in Beijing and Guangzhou were a cultural milestone – East meets West, music meets politics. Now, newly restored footage reveals the untold story of the iconic tour that helped launch WHAM! to global superstardom.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/ab/06/ab0684a38b28962777fae4cc605fbc8c.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/a4eaf3831958677ec9795f2158ef5128.jpg\",\"__typename\":\"BOAppImage\"}]}},\"releases\":[{\"releasedAt\":\"2026-07-28T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/118f1a7a8e0f1820cdf6b1a76b104c9d.jpg\",\"synopsis\":\"A new documentary following George Michael and Andrew Ridgeley in 1985 as they become the first Western band to perform in communist China ahead of their break into global superstardom. George Michael and Andrew Ridgeley's concerts in Beijing and Guangzhou introduced live Western pop to Chinese audiences and marked a turning point for the band. For WHAM!, the tour was more than music; it was a bold move to capture American attention and launch them into global superstardom. Now, newly remastered, this film shows China on the cusp of change, told through the band's journey and the voices of fans experiencing pop culture for the first time. This is the untold story of WHAM! at a singular moment in history, East meets West, pop meets politics, and two young stars coming of age on the world stage.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"WHAM! 10 Days In China\",\"synopsis\":\"A new documentary following George Michael and Andrew Ridgeley in 1985 as they become the first Western band to perform in communist China ahead of their break into global superstardom. George Michael and Andrew Ridgeley's concerts in Beijing and Guangzhou introduced live Western pop to Chinese audiences and marked a turning point for the band. For WHAM!, the tour was more than music; it was a bold move to capture American attention and launch them into global superstardom. Now, newly remastered, this film shows China on the cusp of change, told through the band's journey and the voices of fans experiencing pop culture for the first time. This is the untold story of WHAM! at a singular moment in history, East meets West, pop meets politics, and two young stars coming of age on the world stage.\",\"certificate\":null,\"casting\":[\"George Michael\",\"Andrew Ridgeley\"],\"direction\":[\"Mike Christie\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/a4/14/a414d4027c53ce556d0c2c6da19e0f8b.jpg\",\"https://all.web.img.acsta.net/img/d4/5b/d45b92ebcaada2e5f2309081e4465cf3.jpg\",\"https://all.web.img.acsta.net/img/79/fb/79fbd11423d8d79ca6e8d275be79fe24.jpg\",\"https://all.web.img.acsta.net/img/da/0a/da0a32b927e80f6054e2aa6e9c6d6125.jpg\",\"https://all.web.img.acsta.net/img/5e/7d/5e7d9f2508e6b8762a1ef1da387fcc20.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/a4eaf3831958677ec9795f2158ef5128.jpg\"],\"release\":\"2026-07-28T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"},\"orderIndex\":33},{\"id\":\"1000018715\",\"title\":\"Werwulf\",\"runtime\":null,\"genres\":\"Horror, Historical\",\"__typename\":\"Movie\",\"altId\":[\"385177\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/eb86ca5dc222b2a6a3d5b12400668fce.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{