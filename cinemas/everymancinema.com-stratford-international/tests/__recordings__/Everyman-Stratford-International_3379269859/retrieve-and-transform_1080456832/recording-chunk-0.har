_typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joseph\",\"lastName\":\"Gordon-Levitt\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anne\",\"lastName\":\"Hathaway\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marion\",\"lastName\":\"Cotillard\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Morgan\",\"lastName\":\"Freeman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Caine\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Matthew\",\"lastName\":\"Modine\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Josh\",\"lastName\":\"Stewart\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"The Dark Knight Rises\",\"synopsis\":\"After eight years of struggling with his new status as a wanted vigilante, Batman must contend with newcomers Catwoman and the brutal and villainous Bane.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/a5/ab/a5ab8623b576dc5c2cf545e245767f87.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/117274_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2024-09-20T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"Contains moderate violence\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}},{\"releasedAt\":\"2012-07-20T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"Contains moderate violence\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":\"Nolan in 35mm: The Dark Knight Rises\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2cb7d14c9a2bdd93f3249ffe58248956.jpg\",\"synopsis\":\"Following the death of District Attorney Harvey Dent, Batman assumes responsibility for Dent's crimes to protect the politcian's reputation but is subsequently hunted by the Gotham City Police Department. \\n\\nEight years after the events of The Dark Knight, Batman returns to Gotham, where he encounters the mysterious Selina Kyle and the villainous Bane, and must confront the latter's plans to destroy the city. But the city he strives to protect has branded him an enemy.\\n\\nScreening in 35mm as part of Nolan Season at Everyman Screen on the Green.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/a79e3e6f60edce019138d550d509cbb5.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Dark Knight Rises\",\"synopsis\":\"Following the death of District Attorney Harvey Dent, Batman assumes responsibility for Dent's crimes to protect the politcian's reputation but is subsequently hunted by the Gotham City Police Department. \\n\\nEight years after the events of The Dark Knight, Batman returns to Gotham, where he encounters the mysterious Selina Kyle and the villainous Bane, and must confront the latter's plans to destroy the city. But the city he strives to protect has branded him an enemy.\\n\\nScreening in 35mm as part of Nolan Season at Everyman Screen on the Green.\",\"certificate\":\"12A\",\"casting\":[\"Christian Bale\",\"Gary Oldman\",\"Tom Hardy\",\"Joseph Gordon-Levitt\",\"Anne Hathaway\",\"Marion Cotillard\",\"Morgan Freeman\",\"Michael Caine\",\"Matthew Modine\",\"Josh Stewart\"],\"direction\":[\"Christopher Nolan\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/a79e3e6f60edce019138d550d509cbb5.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/84/48/34/20090662.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/84/48/34/20090661.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/84/48/34/20090660.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/84/48/34/20090649.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/84/48/34/20082866.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/84/48/34/20082865.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/84/48/34/20082862.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/84/48/34/19955479.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/84/48/34/19955478.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/35/25/19983798.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/a79e3e6f60edce019138d550d509cbb5.jpg\"],\"release\":\"2012-07-20T00:00:00.000Z\",\"advisory\":\"Contains moderate violence\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/117274_uk_high.mp4\",\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"},\"orderIndex\":76},{\"id\":\"108998\",\"title\":\"Nolan in 35mm: The Prestige\",\"runtime\":7680,\"genres\":\"Thriller, Drama\",\"__typename\":\"Movie\",\"altId\":[\"51676\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/249a99c183e82c63727884e6614bbed0.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.ac