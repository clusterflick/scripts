it\",\"actor\":{\"firstName\":\"Hunter\",\"lastName\":\"Doohan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Luciane\",\"lastName\":\"Buchanan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tandi\",\"lastName\":\"Wright\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maude\",\"lastName\":\"Davey\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Erroll\",\"lastName\":\"Shand\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Keanu\",\"lastName\":\"Karim\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tapiwa\",\"lastName\":\"Soropa\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"George\",\"lastName\":\"Pullar\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Greta\",\"lastName\":\"van den Brink\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Evil Dead Burn\",\"synopsis\":\"EVIL DEAD BURN unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. After the loss of her husband, a woman seeks solace with her in-laws in their secluded family home. As one by one they are transformed into Deadites—turning the gathering into a family reunion from hell—she comes to discover that the vows she took in life live on... even in death.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/ce/ac/ceac9c23663c964ddbeb832560c5887c.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/362446_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/362446_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/28571c5f3492e1811e3d36eabf26d2b3.jpg\",\"__typename\":\"BOAppImage\"}]}},\"releases\":[{\"releasedAt\":\"2026-07-09T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"32481\",\"name\":\"Studio Canal\",\"__typename\":\"Company\"}],\"localRatings\":[],\"rating\":{\"advisory\":\"strong bloody violence, gore\",\"__typename\":\"Rating\",\"certificate\":\"18\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/6edd02afebe7f9f8cb06871479d74e96.jpg\",\"synopsis\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. After the loss of her husband, a woman seeks solace with her in-laws in their secluded family home. As one by one they are transformed into Deadites—turning the gathering into a family reunion from hell—she comes to discover that the vows she took in life live on... even in death.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/8a41bae87eec94e4bd5185b425eb9a0b.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Evil Dead Burn\",\"synopsis\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. After the loss of her husband, a woman seeks solace with her in-laws in their secluded family home. As one by one they are transformed into Deadites—turning the gathering into a family reunion from hell—she comes to discover that the vows she took in life live on... even in death.\",\"certificate\":\"18\",\"casting\":[\"Souheila Yacoub\",\"Hunter Doohan\",\"Luciane Buchanan\",\"Tandi Wright\",\"Maude Davey\",\"Erroll Shand\",\"Keanu Karim\",\"Tapiwa Soropa\",\"George Pullar\",\"Greta van den Brink\"],\"direction\":[\"Sébastien Vaniček\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/8a41bae87eec94e4bd5185b425eb9a0b.jpg\",\"https://all.web.img.acsta.net/img/03/47/03472a8546b0577555bc3f16b830f9b0.jpg\",\"https://all.web.img.acsta.net/img/98/c3/98c3de10ed86c7d36de1ca7c2fd32dd0.jpg\",\"https://all.web.img.acsta.net/img/a7/14/a71465d399d70da190f82626cd385c42.jpg\",\"https://all.web.img.acsta.net/img/f4/02/f4020d832679cd6e0a5c4ff1076c2122.jpg\",\"https://all.web.img.acsta.net/img/ee/e5/eee50f13cab01bcee03f0115c52dbc78.jpg\",\"https://all.web.img.acsta.net/img/9a/27/9a2731c88d5d47d12b60394d07035403.jpg\",\"https://all.web.img.acsta.net/img/b4/3e/b43e8d2d546163b1aeb50b718d5765bf.jpg\",\"https://all.web.img.acsta.net/img/4c/f8/4cf8de17c3e4220881261d2ac1cbfee0.jpg\",\"https://all.web.img.acsta.net/img/08/4b/084b7a36128e9829ab53f138172e4524.jpg\",\"https://all.web.img.acsta.net/img/43/21/43211e28dbe8639d95b2389391a4fbdf.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/8a41bae87eec94e4bd5185b425eb9a0b.jpg\",\"https://cms-assets.webediamovies.pro/production/2/28571c5f3492e1811e3d36eabf26d2b3.jpg\"],\"release\":\"2026-07-09T00:00:00.000Z\",\"advisory\":\"strong bloody violence, gore\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/362446_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/362446_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Studio Canal\"},\"orderIndex\":1},{\"id\":\"1000048320\",\"title\":\"Family Film Club: Pokémon Detective Pikachu\",\"runtime\":6300,\"genres\":\"Adventure, Action\",\"poster\":\"https://all.web.img.acsta.net/img/17/2a/172a490feef3147f666f83483e5b01c9.webp\",\"__typename\":\"Movie\",\"altId\":[\"421037\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Rob\",\"lastName\":\"Letterman\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ryan\",\"lastName\":\"Reynolds\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Justice\",\"lastName\":\"Smith\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kathryn\",\"lastName\":\"Newton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bill\",\"lastName\":\"Nighy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ken\",\"lastName\":\"Watanabe\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Chris\",\"lastName\":\"Geere\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Family Film Club: Pokémon Detective Pikachu\",\"synopsis\":\"The story begins when ace detective Harry Goodman goes mysteriously missing, prompting his 21-year-old son Tim to find out what happened. Aiding in the investigation is Harry's former Pokémon partner, Detective Pikachu: a hilariously wise-cracking, adorable super-sleuth who is a puzzlement even to himself. Finding that they are uniquely equipped to communicate with one another, Tim and Pikachu join forces on a thrilling adventure to unravel the tangled mystery. Chasing clues together through the neon-lit streets of Ryme City - a sprawling, modern metropolis where humans and Pokémon live side by side in a hyper-realistic live-action world - they encounter a diverse cast of Pokémon characters and uncover a shocking plot that could destroy this peaceful co-existence and threaten the whole Pokémon universe.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/17/2a/172a490feef3147f666f83483e5b01c9.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-07-24T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild fantasy threat\",\"__typename\":\"Rating\",\"certificate\":\"PG\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Family Film Club: Pokémon Detective Pikachu\",\"synopsis\":\"The story begins when ace detective Harry Goodman goes mysteriously missing, prompting his 21-year-old son Tim to find out what happened. Aiding in the investigation is Harry's former Pokémon partner, Detective Pikachu: a hilariously wise-cracking, adorable super-sleuth who is a puzzlement even to himself. Finding that they are uniquely equipped to communicate with one another, Tim and Pikachu join forces on a thrilling adventure to unravel the tangled mystery. Chasing clues together through the neon-lit streets of Ryme City - a sprawling, modern metropolis where humans and Pokémon live side by side in a hyper-realistic live-action world - they encounter a diverse cast of Pokémon characters and uncover a shocking plot that could destroy this peaceful co-existence and threaten the whole Pokémon universe.\",\"certificate\":\"PG\",\"casting\":[\"Ryan Reynolds\",\"Justice Smith\",\"Kathryn Newton\",\"Bill Nighy\",\"Ken Watanabe\",\"Chris Geere\"],\"direction\":[\"Rob Letterman\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-07-24T00:00:00.000Z\",\"advisory\":\"mild fantasy threat\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"},\"orderIndex\":62},{\"id\":\"1000048860\",\"title\":\"Family Film Club: Shrek 2\",\"runtime\":5400,\"genres\":\"Animation, Comedy, Family, Adventure\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/be0c7a9baab67134198d024a3e2ebb6a.jpg\",\"__typename\":\"Movie\",\"altId\":[\"421691\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Andrew\",\"lastName\":\"Adamson\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Family Film Club: Shrek 2\",\"synopsis\":\"After battling a fire-breathing dragon and the evil Lord Farquaad to win the hand of Princess Fiona, Shrek now faces his greatest challenge: the in-laws. Shrek and Princess Fiona return from their honeymoon to find an invitation to visit Fiona's parents, the King and Queen of the Kingdom of Far, Far Away. With Donkey along for the ride, the newlyweds set off. All of the citizens of Far, Far Away turn out to greet their returning Princess, and her parents happily anticipate the homecoming of their daughter and her new Prince. But no one could have prepared them for the sight of their new son-in-law, not to mention how much their little girl had changed. Little did Shrek and Fiona know that their marriage had foiled all of her father's plans for her future--and his own. Now the King must enlist the help of a powerful Fairy Godmother, the handsome Prince Charming and that famed ogre killer 'Puss In Boots' to put right his version of \\\"happily ever after.\\\"\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/d2/5b/d25bbe7960a55ed5698d85db6d8eee2a.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-07-31T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"localRatings\":[],\"rating\":{\"advisory\":\"mild bad language\",\"__typename\":\"Rating\",\"certificate\":\"PG\"}}],\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Mike\",\"lastName\":\"Myers\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Eddie\",\"lastName\":\"Murphy\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Cameron\",\"lastName\":\"Diaz\",\"__typename\":\"Person\"}}]},\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/be0c7a9baab67134198d024a3e2ebb6a.jpg\",\"synopsis\":\"Join us at Family Film Club, where we screen much-loved family favourites for ages 5+. Catch a movie off-peak and enjoy half-price kids' tickets. The perfect way to enjoy a cinema outing together as a family.\\n\\nThis week, grab your popcorn and save a sofa for Shrek 2 -  after returning from their honeymoon, Shrek and Fiona receive an invitation from Fiona’s royal parents, King Harold and Queen Lillian, who reside in the kingdom of Far Far Away. Believing Fiona has married Prince Charming, they are shocked by her ogre transformation and her new husband, kicking off a magical adventure.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Family Film Club: Shrek 2\",\"synopsis\":\"Join us at Family Film Club, where we screen much-loved family favourites for ages 5+. Catch a movie off-peak and enjoy half-price kids' tickets. The perfect way to enjoy a cinema outing together as a family.\\n\\nThis week, grab your popcorn and save a sofa for Shrek 2 -  after returning from their honeymoon, Shrek and Fiona receive an invitation from Fiona’s royal parents, King Harold and Queen Lillian, who reside in the kingdom of Far Far Away. Believing Fiona has married Prince Charming, they are shocked by her ogre transformation and her new husband, kicking off a magical adventure.\",\"certificate\":\"PG\",\"casting\":[\"Mike Myers\",\"Eddie Murphy\",\"Cameron Diaz\"],\"direction\":[\"Andrew Adamson\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-07-31T00:00:00.000Z\",\"advisory\":\"mild bad language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{},\"orderIndex\":63},{\"id\":\"1000040254\",\"title\":\"Family Film Club: The Goonies\",\"runtime\":6840,\"genres\":\"Adventure, Comedy, Family, Fantasy\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/58865a697a24714cb7b5dd8fc98792b4.jpg\",\"__typename\":\"Movie\",\"altId\":[\"411704\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Richard\",\"lastName\":\"Donner\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sean\",\"lastName\":\"Astin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Josh\",\"lastName\":\"Brolin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Corey\",\"lastName\":\"Feldman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Family Film Club: The Goonies\",\"synopsis\":\"A band of young boys find a treasure map and embark on a magical adventure.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/43/1c/431c838aae33f542c605d9d8a5bda150.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-07-17T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"localRatings\":[],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/58865a697a24714cb7b5dd8fc98792b4.jpg\",\"synopsis\":\"Join us at Family Film Club, where we screen much-loved family favourites for ages 5+. Catch a movie off-peak and enjoy half-price kids' tickets. The perfect way to enjoy a cinema outing together as a family.\\n\\nThis week, grab your popcorn and save a sofa for The Goonies - a tight-knit group of misfit kids from Astoria, Oregon, who try to save their homes from foreclosure by a greedy land developer. While searching for a way to raise money, they uncover an old pirate map that leads them on a quest to find the long-lost, legendary treasure of \\\"One-Eyed Willy\\\".\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Family Film Club: The Goonies\",\"synopsis\":\"Join us at Family Film Club, where we screen much-loved family favourites for ages 5+. Catch a movie off-peak and enjoy half-price kids' tickets. The perfect way to enjoy a cinema outing together as a family.\\n\\nThis week, grab your popcorn and save a sofa for The Goonies - a tight-knit group of misfit kids from Astoria, Oregon, who try to save their homes from foreclosure by a greedy land developer. While searching for a way to raise money, they uncover an old pirate map that leads them on a quest to find the long-lost, legendary treasure of \\\"One-Eyed Willy\\\".\",\"certificate\":\"12A\",\"casting\":[\"Sean Astin\",\"Josh Brolin\",\"Corey Feldman\"],\"direction\":[\"Richard Donner\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-07-17T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{},\"orderIndex\":61},{\"id\":\"1000009972\",\"title\":\"Finding Emily\",\"runtime\":6660,\"genres\":\"Comedy, Romance\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/43bd23a3abc3bb050e1a39a2d6c5ffa6.jpg\",\"__typename\":\"Movie\",\"altId\":[\"373290\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/b5/cb/b5cb2d22f927630b4f8f438b5db5ea9a.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c4/16/c4164b49ee5a322ead9ccd495d253642.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/dc/7d/dc7dc4dd64473e0dda3b6236f8ce7c52.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c5/1a/c51a35e97d3a1cb169f0219a52cd236a.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/7c/2a/7c2a291482e451012ba7278749ddf1c2.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/90/dc/90dc82373f1ecc4353d246a3853d3c5e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ab/b6/abb67f917f8deba168a8a971b70c8ebd.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"pers