"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Eve\",\"lastName\":\"Hewson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Colman\",\"lastName\":\"Domingo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Wyatt\",\"lastName\":\"Russell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Henry\",\"lastName\":\"Lloyd-Hughes\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jim\",\"lastName\":\"Parrack\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tommy\",\"lastName\":\"Martinez\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jeremy\",\"lastName\":\"Shamos\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Disclosure Day\",\"synopsis\":\"If you found out we weren't alone, if someone showed you, proved it to you, would that frighten you?\\n\\nThis summer, the truth belongs to seven billion people.\\n\\nWe are coming close to... Disclosure Day.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/da/92/da92b9a3593e3b7717e9f21478739a4f.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/361251_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/361251_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/66ff3e18396677c8fc6e7aae78b34766.jpg\",\"__typename\":\"BOAppImage\"}]}},\"releases\":[{\"releasedAt\":\"2026-06-10T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"26962\",\"name\":\"Universal Pictures International\",\"__typename\":\"Company\"}],\"localRatings\":[],\"rating\":{\"advisory\":\"moderate threat, violence, injury detail, infrequent strong language\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/1cba8fc58d18da5b40fedee235ed938d.jpg\",\"synopsis\":\"If you found out we weren't alone, if someone showed you, proved it to you, would that frighten you? This summer, the truth belongs to eight billion people. \\n\\nWe are coming close to... Disclosure Day.\\n\\nUniversal Pictures is proud to release a new original event film created and directed by Steven Spielberg, Disclosure Day. An upcoming sci-fi film directed by Steven Spielberg from a screenplay by David Koepp.\\n\\nThe film stars SAG winner and Oscar® nominee Emily Blunt (Oppenheimer, A Quiet Place), Emmy and Golden Globe winner Josh O’Connor (Challengers, The Crown), Oscar® winner Colin Firth (The King’s Speech, Kingsman franchise), Eve Hewson (Bad Sisters, The Perfect Couple) and two-time Oscar® nominee Colman Domingo (Sing Sing, Rustin).\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/018f93d64791bbcae76d9f5bedf55f01.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Disclosure Day\",\"synopsis\":\"If you found out we weren't alone, if someone showed you, proved it to you, would that frighten you? This summer, the truth belongs to eight billion people. \\n\\nWe are coming close to... Disclosure Day.\\n\\nUniversal Pictures is proud to release a new original event film created and directed by Steven Spielberg, Disclosure Day. An upcoming sci-fi film directed by Steven Spielberg from a screenplay by David Koepp.\\n\\nThe film stars SAG winner and Oscar® nominee Emily Blunt (Oppenheimer, A Quiet Place), Emmy and Golden Globe winner Josh O’Connor (Challengers, The Crown), Oscar® winner Colin Firth (The King’s Speech, Kingsman franchise), Eve Hewson (Bad Sisters, The Perfect Couple) and two-time Oscar® nominee Colman Domingo (Sing Sing, Rustin).\",\"certificate\":\"12A\",\"casting\":[\"Emily Blunt\",\"Josh O'Connor\",\"Colin Firth\",\"Eve Hewson\",\"Colman Domingo\",\"Wyatt Russell\",\"Henry Lloyd-Hughes\",\"Jim Parrack\",\"Tommy Martinez\",\"Jeremy Shamos\"],\"direction\":[\"Steven Spielberg\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/018f93d64791bbcae76d9f5bedf55f01.jpg\",\"https://all.web.img.acsta.net/img/ba/fc/bafc41e8f31fdc8fe419d04ea84b6798.jpg\",\"https://all.web.img.acsta.net/img/59/78/5978aba01ea72d8afa8b50ee2f56a473.jpg\",\"https://all.web.img.acsta.net/img/84/a6/84a615497a63ae24ba2603836f4e5df2.jpg\",\"https://all.web.img.acsta.net/img/a5/b6/a5b6af4ffa39ca0c9680f085361e55e2.jpg\",\"https://all.web.img.acsta.net/img/5c/64/5c64a5aefb1de2568661bcb19bf47173.jpg\",\"https://all.web.img.acsta.net/img/8b/26/8b26c9bd94d36a37685e294e5825b608.jpg\",\"https://all.web.img.acsta.net/img/80/df/80dff20d14265673ffc2a6cf5b332c0a.jpg\",\"https://all.web.img.acsta.net/img/0b/67/0b6725c6da1c939a1f7ab69e13cbf325.jpg\",\"https://all.web.img.acsta.net/img/eb/34/eb34cf0ac6cd6e8a69b1fdc9da0a897c.jpg\",\"https://all.web.img.acsta.net/img/d9/8a/d98a475e31a5f1bb52628bcb80e806e7.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/018f93d64791bbcae76d9f5bedf55f01.jpg\",\"https://cms-assets.webediamovies.pro/production/2/66ff3e18396677c8fc6e7aae78b34766.jpg\"],\"release\":\"2026-06-10T00:00:00.000Z\",\"advisory\":\"moderate threa