:\"Ledger\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Aaron\",\"lastName\":\"Eckhart\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maggie\",\"lastName\":\"Gyllenhaal\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Caine\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gary\",\"lastName\":\"Oldman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Morgan\",\"lastName\":\"Freeman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Monique Gabriela\",\"lastName\":\"Curnen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Eric\",\"lastName\":\"Roberts\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cillian\",\"lastName\":\"Murphy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"The Dark Knight\",\"synopsis\":\"With the help of Lieutenant Jim Gordon and District Attorney Harvey Dent, Batman sets out to destroy organized crime in Gotham for good. The triumvirate proves to be effective, but they soon find themselves prey to a rising criminal mastermind known as the Joker, who thrusts Gotham into anarchy and forces the Dark Knight ever closer to crossing the fine line between hero and vigilante.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/2b/bb/2bbbaba06a68b78e4d9dc83773f77276.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2023-09-15T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"},{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"Contains moderate violence and sustained threat\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}},{\"releasedAt\":\"2024-09-20T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"Contains strong fantasy violence and sustained threat\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":\"Nolan in 35mm: The Dark Knight\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/6fdbb1a8a8e83da84f17def1f7028bdf.jpg\",\"synopsis\":\"With the help of Lieutenant Jim Gordon and District Attorney Harvey Dent, Batman sets out to destroy organized crime in Gotham for good. The triumvirate proves to be effective, but they soon find themselves prey to a rising criminal mastermind known as the Joker, who thrusts Gotham into anarchy and forces the Dark Knight ever closer to crossing the fine line between hero and vigilante.\\n\\nScreening in 35mm as part of Nolan Season at Everyman Screen on the Green.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/390d99cf6f22f79c167e996cab38a86d.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Dark Knight\",\"synopsis\":\"With the help of Lieutenant Jim Gordon and District Attorney Harvey Dent, Batm