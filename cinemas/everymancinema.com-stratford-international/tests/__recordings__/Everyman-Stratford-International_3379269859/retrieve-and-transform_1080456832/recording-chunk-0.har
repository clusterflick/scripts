          ],
          "redirectURL": "",
          "content": {
            "mimeType": "application/json",
            "text": "{\"data\":{\"allEvent\":{\"nodes\":[{\"title\":\"It's Not You, It's Us\",\"id\":\"RXh0ZXJuYWxFdmVudDo3NTQ4MQ==\",\"description\":\"<p>Head's up! There's currently <strong>no step-free access</strong> at<strong> Everyman Cheltenham</strong> due to a broken lift. We hope to be up and running again soon.</p>\",\"theaters\":[{\"id\":\"G01VU\"}]},{\"title\":\"Reduced Parking | Bowland Beer Festival\",\"id\":\"RXh0ZXJuYWxFdmVudDo3NTQ2OQ==\",\"description\":\"<p>Heads up! Due to the Bowland Beer Festival, there will be reduced parking available throughout July. We apologise for any inconvenience caused.</p>\",\"theaters\":[{\"id\":\"X11NR\"}]},{\"title\":\"It's Not You, It's Us\",\"id\":\"RXh0ZXJuYWxFdmVudDo3NDc5OA==\",\"description\":\"<p>Head's up! We currently have a limited menu at Everyman Maida Vale. <strong>Burgers</strong>, <strong>Hot dogs</strong>, <strong>popcorn</strong>, <strong>cakes, and </strong><strong>sweet </strong>&amp; <strong>savoury pots</strong> are still available. We're sorry for the inconvenience caused.</p>\",\"theaters\":[{\"id\":\"X0LWI\"}]},{\"title\":\"It's Not You, It's Us!\",\"id\":\"RXh0ZXJuYWxFdmVudDo3NDc1Mg==\",\"description\":\"<p>Head's up! There's currently<strong> no step-free access</strong> into <strong>Screens 1, 2 and 5</strong> at <strong>Everyman Edinburgh </strong>due to a broken lift. We hope to be up and running again soon.</p>\",\"theaters\":[{\"id\":\"G018L\"}]},{\"title\":\"It's Not You, It's Us\",\"id\":\"RXh0ZXJuYWxFdmVudDo3NDU5OQ==\",\"description\":\"<p>Heads up! Due to extreme weather conditions, Screen 2 at Everyman Gerrards Cross is experiencing slightly warmer-than-usual temperatures. If you require any assistance on your visit, please do not hesitate to let a member of staff know.&nbsp;</p>\",\"theaters\":[{\"id\":\"X06SK\"}]},{\"title\":\"Up to 3 Hours Free Parking at Royal William Yard\",\"id\":\"RXh0ZXJuYWxFdmVudDo0MTAyMA==\",\"description\":\"<p>Head's up! Guests watching a film at Everyman Plymouth can claim 3 hours of free parking at the RWY car park. Once you've parked, head straight up to the venue and ask the team how to register your vehicle (no need to buy a parking ticket!)</p>\",\"theaters\":[{\"id\":\"G01RJ\"}]},{\"title\":\"It's Not You, It's Us\",\"id\":\"RXh0ZXJuYWxFdmVudDo3NTUyNw==\",\"description\":\"<p>Due to extreme weather conditions, <strong>Everyman Birmingham</strong> is experiencing <strong>temperatures slightly warmer than usual</strong>. If you require any assistance on your visit, please do not hesitate to let a member of staff know.&nbsp;</p>\",\"theaters\":[{\"id\":\"X0VHE\"}]}]}}}",
            "size": 920
