ttps://all.web.img.acsta.net/pictures/14/10/22/16/23/164817.jpg\",\"https://all.web.img.acsta.net/pictures/14/10/22/16/23/168401.jpg\",\"https://all.web.img.acsta.net/pictures/14/10/22/16/23/171643.jpg\",\"https://all.web.img.acsta.net/pictures/14/10/24/08/38/272869.jpg\",\"https://all.web.img.acsta.net/pictures/14/11/20/16/48/062122.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/5ead695822520fcf8fd672f19a00da51.jpg\"],\"release\":\"2014-11-07T00:00:00.000Z\",\"advisory\":\"infrequent strong language, moderate threat, violence\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/159557_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/159557_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"},\"orderIndex\":11},{\"id\":\"1000000443\",\"title\":\"Jaws: Presented by The Shark Trust\",\"runtime\":null,\"genres\":\"Thriller, Horror\",\"poster\":\"https://fr.web.img6.acsta.net/f_jpg/r_600_10000/pictures/14/03/17/10/11/319611.jpg\",\"__typename\":\"Movie\",\"altId\":[\"359659\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Steven\",\"lastName\":\"Spielberg\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Roy\",\"lastName\":\"Scheider\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Shaw\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Richard\",\"lastName\":\"Dreyfuss\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lorraine\",\"lastName\":\"Gary\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Murray\",\"lastName\":\"Hamilton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Jaws: Presented by The Shark Trust\",\"synopsis\":\"A giant great white shark arrives on the shores of a New England beach resort and wreaks havoc with bloody attacks on swimmers until a part-time sheriff teams up with a marine biologist and an old seafarer to hunt the monster down.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2024-07-19T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"moderate injury detail, threat\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://fr.web.img6.acsta.net/f_jpg/r_600_10000/pictures/14/03/17/10/11/319611.jpg\",\"synopsis\":\"Join us at Everyman Plymouth on Sunday, 12 July, for a special screening of Jaws presented by The Shark Trust, followed by a live Q&A session with members of The Shark Trust.\\n\\nWhen a killer shark unleashes chaos on a beach community off Cape Cod, it's up to a local sheriff, a marine biologist, and an old seafarer to hunt the beast down.\\n\\nShark Week is a renowned cultural phenomenon – but Plymouth is going bigger and better this summer by welcoming Shark Month to Royal William Yard in July. The month-long celebration is a partnership with the Shark Trust, a leading international conservation charity, based in Britain’s Ocean City.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/3ca4799337a77206b685d7e0a7d3a53f.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Jaws: Presented by The Shark Trust\",\"synopsis\":\"Join us at Everyman Plymouth on Sunday, 12 July, for a special screening of Jaws presented by The Shark Trust, followed by a live Q&A session with members of The Shark Trust.\\n\\nWhen a killer shark unleashes chaos on a beach community off Cape Cod, it's up to a local sheriff, a marine biologist, and an old seafarer to hunt the beast down.\\n\\nShark Week is a renowned cultural phenomenon – but Plymouth is going bigger and better this summer by welcoming Shark Month to Royal William Yard in July. The month-long celebration is a partnership with the Shark Trust, a leading international conservation charity, based in Britain’s Ocean City.\",\"certificate\":\"12A\",\"casting\":[\"Roy Scheider\",\"Robert Shaw\",\"Richard Dreyfuss\",\"Lorraine Gary\",\"Murray Hamilton\"],\"direction\":[\"Steven Spielberg\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/3ca4799337a77206b685d7e0a7d3a53f.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/3ca4799337a77206b685d7e0a7d3a53f.jpg\"],\"release\":\"2024-07-19T00:00:00.000Z\",\"advisory\":\"moderate injury detail, threat\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Universal International Pictures\"},\"orderIndex\":24},{\"id\":\"315883\",\"title\":\"Klara and the Sun\",\"runtime\":6960,\"genres\":\"Science fiction, Drama, Comedy\",\"__typename\":\"Movie\",\"altId\":[\"372609\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/79e16f26f29bf47ba604d39e9a489c8c.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Taika\",\"lastName\":\"Waititi\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jenna\",\"lastName\":\"Ortega\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mia\",\"lastName\":\"Tharia\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Amy\",\"lastName\":\"Adams\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Aran\",\"lastName\":\"Murphy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Steve\",\"lastName\":\"Buscemi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Natasha\",\"lastName\":\"Lyonne\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Simon\",\"lastName\":\"Baker\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Harry\",\"lastName\":\"Greenwood\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Davida\",\"lastName\":\"McKenzie\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Eden\",\"lastName\":\"Perkins\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Klara and the Sun\",\"synopsis\":\"Based on the bestselling novel from Nobel Prize-winner Kazuo Ishiguro and written and directed by Academy-Award® winner Taika Waititi (Jojo Rabbit), Klara and the Sun introduces audiences to Klara (Jenna Ortega), an Artificial Friend who wants nothing more than to find the perfect home. When Klara meets Josie (Mia Tharia), each immediately senses a kindred spirit in the other. Josie has a fraught relationship with her mother (Amy Adams) and they’ve suffered great loss, but Klara’s innocent wonder and unwavering loyalty begin to heal the family and bring light to Josie’s complicated world.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/52/01/520192056951c9b0f56c527b3196eb1a.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/372609_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/372609_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-10-23T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"distributors\":[{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}],\"localRatings\":[]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/79e16f26f29bf47ba604d39e9a489c8c.jpg\",\"synopsis\":\"Based on the bestselling novel from Nobel Prize-winner Kazuo Ishiguro and written and directed by Academy-Award® winner Taika Waititi (Jojo Rabbit), Klara and the Sun introduces audiences to Klara (Jenna Ortega), an Artificial Friend who wants nothing more than to find the perfect home. When Klara meets Josie (Mia Tharia), each immediately senses a kindred spirit in the other. Josie has a fraught relationship with her mother (Amy Adams), and they’ve suffered great loss, but Klara’s innocent wonder and unwavering loyalty begin to heal the family and bring light to Josie’s complicated world.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Klara and the Sun\",\"synopsis\":\"Based on the bestselling novel from Nobel Prize-winner Kazuo Ishiguro and written and directed by Academy-Award® winner Taika Waititi (Jojo Rabbit), Klara and the Sun introduces audiences to Klara (Jenna Ortega), an Artificial Friend who wants nothing more than to find the perfect home. When Klara meets Josie (Mia Tharia), each immediately senses a kindred spirit in the other. Josie has a fraught relationship with her mother (Amy Adams), and they’ve suffered great loss, but Klara’s innocent wonder and unwavering loyalty begin to heal the family and bring light to Josie’s complicated world.\",\"certificate\":null,\"casting\":[\"Jenna Ortega\",\"Mia Tharia\",\"Amy Adams\",\"Aran Murphy\",\"Steve Buscemi\",\"Natasha Lyonne\",\"Simon Baker\",\"Harry Greenwood\",\"Davida McKenzie\",\"Eden Perkins\"],\"direction\":[\"Taika Waititi\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-10-23T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/372609_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/372609_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures UK\"}},{\"id\":\"34193\",\"title\":\"Late Nights: Donnie Darko\",\"runtime\":6780,\"genres\":\"Drama, Science fiction\",\"__typename\":\"Movie\",\"altId\":[\"29515\",\"45257\",\"242776\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2cb9b73c0fc1f54b5d4f34875c0020ed.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/pictures/21/08/11/11/45/3185314.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/21/08/11/11/45/3168154.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/21/08/11/11/45/3058953.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.ac