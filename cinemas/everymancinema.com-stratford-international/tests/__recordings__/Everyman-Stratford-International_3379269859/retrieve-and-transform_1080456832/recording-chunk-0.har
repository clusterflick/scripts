l},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Noah\",\"lastName\":\"Wyle\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maggie\",\"lastName\":\"Gyllenhaal\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Daveigh\",\"lastName\":\"Chase\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Holmes\",\"lastName\":\"Osborne\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Donnie Darko\",\"synopsis\":\"Donnie is a troubled high school student: in therapy, prone to sleepwalking and in possession of an imaginary friend, a six-foot rabbit named Frank, who tells him the world is going to end in 28 days 06 hours 42 minutes and 12 seconds.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/2b/9e/2b9edc174a6793fbe092fd9d8ea9e8a2.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/29515_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/29515_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2016-12-16T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"39745\",\"name\":\"Arrow Films\",\"__typename\":\"Company\"}],\"localRatings\":[],\"rating\":{\"advisory\":\"strong language, horror\",\"__typename\":\"Rating\",\"certificate\":\"15\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":\"Late Nights: Donnie Darko\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2cb9b73c0fc1f54b5d4f34875c0020ed.jpg\",\"synopsis\":\"Step into the night at Everyman Broadgate with the return of Late Nights. This week, join us for an after-hours screening of Donnie Darko.\\n\\nDonnie is a troubled high school student: in therapy, prone to sleepwalking and in possession of an imaginary friend, a six-foot rabbit named Frank, who tells him the world is going to end in 28 days 06 hours, 42 minutes and 12 seconds.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/cc0a323e56016ef677c836cda7e45681.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Donnie Darko\",\"synopsis\":\"Step into the night at Everyman Broadgate with the return of Late Nights. This week, join us for an after-hours screening of Donnie Darko.\\n\\nDonnie is a troubled high school student: in therapy, prone to sleepwalking and in possession of an imaginary friend, a six-foot rabbit named Frank, who tells him the world is going to end in 28 days 06 hours, 42 minutes and 12 seconds.\",\"certificate\":\"15\",\"casting\":[\"Jake Gyllenhaal\",\"Jena Malone\",\"Drew Barrymore\",\"Mary McDonnell\",\"Katharine Ross\",\"Patrick Swayze\",\"Noah Wyle\",\"Maggie Gyllenhaal\",\"Daveigh Chase\",\"Holmes Osborne\"],\"direction\":[\"Richard Kelly\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/cc0a323e56016ef677c836cda7e45681.jpg\",\"https://all.web.img.acsta.net/pictures/21/08/11/11/45/3185314.jpg\",\"https://all.web.img.acsta.net/pictures/21/08/11/11/45/3168154.jpg\",\"https://all.web.img.acsta.net/pictures/21/08/11/11/45/3058953.jpg\",\"https://all.web.img.acsta.net/pictures/21/08/11/11/45/3019952.jpg\",\"https://all.web.img.acsta.net/pictures/21/08/11/11/45/3152554.jpg\",\"https://all.web.img.acsta.net/pictures/21/08/11/11/45/3119793.jpg\",\"https://all.web.img.acsta.net/pictures/21/08/11/11/45/3133834.jpg\",\"https://all.web.img.acsta.net/pictures/21/08/11/11/45/3101073.jpg\",\"https://all.web.img.acsta.net/pictures/21/08/11/11/45/3080793.jpg\",\"https://all.web.img.acsta.net/pictures/21/08/11/11/45/3038672.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/cc0a323e56016ef677c836cda7e45681.jpg\"],\"release\":\"2016-12-16T00:00:00.000Z\",\"advisory\":\"strong language, horror\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/29515_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/29515_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Arrow Films\"},\"orderIndex\":81},{\"id\":\"1000048748\",\"title\":\"Members’ Preview: Tony\",\"runtime\":null,\"genres\":\"Comedy, Biopic\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/94c57c49af1653831b44c1922d629301.jpg\",\"__typename\":\"Movie\",\"altId\":[\"421547\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Matt\",\"lastName\":\"Johnson (V)\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dominic\",\"lastName\":\"Sessa\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Antonio\",\"lastName\":\"Banderas\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emilia\",\"lastName\":\"Jones\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Leo\",\"lastName\":\"Woodall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Stavros\",\"lastName\":\"Halkias\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Jibrin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Members’ Preview: Tony\",\"synopsis\":\"A 19-year-old Anthony Bourdain travels to Provincetown and stumbles into the chaotic world of a restaurant kitchen, setting off a summer that will shape the course of his life.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/8f/dc/8fdcda7a9751272ba312a7685b1cd3c2.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-08-10T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"1000107175\",\"name\":\"A24\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/94c57c49af1653831b44c1922d629301.jpg\",\"synopsis\":\"Everyman Members are invited to join us on Monday, 10 August, for a preview screening of A24's Tony, a biographical comedy-drama about the early years of one of the world's greatest chefs.\\n\\nA 19-year-old Anthony Bourdain travels to Provincetown and stumbles into the chaotic world of a restaurant kitchen, setting off a summer that will shape the course of his life.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Members’ Preview: Tony\",\"synopsis\":\"Everyman Members are invited to join us on Monday, 10 August, for a preview screening of A24's Tony, a biographical comedy-drama about the early years of one of the world's greatest chefs.\\n\\nA 19-year-old Anthony Bourdain travels to Provincetown and stumbles into the chaotic world of a restaurant kitchen, setting off a summer that will shape the course of his life.\",\"certificate\":null,\"casting\":[\"Dominic Sessa\",\"Antonio Banderas\",\"Emilia Jones\",\"Leo Woodall\",\"Stavros Halkias\",\"Michael Jibrin\"],\"direction\":[\"Matt Johnson (V)\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-08-10T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"A24\"},\"orderIndex\":25},{\"id\":\"1000043022\",\"title\":\"Met Opera 2026-27: Così fan tutte\",\"runtime\":14220,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"414792\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a4cc72154b918f1b3d0ff42640b518a0.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Phelim\",\"lastName\":\"McDermott\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Federica\",\"lastName\":\"Lombardi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Samantha\",\"lastName\":\"Hankey\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ana María\",\"lastName\":\"Martínez (II)\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Duke\",\"lastName\":\"Kim\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Andrey\",\"lastName\":\"Zhilikhovsky\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gerald\",\"lastName\":\"Finley\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Met Opera 2026-27: Così fan tutte\",\"synopsis\":\"The Met: Live in HD season continues with Mozart's satirical comedy of fickle young love. Phelim McDermott's \\\"colorful, inventive\\\" (The New York Times) staging, inspired by Coney Island in the 1950s, sets the uproarious story at a boardwalk amusement park, where the two pairs of lovers at the heart of the tale find themselves on one emotional—and literal—thrill ride after another. Soprano Federica Lombardi and mezzo-soprano Samantha Hankey sing Fiordiligi and Dorabella, opposite tenor Duke Kim and baritone Andrey Zhilikhovsky as Ferrando and Guglielmo. Bass-baritone Gerald Finley reprises his portrayal of the cynical Don Alfonso, with soprano Ana María Martínez as the witty maid Despina.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/e6/2c/e62cf35bf686af38ddd405e73b539023.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-10-03T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a4cc72154b918f1b3d0ff42640b518a0.jpg\",\"synopsis\":\"The Met: Live in HD season continues with Mozart's satirical comedy of fickle young love. Phelim McDermott's \\\"colourful, inventive\\\" (The New York Times) staging, inspired by Coney Island in the 1950s, sets the uproarious story at a boardwalk amusement park, where the two pairs of lovers at the heart of the tale find themselves on one emotional—and literal—thrill ride after another. Soprano Federica Lombardi and mezzo-soprano Samantha Hankey sing Fiordiligi and Dorabella, opposite tenor Duke Kim and baritone Andrey Zhilikhovsky as Ferrando and Guglielmo. Bass-baritone Gerald Finley reprises his portrayal of the cynical Don Alfonso, with soprano Ana María Martínez as the witty maid Despina.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Metropolitan Opera: Così fan tutte (2026)\",\"synopsis\":\"The Met: Live in HD season continues with Mozart's satirical comedy of fickle young love. Phelim McDermott's \\\"colourful, inventive\\\" (The New York Times) staging, inspired by Coney Island in the 1950s, sets the uproarious story at a boardwalk amusement park, where the two pairs of lovers at the heart of the tale find themselves on one emotional—and literal—thrill ride after another. Soprano Federica Lombardi and mezzo-soprano Samantha Hankey sing Fiordiligi and Dorabella, opposite tenor Duke Kim and baritone Andrey Zhilikhovsky as Ferrando and Guglielmo. Bass-baritone Gerald Finley reprises his portrayal of the cynical Don Alfonso, with soprano Ana María Martínez as the witty maid Despina.\",\"certificate\":null,\"casting\":[\"Federica Lombardi\",\"Samantha Hankey\",\"Ana María Martínez (II)\",\"Duke Kim\",\"Andrey Zhilikhovsky\",\"Gerald Finley\"],\"direction\":[\"Phelim McDermott\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-10-03T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{},\"orderIndex\":41},{\"id\":\"1000043023\",\"title\":\"Met Opera 2026-27: La Fanciulla del West\",\"runtime\":11700,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"414793\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/59e4f54ffafd647f4abc17c920677545.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Richard\",\"lastName\":\"Jones\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Vida\",\"lastName\":\"Miknevičiūtė\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"SeokJong\",\"lastName\":\"Baek\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christopher\",\"lastName\":\"Maltman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Met Opera 2026-27: La Fanciulla del West\",\"synopsis\":\"Puccini's exhilarating drama of the Wild West returns in a new staging by Richard Jones, marking the company's first new production of La Fanciulla del West in more than 30 years. Soprano Sondra Radvanovsky makes her role debut as Minnie, the tough tavern owner with a heart of gold who finds love when she least expects it. Tenor SeokJong Baek is the dashing bandit who rambles into the remote California mining town to steal her heart, opposite baritone Christopher Maltman as the lawman determined to deliver justice—and win Minnie for himself. Maestro Keri-Lynn Wilson takes the podium to conduct one of opera's most action-packed adventures, live from the Met stage to cinemas worldwide.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/fd/76/fd76c385312b3e038f64dd102419fb91.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2027-01-23T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/59e4f54ffafd647f4abc17c920677545.jpg\",\"synopsis\":\"Puccini’s exhilarating Wild West drama returns in a new staging by Richard Jones, marking the company’s first new production of La Fanciulla del West in more than 30 years.\\n\\nSoprano Vida Miknevičiūtė makes her Met company debut as Minnie, the tough tavern owner with a heart of gold who finds love when she least expects it. Tenor SeokJong Baek stars as the dashing bandit who arrives in a remote California mining town and steals her heart, while baritone Christopher Maltman portrays the lawman determined to bring him to justice—and win Minnie for himself.\\n\\nMaestro Keri-Lynn Wilson takes the podium to conduct one of opera’s most action-packed adventures, broadcast live from the Met stage to cinemas worldwide.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Metropolitan Opera: La Fanciulla Del West (2027)\",\"synopsis\":\"Puccini’s exhilarating Wild West drama returns in a new staging by Richard Jones, marking the company’s first new production of La Fanciulla del West in more than 30 years.\\n\\nSoprano Vida Miknevičiūtė makes her Met company debut as Minnie, the tough tavern owner with a heart of gold who finds love when she least expects it. Tenor SeokJong Baek stars as the dashing bandit who arrives in a remote California mining town and steals her heart, while baritone Christopher Maltman portrays the lawman determined to bring him to justice—and win Minnie for himself.\\n\\nMaestro Keri-Lynn Wilson takes the podium to conduct one of opera’s most action-packed adventures, broadcast live from the Met stage to cinemas worldwide.\",\"certificate\":null,\"casting\":[\"Vida Miknevičiūtė\",\"SeokJong Baek\",\"Christopher Maltman\"],\"direction\":[\"Richard Jones\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2027-01-23T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"},\"orderIndex\":47},{\"id\":\"1000043020\",\"title\":\"Met Opera 2026-27: Macbeth\",\"runtime\":12540,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"414790\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/aff5b9b01833703c33f746dfa3b47be5.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Louisa\",\"lastName\":\"Proske\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lise\",\"lastName\":\"Davidsen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Freddie\",\"lastName\":\"De Tommaso\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Quinn\",\"lastName\":\"Kelsey\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ryan Speedo\",\"lastName\":\"Green\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Met Opera 2026-27: Macbeth\",\"synopsis\":\"Two of opera's most extraordinary artists return to The Met: Live in HD for Verdi's thrilling take on the immortal Shakespearean tale of the scheming couple determined to seize power at any cost. Baritone Quinn Kelsey is the Scottish king haunted by the ghosts of his murderous ascent to the throne, opposite soprano Lise Davidsen as the power-mad Lady Macbeth, whose ruinous ambition damns them both. Met Music Director Yannick Nézet-Séguin takes the podium for a penetrating production by Louisa Proske. Rounding out the all-star cast are tenor Freddie De Tommaso as Macduff and bass-baritone Ryan Speedo Green as Banquo.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/a1/f2/a1f2763211978c4f72c9b22aa02cce29.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-10-17T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/aff5b9b01833703c33f746dfa3b47be5.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Metropolitan Opera: Macbeth (2026)\",\"synopsis\":\"Two of opera's most extraordinary artists return to The Met: Live in HD for Verdi's thrilling take on the immortal Shakespearean tale of the scheming couple determined to seize power at any cost. Baritone Quinn Kelsey is the Scottish king haunted by the ghosts of his murderous ascent to the throne, opposite soprano Lise Davidsen as the power-mad Lady Macbeth, whose ruinous ambition damns them both. Met Music Director Yannick Nézet-Séguin takes the podium for a penetrating production by Louisa Proske. Rounding out the all-star cast are tenor Freddie De Tommaso as Macduff and bass-baritone Ryan Speedo Green as Banquo.\",\"certificate\":null,\"casting\":[\"Lise Davidsen\",\"Freddie De Tommaso\",\"Quinn Kelsey\",\"Ryan Speedo Green\"],\"direction\":[\"Louisa Proske\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-10-17T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"},\"orderIndex\":42},{\"id\":\"1000043025\",\"title\":\"Met Opera 2026-27: Manon\",\"runtime\":15840,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"414795\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2ca1c2b138d30ff40598fd420d77ae61.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Laurent\",\"lastName\":\"Pelly\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nadine\",\"lastName\":\"Sierra\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Matthew\",\"lastName\":\"Polenzani\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Carlo\",\"lastName\":\"Bosi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Andrzej\",\"lastName\":\"Filończyk\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rod\",\"lastName\":\"Gilfry\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jean\",\"lastName\":\"Teitgen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Met Opera 2026-27: Manon\",\"synopsis\":\"Following her radiant performance in Gounod's Roméo et Juliette which garnered raves for \\\"high notes that spun like liquid gold ... Sierra touched the operatic firmament\\\" (The New York Times) superstar soprano Nadine Sierra takes on another alluring French heroine, the irresistible title character of Massenet's passionate drama, live from the Met stage to cinemas worldwide. Leading tenor Matthew Polenzani is her idealistic lover, the Chevalier des Grieux, with rising-star baritone Andrzej Filończyk as her stalwart cousin, Lescaut, in a breathtaking staging by director Laurent Pelly.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/87/b5/87b5056eeb3dbbf42b1c4a344f173111.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2027-04-03T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2ca1c2b138d30ff40598fd420d77ae61.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Metropolitan Opera: Manon (2027)\",\"synopsis\":\"Following her radiant performance in Gounod's Roméo et Juliette which garnered raves for \\\"high notes that spun like liquid gold ... Sierra touched the operatic firmament\\\" (The New York Times) superstar soprano Nadine Sierra takes on another alluring French heroine, the irresistible title character of Massenet's passionate drama, live from the Met stage to cinemas worldwide. Leading tenor Matthew Polenzani is her idealistic lover, the Chevalier des Grieux, with rising-star baritone Andrzej Filończyk as her stalwart cousin, Lescaut, in a breathtaking staging by director Laurent Pelly.\",\"certificate\":null,\"casting\":[\"Nadine Sierra\",\"Matthew Polenzani\",\"Carlo Bosi\",\"Andrzej Filończyk\",\"Rod Gilfry\",\"Jean Teitgen\"],\"direction\":[\"Laurent Pelly\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2027-04-03T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"},\"orderIndex\":52},{\"id\":\"1000043026\",\"title\":\"Met Opera 2026-27: Otello\",\"runtime\":12060,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"414796\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2fa6466f3721f163ff8ceb00dcc72b36.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Bartlett\",\"lastName\":\"Sher\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ailyn\",\"lastName\":\"Pérez\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brian\",\"lastName\":\"Jagde\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Artur\",\"lastName\":\"Rucinski\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Deborah\",\"lastName\":\"Nansteel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Piotr\",\"lastName\":\"Buszewski\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Vitalij\",\"lastName\":\"Kowaljow\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Met Opera 2026-27: Otello\",\"synopsis\":\"One of today's leading dramatic tenors, Brian Jagde, takes on the tour-de-force title role of what many consider the ultimate Italian opera, live to cinemas worldwide. Verdi's monumental Shakespearean tragedy also features soprano Ailyn Pérez in her company role debut as the long-suffering Desdemona, alongside baritone Artur Ruciński as the sinister Iago. Michele Mariotti leads the full forces of the Met Orchestra and Chorus in the exhilarating score.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/ee/0d/ee0d8b22e97d5017882cac6b6d0a4180.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2027-04-24T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2fa6466f3721f163ff8ceb00dcc72b36.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Metropolitan Opera: Otello (2027)\",\"synopsis\":\"One of today's leading dramatic tenors, Brian Jagde, takes on the tour-de-force title role of what many consider the ultimate Italian opera, live to cinemas worldwide. Verdi's monumental Shakespearean tragedy also features soprano Ailyn Pérez in her company role debut as the long-suffering Desdemona, alongside baritone Artur Ruciński as the sinister Iago. Michele Mariotti leads the full forces of the Met Orchestra and Chorus in the exhilarating score.\",\"certificate\":null,\"casting\":[\"Ailyn Pérez\",\"Brian Jagde\",\"Artur Rucinski\",\"Deborah Nansteel\",\"Piotr Buszewski\",\"Vitalij Kowaljow\"],\"direction\":[\"Bartlett Sher\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2027-04-24T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"},\"orderIndex\":54},{\"id\":\"1000043027\",\"title\":\"Met Opera 2026-27: Parsifal\",\"runtime\":21900,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"414797\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8f92ff598f56c0bb3cd6136854619db6.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"François\",\"lastName\":\"Girard\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elīna\",\"lastName\":\"Garanča\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Piotr\",\"lastName\":\"Beczala\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Peter\",\"lastName\":\"Mattei\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ryan Speedo\",\"lastName\":\"Green\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jongmin\",\"lastName\":\"Park\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alfred\",\"lastName\":\"Walker\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Met Opera 2026-27: Parsifal\",\"synopsis\":\"A profound philosophical meditation on compassion and reconciliation, this transcendent rendering of a medieval knight's heroic quest for the Holy Grail returns to the big screen in François Girard's celebrated production, a \\\"thoughtful and intrepid staging, full of striking imagery\\\" (The New York Times). Yannick Nézet-Séguin conducts a cast of Wagnerian superstars, including tenor Piotr Beczała in the title role, mezzo-soprano Elīna Garanča as the enigmatic Kundry, baritone Peter Mattei as the ailing Amfortas, bass-baritone Ryan Speedo Green as the sorcerer Klingsor, and bass Jongmin Park as the wise Gurnemanz.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/e0/64/e064e85d6fb9741be53e4188a52f0f92.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2027-06-05T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8f92ff598f56c0bb3cd6136854619db6.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Metropolitan Opera: Parsifal (2027)\",\"synopsis\":\"A profound philosophical meditation on compassion and reconciliation, this transcendent rendering of a medieval knight's heroic quest for the Holy Grail returns to the big screen in François Girard's celebrated production, a \\\"thoughtful and intrepid staging, full of striking imagery\\\" (The New York Times). Yannick Nézet-Séguin conducts a cast of Wagnerian superstars, including tenor Piotr Beczała in the title role, mezzo-soprano Elīna Garanča as the enigmatic Kundry, baritone Peter Mattei as the ailing Amfortas, bass-baritone Ryan Speedo Green as the sorcerer Klingsor, and bass Jongmin Park as the wise Gurnemanz.\",\"certificate\":null,\"casting\":[\"Elīna Garanča\",\"Piotr Beczala\",\"Peter Mattei\",\"Ryan Speedo Green\",\"Jongmin Park\",\"Alfred Walker\"],\"direction\":[\"François Girard\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2027-06-05T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"},\"orderIndex\":57},{\"id\":\"1000043021\",\"title\":\"Met Opera 2026-27: Samson et Dalila\",\"runtime\":14040,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"414791\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/f0d37239997a420d2bb3c783f36c09fa.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Darko\",\"lastName\":\"Tresnjak\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Aigul\",\"lastName\":\"Akhmetshina\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Clay\",\"lastName\":\"Hilley\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Quinn\",\"lastName\":\"Kelsey\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alfred\",\"lastName\":\"Walker\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Morris\",\"lastName\":\"Robinson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Met Opera 2026-27: Samson et Dalila\",\"synopsis\":\"Saint-Saëns's spectacular take on the biblical hero of legendary strength and the seductive Philistine whose beauty overpowers him returns in the Met's larger-than-life production. Featuring a massive orchestra and chorus and some of opera's most spellbinding tunes, this masterpiece is a feast for the eyes and ears. Giacomo Sagripanti conducts an electrifying cast led by the formidable star pairing of mezzo- soprano Aigul Akhmetshina and tenor Clay Hilley, transmitted live to cinemas worldwide.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/fd/2b/fd2b3af79196cc65a574a81876065fb3.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-12-05T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/f0d37239997a420d2bb3c783f36c09fa.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Metropolitan Opera: Samson et Dalila (2026)\",\"synopsis\":\"Saint-Saëns's spectacular take on the biblical hero of legendary strength and the seductive Philistine whose beauty overpowers him returns in the Met's larger-than-life production. Featuring a massive orchestra and chorus and some of opera's most spellbinding tunes, this masterpiece is a feast for the eyes and ears. Giacomo Sagripanti conducts an electrifying cast led by the formidable star pairing of mezzo- soprano Aigul Akhmetshina and tenor Clay Hilley, transmitted live to cinemas worldwide.\",\"certificate\":null,\"casting\":[\"Aigul Akhmetshina\",\"Clay Hilley\",\"Quinn Kelsey\",\"Alfred Walker\",\"Morris Robinson\"],\"direction\":[\"Darko Tresnjak\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-12-05T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{},\"orderIndex\":46},{\"id\":\"1000043024\",\"title\":\"Met Opera 2026-27: Silent Night\",\"runtime\":10800,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"414794\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/38553a521e207c36735e1a870d5a7dd4.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"James\",\"lastName\":\"Robinson (III)\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elza\",\"lastName\":\"van den Heever\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ben\",\"lastName\":\"Bliss\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rolando\",\"lastName\":\"Villazón\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ben\",\"lastName\":\"Reisinger\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mattia\",\"lastName\":\"Olivieri\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Met Opera 2026-27: Silent Night\",\"synopsis\":\"Following his smash-hit company debut with The Hours, composer Kevin Puts returns to the Met with his Pulitzer Prize-winning opera, inspired by the true events of the 1914 Christmas truce. A poignant depiction of shared humanity in the most inhumane circumstances, Puts's grand, cinematic opera―with a libretto in English, French, and German by Mark Campbell has been widely acclaimed since its 2011 premiere, hailed as “an overwhelming emotive experience\\\" by The Guardian. The evocative staging by James Robinson takes the audience directly to the battlefields of the Western Front with a star-studded cast, featuring soprano Elza van den Heever and tenors Ben Bliss and Rolando Villazón, conducted by Maestro Dalia Stasevska live from the Met to cinemas worldwide.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/46/3c/463cce8b10be42d5f0f448b35f2fb8e7.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2027-03-20T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/38553a521e207c36735e1a870d5a7dd4.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Metropolitan Opera: Silent Night (2027)\",\"synopsis\":\"Following his smash-hit company debut with The Hours, composer Kevin Puts returns to the Met with his Pulitzer Prize-winning opera, inspired by the true events of the 1914 Christmas truce. A poignant depiction of shared humanity in the most inhumane circumstances, Puts's grand, cinematic opera―with a libretto in English, French, and German by Mark Campbell has been widely acclaimed since its 2011 premiere, hailed as “an overwhelming emotive experience\\\" by The Guardian. The evocative staging by James Robinson takes the audience directly to the battlefields of the Western Front with a star-studded cast, featuring soprano Elza van den Heever and tenors Ben Bliss and Rolando Villazón, conducted by Maestro Dalia Stasevska live from the Met to cinemas worldwide.\",\"certificate\":null,\"casting\":[\"Elza van den Heever\",\"Ben Bliss\",\"Rolando Villazón\",\"Ben Reisinger\",\"Mattia Olivieri\"],\"direction\":[\"James Robinson (III)\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2027-03-20T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{},\"orderIndex\":50},{\"id\":\"279306\",\"title\":\"Michael\",\"runtime\":7680,\"genres\":\"Biopic, Music, Drama\",\"__typename\":\"Movie\",\"altId\":[\"356098\",\"400300\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/f68364c883fcca05a54dd7ecc1c59b7d.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/pictures/24/01/22/14/34/0831833.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c5/25/c52534027fb6b0cd84b77d89e7be5d9e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/89/33/8933aa017e3eddfd1d458e1cbbe890c2.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ae/c3/aec374ee2593d9fb47809236bb320c50.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/0c/55/0c55d2e623128f5e6affd552d371b92f.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/89/45/89454a6c2e06fcd3c5b786f2424ce68c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/fa/7f/fa7fc075dcef1a0ab59211071721287c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ac/0f/ac0f5013584d20df639823e2d702ff2c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/99/50/99503c9becd2f792f151250dab20ebfa.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/43/eb/43ebe8ae342d3f1262d84be8ba73e4e0.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Antoine\",\"lastName\":\"Fuqua\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jaafar\",\"lastName\":\"Jackson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Colman\",\"lastName\":\"Domingo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nia\",\"lastName\":\"Long\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Miles\",\"lastName\":\"Teller\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Juliano\",\"lastName\":\"Krue Valdi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jamal R.\",\"lastName\":\"Henderson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jayden\",\"lastName\":\"Harville\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tre\",\"lastName\":\"Horton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jaylen\",\"lastName\":\"Hunter\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rhyan\",\"lastName\":\"Hill\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Michael\",\"synopsis\":\"Michael will bring audiences a riveting and honest portrayal of the brilliant yet complicated man who became the King of Pop. The film presents his triumphs and tragedies on an epic, cinematic scale - from his human side and personal struggles to his undeniable creative genius, exemplified by his most iconic performances. As never before, audiences will experience an inside look into one of the most influential, trailblazing artists the world has ever known.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/11/c4/11c440dabce816e598fdd408a7292705.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/356098_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/356098_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/ceb191151acc9e8e4892042f19983130.jpg\",\"__typename\":\"BOAppImage\"}]}},\"releases\":[{\"releasedAt\":\"2026-04-22T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"moderate threat, domestic abuse\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/f68364c883fcca05a54dd7ecc1c59b7d.jpg\",\"synopsis\":\"Michael is the cinematic portrayal of the life and legacy of one of the most influential artists the world has ever known.\\n\\nThe film tells the story of Michael Jackson’s life beyond the music, tracing his journey from the discovery of his extraordinary talent as the lead of the Jackson Five, to the visionary artist whose creative ambition fuelled a relentless pursuit to become the biggest entertainer in the world.\\n\\nHighlighting both his life off-stage and some of the most iconic performances from his early solo career, the film gives audiences a front-row seat to Michael Jackson as never before. This is where his story begins.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/b86c7935e597aa3254230479652656a9.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Michael\",\"synopsis\":\"Michael is the cinematic portrayal of the life and legacy of one of the most influential artists the world has ever known.\\n\\nThe film tells the story of Michael Jackson’s life beyond the music, tracing his journey from the discovery of his extraordinary talent as the lead of the Jackson Five, to the visionary artist whose creative ambition fuelled a relentless pursuit to become the biggest entertainer in the world.\\n\\nHighlighting both his life off-stage and some of the most iconic performances from his early solo career, the film gives audiences a front-row seat to Michael Jackson as never before. This is where his story begins.\",\"certificate\":\"12A\",\"casting\":[\"Jaafar Jackson\",\"Colman Domingo\",\"Nia Long\",\"Miles Teller\",\"Juliano Krue Valdi\",\"Jamal R. Henderson\",\"Jayden Harville\",\"Tre Horton\",\"Jaylen Hunter\",\"Rhyan Hill\"],\"direction\":[\"Antoine Fuqua\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/b86c7935e597aa3254230479652656a9.jpg\",\"https://all.web.img.acsta.net/pictures/24/01/22/14/34/0831833.jpg\",\"https://all.web.img.acsta.net/img/c5/25/c52534027fb6b0cd84b77d89e7be5d9e.jpg\",\"https://all.web.img.acsta.net/img/89/33/8933aa017e3eddfd1d458e1cbbe890c2.jpg\",\"https://all.web.img.acsta.net/img/ae/c3/aec374ee2593d9fb47809236bb320c50.jpg\",\"https://all.web.img.acsta.net/img/0c/55/0c55d2e623128f5e6affd552d371b92f.jpg\",\"https://all.web.img.acsta.net/img/89/45/89454a6c2e06fcd3c5b786f2424ce68c.jpg\",\"https://all.web.img.acsta.net/img/fa/7f/fa7fc075dcef1a0ab59211071721287c.jpg\",\"https://all.web.img.acsta.net/img/ac/0f/ac0f5013584d20df639823e2d702ff2c.jpg\",\"https://all.web.img.acsta.net/img/99/50/99503c9becd2f792f151250dab20ebfa.jpg\",\"https://all.web.img.acsta.net/img/43/eb/43ebe8ae342d3f1262d84be8ba73e4e0.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/b86c7935e597aa3254230479652656a9.jpg\",\"https://cms-assets.webediamovies.pro/production/2/ceb191151acc9e8e4892042f19983130.jpg\"],\"release\":\"2026-04-22T00:00:00.000Z\",\"advisory\":\"moderate threat, domestic abuse\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/356098_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/356098_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Universal International Pictures\"},\"orderIndex\":22},{\"id\":\"315380\",\"title\":\"Minions & Monsters\",\"runtime\":5340,\"genres\":\"Animation, Adventure, Comedy, Family\",\"__typename\":\"Movie\",\"altId\":[\"369294\",\"405512\",\"409511\",\"409512\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/1e3814c82e767189a705a211c73d6f5d.jpg\",\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/c3/f9/c3f9d82e8ddaee5fadcab0c192ef4883.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/98/bc/98bca09c21f1aeaa8a10b9597e2a7784.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/6f/a2/6fa24af33e332e47a089fa64789934eb.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/b7/ec/b7ec2da01333e7a1c7c911b3075188cd.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Pierre\",\"lastName\":\"Coffin\",\"__typename\":\"Person\"}}]},\"coDirectors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Patrick\",\"lastName\":\"Delage\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Minions & Monsters\",\"synopsis\":\"Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe with a riotous new chapter, featuring all-new characters, in the biggest global animated franchise in history: Minions & Monsters. \\n\\nThis is the rambunctious, ridiculous and totally true story of how the Minions conquered Hollywood, became movie stars, lost everything, unleashed monsters onto the world and then banded together to try and save the planet from the mayhem they had just created.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/09/ce/09ce2545e188a98492377c2ee693f570.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/369294_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/369294_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/21d29eea1946cbf78ce777f66fc6da2e.jpg\",\"__typename\":\"BOAppImage\"}]}},\"releases\":[{\"releasedAt\":\"2026-07-01T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"very mild comic violence, threat, rude humour\",\"__typename\":\"Rating\",\"certificate\":\"U\"}}],\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Pierre\",\"lastName\":\"Coffin\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Christoph\",\"lastName\":\"Waltz\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Trey\",\"lastName\":\"Parker\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Jesse\",\"lastName\":\"Eisenberg\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Jeff\",\"lastName\":\"Bridges\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Allison\",\"lastName\":\"Janney\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Zoey\",\"lastName\":\"Deutch\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Amy\",\"lastName\":\"Sedaris\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Romesh\",\"lastName\":\"Ranganathan\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Phil\",\"lastName\":\"LaMarr\",\"__typename\":\"Person\"}}]},\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/1e3814c82e767189a705a211c73d6f5d.jpg\",\"synopsis\":\"Hollywood has a monster problem…Follow the Minions in 1920s Hollywood as they aim to make a monster movie of their own and search for frightening creatures to appear in their movie.\\nBut after unleashing monsters upon an unsuspecting world, The Minions must band together to save the day.\\n\\nFresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe with a riotous new chapter, featuring all-new characters, in the biggest global animated franchise in history: Minions & Monsters.\\n\\nThis is the rambunctious, ridiculous and totally true story of how the Minions conquered Hollywood, became movie stars, lost everything, unleashed monsters onto the world and then banded together to try and save the planet from the mayhem they had just created.\\n\\nThe acclaimed voice cast stars Coffin as the Minions, alongside Allison Janney, Christoph Waltz, Jeff Bridges, Jesse Eisenberg, Zoey Deutch, Bobby Moynihan, Phil LaMarr, and Trey Parker.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/2a23a862179ac8293033d1e8c477e98e.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Minions & Monsters\",\"synopsis\":\"Hollywood has a monster problem…Follow the Minions in 1920s Hollywood as they aim to make a monster movie of their own and search for frightening creatures to appear in their movie.\\nBut after unleashing monsters upon an unsuspecting world, The Minions must band together to save the day.\\n\\nFresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe with a riotous new chapter, featuring all-new characters, in the biggest global animated franchise in history: Minions & Monsters.\\n\\nThis is the rambunctious, ridiculous and totally true story of how the Minions conquered Hollywood, became movie stars, lost everything, unleashed monsters onto the world and then banded together to try and save the planet from the mayhem they had just created.\\n\\nThe acclaimed voice cast stars Coffin as the Minions, alongside Allison Janney, Christoph Waltz, Jeff Bridges, Jesse Eisenberg, Zoey Deutch, Bobby Moynihan, Phil LaMarr, and Trey Parker.\",\"certificate\":\"U\",\"casting\":[\"Pierre Coffin\",\"Christoph Waltz\",\"Trey Parker\",\"Jesse Eisenberg\",\"Jeff Bridges\",\"Allison Janney\",\"Zoey Deutch\",\"Amy Sedaris\",\"Romesh Ranganathan\",\"Phil LaMarr\"],\"direction\":[\"Pierre Coffin\"],\"coDirection\":[\"Patrick Delage\"],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/2a23a862179ac8293033d1e8c477e98e.jpg\",\"https://all.web.img.acsta.net/img/c3/f9/c3f9d82e8ddaee5fadcab0c192ef4883.jpg\",\"https://all.web.img.acsta.net/img/98/bc/98bca09c21f1aeaa8a10b9597e2a7784.jpg\",\"https://all.web.img.acsta.net/img/6f/a2/6fa24af33e332e47a089fa64789934eb.jpg\",\"https://all.web.img.acsta.net/img/b7/ec/b7ec2da01333e7a1c7c911b3075188cd.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/2a23a862179ac8293033d1e8c477e98e.jpg\",\"https://cms-assets.webediamovies.pro/production/2/21d29eea1946cbf78ce777f66fc6da2e.jpg\"],\"release\":\"2026-07-01T00:00:00.000Z\",\"advisory\":\"very mild comic violence, threat, rude humour\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/369294_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/369294_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Universal International Pictures\"},\"orderIndex\":5},{\"id\":\"314942\",\"title\":\"Moana\",\"runtime\":6960,\"genres\":\"Family, Comedy, Adventure\",\"__typename\":\"Movie\",\"altId\":[\"348229\",\"405513\",\"409513\",\"409514\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8618f795cdb5902239c48343f73c7c6e.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/9f/5c/9f5ce74e201df9c1c28cbc74cdf98152.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/01/8c/018c798af1fb2d0052c331b16af6ef11.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/fa/93/fa93ee780e08b8134e96f237a3845028.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/2c/a7/2ca751877764b9a6a9c125d9d718aaf0.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/0c/a2/0ca21ff6c6321e9d0a9435e93655e956.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/8f/59/8f592596d36048f428355870260f08ee.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/29/01/29019921ab282c65a30127fa176589ba.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/68/dd/68ddc37ed2e488ba6871b215968dee1c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/54/d1/54d1ca0aaab3dc103031ecc3382b04f6.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/6d/82/6d82b786c01d52be69d38588f214056b.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Thomas\",\"lastName\":\"Kail\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Moana\",\"synopsis\":\"In Disney’s live-action reimagining of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyages beyond the reef of her island of Motunui with the infamous demigod Maui (Dwayne Johnson) on an unforgettable journey to restore prosperity to her people. The film is directed by Emmy® and Tony Award® winner Thomas Kail (“Hamilton”); produced by Dwayne Johnson, Beau Flynn, Dany Garcia, Hiram Garcia and Lin-Manuel Miranda; and executive produced by Thomas Kail, Scott Sheldon, Charles Newirth and Auliʻi Cravalho, who voiced Moana in the animated features “Moana” and “Moana 2.” Audiences can experience the brilliant cinematic sights, sounds and songs of “Moana” in cinemas in July 2026.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/e2/c8/e2c88707bfc3c5e740ce811b785dd022.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/348229_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/348229_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/fedd3918dd3e5345de29cb9565b03bc2.jpg\",\"__typename\":\"BOAppImage\"}]}},\"releases\":[{\"releasedAt\":\"2026-07-10T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild threat\",\"__typename\":\"Rating\",\"certificate\":\"PG\"}}],\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Catherine\",\"lastName\":\"Laga'aia\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dwayne\",\"lastName\":\"Johnson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rena\",\"lastName\":\"Owen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Tui\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Frankie\",\"lastName\":\"Adams\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Jemaine\",\"lastName\":\"Clement\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emma\",\"lastName\":\"Puahi-Shapazian\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Amaya\",\"lastName\":\"Masoli\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8618f795cdb5902239c48343f73c7c6e.jpg\",\"synopsis\":\"Live-action adaptation of the 2016 Disney animated film 'Moana'.\\n\\nAn adventurous teenager sails out on a daring mission to save her people. During her journey, Moana meets the once-mighty demigod Maui, who guides her in her quest to become a master way-finder. Together they sail across the open ocean on an action-packed voyage, encountering enormous monsters and impossible odds. Along the way, Moana fulfills the ancient quest of her ancestors and discovers the one thing she always sought: her own identity.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Moana\",\"synopsis\":\"Live-action adaptation of the 2016 Disney animated film 'Moana'.\\n\\nAn adventurous teenager sails out on a daring mission to save her people. During her journey, Moana meets the once-mighty demigod Maui, who guides her in her quest to become a master way-finder. Together they sail across the open ocean on an action-packed voyage, encountering enormous monsters and impossible odds. Along the way, Moana fulfills the ancient quest of her ancestors and discovers the one thing she always sought: her own identity.\",\"certificate\":\"PG\",\"casting\":[\"Catherine Laga'aia\",\"Dwayne Johnson\",\"Rena Owen\",\"John Tui\",\"Frankie Adams\",\"Jemaine Clement\",\"Emma Puahi-Shapazian\",\"Amaya Masoli\"],\"direction\":[\"Thomas Kail\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/9f/5c/9f5ce74e201df9c1c28cbc74cdf98152.jpg\",\"https://all.web.img.acsta.net/img/01/8c/018c798af1fb2d0052c331b16af6ef11.jpg\",\"https://all.web.img.acsta.net/img/fa/93/fa93ee780e08b8134e96f237a3845028.jpg\",\"https://all.web.img.acsta.net/img/2c/a7/2ca751877764b9a6a9c125d9d718aaf0.jpg\",\"https://all.web.img.acsta.net/img/0c/a2/0ca21ff6c6321e9d0a9435e93655e956.jpg\",\"https://all.web.img.acsta.net/img/8f/59/8f592596d36048f428355870260f08ee.jpg\",\"https://all.web.img.acsta.net/img/29/01/29019921ab282c65a30127fa176589ba.jpg\",\"https://all.web.img.acsta.net/img/68/dd/68ddc37ed2e488ba6871b215968dee1c.jpg\",\"https://all.web.img.acsta.net/img/54/d1/54d1ca0aaab3dc103031ecc3382b04f6.jpg\",\"https://all.web.img.acsta.net/img/6d/82/6d82b786c01d52be69d38588f214056b.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/fedd3918dd3e5345de29cb9565b03bc2.jpg\"],\"release\":\"2026-07-10T00:00:00.000Z\",\"advisory\":\"mild threat\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/348229_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/348229_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Walt Disney\"},\"orderIndex\":0},{\"id\":\"1000036235\",\"title\":\"National Theatre Live: Les Liaisons Dangereuses\",\"runtime\":11220,\"genres\":\"Drama\",\"__typename\":\"Movie\",\"altId\":[\"406840\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/3366d50f393ba30fdb2c610506090d4b.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Marianne\",\"lastName\":\"Elliott\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Aidan\",\"lastName\":\"Turner\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lesley\",\"lastName\":\"Manville\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Monica\",\"lastName\":\"Barbaro\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Darragh\",\"lastName\":\"Hand\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cat\",\"lastName\":\"Simmons\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hannah\",\"lastName\":\"van der Westhuysen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ali\",\"lastName\":\"Goldsmith\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gabriele\",\"lastName\":\"Drake\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nandi\",\"lastName\":\"Bhebhe\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sharif\",\"lastName\":\"Afifi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"National Theatre Live: Les Liaisons Dangereuses\",\"synopsis\":\"Marquise de Merteuil is a master in the art of survival. Alongside the magnetic Vicomte de Valmont, they turn seduction into strategy and weaponise desire. But when their alliance collapses into rivalry, the battle between them threatens to destroy everyone in their path.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/04/19/04197b6a524eab42ba9a9a060b31ec5e.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/406840_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/406840_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-06-25T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"7215\",\"name\":\"National Theatre\",\"__typename\":\"Company\"}],\"localRatings\":[],\"rating\":{\"advisory\":\"brief strong sex\",\"__typename\":\"Rating\",\"certificate\":\"15\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/3366d50f393ba30fdb2c610506090d4b.jpg\",\"synopsis\":\"BAFTA Award-winner Lesley Manville (Phantom Thread) joins Aidan Turner (Rivals) in a striking new staging of Christopher Hampton’s celebrated adaptation of the classic novel, where among the glittering salons of the super-rich, one misstep can mean ruin.\\n\\nMarquise de Merteuil is a master in the art of survival. Alongside the magnetic Vicomte de Valmont, they turn seduction into strategy and weaponise desire.  But when their alliance collapses into rivalry, the battle between them threatens to destroy everyone in their path.\\n\\nFilmed live on stage at the National Theatre, Marianne Elliott (Angels in America) directs this thrilling game of love, lies, and social warfare.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"National Theatre Live: Les Liaisons Dangereuses\",\"synopsis\":\"BAFTA Award-winner Lesley Manville (Phantom Thread) joins Aidan Turner (Rivals) in a striking new staging of Christopher Hampton’s celebrated adaptation of the classic novel, where among the glittering salons of the super-rich, one misstep can mean ruin.\\n\\nMarquise de Merteuil is a master in the art of survival. Alongside the magnetic Vicomte de Valmont, they turn seduction into strategy and weaponise desire.  But when their alliance collapses into rivalry, the battle between them threatens to destroy everyone in their path.\\n\\nFilmed live on stage at the National Theatre, Marianne Elliott (Angels in America) directs this thrilling game of love, lies, and social warfare.\",\"certificate\":\"15\",\"casting\":[\"Aidan Turner\",\"Lesley Manville\",\"Monica Barbaro\",\"Darragh Hand\",\"Cat Simmons\",\"Hannah van der Westhuysen\",\"Ali Goldsmith\",\"Gabriele Drake\",\"Nandi Bhebhe\",\"Sharif Afifi\"],\"direction\":[\"Marianne Elliott\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-06-25T00:00:00.000Z\",\"advisory\":\"brief strong sex\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/406840_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/406840_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"National Theatre\"},\"orderIndex\":8},{\"id\":\"1000046832\",\"title\":\"National Theatre Live: The Misanthrope\",\"runtime\":9000,\"genres\":\"Drama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/bb5b40c9efd51e2019b6a750a3c311e0.jpg\",\"__typename\":\"Movie\",\"altId\":[\"419236\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Indhu\",\"lastName\":\"Rubasingham\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sandra\",\"lastName\":\"Oh\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Paul\",\"lastName\":\"Chahidi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tom\",\"lastName\":\"Mison\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jemima\",\"lastName\":\"Rooper\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Abigail\",\"lastName\":\"Cruttenden\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Poppy\",\"lastName\":\"Townsend White\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Teddy\",\"lastName\":\"Holton-Frances\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gabby\",\"lastName\":\"Wong\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Francesca\",\"lastName\":\"Fullilove\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Imogen\",\"lastName\":\"Elliott\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"National Theatre Live: The Misanthrope\",\"synopsis\":\"Alice, a brilliant novelist, despises the hollow contemporary mantras of kindness and respect. But the bolder she becomes in speaking out, the more colleagues avoid her, and the more her personal relationships begin to fracture.\\n\\nAs she challenges fashionable ideas and lends her voice to causes others are afraid to touch, she faces intense criticism and backlash. Alice will soon learn the price she must pay as an artist and as a woman for daring to speak her mind.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/d4/6e/d46e168f03978cdacc702a4b4a0304e2.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-09-22T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"7215\",\"name\":\"National Theatre\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/bb5b40c9efd51e2019b6a750a3c311e0.jpg\",\"synopsis\":\"Award-winner Sandra Oh (Killing Eve) plays the title role in this razor-sharp reimagining of Molière’s classic dark comedy.\\n \\nTelling the truth isn’t always that simple. Alice, a brilliant novelist, despises the carefully constructed lies of modern society. But the more she challenges those around her, the fiercer the backlash becomes. Soon, she must confront the price of speaking her truth in a world that would rather silence her. \\n \\nFilmed live on stage at the National Theatre, Indhu Rubasingham directs Martin Crimp’s (Cyrano de Bergerac) highly anticipated play.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"National Theatre Live: The Misanthrope\",\"synopsis\":\"Award-winner Sandra Oh (Killing Eve) plays the title role in this razor-sharp reimagining of Molière’s classic dark comedy.\\n \\nTelling the truth isn’t always that simple. Alice, a brilliant novelist, despises the carefully constructed lies of modern society. But the more she challenges those around her, the fiercer the backlash becomes. Soon, she must confront the price of speaking her truth in a world that would rather silence her. \\n \\nFilmed live on stage at the National Theatre, Indhu Rubasingham directs Martin Crimp’s (Cyrano de Bergerac) highly anticipated play.\",\"certificate\":null,\"casting\":[\"Sandra Oh\",\"Paul Chahidi\",\"Tom Mison\",\"Jemima Rooper\",\"Abigail Cruttenden\",\"Poppy Townsend White\",\"Teddy Holton-Frances\",\"Gabby Wong\",\"Francesca Fullilove\",\"Imogen Elliott\"],\"direction\":[\"Indhu Rubasingham\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-09-22T00:00:00.000Z