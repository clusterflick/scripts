/d3e4ae5ac5242812b438e5b3ec4b0991.jpg\",\"https://all.web.img.acsta.net/img/08/86/088654f38822d37096787b6ac4129029.jpg\",\"https://all.web.img.acsta.net/img/c6/23/c6234b764a18606264306790fc58856c.jpg\",\"https://all.web.img.acsta.net/img/68/76/687676005902cabce7752c468a101a4a.jpg\",\"https://all.web.img.acsta.net/img/41/f7/41f7cb505ffeb00c7c9f8d2c24421efa.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/ff7e4fc79c6bbfb4ad9db814a5f3db07.jpg\",\"https://cms-assets.webediamovies.pro/production/2/d53cbab6780c4e0f148dba5d0c7b8526.jpg\"],\"release\":\"2026-07-17T00:00:00.000Z\",\"advisory\":\"strong violence\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/377232_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/377232_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Universal International Pictures\"},\"orderIndex\":26},{\"id\":\"1000046206\",\"title\":\"The Odyssey (35mm)\",\"runtime\":10320,\"genres\":\"Action, Fantasy\",\"__typename\":\"Movie\",\"altId\":[\"418489\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/b3d0fa94e865b63e26928bebf0e790fa.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Christopher\",\"lastName\":\"Nolan\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Matt\",\"lastName\":\"Damon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tom\",\"lastName\":\"Holland\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Charlize\",\"lastName\":\"Theron\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anne\",\"lastName\":\"Hathaway\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":null,\"lastName\":\"Zendaya\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Pattinson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lupita\",\"lastName\":\"Nyong'o\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jon\",\"lastName\":\"Bernthal\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"The Odyssey 35mm\",\"synopsis\":\"The first feature shot entirely in IMAX, The Odyssey details the arduous, dangerous journey of Odysseus, King of Ithaca (Matt Damon) from the Trojan War back to his homeland, where his wife Penelope (Anne Hathaway) awaits his return. Along the way, Odysseus and his dwindling army are faced with the Gods’ worst creations and temptations. The must-see film of 2026, The Odyssey’s all-star cast includes Tom Holland, Robert Pattinson, Lupita Nyong’o, Zendaya and Charlize Theron.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/71/a0/71a0986c727b2be05aecb1e3113561ec.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/e5ad3d1d4e3702bdac52b964b2bdd950.jpg\",\"__typename\":\"BOAppImage\"}]}},\"releases\":[{\"releasedAt\":\"2026-07-17T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong violence\",\"__typename\":\"Rating\",\"certificate\":\"15\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":\"The Odyssey (35mm)\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/b3d0fa94e865b63e26928bebf0e790fa.jpg\",\"synopsis\":\"Join us at Everyman Screen on the Green for The Odyssey, presented in stunning 35mm.\\n\\nAfter the Trojan War, Odysseus faces a dangerous voyage back to Ithaca, meeting creatures like the Cyclops Polyphemus, Sirens, and Circe along the way.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Odyssey 35mm\",\"synopsis\":\"Join us at Everyman Screen on the Green for The Odyssey, presented in stunning 35mm.\\n\\nAfter the Trojan War, Odysseus faces a dangerous voyage back to Ithaca, meeting creatures like the Cyclops Polyphemus, Sirens, and Circe along the way.\",\"certificate\":\"15\",\"casting\":[\"Matt Damon\",\"Tom Holland\",\"Charlize Theron\",\"Anne Hathaway\",\"Zendaya\",\"Robert Pattinson\",\"Lupita Nyong'o\",\"Jon Bernthal\"],\"direction\":[\"Christopher Nolan\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/e5ad3d1d4e3702bdac52b964b2bdd950.jpg\"],\"release\":\"2026-07-17T00:00:00.000Z\",\"advisory\":\"strong violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Universal International Pictures\"},\"orderIndex\":27},{\"id\":\"1000038835\",\"title\":\"The Scarecrows' Wedding & The Smeds and the Smoos\",\"runtime\":3120,\"genres\":\"Animation, Family\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/3f87e2a16378c20ddcc943c269a5b29c.jpg\",\"__typename\":\"Movie\",\"altId\":[\"410017\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Samantha\",\"lastName\":\"Cutler\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jeroen\",\"lastName\":\"Jaspaert\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Daniel\",\"lastName\":\"Snaddon\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"The Scarecrows' Wedding & The Smeds and the Smoos\",\"synopsis\":\"Join us for a back to back special of The Scarecrows' Wedding and The Smeds and the Smoos\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/de/73/de733948d55168c0cbb1f349a9e3731a.png\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-02-06T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"6209\",\"name\":\"Magic Light Pictures\",\"__typename\":\"Company\"}],\"localRatings\":[],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"U\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/3f87e2a16378c20ddcc943c269a5b29c.jpg\",\"synopsis\":\"Join us for a double-bill, featuring Julia Donaldson's famous children's tales on the big screen!\\n\\nTHE SCARECROWS' WEDDING\\nTwo devoted scarecrows, Betty O'Barley and Harry O'Hay, are planning a wedding to remember. When Harry insists on leaving the farm to collect one last thing for their big day, a smooth-talking scarecrow named Reginald Rake swoops in with plans of his own.\\n\\nTHE SMEDS & THE SMOOS\\nBill and Janet fall in love while their families are at war. Faced with disapproval, they flee to a distant planet and Grandma Smoo and Grandpa Smed must put aside their differences and work together to bring them back home.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Scarecrows' Wedding & The Smeds and the Smoos\",\"synopsis\":\"Join us for a double-bill, featuring Julia Donaldson's famous children's tales on the big screen!\\n\\nTHE SCARECROWS' WEDDING\\nTwo devoted scarecrows, Betty O'Barley and Harry O'Hay, are planning a wedding to remember. When Harry insists on leaving the farm to collect one last thing for their big day, a smooth-talking scarecrow named Reginald Rake swoops in with plans of his own.\\n\\nTHE SMEDS & THE SMOOS\\nBill and Janet fall in love while their families are at war. Faced with disapproval, they flee to a distant planet and Grandma Smoo and Grandpa Smed must put aside their differences and work together to bring them back home.\",\"certificate\":\"U\",\"casting\":[],\"direction\":[\"Samantha Cutler\",\"Jeroen Jaspaert\",\"Daniel Snaddon\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-02-06T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Magic Light Pictures\"}},{\"id\":\"1000004629\",\"title\":\"The Sheep Detectives\",\"runtime\":6600,\"genres\":\"Detective, Comedy\",\"__typename\":\"Movie\",\"altId\":[\"365879\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/26e32358895113b92e56f2e90817eadd.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/00/b8/00b8e165d1d43bb55d0830927418be91.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/66/53/665327587269adc9bcadf63ba9017331.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/1e/27/1e27dcca9e3a830029d4ea356c2f4a87.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/61/3d/613dfc2211d3a2a5fe8126c9c0537072.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ca/63/ca63b671151eebe9cdc4ed19ea731a72.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/d8/c5/d8c5d2c2a337baf78ab0917961cb0e69.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/6e/c4/6ec41a812a5e9dab043fd54383fda04e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e9/2f/e92fafaf33d5c89ceac299fdf4711ed6.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e7/00/e7007a2d10f9856115588500e7072cb9.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/68/72/6872f6f4d6b81038945396447300bcbf.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Kyle\",\"lastName\":\"Balda\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"The Sheep Detectives\",\"synopsis\":\"In this witty, new breed of mystery, George (Hugh Jackman) is a shepherd who reads detective novels to his beloved sheep every night, assuming they can’t possibly understand. But when a mysterious incident disrupts life on the farm, the sheep realise they must become the detectives. As they follow the clues and investigate human suspects, they prove that even sheep can be brilliant crime-solvers.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/bd/58/bd58c2088b6d23994c6e02d0164f2d84.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/365879_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/365879_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/fd498aa220c896875a77fa376c477570.jpg\",\"__typename\":\"BOAppImage\"}]}},\"releases\":[{\"releasedAt\":\"2026-05-02T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild violence, threat, brief language\",\"__typename\":\"Rating\",\"certificate\":\"PG\"}},{\"releasedAt\":\"2026-05-08T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild violence, threat, brief language\",\"__typename\":\"Rating\",\"certificate\":\"PG\"}}],\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hugh\",\"lastName\":\"Jackman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nicholas\",\"lastName\":\"Braun\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nicholas\",\"lastName\":\"Galitzine\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Molly\",\"lastName\":\"Gordon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hong\",\"lastName\":\"Chau\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emma\",\"lastName\":\"Thompson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Julia\",\"lastName\":\"Louis-Dreyfus\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Bryan\",\"lastName\":\"Cranston\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Chris\",\"lastName\":\"O'Dowd\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Regina\",\"lastName\":\"Hall\",\"__typename\":\"Person\"}}]},\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/26e32358895113b92e56f2e90817eadd.jpg\",\"synopsis\":\"In this witty, new breed of mystery, George Hardy (Hugh Jackman) is a shepherd who loves to read detective novels to his beloved sheep every night, assuming they can’t possibly understand him. \\n\\nBut when a mysterious incident disrupts life on the farm, the sheep realise they must become the detectives and decide to solve the crime themselves, even if it means leaving their meadow for the first time… As they follow the clues and investigate, the sheep have to face the fact that the human world isn't as simple as it appears in books.\\n\\nThe Sheep Detectives boasts an all-star cast including Hugh Jackman, Nicholas Braun, Nicholas Galitzine, Molly Gordon, Hong Chau, and Emma Thompson with the voices of Julia Louis-Dreyfus, Bryan Cranston, Chris O'Dowd, Regina Hall, Patrick Stewart, Bella Ramsey, and Brett Goldstein. This new mystery comedy film based on the 2005 novel Three Bags Full by Leonie Swann is directed by Kyle Balda, written by Craig Mazin, and shows that even sheep can be brilliant crime-solvers.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/15d03950e998dd1b58b988177a96d1c6.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Sheep Detectives\",\"synopsis\":\"In this witty, new breed of mystery, George Hardy (Hugh Jackman) is a shepherd who loves to read detective novels to his beloved sheep every night, assuming they can’t possibly understand him. \\n\\nBut when a mysterious incident disrupts life on the farm, the sheep realise they must become the detectives and decide to solve the crime themselves, even if it means leaving their meadow for the first time… As they follow the clues and investigate, the sheep have to face the fact that the human world isn't as simple as it appears in books.\\n\\nThe Sheep Detectives boasts an all-star cast including Hugh Jackman, Nicholas Braun, Nicholas Galitzine, Molly Gordon, Hong Chau, and Emma Thompson with the voices of Julia Louis-Dreyfus, Bryan Cranston, Chris O'Dowd, Regina Hall, Patrick Stewart, Bella Ramsey, and Brett Goldstein. This new mystery comedy film based on the 2005 novel Three Bags Full by Leonie Swann is directed by Kyle Balda, written by Craig Mazin, and shows that even sheep can be brilliant crime-solvers.\",\"certificate\":\"PG\",\"casting\":[\"Hugh Jackman\",\"Nicholas Braun\",\"Nicholas Galitzine\",\"Molly Gordon\",\"Hong Chau\",\"Emma Thompson\",\"Julia Louis-Dreyfus\",\"Bryan Cranston\",\"Chris O'Dowd\",\"Regina Hall\"],\"direction\":[\"Kyle Balda\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/15d03950e998dd1b58b988177a96d1c6.jpg\",\"https://all.web.img.acsta.net/img/00/b8/00b8e165d1d43bb55d0830927418be91.jpg\",\"https://all.web.img.acsta.net/img/66/53/665327587269adc9bcadf63ba9017331.jpg\",\"https://all.web.img.acsta.net/img/1e/27/1e27dcca9e3a830029d4ea356c2f4a87.jpg\",\"https://all.web.img.acsta.net/img/61/3d/613dfc2211d3a2a5fe8126c9c0537072.jpg\",\"https://all.web.img.acsta.net/img/ca/63/ca63b671151eebe9cdc4ed19ea731a72.jpg\",\"https://all.web.img.acsta.net/img/d8/c5/d8c5d2c2a337baf78ab0917961cb0e69.jpg\",\"https://all.web.img.acsta.net/img/6e/c4/6ec41a812a5e9dab043fd54383fda04e.jpg\",\"https://all.web.img.acsta.net/img/e9/2f/e92fafaf33d5c89ceac299fdf4711ed6.jpg\",\"https://all.web.img.acsta.net/img/e7/00/e7007a2d10f9856115588500e7072cb9.jpg\",\"https://all.web.img.acsta.net/img/68/72/6872f6f4d6b81038945396447300bcbf.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/15d03950e998dd1b58b988177a96d1c6.jpg\",\"https://cms-assets.webediamovies.pro/production/2/fd498aa220c896875a77fa376c477570.jpg\"],\"release\":\"2026-05-02T00:00:00.000Z\",\"advisory\":\"mild violence, threat, brief language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/365879_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/365879_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures UK\"}},{\"id\":\"1000026649\",\"title\":\"The Social Reckoning\",\"runtime\":null,\"genres\":\"Drama\",\"__typename\":\"Movie\",\"altId\":[\"395189\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/fa4a8363ed3ca87fa94e22d96d6cf66c.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/53/50/5350e1bc3e33ea290e790e3fdab18d5b.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/5e/4f/5e4fde5b7aed0fb951eaed9675f2ce16.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/f6/bb/f6bb13e6ab8c77ff5ce32bcfc6177cbe.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/52/0b/520b7a4c780d18ba78363b2ca271a9d2.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Aaron\",\"lastName\":\"Sorkin\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mikey\",\"lastName\":\"Madison\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jeremy\",\"lastName\":\"Allen White\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Wunmi\",\"lastName\":\"Mosaku\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Betty\",\"lastName\":\"Gilpin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Billy\",\"lastName\":\"Magnussen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bill\",\"lastName\":\"Burr\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jeremy\",\"lastName\":\"Strong\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gbenga\",\"lastName\":\"Akinnagbe\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anna\",\"lastName\":\"Lambe\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Aidan Laprete\",\"lastName\":\"Powell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"The Social Reckoning\",\"synopsis\":\"A companion piece to the hit film, THE SOCIAL NETWORK, Sorkin's original screenplay tells the true story of how Frances Haugen (Madison), a young Facebook engineer, enlists the help of Jeff Horwitz (White), a Wall Street Journal reporter, to go on a dangerous journey that ends up blowing the whistle on the social network's most guarded secrets.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/0a/20/0a20a7fc1efe8dc47bb0c12e6e4f4050.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/395189_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/395189_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-10-09T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/fa4a8363ed3ca87fa94e22d96d6cf66c.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/7debb46e1e7d872e7e0e9fad84450ae5.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Social Reckoning\",\"synopsis\":\"A companion piece to the hit film, THE SOCIAL NETWORK, Sorkin's original screenplay tells the true story of how Frances Haugen (Madison), a young Facebook engineer, enlists the help of Jeff Horwitz (White), a Wall Street Journal reporter, to go on a dangerous journey that ends up blowing the whistle on the social network's most guarded secrets.\",\"certificate\":null,\"casting\":[\"Mikey Madison\",\"Jeremy Allen White\",\"Wunmi Mosaku\",\"Betty Gilpin\",\"Billy Magnussen\",\"Bill Burr\",\"Jeremy Strong\",\"Gbenga Akinnagbe\",\"Anna Lambe\",\"Aidan Laprete Powell\"],\"direction\":[\"Aaron Sorkin\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/7debb46e1e7d872e7e0e9fad84450ae5.jpg\",\"https://all.web.img.acsta.net/img/53/50/5350e1bc3e33ea290e790e3fdab18d5b.jpg\",\"https://all.web.img.acsta.net/img/5e/4f/5e4fde5b7aed0fb951eaed9675f2ce16.jpg\",\"https://all.web.img.acsta.net/img/f6/bb/f6bb13e6ab8c77ff5ce32bcfc6177cbe.jpg\",\"https://all.web.img.acsta.net/img/52/0b/520b7a4c780d18ba78363b2ca271a9d2.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/7debb46e1e7d872e7e0e9fad84450ae5.jpg\"],\"release\":\"2026-10-09T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/395189_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/395189_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures UK\"}},{\"id\":\"1000044931\",\"title\":\"Throwback: Batman Begins\",\"runtime\":8400,\"genres\":\"Action, Thriller\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/01aaade7155b19e5756cfb352474440a.jpg\",\"__typename\":\"Movie\",\"altId\":[\"416968\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Christopher\",\"lastName\":\"Nolan\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christian\",\"lastName\":\"Bale\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Caine\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Liam\",\"lastName\":\"Neeson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Nolan Throwback: Batman Begins\",\"synopsis\":\"The tale finds the disillusioned industrial heir Bruce Wayne, in the wake of his parents' murder, traveling the world to seek the means to fight injustice and turn fear against those who prey on the fearful. He returns to Gotham and unveils his alter-ego: Batman, a masked crusader who uses his strength, intellect and an array of high tech deceptions to fight the sinister forces that threaten the city.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/e1/84/e1842c78bc5eb84f37e2d320964143c8.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":null,\"distributors\":[],\"__typename\":\"Release\",\"localRatings\":[],\"rating\":{\"advisory\":\"Contains moderate horror and violence\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":\"Throwback: Batman Begins\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/01aaade7155b19e5756cfb352474440a.jpg\",\"synopsis\":\"The tale finds the disillusioned industrial heir Bruce Wayne, in the wake of his parents' murder, travelling the world to seek the means to fight injustice and turn fear against those who prey on the fearful. He returns to Gotham and unveils his alter-ego: Batman, a masked crusader who uses his strength, intellect and an array of high-tech deceptions to fight the sinister forces that threaten the city.\\n\\nScreening on Sundays and Wednesdays as part of our Nolan Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Nolan Throwback: Batman Begins\",\"synopsis\":\"The tale finds the disillusioned industrial heir Bruce Wayne, in the wake of his parents' murder, travelling the world to seek the means to fight injustice and turn fear against those who prey on the fearful. He returns to Gotham and unveils his alter-ego: Batman, a masked crusader who uses his strength, intellect and an array of high-tech deceptions to fight the sinister forces that threaten the city.\\n\\nScreening on Sundays and Wednesdays as part of our Nolan Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"certificate\":\"12A\",\"casting\":[\"Christian Bale\",\"Michael Caine\",\"Liam Neeson\"],\"direction\":[\"Christopher Nolan\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":null,\"advisory\":\"Contains moderate horror and violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000044935\",\"title\":\"Throwback: Dunkirk\",\"runtime\":6420,\"genres\":\"War movie, Historical, Drama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/5943fde65a594ced875dc199c3f697c1.jpg\",\"__typename\":\"Movie\",\"altId\":[\"416972\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Christopher\",\"lastName\":\"Nolan\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Fionn\",\"lastName\":\"Whitehead\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mark\",\"lastName\":\"Rylance\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tom\",\"lastName\":\"Hardy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Nolan Throwback: Dunkirk\",\"synopsis\":\"In May 1940, Germany advanced into France, trapping Allied troops on the beaches of Dunkirk. Under air and ground cover from British and French forces, troops were slowly and methodically evacuated from the beach using every serviceable naval and civilian vessel that could be found. At the end of this heroic mission, 330,000 French, British, Belgian and Dutch soldiers were safely evacuated.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/22/24/2224f61fa408762fb2992373efbcf2ca.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-06-28T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"localRatings\":[],\"rating\":{\"advisory\":\"sustained threat, intense sequences, moderate violence, strong language\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":\"Throwback: Dunkirk\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/5943fde65a594ced875dc199c3f697c1.jpg\",\"synopsis\":\"In May 1940, Germany advanced into France, trapping Allied troops on the beaches of Dunkirk. Under air and ground cover from British and French forces, troops were slowly and methodically evacuated from the beach using every serviceable naval and civilian vessel that could be found. At the end of this heroic mission, 330,000 French, British, Belgian and Dutch soldiers were safely evacuated.\\n\\nScreening on Sundays and Wednesdays as part of our Nolan Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Nolan Throwback: Dunkirk\",\"synopsis\":\"In May 1940, Germany advanced into France, trapping Allied troops on the beaches of Dunkirk. Under air and ground cover from British and French forces, troops were slowly and methodically evacuated from the beach using every serviceable naval and civilian vessel that could be found. At the end of this heroic mission, 330,000 French, British, Belgian and Dutch soldiers were safely evacuated.\\n\\nScreening on Sundays and Wednesdays as part of our Nolan Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"certificate\":\"12A\",\"casting\":[\"Fionn Whitehead\",\"Mark Rylance\",\"Tom Hardy\"],\"direction\":[\"Christopher Nolan\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-06-28T00:00:00.000Z\",\"advisory\":\"sustained threat, intense sequences, moderate violence, strong language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000044932\",\"title\":\"Throwback: Inception\",\"runtime\":8880,\"genres\":\"Science fiction, Thriller\",\"__typename\":\"Movie\",\"altId\":[\"416969\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/01593821182ba003c0ebe2c4f6829e46.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Christopher\",\"lastName\":\"Nolan\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Leonardo\",\"lastName\":\"DiCaprio\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tom\",\"lastName\":\"Hardy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marion\",\"lastName\":\"Cotillard\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elliot\",\"lastName\":\"Page\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cillian\",\"lastName\":\"Murphy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Caine\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"Nolan Throwback: Inception\",\"synopsis\":\"Dom Cobb is a skilled thief, the absolute best in the dangerous art of extraction, stealing valuable secrets from deep within the subconscious during the dream state when the mind is at its most vulnerable. Cobb's rare ability has made him a coveted player in this treacherous new world of corporate espionage, but it has also made him an international fugitive and cost him everything he has ever loved. Now, Cobb is being offered a chance at redemption. One last job could give him his life back, but only if he can accomplish the impossible -- inception.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/ea/4c/ea4c1b2c402e6697c97f57a0eb675faa.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-07-12T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"localRatings\":[],\"rating\":{\"advisory\":\"Contains moderate violence\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":\"Throwback: Inception\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/01593821182ba003c0ebe2c4f6829e46.jpg\",\"synopsis\":\"Dom Cobb is a skilled thief, the absolute best in the dangerous art of extraction, stealing valuable secrets from deep within the subconscious during the dream state when the mind is at its most vulnerable. Cobb's rare ability has made him a coveted player in this treacherous new world of corporate espionage, but it has also made him an international fugitive and cost him everything he has ever loved. Now, Cobb is being offered a chance at redemption. One last job could give him his life back, but only if he can accomplish the impossible -- inception.\\n\\nScreening on Sundays and Wednesdays as part of our Nolan Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Nolan Throwback: Inception\",\"synopsis\":\"Dom Cobb is a skilled thief, the absolute best in the dangerous art of extraction, stealing valuable secrets from deep within the subconscious during the dream state when the mind is at its most vulnerable. Cobb's rare ability has made him a coveted player in this treacherous new world of corporate espionage, but it has also made him an international fugitive and cost him everything he has ever loved. Now, Cobb is being offered a chance at redemption. One last job could give him his life back, but only if he can accomplish the impossible -- inception.\\n\\nScreening on Sundays and Wednesdays as part of our Nolan Throwback Season, where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"certificate\":\"12A\",\"casting\":[\"Leonardo DiCaprio\",\"Tom Hardy\",\"Marion Cotillard\",\"Elliot Page\",\"Cillian Murphy\",\"Michael Caine\"],\"direction\":[\"Christopher Nolan\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-07-12T00:00:00.000Z\",\"advisory\":\"Contains moderate violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{},\"orderIndex\":72},{\"id\":\"327712\",\"title\":\"Throwback: Interstellar\",\"runtime\":10140,\"genres\":\"Science fiction\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ca3e99120840837f12be6645ec0f5bca.jpg\",\"__typename\":\"Movie\",\"altId\":[\"358000\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Christopher\",\"lastName\":\"Nolan\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\