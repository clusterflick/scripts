00:00:00.000Z\",\"advisory\":\"moderate violence, threat, language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"},\"orderIndex\":6},{\"id\":\"1000016836\",\"title\":\"The Christophers\",\"runtime\":6000,\"genres\":\"Comedy, Drama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ca8610db6b07a6ac952be107a73a1868.jpg\",\"__typename\":\"Movie\",\"altId\":[\"382414\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/51/0d/510de593a71359952f2fa969ae5da6c4.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/0e/aa/0eaac12cda673ac31d79774d3d2aba36.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/07/1d/071df4c642aa6caeee917e84b955986d.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/f0/48/f048924f3e81a72319f5aaa05ee424a7.jpg\",\"__typename\":\"Image\"}],\"quadImages\":[\"https://all.web.img.acsta.net/img/1c/82/1c82fcbee78cc9eca8ab176c14475639.jpg\"],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Steven\",\"lastName\":\"Soderbergh\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ian\",\"lastName\":\"McKellen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michaela\",\"lastName\":\"Coel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"James\",\"lastName\":\"Corden\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jessica\",\"lastName\":\"Gunning\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"locale\":{\"title\":\"The Christophers\",\"synopsis\":\"What is the value of art? Does it reside in personal expression? Cultural longevity? Financial worth? These questions fuel Steven Soderbergh’s gloriously entertaining comedy, THE CHRISTOPHERS. Julian Sklar (McKellen) was once a star of London’s 1960’s and 70’s pop art explosion, but he hasn’t painted in decades and has been broke for years. His two estranged children (James Corden, Jessica Gunning), desperate for an inheritance, hire Lori, an art restorer and former forger (Coel), to pose as a prospective assistant in order to access unfinished canvases Julian has buried deep in storage. A sharp and remarkable tale of creativity, legacy, and avarice.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/74/10/74104e10c34c1d41b27c307f1f249a65.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/19069cd4bc2b2dd3c620eb4143ceabd7.jpg\",\"__typename\":\"BOAppImage\"}]}},\"releases\":[{\"releasedAt\":\"2026-05-15T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"31124\",\"name\":\"Picturehouse Entertainment\",\"__typename\":\"Company\"}],\"localRatings\":[],\"rating\":{\"advisory\":\"very strong language\",\"__typename\":\"Rating\",\"certificate\":\"15\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ca8610db6b07a6ac952be107a73a1868.jpg\",\"synopsis\":\"A mainstay of the London art scene since his starry breakout in the creative explosion of the 1960’s, Julian Sklar (Ian McKellen) has drifted into a cluttered, self-imposed seclusion. His two estranged children (James Corden, Jessica Gunning) enlist Lori (Michaela Coel), a young painter and sometime-forger, to pose as a prospective assistant and gain access to a fabled series of unfinished canvases Julian has buried deep in his home studio, in a deceptive bid to secure an inheritance for themselves. \",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Christophers\",\"synopsis\":\"A mainstay of the London art scene since his starry breakout in the creative explosion of the 1960’s, Julian Sklar (Ian McKellen) has drifted into a cluttered, self-imposed seclusion. His two estranged children (James Corden, Jessica Gunning) enlist Lori (Michaela Coel), a young painter and sometime-forger, to pose as a prospective assistant and gain access to a fabled series of unfinished canvases Julian has buried deep in his home studio, in a deceptive bid to secure an inheritance for themselves. \",\"certificate\":\"15\",\"casting\":[\"Ian McKellen\",\"Michaela Coel\",\"James Corden\",\"Jessica Gunning\"],\"direction\":[\"Steven Soderbergh\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/51/0d/510de593a71359952f2fa969ae5da6c4.jpg\",\"https://all.web.img.acsta.net/img/0e/aa/0eaac12cda673ac31d79774d3d2aba36.jpg\",\"https://all.web.img.acsta.net/img/07/1d/071df4c642aa6caeee917e84b955986d.jpg\",\"https://all.web.img.acsta.net/img/f0/48/f048924f3e81a72319f5aaa05ee424a7.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/19069cd4bc2b2dd3c620eb4143ceabd7.jpg\"],\"release\":\"2026-05-15T00:00:00.000Z\",\"advisory\":\"very strong language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Picturehouse Entertainment\"}},{\"id\":\"1000015811\",\"title\":\"The Debut\",\"runtime\":null,\"genres\":\"Musical, Comedy\",\"__typename\":\"Movie\",\"altId\":[\"380964\"],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/066f8433453569d31c6a027f0cd687b3.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"releases\":[],\"directors\":{\"__typename\":\"C