\":\"949-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"949-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"949-77-HO00008916\"},{\"id\":\"949-103950\",\"schedule\":{\"businessDate\":\"2026-07-18\",\"startsAt\":\"2026-07-18T22:30:00+01:00\",\"endsAt\":\"2026-07-19T01:48:00+01:00\",\"filmStartsAt\":\"2026-07-18T22:55:00+01:00\",\"filmEndsAt\":\"2026-07-19T01:48:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"949-7-97\",\"filmId\":\"HO00008916\",\"siteId\":\"949\",\"screenId\":\"949-7\",\"areaCategories\":[{\"areaCategoryId\":\"949-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000145\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"949-77-HO00008916\"}],\"relatedData\":{\"sites\":[{\"id\":\"949\",\"name\":{\"text\":\"Lee Valley\",\"translations\":[]},\"location\":{\"latitude\":51.6329,\"longitude\":-0.0373},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.LeeValley@OdeonUK.com\",\"address\":{\"line1\":\"Picketts Lock Lane\",\"line2\":\"Edmonton\",\"city\":\"Lee Valley\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008201\",\"title\":{\"text\":\"GOAT\",\"translations\":[]},\"synopsis\":{\"text\":\"From Sony Pictures Animation, the studio behind Spider-Man TM: Across the Spider-Verse and the artists that made KPop Demon Hunters, comes GOAT, an original action-comedy set in an all-animal world. The story follows Will, a small goat with big dreams who gets a once-in-a-lifetime shot to join the pros and play roarball–a high-intensity, co-ed, full-contact sport dominated by the fastest, fiercest animals in the world. Will’s new teammates aren’t thrilled about having a little goat on their roster, but Will is determined to revolutionize the sport and prove once and for all that “smalls can ball!”\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Sony Pictures Animation, the studio behind Spider-Man TM: Across the Spider-Verse and the artists that made KPop Demon Hunters, comes GOAT, an original action-comedy\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild violence, rude humour, language\",\"translations\":[]},\"releaseDate\":\"2026-06-12\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=kmY-rYS7yng\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000119\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002189\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006525\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009120\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011153\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011459\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017374\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017375\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017376\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017377\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017378\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017379\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017380\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017381\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017382\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017383\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017384\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"9353\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000017\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001297\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"fd3ddcc6-e405-4e1f-89d5-5330b8b46da1\",\"corporateId\":null},\"hopk\":\"HO00008201\",\"hoCode\":\"A000009293\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008916\",\"title\":{\"text\":\"The Odyssey\",\"translations\":[]},\"synopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. The film brings Homer’s foundational saga to IMAX® film screens for the first time. \\n\\nThe Odyssey stars Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson and Lupita Nyong’o, with Zendaya and Charlize Theron.\\n\\nThe Odyssey is produced by Emma Thomas and Christopher Nolan for their company, Syncopy. The executive producer is Thomas Hayslip.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":173,\"trailerUrl\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000008\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000150\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000155\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000018948\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000018\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000064\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000267\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002248\",\"roles\":[\"Actor