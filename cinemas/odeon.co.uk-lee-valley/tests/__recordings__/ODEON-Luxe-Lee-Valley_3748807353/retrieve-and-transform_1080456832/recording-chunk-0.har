          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-11-19\",\"showtimes\":[{\"id\":\"949-105753\",\"schedule\":{\"businessDate\":\"2026-11-19\",\"startsAt\":\"2026-11-19T15:45:00+00:00\",\"endsAt\":\"2026-11-19T18:26:00+00:00\",\"filmStartsAt\":\"2026-11-19T16:10:00+00:00\",\"filmEndsAt\":\"2026-11-19T18:26:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"949-8-108\",\"filmId\":\"HO00009162\",\"siteId\":\"949\",\"screenId\":\"949-8\",\"areaCategories\":[{\"areaCategoryId\":\"949-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"949-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"949-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"949-105754\",\"schedule\":{\"businessDate\":\"2026-11-19\",\"startsAt\":\"2026-11-19T19:00:00+00:00\",\"endsAt\":\"2026-11-19T21:41:00+00:00\",\"filmStartsAt\":\"2026-11-19T19:25:00+00:00\",\"filmEndsAt\":\"2026-11-19T21:41:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"949-8-108\",\"filmId\":\"HO00009162\",\"siteId\":\"949\",\"screenId\":\"949-8\",\"areaCategories\":[{\"areaCategoryId\":\"949-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"949-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"949-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"949\",\"name\":{\"text\":\"Lee Valley\",\"translations\":[]},\"location\":{\"latitude\":51.6329,\"longitude\":-0.0373},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.LeeValley@OdeonUK.com\",\"address\":{\"line1\":\"Picketts Lock Lane\",\"line2\":\"Edmonton\",\"city\":\"Lee Valley\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00009162\",\"title\":{\"text\":\"GIANT – The Play \",\"translations\":[]},\"synopsis\":{\"text\":\"GIANT, the 5-star critically acclaimed play starring John Lithgow (Killers of the Flower Moon, The Crown) as Roald Dahl, comes to the big screen. Winner of 3 Olivier Awards® including Best Play and a Tony Award® for Best Actor in a Play (John Lithgow), the production was filmed live in London’s West End ahead of its sold-out Broadway run. The stellar cast includes Aya Cash (The Boys, The Franchise, You’re the Worst), Elliot Levey (Cold War, Patriots, Good) and Rachael Stirling (The Divine Mrs S).\\n\\nA world-famous children’s author under threat. A battle of wills in the wake of scandal. And one chance to make amends...It’s the summer of 1983, The Witches is about to hit the shelves and Roald Dahl is making last-minute edits.  But the outcry at his recent, explicitly antisemitic article won’t die down. Across a single afternoon at his family home, and rocked by an unexpectedly explosive confrontation, Dahl is forced to choose: make a public apology or risk his name and reputation. Inspired by real events, GIANT explores with dark humour the difference between considered opinion and dangerous rhetoric offering a complicated portrait of a fiendishly charismatic icon. \\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A world-famous children’s author under threat. A battle of wills in the wake of scandal. And one chance to make amends...\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-11-19\",\"runtimeInMinutes\":136,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007372\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019519\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019520\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000446\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000899\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000039\"],\"externalIds\":{\"moviexchangeReleaseId\":\"973a9e31-7311-4dd9-aefe-d46b5e1b78a4\",\"corporateId\":null},\"hopk\":\"HO00009162\",\"hoCode\":\"A000010330\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000007372\",\"name\":{\"givenName\":\"Elliot \",\"familyName\":\"Levey\",\"middleName\":null}},{\"id\":\"0000019519\",\"name\":{\"givenName\":\"Aya\",\"familyName\":\"Cash\",\"middleName\":null}},{\"id\":\"0000019520\",\"name\":{\"givenName\":\"Rachael\",\"familyName\":\"Stirling\",\"middleName\":null}},{\"id\":\"HO00000446\",\"name\":{\"givenName\":\"Nicholas \",\"familyName\":\"Hytner\",\"middleName\":null}},{\"id\":\"HO00000899\",\"name\":{\"givenName\":\"John\",\"familyName\":\"Lithgow\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000039\",\"name\":{\"text\":\"Live Theatre\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true},{\"id\":\"0000000143\",\"name\":{\"text\":\"ODEON Luxe\",\"translations\":[]},\"shortName\":{\"text\":\"ODEON Luxe\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":10,\"isPromoted\":false},{\"id\":\"0000000030\",\"name\":{\"text\":\"Wheelchair Accessible\",\"translations\":[]},\"shortName\":{\"text\":\"Wheelchair\",\"translations\":[]},\"description\":{\"text\":\"This auditorium has bays for wheelchair users with seats beside them for accompanying guests.\",\"translations\