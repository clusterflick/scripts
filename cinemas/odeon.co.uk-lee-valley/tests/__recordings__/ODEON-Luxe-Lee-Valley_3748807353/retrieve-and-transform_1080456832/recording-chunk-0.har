          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-05-28\",\"showtimes\":[{\"id\":\"949-93382\",\"schedule\":{\"businessDate\":\"2026-05-28\",\"startsAt\":\"2026-05-28T19:00:00+01:00\",\"endsAt\":\"2026-05-28T21:55:00+01:00\",\"filmStartsAt\":\"2026-05-28T19:25:00+01:00\",\"filmEndsAt\":\"2026-05-28T21:55:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"949-2-87\",\"filmId\":\"HO00008185\",\"siteId\":\"949\",\"screenId\":\"949-2\",\"areaCategories\":[{\"areaCategoryId\":\"949-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"949-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"949-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"949\",\"name\":{\"text\":\"Lee Valley\",\"translations\":[]},\"location\":{\"latitude\":51.6329,\"longitude\":-0.0373},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.LeeValley@OdeonUK.com\",\"address\":{\"line1\":\"Picketts Lock Lane\",\"line2\":\"Edmonton\",\"city\":\"Lee Valley\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008185\",\"title\":{\"text\":\"NT Live: The Playboy of the Western World\",\"translations\":[]},\"synopsis\":{\"text\":\"Nicola Coughlan (Bridgerton) joins Éanna Hardwicke (The Sixth Commandment) and Siobhán McSweeney (Derry Girls) in John Millington Synge’s riveting play of youth and self-discovery. Pegeen Flaherty’s life is turned upside down when a young man walks into her pub claiming that he’s killed his father. Instead of being shunned, the killer becomes a local hero and begins to win hearts, that is until a second man unexpectedly arrives on the scene… Filmed live on stage at the National Theatre, Caitríona McLaughlin directs this darkly funny tale full to the brim with secrets.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Nicola Coughlan joins Éanna Hardwicke and Siobhán McSweeney in John Millington Synge’s riveting play of youth and self-discovery.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-05-28\",\"runtimeInMinutes\":150,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000008888\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011459\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017349\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017350\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000039\"],\"externalIds\":{\"moviexchangeReleaseId\":\"578868e2-3a8c-4292-8cfa-898c6a412e86\",\"corporateId\":null},\"hopk\":\"HO00008185\",\"hoCode\":\"A000009277\",\"eventId\":\"0000000001\",\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"0000008888\",\"name\":{\"givenName\":\"Éanna\",\"familyName\":\"Hardwicke\",\"middleName\":null}},{\"id\":\"0000011459\",\"name\":{\"givenName\":\"Nicola\",\"familyName\":\"Coughlan\",\"middleName\":null}},{\"id\":\"0000017349\",\"name\":{\"givenName\":\"Siobhán\",\"familyName\":\"McSweeney\",\"middleName\":null}},{\"id\":\"0000017350\",\"name\":{\"givenName\":\"Caitríona\",\"familyName\":\"McLaughlin\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000039\",\"name\":{\"text\":\"Live Theatre\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true},{\"id\":\"0000000143\",\"name\":{\"text\":\"ODEON Luxe\",\"translations\":[]},\"sho