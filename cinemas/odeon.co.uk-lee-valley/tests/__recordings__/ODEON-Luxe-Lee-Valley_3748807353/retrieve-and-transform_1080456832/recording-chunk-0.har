            "text": "{\"businessDate\":\"2026-07-28\",\"showtimes\":[{\"id\":\"949-105059\",\"schedule\":{\"businessDate\":\"2026-07-28\",\"startsAt\":\"2026-07-28T18:45:00+01:00\",\"endsAt\":\"2026-07-28T20:40:00+01:00\",\"filmStartsAt\":\"2026-07-28T19:10:00+01:00\",\"filmEndsAt\":\"2026-07-28T20:40:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"949-8-100\",\"filmId\":\"HO00009107\",\"siteId\":\"949\",\"screenId\":\"949-8\",\"areaCategories\":[{\"areaCategoryId\":\"949-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"949-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"949-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000187\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"949\",\"name\":{\"text\":\"Lee Valley\",\"translations\":[]},\"location\":{\"latitude\":51.6329,\"longitude\":-0.0373},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.LeeValley@OdeonUK.com\",\"address\":{\"line1\":\"Picketts Lock Lane\",\"line2\":\"Edmonton\",\"city\":\"Lee Valley\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00009107\",\"title\":{\"text\":\"WHAM! 10 Days in China\",\"translations\":[]},\"synopsis\":{\"text\":\"In 1985, WHAM! made history as the first Western pop act to perform in communist China. George Michael and Andrew Ridgeley’s concerts in Beijing and Guangzhou were a cultural milestone – East meets West, music meets politics. Now, newly restored footage reveals the untold story of the iconic tour that helped launch WHAM! to global superstardom.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In 1985, WHAM! crossed cultural divides as the first Western pop act in China. Previously unseen, beautifully restored archive footage reveals this landmark meeting\",\"translations\":[]},\"censorRatingId\":\