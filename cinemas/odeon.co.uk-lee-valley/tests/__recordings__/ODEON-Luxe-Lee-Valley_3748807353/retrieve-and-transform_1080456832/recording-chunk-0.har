00000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"949-95115\",\"schedule\":{\"businessDate\":\"2026-02-07\",\"startsAt\":\"2026-02-07T23:20:00+00:00\",\"endsAt\":\"2026-02-08T01:38:00+00:00\",\"filmStartsAt\":\"2026-02-07T23:45:00+00:00\",\"filmEndsAt\":\"2026-02-08T01:38:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"949-7-97\",\"filmId\":\"HO00008310\",\"siteId\":\"949\",\"screenId\":\"949-7\",\"areaCategories\":[{\"areaCategoryId\":\"949-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000145\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"949\",\"name\":{\"text\":\"Lee Valley\",\"translations\":[]},\"location\":{\"latitude\":51.6329,\"longitude\":-0.0373},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.LeeValley@OdeonUK.com\",\"address\":{\"line1\":\"Picketts Lock Lane\",\"line2\":\"Edmonton\",\"city\":\"Lee Valley\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007906\",\"title\":{\"text\":\"Pets on a Train\",\"translations\":[]},\"synopsis\":{\"text\":\"When a train unexpectedly starts up, taking only pets with it, the animals discover that Hans, a badger with a grudge is behind it all. While the crash seems inevitable, the animals can count on Falcon, a roguish Raccoon who will do anything to save them.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When a train unexpectedly starts up, taking only pets with it, the animals discover that Hans, a badger with a grudge is behind it all. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat, violence\",\"translations\":[]},\"releaseDate\":\"2025-10-17\",\"runtimeInMinutes\":87,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007897\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011289\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016735\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016736\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016737\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016738\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016739\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016740\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016741\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016742\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"3418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3421\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"935c9fba-f565-4c62-b794-11566b818ecc\",\"corporateId\":null},\"hopk\":\"HO00007906\",\"hoCode\":\"A000008977\",\"eventId\":null,\"distributorName\":\"ALTITUDE\"},{\"id\":\"HO00008201\",\"title\":{\"text\":\"GOAT\",\"translations\":[]},\"synopsis\":{\"text\":\"From Sony Pictures Animation, the studio behind Spider-Man TM: Across the Spider-Verse and the artists that made KPop Demon Hunters, comes GOAT, an original action-comedy set in an all-animal world. The story follows Will, a small goat with big dreams who gets a once-in-a-lifetime shot to join the pros and play roarball–a high-intensity, co-ed, full-contact sport dominated by the fastest, fiercest animals in the world. Will’s new teammates aren’t thrilled about having a little goat on their roster, but Will is determined to revolutionize the sport and prove once and for all that “smalls can ball!”\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Sony Pictures Animation, the studio behind Spider-Man TM: Across the Spider-Verse and the artists that 