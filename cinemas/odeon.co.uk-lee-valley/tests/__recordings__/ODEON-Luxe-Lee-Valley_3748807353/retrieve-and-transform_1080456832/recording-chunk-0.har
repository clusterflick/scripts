7-97\",\"filmId\":\"HO00008916\",\"siteId\":\"949\",\"screenId\":\"949-7\",\"areaCategories\":[{\"areaCategoryId\":\"949-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000145\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"949-77-HO00008916\"},{\"id\":\"949-103895\",\"schedule\":{\"businessDate\":\"2026-07-20\",\"startsAt\":\"2026-07-20T19:00:00+01:00\",\"endsAt\":\"2026-07-20T22:18:00+01:00\",\"filmStartsAt\":\"2026-07-20T19:25:00+01:00\",\"filmEndsAt\":\"2026-07-20T22:18:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"949-6-107\",\"filmId\":\"HO00008916\",\"siteId\":\"949\",\"screenId\":\"949-6\",\"areaCategories\":[{\"areaCategoryId\":\"949-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"949-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"949-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000143\",\"0000000008\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"949-77-HO00008916\"},{\"id\":\"949-103956\",\"schedule\":{\"businessDate\":\"2026-07-20\",\"startsAt\":\"2026-07-20T20:00:00+01:00\",\"endsAt\":\"2026-07-20T23:18:00+01:00\",\"filmStartsAt\":\"2026-07-20T20:25:00+01:00\",\"filmEndsAt\":\"2026-07-20T23:18:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"949-7-97\",\"filmId\":\"HO00008916\",\"siteId\":\"949\",\"screenId\":\"949-7\",\"areaCategories\":[{\"areaCategoryId\":\"949-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000145\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRu