\":[]},\"shortSynopsis\":{\"text\":\"Nicola Coughlan joins Éanna Hardwicke and Siobhán McSweeney in John Millington Synge’s riveting play of youth and self-discovery.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-05-28\",\"runtimeInMinutes\":150,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000008888\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011459\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017349\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017350\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000039\"],\"externalIds\":{\"moviexchangeReleaseId\":\"578868e2-3a8c-4292-8cfa-898c6a412e86\",\"corporateId\":null},\"hopk\":\"HO00008185\",\"hoCode\":\"A000009277\",\"eventId\":\"0000000001\",\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"0000008888\",\"name\":{\"givenName\":\"Éanna\",\"familyName\":\"Hardwicke\",\"middleName\":null}},{\"id\":\"0000011459\",\"name\":{\"givenName\":\"Nicola\",\"familyName\":\"Coughlan\",\"middleName\":null}},{\"id\":\"0000017349\",\"name\":{\"givenName\":\"Siobhán\",\"familyName\":\"McSweeney\",\"middleName\":null}},{\"id\":\"0000017350\",\"name\":{\"givenName\":\"Caitríona\",\"familyName\":\"McLaughlin\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000039\",\"name\":{\"text\":\"Live Theatre\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true},{\"id\":\"0000000143\",\"name\":{\"text\":\"ODEON Luxe\",\"translations\":[]},\"sho