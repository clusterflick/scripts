26-02-02T23:40:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"949-12-96\",\"filmId\":\"HO00008325\",\"siteId\":\"949\",\"screenId\":\"949-12\",\"areaCategories\":[{\"areaCategoryId\":\"949-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"949-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"949-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000187\",\"0000000143\",\"0000000022\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"949\",\"name\":{\"text\":\"Lee Valley\",\"translations\":[]},\"location\":{\"latitude\":51.6329,\"longitude\":-0.0373},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.LeeValley@OdeonUK.com\",\"address\":{\"line1\":\"Picketts Lock Lane\",\"line2\":\"Edmonton\",\"city\":\"Lee Valley\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00000164\",\"title\":{\"text\":\"Scream Unseen (2 February)\",\"translations\":[]},\"synopsis\":{\"text\":\"Screen Unseen's terrifying little sister...\\r\\n\\r\\nODEON Scream Unseen offers an exclusive screening with a twist!  Just like Screen Unseen, you book in advance not knowing what you’re watching until it starts – but this time, not only will you be the first cinema audience to see it, we aim to scare your socks off! \\r\\n\\r\\nLooking for something to quench your horror thirst? See pre-release screenings from just £6*\\r\\n\\r\\nMake sure you keep an eye on Facebook and Twitter for clues and hints on the spine-chilling, pre-release film we will be showcasing.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"ODEON Scream Unseen offers an exclusive screening with a twist!  Just like Screen Unseen, you book in advance not knowing what you’re watching until it starts \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":null,\"releaseDate\":\"20