          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 4677,
            "text": "{\"businessDate\":\"2025-09-11\",\"showtimes\":[{\"id\":\"SOH1-50091\",\"schedule\":{\"businessDate\":\"2025-09-11\",\"startsAt\":\"2025-09-11T18:00:00+01:00\",\"endsAt\":\"2025-09-11T20:03:00+01:00\",\"filmStartsAt\":\"2025-09-11T18:25:00+01:00\",\"filmEndsAt\":\"2025-09-11T20:03:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"SOH1-1-10\",\"filmId\":\"HO00001735\",\"siteId\":\"SOH1\",\"screenId\":\"SOH1-1\",\"areaCategories\":[{\"areaCategoryId\":\"SOH1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"SOH1-2-HO00001735\"}],\"relatedData\":{\"sites\":[{\"id\":\"SOH1\",\"name\":{\"text\":\"Soho\",\"translations\":[]},\"location\":{\"latitude\":51.5128,\"longitude\":-0.1305},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00001735\",\"title\":{\"text\":\"Film Club: Beach Rats\",\"translations\":[]},\"synopsis\":{\"text\":\"On the outskirts of Brooklyn, Frankie, an aimless teenager, suffocates under the oppressive glare cast by his family and a toxic group of delinquent friends. Struggling with his own identity, Frankie begins to scour hookup sites for older men. When his chatting and webcamming intensify, he begins meeting men at a nearby cruising beach while simultaneously entering into a cautious relationship with a young woman. As Frankie struggles to reconcile his competing desires, his decisions leave him hurtling toward irreparable consequences. Eliza Hittman’s award-winning Sundance hit is a powerful character study that is as visually stunning as it is evocative.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"An aimless teenager on the outer edges of Brooklyn struggles to escape his bleak home life and navigate questions of self-identity.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong sex, nudity, drug misuse, language\",\"translations\":[]},\"releaseDate\":\"2025-08-24\",\"runtimeInMinutes\":98,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002419\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004974\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005952\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010026\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011337\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011338\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011339\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011340\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00001735\",\"hoCode\":\"A000002226\",\"eventId\":null,\"distributorName\":\"Peccadillo Pictures\"}],\"castAndCrew\":[{\"id\":\"0000002419\",\"name\":{\"givenName\":\"Harris\",\"familyName\":\"Dickinson\",\"middleName\":null}},{\"id\":\"0000004974\",\"name\":{\"givenName\":\"Andrew \",\"familyName\":\"Goldman\",\"middleName\":null}},{\"id\":\"0000005952\",\"name\":{\"givenName\":\"Brad \",\"familyName\":\"Becker-Parton\",\"middleName\":null}},{\"id\":\"0000010026\",\"name\":{\"givenName\":\"Neal\",\"familyName\":\"Huff\",\"middleName\":null}},{\"id\":\"0000011337\",\"name\":{\"givenName\":\"Madeline\",\"familyName\":\"Weinstein\",\"middleName\":null}},{\"id\":\"0000011338\",\"name\":{\"givenName\":\"Kate\",\"familyName\":\"Hodge\",\"middleName\":null}},{\"id\":\"0000011339\",\"name\":{\"givenName\":\"Frank\",\"familyName\":\"Hakaj\",\"middleName\":null}},{\"id\":\"0000011340\",\"name\":{\"givenName\":\"Eliza\",\"familyName\":\"Hittman\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\