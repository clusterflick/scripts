            "text": "{\"name\":\"Soho\",\"urlSegment\":\"soho\",\"url\":\"/venues/soho/\",\"nodeId\":1812,\"alias\":\"cinema\",\"createDate\":\"2024-08-13T14:58:40\\u002B01:00\",\"updateDate\":\"2025-06-24T08:25:12\\u002B01:00\",\"robotsNoIndex\":false,\"robotsNoFollow\":false,\"masterCanonicalUrl\":null,\"excludeCanonicalUrl\":false,\"seoImage\":null,\"metaKeywords\":\"\",\"metaDescription\":\"Find out what\\u0027s on at Curzon Cinema in Soho. Check out the latest blockbuster movies, new Indie film releases and the best of world cinema out now.\",\"seoPageTitle\":\"Curzon Soho Cinema Showtimes \\u0026 Film Listings\",\"oGType\":\"\",\"twitterCard\":\"\",\"seoUrl\":\"\",\"oGLocale\":\"\",\"excludeFromXmlSitemap\":false,\"excludeFromSiteSearch\":false,\"pageTitle\":\"Curzon Soho Cinema Showtimes \\u0026 Film Listings\",\"hideTitle\":false,\"grid\":[{\"name\":\"gridCarouselQuotes\",\"columns\":[{\"size\":12,\"elements\":[{\"type\":\"gridCarouselQuotes\",\"value\":[{\"stars\":5,\"quoteHeadline\":\"On every level this is the perfect cinema experience.\",\"subHeadline\":\"Sleazy Michael, google reviews\",\"backgroundColour\":{\"color\":\"ff8200\",\"label\":\"orange\"}},{\"stars\":5,\"quoteHeadline\":\"What a beautiful cinema ! So nicely decorated, very comfy and so perfectly located.\",\"subHeadline\":\"Claire Vernade, google reviews\",\"backgroundColour\":{\"color\":\"f6eb61\",\"label\":\"yellow\"}}],\"config\":{\"background\":null,\"fullWidth\":false,\"wideBackground\":false}}],\"config\":{}}],\"config\":{\"background\":null,\"fullWidth\":false,\"wideBackground\":false}}],\"redirectDetailsElement\":{\"redirect\":false,\"permanent\":false},\"heroCarouselDetailsElement\":[{\"image\":{\"mobile\":\"/media/mu0hr43q/soho3.jpg?width=393\\u0026height=169\\u0026v=1dbb9f206382a90\",\"tablet\":\"/media/mu0hr43q/soho3.jpg?width=782\\u0026height=315\\u0026v=1dbb9f206382a90\",\"desktop\":\"/media/mu0hr43q/soho3.jpg?width=1216\\u0026height=523\\u0026v=1dbb9f206382a90\",\"alt\":\"\"},\"textHeading\":\"WELCOME TO CURZON SOHO\",\"actionLink\":{\"name\":\"take a tour\",\"target\":\"_blank\",\"url\":\"https://tours.360virtualtours.co.uk/curzon/soho/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=393\\u0026height=169\\u0026v=1dbe4e025633ef0\",\"tablet\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=782\\u0026height=315\\u0026v=1dbe4e025633ef0\",\"desktop\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=1216\\u0026height=523\\u0026v=1dbe4e025633ef0\",\"alt\":\"\"},\"textHeading\":\"Support Stonewall on your Curzon cinema visit\",\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/pjsj0oss/pepperoni.jpg?width=393\\u0026height=169\\u0026v=1daf1d80a3f4700\",\"tablet\":\"/media/pjsj0oss/pepperoni.jpg?width=782\\u0026height=315\\u0026v=1daf1d80a3f4700\",\"desktop\":\"/media/pjsj0oss/pepperoni.jpg?width=1216\\u0026height=523\\u0026v=1daf1d80a3f4700\",\"alt\":\"\"},\"textHeading\":\"Food and drink\",\"actionLink\":{\"name\":\"View Menu\",\"target\":\"_blank\",\"url\":\"https://www.curzon.com/media/j10nivdb/menu-2.pdf\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/jbfp1kkb/ph-soho-1.jpg?width=393\\u0026height=169\\u0026v=1dbba9da5c255d0\",\"tablet\":\"/media/jbfp1kkb/ph-soho-1.jpg?width=782\\u0026height=315\\u0026v=1dbba9da5c255d0\",\"desktop\":\"/media/jbfp1kkb/ph-soho-1.jpg?width=1216\\u0026height=523\\u0026v=1dbba9da5c255d0\",\"alt\":\"\"},\"textHeading\":\"HIRE THIS SPACE\",\"actionLink\":{\"name\":\"HIRE THIS SPACE\",\"url\":\"/private-hire/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/xqsg54da/soho1.jpg?width=393\\u0026height=169\\u0026v=1dbba9dcc33a4d0\",\"tablet\":\"/media/xqsg54da/soho1.jpg?width=782\\u0026height=315\\u0026v=1dbba9dcc33a4d0\",\"desktop\":\"/media/xqsg54da/soho1.jpg?width=1216\\u0026height=523\\u0026v=1dbba9dcc33a4d0\",\"alt\":\"\"}},{\"image\":{\"mobile\":\"/media/yzehnils/cocktail-image.webp?width=393\\u0026height=169\\u0026v=1daf1d80a3a3df0\",\"tablet\":\"/media/yzehnils/cocktail-image.webp?width=782\\u0026height=315\\u0026v=1daf1d80a3a3df0\",\"desktop\":\"/media/yzehnils/cocktail-image.webp?width=1216\\u0026height=523\\u0026v=1daf1d80a3a3df0\",\"alt\":\"\"}},{\"image\":{\"mobile\":\"/media/3cmboqh5/soho2.jpg?width=393\\u0026height=169\\u0026v=1dbba9dda7abbf0\",\"tablet\":\"/media/3cmboqh5/soho2.jpg?width=782\\u0026height=315\\u0026v=1dbba9dda7abbf0\",\"desktop\":\"/media/3cmboqh5/soho2.jpg?width=1216\\u0026height=523\\u0026v=1dbba9dda7abbf0\",\"alt\":\"\"}}],\"cinemaLocationDetailsElement\":{\"venueCardImage\":{\"mobile\":\"/media/2nql534x/cinema-venues-_soho.jpg?width=300\\u0026height=160\\u0026v=1db998a5211dac0\",\"alt\":\"\"},\"addressLine1\":\" 99 Shaftesbury Avenue\",\"city\":\"London\",\"postcode\":\"W1D 5DY\",\"nearestStationName\":\"Leicester Square\",\"nearestStationType\":\"underground\"},\"vistaCinema\":{\"key\":\"SOH1\",\"value\":\"Soho\"},\"informationTabAccordions\":[{\"heading\":\"Opening times\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EMonday to Saturday:\\u003C/strong\\u003E 10am\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESunday: \\u003C/strong\\u003E10.30am\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cem\\u003EPlease be aware opening and closing times may be subject to change.\\u003C/em\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Screen info\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 1\\u003Cbr\\u003E\\u003C/strong\\u003E249 seats, 2 wheelchair spaces (in the middle)\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 2\\u003Cbr\\u003E\\u003C/strong\\u003E72 seats, 1 wheelchair space (at the front)\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 3\\u003Cbr\\u003E\\u003C/strong\\u003E81 seats, 1 wheelchair space (at the back)\\u003C/p\\u003E\"},{\"heading\":\"Accessibility\",\"body\":\"\\u003Cp\\u003EAll screens are accessible by lift, and each one has one wheelchair space each. There is a wheelchair-accessible bathroom.\\u003C/p\\u003E\"},{\"heading\":\"Food and Drink\",\"body\":\"\\u003Cp\\u003EFresh coffee, teas and cakes alongside an all-day menu of caf\\u00E9 and bar food with vegan and vegetarian options available. The drinks menu includes a wide selection of cocktails, wine, craft beer and soft drinks.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022https://www.curzon.com/media/j10nivdb/menu-2.pdf\\u0022 target=\\u0022_blank\\u0022 title=\\u0022View Menu\\u0022\\u003ESee our full menu here.\\u003C/a\\u003E\\u003C/span\\u003E\\u003C/p\\u003E\"},{\"heading\":\"HAPPY HOUR INFORMATION\",\"body\":\"\\u003Cp\\u003EAt this venue Happy Hour is all day: 2 for \\u00A316 on all cocktails.\\u003C/p\\u003E\"},{\"heading\":\"Private hires\",\"body\":\"\\u003Cp\\u003EOur screens are available to rent for your private functions, email \\u003Ca href=\\u0022mailto:privatehires@curzon.com\\u0022\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003Eprivatehires@curzon.com\\u003C/span\\u003E\\u003C/a\\u003E for more information.\\u003C/p\\u003E\\n\\u003Cp\\u003ETo find out more, visit our \\u003Ca href=\\u0022/private-hire/soho/\\u0022 title=\\u0022Soho Private Hire\\u0022\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003EPrivate Hires page\\u003C/span\\u003E.\\u003C/a\\u003E\\u003C/p\\u003E\"},{\"heading\":\"social media\",\"body\":\"\\u003Cp\\u003EInstagram: \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca href=\\u0022https://www.instagram.com/curzon.soho?igsh=bTVkejM3bWM2NWY2\\u0022 data-anchor=\\u0022?igsh=bTVkejM3bWM2NWY2\\u0022\\u003Ecurzon.soho\\u003C/a\\u003E\\u003C/span\\u003E\\u003C/p\\u003E\"}],\"informationTabDescription\":\"\\u003Cp\\u003EA beloved haunt of filmmakers \\u2013 Andrea Arnold has called it \\u2018the coolest cinema in the world\\u2019 \\u2013 Curzon Soho is our buzzing West End cinema that regularly hosts Q\\u0026amp;As, festival screenings and documentary events. The three-screen venue is steeped in film history and it maintains an easygoing atmosphere in its comfortable caf\\u00E9 and downstairs bar.\\u003C/p\\u003E\",\"menuTabAccordions\":[{\"heading\":\"Pizza\",\"body\":\"\\u003Ctable border=\\u00221\\u0022 style=\\u0022border-collapse: collapse; width: 100%; height: 382px;\\u0022\\u003E\\n\\u003Ctbody\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EMargherita (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A311.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EPepperoni \\u0026amp; Honey\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003E\\u0027Nduja\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EGoat\\u0027s Cheese \\u0026amp; Caramelised Onion (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.80\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EMushroom \\u0026amp; Truffle Oil (V)\\u003C/td\\u003E\