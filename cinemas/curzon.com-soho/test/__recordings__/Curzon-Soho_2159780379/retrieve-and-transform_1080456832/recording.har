            "text": "{\"businessDate\":\"2025-07-24\",\"showtimes\":[{\"id\":\"SOH1-50471\",\"schedule\":{\"businessDate\":\"2025-07-24\",\"startsAt\":\"2025-07-24T18:20:00+01:00\",\"endsAt\":\"2025-07-24T20:25:00+01:00\",\"filmStartsAt\":\"2025-07-24T19:10:00+01:00\",\"filmEndsAt\":\"2025-07-24T20:25:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"SOH1-1-10\",\"filmId\":\"HO00006282\",\"siteId\":\"SOH1\",\"screenId\":\"SOH1-1\",\"areaCategories\":[{\"areaCategoryId\":\"SOH1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000009\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"SOH1\",\"name\":{\"text\":\"Soho\",\"translations\":[]},\"location\":{\"latitude\":51.5128,\"longitude\":-0.1305},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006282\",\"title\":{\"text\":\"Can't Look Away\",\"translations\":[]},\"synopsis\":{\"text\":\"Can't Look Away is a documentary based on investigative reporting by Bloomberg News’ Olivia Carville which takes viewers inside the emotional and legal struggles of families seeking justice for their children harmed by social media platforms. \\r\\n\\r\\nThe film delves into the tactics of major tech companies, the dangers of addictive algorithms, and the urgent need for industry reform to protect vulnerable users. \\r\\n\\r\\nThrough exclusive courtroom footage, interviews with whistleblowers and experts, and deeply personal stories from grieving families, the film is a searing indictment of the systems that prioritize profit over people. \\r\\n\\r\\nExecutive Producer: Kirsten Powers\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Documentary about legal battles of bereaved families against the social 