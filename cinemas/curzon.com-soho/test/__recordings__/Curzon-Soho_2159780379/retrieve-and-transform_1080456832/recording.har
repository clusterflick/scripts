          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 4745,
            "text": "{\"businessDate\":\"2025-07-12\",\"showtimes\":[{\"id\":\"SOH1-50606\",\"schedule\":{\"businessDate\":\"2025-07-12\",\"startsAt\":\"2025-07-12T14:00:00+01:00\",\"endsAt\":\"2025-07-12T17:01:00+01:00\",\"filmStartsAt\":\"2025-07-12T14:50:00+01:00\",\"filmEndsAt\":\"2025-07-12T17:01:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"SOH1-1-10\",\"filmId\":\"HO00006197\",\"siteId\":\"SOH1\",\"screenId\":\"SOH1-1\",\"areaCategories\":[{\"areaCategoryId\":\"SOH1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000018\",\"0000000017\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"SOH1\",\"name\":{\"text\":\"Soho\",\"translations\":[]},\"location\":{\"latitude\":51.5128,\"longitude\":-0.1305},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006197\",\"title\":{\"text\":\"The Piano Teacher Re-Release\",\"translations\":[]},\"synopsis\":{\"text\":\"Academy Award–winning Austrian director Michael Haneke shifted his focus from the social to the psychological for this riveting study of female sexuality and the dynamics of control, an adaptation of a controversial 1983 novel by Elfriede Jelinek. Haneke finds his match in Isabelle Huppert, who delivers an icy but quietly seething performance as Erika, a middle-aged piano professor at a Viennese conservatory who lives with her mother, in a claustrophobically codependent relationship. Severely repressed, she satisfies her masochistic urges only voyeuristically until she meets Walter (Benoît Magimel), a young student whose desire for Erika leads to a destructive infatuation that upsets the careful equilibrium of her life. A critical breakthrough for Haneke, The Piano Teacher—which won the Grand Prix as well as dual acting awards for its stars at Cannes—is a formalist masterwork that remains a shocking sensation.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Academy Award–winning Austrian director Michael Haneke shifted his focus from the social to the psychological for this riveting study of female sexuality.\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":{\"text\":\"Contains strong language, violence, sexual violence, sex and sado-masochism theme\",\"translations\":[]},\"releaseDate\":\"2025-06-06\",\"runtimeInMinutes\":131,\"trailerUrl\":null,\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000258\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002207\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011332\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011333\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011334\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011380\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"051c196f-32eb-430c-b997-8401355bdef3\",\"corporateId\":null},\"hopk\":\"HO00006197\",\"hoCode\":\"A000007652\",\"eventId\":null,\"distributorName\":\"Curzon\"}],\"castAndCrew\":[{\"id\":\"0000000258\",\"name\":{\"givenName\":\"Isabelle\",\"familyName\":\"Huppert\",\"middleName\":null}},{\"id\":\"0000002207\",\"name\":{\"givenName\":\"Benoît\",\"familyName\":\"Magimel\",\"middleName\":null}},{\"id\":\"0000011332\",\"name\":{\"givenName\":\"Annie\",\"familyName\":\"Girardot\",\"middleName\":null}},{\"id\":\"0000011333\",\"name\":{\"givenName\":\"Susanne\",\"familyName\":\"Lothar\",\"middleName\":null}},{\"id\":\"0000011334\",\"name\":{\"givenName\":\"Michael\",\"familyName\":\"Haneke\",\"middleName\":null}},{\"id\":\"0000011380\",\"name\":{\"givenName\":\"Veit\",\"familyName\":\"Heiduschka\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"Drama\",\"