Rule\"],\"filmAdvanceBookingRuleId\":\"SOH1-85-HO00006204\"}],\"relatedData\":{\"sites\":[{\"id\":\"SOH1\",\"name\":{\"text\":\"Soho\",\"translations\":[]},\"location\":{\"latitude\":51.5128,\"longitude\":-0.1305},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006097\",\"title\":{\"text\":\"The Phoenician Scheme\",\"translations\":[]},\"synopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe; Mia Threapleton as Liesl, his daughter/a nun; Michael Cera as Bjorn, their tutor. With: Riz Ahmed, Tom Hanks, Bryan Cranston, Mathieu Amalric, Richard Ayoade, Jeffrey Wright, Scarlett Johansson, Benedict Cumberbatch, Rupert Friend, Hope Davis.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong injury detail\",\"translations\":[]},\"releaseDate\":\"2025-05-23\",\"runtimeInMinutes\":101,\"trailerUrl\":\"https://www.youtube.com/watch?v=qRAnphZLAIg\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001084\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001275\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001395\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001400\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001409\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001410\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001411\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002527\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003325\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005645\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005699\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011116\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011117\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"eff6ffca-db00-4c6f-9e5e-1783c6ace2d7\",\"corporateId\":null},\"hopk\":\"HO00006097\",\"hoCode\":\"A000007517\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006099\",\"title\":{\"text\":\"The Ballad of Wallis Island\",\"translations\":[]},\"synopsis\":{\"text\":\"Eccentric lottery winner Charles dreams of getting his favorite musicians, McGwyer Mortimer, back together. The fantasy becomes real when the bandmates and former lovers agree to play a private show at his home on Wallis Island. Old tensions resurface as Charles tries desperately to salvage his dream gig.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Eccentric lottery winner Charles dreams of getting his favorite musicians, McGwyer Mortimer, back together. \",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"moderate bad language\",\"translations\":[]},\"releaseDate\":\"2025-05-30\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=T9smxlnKNz0\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003501\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003970\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004380\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011120\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011121\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011122\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011123\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4c563f44-cfa4-4914-86b1-b510771045c8\",\"corporateId\":null},\"hopk\":\"HO00006099\",\"hoCode\":\"A000007519\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006199\",\"title\":{\"text\":\"Hidden (Caché)\",\"translations\":[]},\"synopsis\":{\"text\":\"A married couple is terrorized by a series of surveillance videotapes left on their front porch.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A married couple is terrorized by a series of surveillance videotapes left on their front porch.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-20\",\"runtimeInMinutes\":118,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004195\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011332\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011334\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011380\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011394\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011412\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"8d52e414-ea56-449f-949a-6cbcfa55a8b7\",\"corporateId\":null},\"hopk\":\"HO00006199\",\"hoCode\":\"A000007654\",\"eventId\":null,\"distributorName\":\"Curzon\"},{\"id\":\"HO00006203\",\"title\":{\"text\":\"Tornado\",\"translations\":[]},\"synopsis\":{\"text\":\"Set in the rugged landscape of 1790’s Britain, Tornado (played by model-songwriter Koki,) finds herself caught in a perilous situation when she and her father’s travelling puppet show crosses paths with a ruthless criminal gang led by Sugarman (PULP FICTION star Tim Roth) and his ambitious son Little Sugar (SLOW HORSES’ Jack Lowden). In an attempt to create a new life, Tornado seizes the opportunity to steal the gold from the gang’s most recent heist; what follows is a thrilling tale of adrenaline-fueled action as Tornado fights to escape a violent demise.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Set in the rugged landscape of 1790’s Britain, Tornado (played by model-songwriter Koki,) finds herself caught in a perilous situation.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong bloody violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-06-13\",\"runtimeInMinutes\":91,\"trailerUrl\":null,\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003251\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003321\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011415\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011416\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011417\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000252\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000254\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000256\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b32a6015-ac13-48b6-9e04-b64a47c5df98\",\"corporateId\":null},\"hopk\":\"HO00006203\",\"hoCode\":\"A000007659\",\"eventId\":null,\"distributorName\":\"Lionsgate\"},{\"id\":\"HO00006204\",\"title\":{\"text\":\"28 Years Later\",\"translations\":[]},\"synopsis\":{\"text\":\"Academy Award®-winning director Danny Boyle and Academy Award®-nominated writer Alex Garland reunite for 28 Years Later, a terrifying new story set in the world created by 28 Days Later. It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine, some have found ways to exist amidst the infected. One such group of survivors lives on a small island connected to the mainland by a single, heavily-defended causeway. When one of the group leaves the island on a mission into the dark heart of the mainland, he discovers secrets, wonders, and horrors that have mutated not only the infected but other survivors as well.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine...\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-19\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=poEFz8Ivzug\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000313\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001100\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001270\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003206\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003678\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010558\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011257\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000011418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011419\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a7823fd3-66f7-47af-87ba-d36ef45b168c\",\"corporateId\":null},\"hopk\":\"HO00006204\",\"hoCode\":\"A000007660\",\"eventId\":null,\"distributorName\":\"Sony Pictures\"},{\"id\":\"HO00006110\",\"title\":{\"text\":\"F1® The Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career. Thirty years later, he’s a nomadic racer-for-hire when he’s approached by his former teammate Ruben Cervantes (Javier Bardem), owner of a struggling FORMULA 1 team that is on the verge of collapse. Ruben convinces Sonny to come back to FORMULA 1 for one last shot at saving the team and being the best in the world. He’ll drive alongside Joshua Pearce (Damson Idris), the team's hotshot rookie intent on setting his own pace. But as the engines roar, Sonny’s past catches up with him and he finds that in FORMULA 1, your teammate is your fiercest competition—and the road to redemption is not something you can travel alone.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate threat\",\"translations\":[]},\"releaseDate\":\"2025-06-25\",\"runtimeInMinutes\":156,\"trailerUrl\":\"https://www.youtube.com/watch?v=TZGY2CWPXeU\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000166\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000167\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001693\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002986\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003190\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003191\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008544\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008790\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011188\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"903