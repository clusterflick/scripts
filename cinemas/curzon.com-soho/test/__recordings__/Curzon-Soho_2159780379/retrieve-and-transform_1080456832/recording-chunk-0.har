stAndCrewMemberId\":\"12809\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12810\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e033d58e-8545-4f81-a191-03352ebe4cc0\",\"corporateId\":null},\"hopk\":\"HO00006609\",\"hoCode\":\"A000008158\",\"eventId\":null,\"distributorName\":\"Entertainment Film Distributors\"},{\"id\":\"HO00006610\",\"title\":{\"text\":\"Sentimental Value\",\"translations\":[]},\"synopsis\":{\"text\":\"Nora Borg (Renate Reinsve) is an established Oslo stage actress; her younger sister Agnes (Inga Ibsdotter Lilleaas) has chosen family life with her young son. Though markedly different, the two are close and deeply intertwined, having been raised by a single mother after their filmmaker father’s departure years earlier. When the once renowned Gustav (Stellan Skarsgård) attempts to cast Nora in his comeback film, old wounds bleed anew; \\\"Nora rejects his offer, prompting the isolated patriarch to cast American star Rachel Kemp (Elle Fanning), who gradually comes to realize she has unwittingly become part of a deeply personal film drama. Agnes, meanwhile, delves deeper into the family history as Gustav and Nora attempt rapprochement; but the cracks at the base of the family home run deeper than any Borg can grasp, threatening to topple an already shaky foundation.\\r\\n\\r\\nThis special preview is presented in partnership with The Observer and will feature a post-film conversation between film critic Wendy Ide and leading actor Stellan Skarsgård.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Sisters Nora and Agnes reunite with their estranged father, the charismatic Gustav, a once renowned director who offers stage actress Nora a role.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, suicide references\",\"translations\":[]},\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":133,\"trailerUrl\":\"https://www.youtube.com/watch?v=Gb1sSfWb1Og\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001057\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001058\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001695\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002275\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002626\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002629\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002630\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003236\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008105\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012671\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012672\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012673\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012674\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"938\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5b779d8b-e80b-4790-9616-e4b978f19314\",\"corporateId\":null},\"hopk\":\"HO00006610\",\"hoCode\":\"A000008159\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00006758\",\"title\":{\"text\":\"It’s Never Over, Jeff Buckley\",\"translations\":[]},\"synopsis\":{\"text\":\"Never-before-seen footage, exclusive voice messages, and accounts from Jeff Buckley's inner circle paint a captivating portrait of the gifted musician who died tragically in 1997, having only released one album.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Never-before-seen footage, exclusive voice messages, and accounts from Jeff Buckley's inner circle paint a captivating portrait of the gifted musician who died tragically\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-13\",\"runtimeInMinutes\":106,\"trailerUrl\":null,\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000013094\",\"roles