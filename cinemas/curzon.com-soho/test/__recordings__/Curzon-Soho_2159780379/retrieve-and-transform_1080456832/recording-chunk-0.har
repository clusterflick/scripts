}},{\"id\":\"0000012961\",\"name\":{\"givenName\":\"Bim\",\"familyName\":\"Ajadi\",\"middleName\":null}},{\"id\":\"0000012962\",\"name\":{\"givenName\":\"Benedetta\",\"familyName\":\"Fiore\",\"middleName\":null}},{\"id\":\"0000012963\",\"name\":{\"givenName\":\"Edward\",\"familyName\":\"Smyth\",\"middleName\":null}},{\"id\":\"0000012964\",\"name\":{\"givenName\":\"Camilla\",\"familyName\":\"Greenwell\",\"middleName\":null}},{\"id\":\"0000012965\",\"name\":{\"givenName\":\"Hannah\",\"familyName\":\"Palumbo\",\"middleName\":null}},{\"id\":\"0000012966\",\"name\":{\"givenName\":\"Linden\",\"familyName\":\"Feng\",\"middleName\":null}},{\"id\":\"0000001403\",\"name\":{\"givenName\":\"Timothée \",\"familyName\":\"Chalamet\",\"middleName\":null}},{\"id\":\"0000001416\",\"name\":{\"givenName\":\"Anthony\",\"familyName\":\"Katagas\",\"middleName\":null}},{\"id\":\"0000002090\",\"name\":{\"givenName\":\"Eli\",\"familyName\":\"Bush\",\"middleName\":null}},{\"id\":\"0000003985\",\"name\":{\"givenName\":\"Josh\",\"familyName\":\"Safdie\",\"middleName\":null}},{\"id\":\"0000003988\",\"name\":{\"givenName\":\"Ronald\",\"familyName\":\"Bronstein\",\"middleName\":null}},{\"id\":\"0000007063\",\"name\":{\"givenName\":\"Sandra\",\"familyName\":\"Bernhard\",\"middleName\":null}},{\"id\":\"0000007210\",\"name\":{\"givenName\":\"Gwyneth\",\"familyName\":\"Paltrow\",\"middleName\":null}},{\"id\":\"0000011162\",\"name\":{\"givenName\":\"Odessa\",\"familyName\":\"A’zion\",\"middleName\":null}},{\"id\":\"0000011923\",\"name\":{\"givenName\":\"Fran\",\"familyName\":\"Drescher\",\"middleName\":null}},{\"id\":\"12808\",\"name\":{\"givenName\":\"Kevin\",\"familyName\":\"O’Leary\",\"middleName\":null}},{\"id\":\"12809\",\"name\":{\"givenName\":\"Tyler\",\"familyName\":\"Okonma\",\"middleName\":null}},{\"id\":\"12810\",\"name\":{\"givenName\":\"Abel\",\"familyName\":\"Ferrara\",\"middleName\":null}},{\"id\":\"0000001057\",\"name\":{\"givenName\":\"Jonas\",\"familyName\":\"Dornbach\",\"middleName\":null}},{\"id\":\"0000001058\",\"name\":{\"givenName\":\"Janine\",\"familyName\":\"Jackowski\",\"middleName\":null}},{\"id\":\"0000001695\",\"name\":{\"givenName\":\"Stellan \",\"familyName\":\"Skarsgård\",\"middleName\":null}},{\"id\":\"0000002275\",\"name\":{\"givenName\":\"Olivier\",\"familyName\":\"Père\",\"middleName\":null}},{\"id\":\"0000002626\",\"name\":{\"givenName\":\"Renate\",\"familyName\":\"Reinsve\",\"middleName\":null}},{\"id\":\"0000002629\",\"name\":{\"givenName\":\"Joachim \",\"familyName\":\"Trier\",\"middleName\":null}},{\"id\":\"0000002630\",\"name\":{\"givenName\":\"Andrea\",\"familyName\":\"Berentsen Ottmar\",\"middleName\":null}},{\"id\":\"0000003236\",\"name\":{\"givenName\":\"Maria\",\"familyName\":\"Ekerhovd\",\"middleName\":null}},{\"id\":\"0000008105\",\"name\":{\"givenName\":\"Elle\",\"familyName\":\"Fanning\",\"middleName\":null}},{\"id\":\"0000012671\",\"name\":{\"givenName\":\"Elisha\",\"familyName\":\"Karmitz\",\"middleName\":null}},{\"id\":\"0000012672\",\"name\":{\"givenName\":\"Nathanaël\",\"familyName\":\"Karmitz\",\"middleName\":null}},{\"id\":\"0000012673\",\"name\":{\"givenName\":\"Juliette\",\"familyName\":\"Schrameck\",\"middleName\":null}},{\"id\":\"0000012674\",\"name\":{\"givenName\":\"Atilla Salih\",\"familyName\":\"Yücer\",\"middleName\":null}},{\"id\":\"938\",\"name\":{\"givenName\":\"Lizette\",\"familyName\":\"Jonjic\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":{\"text\":\"Drama\",\"translations\":[]}},{\"id\":\"0000000025\",\"name\":{\"text\":\"Animation\",\"translations\":[]},\"description\":null},{\"id\":\"0000000026\",\"name\":{\"text\":\"Crime\",\"translations\":[]},\"description\":null},{\"id\":\"0000000030\",\"name\":{\"text\":\"Horror\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"HO00000004\",\"classification\":{\"text\":\"12A\",\"translations\":[]},\"classificationDescription\":{\"text\":\"12A\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}},{\"id\":\"HO00000005\",\"classification\":{\"text\":\"18\",\"translations\":[]},\"classificationDescription\":{\"text\":\"18\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}},{\"id\":\"HO00000006\",\"classification\":{\"text\":\"15\",\"translations\":[]},\"classificationDescription\":{\"text\":\"15\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000059\",\"name\":{\"text\":\"Awards Season Screening\",\"translations\":[]},\"shortName\":{\"text\":\"Awards\",\"translations\":[]},\"description\":{\"text\":\"Award winning film.\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false},{\"id\":\"0000000055\",\"name\":{\"text\":\"Open Captioned\",\"translations\":[]},\"shortName\":{\"text\":\"Captioned\",\"translations\":[]},\"description\":{\"text\":\"Open captions appear at the bottom of the screen and include both dialogue and sound descriptions. They are visible to everyone in the auditorium.\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false},{\"id\":\"0000000009\",\"name\":{\"text\":\"Screening followed by a Q&A\",\"translations\":[]},\"shortName\":{\"text\":\"Q&A\",\"translations\":[]},\"description\":{\"text\":\"Q&A\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"SOH1-2\",\"name\":{\"text\":\"Screen 2\",\"translations\":[]}},{\"id\":\"SOH1-3\",\"name\":{\"text\":\"Screen 3\",\"translations\":[]}},{\"id\":\"SOH1-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000024\",\"name\":{\"text\":\"London Short Film Festival\",\"translations\":[]},\"shortName\":{\"text\":\"LSFF\",\"translations\":[]},\"description\":{\"text\":\"The UK’s leading short film festival, the London Short Film Festival (LSFF), returns for its 23rd edition from 23 January - 1 February 2026, bringing films and events to London’s iconic cinemas alongside community and creative spaces.\\nLSFF presents the best in independent, boundary-pushing filmmaking from around the world. Showcasing 300 works from new voices, acclaimed directors, and underground discoveries drawn from the archive, the festival spans the full emotional range of short-form cinema. From raw DIY confessionals to bold, cinematic stories, these are films that surprise, unsettle, comfort, and stay with you. LSFF’s special events combine curated programmes with conversations and unique experiences.\\nCinema Remembers What We Forget, the underlying current in this year’s programme, explores how artists confront memory and identity - the fragments that linger beneath the surface: the messy, the emotional, the defiant and the unfiltered. \\n\",\"translations\":[]},\"schedule\":{\"startDate\":\"2026-01-23\",\"endDate\":\"2026-02-01\"},\"siteIds\":[\"SOH1\"]}],\"filmAdvanceBookingRules\":[{\"id\":\"SOH1-114-HO00006679\",\"filmId\":\"HO00006679\",\"siteId\":\"SOH1\",\"bookingPeriods\":[{\"startsAt\":\"2025-12-15T00:01:00+00:00\",\"orderBookingModes\":[\"Paid\",\"Unpaid\",\"UnpaidConfirmed\"],\"restriction\":\"None\",\"rewardId\":null}]},{\"id\":\"SOH1-113-HO00006609\",\"filmId\":\"HO00006609\",\"siteId\":\"SOH1\",\"bookingPeriods\":[{\"startsAt\":\"2025-11-26T00:01:00+00:00\",\"orderBookingModes\":[\"Paid\",\"Unpaid\",\"UnpaidConfirmed\"],\"restriction\":\"None\",\"rewardId\":null}]}],\"areaCategories\":[{\"id\":\"SOH1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
