ivenName\":\"Abel\",\"familyName\":\"Ferrara\",\"middleName\":null}},{\"id\":\"0000001057\",\"name\":{\"givenName\":\"Jonas\",\"familyName\":\"Dornbach\",\"middleName\":null}},{\"id\":\"0000001058\",\"name\":{\"givenName\":\"Janine\",\"familyName\":\"Jackowski\",\"middleName\":null}},{\"id\":\"0000001695\",\"name\":{\"givenName\":\"Stellan \",\"familyName\":\"Skarsgård\",\"middleName\":null}},{\"id\":\"0000002275\",\"name\":{\"givenName\":\"Olivier\",\"familyName\":\"Père\",\"middleName\":null}},{\"id\":\"0000002626\",\"name\":{\"givenName\":\"Renate\",\"familyName\":\"Reinsve\",\"middleName\":null}},{\"id\":\"0000002629\",\"name\":{\"givenName\":\"Joachim \",\"familyName\":\"Trier\",\"middleName\":null}},{\"id\":\"0000002630\",\"name\":{\"givenName\":\"Andrea\",\"familyName\":\"Berentsen Ottmar\",\"middleName\":null}},{\"id\":\"0000003236\",\"name\":{\"givenName\":\"Maria\",\"familyName\":\"Ekerhovd\",\"middleName\":null}},{\"id\":\"0000008105\",\"name\":{\"givenName\":\"Elle\",\"familyName\":\"Fanning\",\"middleName\":null}},{\"id\":\"0000012671\",\"name\":{\"givenName\":\"Elisha\",\"familyName\":\"Karmitz\",\"middleName\":null}},{\"id\":\"0000012672\",\"name\":{\"givenName\":\"Nathanaël\",\"familyName\":\"Karmitz\",\"middleName\":null}},{\"id\":\"0000012673\",\"name\":{\"givenName\":\"Juliette\",\"familyName\":\"Schrameck\",\"middleName\":null}},{\"id\":\"0000012674\",\"name\":{\"givenName\":\"Atilla Salih\",\"familyName\":\"Yücer\",\"middleName\":null}},{\"id\":\"938\",\"name\":{\"givenName\":\"Lizette\",\"familyName\":\"Jonjic\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":{\"text\":\"Drama\",\"translations\":[]}},{\"id\":\"0000000003\",\"name\":{\"text\":\"Comedy\",\"translations\":[]},\"description\":{\"text\":\"Comedy\",\"translations\":[]}},{\"id\":\"0000000026\",\"name\":{\"text\":\"Crime\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"HO00000004\",\"classification\":{\"text\":\"12A\",\"translations\":[]},\"classificationDescription\":{\"text\":\"12A\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}},{\"id\":\"HO00000006\",\"classification\":{\"text\":\"15\",\"translations\":[]},\"classificationDescription\":{\"text\":\"15\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}},{\"id\":\"HO00000005\",\"classification\":{\"text\":\"18\",\"translations\":[]},\"classificationDescription\":{\"text\":\"18\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000059\",\"name\":{\"text\":\"Awards Season Screening\",\"translations\":[]},\"shortName\":{\"text\":\"Awards\",\"translations\":[]},\"description\":{\"text\":\"Award winning film.\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"SOH1-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}},{\"id\":\"SOH1-3\",\"name\":{\"text\":\"Screen 3\",\"translations\":[]}},{\"id\":\"SOH1-2\",\"name\":{\"text\":\"Screen 2\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000024\",\"name\":{\"text\":\"London Short Film Festival\",\"translations\":[]},\"shortName\":{\"text\":\"LSFF\",\"translations\":[]},\"description\":{\"text\":\"The UK’s leading short film festival, the London Short Film Festival (LSFF), returns for its 23rd edition from 23 January - 1 February 2026, bringing films and events to London’s iconic cinemas alongside community and creative spaces.\\nLSFF presents the best in independent, boundary-pushing filmmaking from around the world. Showcasing 300 works from new voices, acclaimed directors, and underground discoveries drawn from the archive, the festival spans the full emotional range of short-form cinema. From raw DIY confessionals to bold, cinematic stories, these are films that surprise, unsettle, comfort, and stay with you. LSFF’s special events combine curated programmes with conversations and unique experiences.\\nCinema Remembers What We Forget, the underlying current in this year’s programme, explores how artists confront memory and identity - the fragments that linger beneath the surface: the messy, the emotional, the defiant and the unfiltered. \\n\",\"translations\":[]},\"schedule\":{\"startDate\":\"2026-01-23\",\"endDate\":\"2026-02-01\"},\"siteIds\":[\"SOH1\"]}],\"filmAdvanceBookingRules\":[{\"id\":\"SOH1-113-HO00006609\",\"filmId\":\"HO00006609\",\"siteId\":\"SOH1\",\"bookingPeriods\":[{\"startsAt\":\"2025-11-26T00:01:00+00:00\",\"orderBookingModes\":[\"Paid\",\"Unpaid\",\"UnpaidConfirmed\"],\"restriction\":\"None\",\"rewardId\":null}]}],\"areaCategories\":[{\"id\":\"SOH1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
