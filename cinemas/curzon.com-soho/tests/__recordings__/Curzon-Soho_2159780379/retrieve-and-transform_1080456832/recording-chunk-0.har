          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-29\",\"showtimes\":[{\"id\":\"SOH1-56468\",\"schedule\":{\"businessDate\":\"2026-08-29\",\"startsAt\":\"2026-08-29T15:00:00+01:00\",\"endsAt\":\"2026-08-29T17:23:00+01:00\",\"filmStartsAt\":\"2026-08-29T15:50:00+01:00\",\"filmEndsAt\":\"2026-08-29T17:23:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"SOH1-3-14\",\"filmId\":\"HO00007036\",\"siteId\":\"SOH1\",\"screenId\":\"SOH1-3\",\"areaCategories\":[{\"areaCategoryId\":\"SOH1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000017\",\"0000000009\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"SOH1\",\"name\":{\"text\":\"Soho\",\"translations\":[]},\"location\":{\"latitude\":51.5127983093262,\"longitude\":-0.130500003695488},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"SOH1@curzon.com\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007036\",\"title\":{\"text\":\"Life Support\",\"translations\":[]},\"synopsis\":{\"text\":\"Since October 2023, Gaza has been sealed from the world-except for one group, international doctors. While global media are barred from reporting and governments look away, doctors breach the blockade and what they find is not just a humanitarian crisis, but a calculated dismantling of life itself.\\n\\nCovering the entire two years of the genocide, their firsthand accounts and visceral footage offer a rare and vital chronicle of the daily struggles of healthcare workers as they navigate bombed-out hospitals, dwindling supplies, starvation and the overwhelming influx of casualties— predominantly women and children.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Since October 2023, Gaza has been sealed from the world-except for one group. International doctors breach the blockade, what they find is not just a humanitarian crisis.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong injury detail, images of real dead bodies, distressing scenes\",\"translations\":[]},\"releaseDate\":\"2026-07-09\",\"runtimeInMinutes\":93,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/b4751505-4b1e-41c8-9475-5541481c6ff5/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=Si8lAPXrh38\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=Si8lAPXrh38\",\"displayPriority\":10,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007830\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014055\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014056\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014057\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014058\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014059\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014060\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014061\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014062\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014064\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014065\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014066\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000014055\"},{\"castAndCrewMemberId\":\"0000014056\"},{\"castAndCrewMemberId\":\"0000014057\"},{\"castAndCrewMemberId\":\"0000014058\"},{\"castAndCrewMemberId\":\"0000014059\"},{\"castAndCrewMemberId\":\"0000014060\"},{\"castAndCrewMemberId\":\"0000014061\"},{\"castAndCrewMemberId\":\"0000014062\"},{\"castAndCrewMemberId\":\"0000014063\"},{\"castAndCrewMemberId\":\"0000014064\"},{\"castAndCrewMemberId\":\"0