          "redirectURL": "",
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-30\",\"showtimes\":[{\"id\":\"SOH1-56478\",\"schedule\":{\"businessDate\":\"2026-08-30\",\"startsAt\":\"2026-08-30T15:00:00+01:00\",\"endsAt\":\"2026-08-30T16:58:00+01:00\",\"filmStartsAt\":\"2026-08-30T15:25:00+01:00\",\"filmEndsAt\":\"2026-08-30T16:58:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"SOH1-1-10\",\"filmId\":\"HO00007223\",\"siteId\":\"SOH1\",\"screenId\":\"SOH1-1\",\"areaCategories\":[{\"areaCategoryId\":\"SOH1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000018\",\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"SOH1\",\"name\":{\"text\":\"Soho\",\"translations\":[]},\"location\":{\"latitude\":51.5127983093262,\"longitude\":-0.130500003695488},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"SOH1@curzon.com\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007223\",\"title\":{\"text\":\"Curzon Film 50: Le Havre\",\"translations\":[]},\"synopsis\":{\"text\":\"Marcel Marx, a former author and a well-known Bohemian, has retreated into a voluntary exile in the port city of Le Havre where he feels he has reached a closer rapport with the people serving them in the occupation of the honourable, but not too profitable, of a shoe-shiner.\\n\\nHe has buried his dreams of a literary breakthrough and lives happily within the triangle of his favourite bar, his work, and his wife Arletty, when fate suddenly throws in his path an underage immigrant refugee from the darkest Africa.\\n\\nAs Arletty at the same time gets seriously ill and is bedridden, Marcel once more has to rise against the cold wall of human indifference with his only weapon of innate optimism and the unwavering solidarity of the community, but against him stands the whole blind machinery of the Western constitutionally governed state, this time represented by the dragnet of the police, moment by moment drawing closer around the refugee boy. It's time for Marcel to polish his shoes and reveal his teeth.\\n\\nAki Kaurismäki's glorious, colourful and deeply humane modern masterpiece champions the downtrodden and celebrates the smaller things that make life worth living.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When an African boy arrives by cargo ship in the port city of Le Havre, an aging shoe shiner takes pity on the child and welcomes him into his home.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":{\"text\":\"Contains infrequent mild language\",\"translations\":[]},\"releaseDate\":\"2012-07-31\",\"runtimeInMinutes\":93,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=yCCuCzqOiHE\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=yCCuCzqOiHE\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007435\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000802\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000803\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000804\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000806\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000807\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"HO00000802\"},{\"castAndCrewMemberId\":\"HO00000803\"},{\"castAndCrewMemberId\":\"HO00000804\"},{\"castAndCrewMemberId\":\"HO00000805\"},{\"castAndCrewMemberId\":\"HO00000806\"},{\"castAndCrewMemberId\":\"HO00000807\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000007435\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000007435\"}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"mov