          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-07-26\",\"showtimes\":[{\"id\":\"SOH1-55893\",\"schedule\":{\"businessDate\":\"2026-07-26\",\"startsAt\":\"2026-07-26T14:00:00+01:00\",\"endsAt\":\"2026-07-26T17:10:00+01:00\",\"filmStartsAt\":\"2026-07-26T14:25:00+01:00\",\"filmEndsAt\":\"2026-07-26T17:10:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"SOH1-1-10\",\"filmId\":\"HO00007106\",\"siteId\":\"SOH1\",\"screenId\":\"SOH1-1\",\"areaCategories\":[{\"areaCategoryId\":\"SOH1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000018\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"SOH1\",\"name\":{\"text\":\"Soho\",\"translations\":[]},\"location\":{\"latitude\":51.5127983093262,\"longitude\":-0.130500003695488},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"SOH1@curzon.com\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007106\",\"title\":{\"text\":\"Film Club: Far From the Madding Crowd\",\"translations\":[]},\"synopsis\":{\"text\":\"To mark the centenary of Academy Award-winning director John Schlesinger's birth, we're inviting you to experience his greatest films on the big screen. Season curated by Claire Nicolas and Marc David Jacobs. \\n\\nFAR FROM THE MADDING CROWD\\nBased on Thomas Hardy's renowned novel, this British drama focuses on Bathsheba Everdene (Julie Christie), a beautiful young woman who inherits a picturesque farm from her uncle and is determined to run it herself. Three very different suitors -- Francis Troy (Terence Stamp), an intense soldier; William Boldwood (Peter Finch), a middle-aged farmer; and Gabriel Oak (Alan Bates), a shepherd of modest means -- all contend for Bathsheba's hand, and conflict is inevitable.\\n\\nSoho screens the film from 35mm. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A beautiful young woman inherits a picturesque farm from her uncle and is determined to run it herself. Three suitors contest for her hand.\",\"translations\":[]},\"censorRatingId\":\"HO00000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-05\",\"runtimeInMinutes\":165,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001791\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010264\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010274\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011662\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013864\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001791\"},{\"castAndCrewMemberId\":\"0000010264\"},{\"castAndCrewMemberId\":\"0000010274\"},{\"castAndCrewMemberId\":\"0000013864\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000011662\"}],\"producers\":[],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007106\",\"hoCode\":\"A000008753\",\"eventId\":null,\"distributorName\":\"Park Circus\"}],\"castAndCrew\":[{\"id\":\"0000001791\",\"name\":{\"givenName\":\"Terence\",\"familyName\":\"Stamp\",\"middleName\":null}},{\"id\":\"0000010264\",\"name\":{\"givenName\":\"Alan\",\"familyName\":\"Bates\",\"middleName\":null}},{\"id\":\"0000010274\",\"name\":{\"givenName\":\"Julie\",\"familyName\":\"Christie\",\"middleName\":null}},{\"id\":\"0000011662\",\"name\":{\"givenName\":\"John\",\"familyName\":\"Schlesinger\",\"middleName\":null}},{\"id\":\"0000013864\",\"name\":{\"givenName\":\"Peter\",\"familyName\":\"Finch\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":{\"text\":\"Drama\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"HO00000001\",\"classification\":{\"text\":\