          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-03-21\",\"showtimes\":[{\"id\":\"SOH1-53935\",\"schedule\":{\"businessDate\":\"2026-03-21\",\"startsAt\":\"2026-03-21T21:00:00+00:00\",\"endsAt\":\"2026-03-21T22:51:00+00:00\",\"filmStartsAt\":\"2026-03-21T21:25:00+00:00\",\"filmEndsAt\":\"2026-03-21T22:51:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"SOH1-3-14\",\"filmId\":\"HO00006812\",\"siteId\":\"SOH1\",\"screenId\":\"SOH1-3\",\"areaCategories\":[{\"areaCategoryId\":\"SOH1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"SOH1\",\"name\":{\"text\":\"Soho\",\"translations\":[]},\"location\":{\"latitude\":51.5128,\"longitude\":-0.1305},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006812\",\"title\":{\"text\":\"Film Club: Zola\",\"translations\":[]},\"synopsis\":{\"text\":\"\\\"Y\u2019all wanna hear a story about why me & this bitch here fell out? It\u2019s kind of long but full of suspense.\u201d\\n\\nThus began the odyssey of one A\u2019Ziah King, aka ZOLA. From acclaimed writer/director Janicza Bravo, Zola's stranger than fiction saga, which she first told in a now iconic series of viral, uproarious tweets, comes to dazzling cinematic life.\\n\\nZola (newcomer Taylour Paige), a Detroit waitress, strikes up a new friendship with a customer, Stefani (Riley Keough), who seduces her to join a weekend of dancing and partying in Florida. What at first seems like a glamorous trip full of \u201choeism\u201d rapidly transforms into a 48-hour journey involving a nameless pimp, an idiot boyfriend, some Tampa gangsters and other unexpected adventures in this wild, see-it-to-believe-it tale.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A stripper named Zola embarks on a wild road trip to Florida.\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":{\"text\":\"strong sex, sexual violence\",\"translations\":[]},\"releaseDate\":\"2026-02-13\",\"runtimeInMinutes\":86,\"trailerUrl\":\"https://www.youtube.com/watch?v=jrQFYJPkp_U\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000807\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001072\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001073\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001074\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001075\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001076\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001077\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001078\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001079\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001080\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001081\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001082\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001083\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006812\",\"hoCode\":\"A000008404\",\"eventId\":null,\"distributorName\":\"Park Circus\"}],\"castAndCrew\":[{\"id\":\"0000000807\",\"name\":{\"givenName\":\"David\",\"familyName\":\"Hinojosa\",\"middleName\":null}},{\"id\":\"0000001072\",\"name\":{\"givenName\":\"Colman \",\"familyName\":\"Domingo\",\"middleName\":null}},{\"id\":\"0000001073\",\"name\":{\"givenName\":\"Riley \",\"familyName\":\"Keough\",\"middleName\":null}},{\"id\":\"0000001074\",\"name\":{\"givenName\":\"Nicholas\",\"familyName\":\"Braun\",\"middleName\":null}},{\"id\":\"0000001075\",\"name\":{\"givenName\":\"Ari'el\",\"familyName\":\"Stachel\",\"m