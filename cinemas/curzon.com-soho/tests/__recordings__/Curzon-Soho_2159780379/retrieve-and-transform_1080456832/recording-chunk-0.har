          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-08\",\"showtimes\":[{\"id\":\"SOH1-56368\",\"schedule\":{\"businessDate\":\"2026-08-08\",\"startsAt\":\"2026-08-08T18:00:00+01:00\",\"endsAt\":\"2026-08-08T20:04:00+01:00\",\"filmStartsAt\":\"2026-08-08T18:50:00+01:00\",\"filmEndsAt\":\"2026-08-08T20:04:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"SOH1-1-10\",\"filmId\":\"HO00007206\",\"siteId\":\"SOH1\",\"screenId\":\"SOH1-1\",\"areaCategories\":[{\"areaCategoryId\":\"SOH1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000009\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000067\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"SOH1-56374\",\"schedule\":{\"businessDate\":\"2026-08-08\",\"startsAt\":\"2026-08-08T20:30:00+01:00\",\"endsAt\":\"2026-08-08T22:04:00+01:00\",\"filmStartsAt\":\"2026-08-08T20:50:00+01:00\",\"filmEndsAt\":\"2026-08-08T22:04:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"SOH1-1-10\",\"filmId\":\"HO00007206\",\"siteId\":\"SOH1\",\"screenId\":\"SOH1-1\",\"areaCategories\":[{\"areaCategoryId\":\"SOH1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000067\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"SOH1\",\"name\":{\"text\":\"Soho\",\"translations\":[]},\"location\":{\"latitude\":51.5127983093262,\"longitude\":-0.130500003695488},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"SOH1@curzon.com\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007206\",\"title\":{\"text\":\"The Final Film Festival: Imaginal Disk + Shorts\",\"translations\":[]},\"synopsis\":{\"text\":\"A cinematic companion to Magdalena Bay’s recent album, Imaginal Disk expands its kaleidoscopic world into a bold, visually driven narrative.\\n\\nLike the titular album from Mica Tenenbaum and Matthew Lewin (Magdalena Bay), Amanda Kramer’s IMAGINAL DISK is fluid, formally audacious and unafraid of being True to its purest self.\\n\\nFresh oﬀ a run of similarly maximalist exercises across genre and spectacles of performance, Imaginal Disk is Kramer’s boldest and most visual work yet. Working only oﬀ the text that’s provided by the concept album, Kramer & the band craft a narrative of escapism and self discovery for its central protagonist, a figure given just enough detail to latch meaning onto amongst the colourful set pieces but anonymous enough that the viewer can perceive themselves.\\n\\nBetween the overstimulation of imagery and the omnipresence of the music being so much so that it can take a back seat to what’s happening before you, Imaginal Disk is less a musical and more a form of digital silent cinema; Kramer knows exactly how to frame Tenenbaum’s close-ups and expressions to invoke storytelling with short glances and slow blinks all on their own. A Lyda Borelli for hyperpop Spotify Canvas. Whether you’re in it for the cinema or the music or a blend of the two disciplines, Imaginal Disk is a proud addition to TFFF.\\n\\nThis event will also be preceded by a selection of further short works chosen by Kramer. \\n\\nThis UK Premiere will be followed by a Q&A with crew.\\n\\n- Kit Ramsay\\n\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A cinematic companion to Magdalena Bay’s eponymous album, Imaginal Disk expands its kaleidoscopic world into a bold, visually driven narrative.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-08\",\"runtimeInMinutes\":74,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":13,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007325\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000007325\"}],\"producers\":[],\"genreIds\":[\"0000000031\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007206\",\"hoCode\":\"A000008863\",\"eventId\":\"0000000067\",\"distributorName\":\"Final Film Festival\"}],\"castAndCrew\":[{\"id\":\"0000007325\",\"name\":{\"givenName\":\"Amanda\",\"familyName\":\"Kramer\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000031\",\"name\":{\"text\":\"Music\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000009\",\"name\":{\"text\":\"Screening followed by a Q&A\",\"translations\":[]},\"shortName\":{\"text\":\"Q&A\",\"translations\":[]},\"description\":{\"text\":\"Q&A\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"SOH1-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000067\",\"name\":{\"text\":\"The Final Film Festival\",\"translations\":[]},\"shortName\":null,\"description\":{\"text\":\"The Final Film Festival is a multi-venue event comprised of new independent releases from across the world, exciting and unusual repertory presentations and emerging artists from the UK and beyond. TFFF was created by independent film programmers Jack Hewitt and Kit Ramsay, for more information including the entire programme, please see tfffestival.co.uk or @Tff_Festival on Instagram.\\n\",\"translations\":[]},\"schedule\":{\"startDate\":\"2026-08-06\",\"endDate\":\"2026-08-09\"},\"siteIds\":[\"SOH1\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"SOH1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
