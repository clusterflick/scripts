            "text": "{\"businessDate\":\"2026-09-06\",\"showtimes\":[{\"id\":\"SOH1-56481\",\"schedule\":{\"businessDate\":\"2026-09-06\",\"startsAt\":\"2026-09-06T15:00:00+01:00\",\"endsAt\":\"2026-09-06T16:55:00+01:00\",\"filmStartsAt\":\"2026-09-06T15:25:00+01:00\",\"filmEndsAt\":\"2026-09-06T16:55:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"SOH1-1-10\",\"filmId\":\"HO00007231\",\"siteId\":\"SOH1\",\"screenId\":\"SOH1-1\",\"areaCategories\":[{\"areaCategoryId\":\"SOH1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000018\",\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"SOH1\",\"name\":{\"text\":\"Soho\",\"translations\":[]},\"location\":{\"latitude\":51.5127983093262,\"longitude\":-0.130500003695488},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"SOH1@curzon.com\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007231\",\"title\":{\"text\":\"Curzon Film 50: Orlando\",\"translations\":[]},\"synopsis\":{\"text\":\"In 1600, nobleman Orlando (Tilda Swinton) inherits his parents' house, thanks to Queen Elizabeth I (Quentin Crisp), who commands the young man to never change. After a disastrous affair with Russian princess Sasha (Charlotte Valandrey), Orlando looks for solace in the arts before being appointed ambassador to Constantinople in 1700, where war is raging. One morning, Orlando is shocked to wake up as a woman and returns home, struggling as a female to retain her property as the centuries roll by.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After Queen Elizabeth I commands him not to grow old, a young nobleman struggles with love and his place in the world.\",\"translations\":