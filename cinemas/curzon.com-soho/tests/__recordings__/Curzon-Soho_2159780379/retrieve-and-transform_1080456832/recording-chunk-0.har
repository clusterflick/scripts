          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-07\",\"showtimes\":[{\"id\":\"SOH1-56367\",\"schedule\":{\"businessDate\":\"2026-08-07\",\"startsAt\":\"2026-08-07T18:20:00+01:00\",\"endsAt\":\"2026-08-07T20:13:00+01:00\",\"filmStartsAt\":\"2026-08-07T19:10:00+01:00\",\"filmEndsAt\":\"2026-08-07T20:13:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"SOH1-1-10\",\"filmId\":\"HO00007211\",\"siteId\":\"SOH1\",\"screenId\":\"SOH1-1\",\"areaCategories\":[{\"areaCategoryId\":\"SOH1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000009\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000067\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"SOH1\",\"name\":{\"text\":\"Soho\",\"translations\":[]},\"location\":{\"latitude\":51.5127983093262,\"longitude\":-0.130500003695488},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"SOH1@curzon.com\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007211\",\"title\":{\"text\":\"The Final Film Festival: Camera as Folklore shorts\",\"translations\":[]},\"synopsis\":{\"text\":\"This year, The Final Film Festival’s short film programme explores the unpredictable pathology of relationships, the folklore-like topography of our surroundings, and the ever-evolving dialectics of the camera.\\n\\nFeaturing multimedia works from Julia Sipowicz, Nelly Dansen, Julian Barahona Rhi and Cheyenne Terborg, alongside an unconventional contemporary drama from Sophie Monks Kaufman and Lisa Schnepp, sentimental perspectives from Lada Kopytova and Polina Kuzminska, and idiosyncratic local travelogues from Julia Mervis and Ned Caderni, the programme embraces the friction between different forms and perspectives — allowing each work to bleed into the next like the impressionistic images they manifest.\\n\\nThis programme will be followed by a panel Q&A session with the attending filmmakers.\\n\\n- Jack Hewitt\\n\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"This year's short film programme explores the unpredictable pathology of relationships, the folklore-like topography of our surroundings, and the camera.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-07\",\"runtimeInMinutes\":63,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":12,\"castAndCrew\":[],\"actors\":[],\"directors\":[],\"producers\":[],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007211\",\"hoCode\":\"A000008871\",\"eventId\":\"0000000067\",\"distributorName\":\"Final Film Festival\"}],\"castAndCrew\":[],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":{\"text\":\"Drama\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000009\",\"name\":{\"text\":\"Screening followed by a Q&A\",\"translations\":[]},\"shortName\":{\"text\":\"Q&A\",\"translations\":[]},\"description\":{\"text\":\"Q&A\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"SOH1-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000067\",\"name\":{\"text\":\"The Final Film Festival\",\"translations\":[]},\"shortName\":null,\"description\":{\"text\":\"The Final Film Festival is a multi-venue event comprised of new independent releases from across the world, exciting and unusual repertory presentations and emerging artists from the UK and beyond. TFFF was created by independent film programmers Jack Hewitt and Kit Ramsay, for more information including the entire programme, please see tfffestival.co.uk or @Tff_Festival on Instagram.\\n\",\"translations\":[]},\"schedule\":{\"startDate\":\"2026-08-06\",\"endDate\":\"2026-08-09\"},\"siteIds\":[\"SOH1\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"SOH1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
