\":\"\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006677\",\"title\":{\"text\":\"Hamnet\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award\u00ae winning writer/director Chlo\u00e9 Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare\u2019s timeless masterpiece, Hamlet.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award\u00ae winning writer/director Chlo\u00e9 Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare\u2019s timeless masterpiece, Hamlet.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"distressing scenes, brief moderate sex\",\"translations\":[]},\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":126,\"trailerUrl\":\"https://www.youtube.com/watch?v=Y9Tv9wGPxIw\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000175\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001040\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001087\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002138\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002310\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004702\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004703\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005314\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007765\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c566d7dc-50bb-4d55-984b-c4c65751933e\",\"corporateId\":null},\"hopk\":\"HO00006677\",\"hoCode\":\"A000008241\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006689\",\"title\":{\"text\":\"No Other Choice\",\"translations\":[]},\"synopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":139,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000012169\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012827\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012828\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012829\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012830\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012831\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000026\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9ecc0908-a983-42f7-9591-6f8d73d7488b\",\"corporateId\":null},\"hopk\":\"HO00006689\",\"hoCode\":\"A000008255\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00006691\",\"title\":{\"text\":\"Is This Thing On?\",\"translations\":[]},\"synopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family \u2014 forcing them to navigate co-parenting, identity, and whether love can take a new form.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":121,\"trailerUrl\":\"https://www.youtube.com/watch?v=ngmu5zGOa7s\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002276\",\"roles\":[\"Actor\",\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003003\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003138\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006446\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007571\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000012836\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012837\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012838\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4e47345d-b26d-4559-847e-3add7a11d75a\",\"corporateId\":null},\"hopk\":\"HO00006691\",\"hoCode\":\"A000008257\",\"eventId\":null,\"distributorName\":\"Walt Disney Studios Motion Pictures - UK\"},{\"id\":\"HO00006713\",\"title\":{\"text\":\"LSFF: Funny Shit (2026)\",\"translations\":[]},\"synopsis\":{\"text\":\"LSFF\u2019s annual comedy bonanza returns with a riotous mix of the ridiculous, the relatable, and the downright unhinged. \\r\\n\\r\\nFeaturing an investigation into the unmasking of a schoolyard snitch; the desperate bid for a second date; the obsessive reclamation of a beloved sweater; a woman on the brink of a disastrous haircut; sociopathically ambitious filmmakers dumping their deadweight boyfriends - and a man who really, really hates Jack Grealish.\\r\\n\\r\\nWith the latest work from Joe Lycett, Funny Shit serves up laughs for every predilection, from bone-dry to the gloriously asinine.\\r\\n\\r\\n- Dating Mark Silcox, dir. Joe Lycett, UK 2025, 12mins\\r\\n- I Hate Jack, dir. Theo Watkins, UK 2025, 3mins\\r\\n- I Beg Your Pardon, dir. John W. Lustig, US Unknown, 5mins\\r\\n- The Following People DO NOT Smoke Weed, dir. Julia Mervis, UK 2025, 12mins\\r\\n- The Sweater, dir. Maziyar Khatam, Canada 2024, 9mins\\r\\n- Micro Bangs, dir. Iris Breward, UK 2025, 5mins\\r\\n- Nervous Energy, dir. Eve Liu, US 2025, 15mins\\r\\n- 1 In 5 Sheep, dir. James Button, UK 2024, 5mins\\r\\n- Probably Ur Own Fault, dir. June Bubbles, UK 2024, 10mins\\r\\n- SOS, But Don\u2019t Worry If Not, dir. Florence Poppy Deary, UK 2025, 2mins\\r\\n- Getting Hit by a Slow-Moving Vehicle, dir. Fred Bendz and Olof Bendz, Sweden 2025, 11mins\\r\\n- A Breath of Mindfulness, dir. Milly Cohen, US 2024, 8mins\\r\\n\\r\\nContent / Trigger Warnings: Contains scenes of murder and suicide, themes of death and drug use, and ableist and sexist attitudes and language.\\r\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A delirious mix of the ridiculous, the relatable, and the downright unhinged.\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-27\",\"runtimeInMinutes\":97,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000006786\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012896\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012940\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012941\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012942\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012943\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012944\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012945\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012946\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012947\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012948\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012949\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006713\",\"hoCode\":\"A000008284\",\"eventId\":\"0000000024\",\"distributorName\":\"London Short Film Festival\"},{\"id\":\"HO00006717\",\"title\":{\"text\":\"LSFF: Romantic Matinee (2026)\",\"translations\":[]},\"synopsis\":{\"text\":\"A pull towards connection, and the quiet ache of release. These films move through tenderness and distance, tracing how intimacy expands, contracts, and reshapes itself.\\r\\n\\r\\nFrom fleeting encounters and suspended gestures to long-distance devotion and unspoken desire, each film finds love in motion - stretched between bodies, places, and memories. Whether it\u2019s in the whispered longing that stretches across seasons, or in voice notes exchanged between lovers apart, romance here is neither static nor certain.\\r\\n\\r\\nThe attending filmmakers will join us for a Q&A following the screening.\\r\\n\\r\\n- Today, I <3 U _ _ _ _, dir. Oliver Lewis, US 2024, 1min\\r\\n- Tumtum, dir. Rebecca Ozer, UK 2025, 15mins\\r\\n- Yummy, dir. Martinus Klemet, Estonia 2024, 9mins\\r\\n- Fiji, dir. Andrea Lamedica, Italy 2025, 13mins\\r\\n- Purebred, dir. Caleb J. Roberts, Ireland, UK 2025, 15mins\\r\\n- Do You See When Things Change?, dir. Gustav W\u00e4rn, Sweden 2025, 7mins\\r\\n- cowabunga!, dir. Jacob Staudenmaier, US 2025, 2mins\\r\\n- Krizalit, dir. Arantxa Ibarra, Naz Tokg\u00f6z, Turkey 2025, 16mins\\r\\n- Still, Moving, dir. Tash Tung, UK 2025, 7mins\\r\\n- Fantasies of a Rescue Dummy, dir. Adrian Maganza, UK 2025, 7mins\\r\\n\\r\\nContent / Trigger Warnings: Contains flashing images and scenes of homophobia.\\r\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"An exploration of love\u2019s elasticity: the tender pull between desire and the moment of letting go.\\r\\n\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":92,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000012975\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012976\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012977\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012978\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012979\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012981\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012982\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012983\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012984\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012985\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012986\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006717\",\"hoCode\":\"A000008289\",\"eventId\":\"0000000024\",\"distributorName\":\"London Short Film Festival\"},{\"id\":\"HO00006609\",\"title\":{\"text\":\"Marty Supreme\",\"translations\":[]},\"synopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":149,\"trailerUrl\":\"https://www.youtube.com/watch?v=PNDVyJU99M0\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001403\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001416\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002090\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003985\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003988\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000007063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007210\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011162\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011923\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12808\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12809\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12810\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e033d58e-8545-4f81-a191-03352ebe4cc0\",\"corporateId\":null},\"hopk\":\"HO00006609\",\"hoCode\":\"A000008158\",\"eventId\":null,\"distributorName\":\"Entertainment Film Distributors\"},{\"id\":\"HO00006610\",\"title\":{\"text\":\"Sentimental Value\",\"translations\":[]},\"synopsis\":{\"text\":\"Nora Borg (Renate Reinsve) is an established Oslo stage actress; her younger sister Agnes (Inga Ibsdotter Lilleaas) has chosen family life with her young son. Though markedly different, the two are close and deeply intertwined, having been raised by a single mother after their filmmaker father\u2019s departure years earlier. When the once renowned Gustav (Stellan Skarsg\u00e5rd) attempts to cast Nora in his comeback film, old wounds bleed anew; \\\"Nora rejects his offer, prompting the isolated patriarch to cast American star Rachel Kemp (Elle Fanning), who gradually comes to realize she has unwittingly become part of a deeply personal film drama. Agnes, meanwhile, delves deeper into the family history as Gustav and Nora attempt rapprochement; but the cracks at the base of the family home run deeper than any Borg can grasp, threatening to topple an already shaky foundation.\\r\\n\\r\\nThis special preview is presented in partnership with The Observer and will feature a post-film conversation between film critic Wendy Ide and leading actor Stellan Skarsg\u00e5rd.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Sisters Nora and Agnes reunite with their estranged father, the charismatic Gustav, a once renowned director who offers stage actress Nora a role.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, suicide references\",\"translations\":[]},\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":133,\"trailerUrl\":\"https://www.youtube.com/watch?v=Gb1sSfWb1Og\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001057\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"000