stAndCrewMemberId\":\"0000007157\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013073\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014130\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000002460\"},{\"castAndCrewMemberId\":\"0000003915\"},{\"castAndCrewMemberId\":\"0000004392\"},{\"castAndCrewMemberId\":\"0000004710\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000003915\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000001093\"},{\"castAndCrewMemberId\":\"0000007157\"},{\"castAndCrewMemberId\":\"0000013073\"},{\"castAndCrewMemberId\":\"0000014130\"}],\"genreIds\":[\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ad147b9a-b731-410f-8bf9-c4f3f3df2095\",\"corporateId\":null},\"hopk\":\"HO00007147\",\"hoCode\":\"A000008799\",\"eventId\":null,\"distributorName\":\"Black Bear\"},{\"id\":\"HO00007152\",\"title\":{\"text\":\"Rosebush Pruning\",\"translations\":[]},\"synopsis\":{\"text\":\"Underneath the Catalonian sun, a rich white American family lives in hedonistic isolation, seeking love and validation through one another, their designer wardrobes and pop music. When an outsider infiltrates the family, buried tensions surface and blood ties are severed. \\n\\nAn outrageous, biting satire on the absurdity of patriarchal family, starring Callum Turner, Riley Keough, Jamie Bell, Lukas Gage, Elena Anaya, Tracy Letts, Elle Fanning and Pamela Anderson.\\n\\nFrom award winning director Karim Aïnouz, written by Oscar nominated writer Efthimis Filippou, ROSEBUSH PRUNING is absurd, funny and in equal measure. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Underneath the Catalonian sun, a rich white American family lives in hedonistic isolation, seeking love and validation through one another, their designer wardrobes\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":{\"text\":\"sexual violence, strong sex, nudity\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":95,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/ab78ddcf-eae4-4e1c-9d6a-68f6392793c8/media/TrailerVideo\"}],\"trailerUrl\":null,\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000497\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000736\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001041\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001073\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001820\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005512\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006483\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007166\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008082\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008105\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010500\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013540\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014145\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001041\"},{\"castAndCrewMemberId\":\"0000001073\"},{\"castAndCrewMemberId\":\"0000005512\"},{\"castAndCrewMemberId\":\"0000006483\"},{\"castAndCrewMemberId\":\"0000007166\"},{\"castAndCrewMemberId\":\"0000008105\"},{\"castAndCrewMemberId\":\"0000010500\"},{\"castAndCrewMemberId\":\"0000014145\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000001820\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000000497\"},{\"castAndCrewMemberId\":\"0000000736\"},{\"castAndCrewMemberId\":\"0000008082\"},{\"castAndCrewMemberId\":\"0000013540\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ab78ddcf-eae4-4e1c-9d6a-68f6392793c8\",\"corporateId\":null},\"hopk\":\"HO00007152\",\"hoCode\":\"A000008804\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00007210\",\"title\":{\"text\":\"BACKROOMS: EVERYTHING MUST GO WITH BONUS FOOTAGE\",\"translations\":[]},\"synopsis\":{\"text\":\"In the basement of a furniture showroom, a man (Chiwetel Ejiofor) stumbles upon a strange doorway that leads into a mysterious, otherworldly labyrinth. His therapist (Renate Reinsve) doesn't believe him, so he sets out on a mission to gather some proof. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A strange doorway appears in the basement of a furniture showroom.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, violence, injury detail, horror\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":126,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=tKGhxMi50y8\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=tKGhxMi50y8\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000578\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001101\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002626\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003068\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005898\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005899\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009229\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009594\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010891\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013766\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013767\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013768\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013769\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000002626\"},{\"castAndCrewMemberId\":\"0000003068\"},{\"castAndCrewMemberId\":\"0000009594\"},{\"castAndCrewMemberId\":\"0000010891\"},{\"castAndCrewMemberId\":\"0000013766\"},{\"castAndCrewMemberId\":\"0000013767\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000013768\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000000578\"},{\"castAndCrewMemberId\":\"0000001101\"},{\"castAndCrewMemberId\":\"0000005898\"},{\"castAndCrewMemberId\":\"0000005899\"},{\"castAndCrewMemberId\":\"0000009229\"},{\"castAndCrewMemberId\":\"0000013769\"}],\"genreIds\":[\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007210\",\"hoCode\":\"A000008868\",\"eventId\":null,\"distributorName\":\"A24\"},{\"id\":\"HO00007249\",\"title\":{\"text\":\"Taxi Driver (50th Anniversary)\",\"translations\":[]},\"synopsis\":{\"text\":\"Isolated ex-marine Travis Bickle applies for a job as a taxi driver, hoping that the nocturnal working pattern will alleviate the effects of his insomnia and distract him from his gnawing depression. But ferrying passengers through the seedy underbelly of night-time New York City only compounds Bickle's psychological dislocation from the world around him. His nightshifts in the cab are spent resenting those he sees, while his waking daytime hours are wasted away in adult movie theatres.\\n\\nAfter entering into a troubled relationship with a political campaigner and embarking on a fraught mission to save a teenager from the world of prostitution, Bickle's sense of place and purpose steadily warps. He withdraws into himself, hordes illegal firearms and begins a regimen of intense physical training in preparation for a misguided vigilante assault on the evils of society.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A mentally unstable veteran works as a nighttime taxi driver in New York City, where the perceived decadence and sleaze fuels his urge for violent action.\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":{\"text\":\"Contains very strong sex references and child prostitution theme\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":114,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/08345bd6-0c1b-432c-8