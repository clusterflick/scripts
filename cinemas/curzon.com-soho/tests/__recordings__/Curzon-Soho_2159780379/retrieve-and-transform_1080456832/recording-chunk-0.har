:\"HO00000004\",\"classification\":{\"text\":\"12A\",\"translations\":[]},\"classificationDescription\":{\"text\":\"12A\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}},{\"id\":\"HO00000005\",\"classification\":{\"text\":\"18\",\"translations\":[]},\"classificationDescription\":{\"text\":\"18\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}},{\"id\":\"HO00000006\",\"classification\":{\"text\":\"15\",\"translations\":[]},\"classificationDescription\":{\"text\":\"15\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000059\",\"name\":{\"text\":\"Awards Season Screening\",\"translations\":[]},\"shortName\":{\"text\":\"Awards\",\"translations\":[]},\"description\":{\"text\":\"Award winning film.\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false},{\"id\":\"0000000055\",\"name\":{\"text\":\"Open Captioned\",\"translations\":[]},\"shortName\":{\"text\":\"Captioned\",\"translations\":[]},\"description\":{\"text\":\"Open captions appear at the bottom of the screen and include both dialogue and sound descriptions. They are visible to everyone in the auditorium.\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false},{\"id\":\"0000000009\",\"name\":{\"text\":\"Screening followed by a Q&A\",\"translations\":[]},\"shortName\":{\"text\":\"Q&A\",\"translations\":[]},\"description\":{\"text\":\"Q&A\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"SOH1-2\",\"name\":{\"text\":\"Screen 2\",\"translations\":[]}},{\"id\":\"SOH1-3\",\"name\":{\"text\":\"Screen 3\",\"translations\":[]}},{\"id\":\"SOH1-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000024\",\"name\":{\"text\":\"London Short Film Festival\",\"translations\":[]},\"shortName\":{\"text\":\"LSFF\",\"translations\":[]},\"description\":{\"text\":\"The UK\u2019s leading short film festival, the London Short Film Festival (LSFF), returns for its 23rd edition from 23 January - 1 February 2026, bringing films and events to London\u2019s iconic cinemas alongside community and creative spaces.\\nLSFF presents the best in independent, boundary-pushing filmmaking from around the world. Showcasing 300 works from new voices, acclaimed directors, and underground discoveries drawn from the archive, the festival spans the full emotional range of short-form cinema. From raw DIY confessionals to bold, cinematic stories, these are films that surprise, unsettle, comfort, and stay with you. LSFF\u2019s special events combine curated programmes with conversations and unique experiences.\\nCinema Remembers What We Forget, the underlying current in this year\u2019s programme, explores how artists confront memory and identity - the fragments that linger beneath the surface: the messy, the emotional, the defiant and the unfiltered. \\n\",\"translations\":[]},\"schedule\":{\"startDate\":\"2026-01-23\",\"endDate\":\"2026-02-01\"},\"siteIds\":[\"SOH1\"]}],\"filmAdvanceBookingRules\":[{\"id\":\"SOH1-114-HO00006679\",\"filmId\":\"HO00006679\",\"siteId\":\"SOH1\",\"bookingPeriods\":[{\"startsAt\":\"2025-12-15T00:01:00+00:00\",\"orderBookingModes\":[\"Paid\",\"Unpaid\",\"UnpaidConfirmed\"],\"restriction\":\"None\",\"rewardId\":null}]},{\"id\":\"SOH1-113-HO00006609\",\"filmId\":\"HO00006609\",\"siteId\":\"SOH1\",\"bookingPeriods\":[{\"startsAt\":\"2025-11-26T00:01:00+00:00\",\"orderBookingModes\":[\"Paid\",\"Unpaid\",\"UnpaidConfirmed\"],\"restriction\":\"None\",\"rewardId\":null}]}],\"areaCategories\":[{\"id\":\"SOH1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
