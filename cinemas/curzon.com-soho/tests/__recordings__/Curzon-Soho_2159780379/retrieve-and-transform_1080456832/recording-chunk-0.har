          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-10\",\"showtimes\":[{\"id\":\"SOH1-56473\",\"schedule\":{\"businessDate\":\"2026-08-10\",\"startsAt\":\"2026-08-10T18:00:00+01:00\",\"endsAt\":\"2026-08-10T20:28:00+01:00\",\"filmStartsAt\":\"2026-08-10T18:25:00+01:00\",\"filmEndsAt\":\"2026-08-10T20:28:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"SOH1-1-10\",\"filmId\":\"HO00007215\",\"siteId\":\"SOH1\",\"screenId\":\"SOH1-1\",\"areaCategories\":[{\"areaCategoryId\":\"SOH1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000018\",\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"SOH1\",\"name\":{\"text\":\"Soho\",\"translations\":[]},\"location\":{\"latitude\":51.5127983093262,\"longitude\":-0.130500003695488},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"SOH1@curzon.com\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007215\",\"title\":{\"text\":\"Curzon Film 50: A Separation\",\"translations\":[]},\"synopsis\":{\"text\":\"Winner of multiple awards including the Oscar for Best Foreign Language in 2012, Asghar Farhadi's 'A Separation' is a suspenseful and intelligent drama detailing the fractures and tensions at the heart of Iranian society. When his wife (Leila Hatami) leaves him, Nader (Peyman Moadi) hires a young woman (Sareh Bayat) to take care of his suffering father (Ali-Asghar Shahbazi). But he doesn't know his new maid is not only pregnant, but also working without her unstable husband's (Shahab Hosseini) permission. Soon, Nader finds himself entangled in a web of lies manipulation and public confrontations.  Boasting a range of superb performances from the ensemble cast, the compelling film is driven by a taut and finely written script which creates a stunning morality play with universal resonance.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A married couple are faced with a difficult decision - to improve the life of their child by moving to another country or to stay in Iran.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":{\"text\":\"Contains mild language\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":123,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=MjTkXGRhy9w\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=MjTkXGRhy9w\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002268\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002273\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000005582\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000788\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000789\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000790\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000791\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000792\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000793\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000794\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000795\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000002268\"},{\"castAndCrewMemberId\":\"0000005582\"},{\"castAndCrewMemberId\":\"HO00000788\"},{\"castAndCrewMemberId\":\"HO00000789\"},{\"castAndCrewMemberId\":\"HO00000790\"},{\"castAndCrewMemberId\":\"HO00000791\"},{\"castAndCrewMemberId\":\"HO00000792\"},{\"castAndCrewMemberId\":\"HO00000793\"},{\"castAndCrewMemberId\":\"HO00000794\"},{\"castAndCrewMemberId\":\"HO00000795\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000002273\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000002273\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"movi