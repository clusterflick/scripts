0013706\"},{\"castAndCrewMemberId\":\"0000013707\"},{\"castAndCrewMemberId\":\"0000013708\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000013709\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000003927\"},{\"castAndCrewMemberId\":\"0000013710\"},{\"castAndCrewMemberId\":\"HO00000254\"}],\"genreIds\":[\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"53c5bdfb-4dbf-47f5-8eca-b0b807ee068c\",\"corporateId\":null},\"hopk\":\"HO00006951\",\"hoCode\":\"A000008567\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00007147\",\"title\":{\"text\":\"The Invite\",\"translations\":[]},\"synopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \\nHave they reignited the spark or lit the match that burns it all down?\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"very strong language, strong sex references, drug misuse\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":106,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/ad147b9a-b731-410f-8bf9-c4f3f3df2095/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=jnLW-q2ftKA\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=jnLW-q2ftKA\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001093\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002460\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003915\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"0000004392\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004710\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007157\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013073\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014130\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000002460\"},{\"castAndCrewMemberId\":\"0000003915\"},{\"castAndCrewMemberId\":\"0000004392\"},{\"castAndCrewMemberId\":\"0000004710\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000003915\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000001093\"},{\"castAndCrewMemberId\":\"0000007157\"},{\"castAndCrewMemberId\":\"0000013073\"},{\"castAndCrewMemberId\":\"0000014130\"}],\"genreIds\":[\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ad147b9a-b731-410f-8bf9-c4f3f3df2095\",\"corporateId\":null},\"hopk\":\"HO00007147\",\"hoCode\":\"A000008799\",\"eventId\":null,\"distributorName\":\"Black Bear\"},{\"id\":\"HO00007152\",\"title\":{\"text\":\"Rosebush Pruning\",\"translations\":[]},\"synopsis\":{\"text\":\"Underneath the Catalonian sun, a rich white American family lives in hedonistic isolation, seeking love and validation through one another, their designer wardrobes and pop music. When an outsider infiltrates the family, buried tensions surface and blood ties are severed. \\n\\nAn outrageous, biting satire on the absurdity of patriarchal family, starring Callum Turner, Riley Keough, Jamie Bell, Lukas Gage, Elena Anaya, Tracy Letts, Elle Fanning and Pamela Anderson.\\n\\nFrom award winning director Karim Aïnouz, written by Oscar nominated writer Efthimis Filippou, ROSEBUSH PRUNING is absurd, funny and in equal measure. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Underneath the Catalonian sun, a rich white American family lives in hedonistic isolation, seeking love and validation through one another, their designer wardrobes\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":{\"text\":\"sexual violence, strong sex, nudity\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":95,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/ab78ddcf-eae4-4e1c-9d6a-68f6392793c8/media/TrailerVideo\"}],\"trailerUrl\":null,\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000497\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000736\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001041\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001073\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001820\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005512\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006483\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007166\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008082\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008105\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010500\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013540\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014145\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001041\"},{\"castAndCrewMemberId\":\"0000001073\"},{\"castAndCrewMemberId\":\"0000005512\"},{\"castAndCrewMemberId\":\"0000006483\"},{\"castAndCrewMemberId\":\"0000007166\"},{\"castAndCrewMemberId\":\"0000008105\"},{\"castAndCrewMemberId\":\"0000010500\"},{\"castAndCrewMemberId\":\"0000014145\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000001820\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000000497\"},{\"castAndCrewMemberId\":\"0000000736\"},{\"castAndCrewMemberId\":\"0000008082\"},{\"castAndCrewMemberId\":\"0000013540\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ab78ddcf-eae4-4e1c-9d6a-68f6392793c8\",\"corporateId\":null},\"hopk\":\"HO00007152\",\"hoCode\":\"A000008804\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00007210\",\"title\":{\"text\":\"BACKROOMS: EVERYTHING MUST GO WITH BONUS FOOTAGE\",\"translations\":[]},\"synopsis\":{\"text\":\"In the basement of a furniture showroom, a man (Chiwetel Ejiofor) stumbles upon a strange doorway that leads into a mysterious, otherworldly labyrinth. His therapist (Renate Reinsve) doesn't believe him, so he sets out on a mission to gather some proof. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A strange doorway appears in the basement of a furniture showroom.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, violence, injury detail, horror\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":126,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=tKGhxMi50y8\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=tKGhxMi50y8\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000578\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001101\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002626\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003068\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005898\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005899\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009229\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009594\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010891\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013766\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013767\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013768\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013769\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000002626\"},{\"castAndCrewMemberId\":\"0000003068\"},{\"castAndCrewMemberId\":\"0000009594\"},{\"castAndCrewMemberId\":\"0000010891\"},{\"castAndCrewMemberId\":\"0000013766\"},{\"castAndCrewMemberId\":\"0000013767\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000013768\"}],\"producers\":[{\"castAndCrewMe