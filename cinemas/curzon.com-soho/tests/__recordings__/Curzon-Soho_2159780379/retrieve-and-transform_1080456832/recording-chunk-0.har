          ],
          "redirectURL": "",
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-09\",\"showtimes\":[{\"id\":\"SOH1-56369\",\"schedule\":{\"businessDate\":\"2026-08-09\",\"startsAt\":\"2026-08-09T15:00:00+01:00\",\"endsAt\":\"2026-08-09T17:24:00+01:00\",\"filmStartsAt\":\"2026-08-09T15:50:00+01:00\",\"filmEndsAt\":\"2026-08-09T17:24:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"SOH1-1-10\",\"filmId\":\"HO00007207\",\"siteId\":\"SOH1\",\"screenId\":\"SOH1-1\",\"areaCategories\":[{\"areaCategoryId\":\"SOH1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000009\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000067\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"SOH1\",\"name\":{\"text\":\"Soho\",\"translations\":[]},\"location\":{\"latitude\":51.5127983093262,\"longitude\":-0.130500003695488},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"SOH1@curzon.com\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007207\",\"title\":{\"text\":\"The Final Film Festival: Perfect\",\"translations\":[]},\"synopsis\":{\"text\":\"During the worst drought on record, a wealthy pregnant woman living out an escapist fantasy falls in love with a younger woman starting her life over.\\n\\nAt TFFF, one of our priorities when programming new independent work is identifying emerging filmic movements and creatives voices that feel underrepresented within London’s screening culture. With Julia Fox - the Uncut Gems it-girl turned contemporary cultural icon - appearing across two of this years selections, a certain sensibility begins to emerge: films concerned with transgression, queer expression and the collision between personal desire and wider social anxieties.\\n\\nIn Millicent Hailes Perfect, a yassified end-of-the-world cross-class romance becomes a magnifying glass for our relationship with consumption, privilege and environmental collapse. It belongs to a lineage of music video directors crossing into feature filmmaking - from David Finger to Jonathan Glazer - but replaces their industrial and technological anxieties with the visual language of contemporary rap, internet culture and a world reshaped by climate crisis. Perfect is an irresistibly seductive debut from a self-taught filmmaker with a clear voice.\\n\\nThis UK Premiere will be followed by a Q&A with crew.\\n\\n- Jack Hewitt\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"During the worst drought on record, a wealthy pregnant woman living out an escapist fantasy falls in love with a younger woman starting her life over.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-09\",\"runtimeInMinutes\":94,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":14,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014329\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000014329\"}],\"producers\":[],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007207\",\"hoCode\":\"A000008864\",\"eventId\":\"0000000067\",\"distributorName\":\"Final Film Festival\"}],\"castAndCrew\":[{\"id\":\"0000014329\",\"name\":{\"givenName\":\"Millicent\",\"familyName\":\"Hailes\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":{\"text\":\"Drama\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000009\",\"name\":{\"text\":\"Screening followed by a Q&A\",\"translations\":[]},\"shortName\":{\"text\":\"Q&A\",\"translations\":[]},\"description\":{\"text\":\"Q&A\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"SOH1-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000067\",\"name\":{\"text\":\"The Final Film Festival\",\"translations\":[]},\"shortName\":null,\"description\":{\"text\":\"The Final Film Festival is a multi-venue event comprised of new independent releases from across the world, exciting and unusual repertory presentations and emerging artists from the UK and beyond. TFFF was created by independent film programmers Jack Hewitt and Kit Ramsay, for more information including the entire programme, please see tfffestival.co.uk or @Tff_Festival on Instagram.\\n\",\"translations\":[]},\"schedule\":{\"startDate\":\"2026-08-06\",\"endDate\":\"2026-08-09\"},\"siteIds\":[\"SOH1\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"SOH1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
