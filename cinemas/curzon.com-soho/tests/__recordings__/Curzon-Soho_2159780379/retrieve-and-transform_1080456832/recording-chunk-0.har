          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-02\",\"showtimes\":[{\"id\":\"SOH1-55894\",\"schedule\":{\"businessDate\":\"2026-08-02\",\"startsAt\":\"2026-08-02T15:00:00+01:00\",\"endsAt\":\"2026-08-02T17:36:00+01:00\",\"filmStartsAt\":\"2026-08-02T15:25:00+01:00\",\"filmEndsAt\":\"2026-08-02T17:36:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"SOH1-1-10\",\"filmId\":\"HO00007107\",\"siteId\":\"SOH1\",\"screenId\":\"SOH1-1\",\"areaCategories\":[{\"areaCategoryId\":\"SOH1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000018\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"SOH1\",\"name\":{\"text\":\"Soho\",\"translations\":[]},\"location\":{\"latitude\":51.5127983093262,\"longitude\":-0.130500003695488},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"SOH1@curzon.com\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007107\",\"title\":{\"text\":\"Film Club: Billy Liar + Terminus\",\"translations\":[]},\"synopsis\":{\"text\":\"A special double bill to conclude our season celebrating John Schlesinger's centenerary. Season curated by Claire Nicolas and Marc David Jacobs.\\n\\nTERMINUS\\nThe daily rhythms and dramas of Waterloo station are captured in John Schlesinger's influential early film. In his first cinema film, made at British Transport Films, John Schlesinger presents a day in the life of Waterloo rail station. Now a staple television format, this observational look at the workings of one of London's key railway hubs was considered innovative in 1961, winning it awards at Venice and the Baftas.\\n\\nBILLY LIAR \\nA lazy, irresponsible young clerk (Sir Tom Courtenay) in provincial Northern England lives in his own fantasy world and makes emotionally immature decisions as he alienates friends and family.\\n\\nCanterbury Westgate: the screening is introduced by the editor of Terminus, Hugh Raggett. \\n\\nSoho: Billy Liar screens from 35mm film. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Double bill of Schlesinger's documentary Terminus with his classic comedy Billy Liar.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":131,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000049\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010274\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011662\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011663\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000723\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000724\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000725\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000049\"},{\"castAndCrewMemberId\":\"0000010274\"},{\"castAndCrewMemberId\":\"HO00000723\"},{\"castAndCrewMemberId\":\"HO00000724\"},{\"castAndCrewMemberId\":\"HO00000725\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000011662\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000011663\"}],\"genreIds\":[\"0000000002\",\"0000000003\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007107\",\"hoCode\":\"A000008754\",\"eventId\":null,\"distributorName\":\"Studio Canal\"}],\"castAndCrew\":[{\"id\":\"0000000049\",\"name\":{\"givenName\":\"Tom\",\"familyName\":\"Courtenay \",\"middleName\":null}},{\"id\":\"0000010274\",\"name\":{\"givenName\":\"Julie\",\"familyName\":\"Christie\",\"middleName\":null}},{\"id\":\"0000011662\",\"name\":{\"givenName\":\"John\",\"familyName\":\"Schlesinger\",\"middleName\":null}},{\"id\":\"0000011663\",\"name\":{\"givenName\":\"Joseph\",\"familyName\":\"Janni\",\"middleName\":null}},{\"id\":\"HO00000723\",\"name\":{\"givenName\":\"Leonard\",\"familyName\":\"Rossiter\",\"middleName\":null}},{\"id\":\"HO00000724\",\"name\":{\"givenName\":\"Rodney\",\"familyName\":\"Bewes\",\"middleName\":null}},{\"id\":\"HO00000725\",\"name\":{\"givenName\":\"Helen\",\"familyName\":\"Fraser\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":{\"text\":\"Drama\",\"translations\":[]}},{\"id\":\"0000000003\",\"name\":{\"text\":\"Comedy\",\"translations\":[]},\"description\":{\"text\":\"Comedy\",\"translations\":[]}},{\"id\":\"0000000033\",\"name\":{\"text\":\"Romance\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"HO00000002\",\"classification\":{\"text\":\"PG\",\"translations\":[]},\"classificationDescription\":{\"text\":\"PG\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000018\",\"name\":{\"text\":\"35mm presentations\",\"translations\":[]},\"shortName\":{\"text\":\"35mm\",\"translations\":[]},\"description\":{\"text\":\"A 35mm film print\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"SOH1-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"SOH1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
