longitude\":-0.130500003695488},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"SOH1@curzon.com\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00006278\",\"title\":{\"text\":\"Film Club: Darling\",\"translations\":[]},\"synopsis\":{\"text\":\"To mark the centenary of Academy Award-winning director John Schlesinger's birth, we're inviting you to experience his greatest films on the big screen. Season curated by Claire Nicolas and Marc David Jacobs. \\n\\nDARLING\\nA beautiful but amoral model sleeps her way to the top of the London fashion scene at the height of the Swinging Sixties.\\n\\nSoho screens from 35mm. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Beautiful but amoral model Diana Scott sleeps her way to the top of the London fashion scene at the height of the Swinging Sixties.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong sex references\",\"translations\":[]},\"releaseDate\":\"2026-07-04\",\"runtimeInMinutes\":128,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000010274\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011658\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011662\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011663\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000061\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000010274\"},{\"castAndCrewMemberId\":\"0000011658\"},{\"castAndCrewMemberId\":\"HO00000061\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000011662\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000011663\"}],\"genreIds\":[\"0000000002\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006278\",\"hoCode\":\"A000007745\",\"eventId\":null,\"distributorName\":\"Park Circus\"},{\"id\":\"HO00006951\",\"title\":{\"text\":\"Obsession\",\"translations\":[]},\"synopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for but soon discovers that some desires come at a dark, sinister price.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for.\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":null,\"releaseDate\":\"2026-05-15\",\"runtimeInMinutes\":109,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/53c5bdfb-4dbf-47f5-8eca-b0b807ee068c/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=fWLaCC8L6Jo\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=fWLaCC8L6Jo\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003927\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013704\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013705\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013706\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013707\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013708\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013709\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013710\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000254\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000013704\"},{\"castAndCrewMemberId\":\"0000013705\"},{\"castAndCrewMemberId\":\"0000013706\"},{\"castAndCrewMemberId\":\"0000013707\"},{\"castAndCrewMemberId\":\"0000013708\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000013709\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000003927\"},{\"castAndCrewMemberId\":\"0000013710\"},{\"castAndCrewMemberId\":\"HO00000254\"}],\"genreIds\":[\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"53c5bdfb-4dbf-47f5-8eca-b0b807ee068c\",\"corporateId\":null},\"hopk\":\"HO00006951\",\"hoCode\":\"A000008567\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00007147\",\"title\":{\"text\":\"The Invite\",\"translations\":[]},\"synopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \\nHave they reignited the spark or lit the match that burns it all down?\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"very strong language, strong sex references, drug misuse\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":106,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/ad147b9a-b731-410f-8bf9-c4f3f3df2095/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=jnLW-q2ftKA\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=jnLW-q2ftKA\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001093\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002460\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003915\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"0000004392\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004710\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007157\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013073\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014130\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000002460\"},{\"castAndCrewMemberId\":\"0000003915\"},{\"castAndCrewMemberId\":\"0000004392\"},{\"castAndCrewMemberId\":\"0000004710\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000003915\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000001093\"},{\"castAndCrewMemberId\":\"0000007157\"},{\"castAndCrewMemberId\":\"0000013073\"},{\"castAndCrewMemberId\":\"0000014130\"}],\"genreIds\":[\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ad147b9a-b731-410f-8bf9-c4f3f3df2095\",\"corporateId\":null},\"hopk\":\"HO00007147\",\"hoCode\":\"A000008799\",\"eventId\":null,\"distributorName\":\"Black Bear\"},{\"id\":\"HO00007152\",\"title\":{\"text\":\"Rosebush Pruning\",\"translations\":[]},\"synopsis\":{\"text\":\"Underneath the Catalonian sun, a rich white American family lives in hedonistic isolation, seeking love and validation through one another, their designer wardrobes and pop music. When an outsider infiltrates the family, buried tensions surface and blood ties are severed. \\n\\nAn outrageous, biting satire on the absurdity of patriarchal family, starring Callum Turner, Riley Keough, Jamie Bell, Lukas Gage, Elena Anaya, Tracy Letts, Elle Fanning and Pamela Anderson.\\n\\nFrom award winning director Karim Aïnouz, written by Oscar nominated writer Efthimis Filippou, ROSEBUSH PRUNING is absurd, funny and in equal measure. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Underneath the Catalonian sun, a rich white American family lives in hedonistic isolation, seeking love and validation through one another, their designer wardrobes\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":{\"text\":\"sexual violence, strong sex, nudity\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":95,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/ab78ddcf-eae4-4e1c-9d6a-68f6392793c8/media/TrailerVideo\"}],\"trailerUrl\":null,\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\"