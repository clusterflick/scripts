          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-07-24\",\"showtimes\":[{\"id\":\"SOH1-56148\",\"schedule\":{\"businessDate\":\"2026-07-24\",\"startsAt\":\"2026-07-24T18:00:00+01:00\",\"endsAt\":\"2026-07-24T20:41:00+01:00\",\"filmStartsAt\":\"2026-07-24T18:50:00+01:00\",\"filmEndsAt\":\"2026-07-24T20:41:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"SOH1-3-14\",\"filmId\":\"HO00007176\",\"siteId\":\"SOH1\",\"screenId\":\"SOH1-3\",\"areaCategories\":[{\"areaCategoryId\":\"SOH1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000009\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"SOH1\",\"name\":{\"text\":\"Soho\",\"translations\":[]},\"location\":{\"latitude\":51.5127983093262,\"longitude\":-0.130500003695488},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"SOH1@curzon.com\",\"address\":{\"line1\":\"99 Shaftesbury Avenue,\",\"line2\":\"London,\",\"city\":\"W1D 5DY\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007176\",\"title\":{\"text\":\"On The Sea\",\"translations\":[]},\"synopsis\":{\"text\":\"Jack has been married to Maggie for over half his life. He works as a Hand Raker on the mussel beds in North Wales alongside his younger brother, Dyfan, and Dyfan’s three sons. Jack has always assumed that his own boy, Tom, will join the family business on leaving school but Tom’s resistance to follow in his footsteps creates familial tension. Tensions are further inflamed by the \\narrival of an itinerant deckhand, Daniel, who makes known his feelings for Jack.  In this remote, rural community where life revolves around Church and fishery, Jack is faced with an impossible dilemma. \\nOn The Sea is a beautiful, sensual and at times, tragic exploration of masculinity, place and desire\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Love, longing and desire in a beautiful, remote coastal community - On The Sea is a beautiful, sensual and at times, tragic exploration of masculinity, place and desire.\\n\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, sex\",\"translations\":[]},\"releaseDate\":\"2026-07-24\",\"runtimeInMinutes\":111,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/9e1d4df6-3cff-49a5-9ce5-3b45bba4d096/media/TrailerVideo\"}],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001157\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002166\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008266\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013983\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014214\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014215\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014216\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014217\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014218\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014219\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001157\"},{\"castAndCrewMemberId\":\"0000002166\"},{\"castAndCrewMemberId\":\"0000008266\"},{\"castAndCrewMemberId\":\"0000013983\"},{\"castAndCrewMemberId\":\"0000014214\"},{\"castAndCrewMemberId\":\"0000014215\"},{\"castAndCrewMemberId\":\"0000014216\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000014217\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000014218\"},{\"castAndCrewMemberId\":\"0000014219\"}],\"genreIds\":[\"0000000002\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9e1d4df6-3cff-49a5-9ce5-3b45bba4d096\",\"corporateId\":null},\"hopk\":\"HO00007176\",\"hoCode\":\"A000008831\",\"eventId\":null,\"distributorName\":\"Verve\"}],\"castAndCrew\":[{\"id\":\"0000001157\",\"name\":{