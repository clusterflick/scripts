          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014701\",\"name\":\"André Rieu's 2026 Summer Concert: Viva Maastricht!\",\"originalName\":\"André Rieu's 2026 Summer Concert: Viva Maastricht!\",\"length\":165,\"posterLink\":\"https://regalcdn.azureedge.net/CW/AndreRieus2026SummerConcertVivaMaastricht/HO00014701/TV_SmallPosterImage/20260519-115105202.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/AndreRieus2026SummerConcertVivaMaastricht/HO00014701/TV_LargePosterImage/20260519-115004203.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/andre-rieus-2026-summer-concert-viva-maastricht/ho00014701\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"André Rieu, The Johann Strauss Orchestra\",\"directors\":\"\",\"synopsis\":\"This year, André Rieu celebrates a spectacular milestone — the 20th anniversary of his iconic summer concerts on the magnificent Vrijthof square. Captured live in his beloved hometown, this brand-new cinema event marks two decades of music and unforgettable magical summer nights. Viva Maastricht! is a joyful tribute to the city where it all began. Joined by his world-renowned Johann Strauss Orchestra and a vibrant ensemble of artists, André brings the spirit, culture, and warmth of his hometown to life in a dazzling new concert filled with emotion and wonder. From timeless waltzes to soul-stirring classics, this landmark anniversary concert promises an evening of passion, joy, and togetherness. Be part of this historic celebration as the Vrijthof once again transforms into a breathtaking open-air ballroom — only in cinemas this summer.\",\"dateStarted\":\"2026-08-08T00:00:00\",\"eventCount\":226,\"categoriesAttributes\":[],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"alternative-content\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/AndreRieus2026SummerConcertVivaMaastricht/HO00014701/TV_TopShelfPosterImage/20260519-115004203.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/AndreRieus2026SummerConcertVivaMaastricht/HO00014701/TV_SmallPosterImage/20260519-115105202.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/AndreRieus2026SummerConcertVivaMaastricht/HO00014701/Mobile_MovieThumbnail/20260519-115004203.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/AndreRieus2026SummerConcertVivaMaastricht/HO00014701/TV_LargePosterImage/20260519-115004203.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/AndreRieus2026SummerConcertVivaMaastricht/HO00014701/Mobile_MovieFeed/20260519-115042938.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"Piece Of Magic BV\"}}}",
