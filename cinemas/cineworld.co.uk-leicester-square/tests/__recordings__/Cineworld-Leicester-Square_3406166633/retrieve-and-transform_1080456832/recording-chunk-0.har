          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014875\",\"name\":\"Scorsese Season: Goodfellas (1990)\",\"originalName\":\"Scorsese Season: Goodfellas (1990)\",\"length\":146,\"posterLink\":\"https://regalcdn.azureedge.net/CW/ScorseseSeasonGoodfellas1990/HO00014875/TV_SmallPosterImage/20260629-105934715.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/ScorseseSeasonGoodfellas1990/HO00014875/TV_LargePosterImage/20260629-105903980.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/scorsese-season-goodfellas-1990/ho00014875\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Lorraine Bracco, Robert De Niro, Michael Imperioli, Ray Liotta, Joe Pesci, Isiah Whitlock Jr., Samuel L. Jackson\",\"directors\":\"Martin Scorsese\",\"synopsis\":\"The true story of Henry Hill, a half-Irish, half-Sicilian Brooklyn kid who is adopted by neighbourhood gangsters at an early age and climbs the ranks of a Mafia family. With his rise through the organisation, however, comes the dangers of violence, double-crosses, drug addiction and the Federal Bureau of Investigation.\",\"dateStarted\":\"2026-07-24T00:00:00\",\"eventCount\":85,\"categoriesAttributes\":[\"crime\",\"drama\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"classicfilm\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/18.png\",\"ageRestrictionName\":\"18\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/ScorseseSeasonGoodfellas1990/HO00014875/TV_TopShelfPosterImage/20260629-105903980.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\"