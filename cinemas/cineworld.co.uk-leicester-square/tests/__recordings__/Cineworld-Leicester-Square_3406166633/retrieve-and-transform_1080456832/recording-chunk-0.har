          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014876\",\"name\":\"Scorsese Season: Raging Bull (1980)\",\"originalName\":\"Scorsese Season: Raging Bull (1980)\",\"length\":129,\"posterLink\":\"https://regalcdn.azureedge.net/CW/ScorseseSeasonRagingBull1980/HO00014876/TV_SmallPosterImage/20260629-110442925.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/ScorseseSeasonRagingBull1980/HO00014876/TV_LargePosterImage/20260629-110352101.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/scorsese-season-raging-bull-1980/ho00014876\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Robert De Niro, Cathy Moriarty, Joe Pesci, Frank Vincent, Theresa Saldana, Nicholas Colasanto\",\"directors\":\"Martin Scorsese\",\"synopsis\":\"A lacerating biopic of Jake LaMotta, the middleweight boxing champion who was known as “The Bronx Bull” and “The Raging Bull” during his brief reign. LaMotta had early lessons in life: to steal and to fight. He channelled his tough childhood into the ring, where his aggression became a way of combating deep-seated anxieties and emotional fears. This determination and rage turned him from a young hoodlum into a champion. But his drive for the title, his brutality outside of the ring and his almost-psychotic sexual jealousy will destroy his marriage, his deepest friendships and the career he fought to build.\",\"dateStarted\":\"2026-07-27T00:00:00\",\"eventCount\":84,\"categoriesAttributes\":[\"drama\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"classicfilm\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/15.png\",\"ageRestrictionName\":\"15\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/ScorseseSeasonRagingBull1980/HO00014876/TV_TopShelfPosterImage/20260629-110352101.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/ScorseseSeasonRagingBull1980/HO00014876/TV_SmallPosterImage/20260629-110442925.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/ScorseseSeasonRagingBull1980/HO00014876/Mobile_MovieThumbnail/20260629-110352101.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/ScorseseSeasonRagingBull1980/HO00014876/TV_LargePosterImage/20260629-110352101.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/ScorseseSeasonRagingBull1980/HO00014876/Mobile_MovieFeed/20260629-110417089.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"PARK CIRCUS FILMS\"}}}",
