          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014764\",\"name\":\"jackass: best and last\",\"originalName\":\"jackass: best and last\",\"length\":92,\"posterLink\":\"https://regalcdn.azureedge.net/CW/jackassbestandlast/HO00014764/TV_SmallPosterImage/20260603-080254545.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/jackassbestandlast/HO00014764/TV_LargePosterImage/20260603-080033662.jpg\",\"videoLink\":\"https://youtu.be/erztPGWNkY4\",\"link\":\"https://www.cineworld.co.uk/films/jackass-best-and-last/ho00014764\",\"weight\":-10,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Dave England, Johnny Knoxville, Preston Lacy, Chris Pontius, Ehren McGhehey, Steve-O, Wee Man, Rachel Wolfson, Compston Wilson, Sean McInerney\",\"directors\":\"Jeff Tremaine\",\"synopsis\":\"Johnny Knoxville and the gang return for one final fling at the big screen. Featuring all-new stunts and stupidity along with the greatest hits and biggest laughs from the past, jackass: best and last is a joyously raucous celebration of all the mischievous camaraderie that you’ve come to love and expect from these idiots over the past 25 years. So, grab your dumb little buddies, raise your glasses, and come experience the cinematic event that promises to be the last time you’ll ever laugh this hard in a theatre.\",\"dateStarted\":\"2026-06-26T00:00:00\",\"eventCount\":830,\"categoriesAttributes\":[\"comedy\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"audio-described\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/18.png\",\"ageRestrictionName\":\"18\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/jackassbestandlast/HO00014764/Mobile_MovieFeed/20260603-075933208.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"},{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/jackassbestandlast/HO00014764/TV_TopShelfPosterImage/20260603-080033662.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/jackassbestandlast/HO00014764/TV_SmallPosterImage/20260603-080254545.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/jackassbestandlast/HO00014764/Mobile_MovieThumbnail/20260603-080033662.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/jackassbestandlast/HO00014764/TV_LargePosterImage/20260603-080033662.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Video\",\"subType\":\"Trailer_Youtube\",\"url\":\"https://youtu.be/erztPGWNkY4\",\"dimensionHeight\":null,\"dimensionWidth\":null}],\"specialMessage\":null,\"distributorName\":\"PARAMOUNT\"}}}",
