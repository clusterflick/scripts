 sm  \" data-perf-id=\"17240\" data-filters=\"audio-described\" data-start-time=\"2026-07-16T15:00:00\" href=\"/bookings/17240/\">\n    15:00\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n        \n    \n    \n        <span class=\"screen\">S2</span>\n    \n</a>\n\n                \n                </div>\n            </div>\n            \n        \n\n    </div>\n\n    <div class=\"half-col film-description tablet\">\n      \n      \n      \n        <span class=\"film-synopsis\"><p><p>The Invite is a marital dark comedy directed by Olivia Wilde (Booksmart/Don’t Worry Darling), adapted from the 2020 Spanish film The People Upstairs. It follows Joe and Angela, an unhappy, bickering San Francisco couple who host their enigmatic, sexually uninhibited upstairs neighbors for a chaotic dinner party that quickly spirals into raw, hilarious emotional warfare.</p>\n<p><b>Warning: This film contains sequences with flashing or flickering lights that may affect individuals with photosensitivity. Viewer discretion is advised.</b></p></p></span>\n      \n        <br>\n\n        <div class=\"meta\">\n            \n                \n                    <div class=\"meta-line\"><strong>Starring</strong>: <br>\n                    <span class=\"film-cast\">Seth Rogen, Olivia Wilde, Penélope Cruz, Edward Norton</span></div>\n                \n            \n                \n                    <div class=\"meta-line\"><strong>Director</strong>: <br>\n                    <span class=\"film-director\">Olivia Wilde</span></div>\n                \n            \n                \n                    <div class=\"meta-line\"><strong>Writer</strong>: <br>\n                    <span class=\"film-writer\">Cesc Gay, Will McCormack, Rashida Jones</span></div>\n                \n            \n                \n            \n                \n            \n                \n            \n        </div>\n    </div>\n\n    <div class=\"clear marg\"></div>\n    \n    <!-- Films -->\n    </div>\n\n    </section>\n\n\n    \n    <footer class=\"inner clip top\">\n        \n<div class=\"newsletter\">\n<form class=\"mc-form\">\n    \n    <span>Newsletter signup</span>\n    \n    <input id=\"mc-email\" type=\"email\" placeholder=\"Enter your email address\">\n    <div class=\"button teal dark\">Sign up</div>\n    </br>\n    <label for=\"mc-email\"></label>\n</form>\n</div>\n\n    <div class=\"footer-cols\">\n        <div class=\"third-col contact\">\n            <div class=\"contact\">\n                <h3>The Castle Cinema</h3>\n                <p> First floor, 64-66 Brooksby's Walk\n                    <br> Hackney, London E9 6DA\n                    <br>\n                    <a href=\"/info/#find-us\">Map</a>\n                </p>\n                <p>\n                    <a href=\"mailto:hello@thecastlecinema.com\">hello@thecastlecinema.com</a>\n                </p>\n                <h3>Hours</h3>\n                <p>\n                  10am til late, every day (except Christmas Day!)\n                </p>\n                \n<ul class=\"social\">\n    <li>\n        <a href=\"http://www.instagram.com/thecastlecinema\" target=\"_blank\"><img src=\"/static/images/instagram.png\" /></a>\n    </li>\n    <li>\n        <a href=\"https://www.facebook.com/thecastlecinema/\" target=\"_blank\"><img src=\"/static/images/facebook.png\" /></a>\n    </li>\n</ul>\n\n            </div>\n        </div>\n        <div class=\"twothird-col\">\n            <div class=\"nav-col\">\n                <ul class=\"first\">\n                    <li>Top menu</li>\n                    \n\n<li><a href=\"/calendar/\">What's on</a></li>\n<li><a href=\"/membership/\">Membership</a></li>\n<li><a href=\"/membership/#gifts\">Gift Vouchers</a></li>\n<li><a href=\"/bar/\">Bar &amp; food</a></li>\n<li><a href=\"/private-hire/\">Private hire</a></li>\n<li><a href=\"/about-us/\">About us</a></li>\n<li><a href=\"/access/\">Accessibility</a></li>\n\n\n                </ul>\n            </div>\n            <div class=\"nav-col\">\n                <ul class=\"first\">\n                    <li>Cinema info</li>\n                    <li><a href=\"/about-us/\">About us</a></li>\n                    <li><a href=\"/info/#contact\">Contact us</a></li>\n                    <li><a href=\"/info/#find-us\">Find us</a></li>\n                    <li><a href=\"/info/#booking\">Booking info</a></li>\n                    <li><a href=\"/info/#booking\">Ticket prices</a></li>\n                    <li><a href=\"/info/#get-involved\">Get involved</a></li>\n                </ul>\n            </div>\n            <div class=\"nav-col\">\n                <ul>\n                    <li>Listings</li>\n                    <li><a href=\"/listings/\">All listings (A-Z)</a></li>\n                    <li><a href=\"/calendar/\">Calendar</a></li>\n                    <li><a href=\"/listings/?category=live\">Live</a></li>\n                    <li><a href=\"/listings/?category=events\">Events</a></li>\n                    <li><a href=\"/bar/#events\">Art gallery</a></li>\n                </ul>\n            </div>\n            <div class=\"nav-col\">\n                <ul>\n                    <li>Share the love</li>\n                    <li><a href=\"/membership/#gifts\">Gifts</a></li>\n                    <li><a href=\"/membership/\">Support us</a></li>\n                    <li><a href=\"/info/#contact\">Advertising</a></li>\n                    <li><a href=\"/about-us/#curators\">Curators</a></li>\n                </ul>\n            </div>\n        </div>\n        <div class=\"clear\"></div>\n        <div class=\"terms\">\n            <ul>\n                <li><a href=\"/faq/\">FAQs</a></li>\n                <li><a href=\"/privacy/\">Privacy policy</a></li>\n                <li><a href=\"/terms/\">Terms &amp; conditions</a></li>\n                <li><a href=\"/access/\">Access</a></li>\n            </ul>\n            <p>&copy; 2016 The Castle Cinema</p>\n        </div>\n    </div>\n    <div class=\"clear\"></div>\n</footer>\n    <!-- Container -->\n    \n\n    \n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/salvattore/1.0.9/salvattore.min.js\" integrity=\"sha256-7DszDogKBCAj+K9LUttX3pnQ04gZkAwbnvjGx8O2KjA=\" crossorigin=\"anonymous\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/jquery/3.1.1/jquery.min.js\" integrity=\"sha256-hVVnYaiADRTO2PzUGmuLJr8BLUSjGIZsDYGmIJLv2b8=\" crossorigin=\"anonymous\"></script>\n    <script src=\"/static/lib/js/modernizr.custom.min.js\"></script>\n    <script src=\"/static/lib/js/jquery.sticky.js\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/venobox/1.9.3/venobox.min.css\" integrity=\"sha512-e+0yqAgUQFoRrJ4pZigQXpOE0S7J9IGwmgH801h4H5ODqOCG8/GRfXHQ+9ab754NL79O7wDwdjwY3CcU8sEANg==\" crossorigin=\"anonymous\" />\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/venobox/1.9.3/venobox.min.js\" integrity=\"sha512-zBTnX97k269iewUwROiWwO82A6uXO4lcjq0Z4xnvO+qAblC/RMQRUu8fQVKtSFhPNKD5Xzh9PMoZG7+LnmH1Hg==\" crossorigin=\"anonymous\"></script>\n    <script src=\"/static/js/ajax-mailchimp.js\"></script>\n\n    <script>\n      $(window).on('load', function(){\n        $(\"#main-nav\").sticky({ topSpacing: 0 });\n      });\n    \n      /**\n        * Strips (removes) all elements with the given className, \n        * but preserves their children in the DOM hierarchy.\n        *\n        * @param {HTMLElement} node       - The root node from which to start stripping.\n        * @param {string}      className  - The class name to look for.\n        */\n        function stripTagsWithClass(node, className) {\n        // If node has no children, no need to proceed.\n        if (!node || !node.children) return;\n\n        // Convert HTMLCollection/NodeList to an array so we can safely iterate\n        // even if the children change during the process.\n        const children = Array.from(node.children);\n\n        for (const child of children) {\n            // Recursively handle child's subtree first.\n            stripTagsWithClass(child, className);\n\n            // After recursion, check if this child has the target class.\n            if (child.classList && child.classList.contains(className)) {\n            // Move all child nodes (inner text, nested elements, etc.)\n            // out of the element being removed.\n            while (child.firstChild) {\n                child.parentNode.insertBefore(child.firstChild, child);\n            }\n            // Remove the now-empty element from its parent.\n            child.parentNode.removeChild(child);\n            }\n        }\n      }\n\n      $(document).ready(function(){\n\n        /* default settings */\n        $('.venobox').venobox();\n\n\n        /* custom settings */\n        $('.venobox_custom').venobox({\n            framewidth: '400px',        // default: ''\n            frameheight: '300px',       // default: ''\n            border: '10px',             // default: '0'\n            bgcolor: '#5dff5e',         // default: '#fff'\n            titleattr: 'data-title',    // default: 'title'\n            numeratio: true,            // default: false\n            infinigall: true            // default: false\n        });\n\n        /* auto-open #firstlink on page load */\n        $(\"#firstlink\").venobox().trigger('click');\n\n        const $whatson = $('#whats-on')[0];\n\n        $('#whats-on .day').click(function () {\n          var $this = $(this);\n          if (!$this.hasClass('select')) {\n            var index = $this.data('day-index');\n            $('.day').removeClass('select');\n            $this.addClass('select');\n\n            $('.day-group').css('display', 'none');\n            $('.day-group[data-day-index=\"' + index + '\"]').css('display', '');\n            stripTagsWithClass($whatson, 'column')\n            salvattore.init()\n          };\n\n          return false;\n        });\n\n        $('.mc-form .button').click(function () {\n          $(this).closest('form').submit();\n        });\n\n        $('.mc-form').ajaxChimp({\n          url: 'https://thecastlecinema.us14.list-manage.com/subscribe/post?u=951023a30af8baa6abe38e0fd&id=1cbf667c64'\n        });\n      });\n\n      $(document).ready(function(){\n        $('.random-pick').each(function() {\n          var $elements = $(this).children();\n          var elementCount = $elements.length;\n          var heroIndex = +localStorage.getItem('heroIndex');\n          heroIndex += 1;\n          if ((heroIndex == null) || (heroIndex > elementCount - 1)) {\n            heroIndex = 0;\n          }\n\n          var $visibleElement = $($elements.get(heroIndex));\n          $elements.css('display', 'none');\n          $visibleElement.css('display', '');\n          localStorage.setItem('heroIndex', heroIndex);\n        });\n      });\n    </script>\n\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/classie/1.0.1/classie.min.js\" integrity=\"sha256-6O5DljdGA6AiaEVC/Zn8pNLNbQGparYTI9091fGX64k=\" crossorigin=\"anonymous\"></script>\n    <script src=\"/static/js/site.js\"></script>\n    \n\n    <script type=\"application/ld+json\">\n    {\"@context\": \"http://www.schema.org\", \"@id\": \"https://thecastlecinema.com/#organization\", \"@type\": \"MovieTheater\", \"address\": {\"@type\": \"PostalAddress\", \"addressCountry\": \"United Kingdom\", \"addressLocality\": \"London\", \"addressRegion\": \"Hackney\", \"postalCode\": \"E9 6DA\", \"streetAddress\": \"First floor, 64-66 Brooksby\\u0027s Walk\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": \"51.551322\", \"longitude\": \"-0.043188\"}, \"image\": \"https://thecastlecinema.com/static/images/private-hire-%28with-proc-arch%29.jpg\", \"name\": \"Castle Hackney\", \"url\": \"https://thecastlecinema.com\"}\n    </script>\n    \n    <script type=\"application/ld+json\">\n    {\"@context\": \"h