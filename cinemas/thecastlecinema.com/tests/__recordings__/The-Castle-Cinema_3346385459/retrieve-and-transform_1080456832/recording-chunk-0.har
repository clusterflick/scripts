y\"><h3>Mon</h3>20 Jul</div>\n                <div class=\"times\">\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"17163\" data-filters=\"\" data-start-time=\"2026-07-20T10:30:00\" href=\"/bookings/17163/\">\n    10:30\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n            <span class=\"screening-type\">£6 Monday!</span>\n        \n        \n    \n    \n        <span class=\"screen\">S1</span>\n    \n</a>\n\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"17164\" data-filters=\"\" data-start-time=\"2026-07-20T14:00:00\" href=\"/bookings/17164/\">\n    14:00\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n            <span class=\"screening-type\">£6 Monday!</span>\n        \n        \n    \n    \n        <span class=\"screen\">S1</span>\n    \n</a>\n\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"17165\" data-filters=\"\" data-start-time=\"2026-07-20T17:30:00\" href=\"/bookings/17165/\">\n    17:30\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n            <span class=\"screening-type\">£6 Monday!</span>\n        \n        \n    \n    \n        <span class=\"screen\">S1</span>\n    \n</a>\n\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"17166\" data-filters=\"\" data-start-time=\"2026-07-20T21:00:00\" href=\"/bookings/17166/\">\n    21:00\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\