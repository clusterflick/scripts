ority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-08-11 19:18:03\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-08-31\"},{\"movie_id\":\"1164\",\"type\":\"movie\",\"movie_name\":\"The Odyssey\",\"date_release_date\":\"2026-07-17\",\"movie_end_date\":null,\"movie_countries\":\"United Kingdom, USA\",\"genre\":[{\"name\":\"Action\"},{\"name\":\"Adventure\"},{\"name\":\"Drama\"},{\"name\":\"Epic\"}],\"synopsis\":\"<p>Christopher Nolan&rsquo;s The Odyssey is a mythic action epic based on Homer&rsquo;s ancient Greek epic poem, written nearly three thousand years ago. Matt Damon stars as Odysseus, the King of Ithaca, who embarks on a treacherous journey home after the Trojan War. His voyage is fraught with peril and adventure: battling the Cyclops Polyphemus, resisting the allure of the Sirens, and encountering enchantresses like Calypso. Meanwhile, his wife Penelope (Anne Hathaway) faces relentless suitors vying for her hand, while their son, Telemachus (Tom Holland), seeks news of his father.<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">strong violence<\\/span><\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>This film contains sequences of flashing lights which may affect viewers who are susceptible to photosensitive epilepsy or other photosensitivities.&nbsp;<\\/strong><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1776121826Digital_ODY_crt_1Sheet_crn_HelmetOneSheet_siz_947x1500_cta_Release-Date_cou_UK_Eng_des.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1781987998CT-03414.webp\",\"url_key\":\"the-odyssey\",\"page_link\":\"https:\\/\\/www