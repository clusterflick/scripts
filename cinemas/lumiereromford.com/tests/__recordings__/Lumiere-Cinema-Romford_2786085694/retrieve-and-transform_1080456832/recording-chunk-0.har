          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"1354\",\"type\":\"movie\",\"movie_name\":\"Verity: Book Club & Private Screening - hosted by Read Between the Wines\",\"date_release_date\":\"2026-10-03\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Drama\"},{\"name\":\"Thriller\"}],\"synopsis\":\"<p>Join us for a very special&nbsp;Verity Book Club & Private Screening,&nbsp;the ultimate afternoon for Colleen Hoover fans. Since&nbsp;Verity&nbsp;took BookTok by storm and became one of the most talked-about thrillers online, everyone has been counting down to finally seeing it on screen&hellip; and now we get to experience it together!<\\/p>\\r\\n<p>Grab your popcorn and prosecco, and get ready to dive deep into all the twists, theories, red flags, and jaw-dropping moments that made&nbsp;Verity&nbsp;such a viral obsession.<\\/p>\\r\\n<p><strong>Please note:&nbsp;You must read&nbsp;Verity&nbsp;before attending so you can fully join in the discussion!<\\/strong><\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong><a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/verity-book-club-private-screening-tickets-1989908600190\\\" target=\\\"_blank\\\">Grab your tickets and get full information about timings for the day and what is included directly from the host here<\\/a><\\/strong><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/178283288161tBuD7V17L.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1782832825image_60.webp\",\"url_key\":\"verity-reading-between-the-wines-book-club-at-lumiere\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/verity-reading-between-the-wines-book-club-at-lumiere?location=romford&locationKey=4\",\"session_start_date\":\"2026-10-03\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=i36Zw32GfRQ\",\"trailer_type\":\"1\",\"trailer_id\":\"i36Zw32GfRQ\",\"duration\":\"4h 0m\",\"movie_year\":\"\",\"cast\":[],\"directed_by\":[],\"movie_tags\":[],\"movie_language\":[],\"movie_certification_type_id\":\"3\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/18cert1741549184.svg\",\"movie_certification_name\":\"18\",\"movie_certification_short_code\":\"18\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"1\",\"third_party_system_url\":\"https:\\/\\/www.eventbrite.com\\/e\\/verity-book-club-private-screening-tickets-1989908600190\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"16516\",\"show_time_uuid\":\"N3FseEVUSFJXbVg4SlNXTjc1WVBuUT09\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/verity-reading-between-the-wines-book-club-at-lumiere\\/showtimes\\/2026-10-03\\/romford\\/seat-plan?showtime=N3FseEVUSFJXbVg4SlNXTjc1WVBuUT09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"\",\"screen_name\":\"Screen 5\",\"session_start_date\":\"2026-10-03\",\"show_time_slots\":\"2:00PM\",\"show_time_hours\":\"14.00\",\"time_sorting\":1791032400,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_acc