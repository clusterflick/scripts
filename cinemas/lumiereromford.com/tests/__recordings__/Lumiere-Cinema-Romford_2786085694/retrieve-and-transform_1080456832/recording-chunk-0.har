          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"739\",\"type\":\"movie\",\"movie_name\":\"The Muppet Christmas Carol Sing-a-long!\",\"date_release_date\":\"1992-12-11\",\"movie_end_date\":null,\"movie_countries\":\"USA, UK\",\"genre\":[{\"name\":\"Comedy\"},{\"name\":\"Drama\"},{\"name\":\"Family\"}],\"synopsis\":\"<p>The Muppets put their spin on the tale of an elder, Christmas-hating miser who is visited by spirits who foretell his future and share secrets from his past and present, which helps change his view on life.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Enjoy the magic of this Christmas classic in this sing-a-long edition!&nbsp;<\\/strong><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/ssrV29QSVVJuemBHho0Qx7pFYak.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/2WWs8PqWcx34CsvqvVVQahdvUw8.webp\",\"url_key\":\"the-muppet-christmas-carol-1992\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/the-muppet-christmas-carol-1992?location=romford&locationKey=4\",\"session_start_date\":\"2026-12-05\",\"imdb_rate\":\"7.8\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=CVAUtzgfumk\",\"trailer_type\":\"1\",\"trailer_id\":\"CVAUtzgfumk\",\"duration\":\"1h 25m\",\"movie_year\":\"1992\",\"cast\":[{\"actor\":\"Michael Caine\"},{\"actor\":\"Dave Goelz\"},{\"actor\":\"Steve Whitmire\"}],\"directed_by\":[{\"name\":\"Brian Henson\"}],\"movie_tags\":[{\"id\":\"45\",\"name\":\"Sing-a-long!\",\"short_name\":\"singalong\",\"description\":\"\"},{\"id\":\"83\",\"name\":\"Greatest Christmas Movies\",\"short_name\":\"XMAS\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"4\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/PGcert1741549154.svg\",\"movie_certification_name\":\"PG\",\"movie_certification_short_code\":\"PG\",\"movie_certification_description\":\