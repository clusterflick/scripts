            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"1359\",\"type\":\"movie\",\"movie_name\":\"All I Ever Wanted\",\"date_release_date\":\"2026-08-14\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Drama\"},{\"name\":\"Indie\"}],\"synopsis\":\"<p>A struggling single mother riddled with debt, has to start working after the death of her husband. This film follows her journey into self-discovery and happiness with a few challenges along the way.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1775938720Untitled-c-1783124006-5972.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1775938719image_33-c-1783124006-1274.webp\",\"url_key\":\"all-i-ever-wanted-2026\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/all-i-ever-wanted-2026?location=romford&locationKey=4\",\"session_start_date\":\"2026-08-15\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=H1xwN_1TzGs\",\"trailer_type\":\"1\",\"trailer_id\":\"H1xwN_1TzGs\",\"duration\":\"2h 0m\",\"movie_year\":\"\",\"cast\":[{\"actor\":\"Eliza Okusanya\"},{\"actor\":\"John Remedy\"},{\"actor\":\"Princess Abiye\"},{\"actor\":\"Danny Erskene\"},{\"actor\":\"Freddie Greene\"}],\"directed_by\":[{\"name\":\"MK Cypher, Producer: Princess Abiye\"}],\"movie_tags\":[{\"id\":\"60\",\"name\":\"Indie cinema\",\"short_name\":\"indie\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"4\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/PGcert1741549154.svg\",\"movie_certification_name\":\"PG\",\"movie_certification_short_code\":\"PG\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\"