_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-09-03\"},{\"movie_id\":\"1532\",\"type\":\"movie\",\"movie_name\":\"Never Had a Chance\",\"date_release_date\":\"2026-08-29\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Crime\"},{\"name\":\"Drama\"}],\"synopsis\":\"<p>Never Had a Chance is a gritty British-Asian drama set in Hounslow, West London.<\\/p>\\r\\n<p>Ravi, held back by a criminal past, scrapes by dealing weed while longing for a better life with Sukhi. When his friend Jay drags him into a dangerous debt with a local gangster, everything spirals&mdash;ending in tragedy.<\\/p>\\r\\n<p>With nothing left to lose, Ravi takes one final risk to make things right before fleeing the city with Sukhi in search of a new beginning.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">Very strong language, strong injury detail<\\/span><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1787581204never_had_A_chance_1sheet_v2_1.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1787581203A068C008_231114_RNPA-4807.webp\",\"url_key\":\"never-had-a-chance-2026\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/never-had-a-chance-2026?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-03\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=VbxzdfYdKz4\",\"trailer_type\":\"1\",\"trailer_id\":\"VbxzdfYdKz4\",\"duration\":\"2h 2m\",\"movie_year\":\"2026\",\"cast\":[{\"actor\":\"Amar Chaggar\"},{\"actor\":\"Tina Sharma\"},{\"actor\":\"Jayant Singh\"}],\"directed_by\":[{\"name\":\"Jazz Bhalla\"}],\"movie_tags\":[{\"id\":\"60\",\"name\":\"Indie cinema\",\"short_name\":\"indie\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"3\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/im