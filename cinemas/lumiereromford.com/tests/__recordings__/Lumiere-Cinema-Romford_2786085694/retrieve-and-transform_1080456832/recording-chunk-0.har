guage\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-07-06 20:09:23\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-08-08\"},{\"movie_id\":\"1202\",\"type\":\"movie\",\"movie_name\":\"The Nightmare Man\",\"date_release_date\":\"1981-05-01\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Fantasy\"},{\"name\":\"Horror\"},{\"name\":\"Mystery\"}],\"synopsis\":\"<p>A heavy fog cuts the small isolated Scottish island off from the mainland, and dentist Michael Gaffikin has just discovered a dismembered corpse on the golf links. Michael and his artist girlfriend, Fiona Patterson, assist the local law enforcements in searching for the murderer. However, as the body count rises and the surrounding circumstances turn increasingly bizarre and gruesome, everyone begins to wonder if the killer is a human or an unimaginable creature...<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1777239327The-Nightmare-Man-1981-television-series-03.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1777239327nightmare_man.webp\",\"url_key\":\"the-nightmare-man-1981\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/the-nightmare-man-1981?lo