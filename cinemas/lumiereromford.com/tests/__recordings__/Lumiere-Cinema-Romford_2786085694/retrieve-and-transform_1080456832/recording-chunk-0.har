e_countries\":\"United Kingdom\",\"genre\":[{\"name\":\"Action\"},{\"name\":\"Adventure\"},{\"name\":\"Spy\"},{\"name\":\"Thriller\"}],\"synopsis\":\"<p>Diamonds are stolen only to be sold again in the international market. James Bond infiltrates a smuggling mission to find out who's guilty. The mission takes him to Las Vegas where Bond meets his archenemy Blofeld.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">Contains moderate language, violence and threat<\\/span><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/ooDT0eKrWCxJCsn9JehPkD0QYNj.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1783778025diamonds-are-forever-1200-1200-675-675-crop-000000.webp\",\"url_key\":\"diamonds-are-forever-1971\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/diamonds-are-forever-1971?location=romford&locationKey=4\",\"session_start_date\":\"2026-07-19\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=9yOamj4mlnE\",\"trailer_type\":\"1\",\"trailer_id\":\"9yOamj4mlnE\",\"duration\":\"2h 20m\",\"movie_year\":\"1971\",\"cast\":[{\"actor\":\"Sean Connery\"},{\"actor\":\"Jill St. John\"},{\"actor\":\"Charles Gray\"}],\"directed_by\":[{\"name\":\"Guy Hamilton\"}],\"movie_tags\":[{\"id\":\"37\",\"name\":\"Classic cinema\",\"short_name\":\"classic\",\"description\":\"\"},{\"id\":\"115\",\"name\":\"James Bond season\",\"short_name\":\"Bond\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"1\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/12Acert1741549098.svg\",\"movie_certification_name\":\"12A\",\"movie_certification_short_code\":\"12A\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",