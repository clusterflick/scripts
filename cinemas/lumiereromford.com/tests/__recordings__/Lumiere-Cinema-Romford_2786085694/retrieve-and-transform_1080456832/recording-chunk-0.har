imes_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-05-15 21:13:11\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-07-18\"},{\"movie_id\":\"1389\",\"type\":\"movie\",\"movie_name\":\"Shaken Not Stirred: James Bond Double Bill\",\"date_release_date\":\"2026-07-18\",\"movie_end_date\":null,\"movie_countries\":\"United Kingdom\",\"genre\":[{\"name\":\"Action\"},{\"name\":\"Adventure\"},{\"name\":\"Spy\"},{\"name\":\"Thriller\"}],\"synopsis\":\"<p>Join us for&nbsp;Operation: Double-Bill, a cinematic experience celebrating two classic adventures from the iconic James Bond series.<\\/p>\\r\\n<p>Enjoy a back-to-back screening of:&nbsp;<strong>Diamonds Are Forever<\\/strong> &&nbsp;<strong>For Your Eyes Only<\\/strong><\\/p>\\r\\n<p>This special event is a thank-you to our members and the wider James Bond community &mdash; a rare opportunity to immerse yourself in the world of 007 on the big screen with fellow Bond enthusiasts.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Event Details:<\\/strong><\\/p>\\r\\n<p><strong>Date:&nbsp;Saturday 18th July<\\/strong><br \\/><strong>Venue:&nbsp;Lumiere Cinema, Mercury Mall, Romford<\\/strong><\\/p>\\r\\n<ul>\\r\\n<li><strong>Entry From: 11:30 am<\\/strong><\\/li>\\r\\n<li><strong>Doors open: 11:50 am<\\/strong><\\/li>\\r\\n<li><strong>Quick intro: 12.10<\\/strong><\\/li>\\r\\n<li><strong>Diamonds Are Forever: 12.15pm<\\/strong><\\/li>\\r\\n<li><strong>Break 2:15pm-2.45pm<\\/strong><\\/li>\\r\\n<li><strong>For Your Eyes Only: 2:45pm<\\/strong><\\/li>\\r\\n<li><strong>Ends: 5:00pm<\\/strong><\\/li>\\r\\n<\\/ul>\\r\\n<p><br \\/><strong>Sit back, relax, and experience the glamour, intrigue, and action that only Bond can deliver.<\\/strong><\\/p>\\r\\n<p>Important Information:<\\/p>\\r\\n<p><br \\/>Seating is on a first come first served basis &mdash; early arrival is recommended<br \\/>We look forward to welcoming you for an unforgettable double feature.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Please note this is a third-party hosted event, <a href=\\\"https:\\/\\/www.lumiereromford.com\\/movies\\/shaken-not-stirred-july2026\\\" target=\\\"_blank\\\">and tickets must be bought via their website here<\\/a><\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">Contains moderate language, violence and threat<\\/span><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1783786059images_1.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1783786059f7d01psjdtpjctidqbz1.webp\",\"url_key\":\"shaken-not-stirred-july2026\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/shaken-not-stirred-july2026?location=romford&locationKey=4\",\"session_start_date\":\"2026-07-18\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=9yOamj4mlnE\",\"trailer_type\":\"1\",\"trailer_id\":\"9yOamj4mlnE\",\"duration\":\"5h 0m\",\"movie_year\":\"1971\",\"cast\":[{\"actor\":\"Sean Connery\"},{\"actor\":\"Jill St. John\"},{\"actor\":\"Charles Gray\"}],\"directed_by\":[{\"name\":\"Guy Hamilton\"}],\"movie_tags\":[{\"id\":\"37\",\"name\":\"Classic cinema\",\"short_name\":\"classic\",\"description\":\"\"},{\"id\":\"115\",\"name\":\"James