          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"396\",\"type\":\"movie\",\"movie_name\":\"The Royal Ballet: Woolf Works\",\"date_release_date\":\"2026-02-09\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Opera and Ballet\"}],\"synopsis\":\"<p>Virginia Woolf defied literary conventions to depict rich inner worlds &ndash; her heightened, startling and poignant reality.<\\/p>\\r\\n<p>Resident Choreographer Wayne McGregor leads a luminous artistic team to evoke Woolf&rsquo;s signature stream-of-consciousness writing style in this immense work, which rejects traditional narrative structures.<\\/p>\\r\\n<p>Woolf Works is a collage of themes from Mrs Dalloway, Orlando, The Waves and Woolf&rsquo;s other writings.<\\/p>\\r\\n<p>Created in 2015 for The Royal Ballet, this Olivier-award-winning ballet triptych captures the heart of Woolf&rsquo;s uniquely artistic spirit.<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1754094867Woolf_Works-Poster-Portrait.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1754094867Woolf_Works-Poster-Landscape.webp\",\"url_key\":\"royalballet-woolfworks\",\"session_start_date\":\"2026-02-09\",\"imdb_rate\":\"0.0\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"3h 45m\",\"movie_year\":\"\",\"cast\":[],\"directed_by\":[],\"movie_tags\":[{\"id\":\"61\",\"name\":\"Ballet and Opera\",\"short_name\":\"ballet_ope\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"0\",\"movie_certification_logo\":null,\"movie_certification_name\":null,\"movie_certification_description\":null,\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"4553\",\"show_time_uuid\":\"dE5LbjVkMDUwd01LelJEZzdDWTlBZz09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"4\",\"screen_name\":\"Screen 8\",\"session_start_date\":\"2026-02-09\",\"show_time_slots\":\"7:15pm\",\"show_time_hours\":\"19.15\",\"time_sorting\":1770664500,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"2026-02-09 07:15pm\",\"show_time_created_at\":\"2025-08-08 00:54:10\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-02-09\"}],\"page_number\":1,\"per_page\":100,\"total_pages\":1},\"x_signature\":\"YdD5AP0KVujlx\\/FoNV8GiVad+0XiWNqgruXRIffnzBkEmeBaYTEcskj7XoDP8epSdnLmqjhqE6kb56KK5jW1FYQOGP9FTFs4Rb9CLX50bHIbPoOgOc0bxVzdzQYa+hN9YfmSusS5lHDUCpZhhPqBQvmJKmJftFf6Dv8dDaIOW9+9JlxLMQusjmm+Uc\\/qXlBGBnOTBrui8FpSziCeGpCSrNPaOU2oIScQAFe17eT98L4TOIbDdfvVwZlK835YhiaUiIXAsd38gNuleLKmfhHuBTjM6fKfLZDdiZywCdlKV41kX1YU7zeto8M3folxFA8zxYuUiiBK0C8ruEjMkSgpIg==\",\"timestamp\":\"1764019883\"}",
