            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"778\",\"type\":\"movie\",\"movie_name\":\"National Lampoon's Animal House\",\"date_release_date\":\"1978-07-28\",\"movie_end_date\":null,\"movie_countries\":\"USA\",\"genre\":[{\"name\":\"Comedy\"}],\"synopsis\":\"<p>At a 1962 college, Dean Vernon Wormer is determined to expel the entire Delta Tau Chi Fraternity, but those troublemakers have other plans for him.<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/fWooBbipMRIKeSRhEzmeaDV0T8H.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/xJo6Spo55Amfbr3Nu24NUyE2MAx.webp\",\"url_key\":\"national-lampoon-s-animal-house-1978\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/national-lampoon-s-animal-house-1978?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-15\",\"imdb_rate\":\"7.4\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=KWjtI6n5xWM\",\"trailer_type\":\"1\",\"trailer_id\":\"KWjtI6n5xWM\",\"duration\":\"1h 49m\",\"movie_year\":\"1978\",\"cast\":[{\"actor\":\"John Belushi\"},{\"actor\":\"Karen Allen\"},{\"actor\":\"Tom Hulce\"}],\"directed_by\":[{\"name\":\"John Landis\"}],\"movie_tags\":[],\"movie_language\":[],\"movie_certification_type_id\":\"5\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/15cert1741549310.svg\",\"movie_certification_name\":\"15\",\"movie_certification_short_code\":\"15\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"17213\",\"show_time_uuid\":\"djVpRGxvZnRYYnBqbTZMZzU3