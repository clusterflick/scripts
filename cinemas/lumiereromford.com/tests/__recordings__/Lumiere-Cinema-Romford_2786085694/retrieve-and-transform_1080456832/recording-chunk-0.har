            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"1409\",\"type\":\"movie\",\"movie_name\":\"Jurassic Park: Steven Spielberg season\",\"date_release_date\":\"2026-09-01\",\"movie_end_date\":null,\"movie_countries\":\"United States of America\",\"genre\":[{\"name\":\"Adventure\"}],\"synopsis\":\"<p>Experience one of the biggest films in motion picture history with director Steven Spielberg&rsquo;s ultimate thrill ride, Jurassic Park. Featuring Academy Award&reg;-winning visual effects and ground-breaking filmmaking that has been hailed as &ldquo;a triumph of special effects artistry&rdquo; (Roger Ebert, Chicago Sun-Times), this epic film is sheer movie-making magic that was 65 million years in the making.<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1784570258s-l1200.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/17844875620060433.webp\",\"url_key\":\"jurassic-park-1993\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/jurassic-park-1993?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-24\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=Rz_FvTXa_qY\",\"trailer_type\":\"1\",\"trailer_id\":\"Rz_FvTXa_qY\",\"duration\":\"2h 27m\",\"movie_year\":\"1993\",\"cast\":[{\"actor\":\"Sam Neill\"},{\"actor\":\"Laura Dern\"},{\"actor\":\"Jeff Goldblum\"}],\"directed_by\":[{\"name\":\"Steven Spielberg\"}],\"movie_tags\":[{\"id\":\"37\",\"name\":\"Classic cinema\",\"short_name\":\"classic\",\"description\":\"\"},{\"id\":\"119\",\"name\":\"Steven Spielberg season\",\"short_name\":\"spielberg\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"1\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/12Acert1741549098.svg\",\"movie_certification_name\":\"12A\",\"movie_certification_short_code\":\"12A\",\"movie_certification_d