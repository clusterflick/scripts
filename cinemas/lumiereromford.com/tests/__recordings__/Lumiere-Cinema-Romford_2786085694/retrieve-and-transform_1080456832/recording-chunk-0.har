            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"1360\",\"type\":\"movie\",\"movie_name\":\"Harbinger\",\"date_release_date\":\"2026-08-07\",\"movie_end_date\":null,\"movie_countries\":\"United Kingdom\",\"genre\":[{\"name\":\"Horror\"},{\"name\":\"Indie\"}],\"synopsis\":\"<p>Julia, sole survivor of late serial killer Decker, is lured back to the house she shared with him for a ghost hunting TV show. The crew discover the 'Harbinger' - a fairground fortune telling machine that reveals their fates one by one.<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/3CLVK1pr8QYz8Y9QY5xcvfYTAnS.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1783126544Shogun-Harbinger-288.webp\",\"url_key\":\"harbinger-2026\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/harbinger-2026?location=romford&locationKey=4\",\"session_start_date\":\"2026-08-09\",\"imdb_rate\":\"0.0\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"1h 30m\",\"movie_year\":\"2026\",\"cast\":[{\"actor\":\"Jeanine Nerissa Sothcott\"},{\"actor\":\"Peter Woodward\"},{\"actor\":\"Gary Webster\"},{\"actor\":\"Tony Sands\"},{\"actor\":\"Johnny Palmiero\"},{\"actor\":\"Carole Ann Ford\"},{\"actor\":\"Nick Nevern\"}],\"directed_by\":[{\"name\":\"James Crow\"}],\"movie_tags\":[{\"id\":\"60\",\"name\":\"Indie cinema\",\"short_name\":\"indie\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"3\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/18cert1741549184.svg\",\"movie_certification_name\":\"18\",\"movie_certification_short_code\":\"18\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this sho