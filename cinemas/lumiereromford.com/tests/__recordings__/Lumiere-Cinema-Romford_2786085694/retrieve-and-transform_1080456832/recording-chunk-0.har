            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"482\",\"type\":\"movie\",\"movie_name\":\"The Four of the Apocalypse...\",\"date_release_date\":\"1975-08-12\",\"movie_end_date\":null,\"movie_countries\":\"Italy\",\"genre\":[{\"name\":\"Fantasy\"},{\"name\":\"Western\"}],\"synopsis\":\"<p>In 1873, four petty criminals - three men and a pregnant woman - wander through the trackless terrain of Utah, where they are hounded by a sadistic bandit.<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/A0zrgqJ12f02tJrv74UHXZJvPb0.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/cdQ7d4sheNupsbDJEchC67bOzJU.webp\",\"url_key\":\"the-four-of-the-apocalypse-1975\",\"session_start_date\":\"2025-11-24\",\"imdb_rate\":\"6.3\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=9DX2ooJdLrQ\",\"trailer_type\":\"1\",\"trailer_id\":\"9DX2ooJdLrQ\",\"duration\":\"1h 27m\",\"movie_year\":\"1975\",\"cast\":[{\"actor\":\"Fabio Testi\"},{\"actor\":\"Lynne Frederick\"},{\"actor\":\"Michael J. Pollard\"}],\"directed_by\":[{\"name\":\"Lucio Fulci\"}],\"movie_tags\":[],\"movie_language\":[{\"id\":\"1\",\"name\":\"English\",\"short_name\":\"English\",\"description\":null},{\"id\":\"7\",\"name\":\"Italian\",\"short_name\":\"Ita\",\"description\":null}],\"movie_certification_type_id\":\"3\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/18cert1741549184.svg\",\"movie_certification_name\":\"18\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"8468\",\"show_time_uuid\"