esty of autofiction reveals as much as it destroys. But how far can one go to tell a story?<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">Contains strong sex references.<\\/span><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1783638338MV5BMmNkZDA0YWItNTYzMi00ZDI1LWExMmYtYTAxODJkOTViOGQzXkEyXkFqcGc@__V1_.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/ppLv2F7dhvI3wxaEoOP1E0OyBPP.webp\",\"url_key\":\"bitter-christmas-2026\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/bitter-christmas-2026?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-07\",\"imdb_rate\":\"0.0\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"2h 12m\",\"movie_year\":\"2026\",\"cast\":[{\"actor\":\"B\\u00e1rbara Lennie\"},{\"actor\":\"Leonardo Sbaraglia\"},{\"actor\":\"Aitana S\\u00e1nchez-Gij\\u00f3n\"}],\"directed_by\":[{\"name\":\"Pedro Almod\\u00f3var\"}],\"movie_tags\":[],\"movie_language\":[{\"id\":\"8\",\"name\":\"English Subtitles\",\"short_name\":\"Eng Sub\",\"description\":null},{\"id\":\"9\",\"name\":\"Spanish\",\"short_name\":\"Spa\",\"description\":null}],\"movie_certification_type_id\":\"5\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/15cert1741549310.svg\",\"movie_certification_name\":\"15\",\"movie_certification_short_code\":\"15\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"18512\",\"show_time_uuid\":\"QjFQeTBtWU9CaktDQ0J5bTdNOHRBZz09\",\"page_link\":\"https:\\/\\/ww