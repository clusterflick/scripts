sly.<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/7BAXwmFN4pZDNb9N6kzmAAwdssi.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/41Mlaj6wfjlF4wQaVH0tjfDXvMi.webp\",\"url_key\":\"picnic-at-hanging-rock-1975\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/picnic-at-hanging-rock-1975?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-16\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=CFtQMzXZZQs\",\"trailer_type\":\"1\",\"trailer_id\":\"CFtQMzXZZQs\",\"duration\":\"2h 7m\",\"movie_year\":\"1975\",\"cast\":[{\"actor\":\"Rachel Roberts\"},{\"actor\":\"Vivean Gray\"},{\"actor\":\"Helen Morse\"}],\"directed_by\":[{\"name\":\"Peter Weir\"}],\"movie_tags\":[{\"id\":\"37\",\"name\":\"Classic cinema\",\"short_name\":\"classic\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"4\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/PGcert1741549154.svg\",\"movie_certification_name\":\"PG\",\"movie_certification_short_code\":\"PG\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"18540\",\"show_time_uuid\":\"WlRwaWc1RWJ5dDYzZlpZSmNFYkFjZz09\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/picnic-at-hanging-rock-1975\\/showtimes\\/2026-09-16\\/romford\\/seat-plan?showtime=WlRwaWc1RWJ5dDYzZlpZSmNFYkFjZz09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"1\"