":\"1371\",\"type\":\"movie\",\"movie_name\":\"Dark Victory\",\"date_release_date\":\"1939-04-20\",\"movie_end_date\":null,\"movie_countries\":\"United States of America\",\"genre\":[{\"name\":\"Drama\"},{\"name\":\"Romance\"}],\"synopsis\":\"<p>Socialite Judith Traherne lives a lavish but emotionally empty life. Riding horses is one of her few joys, and her stable master is secretly in love with her. Told she has a brain tumor by her doctor, Frederick Steele, Judith becomes distraught. After she decides to have surgery to remove the tumor, Judith realizes she is in love with Dr. Steele, but more troubling medical news may sabotage her new relationship, and her second chance at life.<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/zfgRdIEV68mIvuFxkuEcP8CcvCQ.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/jsIYE5ntyzkJlGKiJcKFGYqH9yN.webp\",\"url_key\":\"dark-victory-1939\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/dark-victory-1939?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-21\",\"imdb_rate\":\"6.9\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"2h 4m\",\"movie_year\":\"1939\",\"cast\":[{\"actor\":\"Bette Davis\"},{\"actor\":\"George Brent\"},{\"actor\":\"Humphrey Bogart\"}],\"directed_by\":[{\"name\":\"Edmund Goulding\"}],\"movie_tags\":[{\"id\":\"37\",\"name\":\"Classic cinema\",\"short_name\":\"classic\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"4\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/PGcert1741549154.svg\",\"movie_certification_name\":\"PG\",\"movie_certification_short_code\":\"PG\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_sy