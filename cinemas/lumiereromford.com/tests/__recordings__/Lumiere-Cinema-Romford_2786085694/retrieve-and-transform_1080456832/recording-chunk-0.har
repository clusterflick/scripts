          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"1383\",\"type\":\"movie\",\"movie_name\":\"Bitter Christmas\",\"date_release_date\":\"2026-08-28\",\"movie_end_date\":null,\"movie_countries\":\"Spain\",\"genre\":[{\"name\":\"Comedy\"},{\"name\":\"Drama\"}],\"synopsis\":\"<p>Ra&uacute;l is a cult filmmaker in the midst of a creative crisis. When tragedy strikes one of his closest collaborators, he draws inspiration from it to write his next film. Little by little, he imagines Elsa, a filmmaker in the midst of writing a script, whose journey begins to mirror his own.<\\/p>\\r\\n<p>The two filmmakers become two sides of the same character, in a game of mirrors where the raw honesty of autofiction reveals as much as it destroys. But how far can one go to tell a story?<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">Contains strong sex references.<\\/span><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1783638338MV5BMmNkZDA0YWItNTYzMi00ZDI1LWExMmYtYTAxODJkOTViOGQzXkEyXkFqcGc@__V1_.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/ppLv2F7dhvI3wxaEoOP1E0OyBPP.webp\",\"url_key\":\"bitter-christmas-2026\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/bitter-christmas-2026?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-10\",\"imdb_rate\":\"0.0\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"2h 12m\",\"movie_year\":\"2026\",\"cast\":[{\"actor\":\"B\\u00e1rbara Lennie\"},{\"actor\":\"Leonardo Sbaraglia\"},{\"actor\":\"Aitana S\\u00e1nchez-Gij\\u00f3n\"}],\"directed_by\":[{\"name\":\"Pedro Almod\\u00f3var\"}],\"movie_tags\":[],\"movie_language\":[{\"id\":\"8\",\"name\":\"English Subtitles\",\"short_name\":\"Eng Sub\",\"description\":null},{\"id\":\"9\",\"name\":\"Spanish\",\"short_name\":\"Spa\",\"description\":null}],\"movie_certification_type_id\":\"5\",\"movie_c