:[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-08-20 01:34:01\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-09-04\"},{\"movie_id\":\"1367\",\"type\":\"movie\",\"movie_name\":\"Tampopo\",\"date_release_date\":\"1985-11-23\",\"movie_end_date\":null,\"movie_countries\":\"Japan\",\"genre\":[{\"name\":\"Comedy\"}],\"synopsis\":\"<p>In this humorous paean to the joys of food, a pair of truck drivers happen onto a decrepit roadside shop selling ramen noodles. The widowed owner, Tampopo, begs them to help her turn her establishment into a paragon of the \\\"art of noodle-soup making\\\". Interspersed are satirical vignettes about the importance of food to different aspects of human life.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">Strong sex, violence<\\/span><\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/ArYdSuX3zY9fMsE4LqmBl7xJq5R.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1787013198tampopo_28880id_043.webp\",\"url_key\":\"tampopo-1985\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/tampopo-1985?location=romford&locationKey=4\",\"session_start_date\