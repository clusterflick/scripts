/p>\\r\\n<p>&nbsp;<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1754093297Cinderell-Poster-Portrait.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1754093296Cinderell-Poster-Landscape.webp\",\"url_key\":\"royalballet-cinderella\",\"session_start_date\":\"2025-11-25\",\"imdb_rate\":\"0.0\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"3h 30m\",\"movie_year\":\"\",\"cast\":[],\"directed_by\":[],\"movie_tags\":[{\"id\":\"61\",\"name\":\"Ballet and Opera\",\"short_name\":\"ballet_ope\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"0\",\"movie_certification_logo\":null,\"movie_certification_name\":null,\"movie_certification_description\":null,\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"4180\",\"show_time_uuid\":\"QkRtcnRXQk0xZUh3OU1KdjZiMisyQT09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"4\",\"screen_name\":\"Screen 8\",\"session_start_date\":\"2025-11-25\",\"show_time_slots\":\"7:15pm\",\"show_time_hours\":\"19.15\",\"time_sorting\":1764098100,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"2025-11-25 07:15pm\",\"show_time_created_at\":\"2025-08-02 21:53:21\",\"thi