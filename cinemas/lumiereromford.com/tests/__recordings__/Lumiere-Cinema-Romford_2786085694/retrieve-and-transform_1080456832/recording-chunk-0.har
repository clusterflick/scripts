            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"1394\",\"type\":\"movie\",\"movie_name\":\"Fallen Angels by No\\u00ebl Coward\",\"date_release_date\":\"2026-10-22\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Comedy\"},{\"name\":\"Drama\"}],\"synopsis\":\"<p>Sparkling, dizzying, and deliciously potent, Fallen Angels, No&euml;l Coward&rsquo;s champagne-fresh comedy of bad manners, shocked and delighted audiences at its 1925 premiere. Two upper-class wives, their husbands away for the day, share a few toasts to their pre-marital dalliances&mdash;with the same man, who just may be en route from France to visit. Old rivalries and past scandals bubble to the surface in this intoxicating romp from one of theatre&rsquo;s comedy masters.<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1784820932BHD_FA_Poster_Trafalger_27x40.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/17840594911378.webp\",\"url_key\":\"fallen-angels\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/fallen-angels?location=romford&locationKey=4\",\"session_start_date\":\"2026-10-25\",\"imdb_rate\":\"0.0\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"2h 10m\",\"movie_year\":\"\",\"cast\":[{\"actor\":\"Rose Byrne\"},{\"actor\":\"Kelli O\\u2019Hara\"}],\"directed_by\":[{\"name\":\"Scott Ellis\"}],\"movie_tags\":[{\"id\":\"38\",\"name\":\"Event Cinema\",\"short_name\":\"event cine\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"0\",\"movie_certification_logo\":null,\"movie_certification_name\":null,\"movie_certification_short_code\":\"N\\/A\",\"movie_certification_description\":null,\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showti