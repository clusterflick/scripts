          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"1362\",\"type\":\"movie\",\"movie_name\":\"The British Horror Film Festival: in association with the Film Festival Guild\",\"date_release_date\":\"2026-09-26\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Festival\"},{\"name\":\"Horror\"},{\"name\":\"Indie\"}],\"synopsis\":\"<p>Featuring the best in independent horror! Organised by the Film Festival Guild.<\\/p>\\r\\n<p>Film screenings, filmmaker Q&As, glitzy awards, and a whole day to celebrate all things dark & daring!<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Schedule for the day (TBC)<\\/strong><\\/p>\\r\\n<ul>\\r\\n<li>Screening 1:&nbsp; 11am-1pm<\\/li>\\r\\n<li>Break for Lunch:&nbsp; 1-2pm<\\/li>\\r\\n<li>Screening 2:&nbsp; 2-4pm<\\/li>\\r\\n<li>Screening 3:&nbsp; 5-7pm<\\/li>\\r\\n<li>Break:&nbsp; 7-8pm<\\/li>\\r\\n<li>Screening 4 & Awards:&nbsp; 8-10pm<\\/li>\\r\\n<li>Drinks & Networking:&nbsp; 10pm-Close&nbsp;<\\/li>\\r\\n<\\/ul>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong><a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/the-british-horror-film-festival-2026-tickets-1990721377228\\\" target=\\\"_blank\\\">For full information about the day and to buy tickets and passes, head over to the Eventbrite page here<\\/a><\\/strong><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1783376185BritishHorrorFF_MainLogo.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1783376185BritishHorrorFF_MainLogo_-_Copy.webp\",\"url_key\":\"british-horror-film-festival-2026\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/british-horror-film-festival-2026?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-26\",\"imdb_rate\":\"0.0\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"12h 0m\",\"movie_year\":\"2026\",\"cast\":[],\"directed_by\":[],\"movie_tags\":[],\"movie_language\":[],\"movie_ce