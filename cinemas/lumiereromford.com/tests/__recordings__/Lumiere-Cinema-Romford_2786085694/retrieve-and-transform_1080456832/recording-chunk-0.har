\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-08-12 17:15:41\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"https:\\/\\/www.baskingbabies.co.uk\\/romford\",\"is_this_sold_by_third_party_system\":\"1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-09-18\"},{\"movie_id\":\"1509\",\"type\":\"movie\",\"movie_name\":\"Mockingjay - Part 1: The Hunger Games Season\",\"date_release_date\":\"2026-09-18\",\"movie_end_date\":null,\"movie_countries\":\"United States of America\",\"genre\":[{\"name\":\"Adventure\"},{\"name\":\"Thriller\"}],\"synopsis\":\"<p>After surviving the Quarter Quell, Katniss finds herself in the hidden stronghold of District 13, where the rebellion against the Capitol is gaining momentum. Struggling with the weight of becoming the symbol of resistance, she must navigate fragile alliances while trying to protect those she loves. As propaganda battles rage and Panem moves closer to full-scale war, Katniss is forced to confront the true cost of revolution.<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/4FAA18ZIja70d1Tu5hr5cj2q1sB.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/lV1P1Q5gLDXVG1ZYCxZHStkcQC3.webp\",\"url_key\":\"the-hunger-games-mockingjay-part-1-2014\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/the-hunger-games-mockingjay-part-1-2014?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-18\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=JzcYyzCZdiM\",\"trailer_type\":\"1\",\"trailer_id\":\"JzcYyzCZdiM\",\"duration\":\"2h 23m\",\"movie_year\":\"2014\",\"cast\":[{\"actor\":\"Jennifer Lawrence\"},{\"actor\":\"Josh Hutcherson\"},{\"actor\":\"Liam Hemsworth\"}],\"directed_by\":[{\"name\":\"Francis Lawrence\"}],\"movie_tags\":[{\"id\":\"124\",\"name\":\"The Hunger Games Season\",\"short_name\":\"Hunger Gam\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"1\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/12Acert1741549098.svg\",\"movie_certification_name\":\"12A\",\"movie_certification_short_code\":\"12A\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"18557\",\"show_time_uuid\":\"WUUzbTVWSlJQOUJ0TERBZFBqQXpZdz09\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/the-hunger-games-mockingjay-part-1-2014\\/showtimes\\/2026-09-18\\/romford\\/seat-plan?showtime=WUUzbTVWSlJQOUJ0TERBZFBqQXpZdz09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"1\",\"screen_name\":\"Screen 7\",\"session_start_date\":\"2026-09-18\",\"show_time_slots\":\"3:30PM\",\"show_time_hours\":\"15.30\",\"time_sorting\":1789741800,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"sub