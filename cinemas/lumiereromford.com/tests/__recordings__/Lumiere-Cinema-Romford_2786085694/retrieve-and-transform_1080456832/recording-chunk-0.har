:[{\"name\":\"Crime\"},{\"name\":\"Drama\"}],\"synopsis\":\"<p>Heroin addict Mark Renton stumbles through bad ideas and sobriety attempts with his unreliable friends --Sick Boy, Begbie, Spud and Tommy. He also has an underage girlfriend, Diane, along for the ride. After cleaning up and moving from Edinburgh to London, Mark finds he can't escape the life he left behind as Begbie and Sick Boy come knocking.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">Very strong language, strong sex, violence, hard drug use<\\/span><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/y0HmDV0bZDTtXWHqqYYbT9XoshB.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/Aw0z8bUhGljT0ots6udf1MTLEMi.webp\",\"url_key\":\"trainspotting-30\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/trainspotting-30?location=romford&locationKey=4\",\"session_start_date\":\"2026-08-25\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=r9v3UXKhVQM\",\"trailer_type\":\"1\",\"trailer_id\":\"r9v3UXKhVQM\",\"duration\":\"1h 55m\",\"movie_year\":\"1996\",\"cast\":[{\"actor\":\"Ewan McGregor\"},{\"actor\":\"Ewen Bremner\"},{\"actor\":\"Jonny Lee Miller\"},{\"actor\":\"Kelly McDonald\"},{\"actor\":\"Robert Carlyle\"}],\"directed_by\":[{\"name\":\"Danny Boyle\"}],\"movie_tags\":[{\"id\":\"37\",\"name\":\"Classic cinema\",\"short_name\":\"classic\",\"description\":\"\"},{\"id\":\"65\",\"name\":\"Anniversary re-release\",\"short_name\":\"anniversar\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"3\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/18cert1741549184.svg\",\"movie_certification_name\":\"18\",\"movie_certification_short_code\":\"18\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_t