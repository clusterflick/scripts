            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"1493\",\"type\":\"movie\",\"movie_name\":\"Doctor Who and the Silurians\",\"date_release_date\":\"1970-03-14\",\"movie_end_date\":null,\"movie_countries\":\"United Kingdom\",\"genre\":[{\"name\":\"Adventure\"},{\"name\":\"Drama\"}],\"synopsis\":\"<p>Investigating mysterious power failures and a death at an underground research centre, The Doctor discovers a colony of Silurians - prehistoric, intelligent reptiles who went into hibernation before man evolved. But now they have woken up, and they are prepared to wipe out mankind with a killer plague to get their planet back.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>The intention, is to show a complete Doctor Who story once a month beginning from the start of the Colour era, the reason is that it allows complete stories and seasons to run concurrently without voids from the start of Jon Oertwee's era and through classic who.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Please book early, the licenses for Doctor Who are quite expensive and if it appears we will not make the money to cover the screening costs we will cancel them, so please book in advance if you can so we can see we are generating enough interest.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/9AqGyd5uDPK9eylF5GOnd0e8dti.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/rQijsfq7ZSV8sHTvfIFAapgtXzG.webp\",\"url_key\":\"doctor-who-and-the-silurians-1970\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/doctor-who-and-the-silurians-1970?location=romford&locationKey=4\",\"session_start_date\":\"2026-10-11\",\"imdb_rate\":\"0.0\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"3h 20m\",\"movie_year\":\"1970\",\"cast\":[{\"actor\":\"Jon Pertwee\"},{\"actor\":\"Caroline John\"},{\"actor\":\"Nicholas Courtney\"}],\"directed_by\":[{\"name\":\"Timothy Combe\"}],\"movie_tags\":[{\"id\":\"37\",\"name\":\"Classic cinema\",\"short_name\":\"classic\",\"description\":\"\"},{\"id\":\"126\",\"name\":\"Classic Doctor Who\",\"short_name\":\"dr who\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"0\",\"movie_certification_logo\":null,\"movie_certification_name\":null,\"movie_certification_short_code\":\"N\\/A\",\"movie_certification_description\":null,\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"18031\",\"show_time_uuid\":\"emVyRHBFNWFocU9QdG14anpRUGdFUT09\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/doctor-who-and-the-silurians-1970\\/showtimes\\/2026-10-11\\/romford\\/seat-plan?showtime=emVyRHBFNWFocU9QdG14anpRUGdFUT09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"1\",\"screen_name\":\"Screen 7\",\"session_start_date\":\"2026-10-11\",\"show_time_slots\":\"11:00AM\",\"show_time_hours\":\"11.00\",\"time_sorting\":1791712800,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_