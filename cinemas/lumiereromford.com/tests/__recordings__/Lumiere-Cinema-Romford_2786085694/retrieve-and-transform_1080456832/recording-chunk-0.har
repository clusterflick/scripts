awyer, his family, and the American government, or the \\\"Midnight Express\\\".<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/6GXioArQEdxcYqOcEfMdpyJPlwx.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/f4dcx5U9X3w27e8iithmsaohF5t.webp\",\"url_key\":\"midnight-express-1978\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/midnight-express-1978?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-15\",\"imdb_rate\":\"7.4\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"2h 21m\",\"movie_year\":\"1978\",\"cast\":[{\"actor\":\"Brad Davis\"},{\"actor\":\"Irene Miracle\"},{\"actor\":\"Bo Hopkins\"}],\"directed_by\":[{\"name\":\"Alan Parker\"}],\"movie_tags\":[{\"id\":\"37\",\"name\":\"Classic cinema\",\"short_name\":\"classic\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"3\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/18cert1741549184.svg\",\"movie_certification_name\":\"18\",\"movie_certification_short_code\":\"18\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"17222\",\"show_time_uuid\":\"RWIybUltUnNSZmlPOFZaMVpiNXZLQT09\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/midnight-express-1978\\/showtimes\\/2026-09-15\\/romford\\/seat-plan?showtime=RWIybUltUnNSZmlPOFZaMVpiNXZLQT09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"1\",\"screen_name\":\"Screen 7\",\"session_start_date\":\"2026-09-15\",\"show_time_slots\":\"2:10PM\",\"show_time_hours\":\"14.10\",\"time_sorting\":1789477800,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-07-17 21:52:13\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-09-15\"},{\"movie_id\":\"1419\",\"type\":\"movie\",\"movie_name\":\"Raiders of the Lost Ark: 45th Anniversary\",\"date_release_date\":\"1981-06-12\",\"movie_end_date\":null,\"movie_countries\":\"USA\",\"genre\":[{\"name\":\"Action\"},{\"name\":\"Adventure\"}],\"synopsis\":\"<p>Steven Spielberg&rsquo;s iconic 1981 blockbuster that introduced the world to Harrison Ford&rsquo;s legendary archaeologist, Indiana Jones.<\\/p>\\r\\n<p>Whip-smart, fearless, and endlessly entertaining, Indy races against time (and the Nazis) to recover the fabled Ark of the Covenant in a globe-trotting quest packed with traps, treasure, and non-stop thrills.<\\/p>\\r\\n<p>Whether you're discovering it for the first time or revisiting an old favourite, Raiders remains the perfect mix of action, humour, and heart.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">Moderate violence, threat, horror.<\\/span><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/ceG9VzoRAVGwivFU403Wc3AHRys-c-1784593154-7739.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/ueDw7djPgKPZfph0vC43aD2EMyF-c-1784593154-7530.webp\",\"url_key\":\"raiders-of-the-lost-ark-45th\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/raiders-of-the-lost-ark-45th?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-15\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=XkkzKHCx154\",\"trailer_type\":\"1\",\"trailer_id\":\"XkkzKHCx154\",\"duration\":\"2h 15m\",\"movie_year\":\"1981\",\"cast\":[{\"actor\":\"Harrison Ford\"},{\"actor\":\"Karen Allen\"},{\"actor\":\"Paul Freeman\"}],\"directed_by\":[{\"name\":\"Steven Spielberg\"}],\"movie_tags\":[{\"id\":\"37\",\"name\":\"Classic cinema\",\"short_name\":\"classic\",\"description\":\"\"},{\"id\":\"119\",\"name\":\"Steven Spielberg season\",\"short_name\":\"spielberg\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"1\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/12Acert1741549098.svg\",\"movie_certification_name\":\"12A\",\"movie_certification_short_code\":\"12A\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"17476\",\"show_time_uuid\":\"U2s3S0dPNTBLVTBUZXEwUDlUMWlPZz09\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/raiders-of-the-lost-ark-45th\\/showtimes\\/2026-09-15\\/romford\\/seat-plan?showtime=U2s3S0dPNTBLVTBUZXEwUDlUMWlPZz09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"1\",\"screen_name\":\"Screen 2\",\"session_start_date\":\"2026-09-15\",\"show_time_slots\":\"6:00PM\",\"show_time_hours\":\"18.00\",\"time_sorting\":1789491600,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-07-21 01:25:37\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-09-15\"},{\"movie_id\":\"1423\",\"type\":\"movie\",\"movie_name\":\"Exhibition on Screen: James McNeill Whistler\",\"date_release_date\":\"2026-09-15\",\"movie_end_date\":null,\"movie_countries\":\"United Kingdom\",\"genre\":[{\"name\":\"Art\"},{\"name\":\"Documentary\"}],\"synopsis\":\"<p>In an era of great change and great beauty emerged the character of James McNeill Whistler. Considered by some to be one of the great innovators of 19th century art, he was a contemporary of the Impressionists, much admired by Van Gogh and Manet. Boldly experimental and famously witty, Whistler disrupted the strict conventions of Victorian society in pursuit of a new cult of beauty, creating &ldquo;art for art&rsquo;s sake&rdquo; and earning himself a place in the history of great art. He found a parallel between painting and music, and entitled many of his paintings \\\"\\\"arrangements\\\"\\\", \\\"\\\"harmonies\\\"\\\" and \\\"\\\"nocturnes\\\"\\\", emphasizing the importance of tonal harmony in his work. His most famous painting, Arrangement in Grey and Black No. 1 (1871), commonly known as Whistler's Mother, is a revered and often parodied portrait of motherhood. It is arguably one of the most famous paintings in history and this film will unveil the artist behind the art.<\\/p>\\r\\n<p>Tate Britain is now holding the first major retrospective of Whistler in three decades. This blockbuster exhibition promises to reawaken the world to just how important Whistler is to art history, uniting world-famous masterpieces with rarely seen works. Exhibition on Screen will bring these stunning works and the incredible story behind them to cinemas around the world while the exhibition is still running, bringing this truly global artist to a global audience. This will be an unmissable chance to get to know this visually spectacular artist and the influence he has had on those who followed.<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1787670737Whistler_portrait.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1787670736James_McNeill_Whistler,_Wapping,_1860-1864_National_Gallery_of_Art,_Washington__76_8.webp\",\"url_key\":\"james-mcneill-whistler\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/james-mcneill-whistler?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-15\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=vAiN-useAN8\",\"trailer_type\":\"1\",\"trailer_id\":\"vAiN-useAN8\",\"duration\":\"1h 50m\",\"movie_year\":\"2026\",\"cast\":[],\"directed_by\":[],\"movie_tags\":[{\"id\":\"38\",\"name\":\"Event Cinema\",\"short_name\":\"event cine\",\"description\":\"\"},{\"id\":\"44\",\"name\":\"Exhibition on Screen\",\"short_name\":\"Exhibition\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"1\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/12Acert1741549098.svg\",\"movie_certification_name\":\"12A\",\"movie_certification_short_code\":\"12A\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"17492\",\"show_time_uuid\":\"SGJBWXN4ZFY4QlY3TkpzZjVjYXJEZz09\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/james-mcneill-whistler\\/showtimes\\/2026-09-15\\/romford\\/seat-plan?showtime=SGJBWXN4ZFY4QlY3TkpzZjVjYXJEZz09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"35\",\"screen_name\":\"Screen 4\",\"session_start_date\":\"2026-09-15\",\"show_time_slots\":\"6:30PM\",\"show_time_hours\":\"18.30\",\"time_sorting\":1789493400,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restr