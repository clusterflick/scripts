            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"1282\",\"type\":\"movie\",\"movie_name\":\"Moana [live action 2026]\",\"date_release_date\":\"2026-07-10\",\"movie_end_date\":null,\"movie_countries\":\"United States of America\",\"genre\":[{\"name\":\"Adventure\"},{\"name\":\"Comedy\"},{\"name\":\"Family\"},{\"name\":\"Fantasy\"}],\"synopsis\":\"<p>Moana answers the Ocean's call and, for the first time, voyages beyond the reef of her island of Motunui with the infamous demigod Maui on an unforgettable journey to restore prosperity to her people.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Please note there will be 2D, 3D and even Sing-a-long shows of this new Moana. Check the daily showtimes for version type.<\\/strong><\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">Contains mild threat<\\/span><strong><br \\/><\\/strong><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1779325537download_24.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/lrXHXd0sFoKInEygRxu6aNiA9Xu.webp\",\"url_key\":\"moana-2026\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/moana-2026?location=romford&locationKey=4\",\"session_start_date\":\"2026-07-11\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=r9l2gHVDnMQ\",\"trailer_type\":\"1\",\"trailer_id\":\"r9l2gHVDnMQ\",\"duration\":\"2h 11m\",\"movie_year\":\"2026\",\"cast\":[{\"actor\":\"Catherine Laga\\u2018aia\"},{\"actor\":\"Dwayne Johnson\"},{\"actor\":\"Rena Owen\"}],\"directed_by\":[{\"name\":\"Thomas Kail\"}],\"movie_tags\":[],\"movie_language\":[],\"movie_certification_type_id\":\"4\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/PGcert1741549154.svg\",\"movie_certification_name\":\"PG\",\"movie_certification_short_code\":\"PG\",\"movie_certification_description\":\"\",\"is_restricted_