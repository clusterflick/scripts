s\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-08-09 10:58:23\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-11-15\"},{\"movie_id\":\"1300\",\"type\":\"movie\",\"movie_name\":\"Carmen: Royal Opera\",\"date_release_date\":\"2026-11-10\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Opera and Ballet\"}],\"synopsis\":\"<p>Under the oppressive heat of the Spanish sun, the fiercely independent Carmen attracts the attention of Don Jos&eacute;. She warns him not to fall in love with her, but his obsession knows no bounds.<\\/p>\\r\\n<p>Damiano Michieletto&rsquo;s searing production returns, casting scorching light on the lust, violence and destructive desire of Bizet&rsquo;s ever-popular opera.&nbsp;<\\/p>\\r\\n<p>An all-star cast brings this white-hot drama to life, with Ginger Costa-Jackson in the fiery title role,&nbsp;alongside Russell Thomas as the jealous and despairing Don Jos&eacute;.<\\/p>\\r\\n<p>Following his 2023 Royal Opera&nbsp;debut, Sesto Quatrini returns to conduct Bizet&rsquo;s electrifying and sensual score.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">There will be one interval during this performance.<\\/span><\\/p>\",\"portrait_image\"