            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"761\",\"type\":\"movie\",\"movie_name\":\"Remember the Night\",\"date_release_date\":\"1940-01-19\",\"movie_end_date\":null,\"movie_countries\":\"USA\",\"genre\":[{\"name\":\"Comedy\"},{\"name\":\"Drama\"},{\"name\":\"Romance\"}],\"synopsis\":\"<p>Love blooms between a sympathetic attorney and the comely shoplifter he has taken home for the Christmas holiday.<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1YSVjAs2XCCkK8zKfjqBldl9En3.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/myCAFAWAugRGorbrqOIUvUtmZzx.webp\",\"url_key\":\"remember-the-night-1940\",\"session_start_date\":\"2025-12-09\",\"imdb_rate\":\"7.6\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=LKcLcT9dOFk\",\"trailer_type\":\"1\",\"trailer_id\":\"LKcLcT9dOFk\",\"duration\":\"1h 34m\",\"movie_year\":\"1940\",\"cast\":[{\"actor\":\"Barbara Stanwyck\"},{\"actor\":\"Fred MacMurray\"},{\"actor\":\"Beulah Bondi\"}],\"directed_by\":[{\"name\":\"Mitchell Leisen\"}],\"movie_tags\":[],\"movie_language\":[],\"movie_certification_type_id\":\"4\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/PGcert1741549154.svg\",\"movie_certification_name\":\"PG\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"8457\",\"show_time_uuid\":\"WVRrRGpNZWhqRGxVdHZOU2tqeEdjQT09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"1\",\"screen_name\":\"Screen 7\",\"session_start_date\":\"2025-12-09\",\"show_time_slots\":\"10:00am\",\"show_time_hours\":\"10.00\",\"time_sorting\":1765274400,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"2025-12-09 10:00am\",\"show_time_created_at\":\"2025-10-31 17:34:59\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2025-12-09\"},{\"movie_id\":\"829\",\"type\":\"movie\",\"movie_name\":\"Sunset Boulevard: 75th Anniversary\",\"date_release_date\":\"1950-08-04\",\"movie_end_date\":null,\"movie_countries\":\"USA\",\"genre\":[{\"name\":\"Drama\"}],\"synopsis\":\"<p>Gloria Swanson as Norma Desmond, an aging silent film queen, and William Holden as the struggling writer who is held in thrall by her madness, created two of the screen's most memorable characters in Sunset Boulevard. Winner of three Academy Awards, director Billy Wilder's orchestration of the bizarre tale is a true cinematic classic. From the unforgettable opening sequence through the inevitable unfolding of tragic destiny, the film is the definitive statement on the dark and desperate side of Hollywood.<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">Contains suicide references, mild violence, language and sex references.<\\/span><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1762827280SunsetBlvd-Digital_Poster-EN-100.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/17627837820044556.webp\",\"url_key\":\"sunset-boulevard\",\"session_start_date\":\"2025-12-09\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=W80GDrwfzPQ&t=1s\",\"trailer_type\":\"1\",\"trailer_id\":\"W80GDrwfzPQ\",\"duration\":\"2h 10m\",\"movie_year\":\"1950\",\"cast\":[{\"actor\":\"William Holden\"},{\"actor\":\"Gloria Swanson\"},{\"actor\":\"Erich von Stroheim\"}],\"directed_by\":[{\"name\":\"Billy Wilder\"}],\"movie_tags\":[{\"id\":\"37\",\"name\":\"Classic cinema\",\"short_name\":\"classic\",\"description\":\"\"},{\"id\":\"65\",\"name\":\"Anniversary re-release\",\"short_name\":\"anniversar\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"4\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/PGcert1741549154.svg\",\"movie_certification_name\":\"PG\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"9078\",\"show_time_uuid\":\"bXJPZUphblFZaGdlcnJiVmxKL3c1QT09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"1\",\"screen_name\":\"Screen 3\",\"session_start_date\":\"2025-12-09\",\"show_time_slots\":\"10:00am\",\"show_time_hours\":\"10.00\",\"time_sorting\":1765274400,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 