,\"type\":\"tag\"}],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-08-20 01:56:46\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-09-10\"},{\"movie_id\":\"1491\",\"type\":\"movie\",\"movie_name\":\"Stories of Hope: London Borough of Havering Suicide Prevention Short Film Premiere - Evening session\",\"date_release_date\":\"2026-09-10\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Documentary\"}],\"synopsis\":\"<p>Join us for a short film screening, Q&A and discussion exploring hope, recovery and lived experience of suicide.<\\/p>\\r\\n<p>Members of Havering's Suicide Prevention Lived Experience Advisory Group (LEAG) have worked with Havering Adult College and Havering Public Health to co-produce a series of powerful short films exploring suicide prevention, hope and their own lived experiences. These films challenge stigma and encourage open conversations about suicide and mental health in Havering.<\\/p>\\r\\n<p><strong>The early evening session will include:<\\/strong><\\/p>\\r\\n<ul>\\r\\n<li>An exclusive screening of the lived experience short films,<\\/li>\\r\\n<li>A Q&A panel discussion with LEAG members and the film creators,<\\/li>\\r\\n<li>Opportunities for reflection, networking and refreshment.<\\/li>\\r\\n<\\/ul>\\r\\n<p>This event is open to everyone, including professionals, the public, community groups, carers and anyone interested in supporting suicide prevention and mental wellbeing.<\\/p>\\r\\n<p>Refreshments and light snacks will be provided. For venue accessibility requirements to support your attendance,&nbsp;<a href=\\\"https:\\/\\/www.lumiereromford.com\\/find-us-and-accessibility\\\" target=\\\"_blank\\\">please see&nbsp;this page.<\\/a><\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong><a href=\\\"https:\\/\\/www.eventbrite.co.uk\\/e\\/stories-of-hope-an-early-evening-suicide-prevention-short-film-premiere-tickets-1993133139875\\\" target=\\\"_blank\\\">To register for a free ticket to the event, please RSVP through this page<\\/a>&nbsp;or click on 'Buy Ticket'.<\\/strong><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1786133275ribbon-1-c-1786133412-9244.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1786133275image_60-c-1786133412-5219.webp\",\"url_key\":\"suicide-prevention-2026-evening\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/suicide-prevention-2026-evening?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-10\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=au8MwUy5wFM\",\"trailer_type\":\"1\",\"trailer_id\":\"au8MwUy5wFM\",\"duration\":\"1h 30m\",\"movie_year\":\"\",\"cast\":[],\"directed_by\":[],\"movie_tags\":[],\"movie_language\":[],\"movie_certification_type_id\":\"0\",\"movie_certification_logo\":null,\"movie_certification_name\":null,\"movie_certification_short_code\":\"N\\/A\",\"movie_certification_description\":null,\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"1\",\"third_party_system_url\":\"https:\\/\\/www.eventbrite.co.uk\\/e\\/stories-of-hope-an-early-evening-suicide-prevention-short-film-p