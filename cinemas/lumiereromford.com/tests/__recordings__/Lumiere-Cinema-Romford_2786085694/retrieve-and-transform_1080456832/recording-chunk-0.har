\\\">This film contains several sequences with flashing lights that may affect those who are susceptible to photosensitive epilepsy or have other photosensitivities.<\\/span><\\/p>\\r\\n<p><em>Mild threat, violence<\\/em><\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>This film is also available in 3D - please check the daily listings.<\\/strong><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1762300457ZOO2_PAYOFF_1SHT_AWat50pc.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1762300457ZOOTOPIA2-ONLINE-USE-_CinemaCon_GroupImage_4K.webp\",\"url_key\":\"zootropolis2\",\"session_start_date\":\"2025-11-28\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=5AwtptT8X8k\",\"trailer_type\":\"1\",\"trailer_id\":\"5AwtptT8X8k\",\"duration\":\"2h 7m\",\"movie_year\":\"2025\",\"cast\":[{\"actor\":\"Ginnifer Goodwin\"},{\"actor\":\"Jason Bateman\"},{\"actor\":\"Ke Huy Quan\"},{\"actor\":\"Idris Elba\"},{\"actor\":\"Macaulay Culkin\"}],\"directed_by\":[{\"name\":\"Jared Bush\"},{\"name\":\"Byron Howard\"}],\"movie_tags\":[],\"movie_language\":[],\"movie_certification_type_id\":\"4\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/PGcert1741549154.svg\",\"movie_certification_name\":\"PG\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"9409\",\"show_time_uuid\":\"dm5IU3R6ZjZEb3J1aDJKTmdLbjAwdz09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_t