            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"733\",\"type\":\"movie\",\"movie_name\":\"It's a Wonderful Life\",\"date_release_date\":\"1947-01-07\",\"movie_end_date\":null,\"movie_countries\":\"USA\",\"genre\":[{\"name\":\"Drama\"},{\"name\":\"Family\"},{\"name\":\"Fantasy\"}],\"synopsis\":\"<p>An angel is sent from Heaven to help a desperately frustrated businessman by showing him what life would have been like if he had never existed.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/bSqt9rhDZx1Q7UZ86dBPKdNomp2.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1764541707wonerf.webp\",\"url_key\":\"it-s-a-wonderful-life-1947\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/it-s-a-wonderful-life-1947?location=romford&locationKey=4\",\"session_start_date\":\"2026-12-24\",\"imdb_rate\":\"8.6\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=kWumEBO97l4\",\"trailer_type\":\"1\",\"trailer_id\":\"kWumEBO97l4\",\"duration\":\"2h 10m\",\"movie_year\":\"1947\",\"cast\":[{\"actor\":\"James Stewart\"},{\"actor\":\"Donna Reed\"},{\"actor\":\"Lionel Barrymore\"}],\"directed_by\":[{\"name\":\"Frank Capra\"}],\"movie_tags\":[{\"id\":\"83\",\"name\":\"Greatest Christmas Movies\",\"short_name\":\"XMAS\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"4\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/PGcert1741549154.svg\",\"movie_certification_name\":\"PG\",\"movie_certification_short_code\":\"PG\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your 