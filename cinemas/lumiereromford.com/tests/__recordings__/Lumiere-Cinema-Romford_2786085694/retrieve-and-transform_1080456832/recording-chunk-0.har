y to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"4554\",\"show_time_uuid\":\"b3RUUkpCcHU2bHBOYUpac0RxVm1Ndz09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"4\",\"screen_name\":\"Screen 8\",\"session_start_date\":\"2026-02-15\",\"show_time_slots\":\"2:00pm\",\"show_time_hours\":\"14.00\",\"time_sorting\":1771164000,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"2026-02-15 02:00pm\",\"show_time_created_at\":\"2025-08-08 00:54:54\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-02-15\"}],\"page_number\":1,\"per_page\":100,\"total_pages\":1},\"x_signature\":\"LG983IDpyfFk5aOlMfU1DcjySroW7du1yHEvbKoiHmRWZlOYJE8J2GSvwJjQF3in\\/Hx0W6lfTrO4GcO4b5I9K9MPVOX1nqWt6YTeKvJjcwvkJbHxrhiLE8tzgL+npjpYBWDLlMLPyewJh\\/\\/UlhpgERBz8dWySKyk2o\\/mnzgT11bWA7V32wKyTH5aqTizbzVd4WKfY1v8hO5sfJexUJnNxv+dR621tl+5+0hEcjAig983IvC1UWQt9QkiBmBS3+wKujxiBvshnyFhllAFtZIjEnVOeO2vhdXgGn0JJiNSpFaySZtXQ8SWAb9Z2iS4Q4q8f42snt5tss9ndPCnKxyYAA==\",\"timestamp\":\"1764019884\"}",
