          "headersSize": 1656,
          "cookies": [
            {
              "name": "cs_sessions",
              "value": "5fa5cdcdf7e5274d90b86c4c875fafe86e61be08",
              "expires": "2026-07-11T18:33:18.000Z",
              "maxAge": 3600,
              "path": "/",
              "secure": true,
