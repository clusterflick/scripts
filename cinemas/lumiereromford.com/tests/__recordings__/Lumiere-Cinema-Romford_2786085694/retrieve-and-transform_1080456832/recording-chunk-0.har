9-05\"},{\"movie_id\":\"1404\",\"type\":\"movie\",\"movie_name\":\"War of the Worlds: Steven Spielberg season\",\"date_release_date\":\"2026-08-01\",\"movie_end_date\":null,\"movie_countries\":\"United States of America\",\"genre\":[{\"name\":\"Adventure\"},{\"name\":\"Thriller\"}],\"synopsis\":\"<p>As Earth is invaded by alien tripod fighting machines, one family fights for survival.<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1784483453images_2.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/17844834530108153.webp\",\"url_key\":\"war-of-the-worlds-2005\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/war-of-the-worlds-2005?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-05\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=SM6aEEjc5hA\",\"trailer_type\":\"1\",\"trailer_id\":\"SM6aEEjc5hA\",\"duration\":\"2h 17m\",\"movie_year\":\"2005\",\"cast\":[{\"actor\":\"Tom Cruise\"},{\"actor\":\"Dakota Fanning\"},{\"actor\":\"Miranda Otto\"}],\"directed_by\":[{\"name\":\"Steven Spielberg\"}],\"movie_tags\":[{\"id\":\"37\",\"name\":\"Classic cinema\",\"short_name\":\"classic\",\"description\":\"\"},{\"id\":\"119\",\"name\":\"Steven Spielberg season\",\"short_name\":\"spielberg\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"1\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/12Acert1741549098.svg\",\"movie_certification_name\":\"12A\",\"movie_certification_short_code\":\"12A\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"18690\",\"show_time_uuid\":\"aWtmaFVaUEtBbzlDRmRRZ0VHWUZUUT09\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/war-of-the-worlds-2005\\/showtimes\\/2026-09-05\\/romford\\/seat-plan?showtime=aWtmaFVaUEtBbzlDRmRRZ0VHWUZUUT09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"1\",\"screen_name\":\"Screen 5\",\"session_start_date\":\"2026-09-05\",\"show_time_slots\":\"2:45PM\",\"show_time_hours\":\"14.45\",\"time_sorting\":1788615900,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-08-23 18:58:17\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-09-05\"},{\"movie_id\":\"1405\",\"type\":\"movie\",\"movie_name\":\"Terminator 2: Judgment Day - 35th Anniversary\",\"date_release_date\":\"2026-09-01\",\"movie_end_date\":null,\"movie_countries\":\"United States of America\",\"genre\":[{\"name\":\"Action\"},{\"name\":\"Sci-Fi\"},{\"name\":\"Thriller\"}],\"synopsis\":\"<p>A reprogrammed T-800 is sent back in time to protect young John Connor from the shape-shifting T-1000. Together with his mother Sarah, he fights to stop Skynet from triggering a nuclear apocalypse.<\\/p>\\r\\n<p><strong>Showing in 2D and 3D, see daily listings.<\\/strong><\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">Strong violence, language<\\/span><strong><br \\/><\\/strong><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1784578220download_16.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1784486171t2-3.webp\",\"url_key\":\"terminator-2-judgment-day\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/terminator-2-judgment-day?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-05\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=1S___gntWDA\",\"trailer_type\":\"1\",\"trailer_id\":\"1S___gntWDA\",\"duration\":\"2h 37m\",\"movie_year\":\"1991\",\"cast\":[{\"actor\":\"Arnold Schwarzenegger\"},{\"actor\":\"Linda Hamilton\"},{\"actor\":\"Edward Furlong\"}],\"directed_by\":[{\"name\":\"James Cameron\"}],\"movie_tags\":[{\"id\":\"37\",\"name\":\"Classic cinema\",\"short_name\":\"classic\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"5\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/15cert1741549310.svg\",\"movie_certification_name\":\"15\",\"movie_certification_short_code\":\"15\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"17469\",\"show_time_uuid\":\"dWt6YTFyalZUQ3VEeVR5U0VWYnh3UT09\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/terminator-2-judgment-day\\/showtimes\\/2026-09-05\\/romford\\/seat-plan?showtime=dWt6YTFyalZUQ3VEeVR5U0VWYnh3UT09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"1\",\"screen_name\":\"Screen 2\",\"session_start_date\":\"2026-09-05\",\"show_time_slots\":\"6:00PM\",\"show_time_hours\":\"18.00\",\"time_sorting\":1788627600,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-07-21 01:01:48\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-09-05\"},{\"movie_id\":\"1367\",\"type\":\"movie\",\"movie_name\":\"Tampopo\",\"date_release_date\":\"1985-11-23\",\"movie_end_date\":null,\"movie_countries\":\"Japan\",\"genre\":[{\"name\":\"Comedy\"}],\"synopsis\":\"<p>In this humorous paean to the joys of food, a pair of truck drivers happen onto a decrepit roadside shop selling ramen noodles. The widowed owner, Tampopo, begs them to help her turn her establishment into a paragon of the \\\"art of noodle-soup making\\\". Interspersed are satirical vignettes about the importance of food to different aspects of human life.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">Strong sex, violence<\\/span><\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/ArYdSuX3zY9fMsE4LqmBl7xJq5R.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1787013198tampopo_28880id_043.webp\",\"url_key\":\"tampopo-1985\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/tampopo-1985?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-05\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=0RtXSon0yMw\",\"trailer_type\":\"1\",\"trailer_id\":\"0RtXSon0yMw\",\"duration\":\"2h 15m\",\"movie_year\":\"1985\",\"cast\":[{\"actor\":\"Tsutomu Yamazaki\"},{\"actor\":\"Nobuko Miyamoto\"},{\"actor\":\"Ken Watanabe\"}],\"directed_by\":[{\"name\":\"J\\u016bz\\u014d Itami\"}],\"movie_tags\":[{\"id\":\"37\",\"name\":\"Classic cinema\",\"short_name\":\"classic\",\"description\":\"\"}],\"movie_language\":[{\"id\":\"4\",\"name\":\"Japanese\",\"short_name\":\"Jpn\",\"description\":null},{\"id\":\"8\",\"name\":\"English Subtitles\",\"short_name\":\"Eng Sub\",\"description\":null}],\"movie_certification_type_id\":\"5\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/15cert1741549310.svg\",\"movie_certification_name\":\"15\",\"movie_certification_short_code\":\"15\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"18143\",\"show_time_uuid\":\"eHNTbzRhUlRRZU9CTnZqNzFzR0hSQT09\",\"page_link\":\"https:\\/\\/www.lumiereromford.c