            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"821\",\"type\":\"movie\",\"movie_name\":\"CBeebies Panto 2025: Cinderella\",\"date_release_date\":\"2025-11-22\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Family\"},{\"name\":\"Musical\"}],\"synopsis\":\"<p>Join Cinderella, Buttons and some funny new characters for a story that celebrates finding your thing!<\\/p>\\r\\n<p>Sparkling with CBeebies&rsquo; stars, this unique adaption of a pantomime classic is full of music, magic and festive fun for all the family - plus a song exclusive to cinemas!<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1762735751Vue_Lumiere_-_CBeebies_Panto_2025__Cinderella.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1762735750cbeebies-panto-2025-cinderella.webp\",\"url_key\":\"cbeebies-panto-2025-cinderella\",\"session_start_date\":\"2025-11-30\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=OXP4TNdKOHk\",\"trailer_type\":\"1\",\"trailer_id\":\"OXP4TNdKOHk\",\"duration\":\"1h 20m\",\"movie_year\":\"\",\"cast\":[],\"directed_by\":[],\"movie_tags\":[],\"movie_language\":[],\"movie_certification_type_id\":\"2\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/Ucert1741549224.svg\",\"movie_certification_name\":\"U\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"8876\",\"show_time_uuid\":\"bVREeFczMkV4N1ovVWI2OGhxZmhaQT09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\