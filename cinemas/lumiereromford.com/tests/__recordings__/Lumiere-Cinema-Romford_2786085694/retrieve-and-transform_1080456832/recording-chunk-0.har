lywood.<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">Contains suicide references, mild violence, language and sex references.<\\/span><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1762827280SunsetBlvd-Digital_Poster-EN-100.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/17627837820044556.webp\",\"url_key\":\"sunset-boulevard\",\"session_start_date\":\"2025-12-11\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=W80GDrwfzPQ&t=1s\",\"trailer_type\":\"1\",\"trailer_id\":\"W80GDrwfzPQ\",\"duration\":\"2h 10m\",\"movie_year\":\"1950\",\"cast\":[{\"actor\":\"William Holden\"},{\"actor\":\"Gloria Swanson\"},{\"actor\":\"Erich von Stroheim\"}],\"directed_by\":[{\"name\":\"Billy Wilder\"}],\"movie_tags\":[{\"id\":\"37\",\"name\":\"Classic cinema\",\"short_name\":\"classic\",\"description\":\"\"},{\"id\":\"65\",\"name\":\"Anniversary re-release\",\"short_name\":\"anniversar\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"4\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/PGcert1741549154.svg\",\"movie_certification_name\":\"PG\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"9079\",\"show_time_uuid\":\"T2NFcFpGN3MzWGtxaVd3cnptMXFIdz09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"1\",\"screen_name\":\"Screen 5\",\"session_start_date\":\"2025-12-11\",\"show_time_slots