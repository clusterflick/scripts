ld_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-08-09\"},{\"movie_id\":\"1310\",\"type\":\"movie\",\"movie_name\":\"Andr\\u00e9 Rieu's 2026 Summer Concert: Viva Maastricht!\",\"date_release_date\":\"2026-08-08\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Music Concert\"}],\"synopsis\":\"<p>This year, Andr&eacute; Rieu celebrates a spectacular milestone - the 20th anniversary of his iconic summer concerts on the magnificent Vrijthof square - with a new concert recorded in 2026, welcoming artists never before seen on the Vrijthof stage.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\"><strong>There will be a 15 minute intermission during the screening.<\\/strong><\\/span><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/sl8Rs0d5dQbnCN5Cf5CCarfzlW0.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1781043909Still_23.webp\",\"url_key\":\"andre-rieu-viva-maastricht-2026\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/andre-rieu-viva-maastricht-2026?location=romford&locationKey=4\",\"session_start_date\":\"2026-08-09\",\"imdb_rate\":\"0.0\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"3h 0m\",\"movie_year\":\"2026\",\"cast\":[{\"actor\":\"Andr\\u00e9 Rieu\"}],\"directed_by\":[],\"movie_tags\":[{\"id\":\"38\",\"name\":\"Event Cinema\",\"short_name\":\"event cine\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"6\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/file21762743298.svg\",\"movie_certification_name\":\"TBC\",\"movie_certification_short_code\":\"tbc\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_