          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"785\",\"type\":\"movie\",\"movie_name\":\"Lucio Fulci Day\",\"date_release_date\":\"2025-10-31\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Horror\"}],\"synopsis\":\"<p>30 years ago on the 13th March 1996 the celebrated Italian Director Lucio Fulci passed away, to celebrate his life we are screening 5 of his movies, with a very clear intention to not screen the old favourites.&nbsp;<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>We'll be screening the following movies:<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Perversion Story aka One On Top Of The Other<\\/p>\\r\\n<p>Massacre Time<\\/p>\\r\\n<p>The Psychic<\\/p>\\r\\n<p>White Fang<\\/p>\\r\\n<p>Touch Of Death<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1761929986generated-image-2025-10-31.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1761929985generated-image-2025-10-31-2.webp\",\"url_key\":\"luciofulci\",\"session_start_date\":\"2026-03-13\",\"imdb_rate\":\"0.0\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"10h 45m\",\"movie_year\":\"\",\"cast\":[{\"actor\":\"Franco Nero\"},{\"actor\":\"George Hilton\"},{\"actor\":\"Jean Sorel\"},{\"actor\":\"Jennifer O'Neill\"}],\"directed_by\":[{\"name\":\"Lucio Fulci\"}],\"movie_tags\":[],\"movie_language\":[],\"movie_certification_type_id\":\"3\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/18cert1741549184.svg\",\"movie_certification_name\":\"18\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater