e\":null,\"movie_countries\":\"United Kingdom, United States of America\",\"genre\":[{\"name\":\"Drama\"},{\"name\":\"Fantasy\"},{\"name\":\"Music\"},{\"name\":\"Romance\"}],\"synopsis\":\"<p>The international hit musical comes to the big screen! Winner of eight Tony Awards in 2019 including Best Musical and the 2020 Grammy Award for Best Musical Theater Album, HADESTOWN: THE MUSICAL is the genre-defying musical blending modern American folk music with New Orleans-inspired jazz to reimagine a sweeping ancient tale of two intertwining love stories, that of young dreamers Orpheus and Eurydice, and King Hades and his wife Persephone. Filmed live on stage in London&rsquo;s West End and featuring the original Broadway stars, HADESTOWN: THE MUSICAL invites audiences on a hell-raising journey to the underworld and back.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">Tickets go live 10am on 13th August.<\\/span><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1786100121Hadestown_One_Sheet.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1786100120Hadestown_Quad.webp\",\"url_key\":\"hadestown-the-musical-2026\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/hadestown-the-musical-2026?location=romford&locationKey=4\",\"session_start_date\":\"2026-10-13\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=S9tHx2wHdpQ\",\"trailer_type\":\"1\",\"trailer_id\":\"S9tHx2wHdpQ\",\"duration\":\"2h 50m\",\"movie_year\":\"2026\",\"cast\":[{\"actor\":\"Reeve Carney\"},{\"actor\":\"Eva Noblezada\"},{\"actor\":\"Andr\\u00e9 De Shields\"}],\"directed_by\":[{\"name\":\"Brett Sullivan\"}],\"movie_tags\":[{\"id\":\"38\",\"name\":\"Event Cinema\",\"short_name\":\"event cine\",\"description\":\"\"},{\"id\":\"43\",\"name\":\"Big Screen Musicals\",\"short_name\":\"Musicals\",\"description\":\"\"}],\"movie_language\":[],\"movie_certific