es they have been given.<\\/p>\\r\\n<p><span style=\\\"text-decoration: underline;\\\">Contains strong language, sex.<\\/span><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/iG8Mf7U30mwKTr0n7l3r5bTi79f.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/iOuNtoSIg4AItzzB9pmFnlMLc27.webp\",\"url_key\":\"preparation-for-the-next-life\",\"session_start_date\":\"2025-12-15\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=dmQA8cO0lIc\",\"trailer_type\":\"1\",\"trailer_id\":\"dmQA8cO0lIc\",\"duration\":\"2h 15m\",\"movie_year\":\"2025\",\"cast\":[{\"actor\":\"Sebiye Behtiyar\"},{\"actor\":\"Fred Hechinger\"},{\"actor\":\"Alicher Adill\"}],\"directed_by\":[{\"name\":\"Bing Liu\"}],\"movie_tags\":[],\"movie_language\":[],\"movie_certification_type_id\":\"5\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/15cert1741549310.svg\",\"movie_certification_name\":\"15\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"9284\",\"show_time_uuid\":\"L24xNjJTbmt3MW9IUnhJR2xmS09Zdz09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"1\",\"screen_name\":\"Screen 5\",\"session_start_date\":\"2025-12-15\",\"show_time_slots\":\"5:30pm\",\"show_time_hours\":\"17.30\",\"time_sorting\":1765819800,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"membe