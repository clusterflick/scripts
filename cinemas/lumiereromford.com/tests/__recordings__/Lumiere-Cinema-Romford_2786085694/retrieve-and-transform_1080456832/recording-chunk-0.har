null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-08-20 01:56:18\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-09-10\"},{\"movie_id\":\"1530\",\"type\":\"movie\",\"movie_name\":\"The Incomer\",\"date_release_date\":\"2026-09-04\",\"movie_end_date\":null,\"movie_countries\":\"United Kingdom, United States of America, Ireland\",\"genre\":[{\"name\":\"Comedy\"}],\"synopsis\":\"<p>Set on a remote Scottish island, two siblings survive by hunting seabirds, retelling the stories of their ancestors, and defending the isle from dreaded &lsquo;Incomers&rsquo;. Their world is upended with the arrival of an awkward council worker who has come to uproot them from their homeland.<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/iccroKK1eUTdCnLfmp7I3YXwAKF.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/jTHrOLyS0SeBpRBfzsos060z7Cn.webp\",\"url_key\":\"the-incomer-2026\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/the-incomer-2026?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-10\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=vJ6TSvmnUEE\",\"trailer_type\":\"1\",\"trailer_id\":\"vJ6TSvmnUEE\",\"duration\":\"2h 2m\",\"movie_year\":\"2026\",\"cast\":[{\"actor\":\"Domhnall Gleeson\"},{\"actor\":\"Gayle Rankin\"},{\"actor\":\"Grant O'Rourke\"},{\"actor\":\"John Hannah\"},{\"actor\":\"Michelle Gomez\"}],\"directed_by\":[{\"name\":\"Louis Paxton\"}],\"movie_tags\":[],\"movie_language\":[],\"movie_certification_type_id\":\"6\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/file21762743298.svg\",\"movie_certification_name\":\"TBC\",\"movie_certification_short_code\":\"tbc\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"18807\",\"show_time_uuid\":\"M293RkE3YktlZC9mR0FOaGJXMXlWdz09\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/the-incomer-2026\\/showtimes\\/2026-09-10\\/romford\\/seat-plan?showtime=M293RkE3YktlZC9mR0FOaGJXMXlWdz09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"1\",\"screen_name\":\"Screen 3\",\"session_start_date\":\"2026-09-10\",\"show_time_slots\":\"12:40PM\",\"show_time_hours\":\"12.40\",\"time_sorting\":1789040400,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-08-25 18:11:11\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-09-10\"},{\"movie_id\":\"1490\",\"type\":\"movie\",\"movie_name\":\"Stories of Hope: London Borough of Havering Suicide Prevention Short Film Premiere - Afternoon session\",\"date_release_date\":\"2026-09-10\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Documentary\"}],\"synopsis\":\"<p>Join us for a short film screening, Q&A and discussion exploring hope, recovery and lived experience of suicide.<\\/p>\\r\\n<p>Members of Havering's Suicide Prevention Lived Experience Advisory Group (LEAG) have worked with Havering Adult College and Havering Public Health to co-produce a series of powerful short films exploring suicide prevention, hope and their own lived experiences. These films challenge stigma and encourage open conversations about suicide and mental health in Havering.<\\/p>\\r\\n<p><strong>The&nbsp;afternoon&nbsp;session will include:<\\/strong><\\/p>\\r\\n<ul>\\r\\n<li>An exclusive screening of the lived experience short films,<\\/li>\\r\\n<li>A Q&A panel discussion with LEAG members and the film creators,<\\/li>\\r\\n<li>Suicide prevention presentations from local partners,<\\/li>\\r\\n<li>Opportunities for reflection, networking and refreshment.<\\/li>\\r\\n<\\/ul>\\r\\n<p>This event is open to everyone, including professionals, the public, community groups, carers and anyone interested in supporting suicide prevention and mental wellbeing.<\\/p>\\r\\n<p>Refreshments and light snacks will be provided. For venue accessibility requirements to support your attendance,&nbsp;<a href=\\\"https:\\/\\/www