l},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-06-26 19:42:24\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-08-02\"},{\"movie_id\":\"308\",\"type\":\"movie\",\"movie_name\":\"Sound Bath in Stillness -  A Unique Journey of Sound at Lumiere Cinema\",\"date_release_date\":\"2025-11-02\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Meditation\"}],\"synopsis\":\"<p><strong>SOUND&nbsp;BATH&nbsp;IN STILLNESS -&nbsp;A Seated Meditation in the new Lumiere&nbsp;Cinema in Romford!<\\/strong><\\/p>\\r\\n<p>A Sound Bath Meditation at Lumiere Cinema, Romford<\\/p>\\r\\n<p>This unique experience combines the power of live sound with the atmosphere of a cinema, creating a space for deep rest, reflection, and stillness.&nbsp;<\\/p>\\r\\n<p>We begin with a guided grounding meditation, slowly immersing you in the sound of a variety of healing instruments, including gongs, Tibetan bowls, Crystal bowls, Chimes, and more.&nbsp;<\\/p>\\r\\n<p>Allow waves of sound to gently wash over you in a comfy cinema seat or a laying down spot at the front.<\\/p>\\r\\n<p><strong>Benefits of Sound Bath:<\\/strong><\\/p>\\r\\n<ul>\\r\\n<li>To induce relaxation and regulate the nervous system<\\/li>\\r\\n<li>To reduce overwhelm and find a sense of calm<\\/li>\\r\\n<li>To improve focus and sleep<\\/li>\\r\\n<\\/ul>\\r\\n<p>Age 13+, Not suitable for people with Epilepsy, Pregnant or have Metal in their body (pacemaker) - if you have any concerns or health conditions do contact us directly to discuss.&nbsp;<\\/p>\\r\\n<p>Lumiere Cinema, Level 3, The Mercury Shopping Centre, Mercury Gardens, Romford RM1 3EE - free parking on Sundays :)<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>If you are interested in booking a private group session at the cinema for a different date, please contact <a href=\\\"mailto:hello@wellsocial.org\\\">hello@wellsocial.org<\\/a>&nbsp;directly.<\\/p>\\r\\n<p><br \\/><strong>----------------------<\\/strong><br \\/>Bluerskies Mindful Creatives FB\\/INSTA: @bluerskiescreatives<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1767977528soundb.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1755698698SOUND_BATH_900_x_600_px_3.webp\",\"url_key\":\"sound-bath\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/sound-bath?location=romford&locationKey=4\",\"session_start_date\":\"2026-08-02\",\"imdb_rate\":\"0.0\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"1h 0m\",\"movie_year\":\"\",\"cast\":[],\"directed_by\":[],\"movie_tags\":[{\"id\":\"63\",\"name\":\"Arts, Crafts and Mindfulness\",\"short_name\":\"arts & min\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"0\",\"movie_certification_logo\":null,\"movie_certification_name\":null,\"movie_certification_short_code\":\"N\\/A\",\"movie_certification_description\":null,\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"1\",\"third_party_system_url\":\"https:\\/\\/www.eventbrite.co.uk\\/e\\/sound-bath-at-lumiere-cinema-tickets-1611770180999\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Pleas