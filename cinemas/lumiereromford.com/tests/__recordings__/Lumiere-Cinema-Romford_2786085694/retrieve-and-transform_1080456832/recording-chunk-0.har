          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"1539\",\"type\":\"movie\",\"movie_name\":\"Exhibition on Screen: Renoir & Love\",\"date_release_date\":\"2027-01-19\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Art\"},{\"name\":\"Documentary\"}],\"synopsis\":\"<p>Pierre-Auguste Renoir is one of the world&rsquo;s favourite artists; a founding member of the Impressionist movement and a constantly evolving artist, he is unmatched at depicting human connection. The National Gallery&rsquo;s blockbuster exhibition brings together vibrant masterpieces which explore love in all its forms, bringing colour and warmth into the cold winter months.<\\/p>\\r\\n<p>With exclusive access to this exciting new show, Exhibition on Screen will bring these world class works to cinema audiences, with close examination of the art and leading experts exploring the immense skill and influence of this master of colour and connection. Be transported back to a Parisian summer of love through the eyes of a true visionary. An unmissable opportunity to fall in love with Renoir this winter.<\\/p>\\r\\n<p>Made in close collaboration with The National Gallery, London and Musee d&rsquo;Orsay, Paris.<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/bx3HUEuH738asEZdkQspG9quvkA.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1787671193Pierre_Auguste_Renoir,_Le_Pont_des_Arts_Paris,_Norton_Simon_Museum_,_wiki.webp\",\"url_key\":\"eos-renoir\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/eos-renoir?location=romford&locationKey=4\",\"session_start_date\":\"2027-01-19\",\"imdb_rate\":\"0.0\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"1h 50m\",\"movie_year\":\"2027\",\"cast\":[],\"directed_by\":[{\"name\":\"Ali Ray\"}],\"movie_tags\":[{\"id\":\"38\",\"name\":\"Event Cinema\",\"short_name\":\"event cine\",\"description\":\"\"},{\"id\":\"44\",\"name\":\"Exhibition on Screen\",\"short_name\":\"Exhibition\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"0\",\"movie_certification_logo\":null,\"movie_certification_name\":null,\"movie_certification_short_code\":\"N\\/A\",\"movie_certification_description\":null,\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"18789\",\"show_time_uuid\":\"VFpacE0ycjhjWGYySHNXcTFkV0NCQT09\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/eos-renoir\\/showtimes\\/2027-01-19\\/romford\\/seat-plan?showtime=VFpacE0ycjhjWGYySHNXcTFkV0NCQT09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"35\",\"screen_name\":\"Screen 4\",\"session_start_date\":\"2027-01-19\",\"show_time_slots\":\"6:00PM\",\"show_time_hours\":\"18.00\",\"time_sorting\":1800381600,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-08-25 16:21:24\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2027-01-19\"}],\"page_number\":1,\"per_page\":100,\"total_pages\":1},\"x_signature\":\"IcjnGwJTZw75UDKEJzB7ncxYSDWppRxdsDFoGq+qAhsAtEYhWGfrYqf\\/n2J2GhpLx04kRcYN1\\/4iHj67Juvt2GnM+frH+6Izz3tIMNXmR1fsi3DscaNI7LCwVNuEBDNYG+v9ZJtQ\\/X\\/J4YB\\/VrGbkrsK\\/f8r80e6eRyf+8weVdzGa6G8snkySr5NvcpQBd7nKg3Q\\/KTiyoParBPmNvD\\/E8OPiSY1b\\/0mDGwkKGYH6yUz4jXcG0LiJ2RO6\\/QkaUAj698+dKTPb4\\/c6ea41HHtV3Riyp+BpUzH062ehT518A+mxQ3n3Tfhh8vegk7TiRuhUrTJ9lZZnMEzweK92zUnhg==\",\"timestamp\":\"1787679246\"}",
