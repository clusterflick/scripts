            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"1372\",\"type\":\"movie\",\"movie_name\":\"RoboCop\",\"date_release_date\":\"1987-07-17\",\"movie_end_date\":null,\"movie_countries\":\"United States of America\",\"genre\":[{\"name\":\"Thriller\"}],\"synopsis\":\"<p>In a violent, near-apocalyptic Detroit, evil corporation Omni Consumer Products wins a contract from the city government to privatize the police force. To test their crime-eradicating cyborgs, the company leads street cop Alex Murphy into an armed confrontation with crime lord Boddicker so they can use his body to support their untested RoboCop prototype. But when RoboCop learns of the company's nefarious plans, he turns on his masters.<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1784204068download_15.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/xcaX6BZ1JUPSVMH2gBkWIckLLaA.webp\",\"url_key\":\"robocop-1987\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/robocop-1987?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-23\",\"imdb_rate\":\"0.0\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"2h 2m\",\"movie_year\":\"1987\",\"cast\":[{\"actor\":\"Peter Weller\"},{\"actor\":\"Nancy Allen\"},{\"actor\":\"Dan O'Herlihy\"}],\"directed_by\":[{\"name\":\"Paul Verhoeven\"}],\"movie_tags\":[{\"id\":\"37\",\"name\":\"Classic cinema\",\"short_name\":\"classic\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"3\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/18cert1741549184.svg\",\"movie_certification_name\":\"18\",\"movie_certification_short_code\":\"18\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\"