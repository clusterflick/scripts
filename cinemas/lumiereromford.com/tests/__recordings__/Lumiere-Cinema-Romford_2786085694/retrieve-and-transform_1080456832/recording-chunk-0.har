            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"709\",\"type\":\"movie\",\"movie_name\":\"Pets on A Train\",\"date_release_date\":\"2025-10-19\",\"movie_end_date\":null,\"movie_countries\":\"USA\",\"genre\":[{\"name\":\"Animation\"},{\"name\":\"Comedy\"},{\"name\":\"Family\"}],\"synopsis\":\"<p>Falcon, a petty thief and high-flying raccoon, thought this would be a simple heist. Get on the train, steal the food, and get off.<\\/p>\\r\\n<p>But when the train is unexpectedly hijacked, he joins forces with Rex, a police dog, to save the cute pets and exotic animals on board and stop this high-speed train before it's too late!<\\/p>\\r\\n<p>&nbsp;<span style=\\\"text-decoration: underline;\\\">Mild threat, violence<\\/span><\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>We have a special preview screening of this film on Sunday 19th October.<\\/strong><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/5YfB4vCHJJHV1CLTgLZrknnpcUk.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/jWyBdGiJOMViBrXPBoz33ouRGFw.webp\",\"url_key\":\"pets-on-a-train-2025\",\"session_start_date\":\"2025-11-29\",\"imdb_rate\":\"0.0\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=QH8V0wpg18A\",\"trailer_type\":\"1\",\"trailer_id\":\"QH8V0wpg18A\",\"duration\":\"1h 47m\",\"movie_year\":\"2025\",\"cast\":[{\"actor\":\"Damien Ferrette\"},{\"actor\":\"Herv\\u00e9 Jolly\"},{\"actor\":\"Kaycie Chase\"}],\"directed_by\":[{\"name\":\"Beno\\u00eet Daffis\"},{\"name\":\"Jean-Christian Tassy\"}],\"movie_tags\":[],\"movie_language\":[],\"movie_certification_type_id\":\"4\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/PGcert1741549154.svg\",\"movie_certification_name\":\"PG\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\