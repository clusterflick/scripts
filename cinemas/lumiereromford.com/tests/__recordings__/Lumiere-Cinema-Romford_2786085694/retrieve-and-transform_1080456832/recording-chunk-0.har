at-plan?showtime=bHlrNVQwcXQyOG5HSTh1L3BiZ3Z0UT09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"1\",\"screen_name\":\"Screen 3\",\"session_start_date\":\"2026-09-14\",\"show_time_slots\":\"5:45PM\",\"show_time_hours\":\"17.45\",\"time_sorting\":1789404300,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-08-05 13:59:19\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-09-14\"},{\"movie_id\":\"1090\",\"type\":\"movie\",\"movie_name\":\"The Back Row Picture Show Film Quiz\",\"date_release_date\":\"2026-03-16\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Performing Arts\"}],\"synopsis\":\"<p><strong>\\u2728\\u2728&nbsp;Lights, Camera&hellip; Quiz Time!&nbsp;\\u2728\\u2728<\\/strong><\\/p>\\r\\n<p>Join host Chris in Screen 6 for the monthly film quiz&nbsp;&mdash; and trust us, you won&rsquo;t want to miss it!<\\/p>\\r\\n<p>Think you&rsquo;ve got what it takes to be crowned our ultimate movie masterminds? From timeless classics to modern blockbusters, this is your moment to shine!<\\/p>\\r\\n<p>Grab your fellow film fanatics, assemble your dream team (up to&nbsp;4 players per team), and get ready for a night packed with big-screen trivia, friendly competition, and plenty of cinematic surprises.<\\/p>\\r\\n<p><strong>Prices:<\\/strong><\\/p>\\r\\n<ul>\\r\\n<li>&pound;12 <em>per team <\\/em>(Lumiere Members)<\\/li>\\r\\n<li>&pound;14 <em>per team <\\/em>(Non-Members)<\\/li>\\r\\n<\\/ul>\\r\\n<p>&nbsp;&nbsp;<\\/p>\\r\\n<p>You are welcome to bring cinema-bought food into Screen 6. The Lumiere Cinema does a wide range of drinks as well as food, including popcorn, sweets, hot dogs, and pizza (pizzas take 15 minutes to cook so come in early if you want to order pizza for the quiz).<\\/p>\\r\\n<p>For Lumiere members, please ring the cinema to get the special discount code when booking via Eventbrite; however we do advise members to just pay at the door as you'll save on the booking fee.<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1782917602IMG_7523.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1772365912attachment-Movie-Quote-Quiz-feat.webp\",\"url_key\":\"the-back-row-picture-show-film-quiz-at-lumiere\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/the-back-row-picture-show-film-quiz-at-lumiere?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-14\",\"imdb_rate\":\"0.0\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"2h 0m\",\"movie_year\":\"\",\"cast\":[],\"directed_by\":[],\"movie_tags\":[{\"id\":\"104\",\"name\":\"Quiz Night at Lumiere\",\"short_name\":\"quiz night\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"3\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/18cert1741549184.svg\",\"movie_certification_name\":\"18\",\"movie_certification_short_code\":\"18\",\"movie_certification_description\":\"\",\"is_restri