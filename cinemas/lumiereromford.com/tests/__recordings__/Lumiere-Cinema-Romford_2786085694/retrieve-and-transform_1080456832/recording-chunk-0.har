          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"1374\",\"type\":\"movie\",\"movie_name\":\"Midnight Express\",\"date_release_date\":\"1978-08-31\",\"movie_end_date\":null,\"movie_countries\":\"United Kingdom, United States of America\",\"genre\":[{\"name\":\"Crime\"},{\"name\":\"Drama\"}],\"synopsis\":\"<p>Billy Hayes is caught attempting to smuggle drugs out of a country. The courts decide to make an example of him, sentencing him to more than 30 years in prison. Hayes has two opportunities for release: the appeals made by his lawyer, his family, and the American government, or the \\\"Midnight Express\\\".<\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/6GXioArQEdxcYqOcEfMdpyJPlwx.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/f4dcx5U9X3w27e8iithmsaohF5t.webp\",\"url_key\":\"midnight-express-1978\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/midnight-express-1978?location=romford&locationKey=4\",\"session_start_date\":\"2026-09-16\",\"imdb_rate\":\"7.4\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"2h 21m\",\"movie_year\":\"1978\",\"cast\":[{\"actor\":\"Brad Davis\"},{\"actor\":\"Irene Miracle\"},{\"actor\":\"Bo Hopkins\"}],\"directed_by\":[{\"name\":\"Alan Parker\"}],\"movie_tags\":[{\"id\":\"37\",\"name\":\"Classic cinema\",\"short_name\":\"classic\",\"description\":\"\"}],\"movie_language\":[],\"movie_certification_type_id\":\"3\",\"movie_certification_logo\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie_certificate\\/18cert1741549184.svg\",\"movie_certification_name\":\"18\",\"movie_certification_short_code\":\"18\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t