g_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"theater_experiences\":[],\"show_times\":[{\"show_time_id\":\"14321\",\"show_time_uuid\":\"b1VNbVNFdjQxUFpDMzY3c1VRcGF5QT09\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/echoes-in-the-darkness-1987\\/showtimes\\/2026-08-08\\/romford\\/seat-plan?showtime=b1VNbVNFdjQxUFpDMzY3c1VRcGF5QT09\",\"theater_experience_id\":\"1\",\"theater_experience_name\":\"Digital Cinema\",\"theater_experience_image\":\"Digital_Cinema_Media_Logo_1.jpg\",\"session_type_id\":\"1\",\"screen_name\":\"Screen 7\",\"session_start_date\":\"2026-08-08\",\"show_time_slots\":\"6:30PM\",\"show_time_hours\":\"18.30\",\"time_sorting\":1786210200,\"sold_out\":false,\"sold_out_text\":\"Closed\",\"screen_tags\":[],\"show_times_tags\":[],\"movie_language\":{\"name\":null,\"short_name\":null},\"member_only\":false,\"member_priority_access\":false,\"member_priority_hour\":\"0\",\"member_priority_hour_with_text\":\"Member priority access till 0. Please login to get access.\",\"member_priority_till\":\"\",\"subscriber_only\":false,\"subscriber_priority_access\":false,\"subscriber_priority_hour\":\"0\",\"subscriber_priority_hour_with_text\":\"\",\"subscriber_priority_till\":\"\",\"subscriber_restrict_free_access\":false,\"subscriber_restrict_message\":null,\"show_time_created_at\":\"2026-04-26 22:30:28\",\"third_party_system_message\":\"Sorry, this showtime isn\\u2019t available for reservation. Please contact the cinema directly to reserve your tickets.\",\"third_party_system_url\":\"\",\"is_this_sold_by_third_party_system\":\"-1\",\"seat_plan_status\":\"1\"}],\"nearest_show_times_date\":\"2026-08-08\"},{\"movie_id\":\"1322\",\"type\":\"movie\",\"movie_name\":\"NHS Choir Concert - 10th Anniversary Celebration\",\"date_release_date\":\"2026-08-08\",\"movie_end_date\":null,\"movie_countries\":\"\",\"genre\":[{\"name\":\"Music\"},{\"name\":\"Music Concert\"}],\"synopsis\":\"<p>One night only!<\\/p>\\r\\n<p>A spectacular 10th anniversary concert - music, memories and magic with your local NHS Hospitals Staff Choir. Book now!<\\/p>\\r\\n<p>Join us for a special evening of music, celebration and community as the staff choir from your local NHS Hospitals mark their 10th anniversary.<\\/p>\\r\\n<p>'10 Years of Music & Memories' is a joyful concert showcasing a decade of performances, bringing together favourite songs, uplifting harmonies and memorable moments from across the years. Performed by your local NHS Hospitals Choir, made up staff from Barking, Havering & Dagenham University Hospitals NHS Trust (Quuen's Hospital, Romford & King George Hospitals, Goodmayes) & North East London Foundation Trust, this event celebrates the power of music to connect people and support wellbeing.<\\/p>\\r\\n<p>Audiences can expect a vibrant and feel-good programme featuring a mix of contemporary hits, classic favourites and inspiring choral arrangements - all delivered with passion, warmth and energy.<\\/p>\\r\\n<p>Whether you are a long-time supporter or discovering the choir for the first time, this promises to be a memorable evening celebrating music, community, and the incredible staff behind the NHS.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong><a href=\\\"https:\\/\\/www.eventbrite.co.uk\\/e\\/nhs-choir-concert-10th-anniversary-celebration-tickets-1991195907561\\\" target=\\\"_blank\\\">Click here<\\/a> or on Buy Tickets to secure your tickets now!<\\/strong><\\/p>\",\"portrait_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/17818305054565c05b-9332-4aab-868c-62e1c30c276e.webp\",\"landscape_image\":\"https:\\/\\/lumiereromford.static.cinesync.io\\/images\\/movie\\/1781830504image_75.webp\",\"url_key\":\"nhs-choir-concert\",\"page_link\":\"https:\\/\\/www.lumiereromford.com\\/movies\\/nhs-choir-concert?l