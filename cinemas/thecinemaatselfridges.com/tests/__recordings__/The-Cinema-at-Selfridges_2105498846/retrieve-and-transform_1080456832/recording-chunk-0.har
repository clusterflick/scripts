es/the-cinema-in-the-power-station\">\n                            <img class=\"menu-promotion__image img-fluid w-100 w-lg-100\" src=\"https://m.cinemacloud.co.uk/imageHeaderFooter/hf_6a3521b6babe98.81395670.jpg\" alt=\"\">\n                        </a>\n                        <div class=\"pt-2\">The Cinema in The Power Station / Battersea</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        </div>\n                                        <div class=\"sub-menu\" id=\"subMenu3\">        <div class=\"col-12 col-xl-10 py-lg-5 px-lg-9 mx-0 mx-lg-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-sm-12 mb-4 ps-lg-7 d-flex justify-content-start\">\n                    <div class=\"menu-booknow text-start\">\n                        <p class=\"text-uppercase opacity-5 pb-2 small\" style=\"letter-spacing:0.1rem;\">Explore The Location</p>\n                        <ul class=\"nav nav-mobile-explore flex-column lh-sm\">\n                                                        <li class=\"mb-2\"><a href=\"https://www.thecinemaatselfridges.com/whats-on\" class=\"p-0\">Box Office</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/private-hire-selfridges\" class=\"p-0\">Private Hire</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/the-cloakroom-at-selfridges\" class=\"p-0\">The Cloakroom</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/film-membership-signup\" class=\"p-0\">Film Membership</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.thecinemaatselfridges.com/account\" class=\"p-0\">Login</a></li>\n                                                    </ul>\n                    </div>\n                </div>\n                <div class=\"col-8 col-lg-6 mb-2 pe-lg-7 d-flex justify-content-end\">\n                    <div class=\"menu-promotion\">\n                        <a class=\"menu-promotion__link\" href=\"https://www.olympicstudios.com/pages/the-cinema-at-selfridges\">\n                            <img class=\"menu-promotion__image img-fluid w-100 w-lg-100\" src=\"https://m.cinemacloud.co.uk/imageHeaderFooter/hf_6a3521bcd95cc8.54869616.jpg\" alt=\"\">\n                        </a>\n                        <div class=\"pt-2\">The Cinema at Selfridges / Duke Street</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        </div>\n                                    </div>\n\n            </div>\n        </div>\n    </nav>\n    <div id=\"page-submenus\" class=\"shopify-section shopify-section-group-header-group section-page-submenus\">\n        <div class=\"d-flex justify-content-evenly\">\n                    <div class=\"submenu\">\n                <a href=\"/whats-on\" class=\"\">\n                    <span class=\"tagline\">What&#039;s On</span>\n                </a>\n            </div>\n                    <div class=\"submenu\">\n                <a href=\"/whats-on/babes-in-arms\" class=\"\">\n                    <span class=\"tagline\">Babes in Arms</span>\n                </a>\n            </div>\n                    <div class=\"submenu\">\n                <a href=\"/ecards\" class=\"\">\n                    <span class=\"tagline\">Gift Cards</span>\n                </a>\n            </div>\n                    <div class=\"submenu\">\n                <a href=\"/ticket-info\" class=\"\">\n                    <span class=\"tagline\">Ticket Info</span>\n                </a>\n            </div>\n                </div>\n    </div>\n    \n</section>\n<style>\n    .cc-account-dropdown .cc-account-menu { display:none; }\n    .cc-account-dropdown:hover .cc-account-menu { display:block; }\n    .cc-account-menu-item { font-size:.8rem; color:#212529; text-decoration:none !important; display:block; }\n    .cc-account-menu-item:hover, .cc-account-menu-item:focus { background-color:#f8f9fa; color:#212529; text-decoration:none !important; }\n</style>\n<script>\ndocument.querySelectorAll('.cc-nav-signout').forEach(function(btn) {\n    btn.addEventListener('click', function() {\n        fetch('/api/account/logout', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ action: 'logout' })\n        })\n        .then(function(r) { return r.ok ? r.json() : null; })\n        .then(function() { window.location.href = '/'; })\n        .catch(function() { window.location.reload(); });\n    });\n});\n</script>\n        <section id=\"section_2_stack\" class=\"bg-dark p-0 m-0\">        <!-- Page Video Modal -->\n        <div id=\"videoModal\" class=\"modal fade\" data-bs-backdrop=\"static\" data-bs-keyboard=\"false\" tabindex=\"-1\" aria-labelledby=\"videoModalLabel\" aria-hidden=\"true\">\n            <div class=\"modal-dialog modal-dialog-centered modal-lg\">\n                <div class=\"modal-content\">\n                    <div class=\"modal-header justify-content-center position-relative\">\n                        <div class=\"w-100 text-center\">\n                            <h1 class=\"modal-title fs-5\" id=\"modalTrailerLabel\">Spider-Man: Brand New Day</h1>\n                        </div>\n                        <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\n                    </div>\n                    <div class=\"modal-body p-1 p-md-2\">\n                        <div class=\"ratio ratio-16x9\">\n                            <iframe class=\"embed-responsive-item\" allowfullscreen allow=\"autoplay\" allowfullscreen=\"true\"></iframe>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- End Page Video Modal -->\n\n            <div class=\"page-header py-5 py-md-0 ratio ratio-2x1 position-relative\">\n        <picture>\n            <source srcset=\"https://m.cinemacloud.co.uk/imageFilm/2397_7_1.jpg\" media=\"(max-width: 767.9px)\">\n            <source srcset=\"https://m.cinemacloud.co.uk/imageFilm/2397_10_1.jpg\" media=\"(min-width: 768px)\">\n            <img src=\"https://m.cinemacloud.co.uk/imageFilm/2397_10_1.jpg\" alt=\"Background\" class=\"film-header-bg w-100 h-100 position-absolute top-0 start-0 object-fit-cover\" onload=\"this.style.opacity=1;\">\n        </picture>\n        <div class=\"position-absolute w-100 w-md-50 h-50 h-md-100 bg-grad-dark\"></div>\n        <div id=\"movie-overlay\" class=\"d-flex flex-column justify-content-end justify-content-md-center align-items-center align-items-md-start h-100 mx-md-5 mx-lg-7\">\n            \n            \n            <img class=\"title-treatment mb-4 mb-md-6 my-3\" src=\"https://m.cinemacloud.co.uk/imageFilm/2397_8_1.png\" alt=\"Spider-Man: Brand New Day\" onerror=\"this.style.display='none';this.nextElementSibling.style.display=''\"><div class=\"title-treatment mb-4 mb-md-6 text-white text-left\" style=\"display:none;\"><h1 class=\"h4 text-white fw-semibold\">Spider-Man: Brand New Day</h1></div>\n            \n            <div class=\"movie-badges mb-2 d-flex justify-content-start\">\n                <span class=\"badge text-bg-secondary me-2 px-3 fw-semibold\">2026</span><span class=\"badge text-bg-secondary me-2 px-3 fw-semibold\">2hr 25mins</span><img src=\"https://m.cinemacloud.co.uk/imageMisc/Dolby/Atmos/Vertical/DLB_Atms_vert_rgb_wht_@1x.png\" class=\"cert-20 me-2\" alt=\"Movie Sound Dolby Atmos\"><img src=\"https://m.cinemacloud.co.uk/bbfc/SVGs/BBFC_tba_RGB.svg\" class=\"cert-20\" alt=\"BBFC Cert tba\">\n            </div>\n            \n            <p class=\"text-light fs-6 fw-semibold\"><small>Sci Fi, Action, Adventure</small></p>\n                        <div id=\"trailer-button\" class=\"d-none d-md-block me-md-auto mb-3\">\n                <a href=\"#\" class=\"btn btn-md rounded-pill d-inline-flex align-items-center blurred-button\"\n                   data-bs-toggle=\"modal\" data-bs-target=\"#videoModal\"\n                   data-video=\"https://www.youtube.com/embed/qwVAc2MmlwU?autoplay=1&origin=\">\n                    <i class=\"bi bi-play-fill fs-5 me-2\"></i>\n                    <span class=\"fs-6\">Trailer</span>\n                </a>\n            </div>\n            <script>\n                document.addEventListener('DOMContentLoaded', function() {\n                    const videoModal = document.getElementById('videoModal');\n                    const modalIframe = videoModal.querySelector('iframe');\n                    videoModal.addEventListener('show.bs.modal', function(event) {\n                        const button = event.relatedTarget;\n                        const url = button.getAttribute('data-video');\n                        modalIframe.setAttribute('src', url);\n                        modalIframe.setAttribute('allow', 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture');\n                    });\n                    videoModal.addEventListener('hidden.bs.modal', function() {\n                        modalIframe.removeAttribute('src');\n                        modalIframe.removeAttribute('allow');\n                    });\n                });\n            </script>\n            \n        </div>\n    </div></section><section id=\"section_3_stack\" class=\"bg-white p-0 m-0\">        <div class=\"container my-5\">\n            <div class=\"row\">\n                <!-- Left column: film info -->\n                <div class=\"col-12 col-lg-6 order-1 order-lg-0\">\n                    <h3 class=\"fjalla-one-regular fs-3 text-uppercase text-dark mb-4\">Spider-Man: Brand New Day</h3>\n                    <div class=\"d-flex mt-1 mb-4\"><img class=\"flex-shrink-1 cert-40\" src=\"https://m.cinemacloud.co.uk/bbfc/SVGs/BBFC_tba_RGB.svg\" alt=\"BBFC Cert\"><small style=\"font-size: 0.7rem;\" class=\"w-100 small ps-2 text-muted fst-italic\">Admission to film screenings is strictly in accordance with BBFC age ratings and valid proof of age may be required as a condition of entry.</small></div>                    <div id=\"trailer-button\" class=\"d-block d-md-none me-md-auto mt-0 mb-4\"><a href=\"#\" class=\"btn btn-white btn-sm btn-lg-md rounded-1\" data-bs-toggle=\"modal\" data-bs-target=\"#videoModal\" data-video=\"https://www.youtube.com/embed/qwVAc2MmlwU?autoplay=1\">Watch Trailer</a></div>                    <h3 class=\"fjalla-one-regular fs-4 text-dark mb-4\">Synopsis</h3><div class=\"mb-5 text-dark\"><p class='p1' style='margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 13px; line-height: normal; font-family: 'Helvetica Neue';'>It's a BRAND NEW DAY for Peter Parker.</p> <p class='p1' style='margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 13px; line-height: normal; font-family: 'Helvetica Neue';'> </p> <p class='p1' style='margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 13px; line-height: normal; font-family: 'Helvetica Neue';'>Fighting crime full-time as Spider-Man in a world that doesn’t remember him - and the pressure of seeing his old friends move on without him - sparks a change in Peter he may not have the power to control. But that transformation might also be the only thing that can stop a shocking new threat to the city and those he loves - a powerful villain no one can even see.</p> <p class='p1' style='margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 13px; line-height: normal; font-family: 'Helvetica Neue';'> </p> <p class='p1' style='margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 13px; line-height: normal; font-family: 'Helvetica Neue';'>The world may have forgotten Peter Parker, but he hasn’t forgotten them.</p></div>                                                            <div class=\"row\">\n                        <div class=\"col-7 col-md-8\">\n                                                                                    <p class=\"mb-1 fw-semibold text-secondary\">Duration:</p><p class=\"mt-0 fw-bolder\">2hr 25mins</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Available Sound Formats:</p><p class=\"mt-0 fw-bolder sound-formats\">Dolby Atmos</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Genre:</p><p class=\"mt-0 fw-bolder\">Sci Fi, Action, Adventure</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Country:</p><p class=\"mt-0 fw-bolder\">United States</p>                        </div>\n                        <div class=\"col-5 col-md-4\">\n                            <p class=\"mb-1 fw-semibold text-secondary\">Director:</p><p class=\"mt-0 fw-bolder\">Destin Daniel Cretton</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Starring:</p><p class=\"mt-0 fw-bolder\">Tom Holland,<br> Zendaya,<br> Jacob Batalon,<br> Jon Bernthal,<br> Eman Esfandi,<br> Sadie Sink,<br> Mark Ruffalo,<br> Rosario Dawson,<br> Keith David,<br> Liza Colón-Zayas,<br> Tramell Tillman</p>                        </div>\n                    </div>\n                                        <hr class=\"dark horizontal my-5\"><div class=\"d-flex align-items-center gap-3 mb-3\"><img src=\"/assets/images/logos/the-cloakroom-bar-2026-black.png\" alt=\"The Cloakroom Bar\" style=\"height:66px;width:auto;\"></div><p class=\"text-dark\">Slip into The Cloakroom Bar before the lights go down, or linger long after the credits roll. Hidden beside the cinema, it's a place for quiet cocktails, low lighting, and conversations that deserve a slower ending.</p>                    <hr class=\"dark horizontal my-5\">                </div>\n\n                <!-- Right column: sticky showtime panel -->\n                <div class=\"col-12 col-lg-6 ps-lg-5 order-0 order-lg-1\">\n                    <div class=\"d-none d-md-block position-sticky\" style=\"top: 164px\">\n                        <h2 class=\"fs-4 fjalla-one-regular text-dark\">The Cinema at Selfridges - Show Times</h2><p class=\"fs-6\">To book online, please select a time from below:</p><p class=\"mb-4\"><small style=\"font-size: 0.8rem;\" class=\"small text-muted\">We apologise for the inconvenience, but unfortunately Selfridges vouchers cannot be used on the cinema website.</small></p>        <script>\n            document.addEventListener('DOMContentLoaded', function() {\n                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle=\"tooltip\"]'));\n                tooltipTriggerList.map(function(el) { return new bootstrap.Tooltip(el); });\n                document.querySelectorAll('a.disabled').forEach(function(el) {\n                    el.addEventListener('click', function(e) { e.preventDefault(); });\n                });\n            });\n        </script>\n              