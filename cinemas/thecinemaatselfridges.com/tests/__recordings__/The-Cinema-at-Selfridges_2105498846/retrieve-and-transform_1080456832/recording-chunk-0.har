            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta content=\"dark light\" name=\"color-scheme\">\n    <meta content=\"origin\" name=\"referrer\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\">\n    <meta name=\"robots\" content=\"index, follow\">\n\n    <!-- SEO -->\n    <title>World Cup 2026 | The Cinema at Selfridges</title>    <meta name=\"description\" content=\"A hub of entertainment, with cinema at its heart, set in iconic locations\">\n    <link rel=\"canonical\" href=\"https://www.thecinemaatselfridges.com/film/world-cup-2026\">\n\n    <!-- Open Graph -->\n    <meta property=\"og:title\"       content=\"World Cup 2026 | The Cinema at Selfridges\">\n    <meta property=\"og:description\" content=\"A hub of entertainment, with cinema at its heart, set in iconic locations\">\n    <meta property=\"og:url\"         content=\"https://www.thecinemaatselfridges.com/film/world-cup-2026\">\n    <meta property=\"og:image\"       content=\"https://www.thecinemaatselfridges.com/assets/images/open_graph_logo.png\">\n    <meta property=\"og:type\"        content=\"website\">\n    <meta property=\"og:locale\"      content=\"en_GB\">\n    <meta property=\"og:site_name\"   content=\"The Cinema at Selfridges\">\n\n    <!-- Twitter / X -->\n    <meta name=\"twitter:card\"        content=\"summary_large_image\">\n    <meta name=\"twitter:title\"       content=\"World Cup 2026 | The Cinema at Selfridges\">\n    <meta name=\"twitter:description\" content=\"A hub of entertainment, with cinema at its heart, set in iconic locations\">\n    <meta name=\"twitter:image\"       content=\"https://www.thecinemaatselfridges.com/assets/images/open_graph_logo.png\">\n\n    <meta name=\"generator\" content=\"cc v3\">\n\n    <!-- BOOTSTRAP 5 -->\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css\" rel=\"stylesheet\" integrity=\"sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB\" crossorigin=\"anonymous\">\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css\">\n\n    <!-- FONTS -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Fjalla+One&family=Open+Sans:wght@300;400;600;700&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://use.typekit.net/ldj0yqi.css\">\n\n    <!-- CUSTOM CSS -->\n    <link rel=\"stylesheet\" href=\"/assets/css/cinema-cloud.css?v=3.1.20\">\n\n    <!-- FAVICON -->\n    <link rel=\"shortcut icon\" type=\"image/ico\" href=\"/assets/images/cinema_3/favicon.ico\">\n    <link rel=\"apple-touch-icon\" type=\"image/png\" sizes=\"167x167\" href=\"/assets/images/cinema_3/favicon-167x167.png\">\n    <link rel=\"apple-touch-icon\" type=\"image/png\" sizes=\"180x180\" href=\"/assets/images/cinema_3/favicon-180x180.png\">\n    <link rel=\"icon\" type=\"image/png\" sizes=\"48x48\"   href=\"/assets/images/cinema_3/favicon-48x48.png\">\n    <link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/assets/images/cinema_3/favicon-192x192.png\">\n\n    <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"MovieTheater\",\"name\":\"The Cinema at Selfridges\",\"url\":\"https://www.thecinemaatselfridges.com\",\"address\":{\"@type\":\"PostalAddress\",\"name\":\"The Cinema at Selfridges\",\"streetAddress\":\"40 Duke Street London\",\"addressLocality\":\"London\",\"postalCode\":\"W1U 1AT\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"51.51526\",\"longitude\":\"-0.15198\"},\"priceRange\":\"£12 - £20\"}</script>\n                    <script async src=\"https://www.googletagmanager.com/gtag/js?id=G-YP9Y0V9VN2\"></script>\n                <script>\n                    window.dataLayer = window.dataLayer || [];\n                    function gtag(){dataLayer.push(arguments);}\n                    gtag('js', new Date());\n                    gtag('config', 'G-YP9Y0V9VN2');\n                </script>\n                </head>\n<body style=\"display:flex;flex-direction:column;min-height:100vh;\">\n        <section class=\"position-sticky top-0 z-index-4\">\n    <nav id=\"cc-nav\" class=\"navbar navbar-expand-lg bg-white border-bottom p-0 d-flex justify-content-between align-items-center start-0 end-0\">\n\n        <!-- Hamburger (mobile) -->\n        <div class=\"col-auto d-flex justify-content-start ms-2 d-lg-none\">\n            <button class=\"navbar-toggler border-0 p-0\" type=\"button\" data-bs-toggle=\"offcanvas\"\n                data-bs-target=\"#offcanvasMenu\" aria-controls=\"offcanvasMenu\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n                <span class=\"navbar-toggler-icon small\"></span>\n            </button>\n        </div>\n\n        <!-- Logo (centred on mobile) -->\n        <div class=\"col-auto d-flex justify-content-center position-absolute start-50 translate-middle-x d-lg-none\">\n            <a href=\"https://www.olympicstudios.com\" class=\"navbar-brand mx-auto\">\n                <img class=\"logo logo0 mobile-logo\" src=\"/assets/images/OlympicLogo_Gold.png\" alt=\"Cinema Logo\">\n            </a>\n        </div>\n\n        <!-- Account icon (mobile) -->\n        <div class=\"col-auto d-flex justify-content-end d-lg-none me-2\">\n            <a href=\"/account\" class=\"text-decoration-none\">\n                <span class=\"d-none me-2 sign-in-tag\">Sign In</span>\n                <i class=\"bi bi-person\" style=\"font-size:1.8rem;vertical-align:middle;\"></i>            </a>\n        </div>\n\n        <!-- Offcanvas panel -->\n        <div class=\"offcanvas offcanvas-start w-80\" id=\"offcanvasMenu\" tabindex=\"-1\" aria-labelledby=\"offcanvasMenuLabel\">\n\n            <div class=\"offcanvas-header bo