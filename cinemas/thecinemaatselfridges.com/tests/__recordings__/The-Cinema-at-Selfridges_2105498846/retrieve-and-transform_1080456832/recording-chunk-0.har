:none !important; display:block; }\n    .cc-account-menu-item:hover, .cc-account-menu-item:focus { background-color:#f8f9fa; color:#212529; text-decoration:none !important; }\n</style>\n<script>\ndocument.querySelectorAll('.cc-nav-signout').forEach(function(btn) {\n    btn.addEventListener('click', function() {\n        fetch('/api/account/logout', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ action: 'logout' })\n        })\n        .then(function(r) { return r.ok ? r.json() : null; })\n        .then(function() { window.location.href = '/'; })\n        .catch(function() { window.location.reload(); });\n    });\n});\n</script>\n        <section id=\"section_2_stack\" class=\"bg-dark p-0 m-0\">        <!-- Page Video Modal -->\n        <div id=\"videoModal\" class=\"modal fade\" data-bs-backdrop=\"static\" data-bs-keyboard=\"false\" tabindex=\"-1\" aria-labelledby=\"videoModalLabel\" aria-hidden=\"true\">\n            <div class=\"modal-dialog modal-dialog-centered modal-lg\">\n                <div class=\"modal-content\">\n                    <div class=\"modal-header justify-content-center position-relative\">\n                        <div class=\"w-100 text-center\">\n                            <h1 class=\"modal-title fs-5\" id=\"modalTrailerLabel\">World Cup 2026: Norway vs England</h1>\n                        </div>\n                        <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\n                    </div>\n                    <div class=\"modal-body p-1 p-md-2\">\n                        <div class=\"ratio ratio-16x9\">\n                            <iframe class=\"embed-responsive-item\" allowfullscreen allow=\"autoplay\" allowfullscreen=\"true\"></iframe>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- End Page Video Modal -->\n\n            <div class=\"page-header py-5 py-md-0 ratio ratio-2x1 position-relative\">\n        <picture>\n            <source srcset=\"https://m.cinemacloud.co.uk/imageFilm/2402_7_1.jpg\" media=\"(max-width: 767.9px)\">\n            <source srcset=\"https://m.cinemacloud.co.uk/imageFilm/2402_10_1.jpg\" media=\"(min-width: 768px)\">\n            <img src=\"https://m.cinemacloud.co.uk/imageFilm/2402_10_1.jpg\" alt=\"Background\" class=\"film-header-bg w-100 h-100 position-absolute top-0 start-0 object-fit-cover\" onload=\"this.style.opacity=1;\">\n        </picture>\n        <div class=\"position-absolute w-100 w-md-50 h-50 h-md-100 bg-grad-dark\"></div>\n        <div id=\"movie-overlay\" class=\"d-flex flex-column justify-content-end justify-content-md-center align-items-center align-items-md-start h-100 mx-md-5 mx-lg-7\">\n            \n            \n            <img class=\"title-treatment mb-4 mb-md-6 my-3\" src=\"https://m.cinemacloud.co.uk/imageFilm/2402_8_9.png\" alt=\"World Cup 2026: Norway vs England\" onerror=\"this.style.display='none';this.nextElementSibling.style.display=''\"><div class=\"title-treatment mb-4 mb-md-6 text-white text-left\" style=\"display:none;\"><h1 class=\"h4 text-white fw-semibold\">World Cup 2026: Norway vs England</h1></div>\n            \n            <div class=\"movie-badges mb-2 d-flex justify-content-start\">\n                <span class=\"badge text-bg-secondary me-2 px-3 fw-semibold\">2026</span><span class=\"badge text-bg-secondary me-2 px-3 fw-semibold\">1hr 45mins</span><img src=\"https://m.cinemacloud.co.uk/bbfc/SVGs/BBFC_PG_RGB.svg\" class=\"cert-20\" alt=\"BBFC Cert PG\">\n            </div>\n            <h6 class=\"text-light\">Live Sport</h6>\n            \n            \n        </div>\n    </div></section><section id=\"section_3_stack\" class=\"bg-white p-0 m-0\">        <div class=\"container my-5\">\n            <div class=\"row\">\n                <!-- Left column: film info -->\n                <div class=\"col-12 col-lg-6 order-1 order-lg-0\">\n                    <h3 class=\"fjalla-one-regular fs-3 text-uppercase text-dark mb-4\">World Cup 2026: Norway vs England</h3>\n                    <div class=\"d-flex mt-1 mb-4\"><img class=\"flex-shrink-1 cert-40\" src=\"https://m.cinemacloud.co.uk/bbfc/SVGs/BBFC_PG_RGB.svg\" alt=\"BBFC Cert\"><small style=\"font-size: 0.7rem;\" class=\"w-100 small ps-2 text-muted fst-italic\">Admission to film screenings is strictly in accordance with BBFC age ratings and valid proof of age may be required as a condition of entry.</small></div>                                        <h3 class=\"fjalla-one-regular fs-4 text-dark mb-4\">Synopsis</h3><div class=\"mb-5 text-dark\"><p data-pm-slice='1 1 []'>This summer, football comes to the big screen. </p> <p data-start='168' data-end='371'>Join us at the Cinema at Selfridges for every England World Cup match shown in full cinematic quality with stadium-level sound that puts you right in the heart of the action. Gather with fellow fans, enjoy every moment of the action, and immerse yourself in the atmosphere of the game.</p> <p data-start='373' data-end='539'>To make your matchday even better, The Cinema at Selfridges has partnered with Willy's Pies to offer a selection of delicious food and drink packages, perfect for enjoying during the match.</p> <h4 data-section-id='1jui4cx' data-start='541' data-end='566'>Ticket Packages</h4> <p data-start='567' data-end='652'><strong>£15 </strong>– General Entry<br data-start='584' data-end='587' /> <strong data-start='587' data-end='594'>£22</strong> – Premium Entry with Pie & soft drink package<br data-start='621' data-end='624' /> <strong data-start='624' data-end='631'>£24</strong> – Premium Entry with Pie & beer package</p> <h4 data-section-id='1v5737w' data-start='654' data-end='679'>Important Information</h4> <p data-start='680' data-end='965'>Food will be available from 30 minutes before kick-off. We recommend arriving early to collect your refreshments and settle in before the match begins. To enjoy your pie at its freshest, please allow plenty of time before kick-off, as late arrivals may experience delays in collection.</p> <p> </p> <p data-start='967' data-end='1064'>Don't miss a summer of world-class football, great food, and an unbeatable big-screen experience.</p></div>                                                            <div class=\"row\">\n                        <div class=\"col-7 col-md-8\">\n                                                                                    <p class=\"mb-1 fw-semibold text-secondary\">Duration:</p><p class=\"mt-0 fw-bolder\">1hr 45mins</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Available Sound Formats:</p><p class=\"mt-0 fw-bolder sound-formats\">5.1</p>                                                                                </div>\n                        <div class=\"col-5 col-md-4\">\n                                                                                </div>\n                    </div>\n                                        <hr class=\"dark horizontal my-5\"><div class=\"d-flex align-items-center gap-3 mb-3\"><img src=\"/assets/images/logos/the-cloakroom-bar-2026-black.png\" alt=\"The Cloakroom Bar\" style=\"height:66px;width:auto;\"></div><p class=\"text-dark\">Slip into The Cloakroom Bar before the lights go down, or linger long after the credits roll. Hidden beside the cinema, it's a place for quiet cocktails, low lighting, and conversations that deserve a slower ending.</p>                    <hr class=\"dark horizontal my-5\">                </div>\n\n                <!-- Right column: sticky showtime panel -->\n                <div class=\"col-12 col-lg-6 ps-lg-5 order-0 order-lg-1\">\n                    <div class=\"d-none d-md-block position-sticky\" style=\"top: 164px\">\n                        <h2 class=\"fs-4 fjalla-one-regular text-dark\">The Cinema at Selfridges - Show Times</h2><p class=\"fs-6\">To book online, please select a time from below:</p><p class=\"mb-4\"><small style=\"font-size: 0.8rem;\" class=\"small text-muted\">We apologise for the inconvenience, but unfortunately Selfridges vouchers cannot be used on the cinema website.</small></p>        <script>\n            document.addEventListener('DOMContentLoaded', function() {\n                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle=\"tooltip\"]'));\n                tooltipTriggerList.map(function(el) { return new bootstrap.Tooltip(el); });\n                document.querySelectorAll('a.disabled').forEach(function(el) {\n                    el.addEventListener('click', function(e) { e.preventDefault(); });\n                });\n            });\n        </script>\n                    <h4 class=\"fs-6 mb-4 fw-semibold text-muted\">Today - Saturday, July 11</h4>\n            <div class=\"d-flex flex-wrap text-center mb-4\">\n                                    <a role=\"button\"\n                       class=\"btn btn-selfridges rounded-1 mb-3 me-3 py-1 py-md-3 px-3 d-flex align-items-center\"\n                                              href=\"https://web3.empire.mycloudcinema.com/#/book/58163\"                        style=\"min-height: 40px;\" >\n                        <div class=\"d-flex align-items-center w-100 justify-content-center\">\n                            <span class=\"btn-times-fs\" style=\"line-height: 1;\">22:00</span>\n                            <span class=\"ms-2 opacity-7\" style=\"line-height: 1;\">Norway vs England</span>                            <span class=\"ms-2 opacity-7 d-none\" style=\"line-height: 1;\"></span>\n                                                                                </div>\n                    </a>\n                    <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Event\",\"name\":\"World Cup 2026: Norway vs England\",\"startDate\":\"2026-07-11T21:00:00.000+00:00\",\"endDate\":\"2026-07-11T22:55:00.000+00:00\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"location\":{\"@type\":\"Place\",\"name\":\"The Cinema at Selfridges\",\"address\":{\"@type\":\"PostalAddress\",\"name\":\"The Cinema at Selfridges\",\"streetAddress\":\"40 Duke Street London\",\"addressLocality\":\"London\",\"postalCode\":\"W1U 1AT\",\"addressCountry\":\"GB\"}},\"priceRange\":\"£12 - £20\",\"offers\":{\"@type\":\"Offer\",\"url\":\"https://web3.empire.mycloudcinema.com/#/book/58163\",\"priceCurrency\":\"GBP\",\"availability\":\"https://schema.org/InStock\",\"validFrom\":\"2026-07-11T18:08:42+01:00\"},\"inLanguage\":\"en\",\"image\":\"https://m.cinemacloud.co.uk/imageFilm/2402_10_1.jpg\"}</script>            </div>\n                                </div>\n                    <div class=\"d-block d-md-none\">\n                        <h2 class=\"fs-4 fjalla-one-regular text-dark\">The Cinema at Selfridges - Show Times</h2><p class=\"fs-6\">To book online, please select a time from below:</p><p class=\"mb-4\"><small style=\"font-size: 0.8rem;\" class=\"small text-muted\">We apologise for the inconvenience, but unfortunately Selfridges vouchers cannot be used on the cinema website.</small></p>        <script>\n            document.addEventListener('DOMContentLoaded', function() {\n                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle=\"tooltip\"]'));\n                tooltipTriggerList.map(function(el) { return new bootstrap.Tooltip(el); });\n                document.querySelectorAll('a.disabled').forEach(function(el) {\n                    el.addEventListener('click', function(e) { e.preventDefault(); });\n                });\n            });\n        </script>\n                    <h4 class=\"fs-6 mb-4 fw-semibold text-muted\">Today - Saturday, July 11</h4>\n            <div class=\"d-flex flex-wrap text-center mb-4\">\n                                    <a role=\"button\"\n                       class=\"btn btn-selfridges rounded-1 mb-3 me-3 py-1 py-md-3 px-3 d-flex align-items-center\"\n                                              href=\"https://web3.empire.mycloudcinema.com/#/book/58163\"                        style=\"min-height: 40px;\" >\n                        <div class=\"d-flex align-items-center w-100 justify-content-center\">\n                            <span class=\"btn-times-fs\" style=\"line-height: 1;\">22:00</span>\n                            <span class=\"ms-2 opacity-7\" style=\"line-height: 1;\">Norway vs England</span>                            <span class=\"ms-2 opacity-7 d-none\" style=\"line-height: 1;\"></span>\n                                                                                </div>\n                    </a>\n                    <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Event\",\"name\":\"World Cup 2026: Norway vs England\",\"startDate\":\"2026-07-11T21:00:00.000+00:00\",\"endDate\":\"2026-07-11T22:55:00.000+00:00\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"location\":{\"@type\":\"Place\",\"name\":\"The Cinema at Selfridges\",\"address\":{\"@type\":\"PostalAddress\",\"name\":\"The Cinema at Selfridges\",\"streetAddress\":\"40 Duke Street London\",\"addressLocality\":\"London\",\"postalCode\":\"W1U 1AT\",\"addressCountry\":\"GB\"}},\"priceRange\":\"£12 - £20\",\"offers\":{\"@type\":\"Offer\",\"url\":\"https://web3.empire.mycloudcinema.com/#/book/58163\",\"priceCurrency\":\"GBP\",\"availability\":\"https://schema.org/InStock\",\"validFrom\":\"2026-07-11T18:08:42+01:00\"},\"inLanguage\":\"en\",\"image\":\"https://m.cinemacloud.co.uk/imageFilm/2402_10_1.jpg\"}</script>            </div>\n                                </div>\n                </div>\n            </div>\n        </div>\n        </section><section id=\"section_4_stack\" class=\"bg-dark py-4 py-lg-5 m-0\"><div class=\"container d-flex flex-column flex-grow-1\"><div class=\"row gx-2 gx-md-4 gy-2 gy-md-4 flex-grow-1\"><div class=\"col-12 d-flex flex-column text-white\"><!-- widget: hero_main --><div class=\"hero-main-widget hm1 d-flex flex-column flex-grow-1 justify-content-center\" style=\"position:relative\"><div class=\"row justify-content-center\" style=\"position:relative;z-index:1\"><div class=\"col-lg-10 mx-auto text-center\"><h2 class=\"fjalla-one-regular majortitle fs-4 hm-h text-uppercase p-0 m-0 pb-2\">UNRIVALLED CINEMA</h2><div class=\" pb-2\">Cinema as it’s meant to be - immersive, effortless, and unforgettable. Our screens offer a truly unrivalled experience with state-of-the-art sound and vision. Settle into spacious, reclining seats with ample legroom and personal tables. The Grab & Go bar offers quiet snacks, and curated wines and drinks to enjoy throughout the film.</div></div></div></div></div></div></div></section><footer class=\"container-fluid bg-light mt-auto\">\n    <div class=\"p-1 pt-4 p-lg-5 border-top row\">\n\n        <div class=\"col-12 col-lg-3 mb-5 mb-lg-3\">\n            <h6 class=\"fjalla-one-regular text-dark mb-4 text-uppercase lh-sm\">A hub of entertainment, with cinema at its heart, set in iconic locations</h6>\n            <div class=\"flex-column text-body-secondary\">\n                <p>Cinema as it&#039;s meant to be - immersive, effortless, and unforgettable. With state-of-the-art sound and vision, our screens offer a truly unrivalled experience. Settle into spacious, reclining seats with ample legroom and personal tables. The Grab &amp; Go bar offers quiet snacks, and curated wines and drinks to enjoy throughout the film.</p>\n            </div>\n        </div>\n\n        <div class=\"col-12 col-lg-6 row d-flex justify-content-start justify-content-lg-center\">\n            <div class=\"col-12 col-md-4 mb-5 mb-lg-3 d-flex justify-content-start justify-content-lg-center\">\n   