le=\"min-height: 40px;\"    >\n            <div class=\"d-flex align-items-center\">\n                <span class=\"d-flex align-items-center\">\n                    <span class=\"btn-times-fs\" style=\"line-height:1;\">17:25</span>\n                                        <span class=\"ms-2 opacity-7 d-none\" style=\"line-height:1;\"></span>\n                </span>\n                                            </div>\n        </a>\n                <a class=\"btn btn-selfridges mb-2 mb-lg-3 me-3 py-1 py-md-3 px-3 rounded-1 d-flex align-items-center justify-content-center\"\n           href=\"https://web3.empire.mycloudcinema.com/#/book/57659\" role=\"button\"  style=\"min-height: 40px;\"    >\n            <div class=\"d-flex align-items-center\">\n                <span class=\"d-flex align-items-center\">\n                    <span class=\"btn-times-fs\" style=\"line-height:1;\">20:30</span>\n                                        <span class=\"ms-2 opacity-7 d-none\" style=\"line-height:1;\"></span>\n                </span>\n                                            </div>\n        </a>\n                                </div>\n                                    </div>\n            </div>\n        </div>\n                    </div>\n        </section>\n                </div>\n        <script>\n        document.addEventListener('DOMContentLoaded', function() {\n            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle=\"tooltip\"]'));\n            tooltipTriggerList.map(function(e) { return new bootstrap.Tooltip(e); });\n            document.querySelectorAll('a.disabled').forEach(function(el) {\n                el.addEventListener('click', function(e) { e.preventDefault(); });\n            });\n            const stickyHeaders = document.querySelectorAll('.date-sticky');\n            if (stickyHeaders.length > 0) {\n                const getStickyTop = () => window.innerWidth >= 992 ? 118 : window.innerWidth >= 768 ? 95 : 87;\n                const checkSticky = () => {\n                    const t = getStickyTop();\n                    stickyHeaders.forEach(h => {\n                        const rect = h.getBoundingClientRect();\n                        h.classList.toggle('is-stuck', rect.top <= t + 5 && rect.top >= t - 5);\n                    });\n                };\n                window.addEventListener('scroll', checkSticky, { passive: true });\n                window.addEventListener('resize', checkSticky, { passive: true });\n                checkSticky();\n            }\n        });\n        </script>\n                    </div>\n</div>\n<script>\n(function () {\n    var stored = sessionStorage.getItem('cc_listing_view');\n    if (!stored) return;\n    var active = document.querySelector('.set-listings.nav-link.active');\n    if (!active || active.getAttribute('data-view') === stored) return;\n    var target = document.querySelector('.set-listings.nav-link[data-view=\"' + stored + '\"]');\n    if (!target) return;\n    // Swap nav link classes\n    active.classList.remove('active');\n    active.setAttribute('aria-selected', 'false');\n    target.classList.add('active');\n    target.setAttribute('aria-selected', 'true');\n    // Swap pane classes\n    var fromPane = document.querySelector('.tab-pane.active');\n    var toPane   = document.getElementById(target.getAttribute('href').replace('#', ''));\n    if (fromPane) { fromPane.classList.remove('active', 'show'); }\n    if (toPane)   { toPane.classList.add('active', 'show'); }\n    // Update data-session so cc.js moving-tab init reads the correct value\n    // and adds the 'active' class to the inner <a>, making the white indicator visible\n    var navPills = target.closest('.nav-pills');\n    if (navPills) navPills.setAttribute('data-session', stored);\n})();\n</script></section><section id=\"section_5_stack\" class=\"bg-white py-4 py-lg-5 m-0\"><div class=\"container d-flex flex-column flex-grow-1\"><div class=\"row gx-2 gx-md-4 