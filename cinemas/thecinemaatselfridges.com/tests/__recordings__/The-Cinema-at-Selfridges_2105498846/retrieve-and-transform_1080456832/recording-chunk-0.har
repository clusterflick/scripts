ass=\"mt-1 small\">Subscribe to our newsletter *</p>\n                                <p class=\"mb-1 small text-body-secondary\">You can unsubscribe anytime by clicking the Unsubscribe button in the newsletters. For further information please see our. <a href=\"https://www.olympicstudios.com/policies/privacy-policy\" target=\"_blank\" class=\"fw-semibold\">Privacy Policy</a>. I confirm that I am over 16 years of age.</p>\n                            </label>\n                            <div class=\"invalid-feedback\">You must agree before submitting.</div>\n                        </div>\n                    </div>\n                    <button type=\"submit\" class=\"btn btn-white border-radius-sm w-100 text-center mt-2\">Subscribe</button>\n                    <p class=\"mt-2 text-body-secondary\" style=\"font-size:0.7rem;\">This site is protected by reCAPTCHA and the Google <a href=\"https://policies.google.com/privacy\" target=\"_blank\">Privacy Policy</a> and <a href=\"https://policies.google.com/terms\" target=\"_blank\">Terms of Service</a> apply.</p>\n                </div>\n            </form>\n            <div id=\"form-response\" class=\"mt-3 text-center\" style=\"display:none;\"></div>\n        </div>\n\n    </div>\n\n    <div class=\"d-flex flex-column flex-sm-row justify-content-between px-1 px-lg-5 py-1 py-lg-4 border-top\">\n        <small>&copy; Copyright <script>document.write(new Date().getFullYear())</script> The Cinema at Selfridges. All rights reserved.</small>\n    </div>\n</footer>\n\n<!-- Bootstrap JS -->\n<script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js\" integrity=\"sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI\" crossorigin=\"anonymous\"></script>\n\n<!-- Cinema Cloud JS -->\n<script type=\"module\" src=\"/assets/js/cc.js?v=1783789723\"></script>\n\n<!-- reCAPTCHA v3 -->\n<script src=\"https://www.google.com/recaptcha/api.js?render=6LfnzhkrAAAAAH5ot9hNeCwWsz1lsiYaGxlS3Aci\"></script>\n<script>\ndocument.getElementById('mc-embedded-subscribe-form').addEventListener('submit', function(e) {\n    e.preventDefault();\n    const form     = this;\n    const response = document.getElementById('form-response');\n\n    if (!form.checkValidity()) {\n        form.classList.add('was-validated');\n        return;\n    }\n\n    grecaptcha.ready(function() {\n        grecaptcha.execute('6LfnzhkrAAAAAH5ot9hNeCwWsz1lsiYaGxlS3Aci', { action: 'subscribe' }).then(function(token) {\n            const formData = new FormData(form);\n            formData.set('g-recaptcha-response', token);\n\n            fetch(form.action, { method: 'POST', body: formData })\n            .then(r => r.json())\n            .then(data => {\n                if (data.status === 'success') {\n                    form.style.display = 'none';\n                    response.textContent = 'Thank you for subscribing!';\n                    response.style.display = 'block';\n                } else {\n                    response.textContent = data.message || 'Subscription failed. Please try again.';\n                    response.style.display = 'block';\n                }\n            })\n            .catch(function() {\n                response.textContent = 'A network error occurred. Please try again.';\n                response.style.display = 'block';\n            });\n        });\n    });\n});\n</script>\n\n</body>\n</html>\n        ",
