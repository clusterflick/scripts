      </div>\n\n    </div>\n  </div>\n            </div>\n\n          </div>\n \n\n\n        </div>\n    </div>\n    </nav>\n\n               \n    <script>\n              // document.addEventListener('DOMContentLoaded', function () {\n    // ... (your existing code) ...\n    // function handleMainMenuClick(e) {\n    //     // Prevent default navigation on mobile\n    //     if (window.innerWidth <= 921.98) {\n    //         const linkHref = e.currentTarget.href;\n    //         const hasSubmenu = e.currentTarget.dataset.target; // Check for data-target\n\n    //         if (hasSubmenu) {\n    //             e.preventDefault();\n    //             showSubMenu(hasSubmenu); // Use data-target to show submenu\n    //         }\n    //         // If the link does not have a submenu, allow default navigation\n    //     }\n    // }\n\n    // // Attach event listeners to menu items\n    // document.querySelectorAll('#mainMenu .nav-item a').forEach(link => {\n    //     link.addEventListener('click', handleMainMenuClick);\n    // });\n\n    // ... (rest of your code) ...\n// });\n            </script>\n\n\n    \n    <div id=\"page-submenus\" class=\"shopify-section shopify-section-group-header-group section-page-submenus\">\n      <!-- <div class=\"submenus\"> -->\n  <div class=\"d-flex justify-content-evenly\"><div class=\"submenu submenu-4\">\n<!-- <a href=\"/whats-on\" class=\"\"> -->\n  <a href=\"/whats-on\" class=\"\">\n        <span class=\"tagline\">What&#039;s On</span>\n    </a>\n</div><div class=\"submenu submenu-7\">\n<!-- <a href=\"/whats-on/babes-in-arms\" class=\"\"> -->\n  <a href=\"/whats-on/babes-in-arms\" class=\"\">\n        <span class=\"tagline\">Babes in Arms</span>\n    </a>\n</div><div class=\"submenu submenu-12\">\n<!-- <a href=\"/ticket-info\" class=\"\"> -->\n  <a href=\"/ticket-info\" class=\"\">\n        <span class=\"tagline\">Ticket Info</span>\n    </a>\n</div>      <!-- <div class=\"submenu submenu-1\">\n          <a href=\"/thecinemaatselfridges.com/signup\" class=\"\">\n              <span class=\"tagline\">Sign Up</span>\n          </a>\n      </div> --></div>    </div>\n  </section>\n\n  <section id=\"section_1_stack\" class=\"bg-dark py-4 py-lg-5\">    <div class=\"d-lg-block text-center \">\n        <img class=\"w-auto logo3-whatson mt-0\" src=\"/assets/images/cinema-logo-white-3.png\" alt=\"Cinema Logo\">\n    </div></section><section id=\"section_2_stack\" class=\"bg-white p-0\"><section class=\"mb-0\">\n    <div class=\"page-header py-5 py-md-0 ratio ratio-2x1 position-relative bg-white\">\n        <picture>\n            <source srcset=\"https://media.cinemacloud.co.uk/imageFilm/2059_7_1.jpg\" media=\"(max-width: 991.9px)\">\n            <source srcset=\"https://media.cinemacloud.co.uk/imageFilm/2059_10_1.jpg\" media=\"(min-width: 992px)\">\n            <img src=\"https://media.cinemacloud.co.uk/imageFilm/2059_10_1.jpg\" alt=\"Background\" class=\"w-100 h-100 position-absolute top-0 start-0 object-fit-cover\">\n        </picture>\n<div class=\"position-absolute w-100 w-lg-50 h-50 h-lg-100 bg-grad\"></div>        <div id=\"movie-overlay\" class=\"d-flex flex-column justify-content-end justify-content-lg-center align-items-center align-items-lg-start h-100 mx-lg-7\">\n        <div class=\"d-none d-lg-inline movie-awards mb-4 d-flex justify-content-start\"></div>    <img class=\"title-treatment mb-4 mb-lg-6\" src=\"https://media.cinemacloud.co.uk/imageFilm/2059_8_1.png\" alt=\"Logo\">    <div class=\"movie-badges mb-2 d-flex justify-content-start\">        <span class=\"badge text-bg-secondary me-2\">2025</span>\n    <span class=\"badge text-bg-secondary me-2\">1hr 40mins</span><span class=\"badge text-bg-secondary me-2\">Q&A</span>        \n        <img src=\"https://media.cinemacloud.co.uk/bbfc/SVGs/BBFC_tba_RGB.svg\" class=\"cert-20\" alt=\"BBFC Cert tba\">\n    </div><h6 class=\"text-white \">Screening with Q&A</h6><p class=\"text-white opacity-6\"><small>Documentary</small></p>    </div>    </div>\n</div>\n</section></section><section id=\"section_3_stack\" class=\"bg-white p-0\">            <div class=\"container my-5\">\n                <div class=\"row\">\n\n                    <div class=\"col-12 col-lg-6 order-1 order-lg-0\">\n                        <h3 class=\"text-uppercase\">Screen Players Film Club: Two Strangers Trying Not to Kill Each Other</h3>\n\n\n                        <p><img src=\"https://media.cinemacloud.co.uk/bbfc/SVGs/BBFC_tba_RGB.svg \" class=\"cert-40 my-4\" alt=\"BBFC Cert $certs\" ></p>\n\n                                                    <h3 class=\" fjalla-one-regular fs-4 text-dark mb-4\">Synopsis</h3>\n                            <p class=\"mb-5 text-dark\"><div style='border: 0px; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-stretch: inherit; line-height: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; margin: 0px; padding: 0px; vertical-align: baseline;' data-olk-copy-source='MessageBody'><span style='font-family: 'Helvetica Neue'; text-align: justify;'>Film Lovers - please join us for our next&nbsp;</span><strong style='font-family: 'Helvetica Neue'; text-align: justify;'>SCREEN PLAYERS FILM CLUB&nbsp;</strong><span style='font-family: 'Helvetica Neue'; text-align: justify;'>for a special screening of the mesmerising and profoundly moving documentary&nbsp;</span><strong style='font-family: 'Helvetica Neue'; text-align: justify;'>Two Strangers Trying Not to Kill Each Other.&nbsp;</strong></div> <div style='border: 0px; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-stretch: inherit; line-height: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; margin: 0px; padding: 0px; vertical-align: baseline;' data-olk-copy-source='MessageBody'>&nbsp;</div> <div style='border: 0px; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-stretch: inherit; line-height: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; margin: 0px; padding: 0px; vertical-align: baseline;' data-olk-copy-source='MessageBody'><span style='font-family: 'Helvetica Neue'; text-align: justify;'>After the screening, filmmakers</span><span class='Apple-converted-space' style='font-family: 'Helvetica Neue'; text-align: justify;'>&nbsp;</span><strong style='font-family: 'Helvetica Neue'; text-align: justify;'>Manon Ouimet<span class='Apple-converted-space'>&nbsp;</span></strong><span style='font-family: 'Helvetica Neue'; text-align: justify;'>and</span><strong style='font-family: 'Helvetica Neue'; text-align: justify;'><span class='Apple-converted-space'>&nbsp;</span>Jacob Perlmutter</strong><span style='font-family: 'Helvetica Neue'; text-align: justify;'>, and the subjects of their film- the artist</span><span class='Apple-converted-space' style='font-family: 'Helvetica Neue'; text-align: justify;'>&nbsp;</span><strong style='font-family: 'Helvetica Neue'; text-align: justify;'>Maggie Barrett<span class='Apple-converted-space'>&nbsp;</span></strong><span style='font-family: 'Helvetica Neue'; text-align: justify;'>and legendary photographer</span><strong style='font-family: 'Helvetica Neue'; text-align: justify;'>Joel Meyerowitz&nbsp;</strong><span style='font-family: 'Helvetica Neue'; text-align: justify;'>will be in conversation with</span><span class='Apple-converted-space' style='font-family: 'Helvetica Neue'; text-align: justify;'>&nbsp;</span><strong style='font-family: 'Helvetica Neue'; text-align: justify;'>Charlotte Bogard Macleod.</strong></div> <div dir='ltr'> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal; min-height: 16px;'>&nbsp;</p> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal;'><strong>TWO STRANGERS TRYING NOT TO KILL EACH OTHER:</strong></p> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal;'>Life, mortality and the artistic process are at the heart of this beautiful and often very funny documentary about brilliant artist and writer Maggie Barrett and her husband, the legendary photographer Joel Meyerowitz.</p> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal; min-height: 16px;'>&nbsp;</p> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal;'>It&rsquo;s a documentary made by one artist couple filming another artist couple, who discover that they share similar values. Although separated by many decades of life experience and artistic output and practice, both couples find a shared commitment to the creative process, and an extraordinary openness to discuss life&rsquo;s more important questions.</p> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal; min-height: 16px;'>&nbsp;</p> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal;'><strong>Two Strangers Not to Kill Each Other</strong><span class='Apple-converted-space'>&nbsp;</span><strong>offers a profound yet tender exploration of love, art and the ephemeral beauty of life.&nbsp;&nbsp;</strong><strong>Unmissable.</strong></p> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal; min-height: 16px;'>&nbsp;</p> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal;'>Screen Players Film Club a Soho Square Studios Production, supported by The Script Factory and The Cinema in Selfridges.</p> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal; min-height: 16px;'>&nbsp;</p> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal;'>Further information on Screen Players Film Club:&nbsp;<span class='Apple-converted-space'>&nbsp;</span><a style='color: #0078d7;' title='https://www.scriptfactory.co.uk/screen-players' href='https://www.scriptfactory.co.uk/screen-players'>https://www.scriptfactory.co.uk/screen-players</a></p> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal; min-height: 16px;'>&nbsp;</p> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal;'><strong>Timings:&nbsp;</strong> &nbsp;<span class='Apple-converted-space'>&nbsp;</span></p> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal;'>6.10pm Programme</p> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal;'>6.30pm Two Strangers Trying Not to Kill Each Other</p> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal;'>8.00pm Post -Screening Interview and Live Podcast</p> <p style='margin: 0px; text-align: justify; font-stretch: normal; font-size: 14px; line-height: normal; font-family: 'Helvetica Neue'; font-size-adjust: none; font-kerning: auto; font-variant-alternates: normal; font-variant-numeric: normal; font-variant-east-asian: normal; font-feature-settings: normal; min-height: 16px;'>&nbsp;</p> </div></p>\n                                                \n                        <div class=\"row\">\n                            <div class=\"col-7 col-md-8\">\n                                \n\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Duration:</p>\n                                    <p class=\"mt-0 fw-bolder\">1hr 40mins</p>\n                                \n\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Available Sound Formats:</p>\n                                    <p class=\"mt-0 fw-bolder sound-formats\">\n                                        5.1                                    </p>\n                                                                                                    <p class=\"mb-1 fw-bold text-secondary\">Genre:</p>\n                                    <p class=\"mt-0 fw-bolder\">Documentary</p>\n                                                                                                    <p class=\"mb-1 fw-bold text-secondary\">Country:</p>\n                                    <p class=\"mt-0 fw-bolder\">Denmark, United Kingdom, United States</p>\n                                \n                            </div>\n                            <div class=\"col-5 col-md-4\">\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Director:</p>\n                                    <p class=\"mt-0 fw-bolder\">Jacob Perlmutter,<br> Manon Ouimet</p>\n                                \n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Starring:</p>\n                                    <p class=\"mt-0 fw-bolder\">Joel Meyerowitz,<br> Maggie Barrett,<br> Brenda Bufalino</p>\n                                                            </div>\n                        </div>\n\n                        \n                        <!-- <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                            </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“Florence Pugh and Andrew Garfield scorch…The pair’s chemistry is off the charts and each set-piece a showstopper in this tragic romance.”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                            Kevin Maher, The Times\n                            </figcaption>\n                        </figure>\n\n                        <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                        </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“It’s such a joy to watch two such assured and natural performers allowed the room to exercise both movie star and actor muscles as well as showcase their ease with both comedy and drama.”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                            Benjamin Lee, Guardian\n                            </figcaption>\n                        </figure>\n\n                        <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                        </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“The perfect movie for when you want to sit in your feelings and be taken on an unashamedly emotional journey…Garfield and Pugh are as dreamy a team as you’d hope!”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                            Tori Brazier, Metro\n                            </figcaption>\n                        </figure>\n\n                        <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                        </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“Andrew Garfield and Florence Pugh will break your heart in a London romance of rare honesty.”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                                Helen O'Hara, Time Out\n                            </figcaption>\n                        </figure> -->\n\n                    </div>\n\n                    \n                    <div class=\"col-12 col-lg-6 ps-lg-5 order-0 order-lg-1\">\n                        <h2 class=\"fs-4 fjalla-one-regular\">Show times</h2>\n\n                        <p class=\"mb-5\">To book online, please select a time from below:</p>            <h4 class=\"fs-6 mb-4 fw-bold text-muted\">Monday, May 19</h4>\n            <div class=\"d-flex flex-wrap text-center mb-4\">\n                <script>\n                    // Initialize all tooltips\n                    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle=\"tooltip\"]'));\n                    tooltipTriggerList.map(function (tooltipTriggerEl) {\n                        return new bootstrap.Tooltip(tooltipTriggerEl);\n                    });\n                </script>\n                           \n                                        <a role=\"button\" class=\"btn btn-selfridges rounded-1 mb-3 me-3 py-1 py-md-3 px-3 d-flex align-items-center\" \n                         href=\"https://web3.empire.mycloudcinema.com/#/book/38371\" style=\"min-height: 40px;\">\n                        <div class=\"d-flex align-items-center w-100 justify-content-center\">\n                            <span class=\"btn-times-fs\" style=\"line-height: 1;\">18:00</span>\n                                                        <span class=\"ms-2 opacity-7 d-none\" style=\"line-height: 1;\"></span>\n\n                            \n                                                    </div>\n                    </a>\n\n\n                    <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Event\",\"name\":\"Screen Players Film Club: Two Strangers Trying Not to Kill Each Other\",\"startDate\":\"2025-05-19T18:00:00.000+01:00\",\"endDate\":\"2025-05-19T20:00:00.000+01:00\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"location\":{\"@type\":\"Place\",\"name\":\"The Cinema at Selfridges\",\"address\":{\"@type\":\"PostalAddress\",\"name\":\"The Cinema at Selfridges\",\"streetAddress\":\"40 Duke Street London\",\"addressLocality\":\"London\",\"postalCode\":\"W1U 1AT\",\"addressCountry\":\"GB\"}},\"priceRange\":\"£12 - £20\",\"offers\":{\"@type\":\"Offer\",\"url\":\"https://web3.empire.mycloudcinema.com/#/book/38371\",\"priceCurrency\":\"GBP\",\"availability\":\"https://schema.org/InStock\",\"validFrom\":\"2025-04-07T19:09:17.538669+01:00\"},\"inLanguage\":\"en\",\"image\":\"https://media.cinemacloud.co.uk/imageFilm/2059_10_1.jpg\"}</script>\n                            </div>\n                                        \n                    </div>\n\n                </div>\n                \n\n                </section>  \n<footer class=\"container-fluid bg-light\">\n  <div class=\"p-1 pt-4 p-lg-5 border-top row\">\n\n    <div class=\"col-12 col-lg-3 mb-5 mb-lg-3\">\n      <h6 class=\"fjalla-one-regular text-dark mb-4 text-uppercase lh-sm\">A hub of entertainment, with cinema at its heart, set in iconic locations</h6>\n      <div class=\"flex-column\">\n        <p>Cinema as it’s meant to be — immersive, effortless, and unforgettable. With state-of-the-art sound and vision, our screens offer a truly unrivalled experience. Settle into spacious, reclining seats with ample legroom and personal tables. The Grab & Go bar offers quiet snacks, and curated wines and drinks to enjoy throughout the film.</p>\n      </div>\n    </div>\n\n    <div class=\"col-12 col-lg-6 row d-flex justify-content-start justify-content-lg-center\">\n      <div class=\"col-12 col-md-4 mb-5 mb-lg-3 d-flex justify-content-start justify-content-lg-center\">\n        <div class=\"text-sm-start\">\n          <h6 class=\"fjalla-one-regular text-dark text-uppercase mb-4\">Discover</h6>\n          <ul class=\"nav flex-column\">\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/select-your-cinema\" class=\"p-0\">Box Office</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/blogs/events\" class=\"p-0\">Events</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/private-hire\" class=\"p-0\">Private Hire</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/membership\" class=\"p-0\">Membership</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/recording-studio\" class=\"p-0\">Recording Studio</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/dine-and-drink\" class=\"p-0\">Dine & Drink</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"/account\" class=\"p-0\">Sign In</a></p></li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"col-12 col-md-4 mb-5 mb-lg-3 d-flex justify-content-start justify-content-lg-center\">\n        <div class=\"text-sm-start\">\n          <h6 class=\"fjalla-one-regular text-dark text-uppercase mb-4\">About</h6>\n          <ul class=\"nav flex-column\">\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/our-story\" class=\"p-0\">Our Story</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/get-in-touch\" class=\"p-0\">Get in Touch</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/join-the-team\" class=\"p-0\">Join the Team</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/accessibility\" class=\"p-0\">Accessibility</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/policies/privacy-policy\" class=\"p-0\">Privacy Policy</a></p></li>\n            <li class=\"\"><p clas