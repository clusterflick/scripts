s\",\"name\":\"The Cinema at Selfridges\",\"streetAddress\":\"40 Duke Street London\",\"addressLocality\":\"London\",\"postalCode\":\"W1U 1AT\",\"addressCountry\":\"GB\"}},\"priceRange\":\"£12 - £20\",\"offers\":{\"@type\":\"Offer\",\"url\":\"https://web3.empire.mycloudcinema.com/#/book/38670\",\"priceCurrency\":\"GBP\",\"availability\":\"https://schema.org/InStock\",\"validFrom\":\"2025-04-07T19:09:17.103807+01:00\"},\"inLanguage\":\"en\",\"image\":\"https://media.cinemacloud.co.uk/imageFilm/1985_10_1.jpg\"}</script>\n                            </div>\n                                        \n                    </div>\n\n                </div>\n                \n\n                </section>  \n<footer class=\"container-fluid bg-light\">\n  <div class=\"p-1 pt-4 p-lg-5 border-top row\">\n\n    <div class=\"col-12 col-lg-3 mb-5 mb-lg-3\">\n      <h6 class=\"fjalla-one-regular text-dark mb-4 text-uppercase lh-sm\">A hub of entertainment, with cinema at its heart, set in iconic locations</h6>\n      <div class=\"flex-column\">\n        <p>Cinema as it’s meant to be — immersive, effortless, and unforgettable. With state-of-the-art sound and vision, our screens offer a truly unrivalled experience. Settle into spacious, reclining seats with ample legroom and personal tables. The Grab & Go bar offers quiet snacks, and curated wines and drinks to enjoy throughout the film.</p>\n      </div>\n    </div>\n\n    <div class=\"col-12 col-lg-6 row d-flex justify-content-start justify-content-lg-center\">\n      <div class=\"col-12 col-md-4 mb-5 mb-lg-3 d-flex justify-content-start justify-content-lg-center\">\n        <div class=\"text-sm-start\">\n          <h6 class=\"fjalla-one-regular text-dark text-uppercase mb-4\">Discover</h6>\n          <ul class=\"nav flex-column\">\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/select-your-cinema\" class=\"p-0\">Box Office</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href