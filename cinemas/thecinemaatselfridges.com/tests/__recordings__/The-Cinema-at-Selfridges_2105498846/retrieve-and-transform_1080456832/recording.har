             <span class=\"tagline\">Sign Up</span>\n          </a>\n      </div> --></div>    </div>\n  </section>\n\n  <section id=\"section_1_stack\" class=\"bg-dark py-4 py-lg-5\">    <div class=\"d-lg-block text-center \">\n        <img class=\"w-auto logo3-whatson mt-0\" src=\"/assets/images/cinema-logo-white-3.png\" alt=\"Cinema Logo\">\n    </div></section><section id=\"section_2_stack\" class=\"bg-white p-0\"><section class=\"mb-0\">\n    <div class=\"page-header py-5 py-md-0 ratio ratio-2x1 position-relative bg-white\">\n        <picture>\n            <source srcset=\"https://media.cinemacloud.co.uk/imageFilm/1985_7_1.jpg\" media=\"(max-width: 991.9px)\">\n            <source srcset=\"https://media.cinemacloud.co.uk/imageFilm/1985_10_1.jpg\" media=\"(min-width: 992px)\">\n            <img src=\"https://media.cinemacloud.co.uk/imageFilm/1985_10_1.jpg\" alt=\"Background\" class=\"w-100 h-100 position-absolute top-0 start-0 object-fit-cover\">\n        </picture>\n<div class=\"position-absolute w-100 w-lg-50 h-50 h-lg-100 bg-grad\"></div>        <div id=\"movie-overlay\" class=\"d-flex flex-column justify-content-end justify-content-lg-center align-items-center align-items-lg-start h-100 mx-lg-7\">\n        <div class=\"d-none d-lg-inline movie-awards mb-4 d-flex justify-content-start\"></div>    <img class=\"title-treatment mb-4 mb-lg-6\" src=\"https://media.cinemacloud.co.uk/imageFilm/1985_8_1.png\" alt=\"Logo\">    <div class=\"movie-badges mb-2 d-flex justify-content-start\">        <span class=\"badge text-bg-secondary me-2\">2025</span>\n    <span class=\"badge text-bg-secondary me-2\">1hr 34mins</span>        <img src=\"https://media.cinemacloud.co.uk/imageMisc/Dolby/Atmos/Vertical/DLB_Atms_vert_rgb_wht_@1x.png\" class=\"cert-20 me-2\" alt=\"Movie Sound Dolby Atmos\">\n        <img src=\"https://media.cinemacloud.co.uk/bbfc/SVGs/BBFC_15_RGB.svg\" class=\"cert-20\" alt=\"BBFC Cert 15\">\n    </div><p class=\"text-white opacity-6\"><small>Thriller</small></p>    </div>    </div>\n</div>\n</section></section><section id=\"section_3_stack\" class=\"bg-white p-0\">            <div class=\"container my-5\">\n                <div class=\"row\">\n\n                    <div class=\"col-12 col-lg-6 order-1 order-lg-0\">\n                        <h3 class=\"text-uppercase\">Black Bag</h3>\n\n\n                        <p><img src=\"https://media.cinemacloud.co.uk/bbfc/SVGs/BBFC_15_RGB.svg \" class=\"cert-40 my-4\" alt=\"BBFC Cert $certs\" ></p>\n\n                                                    <h3 class=\" fjalla-one-regular fs-4 text-dark mb-4\">Synopsis</h3>\n                            <p class=\"mb-5 text-dark\">When his beloved wife Kathryn is suspected of betraying the nation, intelligence agent George Woodhouse faces the ultimate test – loyalty to his marriage or his country.</p>\n                                                \n                        <div class=\"row\">\n                            <div class=\"col-7 col-md-8\">\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Release Date:</p>\n                                    <p class=\"mt-0 fw-bolder\">March</p>\n                                \n\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Duration:</p>\n                                    <p class=\"mt-0 fw-bolder\">1hr 34mins</p>\n                                \n\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Available Sound Formats:</p>\n                                    <p class=\"mt-0 fw-bolder sound-formats\">\n                                        Dolby Atmos                                    </p>\n                                                                                                    <p class=\"mb-1 fw-bold text-secondary\">Genre:</p>\n                                    <p class=\"mt-0 fw-bolder\">Thriller</p>\n                                                                                                    <p class=\"mb-1 fw-bold text-secondary\">Country:</p>\n                                    <p class=\"mt-0 fw-bolder\">United States</p>\n                                \n                            </div>\n                            <div class=\"col-5 col-md-4\">\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Director:</p>\n                                    <p class=\"mt-0 fw-bolder\">Steven Soderbergh</p>\n                                \n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Starring:</p>\n                                    <p class=\"mt-0 fw-bolder\">Cate Blanchett,<br> Pierce Brosnan,<br> Naomie Harris,<br> Tom Burke,<br> Regé-Jean Page,<br> Marisa Abela,<br> Michael Fassbender,<br> Orli Shuka,<br> Daniel Fearn,<br> Alex Magliaro</p>\n                                                            </div>\n                        </div>\n\n                                                <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <blockquote class=\"blockquote\">\n                                <p>“Steven Soderbergh’s new thriller Black Bag about married spies is brilliant, sexy, and as tight as a drum.”&nbsp;<br>★★★★★ Clarisse Loughrey, Independent</p><p>“More John le Carré than James Bond, this is a very entertaining thriller, which applies Soderbergh’s well-trodden heist mechanics to espionage with slickly rewarding results.”&nbsp;<br>★★★★ John Nugent, Empire&nbsp;<br>&nbsp;</p>                            </blockquote>\n                        </figure>\n                        \n                        <!-- <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                            </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“Florence Pugh and Andrew Garfield scorch…The pair’s chemistry is off the charts and each set-piece a showstopper in this tragic romance.”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                            Kevin Maher, The Times\n                            </figcaption>\n                        </figure>\n\n                        <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                        </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“It’s such a joy to watch two such assured and natural performers allowed the room to exercise both movie star and actor muscles as well as showcase their ease with both comedy and drama.”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                            Benjamin Lee, Guardian\n                            </figcaption>\n                        </figure>\n\n                        <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                        </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“The perfect movie for when you want to sit in your feelings and be taken on an unashamedly emotional journey…Garfield and Pugh are as dreamy a team as you’d hope!”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                            Tori Brazier, Metro\n                            </figcaption>\n                        </figure>\n\n                        <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                        </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“Andrew Garfield and Florence Pugh will break your heart in a London romance of rare honesty.”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                                Helen O'Hara, Time Out\n                            </figcaption>\n                        </figure> -->\n\n                    </div>\n\n                    \n                    <div class=\"col-12 col-lg-6 ps-lg-5 order-0 order-lg-1\">\n                        <h2 class=\"fs-4 fjalla-one-regular\">Show times</h2>\n\n                        <p class=\"mb-5\">To book online, please select a time from below:</p>            <h4 class=\"fs-6 mb-4 fw-bold text-muted\">Today - Monday, April 7</h4>\n            <div class=\"d-flex flex-wrap text-center mb-4\">\n                <script>\n                    // Initialize all tooltips\n                    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle=\"tooltip\"]'));\n                    tooltipTriggerList.map(function (tooltipTriggerEl) {\n                        return new bootstrap.Tooltip(tooltipTriggerEl);\n                    });\n                </script>\n                           \n                                        <a role=\"button\" class=\"btn btn-selfridges rounded-1 mb-3 me-3 py-1 py-md-3 px-3 d-flex align-items-center\" \n                         href=\"https://web3.empire.mycloudcinema.com/#/book/38193\" style=\"min-height: 40px;\">\n                        <div class=\"d-flex align-items-center w-100 justify-content-center\">\n         