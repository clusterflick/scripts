            "text": "\n<!doctype html><!doctype html>\n<html lang=\"en\">\n<!-- <html lang=\"en\" class=\"h-100\" data-bs-theme=\"light\"> -->\n\n  <head>\n    <meta charset=\"UTF-8\">\n    <meta content=\"dark light\" name=\"color-scheme\">\n    <meta content=\"origin\" name=\"referrer\">\n\t\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\">\n    <meta name=\"Description\" content=\"A hub of entertainment, with cinema at its heart, set in iconic locations\">\n    <meta name=\"Description\" content=\"Discover the innovative world of Apple and shop everything iPhone, iPad, Apple Watch, Mac, and Apple TV, plus explore accessories, entertainment, and expert device support.\">\n    <meta property=\"og:title\" content=\"Olympic Studios\">\n    <meta property=\"og:description\" content=\"A hub of entertainment, with cinema at its heart, set in iconic locations\">\n    <meta property=\"og:url\" content=\"https://www.olympicstudios.com/\">\n    <meta property=\"og:locale\" content=\"en_UK\">\n    <meta property=\"og:image\" content=\"https://www.thecinemaatselfridges.com/assets/images/open_graph_logo.png?202110180743\">\n    <meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:site_name\" content=\"Olympic Studios\">\n\n    <title>Flow - The Cinema at Selfridges</title>\n    <meta name=\"generator\" content=\"cc v2\">\n\t\t<link rel=\"canonical\" href=\"https://www.olympicstudios.com\" />\n\n    <!-- BOOTSTRAP 5 -->\n\t\t<link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css\" rel=\"stylesheet\" integrity=\"sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH\" crossorigin=\"anonymous\">\n\t\t<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css\">\n\n\t\t<!-- FONTS -->\n    <link href=\"https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700|Noto+Sans:300,400,500,600,700,800|PT+Mono:300,400,500,600,700\" rel=\"stylesheet\">\n\t\t<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n\t\t<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n\t\t<link href=\"https://fonts.googleapis.com/css2?family=Fjalla+One&display=swap\" rel=\"stylesheet\">\n    \n    <link rel=\"stylesheet\" href=\"/assets/css/style.css?v=4.0.13\"/>\n    <!-- <link rel=\"stylesheet\" href=\"/assets/css/astro.css?v=4.0.13\"/> -->\n    <link rel=\"stylesheet\" href=\"/assets/css/style-custom.css?v=4.0.13\"/>\n    <link rel=\"stylesheet\" href=\"/assets/css/cinema-cloud.css?v=4.0.13\"/>\n    <link rel=\"stylesheet\" href=\"/assets/css/horizontal-scroller.css?v=4.0.13\"/>\n    <link rel=\"stylesheet\" href=\"/assets/css/nav.css?v=4.0.13\"/>\n\n\t\t<!-- FAVICON -->\n\t\t<link rel=\"shortcut icon\" type=\"image/ico\" href=\"/assets/images/cinema_3/favicon.ico\" >\n\t\t<!-- <link rel=\"apple-touch-icon\" type=\"image/png\" sizes=\"76x76\" href=\"/assets/images/cinema_3/favicon-76x76.png\"> -->\n\t\t<link rel=\"apple-touch-icon\" type=\"image/png\" sizes=\"167x167\" href=\"/assets/images/cinema_3/favicon-167x167.png\">\n\t\t<link rel=\"apple-touch-icon\" type=\"image/png\" sizes=\"180x180\" href=\"/assets/images/cinema_3/favicon-180x180.png\">\n\t\t<link rel=\"icon\" type=\"image/png\" sizes=\"48x48\" href=\"/assets/images/cinema_3/favicon-48x48.png\">\n\t\t<link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/assets/images/cinema_3/favicon-192x192.png\">\n\n    <!-- Google Tag Manager -->\n\t\t<meta name=\"msvalidate.01\" content=\"C01A3DCD56BCC4BD58FA4C01A144EFC1\" />\t\t\t<!-- Global site tag (gtag.js) - Google Analytics x -->\n\t\t\t<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-YP9Y0V9VN2\"></script>\n\t\t\t<script>\n\t\t\t\t\twindow.dataLayer = window.dataLayer || [];\n\t\t\t\t\tfunction gtag() {\n\t\t\t\t\t\t\tdataLayer.push(arguments);\n\t\t\t\t\t}\n\t\t\t\t\tgtag('js', new Date());\n\t\t\t\t\tgtag('config', 'G-YP9Y0V9VN2');\n\t\t\t</script>\n\t\t\t    <!-- End Google Tag Manager -->\n\n\t\t<script type=\"application/ld+json\">{\"@context\":\"http://schema.org\",\"@type\":\"MovieTheater\",\"name\":\"The Cinema at Selfridges\",\"address\":{\"@type\":\"PostalAddress\",\"name\":\"The Cinema at Selfridges\",\"streetAddress\":\"40 Duke Street London\",\"addressLocality\":\"London\",\"postalCode\":\"W1U 1AT\",\"addressCountry\":\"GB\"},\"image\":\"https://www.The Cinema at Selfridges/assets/images/cinema_3/cinema-logo.png\",\"url\":\"https://www.The Cinema at Selfridges\",\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"51.51526\",\"longitude\":\"-0.15198\"},\"priceRange\":\"\\u00a312 - \\u00a320\"}</script>\n\t</head>\n\t\n\t  <body>\n    <div id=\"announcement-bar\" class=\"border-bottom d-flex justify-content-between align-items-center start-0 end-0 announcement-bar-color-3\">\n      <p class=\"col m-0 d-flex justify-content-start ms-2\"></p>\n  \n      <p class=\"col-auto m-0 justify-content-center d-flex align-items-center justify-content-between text-dark lw-1\">\n          A hub of entertainment, with cinema at its heart, set in iconic locations\n      </p>\n    \n      <p class=\"col text-end m-0 text-uppercase\">  <a href=\"https://www.selfridges.com\" class=\"mx-0 mx-lg-4\">\n      <i class=\"bi bi-bag align-middle me-2 m-0 p-0 fs-10\"></i>\n      <span class=\"d-none d-lg-inline m-0 p-0 fs-10 d-flex align-items-center\">Back to shop</span>\n  </a>        </p>\n      </div>\n              \n\n  <section class=\"position-sticky top-0 z-index-4\">\n    <nav id=\"cc-nav\" class=\"navbar navbar-expand-lg bg-white border-bottom p-0 d-flex justify-content-between align-items-center start-0 end-0\">\n      \n      <!-- Hamburger Button (Visible only on mobile) -->\n      <div class=\"col-auto d-flex justify-content-start ms-2 d-lg-none\">\n\n        <!-- <button class=\"btn btn-primary\" type=\"button\" data-bs-toggle=\"offcanvas\" data-bs-target=\"#testOffcanvas\">Open Offcanvas</button> -->\n        <button class=\"navbar-toggler border-0 p-0\" type=\"button\" data-bs-toggle=\"offcanvas\"\n          data-bs-target=\"#offcanvasMenu\" aria-controls=\"offcanvasMenu\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n          <span class=\"navbar-toggler-icon\"></span>\n        </button>\n      </div>\n\n      <!-- Logo (Center on mobile, left on desktop) -->\n      <div class=\"col-auto d-flex justify-content-center position-absolute start-50 translate-middle-x d-lg-none\">\n      <a href=\"#\" class=\"navbar-brand mx-auto\">\n      <!-- <a href=\"\" class=\"navbar-brand mx-auto\"> -->\n\n      <a href=\"https://www.olympicstudios.com\" class=\"navbar-brand mx-auto\">\n      <!-- <img class=\"logo logo3 mobile-logo\" src=\"/assets/images/cinema-logo3.png\" alt=\"Cinema Logo\"> -->\n      <img class=\"logo logo0 mobile-logo\" src=\"/assets/images/OlympicLogo_Gold.png\" alt=\"Cinema Logo\">\n        </a>\n      </div>\n\n      <!-- Accounts Icon (Visible only on mobile) -->\n      <div class=\"col-auto d-flex justify-content-end d-lg-none me-2\">\n        <a href=\"/account\" class=\"text-decoration-none\">\n          <span class=\"d-none me-2 sign-in-tag\">Sign In</span>\n          <i class=\"bi bi-person\" style=\"font-size: 1.8rem; vertical-align: middle;\"></i>\n        </a>\n      </div>\n\n\n\n    <div class=\"offcanvas offcanvas-start w-80\" id=\"offcanvasMenu\" tabindex=\"-1\" aria-labelledby=\"offcanvasMenuLabel\">\n\n        <div class=\"offcanvas-header border-bottom\">\n          <span class=\"back-btn\" onclick=\"returnToMainMenu()\" aria-label=\"Go back to main menu\">\n            <i class=\"bi bi-chevron-left text-muted\"></i>\n          <!-- <div class=\"offcanvas-title-wrapper d-flex align-items-center\"> -->\n              <span class=\"offcanvas-title flex-grow-1\" id=\"menuTitle\"></span>\n          <!-- </div> -->\n          </span>\n          <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"offcanvas\" aria-label=\"Close\"></button>\n        </div>\n        \n        <div class=\"offcanvas-body d-lg-flex justify-content-between align-items-center\">\n      \n          <!-- Logo Centered on Desktop - DO NOT AMEND -->\n          <div class=\"col d-none d-lg-block ms-2 ms-lg-5\">\n            <a href=\"https://www.olympicstudios.com/\" class=\"d-inline-flex link-body-emphasis text-decoration-none align-middle\">\n              <!-- <img class=\"logo logo3\" src=\"/assets/images/cinema-logo3.png\" alt=\"Cinema Logo\" > -->\n              <img class=\"logo logo0 ms-3\" src=\"/assets/images/OlympicLogo_Gold.png\" alt=\"Cinema Logo\">\n            </a>\n          </div>\n\n          <div id=\"mainMenu\">\n            <ul class=\"navbar-nav col col-md-auto mb-2 justify-content-center mb-md-0\">\n\n              <li class=\"nav-item d-flex align-items-center justify-content-between \">\n                  <a href=\"https://www.olympicstudios.com/pages/select-your-cinema\" \n                    class=\"nav-link nav-link-underline flex-grow-1 d-flex justify-content-between align-items-center \" \n                    data-nav=\"2\" \n                    data-target=\"subMenu2\">\n                    Box Office<i class=\"bi bi-chevron-right ms-2 d-lg-none\"></i>\n                  </a>\n                  \n    <div class=\"hover-content border-bottom\">\n      <div class=\"container-fluid\">\n        <div class=\"row justify-content-center \">\n        \n\n    <div class=\"col-12 col-xl-10 py-lg-4 px-lg-9\">\n      <div class=\"row\">\n        <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n          <div class=\"menu-promotion\">\n            <a class=\"menu-promotion__link\" href=\"https://www.olympiccinema.com/whats-on\">\n              <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_cinema_1.jpg\">\n            </a>\n            <div class=\"pt-2\">Olympic Cinema</div>\n          </div>\n        </div>\n\n        <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n          <div class=\"menu-promotion\">\n            <a class=\"menu-promotion__link\" href=\"https://www.thecinemainthepowerstation.com/whats-on\">\n              <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_cinema_2.jpg\">\n            </a>\n            <div class=\"pt-2\">The Cinema in the Power Station</div>\n          </div>\n        </div>\n\n        <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n          <div class=\"menu-promotion\">\n            <a class=\"menu-promotion__link\" href=\"https://www.thecinemaatselfridges.com/whats-on\">\n              <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_cinema_3.jpg\">\n            </a>\n            <div class=\"pt-2\">The Cinema at Selfridges</div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n        </div>\n      </div>\n    </div>\n\n                </li>\n\n\n              <li class=\"nav-item \">\n                <a class=\"nav-link \" href=\"https://www.olympicstudios.com/blogs/events\">Events</a>\n                              </li>\n\n              <li class=\"nav-item \">\n                <a class=\"nav-link \" href=\"https://www.olympicstudios.com/pages/private-hire\">Private Hire</a>\n                              </li>\n\n              \n\n              <!-- <li class=\"nav-item d-flex align-items-center justify-content-between \">\n                  <a href=\"https://www.olympicstudios.com/pages/membership\" \n                    class=\"nav-link nav-link-underline flex-grow-1 d-flex justify-content-between align-items-center \" \n                    data-nav=\"5\" \n                    data-target=\"subMenu5\">\n                    Membership<i class=\"bi bi-chevron-right ms-2 d-lg-none\"></i>\n                  </a>\n                                </li> -->\n\n              <li class=\"nav-item \">\n                <a class=\"nav-link \" href=\"https://www.olympicstudios.com/pages/membership\">Membership</a>\n                              </li>\n\n\n              <li class=\"nav-item \">\n                <a class=\"nav-link \" href=\"https://www.olympicstudios.com/pages/recording-studio\">Recording Studio</a>\n                              </li>\n\n\n              <li class=\"nav-item d-flex align-items-center justify-content-between \">\n                  <a href=\"https://www.olympicstudios.com/pages/dine-drink-selfridges\" \n                    class=\"nav-link nav-link-underline flex-grow-1 d-flex justify-content-between align-items-center \" \n                    data-nav=\"7\" \n                    data-target=\"subMenu7\">\n                      Dine & Drink<i class=\"bi bi-chevron-right ms-2 d-lg-none\"></i>\n                  </a>\n                  \n    <div class=\"hover-content border-bottom\">\n      <div class=\"container-fluid\">\n        <div class=\"row justify-content-center \">\n        \n  <div class=\"col-12 col-xl-10 py-lg-4 px-lg-9\">\n    <div class=\"row\">\n      \n      <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n        <div class=\"menu-promotion\">\n          <a class=\"menu-promotion__link\" href=\"https://www.olympicstudios.com/pages/dine-drink-olympic-barnes\">\n            <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_dine_1.jpg\">\n          </a>\n          <div class=\"pt-2\">Olympic / Barnes</div>\n        </div>\n      </div>\n\n      <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n        <div class=\"menu-promotion\">\n          <a class=\"menu-promotion__link\" href=\"https://www.olympicstudios.com/pages/battersea-the-lounge-bar\">\n            <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_dine_2.jpg\">\n          </a>\n          <div class=\"pt-2\">The Cinema in The Power Station / Battersea</div>\n        </div>\n      </div>\n\n      <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n        <div class=\"menu-promotion\">\n          <a class=\"menu-promotion__link\" href=\"https://www.olympicstudios.com/pages/dine-drink-selfridges\">\n            <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_dine_3.jpg\">\n          </a>\n          <div class=\"pt-2\">The Cinema at Selfridges / Duke Street</div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n        </div>\n      </div>\n    </div>\n\n                </li>\n\n\n            </ul>\n          </div>\n\n          <!-- Accounts Icon aligned right end on mobile - DO NOT AMEND -->\n          <div class=\"col text-end d-none d-lg-block me-2 me-lg-5\">\n\n                      <a href=\"/account\" class=\"\">\n              <span class=\"sign-in-tag\">Sign In</span>\n              <i class=\"bi bi-person align-middle\" style=\"font-size: 1.8rem;\"></i>\n            </a>\n          </div>\n\n          <div class=\"sub-menus d-block d-lg-none\">\n\n            <div class=\"sub-menu\"  id=\"subMenu2\">\n              <h5 class=\"d-none\">Cinemas</h5>\n              \n\n    <div class=\"col-12 col-xl-10 py-lg-4 px-lg-9\">\n      <div class=\"row\">\n        <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n          <div class=\"menu-promotion\">\n            <a class=\"menu-promotion__link\" href=\"https://www.olympiccinema.com/whats-on\">\n              <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_cinema_1.jpg\">\n            </a>\n            <div class=\"pt-2\">Olympic Cinema</div>\n          </div>\n        </div>\n\n        <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n          <div class=\"menu-promotion\">\n            <a class=\"menu-promotion__link\" href=\"https://www.thecinemainthepowerstation.com/whats-on\">\n              <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_cinema_2.jpg\">\n            </a>\n            <div class=\"pt-2\">The Cinema in the Power Station</div>\n          </div>\n        </div>\n\n        <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n          <div class=\"menu-promotion\">\n            <a class=\"menu-promotion__link\" href=\"https://www.thecinemaatselfridges.com/whats-on\">\n              <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_cinema_3.jpg\">\n            </a>\n            <div class=\"pt-2\">The Cinema at Selfridges</div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n            </div>\n\n            <div class=\"sub-menu\" id=\"subMenu5\">\n              <h5 class=\"d-none\">Membership</h5>\n              \n  <div class=\"col-6\">\n      <div class=\"d-block text-center my-4 pt-lg-5 px-lg-9\">\n        <h2 class=\"fjalla-one-regular majortitle  text-uppercase h3 mb-4\">Membership</h2>\n        <p class=\"text-dark mb-4\">Welcome to the family</p>\n        <a href=\"https://www.olympicstudios.com/pages/membership\" class=\"btn btn-outline-dark mb-4 me-2 text-uppercase\" role=\"button\">Join Us</a>\n        <a href=\"https://www.olympicstudios.com/blogs/events\" class=\"btn btn-outline-dark mb-4 text-uppercase\" role=\"button\">Events</a>\n      </div>\n\n    </div>\n    <div class=\"col-6 pe-0\" style=\"height: 300px; overflow: hidden;\">\n      <img src=\"https://media.cinemacloud.co.uk/imageMisc/2025/membership-dropdown.jpg\" \n          alt=\"\" \n          class=\"w-100 h-100 object-fit-cover p-0\">\n    </div>\n            </div>\n\n            <div class=\"sub-menu\" id=\"subMenu6\">\n              <h5 class=\"d-none\">Recording Studio</h5>\n                <div class=\"d-block text-center my-4 py-lg-4 px-lg-9\">\n      <h2 class=\"fjalla-one-regular majortitle text-dark text-uppercase h3 mb-4\">Coming Soon</h2>\n      <!-- <a href=\"https://www.olympicstudios.com/pages/events\" role=\"button\" class=\"btn btn-outline-dark mb-4 text-uppercase\">Events</a> -->\n  </div>            </div>\n        \n            <div class=\"sub-menu\"  id=\"subMenu7\">\n              <h5 class=\"d-none\">Dine & Drink</h5>\n              \n  <div class=\"col-12 col-xl-10 py-lg-4 px-lg-9\">\n    <div class=\"row\">\n      \n      <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n        <div class=\"menu-promotion\">\n          <a class=\"menu-promotion__link\" href=\"https://www.olympicstudios.com/pages/dine-drink-olympic-barnes\">\n            <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_dine_1.jpg\">\n          </a>\n          <div class=\"pt-2\">Olympic / Barnes</div>\n        </div>\n      </div>\n\n      <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n        <div class=\"menu-promotion\">\n          <a class=\"menu-promotion__link\" href=\"https://www.olympicstudios.com/pages/battersea-the-lounge-bar\">\n            <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_dine_2.jpg\">\n          </a>\n          <div class=\"pt-2\">The Cinema in The Power Station / Battersea</div>\n        </div>\n      </div>\n\n      <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n        <div class=\"menu-promotion\">\n          <a class=\"menu-promotion__link\" href=\"https://www.olympicstudios.com/pages/dine-drink-selfridges\">\n            <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_dine_3.jpg\">\n          </a>\n          <div class=\"pt-2\">The Cinema at Selfridges / Duke Street</div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n            </div>\n\n          </div>\n \n\n\n        </div>\n    </div>\n    </nav>\n\n               \n    <script>\n              // document.addEventListener('DOMContentLoaded', function () {\n    // ... (your existing code) ...\n    // function handleMainMenuClick(e) {\n    //     // Prevent default navigation on mobile\n    //     if (window.innerWidth <= 921.98) {\n    //         const linkHref = e.currentTarget.href;\n    //         const hasSubmenu = e.currentTarget.dataset.target; // Check for data-target\n\n    //         if (hasSubmenu) {\n    //             e.preventDefault();\n    //             showSubMenu(hasSubmenu); // Use data-target to show submenu\n    //         }\n    //         // If the link does not have a submenu, allow default navigation\n    //     }\n    // }\n\n    // // Attach event listeners to menu items\n    // document.querySelectorAll('#mainMenu .nav-item a').forEach(link => {\n    //     link.addEventListener('click', handleMainMenuClick);\n    // });\n\n    // ... (rest of your code) ...\n// });\n            </script>\n\n\n    \n    <div id=\"page-submenus\" class=\"shopify-section shopify-section-group-header-group section-page-submenus\">\n      <!-- <div class=\"submenus\"> -->\n  <div class=\"d-flex justify-content-evenly\"><div class=\"submenu submenu-4\">\n<!-- <a href=\"/whats-on\" class=\"\"> -->\n  <a href=\"/whats-on\" class=\"\">\n        <span class=\"tagline\">What&#039;s On</span>\n    </a>\n</div><div class=\"submenu submenu-7\">\n<!-- <a href=\"/whats-on/babes-in-arms\" class=\"\"> -->\n  <a href=\"/whats-on/babes-in-arms\" class=\"\">\n        <span class=\"tagline\">Babes in Arms</span>\n    </a>\n</div><div class=\"submenu submenu-12\">\n<!-- <a href=\"/ticket-info\" class=\"\"> -->\n  <a href=\"/ticket-info\" class=\"\">\n        <span class=\"tagline\">Ticket Info</span>\n    </a>\n</div>      <!-- <div class=\"submenu submenu-1\">\n          <a href=\"/thecinemaatselfridges.com/signup\" class=\"\">\n              <span class=\"tagline\">Sign Up</span>\n          </a>\n      </div> --></div>    </div>\n  </section>\n\n  <section id=\"section_1_stack\" class=\"bg-dark py-4 py-lg-5\">    <div class=\"d-lg-block text-center \">\n        <img class=\"w-auto logo3-whatson mt-0\" src=\"/assets/images/cinema-logo-white-3.png\" alt=\"Cinema Logo\">\n    </div></section><section id=\"section_2_stack\" class=\"bg-white p-0\"><section class=\"mb-0\">\n    <div class=\"page-header py-5 py-md-0 ratio ratio-2x1 position-relative bg-white\">\n        <picture>\n            <source srcset=\"https://media.cinemacloud.co.uk/imageFilm/1992_7_1.jpg\" media=\"(max-width: 991.9px)\">\n            <source srcset=\"https://media.cinemacloud.co.uk/imageFilm/1992_10_1.jpg\" media=\"(min-width: 992px)\">\n            <img src=\"https://media.cinemacloud.co.uk/imageFilm/1992_10_1.jpg\" alt=\"Background\" class=\"w-100 h-100 position-absolute top-0 start-0 object-fit-cover\">\n        </picture>\n<div class=\"position-absolute w-100 w-lg-50 h-50 h-lg-100 bg-grad\"></div>        <div id=\"movie-overlay\" class=\"d-flex flex-column justify-content-end justify-content-lg-center align-items-center align-items-lg-start h-100 mx-lg-7\">\n        <div class=\"d-none d-lg-inline movie-awards mb-4 d-flex justify-content-start\"><img src=\"https://media.cinemacloud.co.uk/imageMisc/award_bafta_nom.png\" class=\"cert-40 me-4\" alt=\"Bafta Nomination\"><img src=\"https://media.cinemacloud.co.uk/imageMisc/award_oscar_win.png\" class=\"cert-40 me-4\" alt=\"Oscar Winner\"></div>    <img class=\"title-treatment mb-4 mb-lg-6\" src=\"https://media.cinemacloud.co.uk/imageFilm/1992_8_1.png\" alt=\"Logo\">    <div class=\"movie-badges mb-2 d-flex justify-content-start\">        <span class=\"badge text-bg-secondary me-2\">2024</span>\n    <span class=\"badge text-bg-secondary me-2\">1hr 25mins</span>        \n        <img src=\"https://media.cinemacloud.co.uk/bbfc/SVGs/BBFC_U_RGB.svg\" class=\"cert-20\" alt=\"BBFC Cert U\">\n    </div><p class=\"text-white opacity-6\"><small>Animation, Fantasy, Adventure</small></p>    </div>    </div>\n</div>\n</section></section><section id=\"section_3_stack\" class=\"bg-white p-0\">            <div class=\"container my-5\">\n                <div class=\"row\">\n\n                    <div class=\"col-12 col-lg-6 order-1 order-lg-0\">\n                        <h3 class=\"text-uppercase\">Flow</h3>\n\n\n                        <p><img src=\"https://media.cinemacloud.co.uk/bbfc/SVGs/BBFC_U_RGB.svg \" class=\"cert-40 my-4\" alt=\"BBFC Cert $certs\" ></p>\n\n                                                    <h3 class=\" fjalla-one-regular fs-4 text-dark mb-4\">Synopsis</h3>\n                            <p class=\"mb-5 text-dark\">A solitary cat, displaced by a great flood, finds refuge on a boat with various species and must navigate the challenges of adapting to a transformed world together.</p>\n                                                \n                        <div class=\"row\">\n                            <div class=\"col-7 col-md-8\">\n                                \n\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Duration:</p>\n                                    <p class=\"mt-0 fw-bolder\">1hr 25mins</p>\n                                \n\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Available Sound Formats:</p>\n                                    <p class=\"mt-0 fw-bolder sound-formats\">\n                                        5.1                                    </p>\n                                                                                                    <p class=\"mb-1 fw-bold text-secondary\">Genre:</p>\n                                    <p class=\"mt-0 fw-bolder\">Animation, Fantasy, Adventure</p>\n                                                                                                    <p class=\"mb-1 fw-bold text-secondary\">Country:</p>\n                                    <p class=\"mt-0 fw-bolder\">Belgium, France, Latvia</p>\n                                \n                            </div>\n                            <div class=\"col-5 col-md-4\">\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Director:</p>\n                                    <p class=\"mt-0 fw-bolder\">Gints Zilbalodis</p>\n                                \n                                                            </div>\n                        </div>\n\n                                                <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <blockquote class=\"blockquote\">\n                                <p>Oscar Winner:<br><i>Best Animated Feature</i></p><p><i>“No ebbs here: Flow is the real deal.”</i><br>★★★★★ John Nugent, Empire&nbsp;</p><p>“It’s proof there’s not only one direction to take, and that Hollywood’s fixation on photorealism and A-list voice actors isn’t absolute.”<br>★★★★ Clarisse Loughrey, Independent</p><p>“It’s a film full of wonders but not a single word of dialogue in the epic tale of one cat’s adventures after a flood of biblical proportions. As visions of apocalypse go, it’s rather lovely”<br>★★★★ Cath Clarke, Guardian</p><p>“Flow might be a digital confection, but it’s also open, alive, elemental. In every sense, it’s a breath of fresh air.”<br>★★★★ Robbie Collin, Daily Telegraph<br>&nbsp;</p>                            </blockquote>\n                        </figure>\n                        \n                        <!-- <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                            </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“Florence Pugh and Andrew Garfield scorch…The pair’s chemistry is off the charts and each set-piece a showstopper in this tragic romance.”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                            Kevin Maher, The Times\n                            </figcaption>\n                        </figure>\n\n                        <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                        </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“It’s such a joy to watch two such assured and natural performers allowed the room to exercise both movie star and actor muscles as well as showcase their ease with both comedy and drama.”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                            Benjamin Lee, Guardian\n                            </figcaption>\n                        </figure>\n\n                        <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                        </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“The perfect movie for when you want to sit in your feelings and be taken on an unashamedly emotional journey…Garfield and Pugh are as dreamy a team as you’d hope!”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                            Tori Brazier, Metro\n                            </figcaption>\n                        </figure>\n\n                        <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                        </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“Andrew Garfield and Florence Pugh will break your heart in a London romance of rare honesty.”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                                Helen O'Hara, Time Out\n                            </figcaption>\n                        </figure> -->\n\n                    </div>\n\n                    \n                    <div class=\"col-12 col-lg-6 ps-lg-5 order-0 order-lg-1\">\n                        <h2 class=\"fs-4 fjalla-one-regular\">Show times</h2>\n\n                        <p class=\"mb-5\">To book online, please select a time from below:</p>            <h4 class=\"fs-6 mb-4 fw-bold text-muted\">Today - Monday, April 7</h4>\n            <div class=\"d-flex flex-wrap text-center mb-4\">\n                <script>\n                    // Initialize all tooltips\n                    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle=\"tooltip\"]'));\n                    tooltipTriggerList.map(function (tooltipTriggerEl) {\n                        return new bootstrap.Tooltip(tooltipTriggerEl);\n                    });\n                </script>\n                            </div>\n                        <h4 class=\"fs-6 mb-4 fw-bold text-muted\">Tomorrow - Tuesday, April 8</h4>\n            <div class=\"d-flex flex-wrap text-center mb-4\">\n                <script>\n                    // Initialize all tooltips\n                    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle=\"tooltip\"]'));\n                    tooltipTriggerList.map(function (tooltipTriggerEl) {\n                        return new bootstrap.Tooltip(tooltipTriggerEl);\n   