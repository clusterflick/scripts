=\"0 0 15 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n  <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M14.4603 1.70711C14.8508 1.31658 14.8508 0.683417 14.4603 0.292893C14.0698 -0.0976311 13.4366 -0.0976311 13.0461 0.292893L7.75317 5.58579L2.46028 0.292893C2.06976 -0.0976311 1.43659 -0.0976311 1.04607 0.292893C0.655543 0.683417 0.655543 1.31658 1.04607 1.70711L6.33896 7L1.04607 12.2929C0.655543 12.6834 0.655543 13.3166 1.04607 13.7071C1.43659 14.0976 2.06976 14.0976 2.46028 13.7071L7.75317 8.41421L13.0461 13.7071C13.4366 14.0976 14.0698 14.0976 14.4603 13.7071C14.8508 13.3166 14.8508 12.6834 14.4603 12.2929L9.16739 7L14.4603 1.70711Z\" fill=\"white\"/>\n  </svg>      </button>\n    </div>\n          <div class=\"app-modal__body pt-24 pb-40 app-modal__body--modal-app\">\n\n        <div class=\"container\">\n          <div class=\"pt-4 text-center\">\n                      <h2 class=\"h1 app-modal__title text-bst-pink uppercase mb-8\">DOWNLOAD<br />\nTHE APP</h2>\n                      <div class=\"redactor-content app-modal__redactor-content text-bst-pink text-center\">\n                          <p>•\tSecurely access and share your tickets. Tickets are being distributed over the next few weeks. You will receive an email when your tickets are ready to view in the app. Once you've received this email, you can sign in to My Tickets.</p>\n<p>•\tView all artists and build your personalised lineup. Set times coming soon!</p>\n<p>•\tStay in the loop with essential, up-to-date event info</p>\n<p>•\tDiscover competitions and promotions at the event</p>\n                        <div class=\"mt-24 max-w-xl flex flex-col mx-auto\">\n                              <a href=\"https://play.google.com/store/apps/details?id=com.aeg.bst\" target=\"_blank\" class=\"mb-8 app-modal__app-link mx-auto\">\n                  <img src=\"/img/dl-and.png\" alt=\"download app from android app store.\">\n                </a>\n                                          <a href=\"https://apps.apple.com/us/app/bst-hyde-park-2023/id892502483\" target=\"_blank\" class=\"app-modal__app-link mx-auto\">\n                <img src=\"/img/dl-ios.png\" alt=\"download app from Apple IOS app store.\">\n              </a>\n                          </div>\n\n            </div>\n\n          </div>\n        </div>\n\n      </div>\n\n  </div>\n\n</div>\n\n\n  <main id=\"main\" class=\"page-concert show-behind-header\" data-page-handle=\"openHouse\">\n    <div class=\"hero-event overflow-hidden\">\n  <div class=\"container\">\n        \n    <div data-aos=\"fade-left\" data-aos-delay=\"200\" class=\"hero-event__image\">\n              \n    \n      \n\n  \n        <picture class=\"  \" style=\"\">\n                                                                  <source media=\"(min-width: 1920px)\" srcset=\"https://aeg-media-assets.b-cdn.net/bst/images/BST_hyde_park_@elliekoepke_open_house_3rd_july_atmos_132.jpg?width=1422&amp;height=1070&amp;focus_crop=2215,1667,0.5,0.5\">\n                        <source media=\"(min-width: 1920px)\" srcset=\"https://aeg-media-assets.b-cdn.net/bst/images/BST_hyde_park_@elliekoepke_open_house_3rd_july_atmos_132.jpg?width=1422&amp;height=1070&amp;focus_crop=2215,1667,0.5,0.5\">\n                                                                  <source media=\"(min-width: 1024px)\" srcset=\"https://aeg-media-assets.b-cdn.net/bst/images/BST_hyde_park_@elliekoepke_open_house_3rd_july_atmos_132.jpg?width=1067&amp;height=803&amp;focus_crop=2215,1667,0.5,0.5\">\n                        <source media=\"(min-width: 1024px)\" srcset=\"https://aeg-media-assets.b-cdn.net/bst/images/BST_hyde_park_@elliekoepke_open_house_3rd_july_atmos_132.jpg?width=1067&amp;height=803&amp;focus_crop=2215,1667,0.5,0.5\">\n                                                                  <source media=\"(min-width: 600px)\" srcset=\"https://aeg-media-assets.b-cdn.net/bst/images/BST_hyde_park_@elliekoepke_open_house_3rd_july_atmos_132.jpg?width=667&amp;height=502&amp;focus_crop=2215,1667,0.5,0.5\">\n                        <source media=\"(min-width: 600px)\" srcset=\"https://aeg-media-assets.b-cdn.net/bst/images/BST_hyde_park_@elliekoepke_open_house_3rd_july_atmos_132.jpg?width=667&amp;height=502&amp;focus_crop=2215,1667,0.5,0.5\">\n                                                                  <source media=\"\" srcset=\"https://aeg-media-assets.b-cdn.net/bst/images/BST_hyde_park_@elliekoepke_open_house_3rd_july_atmos_132.jpg?width=768&amp;height=578&amp;focus_crop=2215,1667,0.5,0.5\">\n                        <source media=\"\" srcset=\"https://aeg-media-assets.b-cdn.net/bst/images/BST_hyde_park_@elliekoepke_open_house_3rd_july_atmos_132.jpg?width=768&amp;height=578&amp;focus_crop=2215,1667,0.5,0.5\">\n                        <img src=\"https://aeg-media-assets.b-cdn.net/bst/images/BST_hyde_park_@elliekoepke_open_house_3rd_july_atmos_132.jpg?width=768&amp;height=578&amp;focus_crop=2215,1667,0.5,0.5\"\n          alt=\"A large crowd sitting on the floor watching a film at the Open Air Cinema presented by British Airways.\"\n          style=\"\"\n          decoding=\"async\"\n          loading=\"lazy\"\n          width=\"1422\"\n          height=\"1070\"\n                    \n                    >\n    </picture>\n  \n\n          </div>\n\n    <div class=\"grid grid-cols-12 gap-xxs md:gap-sm\">\n      <div class=\"col-span-12 md:col-span-7\">\n\n        <h1 data-aos=\"fade-right\" \n          class=\"variable-color  uppercase mb-xs text-center md:text-left\">\n          Open House\n        </h1>\n\n        <div data-aos=\"fade-right\" data-aos-delay=\"200\" class=\"mb-xs h3\"><p>Thank you for joining us this summer!</p></div>\n\n        \n      </div>\n    </div>\n  </div>\n</div>\n    \n    \n                      \n\n    \n      \n    \n    <!-- h-md h-sm h-lg h-xl -->\n<div class=\"spacer h-md bg-\"></div>\n\n    \n      \n    \n    <div class=\"gallery bg-white overflow-hidden\">\n  <div class=\"container\