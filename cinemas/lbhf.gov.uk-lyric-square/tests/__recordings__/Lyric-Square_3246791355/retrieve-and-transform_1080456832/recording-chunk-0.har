alendar View*/ \r\n\r\n.tribe-common h3 a {\r\n\tfont-size: 20px;\r\n\tline-height: 25px;\r\n\tfont-weight: 500;\r\n}\r\n\r\n.tribe-common--breakpoint-medium.tribe-common .tribe-common-l-container {\r\n    padding-left: 0px !important;\r\n    padding-right: 0px !important;\r\n}\r\n\r\n.tribe-common--breakpoint-medium.tribe-events .tribe-events-l-container {\r\n    padding-bottom: 10px !important;\r\n    padding-top: 30px !important;\r\n}\r\n\r\n.tribe-events .tribe-events-calendar-month__day--past .tribe-events-calendar-month__calendar-event-datetime {\r\n    margin-bottom: 10px;\r\n}\r\n\r\n.tribe-events .tribe-events-calendar-month__calendar-event--featured:before {\r\n    background-color: #ec2e64 !important;\r\n}\r\n\r\n /*Filter Bar*/ \r\n\r\n.tribe-events .tribe-events-c-search__button {\r\n    background-color: #7cc470;\r\n}\r\n\r\n.tribe-events .tribe-events-c-search__button:hover {\r\n    background-color: rgb(103 167 92);\r\n}\r\n\r\n.tribe-common .tribe-common-c-btn {\r\n\t    border-radius: 0;\r\n}\r\n\r\n /*Map View*/ \r\n\r\n.tribe-common--breakpoint-medium.tribe-events-pro .tribe-events-pro-map__event-datetime-featured-text {\r\n    color: #0caa8f !important; \r\n}\r\n\r\n /*List View*/ \r\n\r\n.tribe-common--breakpoint-medium.tribe-events .tribe-events-calendar-list__event-datetime-featured-text {\r\n    color: #0caa8f !important;\r\n}\r\n\r\n.tribe-events .tribe-events-calendar-list__event-row--featured .tribe-events-calendar-list__event-date-tag-datetime:after {\r\n    background-color: #ec2e64 !important;\r\n}\r\n\r\n /*Venue*/ \r\n\r\n@media (min-width: 768px) {\r\n.tribe-events-venue-map {\r\n    width: 430px;\r\n}\r\n}\r\n\r\n@media (min-width: 768px) {\r\n.tribe-events-venue-map>div {\r\n    max-height: 360px;\r\n}\r\n}\r\n\r\n /*Single Event Page*/ \r\n\r\n.tribe-events-meta-group a {\r\n    color: #0caa8f;\r\n}\r\n\r\n /*Grid View*/ \r\n\r\n.tribe-events-pro .tribe-events-pro-photo__event-datetime-featured-text {\r\n    color: #0caa8f !important;\r\n}\r\n\r\n.tribe-common .tribe-common-c-svgicon {\r\n    color: #0caa8f !important;\r\n}\r\n\r\n.tribe-common .tribe-common-c-btn-border {\r\n    border: 3px solid #7cc470;\r\n    border-radius: 0;\r\n    color: #7cc470;\r\n}\r\n\r\n.tribe-events .tribe-events-c-subscribe-dropdown .tribe-events-c-subscribe-dropdown__button:hover {\r\n    background-color: #7cc470;\r\n}\r\n\r\n.tribe-common--breakpoint-medium.tribe-common .tribe-common-b2 {\r\n    margin-bottom: 5px;\r\n}\r\n</style>\n<!-- end Simple Custom CSS and JS -->\n<!-- start Simple Custom CSS and JS -->\n<style type=\"text/css\">\n.qode-btn.qode-btn-with-shadow {\r\n    -webkit-box-shadow: 0 0px 0px #e2e2e2;\r\n    -moz-box-shadow: 0 0px 0px #e2e2e2;\r\n    box-shadow: 0 0px 0px #e2e2e2;\r\n}\r\n\r\n.separator.small {\r\n    background-color: #30303000 !important;\r\n    height: 0px  !important;\r\n    position: relative;\r\n    width: 22px;\r\n    display: block;\r\n    margin: 0px auto 0px  !important;\r\n}\r\n\r\n.qode-cta-section .qode-cta-section-text-wrapper {\r\n  text-align: left;\r\n}\r\n\r\n.qode-cta-section .qode-cta-section-text-wrapper .qode-cta-section-title {\r\n    font-size: 38px;\r\n    text-transform: none;\r\n    font-weight: 100;\r\n    background-color: #00aeef;\r\n    display: inline-block;\r\n    padding: 30px 30px 30px 30px;\r\n}\r\n\r\n.qode-btn.qode-btn-solid {\r\n    color: #303030;\r\n    text-transform: uppercase;\r\n    font-weight: 800;\r\n    font-family: Roboto Condensed;\r\n    font-size: 16px;\r\n}\r\n\r\n.qode-cta-section .qode-cta-section-text-wrapper {\r\n    width: 300px;\r\n    height: 300px;\r\n}\r\n\r\n@media only screen and (max-width: 768px) {\r\n.qode-cta-section img {\r\n    -webkit-transform: scale(1);\r\n    -moz-transform: scale(1);\r\n    transform: scale(1);\r\n}\r\n}\r\n\r\n@media only screen and (max-width: 600px) {\r\n.qode-cta-section img {\r\ndisplay: block;\r\n}\r\n}\r\n\r\n@media only screen and (max-width: 600px) {\r\n.qode-cta-section .qode-cta-section-text-wrapper {\r\n    width: 300px;\r\n    height: 100px;\r\n}\r\n}\r\n\r\n@media only screen and (max-width: 600px) {\r\n.qode-cta-section .qode-cta-section-text-wrapper .qode-cta-section-title {\r\n    font-size: 30px;\r\n  }\r\n}</style>\n<!-- end Simple Custom CSS and JS -->\n<!-- start Simple Custom CSS and JS -->\n<style type=\"text/css\">\n.filter_holder ul li span {\r\n    display: inline-block;\r\n    padding: 0 22px;\r\n    position: relative;\r\n    letter-spacing: 1px;\r\n    text-transform: uppercase;\r\n    font-weight: 500;\r\n    background-color: #7cc470;\r\n    border: 2px solid #fff;\r\n    padding: 10px 20px;\r\n    font-family: Roboto Condensed;\r\n    color: #fff !important;\r\n}\r\n\r\n.filter_holder ul li.active span {\r\n    color: #183140!important;\r\n    font-weight: 800;\r\n}\r\n  \r\n.filter_holder ul li.active span, .filter_holder ul li:hover span {\r\n    color: #183140!important;\r\n}\r\n\r\n.projects_holder article .portfolio_like {\r\n    margin: 0 0 0 10px;\r\n    display: none;\r\n}\r\n\r\n.qbutton.white:hover {\r\n    border-color: #7cc470;\r\n    background-color: #7cc470;\r\n}\r\n\r\n\r\n.portfolio_single .dots {\r\n    display: none;\r\n}\r\n\r\n.portfolio_single .portfolio_social_holder .portfolio_like {\r\n  display: none;\r\n}\r\n\r\n.portfolio_detail .info h6 {\r\n    color: #7cc470;\r\n  padding-bottom: 10px;\r\n}\r\n\r\n.portfolio_detail .info p {\r\nmargin-top: 1px;\r\n    margin-bottom: 1px;\r\n}\r\n\r\n.portfolio_single h3 {\r\n    margin: 40px 0 8px;\r\n}\r\n\r\n@media screen and (min-width: 600px) and (max-width: 1000px) {\r\n.two_columns_66_33>.column2 {\r\n    width: 100%;\r\n    float: left;\r\n}\r\n}\r\n\r\n.portfolio_single {\r\n    display: block;\r\n    margin-top: 30px;\r\n}</style>\n<!-- end Simple Custom CSS and JS -->\n<!-- start Simple Custom CSS and JS -->\n<style type=\"text/css\">\n.qode-accordion-holder .qode-title-holder {\r\n    border-bottom: 1px solid #1d2328;\r\n}</style>\n<!-- end Simple Custom CSS and JS -->\n<!-- start Simple Custom CSS and JS -->\n<style type=\"text/css\">\n.q_icon_with_title.small.square .icon_holder {\r\ntext-align: left;\r\n}\r\n\r\n.q_font_awsome_icon_stack i.fa-stack-base, .q_icon_with_title .icon_holder .fa-stack {\r\n    border: 0px solid silver;\r\n}\r\n\r\n .q_icon_with_title.square .icon_holder .fa-stack {\r\n    -webkit-border-radius: 0px;\r\n    -moz-border-radius: 0px;\r\n    border-radius: 0px;\r\n}\r\n\r\n.q_icon_with_title.center.center .icon_holder {\r\n    margin: 0 0 5px;\r\n}\r\n\r\n\r\n.h2, h2 {\r\n    margin-bottom: -15px;\r\n}</style>\n<!-- end Simple Custom CSS and JS -->\n<!-- start Simple Custom CSS and JS -->\n<style type=\"text/css\">\n.title.title_size_large h1 {\r\n    background-color: #7cc470;\r\n    padding: 60px 80px 60px 30px;\r\n    display: inline-block !important;\r\n}\r\n\r\n@media only screen and (max-width: 480px) {\r\n.title.title_size_large h1 {\r\n    font-size: 16px!important;\r\n    line-height: 25px!important;\r\n    padding: 20px 60px 20px 20px !important;\r\n}\r\n}\r\n\r\n@media screen and (min-width: 1921px) {\r\n.title.title_size_large.position_left.has_background {\r\n    background-size: cover !important;\r\n}\r\n}\r\n\r\n.archive.post-type-archive-tribe_events .title_subtitle_holder h1 span {\r\n  display: none; \r\n}\r\n.archive.post-type-archive-tribe_events .title_subtitle_holder h1:after {\r\n  content: \"Calendar\";  \r\n}\r\n\r\n</style>\n<!-- end Simple Custom CSS and JS -->\n<!-- start Simple Custom CSS and JS -->\n<style type=\"text/css\">\n.wpb_widgetised_column .widget {\r\n    margin: 0 0 08px;\r\n}\r\n\r\n.wpb_widgetised_column .widget a:hover {\r\n      color: #949da0;\r\n}\r\n\r\n.blog_holder article .post_image {\r\n  width: 75%;\r\n}\r\n\r\n.blog_holder.blog_single article {\r\n    margin: 20px 0px;\r\n}\r\n\r\n.blog_holder article .post_text h2 .date {\r\n    color: #0caa8f;\r\n}\r\n\r\n.blog_holder.blog_single article h2 {\r\n    display: block;\r\n 