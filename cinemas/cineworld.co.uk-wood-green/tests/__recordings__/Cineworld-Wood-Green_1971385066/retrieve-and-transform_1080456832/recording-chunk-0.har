          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014754\",\"name\":\"RBO Cinema Season 2026-27: Carmen\",\"originalName\":\"RBO Cinema Season 2026-27: Carmen\",\"length\":215,\"posterLink\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Carmen/HO00014754/TV_SmallPosterImage/20260528-061237554.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Carmen/HO00014754/TV_LargePosterImage/20260528-061237554.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/rbo-cinema-season-2026-27-carmen/ho00014754\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Alexander Vinogradov, Barnaby Rea, Ginger Costa-Jackson, Russell Thomas, Adriana González\",\"directors\":\"Damiano Michieletto\",\"synopsis\":\"Under the oppressive heat of the Spanish sun, the fiercely independent Carmen attracts the attention of Don José. She warns him not to fall in love with her, but his obsession knows no bounds. Damiano Michieletto’s searing production returns, casting scorching light on the lust, violence and destructive desire of Bizet’s ever-popular opera. \\nAn all-star cast brings this white-hot drama to life, with Ginger Costa-Jackson in the fiery title role, alongside Russell Thomas as the jealous and despairing Don José. Following his 2023 Royal Opera debut, Sesto Quatrini returns to conduct Bizet’s electrifying and sensual score.\",\"dateStarted\":\"2026-11-10T00:00:00\",\"eventCount\":75,\"categoriesAttributes\":[],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"3d\",\"alternative-content\",\"laser\",\"recliner\",\"reserved-selected\",\"unlimited-screening\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Carmen/HO00014754/TV_TopShelfPosterImage/20260528-061237554.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Carmen/HO00014754/TV_SmallPosterImage/20260528-061237554.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Carmen/HO00014754/Mobile_MovieThumbnail/20260528-061237554.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Carmen/HO00014754/TV_LargePosterImage/20260528-061237554.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Carmen/HO00014754/Mobile_MovieFeed/20260528-061351802.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"TRAFALGAR RELEASING\"}}}",
