\\"classes\\\":\\\"reserved-seating ad 18 sc2\\\"}\"}]},{\"id\":\"22214\",\"name\":\"SILVER SCREEN A Real Pain\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"silver-screen-a-real-pain\",\"posterImage\":\"ik86r9lohoaqdzf6ftyca6knwaan\",\"bannerImage\":\"cw4i13foduplozc84g0e5e7y88uu\",\"synopsis\":\"Written and directed by Jesse Eisenberg. Mismatched cousins David (Jesse Eisenberg) and Benji (Kieran Culkin) reunite for a tour through Poland to honor their beloved grandmother. The adventure takes a turn when the odd-couple's old tensions resurface against the backdrop of their family history.\",\"starring\":\"Jesse Eisenberg, Kieran Culkin, Will Sharpe, Jennifer Grey\",\"directedBy\":\"Jesse Eisenberg\",\"producedBy\":\"Emma Stone, Jesse Eisenberg, Dave McCary, Ewa Puszczyńska, Ali Herting, Jennifer Semler\",\"searchTerms\":\"\",\"duration\":90,\"genre\":\"Comedy\",\"allGenres\":\"Comedy, Drama\",\"rating\":\"15\",\"trailerYoutubeId\":\"lGeZQWMMDgM\",\"trailerVideo\":null,\"releaseDate\":\"2025-01-10\",\"dateOfFirstShowing\":\"2025-03-05\",\"tmdbPopularityScore\":116.649,\"tmdbId\":\"1013850\",\"dcmEdiMovieId\":\"407718\",\"dcmEdiMovieName\":\"Andre Rieu's Christmas Concert: Gold And Silver (Concert) (2D) [U]\",\"siteId\":\"91\",\"titleClassId\":\"75\",\"showings\":[{\"id\":\"276074\",\"time\":\"2025-03-05T11:00:00Z\",\"ticketsSold\":10,\"screenId\":\"133\",\"seatsRemaining\":57,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating ad silver-screening 15 sc3\\\"}\"}]},{\"id\":\"22216\",\"name\":\"SUBTITLED A Complete Unknown\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"subtitled-a-complete-unknown\",\"posterImage\":\"uj0j8j7su9o9c8dbhsesfhxv7l98\",\"bannerImage\":\"c8qy16k9115c4xs3uud7fesyn9g7\",\"synopsis\":\"Set in the influential New York music scene of the early 60s, A COMPLETE UNKNOWN follows 19-year-old Minnesota musician BOB DYLAN’s (Timothée Chalamet) meteoric rise as a folk singer to concert halls and the top of the charts – his songs and mystique becoming a worldwide sensation – culminating in his groundbreaking electric rock and roll performance at the Newport Folk Festival in 1965.\",\"starring\":\"Timothée Chalamet, Edward Norton, Elle Fanning, Monica Barbaro, Scoot McNairy, Dan Fogler, Boyd Holbrook\",\"directedBy\":\"James Mangold\",\"producedBy\":\"Timothée Chalamet, James Mangold, Fred Berger, Alex Heineman, Alan Gasmer, Peter Jaysen, Bob Bookman, Jeff Rosen\",\"searchTerms\":\"\",\"duration\":140,\"genre\":\"Drama\",\"allGenres\":\"Drama, Music\",\"rating\":\"15\",\"trailerYoutubeId\":\"Nsvexi2Ulbs\",\"trailerVideo\":null,\"releaseDate\":\"2025-01-17\",\"dateOfFirstShowing\":\"2025-03-06\",\"tmdbPopularityScore\":131.361,\"tmdbId\":\"661539\",\"dcmEdiMovieId\":\"446426\",\"dcmEdiMovieName\":\"Big Hero 6 Subtitled (2D) [PG]\",\"siteId\":\"91\",\"titleClassId\":\"75\",\"showings\":[{\"id\":\"276115\",\"time\":\"2025-03-06T16:15:00Z\",\"ticketsSold\":0,\"screenId\":\"131\",\"seatsRemaining\":44,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating subtitled ad 15 sc1\\\"}\"}]},{\"id\":\"22150\",\"name\":\"Mickey 17\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"mickey-17\",\"posterImage\":\"s3tdq8b608za8f252d8fik76db8r\",\"bannerImage\":\"1xtxgtipr795uz7wonbyjqoulfbz\",\"synopsis\":\"From the Academy Award-winning writer/director of “Parasite,” Bong Joon Ho, comes his next groundbreaking cinematic experience, “Mickey 17.” The unlikely hero, Mickey Barnes (Robert Pattinson) has found himself in the extraordinary circumstance of working for an employer who demands the ultimate commitment to the job… to die, for a living.\",\"starring\":\"Robert Pattinson, Mark Ruffalo, Naomi Ackie, Toni Collette, Steven Yeun, Anamaria Vartolomei, Holliday Grainger\",\"directedBy\":\"Bong Joon Ho\",\"producedBy\":\"Bong Joon Ho, Dooho Choi, Dede Gardner, Jeremy Kleiner\",\"searchTerms\":\"\",\"duration\":137,\"genre\":\"Science Fiction\",\"allGenres\":\"Science Fiction, Fantasy, Comedy\",\"rating\":\"15\",\"trailerYoutubeId