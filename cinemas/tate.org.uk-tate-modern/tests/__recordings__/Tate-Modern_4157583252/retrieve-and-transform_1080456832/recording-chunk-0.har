ia.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/Picasso_The_Three_Dancers.max-500x500.jpg\" alt=\"\" /></noscript>\n\n\n            \n        </div>\n    </div>\n    \n    \n\n    <div class=\"card-content\">\n        \n        \n                <div class=\"card-content__inner\">\n\n                    \n                        <div class=\"card-tags\">\n                            \n                                <span>Exhibition</span>\n                            \n                            \n                            \n                        </div>\n                    \n\n                    <h2 class=\"card__title\">\n                        <span class=\"card__title--maintitle\">Theatre Picasso</span>\n                    </h2>\n\n                    \n                    \n                </div>\n        \n    \n    \n        <div class=\"card-icons\">\n            <div class=\"event-info event-info__venue\">\n                <div class=\"event-icon\">\n                    <i class=\"icon--location\"></i>\n                </div>\n                <span>Tate Modern</span>\n            </div>\n\n            <div class=\"event-info event-info__date\">\n                <div class=\"event-icon\">\n                    <i class=\"icon--calendar\"></i>\n                </div>\n                <span>Until 12 Apr 2026</span>\n            </div>\n            \n                <div class=\"event-info event-info__price\">\n                    <!--\n                    <div class=\"event-icon\">    \n                        <i class=\"icon--ticket\"></i>\n                    </div>\n                    \n                    <span> \n                            £15 / Free for Members \n                        </span>-->\n                </div> \n                               \n        </div>\n    \n    </div>\n    \n\n    \n    \n    </a>\n</div>\n\n    </div>\n\n\n        \n    </div>\n</div>\n\n                                        </div>\n                                    \n                                </div>\n                            </div>\n                        </form>\n                    </div>\n\n                    <div class=\"header-nav__item header-nav__join\">\n                        <a href=\"https://shop.tate.org.uk/membership\" class=\"btn btn--type__no-bg btn--size__small btn--style__text\" data-gtm-name=\"Navigation-header\" aria-label=\"Tate Join\">\n                            <span class=\"btn__text\">Become a Member</span>\n                        </a>\n                    </div>\n\n\n                </div>\n                \n                \n\n                \n            </div>\n\n        </div>\n    </header>\n    \n\n    <script>if(typeof(window.tatePopulateBasket)!=='undefined')window.tatePopulateBasket();</script>\n    \n\n    \n\n    \n    \n\n    <main id=\"content\" itemscope=\"\" itemtype=\"https://schema.org/WebPage\" class=\"container-16 \">\n        \n<article class=\"event event--film\">\n    \n\n\n\n\n<header class=\"content-header splash-header  splash-header--with-cta\">\n    <div class=\"container\">\n        <div class=\"container__inner\">\n            \n            \n            \n            \n\n\n            <div class=\"splash-main\">\n                <div class=\"splash-header__primary-info\">\n\n                    \n\n\n                    \n                        <span class=\"splash-header__venue\" itemprop=\"location\">Tate Modern</span>\n                    \n\n                    \n                        <span class=\"splash-header__type\">Film</span>\n                    \n\n                    <h1 class=\"splash-header__fulltitle\" itemprop=\"name\">\n                        \n                            <span class=\"splash-header__surtitle\">Tate Collective Moments</span>\n                        \n                            <span class=\"\">My Father's Shadow screening + live score</span>\n                        \n                    </h1>\n\n                    \n                    \n\n                    \n\n                    \n\n                    \n\n                    <div class=\"splash-header__footer\">\n                        <div>\n                            \n                                \n                                    <span class=\"splash-header__dates\">8 February 2026 at 15.00–17.00</span>\n                                \n                            \n\n                            \n\n\n                        </div>\n\n                        \n                        \n                        <div class=\"btn-group splash-header__action-buttons\">\n                            <div class=\"btn-row\">\n                                \n                                \n                            </div>\n                        </div>\n                        \n\n                    </div>\n\n                </div>\n                <div class=\"splash-header__media\">\n                    <div class=\"splash-header__media--inner responsive-container\">\n                        \n                            \n\n\n    \n    <picture\n        >\n        <source srcset=\"\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/My_fathers_shadow_still_image.width-420.jpg 420w,\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/My_fathers_shadow_still_image.width-540.jpg 540w,\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/My_fathers_shadow_still_image.width-840.jpg 840w,\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/My_fathers_shadow_still_image.width-1200.jpg 1200w,\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/My_fathers_shadow_still_image.width-1440.jpg 1440w,\n            \"\n        sizes=\"\n            (max-width: 479px) 420px,\n            (max-width: 600px) 540px,\n            (max-width: 1023px) 840px,\n            (max-width: 1440px) 1200px,\n            1440px,\n            \"\n        >\n        <img\n            alt=\"\"\n            src=\"https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/My_fathers_shadow_still_image.width-420.jpg\"\n            loading=\"lazy\"\n            width=\"420\"\n            height=\"236\"\n            \n            \n        >\n    </picture>\n\n    \n\n    \n\n\n\n                        \n                    </div>\n                </div>\n            </div>\n            \n                <div class=\"splash-header__image-caption\">\n                    <p data-block-key=\"seiad\">Still from <i>My Father's Shadow</i></p>\n                </div>\n            \n        </div>\n    </div>\n</header>\n\n\n\n    <section class=\"content-main\">\n\n        <div class=\"container container--primary-content\">\n            <div class=\"container__inner\">\n                <div class=\"grid-outer\">\n                    <div class=\"grid-col--66\">\n                        \n                        <div class=\"content__standfirst\"><p data-block-key=\"hsg45\">A special live-scored screening of <i>My Father’s Shadow</i> exclusively for Tate Collective</p></div>\n\n                        \n\n\n                        <div class=\"content__body-text\" itemprop=\"mainContentOfPage\">\n\n                            \n                            \n                                    \n<div class=\"event-outer\n    container\">\n    <div class=\"event-inner\n        container__inner\">\n        <div class=\"block-rich_text\"><p data-block-key=\"ym1s8\">Join us for a unique screening of<i> My Father’s Shadow</i>, the directorial debut from filmmaker Akinola Davies Jr.. The film will be brought to life with live music and sound, performed by the creators of the original film score, CJ Mirra and Duval Timothy, joined by special guests.</p><p data-block-key=\"a8r9r\">The semi-autobiographical film tells a story about family, memory and the relationships that shape us. It is set over the course of a single day in Nigeria during the 1993 election crisis. It follows a father, Fola, estranged from his two young sons, Remi and Akin, as they travel through Lagos while political unrest threatens their journey home.</p><p data-block-key=\"5hsa0\">Set in Tate Modern’s South Tank, the score will be performed live alongside the film, creating a powerful shared experience between the audience, the performers and the screen.</p><p data-block-key=\"2sr1d\">£5 tickets will drop at 13.00 on 5 February. Exclusive to Tate Collective only, sign up for free <a href=\"https://www.tate.org.uk/tate-collective\">here</a>.</p></div>\n<div class=\"block-accordion\">\n<div class=\"accordion__container\" data-accordion>\n    <div class=\"accordion\">\n        \n            \n<div class=\"accordion__item\">\n    <h2 id=\"what-are-tate-collective-moments\" class=\"accordion__header\">\n        <button\n            id=\"h.what-are-tate-collective-moments-2qgQ9\"\n            class=\"accordion__button\"\n            data-accordion-question\n            aria-controls=\"c.what-are-tate-collective-moments-2qgQ9\"\n            aria-expanded=\"false\">\n            \n            <span class=\"accordion__title\">\n                What are Tate Collective Moments?\n            </span>\n        </button>\n    </h2>\n    <div\n        id=\"c.what-are-tate-collective-moments-2qgQ9\"\n        data-accordion-answer\n        class=\"accordion__content\"\n        aria-labelledby=\"h.what-are-tate-collective-moments-2qgQ9\">\n        <div class=\"block-rich_text\"><p data-block-key=\"krtzq\">Tate Collective Moments is a new programme of monthly events just for <a href=\"https://www.tate.org.uk/tate-collective\">Tate Collective</a>. Each month features a different event, from workshops and talks to performances and after-hours access, offering new ways to experience art at Tate.</p><p data-block-key=\"at32r\">Tate Collective is Tate’s free scheme for 16–25 year olds, offering £5 exhibition tickets, discounts, exclusive events and more. <a href=\"https://www.tate.org.uk/tate-collective\">Sign up for free today</a> and don’t miss out.</p></div>\n    </div>\n</div>\n\n        \n            \n<div class=\"accordion__item\">\n    <h2 id=\"accessibility\" class=\"accordion__header\">\n        <button\n            id=\"h.accessibility-DGA7y\"\n            class=\"accordion__button\"\n            data-accordion-question\n            aria-controls=\"c.accessibility-DGA7y\"\n            aria-expanded=\"false\">\n            \n            <span class=\"accordion__title\">\n                Accessibility\n            </span>\n        </button>\n    </h2>\n    <div\n        id=\"c.accessibility-DGA7y\"\n        data-accordion-answer\n        class=\"accordion__content\"\n        aria-labelledby=\"h.accessibility-DGA7y\">\n        <div class=\"block-rich_text\"><p data-block-key=\"xkwou\">The film duration is 94 minutes.</p><p data-block-key=\"anh9s\">The film will be accompanied by live music and sound, played by an ensemble in the centre of the space.</p><p data-block-key=\"228pf\">Ear defenders will be available for those who would like them.</p><p data-block-key=\"419gn\">Spaces will be reserved for wheelchair users and companions. Please let us know if you would like a space reserved for you.</p><p data-block-key=\"4mp7m\">You will be seated for the performance, either on chairs or cushions on the floor. Seats are hard, some of which have arms for additional support.</p><p data-block-key=\"apbo9\">The performance takes place in the South Tank, on Level 0 of the Blavatnik Building at Tate Modern.</p><p data-block-key=\"5sgsb\">Fully accessible toilets are located off of the Tanks foyer, adjacent to the South Tank.</p><p data-block-key=\"4jdm9\">All Tate Modern entrances are step-free. You can enter via the Turbine Hall and into the Natalie Bell Building on Holland Street, or into the Blavatnik Building on Sumner Street.</p><p data-block-key=\"ejmfp\">To help plan your visit to Tate Modern, have a look at our <a href=\"https://www.tate.org.uk/visit/tate-modern/visual-story\">visual story</a>. It includes photographs and information about what you can expect from a visit to the gallery.</p><p data-block-key=\"6vbv5\"><a href=\"https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/galleries/TM_map.pdf\">Download Tate Modern map PDF</a></p><p data-block-key=\"dfjqc\">For more information before your visit:</p><ul><li data-block-key=\"8i5g0\">Email <a href=\"mailto:hello@tate.org.uk\">hello@tate.org.uk</a></li><li data-block-key=\"2c736\">Call +44 (0)20 7887 8888 (daily 10.00–17.00)</li></ul><p data-block-key=\"d3vka\"><a href=\"https://www.tate.org.uk/visit/tate-modern#accessibility\">Check all Tate Modern accessibility information.</a></p></div>\n    </div>\n</div>\n\n        \n    </div>\n</div>\n</div>\n        \n    </div>\n</div>\n\n                            \n\n                        </div>\n\n                    </div>\n                    <div class=\"grid-col--33\">\n                        \n                        <div class=\"content-block content-block--location venue-block\">\n\n                            \n                                <h2 class=\"content-block__title\">Tate Modern</h2>\n                                <div class=\"location\">\n                                    \n                                    <p data-block-key=\"utcqo\">South Tank</p>\n                                    <span class=\"location__row\">Bankside</span><br /><span class=\"location__row\">London SE1 9TG</span><br />\n                                    \n    \t                            <a href=\"https://www.tate.org.uk/visit/tate-modern\" class=\"location__link text-link\">Plan your visit</a>\n                                    \n                                </div>\n                            \n                        </div>\n                        \n                        \n                        <div class=\"content-block content-block--dates\">\n\n                            <h2 class=\"content-block__title\">Date &amp; Time</h2>\n\n                                \n\n                                    \n                                        <p class=\"content-block--dates__item\">8 February 2026 at 15.00–17.00</p>\n                                    \n\n                                \n\n                            \n                        </div>\n                        \n\n                        \n\n                            <div class=\"content-block content-block--price\">\n                                \n                                    <h2 class=\"content-block__title\">Pricing</h2>\n                                \n                                \n\n                                    \n                                    <p><span class=\"price\">£5</span></p>\n                                    \n\n                                    <p data-block-key=\"kfmh7\">Exclusively for <a href=\"https://www.tate.org.uk/tate-collective\">Tate Collective</a>. 16–25? Sign up and <a href=\"https://shop.tate.org.uk/login\">log in</a> to book</p><p data-block-key=\"ed5g8\">Tickets will drop at 13.00 on 5 February</p>\n\n                                    \n\n                                \n                            </div>\n                        \n\n                        \n\n                        \n                    </div>\n                </div>\n            </div>\n        </div>\n\n\n        \n\n        <div class=\"block-heading\"><div class=\"event-outercontainer\">\n    <div class=\"event-innercontainer__inner\">\n        <h2 id=\"we-recommend\" class=\"section__title\">We recommend</h2>\n\n\n    </div>\n</div>\n</div>\n<div class=\"block-strip\">\n\n\n\n\n<div class=\"article-strip container \">\n    <div class=\"article-strip__content container__inner\">\n\n        \n 