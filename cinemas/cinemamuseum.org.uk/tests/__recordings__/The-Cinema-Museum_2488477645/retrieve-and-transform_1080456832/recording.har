= setInterval(function () {\n                        if (typeof window.addthis !== 'undefined') {\n                          window.clearInterval(first_load_interval_id);\n                          if (typeof window.addthis_layers !== 'undefined' && Object.getOwnPropertyNames(window.addthis_layers).length > 0) {\n                            window.addthis.layers(window.addthis_layers);\n                          }\n                          if (Array.isArray(window.addthis_layers_tools)) {\n                            for (i = 0; i < window.addthis_layers_tools.length; i++) {\n                              window.addthis.layers(window.addthis_layers_tools[i]);\n                            }\n                          }\n                        }\n                     },1000)\n                    }());\n                </script> <script data-cfasync=\"false\" type=\"text/javascript\" src=\"https://s7.addthis.com/js/300/addthis_widget.js#pubid=ra-4dbbcf4b502a51ae\" async=\"async\"></script></head>\n\n<body class=\"custom\">\n\n<div id=\"container\">\n\t\n\t<div id=\"header_img\">\n\t\t<a href=http://www.cinemamuseum.org.uk><img src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/images/cm_header.jpg\" width=\"770\" alt=\"The Cinema Museum, London\" title=\"The Cinema Museum, London\" /></a>\n\t</div>\n\t<div id=\"main_nav\">\n\t\t<!-- WP Menubar 5.9.3: start menu main_nav, template Suckerfish_41, CSS sf-blue.css -->\n\r\n<script type=\"text/javascript\">\r\n// <![CDATA[\r\n\twpm1_Hover = function() {\r\n\tvar wpmEls = document.getElementById(\"wpm1\").getElementsByTagName(\"li\");\r\n\tfor (var i=0; i<wpmEls.length; i++) {\r\n\t\twpmEls[i].onmouseover = function() {\r\n\t\t\tthis.className += \" wpmhover\";\r\n\t\t}\r\n\t\twpmEls[i].onmouseout = function() {\r\n\t\t\tthis.className = this.className.replace(new RegExp(\" wpmhover\\\\b\"), \"\");\r\n\t\t}\r\n\t}\r\n}\r\nif (window.attachEvent) window.attachEvent(\"onload\", wpm1_Hover);\r\n// ]]>\r\n</script>\r\n\r\n<div class=\"sf-blue-before\"></div>\r\n<div id=\"wpm1\" class=\"sf-blue\">\r\n<ul><li><a href=\"http://www.cinemamuseum.org.uk\" >Home</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/news/\" >News</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/campaign/\" >CAMPAIGN</a></li><li class=\"selected\"><a href=\"http://www.cinemamuseum.org.uk/topics/events/\" >Events</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">The Collection</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/overview/\" >Overview</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/equipment/\" >Equipment</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/publications/\" >Publications</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/cinemas/\" >Cinemas</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/uniforms/\" >Uniforms</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/films/\" >Films</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/advertising/\" >Advertising</a></li></ul></li><li><a href=\"http://www.cinemamuseum.org.uk/shop/\" >Shop</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">About</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/history/\" >History</a></li><li><a href=\"http://www.cinemamuseum.org.uk/visit/\" >Visit Us</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/links/\" >Links</a></li></ul></li></ul>\r\n</div>\r\n<div class=\"sf-blue-after\"></div>\r\n<!-- WP Menubar 5.9.3: end menu main_nav, template Suckerfish_41, CSS sf-blue.css -->\n                <style type=\"text/css\">\n                    @media screen and (-ms-high-contrast: active), (-ms-high-contrast: none) {\n                        /* Like IE9, which support conditional comments, IE10 needs less padding than the IE8 default */\n                        .sf-blue a, .sf-blue a:hover, .sf-blue a:visited { padding: 0 10.8px; }\n                    }\n                </style>\n\t\t<!--[if IE 9]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie9.css\" media=\"screen\" />\n\t\t<![endif]-->\n\t\t<!--[if IE 7]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie7.css\" media=\"screen\" />\n\t\t<![endif]-->\n\n\t</div>\r\n\t<div id=\"content_box\">\r\n\t\t\r\n\t\t<div id=\"content\" class=\"posts\">\r\n\t\t\t\r\n\t\t\t\t\t\r\n<!--\r\n\t\t\t\r\n<div class=\"navigation\">\r\n\t<span class=\"previous\">&larr; <a href=\"http://www.cinemamuseum.org.uk/2024/kennington-bethlehem-link-benefit-screening-of-feature-documentary-tomorrows-freedom-2022-qa/\" rel=\"prev\">Kennington Bethlehem Link benefit screening of feature documentary <em>Tomorrow’s Freedom</em> (2022) + Q&#038;A</a></span>\r\n\t<span class=\"next\"><a href=\"http://www.cinemamuseum.org.uk/2024/screening-of-being-in-a-place-a-portrait-of-margaret-tait-2023-on-35mm-film-qa-with-director-luke-fowler/\" rel=\"next\">Screening of <em>Being in a Place: A Portrait of Margaret Tait</em> (2023) + Q&#038;A with Peter Todd and Sarah Neely</a> &rarr;</span>\r\n</div>\r\n<div class=\"clear whitespace\"></div>\r\n\r\n-->\r\n\t\t\t\r\n\t\t\t<div id=\"post-34200\" class=\"post-34200 post type-post status-publish format-standard has-post-thumbnail hentry category-events tag-contact tag-ticketlab\">\r\n\t\t\t\t<div class=\"entry_header\">\r\n<!--\r\n\t\t\t\t\tRC: Comment and Edit functionality removed from following post header. Date reduced to Month and Year. Conditional 'Featured Article' added\r\n-->\r\n\t\t\t\t\t<h2>Screening of <em>Remembrance</em> (1982) plus Q&#038;A with Hugh Stoddart</h2>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<h4>Fri 21 Mar 2025 @ 19:30 \t\t\t\t\t\t\t\t\t\t\t<!-- by David --> &middot; \r\n\t\t\t\t\t<!-- <a href=\"http://www.cinemamuseum.org.uk/2024/screening-of-remembrance-1982-plus-qa-with-hugh-stoddart/#comments\">No Comments</a> &middot; -->\r\n\t\t\t\t\t<a href=\"http://www.cinemamuseum.org.uk/topics/events/\" rel=\"category tag\">Events</a>\t\t\t\t\t<!--  -->\r\n\t\t\t\t\t\t\t\t\t\t</h4>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"entry\">\r\n<!--\r\n\t\t\t\t\tRC: I'm not clear when the_content pagination would be triggered.\r\n\t\t\t\t\tIf triggered, consider changing to plug-in based pagination.\r\n-->\r\n\t\t\t\t\t<div class=\"at-above-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2024/screening-of-remembrance-1982-plus-qa-with-hugh-stoddart/\"></div><p><a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-1.png\" target=\"_blank\" rel=\"noopener\" title=\"Remembrance - click to enlarge\"><img fetchpriority=\"high\" decoding=\"async\" class=\"alignleft wp-image-34205 size-large\" title=\"Remembrance - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-1-488x274.png\" alt=\"Remembrance\" width=\"488\" height=\"274\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-1-488x274.png 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-1-300x169.png 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-1-768x432.png 768w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-1-150x84.png 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-1-90x51.png 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-1.png 859w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a>A rare opportunity to see this re-discovered British film from 1982 on the big screen, which was Gary Oldman’s first film, and also starred Tim Spall and John Altman.<span id=\"more-34200\"></span></p>\n<p><em>Remembrance</em> was released in 1982. It won the Grand Prize at the Taormina Film Festival and was screened in the first month of Channel 4’s existence.</p>\n<p>A group of young Royal Navy sailors spend their last night ashore before leaving on a six-month tour of duty. Set around the pubs and clubs of the notorious Union Street in Plymouth, the film cuts between interweaving stories of several characters: some are happy to go, others sad to be parting from families friends and lovers. And for one, there is a score to settle. Central among these stories is a mystery: who is the young man who we meet at the start of the film, so drunk, so adrift – and at risk?</p>\n<p>&#8220;It’s what British cinema does best: no frills, no pomp or pretension, just vivid characters, real emotion and real grit. The whole cast is remarkable (including Timothy Spall and John Altman, later Nick Cotton on TV’s <em>EastEnders</em>), but it’s Gary Oldman who steals the show. He’s so alive, so uninhibited, and brilliant. He is reminiscent of De Niro in <em>Mean Streets</em> (1973), with which this film has curious parallels.” Paul Rowlands, Facebook comment. Website: <a href=\"http://www.money-into-light.com\" target=\"_blank\" rel=\"noopener\">http://www.money-into-light.com</a></p>\n<p><a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-2.jpg\" target=\"_blank\" rel=\"noopener\" title=\"Remembrance - click to enlarge\"><img decoding=\"async\" class=\"alignleft wp-image-34204 size-large\" title=\"Remembrance - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-2-488x275.jpg\" alt=\"Remembrance\" width=\"488\" height=\"275\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-2-488x274.jpg 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-2-300x169.jpg 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-2-768x432.jpg 768w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-2-150x84.jpg 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-2-90x51.jpg 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-2.jpg 1279w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a><em>Remembrance</em> was the third in the sequence of six films made between 1978 and 1988 by director Colin Gregg and screenwriter Hugh Stoddart, and perhaps it was the speed with which they were being funded to make films at the time that might explain why <em>Remembrance</em> was allowed to disappear. The Falklands War, happening between the shoot and the film’s release, rightly attracted huge attention and may have pushed aside a fictional film set in peacetime.</p>\n<p>It was shot entirely on location in Plymouth, much of it at night, using Super-16mm stock. It has now been meticulously restored by the British Film Institute and re-issued in their Flipside series.</p>\n<p>Doors open at 18.30, for a 19.30 start.</p>\n<p>Refreshments will be available in our licensed cafe/bar.</p>\n<h3>TICKETS &amp; PRICING</h3>\n<p>Tickets £10.</p>\n<p>Advance tickets may be purchased from <a href=\"https://ticketlab.co.uk/event/id/27566\" target=\"_blank\" rel=\"noopener noreferrer\">Ticketlab</a>, or direct from the Museum by calling 020 7840 2200 in office hours.<br />\n<a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-3.jpg\" target=\"_blank\" rel=\"noopener\" title=\"Remembrance - click to enlarge\"><img loading=\"lazy\" decoding=\"async\" class=\"alignleft wp-image-34203 size-large\" title=\"Remembrance - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-3-488x274.jpg\" alt=\"Remembrance\" width=\"488\" height=\"274\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-3-488x274.jpg 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-3-300x169.jpg 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-3-768x431.jpg 768w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-3-150x84.jpg 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-3-90x51.jpg 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/08/Remembrance-1982-3.jpg 1100w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a></p>\n<!-- PHP 5.x --><!-- AddThis Advanced Settings above via filter on the_content --><!-- AddThis Advanced Settings below via filter on the_content --><!-- AddThis Advanced Settings generic via filter on the_content --><!-- AddThis Share Buttons above via filter on the_content --><!-- AddThis Share Buttons below via filter on the_content --><div class=\"at-below-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2024/screening-of-remembrance-1982-plus-qa-with-hugh-stoddart/\"></div><!-- AddThis Share Buttons generic via filter on the_content -->\t\t\t\t\t\t\t\t\t\t<script type='text/javascript'>\r\n\t\t\t\t\t//<![CDATA[\r\n\t\t\t\t\tdocument.write(\"<h4 class='backLink'>[<a href='javascript:history.back()' class='backLink' title='Go back'>&larr; Go back<\\/a>]<\\/h4>\");\r\n\t\t\t\t\t//]]>\r\n\t\t\t\t\t</script>\t\t\t\t\t<noscript><h4 class='backLink'>[<a href=\"\" class='backLink' title='Go back'>&larr; Go back</a>]</h4></noscript>\r\n\t\t\t\t</div>\r\n<!--\r\n\t\t\t\t<p class=\"tagged\"><strong>Tags:</strong> <a href=\"http://www.cinemamuseum.org.uk/tag/contact/\" rel=\"tag\">Contact</a>&middot;<a href=\"http://www.cinemamuseum.org.uk/tag/ticketlab/\" rel=\"tag\">TicketLab</a></p>\t\t\t\tRC: Remove tag functionality and