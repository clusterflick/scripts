eSheets-css' href='http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/eshop_files/eshop.css' type='text/css' media='all' />\n<link rel='stylesheet' id='lightboxStyle-css' href='http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/lightbox-plus/css/shadowed/colorbox.css?ver=2.0.2' type='text/css' media='screen' />\n<link rel='stylesheet' id='wp-paginate-css' href='http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/wp-paginate/css/wp-paginate.css?ver=2.2.4' type='text/css' media='screen' />\n<script type=\"text/javascript\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-includes/js/jquery/jquery.min.js?ver=3.7.1\" id=\"jquery-core-js\"></script>\n<script type=\"text/javascript\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-includes/js/jquery/jquery-migrate.min.js?ver=3.4.1\" id=\"jquery-migrate-js\"></script>\n<meta name=\"generator\" content=\"WordPress 6.4.5\" />\n<link rel=\"canonical\" href=\"http://www.cinemamuseum.org.uk/2024/the-spring-season-2025-dates-for-your-diary/\" />\n<link rel='shortlink' href='http://www.cinemamuseum.org.uk/?p=34779' />\n<link rel=\"alternate\" type=\"application/json+oembed\" href=\"http://www.cinemamuseum.org.uk/wp-json/oembed/1.0/embed?url=http%3A%2F%2Fwww.cinemamuseum.org.uk%2F2024%2Fthe-spring-season-2025-dates-for-your-diary%2F\" />\n<link rel=\"alternate\" type=\"text/xml+oembed\" href=\"http://www.cinemamuseum.org.uk/wp-json/oembed/1.0/embed?url=http%3A%2F%2Fwww.cinemamuseum.org.uk%2F2024%2Fthe-spring-season-2025-dates-for-your-diary%2F&#038;format=xml\" />\n<!--[if lt IE 8]>\n<style type=\"text/css\">\n.eshoppanels li{\n    display:inline;\n    margin:10px 5px 0 5px;\n}\n</style>\n<![endif]-->\n\n<!-- WP Menubar 5.9.3: start CSS -->\n<link rel=\"stylesheet\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/Suckerfish_41/sf-blue.css\" type=\"text/css\" media=\"screen\" />\n<!-- WP Menubar 5.9.3: end CSS -->\n\t<!--Simple Popup Plugin v4.0 / RH Mods-->\n\t<script language=\"javascript\" type=\"text/javascript\">\n\t<!--\n\tvar swin=null;\n\tfunction popitup(mypage,w,h,pos,myname,infocus){\n\t    if (w!=parseInt(w)||w<=0) w=$width;\n\t    if (h!=parseInt(h)||h<=0) h=$height;\n\t    if (myname==null){myname=\"swin\"};\n\t    var myleft = 0;\n\t    var mytop = 0;\n\t    if (myleft==0 && mytop==0 && pos!=\"random\"){pos=\"center\"};\n\t    if (pos==\"random\"){myleft=(screen.width)?Math.floor(Math.random()*(screen.width-w)):100;mytop=(screen.height)?Math.floor(Math.random()*((screen.height-h)-75)):100;}\n\t    if (pos==\"center\"){myleft=(screen.width)?(screen.width-w)/2:100;mytop=(screen.height)?(screen.height-h)/2:100;}\n\t    settings=\"width=\" + w + \",height=\" + h + \",top=\" + mytop + \",left=\" + myleft + \",scrollbars=yes,location=no,directories=no,status=no,menubar=no,toolbar=no,resizable=no\";swin=window.open(mypage,myname,settings);\n\t    if (infocus==null || infocus==\"front\"){swin.focus()};\n\t    return false;\n\t}\n\t// -->\n\t</script>\n\t<!--/Simple Popup Plugin-->\n\t<!-- mf-taxonomy-list -->\n <style type=\"text/css\"> html>body .entry ul.mf_taxonomy_column { /* Reset for the Default Theme. */ margin: 0px; padding: 0px; list-style-type: none; padding-left: 0px; text-indent: 0px; } ul.mf_taxonomy_column, .entry ul.mf_taxonomy_column { float: left; margin: 0; padding: 0 0 1em; list-style-type: none; list-style-position: outside; } .mf_cols_1{ width:99%; } .mf_cols_2{ width:49.5%; } .mf_cols_3{ width:33%; } .mf_cols_4{ width:24.75%; } .mf_cols_5{ width:19.77%; } .entry ul.mf_taxonomy_column li:before { content: \"\"; } .mf_taxonomy_column li, .entry ul.mf_taxonomy_column li { list-style: none, outside; position: relative; height: 1.5em; z-index: 0; background: #fff; margin: 0 1em .4em 0; } .mf_taxonomy_column li.has-quantity, .entry ul.mf_taxonomy_column li.has-quantity { border-bottom: 1px dotted #888; } .mf_taxonomy_column a.edit-term { height: 16px; width: 16px; display: block; } .logged-in .mf_taxonomy_column a.term-name { left: 16px; padding-left: 4px; } .mf_taxonomy_column a.edit-term, .mf_taxonomy_column a.term-name, .mf_taxonomy_column .quantity { position:absolute; bottom: -0.2em; line-height: 1em; background: #fff; z-index:10; } .mf_taxonomy_column a.term-name { display: block; left:0; padding-right: 0.3em; text-decoration: none; } .mf_taxonomy_column .quantity { display: block; right:0; padding-left: 0.3em; } .mf_taxonomy_list .clear { clear:both; } </style><script data-cfasync=\"false\" type=\"text/javascript\">if (window.addthis_product === undefined) { window.addthis_product = \"wpp\"; } if (window.wp_product_version === undefined) { window.wp_product_version = \"wpp-6.2.7\"; } if (window.addthis_share === undefined) { window.addthis_share = {}; } if (window.addthis_config === undefined) { window.addthis_config = {\"data_track_clickback\":true,\"ignore_server_config\":true,\"ui_atversion\":300}; } if (window.addthis_layers === undefined) { window.addthis_layers = {}; } if (window.addthis_layers_tools === undefined) { window.addthis_layers_tools = []; } else {  } if (window.addthis_plugin_info === undefined) { window.addthis_plugin_info = {\"info_status\":\"enabled\",\"cms_name\":\"WordPress\",\"plugin_name\":\"Share Buttons by AddThis\",\"plugin_version\":\"6.2.7\",\"plugin_mode\":\"WordPress\",\"anonymous_profile_id\":\"wp-747be56a313680a55be1b14da545a27c\",\"page_info\":{\"template\":\"posts\",\"post_type\":\"\"},\"sharing_enabled_on_post_via_metabox\":false}; } \n                    (function() {\n                      var first_load_interval_id = setInterval(function () {\n                        if (typeof window.addthis !== 'undefined') {\n                          window.clearInterval(first_load_interval_id);\n                          if (typeof window.addthis_layers !== 'undefined' && Object.getOwnPropertyNames(window.addthis_layers).length > 0) {\n                            window.addthis.layers(window.addthis_layers);\n                          }\n                          if (Array.isArray(window.addthis_layers_tools)) {\n                            for (i = 0; i < window.addthis_layers_tools.length; i++) {\n                              window.addthis.layers(window.addthis_layers_tools[i]);\n                            }\n                          }\n                        }\n                     },1000)\n                    }());\n                </script> <script data-cfasync=\"false\" type=\"text/javascript\" src=\"https://s7.addthis.com/js/300/addthis_widget.js#pubid=ra-4dbbcf4b502a51ae\" async=\"async\"></script></head>\n\n<body class=\"custom\">\n\n<div id=\"container\">\n\t\n\t<div id=\"header_img\">\n\t\t<a href=http://www.cinemamuseum.org.uk><img src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/images/cm_header.jpg\" width=\"770\" alt=\"The Cinema Museum, London\" title=\"The Cinema Museum, London\" /></a>\n\t</div>\n\t<div id=\"main_nav\">\n\t\t<!-- WP Menubar 5.9.3: start menu main_nav, template Suckerfish_41, CSS sf-blue.css -->\n\r\n<script type=\"text/javascript\">\r\n// <![CDATA[\r\n\twpm1_Hover = function() {\r\n\tvar wpmEls = document.getElementById(\"wpm1\").getElementsByTagName(\"li\");\r\n\tfor (var i=0; i<wpmEls.length; i++) {\r\n\t\twpmEls[i].onmouseover = function() {\r\n\t\t\tthis.className += \" wpmhover\";\r\n\t\t}\r\n\t\twpmEls[i].onmouseout = function() {\r\n\t\t\tthis.className = this.className.replace(new RegExp(\" wpmhover\\\\b\"), \"\");\r\n\t\t}\r\n\t}\r\n}\r\nif (window.attachEvent) window.attachEvent(\"onload\", wpm1_Hover);\r\n// ]]>\r\n</script>\r\n\r\n<div class=\"sf-blue-before\"></div>\r\n<div id=\"wpm1\" class=\"sf-blue\">\r\n<ul><li><a href=\"http://www.cinemamuseum.org.uk\" >Home</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/news/\" >News</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/campaign/\" >CAMPAIGN</a></li><li class=\"selected\"><a href=\"http://www.cinemamuseum.org.uk/topics/events/\" >Events</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">The Collection</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/overview/\" >Overview</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/equipment/\" >Equipment</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/publications/\" >Publications</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/cinemas/\" >Cinemas</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/uniforms/\" >Uniforms</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/films/\" >Films</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/advertising/\" >Advertising</a></li></ul></li><li><a href=\"http://www.cinemamuseum.org.uk/shop/\" >Shop</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">About</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/history/\" >History</a></li><li><a href=\"http://www.cinemamuseum.org.uk/visit/\" >Visit Us</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/links/\" >Links</a></li></ul></li></ul>\r\n</div>\r\n<div class=\"sf-blue-after\"></div>\r\n<!-- WP Menubar 5.9.3: end menu main_nav, template Suckerfish_41, CSS sf-blue.css -->\n                <style type=\"text/css\">\n                    @media screen and (-ms-high-contrast: active), (-ms-high-contrast: none) {\n                        /* Like IE9, which support conditional comments, IE10 needs less padding than the IE8 default */\n                        .sf-blue a, .sf-blue a:hover, .sf-blue a:visited { padding: 0 10.8px; }\n                    }\n                </style>\n\t\t<!--[if IE 9]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie9.css\" media=\"screen\" />\n\t\t<![endif]-->\n\t\t<!--[if IE 7]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie7.css\" media=\"screen\" />\n\t\t<![endif]-->\n\n\t</div>\r\n\t<div id=\"content_box\">\r\n\t\t\r\n\t\t<div id=\"content\" class=\"posts\">\r\n\t\t\t\r\n\t\t\t\t\t\r\n<!--\r\n\t\t\t\r\n<div class=\"navigation\">\r\n\t<span class=\"previous\">&larr; <a href=\"http://www.cinemamuseum.org.uk/2024/kennington-noir-presents-act-of-violence-1948/\" rel=\"prev\">Kennington Noir presents <em>Act of Violence</em> (1948)</a></span>\r\n\t<span class=\"next\"><a href=\"http://www.cinemamuseum.org.uk/2024/screening-of-rave-on-for-the-avon-2024-plus-qa-with-director-charlotte-sawyer/\" rel=\"next\">Screening of <em>Rave On For The Avon</em> (2024) plus Q&#038;A with director Charlotte Sawyer</a> &rarr;</span>\r\n</div>\r\n<div class=\"clear whitespace\"></div>\r\n\r\n-->\r\n\t\t\t\r\n\t\t\t<div id=\"post-34779\" class=\"post-34779 post type-post status-publish format-standard hentry category-events tag-contact tag-ticketlab\">\r\n\t\t\t\t<div class=\"entry_header\">\r\n<!--\r\n\t\t\t\t\tRC: Comment and Edit functionality removed from following post header. Date reduced to Month and Year. Conditional 'Featured Article' added\r\n-->\r\n\t\t\t\t\t<h2>The Spring Season 2025: dates for your diary</h2>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<h4>Sat 21 Dec  - Mon 30 Jun 2025 \t\t\t\t\t\t\t\t\t\t\t<!-- by David --> &middot; \r\n\t\t\t\t\t<!-- <a href=\"http://www.cinemamuseum.org.uk/2024/the-spring-season-2025-dates-for-your-diary/#comments\">No Comments</a> &middot; -->\r\n\t\t\t\t\t<a href=\"http://www.cinemamuseum.org.uk/topics/events/\" rel=\"category tag\">Events</a>\t\t\t\t\t<!--  -->\r\n\t\t\t\t\t\t\t\t\t\t</h4>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"entry\">\r\n<!--\r\n\t\t\t\t\tRC: I'm not clear when the_content pagination would be triggered.\r\n\t\t\t\t\tIf triggered, consider changing to plug-in based pagination.\r\n-->\r\n\t\t\t\t\t<div class=\"at-above-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2024/the-spring-season-2025-dates-for-your-diary/\"></div><p>Plans do sometimes change so if the event you are planning to attend is further away than 28 days, please check back for future updates.</p>\n<p><a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Dr-Strangelove-3.jpg\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Dr Strangelove - click to enlarge\"><img fetchpriority=\"high\" decoding=\"async\" class=\"alignleft wp-image-34782 size-large\" title=\"Dr Strangelove - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Dr-Strangelove-3-488x275.jpg\" alt=\"Dr Strangelove\" width=\"488\" height=\"275\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Dr-Strangelove-3-488x274.jpg 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Dr-Strangelove-3-300x169.jpg 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Dr-Strangelove-3-768x432.jpg 768w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Dr-Strangelove-3-1536x864.jpg 1536w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Dr-Strangelove-3-150x84.jpg 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Dr-Strangelove-3-90x51.jpg 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Dr-Strangelove-3.jpg 1920w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a></p>\n<p>More details of each event can be found on the individual event pages that are posted under <a href=\"http://www.cinemamuseum.org.uk/topics/events/?event_type=current\">Upcoming Events</a>.</p>\n<h3>TICKETS &amp; PRICING</h3>\n<p>(unless otherwise stated)</p>\n<p>Tickets are available in advance:</p>\n<ul>\n<li>either by booking online (please note a small fee will be added by Billetto or Ticketlab)</li>\n<li>or directly from ourselves by calling us during office hours on 020 7840 2200. Card payments can be accepted – we welcome MasterCard, Maestro, Visa, Visa Electron, Discover, Diners Club International and JCB</li>\n</ul>\n<p>or on the door.</p>\n<h3>February 2025</h3>\n<ul>\n<li><strong>2</strong> Screening of <em>Rave On For The Avon</em> (2024) plus Q&amp;A with director Charlotte Sawyer</li>\n<li><strong>7</strong> Women and Cocaine presents <em>Love Me Tonight</em> (1932)</li>\n<li><strong>8</strong> Exploding Cinema 19.00</li>\n<li><strong>9</strong> The Nickel presents <em>Eraserhead</em> (1977) on 16mm <span style=\"color: red;\">&#8211; SOLD OUT</span></li>\n<li><strong>12</strong> Kennington Noir presents <em>Laura</em> (1944) on 16mm</li>\n<li><strong>13</strong> The Nickel presents <em>Wild at Heart</em> (1990) on 35mm <span style=\"color: red;\">&#8211; SOLD OUT</span></li>\n<li><strong>15</strong> The Nickel presents <em>Eraserhead</em> (1977) on 16mm <span style=\"color: red;\">&#8211; SOLD OUT</span></li>\n<li><strong>19</strong> Kennington Bioscope presents <em>A Pair of Silk Stockings</em> (1918)</li>\n<li><strong>21</strong> The Gothique Film Society presents <em>The Ghost Ship</em> (1943) and <em>Death Line</em> (1972) 19.00</li>\n<li><strong>22</strong> Misty Moon presents The <em>Minder</em> Reunion 2 17.00</li>\n<li><strong>27</strong> The Nickel presents <em>Wild at Heart</em> (1990) on 35mm <span style=\"color: red;\">&#8211; SOLD OUT</span></li>\n</ul>\n<h3>March 2025</h3>\n<ul>\n<li><strong>1 &amp; 2</strong> 1st European Circus History Conference London 10.00-17.00</li>\n<li><strong>5</strong> The Nickel presents <em>Eraserhead</em> (1977) on 16mm <span style=\"color: red;\">&#8211; SOLD OUT</span></li>\n<li><strong>6</strong> The Nickel presents <em>Eraserhead</em> (1977) on 16mm <span style=\"color: red;\">&#8211; SOLD OUT</span></li>\n<li><strong>7</strong> Women and Cocaine presents <em>The Miracle Woman</em> (1931)</li>\n<li><strong>8</strong> The Live Ghost Tent – Quarterly meeting of The Laurel and Hardy Society 15.00</li>\n<li><strong>8</strong> Celebrating Peter Sellers: <em>I&#8217;m All Right Jack</em> (1959)</li>\n<li><strong>9</strong> The Nickel presents <em>Eraserhead</em> (1977) on 16mm</li>\n<li><strong>12</strong> Kennington Noir presents <em>Cry of the City</em> (1948) on 16mm</li>\n<li><strong>14</strong> The Gothique Film Society presents <em>Freaks</em> (1932) and <em>The Mask Of Fu Manchu</em> (1932) 19.00</li>\n<li><strong>15</strong> Some new kind of kick presents <em>Leningrad Cowboys Go America</em> (1989)</li>\n<li><strong>19</strong> Kennington Bioscope presents a programme of &#8216;antiquities&#8217;</li>\n<li><strong>21</strong> Screening of <em>Remembrance</em> (1982) plus Q&amp;A with Hugh Stoddart</li>\n<li><strong>22</strong> The Legend of Houdini, presented by Greg Chapman</li>\n<li><strong>26</strong> Screening of <em>Satu &#8211; Year of the Rabbit</em> (2024) with intro and Q&#038;A</li>\n<li><strong>27</strong> Screening of <em>Satu &#8211; Year of the Rabbit</em> (2024) with intro and Q&#038;A</li>\n<li><strong>29</strong> The Nickel presents <em>The Conversation</em> (1974) on 16mm</li>\n</ul>\n<h3>April 2025</h3>\n<ul>\n<li><strong>2</strong> The Nickel presents <em>The French Connection</em> (1971) on 16mm</li>\n<li><strong>5 &amp; 6</strong> 8th Kennington Bioscope Silent Film Weekend</li>\n<li><strong>10</strong> Screening of <em>Vindication Swim</em> (2024) plus Q&amp;A with director Elliott Hasler</li>\n<li><strong>12</strong> Celebrating Peter Sellers: <em>Never Let Go</em> (1960)</li>\n<li><strong>13</strong> Fundraiser screening of <em>Kensuke’s Kingdom</em> (2024) plus Q&amp;A with directors Kirk Hendry and Neil Boyle 14.00</li>\n<li><strong>16</strong> Kennington Noir presents <em>Act of Violence</em> (1948)</li>\n<li><strong>19</strong> Some new kind of kick presents <em>Code Two</em> (1953)</li>\n<li><strong>23</strong> Kennington Bioscope presents TBA</li>\n<li><strong>24</strong> Women and Cocaine presents <em>As You Desire Me</em> (1932)</li>\n<li><strong>26</strong> The Blinking Buzzards 16.00-19.00</li>\n</ul>\n<h3>May 2025</h3>\n<ul>\n<li><strong>3</strong> Robert Ross and Gemma Ross present A Write On Comedy event: Carry On Up The Cinema Museum VII 12.00</li>\n<li><strong>10</strong> Celebrating Peter Sellers: <em>Heavens Above!</em> (1963)</li>\n<li><strong>14</strong> Kennington Noir presents <em>Gun Crazy</em> (1950)</li>\n<li><strong>17</strong> Some new kind of kick presents <em>Rumble: The Indians Who Rocked the World</em> (2017)</li>\n<li><strong>21</strong> Kennington Bioscope presents TBA</li>\n<li><strong>23</strong> Women and Cocaine presents <em>Shanghai Express</em> (1932)</li>\n<li><strong>31</strong> Misty Moon Presents George Layton Tells Fibs and Stories 19.00</li>\n</ul>\n<h3>June 2025</h3>\n<ul>\n<li><strong>1</strong> The Live Ghost Tent – Quarterly meeting of The Laurel and Hardy Society 15.00</li>\n<li><strong>7</strong> Celebrating Peter Sellers: <em>Dr. Strangelove or: How I Learned to Stop Worrying and Love the Bomb</em> (1964)</li>\n<li><strong>14</strong> Some new kind of kick presents <em>Danger: Diabolik</em> (1968)</li>\n<li><strong>18</strong> Kennington Bioscope presents TBA</li>\n<li><strong>20</strong> Women and Cocaine presents <em>Dancing Lady</em> (1933)</li>\n<li><strong>28</strong> Misty Moon Presents <em>The Bill</em> Reunion 13 17.00</li>\n</ul>\n<h3>July 2025</h3>\n<ul>\n<li><strong>2</strong> Kennington Bioscope presents TBA</li>\n<li><strong>12</strong> Celebrating Peter Sellers: <em>A Shot in the Dark</em> (1964)</li>\n<li><strong>19</strong> Some new kind of kick presents <em>Engaged to Death</em> (1957)</li>\n<li><strong>26</strong> The Blinking Buzzards 16.00-19.00</li>\n</ul>\n<h3>September 2025</h3>\n<ul>\n<li><strong>6</strong> The Live Ghost Tent – Quarterly meeting of The Laurel and Hardy Society 15.00</li>\n<li><strong>13</strong> Celebrating Peter Sellers: <em>Being There</em> (1979)</li>\n<li><strong>20</strong> Some new kind of kick presents <em>The Cramps and The Mutants: The Napa State Tapes</em> (1978)</li>\n<li><strong>25</strong> Women and Cocaine presents <em>The Divorcee</em> (1930)</li>\n</ul>\n<h3>October 2025</h3>\n<ul>\n<li><strong>18</strong> Misty Moon Presents <em>The Bill</em> Reunion 14 17.00</li>\n<li><strong>19</strong> The Blinking Buzzards 16.00-19.00</li>\n<li><strong>23</strong> Women and Cocaine presents <em>Platinum Blonde</em> (1931)</li>\n<li><strong>25</strong> Home Movie Day 2025 10.30</li>\n<li><strong>25</strong> Some new kind of kick presents <em>The Return of the Living Dead</em> (1985)</li>\n</ul>\n<h3>November 2025</h3>\n<ul>\n<li><strong>10</strong> Richard Burton at 100 – A Celebration 19.00</li>\n<li><strong>15</strong> Some new kind of kick presents <em>Mystery Train</em> (1989)</li>\n<li><strong>27</strong> Women and Cocaine presents <em>Safe in Hell</em> (1931)</li>\n<li><strong>29</strong> Robert Ross and Gemma Ross present Carry On Up The Cinema Museum VIII 12.00</li>\n</ul>\n<h3>December 2025</h3>\n<ul>\n<li><strong>6</strong> The Live Ghost Tent – Quarterly meeting of The Laurel and Hardy Society 15.00</li>\n<li><strong>11</strong> Women and Cocaine presents <em>42nd Street</em> (1933)</li>\n<li><strong>20</strong> Some new kind of kick presents <em>The Final Programme</em> (1973)</li>\n</ul>\n<!-- PHP 5.x --><!-- AddThis Advanced Settings above via filter on the_content --><!-- AddThis Advanced Settings below via filter on the_content --><!-- AddThis Advanced Settings generic via filter on the_content --><!-- AddThis Share Buttons above via filter on the_content --><!-- AddThis Share Buttons below via filter on the_content --><div class=\"at-below-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2024/the-spring-season-2025-dates-for-your-diary/\"></div><!-- AddThis Share Buttons generic via filter on the_content -->\t\t\t\t\t\t\t\t\t\t<script type='text/javascript'>\r\n\t\t\t\t\t//<![CDATA[\r