            for (i = 0; i < window.addthis_layers_tools.length; i++) {\n                              window.addthis.layers(window.addthis_layers_tools[i]);\n                            }\n                          }\n                        }\n                     },1000)\n                    }());\n                </script> <script data-cfasync=\"false\" type=\"text/javascript\" src=\"https://s7.addthis.com/js/300/addthis_widget.js#pubid=ra-4dbbcf4b502a51ae\" async=\"async\"></script></head>\n\n<body class=\"custom\">\n\n<div id=\"container\">\n\t\n\t<div id=\"header_img\">\n\t\t<a href=http://www.cinemamuseum.org.uk><img src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/images/cm_header.jpg\" width=\"770\" alt=\"The Cinema Museum, London\" title=\"The Cinema Museum, London\" /></a>\n\t</div>\n\t<div id=\"main_nav\">\n\t\t<!-- WP Menubar 5.9.3: start menu main_nav, template Suckerfish_41, CSS sf-blue.css -->\n\r\n<script type=\"text/javascript\">\r\n// <![CDATA[\r\n\twpm1_Hover = function() {\r\n\tvar wpmEls = document.getElementById(\"wpm1\").getElementsByTagName(\"li\");\r\n\tfor (var i=0; i<wpmEls.length; i++) {\r\n\t\twpmEls[i].onmouseover = function() {\r\n\t\t\tthis.className += \" wpmhover\";\r\n\t\t}\r\n\t\twpmEls[i].onmouseout = function() {\r\n\t\t\tthis.className = this.className.replace(new RegExp(\" wpmhover\\\\b\"), \"\");\r\n\t\t}\r\n\t}\r\n}\r\nif (window.attachEvent) window.attachEvent(\"onload\", wpm1_Hover);\r\n// ]]>\r\n</script>\r\n\r\n<div class=\"sf-blue-before\"></div>\r\n<div id=\"wpm1\" class=\"sf-blue\">\r\n<ul><li><a href=\"http://www.cinemamuseum.org.uk\" >Home</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/news/\" >News</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/campaign/\" >CAMPAIGN</a></li><li class=\"selected\"><a href=\"http://www.cinemamuseum.org.uk/topics/events/\" >Events</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">The Collection</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/overview/\" >Overview</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/equipment/\" >Equipment</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/publications/\" >Publications</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/cinemas/\" >Cinemas</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/uniforms/\" >Uniforms</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/films/\" >Films</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/advertising/\" >Advertising</a></li></ul></li><li><a href=\"http://www.cinemamuseum.org.uk/shop/\" >Shop</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">About</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/history/\" >History</a></li><li><a href=\"http://www.cinemamuseum.org.uk/visit/\" >Visit Us</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/links/\" >Links</a></li></ul></li></ul>\r\n</div>\r\n<div class=\"sf-blue-after\"></div>\r\n<!-- WP Menubar 5.9.3: end menu main_nav, template Suckerfish_41, CSS sf-blue.css -->\n                <style type=\"text/css\">\n                    @media screen and (-ms-high-contrast: active), (-ms-high-contrast: none) {\n                        /* Like IE9, which support conditional comments, IE10 needs less padding than the IE8 default */\n                        .sf-blue a, .sf-blue a:hover, .sf-blue a:visited { padding: 0 10.8px; }\n                    }\n                </style>\n\t\t<!--[if IE 9]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie9.css\" media=\"screen\" />\n\t\t<![endif]-->\n\t\t<!--[if IE 7]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie7.css\" media=\"screen\" />\n\t\t<![endif]-->\n\n\t</div>\r\n\t<div id=\"content_box\">\r\n\t\t\r\n\t\t<div id=\"content\" class=\"posts\">\r\n\t\t\t\r\n\t\t\t\t\t\r\n<!--\r\n\t\t\t\r\n<div class=\"navigation\">\r\n\t<span class=\"previous\">&larr; <a href=\"http://www.cinemamuseum.org.uk/2024/kennington-noir-presents-cry-of-the-city-1948-on-16mm/\" rel=\"prev\">Kennington Noir presents <em>Cry of the City</em> (1948) on 16mm</a></span>\r\n\t<span class=\"next\"><a href=\"http://www.cinemamuseum.org.uk/2024/celebrating-peter-sellers-dr-strangelove-or-how-i-learned-to-stop-worrying-and-love-the-bomb-1964/\" rel=\"next\">Celebrating Peter Sellers: <em>Dr. Strangelove or: How I Learned to Stop Worrying and Love the Bomb</em> (1964)</a> &rarr;</span>\r\n</div>\r\n<div class=\"clear whitespace\"></div>\r\n\r\n-->\r\n\t\t\t\r\n\t\t\t<div id=\"post-34732\" class=\"post-34732 post type-post status-publish format-standard has-post-thumbnail hentry category-events tag-contact tag-ticketlab\">\r\n\t\t\t\t<div class=\"entry_header\">\r\n<!--\r\n\t\t\t\t\tRC: Comment and Edit functionality removed from following post header. Date reduced to Month and Year. Conditional 'Featured Article' added\r\n-->\r\n\t\t\t\t\t<h2>Celebrating Peter Sellers: <em>Heavens Above!</em> (1963)</h2>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<h4>Sat 10 May 2025 @ 19:30 \t\t\t\t\t\t\t\t\t\t\t<!-- by David --> &middot; \r\n\t\t\t\t\t<!-- <a href=\"http://www.cinemamuseum.org.uk/2024/celebrating-peter-sellers-heavens-above-1963/#comments\">No Comments</a> &middot; -->\r\n\t\t\t\t\t<a href=\"http://www.cinemamuseum.org.uk/topics/events/\" rel=\"category tag\">Events</a>\t\t\t\t\t<!--  -->\r\n\t\t\t\t\t\t\t\t\t\t</h4>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"entry\">\r\n<!--\r\n\t\t\t\t\tRC: I'm not clear when the_content pagination would be triggered.\r\n\t\t\t\t\tIf triggered, consider changing to plug-in based pagination.\r\n-->\r\n\t\t\t\t\t<div class=\"at-above-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2024/celebrating-peter-sellers-heavens-above-1963/\"></div><p><a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Heavens-Above-1.jpg\" target=\"_blank\" rel=\"noopener\" title=\"Heavens Above! - click to enlarge\"><img fetchpriority=\"high\" decoding=\"async\" class=\"alignleft wp-image-34736 size-large\" title=\"Heavens Above! - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Heavens-Above-1-488x397.jpg\" alt=\"Heavens Above! \" width=\"488\" height=\"397\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Heavens-Above-1-488x397.jpg 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Heavens-Above-1-300x244.jpg 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Heavens-Above-1-150x122.jpg 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Heavens-Above-1-90x73.jpg 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Heavens-Above-1.jpg 737w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a>Peter Sellers is one of the greatest character actors in the history of British cinema; a name to rank alongside Peter Finch, Alec Guinness and Trevor Howard. To mark the centenary of the year of his birth, The Cinema Museum will commence a seasons of six key Sellers performances.</p>\n<p>Another Boulting Brothers satire, this time on religion, sees Sellers playing a prison chaplain with radical ideas, who is accidentally appointed to a church in a town which is controlled by the Despard family, who virtually run the town and operate a large factory there. His views on charity and foregiveness are soon annoying both hs parishioners and the wider town. The cast includes an A to Z of British comedy talent.</p>\n<p>Followed by a Q&amp;A discussion with leading film and media experts Dr. Graham McCann (to be confirmed) and Dr. Matthew Sweet (to be confirmed).</p>\n<p>Dr. Andrew Roberts, the curator of the event says: “Selecting the best of Seller’s work was a genuine challenge. At worst, he could be utterly self-indulgent; at his finest, he could variously induce laughter, fear and pain by his expressions alone”.</p>\n<p>Doors open at 18.30, for a 19.30 start.</p>\n<p>Refreshments will be available in our licensed cafe/bar.</p>\n<h3>TICKETS &amp; PRICING</h3>\n<p>Tickets £10.</p>\n<p>Advance tickets may be purchased from <a href=\"https://ticketlab.co.uk/event/id/29295\" target=\"_blank\" rel=\"noopener noreferrer\">Ticketlab</a>, or direct from the Museum by calling 020 7840 2200 in office hours.<br />\n<a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Heavens-Above-2.jpg\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Heavens Above!  - click to enlarge\"><img decoding=\"async\" class=\"alignleft wp-image-34735 size-full\" title=\"Heavens Above!  - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Heavens-Above-2.jpg\" alt=\"Heavens Above! \" width=\"488\" height=\"301\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Heavens-Above-2.jpg 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Heavens-Above-2-300x185.jpg 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Heavens-Above-2-150x93.jpg 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Heavens-Above-2-90x56.jpg 90w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a></p>\n<!-- PHP 5.x --><!-- AddThis Advanced Settings above via filter on the_content --><!-- AddThis Advanced Settings below via filter on the_content --><!-- AddThis Advanced Settings generic via filter on the_content --><!-- AddThis Share Buttons above via filter on the_content --><!-- AddThis Share Buttons below via filter on the_content --><div class=\"at-below-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2024/celebrating-peter-sellers-heavens-above-1963/\"></div><!-- AddThis Share Buttons generic via filter on the_content -->\t\t\t\t\t\t\t\t\t\t<script type='text/javascript'>\r\n\t\t\t\t\t//<![CDATA[\r\n\t\t\t\t\tdocument.write(\"<h4 class='backLink'>[<a href='javascript:history.back()' class='backLink' title='Go back'>&larr; Go back<\\/a>]<\\/h4>\");\r\n\t\t\t\t\t//]]>\r\n\t\t\t\t\t</script>\t\t\t\t\t<noscript><h4 class='backLink'>[<a href=\"\" class='backLink' title='Go back'>&larr; Go back</a>]</h4></noscript>\r\n\t\t\t\t</div>\r\n<!--\r\n\t\t\t\t<p class=\"tagged\"><strong>Tags:</strong> <a href=\"http://www.cinemamuseum.org.uk/tag/contact/\" rel=\"tag\">Contact</a>&middot;<a href=\"http://www.cinemamuseum.org.uk/tag/ticketlab/\" rel=\"tag\">TicketLab</a></p>\t\t\t\tRC: Remove tag functionality and replace the 'clear' div with a flatter 'clear flat' one.\r\n-->\t\t\t\t\r\n\t\t\t\t<div class=\"clear flat\"></div>\r\n\t\t\t</div>\r\n\t\t\t\r\n<!--\t\t\r\n\t\t\tRC: Comment functionality removed. (IE8 fails to see this as comment, so commented the php also.)\r\n\t\t\t-->\r\n\t\t\t\r\n\t\t\t\t\r\n\t\t</div>\r\n\t\t\r\n\t\t<div id=\"sidebar\">\r\n\t<ul class=\"sidebar_list\">\r\n\t\t<li id=\"search-3\" class=\"widget widget_search\"><h2 class=\"widgettitle\">Search</h2>\n<form method=\"get\" id=\"search_form\" action=\"http://www.cinemamuseum.org.uk/\">\r\n\t<input type=\"text\" class=\"search_input\" value=\"To search, type and hit enter\" name=\"s\" id=\"s\" onfocus=\"if (this.value == 'To search, type and hit enter') {this.value = '';}\" onblur=\"if (this.value == '') {this.value = 'To search, type and hit enter';}\" />\r\n\t<input type=\"hidden\" id=\"searchsubmit\" value=\"Search\" />\r\n</form>\r\n</li>\n<li id=\"custom_html-5\" class=\"widget_text widget widget_custom_html\"><h2 class=\"widgettitle\">Buy Advance Tickets From Ticketlab</h2>\n<div class=\"textwidget custom-html-widget\"><p class=\"final\"><a href=\"https://ticketlab.co.uk/events/CinemaMuseum\" target=\"_blank\" rel=\"noopener\"><img style=\"border:1px solid teal; height:200px\" \r\nsrc=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2019/08/ticketlab.png\" ></a></p></div></li>\n<li id=\"text-7\" class=\"widget widget_text\"><h2 class=\"widgettitle\">Contact Us</h2>\n\t\t\t<div class=\"textwidget\"><p class=\"final\">The Cinema Museum<br /> \n2 Dugard Way (off Renfrew Road)<br />\nLondon SE11 4TH UK<br />\nTel.: 0207 840 2200<br />\nEmail: <a href=\"mailto:info@cinemamuseum.org.uk\">info@cinemamuseum.org.uk</a></p></div>\n\t\t</li>\n<li id=\"addthis_tool_by_class_name_widget-1\" class=\"widget widget_addthis_tool_by_class_name_widget\"><!-- Widget added by an AddThis plugin --><!-- widget name: AddThis Tool --><h2 class=\"widgettitle\">Share this Page</h2>\n<div class=\"addthis_toolbox addthis_default_style \"><a class=\"addthis_button_facebook_like\" fb:like:layout=\"button_count\"></a><a class=\"addthis_button_tweet\"></a><a class=\"addthis_button_pinterest_pinit\"></a><a class=\"addthis_counter addthis_pill_style\"></a></div><!-- End of widget --></li>\n\t</ul>\r\n</div>\t\t\t\r\n\t</div>\r\n\r\n<div id=\"footer\">\n\t<div id=\"contact\">\n\t\t<p>The Cinema Museum\n\t\t\t<br />2 Dugard Way, London SE11 4TH\n\t\t\t<br />Tel.: +44 (0)20 7840 2200\n\t\t\t<br />Email:\n\t\t\t<a href=\"mailto:info@cinemamuseum.org.uk\">info@cinemamuseum.org.uk</a>\n\t\t</p>\n\t</div>\n\t<div id=\"copyright\">\n\t\t<p>&copy;\n\t\t\tThe Cinema Museum, London &mdash; Site by Antbird</p>\n\t</div>\n\t<div id=\"social_links\">\n\t\t<a href=\"http://www.facebook.com/pages/London/The-Cinema-Museum/94435861815\" target=\"_blank\">\n\t\t\t<img src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/images/facebook.jpg\" alt=\"Visit The Cinema Museum on Facebook\" title=\"Visit The Cinema Museum on Facebook\"\n\t\t\t/>\n\t\t</a>\n\t\t<a href=\"http://twitter.com/CinemaMuseum\" target=\"_blank\">\n\t\t\t<img src=\"http://www.cinem