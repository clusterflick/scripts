lightbox-plus/css/shadowed/colorbox.css?ver=2.0.2' type='text/css' media='screen' />\n<link rel='stylesheet' id='wp-paginate-css' href='http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/wp-paginate/css/wp-paginate.css?ver=2.2.4' type='text/css' media='screen' />\n<script type=\"text/javascript\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-includes/js/jquery/jquery.min.js?ver=3.7.1\" id=\"jquery-core-js\"></script>\n<script type=\"text/javascript\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-includes/js/jquery/jquery-migrate.min.js?ver=3.4.1\" id=\"jquery-migrate-js\"></script>\n<meta name=\"generator\" content=\"WordPress 6.4.5\" />\n<!--[if lt IE 8]>\n<style type=\"text/css\">\n.eshoppanels li{\n    display:inline;\n    margin:10px 5px 0 5px;\n}\n</style>\n<![endif]-->\n\n<!-- WP Menubar 5.9.3: start CSS -->\n<link rel=\"stylesheet\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/Suckerfish_41/sf-blue.css\" type=\"text/css\" media=\"screen\" />\n<!-- WP Menubar 5.9.3: end CSS -->\n\t<!--Simple Popup Plugin v4.0 / RH Mods-->\n\t<script language=\"javascript\" type=\"text/javascript\">\n\t<!--\n\tvar swin=null;\n\tfunction popitup(mypage,w,h,pos,myname,infocus){\n\t    if (w!=parseInt(w)||w<=0) w=$width;\n\t    if (h!=parseInt(h)||h<=0) h=$height;\n\t    if (myname==null){myname=\"swin\"};\n\t    var myleft = 0;\n\t    var mytop = 0;\n\t    if (myleft==0 && mytop==0 && pos!=\"random\"){pos=\"center\"};\n\t    if (pos==\"random\"){myleft=(screen.width)?Math.floor(Math.random()*(screen.width-w)):100;mytop=(screen.height)?Math.floor(Math.random()*((screen.height-h)-75)):100;}\n\t    if (pos==\"center\"){myleft=(screen.width)?(screen.width-w)/2:100;mytop=(screen.height)?(screen.height-h)/2:100;}\n\t    settings=\"width=\" + w + \",height=\" + h + \",top=\" + mytop + \",left=\" + myleft + \",scrollbars=yes,location=no,directories=no,status=no,menubar=no,toolbar=no,resizable=no\";swin=window.open(mypage,myname,settings);\n\t    if (infocus==null || infocus==\"front\"){swin.focus()};\n\t    return false;\n\t}\n\t// -->\n\t</script>\n\t<!--/Simple Popup Plugin-->\n\t<!-- mf-taxonomy-list -->\n <style type=\"text/css\"> html>body .entry ul.mf_taxonomy_column { /* Reset for the Default Theme. */ margin: 0px; padding: 0px; list-style-type: none; padding-left: 0px; text-indent: 0px; } ul.mf_taxonomy_column, .entry ul.mf_taxonomy_column { float: left; margin: 0; padding: 0 0 1em; list-style-type: none; list-style-position: outside; } .mf_cols_1{ width:99%; } .mf_cols_2{ width:49.5%; } .mf_cols_3{ width:33%; } .mf_cols_4{ width:24.75%; } .mf_cols_5{ width:19.77%; } .entry ul.mf_taxonomy_column li:before { content: \"\"; } .mf_taxonomy_column li, .entry ul.mf_taxonomy_column li { list-style: none, outside; position: relative; height: 1.5em; z-index: 0; background: #fff; margin: 0 1em .4em 0; } .mf_taxonomy_column li.has-quantity, .entry ul.mf_taxonomy_column li.has-quantity { border-bottom: 1px dotted #888; } .mf_taxonomy_column a.edit-term { height: 16px; width: 16px; display: block; } .logged-in .mf_taxonomy_column a.term-name { left: 16px; padding-left: 4px; } .mf_taxonomy_column a.edit-term, .mf_taxonomy_column a.term-name, .mf_taxonomy_column .quantity { position:absolute; bottom: -0.2em; line-height: 1em; background: #fff; z-index:10; } .mf_taxonomy_column a.term-name { display: block; left:0; padding-right: 0.3em; text-decoration: none; } .mf_taxonomy_column .quantity { display: block; right:0; padding-left: 0.3em; } .mf_taxonomy_list .clear { clear:both; } </style><script data-cfasync=\"false\" type=\"text/javascript\">if (window.addthis_product === undefined) { window.addthis_product = \"wpp\"; } if (window.wp_product_version === undefined) { window.wp_product_version = \"wpp-6.2.7\"; } if (window.addthis_share === undefined) { window.addthis_share = {}; } if (window.addthis_config === undefined) { window.addthis_config = {\"data_track_clickback\":true,\"ignore_server_config\":true,\"ui_atversion\":300}; } if (window.addthis_layers === undefined) { window.addthis_layers = {}; } if (window.addthis_layers_tools === undefined) { window.addthis_layers_tools = []; } else {  } if (window.addthis_plugin_info === undefined) { window.addthis_plugin_info = {\"info_status\":\"enabled\",\"cms_name\":\"WordPress\",\"plugin_name\":\"Share Buttons by AddThis\",\"plugin_version\":\"6.2.7\",\"plugin_mode\":\"WordPress\",\"anonymous_profile_id\":\"wp-747be56a313680a55be1b14da545a27c\",\"page_info\":{\"template\":\"categories\",\"post_type\":\"\"},\"sharing_enabled_on_post_via_metabox\":false}; } \n                    (function() {\n                      var first_load_interval_id = setInterval(function () {\n                        if (typeof window.addthis !== 'undefined') {\n                          window.clearInterval(first_load_interval_id);\n                          if (typeof window.addthis_layers !== 'undefined' && Object.getOwnPropertyNames(window.addthis_layers).length > 0) {\n                            window.addthis.layers(window.addthis_layers);\n                          }\n                          if (Array.isArray(window.addthis_layers_tools)) {\n                            for (i = 0; i < window.addthis_layers_tools.length; i++) {\n                              window.addthis.layers(window.addthis_layers_tools[i]);\n                            }\n                          }\n                        }\n                     },1000)\n                    }());\n                </script> <script data-cfasync=\"false\" type=\"text/javascript\" src=\"https://s7.addthis.com/js/300/addthis_widget.js#pubid=ra-4dbbcf4b502a51ae\" async=\"async\"></script></head>\n\n<body class=\"custom\">\n\n<div id=\"container\">\n\t\n\t<div id=\"header_img\">\n\t\t<a href=http://www.cinemamuseum.org.uk><img src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/images/cm_header.jpg\" width=\"770\" alt=\"The Cinema Museum, London\" title=\"The Cinema Museum, London\" /></a>\n\t</div>\n\t<div id=\"main_nav\">\n\t\t<!-- WP Menubar 5.9.3: start menu main_nav, template Suckerfish_41, CSS sf-blue.css -->\n\r\n<script type=\"text/javascript\">\r\n// <![CDATA[\r\n\twpm1_Hover = function() {\r\n\tvar wpmEls = document.getElementById(\"wpm1\").getElementsByTagName(\"li\");\r\n\tfor (var i=0; i<wpmEls.length; i++) {\r\n\t\twpmEls[i].onmouseover = function() {\r\n\t\t\tthis.className += \" wpmhover\";\r\n\t\t}\r\n\t\twpmEls[i].onmouseout = function() {\r\n\t\t\tthis.className = this.className.replace(new RegExp(\" wpmhover\\\\b\"), \"\");\r\n\t\t}\r\n\t}\r\n}\r\nif (window.attachEvent) window.attachEvent(\"onload\", wpm1_Hover);\r\n// ]]>\r\n</script>\r\n\r\n<div class=\"sf-blue-before\"></div>\r\n<div id=\"wpm1\" class=\"sf-blue\">\r\n<ul><li><a href=\"http://www.cinemamuseum.org.uk\" >Home</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/news/\" >News</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/campaign/\" >CAMPAIGN</a></li><li class=\"selected\"><a href=\"http://www.cinemamuseum.org.uk/topics/events/\" >Events</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">The Collection</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/overview/\" >Overview</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/equipment/\" >Equipment</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/publications/\" >Publications</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/cinemas/\" >Cinemas</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/uniforms/\" >Uniforms</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/films/\" >Films</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/advertising/\" >Advertising</a></li></ul></li><li><a href=\"http://www.cinemamuseum.org.uk/shop/\" >Shop</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">About</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/history/\" >History</a></li><li><a href=\"http://www.cinemamuseum.org.uk/visit/\" >Visit Us</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/links/\" >Links</a></li></ul></li></ul>\r\n</div>\r\n<div class=\"sf-blue-after\"></div>\r\n<!-- WP Menubar 5.9.3: end menu main_nav, template Suckerfish_41, CSS sf-blue.css -->\n                <style type=\"text/css\">\n                    @media screen and (-ms-high-contrast: active), (-ms-high-contrast: none) {\n                        /* Like IE9, which support conditional comments, IE10 needs less padding than the IE8 default */\n                        .sf-blue a, .sf-blue a:hover, .sf-blue a:visited { padding: 0 10.8px; }\n                    }\n                </style>\n\t\t<!--[if IE 9]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie9.css\" media=\"screen\" />\n\t\t<![endif]-->\n\t\t<!--[if IE 7]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie7.css\" media=\"screen\" />\n\t\t<![endif]-->\n\n\t</div>\t\t\r\n\t<div id=\"content_box\">\r\n\t\t<div id=\"content\" class=\"posts\">\r\n\t\t\r\n\t\t\t\t\r\n\t\t<h1 id=\"content_header\">Upcoming Events</h1>\r\n\t\t<div id='non_post' class='archive'></div> \r\n\r\n\t\t\t\t\t\t\r\n\t\t\t<div id=\"post-34779\" class=\"post-34779 post type-post status-publish format-standard hentry category-events tag-contact tag-ticketlab\">\r\n\t\t\t\t<div class=\"entry_header\">\r\n\t\t\t\t\t<h2><a href=\"http://www.cinemamuseum.org.uk/2024/the-spring-season-2025-dates-for-your-diary/\" rel=\"bookmark\" title=\"Article on The Spring Season 2025: dates for your diary\">The Spring Season 2025: dates for your diary</a></h2>\r\n\t\t\t\t\t\t\t\t\t\t<h4>Sat 21 Dec  - Mon 30 Jun 2025 <!-- by David --> &middot; <!--<span>Comments Off<span class=\"screen-reader-text\"> on The Spring Season 2025: dates for your diary</span></span> &middot;--><a href=\"http://www.cinemamuseum.org.uk/topics/events/\" rel=\"category tag\">Events</a><!-- --></h4>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"entry\">\r\n\t\t\t\t\t\t<p>\r\n\t\t\t\t\t\t\t<div class=\"at-above-post-cat-page addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2024/the-spring-season-2025-dates-for-your-diary/\"></div>Screenings, theatrical extravaganzas, film clubs, book launches, live talks and more as the Cinema Museum continues its fundraising campaign to secure its future. <!-- AddThis Advanced Settings above via filter on get_the_excerpt --><!-- AddThis Advanced Settings below via filter on get_the_excerpt --><!-- AddThis Advanced Settings generic via filter on get_the_excerpt --><!-- AddThis Share Buttons above via filter on get_the_excerpt --><!-- AddThis Share Buttons below via filter on get_the_excerpt --><div class=\"at-below-post-cat-page addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2024/the-spring-season-2025-dates-for-your-diary/\"></div><!-- AddThis Share Buttons generic via filter on get_the_excerpt -->\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t</p>\r\n\t\t\t\t\t<h4 class=\"forwardLink\">[<a class=\"forwardLink\" href=\"http://www.cinemamuseum.org.uk/2024/the-spring-season-2025-dates-for-your-diary/#more-34779\">Read more &rarr;</a>]</h4>\r\n\t\t\t\t</div>\r\n\r\n\t\t\t\t<div class=\"entry_footer\"></div>\r\n\t\t\t\t<div class=\"clear\"></div>\r\n\t\t\t</div>\r\n\t\t\t\r\n\t\t\t\t\t\t\r\n\t\t\t<div id=\"post-34621\" class=\"post-34621 post type-post status-publish format-standard has-post-thumbnail hentry category-events tag-contact\">\r\n\t\t\t\t<div class=\"entry_header\">\r\n\t\t\t\t\t<h2><a href=\"http://www.cinemamuseum.org.uk/2024/1st-european-circus-history-conference-london-28th-february-2nd-march-2025/\" rel=\"bookmark\" title=\"Article on 1st European Circus History Conference London, 28th February – 2nd March 2025\">1st European Circus History Conference London, 28th February – 2nd March 2025</a></h2>\r\n\t\t\t\t\t\t\t\t\t\t<h4>Sat 1 Mar  - Sun 2 Mar 2025 <!-- by David --> &middot; <!--<span>Comments Off<span class=\"screen-reader-text\"> on 1st European Circus History Conference London, 28th February – 2nd March 2025</span></span> &middot;--><a href=\"http://www.cinemamuseum.org.uk/topics/events/\" rel=\"category tag\">Events</a><!-- --></h4>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"entry\">\r\n\t\t\t\t\t\t<p>\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"http://www.cinemamuseum.org.uk/2024/1st-european-circus-history-conference-london-28th-february-2nd-march-2025/\" title=\"1st European Circus History Conference London, 28th February – 2nd March 2025\" >\r\n\t\t\t\t\t\t\t\t<img width=\"150\" height=\"105\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/11/Circus-150x105.jpg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"\" decoding=\"async\" loading=\"lazy\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/11/Circus-150x105.jpg 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/11/Circus-300x209.jpg 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/11/Circus-488x340.jpg 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/11/Circus-768x536.jpg 768w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/11/Circus-90x63.jpg 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/11/Circus.jpg 1500w\" sizes=\"(max-width: 150px) 100vw, 150px\" />\t\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t\t<div class=\"at-above-post-cat-page addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2024/1st-european-circus-history-conference-london-28th-february-2nd-march-2025/\"></div>The Early Evolution of European Circus and its Disciplines, c1760s – 1860s. Appropriately for a European event, the conference concerns circuses and performers active within any part of Europe, and also those who travelled into and from Europe.<!-- AddThis Advanced Settings above via filter on get_the_excerpt --><!-- AddThis Advanced Settings below via filter on get_the_excerpt --><!-- AddThis Advanced Settings generic via filter on get_the_excerpt --><!-- AddThis Share Buttons above via filter on get_the_excerpt --><!-- AddThis Share Buttons below via filter on get_the_excerpt --><div class=\"at-below-post-cat-page addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2024/1st-european-circus-history-conference-london-28th-february-2nd-march-2025/\"></div><!-- AddThis Share Buttons generic via filter on get_the_excerpt -->\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t</p>\r\n\t\t\t\t\t<h4 class=\"forwardLink\">[<a class=\"forwardLink\" href=\"http://www.cinemamuseum.org.uk/2024/1st-european-circus-history-conference-london-28th-february-2nd-march-2025/#more-34621\">Read more &rarr;</a>]</h4>\r\n\t\t\t\t</div>\r\n\r\n\t\t\t\t<div class=\"entry_footer\"></div>\r\n\t\t\t\t<div class=\"clear\"></div>\r\n\t\t\t</div>\r\n\t\t\t\r\n\t\t\t\t\t\t\r\n\t\t\t<div id=\"post-35044\" class=\"post-35044 post type-post status-publish format-standard has-post-thumbnail hentry category-events tag-contact tag-ticketlab\">\r\n\t\t\t\t<div class=\"entry_header\">\r\n\t\t\t\t\t<h2><a href=\"http://www.cinemamuseum.org.uk/2025/the-nickel-presents-eraserhead-1977-on-16mm-film/\" rel=\"bookmark\" title=\"Article on The Nickel presents <em>Eraserhead</em> (1977) on 16mm Film <span style=color:red>&#8211; SOLD OUT &#8211; SEE MAR 6th</span>\">The Nickel presents <em>Eraserhead</em> (1977) on 16mm Film <span style=color:red>&#8211; SOLD OUT &#8211; SEE MAR 6th</span></a></h2>\r\n\t\t\t\t\t\t\t\t\t\t<h4>Wed 5 Mar 2025 @ 19:30 <!-- by David --> &middot; <!--<span>Comments Off<span class=\"screen-reader-text\"> on The Nickel presents <em>Eraserhead</em> (1977) on 16mm Film <span style=