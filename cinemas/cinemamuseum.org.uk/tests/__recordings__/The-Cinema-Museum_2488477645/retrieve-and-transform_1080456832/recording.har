\t<!--[if IE 7]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie7.css\" media=\"screen\" />\n\t\t<![endif]-->\n\n\t</div>\r\n\t<div id=\"content_box\">\r\n\t\t\r\n\t\t<div id=\"content\" class=\"posts\">\r\n\t\t\t\r\n\t\t\t\t\t\r\n<!--\r\n\t\t\t\r\n<div class=\"navigation\">\r\n\t<span class=\"previous\">&larr; <a href=\"http://www.cinemamuseum.org.uk/2025/women-and-cocaine-presents-shanghai-express-1932/\" rel=\"prev\">Women and Cocaine presents <em>Shanghai Express</em> (1932)</a></span>\r\n\t<span class=\"next\"><a href=\"http://www.cinemamuseum.org.uk/2025/women-and-cocaine-presents-dancing-lady-1933/\" rel=\"next\">Women and Cocaine presents <em>Dancing Lady</em> (1933)</a> &rarr;</span>\r\n</div>\r\n<div class=\"clear whitespace\"></div>\r\n\r\n-->\r\n\t\t\t\r\n\t\t\t<div id=\"post-34872\" class=\"post-34872 post type-post status-publish format-standard has-post-thumbnail hentry category-events tag-contact tag-ticketlab\">\r\n\t\t\t\t<div class=\"entry_header\">\r\n<!--\r\n\t\t\t\t\tRC: Comment and Edit functionality removed from following post header. Date reduced to Month and Year. Conditional 'Featured Article' added\r\n-->\r\n\t\t\t\t\t<h2>Some new kind of kick presents <em>Rumble: The Indians Who Rocked the World</em> (2017)</h2>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<h4>Sat 17 May 2025 @ 19:30 \t\t\t\t\t\t\t\t\t\t\t<!-- by David --> &middot; \r\n\t\t\t\t\t<!-- <a href=\"http://www.cinemamuseum.org.uk/2025/some-new-kind-of-kick-presents-rumble-the-indians-who-rocked-the-world-2017/#comments\">No Comments</a> &middot; -->\r\n\t\t\t\t\t<a href=\"http://www.cinemamuseum.org.uk/topics/events/\" rel=\"category tag\">Events</a>\t\t\t\t\t<!--  -->\r\n\t\t\t\t\t\t\t\t\t\t</h4>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"entry\">\r\n<!--\r\n\t\t\t\t\tRC: I'm not clear when the_content pagination would be triggered.\r\n\t\t\t\t\tIf triggered, consider changing to plug-in based pagination.\r\n-->\r\n\t\t\t\t\t<div class=\"at-above-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2025/some-new-kind-of-kick-presents-rumble-the-indians-who-rocked-the-world-2017/\"></div><p><a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Rumble-1.png\" target=\"_blank\" rel=\"noopener\" title=\"Rumble: The Indians Who Rocked the World - click to enlarge\"><img fetchpriority=\"high\" decoding=\"async\" class=\"alignleft wp-image-34875 size-large\" title=\"Rumble: The Indians Who Rocked the World - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Rumble-1-488x336.png\" alt=\"Rumble: The Indians Who Rocked the World\" width=\"488\" height=\"336\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Rumble-1-488x336.png 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Rumble-1-300x206.png 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Rumble-1-768x528.png 768w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Rumble-1-1536x1056.png 1536w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Rumble-1-150x103.png 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Rumble-1-90x62.png 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Rumble-1.png 1600w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a><strong>Some new kind of kick &#8211; celluloid rock n roll trash on a Saturday night.</strong></p>\n<p>So much of Native American culture has been erased, stolen, appropriated or denigrated. This fantastic film shows how influential so many Rock and Rollers were, who would not have had careers if they&#8217;d acknowledged their indigenous selves.</p>\n<p>Doors open at 18.30, for a 19.30 start.<br />\n<strong><br />\nDigital Presentation.</strong></p>\n<p>Refreshments will be available in our licensed cafe/bar.</p>\n<h3>TICKETS &amp; PRICING</h3>\n<p>Tickets £8.</p>\n<p>Advance tickets may be purchased from <a href=\"https://ticketlab.co.uk/event/id/29801#/\" target=\"_blank\" rel=\"noopener noreferrer\">Ticketlab</a>, or direct from the Museum by calling 020 7840 2200 in office hours.<br />\n<a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Rumble-2.webp\" target=\"_blank\" rel=\"noopener\"><img decoding=\"async\" class=\"alignleft wp-image-34874 size-large\" title=\"Rumble: The Indians Who Rocked the World - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Rumble-2-488x342.webp\" alt=\"Rumble: The Indians Who Rocked the World\" width=\"488\" height=\"342\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Rumble-2-488x342.webp 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Rumble-2-300x210.webp 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Rumble-2-150x105.webp 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Rumble-2-90x63.webp 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Rumble-2.webp 720w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a></p>\n<!-- PHP 5.x --><!-- AddThis Advanced Settings above via filter on the_content --><!-- AddThis Advanced Settings below via filter on the_content --><!-- AddThis Advanced Settings generic via filter on the_content --><!-- AddThis Share Buttons above via filter on the_content --><!-- AddThis Share Buttons below via filter on the_content --><div class=\"at-below-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2025/some-new-kind-of-kick-presents-rumble-the-indians-who-rocked-the-world-2017/\"></div><!-- AddThis Share Buttons generic via filter on the_content -->\t\t\t\t\t\t\t\t\t\t<script type='text/javascript'>\r\n\t\t\t\t\t//<![CDATA[\r\n\t\t\t\t\tdocument.write(\"<h4 class='backLink'>[<a href='javascript:history.back()' class='backLink' title='Go back'>&larr; Go back<\\/a>]<\\/h4>\");\r\n\t\t\t\t\t//]]>\r\n\t\t\t\t\t</script>\t\t\t\t\t<noscript><h4 class='backLink'>[<a href=\"\" class='backLink' title='Go back'>&larr; Go back</a>]</h4></noscript>\r\n\t\t\t\t</div>\r\n<!--\r\n\t\t\t\t<p class=\"tagged\"><strong>Tags:</strong> <a href=\"http://www.cinemamuseum.org.uk/tag/contact/\" rel=\"tag\">Contact</a>&middot;<a href=\"http://www.cinemamuseum.org.uk/tag/ticketlab/\" rel=\"tag\">TicketLab</a></p>\t\t\t\tRC: Remove tag functionality and replace the 'clear' div with a flatter 'clear flat' one.\r\n-->\t\t\t\t\r\n\t\t\t\t<div class=\"clear flat\"></div>\r\n\t\t\t</div>\r\n\t\t\t\r\n<!--\t\t\r\n\t\t\tRC: Comment functionality removed. (IE8 fails to see this as comment, so commented the php also.)\r\n\t\t\t-->\r\n\t\t\t\r\n\t\t\t\t\r\n\t\t</div>\r\n\t\t\r\n\t\t<div id=\"sidebar\">\r\n\t<ul class=\"sidebar_list\">\r\n\t\t<li id=\"search-3\" class=\"widget widget_search\"><h2 class=\"widgettitle\">Search</h2>\n<form method=\"get\" id=\"search_form\" action=\"http://www.cinemamuseum.org.uk/\">\r\n\t<input type=\"text\" class=\"search_input\" value=\"To search, type and hit enter\" name=\"s\" id=\"s\" onfocus=\"if (this.value == 'To search, type and hit enter') {this.value = '';}\" onblur=\"if (this.value == '') {this.value = 'To search, type and hit enter';}\" />\r\n\t<input type=\"hidden\" id=\"searchsubmit\" value=\"Search\" />\r\n</form>\r\n</li>\n<li id=\"custom_html-5\" class=\"widget_text widget widget_custom_html\"><h2 class=\"widgettitle\">Buy Advance Tickets From Ticketlab</h2>\n<div class=\"textwidget custom-html-widget\"><p class=\"final\"><a href=\"https://ticketlab.co.uk/events/CinemaMuseum\" target=\"_blank\" rel=\"noopener\"><img style=\"border:1px solid teal; height:200px\" \r\nsrc=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2019/08/ticketlab.png\" ></a></p></div></li>\n<li id=\"text-7\" class=\"widget widget_text\"><h2 class=\"widgettitle\">Contact Us</h2>\n\t\t\t<div class=\"textwidget\"><p class=\"final\">The Cinema Museum<br /> \n2 Dugard Way (off Renfrew Road)<br />\nLondon SE11 4TH UK<br />\nTel.: 0207 840 2200<br />\nEmail: <a href=\"mailto:info@cinemamuseum.org.uk\">info@cinemamuseum.org.uk</a></p></div>\n\t\t</li>\n<li id=\"addthis_tool_by_class_name_widget-1\" class=\"widget widget_addthis_tool_by_class_name_widget\"><!-- Widget added by an AddThis plugin --><!-- widget name: AddThis Tool --><h2 class=\"widgettitle\">Share this Page</h2>\n<div class=\"addthis_toolbox addthis_default_style \"><a class=\"addthis_button_facebook_like\" fb:like:layout=\"button_count\"></a><a class=\"addthis_button_tweet\"></a><a class=\"addthis_button_pinterest_pinit\"></a><a class=\"addthis_counter addthis_pill_style\"></a></div><!-- End of widget --></li>\n\t</ul>\r\n</div>\t\t\t\r\n\t</div>\r\n\r\n<div id=\"footer\">\n\t<div id=\"contact\">\n\t\t<p>The Cinema Museum\n\t\t\t<br />2 Dugard Way, London SE11 4TH\n\t\t\t<br />Tel.: +44 (0)20 7840 2200\n\t\t\t<br />Email:\n\t\t\t<a href=\"mailto:info@cinemamuseum.org.uk\">info@cinemamuseum.org.uk</a>\n\t\t</p>\n\t</div>\n\t<div id=\"copyright\">\n\t\t<p>&copy;\n\t\t\tThe Cinema Museum, London &mdash; Site by Antbird</p>\n\t</div>\n\t<div id=\"social_links\">\n\t\t<a href=\"http://www.facebook.com/pages/London/The-Cinema-Museum/94435861815\" target=\"_blank\">\n\t\t\t<img src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/images/facebook.jpg\" alt=\"Visit The Cinema Museum on Facebook\" title=\"Visit The Cinema Museum on Facebook\"\n\t\t\t/>\n\t\t</a>\n\t\t<a href=\"http://twitter.com/CinemaMuseum\" target=\"_blank\">\n\t\t\t<img src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/images/twitter.png\" alt=\"Follow The Cinema Museum on Twitter\" title=\"Follow The Cinema Museum on Twitter\"\n\t\t\t/>\n\t\t</a>\n\t\t<!-- Removed obsolete items ... PC 2/2/18\n\t\t<a href=\"http://www.youtube.com/user/CinemaMuseum\" target=\"_