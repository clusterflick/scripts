nmouseover = function() {\r\n\t\t\tthis.className += \" wpmhover\";\r\n\t\t}\r\n\t\twpmEls[i].onmouseout = function() {\r\n\t\t\tthis.className = this.className.replace(new RegExp(\" wpmhover\\\\b\"), \"\");\r\n\t\t}\r\n\t}\r\n}\r\nif (window.attachEvent) window.attachEvent(\"onload\", wpm1_Hover);\r\n// ]]>\r\n</script>\r\n\r\n<div class=\"sf-blue-before\"></div>\r\n<div id=\"wpm1\" class=\"sf-blue\">\r\n<ul><li><a href=\"http://www.cinemamuseum.org.uk\" >Home</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/news/\" >News</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/campaign/\" >CAMPAIGN</a></li><li class=\"selected\"><a href=\"http://www.cinemamuseum.org.uk/topics/events/\" >Events</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">The Collection</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/overview/\" >Overview</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/equipment/\" >Equipment</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/publications/\" >Publications</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/cinemas/\" >Cinemas</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/uniforms/\" >Uniforms</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/films/\" >Films</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/advertising/\" >Advertising</a></li></ul></li><li><a href=\"http://www.cinemamuseum.org.uk/shop/\" >Shop</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">About</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/history/\" >History</a></li><li><a href=\"http://www.cinemamuseum.org.uk/visit/\" >Visit Us</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/links/\" >Links</a></li></ul></li></ul>\r\n</div>\r\n<div class=\"sf-blue-after\"></div>\r\n<!-- WP Menubar 5.9.3: end menu main_nav, template Suckerfish_41, CSS sf-blue.css -->\n                <style type=\"text/css\">\n                    @media screen and (-ms-high-contrast: active), (-ms-high-contrast: none) {\n                        /* Like IE9, which support conditional comments, IE10 needs less padding than the IE8 default */\n                        .sf-blue a, .sf-blue a:hover, .sf-blue a:visited { padding: 0 10.8px; }\n                    }\n                </style>\n\t\t<!--[if IE 9]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie9.css\" media=\"screen\" />\n\t\t<![endif]-->\n\t\t<!--[if IE 7]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie7.css\" media=\"screen\" />\n\t\t<![endif]-->\n\n\t</div>\r\n\t<div id=\"content_box\">\r\n\t\t\r\n\t\t<div id=\"content\" class=\"posts\">\r\n\t\t\t\r\n\t\t\t\t\t\r\n<!--\r\n\t\t\t\r\n<div class=\"navigation\">\r\n\t<span class=\"previous\">&larr; <a href=\"http://www.cinemamuseum.org.uk/2025/museum-tour-dates-january-2025/\" rel=\"prev\">Museum tour dates January 2025</a></span>\r\n\t<span class=\"next\"><a href=\"http://www.cinemamuseum.org.uk/2025/women-and-cocaine-presents-the-miracle-woman-1931/\" rel=\"next\">Women and Cocaine presents <em>The Miracle Woman</em> (1931)</a> &rarr;</span>\r\n</div>\r\n<div class=\"clear whitespace\"></div>\r\n\r\n-->\r\n\t\t\t\r\n\t\t\t<div id=\"post-34817\" class=\"post-34817 post type-post status-publish format-standard has-post-thumbnail hentry category-events tag-contact tag-ticketlab\">\r\n\t\t\t\t<div class=\"entry_header\">\r\n<!--\r\n\t\t\t\t\tRC: Comment and Edit functionality removed from following post header. Date reduced to Month and Year. Conditional 'Featured Article' added\r\n-->\r\n\t\t\t\t\t<h2>Fundraiser screening of <em>Kensuke’s Kingdom</em> (2024) plus Q&#038;A with directors Kirk Hendry and Neil Boyle</h2>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<h4>Sun 13 Apr 2025 @ 14:00 \t\t\t\t\t\t\t\t\t\t\t<!-- by David --> &middot; \r\n\t\t\t\t\t<!-- <a href=\"http://www.cinemamuseum.org.uk/2025/fundraiser-screening-of-kensukes-kingdom-2024-plus-qa-with-directors-kirk-hendry-and-neil-boyle/#comments\">No Comments</a> &middot; -->\r\n\t\t\t\t\t<a href=\"http://www.cinemamuseum.org.uk/topics/events/\" rel=\"category tag\">Events</a>\t\t\t\t\t<!--  -->\r\n\t\t\t\t\t\t\t\t\t\t</h4>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"entry\">\r\n<!--\r\n\t\t\t\t\tRC: I'm not clear when the_content pagination would be triggered.\r\n\t\t\t\t\tIf triggered, consider changing to plug-in based pagination.\r\n-->\r\n\t\t\t\t\t<div class=\"at-above-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2025/fundraiser-screening-of-kensukes-kingdom-2024-plus-qa-with-directors-kirk-hendry-and-neil-boyle/\"></div><p><a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-poster.jpg\" target=\"_blank\" rel=\"noopener\" title=\"Kensuke’s Kingdom poster - click to enlarge\"><img fetchpriority=\"high\" decoding=\"async\" class=\"alignleft wp-image-34821 size-large\" title=\"Kensuke’s Kingdom poster - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-poster-488x329.jpg\" alt=\"Kensuke’s Kingdom poster\" width=\"488\" height=\"329\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-poster-488x329.jpg 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-poster-300x203.jpg 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-poster-768x518.jpg 768w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-poster-1536x1037.jpg 1536w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-poster-150x101.jpg 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-poster-90x61.jpg 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-poster.jpg 2000w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a><em>Kensuke’s Kingdom</em> (2024) is the multi award-winning animated film based on the best selling novel by Michael Morpurgo, with a screenplay by Frank Cottrell-Boyce, and featuring the voices of Cillian Murphy, Sally Hawkins and Ken Watanabe.<span id=\"more-34817\"></span></p>\n<p>Young Michael and his dog wash up on a remote island when a violent storm sweeps them overboard during a family sailing trip. Believing he&#8217;s all alone, Michael is surprised to discover a mysterious Japanese man who&#8217;s lived on the island since World War II. Initially suspicious of each other, the boy and the old man must soon join forces when dangerous invaders threaten their fragile paradise.</p>\n<p>Follow the screening, there will be a Q&amp;A with directors Kirk Hendry (who is a Kennington resident) and Neil Boyle, with other participants to be announced.</p>\n<p>Doors open at 13.00, for a 14.00 start.</p>\n<p>Refreshments will be available in our licensed cafe/bar.</p>\n<h3>TICKETS &amp; PRICING</h3>\n<p>Tickets £10.<br />\nAdvance tickets may be purchased from <a href=\"https://ticketlab.co.uk/event/id/29706#/\" target=\"_blank\" rel=\"noopener noreferrer\">Ticketlab</a>, or direct from the Museum by calling 020 7840 2200 in office hours.<br />\n<a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-1-scaled.jpg\" target=\"_blank\" rel=\"noopener\" title=\"Kensuke’s Kingdom - click to enlarge\"><img decoding=\"async\" class=\"alignleft wp-image-34822 size-large\" title=\"Kensuke’s Kingdom - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-1-488x204.jpg\" alt=\"Kensuke’s Kingdom\" width=\"488\" height=\"204\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-1-488x204.jpg 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-1-300x126.jpg 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-1-768x322.jpg 768w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-1-1536x643.jpg 1536w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-1-2048x858.jpg 2048w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-1-150x63.jpg 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Kensukes-Kingdom-1-90x38.jpg 90w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a></p>\n<!-- PHP 5.x --><!-- AddThis Advanced Settings above via filter on the_content --><!-- AddThis Advanced Settings below via filter on the_content --><!-- AddThis Advanced Settings generic via filter on the_content --><!-- AddThis Share Buttons above via filter on the_content --><!-- AddThis Share Buttons below via filter on the_content --><div class=\"at-below-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2025/fundraiser-screening-of-kensukes-kingdom-2024-plus-qa-with-directors-kirk-hendry-and-neil-boyle/\"></div><!-- AddThis Share Buttons generic via filter on the_content -->\t\t\t\t\t\t\t\t\t\t<script type='text/javascript'>\r\n\t\t\t\t\t//<![CDATA[\r\n\t\t\t\t\tdocument.write(\"<h4 class='backLink'>[<a href='javascript:history.back()' class='backLink' title='Go back'>&larr; Go back<\\/a>]<\\/h4>\");\r\n\t\t\t\t\t//]]>\r\n\t\t\t\t\t</script>\t\t\t\t\t<noscript><h4 class='backLink'>[<a href=\"\" class='backLink' title='Go back'>&larr; Go back</a>]</h4></noscript>\r\n\t\t\t\t</div>\r\n<!--\r\n\t\t\t\t<p class=\"tagged\"><strong>Tags:</strong> <a href=\"http://www.cinemamuseum.org.uk/tag/contact/\" rel=\"tag\">Contact</a>&middot;<a href=\"http://www.cinemamuseum.org.uk/tag/t