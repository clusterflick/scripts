r\n\t\t}\r\n\t}\r\n}\r\nif (window.attachEvent) window.attachEvent(\"onload\", wpm1_Hover);\r\n// ]]>\r\n</script>\r\n\r\n<div class=\"sf-blue-before\"></div>\r\n<div id=\"wpm1\" class=\"sf-blue\">\r\n<ul><li><a href=\"http://www.cinemamuseum.org.uk\" >Home</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/news/\" >News</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/campaign/\" >CAMPAIGN</a></li><li class=\"selected\"><a href=\"http://www.cinemamuseum.org.uk/topics/events/\" >Events</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">The Collection</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/overview/\" >Overview</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/equipment/\" >Equipment</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/publications/\" >Publications</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/cinemas/\" >Cinemas</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/uniforms/\" >Uniforms</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/films/\" >Films</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/advertising/\" >Advertising</a></li></ul></li><li><a href=\"http://www.cinemamuseum.org.uk/shop/\" >Shop</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">About</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/history/\" >History</a></li><li><a href=\"http://www.cinemamuseum.org.uk/visit/\" >Visit Us</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/links/\" >Links</a></li></ul></li></ul>\r\n</div>\r\n<div class=\"sf-blue-after\"></div>\r\n<!-- WP Menubar 5.9.3: end menu main_nav, template Suckerfish_41, CSS sf-blue.css -->\n                <style type=\"text/css\">\n                    @media screen and (-ms-high-contrast: active), (-ms-high-contrast: none) {\n                        /* Like IE9, which support conditional comments, IE10 needs less padding than the IE8 default */\n                        .sf-blue a, .sf-blue a:hover, .sf-blue a:visited { padding: 0 10.8px; }\n                    }\n                </style>\n\t\t<!--[if IE 9]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie9.css\" media=\"screen\" />\n\t\t<![endif]-->\n\t\t<!--[if IE 7]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie7.css\" media=\"screen\" />\n\t\t<![endif]-->\n\n\t</div>\r\n\t<div id=\"content_box\">\r\n\t\t\r\n\t\t<div id=\"content\" class=\"posts\">\r\n\t\t\t\r\n\t\t\t\t\t\r\n<!--\r\n\t\t\t\r\n<div class=\"navigation\">\r\n\t<span class=\"previous\">&larr; <a href=\"http://www.cinemamuseum.org.uk/2025/the-nickel-presents-wild-at-heart-1990-on-35mm-film-2/\" rel=\"prev\">The Nickel presents <em>Wild at Heart</em> (1990) on 35mm Film <span style=color:red>&#8211; SOLD OUT</span></a></span>\r\n\t<span class=\"next\"><a href=\"http://www.cinemamuseum.org.uk/2025/screening-of-satu-year-of-the-rabbit-2024-with-intro-and-qa/\" rel=\"next\">Screening of <em>Satu &#8211; Year of the Rabbit</em> (2024) with intro and Q&#038;A</a> &rarr;</span>\r\n</div>\r\n<div class=\"clear whitespace\"></div>\r\n\r\n-->\r\n\t\t\t\r\n\t\t\t<div id=\"post-35059\" class=\"post-35059 post type-post status-publish format-standard has-post-thumbnail hentry category-events tag-contact tag-ticketlab\">\r\n\t\t\t\t<div class=\"entry_header\">\r\n<!--\r\n\t\t\t\t\tRC: Comment and Edit functionality removed from following post header. Date reduced to Month and Year. Conditional 'Featured Article' added\r\n-->\r\n\t\t\t\t\t<h2>The Nickel presents <em>Eraserhead</em> (1977) on 16mm Film <span style=\"color: red;\">&#8211; SOLD OUT &#8211; SEE MAR 9th</span></h2>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<h4>Thu 6 Mar 2025 @ 19:30 \t\t\t\t\t\t\t\t\t\t\t<!-- by David --> &middot; \r\n\t\t\t\t\t<!-- <a href=\"http://www.cinemamuseum.org.uk/2025/the-nickel-presents-eraserhead-1977-on-16mm-film-2/#comments\">No Comments</a> &middot; -->\r\n\t\t\t\t\t<a href=\"http://www.cinemamuseum.org.uk/topics/events/\" rel=\"category tag\">Events</a>\t\t\t\t\t<!--  -->\r\n\t\t\t\t\t\t\t\t\t\t</h4>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"entry\">\r\n<!--\r\n\t\t\t\t\tRC: I'm not clear when the_content pagination would be triggered.\r\n\t\t\t\t\tIf triggered, consider changing to plug-in based pagination.\r\n-->\r\n\t\t\t\t\t<div class=\"at-above-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2025/the-nickel-presents-eraserhead-1977-on-16mm-film-2/\"></div><p><a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Eraserhead-1.png\" target=\"_blank\" rel=\"noopener\" title=\"Eraserhead - click to enlarge\"><img fetchpriority=\"high\" decoding=\"async\" class=\"alignleft wp-image-35005 size-large\" title=\"Eraserhead - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Eraserhead-1-488x274.png\" alt=\"Eraserhead\" width=\"488\" height=\"274\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Eraserhead-1-488x274.png 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Eraserhead-1-300x169.png 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Eraserhead-1-150x84.png 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Eraserhead-1-90x51.png 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Eraserhead-1.png 600w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a>To celebrate the unique cinema talent that was David Lynch, The Nickel is proud to present a screening of Lynch&#8217;s breakthrough work.<span id=\"more-35059\"></span></p>\n<p><em>Eraserhead</em> soon rose from being a film that was little seen to a cult classic, as people grew to appreciate Lynch&#8217;s surreal body-horror fantasy, with its disturbing images and unique sound design. Henry Spenser is persuaded to marry his girlfriend, who has recently had a baby. She moves into his flat, but the baby&#8217;s constant crying drives her mad, leaving Henry to care for the infant&#8230;</p>\n<p>&#8220;<em>Eraserhead</em> is a singular work of the imagination, a harrowing, heartbreaking plunge into the darkest recesses of the soul&#8221; (<em>Time Out</em>).</p>\n<p>Doors open at 18.30, for a 19.30 start. Refreshments will be available in our licensed cafe/bar.</p>\n<p>Screening from a rare original 16mm print.</p>\n<h3>TICKETS &amp; PRICING</h3>\n<p>Tickets £8.</p>\n<p>Advance tickets may be purchased from <a href=\"https://ticketlab.co.uk/event/id/30049\" target=\"_blank\" rel=\"noopener noreferrer\">Ticketlab</a>, or direct from the Museum by calling 020 7840 2200 in office hours.<br />\n<a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Eraserhead-2.jpg\" target=\"_blank\" rel=\"noopener\" title=\"Eraserhead - click to enlarge\"><img decoding=\"async\" class=\"alignleft wp-image-35004 size-large\" title=\"Eraserhead - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Eraserhead-2-488x273.jpg\" alt=\"Eraserhead\" width=\"488\" height=\"273\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Eraserhead-2-488x274.jpg 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Eraserhead-2-300x168.jpg 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Eraserhead-2-150x84.jpg 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Eraserhead-2-90x50.jpg 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Eraserhead-2.jpg 600w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a></p>\n<!-- PHP 5.x --><!-- AddThis Advanced Settings above via filter on the_content --><!-- AddThis Advanced Settings below via filter on the_content --><!-- AddThis Advanced Settings generic via filter on the_content --><!-- AddThis Share Buttons above via filter on the_content --><!-- AddThis Share Buttons below via filter on the_content --><div class=\"at-below-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2025/the-nickel-presents-eraserhead-1977-on-16mm-film-2/\"></div><!-- AddThis Share Buttons generic via filter on the_content -->\t\t\t\t\t\t\t\t\t\t<script type='text/javascript'>\r\n\t\t\t\t\t//<![CDATA[\r\n\t\t\t\t\tdocument.write(\"<h4 class='backLink'>[<a href='javascript:history.back()' class='backLink' title='Go back'>&larr; Go back<\\/a>]<\\/h4>\");\r\n\t\t\t\t\t//]]>\r\n\t\t\t\t\t</script>\t\t\t\t\t<noscript><h4 class='backLink'>[<a href=\"\" class='backLink' title='Go back'>&larr; Go back</a>]</h4></noscript>\r\n\t\t\t\t</div>\r\n<!--\r\n\t\t\t\t<p class=\"tagged\"><strong>Tags:</strong> <a href=\"http://www.cinemamuseum.org.uk/tag/contact/\" rel=\"tag\">Contact</a>&middot;<a href=\"http://www.cinemamuseum.org.uk/tag/ticketlab/\" rel=\"tag\">TicketLab</a></p>\t\t\t\tRC: Remove tag functionality and replace the 'clear' div with a flatter 'clear flat' one.\r\n-->\t\t\t\t\r\n\t\t\t\t<div class=\"clear flat\"></div>\r\n\t\t\t</div>\r\n\t\t\t\r\n<!--\t\t\r\n\t\t\tRC: Comment functionality removed. (IE8 fails to see this as comment, so commented the php also.)\r\n\t\t\t-->\r\n\t\t\t\r\n\t\t\t\t\r\n\t\t</div>\r\n\t\t\r\n\t\t<div id=\"sidebar\">\r\n\t<ul class=\"sidebar_list\">\r\n\t\t<li id=\"search-3\" class=\"widget widget_search\"><h2 class=\"widgettitle\">Search</h2>\n<form method=\"get\" id=\"search_form\" action=\"http://www.cinemamuseum.org.uk/\">\r\n\t<input type=\"text\" class=\"search_input\" value=\"To search, type and hit enter\" name=\"s\" id=\"s\" onfocus=\"if (this.value == 'To search, type and hit enter') {this.value = '';}\" onblur=\"if (this.value == '') {this.value = 'To search, type and hit enter';}\" />\r\n\t<input type=\"hidden\" id=\"searchsubmit\" value=\"Search\" />\r\n</form>\r\n</li>\n<li id=\"custom_html-5\" class=\"widget_text widget widget_custom_html\"><h2 class=\"widgettitle\">Buy Advance Tickets From Ticketlab</h2>\n<div class=\"textwidget custom-html-widget\"><p class=\"final\"><a href=\"https://ticketlab.co.uk/events/CinemaMuseum\" target=\"_blank\" rel=\"noopener\"><img style=\"border:1px solid teal; height:200px\" \r\nsrc=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2019/08/ticketlab.png\" ></a></p></div></li>\n<li id=\"text-7\" class=\"widget widget_text\"><h2 class=\"widgettitle\">Contact Us</h2>\n\t\t\t<div class=\"textwidget\"><p class=\"final\">The Cinema Museum<br /> \n2 Dugard Way (off Renfrew Road)<br />\nLondon SE11 4TH UK<br />\nTel.: 0207 840 2200<br />\nEmail: <a href=\"mailto:info@cinemamuseum.org.uk\">info@cinemamuseum.org.uk</a></p></div>\n\t\t</li>\n<li id=\"addthis_tool_by_class_name_widget-1\" class=\"widget widget_addthis_tool_by_class_name_widget\"><!-- Widget added by an AddThis plugin --><!-- widget name: AddThis Tool --><h2 class=\"widgettitle\">Share this Page</h2>\n<div class=\"addthis_toolbox addthis_default_style \"><a class=\"addthis_button_facebook_like\" fb:like:layout=\"button_count\"></a><a class=\"addthis_button_tweet\"></a><a class=\"addthis_button_pinterest_pinit\"></a><a class=\"addthis_counter addthis_pill_style\"></a></div><!-- End of widget --></li>\n\t</ul>\r\n</div>\t\t\t\r\n\t</div>\r\n\r\n<div id=\"footer\">\n\t<div id=\"contact\">\n\t\t<p>The Cinema Museum\n\t\t\t<br />2 Dugard Way, London SE11 4TH\n\t\t\t<br />Tel.: +44 (0)20 7840 2200\n\t\t\t<br />Email:\n\t\t\t<a href=\"mailto:info@cinemamuseum.org.uk\">info@cinemamuseum.org.uk</a>\n\t\t</p>\n\t</div>\n\t<div id=\"copyright\">\n\t\t<p>&copy;\n\t\t\tThe Cinema Museum, London &mdash; Site by Antbird</p>\n\t</div>\n\t<div id=\"social_links\">\n\t\t<a href=\"http://www.facebook.com/pages/London/The-Cinema-Museum/94435861815\" target=\"_blank\">\n\t\t\t<img src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/images/facebook.jpg\" alt=\"Visit The Cinema Museum on Facebook\" title=\"Visit The Cinema Museum on Facebook\"\n\t\t\t/>\n\t\t</a>\n\t\t<a href=\"http://twitter.com/CinemaMuseum\" target=\"_blank\">\n\t\t\t<img src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/images/twitter.png\" alt=\"Follow The Cinema Museum on Twitter\" title=\"Follow The Cinema Museum on Twitter\"\n\t\t\t/>\n\t\t</a>\n\t\t<!-- Removed obsolete items ... PC 2/2/18\n\t\t<a href=\"http://www.youtube.com/user/CinemaMuseum\" target=\"_blank\">\n\t\t\t<img src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/images/youtube-logo.gif\" alt=\"Visit The Cinema Museum's YouTube Channel\" title=\"Visit The Cinema Museum's YouTube Channel\"\n\t\t\t/>\n\t\t</a> \n\t\t<a href=\"http://www.cinemamuseum.org.uk/feed/\" target=\"_blank\" title=\"Syndicate this site using RSS\">\n\t\t\t<img src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/images/rss.png\" alt=\"Subscribe to the Cinema Museum's RSS Feed\" title=\"Subscribe to the Cinema Museum's RSS Feed\"\n\t\t\t/>\n\t\t</a>-->\n\t</div>\n\t<div class=\"full_clear very_flat\"></div>\n</div>\n</div>\n<!--Powered by eShop v6.3.14 by Rich Pedley http://www.quirm.net/--><!-- Lightbox Plus v2.0.5 - 2010.07.02 - Message: 0-->\n<script type=\"text/javascript\">\njQuery(document).ready(function($){\n  $(\"a[rel*=lightbox]\").colorbox({opacity:0.8});\n});\n</script>\n<script>\r\n  (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){\r\n  (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),\r\n  m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)\r\n  })(window,document,'script','//www.google-analytics.com/analytics.js','ga');\r\n\r\