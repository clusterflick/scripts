            "size": 38909,
            "text": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:og=\"http://ogp.me/ns#\" xmlns:fb=\"http://www.facebook.com/2008/fbml\">\n\n<head profile=\"http://gmpg.org/xfn/11\">\n\n\t<!-- Global site tag (gtag.js) - New Google Analytics - Added 2/2/18 by PC - This does not affect Rob's legacy GA call in footer.php -->\n\t<script async src=\"https://www.googletagmanager.com/gtag/js?id=UA-113465929-1\"></script>\n\t<script>\n\t\twindow.dataLayer = window.dataLayer || [];\n\t\tfunction gtag(){dataLayer.push(arguments);}\n\t\tgtag('js', new Date());\n\t\tgtag('config', 'UA-113465929-1');\n\t</script>\n\n\t<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n\n\t<!-- A shop item page or shop search listing page may have a top-level department; if present it should be included the its title. -->\n\t\n\t<!-- Create title and description, allowing for rss output. -->\n\t\t\t\n\t<title>Screening of Vindication Swim (2024) plus Q&#038;A with director Elliott Hasler &raquo; The Cinema Museum, London</title>\n\t<meta name=\"description\" content=\"The Cinema Museum presents a screening of the award winning 2024 British film Vindication Swim, the true story of a remarkable British woman, Mercedes Gleitze, who in 1927 became the first British woman to swim the English Channel. Vindication Swim depicts Mercedes’ upstream struggle in overcoming both the cold waters of the English Channel and [&#8230;]\" />\n\t<meta name=\"generator\" content=\"WordPress 6.4.5\" /> <!-- leave this for stats -->\n\t\n\t<!-- Facebook Open Graph -->\n\t<meta property=\"og:title\" content=\"Screening of Vindication Swim (2024) plus Q&#038;A with director Elliott Hasler &raquo; The Cinema Museum, London\" />\n\t<meta property=\"og:description\" content=\"The Cinema Museum presents a screening of the award winning 2024 British film Vindication Swim, the true story of a remarkable British woman, Mercedes Gleitze, who in 1927 became the first British woman to swim the English Channel. Vindication Swim depicts Mercedes’ upstream struggle in overcoming both the cold waters of the English Channel and [&#8230;]\" />\n\t<meta property=\"og:url\" content=\"http://www.cinemamuseum.org.uk/2024/screening-of-vindication-swim-2024-plus-qa-with-director-elliott-hasler/\" />\n\t<meta property=\"og:image\" content=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication_Swim_Poster.jpg\" />\n\t<meta property=\"og:type\" content=\"article\" />\n\t<meta property=\"og:site_name\" content=\"The Cinema Museum, London\" />\n\t\n\t<link rel=\"shortcut icon\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/favicon.ico\" />\n\t\n\t<link rel=\"stylesheet\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/style.css\" type=\"text/css\" media=\"screen\" />\n\t<link rel=\"stylesheet\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/custom.css\" type=\"text/css\" media=\"screen\" />\n\t<!--[if IE 7]>\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/ie7.css\" media=\"screen\" />\n\t<![endif]-->\n\t<!--[if lte IE 6]>\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/ie6.css\" media=\"screen\" />\n\t<![endif]-->\n\t<link rel=\"stylesheet\" type=\"text/css\" media=\"print\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/print.css\" />\n\n<meta name='robots' content='max-image-preview:large' />\n<script type=\"text/javascript\">\n/* <![CDATA[ */\nwindow._wpemojiSettings = {\"baseUrl\":\"https:\\/\\/s.w.org\\/images\\/core\\/emoji\\/14.0.0\\/72x72\\/\",\"ext\":\".png\