t\t\t\t\r\n\t\t\r\n\t\t</div>\r\n\t\r\n\t\t<div id=\"sidebar\">\r\n\t<ul class=\"sidebar_list\">\r\n\t\t<li id=\"search-3\" class=\"widget widget_search\"><h2 class=\"widgettitle\">Search</h2>\n<form method=\"get\" id=\"search_form\" action=\"http://www.cinemamuseum.org.uk/\">\r\n\t<input type=\"text\" class=\"search_input\" value=\"To search, type and hit enter\" name=\"s\" id=\"s\" onfocus=\"if (this.value == 'To search, type and hit enter') {this.value = '';}\" onblur=\"if (this.value == '') {this.value = 'To search, type and hit enter';}\" />\r\n\t<input type=\"hidden\" id=\"searchsubmit\" value=\"Search\" />\r\n</form>\r\n</li>\n<li id=\"custom_html-5\" class=\"widget_text widget widget_custom_html\"><h2 class=\"widgettitle\">Buy Advance Tickets From Ticketlab</h2>\n<div class=\"textwidget custom-html-widget\"><p class=\"final\"><a href=\"https://ticketlab.co.uk/events/CinemaMuseum\" target=\"_blank\" rel=\"noopener\"><img style=\"border:1px solid teal; height:200px\" \r\nsrc=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2019/08/ticketlab.png\" ></a></p></div></li>\n<li id=\"text-7\" class=\"widget widget_text\"><h2 class=\"widgettitle\">Contact Us</h2>\n\t\t\t<div class=\"textwidget\"><p class=\"final\">The Cinema Museum<br /> \n2 Dugard Way (off Renfrew Road)<br />\nLondon SE11 4TH UK<br />\nTel.: 0207 840 2200<br />\nEmail: <a href=\"mailto:info@cinemamuseum.org.uk\">info@cinemamuseum.org.uk</a></p></div>\n\t\t</li>\n<li id=\"text-6\" class=\"widget widget_text\"><h2 class=\"widgettitle\">Get Twitter updates</h2>\n\t\t\t<div class=\"textwidget\"><p>You can check back here for the latest updates on our event programme - but why not let the Cinema Museum tweet you?</p>\n<p>Start following @CinemaMuseum by visiting our <a href=\"http://twitter.com/CinemaMuseum\" target=\"_blank\" rel=\"noopener\">Twitter page</a>, or by texting follow CinemaMuseum to 86444 (in the UK).</p>\n<p align=\"right\" class=\"final\"><a href=\"http://twitter.com/CinemaMuseum\" target=\"_blank\" rel=\"noopener\"><img src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/images/twitter.png\" alt=\"Twitter logo\" title=\"Follow us on Twitter\"/></a></p> </div>\n\t\t</li>\n<li id=\"addthis_tool_by_class_name_widget-1\" class=\"widget widget_addthis_tool_by_class_name_widget\"><!-- Widget added by an AddThis plugin --><!-- widget name: AddThis Tool --><h2 class=\"widgettitle\">Share this Page</h2>\n<div class=\"addthis_toolbox addthis_default_style \"><a class=\"addthis_button_facebook_like\" fb:like:layout=\"button_count\"></a><a class=\"addthis_button_tweet\"></a><a class=\"addthis_button_pinterest_pinit\"></a><a class=\"addthis_counter addthis_pill_style\"></a></div><!-- End of widget --></li>\n\t</ul>\r\n</div>\t\t\r\n\t</div>\r\n\t\t\r\n<div id=\"footer\">\n\t<div id=\"contact\">\n\t\t<p>The Cinema Museum\n\t\t\t<br />2 Dugard Way, London SE11 4TH\n\t\t\t<br />Tel.: +44 (0)20 7840 2200\n\t\t\t<br />Email:\n\t\t\t<a href=\"mailto:info@cinemamuseum.org.uk\">info@cinemamuseum.org.uk</a>\n\t\t</p>\n\t</div>\n\t<div id=\"copyright\">\n\t\t<p>&copy;\n\t\t\tThe Cinema Museum, London &mdash; Site by Antbird</p>\n\t</div>\n\t<div id=\"social_links\">\n\t\t<a href=\"http://www.facebook.com/pages/London/The-Cinema-Museum/94435861815\" target=\"_blank\">\n\t\t\t<img src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/images/facebook.jpg\" alt=\"Visit The Cinema Museum on Facebook\" title=\"Visit The Cinema Museum on Facebook\"\n\t\t\t/>\n\t\t</a>\n\t\t<a href=\"http://twitter.com/CinemaMuseum\" target=\"_blank\">\n\t\t\t<img src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/images/twitter.png\" alt=\"Follow The Cinema Museum on Twitter\" title=\"Follow The Cinema Museum on Twitter\"\n\t\t\t/>\n\t\t</a>\n\t\t<!-- Removed obsolete items ... PC 2/2/18\n\t\t<a href=\"http://www.youtube.com/user/CinemaMuseum\" target=\"_blank\">\n