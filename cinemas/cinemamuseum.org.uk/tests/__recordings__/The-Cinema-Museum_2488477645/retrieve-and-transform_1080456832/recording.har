n/\" >CAMPAIGN</a></li><li class=\"selected\"><a href=\"http://www.cinemamuseum.org.uk/topics/events/\" >Events</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">The Collection</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/overview/\" >Overview</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/equipment/\" >Equipment</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/publications/\" >Publications</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/cinemas/\" >Cinemas</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/uniforms/\" >Uniforms</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/films/\" >Films</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/advertising/\" >Advertising</a></li></ul></li><li><a href=\"http://www.cinemamuseum.org.uk/shop/\" >Shop</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">About</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/history/\" >History</a></li><li><a href=\"http://www.cinemamuseum.org.uk/visit/\" >Visit Us</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/links/\" >Links</a></li></ul></li></ul>\r\n</div>\r\n<div class=\"sf-blue-after\"></div>\r\n<!-- WP Menubar 5.9.3: end menu main_nav, template Suckerfish_41, CSS sf-blue.css -->\n                <style type=\"text/css\">\n                    @media screen and (-ms-high-contrast: active), (-ms-high-contrast: none) {\n                        /* Like IE9, which support conditional comments, IE10 needs less padding than the IE8 default */\n                        .sf-blue a, .sf-blue a:hover, .sf-blue a:visited { padding: 0 10.8px; }\n                    }\n                </style>\n\t\t<!--[if IE 9]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie9.css\" media=\"screen\" />\n\t\t<![endif]-->\n\t\t<!--[if IE 7]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie7.css\" media=\"screen\" />\n\t\t<![endif]-->\n\n\t</div>\r\n\t<div id=\"content_box\">\r\n\t\t\r\n\t\t<div id=\"content\" class=\"posts\">\r\n\t\t\t\r\n\t\t\t\t\t\r\n<!--\r\n\t\t\t\r\n<div class=\"navigation\">\r\n\t<span class=\"previous\">&larr; <a href=\"http://www.cinemamuseum.org.uk/2025/8th-kennington-bioscope-silent-film-weekend/\" rel=\"prev\">8th Kennington Bioscope Silent Film Weekend</a></span>\r\n\t<span class=\"next\"><a href=\"http://www.cinemamuseum.org.uk/2025/the-live-ghost-tent-quarterly-meeting-of-the-laurel-and-hardy-society-8th-march-2025/\" rel=\"next\">The Live Ghost Tent – Quarterly meeting of The Laurel and Hardy Society 8th March 2025</a> &rarr;</span>\r\n</div>\r\n<div class=\"clear whitespace\"></div>\r\n\r\n-->\r\n\t\t\t\r\n\t\t\t<div id=\"post-34985\" class=\"post-34985 post type-post status-publish format-standard has-post-thumbnail hentry category-events tag-contact\">\r\n\t\t\t\t<div class=\"entry_header\">\r\n<!--\r\n\t\t\t\t\tRC: Comment and Edit functionality removed from following post header. Date reduced to Month and Year. Conditional 'Featured Article' added\r\n-->\r\n\t\t\t\t\t<h2>Kennington Bioscope presents a programme of ‘antiquities’</h2>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<h4>Wed 19 Mar 2025 @ 19:30 \t\t\t\t\t\t\t\t\t\t\t<!-- by David --> &middot; \r\n\t\t\t\t\t<!-- <a href=\"http://www.cinemamuseum.org.uk/2025/kennington-bioscope-presents-a-programme-of-antiquities/#comments\">No Comments</a> &middot; -->\r\n\t\t\t\t\t<a href=\"http://www.cinemamuseum.org.uk/topics/events/\" rel=\"category tag\">Events</a>\t\t\t\t\t<!--  -->\r\n\t\t\t\t\t\t\t\t\t\t</h4>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"entry\">\r\n<!--\r\n\t\t\t\t\tRC: I'm not clear when the_content pagination would be triggered.\r\n\t\t\t\t\tIf triggered, consider changing to plug-in based pagination.\r\n-->\r\n\t\t\t\t\t<div class=\"at-above-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2025/kennington-bioscope-presents-a-programme-of-antiquities/\"></div><p>The Kennington Bioscope is a regular cinema event featuring live accompaniment to silent films that takes place at the Cinema Museum.</p>\n<p><a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Bending-Hur-Roaming-Romeo.png\" target=\"_blank\" rel=\"noopener\" title=\"Bending Hur / Roaming Romeo - click to enlarge\"><img fetchpriority=\"high\" decoding=\"async\" class=\"alignleft wp-image-34989 size-large\" title=\"Bending Hur / Roaming Romeo - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Bending-Hur-Roaming-Romeo-488x377.png\" alt=\"Bending Hur / Roaming Romeo\" width=\"488\" height=\"377\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Bending-Hur-Roaming-Romeo-488x377.png 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Bending-Hur-Roaming-Romeo-300x232.png 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Bending-Hur-Roaming-Romeo-150x116.png 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Bending-Hur-Roaming-Romeo-90x69.png 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Bending-Hur-Roaming-Romeo.png 600w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a>Kennington Bioscope hosts a series of silent films based around Greek and Roman antiquity, presented by Professor Maria Wyke from the Department of Greek and Latin, UCL, London.<span id=\"more-34985\"></span></p>\n<p>There will be a Q &amp; A following the screenings.</p>\n<p>The programme (subject to change) will be:</p>\n<p><strong><em>Visit to Pompeii</em> (1901)</strong>, directed by George A. Smith and Charles Urban, Warwick Trading Company, UK. This British travelogue documents, in long panning shots, the state of the excavations at Pompeii in 1901 and the journey up to Vesuvius in a railway carriage.</p>\n<p><strong><em>Julius Caesar</em> (1908)</strong>. An America version of Shakespeare’s play.</p>\n<p><strong><em>The Private Life of Helen of Troy</em> (1927)</strong>. Two fragments from an America burlesque of the Trojan War, directed by Alexander Korda.</p>\n<p><strong><em>Dans l’Hellade / In Ancient Greece</em></strong> (Pathé Frères, France, 1909). Starring dancer Stacia Napierkowska. Scanned from a 28mm print.</p>\n<p><strong>Interval</strong></p>\n<p><strong><em>The Odyssey / L’Odissea</em> (1911)</strong>, directed by Francesco Bertolini, Adolfo Padovan, and Giuseppe de Liguoro, Milano Films, Italy.</p>\n<p><strong><em>Bending Her / Roaming Romeo</em> (1928)</strong>. Comedy directed by and starring Lupino Lane.</p>\n<p>Live piano accompaniment.</p>\n<p>Silent film with intertitles which may be suitable for the deaf and hard of hearing.</p>\n<h3>Tickets &amp; Pricing</h3>\n<p>£8. Seats are limited, so please arrive early or request an invitation using the email <a href=\"mailto:kenbioscope@gmail.com\">kenbioscope@gmail.com</a>.<br />\n<a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/The-Private-Life-of-Helen-of-Troy.jpg\" target=\"_blank\" rel=\"noopener\" title=\"The Private Life of Helen of Troy - click to enlarge\"><img decoding=\"async\" class=\"alignleft wp-image-34992 size-large\" title=\"The Private Life of Helen of Troy - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/The-Private-Life-of-Helen-of-Troy-488x387.jpg\" alt=\"The Private Life of Helen of Troy\" width=\"488\" height=\"387\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/The-Private-Life-of-Helen-of-Troy-488x387.jpg 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/The-Private-Life-of-Helen-of-Troy-300x238.jpg 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/The-Private-Life-of-Helen-of-Troy-768x609.jpg 768w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/The-Private-Life-of-Helen-of-Troy-1536x1218.jpg 1536w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/The-Private-Life-of-Helen-of-Troy-150x119.jpg 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/The-Private-Life-of-Helen-of-Troy-90x71.jpg 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/The-Private-Life-of-Helen-of-Troy.jpg 1571w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a></p>\n<!-- PHP 5.x --><!-- AddThis Advanced Settings above via filter on the_content --><!-- AddThis Advanced Settings below via filter on the_content --><!-- AddThis Advanced Settings generic via filter on the_content --><!-- AddThis Share Buttons above via filter on the_content --><!-- AddThis Share Buttons below via filter on the_content --><div class=\"at-below-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2025/kennington-bioscope-presents-a-programme-of-antiquities/\"></div><!-- AddThis Share Buttons generic via filter on the_content -->\t\t\t\t\t\t\t\t\t\t<script type='text/javascript'>\r\n\t\t\t\t\t//<![CDATA[\r\n\t\t\t\t\tdocument.write(\"<h4 class='backLink'>[<a href='javascript:history.back()' class='backLink' title='Go back'>&larr; Go back<\\/a>]<\\/h4>\");\r\n\t\t\t\t\t//]]>\r\n\t\t\t\t\t</script>\t\t\t\t\t<noscript><h4 class='backLink'>[<a href=\"\" class='backLink' title='Go back'>&larr; Go back</a>]</h4></noscript>\r\n\t\t\t\t</div>\r\n<!--\r\n\t\t\t\t<p class=\"tagged\"><strong>Tags:</strong> <a href=\"http://www.cinemamuseum.org.uk/tag/contact/\" rel=\"tag\">Contact</a></p>\t\t\t\tRC: Remove tag functionality and replace the 'clear' div with a flatter 'clear flat' one.\r\n-->\t\t\t\t\r\n\t\t\t\t<div class=\"clear flat\"></div>\r\n\t\t\t</div>\r\n\t\t\t\r\n<!--\t\t\r\n\t\t\tRC: Comment functionality remo