assName = this.className.replace(new RegExp(\" wpmhover\\\\b\"), \"\");\r\n\t\t}\r\n\t}\r\n}\r\nif (window.attachEvent) window.attachEvent(\"onload\", wpm1_Hover);\r\n// ]]>\r\n</script>\r\n\r\n<div class=\"sf-blue-before\"></div>\r\n<div id=\"wpm1\" class=\"sf-blue\">\r\n<ul><li><a href=\"http://www.cinemamuseum.org.uk\" >Home</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/news/\" >News</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/campaign/\" >CAMPAIGN</a></li><li class=\"selected\"><a href=\"http://www.cinemamuseum.org.uk/topics/events/\" >Events</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">The Collection</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/overview/\" >Overview</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/equipment/\" >Equipment</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/publications/\" >Publications</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/cinemas/\" >Cinemas</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/uniforms/\" >Uniforms</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/films/\" >Films</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/advertising/\" >Advertising</a></li></ul></li><li><a href=\"http://www.cinemamuseum.org.uk/shop/\" >Shop</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">About</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/history/\" >History</a></li><li><a href=\"http://www.cinemamuseum.org.uk/visit/\" >Visit Us</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/links/\" >Links</a></li></ul></li></ul>\r\n</div>\r\n<div class=\"sf-blue-after\"></div>\r\n<!-- WP Menubar 5.9.3: end menu main_nav, template Suckerfish_41, CSS sf-blue.css -->\n                <style type=\"text/css\">\n                    @media screen and (-ms-high-contrast: active), (-ms-high-contrast: none) {\n                        /* Like IE9, which support conditional comments, IE10 needs less padding than the IE8 default */\n                        .sf-blue a, .sf-blue a:hover, .sf-blue a:visited { padding: 0 10.8px; }\n                    }\n                </style>\n\t\t<!--[if IE 9]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie9.css\" media=\"screen\" />\n\t\t<![endif]-->\n\t\t<!--[if IE 7]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie7.css\" media=\"screen\" />\n\t\t<![endif]-->\n\n\t</div>\r\n\t<div id=\"content_box\">\r\n\t\t\r\n\t\t<div id=\"content\" class=\"posts\">\r\n\t\t\t\r\n\t\t\t\t\t\r\n<!--\r\n\t\t\t\r\n<div class=\"navigation\">\r\n\t<span class=\"previous\">&larr; <a href=\"http://www.cinemamuseum.org.uk/2024/kennington-bioscope-presents-dr-jekyll-and-mr-hyde-1920/\" rel=\"prev\">Kennington Bioscope presents <em>Dr. Jekyll and Mr. Hyde</em> (1920)</a></span>\r\n\t<span class=\"next\"><a href=\"http://www.cinemamuseum.org.uk/2024/exploding-cinema-february/\" rel=\"next\">Exploding Cinema February</a> &rarr;</span>\r\n</div>\r\n<div class=\"clear whitespace\"></div>\r\n\r\n-->\r\n\t\t\t\r\n\t\t\t<div id=\"post-34678\" class=\"post-34678 post type-post status-publish format-standard has-post-thumbnail hentry category-events tag-contact tag-ticketlab\">\r\n\t\t\t\t<div class=\"entry_header\">\r\n<!--\r\n\t\t\t\t\tRC: Comment and Edit functionality removed from following post header. Date reduced to Month and Year. Conditional 'Featured Article' added\r\n-->\r\n\t\t\t\t\t<h2>Screening of <em>Vindication Swim</em> (2024) plus Q&#038;A with director Elliott Hasler</h2>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<h4>Thu 10 Apr 2025 @ 19:30 \t\t\t\t\t\t\t\t\t\t\t<!-- by David --> &middot; \r\n\t\t\t\t\t<!-- <a href=\"http://www.cinemamuseum.org.uk/2024/screening-of-vindication-swim-2024-plus-qa-with-director-elliott-hasler/#comments\">No Comments</a> &middot; -->\r\n\t\t\t\t\t<a href=\"http://www.cinemamuseum.org.uk/topics/events/\" rel=\"category tag\">Events</a>\t\t\t\t\t<!--  -->\r\n\t\t\t\t\t\t\t\t\t\t</h4>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"entry\">\r\n<!--\r\n\t\t\t\t\tRC: I'm not clear when the_content pagination would be triggered.\r\n\t\t\t\t\tIf triggered, consider changing to plug-in based pagination.\r\n-->\r\n\t\t\t\t\t<div class=\"at-above-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2024/screening-of-vindication-swim-2024-plus-qa-with-director-elliott-hasler/\"></div><p><a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication-Swim-2.jpg\" target=\"_blank\" rel=\"noopener\" title=\"Vindication Swim - click to enlarge\"><img fetchpriority=\"high\" decoding=\"async\" class=\"alignleft wp-image-34682 size-large\" title=\"Vindication Swim - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication-Swim-2-488x325.jpg\" alt=\"Vindication Swim\" width=\"488\" height=\"325\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication-Swim-2-488x325.jpg 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication-Swim-2-300x200.jpg 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication-Swim-2-768x512.jpg 768w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication-Swim-2-150x100.jpg 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication-Swim-2-90x60.jpg 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication-Swim-2.jpg 800w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a>The Cinema Museum presents a screening of the award winning 2024 British film <em>Vindication Swim</em>, the true story of a remarkable British woman, Mercedes Gleitze, who in 1927 became the first British woman to swim the English Channel.<span id=\"more-34678\"></span></p>\n<p><em>Vindication Swim</em> depicts Mercedes’ upstream struggle in overcoming both the cold waters of the English Channel and the oppressive society of 1920s England. When a rival comes forward claiming to have accomplished the same feat, Mercedes is forced into battle to retain her record and her legacy.</p>\n<p>The screening will be followed by a Q&amp;A with director Elliott Hasler and producer Simon Hasler, with other participants to be announced.</p>\n<p>Doors open at 18.30, for a 19.30 start.</p>\n<p>Refreshments will be available in our licensed cafe/bar.</p>\n<h3>TICKETS &amp; PRICING</h3>\n<p>Tickets £8.</p>\n<p>Advance tickets may be purchased from <a href=\"https://ticketlab.co.uk/event/id/29261\" target=\"_blank\" rel=\"noopener noreferrer\">Ticketlab</a>, or direct from the Museum by calling 020 7840 2200 in office hours.<br />\n<a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication-Swim-3.jpg\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Vindication Swim - click to enlarge\"><img decoding=\"async\" class=\"alignleft wp-image-34683 size-large\" title=\"Vindication Swim - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication-Swim-3-488x325.jpg\" alt=\"Vindication Swim\" width=\"488\" height=\"325\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication-Swim-3-488x325.jpg 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication-Swim-3-300x200.jpg 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication-Swim-3-768x512.jpg 768w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication-Swim-3-150x100.jpg 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication-Swim-3-90x60.jpg 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2024/12/Vindication-Swim-3.jpg 800w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a></p>\n<!-- PHP 5.x --><!-- AddThis Advanced Settings above via filter on the_content --><!-- AddThis Advanced Settings below via filter on the_content --><!-- AddThis Advanced Settings generic via filter on the_content --><!-- AddThis Share Buttons above via filter on the_content --><!-- AddThis Share Buttons below via filter on the_content --><div class=\"at-below-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2024/screening-of-vindication-swim-2024-plus-qa-with-director-elliott-hasler/\"></div><!-- AddThis Share Buttons generic via filter on the_content -->\t\t\t\t\t\t\t\t\t\t<script type='text/javascript'>\r\n\t\t\t\t\t//<![CDATA[\r\n\t\t\t\t\tdocument.write(\"<h4 class='backLink'>[<a href='javascript:history.back()' class='backLink' title='Go back'>&larr; Go back<\\/a>]<\\/h4>\");\r\n\t\t\t\t\t//]]>\r\n\t\t\t\t\t</script>\t\t\t\t\t<noscript><h4 class='backLink'>[<a href=\"\" class='backLink' title='Go back'>&larr; Go back</a>]</h4></noscript>\r\n\t\t\t\t</div>\r\n<!--\r\n\t\t\t\t<p class=\"tagged\"><strong>Tags:</strong> <a href=\"http://www.cinemamuseum.org.uk/tag/contact/\" rel=\"tag\">Contact</a>&middot;<a href=\"http://www.cinemamuseum.org.uk/tag/ticketlab/\" rel=\"tag\">TicketLab</a></p>\t\t\t\tRC: Remove tag functionality and replace the 'clear' div with a flatter 'clear flat' one.\r\n-->\t\t\t\t\r\n\t\t\t\t<div class=\"clear flat\"></div>\r\n\t\t\t</div>\r\n\t\t\t\r\n<!--\t\t\r\n\t\t\tRC: Comment functionality removed. (IE8 fails to see this as comment, so commented the php also.)\r\n\t\t\t-->\r\n\t\t\t\r\n\t\t\t\t\r\n\t\t</div>\r\n\t\t\r\n\t\t<div id=\"sidebar\">\r\n\t<ul class=\"sidebar_list\">\r\n\t\t<li id=\"search-3\" class=\"widget widget_search\"><h2 class=\"widgettitle\">Search</h2>\n<form method=\"get\" id=\"search_form\" action=\"http://www.cinemamuseum.org.uk/\">\r\n\t<input