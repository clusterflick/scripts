                          if (Array.isArray(window.addthis_layers_tools)) {\n                            for (i = 0; i < window.addthis_layers_tools.length; i++) {\n                              window.addthis.layers(window.addthis_layers_tools[i]);\n                            }\n                          }\n                        }\n                     },1000)\n                    }());\n                </script> <script data-cfasync=\"false\" type=\"text/javascript\" src=\"https://s7.addthis.com/js/300/addthis_widget.js#pubid=ra-4dbbcf4b502a51ae\" async=\"async\"></script></head>\n\n<body class=\"custom\">\n\n<div id=\"container\">\n\t\n\t<div id=\"header_img\">\n\t\t<a href=http://www.cinemamuseum.org.uk><img src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/themes/Cutline-1-1.4-2ColumnRight/images/cm_header.jpg\" width=\"770\" alt=\"The Cinema Museum, London\" title=\"The Cinema Museum, London\" /></a>\n\t</div>\n\t<div id=\"main_nav\">\n\t\t<!-- WP Menubar 5.9.3: start menu main_nav, template Suckerfish_41, CSS sf-blue.css -->\n\r\n<script type=\"text/javascript\">\r\n// <![CDATA[\r\n\twpm1_Hover = function() {\r\n\tvar wpmEls = document.getElementById(\"wpm1\").getElementsByTagName(\"li\");\r\n\tfor (var i=0; i<wpmEls.length; i++) {\r\n\t\twpmEls[i].onmouseover = function() {\r\n\t\t\tthis.className += \" wpmhover\";\r\n\t\t}\r\n\t\twpmEls[i].onmouseout = function() {\r\n\t\t\tthis.className = this.className.replace(new RegExp(\" wpmhover\\\\b\"), \"\");\r\n\t\t}\r\n\t}\r\n}\r\nif (window.attachEvent) window.attachEvent(\"onload\", wpm1_Hover);\r\n// ]]>\r\n</script>\r\n\r\n<div class=\"sf-blue-before\"></div>\r\n<div id=\"wpm1\" class=\"sf-blue\">\r\n<ul><li><a href=\"http://www.cinemamuseum.org.uk\" >Home</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/news/\" >News</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/campaign/\" >CAMPAIGN</a></li><li class=\"selected\"><a href=\"http://www.cinemamuseum.org.uk/topics/events/\" >Events</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">The Collection</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/overview/\" >Overview</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/equipment/\" >Equipment</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/publications/\" >Publications</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/cinemas/\" >Cinemas</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/uniforms/\" >Uniforms</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/films/\" >Films</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/collection/advertising/\" >Advertising</a></li></ul></li><li><a href=\"http://www.cinemamuseum.org.uk/shop/\" >Shop</a></li><li class=\"sf-drop-indicator\"><a style=\"cursor:default;\" href=\"javascript:void(0)\">About</a><ul><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/history/\" >History</a></li><li><a href=\"http://www.cinemamuseum.org.uk/visit/\" >Visit Us</a></li><li><a href=\"http://www.cinemamuseum.org.uk/topics/about/links/\" >Links</a></li></ul></li></ul>\r\n</div>\r\n<div class=\"sf-blue-after\"></div>\r\n<!-- WP Menubar 5.9.3: end menu main_nav, template Suckerfish_41, CSS sf-blue.css -->\n                <style type=\"text/css\">\n                    @media screen and (-ms-high-contrast: active), (-ms-high-contrast: none) {\n                        /* Like IE9, which support conditional comments, IE10 needs less padding than the IE8 default */\n                        .sf-blue a, .sf-blue a:hover, .sf-blue a:visited { padding: 0 10.8px; }\n                    }\n                </style>\n\t\t<!--[if IE 9]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie9.css\" media=\"screen\" />\n\t\t<![endif]-->\n\t\t<!--[if IE 7]>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/plugins/menubar-templates/menubar-ie7.css\" media=\"screen\" />\n\t\t<![endif]-->\n\n\t</div>\r\n\t<div id=\"content_box\">\r\n\t\t\r\n\t\t<div id=\"content\" class=\"posts\">\r\n\t\t\t\r\n\t\t\t\t\t\r\n<!--\r\n\t\t\t\r\n<div class=\"navigation\">\r\n\t<span class=\"previous\">&larr; <a href=\"http://www.cinemamuseum.org.uk/2025/women-and-cocaine-presents-platinum-blonde-1931/\" rel=\"prev\">Women and Cocaine presents <em>Platinum Blonde</em> (1931)</a></span>\r\n\t<span class=\"next\"><a href=\"http://www.cinemamuseum.org.uk/2025/women-and-cocaine-presents-42nd-street-1933/\" rel=\"next\">Women and Cocaine presents <em>42nd Street</em> (1933)</a> &rarr;</span>\r\n</div>\r\n<div class=\"clear whitespace\"></div>\r\n\r\n-->\r\n\t\t\t\r\n\t\t\t<div id=\"post-34943\" class=\"post-34943 post type-post status-publish format-standard has-post-thumbnail hentry category-events tag-contact tag-ticketlab\">\r\n\t\t\t\t<div class=\"entry_header\">\r\n<!--\r\n\t\t\t\t\tRC: Comment and Edit functionality removed from following post header. Date reduced to Month and Year. Conditional 'Featured Article' added\r\n-->\r\n\t\t\t\t\t<h2>Women and Cocaine presents <em> Safe in Hell</em> (1931)</h2>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<h4>Thu 27 Nov 2025 @ 19:30 \t\t\t\t\t\t\t\t\t\t\t<!-- by David --> &middot; \r\n\t\t\t\t\t<!-- <a href=\"http://www.cinemamuseum.org.uk/2025/women-and-cocaine-presents-safe-in-hell-1931/#comments\">No Comments</a> &middot; -->\r\n\t\t\t\t\t<a href=\"http://www.cinemamuseum.org.uk/topics/events/\" rel=\"category tag\">Events</a>\t\t\t\t\t<!--  -->\r\n\t\t\t\t\t\t\t\t\t\t</h4>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"entry\">\r\n<!--\r\n\t\t\t\t\tRC: I'm not clear when the_content pagination would be triggered.\r\n\t\t\t\t\tIf triggered, consider changing to plug-in based pagination.\r\n-->\r\n\t\t\t\t\t<div class=\"at-above-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2025/women-and-cocaine-presents-safe-in-hell-1931/\"></div><p><a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Safe-in-Hell-2.jpg\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Safe in Hell - click to enlarge\"><img fetchpriority=\"high\" decoding=\"async\" class=\"alignleft wp-image-34946 size-large\" title=\"Safe in Hell - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Safe-in-Hell-2-488x367.jpg\" alt=\"Safe in Hell\" width=\"488\" height=\"367\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Safe-in-Hell-2-488x367.jpg 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Safe-in-Hell-2-300x225.jpg 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Safe-in-Hell-2-150x113.jpg 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Safe-in-Hell-2-90x68.jpg 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Safe-in-Hell-2-100x75.jpg 100w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Safe-in-Hell-2.jpg 727w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a>Dorothy Mackaill plays Gilda Carlson, a fiery and resourceful woman fleeing to a Caribbean island after being framed for murder. Surrounded by dangerous exiles and corrupt officials, Gilda fights for survival while awaiting her sailor fiancé, in this gritty pre-Code thriller of passion and peril. Directed by William Wellman.</p>\n<p>The film will be preceded by a short introduction, and followed by a raffle.</p>\n<p>Women and Cocaine Presents is a film night presented by curator Caroline Cassin at The Cinema Museum to celebrate the fierce and liberated women of Pre code cinema. From the period of 1930 to 1934, before the introduction of censorship, women were depicted in roles with a frankness and sex-positivity that remains rare even today. These newly independent women pushed gender boundaries as they pursued their own economic freedom and excitement, defying the previous Victorian ideals of domesticity, sexual purity and religion. Hollywood soon caught on and began to represent these women on screen, and each month we celebrate a different woman from that era.<br />\n“My father warned me about men &amp; booze, but he never mentioned a word about women &amp; cocaine” – Tallulah Bankhead.</p>\n<p>Follow Women &amp; Cocaine on <a href=\"https://www.instagram.com/womenandc/\" target=\"_blank\" rel=\"noopener noreferrer\">Instagram</a> and <a href=\"https://www.facebook.com/WandCpresents/\" target=\"_blank\" rel=\"noopener noreferrer\">Facebook</a>.</p>\n<p>Doors open at 18.30, for a 19.30 start.</p>\n<p>Refreshments will be available in our licensed cafe/bar.</p>\n<p>Seating is unallocated. There are a few disabled parking spaces directly outside the main door of the venue &#8211; please contact us to let us know if you need one. Service dogs welcome. Unfortunately, this film screening does not have closed captions or audio description available.<br />\nContact Us: Please contact us if you have any additional requirements.</p>\n<h3>TICKETS &amp; PRICING</h3>\n<p>Tickets: £8.<br />\nAdvance tickets may be purchased from <a href=\"https://ticketlab.co.uk/event/id/29823\" target=\"_blank\" rel=\"noopener noreferrer\">Ticketlab</a>, or direct from the Museum by calling 020 7840 2200 in office hours. Tickets will also be available on the door on the night. Concessions available on the door with valid ID.<br />\n<a href=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Safe-in-Hell-1.jpg\" target=\"_blank\" rel=\"noopener\" title=\"Safe in Hell - click to enlarge\"><img decoding=\"async\" class=\"alignleft wp-image-34945 size-large\" title=\"Safe in Hell - click to enlarge\" src=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Safe-in-Hell-1-488x317.jpg\" alt=\"Safe in Hell\" width=\"488\" height=\"317\" srcset=\"http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Safe-in-Hell-1-488x317.jpg 488w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Safe-in-Hell-1-300x195.jpg 300w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Safe-in-Hell-1-150x98.jpg 150w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Safe-in-Hell-1-90x59.jpg 90w, http://www.cinemamuseum.org.uk/wordpress/wp-content/uploads/2025/01/Safe-in-Hell-1.jpg 600w\" sizes=\"(max-width: 488px) 100vw, 488px\" /></a></p>\n<!-- PHP 5.x --><!-- AddThis Advanced Settings above via filter on the_content --><!-- AddThis Advanced Settings below via filter on the_content --><!-- AddThis Advanced Settings generic via filter on the_content --><!-- AddThis Share Buttons above via filter on the_content --><!-- AddThis Share Buttons below via filter on the_content --><div class=\"at-below-post addthis_tool\" data-url=\"http://www.cinemamuseum.org.uk/2025/women-and-cocaine-presents-safe-in-hell-1931/\"></div><!-- AddThis Share Buttons generic via filter on the_content -->\t\t\t\t\t\t\t\t\t\t<script type='text/javascript'>\r\n\t\t\t\t\t//<![CDATA[\r\n\t\t\t\t\tdocument.write(\"<h4 class='backLink'>[<a href='javascript:history.back()' class='backLink' title='Go back'>&larr; Go back<\\/a>]<\\/h4>\");\r\n\t\t\t\t\t//]]>\r\n\t\t\t\t\t</script>\t\t\t\t\t<noscript><h4 class='backLink'>[<a href=\"\" class='backLink' title='Go back'>&larr; Go back</a>]</h4></noscript>\r\n\t\t\t\t</div>\r\n<!--\r\n\t\t\t\t<p class=\"tagged\"><strong>Tags:</strong> <a href=\"http://www.cinemamuseum.org.uk/tag/contact/\" rel=\"tag\">Contact</a>&middot;<a href=\"http://www.cinemamuseum.org.uk/tag/ticketlab/\" rel=\"tag\">TicketLab</a></p>\t\t\t\tRC: Remove tag functionality and replace the 'clear' div with a flatter 'clear flat' one.\r\n-->\t\t\t\t\r\n\t\t\t\t<div class=\"clear flat\"></div>\r\n\t\t\t</div>\r\n\t\t\t\r\n<!--\t\t\r\n\t\t\tRC: Comment functionality removed. (IE8 fail