 viewBox=\"0 0 15 15\" xmlns=\"http://www.w3.org/2000/svg\">\n\t<circle cx=\"7.5\" cy=\"7.5\" r=\"7.5\"></circle>\n</svg>\n\t</div>\n</div>\n\n\t\t<script type=\"application/ld+json\">\n[{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Bande \\u00e0 part (1964)\",\"description\":\"&lt;p&gt;Jean-Luc Godard\\\\'s comedy-dance-crime pastiche &lt;em&gt;Bande \\u00e0 part&lt;/em&gt; (1964). &quot;All you need to make a movie is a girl and a gun&quot;, according to Godard. Add some amazing dancing, a love triangle and criminals so inept you can\\\\'t help feeling sorry for them, and you get this classic early Godard.&lt;/p&gt;\\\\n\",\"image\":\"https://cinemamuseum.org.uk/wp-content/uploads/2026/03/Bande-a-part-poster.jpg\",\"url\":\"https://cinemamuseum.org.uk/scheduled/bande-a-part-1964/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-07-12T14:00:00+01:00\",\"endDate\":\"2026-07-12T17:00:00+01:00\",\"offers\":{\"@type\":\"Offer\",\"price\":\"10\",\"priceCurrency\":\"GBP\",\"url\":\"https://cinemamuseum.org.uk/scheduled/bande-a-part-1964/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-03-16T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Booksmart (2019)\",\"description\":\"&lt;p&gt;On the eve of their high school graduation, Amy and Molly, two overachieving best friends, realise they\\\\'ve spent too much time studying and not enough partying. Determined to make up for lost time, they attempt to cram four years of experiences into one unforgettable night.&lt;/p&gt;\\\\n\",\"image\":\"https://cinemamuseum.org.uk/wp-content/uploads/2026/07/Booksmart-poster.jpg\",\"url\":\"https://cinemamuseum.org.uk/scheduled/booksmart-2019/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-07-14T19:30:00+01:00\",\"endDate\":\"2026-07-14T19:30:00+01:00\",\"offers\":{\"@type\":\"Offer\",\"price\":\"10\",\"priceCurrency\":\"GBP\",\"url\":\"https://cinemamuseum.org.uk/scheduled/booksmart-2019/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-07-02T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"He Ran All the Way (1951)\",\"description\":\"&lt;p&gt;Nick Robey and his partner Al stage a payroll holdup. Al is shot, and Nick kills a policeman. Nick hides out at a public pool, where he meets Peg Dobbs, a bakery worker. She takes him back to her apartment, and he forces her family at gunpoint to hide him from the police manhunt.&lt;/p&gt;\\\\n\",\"image\":\"https://cinemamuseum.org.uk/wp-content/uploads/2026/05/He-Ran-All-the-Way-poster-scaled.jpg\",\"url\":\"https://cinemamuseum.org.uk/scheduled/he-ran-all-the-way-1951/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-07-15T19:30:00+01:00\",\"endDate\":\"2026-07-15T19:30:00+01:00\",\"offers\":{\"@type\":\"Offer\",\"price\":\"10\",\"priceCurrency\":\"GBP\",\"url\":\"https://cinemamuseum.org.uk/scheduled/he-ran-all-the-way-1951/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-05-26T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Italy Through its Cinema: Umberto D. (1952)\",\"description\":\"&lt;p&gt;An elderly pensioner in Rome battles poverty and loneliness, clinging to dignity and companionship as he faces eviction and despair.&lt;/p&gt;\\\\n\",\"image\":\"https://cinemamuseum.org.uk/wp-content/uploads/2026/04/Umberto-D-Poster.jpg\",\"url\":\"https://cinemamuseum.org.uk/scheduled/italy-through-its-cinema-umberto-d-1952/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-07-16T19:30:00+01:00\",\"endDate\":\"2026-07-16T19:30:00+01:00\",\"offers\":{\"@type\":\"Offer\",\"price\":\"10\",\"priceCurrency\":\"GBP\",\"url\":\"https://cinemamuseum.org.uk/scheduled/italy-through-its-cinema-umberto-d-1952/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-04-16T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Street Scene (1931)\",\"description\":\"&lt;p&gt;On a sweltering summer day in a Hell\\u2019s Kitchen tenement, neighbours gather to argue and gossip as whispers of an illicit affair spread. Directed by King Vidor and starring Sylvia Sidney, this fascinating early sound drama uniquely captures the humanity of lives lived in close quarters.&lt;/p&gt;\\\\n\",\"image\":\"https://cinemamuseum.org.uk/wp-content/uploads/2026/03/Street-Scene-poster.jpg\",\"url\":\"https://cinemamuseum.org.uk/scheduled/street-scene-1931/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-07-17T19:30:00+01:00\",\"endDate\":\"2026-07-17T19:30:00+01:00\",\"offers\":{\"@type\":\"Offer\",\"price\":\"10\",\"priceCurrency\":\"GBP\",\"url\":\"https://cinemamuseum.org.uk/scheduled/street-scene-1931/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-03-29T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"80 Years of Martin and Lewis: The Caddy (1953)\",\"description\":\"&lt;p&gt;July 2026 marks eighty years since the formation of Martin and Lewis, and seventy years since their break up, exactly a decade later. It\\u2019s difficult to overstate their success in this period; at the height of their fame in the early fifties, the pair were a showbiz phenomenon who incited levels of hysteria reserved in popular memory for fans of Elvis or The Beatles. The Martin and Lewis empire spread everywhere: from the nightclub scene where they originated into television, radio, comics and, of course, Hollywood.&lt;/p&gt;\\\\n\",\"image\":\"https://cinemamuseum.org.uk/wp-content/uploads/2026/05/The-Caddy-Poster.png\",\"url\":\"https://cinemamuseum.org.uk/scheduled/80-years-of-martin-and-lewis-the-caddy-1953/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-07-22T19:30:00+01:00\",\"endDate\":\"2026-07-22T19:30:00+01:00\",\"offers\":{\"@type\":\"Offer\",\"price\":\"10\",\"priceCurrency\":\"GBP\",\"url\":\"https://cinemamuseum.org.uk/scheduled/80-years-of-martin-and-lewis-the-caddy-1953/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-05-25T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Sir Henry at Rawlinson End (1980)\",\"description\":\"&lt;p&gt;Vivian Stanshall\\\\'s gothic bioscopic. A stunningly created sepia world with joyous dialogue, amazing characters, Trevor Howard in his best, or certainly most fun role. Unlike anything else that you\\\\'ll experience.&lt;/p&gt;\\\\n\",\"image\":\"https://cinemamuseum.org.uk/wp-content/uploads/2026/02/Sir-Henry-at-Rawlinson-End-poster.jpg\",\"url\":\"https://cinemamuseum.org.uk/scheduled/sir-henry-at-rawlinson-end-1980/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-07-25T19:30:00+01:00\",\"endDate\":\"2026-07-25T19:30:00+01:00\",\"offers\":{\"@type\":\"Offer\",\"price\":\"10\",\"priceCurrency\":\"GBP\",\"url\":\"https://cinemamuseum.org.uk/scheduled/sir-henry-at-rawlinson-end-1980/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-02-11T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Ammonite (2020)\",\"description\":\"&lt;p&gt;In 1840s England, overlooked fossil hunter Mary Anning (Kate Winslet) ekes out a living on the rugged southern coast. When she\\\\'s hired to care for Charlotte Murchison (Saoirse Ronan), the wife of a wealthy visitor, their initial friction gives way to an intense and transformative relationship that challenges the boundaries of class and convention.&lt;/p&gt;\\\\n\",\"image\":\"https://cinemamuseum.org.uk/wp-content/uploads/2026/07/Ammonite-poster.jpg\",\"url\":\"https://cinemamuseum.org.uk/scheduled/ammonite-2020/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-07-29T19:30:00+01:00\",\"endDate\":\"2026-07-29T19:30:00+01:00\",\"offers\":{\"@type\":\"Offer\",\"price\":\"10\",\"priceCurrency\":\"GBP\",\"url\":\"https://cinemamuseum.org.uk/scheduled/ammonite-2020/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-07-06T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"UK Premiere of Jimmy Somerville &#8211; Queer Rebel of English Pop (2025)\",\"description\":\"&lt;p&gt;ACT UP London and friends invite you to the UK premiere of ARTE\\\\'s &lt;em&gt;Jimmy Somerville - Queer Rebel of English Pop&lt;/em&gt; (2025), awarded the SACEM Award for Best Documentary 2025. With his 1984 hit &quot;Smalltown Boy&quot;, Jimmy Somerville hit the bigtime and became the voice of the gay movement in Britain.&lt;/p&gt;\\\\n\",\"image\":\"https://cinemamuseum.org.uk/wp-content/uploads/2026/04/Jimmy-Somerville-poster.jpg\",\"url\":\"https://cinemamuseum.org.uk/scheduled/uk-premiere-of-jimmy-somerville-queer-rebel-of-english-pop-2025/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-08-28T18:30:00+01:00\",\"endDate\":\"2026-08-28T18:30:00+01:00\",\"offers\":{\"@type\":\"Offer\",\"price\":\"10 \\u2013 20\",\"priceCurrency\":\"GBP\",\"url\":\"https://cinemamuseum.org.uk/scheduled/uk-premiere-of-jimmy-somerville-queer-rebel-of-english-pop-2025/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2026-04-17T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Under the Silver Lake (2018)\",\"description\":\"&lt;p&gt;A drifting LA slacker hunts for his missing neighbour through conspiratorial clues, in a neo\\u2011noir that feels like a millennial Mulholland Drive.&lt;/p&gt;\\\\n\",\"image\":\"https://cinemamuseum.org.uk/wp-content/uploads/2025/12/Under-the-Silver-Lake-poster.jpg\",\"url\":\"https://cinemamuseum.org.uk/scheduled/under-the-silver-lake-2018/\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"startDate\":\"2026-09-04T19:00:00+01:00\",\"endDate\":\"2026-09-04T19:00:00+01:00\",\"offers\":{\"@type\":\"Offer\",\"price\":\"12\",\"priceCurrency\":\"GBP\",\"url\":\"https://cinemamuseum.org.uk/scheduled/under-the-silver-lake-2018/\",\"category\":\"primary\",\"availability\":\"inStock\",\"validFrom\":\"2025-12-14T00:00:00+00:00\"},\"performer\":\"Organization\"},{\"@context\":\"http://schema.org\",\"@type\":\"Event\",\"name\":\"Emperor Nero and the Spectacle of Ancient Rome &#8211; Quo Vadis? (1913)\",\"description\":\"&lt;p&gt;Kennington Bioscope hosts the celebrated Italian feature film about Nero and the burning of Rome - Quo Vadis? (1913) - as well as a varied programme of shorts set in ancient Rome. They will be presented by Professor Maria Wyke from the Department of Greek and Latin, UCL, London.&lt;/p&gt;\\\\n\",\"image\":\"https://cinemamuseum.org.uk/wp-content/uploads/2026/07/Quo-Vadis-poster.jpg\",\"url\":\"https://cinemamuseum.org.uk/scheduled/emperor-nero-and-the-spectacle-of-ancient-rome-quo-vadis-1913/\",\"eventA