ington-bioscope/\">here.</a></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\n\t\t<!-- Event categories end-->\n\n\t\t\t\n\t<!-- Event footer -->\n\t<div id=\"tribe-events-footer\">\n\t\t<!-- Navigation -->\n\t\t<nav class=\"tribe-events-nav-pagination\" aria-label=\"Event Navigation\">\n\t\t\t<ul class=\"tribe-events-sub-nav\">\n\t\t\t\t<li class=\"tribe-events-nav-previous\"><a href=\"https://cinemamuseum.org.uk/scheduled/under-the-silver-lake-2018/\"><span>«</span> Under the Silver Lake (2018)</a></li>\n\t\t\t\t<li class=\"tribe-events-nav-next\"><a href=\"https://cinemamuseum.org.uk/scheduled/the-live-ghost-tent-quarterly-meeting-september-2026/\">The Live Ghost Tent – Quarterly Meeting September 2026 <span>»</span></a></li>\n\t\t\t</ul>\n\t\t\t<!-- .tribe-events-sub-nav -->\n\t\t</nav>\n\t</div>\n\t<!-- #tribe-events-footer -->\n\n</div><!-- #tribe-events-content -->\n<div class=\"tribe-events-after-html\"></div>\n<!--\nThis calendar is powered by The Events Calendar.\nhttp://evnt.is/18wn\n-->\n</section></div>\n</div>\n</main>\n\n\n<footer class=\"wp-block-template-part\">\n<div class=\"wp-block-group is-style-section-1 has-global-padding is-layout-constrained wp-block-group-is-layout-constrained is-style-section-1--6\" style=\"padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--50)\">\n<div class=\"wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group alignfull tw-sm-justify-center is-content-justification-space-between is-layout-flex wp-container-core-group-is-layout-b00a0784 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-d0b3c9c8 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-vertically-aligned-top tw-stretched-link is-layout-flow wp-container-core-column-is-layout-47e5a185 wp-block-column-is-layout-flow\" style=\"flex-basis:100%\"><div class=\"aligncenter wp-block-site-logo\"><a 