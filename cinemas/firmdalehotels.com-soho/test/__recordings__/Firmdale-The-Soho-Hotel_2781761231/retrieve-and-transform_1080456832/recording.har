ener noreferrer\">\n                                    <span class=\"visually-hidden\">instagram</span>\n                                </a>\n                            </li>\n                            <li class=\"social-links__item\">\n                                <a href=\"https://www.facebook.com/FirmdaleHotels/\" class=\"social-links__item-link social-links__item-link--facebook\" title=\"facebook\" target=\"_blank\" rel=\"noopener noreferrer\">\n                                    <span class=\"visually-hidden\">facebook</span>\n                                </a>\n                            </li>\n                            <li class=\"social-links__item\">\n                                <a href=\"https://uk.linkedin.com/company/firmdale-hotels-plc\" class=\"social-links__item-link social-links__item-link--linkedin\" title=\"linkedin\" target=\"_blank\" rel=\"noopener noreferrer\">\n                                    <span class=\"visually-hidden\">linkedin</span>\n                                </a>\n                            </li>\n                    </ul>\n                </div>\n        </div>\n    <div class=\"primary-footer__links\">\n        <ul class=\"primary-footer__links-list constrain\">\n            <li class=\"primary-footer__links-list-item\">\n                <button class=\"unbutton primary-footer__links-list-item-actual js-osano-trigger\">\n                    Cookie Settings\n                </button>\n            </li>\n                    <li class=\"primary-footer__links-list-item\">\n                        <a class=\"primary-footer__links-list-item-actual\" href=\"/contact-us\">Contact Us</a>\n                    </li>\n                    <li class=\"primary-footer__links-list-item\">\n                        <a class=\"primary-footer__links-list-item-actual\" href=\"/responsibility\">Responsibility</a>\n                    </li>\n                    <li class=\"primary-footer__links-list-item\">\n                     