/webp\" />\r\n<source srcset=\"/media/e5snuc22/the-mastermind.jpg?width=960&format=webp&v=1dc42835f0feb20\" media=\"(min-width: 1440px)\" type=\"image/webp\" />\r\n<source srcset=\"/media/e5snuc22/the-mastermind.jpg?width=960&format=webp&v=1dc42835f0feb20\" media=\"(min-width: 1280px)\" type=\"image/webp\" />\r\n<source srcset=\"/media/e5snuc22/the-mastermind.jpg?width=720&format=webp&v=1dc42835f0feb20\" media=\"(min-width: 980px)\" type=\"image/webp\" />\r\n<source srcset=\"/media/e5snuc22/the-mastermind.jpg?width=980&format=webp&v=1dc42835f0feb20\" media=\"(min-width: 768px)\" type=\"image/webp\" />\r\n<source srcset=\"/media/e5snuc22/the-mastermind.jpg?width=425&format=webp&v=1dc42835f0feb20\" media=\"(min-width: 375px)\" type=\"image/webp\" />\r\n<source srcset=\"/media/e5snuc22/the-mastermind.jpg?width=375&format=webp&v=1dc42835f0feb20\"  type=\"image/webp\" />\r\n<source srcset=\"/media/e5snuc22/the-mastermind.jpg?width=960&v=1dc42835f0feb20\" media=\"(min-width: 1920px)\" />\r\n<source srcset=\"/media/e5snuc22/the-mastermind.jpg?width=960&v=1dc42835f0feb20\" media=\"(min-width: 1440px)\" />\r\n<source srcset=\"/media/e5snuc22/the-mastermind.jpg?width=960&v=1dc42835f0feb20\" media=\"(min-width: 1280px)\" />\r\n<source srcset=\"/media/e5snuc22/the-mastermind.jpg?width=720&v=1dc42835f0feb20\" media=\"(min-width: 980px)\" />\r\n<source srcset=\"/media/e5snuc22/the-mastermind.jpg?width=980&v=1dc42835f0feb20\" media=\"(min-width: 768px)\" />\r\n<source srcset=\"/media/e5snuc22/the-mastermind.jpg?width=425&v=1dc42835f0feb20\" media=\"(min-width: 375px)\" />\r\n<source srcset=\"/media/e5snuc22/the-mastermind.jpg?width=375&v=1dc42835f0feb20\"  />\r\n<img alt=\"Still from &#x27;The Mastermind&#x27;. A bearded man dressed smartly, stands in front of an oil painting in an art gallery.\" src=\"/media/e5snuc22/the-mastermind.jpg?width=375&amp;v=1dc42835f0feb20\" loading=\"lazy\" decoding=\"async\" fetchpriority=\"low\" class=\"video-block__img js-video-with-facade-img\" /></picture>\n                </a>\n            <iframe title=\"Embedded video\" class=\"embed__source js-video-with-facade-iframe\" data-src=\"https://www.youtube-nocookie.com/embed/AWokrf6yeEU?autoplay=1\" allow=\"autoplay\" width=\"960\" height=\"540\" frameborder=\"0\" allowfullscreen loading=\"lazy\" aria-hidden=\"true\" tabindex=\"-1\"></iframe>\n        </div>\n    </div>\n\n                </div>\n                <div class=\"block column-span column-span--6\" data-area-col-span=\"6\" style=\"--blockStackingOrder:0\">\n                    \n\n\n\n    <div class=\"group group--h-align-left group--v-gutter-default\">\n        \n\n\n                <div class=\"block column-span column-span--12\" data-area-col-span=\"12\" style=\"--blockStackingOrder:0\">\n                    \n\n\n\n    <div class=\"text-block shared-styles js-add-wrapper\" data-wrap=\"table\" data-wrap-class=\"table-scroll\">\n        <h2 class=\"heading--h3\">The Mastermind</h2>\n<p>In 1970, Mooney and two cohorts wander into a museum in broad daylight and steal four paintings. When holding onto the art proves more difficult than stealing them, Mooney is relegated to a life on the run.</p>\n<p>Stars Josh O'Connor, Sterling Thompson, Alana Haim<br><em>(Certification 12A)</em></p>\n<ul>\n<li><a rel=\"noopener\" href=\"https://www.sevenrooms.com/reservations/brasseriemax?default_date=2025-11-22&amp;default_time=8:00PM&amp;client_id=eef1eb6d014da2137338193d5cb8bc64cbb27f83f1f5c8570f52e86fbd3392f58eb28c93a196e83af2deeefe08b291d306ef24fc2f649a48381ccf66dd7ff805\" target=\"_blank\" data-anchor=\"?default_date=2025-11-22&amp;default_time=8:00PM&amp;client_id=eef1eb6d014da2137338193d5cb8bc64cbb27f83f1f5c8570f52e86fbd3392f58eb28c93a196e83af2deeefe08b291d306ef24fc2f649a48381ccf66dd7ff805\">COVENT GARDEN HOTEL - SATURDAY 22ND NOVEMBER, 8PM</a></li>\n<li><a rel=\"noopener\" href=\"https://www.sevenrooms.com/reservations/refuelbarandrestaurant?default_date=2025-11-30&amp;default_time=3:30PM&amp;client_id=41