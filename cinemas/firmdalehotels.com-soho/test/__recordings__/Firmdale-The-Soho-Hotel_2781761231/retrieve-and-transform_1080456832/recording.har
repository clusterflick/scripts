sri2/blue-moon.jpg?width=960&v=1dc4a5ecc2106d0\" media=\"(min-width: 1920px)\" />\r\n<source srcset=\"/media/45knsri2/blue-moon.jpg?width=960&v=1dc4a5ecc2106d0\" media=\"(min-width: 1440px)\" />\r\n<source srcset=\"/media/45knsri2/blue-moon.jpg?width=960&v=1dc4a5ecc2106d0\" media=\"(min-width: 1280px)\" />\r\n<source srcset=\"/media/45knsri2/blue-moon.jpg?width=720&v=1dc4a5ecc2106d0\" media=\"(min-width: 980px)\" />\r\n<source srcset=\"/media/45knsri2/blue-moon.jpg?width=980&v=1dc4a5ecc2106d0\" media=\"(min-width: 768px)\" />\r\n<source srcset=\"/media/45knsri2/blue-moon.jpg?width=425&v=1dc4a5ecc2106d0\" media=\"(min-width: 375px)\" />\r\n<source srcset=\"/media/45knsri2/blue-moon.jpg?width=375&v=1dc4a5ecc2106d0\"  />\r\n<img alt=\"Still from the film Blue Moon. A close up of a woman holding some roses looking down at a man pleading towards her\" src=\"/media/45knsri2/blue-moon.jpg?width=375&amp;v=1dc4a5ecc2106d0\" loading=\"lazy\" decoding=\"async\" fetchpriority=\"low\" class=\"video-block__img js-video-with-facade-img\" /></picture>\n                </a>\n            <iframe title=\"Embedded video\" class=\"embed__source js-video-with-facade-iframe\" data-src=\"https://www.youtube-nocookie.com/embed/qo7gRHip0lI?autoplay=1\" allow=\"autoplay\" width=\"960\" height=\"540\" frameborder=\"0\" allowfullscreen loading=\"lazy\" aria-hidden=\"true\" tabindex=\"-1\"></iframe>\n        </div>\n    </div>\n\n                </div>\n                <div class=\"block column-span column-span--6\" data-area-col-span=\"6\" style=\"--blockStackingOrder:0\">\n                    \n\n\n\n    <div class=\"group group--h-align-left group--v-gutter-default\">\n        \n\n\n                <div class=\"block column-span column-span--12\" data-area-col-span=\"12\" style=\"--blockStackingOrder:0\">\n                    \n\n\n\n    <div class=\"text-block shared-styles js-add-wrapper\" data-wrap=\"table\" data-wrap-class=\"table-scroll\">\n        <h2 class=\"heading--h3\">Blue Moon</h2>\n<p>Tells the story of lyricist Lorenz Hart's struggles with alcoholism and mental health as his former collaborator, Richard Rodgers, celebrates the opening night of his groundbreaking hit musical \"Oklahoma!\"</p>\n<p>Stars Ethan Hawke, Margaret Qualley, Bobby Cannavale<br><em>(Certification 15)</em></p>\n<ul>\n<li><a rel=\"noopener\" href=\"https://www.sevenrooms.com/reservations/refuelbarandrestaurant?default_date=2026-01-01&amp;default_time=3:30PM&amp;client_id=1645fc6958c6c58dc98dbeb7512a7ee9d0e7f156537f885c071362c174c58ec586ddda7a0128b2e40407cf1c10f1ef29d50552a9cbc1ac77bbbb8537b7462e66\" target=\"_blank\" data-anchor=\"?default_date=2026-01-01&amp;default_time=3:30PM&amp;client_id=1645fc6958c6c58dc98dbeb7512a7ee9d0e7f156537f885c071362c174c58ec586ddda7a0128b2e40407cf1c10f1ef29d50552a9cbc1ac77bbbb8537b7462e66\">THE SOHO HOTEL - THURSDAY 1ST JANUARY, 3:30PM</a></li>\n</ul>\n    </div>\n\n                </div>\n\n    </div>\n\n                </div>\n\n\n\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"section__media\">\n                        </div>\n                    </section>\n\n    </div>\n</main>\n\n\n    <footer>\n        \n\n<div class=\"pre-footer\">\n    \n\n\n\n\n\n\n                    <section class=\"section section--theme-none section--halign-center section--valign-middle section--top-padding-default section--bottom-padding-default section--width-default section--gutter-default section--v-gutter-default section--stacked-v-gutter-match-desktop section--size-sized-by-content section--has-decorative-border\"\n                        >\n                        <div class=\"section__content\">\n                            <div class=\"constrain constrain--default\">\n                                <div class=\"section__layout\">\n                                    \n\n\n\n\n\n                <div class=\"block column-span column-span--3\" data-area-