abindex=\"-1\"></iframe>\n        </div>\n    </div>\n\n                </div>\n                <div class=\"block column-span column-span--6\" data-area-col-span=\"6\" style=\"--blockStackingOrder:0\">\n                    \n\n\n\n    <div class=\"group group--h-align-left group--v-gutter-default\">\n        \n\n\n                <div class=\"block column-span column-span--12\" data-area-col-span=\"12\" style=\"--blockStackingOrder:0\">\n                    \n\n\n\n    <div class=\"text-block shared-styles js-add-wrapper\" data-wrap=\"table\" data-wrap-class=\"table-scroll\">\n        <h2 class=\"heading--h3\">It's a Wonderful Life</h2>\n<p>An angel is sent from Heaven to help a desperately frustrated businessman by showing him what life would have been like if he had never existed. (1946)</p>\n<p>Stars James Stewart, Donna Reed, Lionel Barrymore<br><em>(Certification U)</em></p>\n<ul>\n<li><a rel=\"noopener\" href=\"https://www.sevenrooms.com/reservations/brasseriemax?default_date=2025-12-13&amp;default_time=8:00PM&amp;client_id=1f03a9167f7a18acce400d2633d7b793bbfeeb9d8bcc66e2553ba0ae3283e0c4982c395dc491ed043a886bc93874e488a704f0696efd9dd0f5017eb2d33882f7\" target=\"_blank\" data-anchor=\"?default_date=2025-12-13&amp;default_time=8:00PM&amp;client_id=1f03a9167f7a18acce400d2633d7b793bbfeeb9d8bcc66e2553ba0ae3283e0c4982c395dc491ed043a886bc93874e488a704f0696efd9dd0f5017eb2d33882f7\">COVENT GARDEN HOTEL - SATURDAY 13TH DECEMBER, 8PM</a> </li>\n<li><a rel=\"noopener\" href=\"https://www.sevenrooms.com/reservations/refuelbarandrestaurant?default_date=2025-12-21&amp;default_time=3:30PM&amp;client_id=c4db74eb7431b03bff95854c5fab58f342941ed92321c558b2bb8981a5b669249060dbc4f37db61e788407a9bbaeb0cf52c9e50a031e8b21137c43fdb3b4fe18\" target=\"_blank\" data-anchor=\"?default_date=2025-12-21&amp;default_time=3:30PM&amp;client_id=c4db74eb7431b03bff95854c5fab58f342941ed92321c558b2bb8981a5b669249060dbc4f37db61e788407a9bbaeb0cf52c9e50a031e8b21137c43fdb3b4fe18\">THE SOHO HOTEL - SUNDAY 21ST DECEMBER, 3:30PM</a></li>\n<li><a rel=\"noopener\" href=\"https://www.sevenrooms.com/reservations/brasseriemax?default_date=2025-12-24&amp;default_time=4:00PM&amp;client_id=c676ce486688f9c99f779ffb8e7efcee6febad54a46c23efcfeeb411235d23fd2fc0e2cf63eacae7b5e662595afebbfbadde6b8e15e08e5c6ba2ae6551803c63\" target=\"_blank\" data-anchor=\"?default_date=2025-12-24&amp;default_time=4:00PM&amp;client_id=c676ce486688f9c99f779ffb8e7efcee6febad54a46c23efcfeeb411235d23fd2fc0e2cf63eacae7b5e662595afebbfbadde6b8e15e08e5c6ba2ae6551803c63\">COVENT GARDEN HOTEL - WEDNESDAY 24TH DECEMBER, 4PM</a></li>\n</ul>\n    </div>\n\n                </div>\n\n    </div>\n\n                </div>\n\n\n\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"section__media\">\n                        </div>\n                    </section>\n                    <section class=\"section section--theme-primary section--halign-left section--valign-middle section--top-padding-default section--bottom-padding-default section--width-default section--gutter-large section--v-gutter-default section--stacked-v-gutter-match-desktop section--size-sized-by-content section--remove-decorative-tear\"\n                        >\n                        <div class=\"section__content\">\n                            <div class=\"constrain constrain--default\">\n                                <div class=\"section__layout\">\n                                    \n\n\n\n\n\n                <div class=\"block column-span column-span--6\" data-area-col-span=\"6\" style=\"--blockStackingOrder:0\">\n                    \n\n\n\n    <div class=\"video-block embed js-video-with-facade video-block--poster\">\n        <div class=\"video-block__content\">\n                <a href=\"https://www.youtube-nocookie.com/embed/14o38xfHlXc?autoplay=1\" class=\"video-block__link js-video-with-facade-link\" target=\"_blank\" aria-label=\"Click to