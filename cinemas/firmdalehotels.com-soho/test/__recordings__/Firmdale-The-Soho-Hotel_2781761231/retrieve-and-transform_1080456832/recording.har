45/i-swear.jpg?width=720&v=1dc42834d376fe0\" media=\"(min-width: 980px)\" />\r\n<source srcset=\"/media/q3gmxx45/i-swear.jpg?width=980&v=1dc42834d376fe0\" media=\"(min-width: 768px)\" />\r\n<source srcset=\"/media/q3gmxx45/i-swear.jpg?width=425&v=1dc42834d376fe0\" media=\"(min-width: 375px)\" />\r\n<source srcset=\"/media/q3gmxx45/i-swear.jpg?width=375&v=1dc42834d376fe0\"  />\r\n<img alt=\"Still from the film &#x27;I Swear&#x27;. A man stands smiling holding a bunch of flowers up in front of a yellow curtain.\" src=\"/media/q3gmxx45/i-swear.jpg?width=375&amp;v=1dc42834d376fe0\" loading=\"lazy\" decoding=\"async\" fetchpriority=\"low\" class=\"video-block__img js-video-with-facade-img\" /></picture>\n                </a>\n            <iframe title=\"Embedded video\" class=\"embed__source js-video-with-facade-iframe\" data-src=\"https://www.youtube-nocookie.com/embed/oeWqQN3snCU?autoplay=1\" allow=\"autoplay\" width=\"960\" height=\"540\" frameborder=\"0\" allowfullscreen loading=\"lazy\" aria-hidden=\"true\" tabindex=\"-1\"></iframe>\n        </div>\n    </div>\n\n                </div>\n                <div class=\"block column-span column-span--6\" data-area-col-span=\"6\" style=\"--blockStackingOrder:0\">\n                    \n\n\n\n    <div class=\"group group--h-align-left group--v-gutter-default\">\n        \n\n\n                <div class=\"block column-span column-span--12\" data-area-col-span=\"12\" style=\"--blockStackingOrder:0\">\n                    \n\n\n\n    <div class=\"text-block shared-styles js-add-wrapper\" data-wrap=\"table\" data-wrap-class=\"table-scroll\">\n        <h2 class=\"heading--h3\">I Swear</h2>\n<p>The true life story of John Davidson, MBE, charting his journey from a misunderstood teenager in 1980’s Britain to present day advocate for the understanding and acceptance of Tourette's Syndrome.</p>\n<p>Stars Robert Aramayo, Peter Mullan, Maxine Peak<br><em>(Certification 15)</em></p>\n<ul>\n<li><a rel=\"noopener\" href=\"https://www.sevenrooms.com/reservations/brasseriemax?default_date=2025-11-15&amp;default_time=8:00PM&amp;client_id=59134e1026f1de9e39292001761577173a10384a89e11de9c3862e13db7a3c0269d51e12b120af1e7673c74e07c9e6cd616a9cf47e87d0b3a2fe7c70c4b7382b\" target=\"_blank\" data-anchor=\"?default_date=2025-11-15&amp;default_time=8:00PM&amp;client_id=59134e1026f1de9e39292001761577173a10384a89e11de9c3862e13db7a3c0269d51e12b120af1e7673c74e07c9e6cd616a9cf47e87d0b3a2fe7c70c4b7382b\">COVENT GARDEN HOTEL - SATURDAY 15TH NOVEMBER, 8PM</a> </li>\n<li><a rel=\"noopener\" href=\"https://www.sevenrooms.com/reservations/refuelbarandrestaurant?default_date=2025-11-23&amp;default_time=3:30PM&amp;client_id=e3903c5c8a5d8677f0007c4bd901b76b630f6fd52259058ce17745d563b1becc7984d922abef7c5b7a7280e121766a657575a015057d3b36b21b105caba9b9b7\" target=\"_blank\" data-anchor=\"?default_date=2025-11-23&amp;default_time=3:30PM&amp;client_id=e3903c5c8a5d8677f0007c4bd901b76b630f6fd52259058ce17745d563b1becc7984d922abef7c5b7a7280e121766a657575a015057d3b36b21b105caba9b9b7\">THE SOHO HOTEL - SUNDAY 23RD NOVEMBER, 3:30PM</a></li>\n</ul>\n    </div>\n\n                </div>\n\n    </div>\n\n                </div>\n\n\n\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"section__media\">\n                        </div>\n                    </section>\n                    <section class=\"section section--theme-none section--halign-left section--valign-middle section--top-padding-default section--bottom-padding-default section--width-default section--gutter-large section--v-gutter-default section--stacked-v-gutter-match-desktop section--size-sized-by-content section--remove-decorative-tear\"\n                        >\n                        <div class=\"section__content\">\n                            <div class=\"constrain constrain--default\">\n                                <div class=\"section__layout\">\n                      