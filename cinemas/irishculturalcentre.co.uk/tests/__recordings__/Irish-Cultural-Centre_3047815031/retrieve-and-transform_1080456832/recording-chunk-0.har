ackground-container\"></div><div class=\"vce-row-content\" data-vce-element-content=\"true\"><div class=\"vce-col vce-col--md-auto vce-col--xs-1 vce-col--xs-last vce-col--xs-first vce-col--sm-last vce-col--sm-first vce-col--md-last vce-col--lg-last vce-col--xl-last vce-col--md-first vce-col--lg-first vce-col--xl-first\" id=\"el-ffaa4f0c\"><div class=\"vce-col-inner\" data-vce-do-apply=\"border margin background  el-ffaa4f0c\"><div class=\"vce-col-content\" data-vce-element-content=\"true\" data-vce-do-apply=\"padding el-ffaa4f0c\"><div class=\"vce-row-container\" data-vce-boxed-width=\"true\"><div class=\"vce-row vce-row--col-gap-30 vce-row-equal-height vce-row-content--top\" id=\"el-00d83ade\" data-vce-do-apply=\"all el-00d83ade\"><div class=\"vce-row-content\" data-vce-element-content=\"true\"><div class=\"vce-col vce-col--md-auto vce-col--xs-1 vce-col--xs-last vce-col--xs-first vce-col--sm-last vce-col--sm-first vce-col--md-last vce-col--lg-last vce-col--xl-last vce-col--md-first vce-col--lg-first vce-col--xl-first\" id=\"el-7a876d4a\"><div class=\"vce-col-inner\" data-vce-do-apply=\"border margin background  el-7a876d4a\"><div class=\"vce-col-content\" data-vce-element-content=\"true\" data-vce-do-apply=\"padding el-7a876d4a\"><div class=\"vce-text-block\"><div class=\"vce-text-block-wrapper vce\" id=\"el-dadd32ac\" data-vce-do-apply=\"all el-dadd32ac\"><h1 style=\"text-align: center;\">What's on</h1><p style=\"text-align: left;\"><span style=\"font-size: 16pt;\">The Irish Cultural Centre in Hammersmith, London hosts a weekly programme of live Irish music, literature, theatre, comedy, film, and cultural events. From traditional sessions to contemporary performances, our events bring the best of Irish culture to West London. </span></p><p style=\"text-align: left;\"><span style=\"font-size: 16pt;\">Browse upcoming events below and book tickets online.</span></p></div></div><div class=\"vce-row-container\" data-vce-boxed-width=\"true\"><div class=\"vce-row vce-row