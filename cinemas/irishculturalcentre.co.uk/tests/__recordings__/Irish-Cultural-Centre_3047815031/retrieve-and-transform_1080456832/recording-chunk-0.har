et=\"_blank\" href=\"https://www.linkedin.com/company/the-irish-cultural-centre/?originalSubdomain=uk\"><i class=\"fa fa-linkedin\"></i></a>\r\n<a target=\"_blank\" href=\"https://www.youtube.com/channel/UC42aQPm14tTeIVBH_qff7Iw\"><i class=\"fa fa-youtube\"></i></a>\r\n<a target=\"_blank\" href=\"https://bsky.app/profile/irishculturalcentr.bsky.social\"><i class=\"fa fa-bluesky\"></i></a>\r\n<a target=\"_blank\" href=\"https://www.tiktok.com/@irishculturalcentre\"><i class=\"fa fa-tiktok\"></i></a>\r\n</div></div></li>\t\t\t\t\t</ul>\n\t\t\t\t</div><!-- #fourth .widget-area -->\n\n\t\t\t</div><!-- #footer-widget-area -->\n\n\t<div class=\"bottom-footer fadein\">\n    <div class=\"bottom-footer-left\">\n      <p style=\"margin-bottom: 0px\">Registered Office: 5 Black's Road, Hammersmith, London W6 9DT</p>\n      <p style=\"margin-bottom: 0px\">Company Reg. No. 06100801</p>\n      <p style=\"margin-bottom: 0px\">Charity Reg. No. 1122387</p>\n        \n      <p style=\"margin-bottom: 0px\">&copy; <a href=\"https://irishculturalcentre.co.uk/\">Irish Cultural Centre</a> 2026</p>\n      <p style=\"margin-bottom: 0px\">Website by <a target=\"_blank\" href=\"https://salsaco.co.uk/\">Salsa</a></p>\n    </div>\n    <div class=\"bottom-footer-right\">\n      <img style=\"width: 100%;max-width: 320px;height: auto;\" width=\"283\" height=\"75\" src=\"/wp-content/themes/Irish-cultural-centre/images/logo-global-irish.png\" alt=\"Global Irish Logo\">\n    </div>\n\t</div>\n</div>\n\n\n<script data-cfasync=\"false\" src=\"/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js\"></script><script>\n\n$(document).ready(function() { \n  \n  /// form panel\n  formPanel = $('.form-panel-wrap');\n\n  // form panel button\n  formPanelButton = $('.formPanelButton button');\n\n  // close button\n  closePanelButton = $('.close-button');\n\n  // menu function\n  formPanelButton.click(function(event) {    \n    event.preventDefault();\n    formPanel.toggleClass('active');\n  });\n\n  closePanelButton.click(function(event) {    \n    event.preventDefault();\n    formPanel.removeClass('active');\n  });  \n  \n\n}); \n\n</script>\n\n\n\n<script>\n// review slider\n$('.your-class').slick({\n    adaptiveHeight: true,\n    prevArrow:\"<button type='button' class='slick-prev pull-left'><span class='icon-arrow-left'></span></button>\",\n    nextArrow:\"<button type='button' class='slick-next pull-right'><span class='icon-arrow-right'></span></button>\"\n});\n\n</script>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function(){\n    \n    // Create a media condition that targets viewports at least 768px wide\n    const mediaQuery = window.matchMedia('(max-width: 768px)')\n    checkMedia();\n\n    function checkMedia(){\n        // Check if the media query is true\n        if (mediaQuery.matches) {\n          // review slider\n\n          if (document.querySelector('.sponsor-logos.slick-initialized') == null && document.querySelector('.sponsor-logos') != null) {\n            $('.sponsor-logos').slick({\n                adaptiveHeight: true,\n                prevArrow:\"<button type='button' class='slick-prev pull-left'><span class='icon-arrow-left'></span></button>\",\n                nextArrow:\"<button type='button' class='slick-next pull-right'><span class='icon-arrow-right'></span></button>\"\n            }); \n          }\n\n        } else {\n          if (document.querySelector('.sponsor-logos.slick-initialized') != null) {\n            $('.sponsor-logos').slick('unslick');\n          }\n        }\n    }\n\n\n    window.addEventListener('resize', function(){\n      checkMedia();\n    });\n\n  })\n</script>\n\n\n<script>\n\n//languages\n\n$(document).ready(function() { \n\n  languages = $('.languages a');\n\n// detect language\n\nfunction readCookie(name) {\n    var c = document.cookie.split('; '),\n    cookies = {}, i, C;\n\n    for (i = c.length - 1; i >= 0; i--) {\n        C = c[i].split('=');\n        cookies[C[0]] = C[1];\n     }\n\n     return cookies[name];\n  }\n\n  selectedLanguage = readCookie('googtrans');\n\n  if(selectedLanguage == \"/en/ga\") {\n      languages.removeClass('selected');\n      $(\".languages a#Irish\").addClass('selected');\n  }\n\n\n  // toggle colour\n\n\n  languages.click(function(event) {\n    languages.removeClass('selected');\n    $(this).toggleClass('selected');\n  });  \n\n}); \n\n</script>\n\n<script>\n\n$(document).ready(function() { \n  //////////// menu toggle\n  body = $('body');\n  menuPanel = $('.menu-panel.main-menu-panel');\n  header = $('.header-wrap');\n\n  // search menu\n  searchMenuPanel = $('.menu-panel.search-menu-panel');\n\n  // menu buttons\n  menuButton = $('.menu-icon-wrap');\n  searchMenuButton = $('#menu-item-97 a, #menu-item-1806 a');\n\n  // menu function\n  menuButton.click(function(event) {    \n    event.preventDefault();\n    $(this).toggleClass('active');\n    menuPanel.toggleClass('active');\n    header.toggleClass('active');\n    body.toggleClass('menu-active');\n\n    // hide menu items\n    $(\"#menu-item-28\").toggleClass('menu-hide');\n    $(\"#menu-item-30\").toggleClass('menu-hide');    \n    $(\"#menu-item-1804\").toggleClass('menu-hide');\n    $(\"#menu-item-1805\").toggleClass('menu-hide');\n    $(\"#menu-item-1608\").toggleClass('menu-hide');\n    $(\".slider-caption\").toggleClass('menu-hide');\n\n  });\n\n\n  searchMenuButton.click(function(event) {\n    event.preventDefault();\n    $(this).toggleClass('active');\n    searchMenuPanel.toggleClass('active');\n    header.toggleClass('active');\n    body.toggleClass('menu-active');   \n\n     // hide menu items\n    $(\".slider-caption\").toggleClass('menu-hide');\n  });\n\n  //////////// Header fade homepage scroll\n\n  $(window).bind(\"scroll\", function() {\n      if ($(this).scrollTop() > 120) {\n          header.addClass('scrolled');\n      } else {\n          header.removeClass('scrolled');\n      }\n  });\n  \n\n}); \n\n</script>\n\n\n\n<script>\n\n$(document).ready(function() {   \n\n// Select all links with hashes\n$('a[href*=\"#\"]')\n  // Remove links that don't actually link to anything\n  .not('[href=\"#\"]')\n  .not('[href=\"#0\"]')\n  .not('a.profile-link')\n  .click(function(event) {\n    // On-page links\n    if (\n      location.pathname.replace(/^\\//, '') == this.pathname.replace(/^\\//, '') \n      && \n      location.hostname == this.hostname\n    ) {\n      // Figure out element to scroll to\n      var target = $(this.hash);\n      target = target.length ? target : $('[name=' + this.hash.slice(1) + ']');\n      // Does a scroll target exist?\n      if (target.length) {\n        // Only prevent default if animation is actually gonna happen\n        event.preventDefault();\n        $('html, body').animate({\n          scrollTop: target.offset().top - 167\n        }, 1000, function() {\n          // Callback after animation\n          // Must change focus!\n          var $target = $(target);\n          $target.focus();\n          if ($target.is(\":focus\")) { // Checking if the target was focused\n            return false;\n          } else {\n            $target.attr('tabindex','-1'); // Adding tabindex for elements not focusable\n            $target.focus(); // Set focus again\n          };\n        });\n      }\n    }\n  });\n\n}); \n\n</script>\n\n<script type=\"text/javascript\">\nvar $animation_elements = $('.fadein');\nvar $window = $(window);\n\nfunction check_if_in_view() {\n  var window_height = $window.height();\n  var window_top_position = $window.scrollTop();\n  var window_bottom_position = (window_top_position + window_height);\n\n  $.each($animation_elements, function() {\n    var $element = $(this);\n    var element_height = $element.outerHeight();\n    var element_top_position = $element.offset().top;\n    var element_bottom_position = (element_top_position + element_height);\n\n    //check to see if this current container is within viewport\n    if ((element_bottom_position >= window_top_position) &&\n      (element_top_position <= window_bottom_position)) {\n      $element.addClass('in-view');\n    } else {\n      $element.removeClass('in-view');\n    }\n  });\n}\n\n$window.on('scroll resize', check_if_in_view);\n$window.trigger('scroll');\n</script>\n\n\n\n<script>\n\t\t\t\t( function() {\n\t\t\t\t\tconst style = document.createElement( 'style' );\n\t\t\t\t\tstyle.appendChild( document.createTextNode( '#frm_field_104_container {visibility:hidden;overflow:hidden;width:0;height:0;position:absolute;}' ) );\n\t\t\t\t\tdocument.head.appendChild( style );\n\t\t\t\t\tdocument.currentScript?.remove();\n\t\t\t\t} )();\n\t\t\t</script><script type=\"speculationrules\">\n{\"prefetch\":[{\"source\":\"document\",\"where\":{\"and\":[{\"href_matches\":\"/*\"},{\"not\":{\"href_matches\":[\"/wp-*.php\",\"/wp-admin/*\",\"/wp-content/uploads/*\",\"/wp-content/*\",\"/wp-content/plugins/*\",\"/wp-content/themes/Irish-cultural-centre/*\",\"/*\\\\?(.+)\"]}},{\"not\":{\"selector_matches\":\"a[rel~=\\\"nofollow\\\"]\"}},{\"not\":{\"selector_matches\":\".no-prefetch, .no-prefetch a\"}}]},\"eagerness\":\"conservative\"}]}\n</script>\n<!-- BEGIN MENU BUTTON -->\r\n<div class=\"taptap-menu-button-wrapper\">\r\n    \r\n    <!-- BEGIN MENU BUTTON LABEL (if one is entered) -->\r\n        <!-- END MENU BUTTON LABEL (if one is entered) -->\r\n    \r\n    <!-- BEGIN MENU BUTTON STYLES -->\r\n            \r\n            <div class=\"taptap-main-menu-button\">\r\n                <div class=\"taptap-main-menu-button-middle\"></div>\r\n            </div>\r\n                <!-- END MENU BUTTON STYLES -->\r\n    </div>\r\n<!-- END MENU BUTTON -->\r\n\r\n<!-- BEGIN SEARCH BUTTON -->\r\n<div class=\"taptap-search-button-wrapper\">\r\n    <!-- BEGIN SEARCH BUTTON LABEL (if one is entered) -->\r\n        <!-- END SEARCH BUTTON LABEL (if one is entered) -->\r\n    \r\n    </div>\r\n<!-- END SEARCH BUTTON -->\r\n\r\n<!-- BEGIN SEARCH FORM -->\r\n<div class=\"taptap-search-wrapper\">\r\n        <!-