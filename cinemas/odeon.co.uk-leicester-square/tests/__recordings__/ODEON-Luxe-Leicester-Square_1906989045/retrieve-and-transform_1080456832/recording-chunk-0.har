,\"isSoldOut\":false,\"seatLayoutId\":\"153-2-38\",\"filmId\":\"HO00008273\",\"siteId\":\"153\",\"screenId\":\"153-2\",\"areaCategories\":[{\"areaCategoryId\":\"153-0000000010\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"153\",\"name\":{\"text\":\"London Leicester Square\",\"translations\":[]},\"location\":{\"latitude\":51.5104,\"longitude\":-0.1293},\"contactDetails\":{\"phoneNumbers\":[],\"email\":null,\"address\":{\"line1\":\"22-24 Leicester Square\",\"line2\":\"\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007316\",\"title\":{\"text\":\"Zootropolis 2\",\"translations\":[]},\"synopsis\":{\"text\":\"Brave rabbit cop Judy Hopps and her friend, the fox Nick Wilde, team up again to crack a new case, the most perilous and intricate of their careers.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Brave rabbit cop Judy Hopps and her friend, the fox Nick Wilde, team up again to crack a new case, the most perilous and intricate of their careers.\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat, violence\",\"translations\":[]},\"releaseDate\":\"2025-11-28\",\"runtimeInMinutes\":108,\"trailerUrl\":null,\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003440\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000003441\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003443\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006395\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008394\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015583\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015584\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000082\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000488\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002397\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"87004e42-c4bd-4468-8b83-00f122c59dd9\",\"corporateId\":null},\"hopk\":\"HO00007316\",\"hoCode\":\"A000008328\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00007533\",\"title\":{\"text\":\"Avatar: Fire and Ash\",\"translations\":[]},\"synopsis\":{\"text\":\"Jake and Neytiri's family grapples with grief after Neteyam's death, encountering a new, aggressive Na'vi tribe, the Ash People, who are led by the fiery Varang, as the conflict on Pandora escalates and a new moral focus emerges.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Jake and Neytiri's family grapples with grief after Neteyam's death, encountering a new, aggressive Na'vi tribe, the Ash People, who are led by the fiery Varang.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-19\",\"runtimeInMinutes\":197,\"trailerUrl\":null,\"displayPriority\":8,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000560\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002207\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002294\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005786\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005787\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007837\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17711\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17712\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17713\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000042\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000349\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000696\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002427\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000010\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a4cb369f-77c4-4fe1-8f85-dd5e76b195dd\",\"corporateId\":null},\"hopk\":\"HO00007533\",\"hoCode\":\"A000008563\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008012\",\"title\":{\"text\":\"The Housemaid\",\"translations\":[]},\"synopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous — a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, sex, sexual violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-12-22\",\"runtimeInMinutes\":131,\"trailerUrl\":\"https://www.youtube.com/watch?v=kdDdlY2VPxw\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000009161\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012707\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016976\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016977\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000031\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000135\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000814\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001305\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dc7be94d-5ba5-4a79-accd-48ed4d19a3b6\",\"corporateId\":null},\"hopk\":\"HO00008012\",\"hoCode\":\"A000009092\",\"eventId\":null,\"distributorName\":\"LIONSGATE INTERNATIONAL\"},{\"id\":\"HO00008014\",\"title\":{\"text\":\"Anaconda\",\"translations\":[]},\"synopsis\":{\"text\":\"Doug (Jack Black) and Griff (Paul Rudd) have been best friends since they were kids, and have always dreamed of remaking their all-time favourite movie: the cinematic \\\"classic\\\" Anaconda. When a midlife crisis pushes them to finally go for it, they head deep into the Amazon to start filming. But things get real when an actual giant anaconda appears, turning their comically chaotic movie set into a deadly situation. The movie they’re dying to make? It might just get them killed......\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Doug (Jack Black) and Griff (Paul Rudd) have been best friends since they were kids, and have always dreamed of remaking their all-time favourite movie..\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-25\",\"runtimeInMinutes\":99,\"trailerUrl\":\"https://www.youtube.com/watch?v=c1AvAE_AMdo\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000223\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000224\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002845\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004772\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000012329\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014628\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016978\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000101\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000928\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002663\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c37a28f1-30f5-4bb7-a75b-289ae4f5db56\",\"corporateId\":null},\"hopk\":\"HO00008014\",\"hoCode\":\"A000009094\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008189\",\"title\":{\"text\":\"28 Years Later: The Bone Temple\",\"translations\":[]},\"synopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later: The Bone Temple. In a continuation of the epic story, Dr. Kelson (Ralph Fiennes) finds himself in a shocking new relationship - with consequences that could change the world as they know it - and Spike's (Alfie Williams) encounter with Jimmy Crystal (Jack O'Connell) becomes a nightmare he can't escape. In the world of The Bone Temple, the infected are no longer the greatest threat to survival - the inhumanity of the survivors can be stranger and more terrifying.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong gory violence, injury detail, very strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-14\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=wyYliP8dPWU\",\"displayPriority\":9,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000097\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000442\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002404\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002653\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005575\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014011\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014577\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017356\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000576\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"12790418-6492-492a-814c-53673bc1ab1a\",\"corporateId\":null},\"hopk\":\"HO00008189\",\"hoCode\":\"A000009281\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008193\",\"title\":{\"text\":\"Mercy\",\"translations\":[]},\"synopsis\":{\"text\":\"In the near future, a detective (Chris Pratt) stands on trial accused of murdering his wife. He has 90 minutes to prove his innocence to the advanced A.I. Judge (Rebecca Ferguson) he once championed, before it determines his fate.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In the near future, a detective (Chris Pratt) stands on trial accused of murdering his wife. He has 90 minutes to prove his innocence to the advanced A.I. Judge.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate violence, threat, injury detail, drug misuse, strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=sN-C09dfczY\",\"displayPriority\":12,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003235\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000009008\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017362\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017363\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017364\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000086\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000825\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000982\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001684\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002432\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"eea3fe00-3e2b-4dcc-9150-aedd76790a42\",\"corporateId\":null},\"hopk\":\"HO00008193\",\"hoCode\":\"A000009285\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008237\",\"title\":{\"text\":\"Shelter\",\"translations\":[]},\"synopsis\":{\"text\":\"On a remote coastal island, a man living in self-imposed exile rescues a young girl from a deadly storm. This action sets off a chain of events, bringing him out of seclusion and both into harm’s way. As their lives intertwine, he must navigate protecting the orphaned girl while battling enemies from is past - setting them both on a breathless odyssey for survival and a deeper journey toward redemption.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"On a remote coastal island, a man living in self-imposed exile rescues a young girl from a deadly storm.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":107,\"trailerUrl\":null,\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000262\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001557\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002147\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014866\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016569\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017459\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000088\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000251\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001694\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001819\",\"roles\":[\"Actor\",\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000007\",\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9e3b2fd7-c5b2-4dee-857d-9dc3d230e4cd\",\"corpo