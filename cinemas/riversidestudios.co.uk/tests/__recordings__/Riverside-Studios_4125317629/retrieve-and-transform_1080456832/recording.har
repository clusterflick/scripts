\"button button-blue\">Book now</a>\n        </div>\n      </div>\n\n\n\n    </div>\n\n  </div>\n</div>\n      </div>\n\n\n\n  </div>\n\n\n</section>\n</section>\r\n  \r\n</div>\r\n\r\n<script id=\"_performance_time_template\" type=\"text/html\">\r\n  <div class=\"form-element form-element-checkbox\">\r\n    <input type=\"radio\" name=\"time\" value=\"<%= id %>\" id=\"<%= id %>\" data-price=\"<%= price %>\" <% if (!availability) { %>disabled=\"disabled\" <% } %> />\r\n    <label for=\"<%= id %>\"><span><%= time %></span>  <% if (!availability) { %><span class=\"sold-out\">SOLD OUT</span><% } %></label>\r\n    <% if (tooltip_name && tooltip_text) { %><div class=\"tooltip\" data-tooltip_text=\"<%= tooltip_text %>\" data-tooltip_theme=\"<%= tooltip_theme %>\"><%=tooltip_name %></div><% } %>\r\n  </div>\r\n</script>\r\n\r\n<script id=\"_ticket_type_template\" type=\"text/html\">\r\n  <div class=\"form-element-number-wrapper<%= !available ? ' price-band-sold-out' : '' %>\">\r\n    <div class=\"form-element form-element-number\">\r\n      <label>\r\n        <span class=\"ticket-price\">£<%= price %> / person</span>\r\n        <span class=\"ticket-type\"><%= name %></span>\r\n      </label>\r\n      <% if (available) { %>\r\n      <input type=\"number\" value=\"0\" />\r\n      <% } %>\r\n    </div>\r\n    <span class=\"description\"><%= available ? description : 'Sold Out' %></span>\r\n  </div>\r\n</script>\r\n\r\n<script id=\"_modal_ticket_type_template\" type=\"text/html\">\r\n  <div class=\"price-band-modal-ticket-button <%= !available ? ' price-band-sold-out' : '' %>\">\r\n    <span class=\"price-band-modal-ticket-name\">\r\n      <%= name %>\r\n\r\n    </span>\r\n    <span class=\"price-band-modal-ticket-price\">\r\n      £<%= price %>\r\n      <% if (description) { %>\r\n        <div class=\"tooltip\" data-tooltip_theme=\"ticket-modal\" data-tooltip_text=\"<%= available ? description : 'Sold Out' %>\"></div>\r\n      <% } %>\r\n    </span>\r\n    <span class=\"price-band-modal-ticket-description\"></span>\r\n\r\n  </div>\r\n</script>\r\n\r\n<script>\r\n  var event_data = {\"performance_dates\":[{\"id\":\"aYMIFl9A\",\"date\":\"2025-03-15\",\"availability\":1},{\"id\":\"urZBA5DA\",\"date\":\"2025-03-16\",\"availability\":1},{\"id\":\"2tzNtOjD\",\"date\":\"2025-03-17\",\"availability\":1}],\"performance_times\":{\"aYMIFl9A\":[{\"id\":\"1111:15714\",\"price\":\"0.00\",\"time\":\"15:30\",\"raw_time\":\"1742052600\",\"venue\":\"Screen 2\",\"age_rating\":\"15\",\"reserved\":1,\"availability\":1,\"tooltip_name\":\"\",\"tooltip_text\":\"\",\"tooltip_theme\":\"\"}],\"urZBA5DA\":[{\"id\":\"1111:15715\",\"price\":\"0.00\",\"time\":\"13:00\",\"raw_time\":\"1742130000\",\"venue\":\"Screen 2\",\"age_rating\":\"15\",\"reserved\":1,\"availability\":1,\"tooltip_name\":\"\",\"tooltip_text\":\"\",\"tooltip_theme\":\"\"}],\"2tzNtOjD\":[{\"id\":\"1111:15716\",\"price\":\"0.00\",\"time\":\"12:45\",\"raw_time\":\"1742215500\",\"venue\":\"Screen 2\",\"age_rating\":\"15\",\"reserved\":1,\"availability\":1,\"tooltip_name\":\"Silver Screen\",\"tooltip_text\":\"Our special screenings during quieter times of the day, where we show a selection of new, talk-of-the-town releases and timeless classics. The price includes a complimentary hot drink and biscuits, served before the film.\",\"tooltip_theme\":\"Silver-Screen\"}]},\"price_bands\":{\"1111:15714\":{\"128\":[{\"code\":\"full_price\",\"name\":\"General\",\"price\":\"12.00\",\"min_quantity\":1,\"description\":\"\",\"list_only\":0,\"price_band_id\":128,\"available\":true},{\"code\":\"25 & Under\",\"name\":\"25 & Under\",\"price\":\"8.00\",\"min_quantity\":0,\"description\":\"Age verification may be required for our age restricted films.\\n\\nPlease note that by law we cannot permit entry to anyone that is under age for films certified 15 or over, even if they are accompanied by an adult.\\n\",\"list_only\":false,\"price_band_id\":128,\"available\":true},{\"code\":\"Dive In Members\",\"name\":\"Dive In Membe