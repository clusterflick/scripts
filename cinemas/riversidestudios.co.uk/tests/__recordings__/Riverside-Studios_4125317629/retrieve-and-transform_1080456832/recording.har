            "text": "<!DOCTYPE html>\n\n<!--[if lt IE 7]>\n<html lang=\"en\"\n      class=\"no-js ie legacy-ie lt-ie10 lt-ie9 lte-ie9 lt-ie8 lt-ie7\"> <![endif]-->\n<!--[if IE 7]>\n<html lang=\"en\"\n      class=\"no-js ie legacy-ie lt-ie10 lt-ie9 lte-ie9 lt-ie8\"> <![endif]-->\n<!--[if IE 8]>\n<html lang=\"en\" class=\"no-js ie legacy-ie lt-ie10 lt-ie9 lte-ie9\"> <![endif]-->\n<!--[if IE 9]>\n<html lang=\"en\" class=\"no-js ie legacy-ie lt-ie10\"> <![endif]-->\n<!--[if gt IE 9]><!-->\n<html lang=\"en\" class=\"no-js\"> <!--<![endif]-->\n<!--[if !IE]><!--><script>if(document.documentMode) document.documentElement.className+=' ie'+document.documentMode;</script><!--<![endif]-->\n\n<head>\n\n            <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\n                new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\n                j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n                'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n          })\n                              (window, document, 'script', 'dataLayer', 'GTM-W5VLL9M');\n                  </script>\n    \n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=Edge,chrome=1\">\n<title>I'm Still Here \r\n | Riverside Studios</title>\n\n    <meta name=\"description\" content=\"\"Spectacular” - INDIEWIRE\"a sombre, heartfelt drama about the nation’s disappeared.”- Guardian“I’m Still Here triumphs in pairing Salles’s intrinsic understanding of the emotional potential of realism with two brilliant performers in Mello and\">\n    \n<meta charset=\"utf-8\">\n<meta name=\"author\" content=\"I'm Still Here \r\n | Riverside Studios\">\n<meta name=\"generator\" content=\"Grandad Digital - Powered by You.Create Content Management System\">\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Organization\",\n  \"url\": \"https://riversidestudios.co.uk/\",\n  \"logo\": \"https://riversidestudios.co.uk/assets/img/logo.png\"\n}\n</script>\n<script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Event\",\"name\":\"I'm Still Here\",\"description\":\"Nominated at the 97th Academy Awards for Best International Feature Film, Best Actress (Torres) and Best Picture \\\"Spectacular\\u201d - INDIEWIRE\\\"a sombre, heartfelt drama about the nation\\u2019s disappeared.\\u201d- Guardian\\u201cI\\u2019m Still Here triumphs in pairing Salles\\u2019s intrinsic understanding of the emotional potential of realism with two brilliant performers in Mello and Torres\\u201d- Little White Lies&nbsp;&nbsp;BRAZIL, 1971. Brazil faces the tightening grip of a military dictatorship. Eunice Paiva, a mother of five children, is forced to reinvent herself after her family suffers a violent and arbitrary act by the government.I\\u2019m Still Here is based on Marcelo Rubens Paiva's biographical book and tells the true story that helped reconstruct an important part of Brazil\\u2019s hidden history.\",\"image\":[\"https:\\/\\/riversidestudios.co.uk\\/images\\/uploads\\/cc59506c5140a352b345cf88f686010c.JPG\"],\"startDate\":\"2025-03-05T20:20:00+00:00\",\"endDate\":\"2025-03-05T20:20:00+00:00\",\"eventStatus\":\"https:\\/\\/schema.org\\/EventScheduled\"}</script>\n<link rel=\"shortcut icon\" href=\"https://riversidestudios.co.uk/assets/favicons/favicon.ico?1651755466\" />\n    <link href=\"https://riversidestudios.co.uk/see-and-do/im-still-here-158545/\" rel=\"canonical\"/>\n\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=5, user-scalable=yes\"/>\n<link rel=\"dns-prefetch\" href=\"https://riversidestudios.co.uk/\"/>\n<link rel=\"stylesheet\" href=\"//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css\">\n<!-- <link rel=\"stylesheet\" type=\"text/css\" href=\"https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css\" /> -->\n\n<link href=\"https://riversidestudios.co.uk/assets/css/