nce-times\"></div>\r\n\r\n                      </div>\r\n\r\n\r\n                      <!-- <div class=\"section-title font-blue font-uppercase font-small  font-title\">Select a date and time to book time</div> -->\r\n\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n\r\n                                <div class=\"booking-section ticket-select\" data-section=\"2\">\r\n                  <div class=\"container mobile-only-break-768\">\r\n                    <div class=\"booking-section-content\">\r\n                      <div class=\"section-title font-blue font-uppercase font-small  font-title\">Select your tickets</div>\r\n                      <button class=\"button button-blue booking-next-step\" data-action=\"3\" disabled>Next: Select your seats</button>\r\n\r\n                      <div class=\"booking-section-field ticket-types\"></div>\r\n                                          </div>\r\n                  </div>\r\n                </div>\r\n\r\n                                <!-- <div class=\"booking-section\" data-section=\"5\">\r\n                  <div class=\"container mobile-only-break-768\">\r\n                    <div class=\"booking-section-content\">\r\n                      <div class=\"section-title font-blue font-uppercase font-small  font-title\">Checkout</div>\r\n\r\n                      <button class=\"button button-blue booking-next-step t\" data-action=\"6\">Checkout</button>\r\n                    </div>\r\n                  </div>\r\n                </div> -->\r\n\r\n                    </div>\r\n            </div>\r\n          </div>\r\n\r\n        </div>\r\n          </div>\r\n\r\n    </div>\r\n    <div class=\"template-bottom\">\r\n\r\n      <div class=\"container\">\r\n        <div class=\"template-bottom-inner\">\r\n          <div class=\"template-bottom-mobile\">\r\n\r\n\r\n            \r\n          </div>\r\n          <div class=\"template-left\">\r\n\r\n                                      <div class=\"te\">\r\n    <p style=\"margin-top: 0px\">\r\n      We are delighted to welcome director (and Hammersmith local) Patrick \r\n      Dickinson to our cinema for a post-show Q&amp;A after this special screening.\r\n    </p>\r\n    <p style=\"margin-top: 0px\">\r\n      \r\n    </p>\r\n    <p style=\"margin-top: 0px\">\r\n      From Tokyo to the Lake District - a universal portrait of love, \r\n      acceptance and family loss in which the true journey toward forgiveness \r\n      and reconciliation will prove the hardest of all.\r\n    </p>\r\n    <p style=\"margin-top: 0px\">\r\n       \r\n    </p>\r\n    <p style=\"margin-top: 0px\">\r\n      After the death of his wife, Kenzaburo and their son Toshi receive an \r\n      unexpected letter from beyond the grave. Kenzaburo's wife and Toshi's \r\n      mother, Akiko, asks them to scatter her ashes at the place she loved \r\n      most as a child &#8211; Lake Windermere. But the father's and son&#8217;s fraught \r\n      relationship threatens to upend their journey.\r\n    </p>\r\n    <p style=\"margin-top: 0px\">\r\n       \r\n    </p>\r\n    <p style=\"margin-top: 0px\">\r\n      Starring Hirokazu Kore-eda regular, Lily Franky (Shoplifters, After the \r\n      Storm, Like Father, Like Son) and with a supporting role from Ciar&#225;n \r\n      Hinds (Belfast, Harry Potter and the Deathly Hallows Part 2).\r\n    </p></div>            \r\n          </div>\r\n          <div class=\"template-right\">\r\n              \r\n                        <div class=\"event-details\">\r\n\r\n\r\n                            <div class=\"event-detail-section event-info\">\r\n\r\n                <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Rating Information: </div>\r\n\r\n                <div class=\"event-info-text age-rating text\"><span>upsetting scenes</span></div>\r\n              </div>\r\n\r\n                                          <div class=\"event-detail-section event-info\">\r\n                <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Run time:</div>\r\n                <div class=\"event-info-text\"><span>94 mins</span></div>\r\n              </div>\r\n\r\n              \r\n              \r\n              \r\n                              <div class=\"event-detail-section event-info\">\r\n                  <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Year of release:</div>\r\n                  <div class=\"event-info-text\"><span>2025</span></div>\r\n                </div>\r\n\r\n              \r\n                              <div class=\"event-detail-section event-info\">\r\n                  <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Company:</div>\r\n                  <div class=\"event-info-text\"><span>Day For Night</span></div>\r\n                </div>\r\n              \r\n                              <div class=\"event-detail-section event-info\">\r\n                  <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Director:</div>\r\n                  <div class=\"event-info-text\"><span>Patrick Dickinson</span></div>\r\n                </div>\r\n\r\n              \r\n                              <div class=\"event-detail-section event-info\">\r\n                  <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Cast:</div>\r\n                  <div class=\"event-info-text\"><span>Lily Franky, Ciarán Hinds, Aoife Hinds, Thomas Coombes</span></div>\r\n                </div>\r\n\r\n              \r\n              \r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n              \r\n              \r\n              \r\n              <div class=\"performance_details\">\r\n                <div class=\"performance-label\">Select a time to book</div>\r\n                <div class=\"performance-day\">\r\n                  <div class=\"performance-date\">Wednesday 5 March 2025</div>\r\n                  <div class=\"perfo