        </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n<div class=\"nav-item has-sub-nav\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"Our Story\">\n        Our Story    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>Our Story</span>\r\n</div>\n                \n\n                                  <a class=\"button button-large button-blue\" href=\"https://riversidestudios.co.uk/our-story/\" role=\"menuitem\">Explore</a>\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Find out more about Riverside's rich heritage</div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/our-story/a-brief-history-of-riverside/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"The Riverside Studios Story\" role=\"menuitem\">\n                      The Riverside Studios Story                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/our-story/riverside-reflections/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Riverside Reflections: An Oral History\" role=\"menuitem\">\n                      Riverside Reflections: An Oral History                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/our-story/the-archive/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Riverside's Archive\" role=\"menuitem\">\n                      Riverside's Archive                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/our-story/heritage-project-blog/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Heritage Project Blog\" role=\"menuitem\">\n                      Heritage Project Blog                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/our-story/riverside-icons/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Riverside Icons\" role=\"menuitem\">\n                      Riverside Icons                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n<div class=\"nav-item\">\n    <a  href=\"https://riversidestudios.co.uk/riverside-pass/\"  class=\"nav-title\" title=\"Riverside Pass - Join now!\">\n        Riverside Pass - Join now!    </a>\n    </div>\n            <div class=\"nav-item \">\r\n              <a class=\"nav-title has-icon search\" href=\"https://riversidestudios.co.uk/search/\"><span>Search</span></a>\r\n            </div>\r\n          </nav>\r\n          <nav class=\"shop-nav container mobile-only-break-1024\">\r\n            <div class=\"nav-item\" style=\"display:none;\">\r\n              <a class=\"nav-title has-icon login\" href=\"https://riversidestudios.co.uk/account/login/\"><span>Login</span></a>\r\n            </div>\r\n            <div class=\"nav-item\" style=\"display:none;\">\r\n              <a class=\"nav-title has-icon account\" href=\"https://riversidestudios.co.uk/account/\"><span>Account</span></a>\r\n            </div>\r\n            <div class=\"nav-item\" style=\"display:none;\">\r\n              <a class=\"nav-title has-icon logout\" href=\"https://riversidestudios.co.uk/account/logout/\"><span>Logout</span></a>\r\n            </div>\r\n                        <div class=\"nav-item\">\r\n              <a class=\"nav-title has-icon basket basket-trigger\" href=\"https://riversidestudios.co.uk/basket/\"><span>Basket<span class=\"nav-basket-count\"><span></span></a>\r\n            </div>\r\n                        <div class=\"nav-item acc\">\r\n              <div class=\"acs-button\" aria-label = \"Open Accessibility menu\">\r\n                <span>Accessibility</span>\r\n              </div>\r\n            </div>\r\n\r\n          </nav>\r\n\r\n        </div>\r\n      </div>\r\n    </div>\r\n</header>\r\n\r\n\r\n<!-- <div class=\"basket-overlay\">\r\n  <div class=\"basket-nav\">\r\n    <div class=\"nav-item \">\r\n      <a class=\"nav-title has-icon close-basket basket-trigger\" href=\"\"><span>Basket</span></a>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"basket\">\r\n    <div class=\"basket-items\">\r\n      <div class=\"basket-title font-title font-medium font-uppercase font-white \">Basket</div>\r\n      <div class=\"basket-item\">\r\n        <span class=\"basket-item-name font-text font-white\">No Time to Die</span>\r\n        <span class=\"basket-item-date font-text font-white\">Monday Nov 2 at 20:00pm</span>\r\n        <span class=\"basket-item-price font-tag-small font-white\">Standard seating - £9.95</span>\r\n      </div>\r\n      <div class=\"basket-item\">\r\n        <span class=\"basket-item-name font-text font-white\">No Time to Die</span>\r\n        <span class=\"basket-item-date font-text font-white\">Monday Nov 2 at 20:00pm</span>\r\n        <span class=\"basket-item-price font-tag-small font-white\">Standard seating - £9.95</span>\r\n      </div>\r\n    </div>\r\n    <div class=\"basket-total\">\r\n      <span class=\"basket-total-label font-text font-white\">Total price</span>\r\n      <span class=\"basket-total-price font-small font-bold font-white\">£19.90</span>\r\n      <a href=\"\" class=\"button button-white\">Go to basket</a>\r\n    </div>\r\n\r\n  </div>\r\n\r\n\r\n</div> -->\r\n  <div class=\"video-modals\"></div>\n  <div class=\"side-logo riverside-logo\"><span></span></div>\n  <div class=\"side-logo studios-logo\"><span></span></div>\n\n    <div class=\"overlay\"></div>\n    <div class=\"overlay-login\"></div>\n\n    <div class=\"outer-container\">\n      <div id=\"main-content\" ></div>\n      <div class=\"filter-overlay\"></div>\n    <div class=\"gdad-data\" data-gdad=\"157656\"></div>\r\n<div class=\"page page-event-detail\">\r\n  <section class=\"template template-event-detail \">\r\n    <div class=\"template-top header-padding header-switch\">\r\n              <div class=\"image-container main\">\r\n          <div class=\"custom-image\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/24e6839d03f735a620bde1b22ffb218b.png&quot;,&quot;fx&quot;:&quot;57.3&quot;,&quot;fy&quot;:&quot;33.8&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;3240&quot;,&quot;height&quot;:&quot;2160&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\" style=\"background-image: url('https://riversidestudios.co.uk/assets/img/blank.png'); background-repeat: no-repeat; background-size: cover;\"></div>\r\n        </div>\r\n                    <div class=\"image-container thumb\">\r\n          <div class=\"custom-image\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/24e6839d03f735a620bde1b22ffb218b.png&quot;,&quot;fx&quot;:&quot;57.3&quot;,&quot;fy&quot;:&quot;33.8&quot;,&quot;cx&quot;:&quot;&quot;,&quot;cy&quot;:&quot;&quot;,&quot;cw&quot;:&quot;&quot;,&quot;ch&quot;:&quot;&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;3240&quot;,&quot;height&quot;:&quot;2160&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\" style=\"background-image: url('https://riversidestudios.co.uk/assets/img/blank.png'); background-repeat: no-repeat; background-size: cover;\"></div>\r\n        </div>\r\n            <div class=\"template-content-outer\">\r\n      <div class=\"template-content\">\r\n        <div class=\"container\">\r\n          <div class=\"template-content-inner\">\r\n                          <div class=\"template-availability font-blue font-uppercase font-tag font-title\"><span>London Breeze Film Festival</span></div>\r\n                                      <div class=\"template-surtitle font-yellow font-uppercase font-tag font-title\"><span>Film</span></div>\r\n            \r\n            <div class=\"template-title-top\">\r\n                              <h1 class=\"template-title font-title font-xlarge font-uppercase 0\"><span>London Breeze: On Falling + Director Q&A</span>\r\n</h1>\r\n              \r\n\r\n                              <div class=\"age-rating r-15\"></div>\r\n                            \r\n            </div>\r\n\r\n\r\n\r\n            \r\n            <div class=\"template-content-top\">\r\n\r\n                              <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Sunday 9 March 2025</span></div>\r\n              \r\n\r\n\r\n              \r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n              <div class=\"event-booking\">\r\n\r\n          <div class=\"booking-modal-back-container\">\r\n            <div class=\"container desktop-only-break-768\">\r\n              <div class=\"booking-modal-back-inner\">\r\n                <button class=\"booking-modal-back\">Back to Event page </button>\r\n\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n                  <div class=\"booking-progress-container\">\r\n            <div class=\"container desktop-only-break-768\">\r\n              <div class=\"booking-progress-inner\">\r\n                <div class=\"booking-progress date-action active\" data-progress=\"1\">\r\n                  <div class=\"booking-progress-icon \"></div>\r\n                  <div class=\"booking-progress-label\"><span>Select</span> Date & Time</div>\r\n                  <div class=\"booking-progress-data\"><span class=\"date\">Select Date & Time</span>  <span class=\"time\"></span></div>\r\n                </div>\r\n                <!-- <div class=\"booking-progress time-action\" data-progress=\"2\">\r\n                  <div class=\"booking-progress-icon \"></div>\r\n                  <div class=\"booking-progress-label\"><span>Select</span> Time</div>\r\n                  <div class=\"booking-progress-data\">Select Time</div>\r\n                </div> -->\r\n                                <div class=\"booking-progress seat-action\" data-progress=\"2\">\r\n                  <div class=\"booking-progress-icon \"></div>\r\n                  <div class=\"booking-progress-label\"><span>Select</span> Seats</div>\r\n                </div>\r\n                              </div>\r\n            </div>\r\n\r\n          </div>\r\n\r\n                  <div class=\"booking-modal \">\r\n            <div class=\"container desktop-only-break-768\">\r\n              <div class=\"booking-modal-inner\">\r\n\r\n                        <div class=\"booking-summary\">\r\n                  <div class=\"container mobile-only-break-768\">\r\n                    <nav class=\"booking-nav\">\r\n                                              <div class=\"booking-nav-item\">\r\n                          <a class=\"login\" href=\"https://riversidestudios.co.uk/account/login/\"><span>Login</span></a>\r\n                        </div>\r\n                                            <div class=\"booking-nav-item\">\r\n                        <a class=\"basket basket-trigger\" href=\"https://riversidestudios.co.uk/basket/\"><span>Basket<span class=\"nav-basket-count\"><span></span></a>\r\n                      </div>\r\n\r\n                    </nav>\r\n                    <div class=\"summary-title section-title font-blue font-uppercase font-small font-title\">Booking Summary</div>\r\n\r\n                    <div class=\"booking-summary-content\">\r\n                      <div class=\"tickets\">\r\n                        <div class=\"ticket\">\r\n                          <span class=\"ticket-date\"></span>\r\n                          <span class=\"ticket-time\"></span>\r\n                          <span class=\"ticket-type\"></span>\r\n                          <button class=\"edit-ticket button-text hidden\">Edit</button>\r\n                        </div>\r\n                      </div>\r\n                      <div class=\"booking-summary-total\">\r\n                        <span class=\"booking-total-label\">Total Price</span>\r\n                        <span class=\"booking-total\">£0</span>\r\n                      </div>\r\n\r\n\r\n\r\n\r\n\r\n                    </div>\r\n                    <div class=\"errors\"></div>\r\n                    <div class=\"messages\"></div>\r\n                    <button class=\"button button-pink go-to-basket\" disabled>Add to basket and Proceed to checkout</button>\r\n\r\n\r\n                  </div>\r\n                </div>\r\n\r\n                <div class=\"booking-section performance-time active\" data-section=\"1\">\r\n                  <div class=\"container mobile-only-break-768\">\r\n                    <div class=\"booking-section-content\">\r\n                      <div class=\"section-title font-blue font-uppercase font-small  font-title\">Select a date and time to book </div>\r\n                      <button class=\"button button-blue booking-next-step \" disabled data-action=\"2\">Next: Select ticket</button>\r\n\r\n                      <div class=\"booking-section-content-left\">\r\n                        <div class=\"booking-section-content-label\">Select Date</div>\r\n                        <div class=\"booking-section-field event-datepicker\"></div>\r\n\r\n                      </div>\r\n                      <div class=\"booking-section-content-right\">\r\n                        <div class=\"booking-section-content-label\">Select Time</div>\r\n\r\n                        <div class=\"booking-section-field performance-times\"></div>\r\n\r\n                      </div>\r\n\r\n\r\n                      <!-- <div class=\"section-title font-blue font-uppercase font-small  font-title\">Select a date and time to book time</div> -->\r\n\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n\r\n                                <div class=\"booking-section ticket-section-seats\" data-section=\"2\">\r\n                  <div class=\"container mobile-only-break-768\">\r\n                    <div class=\"booking-section-content\">\r\n\r\n                      <div class=\"section-title font-blue font-uppercase font-small  font-title\">Select your seats</div>\r\n                      <button class=\"button button-blue go-to-basket\" data-action=\"5\" disabled>Next: Checkout</button>\r\n\r\n                      <div class=\"booking-section-field\">\r\n                        <div id=\"priceBands\">\r\n                          <div class=\"price-band\" data-band=\"5\"><span class=\"icon\" style=\"background: #000000\"></span><span class=\"title\">Sold &nbsp;&nbsp;</span></div>\r\n                        </div>\r\n\r\n                        <div id=\"selectedArea\">\r\n                          <div class=\"zoom-label\">Viewing: <span class=\"zoomed-area\"></span></div>\r\n                          <div class=\"reset-zoom\">Reset</div>\r\n                        </div>\r\n\r\n                        <div id=\"seatSelector\" style=\"display: inline-block; position: relative; width: 100%; padding-bottom: 70%; vertical-align: middle; overflow: hidden; \">\r\n                          <svg style=\"position: absolute; left:0; top:0; width:100%; height:100%\" id=\"seatingPlan\" xmlns=\"http://www.w3.org/2000/svg\"></svg>\r\n                        </div>\r\n\r\n                        <div class=\"screen\">STAGE</div>\r\n\r\n                        <div id=\"selectedSeats\">\r\n                          <div class=\"selected-seat-title font-title font-uppercase font-blue font-small\">Selected Seats</div>\r\n\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                                <!-- <div class=\"booking-section\" data-section=\"5\">\r\n                  <div class=\"container mobile-only-break-768\">\r\n                    <div class=\"booking-section-content\">\r\n                      <div class=\"section-title font-blue font-uppercase font-small  font-title\">Checkout</div>\r\n\r\n                      <button class=\"button button-blue booking-next-step t\" data-action=\"6\">Checkout</button>\r\n                    </div>\r\n                  </div>\r\n                </div> -->\r\n\r\n                    </div>\r\n            </div>\r\n          </div>\r\n\r\n        </div>\r\n          </div>\r\n\r\n    </div>\r\n    <div class=\"template-bottom\">\r\n\r\n      <div class=\"container\">\r\n        <div class=\"template-bottom-inner\">\r\n          <div class=\"template-bottom-mobile\">\r\n\r\n\r\n            \r\n          </div>\r\n          <div class=\"template-left\">\r\n\r\n                                      <div class=\"te\">\r\n    <p><strong>London Breeze</strong> is excited to be supporting the opening weekend of <i>On Falling</i> as it releases into cinemas across the UK. Writer and director of the film, Laura Carriera will join us for a <strong>Q&amp;A </strong>after the screening.</p><p><i>On Falling</i> tells the story of Aurora (Joana Santos), a Portuguese migrant working who is a warehouse picker in Edinburgh. Trapped between the confines of a vast distribution centre and the solitude of her own bedroom, Aurora seeks out every opportunity to resist the loneliness and alienation that threaten her sense of self.</p><p><strong>BAFTA Longlisted for Outstanding Debut by a British Writer, Director or Producer </strong>and winner of the <strong>BFI London Film Festival Sutherland Award 2024 </strong>for the most original and imaginative directorial debut, Laura Carreira’s<i> On Falling </i>is co-produced by Ken Loach’s <strong>Sixteen Film </strong>production company.</p><p>&nbsp;</p><p>&nbsp;</p></div>            \r\n          </div>\r\n          <div class=\"template-right\">\r\n              \r\n                        <div class=\"event-details\">\r\n\r\n\r\n                            <div class=\"event-detail-section event-info\">\r\n\r\n                <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Rating Information: </div>\r\n\r\n                <div class=\"event-info-text age-rating text\"><span>15</span></div>\r\n              </div>\r\n\r\n                                          <div class=\"event-detail-section event-info\">\r\n                <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Run time:</div>\r\n                <div class=\"event-info-text\"><span>104 mins</span></div>\r\n              </div>\r\n\r\n              \r\n              \r\n              \r\n                              <div class=\"event-detail-section event-info\">\r\n                  <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Year of release:</div>\r\n                  <div class=\"event-info-text\"><span>2025</span></div>\r\n                </div>\r\n\r\n              \r\n                              <div class=\"event-detail-section event-info\">\r\n                  <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Company:</div>\r\n                  <div class=\"event-info-text\"><span>Conic</span></div>\r\n                </div>\r\n              \r\n                              <div class=\"event-detail-section event-info\">\r\n                  <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Director:</div>\r\n                  <div class=\"event-info-text\"><span>Laura Carreira</span></div>\r\n                </div>\r\n\r\n              \r\n                              <div class=\"event-detail-section event-info\">\r\n                  <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Cast:</div>\r\n                  <div class=\"event-info-text\"><span>Joana Santos, Inês Vaz, Piotr Sikora, Jake McGarry, Neil Leiper</span></div>\r\n                </div>\r\n\r\n              \r\n              \r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n              \r\n              \r\n              \r\n              <div class=\"performance_details\">\r\n                <div class=\"performance-label\">Select a time to book</div>\r\n                <div class=\"performance-day\">\r\n                  <div class=\"performance-date\">Sunday 9 March 2025</div>\r\n                  <div class=\"performance\">\r\n                    <div class=\"button button-blue book_performance_button\" data-id=\"y0m2AcZl||1111:15403\">17:50</div>\r\n                    <div class=\"tooltip\" data-tooltip_text=\"\" data-tooltip_theme=\"\"></div>\r\n                  </div>\r\n                </div>\r\n\r\n              </div>\r\n            </div>\r\n                                </div>\r\n\r\n\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n  </section>\r\n\r\n      <section class=\" blocks\" id=\"main\" role=\"main\">\n<section class=\"block block-media \">\n\n            <div class=\"block-header\">\n          <div class=\"container\">\n                        <h3 class=\"block-title font-title font-medium font-blue font-uppercase\">Trailer</h3>\n                                  </div>\n        </div>\n    \n    \n        \n  <div class=\"container-wide desktop-only-break-768\">\n    <div class=\"slot play-video has-video \">\n\n      <div class=\"slot-image image-container \">\n\n                                <div class=\"embed-video video_player\" >\n            <div style=\"padding:56.25% 0 0 0;position:relative;\"><iframe src=\"https://player.vimeo.com/video/1057550296?badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479\" frameborder=\"0\" allow=\"autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media\" style=\"position:absolute;top:0;left:0;width:100%;height:100%;\" title=\"ON FALLING 16x9 Trailer FINAL HQ\"></iframe></div><script src=\"https://player.vimeo.com/api/player.js\"></script>          </div>\n                    </div>\n\n          </div>\n</div>\n\n\n\n    \n</section>\n\n\n</section>\r\n  \r\n</div>\r\n\r\n<script id=\"_performance_time_template\" type=\"text/html\">\r\n  <div class=\"form-element form-element-checkbox\">\r\n    <input type=\"radio\" name=\"time\" value=\"<%= id %>\" id=\"<%= id %>\" data-price=\"<%= price %>\" <% if (!availability) { %>disabled=\"disabled\" <% } %> />\r\n    <label for=\"<%= id %>\"><span><%= time %></span>  <% if (!availability) { %><span class=\"sold-out\">SOLD OUT</span><% } %></label>\r\n    <% if (tooltip_name && tooltip_text) { %><div class=\"tooltip\" data-tooltip_text=\"<%= tooltip_text %>\" data-tooltip_theme=\"<%= tooltip_theme %>\"><%=tooltip_name %></div><% } %>\r\n  </div>\r\n</script>\r\n\r\n<script id=\"_ticket_type_template\" type=\"text/html\">\r\n  <div class=\"form-element-number-wrapper<%= !available ? ' price-band-sold-out' : '' %>\">\r\n    <div class=\"form-element form-element-number\">\r\n      <label>\r\n        <span class=\"ticket-price\">£<%= price %> / person</span>\r\n        <span class=\"ticket-type\"><%= name %></span>\r\n      </label>\r\n      <% if (available) { %>\r\n      <input type=\"number\" value=\"0\" />\r\n      <% } %>\r\n    </div>\r\n    <span class=\"description\"><%= available ? description : 'Sold Out' %></span>\r\n  </div>\r\n</script>\r\n\r\n<script id=\"_modal_ticket_type_template\" type=\"text/html\">\r\n  <div class=\"price-band-modal-ticket-button <%= !available ? ' price-band-sold-out' : '' %>\">\r\n    <span class=\"price-band-modal-ticket-name\">\r\n      <%= name %>\r\n\r\n    </span>\r\n    <span class=\"price-band-modal-ticket-price\">\r\n      £<%= price %>\r\n      <% if (description) { %>\r\n        <div class=\"tooltip\" data-tooltip_theme=\"ticket-modal\" data-tooltip_text=\"<%= available ? description : 'Sold Out' %>\"></div>\r\n      <% } %>\r\n    </span>\r\n    <span class=\"price-band-modal-ticket-description\"></span>\r\n\r\n  </div>\r\n</script>\r\n\r\n<script>\r\n  var event_data = {\"performance_dates\":[{\"id\":\"y0m2AcZl\",\"date\":\"2025-03-09\",\"availability\":1}],\"performance_times\":{\"y0m2AcZl\":[{\"id\":\"1111:15403\",\"price\":\"0.00\",\"time\":\"17:50\",\"raw_time\":\"1741542600\",\"venue\":\"Screen 1\",\"age_rating\":\"15\",\"reserved\":1,\"availability\":1,\"tooltip_name\":\"\",\"tooltip_text\":\"\",\"tooltip_theme\":\"\"}]},\"price_bands\":{\"1111:15403\":{\"176\":[{\"code\":\"full_price\",\"name\":\"General Seating\",\"price\":\"13.00\",\"min_quantity\":1,\"description\":\"\",\"list_only\":0,\"price_band_id\":176,\"available\":true},{\"code\":\"25 & Under\",\"name\":\"25 & Under\",\"price\":\"9.00\",\"min_quantity\":0,\"description\":\"Age verification may be required for our age restricted films.\\n\\nPlease note that by law we cannot permit entry to anyone that is under age for films certified 15 or over, even if they are accompanied by an adult.\\n\",\"list_only\":false,\"price_band_id\":176,\"available\":true}]}},\"performance_date_range\":\"Sunday 9 March 2025\"};\r\n</script>\r\n\r\n<div id=\"price_band_modal\">\r\n  <div class=\"price-band-modal-inner\">\r\n    <div class=\"price-band-modal-content\">\r\n      <div class=\"price-band-modal-title\">\r\n        Choose a Price Band\r\n      </div>\r\n      <div class=\"price-band-modal-description\"></div>\r\n      <div class=\"price-band-modal-tickets\"></div>\r\n      <div   class=\"price-band-modal-tickets-tooltips\"></div>\r\n      <div class=\"price-band-modal-close\">\r\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.or