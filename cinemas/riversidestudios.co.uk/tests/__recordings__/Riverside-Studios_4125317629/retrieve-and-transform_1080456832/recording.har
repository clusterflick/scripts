            "mimeType": "text/html; charset=utf-8",
            "size": 12770,
            "text": "<!DOCTYPE html>\n\n<!--[if lt IE 7]>\n<html lang=\"en\"\n      class=\"no-js ie legacy-ie lt-ie10 lt-ie9 lte-ie9 lt-ie8 lt-ie7\"> <![endif]-->\n<!--[if IE 7]>\n<html lang=\"en\"\n      class=\"no-js ie legacy-ie lt-ie10 lt-ie9 lte-ie9 lt-ie8\"> <![endif]-->\n<!--[if IE 8]>\n<html lang=\"en\" class=\"no-js ie legacy-ie lt-ie10 lt-ie9 lte-ie9\"> <![endif]-->\n<!--[if IE 9]>\n<html lang=\"en\" class=\"no-js ie legacy-ie lt-ie10\"> <![endif]-->\n<!--[if gt IE 9]><!-->\n<html lang=\"en\" class=\"no-js\"> <!--<![endif]-->\n<!--[if !IE]><!--><script>if(document.documentMode) document.documentElement.className+=' ie'+document.documentMode;</script><!--<![endif]-->\n\n<head>\n\n            <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\n                new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\n                j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n                'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n          })\n                              (window, document, 'script', 'dataLayer', 'GTM-W5VLL9M');\n                  </script>\n    \n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=Edge,chrome=1\">\n<title>Conclave\r\n | Riverside Studios</title>\n\n    <meta name=\"description\" content=\"&nbsp;Nominated for 8 Oscars for the 2025 ceremony including Best Picture.&nbsp;\"An entertainingly juicy adaptation of Robert Harris’s novel\" Guardian ★ ★ ★ ★The Pope has died. Cardinal Lawrence must lead the Conclave to select the new leader of\">\n    \n<meta charset=\"utf-8\">\n<meta name=\"author\" content=\"Conclave\r\n | Riverside Studios\">\n<meta name=\"generator\" content=\"Grandad Digital - Powered by You.Create Content Management System\">\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Organization\",\n  \"url\": \"https://riversidestudios.co.uk/\",\n  \"logo\": \"https://riversidestudios.co.uk/assets/img/logo.png\"\n}\n</script>\n<script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Event\",\"name\":\"Conclave\",\"description\":\"FROM THE DIRECTOR OF THE OSCAR-WINNING ALL QUIET ON THE WESTERN FRONT &nbsp;Nominated for 8 Oscars for the 2025 ceremony including Best Picture.&nbsp;\\\"An entertainingly juicy adaptation of Robert Harris\\u2019s novel\\\" Guardian \\u2605 \\u2605 \\u2605 \\u2605The Pope has died. Cardinal Lawrence must lead the Conclave to select the new leader of the Catholic world. But as high-ranking cardinals gather, he discovers sides have been drawn and secrets that might destroy a future pope, perhaps even the Church itself, threaten to be revealed. Following his Oscar-winning success with All Quiet on the Western Front, Edward Berger presents us with another tale of conflict, albeit one where battles are waged in hushed tones in hallowed hallways. Fiennes, Tucci and John Lithgow make the most of Peter Straughan\\u2019s (Tinker Tailor Soldier Spy) screenplay, based on Robert Harris\\u2019 2016 novel, with Isabella Rossellini making a cameo as the formidable Sister Agnes.\",\"image\":[\"https:\\/\\/riversidestudios.co.uk\\/images\\/uploads\\/ef8a678bd696b40f4761bc7b5ce0ecd2.jpeg\"],\"startDate\":\"2025-03-04T20:20:00+00:00\",\"endDate\":\"2025-03-06T17:40:00+00:00\",\"eventStatus\":\"https:\\/\\/schema.org\\/EventScheduled\"}</script>\n<link rel=\"shortcut icon\" href=\"https://riversidestudios.co.uk/assets/favicons/favicon.ico?1651755466\" />\n    <link href=\"https://riversidestudios.co.uk/see-and-do/conclave-143690/\" rel=\"canonical\"/>\n\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=5, user-scalable=yes\"/>\n<link rel=\"dns-prefetch\" href=\"https://riversidestudios.co.uk/\"/>\n<link rel=\"stylesheet\" href=\"//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css\">\n<!-- <link rel=\"stylesheet\" type=\"text/css\" href=\"https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css\" /> -->\n\n<link href=\"https://riversidestudios.co.uk/assets/css/styles.min.css?v=b660f5e1efcf1b00290891e9f653159e\" rel=\"stylesheet\" type=\"text/css\" />\n<script>\n  document.documentElement.className = document.documentElement.className.replace(/\\bno-js\\b/, 'js');\n  var base_url = 'https://riversidestudios.co.uk/',\n    gdrck = '6LffRNoZAAAAAJIWWC7QG27lobOmUg6S4sE9GI8k',\n  gdmaps = {},\n    $ajaxRequestSent = false;\n</script>\n\n    <script>\n      var gdEvents = false;\n    </script>\n    \n\n            <meta property=\"og:type\" content=\"website\"/>\n                        <meta property=\"og:title\" content=\"Conclave - Riverside Studios\"/>\n                        <meta property=\"og:url\" content=\"https://riversidestudios.co.uk/see-and-do/conclave-143690/\"/>\n                        <meta property=\"og:image\" content=\"https://riversidestudios.co.uk/images/uploads/ef8a678bd696b40f4761bc7b5ce0ecd2.jpeg\"/>\n                        <meta property=\"og:description\" content=\"&nbsp;Nominated for 8 Oscars for the 2025 ceremony including Best Picture.&nbsp;'An entertainingly juicy adaptation of Robert Harris’s novel' Guardian ★ ★ ★ ★The Pope has died. Cardinal Lawrence must lead the Conclave to select the new leader of\"/>\n                        <meta property=\"og:site_name\" content=\"Riverside Studios\"/>\n                        <meta property=\"og:locale\" content=\"EN_GB\"/>\n                        <meta property=\"twitter:card\" content=\"summary_large_image\"/>\n                        <meta property=\"twitter:site\" content=\"@RiversideLondon\"/>\n                        <meta property=\"twitter:creator\" content=\"@RiversideLondon\"/>\n                        <meta property=\"twitter:title\" content=\"Conclave - Riverside Studios\"/>\n                        <meta property=\"twitter:description\" content=\"&nbsp;Nominated for 8 Oscars for the 2025 ceremony including Best Picture.&n