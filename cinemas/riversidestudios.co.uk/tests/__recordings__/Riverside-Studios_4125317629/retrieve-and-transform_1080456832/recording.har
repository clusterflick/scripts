": \"https://riversidestudios.co.uk/assets/img/logo.png\"\n}\n</script>\n<script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Event\",\"name\":\"Black Bag\",\"description\":\"FROM STEVEN SODERBERGH - THE DIRECTOR OF TRAFFIC AND OUT OF SIGHT... Black Bag follows legendary intelligence agent George Woodhouse - a spy who can\\u2019t be lied to - who relentlessly pursues his targets, and is steadfast in his loyalty to his country. When a device that could result in hundreds of thousands of deaths goes missing, George has only seven days to find the traitor who stole it. When he discovers that his beloved wife and a fellow spy, Kathryn, is one of the five suspects, George faces the ultimate test \\u2013 his love for Kathryn or his loyalty to his country.\",\"image\":[\"https:\\/\\/riversidestudios.co.uk\\/images\\/uploads\\/2bf1abfbe2140c32a6082cc848507145.jpg\"],\"startDate\":\"2025-03-14T17:45:00+00:00\",\"endDate\":\"2025-03-20T18:05:00+00:00\",\"eventStatus\":\"https:\\/\\/schema.org\\/EventScheduled\"}</script>\n<link rel=\"shortcut icon\" href=\"https://riversidestudios.co.uk/assets/favicons/favicon.ico?1651755466\" />\n    <link href=\"https://riversidestudios.co.uk/see-and-do/black-bag-165332/\" rel=\"canonical\"/>\n\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=5, user-scalable=yes\"/>\n<link rel=\"dns-prefetch\" href=\"https://riversidestudios.co.uk/\"/>\n<link rel=\"stylesheet\" href=\"//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css\">\n<!-- <link rel=\"stylesheet\" type=\"text/css\" href=\"https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css\" /> -->\n\n<link href=\"https://riversidestudios.co.uk/assets/css/styles.min.css?v=b660f5e1efcf1b00290891e9f653159e\" rel=\"stylesheet\" type=\"text/css\" />\n<script>\n  document.documentElement.className = document.documentElement.className.replace(/\\bno-js\\b/, 'js');\n  var base_url = 'https://riversidestudios.co.uk/',\n  