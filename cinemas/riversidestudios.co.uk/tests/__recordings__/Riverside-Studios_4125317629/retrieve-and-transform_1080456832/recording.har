id-item event\">\n  <div class=\"slot event\">\n    \n          <div class=\"slot-image\">\n        <a href=\"https://riversidestudios.co.uk/see-and-do/mulholland-drive-157198/\">\n          <div class=\"image image-container\"><img src=\"https://riversidestudios.co.uk/assets/img/blank.png\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/a805097e95862a4f6583efbfe4735b55.jpeg&quot;,&quot;fx&quot;:&quot;47.2&quot;,&quot;fy&quot;:&quot;40.6&quot;,&quot;cx&quot;:&quot;328&quot;,&quot;cy&quot;:&quot;5&quot;,&quot;cw&quot;:&quot;897&quot;,&quot;ch&quot;:&quot;895&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;1600&quot;,&quot;height&quot;:&quot;900&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  alt=\"\"/></div>\n        </a>\n      </div>\n        <div class=\"slot-content\">\n      <!-- <div class=\"slot-content-inner\"> -->\n\n\n      <div class=\"slot-top\">\n                    <div class=\"slot-date tag date font-uppercase font-tag-small font-blue\"> 29 Mar 2025</div>\n        \n      </div>\n                <h4 class=\"slot-title font-small font-uppercase font-title font-blue\">\n            <a href=\"https://riversidestudios.co.uk/see-and-do/mulholland-drive-157198/\" class=\"font-blue\">\n              <span>Mulholland Drive</span>\r\n            </a>\n          </h4>\n            <div class=\"slot-bottom\">\n                  <div class=\"event-tag slot-tag font-tag-small font-uppercase font-blue \"><span>Film</span></div>\n        \n                  <div class=\"event-tag slot-rating r-18\"></div>\n        \n\n\n        <div class=\"slot-button\">\n          <a href=\"https://riversidestudios.co.uk/see-and-do/mulholland-drive-157198/\" class=\"button button-blue\">Book now</a>\n        </div>\n      </div>\n\n\n\n    </div>\n\n  </div>\n</div>\n      </div>\n\n\n\n  </div>\n\n\n</section>\n</section>\r\n  \r\n</div>\r\n\r\n<script id=\"_performance_time_template\" type=\"text/html\">\r\n  <div class=\"form-element form-element-checkbox\">\r\n    <input type=\"radio\" name=\"time\" value=\"<%= id %>\" id=\"<%= id %>\" data-price=\"<%= price %>\" <% if (!availability) { %>disabled=\"disabled\" <% } %> />\r\n    <label for=\"<%= id %>\"><span><%= time %></span>  <% if (!availability) { %><span class=\"sold-out\">SOLD OUT</span><% } %></label>\r\n    <% if (tooltip_name && tooltip_text) { %><div class=\"tooltip\" data-tooltip_text=\"<%= tooltip_text %>\" data-tooltip_theme=\"<%= tooltip_theme %>\"><%=tooltip_name %></div><% } %>\r\n  </div>\r\n</script>\r\n\r\n<script id=\"_ticket_type_template\" type=\"text/html\">\r\n  <div class=\"form-element-number-wrapper<%= !available ? ' price-band-sold-out' : '' %>\">\r\n    <div class=\"form-element form-element-number\">\r\n      <label>\r\n        <span class=\"ticket-price\">£<%= price %> / person</span>\r\n        <span class=\"ticket-type\"><%= name %></span>\r\n      </label>\r\n      <% if (available) { %>\r\n      <input type=\"number\" value=\"0\" />\r\n      <% } %>\r\n    </div>\r\n    <span class=\"description\"><%= available ? description : 'Sold Out' %></span>\r\n  </div>\r\n</script>\r\n\r\n<script id=\"_modal_ticket_type_template\" type=\"text/html\">\r\n  <div class=\"price-band-modal-ticket-button <%= !available ? ' price-band-sold-out' : '' %>\">\r\n    <span class=\"price-band-modal-ticket-name\">\r\n      <%= name %>\r\n\r\n    </span>\r\n    <span class=\"price-band-modal-ticket-price\">\r\n      £<%= price %>\r\n      <% if (description) { %>\r\n        <div class=\"tooltip\" data-tooltip_theme=\"ticket-modal\" data-tooltip_text=\"<%= available ? description : 'Sold Out' %>\"></div>\r\n      <% } %>\r\n    </span>\r\n    <span class=\"price-band-modal-ticket-description\"></span>\r\n\r\n  </div>\r\n</script>\r\n\r\n<script>\r\n  var event_data = {\"performance_dates\":[{\"id\":\"HG3eoQc2\",\"date\":\"2025-03-29\",\"availability\":1}],\"performance_times\":{\"HG3eoQc2\":[{\"id\":\"1111:15386\",\"price\":\"0.00\",\"time\":\"13:00\",\"raw_time\":\"1743253200\",\"venue\":\"Screen 1\",\"age_rating\":\"18\",\"reserved\":1,\"availability\":1,\"tooltip_name\":\"\",\"tooltip_text\":\"\",\"tooltip_theme\":\"\"}]},\"price_bands\":{\"1111:15386\":{\"176\":[{\"code\":\"full_price\",\"name\":\"General Seating\",\"price\":\"12.00\",\"min_quantity\":1,\"description\":\"\",\"list_only\":0,\"price_band_id\":176,\"available\":true},{\"code\":\"25 & Under\",\"name\":\"25 & Under\",\"price\":\"8.00\",\"min_quantity\":0,\"description\":\"Age verification may be required for our age restricted films.\\n\\nPlease note that by law we cannot permit entry to anyone that is under age for films certified 15 or over, even if they are accompanied by an adult.\\n\",\"list_only\":false,\"price_band_id\":176,\"available\":true},{\"code\":\"Dive In Members\",\"name\":\"Dive In Members\",\"price\":\"8.00\",\"min_quantity\":0,\"description\":\"Our new reduced price for our Dive In members. Please note that proof of Dive In membership may be required upon entry. For more information on membership, please see our website.\",\"list_only\":false,\"price_band_id\":176,\"available\":true}]}},\"performance_date_range\":\"Saturday 29 March 2025\"};\r\n</script>\r\n\r\n<div id=\"price_band_modal\">\r\n  <div class=\"price-band-modal-inner\">\r\n    <div class=\"price-band-modal-content\">\r\n      <div class=\"price-band-modal-title\">\r\n        Choose a Price Band\r\n      </div>\r\n      <div class=\"price-band-modal-description\"></div>\r\n      <div class=\"price-band-modal-tickets\"></div>\r\n      <div   class=\"price-band-modal-tickets-tooltips\"></div>\r\n      <div class=\"price-band-modal-close\">\r\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n          <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\" stroke=\"black\" stroke-width=\"2\" stroke-linecap=\"round\"/>\r\n          <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\" stroke=\"black\" stroke-width=\"2\" strok