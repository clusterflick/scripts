r: #00782A;\r\n                    }\r\n                    .tippy-box[data-theme~='Christmas-Special'][data-placement^='left'] > .tippy-arrow::before {\r\n                        border-left-color: #00782A;\r\n                    }\r\n                    .tippy-box[data-theme~='Christmas-Special'][data-placement^='right'] > .tippy-arrow::before {\r\n                        border-right-color: #00782A;\r\n                    }\r\n                    \r\n                    .tippy-box[data-theme~='Pay-What-You-Can'] {\r\n                        background-color: #00782A;\r\n                    }\r\n                    .tippy-box[data-theme~='Pay-What-You-Can'][data-placement^='top'] > .tippy-arrow::before {\r\n                        border-top-color: #00782A;\r\n                    }\r\n                    .tippy-box[data-theme~='Pay-What-You-Can'][data-placement^='bottom'] > .tippy-arrow::before {\r\n                        border-bottom-color: #00782A;\r\n                    }\r\n                    .tippy-box[data-theme~='Pay-What-You-Can'][data-placement^='left'] > .tippy-arrow::before {\r\n                        border-left-color: #00782A;\r\n                    }\r\n                    .tippy-box[data-theme~='Pay-What-You-Can'][data-placement^='right'] > .tippy-arrow::before {\r\n                        border-right-color: #00782A;\r\n                    }\r\n                    \r\n                    .tippy-box[data-theme~='Special-Disco-cise-Edition'] {\r\n                        background-color: #00782A;\r\n                    }\r\n                    .tippy-box[data-theme~='Special-Disco-cise-Edition'][data-placement^='top'] > .tippy-arrow::before {\r\n                        border-top-color: #00782A;\r\n                    }\r\n                    .tippy-box[data-theme~='Special-Disco-cise-Edition'][data-placement^='bottom'] > .tippy-arrow::before {\r\n                        border-bottom-color: #00782A;\r\n                    }\r\n                  