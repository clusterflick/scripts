ce-band-sold-out' : '' %>\">\r\n    <div class=\"form-element form-element-number\">\r\n      <label>\r\n        <span class=\"ticket-price\">£<%= price %> / person</span>\r\n        <span class=\"ticket-type\"><%= name %></span>\r\n      </label>\r\n      <% if (available) { %>\r\n      <input type=\"number\" value=\"0\" />\r\n      <% } %>\r\n    </div>\r\n    <span class=\"description\"><%= available ? description : 'Sold Out' %></span>\r\n  </div>\r\n</script>\r\n\r\n<script id=\"_modal_ticket_type_template\" type=\"text/html\">\r\n  <div class=\"price-band-modal-ticket-button <%= !available ? ' price-band-sold-out' : '' %>\">\r\n    <span class=\"price-band-modal-ticket-name\">\r\n      <%= name %>\r\n\r\n    </span>\r\n    <span class=\"price-band-modal-ticket-price\">\r\n      £<%= price %>\r\n      <% if (description) { %>\r\n        <div class=\"tooltip\" data-tooltip_theme=\"ticket-modal\" data-tooltip_text=\"<%= available ? description : 'Sold Out' %>\"></div>\r\n      <% } %>\r\n    </span>\r\n    <span class=\"price-band-modal-ticket-description\"></span>\r\n\r\n  </div>\r\n</script>\r\n\r\n<script>\r\n  var event_data = {\"performance_dates\":[{\"id\":\"lEEMlWww\",\"date\":\"2025-03-05\",\"availability\":1}],\"performance_times\":{\"lEEMlWww\":[{\"id\":\"1111:15456\",\"price\":\"0.00\",\"time\":\"20:00\",\"raw_time\":\"1741204800\",\"venue\":\"Screen 2\",\"age_rating\":\"PG\",\"reserved\":1,\"availability\":1,\"tooltip_name\":\"\",\"tooltip_text\":\"\",\"tooltip_theme\":\"\"}]},\"price_bands\":{\"1111:15456\":{\"128\":[{\"code\":\"full_price\",\"name\":\"General\",\"price\":\"12.00\",\"min_quantity\":1,\"description\":\"\",\"list_only\":0,\"price_band_id\":128,\"available\":true},{\"code\":\"25 & Under\",\"name\":\"25 & Under\",\"price\":\"8.00\",\"min_quantity\":0,\"description\":\"Age verification may be required for our age restricted films.\\n\\nPlease note that by law we cannot permit entry to anyone that is under age for films certified 15 or ove