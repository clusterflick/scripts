span></span></div>\n  <div class=\"side-logo studios-logo\"><span></span></div>\n\n  <div class=\"membership-container\"></div>\n    <div class=\"overlay\"></div>\n    <div class=\"overlay-login\"></div>\n    <main class=\"outer-container\"  id=\"main-content\"  >\n      <div class=\"filter-overlay\"></div>\n          \r\n\r\n\r\n\r\n\r\n\r\n<div class=\"page page-event\">\r\n  <section class=\"template template-event-detail play-container has-modal  has-text-bottom      \">\r\n\r\n\r\n  \r\n\r\n\r\n    <div class=\"template-top header-padding header-switch\">\r\n                <div class=\"image-container \">\r\n                                <picture>\r\n                    <source sizes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/04/a7749556dd4a013c79f3cbb33025d1/w880/q80/wpojpg/images/uploads/04a7749556dd4a013c79f3cbb33025d1.webp 880w,https://riversidestudios.co.uk/images/custom/04/a7749556dd4a013c79f3cbb33025d1/w1210/q80/wpojpg/images/uploads/04a7749556dd4a013c79f3cbb33025d1.webp 1210w,https://riversidestudios.co.uk/images/custom/04/a7749556dd4a013c79f3cbb33025d1/w1470/q80/wpojpg/images/uploads/04a7749556dd4a013c79f3cbb33025d1.webp 1470w,https://riversidestudios.co.uk/images/custom/04/a7749556dd4a013c79f3cbb33025d1/w1680/q80/wpojpg/images/uploads/04a7749556dd4a013c79f3cbb33025d1.webp 1680w,https://riversidestudios.co.uk/images/custom/04/a7749556dd4a013c79f3cbb33025d1/w1870/q80/wpojpg/images/uploads/04a7749556dd4a013c79f3cbb33025d1.webp 1870w,https://riversidestudios.co.uk/images/custom/04/a7749556dd4a013c79f3cbb33025d1/w2048/q80/wpojpg/images/uploads/04a7749556dd4a013c79f3cbb33025d1.webp 2048w,https://riversidestudios.co.uk/images/custom/04/a7749556dd4a013c79f3cbb33025d1/w2052/q80/wpojpg/images/uploads/04a7749556dd4a013c79f3cbb33025d1.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position: 49.9% 50.0% \" src=\"https://riversidestudios.co.uk/images/custom/04/a7749556dd4a013c79f3cbb33025d1/w880/q80/images/uploads/04a7749556dd4a013c79f3cbb33025d1.jpg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/04a7749556dd4a013c79f3cbb33025d1.jpg&quot;,&quot;fx&quot;:&quot;49.9&quot;,&quot;fy&quot;:&quot;50.0&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;2052&quot;,&quot;height&quot;:&quot;2092&quot;,&quot;orientation&quot;:&quot;portrait&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/04/a7749556dd4a013c79f3cbb33025d1/w880/q80/images/uploads/04a7749556dd4a013c79f3cbb33025d1.jpg 880w,https://riversidestudios.co.uk/images/custom/04/a7749556dd4a013c79f3cbb33025d1/w1210/q80/images/uploads/04a7749556dd4a013c79f3cbb33025d1.jpg 1210w,https://riversidestudios.co.uk/images/custom/04/a7749556dd4a013c79f3cbb33025d1/w1470/q80/images/uploads/04a7749556dd4a013c79f3cbb33025d1.jpg 1470w,https://riversidestudios.co.uk/images/custom/04/a7749556dd4a013c79f3cbb33025d1/w1680/q80/images/uploads/04a7749556dd4a013c79f3cbb33025d1.jpg 1680w,https://riversidestudios.co.uk/images/custom/04/a7749556dd4a013c79f3cbb33025d1/w1870/q80/images/uploads/04a7749556dd4a013c79f3cbb33025d1.jpg 1870w,https://riversidestudios.co.uk/images/custom/04/a7749556dd4a013c79f3cbb33025d1/w2048/q80/images/uploads/04a7749556dd4a013c79f3cbb33025d1.jpg 2048w,https://riversidestudios.co.uk/images/custom/04/a7749556dd4a013c79f3cbb33025d1/w2052/q80/images/uploads/04a7749556dd4a013c79f3cbb33025d1.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                   \r\n                  <div class=\"template-surtitle font-yellow font-uppercase font-tag font-title\">Cinema</div>  \r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Pitchblack Mixtapes: Logical Progression (Disc 1) (30th Anniversary)</span>\r\n              \r\n                     </h1>\r\n                                                <div class=\"age-rating r-15\" title=\"15\"></div>\r\n                                              <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Wed 29 Jul 2026 20:00</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"dEZRM3B6dVZGV29NYjUxNHhFVmEvZz09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <h3>*Please arrive by event start time as latecomers will not be admitted and refunds will not be offered*</h3><p>Immerse yourself in one of the greatest electronic compilations of all-time at Pitchblack Playback's listening session in the dark, celebrating the 30th anniversary of LTJ Bukem's seminal 'Logical Progression'. Hear Disc 1 of this hugely influential deep atmospheric jungle testament played loud in uncompressed audio on our powerful Screen One cinema sound system.</p><p>No phones; no talking; no singing; no distractions; just you and the music.</p><p>&nbsp;</p><p>\"This sounds great” — Rick Rubin</p><p>\"A fabulous idea\" — Jay Kay, Jamiroquai</p><p>\"The optimal way to listen to an album\" — Max Richter</p><p>\"This might just be my favourite new thing to do\" — Nihal, BBC Radio 5 Live</p><p>&nbsp;</p><p>Ticket includes recycled cotton Pitchblack Playback eye mask for extra darkness.</p><p>As recommended by The Guardian, GQ, Time Out and BBC 6 Music.</p><figure class=\"table\"><table><tbody><tr><td><strong>Age Rating:</strong></td><td>15</td></tr><tr><td><strong>Language:</strong></td><td>English</td></tr><tr><td><strong>Cast:</strong></td><td>LTJ Bukem</td></tr><tr><td><strong>Company:</strong></td><td>Pitchblack Playback</td></tr><tr><td><strong>Interval:</strong></td><td>None</td></tr><tr><td><strong>Trailers:</strong></td><td>None</td></tr><tr><td><strong>Year of Release:</strong></td><td>1996</td></tr></tbody></table></figure></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">77 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n        \n\n<section class=\"block block-events-list\">\n\n\n  <div class=\"container\">\n                <div class=\"block-header has-button\">\n            <div class=\"block-head