iv>\n  <div class=\"side-logo studios-logo\"><span></span></div>\n\n  <div class=\"membership-container\"></div>\n    <div class=\"overlay\"></div>\n    <div class=\"overlay-login\"></div>\n    <main class=\"outer-container\"  id=\"main-content\"  >\n      <div class=\"filter-overlay\"></div>\n          \r\n\r\n\r\n\r\n\r\n\r\n<div class=\"page page-event\">\r\n  <section class=\"template template-event-detail play-container has-modal  has-text-bottom      \">\r\n\r\n\r\n  \r\n\r\n\r\n    <div class=\"template-top header-padding header-switch\">\r\n                <div class=\"image-container \">\r\n                                <picture>\r\n                    <source sizes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/3d/84011edba3d9f1ac1e142d8bfea407/w880/q80/wpojpg/images/uploads/3d84011edba3d9f1ac1e142d8bfea407.webp 880w,https://riversidestudios.co.uk/images/custom/3d/84011edba3d9f1ac1e142d8bfea407/w1210/q80/wpojpg/images/uploads/3d84011edba3d9f1ac1e142d8bfea407.webp 1210w,https://riversidestudios.co.uk/images/custom/3d/84011edba3d9f1ac1e142d8bfea407/w1470/q80/wpojpg/images/uploads/3d84011edba3d9f1ac1e142d8bfea407.webp 1470w,https://riversidestudios.co.uk/images/custom/3d/84011edba3d9f1ac1e142d8bfea407/w1680/q80/wpojpg/images/uploads/3d84011edba3d9f1ac1e142d8bfea407.webp 1680w,https://riversidestudios.co.uk/images/custom/3d/84011edba3d9f1ac1e142d8bfea407/w1870/q80/wpojpg/images/uploads/3d84011edba3d9f1ac1e142d8bfea407.webp 1870w,https://riversidestudios.co.uk/images/custom/3d/84011edba3d9f1ac1e142d8bfea407/w1998/q80/wpojpg/images/uploads/3d84011edba3d9f1ac1e142d8bfea407.webp 2048w,https://riversidestudios.co.uk/images/custom/3d/84011edba3d9f1ac1e142d8bfea407/w1998/q80/wpojpg/images/uploads/3d84011edba3d9f1ac1e142d8bfea407.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position:  50%  50% \" src=\"https://riversidestudios.co.uk/images/custom/3d/84011edba3d9f1ac1e142d8bfea407/w880/q80/images/uploads/3d84011edba3d9f1ac1e142d8bfea407.jpg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/3d84011edba3d9f1ac1e142d8bfea407.jpg&quot;,&quot;fx&quot;:&quot;&quot;,&quot;fy&quot;:&quot;&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;1998&quot;,&quot;height&quot;:&quot;1080&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/3d/84011edba3d9f1ac1e142d8bfea407/w880/q80/images/uploads/3d84011edba3d9f1ac1e142d8bfea407.jpg 880w,https://riversidestudios.co.uk/images/custom/3d/84011edba3d9f1ac1e142d8bfea407/w1210/q80/images/uploads/3d84011edba3d9f1ac1e142d8bfea407.jpg 1210w,https://riversidestudios.co.uk/images/custom/3d/84011edba3d9f1ac1e142d8bfea407/w1470/q80/images/uploads/3d84011edba3d9f1ac1e142d8bfea407.jpg 1470w,https://riversidestudios.co.uk/images/custom/3d/84011edba3d9f1ac1e142d8bfea407/w1680/q80/images/uploads/3d84011edba3d9f1ac1e142d8bfea407.jpg 1680w,https://riversidestudios.co.uk/images/custom/3d/84011edba3d9f1ac1e142d8bfea407/w1870/q80/images/uploads/3d84011edba3d9f1ac1e142d8bfea407.jpg 1870w,https://riversidestudios.co.uk/images/custom/3d/84011edba3d9f1ac1e142d8bfea407/w1998/q80/images/uploads/3d84011edba3d9f1ac1e142d8bfea407.jpg 2048w,https://riversidestudios.co.uk/images/custom/3d/84011edba3d9f1ac1e142d8bfea407/w1998/q80/images/uploads/3d84011edba3d9f1ac1e142d8bfea407.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                   \r\n                  <div class=\"template-surtitle font-yellow font-uppercase font-tag font-title\">Cinema</div>  \r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>The Last One for the Road</span>\r\n              \r\n                     </h1>\r\n                                                <div class=\"age-rating r-15\" title=\"15\"></div>\r\n                                              <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Fri 10 - Tue 14 Jul 2026</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"SEhSUEVYUGdVMXZCSFQ3UUx5c0VIdz09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <blockquote><p>“Loosely reminiscent of the happy-sad fables of Alice Rohrwacher, Francesco Sossai’s boozy dramedy is enchanting” - Tomris Laffly, Variety</p><p>\" a leisurely Beckettian bender through northeastern Italy\" - BFI Sight &amp; Sound Magazine</p></blockquote><h3>World Premiere: CANNES FILM FESTIVAL - Un Certain Regard 2025</h3><p>Surviving bar-to-bar on anecdotes and the ‘good old days’, two blustery 50-somethings hatch a plan to change their luck by digging up the cash their old pal buried before he left for Argentina. En route to the airport, they come across a shy architecture student whose view of life will transform as they take him under their wing on a road trip across the Venetian plains.</p><p><i><strong>THE LAST ONE FOR THE ROAD</strong></i> is the award-winning, critically-acclaimed, festival-favourite, boozy road movie you didn’t know you needed this summer. Take a trip across Northern Italy with this charming adventure including fabulous performances by Filippo Scotti (<i>The Hand of God</i>), Sergio Romano, and Pierpaolo Capovilla.</p><figure class=\"table\"><table><tbody><tr><td><strong>Age Rating:</strong></td><td>15</td></tr><tr><td><strong>Language:</strong></td><td>Italian with subtitles</td></tr><tr><td><strong>Content Warnings:</strong></td><td>strong language, brief drug misuse, nudity</td></tr><tr><td><strong>Director:</strong></td><td>Francesco Sossai</td></tr><tr><td><strong>Cast:</strong></td><td>Filippo Scotti, Sergio Romano, Pierpaolo Capovilla, Roberto Citran, Andrea Pennacchi</td></tr><tr><td><strong>Company:</strong></td><td>Bulldog Film Distribution</td></tr><tr><td><strong>Trailers:</strong></td><td>20 mins</td></tr><tr><td><strong>Year of Release:</strong></td><td>2026</td></tr></tbody></table></figure></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">100 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n        \n\n<section class=\"block block-events-list\">\n\n\n  <div class=\"container\">\n                <div class=\"block-header has-button\">\n            <div class=\"block-header-left\">\n            <h3 class=\"block-title font-medium font-title font-uppercase font-blue\"><span>Upcoming Cinema</span>\r\n</h3>\n                                </div>\n                      \n          </div>\n            <div class=\"grid\">\n          \n\n<div class=\"grid-item event\">\n  <div class=\"slot event\">\n    \n          <div class=\"slot-image\">\n        <a href=\"https://riversidestudios.co.uk/whats-on/hr-the-invite/\">\n        <div class=\"image-container\">\n                            <picture>\n                  <source sizes=\"(min-width: 1780px) calc(-4.1vw + 484px), (min-width: 1240px) calc(22.12vw + 23px), (min-width: 780px) calc(27.5vw - 21px), (min-width: 460px) 375px, calc(76.43vw + 39px)\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/4d/8da94b4c5c654e2c977b1fd0bdbe66/w400/q80/wpojpeg/images/uploads/4d8da94b4c5c654e2c977b1fd0bdbe66.webp 400w,https://riversidestudios.co.uk/images/custom/4d/8da94b4c5c654e2c977b1fd0bdbe66/w500/q80/wpojpeg/images/uploads/4d8da94b4c5c654e2c977b1fd0bdbe66.webp 500w,https://riversidestudios.co.uk/images/custom/4d/8da94b4c5c654e2c977b1fd0bdbe66/w600/q80/wpojpeg/images/uploads/4d8da94b4c5c654e2c977b1fd0bdbe66.webp 600w,https://riversidestudios.co.uk/images/custom/4d/8da94b4c5c654e2c977b1fd0bdbe66/w700/q80/wpojpeg/images/uploads/4d8da94b4c5c654e2c977b1fd0bdbe66.webp 700w,https://riversidestudios.co.uk/images/custom/4d/8da94b4c5c654e2c977b1fd0bdbe66/w900/q80/wpojpeg/images/uploads/4d8da94b4c5c654e2c977b1fd0bdbe66.webp 900w,https://riversidestudios.co.uk/images/custom/4d/8da94b4c5c654e2c977b1fd0bdbe66/w1100/q80/wpojpeg/images/uploads/4d8da94b4c5c654e2c977b1fd0bdbe66.webp 1100w,https://riversidestudios.co.uk/images/custom/4d/8da94b4c5c6