\n                                                <div class=\"age-rating r-15\" title=\"15\"></div>\r\n                                              <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Mon 13 Jul 2026 20:00</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"bXZhVEozVmJhMnRqSitPK1dFT1RQdz09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <h3>*Please arrive by event start time as latecomers will not be admitted and refunds will not be offered*</h3><p>Immerse yourself in one of the greatest hip hop albums of all-time at <strong>Pitchblack Playback'</strong>s listening session in the dark, celebrating its 30th anniversary. Hear this stunning album played loud in uncompressed audio on our powerful Screen One cinema sound system.</p><p>No phones; no talking; no signing; no distractions; just you and the music.</p><p>&nbsp;</p><p>\"This sounds great” — Rick Rubin</p><p>\"A fabulous idea\" — Jay Kay, Jamiroquai</p><p>\"The optimal way to listen to an album\" — Max Richter</p><p>\"This might just be my favourite new thing to do\" — Nihal, BBC Radio 5 Live</p><p>&nbsp;</p><p><strong>Ticket includes recycled cotton Pitchblack Playback eye mask for extra darkness.</strong></p><p><strong>As recommended by The Guardian, GQ, Time Out and BBC 6 Music.</strong></p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">60 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n        \n\n<section class=\"block block-events-list\">\n\n\n  <div class=\"container\">\n                <div class=\"block-header has-button\">\n            <div class=\"block-header-left\">\n            <h3 class=\"block-title font-medium font-title font-uppercase font-blue\"><span>Upcoming Cinema</span>\r\n</h3>\n                                </div>\n                      \n          </div>\n            <div class=\"grid\">\n          \n\n<div class=\"grid-item event\">\n  <div class=\"slot event\">\n    \n          <div class=\"slot-image\">\n        <a href=\"https://riversidestudios.co.uk/whats-on/hr-the-invite/\">\n        <div class=\"image-container\">\n                            <picture>\n                  <source sizes=\"(min-width: 1780px) calc(-4.1vw + 484px), (min-width: 1240px) calc(22.12vw + 23px), (min-width: 780px) calc(27.5vw - 21px), (min-width: 460px) 375px, calc(76.43vw + 39px)\" type=\"image/webp\" srcset=\"https://riversidestud