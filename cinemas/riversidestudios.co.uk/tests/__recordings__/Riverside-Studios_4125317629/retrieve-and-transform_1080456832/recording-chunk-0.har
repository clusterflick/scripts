font-xsmall font-blue\">Explore Riverside's unique history as a multi-arts venue and meet our current team.</div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/about-us/our-story/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Our Story\" role=\"menuitem\">\n                      Our Story                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/about-us/our-archive/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Our Archive\" role=\"menuitem\">\n                      Our Archive                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/about-us/the-team/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"The Team\" role=\"menuitem\">\n                      The Team                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n<div class=\"nav-item has-sub-nav\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"Memberships\">\n        Memberships    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>Join & Support Us</span>\r\n</div>\n                \n\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Get more from Riverside Studios with our range of membership options, offering priority booking, discounted tickets and invitations to special events.  \r\n</div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/memberships/riverside-pass/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Riverside Pass\" role=\"menuitem\">\n                      Riverside Pass                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/memberships/dive-in-membership/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Dive In Membership\" role=\"menuitem\">\n                      Dive In Membership                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/memberships/founder-members/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Founder Members\" role=\"menuitem\">\n                      Founder Members                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/memberships/make-a-donation/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Make a Donation\" role=\"menuitem\">\n                      Make a Donation                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n<div class=\"nav-item has-sub-nav\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"Hire Us / Work With Us\">\n        Hire Us / Work With Us    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>Hire Us / Work With Us</span>\r\n</div>\n                \n\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Comprehensive venue information and contact details for those wanting to bring their production to Riverside Studios, to host a private event or to work here. </div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/hire-us-work-with-us/private-events-and-office-hire/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Private Events and Office Hire\" role=\"menuitem\">\n                      Private Events and Office Hire                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/hire-us-work-with-us/bring-a-show-or-workshop/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Bring a Show or Workshop\" role=\"menuitem\">\n                      Bring a Show or Workshop                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/hire-us-work-with-us/community-partnership-enquiries/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Community & Partnership Enquiries\" role=\"menuitem\">\n                      Community & Partnership Enquiries                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n            <div class=\"nav-item \">\r\n              <a class=\"nav-title has-icon search\" href=\"https://riversidestudios.co.uk/search/\"><span>Search</span></a>\r\n            </div>\r\n          </nav>\r\n          <nav class=\"shop-nav container mobile-only-break-1024\">\r\n                        <div class=\"member-nav\" data-url=\"https://spektrix.riversidestudios.co.uk/riversidestudios/api/v3/customer?$expand=subscriptions\" class=\"nav-item\"></div>\r\n                        <div class=\"nav-item\">\r\n            \t<a draggable=\"false\"  class=\"nav-title has-icon basket basket-trigger\" href=\"https://riversidestudios.co.uk/basket/\"><span>Basket</span> </a>\r\n            </div>\r\n            <div class=\"nav-item acc\">\r\n\r\n              <div class=\"acs-button\" aria-label = \"Open Accessibility menu\">\r\n                <span>Accessibility</span>\r\n              </div>\r\n            </div>\r\n\r\n          </nav>\r\n\r\n        </div>\r\n      </div>\r\n    </div>\r\n</header>\n  <div class=\"video-modals\"></div>\n  <div class=\"side-logo riverside-logo\"><span></span></div>\n  <div class=\"side-logo studios-logo\"><span></span></div>\n\n  <div class=\"membership-container\"></div>\n    <div class=\"overlay\"></div>\n    <div class=\"overlay-login\"></div>\n    <main class=\"outer-container\"  id=\"main-content\"  >\n      <div class=\"filter-overlay\"></div>\n          \r\n\r\n\r\n\r\n\r\n\r\n<div class=\"page page-event\">\r\n  <section class=\"template template-event-detail play-container has-modal  has-text-bottom      \">\r\n\r\n\r\n  \r\n\r\n\r\n    <div class=\"template-top header-padding header-switch\">\r\n                <div class=\"image-container \">\r\n                                <picture>\r\n                    <source sizes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/46/b4c3d13ab5aa848a91e7c808035df3/w880/q80/wpojpg/images/uploads/46b4c3d13ab5aa848a91e7c808035df3.webp 880w,https://riversidestudios.co.uk/images/custom/46/b4c3d13ab5aa848a91e7c808035df3/w1200/q80/wpojpg/images/uploads/46b4c3d13ab5aa848a91e7c808035df3.webp 1210w,https://riversidestudios.co.uk/images/custom/46/b4c3d13ab5aa848a91e7c808035df3/w1200/q80/wpojpg/images/uploads/46b4c3d13ab5aa848a91e7c808035df3.webp 1470w,https://riversidestudios.co.uk/images/custom/46/b4c3d13ab5aa848a91e7c808035df3/w1200/q80/wpojpg/images/uploads/46b4c3d13ab5aa848a91e7c808035df3.webp 1680w,https://riversidestudios.co.uk/images/custom/46/b4c3d13ab5aa848a91e7c808035df3/w1200/q80/wpojpg/images/uploads/46b4c3d13ab5aa848a91e7c808035df3.webp 1870w,https://riversidestudios.co.uk/images/custom/46/b4c3d13ab5aa848a91e7c808035df3/w1200/q80/wpojpg/images/uploads/46b4c3d13ab5aa848a91e7c808035df3.webp 2048w,https://riversidestudios.co.uk/images/custom/46/b4c3d13ab5aa848a91e7c808035df3/w1200/q80/wpojpg/images/uploads/46b4c3d13ab5aa848a91e7c808035df3.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position: 60.5% 87.1% \" src=\"https://riversidestudios.co.uk/images/custom/46/b4c3d13ab5aa848a91e7c808035df3/w880/q80/images/uploads/46b4c3d13ab5aa848a91e7c808035df3.jpg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/46b4c3d13ab5aa848a91e7c808035df3.jpg&quot;,&quot;fx&quot;:&quot;60.5&quot;,&quot;fy&quot;:&quot;87.1&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;1200&quot;,&quot;height&quot;:&quot;800&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/46/b4c3d13ab5aa848a91e7c808035df3/w880/q80/images/uploads/46b4c3d13ab5aa848a91e7c808035df3.jpg 880w,https://riversidestudios.co.uk/images/custom/46/b4c3d13ab5aa848a91e7c808035df3/w1200/q80/images/uploads/46b4c3d13ab5aa848a91e7c808035df3.jpg 1210w,https://riversidestudios.co.uk/images/custom/46/b4c3d13ab5aa848a91e7c808035df3/w1200/q80/images/uploads/46b4c3d13ab5aa848a91e7c808035df3.jpg 1470w,https://riversidestudios.co.uk/images/custom/46/b4c3d13ab5aa848a91e7c808035df3/w1200/q80/images/uploads/46b4c3d13ab5aa848a91e7c808035df3.jpg 1680w,https://riversidestudios.co.uk/images/custom/46/b4c3d13ab5aa848a91e7c808035df3/w1200/q80/images/uploads/46b4c3d13ab5aa848a91e7c808035df3.jpg 1870w,https://riversidestudios.co.uk/images/custom/46/b4c3d13ab5aa848a91e7c808035df3/w1200/q80/images/uploads/46b4c3d13ab5aa848a91e7c808035df3.jpg 2048w,https://riversidestudios.co.uk/images/custom/46/b4c3d13ab5aa848a91e7c808035df3/w1200/q80/images/uploads/46b4c3d13ab5aa848a91e7c808035df3.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Rehearsal Room</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Wed 10 - Wed 31 Dec 2025</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"VTMyaGVMQmpmdm80cUFGbUlwNUVJQT09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p>Whether you're rehearsing an upcoming production, organising a table read, or want to invite guests to a sharing, our Rehearsal Room offers the ideal setup. Designed with flexibility in mind, this 100m² space is equipped with everything you need to bring your creative vision to life.</p><p>&nbsp;</p><p><strong>Seamless, Stress-Free Booking</strong></p><p>Our new booking system is as simple as it gets – no deposits, no back-and-forth emails, just a quick online payment with your credit card. Choose your slot, confirm your booking, and you’re all set!</p><p><i>Daily Time Slots Available, 7 days a week:</i></p><p><i>- 9 am - 1 pm</i></p><p><i>- 2 pm - 6 pm</i></p><p><i>- 7 pm - 11 pm</i></p><p>From only £15/hr (£60 per slot), you get access to a versatile rehearsal room with everything you need for a productive session.</p><p>&nbsp;</p><p><strong>Pricing</strong></p><p>£15/hr (£60 per slot)</p><p>We are booking until the end of October 2025 - future dates will be released at a later date.</p><p>20% discount when booking multiple slots in the same transaction.</p><p>50% ‘day of’ discount, if space is available.</p><p><strong>Please note that these rates are for private rehearsal space bookings and not for ticketed or private events. If you would like to enquire about hiring the space beyond a simple rehearsal please do so here: </strong><a href=\"https://riversidestudios.co.uk/rehearsal-room/\" target=\"_blank\" rel=\"noopener noreferrer\"><strong>https://riversidestudios.co.uk/rehearsal-room/</strong></a></p><p>&nbsp;</p><p><strong>Room Highlights</strong></p><p>- Capacity: Comfortably accommodates up to 20 people.</p><p>- Specifications: 102 m², frosted windows for privacy, but lots of natural light during the day.</p><p>- Speaker available on request, subject to availability.</p><p>- Furniture: Includes two trestle tables and eight stackable chairs, giving you the freedom to arrange the space as you need. You can bring additional pieces as required.</p><p>- Access: An access code will be provided upon arrival.</p><p>- Setup &amp; Reset: Please ensure the room is left as you found it for the next guests. It is fully cleaned and serviced daily.</p><p>- Vinyl floor (not carpet).</p><p>- Suitable for music.</p><p>- Ample power outlets.</p><p>- Fully wheelchair accessible.</p><p>- Pet-friendly.</p><p>- Bathrooms down a very short corridor nearby.</p><p>- Our delightful Bakery to keep you caffeinated/snacked during the day, and our Bar &amp; Kitchen to keep you fed and watered after your full creative day.</p><p>&nbsp;</p><p><strong>Why Choose Riverside Studios?</strong></p><p>Riverside Studios offers more than just space – it’s a creative hub with an atmosphere designed to inspire and support your work. Our rehearsal room is versatile, easy to book, and affordable to help you focus on what matters most: your craft.</p><p>For any questions or if you are interested in exclusive hire, long-term booking, or booking our spaces for corporate/other events, please get in touch with us at&nbsp;<span id=\"e1822004278\">[javascript protected email address]</span><script type=\"text/javascript\">/*<![CDATA[*/eval(\"var a=\\\"+R3@KYjLXU-AV0ZJeQOnN.w5Suymt_TbF7qlWPIh4rcvdxs2zfgoiBG8EC61HpDaMk9\\\";var b=a.split(\\\"\\\").sort().join(\\\"\\\");var c=\\\"xDxGH106fDx61fdx1Hpdf813v83po\\\";var d=\\\"\\\";for(var e=0;e<c.length;e++)d+=b.charAt(a.indexOf(c.charAt(e)));document.getElementById(\\\"e1822004278\\\").innerHTML=\\\"<a href=\\\\\\\"mailto:\\\"+d+\\\"\\\\\\\" class=\\\\\\\"link-email \\\\\\\">\\\"+d+\\\"</a>\\\"\")/*]]>*/</script></p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n      