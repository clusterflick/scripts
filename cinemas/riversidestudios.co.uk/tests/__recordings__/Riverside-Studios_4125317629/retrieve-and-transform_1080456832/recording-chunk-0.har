                   <picture>\r\n                    <source sizes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/f6/d35809652dfc4dcb1df2851c75bcbc/w880/q80/wpojpg/images/uploads/f6d35809652dfc4dcb1df2851c75bcbc.webp 880w,https://riversidestudios.co.uk/images/custom/f6/d35809652dfc4dcb1df2851c75bcbc/w1210/q80/wpojpg/images/uploads/f6d35809652dfc4dcb1df2851c75bcbc.webp 1210w,https://riversidestudios.co.uk/images/custom/f6/d35809652dfc4dcb1df2851c75bcbc/w1470/q80/wpojpg/images/uploads/f6d35809652dfc4dcb1df2851c75bcbc.webp 1470w,https://riversidestudios.co.uk/images/custom/f6/d35809652dfc4dcb1df2851c75bcbc/w1680/q80/wpojpg/images/uploads/f6d35809652dfc4dcb1df2851c75bcbc.webp 1680w,https://riversidestudios.co.uk/images/custom/f6/d35809652dfc4dcb1df2851c75bcbc/w1870/q80/wpojpg/images/uploads/f6d35809652dfc4dcb1df2851c75bcbc.webp 1870w,https://riversidestudios.co.uk/images/custom/f6/d35809652dfc4dcb1df2851c75bcbc/w2048/q80/wpojpg/images/uploads/f6d35809652dfc4dcb1df2851c75bcbc.webp 2048w,https://riversidestudios.co.uk/images/custom/f6/d35809652dfc4dcb1df2851c75bcbc/w2880/q80/wpojpg/images/uploads/f6d35809652dfc4dcb1df2851c75bcbc.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position: 43.7% 38.6% \" src=\"https://riversidestudios.co.uk/images/custom/f6/d35809652dfc4dcb1df2851c75bcbc/w880/q80/images/uploads/f6d35809652dfc4dcb1df2851c75bcbc.jpg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/f6d35809652dfc4dcb1df2851c75bcbc.jpg&quot;,&quot;fx&quot;:&quot;43.7&quot;,&quot;fy&quot;:&quot;38.6&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;5184&quot;,&quot;height&quot;:&quot;3456&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/f6/d35809652dfc4dcb1df2851c75bcbc/w880/q80/images/uploads/f6d35809652dfc4dcb1df2851c75bcbc.jpg 880w,https://riversidestudios.co.uk/images/custom/f6/d35809652dfc4dcb1df2851c75bcbc/w1210/q80/images/uploads/f6d35809652dfc4dcb1df2851c75bcbc.jpg 1210w,https://riversidestudios.co.uk/images/custom/f6/d35809652dfc4dcb1df2851c75bcbc/w1470/q80/images/uploads/f6d35809652dfc4dcb1df2851c75bcbc.jpg 1470w,https://riversidestudios.co.uk/images/custom/f6/d35809652dfc4dcb1df2851c75bcbc/w1680/q80/images/uploads/f6d35809652dfc4dcb1df2851c75bcbc.jpg 1680w,https://riversidestudios.co.uk/images/custom/f6/d35809652dfc4dcb1df2851c75bcbc/w1870/q80/images/uploads/f6d35809652dfc4dcb1df2851c75bcbc.jpg 1870w,https://riversidestudios.co.uk/images/custom/f6/d35809652dfc4dcb1df2851c75bcbc/w2048/q80/images/uploads/f6d35809652dfc4dcb1df2851c75bcbc.jpg 2048w,https://riversidestudios.co.uk/images/custom/f6/d35809652dfc4dcb1df2851c75bcbc/w2880/q80/images/uploads/f6d35809652dfc4dcb1df2851c75bcbc.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Baby Broadway</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Fri 19 Dec 2025 11:00</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"L0RGOUthWFhEazNKY2ZrZzJRb3RVUT09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p><strong>This December, join us for a magical Baby Broadway concert that brings the spirit of Christmas to life for families with young children! </strong>Sing and dance along to festive showtunes from hit musicals and beloved Christmas films, all performed by two talented West End singers.</p><p>Enjoy classic songs from <i>Elf, White Christmas, The Snowman, Frozen</i>, and more. Festive fancy dress is encouraged, and the fun doesn’t stop there: expect bubbles, bells, flying babies, and puppetry for a truly interactive concert experience.</p><p>Open to all ages from newborns to school-aged kids and grandparents, this 45-minute concert is the perfect way to celebrate the holiday season. Doors open 15 minutes before showtime. This lively concert is all about the music, with no costumes or elaborate staging - just festive fun for all.</p><p><strong>Open to all ages (recommended 0-7). Babies under 12 months go free and do not require a ticket.</strong></p><p><strong>Have Yourself a Merry Little Christmas with Baby Broadway!</strong></p><p>&nbsp;</p><p>Visit the <a href=\"http://www.babybroadway.co.uk/\" target=\"_blank\" rel=\"noopener noreferrer\">Baby Broadway website</a> for more information.</p><blockquote><p><i>“Tip-top show tunes that worm their way into ears of all ages” - Time Out London</i></p><p><i>\"Actually entertaining for adults and simply magical for the kids\" -&nbsp;@daddyshortlegs</i></p></blockquote></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">45 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n    \r\n</div>\r\n  </main>\n\r\n<footer class=\"footer\">\r\n\r\n  <div class=\"container-wide desktop-only-break-1024\">\r\n    <div class=\"footer-inner\">\r\n\r\n\r\n      <div class=\"footer-navs\">\r\n\r\n\r\n                  <div class=\"footer-section\">\r\n\r\n                            <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">See Also</h5>\r\n                            <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/newsletter-signup/\">Newsletter signup</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/vacancies/\">Vacancies</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/policies/\">Policies</a>\r\n                        <div id=\"member-login\"></div>\r\n          </div>\r\n\r\n        \r\n                  <div class=\"footer-section\">\r\n\r\n            <div class=\"footer-nav-top\">\r\n                                <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase