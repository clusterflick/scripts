fa3ac4f46039c2b6f631d3a1b54fe.jpg 1680w,https://riversidestudios.co.uk/images/custom/5b/dfa3ac4f46039c2b6f631d3a1b54fe/w1870/q80/images/uploads/5bdfa3ac4f46039c2b6f631d3a1b54fe.jpg 1870w,https://riversidestudios.co.uk/images/custom/5b/dfa3ac4f46039c2b6f631d3a1b54fe/w2048/q80/images/uploads/5bdfa3ac4f46039c2b6f631d3a1b54fe.jpg 2048w,https://riversidestudios.co.uk/images/custom/5b/dfa3ac4f46039c2b6f631d3a1b54fe/w2048/q80/images/uploads/5bdfa3ac4f46039c2b6f631d3a1b54fe.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Too Small to Tell</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Mon 16 Feb - Wed 4 Mar 2026</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"YmlWV2dRZWdpblU0V20vV2JGTFlPQT09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p><strong>Written and performed by Lisa Rose</strong></p><p>North London actress and writer&nbsp;<strong>Lisa Rose</strong>&nbsp;brings her powerful and darkly funny solo show&nbsp;<i><strong>Too Small to&nbsp;Tell</strong></i>to the stage — a deeply personal story inspired by her experiences working for a now-notorious film mogul in the 1990s.</p><p>Blending humour and heartbreak, Rose explores power, silence, and survival in an industry built on secrets. Following&nbsp;<strong>sold-out performances at Park Theatre</strong>&nbsp;and&nbsp;<strong>packed houses at Upstairs at the Gatehouse</strong>, the play was&nbsp;<strong>shortlisted for Best New Play at Brighton Fringe 2025</strong>.</p><p>Directed by&nbsp;<strong>Elizabeth Ranken</strong>&nbsp;and co-created with&nbsp;<strong>Paula B. Stanic</strong>, *<i>Too Small to&nbsp;Tell</i>&nbsp;is a timely and gripping exploration of resilience, sisterhood, and speaking truth to power.</p><blockquote><p><i>\"Truthful, touching, timely, terrific!\"</i><br><i>\"A story that should never stop being told.\"</i></p></blockquote><p>&nbsp;</p><p>@toosmalltotell |&nbsp;<a href=\"https://www.facebook.com/toosmalltotell\" target=\"_blank\" rel=\"noopener noreferrer\">facebook.com/toosmalltotell</a></p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n    \r\n</div>\r\n  </main>\n\r\n<footer class=\"footer\">\r\n\r\n  <div class=\"container-wide desktop-only-break-1024\">\r\n    <div class=\"footer-inner\">\r\n\r\n\r\n      <div class=\"footer-navs\">\r\n\r\n\r\n                  <div class=\"footer-section\">\r\n\r\n                            <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">See Also</h5>\r\n                            <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/newsletter-signup/\">Newsletter signup</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/vacancies/\">Vacancies</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/policies/\">Policies</a>\r\n                        <div id=\"member-login\"></div>\r\n          </div>\r\n\r\n        \r\n                  <div class=\"footer-section\">\r\n\r\n            <div class=\"footer-nav-top\">\r\n                                <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">Our Website</h5>\r\n                                <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/privacy-and-cookies/\">Privacy and Cookies</a>\r\n                              <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/website-accessibility/\">Website Accessibility</a>\r\n                          </div>\r\n          </div>\r\n\r\n        \r\n        \r\n        \r\n              </div>\r\n\r\n\r\n\r\n      <div class=\"footer-bottom\">\r\n        <div class=\"footer-logos\">\r\n        </div>\r\n\r\n                  <div class=\"footer-social\">\r\n            <div class=\"footer-social-inner\">\r\n              <nav class=\"social-icons \">\r\n                <a href=\"https://www.facebook.com/RiversideStudiosLondon/\" class=\"fa