os.co.uk/images/custom/9f/0bce23114cd236efd0247b584af573/w1093/q80/images/uploads/9f0bce23114cd236efd0247b584af573.jpg 2048w,https://riversidestudios.co.uk/images/custom/9f/0bce23114cd236efd0247b584af573/w1093/q80/images/uploads/9f0bce23114cd236efd0247b584af573.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>The Jolly Djembe Club</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Sat 13 Dec 2025 - Sat 24 Jan 2026</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"VTBjVnNlbmY0VktWc3RQTEE2Wk5hZz09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p>Don't miss out on an unforgettable cultural adventure at Riverside Studios! Join Mangotree Kids as we bring the vibrant energy of Africa to life with our&nbsp;<strong>Jolly Djembe African Drumming</strong>&nbsp;session. Kids will embark on a thrilling journey to discover the rhythms of Africa, learning the art of African Djembe drumming, new songs, and infectious beats.&nbsp;</p><p>But that's not all—young adventurers will also take part in an exciting mission to help us save our endangered mangoes before the rainy season arrives through our inactive storytelling. This is a celebration filled with music, fun, and cultural exploration.&nbsp;</p><p><strong>Book your spot now</strong>&nbsp;for a magical experience like no other!</p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">60 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n    \r\n</div>\r\n  </main>\n\r\n<footer class=\"footer\">\r\n\r\n  <div class=\"container-wide desktop-only-break-1024\">\r\n    <div class=\"footer-inner\">\r\n\r\n\r\n      <div class=\"footer-navs\">\r\n\r\n\r\n                  <div class=\"footer-section\">\r\n\r\n                            <h5 class=\"footer-nav-title font-xxsmall font-title fo