a05c3b5ad90eafe25f/w1870/q80/images/uploads/b396fb3869d6cca05c3b5ad90eafe25f.jpg 1870w,https://riversidestudios.co.uk/images/custom/b3/96fb3869d6cca05c3b5ad90eafe25f/w1920/q80/images/uploads/b396fb3869d6cca05c3b5ad90eafe25f.jpg 2048w,https://riversidestudios.co.uk/images/custom/b3/96fb3869d6cca05c3b5ad90eafe25f/w1920/q80/images/uploads/b396fb3869d6cca05c3b5ad90eafe25f.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Kill Bill: The Whole Bloody Affair</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Sat 10 - Sun 11 Jan 2026</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"UjVTeHJxTDZtSjdXbXhiR0orbHZ1QT09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <h2>For our Quentin Tarantino Weekender on 10-11 January you can enjoy 20% off the adult price if you buy a ticket for ONE UPON A TIME IN HOLLYWOOD + Q&amp;A on 10 Jan and a ticket to one of the KILL BILL: THE WHOLE BLOODY AFFAIR screenings on the same weekend!</h2><p>Get ready to return to the grindhouse — Lionsgate is bringing Quentin Tarantino’s legendary revenge saga back to the big screen with <i><strong>KILL BILL: THE WHOLE BLOODY AFFAIR</strong></i>.</p><p>For the first time, experience <strong>Volumes 1 &amp; 2 </strong>seamlessly united in one epic cinematic event — featuring a never-before-seen scene that makes this the ultimate Tarantino cut.</p><p>&nbsp;</p><p><i><strong>Includes a 15 minute intermission.</strong></i></p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">241 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n    \r\n</div>\r\n  </main>\n\r\n<footer class=\"footer\">\r\n\r\n  <div class=\"container-wide desktop-only-break-1024\">\r\n    <div class=\"footer-inner\">\r\n\r\n\r\n      <div class=\"footer-navs\">\r\n\r\n\r\n                  <div c