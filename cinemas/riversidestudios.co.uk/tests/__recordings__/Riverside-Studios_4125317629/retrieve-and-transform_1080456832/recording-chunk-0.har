ustom\\/4d\\/a633230e1207168254909a2b9e1060\\/w1280\\/q80\\/wpopng\\/cx296\\/cw674\\/ch676\\/images\\/uploads\\/4da633230e1207168254909a2b9e1060.webp 1680w\",\"https:\\/\\/riversidestudios.co.uk\\/images\\/custom\\/4d\\/a633230e1207168254909a2b9e1060\\/w1280\\/q80\\/wpopng\\/cx296\\/cw674\\/ch676\\/images\\/uploads\\/4da633230e1207168254909a2b9e1060.webp 1870w\",\"https:\\/\\/riversidestudios.co.uk\\/images\\/custom\\/4d\\/a633230e1207168254909a2b9e1060\\/w1280\\/q80\\/wpopng\\/cx296\\/cw674\\/ch676\\/images\\/uploads\\/4da633230e1207168254909a2b9e1060.webp 2048w\",\"https:\\/\\/riversidestudios.co.uk\\/images\\/custom\\/4d\\/a633230e1207168254909a2b9e1060\\/w1280\\/q80\\/wpopng\\/cx296\\/cw674\\/ch676\\/images\\/uploads\\/4da633230e1207168254909a2b9e1060.webp 2880w\"],\"focal_point\":[\"50\",\"50\"],\"search_text\":\"PalesTEENian is a solo, semi-autobiographical show about Joe growing up Palestinian in South London. It's a play about identity, coming of age and Palestine but where humour and heart is at the centre of it. Joe grows up confused, goes back to Palestine, sees it change, sees himself change, and embarks on a journey to being a stand-up comedy star with the finals of a massive stand-up competition happening...October 2023.Age recommendation: 16+\",\"book_link\":false,\"event_type\":[\"81021\"],\"search\":\"PalesTEENian PalesTEENian Bitesize  <p><i><strong>PalesTEENian<\\/strong> <\\/i>is a solo, semi-autobiographical show about Joe growing up Palestinian in South London. It's a play about identity, coming of age and Palestine but where humour and heart is at the centre of it. Joe grows up confused, goes back to Palestine, sees it change, sees himself change, and embarks on a journey to being a stand-up comedy star with the finals of a massive stand-up competition happening...October 2023.<\\/p><p><strong>Age recommendation: 16+<\\/strong><\\/p> PalesTEENian  PalesTEENian is a solo, semi-autobiographical show about Joe growing up Palestinian in South London. It's a play about identity, coming of age and Palestine but where humour and heart is at the centre of it. Joe grows up confused, goes back to Palestine, sees it change, sees himself change, and embarks on a journey to being a stand-up comedy star with the finals of a massive stand-up competition happening...October 2023.Age recommendation: 16+ Bitesize\"},{\"url\":\"https:\\/\\/riversidestudios.co.uk\\/whats-on\\/Yg-we-had-fun\\/\",\"id\":\"3735\",\"name\":\"We Had Fun\",\"title\":\"We Had Fun\",\"duration\":\"60 minutes\",\"slot_tag\":\"Bitesize\",\"link_title\":\"More Info\",\"performances\":{\"1785106800\":[{\"tag_ids\":[\"81021\"],\"tag_name\":\"\",\"html\":\"<a class=\\\"performance button\\\" href=\\\"https:\\/\\/riversidestudios.co.uk\\/seats\\/232206\\/\\\">\\n   \\n      <div class=\\\"performance-time\\\" data-acc=\\\"\\\">19:00<\\/div>\\n    \\n<\\/a>\\n\",\"timestamp\":\"1785175200\",\"accessibility_class\":\"\"}],\"1785193200\":[{\"tag_ids\":[\"81021\"],\"tag_name\":\"\",\"html\":\"<a class=\\\"performance button\\\" href=\\\"https:\\/\\/riversidestudios.co.uk\\/seats\\/232416\\/\\\">\\n   \\n      <div class=\\\"performance-time\\\" data-acc=\\\"\\\">20:45<\\/div>\\n    \\n<\\/a>\\n\",\"timestamp\":\"1785267900\",\"accessibility_class\":\"\"}],\"1785279600\":[{\"tag_ids\":[\"81021\"],\"tag_name\":\"\",\"html\":\"<a class=\\\"performance button\\\" href=\\\"https:\\/\\/riversidestudios.co.uk\\/seats\\/235001\\/\\\">\\n   \\n      <div class=\\\"performance-time\\\" data-acc=\\\"\\\">20:45<\\/div>\\n    \\n<\\/a>\\n\",\"timestamp\":\"1785354300\",\"accessibility_class\":\"\"}]},\"performance_dates\":[1785106800,1785193200,1785279600],\"times\":[1785175200,1785267900,1785354300],\"start_date\":\"1785175200\",\"end_date\":\"1785354300\",\"age_rating_class\":\"\",\"ticket_free\":false,\"priority_booking\":true,\"hash\":\"V0RTK1prNlExYWw1dmN3aXYrWXpaZz09\",\"embed_id\":\"\",\"embed_host\":\"\",\"date_formatted\":\"Mon 27 - Wed 29 Jul 2026\",\"text\":\"W