alse;\n    </script>\n    \n\n      <meta property=\"og:type\" content=\"website\">\n                  <meta property=\"og:title\" content=\"Kill Bill: The Whole Bloody Affair - Riverside Studios\">\n                  <meta property=\"og:url\" content=\"https://riversidestudios.co.uk/whats-on/1k-kill-bill-the-whole-bloody-affair/\">\n                  <meta property=\"og:image\" content=\"https://riversidestudios.co.uk/images/uploads/b396fb3869d6cca05c3b5ad90eafe25f.jpg\">\n                  <meta property=\"og:image:secure_url\" content=\"https://riversidestudios.co.uk/images/uploads/b396fb3869d6cca05c3b5ad90eafe25f.jpg\">\n                  <meta property=\"og:description\" content=\"For our Quentin Tarantino Weekender on 10-11 January you can enjoy 20% off the adult price if you buy a ticket for ONE UPON A TIME IN HOLLYWOOD + Q&amp;A on 10 Jan and a ticket to one of the KILL BILL: THE WHOLE BLOODY AFFAIR screenings on the same weeken\">\n                  <meta property=\"og:site_name\" content=\"Riverside Studios\">\n                  <meta property=\"og:locale\" content=\"EN_GB\">\n                  <meta property=\"twitter:card\" content=\"summary_large_image\">\n                  <meta property=\"twitter:site\" content=\"@RiversideLondon\">\n                  <meta property=\"twitter:creator\" content=\"@RiversideLondon\">\n                  <meta property=\"twitter:title\" content=\"Kill Bill: The Whole Bloody Affair - Riverside Studios\">\n                  <meta property=\"twitter:description\" content=\"For our Quentin Tarantino Weekender on 10-11 January you can enjoy 20% off the adult price if you buy a ticket for ONE UPON A TIME IN HOLLYWOOD + Q&amp;A on 10 Jan and a ticket to one of the KILL BILL: THE WHOLE BLOODY AFFAIR screenings on the same weeken\">\n                  <meta property=\"twitter:image:src\" content=\"https://riversidestudios.co.uk/images/uploads/b396fb3869d6cca05c3b5ad90eafe25f.jpg\">\n                  <meta property=\"twitter:image