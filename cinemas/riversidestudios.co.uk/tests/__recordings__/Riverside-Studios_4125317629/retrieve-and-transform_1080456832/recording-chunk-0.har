sidestudios.co.uk/images/custom/82/a91fc4423ef2810d1285b601e80736/w1210/q80/wpopng/images/uploads/82a91fc4423ef2810d1285b601e80736.webp 1210w,https://riversidestudios.co.uk/images/custom/82/a91fc4423ef2810d1285b601e80736/w1240/q80/wpopng/images/uploads/82a91fc4423ef2810d1285b601e80736.webp 1470w,https://riversidestudios.co.uk/images/custom/82/a91fc4423ef2810d1285b601e80736/w1240/q80/wpopng/images/uploads/82a91fc4423ef2810d1285b601e80736.webp 1680w,https://riversidestudios.co.uk/images/custom/82/a91fc4423ef2810d1285b601e80736/w1240/q80/wpopng/images/uploads/82a91fc4423ef2810d1285b601e80736.webp 1870w,https://riversidestudios.co.uk/images/custom/82/a91fc4423ef2810d1285b601e80736/w1240/q80/wpopng/images/uploads/82a91fc4423ef2810d1285b601e80736.webp 2048w,https://riversidestudios.co.uk/images/custom/82/a91fc4423ef2810d1285b601e80736/w1240/q80/wpopng/images/uploads/82a91fc4423ef2810d1285b601e80736.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position: 42.6% 47.5% \" src=\"https://riversidestudios.co.uk/images/custom/82/a91fc4423ef2810d1285b601e80736/w880/q80/images/uploads/82a91fc4423ef2810d1285b601e80736.png\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/82a91fc4423ef2810d1285b601e80736.png&quot;,&quot;fx&quot;:&quot;42.6&quot;,&quot;fy&quot;:&quot;47.5&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;1240&quot;,&quot;height&quot;:&quot;874&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/82/a91fc4423ef2810d1285b601e80736/w880/q80/images/uploads/82a91fc4423ef2810d1285b601e80736.png 880w,https://riversidestudios.co.uk/images/custom/82/a91fc4423ef2810d1285b601e80736/w1210/q80/images/uploads/82a91fc4423ef2810d1285b601e80736.png 1210w,https://riversidestudios.co.uk/images/custom/82/a91fc4423ef2810d1285b601e80736/w1240/q80/images/uploads/82a91fc4423ef2810d1285b601e80736.png 1470w,https://riversidestudios.co.uk/images/custom/82/a91fc4423ef2810d1285b601e80736/w1240/q80/images/uploads/82a91fc4423ef2810d1285b601e80736.png 1680w,https://riversidestudios.co.uk/images/custom/82/a91fc4423ef2810d1285b601e80736/w1240/q80/images/uploads/82a91fc4423ef2810d1285b601e80736.png 1870w,https://riversidestudios.co.uk/images/custom/82/a91fc4423ef2810d1285b601e80736/w1240/q80/images/uploads/82a91fc4423ef2810d1285b601e80736.png 2048w,https://riversidestudios.co.uk/images/custom/82/a91fc4423ef2810d1285b601e80736/w1240/q80/images/uploads/82a91fc4423ef2810d1285b601e80736.png 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                   \r\n                  <div class=\"template-surtitle font-yellow font-uppercase font-tag font-title\">Cinema</div>  \r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>National Theatre Live: The Audience</span>\r\n              \r\n                     </h1>\r\n                                                <div class=\"age-rating r-12a\" title=\"12A\"></div>\r\n                                              <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Thu 26 Feb - Sun 1 Mar 2026</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"OHVnZHQyczlvUFoxK1JvS24vM1ozZz09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p>Returning to cinemas for the first time in over a decade, Helen Mirren plays Queen Elizabeth II in the <strong>Olivier </strong>and <strong>Tony Award® -winning</strong> hit production, directed by Stephen Daldry. &nbsp;</p><p>&nbsp;</p><p>For 60 years, Queen Elizabeth II met with each of her 12 prime ministers in a private weekly meeting. This meeting is known as<strong> The Audience</strong>. From Winston Churchill to Margaret Thatcher and David Cameron, the Queen advised her prime ministers on matters both public and personal. Through these private audiences, we see glimpses of the woman behind the crown and witness the moments that shaped a monarch.</p><p>&nbsp;</p><p>Peter Morgan’s Netflix phenomenon<i> The Crown</i> was based on this hit play that was captured <strong>live from London’s West End</strong> in 2013 and went on to become one of the most-watched NT Live productions.</p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">180 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n    \r\n</div>\r\n  </main>\n\r\n<footer class=\"footer\">\r\n\r\n  <div class=\"container-wide desktop-only-break-1024\">\r\n    <div class=\"footer-inner\">\r\n\r\n\r\n      <div class=\"footer-navs\">\r\n\r\n\r\n                  <div class=\"footer-section\">\r\n\r\n                            <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">See Also</h5>\r\n                            <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/vacancies/\">Vacancies</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/policies/\">Policies</a>\r\n                        <div id=\"member-login\"></div>\r\n          </div>\r\n\r\n        \r\n                  <div class=\"footer-section\">\r\n\r\n            <div class=\"footer-nav-top\">\r\n                                <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">Our Website</h5>\r\n                                <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/privacy-and-cookies/\">Privacy and Cookies</a>\r\n                              <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/website-accessibility/\">Website Accessibility</a>\r\n                              <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/newsletter-signup/\">Newsletter signup</a>\r\n                          </div>\r\n          </div>\r\n\r\n        \r\n        \r\n        \r\n              </div>\r\n\r\n\r\n\r\n      <div class=\"foot