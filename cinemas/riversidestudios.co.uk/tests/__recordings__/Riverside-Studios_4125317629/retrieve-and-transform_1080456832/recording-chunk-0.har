\">\r\n                <div class=\"image-container \">\r\n                                <picture>\r\n                    <source sizes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/cd/2721413feb8669b9d3f606a253bd70/w880/q80/wpojpg/images/uploads/cd2721413feb8669b9d3f606a253bd70.webp 880w,https://riversidestudios.co.uk/images/custom/cd/2721413feb8669b9d3f606a253bd70/w1210/q80/wpojpg/images/uploads/cd2721413feb8669b9d3f606a253bd70.webp 1210w,https://riversidestudios.co.uk/images/custom/cd/2721413feb8669b9d3f606a253bd70/w1280/q80/wpojpg/images/uploads/cd2721413feb8669b9d3f606a253bd70.webp 1470w,https://riversidestudios.co.uk/images/custom/cd/2721413feb8669b9d3f606a253bd70/w1280/q80/wpojpg/images/uploads/cd2721413feb8669b9d3f606a253bd70.webp 1680w,https://riversidestudios.co.uk/images/custom/cd/2721413feb8669b9d3f606a253bd70/w1280/q80/wpojpg/images/uploads/cd2721413feb8669b9d3f606a253bd70.webp 1870w,https://riversidestudios.co.uk/images/custom/cd/2721413feb8669b9d3f606a253bd70/w1280/q80/wpojpg/images/uploads/cd2721413feb8669b9d3f606a253bd70.webp 2048w,https://riversidestudios.co.uk/images/custom/cd/2721413feb8669b9d3f606a253bd70/w1280/q80/wpojpg/images/uploads/cd2721413feb8669b9d3f606a253bd70.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position:  50%  50% \" src=\"https://riversidestudios.co.uk/images/custom/cd/2721413feb8669b9d3f606a253bd70/w880/q80/images/uploads/cd2721413feb8669b9d3f606a253bd70.jpg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/cd2721413feb8669b9d3f606a253bd70.jpg&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;1280&quot;,&quot;height&quot;:&quot;680&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/cd/2721413feb8669b9d3f606a253bd70/w880/q80/images/uploads/cd2721413feb8669b9d3f606a253bd70.jpg 880w,https://riversidestudios.co.uk/images/custom/cd/2721413feb8669b9d3f606a253bd70/w1210/q80/images/uploads/cd2721413feb8669b9d3f606a253bd70.jpg 1210w,https://riversidestudios.co.uk/images/custom/cd/2721413feb8669b9d3f606a253bd70/w1280/q80/images/uploads/cd2721413feb8669b9d3f606a253bd70.jpg 1470w,https://riversidestudios.co.uk/images/custom/cd/2721413feb8669b9d3f606a253bd70/w1280/q80/images/uploads/cd2721413feb8669b9d3f606a253bd70.jpg 1680w,https://riversidestudios.co.uk/images/custom/cd/2721413feb8669b9d3f606a253bd70/w1280/q80/images/uploads/cd2721413feb8669b9d3f606a253bd70.jpg 1870w,https://riversidestudios.co.uk/images/custom/cd/2721413feb8669b9d3f606a253bd70/w1280/q80/images/uploads/cd2721413feb8669b9d3f606a253bd70.jpg 2048w,https://riversidestudios.co.uk/images/custom/cd/2721413feb8669b9d3f606a253bd70/w1280/q80/images/uploads/cd2721413feb8669b9d3f606a253bd70.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Explore Creativity & Calm: An Abstract Art Workshop with Mindfulness Practices</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Sat 13 Dec 2025 14:00</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"VlBhd0hlUWh3NDQ2QWxMdkR0ck0zUT09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p>Discover the therapeutic power of abstract art at Riverside Studios</p><p>Join artist Roya Nozadi for a gentle, grounding workshop designed to be more than a painting class, it’s a practice for your mind, helping you find relief, focus, and creative challenge.</p><p>No experience required, just curiosity. Ages 16+.</p><p>What to expect:</p><ul><li>Explore how to quiet your mind and being present</li><li>Explore intuitive mark-making. Let go of perfection and enjoy creating without rules or pressure.</li><li>Explore colour, form and line. Build the foundations for future sessions where we’ll explore texture, collage, and deeper techniques.</li><li>Explore connection with like-minded people in a warm, supportive creative space</li></ul><p>&nbsp;</p><p>All materials are included. You will leave with a clear mind and a finished artwork to take home. Meet the Artist: https://royanozadi.com/ Roya Nozadi will guide you through this mindful, creative journey.</p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">120 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n    \r\n</div>\r\n  </main>\n\r\n<footer class=\"footer\">\r\n\r\n  <div class=\"container-wide desktop-only-break-1024\">\r\n    <div class=\"footer-inner\">\r\n\r\n\r\n      <div class=\"footer-navs\">\r\n\r\n\r\n                  <div class=\"footer-section\">\r\n\r\n                            <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">See Also</h5>\r\n                            <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/newsletter-signup/\">Newsletter signup</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/vacancies/\">Vacancies</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/policies/\">Policies</a>\r\n                        <div id=\"member-login\"></div>\r\n          </div>\r\n\r\n        \r\n                  <div class=\"footer-section\">\r\n\r\n            <div class=\"footer-nav-top\">\r\n                                <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">Our Website</h5>\r\n                                <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/privacy-and-cookies/\">Privacy and Cookies</a>\r\n                              <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/website-accessibility/\">Website Accessibility</a>\r\n                     