-container \">\r\n                                <picture>\r\n                    <source sizes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/ae/4e3b3a79bdf2cfbebe79d64feeba5a/w880/q80/wpojpeg/images/uploads/ae4e3b3a79bdf2cfbebe79d64feeba5a.webp 880w,https://riversidestudios.co.uk/images/custom/ae/4e3b3a79bdf2cfbebe79d64feeba5a/w1210/q80/wpojpeg/images/uploads/ae4e3b3a79bdf2cfbebe79d64feeba5a.webp 1210w,https://riversidestudios.co.uk/images/custom/ae/4e3b3a79bdf2cfbebe79d64feeba5a/w1470/q80/wpojpeg/images/uploads/ae4e3b3a79bdf2cfbebe79d64feeba5a.webp 1470w,https://riversidestudios.co.uk/images/custom/ae/4e3b3a79bdf2cfbebe79d64feeba5a/w1680/q80/wpojpeg/images/uploads/ae4e3b3a79bdf2cfbebe79d64feeba5a.webp 1680w,https://riversidestudios.co.uk/images/custom/ae/4e3b3a79bdf2cfbebe79d64feeba5a/w1870/q80/wpojpeg/images/uploads/ae4e3b3a79bdf2cfbebe79d64feeba5a.webp 1870w,https://riversidestudios.co.uk/images/custom/ae/4e3b3a79bdf2cfbebe79d64feeba5a/w2048/q80/wpojpeg/images/uploads/ae4e3b3a79bdf2cfbebe79d64feeba5a.webp 2048w,https://riversidestudios.co.uk/images/custom/ae/4e3b3a79bdf2cfbebe79d64feeba5a/w2880/q80/wpojpeg/images/uploads/ae4e3b3a79bdf2cfbebe79d64feeba5a.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position: 63.4% 40.4% \" src=\"https://riversidestudios.co.uk/images/custom/ae/4e3b3a79bdf2cfbebe79d64feeba5a/w880/q80/images/uploads/ae4e3b3a79bdf2cfbebe79d64feeba5a.jpeg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/ae4e3b3a79bdf2cfbebe79d64feeba5a.jpeg&quot;,&quot;fx&quot;:&quot;63.4&quot;,&quot;fy&quot;:&quot;40.4&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;5184&quot;,&quot;height&quot;:&quot;3456&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/ae/4e3b3a79bdf2cfbebe79d64feeba5a/w880/q80/images/uploads/ae4e3b3a79bdf2cfbebe79d64feeba5a.jpeg 880w,https://riversidestudios.co.uk/images/custom/ae/4e3b3a79bdf2cfbebe79d64feeba5a/w1210/q80/images/uploads/ae4e3b3a79bdf2cfbebe79d64feeba5a.jpeg 1210w,https://riversidestudios.co.uk/images/custom/ae/4e3b3a79bdf2cfbebe79d64feeba5a/w1470/q80/images/uploads/ae4e3b3a79bdf2cfbebe79d64feeba5a.jpeg 1470w,https://riversidestudios.co.uk/images/custom/ae/4e3b3a79bdf2cfbebe79d64feeba5a/w1680/q80/images/uploads/ae4e3b3a79bdf2cfbebe79d64feeba5a.jpeg 1680w,https://riversidestudios.co.uk/images/custom/ae/4e3b3a79bdf2cfbebe79d64feeba5a/w1870/q80/images/uploads/ae4e3b3a79bdf2cfbebe79d64feeba5a.jpeg 1870w,https://riversidestudios.co.uk/images/custom/ae/4e3b3a79bdf2cfbebe79d64feeba5a/w2048/q80/images/uploads/ae4e3b3a79bdf2cfbebe79d64feeba5a.jpeg 2048w,https://riversidestudios.co.uk/images/custom/ae/4e3b3a79bdf2cfbebe79d64feeba5a/w2880/q80/images/uploads/ae4e3b3a79bdf2cfbebe79d64feeba5a.jpeg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Third Age on Stage: Acting Workshops for the Over 50s</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Fri 12 - Fri 19 Dec 2025</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"d3dFcGhUL0xWVkFtZU9FVkdBcnd4UT09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <h2>Learn new acting and performance skills. Veterans and beginners are welcome!</h2><p>The class will open again for new members in autumn.</p><p>Run by Dive In Associate, <strong>Cats Whiskers Community Arts</strong>, these weekly drama workshops include voice and speech training, movement, improvisation, character creation and work with texts. They aim to improve self-confidence and memory in a relaxed and fun environment.&nbsp;&nbsp;</p><p>Drama teacher and director<strong> Carol Allen</strong> from Cats Whiskers Community Arts has been teaching adult drama classes for over fifteen years, in which time her students have taken part in live performances at venues including Kensington Palace, the Drayton Arms Theatre and the Bush theatre. Students have also appeared in short films.&nbsp; The Riverside group started in the midst of Covid in 2020 and members have written and performed short plays with Riverscribes, plus a full length revue, “The Seven Ages of Us” and most recently an informal programme of sketches, poetry and song.</p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">120 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n    \r\n</div>\r\n  </main>\n\r\n<footer class=\"footer\">\r\n\r\n  <div class=\"container-wide desktop-only-break-1024\">\r\n    <div class=\"footer-inner\">\r\n\r\n\r\n      <div class=\"footer-navs\">\r\n\r\n\r\n                  <div class=\"footer-section\">\r\n\r\n                            <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">See Also</h5>\r\n                            <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/newsletter-signup/\">Newsletter signup</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/vacancies/\">Vacancies</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/policies/\">Policies</a>\r\n                        <div id=\"member-login\"></div>\r\n          </div>\r\n\r\n        \r\n                  <div class=\"footer-section\">\r\n\r\n            <div class=\"footer-nav-top\">\r\n                                <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">Our Website</h5>\r\n                                <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/privacy-and-cookies/\">Privacy and Cookies</a>\r\n                              <a class=\"footer-nav-item font-text font-white\" href=\"https://