        </div>\r\n      </div>\r\n    </div>\r\n</header>\n  <div class=\"video-modals\"></div>\n  <div class=\"side-logo riverside-logo\"><span></span></div>\n  <div class=\"side-logo studios-logo\"><span></span></div>\n\n  <div class=\"membership-container\"></div>\n    <div class=\"overlay\"></div>\n    <div class=\"overlay-login\"></div>\n    <main class=\"outer-container\"  id=\"main-content\"  >\n      <div class=\"filter-overlay\"></div>\n          \r\n\r\n\r\n\r\n\r\n\r\n<div class=\"page page-event\">\r\n  <section class=\"template template-event-detail play-container has-modal  has-text-bottom      \">\r\n\r\n\r\n  \r\n\r\n\r\n    <div class=\"template-top header-padding header-switch\">\r\n                <div class=\"image-container \">\r\n                                <picture>\r\n                    <source sizes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/39/6538bc931dd398ffa897aeb8b06c7e/w880/q80/wpopng/images/uploads/396538bc931dd398ffa897aeb8b06c7e.webp 880w,https://riversidestudios.co.uk/images/custom/39/6538bc931dd398ffa897aeb8b06c7e/w1210/q80/wpopng/images/uploads/396538bc931dd398ffa897aeb8b06c7e.webp 1210w,https://riversidestudios.co.uk/images/custom/39/6538bc931dd398ffa897aeb8b06c7e/w1470/q80/wpopng/images/uploads/396538bc931dd398ffa897aeb8b06c7e.webp 1470w,https://riversidestudios.co.uk/images/custom/39/6538bc931dd398ffa897aeb8b06c7e/w1680/q80/wpopng/images/uploads/396538bc931dd398ffa897aeb8b06c7e.webp 1680w,https://riversidestudios.co.uk/images/custom/39/6538bc931dd398ffa897aeb8b06c7e/w1870/q80/wpopng/images/uploads/396538bc931dd398ffa897aeb8b06c7e.webp 1870w,https://riversidestudios.co.uk/images/custom/39/6538bc931dd398ffa897aeb8b06c7e/w1920/q80/wpopng/images/uploads/396538bc931dd398ffa897aeb8b06c7e.webp 2048w,https://riversidestudios.co.uk/images/custom/39/6538bc931dd398ffa897aeb8b06c7e/w1920/q80/wpopng/images/uploads/396538bc931dd398ffa897aeb8b06c7e.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position: 47.6% 26.0% \" src=\"https://riversidestudios.co.uk/images/custom/39/6538bc931dd398ffa897aeb8b06c7e/w880/q80/images/uploads/396538bc931dd398ffa897aeb8b06c7e.png\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/396538bc931dd398ffa897aeb8b06c7e.png&quot;,&quot;fx&quot;:&quot;47.6&quot;,&quot;fy&quot;:&quot;26.0&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;1920&quot;,&quot;height&quot;:&quot;1272&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/39/6538bc931dd398ffa897aeb8b06c7e/w880/q80/images/uploads/396538bc931dd398ffa897aeb8b06c7e.png 880w,https://riversidestudios.co.uk/images/custom/39/6538bc931dd398ffa897aeb8b06c7e/w1210/q80/images/uploads/396538bc931dd398ffa897aeb8b06c7e.png 1210w,https://riversidestudios.co.uk/images/custom/39/6538bc931dd398ffa897aeb8b06c7e/w1470/q80/images/uploads/396538bc931dd398ffa897aeb8b06c7e.png 1470w,https://riversidestudios.co.uk/images/custom/39/6538bc931dd398ffa897aeb8b06c7e/w1680/q80/images/uploads/396538bc931dd398ffa897aeb8b06c7e.png 1680w,https://riversidestudios.co.uk/images/custom/39/6538bc931dd398ffa897aeb8b06c7e/w1870/q80/images/uploads/396538bc931dd398ffa897aeb8b06c7e.png 1870w,https://riversidestudios.co.uk/images/custom/39/6538bc931dd398ffa897aeb8b06c7e/w1920/q80/images/uploads/396538bc931dd398ffa897aeb8b06c7e.png 2048w,https://riversidestudios.co.uk/images/custom/39/6538bc931dd398ffa897aeb8b06c7e/w1920/q80/images/uploads/396538bc931dd398ffa897aeb8b06c7e.png 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                   \r\n                  <div class=\"template-surtitle font-yellow font-uppercase font-tag font-title\">Cinema</div>  \r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Clash of the Titans</span>\r\n              \r\n                     </h1>\r\n                                                <div class=\"age-rating r-18\" title=\"18\"></div>\r\n                                              <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Sat 18 - Mon 20 Jul 2026</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"Q0tkc3poREg3ckpJMURDZ0Z6SVN6dz09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p>As master filmmaker Christopher Nolan finally reveals his ambitious take on Homer's epic <i>THE ODYSSEY</i> this July, travel back with us through the ages to explore how other filmmakers have drawn on the ancient myths of yesterday to forge groundbreaking big screen entertainment. Enjoy a multi-buy offer for all films in the <strong>MYTHS AND MONSTERS</strong> season with 15% off adult and concession prices if more than one ticket is purchased in same order.</p><p>&nbsp;</p><p><strong>MYTHS AND MONSTERS </strong>classic film season at Riverside Studios:</p><p><i>Clash of the Titans</i> (1981): 18th-20th July</p><p><i>Spartacus</i> (1960): 25-28th July</p><p><i>Troy </i>(2004): 1st-3rd August</p><p>&nbsp;</p><p><i><strong>CLASH OF THE TITANS</strong></i><strong> (1981)</strong></p><p>The machinations of gods above and the fates of man and monsters here below play out in 1981's <i><strong>Clash of the Titans</strong></i>. Decades prior to the sensational 2010 version of the tale, Harry Hamlin took up sword and shield to play valorous Perseus, mortal son of Zeus (Laurence Olivier) who sets out to fulfill his destiny by rescuing beloved Andromeda from the wrath of goddess Thetis (Maggie Smith).</p><p>Perils await Perseus time and again. And eye-filling thrills await viewers as stop-motion effects legend Ray Harryhausen unleashes snake-haired Medusa, fearsome Kraken, winged Pegasus, two-headed dog Dioskilos, giant scorpions and more!</p><figure class=\"table\"><table><tbody><tr><td><strong>Age Rating:</strong></td><td>18</td></tr><tr><td><strong>Language:</strong></td><td>English</td></tr><tr><td><strong>Content Warnings:</strong></td><td>TBC</td></tr><tr><td><strong>Director:</strong></td><td>Desmond Davis</td></tr><tr><td><strong>Cast:</strong></td><td>Laurence Olivier, Maggie Smith, Harry Hamlin, Judi Bowker, Ursula Andress, Burgess Meredith</td></tr><tr><td><strong>Company:</strong></td><td>Park Circus</td></tr><tr><td><strong>Trailers:</strong></td><td>20 mins</td></tr><tr><td><strong>Year of Release:</strong></td><td>1981</td></tr></tbody></table></figure></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">118 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n        \n\n<section class=\"block block-events-list\">\n\n\n  <div class=\"container\">\n                <div class=\"block-header has-button\">\n            <div class=\"block-header-left\">\n            <h3 class=\"block-title font-medium font-title font-uppercase font-blue\"><span>Upcoming Cinema</span>\r\n</h3>\n                                </div>\n                      \n          </div>\n            <div class=\"grid\">\n          \n\n<div class=\"grid-item event\">\n  <div class=\"slot event\">\n    \n          <div class=\"slot-image\">\n        <a href=\"https://riversidestudios.co.uk/whats-on/hr-the-invite/\">\n        <div class=\"image-container\">\n                            <picture>\n                  <source sizes=\"(min-width: 1780px) calc(-4.1vw + 484px), (min-width: 1240px) calc(22.12vw + 23px), (min-width: 780px) calc(27.5vw - 21px), (min-width: 460px) 375px, calc(76.43vw + 39px)\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/4d/8da94b4c5c654e2c977b1fd0bdbe66/w400/q80/wpojpeg/images/uploads/4d8da94b4c5c654e2c977b1fd0bdbe66.webp 400w,https://riversidestudios.co.uk/images/custom/4d/8da94b4c5c654e2c977b1fd0bdbe66/w500/q80/wpojpeg/images/uploads/4d8da94b4c5c654e2c977b1fd0bdbe66.webp 500w,https://riversidestudios.co.uk/images/custom/4d/8da94b4c5c654e2c977b1fd0bdbe66/w600/q80/wpojpeg/images/uploads/4d8da94b4c5c654e2c977b1fd0bdbe66.webp 600w,https://riversidestudios.co.uk/images/custom/