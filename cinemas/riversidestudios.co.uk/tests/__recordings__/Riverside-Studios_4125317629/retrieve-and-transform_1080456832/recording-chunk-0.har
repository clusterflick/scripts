r\n\r\n\r\n\r\n<div class=\"page page-event\">\r\n  <section class=\"template template-event-detail play-container has-modal  has-text-bottom      \">\r\n\r\n\r\n  \r\n\r\n\r\n    <div class=\"template-top header-padding header-switch\">\r\n                <div class=\"image-container \">\r\n                                <picture>\r\n                    <source sizes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/7c/01907ab70ca28b80e22222b5089965/w880/q80/wpopng/images/uploads/7c01907ab70ca28b80e22222b5089965.webp 880w,https://riversidestudios.co.uk/images/custom/7c/01907ab70ca28b80e22222b5089965/w1197/q80/wpopng/images/uploads/7c01907ab70ca28b80e22222b5089965.webp 1210w,https://riversidestudios.co.uk/images/custom/7c/01907ab70ca28b80e22222b5089965/w1197/q80/wpopng/images/uploads/7c01907ab70ca28b80e22222b5089965.webp 1470w,https://riversidestudios.co.uk/images/custom/7c/01907ab70ca28b80e22222b5089965/w1197/q80/wpopng/images/uploads/7c01907ab70ca28b80e22222b5089965.webp 1680w,https://riversidestudios.co.uk/images/custom/7c/01907ab70ca28b80e22222b5089965/w1197/q80/wpopng/images/uploads/7c01907ab70ca28b80e22222b5089965.webp 1870w,https://riversidestudios.co.uk/images/custom/7c/01907ab70ca28b80e22222b5089965/w1197/q80/wpopng/images/uploads/7c01907ab70ca28b80e22222b5089965.webp 2048w,https://riversidestudios.co.uk/images/custom/7c/01907ab70ca28b80e22222b5089965/w1197/q80/wpopng/images/uploads/7c01907ab70ca28b80e22222b5089965.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position: 51.2% 33.7% \" src=\"https://riversidestudios.co.uk/images/custom/7c/01907ab70ca28b80e22222b5089965/w880/q80/images/uploads/7c01907ab70ca28b80e22222b5089965.png\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/7c01907ab70ca28b80e22222b5089965.png&quot;,&quot;fx&quot;:&quot;51.2&quot;,&quot;fy&quot;:&quot;33.7&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;1197&quot;,&quot;height&quot;:&quot;647&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/7c/01907ab70ca28b80e22222b5089965/w880/q80/images/uploads/7c01907ab70ca28b80e22222b5089965.png 880w,https://riversidestudios.co.uk/images/custom/7c/01907ab70ca28b80e22222b5089965/w1197/q80/images/uploads/7c01907ab70ca28b80e22222b5089965.png 1210w,https://riversidestudios.co.uk/images/custom/7c/01907ab70ca28b80e22222b5089965/w1197/q80/images/uploads/7c01907ab70ca28b80e22222b5089965.png 1470w,https://riversidestudios.co.uk/images/custom/7c/01907ab70ca28b80e22222b5089965/w1197/q80/images/uploads/7c01907ab70ca28b80e22222b5089965.png 1680w,https://riversidestudios.co.uk/images/custom/7c/01907ab70ca28b80e22222b5089965/w1197/q80/images/uploads/7c01907ab70ca28b80e22222b5089965.png 1870w,https://riversidestudios.co.uk/images/custom/7c/01907ab70ca28b80e22222b5089965/w1197/q80/images/uploads/7c01907ab70ca28b80e22222b5089965.png 2048w,https://riversidestudios.co.uk/images/custom/7c/01907ab70ca28b80e22222b5089965/w1197/q80/images/uploads/7c01907ab70ca28b80e22222b5089965.png 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Yoga for all from Lumi Foundation</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Thu 11 - Thu 18 Dec 2025</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"MnprMWRhMHBlbXdQLzBxRmZPZVJsQT09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p>Whether you're brand new to yoga or a seasoned practitioner, this class is for you!&nbsp; Join us to move, breath and connect with fellow local yogis.&nbsp;&nbsp;</p><p>The class will help you build strength and flexibility while creating space for your mind to quieten.&nbsp; Expect to leave feeling revitalised, energised and filled with a sense of possibility.</p><p>Please bring your own mat if you can.&nbsp; A limited number are available to borrow at Riverside Studios.&nbsp; This class can also be done using a chair for support.&nbsp;</p><p>Your teacher will be from <strong>Lumi Foundation</strong> with proceeds from the class going towards raising funds for Lumi Foundation.&nbsp; Thank you for helping us bring yoga to all!</p><p>&nbsp;</p><p><strong>About Lumi Foundation</strong></p><p>Lumi Foundation is an award-winning charity with a simple belief - yoga is for everyone!</p><p>Founded in 2017, we offer classes to a wide and varied audience. We work with adults and children with disabilities, elderly groups, refugees, those in recovery from addiction, survivors of domestic abuse, low-income communities and individuals undergoing cancer treatment.</p><p>Our teachers are highly qualified and able to adapt classes to suit the needs of different groups. Typical classes blend mat and chair‑based practices, focusing on movement, breathwork and meditation.</p><p>Most importantly, these classes are also a way for people to come together and practice as a community.</p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">60 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n    \r\n</div>\r\n  </main>\n\r\n<footer class=\"footer\">\r\n\r\n  <div class=\"container-wide desktop-only-break-1024\">\r\n    <div class=\"footer-inner\">\r\n\r\n\r\n      <div class=\"footer-navs\">\r\n\r\n\r\n                  <div class=\"footer-section\">\r\n\r\n                            <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">See Also</h5>\r\n                            <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/newsletter-signup/\">Newsletter signup</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/vacancies/\">Vacancies</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/policies/\">Policies</a>\r\n                        <div id=\"member-login\"></div>\r\n          </div>\r\n\r\n        \r\n                  <div class=\"footer-section\">\r\n\r\n            <div class=\"footer-nav-top\">\r\n                                <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">Our Website</h5>\r\n                                <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/privacy-and-cookies/\">Privacy and Cookies</a>\r\n                              <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/website-accessibility/\">Website Accessibility</a>\r\n                          </div>\r\n          </div>\r\n\r\n        \r\n        \r\n        \r\n              </div>\r\n\r\n\r\n\r\n      <div class=\"footer-bottom\">\r\n        <div class=\"footer-logos\">\r\n        </div>\r\n\r\n                  <div class=\"footer-social\">\r\n            <div class=\"footer-social-inner\">\r\n              <nav class=\"social-icons \">\r\n                <a href=\"https://www.facebook.com/RiversideStudiosLondon/\" class=\"facebook\" title=\"Facebook\"\r\n   target=\"_blank\"><span class=\"sr-only\">Facebook</span></a>\r\n<a href=\"https://www.instagram.com/riversidestudioslondon/?hl=en\" class=\"instagram\" title=\"Instagram\"\r\n   target=\"_blank\"><span class=\"sr-only\">Instagram</span></a>\r\n<a href=\"https://twitter.com/RiversideLondon\" class=\"x-twitter\" title=\"X\"\r\n   target=\"_blank\"><span class=\"sr-only\">X</span></a>\r\n              </nav>\r\n            </div>\r\n          </div>\r\n\r\n        \r\n      </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n      <div class=\"footer-legal\">\r\n        <span class=\"footer-copy font-tiny font-white\">&copy; Anil Agarwal Riverside Studios Trust. All rights reserved.</span>\r\n        <a href=\"https://grandad.digital\" target=\"_blan