;\n    </script>\n    \n\n      <meta property=\"og:type\" content=\"website\">\n                  <meta property=\"og:title\" content=\"The Jolly Djembe Club - Riverside Studios\">\n                  <meta property=\"og:url\" content=\"https://riversidestudios.co.uk/whats-on/9a-the-jolly-djembe-club/\">\n                  <meta property=\"og:image\" content=\"https://riversidestudios.co.uk/images/uploads/9f0bce23114cd236efd0247b584af573.jpg\">\n                  <meta property=\"og:image:secure_url\" content=\"https://riversidestudios.co.uk/images/uploads/9f0bce23114cd236efd0247b584af573.jpg\">\n                  <meta property=\"og:description\" content=\"Don't miss out on an unforgettable cultural adventure at Riverside Studios! Join Mangotree Kids as we bring the vibrant energy of Africa to life with our Jolly Djembe African Drumming session. Kids will embark on a thrilling journey to discover the rhythm\">\n                  <meta property=\"og:site_name\" content=\"Riverside Studios\">\n                  <meta property=\"og:locale\" content=\"EN_GB\">\n                  <meta property=\"twitter:card\" content=\"summary_large_image\">\n                  <meta property=\"twitter:site\" content=\"@RiversideLondon\">\n                  <meta property=\"twitter:creator\" content=\"@RiversideLondon\">\n                  <meta property=\"twitter:title\" content=\"The Jolly Djembe Club - Riverside Studios\">\n                  <meta property=\"twitter:description\" content=\"Don't miss out on an unforgettable cultural adventure at Riverside Studios! Join Mangotree Kids as we bring the vibrant energy of Africa to life with our Jolly Djembe African Drumming session. Kids will embark on a thrilling journey to discover the rhythm\">\n                  <meta property=\"twitter:image:src\" content=\"https://riversidestudios.co.uk/images/uploads/9f0bce23114cd236efd0247b584af573.jpg\">\n                  <meta property=\"twitter:image:alt\" content=\"Riverside Studios\">\n   