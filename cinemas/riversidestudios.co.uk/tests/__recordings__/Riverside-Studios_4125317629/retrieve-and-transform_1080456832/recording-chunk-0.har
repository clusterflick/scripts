div>\n    <main class=\"outer-container\"  id=\"main-content\"  >\n      <div class=\"filter-overlay\"></div>\n          \r\n\r\n\r\n\r\n\r\n\r\n<div class=\"page page-event\">\r\n  <section class=\"template template-event-detail play-container has-modal  has-text-bottom      \">\r\n\r\n\r\n  \r\n\r\n\r\n    <div class=\"template-top header-padding header-switch\">\r\n                <div class=\"image-container \">\r\n                                <picture>\r\n                    <source sizes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/d8/67fcbf391c33d44e199d7ebd4673f4/w880/q80/wpojpg/images/uploads/d867fcbf391c33d44e199d7ebd4673f4.webp 880w,https://riversidestudios.co.uk/images/custom/d8/67fcbf391c33d44e199d7ebd4673f4/w1210/q80/wpojpg/images/uploads/d867fcbf391c33d44e199d7ebd4673f4.webp 1210w,https://riversidestudios.co.uk/images/custom/d8/67fcbf391c33d44e199d7ebd4673f4/w1470/q80/wpojpg/images/uploads/d867fcbf391c33d44e199d7ebd4673f4.webp 1470w,https://riversidestudios.co.uk/images/custom/d8/67fcbf391c33d44e199d7ebd4673f4/w1680/q80/wpojpg/images/uploads/d867fcbf391c33d44e199d7ebd4673f4.webp 1680w,https://riversidestudios.co.uk/images/custom/d8/67fcbf391c33d44e199d7ebd4673f4/w1870/q80/wpojpg/images/uploads/d867fcbf391c33d44e199d7ebd4673f4.webp 1870w,https://riversidestudios.co.uk/images/custom/d8/67fcbf391c33d44e199d7ebd4673f4/w2048/q80/wpojpg/images/uploads/d867fcbf391c33d44e199d7ebd4673f4.webp 2048w,https://riversidestudios.co.uk/images/custom/d8/67fcbf391c33d44e199d7ebd4673f4/w2880/q80/wpojpg/images/uploads/d867fcbf391c33d44e199d7ebd4673f4.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position: 53.6% 42.7% \" src=\"https://riversidestudios.co.uk/images/custom/d8/67fcbf391c33d44e199d7ebd4673f4/w880/q80/images/uploads/d867fcbf391c33d44e199d7ebd4673f4.jpg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/d867fcbf391c33d44e199d7ebd4673f4.jpg&quot;,&quot;fx&quot;:&quot;53.6&quot;,&quot;fy&quot;:&quot;42.7&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;3600&quot;,&quot;height&quot;:&quot;2756&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/d8/67fcbf391c33d44e199d7ebd4673f4/w880/q80/images/uploads/d867fcbf391c33d44e199d7ebd4673f4.jpg 880w,https://riversidestudios.co.uk/images/custom/d8/67fcbf391c33d44e199d7ebd4673f4/w1210/q80/images/uploads/d867fcbf391c33d44e199d7ebd4673f4.jpg 1210w,https://riversidestudios.co.uk/images/custom/d8/67fcbf391c33d44e199d7ebd4673f4/w1470/q80/images/uploads/d867fcbf391c33d44e199d7ebd4673f4.jpg 1470w,https://riversidestudios.co.uk/images/custom/d8/67fcbf391c33d44e199d7ebd4673f4/w1680/q80/images/uploads/d867fcbf391c33d44e199d7ebd4673f4.jpg 1680w,https://riversidestudios.co.uk/images/custom/d8/67fcbf391c33d44e199d7ebd4673f4/w1870/q80/images/uploads/d867fcbf391c33d44e199d7ebd4673f4.jpg 1870w,https://riversidestudios.co.uk/images/custom/d8/67fcbf391c33d44e199d7ebd4673f4/w2048/q80/images/uploads/d867fcbf391c33d44e199d7ebd4673f4.jpg 2048w,https://riversidestudios.co.uk/images/custom/d8/67fcbf391c33d44e199d7ebd4673f4/w2880/q80/images/uploads/d867fcbf391c33d44e199d7ebd4673f4.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Thunderball 60th Anniversary Screening + Live Q&A with Martine Beswick</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Sat 13 Dec 2025 14:00</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"cENyL2owQ1FSaGlYTlR0T3ZjeVE0QT09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p><strong>SpyHards Podcast presents: Spies on Screen</strong> is a exciting new programming strand at <strong>Riverside Studios</strong>! <strong>SpyHards</strong> is the world’s leading podcast focused exclusively on spy movies and television. Hosted by Scott Hardy and Cam Smith, the show provides weekly deep dives into espionage cinema—from beloved blockbusters to forgotten cult favourites—alongside interviews with the actors, filmmakers, and creators behind the genre’s most iconic works.</p><p>We are delighted for this inaugural event to be welcoming actor <strong>Martine Beswick</strong> to discuss her role in the iconic 007 franchise, following an anniversary screening of the Sean Connery-starring Bond adventure <i><strong>THUNDERBALL</strong></i>, in which she played Paula. Martine will also be signing autographs later in the cinema foyer (separate fees may apply).</p><p>&nbsp;</p><p><i><strong>THUNDERBALL </strong></i><strong>(1965)</strong></p><p>Led by one-eyed evil mastermind Emilio Largo (Adolfo Celi), the terrorist group SPECTRE hijacks two warheads from a NATO plane and threatens widespread nuclear destruction to extort millions of pounds. The dashing Agent 007, James Bond (Sean Connery), is sent to recover the warheads from the heart of Largo's lair in the Bahamas, facing underwater attacks from sharks and men alike. He must also convince the enchanting Domino (Claudine Auger), Largo's mistress, to become a key ally.</p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">129 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n    \r\n</div>\r\n  </main>\n\r\n<footer class=\"footer\">\r\n\r\n  <div class=\"container-wide desktop-only-break-1024\">\r\n    <div class=\"footer-inner\">\r\n\r\n\r\n      <div class=\"footer-navs\">\r\n\r\n\r\n                  <div class=\"footer-section\">\r\n\r\n                            <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">See Also</h5>\r\n                            <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/newsletter-signup/\">Newsletter signup</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/vacancies/\">Vacancies</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/policies/\">Policies</a>\r\n                        <div id=\"member-login\"></div>\r\n          </div>\r\n\r\n        \r\n                  <div class=\"footer-section\">\r\n\r\n            <div class=\"footer-nav-top\">\r\n                                <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">Our Website</h5>\r\n                                <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/privacy-and-cookies/\">Privacy and Cookies</a>\r\n                              <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/website-accessibility/\">Website Accessibility</a>\r\n                          </div>\r\n          </div>\r\n\r\n        \r\n        \r\n        \r\n              </div>\r\n\r\n\r\n\r\n      <div class=\"footer-bottom\">\r\n        <div class=\"footer-logos\">\r\n        </div>\r\n\r\n                  <div class=\"footer-social\">\r\n            <div class=\"footer-social-inner\">\r\n              <nav class=\"social-icons \">\r\n                <a href=\"https://www.facebook.com/RiversideStudiosLondon/\" class=\"facebook\" title=\"Facebook\"\r\n   target=\"_blank\"><span class=\"sr-only\">Facebook</span></a>\r\n<a href=\"https://www.instagram.com/riversidestudioslondon/?hl=en\" class=\"instagram\" title=\"Instagram\"\r\n   target=\"_blank\"><span class=\"sr-only\">Instagram</span></a>\r\n<a href=\"https://twitter.com/RiversideLondon\" class=\"x-twitter\" title=\"X\"\r\n   target=\"_blank\"><span class=\"sr-only\">X</span></a>\r\n              </nav>\r\n            </div>\r\n          </div>\r\n\r\n        \r\n      </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n      <div class=\"footer-legal\">\r\n        <span class=\"footer-copy font-tiny font-white\">&c