750/q80/wpojpeg/images/uploads/927d070abf93b6f61225581a610fb771.webp 1470w,https://riversidestudios.co.uk/images/custom/92/7d070abf93b6f61225581a610fb771/w750/q80/wpojpeg/images/uploads/927d070abf93b6f61225581a610fb771.webp 1680w,https://riversidestudios.co.uk/images/custom/92/7d070abf93b6f61225581a610fb771/w750/q80/wpojpeg/images/uploads/927d070abf93b6f61225581a610fb771.webp 1870w,https://riversidestudios.co.uk/images/custom/92/7d070abf93b6f61225581a610fb771/w750/q80/wpojpeg/images/uploads/927d070abf93b6f61225581a610fb771.webp 2048w,https://riversidestudios.co.uk/images/custom/92/7d070abf93b6f61225581a610fb771/w750/q80/wpojpeg/images/uploads/927d070abf93b6f61225581a610fb771.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position: 50.9% 6.8% \" src=\"https://riversidestudios.co.uk/images/custom/92/7d070abf93b6f61225581a610fb771/w880/q80/images/uploads/927d070abf93b6f61225581a610fb771.jpeg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/927d070abf93b6f61225581a610fb771.jpeg&quot;,&quot;fx&quot;:&quot;50.9&quot;,&quot;fy&quot;:&quot;6.8&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;750&quot;,&quot;height&quot;:&quot;616&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/92/7d070abf93b6f61225581a610fb771/w750/q80/images/uploads/927d070abf93b6f61225581a610fb771.jpeg 880w,https://riversidestudios.co.uk/images/custom/92/7d070abf93b6f61225581a610fb771/w750/q80/images/uploads/927d070abf93b6f61225581a610fb771.jpeg 1210w,https://riversidestudios.co.uk/images/custom/92/7d070abf93b6f61225581a610fb771/w750/q80/images/uploads/927d070abf93b6f61225581a610fb771.jpeg 1470w,https://riversidestudios.co.uk/images/custom/92/7d070abf93b6f61225581a610fb771/w750/q80/images/uploads/927d070abf93b6f61225581a610fb771.jpeg 1680w,https://riversidestudios.co.uk/images/custom/92/7d070abf93b6f61225581a610fb771/w750/q80/images/uploads/927d070abf93b6f61225581a610fb771.jpeg 1870w,https://riversidestudios.co.uk/images/custom/92/7d070abf93b6f61225581a610fb771/w750/q80/images/uploads/927d070abf93b6f61225581a610fb771.jpeg 2048w,https://riversidestudios.co.uk/images/custom/92/7d070abf93b6f61225581a610fb771/w750/q80/images/uploads/927d070abf93b6f61225581a610fb771.jpeg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Beat the Stress: Djembe Drumming for Adults</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Sun 14 Dec 2025 - Sun 25 Jan 2026</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"dzkvQnJnYUVLa081QWRCdm1FUFdzdz09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <h3>“Eyes closed and listening to the rhythm of the drum”</h3><p>Life can feel overwhelming at times — but stress doesn’t have to win. <strong>Beat the Stress </strong>is your chance to let it all go through the powerful, uplifting energy of <strong>African Djembe drumming</strong>.</p><p>Step into the <strong>ultimate drum circle</strong>, where every beat helps you release tension, spark creativity, and connect with the ancient rhythms of Africa. Discover the joy of learning new patterns, embrace Rhythm Meditation, and experience the deep calm and joy of Djembe.</p><p><strong>Be part of our Djembe Revolution!</strong></p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">60 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n    \r\n</div>\r\n  </main>\n\r\n<footer class=\"footer\">\r\n\r\n  <div class=\"container-wide desktop-only-break-1024\">\r\n    <div class=\"footer-inner\">\r\n\r\n\r\n      <div class=\"footer-navs\">\r\n\r\n\r\n                  <div class=\"footer-section\">\r\n\r\n                            <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">See Also</h5>\r\n     