            "mimeType": "text/html; charset=utf-8",
            "text": "<!DOCTYPE html>\n\n\n<html lang=\"en\" class=\"no-js\">\n\n<head>\n  <title>Queer Poetry Open Mic Night | Riverside Studios</title>\n\n    <meta name=\"description\" content=\"Hey there! We are collaborating with S-BARS to bring you a Queer Poetry Open Mic night! Bring your poems and perform for a supportive and kind audience! OR come along and listen to lots of wonderful poets sharing their art! 6:30pm: Doors7:00pm: Event star\">\n    \n<meta charset=\"utf-8\">\n\n<meta name=\"generator\" content=\"Grandad Digital - Powered by You.Create Content Management System\">\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=Edge\">\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Organization\",\n  \"url\": \"https://riversidestudios.co.uk/\",\n  \"logo\": \"https://riversidestudios.co.uk/assets/img/logo.png\"\n}\n</script>\n<script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Event\",\"name\":\"Queer Poetry Open Mic Night\",\"description\":\"Hey there! We are collaborating with S-BARS to bring you a Queer Poetry Open Mic night!&nbsp;Bring your poems and perform for a supportive and kind audience! OR come along and listen to lots of wonderful poets sharing their art!&nbsp;6:30pm: Doors7:00pm: Event starts10:00pm: Event finishes&nbsp;&nbsp;Please note there are open mic slots available for purchase&nbsp;online&nbsp;and there will be a limited amount of&nbsp;sign up spaces on the door!\",\"image\":[\"https:\\/\\/riversidestudios.co.uk\\/images\\/uploads\\/7415253382a160490cb50937855cd909.jpeg\"],\"startDate\":\"2026-01-27T19:00:00+00:00\",\"endDate\":\"2026-01-27T19:00:00+00:00\",\"eventStatus\":\"https:\\/\\/schema.org\\/EventScheduled\"}</script>\n\n    <link href=\"https://riversidestudios.co.uk/whats-on/b2-queer-poetry-open-mic-night/\" rel=\"canonical\"/>\n\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=5, user-scalable=yes