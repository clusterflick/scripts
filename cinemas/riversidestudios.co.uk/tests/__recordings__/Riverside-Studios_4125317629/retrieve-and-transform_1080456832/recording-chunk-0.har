6f9078486b7876b37099abd38ffe23.webp 2048w,https://riversidestudios.co.uk/images/custom/60/6f9078486b7876b37099abd38ffe23/w2880/q80/wpojpeg/images/uploads/606f9078486b7876b37099abd38ffe23.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position: 49.7% 53.6% \" src=\"https://riversidestudios.co.uk/images/custom/60/6f9078486b7876b37099abd38ffe23/w880/q80/images/uploads/606f9078486b7876b37099abd38ffe23.jpeg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/606f9078486b7876b37099abd38ffe23.jpeg&quot;,&quot;fx&quot;:&quot;49.7&quot;,&quot;fy&quot;:&quot;53.6&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;2992&quot;,&quot;height&quot;:&quot;2417&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/60/6f9078486b7876b37099abd38ffe23/w880/q80/images/uploads/606f9078486b7876b37099abd38ffe23.jpeg 880w,https://riversidestudios.co.uk/images/custom/60/6f9078486b7876b37099abd38ffe23/w1210/q80/images/uploads/606f9078486b7876b37099abd38ffe23.jpeg 1210w,https://riversidestudios.co.uk/images/custom/60/6f9078486b7876b37099abd38ffe23/w1470/q80/images/uploads/606f9078486b7876b37099abd38ffe23.jpeg 1470w,https://riversidestudios.co.uk/images/custom/60/6f9078486b7876b37099abd38ffe23/w1680/q80/images/uploads/606f9078486b7876b37099abd38ffe23.jpeg 1680w,https://riversidestudios.co.uk/images/custom/60/6f9078486b7876b37099abd38ffe23/w1870/q80/images/uploads/606f9078486b7876b37099abd38ffe23.jpeg 1870w,https://riversidestudios.co.uk/images/custom/60/6f9078486b7876b37099abd38ffe23/w2048/q80/images/uploads/606f9078486b7876b37099abd38ffe23.jpeg 2048w,https://riversidestudios.co.uk/images/custom/60/6f9078486b7876b37099abd38ffe23/w2880/q80/images/uploads/606f9078486b7876b37099abd38ffe23.jpeg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                   \r\n                  <div class=\"template-surtitle font-yellow font-uppercase font-tag font-title\">Cinema</div>  \r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>The Misfits</span>\r\n              \r\n                     </h1>\r\n                                                <div class=\"age-rating r-pg\" title=\"PG\"></div>\r\n                                              <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Sat 11 - Wed 15 Jul 2026</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"MHRDMVcrdU0xdWJvS1VLOEpTZkgzUT09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p>Riverside Studios' \"<strong>Marilyn in the Movies</strong>\" season celebrates the one and only Marilyn Monroe on the centenary of the birth of cinema’s most enduring film star! The season includes the centrepiece of the British Film Institute's celebration of Monroe: the BFI rerelease of THE MISFITS (1961), John Huston’s elegiac anti-Western and Monroe’s poignant final film.</p><p><strong>Enjoy a 15% discount if you buy two or more tickets to the season in the same order.</strong></p><p>Marilyn in the Movies films:</p><ul><li><i>GENTLEMEN PREFER BLONDES (1953)</i></li><li><i>SOME LIKE IT HOT (1959)</i></li><li><i>THE MISFITS (1961)</i></li></ul><p>&nbsp;</p><p><i><strong>THE MISFITS:</strong></i></p><p>Central to the BFI’s centenary celebration of Marilyn Monroe is BFI Distribution’s re-release of The Misfits (1961), Monroe’s poignant final film, returning to cinemas in the UK and Ireland in June. John Huston’s tragic swan song to the western, written by Monroe’s then-husband Arthur Miller, is a touching and off-beat drama of broken-hearted cowboys and broken-down marriages, co-starring Clark Gable and Montgomery Clift as an aging cowboy and a rodeo-rocked bull rider, both with bittersweet memories of a west that’s no longer wild. Infused with the promises of what could have been if she had been given more time to explore her skills as a dramatic performer, Monroe delivers one of her very best performances, pouring a devastatingly raw vulnerability and a sincere sentimentality into Roslyn, a delicate divorcee who moves out to the Nevada desert, a gathering ground for misfits, burnouts and empty bottles, and who finds herself falling for a similarly lost cowboy.</p><figure class=\"table\"><table><tbody><tr><td><strong>Language:</strong></td><td>English</td></tr><tr><td><strong>Content Warnings:</strong></td><td>TBC</td></tr><tr><td><strong>Director:</strong></td><td>John Huston</td></tr><tr><td><strong>Cast:</strong></td><td>Clark Gable, Marilyn Monroe, Montgomery Clift</td></tr><tr><td><strong>Company:</strong></td><td>BFI</td></tr><tr><td><strong>Interval:</strong></td><td>No</td></tr><tr><td><strong>Trailers:</strong></td><td>20 mins</td></tr><tr><td><strong>Year of Release:</strong></td><td>1961</td></tr></tbody></table></figure></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">125 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n        \n\n<section class=\"block block-events-list\">\n\n\n  <div class=\"container\">\n                <div class=\"block-header has-button\">\n            <div class=\"block-header-left\">\n            <h3 class=\"block-title font-medium font-title font-uppercase font-blue\"><span>Upcoming Cinema</span>\r\n</h3>\n                                </div>\n                      \n          </div>\n            <div class=\"grid\">\n          \n\n<div class=\"grid-item event\">\n  <div class=\"slot event\">\n    \n          <div class=\"slot-image\">\n        <a href=\"https://riversidestudios.co.uk/whats-on/hr-the-invite/\">\n        <div class=\"image-container\">\n                            <picture>\n                  <source sizes=\"(min-width: 1780px) calc(-4.1vw + 484px), (min-width: 1240px) calc(22.12vw + 23px), (min-width: 780px) calc(27.5vw - 21px), (min-width: 460px) 375px, calc(76.43vw + 39px)\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/4d/8da94b4c5c654e2c977b1fd0bdbe66/w400/q80/wpo