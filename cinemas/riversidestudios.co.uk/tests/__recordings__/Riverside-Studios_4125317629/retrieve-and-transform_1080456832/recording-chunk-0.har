v\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"Hire Us / Work With Us\">\n        Hire Us / Work With Us    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>Hire Us / Work With Us</span>\r\n</div>\n                \n\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Comprehensive venue information and contact details for those wanting to bring their production to Riverside Studios, to host a private event or to work here. </div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/hire-us-work-with-us/private-events-and-office-hire/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Private Events and Office Hire\" role=\"menuitem\">\n                      Private Events and Office Hire                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/hire-us-work-with-us/bring-a-show-or-workshop/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Bring a Show or Workshop\" role=\"menuitem\">\n                      Bring a Show or Workshop                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/hire-us-work-with-us/community-partnership-enquiries/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Community & Partnership Enquiries\" role=\"menuitem\">\n                      Community & Partnership Enquiries                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n            <div class=\"nav-item \">\r\n              <a class=\"nav-title has-icon search\" href=\"https://riversidestudios.co.uk/search/\"><span>Search</span></a>\r\n            </div>\r\n          </nav>\r\n          <nav class=\"shop-nav container mobile-only-break-1024\">\r\n                        <div class=\"member-nav\" data-url=\"https://spektrix.riversidestudios.co.uk/riversidestudios/api/v3/customer?$expand=subscriptions\" class=\"nav-item\"></div>\r\n                        <div class=\"nav-item\">\r\n            \t<a draggable=\"false\"  class=\"nav-title has-icon basket basket-trigger\" href=\"https://riversidestudios.co.uk/basket/\"><span>Basket</span> </a>\r\n            </div>\r\n            <div class=\"nav-item acc\">\r\n\r\n              <div class=\"acs-button\" aria-label = \"Open Accessibility menu\">\r\n                <span>Accessibility</span>\r\n              </div>\r\n            </div>\r\n\r\n          </nav>\r\n\r\n        </div>\r\n      </div>\r\n    </div>\r\n</header>\n  <div class=\"video-modals\"></div>\n  <div class=\"side-logo riverside-logo\"><span></span></div>\n  <div class=\"side-logo studios-logo\"><span></span></div>\n\n  <div class=\"membership-container\"></div>\n    <div class=\"overlay\"></div>\n    <div class=\"overlay-login\"></div>\n    <main class=\"outer-container\"  id=\"main-content\"  >\n      <div class=\"filter-overlay\"></div>\n          \r\n\r\n\r\n\r\n\r\n\r\n<div class=\"page page-event\">\r\n  <section class=\"template template-event-detail play-container has-modal  has-text-bottom      \">\r\n\r\n\r\n  \r\n\r\n\r\n    <div class=\"template-top header-padding header-switch\">\r\n                <div class=\"image-container \">\r\n                                <picture>\r\n                    <source sizes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/a7/dd1747398147d6ccb9558fe1324f6f/w880/q80/wpojpg/images/uploads/a7dd1747398147d6ccb9558fe1324f6f.webp 880w,https://riversidestudios.co.uk/images/custom/a7/dd1747398147d6ccb9558fe1324f6f/w1024/q80/wpojpg/images/uploads/a7dd1747398147d6ccb9558fe1324f6f.webp 1210w,https://riversidestudios.co.uk/images/custom/a7/dd1747398147d6ccb9558fe1324f6f/w1024/q80/wpojpg/images/uploads/a7dd1747398147d6ccb9558fe1324f6f.webp 1470w,https://riversidestudios.co.uk/images/custom/a7/dd1747398147d6ccb9558fe1324f6f/w1024/q80/wpojpg/images/uploads/a7dd1747398147d6ccb9558fe1324f6f.webp 1680w,https://riversidestudios.co.uk/images/custom/a7/dd1747398147d6ccb9558fe1324f6f/w1024/q80/wpojpg/images/uploads/a7dd1747398147d6ccb9558fe1324f6f.webp 1870w,https://riversidestudios.co.uk/images/custom/a7/dd1747398147d6ccb9558fe1324f6f/w1024/q80/wpojpg/images/uploads/a7dd1747398147d6ccb9558fe1324f6f.webp 2048w,https://riversidestudios.co.uk/images/custom/a7/dd1747398147d6ccb9558fe1324f6f/w1024/q80/wpojpg/images/uploads/a7dd1747398147d6ccb9558fe1324f6f.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position:  50%  50% \" src=\"https://riversidestudios.co.uk/images/custom/a7/dd1747398147d6ccb9558fe1324f6f/w880/q80/images/uploads/a7dd1747398147d6ccb9558fe1324f6f.jpg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/a7dd1747398147d6ccb9558fe1324f6f.jpg&quot;,&quot;fx&quot;:&quot;&quot;,&quot;fy&quot;:&quot;&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;1024&quot;,&quot;height&quot;:&quot;683&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/a7/dd1747398147d6ccb9558fe1324f6f/w880/q80/images/uploads/a7dd1747398147d6ccb9558fe1324f6f.jpg 880w,https://riversidestudios.co.uk/images/custom/a7/dd1747398147d6ccb9558fe1324f6f/w1024/q80/images/uploads/a7dd1747398147d6ccb9558fe1324f6f.jpg 1210w,https://riversidestudios.co.uk/images/custom/a7/dd1747398147d6ccb9558fe1324f6f/w1024/q80/images/uploads/a7dd1747398147d6ccb9558fe1324f6f.jpg 1470w,https://riversidestudios.co.uk/images/custom/a7/dd1747398147d6ccb9558fe1324f6f/w1024/q80/images/uploads/a7dd1747398147d6ccb9558fe1324f6f.jpg 1680w,https://riversidestudios.co.uk/images/custom/a7/dd1747398147d6ccb9558fe1324f6f/w1024/q80/images/uploads/a7dd1747398147d6ccb9558fe1324f6f.jpg 1870w,https://riversidestudios.co.uk/images/custom/a7/dd1747398147d6ccb9558fe1324f6f/w1024/q80/images/uploads/a7dd1747398147d6ccb9558fe1324f6f.jpg 2048w,https://riversidestudios.co.uk/images/custom/a7/dd1747398147d6ccb9558fe1324f6f/w1024/q80/images/uploads/a7dd1747398147d6ccb9558fe1324f6f.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>For Us, By Us: Workshop Series</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Thu 15 Jan - Fri 8 May 2026</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"Sm9lUkxkejZzcW8rVk9BWTZDQnZ3dz09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p>Created by young people, for young people. 100% youth-led.&nbsp;</p><p><i>“Burnt Orange Theatre is quite right in their assertion that these sorts of stories aren’t told often enough.”</i> – LondonTheatre1 on STORIES&nbsp;</p><p><strong>For Us, By Us</strong> is a bold new programme of 12 youth-led workshops for creatives aged 14–21, designed and curated by the <strong>Burnt Orange Youth Board</strong>. This is young people taking the lead, creating the space, skills, and conversations they know are most needed right now.&nbsp;</p><p>Every session has been imagined by young creatives themselves, their questions, their challenges, and their ambitions; making the programme unlike anything else available. It’s not adults telling you what to do. It’s peers and near-peers building a toolkit for the next generation of artists.&nbsp;</p><p>&nbsp;</p><p><strong>What to expect&nbsp;</strong></p><p>The workshops are wide-ranging, covering both artistic and personal development. Together, you’ll explore:&nbsp;</p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Creative skills – from movement and voice to writing, devising, and self-taping.&nbsp;</p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Industry know-how – producing your own work, navigating auditions, and understanding the business side of creativity.&nbsp;</p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Wellbeing and resilience – tackling the pressures of being a young artist, overcoming creative block, and finding sustainable ways to thrive.&nbsp;</p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Collaboration – learning how to work across disciplines, share ideas, and spark new projects with your peers.&nbsp;</p><p>Each session stands alone, so you can pick and choose the topics that excite you most. But if you commit to multiple workshops, you’ll benefit from a joined-up journey, building a stronger skillset, deeper confidence, and lasting creative friendships.&nbsp;</p><p>&nbsp;</p><p><strong>Why youth-led matters&nbsp;</strong></p><p>The Burnt Orange Youth Board created this series because they know what’s missing for young people in the arts. They’ve been through the hurdles of auditioning, studying, and trying to access opportunities, and they want to pass on what they wish they’d had when starting out. This makes <strong>For Us, By Us</strong> immediately relevant, practical, and rooted in lived experience.&nbsp;</p><p><strong>Burnt Orange Theatre</strong> is a multi-award-winning Community Interest Company (CIC) that creates professional-level opportunities tailored for young people. We work to industry standard while ensuring accessibility, so every young creative has a fair chance to take the next step in their journey.&nbsp;</p><p><i>“What a pleasure to have such a free, fast-paced, fulfilling environment to experiment and grow as a young actor. Burnt Orange are incredible facilitators and craft such a freeing atmosphere for young people.”</i> – Participant Feedback 2025&nbsp;</p><p>Don’t miss out - join <strong>For Us, By Us</strong> and experience a workshop series shaped by young people, for young people. Book your sessions now and be part of the movement.</p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">180 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n    \r\n</div>\r\n  </main>\n\r\n<footer class=\"footer\">\r\n\r\n  <div class=\"container-wide desktop-only-break-1024\">\r\n    <div class=\"footer-inner\">\r\n\r\n\r\n      <div class=\"footer-navs\">\r\n\r\n\r\n                  <div class=\"footer-section\">\r\n\r\n                            <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">See Also</h5>\r\n                            <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/newsletter-signup/\">Newsletter signup</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/vacancies/\">Vacancies</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/policies/\">Policies</a>\r\n                        <div id=\"member-login\"></div>\r\n          </div>\r\n\r\n        \r\n                  <div class=\"footer-section\">\r\n\r\n            <div class=\"footer-nav-top\">\r\n                                <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">Our Website</h5>\r\n                                <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/privacy-and-cookies/\">Privacy and Cookies</a>\r\n                              <a class=\"footer-nav-ite