tom      \">\r\n\r\n\r\n  \r\n\r\n\r\n    <div class=\"template-top header-padding header-switch\">\r\n                <div class=\"image-container \">\r\n                                <picture>\r\n                    <source sizes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/a4/d5aa61016f8953212cec3e0870eab3/w880/q80/wpojpg/images/uploads/a4d5aa61016f8953212cec3e0870eab3.webp 880w,https://riversidestudios.co.uk/images/custom/a4/d5aa61016f8953212cec3e0870eab3/w1210/q80/wpojpg/images/uploads/a4d5aa61016f8953212cec3e0870eab3.webp 1210w,https://riversidestudios.co.uk/images/custom/a4/d5aa61016f8953212cec3e0870eab3/w1470/q80/wpojpg/images/uploads/a4d5aa61016f8953212cec3e0870eab3.webp 1470w,https://riversidestudios.co.uk/images/custom/a4/d5aa61016f8953212cec3e0870eab3/w1680/q80/wpojpg/images/uploads/a4d5aa61016f8953212cec3e0870eab3.webp 1680w,https://riversidestudios.co.uk/images/custom/a4/d5aa61016f8953212cec3e0870eab3/w1870/q80/wpojpg/images/uploads/a4d5aa61016f8953212cec3e0870eab3.webp 1870w,https://riversidestudios.co.uk/images/custom/a4/d5aa61016f8953212cec3e0870eab3/w1920/q80/wpojpg/images/uploads/a4d5aa61016f8953212cec3e0870eab3.webp 2048w,https://riversidestudios.co.uk/images/custom/a4/d5aa61016f8953212cec3e0870eab3/w1920/q80/wpojpg/images/uploads/a4d5aa61016f8953212cec3e0870eab3.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position: 49.6% 39.0% \" src=\"https://riversidestudios.co.uk/images/custom/a4/d5aa61016f8953212cec3e0870eab3/w880/q80/images/uploads/a4d5aa61016f8953212cec3e0870eab3.jpg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/a4d5aa61016f8953212cec3e0870eab3.jpg&quot;,&quot;fx&quot;:&quot;49.6&quot;,&quot;fy&quot;:&quot;39.0&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;1920&quot;,&quot;height&quot;:&quot;1080&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/a4/d5aa61016f8953212cec3e0870eab3/w880/q80/images/uploads/a4d5aa61016f8953212cec3e0870eab3.jpg 880w,https://riversidestudios.co.uk/images/custom/a4/d5aa61016f8953212cec3e0870eab3/w1210/q80/images/uploads/a4d5aa61016f8953212cec3e0870eab3.jpg 1210w,https://riversidestudios.co.uk/images/custom/a4/d5aa61016f8953212cec3e0870eab3/w1470/q80/images/uploads/a4d5aa61016f8953212cec3e0870eab3.jpg 1470w,https://riversidestudios.co.uk/images/custom/a4/d5aa61016f8953212cec3e0870eab3/w1680/q80/images/uploads/a4d5aa61016f8953212cec3e0870eab3.jpg 1680w,https://riversidestudios.co.uk/images/custom/a4/d5aa61016f8953212cec3e0870eab3/w1870/q80/images/uploads/a4d5aa61016f8953212cec3e0870eab3.jpg 1870w,https://riversidestudios.co.uk/images/custom/a4/d5aa61016f8953212cec3e0870eab3/w1920/q80/images/uploads/a4d5aa61016f8953212cec3e0870eab3.jpg 2048w,https://riversidestudios.co.uk/images/custom/a4/d5aa61016f8953212cec3e0870eab3/w1920/q80/images/uploads/a4d5aa61016f8953212cec3e0870eab3.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                   \r\n                  <div class=\"template-surtitle font-yellow font-uppercase font-tag font-title\">Cinema</div>  \r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Kids' Club: The Super Mario Galaxy Movie</span>\r\n              \r\n                     </h1>\r\n                                                <div class=\"age-rating r-pg\" title=\"PG\"></div>\r\n                                              <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Sat 25 - Sun 26 Jul 2026</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"WnhrZGQ5SldVc3RKd0dRWlFXUnFlZz09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p><i><strong>The Super Mario Galaxy Movie </strong></i>finds Mario and Luigi solving everyday problems in the Mushroom Kingdom with their \"let's-a-go\" attitude. They meet a new friend in Yoshi, try to reform a miniaturized Bowser, and eagerly look forward to Peach's birthday party. A call for help sends the crew across the galaxy to face new worlds, unexpected threats, and iconic characters like Rosalina and Bowser Jr.</p><figure class=\"table\"><table><tbody><tr><td><strong>Age Rating:</strong></td><td>PG</td></tr><tr><td><strong>Language:</strong></td><td>English</td></tr><tr><td><strong>Content Warnings:</strong></td><td>mild violence, threat</td></tr><tr><td><strong>Director:</strong></td><td>Aaron Horvath &amp; Michael Jelenic</td></tr><tr><td><strong>Cast:</strong></td><td>Chris Pratt, Anya Taylor-Joy, Brie Larson, Virginia Dare Jelenic, Benny Safdie, Kevin Michael Richardson, Charlie Day, Donald Glover, Keegan-Michael Key, Eric Bauza</td></tr><tr><td><strong>Company:</strong></td><