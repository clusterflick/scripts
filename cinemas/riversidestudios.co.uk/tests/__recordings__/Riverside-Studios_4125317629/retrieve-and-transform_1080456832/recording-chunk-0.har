izes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/8d/86931500919c650652faa51703a54f/w880/q80/wpojpg/images/uploads/8d86931500919c650652faa51703a54f.webp 880w,https://riversidestudios.co.uk/images/custom/8d/86931500919c650652faa51703a54f/w1210/q80/wpojpg/images/uploads/8d86931500919c650652faa51703a54f.webp 1210w,https://riversidestudios.co.uk/images/custom/8d/86931500919c650652faa51703a54f/w1470/q80/wpojpg/images/uploads/8d86931500919c650652faa51703a54f.webp 1470w,https://riversidestudios.co.uk/images/custom/8d/86931500919c650652faa51703a54f/w1680/q80/wpojpg/images/uploads/8d86931500919c650652faa51703a54f.webp 1680w,https://riversidestudios.co.uk/images/custom/8d/86931500919c650652faa51703a54f/w1870/q80/wpojpg/images/uploads/8d86931500919c650652faa51703a54f.webp 1870w,https://riversidestudios.co.uk/images/custom/8d/86931500919c650652faa51703a54f/w2048/q80/wpojpg/images/uploads/8d86931500919c650652faa51703a54f.webp 2048w,https://riversidestudios.co.uk/images/custom/8d/86931500919c650652faa51703a54f/w2880/q80/wpojpg/images/uploads/8d86931500919c650652faa51703a54f.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position: 48.6% 29.6% \" src=\"https://riversidestudios.co.uk/images/custom/8d/86931500919c650652faa51703a54f/w880/q80/images/uploads/8d86931500919c650652faa51703a54f.jpg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/8d86931500919c650652faa51703a54f.jpg&quot;,&quot;fx&quot;:&quot;48.6&quot;,&quot;fy&quot;:&quot;29.6&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;3074&quot;,&quot;height&quot;:&quot;2049&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/8d/86931500919c650652faa51703a54f/w880/q80/images/uploads/8d86931500919c650652faa51703a54f.jpg 880w,https://riversidestudios.co.uk/images/custom/8d/86931500919c650652faa51703a54f/w1210/q80/images/uploads/8d86931500919c650652faa51703a54f.jpg 1210w,https://riversidestudios.co.uk/images/custom/8d/86931500919c650652faa51703a54f/w1470/q80/images/uploads/8d86931500919c650652faa51703a54f.jpg 1470w,https://riversidestudios.co.uk/images/custom/8d/86931500919c650652faa51703a54f/w1680/q80/images/uploads/8d86931500919c650652faa51703a54f.jpg 1680w,https://riversidestudios.co.uk/images/custom/8d/86931500919c650652faa51703a54f/w1870/q80/images/uploads/8d86931500919c650652faa51703a54f.jpg 1870w,https://riversidestudios.co.uk/images/custom/8d/86931500919c650652faa51703a54f/w2048/q80/images/uploads/8d86931500919c650652faa51703a54f.jpg 2048w,https://riversidestudios.co.uk/images/custom/8d/86931500919c650652faa51703a54f/w2880/q80/images/uploads/8d86931500919c650652faa51703a54f.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                   \r\n                  <div class=\"template-surtitle font-yellow font-uppercase font-tag font-title\">Cinema</div>  \r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>The Odyssey</span>\r\n              \r\n                     </h1>\r\n                                                <div class=\"age-rating r-15\" title=\"15\"></div>\r\n                                              <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Fri 17 - Thu 30 Jul 2026</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"UVJmcm5jM2U4Y21sMThTc2hTZzQxZz09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p>Christopher Nolan’s next film, <i><strong>The Odyssey</strong></i>, is a mythic action epic shot across the world using brand new IMAX® film technology. The film brings Homer’s foundational saga to IMAX® film screens for the first time and opens in cinemas everywhere on July 17, 2026. &nbsp;</p><p><i>The Odyssey </i>is produced by Emma Thomas and Christopher Nolan for their company, Syncopy. The executive producer is Thomas Hayslip.</p><figure class=\"table\"><table><tbody><tr><td><strong>Age Rating:</strong></td><td>12A</td></tr><tr><td><strong>Language:</strong></td><td>English</td></tr><tr><td><strong>Content Warnings:</strong></td><td>Strong violence</td></tr><tr><td><strong>Director:</strong></td><td>Christopher Nolan</td></tr><tr><td><strong>Cast:</strong></td><td>Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson and Lupita Nyong’o, with Zendaya and Charlize Theron</td></tr><tr><td><strong>Company:</strong></td><td>Universal</td></tr><tr><td><strong>Interval:</strong></td><td>None</td></tr><tr><td><strong>Trailers:</strong></td><td>20 mins</td></tr><tr><td><strong>Year of Release:</strong></td><td>2026</td></tr><tr><td><strong>Audio Described:</strong></td><td>Yes</td></tr></tbody></table></figure></div>            \r\n\r\n     