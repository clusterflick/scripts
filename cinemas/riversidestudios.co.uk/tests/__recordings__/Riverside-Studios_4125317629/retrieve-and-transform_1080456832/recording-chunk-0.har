         </button>\r\n        </div>\r\n\r\n\r\n        <div class=\"sub-nav-wrapper\"></div>\r\n\r\n        <div class=\"header-bottom \">\r\n          <nav class=\"main-nav container mobile-only-break-1024\">\r\n            \n<div class=\"nav-item\">\n    <a  href=\"https://riversidestudios.co.uk/whats-on/\"  class=\"nav-title active\" title=\"What's On\">\n        What's On    </a>\n    </div>\n<div class=\"nav-item has-sub-nav\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"Your Visit\">\n        Your Visit    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>Your Visit</span>\r\n</div>\n                \n\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Plan your visit with confidence—here you’ll find everything you need to feel prepared, informed, and excited for your time with us, whether it’s your first trip or a return experience.</div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/food-drink/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Food & Drink\" role=\"menuitem\">\n                      Food & Drink                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/getting-here/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Getting Here\" role=\"menuitem\">\n                      Getting Here                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/accessibility/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Accessibility\" role=\"menuitem\">\n                      Accessibility                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/faqs/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"FAQs\" role=\"menuitem\">\n                      FAQs                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/contact-us/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Contact Us\" role=\"menuitem\">\n                      Contact Us                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/ticketing-terms-and-conditions/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Ticketing Terms and Conditions\" role=\"menuitem\">\n                      Ticketing Terms and Conditions                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n<div class=\"nav-item has-sub-nav\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"About Us\">\n        About Us    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>About Us</span>\r\n</div>\n               