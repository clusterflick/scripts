,\n    gdrck = '6LffRNoZAAAAAJIWWC7QG27lobOmUg6S4sE9GI8k',\n  gdmaps = {},\n    $ajaxRequestSent = false;\n</script>\n\n    <script>\n    let gdEvents = false;\n    </script>\n    \n\n      <meta property=\"og:type\" content=\"website\">\n                  <meta property=\"og:title\" content=\"National Theatre Live: The Audience - Riverside Studios\">\n                  <meta property=\"og:url\" content=\"https://riversidestudios.co.uk/whats-on/Zt-national-theatre-live-the-audience/\">\n                  <meta property=\"og:image\" content=\"https://riversidestudios.co.uk/images/uploads/82a91fc4423ef2810d1285b601e80736.png\">\n                  <meta property=\"og:image:secure_url\" content=\"https://riversidestudios.co.uk/images/uploads/82a91fc4423ef2810d1285b601e80736.png\">\n                  <meta property=\"og:description\" content=\"Returning to cinemas for the first time in over a decade, Helen Mirren plays Queen Elizabeth II in the Olivier and Tony Award® -winning hit production, directed by Stephen Daldry. For 60 years, Queen Elizabeth II met with each of her 12 prime ministers i\">\n                  <meta property=\"og:site_name\" content=\"Riverside Studios\">\n                  <meta property=\"og:locale\" content=\"EN_GB\">\n                  <meta property=\"twitter:card\" content=\"summary_large_image\">\n                  <meta property=\"twitter:site\" content=\"@RiversideLondon\">\n                  <meta property=\"twitter:creator\" content=\"@RiversideLondon\">\n                  <meta property=\"twitter:title\" content=\"National Theatre Live: The Audience - Riverside Studios\">\n                  <meta property=\"twitter:description\" content=\"Returning to cinemas for the first time in over a decade, Helen Mirren plays Queen Elizabeth II in the Olivier and Tony Award® -winning hit production, directed by Stephen Daldry. For 60 years, Queen Elizabeth II met with each of her 12 prime ministers i\">\n                  <meta property=\"twitter:image:src\" content=\"https://riversidestudios.co.uk/images/uploads/82a91fc4423ef2810d1285b601e80736.png\">\n                  <meta property=\"twitter:image:alt\" content=\"Riverside Studios\">\n                  <meta property=\"twitter:domain\" content=\"riversidestudios.co.uk\">\n            \n\n\n\n<link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"https://riversidestudios.co.uk/assets/favicons/apple-touch-icon.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"https://riversidestudios.co.uk/assets/favicons/favicon-32x32.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"https://riversidestudios.co.uk/assets/favicons/favicon-16x16.png\">\n<link rel=\"manifest\" href=\"https://riversidestudios.co.uk/assets/favicons/site.webmanifest\">\n<link rel=\"mask-icon\" href=\"https://riversidestudios.co.uk/assets/favicons/safari-pinned-tab.svg\" color=\"#5bbad5\">\n<link rel=\"shortcut icon\" href=\"https://riversidestudios.co.uk/assets/favicons/favicon.ico\">\n<meta name=\"msapplication-TileColor\" content=\"#ffffff\">\n<meta name=\"msapplication-config\" content=\"https://riversidestudios.co.uk/assets/favicons/browserconfig.xml\">\n<meta name=\"theme-color\" content=\"#ffffff\">\n\n\n\n</head>\n<body class=\" \">\n\n  <a draggable=\"false\"  href=\"#main-content\">Skip to main content</a>\n\n<div class=\"nav-overlay\"></div>\r\n\r\n<header id=\"header\">\r\n\r\n  <div class=\"container desktop-only-break-1024\">\r\n        <div class=\"header-inner\">\r\n        <div class=\"header-top \">\r\n          <a href=\"https://riversidestudios.co.uk/\" class=\"logo\" title=\"Riverside Studios Logo\">\r\n              <img src=\"https://riversidestudios.co.uk/assets/img/logo.svg\" alt=\"Riverside Studios Logo\" />\r\n              <span class=\"sr-only\">Riverside Studios</span>\r\n          </a>\r\n          <button class=\"nav-trigger\">\r\n            <span class=\"nav-trigger-label\">Menu</span>\r\n            <span class=\"burger-menu\">\r\n              <span></span>\r\n              <span></span>\r\n              <span></span>\r\n              <span></span>\r\n            </span>\r\n          </button>\r\n        </div>\r\n\r\n\r\n        <div class=\"sub-nav-wrapper\"></div>\r\n\r\n        <div class=\"header-bottom \">\r\n          <nav class=\"main-nav container mobile-only-break-1024\">\r\n            \n<div class=\"nav-item\">\n    <a  href=\"https://riversidestudios.co.uk/whats-on/\"  class=\"nav-title active\" title=\"What's On\">\n        What's On    </a>\n    </div>\n<div class=\"nav-item has-sub-nav\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"Your Visit\">\n        Your Visit    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>Your Visit</span>\r\n</div>\n                \n\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Plan your visit with confidence—here you’ll find everything you need to feel prepared, informed, and excited for your time with us, whether it’s your first trip or a return experience.</div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/food-drink/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Food & Drink\" role=\"menuitem\">\n                      Food & Drink                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/getting-here/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Getting Here\" role=\"menuitem\">\n                      Getting Here                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/accessibility/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Accessibility\" role=\"menuitem\">\n                      Accessibility                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/faqs/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"FAQs\" role=\"menuitem\">\n                      FAQs                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/contact-us/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Contact Us\" role=\"menuitem\">\n                      Contact Us                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/ticketing-terms-and-conditions/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Ticketing Terms and Conditions\" role=\"menuitem\">\n                      Ticketing Terms and Conditions                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n<div class=\"nav-item has-sub-nav\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"About Us\">\n        About Us    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>About Us</span>\r\n</div>\n                \n\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Explore Riverside's unique history as a multi-arts venue and meet our current team.</div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/about-us/our-story/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Our Story\" role=\"menuitem\">\n                      Our Story                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/about-us/our-archive/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Our Archive\" role=\"menuitem\">\n                      Our Archive                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/about-us/the-team/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"The Team\" role=\"menuitem\">\n                      The Team                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n<div class=\"nav-item has-sub-nav\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"Memberships\">\n        Memberships    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>Join & Support Us</span>\r\n</div>\n                \n\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Get more from Riverside Studios with our range of membership options, offering priority booking, discounted tickets and invitations to special events.  \r\n</div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/memberships/riverside-pass/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Riverside Pass\" role=\"menuitem\">\n                      Riverside Pass                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/memberships/dive-in-membership/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Dive In Membership\" role=\"menuitem\">\n                      Dive In Membership                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/memberships/founder-members/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Founder Members\" role=\"menuitem\">\n                      Founder Members                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/memberships/make-a-donation/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Make a Donation\" role=\"menuitem\">\n                      Make a Donation                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n<div class=\"nav-item has-sub-nav\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"Hire Us / Work With Us\">\n        Hire Us / Work With Us    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>Hire Us / Work With Us</span>\r\n</div>\n                \n\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Comprehensive venue information and contact details for those wanting to bring their production to Riverside Studios, to host a private event or to work here. </div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/hire-us-work-with-us/private-events-and-office-hire/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Private Events and Office Hire\" role=\"menuitem\">\n                      Private Events and Office Hire                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/hire-us-work-with-us/bring-a-show-or-workshop/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Bring a Show or Workshop\" role=\"menuitem\">\n                      Bring a Show or Workshop                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/hire-us-work-with-us/community-partnership-enquiries/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Community & Partnership Enquiries\" role=\"menuitem\">\n                      Community & Partnership Enquiries                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n       