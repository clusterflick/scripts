\n\n  <div class=\"membership-container\"></div>\n    <div class=\"overlay\"></div>\n    <div class=\"overlay-login\"></div>\n    <main class=\"outer-container\"  id=\"main-content\"  >\n      <div class=\"filter-overlay\"></div>\n          \r\n\r\n\r\n\r\n\r\n\r\n<div class=\"page page-event\">\r\n  <section class=\"template template-event-detail play-container has-modal  has-text-bottom      \">\r\n\r\n\r\n  \r\n\r\n\r\n    <div class=\"template-top header-padding header-switch\">\r\n                <div class=\"image-container \">\r\n                                <picture>\r\n                    <source sizes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/8b/4220cb71ca091697272f7fe4f0def2/w880/q80/wpojpg/images/uploads/8b4220cb71ca091697272f7fe4f0def2.webp 880w,https://riversidestudios.co.uk/images/custom/8b/4220cb71ca091697272f7fe4f0def2/w1210/q80/wpojpg/images/uploads/8b4220cb71ca091697272f7fe4f0def2.webp 1210w,https://riversidestudios.co.uk/images/custom/8b/4220cb71ca091697272f7fe4f0def2/w1470/q80/wpojpg/images/uploads/8b4220cb71ca091697272f7fe4f0def2.webp 1470w,https://riversidestudios.co.uk/images/custom/8b/4220cb71ca091697272f7fe4f0def2/w1680/q80/wpojpg/images/uploads/8b4220cb71ca091697272f7fe4f0def2.webp 1680w,https://riversidestudios.co.uk/images/custom/8b/4220cb71ca091697272f7fe4f0def2/w1870/q80/wpojpg/images/uploads/8b4220cb71ca091697272f7fe4f0def2.webp 1870w,https://riversidestudios.co.uk/images/custom/8b/4220cb71ca091697272f7fe4f0def2/w2048/q80/wpojpg/images/uploads/8b4220cb71ca091697272f7fe4f0def2.webp 2048w,https://riversidestudios.co.uk/images/custom/8b/4220cb71ca091697272f7fe4f0def2/w2880/q80/wpojpg/images/uploads/8b4220cb71ca091697272f7fe4f0def2.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position: 49.5% 45.3% \" src=\"https://riversidestudios.co.uk/images/custom/8b/4220cb71ca091697272f7fe4f0def2/w880/q80/images/uploads/8b4220cb71ca091697272f7fe4f0def2.jpg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/8b4220cb71ca091697272f7fe4f0def2.jpg&quot;,&quot;fx&quot;:&quot;49.5&quot;,&quot;fy&quot;:&quot;45.3&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;3005&quot;,&quot;height&quot;:&quot;2254&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/8b/4220cb71ca091697272f7fe4f0def2/w880/q80/images/uploads/8b4220cb71ca091697272f7fe4f0def2.jpg 880w,https://riversidestudios.co.uk/images/custom/8b/4220cb71ca091697272f7fe4f0def2/w1210/q80/images/uploads/8b4220cb71ca091697272f7fe4f0def2.jpg 1210w,https://riversidestudios.co.uk/images/custom/8b/4220cb71ca091697272f7fe4f0def2/w1470/q80/images/uploads/8b4220cb71ca091697272f7fe4f0def2.jpg 1470w,https://riversidestudios.co.uk/images/custom/8b/4220cb71ca091697272f7fe4f0def2/w1680/q80/images/uploads/8b4220cb71ca091697272f7fe4f0def2.jpg 1680w,https://riversidestudios.co.uk/images/custom/8b/4220cb71ca091697272f7fe4f0def2/w1870/q80/images/uploads/8b4220cb71ca091697272f7fe4f0def2.jpg 1870w,https://riversidestudios.co.uk/images/custom/8b/4220cb71ca091697272f7fe4f0def2/w2048/q80/images/uploads/8b4220cb71ca091697272f7fe4f0def2.jpg 2048w,https://riversidestudios.co.uk/images/custom/8b/4220cb71ca091697272f7fe4f0def2/w2880/q80/images/uploads/8b4220cb71ca091697272f7fe4f0def2.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Sound Bath: Total Relaxation</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Sun 14 Dec 2025 - Sat 10 Jan 2026</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"M0pRRWhHM3MzWU5zdlhITnhXa2lCQT09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <h2>Indulge in the ultimate relaxation experience at our upcoming 70min Sound Bath!</h2><p>Immerse yourself in a peaceful atmosphere where the soothing sounds of singing bowls, drums, and chimes will wash over you.&nbsp;As the harmonic vibrations resonate through your body, stress and tension will melt away, leaving you with a profound sense of calm and inner balance.&nbsp;</p><p>&nbsp;</p><p>No prior experience is required.&nbsp;</p><p>This event is capped at 20 people and we have <strong>12 yoga mats</strong> available on site to borrow. Therefore, participants should ideally:</p><ul><li>bring their own yoga mat</li><li>wear comfortable and warm clothes</li><li>bring a blanket</li></ul><p>&nbsp;</p><p><i><strong>Please note: this event is NOT suitable if you're pregnant (first trimester), experience epilepsy, severe heart conditions or severe mental disorder (i.e.&nbsp;schizophrenia).</strong></i></p><p>&nbsp;</p><p><strong>Bio</strong></p><p>Consuelo Cogrossi is an Holistic Wellbeing Expert who helps people managing the early signs of anxiety with confidence and ease.&nbsp;As a working mum who recovered from an eating disorder and postnatal anxiety, she understands the struggle of mentally counting calories&nbsp;while perusing restaurant menus and the exhaustion of a never-ending to do list brimming of responsibilities.</p><p>Consuelo blends the best modalities from the Wellbeing industry - including yoga, meditation, sound healing, breathwork and plant medicine through Cacao Ceremonies - to offer you an holistic approach to Wellbeing. These practices are designed to help you release tension in your body, enhance your vitality and sharpen your mental clarity. With Consuelo's guidance&nbsp;you'll learn the tools to confidently navigate the demands of modern life, so you can feel more balanced and energised.&nbsp;</p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">70 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n    \r\n</div>\r\n  </main>\n\r\n<footer class=\"footer\">\r\n\r\n  <div class=\"container-wide desktop-only-break-1024\">\r\n    <div class=\"foote