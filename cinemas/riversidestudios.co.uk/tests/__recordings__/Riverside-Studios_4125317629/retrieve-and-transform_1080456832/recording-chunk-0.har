studios.co.uk/assets/favicons/site.webmanifest\">\n<link rel=\"mask-icon\" href=\"https://riversidestudios.co.uk/assets/favicons/safari-pinned-tab.svg\" color=\"#5bbad5\">\n<link rel=\"shortcut icon\" href=\"https://riversidestudios.co.uk/assets/favicons/favicon.ico\">\n<meta name=\"msapplication-TileColor\" content=\"#ffffff\">\n<meta name=\"msapplication-config\" content=\"https://riversidestudios.co.uk/assets/favicons/browserconfig.xml\">\n<meta name=\"theme-color\" content=\"#ffffff\">\n\n\n\n</head>\n<body class=\" \">\n\n  <a draggable=\"false\"  href=\"#main-content\">Skip to main content</a>\n\n<div class=\"nav-overlay\"></div>\r\n\r\n<header id=\"header\">\r\n\r\n  <div class=\"container desktop-only-break-1024\">\r\n        <div class=\"header-inner\">\r\n        <div class=\"header-top \">\r\n          <a href=\"https://riversidestudios.co.uk/\" class=\"logo\" title=\"Riverside Studios Logo\">\r\n              <img src=\"https://riversidestudios.co.uk/assets/img/logo.svg\" alt=\"Riverside Studios Logo\" />\r\n              <span class=\"sr-only\">Riverside Studios</span>\r\n          </a>\r\n          <button class=\"nav-trigger\">\r\n            <span class=\"nav-trigger-label\">Menu</span>\r\n            <span class=\"burger-menu\">\r\n              <span></span>\r\n              <span></span>\r\n              <span></span>\r\n              <span></span>\r\n            </span>\r\n          </button>\r\n        </div>\r\n\r\n\r\n        <div class=\"sub-nav-wrapper\"></div>\r\n\r\n        <div class=\"header-bottom \">\r\n          <nav class=\"main-nav container mobile-only-break-1024\">\r\n            \n<div class=\"nav-item\">\n    <a  href=\"https://riversidestudios.co.uk/whats-on/\"  class=\"nav-title active\" title=\"What's On\">\n        What's On    </a>\n    </div>\n<div class=\"nav-item has-sub-nav\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"Your Visit\">\n        Your Visit    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>Your Visit</span>\r\n</div>\n                \n\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Plan your visit with confidence—here you’ll find everything you need to feel prepared, informed, and excited for your time with us, whether it’s your first trip or a return experience.</div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/food-drink/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Food & Drink\" role=\"menuitem\">\n                      Food & Drink                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/getting-here/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Getting Here\" role=\"menuitem\">\n                      Getting Here                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/accessibility/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Accessibility\" role=\"menuitem\">\n                      Accessibility                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/faqs/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"FAQs\" role=\"menuitem\">\n                      FAQs                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/contact-us/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Contact Us\" role=\"menuitem\">\n                      Contact Us                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/ticketing-terms-and-conditions/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Ticketing Terms and Conditions\" role=\"menuitem\">\n                      Ticketing Terms and Conditions                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n<div class=\"nav-item has-sub-nav\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"About Us\">\n        About Us    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>About Us</span>\r\n</div>\n                \n\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Explore Riverside's unique history as a multi-arts venue and meet our current team.</div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/about-us/our-story/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Our Story\" role=\"menuitem\">\n                      Our Story                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/about-us/our-archive/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Our Archive\" role=\"menuitem\">\n                      Our Archive                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/about-us/the-team/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"The Team\" role=\"menuitem\">\n                      The Team                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n<div class=\"nav-item has-sub-nav\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"Memberships\">\n        Memberships    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>Join & Support Us</span>\r\n</div>\n                \n\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Get more from Riverside Studios with our range of membership options, offering priority booking, discounted tickets and invitations to special events.  \r\n</div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/memberships/riverside-pass/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Riverside Pass\" role=\"menuitem\">\n                      Riverside Pass                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/memberships/dive-in-membership/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Dive In Membership\" role=\"menuitem\">\n                      Dive In Membership                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/memberships/founder-members/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Founder Members\" role=\"menuitem\">\n                      Founder Members                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/memberships/make-a-donation/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Make a Donation\" role=\"menuitem\">\n                      Make a Donation                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n<div class=\"nav-item has-sub-nav\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"Hire Us / Work With Us\">\n        Hire Us / Work With Us    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>Hire Us / Work With Us</span>\r\n</div>\n                \n\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Comprehensive venue information and contact details for those wanting to bring their production to Riverside Studios, to host a private event or to work here. </div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/hire-us-work-with-us/private-events-and-office-hire/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Private Events and Office Hire\" role=\"menuitem\">\n                      Private Events and Office Hire                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/hire-us-work-with-us/bring-a-show-or-workshop/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Bring a Show or Workshop\" role=\"menuitem\">\n                      Bring a Show or Workshop                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/hire-us-work-with-us/community-partnership-enquiries/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Community & Partnership Enquiries\" role=\"menuitem\">\n                      Community & Partnership Enquiries                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n            <div class=\"nav-item \">\r\n              <a class=\"nav-title has-icon search\" href=\"https://riversidestudios.co.uk/search/\"><span>Search</span></a>\r\n            </div>\r\n          </nav>\r\n          <nav class=\"shop-nav container mobile-only-break-1024\">\r\n                        <div class=\"member-nav\" data-url=\"https://spektrix.riversidestudios.co.uk/riversidestudios/api/v3/customer?$expand=subscriptions\" class=\"nav-item\"></div>\r\n                        <div class=\"nav-item\">\r\n            \t<a draggable=\"false\"  class=\"nav-title has-icon basket basket-trigger\" href=\"https://riversidestudios.co.uk/basket/\"><span>Basket</span> </a>\r\n            </div>\r\n            <div class=\"nav-item acc\">\r\n\r\n              <div class=\"acs-button\" aria-label = \"Open Accessibility menu\">\r\n                <span>Accessibility</span>\r\n              </div>\r\n            </div>\r\n\r\n          </nav>\r\n\r\n        </div>\r\n      </div>\r\n    </div>\r\n</header>\n  <div class=\"video-modals\"></div>\n  <div class=\"side-logo riverside-logo\"><span></span></div>\n  <div class=\"side-logo studios-logo\"><span></span></div>\n\n  <div class=\"membership-container\"></div>\n    <div class=\"overlay\"></div>\n    <div class=\"overlay-login\"></div>\n    <main class=\"outer-container\"  id=\"main-content\"  >\n      <div class=\"filter-overlay\"></div>\n          \r\n\r\n\r\n\r\n\r\n\r\n<div class=\"page page-event\">\r\n  <section class=\"template template-event-detail play-container has-modal  has-text-bottom      \">\r\n\r\n\r\n  \r\n\r\n\r\n    <div class=\"template-top header-padding header-switch\">\r\n                <div class=\"image-container \">\r\n                                <picture>\r\n                    <source sizes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/d5/b9e9d6d62bdca12eac9792da3e548a/w880/q80/wpojpg/images/uploads/d5b9e9d6d62bdca12eac9792da3e548a.webp 880w,https://riversidestudios.co.uk/images/custom/d5/b9e9d6d62bdca12eac9792da3e548a/w1210/q80/wpojpg/images/uploads/d5b9e9d6d62bdca12eac9792da3e548a.webp 1210w,https://riversidestudios.co.uk/images/custom/d5/b9e9d6d62bdca12eac9792da3e548a/w1470/q80/wpojpg/images/uploads/d5b9e9d6d62bdca12eac9792da3e548a.webp 1470w,https://riversidestudios.co.uk/images/custom/d5/b9e9d6d62bdca12eac9792da3e548a/w1680/q80/wpojpg/images/uploads/d5b9e9d6d62bdca12eac9792da3e548a.webp 1680w,https://riversidestudios.co.uk/images/custom/d5/b9e9d6d62bdca12eac9792da3e548a/w1870/q80/wpojpg/images/uploads/d5b9e9d6d62bdca12eac9792da3e548a.webp 1870w,https://riversidestudios.co.uk/images/custom/d5/b9e9d6d62bdca12eac9792da3e548a/w2048/q80/wpojpg/images/uploads/d5b9e9d6d62bdca12eac9792da3e548a.webp 2048w,https://riversidestudios.co.uk/images/custom/d5/b9e9d6d62bdca12eac9792da3e548a/w2880/q80/wpojpg/images/uploads/d5b9e9d6d62bdca12eac9792da3e548a.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position: 41.8% 38.6% \" src=\"https://riversidestudios.co.uk/images/custom/d5/b9e9d6d62bdca12eac9792da3e548a/w880/q80/images/uploads/d5b9e9d6d62bdca12eac9792da3e548a.jpg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/d5b9e9d6d62bdca12eac9792da3e548a.jpg&quot;,&quot;fx&quot;:&quot;41.8&quot;,&quot;fy&quot;:&quot;38.6&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;5184&quot;,&quot;height&quot;:&quot;3456&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/d5/b9e9d6d62bdca12eac9792da3e548a/w880/q80/images/uploads/d5b9e9d6d62bdca12eac9792da3e548a.jpg 880w,https://riversidestudios.co.uk/images/custom/d5/b9e9d6d62bdca12eac9792da3e548a/w1210/q80/images/uploads/d5b9e9d6d62bdca12eac9792da3e548a.jpg 1210w,https://riversidestudios.co.uk/images/custom/d5/b9e9d6d62bdca12eac9792da3e548a/w1470/q80/images/uploads/d5b9e9d6d62bdca12eac9792da3e548a.jpg 1470w,https://riversidestudios.co.uk/images/custom/d5/b9e9d6d62bdca12eac9792da3e548a/w1680/q80/images/uploads/d5b9e9d6d62bdca12eac9792da3e548a.jpg 1680w,https://riversidestudios.co.uk/images/custom/d5/b9e9d6d62bdca12eac9792da3e548a/w1870/q80/images/uploads/d5b9e9d6d62bdca12eac9792da3e548a.jpg 1870w,https://riversidestudios.co.uk/images/custom/d5/b9e9d6d62bdca12eac9792da3e548a/w2048/q80/images/uploads/d5b9e9d6d62bdca12eac9792da3e548a.jpg 2048w,https://riversidestudios.co.uk/images/custom/d5/b9e9d6d62bdca12eac9792da3e548a/w2880/q80/images/uploads/d5b9e9d6d62bdca12eac9792da3e548a.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Young Riverscribes</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Sun 18 Jan - Sun 29 Mar 2026</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"OEM3ZG90QlVDVVUxWE1XRnlPK1hWdz09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <h3>Join Burnt Orange Theatre’s brand-new Young Riverscribes project, created in partnership with Riverside Studios.</h3><blockquote><p>“Burnt Orange are a vital cog in the mad machine that is the world of theatre: a world where chances are dwindling away for all but the very lucky who can afford it.” – Everything Theatre&nbsp;</p></blockquote><p><strong>Young Riverscribes </strong>is more than a youth theatre, it's a revolutionary creative platform designed with and for young people aged 14–21. Over a series of dynamic workshops, you’ll gain the skills and confidence to collaborate, create, and perform both as an individual artist and as part of a thriving ensemble.&nbsp;</p><p>At the heart of the project is <strong>Demystify</strong>, our unique built-in support system offering insider industry knowledge every step of the way. Expect Q&amp;As, networking opportunities, guest professionals, and practical guidance that will help you navigate the creative industries with clarity and confidence.&nbsp;</p><p>Each fortnightly session is led by the Burnt Orange team alongside special guests such as casting assistants, agents, drama school tutors, and working artists. Every workshop is tailored to the passions and needs of the group, covering:&nbsp;</p><p>● Performing scripted work&nbsp;</p><p>● Writing and devising&nbsp;</p><p>● Directing and creative leadership&nbsp;</p><p>● Screen acting skills&nbsp;</p><p>● Scratch night opportunities&nbsp;</p><p>● And any other creative roles you’re eager to explore&nbsp;</p><p>&nbsp;</p><p>Young Riverscribes is designed to grow with you; the more sessions you attend, the more your skills and creative relationships will develop. We encourage participants to commit to multiple sessions to build a collaborative ensemble, and discounted booking is available when you sign up for more than one.&nbsp;</p><p>If cost is a barrier, free places are available. Just contact us directly at <a href=\"mailto:burntorange.theatre@gmail.com\"><strong>burntorange.theatre@gmail.com</strong></a>.&nbsp;</p><p>&nbsp;</p><p><i>“It is evident to me that Burnt Orange Theatre understand young people, their context and what motivates them.”</i> – Workshop Feedback 2024&nbsp;</p><p>Ready to take the leap? Book your place in <strong>Young Riverscribes </strong>today and start building your creative future.&nbsp;</p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">180 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n    \r\n</div>\r\n  </main>\n\r\n<footer class=\"footer\">\r\n\r\n  <div class=\"container-wide desktop-only-break-1024\">\r\n    <div class=\"footer-inner\">\r\n\r\n\r\n      <div class=\"footer-navs\">\r\n\r\n\r\n                  <div class=\"footer-section\">\r\n\r\n                            <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">See Also</h5>\r\n                            <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/newsletter-signup/\">Newsletter signup</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/vacancies/\">Vacancies</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/policies/\">Policies</a>\r\n                        <div id=\"member-login\"></div>\r\n          </div>\r\n\r\n        \r\n                  <div class=\"footer-section\">\r\n\r\n            <div class=\"footer-nav-top\">\r\n                                <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">Our Website</h5>\r\n                                <a class=\