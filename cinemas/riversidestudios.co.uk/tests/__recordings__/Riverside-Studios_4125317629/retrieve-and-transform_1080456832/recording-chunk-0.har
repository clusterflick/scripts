54d8f8c70435d09d7b10df03fb5c5c/w880/q80/wpojpg/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.webp 880w,https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w1210/q80/wpojpg/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.webp 1210w,https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w1470/q80/wpojpg/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.webp 1470w,https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w1680/q80/wpojpg/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.webp 1680w,https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w1870/q80/wpojpg/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.webp 1870w,https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w2048/q80/wpojpg/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.webp 2048w,https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w2880/q80/wpojpg/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position:  50%  50% \" src=\"https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w880/q80/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.jpg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/2454d8f8c70435d09d7b10df03fb5c5c.jpg&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;3840&quot;,&quot;height&quot;:&quot;2160&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w880/q80/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.jpg 880w,https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w1210/q80/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.jpg 1210w,https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w1470/q80/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.jpg 1470w,https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w1680/q80/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.jpg 1680w,https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w1870/q80/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.jpg 1870w,https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w2048/q80/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.jpg 2048w,https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w2880/q80/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                   \r\n                  <div class=\"template-surtitle font-yellow font-uppercase font-tag font-title\">London Breeze Film Festival</div>  \r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Disremember + Q&A</span>\r\n              \r\n                     </h1>\r\n                                                <div class=\"age-rating r-18\" title=\"18\"></div>\r\n                                              <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Tue 27 Jan 2026 18:15</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"SEtkSWVpNFpIdmRVdm82NmhVbnIzZz09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p><strong>London Breeze</strong> is delighted to have an opportunity to bring the winner of its Best Feature Fiction award for 2025, taut psychological thriller, DISREMEMBER, to the Riverside Studios. &nbsp;</p><p>After learning his wife wants a divorce, a struggling alcoholic wakes up unexpectedly in his friend’s apartment with no memory of how he got there. As Rob tries to piece together what happened, the blackouts continue, leaving him in unfamiliar places with no recollection of how he got there. Determined to regain control, he installs CCTV cameras—only to discover something far more disturbing than he ever imagined. A truth his own mind refuses to remember.</p><p>Writer, director and actor, Matthew Simpson, will join us after the film to talk about his extraordinary journey to making his multi award winning debut feature as a solo filmmaker. Come and be inspired.</p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">84 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n        \n<section class=\"block block-media \">\n\n            <div class=\"block-header\">\n          <div class=\"container\">\n                        <h3 class=\"block-title font-title font-medium font-blue font-uppercase\"><span>Trailer</span>\r\n</h3>\n                 \n          </div>\n        </div>\n    \n    \n          <div class=\"container-wide desktop-only-break-768\">\n    <div class=\"slot play-video has-video \">\n\n      <div class=\"slot-image image-container \">\n\n                    <div class=\"image-bg\"></div>\n                  <picture>\n          <source sizes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w1870/q80/wpojpg/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.webp 1870w,https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w2048/q80/wpojpg/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.webp 2048w,https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w2880/q80/wpojpg/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.webp 2880w\">\n            <img loading=\"lazy\" sizes=\"100vw\"  style=\"object-position:  50%  50% \" src=\"https://riversidestudios.co.uk/images/custom/24/54d8f8c70435d09d7b10df03fb5c5c/w1870/q80/images/uploads/2454d8f8c70435d09d7b10df03fb5c5c.jpg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/2454d8f8c70435d09d7b10df03fb5c5c.jpg&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;3840&quot;,&quot;height&quot;:&quot;2160&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custo