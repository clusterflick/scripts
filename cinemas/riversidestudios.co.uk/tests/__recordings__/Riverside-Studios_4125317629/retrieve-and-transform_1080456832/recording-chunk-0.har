stom/30/3fed538b5ea2786cbce35d056e28dc/w538/q80/images/uploads/303fed538b5ea2786cbce35d056e28dc.PNG 1470w,https://riversidestudios.co.uk/images/custom/30/3fed538b5ea2786cbce35d056e28dc/w538/q80/images/uploads/303fed538b5ea2786cbce35d056e28dc.PNG 1680w,https://riversidestudios.co.uk/images/custom/30/3fed538b5ea2786cbce35d056e28dc/w538/q80/images/uploads/303fed538b5ea2786cbce35d056e28dc.PNG 1870w,https://riversidestudios.co.uk/images/custom/30/3fed538b5ea2786cbce35d056e28dc/w538/q80/images/uploads/303fed538b5ea2786cbce35d056e28dc.PNG 2048w,https://riversidestudios.co.uk/images/custom/30/3fed538b5ea2786cbce35d056e28dc/w538/q80/images/uploads/303fed538b5ea2786cbce35d056e28dc.PNG 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                   \r\n                  <div class=\"template-surtitle font-yellow font-uppercase font-tag font-title\">Cinema</div>  \r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Alpha</span>\r\n              \r\n                     </h1>\r\n                                                <div class=\"age-rating r-15\" title=\"15\"></div>\r\n                                              <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Sat 11 - Tue 14 Jul 2026</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"ZGE4OXFxU1VTb2dYbEI1RzZDVGpsZz09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <h3>Please note there will be a 10 minute interval at the midway point of this film.</h3><p>Welcome to the newest chapter of the <strong>YRF Spy Universe </strong>that presents an edgy origin story of a girl raised and built to kill. <i><strong>Alpha</strong></i> is a female-led action film that will take you on a fun, edge of the seat, thrilling ride that is designed as an out and out entertainer.</p><p>Produced by Aditya Chopra and directed by Shiv Rawail, acclaimed for the globally celebrated series <i>The Railway Men</i>.</p><figure class=\"table\"><table><tbody><tr><td><strong>Age Rating:</strong></td><td>15</td></tr><tr><td><strong>Language:</strong></td><td>Hindi with subtitles</td></tr><tr><td><strong>Content Warnings:</strong></td><td>strong violence, injury detail</td></tr><tr><td><strong>Director:</strong></td><td>Shiv Rawail</td></tr><tr><td><strong>Cast:</strong></td><td>Alia Bhatt, Sharvari, Madhavan, Anil Kapoor, Bobby Deol</td></tr><tr><td><strong>Company:</strong></td><td>Yash Raj Films</td></tr><tr><td><strong>Trailers:</strong></td><td>20 mins</td></tr><tr><td><strong>Year of Release:</strong></td><td>2026</td></tr></tbody></table></figure></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event