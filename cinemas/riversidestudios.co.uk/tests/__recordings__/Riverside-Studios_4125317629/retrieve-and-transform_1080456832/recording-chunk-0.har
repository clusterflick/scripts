ercase font-blue\"><span>Your Visit</span>\r\n</div>\n                \n\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Plan your visit with confidence—here you’ll find everything you need to feel prepared, informed, and excited for your time with us, whether it’s your first trip or a return experience.</div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/food-drink/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Food & Drink\" role=\"menuitem\">\n                      Food & Drink                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/getting-here/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Getting Here\" role=\"menuitem\">\n                      Getting Here                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/accessibility/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Accessibility\" role=\"menuitem\">\n                      Accessibility                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/faqs/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"FAQs\" role=\"menuitem\">\n                      FAQs                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/contact-us/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Contact Us\" role=\"menuitem\">\n                      Contact Us                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/plan-your-visit/ticketing-terms-and-conditions/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Ticketing Terms and Conditions\" role=\"menuitem\">\n                      Ticketing Terms and Conditions                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n<div class=\"nav-item has-sub-nav\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"About Us\">\n        About Us    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>About Us</span>\r\n</div>\n                \n\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Explore Riverside's unique history as a multi-arts venue and meet our current team.</div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/about-us/our-story/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Our Story\" role=\"menuitem\">\n                      Our Story                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/about-us/our-archive/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Our Archive\" role=\"menuitem\">\n                      Our Archive                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/about-us/the-team/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"The Team\" role=\"menuitem\">\n                      The Team                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n<div class=\"nav-item has-sub-nav\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"Memberships\">\n        Memberships    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>Join & Support Us</span>\r\n</div>\n                \n\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Get more from Riverside Studios with our range of membership options, offering priority booking, discounted tickets and invitations to special events.  \r\n</div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/memberships/riverside-pass/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Riverside Pass\" role=\"menuitem\">\n                      Riverside Pass                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/memberships/dive-in-membership/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Dive In Membership\" role=\"menuitem\">\n                      Dive In Membership                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/memberships/founder-members/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Founder Members\" role=\"menuitem\">\n                      Founder Members                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/memberships/make-a-donation/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Make a Donation\" role=\"menuitem\">\n                      Make a Donation                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n<div class=\"nav-item has-sub-nav\">\n    <a  href=\"javascript:void(0);\"  aria-haspopup=\"true\" aria-expanded=\"false\"  class=\"nav-title\" title=\"Hire Us / Work With Us\">\n        Hire Us / Work With Us    </a>\n            <div class=\"sub-nav\">\n          <div class=\"container desktop-only-break-1024 sub-nav-inner\">\n            <div class=\"sub-nav-top container mobile-only-break-1024\">\n\n              <div class=\"sub-nav-top-content\">\n                <button class=\"button button-text button-text-back button-back\">Back</button>\n\n                                <div class=\"font-sub-nav-title sub-nav-title  font-title  font-uppercase font-blue\"><span>Hire Us / Work With Us</span>\r\n</div>\n                \n\n                \n                                <div class=\"sub-nav-text font-bold font-xsmall font-blue\">Comprehensive venue information and contact details for those wanting to bring their production to Riverside Studios, to host a private event or to work here. </div>\n                \n\n              </div>\n            </div>\n            <div class=\"sub-nav-bottom container mobile-only-break-1024\">\n                            \n                                    <a  href=\"https://riversidestudios.co.uk/hire-us-work-with-us/private-events-and-office-hire/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Private Events and Office Hire\" role=\"menuitem\">\n                      Private Events and Office Hire                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/hire-us-work-with-us/bring-a-show-or-workshop/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Bring a Show or Workshop\" role=\"menuitem\">\n                      Bring a Show or Workshop                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/hire-us-work-with-us/community-partnership-enquiries/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Community & Partnership Enquiries\" role=\"menuitem\">\n                      Community & Partnership Enquiries                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n            <div class=\"nav-item \">\r\n              <a class=\"nav-title has-icon search\" href=\"https://riversidestudios.co.uk/search/\"><span>Search</span></a>\r\n            </div>\r\n          </nav>\r\n          <nav class=\"shop-nav container mobile-only-break-1024\">\r\n                        <div class=\"member-nav\" data-url=\"https://spektrix.riversidestudios.co.uk/riversidestudios/api/v3/customer?$expand=subscriptions\" class=\"nav-item\"></div>\r\n                        <div class=\"nav-item\">\r\n            \t<a draggable=\"false\"  class=\"nav-title has-icon basket basket-trigger\" href=\"https://riversidestudios.co.uk/basket/\"><span>Basket</span> </a>\r\n            </div>\r\n            <div class=\"nav-item acc\">\r\n\r\n              <div class=\"acs-button\" aria-label = \"Open Accessibility menu\">\r\n                <span>Accessibility</span>\r\n              </div>\r\n            </div>\r\n\r\n          </nav>\r\n\r\n        </div>\r\n      </div>\r\n    </div>\r\n</header>\n  <div class=\"video-modals\"></div>\n  <div class=\"side-logo riverside-logo\"><span></span></div>\n  <div class=\"side-logo studios-logo\"><span></span></div>\n\n  <div class=\"membership-container\"></div>\n    <div class=\"overlay\"></div>\n    <div class=\"overlay-login\"></div>\n    <main class=\"outer-container\"  id=\"main-content\"  >\n      <div class=\"filter-overlay\"></div>\n          \r\n\r\n\r\n\r\n\r\n\r\n<div class=\"page page-event\">\r\n  <section class=\"template template-event-detail play-container has-modal  has-text-bottom      \">\r\n\r\n\r\n  \r\n\r\n\r\n    <div class=\"template-top header-padding header-switch\">\r\n                <div class=\"image-container \">\r\n                                <picture>\r\n                    <source sizes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/5e/d3c152ad1dcfd8c0c199f6ffb17975/w880/q80/wpojpg/images/uploads/5ed3c152ad1dcfd8c0c199f6ffb17975.webp 880w,https://riversidestudios.co.uk/images/custom/5e/d3c152ad1dcfd8c0c199f6ffb17975/w1210/q80/wpojpg/images/uploads/5ed3c152ad1dcfd8c0c199f6ffb17975.webp 1210w,https://riversidestudios.co.uk/images/custom/5e/d3c152ad1dcfd8c0c199f6ffb17975/w1470/q80/wpojpg/images/uploads/5ed3c152ad1dcfd8c0c199f6ffb17975.webp 1470w,https://riversidestudios.co.uk/images/custom/5e/d3c152ad1dcfd8c0c199f6ffb17975/w1680/q80/wpojpg/images/uploads/5ed3c152ad1dcfd8c0c199f6ffb17975.webp 1680w,https://riversidestudios.co.uk/images/custom/5e/d3c152ad1dcfd8c0c199f6ffb17975/w1870/q80/wpojpg/images/uploads/5ed3c152ad1dcfd8c0c199f6ffb17975.webp 1870w,https://riversidestudios.co.uk/images/custom/5e/d3c152ad1dcfd8c0c199f6ffb17975/w2048/q80/wpojpg/images/uploads/5ed3c152ad1dcfd8c0c199f6ffb17975.webp 2048w,https://riversidestudios.co.uk/images/custom/5e/d3c152ad1dcfd8c0c199f6ffb17975/w2880/q80/wpojpg/images/uploads/5ed3c152ad1dcfd8c0c199f6ffb17975.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position: 54.1% 27.4% \" src=\"https://riversidestudios.co.uk/images/custom/5e/d3c152ad1dcfd8c0c199f6ffb17975/w880/q80/images/uploads/5ed3c152ad1dcfd8c0c199f6ffb17975.jpg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/5ed3c152ad1dcfd8c0c199f6ffb17975.jpg&quot;,&quot;fx&quot;:&quot;54.1&quot;,&quot;fy&quot;:&quot;27.4&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;5000&quot;,&quot;height&quot;:&quot;3333&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/5e/d3c152ad1dcfd8c0c199f6ffb17975/w880/q80/images/uploads/5ed3c152ad1dcfd8c0c199f6ffb17975.jpg 880w,https://riversidestudios.co.uk/images/custom/5e/d3c152ad1dcfd8c0c199f6ffb17975/w1210/q80/images/uploads/5ed3c152ad1dcfd8c0c199f6ffb17975.jpg 1210w,https://riversidestudios.co.uk/images/custom/5e/d3c152ad1dcfd8c0c199f6ffb17975/w1470/q80/images/uploads/5ed3c152ad1dcfd8c0c199f6ffb17975.jpg 1470w,https://riversidestudios.co.uk/images/custom/5e/d3c152ad1dcfd8c0c199f6ffb17975/w1680/q80/images/uploads/5ed3c152ad1dcfd8c0c199f6ffb17975.jpg 1680w,https://riversidestudios.co.uk/images/custom/5e/d3c152ad1dcfd8c0c199f6ffb17975/w1870/q80/images/uploads/5ed3c152ad1dcfd8c0c199f6ffb17975.jpg 1870w,https://riversidestudios.co.uk/images/custom/5e/d3c152ad1dcfd8c0c199f6ffb17975/w2048/q80/images/uploads/5ed3c152ad1dcfd8c0c199f6ffb17975.jpg 2048w,https://riversidestudios.co.uk/images/custom/5e/d3c152ad1dcfd8c0c199f6ffb17975/w2880/q80/images/uploads/5ed3c152ad1dcfd8c0c199f6ffb17975.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Bossa Nova Night: A Tribute to João Gilberto by Mario Bakuna</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Sat 31 Jan 2026 19:30</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"cUduTEFRRnRaNzFXbGs0Rzg1eGxydz09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p><i>Featuring Mario Bakuna on Acoustic Guitar and Vocals</i></p><p>Following sold-out performances across the UK, Portugal, France, Spain, and the Netherlands, Mario Bakuna is delighted to bring this special concert to the Riverside Studios.</p><p>Join him in celebrating the legacy of João Gilberto, the legendary Brazilian musician and pioneering father of Bossa Nova in the late 1950s. In this heartfelt tribute, Mario Bakuna presents reinterpretations of Gilberto’s work alongside his own original compositions. Audiences can expect a rich blend of traditional samba elements, syncopated rhythms of plucked chords, and the breezy sophistication that defines Bossa Nova.</p><p>&nbsp;</p><p><strong>Mario Bakuna</strong> is a Brazilian composer, arranger, vocalist, and guitarist with over 20 years of professional experience, currently based in London, UK. Well known for his deep exploration of traditional Brazilian rhythms, samba, jazz, and bossa nova, Mario focuses on both original compositions and fresh arrangements of works by iconic artists like Tom Jobim, Dorival Caymmi, Paulo Moura, and João Donato. In recent years, he has also dedicated his research and performance to reinterpreting Samba Jazz, a genre that emerged in 1950s Rio de Janeiro through the work of artists like Luiz Eça, Tamba Trio, and Edson Machado. This style blends Brazilian standards with sophisticated harmonies influenced by the post–bossa nova movement.</p><p>Driven by a passion for musical exploration, Mario moved to Europe to deepen his research and expand his artistic horizons. Since settling in London, he has collaborated with artists such as Jean Toussaint, Liam Noble, Ricardo dos Santos, Edmundo Carneiro, Cacau Queiroz, Alain Jean-Marie, Dudu Penz, and Filó Machado. He has since become a prominent figure and key reference in the UK’s Brazilian jazz scene, performing extensively across Europe and beyond at renowned venues and international festivals.</p><p>His albums <i>Where Rio de Janeiro Meets Bahia</i> and <i>Brazilian Landscapes</i> highlight his ability to fuse traditional roots with a contemporary musical sensibility. With sold-out concerts and critical acclaim, these projects have toured across 20 European countries, as well as Brazil, Canada, Madagascar, Egypt, Kazakhstan, and Azerbaijan—captivating audiences around the world.</p><p>&nbsp;</p><p>“<i>Mario Bakuna, a sparkling guitarist, plays with palpable feeling - his virtuosic fluency on the fretboard is controlled and flourishes are perfectly placed. His voice has a texture like heavy cloth”. (Songlines Magazine)</i></p><p><i>“Mario Bakuna, a man who exudes music. (…) ‘vocals’ doesn’t begin to do him justice: his expressive range and the precision with which he was able to deploy it was truly the band’s fifth instrument. &nbsp;(…) And he did this while playing guitar with precision and finesse. (…) his solos were a further source of amazement, his technique somewhere between finger-picking style and classical. His solo introduction to a Baden Powell number made a hash of any attempt at a definition.” (The Whitman Review, Wakefield Jazz)</i></p><p>&nbsp;</p><p>Website: <a href=\"https://www.mariobakuna.com/\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.mariobakuna.com</a></p><p>Facebook: <a href=\"https://www.facebook.com/MarioBakunaMusician\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.facebook.com/MarioBakunaMusician</a></p><p>Instagram: <a href=\"https://www.instagram.com/mariobakuna\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.instagram.com/mariobakuna</a></p><p>YouTube: <a href=\"https://www.youtube.com/c/mariobakuna\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.youtube.com/c/mariobakuna</a></p><p>Listen:&nbsp;<a href=\"https://mariobakuna.bandcamp.com/\" target=\"_blank\" rel=\"noopener noreferrer\">https://mariobakuna.bandcamp.com</a></p><p>&nbsp;</p><p>Video sample:&nbsp;<a href=\"https://www.youtube.com/watch?v=i8f5jxuzASE\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.youtube.com/watch?v=i8f5jxuzASE</a></p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">90 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n    \r\n</div>\r\n  </main>\n\r\n<footer class=\"footer\">\r\n\r\n  <div class=\"container-wide desktop-only-break-1024\">\r\n    <div class=\"footer-inner\">\r\n\r\n\r\n      <div class=\"footer-navs\">\r\n\r\n\r\n                  <div class=\"footer-section\">\r\n\r\n                            <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">See Also</h5>\r\n                            <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/newsletter-signup/\">Newsletter signup</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/vacancies/\">Vacancies</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/policies/\">Policies</a>\r\n                        <div id=\"member-login\"></div>\r\n          </div>\r\n\r\n        \r\n                  <div class=\"footer-section\">\r\n\r\n            <div class=\"footer-nav-top\">\r\n                                <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">Our Website</h5>\r\n                                <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/privacy-and-cookies/\">Privacy and Cookies</a>\r\n                              <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/website-accessibility/\">Website Accessibility</a>\r\n                          </div>\r\n          </div>\r\n\r\n        \r\n        \r\n        \r\n              </div>\r\n\r\n\r\n\r\n      <div class=\"footer-bottom\">\r\n        <div class=\"footer-logos\">\r\n        </div>\r\n\r\n                  <div class=\"footer-social\">\r\n            <div class=\"footer-social-inner\">\r\n              <nav class=\"social-icons \">\r\n