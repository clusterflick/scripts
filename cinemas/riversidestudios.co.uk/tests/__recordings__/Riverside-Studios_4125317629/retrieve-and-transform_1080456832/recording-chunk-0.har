b3236c2fa62e1dfbe90c.jpg 1680w,https://riversidestudios.co.uk/images/custom/30/ec28752ef2b3236c2fa62e1dfbe90c/w1870/q80/images/uploads/30ec28752ef2b3236c2fa62e1dfbe90c.jpg 1870w,https://riversidestudios.co.uk/images/custom/30/ec28752ef2b3236c2fa62e1dfbe90c/w2048/q80/images/uploads/30ec28752ef2b3236c2fa62e1dfbe90c.jpg 2048w,https://riversidestudios.co.uk/images/custom/30/ec28752ef2b3236c2fa62e1dfbe90c/w2048/q80/images/uploads/30ec28752ef2b3236c2fa62e1dfbe90c.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Pilates with Athena</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Tue 16 Dec 2025 - Tue 31 Mar 2026</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"SmRCaHRPbk5DVDNZbnFRNjY1VWJmUT09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p>Pilates is a method of exercise that can help to improve flexibility, build strength, endurance, postural alignment, it helps to develop a strong core and improve posture, coordination and balance. Emphasis is on correct breathing, working muscles of the abdomen, lower back and hips which are essential for stability and strength of the spine.</p><p>&nbsp;</p><p>The <a href=\"https://www.instagram.com/pilateswithathena/\" target=\"_blank\" rel=\"noopener noreferrer\"><strong>Pilates with Athena</strong></a><strong> </strong>system allows for exercises to be adapted to suit all levels, whether a complete beginner to more advanced.&nbsp;</p><p>Pilates is also an excellent method of exercise during all stages of pregnancy, and very good post partum to regain the strength of the core.&nbsp;<br>&nbsp;</p><p>Pilates is a fantastic mind and body discipline, creating a full body workout using bodyweight and some equipment to enhance some exercises.</p><p>&nbsp;</p><p>Instagram: @pilateswithathena</p><p>Website: <a href=\"https://www.atozfitness.co.uk/\">Home | My Site</a></p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">45 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n    \r\n</div>\r\n  </main>\n\r\n<footer class=\"footer\">\r\n\r\n  <div class=\"container-wide desktop-only-break-1024\">\r\n    <div class=\"footer-inner\">\r\n\r\n\r\n      <div class=\"footer-navs\">\r\n\r\n\r\n                  <div class=\"footer-section\">\r\n\r\n                            <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">See Also</h5>\r\n                            <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/newsletter-signup/\">Newsletter signup</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/vacancies/\">Vacancies</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/policies/\">Policies</a>\r\n                        <div id=\"member-login\"></div>\r\n          </div>\r\n\r\n        \r\n                  <div class=\"footer-section\">\r\n\r\n            <div class=\"footer-nav-top\">\r\n                                <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">Our Website</h5>\r\n                                <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/privacy-and-cookies/\">Privacy and Cookies</a>\r\n                              <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/website-accessibility/\">Website Accessibility</a>\r\n                          </div>\r\n          </div>\r\n\r\n        \r\n        \r\n        \r\n              </div>\r\n\r\n\r\n\r\n      <div class=\"footer-bottom\">\r\n        <div class=\"footer-logos\">\r\n        </div>\r\n\r\n                  <div class=\"footer-social\">\r\n           