          Bring a Show or Workshop                  </a>\n                                    <a  href=\"https://riversidestudios.co.uk/hire-us-work-with-us/community-partnership-enquiries/\" class=\"sub-nav-item font-sub-nav font-bold font-blue\" title=\"Community & Partnership Enquiries\" role=\"menuitem\">\n                      Community & Partnership Enquiries                  </a>\n                                            </div>\n          </div>\n\n        </div>\n    </div>\n            <div class=\"nav-item \">\r\n              <a class=\"nav-title has-icon search\" href=\"https://riversidestudios.co.uk/search/\"><span>Search</span></a>\r\n            </div>\r\n          </nav>\r\n          <nav class=\"shop-nav container mobile-only-break-1024\">\r\n                        <div class=\"member-nav\" data-url=\"https://spektrix.riversidestudios.co.uk/riversidestudios/api/v3/customer?$expand=subscriptions\" class=\"nav-item\"></div>\r\n                        <div class=\"nav-item\">\r\n            \t<a draggable=\"false\"  class=\"nav-title has-icon basket basket-trigger\" href=\"https://riversidestudios.co.uk/basket/\"><span>Basket</span> </a>\r\n            </div>\r\n            <div class=\"nav-item acc\">\r\n\r\n              <div class=\"acs-button\" aria-label = \"Open Accessibility menu\">\r\n                <span>Accessibility</span>\r\n              </div>\r\n            </div>\r\n\r\n          </nav>\r\n\r\n        </div>\r\n      </div>\r\n    </div>\r\n</header>\n  <div class=\"video-modals\"></div>\n  <div class=\"side-logo riverside-logo\"><span></span></div>\n  <div class=\"side-logo studios-logo\"><span></span></div>\n\n  <div class=\"membership-container\"></div>\n    <div class=\"overlay\"></div>\n    <div class=\"overlay-login\"></div>\n    <main class=\"outer-container\"  id=\"main-content\"  >\n      <div class=\"filter-overlay\"></div>\n          \r\n\r\n\r\n\r\n\r\n\r\n<div class=\"page page-event\">\r\n  <section class=\"template template-event-detail play-container has-modal  has-text-bottom      \">\r\n\r\n\r\n  \r\n\r\n\r\n    <div class=\"template-top header-padding header-switch\">\r\n                <div class=\"image-container \">\r\n                                <picture>\r\n                    <source sizes=\"100vw\" type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/d4/65ee7fdbaa5e7e789696a5bd784570/w880/q80/wpojpg/images/uploads/d465ee7fdbaa5e7e789696a5bd784570.webp 880w,https://riversidestudios.co.uk/images/custom/d4/65ee7fdbaa5e7e789696a5bd784570/w1210/q80/wpojpg/images/uploads/d465ee7fdbaa5e7e789696a5bd784570.webp 1210w,https://riversidestudios.co.uk/images/custom/d4/65ee7fdbaa5e7e789696a5bd784570/w1470/q80/wpojpg/images/uploads/d465ee7fdbaa5e7e789696a5bd784570.webp 1470w,https://riversidestudios.co.uk/images/custom/d4/65ee7fdbaa5e7e789696a5bd784570/w1680/q80/wpojpg/images/uploads/d465ee7fdbaa5e7e789696a5bd784570.webp 1680w,https://riversidestudios.co.uk/images/custom/d4/65ee7fdbaa5e7e789696a5bd784570/w1870/q80/wpojpg/images/uploads/d465ee7fdbaa5e7e789696a5bd784570.webp 1870w,https://riversidestudios.co.uk/images/custom/d4/65ee7fdbaa5e7e789696a5bd784570/w2048/q80/wpojpg/images/uploads/d465ee7fdbaa5e7e789696a5bd784570.webp 2048w,https://riversidestudios.co.uk/images/custom/d4/65ee7fdbaa5e7e789696a5bd784570/w2157/q80/wpojpg/images/uploads/d465ee7fdbaa5e7e789696a5bd784570.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position:  50%  50% \" src=\"https://riversidestudios.co.uk/images/custom/d4/65ee7fdbaa5e7e789696a5bd784570/w880/q80/images/uploads/d465ee7fdbaa5e7e789696a5bd784570.jpg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/d465ee7fdbaa5e7e789696a5bd784570.jpg&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;2157&quot;,&quot;height&quot;:&quot;1330&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/d4/65ee7fdbaa5e7e789696a5bd784570/w880/q80/images/uploads/d465ee7fdbaa5e7e789696a5bd784570.jpg 880w,https://riversidestudios.co.uk/images/custom/d4/65ee7fdbaa5e7e789696a5bd784570/w1210/q80/images/uploads/d465ee7fdbaa5e7e789696a5bd784570.jpg 1210w,https://riversidestudios.co.uk/images/custom/d4/65ee7fdbaa5e7e789696a5bd784570/w1470/q80/images/uploads/d465ee7fdbaa5e7e789696a5bd784570.jpg 1470w,https://riversidestudios.co.uk/images/custom/d4/65ee7fdbaa5e7e789696a5bd784570/w1680/q80/images/uploads/d465ee7fdbaa5e7e789696a5bd784570.jpg 1680w,https://riversidestudios.co.uk/images/custom/d4/65ee7fdbaa5e7e789696a5bd784570/w1870/q80/images/uploads/d465ee7fdbaa5e7e789696a5bd784570.jpg 1870w,https://riversidestudios.co.uk/images/custom/d4/65ee7fdbaa5e7e789696a5bd784570/w2048/q80/images/uploads/d465ee7fdbaa5e7e789696a5bd784570.jpg 2048w,https://riversidestudios.co.uk/images/custom/d4/65ee7fdbaa5e7e789696a5bd784570/w2157/q80/images/uploads/d465ee7fdbaa5e7e789696a5bd784570.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Amore: Jazz & World Music Night</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Sun 21 Dec 2025 - Sat 27 Jun 2026</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"YjlIN2pvSHdvNHNoOFR4VEthT0IxQT09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <p><strong>An always-eclectic line-up of jazz, funk and soul bands, singer-songwriters, poets and spoken word artists.</strong></p><h2><strong>Sunday 21 December</strong></h2><h3>CHRISTMAS EXTRAVAGANZA BLEGGAE NIGHT!!!!!!!!!</h3><p>“ The Popular and hugely entertaining Riverside regular Tim Hain aka “the King of Bleggae” ( blues reggae ) joins forces with the dynamic songstress and Mick Fleetwood protege Tallulah Bardens for a Christmas extravaganza. They will each perform and support each other ‘s original songs and meaningful covers from ballads to blues and boogie. It will be an evening of serious fun.</p><p>&nbsp;</p><p><a href=\"https://www.youtube.com/watch?v=J_txt8ZymhQ\" target=\"_blank\" rel=\"noopener noreferrer\"><strong>https://www.youtube.com/watch?v=J_txt8ZymhQ</strong></a></p><p>&nbsp;</p><p><strong>With Tim Hain</strong></p><p>“Timeless”&nbsp; Tim&nbsp; Hain is one of the UK’s finest “old school” blues guitarists, but he can’t&nbsp; resist a bit of reggae. He is also a&nbsp; compelling communicator and singer-songwriter. He has been called “The Van Morrison of Blues-Reggae” by legendary producer Chris KIMSEY&nbsp; who mixed Tim’s latest album “Tales Of Timeless Tim” and produced both the Rolling Stones and reggae icons Peter Tosh and&nbsp; Jimmy Cliff.</p><p>Tim has performed at Riverside several times, always to a rousing reception. With powerhouse Chris Belshaw on Bass, and Tansay Omar ( Bjork, Boy George, Stereo MCs) on drums, this will be a stripped down, up-front&nbsp; performance; “back to the roots”,&nbsp; as Tim puts it, but all the more powerful for it.</p><p>His single “Sister Rosetta “ was voted “record of the week” on New Dawn Radio’s “Jukebox Judgment” by top industry pros, , and made Mile Read’s Heritage Chart..</p><p>Tim has played with the best on both sides of the Atlantic, touring and recording with reggae greats Tyrone Taylor, Winston Reedy, and Carroll Thompson, performing with Zakiya ( daughter of John Lee) Hooker and&nbsp; even&nbsp; jammed with Jeff Beck. He honed his craft fronting&nbsp; 2000 gigs since the turn of the century and is a natural performer, mixing songs and rhythms with which&nbsp; you will be familiar, with his own stellar tunes</p><p>&nbsp;</p><p><strong>Tallulah Bardens</strong></p><p>Known for her raw, electrifying energy across genres, from early blues to minimal techno, Tallulah Bardens’s style brings soulful storytelling to every stage she graces. With recent releases including Armada and Tomorrowland, her current writing and performance collaborations include jazz-house project with Chicago house legend Joe Smooth, trip-hop projects with her music collective Porcelain, and a starring contribution on official Fleetwood Mac tribute album Legacy, alongside Elton John and The Corrs among others.&nbsp;&nbsp;Tallulah continues to push creative boundaries through live blues collaborations with Tim Hain and new songwriting with Mick Fleetwood.</p><p><strong>Support Act</strong></p><p><strong>Solur Jazz/Worldmusic Band Trio</strong>:with Peter Garvey(PHD Composer/Pianist),Henry Knudsen(Alto Sax) &amp; Hide Takemoto(Guitar, UK Ambassador for Yamaha Music Corporation 2024 )</p><p>&nbsp;World Music, Jazz, Latin Jazz&nbsp; Solur Jazz Band presents a wide flavour of eclectic styles, showcasing the wide proliferation of Jazz and World Music.</p></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">150 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n        \n<section class=\"block block-masonry-grid\">\n  <div class=\"masonry-overlay\">\n    <div class=\"container\">\n      <div class=\"overlay-inner\">\n        <div class=\"swiper-container\">\n          <div class=\"swiper-wrapper\">\n            <div class=\"grid-item swiper-slide size-default\">\n    <div class=\"grid-item-inner\" >\n        <div class=\"slot-content\">\n                      <div class=\" image-container image-default\">\n                <picture>\n            <source type=\"image/webp\" srcset=\"https://riversidestudios.co.uk/images/custom/c3/d0ee5423a3062bc026b3142e56c092/w800/q80/wpojpg/images/uploads/c3d0ee5423a3062bc026b3142e56c092.webp 800w,https://riversidestudios.co.uk/images/custom/c3/d0ee5423a3062bc026b3142e56c092/w1000/q80/wpojpg/images/uploads/c3d0ee5423a3062bc026b3142e56c092.webp 1000w,https://riversidestudios.co.uk/images/custom/c3/d0ee5423a3062bc026b3142e56c092/w1200/q80/wpojpg/images/uploads/c3d0ee5423a3062bc026b3142e56c092.webp 1200w,https://riversidestudios.co.uk/images/custom