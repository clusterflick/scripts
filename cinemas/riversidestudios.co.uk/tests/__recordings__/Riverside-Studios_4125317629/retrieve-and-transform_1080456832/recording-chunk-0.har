dabe1/w880/q80/wpojpg/images/uploads/91f43a08c9f878dfef20e604092dabe1.webp 880w,https://riversidestudios.co.uk/images/custom/91/f43a08c9f878dfef20e604092dabe1/w1210/q80/wpojpg/images/uploads/91f43a08c9f878dfef20e604092dabe1.webp 1210w,https://riversidestudios.co.uk/images/custom/91/f43a08c9f878dfef20e604092dabe1/w1470/q80/wpojpg/images/uploads/91f43a08c9f878dfef20e604092dabe1.webp 1470w,https://riversidestudios.co.uk/images/custom/91/f43a08c9f878dfef20e604092dabe1/w1680/q80/wpojpg/images/uploads/91f43a08c9f878dfef20e604092dabe1.webp 1680w,https://riversidestudios.co.uk/images/custom/91/f43a08c9f878dfef20e604092dabe1/w1870/q80/wpojpg/images/uploads/91f43a08c9f878dfef20e604092dabe1.webp 1870w,https://riversidestudios.co.uk/images/custom/91/f43a08c9f878dfef20e604092dabe1/w2048/q80/wpojpg/images/uploads/91f43a08c9f878dfef20e604092dabe1.webp 2048w,https://riversidestudios.co.uk/images/custom/91/f43a08c9f878dfef20e604092dabe1/w2667/q80/wpojpg/images/uploads/91f43a08c9f878dfef20e604092dabe1.webp 2880w\">\r\n                                <img fetchpriority=\"high\" sizes=\"100vw\"  style=\"object-position: 46.6% 14.8% \" src=\"https://riversidestudios.co.uk/images/custom/91/f43a08c9f878dfef20e604092dabe1/w880/q80/images/uploads/91f43a08c9f878dfef20e604092dabe1.jpg\"  data-custom=\"{&quot;img_src&quot;:&quot;images\\/uploads\\/91f43a08c9f878dfef20e604092dabe1.jpg&quot;,&quot;fx&quot;:&quot;46.6&quot;,&quot;fy&quot;:&quot;14.8&quot;,&quot;original&quot;:{&quot;width&quot;:&quot;2667&quot;,&quot;height&quot;:&quot;1417&quot;,&quot;orientation&quot;:&quot;landscape&quot;}}\"  srcset=\"https://riversidestudios.co.uk/images/custom/91/f43a08c9f878dfef20e604092dabe1/w880/q80/images/uploads/91f43a08c9f878dfef20e604092dabe1.jpg 880w,https://riversidestudios.co.uk/images/custom/91/f43a08c9f878dfef20e604092dabe1/w1210/q80/images/uploads/91f43a08c9f878dfef20e604092dabe1.jpg 1210w,https://riversidestudios.co.uk/images/custom/91/f43a08c9f878dfef20e604092dabe1/w1470/q80/images/uploads/91f43a08c9f878dfef20e604092dabe1.jpg 1470w,https://riversidestudios.co.uk/images/custom/91/f43a08c9f878dfef20e604092dabe1/w1680/q80/images/uploads/91f43a08c9f878dfef20e604092dabe1.jpg 1680w,https://riversidestudios.co.uk/images/custom/91/f43a08c9f878dfef20e604092dabe1/w1870/q80/images/uploads/91f43a08c9f878dfef20e604092dabe1.jpg 1870w,https://riversidestudios.co.uk/images/custom/91/f43a08c9f878dfef20e604092dabe1/w2048/q80/images/uploads/91f43a08c9f878dfef20e604092dabe1.jpg 2048w,https://riversidestudios.co.uk/images/custom/91/f43a08c9f878dfef20e604092dabe1/w2667/q80/images/uploads/91f43a08c9f878dfef20e604092dabe1.jpg 2880w\" alt=\"\">\r\n                                </picture>\r\n                \r\n                            </div>\r\n            <div class=\"template-content-outer\">\r\n\r\n          <div class=\"template-content\">\r\n            <div class=\"container \">\r\n\r\n              <div class=\"template-content-inner \">\r\n\r\n                                                        <div class=\"template-title-top\">\r\n                    <h1 class=\"template-title font-title font-xlarge font-uppercase \">\r\n                       <span>Old Fat F**k Up</span>\r\n              \r\n                     </h1>\r\n                                            <div class=\"template-tag\"></div>\r\n                    </div>\r\n\r\n                                    \r\n                  <div class=\"template-content-top\">\r\n                     <div class=\"template-date performance-date-range  font-uppercase font-tag font-title\"><span>Wed 10 - Wed 17 Dec 2025</span></div>\r\n\r\n                  </div>\r\n                                    \r\n               \r\n\r\n           <div class=\"booking-info\">\r\n        <div class=\"container\">\r\n          <div class=\"booking-info-inner\">\r\n            <div class=\"cta-bar \" id=\"event-info\" data-hash=\"ckUrMno4ejFFdXNMamJJY3F5Mjh3UT09\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n      <div class=\"template-bottom\">\r\n        <div class=\"container\">\r\n          <div class=\"template-bottom-inner \">\r\n            <div class=\"template-left   \">\r\n\r\n                          <div class=\"te\">\r\n    <blockquote><p>★★★★ <i>Phenomenal. Devastating. Unexpectedly hilarious. - </i>All That Dazzles</p><p>★★★★ <i>Completely mesmerising, deeply complex, so powerful it’s impossible to look away - </i>Everything Theatre</p><p>★★★★ <i>Old Fat F**k Up is the golden ticket, a theatrical gem - </i>North West End</p><p>★★★★ <i>Laced with humour. Beautiful, raw and deeply human - </i>A Young(ish) Perspective</p></blockquote><p><strong>EVERYTHING IS GOING TO BE OKAY* &nbsp;</strong></p><p><i><strong>Old Fat F**k Up</strong></i> is a show about seeing your naked body in the mirror and crying, discovering your career’s uncontrollably disintegrating, and realising that suddenly everything costs a bomb. Oh, and now you’ve got kids too, so there’s that. Hilarious, right?</p><p>Following last year's ★★★★★ hilarious and terrifying hit, F**king Legend (Pleasance, Edinburgh; Riverside Studios, London), Olly (and his fairly punchable face) returns with a show that rips into the absurdity of modern life, peels back the layers of middle-aged denial and the pain of parenthood, then exposes the wreckage men leave behind when they’re just trying not to break things.</p><p><strong>*but may not be. In fact, let’s be honest, it probably won’t be.&nbsp;</strong></p><p>See <a href=\"https://old.riversidestudios.co.uk/see-and-do/fking-legend-202323/\"><i>F**king Legend</i></a> alongside Olly’s new show <a href=\"https://old.riversidestudios.co.uk/see-and-do/old-fat-fk-up-202325/\"><i>Old Fat F**k Up</i></a> and get <strong>20% off</strong> full-price tickets when booked together in the same transaction. <i>(Offer applies to full-price tickets only; performances do not need to be on the same day.)</i></p><blockquote><p>‘Olly Hawes is a magnificent writer’ WhatsOnStage</p><p>‘An entirely innovative and distinctive voice in contemporary theatre’ Adventures in Theatreland</p><p>‘A magnificent storyteller’ British Theatre Guide</p></blockquote><p>&nbsp;</p><p><strong>Olly </strong>makes shows that explore the tension between the desires of individuals and the stability of collectives. He is co-artistic director of take stock exchange - their latest series of podcasts, <strong>Machloket</strong>, made with the Royal Court, is available now. He’s worked with some of the country’s most prestigious and exciting venues, including the National Theatre, The Young Vic and The Barbican.&nbsp;</p><p><strong>P Burton-Morgan </strong>has been Artistic Director of Metta Theatre since 2005 for which they have written/directed over 30 productions including Sherlock Holmes and the PoisonWood (Watermill) and the WGGB award-winning In the Willows (UK tour). Their debut novel Muddying is currently out on submission with United Agents and they're also a Ledbury Festival slam-winning poet.</p><p>&nbsp;</p><p><strong>Praise for F**king Legend</strong></p><blockquote><p>TOP 10 SHOW Ed Fringe 2024 &nbsp;‘Extraordinary. I can’t recommend it enough’ Fergus Morgan, The Crush Bar&nbsp;</p><p>★★★★ ‘Terrifically smart and discomforting… exhilarating’ The Scotsman&nbsp;</p><p>★★★★★ ‘A Marvel to Behold’ All That Dazzles&nbsp;</p><p>★★★★ ‘Perfectly eccentric, complex, emotional,’ Adventures in Theatreland&nbsp;</p><p>★★★★ ‘Completely and utterly gripping’ What’s Good To Do&nbsp;</p></blockquote></div>            \r\n\r\n            \r\n\r\n         </div>\r\n\r\n           <aside class=\"template-right\">\r\n               <div class=\"event-details\">\r\n                \r\n                  <div class=\"event-detail-section event-info\">\r\n                      <div class=\"rating-info font-tag font-uppercase font-title font-blue \">Duration:  </div>\r\n                      <span class=\"event-info-text age-rating text\">70 minutes</span>\r\n                    </div>                  \r\n                    \r\n                  \r\n                  \r\n                                  <div id=\"event-performances\" class=\"performance_details\"></div>\r\n\r\n        \r\n               </div>\r\n\r\n           </aside>\r\n       \r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n      </section>\r\n\r\n\r\n    \r\n</div>\r\n  </main>\n\r\n<footer class=\"footer\">\r\n\r\n  <div class=\"container-wide desktop-only-break-1024\">\r\n    <div class=\"footer-inner\">\r\n\r\n\r\n      <div class=\"footer-navs\">\r\n\r\n\r\n                  <div class=\"footer-section\">\r\n\r\n                            <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">See Also</h5>\r\n                            <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/newsletter-signup/\">Newsletter signup</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/vacancies/\">Vacancies</a>\r\n                          <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/policies/\">Policies</a>\r\n                        <div id=\"member-login\"></div>\r\n          </div>\r\n\r\n        \r\n                  <div class=\"footer-section\">\r\n\r\n            <div class=\"footer-nav-top\">\r\n                                <h5 class=\"footer-nav-title font-xxsmall font-title font-uppercase font-white\">Our Website</h5>\r\n                                <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/privacy-and-cookies/\">Privacy and Cookies</a>\r\n                              <a class=\"footer-nav-item font-text font-white\" href=\"https://riversidestudios.co.uk/websit