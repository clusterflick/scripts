            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014890\",\"name\":\"Lenin (Telugu)\",\"originalName\":\"Lenin (Telugu)\",\"length\":150,\"posterLink\":\"https://regalcdn.azureedge.net/CW/LeninTelugu/HO00014890/TV_SmallPosterImage/20260707-122559757.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/LeninTelugu/HO00014890/TV_LargePosterImage/20260707-122559757.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/lenin-telugu/ho00014890\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Akhil Akkineni, Bhagyashri Borse\",\"directors\":\"Murali Kishor Abburu\",\"synopsis\":\"Lenin is an upcoming Telugu romantic action drama starring Akhil Akkineni and Bhagyashree Borse, directed by Murali Kishore Abburu. Set against a rural backdrop, the film blends romance, action, and emotional drama while addressing socially relevant themes such as honor killings.\",\"dateStarted\":\"2026-07-10T00:00:00\",\"eventCount\":68,\"categoriesAttributes\":[\"action\",\"drama\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"laser\",\"reserved-selected\",\"subbed\",\"telugu\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/18.png\",\"ageRestrictionName\":\"18\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/LeninTelugu/HO00014890/TV_TopShelfPosterImage/20260707-122559757.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/LeninTelugu/HO00014890/TV_SmallPosterImage/20260707-122559757.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"ur