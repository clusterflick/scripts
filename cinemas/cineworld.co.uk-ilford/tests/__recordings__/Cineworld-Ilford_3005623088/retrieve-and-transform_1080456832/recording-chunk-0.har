          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014818\",\"name\":\"Alpha (Hindi)\",\"originalName\":\"Alpha (Hindi)\",\"length\":141,\"posterLink\":\"https://regalcdn.azureedge.net/CW/AlphaHindi/HO00014818/TV_SmallPosterImage/20260622-110441677.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/AlphaHindi/HO00014818/TV_LargePosterImage/20260622-110441677.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/alpha-hindi/ho00014818\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Bobby Deol, Anil Kapoor, Alia Bhatt, Sharvari\",\"directors\":\"Shiv Rawail\",\"synopsis\":\"Welcome to the newest chapter of the YRF Spy Universe that presents an edgy origin story of a girl raised and built to kill. Alpha is a female-led action film that will take you on a fun, edge of the seat, thrilling ride that is designed as an out and out entertainer. \\n\\nYash Raj Films presents Alpha, starring Alia Bhatt, Sharvari, Anil Kapoor, and Bobby Deol. Produced by Aditya Chopra and directed by Shiv Rawail, acclaimed for the globally celebrated series The Railway Men, Alpha is set to release in theatres worldwide on July 3, 2026.\",\"dateStarted\":\"2026-07-03T00:00:00\",\"eventCount\":94,\"categoriesAttributes\":[\"action\",\"adventure\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"hindi\",\"laser\",\"reserved-selected\",\"subbed\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/15.png\",\"ageRestrictionName\":\"15\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/AlphaHindi/HO00014818/TV_TopShelfPosterImage/20260622-110441677.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/AlphaHindi/HO00014818/TV_SmallPosterImage/20260622-110441677.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/AlphaHindi/HO00014818/Mobile_MovieThumbnail/20260622-110441677.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/AlphaHindi/HO00014818/TV_LargePosterImage/20260622-110441677.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/AlphaHindi/HO00014818/Mobile_MovieFeed/20260622-110524684.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"YASH RAJ FILMS\"}}}",
