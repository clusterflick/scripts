          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014112\",\"name\":\"The Odyssey (2026)\",\"originalName\":\"The Odyssey (2026)\",\"length\":173,\"posterLink\":\"https://regalcdn.azureedge.net/CW/TheOdyssey2026/HO00014112/TV_SmallPosterImage/20260610-044529391.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/TheOdyssey2026/HO00014112/TV_LargePosterImage/20260610-044446831.jpg\",\"videoLink\":\"https://youtu.be/Mzw2ttJD2qQ\",\"link\":\"https://www.cineworld.co.uk/films/the-odyssey-2026/ho00014112\",\"weight\":-16,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Matt Damon, Anne Hathaway, Tom Holland, Robert Pattinson, Charlize Theron, Lupita Nyong'o, Zendaya\",\"directors\":\"Christopher Nolan\",\"synopsis\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. The film brings Homer’s foundational saga to IMAX® film screens for the first time and opens in cinemas everywhere on July 16, 2026. \\n\\nThe Odyssey stars Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson and Lupita Nyong’o, with Zendaya and Charlize Theron.\\n\\nThe Odyssey is produced by Emma Thomas and Christopher Nolan for their company, Syncopy. The executive producer is Thomas Hayslip.\",\"dateStarted\":\"2026-07-17T00:00:00\",\"eventCount\":8041,\"categoriesAttributes\":[\"action\",\"drama\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"4dx\",\"audio-described\",\"imax\",\"laser\",\"recliner\",\"reserved-selected\",\"subbed\",\"superscreen\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/15.png\",\"ageRestrictionName\":\"15\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Video\",\"subType\":\"Trailer_Youtube\",\"url\":\"https://youtu.be/Mzw2ttJD2qQ\",\"d