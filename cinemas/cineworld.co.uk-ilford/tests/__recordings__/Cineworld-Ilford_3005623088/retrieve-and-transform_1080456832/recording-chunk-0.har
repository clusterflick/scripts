          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014829\",\"name\":\"Paw Patrol Dino Movie Preview in aid of MediCinema\",\"originalName\":\"Paw Patrol Dino Movie Preview in aid of MediCinema\",\"length\":90,\"posterLink\":\"/xmedia/img/10108/film.placeholder.poster.jpg\",\"posterLinkLarge\":\"/xmedia/img/10108/film.placeholder.poster.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/paw-patrol-dino-movie-preview-in-aid-of-medicinema/ho00014829\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Terry Crews, Paris Hilton, Jennifer Hudson, Snoop Dogg, Jameela Jamil, Fortune Feimster, Ron Pardo, Nylan Parthipan, McKenna Grace, Carter Young, Meredith MacNeill, Hayden Chemberlen, Rain Janjua, Bill Nye, Lucien Duncan-Reid, William Desrosiers, Henry Bolan\",\"directors\":\"Cal Brunker\",\"synopsis\":\"After their ship gets caught in a mysterious storm, the PAW Patrol pups crash land on an uncharted tropical island filled with dinosaurs. They meet Rex, a pup who has been stranded on the island for years and has become an expert in all things dino-related. When the PAW Patrol's archrival, Mayor Humdinger, begins recklessly mining in hopes of exploiting the island for its natural resources, he inadvertently causes a huge, dormant volcano to erupt. The PAW Patrol pups are thrown into a series of high-stakes, dino-sized rescues bigger than anything they've done before, as they must stop Humdinger before everything on the island goes extinct.\",\"dateStarted\":\"2026-08-02T00:00:00\",\"eventCount\":85,\"categoriesAttributes\":[\"action\",\"animation\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"audio-described\",\"ch\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/U.png\",\"ageRestrictionName\":\"u\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[],\"specialMessage\":null,\"distributorName\":\"MEDICINEMA\"}}}",
