          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014533\",\"name\":\"Toy Story 5\",\"originalName\":\"Toy Story 5\",\"length\":102,\"posterLink\":\"https://regalcdn.azureedge.net/CW/ToyStory5/HO00014533/TV_SmallPosterImage/20260512-103731565.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/ToyStory5/HO00014533/TV_LargePosterImage/20260512-103609382.jpg\",\"videoLink\":\"https://youtu.be/UV7Ht-R3ICY\",\"link\":\"https://www.cineworld.co.uk/films/toy-story-5/ho00014533\",\"weight\":-15,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Tim Allen, Joan Cusack, Tom Hanks, Greta Lee, Tony Hale, Conan O'Brien\",\"directors\":\"Andrew Stanton, McKenna Harris\",\"synopsis\":\"The toys are back in Disney and Pixar’s “Toy Story 5,” and this time around it’s Toy meets Tech. Buzz, Woody, Jessie and the rest of the gang’s jobs get exponentially harder when they go head to head with this all-new threat to playtime.\",\"dateStarted\":\"2026-06-18T00:00:00\",\"eventCount\":5144,\"categoriesAttributes\":[\"action\",\"animation\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"3d\",\"4dx\",\"audio-described\",\"imax\",\"laser\",\"recliner\",\"reserved-selected\",\"sc\",\"subbed\",\"superscreen\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/PG.png\",\"ageRestrictionName\":\"pg\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/ToyStory5/HO00014533/TV_TopShelfPosterImage/20260512-103609382.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/ToyStory5/HO00014533/TV_SmallPosterImage/20260512-103731565.jpg\",\"dimensionHeight\":\"3