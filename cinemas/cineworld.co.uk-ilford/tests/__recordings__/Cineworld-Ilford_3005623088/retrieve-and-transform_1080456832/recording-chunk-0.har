          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014842\",\"name\":\"Sia: Nostalgic For The Present\",\"originalName\":\"Sia: Nostalgic For The Present\",\"length\":75,\"posterLink\":\"https://regalcdn.azureedge.net/CW/SiaNostalgicForThePresent/HO00014842/TV_SmallPosterImage/20260617-103554564.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/SiaNostalgicForThePresent/HO00014842/TV_LargePosterImage/20260617-103448391.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/sia-nostalgic-for-the-present/ho00014842\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Paul Dano, Ben Mendelsohn, Kristen Wiig, Gaby Hoffmann, Maddie Ziegler, Sia, Tig Notaro\",\"directors\":\"Sia, Daniel Askill\",\"synopsis\":\"One voice. One unforgettable spectacle.\\n\\nSia: Nostalgic for the Present - a bold, genre-defying experience that trades pop pageantry for pure artistry. Awe-inspiring vocals, breathtaking choreography, and iconic performances, captured cinematically and soundtracked by an unmatched catalog of hits.\\n\\nIn 2016, Sia toured the world mirroring this film live on stage, frame for frame. Remastered for its tenth anniversary, it stands alone for the first time - not as a concert film, but as a visual masterpiece unlike anything in music since.\\n\\nStarring Maddie Ziegler, Kristen Wiig, Paul Dano, Ben Mendelsohn, Gaby Hoffmann, and Tig Notaro. Choreographed by Ryan Heffington. Directed by Sia and Daniel Askill.\\n\\n\",\"dateStarted\":\"2026-07-23T00:00:00\",\"eventCount\":32,\"categoriesAttributes\":[],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"alternative-content\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/PG.png\",\"ageRestrictionName\":\"pg\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/SiaNostalgicForThePresent/HO00014842/TV_TopShelfPosterImage/20260617-103448391.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/SiaNostalgicForThePresent/HO00014842/TV_SmallPosterImage/20260617-103554564.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/SiaNostalgicForThePresent/HO00014842/Mobile_MovieThumbnail/20260617-103448391.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/SiaNostalgicForThePresent/HO00014842/TV_LargePosterImage/20260617-103448391.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/SiaNostalgicForThePresent/HO00014842/Mobile_MovieFeed/20260617-103526783.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"TRAFALGAR RELEASING\"}}}",
