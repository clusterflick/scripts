            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014730\",\"name\":\"Moana (Live Action) (2026)\",\"originalName\":\"Moana (Live Action) (2026)\",\"length\":115,\"posterLink\":\"https://regalcdn.azureedge.net/CW/Moana2026/HO00014730/TV_SmallPosterImage/20260520-051252060.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/Moana2026/HO00014730/TV_LargePosterImage/20260520-051225134.jpg\",\"videoLink\":\"https://youtu.be/r9l2gHVDnMQ\",\"link\":\"https://www.cineworld.co.uk/films/moana-live-action-2026/ho00014730\",\"weight\":-17,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Dwayne Johnson, Rena Owen, John Tui, Frankie Adams, Catherine Laga‘aia\",\"directors\":\"Thomas Kail\",\"synopsis\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyages beyond the reef of her island of Motunui with the infamous demigod Maui (Dwayne Johnson) on an unforgettable journey to restore prosperity to her people. The film is directed by Emmy® and Tony Award® winner Thomas Kail (“Hamilton”); produced by Dwayne Johnson, Dany Garcia, Beau Flynn, Hiram Garcia and Lin-Manuel Miranda; and executive produced by Thomas Kail, Scott Sheldon, Charles Newirth and Auliʻi Cravalho, who voiced Moana in the animated features “Moana” and “Moana 2.”\",\"dateStarted\":\"2026-07-10T00:00:00\",\"eventCount\":5356,\"categoriesAttributes\":[\"action\",\"comedy\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"3d\",\"4dx\",\"audio-described\",\"cinebabies\",\"imax\",\"laser\",\"recliner\",\"reserved-selected\",\"screenx\",\"subbed\",\"superscreen\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/PG.png\",\"ageRestrictionName\":\"pg\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/Moana2026/HO00014730/TV_TopShelfPosterImage/20260520-051225134.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/Moana2026/HO00014730/TV_SmallPosterImage/20260520-051252060.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/Moana2026/HO00014730/Mobile_MovieThumbnail/20260520-051225134.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/Moana2026/HO00014730/TV_LargePosterImage/20260520-051225134.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Video\",\"subType\":\"Trailer_Youtube\",\"url\":\"https://youtu.be/r9l2gHVDnMQ\",\"dimensionHeight\":null,\"dimensionWidth\":null},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/Moana2026/HO00014730/Mobile_MovieFeed/20260520-051518982.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"DISNEY\"}}}",
