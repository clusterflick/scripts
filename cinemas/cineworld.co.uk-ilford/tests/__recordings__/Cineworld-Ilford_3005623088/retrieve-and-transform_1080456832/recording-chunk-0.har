          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014869\",\"name\":\"Gatta Kusthi 2 (Tamil)\",\"originalName\":\"Gatta Kusthi 2 (Tamil)\",\"length\":155,\"posterLink\":\"https://regalcdn.azureedge.net/CW/GattaKusthi2Tamil/HO00014869/TV_SmallPosterImage/20260630-091301634.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/GattaKusthi2Tamil/HO00014869/TV_LargePosterImage/20260630-091301634.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/gatta-kusthi-2-tamil/ho00014869\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Vishnu Vishal\",\"directors\":\"\",\"synopsis\":\"Veera, a devoted husband and father, balances the demands of domestic life while passionately championing his wife Keerthy's wrestling career. But when societal pressures and unforeseen circumstances threaten to tear their family apart, Veera faces his toughest fight yet — one that has nothing to do with the ring, and everything to do with reclaiming the trust and love of those he holds most dear.\",\"dateStarted\":\"2026-07-03T00:00:00\",\"eventCount\":12,\"categoriesAttributes\":[\"comedy\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"reserved-selected\",\"subbed\",\"tamil\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/GattaKusthi2Tamil/HO00014869/TV_TopShelfPosterImage/20260630-091301634.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/GattaKusthi2Tamil/HO00014869/TV_SmallPosterImage/20260630-091301634.jpg\",\"dimens