          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014915\",\"name\":\"£2 Family Films : Early Man (2026 Re-Release)\",\"originalName\":\"£2 Family Films : Early Man (2026 Re-Release)\",\"length\":89,\"posterLink\":\"/xmedia/img/10108/film.placeholder.poster.jpg\",\"posterLinkLarge\":\"/xmedia/img/10108/film.placeholder.poster.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/2-family-films-early-man-2026-re-release/ho00014915\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Richard Ayoade, Tom Hiddleston, Eddie Redmayne, Timothy Spall, Richard Webber, Maisie Williams, Mark Williams, Selina Griffiths, Johnny Vegas, Gina Yashere, Simon Greenall\",\"directors\":\"Mark Burton, Richard Starzak\",\"synopsis\":\"Set at the dawn of time, when prehistoric creatures and woolly mammoths roamed the earth, EARLY MAN tells the story of how plucky caveman Dug, along with sidekick Hognob unites his tribe against the mighty Bronze Age in a battle to beat them at their own game. It also marks Nick Park’s first feature film since Academy Award® winning WALLACE AND GROMIT: THE CURSE OF THE WERE-RABBIT.  EARLY MAN unleashes an unforgettable cast of hilarious new characters.\",\"dateStarted\":\"2026-08-21T00:00:00\",\"eventCount\":561,\"categoriesAttributes\":[\"animation\",\"comedy\",\"movies-for-juniors\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"audio-described\",\"classicfilm\",\"laser\",\"movies-for-juniors\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/PG.png\",\"ageRestrictionName\":\"pg\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[],\"specialMessage\":null,\"distributorName\":\"PARK CIRCUS FILMS\"}}}",
