>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-11598\"><a href=\"https://www.stjohnsshirley.org.uk/st-johns-churchyard-trail-qr-c/\">St John’s Churchyard Trail – QR C</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-11597\"><a href=\"https://www.stjohnsshirley.org.uk/st-johns-churchyard-trail-qr-d/\">St John’s Churchyard Trail – QR D</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-11713\"><a href=\"https://www.stjohnsshirley.org.uk/st-johns-churchyard-trail-qr-e/\">St John’s Churchyard Trail – QR E</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-11714\"><a href=\"https://www.stjohnsshirley.org.uk/st-johns-churchyard-trail-qr-f/\">St John’s Churchyard Trail – QR F</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-11715\"><a href=\"https://www.stjohnsshirley.org.uk/st-johns-churchyard-trail-qr-g/\">St John’s Churchyard Trail – QR G</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-11716\"><a href=\"https://www.stjohnsshirley.org.uk/st-johns-churchyard-trail-qr-h/\">St John’s Churchyard Trail – QR H</a></li>\n</ul>\n</li>\n</ul></div><div class=\"menu-bar-items\"><span class=\"menu-bar-item search-item\"><a aria-label=\"Open Search Bar\" href=\"#\"></a></span></div>\t\t\t</div>\n\t\t</nav>\n\t\t\n\t<div class=\"site grid-container container hfeed\" id=\"page\">\n\t\t\t\t<div class=\"site-content\" id=\"content\">\n\t\t\t\n\t<div class=\"content-area\" id=\"primary\">\n\t\t<main class=\"site-main\" id=\"main\">\n\t\t\t\n<article id=\"post-53736\" class=\"post-53736 page type-page status-publish has-post-thumbnail infinite-scroll-item\" itemtype=\"https://schema.org/CreativeWork\" itemscope>\n\t<div class=\"inside-article\">\n\t\t\n\t\t\t<header class=\"entry-header\">\n\t\t\t\t<h1 class=\"entry-title\" itemprop=\"headline\">Love Actually</h1>\t\t\t</header>\n\n\t\t\t\n\t\t<div class=\"entry-content\" itemprop=\"text\">\n\t\t\t\n<p class=\"wp-block-paragraph\"></p>\n\n\n\n<h3 id=\"get-your-tickets\" class=\"wp-block-heading\">Get your tickets </h3>\n\n\n\n<h2 id=\"saturday-18th-december\" class=\"wp-block-heading\">Saturday 12th December @ 7:30pm</h2>\n\n\n\n<div class=\"wp-block-media-text is-stacked-on-mobile alignwide\"><figure class=\"wp-block-media-text__media\"><img fetchpriority=\"high\" decoding=\"async\" width=\"1364\" height=\"1024\" data-attachment-id=\"53737\" data-permalink=\"https://www.stjohnsshirley.org.uk/love-actually/love-actually/#main\" data-orig-file=\"https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/Love-Actually.jpeg\" data-orig-size=\"2560,1922\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;1.78&quot;,&quot;camera&quot;:&quot;iPhone 15 Pro Max&quot;,&quot;created_timestamp&quot;:&quot;1705244013&quot;,&quot;focal_length&quot;:&quot;6.86&quot;,&quot;iso&quot;:&quot;320&quot;,&quot;shutter_speed&quot;:&quot;0.016666666666667&quot;,&quot;orientation&quot;:&quot;1&quot;}\" data-image-title=\"Love Actually\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/Love-Actually-1364x1024.jpeg\" src=\"https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/Love-Actually-1364x1024.jpeg\" alt=\"\" class=\"wp-image-53737 size-full\" srcset=\"https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/Love-Actually-1364x1024.jpeg 1364w, https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/Love-Actually-150x113.jpeg 150w, https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/Love-Actually-300x225.jpeg 300w, https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/Love-Actually-767x576.jpeg 767w, https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/Love-Actually-1536x1153.jpeg 1536w, https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/Love-Actually-2048x1538.jpeg 2048w, https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/Love-Actually-267x200.jpeg 267w\" sizes=\"(max-width: 1364px) 100vw, 1364px\" /></figure><div class=\"wp-block-media-text__content\">\r\n\t\t\t<div class='mt-order my-tickets' id='mt-response-53736-calendar-month'>\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<form action='https://www.stjohnsshirley.org.uk/love-actually/' method='POST' class='ticket-orders' id='order-tickets-calendar-month'>\r\n\t\t\t\t\t<div>\r\n\t\t\t\t\t\t<input type=\"hidden\" id=\"_wpnonce\" name=\"_wpnonce\" value=\"784bc66420\" /><input type=\"hidden\" name=\"_wp_http_referer\" value=\"/love-actually/\" />\r\n\t\t\t\t\t\t<input type='hidden' name='mt_event_id' value='53736' />\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<fieldset>\r\n\t\t\t\t\t<legend>Buy Tickets</legend>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<p class=\"tickets-remaining\"><span class='value'>148</span> tickets remaining.</p>\r\n\t\t\t\t\t\t<div class='mt-ticket-field mt-ticket-adult mt-available '><label for='mt_tickets_adult_53736' id='mt_tickets_label_adult_53736'>Adult</label><div class=\"mt-ticket-input\"><input type='number' name='mt_tickets[adult]'  min='0' max='148' id='mt_tickets_adult_53736' class='tickets_field' value='0' aria-labelledby='mt_tickets_label_adult_53736 mt_tickets_data_adult' /><button type=\"button\" class=\"mt-increment\"><span class=\"dashicons dashicons-plus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Add one</span></button><button type=\"button\" class=\"mt-decrement\"><span class=\"dashicons dashicons-minus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Remove one</span></button></div><span class='mt-ticket-data-price' id='mt_tickets_data_adult'><span class=\"mt-ticket-price\">£<span class=\"price\">5.00</span></span></span><span class='mt-error-notice' aria-live='assertive'></span></div><div class='mt-ticket-field mt-ticket-child mt-available '><label for='mt_tickets_child_53736' id='mt_tickets_label_child_53736'>Child</label><div class=\"mt-ticket-input\"><input type='number' name='mt_tickets[child]'  min='0' max='148' id='mt_tickets_child_53736' class='tickets_field' value='0' aria-labelledby='mt_tickets_label_child_53736 mt_tickets_data_child' /><button type=\"button\" class=\"mt-increment\"><span class=\"dashicons dashicons-plus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Add one</span></button><button type=\"button\" class=\"mt-decrement\"><span class=\"dashicons dashicons-minus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Remove one</span></button></div><span class='mt-ticket-data-price' id='mt_tickets_data_child'><span class=\"mt-ticket-price\">£<span class=\"price\">5.00</span></span></span><span class='mt-error-notice' aria-live='assertive'></span></div><div class='mt-ticket-field mt-ticket-reserve-and-pay-on-the-door mt-available '><label for='mt_tickets_reserve-and-pay-on-the-door_53736' id='mt_tickets_label_reserve-and-pay-on-the-door_53736'>Reserve and pay on the door</label><div class=\"mt-ticket-input\"><input type='number' name='mt_tickets[reserve-and-pay-on-the-door]'  min='0' max='148' id='mt_tickets_reserve-and-pay-on-the-door_53736' class='tickets_field' value='0' aria-labelledby='mt_tickets_label_reserve-and-pay-on-the-door_53736 mt_tickets_data_reserve-and-pay-on-the-door' /><button type=\"button\" class=\"mt-increment\"><span class=\"dashicons dashicons-plus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Add one</span></button><button type=\"button\" class=\"mt-decrement\"><span class=\"dashicons dashicons-minus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Remove one</span></button></div><span class='mt-ticket-data-price' id='mt_tickets_data_reserve-and-pay-on-the-door'><span class=\"mt-ticket-price\">£<span class=\"price\">0.00</span></span></span><span class='mt-error-notice' aria-live='assertive'></span></div>\r\n\t\t\t\t\t\t<div class='mt-response-container'>\r\n\t\t\t\t\t\t\t<p>\r\n\t\t\t\t\t\t\t\t<button type='submit' name='mt_add_to_cart'>Add to Cart<span class='mt-processing'><img src='https://www.stjohnsshirley.org.uk/wp-admin/images/spinner-2x.gif' alt='Working' /></span></button>\r\n\t\t\t\t\t\t\t</p>\r\n\t\t\t\t\t\t\t<div class='mt-response' aria-live='assertive'></div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<input type='hidden' name='my-tickets' value='true' />\r\n\t\t\t\t\t</fieldset>\r\n\t\t\t\t</form>\r\n\t\t\t</div>\n</div></div>\n\n\n\n<p class=\"wp-block-paragraph\">Set one month before Christmas, we follow the lives of several people falling in or out of love. <a href=\"https://www.imdb.com/title/tt0314331/?ref_=tt_urv\"><strong>“Love Actually”</strong></a> is a great movie with several well developed story lines that all come together nicely and a terrific cast that can be both comedic and dramatic. It certainly wasn’t an easy film to make and I’m sure the studio must have considered it a huge risk, telling stories from several characters in the space of two hours, with all of them having little to no connection with the others, but it worked, <a href=\"https://www.imdb.com/name/nm0193485/?ref_=ttfc_fc_dr1\">Richard Curtis</a> clearly put hard work in to this script and gathered a very impressive cast to make it a hit. Of course, with the amount of stories there are, some of them felt underdeveloped, I found <a href=\"https://www.imdb.com/name/nm0000614/?ref_=ttfc_fc_cl_t40\">Alan Rickman</a> and <a href=\"https://www.imdb.com/name/nm0000668/?ref_=ttfc_fc_cl_t7\">Emma Thompson</a>‘s to be one of the most compelling, but in the great their story dosen’t get any proper closure, <a href=\"https://www.imdb.com/name/nm0000147/?ref_=ttfc_fc_cl_t4\">Colin Firth</a>‘s story felt very tight, I would like to have seen more of him with <a href=\"https://www.imdb.com/name/nm0347149/?ref_=ttfc_fc_cl_t5\">Sienna Guillory</a>, but with a film as crowded as this you are going to feel underwhelmed with certain parts. The films cast really is terrific and is the main reason why a story as complicated and messy as this really works, <a href=\"https://www.imdb.com/name/nm0000553/?ref_=ttfc_fc_cl_t6\">Liam Neeson</a> shines as a step dad hoping to cheer up the son of his deceased wife, Emma Thompson is delightful as a wife questioning her own decisions, Alan Rickman astounds as a confused husband, <a href=\"https://www.imdb.com/name/nm0000424/?ref_=ttfc_fc_cl_t16\">Hugh Grant</a> is terrific as a prime minister who discovers love for the first time, every actor puts all their heart in to these roles and they are all a delight to watch. However, the best performance for me would have to be <a href=\"https://www.imdb.com/name/nm0631490/?ref_=ttfc_fc_cl_t1\">Bill Nighy</a>, who shines in every scene as Billy Mack, playing a character in no way similar to any role he has done previously, he plays a straight up pompous musician, and he does it ridiculously well. Always a fun film to watch at Christmas time, <strong>Love Actually</strong> is funny, emotional and very sweet, I would recommend it to anyone looking for a good comedy or <a href=\"https://www.vintagemovieposters.co.uk/product-category/romance/\">romance</a> film.</p>\n\n\n\n<div style=\"height:27px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n\n\n<p class=\"wp-block-paragraph\">On the 12th December 2026 @ 7:30pm we will be screening <strong>Love Actually</strong></p>\n\n\n\n<p class=\"wp-block-paragraph\">Doors open 7pm for at 7:30pm start.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Bring your own cushions and blankets</strong> to make sure you are comfortable. There will be Popcorn / sweets and hot dogs and drinks to make it a real cinema experience.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Come and join us and be part of St John&#8217;s cinema.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>All showings are screened with subtitles so everyone can enjoy the film.</strong></p>\n\n\n\n<p class=\"wp-block-paragraph\">You can buy tickets online or on the door. </p>\n\n\n\n<p class=\"wp-block-paragraph\">See the other films we&#8217;re showing <a href=\"https://www.stjohnsshirley.org.uk/cinema\">here</a>. </p>\n\r\n\t\t\t<div class='mt-order my-tickets' id='mt-response-53736'>\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<form action='https://www.stjohnsshirley.org.uk/love-actually/' method='POST' class='ticket-orders' id='order-tickets'>\r\n\t\t\t\t\t<div>\r\n\t\t\t\t\t\t<input type=\"hidden\" id=\"_wpnonce\" name=\"_wpnonce\" value=\"784bc66420\" /><input type=\"hidden\" name=\"_wp_http_referer\" value=\"/love-actually/\" />\r\n\t\t\t\t\t\t<input type='hidden' name='mt_event_id' value='53736' />\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<fieldset>\r\n\t\t\t\t\t<legend>Buy Tickets</legend>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<p class=\"tickets-remaining\"><span class='value'>148</span> tickets remaining.</p>\r\n\t\t\t\t\t\t<div class='mt-ticket-field mt-ticket-adult mt-available '><label for='mt_tickets_adult_53736' id='mt_tickets_label_adult_53736'>Adult</label><div class=\"mt-ticket-input\"><input type='number' name='mt_tickets[adult]'  min='0' max='148' id='mt_tickets_adult_53736' class='tickets_field' value='0' aria-labelledby='mt_tickets_label_adult_53736 mt_tickets_data_adult' /><button type=\"button\" class=\"mt-increment\"><span class=\"dashicons dashicons-plus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Add one</span></button><button type=\"button\" class=\"mt-decrement\"><span class=\"dashicons dashicons-minus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Remove one</span></button></div><span class='mt-ticket-data-price' id='mt_tickets_data_adult'><span class=\"mt-ticket-price\">£<span class=\"price\">5.00</span></span></span><span class='mt-error-notice' aria-live='assertive'></span></div><div class='mt-ticket-field mt-ticket-child mt-available '><label for='mt_tickets_child_53736' id='mt_tickets_label_child_53736'>Child</label><div class=\"mt-ticket-input\"><input type='number' name='mt_tickets[child]'  min='0' max='148' id='mt_tickets_child_53736' class='tickets_field' value='0' aria-labelledby='mt_tickets_label_child_53736 mt_tickets_data_child' /><button type=\"button\" class=\"mt-increment\"><span class=\"dashicons dashicons-plus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Add one</span></button><button type=\"button\" class=\"mt-decrement\"><span class=\"dashicons dashicons-minus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Remove one</span></button></div><span class='mt-ticket-data-price' id='mt_tickets_data_child'><span class=\"mt-ticket-price\">£<span class=\"price\">5.00</span></span></span><span class='mt-error-notice' aria-live='assertive'></span></div><div class='mt-ticket-field mt-ticket-reserve-and-pay-on-the-door mt-available '><label for='mt_tickets_reserve-and-pay-on-the-door_53736' id='mt_tickets_label_reserve-and-pay-on-the-door_53736'>Reserve and pay on the door</label><div class=\"mt-ticket-input\"><input type='number' name='mt_tickets[reserve-and-pay-on-the-door]'  min='0' max='148' id='mt_tickets_reserve-and-pay-on-the-door_53736' class='tickets_field' value='0' aria-labelledby='mt_tickets_label_reserve-and-pay-on-the-door_53736 mt_tickets_data_reserve-and-pay-on-the-door' /><button type=\"button\" class=\"mt-increment\"><span class=\"dashicons dashicons-plus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Add one</span></button><button type=\"button\" class=\"mt-decrement\"><span class=\"dashicons dashicons-minus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Remove one</span></button></div><span class='mt-ticket-data-price' id='mt_tickets_data_reserve-and-pay-on-the-door'><span class=\"mt-ticket-price\">£<span class=\"price\">0.00</span></span></span><span class='mt-error-notice' aria-live='assertive'></span></div>\r\n\t\t\t\t\t\t<div class='mt-response-container'>\r\n\t\t\t\t\t\t\t<p>\r\n\t\t\t\t\t\t\t\t<button type='submit' name='mt_add_to_cart'>Add to Cart<span class='mt-processing'><img src='https://www.stjohnsshirley.org.uk/wp-admin/images/spinner-2x.gif' alt='Working' /></span></button>\r\n\t\t\t\t\t\t\t</p>\r\n\t\t\t\t\t\t\t<div class='mt-response' aria-live='assertive'></div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<input type='hidden' name='my-tickets' value='true' />\r\n\t\t\t\t\t</fieldset>\r\n\t\t\t\t</form>\r\n\t\t\t</div>\t\t</div>\n\n\t\t\t</div>\n</article>\n\t\t</main>\n\t</div>\n\n\t<div class=\"widget-area sidebar is-right-sidebar\" id=\"right-sidebar\">\n\t<div class=\"inside-right-sidebar\">\n\t\t<aside id=\"search-2\" class=\"widget inner-padding widget_search\"><form method=\"get\" class=\"search-form\" action=\"https://www.stjohnsshirley.org.uk/\">\n\t<label>\n\t\t<span class=\"screen-reader-text\">Search for:</span>\n\t\t<input type=\"search\" class=\"search-field\" placeholder=\"Search &hellip;\" value=\"\" name=\"s\" title=\"Search for:\">\n\t</label>\n\t<button class=\"search-submit\" aria-label=\"Search\"></button></form>\n</aside><aside id=\"block-18\" class=\"widget inner-padding widget_block\">\n<div class=\"wp-block-group\"><div class=\"wp-block-group__inner-container is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Donate</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Donate to help continue the ministry and mission at St John's</p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter size-full\"><a href=\"https://www.stjohnsshirley.org.uk/donate\"><img loading=\"lazy\" decoding=\"async\" width=\"200\" height=\"66\" src=\"https://www.stjohnsshirley.org.uk/wp-content/uploads/2019/12/donatebutton-e1577196228377.png\" alt=\"\" class=\"wp-image-5150\" srcset=\"https://www.stjohnsshirley.org.uk/wp-content/uploads/2019/12/donatebutton-e1577196228377.png 200w, https://www.stjohnsshirley.org.uk/wp-content/uploads/2019/12/donatebutton-e15