www.stjohnsshirley.org.uk/st-johns-churchyard-trail-qr-b/\">St John’s Churchyard Trail – QR B</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-11598\"><a href=\"https://www.stjohnsshirley.org.uk/st-johns-churchyard-trail-qr-c/\">St John’s Churchyard Trail – QR C</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-11597\"><a href=\"https://www.stjohnsshirley.org.uk/st-johns-churchyard-trail-qr-d/\">St John’s Churchyard Trail – QR D</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-11713\"><a href=\"https://www.stjohnsshirley.org.uk/st-johns-churchyard-trail-qr-e/\">St John’s Churchyard Trail – QR E</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-11714\"><a href=\"https://www.stjohnsshirley.org.uk/st-johns-churchyard-trail-qr-f/\">St John’s Churchyard Trail – QR F</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-11715\"><a href=\"https://www.stjohnsshirley.org.uk/st-johns-churchyard-trail-qr-g/\">St John’s Churchyard Trail – QR G</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-11716\"><a href=\"https://www.stjohnsshirley.org.uk/st-johns-churchyard-trail-qr-h/\">St John’s Churchyard Trail – QR H</a></li>\n</ul>\n</li>\n</ul></div><div class=\"menu-bar-items\"><span class=\"menu-bar-item search-item\"><a aria-label=\"Open Search Bar\" href=\"#\"></a></span></div>\t\t\t</div>\n\t\t</nav>\n\t\t\n\t<div class=\"site grid-container container hfeed\" id=\"page\">\n\t\t\t\t<div class=\"site-content\" id=\"content\">\n\t\t\t\n\t<div class=\"content-area\" id=\"primary\">\n\t\t<main class=\"site-main\" id=\"main\">\n\t\t\t\n<article id=\"post-53714\" class=\"post-53714 page type-page status-publish has-post-thumbnail infinite-scroll-item\" itemtype=\"https://schema.org/CreativeWork\" itemscope>\n\t<div class=\"inside-article\">\n\t\t\n\t\t\t<header class=\"entry-header\">\n\t\t\t\t<h1 class=\"entry-title\" itemprop=\"headline\">The Polar Express</h1>\t\t\t</header>\n\n\t\t\t\n\t\t<div class=\"entry-content\" itemprop=\"text\">\n\t\t\t\n<p class=\"wp-block-paragraph\"></p>\n\n\n\n<h3 id=\"get-your-tickets\" class=\"wp-block-heading\">Get your tickets </h3>\n\n\n\n<h2 id=\"saturday-18th-december\" class=\"wp-block-heading\">Saturday 12th December @ 3:30pm</h2>\n\n\n\n<div class=\"wp-block-media-text is-stacked-on-mobile alignwide\"><figure class=\"wp-block-media-text__media\"><img fetchpriority=\"high\" decoding=\"async\" width=\"1596\" height=\"898\" data-attachment-id=\"53715\" data-permalink=\"https://www.stjohnsshirley.org.uk/the-polar-express/1596x898-polar-express/#main\" data-orig-file=\"https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/1596x898-Polar-Express.jpg\" data-orig-size=\"1596,898\" data-comments-opened=\"1\" data-image-title=\"1596&amp;#215;898-Polar-Express\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/1596x898-Polar-Express.jpg\" src=\"https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/1596x898-Polar-Express.jpg\" alt=\"\" class=\"wp-image-53715 size-full\" srcset=\"https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/1596x898-Polar-Express.jpg 1596w, https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/1596x898-Polar-Express-150x84.jpg 150w, https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/1596x898-Polar-Express-300x169-1.jpg 300w, https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/1596x898-Polar-Express-768x432.jpg 768w, https://www.stjohnsshirley.org.uk/wp-content/uploads/2026/11/1596x898-Polar-Express-1536x864.jpg 1536w\" sizes=\"(max-width: 1596px) 100vw, 1596px\" /></figure><div class=\"wp-block-media-text__content\">\r\n\t\t\t<div class='mt-order my-tickets' id='mt-response-53714-calendar-month'>\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<form action='https://www.stjohnsshirley.org.uk/the-polar-express/' method='POST' class='ticket-orders' id='order-tickets-calendar-month'>\r\n\t\t\t\t\t<div>\r\n\t\t\t\t\t\t<input type=\"hidden\" id=\"_wpnonce\" name=\"_wpnonce\" value=\"784bc66420\" /><input type=\"hidden\" name=\"_wp_http_referer\" value=\"/the-polar-express/\" />\r\n\t\t\t\t\t\t<input type='hidden' name='mt_event_id' value='53714' />\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<fieldset>\r\n\t\t\t\t\t<legend>Buy Tickets</legend>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<p class=\"tickets-remaining\"><span class='value'>141</span> tickets remaining.</p>\r\n\t\t\t\t\t\t<div class='mt-ticket-field mt-ticket-adult mt-available '><label for='mt_tickets_adult_53714' id='mt_tickets_label_adult_53714'>Adult</label><div class=\"mt-ticket-input\"><input type='number' name='mt_tickets[adult]'  min='0' max='141' id='mt_tickets_adult_53714' class='tickets_field' value='0' aria-labelledby='mt_tickets_label_adult_53714 mt_tickets_data_adult' /><button type=\"button\" class=\"mt-increment\"><span class=\"dashicons dashicons-plus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Add one</span></button><button type=\"button\" class=\"mt-decrement\"><span class=\"dashicons dashicons-minus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Remove one</span></button></div><span class='mt-ticket-data-price' id='mt_tickets_data_adult'><span class=\"mt-ticket-price\">£<span class=\"price\">3.00</span></span></span><span class='mt-error-notice' aria-live='assertive'></span></div><div class='mt-ticket-field mt-ticket-child mt-available '><label for='mt_tickets_child_53714' id='mt_tickets_label_child_53714'>Child</label><div class=\"mt-ticket-input\"><input type='number' name='mt_tickets[child]'  min='0' max='141' id='mt_tickets_child_53714' class='tickets_field' value='0' aria-labelledby='mt_tickets_label_child_53714 mt_tickets_data_child' /><button type=\"button\" class=\"mt-increment\"><span class=\"dashicons dashicons-plus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Add one</span></button><button type=\"button\" class=\"mt-decrement\"><span class=\"dashicons dashicons-minus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Remove one</span></button></div><span class='mt-ticket-data-price' id='mt_tickets_data_child'><span class=\"mt-ticket-price\">£<span class=\"price\">3.00</span></span></span><span class='mt-error-notice' aria-live='assertive'></span></div><div class='mt-ticket-field mt-ticket-reserve-and-pay-on-the-door mt-available '><label for='mt_tickets_reserve-and-pay-on-the-door_53714' id='mt_tickets_label_reserve-and-pay-on-the-door_53714'>Reserve and pay on the door</label><div class=\"mt-ticket-input\"><input type='number' name='mt_tickets[reserve-and-pay-on-the-door]'  min='0' max='141' id='mt_tickets_reserve-and-pay-on-the-door_53714' class='tickets_field' value='0' aria-labelledby='mt_tickets_label_reserve-and-pay-on-the-door_53714 mt_tickets_data_reserve-and-pay-on-the-door' /><button type=\"button\" class=\"mt-increment\"><span class=\"dashicons dashicons-plus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Add one</span></button><button type=\"button\" class=\"mt-decrement\"><span class=\"dashicons dashicons-minus\" aria-hidden=\"true\"></span><span class=\"screen-reader-text\">Remove one</span></button></div><span class='mt-ticket-data-price' id='mt_tickets_data_reserve-and-pay-on-the-door'><span class=\"mt-ticket-price\">£<span class=\"price\">0.00</span></span></span><span class='mt-error-notice' aria-live='assertive'></span></div>\r\n\t\t\t\t\t\t<div class='mt-response-container'>\r\n\t\t\t\t\t\t\t<p>\r\n\t\t\t\t\t\t\t\t<button type='submit' name='mt_add_to_cart'>Add to Cart<span class='mt-processing'><img src='https://www.stjohnsshirley.org.uk/wp-admin/images/spinner-2x.gif' alt='Working' /></span></button>\r\n\t\t\t\t\t\t\t</p>\r\n\t\t\t\t\t\t\t<div class='mt-response' aria-live='assertive'></div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<input type='hidden' name='my-tickets' value='true' />\r\n\t\t\t\t\t</fieldset>\r\n\t\t\t\t</form>\r\n\t\t\t</div>\n</div></div>\n\n\n\n<p class=\"wp-block-paragraph\">A young boy who has grown skeptical of Santa Claus is shocked to see a train stop outside his window on Christmas Eve, destined for the North Pole. When he accepts an invitation from the conductor to climb on board, he embarks on a white-knuckle ride to Santa’s headquarters, where he makes fast friends and learns an invaluable lesson about the true spirit of Christmas.</p>\n\n\n\n<div style=\"height:27px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n\n\n<p class=\"wp-block-paragraph\">On the 12th December 2026 @ 3:30pm we will be screening The Polar Express.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Doors open 3pm for at 3:30pm start.  </p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Bring your own cushions and blankets</strong> to make sure you are comfortable. There will be Popcorn / sweets and hot dogs and drinks to make it a real cinema experience.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Come and join us and be part of St John&#8217;s cinema.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>All showings are screened with subtitles so everyone can enjoy the film.</strong></p>\n\n\n\n<p class=\"wp-block-paragraph\">You can buy tickets online or on the door. </p>\n\n\n\n<p class=\"wp-block-paragraph\">See the other films we&#8217;re showing <a href=\"https://www.stjohnsshirley.org.uk/cinema\">here</a>. </p>\n\t\t</div>\n\n\t\t\t</div>\n</article>\n\t\t</main>\n\t</div>\n\n\t<div class=\"widget-area sidebar is-right-sidebar\" id=\"right-sidebar\">\n\t<div class=\"inside-right-sidebar\">\n\t\t<aside id=\"search-2\" class=\"widget inner-padding widget_search\"><form method=\"get\" class=\"search-form\" action=\"https://www.stjohnsshirley.org.uk/\">\n\t<label>\n\t\t<span class=\"screen-reader-text\">Search for:</span>\n\t\t<input type=\"search\" class=\"search-field\" placeholder=\"Search &hellip;\" value=\"\" name=\"s\" title=\"Search for:\">\n\t</label>\n\t<button class=\"search-submit\" aria-label=\"Search\"></button></form>\n</aside><aside id=\"block-18\" class=\"widget inner-padding widget_block\">\n<div class=\"wp-block-group\"><div class=\"wp-block-group__inner-container is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Donate</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Donate to help continue the ministry and mission at St John's</p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter size-full\"><a href=\"https://www.stjohnsshirley.org.uk/donate\"><img loading=\"lazy\" decoding=\"async\" width=\"200\" height=\"66\" src=\"https://www.stjohnsshirley.org.uk/wp-content/uploads/2019/12/donatebutton-e1577196228377.png\" alt=\"\" class=\"wp-image-5150\" srcset=\"https://www.stjohnsshirley.org.uk/wp-content/uploads/2019/12/donatebutton-e1577196228377.png 200w, https://www.stjohnsshirley.org.uk/wp-content/uploads/2019/12/donatebutton-e1577196228377-150x50.png 150w\" sizes=\"auto, (max-width: 200px) 100vw, 200px\" /></a></figure>\n</div></div></div>\n</aside><aside id=\"block-17\" class=\"widget inner-padding widget_block\">\n<div class=\"wp-block-group\"><div class=\"wp-block-group__inner-container is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Subscribe</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Enter your email below to be notified of all new posts to this website</p>\n\n\n\t<div class=\"wp-block-jetpack-subscriptions__supports-newline wp-block-jetpack-subscriptions__use-newline wp-block-jetpack-subscriptions__show-subs wp-block-jetpack-subscriptions\">\n\t\t<div class=\"wp-block-jetpack-subscriptions__container is-not-subscriber\">\n\t\t\t\t\t\t\t<form\n\t\t\t\t\taction=\"https://wordpress.com/email-subscriptions\"\n\t\t\t\t\tmethod=\"post\"\n\t\t\t\t\taccept-charset=\"utf-8\"\n\t\t