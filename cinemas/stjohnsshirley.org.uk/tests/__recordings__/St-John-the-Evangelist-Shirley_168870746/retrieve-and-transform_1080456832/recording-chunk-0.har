"1365,1024\" data-comments-opened=\"1\" data-image-title=\"img_1962.jpg\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.stjohnsshirley.org.uk/wp-content/uploads/2020/02/img_1962-1365x1024.jpg\" role=\"button\" tabindex=\"0\" aria-label=\"Open image 6 of 6 in full-screen\" srcset=\"https://i0.wp.com/www.stjohnsshirley.org.uk/wp-content/uploads/2020/02/img_1962-scaled.jpg?strip=info&#038;w=600&#038;ssl=1 600w,https://i0.wp.com/www.stjohnsshirley.org.uk/wp-content/uploads/2020/02/img_1962-scaled.jpg?strip=info&#038;w=900&#038;ssl=1 900w,https://i0.wp.com/www.stjohnsshirley.org.uk/wp-content/uploads/2020/02/img_1962-scaled.jpg?strip=info&#038;w=1200&#038;ssl=1 1200w,https://i0.wp.com/www.stjohnsshirley.org.uk/wp-content/uploads/2020/02/img_1962-scaled.jpg?strip=info&#038;w=1365&#038;ssl=1 1365w\" alt=\"\" data-height=\"1024\" data-id=\"5404\" data-link=\"https://www.stjohnsshirley.org.uk/img_1962-jpg/\" data-url=\"https://www.stjohnsshirley.org.uk/wp-content/uploads/2020/02/img_1962-scaled.jpg\" data-width=\"1365\" src=\"https://i0.wp.com/www.stjohnsshirley.org.uk/wp-content/uploads/2020/02/img_1962-scaled.jpg?ssl=1\" data-amp-layout=\"responsive\"/></a></figure></div></div></div></div>\n\n\n\n<div style=\"height:30px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n\n<div class=\"thermometer-container\"><div class=\"thermometer-wrap therm-align-left\" style=\"display:table;height: 392.28295819936px; width: 200px;\"><svg xmlns=\"http://www.w3.org/2000/svg\" version=\"2\" x=\"0\" y=\"0\" width=\"200\" height=\"392.28295819936\" viewBox=\"-31.5 0 155.5 305\" aria-label=\"Raised £5,478 towards the £10,000 target.\" preserveAspectRatio=\"xMidYMid\" class=\"thermometer_svg\"><defs><linearGradient id=\"therm_1_gradient_edfc94089fe84e5ee028e8e6ca835519\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\"><stop style=\"stop-color: #d7191c\" offset=\"0%\" /><stop style=\"stop-color: #d7191c\" offset=\"100%\" /></linearGradient><filter id=\"therm_1_shadow\" x=\"-20%\" y=\"-20%\" height=\"150%\" width=\"150%\" filterUnits=\"objectBoundingBox\">\r\n        <feGaussianBlur in=\"SourceAlpha\" stdDeviation=\"3\" result=\"shadow\"/> <!-- stdDeviation is how much to blur -->\r\n        <feOffset dx=\"1.8\" dy=\"1.8\" result=\"offsetblur\" in=\"shadow\"/> <!-- how much to offset -->\r\n        <feComponentTransfer result=\"shadow1\" in=\"offsetblur\">\r\n            <feFuncA type=\"linear\" slope=\"0.6\"/> <!-- slope is the opacity of the shadow -->\r\n        </feComponentTransfer>\r\n        <feBlend in = \"SourceGraphic\" in2 = \"shadow1\" mode = \"normal\"/>\r\n        </filter><filter id=\"therm_1_blur\">\r\n          <!-- filter processes -->\r\n          <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"7.5\"/><!-- stdDeviation is amount of blur -->\r\n      </filter>\r\n    <filter id=\"therm_1_blur2\">\r\n          <!-- filter processes -->\r\n          <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"2.2\"/><!-- stdDeviation is amount of blur -->\r\n      </filter>\r\n  </defs><desc>Created using the Donation Thermometer plugin https://wordpress.org/plugins/donation-thermometer/.</desc><text x=\"38\" y=\"20\" class=\"therm_target\" fill=\"#000000\" dominant-baseline=\"auto\" text-anchor=\"middle\">£10,000</text><path d=\"M38 25.5 C 28 25.5, 20 30, 20 36 L 20 251 C 15.5 255, 13 262, 13 268 C 13 282, 24 293, 38 293 C 52 293, 63 282, 63 268 C 63 262, 60 255, 56 251 L 56 36 C 56 30, 48 25.5, 38 25.5\" style=\"fill: transparent; stroke-opacity: 0!important;\"></path><path d=\"M20 130.962 L 20 251 C 15.5 255, 13 262, 13 268 C 13 282, 24 293, 38 293 C 52 293, 63 282, 63  268 C 63 262, 60 255, 56 251 L 56 130.962 L 20 130.962\" style=\"stroke-width: 0;\" fill=\"url(#therm_1_gradient_edfc94089fe84e5ee028e8e6ca835519)\"/><path d=\"M20 130.962 L 56 130.962\" class=\"therm_raisedLevel\" /><path d=\"M 58 130.962, 63 125.962, 63 135.962 Z\" class=\"therm_arrow\"/><text x=\"66\" y=\"130.962\" class=\"therm_raised\" text-anchor=\"start\" dominant-baseline=\"central\" fill=\"#000000\">£5,478</text><path d=\"M 56 36 L 43 36 M 56 78 L 43 78 M 56 120 L 43 120 M 56 162 L 43 162 M 56 204 L 43 204 M 56 246 L 43 246\" class=\"therm_majorTick\"/><path d=\"M 56 57 L 50 57 M 56 99 L 50 99 M 56 141 L 50 141 M 56 183 L 50 183 M 56 225 L 50 225\" class=\"therm_minorTick\"/><path d=\"M38 25.5 C 28 25.5, 20 30, 20 36 L 20 251 C 15.5 255, 13 262, 13 268 C 13 282, 24 293, 38 293 C 52 293, 63 282, 63 268 C 63 262, 60 255, 56 251 L 56 36 C 56 30, 48 25.5, 38 25.5\" class=\"therm_border\"><title>Raised £5,478 towards the £10,000 target.</title></path><text x=\"38\" y=\"274\" class=\"therm_percent\" style=\"font-size: 17px\" text-anchor=\"middle\" fill=\"#000000\">55%</text></svg></div></div>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\">We are raising money for our church 1 film at at time. All the money we make on the films goes back into the church absolutely nothing is siphoned off for any other use.</p>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\">Thank you very much for your support.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>All our films will be shown with subtitles</strong>, this is so we can include as many people as possible. Our pricing is low, just £5 a ticket or less, we will be offering sweets, hot dogs and even a licensed bar (evening screening only) for you to enjoy.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We are aiming to create a fun time for all the family without breaking the bank.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Tickets for all shows are available online and on the door, we are trying to avoid paper tickets to help the environment.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Our films are all licensed for public viewing through filmbankmedia.com</p>\n<div class=\"sharedaddy sd-sharing-enabled\"><div class=\"robots-nocontent sd-block sd-social sd-social-official sd-sharing\"><h3 class=\"sd-title\">Spread the good news</h3><div class=\"sd-content\"><ul><li class=\"share-facebook\"><div class=\"fb-share-button\" data-href=\"https://www.stjohnsshirley.org.uk/cinema/\" data-layout=\"button_count\"></div></li><li class=\"share-twitter\"><a href=\"https://twitter.com/share\" class=\"twitter-share-button\" data-url=\"https://www.stjohnsshirley.org.uk/cinema/\" data-text=\"Cinema\" data-via=\"stjohnsshirley\" >Tweet</a></li><li class=\"share-end\"></li></ul></div></div></div>\t\t</div>\n\n\t\t\t</div>\n</article>\n\t\t</main>\n\t</div>\n\n\t<div class=\"widget-area sidebar is-right-sidebar\" id=\"right-sidebar\">\n\t<div class=\"inside-right-sidebar\">\n\t\t<aside id=\"search-2\" class=\"widget inner-padding widget_search\"><form method=\"get\" class=\"search-form\" action=\"https://www.stjohnsshirley.org.uk/\">\n\t<label>\n\t\t<span class=\"screen-reader-text\">Search for:</span>\n\t\t<input type=\"search\" class=\"search-field\" placeholder=\"Search &hellip;\" value=\"\" name=\"s\" title=\"Search for:\">\n\t</label>\n\t<button class=\"search-submit\" aria-label=\"Search\"></button></form>\n</aside><aside id=\"block-18\" class=\"widget inner-padding widget_block\">\n<div class=\"wp-block-group\"><div class=\"wp-block-group__inner-container is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Donate</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Donate to help continue the ministry and mission at St John's</p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter size-full\"><a href=\"https://www.stjohnsshirley.org.uk/donate\"><img loading=\"lazy\" decoding=\"async\" width=\"200\" height=\"66\" src=\"https://www.stjohnsshirley.org.uk/wp-content/uploads/2019/12/donatebutton-e1577196228377.png\" alt=\"\" class=\"wp-image-5150\" srcset=\"https://www.stjohnsshirley.org.uk/wp-content/uploads/2019/12/donatebutton-e1577196228377.png 200w, https://www.stjohnsshirley.org.uk/wp-content/uploads/2019/12/donatebutton-e1577196228377-150x50.png 150w\" sizes=\"auto, (