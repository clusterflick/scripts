          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014866\",\"name\":\"WHAM! 10 Days in China\",\"originalName\":\"WHAM! 10 Days in China\",\"length\":90,\"posterLink\":\"https://regalcdn.azureedge.net/CW/WHAM10DaysinChina/HO00014866/TV_SmallPosterImage/20260623-112835517.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/WHAM10DaysinChina/HO00014866/TV_LargePosterImage/20260623-112835517.jpg\",\"videoLink\":\"https://youtu.be/P7oAaJqqv8w\",\"link\":\"https://www.cineworld.co.uk/films/wham-10-days-in-china/ho00014866\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"George Michael, Andrew Ridgeley\",\"directors\":\"Mike Christie\",\"synopsis\":\"In 1985, WHAM! made history as the first Western pop act to perform in communist China. George Michael and Andrew Ridgeley’s concerts in Beijing and Guangzhou were a cultural milestone – East meets West, music meets politics. Now, newly restored footage reveals the untold story of the iconic tour that helped launch WHAM! to global superstardom.\",\"dateStarted\":\"2026-07-28T00:00:00\",\"eventCount\":35,\"categoriesAttributes\":[],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"alternative-content\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/WHAM10DaysinChina/HO00014866/TV_TopShelfPosterImage/20260623-112835517.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/WHAM10DaysinChina/HO00014866/TV_SmallPosterImage/20260623-112835517.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/WHAM10DaysinChina/HO00014866/Mobile_MovieThumbnail/20260623-112835517.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/WHAM10DaysinChina/HO00014866/TV_LargePosterImage/20260623-112835517.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/WHAM10DaysinChina/HO00014866/Mobile_MovieFeed/20260623-112909298.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"},{\"type\":\"Video\",\"subType\":\"Trailer_Youtube\",\"url\":\"https://youtu.be/P7oAaJqqv8w\",\"dimensionHeight\":null,\"dimensionWidth\":null}],\"specialMessage\":null,\"distributorName\":\"TRAFALGAR RELEASING\"}}}",
