          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014601\",\"name\":\"Obsession\",\"originalName\":\"Obsession\",\"length\":109,\"posterLink\":\"https://regalcdn.azureedge.net/CW/Obsession/HO00014601/TV_SmallPosterImage/20260409-120609940.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/Obsession/HO00014601/TV_LargePosterImage/20260409-115849189.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/obsession/ho00014601\",\"weight\":-11,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Andy Richter, Michael Johnston, Inde Navarrette, Cooper Tomlinson, Megan Lawless\",\"directors\":\"Curry Barker\",\"synopsis\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for but soon discovers that some desires come at a dark, sinister price.\",\"dateStarted\":\"2026-05-15T00:00:00\",\"eventCount\":689,\"categoriesAttributes\":[\"horror\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"audio-described\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/18.png\",\"ageRestrictionName\":\"18\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/Obsession/HO00014601/TV_TopShelfPosterImage/20260409-115849189.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/Obsession/HO00014601/TV_SmallPosterImage/20260409-120609940.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/Obsessi