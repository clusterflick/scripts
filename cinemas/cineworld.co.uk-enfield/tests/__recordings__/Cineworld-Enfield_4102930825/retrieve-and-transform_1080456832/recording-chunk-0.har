          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014462\",\"name\":\"Fuze\",\"originalName\":\"Fuze\",\"length\":96,\"posterLink\":\"https://regalcdn.azureedge.net/CW/Fuze/HO00014462/TV_SmallPosterImage/20260311-083133612.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/Fuze/HO00014462/TV_LargePosterImage/20260311-082913582.jpg\",\"videoLink\":\"https://youtu.be/wX379E12UR4\",\"link\":\"https://www.cineworld.co.uk/films/fuze/ho00014462\",\"weight\":-4,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Luke Mably, Aaron Taylor-Johnson, Sam Worthington, Theo James, Gugu Mbatha-Raw, Atul Sharma, Honor Swinton Byrne, Saffron Hocking, Elham Ehsas\",\"directors\":\"David Mackenzie\",\"synopsis\":\"When a World War II bomb is discovered in central London a team of military experts led by Will (Aaron Taylor-Johnson), are sent in to investigate and defuse it. A huge police operation is put into action to evacuate thousands of local residents. Amidst the chaos of the situation a group of men, under the guidance of diamond-expert Karalis (Theo James), are hiding out in a basement within the evacuation zone. With emergency services stretched to the limit and the bomb ready to explode, the group begin an audacious jewel heist under cover of the ultimate distraction.\",\"dateStarted\":\"2026-04-03T00:00:00\",\"eventCount\":5,\"categoriesAttributes\":[\"action\",\"crime\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"audio-described\",\"cineseniors\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/15.png\",\"ageRestrictionName\":\"15\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/Fuze/HO00014462/TV_TopShelfPosterImage/20260311-082913582.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/Fuze/HO00014462/TV_SmallPosterImage/20260311-083133612.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/Fuze/HO00014462/Mobile_MovieThumbnail/20260311-082913582.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/Fuze/HO00014462/TV_LargePosterImage/20260311-082913582.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/Fuze/HO00014462/Mobile_MovieFeed/20260311-083025788.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"},{\"type\":\"Video\",\"subType\":\"Trailer_Youtube\",\"url\":\"https://youtu.be/wX379E12UR4\",\"dimensionHeight\":null,\"dimensionWidth\":null}],\"specialMessage\":null,\"distributorName\":\"STUDIOCANAL\"}}}",
