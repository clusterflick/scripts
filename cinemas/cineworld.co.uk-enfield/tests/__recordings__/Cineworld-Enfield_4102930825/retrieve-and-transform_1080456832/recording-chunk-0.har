          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00012505\",\"name\":\"Michael\",\"originalName\":\"Michael\",\"length\":127,\"posterLink\":\"https://regalcdn.azureedge.net/CW/Michael/HO00012505/TV_SmallPosterImage/20260423-051455402.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/Michael/HO00012505/TV_LargePosterImage/20260423-051419928.jpg\",\"videoLink\":\"https://youtu.be/RrktXOjOtps\",\"link\":\"https://www.cineworld.co.uk/films/michael/ho00012505\",\"weight\":-5,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Colman Domingo, Nia Long, Miles Teller, Jaafar Jackson, Juliano Krue Valdi, Laura Harrier\",\"directors\":\"Antoine Fuqua\",\"synopsis\":\"Michael is the cinematic portrayal of the life and legacy of one of the most influential artists the world has ever known.\\n\\nThe film tells the story of Michael Jackson’s life beyond the music, tracing his journey from the discovery of his extraordinary talent as the lead of the Jackson Five, to the visionary artist whose creative ambition fuelled a relentless pursuit to become the biggest entertainer in the world.\\n\\nHighlighting both his life off-stage and some of the most iconic performances from his early solo career, the film gives audiences a front-row seat to Michael Jackson as never before. This is where his story begins.\\n\\nMichael stars Jaafar Jackson in his feature film debut, Nia Long (Empire, The Best Man franchise), Laura Harrier (BlacKkKlansman, Spider-Man: Homecoming) and Juliano Krue Valdi (The Loud House, Arco), with Miles Teller (Top Gun: Maverick, Whiplash) and two-time Academy Award® nominee Colman Domingo (Sing Sing, Rustin).\\n\\nDirected by Antoine Fuqua, the award-winning filmmaker of Training Day, Olympus Has Fallen and The Equalizer franchise, from a screenplay by three-time Academy Award® nominee John Logan (Gladiator, The Aviator), the film is produced by Academy Award® winner Graham King (The Departed, Bohemian Rhapsody), John Branca (executive producer This Is It, Thriller 40) and John McClain (executive producer This Is It, Michael Jackson Live at Wembley July 16, 1988).\",\"dateStarted\":\"2026-04-22T00:00:00\",\"eventCount\":64,\"categoriesAttributes\":[\"drama\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"audio-described\",\"cineseniors\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Video\",\"subType\":\"Trailer_Youtube\",\"url\":\"https://youtu.be/RrktXOjOtps\",\"dimensionHeight\":null,\"dimensionWidth\":null},{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/Michael/HO00012505/TV_TopShelfPosterImage/20260423-051419928.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/Michael/HO00012505/Mobile_MovieThumbnail/20260423-051419928.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/Michael/HO00012505/TV_LargePosterImage/20260423-051419928.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/Michael/HO00012505/TV_SmallPosterImage/20260423-051455402.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/Michael/HO00012505/Mobile_MovieFeed/20260423-051519265.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"