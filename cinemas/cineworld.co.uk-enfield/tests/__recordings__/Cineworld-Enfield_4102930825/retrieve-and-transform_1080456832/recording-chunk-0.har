          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014757\",\"name\":\"RBO Cinema Season 2026-27: Götterdämmerung\",\"originalName\":\"RBO Cinema Season 2026-27: Götterdämmerung\",\"length\":350,\"posterLink\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Gtterdmmerung/HO00014757/TV_SmallPosterImage/20260528-062340389.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Gtterdmmerung/HO00014757/TV_LargePosterImage/20260528-062051634.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/rbo-cinema-season-2026-27-gotterdammerung/ho00014757\",\"weight\":0,\"releaseYear\":\"2027\",\"releaseCountry\":null,\"cast\":\"Christopher Purves, Mika Kares, Amanda Majeski, Andreas Schager, Elisabet Strid, Thomas Lehman, Annika Schlicht, Noa Beinart, Claire Barnett-Jones, Catharine Woodward, Sarah Brady, Niamh O’Sullivan, Sian Griffiths\",\"directors\":\"Barrie Kosky\",\"synopsis\":\"An earth in ruin. The twilight of the Gods. \\nDeception leads to treachery, then devastation, when Siegfried is tricked into betraying Brünnhilde. Learning the truth of her beloved’s innocence, Brünnhilde at last returns the ring to the Rhinemaidens, before ordering that Valhalla be swallowed in flames. For the long-awaited finale of Wagner’s epic saga, director Barrie Kosky situates the rich apocalyptic drama in a contemporary world of dream-like turmoil. Antonio Pappano, Conductor Laureate of The Royal Opera, returns to take on the impassioned, otherworldly music – including Siegfried’s transporting Funeral March and Brünnhilde’s electrifying Immolation Scene. The brilliant cast is led by Elisabet Strid, Andreas Schager and Mika Kares, who together with the full forces of the Orchestra of the Royal Opera House and the Royal Opera Chorus bring opera’s greatest journey to its shattering end.\",\"dateStarted\":\"2027-02-03T00:00:00\",\"eventCount\":74,\"categoriesAttributes\":[],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"alternative-content\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Gtterdmmerung/HO00014757/TV_TopShelfPosterImage/20260528-062051634.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Gtterdmmerung/HO00014757/TV_SmallPosterImage/20260528-062340389.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Gtterdmmerung/HO00014757/Mobile_MovieThumbnail/20260528-062051634.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Gtterdmmerung/HO00014757/TV_LargePosterImage/20260528-062051634.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Gtterdmmerung/HO00014757/Mobile_MovieFeed/20260528-062140510.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"TRAFALGAR RELEASING\"}}}",
