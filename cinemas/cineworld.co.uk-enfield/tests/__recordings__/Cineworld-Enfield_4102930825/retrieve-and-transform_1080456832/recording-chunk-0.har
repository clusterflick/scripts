          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014725\",\"name\":\"Minions & Monsters\",\"originalName\":\"Minions & Monsters\",\"length\":90,\"posterLink\":\"https://regalcdn.azureedge.net/CW/MinionsMonsters/HO00014725/TV_SmallPosterImage/20260520-051034151.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/MinionsMonsters/HO00014725/TV_LargePosterImage/20260520-051006985.jpg\",\"videoLink\":\"https://youtu.be/rwUCM8fuP2U\",\"link\":\"https://www.cineworld.co.uk/films/minions-monsters/ho00014725\",\"weight\":-14,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Jeff Bridges, Pierre Coffin, Zoey Deutch, Jesse Eisenberg, Allison Janney, Trey Parker, Christoph Waltz, Bobby Moynihan, Phil LaMarr\",\"directors\":\"Pierre Coffin\",\"synopsis\":\"Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe with a riotous new chapter, featuring all-new characters, in the biggest global animated franchise in history: Minions & Monsters.\\n\\nThis is the rambunctious, ridiculous and totally true story of how the Minions conquered Hollywood, became movie stars, lost everything, unleashed monsters onto the world and then banded together to try and save the planet from the mayhem they had just created.\\n\\nMinions & Monsters is directed by Academy Award® nominee Pierre Coffin, a director of the first three Despicable Me films and the first Minions film. Coffin has also provided the voice for the Minions since their film debut in 2010. The film is written by Brian Lynch (Minions, The Secret Life of Pets films) and Pierre Coffin and is produced by Illumination’s Academy Award® nominated founder and CEO Chris Meledandri and by Bill Ryan (executive producer, The Super Mario Bros. Movie). The executive producer is Brian Lynch.\\n\\nMore than ten years after their creation, the Minions have become the most iconic animated characters of their generation. Globally recognised and beloved by fans of all ages, they have propelled Illumination’s Despicable Me and Minions to a global box office of more than $5.6 billion.\",\"dateStarted\":\"2026-07-01T00:00:00\",\"eventCount\":4507,\"categoriesAttributes\":[\"animation\",\"comedy\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"3d\",\"4dx\",\"audio-described\",\"cinebabies\",\"laser\",\"recliner\",\"reserved-selected\",\"subbed\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/U.png\",\"ageRestrictionName\":\"u\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MinionsMonsters/HO00014725/TV_TopShelfPosterImage/20260520-051006985.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MinionsMonsters/HO00014725/TV_SmallPosterImage/20260520-051034151.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/MinionsMonsters/HO00014725/Mobile_MovieThumbnail/20260520-051006985.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MinionsMonsters/HO00014725/TV_LargePosterImage/20260520-051006985.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/MinionsMonsters/HO00014725/Mobile_MovieFeed/20260520-051052942.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"},{\"type\":\"Video\",\"subType\":\"Trailer_Youtube\",\"url\":\"https://youtu.be/rwUCM8fuP2U\",\"dimensionHeight\":null,\"dimensionWidth\":null}],\"specialMessage\":null,\"distributorName\":\"UNIVERSAL INT'L\"}}}",
