025/menu_cinema_2.jpg\">\n            </a>\n            <div class=\"pt-2\">The Cinema in the Power Station</div>\n          </div>\n        </div>\n\n        <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n          <div class=\"menu-promotion\">\n            <a class=\"menu-promotion__link\" href=\"https://www.thecinemaatselfridges.com/whats-on\">\n              <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_cinema_3.jpg\">\n            </a>\n            <div class=\"pt-2\">The Cinema at Selfridges</div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n        </div>\n      </div>\n    </div>\n\n                </li>\n\n\n              <li class=\"nav-item \">\n                <a class=\"nav-link \" href=\"https://www.olympicstudios.com/blogs/events\">Events</a>\n                              </li>\n\n              <li class=\"nav-item \">\n                <a class=\"nav-link \" href=\"https://www.olympicstudios.com/pages/private-hire\">Private Hire</a>\n                              </li>\n\n              \n\n              <!-- <li class=\"nav-item d-flex align-items-center justify-content-between \">\n                  <a href=\"https://www.olympicstudios.com/pages/membership\" \n                    class=\"nav-link nav-link-underline flex-grow-1 d-flex justify-content-between align-items-center \" \n                    data-nav=\"5\" \n                    data-target=\"subMenu5\">\n                    Membership<i class=\"bi bi-chevron-right ms-2 d-lg-none\"></i>\n                  </a>\n                                </li> -->\n\n              <li class=\"nav-item \">\n                <a class=\"nav-link \" href=\"https://www.olympicstudios.com/pages/membership\">Membership</a>\n                              </li>\n\n\n              <li class=\"nav-item \">\n                <a class=\"nav-link \" href=\"https://www.olympicstudios.com/pages/recording-studio\">Recor