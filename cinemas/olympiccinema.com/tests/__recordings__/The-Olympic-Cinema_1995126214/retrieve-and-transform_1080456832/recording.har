class=\"sub-menu\"  id=\"subMenu7\">\n              <h5 class=\"d-none\">Dine & Drink</h5>\n              \n  <div class=\"col-12 col-xl-10 py-lg-4 px-lg-9\">\n    <div class=\"row\">\n      \n      <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n        <div class=\"menu-promotion\">\n          <a class=\"menu-promotion__link\" href=\"https://www.olympicstudios.com/pages/dine-drink-olympic-barnes\">\n            <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_dine_1.jpg\">\n          </a>\n          <div class=\"pt-2\">Olympic / Barnes</div>\n        </div>\n      </div>\n\n      <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n        <div class=\"menu-promotion\">\n          <a class=\"menu-promotion__link\" href=\"https://www.olympicstudios.com/pages/battersea-the-lounge-bar\">\n            <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_dine_2.jpg\">\n          </a>\n          <div class=\"pt-2\">The Cinema in The Power Station / Battersea</div>\n        </div>\n      </div>\n\n      <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n        <div class=\"menu-promotion\">\n          <a class=\"menu-promotion__link\" href=\"https://www.olympicstudios.com/pages/dine-drink-selfridges\">\n            <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_dine_3.jpg\">\n          </a>\n          <div class=\"pt-2\">The Cinema at Selfridges / Duke Street</div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n            </div>\n\n          </div>\n \n\n\n        </div>\n    </div>\n    </nav>\n\n               \n    <script>\n              // document.addEventListener('DOMContentLoaded', function () {\n    // ... (your existing code) ...\n    // function handleMainMenuClick(e) {\n    //     // Prevent default navigation on mobile\n    //     if (window.innerWidth <= 921.98) {\n    //         const linkHref = e.currentTarget.href;\n    //         const hasSubmenu = e.currentTarget.dataset.target; // Check for data-target\n\n    //         if (hasSubmenu) {\n    //             e.preventDefault();\n    //             showSubMenu(hasSubmenu); // Use data-target to show submenu\n    //         }\n    //         // If the link does not have a submenu, allow default navigation\n    //     }\n    // }\n\n    // // Attach event listeners to menu items\n    // document.querySelectorAll('#mainMenu .nav-item a').forEach(link => {\n    //     link.addEventListener('click', handleMainMenuClick);\n    // });\n\n    // ... (rest of your code) ...\n// });\n            </script>\n\n\n    \n    <div id=\"page-submenus\" class=\"shopify-section shopify-section-group-header-group section-page-submenus\">\n      <!-- <div class=\"submenus\"> -->\n  <div class=\"d-flex justify-content-evenly\"><div class=\"submenu submenu-2\">\n<!-- <a href=\"/whats-on\" class=\"\"> -->\n  <a href=\"/whats-on\" class=\"\">\n        <span class=\"tagline\">What&#039;s On</span>\n    </a>\n</div><div class=\"submenu submenu-5\">\n<!-- <a href=\"/whats-on/babes-in-arms\" class=\"\"> -->\n  <a href=\"/whats-on/babes-in-arms\" class=\"\">\n        <span class=\"tagline\">Babes in Arms</span>\n    </a>\n</div><div class=\"submenu submenu-10\">\n<!-- <a href=\"/ticket-info\" class=\"\"> -->\n  <a href=\"/ticket-info\" class=\"\">\n        <span class=\"tagline\">Ticket Info</span>\n    </a>\n</div>      <!-- <div class=\"submenu submenu-1\">\n          <a href=\"/olympiccinema.com/signup\" class=\"\">\n              <span class=\"tagline\">Sign Up</span>\n          </a>\n      </div> --></div>    </div>\n  </section>\n\n  <section id=\"section_1_stack\" class=\"bg-dark py-4 py-lg-5\">    <div class=\"d-lg-block text-center \">\n        <img class=\"w-auto logo1-whatson mt-0\" src=\"/assets/images/cinema-logo-white-1.png\" alt=\"Cinema Logo\">\n    </div></section><section id=\"section_2_stack\" class=\"bg-white p-0\"><section class=\"mb-0\">\n    <div class=\"page-header py-5 py-md-0 ratio ratio-2x1 position-relative bg-white\">\n        <picture>\n            <source srcset=\"https://media.cinemacloud.co.uk/imageFilm/2012_7_1.jpg\" media=\"(max-width: 991.9px)\">\n            <source srcset=\"https://media.cinemacloud.co.uk/imageFilm/2012_10_1.jpg\" media=\"(min-width: 992px)\">\n            <img src=\"https://media.cinemacloud.co.uk/imageFilm/2012_10_1.jpg\" alt=\"Background\" class=\"w-100 h-100 position-absolute top-0 start-0 object-fit-cover\">\n        </picture>\n<div class=\"position-absolute w-100 w-lg-50 h-50 h-lg-100 bg-grad\"></div>        <div id=\"movie-overlay\" class=\"d-flex flex-column justify-content-end justify-content-lg-center align-items-center align-items-lg-start h-100 mx-lg-7\">\n        <div class=\"d-none d-lg-inline movie-awards mb-4 d-flex justify-content-start\"></div>    <img class=\"title-treatment mb-4 mb-lg-6\" src=\"https://media.cinemacloud.co.uk/imageFilm/2012_8_1.png\" alt=\"Logo\">    <div class=\"movie-badges mb-2 d-flex justify-content-start\">        <span class=\"badge text-bg-secondary me-2\">2024</span>\n    <span class=\"badge text-bg-secondary me-2\">1hr 21mins</span>        <img src=\"https://media.cinemacloud.co.uk/imageMisc/Dolby/Atmos/Vertical/DLB_Atms_vert_rgb_wht_@1x.png\" class=\"cert-20 me-2\" alt=\"Movie Sound Dolby Atmos\">\n        <img src=\"https://media.cinemacloud.co.uk/bbfc/SVGs/BBFC_12A_RGB.svg\" class=\"cert-20\" alt=\"BBFC Cert 12A\">\n    </div><p class=\"text-white opacity-6\"><small>Comedy, Music, History</small></p>    </div>    </div>\n</div>\n</section></section><section id=\"section_3_stack\" class=\"bg-white p-0\">            <div class=\"container my-5\">\n                <div class=\"row\">\n\n                    <div class=\"col-12 col-lg-6 order-1 order-lg-0\">\n                        <h3 class=\"text-uppercase\">Six The Musical Live!</h3>\n\n\n                        <p><img src=\"https://media.cinemacloud.co.uk/bbfc/SVGs/BBFC_12A_RGB.svg \" class=\"cert-40 my-4\" alt=\"BBFC Cert $certs\" ></p>\n\n                                                    <h3 class=\" fjalla-one-regular fs-4 text-dark mb-4\">Synopsis</h3>\n                            <p class=\"mb-5 text-dark\">The pop-inspired musical brings the six wives of Henry VIII right into the 21st century with infectious, empowering performances, accompanied by the on-stage band, the Ladies in Waiting. The Original West End cast reunites at London’s Vaudeville Theatre in front of a sold-out audience to strut their stuff and re-write their Tudor traumas in an unmissable cinematic recording of the show packed full of style, sass, and sensational songs.</p>\n                                                \n                        <div class=\"row\">\n                            <div class=\"col-7 col-md-8\">\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Release Date:</p>\n                                    <p class=\"mt-0 fw-bolder\">April</p>\n                                \n\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Duration:</p>\n                                    <p class=\"mt-0 fw-bolder\">1hr 21mins</p>\n                                \n\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Available Sound Formats:</p>\n                                    <p class=\"mt-0 fw-bolder sound-formats\">\n                                        Dolby Atmos                                    </p>\n                                                                                                    <p class=\"mb-1 fw-bold text-secondary\">Genre:</p>\n                                    <p class=\"mt-0 fw-bolder\">Comedy, Music, History</p>\n                                                                                                    <p class=\"mb-1 fw-bold text-secondary\">Country:</p>\n                                    <p class=\"mt-0 fw-bolder\">United Kingdom</p>\n                                \n                            </div>\n                            <div class=\"col-5 col-md-4\">\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Director:</p>\n                                    <p class=\"mt-0 fw-bolder\">Liz Clare,<br> Jamie Armitage</p>\n                                \n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Starring:</p>\n                                    <p class=\"mt-0 fw-bolder\">Jarneia Richard-Noel,<br> Millie O'Connell,<br> Natalie Paris,<br> Alexia McIntosh,<br> Aimie Atkinson,<br> Maiya Quansah-Breed</p>\n                                                            </div>\n                        </div>\n\n                        \n                        <!-- <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                            </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“Florence Pugh and Andrew Garfield scorch…The pair’s chemistry is off the charts and each set-piece a showstopper in this tragic romance.”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                            Kevin Maher, The Times\n                            </figcaption>\n                        </figure>\n\n                        <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                        </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“It’s such a joy to watch two such assured and natural performers allowed the room to exercise both movie star and actor muscles as well as showcase their ease with both comedy and drama.”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                            Benjamin Lee, Guardian\n                            </figcaption>\n                        </figure>\n\n                        <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                        </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“The perfect movie for when you want to sit in your feelings and be taken on an unashamedly emotional journey…Garfield and Pugh are as dreamy a team as you’d hope!”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                            Tori Brazier, Metro\n                            </figcaption>\n                        </figure>\n\n                        <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                        </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“Andrew Garfield and Florence Pugh will break your heart in a London romance of rare honesty.”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                                Helen O'Hara, Time Out\n                            </figcaption>\n                        </figure> -->\n\n             