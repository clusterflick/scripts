MAIL\" class=\"form-control required email\" id=\"mce-EMAIL\" placeholder=\"Your email *\" required>\n              <div class=\"invalid-feedback\">\n                Please type a valid email address.\n              </div>\n            </div>\n\n            <div class=\"row my-2\">\n              <div class=\"mc-field-group has-validation col-md-6 mb-2 mb-lg-0\">\n                <!-- <label for=\"mce-FNAME\" class=\"form-label\">First Name </label> -->\n                <input type=\"text\" name=\"FNAME\" class=\"form-control text\" id=\"mce-FNAME\" placeholder=\"First Name\" required>\n                <div class=\"valid-feedback\">Looks good!</div>\n              </div>\n              <div class=\"mc-field-group has-validation col-md-6\">\n                <!-- <label for=\"mce-LNAME\" class=\"form-label\">Last Name </label> -->\n                <input type=\"text\" name=\"LNAME\" class=\"form-control text\" id=\"mce-LNAME\" placeholder=\"Last Name\" required>\n                <div class=\"valid-feedback\">Looks good!</div>\n              </div>\n            </div>\n\n          \n\n            <div hidden=\"\">\n                <!-- <input type=\"hidden\" class=\"form-check-input\" name=\"group[1901][1]\" id=\"mce-group[1901]-1901-0\" value=\"\" checked>\n                <input type=\"hidden\" class=\"form-check-input\" name=\"group[1901][2]\" id=\"mce-group[1901]-1901-1\" value=\"\" checked>\n                <input type=\"hidden\" class=\"form-check-input\" name=\"group[1901][4]\" id=\"mce-group[1901]-1901-2\" value=\"\" checked> -->\n              <input type=\"hidden\" class=\"form-check-input\" name=\"group[1901][1]\" id=\"mce-group[1901]-1901-0\" value=\"\" checked>              <input type=\"hidden\" name=\"tags\" value=\"2961389,2961391,2961388\"> \n            </div>\n            <div id=\"mce-responses\" class=\"clear\">\n              <div class=\"response\" id=\"mce-error-response\" style=\"display: none;\"></div>\n              <div class=\"response\" id