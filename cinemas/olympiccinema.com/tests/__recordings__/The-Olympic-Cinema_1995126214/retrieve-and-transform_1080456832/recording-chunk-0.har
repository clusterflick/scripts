            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta content=\"dark light\" name=\"color-scheme\">\n    <meta content=\"origin\" name=\"referrer\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\">\n    <meta name=\"robots\" content=\"index, follow\">\n\n    <!-- SEO -->\n    <title>The Odyssey | Olympic Studios</title>    <meta name=\"description\" content=\"A hub of entertainment, with cinema at its heart, set in iconic locations\">\n    <link rel=\"canonical\" href=\"https://www.olympiccinema.com/film/the-odyssey\">\n\n    <!-- Open Graph -->\n    <meta property=\"og:title\"       content=\"The Odyssey | Olympic Studios\">\n    <meta property=\"og:description\" content=\"A hub of entertainment, with cinema at its heart, set in iconic locations\">\n    <meta property=\"og:url\"         content=\"https://www.olympiccinema.com/film/the-odyssey\">\n    <meta property=\"og:image\"       content=\"https://www.olympiccinema.com/assets/images/open_graph_logo.png\">\n    <meta property=\"og:type\"        content=\"website\">\n    <meta property=\"og:locale\"      content=\"en_GB\">\n    <meta property=\"og:site_name\"   content=\"Olympic Studios\">\n\n    <!-- Twitter / X -->\n    <meta name=\"twitter:card\"        content=\"summary_large_image\">\n    <meta name=\"twitter:title\"       content=\"The Odyssey | Olympic Studios\">\n    <meta name=\"twitter:description\" content=\"A hub of entertainment, with cinema at its heart, set in iconic locations\">\n    <meta name=\"twitter:image\"       content=\"https://www.olympiccinema.com/assets/images/open_graph_logo.png\">\n\n    <meta name=\"generator\" content=\"cc v3\">\n\n    <!-- BOOTSTRAP 5 -->\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css\" rel=\"stylesheet\" integrity=\"sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB\" crossorigin=\"anonymous\">\n    <lin