            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta content=\"dark light\" name=\"color-scheme\">\n    <meta content=\"origin\" name=\"referrer\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\">\n    <meta name=\"robots\" content=\"index, follow\">\n\n    <!-- SEO -->\n    <title>A Private Life | Olympic Studios</title>    <meta name=\"description\" content=\"A hub of entertainment, with cinema at its heart, set in iconic locations\">\n    <link rel=\"canonical\" href=\"https://www.olympiccinema.com/film/a-private-life\">\n\n    <!-- Open Graph -->\n    <meta property=\"og:title\"       content=\"A Private Life | Olympic Studios\">\n    <meta property=\"og:description\" content=\"A hub of entertainment, with cinema at its heart, set in iconic locations\">\n    <meta property=\"og:url\"         content=\"https://www.olympiccinema.com/film/a-private-life\">\n    <meta property=\"og:image\"       content=\"https://www.olympiccinema.com/assets/images/open_graph_logo.png\">\n    <meta property=\"og:type\"        content=\"website\">\n    <meta property=\"og:locale\"      content=\"en_GB\">\n    <meta property=\"og:site_name\"   content=\"Olympic Studios\">\n\n    <!-- Twitter / X -->\n    <meta name=\"twitter:card\"        content=\"summary_large_image\">\n    <meta name=\"twitter:title\"       content=\"A Private Life | Olympic Studios\">\n    <meta name=\"twitter:description\" content=\"A hub of entertainment, with cinema at its heart, set in iconic locations\">\n    <meta name=\"twitter:image\"       content=\"https://www.olympiccinema.com/assets/images/open_graph_logo.png\">\n\n    <meta name=\"generator\" content=\"cc v3\">\n\n    <!-- BOOTSTRAP 5 -->\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css\" rel=\"stylesheet\" integrity=\"sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB\" crossorigin=\"anonymous\">\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css\">\n\n    <!-- FONTS -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Fjalla+One&family=Open+Sans:wght@300;400;600;700&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://use.typekit.net/ldj0yqi.css\">\n\n    <!-- CUSTOM CSS -->\n    <link rel=\"stylesheet\" href=\"/assets/css/cinema-cloud.css?v=3.1.20\">\n\n    <!-- FAVICON -->\n    <link rel=\"shortcut icon\" type=\"image/ico\" href=\"/assets/images/cinema_1/favicon.ico\">\n    <link rel=\"apple-touch-icon\" type=\"image/png\" sizes=\"167x167\" href=\"/assets/images/cinema_1/favicon-167x167.png\">\n    <link rel=\"apple-touch-icon\" type=\"image/png\" sizes=\"180x180\" href=\"/assets/images/cinema_1/favicon-180x180.png\">\n    <link rel=\"icon\" type=\"image/png\" sizes=\"48x48\"   href=\"/assets/images/cinema_1/favicon-48x48.png\">\n    <link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/assets/images/cinema_1/favicon-192x192.png\">\n\n    <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"MovieTheater\",\"name\":\"Olympic Studios\",\"url\":\"https://www.olympiccinema.com\",\"address\":{\"@type\":\"PostalAddress\",\"name\":\"Olympic Studios\",\"streetAddress\":\"117-123 Church Road Barnes, London\",\"addressLocality\":\"London\",\"postalCode\":\"SW13 9HL\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"51.475098\",\"longitude\":\"-0.240723\"},\"priceRange\":\"£10 - £18.50\"}</script>\n                    <script async src=\"https://www.googletagmanager.com/gtag/js?id=G-R7ZMNQ3K54\"></script>\n                <script>\n                    window.dataLayer = window.dataLayer || [];\n                    function gtag(){dataLayer.push(arguments);}\n                    gtag('js', new Date());\n                    gtag('config', 'G-R7ZMNQ3K54');\n                </script>\n                </head>\n<body style=\"display:flex;flex-direction:column;min-height:100vh;\">\n        <section class=\"position-sticky top-0 z-index-4\">\n    <nav id=\"cc-nav\" class=\"navbar navbar-expand-lg bg-white border-bottom p-0 d-flex justify-content-between align-items-center start-0 end-0\">\n\n        <!-- Hamburger (mobile) -->\n        <div class=\"col-auto d-flex justify-content-start ms-2 d-lg-none\">\n            <button class=\"navbar-toggler border-0 p-0\" type=\"button\" data-bs-toggle=\"offcanvas\"\n                data-bs-target=\"#offcanvasMenu\" aria-controls=\"offcanvasMenu\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n                <span class=\"navbar-toggler-icon small\"></span>\n            </button>\n        </div>\n\n        <!-- Logo (centred on mobile) -->\n        <div class=\"col-auto d-flex justify-content-center position-absolute start-50 translate-middle-x d-lg-none\">\n            <a href=\"https://www.olympicstudios.com\" class=\"navbar-brand mx-auto\">\n                <img class=\"logo logo0 mobile-logo\" src=\"/assets/images/OlympicLogo_Gold.png\" alt=\"Cinema Logo\">\n            </a>\n        </div>\n\n        <!-- Account icon (mobile) -->\n        <div class=\"col-auto d-flex justify-content-end d-lg-none me-2\">\n            <a href=\"/account\" class=\"text-decoration-none\">\n                <span class=\"d-none me-2 sign-in-tag\">Sign In</span>\n                <i class=\"bi bi-person\" style=\"font-size:1.8rem;vertical-align:middle;\"></i>            </a>\n        </div>\n\n        <!-- Offcanvas panel -->\n        <div class=\"offcanvas offcanvas-start w-80\" id=\"offcanvasMenu\" tabindex=\"-1\" aria-labelledby=\"offcanvasMenuLabel\">\n\n            <div class=\"offcanvas-header border-bottom\">\n                <span class=\"back-btn\" onclick=\"returnToMainMenu()\" aria-label=\"Go back\">\n                    <i class=\"bi bi-chevron-left text-muted\"></i>\n                    <span class=\"offcanvas-title flex-grow-1\" id=\"menuTitle\"></span>\n                </span>\n                <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"offcanvas\" aria-label=\"Close\"></button>\n            </div>\n\n            <div class=\"offcanvas-body d-lg-flex justify-content-between align-items-center\">\n\n                <!-- Desktop logo -->\n                <div class=\"col d-none d-lg-block ms-2 ms-lg-5\">\n                    <a href=\"https://www.olympicstudios.com/\" class=\"d-inline-flex link-body-emphasis text-decoration-none align-middle\">\n                        <img class=\"logo logo0 ms-3\" src=\"/assets/images/OlympicLogo_Gold.png\" alt=\"Cinema Logo\">\n                    </a>\n                </div>\n\n                <!-- Main nav links -->\n                <div id=\"mainMenu\">\n                    <ul class=\"navbar-nav col col-md-auto mb-2 justify-content-center mb-md-0\">\n\n                                                <li class=\"nav-item d-flex align-items-center justify-content-between\">\n                            <a href=\"https://www.olympiccinema.com\"\n                               class=\"nav-link nav-link-underline flex-grow-1 d-flex justify-content-between align-items-center active\"\n                               data-nav=\"1\" data-target=\"subMenu1\">\n                               Barnes<i class=\"bi bi-chevron-right ms-2 d-lg-none\"></i>\n                            </a>\n                                    <div class=\"hover-content border-bottom\">\n            <div class=\"container-fluid\">\n                <div class=\"row justify-content-center\">\n                            <div class=\"col-12 col-xl-10 py-lg-5 px-lg-9 mx-0 mx-lg-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-sm-12 mb-4 ps-lg-7 d-flex justify-content-start\">\n                    <div class=\"menu-booknow text-start\">\n                        <p class=\"text-uppercase opacity-5 pb-2 small\" style=\"letter-spacing:0.1rem;\">Explore The Location</p>\n                        <ul class=\"nav nav-mobile-explore flex-column lh-sm\">\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympiccinema.com/whats-on\" class=\"p-0\">Box Office</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/private-hire-barnes\" class=\"p-0\">Private Hire</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/membershipatolympicstudios\" class=\"p-0\">Membership</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/barnes-bar-and-bistro\" class=\"p-0\">Bar &amp; Bistro</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympiccinema.com/whats-on/events\" class=\"p-0\">Events</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/members-club\" class=\"p-0\">Club Room</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/recording-studio\" class=\"p-0\">Recording Studio</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympiccinema.com/account\" class=\"p-0\">Login</a></li>\n                                                    </ul>\n                    </div>\n                </div>\n                <div class=\"col-8 col-lg-6 mb-2 pe-lg-7 d-flex justify-content-end\">\n                    <div class=\"menu-promotion\">\n                        <a class=\"menu-promotion__link\" href=\"https://www.olympicstudios.com/pages/olympic-studios-barnes\">\n                            <img class=\"menu-promotion__image img-fluid w-100 w-lg-100\" src=\"https://m.cinemacloud.co.uk/imageHeaderFooter/hf_6a35219db769f4.47754229.jpg\" alt=\"\">\n                        </a>\n                        <div class=\"pt-2\">Olympic / Barnes</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n                        </div>\n            </div>\n        </div>\n                                </li>\n                                                <li class=\"nav-item d-flex align-items-center justify-content-between\">\n                            <a href=\"https://www.thecinemainthepowerstation.com\"\n                               class=\"nav-link nav-link-underline flex-grow-1 d-flex justify-content-between align-items-center \"\n                               data-nav=\"2\" data-target=\"subMenu2\">\n                               Battersea<i class=\"bi bi-chevron-right ms-2 d-lg-none\"></i>\n                            </a>\n                                    <div class=\"hover-content border-bottom\">\n            <div class=\"container-fluid\">\n                <div class=\"row justify-content-center\">\n                            <div class=\"col-12 col-xl-10 py-lg-5 px-lg-9 mx-0 mx-lg-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-sm-12 mb-4 ps-lg-7 d-flex justify-content-start\">\n                    <div class=\"menu-booknow text-start\">\n                        <p class=\"text-uppercase opacity-5 pb-2 small\" style=\"letter-spacing:0.1rem;\">Explore The Location</p>\n                        <ul class=\"nav nav-mobile-explore flex-column lh-sm\">\n                                                        <li class=\"mb-2\"><a href=\"https://www.thecinemainthepowerstation.com/whats-on\" class=\"p-0\">Box Office</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/private-hire-battersea\" class=\"p-0\">Private Hire</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/membershipatolympicstudios\" class=\"p-0\">Membership</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/battersea-the-lounge-bar\" class=\"p-0\">The Lounge Bar</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.thecinemainthepowerstation.com/account\" class=\"p-0\">Login</a></li>\n                                                    </ul>\n                    </div>\n                </div>\n                <div class=\"col-8 col-lg-6 mb-2 pe-lg-7 d-flex justify-content-end\">\n                    <div class=\"menu-promotion\">\n                        <a class=\"menu-promotion__link\" href=\"https://www.olympicstudios.com/pages/the-cinema-in-the-power-station\">\n                            <img class=\"menu-promotion__image img-fluid w-100 w-lg-100\" src=\"https://m.cinemacloud.co.uk/imageHeaderFooter/hf_6a3521b6babe98.81395670.jpg\" alt=\"\">\n                        </a>\n                        <div class=\"pt-2\">The Cinema in The Power Station / Battersea</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n                        </div>\n            </div>\n        </div>\n                                </li>\n                                                <li class=\"nav-item d-flex align-items-center justify-content-between\">\n                            <a href=\"https://www.thecinemaatselfridges.com\"\n                               class=\"nav-link nav-link-underline flex-grow-1 d-flex justify-content-between align-items-center \"\n                               data-nav=\"3\" data-target=\"subMenu3\">\n                               Selfridges<i class=\"bi