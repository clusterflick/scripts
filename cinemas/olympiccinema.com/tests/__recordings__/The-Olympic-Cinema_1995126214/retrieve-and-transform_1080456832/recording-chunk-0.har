es/olympic-studios-barnes\">\n                            <img class=\"menu-promotion__image img-fluid w-100 w-lg-100\" src=\"https://m.cinemacloud.co.uk/imageHeaderFooter/hf_6a35219db769f4.47754229.jpg\" alt=\"\">\n                        </a>\n                        <div class=\"pt-2\">Olympic / Barnes</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n                        </div>\n            </div>\n        </div>\n                                </li>\n                                                <li class=\"nav-item d-flex align-items-center justify-content-between\">\n                            <a href=\"https://www.thecinemainthepowerstation.com\"\n                               class=\"nav-link nav-link-underline flex-grow-1 d-flex justify-content-between align-items-center \"\n                               data-nav=\"2\" data-target=\"subMenu2\">\n                               Battersea<i class=\"bi bi-chevron-right ms-2 d-lg-none\"></i>\n                            </a>\n                                    <div class=\"hover-content border-bottom\">\n            <div class=\"container-fluid\">\n                <div class=\"row justify-content-center\">\n                            <div class=\"col-12 col-xl-10 py-lg-5 px-lg-9 mx-0 mx-lg-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-sm-12 mb-4 ps-lg-7 d-flex justify-content-start\">\n                    <div class=\"menu-booknow text-start\">\n                        <p class=\"text-uppercase opacity-5 pb-2 small\" style=\"letter-spacing:0.1rem;\">Explore The Location</p>\n                        <ul class=\"nav nav-mobile-explore flex-column lh-sm\">\n                                                        <li class=\"mb-2\"><a href=\"https://www.thecinemainthepowerstation.com/whats-on\" class=\"p-0\">Box Office</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/private-hire-battersea\" class=\"p-0\">Private Hire</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/membershipatolympicstudios\" class=\"p-0\">Membership</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/battersea-the-lounge-bar\" class=\"p-0\">The Lounge Bar</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.thecinemainthepowerstation.com/account\" class=\"p-0\">Login</a></li>\n                                                    </ul>\n                    </div>\n                </div>\n                <div class=\"col-8 col-lg-6 mb-2 pe-lg-7 d-flex justify-content-end\">\n                    <div class=\"menu-promotion\">\n                        <a class=\"menu-promotion__link\" href=\"https://www.olympicstudios.com/pages/the-cinema-in-the-power-station\">\n                            <img class=\"menu-promotion__image img-fluid w-100 w-lg-100\" src=\"https://m.cinemacloud.co.uk/imageHeaderFooter/hf_6a3521b6babe98.81395670.jpg\" alt=\"\">\n                        </a>\n                        <div class=\"pt-2\">The Cinema in The Power Station / Battersea</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n                        </div>\n            </div>\n        </div>\n                                </li>\n                                                <li class=\"nav-item d-flex align-items-center justify-content-between\">\n                            <a href=\"https://www.thecinemaatselfridges.com\"\n                               class=\"nav-link nav-link-underline flex-grow-1 d-flex justify-content-between align-items-center \"\n                               data-nav=\"3\" data-target=\"subMenu3\">\n                               Selfridges<i class=\"bi bi-chevron-right ms-2 d-lg-none\"></i>\n                            </a>\n                                    <div class=\"hover-content border-bottom\">\n            <div class=\"container-fluid\">\n                <div class=\"row justify-content-center\">\n                            <div class=\"col-12 col-xl-10 py-lg-5 px-lg-9 mx-0 mx-lg-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-sm-12 mb-4 ps-lg-7 d-flex justify-content-start\">\n                    <div class=\"menu-booknow text-start\">\n                        <p class=\"text-uppercase opacity-5 pb-2 small\" style=\"letter-spacing:0.1rem;\">Explore The Location</p>\n                        <ul class=\"nav nav-mobile-explore flex-column lh-sm\">\n                                                        <li class=\"mb-2\"><a href=\"https://www.thecinemaatselfridges.com/whats-on\" class=\"p-0\">Box Office</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/private-hire-selfridges\" class=\"p-0\">Private Hire</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/the-cloakroom-at-selfridges\" class=\"p-0\">The Cloakroom</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/film-membership-signup\" class=\"p-0\">Film Membership</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.thecinemaatselfridges.com/account\" class=\"p-0\">Login</a></li>\n                                                    </ul>\n                    </div>\n                </div>\n                <div class=\"col-8 col-lg-6 mb-2 pe-lg-7 d-flex justify-content-end\">\n                    <div class=\"menu-promotion\">\n                        <a class=\"menu-promotion__link\" href=\"https://www.olympicstudios.com/pages/the-cinema-at-selfridges\">\n                            <img class=\"menu-promotion__image img-fluid w-100 w-lg-100\" src=\"https://m.cinemacloud.co.uk/imageHeaderFooter/hf_6a3521bcd95cc8.54869616.jpg\" alt=\"\">\n                        </a>\n                        <div class=\"pt-2\">The Cinema at Selfridges / Duke Street</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n                        </div>\n            </div>\n        </div>\n                                </li>\n                        \n                        <li class=\"nav-item\">\n                            <a class=\"nav-link\" href=\"https://www.olympicstudios.com/pages/private-hire\">Private Hire</a>\n                        </li>\n\n                    </ul>\n                </div>\n\n                <!-- Account icon (desktop) -->\n                <div class=\"col text-end d-none d-lg-block me-2 me-lg-5\">\n                                        <a href=\"/account\" class=\"\">\n                        <span class=\"sign-in-tag\">Sign In</span>\n                        <i class=\"bi bi-person\" style=\"font-size:1.8rem;vertical-align:middle;\"></i>                    </a>\n                                    </div>\n\n                <!-- Mobile sub-menus -->\n                <div class=\"sub-menus d-block d-lg-none\">\n                                        <div class=\"sub-menu\" id=\"subMenu1\">        <div class=\"col-12 col-xl-10 py-lg-5 px-lg-9 mx-0 mx-lg-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-sm-12 mb-4 ps-lg-7 d-flex justify-content-start\">\n                    <div class=\"menu-booknow text-start\">\n                        <p class=\"text-uppercase opacity-5 pb-2 small\" style=\"letter-spacing:0.1rem;\">Explore The Location</p>\n                        <ul class=\"nav nav-mobile-explore flex-column lh-sm\">\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympiccinema.com/whats-on\" class=\"p-0\">Box Office</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/private-hire-barnes\" class=\"p-0\">Private Hire</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/membershipatolympicstudios\" class=\"p-0\">Membership</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/barnes-bar-and-bistro\" class=\"p-0\">Bar &amp; Bistro</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympiccinema.com/whats-on/events\" class=\"p-0\">Events</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/members-club\" class=\"p-0\">Club Room</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/recording-studio\" class=\"p-0\">Recording Studio</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympiccinema.com/account\" class=\"p-0\">Login</a></li>\n                                                    </ul>\n                    </div>\n                </div>\n                <div class=\"col-8 col-lg-6 mb-2 pe-lg-7 d-flex justify-content-end\">\n                    <div class=\"menu-promotion\">\n                        <a class=\"menu-promotion__link\" href=\"https://www.olympicstudios.com/pages/olympic-studios-barnes\">\n                            <img class=\"menu-promotion__image img-fluid w-100 w-lg-100\" src=\"https://m.cinemacloud.co.uk/imageHeaderFooter/hf_6a35219db769f4.47754229.jpg\" alt=\"\">\n                        </a>\n                        <div class=\"pt-2\">Olympic / Barnes</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        </div>\n                                        <div class=\"sub-menu\" id=\"subMenu2\">        <div class=\"col-12 col-xl-10 py-lg-5 px-lg-9 mx-0 mx-lg-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-sm-12 mb-4 ps-lg-7 d-flex justify-content-start\">\n                    <div class=\"menu-booknow text-start\">\n                        <p class=\"text-uppercase opacity-5 pb-2 small\" style=\"letter-spacing:0.1rem;\">Explore The Location</p>\n                        <ul class=\"nav nav-mobile-explore flex-column lh-sm\">\n                                                        <li class=\"mb-2\"><a href=\"https://www.thecinemainthepowerstation.com/whats-on\" class=\"p-0\">Box Office</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/private-hire-battersea\" class=\"p-0\">Private Hire</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/membershipatolympicstudios\" class=\"p-0\">Membership</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/battersea-the-lounge-bar\" class=\"p-0\">The Lounge Bar</a></li>\n                                                        <li class=\"mb-2\"><a href=\"https://www.thecinemainthepowerstation.com/account\" class=\"p-0\">Login</a></li>\n                                                    </ul>\n                    </div>\n                </div>\n                <div class=\"col-8 col-lg-6 mb-2 pe-lg-7 d-flex justify-content-end\">\n                    <div class=\"menu-promotion\">\n                        <a class=\"menu-promotion__link\" href=\"https://www.olympicstudios.com/pages/the-cinema-in-the-power-station\">\n                            <img class=\"menu-promotion__image img-fluid w-100 w-lg-100\" src=\"https