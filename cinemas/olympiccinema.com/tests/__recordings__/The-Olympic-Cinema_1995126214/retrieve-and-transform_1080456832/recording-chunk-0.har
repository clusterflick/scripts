=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css\">\n\n    <!-- FONTS -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Fjalla+One&family=Open+Sans:wght@300;400;600;700&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://use.typekit.net/ldj0yqi.css\">\n\n    <!-- CUSTOM CSS -->\n    <link rel=\"stylesheet\" href=\"/assets/css/cinema-cloud.css?v=3.1.20\">\n\n    <!-- FAVICON -->\n    <link rel=\"shortcut icon\" type=\"image/ico\" href=\"/assets/images/cinema_1/favicon.ico\">\n    <link rel=\"apple-touch-icon\" type=\"image/png\" sizes=\"167x167\" href=\"/assets/images/cinema_1/favicon-167x167.png\">\n    <link rel=\"apple-touch-icon\" type=\"image/png\" sizes=\"180x180\" href=\"/assets/images/cinema_1/favicon-180x180.png\">\n    <link rel=\"icon\" type=\"image/png\" sizes=\"48x48\"   href=\"/assets/images/cinema_1/favicon-48x48.png\">\n    <link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/assets/images/cinema_1/favicon-192x192.png\">\n\n    <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"MovieTheater\",\"name\":\"Olympic Studios\",\"url\":\"https://www.olympiccinema.com\",\"address\":{\"@type\":\"PostalAddress\",\"name\":\"Olympic Studios\",\"streetAddress\":\"117-123 Church Road Barnes, London\",\"addressLocality\":\"London\",\"postalCode\":\"SW13 9HL\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"51.475098\",\"longitude\":\"-0.240723\"},\"priceRange\":\"£10 - £18.50\"}</script>\n                    <script async src=\"https://www.googletagmanager.com/gtag/js?id=G-R7ZMNQ3K54\"></script>\n                <script>\n                    window.dataLayer = window.dataLayer || [];\n                    function gtag(){dataLayer.push(arguments);}\n                    gtag('js', new Date());\n                    gtag('config', 'G-R7ZMNQ3K54');\n                </script>\n                </head>\n<body style=\"display:flex;flex-direction:column;min-height:100vh;\">\n        <section class=\"position-sticky top-0 z-index-4\">\n    <nav id=\"cc-nav\" class=\"navbar navbar-expand-lg bg-white border-bottom p-0 d-flex justify-content-between align-items-center start-0 end-0\">\n\n        <!-- Hamburger (mobile) -->\n        <div class=\"col-auto d-flex justify-content-start ms-2 d-lg-none\">\n            <button class=\"navbar-toggler border-0 p-0\" type=\"button\" data-bs-toggle=\"offcanvas\"\n                data-bs-target=\"#offcanvasMenu\" aria-controls=\"offcanvasMenu\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n                <span class=\"navbar-toggler-icon small\"></span>\n            </button>\n        </div>\n\n        <!-- Logo (centred on mobile) -->\n        <div class=\"col-auto d-flex justify-content-center position-absolute start-50 translate-middle-x d-lg-none\">\n            <a href=\"https://www.olympicstudios.com\" class=\"navbar-brand mx-auto\">\n                <img class=\"logo logo0 mobile-logo\" src=\"/assets/images/OlympicLogo_Gold.png\" alt=\"Cinema Logo\">\n            </a>\n        </div>\n\n        <!-- Account icon (mobile) -->\n        <div class=\"col-auto d-flex justify-content-end d-lg-none me-2\">\n            <a href=\"/account\" class=\"text-decoration-none\">\n                <span class=\"d-none me-2 sign-in-tag\">Sign In</span>\n                <i class=\"bi bi-person\" style=\"font-size:1.8rem;vertical-align:middle;\"></i>            </a>\n        </div>\n\n        <!-- Offcanvas panel -->\n        <div class=\"offcanvas offcanvas-start w-80\" id=\"offcanvasMenu\" tabindex=\"-1\" aria-labelledby=\"offcanvasMenuLabel\">\n\n            <div class=\"offcanvas-header border-bottom\">\n                <span class=\"back-btn\" onclick=\"returnToMainMenu()\" aria-la