n<!-- Bootstrap JS -->\n<script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js\" integrity=\"sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI\" crossorigin=\"anonymous\"></script>\n\n<!-- Cinema Cloud JS -->\n<script type=\"module\" src=\"/assets/js/cc.js?v=1783789733\"></script>\n\n<!-- reCAPTCHA v3 -->\n<script src=\"https://www.google.com/recaptcha/api.js?render=6LdezhkrAAAAAAFn9r67GsJcpL_NwdgNgUdcaBz6\"></script>\n<script>\ndocument.getElementById('mc-embedded-subscribe-form').addEventListener('submit', function(e) {\n    e.preventDefault();\n    const form     = this;\n    const response = document.getElementById('form-response');\n\n    if (!form.checkValidity()) {\n        form.classList.add('was-validated');\n        return;\n    }\n\n    grecaptcha.ready(function() {\n        grecaptcha.execute('6LdezhkrAAAAAAFn9r67GsJcpL_NwdgNgUdcaBz6', { action: 'subscribe' }).then(function(token) {\n            const formData = new FormData(form);\n            formData.set('g-recaptcha-response', token);\n\n            fetch(form.action, { method: 'POST', body: formData })\n            .then(r => r.json())\n            .then(data => {\n                if (data.status === 'success') {\n                    form.style.display = 'none';\n                    response.textContent = 'Thank you for subscribing!';\n                    response.style.display = 'block';\n                } else {\n                    response.textContent = data.message || 'Subscription failed. Please try again.';\n                    response.style.display = 'block';\n                }\n            })\n            .catch(function() {\n                response.textContent = 'A network error occurred. Please try again.';\n                response.style.display = 'block';\n            });\n        });\n    });\n});\n</script>\n\n</body>\n</html>\n        ",
