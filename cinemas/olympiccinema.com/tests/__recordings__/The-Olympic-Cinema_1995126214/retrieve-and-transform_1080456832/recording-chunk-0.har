ation:none !important; display:block; }\n    .cc-account-menu-item:hover, .cc-account-menu-item:focus { background-color:#f8f9fa; color:#212529; text-decoration:none !important; }\n</style>\n<script>\ndocument.querySelectorAll('.cc-nav-signout').forEach(function(btn) {\n    btn.addEventListener('click', function() {\n        fetch('/api/account/logout', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ action: 'logout' })\n        })\n        .then(function(r) { return r.ok ? r.json() : null; })\n        .then(function() { window.location.href = '/'; })\n        .catch(function() { window.location.reload(); });\n    });\n});\n</script>\n        <div class=\"cc-banner\" style=\"background:#937251\"><div class=\"cc-banner-desktop d-none d-md-block\"><div class=\"container\"><div class=\"d-flex flex-column align-items-center justify-content-center text-center py-2\"><span class=\"cc-banner-title fjalla-one-regular majortitle text-uppercase\" style=\"color:#ffffff;font-size:14px;letter-spacing:0.05em\">FAMILY FILM SEASON</span><span class=\"cc-banner-tagline\" style=\"color:#ffffff;font-size:11px\">£10 cinema tickets for all children under 14</span></div></div></div><div class=\"cc-banner-mobile d-block d-md-none\"><div class=\"container text-center py-2\"><div class=\"cc-banner-tagline\" style=\"color:#ffffff;font-size:11px\">£10 cinema tickets for all children under 14</div></div></div></div><section id=\"section_2_stack\" class=\"bg-dark p-0 m-0\">        <!-- Page Video Modal -->\n        <div id=\"videoModal\" class=\"modal fade\" data-bs-backdrop=\"static\" data-bs-keyboard=\"false\" tabindex=\"-1\" aria-labelledby=\"videoModalLabel\" aria-hidden=\"true\">\n            <div class=\"modal-dialog modal-dialog-centered modal-lg\">\n                <div class=\"modal-content\">\n                    <div class=\"modal-header justify-content-center position-relative\">\n                        <div class=\"w-100 text-center\">\n                            <h1 class=\"modal-title fs-5\" id=\"modalTrailerLabel\">Virginia Woolf&#039;s Night and Day</h1>\n                        </div>\n                        <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\n                    </div>\n                    <div class=\"modal-body p-1 p-md-2\">\n                        <div class=\"ratio ratio-16x9\">\n                            <iframe class=\"embed-responsive-item\" allowfullscreen allow=\"autoplay\" allowfullscreen=\"true\"></iframe>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- End Page Video Modal -->\n\n            <div class=\"page-header py-5 py-md-0 ratio ratio-2x1 position-relative\">\n        <picture>\n            <source srcset=\"https://m.cinemacloud.co.uk/imageFilm/2416_7_1.jpg\" media=\"(max-width: 767.9px)\">\n            <source srcset=\"https://m.cinemacloud.co.uk/imageFilm/2416_10_1.jpg\" media=\"(min-width: 768px)\">\n            <img src=\"https://m.cinemacloud.co.uk/imageFilm/2416_10_1.jpg\" alt=\"Background\" class=\"film-header-bg w-100 h-100 position-absolute top-0 start-0 object-fit-cover\" onload=\"this.style.opacity=1;\">\n        </picture>\n        <div class=\"position-absolute w-100 w-md-50 h-50 h-md-100 bg-grad-dark\"></div>\n        <div id=\"movie-overlay\" class=\"d-flex flex-column justify-content-end justify-content-md-center align-items-center align-items-md-start h-100 mx-md-5 mx-lg-7\">\n            \n            \n            <img class=\"title-treatment mb-4 mb-md-6 my-3\" src=\"https://m.cinemacloud.co.uk/imageFilm/2416_8_1.png\" alt=\"Virginia Woolf&#039;s Night and Day\" onerror=\"this.style.display='none';this.nextElementSibling.style.display=''\"><div class=\"title-treatment mb-4 mb-md-6 text-white text-left\" style=\"display:none;\"><h1 class=\"h4 text-white fw-semibold\">Virginia Woolf&#039;s Night and Day</h1></div>\n            \n            <div class=\"movie-badges mb-2 d-flex justify-content-start\">\n                <span class=\"badge text-bg-secondary me-2 px-3 fw-semibold\">2026</span><span class=\"badge text-bg-secondary me-2 px-3 fw-semibold\">1hr 35mins</span><img src=\"https://m.cinemacloud.co.uk/imageMisc/Dolby/Atmos/Vertical/DLB_Atms_vert_rgb_wht_@1x.png\" class=\"cert-20 me-2\" alt=\"Movie Sound Dolby Atmos\"><img src=\"https://m.cinemacloud.co.uk/bbfc/SVGs/BBFC_12A_RGB.svg\" class=\"cert-20\" alt=\"BBFC Cert 12A\">\n            </div>\n            \n            <p class=\"text-light fs-6 fw-semibold\"><small>Comedy, Drama, Romance</small></p>\n                        <div id=\"trailer-button\" class=\"d-none d-md-block me-md-auto mb-3\">\n                <a href=\"#\" class=\"btn btn-md rounded-pill d-inline-flex align-items-center blurred-button\"\n                   data-bs-toggle=\"modal\" data-bs-target=\"#videoModal\"\n                   data-video=\"https://www.youtube.com/embed/fPQ4RfIYeQ0?autoplay=1&origin=\">\n                    <i class=\"bi bi-play-fill fs-5 me-2\"></i>\n                    <span class=\"fs-6\">Trailer</span>\n                </a>\n            </div>\n            <script>\n                document.addEventListener('DOMContentLoaded', function() {\n                    const videoModal = document.getElementById('videoModal');\n                    const modalIframe = videoModal.querySelector('iframe');\n                    videoModal.addEventListener('show.bs.modal', function(event) {\n                        const button = event.relatedTarget;\n                        const url = button.getAttribute('data-video');\n                        modalIframe.setAttribute('src', url);\n                        modalIframe.setAttribute('allow', 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture');\n                    });\n                    videoModal.addEventListener('hidden.bs.modal', function() {\n                        modalIframe.removeAttribute('src');\n                        modalIframe.removeAttribute('allow');\n                    });\n                });\n            </script>\n            \n        </div>\n    </div></section><section id=\"section_3_stack\" class=\"bg-white p-0 m-0\">        <div class=\"container my-5\">\n            <div class=\"row\">\n                <!-- Left column: film info -->\n                <div class=\"col-12 col-lg-6 order-1 order-lg-0\">\n                    <h3 class=\"fjalla-one-regular fs-3 text-uppercase text-dark mb-4\">Virginia Woolf's Night and Day</h3>\n                    <div class=\"d-flex mt-1 mb-4\"><img class=\"flex-shrink-1 cert-40\" src=\"https://m.cinemacloud.co.uk/bbfc/SVGs/BBFC_12A_RGB.svg\" alt=\"BBFC Cert\"><small style=\"font-size: 0.7rem;\" class=\"w-100 small ps-2 text-muted fst-italic\">Admission to film screenings is strictly in accordance with BBFC age ratings and valid proof of age may be required as a condition of entry.</small></div>                    <div id=\"trailer-button\" class=\"d-block d-md-none me-md-auto mt-0 mb-4\"><a href=\"#\" class=\"btn btn-white btn-sm btn-lg-md rounded-1\" data-bs-toggle=\"modal\" data-bs-target=\"#videoModal\" data-video=\"https://www.youtube.com/embed/fPQ4RfIYeQ0?autoplay=1\">Watch Trailer</a></div>                    <h3 class=\"fjalla-one-regular fs-4 text-dark mb-4\">Synopsis</h3><div class=\"mb-5 text-dark\">Based on Virginia Woolf’s funniest novel, Night & Day is an unromantic comedy about a passionate astronomer who does everything she can to avoid romantic love and marriage. The story of heroine Katharine Hilbery’s bold challenge to the Edwardian patriarchy is set against the backdrop of the suffragette movement and advances in science and technology, at the turn of the 20th century.</div>                                                            <div class=\"row\">\n                        <div class=\"col-7 col-md-8\">\n                                                                                    <p class=\"mb-1 fw-semibold text-secondary\">Duration:</p><p class=\"mt-0 fw-bolder\">1hr 35mins</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Available Sound Formats:</p><p class=\"mt-0 fw-bolder sound-formats\">Dolby Atmos</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Genre:</p><p class=\"mt-0 fw-bolder\">Comedy, Drama, Romance</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Country:</p><p class=\"mt-0 fw-bolder\">Germany, United Kingdom, United States</p>                        </div>\n                        <div class=\"col-5 col-md-4\">\n                            <p class=\"mb-1 fw-semibold text-secondary\">Director:</p><p class=\"mt-0 fw-bolder\">Tina Gharavi</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Starring:</p><p class=\"mt-0 fw-bolder\">Jack Whitehall,<br> Haley Bennett,<br> Jennifer Saunders,<br> Sally Phillips,<br> Timothy Spall,<br> Elyas M&#039;Barek,<br> Lily Allen,<br> Misia Butler,<br> Simon Phillips,<br> Camilla Borghesani,<br> Erika Linder,<br> Nick Blakeley,<br> Elizabeth Edmonds</p>                        </div>\n                    </div>\n                                                            <hr class=\"dark horizontal my-5\"><figure class=\"mb-5\"><div class=\"d-block mb-2\"><div class=\"d-flex align-items-center\"><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i></div></div><blockquote class=\"blockquote text-dark mb-2\"><p>\"“Dreamy adaptation that reaches for the stars…It is such a sweet story and guilelessly eccentric.”\"</p></blockquote><figcaption class=\"blockquote-footer mt-1\">Peter Bradshaw, Guardian</figcaption></figure><figure class=\"mb-5\"><div class=\"d-block mb-2\"><div class=\"d-flex align-items-center\"><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i></div></div><blockquote class=\"blockquote text-dark mb-2\"><p>\"Haley Bennett is superb.\"</p></blockquote><figcaption class=\"blockquote-footer mt-1\">Kevin Maher, The Times</figcaption></figure><figure class=\"mb-5\"><div class=\"d-block mb-2\"><div class=\"d-flex align-items-center\"><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i></div></div><blockquote class=\"blockquote text-dark mb-2\"><p>\"A delightful night at the cinema with Virginia Woolf.\"</p></blockquote><figcaption class=\"blockquote-footer mt-1\">Tim Robey, The Telegraph</figcaption></figure>                </div>\n\n                <!-- Right column: sticky showtime panel -->\n                <div class=\"col-12 col-lg-6 ps-lg-5 order-0 order-lg-1\">\n                    <div class=\"d-none d-md-block position-sticky\" style=\"top: 164px\">\n                        <h2 class=\"fs-4 fjalla-one-regular text-dark\">Olympic Studios - Show Times</h2><p class=\"fs-6\">To book online, please select a time from below:</p>        <script>\n            document.addEventListener('DOMContentLoaded', function() {\n                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle=\"tooltip\"]'));\n                tooltipTriggerList.map(function(el) { return new bootstrap.Tooltip(el); });\n                document.querySelectorAll('a.disabled').forEach(function(el) {\n                    el.addEventListener('click', function(e) { e.preventDefault(); });\n                });\n            });\n        </script>\n            