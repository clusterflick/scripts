d\" value=\"1\">\n                    </div>\n                    <div class=\"col-md-12 pt-2\">\n                        <div class=\"form-check\">\n                            <input class=\"form-check-input\" type=\"checkbox\" value=\"1\" id=\"mc-invalidCheck-visible\" required checked>\n                            <label class=\"form-check-label\" for=\"mc-invalidCheck-visible\">\n                                <p class=\"mt-1 small\">Subscribe to our newsletter *</p>\n                                <p class=\"mb-1 small text-body-secondary\">You can unsubscribe anytime by clicking the Unsubscribe button in the newsletters. For further information please see our. <a href=\"https://www.olympicstudios.com/policies/privacy-policy\" target=\"_blank\" class=\"fw-semibold\">Privacy Policy</a>. I confirm that I am over 16 years of age.</p>\n                            </label>\n                            <div class=\"invalid-feedback\">You must agree before submitting.</div>\n                        </div>\n                    </div>\n                    <button type=\"submit\" class=\"btn btn-white border-radius-sm w-100 text-center mt-2\">Subscribe</button>\n                    <p class=\"mt-2 text-body-secondary\" style=\"font-size:0.7rem;\">This site is protected by reCAPTCHA and the Google <a href=\"https://policies.google.com/privacy\" target=\"_blank\">Privacy Policy</a> and <a href=\"https://policies.google.com/terms\" target=\"_blank\">Terms of Service</a> apply.</p>\n                </div>\n            </form>\n            <div id=\"form-response\" class=\"mt-3 text-center\" style=\"display:none;\"></div>\n        </div>\n\n    </div>\n\n    <div class=\"d-flex flex-column flex-sm-row justify-content-between px-1 px-lg-5 py-1 py-lg-4 border-top\">\n        <small>&copy; Copyright <script>document.write(new Date().getFullYear())</script> Olympic Studios. All rights reserved.</small>\n    </div>\n</footer>\n\n<!-- Bootstrap JS -->\n<script src=\"https://cdn.