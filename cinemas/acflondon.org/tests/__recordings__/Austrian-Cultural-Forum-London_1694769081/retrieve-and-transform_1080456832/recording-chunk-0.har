>\n                    <li class=\"menu-item menu-item__left has-children menu-green\"><a class=\"menu-heading\" href=\"/about/\">Information</a>\n                        <ul class=\"sub-menu plain-list info-list\">\n                            <div class=\"content\">\n                                <div class=\"sub-menu-wrapper\">\n                                    <li class=\"sub-item\"><a href=\"/about/\">About the ACF</a></li>\n                                    <li class=\"sub-item\"><a href=\"/about/history/\">History</a></li>\n                                    <li class=\"sub-item\"><a href=\"/about/library/\">Library</a></li>\n                                    <li class=\"sub-item\"><a href=\"/about/team/\">Team</a></li>\n                                    <li class=\"sub-item\"><a href=\"/about/submitting-proposals/\">Submitting proposals</a></li>\n                                    <li class=\"sub-item\"><a href=\"/about/partners/\">Partners</a></li>\n                                    <li class=\"sub-item\"><a href=\"/about/jobs-and-internships/\">Jobs &amp; internships</a></li>\n                                    <li class=\"sub-item\"><a href=\"/grants-and-opportunities/\">Grants &amp; opportunities</a></li>\n                                    <li class=\"sub-item\"><a href=\"/about/austro-uk-science-alliance/\">Austro-UK Science Alliance</a></li>\n                                    <li class=\"sub-item mobile-item\"><a href=\"/newsletter/\">Newsletter</a></li>\n                                </div>\n                            </div>\n                        </ul>\n                    </li>\n                    <li class=\"menu-item menu-item__left menu-item__calendar has-children menu-blue\"><a class=\"menu-heading calendar-heading\" href=\"#\">Calendar</a>\n                        <ul class=\"sub-menu plain-list calendar-list\">\n                            <div class=\"content calendar-content\">\n                                <div class=\"sub-menu-wrapper calendar\">\n                                </div>\n                            </div>\n                        </ul>\n                    </li>\n                    <div class=\"mobile-menu-section black\">\n                        <li class=\"menu-item\"><a href=\"/visit/\">Visit</a></li>\n                        <li class=\"menu-item menu-item__right search\"><a href=\"/search/\" class=\"search-trigger\">Search</a></li>\n                        <li class=\"menu-item menu-item__right\"><a href=\"/mailing-list/\">Mailing List</a></li>\n                        <li class=\"menu-item menu-item__right mailing-list mobile-homelink\"><a href=\"/\">Home</a></li>\n                        <ul class=\"plain-list sm-list mobile-sm-list\">\n                            <li class=\"sm-item sm-twitter\"><a href=\"https://twitter.com/ACF_London\" class=\"twitter\"></a></li>\n                            <li class=\"sm-item\"><a href=\"https://www.instagram.com/acf_london/\" class=\"instagram\"></a></li>\n                            <li class=\"sm-item\"><a href=\"https://www.facebook.com/acflondon/\" class=\"facebook\"></a></li>\n                        </ul>\n                    </div>\n                </ul>\n            </div>\n        </div>\n        <div class=\"basket-underlay\">\n            \n    <div class=\"content-outer\">\n        <div class=\"content-wrapper\">\n            <div class=\"basket-container\">\n                <div class=\"basket-container__inner\">\n                    <div class=\"row\">\n                        <div class=\"col-xs-12 basket-row\">\n                            <h2 class=\"booking-title\">Sonic Cinema presents Viktoria Schmid and Johann Lurf</h2>\n                            <a href=\"#\" class=\"basket-close\"></a>\n                            <form action=\"/book/\" method=\"post\" id=\"id_book\">\n                                <div class=\"booking-input\">\n                                    <input type=\"text\" class=\"input-field\" placeholder=\"First name\" name=\"first_name\">\n                                    <input type=\"text\" class=\"input-field\" placeholder=\"Last name\" name=\"last_name\">\n                                    <p id=\"name_error\" class=\"error\"></p>\n                                    <input type=\"email\" class=\"input-field\" placeholder=\"Email address\" name=\"email\">\n                                    <input type=\"email\" class=\"input-field\" placeholder=\"Confirm email address\" name=\"confirm_email\">\n                                    <p id=\"email_error\" class=\"error\"></p>\n                                </div>\n                                <div class=\"row\">\n                                    <div class=\"col-xs-12 col-sm-8 manage\">\n                                        <p class=\"quanity-heading\">Ticket quantity</p>\n                                        <input type=\"hidden\" value=\"4512\" name=\"event_id\"/>\n                                        <input type=\"text\" value=\"1\" class=\"cart-count count-item\" name=\"quantity\"/>\n                                        <p id=\"quantity_error\" class=\"error quantity\">You can book a maximum of two tickets per event. If you require more tickets or would like to make a group booking, please contact <a href=\"mailto:office@acflondon.org\">office@acflondon.org</a></p>\n                                    </div>\n                                </div>\n                                <p id=\"captcha_error\" class=\"error\"></p>\n                                \n                                <button class=\"g-recaptcha checkout-button booking-title\" \n                                        data-sitekey=\"6LcAaKAkAAAAAKRuvWDNtepkH0mF2Bpg5cZw9qDF\" \n                                        data-callback='checkout' \n                                        data-action='submit' style=\"padding: 0;background: transparent;border: 0;cursor: pointer;\">Book</button>\n                            </form>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n        </div>\n        <div class=\"content-outer\">\n            \n\t<div class=\"content offset-small\">\n        <div class=\"element-content\">\n\n            <div class=\"row type-tags\">\n                <div class=\"col-xs-12\">\n                    \n                        \n                            <a href=\"/tags/?tag=Visual Arts\" class=\"type-tag visual-arts\">Visual Arts</a>\n                        \n                            <a href=\"/tags/?tag=Film\" class=\"type-tag film\">Film</a>\n                        \n                    \n                </div>\n            </div>\n            \n            <div class=\"row\">\n                \n                        \n                \n\n                            \n                <div class=\"col-xs-12 col-sm-12 col-md-6\">\n                    <div class=\"event-wrapper event-detail\">\n                        \n                        <div class=\"mobile-tags\">\n                            \n                                <span class=\"tag event-tag\"><a href=\"/tags/?tag=Visual Arts\">Visual Arts</a></span>\n                            \n                                <span class=\"tag event-tag\"><a href=\"/tags/?tag=Film\">Film</a></span>\n                            \n                        </div>\n                        \n                        <h1 class=\"detail-title\">Sonic Cinema presents Viktoria Schmid and Johann Lurf</h1>\n                        <span class=\"detail-block\">\n                            <ul class=\"plain-list event-detail-list\">\n                                <li class=\"detail-item\">Thu 22 Jan 2026</li>\n                                <li class=\"detail-item\">6:45PM</li>\n                            </ul>\n                        </span>\n                        \n                            <div class=\"body-text event-desc\">\n                                <p data-block-key=\"iaygi\">Sonic Cinema presents a programme of ten short films, bringing together the practices of Vienna-based filmmakers Viktoria Schmid and Johann Lurf for the first time.</p><p data-block-key=\"5ufop\">Viktoria Schmid and Johann Lurf work at the intersection of the cinema and exhibition space, exploring shared interests in cinematic technologies, landscape, and human perception. Each working with a wide variety of mediums and formats including 35mm CinemaScope, 16mm, stereoscopic 3D, video, photography, and installation their works are characterised by their thoughtful exploration of concepts and surprising reconfigurations of the world around us. Though sharing similarities in subject matter and concepts, Schmid and Lurf’s differing approaches to their individual practices results in the distinctive bodies of work this programme seeks to juxtapose.</p><p data-block-key=\"ejq7n\">Viktoria Schmid and Johann Lurf will be present for a Q&amp;A after the screening.</p><p data-block-key=\"24aub\"><b>Booking and further information</b>:<br/> <a href=\"https://ica.art/films/sonic-cinema-viktoria-schmid-johann-lurf\">https://ica.art/films/sonic-cinema-viktoria-schmid-johann-lurf</a><br/> </p><p data-block-key=\"fho2o\"><b>Venue:</b><br/> Institute of Contemporary Arts, The Mall, St. James&#x27;s, London SW1Y 5AH</p><p data-block-key=\"2nmaf\"><a href=\"http://www.soniccinema.org/\">Sonic Cinema</a> is a research project and event series by Oliver Dickens, exploring the intersection of sound and moving-image. It is dedicated to the memory of Louis Benassi. Sign up to the Sonic Cinema newsletter <a href=\"https://mailchi.mp/12c77b6b762d/sonic-cinema\">here</a>.</p>\n                            </div>\n                        \n                        \n                    </div>\n                </div>\n                \n                \n                <div class=\"col-xs-12 col-sm-12 col-md-6 event-main-media\">\n                    <div class=\"event-wrapper\">\n                        \n                            \n                            <img src=\"/media/images/Sonic_Cinema_2026.width-900.jpg\" class=\"image\" alt=\"Sonic Cinema 2026\" />\n                    \n                    \n                    \n                        <div class=\"event-booking left\">\n                            \n                            \n                            \n                                \n                                    <p class=\"body-text location-block clear\">\n                                        <span class=\"event-location\"></span><br />\n                                        Institute of Contemporary Arts<br />\n                                        The Mall<br />\n                                        London <br />\n                                        \n                                    </p>\n                                \n                            \n                        </div>\n                        \n                    </div>\n                </div>\n                \n\n            </div>\n\n            \n\n            \n            \n            \n            \n\n\n            <!-- Event programme below here -->\n            <div class=\"row event-programme\">\n\n                \n                    \n                    \n\n                \n\n                \n            </div>\n        </div>\n    </div>\n\n            \n            <div class=\"content\">\n          \t\t<div class=\"footer-nav\" style=\"display: flex;\">\n          \t\t\t<a href=\"/newsletter/\"><span class=\"link link-black\">Newsletter</span></a>\n          \t\t\t<a href=\"/visit/\" class=\"location-link\"><span class=\"link link-visit\">Visit</span></a>\n          \t\t\t<a href=\"https://www.bmeia.gv.at/\"><img src=\"/static/img/BMEIA_Logo_srgb_EN.svg\" style=\"margin-left: 40px; width: 160px\" /></a>\n          \t\t</div>\n          \t</div>\n            \n        </div>\n        <div class=\"search-wrapper\">\n            \n                \n                <img class=\"preloader\" src=\"/media/images/freud-couch-1536x864.width-900.jpg\" />\n                <form action=\"/search\" method=\"get\" class=\"search-form\">\n                    <fieldset class=\"search-form__fieldset\">\n                        <div class=\"row\">\n                            <div class=\"col-xs-10 col-xs-offset-1 col-md-offset-3 col-md-6 search-form__field\">\n                                <input type=\"search\" class=\"search-form__input search-form__input--text\" name=\"query\">\n                            </div>\n                            <div class=\"col-xs-10 col-xs-offset-1 col-md-offset-3 col-md-6 search-form__field\">\n                                <input type=\"submit\" value=\"Search\" class=\"search-form__input search-form__input--submit\">\n                            </div>\n                        </div>\n                    </fieldset>\n                </form>\n            \n        </div>\n\n        <footer>\n            <div class=\"content-outer\">\n                <div class=\"content\">\n                    <div class=\"element-content clearfix footer-content\">\n                        <h1><a href=\"/\" class=\"site-logo footer-logo\"><span class=\"site-title\">Austrian Cultural Forum</span></a></h1>\n                        <p class=\"contact\"><a href=\"/\" class=\"footer-title\">Austrian Cultural Forum London</a><br />\n                        28 Rutland Gate<br />\n                        London SW7 1PQ<br />\n                        Tube: Knightsbridge</p>\n                        <p class=\"contact\">Opening times<br />\n                        Monday to Friday, 9.00am – 5.00pm</p>\n                        <p class=\"contact contact-tel\">Tel <a href=\"tel:+44 (0)20 7225 7300\">+44 (0)20 7225 7300</a><br />\n                        Fax <a href=\"tel:+44 (0)20 7225 0470\">+44 (0)20 7225 0470</a><br />\n                        Email: <a href=\"mailto:office@acflondon.org\">office@acflondon.org</a></p>\n                        <p style=\"clear: left;color: grey;\">Powered by the <a style=\"color: grey;\" href=\"https://www.bmeia.gv.at/themen/auslandskultur\">Austrian Federal Ministry for European and International Affairs</a></p>\n                        \n                        <ul class=\"plain-list footer-list\">\n                            <li class=\"footer-item\"><a href=\"/\">Home</a></li>\n                            <li class=\"footer-item\"><a href=\"/events/\">Programme</a></li>\n                            <li class=\"footer-item\"><a href=\"/about/\">Information</a></li>\n                            <li class=\"footer-item\"><a href=\"/mailing-list/\">Mailing List</a></li>\n                            <li class=\"footer-item\"><a href=\"/privacy-policy/\">Privacy Policy</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </footer>\n\n        \n    <script type=\"text/javascript\" src=\"/static/js/libs/lightslider.min.js\"></script>\n    <script type=\"text/javascript\" src=\"/static/js/libs/swiper.min.js\"></script>\n    <script type=\"text/javascript\" src=\"/static/js/libs/isotope.pkgd.js\"></script>\n    <script src=\"https://www.google.com/recaptcha/api.js\"></script>\n    <script>\n       function onSubmit(token) {\n         document.getElementById(\"id_book\").submit();\n       }\n     </script>\n\n\n        \n        <script type=\"text/javascript\" src=\"/static/js/libs/jquery.cookiebar.js\"></script>\n        <script type=\"text/javascript\" src=\"/static/js/libs/jquery.matchMedia.min.js\"></script>\n        <script type=\"text/javascript\" src=\"/static/js/libs/jquery.fitvids.js\"></script>\n        <script type=\"text/javascript\" src=\"/static/js/libs/flowtype.js\"></script>\n        <script type=\"text/javascript\" src=\"/static/js/scripts.js\"></script>\n\n        \n        \n    </body>\n</html>\n",
