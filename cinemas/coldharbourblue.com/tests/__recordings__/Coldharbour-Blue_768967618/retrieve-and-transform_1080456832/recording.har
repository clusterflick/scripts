p\"\n\t\tid=\"tribe-events-tooltip-content-12488\"\n\t\trole=\"tooltip\"\n\t>\n\t\t<div class=\"tribe-events-calendar-month__calendar-event-tooltip-featured-image-wrapper\">\n\t<img\n\t\tclass=\"tribe-events-calendar-month__calendar-event-tooltip-featured-image\"\n\t\tsrc=\"https://www.coldharbourblue.com/wp-content/uploads/2025/09/short-com.avif\"\n\t\t\t\t\tsrcset=\"https://www.coldharbourblue.com/wp-content/uploads/2025/09/short-com-300x151.avif 300w, https://www.coldharbourblue.com/wp-content/uploads/2025/09/short-com-768x387.avif 768w, https://www.coldharbourblue.com/wp-content/uploads/2025/09/short-com-600x302.avif 600w, https://www.coldharbourblue.com/wp-content/uploads/2025/09/short-com.avif 886w\"\n\t\t\t\t\t\t\talt=\"\"\n\t\t\t/>\n</div>\n\t\t<div class=\"tribe-events-calendar-month__calendar-event-tooltip-datetime\">\n\t\t<time datetime=\"2025-09-29\">\n\t\t<span class=\"tribe-event-date-start\">September 29 @ 7:00 pm</span> - <span class=\"tribe-event-time\">11:00 pm</span>\t</time>\n\t</div>\n\t\t<div class=\"tribe-events-calendar-month__calendar-event-tooltip-title tribe-common-h7\">\n\t<a\n\t\thref=\"https://www.coldharbourblue.com/event/short-com-film-and-animation-festival/\"\n\t\ttitle=\"Short Com Film and Animation Festival\"\n\t\trel=\"bookmark\"\n\t\tclass=\"tribe-events-calendar-month__calendar-event-tooltip-title-link tribe-common-anchor-thin\"\n\t>\n\t\tShort Com Film and Animation Festival\t</a>\n</div>\n\t\t<div class=\"tribe-events-calendar-month__calendar-event-tooltip-description tribe-common-b3\">\n\t<p>Short Com Film and Animation Festival 2025 are delighted to bring a bespoke programme to Coldharbour Blue. Short Com have been selecting the funniest short films from around the globe since 2011. And have one wicked programme of shorts to make you laugh, smile and maybe even cry. MEMBERS GET 50% OFF - EMAIL US [&hellip;]</p>\n</div>\n\t\t\t</div>\n</div>\n\n\t</div>\n\n</article>\n\n\t</div>\n\n\t\n</div>\n</td>\n\n\t\t\t\n\t\t\t\t<td\n\