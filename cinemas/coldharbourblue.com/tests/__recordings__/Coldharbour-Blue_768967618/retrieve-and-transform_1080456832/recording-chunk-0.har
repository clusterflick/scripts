/li>\n</ul>\t\t\t\t\t</nav>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</header>\r\n\r\n\t\r\n    <div class=\"hero \">\r\n        <div class=\"hero-content has-bg-img fixed\" style=\"background-image: url('https://www.coldharbourblue.com/wp-content/uploads/2025/05/IMG_2175-1024x683.jpg');\">\r\n            <div class=\"hero-image-filter\"></div>\r\n            <div class=\"hero-content-inner\">\r\n                \r\n                                    <h1 class=\"h2 hero-title\">Crafty Movie Night &#8211; 500 Days of Summer</h1>\r\n                \r\n                \r\n                            </div>\r\n        </div>\r\n    </div>\r\n\t<div class=\"main-wrapper \">\r\n\r\n\t\t<main id=\"site-content\" class=\"main\" role=\"main\" aria-label=\"Main Content\"><section id=\"tribe-events-pg-template\" class=\"tribe-events-pg-template\" role=\"main\"><div class=\"tribe-events-before-html\"></div><span class=\"tribe-events-ajax-loading\"><img class=\"tribe-events-spinner-medium\" src=\"https://www.coldharbourblue.com/wp-content/plugins/the-events-calendar/src/resources/images/tribe-loading.gif\" alt=\"Loading Events\" /></span>\n<div id=\"tribe-events-content\" class=\"tribe-events-single\">\n\n\t<p class=\"tribe-events-back\">\n\t\t<a href=\"https://www.coldharbourblue.com/events/\"> &laquo; All Events</a>\n\t</p>\n\n\t<!-- Notices -->\n\t<div class=\"tribe-events-notices\"><ul><li>This event has passed.</li></ul></div>\n\t<h1 class=\"tribe-events-single-event-title\">Crafty Movie Night &#8211; 500 Days of Summer</h1>\n\t<div class=\"tribe-events-schedule tribe-clearfix\">\n\t\t<h2><span class=\"tribe-event-date-start\">July 29 @ 6:30 pm</span> - <span class=\"tribe-event-time\">10:00 pm</span></h2>\t\t\t\t\t<span class=\"tribe-events-cost\">&pound;10.00</span>\n\t\t\t</div>\n\n\t<!-- Event header -->\n\t<div id=\"tribe-events-header\"  data-title=\"Crafty Movie Night - 500 Days of Summer - Coldharbour Blue\" data-viewtitle=\"Crafty Movie Night &#8211; 500 Days of Summer\">\n\t\t<!-- Navigation -->\n\t\t<nav class=\"tribe-events-nav-pagination\" aria-label=\"Event Navigation\">\n\t\t\t<ul class=\"tribe-events-sub-nav\">\n\t\t\t\t<li class=\"tribe-events-nav-previous\"><a href=\"https://www.coldharbourblue.com/event/the-last-one-for-the-road/\"><span>&laquo;</span> The Last One for the Road</a></li>\n\t\t\t\t<li class=\"tribe-events-nav-next\"><a href=\"https://www.coldharbourblue.com/event/the-film-club-death-becomes-her-1992/\">The Film Club &#8211; &#8216;Death Becomes Her&#8217; (1992) <span>&raquo;</span></a></li>\n\t\t\t</ul>\n\t\t\t<!-- .tribe-events-sub-nav -->\n\t\t</nav>\n\t</div>\n\t<!-- #tribe-events-header -->\n\n\t\t\t<div id=\"post-15219\" class=\"post-15219 tribe_events type-tribe_events status-publish has-post-thumbnail hentry tribe_events_cat-events cat_events\">\n\n\t\t\t<div class=\"tribe-events-event-image\"><img width=\"1536\" height=\"1920\" src=\"https://www.coldharbourblue.com/wp-content/uploads/2026/06/CRAFTY-MOVIE-NIGHT-1.png\" class=\"attachment-full size-full wp-post-image\" alt=\"\" decoding=\"async\" fetchpriority=\"high\" srcset=\"https://www.coldharbourblue.com/wp-content/uploads/2026/06/CRAFTY-MOVIE-NIGHT-1.png 1536w, https://www.coldharbourblue.com/wp-content/uploads/2026/06/CRAFTY-MOVIE-NIGHT-1-240x300.png 240w, https://www.coldharbourblue.com/wp-content/uploads/2026/06/CRAFTY-MOVIE-NIGHT-1-819x1024.png 819w, https://www.coldharbourblue.com/wp-content/uploads/2026/06/CRAFTY-MOVIE-NIGHT-1-768x960.png 768w, https://www.coldharbourblue.com/wp-content/uploads/2026/06/CRAFTY-MOVIE-NIGHT-1-1229x1536.png 1229w, https://www.coldharbourblue.com/wp-content/uploads/2026/06/CRAFTY-MOVIE-NIGHT-1-600x750.png 600w\" sizes=\"(max-width: 1536px) 100vw, 1536px\" /></div>\t\t\t<div class=\"grid\">\n\t\t\t\t<div class=\"grid-xs-12 grid-m-6\">\n\t\t\t\t\t<!-- Event content -->\n\t\t\t\t\t\n\t\t\t\t\t<div class=\"tribe-events-single-event-description tribe-events-content\">\n\t\t\t\t\t\t<p>Grab your latest project and join us for a night of crafting and fun. Whether you’re knitting, crocheting, sewing, bring your work-in-progress and get ready for a cosy evening with an excellent movie.<br />\nA collaboration between Coldharbour Blue and Craft Forward.</p>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"tribe-events-button\" href=\"http://coldharbourblue.com/event/crafty-movie-night-500-days-of-summer\" target=\"\">Event Info &amp; Tickets</a>\n\t\t\t\t\t\t\n\n\t\t\t\t\t</div>\n\t\t\t\t\t<!-- .tribe-events-single-event-description -->\n\t\t\t\t\t<div class=\"tribe-events tribe-common\">\n\t<div class=\"tribe-events-c-subscribe-dropdown__container\">\n\t\t<div class=\"tribe-events-c-subscribe-dropdown\">\n\t\t\t<div class=\"tribe-common-c-btn-border tribe-events-c-subscribe-dropdown__button\">\n\t\t\t\t<svg\n\t class=\"tribe-common-c-svgicon tribe-common-c-svgicon--cal-export tribe-events-c-subscribe-dropdown__export-icon\" \taria-hidden=\"true\"\n\tviewBox=\"0 0 23 17\"\n\txmlns=\"http://www.w3.org/2000/svg\"\n>\n\t<path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M.128.896V16.13c0 .211.145.383.323.383h15.354c.179 0 .323-.172.323-.383V.896c0-.212-.144-.383-.323-.383H.451C.273.513.128.684.128.896Zm16 6.742h-.901V4.679H1.009v10.729h14.218v-3.336h.901V7.638ZM1.01 1.614h14.218v2.058H1.009V1.614Z\" />\n\t<path d=\"M20.5 9.846H8.312M18.524 6.953l2.89 2.909-2.855 2.855\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n</svg>\n\t\t\t\t<button\n\t\t\t\t\tclass=\"tribe-events-c-subscribe-dropdown__button-text\"\n\t\t\t\t\taria-expanded=\"false\"\n\t\t\t\t\taria-controls=\"tribe-events-subscribe-dropdown-content\"\n\t\t\t\t\taria-label=\"View links to add events to your calendar\"\n\t\t\t\t>\n\t\t\t\t\tAdd to calendar\t\t\t\t</button>\n\t\t\t\t<svg\n\t class=\"tribe-common-c-svgicon tribe-common-c-svgicon--caret-down tribe-events-c-subscribe-dropdown__button-icon\" \taria-hidden=\"true\"\n\tviewBox=\"0 0 10 7\"\n\txmlns=\"http://www.w3.or