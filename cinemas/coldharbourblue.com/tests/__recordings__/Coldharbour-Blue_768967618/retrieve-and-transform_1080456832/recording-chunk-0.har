n\n\t<!-- Notices -->\n\t<div class=\"tribe-events-notices\"><ul><li>This event has passed.</li></ul></div>\n\t<h1 class=\"tribe-events-single-event-title\">The Film Club &#8211; &#8216;Death Becomes Her&#8217; (1992)</h1>\n\t<div class=\"tribe-events-schedule tribe-clearfix\">\n\t\t<h2><span class=\"tribe-event-date-start\">August 2 @ 1:00 pm</span> - <span class=\"tribe-event-time\">4:00 pm</span></h2>\t\t\t</div>\n\n\t<!-- Event header -->\n\t<div id=\"tribe-events-header\"  data-title=\"The Film Club - &#039;Death Becomes Her&#039; (1992) - Coldharbour Blue\" data-viewtitle=\"The Film Club &#8211; &#8216;Death Becomes Her&#8217; (1992)\">\n\t\t<!-- Navigation -->\n\t\t<nav class=\"tribe-events-nav-pagination\" aria-label=\"Event Navigation\">\n\t\t\t<ul class=\"tribe-events-sub-nav\">\n\t\t\t\t<li class=\"tribe-events-nav-previous\"><a href=\"https://www.coldharbourblue.com/event/crafty-movie-night-500-days-of-summer/\"><span>&laquo;</span> Crafty Movie Night &#8211; 500 Days of Summer</a></li>\n\t\t\t\t<li class=\"tribe-events-nav-next\"><a href=\"https://www.coldharbourblue.com/event/the-last-one-for-the-road-2/\">The Last One for the Road <span>&raquo;</span></a></li>\n\t\t\t</ul>\n\t\t\t<!-- .tribe-events-sub-nav -->\n\t\t</nav>\n\t</div>\n\t<!-- #tribe-events-header -->\n\n\t\t\t<div id=\"post-16112\" class=\"post-16112 tribe_events type-tribe_events status-publish has-post-thumbnail hentry tribe_events_cat-events cat_events\">\n\n\t\t\t<div class=\"tribe-events-event-image\"><img width=\"750\" height=\"750\" src=\"https://www.coldharbourblue.com/wp-content/uploads/2026/07/cz4hpiwpx1at7osaidr0.webp\" class=\"attachment-full size-full wp-post-image\" alt=\"\" decoding=\"async\" fetchpriority=\"high\" srcset=\"https://www.coldharbourblue.com/wp-content/uploads/2026/07/cz4hpiwpx1at7osaidr0.webp 750w, https://www.coldharbourblue.com/wp-content/uploads/2026/07/cz4hpiwpx1at7osaidr0-300x300.webp 300w, https://www.coldharbourblue.com/wp-content/uploads/2026/07/cz4hpiwpx1at7osaidr0-150x150.webp 150w, https://www.coldharbourblue.com/wp-content/uploads/2026/07/cz4hpiwpx1at7osaidr0-600x600.webp 600w, https://www.coldharbourblue.com/wp-content/uploads/2026/07/cz4hpiwpx1at7osaidr0-100x100.webp 100w\" sizes=\"(max-width: 750px) 100vw, 750px\" /></div>\t\t\t<div class=\"grid\">\n\t\t\t\t<div class=\"grid-xs-12 grid-m-6\">\n\t\t\t\t\t<!-- Event content -->\n\t\t\t\t\t\n\t\t\t\t\t<div class=\"tribe-events-single-event-description tribe-events-content\">\n\t\t\t\t\t\t<p>Join us for a special screening of Death Becomes Her (1992), the iconic dark comedy. Funny, sharp, and endlessly quotable, it&#8217;s a celebration of camp cinema and the pressures of beauty, ageing, and perfection.</p>\n<p>We&#8217;ll also be celebrating the film&#8217;s recent return to pop culture, including its influence on Sabrina Carpenter&#8217;s latest music video, with a short feature before the screening and a few fun surprises throughout the afternoon.</p>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"tribe-events-button\" href=\"https://www.thecliq.app/event/death-becomes-her-social-screening\" target=\"\">Event Info &amp; Tickets</a>\n\t\t\t\t\t\t\n\n\t\t\t\t\t</div>\n\t\t\t\t\t<!-- .tribe-events-single-event-description -->\n\t\t\t\t\t<div class=\"tribe-events tribe-common\">\n\t<div class=\"tribe-events-c-subscribe-dropdown__container\">\n\t\t<div class=\"tribe-events-c-subscribe-dropdown\">\n\t\t\t<div class=\"tribe-common-c-btn-border tribe-events-c-subscribe-dropdown__button\">\n\t\t\t\t<svg\n\t class=\"tribe-common-c-svgicon tribe-common-c-svgicon--cal-export tribe-events-c-subscribe-dropdown__export-icon\" \taria-hidden=\"true\"\n\tviewBox=\"0 0 23 17\"\n\txmlns=\"http://www.w3.org/2000/svg\"\n>\n\t<path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M.128.896V16.13c0 .211.145.383.323.383h15.354c.179 0 .323-.172.323-.383V.896c0-.212-.144-.383-.323-.383H.451C.273.513.128.684.128.896Zm16 6.742h-.901V4.679H1.009v10.729h14.218v-3.336h.901V7.638ZM1.