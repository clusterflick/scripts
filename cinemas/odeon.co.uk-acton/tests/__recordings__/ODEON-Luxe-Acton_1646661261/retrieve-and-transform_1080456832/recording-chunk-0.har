les\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000009008\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017362\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017363\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017364\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000086\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000825\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000982\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001684\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002432\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"eea3fe00-3e2b-4dcc-9150-aedd76790a42\",\"corporateId\":null},\"hopk\":\"HO00008193\",\"hoCode\":\"A000009285\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008237\",\"title\":{\"text\":\"Shelter\",\"translations\":[]},\"synopsis\":{\"text\":\"On a remote coastal island, a man living in self-imposed exile rescues a young girl from a deadly storm. This action sets off a chain of events, bringing him out of seclusion and both into harm’s way. As their lives intertwine, he must navigate protecting the orphaned girl while battling enemies from is past - setting them both on a breathless odyssey for survival and a deeper journey toward redemption.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"On a remote coastal island, a man living in self-imposed exile rescues a young girl from a deadly storm.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":107,\"trailerUrl\":null,\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000262\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001557\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002147\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014866\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016569\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017459\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000088\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000251\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001694\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001819\",\"roles\":[\"Actor\",\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000007\",\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9e3b2fd7-c5b2-4dee-857d-9dc3d230e4cd\",\"corporateId\":null},\"hopk\":\"HO00008237\",\"hoCode\":\"A000009331\",\"eventId\":null,\"distributorName\":\"Black Bear Pictures\"},{\"id\":\"HO00008239\",\"title\":{\"text\":\"Kangaroo\",\"translations\":[]},\"synopsis\":{\"text\":\"KANGAROO is a heart-warming family comedy about ex TV personality, Chris Masterman, who becomes stranded in an Outback town outside Alice Springs. There, he teams up with 12-year-old Indigenous girl Charlie. The pair form an unlikely friendship and work together to rescue and rehabilitate orphaned joeys in the remote but stunning Outback community - an endeavour that proves to be life-changing for them both.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"KANGAROO is a heart-warming family comedy about an ex-TV personality Chris Masterman, who becomes stranded in an Outback town after a car accident on his way to Broome. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild bad language, threat, violence\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":107,\"trailerUrl\":\"https://www.youtube.com/watch?v=BAwuJ74KP6U\",\"displayPriority\":12,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002636\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006784\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011449\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011614\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012011\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016712\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016713\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000016714\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016715\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016716\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016717\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016718\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016719\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016720\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016721\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016722\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016723\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016724\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016725\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002378\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2190fa2f-4101-475d-848f-b328ee1f0b8d\",\"corporateId\":null},\"hopk\":\"HO00008239\",\"hoCode\":\"A000009333\",\"eventId\":null,\"distributorName\":\"STUDIOCANAL\"},{\"id\":\"HO00008273\",\"title\":{\"text\":\"Primate\",\"translations\":[]},\"synopsis\":{\"text\":\"In PRIMATE, a group of friends’ tropical vacation turns into a terrifying, primal tale of horror and survival.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In PRIMATE, a group of friends’ tropical vacation turns into a terrifying, primal tale of horror and survival.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong bloody violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":89,\"trailerUrl\":\"https://www.youtube.com/watch?v=L9Odp8RvbLo\",\"displayPriority\":10,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000017524\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017525\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017526\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017527\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017528\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017529\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017530\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017532\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017533\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002732\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"67aa2582-ac18-4747-8f49-005d24853af3\",\"corporateId\":null},\"hopk\":\"HO00008273\",\"hoCode\":\"A000009367\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00008325\",\"title\":{\"text\":\"Return to Silent Hill\",\"translations\":[]},\"synopsis\":{\"text\":\"When a mysterious letter calls him back to Silent Hill in search of his lost love, James finds a once-recognizable town and encounters terrifying figures both familiar and new, and begins to question his own sanity.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When a mysterious letter calls him back to Silent Hill in search of his lost love, James finds a once-recognizable town and encounters terrifying figures.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong horror, gore, language\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":105,\"trailerUrl\":null,\"displayPriority\":11,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003901\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004117\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012885\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012886\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017616\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017617\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017618\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"0004c65f-7fef-466d-afe4-7bab15b10fa6\",\"corporateId\":null},\"hopk\":\"HO00008325\",\"hoCode\":\"A000009423\",\"eventId\":null,\"distributorName\":\"ENTERTAINMENT FILM DISTRIBUTOR\"},{\"id\":\"HO00008390\",\"title\":{\"text\":\"Iron Lung\",\"translations\":[]},\"synopsis\":{\"text\":\"The stars are gone. The planets have disappeared. Only individuals aboard space stations or starships were left to give the end a name - The Quiet Rapture. After decades of decay and crumbling infrastructure, the Consolidation of Iron has made a discovery on a barren moon designated AT-5. An ocean of blood.\\u2028 Hoping to discover desperately needed resources they immediately launch an expedition. A submarine is crafted and a convict is welded inside. Due to the pressure and depth of the ocean the forward viewport has been encased in metal. If successful, they will earn their freedom. If not, another will follow. This will be the 13th expedition.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The stars are gone. The planets have disappeared. Only those on space stations or starships were left to give the end a name. The Quiet Rapture. The universe dims.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, bloody images, threat\",\"translations\":[]},\"releaseDate\":\"2026-01-29\",\"runtimeInMinutes\":125,\"trailerUrl\":null,\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000017729\",\"roles\":[\"Actor\",\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000014\",\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4187d757-ba5e-42e9-9ba3-f3aa56e6b45f\",\"corporateId\":null},\"hopk\":\"HO00008390\",\"hoCode\":\"A000009492\",\"eventId\":null,\"distributorName\":\"(New) Iron Lung Inc\"},{\"id\":\"HO00008395\",\"title\":{\"text\":\"Border 2\",\"translations\":[]},\"synopsis\":{\"text\":\"During the events of the 1971 Indo-Pak war, a new generation of young Indian warriors were getting ready to defend the nation from an even bigger threat to the Indian motherland.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"During the events of the 1971 Indo-Pak war, a new generation of young Indian warriors were getting ready to defend the nation from an even bigger threat\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":199,\"trailerUrl\":\"https://www.youtube.com/watch?v=nvmc2ECk8Lo\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000133\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000231\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005031\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001128\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002713\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000009\",\"0000000024\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"263d0f31-f2aa-489e-b8db-f1bb8f88a009\",\"corporateId\":null},\"hopk\":\"HO00008395\",\"hoCode\":\"A000009497\",\"eventId\":null,\"distributorName\":\"AA Films UK LTD\"},{\"id\":\"HO00008400\",\"title\":{\"text\":\"En Ghab El Kot \",\"translations\":[]},\"synopsis\":{\"text\":\"Zain, a quiet art history professor, is mistaken for a famous thief known as \\\"The Cat\\\" due to their uncanny resemblance. When his fiancée Hind is assigned to restore a valuable painting that \\\"The Cat\\\" plans to steal, Zain gets caught in a whirlwind of danger and comedy. While Hind is drawn to the mysterious thief, Zain is tasked with recovering the stolen artwork — leaving her torn between the two men.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The theft of a famous painting from a museum leads to an unexpected conflict between the gang members and the museum staff.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":100,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000012604\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012605\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017120\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017751\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017752\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000001\",\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ff479b54-23e3-46b1-8bda-324d2afe9322\",\"corporateId\":null},\"hopk\":\"HO00008400\",\"hoCode\":\"A000009503\",\"eventId\":null,\"distributorName\":\"Ceema Films FZCO\"},{\"id\":\"HO00008431\",\"title\":{\"text\":\"Mardaani 3\",\"translations\":[]},\"synopsis\":{\"text\":\"The blockbuster Mardaani franchise has received unanimous love from people and has attained a cult status amongst cine-lovers. Mardaani 3 will see Rani Mukerji reprise the role of a daredevil cop, Shivani Shivaji Roy, who selflessly fights for justice. This film will be a bloody, violent clash between Shivani’s goodness vs sinister evil forces as she begins an extraordinary race against time to hunt and rescue scores of missing girls of the country.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Mardaani 3 will see Rani Mukerji reprise the role of a daredevil cop, Shivani Shivaji Roy, who selflessly fights for justice. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong threat, violence, injury detail, sexual threat\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":130,\"trailerUrl\":\"https://www.youtube.com/watch?v=V4TJKSEftkU\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000714\",\"roles\"