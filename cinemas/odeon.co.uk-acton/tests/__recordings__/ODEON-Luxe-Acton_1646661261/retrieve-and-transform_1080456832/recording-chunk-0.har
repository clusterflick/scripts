26-07-15T00:31:00+01:00\",\"filmStartsAt\":\"2026-07-14T22:55:00+01:00\",\"filmEndsAt\":\"2026-07-15T00:31:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"995-5-108\",\"filmId\":\"HO00008912\",\"siteId\":\"995\",\"screenId\":\"995-5\",\"areaCategories\":[{\"areaCategoryId\":\"995-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"995-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"995-0000000018\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"995-0000000021\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000174\",\"0000000208\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"995\",\"name\":{\"text\":\"Acton\",\"translations\":[]},\"location\":{\"latitude\":51.5258,\"longitude\":-0.2811},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Royale Leisure Park\",\"line2\":\"Kendal Avenue\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00001947\",\"title\":{\"text\":\"Zog + Zog and the Flying Doctors\",\"translations\":[]},\"synopsis\":{\"text\":\"As Zog, Pearl, and Gadabout begin a new series of adventures on CBeebies, revisit how they first came to take flight with this special cinema double bill of the original two animated specials. In Zog, meet the clumsy but keen young dragon as he begins his training at Dragon School. Tasked with capturing a princess, could it be that the girl who so kindly treats his bumps and bruises is exactly who he’s been looking for? Then in Zog and the Flying Doctors, Zog’s newly formed team with Princess Pearl and Gadabout travel the land to treat all kinds of creatures, real and mythical, including a mermaid, unicorn and lion.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"As Zog, Pearl, and Gadabout begin a new series of adventures on CBeebies, revisit how they first came to take flight with this special cinema double bill of the original \",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-05\",\"runtimeInMinutes\":53,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000006445\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016173\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019165\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019166\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019167\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019168\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019169\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"2537\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"15e3cd5a-c75d-45a4-a367-93973469f2c7\",\"corporateId\":null},\"hopk\":\"HO00001947\",\"hoCode\":\"A000002231\",\"eventId\":null,\"distributorName\":\"Magic Light Pictures\"},{\"id\":\"HO00008218\",\"title\":{\"text\":\"Toy Story 5\",\"translations\":[]},\"synopsis\":{\"text\":\"The toys are back in Disney and Pixar’s “Toy Story 5,” and this time around it’s Toy meets Tech. Buzz, Woody, Jessie and the rest of the gang’s jobs get exponentially harder when they go head to head with this all-new threat to playtime.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The toys are back in Disney and Pixar’s “Toy Story 5,” and this time around it’s Toy meets Tech. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-19\",\"runtimeInMinutes\":102,\"trailerUrl\":\"https://www.youtube.com/watch?v=RFm6wN7IhtY\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002721\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002933\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004242\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009613\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010641\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017418\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017419\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"7850\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000222\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002742\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e4e53d03-846a-4c4b-a95f-af4af0f815b4\",\"corporateId\":null},\"hopk\":\"HO00008218\",\"hoCode\":\"A000009312\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008246\",\"title\":{\"text\":\"Project Hail Mary\",\"translations\":[]},\"synopsis\":{\"text\":\"Science teacher Ryland Grace (Ryan Gosling) wakes up on a spaceship light years from home with no recollection of who he is or how he got there. As his memory returns, he begins to uncover his mission: solve the riddle of the mysterious substance causing the sun to die out. He must call on his scientific knowledge and unorthodox ideas to save everything on Earth from extinction… but an unexpected friendship means he may not have to do it alone.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Science teacher Ryland Grace (Ryan Gosling) wakes up on a spaceship light years from home with no recollection of who he is or how he got there.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate threat, rude humour, drug references, implied strong language\",\"translations\":[]},\"releaseDate\":\"2026-03-19\",\"runtimeInMinutes\":156,\"trailerUrl\":\"https://www.youtube.com/watch?v=NJGdoaI2VKY\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000556\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000557\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000910\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002808\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010992\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017480\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017481\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017482\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000263\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001953\",\"roles\":[\"Actor\",\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000045\"],\"externalIds\":{\"moviexchangeReleaseId\":\"d6d9381c-63a6-4a6e-8cf1-4989e69890c2\",\"corporateId\":null},\"hopk\":\"HO00008246\",\"hoCode\":\"A000009340\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008413\",\"title\":{\"text\":\"Supergirl\",\"translations\":[]},\"synopsis\":{\"text\":\"When an unexpected and ruthless adversary strikes too close to home, Kara Zor-El, aka Supergirl, reluctantly joins forces with an unlikely companion on an epic, interstellar journey of vengeance and justice.\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It follows Kara Zor-El's story and her darker origin before she finally made her way to Earth.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-25\",\"runtimeInMinutes\":108,\"trailerUrl\":\"https://www.youtube.com/watch?v=wxTiyxH9eZw\",\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007748\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014392\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017778\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001118\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001286\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001846\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002429\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002629\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000001\",\"0000000003\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dbd619f1-56eb-431b-8c89-2eb427edd34f\",\"corporateId\":null},\"hopk\":\"HO00008413\",\"hoCode\":\"A000009517\",\"eventId\":null,\"distributorName\":\"WARNER BROS DISTRIBUTORS LTD\"},{\"id\":\"HO00008415\",\"title\":{\"text\":\"Moana\",\"translations\":[]},\"synopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyages beyond the reef of her island of Motunui with the infamous demigod Maui (Dwayne Johnson) on an unforgettable journey to restore prosperity to her people. The film is directed by Emmy® and Tony Award® winner Thomas Kail (“Hamilton”); produced by Dwayne Johnson, Dany Garcia, Beau Flynn, Hiram Garcia and Lin-Manuel Miranda; and executive produced by Thomas Kail, Scott Sheldon, Charles Newirth and Auliʻi Cravalho, who voiced Moana in the animated features “Moana” and “Moana 2.”\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyage\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=zQjHSoVCQLs\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000117\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001075\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009582\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016273\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017779\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017780\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000102\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000113\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000114\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001036\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"6d579a6e-0609-4ead-992c-190cf5e0fd6f\",\"corporateId\":null},\"hopk\":\"HO00008415\",\"hoCode\":\"A000009519\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008468\",\"title\":{\"text\":\"Disclosure Day\",\"translations\":[]},\"synopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming close to … Disclosure Day.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate threat, violence, injury detail, infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-06-10\",\"runtimeInMinutes\":145,\"trailerUrl\":\"https://www.youtube.com/watch?v=WnW25gFk2Mk\",\"displayPriority\":9,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000219\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000635\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010990\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000216\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000318\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001974\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002474\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"1f2756b4-b117-4f07-b240-55d7611c2d78\",\"corporateId\":null},\"hopk\":\"HO00008468\",\"hoCode\":\"A000009576\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008565\",\"title\":{\"text\":\"Minions & Monsters\",\"translations\":[]},\"synopsis\":{\"text\":\"Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe with a riotous new chapter, featuring all-new characters, in the biggest global animated franchise in history: Minions & Monsters.\\n\\nThis is the rambunctious, ridiculous and totally true story of how the Minions conquered Hollywood, became movie stars, lost everything, unleashed monsters onto the world and then banded together to try and save the planet from the mayhem they had just created.\\n\\nMinions & Monsters is directed by Academy Award® nominee Pierre Coffin, a director of the first three Despicable Me films and the first Minions film. Coffin has also provided the voice for the Minions since their film debut in 2010. The film is written by Brian Lynch (Minions, The Secret Life of Pets films) and Pierre Coffin and is produced by Illumination’s Academy Award® nominated founder and CEO Chris Meledandri and by Bill Ryan (executive producer, The Super Mario Bros. Movie). The executive producer is Brian Lynch.\\n\\nMore than ten years after their creation, the Minions have become the most iconic animated characters of their generation. Globally recognised and beloved by fans of all ages, they have propelled Illumination’s Despicable Me and Minions to a global box office of more than $5.6 billion.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe \",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":{\"text\":\"very mild comic violence, threat, rude humour\",\"translations\":[]},\"releaseDate\":\"2026-07-01\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=drr0on3W0K8\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002922\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017409\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018101\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"18969\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000015\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000542\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001046\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"HO00001049\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001410\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"1051448b-9ebc-4ce8-b9e7-c007182dbdca\",\"corporateId\":null},\"hopk\":\"HO00008565\",\"hoCode\":\"A000009677\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008744\",\"title\":{\"text\":\"Obsession\",\"translations\":[]},\"synopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for but soon discovers that some desires come at a dark, sinister price.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong violence, gore\",\"translations\":[]},\"releaseDate\":\"2026-05-15\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=fWLaCC8L6Jo\",\"displayPriority\":10,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002047\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006579\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018515\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018516\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018517\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018518\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018519\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018520\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000018521\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a6a25d26-497a-4daa-a5ff-b5fc9719faca\",\"corporateId\":null},\"hopk\":\"HO00008744\",\"hoCode\":\"A000009874\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008912\",\"title\":{\"text\":\"Scary Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"Twenty-six years after outrunning a suspiciously familiar masked killer (“Ghostface”), the Core Four are back in the killer’s crosshairs and no horror movie IP is safe. Marlon Wayans (“Shorty”), Shawn Wayans (“Ray”), Anna Faris (“Cindy”), and Regina Hall (“Brenda”) reunite in Scary Movie alongside returning favorites and fresh faces to slash through reboots, remakes, requels, prequels, sequels, spin-offs, elevated horror, origin stories, anything with the word legacy in it, and every “final chapter” that absolutely isn’t final. Nothing is sacred. No trope survives. Every line gets crossed.  The Wayans are back to cancel the Cancel Culture.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Twenty-six years after outrunning a suspiciously familiar masked killer (“Ghostface”), the Core Four are back in the killer’s crosshairs and no horror movie IP is safe.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, sex references, drug misuse, violence, nudity\",\"translations\":[]},\"releaseDate\":\"2026-06-05\",\"runtimeInMinutes\":96,\"trailerUrl\":\"https://www.youtube.com/watch?v=_4CvRre-Rb8\",\"displayPriority\":13,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004846\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018926\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000018927\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018928\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018929\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018930\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018931\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018932\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018933\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018934\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018935\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018936\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018937\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018938\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018939\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018940\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000018941\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018942\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018943\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001258\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002366\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002485\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5c55d281-233a-49e5-b907-c1728bb2c5c9\",\"corporateId\":null},\"hopk\":\"HO00008912\",\"hoCode\":\"A000010054\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00008964\",\"title\":{\"text\":\"Evil Dead Burn\",\"translations\":[]},\"synopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. After the loss of her husband, a woman seeks solace with her in-laws in their secluded family home. As one by one they are transformed into Deadites—turning the gathering into a family reunion from hell—she comes to discover that the vows she took in life... live on even in death.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. \",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong bloody violence, gore\",\"translations\":[]},\"releaseDate\":\"2026-07-09\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=YYkUkyfjUKg\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000008177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009258\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019021\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019022\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019023\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019024\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000303\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"3c50ff95-67b2-4152-9965-ad2431794116\",\"corporateId\":null},\"hopk\":\"HO00008964\",\"hoCode\":\"A000010114\",\"eventId\":null,\"distributorName\":\"STUDIOCANAL\"},{\"id\":\"HO00009080\",\"title\":{\"text\":\"Alpha\",\"translations\":[]},\"synopsis\":{\"text\":\"Welcome to the newest chapter of the YRF Spy Universe that presents an edgy origin story of a girl raised and built to kill. Alpha is a female-led action film that will take you on a fun, edge of the seat, thrilling ride that is designed as an out and out entertainer. \\n\\nYash Raj Films presents Alpha, starring Alia Bhatt, Sharvari, Anil Kapoor, and Bobby Deol. Produced by Aditya Chopra and directed by Shiv Rawail, acclaimed for the globally celebrated series The Railway Men, Alpha is set to release in theatres worldwide on July 3, 2026.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Welcome to the newest chapter of the YRF Spy Universe that presents an edgy origin story of a girl raised and built to kill. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":141,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004713\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019336\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019337\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000502\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000856\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002020\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"67ed5047-d1b1-4f4e-83f8-6d4db9b74731\",\"corporateId\":null},\"hopk\":\"HO00009080\",\"hoCode\":\"A000010238\",\"eventId\":null,\"distributorName\":\"YASH RAJ FILMS LTD\"},{\"id\":\"HO00009102\",\"title\":{\"text\":\"Welcome to the Jungle\",\"translations\":[]},\"synopsis\":{\"text\":\"Directed by Ahmed Khan, the third instalment of the Welcome franchise promises larger-than-life chaos, jungle madness, and nostalgic comedy.\\n\\nOne of Bollywood’s biggest comedy entertainers of the year. Packed with over-the-top humour, quirky moments, and a massive ensemble cast, the teaser hints at a complete roller coaster ride filled with madness, confusion, and the trademark chaos that made the Welcome franchise a fan favourite.\\n\\nAlso referred to as Welcome 3, the film marks the grand return of the beloved slapstick comedy franchise that began with the cult 2007 hit Welcome. This time, however, the makers are taking the story in a completely new direction by shifting the setting from urban chaos to a large-scale jungle adventure. Blending action, comedy, and survival-style madness, the film aims to offer audiences a fresh take while retaining the franchise’s signature comic energy.\\n\\nProduced by Firoz A. Nadiadwala under the banner of Base Industries Group and directed by Ahmed Khan, Welcome To The Jungle is being mounted on a massive scale. Reports suggest that the film involves an extensive technical crew and elaborate production design to execute its high-octane action-comedy sequences set in dense jungle landscapes.\\n\\nOne of the biggest highlights of the film is undoubtedly its star-studded cast. Akshay Kumar returns to the franchise after missing the second installment, leading an ensemble featuring Sanjay Dutt, Suniel Shetty, Arshad Warsi, Paresh Rawal, Raveena Tandon, Lara Dutta, Jacqueline Fernandez, Disha Patani, Tusshar Kapoor, among others. The comedy quotient is further elevated with performers like Johnny Lever, Rajpal Yadav, Krushna Abhishek, and Kiku Sharda adding to the madness.\\n\\nThe teaser has already sparked excitement among fans of the franchise, especially those eager to see the return of the classic Welcome brand of humour. With its ambitious scale, nostalgic callbacks, and one of the largest ensemble casts in recent Bollywood history, Welcome To The Jungle is shaping up to be a major theatrical entertainer that aims to revive the charm of the original while introducing a fresh adventure-driven twist.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Directed by Ahmed Khan, the third instalment of the Welcome franchise promises larger-than-life chaos, jungle madness, and nostalgic comedy.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-26\",\"runtimeInMinutes\":163,\"trailerUrl\":\"https://www.youtube.com/watch?v=R704yP3dlXw\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004526\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006280\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019401\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019402\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000494\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001360\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001495\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000006\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"57db58a9-8c83-4d0a-a2f1-f183a63f5b50\",\"corporateId\":null},\"hopk\":\"HO00009102\",\"hoCode\":\"A000010264\",\"eventId\":null,\"distributorName\":\"Bakrania Media Limited\"},{\"id\":\"HO00009124\",\"title\":{\"text\":\"Life Support\",\"translations\":[]},\"synopsis\":{\"text\":\"Since October 2023, Gaza has been sealed from the world-except for one group. While journalists are barred and governments look away, international doctors breach the blockade, walking into a nightmare of Israel's making. What they find is not just a humanitarian crisis, but a calculated dismantling of life itself. Intercutting between interviews, doctors' video diaries from Gaza and original material shot by Palestinian journalists in Gaza, the film delves into the daily struggles of these medical professionals as they navigate bombed-out hospitals, dwindling supplies, and the overwhelming influx of casualties- predominantly women and children. Their firsthand accounts provide a rare and vital perspective on the human cost of the conflict, offering a counter-narrative to the official stories propagated by state actors and their media outlets. The film explores the doctors' motivations for going to Gaza, their moral dilemmas in the face of unimaginable suffering. The chronicles they offer highlight the broader implications of their work as they become de facto journalists and human rights advocates, documenting the deliberate destruction of the health-care system and Israel's attempt to erase Gaza's present and make its future impossible. The doctors' testimonies also highlight the extraordinary resolve of a people determined to uphold their rights and dignity in the face of almost complete silence from the international community.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Since October 2023, Gaza has been sealed from the world-except for one group. International doctors breach the blockade, what they find is not just a humanitarian crisis.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong injury detail, images of real dead bodies, distressing scenes\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":93,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000019425\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019426\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019427\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019428\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019429\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019430\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019431\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019432\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019433\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019434\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019435\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019436\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019437\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000008\"],\"externalIds\":{\"moviexchangeReleaseId\":\"fb31559b-820a-406e-89bf-4a9a26f4e490\",\"corporateId\":null},\"hopk\":\"HO00009124\",\"hoCode\":\"A000010288\",\"eventId\":null,\"distributorName\":\"Dartmouth Films LTD\"},{\"id\":\"HO00009154\",\"title\":{\"text\":\"Dhamaal 4\",\"translations\":[]},\"synopsis\":{\"text\":\"The ‘Dhamaal’ boys are back and ready to chase the \\\"Treasure of Life,\\\" facing crazy challenges along the way. What starts as a treasure hunt quickly turns into a rollercoaster of hilarious misadventures.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The ‘Dhamaal’ boys are back and ready to chase the \\\"Treasure of Life,\\\" facing crazy challenges along the way. \",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate violence, threat, suicide references\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":143,\"trailerUrl\":\"https://www.youtube.com/watch?v=IG-eByZdz6Y\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003455\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005393\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007075\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000007076\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014254\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015945\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019496\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019497\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019498\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019499\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019500\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000711\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000712\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000860\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001415\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002802\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002890\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000006\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"3ce370f1-759f-49a4-8efc-e212cc8409c9\",\"corporateId\":null},\"hopk\":\"HO00