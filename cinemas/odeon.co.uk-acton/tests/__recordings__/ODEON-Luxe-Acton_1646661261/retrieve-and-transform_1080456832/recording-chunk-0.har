mEndsAt\":\"2026-02-07T22:46:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"995-8-76\",\"filmId\":\"HO00008361\",\"siteId\":\"995\",\"screenId\":\"995-8\",\"areaCategories\":[{\"areaCategoryId\":\"995-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"995-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"995-0000000018\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"995-0000000021\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000174\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"995\",\"name\":{\"text\":\"Acton\",\"translations\":[]},\"location\":{\"latitude\":51.5258,\"longitude\":-0.2811},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Royale Leisure Park\",\"line2\":\"Kendal Avenue\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007906\",\"title\":{\"text\":\"Pets on a Train\",\"translations\":[]},\"synopsis\":{\"text\":\"When a train unexpectedly starts up, taking only pets with it, the animals discover that Hans, a badger with a grudge is behind it all. While the crash seems inevitable, the animals can count on Falcon, a roguish Raccoon who will do anything to save them.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When a train unexpectedly starts up, taking only pets with it, the animals discover that Hans, a badger with a grudge is behind it all. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat, violence\",\"translations\":[]},\"releaseDate\":\"2025-10-17\",\"runtimeInMinutes\":87,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007897\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011289\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016735\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016736\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016737\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016738\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016739\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016740\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016741\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016742\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"3418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3421\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"935c9fba-f565-4c62-b794-11566b818ecc\",\"corporateId\":null},\"hopk\":\"HO00007906\",\"hoCode\":\"A000008977\",\"eventId\":null,\"distributorName\":\"ALTITUDE\"},{\"id\":\"HO00008201\",\"title\":{\"text\":\"GOAT\",\"translations\":[]},\"synopsis\":{\"text\":\"From Sony Pictures Animation, the studio behind Spider-Man TM: Across the Spider-Verse and the artists that made KPop Demon Hunters, comes GOAT, an original action-comedy set in an all-animal world. The story follows Will, a small goat with big dreams who gets a once-in-a-lifetime shot to join the pros and play roarball–a high-intensity, co-ed, full-contact sport dominated by the fastest, fiercest animals in the world. Will’s new teammates aren’t thrilled about having a little goat on their roster, but Will is determined to revolutionize the sport and prove once and for all that “smalls can ball!”\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Sony Pictures Animation, the studio behind Spider-Man TM: Across the Spider-Verse and the artists that made KPop Demon Hunters, comes GOAT, an original action-comedy\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild violence, rude humour, language\",\"translations\":[]},\"releaseDate\":\"2026-02-13\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=kmY-rYS7yng\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000119\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002189\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006525\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009120\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011153\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011459\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017374\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017375\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017376\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017377\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017378\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017379\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017380\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017381\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017382\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017383\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017384\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"9353\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000017\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001297\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"fd3ddcc6-e405-4e1f-89d5-5330b8b46da1\",\"corporateId\":null},\"hopk\":\"HO00008201\",\"hoCode\":\"A000009293\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008310\",\"title\":{\"text\":\"Send Help\",\"translations\":[]},\"synopsis\":{\"text\":\"Two colleagues become stranded on a deserted island, the only survivors of a plane crash. On the island, they must overcome past grievances and work together to survive, but ultimately, it's a battle of wills and wits to make it out alive.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Two colleagues become stranded on a deserted island, the only survivors of a plane crash. On the island, they must overcome past grievances and work together to survive. \",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-05\",\"runtimeInMinutes\":113,\"trailerUrl\":\"https://www.youtube.com/watch?v=NwR6J0W4XN0\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000005399\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008617\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009978\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000303\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001664\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001891\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"d6fe525e-3f8f-4e06-ba6b-7bcad91081ff\",\"corporateId\":null},\"hopk\":\"HO00008310\",\"hoCode\":\"A000009406\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008356\",\"title\":{\"text\":\"Stray Kids: The dominATE Experience\",\"translations\":[]},\"synopsis\":{\"text\":\"Featuring the global K-Pop sensation Stray Kids and a live performance from their record-breaking world tour, alongside exclusive behind-the-scenes footage and intimate interviews with the band, Stray Kids: The dominATE Experience is an epic concert film that gives fans both a spectacular front-row seat and unique access to their favourite band.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Featuring the global K-Pop sensation Stray Kids and a live performance from their record-breaking world tour, alongside exclusive behind-the-scenes footage.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-06\",\"runtimeInMinutes\"