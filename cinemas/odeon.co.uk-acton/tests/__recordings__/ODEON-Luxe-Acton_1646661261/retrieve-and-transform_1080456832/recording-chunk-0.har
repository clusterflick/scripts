{\"castAndCrewMemberId\":\"HO00000349\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000696\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002427\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000010\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a4cb369f-77c4-4fe1-8f85-dd5e76b195dd\",\"corporateId\":null},\"hopk\":\"HO00007533\",\"hoCode\":\"A000008563\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008012\",\"title\":{\"text\":\"The Housemaid\",\"translations\":[]},\"synopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous — a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, sex, sexual violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-12-22\",\"runtimeInMinutes\":131,\"trailerUrl\":\"https://www.youtube.com/watch?v=kdDdlY2VPxw\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000009161\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012707\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016976\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016977\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000031\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000135\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000814\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001305\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dc7be94d-5ba5-4a79-accd-48ed4d19a3b6\",\"corporateId\":null},\"hopk\":\"HO00008012\",\"hoCode\":\"A000009092\",\"eventId\":null,\"distributorName\":\"LIONSGATE INTERNATIONAL\"},{\"id\":\"HO00008080\",\"title\":{\"text\":\"Hamnet\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"distressing scenes, brief moderate sex\",\"translations\":[]},\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":126,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003903\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011027\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017134\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000116\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000321\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000322\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001794\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001974\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000005\"],\"externalIds\":{\"moviexchangeReleaseId\":\"37b2b94f-65a0-481e-9d3c-bde2445c99a4\",\"corporateId\":null},\"hopk\":\"HO00008080\",\"hoCode\":\"A000009165\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008101\",\"title\":{\"text\":\"Marty Supreme\",\"translations\":[]},\"synopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, sex, nudity, injury detail, violence\",\"translations\":[]},\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":150,\"trailerUrl\":\"https://www.youtube.com/watch?v=s9gSuKaKcqM\",\"displayPriority\":7,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001370\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012950\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014188\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014753\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017170\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017171\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"17172\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17173\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17174\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"2227\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000258\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"90e71dd1-a916-4807-8aff-0dd9f141e72d\",\"corporateId\":null},\"hopk\":\"HO00008101\",\"hoCode\":\"A000009187\",\"eventId\":null,\"distributorName\":\"ENTERTAINMENT FILM DISTRIBUTOR\"},{\"id\":\"HO00008159\",\"title\":{\"text\":\"Dhurandhar\",\"translations\":[]},\"synopsis\":{\"text\":\"Dhurandhar is a star-studded saga inspired by incredible true events set in the gritty criminal vein of underworld with a backdrop of Indian patriotism, featuring action sequences, Shakespearean betrayals, and tradecrafts of espionage.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Dhurandhar is a star-studded saga inspired by incredible true events set in the gritty criminal vein of underworld with a backdrop of Indian patriotism.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2025-12-05\",\"runtimeInMinutes\":212,\"trailerUrl\":\"https://www.youtube.com/watch?v=rZ_e-s6VvR4\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000689\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004098\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005755\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006258\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007370\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011423\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000011424\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017116\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017292\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017293\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017294\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001386\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000020\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"917d3e2c-26cb-42b2-b68f-0994d524ec24\",\"corporateId\":null},\"hopk\":\"HO00008159\",\"hoCode\":\"A000009249\",\"eventId\":null,\"distributorName\":\"Moviegoers Entertainment Ltd\"},{\"id\":\"HO00008177\",\"title\":{\"text\":\"Giant\",\"translations\":[]},\"synopsis\":{\"text\":\"Based on the remarkable true story of legendary British-Yemeni boxing champion Prince Naseem \\\"Naz\\\" Hamed and his relationship with Irish boxing trainer Brendan Ingle, GIANT charts Naz’s inspiring rags-to-riches underdog tale from his humble beginnings in Sheffield to becoming champion of the world.\\n\\nWith his unorthodox style, cocky persona and sheer dominance of the sport, Naseem faced down the abhorrent racism and islamophobia that swept Britain in the 80’s and 90’s, to become a global sporting icon, both inside and outside of the ring.\\n\\nThe film explores the unlikely and tender relationship between Naz and his trainer Ingle – a steel industry worker who ran a humble boxing gym in a church hall in the North of England; and the instrumental role that Ingle played on Naz’s road to success. With exhilarating and visceral scenes in the ring, coupled with deeply moving and intimate moments behind the curtain, GIANT is an inspiring biopic of one of the greatest showmen the sporting world has even seen – the untold true story of the boy behind The Prince.\\n\\nPierce Brosnan (James Bond franchise, Mamma Mia!, The Love Punch, Mobland) stars as Brendan Ingle, with Amir El-Masry (The Night Manager, Limbo, The Crown, SAS: Rogue Heroes) playing Naseem Hamed. From executive producer Sylvester Stallone (Rocky, Creed), GIANT is written and directed by film-maker Rowan Athale (Gangs of London).\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The remarkable real-life story of legendary British-Yemeni boxer Prince Naseem \\\"Naz\\\" Hamed.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, discrimination\",\"translations\":[]},\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":110,\"trailerUrl\":\"https://www.youtube.com/watch?v=iUYO2kk1Fek\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000949\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003156\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017331\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017332\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017333\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001836\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000023\"],\"externalIds\":{\"moviexchangeReleaseId\":\"1c43a4ae-d161-4502-9f9e-6ae2973ddcd3\",\"corporateId\":null},\"hopk\":\"HO00008177\",\"hoCode\":\"A000009268\",\"eventId\":null,\"distributorName\":\"True Brit Entertainment LTD\"},{\"id\":\"HO00008189\",\"title\":{\"text\":\"28 Years Later: The Bone Temple\",\"translations\":[]},\"synopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later: The Bone Temple. In a continuation of the epic story, Dr. Kelson (Ralph Fiennes) finds himself in a shocking new relationship - with consequences that could change the world as they know it - and Spike's (Alfie Williams) encounter with Jimmy Crystal (Jack O'Connell) becomes a nightmare he can't escape. In the world of The Bone Temple, the infected are no longer the greatest threat to survival - the inhumanity of the survivors can be stranger and more terrifying.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong gory violence, injury detail, very strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-14\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=wyYliP8dPWU\",\"displayPriority\":9,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000097\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000442\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002404\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002653\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005575\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014011\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014577\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017356\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000576\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"12790418-6492-492a-814c-53673bc1ab1a\",\"corporateId\":null},\"hopk\":\"HO00008189\",\"hoCode\":\"A000009281\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008193\",\"title\":{\"text\":\"Mercy\",\"translations\":[]},\"synopsis\":{\"text\":\"In the near future, a detective (Chris Pratt) stands on trial accused of murdering his wife. He has 90 minutes to prove his innocence to the advanced A.I. Judge (Rebecca Ferguson) he once championed, before it determines his fate.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In the near future, a detective (Chris Pratt) stands on trial accused of murdering his wife. He has 90 minutes to prove his innocence to the advanced A.I. Judge.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate violence, threat, injury detail, drug misuse, strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=sN-C09dfczY\",\"displayPriority\":12,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003235\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000009008\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017362\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017363\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017364\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000086\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000825\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000982\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001684\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002432\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"eea3fe00-3e2b-4dcc-9150-aedd76790a42\",\"corporateId\":null},\"hopk\":\"HO00008193\",\"hoCode\":\"A000009285\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008222\",\"title\":{\"text\":\"Saipan\",\"translations\":[]},\"synopsis\":{\"text\":\"SAIPAN explores the explosive clash between soccer star Roy Keane and manager Mick McCarthy before the 2002 FIFA World Cup. Their feud, rooted in clashing standards and personalities, erupted on the island of Saipan, shaking the Irish team and nation. As Keane walked out, McCarthy faced chaos. This gripping true story goes beyond sport, it’s a dramatic, often comic tale of leadership, loyalty, and a rivalry that captured global attention.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"SAIPAN explores the explosive clash between soccer star Roy Keane and manager Mick McCarthy before the 2002 FIFA World Cup.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"very strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=s4TzwHPsq_s\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000111\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000000112\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012549\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017369\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017420\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017421\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"15f1abd4-8ed9-44f9-bb19-c7de8145ff5e\",\"corporateId\":null},\"hopk\":\"HO00008222\",\"hoCode\":\"A000009316\",\"eventId\":null,\"distributorName\":\"VERTIGO RELEASING LIMITED\"},{\"id\":\"HO00008325\",\"title\":{\"text\":\"Return to Silent Hill\",\"translations\":[]},\"synopsis\":{\"text\":\"When a mysterious letter calls him back to Silent Hill in search of his lost love, James finds a once-recognizable town and encounters terrifying figures both familiar and new, and begins to question his own sanity.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When a mysterious letter calls him back to Silent Hill in search of his lost love, James finds a once-recognizable town and encounters terrifying figures.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong horror, gore, language\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":105,\"trailerUrl\":null,\"displayPriority\":11,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003901\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004117\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012885\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012886\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017616\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017617\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017618\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"0004c65f-7fef-466d-afe4-7bab15b10fa6\",\"corporateId\":null},\"hopk\":\"HO00008325\",\"hoCode\":\"A000009423\",\"eventId\":null,\"distributorName\":\"ENTERTAINMENT FILM DISTRIBUTOR\"},{\"id\":\"HO00008390\",\"title\":{\"text\":\"Iron Lung\",\"translations\":[]},\"synopsis\":{\"text\":\"The stars are gone. The planets have disappeared. Only individuals aboard space stations or starships were left to give the end a name - The Quiet Rapture. After decades of decay and crumbling infrastructure, the Consolidation of Iron has made a discovery on a barren moon designated AT-5. An ocean of blood.\\u2028 Hoping to discover desperately needed resources they immediately launch an expedition. A submarine is crafted and a convict is welded inside. Due to the pressure and depth of the ocean the forward viewport has been encased in metal. If successful, they will earn their freedom. If not, another will follow. This will be the 13th expedition.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The stars are gone. The planets have disappeared. Only those on space stations or starships were left to give the end a name. The Quiet Rapture. The universe dims.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, bloody images, threat\",\"translations\":[]},\"releaseDate\":\"2026-01-29\",\"runtimeInMinutes\":125,\"trailerUrl\":null,\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000017729\",\"roles\":[\"Actor\",\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000014\",\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4187d757-ba5e-42e9-9ba3-f3aa56e6b45f\",\"corporateId\":null},\"hopk\":\"HO00008390\",\"hoCode\":\"A000009492\",\"eventId\":null,\"distributorName\":\"(New) Iron Lung Inc\"},{\"id\":\"HO00008395\",\"title\":{\"text\":\"Border 2\",\"translations\":[]},\"synopsis\":{\"text\":\"During the events of the 1971 Indo-Pak war, a new generation of young Indian warriors were getting ready to defend the nation from an even bigger threat to the Indian motherland.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"During the events of the 1971 Indo-Pak war, a new generation of young Indian warriors were getting ready to defend the nation from an even bigger threat\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":199,\"trailerUrl\":\"https://www.youtube.com/watch?v=nvmc2ECk8Lo\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000133\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000231\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005031\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001128\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002713\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000009\",\"0000000024\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"263d0f31-f2aa-489e-b8db-f1bb8f88a009\",\"corporateId\":null},\"hopk\":\"HO00008395\",\"hoCode\":\"A000009497\",\"eventId\":null,\"distributorName\":\"AA Films UK LTD\"},{\"id\":\"HO00008400\",\"title\":{\"text\":\"En Ghab El Kot \",\"translations\":[]},\"synopsis\":{\"text\":\"Zain, a quiet art history professor, is mistaken for a famous thief known as \\\"The Cat\\\" due to their uncanny resemblance. When his fiancée Hind is assigned to restore a valuable painting that \\\"The Cat\\\" plans to steal, Zain gets caught in a whirlwind of danger and comedy. While Hind is drawn to the mysterious thief, Zain is tasked with recovering the stolen artwork — leaving her torn between the two men.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The theft of a famous painting from a museum leads to an unexpected conflict between the gang members and the museum staff.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":100,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000012604\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012605\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017120\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017751\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017752\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000001\",\"0000000006\"],\"externalIds\":{\"moviexchangeRel