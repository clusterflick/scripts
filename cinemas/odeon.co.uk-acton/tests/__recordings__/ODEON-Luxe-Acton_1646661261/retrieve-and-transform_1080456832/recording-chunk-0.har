            "text": "{\"businessDate\":\"2026-07-28\",\"showtimes\":[{\"id\":\"995-61124\",\"schedule\":{\"businessDate\":\"2026-07-28\",\"startsAt\":\"2026-07-28T19:15:00+01:00\",\"endsAt\":\"2026-07-28T21:10:00+01:00\",\"filmStartsAt\":\"2026-07-28T19:40:00+01:00\",\"filmEndsAt\":\"2026-07-28T21:10:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"995-4-98\",\"filmId\":\"HO00009107\",\"siteId\":\"995\",\"screenId\":\"995-4\",\"areaCategories\":[{\"areaCategoryId\":\"995-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"995-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"995-0000000018\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000187\",\"0000000174\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"995\",\"name\":{\"text\":\"Acton\",\"translations\":[]},\"location\":{\"latitude\":51.5258,\"longitude\":-0.2811},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Royale Leisure Park\",\"line2\":\"Kendal Avenue\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00009107\",\"title\":{\"text\":\"WHAM! 10 Days in China\",\"translations\":[]},\"synopsis\":{\"text\":\"In 1985, WHAM! made history as the first Western pop act to perform in communist China. George Michael and Andrew Ridgeley’s concerts in Beijing and Guangzhou were a cultural milestone – East meets West, music meets politics. Now, newly restored footage reveals the untold story of the iconic tour that helped launch WHAM! to global superstardom.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In 1985, WHAM! crossed cultural divides as the first Western pop act in China. Previously unseen, beautifully restored archive footage reveals this landmark meeting\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote