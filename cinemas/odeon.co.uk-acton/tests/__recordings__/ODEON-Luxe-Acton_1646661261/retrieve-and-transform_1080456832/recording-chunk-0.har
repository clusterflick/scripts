            "text": "{\"businessDate\":\"2026-02-28\",\"showtimes\":[{\"id\":\"995-52989\",\"schedule\":{\"businessDate\":\"2026-02-28\",\"startsAt\":\"2026-02-28T14:00:00+00:00\",\"endsAt\":\"2026-02-28T16:24:00+00:00\",\"filmStartsAt\":\"2026-02-28T14:25:00+00:00\",\"filmEndsAt\":\"2026-02-28T16:24:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"995-7-91\",\"filmId\":\"HO00008387\",\"siteId\":\"995\",\"screenId\":\"995-7\",\"areaCategories\":[{\"areaCategoryId\":\"995-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"995-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"995-0000000018\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"995-0000000021\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000187\",\"0000000174\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"995-52342\",\"schedule\":{\"businessDate\":\"2026-02-28\",\"startsAt\":\"2026-02-28T19:20:00+00:00\",\"endsAt\":\"2026-02-28T21:15:00+00:00\",\"filmStartsAt\":\"2026-02-28T19:45:00+00:00\",\"filmEndsAt\":\"2026-02-28T21:15:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"995-7-82\",\"filmId\":\"HO00008319\",\"siteId\":\"995\",\"screenId\":\"995-7\",\"areaCategories\":[{\"areaCategoryId\":\"995-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"995-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"995-0000000018\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"995-0000000021\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000174\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"995\",\"name\":{\"text\":\"Acton\",\"translations\":[]},\"location\":{\"latitude\":51.5258,\"longitude\":-0.2811},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Royale Leisure Park\",\"line2\":\"Kendal Avenue\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008319\",\"title\":{\"text\":\"EPiC: Elvis Presley in Concert\",\"translations\":[]},\"synopsis\":{\"text\":\"Elvis sings and tells his story like never before in a new cinematic experience from visionary filmmaker Baz Luhrmann.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Elvis sings and tells his story like never before in a new cinematic experience from visionary filmmaker Baz Luhrmann.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate bad language, sex references, drug references\",\"translations\":[]},\"releaseDate\":\"2026-02-20\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=V4rLM1k1nKY\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001522\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000005483\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017604\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017605\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017606\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001900\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"29586d46-5172-4706-aca2-77fc2b4810c9\",\"corporateId\":null},\"hopk\":\"HO00008319\",\"hoCode\":\"A000009416\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008387\",\"title\":{\"text\":\"Twenty One Pilots: More Than We Ever Imagined\",\"translations\":[]},\"synopsis\":{\"text\":\"Experience the electrifying concert film capturing Twenty One Pilots at a career-defining moment: their monumental Mexico City headline show, performing in front of 65,000 fans at Estadio GNP Seguros during The Clancy World Tour. \\n\\nSet against the vibrant pulse of one of the world’s most iconic music capitals, the film blends cinematic high-energy performance footage with intimate, behind-the-scenes access, revealing the heart, humor, and humanity of the artists as they prepare for one of the biggest shows of their career. \\n\\nViewers follow the band from their arrival in Mexico City to the stage, sharing in the preparation and anticipation that build as showtime approaches. Exclusive commentary from Tyler and Josh offer personal reflections on the journey that brought them to this historic stage and the deep connection with their fans who make it all possible.\\n\\nThe film pulls audiences into the full spectacle of the night. Sweeping aerials of the stadium, on-stage cameras, and crowd-level shots place viewers right at the center of the experience, seeing the show from every angle.  The result is a thrilling, emotional celebration of music, community, and achievement - an unforgettable portrait of Twenty One Pilots, performing a show that will echo through their legacy.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Experience the electrifying concert film capturing Twenty One Pilots at a career-defining moment: their monumental Mexico City headline show.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-25\",\"runtimeInMinutes\":119,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000005569\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005570\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013680\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017715\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017716\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017717\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017718\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a81251d1-868e-4b61-bbc3-6f1257804775\",\"corporateId\":null},\"hopk\":\"HO00008387\",\"hoCode\":\"A000009489\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000001522\",\"name\":{\"givenName\":\"Baz\",\"familyName\":\"Luhrmann\",\"middleName\":null}},{\"id\":\"0000005483\",\"name\":{\"givenName\":\"Schuyler\",\"familyName\":\"Weiss\",\"middleName\":null}},{\"id\":\"0000017604\",\"name\":{\"givenName\":\"Jeremy\",\"familyName\":\"Castro\",\"middleName\":null}},{\"id\":\"0000017605\",\"name\":{\"givenName\":\"Matthew\",\"familyName\":\"Gross\",\"middleName\":null}},{\"id\":\"0000017606\",\"name\":{\"givenName\":\"Colin\",\"familyName\":\"Smeeton\",\"middleName\":null}},{\"id\":\"HO00001900\",\"name\":{\"givenName\":\"Elvis\",\"familyName\":\"Presley\",\"middleName\":null}},{\"id\":\"0000005569\",\"name\":{\"givenName\":\"Tyler\",\"familyName\":\"Joseph\",\"middleName\":null}},{\"id\":\"0000005570\",\"name\":{\"givenName\":\"Josh\",\"familyName\":\"Dun\",\"middleName\":null}},{\"id\":\"0000013680\",\"name\":{\"givenName\":\"Devin\",\"familyName\":\"Dehaven\",\"middleName\":null}},{\"id\":\"0000017715\",\"name\":{\"givenName\":\"Mark\",\"familyName\":\"Eshleman\",\"middleName\":null}},{\"id\":\"0000017716\",\"name\":{\"givenName\":\"Nathan\",\"familyName\":\"Bielski\",\"middleName\":null}},{\"id\":\"0000017717\",\"name\":{\"givenName\":\"Aldo\",\"familyName\":\"Ballesteros\",\"middleName\":null}},{\"id\":\"0000017718\",\"name\":{\"givenName\":\"Chris\",\"familyName\":\"Woltman\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000055\",\"name\":{\"text\":\"Music\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000001\",\"classification\":{\"text\":\"12A\",\"translations\":[]},\"classificationDescription\":{\"text\":\"12A with Parental Guidance\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":