ing\":35,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1\\\"}\"},{\"id\":\"386878\",\"time\":\"2026-01-18T12:00:00Z\",\"ticketsSold\":12,\"screenId\":\"140\",\"seatsRemaining\":48,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1\\\"}\"},{\"id\":\"386879\",\"time\":\"2026-01-18T17:30:00Z\",\"ticketsSold\":21,\"screenId\":\"140\",\"seatsRemaining\":39,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1\\\"}\"},{\"id\":\"386886\",\"time\":\"2026-01-19T12:00:00Z\",\"ticketsSold\":6,\"screenId\":\"140\",\"seatsRemaining\":54,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1\\\"}\"},{\"id\":\"386887\",\"time\":\"2026-01-19T17:30:00Z\",\"ticketsSold\":11,\"screenId\":\"140\",\"seatsRemaining\":49,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1\\\"}\"},{\"id\":\"386900\",\"time\":\"2026-01-20T20:00:00Z\",\"ticketsSold\":12,\"screenId\":\"140\",\"seatsRemaining\":48,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1\\\"}\"},{\"id\":\"386903\",\"time\":\"2026-01-21T12:10:00Z\",\"ticketsSold\":2,\"screenId\":\"140\",\"seatsRemaining\":58,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1\\\"}\"},{\"id\":\"386904\",\"time\":\"2026-01-21T20:20:00Z\",\"ticketsSold\":0,\"screenId\":\"140\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"hard-of-hearing\\\"}\"},{\"id\":\"386915\",\"time\":\"2026-01-22T12:00:00Z\",\"ticketsSold\":6,\"screenId\":\"141\",\"seatsRemaining\":54,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"387231\",\"time\":\"2026-01-23T12:10:00Z\",\"ticketsSold\":3,\"screenId\":\"141\",\"seatsRemaining\":57,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"387761\",\"time\":\"2026-01-27T17:10:00Z\",\"ticketsSold\":19,\"screenId\":\"141\",\"seatsRemaining\":41,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"387234\",\"time\":\"2026-01-29T14:30:00Z\",\"ticketsSold\":6,\"screenId\":\"140\",\"seatsRemaining\":54,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1\\\"}\"}]},{\"id\":\"17282\",\"name\":\"FUN IN THE LOUNGE - FREE ENTRY: OPEN MIC\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"free-fun-at-the-lounge-open-mic\",\"posterImage\":\"m7x0lx0w2z7hcz1p6zj2a80e39dn\",\"bannerImage\":\"03e90oqz0q1333idlt2kfbqymlb7\",\"synopsis\":\"FREE ENTRY - Please RSVP for free below so we can manage numbers - Donations help us keep our community events free!\\n\\nOur Open Mic Nights take place on the last Thursday of each month, from 8pm. Sign up for performers is from 7:30PM; 10min slots per act.\\n\\nGet notified of all our free events by becoming a member on our Meetup Groups: \\u003ca href=\\\"https://www.meetup.com/west-london-board-games-meetup-group/\\\"\\u003eWest London Board Games\\u003c/a\\u003e and \\u003ca href=\\\"https://www.meetup.com/free-open-mic-jazz-nights-in-west-london/\\\"\\u003eFree Open Mic \\u0026 Jazz Nights in West London\\u003c/a\\u003e!\\n\\nDo you love to perform? What about that two minute comedy sketch you've been writing and want to try out in front of an audience? Whether you write poetry or perform with an instrument, ActOne's Open Mic Night is a warm and welcoming community space in which to experiment, play and meet likeminded individuals who are being brave and putting themselves out there.\\n\\nOur Open Mic Nights are for everyone! We aim to cultivate an atmosphere of energy, enthusiasm and unconditional support, so whether you wish to perform or sit back and be entertained come ready to clap your hands until they're sore!\",\"starring\":null,\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":120,\"genre\":null,\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-01-29\",\"dateOfFirstShowing\":\"2026-01-29\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"37604\",\"dcmEdiMovieName\":\"All The Best - The Fun Begins (2D) [PG]\",\"siteId\":\"93\",\"titleClassId\":\"277\",\"showings\":[{\"id\":\"214730\",\"time\":\"2024-08-29T19:00:00Z\",\"ticketsSold\":19,\"screenId\":\"301\