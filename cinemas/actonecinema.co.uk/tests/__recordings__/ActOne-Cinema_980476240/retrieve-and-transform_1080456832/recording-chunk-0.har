",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392501\",\"time\":\"2026-02-11T12:30:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392502\",\"time\":\"2026-02-11T20:10:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392500\",\"time\":\"2026-02-12T12:30:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392499\",\"time\":\"2026-02-12T20:10:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"}]},{\"id\":\"33908\",\"name\":\"REM x BUSTER KEATON'S SHERLOCK JR\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"rem-x-buster-keatons-sherlock-jr\",\"posterImage\":\"xpz90cvd62n38cc511k3f7ufhsms\",\"bannerImage\":\"t419eiz696jwxm241xm4lbo2v484\",\"synopsis\":\"Buster Keaton’s 1924 comedy classic is reimagined with R.E.M. 's alt-rock masterpieces Monster (1994) and New Adventures in Hi-Fi (1996). In this sublime comedy teetering between reality and illusion, Buster Keaton stars as a film projectionist who dreams of becoming a detective. He uses his limited skills when he is framed by a rival for stealing his girlfriend’s father’s pocket watch.\",\"starring\":\"Buster Keaton, Kathryn McGuire, Joe Keaton\",\"directedBy\":\"Buster Keaton, Josh Frank\",\"producedBy\":\"\",\"searchTerms\":\"\",\"duration\":45,\"genre\":\"Comedy\",\"allGenres\":\"Comedy\",\"rating\":\"12A\",\"trailerYoutubeId\":\"v=otwTXYFHmFc\",\"trailerVideo\":null,\"releaseDate\":\"2026-02-07\",\"dateOfFirstShowing\":\"2026-02-07\",\"tmdbPopularityScore\":0.1724,\"tmdbId\":\"1556179\",\"dcmEdiMovieId\":\"437070\",\"dcmEdiMovieName\":\"R.E.M. X BUSTER KEATON'S SHERLOCK JR. [Unknown]\",\"siteId\":\"93\",\"titleClassId\":\"110\",\"showings\":[{\"id\":\"390177\",\"time\":\"2026-02-07T18:00:00Z\",\"ticketsSold\":0,\"screenId\":\"140\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1\\\"}\"},{\"id\":\"390178\",\"time\":\"2026-02-08T18:00:00Z\",\"ticketsSold\":1,\"screenId\":\"140\",\"seatsRemaining\":59,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1\\\"}\"}]},{\"id\":\"34159\",\"name\":\"BREATHLESS (A BOUT DE SOUFFLE)\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"breathless-a-bout-de-souffle\",\"posterImage\":\"8yu3et8z4f1ve0hipteicqe6ea80\",\"bannerImage\":\"jwx86asb19o6sax40onhu97t3h6t\",\"synopsis\":\"A small-time thief steals a car and impulsively murders a motorcycle policeman. Wanted by the authorities, he attempts to persuade a girl to run away to Italy with him.\",\"starring\":\"Jean-Paul Belmondo, Jean Seberg, Daniel Boulanger\",\"directedBy\":\"Jean-Luc Godard\",\"producedBy\":\"Georges de Beauregard\",\"searchTerms\":\"\",\"duration\":90,\"genre\":\"Documentary\",\"allGenres\":\"Documentary\",\"rating\":\"12A\",\"trailerYoutubeId\":\"fOlDsR4DUfE\",\"trailerVideo\":null,\"releaseDate\":\"2026-02-07\",\"dateOfFirstShowing\":\"2026-02-07\",\"tmdbPopularityScore\":3.6124,\"tmdbId\":\"269\",\"dcmEdiMovieId\":\"148542\",\"dcmEdiMovieName\":\"Breathless (Re: 2020) (2D) [12A]\",\"siteId\":\"93\",\"titleClassId\":\"110\",\"showings\":[{\"id\":\"392519\",\"time\":\"2026-02-07T12:20:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2 subtitled rerelease\\\"}\"},{\"id\":\"392520\",\"time\":\"2026-02-08T14:50:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2 subtitled rerelease\\\"}\"},{\"id\":\"392717\",\"time\":\"2026-02-10T20:00:00Z\",\"ticketsSold\":0,\"screenId\":\"140\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1 subtitled rerelease\\\"}\"},{\"id\":\"392719\",\"time\":\"2026-02-11T14:50:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2 subtitled rerelease\\\"}\"},{\"id\":\"392521\",\"time\":\"2026-02-12T14:50:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2 subtitled rerelease\\\"}\"}]},{\"id\":\"25834\",\"name\":\"ROYAL BALLET LIVE: WOOLF WORKS\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"royal-ballet-live-woolf-works\",\"posterImage\":\"l837et4urpkj9yne7aornbvgrozl\",\"bannerImage\":\"8d2pnieqh62eb667v2li62tmtiva\",\"synopsis\":\"For the full programme of the RBO '25-'26 season and our money-saving Season Passes, please \\u003ca href=\\\"https://www.actonecinema.co.uk/royal-ballet--opera-live\\\"\\u003ego here\\u003c/a\\u003e.\\n\\nBroadcast LIVE from THE ROYAL OPERA HOUSE, for one night only!\\n\\nVirginia Woolf defied literary conventions to depict rich inner worlds – her heightened, startling and poignant reality. Resident Choreographer Wayne McGregor leads a luminous artistic team to evoke Woolf’s signature stream of consciousness writing style in this immense work that rejects traditional narrative structures. Woolf Works is a collage of themes from Mrs Dalloway, Orlando, The Waves and Woolf’s other writings. Created in 2015 for The Royal Ballet, this Olivier-award winning ballet triptych captures the heart of Woolf’s uniquely artistic spirit.\\n\\nRunning time: 210 minutes (To be confirmed)\",\"starring\":\"TBC\",\"directedBy\":\"\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":210,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"9B8DfHdFhvM\",\"trailerVideo\":null,\"releaseDate\":\"2026-02-09\",\"dateOfFirstShowing\":\"2026-02-09\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"62279\",\"dcmEdiMovieName\":\"Alice's Adventures In Wonderland - Royal Ballet 2013 (Ballet) (2D) [Unknown]\",\"siteId\":\"93\",\"titleClassId\":\"398\",\"showings\":[{\"id\":\"317987\",\"time\":\"2026-02-09T19:15:00Z\",\"ticketsSold\":23,\"screenId\":\"140\",\"seatsRemaining\":37,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1 royal-ballet--opera-live no-ads--trailers\\\"}\"}]},{\"id\":\"33078\",\"name\":\"CARERS \\u0026 BABIES: HAMNET\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"carers-babies-hamnet\",\"posterImage\":\"yfsnlsjbaais40xplmf7ax497iw1\",\"bannerImage\":\"8v1l11gji32qw8f8imcdumrtabi0\",\"synopsis\":\"\\u003cb\\u003eThis performance is exclusive to our \\u003ca href=\\\"https://actonecinema.co.uk/carers--babies-club\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\"\\u003eCARERS \\u0026 BABIES CLUB\\u003c/a\\u003e. You must have at least one baby in your party aged 0-12 months old.\\u003c/b\\u003e\\n\\nBreaking hearts and mending them in one fell swoop, HAMNET is one of the most anticipated films of the year! After losing their son Hamnet to plague, Agnes and William Shakespeare grapple with grief in 16th-century England. A healer, Agnes must find strength to care for her surviving children while processing her devastating loss.\\n\\n\\u003cb\\u003e7 Academy Award nominations\\u003c/b\\u003e\\n\\u003cb\\u003e2 Golden Globe wins and 4 nominations\\u003c/b\\u003e\\n\\n★★★★★ - Daily Telegraph\\n★★★★★ - Time Out\\n★★★★★ - The Times\",\"starring\":\"Jessie Buckley, Paul Mescal, Emily Watson\",\"directedBy\":\"Chloé Zhao\",\"producedBy\":\"Steven Spielberg, Sam Mendes, Nicolas Gonda, Pippa Harris, Liza Marshall\",\"searchTerms\":\"\",\"duration\":126,\"genre\":\"Drama\",\"allGenres\":\"Drama, Romance\",\"rating\":\"12A\",\"trailerYoutubeId\":\"Y9Tv9wGPxIw\",\"trailerVideo\":null,\"releaseDate\":\"2026-02-10\",\"dateOfFirstShowing\":\"2026-02-10\",\"tmdbPopularityScore\":48.3736,\"tmdbId\":\"858024\",\"dcmEdiMovieId\":\"468539\",\"dcmEdiMovieName\":\"No Match Found\",\"siteId\":\"93\",\"titleClassId\":\"110\",\"showings\":[{\"id\":\"383097\",\"time\":\"2026-01-13T11:30:00Z\",\"ticketsSold\":23,\"screenId\":\"141\",\"seatsRemaining\":37,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392718\",\"time\":\"2026-02-10T11:30:00Z\",\"ticketsSold\":1,\"screenId\":\"141\",\"seatsRemaining\":59,\"displayMetaData\":\"{\\\"classes\\\":\\\"carers--babies sc2\\\"}\"}]},{\"id\":\"33974\",\"name\":\"WUTHERING HEIGHTS\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"wuthering-heights\",\"posterImage\":\"ix5dezzo082mzhbokfclpj4l907t\",\"bannerImage\":\"353jxqoy7zrlhlcwv999cfad2e3l\",\"synopsis\":\"A passionate and tumultuous love story set against the backdrop of the Yorkshire moors, exploring the intense and destructive relationship between Heathcliff and Catherine Earnshaw.\",\"starring\":\"Margot Robbie, Jacob Elordi, Hong Chau\",\"directedBy\":\"Emerald Fennell\",\"producedBy\":\"Margot Robbie, Tom Ackerley, Emerald Fennell, Josey McNamara\",\"searchTerms\":\"\",\"duration\":136,\"genre\":\"Drama\",\"allGenres\":\"Drama, Romance\",\"rating\":\"tbc\",\"trailerYoutubeId\":\"i39w-wDZZuU\",\"trailerVideo\":null,\"releaseDate\":\"2026-02-13\",\"dateOfFirstShowing\":\"2026-02-13\",\"tmdbPopularityScore\":14.3307,\"tmdbId\":\"1316092\",\"dcmEdiMovieId\":\"\",\"dcmEdiMovieName\":null,\"siteId\":\"93\",\"titleClassId\":\"110\",\"showings\":[{\"id\":\"392398\",\"time\":\"2026-02-13T14:30:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392399\",\"time\":\"2026-02-13T17:20:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392400\",\"time\":\"2026-02-13T20:10:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392401\",\"time\":\"2026-02-14T14:30:00Z\",\"ticketsSold\":7,\"screenId\":\"141\",\"seatsRemaining\":53,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392402\",\"time\":\"2026-02-14T17:20:00Z\",\"ticketsSold\":4,\"screenId\":\"141\",\"seatsRemaining\":56,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392403\",\"time\":\"2026-02-14T20:10:00Z\",\"ticketsSold\":2,\"screenId\":\"141\",\"seatsRemaining\":58,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392404\",\"time\":\"2026-02-15T14:30:00Z\",\"ticketsSold\":2,\"screenId\":\"141\",\"seatsRemaining\":58,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392405\",\"time\":\"2026-02-15T17:20:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392406\",\"time\":\"2026-02-15T20:10:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392407\",\"time\":\"2026-02-16T14:30:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392408\",\"time\":\"2026-02-16T17:20:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392409\",\"time\":\"2026-02-16T20:10:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392411\",\"time\":\"2026-02-17T14:30:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392412\",\"time\":\"2026-02-17T17:20:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392413\",\"time\":\"2026-02-17T20:10:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392415\",\"time\":\"2026-02-18T14:30:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392416\",\"time\":\"2026-02-18T17:20:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392417\",\"time\":\"2026-02-18T20:10:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392419\",\"time\":\"2026-02-19T14:30:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392420\",\"time\":\"2026-02-19T17:20:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392421\",\"time\":\"2026-02-19T20:10:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"}]},{\"id\":\"34196\",\"name\":\"ALL ABOUT LOVE: A NIGHT OF LOVE, LITERATURE AND LIVE PERFORMANCE\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"all-about-love-a-night-of-love-literature-and-live-performance\",\"posterImage\":\"g84rw8rx71v16pwexdalrdhrmngj\",\"bannerImage\":\"9fcnv95c19g9n3z4rkpnh5rsfu19\",\"synopsis\":\"Real relationships, real stories, real love.\\n\\nALL ABOUT LOVE is an intimate, one-night-only event exploring love in all its depth, complexities, and forms.\\n\\nHosted at ActOne Cinema, the evening brings together live conversations, music, poetry and books to explore romantic, familial and platonic love.\\n\\nAcross three carefully curated segments, guests will hear from three real couples, from siblings to friends to spouses, sharing a book that has shaped how they understand or experience love, interwoven with live performances from emerging artists. Each act offers a different lens on the joys, complexities and deeply human nature of love.\\n\\nThis is not a panel or a lecture, but a warm, reflective night designed to feel like a shared living room: thoughtful, honest, and quietly powerful. Guests are invited to settle in, enjoy drinks and snacks from the bar, and let the evening unfold.\\n\\nMidway through the evening, Fiksy, the community-powered reading platform behind the event, will also share a special announcement - you’ll be hearing it first!\\n\\nWhether you come with a friend, a family member, a partner, or on your own, All About Love is an invitation to slow down, listen closely, and experience love through story, sound and shared reflection.\\n\\nAbout the Host: \\u003ca href=\\\"https://www.instagram.com/fiksybooks/\\\"\\u003eFIKSY\\u003c/a\\u003e\\nFiksy is a new platform helping readers discover new books through swapping rather than buying, making reading more fun, affordable, and sustainable. We're a community-powered library built on connection, curiosity, and care.\",\"starring\":null,\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":180,\"genre\":null,\"allGenres\":null,\"rating\":\"18\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-02-13\",\"dateOfFirstShowing\":\"2026-02-13\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"14860\",\"dcmEdiMovieName\":\"All About Eve (Re: 2007) (2D) [U]\",\"siteId\":\"93\",\"titleClassId\":\"141\",\"showings\":[{\"id\":\"392697\",\"time\":\"2026-02-13T19:00:00Z\",\"ticketsSold\":19,\"screenId\":\"301\",\"seatsRemaining\":31,\"displayMetaData\":\"{\\\"classes\\\":\\\"special-event live-music\\\"}\"}]},{\"id\":\"22686\",\"name\":\"ActOne Film Quiz\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"actone-film-quiz\",\"posterImage\":\"9fnw5in6ryri4igpx61zqr3h68r2\",\"bannerImage\":\"7091c1x8khua0fco8d72ftug2xqf\",\"synopsis\":\"Lights, camera, ActOne! Join us for our brand-new monthly film quiz, hosted by \\u003ca href=\\\"https://www.instagram.com/laralorenthehost/\\\"\\u003e@laralorenthehost\\u003c/a\\u003e. Different theme every month!\\n\\nTest your film knowledge, win cool prizes, and enjoy a night out at the lounge of our cosy community cinema. Entry is £3 per person and we welcome teams of up to 6 movie buffs and trivia champions!\",\"starring\":null,\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":120,\"genre\":null,\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-02-19\",\"dateOfFirstShowing\":\"2026-02-19\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":null,\"dcmEdiMovieName\":\"No Match Found\",\"siteId\":\"93\",\"titleClassId\":\"141\",\"showings\":[{\"id\":\"281743\",\"time\":\"2025-04-16T18:30:00Z\",\"ticketsSold\":42,\"screenId\":\"301\",\"seatsRemaining\":0,\"displayMetaData\":\"{\\\"classes\\\":\\\"special-event\\\"}\"},{\"id\":\"295274\",\"time\":\"2025-05-15T18:30:00Z\",\"ticketsSold\":34,\"screenId\":\"301\",\"seatsRemaining\":11,\"displayMetaData\":\"{\\\"classes\\\":\\\"special-event\\\"}\"},{\"id\":\"303146\",\"time\":\"2025-06-19T18:30:00Z\",\"ticketsSold\":36,\"screenId\":\"301\",\"seatsRemaining\":14,\"displayMetaData\":\"{\\\"classes\\\":\\\"special-event fun-at-the-lounge\\\"}\"},{\"id\":\"314090\",\"time\":\"2025-07-17T18:30:00Z\",\"ticketsSold\":50,\"screenId\":\"301\",\"seatsRemaining\":0,\"displayMetaData\":\"{\\\"classes\\\":\\\"special-event fun-in-the-lounge\\\"}\"},{\"id\":\"326035\",\"time\":\"2025-08-21T18:30:00Z\",\"ticketsSold\":50,\"screenId\":\"301\",\"seatsRemaining\":0,\"displayMetaData\":\"{\\\"classes\\\":\\\"special-event fun-in-the-lounge\\\"}\"},{\"id\":\"339169\",\"time\":\"2025-09-18T18:30:00Z\",\"ticketsSold\":24,\"screenId\":\"301\",\"seatsRemaining\":26,\"displayMetaData\":\"{\\\"classes\\\":\\\"special-event fun-in-the-lounge\\\"}\"},{\"id\":\"348177\",\"time\":\"2025-10-16T18:30:00Z\",\"ticketsSold\":37,\"screenId\":\"301\",\"seatsRemaining\":13,\"displayMetaData\":\"{\\\"classes\\\":\\\"special-event fun-in-the-lounge\\\"}\"},{\"id\":\"366705\",\"time\":\"2025-11-20T19:30:00Z\",\"ticketsSold\":30,\"screenId\":\"301\",\"seatsRemaining\":20,\"displayMetaData\":\"{\\\"classes\\\":\\\"special-event fun-in-the-lounge\\\"}\"},{\"id\":\"381456\",\"time\":\"2026-01-15T19:30:00Z\",\"ticketsSold\":50,\"screenId\":\"301\",\"seatsRemaining\":0,\"displayMetaData\":\"{\\\"classes\\\":\\\"special-event fun-in-the-lounge\\\"}\"},{\"id\":\"390539\",\"time\":\"2026-02-19T19:30:00Z\",\"ticketsSold\":17,\"screenId\":\"301\",\"seatsRemaining\":28,\"displayMetaData\":\"{\\\"classes\\\":\\\"special-event fun-in-the-lounge\\\"}\"}]},{\"id\":\"33732\",\"name\":\"MAY YOU BE WITH THE FARCE\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"may-the-farce-be-with-you\",\"posterImage\":\"7xn30ji09ldvs2ploquymau2t4ig\",\"bannerImage\":\"umq9681bdi0dkkb0z22o2hv7wt9z\",\"synopsis\":\"Comedian, cartoonist and actor Mike Capozzola's multimedia comedy show that mocks and celebrates all things STAR WARS!\\n\\nTHRILL TO uncanny impressions!\\n\\nGLIMPSE archival art from school notebooks!\\n\\nWITNESS a merciless appraisal of Star Wars merchandising\\n\\nRELIVE the tale of an epic lightsaber battle that nearly derailed a New York parade!\\n\\nMike Capozzola is a UK-based, Italian-American comedian and actor originally from New York who has performed at comedy clubs, comedy festivals and comic cons in most of the USA and in 25 countries across the UK, Europe and Middle East.\\n\\n\\n\\\"Hilarious... Twisted!”\\n-RICHARD LEWIS 'Curb Your Enthusiasm'\\n\\nQuick-witted, razor sharp observations\\\"\\n-'SHAKEN NOT STIRRED’\\n\\n“A brilliant comedian with a dry sense of humor”\\n-SAN FRANCISCO SKETCHFEST\\n\\n\\\"Side-splitting humor. One of the most unique voices in entertainment today”\\n-NERD NiTE\\n\\n---\\n\\n\\u003ci\\u003eWell-behaved smart kids 12+ welcome\\nThis is not a \\\"kids show\\\" Mike is not blowing bubbles or making Yoda-balloons. There are no singalongs.\\u003c/i\\u003e\",\"starring\":\"Mike Capozzola\",\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":70,\"genre\":null,\"allGenres\":null,\"rating\":\"12A\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-02-22\",\"dateOfFirstShowing\":\"2026-02-22\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"358555\",\"dcmEdiMovieName\":\"May You Stay Forever Young (2D) [15]\",\"siteId\":\"93\",\"titleClassId\":\"141\",\"showings\":[{\"id\":\"387848\",\"time\":\"2026-02-22T15:00:00Z\",\"ticketsSold\":11,\"screenId\":\"140\",\"seatsRemaining\":63,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1\\\"}\"}]},{\"id\":\"32557\",\"name\":\"NT LIVE: THE AUDIENCE\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"nt-live-the-audience\",\"posterImage\":\"9c9kjf6dhukz87ta2x5b3rvgjzk5\",\"bannerImage\":\"1pkbv66ur7qezp5aayygb4nkngyz\",\"synopsis\":\"Returning to cinemas for the first time in over a decade, Helen Mirren plays Queen Elizabeth II in the  Olivier and Tony Award® -winning hit production, directed by Stephen Daldry. \\n\\nFor 60 years, Queen Elizabeth II met with each of her 12 prime ministers in a private weekly meeting. This meeting is known as The Audience. From Winston Churchill to Margaret Thatcher and David Cameron, the Queen advised her prime ministers on matters both public and personal. Through these private audiences, we see glimpses of the woman behind the crown and witness the moments that shaped a monarch.\\n\\nPeter Morgan’s Netflix phenomenon The Crown was based on this hit play that was captured live from London’s West End in 2013 and went on to become one of the most-watched NT Live productions.\",\"starring\":\"Helen Mirren, Michael Elwyn, Haydn Gwynne\",\"directedBy\":\"Robin Lough\",\"producedBy\":\"Emma Keith\",\"searchTerms\":\"\",\"duration\":180,\"genre\":\"Drama\",\"allGenres\":\"Drama\",\"rating\":\"PG\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2013-06-12\",\"dateOfFirstShowing\":\"2026-02-26\",\"tmdbPopularityScore\":0.5223,\"tmdbId\":\"209149\",\"dcmEdiMovieId\":\"64275\",\"dcmEdiMovieName\":\"NT Live: The Comedy Of Errors (2D) [NR]\",\"siteId\":\"93\",\"titleClassId\":\"160\",\"showings\":[{\"id\":\"378120\",\"time\":\"2026-02-26T19:00:00Z\",\"ticketsSold\":16,\"screenId\":\"140\",\"seatsRemaining\":58,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1 special-event nt-live\\\"}\"}]},{\"id\":\"33883\",\"name\":\"GENTLE, ANGRY WOMEN + DIRECTOR Q\\u0026A\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"gentle-angry-women-director-qa\",\"posterImage\":\"riwt2z646ckembkrh2z7mbyo4ocd\",\"bannerImage\":\"lpkuh8q962c75xf3gs492kaj3dx4\",\"synopsis\":\"Three young activists trace the legacy of Greenham Common Women’s Peace protest forty years on and discover the alarming reality of British nuclear armament. Retracing the original 110-mile march, Poppy (16), Xanthe (17), and Evie (19) embark on an intimate intergenerational exchange, revealing a journey of self-discovery and a timely narrative of feminist activism that speaks to the need for hope, action and change.\\n\\nGentle, Angry Women (63min) is a poignant and timely documentary that weaves personal discovery, historical remembrance, and contemporary activism together, while honouring the largely overlooked Greenham Common Women's Peace Camp, where thousands of women lived for 19 years protesting against nuclear missiles. It responds to the rising global tensions of our time while celebrating the enduring power of women's collective action - revealing a bridge between past courage and present hope.\\n\\nThe film will be followed by a Q\\u0026A with the director, Barbara Santi. Tickets are on a Pay-What-You-Can scale, from £3.00. There will be no ads and trailers before the film, so please arrive on time.\\n\\nPart of our \\u003ca href=\\\"https://www.actonecinema.co.uk/footprints/\\\"\\u003eFOOTPRINTS film strand\\u003c/a\\u003e: A fascinating series of screenings, discussions and Q\\u0026As that tackle environmental issues. The damage being done to the environment will lay its most dire consequences at the feet of future generations. With Gentle, Angry Women, FOOTPRINTS wish to encourage young people to question their place in the climate crisis and how they can become more involved.\",\"starring\":\"\",\"directedBy\":\"Barbara Santi\",\"producedBy\":\"Barbara Santi\",\"searchTerms\":\"\",\"duration\":100,\"genre\":\"Documentary\",\"allGenres\":\"Documentary\",\"rating\":\"12A\",\"trailerYoutubeId\":\"hS0lU_Nvk7M\",\"trailerVideo\":null,\"releaseDate\":\"2025-09-26\",\"dateOfFirstShowing\":\"2026-03-01\",\"tmdbPopularityScore\":0.1081,\"tmdbId\":\"1544514\",\"dcmEdiMovieId\":null,\"dcmEdiMovieName\":\"No Match Found\",\"siteId\":\"93\",\"titleClassId\":\"234\",\"showings\":[{\"id\":\"390014\",\"time\":\"2026-03-01T14:30:00Z\",\"ticketsSold\":12,\"screenId\":\"140\",\"seatsRemaining\":62,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1 footprints no-ads--trailers qa\\\"}\"}]},{\"id\":\"25835\",\"name\":\"ROYAL BALLET LIVE: GISELLE\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"royal-ballet-live-giselle\",\"posterImage\":\"gi52fpy51ttksvul6i384qumhsf9\",\"bannerImage\":\"9cbbm1nev37h4fqrkljagwofqaa9\",\"synopsis\":\"For the full programme of the RBO '25-'26 season and our money-saving Season Passes, please \\u003ca href=\\\"https://www.actonecinema.co.uk/royal-ballet--opera-live\\\"\\u003ego here\\u003c/a\\u003e.\\n\\nBroadcast LIVE from THE ROYAL OPERA HOUSE, for one night only!\\n\\nThe peasant girl Giselle has fallen in love with Albrecht. When she discovers that he is actually a nobleman promised to another, she kills herself in despair. Her spirit joins the Wilis: the vengeful ghosts of women hell-bent on killing any man who crosses their path in a dance to the death. Wracked with guilt, Albrecht visits Giselle’s grave, where he must face the Wilis – and Giselle’s ghost. \\n\\nPeter Wright’s 1985 production of this quintessential Romantic ballet is a classic of The Royal Ballet repertory. Set to Adolphe Adam’s evocative score and with atmospheric designs by John Macfarlane, Giselle conjures up the earthly and otherworldly realms in a tale of love, betrayal and redemption.\\n\\nRunning time: 210 minutes (To be confirmed)\",\"starring\":\"TBC\",\"directedBy\":\"\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":210,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"9B8DfHdFhvM\",\"trailerVideo\":null,\"releaseDate\":\"2026-02-27\",\"dateOfFirstShowing\":\"2026-03-03\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"62279\",\"dcmEdiMovieName\":\"Alice's Adventures In Wonderland - Royal Ballet 2013 (Ballet) (2D) [Unknown]\",\"siteId\":\"93\",\"titleClassId\":\"398\",\"showings\":[{\"id\":\"317992\",\"time\":\"2026-03-03T19:15:00Z\",\"ticketsSold\":13,\"screenId\":\"140\",\"seatsRemaining\":61,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1 royal-ballet--opera-live no-ads--trailers\\\"}\"}]},{\"id\":\"32781\",\"name\":\"OTHELLO\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"othello\",\"posterImage\":\"0liskot0mr6ggrp03tgqx8zp20ql\",\"bannerImage\":\"wvwe4b7juplortsj3lua9yfmcfni\",\"synopsis\":\"Shakespeare’s OTHELLO rages to life like never before in a ‘compelling’ (★★★★ Telegraph) new production starring David Harewood OBE (Homeland, Best of Enemies), Toby Jones OBE (Mr Bates vs the Post Office, Detectorists), Caitlin FitzGerald (Succession, Masters of Sex), Vinette Robinson (Boiling Point) and Luke Treadaway (A Street Cat Named Bob).\\n\\nDirected by Tony Award-winner Tom Morris OBE (War Horse, Dr Semmelweis, The Grinning Man) with music by PJ Harvey, this epic story of manipulation, jealousy and toxic masculinity explores the darker side of power, rage and desire. Filmed live at the Theatre Royal Haymarket in London especially for the big screen, this is ‘an electrifying star-studded Othello.’ (★★★★ Mail on Sunday)\",\"starring\":\"David Harewood, Toby Jones, Caitlin Fitzgerald, Vinette Robinson, Luke Treadaway\",\"directedBy\":\"Tom Morris\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":165,\"genre\":null,\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"otYIqyRlt9c\",\"trailerVideo\":null,\"releaseDate\":\"2026-02-04\",\"dateOfFirstShowing\":\"2026-03-04\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"927672\",\"dcmEdiMovieName\":\"Othello (2D) [12A]\",\"siteId\":\"93\",\"titleClassId\":\"141\",\"showings\":[{\"id\":\"378503\",\"time\":\"2026-03-04T19:00:00Z\",\"ticketsSold\":13,\"screenId\":\"140\",\"seatsRemaining\":47,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1 special-event\\\"}\"}]},{\"id\":\"33863\",\"name\":\"IRON LADIES + LIVE Q\\u0026A\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"iron-ladies-live-qa\",\"posterImage\":\"asb95592awk5shh7ff2iyaeh823w\",\"bannerImage\":\"qylx6tw3lcatm1selzdzpv9q4pyw\",\"synopsis\":\"IRON LADIES tells the story of the working-class women who, during the 1984–85 Miners' Strike, found themselves at the forefront of a battle against the British state.\\n\\nFrom Scotland to Kent, women from the coalfields shed light on their experiences of the year-long struggle, and how they became the backbone of the Strike. \\n\\nWith many still active today, the actions of these iron-willed women reshaped the landscape of political activism for working-class women.\\n\\nA live Q\\u0026A with director Daniel Draper will follow the screening.\",\"starring\":\"Rattapoom Toekongsap, Sudarat Butrprom, Pharunyoo Rojanawuttitham\",\"directedBy\":\"Poj Arnon\",\"producedBy\":\"Poj Arnon, Thawatchai Phanpakdee\",\"searchTerms\":\"\",\"duration\":98,\"genre\":\"Documentary\",\"allGenres\":\"Comedy\",\"rating\":\"12A\",\"trailerYoutubeId\":\"KkQBOaJjW_s\",\"trailerVideo\":null,\"releaseDate\":\"2026-03-07\",\"dateOfFirstShowing\":\"2026-03-07\",\"tmdbPopularityScore\":1.5961,\"tmdbId\":\"335085\",\"dcmEdiMovieId\":\"\",\"dcmEdiMovieName\":null,\"siteId\":\"93\",\"titleClassId\":\"141\",\"showings\":[{\"id\":\"389798\",\"time\":\"2026-03-07T15:00:00Z\",\"ticketsSold\":3,\"screenId\":\"140\",\"seatsRemaining\":71,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1 special-event qa\\\"}\"}]},{\"id\":\"26116\",\"name\":\"EXHIBITION ON SCREEN: TURNER \\u0026 CONSTABLE\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"exhibition-on-screen-turner-constable\",\"posterImage\":\"n8l3kpmsl6mn205nu2mw0y4n89kl\",\"bannerImage\":\"q8ocmlquz46xjpo2w9sjtrkgspq9\",\"synopsis\":\"Celebrating the 250th anniversary of their births, this unmissable new documentary explores Turner and Constable’s intertwined lives and legacies alongside the groundbreaking Tate exhibition.\\n\\nTwo of Britain’s greatest painters, J.M.W. Turner and John Constable were also the greatest of rivals. Born within a year of each other, both used landscape painting to reflect the changing world around them. Tate Britain is bringing these two greats together for a groundbreaking exhibition, in London from November 2025 to April 2026, and Exhibition on Screen once again has exclusive and privileged access to bring their extraordinary art and remarkable stories to the big screen in February so that you can enjoy both film and exhibition together. Discover unexpected sides to both artists with intimate views of sketchbooks and personal items and insights from leading experts.\\n\\nTurner’s blazing sunsets and sublime scenes from his travels and Constable’s idealised depictions of beloved places from home whipped the public of the time into a frenzy of enthusiasm. Constable represents the very best of the old school of realism and pastoral nostalgia; Turner, an exciting new way of depicting emotion and dreamlike impressions. Critics compared their starkly different styles to a clash of ‘fire and water’. Don’t miss this opportunity to see these greats side-by-side, as they so often were in life, on the big screen for the first time.\",\"starring\":null,\"directedBy\":\"David Bickerstaff\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":90,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"\",\"trailerVideo\":null,\"releaseDate\":\"2026-03-10\",\"dateOfFirstShowing\":\"2026-03-10\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"470745\",\"dcmEdiMovieName\":\"Exhibition On Screen: Turner \\u0026amp; Constable 2026 (Exhibition) [Unknown]\",\"siteId\":\"93\",\"titleClassId\":\"400\",\"showings\":[{\"id\":\"321565\",\"time\":\"2026-03-10T18:00:00Z\",\"ticketsSold\":29,\"screenId\":\"140\",\"seatsRemaining\":45,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1 special-event eos\\\"}\"}]},{\"id\":\"25836\",\"name\":\"ROYAL OPERA LIVE: SIEGFRIED\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"royal-opera-live-siegfried\",\"posterImage\":\"y4dxzwvq1nf78lbsnud99q2sjx2l\",\"bannerImage\":\"guu25b2ekkbmwcwwagwzw9uvfisg\",\"synopsis\":\"For the full programme of the RBO '25-'26 season and our money-saving Season Passes, please \\u003ca href=\\\"https://www.actonecinema.co.uk/royal-ballet--opera-live\\\"\\u003ego here\\u003c/a\\u003e.\\n\\nBroadcast LIVE from THE ROYAL OPERA HOUSE, for one night only!\\n\\nRaised by a scheming dwarf and unaware of his true family origins, a young man embarks on an epic journey. Soon, destiny brings him face-to-face with a shattered sword, a fearsome dragon and the cursed ring it guards, and a Valkyrie forced into enchanted slumber... \\n\\nMoments of transcendent beauty and heroic triumph sparkle in the third chapter of Wagner’s Ring cycle, brought to life under Barrie Kosky’s inspired eye following his spectacular Das Rheingold (2023) and Die Walküre (2025). Andreas Schager, in his much-anticipated debut with The Royal Opera, stars as Siegfried’s titular hero, alongside Christopher Maltman’s towering Wanderer, Peter Hoare’s treacherous Mime and Elisabet Strid’s radiant Brünnhilde. Antonio Pappano conducts, drawing out the unspoken tensions and ethereal mysticism of Wagner’s dynamic score.\\n\\nRunning time: 330 minutes (to be confirmed)\\nSung in German with subtitles\",\"starring\":\"ANDREAS SCHAGER, PETER HOARE, CHRISTOPHER MALTMAN, ELISABET STRID\",\"directedBy\":\"BARRIE KOSKY\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":330,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"9B8DfHdFhvM\",\"trailerVideo\":null,\"releaseDate\":\"2026-03-31\",\"dateOfFirstShowing\":\"2026-03-31\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"204938\",\"dcmEdiMovieName\":\"Anastasia - Royal Opera, London 2016/17 (Ballet) (2D) [12A]\",\"siteId\":\"93\",\"titleClassId\":\"398\",\"showings\":[{\"id\":\"317989\",\"time\":\"2026-03-31T16:15:00Z\",\"ticketsSold\":19,\"screenId\":\"140\",\"seatsRemaining\":41,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1 royal-ballet--opera-live no-ads--trailers\\\"}\"}]},{\"id\":\"33506\",\"name\":\"NT LIVE: ALL MY SONS\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"nt-live-all-my-sons\",\"posterImage\":\"43z8huyramizxi7htqdah93sr42f\",\"bannerImage\":\"f7byrr70dnlwdcbe5mjuyum7py08\",\"synopsis\":\"Bryan Cranston (Breaking Bad) and Marianne Jean-Baptiste (Hard Truths) feature in a five-star, triumphantly acclaimed new production of Arthur Miller’s classic play, from visionary director Ivo Van Hove (A View from the Bridge).\\n\\nOne family, the heart of the American dream. When wartime delivers profits for Joe, it comes at a price when his partner is charged with criminal manufacturing deals, and his eldest son goes missing in action. Will peacetime bring peace of mind, or will he be confronted by the consequence of his actions?\\n\\nFilmed live from the West End, Paapa Essiedu (I May Destroy You), Tom Glynn-Carney (House of the Dragon), and Hayley Squires (I, Daniel Blake) also feature in this disturbingly prescient play.\",\"starring\":\"Bryan Cranston, Marianne Jean-Baptiste, Paapa Essiedu, Tom Glynn-Carney, Hayley Squires\",\"directedBy\":\"Ivo Van Hove\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":130,\"genre\":null,\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-04-16\",\"dateOfFirstShowing\":\"2026-04-16\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"\",\"dcmEdiMovieName\":null,\"siteId\":\"93\",\"titleClassId\":\"160\",\"showings\":[{\"id\":\"387271\",\"time\":\"2026-04-16T18:00:00Z\",\"ticketsSold\":15,\"screenId\":\"140\",\"seatsRemaining\":59,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1 special-event nt-live\\\"}\"}]},{\"id\":\"25838\",\"name\":\"ROYAL OPERA LIVE: THE MAGIC FLUTE\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"royal-opera-live-the-magic-flute\",\"posterImage\":\"koexi4murpfwm5reij3vlh1yp0sx\",\"bannerImage\":\"533w0jvsmdq7sks40u8osk07l5it\",\"synopsis\":\"For the full programme of the RBO '25-'26 season and our money-saving Season Passes, please \\u003ca href=\\\"https://www.actonecinema.co.uk/royal-ballet--opera-live\\\"\\u003ego here\\u003c/a\\u003e.\\n\\nPrincess Pamina has been captured. Her mother, the Queen of the Night, tasks the young Prince Tamino with her daughter’s rescue. But when Tamino and his friendly sidekick, Papageno, embark on their adventure, they soon learn that when it comes to the quest for love, nothing is as it really seems. Guided by a magic flute, they encounter monsters, villains, and a mysterious brotherhood of men – but help, it turns out, comes when you least expect it.\\n\\nMozart’s fantastical opera glitters in David McVicar’s enchanting production. A star cast including Julia Bullock as Pamina, Amitai Pati as Tamino, Huw Montague Rendall as Papageno, Kathryn Lewek as the Queen of the Night, and Soloman Howard as Sarastro, led by French conductor Marie Jacquot in her Covent Garden debut.\\n\\nFilmed live in October 2025\\n\\nRunning time: 210 minutes (To be confirmed) \\nSung in German with English subtitles.\",\"starring\":\"JULIA BULLOCK, AMITAI PATI, HUW MONTAGUE RENDALL, KATHRYN LEWEK\",\"directedBy\":\"DAVID MCVICAR\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":210,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"7jTbrr-0aEA\",\"trailerVideo\":null,\"releaseDate\":\"2026-04-21\",\"dateOfFirstShowing\":\"2026-04-21\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"204938\",\"dcmEdiMovieName\":\"Anastasia - Royal Opera, London 2016/17 (Ballet) (2D) [12A]\",\"siteId\":\"93\",\"titleClassId\":\"398\",\"showings\":[{\"id\":\"317990\",\"time\":\"2026-04-21T17:45:00Z\",\"ticketsSold\":18,\"screenId\":\"140\",\"seatsRemaining\":56,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1 royal-ballet--opera-live no-ads--trailers\\\"}\"}]},{\"id\":\"34352\",\"name\":\"THE CONSPIRACISTS + LIVE Q\\u0026A\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-conspiracists-live-qa\",\"posterImage\":\"sj9x5svc0pgml8fhote1yq44onxn\",\"bannerImage\":\"y3ste7dwgby2k6w72uycbxhovxx3\",\"synopsis\":\"Three women set off on a road trip across America. One of them is a MAGA supporter and conspiracy theorist. She has just been sentenced to 30 months in prison for her role in the storming of The US Capitol. They meet other “patriots” along the way and as the journey unfolds she leads her travel companions deeper into her labyrinth of conspiracy, determined to open their eyes to what she sees as the real truth. By the trip’s end will she have converted them to her “5D world”? \\n\\nTHE CONSPIRACISTS is an intimate and empathetic portrait of women drawn into the world of conspiracy.\\n\\nThe screening will be followed by a live Q\\u0026A with director Liz Smith and featured participant and associate producer Noelle Cook.\\n\\n\\u003ci\\u003eLiz Smith is an award winning British documentary filmmaker. Her work is centred around human rights. The films she makes at Page75 Productions are the outcome of years of study on the issues driving the rise of populism and the erosion of our democratic rights. However, researching the issues can only go so far. Her approach of spending time with affected communities on the frontline delivers a much deeper understanding of the forces driving these trends Her recent feature documentaries include I Am Gen Z and The Line We Crossed. \\n\\nNoelle Cook is an ethnographer and researcher examining how identity, belief, and belonging shape women’s participation in conspiratorial and right-wing movements. She is the author of The Conspiracists: Women, Extremism, and the Lure of Belonging.\\u003c/i\\u003e\",\"starring\":\"Noelle Cook, Yvonne St Cyr, Liz Smith, Tammy Butry, Jill McCartney, Troy St Cyr, Brianne Chapman - Self\",\"directedBy\":\"Liz Smith\",\"producedBy\":\"Chantelle de Carvalho\",\"searchTerms\":\"\",\"duration\":96,\"genre\":\"Comedy\",\"allGenres\":\"Comedy\",\"rating\":\"15\",\"trailerYoutubeId\":\"2O_NDAaAd_U\",\"trailerVideo\":null,\"releaseDate\":\"2026-04-26\",\"dateOfFirstShowing\":\"2026-04-26\",\"tmdbPopularityScore\":1.3844,\"tmdbId\":null,\"dcmEdiMovieId\":\"484879\",\"dcmEdiMovieName\":\"#Runseokjin_Ep.Tour The Movie (Concert) [12A]\",\"siteId\":\"93\",\"titleClassId\":\"141\",\"showings\":[{\"id\":\"394425\",\"time\":\"2026-04-26T13:30:00Z\",\"ticketsSold\":0,\"screenId\":\"140\",\"seatsRemaining\":74,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1\\\"}\"}]},{\"id\":\"25839\",\"name\":\"ROYAL OPERA LIVE: EUGENE ONEGIN\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"royal-opera-live-eugene-onegin\",\"posterImage\":\"orscwwd3xzl7564csmjifojwdvig\",\"bannerImage\":\"br1yu6uet2k1gdr8k2u2zzfbg96d\",\"synopsis\":\"For the full programme of the RBO '25-'26 season and our money-saving Season Passes, please \\u003ca href=\\\"https://www.actonecinema.co.uk/royal-ballet--opera-live\\\"\\u003ego here\\u003c/a\\u003e.\\n\\nBroadcast LIVE from THE METROPOLITAN OPERA, for one night only!\\n\\nFollowing her acclaimed 2024 company debut in Puccini’s Madama Butterfly, soprano Asmik Grigorian returns to the Met as Tatiana, the lovestruck young heroine in this ardent operatic adaptation of Pushkin. Baritone Igor Golovatenko reprises his portrayal of the urbane Onegin, who realizes his affection for her all too late. The Met’s evocative production, directed by Tony Award–winner Deborah Warner, “offers a beautifully detailed reading of … Tchaikovsky’s lyrical romance” (The Telegraph).\\n\\nRunning time: 245 minutes, Two Intervals\\nSung in Russian with English subtitles\",\"starring\":\"ASMIK GRIGORIAN, MARIA BARAKOVA, STEPHANIE BLYTHE, STANISLAS DE BARBEYRAC\",\"directedBy\":\"DEBORAH WARNER\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":245,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"9B8DfHdFhvM\",\"trailerVideo\":null,\"releaseDate\":\"2026-05-05\",\"dateOfFirstShowing\":\"2026-05-05\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"204938\",\"dcmEdiMovieName\":\"Anastasia - Royal Opera, London 2016/17 (Ballet) (2D) [12A]\",\"siteId\":\"93\",\"titleClassId\":\"398\",\"showings\":[{\"id\":\"317991\",\"time\":\"2026-05-05T17:00:00Z\",\"ticketsSold\":15,\"screenId\":\"140\",\"seatsRemaining\":45,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1 royal-ballet--opera-live no-ads--trailers\\\"}\"}]},{\"id\":\"26121\",\"name\":\"EXHIBITION ON SCREEN: FRIDA KAHLO\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"exhibition-on-screen-frida-kahlo\",\"posterImage\":\"qogzyzsfshirsbx3ttyq08610pmx\",\"bannerImage\":\"osupg5xb0qelaq18mik7y1jpwo9w\",\"synopsis\":\"Frida Kahlo is a phenomenon. She is arguably the world’s favourite female artist – beloved by young and old. Exhibition on Screen’s award-winning film – first released during COVID to a restricted audience - is back by popular demand with an exciting new addition from the blockbuster transatlantic exhibition from Tate Britain and MFA Houston 'Frida Kahlo: the Making of an Icon'.  Back in the cinemas in May 2026, one month before the Tate exhibition opens, allowing audiences to watch both the film and see the show. \\n  \\nWho was Frida Kahlo? Everyone knows her face but who was the woman behind the bright colours, the big brows and the floral crowns? Take a journey through the life of a true icon, discover her art, and uncover the true story of her rebellious, passionate and turbulent life. \\n  \\nMaking use of the latest technology to deliver previously unimaginable quality, we take an in-depth look at key works throughout her career. Using letters Kahlo wrote to guide us, this definitive film reveals her deepest emotions and unlocks the secrets and symbolism contained within her art. \\n  \\nExhibition on Screen’s trademark combination of interviews with those who knew her and world experts, commentary and a detailed exploration of her art, combined with new special bonus footage from the 2026 Tate exhibition, delivers a treasure trove of colour and emotion. This personal and intimate film offers privileged access to her works, her home, her studio and highlights the source of her feverish creativity, her resilience and her unmatched lust for life, beauty and revolution. \\n  \\nCreated in close collaboration with world experts and those who knew her. \\n  \\nAdditional new material from the curators of the groundbreaking new Tate Britain and MFA Houston exhibition.\",\"starring\":null,\"directedBy\":\"Ali Ray\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":90,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"D76y2YhjV8A\",\"trailerVideo\":null,\"releaseDate\":\"2026-05-15\",\"dateOfFirstShowing\":\"2026-05-19\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"470746\",\"dcmEdiMovieName\":\"Exhibition On Screen: Frida Kahlo 2026 Encore (Exhibition) [Unknown]\",\"siteId\":\"93\",\"titleClassId\":\"400\",\"showings\":[{\"id\":\"321564\",\"time\":\"2026-05-19T17:00:00Z\",\"ticketsSold\":7,\"screenId\":\"140\",\"seatsRemaining\":67,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1 special-event eos\\\"}\"}]},{\"id\":\"32558\",\"name\":\"NT LIVE: THE PLAYBOY OF THE WESTERN WORLD\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"nt-live-the-playboy-of-the-western-world\",\"posterImage\":\"vw7feddm6jadp5x3jafo3q5fxebs\",\"bannerImage\":\"45v0u56yovdbpbo8cno5v98k34yq\",\"synopsis\":\"Nicola Coughlan (Bridgerton) joins Éanna Hardwicke (The Sixth Commandment) and Siobhán McSweeney (Derry Girls) in John Millington Synge’s riveting play of youth and self-discovery.\\n\\nPegeen Flaherty’s life is turned upside down when a young man walks into her pub claiming that he’s killed his father. Instead of being shunned, the killer becomes a local hero and begins to win hearts, that is until a second man unexpectedly arrives on the scene…\\n\\nFilmed live on stage at the National Theatre, Caitríona McLaughlin directs this darkly funny tale full to the brim with secrets.\",\"starring\":\"Nicola Coughlan, Éanna Hardwicke, Siobhán McSweeney\",\"directedBy\":\"Caitríona McLaughlin\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":150,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-05-28\",\"dateOfFirstShowing\":\"2026-05-28\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"\",\"dcmEdiMovieName\":null,\"siteId\":\"93\",\"titleClassId\":\"160\",\"showings\":[{\"id\":\"378122\",\"time\":\"2026-05-28T18:00:00Z\",\"ticketsSold\":3,\"screenId\":\"140\",\"seatsRemaining\":57,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1 special-event nt-live\\\"}\"}]},{\"id\":\"32560\",\"name\":\"NT LIVE: LES LIAISONS DANSEREUSES\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"nt-live-les-liaisons-dansereuses\",\"posterImage\":\"wgf78j8ktinb5tlcvjacstub0u9y\",\"bannerImage\":\"m2e4a8lirwvqlstl9ysdn61nfu6j\",\"synopsis\":\"BAFTA Award-winner Lesley Manville (Phantom Thread) joins Aidan Turner (Rivals) in a striking new staging of Christopher Hampton’s celebrated adaptation of the classic novel, where among the glittering salons of the super-rich, one misstep can mean ruin.\\n\\nMarquise de Merteuil is a master in the art of survival. Alongside the magnetic Vicomte de Valmont, they turn seduction into strategy and weaponise desire.  But when their alliance collapses into rivalry, the battle between them threatens to destroy everyone in their path.\\n\\nFilmed live on stage at the National Theatre, Marianne Elliott (Angels in America) directs this thrilling game of love, lies, and social warfare.\",\"starring\":\"Lesley Manville, Aidan Turner\",\"directedBy\":\"Marianne Elliott\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":150,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-06-25\",\"dateOfFirstShowing\":\"2026-06-25\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"\",\"dcmEdiMovieName\":null,\"siteId\":\"93\",\"titleClassId\":\"160\",\"showings\":[{\"id\":\"378121\",\"time\":\"2026-06-25T18:00:00Z\",\"ticketsSold\":2,\"screenId\":\"140\",\"seatsRemaining\":58,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1 special-event nt-live\\\"}\"}]}]}}}",
