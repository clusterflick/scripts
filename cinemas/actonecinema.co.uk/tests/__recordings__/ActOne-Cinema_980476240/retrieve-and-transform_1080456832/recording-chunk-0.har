isplayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"466822\",\"time\":\"2026-08-03T20:00:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"captions\\\"}\"},{\"id\":\"466906\",\"time\":\"2026-08-04T14:00:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"466828\",\"time\":\"2026-08-05T11:30:00Z\",\"ticketsSold\":1,\"screenId\":\"141\",\"seatsRemaining\":59,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"466834\",\"time\":\"2026-08-06T14:00:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"}]},{\"id\":\"39283\",\"name\":\"ON THE SEA\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"on-the-sea\",\"posterImage\":\"cqhsd8oebs6vqe0nqwteq2kj0s16\",\"bannerImage\":\"jt8v384z42mw52btx8bvjf441gfs\",\"synopsis\":\"Jack has been married to Maggie for over half his life. He works as a Hand Raker on the mussel beds in North Wales alongside his younger brother, Dyfan, and Dyfan’s three sons. Jack has always assumed that his own boy, Tom, will join the family business on leaving school but Tom’s resistance to follow in his footsteps creates familial tension. Tensions are further inflamed by the arrival of an itinerant deckhand, Daniel, who makes known his feelings for Jack. In this remote, rural community where life revolves around Church and fishery, Jack is faced with an impossible dilemma. On The Sea is a beautiful, sensual and at times, tragic exploration of masculinity, place and desire.\",\"starring\":\"Barry Ward, Lorne MacFadyen, Liz White\",\"directedBy\":\"Helen Walsh\",\"producedBy\":\"\",\"searchTerms\":\"\",\"duration\":115,\"genre\":\"Drama\",\"allGenres\":\"Drama, Romance\",\"rating\":\"15\",\"trailerYoutubeId\":\"od_S8t86F0M\",\"trailerVideo\":null,\"releaseDate\":\"2026-07-31\",\"dateOfFirstShowing\":\"2026-07-31\",\"tmdbPopularityScor