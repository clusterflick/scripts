{\\\"classes\\\":\\\"sc1\\\"}\"},{\"id\":\"390139\",\"time\":\"2026-02-04T14:50:00Z\",\"ticketsSold\":0,\"screenId\":\"140\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1\\\"}\"},{\"id\":\"390140\",\"time\":\"2026-02-04T20:20:00Z\",\"ticketsSold\":0,\"screenId\":\"140\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1\\\"}\"},{\"id\":\"390136\",\"time\":\"2026-02-05T14:40:00Z\",\"ticketsSold\":2,\"screenId\":\"140\",\"seatsRemaining\":58,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1\\\"}\"},{\"id\":\"390137\",\"time\":\"2026-02-05T20:00:00Z\",\"ticketsSold\":0,\"screenId\":\"140\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1\\\"}\"},{\"id\":\"392509\",\"time\":\"2026-02-06T17:10:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392510\",\"time\":\"2026-02-07T17:10:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392511\",\"time\":\"2026-02-08T17:10:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392714\",\"time\":\"2026-02-10T17:10:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392512\",\"time\":\"2026-02-11T17:10:00Z\",\"ticketsSold\":0,\"screenId\":\"141\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"},{\"id\":\"392513\",\"time\":\"2026-02-12T17:10:00Z\",\"ticketsSold\":1,\"screenId\":\"141\",\"seatsRemaining\":59,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc2\\\"}\"}]},{\"id\":\"24082\",\"name\":\"LIVE JAZZ WITH TRENT PIETERSE QUARTET\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"live-jazz-with-trent-pieterse-quartet\",\"posterImage\":\"wzff5i6vk8aq8my6di98q9sf2oz2\",\"bannerImage\":\"n2gqaf2suh7hm1nuzdr5h4nykijg\",\"synopsis\":\"£5 entry.\\n\\nGet notified of our events by becoming a member on our Meetup Groups: \\u003ca href=\\\"https://www.meetup.com/west-london-board-games-meetup-group/\\\"\\u003eWest London Board Games\\u003c/a\\u003e and \\u003ca href=\\\"https://www.meetup.com/free-open-mic-jazz-nights-in-west-london/\\\"\\u003eFree Open Mic \\u0026 Jazz Nights in West London\\u003c/a\\u003e!\\n\\nJoin us for an unforgettable evening of live jazz with the talented Trent Pieterse Quartet. Discover soulful melodies as local jazz musicians take the stage, captivating you with their incredible skills and improvisation!\\n\\nSo come on down to the only independent, not-for-profit, community cinema in Ealing and join us for a night of incredible talent and a chance to mingle with fellow jazz enthusiasts!\",\"starring\":null,\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":150,\"genre\":null,\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-01-31\",\"dateOfFirstShowing\":\"2026-01-31\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"384560\",\"dcmEdiMovieName\":\"'Esports Live' With Mason Mount And Friends (ANALOG) [Unknown]\",\"siteId\":\"93\",\"titleClassId\":\"277\",\"showings\":[{\"id\":\"298211\",\"time\":\"2025-05-24T18:30:00Z\",\"ticketsSold\":32,\"screenId\":\"301\",\"seatsRemaining\":18,\"displayMetaData\":\"{\\\"classes\\\":\\\"fun-at-the-lounge\\\"}\"},{\"id\":\"300940\",\"time\":\"2025-06-14T18:30:00Z\",\"ticketsSold\":40,\"screenId\":\"301\",\"seatsRemaining\":10,\"displayMetaData\":\"{\\\"classes\\\":\\\"fun-at-the-lounge\\\"}\"},{\"id\":\"300943\",\"time\":\"2025-07-05T18:30:00Z\",\"ticketsSold\":22,\"screenId\":\"301\",\"seatsRemaining\":28,\"displayMetaData\":\"{\\\"classes\\\":\\\"fun-at-the-lounge\\\"}\"},{\"id\":\"342453\",\"time\":\"2025-10-04T18:30:00Z\",\"ticketsSold\":25,\"screenId\":\"301\",\"seatsRemaining\":25,\"displayMetaData\":\"{\\\"classes\\\":\\\"fun-in-the-lounge\\\"}\"},{\"id\":\"363780\",\"time\":\"2025-11-08T19:30:00Z\",\"ticketsSold\":26,\"screenId\":\"301\",\"seatsRemaining\":24,\"displayMetaData\":\"{\\\"classes\\\":\\\"fun-in-the-lounge\\\"}\"},{\"id\":\"390869\",\"time\":\"2026-01-31T19:30:00Z\",\"ticketsSold\":0,\"screenId\":\"301\",\"seatsRemaining\":50,\"displayMetaData\":\"{\\\"classes\\\":\\\"fun-in-the-lounge\\\"}\"}]},{\"id\":\"32722\",\"name\":\"LSFF: The Colonial Present in Cinema and Sound (+ reflective listening soundscape)\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"lsff-the-colonial-present-in-cinema-and-sound-reflective-listening-soundscape\",\"posterImage\":\"9wiqhoqob2d8nokkqkhez72nd9pk\",\"bannerImage\":\"u1rk8szarrpy9c1f94wmbevvt1rx\",\"synopsis\":\"Stories of national liberation brought to life through film and a shared music listening experience.\\n\\nJoin us for an evening that foregrounds the people, memories, and movements that continue to shape our world. Through film and sound, we explore the Colonial Present, and resistances against imperial violence across time and geography. A journey that takes us from the African continent and Brazil, to Turtle Island, and the everlasting struggle in Palestine with the Oscar-nominated The Present by Farah Nabulsi.\\n\\nThe film programme will be followed by a reflective listening soundscape exploring the power of music and audio in service of political cause.\\n\\nTogether, these cinematic and sonic manifestos ignite vital questions: How can film, music, and culture at large, become weapons of political struggle, catalysts of solidarity, and a call for action?\\n\\nThis programme is curated by Thawra Archive. \\n\\nMonangambé, dir. Sarah Maldoror, Angola 1968, 16 mins\\nChildren without Childhood, dir. Khadijeh Habashneh Abu Ali, Palestine 1979, 21 mins\\nHá Terra!, dir. Ana Vaz, Brazil 2016, 13 mins \\nBeneath the Concrete, the forest, dir. Lev Omelchenko, USA 2023, 12 mins\\nThe Present, dir. Farah Nabulsi, Palestine, Qatar 2020, 24 mins\\n\\nContent / Trigger Warnings: Contains scenes of graphic violence or injury, and of harm towards children.\\n\\n\\nThe UK’s leading short film festival, the London Short Film Festival (LSFF), returns for its 23rd edition from 23 January - 1 February 2026, bringing films and events to London’s iconic cinemas alongside community and creative spaces.\\n\\nLSFF presents the best in independent, boundary-pushing filmmaking from around the world. Showcasing 300 works from new voices, acclaimed directors, and underground discoveries drawn from the archive, the festival spans the full emotional range of short-form cinema. From raw DIY confessionals to bold, cinematic stories, these are films that surprise, unsettle, comfort, and stay with you. LSFF’s special events combine curated programmes with conversations and unique experiences.\\n\\nCinema Remembers What We Forget, the underlying current in this year’s programme, explores how artists confront memory and identity - the fragments that linger beneath the surface: the messy, the emotional, the defiant and the unfiltered.\",\"starring\":null,\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":120,\"genre\":null,\"allGenres\":null,\"rating\":\"18\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-02-01\",\"dateOfFirstShowing\":\"2026-02-01\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":null,\"dcmEdiMovieName\":\"No Match Found\",\"siteId\":\"93\",\"titleClassId\":\"141\",\"showings\":[{\"id\":\"378254\",\"time\":\"2026-02-01T14:30:00Z\",\"ticketsSold\":31,\"screenId\":\"140\",\"seatsRemaining\":43,\"displayMetaData\":\"{\\\"classes\\\":\\\"sc1 special-event\\\"}\"}]},{\"id\":\"33905\",\"name\":\"CARERS \\u0026 BABIES: H IS FOR HAWK\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"carers-babies-h-is-for-hawk\",\"posterImage\":\"tyrk3g7h1r9vnlmpct605j473wt7\",\"bannerImage\":\"d5adq9oam6unafgqdxvr2aiik6xh\",\"synopsis\":\"\\u003cb\\u003eThis performance is exclusive to our \\u003ca href=\\\"https://actonecinema.co.uk/carers--babies-club\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\"\\u003eCARERS \\u0026 BABIES CLUB\\u003c/a\\u003e. You must have at least one baby in your party aged 0-12 months old.\\u003c/b\\u003e\\n\\nWhen Helen's beloved father passes away, she is knocked sideways by grief and loses herself in memories of their time birding and exploring the natural world together. She becomes obsessed with the idea of training her own goshawk, and so she brings the fearsome bird Mabel home to her life as a graduate fellow at Cambridge. \\n\\nHelen fills the freezer with hawk food and turns off her phone, ready to embark on the long, strange business of trying to train this wildest of animals. But as she labours to tame Mabel, a grieving Helen undergoes an untaming of her own. \\n\\nA record of a spiritual journey, H IS FOR HAWK is a story about memory and nature and how it might be possible to reconcile death with life and love.\\n\\n★★★★ - Daily Telegraph\",\"starring\":\"Claire Foy, Brendan Gleeson, Angus Cooper\",\"directedBy\":\"Philippa Lowthorpe\",\"producedBy\":\"Lena Headey, Dede Gardner, Jeremy Kleiner\",\"searchTerms\":\"\",\"duration\":128,\"genre\":\"Drama\",\"allGenres\":\"Drama\",\"rating\":\"12A\",\"trailerYoutubeId\":\"RJ29BBXfN64\",\"trailerVideo\":null,\"releaseDate\":\"2026-02-03\",\"dateOfFirstShowing\":\"2026-02-03\",\"tmdbPopularityScore\":3.8577,\"tmdbId\":\"1243006\",\"dcmEdiMovieId\":\"477805\",\"dcmEdiMovieName\":\"No Match Found\",\"siteId\":\"93\",\"titleClassId\":\"157\",\"showings\":[{\"id\":\"390147\",\"time\":\"2026-02-03T11:30:00Z\",\"ticketsSold\":0,\"screenId\":\"140\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"carers--babies sc1\\\"}\"}]},{\"id\":\"33903\",\"name\":\"A ROOM WITH A VIEW\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"a-room-with-a-view\",\"posterImage\":\"4gjyex58mcvar5f1zrpwqfg4ik6q\",\"bannerImage\":\"crqdhe1mrkkw7cf8wxxglvkv7cwp\",\"synopsis\":\"Lucy Honeychurch shares a brief romance with George Emerson in Florence. Yet as she tries to move on with her life and look for marriage elsewhere, can she truly forget the events of that summer?\\n\\nPlease note: this screening will not have any ads or trailer so please arrive at the allocated time.\\n\\n\\u003ca href=\\\"https://actonecinema.co.uk/classic-matinee\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\"\\u003eClassic Matinee\\u003c/a\\u003e is a monthly screening of famous and undiscovered classics. Following the films there is a chance to socialise with free tea, coffee and biscuits. Tickets for the over 60's are just £5.00, carers go free and we welcome people living with dementia and care home residents (please contact us if you want to bring a group).\",\"starring\":\"Helena Bonham Carter, Julian Sands, Maggie Smith\",\"directedBy\":\"James Ivory\",\"producedBy\":\"Ismail Merchant\",\"searchTerms\":\"\",\"duration\":117,\"genre\":\"Drama\",\"allGenres\":\"Drama, Thriller\",\"rating\":\"PG\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2007-01-01\",\"dateOfFirstShowing\":\"2026-02-03\",\"tmdbPopularityScore\":2.0944,\"tmdbId\":\"11257\",\"dcmEdiMovieId\":\"\",\"dcmEdiMovieName\":null,\"siteId\":\"93\",\"titleClassId\":\"159\",\"showings\":[{\"id\":\"390148\",\"time\":\"2026-02-03T14:20:00Z\",\"ticketsSold\":4,\"screenId\":\"140\",\"seatsRemaining\":56,\"displayMetaData\":\"{\\\"classes\\\":\\\"classic-matinee sc1\\\"}\"}]},{\"id\":\"17560\",\"name\":\"FUN IN THE LOUNGE - FREE ENTRY: BOARD GAMES\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"fun-at-the-lounge---free-entry-board-games\",\"posterImage\":\"zd1egphtlaiiru9m2qozcm3pk83r\",\"bannerImage\":\"e2jlqavsfbw2kiq8hw5fgu6hmi37\",\"synopsis\":\"FREE ENTRY - Please RSVP for free below so we can manage numbers - Donations help us keep our community events free!\\n\\nOur Board Games Evenings take place the first Wednesday of every month.\\n\\nGet notified of all our free events by becoming a member on our Meetup Groups: \\u003ca href=\\\"https://www.meetup.com/west-london-board-games-meetup-group/\\\"\\u003eWest London Board Games\\u003c/a\\u003e and \\u003ca href=\\\"https://www.meetup.com/free-open-mic-jazz-nights-in-west-london/\\\"\\u003eFree Open Mic \\u0026 Jazz Nights in West London\\u003c/a\\u003e!\\n\\nJoin us for an evening of gaming fun, chat and drinks! Whether you're a seasoned gamer or brand new to the world of board games, this event is perfect for everyone. You can bring and host your own games, join other people's games or play one from our newbie-friendly collection. If you don't know how to play a game someone will teach you and if you come alone we'll help you find a group.\\n\\nSome notes:\\nYou can join anytime after 6pm, but the earliest you come, the easier will be to find a group.\\nAll the games either belong to the group or to individuals who come to the meetup. Please take good care of all games - be careful with nearby drinks, help put everything back in the box after you're done and return them to the owner/organiser.\\nWe are of course LGBTQI+ friendly!\\nPets are welcome!\",\"starring\":null,\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":240,\"genre\":null,\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-02-04\",\"dateOfFirstShowing\":\"2026-02-04\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"37604\",\"dcmEdiMovieName\":\"All The Best - The Fun Begins (2D) [PG]\",\"siteId\":\"93\",\"titleClassId\":\"277\",\"showings\":[{\"id\":\"216648\",\"time\":\"2024-09-04T17:00:00Z\",\"ticketsSold\":4,\"screenId\":\"301\",\"seatsRemaining\":46,\"displayMetaData\":\"{\\\"classes\\\":\\\"special-event fun-at-the-lounge\\\"}\"},{\"id\":\"221735\",\"time\":\"2024-10-02T17:00:00Z\",\"ticketsSold\":7,\"screenId\":\"301\",\"seatsRemaining\":43,\"displayMetaData\":\"{\\\"classes\\\":\\\"special-event fun-at-the-lounge\\\"}\"},{\"i