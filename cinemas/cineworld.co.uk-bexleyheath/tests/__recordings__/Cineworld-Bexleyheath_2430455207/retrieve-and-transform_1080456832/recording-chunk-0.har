          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014752\",\"name\":\"RBO Cinema Season 2026-27: Macbeth\",\"originalName\":\"RBO Cinema Season 2026-27: Macbeth\",\"length\":210,\"posterLink\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Macbeth/HO00014752/TV_SmallPosterImage/20260528-060740074.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Macbeth/HO00014752/TV_LargePosterImage/20260528-060645901.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/rbo-cinema-season-2026-27-macbeth/ho00014752\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Quinn Kelsey, Lise Davidsen, Freddie De Tommaso, Ryan Speedo Green\",\"directors\":\"Louisa Proske\",\"synopsis\":\"Two of opera’s most extraordinary artists return to The Met: Live in HD for Verdi’s thrilling take on the immortal Shakespearean tale of the scheming couple determined to seize power at any cost. Following past triumphs in many of Verdi’s signature baritone roles, Quinn Kelsey is the Scottish king haunted by the ghosts of his murderous ascent to the throne, opposite Lise Davidsen—the world’s reigning dramatic soprano—as the power-mad Lady Macbeth, whose ruinous ambition damns them both. Met Music Director Yannick Nézet-Séguin takes the podium for a penetrating production by Louisa Proske, a brilliant young director making waves around the world. Rounding out the all-star cast are tenor Freddie De Tommaso as the heroic Macduff and bass-baritone Ryan Speedo Green as Macbeth’s friend-turned-victim Banquo. This production is part of the Met’s award-winning Live in HD series, bringing opera to cinemas across the globe.\",\"dateStarted\":\"2026-10-20T00:00:00\",\"eventCount\":79,\"categoriesAttributes\":[],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"alternative-content\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Macbeth/HO00014752/TV_TopShelfPosterImage/20260528-060645901.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Macbeth/HO00014752/TV_SmallPosterImage/20260528-060740074.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Macbeth/HO00014752/Mobile_MovieThumbnail/20260528-060645901.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Macbeth/HO00014752/TV_LargePosterImage/20260528-060645901.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Macbeth/HO00014752/Mobile_MovieFeed/20260528-060709505.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"TRAFALGAR RELEASING\"}}}",
