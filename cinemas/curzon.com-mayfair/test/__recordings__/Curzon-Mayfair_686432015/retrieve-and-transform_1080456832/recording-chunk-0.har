tributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"MAY1-32393\",\"schedule\":{\"businessDate\":\"2026-02-02\",\"startsAt\":\"2026-02-02T20:15:00+00:00\",\"endsAt\":\"2026-02-02T23:08:00+00:00\",\"filmStartsAt\":\"2026-02-02T20:40:00+00:00\",\"filmEndsAt\":\"2026-02-02T23:08:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-2-8\",\"filmId\":\"HO00006557\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-2\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"MAY1-32392\",\"schedule\":{\"businessDate\":\"2026-02-02\",\"startsAt\":\"2026-02-02T20:45:00+00:00\",\"endsAt\":\"2026-02-02T22:56:00+00:00\",\"filmStartsAt\":\"2026-02-02T21:10:00+00:00\",\"filmEndsAt\":\"2026-02-02T22:56:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-1-10\",\"filmId\":\"HO00006693\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-1\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000003\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"MAY1\",\"name\":{\"text\":\"Mayfair\",\"translations\":[]},\"location\":{\"latitude\":51.5066,\"longitude\":-0.1479},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"38 Curzon Street,\",\"line2\":\"London,\",\"city\":\"W1J 7TY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006557\",\"title\":{\"text\":\"Nuremberg\",\"translations\":[]},\"synopsis\":{\"text\":\"In the immediate aftermath of the Second World War, as the world grapples with the unveiled horrors of the Holocaust, U.S. Army psychiatrist Lt. Col. Douglas Kelley (Rami Malek) is assigned the extraordinary task of assessing the mental state of Hermann Göring (Russell Crowe), the notorious former Reichsmarschall and Hitler’s second in command, along with other high ranking Nazi officials.\\nAs the Allies – led by the unyielding chief U.S. prosecutor, Supreme Court Justice Robert H. Jackson (Michael Shannon) alongside Sgt. Howie Triest (Leo Woodall), David Maxwell-Fyfe (Richard E. Grant), Gustave Gilbert (Colin Hanks), Col. John Amen (Mark O’Brien) and Burton C. Andrus (John Slattery) – navigate the monumental task of creating an unprecedented international tribunal to ensure the Nazi regime answers for its atrocities, Kelley gets to know his ‘patients’. But he soon finds himself locked in a psychological duel with Göring, whose charisma and cunning reveal a sobering truth: that ordinary men can commit extraordinary evil.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Allies, led by the unyielding chief prosecutor, Robert H. Jackson (Michael Shannon), have the task of ensuring the Nazi regime answers for the unveiled horrors.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"images of real dead bodies, Holocaust references, strong violence\",\"translations\":[]},\"releaseDate\":\"2025-11-14\",\"runtimeInMinutes\":148,\"trailerUrl\":\"https://www.youtube.com/watch?v=WvAy9C-bipY\",\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001228\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001276\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002501\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000002502\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002870\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003677\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008524\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010518\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011757\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012532\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012533\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012534\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012535\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012536\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012537\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012538\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012539\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012540\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012541\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a9352d00-a535-4fe7-ac89-71294e5ef2ca\",\"corporateId\":null},\"hopk\":\"HO00006557\",\"hoCode\":\"A000008098\",\"eventId\":null,\"distributorName\":\"Studio Canal\"},{\"id\":\"HO00006677\",\"title\":{\"text\":\"Hamnet\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"distressing scenes, brief moderate sex\",\"translations\":[]},\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":126,\"trailerUrl\":\"https://www.youtube.com/watch?v=Y9Tv9wGPxIw\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000175\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001040\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001087\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002138\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002310\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004702\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004703\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005314\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007765\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c566d7dc-50bb-4d55-984b-c4c65751933e\",\"corporateId\":null},\"hopk\":\"HO00006677\",\"hoCode\":\"A000008241\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006686\",\"title\":{\"text\":\"H is for Hawk\",\"translations\":[]},\"synopsis\":{\"text\":\"When Helen's beloved father passes away, she is knocked sideways by grief and loses herself in memories of their time birding and exploring the natural world together. She becomes obsessed with the idea of training her own goshawk, and so she brings the fearsome bird Mabel home to her life as a graduate fellow at Cambridge. Helen fills the freezer with hawk food and turns off her phone, ready to embark on the long, strange business of trying to train this wildest of animals. But as she labours to tame Mabel, a grieving Helen undergoes an untaming of her own. A record of a spiritual journey, H IS FOR HAWK is a story about memory and nature and how it might be possible to reconcile death with life and love.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When Helen's beloved father passes away, she is knocked sideways by grief and loses herself in memories of their time birding and exploring the natural world together.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, drug misuse, injury detail, sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=RJ29BBXfN64\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000166\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000167\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000254\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002250\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007943\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012811\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012812\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012813\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012814\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012815\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e652fb82-1635-4421-a615-6bd0166c8771\",\"corporateId\":null},\"hopk\":\"HO00006686\",\"hoCode\":\"A000008251\",\"eventId\":null,\"distributorName\":\"Lionsgate\"},{\"id\":\"HO00006689\",\"title\":{\"text\":\"No Other Choice\",\"translations\":[]},\"synopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":139,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000012169\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012827\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012828\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012829\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012830\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012831\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000026\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9ecc0908-a983-42f7-9591-6f8d73d7488b\",\"corporateId\":null},\"hopk\":\"HO00006689\",\"hoCode\":\"A000008255\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00006693\",\"title\":{\"text\":\"Nouvelle Vague\",\"translations\":[]},\"synopsis\":{\"text\":\"A playful, poignant love letter to cinema, Nouvelle Vague reimagines the making of Jean-Luc Godard’s Breathless in an exuberant exploration of the youthful rebellion and creative chaos that shaped the French New Wave.\\n\\nDirected by Richard Linklater, starring Zoey Deutch, Guillaume Marbeck, and Aubry Dullin.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A playful, poignant love letter to cinema, Nouvelle Vague reimagines the making of Jean-Luc Godard’s Breathless in an exuberant exploration of the youthful rebellion.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":106,\"trailerUrl\":\"https://www.youtube.com/watch?v=sRqWbsdACzg\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002634\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008603\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012851\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012852\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012853\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012854\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012855\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012856\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012857\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"8ddd1648-0036-4a88-99b9-4b2eb84d4838\",\"corporateId\":null},\"hopk\":\"HO00006693\",\"hoCode\":\"A000008259\",\"eventId\":null,\"distributorName\":\"Altitude Film Distribution\"},{\"id\":\"