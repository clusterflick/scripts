            "mimeType": "application/json; charset=utf-8",
            "text": "{\"name\":\"Mayfair\",\"urlSegment\":\"mayfair\",\"url\":\"/venues/mayfair/\",\"nodeId\":1808,\"alias\":\"cinema\",\"createDate\":\"2024-08-13T14:58:09\\u002B01:00\",\"updateDate\":\"2026-01-28T09:53:25\\u002B00:00\",\"versions\":{\"\":\"https://www.curzon.com/venues/mayfair/\"},\"robotsNoIndex\":false,\"robotsNoFollow\":false,\"masterCanonicalUrl\":null,\"excludeCanonicalUrl\":false,\"seoImage\":null,\"metaKeywords\":\"\",\"metaDescription\":\"Find out what\\u0027s on at Curzon Cinema in Mayfair. Check out the latest blockbuster movies, new Indie film releases and the best of world cinema out now.\",\"seoPageTitle\":\"Curzon Mayfair Cinema Showtimes \\u0026 Film Listings\",\"oGType\":\"\",\"twitterCard\":\"\",\"seoUrl\":\"\",\"oGLocale\":\"\",\"excludeFromXmlSitemap\":false,\"excludeFromSiteSearch\":false,\"pageTitle\":\"Curzon Mayfair Cinema Showtimes \\u0026 Film Listings\",\"hideTitle\":false,\"grid\":[{\"name\":\"gridCarouselQuotes\",\"columns\":[{\"size\":12,\"elements\":[{\"type\":\"gridCarouselQuotes\",\"value\":[{\"stars\":5,\"quoteHeadline\":\"Comfy sofa seating , spacious legroom, friendly staff and above all great distinctive classic vibe\",\"subHeadline\":\"Osama Al Nasir, google reviews\",\"backgroundColour\":{\"color\":\"64ccc9\",\"label\":\"aqua\"}},{\"stars\":5,\"quoteHeadline\":\"An exquisite venue right in the heart of Mayfair with excellent concessions, friendly staff, and comfortable seats. Truly a treat well worth the price of admission.\",\"subHeadline\":\"Alexander Klein, google reviews\",\"backgroundColour\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"stars\":5,\"quoteHeadline\":\"State of the art screen. Relaxed atmosphere. Beautiful cinema in a lovely part of London.\",\"subHeadline\":\"Leo IlGattopardo, google reviews\",\"backgroundColour\":{\"color\":\"a5b99c\",\"label\":\"green-navy\"}}],\"config\":{\"background\":null,\"fullWidth\":false,\"wideBackground\":false}}],\"config\":{}}],\"config\":{\"background\":null,\"fullWidth\":false,\"wideBackground\":false}}],\"redirectDetailsElement\":{\"redirect\":false,\"permanent\":false},\"heroCarouselDetailsElement\":[{\"image\":{\"mobile\":\"/media/v3bmqdhf/open.webp?width=393\\u0026height=169\\u0026v=1dc903b9a6542f0\",\"tablet\":\"/media/v3bmqdhf/open.webp?width=782\\u0026height=315\\u0026v=1dc903b9a6542f0\",\"desktop\":\"/media/v3bmqdhf/open.webp?width=1216\\u0026height=523\\u0026v=1dc903b9a6542f0\",\"alt\":\"\"},\"textHeading\":\"ON TUESDAY 3 FEBRUARY OUR VENUES WILL OPEN AT 12PM\"},{\"image\":{\"mobile\":\"/media/a4vnrb1y/mayfair1.jpg?width=393\\u0026height=169\\u0026v=1dbb5f6e34dca70\",\"tablet\":\"/media/a4vnrb1y/mayfair1.jpg?width=782\\u0026height=315\\u0026v=1dbb5f6e34dca70\",\"desktop\":\"/media/a4vnrb1y/mayfair1.jpg?width=1216\\u0026height=523\\u0026v=1dbb5f6e34dca70\",\"alt\":\"\"},\"textHeading\":\"WELCOME TO CURZON MAYFAIR\",\"actionLink\":{\"name\":\"take a tour\",\"target\":\"_blank\",\"url\":\"https://tours.360virtualtours.co.uk/curzon/mayfair/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/px2iem4l/st-mungos-web.jpg?width=393\\u0026height=169\\u0026v=1dc44fc6573af80\",\"tablet\":\"/media/px2iem4l/st-mungos-web.jpg?width=782\\u0026height=315\\u0026v=1dc44fc6573af80\",\"desktop\":\"/media/px2iem4l/st-mungos-web.jpg?width=1216\\u0026height=523\\u0026v=1dc44fc6573af80\",\"alt\":\"\"},\"textHeading\":\"Support St Mungo\\u0027s on your Curzon cinema visit\",\"actionLink\":{\"name\":\"FIND OUT MORE\",\"url\":\"https://www.curzon.com/charity/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/5c4bhbxo/coffee-cake.jpg?width=393\\u0026height=169\\u0026v=1db9da6ab2ee1f0\",\"tablet\":\"/media/5c4bhbxo/coffee-cake.jpg?width=782\\u0026height=315\\u0026v=1db9da6ab2ee1f0\",\"desktop\":\"/media/5c4bhbxo/coffee-cake.jpg?width=1216\\u0026height=523\\u0026v=1db9da6ab2ee1f0\",\"alt\":\"\"},\"textHeading\":\"Food and drink\",\"actionLink\":{\"name\":\"View Menu\",\"target\":\"_blank\",\"url\":\"/media/u53o0rk2/menu-5_oct2025_updated.pdf\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/idflj0l2/ph-mayfair.jpg?width=393\\u0026height=169\\u0026v=1dbb5f6e3026990\",\"tablet\":\"/media/idflj0l2/ph-mayfair.jpg?width=782\\u0026height=315\\u0026v=1dbb5f6e3026990\",\"desktop\":\"/media/idflj0l2/ph-mayfair.jpg?width=1216\\u0026height=523\\u0026v=1dbb5f6e3026990\",\"alt\":\"\"},\"textHeading\":\"HIRE THIS SPACE\",\"actionLink\":{\"name\":\"CONTACT US\",\"url\":\"https://www.curzon.com/private-hire/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/cjbjjnbp/mayfair2.jpg?width=393\\u0026height=169\\u0026v=1dbb5f6e385a350\",\"tablet\":\"/media/cjbjjnbp/mayfair2.jpg?width=782\\u0026height=315\\u0026v=1dbb5f6e385a350\",\"desktop\":\"/media/cjbjjnbp/mayfair2.jpg?width=1216\\u0026height=523\\u0026v=1dbb5f6e385a350\",\"alt\":\"\"},\"textHeading\":\"GET DIRECTIONS\",\"actionLink\":{\"name\":\"VIEW ON MAP\",\"url\":\"https://www.google.com/maps/place/Curzon\\u002BMayfair/@51.5063389,-0.150357,16z/data=!4m6!3m5!1s0x4876052f23047095:0xf7b1801c3b92a6d6!8m2!3d51.5065673!4d-0.1479457!16s%2Fg%2F11c1rg1qnm?entry=ttu\\u0026g_ep=EgoyMDI1MDcxMy4wIKXMDSoASAFQAw%3D%3D\"}},{\"image\":{\"mobile\":\"/media/xenl1e1p/mayfair4.jpg?width=393\\u0026height=169\\u0026v=1dbb5f6e32cade0\",\"tablet\":\"/media/xenl1e1p/mayfair4.jpg?width=782\\u0026height=315\\u0026v=1dbb5f6e32cade0\",\"desktop\":\"/media/xenl1e1p/mayfair4.jpg?width=1216\\u0026height=523\\u0026v=1dbb5f6e32cade0\",\"alt\":\"\"},\"textHeading\":\"WELCOME TO CURZON MAYFAIR\"}],\"cinemaLocationDetailsElement\":{\"venueCardImage\":{\"mobile\":\"/media/ahjdialu/cinema-venues-_mayfair.jpg?width=300\\u0026height=160\\u0026v=1db99895de3a190\",\"alt\":\"\"},\"addressLine1\":\"38 Curzon Street\",\"city\":\"London\",\"postcode\":\"W1J 7TY\",\"nearestStationName\":\"Hyde Park Corner or Green Park\",\"nearestStationType\":\"underground\"},\"vistaCinema\":{\"key\":\"MAY1\",\"value\":\"Mayfair\"},\"informationTabAccordions\":[{\"heading\":\"Opening times\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EMonday to Saturday:\\u003C/strong\\u003E The cinema opens 30 minutes before the first show\\u0027s programme begins and closes at midnight.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESunday:\\u003C/strong\\u003E Closes at 11.30pm.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cem\\u003EPlease be aware opening and closing times may be subject to change.\\u003C/em\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Screen info\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 1\\u003C/strong\\u003E\\u003Cbr\\u003E307 seats, including 32 premium Pullman seats, 2 Royal Boxes (4 seats each), 2 wheelchair spaces\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 2\\u003C/strong\\u003E\\u003Cbr\\u003E65 premium Pullman seats\\u003C/p\\u003E\"},{\"heading\":\"Accessibility\",\"body\":\"\\u003Cp\\u003EWheelchair access is provided on entrance to the building via a stairlift, which is subject to weight restrictions and is unsuitable for powered wheelchairs. Screen 1 is accessed via another dedicated lift. The foyer lift has a maximum weight limit of 225 kg. There is no step-free access to the Royal Boxes or Screen 2, which are up two flights of stairs. There is a wheelchair-accessible bathroom.\\u003C/p\\u003E\"},{\"heading\":\"Food and Drink\",\"body\":\"\\u003Cp\\u003EOur drinks menu includes a wide selection of cocktails, wine, craft beer, soft drinks and hot drinks.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022/media/u53o0rk2/menu-5_oct2025_updated.pdf\\u0022 target=\\u0022_blank\\u0022 title=\\u0022Menu 5 Oct2025 Updated\\u0022\\u003ESee our full menu here.\\u003C/a\\u003E\\u003C/p\\u003E\"},{\"heading\":\"HAPPY HOUR INFORMATION\",\"body\":\"\\u003Cp\\u003EAt this venue Happy Hour is 5pm to 10pm every day, 2 for \\u00A316 on all cocktails.\\u003C/p\\u003E\"},{\"heading\":\"Private hires\",\"body\":\"\\u003Cp\\u003EOur screens are available to rent for your private functions, email \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca href=\\u0022mailto:privatehires@curzon.com\\u0022\\u003Eprivatehires@curzon.com\\u003C/a\\u003E\\u003C/span\\u003E for more information.\\u003C/p\\u003E\\n\\u003Cp\\u003ETo find out more, visit our \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca href=\\u0022/private-hire/mayfair/\\u0022\\u003EPrivate Hires page.\\u003C/a\\u003E\\u003C/span\\u003E\\u003C/p\\u003E\"},{\"heading\":\"social media\",\"body\":\"\\u003Cp\\u003EInstagram: \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022https://www.instagram.com/curzon.mayfair?igsh=aWlnamhjem41cnp3\\u0022 target=\\u0022_blank\\u0022 data-anchor=\\u0022?igsh=aWlnamhjem41cnp3\\u0022\\u003Ecurzon.mayfair\\u003C/a\\u003E\\u003C/span\\u003E\\u003C/p\\u003E\"}],\"informationTabDescription\":\"\\u003Cp\\u003EOriginally built in 1934, our iconic flagship cinema is one of the finest surviving buildings of the postwar period, with its Sixties-inspired art deco ceiling, original marble bathrooms and sophisticated bar. The lavish main auditorium, which houses an 11m screen and two Royal Boxes, frequently plays host to red-carpet premieres and is a landmark location on the London cinema circuit.\\u003C/p\\u003E\",\"menuTabAccordions\":[{\"heading\":\"Snacks\",\"body\":\"\\u003Ctable border=\\u00221\\u0022 style=\\u0022border-collapse: collapse; width: 100%; height: 92.5px;\\u0022\\u003E\\n\\u003Ctbody\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18.5px;\\u0022\\u003EHummus \\u0026amp; Crispbread (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A36.25\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18.5px;\\u0022\\u003ENocellara Olives (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A34.75\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18.5px;\\u0022\\u003EJude\\u0027s Ice Cream\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18.5px; text-align: right;\\u0022\\u003E\\u00A33.90\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18.5px;\\u0022\\u003ESnacks\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18.5px; text-align: right;\\u0022\\u003Efrom \\u00A34.25\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003C/tbody\\u003E\\n\\u003C/table\\u003E\"},{\"heading\":\"Cakes \\u0026 Cookies\",\"body\":\"\\u003Ctable border=\\u00221\\u0022 style=\\u0022border-collapse: collapse; width: 100%; height: 72px;\\u0022\\u003E\\n\\u003Ctbody\\u003E\\n\\u003Ctr style=\\u0022height: 18px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18px;\\u0022\\u003ESelection of cakes, traybakes \\u0026amp; cookies\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18px; text-align: right;\\u0022\\u003Efrom \\u00A33.10\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18px;\\u0022\\u003ECoffee \\u0026amp; Cake Deal (Monday - Friday before 5PM)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18px; text-align: right;\\u0022\\u003E\\u00A36.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003C/tbody\\u003E\\n\\u003C/table\\u003E\"},{\"heading\":\"Cocktails \\u0026 Spirits\",\"body\":\"\\u003Ctable border=\\u00221\\u0022 style=\\u0022border