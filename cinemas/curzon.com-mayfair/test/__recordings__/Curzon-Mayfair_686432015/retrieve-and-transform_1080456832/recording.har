-6\",\"filmId\":\"HO00006110\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-1\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000003\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"MAY1-84-HO00006110\"},{\"id\":\"MAY1-30448\",\"schedule\":{\"businessDate\":\"2025-07-02\",\"startsAt\":\"2025-07-02T21:00:00+01:00\",\"endsAt\":\"2025-07-02T23:20:00+01:00\",\"filmStartsAt\":\"2025-07-02T21:25:00+01:00\",\"filmEndsAt\":\"2025-07-02T23:20:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-2-8\",\"filmId\":\"HO00006204\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-2\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"MAY1-85-HO00006204\"}],\"relatedData\":{\"sites\":[{\"id\":\"MAY1\",\"name\":{\"text\":\"Mayfair\",\"translations\":[]},\"location\":{\"latitude\":51.5066,\"longitude\":-0.1479},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"38 Curzon Street,\",\"line2\":\"London,\",\"city\":\"W1J 7TY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006204\",\"title\":{\"text\":\"28 Years Later\",\"translations\":[]},\"synopsis\":{\"text\":\"Academy Award®-winning director Danny Boyle and Academy Award®-nominated writer Alex Garland reunite for 28 Years Later, a terrifying new story set in the world created by 28 Days Later. It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine, some have found ways to exist amidst the infected. One such group of survivors lives on a small island connected to the mainland by a single, heavily-defended causeway. When one of the group leaves the island on a mission into the dark heart of the mainland, he discovers secrets, wonders, and horrors that have mutated not only the infected but other survivors as well.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine...\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-19\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=poEFz8Ivzug\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000313\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001100\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001270\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003206\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003678\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010558\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011257\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000011418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011419\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a7823fd3-66f7-47af-87ba-d36ef45b168c\",\"corporateId\":null},\"hopk\":\"HO00006204\",\"hoCode\":\"A000007660\",\"eventId\":null,\"distributorName\":\"Sony Pictures\"},{\"id\":\"HO00006212\",\"title\":{\"text\":\"Jane Austen Wrecked My Life\",\"translations\":[]},\"synopsis\":{\"text\":\"Agathe, hopelessly clumsy yet charming, and full of contradictions, dreams of experiencing love akin to a Jane Austen novel. Instead she finds herself stuck in desperate singlehood, spending her days working in the legendary British bookshop, Shakespeare & Co in Paris, rather than pursuing her own ambitions of becoming a novelist. But when an unexpected invitation to the Jane Austen Writers' Residency in England lands in her lap, Agathe is in for an eye-opening and life-changing experience. Encouraged to confront her insecurities and explore her true romantic, sexual and creative nature, in part thanks to her eccentric co-residents, Agathe realises it’s time to stop wasting her sentimental life and take control - over both her writing aspirations, and her very own love story.\\n\\nStarring Camille Rutherford (Anatomy of a Fall), Pablo Pauly (The French Dispatch) and Charlie Anson (Death on the Nile), Jane Austen Wrecked My Life is an uplifting and heart-warming throwback to classic romance, with a modern sensibility, marking the directorial debut of acclaimed screenwriter Laura Piani.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A desperately single bookseller, lost in a fantasy world, finds herself forced to fulfil her dreams of becoming a writer in order to stop messing up her love life.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, sex, sex references\",\"translations\":[]},\"releaseDate\":\"2025-06-13\",\"runtimeInMinutes\":98,\"trailerUrl\":\"https://www.youtube.com/watch?v=i0dy0doC358\",\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001844\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006034\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011462\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011463\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011464\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011465\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011466\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2e524f02-15b6-4d4b-97fb-d4656199c5bb\",\"corporateId\":null},\"hopk\":\"HO00006212\",\"hoCode\":\"A000007668\",\"eventId\":null,\"distributorName\":\"Icon\"},{\"id\":\"HO00006110\",\"title\":{\"text\":\"F1® The Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career. Thirty years later, he’s a nomadic racer-for-hire when he’s approached by his former teammate Ruben Cervantes (Javier Bardem), owner of a struggling FORMULA 1 team that is on the verge of collapse. Ruben convinces Sonny to come back to FORMULA 1 for one last shot at saving the team and being the best in the world. He’ll drive alongside Joshua Pearce (Damson Idris), the team's hotshot rookie intent on setting his own pace. But as the engines roar, Sonny’s past catches up with him and he finds that in FORMULA 1, your teammate is your fiercest competition—and the road to redemption is not something you can travel alone.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate threat\",\"translations\":[]},\"releaseDate\":\"2025-06-25\",\"runtimeInMinutes\":156,\"trailerUrl\":\"https://www.youtube.com/watch?v=TZGY2CWPXeU\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000166\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000167\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001693\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002986\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003190\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003191\",\"roles\":[\"Producer\