            "text": "{\"businessDate\":\"2025-09-04\",\"showtimes\":[{\"id\":\"MAY1-29607\",\"schedule\":{\"businessDate\":\"2025-09-04\",\"startsAt\":\"2025-09-04T19:00:00+01:00\",\"endsAt\":\"2025-09-04T21:00:00+01:00\",\"filmStartsAt\":\"2025-09-04T19:00:00+01:00\",\"filmEndsAt\":\"2025-09-04T21:00:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-1-6\",\"filmId\":\"HO00006045\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-1\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000003\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"MAY1\",\"name\":{\"text\":\"Mayfair\",\"translations\":[]},\"location\":{\"latitude\":51.5066,\"longitude\":-0.1479},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"38 Curzon Street,\",\"line2\":\"London,\",\"city\":\"W1J 7TY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006045\",\"title\":{\"text\":\"NT Live: Inter Alia\",\"translations\":[]},\"synopsis\":{\"text\":\"Oscar-nominated Rosamund Pike (Gone Girl, Saltburn) is Jessica in the much-anticipated next play from the team behind Prima Facie.      Jessica Parks is a smart Crown Court Judge at the top of her career. Behind the robe, she is a karaoke fiend, a loving wife and a supportive parent. When an event threatens to throw her life completely off balance, can she hold her family upright? \\nWriter Suzie Miller and director Justin Martin reunite following their global phenomenon Prima Facie, with this searing examination of modern motherhood and masculinity.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Oscar-nominated Rosamund Pike (Gone Girl, Saltburn) is Jessica in the much-anticipated next play from the team behind Prima Facie.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-09-04\",\"runtimeInMinutes\":120,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003120\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000007270\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\",\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"98eacf80-566d-4e38-8a71-7a5466052dd7\",\"corporateId\":null},\"hopk\":\"HO00006045\",\"hoCode\":\"A000007455\",\"eventId\":null,\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"0000003120\",\"name\":{\"givenName\":\"Justin\",\"familyName\":\"Martin\",\"middleName\":null}},{\"id\":\"0000007270\",\"name\":{\"givenName\":\"Rosamund\",\"familyName\":\"Pike\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":{\"text\":\"Drama\",\"translations\":[]}},{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000003\",\"name\":{\"text\":\"Live event\",\"translations\":[]},\"shortName\":{\"text\":\"Live\",\"translations\":[]},\"description\":{\"text\":\"Live Via Satellite\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"MAY1-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"MAY1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvaila