            "mimeType": "application/json; charset=utf-8",
            "size": 5429,
            "text": "{\"businessDate\":\"2025-11-30\",\"showtimes\":[{\"id\":\"MAY1-30177\",\"schedule\":{\"businessDate\":\"2025-11-30\",\"startsAt\":\"2025-11-30T14:00:00+00:00\",\"endsAt\":\"2025-11-30T17:15:00+00:00\",\"filmStartsAt\":\"2025-11-30T14:00:00+00:00\",\"filmEndsAt\":\"2025-11-30T17:15:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-1-6\",\"filmId\":\"HO00006227\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-1\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000003\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000017\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"MAY1\",\"name\":{\"text\":\"Mayfair\",\"translations\":[]},\"location\":{\"latitude\":51.5066,\"longitude\":-0.1479},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"38 Curzon Street,\",\"line2\":\"London,\",\"city\":\"W1J 7TY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006227\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: Cinderella\",\"translations\":[]},\"synopsis\":{\"text\":\"Stuck at home and put to work by her spoiled Step-Sisters, Cinderella’s life is dreary and dull. Everything changes when she helps a mysterious woman out...With a little bit of magic, she is transported into an ethereal new world – one where fairies bring the gifts of the seasons, where pumpkins turn into carriages, and where true love awaits. \\nThis enchanting ballet by The Royal Ballet’s Founding Choreographer Frederick Ashton is a theatrical experience for all the family and will transport you into an ethereal world where a sprinkling of fairy dust makes dreams come true.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Stuck at home and put to work by her spoiled Step-Sisters, Cinderella’s life is dreary and dull. Everything changes when she helps a mysterious woman out...\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-25\",\"runtimeInMinutes\":195,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001474\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011529\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011530\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011532\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011533\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011534\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3646\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"9291\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000290\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000291\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"88d0e3c2-d7a3-443d-821c-0953c1b7157f\",\"corporateId\":null},\"hopk\":\"HO00006227\",\"hoCode\":\"A000007684\",\"eventId\":\"0000000042\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000001474\",\"name\":{\"givenName\":\"Isabella\",\"familyName\":\"Gasparini\",\"middleName\":null}},{\"id\":\"0000011529\",\"name\":{\"givenName\":\"Bennet\",\"familyName\":\"Gartside\",\"middleName\":null}},{\"id\":\"0000011530\",\"name\":{\"givenName\":\"James\",\"familyName\":\"Hay\",\"middleName\":null}},{\"id\":\"0000011531\",\"name\":{\"givenName\":\"Mariko\",\"familyName\":\"Sasaki\",\"middleName\":null}},{\"id\":\"0000011532\",\"name\":{\"givenName\":\"Meaghan Grace\",\"familyName\":\"Hinkis\",\"middleName\":null}},{\"id\":\"0000011533\",\"name\":{\"givenName\":\"Claire\",\"familyName\":\"Calvert\",\"middleName\":null}},{\"id\":\"0000011534\",\"name\":{\"givenName\":\"Da