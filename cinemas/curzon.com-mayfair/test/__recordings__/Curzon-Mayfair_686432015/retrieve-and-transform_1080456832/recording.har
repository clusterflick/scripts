        "response": {
          "bodySize": 5257,
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 5257,
            "text": "{\"businessDate\":\"2025-10-21\",\"showtimes\":[{\"id\":\"MAY1-30174\",\"schedule\":{\"businessDate\":\"2025-10-21\",\"startsAt\":\"2025-10-21T18:45:00+01:00\",\"endsAt\":\"2025-10-21T22:00:00+01:00\",\"filmStartsAt\":\"2025-10-21T18:45:00+01:00\",\"filmEndsAt\":\"2025-10-21T22:00:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-1-6\",\"filmId\":\"HO00006234\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-1\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000003\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000017\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"MAY1\",\"name\":{\"text\":\"Mayfair\",\"translations\":[]},\"location\":{\"latitude\":51.5066,\"longitude\":-0.1479},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"38 Curzon Street,\",\"line2\":\"London,\",\"city\":\"W1J 7TY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006234\",\"title\":{\"text\":\"Met Opera 2025-26: La Sonnambula\",\"translations\":[]},\"synopsis\":{\"text\":\"Following triumphant Live in HD performances in Gounod’s Roméo et Juliette, Verdi’s La Traviata, and Donizetti’s Lucia di Lammermoor, Nadine Sierra summits another peak of the soprano repertoire as Amina, who sleepwalks her way into audiences’ hearts in Bellini’s poignant tale of love lost and found. In his new production, Rolando Villazón—the tenor who has embarked on a brilliant second career as a director—retains the opera’s original setting in the Swiss Alps but uses its somnambulant plot to explore the emotional and psychological valleys of the mind. Tenor Xabier Anduaga co-stars as Amina’s fiancé, Elvino, alongside soprano Sydney Mancasola as her rival, Lisa, and bass Alexander Vinogradov as Count Rodolfo. Riccardo Frizza takes the podium for one of opera’s most ravishing works, which will be transmitted live from the Met stage to cinemas on October 18. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Following triumphant Live in HD performances in Gounod’s Roméo et Juliette, Verdi’s La Traviata, and Donizetti’s Lucia di Lammermoor, Nadine Sierra summits another peak \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-10-18\",\"runtimeInMinutes\":195,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000000922\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001591\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000613\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000614\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000615\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000616\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4848c0c5-a740-4604-959c-474008908332\",\"corporateId\":null},\"hopk\":\"HO00006234\",\"hoCode\":\"A000007691\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000000922\",\"name\":{\"givenName\":\"Alexander \",\"familyName\":\"Vinogradov\",\"middleName\":null}},{\"id\":\"0000001591\",\"name\":{\"givenName\":\"Nadine \",\"familyName\":\"Sierra\",\"middleName\":null}},{\"id\":\"HO00000613\",\"name\":{\"givenName\":\"Riccardo\",\"familyName\":\"Frizza\",\"middleName\":null}},{\"id\":\"HO00000614\",\"name\":{\"givenName\":\"Sydney\",\"familyName\":\"Mancasola\",\"middleName\":null}},{\"id\":\"HO00000615\",\"name\":{\"givenName\":\"Xabier\",\"familyName\":\"Anduag