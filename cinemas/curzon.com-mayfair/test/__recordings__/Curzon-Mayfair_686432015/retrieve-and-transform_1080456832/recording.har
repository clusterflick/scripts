            "mimeType": "application/json; charset=utf-8",
            "size": 4036,
            "text": "{\"businessDate\":\"2025-12-14\",\"showtimes\":[{\"id\":\"MAY1-30178\",\"schedule\":{\"businessDate\":\"2025-12-14\",\"startsAt\":\"2025-12-14T14:00:00+00:00\",\"endsAt\":\"2025-12-14T17:30:00+00:00\",\"filmStartsAt\":\"2025-12-14T14:00:00+00:00\",\"filmEndsAt\":\"2025-12-14T17:30:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-1-6\",\"filmId\":\"HO00006228\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-1\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000003\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000017\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"MAY1\",\"name\":{\"text\":\"Mayfair\",\"translations\":[]},\"location\":{\"latitude\":51.5066,\"longitude\":-0.1479},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"38 Curzon Street,\",\"line2\":\"London,\",\"city\":\"W1J 7TY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006228\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: The Nutcracker\",\"translations\":[]},\"synopsis\":{\"text\":\"The magician Herr Drosselmeyer needs to save his nephew. Hans-Peter has been transformed into a Nutcracker; the only way to save him is for the Nutcracker to defeat the Mouse King and find a girl to love and care for him. A flicker of hope comes in the form of the young Clara, whom Drosselmeyer meets at a Christmas party. With some magic, a cosy Christmas gathering turns into a marvellous adventure. \\nPeter Wright’s The Nutcracker has enchanted audiences since its 1984 premiere by the Company. Featuring Tchaikovsky’s most familiar melodies and brought to life by Julia Trevelyan Oman’s exquisite designs, The Nutcracker is sure to be a festive firecracker for all ages.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The magician Herr Drosselmeyer needs to save his nephew. Hans-Peter has been transformed into a Nutcracker.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-10\",\"runtimeInMinutes\":210,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"HO00000292\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b3549712-da50-415c-811f-783459340cae\",\"corporateId\":null},\"hopk\":\"HO00006228\",\"hoCode\":\"A000007685\",\"eventId\":\"0000000042\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"HO00000292\",\"name\":{\"givenName\":\"Peter \",\"familyName\":\"Wright\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Encore\",\"translations\":[]},\"shortName\":{\"text\":\"Encore\",\"translations\":[]},\"description\":{\"text\":\"Encore\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false},{\"id\":\"0000000017\",\"name\":{\"text\":\"Members preview\",\"translations\":[]},\"shortName\":{\"text\":\"Members\",\"translations\":[]},\"description\":{\"text\":\"Members' only preview screening.\",\"translations\":[]},\"importantMessage\":{\"text\":\"Members' only preview screening.\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"MAY1-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"MAY1-0000000001\",\"name\"