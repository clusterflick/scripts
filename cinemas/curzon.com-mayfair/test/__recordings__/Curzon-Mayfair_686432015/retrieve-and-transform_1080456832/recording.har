            "text": "{\"businessDate\":\"2025-09-26\",\"showtimes\":[{\"id\":\"MAY1-29609\",\"schedule\":{\"businessDate\":\"2025-09-26\",\"startsAt\":\"2025-09-26T14:00:00+01:00\",\"endsAt\":\"2025-09-26T16:10:00+01:00\",\"filmStartsAt\":\"2025-09-26T14:10:00+01:00\",\"filmEndsAt\":\"2025-09-26T16:10:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-2-8\",\"filmId\":\"HO00006045\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-2\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"MAY1\",\"name\":{\"text\":\"Mayfair\",\"translations\":[]},\"location\":{\"latitude\":51.5066,\"longitude\":-0.1479},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"38 Curzon Street,\",\"line2\":\"London,\",\"city\":\"W1J 7TY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006045\",\"title\":{\"text\":\"NT Live: Inter Alia\",\"translations\":[]},\"synopsis\":{\"text\":\"Oscar-nominated Rosamund Pike (Gone Girl, Saltburn) is Jessica in the much-anticipated next play from the team behind Prima Facie.      Jessica Parks is a smart Crown Court Judge at the top of her career. Behind the robe, she is a karaoke fiend, a loving wife and a supportive parent. When an event threatens to throw her life completely off balance, can she hold her family upright? \\nWriter Suzie Miller and director Justin Martin reunite following their global phenomenon Prima Facie, with this searing examination of modern motherhood and masculinity.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Oscar-nominated Rosamund Pike (Gone Girl, Saltburn) is Jessica in the much-anticipated next play from the team behind Prima Facie.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":