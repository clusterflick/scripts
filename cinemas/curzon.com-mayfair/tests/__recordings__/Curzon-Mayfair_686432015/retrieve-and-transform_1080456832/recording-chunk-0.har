InMinutes\":106,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/ad147b9a-b731-410f-8bf9-c4f3f3df2095/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=jnLW-q2ftKA\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=jnLW-q2ftKA\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001093\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002460\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003915\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"0000004392\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004710\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007157\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013073\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014130\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000002460\"},{\"castAndCrewMemberId\":\"0000003915\"},{\"castAndCrewMemberId\":\"0000004392\"},{\"castAndCrewMemberId\":\"0000004710\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000003915\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000001093\"},{\"castAndCrewMemberId\":\"0000007157\"},{\"castAndCrewMemberId\":\"0000013073\"},{\"castAndCrewMemberId\":\"0000014130\"}],\"genreIds\":[\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ad147b9a-b731-410f-8bf9-c4f3f3df2095\",\"corporateId\":null},\"hopk\":\"HO00007147\",\"hoCode\":\"A000008799\",\"eventId\":null,\"distributorName\":\"Black Bear\"},{\"id\":\"HO00007149\",\"title\":{\"text\":\"My Father's Island\",\"translations\":[]},\"synopsis\":{\"text\":\"A haunted young man travels to a remote island to reconnect with his father and confront the traumatic experience they shared ten years prior that transformed their relationship.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A haunted young man travels to a remote island to reconnect with his father and confront the traumatic experience they shared ten years prior.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":115,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=Bbzz7xen8_w\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=Bbzz7xen8_w\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000742\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000883\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001919\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007115\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010848\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014134\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014135\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000742\"},{\"castAndCrewMemberId\":\"0000001919\"},{\"castAndCrewMemberId\":\"0000007115\"},{\"castAndCrewMemberId\":\"0000010848\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000014134\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000000883\"},{\"castAndCrewMemberId\":\"0000014135\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2a37c6f4-778b-41b0-9931-14ff5aee2189\",\"corporateId\":null},\"hopk\":\"HO00007149\",\"hoCode\":\"A000008801\",\"eventId\":null,\"distributorName\":\"Curzon\"},{\"id\":\"HO00007152\",\"title\":{\"text\":\"Rosebush Pruning\",\"translations\":[]},\"synopsis\":{\"text\":\"Underneath the Catalonian sun, a rich white American family lives in hedonistic isolation, seeking love and validation through one another, their designer wardrobes and pop music. When an outsider infiltrates the family, buried tensions surface and blood ties are severed. \\n\\nAn outrageous, biting satire on the absurdity of patriarchal family, starring Callum Turner, Riley Keough, Jamie Bell, Lukas Gage, Elena Anaya, Tracy Letts, Elle Fanning and Pamela Anderson.\\n\\nFrom award winning director Karim Aïnouz, written by Oscar nominated writer Efthimis Filippou, ROSEBUSH PRUNING is absurd, funny and in equal measure. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Underneath the Catalonian sun, a rich white American family lives in hedonistic isolation, seeking love and validation through one another, their designer wardrobes\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":{\"text\":\"sexual violence, strong sex, nudity\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":95,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/ab78ddcf-eae4-4e1c-9d6a-68f6392793c8/media/TrailerVideo\"}],\"trailerUrl\":null,\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000497\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000736\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001041\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001073\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001820\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005512\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006483\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007166\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008082\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008105\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010500\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013540\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014145\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001041\"},{\"castAndCrewMemberId\":\"0000001073\"},{\"castAndCrewMemberId\":\"0000005512\"},{\"castAndCrewMemberId\":\"0000006483\"},{\"castAndCrewMemberId\":\"0000007166\"},{\"castAndCrewMemberId\":\"0000008105\"},{\"castAndCrewMemberId\":\"0000010500\"},{\"castAndCrewMemberId\":\"0000014145\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000001820\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000000497\"},{\"castAndCrewMemberId\":\"0000000736\"},{\"castAndCrewMemberId\":\"0000008082\"},{\"castAndCrewMemberId\":\"0000013540\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ab78ddcf-eae4-4e1c-9d6a-68f6392793c8\",\"corporateId\":null},\"hopk\":\"HO00007152\",\"hoCode\":\"A000008804\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00007178\",\"title\":{\"text\":\"Amores perros: Alejandro González Iñárritu Q&A\",\"translations\":[]},\"synopsis\":{\"text\":\"To celebrate the 25th anniversary of Amores Perros and its global streaming premiere on MUBI on 10 July, join us for a special screening of Alejandro G. Iñárritu's legendary debut — presented in a stunning new 4K restoration and co-hosted with MUBI and MACK, publishers of the official anniversary book.\\n\\nCentring on three interlocking narratives, it chronicles the Mexico City underworld through the perspectives of an amateur dog fighter, a supermodel and an assassin.\\n\\nFrom 6pm, copies of the book will be available to purchase in the foyer, with Alejandro G. Iñárritu present to sign them. At 7pm, the filmmaker will appear on stage for an exclusive Q&A ahead of the screening at 7.30pm.\\n\\nFive-time Academy Award winner Alejandro G. Iñárritu (The Revenant, Birdman, 21 Grams) returns to his debut, one of the most celebrated films of the 21st century – for one night only. \\n\\nThis event is presented in collaboration with MACK, MUBI and Curzon.\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Alejandro G. Iñárritu Q&A and book signing to celebrate 25 years since the release of his classic debut film.\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-16\",\"runtimeInMinutes\":154,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=_P29GF_NbDc\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=_P29GF_NbDc\",\"dis