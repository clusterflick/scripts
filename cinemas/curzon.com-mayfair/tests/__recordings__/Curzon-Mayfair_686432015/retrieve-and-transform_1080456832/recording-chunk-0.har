          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-05-02\",\"showtimes\":[{\"id\":\"MAY1-31972\",\"schedule\":{\"businessDate\":\"2026-05-02\",\"startsAt\":\"2026-05-02T18:00:00+01:00\",\"endsAt\":\"2026-05-02T22:05:00+01:00\",\"filmStartsAt\":\"2026-05-02T18:00:00+01:00\",\"filmEndsAt\":\"2026-05-02T22:05:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-1-6\",\"filmId\":\"HO00006235\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-1\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000003\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"MAY1\",\"name\":{\"text\":\"Mayfair\",\"translations\":[]},\"location\":{\"latitude\":51.5066,\"longitude\":-0.1479},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"38 Curzon Street,\",\"line2\":\"London,\",\"city\":\"W1J 7TY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006235\",\"title\":{\"text\":\"Met Opera 2025-26: Eugene Onegin\",\"translations\":[]},\"synopsis\":{\"text\":\"Following her acclaimed 2024 company debut in Puccini\u2019s Madama Butterfly, soprano Asmik Grigorian returns to the Met as Tatiana, the lovestruck young heroine in this ardent operatic adaptation of Pushkin, which will be transmitted live from the Metropolitan Opera stage to cinemas worldwide on May 2. Baritone Igor Golovatenko reprises his portrayal of the urbane Onegin, who realizes his affection for her all too late. The Met\u2019s evocative production, directed by Tony Award\u2013winner Deborah Warner, \u201coffers a beautifully detailed reading of \u2026 Tchaikovsky\u2019s lyrical romance\u201d (The Telegraph).\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Following her acclaimed 2024 company debut in Puccini\u2019s Madama Butterfly, soprano Asmik Grigorian returns to the Met as Tatiana, the lovestruck young heroine.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-05-02\",\"runtimeInMinutes\":245,\"trailerUrl\":null,\"displayPriority\":67,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001571\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003826\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000387\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000488\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000617\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000618\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000619\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000620\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006235\",\"hoCode\":\"A000007692\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000001571\",\"name\":{\"givenName\":\"Stephanie \",\"familyName\":\"Blythe\",\"middleName\":null}},{\"id\":\"0000003826\",\"name\":{\"givenName\":\"Alexander\",\"familyName\":\"Tsymbalyuk\",\"middleName\":null}},{\"id\":\"HO00000387\",\"name\":{\"givenName\":\"Asmik\",\"familyName\":\"Grigorian\",\"middleName\":null}},{\"id\":\"HO00000488\",\"name\":{\"givenName\":\"Stanislas\",\"familyName\":\"de Barbeyrac\",\"middleName\":null}},{\"id\":\"HO00000617\",\"name\":{\"givenName\":\"Timur\",\"familyName\":\"Zangiev\",\"middleName\":null}},{\"id\":\"HO00000618\",\"name\":{\"givenName\":\"Maria\",\"familyName\":\"Barakova\",\"middleName\":null}},{\"id\":\"HO00000619\",\"nam