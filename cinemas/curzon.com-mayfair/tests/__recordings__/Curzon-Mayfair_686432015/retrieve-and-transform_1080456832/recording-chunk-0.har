          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-05-30\",\"showtimes\":[{\"id\":\"MAY1-31973\",\"schedule\":{\"businessDate\":\"2026-05-30\",\"startsAt\":\"2026-05-30T18:00:00+01:00\",\"endsAt\":\"2026-05-30T20:50:00+01:00\",\"filmStartsAt\":\"2026-05-30T18:00:00+01:00\",\"filmEndsAt\":\"2026-05-30T20:50:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-1-6\",\"filmId\":\"HO00006241\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-1\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000003\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"MAY1\",\"name\":{\"text\":\"Mayfair\",\"translations\":[]},\"location\":{\"latitude\":51.5066,\"longitude\":-0.1479},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"38 Curzon Street,\",\"line2\":\"London,\",\"city\":\"W1J 7TY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006241\",\"title\":{\"text\":\"Met Opera 2026: El \u00daltimo Sue\u00f1o de Frida y Diego\",\"translations\":[]},\"synopsis\":{\"text\":\"On May 30, the Metropolitan Opera\u2019s 2025\u201326 Live in HD season comes to a close with a live transmission of American composer Gabriela Lena Frank\u2019s first opera, a magical-realist portrait of Mexico\u2019s painterly power couple Frida Kahlo and Diego Rivera, with libretto by Pulitzer Prize\u2013winning playwright Nilo Cruz. Fashioned as a reversal of the Orpheus and Euridice myth, the story depicts Frida, sung by leading mezzo-soprano Isabel Leonard, leaving the underworld on the Day of the Dead and reuniting with Diego, portrayed by baritone Carlos \u00c1lvarez. The famously feuding pair briefly relive their tumultuous love, embracing both the passion and the pain before bidding the land of the living a final farewell. Music Director Yannick N\u00e9zet-S\u00e9guin conducts the Met-premiere staging of Frank\u2019s opera, a \u201cconfident, richly imagined score\u201d (The New Yorker) that \u201cbursts with color and fresh individuality\u201d (Los Angeles Times). The vibrant new production, taking enthusiastic inspiration from Frida and Diego\u2019s paintings, is directed and choreographed by Deborah Colker.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"On May 30, the Metropolitan Opera\u2019s 2025\u201326 Live in HD season comes to a close with a\\nlive transmission of American composer Gabriela Lena Frank\u2019s first opera, a magical-\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-05-30\",\"runtimeInMinutes\":170,\"trailerUrl\":null,\"displayPriority\":68,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001489\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001562\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001569\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003664\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000634\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000635\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c4f6fe03-3def-4e0e-b94b-05e9c03edcfe\",\"corporateId\":null},\"hopk\":\"HO00006241\",\"hoCode\":\"A000007699\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000001489\",\"name\":{\"givenName\":\"Carlos\",\"familyName\":\"\u00c1lvarez\",\"middleName\":null}},{\"id\":\"0000001562\",\"name\":{\"givenName\":\"Yannick\",\"familyName\":\"N\u00e9zet-S\u00e9guin\",\"