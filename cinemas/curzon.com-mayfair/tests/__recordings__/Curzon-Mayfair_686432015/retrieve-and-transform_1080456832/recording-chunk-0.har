          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2027-02-07\",\"showtimes\":[{\"id\":\"MAY1-33585\",\"schedule\":{\"businessDate\":\"2027-02-07\",\"startsAt\":\"2027-02-07T14:00:00+00:00\",\"endsAt\":\"2027-02-07T19:50:00+00:00\",\"filmStartsAt\":\"2027-02-07T14:00:00+00:00\",\"filmEndsAt\":\"2027-02-07T19:50:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-2-8\",\"filmId\":\"HO00007125\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-2\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"MAY1\",\"name\":{\"text\":\"Mayfair\",\"translations\":[]},\"location\":{\"latitude\":51.5065994262695,\"longitude\":-0.147900000214577},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"MAY1@curzon.com\",\"address\":{\"line1\":\"38 Curzon Street,\",\"line2\":\"London,\",\"city\":\"W1J 7TY\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007125\",\"title\":{\"text\":\"RBO Cinema Season 2026-27: Götterdämmerung\",\"translations\":[]},\"synopsis\":{\"text\":\"An earth in ruin. The twilight of the Gods. \\nDeception leads to treachery, then devastation, when Siegfried is tricked into betraying Brünnhilde. Learning the truth of her beloved’s innocence, Brünnhilde at last returns the ring to the Rhinemaidens, before ordering that Valhalla be swallowed in flames. For the long-awaited finale of Wagner’s epic saga, director Barrie Kosky situates the rich apocalyptic drama in a contemporary world of dream-like turmoil. Antonio Pappano, Conductor Laureate of The Royal Opera, returns to take on the impassioned, otherworldly music – including Siegfried’s transporting Funeral March and Brünnhilde’s electrifying Immolation Scene. The brilliant cast is led by Elisabet Strid, Andreas Schager and Mika Kares, who together with the full forces of the Orchestra of the Royal Opera House and the Royal Opera Chorus bring opera’s greatest journey to its shattering end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"An earth in ruin. The twilight of the Gods. \\nDeception leads to treachery, then devastation, when Siegfried is tricked into betraying Brünnhilde. \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2027-02-03\",\"runtimeInMinutes\":350,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000006115\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006116\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000490\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000606\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000734\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000735\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000736\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000737\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000738\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000739\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000740\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000741\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000742\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000743\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000006115\"},{\"castAndCrewMemberId\":\"HO00000490\"},{\"castAndCrewMemberId\":\"HO00000606\"},{\"castAndCrewMemberId\":\"HO00000734\"},{\"castAndCrewMemberId\":\"HO00000735\"},{\"castAndCrewMemberId\":\"HO00000736\"},{\"castAndCrewMemberId\":\"HO00000737\"},{\"castAndCrewMemberId\":\"HO00000738\"},{\"castAndCrewMemberId\":\"HO00000739\"},{\"castAndCrewMemberId\":\"HO00000740\"},{\"castAndCrewMemberId\":\"HO00000741\"},{\"castAndCrewMemberId\":\"H