          "redirectURL": "",
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-12-13\",\"showtimes\":[{\"id\":\"MAY1-33584\",\"schedule\":{\"businessDate\":\"2026-12-13\",\"startsAt\":\"2026-12-13T14:00:00+00:00\",\"endsAt\":\"2026-12-13T16:20:00+00:00\",\"filmStartsAt\":\"2026-12-13T14:00:00+00:00\",\"filmEndsAt\":\"2026-12-13T16:20:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-1-10\",\"filmId\":\"HO00007123\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-1\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000003\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"MAY1\",\"name\":{\"text\":\"Mayfair\",\"translations\":[]},\"location\":{\"latitude\":51.5065994262695,\"longitude\":-0.147900000214577},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"MAY1@curzon.com\",\"address\":{\"line1\":\"38 Curzon Street,\",\"line2\":\"London,\",\"city\":\"W1J 7TY\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007123\",\"title\":{\"text\":\"RBO Cinema Season 2026-27: The Nutcracker\",\"translations\":[]},\"synopsis\":{\"text\":\"At a cosy Christmas party, young Clara meets the mysterious magician Drosselmeyer, who gives her a nutcracker doll. When the guests have departed and the house is asleep, Clara sneaks downstairs in search of the doll. Instead, she finds Drosselmeyer, who whisks her away on a journey into a whole world of enchantment: fantastical landscapes of flurried snow and glittering confection where toys come alive and the magic never stops. \\nPeter Wright’s production of this festive family favourite sparkles to the wondrous swell of Tchaikovsky’s orchestral score, alongside the glow and grandeur of Julia Trevelyan Oman’s period designs.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"At a cosy Christmas party, young Clara meets the mysterious magician Drosselmeyer, who gives her a nutcracker doll. \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-12-01\",\"runtimeInMinutes\":140,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011530\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3643\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3646\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000732\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000733\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000011530\"},{\"castAndCrewMemberId\":\"3643\"},{\"castAndCrewMemberId\":\"3646\"},{\"castAndCrewMemberId\":\"HO00000732\"},{\"castAndCrewMemberId\":\"HO00000733\"}],\"directors\":[],\"producers\":[],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"cf10965f-7f6b-4fc9-82bb-c7433bd1a7de\",\"corporateId\":null},\"hopk\":\"HO00007123\",\"hoCode\":\"A000008774\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000011530\",\"name\":{\"givenName\":\"James\",\"familyName\":\"Hay\",\"middleName\":null}},{\"id\":\"3643\",\"name\":{\"givenName\":\"Reece\",\"familyName\":\"Clarke\",\"middleName\":null}},{\"id\":\"3646\",\"name\":{\"givenName\":\"Mayara\",\"familyName\":\"Magri\",\"middleName\":null}},{\"id\":\"HO00000732\",\"name\":{\"givenName\":\"Marianna\",\"familyName\":\"Tsembenhoi\",\"middleName\":null}},{\"id\":\"HO00000733\",\"name\":{\"givenName\":\"Taisuke\",\"familyName\":\"Nakao\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificatio