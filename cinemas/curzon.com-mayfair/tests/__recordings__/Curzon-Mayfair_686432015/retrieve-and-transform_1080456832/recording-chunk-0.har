          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2027-03-20\",\"showtimes\":[{\"id\":\"MAY1-33597\",\"schedule\":{\"businessDate\":\"2027-03-20\",\"startsAt\":\"2027-03-20T17:00:00+00:00\",\"endsAt\":\"2027-03-20T20:00:00+00:00\",\"filmStartsAt\":\"2027-03-20T17:00:00+00:00\",\"filmEndsAt\":\"2027-03-20T20:00:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-1-10\",\"filmId\":\"HO00007138\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-1\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000003\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"MAY1\",\"name\":{\"text\":\"Mayfair\",\"translations\":[]},\"location\":{\"latitude\":51.5065994262695,\"longitude\":-0.147900000214577},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"MAY1@curzon.com\",\"address\":{\"line1\":\"38 Curzon Street,\",\"line2\":\"London,\",\"city\":\"W1J 7TY\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007138\",\"title\":{\"text\":\"Met Opera 2026-27: Silent Night\",\"translations\":[]},\"synopsis\":{\"text\":\"Following his smash-hit company debut with The Hours, composer Kevin Puts returns to the Met with his Pulitzer Prize–winning opera, inspired by the true events of the 1914 Christmas truce. A poignant depiction of shared humanity in the most inhumane circumstances, Puts’s grand, cinematic opera—with a libretto in English, French, and German by Mark Campbell—has been widely acclaimed since its 2011 premiere, hailed as “an overwhelming emotive experience” by The Guardian. The evocative staging by James Robinson takes the audience directly to the battlefields of the Western Front with a star-studded cast, featuring soprano Elza van den Heever and tenors Ben Bliss and Rolando Villazón, conducted by Maestro Dalia Stasevska live from the Met to cinemas worldwide.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Following his smash-hit company debut with The Hours, composer Kevin Puts returns to the Met with his Pulitzer Prize–winning opera, inspired by the true events \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2027-03-20\",\"runtimeInMinutes\":180,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000919\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000003805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003828\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000554\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000616\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000771\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000772\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000773\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000774\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000775\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000003805\"},{\"castAndCrewMemberId\":\"0000003828\"},{\"castAndCrewMemberId\":\"HO00000554\"},{\"castAndCrewMemberId\":\"HO00000616\"},{\"castAndCrewMemberId\":\"HO00000771\"},{\"castAndCrewMemberId\":\"HO00000772\"},{\"castAndCrewMemberId\":\"HO00000773\"},{\"castAndCrewMemberId\":\"HO00000774\"},{\"castAndCrewMemberId\":\"HO00000775\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000000920\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000000919\"}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"92ab0ad6-67f6-4323-9cb8-a0ad1ab6bf6d\",\"corporateId\":null},\"hopk\":\"HO00007138\",\"hoCode\":\"A000008789\",\"eventId\":null,\"distributorName\":\"Trafalgar Rele