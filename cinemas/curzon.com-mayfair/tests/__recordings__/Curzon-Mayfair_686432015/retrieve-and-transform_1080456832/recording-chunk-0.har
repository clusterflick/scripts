rictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"MAY1-113-HO00006609\"},{\"id\":\"MAY1-32424\",\"schedule\":{\"businessDate\":\"2026-02-01\",\"startsAt\":\"2026-02-01T20:00:00+00:00\",\"endsAt\":\"2026-02-01T22:44:00+00:00\",\"filmStartsAt\":\"2026-02-01T20:25:00+00:00\",\"filmEndsAt\":\"2026-02-01T22:44:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-1-10\",\"filmId\":\"HO00006689\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-1\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000003\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"MAY1\",\"name\":{\"text\":\"Mayfair\",\"translations\":[]},\"location\":{\"latitude\":51.5066,\"longitude\":-0.1479},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"38 Curzon Street,\",\"line2\":\"London,\",\"city\":\"W1J 7TY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006557\",\"title\":{\"text\":\"Nuremberg\",\"translations\":[]},\"synopsis\":{\"text\":\"In the immediate aftermath of the Second World War, as the world grapples with the unveiled horrors of the Holocaust, U.S. Army psychiatrist Lt. Col. Douglas Kelley (Rami Malek) is assigned the extraordinary task of assessing the mental state of Hermann G\u00f6ring (Russell Crowe), the notorious former Reichsmarschall and Hitler\u2019s second in command, along with other high ranking Nazi officials.\\nAs the Allies \u2013 led by the unyielding chief U.S. prosecutor, Supreme Court Justice Robert H. Jackson (Michael Shannon) alongside Sgt. Howie Triest (Leo Woodall), David Maxwell-Fyfe (Richard E. Grant), Gustave Gilbert (Colin Hanks), Col. John Amen (Mark O\u2019Brien) and Burton C. Andrus (John Slattery) \u2013 navigate the monumental task of creating an unprecedented international tribunal to ensure the Nazi regime answers for its atrocities, Kelley gets to know his \u2018patients\u2019. But he soon finds himself locked in a psychological duel with G\u00f6ring, whose charisma and cunning reveal a sobering truth: that ordinary men can commit extraordinary evil.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Allies, led by the unyielding chief prosecutor, Robert H. Jackson (Michael Shannon), have the task of ensuring the Nazi regime answers for the unveiled horrors.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"images of real dead bodies, Holocaust references, strong violence\",\"translations\":[]},\"releaseDate\":\"2025-11-14\",\"runtimeInMinutes\":148,\"trailerUrl\":\"https://www.youtube.com/watch?v=WvAy9C-bipY\",\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001228\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001276\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002501\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000002502\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002870\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003677\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008524\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010518\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011757\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012532\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012533\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012534\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012535\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012536\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012537\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012538\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012539\",\"roles\":[\"Producer\"]},{\"castAnd