          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-09-06\",\"showtimes\":[{\"id\":\"MAY1-33990\",\"schedule\":{\"businessDate\":\"2026-09-06\",\"startsAt\":\"2026-09-06T15:00:00+01:00\",\"endsAt\":\"2026-09-06T17:37:00+01:00\",\"filmStartsAt\":\"2026-09-06T15:25:00+01:00\",\"filmEndsAt\":\"2026-09-06T17:37:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-1-11\",\"filmId\":\"HO00007232\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-1\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"MAY1\",\"name\":{\"text\":\"Mayfair\",\"translations\":[]},\"location\":{\"latitude\":51.5065994262695,\"longitude\":-0.147900000214577},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"MAY1@curzon.com\",\"address\":{\"line1\":\"38 Curzon Street,\",\"line2\":\"London,\",\"city\":\"W1J 7TY\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007232\",\"title\":{\"text\":\"Curzon Film 50: Parasite\",\"translations\":[]},\"synopsis\":{\"text\":\"Winner of the 2020 Oscar for Best Picture, Best Director, Best Original Screenplay and Best International Film, the 2020 BAFTA for Best Film Not in the English Language and Best Original Screenplay, and the Palme d'Or at the 2019 Cannes Film Festival. Bong Joon-ho ('Snowpiercer' 'Okja') returns with this black comedy about wealth, greed and class discrimination. Kim Ki-teak's (Song Kang-ho) family are all unemployed and living in a squalid basement. When his son gets a tutoring job at the lavish home of the Park family, the Kim family's luck changes. One by one they gradually infiltrate the wealthy Park's home, attempting to take over their affluent lifestyle.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Winner of the Palme d'Or at the 2019 Cannes Film Festival. Bong Joon-ho returns with this black comedy about wealth, greed and class discrimination\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"Strong bloody violence, language, sex, sex references\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":132,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=tBfgTZsBeFM\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=tBfgTZsBeFM\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004980\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000407\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000408\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000409\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000410\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000411\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000412\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000413\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000414\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000415\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000004980\"},{\"castAndCrewMemberId\":\"HO00000407\"},{\"castAndCrewMemberId\":\"HO00000408\"},{\"castAndCrewMemberId\":\"HO00000409\"},{\"castAndCrewMemberId\":\"HO00000410\"},{\"castAndCrewMemberId\":\"HO00000411\"}],\"directors\":[{\"castAndCrewMemberId\":\"HO00000412\"}],\"producers\":[{\"castAndCrewMemberId\":\"HO00000412\"},{\"castAndCrewMemberId\":\"HO00000413\"},{\"castAndCrewMemberId\":\"HO00000414\"},{\"castAndCrewMemberId\":\"HO00000415\"}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007232\",\"hoCode\":\"A000008898\",\"eventId\":\"0000000068\",\"distributorName\":\"Curzon\"}],\"castAndCrew\":[{\"id\":\"00000049