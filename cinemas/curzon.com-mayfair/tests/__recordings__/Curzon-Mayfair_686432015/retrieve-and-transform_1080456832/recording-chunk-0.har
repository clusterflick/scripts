            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-07-11\",\"showtimes\":[{\"id\":\"MAY1-33980\",\"schedule\":{\"businessDate\":\"2026-07-11\",\"startsAt\":\"2026-07-11T20:20:00+01:00\",\"endsAt\":\"2026-07-11T22:20:00+01:00\",\"filmStartsAt\":\"2026-07-11T20:45:00+01:00\",\"filmEndsAt\":\"2026-07-11T22:20:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-1-11\",\"filmId\":\"HO00007152\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-1\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"MAY1-33981\",\"schedule\":{\"businessDate\":\"2026-07-11\",\"startsAt\":\"2026-07-11T20:50:00+01:00\",\"endsAt\":\"2026-07-11T23:01:00+01:00\",\"filmStartsAt\":\"2026-07-11T21:15:00+01:00\",\"filmEndsAt\":\"2026-07-11T23:01:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-2-8\",\"filmId\":\"HO00007147\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-2\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"MAY1\",\"name\":{\"text\":\"Mayfair\",\"translations\":[]},\"location\":{\"latitude\":51.5065994262695,\"longitude\":-0.147900000214577},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"MAY1@curzon.com\",\"address\":{\"line1\":\"38 Curzon Street,\",\"line2\":\"London,\",\"city\":\"W1J 7TY\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007147\",\"title\":{\"text\":\"The Invite\",\"translations\":[]},\"synopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \\nHave they reignited the spark or lit the match that burns it all down?\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"very strong language, strong sex references, drug misuse\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":106,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/ad147b9a-b731-410f-8bf9-c4f3f3df2095/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=jnLW-q2ftKA\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=jnLW-q2ftKA\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001093\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002460\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003915\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"0000004392\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004710\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007157\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013073\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014130\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000002460\"},{\"castAndCrewMemberId\":\"0000003915\"},{\"castAndCrewMemberId\":\"0000004392\"},{\"castAndCrewMemberId\":\"0000004710\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000003915\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000001093\"},{\"castAndCrewMemberId\":\"0000007157\"},{\"castAndCrewMemberId\":\"0000013073\"},{\"castAndCrewMemberId\":\"0000014130\"}],\"genreIds\":[\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ad147b9a-b731-410f-8bf9-c4f3f3df2095\",\"corporateId\":null},\"hopk\":\"HO00007147\",\"hoCode\":\"A000008799\",\"eventId\":null,\"distributorName\":\"Black Bear\"},{\"id\":\"HO00007152\",\"title\":{\"text\":\"Rosebush Pruning\",\"translations\":[]},\"synopsis\":{\"text\":\"Underneath the Catalonian sun, a rich white American family lives in hedonistic isolation, seeking love and validation through one another, their designer wardrobes and pop music. When an outsider infiltrates the family, buried tensions surface and blood ties are severed. \\n\\nAn outrageous, biting satire on the absurdity of patriarchal family, starring Callum Turner, Riley Keough, Jamie Bell, Lukas Gage, Elena Anaya, Tracy Letts, Elle Fanning and Pamela Anderson.\\n\\nFrom award winning director Karim Aïnouz, written by Oscar nominated writer Efthimis Filippou, ROSEBUSH PRUNING is absurd, funny and in equal measure. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Underneath the Catalonian sun, a rich white American family lives in hedonistic isolation, seeking love and validation through one another, their designer wardrobes\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":{\"text\":\"sexual violence, strong sex, nudity\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":95,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/ab78ddcf-eae4-4e1c-9d6a-68f6392793c8/media/TrailerVideo\"}],\"trailerUrl\":null,\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000497\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000736\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001041\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001073\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001820\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005512\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006483\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007166\",\"roles\":[\"Actor\"]},{\"castAndC