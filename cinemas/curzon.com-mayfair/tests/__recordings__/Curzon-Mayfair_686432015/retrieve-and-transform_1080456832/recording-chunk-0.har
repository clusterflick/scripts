            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-01-29\",\"showtimes\":[{\"id\":\"MAY1-32362\",\"schedule\":{\"businessDate\":\"2026-01-29\",\"startsAt\":\"2026-01-29T11:00:00+00:00\",\"endsAt\":\"2026-01-29T13:53:00+00:00\",\"filmStartsAt\":\"2026-01-29T11:25:00+00:00\",\"filmEndsAt\":\"2026-01-29T13:53:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-2-8\",\"filmId\":\"HO00006557\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-2\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"MAY1-32358\",\"schedule\":{\"businessDate\":\"2026-01-29\",\"startsAt\":\"2026-01-29T11:45:00+00:00\",\"endsAt\":\"2026-01-29T14:29:00+00:00\",\"filmStartsAt\":\"2026-01-29T12:10:00+00:00\",\"filmEndsAt\":\"2026-01-29T14:29:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-1-10\",\"filmId\":\"HO00006689\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-1\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000003\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"MAY1-32361\",\"schedule\":{\"businessDate\":\"2026-01-29\",\"startsAt\":\"2026-01-29T14:20:00+00:00\",\"endsAt\":\"2026-01-29T16:51:00+00:00\",\"filmStartsAt\":\"2026-01-29T14:45:00+00:00\",\"filmEndsAt\":\"2026-01-29T16:51:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-2-8\",\"filmId\":\"HO00006677\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-2\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000059\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"rest