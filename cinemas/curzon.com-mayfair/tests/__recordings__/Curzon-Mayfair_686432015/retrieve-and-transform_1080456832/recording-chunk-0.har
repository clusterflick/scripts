          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-03-29\",\"showtimes\":[{\"id\":\"MAY1-32431\",\"schedule\":{\"businessDate\":\"2026-03-29\",\"startsAt\":\"2026-03-29T14:00:00+01:00\",\"endsAt\":\"2026-03-29T16:36:00+01:00\",\"filmStartsAt\":\"2026-03-29T14:25:00+01:00\",\"filmEndsAt\":\"2026-03-29T16:36:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"MAY1-1-10\",\"filmId\":\"HO00006801\",\"siteId\":\"MAY1\",\"screenId\":\"MAY1-1\",\"areaCategories\":[{\"areaCategoryId\":\"MAY1-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"MAY1-0000000003\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"MAY1\",\"name\":{\"text\":\"Mayfair\",\"translations\":[]},\"location\":{\"latitude\":51.5066,\"longitude\":-0.1479},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"38 Curzon Street,\",\"line2\":\"London,\",\"city\":\"W1J 7TY\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006801\",\"title\":{\"text\":\"Film Club: La Chimera\",\"translations\":[]},\"synopsis\":{\"text\":\"Everyone has their own Chimera, something they try to achieve but never manage to find. For the band of tombaroli, thieves of ancient grave goods and archaeological wonders, the Chimera means redemption from work and the dream of easy wealth. For Arthur, the Chimera looks like the woman he lost, Beniamina. To find her, Arthur challenges the invisible, searches everywhere, goes inside the earth \u2013 in search of the door to the afterlife of which myths speak. In an adventurous journey between the living and the dead, between forests and cities, between celebrations and solitudes, the intertwined destinies of these characters unfold, all in search of the Chimera.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Everyone has their own Chimera, something they try to achieve but never manage to find. For Arthur, the Chimera looks like the woman he lost, Beniamina.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language\",\"translations\":[]},\"releaseDate\":\"2026-03-29\",\"runtimeInMinutes\":131,\"trailerUrl\":\"https://www.youtube.com/watch?v=k0oGUwzxefk\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000734\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001143\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001266\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001816\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002895\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003532\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000004970\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008460\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008461\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008462\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008463\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008464\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008465\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008466\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008467\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000007\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006801\",\"hoCode\":\"A000008391\",\"eventId\":null,\"distributorName\":\"Curzon\"}],\"castAndCrew\":[{\"id\":\"0000000734\",\"name\":{\"givenName\":\"Vincenzo\",\"familyName\":\"Nemolato\",\"middleName\":null}},{\"id\":\"0000001143\",\"name\":{\"givenName\":\"Josh\",\"familyName\":\"O\u2019Connor\",\"middleName\":null}},{\"id\":\"0000001266\",\"name\":{\"givenName\":\"Carlo\",\"familyName\":\"Cresto-Dina\",\"middleName\":null}},{\"id\":\"0000001816\",\"name\":{\"givenName\":\