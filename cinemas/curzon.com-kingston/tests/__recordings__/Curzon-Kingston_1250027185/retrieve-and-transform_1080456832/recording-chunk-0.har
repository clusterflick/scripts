equires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"KIN1-131-HO00007158\"},{\"id\":\"KIN1-26752\",\"schedule\":{\"businessDate\":\"2026-08-04\",\"startsAt\":\"2026-08-04T18:00:00+01:00\",\"endsAt\":\"2026-08-04T20:03:00+01:00\",\"filmStartsAt\":\"2026-08-04T18:25:00+01:00\",\"filmEndsAt\":\"2026-08-04T20:03:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-4-11\",\"filmId\":\"HO00007102\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-4\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"KIN1-27071\",\"schedule\":{\"businessDate\":\"2026-08-04\",\"startsAt\":\"2026-08-04T20:30:00+01:00\",\"endsAt\":\"2026-08-04T23:19:00+01:00\",\"filmStartsAt\":\"2026-08-04T20:55:00+01:00\",\"filmEndsAt\":\"2026-08-04T23:19:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-1-6\",\"filmId\":\"HO00007158\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-1\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000024\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"KIN1-131-HO00007158\"}],\"relatedData\":{\"sites\":[{\"id\":\"KIN1\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.4119987487793,\"longitude\":-0.30460000038147},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"KIN1@curzon.com\",\"address\":{\"line1\":\"The Bentall Centre,\",\"line2\":\"London,\",\"city\":\"KT1 1TP\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007102\",\"title\":{\"text\":\"Film Club: Billy Liar (4K Restoration)\",\"translations\":[]},\"synopsis\":{\"text\":\"To mark the centenary of Academy Award-winning director John Schlesinger's birth, we're inviting you to experience his greatest films on the big screen. Season curated by Claire Nicolas and Marc David Jacobs.\\n\\nBILLY LIAR\\nA lazy, irresponsible young clerk (Sir Tom Courtenay) in provincial Northern England lives in his own fantasy world and makes emotionally immature decisions as he alienates friends and family.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A lazy, irresponsible young clerk in provincial Northern England lives in his own fantasy world and makes emotionally immature decisions as he alienates friends & family.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":98,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000049\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010274\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011662\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011663\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000723\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000724\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000725\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000049\"},{\"castAndCrewMemberId\":\"0000010274\"},{\"castAndCrewMemberId\":\"HO00000723\"},{\"castAndCrewMemberId\":\"HO00000724\"},{\"castAndCrewMemberId\":\"HO00000725\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000011662\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000011663\"}],\"genreIds\":[\"0000000002\",\"0000000003\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007102\",\"hoCode\":\"A000008749\",\"eventId\":null,\"distributorName\":\"Studio Canal\"},{\"id\":\"HO00007158\",\"title\":{\"text\":\"Spider-Man: Brand New Day\",\"translations\":[]},\"synopsis\":{\"text\":\"It's a BRAND NEW DAY for Peter Parker. Fighting crime full-time as Spider-Man in a world that doesn’t remember him -- and the pressure of seeing his old friends move on without him -- sparks a change in Peter he may not have the power to control. But that transformation might also be the only thing that can stop a shocking new threat to the city and those he loves - a powerful villain no one can even see.\\n\\nThe world may have forgotten Peter Parker, but he hasn’t forgotten them.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It's a BRAND NEW DAY for Peter Parker. Fighting crime full-time as Spider-Man in a world that doesn’t remember him sparks a change he may not have the power to control.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-29\",\"runtimeInMinutes\":144,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/d1ef6990-72ef-4f8a-9caf-103f84b2f6f2/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=Q27BvUipKn8\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=Q27BvUipKn8\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000126\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000319\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000708\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001363\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001708\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001710\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002220\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002221\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004930\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007753\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008295\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014170\