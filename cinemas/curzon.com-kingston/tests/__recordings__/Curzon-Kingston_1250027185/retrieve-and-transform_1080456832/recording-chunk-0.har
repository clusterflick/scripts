            "text": "{\"businessDate\":\"2027-06-05\",\"showtimes\":[{\"id\":\"KIN1-26591\",\"schedule\":{\"businessDate\":\"2027-06-05\",\"startsAt\":\"2027-06-05T17:00:00+01:00\",\"endsAt\":\"2027-06-05T23:30:00+01:00\",\"filmStartsAt\":\"2027-06-05T17:25:00+01:00\",\"filmEndsAt\":\"2027-06-05T23:30:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-2-7\",\"filmId\":\"HO00007136\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-2\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"KIN1\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.4119987487793,\"longitude\":-0.30460000038147},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"KIN1@curzon.com\",\"address\":{\"line1\":\"The Bentall Centre,\",\"line2\":\"London,\",\"city\":\"KT1 1TP\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007136\",\"title\":{\"text\":\"Met Opera 2026-27: Parsifal\",\"translations\":[]},\"synopsis\":{\"text\":\"A profound philosophical meditation on compassion and reconciliation, this transcendent rendering of a medieval knight’s heroic quest for the Holy Grail returns to the big screen in François Girard’s celebrated production, a “thoughtful and intrepid staging, full of striking imagery” (The New York Times). Yannick Nézet-Séguin conducts a cast of Wagnerian superstars, including tenor Piotr Beczała in the title role, mezzo-soprano Elīna Garanča as the enigmatic Kundry, baritone Peter Mattei as the ailing Amfortas, bass-baritone Ryan Speedo Green as the sorcerer Klingsor, and bass Jongmin Park as the wise Gurnemanz.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A profound philosophical meditation on compassion and reconciliation, this transcendent rendering of a medieval knight’s heroic quest for the Holy Grail \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2027-06-05\",\"runtimeInMinutes\":365,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000907\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000917\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001562\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001583\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003813\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003825\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000625\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000628\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000907\"},{\"castAndCrewMemberId\":\"0000000917\"},{\"castAndCrewMemberId\":\"0000001562\"},{\"castAndCrewMemberId\":\"0000001583\"},{\"castAndCrewMemberId\":\"0000003825\"},{\"castAndCrewMemberId\":\"HO00000625\"},{\"castAndCrewMemberId\":\"HO00000628\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000000920\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000003813\"}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"1e096210-dccb-4598-b79a-c5e6aecc8a5f\",\"corporateId\":null},\"hopk\":\"HO00007136\",\"hoCode\":\"A000008787\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000907\",\"name\":{\"givenName\":\"Ryan Speedo\",\"familyName\":\"Green\",\"middleName\":null}},{\"id\":\"0000000917\",\"name\":{\"givenName\":\"Alfred\",\"familyName\":\"Walker\",\"middleName\":null}},{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000001562\",\"name\":{\"givenName\":\"Yannick\",\"famil