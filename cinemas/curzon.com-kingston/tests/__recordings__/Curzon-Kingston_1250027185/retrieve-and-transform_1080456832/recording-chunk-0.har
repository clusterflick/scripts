          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-03-13\",\"showtimes\":[{\"id\":\"KIN1-24245\",\"schedule\":{\"businessDate\":\"2026-03-13\",\"startsAt\":\"2026-03-13T18:00:00+00:00\",\"endsAt\":\"2026-03-13T20:05:00+00:00\",\"filmStartsAt\":\"2026-03-13T18:25:00+00:00\",\"filmEndsAt\":\"2026-03-13T20:05:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-2-7\",\"filmId\":\"HO00006798\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-2\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"KIN1\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.412,\"longitude\":-0.3046},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Bentall Centre,\",\"line2\":\"London,\",\"city\":\"KT1 1TP\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006798\",\"title\":{\"text\":\"Film Club: The Farewell\",\"translations\":[]},\"synopsis\":{\"text\":\"A headstrong Chinese-American woman returns to China when her beloved grandmother is diagnosed with terminal cancer. Billi struggles with her family's decision to keep grandma in the dark about her own illness as they all stage an impromptu wedding to see grandma one last time.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A Chinese family discover their grandmother has only a short while left to live and decide to keep her in the dark, scheduling a wedding to gather before she dies.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":{\"text\":\"Mild bad language, sex references\",\"translations\":[]},\"releaseDate\":\"2026-03-06\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=c1gAN2pmYDc\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndC