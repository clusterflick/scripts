          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-25\",\"showtimes\":[{\"id\":\"KIN1-27405\",\"schedule\":{\"businessDate\":\"2026-08-25\",\"startsAt\":\"2026-08-25T18:00:00+01:00\",\"endsAt\":\"2026-08-25T20:30:00+01:00\",\"filmStartsAt\":\"2026-08-25T18:15:00+01:00\",\"filmEndsAt\":\"2026-08-25T20:30:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-3-13\",\"filmId\":\"HO00007224\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-3\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000001\",\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"KIN1\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.4119987487793,\"longitude\":-0.30460000038147},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"KIN1@curzon.com\",\"address\":{\"line1\":\"The Bentall Centre,\",\"line2\":\"London,\",\"city\":\"KT1 1TP\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007224\",\"title\":{\"text\":\"Curzon Film 50: Love 3D\",\"translations\":[]},\"synopsis\":{\"text\":\"Igniting controversy and must-see appeal at the Cannes Film Festival, Love is a semi-autobiographical, sexually-charged melodrama shot in stereoscopic 3D.\\n\\n Gaspar Noé’s most ambitious work to date follows young filmmaker Murphy who wakes up on New Year's Day to a frantic phone call. His ex-girlfriend Electra has been missing for months and her mother fears the worst. Over the course of a long, rainy day, Murphy finds himself alone, reminiscing about the greatest love affair of his life - the two years he spent with Electra.\\n\\nWhat follows is a burning, passionate story, full of promises, games, excesses, and mistakes…\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Gaspar Noé’s most ambitious work to date follows young filmmaker Murphy who wakes up on New Year's Day to a frantic phone call. His ex-girlfriend Electra has been missing\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":{\"text\":\"strong real sex, very strong language\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":135,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=CVS2pe7kw1o\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=CVS2pe7kw1o\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000394\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001821\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003284\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003285\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003286\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004404\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000808\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000809\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000810\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000811\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000812\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000813\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000814\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000004404\"},{\"castAndCrewMemberId\":\"HO00000808\"},{\"castAndCrewMemberId\":\"HO00000809\"},{\"castAndCrewMemberId\":\"HO00000810\"},{\"castAndCrewMemberId\":\"HO00000811\"},{\"castAndCrewMemberId\":\"HO00000812\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000003284\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000000394\"},{\"castAndCrewMemberId\":\"0000001821\"},{\"castAndCrewMemberId\":\"0000003284\"},{\"castAndCrewMemberId\":\"0000003285\"},{\"castAndCrewMemberId\":\"0000003286\"},{\"castAndCrewMemberId\":\"HO00000