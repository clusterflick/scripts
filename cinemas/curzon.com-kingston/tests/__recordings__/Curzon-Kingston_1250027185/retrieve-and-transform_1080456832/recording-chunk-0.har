-ce8d7c41f210/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=GM3Dmn06fy8\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=GM3Dmn06fy8\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002191\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003325\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005692\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006291\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009763\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013297\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013298\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013314\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013315\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013316\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000002191\"},{\"castAndCrewMemberId\":\"0000003325\"},{\"castAndCrewMemberId\":\"0000005692\"},{\"castAndCrewMemberId\":\"0000006291\"},{\"castAndCrewMemberId\":\"0000009763\"},{\"castAndCrewMemberId\":\"0000013314\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000013297\"},{\"castAndCrewMemberId\":\"0000013315\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000013298\"},{\"castAndCrewMemberId\":\"0000013316\"}],\"genreIds\":[\"0000000003\",\"0000000007\",\"0000000025\"],\"externalIds\":{\"moviexchangeReleaseId\":\"3e6d64d4-c466-4c58-93cd-ce8d7c41f210\",\"corporateId\":null},\"hopk\":\"HO00006825\",\"hoCode\":\"A000008421\",\"eventId\":null,\"distributorName\":\"Walt Disney Studios Motion Pictures - UK\"},{\"id\":\"HO00006931\",\"title\":{\"text\":\"Disclosure Day\",\"translations\":[]},\"synopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming close to … Disclosure Day.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-10\",\"runtimeInMinutes\":145,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/920be864-1bc7-4cfd-aa64-b828b3c90b38/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=pFz8czbdPdU\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=pFz8czbdPdU\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000341\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001072\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002138\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000002139\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008293\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013627\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000341\"},{\"castAndCrewMemberId\":\"0000000418\"},{\"castAndCrewMemberId\":\"0000001072\"},{\"castAndCrewMemberId\":\"0000008293\"},{\"castAndCrewMemberId\":\"0000013627\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000002138\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000002138\"},{\"castAndCrewMemberId\":\"0000002139\"}],\"genreIds\":[\"0000000035\"],\"externalIds\":{\"moviexchangeReleaseId\":\"920be864-1bc7-4cfd-aa64-b828b3c90b38\",\"corporateId\":null},\"hopk\":\"HO00006931\",\"hoCode\":\"A000008544\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00007012\",\"title\":{\"text\":\"Moana\",\"translations\":[]},\"synopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyages beyond the reef of her island of Motunui with the infamous demigod Maui (Dwayne Johnson) on an unforgettable journey to restore prosperity to her people. The film is directed by Emmy® and Tony Award® winner Thomas Kail (“Hamilton”); produced by Dwayne Johnson, Dany Garcia, Beau Flynn, Hiram Garcia and Lin-Manuel Miranda; and executive produced by Thomas Kail, Scott Sheldon, Charles Newirth and Auliʻi Cravalho, who voiced Moana in the animated features “Moana” and “Moana 2.”\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyage\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":120,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/a7437e11-b6d4-476f-89ac-5a3a2ee813c8/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=JnficPHHF2U\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=JnficPHHF2U\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000371\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001009\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001016\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001017\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001018\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000007576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011016\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011017\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011018\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011019\",\"roles\":[\"Director\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001009\"},{\"castAndCrewMemberId\":\"0000007576\"},{\"castAndCrewMemberId\":\"0000011016\"},{\"castAndCrew