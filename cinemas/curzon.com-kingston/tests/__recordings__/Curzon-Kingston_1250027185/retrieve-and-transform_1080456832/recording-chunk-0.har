          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-09-01\",\"showtimes\":[{\"id\":\"KIN1-27406\",\"schedule\":{\"businessDate\":\"2026-09-01\",\"startsAt\":\"2026-09-01T18:00:00+01:00\",\"endsAt\":\"2026-09-01T19:52:00+01:00\",\"filmStartsAt\":\"2026-09-01T18:15:00+01:00\",\"filmEndsAt\":\"2026-09-01T19:52:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-4-11\",\"filmId\":\"HO00007225\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-4\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"KIN1\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.4119987487793,\"longitude\":-0.30460000038147},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"KIN1@curzon.com\",\"address\":{\"line1\":\"The Bentall Centre,\",\"line2\":\"London,\",\"city\":\"KT1 1TP\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007225\",\"title\":{\"text\":\"Curzon Film 50: Mustang\",\"translations\":[]},\"synopsis\":{\"text\":\"Beautifully shot, with stunning performances by its young cast, the Oscar-nominated Mustang is both a rousing tale of spirited youth and a powerful, moving, and timely work of engaging social cinema.\\n\\nIt’s the beginning of summer. In a small village in northern Turkey, Lale and her four sisters are on their way home from school, innocently playing with local boys. But prying village eyes view their games with suspicion and the girls’ behaviour – and refusal to repent – quickly causes a scandal among the family.\\n\\nSoon the sisters find themselves locked in their bedrooms, with sober dress enforced and their schoolwork replaced by cookery classes. Their home now a prison, all the girls have to live for are arranged marriages and family honour. But together, driven by strength, courage, and a desire for freedom, the five sisters fight back against the limits imposed on them and test their family ties to breaking point.\\n\\nDrawing vocal support from critics, festivals, and audiences across the globe, this highly impressive debut from director Deniz Gamze Ergüven is set to be one of the most talked-about and celebrated films of the year.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When five orphan girls are seen innocently playing with boys on a beach, their scandalized conservative guardians confine them while forced marriages are arranged.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"infrequent strong sex references\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":97,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=B5GdLjcK9G0\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=B5GdLjcK9G0\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003323\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000815\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000816\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000817\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000818\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000819\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000820\",\"roles\":[\"Director\"]}],\"actors\":[{\"castAndCrewMemberId\":\"HO00000815\"},{\"castAndCrewMemberId\":\"HO00000816\"},{\"castAndCrewMemberId\":\"HO00000817\"},{\"castAndCrewMemberId\":\"HO00000818\"},{\"castAndCrewMemberId\":\"HO00000819\"}],\"directors\":[{\"castAndCrewMemberId\":\"HO00000820\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000003323\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007225\",\"hoCode\":\"A000008890\",\"eventId\":\"0000000068\",\"distributorName\":\"Curzon\"}],\"castAndCrew\":[{\"id\":\"0000003323\",\"name\":{\"givenName\":\"Charles\",\"familyName\":\"Gillibert\",\"middleName\":null}},{\"id\":\"HO00000815\",\"name\":{\"givenName\":\"Ilayda\",\"familyName\":\"Akdogan\",\"middleName\":null}},{\"id\":\"HO00000816\",\"name\":{\"givenName\":\"Tugba\",\"familyName\":\"Sunguroglu\",\"middleName\":null}},{\"id\":\"HO00000817\",\"name\":{\"givenName\":\"Doga Zeynep\",\"familyName\":\"Doguslu\",\"middleName\":null}},{\"id\":\"HO00000818\",\"name\":{\"givenName\":\"Günes\",\"familyName\":\"Sensoy\",\"middleName\":null}},{\"id\":\"HO00000819\",\"name\":{\"givenName\":\"Elit\",\"familyName\":\"Iscan\",\"middleName\":null}},{\"id\":\"HO00000820\",\"name\":{\"givenName\":\"Deniz\",\"familyName\":\"Gamze Ergüven\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":{\"text\":\"Drama\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"HO00000006\",\"classification\":{\"text\":\"15\",\"translations\":[]},\"classificationDescription\":{\"text\":\"15\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000053\",\"name\":{\"text\":\"Film Club\",\"translations\":[]},\"shortName\":{\"text\":\"Film Club\",\"translations\":[]},\"description\":{\"text\":\"Film Club Screening. Browse more at curzon.com/film-club\",\"translations\":[]},\"importantMessage\":{\"text\":\"Film Club Screening\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"KIN1-4\",\"name\":{\"text\":\"CENTURY\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000068\",\"name\":{\"text\":\"Curzon Film 50\",\"translations\":[]},\"shortName\":null,\"description\":null,\"schedule\":{\"startDate\":\"2026-07-31\",\"endDate\":\"2026-10-10\"},\"siteIds\":[\"ALD1\",\"BLO1\",\"CAM1\",\"CAN2\",\"COL1\",\"HOX1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SOH1\",\"VIC1\",\"WIM