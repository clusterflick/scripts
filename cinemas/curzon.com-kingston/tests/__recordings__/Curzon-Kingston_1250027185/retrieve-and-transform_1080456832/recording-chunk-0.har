nslations\":[]},\"shortName\":{\"text\":\"THE MET\",\"translations\":[]},\"description\":{\"text\":\"The Met Opera returns to Curzon featuring performances transmitted live from the New York stage to cinemas worldwide.\",\"translations\":[]},\"schedule\":{\"startDate\":\"2025-10-18\",\"endDate\":\"2027-12-31\"},\"siteIds\":[\"BLO1\",\"CAM1\",\"CAN2\",\"COL1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"VIC1\",\"WIM1\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"KIN1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
