          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2027-01-23\",\"showtimes\":[{\"id\":\"KIN1-26587\",\"schedule\":{\"businessDate\":\"2027-01-23\",\"startsAt\":\"2027-01-23T18:00:00+00:00\",\"endsAt\":\"2027-01-23T21:40:00+00:00\",\"filmStartsAt\":\"2027-01-23T18:25:00+00:00\",\"filmEndsAt\":\"2027-01-23T21:40:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-2-7\",\"filmId\":\"HO00007132\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-2\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"KIN1\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.4119987487793,\"longitude\":-0.30460000038147},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"KIN1@curzon.com\",\"address\":{\"line1\":\"The Bentall Centre,\",\"line2\":\"London,\",\"city\":\"KT1 1TP\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007132\",\"title\":{\"text\":\"Met Opera 2026-27: La Fanciulla del West\",\"translations\":[]},\"synopsis\":{\"text\":\"Puccini’s exhilarating drama of the Wild West returns in a new staging by Richard Jones, marking the company’s first new production of La Fanciulla del West in more than 30 years. Soprano Sondra Radvanovsky makes her role debut as Minnie, the tough tavern owner with a heart of gold who finds love when she least expects it. Tenor SeokJong Baek is the dashing bandit who rambles into the remote California mining town to steal her heart, opposite baritone Christopher Maltman as the lawman determined to deliver justice—and win Minnie for himself. Maestro Keri-Lynn Wilson takes the podium to conduct one of opera’s most action-packed adventures, live from the Met stage to cinemas worldwide.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Puccini’s exhilarating drama of the Wild West returns in a new staging by Richard Jones, marking the company’s first new production of La Fanciulla del West\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2027-01-23\",\"runtimeInMinutes\":195,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000003519\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003814\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000485\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000761\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000003814\"},{\"castAndCrewMemberId\":\"HO00000485\"},{\"castAndCrewMemberId\":\"HO00000761\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000000920\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000003519\"}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9b26d7eb-548e-4fe1-8eda-2573cc7bd48b\",\"corporateId\":null},\"hopk\":\"HO00007132\",\"hoCode\":\"A000008783\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000003519\",\"name\":{\"givenName\":\"Richard \",\"familyName\":\"Jones\",\"middleName\":null}},{\"id\":\"0000003814\",\"name\":{\"givenName\":\"Christopher \",\"familyName\":\"Maltman\",\"middleName\":null}},{\"id\":\"HO00000485\",\"name\":{\"givenName\":\"SeokJong\",\"familyName\":\"Baek\",\"middleName\":null}},{\"id\":\"HO00000761\",\"name\":{\"givenName\":\"Vida\",\"familyName\":\"Miknevičiūtė\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"cens