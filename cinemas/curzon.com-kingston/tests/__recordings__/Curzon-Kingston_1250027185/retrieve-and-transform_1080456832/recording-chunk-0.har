            "text": "{\"businessDate\":\"2026-09-19\",\"showtimes\":[{\"id\":\"KIN1-26583\",\"schedule\":{\"businessDate\":\"2026-09-19\",\"startsAt\":\"2026-09-19T18:00:00+01:00\",\"endsAt\":\"2026-09-19T21:25:00+01:00\",\"filmStartsAt\":\"2026-09-19T18:25:00+01:00\",\"filmEndsAt\":\"2026-09-19T21:25:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-2-7\",\"filmId\":\"HO00007139\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-2\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"KIN1\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.4119987487793,\"longitude\":-0.30460000038147},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"KIN1@curzon.com\",\"address\":{\"line1\":\"The Bentall Centre,\",\"line2\":\"London,\",\"city\":\"KT1 1TP\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007139\",\"title\":{\"text\":\"Twenty Years of the Met in Cinemas\",\"translations\":[]},\"synopsis\":{\"text\":\"Twenty Years of the Met in Cinemas is a celebration of the Met’s two decades of onstage glory as experienced in movie theaters, featuring highlights from the company’s collection of more than 185 extraordinary onscreen performances. \\nHosted by star soprano Renée Fleming, this special presentation will showcase unforgettable moments from some of opera’s greatest stars, culled from the series’ vast archive of transmissions, featuring such remarkable artists as Lise Davidsen, Natalie Dessay, Joyce DiDonato, Juan Diego Flórez, Elīna Garanča, Dmitri Hvorostovsky,  Jonas Kaufmann, Peter Mattei, Matthew Polenzani, Sondra Radvanovsky, Nadine Sierra, and, of course, Fleming herself.\",\"transla