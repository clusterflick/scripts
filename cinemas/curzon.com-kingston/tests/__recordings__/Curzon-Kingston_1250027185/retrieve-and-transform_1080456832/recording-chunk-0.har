Id\":\"0000002310\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004702\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004703\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005314\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007765\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c566d7dc-50bb-4d55-984b-c4c65751933e\",\"corporateId\":null},\"hopk\":\"HO00006677\",\"hoCode\":\"A000008241\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006679\",\"title\":{\"text\":\"28 Years Later: The Bone Temple\",\"translations\":[]},\"synopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later: The Bone Temple. In a continuation of the epic story, Dr. Kelson (Ralph Fiennes) finds himself in a shocking new relationship - with consequences that could change the world as they know it - and Spike's (Alfie Williams) encounter with Jimmy Crystal (Jack O'Connell) becomes a nightmare he can't escape. In the world of The Bone Temple, the infected are no longer the greatest threat to survival - the inhumanity of the survivors can be stranger and more terrifying. \\r\\n\\r\\nCUSTOMER NOTICE: This screening is restricted to viewers aged 18 and over. Valid identification must be presented at admission.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later.\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-16\",\"runtimeInMinutes\":110,\"trailerUrl\":\"https://www.youtube.com/watch?v=rl_DJZCyEH4\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000313\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001245\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001270\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003206\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010558\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011257\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011419\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012645\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012802\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ce27f9c4-2b7c-4839-b9e6-0ceceb8e7949\",\"corporateId\":null},\"hopk\":\"HO00006679\",\"hoCode\":\"A000008243\",\"eventId\":null,\"distributorName\":\"Sony Pictures\"},{\"id\":\"HO00006680\",\"title\":{\"text\":\"Rental Family\",\"translations\":[]},\"synopsis\":{\"text\":\"A down-and-out actor living in Tokyo is hired as a token American guy for a Japanese rental-family company, leading him on an unexpected journey of self-discovery through the roles he plays in other people\u2019s lives.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A down-and-out actor living in Tokyo is hired as a token American guy for a Japanese rental-family company, leading him on an unexpected journey of self-discovery.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":103,\"trailerUrl\":\"https://www.youtube.com/watch?v=sZT37sM2VgE\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004929\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008380\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008381\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012803\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012804\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012806\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000012807\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5675d1e4-8525-4a12-8283-5e88dcc4e188\",\"corporateId\":null},\"hopk\":\"HO00006680\",\"hoCode\":\"A000008244\",\"eventId\":null,\"distributorName\":\"Walt Disney Studios Motion Pictures - UK\"},{\"id\":\"HO00006689\",\"title\":{\"text\":\"No Other Choice\",\"translations\":[]},\"synopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":139,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000012169\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012827\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012828\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012829\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012830\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012831\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000026\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9ecc0908-a983-42f7-9591-6f8d73d7488b\",\"corporateId\":null},\"hopk\":\"HO00006689\",\"hoCode\":\"A000008255\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00006608\",\"title\":{\"text\":\"The Housemaid\",\"translations\":[]},\"synopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous \u2014 a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters\u2019 closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, sex, sexual violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":131,\"trailerUrl\":\"https://www.youtube.com/watch?v=vjThWa5R8Zw\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004322\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000004324\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005947\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009337\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009458\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012668\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012669\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012670\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a8844268-054d-43db-9829-a96cd7a752cf\",\"corporateId\":null},\"hopk\":\"HO00006608\",\"hoCode\":\"A000008157\",\"eventId\":null,\"distributorName\":\"Lionsgate\"},{\"id\":\"HO00006609\",\"title\":{\"text\":\"Marty Supreme\",\"translations\":[]},\"synopsis\":{\"text\":