            "text": "{\"businessDate\":\"2027-05-25\",\"showtimes\":[{\"id\":\"KIN1-26601\",\"schedule\":{\"businessDate\":\"2027-05-25\",\"startsAt\":\"2027-05-25T19:15:00+01:00\",\"endsAt\":\"2027-05-25T22:30:00+01:00\",\"filmStartsAt\":\"2027-05-25T19:40:00+01:00\",\"filmEndsAt\":\"2027-05-25T22:30:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-1-6\",\"filmId\":\"HO00007130\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-1\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"KIN1\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.4119987487793,\"longitude\":-0.30460000038147},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"KIN1@curzon.com\",\"address\":{\"line1\":\"The Bentall Centre,\",\"line2\":\"London,\",\"city\":\"KT1 1TP\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007130\",\"title\":{\"text\":\"RBO Cinema Season 2026-27: Romeo and Juliet\",\"translations\":[]},\"synopsis\":{\"text\":\"The Capulets and Montagues are sworn enemies. Yet it is love at first sight for Romeo Montague and Juliet Capulet when they meet each other at the Capulet ball, into which Romeo has snuck. The two fall in love and they profess their devotion to each other at Juliet’s balcony. They secretly get married.   \\nThe stakes are raised for the young couple when Romeo avenges the death of his friend Mercutio who has been killed by Tybalt, Juliet’s cousin. For this, Romeo is exiled from Verona. Meanwhile, Juliet’s parents are forcing her to marry another suitor. In order to be together, Romeo and Juliet must risk it all. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Capulets and Montag