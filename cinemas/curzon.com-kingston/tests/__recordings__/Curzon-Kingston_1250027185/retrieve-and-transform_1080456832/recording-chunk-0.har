            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-05-28\",\"showtimes\":[{\"id\":\"KIN1-23319\",\"schedule\":{\"businessDate\":\"2026-05-28\",\"startsAt\":\"2026-05-28T20:00:00+01:00\",\"endsAt\":\"2026-05-28T23:25:00+01:00\",\"filmStartsAt\":\"2026-05-28T20:25:00+01:00\",\"filmEndsAt\":\"2026-05-28T23:25:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-1-6\",\"filmId\":\"HO00006720\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-1\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000031\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"KIN1\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.412,\"longitude\":-0.3046},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Bentall Centre,\",\"line2\":\"London,\",\"city\":\"KT1 1TP\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006720\",\"title\":{\"text\":\"NT Live: The Playboy of the Western World\",\"translations\":[]},\"synopsis\":{\"text\":\"Nicola Coughlan (Bridgerton) joins \u00c9anna Hardwicke (The Sixth Commandment) and Siobh\u00e1n McSweeney (Derry Girls) in John Millington Synge\u2019s riveting play of youth and self-discovery. Pegeen Flaherty\u2019s life is turned upside down when a young man walks into her pub claiming that he\u2019s killed his father. Instead of being shunned, the killer becomes a local hero and begins to win hearts, that is until a second man unexpectedly arrives on the scene\u2026 Filmed live on stage at the National Theatre, Caitr\u00edona McLaughlin directs this darkly funny tale full to the brim with secrets.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Nicola Coughlan joins \u00c9anna Hardwicke and Siobh\u00e1n McSweeney in John Millington Synge\u2019s riveting play of youth and self-discovery.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-04\",\"runtimeInMinutes\":180,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000006980\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012989\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012990\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012991\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"fd971138-54b5-41e0-8bfe-d35c799db276\",\"corporateId\":null},\"hopk\":\"HO00006720\",\"hoCode\":\"A000008293\",\"eventId\":\"0000000031\",\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"0000006980\",\"name\":{\"givenName\":\"Nicola\",\"familyName\":\"Coughlan\",\"middleName\":null}},{\"id\":\"0000012989\",\"name\":{\"givenName\":\"\u00c9anna\",\"familyName\":\"Hardwicke\",\"middleName\":null}},{\"id\":\"0000012990\",\"name\":{\"givenName\":\"Siobh\u00e1n\",\"familyName\":\"McSweeney\",\"middleName\":null}},{\"id\":\"0000012991\",\"name\":{\"givenName\":\"Caitr\u00edona\",\"familyName\":\"McLaughlin\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[],\"screens\":[{\"id\":\"KIN1-1\",\"name\":{\"text\":\"COLISEUM\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000031\",\"name\":{\"text\":\"NT Live\",\"translations\":[]},\"shortName\":{\"text\":\"NT Live\",\"translations\":[]},\"description\":{\"text\":\"National Theatre Live brings the best of British theatre to cinema screens across the UK and around the world. With state-of-the-art filming techniques, tailored to every play, we bring you each performance as it happens, in all its glory. From close-ups that capture every flicker of emotion, to sweeping wide shots of the stage. Whether you come along to the live broadcast, or catch one of many replays, you\u2019ll have the best seats in the house.\",\"translations\":[]},\"schedule\":{\"startDate\":\"2024-01-01\",\"endDate\":\"2099-12-31\"},\"siteIds\":[\"ALD1\",\"BLO1\",\"CAM1\",\"CAN01\",\"CAN2\",\"COL1\",\"HOX1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SHE1\",\"SOH1\",\"VIC1\",\"WIM01\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"KIN1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
