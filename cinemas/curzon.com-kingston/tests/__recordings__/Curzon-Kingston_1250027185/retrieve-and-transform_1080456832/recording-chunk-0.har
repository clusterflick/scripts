"title\":{\"text\":\"Spider-Man: Brand New Day\",\"translations\":[]},\"synopsis\":{\"text\":\"It's a BRAND NEW DAY for Peter Parker. Fighting crime full-time as Spider-Man in a world that doesn’t remember him -- and the pressure of seeing his old friends move on without him -- sparks a change in Peter he may not have the power to control. But that transformation might also be the only thing that can stop a shocking new threat to the city and those he loves - a powerful villain no one can even see.\\n\\nThe world may have forgotten Peter Parker, but he hasn’t forgotten them.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It's a BRAND NEW DAY for Peter Parker. Fighting crime full-time as Spider-Man in a world that doesn’t remember him sparks a change he may not have the power to control.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-29\",\"runtimeInMinutes\":144,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/d1ef6990-72ef-4f8a-9caf-103f84b2f6f2/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=Q27BvUipKn8\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=Q27BvUipKn8\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000126\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000319\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000708\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001363\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001708\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001710\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002220\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002221\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004930\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007753\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008295\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014170\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014171\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000126\"},{\"castAndCrewMemberId\":\"0000000319\"},{\"castAndCrewMemberId\":\"0000002220\"},{\"castAndCrewMemberId\":\"0000002221\"},{\"castAndCrewMemberId\":\"0000004930\"},{\"castAndCrewMemberId\":\"0000007753\"},{\"castAndCrewMemberId\":\"0000014170\"},{\"castAndCrewMemberId\":\"0000014171\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000001363\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000000708\"},{\"castAndCrewMemberId\":\"0000001708\"},{\"castAndCrewMemberId\":\"0000001710\"},{\"castAndCrewMemberId\":\"0000008295\"}],\"genreIds\":[\"0000000007\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"d1ef6990-72ef-4f8a-9caf-103f84b2f6f2\",\"corporateId\":null},\"hopk\":\"HO00007158\",\"hoCode\":\"A000008810\",\"eventId\":null,\"distributorName\":\"Sony Pictures\"},{\"id\":\"HO00007209\",\"title\":{\"text\":\"Kids Club: The Super Mario Galaxy Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"The Super Mario Galaxy Movie is an animated film based on the world of Super Mario Bros., and follows The Super Mario Bros. Movie, which was released in 2023 and earned more than $1.3 billion worldwide. Both the 2023 film and The Super Mario Galaxy Movie are produced by Chris Meledandri of Illumination and Shigeru Miyamoto of Nintendo.\\n\\nThe film will be co-financed by Universal Pictures and Nintendo and will be released worldwide by Universal Pictures.\\n\\nThe Super Mario Galaxy Movie is directed by returning filmmakers Aaron Horvath and Michael Jelenic, from a screenplay by returning screenwriter Matthew Fogel, with Brian Tyler returning to compose the score.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Super Mario Galaxy Movie is an animated film based on the world of Super Mario Bros., and follows The Super Mario Bros. Movie, which was released in 2023. \",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-04-01\",\"runtimeInMinutes\":98,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/ed1e08fa-8624-4161-83bf-0ec0e273ff84/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=DDZkObBBV5w\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=DDZkObBBV5w\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001793\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002278\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003139\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005354\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005358\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005359\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005360\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005361\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005675\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013512\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000351\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001793\"},{\"castAndCrewMemberId\":\"0000002278\"},{\"castAndCrewMemberId\":\"0000003139\"},{\"castAndCrewMemberId\":\"0000005354\"},{\"castAndCrewMemberId\":\"0000005355\"},{\"castAndCrewMemberId\":\"0000005358\"},{\"castAndCrewMemberId\":\"0000005675\"},{\"castAndCrewMemberId\":\"HO00000351\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000005359\"},{\"castAndCrewMemberId\":\"0000005360\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000005361\"},{\"castAndCrewMemberId\":\"0000013512\"}],\"genreIds\":[\"0000000007\",\"0000000025\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ed1e08fa-8624-4161-83bf-0ec0e273ff84\",\"corporateId\":null},\"hopk\":\"HO00007209\",\"hoCode\":\"A000008867\",\"eventId\":null,\"