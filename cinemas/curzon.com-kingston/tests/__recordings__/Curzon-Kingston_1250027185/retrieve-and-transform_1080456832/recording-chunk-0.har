          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-09-22\",\"showtimes\":[{\"id\":\"KIN1-26957\",\"schedule\":{\"businessDate\":\"2026-09-22\",\"startsAt\":\"2026-09-22T18:00:00+01:00\",\"endsAt\":\"2026-09-22T20:55:00+01:00\",\"filmStartsAt\":\"2026-09-22T18:25:00+01:00\",\"filmEndsAt\":\"2026-09-22T20:55:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-1-6\",\"filmId\":\"HO00007173\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-1\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"KIN1\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.4119987487793,\"longitude\":-0.30460000038147},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"KIN1@curzon.com\",\"address\":{\"line1\":\"The Bentall Centre,\",\"line2\":\"London,\",\"city\":\"KT1 1TP\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007173\",\"title\":{\"text\":\"National Theatre Live: The Misanthrope\",\"translations\":[]},\"synopsis\":{\"text\":\"Award-winner Sandra Oh (Killing Eve) plays the title role in this razor-sharp reimagining of Molière’s classic dark comedy. Telling the truth isn’t always that simple. Alice, a brilliant novelist, despises the carefully constructed lies of modern society. But the more she challenges those around her, the fiercer the backlash becomes. Soon, she must confront the price of speaking her truth in a world that would rather silence her. Filmed live on stage at the National Theatre, Indhu Rubasingham directs Martin Crimp’s (Cyrano de Bergerac) highly anticipated play.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Award-winner Sandra Oh (Killing Eve) plays the title role in this razor-sharp reimagining of Molière’s classic dark comedy.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-09-22\",\"runtimeInMinutes\":150,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000643\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010780\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014196\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014197\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014198\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"14232\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"14233\",\"roles\":[\"Director\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000010780\"},{\"castAndCrewMemberId\":\"0000014196\"},{\"castAndCrewMemberId\":\"0000014197\"},{\"castAndCrewMemberId\":\"0000014198\"},{\"castAndCrewMemberId\":\"14232\"}],\"directors\":[{\"castAndCrewMemberId\":\"14233\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000000643\"}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"323fcfab-1fcc-48ba-8654-8a4e7d861cc2\",\"corporateId\":null},\"hopk\":\"HO00007173\",\"hoCode\":\"A000008828\",\"eventId\":null,\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"0000000643\",\"name\":{\"givenName\":\"National Theatre\",\"familyName\":\"Live\",\"middleName\":null}},{\"id\":\"0000010780\",\"name\":{\"givenName\":\"Sandra\",\"familyName\":\"Oh\",\"middleName\":null}},{\"id\":\"0000014196\",\"name\":{\"givenName\":\"Paul\",\"familyName\":\"Chahidi\",\"middleName\":null}},{\"id\":\"0000014197\",\"name\":{\"givenName\":\"Tom\",\"familyName\":\"Mison\",\"middleName\":null}},{\"id\":\"0000014198\",\"name\":{\"givenName\":\"Abigail\",\"familyName\":\"Cruttenden\",\"middleName\":null}},{\"id\":\"14232\",\"name\":{\"givenName\":\"Jemima\",\"familyName\":\"Rooper\",\"middleName\":null}},{\"id\":\"14233\",\"name\":{\"givenName\":\"Indhu\",\"familyName\":\"Rubasingham\",\"middleName\":n