"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"KIN1-130-HO00007116\"},{\"id\":\"KIN1-26897\",\"schedule\":{\"businessDate\":\"2026-07-17\",\"startsAt\":\"2026-07-17T19:10:00+01:00\",\"endsAt\":\"2026-07-17T22:27:00+01:00\",\"filmStartsAt\":\"2026-07-17T19:35:00+01:00\",\"filmEndsAt\":\"2026-07-17T22:27:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-2-7\",\"filmId\":\"HO00007116\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-2\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"KIN1-130-HO00007116\"},{\"id\":\"KIN1-26893\",\"schedule\":{\"businessDate\":\"2026-07-17\",\"startsAt\":\"2026-07-17T20:10:00+01:00\",\"endsAt\":\"2026-07-17T23:27:00+01:00\",\"filmStartsAt\":\"2026-07-17T20:35:00+01:00\",\"filmEndsAt\":\"2026-07-17T23:27:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-1-6\",\"filmId\":\"HO00007116\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-1\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000024\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"KIN1-130-HO00007116\"}],\"relatedData\":{\"sites\":[{\"id\":\"KIN1\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.4119987487793,\"longitude\":-0.30460000038147},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"KIN1@curzon.com\",\"address\":{\"line1\":\"The Bentall Centre,\",\"line2\":\"London,\",\"city\":\"KT1 1TP\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007116\",\"title\":{\"text\":\"The Odyssey\",\"translations\":[]},\"synopsis\":{\"text\":\"Legendary filmmaker Christopher Nolan follows up his Oscar-winning sensation Oppenheimer with another rousing epic, The Odyssey, whose all-star cast includes Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson, Lupita Nyong'o, Zendaya and Charlize Theron.\\n\\nThis mythic action movie recounts the story of Odysseus (Damon) on his perilous journey home, troubled by gods and monsters. Meanwhile, his wife Penelope (Hathaway) and son Telemachus (Holland) fight to hold their kingdom together against relentless suitors.\\n\\nSee it on 35mm film at Soho, and enjoy it with Dolby Atmos sound at Bloomsbury, Canterbury Riverside and Kingston.\\n\\nTHE ODYSSEY MIDNIGHT SCREENINGS\\nThe film will start promptly at 12:01am on Thursday night. Please ensure you are seated by midnight.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":172,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/b3ff6b75-3025-43b7-88a5-37fc8c43d313/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000319\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000680\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001061\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002220\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002609\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003850\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004443\",\"roles\":[\"Actor\"]},{\"castAndCrewM