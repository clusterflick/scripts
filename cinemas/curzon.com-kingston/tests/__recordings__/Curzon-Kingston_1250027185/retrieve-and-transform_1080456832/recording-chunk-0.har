          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-18\",\"showtimes\":[{\"id\":\"KIN1-27404\",\"schedule\":{\"businessDate\":\"2026-08-18\",\"startsAt\":\"2026-08-18T18:00:00+01:00\",\"endsAt\":\"2026-08-18T20:32:00+01:00\",\"filmStartsAt\":\"2026-08-18T18:15:00+01:00\",\"filmEndsAt\":\"2026-08-18T20:32:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-4-11\",\"filmId\":\"HO00007212\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-4\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"KIN1\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.4119987487793,\"longitude\":-0.30460000038147},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"KIN1@curzon.com\",\"address\":{\"line1\":\"The Bentall Centre,\",\"line2\":\"London,\",\"city\":\"KT1 1TP\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007212\",\"title\":{\"text\":\"Curzon Film 50: 120 BPM\",\"translations\":[]},\"synopsis\":{\"text\":\"The lives of AIDS activists in early 90s Paris are reimagined in bold and vivid detail in 120 BPM, a stunning and heart-wrenching drama from the writer of Palme d’Or winner The Class, Robin Campillo. Winner of the Grand Prix at Cannes 2017 and a host of international awards, this is an essential work of cinema with a profoundly moving and delicately crafted love story at its heart.\\n\\nAs the AIDS epidemic tears through their community, the members of ACT UP Paris are fighting for survival. While they battle against governmental apathy, pharmaceutical greed and public ignorance, they also go out partying, debate politics and, occasionally, fall in love. One day, as outspoken radical Sean (Nahuel Pérez Biscayart) strikes up a conversation with shy newcomer Nathan (Arnaud Valois), they have no idea that their lives are about to change forever.\\n\\nBased on the director’s own experiences, this vibrant and deeply emotional drama rushes with youthful energy, balancing powerful themes of social justice with euphoric moments of spine-tingling sensuality. Urgent and affecting, it’s a film about life, death, love, tragedy – and, above all, the will to survive.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"120 BPM. The average heart rate. The protagonists of 120 battements par minute are passionate about fighting the indifference that exists towards AIDS.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong sex, nudity, sex references, language\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":137,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=4GzCfjF0vDU\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=4GzCfjF0vDU\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000179\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000751\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007120\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008027\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014331\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014332\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000179\"},{\"castAndCrewMemberId\":\"0000000751\"},{\"castAndCrewMemberId\":\"0000014331\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000008027\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000007120\"},{\"castAndCrewMemberId\":\"0000014332\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007212\",\"hoCode\":\"A000008873\",\"eventId\":\"0000000068\",\"distributorName\":\"Curzon\"}],\"castAndCrew\":[{\"id\"