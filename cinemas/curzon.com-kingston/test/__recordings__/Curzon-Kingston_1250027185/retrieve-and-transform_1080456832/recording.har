            "text": "{\"businessDate\":\"2025-10-02\",\"showtimes\":[{\"id\":\"KIN1-17662\",\"schedule\":{\"businessDate\":\"2025-10-02\",\"startsAt\":\"2025-10-02T18:20:00+01:00\",\"endsAt\":\"2025-10-02T20:30:00+01:00\",\"filmStartsAt\":\"2025-10-02T18:30:00+01:00\",\"filmEndsAt\":\"2025-10-02T20:30:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-1-6\",\"filmId\":\"HO00006045\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-1\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000017\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"KIN1\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.412,\"longitude\":-0.3046},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Bentall Centre,\",\"line2\":\"London,\",\"city\":\"KT1 1TP\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006045\",\"title\":{\"text\":\"NT Live: Inter Alia\",\"translations\":[]},\"synopsis\":{\"text\":\"Oscar-nominated Rosamund Pike (Gone Girl, Saltburn) is Jessica in the much-anticipated next play from the team behind Prima Facie.      Jessica Parks is a smart Crown Court Judge at the top of her career. Behind the robe, she is a karaoke fiend, a loving wife and a supportive parent. When an event threatens to throw her life completely off balance, can she hold her family upright? \\nWriter Suzie Miller and director Justin Martin reunite following their global phenomenon Prima Facie, with this searing examination of modern motherhood and masculinity.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Oscar-nominated Rosamund Pike (Gone Girl, Saltburn) is Jessica in the much-anticipated next play from the team behind Prima Facie.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"ce