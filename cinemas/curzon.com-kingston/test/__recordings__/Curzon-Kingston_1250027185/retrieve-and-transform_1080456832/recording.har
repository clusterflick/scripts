AndCrewMemberId\":\"0000011429\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011430\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011431\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011432\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011433\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000003\",\"0000000007\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b560745f-df8b-460e-805c-3806cfabc263\",\"corporateId\":null},\"hopk\":\"HO00006207\",\"hoCode\":\"A000007663\",\"eventId\":null,\"distributorName\":\"Walt Disney Studios Motion Pictures - UK\"},{\"id\":\"HO00006110\",\"title\":{\"text\":\"F1® The Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career. Thirty years later, he’s a nomadic racer-for-hire when he’s approached by his former teammate Ruben Cervantes (Javier Bardem), owner of a struggling FORMULA 1 team that is on the verge of collapse. Ruben convinces Sonny to come back to FORMULA 1 for one last shot at saving the team and being the best in the world. He’ll drive alongside Joshua Pearce (Damson Idris), the team's hotshot rookie intent on setting his own pace. But as the engines roar, Sonny’s past catches up with him and he finds that in FORMULA 1, your teammate is your fiercest competition—and the road to redemption is not something you can travel alone.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate threat\",\"translations\":[]},\"releaseDate\":\"2025-06-25\",\"runtimeInMinutes\":156,\"trailerUrl\":\"https://www.youtube.com/watch?v=TZGY2CWPXeU\"