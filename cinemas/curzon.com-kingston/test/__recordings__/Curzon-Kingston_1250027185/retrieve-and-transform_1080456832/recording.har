":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"KIN1-85-HO00006204\"},{\"id\":\"KIN1-19562\",\"schedule\":{\"businessDate\":\"2025-06-24\",\"startsAt\":\"2025-06-24T20:40:00+01:00\",\"endsAt\":\"2025-06-24T23:11:00+01:00\",\"filmStartsAt\":\"2025-06-24T21:05:00+01:00\",\"filmEndsAt\":\"2025-06-24T23:11:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-2-7\",\"filmId\":\"HO00006206\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-2\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"KIN1-87-HO00006206\"},{\"id\":\"KIN1-19561\",\"schedule\":{\"businessDate\":\"2025-06-24\",\"startsAt\":\"2025-06-24T21:00:00+01:00\",\"endsAt\":\"2025-06-24T23:20:00+01:00\",\"filmStartsAt\":\"2025-06-24T21:25:00+01:00\",\"filmEndsAt\":\"2025-06-24T23:20:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-4-11\",\"filmId\":\"HO00006101\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-4\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"KIN1\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.412,\"longitude\":-0.3046},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Bentall Centre,\",\"line2\":\"London,\",\"city\":\"KT1 1TP\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006095\",\"title\":{\"text\":\"Lilo & Stitch\",\"translations\":[]},\"synopsis\":{\"text\":\"A live-action reimagining of Disney’s 2002 animated classic, “Lilo & Stitch” is the wildly funny and touching story of a lonely Hawaiian girl and the fugitive alien who helps to mend her broken family. Directed by Dean Fleischer Camp, the Oscar®-nominated filmmaker behind the animated feature film “Marcel the Shell with Shoes On,” the film stars Sydney Elizebeth Agudong, Billy Magnussen, Tia Carrere, Hannah Waddingham, Chris Sanders, with Courtney B. Vance, and Zach Galifianakis, introducing Maia Kealoha. “Lilo & Stitch” is produced by Jonathan Eirich, p.g.a. and Dan Lin, with Louie Provost, Tom Peitzman and Ryan Halprin serving as executive producers.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"“Lilo & Stitch” is the wildly funny and touching story of a lonely Hawaiian girl and the fugitive alien who helps to mend her broken family.\",\"translations\":[]},\"censorRatingId\":\"HO00000001\",\"censorRatingNote\":null,\"releaseDate\":\"2025-05-23\",\"runtimeInMinutes\":108,\"trailerUrl\":\"https://www.youtube.com/watch?v=8SBLkgpQ99U\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001269\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001723\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004973\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005592\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006407\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006408\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010016\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011110\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011111\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011112\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011113\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000003\",\"0000000007\"],\"externalIds\":{\"moviexchangeReleaseId\":\"560b5a6d-5c9a-496d-a7c0-df3e44b57480\",\"corporateId\":null},\"hopk\":\"HO00006095\",\"hoCode\":\"A000007515\",\"eventId\":null,\"distributorName\":\"Walt Disney Studios Motion Pictures - UK\"},{\"id\":\"HO00006096\",\"title\":{\"text\":\"Mission: Impossible - The Final Reckoning\",\"translations\":[]},\"synopsis\":{\"text\":\"Light the fuse because Tom Cruise's world-saving super spy Ethan Hunt is back to complete a mission for the ages alongside Simon Pegg, Ving Rhames and Hayley Atwell. This propulsive action-adventure demands to be seen on the big screen.    \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Our lives are the sum of our choices. Tom Cruise is Ethan Hunt in Mission: Impossible – The Final Reckoning.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"moderate violence, injury detail, threat, language\",\"translations\":[]},\"releaseDate\":\"2025-05-21\",\"runtimeInMinutes\":170,\"trailerUrl\":\"https://www.youtube.com/watch?v=CUAQn2P13yY\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000029\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000030\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000031\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000436\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000802\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003183\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003189\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003192\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003193\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003194\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004434\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005130\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005592\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005596\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005686\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005717\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005718\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005719\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005720\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005721\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005722\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006663\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011114\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011115\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000349\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\",\"0000000007\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9246b245-546b-48f2-aa44-5143e8e5b45e\",\"corporateId\":null},\"hopk\":\"HO00006096\",\"hoCode\":\"A000007516\",\"eventId\":null,\"distributorName\":\"Paramount\"},{\"id\":\"HO00006101\",\"title\":{\"text\":\"The Salt Path\",\"translations\":[]},\"synopsis\":{\"text\":\"THE SALT PATH is the profound true story of husband and wife, Raynor and Moth Winn’s 630-mile trek along the beautiful but rugged Cornish, Devon and Dorset coastline. After being forcibly removed from their home, they make the desperate decision to walk in the hope that, in nature, they will find solace and a sense of acceptance. With depleted resources, only a tent and some essentials between them, every step along the path is a testament to their growing strength and determination. THE SALT PATH is a journey that is exhilarating, challenging, and liberating in equal measure. A portrayal of home, how it can be lost and rediscovered in the most unexpected ways.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE SALT PATH is the profound true story of husband and wife, Raynor and Moth Winn’s 630-mile trek along the beautiful but rugged Cornish, Devon and Dorset coastline. \",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate sex, drug misuse\",\"translations\":[]},\"releaseDate\":\"2025-05-30\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=UQ7RJCOm-c8\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001890\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001891\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002998\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004583\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011130\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011131\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011132\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011133\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011134\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011135\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011136\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011137\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011138\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011139\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b7f9da6c-7b33-44f6-8667-f9f496405624\",\"corporateId\":null},\"hopk\":\"HO00006101\",\"hoCode\":\"A000007521\",\"eventId\":null,\"distributorName\":\"Black Bear\"},{\"id\":\"HO00006115\",\"title\":{\"text\":\"Film Club: Hot Milk\",\"translations\":[]},\"synopsis\":{\"text\":\"With a strange illness, a mother and her daughter embark on a journey to the Spanish coast to find a cure, and along the way the daughter discovers another reality far from her controlling mother.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"With a strange illness, a mother and her daughter embark on a journey to the Spanish coast to find a cure, and along the way the daughter discovers another reality...\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-26\",\"runtimeInMinutes\":92,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000784\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002729\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004216\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008628\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011202\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011203\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011204\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000003\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000200\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006115\",\"hoCode\":\"A000007545\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00006204\",\"title\":{\"text\":\"28 Years Later\",\"translations\":[]},\"synopsis\":{\"text\":\"Academy Award®-winning director Danny Boyle and Academy Award®-nominated writer Alex Garland reunite for 28 Years Later, a terrifying new story set in the world created by 28 Days Later. It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine, some have found ways to exist amidst the infected. One such group of survivors lives on a small island connected to the mainland by a single, heavily-defended causeway. When one of the group leaves the island on a mission into the dark heart of the mainland, he discovers secrets, wonders, and horrors that have mutated not only the infected but other survivors as well.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine...\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-19\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=poEFz8Ivzug\",\"di