          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 5226,
            "text": "{\"businessDate\":\"2026-03-31\",\"showtimes\":[{\"id\":\"KIN1-19092\",\"schedule\":{\"businessDate\":\"2026-03-31\",\"startsAt\":\"2026-03-31T17:15:00+01:00\",\"endsAt\":\"2026-03-31T23:10:00+01:00\",\"filmStartsAt\":\"2026-03-31T17:40:00+01:00\",\"filmEndsAt\":\"2026-03-31T23:10:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-1-6\",\"filmId\":\"HO00006232\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-1\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000042\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"KIN1\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.412,\"longitude\":-0.3046},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Bentall Centre,\",\"line2\":\"London,\",\"city\":\"KT1 1TP\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006232\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: Siegfried\",\"translations\":[]},\"synopsis\":{\"text\":\"Raised by a scheming dwarf and unaware of his true family origins, a young man embarks on an epic journey. Soon, destiny brings him face-to-face with a shattered sword, a fearsome dragon and the cursed ring it guards, and a Valkyrie forced into enchanted slumber... \\nMoments of transcendent beauty and heroic triumph sparkle in the third chapter of Wagner’s Ring cycle, brought to life under Barrie Kosky’s inspired eye following his spectacular Das Rheingold (2023) and Die Walküre (2025). Andreas Schager, in his much-anticipated debut with The Royal Opera, stars as Siegfried’s titular hero, alongside Christopher Maltman’s towering Wanderer, Peter Hoare’s treacherous Mime and Elisabet Strid’s radiant Brünnhilde. Antonio Pappano conducts, drawing out the unspoken tensions and ethereal mysticism of Wagner’s dynamic score.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Raised by a scheming dwarf and unaware of his true family origins, a young man embarks on an epic journey. \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-03-31\",\"runtimeInMinutes\":330,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003814\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006115\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006116\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000286\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000490\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000606\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000607\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000608\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000609\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"0000526f-f09f-444c-9d66-e6ec960d9d6d\",\"corporateId\":null},\"hopk\":\"HO00006232\",\"hoCode\":\"A000007689\",\"eventId\":\"0000000042\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000003814\",\"name\":{\"givenName\":\"Christopher \",\"familyName\":\"Maltman\",\"middleName\":null}},{\"id\":\"0000006115\",\"name\":{\"givenName\":\"Christopher\",\"familyName\":\"Purves\",\"middleName\":null}},{\"id\":\"0000006116\",\"name\":{\"givenName\":\"Barrie\",\"familyName\":\"Kosky\",\"middleName\":null}},{\"id\":\"HO00000286\",\"name\":{\"givenName\":\"Soloman\",\"familyName\":\"Howard\",\"middleName\":null}},{\"id\":\"HO00000490\",\"name\":{\"givenName\":\"Elisabet\",\"familyName\":\"Strid\",\"middleName\":null}},{\"id\":\"HO00000606\",\"name\":{\"givenName\":\"Andreas\",\"familyName\":\"Schager\",\"middleName\":null}},{\"id\":\"HO00000607\",\"name\":{\"givenName\":\"Peter\",\"familyName\":\"Hoare\",\"middleName\":null}},{\"id\":\"HO00000608\",\"name\":{\"givenName\":\"Wiebke\",\"familyName\":\"Lehmkuhl\",\"middleName\":null}},{\"id\":\"HO00000609\",\"name\":{\"givenName\":\"Sarah\",\"familyName\":\"Dufresne\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[],\"screens\":[{\"id\":\"KIN1-1\",\"name\":{\"text\":\"COLISEUM\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000042\",\"name\":{\"text\":\"Royal Ballet and Opera\",\"translations\":[]},\"shortName\":{\"text\":\"RB&O\",\"translations\":[]},\"description\":{\"text\":\"The Royal Ballet and Opera brings the thrill of world-class theatre to cinema screens right around the globe. \\n\\nWith productions across both Companies, the programme includes beloved classics as well as new productions.\\n\\nOffering audiences a view from the best seat in the house, the programme shares the joy of live performance, and the beauty of world-class art with cinemagoers in more than 1,500 cinemas and 50 countries around the world.\\n\",\"translations\":[]},\"schedule\":{\"startDate\":\"2024-09-01\",\"endDate\":\"2026-06-30\"},\"siteIds\":[\"ALD1\",\"BLO1\",\"CAM1\",\"CAN01\",\"CAN2\",\"COL1\",\"HOX1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SHE1\",\"SOH1\",\"VIC1\",\"WIM01\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"KIN1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}"
