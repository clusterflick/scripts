        "response": {
          "bodySize": 3787,
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 3787,
            "text": "{\"businessDate\":\"2025-11-05\",\"showtimes\":[{\"id\":\"KIN1-19086\",\"schedule\":{\"businessDate\":\"2025-11-05\",\"startsAt\":\"2025-11-05T19:15:00+00:00\",\"endsAt\":\"2025-11-05T23:10:00+00:00\",\"filmStartsAt\":\"2025-11-05T19:40:00+00:00\",\"filmEndsAt\":\"2025-11-05T23:10:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"KIN1-1-6\",\"filmId\":\"HO00006226\",\"siteId\":\"KIN1\",\"screenId\":\"KIN1-1\",\"areaCategories\":[{\"areaCategoryId\":\"KIN1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000042\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"KIN1\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.412,\"longitude\":-0.3046},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Bentall Centre,\",\"line2\":\"London,\",\"city\":\"KT1 1TP\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006226\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: La Fille Mal Gardee\",\"translations\":[]},\"synopsis\":{\"text\":\"Lise, the only daughter of Widow Simone, is in love with the young farmer Colas, but her mother has far more ambitious plans for her. Simone hopes to marry her off to Alain, the son of the wealthy proprietor Thomas. Desperate to marry Colas rather than Alain, Lise contrives to outwit her mother’s plans.  \\n65 years after its premiere, The Royal Ballet presents Frederick Ashton’s La Fille mal gardée. This affectionate portrayal of village life combines exuberant good humour and brilliantly inventive choreography in what is undoubtedly Ashton’s love letter to the English countryside. La Fille mal gardée whisks us away into pastoral bliss with Ferdinand Hérold’s cheerful score and Osbert Lancaster’s colourful designs.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Lise, the only daughter of Widow Simone, is in love with the young farmer Colas, but her mother has far more ambitious plans for her.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-05\",\"runtimeInMinutes\":210,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"431db788-8022-47d3-b718-45d5af01a49a\",\"corporateId\":null},\"hopk\":\"HO00006226\",\"hoCode\":\"A000007683\",\"eventId\":\"0000000042\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[],\"screens\":[{\"id\":\"KIN1-1\",\"name\":{\"text\":\"COLISEUM\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000042\",\"name\":{\"text\":\"Royal Ballet and Opera\",\"translations\":[]},\"shortName\":{\"text\":\"RB&O\",\"translations\":[]},\"description\":{\"text\":\"The Royal Ballet and Opera brings the thrill of world-class theatre to cinema screens right around the globe. \\n\\nWith productions across both Companies, the programme includes beloved classics as well as new productions.\\n\\nOffering audiences a view from the best seat in the house, the programme shares the joy of live performance, and the beauty of world-class art with cinemagoers in more than 1,500 cinemas and 50 countries around the world.\\n\",\"translations\":[]},\"schedule\":{\"startDate\":\"2024-09-01\",\"endDate\":\"2026-06-30\"},\"siteIds\":[\"ALD1\",\"BLO1\",\"CAM1\",\"CAN01\",\"CAN2\",\"COL1\",\"HOX1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SHE1\",\"SOH1\",\"VIC1\",\"WIM01\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"KIN1-0000