            "text": "{\"name\":\"Kingston\",\"urlSegment\":\"kingston\",\"url\":\"/venues/kingston/\",\"nodeId\":1806,\"alias\":\"cinema\",\"createDate\":\"2024-08-13T14:57:53\\u002B01:00\",\"updateDate\":\"2025-06-24T08:23:23\\u002B01:00\",\"robotsNoIndex\":false,\"robotsNoFollow\":false,\"masterCanonicalUrl\":null,\"excludeCanonicalUrl\":false,\"seoImage\":null,\"metaKeywords\":\"\",\"metaDescription\":\"Find out what\\u0027s on at Curzon Cinema in Kingston. Check out the latest blockbuster movies, new Indie film releases and the best of world cinema out now.\",\"seoPageTitle\":\"Curzon Kingston Cinema Showtimes \\u0026 Film Listings\",\"oGType\":\"\",\"twitterCard\":\"\",\"seoUrl\":\"\",\"oGLocale\":\"\",\"excludeFromXmlSitemap\":false,\"excludeFromSiteSearch\":false,\"pageTitle\":\"\",\"hideTitle\":false,\"grid\":[],\"redirectDetailsElement\":{\"redirect\":false,\"permanent\":false},\"heroCarouselDetailsElement\":[{\"image\":{\"mobile\":\"/media/hlrger5k/curzon-kingston-2.jpg?width=393\\u0026height=169\\u0026v=1dba25e58732bd0\",\"tablet\":\"/media/hlrger5k/curzon-kingston-2.jpg?width=782\\u0026height=315\\u0026v=1dba25e58732bd0\",\"desktop\":\"/media/hlrger5k/curzon-kingston-2.jpg?width=1216\\u0026height=523\\u0026v=1dba25e58732bd0\",\"alt\":\"\"},\"textHeading\":\"Welcome to Curzon Kingston\",\"actionLink\":{\"name\":\"take a tour\",\"target\":\"_blank\",\"url\":\"https://tours.360virtualtours.co.uk/curzon/kingston/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=393\\u0026height=169\\u0026v=1dbe4e025633ef0\",\"tablet\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=782\\u0026height=315\\u0026v=1dbe4e025633ef0\",\"desktop\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=1216\\u0026height=523\\u0026v=1dbe4e025633ef0\",\"alt\":\"\"},\"textHeading\":\"Support Stonewall on your Curzon cinema visit\",\"actionLink\":{\"name\":\"FIND OUT MORE\",\"url\":\"https://www.curzon.com/charity/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/ypoos51i/kingston-venue-page2.jpg?width=393\\u0026height=169\\u0026v=1dba25e8640a290\",\"tablet\":\"/media/ypoos51i/kingston-venue-page2.jpg?width=782\\u0026height=315\\u0026v=1dba25e8640a290\",\"desktop\":\"/media/ypoos51i/kingston-venue-page2.jpg?width=1216\\u0026height=523\\u0026v=1dba25e8640a290\",\"alt\":\"\"},\"textHeading\":\"Food and Drink\",\"actionLink\":{\"name\":\"View Menu\",\"target\":\"_blank\",\"url\":\"https://www.curzon.com/media/j4gbe2nc/menu-1.pdf\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/25adji3d/free-parking3.jpg?width=393\\u0026height=169\\u0026v=1dba25e9629a9e0\",\"tablet\":\"/media/25adji3d/free-parking3.jpg?width=782\\u0026height=315\\u0026v=1dba25e9629a9e0\",\"desktop\":\"/media/25adji3d/free-parking3.jpg?width=1216\\u0026height=523\\u0026v=1dba25e9629a9e0\",\"alt\":\"\"},\"textHeading\":\"Free Parking monday to friday\"},{\"image\":{\"mobile\":\"/media/wbliele3/ph-kingston.jpg?width=393\\u0026height=169\\u0026v=1dba2f1a402da30\",\"tablet\":\"/media/wbliele3/ph-kingston.jpg?width=782\\u0026height=315\\u0026v=1dba2f1a402da30\",\"desktop\":\"/media/wbliele3/ph-kingston.jpg?width=1216\\u0026height=523\\u0026v=1dba2f1a402da30\",\"alt\":\"\"},\"textHeading\":\"Hire Curzon Kingston\",\"actionLink\":{\"name\":\"Hire Curzon Kingston\",\"url\":\"https://www.curzon.com/private-hire/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/5acbuvfy/kingston-venue-page5.jpg?width=393\\u0026height=169\\u0026v=1dba25fa6eaf350\",\"tablet\":\"/media/5acbuvfy/kingston-venue-page5.jpg?width=782\\u0026height=315\\u0026v=1dba25fa6eaf350\",\"desktop\":\"/media/5acbuvfy/kingston-venue-page5.jpg?width=1216\\u0026height=523\\u0026v=1dba25fa6eaf350\",\"alt\":\"\"}},{\"image\":{\"mobile\":\"/media/x3edpzy5/rooftop1.jpg?width=393\\u0026height=169\\u0026v=1dba25fb52b53b0\",\"tablet\":\"/media/x3edpzy5/rooftop1.jpg?width=782\\u0026height=315\\u0026v=1dba25fb52b53b0\",\"desktop\":\"/media/x3edpzy5/rooftop1.jpg?width=1216\\u0026height=523\\u0026v=1dba25fb52b53b0\",\"alt\":\"\"},\"textHeading\":\"Rooftop at Curzon Kingston \",\"actionLink\":{\"name\":\"FIND OUT MORE\",\"url\":\"https://www.curzon.com/rooftop/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}}],\"cinemaLocationDetailsElement\":{\"venueCardImage\":{\"mobile\":\"/media/5gpdh2gz/cinema-venues-_kingston.jpg?width=300\\u0026height=160\\u0026v=1db99894b2be9e0\",\"alt\":\"\"},\"addressLine1\":\"The Bentall Centre\",\"addressLine2\":\"Wood St\",\"addressLine3\":\"Kingston upon Thames\",\"city\":\"London\",\"postcode\":\"KT1 1TP\",\"nearestStationName\":\"Kingston\",\"nearestStationType\":\"national-rail\"},\"vistaCinema\":{\"key\":\"KIN1\",\"value\":\"Kingston\"},\"informationTabAccordions\":[{\"heading\":\"Opening times\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EMonday to Saturday:\\u003C/strong\\u003E The cinema opens 30 minutes before the first show\\u0027s programme begins and closes at midnight.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESunday:\\u003C/strong\\u003E Closes at 11.30pm.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EThe Rooftop:\\u003C/strong\\u003E Opens from 12pm everyday.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cem\\u003EPlease be aware opening and closing times may be subject to change.\\u003C/em\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Screen info\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EColiseum (Dolby Atmos)\\u003C/strong\\u003E\\u003Cbr\\u003E110 seats, 4 wheelchair spaces\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EPalace\\u003C/strong\\u003E\\u003Cbr\\u003E60 seats, 2 wheelchair spaces\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EElectric\\u003C/strong\\u003E\\u003Cbr\\u003E55 seats, 2 wheelchair spaces\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003ECentury\\u003C/strong\\u003E\\u003Cbr\\u003E58 seats, 2 wheelchair spaces\\u003C/p\\u003E\"},{\"heading\":\"Accessibility\",\"body\":\"\\u003Cp\\u003EAll screens have 2-4 wheelchair spaces. Screens accessible toilet are situated on the 3rd floor. There\\u0027s lift access between each floor.\\u003C/p\\u003E\"},{\"heading\":\"Food and Drink\",\"body\":\"\\u003Cp\\u003EOur drinks menu includes a wide selection of cocktails, wine, craft beer, soft drinks and hot drinks.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022https://www.curzon.com/media/j4gbe2nc/menu-1.pdf\\u0022 target=\\u0022_blank\\u0022 title=\\u0022View Menu\\u0022\\u003ESee our full menu here.\\u003C/a\\u003E\\u003C/span\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Private hires\",\"body\":\"\\u003Cp\\u003EOur screens are available to rent for your private functions, email \\u003Ca href=\\u0022mailto:privatehires@curzon.com\\u0022 title=\\u0022Email private hires\\u0022\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003Eprivatehires@curzon.com\\u003C/span\\u003E\\u003C/a\\u003E for more information.\\u003C/p\\u003E\\n\\u003Cp\\u003ETo find out more, visit our \\u003Ca href=\\u0022https://www.curzon.com/private-hire/kingston/\\u0022 title=\\u0022Kingston private hires\\u0022\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003EPrivate Hires page\\u003C/span\\u003E.\\u003C/a\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Parking information\",\"body\":\"\\u003Cp\\u003EVisit Curzon Cinema on the Second Floor and enjoy up to 7 hours free parking at the Bentall Centre.\\u003C/p\\u003E\\n\\u003Cp\\u003EThe car park is free for Curzon customers 6am to 1am Monday-Friday. Please note, free parking is not available on the weekends or bank holidays.\\u00A0\\u003C/p\\u003E\\n\\u003Cp\\u003EPlease validate your parking on the device provided at the venue. If the device is not working please let a member of the Curzon staff know.\\u003C/p\\u003E\\n\\u003Cp\\u003ESee below for conditions:\\u003C/p\\u003E\\n\\u003Cp\\u003EClaim the free parking offer at the Curzon bar at the end of your Curzon Cinema visit. Free parking duration applies from arrival at the Bentall Centre Car Park until the end of your visit.\\u003C/p\\u003E\\n\\u003Cp\\u003E*Terms and Conditions:\\u003C/p\\u003E\\n\\u003Cp\\u003EOffer only valid with Curzon cinema ticket purchases only, it is not valid on Curzon food and beverages, valid in Car Parks A \\u0026amp; B. The offer is not valid in Seven Kings. The offer is valid from 00:00 Monday to 02:00 Saturday but does not include Public Holidays that are listed on the HM Government website. One discount can be applied to each visit. Discount only works for the current visit and if all the free time is not used up in that visit, remaining time cannot be carried forward to a subsequent visit. Change will not be given for any unused discount. Discounts attempted between 02:00 Saturday and Monday 00:00 or on a Public Holiday will not be accepted. Whilst unlikely, if the normal tariff without a discount generates a cheaper fee, that fee will be charged and not one with the discount.\\u003C/p\\u003E\"},{\"heading\":\"Social Media\",\"body\":\"\\u003Cp\\u003EInstagram: \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022https://www.instagram.com/kingstoncurzon?igsh=MWhieHBoZWFrdDAzMg==\\u0022 target=\\u0022_blank\\u0022 title=\\u0022Curzon Kingston Instagram\\u0022 data-anchor=\\u0022?igsh=MWhieHBoZWFrdDAzMg==\\u0022\\u003Ekingstoncurzon\\u003C/a\\u003E\\u003C/span\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Rooftop at Curzon\",\"body\":\"\\u003Cp\\u003EREOPENING MAY 2025\\u003C/p\\u003E\\n\\u003Cp\\u003EOur sophisticated new bar Rooftop at Curzon is now open. The venue boasts a breathtaking view of Kingston-on-Thames that can be enjoyed with a cocktail in hand from our curated menu.\\u003C/p\\u003E\\n\\u003Cp\\u003EPlease note the bar will be closed during private events. Check the \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022https://www.instagram.com/rooftopcurzon/\\u0022 target=\\u0022_blank\\u0022 title=\\u0022Kingston Rooftop Instagram\\u0022\\u003ERooftop at Curzon Instagram\\u003C/a\\u003E\\u003C/span\\u003E for the latest updates on opening times.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Ca href=\\u0022#\\u0022 title=\\u0022Rooftop Bar Kingston\\u0022\\u003EFind out more\\u003C/a\\u003E \\u2192\\u003C/p\\u003E\"}],\"informationTabDescription\":\"\\u003Cp\\u003ELocated in the bustling Bentall Centre, Curzon Kingston is a lively venue that houses four screens, each named after a local 20th-century cinema in a nod to the waterfront town\\u2019s cultural past. There\\u2019s the Palace, which pays tribute to Kingston\\u2019s first cinema from 1909; the Century, which opened in the 1920s and showed Charlie Chaplin\\u2019s\\u0026nbsp;\\u003Cem\\u003EModern Times\\u003C/em\\u003E (1936) as its final film; the church-hall conversion the Electric; and our designated Dolby Atmos screen the Coliseum, a homage to the town\\u2019s 1913 cinema.\\u0026nbsp;\\u003C/p\\u003E\",\"menuTabAccordions\":[{\"heading\":\"Pizza\",\"body\":\"\\u003Ctable border=\\u00221\\u0022 style=\\u0022border-collapse: collapse; width: 100%; height: 382px;\\u0022\\u003E\\n\\u003Ctbody\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EMargherita (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A311.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EPepperoni \\u0026amp; Honey\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003E\\u0027Nduja\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EGoat\\u0027s Cheese \\u0026amp; Caramelised Onion (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.80\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EMushroom \\u0026amp; Truffle Oil (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.80\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EVegan Margherita (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A311.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EVegan Mushroom \\u0026amp; Truffle Oil (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.80\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003ETomato \\u0026amp; Pesto Flatbread (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A37.95\\u003C/td\\u003E\\n\\u003C/tr\\u00