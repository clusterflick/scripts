             <span class=\"c-event-filter__item\">\n                        \n                        <span>View</span>\n                        <!-- What's On Filters: View -->\n                        <label for=\"list\" class=\"c-btn c-btn--small c-btn--primary\">\n                            List\n                            <input type=\"radio\" name=\"view\" value=\"list\" id=\"list\"  checked=\"checked\">\n                        </label>\n\n                        <!-- What's On Filters: View -->\n                        <label for=\"grid\" class=\"c-btn c-btn--small c-btn--muted\">\n                            Grid\n                            <input type=\"radio\" name=\"view\" value=\"grid\" id=\"grid\" >\n                        </label>\n                    </span>\n\n                                            <span class=\"c-event-filter__item\">\n                            \n                            <span>Order</span>\n                            <!-- What's On Filters: Sort -->\n                            <label for=\"date\" class=\"c-btn c-btn--small c-btn--primary\">\n                                Date\n                                <input type=\"radio\" name=\"sort\" value=\"date\" id=\"date\"  checked=\"checked\">\n                            </label>\n\n                            <!-- What's On Filters: Sort -->\n                            <label for=\"az\" class=\"c-btn c-btn--small c-btn--muted\">\n                                A-Z\n                                <input type=\"radio\" name=\"sort\" value=\"az\" id=\"az\" >\n                            </label>\n                        </span>\n                    \n                    <button type=\"submit\">Submit</button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"o-layout c-whats-on\">\n        <div class=\"o-layout__item u-1/4@tablet\">\n            <section class=\"c-event-filters\">\n                <section class=\"c-filter-list datepicker\">\n                    <div class=\"attendable-datepicker\"></div>\n                    <p class=\"c-small-label c-rss\"><a href=\"http://www.cadoganhall.com/events/rss/\"><i class=\"fas fa-rss-square\" aria-hidden=\"true\"></i></a></p>\n                </section>\n                                    <section class=\"c-filter-list\">\n                        <p class=\"c-small-label\">Filter by Genre</p>\n                        <ul class=\"c-event-filters__list c-event-filters__genre\">\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/chamber-recital\">Chamber music / Recital</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/choral-opera-vocal\">Choral / Opera / Vocal</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/christmas\">Christmas</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/classical-crossover\">Classical-crossover</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/comedy\">Comedy</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/dance-performance\">Dance / Performance</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/early-music\">Early Music</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/family-events\">Family Events</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/film\">Film / Film Music</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/folk-world\">Folk / World</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/free-events\">Free Events</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/jazz-blues\">Jazz / Blues</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/musical-theatre\">Musical Theatre</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/orchestral\">Orchestral</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/rock-pop\">Rock / Pop</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/spoken-word-literature\">Spoken Word / Literature</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/whats-on/genres/video-game-music\">Video game music</a></li>\n                                                        <li><a href=\"https://cadoganhall.com/encore-events/\">ENCORE Events</a></li>\n                            <li><a href=\"https://cadoganhall.com/whats-on/?results=all\">View all</a></li>\n                        </ul>\n                    </section>\n                \n                                    <section class=\"c-filter-list\">\n                        <p class=\"c-small-label\">Series</p>\n                        <ul class=\"c-event-filters__list c-event-filters__genre\">\n                                                            <li><a href=\"https://cadoganhall.com/series/zurich-international-orchestra-series-2026-27/\">Zurich International Orchestra Series 2026&#8209;27</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/series/out-to-lunch-2026-lunchtime-jazz-series/\">Out to Lunch 2026 lunchtime jazz series</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/series/comedy-at-cadogan-hall/\">Comedy at Cadogan Hall</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/series/beethoven-200/\">BEETHOVEN 200</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/series/chelsea-arts-festival-2026/\">Chelsea Arts Festival 2026</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/series/down-for-the-count/\">Down for the Count Swing Orchestra</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/series/efg-london-jazz-festival-2026/\">EFG London Jazz Festival 2026</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/series/national-symphony-orchestra/\">National Symphony Orchestra</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/series/polish-jazz-festival-2026/\">Polish Jazz Festival 2026</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/series/royal-philharmonic-orchestra-2026-27-season/\">Royal Philharmonic Orchestra 2026-27 season</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/series/the-jazz-repertory-company-presents/\">The Jazz Repertory Company presents...</a></li>\n                                                            <li><a href=\"https://cadoganhall.com/series/young-musicians-symphony-orchestra-2025-26/\">Young Musicians Symphony Orchestra</a></li>\n                                                    </ul>\n                    </section>\n                \n            </section>\n        </div>\n\n        <div class=\"o-layout__item u-3/4@tablet\">\n            <section class=\"c-event-list-typeahead\"></section>\n\n            \n                            <a class=\"c-btn c-btn--primary c-btn--small c-btn--filter-clear\" href=\"https://cadoganhall.com/admin/whats-on/\">&times; Clear Selection</a>\n                <h1 class=\"c-event-list__heading\">Film / Film Music</h1>\n            \n                                                <div class=\"c-event-item\">\n    <a class=\"c-event-item__link-wrap\" href=\"https://cadoganhall.com/whats-on/the-music-of-the-lord-of-the-rings/\">\n        <span class=\"u-hidden-visually\">\n            The Music of The Lord of The Rings        </span>\n    </a>\n\n    <figure class=\"fig\">\n            <img class=\"lazyload\"\n        src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\"\n        data-src=\"https://assets.cadoganhall.com/wp-content/uploads/2026/02/260910_LOTR.jpg\"\n        alt=\"The Music of The Lord of The Rings\"\n        title=\"The Music of The Lord of The Rings\"/>\n        </figure>\n\n    <div class=\"c-event-item__content\">\n        <h3 class=\"c-event-item__heading\">The Music of The Lord of The Rings</h3>\n                    <p class=\"c-event-item__subheading\">A Tribute to Howard Shore</p>\n                            <p class=\"c-event-item__date\">Thursday 10 September 2026, 7.30pm</p>\n                                    <div class=\"c-event-item__excerpt u-smallprint o-max--600\">Experience the majestic music of the legendary Lord of the Rings films in a breathtaking concert that will transport you straight into the heart of Tolkien’s universe, performed by the Mystery Ensemble with vocalist Josephine Shaw.\n</div>\n        \n        <div class=\"o-row c-event-buttons__row\">\n            \n                \n    <div class=\"c-event-buttons\">\n        <a class=\"c-btn c-btn--ghost\" data-button=\"more-info\" href=\"https://cadoganhall.com/whats-on/the-music-of-the-lord-of-the-rings/\">More Info</a>\n                    <a class=\" c-btn c-btn--book\" data-button=\"book\" href=\"https://cadoganhall.com/whats-on/the-music-of-the-lord-of-the-rings/book/1282034\">Book Now</a>            </div>\n</div>\n    </div>\n</div>\n                                    <div class=\"c-event-item\">\n    <a class=\"c-event-item__link-wrap\" href=\"https://cadoganhall.com/whats-on/frankenstein-1931-performed-live-by-the-royal-philharmonic-orchestra/\">\n        <span class=\"u-hidden-visually\">\n            Frankenstein (1931)        </span>\n    </a>\n\n    <figure class=\"fig\">\n            <img class=\"lazyload\"\n        src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\"\n        data-src=\"https://assets.cadoganhall.com/wp-content/uploads/2026/02/261025_frankenstein.jpg\"\n        alt=\"Frankenstein\"\n        title=\"Frankenstein\"/>\n        </figure>\n\n    <div class=\"c-event-item__content\">\n        <h3 class=\"c-event-item__heading\">Frankenstein (1931)</h3>\n                    <p class=\"c-event-item__subheading\">Film screening with new score performed live by the Royal Philharmonic Orchestra</p>\n                            <p class=\"c-event-item__date\">Sunday 25 October 2026, 3.30pm &amp; 7pm</p>\n                                    <div class=\"c-event-item__excerpt u-smallprint o-max--600\">A cinematic masterpiece transformed! The 1931 classic film starring Boris Karloff with a thrilling new film score by Grammy-nominated composer Michael Shapiro played live by the Royal Philharmonic Orchestra, turning a horror classic into a contempora...</div>\n        \n        <div class=\"o-row c-event-buttons__row\">\n            \n                \n    <div class=\"c-event-buttons\">\n        <a class=\"c-btn c-btn--ghost\" data-button=\"more-info\" href=\"https://cadoganhall.com/whats-on/frankenstein-1931-performed-live-by-the-royal-philharmonic-orchestra/\">More Info</a>\n                    <a class=\" c-btn c-btn--book\" data-button=\"book\" href=\"https://cadoganhall.com/whats-on/frankenstein-1931-performed-live-by-the-royal-philharmonic-orchestra/#performances-list\">Book Now</a>            </div>\n</div>\n    </div>\n</div>\n                                    <div class=\"c-event-item\">\n    <a class=\"c-event-item__link-wrap\" href=\"https://cadoganhall.com/whats-on/gareth-malone-sing-a-long-a-gareth-at-the-movies/\">\n        <span class=\"u-hidden-visually\">\n            Gareth Malone        </span>\n    </a>\n\n    <figure class=\"fig\">\n            <img class=\"lazyload\"\n        src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\"\n        data-src=\"https://assets.cadoganhall.com/wp-content/uploads/2026/06/261129_gareth1.jpg\"\n        alt=\"Sing-A-Long-A-Gareth at the Movies\"\n        title=\"Sing-A-Long-A-Gareth at the Movies\"/>\n        </figure>\n\n    <div class=\"c-event-item__content\">\n        <h3 class=\"c-event-item__heading\">Gareth Malone</h3>\n                    <p class=\"c-event-item__subheading\">Sing-A-Long-A-Gareth: At The Movies</p>\n                            <p class=\"c-event-item__date\">Sunday 29 November 2026, 4pm</p>\n                                    <div class=\"c-event-item__excerpt u-smallprint o-max--600\">Gareth Malone – the man who got the nation singing – is back on the road with Sing-A-Long-A-Gareth: At The Movies, a brand-new live show celebrating the unforgettable songs that have helped make movie moments magical. From sweeping cinema classic...</div>\n        \n        <div class=\"o-row c-event-buttons__row\">\n            \n                \n    <div class=\"c-event-buttons\">\n        <a class=\"c-btn c-btn--ghost\" data-button=\"more-info\" href=\"https://cadoganhall.com/whats-on/gareth-malone-sing-a-long-a-gareth-at-the-movies/\">More Info</a>\n                    <a class=\" c-btn c-btn--book\" data-button=\"book\" href=\"https://cadoganhall.com/whats-on/gareth-malone/book/1334634\">Book Now</a>            </div>\n</div>\n    </div>\n</div>\n                                    <div class=\"c-event-item\">\n    <a class=\"c-event-item__link-wrap\" href=\"https://cadoganhall.com/whats-on/zios-2026-27-taiwan-philharmonic-1/\">\n        <span class=\"u-hidden-visually\">\n            Taiwan Philharmonic        </span>\n    </a>\n\n    <figure class=\"fig\">\n            <img class=\"lazyload\"\n        src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\"\n        data-src=\"https://assets.cadoganhall.com/wp-content/uploads/2026/04/270327_ZIOS_Markl.jpg\"\n        alt=\"Jun Märkl. Photo by Tat Keng Tey.\"\n        title=\"Jun Märkl. Photo by Tat Keng Tey.\"/>\n        </figure>\n\n    <div class=\"c-event-item__content\">\n        <h3 class=\"c-event-item__heading\">Taiwan Philharmonic</h3>\n                            <p class=\"c-event-item__date\">Saturday 27 March 2027, 7.30pm</p>\n                                    <div class=\"c-event-item__excerpt u-smallprint o-max--600\">A thrilling ride through our solar system to a galaxy far, far away, via sci-fi film scores and highpoints of Holst’s orchestral classic.\nThe Taiwan Philharmonic, one of Asia’s finest orchestras, has travelled the furthest across our planet of al...</div>\n        \n        <div class=\"o-row c-event-buttons__row\">\n            \n                \n    <div class=\"c-event-buttons\">\n        <a class=\"c-btn c-btn--ghost\" data-button=\"more-info\" href=\"https://cadoganhall.com/whats-on/zios-2026-27-taiwan-philharmonic-1/\">More Info</a>\n                    <a class=\" c-btn c-btn--book\" data-button=\"book\" href=\"https://cadoganhall.com/whats-on/zios-taiwan-philharmonic/book/1318635\">Book Now</a>            </div>\n</div>\n    </div>\n</div>\n                            \n            <!-- Events near the date -->\n                        <!-- End of Events near the da