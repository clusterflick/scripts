          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"status\":true,\"data\":{\"movies\":[{\"movie_id\":\"124\",\"type\":\"movie\",\"movie_name\":\"MAIN VAAPAS AAUNGA\",\"date_release_date\":\"2026-06-12\",\"movie_end_date\":null,\"movie_countries\":\"India\",\"genre\":[{\"name\":\"Drama\"},{\"name\":\"Historical period drama\"},{\"name\":\"Romance\"}],\"synopsis\":\"<p>It is a story of a boy and a girl, but also a country. This tale of fiction derives almost entirely from stories of people during the Partition of India. The past is always present. And decades later, when all incidents of woe have been spoken of, what remains is the early feeling of love that was too personal to share.<\\/p>\",\"portrait_image\":\"https:\\/\\/metrocinema.static.cinesync.io\\/images\\/movie\\/1781002826download.webp\",\"landscape_image\":\"https:\\/\\/metrocinema.static.cinesync.io\\/images\\/movie\\/1781002826download-1.webp\",\"url_key\":\"mainvaapasaaunga\",\"page_link\":\"https:\\/\\/www.metrocinema.co.uk\\/movies\\/mainvaapasaaunga?location=metro-cinema&locationKey=4\",\"session_start_date\":\"2026-07-11\",\"imdb_rate\":\"0.0\",\"trailer\":\"\",\"trailer_type\":\"1\",\"trailer_id\":false,\"duration\":\"2h 47m\",\"movie_year\":\"2026\",\"cast\":[{\"actor\":\"VEDANG RAINA\"},{\"actor\":\"NASEERUDDIN SHAH\"},{\"actor\":\"SHARVARI WAGH\"},{\"actor\":\"DILJIT DOSANJH\"}],\"directed_by\":[],\"movie_tags\":[],\"movie_language\":[{\"id\":\"1\",\"name\":\"Hindi Language\",\"short_name\":\"Hindi\",\"description\":null}],\"movie_certification_type_id\":\"7\",\"movie_certification_logo\":\"https:\\/\\/metrocinema.static.cinesync.io\\/images\\/movie_certificate\\/15certificate1764765279.svg\",\"movie_certification_name\":\"15\",\"movie_certification_short_code\":\"15\",\"movie_certification_description\":\"\",\"is_restricted_mode\":false,\"is_booking_open\":true,\"is_coming_soon\":false,\"is_this_sold_by_third_party_system\":\"-1\",\"third_party_system_url\":\"\",\"third_party_system_message\":\"Sorry, online booking isn