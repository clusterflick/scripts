9\",\"850\",\"851\",\"852\",\"853\",\"854\",\"856\",\"857\",\"858\",\"859\",\"860\",\"888\",\"912\",\"915\",\"916\",\"917\",\"920\",\"923\",\"925\",\"929\",\"930\",\"948\",\"949\",\"953\",\"954\",\"955\",\"957\",\"961\",\"962\",\"963\",\"980\",\"985\",\"995\",\"998\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"486-0000000001\",\"name\":{\"text\":\"Recliner Saver\",\"translations\":[]},\"hopk\":\"0000000002\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false},{\"id\":\"486-0000000013\",\"name\":{\"text\":\"Recliner Popular\",\"translations\":[]},\"hopk\":\"0000000020\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false},{\"id\":\"486-0000000020\",\"name\":{\"text\":\"Recliner\",\"translations\":[]},\"hopk\":\"0000000029\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
