          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-12-01\",\"showtimes\":[{\"id\":\"486-22565\",\"schedule\":{\"businessDate\":\"2026-12-01\",\"startsAt\":\"2026-12-01T19:15:00+00:00\",\"endsAt\":\"2026-12-01T22:00:00+00:00\",\"filmStartsAt\":\"2026-12-01T19:40:00+00:00\",\"filmEndsAt\":\"2026-12-01T22:00:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"486-2-25\",\"filmId\":\"HO00008947\",\"siteId\":\"486\",\"screenId\":\"486-2\",\"areaCategories\":[{\"areaCategoryId\":\"486-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"486-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"486-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"486\",\"name\":{\"text\":\"Putney\",\"translations\":[]},\"location\":{\"latitude\":51.4654,\"longitude\":-0.2145},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Putney@OdeonUK.com\",\"address\":{\"line1\":\"26 Putney High Street\",\"line2\":\"Putney\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008947\",\"title\":{\"text\":\"RBO Cinema Season 2026-27: The Nutcracker\",\"translations\":[]},\"synopsis\":{\"text\":\"At a cosy Christmas party, young Clara meets the mysterious magician Drosselmeyer, who gives her a nutcracker doll. When the guests have departed and the house is asleep, Clara sneaks downstairs in search of the doll. Instead, she finds Drosselmeyer, who whisks her away on a journey into a whole world of enchantment: fantastical landscapes of flurried snow and glittering confection where toys come alive and the magic never stops. \\nPeter Wright’s production of this festive family favourite sparkles to the wondrous swell of Tchaikovsky’s orchestral score, alongside the glow and grandeur of Julia Trevelyan Oman’s period designs.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"At a cosy Christmas party, young Clara meets the mysterious magician Drosselmeyer, who gives her a nutcracker doll. \",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-12-01\",\"runtimeInMinutes\":140,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000015496\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018982\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018983\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"6141\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"6144\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":\"bf98f859-895c-4c38-8fb5-ff31eab7f8da\",\"corporateId\":null},\"hopk\":\"HO00008947\",\"hoCode\":\"A000010094\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000015496\",\"name\":{\"givenName\":\"James\",\"familyName\":\"Hay\",\"middleName\":null}},{\"id\":\"0000018982\",\"name\":{\"givenName\":\"Marianna\",\"familyName\":\"Tsembenhoi\",\"middleName\":null}},{\"id\":\"0000018983\",\"name\":{\"givenName\":\"Taisuke\",\"familyName\":\"Nakao\",\"middleName\":null}},{\"id\":\"6141\",\"name\":{\"givenName\":\"Reece\",\"familyName\":\"Clarke\",\"middleName\":null}},{\"id\":\"6144\",\"name\":{\"givenName\":\"Mayara\",\"familyName\":\"Magri\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000028\",\"name\":{\"text\":\"Ballet\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"descr