ce-cdn.com/content/v1/6386527a7fa42418322e3fbe/faccbfa5-e741-46c1-96a0-153f70d037b6/16-9.png\\\"\\n  data-image-dimensions=\\\"1200x630\\\"\\n  data-image-focal-point=\\\"0.5,0.5\\\"\\n  data-sqsp-image-classic-block-image\\n  alt=\\\"\\\"\\n  data-licensed-asset-preview=\\\"false\\\"\\n  data-load=\\\"false\\\" elementtiming=\\\"system-image-block\\\" src=\\\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/faccbfa5-e741-46c1-96a0-153f70d037b6/16-9.png\\\" width=\\\"1200\\\" height=\\\"630\\\" alt=\\\"\\\" sizes=\\\"auto, (max-width: 640px) 100vw, (max-width: 767px) 75.00vw, 75.00vw\\\" style=\\\"display:block;object-position: var(--image-component-focal-point);object-fit: var(--image-component-object-fit);\\\" srcset=\\\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/faccbfa5-e741-46c1-96a0-153f70d037b6/16-9.png?format=100w 100w, https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/faccbfa5-e741-46c1-96a0-153f70d037b6/16-9.png?format=300w 300w, https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/faccbfa5-e741-46c1-96a0-153f70d037b6/16-9.png?format=500w 500w, https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/faccbfa5-e741-46c1-96a0-153f70d037b6/16-9.png?format=750w 750w, https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/faccbfa5-e741-46c1-96a0-153f70d037b6/16-9.png?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/faccbfa5-e741-46c1-96a0-153f70d037b6/16-9.png?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/faccbfa5-e741-46c1-96a0-153f70d037b6/16-9.png?format=2500w 2500w\\\" loading=\\\"lazy\\\" decoding=\\\"async\\\" data-loader=\\\"sqs\\\" data-image-component=\\\"1.0.1\\\">\\n        </div>\\n      </div>\\n    \\n        \\n      \\n\\n      \\n        <figcaption\\n          data-sqsp-image-classic-block-caption-container\\n          \\n          class=\\\"image-caption-wrapper\\\"\\n        >\\n          <div class=\\\"image-caption\\\"><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\"><em>Image: OONA, The Station Where David Gets Off for Work, 2024, photograph. Photo by Karolina Krupi\\u010Dkov\\u00E1. Courtesy of OONA and The Second-Guess.</em></p></div>\\n        </figcaption>\\n      \\n    \\n      </figure>\\n    \\n\\n    \\n\\n\\n  </div>\\n\\n  \\n\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"yui_3_17_2_1_1788452117034_4308\\\" id=\\\"block-yui_3_17_2_1_1788452117034_4308\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content>\\n<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>Dear David</em> is powered by Art on Tezos.</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"></p><p class=\\\"p1\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>HERVISIONS</strong> (est. 2015) is a femme-focused curatorial agency facilitating online and offline experiences and collaborations with partners to research and produce innovative commissions, exhibitions and events with a strong focus on the intersection of art, technology and culture.</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>OONA</strong> (b. 2021) is an anonymous performance and conceptual artist. She does not exist, but she takes herself seriously, so you should too.</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>The Second-Guess</strong> is a curatorial collective based in Berlin and Los Angeles that explores the relationship between humans and technology. Co-founded by Anika Meier and Margaret Murphy.</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>Frieze Connect</strong> is a membership programme that connects you with the people and ideas shaping contemporary culture.</p>\\n<p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\">Members have access to all events in our programme.</p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-yui_3_17_2_1_1788452117034_4308 {\\n    \\n    --stroke-style: none;--stroke-thickness: 2px;\\n    \\n      --tweak-text-block-stroke-color: hsla(var(--black-hsl), 1)\\n;\\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-yui_3_17_2_1_1788452117034_4308 .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-yui_3_17_2_1_1788452117034_4308 {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-yui_3_17_2_1_1788452117034_4308 {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  #block-yui_3_17_2_1_1788452117034_4308 {\\n      --tweak-text-block-blend\\n  : normal;\\n    }\\n  \\n\\n  #block-yui_3_17_2_1_1788452117034_4308 {\\n    --blur-value: blur(15px);}\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-yui_3_17_2_1_1788452117034_4308 {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-yui_3_17_2_1_1788452117034_4308 .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n        }</style>\\n<style class=\\\"transform-vars\\\">\\n    #block-yui_3_17_2_1_1788452117034_4308 {\\n      --opacity: 100%;\\n      --translate-x: 0px;\\n      --translate-y: 0px;\\n      --rotation: 0deg;\\n      --scale-x: 100%;\\n      --scale-y: 100%;\\n      --skew-x: 0deg;\\n      --skew-y: 0deg;\\n      --origin-x: 50%;\\n      --origin-y: 50%;\\n      --block-transform: none;\\n\\n      opacity: var(--opacity, 1);\\n      transform: var(--block-transform);\\n      transform-origin: var(--origin-x) var(--origin-y);\\n    }\\n  </style><style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n\\n\\n\\n</div>\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/e388f110-411c-4f4a-a838-d57e9dd77523_1174/website.components.button.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/e388f110-411c-4f4a-a838-d57e9dd77523_1174/website.components.button.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.button\\\" data-sqsp-block=\\\"button\\\" data-website-component-id=\\\"f9858893c92e9b1ab670\\\" id=\\\"block-f9858893c92e9b1ab670\\\"><div class=\\\"sqs-block-content\\\">\\n\\n\\n\\n  \\n    \\n    \\n      \\n      \\n\\n\\n\\n<div\\n  class=\\\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--left \\\"\\n  data-animation-role=\\\"button\\\"\\n  data-button-size=\\\"medium\\\"\\n  data-button-type=\\\"primary\\\"\\n  \\n>\\n 