\\\" data-website-component-id=\\\"8ee6179ae3096d611719\\\" id=\\\"block-8ee6179ae3096d611719\\\"><div class=\\\"sqs-block-content\\\">\\n  \\n\\n<div\\n  class=\\\"sqs-code-container\\\"\\n  \\n  \\n    data-localized=\\\"{&quot;enableSafeModeButton&quot;:&quot;Preview in safe mode&quot;,&quot;enableSafeModeText&quot;:&quot;This block contains embedded scripts. Embedded scripts are disabled while you're logged in and editing your site.&quot;,&quot;enableSafeModeTitle&quot;:&quot;Embedded Scripts&quot;,&quot;exitSafeModeButton&quot;:&quot;Exit safe preview&quot;,&quot;exitSafeModeText&quot;:&quot;Please view the page after logging out for accurate rendering.&quot;,&quot;exitSafeModeTitle&quot;:&quot;Safe Preview&quot;,&quot;globalSafeMode&quot;:&quot;Embedded Code: This block contains embedded code that has been disabled.&quot;,&quot;scriptDisabled&quot;:&quot;Script Disabled&quot;}\\\"\\n  \\n  \\n  \\n  \\n>\\n  \\n    <style>\\n.header-title-logo a {\\n  content: url(\\\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/e97578eb-c638-4fe4-87a2-fc226c8624b2/shoreditch-arts-club-logo.png\\\");\\n  }\\n</style>\\n  \\n  \\n\\n\\n\\n</div>\\n\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div></div><div class=\\\"col sqs-col-3 span-3\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\\\" data-aspect-ratio=\\\"2.615933412604043\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"88f3f764c34956759b35\\\" id=\\\"block-88f3f764c34956759b35\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Join us for a curated screening celebrating the launch of FUBU Film Club - a digital film archive and platform dedicated to the research, curation and preservation of Black moving image, via ongoing cataloguing of Black Film and Video between 1960 - 2015. </p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/fubu-film-club\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1787858505191-0914S67WWOMH1ZRSY9I1/Screenshot%2B2026-08-27%2Bat%2B20.20.45.png\",\"contentType\":\"image/png\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1791565200671,\"endDate\":1791576000671},\"startDate\":1791565200671,\"endDate\":1791576000671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1008x708\",\"recordTypeLabel\":\"event\"},{\"id\":\"6a995e9f8ef82a4c06481fb3\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1788436965546,\"updatedOn\":1789381091336,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1788436965546,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"1788436838187-9DQZOTQV98Y5DNLSNUN3\",\"systemDataVariants\":\"1200x675\",\"systemDataSourceType\":\"PNG\",\"filename\":\"Founders Series first event.png\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"89144d\",\"topRightAverage\":\"9c1540\",\"bottomLeftAverage\":\"97073b\",\"bottomRightAverage\":\"97163f\",\"centerAverage\":\"af7585\",\"suggestedBgColor\":\"564241\"},\"urlId\":\"code-hospitality-\",\"title\":\"CODE Founders Series: The Restaurant Toolkit\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a995e9f8ef82a4c06481fb3\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"e145ab9bbf456ae5c27d\\\" id=\\\"block-e145ab9bbf456ae5c27d\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Monday 5th October, 6 \\u2014 8:30pm: CODE Founders Series: The Restaurant Toolkit</h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">The&nbsp;CODE&nbsp;Founders Series, powered by Toast, is back. Now in its third year, this popular panel series explores what it takes to make it in&nbsp;hospitality&nbsp;through the eyes of founders and operators.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Join the first panel of the&nbsp;CODE&nbsp;Founders Series, powered by Toast. Learn how to start, scale and succeed from our experienced industry panel comprising Laura Harper-Hinton, co-founder and CEO of Caravan Restaurants and Coffee Roasters; James Robson, co-owner of Fallow, Roe, Fowl and OXO Tower Restaurant; and Ravinder Bhogal and Nadeem Lalani Nanjuwany, the husband and wife team behind Jikoni, Caf\\u00E9 Jikoni at V&amp;A East.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Our panellists have all started from scratch (at least once) and will answer all your questions about finances, property, tech and more.</p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-e145ab9bbf456ae5c27d {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-e145ab9bbf456ae5c27d .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-e145ab9bbf456ae5c27d {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-e145ab9bbf456ae5c27d {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-e145ab9bbf456ae5c27d {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-e145ab9bbf456ae5c27d {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-e145ab9bbf456ae5c27d .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n        }</style>\\n<style class=\