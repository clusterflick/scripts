"code\\\" data-website-component-id=\\\"cde6930abe71774a88e5\\\" id=\\\"block-cde6930abe71774a88e5\\\"><div class=\\\"sqs-block-content\\\">\\n  \\n\\n<div\\n  class=\\\"sqs-code-container\\\"\\n  \\n  \\n    data-localized=\\\"{&quot;enableSafeModeButton&quot;:&quot;Preview in safe mode&quot;,&quot;enableSafeModeText&quot;:&quot;This block contains embedded scripts. Embedded scripts are disabled while you're logged in and editing your site.&quot;,&quot;enableSafeModeTitle&quot;:&quot;Embedded Scripts&quot;,&quot;exitSafeModeButton&quot;:&quot;Exit safe preview&quot;,&quot;exitSafeModeText&quot;:&quot;Please view the page after logging out for accurate rendering.&quot;,&quot;exitSafeModeTitle&quot;:&quot;Safe Preview&quot;,&quot;globalSafeMode&quot;:&quot;Embedded Code: This block contains embedded code that has been disabled.&quot;,&quot;scriptDisabled&quot;:&quot;Script Disabled&quot;}\\\"\\n  \\n  \\n  \\n  \\n>\\n  \\n    <style>\\n.header-title-logo a {\\n  content: url(\\\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/e97578eb-c638-4fe4-87a2-fc226c8624b2/shoreditch-arts-club-logo.png\\\");\\n  }\\n</style>\\n  \\n  \\n\\n\\n\\n</div>\\n\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div></div><div class=\\\"col sqs-col-3 span-3\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\\\" data-aspect-ratio=\\\"2.615933412604043\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"6d1e36b330eeb2ac1ffe\\\" id=\\\"block-6d1e36b330eeb2ac1ffe\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">How do you keep your culture, values and team spirit intact as you add sites, people and complexity? This is a chance to hear directly from four of the businesses on CODE\\u2019s list of Happiest Places to Work 2026 on how they do it.</p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/code-hospitality-13-oct\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1789382554251-MW61RWJADUA7N05S9QYS/1.png\",\"contentType\":\"image/png\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1791910800671,\"endDate\":1791919800671},\"startDate\":1791910800671,\"endDate\":1791919800671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1440x872\",\"recordTypeLabel\":\"event\"},{\"id\":\"6a908d287245037916ad7c5f\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1787858605016,\"updatedOn\":1789386841522,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1787858605016,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"1787858505191-0914S67WWOMH1ZRSY9I1\",\"systemDataVariants\":\"1008x708\",\"systemDataSourceType\":\"PNG\",\"filename\":\"Screenshot+2026-08-27+at+20.20.45.png\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"180708\",\"topRightAverage\":\"130600\",\"bottomLeftAverage\":\"2c191f\",\"bottomRightAverage\":\"3c3434\",\"centerAverage\":\"2c1615\",\"suggestedBgColor\":\"2c1d1d\"},\"urlId\":\"fubu-film-club\",\"title\":\"Anatomy of an Archive \\u2014 A FUBU Film Club + DykeTV Screening\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a908d287245037916ad7c5f\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"e2ada3981106e5adb327\\\" id=\\\"block-e2ada3981106e5adb327\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Friday 9th October, 6 \\u2014 9pm: Anatomy of an Archive \\u2014 A FUBU Film Club + DykeTV Screening</h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">An activation of FUBU Film Club - a digital film archive and platform dedicated to the research, curation and preservation of Black moving image, via ongoing cataloguing of Black Film and Video between 1960 - 2015. </p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Curated by Tosin Alapafuja, this event seeks to acknowledge Black Archival Film research as an act of media archaeology through conversation, connection and cinema - what do we find when the process of digging is intentional, in depth and a careful act of sifting through? What materials we are able to uncover, what does it tell us about the lifestyles, cultures, communities and experiences of that time? Most importantly, how can we ensure Black film history stays accessible?</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"></p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Members go free. View your members\\u2019 newsletter or contact the team directly to RSVP.</p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-e2ada3981106e5adb327 {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-e2ada3981106e5adb327 .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-e2ada3981106e5adb327 {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-e2ada3981106e5adb327 {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-e2ada3981106e5adb327 {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-e2ada3981106e5adb327 {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-e2ada3981106e5adb327 .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n        }</style>\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n\\n\\n\\n</div>\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-image image-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.imageLayout/4b41942d-5437-43a4-a2b3-8363fa33b1b6_248/website.components.imageLayout.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.imageLayout/4b41942d-5437-43a4-a2b3-8363fa33b1b6_248/website.components.imageLayout.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.imageLayout\\\" data-sqsp-block=\\\"image-classic\\\" data-website-component-id=\\\"0d7b9d46b770f8fefa30\\\" id=\\\"block-0d7b9d46b770f8fefa30\\\"><div class=\\\"sqs-block-content\\\">\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n  \\n  \\n    \\n  <div\\n    class=\\\"\\n      image-block-outer-wrapper\\n      layout-caption-below\\n      design-layout-inline\\n      combination-animation-site-default\\n      individual-animation-site-default\\n      individual-text-animation-site-default\\n    \\\"\\n    data-test=\\\"image-block-inline-outer-wrapper\\\"\\n    data-sqsp-image-classic-block-layout=\\\"inline\\\"\\n    style=\\\"--image-component-focal-point: 50% 50%;--image-component-object-fit: cover;\\\"\\n  >\\n\\n    \\n\\n    \\n\\n    \\n      <figure\\n        class=\\\"sqs-block-image-figure intrinsic\\\"\\n        style=\\\"max-width:1008px;\\\"\\n      >\\n        \\n      \\n        \\n          \\n      <div\\n        \\n        \\n        class=\\\"image-block-wrapper\\\"\\n        data-animation-role=\\\"image\\\"\\n        \\n  \\n\\n      >\\n        <div\\n          data-sqsp-image-classic-block-image-container\\n 