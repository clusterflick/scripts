ng your site.&quot;,&quot;enableSafeModeTitle&quot;:&quot;Embedded Scripts&quot;,&quot;exitSafeModeButton&quot;:&quot;Exit safe preview&quot;,&quot;exitSafeModeText&quot;:&quot;Please view the page after logging out for accurate rendering.&quot;,&quot;exitSafeModeTitle&quot;:&quot;Safe Preview&quot;,&quot;globalSafeMode&quot;:&quot;Embedded Code: This block contains embedded code that has been disabled.&quot;,&quot;scriptDisabled&quot;:&quot;Script Disabled&quot;}\\\"\\n  \\n  \\n  \\n  \\n>\\n  \\n    <style>\\n.header-title-logo a {\\n  content: url(\\\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/e97578eb-c638-4fe4-87a2-fc226c8624b2/shoreditch-arts-club-logo.png\\\");\\n  }\\n</style>\\n  \\n  \\n\\n\\n\\n</div>\\n\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div></div><div class=\\\"col sqs-col-3 span-3\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\\\" data-aspect-ratio=\\\"2.615933412604043\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"7188bf081d8fc8fd28fa\\\" id=\\\"block-7188bf081d8fc8fd28fa\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Please join us at the beautiful Interval in Clerkenwell for an intimate members\\u2019 mixer, led by the Club\\u2019s longtime collaborator and Interval co-founder David Gryn.</p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52448099999999,\"mapLng\":-0.1026785,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Interval\",\"addressLine1\":\"73 Compton Street\",\"addressLine2\":\"London, England, EC1V 0BN\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/interval-members-mixer-lorette\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1784236625516-C9MUYOMBJSNB48WAV8AC/726220490_17906798961426514_8696230421275212043_n.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1785949200518,\"endDate\":1785952800518},\"startDate\":1785949200518,\"endDate\":1785952800518,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1428x1030\",\"recordTypeLabel\":\"event\"},{\"id\":\"6a280088e0b6014f86b4ab6e\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1781012332935,\"updatedOn\":1783590177204,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1781012332935,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"282cba60-7774-4454-b0de-9db9ef9cfbe6\",\"systemDataVariants\":\"1491x838\",\"systemDataSourceType\":\"JPG\",\"filename\":\"light-language.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"747b61\",\"topRightAverage\":\"524e33\",\"bottomLeftAverage\":\"929c81\",\"bottomRightAverage\":\"a3855d\",\"centerAverage\":\"707256\",\"suggestedBgColor\":\"8a6e58\"},\"urlId\":\"nick-fraser-chapter-2\",\"title\":\"Nick Fraser: Chapter 2\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a280088e0b6014f86b4ab6e\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"22a4d75214de548b47ca\\\" id=\\\"block-22a4d75214de548b47ca\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Friday 31st July, 7 \\u2014 10pm: Nick Fraser: Chapter 2</h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Celebrate the life of artist Nick Fraser (1946 \\u2013&nbsp;2023) an East End legend who spent more than three decades working at the Tate &amp; Lyle factory while privately building an extraordinary world of colour, symbols, faith, humour and human feeling.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Nick Fraser: Chapter 2 is an immersive one-day exhibition at Shoreditch Arts Club combining original artworks, archival projection, rare film footage and a live musical performance from BoThai. The evening will also unveil the first public release of limited-edition Nick Fraser prints. </p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">The exhibition is thoughtfully curated by member Marcus O\\u2019Shaughnessy, a close family friend of Fraser\\u2019s, who Fraser had entrusted along with his father his archival collection upon his passing.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Largely self-taught, Fraser created outside the art world and away from public attention. Using construction materials and decorating supplies from everyday life, he made large-scale paintings and multi-panel works that feel both raw and devotional.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>Born in 1946 and known privately for decades as a fiercely independent and deeply contemplative artist, Fraser created a powerful body of work exploring masculinity, spirituality, identity, memory and human existence. Working largely outside the traditional art world, he developed an uncompromising visual language that remained hidden from public view for much of his life.</em></p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-22a4d75214de548b47ca {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-22a4d75214de548b47ca .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-22a4d75214de548b47ca {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-22a4d75214de548b47ca {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-22a4d75214de548b47ca {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-22a4d75214de548b47ca {\\n            \\n            }\\n        }\\n    \\n  \\n    @media scree