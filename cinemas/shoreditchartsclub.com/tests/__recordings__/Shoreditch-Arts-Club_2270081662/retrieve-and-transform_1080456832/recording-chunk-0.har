sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"1fee77c537e1bfc24cbf\\\" id=\\\"block-1fee77c537e1bfc24cbf\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">We close our Artist Focus series with Emily Pope's new film premiere: <em>Last Orders</em>, which explores themes of obsession and rebirth.</p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/a-z-shoreditch-arts-club-act-iii-emily-pope\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1792572612647-IOQYWLIH8WP7F1VSNX2R/e66538a0-354a-41ce-89b9-be895c2b7101.png\",\"contentType\":\"image/png\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1796061600671,\"endDate\":1796072400671},\"startDate\":1796061600671,\"endDate\":1796072400671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1030x579\",\"recordTypeLabel\":\"event\"}],\"past\":[{\"id\":\"6a9a9d9fe4daac55116df101\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1788519467217,\"updatedOn\":1789379407770,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1788519467217,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"1788519328248-4P96B6TJI9G4C6LSVC37\",\"systemDataVariants\":\"1200x675\",\"systemDataSourceType\":\"JPG\",\"filename\":\"Web_Ready-Janisa_BlueMoonBrewery_Toronto_PascalineLeBras_17July2023_8.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"0b051f\",\"topRightAverage\":\"020107\",\"bottomLeftAverage\":\"02062e\",\"bottomRightAverage\":\"02115b\",\"centerAverage\":\"20031b\",\"suggestedBgColor\":\"20113b\"},\"urlId\":\"sofar-fringe-festival-shoreditch-arts-club\",\"title\":\"Sofar Fringe Festival\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a9a9d9fe4daac55116df101\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"f0faa39fe3f2410b2932\\\" id=\\\"block-f0faa39fe3f2410b2932\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Saturday 17th October, 1pm \\u2014 late:  Sofar Fringe Festival</h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Sofar Fringe is a one-day festival taking place across venues in Shoreditch, and we\\u2019re excited to be one of them! </p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Join us for a celebration of grass-root talent where music, comedy, dance, spoken word, and food meet. With 10 local venues and businesses collaborating (all&nbsp;within walking distance), the day feels like a treasure hunt through the beating heart of London.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Shoreditch Arts Club is a proud venue partner of Sofar Sounds, offering members free access across the festival. Please contact the team for your free tickets. Public tickets available via the link below.</p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-f0faa39fe3f2410b2932 {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-f0faa39fe3f2410b2932 .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-f0faa39fe3f2410b2932 {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-f0faa39fe3f2410b2932 {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-f0faa39fe3f2410b2932 {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-f0faa39fe3f2410b2932 {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-f0faa39fe3f2410b2932 .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n        }</style>\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n\\n\\n\\n</div>\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/e388f110-411c-4f4a-a838-d57e9dd77523_1174/website.components.button.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/e388f110-411c-4f4a-a838-d57e9dd77523_1174/website.components.button.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.button\\\" data-sqsp-block=\\\"button\\\" data-website-component-id=\\\"yui_3_17_2_1_1789378660766_6169\\\" id=\\\"block-yui_3_17_2_1_1789378660766_6169\\\"><div class=\\\"sqs-block-content\\\">\\n\\n\\n\\n  \\n    \\n    \\n      \\n      \\n\\n\\n\\n<div\\n  class=\\\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--center \\\"\\n  data-animation-role=\\\"button\\\"\\n  data-button-size=\\\"medium\\\"\\n  data-button-type=\\\"primary\\\"\\n  \\n>\\n  <a\\n    href=\\\"https://www.sofarfringe.uk/\\\"\\n    class=\\\"sqs-block-button-element--medium sqs-button-element--primary sqs-block-button-element\\\"\\n    data-sqsp-button\\n    target=\\\"_blank\\\"\\n  >\\n    Buy Tickets\\n  </a>\\n  \\n\\n\\n\\n</div>\\n\\n    \\n  \\n    \\n    \\n      \\n    \\n  \\n\\n\\n<style>\\n  #block-yui_3_17_2_1_1789378660766_6169 {\\n    --sqs-block-content-flex: 0;\\n  }\\n\\n  \\n  \\n    \\n      \\n      \\n    \\n      \\n      \\n        \\n      \\n    \\n  \\n</style>\\n<style class=\\\"transform-vars\\\">\\n    #block-yu