0w, https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1777027753528-EM0ZTG1L77GI4E1WJWRU/future-social-banner.png?format=2500w 2500w\\\" loading=\\\"lazy\\\" decoding=\\\"async\\\" data-loader=\\\"sqs\\\" data-image-component=\\\"1.0.1\\\">\\n        </div>\\n      </div>\\n    \\n        \\n      \\n\\n      \\n        <figcaption\\n          data-sqsp-image-classic-block-caption-container\\n          \\n          class=\\\"image-caption-wrapper\\\"\\n        >\\n          <div class=\\\"image-caption\\\"></div>\\n        </figcaption>\\n      \\n    \\n      </figure>\\n    \\n\\n    \\n\\n\\n  </div>\\n\\n  \\n\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"c868fcf531a6d807b07e\\\" id=\\\"block-c868fcf531a6d807b07e\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\">Members have access to all events in our programme.</p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-c868fcf531a6d807b07e {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-c868fcf531a6d807b07e .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text