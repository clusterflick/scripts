\"website.components.button\\\" data-sqsp-block=\\\"button\\\" data-website-component-id=\\\"5f5eeff2c003b3878e92\\\" id=\\\"block-5f5eeff2c003b3878e92\\\"><div class=\\\"sqs-block-content\\\">\\n\\n\\n\\n  \\n    \\n    \\n      \\n      \\n\\n\\n\\n<div\\n  class=\\\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--left \\\"\\n  data-animation-role=\\\"button\\\"\\n  data-button-size=\\\"medium\\\"\\n  data-button-type=\\\"primary\\\"\\n  \\n>\\n  <a\\n    href=\\\"/membership\\\"\\n    class=\\\"sqs-block-button-element--medium sqs-button-element--primary sqs-block-button-element\\\"\\n    data-sqsp-button\\n    \\n  >\\n    Apply to Become a Member\\n  </a>\\n  \\n\\n\\n\\n</div>\\n\\n    \\n  \\n    \\n    \\n      \\n    \\n  \\n\\n\\n<style>\\n  #block-5f5eeff2c003b3878e92 {\\n    --sqs-block-content-flex: 0;\\n  }\\n\\n  \\n  \\n    \\n      \\n      \\n    \\n      \\n      \\n        \\n      \\n    \\n  \\n</style>\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-code code-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.code/05600e48-e9fe-4f14-8f3e-47da6d63cef0_1049/website.components.code.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.code/05600e48-e9fe-4f14-8f3e-47da6d63cef0_1049/website.components.code.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.code\\\" data-sqsp-block=\\\"code\\\" data-website-component-id=\\\"e5d77d902b2548092f9b\\\" id=\\\"block-e5d77d902b2548092f9b\\\"><div class=\\\"sqs-block-content\\\">\\n  \\n\\n<div\\n  class=\\\"sqs-code-container\\\"\\n  \\n  \\n    data-localized=\\\"{&quot;enableSafeModeButton&quot;:&quot;Preview in safe mode&quot;,&quot;enableSafeModeText&quot;:&quot;This block contains embedded scripts. Embedded scripts are disabled while you're logged in and editing your site.&quot;,&quot;enableSafeModeTitle&quot;:&quot;Embedded Scripts&quot;,&quot;exitSafeModeButton&quot;:&quot;Exit safe preview&quot;,&quot;exitSafeModeText&quot;:&quot;Please view the page after logging out for accurate rendering.&quot;,&quot;exitSafeModeTitle&quot;:&quot;Safe Preview&quot;,&quot;globalSafeMode&quot;:&quot;Embedded Code: This block contains embedded code that has been disabled.&quot;,&quot;scriptDisabled&quot;:&quot;Script Disabled&quot;}\\\"\\n  \\n  \\n  \\n  \\n>\\n  \\n    <style>\\n.header-title-logo a {\\n  content: url(\\\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/e97578eb-c638-4fe4-87a2-fc226c8624b2/shoreditch-arts-club-logo.png\\\");\\n  }\\n</style>\\n  \\n  \\n\\n\\n\\n</div>\\n\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div></div><div class=\\\"col sqs-col-3 span-3\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\\\" data-aspect-ratio=\\\"2.615933412604043\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"fcdda1efc687bd41ded0\\\" id=\\\"block-fcdda1efc687bd41ded0\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Staged in galleries, museums and cultural spaces including the National Gallery in London and Siri Sala in Bangkok, <a target=\\\"_blank\\\" href=\\\"https://mahjongpalace.net/\\\">Mahjong Palace</a> brings together members and guests to enjoy evening cocktails, light bites and a classic game of the elegant and history-rich Mahjong. </p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/mahjong-palace-sac\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1776156260754-3KO0SZYFPPKJNEA8KDGI/mjpxsac-web.png\",\"contentType\":\"image/png\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1784914200671,\"endDate\":1784925000671},\"startDate\":1784914200671,\"endDate\":1784925000671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"seoData\":{\"seoTitle\":\"Mahjong Palace x Shoreditch Arts Club\",\"seoDescription\":\"Friday 29 May, 7 \\u2013 9pm \\u2022\\u00A0New York's sell-out Mahjong club is landing at Shoreditch Arts Club, a reimagining of the traditional game in a contemporary setting.\",\"seoHidden\":false,\"seoImageId\":\"69ddfec7e8c53572a3eeab2a\"},\"originalSize\":\"6750x4500\",\"recordTypeLabel\":\"event\"},{\"id\":\"6a0d8180d469134971add7e0\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1780647655300,\"updatedOn\":1780647655449,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1780647655300,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"1777027753528-EM0ZTG1L77GI4E1WJWRU\",\"systemDataVariants\":\"1920x1080\",\"systemDataSourceType\":\"PNG\",\"filename\":\"future-social-banner.png\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"e5a47e\",\"topRightAverage\":\"fcf9fc\",\"bottomLeftAverage\":\"202807\",\"bottomRightAverage\":\"dba802\",\"centerAverage\":\"9d6429\",\"suggestedBgColor\":\"846037\"},\"urlId\":\"future-social-shoreditch-arts-club-session-02\",\"title\":\"Future:Social Session 02 \",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a0d8180d469134971add7e0\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"16b95fa26a1621993bee\\\" id=\\\"block-16b95fa26a1621993bee\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Monday 13th July, 7 \\u2014 8pm: Future:Social Session 02</h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Future:Social is a new monthly gathering at Shoreditch Arts Club bringing together a small group of thinkers and practitioners around one question. </p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">After a successful, fully-packed first iteration, Session 02 asks: If social skills are muscles, where do we train them? </p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">The argument of the session is that hospitality venues are the gyms of social fitness, and that we have allowed them to close or be replaced by screens without noticing what we have lost. The anthropologist makes the case from human evolution and group behaviour. The hospitality expert speaks to what it takes to design a room that consistently produces connection. The comedian carries the lived experience of reading a room for a living, and what happens when audiences forget how to be one. Closes with a practical takeaway for the audience on how to train their own social fitness.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Expect a proper conversation, a good drink, and a room full of people you'll want to keep talking to long after. Drinks sponsored by Better Sundays, Botivo, Tequila Ocho and Three Cents.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Members go free. View your members\\u2019 newsletter or contact the team directly to RSVP.</p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-16b95fa26a1621993bee {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-16b95fa26a1621993bee .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-16b95fa26a1621993bee {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-16b95fa26a1621993bee {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-16b95fa26a1621993bee {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-16b95fa26a1621993bee {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-16b95fa26a1621993bee .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n        }</style>\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n\\n\\n\\n</div>\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-image image-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.imageLayout/4b41942d-5437-43a4-a2b3-8363fa33b1b6_248/website.components.imageLayout.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.imageLayout/4b41942d-5437-43a4-a2b3-8363fa33b1b6_248/website.components.imageLayout.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.imageLayout\\\" data-sqsp-block=\\\"image-classic\\\" data-website-component-id=\\\"50e2bb9adecfcfce643d\\\" id=\\\"block-50e2bb9adecfcfce643d\\\"><div class=\\\"sqs-block-content\\\">\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n  \\n  \\n    \\n  <div\\n    class=\\\"\\n      image-block-outer-wrapper\\n      layout-caption-below\\n      design-layout-inline\\n      combination-animation-site-default\\n      individual-animation-site-default\\n      individual-text-animation-site-default\\n    \\\"\\n    data-test=\\\"image-block-inline-outer-wrapper\\\"\\n    data-sqsp-image-classic-block-layout=\\\"in