Average\":\"35662d\",\"topRightAverage\":\"616f2d\",\"bottomLeftAverage\":\"b69d5e\",\"bottomRightAverage\":\"8b7b48\",\"centerAverage\":\"666f24\",\"suggestedBgColor\":\"8d7f4a\"},\"urlId\":\"christies-sac-tour-aug-2026\",\"title\":\"The Meeting Ground: Scenes from the KNMA Collection Guided Tour at Christie\\u2019s\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a60c89acd79b266fdd1199b\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"deda78e207188a66287a\\\" id=\\\"block-deda78e207188a66287a\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\" id=\\\"yui_3_17_2_1_1784815911509_20590\\\">Friday 7th August, 4pm \\u2014 5pm : Guided Tour at Christie\\u2019s:<em>The Meeting Ground: Scenes from the KNMA Collection</em></h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\" id=\\\"yui_3_17_2_1_1784815911509_20589\\\">Please join us for an exclusive members\\u2019 guided tour at Christie\\u2019s for their current <em>exhibition The Meeting Ground: Scenes from the KNMA Collection</em>, a major institutional exhibition as part of Christie\\u2019s summer exhibition series, bringing South Asian artist histories to wider audiences. </p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-deda78e207188a66287a {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-deda78e207188a66287a .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-deda78e207188a66287a {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-deda78e207188a66287a {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-deda78e207188a66287a {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-deda78e207188a66287a {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-deda78e207188a66287a .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n        }</style>\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n\\n\\n\\n</div>\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/e388f110-411c-4f4a-a838-d57e9dd77523_1174/website.components.button.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/e388f110-411c-4f4a-a838-d57e9dd77523_1174/website.components.button.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.button\\\" data-sqsp-block=\\\"button\\\" data-website-component-id=\\\"yui_3_17_2_1_1784815911509_13563\\\" id=\\\"block-yui_3_17_2_1_1784815911509_13563\\\"><div class=\\\"sqs-block-content\\\">\\n\\n\\n\\n  \\n    \\n    \\n      \\n      \\n\\n\\n\\n<div\\n  class=\\\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--center \\\"\\n  data-animation-role=\\\"button\\\"\\n  data-button-size=\\\"medium\\\"\\n  data-button-type=\\\"primary\\\"\\n  \\n>\\n  <a\\n    href=\\\"/s/CHRISTIES-Meeting-Ground-Scenes-from-the-KNMA-Collection.pdf\\\"\\n    class=\\\"sqs-block-button-element--medium sqs-button-element--primary sqs-block-button-element\\\"\\n    data-sqsp-button\\n    target=\\\"_blank\\\"\\n  >\\n    Press Release\\n  </a>\\n  \\n\\n\\n\\n</div>\\n\\n    \\n  \\n    \\n    \\n      \\n    \\n  \\n\\n\\n<style>\\n  #block-yui_3_17_2_1_1784815911509_13563 {\\n    --sqs-block-content-flex: 0;\\n  }\\n\\n  \\n  \\n    \\n      \\n      \\n    \\n      \\n      \\n        \\n      \\n    \\n  \\n</style>\\n<style class=\\\"transform-vars\\\">\\n    #block-yui_3_17_2_1_1784815911509_13563 {\\n      --opacity: 100%;\\n      --translate-x: 0px;\\n      --translate-y: 0px;\\n      --rotation: 0deg;\\n      --scale-x: 100%;\\n      --scale-y: 100%;\\n      --skew-x: 0deg;\\n      --skew-y: 0deg;\\n      --origin-x: 50%;\\n      --origin-y: 50%;\\n      --block-transform: none;\\n\\n      opacity: var(--opacity, 1);\\n      transform: var(--block-transform);\\n      transform-origin: var(--origin-x) var(--origin-y);\\n    }\\n  </style><style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"yui_3_17_2_1_1784815911509_22162\\\" id=\\\"block-yui_3_17_2_1_1784815911509_22162\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">This event will take place at 8 King St, London SW1Y 6QT</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>Presented in collaboration with Christie's, The Meeting Ground is curated by Akansha Rastogi with Preeti Bahadur, Avijna Bhattacharya, Premjish Achari and Srinivas Aditya Mopidevi. The exhibition will bring together works across modern and contemporary practices alongside folk and indigenous artistic expressions from South Asia.&nbsp;</em></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>The Meeting Ground invites viewers into an unfolding of several \\u2018scenes\\u2019. It begins as dialogue and contestations between modernists including M.F. Husain, S.H. Raza, Jeram Patel, K.C.S. Paniker, K.G. Subramanyan and K. Ramanujam and different centres of artistic creation in India from the 1950s to today.&nbsp;</em></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>This historical focus from the early twentieth century expands into a scene offering performative metaphors, where artists such as Neha Choksi, LN Tallur, and Simryn Gill reflect on how individuals and institutions hold forms of listening and mark-making to keep memories agile.&nbsp;</em></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>The third strand of the exhibition foregrounds protagonists like Zainul Abedin, Anwar Jalal Shemza, Zarina Hashmi, F.N. Souza, Bani Abidi and others who inhabit multiple homelands and shared worlds, often refusing to belong to places defined by the severity of modern maps.&nbsp;</em></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>Interwoven with these movements are masters of indigenous traditions, such as Jangarh Singh Shyam, Jivya Soma Mashe, and the collaboration between Gauri Gill and Rajesh Vangad.&nbsp;</em></p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"></p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>Reserved exclusively for members of Shoreditch Arts Club only. Please RSVP by contacting the team via email.</em></p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-yui_3_17_2_1_1784815911509_22162 {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-yui_3_17_2_1_1784815911509_22162 .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-yui_3_17_2_1_1784815911509_22162 {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-yui_3_17_2_1_1784815911509_22162 {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-yui_3_17_2_1_1784815911509_22162 {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-yui_3_17_2_1_1784815911509_22162 {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-yui_3_17_2_1_1784815911509_22162 .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n        }</style>\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n\\n\\n\\n</div>\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-image image-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.imageLayout/4b41942d-5437-43a4-a2b3-8363fa33b1b6_248/website.components.imageLayout.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.imageLayout/4b41942d-5437-43a4-a2b3-8363fa33b1b6_248/website.components.imageLayout.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.imageLayout\\\" data-sqsp-block=\\\"image-classic\\\" data-website-component-id=\\\"955b19cafa21a638f24d\\\" id=\\\"block-955b19cafa21a638f24d\\\"><div class=\\\"sqs-block-content\\\">\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n  \\n  \\n    \\n  <div\\n    class=\\\"\\n      image-block-outer-wrapper\\n      layout-caption-below\\n      design-layout-inline\\n      combination-animation-site-default\\n      individual-animation-site-default\\n      individual-text-animation-site-default\\n    \\\"\\n    data-test=\\\"image-block-inline-outer-wrapper\\\"\\n    data-sqsp-image-classic-block-layout=\\\"inline\\\"\\n    style=\\\"--image-component-focal-point: 50% 50%;--image-component-object-fit: cover;\\\"\\n  >\\n\\n    \\n\\n    \\n\\n    \\n      <figure\\n        class=\\\"sqs-block-image-figure intrinsic\\\"\\n        style=\\\"m