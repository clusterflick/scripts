itSafeModeText&quot;:&quot;Please view the page after logging out for accurate rendering.&quot;,&quot;exitSafeModeTitle&quot;:&quot;Safe Preview&quot;,&quot;globalSafeMode&quot;:&quot;Embedded Code: This block contains embedded code that has been disabled.&quot;,&quot;scriptDisabled&quot;:&quot;Script Disabled&quot;}\\\"\\n  \\n  \\n  \\n  \\n>\\n  \\n    <style>\\n.header-title-logo a {\\n  content: url(\\\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/e97578eb-c638-4fe4-87a2-fc226c8624b2/shoreditch-arts-club-logo.png\\\");\\n  }\\n</style>\\n  \\n  \\n\\n\\n\\n</div>\\n\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div></div><div class=\\\"col sqs-col-3 span-3\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\\\" data-aspect-ratio=\\\"2.615933412604043\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"f93a9209fa470159a946\\\" id=\\\"block-f93a9209fa470159a946\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Led by SXSW Head of Partner Happiness Ella-Jane Coxwell, this session combines breathing exercises, meditations and psychoeducational elements designed to help people access greater presence. </p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/master-your-breath\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1787745543525-ZRLP6ZQ865OV977E2Y3O/download.webp\",\"contentType\":\"image/webp\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1790616600671,\"endDate\":1790620200671},\"startDate\":1790616600671,\"endDate\":1790620200671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1820x1177\",\"recordTypeLabel\":\"event\"},{\"id\":\"6a87015a2a33510ea2618424\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1787578345035,\"updatedOn\":1789994170207,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1787578345035,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"b3e1abba-e890-4098-9e5d-42ceea37623c\",\"systemDataVariants\":\"1600x900\",\"systemDataSourceType\":\"PNG\",\"filename\":\"ae42a8b9-341c-423d-bd30-92cfbd71e4d5.png\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"d9f950\",\"topRightAverage\":\"d9f950\",\"bottomLeftAverage\":\"d9f950\",\"bottomRightAverage\":\"d9f950\",\"centerAverage\":\"d9f950\",\"suggestedBgColor\":\"d8f659\"},\"urlId\":\"major-futures-sac-minor-attractions\",\"title\":\"Major Futures presented by Minor Attractions\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a87015a2a33510ea2618424\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"558a07feba0f8af842ac\\\" id=\\\"block-558a07feba0f8af842ac\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Wednesday 23rd September, 6:30 \\u2014 10pm: Major Futures presented by Minor Attractions</h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">In a partnership with Minor Attractions, Shoreditch Arts Club hosts Major Futures, a charity auction created as part of the London fair\\u2019s official programme. Artworks by Eva Dixon, Bora Akincinturk, Leo Costelloe, Benjamin Jones, Lucia Farrow and more. </p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Major Futures is the new charitable initiative created by Minor Attractions that looks to provide funding for non-profit art spaces, independent curators, and event programmers. Major Futures strives to create long-term opportunities for London\\u2019s emerging creative practitioners, responding to the current lack of public and private funding in the British cultural industries.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Shoreditch Arts Club members have priority and free access. RSVPs available soon.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong><em>Minor Attractions </em></strong><em>is a cultural programming organisation based in London, manifesting through two seasonal anchors: the flagship Art Fair, a multi-room hotel takeover in October during London\\u2019s art week, and Summer Sessions, a programme of city-wide art and cultural activations. Founded in 2023, the art fair invites global commercial galleries and not-for-profit art spaces to bring exciting and daring work, creating a new context for London\\u2019s buzzing art scene. The fair is designed as a space where art and nightlife meet, allowing the swells of international collectors in the city to mingle with the art workers and artists that make the art world tick.</em></p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-558a07feba0f8af842ac {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-558a07feba0f8af842ac .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-558a07feba0f8af842ac {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-558a07feba0f8af842ac {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-558a07feba0f8af842ac {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-558a07feba0f8af842ac {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-558a07feba0f8af842ac .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n        }</style>\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n\\n\\n\\n</div>\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-image image-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.imageLayout/4b41942d-5437-43a4-a2b3-8363fa33b1b6_248/website.components.imageLayout.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.imageLayout/4b41942d-5437-43a4-a2b3-8363fa33b1b6_248/website.components.imageLayout.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.imageLayout\\\" data-sqsp-block=\\\"image-classic\\\" data-website-component-id=\\\"add4b62f270616ed907b\\\" id=\\\"block-add4b62f270616ed907b\\\"><div class=\\\"sqs-block-content\\\">\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n  \\n  \\n    \\n  <div\\n    class=\\\"\\n      image-block-outer-wrapper\\n      layout-caption-below\\n      design-layout-inline\\n      combination-animation-site-default\\n      individual-animation-site-default\\n      individual-text-animation-site-default\\n    \\\"\\n    data-test=\\\"image-block-inline-outer-wrapper\\\"\\n    data-sqsp-image-classic-block-layout=\\\"inline\\\"\\n    style=\\\"--image-component-focal-point: 50% 50%;--image-component-object-fit: cover;\\\"\\n  >\\n\\n    \\n\\n    \\n\\n    \\n      <figure\\n        class=\\\"sqs-block-image-figure intrinsic\\\"\\n        style=\\\"max-width:801px;\\\"\\n      >\\n        \\n      \\n        \\n          \\n      <div\\n        \\n        \\n        class=\\\"image-block-wrapper\\\"\\n        data-animation-role=\\\"image\\\"\\n    