uot;,&quot;scriptDisabled&quot;:&quot;Script Disabled&quot;}\\\"\\n  \\n  \\n  \\n  \\n>\\n  \\n    <style>\\n.header-title-logo a {\\n  content: url(\\\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/e97578eb-c638-4fe4-87a2-fc226c8624b2/shoreditch-arts-club-logo.png\\\");\\n  }\\n</style>\\n  \\n  \\n\\n\\n\\n</div>\\n\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div></div><div class=\\\"col sqs-col-3 span-3\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\\\" data-aspect-ratio=\\\"2.615933412604043\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"f7b41ceb4a45d55fad27\\\" id=\\\"block-f7b41ceb4a45d55fad27\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Evening with Chia Amisola, Yichu Li, Zein Majali, Nacoca Ko, and Bea Xu Presented by HERVISIONS and co-curated by Danielle Paterson in partnership with Shoreditch Arts Club</p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/hervisions-chia-amisola\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1781258503865-GOGHCBMCK3OFNPK2ZU33/Screens+-+1.png\",\"contentType\":\"image/png\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1782756000671,\"endDate\":1782766800671},\"startDate\":1782756000671,\"endDate\":1782766800671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"2188x1276\",\"recordTypeLabel\":\"event\"},{\"id\":\"6a21a18f895bd3693102ddf2\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1780589071068,\"updatedOn\":1780590416773,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1780589071068,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"1780589247555-KP8AX6GTVI37D03F43L7\",\"systemDataVariants\":\"1880x940\",\"systemDataSourceType\":\"PNG\",\"filename\":\"image-banner-goodmeasure.png\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"f2c1a7\",\"topRightAverage\":\"f1b39d\",\"bottomLeftAverage\":\"d46d63\",\"bottomRightAverage\":\"c38b83\",\"centerAverage\":\"fccdb3\",\"suggestedBgColor\":\"eb8968\"},\"urlId\":\"good-measure-launch-party\",\"title\":\"Good Measure Launch Party\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a21a18f895bd3693102ddf2\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"edf560a5fb28dd7662da\\\" id=\\\"block-edf560a5fb28dd7662da\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Friday 26th June, 7 \\u2013&nbsp;11pm:  Good Measure Launch Party</h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Join us in the launch of a new coalition of venues, brands and creators building the connection, experience and social health economy.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">The world has never been more connected, yet many have never felt more alone. <a target=\\\"_blank\\\" href=\\\"https://www.goodmeasure.group\\\">Good Measure</a> is a new coalition bringing together the artists, operators, founders, venues, brands and creators building real connection into our future.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Live DJ sets by Johnny Aux (Paranoid London) DJ Chris Read, Es Jayar </p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Drinks free til 8pm. Special guests, art and music to be unveiled on the night.</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"></p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Members and private RSVP only. </p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#