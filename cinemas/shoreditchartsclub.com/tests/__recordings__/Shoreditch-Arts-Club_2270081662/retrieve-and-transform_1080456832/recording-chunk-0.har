e that has been disabled.&quot;,&quot;scriptDisabled&quot;:&quot;Script Disabled&quot;}\\\"\\n  \\n  \\n  \\n  \\n>\\n  \\n    <style>\\n.header-title-logo a {\\n  content: url(\\\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/e97578eb-c638-4fe4-87a2-fc226c8624b2/shoreditch-arts-club-logo.png\\\");\\n  }\\n</style>\\n  \\n  \\n\\n\\n\\n</div>\\n\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div></div><div class=\\\"col sqs-col-3 span-3\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\\\" data-aspect-ratio=\\\"2.615933412604043\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"42fb5fc0e4eb81cb71fb\\\" id=\\\"block-42fb5fc0e4eb81cb71fb\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Building Women\\u2019s Power&nbsp;is co-hosted by Civic Power Fund and Foundation CHANEL and brings together grassroots organisers, movement leaders, funders and allies for an afternoon of networking and celebration at Shoreditch Arts Club. </p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>Please note access to the space is not available on this day. Members can RSVP to attend the event. </em></p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/future-of-socialising-preview\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/ba26e133-86ea-4478-8a3d-c33f74ad8a58/566776366_18531615577058705_1343827711841219151_n.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1783512000671,\"endDate\":1783526400671},\"startDate\":1783512000671,\"endDate\":1783526400671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1440x1440\",\"recordTypeLabel\":\"event\"},{\"id\":\"6a2186d755963a57d60696f8\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1780582156716,\"updatedOn\":1781187584684,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1780582156716,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"eceed3d5-5b9a-4123-87ad-844369804953\",\"systemDataVariants\":\"3089x2048,2500w\",\"systemDataSourceType\":\"JPG\",\"filename\":\"IMG_1903.JPG\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"7895b7\",\"topRightAverage\":\"210403\",\"bottomLeftAverage\":\"050804\",\"bottomRightAverage\":\"978c72\",\"centerAverage\":\"746a3f\",\"suggestedBgColor\":\"69635b\"},\"urlId\":\"zethu-maseko-and-friends-july-3\",\"title\":\"Zethu Maseko &amp; Friends: Open Table &amp; Exhibition\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a2186d755963a57d60696f8\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"393d5f475154cc1c8526\\\" id=\\\"block-393d5f475154cc1c8526\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Friday 3rd July, 6 \\u2013&nbsp; 9pm: Zethu Maseko &amp; Friends: Open Table &amp; Exhibition</h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Join us for the second instalment of the artist-led gathering, featuring an informal presentation of selected works-in-progress and creative projects. </p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Shoreditch Arts Club collaborating member and artist Zethu Maseko brings a weekend wind-down evening of music and conversation to Shoreditch Arts Club. A small group of invited artists will be bringing recent works and ongoing projects to share within the space. </p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Think conversational and collective atmosphere, rather than a formal exhibition or networking session; with physical works by Maseko temporarily on view at the club, drinks at the bar and inspiring concepts to take into your practice.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Private invites and Shoreditch Arts Club members only. RSVP through the Members Newsletter.</p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-393d5f475154cc1c8526 {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-393d5f475154cc1c8526 .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-393d5f475154cc1c8526 {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-393d5f475154cc1c8526 {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-393d5f475154cc1c8526 {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-393d5f475154cc1c8526 {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-393d5f475154cc1c8526 .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n        }</style>\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n\\n\\n\\n</div>\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-image image-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.imageLayout/4b41942d-5437-43a4-a2b3-8363fa33b1b6_248/website.components.imageLayout.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/