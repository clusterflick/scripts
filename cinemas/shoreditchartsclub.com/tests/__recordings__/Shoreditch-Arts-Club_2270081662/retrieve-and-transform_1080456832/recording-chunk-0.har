w&quot;,&quot;globalSafeMode&quot;:&quot;Embedded Code: This block contains embedded code that has been disabled.&quot;,&quot;scriptDisabled&quot;:&quot;Script Disabled&quot;}\\\"\\n  \\n  \\n  \\n  \\n>\\n  \\n    <style>\\n.header-title-logo a {\\n  content: url(\\\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/e97578eb-c638-4fe4-87a2-fc226c8624b2/shoreditch-arts-club-logo.png\\\");\\n  }\\n</style>\\n  \\n  \\n\\n\\n\\n</div>\\n\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div></div><div class=\\\"col sqs-col-3 span-3\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\\\" data-aspect-ratio=\\\"2.615933412604043\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"565ac9d89e84890e0280\\\" id=\\\"block-565ac9d89e84890e0280\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Join us to discuss \\u2018Why We Dance\\u2019: its importance as a language, an art form and a way to connect. Invited guests include Lucy Dixon&nbsp;of House of Lemon,&nbsp;Yasmine Naghdi&nbsp;of The Royal Ballet, and cognitive neuroscientist&nbsp;Inder Singh-Virdi.</p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/future-social-shoreditch-arts-club-session-03\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1777027753528-EM0ZTG1L77GI4E1WJWRU/future-social-banner.png\",\"contentType\":\"image/png\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1790013600671,\"endDate\":1790017200671},\"startDate\":1790013600671,\"endDate\":1790017200671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1920x1080\",\"recordTypeLabel\":\"event\"},{\"id\":\"6a86fbe9f0b22b234a1a780d\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1787576174022,\"updatedOn\":1787671109478,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1787576174022,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"1787576133830-IP6GWY8BQ725MYU7WVB5\",\"systemDataVariants\":\"1500x1198\",\"systemDataSourceType\":\"JPG\",\"filename\":\"Anais+on+bed copy.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"8d8d8d\",\"topRightAverage\":\"585858\",\"bottomLeftAverage\":\"525252\",\"bottomRightAverage\":\"696969\",\"centerAverage\":\"505050\",\"suggestedBgColor\":\"606060\"},\"urlId\":\"secret-sex-book-club-anais-nin\",\"title\":\"The Secret Sex Book Club: Ana\\u00EFs Nin\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a86fbe9f0b22b234a1a780d\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"0f8fa7b84920f644139b\\\" id=\\\"block-0f8fa7b84920f644139b\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Friday 11th September, 6\\u2014 9pm: The Secret Sex Book Club: Ana\\u00EFs Nin</h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">You are invited into a clandestine literary evening speaking on desire, discomfort, fantasy, memory, power, and the language we use when we finally speak honestly about sex.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Passages are read aloud from first edition or antique books, banned, seized, or privately printed. After each reading, we reveal the hidden history: the scandal, the trial, the ban, the secret circulation, and the cultural shockwave it created.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">The first session will draw from the works of Ana\\u00EFs Nin, French-born American diarist, essayist, novelist, and writer of short stories and erotica. Her multi-volume personal diaries span decades, including pioneering feminist erotica, and her surrealist fiction. Her introspective writing explored female desire, identity, and psychoanalysis long before the modern women's movement.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Host Tom Sandham is an award-winning journalist and writer, luxury drinks columnist for the Telegraph, and regular ITV presenter. He has spent the last few years researching&nbsp; sex, sex culture and how pleasure can be properly addressed. </p><p class=\\\"sqsrte-large\\\" style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>Shoreditch Arts Club members have priority and free access. Public tickets live soon.</em></p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-0f8fa7b84920f644139b {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-0f8fa7b84920f644139b .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-0f8fa7b84920f644139b {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-0f8fa7b84920f644139b {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-0f8fa7b84920f644139b {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-0f8fa7b84920f644139b {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-0f8fa7b84920f644139b .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n        }</style>\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n\\n\\n\\n</div>\\n</div></div><div class=\\\"sqs-block websit