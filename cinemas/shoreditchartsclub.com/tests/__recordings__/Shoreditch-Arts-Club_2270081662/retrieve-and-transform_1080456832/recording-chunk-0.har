tions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"c3e3af1b5055fd98e5cb\\\" id=\\\"block-c3e3af1b5055fd98e5cb\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Sofar Sounds returns to Shoreditch Arts Club to transform the space for an intimate and secret live music performance, creating an immersive experience that brings guests and artists closer together. Each Sofar is small, and typically features three diverse acts, with no headliner.</p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/sofar-sounds-aug-26\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1778682304630-5Z6ZNGSSOHIX95SKUXFC/TheStoneJets_MatthewOneMan_ShoreditchArtsClub_SofarLondon_SofarRemixed_JaneJimenezPhotography_October282023-42.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1787250600671,\"endDate\":1787259600671},\"startDate\":1787250600671,\"endDate\":1787259600671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"2560x1707\",\"recordTypeLabel\":\"event\"},{\"id\":\"6a6b8261cc0020699f88c1dd\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1785430734048,\"updatedOn\":1785430734195,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1785430734048,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"4c0db3a4-c243-41b9-9879-311641157bab\",\"systemDataVariants\":\"722x406\",\"systemDataSourceType\":\"PNG\",\"filename\":\"Screenshot+2026-07-30+at+17.49.50.png\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"57a5ad\",\"topRightAverage\":\"3097a6\",\"bottomLeftAverage\":\"000610\",\"bottomRightAverage\":\"014358\",\"centerAverage\":\"29919e\",\"suggestedBgColor\":\"47929d\"},\"urlId\":\"ces-enfants-sac\",\"title\":\"CES ENFANTS presents Extrovert // Introvert\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a6b8261cc0020699f88c1dd\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"c7caaaa593f13d89c5c5\\\" id=\\\"block-c7caaaa593f13d89c5c5\\\"><div class=\\\"sqs-block-content\\\"><div class=\