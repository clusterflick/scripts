bsite.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"a2f1bdc66607aeace316\\\" id=\\\"block-a2f1bdc66607aeace316\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">A new live conversation series by member Delenn Vaughan. The first edition features BAFTA-winning duo, Director&nbsp;Akinola Davies Jr.&nbsp;in conversation with collaborator&nbsp;CKTRL, offering a rare behind-the-scenes look into the creative process behind the film,&nbsp;<em>Spirit</em>.&nbsp;</p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/the-art-of-us-spirit\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1781541844855-NPSCJPLNBG894835O9QG/grade_ref_still_0006463.png\",\"contentType\":\"image/png\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1782410400671,\"endDate\":1782421200671},\"startDate\":1782410400671,\"endDate\":1782421200671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1650x999\",\"recordTypeLabel\":\"event\"},{\"id\":\"6a1575b95a595249dd26520c\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1779791397836,\"updatedOn\":1779791398045,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1779791397836,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"1743164030997-M8PREVYRMD78HAZS7X1I