s.sqspcdn.com/website-component-definition/static-assets/website.components.button/e388f110-411c-4f4a-a838-d57e9dd77523_1174/website.components.button.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/e388f110-411c-4f4a-a838-d57e9dd77523_1174/website.components.button.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.button\\\" data-sqsp-block=\\\"button\\\" data-website-component-id=\\\"fc0a7d77a8230ede98ba\\\" id=\\\"block-fc0a7d77a8230ede98ba\\\"><div class=\\\"sqs-block-content\\\">\\n\\n\\n\\n  \\n    \\n    \\n      \\n      \\n\\n\\n\\n<div\\n  class=\\\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--left \\\"\\n  data-animation-role=\\\"button\\\"\\n  data-button-size=\\\"medium\\\"\\n  data-button-type=\\\"primary\\\"\\n  \\n>\\n  <a\\n    href=\\\"/membership\\\"\\n    class=\\\"sqs-block-button-element--medium sqs-button-element--primary sqs-block-button-element\\\"\\n    data-sqsp-button\\n    \\n  >\\n    Apply to Become a Member\\n  </a>\\n  \\n\\n\\n\\n</div>\\n\\n    \\n  \\n    \\n    \\n      \\n    \\n  \\n\\n\\n<style>\\n  #block-fc0a7d77a8230ede98ba {\\n    --sqs-block-content-flex: 0;\\n  }\\n\\n  \\n  \\n    \\n      \\n      \\n    \\n      \\n      \\n        \\n      \\n    \\n  \\n</style>\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-code code-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.code/05600e48-e9fe-4f14-8f3e-47da6d63cef0_1049/website.components.code.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.code/05600e48-e9fe-4f14-8f3e-47da6d63cef0_1049/website.components.code.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.code\\\" data-sqsp-block=\\\"code\\\" data-website-component-id=\\\"cad5e8e3d25ee02af322\\\" id=\\\"block-cad5e8e3d25ee02af322\\\"><div class=\\\"sqs-block-content\\\">\\n  \\n\\n<div\\n  class=\\\"sqs-code-container\\\"\\n  \\n  \\n    data-localized=\\\"{&quot;enableSafeModeButton&quot;:&quot;Preview in safe mode&quot;,&quot;enableSafeModeText&quot;:&quot;This block contains embedded scripts. Embedded scripts are disabled while you're logged in and editing your site.&quot;,&quot;enableSafeModeTitle&quot;:&quot;Embedded Scripts&quot;,&quot;exitSafeModeButton&quot;:&quot;Exit safe preview&quot;,&quot;exitSafeModeText&quot;:&quot;Please view the page after logging out for accurate rendering.&quot;,&quot;exitSafeModeTitle&quot;:&quot;Safe Preview&quot;,&quot;globalSafeMode&quot;:&quot;Embedded Code: This block contains embedded code that has been disabled.&quot;,&quot;scriptDisabled&quot;:&quot;Script Disabled&quot;}\\\"\\n  \\n  \\n  \\n  \\n>\\n  \\n    <style>\\n.header-title-logo a {\\n  content: url(\\\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/e97578eb-c638-4fe4-87a2-fc226c8624b2/shoreditch-arts-club-logo.png\\\");\\n  }\\n</style>\\n  \\n  \\n\\n\\n\\n</div>\\n\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div></div><div class=\\\"col sqs-col-3 span-3\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\\\" data-aspect-ratio=\\\"2.615933412604043\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"4a4ee3c13382829a4c90\\\" id=\\\"block-4a4ee3c13382829a4c90\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Future:Social is a new monthly gathering at Shoreditch Arts Club bringing together a small group of thinkers and practitioners around one question. Session 02 asks: If social skills are muscles, where do we train them?</p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/future-social-shoreditch-arts-club-session-02\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1777027753528-EM0ZTG1L77GI4E1WJWRU/future-social-banner.png\",\"contentType\":\"image/png\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1783965600671,\"endDate\":1783969200671},\"startDate\":1783965600671,\"endDate\":1783969200671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1920x1080\",\"recordTypeLabel\":\"event\"},{\"id\":\"69fc89ec362adf7aad490def\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1780481480781,\"updatedOn\":1781286395093,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1780481480781,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"1781281561583-595DR2Y2372HIKRQPF2L\",\"systemDataVariants\":\"1620x1080\",\"systemDataSourceType\":\"PNG\",\"filename\":\"sketchsesh-3-2.png\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"532c1c\",\"topRightAverage\":\"312519\",\"bottomLeftAverage\":\"908f8c\",\"bottomRightAverage\":\"0a0901\",\"centerAverage\":\"645942\",\"suggestedBgColor\":\"655246\"},\"urlId\":\"sketchsesh-sac\",\"title\":\"SKETCHSESH!\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-69fc89ec362adf7aad490def\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"ade5dcadcbacc84e8fcd\\\" id=\\\"block-ade5dcadcbacc84e8fcd\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Friday 10th July, 6 \\u2014 8pm: SKETCHSESH!</h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">SketchSesh is a free-flowing life drawing session that promotes curiosity, individuality, and creative expression in an increasingly digital, screen-oriented world.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Founded by&nbsp;artists <a target=\\\"_blank\\\" href=\\\"https://www.instagram.com/jamesdavisonstudio/?hl=en\\\">James Davison</a>&nbsp;and&nbsp;<a target=\\\"_blank\\\" href=\\\"https://www.instagram.com/putyourhandsonyourhips/\\\">Simon Gray</a>&nbsp;in 2017 in the basement of&nbsp;The Glory, <a target=\\\"_blank\\\" href=\\\"https://www.instagram.com/sketchsesh\\\">SketchSesh</a> was created in response to London\\u2019s creative community and inspired by the fashion drawing classes once held at the iconic old&nbsp;Central Saint Martins&nbsp;building on Charing Cross Road.</p><p class=\\\"sqsrte-large\\\" style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Join us at Shoreditch Arts Club for the special SketchSesh edition in collaboration with designers Mvudslyde and Tj Finley, with flowing drinks, live DJs and immersive archival film projections across our screens. </p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-ade5dcadcbacc84e8fcd {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-ade5dcadcbacc84e8fcd .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-ade5dcadcbacc84e8fcd {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-ade5dcadcbacc84e8fcd {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-ade5dcadcbacc84e8fcd {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-ade5dcadcbacc84e8fcd {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block