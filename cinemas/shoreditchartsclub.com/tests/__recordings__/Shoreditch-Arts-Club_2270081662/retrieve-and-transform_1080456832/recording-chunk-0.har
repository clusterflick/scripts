sqspcdn.com/website-component-definition/static-assets/website.components.code/05600e48-e9fe-4f14-8f3e-47da6d63cef0_1049/website.components.code.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.code/05600e48-e9fe-4f14-8f3e-47da6d63cef0_1049/website.components.code.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.code\\\" data-sqsp-block=\\\"code\\\" data-website-component-id=\\\"3b7de7f3b55da7f9543e\\\" id=\\\"block-3b7de7f3b55da7f9543e\\\"><div class=\\\"sqs-block-content\\\">\\n  \\n\\n<div\\n  class=\\\"sqs-code-container\\\"\\n  \\n  \\n    data-localized=\\\"{&quot;enableSafeModeButton&quot;:&quot;Preview in safe mode&quot;,&quot;enableSafeModeText&quot;:&quot;This block contains embedded scripts. Embedded scripts are disabled while you're logged in and editing your site.&quot;,&quot;enableSafeModeTitle&quot;:&quot;Embedded Scripts&quot;,&quot;exitSafeModeButton&quot;:&quot;Exit safe preview&quot;,&quot;exitSafeModeText&quot;:&quot;Please view the page after logging out for accurate rendering.&quot;,&quot;exitSafeModeTitle&quot;:&quot;Safe Preview&quot;,&quot;globalSafeMode&quot;:&quot;Embedded Code: This block contains embedded code that has been disabled.&quot;,&quot;scriptDisabled&quot;:&quot;Script Disabled&quot;}\\\"\\n  \\n  \\n  \\n  \\n>\\n  \\n    <style>\\n.header-title-logo a {\\n  content: url(\\\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/e97578eb-c638-4fe4-87a2-fc226c8624b2/shoreditch-arts-club-logo.png\\\");\\n  }\\n</style>\\n  \\n  \\n\\n\\n\\n</div>\\n\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div></div><div class=\\\"col sqs-col-3 span-3\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\\\" data-aspect-ratio=\\\"2.615933412604043\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"64b744dfe616aa69022f\\\" id=\\\"block-64b744dfe616aa69022f\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Join us for a celebration of grass-root talent, where music, comedy, dance, spoken word, and food meet. With over 10 local venues and businesses collaborating (<em>all</em>&nbsp;within walking distance), the day feels like a treasure hunt through the beating heart of London.</p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/sofar-fringe-festival-shoreditch-arts-club\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1788519328248-4P96B6TJI9G4C6LSVC37/Web_Ready-Janisa_BlueMoonBrewery_Toronto_PascalineLeBras_17July2023_8.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1792238400671,\"endDate\":1792270800671},\"startDate\":1792238400671,\"endDate\":1792270800671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1200x675\",\"recordTypeLabel\":\"event\"},{\"id\":\"6a995a7565509d1da10c677c\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1788447911361,\"updatedOn\":1790946282951,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1788447911361,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"1788452024868-ZMHSH0E61F8DX5NP8XZ8\",\"systemDataVariants\":\"1500x1000\",\"systemDataSourceType\":\"PNG\",\"filename\":\"2.png\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"ff0000\",\"topRightAverage\":\"ff0000\",\"bottomLeftAverage\":\"ff0000\",\"bottomRightAverage\":\"ff0000\",\"centerAverage\":\"fbfcf8\",\"suggestedBgColor\":\"cd9a93\"},\"urlId\":\"oona-david-til-cameras-do-us-part-sac\",\"title\":\"THE WEDDING: OONA &amp; David \\u2014 Til the Cameras Do Us Part\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a995a7565509d1da10c677c\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"693faf07352afd8ea9ac\\\" id=\\\"block-693faf07352afd8ea9ac\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Friday 16th October, 4:30 \\u2014 7:30pm:  THE WEDDING: OONA &amp; David \\u2014 <em>Til the Cameras Do Us Part</em></h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">HERVISIONS and Shoreditch Arts Club present THE WEDDING: OONA &amp; DAVID \\u2014 Til The Cameras Do Us Part, a live performance by artist OONA, in collaboration withThe Second-Guess and Frieze Connect.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>The Wedding: OONA &amp; David</em> is the eighth and final chapter of <em>Dear David: A Surveillance Love Story</em>, OONA\\u2019s ongoing performance and moving-image project constructed entirely from her own CCTV footage captured on the London Underground. The performance brings the project to its culminating chapter, staging a wedding between OONA and David, the Transport for London CCTV Data Manager with whom she has corresponded over several years. </p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">The presentation will be followed in by a panel discussion led by <strong>Anika Meier</strong>, writer and co-founder of the curatorial collective, The Second-Guess, exploring questions around visibility, representation and the ways women are seen \\u2014 and not seen \\u2014 within contemporary visual culture. Further guests will be announced.</p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-693faf07352afd8ea9ac {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-693faf07352afd8ea9ac .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-693faf07352afd8ea9ac {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-693faf07352afd8ea9ac {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-693faf07352afd8ea9ac {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-693faf07352afd8ea9ac {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-693faf07352afd8ea9ac .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n        }</style>\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n\\n\\n\\n</div>\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/e388f110-411c-4f4a-a838-d57e9dd77523_1174/website.components.button.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/e388f110-411c-4f4a-a838-d57e9dd77523_1174/website.components.button.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.button\\\" data-sqsp-block=\\\"button\\\" data-website-component-id=\\\"yui_3_17_2_1_1790935461831_6407\\\" id=\\\"block-yui_3_17_2_1_1790935461831_6407\\\"><div class=\\\"sqs-block-content\\\">\\n\\n\\n\\n  \\n    \\n    \\n      \\n      \\n\\n\\n\\n<div\\n  class=\\\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--center \\\"\\n  data-animation-role=\\\"button\\\"\\n  data-button-size=\\\"medium\\\"\\n  data-button-type=\\\"primary\\\"\\n  \\n>\\n  <a\\n    href=\\\"\\\"\\n    class=\\\"sqs-block-button-element--medium sqs-button-element--primary sqs-block-button-element\\\"\\n    data-sqsp-button\\n    \\n  >\\n    RSVP Here\\n  </a>\\n  \\n\\n\\n\\n</div>\\n\\n    \\n  \\n    \\n    \\n      \\n    \\n  \\n\\n\\n<style>\\n  #block-yui_3_17_2_1_1790935461831_6407 {\\n    --sqs-block-content-flex: 0;\\n  }\\n\\n  \\n  \\n    \\n      \\n      \\n    \\n      \\n      \\n        \\n      \\n    \\n  \\n</style>\\n<style class=\\\"transform-vars\\\">\\n    #block-yui_3_17_2_1_1790935461831_6407 {\\n      --opacity: 100%;\\n      --translate-x: 0px;\\n      --translate-y: 0px;\\n      --rotation: 0deg;\\n      --scale-x: 100%;\\n      --scale-y: 100%;\\n      --skew-x: 0deg;\\n      --skew-y: 0deg;\\n      --origin-x: 50%;\\n      --origin-y: 50%;\\n      --block-transform: none;\\n\\n      opacity: var(--opacity, 1);\\n      transform: var(--block-transform);\\n      transform-origin: var(--origin-x) var(--origin-y);\\n    }\\n  </style><style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"yui_3_17_2_1_1790935461831_6484\\\" id=\\\"block-yui_3_17_2_1_1790935461831_6484\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>After seven years of emailing, OONA is finally ready to make it official. This October in London, she will marry David, the man who has been watching her since 2019.</em></p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>OONA will walk down the aisle in a surveillance wedding dress under the gaze of live cameras. Collaborators, curators, and collectors will give wedding speeches. A functional surveillance-camera ring will take the place of the wedding ring. And OONA will deliver her final Dear David letter as her vows to an empty aisle. The audience joins as wedding guests and witnesses, but also as CCTV viewers, watching the relationship\\u2019s final act unfold live.</em></p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>So, who is David, and how did we get here?</em></p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>Since 2019, OONA has filed official requests for the CCTV footage the London Underground captures of her. In doing so, she struck up an unlikely and warm correspondence with David, a CCTV Data Manager who has worked for Transport for London for the past 30 years. Dear David is built entirely from OONA\\u2019s own CCTV footage on the London Underground. The Wedding: OONA &amp; David is the eighth and final chapter of Dear David: A Surveillance Love Story.</em></p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>What began as bureaucracy became a love story: eight love letters exploring visibility, consent, and self-sovereignty through the lens of the very cameras built to watch her.</em></p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><em>After all, if someone has been watching you for seven years, isn\\u2019t it time to define the relationship?</em></p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-yui_3_17_2_1_1790935461831_6484 {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-yui_3_17_2_1_1790935461831_6484 .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-yui_3_17_2_1_1790935461831_6484 {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-yui_3_17_2_1_1790935461831_6484 {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-yui_3_17_2_1_1790935461831_6484 {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-yui_3_17_2_1_1790935461831_6484 {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-yui_3_17_2_1_1790935461831_6484 .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n        }</style>\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n\\n\\n\\n</div>\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-image image-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.imageLayout/4b41942d-5437-43a4-a2b3-8363fa33b1b6_248/website.components.imageLayout.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.imageLayout/4b41942d-5