n  \\n  \\n>\\n  \\n    <style>\\n.header-title-logo a {\\n  content: url(\\\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/e97578eb-c638-4fe4-87a2-fc226c8624b2/shoreditch-arts-club-logo.png\\\");\\n  }\\n</style>\\n  \\n  \\n\\n\\n\\n</div>\\n\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div></div><div class=\\\"col sqs-col-3 span-3\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\\\" data-aspect-ratio=\\\"2.615933412604043\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"badc8350d76c6b04101b\\\" id=\\\"block-badc8350d76c6b04101b\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Staged in galleries, museums and cultural spaces including the National Gallery in London and Siri Sala in Bangkok, <a target=\\\"_blank\\\" href=\\\"https://mahjongpalace.net/\\\">Mahjong Palace</a> brings together members and guests to enjoy evening cocktails, light bites and a classic game of the elegant and history-rich Mahjong. </p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/mahjong-palace-sac-02-10\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1776156260754-3KO0SZYFPPKJNEA8KDGI/mjpxsac-web.png\",\"contentType\":\"image/png\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1790962200671,\"endDate\":1790971200671},\"startDate\":1790962200671,\"endDate\":1790971200671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"6750x4500\",\"recordTypeLabel\":\"event\"},{\"id\":\"6a8c512447a75d54e10072f7\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1787745581901,\"updatedOn\":1788514597327,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1787745581901,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"1787745543525-ZRLP6ZQ865OV977E2Y3O\",\"systemDataVariants\":\"1820x1177\",\"systemDataSourceType\":\"WEBP\",\"filename\":\"download.webp\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"693e87\",\"topRightAverage\":\"6e46a5\",\"bottomLeftAverage\":\"3c2c67\",\"bottomRightAverage\":\"3f2d6c\",\"centerAverage\":\"d15792\",\"suggestedBgColor\":\"694088\"},\"urlId\":\"master-your-breath\",\"title\":\"Master Your Breath, Master Your Life\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a8c512447a75d54e10072f7\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"7067c290ecefc3f17324\\\" id=\\\"block-7067c290ecefc3f17324\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Monday 28th September, 6:30 \\u2014 7:30pm: Master Your Breath, Master Your Life</h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Join Ella-Jane Coxwell, Head of Partner Happiness at SXSW, Founder of Still &amp; Stride and Meditation teacher, in a breath work and meditative session in our Cinema.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">The session combines breathing exercises, meditations and psychoeducational elements designed to help people access greater presence. Guests will leave with a practical understanding of the mechanics of meditation that they can implement in their daily lives.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Ella-Jane Coxwell is a London-based meditation and breathwork facilitator. Her work revolves around helping people return to themselves - equipping them with tools to reduce the noise, so they can hear their inner voice&nbsp;once more. Her approach blends practical technique with the science behind why these practices work, helping people regulate, reset, and build the capacity&nbsp;to navigate uncertainty and live a life that truly feels like theirs.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Shoreditch Arts Club members go free. Follow the link below and use your private free code. Full-priced tickets available publicly.</p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-7067c290ecefc3f17324 {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-7067c290ecefc3f17324 .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-7067c290ecefc3f17324 {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-7067c290ecefc3f17324 {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-7067c290ecefc3f17324 {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-7067c290ecefc3f17324 {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-7067c290ecefc3f17324 .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n        }</style>\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n\\n\\n\\n</div>\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/e388f110-411c-4f4a-a838-d57e9dd77523_1174/website.components.button.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/e38