919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/a-z-shoreditch-arts-club-act-i-billy-klotsa\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1791304413427-JWYKGZZBSHWCGIJNPI78/Billy.Icarus_Rising_1+%282%29.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1794335400671,\"endDate\":1794348000671},\"startDate\":1794335400671,\"endDate\":1794348000671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"2100x1572\",\"recordTypeLabel\":\"event\"},{\"id\":\"6ad0b07c31e60307ea1b6326\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1792062994045,\"updatedOn\":1792099497560,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1792062994045,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"1792099489581-M46NOONAG1YCM880ZLW6\",\"systemDataVariants\":\"1200x675\",\"systemDataSourceType\":\"JPG\",\"filename\":\"Web_Ready-Janisa_BlueMoonBrewery_Toronto_PascalineLeBras_17July2023_8.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"0b051f\",\"topRightAverage\":\"020107\",\"bottomLeftAverage\":\"02062e\",\"bottomRightAverage\":\"02115b\",\"centerAverage\":\"20031b\",\"suggestedBgColor\":\"20113b\"},\"urlId\":\"sofar-sounds-singles-night\",\"title\":\"Sofar Sounds Singles Night presented by Tinder\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6ad0b07c31e60307ea1b6326\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"3984df3d7771bcd29c05\\\" id=\\\"block-3984df3d7771bcd29c05\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Wednesday 11th November, 7:30pm \\u2014 10pm: Sofar Sounds Singles Night presented by Tinder</h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">For this year\\u2019s World Singles Day, Sofar Sounds and Tinder bring Singles Night at Shoreditch Arts Club.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Contrary to its name, the event is not a show exclusively for single people. Sofar x Tinder have collaborated to curate a lineup of live performances that will help spark conversations for solo-goers who all share the same love for music. </p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Shoreditch Arts Club members go free. Please contact the team to register your complimentary access. </p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-3984df3d7771bcd29c05 {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-3984df3d7771bcd29c05 .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-3984df3d7771bcd29c05 {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-3984df3d7771bcd29c05 {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-3984df3d7771bcd29c05 {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-3984df3d7771bcd29c05 {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-3984df3d7771bcd29c05 .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n        }</style>\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n\\n\\n\\n</div>\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/e388f110-411c-4f4a-a838-d57e9dd77523_1174/website.components.button.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/e388f110-411c-4f4a-a838-d57e9dd77523_1174/website.components.button.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.button\\\" data-sqsp-block=\\\"button\\\" data-website-component-id=\\\"82ef03ea748b7ae5b22d\\\" id=\\\"block-82ef03ea748b7ae5b22d\\\"><div class=\\\"sqs-block-content\\\">\\n\\n\\n\\n  \\n 