" data-aspect-ratio=\\\"2.615933412604043\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"d5a316c7e9252b4799c8\\\" id=\\\"block-d5a316c7e9252b4799c8\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Join us in the launch of Good Measures: a new coalition of venues, brands and creators building the connection, experience and social health economy.</p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/good-measure-launch-party\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1780589247555-KP8AX6GTVI37D03F43L7/image-banner-goodmeasure.png\",\"contentType\":\"image/png\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1782496800691,\"endDate\":1782511200691},\"startDate\":1782496800691,\"endDate\":1782511200691,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1880x940\",\"recordTypeLabel\":\"event\"},{\"id\":\"6a302a19c74e1b690f8ef3e5\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1781600606633,\"updatedOn\":1781868646936,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1781600606633,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"1781541844855-NPSCJPLNBG894835O9QG\",\"systemDataVariants\":\"1650x999\",\"systemDataSourceType\":\"PNG\",\"filename\":\"grade_ref_still_0006463.png\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"202121\",\"topRightAverage\":\"303131\",\"bottomLeftAverage\":\"1e1e1e\",\"bottomRightAverage\":\"181818\",\"centerAverage\":\"2d2e2d\",\"suggestedBgColor\":\"484a4a\"},\"urlId\":\"the-art-of-us-spirit\",\"title\":\"The Art Of Us: Spirit \",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a302a19c74e1b690f8ef3e5\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"4f8cdd3f0a2668a98d96\\\" id=\\\"block-4f8cdd3f0a2668a98d96\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Thursday 25th June, 7 \\u2014 10pm: The Art Of Us: <em>Spirit</em></h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Rooted in community, process, and the power of partnership,&nbsp;<em>The Art of Us</em>&nbsp;creates an intimate space where dialogue, collaboration, and shared vision take centre stage - spotlighting not just the work itself, but the relationships that shape culture.</p><p class=\\\"sqsrte-large\\\" style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">&nbsp;Run by November Group founder and Shoreditch Arts Club member Delenn Vaughan, the first session at Shoreditch Arts Club sees  BAFTA-winning duo, Director Akinola Davies Jr. in conversation with collaborator CKTRL, offering a rare behind-the-scenes look into the creative process behind the film, Spirit. </p><p class=\\\"sqsrte-large\\\" style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"></p><p class=\\\"sqsrte-large\\\" style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Reserved for Shoreditch Arts Club members and private invites only. </p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-4f8cdd3f0a2668a98d96 {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-4f8cdd3f0a2668a98d96 .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-4f8cdd3f0a2668a98d96 {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-4f8cdd3f0a2668a98d96 {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-4f8cdd3f0a2668a98d96 {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen an