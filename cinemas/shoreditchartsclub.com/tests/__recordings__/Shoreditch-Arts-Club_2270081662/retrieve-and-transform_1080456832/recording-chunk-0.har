es.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/e97578eb-c638-4fe4-87a2-fc226c8624b2/shoreditch-arts-club-logo.png\\\");\\n  }\\n</style>\\n  \\n  \\n\\n\\n\\n</div>\\n\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div></div><div class=\\\"col sqs-col-3 span-3\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\\\" data-aspect-ratio=\\\"2.615933412604043\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"6e6de504e72be482f143\\\" id=\\\"block-6e6de504e72be482f143\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Join us to discuss \\u2018Invisible Connections\\u2019: This session asks what it is about ritual, belief, ceremony and shared human experience that ties us together, and whether those are the moments we touch what Jung called the collective unconscious, the stories and archetypes he saw surfacing again and again across time and place.</p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/future-social-shoreditch-arts-club-future-social-4\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/76ffae50-f244-4683-8a75-6d2ca5c82bdb/3e7a6a763c6d3755300ef6a9325a5db0.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1793644200671,\"endDate\":1793653200671},\"startDate\":1793644200671,\"endDate\":1793653200671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"563x316\",\"recordTypeLabel\":\"event\"},{\"id\":\"6abfe0798ce6b622cb2c2f9c\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1790960285624,\"updatedOn\":1791304103233,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1790960285624,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"1790960177263-5VIZE1WCFRHRUTSEZCIN\",\"systemDataVariants\":\"3240x1600,2500w\",\"systemDataSourceType\":\"PNG\",\"filename\":\"3.png\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"ea3882\",\"topRightAverage\":\"d66b99\",\"bottomLeftAverage\":\"d75d91\",\"bottomRightAverage\":\"eb4087\",\"centerAverage\":\"cee9e1\",\"suggestedBgColor\":\"e9a4c1\"},\"urlId\":\"code-hospitality-9-nov\",\"title\":\"CODE Founders Series | Lessons from a previous life: How first careers shaped hospitality founders\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6abfe0798ce6b622cb2c2f9c\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.ht