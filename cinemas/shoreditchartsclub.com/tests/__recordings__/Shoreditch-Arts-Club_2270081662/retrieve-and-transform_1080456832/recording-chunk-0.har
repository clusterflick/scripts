om/content/v1/6386527a7fa42418322e3fbe/1784815949611-FDVDL0Z3JJCGC32SXUHQ/WhatsApp+Image+2026-07-23+at+12.21.19.jpeg?format=300w 300w, https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1784815949611-FDVDL0Z3JJCGC32SXUHQ/WhatsApp+Image+2026-07-23+at+12.21.19.jpeg?format=500w 500w, https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1784815949611-FDVDL0Z3JJCGC32SXUHQ/WhatsApp+Image+2026-07-23+at+12.21.19.jpeg?format=750w 750w, https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1784815949611-FDVDL0Z3JJCGC32SXUHQ/WhatsApp+Image+2026-07-23+at+12.21.19.jpeg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1784815949611-FDVDL0Z3JJCGC32SXUHQ/WhatsApp+Image+2026-07-23+at+12.21.19.jpeg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1784815949611-FDVDL0Z3JJCGC32SXUHQ/WhatsApp+Image+2026-07-23+at+12.21.19.jpeg?format=2500w 2500w\\\" loading=\\\"lazy\\\" decoding=\\\"async\\\" data-loader=\\\"sqs\\\" data-image-component=\\\"1.0.1\\\">\\n        </div>\\n      </div>\\n    \\n        \\n      \\n\\n      \\n        <figcaption\\n          data-sqsp-image-classic-block-caption-container\\n          \\n          class=\\\"image-caption-wrapper\\\"\\n        >\\n          <div class=\\\"image-caption\\\"><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">LN Tallur, Interference, 2019, 4K video&nbsp;</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Interference was made in partnership with the Junagadh Museum in Gujarat, India.&nbsp;</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Special thanks to the Junagadh Museum; Varia Kiran, Videography; Vandita Jain, sound engineer; and Bhanu Pratap Singh.&nbsp;</p></div>\\n        </figcaption>\\n      \\n    \\n      </figure>\\n    \\n\\n    \\n\\n\\n  </div>\\n\\n  \\n\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html h