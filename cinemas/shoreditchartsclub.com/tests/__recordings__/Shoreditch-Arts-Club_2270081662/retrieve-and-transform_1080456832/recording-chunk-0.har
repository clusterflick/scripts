\" data-sqsp-block=\\\"code\\\" data-website-component-id=\\\"0dfbcde0c5b5293ee8f7\\\" id=\\\"block-0dfbcde0c5b5293ee8f7\\\"><div class=\\\"sqs-block-content\\\">\\n  \\n\\n<div\\n  class=\\\"sqs-code-container\\\"\\n  \\n  \\n    data-localized=\\\"{&quot;enableSafeModeButton&quot;:&quot;Preview in safe mode&quot;,&quot;enableSafeModeText&quot;:&quot;This block contains embedded scripts. Embedded scripts are disabled while you're logged in and editing your site.&quot;,&quot;enableSafeModeTitle&quot;:&quot;Embedded Scripts&quot;,&quot;exitSafeModeButton&quot;:&quot;Exit safe preview&quot;,&quot;exitSafeModeText&quot;:&quot;Please view the page after logging out for accurate rendering.&quot;,&quot;exitSafeModeTitle&quot;:&quot;Safe Preview&quot;,&quot;globalSafeMode&quot;:&quot;Embedded Code: This block contains embedded code that has been disabled.&quot;,&quot;scriptDisabled&quot;:&quot;Script Disabled&quot;}\\\"\\n  \\n  \\n  \\n  \\n>\\n  \\n    <style>\\n.header-title-logo a {\\n  content: url(\\\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/e97578eb-c638-4fe4-87a2-fc226c8624b2/shoreditch-arts-club-logo.png\\\");\\n  }\\n</style>\\n  \\n  \\n\\n\\n\\n</div>\\n\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div></div><div class=\\\"col sqs-col-3 span-3\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\\\" data-aspect-ratio=\\\"2.615933412604043\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"85163c49155098056e85\\\" id=\\\"block-85163c49155098056e85\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">DEADSTOCK is a Halloween party with a fashion twist. For one night, familiar pieces of office culture are pushed into something more surreal: workplace objects become props, everyday routines become performance, and the ordinary is reimagined as fashion, art and theatre.</p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/deadstock-halloween\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/ad0bc591-f9a6-44fc-9e43-ec5b707f2ed0/DEADSTOCK_V2-08.png\",\"contentType\":\"image/png\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1793383200671,\"endDate\":1793401200671},\"startDate\":1793383200671,\"endDate\":1793401200671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"2500x1406\",\"recordTypeLabel\":\"event\"},{\"id\":\"6abfe42dba29227d43eb54b3\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1791191785321,\"updatedOn\":1792687025568,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1791191785321,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"76ffae50-f244-4683-8a75-6d2ca5c82bdb\",\"systemDataVariants\":\"563x316\",\"systemDataSourceType\":\"JPG\",\"filename\":\"3e7a6a763c6d3755300ef6a9325a5db0.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"000000\",\"topRightAverage\":\"000000\",\"bottomLeftAverage\":\"000000\",\"bottomRightAverage\":\"000000\",\"centerAverage\":\"792005\",\"suggestedBgColor\":\"321503\"},\"urlId\":\"future-social-shoreditch-arts-club-future-social-4\",\"title\":\"Future:Social Session 04 \\u2013&nbsp;Invisible Bonds\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6abfe42dba29227d43eb54b3\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"09d9e39b45b1e1fcef65\\\" id=\\\"block-09d9e39b45b1e1fcef65\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Monday 2nd November, 6:30 \\u2014 9pm: Future:Social Session 04 \\u2013&nbsp;Invisible Bonds</h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Future:Social is a monthly gathering at Shoreditch Arts Club bringing together a small group of thinkers and practitioners around one question. </p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">There are more invisible ties between us than most of us realise. W e feel them when a stranger seems instantly familiar, when a whole venue goes quiet at the same moment, or when someone says exactly what we were thinking. We tend to wave these moments away as a bit woo, and yet people have built rituals, beliefs and ceremonies around them across every century and culture we know of.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">This session asks what it is about ritual, belief, ceremony and shared human experience that ties us together, and whether those are the moments we touch what Jung called the collective unconscious, the stories and archetypes he saw surfacing again and again across time and place.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Speakers: </p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>Victoria Smith-Murphy</strong> <em>Founder, Tarot &amp; Transformation; </em><strong>Isabel Soden </strong>Founder, Reuben Feels; <strong>Clive Hyland </strong>Author, <em>The Quantum Way; </em><strong>Claire Warner </strong>Co-founder, <em>Good Measure</em></p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-09d9e39b45b1e1fcef65 {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-09d9e39b45b1e1fcef65 .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-09d9e39b45b1e1fcef65 {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-09d9e39b45b1e1fcef65 {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-09d9e39b45b1e1fcef65 {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-09d9e39b45b1e1fcef65 {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-09d9e39b45b1e1fcef65 .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n        }</style>\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n\\n\\n\\n</div>\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/e388f110-411c-4f4a-a838-d57e9dd77523_1174/website.components.button.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/e388f110-411c-4f4a-a838-d57e9dd77523_1174/website.components.button.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.button\\\" data-sqsp-block=\\\"button\\\" data-website-component-id=\\\"9cdfbcf47b3ec508d073\\\" id=\\\"block-9cdfbcf47b3ec508d073\\\"><div class=\\\"sqs-block-content\\\">\\n\\n\\n\\n  \\n    \\n    \\n      \\n      \\n\\n\\n\\n<div\\n  class=\\\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--center \\\"\\n  data-animation-role=\\\"button\\\"\\n  data-button-size=\\\"medium\\\"\\n  data-button-type=\\\"primary\\\"\\n  \\n>\\n  <a\\n    href=\\\"https://www.eventbrite.co.uk/e/future-social-04-invisible-connections-tickets-2002955281164?utm-campaign=social&utm-content=attendeeshare&utm-medium=discovery&utm-term=listing&utm-source=wsa&aff=ebdsshwebmobile\\\"\\n    clas