\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"e4e4eff748dead5f07bf\\\" id=\\\"block-e4e4eff748dead5f07bf\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Staged in galleries, museums and cultural spaces including the National Gallery in London and Siri Sala in Bangkok, <a target=\\\"_blank\\\" href=\\\"https://mahjongpalace.net/\\\">Mahjong Palace</a> brings together members and guests to enjoy evening cocktails, light bites and a classic game of the elegant and history-rich Mahjong. </p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/mahjong-palace-sac-29-07\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1776156260754-3KO0SZYFPPKJNEA8KDGI/mjpxsac-web.png\",\"contentType\":\"image/png\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1787333400671,\"endDate\":1787342400671},\"startDate\":1787333400671,\"endDate\":1787342400671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"6750x4500\",\"recordTypeLabel\":\"event\"},{\"id\":\"6a85993f6edbad30ce69ac57\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1787140642208,\"updatedOn\":1787140667917,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1787140642208,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"1778682304630-5Z6ZNGSSOHIX95SKUXFC\",\"systemDataVariants\":\"2560x1707,2500w\",\"systemDataSourceType\":\"JPG\",\"filename\":\"TheStoneJets_MatthewOneMan_ShoreditchArtsClub_SofarLondon_SofarRemixed_JaneJimenezPhotography_October282023-42.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"261117\",\"topRightAverage\":\"af84b3\",\"bottomLeftAverage\":\"41051b\",\"bottomRightAverage\":\"520a18\",\"centerAverage\":\"301029\",\"suggestedBgColor\":\"78345e\"},\"urlId\":\"sofar-sounds-aug-26\",\"title\":\"Sofar Sounds \",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a85993f6edbad30ce69ac57\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"b8c88338d46f976a9465\\\" id=\\\"block-b8c88338d46f976a9465\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Thursday 20th August, 7:30pm \\u2014 10pm: Sofar Sounds</h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Shoreditch Arts Club welcomes Sofar Sounds to transform the space for an intimate and secret live music performance, creating an immersive experience that brings guests and artists closer together. Each Sofar is small, and typically features three diverse acts, with no headliner.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Doors at 7:30pm. First performer at 8pm.</p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-b8c88338d46f976a9465 {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-b8c88338d46f976a9465 .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-b8c88338d46f976a9465 {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-b8c88338d46f976a9465 {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-b8c88338d46f976a9465 {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-b8c88338d46f976a9465 {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-b8c88338d46f976a9465 .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n        }</style>\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n\\n\\n\\n</div>\\n</div></div><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\\\" dat