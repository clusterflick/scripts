e-component-definition/static-assets/website.components.code/05600e48-e9fe-4f14-8f3e-47da6d63cef0_1049/website.components.code.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.code\\\" data-sqsp-block=\\\"code\\\" data-website-component-id=\\\"bc6f002361fad2b6b663\\\" id=\\\"block-bc6f002361fad2b6b663\\\"><div class=\\\"sqs-block-content\\\">\\n  \\n\\n<div\\n  class=\\\"sqs-code-container\\\"\\n  \\n  \\n    data-localized=\\\"{&quot;enableSafeModeButton&quot;:&quot;Preview in safe mode&quot;,&quot;enableSafeModeText&quot;:&quot;This block contains embedded scripts. Embedded scripts are disabled while you're logged in and editing your site.&quot;,&quot;enableSafeModeTitle&quot;:&quot;Embedded Scripts&quot;,&quot;exitSafeModeButton&quot;:&quot;Exit safe preview&quot;,&quot;exitSafeModeText&quot;:&quot;Please view the page after logging out for accurate rendering.&quot;,&quot;exitSafeModeTitle&quot;:&quot;Safe Preview&quot;,&quot;globalSafeMode&quot;:&quot;Embedded Code: This block contains embedded code that has been disabled.&quot;,&quot;scriptDisabled&quot;:&quot;Script Disabled&quot;}\\\"\\n  \\n  \\n  \\n  \\n>\\n  \\n    <style>\\n.header-title-logo a {\\n  content: url(\\\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/e97578eb-c638-4fe4-87a2-fc226c8624b2/shoreditch-arts-club-logo.png\\\");\\n  }\\n</style>\\n  \\n  \\n\\n\\n\\n</div>\\n\\n<style class=\\\"transform-overrides-vars\\\">\\n  \\n</style>\\n\\n</div></div></div><div class=\\\"col sqs-col-3 span-3\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\\\" data-aspect-ratio=\\\"2.615933412604043\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"b6bc12b256c186e0f3e8\\\" id=\\\"block-b6bc12b256c186e0f3e8\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Join photographer and visual artist Bahareh Safa for <em>Hidden Threads</em>, an exhibition and artist talk at Shoreditch Arts Club, celebrating her artistic practice through photography, poetry, Persian cultural heritage, and print on silk.</p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/hidden-threads-bahareh\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1783590246898-KX7QO2PG0035YI66BUSR/screenshot-2026-05-15-at-17.15.03.jpeg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1788537600671,\"endDate\":1788552000671},\"startDate\":1788537600671,\"endDate\":1788552000671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1000x1000\",\"recordTypeLabel\":\"event\"},{\"id\":\"6a575c2b52cba24b6647a993\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1784110686547,\"updatedOn\":1786376213006,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1784110686547,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"1784110659595-QEXUD16SD8JEY4HSPPJW\",\"systemDataVariants\":\"1320x1760\",\"systemDataSourceType\":\"JPG\",\"filename\":\"639854745_18093464012513987_7064851143058791267_n.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"fd67c1\",\"topRightAverage\":\"fd67c1\",\"bottomLeftAverage\":\"fd67c1\",\"bottomRightAverage\":\"fd67c1\",\"centerAverage\":\"cc75ab\",\"suggestedBgColor\":\"ee69b9\"},\"urlId\":\"the-watch-party-club-rhwa\",\"title\":\" The Watch Party Club\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a575c2b52cba24b6647a993\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"0d3276ef7f3596f4a621\\\" id=\\\"block-0d3276ef7f3596f4a621\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Friday 28th August, 6pm \\u2014 10pm: The Watch Party Club</h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">This one\\u2019s for the reality TV heads! </p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Expect a fun, lively evening of discussion, respectful debates, interactive moments, and the space to finally get your takes off your chest in a room full of people who get it. This time centred around the much anticipated The Real Housewives of Atlanta Reunion, The Watch Party Club is hosted by member &amp; founder Kayah Bello, who curates community-led gatherings where TV and pop culture become the starting point for real conversation, layered opinions, and genuine connection. </p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Shoreditch Arts Club members go free. Check your newsletter or contact the team to RSVP.</p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-0d3276ef7f3596f4a621 {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-0d3276ef7f3596f4a621 .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-0d3276ef7f3596f4a621 {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-0d3276ef7f3596f4a621 {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-0d3276ef7f3596f4a621 {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-0d3276ef7f3596f4a621 {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-0d3276ef7f3596f4a621 .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n       