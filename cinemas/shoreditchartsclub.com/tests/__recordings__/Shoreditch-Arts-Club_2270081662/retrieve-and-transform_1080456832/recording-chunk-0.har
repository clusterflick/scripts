ponent-definition/static-assets/website.components.spacer/bf6c3cf3-1398-4596-a655-57583cbfb9fb_1327/website.components.spacer.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.spacer\\\" data-website-component-id=\\\"4fa44adffeb16f478c17\\\" id=\\\"block-4fa44adffeb16f478c17\\\"><div class=\\\"sqs-block-content\\\">&nbsp;</div></div></div></div></div></div></div>\",\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">The Watch Party Club is hosted by member &amp; founder Kayah Bello, who curates community-led gatherings where TV and pop culture become the starting point for real conversation, layered opinions, and genuine connection. </p>\",\"location\":{\"mapZoom\":12.0,\"mapLat\":51.52420919999999,\"mapLng\":-0.0764826,\"markerLat\":51.52420919999999,\"markerLng\":-0.0764826,\"addressTitle\":\"Shoreditch Arts Club\",\"addressLine1\":\"6 Redchurch Street\",\"addressLine2\":\"London, England\",\"addressCountry\":\"United Kingdom\"},\"customContent\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/events/the-watch-party-club-rhwa\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/6386527a7fa42418322e3fbe/1784110659595-QEXUD16SD8JEY4HSPPJW/639854745_18093464012513987_7064851143058791267_n.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"CalendarEvent\",\"startDate\":1787936400671,\"endDate\":1787950800671},\"startDate\":1787936400671,\"endDate\":1787950800671,\"items\":[],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1320x1760\",\"recordTypeLabel\":\"event\"},{\"id\":\"6a60c59e877e9d64f5f7a8b2\",\"collectionId\":\"6421a0590e521464f0af3302\",\"recordType\":12,\"addedOn\":1784727485908,\"updatedOn\":1787140401287,\"starred\":false,\"passthrough\":false,\"tags\":[],\"categories\":[],\"workflowState\":1,\"publishOn\":1784727485908,\"authorId\":\"654115149373bf6d84a1ccf2\",\"systemDataId\":\"1784727202456-7IYTU98S6W4WA7Q9HHNH\",\"systemDataVariants\":\"900x507\",\"systemDataSourceType\":\"JPG\",\"filename\":\"Event-66607-1.77777-2026-07-15-14_13_12.899-3UZw7LSEKr-image.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"bb977c\",\"topRightAverage\":\"371b10\",\"bottomLeftAverage\":\"291a18\",\"bottomRightAverage\":\"271313\",\"centerAverage\":\"40221e\",\"suggestedBgColor\":\"75564c\"},\"urlId\":\"sofar-untold\",\"title\":\"Untold Studios x Sofar\",\"body\":\"<div class=\\\"sqs-layout sqs-grid-12 columns-12\\\" data-layout-label=\\\"Post Body\\\" data-type=\\\"item\\\" id=\\\"item-6a60c59e877e9d64f5f7a8b2\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-12 span-12\\\"><div class=\\\"row sqs-row\\\"><div class=\\\"col sqs-col-9 span-9\\\"><div class=\\\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\\\" data-block-css=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.styles.css&quot;]\\\" data-block-scripts=\\\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/d2a1a69c-95e9-4739-b5f8-14c197d4b62d_1004/website.components.html.visitor.js&quot;]\\\" data-block-type=\\\"1337\\\" data-definition-name=\\\"website.components.html\\\" data-sqsp-block=\\\"text\\\" data-website-component-id=\\\"0e6030492d407415d95b\\\" id=\\\"block-0e6030492d407415d95b\\\"><div class=\\\"sqs-block-content\\\"><div class=\\\"sqs-text-block-container\\\">\\n  \\n  <div class=\\\"sqs-html-content\\\" data-sqsp-text-block-content><h3 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Wednesday 26th August, 7:30pm \\u2014 10pm: Untold Studios x Sofar</h3><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">This exclusive Untold Studios x Sofar event will pull back the curtain on the creative process behind some of today's artists and reveal the future of visual storytelling in music. Two artists will perform and be joined by the legendary Charlie Sarsfield to discuss his career in music visuals.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Sofar Sounds is a global community that connects artists and audiences through unique and intimate experiences. Sofar Sounds bring people together to create space where music and arts matter in 400 cities around the world.</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Shoreditch Arts Club members go free \\u2013 please view your newsletter to redeem your code.</p></div>\\n\\n\\n  \\n<style id=\\\"container-styles\\\">#block-0e6030492d407415d95b {\\n    \\n    --stroke-style: none;--stroke-thickness: 6px;\\n    \\n      \\n      \\n      \\n    \\n\\n\\n\\n  }\\n\\n  #block-0e6030492d407415d95b .sqs-html-content {\\n    \\n    --tweak-text-block-padding: 6% 6% 6% 6%;\\n  --tweak-text-block-padding: initial;\\n}\\n\\n  #block-0e6030492d407415d95b {\\n      mix-blend-mode: var(--tweak-text-block-blend\\n  );\\n      border-radius: var(--tweak-text-block-radius);\\n  }\\n\\n  \\n  \\n#block-0e6030492d407415d95b {\\n      --tweak-text-block-radius: 0px 0px 0px 0px;\\n    }\\n\\n\\n  \\n  \\n\\n  #block-0e6030492d407415d95b {\\n    }\\n\\n</style>\\n\\n<style id=\\\"override-container-styles\\\">\\n    @media screen and (max-width: 767px) {\\n          \\n            \\n\\n#block-0e6030492d407415d95b {\\n            \\n            }\\n        }\\n    \\n  \\n    @media screen and (max-width: 767px) {\\n          #block-0e6030492d407415d95b .sqs-html-content {\\n            \\n            }\\n        }\\n    \\n  @media screen and (max-width: 767px) {\\n          \\n          \\n\\n          \\n          \\n          \\n       