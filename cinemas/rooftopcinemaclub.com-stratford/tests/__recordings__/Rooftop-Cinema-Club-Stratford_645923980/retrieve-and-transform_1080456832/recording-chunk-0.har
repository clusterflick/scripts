/2000/svg\" class=\"h-5 w-5 md:h-6 md:w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 6h16M4 12h16M4 18h16\" />\n                </svg>\n            </button>\n        </nav>\n    </div>\n</header>\n\n\n        <main id=\"content\" class=\"flex-1 flex flex-col\">\n            <div x-data=\"{\n    show_trailer: false,\n    get trailer_embed_url() {\n        let url = 'https://www.youtube.com/watch?v=2ZMGk_Ml1fc';\n        url = url.replace('watch?v=', 'embed/').replace('youtu.be/', 'www.youtube.com/embed/');\n        return url + (url.includes('?') ? '&' : '?') + 'autoplay=1';\n    }\n}\">\n<section class=\"relative w-full h-screen overflow-hidden\">\n    \n    \n    \n    <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1600,h_900,c_fill,g_xy_center,x_512,y_288,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/8260d443-b781-42d7-ab37-473452d2001a/AAAABYhTcCyJ7aSg5DzkfNVmmseDNp1AkQF_BXN9IHmNzYViBN8WqzUV_IQ3zN5nAy1tyBCd5ZcfJnJEiZMRR6l6XP0crNw0FkH3Ei4a.jpeg\" alt=\"Stratford, London outdoor screening of AAAABYhTcCyJ7aSg5DzkfNVmmseDNp1AkQF_BXN9IHmNzYViBN8WqzUV_IQ3zN5nAy1tyBCd5ZcfJnJEiZMRR6l6XP0crNw0FkH3Ei4a.jpeg in London\" fetchpriority=\"high\" class=\"absolute inset-0 w-full h-full object-cover\">\n    \n    \n    \n\n    <div class=\"absolute inset-0 bg-black/30\"></div>\n\n    <div class=\"absolute left-0 right-0 z-10 px-6 lg:px-12 bottom-[20%] md:bottom-[28%]\">\n        <div class=\"text-brand-white\">\n            <p class=\"text-xs md:text-lg mb-2 md:mb-3 flex items-center gap-2\">\n                Sat, Aug 15\n                <span class=\"text-brand-lavenderpink text-sm md:text-lg\">\n                    <svg width=\"19\" height=\"19\" viewBox=\"0 0 19 19\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M18.5929 12.0172L15.8036 9.5L18.5929 6.98282C19.4486 6.21064 18.8