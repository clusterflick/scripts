            "mimeType": "text/html; charset=utf-8",
            "text": "<!doctype html>\n<html class=\"scroll-smooth antialiased\" lang=\"en\">\n    <head>\n        <meta charset=\"utf-8\">\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n        <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"theme-color\" content=\"#E95D40\">\n        \n        \n        <title>Sex and the City at Stratford, London &mdash; September 15, 2026 | Rooftop Cinema Club</title>\n<meta name=\"description\" content=\"Watch Sex and the City at Stratford, London on September 15, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:title\" content=\"Sex and the City at Stratford, London &mdash; September 15, 2026\" />\n<meta property=\"og:description\" content=\"Watch Sex and the City at Stratford, London on September 15, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:url\" content=\"https://rooftopcinemaclub.com/uk/london/stratford/screenings/sex-and-the-city-3080\" />\n<meta property=\"og:site_name\" content=\"Rooftop Cinema Club\" />\n<meta property=\"og:locale\" content=\"en_GB\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"Sex and the City at Stratford, London &mdash; September 15, 2026\" />\n<meta name=\"twitter:description\" content=\"Watch Sex and the City at Stratford, London on September 15, 2026. Outdoor rooftop cinema in London.\" />\n<link href=\"https://rooftopcinemaclub.com/uk\" rel=\"home\" />\n<link href=\"https://rooftopcinemaclub.com/uk/london/stratford/screenings/sex-and-the-city-3080\" rel=\"canonical\" />\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Global Home\",\"item\":\"https://rooftopcinemaclub.com/uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"London\",\"item\":\"https://rooftopcinemaclub.com/uk/london\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Stratford, London\",\"item\":\"https://rooftopcinemaclub.com/uk/london/stratford\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Sex and the City\",\"item\":\"https://rooftopcinemaclub.com/uk/london/stratford/screenings/sex-and-the-city-3080\"}]}</script>\n<script type=\"application/ld+json\">{    \"@context\": \"https://schema.org\",    \"@type\": \"ScreeningEvent\",    \"@id\": \"https://rooftopcinemaclub.com/uk/london/stratford/screenings/sex-and-the-city-3080#event\",    \"name\": \"Sex and the City\",    \"url\": \"https://rooftopcinemaclub.com/uk/london/stratford/screenings/sex-and-the-city-3080\",    \"startDate\": \"2026-09-15T19:00:00+00:00\",            \"endDate\": \"2026-09-15T21:30:00+00:00\",            \"eventStatus\": \"https://schema.org/EventScheduled\",    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",    \"inLanguage\": \"en-GB\",    \"isAccessibleForFree\": false,    \"offers\": {        \"@type\": \"Offer\",        \"url\": \"https://rooftopcinemaclub.com/uk/london/stratford/screenings/sex-and-the-city-3080\",        \"availability\": \"https://schema.org/InStock\"    },        \"description\": \"Fashion Week deserves a front row seat. &nbsp; Celebrate London Fashion Week with a mini Sex and the City marathon, showcasing three of Carrie Bradshaw's most iconic fashion-filled episodes. &nbsp; From Carrie's unforgettable catwalk tumble in The Real Me, to the glamour of A Vogue Idea, before finishing in couture-filled Paris with An American Girl in Paris: Part Une, this is a love letter to the style moments that helped define a generation. &nbsp; Slip on your favourite heels (or your comfiest trainers), grab a cocktail and settle in for an evening of Manolos, martinis and Manhattan's most fashionable foursome &ndash; all under the London skyline.\",            \"typicalAgeRange\": \"18+\",    \"audience\": {        \"@type\": \"Audience\",        \"audienceType\": \"18+\"    },                    \"image\": {        \"@type\": \"ImageObject\",        \"url\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/5f679e6d-ab78-416e-9d57-3037c04fc577/Sex-and-the-City-Hero.jpg\",        \"width\": 1920,        \"height\": 1080    },            \"workFeatured\": {        \"@type\": \"Movie\",        \"name\": \"Sex and the City\",                \"image\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/5f679e6d-ab78-416e-9d57-3037c04fc577/Sex-and-the-City-Hero.jpg\",        \"duration\": \"PT150M\"    },            \"location\": {        \"@type\": \"MovieTheater\",        \"@id\": \"https://rooftopcinemaclub.com/uk/london/stratford#venue\",        \"name\": \"Stratford, London\",        \"address\": {            \"@type\": \"PostalAddress\",            \"streetAddress\": \"Level 7, Roof East\",            \"postalCode\": \"E15 1XE\",            \"addressLocality\": \"London\",            \"addressCountry\": \"GB\"        },        \"geo\": {            \"@type\": \"GeoCoordinates\",            \"latitude\": 51.5416372,            \"longitude\": -0.0012586999999999        }    },        \"organizer\": {        \"@type\": \"Organization\",        \"@id\": \"https://rooftopcinemaclub.com/#organization\",        \"name\": \"Rooftop Cinema Club\",        \"url\": \"https://roo