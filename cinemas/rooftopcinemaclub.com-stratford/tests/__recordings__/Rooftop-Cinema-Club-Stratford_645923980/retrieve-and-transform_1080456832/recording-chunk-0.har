text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Screen</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Screen 1</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Duration</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">108 Minutes</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        \n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Door Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">30 mins</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n        \n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Date</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Wed, Aug 19</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">9:00 PM</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Year</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">2004</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n    </div>\n\n    <div class=\"rounded-2xl p-10 text-brand-navy/80\">\n        \n    </div>\n\n    <div class=\"mt-8\">\n\n        <div class=\"md:hidden relative\">\n            <div class=\"relative\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_400,h_300,c_fill,g_xy_center,x_600,y_450,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/39be1d28-a603-4ab9-b41b-8c1a75c78e35/EternalSunshineoftheSpotlessMindFilmStill_1200x900_01.jpg\" alt=\"Stratford, London outdoor screening of EternalSunshineoftheSpotlessMindFilmStill_1200x900_01.jpg in London\" class=\"w-[45%] aspect-[4/3] object-cover rounded-xl relative z-10 -ml-4 shadow-lg\">\n                \n                \n                \n            </div>\n\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-5 pt-10 -mt-6 relative z-0\">\n                <div class=\"prose prose-invert prose-sm leading-relaxed max-w-none\">\n                    When their relationship turns sour, a couple undergoes a procedure to have each other erased from their memories. But it is only through the process of loss that they discover what they had to begin with.\n                </div>\n            </div>\n            \n        </div>\n\n        <div class=\"hidden md:flex relative flex-row items-center gap-0 min-h-[350px]\">\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-10 w-1/2 z-10 relative -mr-12 shadow-2xl\">\n                <div class=\"prose prose-invert prose-lg leading-relaxed max-w-none\">\n                    When their relationship turns sour, a couple undergoes a procedure to have each other erased from their memories. But it is only through the process of loss that they discover what they had to begin with.\n                </div>\n            </div>\n            \n\n            <div class=\"w-1/2 z-0\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_900,h_450,c_fill,g_xy_center,x_600,y_450,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/39be1d28-a603-4ab9-b41b-8c1a75c78e35/EternalSunshineoftheSpotlessMindFilmStill_1200x900_01.jpg\" alt=\"Stratford, London outdoor screening of EternalSunshineoftheSpotlessMindFilmStill_1200x900_01.jpg in London\" class=\"w-full h-[450px] object-cover rounded-2xl shadow-inner\">\n                \n                \n                \n            </div>\n        </div>\n    </div>\n</section>\n\n\n\n<div x-cloak x-show=\"show_trailer\" @keydown.escape.window=\"show_trailer = false\"\n     class=\"fixed inset-0 z-50 flex items-center justify-center p-4\">\n\n    <div class=\"absolute inset-0 bg-black/80\" @click=\"show_trailer = false\"></div>\n\n    <div class=\"relative w-full max-w-4xl z-10\" @click.stop>\n        <button @click=\"show_trailer = false\"\n                class=\"absolute -top-10 right-0 text-white hover:opacity-80 cursor-pointer\">\n            <svg class=\"w-8 h-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\"/>\n            </svg>\n        </button>\n\n        <div class=\"relative w-full\" style=\"padding-bottom: 56.25%\">\n            <template x-if=\"show_trailer\">\n                <iframe\n                    :src=\"trailer_embed_url\"\n                    class=\"absolute inset-0 w-full h-full rounded-xl\"\n                    frameborder=\"0\"\n                    allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n                    allowfullscreen>\n                </iframe>\n            </template>\n        </div>\n    </div>\n</div>\n\n\n\n</div>\n\n\n\n        </main>\n\n        <div id=\"tickets-checkout-root\"></div>\n        <div id=\"gift-card-checkout-root\"></div>\n\n        <div id=\"modals-root\"></div>\n\n        <footer class=\"w-full bg-brand-red text-brand-white px-4 md:px-12 py-12\">\n\n    <div class=\"flex flex-col gap-3 mb-12 items-start\">\n        \n            <div>\n                <div class=\"inline-flex 