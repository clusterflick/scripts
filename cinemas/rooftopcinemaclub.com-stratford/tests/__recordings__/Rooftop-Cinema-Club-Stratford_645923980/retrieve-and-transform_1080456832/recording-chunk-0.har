            "mimeType": "text/html; charset=utf-8",
            "text": "<!doctype html>\n<html class=\"scroll-smooth antialiased\" lang=\"en\">\n    <head>\n        <meta charset=\"utf-8\">\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n        <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"theme-color\" content=\"#E95D40\">\n        \n        \n        <title>Dirty Dancing at Stratford, London &mdash; August 31, 2026 | Rooftop Cinema Club</title>\n<meta name=\"description\" content=\"Watch Dirty Dancing at Stratford, London on August 31, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:title\" content=\"Dirty Dancing at Stratford, London &mdash; August 31, 2026\" />\n<meta property=\"og:description\" content=\"Watch Dirty Dancing at Stratford, London on August 31, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:url\" content=\"https://rooftopcinemaclub.com/uk/london/stratford/screenings/dirty-dancing-3001\" />\n<meta property=\"og:site_name\" content=\"Rooftop Cinema Club\" />\n<meta property=\"og:locale\" content=\"en_GB\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"Dirty Dancing at Stratford, London &mdash; August 31, 2026\" />\n<meta name=\"twitter:description\" content=\"Watch Dirty Dancing at Stratford, London on August 31, 2026. Outdoor rooftop cinema in London.\" />\n<link href=\"https://rooftopcinemaclub.com/uk\" rel=\"home\" />\n<link href=\"https://rooftopcinemaclub.com/uk/london/stratford/screenings/dirty-dancing-3001\" rel=\"canonical\" />\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Global Home\",\"item\":\"https://rooftopcinemaclub.com/uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"London\",\"item\":\"https://rooftopcinemaclub.com/uk/london\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Stratford, London\",\"item\":\"https://rooftopcinemaclub.com/uk/london/stratford\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Dirty Dancing\",\"item\":\"https://rooftopcinemaclub.com/uk/london/stratford/screenings/dirty-dancing-3001\"}]}</script>\n<script type=\"application/ld+json\">{    \"@context\": \"https://schema.org\",    \"@type\": \"ScreeningEvent\",    \"@id\": \"https://rooftopcinemaclub.com/uk/london/stratford/screenings/dirty-dancing-3001#event\",    \"name\": \"Dirty Dancing\",    \"url\": \"https://rooftopcinemaclub.com/uk/london/stratford/screenings/dirty-dancing-3001\",    \"startDate\": \"2026-08-31T18:00:00+00:00\",            \"endDate\": \"2026-08-31T19:40:00+00:00\",            \"eventStatus\": \"https://schema.org/EventScheduled\",    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",    \"inLanguage\": \"en-GB\",    \"isAccessibleForFree\": false,    \"offers\": {        \"@type\": \"Offer\",        \"url\": \"https://rooftopcinemaclub.com/uk/london/stratford/screenings/dirty-dancing-3001\",        \"availability\": \"https://schema.org/InStock\"    },        \"description\": \"Nobody puts summer in a corner. &nbsp; Join us on the final official day of summer for a special rooftop screening of Dirty Dancing &ndash; the ultimate holiday romance and the perfect way to say goodbye to the season. &nbsp; As the sun sets over the city, relive every lift, dance move and unforgettable line from the film that gave us Baby, Johnny and one of the most iconic movie soundtracks of all time. Whether you're watching for the first time or the fiftieth, there's something magical about experiencing Dirty Dancing under the open sky. &nbsp; Grab a drink, bring your favourite person and spend the last evening of summer celebrating romance, nostalgia and the feeling that maybe, just maybe, summer doesn't have to end quite yet. &nbsp; I've had the time of my life. See you on the rooftop.\",            \"typicalAgeRange\": \"18+\",    \"audience\": {        \"@type\": \"Audience\",        \"audienceType\": \"18+\"    },                    \"image\": {        \"@type\": \"ImageObject\",        \"url\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_1920,y_1080,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/c2110db4-33c0-4238-b99c-429950911579/dirty-dancing.jpeg\",        \"width\": 1920,        \"height\": 1080    },            \"workFeatured\": {        \"@type\": \"Movie\",        \"name\": \"Dirty Dancing\",                \"image\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_1920,y_1080,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/c2110db4-33c0-4238-b99c-429950911579/dirty-dancing.jpeg\",        \"duration\": \"PT100M\",        \"dateCreated\": \"1987\"    },            \"location\": {        \"@type\": \"MovieTheater\",        \"@id\": \"https://rooftopcinemaclub.com/uk/london/stratford#venue\",        \"name\": \"Stratford, London\",        \"address\": {            \"@type\": \"PostalAddress\",            \"streetAddress\": \"Level 7, Roof East\",            \"postalCode\": \"E15 1XE\",            \"addressLocality\": \"London\",            \"addressCountry\": \"GB\"        },        \"geo\": {            \"@type\": \"GeoCoordinates\",            \"latitude\": 51.5416372,            \"longitude\": -0.0012586999999999        }    },        \"organizer\": {        \"@type\": \"Organization\",        \"@id\": \"https://rooft