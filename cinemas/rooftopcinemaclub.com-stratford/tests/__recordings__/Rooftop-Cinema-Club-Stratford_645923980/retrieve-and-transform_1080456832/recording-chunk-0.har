   \n    \n    \n    <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1600,h_900,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/2ddc2953-0d76-41cf-b109-a3989b32ae36/Shopaholic-Hero-(1).jpg\" alt=\"Stratford, London outdoor screening of Shopaholic-Hero-(1).jpg in London\" fetchpriority=\"high\" class=\"absolute inset-0 w-full h-full object-cover\">\n    \n    \n    \n\n    <div class=\"absolute inset-0 bg-black/30\"></div>\n\n    <div class=\"absolute left-0 right-0 z-10 px-6 lg:px-12 bottom-[20%] md:bottom-[28%]\">\n        <div class=\"text-brand-white\">\n            <p class=\"text-xs md:text-lg mb-2 md:mb-3 flex items-center gap-2\">\n                Sun, Sep 13\n                <span class=\"text-brand-lavenderpink text-sm md:text-lg\">\n                    <svg width=\"19\" height=\"19\" viewBox=\"0 0 19 19\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M18.5929 12.0172L15.8036 9.5L18.5929 6.98282C19.4486 6.21064 18.8604 4.79245 17.7097 4.85021L13.9583 5.04173L14.1498 1.29028C14.2091 0.139614 12.7894 -0.44864 12.0172 0.407141L9.5 3.19641L6.98282 0.407141C6.21064 -0.44864 4.79245 0.139614 4.85021 1.29028L5.04173 5.04173L1.29028 4.85021C0.139614 4.79093 -0.44864 6.21064 0.407141 6.98282L3.19641 9.5L0.407141 12.0172C-0.44864 12.7894 0.139614 14.2076 1.29028 14.1498L5.04173 13.9583L4.85021 17.7097C4.79093 18.8604 6.21064 19.4486 6.98282 18.5929L9.5 15.8036L12.0172 18.5929C12.7894 19.4486 14.2076 18.8604 14.1498 17.7097L13.9583 13.9583L17.7097 14.1498C18.8604 14.2091 19.4486 12.7894 18.5929 12.0172Z\" fill=\"currentColor\"/>\n                    </svg>\n                </span>\n                5:45 PM\n            </p>\n\n            <h1 class=\"text-2xl md:text-5xl lg:text-6xl font-black uppercase leading-tight mb-3 md:mb-5 tracking-tight\">\n                Book Club: Confessions of a Shopaholic\n            </h1>\n\n            <div class=\"flex items-center gap-3 md:gap-5\">\n                \n\n<button data-checkout-screening=\"3652261d-a6ea-4904-9e69-998a368282e9\"\n        class=\"cursor-pointer inline-flex items-center justify-center rounded-full px-4 py-2 text-xs sm:px-5 sm:py-2.5 sm:text-sm md:px-6 md:py-2.5 md:text-[16px] font-bold border-2 border-transparent bg-brand-lavenderpink text-brand-navy transition-colors duration-150 hover:bg-brand-honey active:bg-brand-honey\">\n    Book\n</button>\n\n\n\n\n\n                \n                \n                \n            </div>\n\n            \n        </div>\n    </div>\n\n    <div class=\"absolute bottom-0 right-0 z-10 px-6 lg:px-12 pb-8 flex flex-col items-end gap-2\">\n        \n        <div class=\"flex items-center justify-center text-center w-12 h-12 rounded-full bg-brand-lightbeige text-brand-navy\">\n            <h3 class=\"text-xl leading-none\">18+</h3>\n        </div>\n        \n\n        \n\n        \n        <div class=\"flex flex-wrap gap-1 justify-end\">\n            \n            <span class=\"px-2 py-1 text-xs rounded bg-white text-brand-navy font-medium\">\n            Event\n        </span>\n            \n        </div>\n        \n    </div>\n</section>\n\n<section class=\"w-[90%] bg-brand-honey rounded-lg py-16 px-12 mx-auto space-y-12 my-16\">\n    <h2 class=\"text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-brand-navy leading-tight\">\n        Screening Details\n    </h2>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-6 md:gap-y-10 mb-20 px-0 md:px-8\">\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Film</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\"><a href=\"/uk/films/book-club-confessions-of-a-shopaholic\" class=\"underline\">Book Club: Confessions of a Shopaholic</a></div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Venue</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\"><a href=\"/uk/london/stratford\" class=\"underline\">Stratford, London</a></div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Screen</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Screen 1</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Duration</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">235 Minutes</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        \n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Date</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Sun, Sep 13</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">5:45 PM</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Year</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\"></div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n    </div>\n\n    <div class=\"rounded-2xl p-10 text-brand-navy/80\">\n        <p>Open to everyone, join us for a fun, chatty evening led by Caitlin Curry from London Girls Book Club, celebrating the iconic Confessions of a Shopaholic by Sophie Kinsella.</p>\n<p>&nbsp;</p>\n<p>We'll be discussing the much loved novel before heading in to watch the film adaptation together, because books are meant to be not just read, but experienced together.</p>\n<p>&nbsp;</p>\n<p>Whether you're a long time Becky Bloomwood fan or discovering her story for the first time, this event is all about sharing thoughts, swapping opinions and connecting with other lovely book lovers in a relaxed and welcoming space.</p>\n<p>&nbsp;</p>\n<p>For those with a London Girls Book Club ticket, Caitlin will lead the discussion with thought provoking book club questions, leaving plenty of time to chat, meet new people and dive into the humour, heart and unforgettable moments that have made Confessions of a Shopaholic such a modern classic before settling in to enjoy the film together.</p>\n<p>&nbsp;</p>\n<p><br>Here&rsquo;s how the night will go for those with a London Girls Book Club ticket:</p>\n<p>&nbsp;</p>\n<p>5:45pm &ndash; Arrival: grab your welcome drink and get to know everyone<br>6:05pm &ndash; Quick intro from Caitlin &amp; London Girls Book Club<br>6:15pm &ndash; First round of book chat on Confessions of Shopaholic by Sophie Kinsella with guided book club questions<br>6:45pm &ndash; Group swap to meet new people / second round of discussion begins<br>7:15pm &ndash; Book club discussion ends and we&rsquo;ll head to watch the film together<br>7:45pm &ndash; Grab some food/snacks and the film begins<br>9:30pm &ndash; Film ends &amp; goodbyes!</p>\n    </div>\n\n    <div class=\"mt-8\">\n\n        <div class=\"md:hidden relative\">\n            <div class=\"relative\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_400,h_300,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/2ddc2953-0d76-41cf-b109-a3989b32ae36/Shopaholic-Hero-(1).jpg\" alt=\"Stratford, London outdoor screening of Shopaholic-Hero-(1).jpg in London\" class=\"w-[45%] aspect-[4/3] object-cover rounded-xl relative z-10 -ml-4 shadow-lg\">\n                \n                \n                \n            </div>\n\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-5 pt-10 -mt-6 relative z-0\">\n                <div class=\"prose prose-invert prose-sm leading-relaxed max-w-none\">\n                    A book club + movie night in collaboration with London Girls Book Club. September's book is the iconic Confessions of a Shopaholic.\n                </div>\n            </div>\n            \n        </div>\n\n        <div class=\"hidden md:flex relative flex-row items-center gap-0 min-h-[350px]\">\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-10 w-1/2 z-10 relative -mr-12 shadow-2xl\">\n                <div class=\"prose prose-invert prose-lg leading-relaxed max-w-none\">\n                    A book club + movie night in collaboration with London Girls Book Club. September's book is the iconic Confessions of a Shopaholic.\n                </div>\n            </div>\n            \n\n            <div class=\"w-1/2 z-0\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_900,h_450,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/2ddc2953-0d76-41cf-b109-a3989b32ae36/Shopaholic-Hero-(1).jpg\" alt=\"Stratford, London outdoor screening of Shopaholic-Hero-(1).jpg in London\" class=\"w-full h-[450px] object-cover rounded-2xl shadow-inner\">\n                \n                \n                \n            </div>\n        </div>\n    </div>\n</section>\n\n\n\n\n</div>\n\n\n\n        </main>\n\n        <div id=\"tickets-checkout-root\"></div>\n        <div id=\"gift-card-checkout-root\"></div>\n\n        <div id=\"modals-root\"></div>\n\n        <footer class=\"w-full bg-br