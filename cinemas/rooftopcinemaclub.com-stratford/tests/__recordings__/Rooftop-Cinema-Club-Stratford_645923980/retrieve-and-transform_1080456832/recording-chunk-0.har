            "mimeType": "text/html; charset=utf-8",
            "text": "<!doctype html>\n<html class=\"scroll-smooth antialiased\" lang=\"en\">\n    <head>\n        <meta charset=\"utf-8\">\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n        <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"theme-color\" content=\"#E95D40\">\n        \n        \n        <title>10 Things I Hate About You x Sofar Sounds at Stratford, London &mdash; August 12, 2026 | Rooftop Cinema Club</title>\n<meta name=\"description\" content=\"Watch 10 Things I Hate About You x Sofar Sounds at Stratford, London on August 12, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:title\" content=\"10 Things I Hate About You x Sofar Sounds at Stratford, London &mdash; August 12, 2026\" />\n<meta property=\"og:description\" content=\"Watch 10 Things I Hate About You x Sofar Sounds at Stratford, London on August 12, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:url\" content=\"https://rooftopcinemaclub.com/uk/london/stratford/screenings/10-things-i-hate-about-you-x-sofar-sounds-2962\" />\n<meta property=\"og:site_name\" content=\"Rooftop Cinema Club\" />\n<meta property=\"og:locale\" content=\"en_GB\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"10 Things I Hate About You x Sofar Sounds at Stratford, London &mdash; August 12, 2026\" />\n<meta name=\"twitter:description\" content=\"Watch 10 Things I Hate About You x Sofar Sounds at Stratford, London on August 12, 2026. Outdoor rooftop cinema in London.\" />\n<link href=\"https://rooftopcinemaclub.com/uk\" rel=\"home\" />\n<link href=\"https://rooftopcinemaclub.com/uk/london/stratford/screenings/10-things-i-hate-about-you-x-sofar-sounds-2962\" rel=\"canonical\" />\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Global Home\",\"item\":\"https://rooftopcinemaclub.com/uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"London\",\"item\":\"https://rooftopcinemaclub.com/uk/london\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Stratford, London\",\"item\":\"https://rooftopcinemaclub.com/uk/london/stratford\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"10 Things I Hate About You x Sofar Sounds\",\"item\":\"https://rooftopcinemaclub.com/uk/london/stratford/screenings/10-things-i-hate-about-you-x-sofar-sounds-2962\"}]}</script>\n<script type=\"application/ld+json\">{    \"@context\": \"https://schema.org\",    \"@type\": \"ScreeningEvent\",    \"@id\": \"https://rooftopcinemaclub.com/uk/london/stratford/screenings/10-things-i-hate-about-you-x-sofar-sounds-2962#event\",    \"name\": \"10 Things I Hate About You x Sofar Sounds\",    \"url\": \"https://rooftopcinemaclub.com/uk/london/stratford/screenings/10-things-i-hate-about-you-x-sofar-sounds-2962\",    \"startDate\": \"2026-08-12T19:20:00+00:00\",            \"endDate\": \"2026-08-12T21:40:00+00:00\",            \"eventStatus\": \"https://schema.org/EventScheduled\",    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",    \"inLanguage\": \"en-GB\",    \"isAccessibleForFree\": false,    \"offers\": {        \"@type\": \"Offer\",        \"url\": \"https://rooftopcinemaclub.com/uk/london/stratford/screenings/10-things-i-hate-about-you-x-sofar-sounds-2962\",        \"availability\": \"https://schema.org/InStock\"    },        \"description\": \"A very special screening of 10 Things I Hate About You in partnership with Sofar Sounds, featuring a live performance inspired by the iconic sounds of the 90s. Expect nostalgic indie-pop, alternative rock and feel-good anthems that perfectly capture the spirit of one of the decade's most beloved teen films. &nbsp; Before the film begins, during golden hour, we&rsquo;re handing the rooftop over to the magical team at Sofar Sounds for an intimate live set under the London sky. &nbsp; Expect stripped-back performances inspired by this classic movie, undiscovered talent and that unmistakable Sofar energy - the kind that makes you feel like you&rsquo;ve stumbled into something secret and special.&nbsp; &nbsp; Then, as the sun dips and the skyline glows, we roll straight into our movie. &nbsp; Rooftop Cinema Club is an 18+ venue after 5pm. &nbsp; Sofar Sounds shows are intimate, listening-focused experiences &nbsp;- this gig will be served to you via our state of the art headphones.&nbsp;\",            \"typicalAgeRange\": \"18+\",    \"audience\": {        \"@type\": \"Audience\",        \"audienceType\": \"18+\"    },                    \"image\": {        \"@type\": \"ImageObject\",        \"url\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_1440,y_810,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/0056ac1c-7e2a-46bc-889e-ae0380664283/10-things-I-hate-about-you.png\",        \"width\": 1920,        \"height\": 1080    },            \"workFeatured\": {        \"@type\": \"Movie\",        \"name\": \"10 Things I Hate About You x Sofar Sounds\",                \"image\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_1440,y_810,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/0056ac1c-7e2a-46bc-889e-ae0380664283/10-things-I-hate-about-you.png\",        \"duration\": \"PT140M\",        \"dateCreated\": \"1999\"    },            \"location\": {        \"@type\": \"MovieTheater\",        \"@id\": \"https://rooftopcinemaclub.com/uk/london/stratford#venue\",        \"name\": \"Stratford, London\",        \"address\": {            \"@type\": \"PostalAddress\",            \"streetAddress\": \"Level 7, Roof East\",            \"postalCode\": \"E15 1XE\",            \"addressLocality\": \"London\",            \"addressCountry\": \"GB\"        },        \"geo\": {            \"@type\": \"GeoCoordinates\",            \"latitude\": 51.5416372,            \"longitude\": -0.0012586999999999        }    },        \"organizer\": {        \"@type\": \"Organization\",        \"@id\": \"https://rooftopcinemaclub.com/#organization\",        \"name\": \"Rooftop Cinema Club\",        \"url\": \"https://rooftopcinemaclub.com\"    },    \"performer\": {        \"@type\": \"Organization\",        \"@id\": \"https://rooftopcinemaclub.com/#organization\",        \"name\": \"Rooftop Cinema Club\",        \"url\": \"https://rooftopcinemaclub.com\"    }}</script>\n        <script type=\"application/ld+json\">\n        {\n            \"@context\": \"https://schema.org\",\n            \"@graph\": [\n                {\n                    \"@type\": \"Organization\",\n                    \"@id\": \"https://rooftopcinemaclub.com/#organization\",\n                    \"name\": \"Rooftop Cinema Club\",\n                    \"url\": \"https://rooftopcinemaclub.com\",\n                    \"logo\": {\n                        \"@type\": \"ImageObject\",\n                        \"url\": \"https://rooftopcinemaclub.com/images/Rooftop_Cinema_Logo_Cream.svg\",\n                        \"width\": 1600,\n                        \"height\": 450\n                    },\n                    \"sameAs\": [\n                        \"https://www.instagram.com/rooftopcinemaclub/\",\n                        \"https://www.facebook.com/RooftopCinemaClub/\",\n                        \"https://www.tiktok.com/@rooftopcinemaclub\",\n                        \"https://twitter.