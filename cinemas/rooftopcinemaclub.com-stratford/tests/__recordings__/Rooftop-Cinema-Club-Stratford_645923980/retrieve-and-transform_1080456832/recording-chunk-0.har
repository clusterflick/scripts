          "content": {
            "mimeType": "text/html; charset=utf-8",
            "text": "<!doctype html>\n<html class=\"scroll-smooth antialiased\" lang=\"en\">\n    <head>\n        <meta charset=\"utf-8\">\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n        <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"theme-color\" content=\"#E95D40\">\n        \n        \n        <title>Book Club: Confessions of a Shopaholic at Stratford, London &mdash; September 13, 2026 | Rooftop Cinema Club</title>\n<meta name=\"description\" content=\"Watch Book Club: Confessions of a Shopaholic at Stratford, London on September 13, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:title\" content=\"Book Club: Confessions of a Shopaholic at Stratford, London &mdash; September 13, 2026\" />\n<meta property=\"og:description\" content=\"Watch Book Club: Confessions of a Shopaholic at Stratford, London on September 13, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:url\" content=\"https://rooftopcinemaclub.com/uk/london/stratford/screenings/book-club-confessions-of-a-shopaholic-3078\" />\n<meta property=\"og:site_name\" content=\"Rooftop Cinema Club\" />\n<meta property=\"og:locale\" content=\"en_GB\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"Book Club: Confessions of a Shopaholic at Stratford, London &mdash; September 13, 2026\" />\n<meta name=\"twitter:description\" content=\"Watch Book Club: Confessions of a Shopaholic at Stratford, London on September 13, 2026. Outdoor rooftop cinema in London.\" />\n<link href=\"https://rooftopcinemaclub.com/uk\" rel=\"home\" />\n<link href=\"https://rooftopcinemaclub.com/uk/london/stratford/screenings/book-club-confessions-of-a-shopaholic-3078\" rel=\"canonical\" />\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Global Home\",\"item\":\"https://rooftopcinemaclub.com/uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"London\",\"item\":\"https://rooftopcinemaclub.com/uk/london\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Stratford, London\",\"item\":\"https://rooftopcinemaclub.com/uk/london/stratford\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Book Club: Confessions of a Shopaholic\",\"item\":\"https://rooftopcinemaclub.com/uk/london/stratford/screenings/book-club-confessions-of-a-shopaholic-3078\"}]}</script>\n<script type=\"application/ld+json\">{    \"@context\": \"https://schema.org\",    \"@type\": \"ScreeningEvent\",    \"@id\": \"https://rooftopcinemaclub.com/uk/london/stratford/screenings/book-club-confessions-of-a-shopaholic-3078#event\",    \"name\": \"Book Club: Confessions of a Shopaholic\",    \"url\": \"https://rooftopcinemaclub.com/uk/london/stratford/screenings/book-club-confessions-of-a-shopaholic-3078\",    \"startDate\": \"2026-09-13T17:45:00+00:00\",            \"endDate\": \"2026-09-13T21:40:00+00:00\",            \"eventStatus\": \"https://schema.org/EventScheduled\",    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",    \"inLanguage\": \"en-GB\",    \"isAccessibleForFree\": false,    \"offers\": {        \"@type\": \"Offer\",        \"url\": \"https://rooftopcinemaclub.com/uk/london/stratford/screenings/book-club-confessions-of-a-shopaholic-3078\",        \"availability\": \"https://schema.org/InStock\"    },        \"description\": \"Open to everyone, join us for a fun, chatty evening led by Caitlin Curry from London Girls Book Club, celebrating the iconic Confessions of a Shopaholic by Sophie Kinsella. &nbsp; We'll be discussing the much loved novel before heading in to watch the film adaptation together, because books are meant to be not just read, but experienced together. &nbsp; Whether you're a long time Becky Bloomwood fan or discovering her story for the first time, this event is all about sharing thoughts, swapping opinions and connecting with other lovely book lovers in a relaxed and welcoming space. &nbsp; For those with a London Girls Book Club ticket, Caitlin will lead the discussion with thought provoking book club questions, leaving plenty of time to chat, meet new people and dive into the humour, heart and unforgettable moments that have made Confessions of a Shopaholic such a modern classic before settling in to enjoy the film together. &nbsp; Here&rsquo;s how the night will go for those with a London Girls Book Club ticket: &nbsp; 5:45pm &ndash; Arrival: grab your welcome drink and get to know everyone6:05pm &ndash; Quick intro from Caitlin &amp; London Girls Book Club6:15pm &ndash; First round of book chat on Confessions of Shopaholic by Sophie Kinsella with guided book club questions6:45pm &ndash; Group swap to meet new people / second round of discussion begins7:15pm &ndash; Book club discussion ends and we&rsquo;ll head to watch the film together7:45pm &ndash; Grab some food/snacks and the film begins9:30pm &ndash; Film ends &amp; goodbyes!\",            \"typicalAgeRange\": \"18+\",    \"audience\": {        \"@type\": \"Audience\",        \"audienceType\": \"18+\"    },                    \"image\": {        \"@type\": \"ImageObject\",        \"url\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/2ddc2953-0d76-41cf-b109-a3989b32ae36/Shopaholic-Hero-(1).jpg\",        \"width\": 1920,        \"height\": 1080    },            \"workFeatured\": {        \"@type\": \"Movie\",        \"name\": \"Book Club: Confessions of a Shopaholic\",                \"image\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/2ddc2953-0d76-41cf-b109-a3989b32ae36/Shopaholic-Hero-(1).jpg\",        \"duration\": \"PT235M\"    },            \"location\": {        \"@type\": \"MovieTheater\",        \"@id\": \"https://rooftopcinemaclub.com/uk/london/stratford#venue\",        \"name\": \"Stratford, London\",        \"address\": {            \"@type\": \"PostalAddress\",            \"streetAddress\": \"Level 7, Roof East\",            \"postalCode\": \"E15 1XE\",            \"addressLocality\": \"London\",            \"addressCountry\": \"GB\"        },        \"geo\": {            \"@type\": \"GeoCoordinates\",            \"latitude\": 51.5416372,            \"longitude\": -0.0012586999999999        }    },        \"organizer\": {        \"@type\": \"Organization\",        \"@id\": \"https://rooftopcinemaclub.com/#organization\",        \"name\": \"Rooftop Cinema Club\",        \"url\": \"https://rooftopcinemaclub.com\"    },    \"performer\": {        \"@type\": \"Organization\",        \"@id\": \"https://rooftopcinemaclub.com/#organization\",        \"name\": \"Rooftop Cinema Club\",        \"url\": \"https://rooftopcinemaclub.com\"    }}</script>\n        <script type=\"application/ld+json\">\n        {\n            \"@context\": \"https://schema.org\",\n            \"@graph\": [\n                {\n                    \"@type\": \"Organization\",\n                    \"@id\": \"https://rooftopcinemaclub.com/#organization\",\n                    \"name\": \"Rooftop Cinema Club\",\n                    \"url\": \"https://rooftopcinemaclub.com\",\n                    \"logo\": {\n                        \"@type\": \"ImageObject\",\n                        \"url\": \