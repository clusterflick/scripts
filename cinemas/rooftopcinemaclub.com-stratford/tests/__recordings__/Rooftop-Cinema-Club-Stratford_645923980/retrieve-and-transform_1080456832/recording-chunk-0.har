:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Duration</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">180 Minutes</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        \n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Door Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">45 mins</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n        \n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Date</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Sat, Aug 15</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">7:35 PM</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Year</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">2013</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n    </div>\n\n    <div class=\"rounded-2xl p-10 text-brand-navy/80\">\n        \n    </div>\n\n    <div class=\"mt-8\">\n\n        <div class=\"md:hidden relative\">\n            <div class=\"relative\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_400,h_300,c_fill,g_xy_center,x_363,y_200,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/76c2e365-f470-47b6-9a7c-c08e51928bbd/The-Wolf-of-Wall-Street.jpeg\" alt=\"Stratford, London outdoor screening of The-Wolf-of-Wall-Street.jpeg in London\" class=\"w-[45%] aspect-[4/3] object-cover rounded-xl relative z-10 -ml-4 shadow-lg\">\n                \n                \n                \n            </div>\n\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-5 pt-10 -mt-6 relative z-0\">\n                <div class=\"prose prose-invert prose-sm leading-relaxed max-w-none\">\n                    EARN. SPEND. PARTY.\r\nBased on the true story of Jordan Belfort, from his rise to a wealthy stock-broker living the high life to his fall involving crime, corruption and the federal government.\n                </div>\n            </div>\n            \n        </div>\n\n        <div class=\"hidden md:flex relative flex-row items-center gap-0 min-h-[350px]\">\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-10 w-1/2 z-10 relative -mr-12 shadow-2xl\">\n                <div class=\"prose prose-invert prose-lg leading-relaxed max-w-none\">\n                    EARN. SPEND. PARTY.\r\nBased on the true story of Jordan Belfort, from his rise to a wealthy stock-broker living the high life to his fall involving crime, corruption and the federal government.\n                </div>\n            </div>\n            \n\n            <div class=\"w-1/2 z-0\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_900,h_450,c_fill,g_xy_center,x_363,y_200,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/76c2e365-f470-47b6-9a7c-c08e51928bbd/The-Wolf-of-Wall-Street.jpeg\" alt=\"Stratford, London outdoor screening of The-Wolf-of-Wall-Street.jpeg in London\" class=\"w-full h-[450px] object-cover rounded-2xl shadow-inner\">\n                \n                \n                \n            </div>\n        </div>\n    </div>\n</section>\n\n\n\n<div x-cloak x-show=\"show_trailer\" @keydown.escape.window=\"show_trailer = false\"\n     