  <path d=\"M26.667 21.333C29.6124 21.3332 32 23.7216 32 26.667C31.9998 29.6123 29.6123 31.9998 26.667 32H5.33301C2.38774 31.9998 0.000173164 29.6123 0 26.667C0 23.7216 2.38764 21.3332 5.33301 21.333C2.38764 21.3328 0 18.9454 0 16C2.57701e-06 13.0546 2.38764 10.6672 5.33301 10.667C2.38764 10.6668 0 8.27842 0 5.33301C0.000178318 2.38775 2.38775 0.000178659 5.33301 0H26.667C29.6123 0.000176597 31.9998 2.38775 32 5.33301C32 8.27842 29.6124 10.6668 26.667 10.667C29.6124 10.6672 32 13.0546 32 16C32 18.9454 29.6124 21.3328 26.667 21.333Z\" fill=\"#5C9AC6\"/>\n                            <path d=\"M10.5 16H21.5\" stroke=\"#F9F4EE\" stroke-linecap=\"round\" stroke-width=\"2\"/>\n                            <path d=\"M16 10.5V21.5\" stroke=\"#F9F4EE\" stroke-linecap=\"round\" stroke-width=\"2\"/>\n                        </svg>\n                    </button>\n                </div>\n\n                <div class=\"col-span-2 md:col-span-1 md:col-start-3 md:row-start-1 md:row-span-2 flex items-start\">\n                    \n                    <button data-checkout-screening=\"a532af7f-b59e-4bca-a67c-9b04ca077935\" class=\"flex items-center justify-between w-full px-5 py-3 md:py-2.5 bg-brand-navy text-brand-white text-sm font-bold rounded-full hover:bg-brand-navy/90 transition-colors cursor-pointer\">\n                        <span>BOOK</span>\n                        <span class=\"flex items-center gap-1.5 text-xs font-normal ml-4\">\n                            <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n                            <span>7:00 PM</span>\n                        </span>\n                    </button>\n                    \n                </div>\n            </div>\n            \n        </div>\n    </div>\n    \n    <div class=\"screening-group mb-12 md:mb-16\">\n        <div class=\"mb-8\">\n            <h2 class=\"text-base md:text-lg font-bold text-brand-navy uppercase shrink-0 pb-3\">SUN, SEP 13</h2>\n            <hr class=\"border-brand-navy\">\n        </div>\n\n        <div class=\"space-y-14\">\n            \n            <div class=\"screening-card grid grid-cols-[10rem_1fr] md:grid-cols-[1fr_2fr_1fr] gap-x-4 gap-y-3 md:gap-6\">\n\n                <div class=\"col-start-1 row-start-1 md:row-span-2 space-y-2\">\n                    <div class=\"relative rounded-lg overflow-hidden aspect-[4/3] bg-brand-paleblue\">\n                        \n                        <img alt=\"Book Club: Confessions of a Shopaholic\" class=\"w-full h-full object-cover\" src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_600,h_450,c_fill,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/2ddc2953-0d76-41cf-b109-a3989b32ae36/Shopaholic-Hero-(1).jpg\">\n                        \n                        \n                        \n                        <div class=\"absolute bottom-2 right-2 md:bottom-3 md:right-3\">\n                            <div class=\"flex items-center justify-center text-center w-10 h-10 md:w-12 md:h-12 rounded-full bg-brand-lightbeige text-brand-navy\">\n                                <h3 class=\"text-lg md:text-xl leading-none\">18+</h3>\n                            </div>\n                        </div>\n                        \n                    </div>\n                    <div class=\"space-y-1\">\n                        \n                        \n                        \n                        <div class=\"text-center py-1 px-2 text-xs font-medium rounded bg-white text-brand-navy\">Event</div>\n                        \n                        \n                    </div>\n                </div>\n\n                <div class=\"col-start-2 row-start-1 md:row-span-2\">\n                    <h3 class=\"text-sm md:text-lg text-brand-navy uppercase leading-tight mb-2\"><a href=\"/uk/london/stratford/screenings/book-club-confessions-of-a-shopaholic-3078\" class=\"hover:underline\">Book Club: Confessions of a Shopaholic</a></h3>\n\n                    <div class=\"flex flex-wrap items-center gap-x-3 gap-y-1 mb-2 text-brand-navy/80\">\n                        <div class=\"flex items-center gap-1.5 text-xs font-medium\">\n                            <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/>\n                            </svg>\n                            <span>Sun, Sep 13</span>\n                        </div>\n                        \n                        <div class=\"flex items-center gap-1.5 text-xs font-medium\">\n                            <svg class=\"w-3.5 h-3.5 shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n                            <span>5:45 PM</span>\n                        </div>\n                        \n                        \n                        \n                        <div class=\"flex items-center gap-1.5 text-xs font-medium\">\n                            <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z\"/>\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 11a3 3 0 11-6 0 3 3 0 016 0z\"/>\n                            </svg>\n                            <span>Stratford, London</span>\n                        </div>\n                        \n                    </div>\n\n                    \n                    <p class=\"text-xs md:text-sm text-brand-navy/70 italic line-clamp-1 mb-3\">A book club + movie night in collaboration with London Girls Book Club. September's book is the iconic Confessions of a Shopaholic.</p>\n                    \n\n                    <button data-screening-details=\"3652261d-a6ea-4904-9e69-998a368282e9\" class=\"inline-flex items-center gap-2 py-2 border-b border-brand-navy/40 cursor-pointer\">\n                        <span class=\"text-sm md:text-base text-brand-navy\">More Details</span>\n                        <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"none\" viewBox=\"0 0 32 32\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path d=\"M26.667 21.333C29.6124 21.3332 32 23.7216 32 26.667C31.9998 29.6123 29.6123 31.9998 26.667 32H5.33301C2.38774 31.9998 0.000173164 29.6123 0 26.667C0 23.7216 2.38764 21.3332 5.33301 21.333C2.38764 21.3328 0 18.9454 0 16C2.57701e-06 13.0546 2.38764 10.6672 5.33301 10.667C2.38764 10.6668 0 8.27842 0 5.33301C0.000178318 2.38775 2.38775 0.000178659 5.33301 0H26.667C29.6123 0.000176597 31.9998 2.38775 32 5.33301C32 8.27842 29.6124 10.6668 26.667 10.667C29.6124 10.6672 32 13.0546 32 16C32 18.9454 29.6124 21.3328 26.667 21.333Z\" fill=\"#5C9AC6\"/>\n                            <path d=\"M10.5 16H21.5\" stroke=\"#F9F4EE\" stroke-linecap=\"round\" stroke-width=\"2\"/>\n                            <path d=\"M16 10.5V21.5\" stroke=\"#F9F4EE\" stroke-linecap=\"round\" stroke-width=\"2\"/>\n                        </svg>\n                    </button>\n                </div>\n\n                <div class=\"col-span-2 md:col-span-1 md:col-start-3 md:row-start-1 md:row-span-2 flex items-start\">\n                    \n                    <button data-checkout-screening=\"3652261d-a6ea-4904-9e69-998a368282e9\" class=\"flex items-center justify-between w-full px-5 py-3 md:py-2.5 bg-brand-navy text-brand-white text-sm font-bold rounded-full hover:bg-brand-navy/90 transition-colors cursor-pointer\">\n                        <span>BOOK</span>\n                        <span class=\"flex items-center gap-1.5 text-xs font-normal ml-4\">\n                            <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n                            <span>5:45 PM</span>\n                        </span>\n                    </button>\n                    \n                </div>\n            </div>\n            \n        </div>\n    </div>\n    \n    <div class=\"screening-group mb-12 md:mb-16\">\n        <div class=\"mb-8\">\n            <h2 class=\"text-base md:text-lg font-bold text-brand-navy uppercase shrink-0 pb-3\">TUE, SEP 15</h2>\n            <hr class=\"border-brand-navy\">\n        </div>\n\n        <div class=\"space-y-14\">\n            \n            <div class=\"screening-card grid grid-cols-[10rem_1fr] md:grid-cols-[1fr_2fr_1fr] gap-x-4 gap-y-3 md:gap-6\">\n\n                <div class=\"col-start-1 row-start-1 md:row-span-2 space-y-2\">\n                    <div class=\"relative rounded-lg overflow-hidden aspect-[4/3] bg-brand-paleblue\">\n                        \n                        <img alt=\"Sex and the City\" class=\"w-full h-full object-cover\" src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_600,h_450,c_fill,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/5f679e6d-ab78-416e-9d57-3037c04fc577/Sex-and-the-City-Hero.jpg\">\n                        \n                        \n                        \n                        <div class=\"absolute bottom-2 right-2 md:bottom-3 md:right-3\">\n                            <div class=\"flex items-center justify-center text-center w-10 h-10 md:w-12 md:h-12 rounded-full bg-brand-lightbeige text-brand-navy\">\n                                <h3 class=\"text-lg md:text-xl leading-none\">18+</h3>\n                            </div>\n                        </div>\n                        \n                    </div>\n                    <div class=\"space-y-1\">\n                        \n                        \n                        <div class=\"text-center py-1 px-2 text-xs font-medium rounded\" style=\"background-color: #3156d2; color: #f9f4ee\">Mini Marathons</div>\n                        \n                        \n                        <div class=\"text-center py-1 px-2 text-xs font-medium rounded bg-white text-brand-navy\">Event</div>\n                        \n                        \n                    </div>\n                </div>\n\n                <div class=\"col-start-2 row-start-1 md:row-span-2\">\n                    <h3 class=\"text-sm md:text-lg text-brand-navy uppercase leading-tight mb-2\"><a href=\"/uk/london/stratford/screenings/sex-and-the-city-3080\" class=\"hover:underline\">Sex and the City</a></h3>\n\n                    <div class=\"flex flex-wrap items-center gap-x-3 gap-y-1 mb-2 text-brand-navy/80\">\n                        <div class=\"flex items-center gap-1.5 text-xs font-medium\">\n                            <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/>\n                            </svg>\n                            <span>Tue, Sep 15</span>\n                        </div>\n                        \n                        <div class=\"flex items-center gap-1.5 text-xs font-medium\">\n                            <svg class=\"w-3.5 h-3.5 shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n                            <span>7:00 PM</span>\n                        </div>\n                       