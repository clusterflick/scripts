x-transition:leave-start=\"opacity-100\"\n    x-transition:leave-end=\"opacity-0\"\n    @keydown.escape.window=\"menu_open = false\"\n    id=\"primary-menu\"\n    class=\"fixed inset-0 z-[100]\"\n>\n    <div @click=\"menu_open = false\" class=\"absolute inset-0 bg-black/40 hidden md:block\"></div>\n\n    <div\n        x-show=\"menu_open\"\n        x-transition:enter=\"transition ease-out duration-300\"\n        x-transition:enter-start=\"translate-x-8 opacity-0\"\n        x-transition:enter-end=\"translate-x-0 opacity-100\"\n        x-transition:leave=\"transition ease-in duration-200\"\n        x-transition:leave-start=\"translate-x-0 opacity-100\"\n        x-transition:leave-end=\"translate-x-8 opacity-0\"\n        class=\"absolute inset-y-0 right-0 w-full md:w-[700px] lg:w-[780px] bg-brand-red text-brand-white overflow-y-auto\"\n    >\n        <div class=\"min-h-screen flex flex-col px-8 sm:px-12 lg:px-12 pt-8 pb-12\">\n            <div class=\"flex items-baseline gap-4 mb-8\" x-data=\"{ customer: window.app?.customer }\">\n                <template x-if=\"customer\">\n                    <div class=\"flex items-center gap-4 text-sm min-w-0\">\n                        <span class=\"flex items-baseline gap-1 font-semibold min-w-0\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4 shrink-0 self-center\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z\" />\n                            </svg>\n                            <span class=\"truncate\" x-text=\"`${customer.first_name} ${customer.last_name}`\"></span>\n                        </span>\n                        <div class=\"flex items-center shrink-0\">\n                            <a href=\"/uk/account\" class=\"border-b border-brand-white/50 hover:opacity-80 transition\">my account</a>\n                        </div>\n                    </div>\n                </template>\n\n                <template x-if=\"!customer\">\n                    <div class=\"flex items-center gap-2 text-sm\">\n                        <a href=\"/uk/account/login\" class=\"border-b border-brand-white/50 hover:opacity-80 transition\">log in</a>\n                        <span class=\"flex items-center gap-4 shrink-0\">or</span>\n                        <a href=\"/uk/account/register\" class=\"border-b border-brand-white/50 hover:opacity-80 transition\">sign up</a>\n                    </div>\n                </template>\n\n                <button\n                    @click=\"menu_open = false\"\n                    type=\"button\"\n                    class=\"ml-auto shrink-0 w-10 h-10 flex items-center justify-center text-brand-lavender hover:opacity-80 transition cursor-pointer\"\n                >\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"27\" height=\"27\">\n                        <g clip-path=\"url(#modal-close-a)\">\n                            <path fill=\"#C7A2F9\" d=\"M27 6.75a6.75 6.75 0 0 0-13.5 0 6.75 6.75 0 1 0-6.75 6.75 6.75 6.75 0 1 0 6.75 6.75 6.75 6.75 0 1 0 6.753-6.75A6.75 6.75 0 0 0 27 6.75Z\"/>\n                        </g>\n                        <g stroke=\"#F9F4EE\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" clip-path=\"url(#modal-close-b)\">\n                            <path d=\"m18 9.5-9 9M18 18.5l-9-9\"/>\n                        </g>\n                        <defs>\n                            <clipPath id=\"modal-close-a\"><path fill=\"#fff\" d=\"M0 0h27v27H0z\"/></clipPath>\n                            <clipPath id=\"modal-close-b\"><path fill=\"#fff\" d=\"M5.5 6h16v16h-16z\"/></clipPath>\n                        </defs>\n                    </svg>\n                </button>\n            </div>\n\n            <div class=\"flex-1 flex flex-col md:flex-row gap-8 md:gap-24 lg:gap-3