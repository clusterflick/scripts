md:h-10\">\n            </a>\n            <button type=\"button\" data-venue-selector-trigger class=\"self-start flex items-center gap-2 text-sm font-medium tracking-wide transition cursor-pointer rounded-full px-3 py-1 bg-brand-lightbeige text-brand-red hover:bg-brand-honey\">\n    <svg class=\"h-4 w-4 shrink-0\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z\" /><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 11a3 3 0 11-6 0 3 3 0 016 0z\" /></svg>\n    <span class=\"truncate max-w-[150px] md:max-w-none\">Stratford, London</span>\n    <svg class=\"w-3.5 h-3.5 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\" /></svg>\n</button>\n\n            <div id=\"closest-venue-popover-root\" class=\"contents\"></div>\n        </div>\n\n        <nav class=\"flex items-center gap-2 md:gap-3 relative\">\n            \n\n            <div id=\"basket-button-root\"></div>\n\n            <button @click=\"menu_open = true\" type=\"button\" class=\"w-11 h-11 md:w-12 md:h-12 rounded-full bg-brand-lavenderpink flex items-center justify-center text-brand-navy hover:bg-brand-honey transition cursor-pointer\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 md:h-6 md:w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 6h16M4 12h16M4 18h16\" />\n                </svg>\n            </button>\n        </nav>\n    </div>\n</header>\n\n\n        <main id=\"content\" class=\"flex-1 flex flex-col\">\n            <div x-data=\"{\n    show_trailer: false,\n    get trailer_embed_url() {\n        let url = 'https://www.youtube.com/watch?v=EXeTwQWrcwY';\n        url = url.replace('watch?v=', 'embed/').replace('youtu.be/', 'www.youtube.com/embed/');\n        return url + (url.includes('?') ? '&' : '?') + 'autoplay=1';\n    }\n}\">\n<section class=\"relative w-full h-screen overflow-hidden\">\n    \n    \n    \n    <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1600,h_900,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/3dc3a904-944d-4d61-9f0d-81f58b87574c/the-dark-knight.jpeg\" alt=\"Stratford, London outdoor screening of the-dark-knight.jpeg in London\" fetchpriority=\"high\" class=\"absolute inset-0 w-full h-full object-cover\">\n    \n    \n    \n\n    <div class=\"absolute inset-0 bg-black/30\"></div>\n\n    <div class=\"absolute left-0 right-0 z-10 px-6 lg:px-12 bottom-[20%] md:bottom-[28%]\">\n        <div class=\"text-brand-white\">\n            <p class=\"text-xs md:text-lg mb-2 md:mb-3 flex items-center gap-2\">\n                Sat, Aug 29\n                <span class=\"text-brand-lavenderpink text-sm md:text-lg\">\n                    <svg width=\"19\" height=\"19\" viewBox=\"0 0 19 19\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M18.5929 12.0172L15.8036 9.5L18.5929 6.98282C19.4486 6.21064 18.8604 4.79245 17.7097 4.85021L13.9583 5.04173L14.1498 1.29028C14.2091 0.139614 12.7894 -0.44864 12.0172 0.407141L9.5 3.19641L6.98282 0.407141C6.21064 -0.44864 4.79245 0.139614 4.85021 1.29028L5.04173 5.04173L1.29028 4.85021C0.139614 4.79093 -0.44864 6.21064 0.407141 6.98282L3.19641 9.5L0.407141 12.0172C-0.44864 12.7894 0.139614 14.2076 1.29028 14.1498L5.04173 13.9583L4.85021 17.7097C4.79093 18.8604 6.21064 19.4486 6.98282 18.5929L9.5 15.8036L12.0172 18.5929C12.7894 19.4486 14.2076 18.8604 14.1498 17.7097L13.9583 13.9583L17.7097 14.1498C18.8604 14.2091 19.4486 12.7894 18.5929 12.0172Z\" fill=\"currentColor\"/>\n                    </svg>\n                </span>\n                8:00 PM\n            </p>\n\n            <h1 class=\"text-2xl md:text-5xl lg:text-6xl font-black uppercase leading-tight mb-3 md:mb-5 tracking-tight\">\n                The Dark Knight\n            </h1>\n\n            <div class=\"flex items-center gap-3 md:gap-5\">\n                \n\n<button data-checkout-screening=\"964dabdf-0fe0-4186-b6a1-d95f39a31337\"\n        class=\"cursor-pointer inline-flex items-center justify-center rounded-full px-4 py-2 text-xs sm:px-5 sm:py-2.5 sm:text-sm md:px-6 md:py-2.5 md:text-[16px] font-bold border-2 border-transparent bg-brand-lavenderpink text-brand-navy transition-colors duration-150 hover:bg-brand-honey active:bg-brand-honey\">\n    Book\n</button>\n\n\n\n\n\n                \n                \n                <button @click=\"show_trailer = true\" class=\"flex items-center gap-1.5 md:gap-2 text-brand-white text-xs md:text-base font-medium hover:opacity-80 transition cursor-pointer\">\n                    <svg class=\"w-6 h-6 md:w-8 md:h-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" fill=\"none\"/>\n                        <path d=\"M10 8.5l6 3.5-6 3.5V8.5z\" fill=\"currentColor\" stroke=\"none\"/>\n                    </svg>\n                    Play Trailer\n                </button>\n                \n                \n            </div>\n\n            \n        </div>\n    </div>\n\n    <div class=\"absolute bottom-0 right-0 z-10 px-6 lg:px-12 pb-8 flex flex-col items-end gap-2\">\n        \n        <div class=\"flex items-center justify-center text-center w-12 h-12 rounded-full bg-brand-lightbeige text-brand-navy\">\n            <h3 class=\"text-xl leading-none\">18+</h3>\n        </div>\n        \n\n        \n\n        \n    </div>\n</section>\n\n<section class=\"w-[90%] bg-brand-honey rounded-lg py-16 px-12 mx-auto space-y-12 my-16\">\n    <h2 class=\"text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-brand-navy leading-tight\">\n        Screening Details\n    </h2>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-6 md:gap-y-10 mb-20 px-0 md:px-8\">\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Film</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\"><a href=\"/uk/films/the-dark-knight\" class=\"underline\">The Dark Knight</a></div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Venue</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\"><a href=\"/uk/london/stratford\" class=\"underline\">Stratford, London</a></div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Screen</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Screen 1</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Duration</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">152 Minutes</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        \n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Door Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">45 mins</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n        \n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Date</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Sat, Aug 29</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">8:00 PM</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Year</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">2008</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n    </div>\n\n    <div class=\"rounded-2xl p-10 text-brand-navy/80\">\n        \n    </div>\n\n    <div class=\"mt-8\">\n\n        <div class=\"md:hidden relative\">\n            <div class=\"relative\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_400,h_300,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/3dc3a904-944d-4d61-9f0d-81f58b87574c/the-dark-knight.jpeg\" alt=\"Stratford, London outdoor screening of the-dark-knight.jpeg in London\" class=\"w-[45%] aspect-[4/3] object-cover rounded-xl relative z-10 -ml-4 shadow-lg\">\n                \n                \n                \n            </div>\n\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-5 pt-10 -mt-6 relative z-0\">\n                <div class=\"prose prose-invert prose-sm leading-relaxed max-w-none\">\n                    WHY SO SERIOUS?\r\n\r\nBatman raises the stakes in his war on crime. With the help of Lt. Jim Gordon and District Attorney Harvey Dent, Batman sets out to dismantle the remaining criminal organizations that plague the streets. The partnership proves to be effective, but they soon find themselves prey to a reign of chaos unleashed by a rising criminal mastermind known to the terrified citizens of Gotham as the Joker.\n                </div>\n            </div>\n            \n        </div>\n\n        <div class=\"hidden md:flex relative flex-row items-center gap-0 min-h-[350px]\">\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-10 w-1/2 z-10 relative -mr-12 shadow-2xl\">\n                <div class=\"prose prose-invert prose-lg leading-relaxed max-w-none\">\n                    WHY SO SERIOUS?\r\n\r\nBatman raises the stakes in his war on crime. With the help of Lt. Jim Gordon and District Attorney Harvey Dent, Batman sets out to dismantle the remaining criminal organizations that plague the streets. The partnership proves to be effective, but they soon find themselves prey to a reign of chaos unleashed by a rising criminal mastermind known to the terrified citizens of Gotham as the Joker.\n                </div>\n            </div>\n            \n\n            <div class=\"w-1/2 z-0\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_900,h_450,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/3dc3a904-944d-4d61-9f0d-81f58b87574c/the-dark-knight.jpeg\" alt=\"Stratford, London outdoor screening of the-dark-knight.jpeg in London\" class=\"w-full h-[450px] object-cover rounded-2xl shadow-inner\">\n                \n                \n                \n            </div>\n        </div>\n    </div>\n</section>\n\n\n\n<div x-cloak x-show=\"show_trailer\" @keydown.escape.window=\"show_trailer = false\"\n     class=\"fixed inset-0 z-50 flex items-center justify-center p-4\">\n\n    <div class=\"absolute inset-0 bg-black/80\" @click=\"show_trailer = false\"></div>\n\n    <div class=\"relative w-full max-w-4xl z-10\" @click.stop>\n        <button @click=\"show_trailer = false\"\n                class=\"absolute -top-10 right-0 text-white hover:o