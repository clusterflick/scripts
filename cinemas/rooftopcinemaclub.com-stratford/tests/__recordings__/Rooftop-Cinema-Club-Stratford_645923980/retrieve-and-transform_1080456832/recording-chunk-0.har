          "content": {
            "mimeType": "text/html; charset=utf-8",
            "text": "<!doctype html>\n<html class=\"scroll-smooth antialiased\" lang=\"en\">\n    <head>\n        <meta charset=\"utf-8\">\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n        <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"theme-color\" content=\"#E95D40\">\n        \n        \n        <title>Rio - Carnival Party at Stratford, London &mdash; August 29, 2026 | Rooftop Cinema Club</title>\n<meta name=\"description\" content=\"Watch Rio - Carnival Party at Stratford, London on August 29, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:title\" content=\"Rio - Carnival Party at Stratford, London &mdash; August 29, 2026\" />\n<meta property=\"og:description\" content=\"Watch Rio - Carnival Party at Stratford, London on August 29, 2026. Outdoor rooftop cinema in London.\" />\n<meta property=\"og:url\" content=\"https://rooftopcinemaclub.com/uk/london/stratford/screenings/rio-carnival-party-2995\" />\n<meta property=\"og:site_name\" content=\"Rooftop Cinema Club\" />\n<meta property=\"og:locale\" content=\"en_GB\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"Rio - Carnival Party at Stratford, London &mdash; August 29, 2026\" />\n<meta name=\"twitter:description\" content=\"Watch Rio - Carnival Party at Stratford, London on August 29, 2026. Outdoor rooftop cinema in London.\" />\n<link href=\"https://rooftopcinemaclub.com/uk\" rel=\"home\" />\n<link href=\"https://rooftopcinemaclub.com/uk/london/stratford/screenings/rio-carnival-party-2995\" rel=\"canonical\" />\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Global Home\",\"item\":\"https://rooftopcinemaclub.com/uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"London\",\"item\":\"https://rooftopcinemaclub.com/uk/london\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Stratford, London\",\"item\":\"https://rooftopcinemaclub.com/uk/london/stratford\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Rio - Carnival Party\",\"item\":\"https://rooftopcinemaclub.com/uk/london/stratford/screenings/rio-carnival-party-2995\"}]}</script>\n<script type=\"application/ld+json\">{    \"@context\": \"https://schema.org\",    \"@type\": \"ScreeningEvent\",    \"@id\": \"https://rooftopcinemaclub.com/uk/london/stratford/screenings/rio-carnival-party-2995#event\",    \"name\": \"Rio - Carnival Party\",    \"url\": \"https://rooftopcinemaclub.com/uk/london/stratford/screenings/rio-carnival-party-2995\",    \"startDate\": \"2026-08-29T13:15:00+00:00\",            \"endDate\": \"2026-08-29T15:35:00+00:00\",            \"eventStatus\": \"https://schema.org/EventScheduled\",    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",    \"inLanguage\": \"en-GB\",    \"isAccessibleForFree\": false,    \"offers\": {        \"@type\": \"Offer\",        \"url\": \"https://rooftopcinemaclub.com/uk/london/stratford/screenings/rio-carnival-party-2995\",        \"availability\": \"https://schema.org/InStock\"    },        \"description\": \"Carnival weekend has landed on the rooftop. 💃✨ &nbsp; Before Rio hits the big screen, we're turning things all the way up with a samba workshop led by the iconic dancers from Brazilian Fantasy. &nbsp; No experience? Perfect. Just bring the energy. &nbsp; Come learn some moves, catch the rhythm, and get into full Carnival mode before settling in for a sky-high screening of Rio. &nbsp; 🎶 45 mins of samba vibes💃 Brazilian Fantasy dancers leading the way👩&zwj;👦&nbsp; All ages welcome🎬 Rio screening included &nbsp; Leave your embarrassment at the door. Feathers optional.&nbsp;\",                        \"image\": {        \"@type\": \"ImageObject\",        \"url\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/448f0738-43db-4a34-94c6-89d7fd394eeb/Rio_1920x1080.jpg\",        \"width\": 1920,        \"height\": 1080    },            \"workFeatured\": {        \"@type\": \"Movie\",        \"name\": \"Rio - Carnival Party\",                \"image\": \"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1920,h_1080,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/448f0738-43db-4a34-94c6-89d7fd394eeb/Rio_1920x1080.jpg\",        \"duration\": \"PT140M\",        \"dateCreated\": \"2011\"    },            \"location\": {        \"@type\": \"MovieTheater\",        \"@id\": \"https://rooftopcinemaclub.com/uk/london/stratford#venue\",        \"name\": \"Stratford, London\",        \"address\": {            \"@type\": \"PostalAddress\",            \"streetAddress\": \"Level 7, Roof East\",            \"postalCode\": \"E15 1XE\",            \"addressLocality\": \"London\",            \"addressCountry\": \"GB\"        },        \"geo\": {            \"@type\": \"GeoCoordinates\",            \"latitude\": 51.5416372,            \"longitude\": -0.0012586999999999        }    },        \"organizer\": {        \"@type\": \"Organization\",        \"@id\": \"https://rooftopcinemaclub.com/#organization\",        \"name\": \"Rooftop Cinema Club\",        \"url\": \"https://rooftopcinemaclub.com\"    },    \"performer\": {        \"@type\": \"Organization\",        \"@id\": \"https://rooftopcinemaclub.com/#organization\",        \"na