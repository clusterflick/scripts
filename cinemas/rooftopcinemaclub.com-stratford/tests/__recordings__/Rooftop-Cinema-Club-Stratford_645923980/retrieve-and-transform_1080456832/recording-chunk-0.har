e=\"currentColor\" stroke-width=\"2\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 6h16M4 12h16M4 18h16\" />\n                </svg>\n            </button>\n        </nav>\n    </div>\n</header>\n\n\n        <main id=\"content\" class=\"flex-1 flex flex-col\">\n            <div x-data=\"{\n    show_trailer: false,\n    get trailer_embed_url() {\n        let url = 'https://www.youtube.com/watch?v=P1GRO31ve5Q';\n        url = url.replace('watch?v=', 'embed/').replace('youtu.be/', 'www.youtube.com/embed/');\n        return url + (url.includes('?') ? '&' : '?') + 'autoplay=1';\n    }\n}\">\n<section class=\"relative w-full h-screen overflow-hidden\">\n    \n    \n    \n    <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_1600,h_900,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/448f0738-43db-4a34-94c6-89d7fd394eeb/Rio_1920x1080.jpg\" alt=\"Stratford, London outdoor screening of Rio_1920x1080.jpg in London\" fetchpriority=\"high\" class=\"absolute inset-0 w-full h-full object-cover\">\n    \n    \n    \n\n    <div class=\"absolute inset-0 bg-black/30\"></div>\n\n    <div class=\"absolute left-0 right-0 z-10 px-6 lg:px-12 bottom-[20%] md:bottom-[28%]\">\n        <div class=\"text-brand-white\">\n            <p class=\"text-xs md:text-lg mb-2 md:mb-3 flex items-center gap-2\">\n                Sat, Aug 29\n                <span class=\"text-brand-lavenderpink text-sm md:text-lg\">\n                    <svg width=\"19\" height=\"19\" viewBox=\"0 0 19 19\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M18.5929 12.0172L15.8036 9.5L18.5929 6.98282C19.4486 6.21064 18.8604 4.79245 17.7097 4.85021L13.9583 5.04173L14.1498 1.29028C14.2091 0.139614 12.7894 -0.44864 12.0172 0.407141L9.5 3.19641L6.98282 0.407141C6.21064 -0.44864 4.79245 0.139614 4.85021 1.29028L5.04173 5.04173L1.29028 4.85021C0.139614 4.79093 -0.44864 6.21064 0.407141 6.98282L3.19641 9.5L0.407141 12.0172C-0.44864 12.7894 0.139614 14.2076 1.29028 14.1498L5.04173 13.9583L4.85021 17.7097C4.79093 18.8604 6.21064 19.4486 6.98282 18.5929L9.5 15.8036L12.0172 18.5929C12.7894 19.4486 14.2076 18.8604 14.1498 17.7097L13.9583 13.9583L17.7097 14.1498C18.8604 14.2091 19.4486 12.7894 18.5929 12.0172Z\" fill=\"currentColor\"/>\n                    </svg>\n                </span>\n                1:15 PM\n            </p>\n\n            <h1 class=\"text-2xl md:text-5xl lg:text-6xl font-black uppercase leading-tight mb-3 md:mb-5 tracking-tight\">\n                Rio - Carnival Party\n            </h1>\n\n            <div class=\"flex items-center gap-3 md:gap-5\">\n                \n\n<button data-checkout-screening=\"6f8376de-8ce4-4bbb-8ab7-d6f66c1c4247\"\n        class=\"cursor-pointer inline-flex items-center justify-center rounded-full px-4 py-2 text-xs sm:px-5 sm:py-2.5 sm:text-sm md:px-6 md:py-2.5 md:text-[16px] font-bold border-2 border-transparent bg-brand-lavenderpink text-brand-navy transition-colors duration-150 hover:bg-brand-honey active:bg-brand-honey\">\n    Book\n</button>\n\n\n\n\n\n                \n                \n                <button @click=\"show_trailer = true\" class=\"flex items-center gap-1.5 md:gap-2 text-brand-white text-xs md:text-base font-medium hover:opacity-80 transition cursor-pointer\">\n                    <svg class=\"w-6 h-6 md:w-8 md:h-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" fill=\"none\"/>\n                        <path d=\"M10 8.5l6 3.5-6 3.5V8.5z\" fill=\"currentColor\" stroke=\"none\"/>\n                    </svg>\n                    Play Trailer\n                </button>\n                \n                \n            </div>\n\n            \n            <div class=\"flex flex-wrap gap-2 mt-4\">\n                \n                \n                <div class=\"text-center py-1 px-3 text-xs font-medium rounded\" style=\"background-color: #dbe1fd; color: #f9f4ee;\">Family-Friendly</div>\n                \n                \n                \n                \n            </div>\n            \n        </div>\n    </div>\n\n    <div class=\"absolute bottom-0 right-0 z-10 px-6 lg:px-12 pb-8 flex flex-col items-end gap-2\">\n        \n\n        \n\n        \n        <div class=\"flex flex-wrap gap-1 justify-end\">\n            \n            <span class=\"px-2 py-1 text-xs rounded bg-white text-brand-navy font-medium\">\n            Event\n        </span>\n            \n            <span class=\"px-2 py-1 text-xs rounded bg-white text-brand-navy font-medium\">\n            Alternative Events\n        </span>\n            \n        </div>\n        \n    </div>\n</section>\n\n<section class=\"w-[90%] bg-brand-honey rounded-lg py-16 px-12 mx-auto space-y-12 my-16\">\n    <h2 class=\"text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-brand-navy leading-tight\">\n        Screening Details\n    </h2>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-6 md:gap-y-10 mb-20 px-0 md:px-8\">\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Film</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\"><a href=\"/uk/films/rio-carnival-party\" class=\"underline\">Rio - Carnival Party</a></div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Venue</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\"><a href=\"/uk/london/stratford\" class=\"underline\">Stratford, London</a></div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Screen</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Screen 1</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Duration</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">140 Minutes</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        \n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Door Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">30 mins</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n        \n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Date</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Sat, Aug 29</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">1:15 PM</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Year</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">2011</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n    </div>\n\n    <div class=\"rounded-2xl p-10 text-brand-navy/80\">\n        <p>Carnival weekend has landed on the rooftop. 💃✨</p>\n<p>&nbsp;</p>\n<p>Before Rio hits the big screen, we're turning things all the way up with a samba workshop led by the iconic dancers from Brazilian Fantasy.</p>\n<p>&nbsp;</p>\n<p>No experience? Perfect. Just bring the energy.</p>\n<p>&nbsp;</p>\n<p>Come learn some moves, catch the rhythm, and get into full Carnival mode before settling in for a sky-high screening of Rio.</p>\n<p>&nbsp;</p>\n<p>🎶 45 mins of samba vibes<br>💃 Brazilian Fantasy dancers leading the way<br>👩&zwj;👦&nbsp; All ages welcome<br>🎬 Rio screening included</p>\n<p>&nbsp;</p>\n<p>Leave your embarrassment at the door. Feathers optional.&nbsp;</p>\n    </div>\n\n    <div class=\"mt-8\">\n\n        <div class=\"md:hidden relative\">\n            <div class=\"relative\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_400,h_300,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/448f0738-43db-4a34-94c6-89d7fd394eeb/Rio_1920x1080.jpg\" alt=\"Stratford, London outdoor screening of Rio_1920x1080.jpg in London\" class=\"w-[45%] aspect-[4/3] object-cover rounded-xl relative z-10 -ml-4 shadow-lg\">\n                \n                \n                \n            </div>\n\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-5 pt-10 -mt-6 relative z-0\">\n                <div class=\"prose prose-invert prose-sm leading-relaxed max-w-none\">\n                    1 OUT OF EVERY 8 AMERICANS ARE AFRAID OF FLYING. MOST OF THEM DON'T HAVE FEATHERS.\r\nCaptured by smugglers when he was just a hatchling, a macaw named Blu never learned to fly and lives a happily domesticated life in Minnesota with his human friend, Linda. Blu is thought to be the last of his kind, but when word comes that Jewel, a lone female, lives in Rio de Janeiro, Blu and Linda go to meet her. Animal smugglers kidnap Blu and Jewel, but the pair soon escape and begin a perilous adventure back to freedom – and Linda.\n                </div>\n            </div>\n            \n        </div>\n\n        <div class=\"hidden md:flex relative flex-row items-center gap-0 min-h-[350px]\">\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-10 w-1/2 z-10 relative -mr-12 shadow-2xl\">\n                <div class=\"prose prose-invert prose-lg leading-relaxed max-w-none\">\n                    1 OUT OF EVERY 8 AMERICANS ARE AFRAID OF FLYING. MOST OF THEM DON'T HAVE FEATHERS.\r\nCaptured by smugglers when he was just a hatchling, a macaw named Blu never learned to fly and lives a happily domesticated life in Minnesota with his human friend, Linda. Blu is thought to be the last of his kind, but when word comes that Jewel, a lone female, lives in Rio de Janeiro, Blu and Linda go to meet her. Animal smugglers kidnap Blu and Jewel, but the pair soon escape and begin a perilous adventure back to freedom – and Linda.\n                </div>\n            </div>\n            \n\n            <div class=\"w-1/2 z-0\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_900,h_450,c_fill,g_xy_center,x_960,y_540,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/448f0738-43db-4a34-94c6-89d7fd394eeb/Rio_1920x1080.jpg\" alt=\"Stratford, London outdoor screening of Rio_1920x1080.jpg in London\" class=\"w-full h-[450px] object-cover rounded-2xl shadow-inner\">\n                \n                \n                \n            </div>\n        </div>\n    </div>\n</section>\n\n\n\n<div x-cloak x-show=\"show_trailer\" @keydown.escape.window=\"show_trailer = false\"\n     class=\"fixed inset-0 z-50 flex items-center justify-center p-4\">\n\n    <div class=\"absolute inset-0 bg-black/80\" @click=\"show_trailer = false\"></div>\n\n    <div class=\"relative w-full max-w-4xl z-10\" @click.stop>\n        <button @click=\"show_trailer = false\"\n                class=\"absolute -top-10 right-0 text-white hover:opacity-80 cursor-pointer\">\n            <svg class=\"w-8 h-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\"/>\n            </svg>\n        </button>\n\n        <div class=\"relative w-full\" style=\"padding-bottom: 56.25%\">\n            <template x-if=\"show_trailer\">\n                <iframe\n                    :src=\"trailer_embed_url\"\n                    class=\"absolute inset-0 w-full h-full rounded-xl\"\n                    frameborder=\"0\"\n                    allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n                    allowfullscreen>\n                </iframe>\n            </template>\n        </div>\n    </div>\n</div>\n\n\n\n</div>\n\n\n\n        </main>\n\n        <div id=\"tickets-checkout-root\"></div>\n        <div id=\"gift-card-checkout-root\"></div>\n\n        <div id=\"modals-root\"></div>\n\n        <footer class=\"w-full bg-brand-red text-brand-white px-4 md:px-12 py-12\">\n\n    <div class=\"flex flex-col gap-3 mb-12 items-start\">\n        \n            <div>\n                <div class=\"inline-flex justify-start items-center\">\n                    <a href=\"/uk/locations\">\n                        <img src=\"/images/Rooftop_Cinema_Logo_Cream.svg\" alt=\"Rooftop Cinema Club\" class=\"h-10 md:h-20\">\n                    </a>\n\n                    <div class=\"flex flex-col justify-start items-center gap-2 border-l border-l-white ml-4 pl-4\">\n                        <span class=\"text-white font-heading text-[10px] md:text-sm leading-none uppercase\">in partnership with</span>\n                        <svg class=\"w-28 md:w-32\" xml:space=\"preserve\" viewBox=\"0 0 1033.143 564.983\"><path fill=\"white\" d=\"m945.022 304.383-.004.004-4.762.004c-1.174 0-2.272.353-3.332 1.435-1.315 1.344-1.515 3.068-1.197 4.754 3.863 20.609 5.852 40.725 6.502 59.701h-59.77c-1.35 0-2.467.478-3.36 1.362-.94.93-1.521 2.114-1.52 4.058l.005 17.154c.002 3.414 2.352 5.32 5.188 5.32h59.437c-.444 13.108-1.46