center gap-4 text-sm min-w-0\">\n                        <span class=\"flex items-baseline gap-1 font-semibold min-w-0\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4 shrink-0 self-center\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z\" />\n                            </svg>\n                            <span class=\"truncate\" x-text=\"`${customer.first_name} ${customer.last_name}`\"></span>\n                        </span>\n                        <div class=\"flex items-center shrink-0\">\n                            <a href=\"/uk/account\" class=\"border-b border-brand-white/50 hover:opacity-80 transition\">my account</a>\n                        </div>\n                    </div>\n                </template>\n\n                <template x-if=\"!customer\">\n                    <div class=\"flex items-center gap-2 text-sm\">\n                        <a href=\"/uk/account/login\" class=\"border-b border-brand-white/50 hover:opacity-80 transition\">log in</a>\n                        <span class=\"flex items-center gap-4 shrink-0\">or</span>\n                        <a href=\"/uk/account/register\" class=\"border-b border-brand-white/50 hover:opacity-80 transition\">sign up</a>\n                    </div>\n                </template>\n\n                <button\n                    @click=\"menu_open = false\"\n                    type=\"button\"\n                    class=\"ml-auto shrink-0 w-10 h-10 flex items-center justify-center text-brand-lavender hover:opacity-80 transition cursor-pointer\"\n                >\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"27\" height=\"27\">\n                        <g clip-path=\"url(#modal-close-a)\">\n                            <path fill=\"#C7A2F9\" d=\"M27 6.75