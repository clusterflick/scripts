mb-20 px-0 md:px-8\">\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Film</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\"><a href=\"/uk/films/twilight\" class=\"underline\">Twilight</a></div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Venue</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\"><a href=\"/uk/london/stratford\" class=\"underline\">Stratford, London</a></div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Screen</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Screen 1</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Duration</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">122 Minutes</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        \n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Door Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">30 mins</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n        \n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Date</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Tue, Aug 25</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">8:55 PM</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Year</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">2008</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n    </div>\n\n    <div class=\"rounded-2xl p-10 text-brand-navy/80\">\n        \n    </div>\n\n    <div class=\"mt-8\">\n\n        <div class=\"md:hidden relative\">\n            <div class=\"relative\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_400,h_300,c_fill,g_xy_center,x_640,y_360,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/dc3d2a52-2e0e-4621-8da8-81b3aa922487/Twilight.jpeg\" alt=\"Stratford, London outdoor screening of Twilight.jpeg in London\" class=\"w-[45%] aspect-[4/3] object-cover rounded-xl relative z-10 -ml-4 shadow-lg\">\n                \n                \n                \n            </div>\n\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-5 pt-10 -mt-6 relative z-0\">\n                <div class=\"prose prose-invert prose-sm leading-relaxed max-w-none\">\n                    Bella Swan is an average teenager who often goes unnoticed. However, her life changes for the better when she meets Edward Cullen, a vampire with dreamy eyes and skin that sparkles in sunlight.\n                </div>\n            </div>\n            \n        </div>\n\n        <div class=\"hidden md:flex relative flex-row items-center gap-0 min-h-[350px]\">\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-10 w-1/2 z-10 relative -mr-12 shadow-2xl\">\n                <div class=\"prose prose-invert prose-lg leading-relaxed max-w-none\">\n                    Bella Swan is an average teenager who often goes unnoticed. However, her life changes for the better when she meets Edward Cullen, a vampire with dreamy eyes and skin that sparkles in sunlight.\n                </div>\n            </div>\n            \n\n            <div class=\"w-1/2 z-0\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_900,h_450,c_fill,g_xy_center,x_640,y_360,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/dc3d2a52-2e0e-4621-8da8-81b3aa922487/Twilight.jpeg\" alt=\"Stratford, London outdoor screening of Twilight.jpeg in London\" class=\"w-full h-[450px] object-cover rounded-2xl shadow-inner\">\n                \n                \n                \n            </div>\n        </div>\n    </div>\n</section>\n\n\n\n<div x-cloak x-show=\"show_trailer\" @keydown.escape.window=\"show_trailer = false\"\n     class=\"fixed inset-0 z-50 flex items-center justify-center p-4\">\n\n    <div class=\"absolute inset-0 bg-black/80\" @click=\"show_trailer = false\"></div>\n\n    <div class=\"relative w-full max-w-4xl z-10\" @click.stop>\n        <button @click=\"show_trailer = false\"\n                class=\"absolute -top-10 right-0 text-white hover:opacity-80 cursor-pointer\">\n            <svg class=\"w-8 h-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\"/>\n            </svg>\n        </button>\n\n        <div class=\"relative w-full\" style=\"padding-bottom: 56.25%\">\n            <template x-if=\"show_trailer\">\n                <iframe\n                    :src=\"trailer_embed_url\"\n                    class=\"absolute inset-0 w-full h-full rounded-xl\"\n                    frameborder=\"0\"\n                    allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n                    allowfullscreen>\n                </iframe>\n            </template>\n        </div>\n    </div>\n</div>\n\n\n\n</div>\n\n\n\n        </main>\n\n        <div id=\"tickets-checkout-root\"></div>\n        <div id=\"gift-card-checkout-root\"></div>\n\n        <div id=\"modals-root\"></div>\n\n        <footer class=\"w-full bg-brand-red text-brand-white px-4 md:px-12 py-12\">\n\n    <div class=\"flex flex-col gap-3 mb-12 items-start\">\n        \n            <div>\n                <div class=\"inline-flex justify-start items-center\">\n                    <a href=\"/uk/locations\">\n                        <img src=\"/images/Rooftop_Cinema_Logo_Cream.svg\" alt=\"Rooftop Cinema Club\" class=\"h-10 md:h-20\">\n                    </a>\n\n                    <div class=\"flex flex-col justify-start items-center gap-2 border-l border-l-white ml-4 pl-4\">\n                        <span class=\"text-white font-heading text-[10px] md:text-sm leading-none uppercase\">in partnership with</span>\n                        <svg class=\"w-28 md:w-32\" xml:space=\"preserve\" viewBox=\"0 0 1033.143 564.983\"><path fill=\"white\" d=\"m945.022 304.383-.004.004-4.762.004c-1.174 0-2.272.353-3.332 1.435-1.315 1.344-1.515 3.068-1.197 4.754 3.863 20.609 5.852 40.725 6.502 59.701h-59.77c-1.35 0-2.467.478-3.36 1.362-.94.93-1.521 2.114-1.52 4.058l.005 17.154c.002 3.414 2.352 5.32 5.188 5.32h59.437c-.444 13.108-1.468 25.43-2.867 36.454a407 407 0 0 1-3.687 23.545c-.258 2.058.286 3.354 1.281 4.457 1.188 1.19 2.573 1.474 4.205 1.473l5.93-.008 9.222.008a7.12 7.12 0 0 0 5.135-2.153c1.538-1.579 1.802-3.268 1.969-4.242a439 439 0 0 0 3.322-22.938c1.299-11.067 2.247-23.436 2.658-36.595h58.573c2.835 0 5.186-1.907 5.187-5.32l.006-17.155c0-1.944-.58-3.129-1.52-4.058-.893-.884-2.01-1.362-3.36-1.362H969.39a435 435 0 0 0-2.52-35.105 423 423 0 0 0-3.517-24.613c-.294-1.686-.876-3.366-2.61-4.715-1.147-.894-2.742-1.457-3.818-1.457l-8.