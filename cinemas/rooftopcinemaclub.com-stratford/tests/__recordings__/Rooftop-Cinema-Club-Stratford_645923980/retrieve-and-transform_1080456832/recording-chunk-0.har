les/dtla\" class=\"text-sm text-brand-white font-light hover:underline\">DTLA, Los Angeles</a>\n                    </li>\n                    \n                </ul>\n            </div>\n            \n            <div>\n                <a href=\"/us/miami-beach\" class=\"block text-sm font-bold mb-1 hover:underline\">Miami Beach</a>\n                <ul class=\"space-y-1\">\n                    \n                    <li>\n                        <a href=\"/us/miami-beach/south-beach\" class=\"text-sm text-brand-white font-light hover:underline\">South Beach, Miami</a>\n                    </li>\n                    \n                </ul>\n            </div>\n            \n            <div>\n                <a href=\"/us/new-york\" class=\"block text-sm font-bold mb-1 hover:underline\">New York</a>\n                <ul class=\"space-y-1\">\n                    \n                    <li>\n                        <a href=\"/us/new-york/midtown\" class=\"text-sm text-brand-white font-light hover:underline\">Midtown, New York</a>\n                    </li>\n                    \n                </ul>\n            </div>\n            \n            <div>\n                <a href=\"/us/san-diego\" class=\"block text-sm font-bold mb-1 hover:underline\">San Diego</a>\n                <ul class=\"space-y-1\">\n                    \n                    <li>\n                        <a href=\"/us/san-diego/little-italy\" class=\"text-sm text-brand-white font-light hover:underline\">Little Italy, San Diego</a>\n                    </li>\n                    \n                </ul>\n            </div>\n            \n        </div>\n    </div>\n    \n\n    \n    <div>\n        <a href=\"/uk/locations\" class=\"inline-flex items-center flex-wrap gap-x-2 gap-y-1 text-sm font-bold tracking-wider uppercase mb-5 hover:opacity-90 transition\">\n            <span>United Kingdom</span>\n            <svg viewBox=\"0 0 29 28\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 