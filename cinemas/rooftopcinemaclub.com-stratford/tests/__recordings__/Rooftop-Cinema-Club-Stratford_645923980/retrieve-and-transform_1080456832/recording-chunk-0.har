 gap-2 py-2 border-b border-brand-navy/40 cursor-pointer\">\n                        <span class=\"text-sm md:text-base text-brand-navy\">More Details</span>\n                        <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"none\" viewBox=\"0 0 32 32\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path d=\"M26.667 21.333C29.6124 21.3332 32 23.7216 32 26.667C31.9998 29.6123 29.6123 31.9998 26.667 32H5.33301C2.38774 31.9998 0.000173164 29.6123 0 26.667C0 23.7216 2.38764 21.3332 5.33301 21.333C2.38764 21.3328 0 18.9454 0 16C2.57701e-06 13.0546 2.38764 10.6672 5.33301 10.667C2.38764 10.6668 0 8.27842 0 5.33301C0.000178318 2.38775 2.38775 0.000178659 5.33301 0H26.667C29.6123 0.000176597 31.9998 2.38775 32 5.33301C32 8.27842 29.6124 10.6668 26.667 10.667C29.6124 10.6672 32 13.0546 32 16C32 18.9454 29.6124 21.3328 26.667 21.333Z\" fill=\"#5C9AC6\"/>\n                            <path d=\"M10.5 16H21.5\" stroke=\"#F9F4EE\" stroke-linecap=\"round\" stroke-width=\"2\"/>\n                            <path d=\"M16 10.5V21.5\" stroke=\"#F9F4EE\" stroke-linecap=\"round\" stroke-width=\"2\"/>\n                        </svg>\n                    </button>\n                </div>\n\n                <div class=\"col-span-2 md:col-span-1 md:col-start-3 md:row-start-1 md:row-span-2 flex items-start\">\n                    \n                    <button data-checkout-screening=\"0c7886d3-3714-4655-8d82-8b2d361c6182\" class=\"flex items-center justify-between w-full px-5 py-3 md:py-2.5 bg-brand-navy text-brand-white text-sm font-bold rounded-full hover:bg-brand-navy/90 transition-colors cursor-pointer\">\n                        <span>BOOK</span>\n                        <span class=\"flex items-center gap-1.5 text-xs font-normal ml-4\">\n                            <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n                      