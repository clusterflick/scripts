ap items-center gap-x-3 gap-y-1 mb-2 text-brand-navy/80\">\n                        <div class=\"flex items-center gap-1.5 text-xs font-medium\">\n                            <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/>\n                            </svg>\n                            <span>Sun, Sep 6</span>\n                        </div>\n                        \n                        <div class=\"flex items-center gap-1.5 text-xs font-medium\">\n                            <svg class=\"w-3.5 h-3.5 shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n                            <span>6:45 PM</span>\n                        </div>\n                        \n                        \n                        <div class=\"flex items-center gap-1.5 text-xs font-medium\">\n                            <svg class=\"w-3.5 h-3.5 shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" viewBox=\"0 0 24 24\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3\"/>\n                            </svg>\n                            <span>Doors open at <span>6:00 PM</span></span>\n                        </div>\n                        \n                        \n                        <div class=\"flex items-center gap-1.5 text-xs font-medium\">\n                            <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17.657 16.6