xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Door Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">60 mins</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n        \n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Date</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">Fri, Aug 28</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Time</h2>\n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">6:30 PM</div>\n            <hr class=\"border-brand-navy/30\">\n        </div>\n\n        <div>\n            <h2 class=\"text-xl md:text-2xl font-bold text-brand-navy uppercase tracking-wide mb-1\">Year</h2>\n            \n            <div class=\"text-sm md:text-base text-brand-navy/80 mb-4\">2014</div>\n            \n            <hr class=\"border-brand-navy/30\">\n        </div>\n    </div>\n\n    <div class=\"rounded-2xl p-10 text-brand-navy/80\">\n        \n    </div>\n\n    <div class=\"mt-8\">\n\n        <div class=\"md:hidden relative\">\n            <div class=\"relative\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_400,h_300,c_fill,g_xy_center,x_500,y_334,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/046c619b-1190-49ef-b6ce-e07005a23227/MV5BMTkyMzIwMDMyNV5BMl5BanBnXkFtZTgwNzEzOTE0MjE@._V1_.jpg\" alt=\"Stratford, London outdoor screening of MV5BMTkyMzIwMDMyNV5BMl5BanBnXkFtZTgwNzEzOTE0MjE@._V1_.jpg in London\" class=\"w-[45%] aspect-[4/3] object-cover rounded-xl relative z-10 -ml-4 shadow-lg\">\n                \n                \n                \n            </div>\n\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-5 pt-10 -mt-6 relative z-0\">\n                <div class=\"prose prose-invert prose-sm leading-relaxed max-w-none\">\n                    Rosie and Alex have been friends since childhood and cannot imagine themselves as a couple. However, when they head in different directions, they realise that they are made for each other.\n                </div>\n            </div>\n            \n        </div>\n\n        <div class=\"hidden md:flex relative flex-row items-center gap-0 min-h-[350px]\">\n            \n            <div class=\"bg-brand-navy text-brand-white rounded-2xl p-10 w-1/2 z-10 relative -mr-12 shadow-2xl\">\n                <div class=\"prose prose-invert prose-lg leading-relaxed max-w-none\">\n                    Rosie and Alex have been friends since childhood and cannot imagine themselves as a couple. However, when they head in different directions, they realise that they are made for each other.\n                </div>\n            </div>\n            \n\n            <div class=\"w-1/2 z-0\">\n                \n                \n                \n                <img src=\"https://res.cloudinary.com/dpgypjrov/image/fetch/f_auto,w_900,h_450,c_fill,g_xy_center,x_500,y_334,q_auto/https://d31ni94nh7toh0.cloudfront.net/PRODUCTION/films/046c619b-1190-49ef-b6ce-e07005a23227/MV5BMTkyMzIwMDMyNV5BMl5BanBnXkFtZTgwNzEzOTE0MjE@._V1_.jpg\" alt=\"Stratford, London outdoor screening of MV5BMTkyMzIwMDMyNV5BMl5BanBnXkFtZTgwNzEzOTE0MjE@._V1_.jpg in London\" class=\"w-full h-[450px] object-cover rounded-2xl shadow-inner\">\n                \n                \n                \n            </div>\n        </div>\n    </div>\n</section>\n\n\n\n<div x-cloak x-show=\"show_trailer\" @keydown.escape.window=\"show_trailer = false\"\n     class=\"fixed inset-0 z-50 flex items-center justify-center p-4\">\n\n    <div class=\"absolute inset-0 bg-black/80\" @click=\"show_trailer = false\"></div>\n\n    <div class=\"relative w-full max-w-4xl z-10\" @click.stop>\n      