gories\":[{\"areaCategoryId\":\"838-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000187\",\"0000000147\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"838\",\"name\":{\"text\":\"Swiss Cottage\",\"translations\":[]},\"location\":{\"latitude\":51.5425,\"longitude\":-0.1745},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.swisscottage@OdeonUK.com\",\"address\":{\"line1\":\"96 Finchley Road\",\"line2\":\"Swiss Cottage\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008184\",\"title\":{\"text\":\"National Theatre Live: The Audience (Rerelease)\",\"translations\":[]},\"synopsis\":{\"text\":\"Returning to cinemas for the first time in over a decade, Helen Mirren plays Queen Elizabeth II in the Olivier and Tony Award® -winning hit production, directed by Stephen Daldry. For 60 years, Queen Elizabeth II met with each of her 12 prime ministers in a private weekly meeting. This meeting is known as The Audience. From Winston Churchill to Margaret Thatcher and David Cameron, the Queen advised her prime ministers on matters both public and personal. Through these private audiences, we see glimpses of the woman behind the crown and witness the moments that shaped a monarch. Peter Morgan’s Netflix phenomenon The Crown was based on this hit play that was captured live from London’s West End in 2013 and went on to become one of the most-watched NT Live productions.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Academy Award-winner Helen Mirren plays Queen Elizabeth II in the much-anticipated return of the Olivier Award–winning hit production, that inspired Netflix’s The Crown.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-26\",\"runtimeInMinutes\":180,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000328\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000004641\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017347\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017348\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000137\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000447\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000039\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9131253f-ec7c-4f61-b9e3-bbea8ddf1cd3\",\"corporateId\":null},\"hopk\":\"HO00008184\",\"hoCode\":\"A000009276\",\"eventId\":\"0000000001\",\"distributorName\":\"National Theatre\"},{\"id\":\"HO00008387\",\"title\":{\"text\":\"Twenty One Pilots: More Than We Ever Imagined\",\"translations\":[]},\"synopsis\":{\"text\":\"Experience the electrifying concert film capturing Twenty One Pilots at a career-defining moment: their monumental Mexico City headline show, performing in front of 65,000 fans at Estadio GNP Seguros during The Clancy World Tour. \\n\\nSet against the vibrant pulse of one of the world’s most iconic music capitals, the film blends cinematic high-energy performance footage with intimate, behind-the-scenes access, revealing the heart, humor, and humanity of the artists as they prepare for one of the biggest shows of their career. \\n\\nViewers follow the band from their arrival in Mexico City to the stage, sharing in the preparation and anticipation that build as showtime approaches. Exclusive commentary from Tyler and Josh offer personal reflections on the journey that brought them to this historic stage and the deep connection with their fans who make it all possible.\\n\\nThe film pulls audiences into the full spectacle of the night. Sweeping aerials of the stadium, on-stage cameras, and crowd-level shots place viewers right at the center of the experience, seeing the show from every angle.  The result is a thrilling, emotional celebration of music, community, and achievement - an unforgettable portrait of Twenty One Pilots, performing a show that will echo through their legacy.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Experience the electrifying concert film capturing Twenty One Pilots at a career-defining moment: their monumental Mexico City headline show.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-25\",\"runtimeInMinutes\":119,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000005569\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005570\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013680\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017715\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017716\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017717\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017718\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a81251d1-868e-4b61-bbc3-6f1257804775\",\"corporateId\":null},\"hopk\":\"HO00008387\",\"hoCode\":\"A000009489\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000000328\",\"name\":{\"givenName\":\"Stephen\",\"familyName\":\"Daldry\",\"middleName\":null}},{\"id\":\"0000004641\",\"name\":{\"givenName\":\"Paul\",\"familyName\":\"Ritter\",\"middleName\":null}},{\"id\":\"0000017347\",\"name\":{\"givenName\":\"Edward\",\"familyName\":\"Fox\",\"middleName\":null}},{\"id\":\"0000017348\",\"name\":{\"givenName\":\"Daniel\",\"familyName\":\"McCabe\",\"middleName\":null}},{\"id\":\"HO00000137\",\"name\":{\"givenName\":\"Helen\",\"familyName\":\"Mirren\",\"middleName\":null}},{\"id\":\"HO00000447\",\"name\":{\"givenName\":\"National Theatre\",\"familyName\":\"Live\",\"middleName\":null}},{\"id\":\"0000005569\",\"name\":{\"givenName\":\"Tyler\",\"familyName\":\"Joseph\",\"middleNa