reaCategoryId\":\"838-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"838-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"838\",\"name\":{\"text\":\"Swiss Cottage\",\"translations\":[]},\"location\":{\"latitude\":51.5425,\"longitude\":-0.1745},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.swisscottage@OdeonUK.com\",\"address\":{\"line1\":\"96 Finchley Road\",\"line2\":\"Swiss Cottage\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007533\",\"title\":{\"text\":\"Avatar: Fire and Ash\",\"translations\":[]},\"synopsis\":{\"text\":\"Jake and Neytiri's family grapples with grief after Neteyam's death, encountering a new, aggressive Na'vi tribe, the Ash People, who are led by the fiery Varang, as the conflict on Pandora escalates and a new moral focus emerges.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Jake and Neytiri's family grapples with grief after Neteyam's death, encountering a new, aggressive Na'vi tribe, the Ash People, who are led by the fiery Varang.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-19\",\"runtimeInMinutes\":197,\"trailerUrl\":null,\"displayPriority\":8,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000560\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002207\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002294\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005786\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005787\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007837\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17711\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17712\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17713\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000042\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000349\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000696\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002427\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000010\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a4cb369f-77c4-4fe1-8f85-dd5e76b195dd\",\"corporateId\":null},\"hopk\":\"HO00007533\",\"hoCode\":\"A000008563\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008012\",\"title\":{\"text\":\"The Housemaid\",\"translations\":[]},\"synopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous — a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, sex, sexual violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-12-22\",\"runtimeInMinutes\":131,\"trailerUrl\":\"https://www.youtube.com/watch?v=kdDdlY2VPxw\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000009161\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012707\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016976\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016977\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000031\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000135\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000814\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001305\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dc7be94d-5ba5-4a79-accd-48ed4d19a3b6\",\"corporateId\":null},\"hopk\":\"HO00008012\",\"hoCode\":\"A000009092\",\"eventId\":null,\"distributorName\":\"LIONSGATE INTERNATIONAL\"},{\"id\":\"HO00008014\",\"title\":{\"text\":\"Anaconda\",\"translations\":[]},\"synopsis\":{\"text\":\"Doug (Jack Black) and Griff (Paul Rudd) have been best friends since they were kids, and have always dreamed of remaking their all-time favourite movie: the cinematic \\\"classic\\\" Anaconda. When a midlife crisis pushes them to finally go for it, they head deep into the Amazon to start filming. But things get real when an actual giant anaconda appears, turning their comically chaotic movie set into a deadly situation. The movie they’re dying to make? It might just get them killed......\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Doug (Jack Black) and Griff (Paul Rudd) have been best friends since they were kids, and have always dreamed of remaking their all-time favourite movie..\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-25\",\"runtimeInMinutes\":99,\"trailerUrl\":\"https://www.youtube.com/watch?v=c1AvAE_AMdo\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000223\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000224\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002845\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004772\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000012329\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014628\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016978\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000101\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000928\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002663\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c37a28f1-30f5-4bb7-a75b-289ae4f5db56\",\"corporateId\":null},\"hopk\":\"HO00008014\",\"hoCode\":\"A000009094\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008080\",\"title\":{\"text\":\"Hamnet\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"distressing scenes, brief moderate sex\",\"translations\":[]},\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":126,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003903\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011027\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017134\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000116\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000321\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000322\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001794\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001974\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000005\"],\"externalIds\":{\"moviexchangeReleaseId\":\"37b2b94f-65a0-481e-9d3c-bde2445c99a4\",\"corporateId\":null},\"hopk\":\"HO00008080\",\"hoCode\":\"A000009165\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008082\",\"title\":{\"text\":\"The History of Sound\",\"translations\":[]},\"synopsis\":{\"text\":\"In 1917, Lionel — a young, talented music student — meets David at the Boston Conservatory, where they bond over a deep love of folk music. Years later, Lionel receives a letter from David, leading to an impromptu journey through the backwoods of Maine to collect traditional songs. This unexpected reunion, ensuing love affair, and the music they collect and preserve, will shape the course of Lionel’s life far beyond his own awareness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Two young men during World War I set out to record the lives, voices and music of their American countrymen.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"brief strong sex\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":128,\"trailerUrl\":\"https://www.youtube.com/watch?v=E2PSkw8BI7k\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004598\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000007165\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000007355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010579\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010990\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017135\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017136\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017137\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017138\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017139\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017140\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017141\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000224\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\",\"0000000018\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5916d744-923e-430d-9c44-1892f33b6e58\",\"corporateId\":null},\"hopk\":\"HO00008082\",\"hoCode\":\"A000009167\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008101\",\"title\":{\"text\":\"Marty Supreme\",\"translations\":[]},\"synopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, sex, nudity, injury detail, violence\",\"translations\":[]},\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":150,\"trailerUrl\":\"https://www.youtube.com/watch?v=s9gSuKaKcqM\",\"displayPriority\":7,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001370\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012950\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014188\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014753\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017170\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017171\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"17172\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17173\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17174\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"2227\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000258\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"90e71dd1-a916-4807-8aff-0dd9f141e72d\",\"corporateId\":null},\"hopk\":\"HO00008101\",\"hoCode\":\"A000009187\",\"eventId\":null,\"distributorName\":\"ENTERTAINMENT FILM DISTRIBUTOR\"},{\"id\":\"HO00008189\",\"title\":{\"text\":\"28 Years Later: The Bone Temple\",\"translations\":[]},\"synopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later: The Bone Temple. In a continuation of the epic story, Dr. Kelson (Ralph Fiennes) finds himself in a shocking new relationship - with consequences that could change the world as they know it - and Spike's (Alfie Williams) encounter with Jimmy Crystal (Jack O'Connell) becomes a nightmare he can't escape. In the world of The Bone Temple, the infected are no longer the greatest threat to survival - the inhumanity of the survivors can be stranger and more terrifying.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong gory violence, injury detail, very strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-14\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=wyYliP8dPWU\",\"displayPriority\":9,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000097\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000442\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002404\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002653\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005575\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014011\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014577\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017356\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000576\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"12790418-6492-492a-814c-53673bc1ab1a\",\"corporateId\":null},\"hopk\":\"HO00008189\",\"hoCode\":\"A000009281\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008191\",\"title\":{\"text\":\"Rental Family\",\"translations\":[]},\"synopsis\":{\"text\":\"A down-and-out actor living in Tokyo is hired as a token American guy for a Japanese rental-family company, leading him on an unexpected journey of self-discovery through the roles he plays in other people’s lives.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A down-and-out actor living in Tokyo is hired as a token American guy for a Japanese rental-family company, leading him on an unexpected journey of self-discovery.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-16\",\"runtimeInMinutes\":110,\"trailerUrl\":\"https://www.youtube.com/watch?v=sZT37sM2VgE\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007702\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008791\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008792\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017357\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017358\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017359\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017360\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017361\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"2617\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a2ea80c3-a876-47ff-9c5c-0cddaeae7ddd\",\"corporateId\":null},\"hopk\":\"HO00008191\",\"hoCode\":\"A000009283\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008327\",\"title\":{\"text\":\"No Other Choice\",\"translations\":[]},\"synopsis\":{\"text\":\"Man-su (Lee Byung Hun), a specialist in paper manufacturing with 25 years of experience, is so satisfied with life that he can truthfully tell himself, “I’ve got it all.” While happily passing his days with his wife Miri (Son Yejin), their two children and two dogs, Man-su is suddenly informed by his company that he has been fired.\\n“We’re sorry. We have no other choice.”\\nFeeling shocked as if his head had been cut off by an ax, Man-su vows to find himself a new job within the next three months for the sake of his family. Despite his firm resolve to turn his life around, Man-su spends over a year drifting from one job interview after another, and working at a retail store. He eventually finds himself in danger of losing the very house that he struggled so hard to buy.\\nDesperate, he visits Moon Paper out of the blue and tries to hand over his CV, but he just ends up getting humiliated by line manager Choi Sun-chul (Park Hee Soon). Man-su knows he is better qualified than anyone to work at Moon Paper, so he comes to a certain decision.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, violence, injury detail, sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":139,\"trailerUrl\":null,\"displayPriority\":13,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000010701\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016863\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017619\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017620\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017621\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017622\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000009\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e660de4a-88af-472a-a1e1-57ffb9dcbb49\",\"corporateId\":null},\"hopk\":\"HO00008327\",\"hoCode\":\"A000009425\",\"eventId\":null,\"distributorName\":\"MUBI UK Ltd\"},{\"id\":\"HO00008329\",\"title\":{\"text\":\"H is for Hawk\",\"translations\":[]},\"synopsis\":{\"text\":\"When Helen's beloved father passes away, she is knocked sideways by grief and loses herself in memories of their time birding and exploring the natural world together. She becomes obsessed with the idea of training her own goshawk, and so she brings the fearsome bird Mabel home to her life as a graduate fellow at Cambridge. Helen fills the freezer with hawk food and turns off her phone, ready to embark on the long, strange business of trying to train this wildest of animals. But as she labours to tame Mabel, a grieving Helen undergoes an untaming of her own. A record of a spiritual journey, H IS FOR HAWK is a story about memory and nature and how it might be possible to reconcile death with life and love.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When Helen's beloved father passes away, she is knocked sideways by grief and loses herself in memories of their time birding and exploring the natural world together.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"infrequent strong language, drug misuse, injury detail, sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=RJ29BBXfN64\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000389\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000000808\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004579\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017009\",\"roles\":[\"A