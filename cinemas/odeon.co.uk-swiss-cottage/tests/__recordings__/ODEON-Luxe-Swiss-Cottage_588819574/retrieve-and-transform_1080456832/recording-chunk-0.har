            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-04-16\",\"showtimes\":[{\"id\":\"838-34660\",\"schedule\":{\"businessDate\":\"2026-04-16\",\"startsAt\":\"2026-04-16T19:00:00+01:00\",\"endsAt\":\"2026-04-16T21:40:00+01:00\",\"filmStartsAt\":\"2026-04-16T19:25:00+01:00\",\"filmEndsAt\":\"2026-04-16T21:40:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"838-2-39\",\"filmId\":\"HO00008389\",\"siteId\":\"838\",\"screenId\":\"838-2\",\"areaCategories\":[{\"areaCategoryId\":\"838-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"838-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"838-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"838\",\"name\":{\"text\":\"Swiss Cottage\",\"translations\":[]},\"location\":{\"latitude\":51.5425,\"longitude\":-0.1745},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.swisscottage@OdeonUK.com\",\"address\":{\"line1\":\"96 Finchley Road\",\"line2\":\"Swiss Cottage\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008389\",\"title\":{\"text\":\"NT Live: All My Sons\",\"translations\":[]},\"synopsis\":{\"text\":\"Bryan Cranston (Breaking Bad) and Marianne Jean-Baptiste (Hard Truths) feature in a five-star, triumphantly acclaimed new production of Arthur Miller’s classic play, from visionary director Ivo Van Hove (A View from the Bridge).    One family, the heart of the American dream. When wartime delivers profits for Joe, it comes at a price when his partner is charged with criminal manufacturing deals, and his eldest son goes missing in action. Will peacetime bring peace of mind, or will he be confronted by the consequence of his actions?    Filmed live from the West End, Paapa Essiedu (I May Destroy You), Tom Glynn-Carney (House of the Dragon), and Hayley Squires (I, Daniel Blake) also feature in this disturbingly prescient play. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Bryan Cranston and Marianne Jean-Baptiste feature in a five-star, triumphantly acclaimed new production of Arthur Miller’s classic play.  \",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-04-16\",\"runtimeInMinutes\":135,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001247\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003696\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000004386\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005574\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001680\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002669\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000039\"],\"externalIds\":{\"moviexchangeReleaseId\":\"56717cc4-bc77-4669-b0bd-9e23b770a989\",\"corporateId\":null},\"hopk\":\"HO00008389\",\"hoCode\":\"A000009491\",\"eventId\":\"0000000001\",\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"0000001247\",\"name\":{\"givenName\":\"Tom\",\"familyName\":\"Glynn-Carney\",\"middleName\":null}},{\"id\":\"0000003696\",\"name\":{\"givenName\":\"Ivo\",\"familyName\":\"van Hove\",\"middleName\":null}},{\"id\":\"0000004386\",\"name\":{\"givenName\":\"Marianne\",\"familyName\":\"Jean-Baptiste\",\"middleName\":null}},{\"id\":\"0000005574\",\"name\":{\"givenName\":\"Paapa\",\"familyName\":\"Essiedu\",\"middleName\":null}},{\"id\":\"HO00001680\",\"name\":{\"givenName\":\"Bryan\",\"familyName\":\"Cranston\",\"middleName\":null}},{\"id\":\"HO00002669\",\"name\":{\"givenName\":\"Hayley\",\"familyName\":\"Squires\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000039\",\"name\":{\"text\":\"Live Theatre\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":