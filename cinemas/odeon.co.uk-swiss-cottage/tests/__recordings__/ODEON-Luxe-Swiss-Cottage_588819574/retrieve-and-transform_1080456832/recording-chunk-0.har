layPriority\":8,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000560\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002207\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002294\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005786\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005787\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007837\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17711\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17712\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17713\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000042\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000349\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000696\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002427\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000010\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a4cb369f-77c4-4fe1-8f85-dd5e76b195dd\",\"corporateId\":null},\"hopk\":\"HO00007533\",\"hoCode\":\"A000008563\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008012\",\"title\":{\"text\":\"The Housemaid\",\"translations\":[]},\"synopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous — a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, sex, sexual violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-12-22\",\"runtimeInMinutes\":131,\"trailerUrl\":\"https://www.youtube.com/watch?v=kdDdlY2VPxw\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000009161\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012707\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016976\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016977\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000031\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000135\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000814\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001305\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dc7be94d-5ba5-4a79-accd-48ed4d19a3b6\",\"corporateId\":null},\"hopk\":\"HO00008012\",\"hoCode\":\"A000009092\",\"eventId\":null,\"distributorName\":\"LIONSGATE INTERNATIONAL\"},{\"id\":\"HO00008080\",\"title\":{\"text\":\"Hamnet\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"distressing scenes, brief moderate sex\",\"translations\":[]},\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":126,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemb