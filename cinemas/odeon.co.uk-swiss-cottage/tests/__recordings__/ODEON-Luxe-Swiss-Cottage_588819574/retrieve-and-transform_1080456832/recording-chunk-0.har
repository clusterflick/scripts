            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-03-31\",\"showtimes\":[{\"id\":\"838-31359\",\"schedule\":{\"businessDate\":\"2026-03-31\",\"startsAt\":\"2026-03-31T17:15:00+01:00\",\"endsAt\":\"2026-03-31T23:10:00+01:00\",\"filmStartsAt\":\"2026-03-31T17:40:00+01:00\",\"filmEndsAt\":\"2026-03-31T23:10:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"838-2-30\",\"filmId\":\"HO00007280\",\"siteId\":\"838\",\"screenId\":\"838-2\",\"areaCategories\":[{\"areaCategoryId\":\"838-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"838-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"838-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000048\",\"0000000178\",\"0000000187\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"838\",\"name\":{\"text\":\"Swiss Cottage\",\"translations\":[]},\"location\":{\"latitude\":51.5425,\"longitude\":-0.1745},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.swisscottage@OdeonUK.com\",\"address\":{\"line1\":\"96 Finchley Road\",\"line2\":\"Swiss Cottage\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007280\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: Siegfried\",\"translations\":[]},\"synopsis\":{\"text\":\"Raised by a scheming dwarf and unaware of his true family origins, a young man embarks on an epic journey. Soon, destiny brings him face-to-face with a shattered sword, a fearsome dragon and the cursed ring it guards, and a Valkyrie forced into enchanted slumber... \\nMoments of transcendent beauty and heroic triumph sparkle in the third chapter of Wagner’s Ring cycle, brought to life under Barrie Kosky’s inspired eye following his spectacular Das Rheingold (2023) and Die Walküre (2025). Andreas Schager, in his much-anticipated debut with The Royal Opera, stars as Siegfried’s titular hero, alongside Christopher Maltman’s towering Wanderer, Peter Hoare’s treacherous Mime and Elisabet Strid’s radiant Brünnhilde. Antonio Pappano conducts, drawing out the unspoken tensions and ethereal mysticism of Wagner’s dynamic score.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Raised by a scheming dwarf and unaware of his true family origins, a young man embarks on an epic journey. \",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-03-31\",\"runtimeInMinutes\":330,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000006070\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009261\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009262\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013288\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015508\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015509\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015510\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015511\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001942\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000043\"],\"externalIds\":{\"moviexchangeReleaseId\":\"0000526f-f09f-444c-9d66-e6ec960d9d6d\",\"corporateId\":null},\"hopk\":\"HO00007280\",\"hoCode\":\"A000008286\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000006070\",\"name\":{\"givenName\":\"Soloman\",\"familyName\":\"Howard\",\"middleName\":null}},{\"id\":\"0000009261\",\"name\":{\"givenName\":\"Christopher\",\"familyName\":\"Purves\",\"middleName\":null}},{\"id\":\"0000009262\",\"name\":{\"givenName\":\"Barrie\",\"familyName\":\"Kosky\",\"middleName\":null}},{\"id\":\"0000013288\",\"name\":{\"givenName\":\"Elisabet\",\"familyName\":\"Strid\",\"middleName\":null}},{\"id\":\"0000015508\",\"name\":{\"givenName\":\"Andreas\",\"familyName\":\"Schager\",\"mi