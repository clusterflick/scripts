          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-02-25\",\"showtimes\":[{\"id\":\"838-34794\",\"schedule\":{\"businessDate\":\"2026-02-25\",\"startsAt\":\"2026-02-25T16:40:00+00:00\",\"endsAt\":\"2026-02-25T19:04:00+00:00\",\"filmStartsAt\":\"2026-02-25T17:05:00+00:00\",\"filmEndsAt\":\"2026-02-25T19:04:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"838-1-36\",\"filmId\":\"HO00008387\",\"siteId\":\"838\",\"screenId\":\"838-1\",\"areaCategories\":[{\"areaCategoryId\":\"838-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000187\",\"0000000147\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"838-34793\",\"schedule\":{\"businessDate\":\"2026-02-25\",\"startsAt\":\"2026-02-25T19:30:00+00:00\",\"endsAt\":\"2026-02-25T21:54:00+00:00\",\"filmStartsAt\":\"2026-02-25T19:55:00+00:00\",\"filmEndsAt\":\"2026-02-25T21:54:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"838-1-36\",\"filmId\":\"HO00008387\",\"siteId\":\"838\",\"screenId\":\"838-1\",\"areaCategories\":[{\"areaCategoryId\":\"838-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000187\",\"0000000147\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"838\",\"name\":{\"text\":\"Swiss Cottage\",\"translations\":[]},\"location\":{\"latitude\":51.5425,\"longitude\":-0.1745},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.swisscottage@OdeonUK.com\",\"address\":{\"line1\":\"96 Finchley Road\",\"line2\":\"Swiss Cottage\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008387\",\"title\":{\"text\":\"Twenty One Pilots: More Than We Ever Imagined\",\"translations\":[]},\"synopsis\":{\"text\":\"Experience the electrifying concert film capturing Twenty One Pilots at a career-defining moment: their monumental Mexico City headline show, performing in front of 65,000 fans at Estadio GNP Seguros during The Clancy World Tour. \\n\\nSet against the vibrant pulse of one of the world’s most iconic music capitals, the film blends cinematic high-energy performance footage with intimate, behind-the-scenes access, revealing the heart, humor, and humanity of the artists as they prepare for one of the biggest shows of their career. \\n\\nViewers follow the band from their arrival in Mexico City to the stage, sharing in the preparation and anticipation that build as showtime approaches. Exclusive commentary from Tyler and Josh offer personal reflections on the journey that brought them to this historic stage and the deep connection with their fans who make it all possible.\\n\\nThe film pulls audiences into the full spectacle of the night. Sweeping aerials of the stadium, on-stage cameras, and crowd-level shots place viewers right at the center of the experience, seeing the show from every angle.  The result is a thrilling, emotional celebration of music, community, and achievement - an unforgettable portrait of Twenty One Pilots, performing a show that will echo through their legacy.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Experience the electrifying concert film capturing Twenty One Pilots at a career-defining moment: their monumental Mexico City headline show.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-25\",\"runtimeInMinutes\":119,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000005569\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005570\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013680\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017715\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017716\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017717\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017718\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a81251d1-868e-4b61-bbc3-6f1257804775\",\"corporateId\":null},\"hopk\":\"HO00008387\",\"hoCode\":\"A000009489\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000005569\",\"name\":{\"givenName\":\"Tyler\",\"familyName\":\"Joseph\",\"middleName\":null}},{\"id\":\"0000005570\",\"name\":{\"givenName\":\"Josh\",\"familyName\":\"Dun\",\"middleName\":null}},{\"id\":\"0000013680\",\"name\":{\"givenName\":\"Devin\",\"familyName\":\"Dehaven\",\"middleName\":null}},{\"id\":\"0000017715\",\"name\":{\"givenName\":\"Mark\",\"familyName\":\"Eshleman\",\"middleName\":null}},{\"id\":\"0000017716\",\"name\":{\"givenName\":\"Nathan\",\"familyName\":\"Bielski\",\"middleName\":null}},{\"id\":\"0000017717\",\"name\":{\"givenName\":\"Aldo\",\"familyName\":\"Ballesteros\",\"middleName\":null}},{\"id\":\"0000017718\",\"name\":{\"givenName\":\"Chris\",\"familyName\":\"Woltman\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000055\",\"name\":{\"text\":\"Music\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000001\",\"classification\":{\"text\":\"12A\",\"translations\":[]},\"classificationDescription\":{\"text\":\"12A with Parental Guidance\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true},{\"id\":\"0000000187\",\"name\":{\"text\":\"Flash Warning\",\"translations\":[]},\"shortName\":{\"text\":\"Flash\",\"translations\":[]},\"description\":{\"text\":\"This title has been issued a Guest Warning by the BBFC