            "text": "{\"businessDate\":\"2026-09-28\",\"showtimes\":[{\"id\":\"838-37390\",\"schedule\":{\"businessDate\":\"2026-09-28\",\"startsAt\":\"2026-09-28T15:30:00+01:00\",\"endsAt\":\"2026-09-28T18:25:00+01:00\",\"filmStartsAt\":\"2026-09-28T15:55:00+01:00\",\"filmEndsAt\":\"2026-09-28T18:25:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"838-5-35\",\"filmId\":\"HO00009033\",\"siteId\":\"838\",\"screenId\":\"838-5\",\"areaCategories\":[{\"areaCategoryId\":\"838-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"838-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"838-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000143\",\"0000000008\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"838-37391\",\"schedule\":{\"businessDate\":\"2026-09-28\",\"startsAt\":\"2026-09-28T19:15:00+01:00\",\"endsAt\":\"2026-09-28T22:10:00+01:00\",\"filmStartsAt\":\"2026-09-28T19:40:00+01:00\",\"filmEndsAt\":\"2026-09-28T22:10:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"838-5-35\",\"filmId\":\"HO00009033\",\"siteId\":\"838\",\"screenId\":\"838-5\",\"areaCategories\":[{\"areaCategoryId\":\"838-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"838-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"838-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"838\",\"name\":{\"text\":\"Swiss Cottage\",\"translations\":[]},\"location\":{\"latitude\":51.5425,\"longitude\":-0.1745},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.swisscottage@OdeonUK.com\",\"address\":{\"line1\":\"96 Finchley Road\",\"line2\":\"Swiss Cottage\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00009033\",\"title\":{\"text\":\"National Theatre Live: The Misanthrope\",\"translations\":[]},\"synopsis\":{\"text\":\"Award-winner Sandra Oh (Killing Eve) plays the title role in this razor-sharp reimagining of Molière’s classic dark comedy. Telling the truth isn’t always that simple. Alice, a brilliant novelist, despises the carefully constructed lies of modern society. But the more she challenges those around her, the fiercer the backlash becomes. Soon, she must confront the price of speaking her truth in a world that would rather silence her. Filmed live on stage at the National Theatre, Indhu Rubasingham directs Martin Crimp’s (Cyrano de Bergerac) highly anticipated play.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Award-winner Sandra Oh (Killing Eve) plays the title role in this razor-sharp reimagining of Molière’s classic dark comedy.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-09-22\",\"runtimeInMinutes\":150,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002358\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019238\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019239\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"19464\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"19465\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000447\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000039\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5601913c-5c9c-400a-8361-fab2a4c2a9ba\",\"corporateId\":null},\"hopk\":\"HO00009033\",\"hoCode\":\"A000010187\",\"eventId\":\"0000000001\",\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"0000002358\",\"name\":{\"givenName\":\"Sandra\",\"familyName\":\"Oh\",\"middleName\":null}},