            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-11\",\"showtimes\":[{\"id\":\"838-38286\",\"schedule\":{\"businessDate\":\"2026-08-11\",\"startsAt\":\"2026-08-11T19:15:00+01:00\",\"endsAt\":\"2026-08-11T21:36:00+01:00\",\"filmStartsAt\":\"2026-08-11T19:40:00+01:00\",\"filmEndsAt\":\"2026-08-11T21:36:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"838-2-30\",\"filmId\":\"HO00009197\",\"siteId\":\"838\",\"screenId\":\"838-2\",\"areaCategories\":[{\"areaCategoryId\":\"838-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"838-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"838-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000187\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"838\",\"name\":{\"text\":\"Swiss Cottage\",\"translations\":[]},\"location\":{\"latitude\":51.5425,\"longitude\":-0.1745},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.swisscottage@OdeonUK.com\",\"address\":{\"line1\":\"96 Finchley Road\",\"line2\":\"Swiss Cottage\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00009197\",\"title\":{\"text\":\"Nimrods: A Green Day Comedy\",\"translations\":[]},\"synopsis\":{\"text\":\"When Tommy receives a phone call inviting his band to open for Green Day on New Years Eve, he doesn’t realise it’s an elaborate prank by his older brother, Wayne. Desperate to believe his life is about to change, Tommy steals Wayne's car and begins driving his band from Kansas City to Los Angeles, hell bent on getting there in three days. What follows is a rowdy and uproarious road trip across America, inspired by Green Day’s early days of touring in a van, years before the release of their breakout record Dookie.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Three high school friends go on a road trip thinking that their band is opening for Green Day on New Year’s Eve. Inspired by Green Day’s real-life adventures...\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-11\",\"runtimeInMinutes\":116,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004766\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007690\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010773\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019627\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019628\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019629\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019630\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019631\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019632\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019633\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019634\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019635\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019636\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019637\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000929\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4c4d85ca-bbaa-49b3-8134-cb961d0d8717\",\"corporateId\":null},\"hopk\":\"HO00009197\",\"hoCode\":\"A000010365\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000004766\",\"name\":{\"givenName\":\"Mason\",\"familyName\":\"Thames\",\"middleName\":null}},{\"id\":\"0000007690\",\"name\":{\"givenName\":\"Fred \",\"familyName\":\"Armisen\",\"middleName\":null}},{\"id\":\"0000010773\",\"name\":{\"givenName\":\"Jenna \",\"familyName\":\"Fischer\",\"middleName\":null}},{\"id\":\"0000019627\",\"name\":{\"givenName\":\"Angela\",\"family