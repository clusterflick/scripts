ot;:2,&quot;335559740&quot;:360}\"> </span></p>\n                                                            </div>-->\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                                            <!--<div class=\"whatson-single-evnet-info\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<h3>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tShow Info\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</h3>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<table width=\"100%\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<tr><th width=\"32%\">Venue</th><th width=\"3%\">:</th><td width=\"65%\">Wilton's Music Hall</td></tr>\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t                                                                                                                                        <tr><th>Price</th><th>:</th><td>£12.50, £14.50, £15, £15.50, £16.50, £17, £17.50, £18, £19, £20</td></tr>                                                                     <tr><th>Runtime</th><th>:</th><td>133</td></tr>                                                                     \t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</table>\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>-->\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n                                        <style>.whatson-sinlge-event-king-info{margin-top:-15px;}</style>\t\t\t\t\t\t\t\t\t\t\n                                        <script data-cfasync=\"false\" src=\"/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js\"></script><script>\n                                            /*jQuery(document).ready(function($) {\n                                                //create the slider\n\t\t\t\t\t\t\t\t\t\t\t\tjQuery('.cd-testimonials-wrapper').flexslider({\n                                                    selector: \".cd-testimonials > li\",\n                                                    animation: \"slide\",\n\t\t\t\t\t\t\t\t\t\t\t\t\tslideshow: false,\n\t\t\t\t\t\t\t\t\t\t\t\t\tanimationLoop: false,