                      beforeShowDay: function( date ) {\n                        var highlight = eventDates[date];\n\n                        if( highlight ) {\n                             return [true,\"event\", 'Click for event'];\n                        } else {\n                             return [true, '', ''];\n                        }\n                    },\n                       onSelect: function (dateText, inst) {\n                            window.location = '/whats-on/?eventfilter=by-date&date-from=' + dateText;\n                        }\n                    });\n                }\n                $(\".DatePickerDiv\").toggle(\"fold\", 300);\n            });\n\n// An array of dates\nvar eventDates = [\"11\\/21\\/2026\",\"10\\/31\\/2026\",\"09\\/26\\/2026\",\"11\\/28\\/2026\",\"11\\/27\\/2026\",\"11\\/12\\/2026\",\"10\\/08\\/2026\",\"11\\/10\\/2026\",\"11\\/26\\/2026\",\"11\\/13\\/2026\",\"10\\/14\\/2026\",\"11\\/25\\/2026\",\"11\\/21\\/2026\",\"10\\/19\\/2026\",\"11\\/14\\/2026\",\"10\\/17\\/2026\",\"11\\/09\\/2026\",\"11\\/11\\/2026\",\"10\\/24\\/2026\",\"10\\/21\\/2026\",\"10\\/22\\/2026\",\"10\\/31\\/2026\",\"10\\/09\\/2026\",\"10\\/06\\/2026\",\"01\\/02\\/2027\",\"10\\/10\\/2026\",\"09\\/23\\/2026\",\"09\\/19\\/2026\",\"09\\/03\\/2026\",\"11\\/07\\/2026\",\"09\\/26\\/2026\",\"09\\/05\\/2026\",\"10\\/03\\/2026\",\"10\\/20\\/2026\",\"07\\/24\\/2026\",\"07\\/27\\/2026\",\"07\\/17\\/2026\",\"07\\/13\\/2026\",\"07\\/22\\/2026\",\"07\\/31\\/2026\",\"07\\/30\\/2026\",\"07\\/29\\/2026\",\"07\\/28\\/2026\",\"07\\/16\\/2026\"];\nvar eventIDs = [7221,7220,7219,7194,7193,7189,7188,7173,7178,7176,7175,7172,7164,7162,7154,7142,7139,7138,7126,7120,7118,7115,7075,7074,7036,7016,7006,7003,6966,6960,6892,6882,6852,6841,6756,6744,6725,6720,6717,6702,6701,6700,6699,6656];\nvar instanceIDs = [\"343548ACNQBGKKLPVTJRLHVDLDVKDLPLJ\",\"343149APPGLVPPNTRGPKTRHDNMRMVTNGV\",\"342548ATLRRNDJQVSGTQVSBMPSBCTSTSQ\",\"341748AKSTQJGMQQSGKCRLRPCSBNPRSSQ\",\"341548AGVCLMGHDSQKM