rDiv\">\n\t\t\t\t\t\t<div id=\"datepicker\"></div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<ul class=\"whatsoncategory DropDownGenreList\" name='category' id=\"whatsoncategory\" onchange=\"this.form.submit()\">\n\t\t\t\t\t\t<li><a href=\"/whats-on/?category=all\"  >All</a></li><li><a href=\"?category=cabaret\"  value=\"cabaret\" >Cabaret</a></li><li><a href=\"?category=comedy\"  value=\"comedy\" >Comedy</a></li><li><a href=\"?category=family\"  value=\"family\" >Family</a></li><li><a href=\"?category=film\" class=\"selected\" value=\"film\" selected=\"selected\">Film</a></li><li><a href=\"?category=heritage-tour\"  value=\"heritage-tour\" >Heritage Tour</a></li><li><a href=\"?category=magic\"  value=\"magic\" >Magic</a></li><li><a href=\"?category=music\"  value=\"music\" >Music</a></li><li><a href=\"?category=music-hall\"  value=\"music-hall\" >Music Hall</a></li><li><a href=\"?category=musical-theatre\"  value=\"musical-theatre\" >Musical Theatre</a></li><li><a href=\"?category=new-writing\"  value=\"new-writing\" >New Writing</a></li><li><a href=\"?category=opera\"  value=\"opera\" >Opera</a></li><li><a href=\"?category=theatre\"  value=\"theatre\" >Theatre</a></li>\t\t\t\t\t</ul>\n\t\t\t\t\t<ul class=\"whatsonaccessibity DropDownGenreList\" name=\"accessibity\" id=\"whatsonaccessibity\" onchange=\"this.form.submit()\">\n\t\t\t\t\t\t<li><a href=\"/whats-on/?accessible=all\"  >All</a></li>\t\t\t\t\t</ul>\n\t\t\t\t</div>\t\n\t\t\t</div>\n\n\t\t</form>\n\t\t</div>\t\n\t</div>\n\t\t\n    <div class=\"section-inner\"><!--container-->\n\t\t\n    <div class=\"row\">\n             \n                 \n            <!-- pagination here -->\n         \n            <!-- the loop -->\n            \n                 \n            \n                 \n            \n                 \n            \n                 \n            \n                 \n            \n                 \n            \n                 \n            \n                 \n            \n                 \n          