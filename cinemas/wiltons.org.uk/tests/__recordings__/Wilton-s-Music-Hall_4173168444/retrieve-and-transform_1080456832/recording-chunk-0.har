(window).load(function(){\n\t\tvar nowTemp = new Date();\n\t\tvar now = new Date(nowTemp.getFullYear(), nowTemp.getMonth(), nowTemp.getDate(), 0, 0, 0, 0);\n\t\tjQuery('#dp-calendar-search').datepicker({ \n\t\t\tformat:'yy-mm-dd',\n\t\t}).on('onRender', function(ev) {\n\t\t\treturn ev.date.valueOf() < now.valueOf() ? 'disabled' : '';\n\t\t }).on('changeDate', function(ev) {\n\t\t\tif(ev.date.valueOf() < now.valueOf())\n\t\t\t{\n\t\t\t\talert('Please select valid date.');\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\twindow.location = '/whats-on/?eventfilter=by-date&date-from=' + formatDate(ev.date);\n\t\t\t}\n\t\t });\n      jQuery('.flexslider').flexslider({\n        animation: \"slide\",\n\t\tanimationLoop: true,  \n\t\tslideshowSpeed: 5000,\n        start: function(slider){\n          jQuery('body').removeClass('loading');\n        }\n      });\n    });\n\t\n</script>\n<script type=\"text/javascript\">\njQuery(window).scroll(function(){\n  var sticky = jQuery('#site-header,body'),\n      scroll = jQuery(window).scrollTop();\n\n  if (scroll >= 145) sticky.addClass('fixed');\n  else sticky.removeClass('fixed');\n});\n\t\n</script>\n\n\n<!-----------LightBox------>\n<script type='text/javascript' src='/wp-content/themes/suredigital-starter/assets/js/wonderpluginlightbox.js'></script>\n<script type='text/javascript' src='/wp-content/themes/suredigital-starter/assets/js/fslightbox-mod.js'></script>\n<!--<script type='text/javascript' src='/wp-content/themes/suredigital-starter/assets/js/fslightbox.js'></script>-->\n<!-----------End LightBox------>\n<script type='text/javascript' src='/wp-content/themes/suredigital-starter/assets/js/comman-script.js'></script>\n\n\n\t</body>\n</html>\n\n<script type=\"text/javascript\">\njQuery(window).resize(function() {\n    jQuery('.Event_detailsBannerImg .EvntD_img').height(jQuery(window).height() - 110);\n});\njQuery(window).trigger('resize');\n</script>\n<script type=\"text/javascript\">\njQuery(function(){\n\tjQuery(\".EvntD_img .WatchIcon\").click(function(){\n\t\t  //as noted in addendum, check for querystring exitence\n\t\t  var symbol = jQuery(\"#VideoHolder_Play iframe\")[0].src.indexOf(\"?\") > -1 ? \"&\" : \"?\";\n\t\t  //modify source to autoplay and start video\n\t\t  jQuery(\"#VideoHolder_Play iframe\")[0].src += symbol + \"autoplay=1\";\n\t\t });\n    jQuery('.BannerVideo_close').click(function(){\n\t\tjQuery(\"#VideoHolder_Play\").css({'display':'none'});\n        jQuery('#VideoHolder_Play iframe').attr('src', jQuery('iframe').attr('srcvalue'));\n    });\n});\n</script>\t\n\n\n<script>\n\t//To handle # link of tabs\n\tjQuery(function () {\n\t\tvar hash = window.location.hash;\n\t\tif (hash == '#schedules')\n\t\t{\n\t\t\tjQuery('ul.nav a[href=\"#Tickets_in\"]').tab('show');\n\t\t}\n\t\thash && jQuery('ul.nav a[href=\"' + hash + '\"]').tab('show');\n\n\t\tjQuery('.nav-tabs a').click(function (e) {\n\t\t\tvar scrollHeight = jQuery(document).scrollTop();\n\t\t\tjQuery(this).tab('show');\n\n\t\t\tif (jQuery('#map-canvas').length != 0) {\n\t\t\t\tinitialize(); //Google map\n\t\t\t}\n\t\t\twindow.location.hash = this.hash;\n\t\t\tsetTimeout(function () {\n\t\t\t\tjQuery(window).scrollTop(scrollHeight);\n\t\t\t}, 0); //Set scroll back to position\n\t\t});\n\t});\n\n\t//Below script only work when realtime status code not applied\n\t\t\t\tvar viewMorebutton = jQuery(\".chnageViewMoreBtn\");\n\t\t\t\tvar viewMoreDate = jQuery(\"#datetime_tbody\");\n\t\t\t\tvar viewMoreDateWeb = jQuery(\"#datetime_tbody_web\");\n\t\t\t\t\n\t\t\t\tjQuery(window).load(function() {\n\t\t\t\t\tviewMoreDate.find(\"tr\").each(function(index) {\n\t\t\t\t\t\tif(index>9)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tthis.style='display:none;';\n\t\t\t\t\t\t\tif(index==10)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\tviewMorebutton.html('')\n\t\t\t\t\t\t\tviewMorebutton.append('VIEW MORE DATES');\n\t\t\t\t\t\t\t}\t\t\t\t\t   \n\t\t\t\t\t\t}\t\t\t    \n\t\t\t\t\t});\n\t\t\t\t\tviewMoreDateWeb.find(\"tr\").each(function(index) {\n\t\t\t\t\t\tif(index>9)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tthis.style='display:none;';\n\t\t\t\t\t\t\tif(index==10)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tviewMoreDateWeb.html('')\n\t\t\t\t\t\t\t\tviewMoreDateWeb.append('VIEW MORE DATES');\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\t\t\t    \n\t\t\t\t\t});\n\t\t\t});\n\t\t\t\n\t\t\t\tviewMorebutton.click(function() { \n\t\t\t\t\tconsole.log(viewMorebutton.html());\t\t    \n\t\t\t\t\tvar trData = viewMoreDate.find(\"tr\");\t\t\t\t\n\t\t\t\t\tvar trDataWeb = viewMoreDateWeb.find(\"tr\");\t\n\t\t\t\t\t\n\t\t\t\t\tif(viewMorebutton.html() =='VIEW MORE DATES')\n\t\t\t\t\t{\n\t\t\t\t\tviewMorebutton.html('')\n\t\t\t\t\t\ttrData.each(function(index) {\n\t\t\t\t\t\tthis.style='';\n\t\t\t\t\t});\t\t\t\n\t\t\t\t\t\ttrDataWeb.each(function(index) {\n\t\t\t\t\t\tthis.style='';\n\t\t\t\t\t});\t\t\t\n\t\t\t\t\tviewMorebutton.append('VIEW LESS DATES');\n\t\t\t\t\t} else {\n\t\t\t\t\tviewMorebutton.html('')\n\t\t\t\t\ttrData.each(function(index) {\n\t\t\t\t\t\tif(index>9)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tconsole.log('index>9');\n\t\t\t\t\t\t\tthis.style='display:none;';\n\t\t\t\t\t\t}\t\t\t    \n\t\t\t\t\t});\n\t\t\t\t\t\ttrDataWeb.each(function(index) {\n\t\t\t\t\t\tconsole.log(index);\n\t\t\t\t\t\tif(index>9)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tthis.style='display:none;';\n\t\t\t\t\t\t}\t\t\t    \n\t\t\t\t\t});\n\t\t\t\t\tviewMorebutton.append('VIEW MORE DATES');\n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t});\n\n</script>\n\n\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/vue/2.6.11/vue.min.js\"></script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/axios/0.19.2/axios.min.js\"></script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/vuex/3.2.0/vuex.min.js\"></script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.26.0/moment-with-locales.min.js\"></script>\n<script src=\"https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?features=Promise.prototype.finally\" defer></script>\n<script src=\"https://cdn.jsdelivr.net/gh/jbdemonte/barcode/jquery/jquery-barcode.js\"></script>\n<link rel=\"stylesheet\" type=\"text/css\" href=\"//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css\"/>\n<script type=\"text/javascript\" src=\"//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js\"></script>\n\n\n<style>\n\ti.icn-spinner {\n\t\tfont-size: 20px;\n\t}\n\n\t.icn-spinner {\n\t\tanimation: spin-animation infinite;\n\t\tdisplay: inline-block;\n\t}\n\n\t@-webkit-keyframes spin-animation {\n        from {\n            -webkit-transform: rotate(0deg);\n        }\n\n        to {\n            -webkit-transform: rotate(360deg);\n        }\n    }\n\n    @keyframes spin-animation {\n        from {\n            transform: rotate(0deg);\n        }\n\n        to {\n            transform: rotate(360deg);\n        }\n    }\n\t.icn-spinner::after {\n        content: '';\n\t\tcolor: #fff;\n        display: block;\n        left: 48%;\n        top: 40%;\n        width: 20px;\n        height: 20px;\n        border-style: solid;\n        border-top-color: transparent;\n        border-width: 2px;\n        border-radius: 50%;\n        -webkit-animation: spin .8s linear infinite;\n        animation: spin .8s linear infinite;\n    }\n</style>\n\n<script type=\"text/javascript\">\n\n\tconst instance_realtime_status_url = \"https://wiltons.org.uk/wp-json/21stcd/v1/whatson_instance_realtime_status_byspektrixinstanceid\";\n\tconst event_realtime_status_url = \"https://wiltons.org.uk/wp-json/21stcd/v1/whatson_event_realtime_status\";\n\t\n\tconst VueBookButtonDesktop = new Vue({\n        el: '#VueBookButtonDesktop',\n        data: {\n\t\t\t\tIsButtonLloadingStatusActive: false,\n            \t            \tspektrix_instance_id_325148AHRLVVTCJCTMSRPRHJGCNRHRBGH_loading: false,\n\t\t\t\tspektrix_instance_id_325148AHRLVVTCJCTMSRPRHJGCNRHRBGH_status: 'Book',\n\t\t\t\t        },\n        created() {\n            this.init();\n\t\t\tthis.updateEventStatus();\n        },\n        methods: {\n            init: function (params) {\n\t\t\t\t