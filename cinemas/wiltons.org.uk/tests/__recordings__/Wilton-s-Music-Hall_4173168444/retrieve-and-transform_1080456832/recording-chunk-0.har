LRQGMCMJGNQRRSNGBHRRVLKQB_loading == false\" href=\"https://wiltons.org.uk/booking?event-id=6701&instances-id=325548\" class=\"Ticketbook_btn CommonBtn\" onclick=\"openPopup('popup_content_', 'https://wiltons.org.uk/booking?event-id=6701&instances-id=325548')\" v-bind:class=\"getBookButtonClass(spektrix_instance_id_325548AQLRQGMCMJGNQRRSNGBHRRVLKQB_status)\" >\n\t\t\t\t\t\t<span>{{spektrix_instance_id_325548AQLRQGMCMJGNQRRSNGBHRRVLKQB_status}}</span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a v-if=\"spektrix_instance_id_325548AQLRQGMCMJGNQRRSNGBHRRVLKQB_loading == true\" href=\"https://wiltons.org.uk/booking?event-id=6701&instances-id=325548\" class=\"Ticketbook_btn CommonBtn BookBtn_Limited\">\n\t\t\t\t\t\t<span class=\"instance_status_in_button_spinner\"><i class=\"icn-spinner\"></i></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t</td>\n\t\t\t</tr>\n\n\t\t\t\t\t</tbody>\n\n\t</table>\t\n\t<br/>\n\t<button class=\"chnageViewMoreBtn\"></button>\t\n\n</div>\t\t\t</div>\n\t\t\t\n            <div class=\"whatson-event-details-main-post-div\">\t\n\t\t\t\t\t\t<div class=\"section-inner\">\n\t\t\t\t\t\t\t<div class=\"EventDetail_containt\">\n\t\t\t\t\t\t\t\t<div class=\"EventDetail_Discip\" role=\"main\">\n\t\t\t\t\t\t\t\t\t\n<div class=\"Details_Tabs Details_TabsDesktop\" role=\"tabpanel\">\n\t<div class=\"Tabstoggle\">\n\t\t<button type=\"button\" class=\"textType\">About</button>\t\t\t\t\t\t\t\t\t\t\n\t</div>\n\t<ul class=\"nav nav-tabs\" role=\"tablist\">\n\t\t\t\t\n\t\t\n\t\t\t\t<!-- <li class=\"active\"><a href=\"#Details_in\" role=\"tab\" data-toggle=\"tab\" class=\"textType\">About</a></li>-->\n\t\t<!-- <li><a href=\"#whatson-testimonials-wrapper\" role=\"tab\" data-toggle=\"tab\" class=\"textType\">REVIEWS</a></li>-->\n\t\t\n\t\t<!--<li id=\"ticketsschedules\"><a href=\"#Tickets_in\" role=\"tab\" data-toggle=\"tab\" class=\"textType\">Tickets & Times</a></li>-->\n\t\t\t\t\t\t\t</ul>\n\t<div class=\"tab-content\">\n\t\t<div role=\"tabpanel\" class=\"tab-pane active\" id=\"Details_in\">\n\t\t\t<!--<a href=\"#\" class=\"MobileAccordianBtn\">Description</a>-->\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"EventDescriptionLeft\">\n\t\t\t\t\t\t\t<!--<h3 class=\"TabsSec_Title\">MAIN INFO</h3>\n\t\t\t\t<div class=\"ShortInfoLeft\">\n\t\t\t\t<p>DIRECTOR: CARY JOJI FUKUNAGA</p>\n\t\t\t\t<p>STARRING: DANIEL CRAIG, RALPH FIENNES, NAOMIE HARRIS, RAMI MALEK, LÉA SEYDOUX</p> \n\t\t\t\t<p>CERTIFICATE: 12A</p>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>-->\t\n\t\t\t\t<div class=\"whatson-event-details-content MobileAccordian_info\">\n\t\t\t\t\t<!--hide-on-mobile-->\n\t\t\t\t\t<p><em>“You should only play when you&#8217;re sure to win”  </em></p>\n<p><span data-contrast=\"none\"><strong>Louise Brooks</strong> stars as the effortlessly seductive Lulu, a high class courtesan and dancer who brings destruction to the Berlin bourgeoisie with her turbulent love affairs, both male and female.  </span><span data-ccp-props=\"{&quot;134245417&quot;:false,&quot;201341983&quot;:0,&quot;335559740&quot;:360}\"> </span></p>\n<p><span data-contrast=\"none\">Heavily censored in its day, <strong>G.W. Pabst</strong>&#8216;s 1929 Weimar masterpiece nonetheless</span><span data-contrast=\"none\"> launched flapper icon Brooks to international stardom and <em><strong>Pandora&#8217;s Box </strong></em></span><span data-contrast=\"none\">still feels incredibly modern today, ranking amongst the Guardian&#8217;s top 100 films of all time. </span></p>\n<p><span data-contrast=\"none\">Experience this rare special screening with</span><span data-contrast=\"auto\"> live piano score by <strong>Christopher Eldred</strong>.</span><span data-ccp-props=\"{&quot;134245417&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:2,&quot;335551620&quot;:2,&quot;335559740&quot;:360}\"> </span></p>\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t</div>\n\t\t<!--<div role=\"tabpanel\" class=\"tab-pane active\" id=\"Tickets_in\">\n\t\t\t<!--<a href=\"#\" class=\"MobileAccordianBtn\">Tickets & Times</a>--\n\t\t</div>-->\n\t\t<div role=\"tabpanel\" class=\"tab-pane EventDetails_Video\" id=\"VideoTabs\">\n\t\t\t<div class=\"EventDetailsVideo_inner\">\n\t\t\t\t<img class=\"Blankbanner_img\" src=\"/wp-content/plugins/whats-on/images/blankImg_video.png\" alt=\"Event Details Video\">\n\t\t\t\t<style>.EventDetails_Video{display:none;}</style><h4>Video Not Found</h4>\t\t\t</div>\t\n\t\t</div>\t\n\t\t\t\t\n\t\t\t\t\n\t\t<div class=\"whatson-event-terms-link-area\" style=\"display: none;\">\n\t\t\t\t\t\t\t\t<a class=\"whatson-event-terms-link\" href=\"https://wiltons.org.uk/about-our-music/terms-and-conditions/\" target=\"_blank\"> Terms and Conditions </a>\n\t\t\t\t\t\t\t </div>\n\t</div>\n\n\t\t\n\t<script>\n\t\tjQuery('.WarningSms_drop button').ready(function() {\n\t\t\tjQuery('.WarningSms_drop button').click(function(){\t\t\t\n\t\t\tjQuery('.WarningSms_drop').toggleClass('show');\n\t\t});\n});\n\t\t\n\t</script>\n</div>\n\n<script type=\"text/javascript\">\n\tjQuery('.repeat-toggle').click(function()\n{\n     jQuery(this).toggleClass('open'); //Adds 'a', removes 'b' and vice versa\n});\n//Mobile tabs accordian////////\t\njQuery('.tab-pane .MobileAccordianBtn').click(function (e) {\n\te.preventDefault();\n\tvar $this = $(this);\n\t$this.addClass('active');\n\tjQuery('.tab-pane .MobileAccordianBtn').removeClass('active');\n\t$this.addClass('active');\n\tif ($this.next().hasClass('show')) {\n\t\t$this.next().removeClass('show');\n\t\tjQuery('.tab-pane .MobileAccordianBtn').removeClass('active');;\n\t} else {\n\t\t$this.parent().parent().find('.MobileAccordian_info').removeClass('show');\n\t\t$this.parent().parent().find('.MobileAccordian_info').slideUp(350);\n\t\t$this.next().toggleClass('show');\n\t}\n});\t\n\t\n</script>\t\t\t\t\t\t\t\t\t<div class=\"whatson-event-view-tags-link-area\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t<div class=\"whatson-sinlge