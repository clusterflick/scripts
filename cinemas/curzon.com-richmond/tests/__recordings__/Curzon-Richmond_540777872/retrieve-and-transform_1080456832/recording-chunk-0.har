          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-10-03\",\"showtimes\":[{\"id\":\"RIC1-17103\",\"schedule\":{\"businessDate\":\"2026-10-03\",\"startsAt\":\"2026-10-03T18:00:00+01:00\",\"endsAt\":\"2026-10-03T21:57:00+01:00\",\"filmStartsAt\":\"2026-10-03T18:00:00+01:00\",\"filmEndsAt\":\"2026-10-03T21:57:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00007131\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"RIC1@curzon.com\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007131\",\"title\":{\"text\":\"Met Opera 2026-27: Così fan tutte\",\"translations\":[]},\"synopsis\":{\"text\":\"The Met: Live in HD season continues with Mozart’s satirical comedy of fickle young love. Phelim McDermott’s “colorful, inventive” (The New York Times) staging, inspired by Coney Island in the 1950s, sets the uproarious story at a boardwalk amusement park, where the two pairs of lovers at the heart of the tale find themselves on one emotional—and literal—thrill ride after another. Soprano Federica Lombardi and mezzo-soprano Samantha Hankey sing Fiordiligi and Dorabella, opposite tenor Duke Kim and baritone Andrey Zhilikhovsky as Ferrando and Guglielmo. Bass-baritone Gerald Finley reprises his portrayal of the cynical Don Alfonso, with soprano Ana María Martínez as the witty maid Despina.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Met: Live in HD season continues with Mozart’s satirical comedy of fickle young love. Phelim McDermott’s “colorful, inventive” (The New York Times) staging\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-10-03\",\"runtimeInMinutes\":237,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000003516\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003807\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003829\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014099\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014100\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014101\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000310\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000003516\"},{\"castAndCrewMemberId\":\"0000003829\"},{\"castAndCrewMemberId\":\"0000014099\"},{\"castAndCrewMemberId\":\"0000014100\"},{\"castAndCrewMemberId\":\"0000014101\"},{\"castAndCrewMemberId\":\"HO00000310\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000000920\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000003807\"}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"02e51e1b-5e8f-4a11-96e1-b74f5c968d29\",\"corporateId\":null},\"hopk\":\"HO00007131\",\"hoCode\":\"A000008782\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000003516\",\"name\":{\"givenName\":\"Andrey\",\"familyName\":\"Zhilikhovsky\",\"middleName\":null}},{\"id\":\"0000003807\",\"name\":{\"givenName\":\"Phelim \",\"familyName\":\"McDermott\",\"middleName\":null}},{\"id\":\"0000003829\",\"name\":{\"givenName\":\"Ana María\",\"familyName\":\"Martínez\",\"middleName