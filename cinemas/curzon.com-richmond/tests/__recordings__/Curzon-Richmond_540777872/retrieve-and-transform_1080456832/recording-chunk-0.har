          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-05\",\"showtimes\":[{\"id\":\"RIC1-17239\",\"schedule\":{\"businessDate\":\"2026-08-05\",\"startsAt\":\"2026-08-05T18:00:00+01:00\",\"endsAt\":\"2026-08-05T20:10:00+01:00\",\"filmStartsAt\":\"2026-08-05T18:25:00+01:00\",\"filmEndsAt\":\"2026-08-05T20:10:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00007177\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"RIC1@curzon.com\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007177\",\"title\":{\"text\":\"David Byrne's American Utopia\",\"translations\":[]},\"synopsis\":{\"text\":\"‘Do we get stupider as we grow up?’ In his wildly popular Broadway show American Utopia, David Byrne reflects on human connections, life and how on earth we work through it. He joins the dots with his music and it all starts making sense. Spike Lee here transforms the production into immersive, dynamic cinema that radiates with astounding performances, inventive contemporary dance and political urgency. American Utopia flows like an iridescent dream vision. Work by James Baldwin, Janelle Monáe and Kurt Schwitters is highlighted among exhilarating renditions of Byrne’s solo work, as well as Talking Heads classics. According to the multi-hyphenate, we love looking at humans more than anything else. Anti-fascist and anti-racist, Byrne illuminates our responsibility to care for one another as he and his co-performers burn down the house.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Spike Lee documents the former Talking Heads frontman's brilliant, timely 2019 Broadway show, based on his album and tour of the same name.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-08-05\",\"runtimeInMinutes\":105,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/71462d28-6647-40ab-b4bf-54d585dfd560/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=WZ2I-A4kNfM\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=WZ2I-A4kNfM\",\"displayPriority\":10,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000006713\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011349\",\"roles\":[\"Director\",\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000006713\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000011349\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000011349\"}],\"genreIds\":[\"0000000032\"],\"externalIds\":{\"moviexchangeReleaseId\":\"71462d28-6647-40ab-b4bf-54d585dfd560\",\"corporateId\":null},\"hopk\":\"HO00007177\",\"hoCode\":\"A000008832\",\"eventId\":null,\"distributorName\":\"Dogwoof\"}],\"castAndCrew\":[{\"id\":\"0000006713\",\"name\":{\"givenName\":\"David\",\"familyName\":\"Byrne\",\"middleName\":null}},{\"id\":\"0000011349\",\"name\":{\"givenName\":\"Spike\",\"familyName\":\"Lee\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000032\",\"name\":{\"text\":\"Musical\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"HO00000004\",\"classification\":{\"text\":\"12A\",\"translations\":[]},\"classificationDescription\":{\"text\":\"12A\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[],\"screens\":[{\"id\":\"RIC1-1\",\"name\":{\"text\":\"Sc