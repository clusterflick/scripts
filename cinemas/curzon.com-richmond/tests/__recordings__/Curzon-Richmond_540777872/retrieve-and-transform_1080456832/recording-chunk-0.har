            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2027-04-22\",\"showtimes\":[{\"id\":\"RIC1-17098\",\"schedule\":{\"businessDate\":\"2027-04-22\",\"startsAt\":\"2027-04-22T19:15:00+01:00\",\"endsAt\":\"2027-04-22T22:40:00+01:00\",\"filmStartsAt\":\"2027-04-22T19:15:00+01:00\",\"filmEndsAt\":\"2027-04-22T22:40:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00007128\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"RIC1@curzon.com\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007128\",\"title\":{\"text\":\"RBO Cinema Season 2026-27: Swan Lake\",\"translations\":[]},\"synopsis\":{\"text\":\"Princess Odette is bound by a curse, turned into a swan by the evil sorcerer Von Rothbart. The spell can only be broken by a pledge of eternal love. When she meets Prince Siegfried, he is immediately enamoured by her fragile beauty and pledges to free her. But freedom is not promised for Odette as Von Rothbart conspires to thwart the lovers’ plans.\\nLiam Scarlett’s production for The Royal Ballet brings together Tchaikovsky’s towering score and John Macfarlane’s picturesque designs to create an enduring ballet spectacle of love, treachery and forgiveness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Princess Odette is bound by a curse, turned into a swan by the evil sorcerer Von Rothbart. The spell can only be b