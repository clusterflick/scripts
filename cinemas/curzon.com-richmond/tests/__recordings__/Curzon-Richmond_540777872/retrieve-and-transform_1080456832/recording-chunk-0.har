          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-09\",\"showtimes\":[{\"id\":\"RIC1-17336\",\"schedule\":{\"businessDate\":\"2026-08-09\",\"startsAt\":\"2026-08-09T15:00:00+01:00\",\"endsAt\":\"2026-08-09T17:04:00+01:00\",\"filmStartsAt\":\"2026-08-09T15:25:00+01:00\",\"filmEndsAt\":\"2026-08-09T17:04:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00007216\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"RIC1@curzon.com\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007216\",\"title\":{\"text\":\"Curzon Film 50: Babette's Feast\",\"translations\":[]},\"synopsis\":{\"text\":\"When Babette, a beautiful and mysterious French refugee, arrives in a remote Danish town, the tight-knit, puritanical community begrudgingly let her in, providing her with shelter and work. But after the town patriarch passes away and Babette insists on preparing a feast in his honour, a magical world of sensory revelations is thrown open to the villagers, changing their lives forever..\\n\\nEvoking the work of other great Scandinavian directors such as Ingmar Bergman and Carl Theodor Dreyer, but with a uniquely joyous, exuberant touch, this 1988 Oscar for Best Foreign Language Film winning tale of everyday passion - of the human capacity to create and to love - is a mouthwatering ode to the glory of life from one of cinema's true originals.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"During the late 19th century, a strict religious community in a Danish village takes in a French refugee from the Franco-Prussian War as a servant to the late pastor.\",\"translations\":[]},\"censorRatingId\":\"HO00000001\",\"censorRatingNote\":{\"text\":\"Contains no material likely to offend or harm\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":99,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=AgxXGnuoTk8\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=AgxXGnuoTk8\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003966\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006705\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007143\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007179\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007180\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007181\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007182\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007183\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000007184\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000007185\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000003966\"},{\"castAndCrewMemberId\":\"0000006705\"},{\"castAndCrewMemberId\":\"0000007143\"},{\"castAndCrewMemberId\":\"0000007179\"},{\"castAndCrewMemberId\":\"0000007180\"},{\"castAndCrewMemberId\":\"0000007181\"},{\"castAndCrewMemberId\":\"0000007182\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000007183\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000007184\"},{\"castAndCrewMemberId\":\"0000007185\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007216\",\"hoCode\":\"A000008878\",\"eventId\":\"0000000068\",\"distributorName\":\"Curzon\"}],\"castAndCrew\":[{\"id\":\"0000003966\",\"name\":{\"givenName\":\"Stéphane\",\"familyName\":\"Audran\",\"middleName\":null}},{\"id\":\"0000006705\",\"name\":{\"givenName\":\"Bibi \",\"familyName\":\"Andersson\",\"middleName\":null}},{\"id\":\"0000007143\",\"name\":{\"givenName\":\"Jarl\",\"familyName\":\"Kulle\",\"middleName\":null}},{\"id\":\"0000007179\",\"name\":{\"givenName\":\"Bodil\",\"familyName\":\"Kjer\",\"middleName\":null}},{\"id\":\"0000007180\",\"name\":{\"givenName\":\"Birgitte\",\"familyName\":\"Federspiel\",\"middleName\":null}},{\"id\":\"0000007181\",\"name\":{\"givenName\":\"Ghita\",\"familyName\":\"Nørby\",\"middleName\":null}},{\"id\":\"0000007182\",\"name\":{\"givenName\":\"Jean-Philippe\",\"familyName\":\"Lafont\",\"middleName\":null}},{\"id\":\"0000007183\",\"name\":{\"givenName\":\"Gabriel\",\"familyName\":\"Axel\",\"middleName\":null}},{\"id\":\"0000007184\",\"name\":{\"givenName\":\"Just\",\"familyName\":\"Betzer\",\"middleName\":null}},{\"id\":\"0000007185\",\"name\":{\"givenName\":\"Bo\",\"familyName\":\"Christensen\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":{\"text\":\"Drama\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"HO00000001\",\"classification\":{\"text\":\"U\",\"translations\":[]},\"classificationDescription\":{\"text\":\"U\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000053\",\"name\":{\"text\":\"Film Club\",\"translations\":[]},\"shortName\":{\"text\":\"Film Club\",\"translations\":[]},\"description\":{\"text\":\"Film Club Screening. Browse more at curzon.com/film-club\",\"translations\":[]},\"importantMessage\":{\"text\":\"Film Club Screening\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"RIC1-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000068\",\"name\":{\"text\":\"Curzon Film 50\",\"translations\":[]},\"shortName\":null,\"description\"