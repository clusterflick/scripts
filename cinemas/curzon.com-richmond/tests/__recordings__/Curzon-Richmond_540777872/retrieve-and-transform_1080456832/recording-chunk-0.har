\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"RIC1-130-HO00007116\"}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"RIC1@curzon.com\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007116\",\"title\":{\"text\":\"The Odyssey\",\"translations\":[]},\"synopsis\":{\"text\":\"Legendary filmmaker Christopher Nolan follows up his Oscar-winning sensation Oppenheimer with another rousing epic, The Odyssey, whose all-star cast includes Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson, Lupita Nyong'o, Zendaya and Charlize Theron.\\n\\nThis mythic action movie recounts the story of Odysseus (Damon) on his perilous journey home, troubled by gods and monsters. Meanwhile, his wife Penelope (Hathaway) and son Telemachus (Holland) fight to hold their kingdom together against relentless suitors.\\n\\nSee it on 35mm film at Soho, and enjoy it with Dolby Atmos sound at Bloomsbury, Canterbury Riverside and Kingston.\\n\\nTHE ODYSSEY MIDNIGHT SCREENINGS\\nThe film will start promptly at 12:01am on Thursday night. Please ensure you are seated by midnight.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":172,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/b3ff6b75-3025-43b7-88a5-37fc8c43d313/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000319\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000680\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001061\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002220\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002609\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003850\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004443\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005731\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000014094\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000319\"},{\"castAndCrewMemberId\":\"0000000680\"},{\"castAndCrewMemberId\":\"0000001061\"},{\"castAndCrewMemberId\":\"0000002220\"},{\"castAndCrewMemberId\":\"0000002609\"},{\"castAndCrewMemberId\":\"0000003850\"},{\"castAndCrewMemberId\":\"0000004443\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000005731\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000005731\"},{\"castAndCrewMemberId\":\"0000014094\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b3ff6b75-3025-43b7-88a5-37fc8c43d313\",\"corporateId\":null},\"hopk\":\"HO00007116\",\"hoCode\":\"A000008764\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"}],\"castAndCrew\":[{\"id\":\"0000000319\",\"name\":{\"givenName\":\"Zendaya\",\"familyName\":\"\",\"middleName\":null}},{\"id\":\"0000000680\",\"name\":{\"givenName\":\"Charlize\",\"familyName\":\"Theron\",\"middleName\":null}},{\"id\":\"0000001061\",\"name\":{\"givenName\":\"Matt\",\"familyName\":\"Damon\",\"middleName\":null}},{\"id\":\"0000002220\",\"name\":{\"givenName\":\"Tom \",\"familyName\":\"Holland\",\"middleName\":null}},{\"id\":\"0000002609\",\"name\":{\"givenName\":\"Robert\",\"familyName\":\"Pattinson\",\"middleName\":null}},{\"id\":\"0000003850\",\"name\":{