            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-10-17\",\"showtimes\":[{\"id\":\"RIC1-17104\",\"schedule\":{\"businessDate\":\"2026-10-17\",\"startsAt\":\"2026-10-17T18:00:00+01:00\",\"endsAt\":\"2026-10-17T21:29:00+01:00\",\"filmStartsAt\":\"2026-10-17T18:00:00+01:00\",\"filmEndsAt\":\"2026-10-17T21:29:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00007133\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"RIC1@curzon.com\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007133\",\"title\":{\"text\":\"Met Opera 2026-27: Macbeth\",\"translations\":[]},\"synopsis\":{\"text\":\"Two of opera’s most extraordinary artists return to The Met: Live in HD for Verdi’s thrilling take on the immortal Shakespearean tale of the scheming couple determined to seize power at any cost. Baritone Quinn Kelsey is the Scottish king haunted by the ghosts of his murderous ascent to the throne, opposite soprano Lise Davidsen as the power-mad Lady Macbeth, whose ruinous ambition damns them both. Met Music Director Yannick Nézet-Séguin takes the podium for a penetrating production by Louisa Proske. Rounding out the all-star cast are tenor Freddie De Tommaso as Macduff and bass-baritone Ryan Speedo Green as Banquo.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Two of opera’s most extraordinary artists return to The Met: Live in HD for Verdi’s thrilling take on the immortal Shakespearean tale of the scheming couple\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-10-17\",\"runtimeInMinutes\":209,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000907\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001562\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001580\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009287\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014095\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000907\"},{\"castAndCrewMemberId\":\"0000001562\"},{\"castAndCrewMemberId\":\"0000001576\"},{\"castAndCrewMemberId\":\"0000001580\"},{\"castAndCrewMemberId\":\"0000009287\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000000920\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000014095\"}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b47bff1f-aac7-4697-9356-3ac74206096b\",\"corporateId\":null},\"hopk\":\"HO00007133\",\"hoCode\":\"A000008784\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000907\",\"name\":{\"givenName\":\"Ryan Speedo\",\"familyName\":\"Green\",\"middleName\":null}},{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000001562\",\"name\":{\"givenName\":\"Yannick\",\"familyName\":\"Nézet-Séguin\",\"middleName\":null}},{\"id\":\"0000001576\",\"name\":{\"givenName\":\"Quinn\",\"familyName\":\"Kelsey\",\"middleName\":null}},{\"id\":\"0000001580\",\"name\":{\"givenName\":\"Lise\",\"familyName\":\"Davidsen\",\"middleName\":null}},{\"id\":\"0000009287\",\"name\":{\"givenName\":\"Freddie\",\"familyName\":\"