            "text": "{\"businessDate\":\"2026-07-28\",\"showtimes\":[{\"id\":\"RIC1-17305\",\"schedule\":{\"businessDate\":\"2026-07-28\",\"startsAt\":\"2026-07-28T11:00:00+01:00\",\"endsAt\":\"2026-07-28T12:55:00+01:00\",\"filmStartsAt\":\"2026-07-28T11:25:00+01:00\",\"filmEndsAt\":\"2026-07-28T12:55:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00002081\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000048\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"RIC1-2-HO00002081\"}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"RIC1@curzon.com\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00002081\",\"title\":{\"text\":\"Orlando\",\"translations\":[]},\"synopsis\":{\"text\":\"In 1600, nobleman Orlando (Tilda Swinton) inherits his parents' house, thanks to Queen Elizabeth I (Quentin Crisp), who commands the young man to never change. After a disastrous affair with Russian princess Sasha (Charlotte Valandrey), Orlando looks for solace in the arts before being appointed ambassador to Constantinople in 1700, where war is raging. One morning, Orlando is shocked to wake up as a woman and returns home, struggling as a female to retain her property as the centuries roll by.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After Queen Elizabeth I commands him not to grow old, a young nobleman struggles with love and his place in the world.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"1993-03-12\",\"runtimeInMinutes\":90,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000198\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011174\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011175\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011176\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011178\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011179\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000198\"},{\"castAndCrewMemberId\":\"0000011174\"},{\"castAndCrewMemberId\":\"0000011175\"},{\"castAndCrewMemberId\":\"0000011176\"},{\"castAndCrewMemberId\":\"0000011177\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000011178\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000011179\"}],\"genreIds\":[\"0000000002\",\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4821c3e3-21a2-48f0-9f4c-cc3f68486ea6\",\"corporateId\":null},\"hopk\":\"HO00002081\",\"hoCode\":\"A000002671\",\"eventId\":null,\"distributorName\":\"Curzon\"}],\"castAndCrew\":[{\"id\":\"0000000198\",\"name\":{\"givenName\":\"Tilda\",\"familyName\":\"Swinton\",\"middleName\":null}},{\"id\":\"0000011174\",\"name\":{\"givenName\":\"Quentin\",\"familyName\":\"Crisp\",\"middleName\":null}},{\"id\":\"0000011175\",\"name\":{\"givenName\":\"Jimmy\",\"familyName\":\"Somerville\",\"middleName\":null}},{\"id\":\"0000011176\",\"name\":{\"givenName\":\"John\",\"familyName\":\"Bott\",\"middleName\":null}},{\"id\":\"0000011177\",\"name\":{\"givenName\":\"Elaine\",\"familyName\":\"Banham\",\"middleName\":null}},{\"id\":\"0000011178\",\"name\":{\"givenName\":\"Sally\",\"familyName\":\"Potter\",\"middleName\":null}},{\"id\":\"0000011179\",\"name\":{\"givenName\":\"Christopher\",\"familyName\":\"Sheppard\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",