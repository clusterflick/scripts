            "text": "{\"name\":\"Richmond\",\"urlSegment\":\"richmond\",\"url\":\"/venues/richmond/\",\"nodeId\":1810,\"alias\":\"cinema\",\"createDate\":\"2024-08-13T14:58:24\\u002B01:00\",\"updateDate\":\"2026-01-28T09:53:43\\u002B00:00\",\"versions\":{\"\":\"https://www.curzon.com/venues/richmond/\"},\"robotsNoIndex\":false,\"robotsNoFollow\":false,\"masterCanonicalUrl\":null,\"excludeCanonicalUrl\":false,\"seoImage\":null,\"metaKeywords\":\"\",\"metaDescription\":\"Find out what\\u0027s on at Curzon Cinema in Richmond. Check out the latest blockbuster movies, new Indie film releases and the best of world cinema out now.\",\"seoPageTitle\":\"Curzon Richmond Cinema Showtimes \\u0026 Film Listings\",\"oGType\":\"\",\"twitterCard\":\"\",\"seoUrl\":\"\",\"oGLocale\":\"\",\"excludeFromXmlSitemap\":false,\"excludeFromSiteSearch\":false,\"pageTitle\":\"Curzon Richmond Cinema Showtimes \\u0026 Film Listings\",\"hideTitle\":false,\"grid\":[],\"redirectDetailsElement\":{\"redirect\":false,\"permanent\":false},\"heroCarouselDetailsElement\":[{\"image\":{\"mobile\":\"/media/v3bmqdhf/open.webp?width=393\\u0026height=169\\u0026v=1dc903b9a6542f0\",\"tablet\":\"/media/v3bmqdhf/open.webp?width=782\\u0026height=315\\u0026v=1dc903b9a6542f0\",\"desktop\":\"/media/v3bmqdhf/open.webp?width=1216\\u0026height=523\\u0026v=1dc903b9a6542f0\",\"alt\":\"\"},\"textHeading\":\"ON TUESDAY 3 FEBRUARY OUR VENUES WILL OPEN AT 12PM\"},{\"image\":{\"mobile\":\"/media/1adoetoz/richmond1.jpg?width=393\\u0026height=169\\u0026v=1dbb9e12d265a70\",\"tablet\":\"/media/1adoetoz/richmond1.jpg?width=782\\u0026height=315\\u0026v=1dbb9e12d265a70\",\"desktop\":\"/media/1adoetoz/richmond1.jpg?width=1216\\u0026height=523\\u0026v=1dbb9e12d265a70\",\"alt\":\"\"},\"textHeading\":\"WELCOME TO CURZON RICHMOND\",\"actionLink\":{\"name\":\"take a tour\",\"target\":\"_blank\",\"url\":\"https://tours.360virtualtours.co.uk/curzon/richmond/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/px2iem4l/st-mungos-web.jpg?width=393\\u0026height=169\\u0026v=1dc44fc6573af80\",\"tablet\":\"/media/px2iem4l/st-mungos-web.jpg?width=782\\u0026height=315\\u0026v=1dc44fc6573af80\",\"desktop\":\"/media/px2iem4l/st-mungos-web.jpg?width=1216\\u0026height=523\\u0026v=1dc44fc6573af80\",\"alt\":\"\"},\"textHeading\":\"Support St Mungo\\u0027s on your Curzon cinema visit\",\"actionLink\":{\"name\":\"FIND OUT MORE\",\"url\":\"/charity/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/5c4bhbxo/coffee-cake.jpg?width=393\\u0026height=169\\u0026v=1db9da6ab2ee1f0\",\"tablet\":\"/media/5c4bhbxo/coffee-cake.jpg?width=782\\u0026height=315\\u0026v=1db9da6ab2ee1f0\",\"desktop\":\"/media/5c4bhbxo/coffee-cake.jpg?width=1216\\u0026height=523\\u0026v=1db9da6ab2ee1f0\",\"alt\":\"\"},\"textHeading\":\"Food and drink\",\"actionLink\":{\"name\":\"View Menu\",\"target\":\"_blank\",\"url\":\"/media/u53o0rk2/menu-5_oct2025_updated.pdf\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/x4xl5eof/ph-richmond-1.jpg?width=393\\u0026height=169\\u0026v=1dbb9e13c600ef0\",\"tablet\":\"/media/x4xl5eof/ph-richmond-1.jpg?width=782\\u0026height=315\\u0026v=1dbb9e13c600ef0\",\"desktop\":\"/media/x4xl5eof/ph-richmond-1.jpg?width=1216\\u0026height=523\\u0026v=1dbb9e13c600ef0\",\"alt\":\"\"},\"textHeading\":\"HIRE THIS SPACE\",\"actionLink\":{\"name\":\"HIRE THIS SPACE\",\"url\":\"/private-hire/\"}},{\"image\":{\"mobile\":\"/media/ynnhkvf3/richmond-bar.jpg?width=393\\u0026height=169\\u0026v=1dbdc951accd170\",\"tablet\":\"/media/ynnhkvf3/richmond-bar.jpg?width=782\\u0026height=315\\u0026v=1dbdc951accd170\",\"desktop\":\"/media/ynnhkvf3/richmond-bar.jpg?width=1216\\u0026height=523\\u0026v=1dbdc951accd170\",\"alt\":\"\"},\"textHeading\":\"GET DIRECTIONS\",\"actionLink\":{\"name\":\"VIEW ON MAP\",\"url\":\"https://www.google.com/maps?q=Curzon\\u002BRichmond/@51.4592396,-0.3115151,17z/data=!3m1!4b1!4m5!3m4!1s0x48760c621fa5e10d:0x33798d9fc03cd680!8m2!3d51.4592298!4d-0.3070232\"}}],\"cinemaLocationDetailsElement\":{\"venueCardImage\":{\"mobile\":\"/media/iqnjdlag/cinema-venues-_richmond.jpg?width=300\\u0026height=160\\u0026v=1db99897a3cb610\",\"alt\":\"\"},\"addressLine1\":\"Water lane\",\"city\":\"Richmond\",\"postcode\":\"TW9 1TJ\",\"nearestStationName\":\"Richmond\",\"nearestStationType\":\"underground\"},\"vistaCinema\":{\"key\":\"RIC1\",\"value\":\"Richmond\"},\"informationTabAccordions\":[{\"heading\":\"Opening times\",\"body\":\"\\u003Cp\\u003EThe cinema opens 20 minutes before the first show\\u0027s programme begins every day.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cem\\u003EPlease be aware opening and closing times may be subject to change.\\u003C/em\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Screen Info\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 1\\u003Cbr\\u003E\\u003C/strong\\u003E144 seats, 1 wheelchair space\\u003C/p\\u003E\"},{\"heading\":\"Accessibility\",\"body\":\"\\u003Cp\\u003EThe venue is fully wheelchair-accessible and hosts weekly captioned Hard of Hearing screenings. There is a wheelchair-accessible bathroom.\\u003C/p\\u003E\"},{\"heading\":\"Food and Drink\",\"body\":\"\\u003Cp\\u003EOur drinks menu includes a wide selection of cocktails, wine, craft beer, soft drinks and hot drinks.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022/media/u53o0rk2/menu-5_oct2025_updated.pdf\\u0022 target=\\u0022_blank\\u0022 title=\\u0022Menu 5 Oct2025 Updated\\u0022\\u003ESee our full menu.\\u003C/a\\u003E\\u003C/span\\u003E\\u003C/p\\u003E\"},{\"heading\":\"HAPPY HOUR INFORMATION\",\"body\":\"\\u003Cp\\u003EAt this venue Happy Hour is 5pm to 10pm every day, 2 for \\u00A316 on all cocktails.\\u003C/p\\u003E\"},{\"heading\":\"Private hires\",\"body\":\"\\u003Cp\\u003EOur screens are available to rent for your private functions, email \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca href=\\u0022mailto:privatehires@curzon.com\\u0022\\u003Eprivatehires@curzon.com\\u003C/a\\u003E\\u003C/span\\u003E for more information.\\u003C/p\\u003E\\n\\u003Cp\\u003ETo find out more, visit our \\u003Ca href=\\u0022/private-hire/richmond/\\u0022 title=\\u0022Richmond\\u0022\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003EPrivate Hires page\\u003C/span\\u003E.\\u003C/a\\u003E\\u003C/p\\u003E\"},{\"heading\":\"social media\",\"body\":\"\\u003Cp\\u003EInstagram: \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022https://www.instagram.com/curzonrichmond?igsh=MWR5a201bDN2eWpkNg==\\u0022 target=\\u0022_blank\\u0022 data-anchor=\\u0022?igsh=MWR5a201bDN2eWpkNg==\\u0022\\u003Ecurzonrichmond\\u003C/a\\u003E\\u003C/span\\u003E\\u003C/p\\u003E\"}],\"informationTabDescription\":\"\\u003Cp\\u003EThis grand cinema, which was built in 1914, is designed in the manner of a theatre, and features an auditorium adorned with ornate pillars and heavy curtains shielding the screen. Located on a quaint cobblestone street on the banks of the Thames, Curzon Richmond is a distinctive venue steeped in film history.\\u003C/p\\u003E\",\"menuTabAccordions\":[{\"heading\":\"Snacks\",\"body\":\"\\u003Ctable border=\\u00221\\u0022 style=\\u0022border-collapse: collapse; width: 100%; height: 92.5px;\\u0022\\u003E\\n\\u003Ctbody\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18.5px;\\u0022\\u003EHummus \\u0026amp; Crispbread (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A36.25\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18.5px;\\u0022\\u003ENocellara Olives (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A34.75\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18.5px;\\u0022\\u003EJude\\u0027s Ice Cream\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18.5px; text-align: right;\\u0022\\u003E\\u00A33.90\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18.5px;\\u0022\\u003ESnacks\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18.5px; text-align: right;\\u0022\\u003Efrom \\u00A34.25\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003C/tbody\\u003E\\n\\u003C/table\\u003E\"},{\"heading\":\"Cakes \\u0026 Cookies\",\"body\":\"\\u003Ctable border=\\u00221\\u0022 style=\\u0022border-collapse: collapse; width: 100%; height: 72px;\\u0022\\u003E\\n\\u003Ctbody\\u003E\\n\\u003Ctr style=\\u0022height: 18px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18px;\\u0022\\u003ESelection of cakes, traybakes \\u0026amp; cookies\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18px; text-align: right;\\u0022\\u003Efrom \\u00A33.10\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18px;\\u0022\\u003ECoffee \\u0026amp; Cake Deal (Monday - Friday before 5PM)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18px; text-align: right;\\u0022\\u003E\\u00A36.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003C/tbody\\u003E\\n\\u003C/table\\u003E\"},{\"heading\":\"Cocktails \\u0026 Spirits\",\"body\":\"\\u003Ctable border=\\u00221\\u0022 style=\\u0022border-collapse: collapse; width: 100%; height: 574.697px;\\u0022\\u003E\\n\\u003Ctbody\\u003E\\n\\u003Ctr style=\\u0022height: 18.4983px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18.4983px;\\u0022\\u003E\\u00