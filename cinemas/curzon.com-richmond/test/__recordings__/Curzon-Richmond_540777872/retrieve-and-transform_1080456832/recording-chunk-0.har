          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-02-22\",\"showtimes\":[{\"id\":\"RIC1-16571\",\"schedule\":{\"businessDate\":\"2026-02-22\",\"startsAt\":\"2026-02-22T11:00:00+00:00\",\"endsAt\":\"2026-02-22T13:00:00+00:00\",\"filmStartsAt\":\"2026-02-22T11:25:00+00:00\",\"filmEndsAt\":\"2026-02-22T13:00:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006803\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006803\",\"title\":{\"text\":\"Film Club: Let the Sunshine In\",\"translations\":[]},\"synopsis\":{\"text\":\"The world’s most renowned female director, Claire Denis (Beau Travail, White Material), delivers a refreshingly honest tale of a middle-aged woman’s quest for love in her witty and heart-warming new film, Let the Sunshine In.\\n\\nIsabelle (Juliette Binoche) is a stylish and accomplished artist living in Paris. Divorced and looking to find true love at last, she meets a handsome, kind and intelligent younger man who she thinks might finally be the one. But when he calls their affair a mistake and returns to his wife, Isabelle must again face the issue of mid-life loneliness. Sifting through former lovers, new admirers, jealous friends and chance encounters, will she find a fulfilling match? Or will she discover a new path to happiness along the way?\\n\\nLed by an outstanding performance by the incomparable Juliette Binoche, and featuring a scene-stealing appearance by Gérard Depardieu, Let the Sunshine In is a truly unique, touching and beautifully relatable piece of cinema from one of the world’s greatest living filmmakers.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Isabelle, Parisian artist, divorced mother, is looking for love, true love at last.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong sex, sex references\",\"translations\":[]},\"releaseDate\":\"2026-02-14\",\"runtimeInMinutes\":95,\"trailerUrl\":\"https://www.youtube.com/watch?v=KSFyyh-kqnE\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003248\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003693\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003869\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000009124\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010739\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013243\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013244\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013245\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013246\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013247\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013248\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013249\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\",\"0000000003\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006803\",\"hoCode\":\"A000008394\",\"eventId\":null,\"distributorName\":\"Curzon\"}],\"castAndCrew\":[{\"id\":\"0000003240\",\"name\":{\"givenName\":\"Juliette\",\"familyName\":\"Binoche\",\"middleName\":null}},{\"id\":\"0000003248\",\"name\":{\"givenName\":\"Olivier  \",\"familyName\":\"Delbosc\",\"middleName\":null}},{\"id\":\"0000003693\",\"name\":{\"givenNam