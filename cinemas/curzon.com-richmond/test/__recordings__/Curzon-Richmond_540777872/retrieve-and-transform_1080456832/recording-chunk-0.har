          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-05-30\",\"showtimes\":[{\"id\":\"RIC1-15396\",\"schedule\":{\"businessDate\":\"2026-05-30\",\"startsAt\":\"2026-05-30T18:00:00+01:00\",\"endsAt\":\"2026-05-30T21:15:00+01:00\",\"filmStartsAt\":\"2026-05-30T18:25:00+01:00\",\"filmEndsAt\":\"2026-05-30T21:15:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006241\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006241\",\"title\":{\"text\":\"Met Opera 2026: El Último Sueño de Frida y Diego\",\"translations\":[]},\"synopsis\":{\"text\":\"On May 30, the Metropolitan Opera’s 2025–26 Live in HD season comes to a close with a live transmission of American composer Gabriela Lena Frank’s first opera, a magical-realist portrait of Mexico’s painterly power couple Frida Kahlo and Diego Rivera, with libretto by Pulitzer Prize–winning playwright Nilo Cruz. Fashioned as a reversal of the Orpheus and Euridice myth, the story depicts Frida, sung by leading mezzo-soprano Isabel Leonard, leaving the underworld on the Day of the Dead and reuniting with Diego, portrayed by baritone Carlos Álvarez. The famously feuding pair briefly relive their tumultuous love, embracing both the passion and the pain before bidding the land of the living a final farewell. Music Director Yannick Nézet-Séguin conducts the Met-premiere staging of Frank’s opera, a “confident, richly imagined score” (The New Yorker) that “bursts with color and fresh individuality” (Los Angeles Times). The vibrant new production, taking enthusiastic inspiration from Frida and Diego’s paintings, is directed and choreographed by Deborah Colker.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"On May 30, the Metropolitan Opera’s 2025–26 Live in HD season comes to a close with a\\nlive transmission of American composer Gabriela Lena Frank’s first opera, a magical-\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-05-30\",\"runtimeInMinutes\":170,\"trailerUrl\":null,\"displayPriority\":68,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001489\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001562\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001569\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003664\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000634\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000635\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c4f6fe03-3def-4e0e-b94b-05e9c03edcfe\",\"corporateId\":null},\"hopk\":\"HO00006241\",\"hoCode\":\"A000007699\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000001489\",\"name\":{\"givenName\":\"Carlos\",\"familyName\":\"Álvarez\",\"middleName\":null}},{\"id\":\"0000001562\",\"name\":{\"givenName\":\"Yannick\",\"familyName\":\"Nézet-Séguin\",\"middleName\":null}},{\"id\":\"0000001569\",\"name\":{\"givenName\":\"Isabel\",\"familyName\":\"Leonard\",\"middleName\":null}},{\"id\":\"0000003664\",\"name\":{\"givenName\":\"Gabriella\",\"familyName\":\"Reyes\",\"middleName\":null}},{\"id\":\"HO00000634\",\"name\":{\"givenName\":\"Nils\",\"familyName\":\"Wanderer\",\"middleName\":null}},{\"id\":\"HO00000635\",\"name\":{\"givenName\":\"Deborah\",\"familyName\":\"Colker\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000003\",\"name\":{\"text\":\"Live event\",\"translations\":[]},\"shortName\":{\"text\":\"Live\",\"translations\":[]},\"description\":{\"text\":\"Live Via Satellite\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"RIC1-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000043\",\"name\":{\"text\":\"THE MET: LIVE IN HD\",\"translations\":[]},\"shortName\":{\"text\":\"THE MET\",\"translations\":[]},\"description\":{\"text\":\"The Met Opera returns to Curzon featuring performances transmitted live from the New York stage to cinemas worldwide.\",\"translations\":[]},\"schedule\":{\"startDate\":\"2025-10-18\",\"endDate\":\"2026-05-30\"},\"siteIds\":[\"BLO1\",\"CAM1\",\"CAN01\",\"COL1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SHE1\",\"VIC1\",\"WIM01\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"RIC1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
