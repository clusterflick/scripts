            "text": "{\"businessDate\":\"2025-11-21\",\"showtimes\":[{\"id\":\"RIC1-16164\",\"schedule\":{\"businessDate\":\"2025-11-21\",\"startsAt\":\"2025-11-21T11:15:00+00:00\",\"endsAt\":\"2025-11-21T13:57:00+00:00\",\"filmStartsAt\":\"2025-11-21T11:40:00+00:00\",\"filmEndsAt\":\"2025-11-21T13:57:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006408\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"RIC1-109-HO00006408\"},{\"id\":\"RIC1-16163\",\"schedule\":{\"businessDate\":\"2025-11-21\",\"startsAt\":\"2025-11-21T14:15:00+00:00\",\"endsAt\":\"2025-11-21T16:57:00+00:00\",\"filmStartsAt\":\"2025-11-21T14:40:00+00:00\",\"filmEndsAt\":\"2025-11-21T16:57:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006408\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"RIC1-109-HO00006408\"},{\"id\":\"RIC1-16162\",\"schedule\":{\"businessDate\":\"2025-11-21\",\"startsAt\":\"2025-11-21T17:15:00+00:00\",\"endsAt\":\"2025-11-21T19:57:00+00:00\",\"filmStartsAt\":\"2025-11-21T17:40:00+00:00\",\"filmEndsAt\":\"2025-11-21T19:57:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006408\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"RIC1-109-HO00006408\"},{\"id\":\"RIC1-16161\",\"schedule\":{\"businessDate\":\"2025-11-21\",\"startsAt\":\"2025-11-21T20:15:00+00:00\",\"endsAt\":\"2025-11-21T22:57:00+00:00\",\"filmStartsAt\":\"2025-11-21T20:40:00+00:00\",\"filmEndsAt\":\"2025-11-21T22:57:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006408\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"RIC1-109-HO00006408\"}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006408\",\"title\":{\"text\":\"Wicked: For Good\",\"translations\":[]},\"synopsis\":{\"text\":\"Last year’s global cinematic cultural sensation, which became the most successful Broadway film adaptation of all time, now reaches its epic, electrifying, emotional conclusion in Wicked: For Good. \\n\\nDirected once again by award-winning director Jon M. Chu and starring the spectacular returning cast, led by Academy Award® nominated superstars Cynthia Erivo and Ariana Grande, the final chapter of the untold story of the witches of Oz begins with Elphaba and Glinda estranged and living with the consequences of their choices. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"And now whatever way our stories end, I know you have rewritten mine by being my friend …\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-21\",\"runtimeInMinutes\":137,\"trailerUrl\":\"https://www.youtube.com/watch?v=a1l5pm5YHQ8\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000269\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000376\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002344\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003143\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005151\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008505\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008691\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008692\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008694\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008695\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000007\",\"0000000028\",\"0000000032\"],\"externalIds\":{\"moviexchangeReleaseId\":\"cd2537dd-7157-4e64-876e-d26f4d203c1a\",\"corporateId\":null},\"hopk\":\"HO00006408\",\"hoCode\":\"A000007909\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"}],\"castAndCrew\":[{\"id\":\"0000000269\",\"name\":{\"givenName\":\"Marc\",\"familyName\":\"Platt\",\"middleName\":null}},{\"id\":\"0000000376\",\"name\":{\"givenName\":\"Jon M.\",\"familyName\":\"Chu\",\"middleName\":null}},{\"id\":\"0000001355\",\"name\":{\"givenName\":\"Michelle \",\"familyName\":\"Yeoh\",\"middleName\":null}},{\"id\":\"0000002344\",\"name\":{\"givenName\":\"Ariana\",\"familyName\":\"Grande\",\"middleName\":null}},{\"id\":\"0000003143\",\"name\":{\"givenName\":\"Jeff\",\"familyName\":\"Goldblum\",\"middleName\":null}},{\"id\":\"0000005151\",\"name\":{\"givenName\":\"Cynthia\",\"familyName\":\"Erivo\",\"middleName\":null}},{\"id\":\"0000008505\",\"name\":{\"givenName\":\"Bowen\",\"familyName\":\"Yang\",\"middleName\":null}},{\"id\":\"0000008691\",\"name\":{\"givenName\":\"Marissa\",\"familyName\":\"Bode\",\"middleName\":null}},{\"id\":\