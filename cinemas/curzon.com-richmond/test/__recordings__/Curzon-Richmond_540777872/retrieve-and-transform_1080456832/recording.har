            "text": "{\"businessDate\":\"2025-11-10\",\"showtimes\":[{\"id\":\"RIC1-16131\",\"schedule\":{\"businessDate\":\"2025-11-10\",\"startsAt\":\"2025-11-10T18:00:00+00:00\",\"endsAt\":\"2025-11-10T20:18:00+00:00\",\"filmStartsAt\":\"2025-11-10T18:25:00+00:00\",\"filmEndsAt\":\"2025-11-10T20:18:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006544\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"RIC1-108-HO00006544\"},{\"id\":\"RIC1-16225\",\"schedule\":{\"businessDate\":\"2025-11-10\",\"startsAt\":\"2025-11-10T20:40:00+00:00\",\"endsAt\":\"2025-11-10T23:05:00+00:00\",\"filmStartsAt\":\"2025-11-10T21:05:00+00:00\",\"filmEndsAt\":\"2025-11-10T23:05:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006510\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006510\",\"title\":{\"text\":\"Palestine 36\",\"translations\":[]},\"synopsis\":{\"text\":\"In 1936, as Palestinian villages revolt against British colonial rule, Yusuf navigates between Jerusalem and his rural home, amidst escalating unrest and a pivotal moment for the British Empire.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In 1936, as Palestinian villages revolt against British colonial rule, Yusuf navigates between Jerusalem and his rural home, amidst escalating unrest.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate violence, threat, upsetting scenes\",\"translations\":[]},\"releaseDate\":\"2025-10-31\",\"runtimeInMinutes\":120,\"trailerUrl\":\"https://www.youtube.com/watch?v=wWtwnae_5UI\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001984\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005181\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005656\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008938\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009674\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009923\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012329\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012426\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012427\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012428\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012429\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5e7856c1-ef40-4815-a376-a9ded2d939e2\",\"corporateId\":null},\"hopk\":\"HO00006510\",\"hoCode\":\"A000008046\",\"eventId\":null,\"distributorName\":\"Curzon\"},{\"id\":\"HO00006544\",\"title\":{\"text\":\"The Choral\",\"translations\":[]},\"synopsis\":{\"text\":\"1916. As war rages on the Western Front, the Choral Society in Ramsden, Yorkshire has lost most of its men to the army. The Choral’s ambitious committee, determined to press ahead, decides to recruit local young males to swell their ranks. They must also engage a new chorus master, and despite their suspicions that he has something to hide, their best bet seems to be Dr. Henry Guthrie (Ralph Fiennes) – driven, uncompromising, and recently returned from a career in Germany. As conscription papers start to arrive, the whole community discovers that the best response to the chaos that is laying waste to their lives is to make music together.\\n\\n \\n\\nDirected by BAFTA, Olivier and Tony Award winner NICHOLAS HYTNER (The Crucible) and written by BAFTA, Olivier and Tony Award winner ALAN BENNETT, The Choral marks their fourth writer-director collaboration following the acclaimed films The Madness of King George, The History Boys, and The Lady in The Van.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"1916. As war rages on the Western Front, the Choral Society in Ramsden, Yorkshire has lost most of its men to the army. \",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate sex\",\"translations\":[]},\"releaseDate\":\"2025-11-07\",\"runtimeInMinutes\":113,\"trailerUrl\":\"https://www.youtube.com/watch?v=6zRVP-ZgMm8\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001270\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002005\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000002637\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003200\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003976\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009275\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012489\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012490\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"11244\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"f1ef9670-f7cd-4a13-bd6c-bd711489b3b6\",\"corporateId\":null},\"hopk\":\"HO00006544\",\"hoCode\":\"A000008085\",\"eventId\":null,\"distributorName\":\"Sony Pictures\"}],\"castAndCrew\":[{\"id\":\"0000001984\",\"name\":{\"givenName\":\"Jeremy\",\"familyName\":\"Irons\",\"midd