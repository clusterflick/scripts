            "text": "{\"businessDate\":\"2025-11-30\",\"showtimes\":[{\"id\":\"RIC1-15830\",\"schedule\":{\"businessDate\":\"2025-11-30\",\"startsAt\":\"2025-11-30T14:40:00+00:00\",\"endsAt\":\"2025-11-30T17:30:00+00:00\",\"filmStartsAt\":\"2025-11-30T15:00:00+00:00\",\"filmEndsAt\":\"2025-11-30T17:30:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006432\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"RIC1-16152\",\"schedule\":{\"businessDate\":\"2025-11-30\",\"startsAt\":\"2025-11-30T19:50:00+00:00\",\"endsAt\":\"2025-11-30T22:30:00+00:00\",\"filmStartsAt\":\"2025-11-30T20:10:00+00:00\",\"filmEndsAt\":\"2025-11-30T22:30:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006567\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006432\",\"title\":{\"text\":\"Pulling Focus: Triangle of Sadness\",\"translations\":[]},\"synopsis\":{\"text\":\"This outrageous comedy finds a rogues’ gallery of wealthy guests (from business tycoons to heiresses) aboard a hyper-luxury yacht, whose downtrodden staff – under the command of their captain and avowed Marxist (Woody Harrelson) – must respond to their every belittling whim in the hope of winning tips. Among the super-rich patrons are the oh-so-beautiful couple Carl (Harris Dickinson) and Yaya (Charlbi Dean), two models and social-media influencers who have been invited on a free trip to show off the kind of lavish lifestyle many could only dream of. \\r\\n\\r\\nPulling Focus—a collaboration showcasing the refreshed Volvo XC60, with a celebration of classic and contemporary Swedish cinema. curzon.com/volvo\\r\\n\\r\\nComplimentary glögg and a cinnamon bun will be served at all Pulling Focus screenings. Skål!\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Two-time Palme d’Or winner Ruben Östlund cements his position as contemporary cinema’s leading satirist with this savagely funny tale of class clashes and role reversals.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, crude humour, brief sex\",\"translations\":[]},\"releaseDate\":\"2025-11-22\",\"runtimeInMinutes\":150,\"trailerUrl\":\"https://www.youtube.com/watch?v=jRwtXvUWYmA\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000451\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001703\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002419\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003322\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004113\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004114\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004115\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004116\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004117\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004118\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004119\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004120\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004121\",\"roles\":[\"Acto