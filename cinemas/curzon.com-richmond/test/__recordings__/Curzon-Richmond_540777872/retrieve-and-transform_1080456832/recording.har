        "response": {
          "bodySize": 1966,
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 1966,
            "text": "{\"businessDate\":\"2025-12-27\",\"showtimes\":[{\"id\":\"RIC1-16219\",\"schedule\":{\"businessDate\":\"2025-12-27\",\"startsAt\":\"2025-12-27T14:30:00+00:00\",\"endsAt\":\"2025-12-27T16:37:00+00:00\",\"filmStartsAt\":\"2025-12-27T14:55:00+00:00\",\"filmEndsAt\":\"2025-12-27T16:37:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006632\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006632\",\"title\":{\"text\":\"Film Club: The Wizard of Oz\",\"translations\":[]},\"synopsis\":{\"text\":\"“The Wizard of Oz is a film with very great power… And it’s to be expected that it has stayed with us for the past several years and that we find its echoes in our films for such a long time after. The Wizard of Oz is like a dream and it has immense emotional power... There’s a certain amount of fear in that picture, as well as things to dream about. So it seems truthful in some way.” -- David Lynch\\r\\n\\r\\nScreening as part of our David Lynch season, the Wizard of Oz is referenced overtly or obliquely in almost every one of his films. It is a truly timeless film whose appeal cuts across age groups and levels of movie fandom. \\r\\n\\r\\nDorothy Gale is swept away from a farm in Kansas to a magical land of Oz in a tornado and embarks on a quest with her new friends to see the Wizard who can help her return home in Kansas and help her friends as well. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Dorothy Gale is swept away from a farm in Kansas to a magical land of Oz. Screening as part of our David Lynch season.\",\"translations\":[]},\"censorRatingId\":\"HO00000001\",\"censorRatingNote\":{\"text\":\"mild fantasy threat, scary sequences\",\"translations\":[]},\"releaseDate\":\"2025-12-06\",\"runtimeInMinutes\":102,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000009309\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009310\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009311\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009312\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000009313\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000009314\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000007\",\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006632\",\"hoCode\":\"A000008186\",\"eventId\":null,\"distributorName\":\"Park Circus\"}],\"castAndCrew\":[{\"id\":\"0000009309\",\"name\":{\"givenName\":\"Judy\",\"familyName\":\"Garland\",\"middleName\":null}},{\"id\":\"0000009310\",\"name\":{\"givenName\":\"Frank\",\"familyName\":\"Morgan\",\"middleName\":null}},{\"id\":\"0000009311\",\"name\":{\"givenName\":\"Ray\",\"familyName\":\"Bolger\",\"middleName\":null}},{\"id\":\"0000009312\",\"name\":{\"givenName\":\"Victor\",\"familyName\":\"Flemming\",\"middleName\":null}},{\"id\":\"0000009313\",\"name\":{\"givenName\":\"George\",\"familyName\":\"Cukor\",\"middleName\":null}},{\"id\":\"0000009314\",\"name\":{\"givenName\":\"Mervyn\",\"familyName\":\"LeRoy\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000007\",\"name\":{\"text\":\"Family\",\"translations\":[]},\"description\":null},{\"id\":\"0000000028\",\"name\":{\"text\":\"Fantasy\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"HO00000001\",\"cla