            "text": "{\"businessDate\":\"2025-11-20\",\"showtimes\":[{\"id\":\"RIC1-16211\",\"schedule\":{\"businessDate\":\"2025-11-20\",\"startsAt\":\"2025-11-20T17:30:00+00:00\",\"endsAt\":\"2025-11-20T23:13:00+00:00\",\"filmStartsAt\":\"2025-11-20T17:55:00+00:00\",\"filmEndsAt\":\"2025-11-20T20:35:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006621\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000062\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006621\",\"title\":{\"text\":\"Wicked: Double Bill\",\"translations\":[]},\"synopsis\":{\"text\":\"Last year’s global cinematic cultural sensation, which became the most successful Broadway film adaptation of all time, now reaches its epic, electrifying, emotional conclusion in Wicked: For Good. \\n\\nDirected once again by award-winning director Jon M. Chu and starring the spectacular returning cast, led by Academy Award® nominated superstars Cynthia Erivo and Ariana Grande, the final chapter of the untold story of the witches of Oz begins with Elphaba and Glinda estranged and living with the consequences of their choices. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Follows Elphaba, the future Wicked Witch of the West, and her relationship with Glinda, the Good Witch of the North. The second of a two-part feature film adaptation.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRati