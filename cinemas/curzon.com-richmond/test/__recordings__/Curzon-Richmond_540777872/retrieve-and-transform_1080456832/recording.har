            "text": "{\"businessDate\":\"2026-02-09\",\"showtimes\":[{\"id\":\"RIC1-15384\",\"schedule\":{\"businessDate\":\"2026-02-09\",\"startsAt\":\"2026-02-09T19:15:00+00:00\",\"endsAt\":\"2026-02-09T23:10:00+00:00\",\"filmStartsAt\":\"2026-02-09T19:40:00+00:00\",\"filmEndsAt\":\"2026-02-09T23:10:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006230\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000042\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006230\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: Woolf Works\",\"translations\":[]},\"synopsis\":{\"text\":\"Virginia Woolf defied literary conventions to depict rich inner worlds – her heightened, startling and poignant reality. Resident Choreographer Wayne McGregor leads a luminous artistic team to evoke Woolf’s signature stream of consciousness writing style in this immense work that rejects traditional narrative structures. Woolf Works is a collage of themes from Mrs Dalloway, Orlando, The Waves and Woolf’s other writings. Created in 2015 for The Royal Ballet, this Olivier-award winning ballet triptych captures the heart of Woolf’s uniquely artistic spirit.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Virginia Woolf defied literary conventions to depict rich inner worlds – her heightened, startling and poignant reality. \",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-09\",\"runtimeInMinutes\":210,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"HO00000605\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"f7dfcce7-7f8a-4e54-a9e6-b6bba820a310\",\"corporateId\":null},\"hopk\":\"HO00006230\",\"hoCode\":\"A000007687\",\"eventId\":\"0000000042\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"HO00000605\",\"name\":{\"givenName\":\"Wayne\",\"familyName\":\"McGregor\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"HO00000004\",\"classification\":{\"text\":\"12A\",\"translations\":[]},\"classificationDescription\":{\"text\":\"12A\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000003\",\"name\":{\"text\":\"Live event\",\"translations\":[]},\"shortName\":{\"text\":\"Live\",\"translations\":[]},\"description\":{\"text\":\"Live Via Satellite\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"RIC1-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000042\",\"name\":{\"text\":\"Royal Ballet and Opera\",\"translations\":[]},\"shortName\":{\"text\":\"RB&O\",\"translations\":[]},\"description\":{\"text\":\"The Royal Ballet and Opera brings the thrill of world-class theatre to cinema screens right around the globe. \\n\\nWith productions across both Companies, the programme includes beloved classics as well as new productions.\\n\\nOffering audiences a view from the best seat in the house, the programme shares the joy of live performance, and the beauty of world-class art with cinemagoers in more than 1,500 cinemas and 50 countries around the world.\\n\",\"translations\