            "text": "{\"businessDate\":\"2025-12-10\",\"showtimes\":[{\"id\":\"RIC1-15382\",\"schedule\":{\"businessDate\":\"2025-12-10\",\"startsAt\":\"2025-12-10T19:15:00+00:00\",\"endsAt\":\"2025-12-10T23:10:00+00:00\",\"filmStartsAt\":\"2025-12-10T19:40:00+00:00\",\"filmEndsAt\":\"2025-12-10T23:10:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006228\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000042\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006228\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: The Nutcracker\",\"translations\":[]},\"synopsis\":{\"text\":\"The magician Herr Drosselmeyer needs to save his nephew. Hans-Peter has been transformed into a Nutcracker; the only way to save him is for the Nutcracker to defeat the Mouse King and find a girl to love and care for him. A flicker of hope comes in the form of the young Clara, whom Drosselmeyer meets at a Christmas party. With some magic, a cosy Christmas gathering turns into a marvellous adventure. \\nPeter Wright’s The Nutcracker has enchanted audiences since its 1984 premiere by the Company. Featuring Tchaikovsky’s most familiar melodies and brought to life by Julia Trevelyan Oman’s exquisite designs, The Nutcracker is sure to be a festive firecracker for all ages.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The magician Herr Drosselmeyer needs to save his nephew. Hans-Peter has been transformed into a Nutcracker.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-10\",\"runtimeInMinutes\":210,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"HO00000292\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b3549712-da50-415c-811f-783459340cae\",\"corporateId\":null},\"hopk\":\"HO00006228\",\"hoCode\":\"A000007685\",\"eventId\":\"0000000042\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"HO00000292\",\"name\":{\"givenName\":\"Peter \",\"familyName\":\"Wright\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"HO00000004\",\"classification\":{\"text\":\"12A\",\"translations\":[]},\"classificationDescription\":{\"text\":\"12A\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000003\",\"name\":{\"text\":\"Live event\",\"translations\":[]},\"shortName\":{\"text\":\"Live\",\"translations\":[]},\"description\":{\"text\":\"Live Via Satellite\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"RIC1-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000042\",\"name\":{\"text\":\"Royal Ballet and Opera\",\"translations\":[]},\"shortName\":{\"text\":\"RB&O\",\"translations\":[]},\"description\":{\"text\":\"The Royal Ballet and Opera brings the thrill of world-class theatre to cinema screens right around the globe. \\n\\nWith productions across both Companies, the programme includes beloved classics as well as new productions.\\n\\nOffering audiences a view from the best seat in the house, the programme shares the joy of live performance, and the beauty of world-class