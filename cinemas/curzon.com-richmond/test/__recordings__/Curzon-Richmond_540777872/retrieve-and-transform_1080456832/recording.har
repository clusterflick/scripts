            "text": "{\"businessDate\":\"2026-09-04\",\"showtimes\":[{\"id\":\"RIC1-15604\",\"schedule\":{\"businessDate\":\"2026-09-04\",\"startsAt\":\"2026-09-04T19:00:00+01:00\",\"endsAt\":\"2026-09-04T21:17:00+01:00\",\"filmStartsAt\":\"2026-09-04T19:25:00+01:00\",\"filmEndsAt\":\"2026-09-04T21:25:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006045\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006045\",\"title\":{\"text\":\"NT Live: Inter Alia\",\"translations\":[]},\"synopsis\":{\"text\":\"Oscar-nominated Rosamund Pike (Gone Girl, Saltburn) is Jessica in the much-anticipated next play from the team behind Prima Facie.      Jessica Parks is a smart Crown Court Judge at the top of her career. Behind the robe, she is a karaoke fiend, a loving wife and a supportive parent. When an event threatens to throw her life completely off balance, can she hold her family upright? \\nWriter Suzie Miller and director Justin Martin reunite following their global phenomenon Prima Facie, with this searing examination of modern motherhood and masculinity.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Oscar-nominated Rosamund Pike (Gone Girl, Saltburn) is Jessica in the much-anticipated next play from the team behind Prima Facie.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"t