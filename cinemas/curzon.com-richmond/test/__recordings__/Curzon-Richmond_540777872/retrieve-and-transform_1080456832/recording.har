            "text": "{\"businessDate\":\"2026-01-22\",\"showtimes\":[{\"id\":\"RIC1-15605\",\"schedule\":{\"businessDate\":\"2026-01-22\",\"startsAt\":\"2026-01-22T19:00:00+00:00\",\"endsAt\":\"2026-01-22T22:25:00+00:00\",\"filmStartsAt\":\"2026-01-22T19:25:00+00:00\",\"filmEndsAt\":\"2026-01-22T22:25:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006324\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000032\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000031\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006324\",\"title\":{\"text\":\"National Theatre Live: Hamlet\",\"translations\":[]},\"synopsis\":{\"text\":\"Olivier Award-winner Hiran Abeysekera (Life of Pi) is Hamlet in this fearless, contemporary take on Shakespeare’s famous tragedy.\\n\\nTrapped between duty and doubt, surrounded by power and privilege, young Prince Hamlet dares to ask the ultimate question – you know the one.\\n\\nNational Theatre Deputy Artistic Director, Robert Hastie (Standing at the Sky’s Edge, Operation Mincemeat) directs this sharp, stylish and darkly funny reimagining.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Trapped between duty and doubt, surrounded by power and privilege, young Prince Hamlet dares to ask the ultimate question – you know the one.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-22\",\"runtimeInMinutes\":180,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"HO00000637\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000638\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000002\",\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"6f82b1be-34df-4673-aa1a-195a2cacf7cc\",\"corporateId\":null},\"hopk\":\"HO00006324\",\"hoCode\":\"A000007802\",\"eventId\":\"0000000031\",\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"HO00000637\",\"name\":{\"givenName\":\"Hiran\",\"familyName\":\"Abeysekera\",\"middleName\":null}},{\"id\":\"HO00000638\",\"name\":{\"givenName\":\"Robert\",\"familyName\":\"Hastie\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":{\"text\":\"Drama\",\"translations\":[]}},{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000032\",\"name\":{\"text\":\"Recorded Performance\",\"translations\":[]},\"shortName\":{\"text\":\"Recorded\",\"translations\":[]},\"description\":{\"text\":\"Prerecorded Q&A\",\"translations\":[]},\"importantMessage\":{\"text\":\"Prerecorded Q&A\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"RIC1-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000031\",\"name\":{\"text\":\"NT Live\",\"translations\":[]},\"shortName\":{\"text\":\"NT Live\",\"translations\":[]},\"description\":{\"text\":\"National Theatre Live brings the best of British theatre to cinema screens across the UK and around the world. With state-of-the-art filming techniques, tailored to every play, we bring you each performance as it happens, in all its glory. From close-ups that capture every flicker of emotion, to sweeping wide shots of the stage. Whether you come along to the live broadcast, or catch one of many replays, you’ll have the best seats in the house.\",\"translations\":[]},\"schedule\":{\"startDate\":\"2024-01-01\",\"endDate\":\"2099-12-31\"},\"siteIds\":[\"ALD1\",\"BLO1\",\"CAM1\",\"CAN01\",\"CAN2\",\"COL1\",\"HOX1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SHE1\",\"SOH1\",\"VIC1\",\"WIM01\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"RIC1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}"
