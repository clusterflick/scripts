          "bodySize": 2179,
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 2179,
            "text": "{\"businessDate\":\"2025-12-06\",\"showtimes\":[{\"id\":\"RIC1-16217\",\"schedule\":{\"businessDate\":\"2025-12-06\",\"startsAt\":\"2025-12-06T14:35:00+00:00\",\"endsAt\":\"2025-12-06T17:21:00+00:00\",\"filmStartsAt\":\"2025-12-06T15:00:00+00:00\",\"filmEndsAt\":\"2025-12-06T17:21:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006629\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006629\",\"title\":{\"text\":\"Film Club: Mulholland Drive\",\"translations\":[]},\"synopsis\":{\"text\":\"Beautiful, bizarre and strangely addictive, the film begins as a botched hit which results in the meeting of brunette amnesiac Rita (Laura Harring – Love in the Time of Cholera) and blonde would-be Hollywood actress Betty (Naomi Watts – Birdman, 21 Grams).  Taking the viewer on a memorable neo-noir trip through Hollywood’s dark underbelly, Lynch dispenses with a conventional narrative in favour of a hallucinogenic assault on the senses that will stay with you long after the credits roll. \\n\\nRecently voted the best film of the 21st Century in a BBC Culture poll, MULHOLLAND DRIVE is essential viewing by one of the masters of contemporary American cinema.  David Lynch’s scary and seductive vision of Hollywood is a true masterpiece, weaving together a tale of love, jealousy, and revenge like no other.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"David Lynch’s scary and seductive vision of Hollywood is a true masterpiece, weaving together a tale of love, jealousy, and revenge like no other.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"Contains strong language and moderate sex and violence\",\"translations\":[]},\"releaseDate\":\"2025-11-30\",\"runtimeInMinutes\":141,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001687\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005927\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005932\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010928\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010929\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010930\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010931\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010932\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010933\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010934\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010935\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010936\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010937\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010938\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006629\",\"hoCode\":\"A000008182\",\"eventId\":null,\"distributorName\":\"Park Circus\"}],\"castAndCrew\":[{\"id\":\"0000001687\",\"name\":{\"givenName\":\"David\",\"familyName\":\"Lynch\",\"middleName\":null}},{\"id\":\"0000005927\",\"name\":{\"givenName\":\"Justin \",\"familyName\":\"Theroux\",\"middleName\":null}},{\"id\":\"0000005932\",\"name\":{\"givenName\":\"Mary\",\"familyName\":\"Sweeney\",\"middleName\":null}},{\"id\":\"0000010928\",\"name\":{\"givenName\":\"Robert\",\"familyName\":