            "text": "{\"businessDate\":\"2025-11-25\",\"showtimes\":[{\"id\":\"RIC1-15914\",\"schedule\":{\"businessDate\":\"2025-11-25\",\"startsAt\":\"2025-11-25T13:00:00+00:00\",\"endsAt\":\"2025-11-25T15:40:00+00:00\",\"filmStartsAt\":\"2025-11-25T13:25:00+00:00\",\"filmEndsAt\":\"2025-11-25T15:40:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006528\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000048\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"RIC1-16156\",\"schedule\":{\"businessDate\":\"2025-11-25\",\"startsAt\":\"2025-11-25T16:10:00+00:00\",\"endsAt\":\"2025-11-25T18:52:00+00:00\",\"filmStartsAt\":\"2025-11-25T16:35:00+00:00\",\"filmEndsAt\":\"2025-11-25T18:52:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006408\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"RIC1-109-HO00006408\"},{\"id\":\"RIC1-15381\",\"schedule\":{\"businessDate\":\"2025-11-25\",\"startsAt\":\"2025-11-25T19:15:00+00:00\",\"endsAt\":\"2025-11-25T22:55:00+00:00\",\"filmStartsAt\":\"2025-11-25T19:40:00+00:00\",\"filmEndsAt\":\"2025-11-25T22:55:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"RIC1-1-6\",\"filmId\":\"HO00006227\",\"siteId\":\"RIC1\",\"screenId\":\"RIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"RIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000042\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"RIC1\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4593,\"longitude\":-0.307},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Water Lane,\",\"line2\":\"Richmond,\",\"city\":\"TW9 1TJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006227\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: Cinderella\",\"translations\":[]},\"synopsis\":{\"text\":\"Stuck at home and put to work by her spoiled Step-Sisters, Cinderella’s life is dreary and dull. Everything changes when she helps a mysterious woman out...With a little bit of magic, she is transported into an ethereal new world – one where fairies bring the gifts of the seasons, where pumpkins turn into carriages, and where true love awaits. \\nThis enchanting ballet by The Royal Ballet’s Founding Choreographer Frederick Ashton is a theatrical experience for all the family and will transport you into an ethereal world where a sprinkling of fairy dust makes dreams come true.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Stuck at home and put to work by her spoiled Step-Sisters, Cinderella’s life is dreary and dull. Everything changes when she helps a mysterious woman out...\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-25\",\"runtimeInMinutes\":195,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001474\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011529\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011530\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011532\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011533\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011534\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3646\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"9291\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000290\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000291\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"88d0e3c2-d7a3-443d-821c-0953c1b7157f\",\"corporateId\":null},\"hopk\":\"HO00006227\",\"hoCode\":\"A000007684\",\"eventId\":\"0000000042\",\"distributorName\":\"Trafalgar Releasing\"},{\"id\":\"HO00006408\",\"title\":{\"text\":\"Wicked: For Good\",\"translations\":[]},\"synopsis\":{\"text\":\"Last year’s global cinematic cultural sensation, which became the most successful Broadway film adaptation of all time, now reaches its epic, electrifying, emotional conclusion in Wicked: For Good. \\n\\nDirected once again by award-winning director Jon M. Chu and starring the spectacular returning cast, led by Academy Award® nominated superstars Cynthia Erivo and Ariana Grande, the final chapter of the untold story of the witches of Oz begins with Elphaba and Glinda estranged and living with the consequences of their choices. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"And now whatever way our stories end, I know you have rewritten mine by being my friend …\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-21\",\"runtimeInMinutes\":137,\"trailerUrl\":\"https://www.youtube.com/watch?v=a1l5pm5YHQ8\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000269\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000376\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002344\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003143\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005151\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008505\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008691\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008692\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008694\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008695\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000007\",\"0000000028\",\"0000000032\"],\"externalIds\":{\"moviexchangeReleaseId\":\"cd2537dd-7157-4e64-876e-d26f4d203c1a\",\"corporateId\":null},\"hopk\":\"HO00006408\",\"hoCode\":\"A000007909\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006528\",\"title\":{\"text\":\"The House of Mirth (Re-release)\",\"translations\":[]},\"synopsis\":{\"text\":\"Terence Davies' The House of Mirth is a tragic love story set against a background of wealth and social hypocrisy in turn of the century New York. Lily Bart is a ravishing socialite at the height of her success who quickly discovers the precariousness of her position when her beauty and charm start attracting unwelcome interest and jealousy. Torn between her heart and her head, Lily always seems to do the right thing at the wrong time. She seeks a wealthy husband and in trying to conform to social expectations, she misses her chance for real love with Lawrence Selden.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A woman risks losing her chance of happiness with the only man she has ever loved.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"drug misuse, suicide references, brief sexual threat\",\"translations\":[]},\"releaseDate\":\"2025-10-24\",\"runtimeInMinutes\":135,\"trailerUrl\":null,\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000476\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001938\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003422\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004583\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004834\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012456\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012