            "text": "{\"businessDate\":\"2026-08-11\",\"showtimes\":[{\"id\":\"695-45498\",\"schedule\":{\"businessDate\":\"2026-08-11\",\"startsAt\":\"2026-08-11T19:15:00+01:00\",\"endsAt\":\"2026-08-11T22:25:00+01:00\",\"filmStartsAt\":\"2026-08-11T19:40:00+01:00\",\"filmEndsAt\":\"2026-08-11T22:25:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"695-5-71\",\"filmId\":\"HO00008932\",\"siteId\":\"695\",\"screenId\":\"695-5\",\"areaCategories\":[{\"areaCategoryId\":\"695-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"695-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"695-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"695\",\"name\":{\"text\":\"Beckenham\",\"translations\":[]},\"location\":{\"latitude\":51.4071,\"longitude\":-0.0312},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Beckenham@odeonuk.com\",\"address\":{\"line1\":\"The High Street\",\"line2\":\"\",\"city\":\"Beckenham\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008932\",\"title\":{\"text\":\"Andre Rieu - Summer 2026: Viva Maastricht!\",\"translations\":[]},\"synopsis\":{\"text\":\"This year, André Rieu celebrates a spectacular milestone — the 20th anniversary of his iconic summer concerts on the magnificent Vrijthof square. Captured live in his beloved hometown, this brand-new cinema event marks two decades of music and unforgettable magical summer nights. Viva Maastricht! is a joyful tribute to the city where it all began. Joined by his world-renowned Johann Strauss Orchestra and a vibrant ensemble of artists, André brings the spirit, culture, and warmth of his hometown to life in a dazzling new concert filled with emotion and wonder. From timeless waltzes to soul-stirring classics, thi