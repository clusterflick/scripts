dSeating\":true},{\"areaCategoryId\":\"695-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"695-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"695\",\"name\":{\"text\":\"Beckenham\",\"translations\":[]},\"location\":{\"latitude\":51.4071,\"longitude\":-0.0312},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Beckenham@odeonuk.com\",\"address\":{\"line1\":\"The High Street\",\"line2\":\"\",\"city\":\"Beckenham\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008836\",\"title\":{\"text\":\"Paw Patrol: The Dino Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"After their ship gets caught in a mysterious storm, the PAW Patrol pups crash land on an uncharted tropical island filled with dinosaurs. They meet Rex, a pup who has been stranded on the island for years and has become an expert in all things dino-related. When the PAW Patrol's archrival, Mayor Humdinger, begins recklessly mining in hopes of exploiting the island for its natural resources, he inadvertently causes a huge, dormant volcano to erupt. The PAW Patrol pups are thrown into a series of high-stakes, dino-sized rescues bigger than anything they've done before, as they must stop Humdinger before everything on the island goes extinct.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After their ship gets caught in a mysterious storm, the PAW Patrol pups crash land on an uncharted tropical island filled with dinosaurs. They meet Rex.\",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-06\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=W6q8uzqfB5k\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002221\",\"roles\":[\"Director\"]},{\"castAndCrew