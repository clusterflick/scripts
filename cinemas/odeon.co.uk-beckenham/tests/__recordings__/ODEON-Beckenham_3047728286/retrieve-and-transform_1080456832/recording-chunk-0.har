chedule\":{\"businessDate\":\"2026-07-12\",\"startsAt\":\"2026-07-12T20:45:00+01:00\",\"endsAt\":\"2026-07-12T22:59:00+01:00\",\"filmStartsAt\":\"2026-07-12T21:10:00+01:00\",\"filmEndsAt\":\"2026-07-12T22:59:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"695-4-63\",\"filmId\":\"HO00008964\",\"siteId\":\"695\",\"screenId\":\"695-4\",\"areaCategories\":[{\"areaCategoryId\":\"695-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"695-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"695-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"695-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"695-47158\",\"schedule\":{\"businessDate\":\"2026-07-12\",\"startsAt\":\"2026-07-12T21:00:00+01:00\",\"endsAt\":\"2026-07-12T23:11:00+01:00\",\"filmStartsAt\":\"2026-07-12T21:25:00+01:00\",\"filmEndsAt\":\"2026-07-12T23:11:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"695-6-58\",\"filmId\":\"HO00009072\",\"siteId\":\"695\",\"screenId\":\"695-6\",\"areaCategories\":[{\"areaCategoryId\":\"695-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"695-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"695-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"695-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"695\",\"name\":{\"text\":\"Beckenham\",\"translations\":[]},\"location\":{\"latitude\":51.4071,\"longitude\":-0.0312},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Beckenham@odeonuk.com\",\"address\":{\"line1\":\"The High Street\",\"line2\":\"\",\"city\":\"Beckenham\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00001947\",\"title\":{\"text\":\"Zog + Zog and the Flying Doctors\",\"translations\":[]},\"synopsis\":{\"text\":\"As Zog, Pearl, and Gadabout begin a new series of adventures on CBeebies, revisit how they first came to take flight with this special cinema double bill of the original two animated specials. In Zog, meet the clumsy but keen young dragon as he begins his training at Dragon School. Tasked with capturing a princess, could it be that the girl who so kindly treats his bumps and bruises is exactly who he’s been looking for? Then in Zog and the Flying Doctors, Zog’s newly formed team with Princess Pearl and Gadabout travel the land to treat all kinds of creatures, real and mythical, including a mermaid, unicorn and lion.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"As Zog, Pearl, and Gadabout begin a new series of adventures on CBeebies, revisit how they first came to take flight with this special cinema double bill of the original \",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-05\",\"runtimeInMinutes\":53,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000006445\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016173\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019165\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019166\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019167\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019168\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019169\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"2537\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"15e3cd5a-c75d-45a4-a367-93973469f2c7\",\"corporateId\":null},\"hopk\":\"HO00001947\",\"hoCode\":\"A000002231\",\"eventId\":null,\"distributorName\":\"Magic Light Pictures\"},{\"id\":\"HO00008218\",\"title\":{\"text\":\"Toy Story 5\",\"translations\":[]},\"synopsis\":{\"text\":\"The toys are back in Disney and Pixar’s “Toy Story 5,” and this time around it’s Toy meets Tech. Buzz, Woody, Jessie and the rest of the gang’s jobs get exponentially harder when they go head to head with this all-new threat to playtime.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The toys are back in Disney and Pixar’s “Toy Story 5,” and this time around it’s Toy meets Tech. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-19\",\"runtimeInMinutes\":102,\"trailerUrl\":\"https://www.youtube.com/watch?v=RFm6wN7IhtY\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002721\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002933\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004242\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009613\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010641\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017418\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017419\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"7850\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000222\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002742\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e4e53d03-846a-4c4b-a95f-af4af0f815b4\",\"corporateId\":null},\"hopk\":\"HO00008218\",\"hoCode\":\"A000009312\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008413\",\"title\":{\"text\":\"Supergirl\",\"translations\":[]},\"synopsis\":{\"text\":\"When an unexpected and ruthless adversary strikes too close to home, Kara Zor-El, aka Supergirl, reluctantly joins forces with an unlikely companion on an epic, interstellar journey of vengeance and justice.\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It follows Kara Zor-El's story and her darker origin before she finally made her way to Earth.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-25\",\"runtimeInMinutes\":108,\"trailerUrl\":\"https://www.youtube.com/watch?v=wxTiyxH9eZw\",\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007748\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014392\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017778\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001118\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001286\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001846\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002429\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002629\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000001\",\"0000000003\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dbd619f1-56eb-431b-8c89-2eb427edd34f\",\"corporateId\":null},\"hopk\":\"HO00008413\",\"hoCode\":\"A000009517\",\"eventId\":null,\"distributorName\":\"WARNER BROS DISTRIBUTORS LTD\"},{\"id\":\"HO00008415\",\"title\":{\"text\":\"Moana\",\"translations\":[]},\"synopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyages beyond the reef of her island of Motunui with the infamous demigod Maui (Dwayne Johnson) on an unforgettable journey to restore prosperity to her people. The film is directed by Emmy® and Tony Award® winner Thomas Kail (“Hamilton”); produced by Dwayne Johnson, Dany Garcia, Beau Flynn, Hiram Garcia and Lin-Manuel Miranda; and executive produced by Thomas Kail, Scott Sheldon, Charles Newirth and Auliʻi Cravalho, who voiced Moana in the animated features “Moana” and “Moana 2.”\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyage\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=zQjHSoVCQLs\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000117\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001075\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009582\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016273\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017779\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017780\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000102\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000113\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000114\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001036\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"6d579a6e-0609-4ead-992c-190cf5e0fd6f\",\"corporateId\":null},\"hopk\":\"HO00008415\",\"hoCode\":\"A000009519\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008498\",\"title\":{\"text\":\"Bluey at the Cinema: Playdates with Friends\",\"translations\":[]},\"synopsis\":{\"text\":\"Bluey at the Cinema: Playdates with Friends Collection is an hour of fun that features eight episodes from across the TV show’s three series, all celebrating play and imagination with friends and family! The compilation showcases some of Bluey's favourite games like Shadowlands and Octopus, and highlights special friendship moments in episodes such as Circus and Slide - all packed with lots of joy and laughter.\\n\\nEpisode running order \\n \\nShadowlands - S1 - Ep. 5 \\nThe Doctor - S1 - Ep. 18 \\nMums & Dads - S1 - Ep. 41 \\nCircus - S2 - Ep. 32 \\nOctopus - S2 - Ep. 40 \\nMuffin Cone - S2 - Ep. 42 \\nWild Girls - S3 - Ep. 44 \\nSlide - S3 - Ep. 46 \\n \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Bluey at the Cinema: Playdates with Friends Collection is an hour of fun that features eight episodes from across the TV show’s three series!\",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":null,\"releaseDate\":\"2026-03-27\",\"runtimeInMinutes\":60,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"48aa1ac3-cba2-4969-a10b-481a2cc1e0eb\",\"corporateId\":null},\"hopk\":\"HO00008498\",\"hoCode\":\"A000009608\",\"eventId\":null,\"distributorName\":\"VUE Entertainment Ltd\"},{\"id\":\"HO00008565\",\"title\":{\"text\":\"Minions & Monsters\",\"translations\":[]},\"synopsis\":{\"text\":\"Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe with a riotous new chapter, featuring all-new characters, in the biggest global animated franchise in history: Minions & Monsters.\\n\\nThis is the rambunctious, ridiculous and totally true story of how the Minions conquered Hollywood, became movie stars, lost everything, unleashed monsters onto the world and then banded together to try and save the planet from the mayhem they had just created.\\n\\nMinions & Monsters is directed by Academy Award® nominee Pierre Coffin, a director of the first three Despicable Me films and the first Minions film. Coffin has also provided the voice for the Minions since their film debut in 2010. The film is written by Brian Lynch (Minions, The Secret Life of Pets films) and Pierre Coffin and is produced by Illumination’s Academy Award® nominated founder and CEO Chris Meledandri and by Bill Ryan (executive producer, The Super Mario Bros. Movie). The executive producer is Brian Lynch.\\n\\nMore than ten years after their creation, the Minions have become the most iconic animated characters of their generation. Globally recognised and beloved by fans of all ages, they have propelled Illumination’s Despicable Me and Minions to a global box office of more than $5.6 billion.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe \",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":{\"text\":\"very mild comic violence, threat, rude humour\",\"translations\":[]},\"releaseDate\":\"2026-07-01\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=drr0on3W0K8\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002922\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017409\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018101\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"18969\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000015\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000542\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001046\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"HO00001049\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001410\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"1051448b-9ebc-4ce8-b9e7-c007182dbdca\",\"corporateId\":null},\"hopk\":\"HO00008565\",\"hoCode\":\"A000009677\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008769\",\"title\":{\"text\":\"Time Hoppers: The Silk Road\",\"translations\":[]},\"synopsis\":{\"text\":\"Four gifted children accidentally travel back in time to the historic Silk Road, where they encounter an evil alchemist that is determined to erase the foundations of science. If he succeeds, great inventions like the camera, computer, and astrolabe will never be created!  The kids will have to use all their wits to thwart his plans as the future of science and technology hangs in the balance.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Four gifted children journey through time to stop a vengeful alchemist whose plans threaten the future of science and technology.\",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":{\"text\":\"very mild threat, violence, language, upsetting scenes\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":81,\"trailerUrl\":\"https://www.youtube.com/watch?v=H-1todq4l54\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000018581\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018582\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018583\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018584\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018585\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018586\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018587\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018588\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000018589\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000003\",\"0000000004\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2e92e915-ef4e-4c31-83ea-a0b90c48f91a\",\"corporateId\":null},\"hopk\":\"HO00008769\",\"hoCode\":\"A000009900\",\"eventId\":null,\"distributorName\":\"MIRACLE COMMUNICATIONS LTD\"},{\"id\":\"HO00008964\",\"title\":{\"text\":\"Evil Dead Burn\",\"translations\":[]},\"synopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. After the loss of her husband, a woman seeks solace with her in-laws in their secluded family home. As one by one they are transformed into Deadites—turning the gathering into a family reunion from hell—she comes to discover that the vows she took in life... live on even in death.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. \",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong bloody violence, gore\",\"translations\":[]},\"releaseDate\":\"2026-07-09\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=YYkUkyfjUKg\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000008177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009258\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019021\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019022\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019023\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019024\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000303\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"3c50ff95-67b2-4152-9965-ad2431794116\",\"corporateId\":null},\"hopk\":\"HO00008964\",\"hoCode\":\"A000010114\",\"eventId\":null,\"distributorName\":\"STUDIOCANAL\"},{\"id\":\"HO00009072\",\"title\":{\"text\":\"The Invite\",\"translations\":[]},\"synopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \\nHave they reignited the spark or lit the match that burns it all down?\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"very strong language, strong sex references, drug misuse\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":106,\"trailerUrl\":\"https://www.youtube.com/watch?v=7YIHRhRMn94\",\"displayPriority\":8,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000785\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004368\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019329\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019330\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000241\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001028\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001154\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"HO00002297\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a87bd21e-c69e-4d0b-b7d0-18dabf2eeb9f\",\"corporateId\":null},\"hopk\":\"HO00009072\",\"hoCode\":\"A000010230\",\"eventId\":null,\"distributorName\":\"Black Bear Pictures\"},{\"id\":\"HO00009126\",\"title\":{\"text\":\"Moana - Sing-Along\",\"translations\":[]},\"synopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyages beyond the reef of her island of Motunui with the infamous demigod Maui (Dwayne Johnson) on an unforgettable journey to restore prosperity to her people. The film is directed by Emmy® and Tony Award® winner Thomas Kail (“Hamilton”); produced by Dwayne Johnson, Dany Garcia, Beau Flynn, Hiram Garcia and Lin-Manuel Miranda; and executive produced by Thomas Kail, Scott Sheldon, Charles Newirth and Auliʻi Cravalho, who voiced Moana in the animated features “Moana” and “Moana 2.”\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In Disney’s liv