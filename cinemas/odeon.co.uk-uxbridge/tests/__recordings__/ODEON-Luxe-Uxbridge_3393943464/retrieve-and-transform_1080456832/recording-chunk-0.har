            "text": "{\"businessDate\":\"2026-10-20\",\"showtimes\":[{\"id\":\"593-80958\",\"schedule\":{\"businessDate\":\"2026-10-20\",\"startsAt\":\"2026-10-20T18:00:00+01:00\",\"endsAt\":\"2026-10-20T21:54:00+01:00\",\"filmStartsAt\":\"2026-10-20T18:25:00+01:00\",\"filmEndsAt\":\"2026-10-20T21:54:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"593-5-176\",\"filmId\":\"HO00008941\",\"siteId\":\"593\",\"screenId\":\"593-5\",\"areaCategories\":[{\"areaCategoryId\":\"593-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000018\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000048\",\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"593\",\"name\":{\"text\":\"Uxbridge\",\"translations\":[]},\"location\":{\"latitude\":51.545,\"longitude\":-0.4757},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Uxbridge@odeonuk.com\",\"address\":{\"line1\":\"302 The Chimes Shopping Centre\",\"line2\":\"\",\"city\":\"Uxbridge\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008941\",\"title\":{\"text\":\"Met Opera 2026-27: Macbeth\",\"translations\":[]},\"synopsis\":{\"text\":\"Two of opera’s most extraordinary artists return to The Met: Live in HD for Verdi’s thrilling take on the immortal Shakespearean tale of the scheming couple determined to seize power at any cost. Baritone Quinn Kelsey is the Scottish king haunted by the ghosts of his murderous ascent to the throne, opposite soprano Lise Davidsen as the power-mad Lady Macbeth, whose ruinous ambition damns them both. Met Music Director Yannick Nézet-Séguin takes the podium for a penetrating production by Louisa Proske. Rounding out the all-star cast are tenor Freddie De Tommaso as Macduff and bass-baritone Ryan Speedo Green as Banquo.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Two of opera’s most extraordinary artists return to The Met: Live in HD for Verdi’s thrilling take on the immortal Shakespearean tale of the scheming couple\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-10-17\",\"runtimeInMinutes\":209,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000018978\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"15480\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000368\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000397\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000476\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001914\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001920\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000043\"],\"externalIds\":{\"moviexchangeReleaseId\":\"af3636fd-b1e2-42c3-b07c-cdf375c3ebe7\",\"corporateId\":null},\"hopk\":\"HO00008941\",\"hoCode\":\"A000010088\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000018978\",\"name\":{\"givenName\":\"Louisa\",\"familyName\":\"Proske\",\"middleName\":null}},{\"id\":\"15480\",\"name\":{\"givenName\":\"Freddie\",\"familyName\":\"De Tommaso\",\"middleName\":null}},{\"id\":\"HO00000368\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"HO00000397\",\"name\":{\"givenName\":\"Ryan Speedo\",\"familyName\":\"Green\",\"middleName\":null}},{\"id\":\"HO00000476\",\"name\":{\"givenName\":\"Lise\",\"familyName\":\"Davidsen\",\"middleName\":null}},{\"id\":\"HO00001914\",\"name\":{\"givenName\":\"Yannick\",\"familyName\":\"Nézet-Séguin\",\"middleName\":null}},{\"id\":\"HO00001920\",\"name\":{\"givenName\":\"Quinn\",\"familyName\":\"Kelsey\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000043\",\"name\":{\"text\":\"Opera\",\"translations\":[]},\"de