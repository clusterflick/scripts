            "text": "{\"businessDate\":\"2026-02-24\",\"showtimes\":[{\"id\":\"593-73559\",\"schedule\":{\"businessDate\":\"2026-02-24\",\"startsAt\":\"2026-02-24T13:00:00+00:00\",\"endsAt\":\"2026-02-24T15:03:00+00:00\",\"filmStartsAt\":\"2026-02-24T13:10:00+00:00\",\"filmEndsAt\":\"2026-02-24T15:03:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"593-3-124\",\"filmId\":\"HO00007830\",\"siteId\":\"593\",\"screenId\":\"593-3\",\"areaCategories\":[{\"areaCategoryId\":\"593-0000000014\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000018\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000024\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"593\",\"name\":{\"text\":\"Uxbridge\",\"translations\":[]},\"location\":{\"latitude\":51.545,\"longitude\":-0.4757},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Uxbridge@odeonuk.com\",\"address\":{\"line1\":\"302 The Chimes Shopping Centre\",\"line2\":\"\",\"city\":\"Uxbridge\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007830\",\"title\":{\"text\":\"The Choral\",\"translations\":[]},\"synopsis\":{\"text\":\"1916. As war rages on the Western Front, the Choral Society in Ramsden, Yorkshire has lost most of its men to the army. The Choral’s ambitious committee, determined to press ahead, decides to recruit local young males to swell their ranks. They must also engage a new chorus master, and despite their suspicions that he has something to hide, their best bet seems to be Dr. Henry Guthrie (Ralph Fiennes) – driven, uncompromising, and recently returned from a career in Germany. As conscription papers start to arrive, the whole community discovers that the best response to the chaos that is laying waste to their lives is to make music together.\\n\\n \\n\\nDirected by BAFTA, Olivier and Tony Award winner NICHOLAS HYTNER (The Crucible) and written by BAFTA, Olivier and Tony Award winner ALAN BENNETT, The Choral marks their fourth writer-director collaboration following the acclaimed films The Madness of King George, The History Boys, and The Lady in The Van.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"1916. As war rages on the Western Front, the Choral Society in Ramsden, Yorkshire has lost most of its men to the army. \",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate sex\",\"translations\":[]},\"releaseDate\":\"2025-11-07\",\"runtimeInMinutes\":113,\"trailerUrl\":\"https://www.youtube.com/watch?v=6zRVP-ZgMm8\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000456\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001181\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002690\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016601\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016602\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000061\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000446\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000914\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000024\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2d11e861-3222-4621-b9ca-ef1884f57c6f\",\"corporateId\":null},\"hopk\":\"HO00007830\",\"hoCode\":\"A000008887\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"}],\"castAndCrew\":[{\"id\":\"0000000456\",\"name\":{\"givenName\":\"Simon Russell \",\"familyName\":\"Beale\",\"middleName\":null}},{\"id\":\"0000001181\",\"name\":{\"givenName\":\"Roger\",\"familyName\":\"Allam\",\"middleName\":null}},{\"id\":\"0000002690\",\"name\":{\"givenName\":\"Mark\",\"familyName\":\"Addy\",\"middleName\":null}},{\"id\":\"0000016601\",\"name\":{\"givenName\":\"Alun\",\"familyName\":\"Armstrong\",\"middleName\":null}},{\"id\":\"0000016602\",\"name\":{\"givenName\":\"Robert\",\"familyName\":\"Emms\",\"middleName\":null}},{\"id\":\"HO00000061\",\"name\":{\"givenName\":\"Damian \",\"familyName\":\"Jones\",\"middleName\":null}},{\"id\":\"HO00000446\",\"name\":{\"givenName\":\"Nicholas \",\"familyName\":\"Hytner\",\"middleName\":null}},{\"id\":\"HO00000576\",\"name\":{\"givenName\":\"Ralph\",\"familyName\":\"Fiennes\",\"middleName\":null}},{\"id\":\"HO00000914\",\"name\":{\"givenName\":\"Kevin \",\"familyName\":\"Loader\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000009\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":null},{\"id\":\"0000000024\",\"name\":{\"text\":\"War\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000001\",\"classification\":{\"text\":\"12A\",\"translations\":[]},\"classificationDescription\":{\"text\":\"12A with Parental Guidance\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Audio Described\",\"translations\":[]},\"shortName\":{\"text\":\"AudioDes\",\"translations\":[]},\"description\":{\"text\":\"A narrator describes the action, scene changes, and actors' body language, along with the dialogue of the film. Audio Description is accessed via headphones and a body pack.\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":3,\"isPromoted\":false},{\"id\":\"0000000024\",\"name\":{\"text\":\"Silver Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"SilverCine\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":5,\"isPromoted\":true},{\"id\":\"0000000030\",\"name\":{\"text\":\"Wheelchair Accessible\",\"translations\":[]},\"shortName\":{\"text\":\"Wheelchair\",\"translations\":[]},\"description\":{\"text\":\"This auditorium has bays for wheelchair users with seats beside them for accompanying guests.\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":10,\"isPromoted\":false}],\"screens\":[{\"id\":\"593-3\",\"name\":{\"text\":\"Screen 3\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"593-0000000014\",\"name\":{\"text\":\"VIP Bed\",\"translations\":[]},\"hopk\":\"0000000021\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false},{\"id\":\"593-0000000003\",\"name\":{\"text\":\"Recliner Saver\",\"translations\":[]},\"hopk\":\"0000000002\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false},{\"id\":\"593-0000000018\",\"name\":{\"text\":\"Premier Recliner\",\"translations\":[]},\"hopk\":\"0000000026\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
