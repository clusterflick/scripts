            "text": "{\"businessDate\":\"2026-03-04\",\"showtimes\":[{\"id\":\"593-71847\",\"schedule\":{\"businessDate\":\"2026-03-04\",\"startsAt\":\"2026-03-04T19:15:00+00:00\",\"endsAt\":\"2026-03-04T22:25:00+00:00\",\"filmStartsAt\":\"2026-03-04T19:40:00+00:00\",\"filmEndsAt\":\"2026-03-04T22:25:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"593-4-126\",\"filmId\":\"HO00008256\",\"siteId\":\"593\",\"screenId\":\"593-4\",\"areaCategories\":[{\"areaCategoryId\":\"593-0000000014\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000018\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"593\",\"name\":{\"text\":\"Uxbridge\",\"translations\":[]},\"location\":{\"latitude\":51.545,\"longitude\":-0.4757},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Uxbridge@odeonuk.com\",\"address\":{\"line1\":\"302 The Chimes Shopping Centre\",\"line2\":\"\",\"city\":\"Uxbridge\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008256\",\"title\":{\"text\":\"OTHELLO\",\"translations\":[]},\"synopsis\":{\"text\":\"Shakespeare’s OTHELLO rages to life like never before in a ‘compelling’ (★★★★ Telegraph) new production starring David Harewood OBE (Homeland, Best of Enemies), Toby Jones OBE (Mr Bates vs the Post Office, Detectorists), Caitlin FitzGerald (Succession, Masters of Sex), Vinette Robinson (Boiling Point) and Luke Treadaway (A Street Cat Named Bob). \\n\\nDirected by Tony Award-winner Tom Morris OBE (War Horse, Dr Semmelweis, The Grinning Man) with music by PJ Harvey, this epic story of manipulation, jealousy and toxic masculinity explores the darker side of power, rage and desire. Filmed live at the Theatre Royal Haymarket in London especially for the big screen, this is ‘an electrifying star-studded Othello.’ (★★★★ Mail on Sunday) \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Shakespeare’s OTHELLO rages to life like never before in a ‘compelling’ (★★★★ Telegraph) new production starring David Harewood OBE (Homeland, Best of Enemies)...\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-03-04\",\"runtimeInMinutes\":165,\"trailerUrl\":\"https://www.youtube.com/watch?v=BSmPMR5Fr5U\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001183\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001453\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004544\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007863\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017483\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017484\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000039\"],\"externalIds\":{\"moviexchangeReleaseId\":\"976fac7a-021b-4144-88f8-d01dbf2ce9e2\",\"corporateId\":null},\"hopk\":\"HO00008256\",\"hoCode\":\"A000009350\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000001183\",\"name\":{\"givenName\":\"Toby\",\"familyName\":\"Jones\",\"middleName\":null}},{\"id\":\"0000001453\",\"name\":{\"givenName\":\"Luke \",\"familyName\":\"Treadaway\",\"middleName\":null}},{\"id\":\"0000004544\",\"name\":{\"givenName\":\"Vinette\",\"familyName\":\"Robinson\",\"middleName\":null}},{\"id\":\"0000007863\",\"name\":{\"givenName\":\"David\",\"familyName\":\"Harewood\",\"middleName\":null}},{\"id\":\"0000017483\",\"name\":{\"givenName\":\"Caitlin\",\"familyName\":\"FitzGerald\",\"middleName\":null}},{\"id\":\"0000017484\",\"name\":{\"givenName\":\"Tom\",\"familyName\":\"Morris\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000039\",\"name\":{\"text\":\"Live Theatre\",