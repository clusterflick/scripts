-02-03T22:52:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"593-1-120\",\"filmId\":\"HO00008237\",\"siteId\":\"593\",\"screenId\":\"593-1\",\"areaCategories\":[{\"areaCategoryId\":\"593-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000018\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000145\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"593-74068\",\"schedule\":{\"businessDate\":\"2026-02-03\",\"startsAt\":\"2026-02-03T21:00:00+00:00\",\"endsAt\":\"2026-02-03T22:54:00+00:00\",\"filmStartsAt\":\"2026-02-03T21:25:00+00:00\",\"filmEndsAt\":\"2026-02-03T22:54:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"593-3-124\",\"filmId\":\"HO00008273\",\"siteId\":\"593\",\"screenId\":\"593-3\",\"areaCategories\":[{\"areaCategoryId\":\"593-0000000014\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000018\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"593\",\"name\":{\"text\":\"Uxbridge\",\"translations\":[]},\"location\":{\"latitude\":51.545,\"longitude\":-0.4757},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Uxbridge@odeonuk.com\",\"address\":{\"line1\":\"302 The Chimes Shopping Centre\",\"line2\":\"\",\"city\":\"Uxbridge\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007533\",\"title\":{\"text\":\"Avatar: Fire and Ash\",\"translations\":[]},\"synopsis\":{\"text\":\"Jake and Neytiri's family grapples with grief after Neteyam's death, encountering a new, aggressive Na'vi tribe, the Ash People, who are led by the fiery Varang, as the conflict on Pandora escalates and a new moral focus emerges.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Jake and Neytiri's family grapples with grief after Neteyam's death, encountering a new, aggressive Na'vi tribe, the Ash People, who are led by the fiery Varang.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-19\",\"runtimeInMinutes\":197,\"trailerUrl\":null,\"displayPriority\":8,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000560\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002207\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002294\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005786\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005787\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007837\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17711\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17712\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17713\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000042\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000349\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000696\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002427\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000010\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a4cb369f-77c4-4fe1-8f85-dd5e76b195dd\",\"corporateId\":null},\"hopk\":\"HO00007533\",\"hoCode\":\"A000008563\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00007929\",\"title\":{\"text\":\"Nuremberg\",\"translations\":[]},\"synopsis\":{\"text\":\"In the immediate aftermath of the Second World War, as the world grapples with the unveiled horrors of the Holocaust, U.S. Army psychiatrist Lt. Col. Douglas Kelley (Rami Malek) is assigned the extraordinary task of assessing the mental state of Hermann Göring (Russell Crowe), the notorious former Reichsmarschall and Hitler’s second in command, along with other high ranking Nazi officials.\\nAs the Allies – led by the unyielding chief U.S. prosecutor, Supreme Court Justice Robert H. Jackson (Michael Shannon) alongside Sgt. Howie Triest (Leo Woodall), David Maxwell-Fyfe (Richard E. Grant), Gustave Gilbert (Colin Hanks), Col. John Amen (Mark O’Brien) and Burton C. Andrus (John Slattery) – navigate the monumental task of creating an unprecedented international tribunal to ensure the Nazi regime answers for its atrocities, Kelley gets to know his ‘patients’. But he soon finds himself locked in a psychological duel with Göring, whose charisma and cunning reveal a sobering truth: that ordinary men can commit extraordinary evil.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Allies, led by the unyielding chief prosecutor, Robert H. Jackson (Michael Shannon), have the task of ensuring the Nazi regime answers for the unveiled horrors.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"images of real dead bodies, Holocaust references, strong violence\",\"translations\":[]},\"releaseDate\":\"2025-11-14\",\"runtimeInMinutes\":148,\"trailerUrl\":null,\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004231\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000004232\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004687\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014229\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015883\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016789\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016790\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016791\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016792\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016793\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016794\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016795\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016796\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016797\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000147\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000997\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001323\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001785\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002222\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\",\"0000000013\",\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"f015523e-e189-4198-a6f8-cf6f63968b64\",\"corporateId\":null},\"hopk\":\"HO00007929\",\"hoCode\":\"A000009001\",\"eventId\":null,\"distributorName\":\"STUDIOCANAL\"},{\"id\":\"HO00008012\",\"title\":{\"text\":\"The Housemaid\",\"translations\":[]},\"synopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous — a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, sex, sexual violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-12-22\",\"runtimeInMinutes\":131,\"trailerUrl\":\"h