7IhtY\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002721\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002933\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004242\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009613\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010641\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017418\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017419\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"7850\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000222\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002742\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e4e53d03-846a-4c4b-a95f-af4af0f815b4\",\"corporateId\":null},\"hopk\":\"HO00008218\",\"hoCode\":\"A000009312\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008413\",\"title\":{\"text\":\"Supergirl\",\"translations\":[]},\"synopsis\":{\"text\":\"When an unexpected and ruthless adversary strikes too close to home, Kara Zor-El, aka Supergirl, reluctantly joins forces with an unlikely companion on an epic, interstellar journey of vengeance and justice.\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It follows Kara Zor-El's story and her darker origin before she finally made her way to Earth.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-25\",\"runtimeInMinutes\":108,\"trailerUrl\":\"https://www.youtube.com/watch?v=wxTiyxH9eZw\",\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007748\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014392\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017778\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001118\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001286\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001846\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002429\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002629\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000001\",\"0000000003\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dbd619f1-56eb-431b-8c89-2eb427edd34f\",\"corporateId\":null},\"hopk\":\"HO00008413\",\"hoCode\":\"A000009517\",\"eventId\":null,\"distributorName\":\"WARNER BROS DISTRIBUTORS LTD\"},{\"id\":\"HO00008415\",\"title\":{\"text\":\"Moana\",\"translations\":[]},\"synopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyages beyond the reef of her island of Motunui with the infamous demigod Maui (Dwayne Johnson) on an unforgettable journey to restore prosperity to her people. The film is directed by Emmy® and Tony Award® winner Thomas Kail (“Hamilton”); produced by Dwayne Johnson, Dany Garcia, Beau Flynn, Hiram Garcia and Lin-Manuel Miranda; and executive produced by Thomas Kail, Scott Sheldon, Charles Newirth and Auliʻi Cravalho, who voiced Moana in the animated features “Moana” and “Moana 2.”\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyage\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=zQjHSoVCQLs\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000117\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001075\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009582\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016273\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017779\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017780\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000102\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000113\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000114\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001036\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"6d579a6e-0609-4ead-992c-190cf5e0fd6f\",\"corporateId\":null},\"hopk\":\"HO00008415\",\"hoCode\":\"A000009519\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008468\",\"title\":{\"text\":\"Disclosure Day\",\"translations\":[]},\"synopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming close to … Disclosure Day.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate threat, violence, injury detail, infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-06-10\",\"runtimeInMinutes\":145,\"trailerUrl\":\"https://www.youtube.com/watch?v=WnW25gFk2Mk\",\"displayPriority\":9,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000219\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000635\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010990\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000216\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000318\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001974\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002474\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"1f2756b4-b117-4f07-b240-55d7611c2d78\",\"corporateId\":null},\"hopk\":\"HO00008468\",\"hoCode\":\"A000009576\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008565\",\"title\":{\"text\":\"Minions & Monsters\",\"translations\":[]},\"synopsis\":{\"text\":\"Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe with a riotous new chapter, featuring all-new characters, in the biggest global animated franchise in history: Minions & Monsters.\\n\\nThis is the rambunctious, ridiculous and totally true story of how the Minions conquered Hollywood, became movie stars, lost everything, unleashed monsters onto the world and then banded together to try and save the planet from the mayhem they had just created.\\n\\nMinions & Monsters is directed by Academy Award® nominee Pierre Coffin, a director of the first three Despicable Me films and the first Minions film. Coffin has also provided the voice for the Minions since their film debut in 2010. The film is written by Brian Lynch (Minions, The Secret Life of Pets films) and Pierre Coffin and is produced by Illumination’s Academy Award® nominated founder and CEO Chris Meledandri and by Bill Ryan (executive producer, The Super Mario Bros. Movie). The executive producer is Brian Lynch.\\n\\nMore than ten years after their creation, the Minions have become the most iconic animated characters of their generation. Globally recognised and beloved by fans of all ages, they have propelled Illumination’s Despicable Me and Minions to a global box office of more than $5.6 billion.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe \",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":{\"text\":\"very mild comic violence, threat, rude humour\",\"translations\":[]},\"releaseDate\":\"2026-07-01\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=drr0on3W0K8\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002922\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017409\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018101\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"18969\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000015\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000542\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001046\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"HO00001049\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001410\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"1051448b-9ebc-4ce8-b9e7-c007182dbdca\",\"corporateId\":null},\"hopk\":\"HO00008565\",\"hoCode\":\"A000009677\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008744\",\"title\":{\"text\":\"Obsession\",\"translations\":[]},\"synopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for but soon discovers that some desires come at a dark, sinister price.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong violence, gore\",\"translations\":[]},\"releaseDate\":\"2026-05-15\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=fWLaCC8L6Jo\",\"displayPriority\":10,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002047\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006579\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018515\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018516\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018517\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018518\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018519\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018520\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000018521\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a6a25d26-497a-4daa-a5ff-b5fc9719faca\",\"corporateId\":null},\"hopk\":\"HO00008744\",\"hoCode\":\"A000009874\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008769\",\"title\":{\"text\":\"Time Hoppers: The Silk Road\",\"translations\":[]},\"synopsis\":{\"text\":\"Four gifted children accidentally travel back in time to the historic Silk Road, where they encounter an evil alchemist that is determined to erase the foundations of science. If he succeeds, great inventions like the camera, computer, and astrolabe will never be created!  The kids will have to use all their wits to thwart his plans as the future of science and technology hangs in the balance.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Four gifted children journey through time to stop a vengeful alchemist whose plans threaten the future of science and technology.\",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":{\"text\":\"very mild threat, violence, language, upsetting scenes\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":81,\"trailerUrl\":\"https://www.youtube.com/watch?v=H-1todq4l54\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000018581\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018582\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018583\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018584\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018585\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018586\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018587\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018588\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000018589\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000003\",\"0000000004\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2e92e915-ef4e-4c31-83ea-a0b90c48f91a\",\"corporateId\":null},\"hopk\":\"HO00008769\",\"hoCode\":\"A000009900\",\"eventId\":null,\"distributorName\":\"MIRACLE COMMUNICATIONS LTD\"},{\"id\":\"HO00008964\",\"title\":{\"text\":\"Evil Dead Burn\",\"translations\":[]},\"synopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. After the loss of her husband, a woman seeks solace with her in-laws in their secluded family home. As one by one they are transformed into Deadites—turning the gathering into a family reunion from hell—she comes to discover that the vows she took in life... live on even in death.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. \",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong bloody violence, gore\",\"translations\":[]},\"releaseDate\":\"2026-07-09\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=YYkUkyfjUKg\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000008177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009258\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019021\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019022\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019023\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019024\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000303\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"3c50ff95-67b2-4152-9965-ad2431794116\",\"corporateId\":null},\"hopk\":\"HO00008964\",\"hoCode\":\"A000010114\",\"eventId\":null,\"distributorName\":\"STUDIOCANAL\"},{\"id\":\"HO00009072\",\"title\":{\"text\":\"The Invite\",\"translations\":[]},\"synopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \\nHave they reignited the spark or lit the match that burns it all down?\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"very strong language, strong sex references, drug misuse\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":106,\"trailerUrl\":\"https://www.youtube.com/watch?v=7YIHRhRMn94\",\"displayPriority\":8,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000785\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004368\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019329\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019330\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000241\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001028\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001154\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"HO00002297\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a87bd21e-c69e-4d0b-b7d0-18dabf2eeb9f\",\"corporateId\":null},\"hopk\":\"HO00009072\",\"hoCode\":\"A000010230\",\"eventId\":null,\"distributorName\":\"Black Bear Pictures\"},{\"id\":\"HO00009080\",\"title\":{\"text\":\"Alpha\",\"translations\":[]},\"synopsis\":{\"text\":\"Welcome to the newest chapter of the YRF Spy Universe that presents an edgy origin story of a girl raised and built to kill. Alpha is a female-led action film that will take you on a fun, edge of the seat, thrilling ride that is designed as an out and out entertainer. \\n\\nYash Raj Films presents Alpha, starring Alia Bhatt, Sharvari, Anil Kapoor, and Bobby Deol. Produced by Aditya Chopra and directed by Shiv Rawail, acclaimed for the globally celebrated series The Railway Men, Alpha is set to release in theatres worldwide on July 3, 2026.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Welcome to the newest chapter of the YRF Spy Universe that presents an edgy origin story of a girl raised and built to kill. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":141,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004713\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019336\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019337\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000502\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000856\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002020\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"67ed5047-d1b1-4f4e-83f8-6d4db9b74731\",\"corporateId\":null},\"hopk\":\"HO00009080\",\"hoCode\":\"A000010238\",\"eventId\":null,\"distributorName\":\"YASH RAJ FILMS LTD\"},{\"id\":\"HO00009154\",\"title\":{\"text\":\"Dham