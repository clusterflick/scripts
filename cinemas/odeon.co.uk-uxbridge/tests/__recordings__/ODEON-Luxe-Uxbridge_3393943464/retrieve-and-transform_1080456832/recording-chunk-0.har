          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-11-10\",\"showtimes\":[{\"id\":\"593-80960\",\"schedule\":{\"businessDate\":\"2026-11-10\",\"startsAt\":\"2026-11-10T19:00:00+00:00\",\"endsAt\":\"2026-11-10T23:00:00+00:00\",\"filmStartsAt\":\"2026-11-10T19:25:00+00:00\",\"filmEndsAt\":\"2026-11-10T23:00:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"593-5-176\",\"filmId\":\"HO00008945\",\"siteId\":\"593\",\"screenId\":\"593-5\",\"areaCategories\":[{\"areaCategoryId\":\"593-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000018\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000048\",\"0000000178\",\"0000000053\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"593\",\"name\":{\"text\":\"Uxbridge\",\"translations\":[]},\"location\":{\"latitude\":51.545,\"longitude\":-0.4757},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Uxbridge@odeonuk.com\",\"address\":{\"line1\":\"302 The Chimes Shopping Centre\",\"line2\":\"\",\"city\":\"Uxbridge\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008945\",\"title\":{\"text\":\"RBO Cinema Season 2026-27: Carmen\",\"translations\":[]},\"synopsis\":{\"text\":\"Under the oppressive heat of the Spanish sun, the fiercely independent Carmen attracts the attention of Don José. She warns him not to fall in love with her, but his obsession knows no bounds. Damiano Michieletto’s searing production returns, casting scorching light on the lust, violence and destructive desire of Bizet’s ever-popular opera. \\nAn all-star cast brings this white-hot drama to life, with Ginger Costa-Jackson in the fiery title role, alongside Russell Thomas as the jealous and despairing Don José. Following his 2023 Royal Opera debut, Sesto Quatrini returns to conduct Bizet’s electrifying and sensual score.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Under the oppressive heat of the Spanish sun, the fiercely independent Carmen attracts the attention of Don José. She warns him not to fall in love with her\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-11-10\",\"runtimeInMinutes\":215,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014297\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015504\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018979\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018980\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018981\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000473\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000043\"],\"externalIds\":{\"moviexchangeReleaseId\":\"180444c8-b825-4df9-8799-2f8b917f65de\",\"corporateId\":null},\"hopk\":\"HO00008945\",\"hoCode\":\"A000010092\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000014297\",\"name\":{\"givenName\":\"Alexander\",\"familyName\":\"Vinogradov\",\"middleName\":null}},{\"id\":\"0000015504\",\"name\":{\"givenName\":\"Barnaby\",\"familyName\":\"Rea\",\"middleName\":null}},{\"id\":\"0000018979\",\"name\":{\"givenName\":\"Ginger\",\"familyName\":\"Costa-Jackson\",\"middleName\":null}},{\"id\":\"0000018980\",\"name\":{\"givenName\":\"Russell\",\"familyName\":\"Thomas\",\"middleName\":null}},{\"id\":\"0000018981\",\"name\":{\"givenName\":\"Adriana\",\"familyName\":\"González\",\"middleName\":null}},{\"id\":\"HO00000473\",\"name\":{\"givenName\":\"Damiano \",\"familyName\":\"Michieletto\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000043\",\"name\":{\"text\":\"Opera\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDe