er\"]},{\"castAndCrewMemberId\":\"HO00000322\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001794\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001974\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000005\"],\"externalIds\":{\"moviexchangeReleaseId\":\"37b2b94f-65a0-481e-9d3c-bde2445c99a4\",\"corporateId\":null},\"hopk\":\"HO00008080\",\"hoCode\":\"A000009165\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008101\",\"title\":{\"text\":\"Marty Supreme\",\"translations\":[]},\"synopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, sex, nudity, injury detail, violence\",\"translations\":[]},\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":150,\"trailerUrl\":\"https://www.youtube.com/watch?v=s9gSuKaKcqM\",\"displayPriority\":7,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001370\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012950\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014188\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014753\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017170\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017171\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"17172\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17173\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17174\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"2227\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000258\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"90e71dd1-a916-4807-8aff-0dd9f141e72d\",\"corporateId\":null},\"hopk\":\"HO00008101\",\"hoCode\":\"A000009187\",\"eventId\":null,\"distributorName\":\"ENTERTAINMENT FILM DISTRIBUTOR\"},{\"id\":\"HO00008189\",\"title\":{\"text\":\"28 Years Later: The Bone Temple\",\"translations\":[]},\"synopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later: The Bone Temple. In a continuation of the epic story, Dr. Kelson (Ralph Fiennes) finds himself in a shocking new relationship - with consequences that could change the world as they know it - and Spike's (Alfie Williams) encounter with Jimmy Crystal (Jack O'Connell) becomes a nightmare he can't escape. In the world of The Bone Temple, the infected are no longer the greatest threat to survival - the inhumanity of the survivors can be stranger and more terrifying.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong gory violence, injury detail, very strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-14\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=wyYliP8dPWU\",\"displayPriority\":9,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000097\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000442\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002404\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002653\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005575\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014011\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014577\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017356\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000576\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"12790418-6492-492a-814c-53673bc1ab1a\",\"corporateId\":null},\"hopk\":\"HO00008189\",\"hoCode\":\"A000009281\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008193\",\"title\":{\"text\":\"Mercy\",\"translations\":[]},\"synopsis\":{\"text\":\"In the near future, a detective (Chris Pratt) stands on trial accused of murdering his wife. He has 90 minutes to prove his innocence to the advanced A.I. Judge (Rebecca Ferguson) he once championed, before it determines his fate.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In the near future, a detective (Chris Pratt) stands on trial accused of murdering his wife. He has 90 minutes to prove his innocence to the advanced A.I. Judge.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate violence, threat, injury detail, drug misuse, strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=sN-C09dfczY\",\"displayPriority\":12,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003235\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000009008\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017362\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017363\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017364\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000086\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000825\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000982\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001684\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002432\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"eea3fe00-3e2b-4dcc-9150-aedd76790a42\",\"corporateId\":null},\"hopk\":\"HO00008193\",\"hoCode\":\"A000009285\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008195\",\"title\":{\"text\":\"Is This Thing On?\",\"translations\":[]},\"synopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family — forcing them to navigate co-parenting, identity, and whether love can take a new form.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":121,\"trailerUrl\":\"https://www.youtube.com/watch?v=ngmu5zGOa7s\",\"displayPriority\":11,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000027\",\"roles\":[\"Actor\",\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000883\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000002332\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004642\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017365\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017366\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017367\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"30\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c59e6ef3-faa4-469e-9fc7-2d8997cff25e\",\"corporateId\":null},\"hopk\":\"HO00008195\",\"hoCode\":\"A000009287\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008237\",\"title\":{\"text\":\"Shelter\",\"translations\":[]},\"synopsis\":{\"text\":\"On a remote coastal island, a man living in self-imposed exile rescues a young girl from a deadly storm. This action sets off a chain of events, bringing him out of seclusion and both into harm’s way. As their lives intertwine, he must navigate protecting the orphaned girl while battling enemies from is past - setting them both on a breathless odyssey for survival and a deeper journey toward redemption.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"On a remote coastal island, a man living in self-imposed exile rescues a young girl from a deadly storm.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":107,\"trailerUrl\":null,\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000262\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001557\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002147\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014866\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016569\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017459\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000088\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000251\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001694\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001819\",\"roles\":[\"Actor\",\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000007\",\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9e3b2fd7-c5b2-4dee-857d-9dc3d230e4cd\",\"corporateId\":null},\"hopk\":\"HO00008237\",\"hoCode\":\"A000009331\",\"eventId\":null,\"distributorName\":\"Black Bear Pictures\"},{\"id\":\"HO00008239\",\"title\":{\"text\":\"Kangaroo\",\"translations\":[]},\"synopsis\":{\"text\":\"KANGAROO is a heart-warming family comedy about ex TV personality, Chris Masterman, who becomes stranded in an Outback town outside Alice Springs. There, he teams up with 12-year-old Indigenous girl Charlie. The pair form an unlikely friendship and work together to rescue and rehabilitate orphaned joeys in the remote but stunning Outback community - an endeavour that proves to be life-changing for them both.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"KANGAROO is a heart-warming family comedy about an ex-TV personality Chris Masterman, who becomes stranded in an Outback town after a car accident on his way to Broome. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild bad language, threat, violence\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":107,\"trailerUrl\":\"https://www.youtube.com/watch?v=BAwuJ74KP6U\",\"displayPriority\":12,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002636\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006784\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011449\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011614\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012011\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016712\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016713\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000016714\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016715\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016716\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016717\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016718\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016719\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016720\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016721\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016722\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016723\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016724\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016725\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002378\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2190fa2f-4101-475d-848f-b328ee1f0b8d\",\"corporateId\":null},\"hopk\":\"HO00008239\",\"hoCode\":\"A000009333\",\"eventId\":null,\"distributorName\":\"STUDIOCANAL\"},{\"id\":\"HO00008273\",\"title\":{\"text\":\"Primate\",\"translations\":[]},\"synopsis\":{\"text\":\"In PRIMATE, a group of friends’ tropical vacation turns into a terrifying, primal tale of horror and survival.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In PRIMATE, a group of friends’ tropical vacation turns into a terrifying, primal tale of horror and survival.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong bloody violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":89,\"trailerUrl\":\"https://www.youtube.com/watch?v=L9Odp8RvbLo\",\"displayPriority\":10,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000017524\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017525\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017526\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017527\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017528\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017529\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017530\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017532\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017533\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002732\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"67aa2582-ac18-4747-8f49-005d24853af3\",\"corporateId\":null},\"hopk\":\"HO00008273\",\"hoCode\":\"A000009367\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00008327\",\"title\":{\"text\":\"No Other Choice\",\"translations\":[]},\"synopsis\":{\"text\":\"Man-su (Lee Byung Hun), a specialist in paper manufacturing with 25 years of experience, is so satisfied with life that he can truthfully tell himself, “I’ve got it all.” While happily passing his days with his wife Miri (Son Yejin), their two children and two dogs, Man-su is suddenly informed by his company that he has been fired.\\n“We’re sorry. We have no other choice.”\\nFeeling shocked as if his head had been cut off by an ax, Man-su vows to find himself a new job within the next three months for the sake of his family. Despite his firm resolve to turn his life around, Man-su spends over a year drifting from one job interview after another, and working at a retail store. He eventually finds himself in danger of losing the very house that he struggled so hard to buy.\\nDesperate, he visits Moon Paper out of the blue and tries to hand over his CV, but he just ends up getting humiliated by line manager Choi Sun-chul (Park Hee Soon). Man-su knows he is better qualified than anyone to work at Moon Paper, so he comes to a certain decision.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, violence, injury detail, sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":139,\"trailerUrl\":null,\"displayPriority\":13,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000010701\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016863\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017619\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017620\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017621\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017622\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000009\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e660de4a-88af-472a-a1e1-57ffb9dcbb49\",\"corporateId\":null},\"hopk\":\"HO00008327\",\"hoCode\":\"A000009425\",\"eventId\":null,\"distributorName\":\"MUBI UK Ltd\"},{\"id\":\"HO00008366\",\"title\":{\"text\":\"Melania\",\"translations\":[]},\"synopsis\":{\"text\":\"Offering unprecedented access to the 20 days leading up to the 2025 Presidential Inauguration — through the eyes of the First Lady-elect herself — step inside Melania Trump's world as she orchestrates inauguration plans, navigates the complexities of the White House transition, and reenters public life with her family. With exclusive footage capturing critical meetings, private conversations, and never-before-seen environments, Mrs. Trump returns to one of the world's most powerful roles.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Offering unprecedented access to the 20 days leading up to the 2025 Presidential Inauguration — through the eyes of the First Lady-elect herself.\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild bad language, upsetting scenes, brief sexual violence references\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":104,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002852\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017676\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017677\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000008\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e0b807dc-6fff-41b2-90d7-5637351348c3\",\"corporateId\":null},\"hopk\":\"HO00008366\",\"hoCode\":\"A000009466\",\"eventId\":null,\"distributorName\":\"SHEAR ENTERTAINMENT\"},{\"id\":\"HO00008431\",\"title\":{\"text\":\"Mardaani 3\",\"translations\":[]},\"synopsis\":{\"text\":\"The blockbuster Mardaani franchise has received unanimous love from people and has attained a cult status amongst cine-lovers. Mardaani 3 will see Rani Mukerji reprise the role of a daredevil cop, Shivani Shivaji Roy, who selflessly fights for justice. This film will be a bloody, violent clash between Shivani’s goodness vs sinister evil forces as she begins an extraordinary race against time to hunt and rescue scores of missing girls of the country.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Mardaani 3 will see Rani Mukerji reprise the role of a daredevil cop, Shivani Shivaji Roy, who selflessly fights for justice. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong threat, violence, injury detail, sexual threat\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":130,\"trailerUrl\":\"https://www.youtube.com/watch?v=V4TJKSEftkU\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000714\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011547\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017800\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"17860\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002020\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"96f02b86-c02e-4978-bb33-f79eeb7ad66d\",\"corporateId\":null},\"hopk\":\"HO00008431\",\"hoCode\":\"A000009536\",\"eventId\":null,\"distributorName\":\"YASH RAJ FILMS LTD\"}],\"castAndCrew\":[{\"id\":\"0000000560\",\"name\":{\"givenName\":\"Kate\",\"familyName\":\"Winslet\",\"middleName\":null}},{\"id\":\"0000002207\",\"name\":{\"givenName\":\"Stephen\",\"familyName\":\"Lang\",\"middleName\":null}},{\"id\":\"0000002294\",\"name\":{\"givenName\":\"Cliff\",\"familyName\":\"Curtis\",\"middleName\":null}},{\"id\":\"0000005786\",\"name\":{\"givenName\":\"Sam\",\"familyName\":\"Worthington\",\"middleName\":null}},{\"id\":\"0000005787\",\"name\":{\"givenName\":\"Oona\",\"familyName\":\"Chaplin\",\"middleName\":null}},{\"id\":\"0000007837\",\"name\":{\"givenName\":\"Jack\",\"familyName\":\"Champion\",\"middleName\":nu