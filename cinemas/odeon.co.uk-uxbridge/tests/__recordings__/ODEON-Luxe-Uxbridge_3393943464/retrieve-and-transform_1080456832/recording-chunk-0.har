00000006\",\"0000000147\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"593-73911\",\"schedule\":{\"businessDate\":\"2026-02-15\",\"startsAt\":\"2026-02-15T18:00:00+00:00\",\"endsAt\":\"2026-02-15T20:05:00+00:00\",\"filmStartsAt\":\"2026-02-15T18:25:00+00:00\",\"filmEndsAt\":\"2026-02-15T20:05:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"593-3-125\",\"filmId\":\"HO00008201\",\"siteId\":\"593\",\"screenId\":\"593-3\",\"areaCategories\":[{\"areaCategoryId\":\"593-0000000014\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000018\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"593-73268\",\"schedule\":{\"businessDate\":\"2026-02-15\",\"startsAt\":\"2026-02-15T20:00:00+00:00\",\"endsAt\":\"2026-02-15T22:45:00+00:00\",\"filmStartsAt\":\"2026-02-15T20:25:00+00:00\",\"filmEndsAt\":\"2026-02-15T22:45:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"593-1-136\",\"filmId\":\"HO00008205\",\"siteId\":\"593\",\"screenId\":\"593-1\",\"areaCategories\":[{\"areaCategoryId\":\"593-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000018\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"593-0000000021\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000145\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"593\",\"name\":{\"text\":\"Uxbridge\",\"translations\":[]},\"location\":{\"latitude\":51.545,\"longitude\":-0.4757},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Uxbridge@odeonuk.com\",\"address\":{\"line1\":\"302 The Chimes Shopping Centre\",\"line2\":\"\",\"city\":\"Uxbridge\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006631\",\"title\":{\"text\":\"The Bad Guys 2\",\"translations\":[]},\"synopsis\":{\"text\":\"Who’s badder than The Bad Guys? The Bad Girls.\\n\\nIn the new chapter from DreamWorks Animation’s acclaimed 2022 action-comedy hit about a crackerjack criminal crew of animal outlaws, The Bad Guys are struggling to find trust and acceptance in their newly minted lives as Good Guys, when they are pulled out of retirement and forced to do “one last job” by an all-female squad of criminals.\\n\\nBased on the New York Times best-selling book series by Aaron Blabey, The Bad Guys 2 reunites the film’s all-star cast and filmmakers.\\n\\nReturning to their roles as The Bad Guys are Academy Award® winner Sam Rockwell as dashing reformed pickpocket Mr. Wolf; Marc Maron as safe-cracker Mr. Snake, Craig Robinson as master-of-disguise Mr. Shark, Grammy winner Anthony Ramos as the short-fused Mr. Piranha and Golden Globe winner Awkwafina as expert hacker Ms. Tarantula, aka “Webs.”\\n\\nThe A-list comedic cast includes the return of Zazie Beetz as Diana Foxington, BAFTA winner Richard Ayoade as Professor Marmalade, Emmy winner Alex Borstein as police chief Misty Luggins and Lilly Singh as Tiffany Fluffit.\\n\\nThe Bad Guys 2 is directed by returning filmmaker Pierre Perifel and produced by returning producer Damon Ross. The co-director is JP Sans, who served as head of character animation on The Bad Guys, and the music is by Oscar®-nominated returning composer Daniel Pemberton.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Bad Guys are struggling to find trust and acceptance in their newly minted lives as Good Guys, when they are pulled out of retirement and forced to do 'one last job'.\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild violence, threat, rude humour\",\"translations\":[]},\"releaseDate\":\"2025-07-25\",\"runtimeInMinutes\":104,\"trailerUrl\":\"https://www.youtube.com/watch?v=H5r_gDDSwqo\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000021\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000025\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002382\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004692\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004693\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004694\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000004695\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014125\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014126\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014127\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014128\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"4394\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000284\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001176\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002271\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"41b52a1e-482a-48ba-9dd1-bd2d2d318b4f\",\"corporateId\":null},\"hopk\":\"HO00006631\",\"hoCode\":\"A000007553\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008201\",\"title\":{\"text\":\"GOAT\",\"translations\":[]},\"synopsis\":{\"text\":\"From Sony Pictures Animation, the studio behind Spider-Man TM: Across the Spider-Verse and the artists that made KPop Demon Hunters, comes GOAT, an original action-comedy set in an all-animal world. The story follows Will, a small goat with big dreams who gets a once-in-a-lifetime shot to join the pros and play roarball–a high-intensity, co-ed, full-contact sport dominated by the fastest, fiercest animals in the world. Will’s new teammates aren’t thrilled about having a little goat on their roster, but Will is determined to revolutionize the sport and prove once and for all that “smalls can ball!”\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Sony Pictures Animation, the studio behind Spider-Man TM: Across the Spider-Verse and the artists that made KPop Demon Hunters, comes GOAT, an original action-comedy\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild violence, rude humour, language\",\"translations\":[]},\"releaseDate\":\"2026-02-13\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=kmY-rYS7yng\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000119\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002189\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006525\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009120\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011153\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011459\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017374\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017375\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017376\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017377\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017378\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017379\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017380\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017381\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017382\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017383\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017384\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"9353\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO000000