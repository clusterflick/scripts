ewMemberId\":\"0000014753\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017170\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017171\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"17172\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17173\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17174\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"2227\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000258\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"90e71dd1-a916-4807-8aff-0dd9f141e72d\",\"corporateId\":null},\"hopk\":\"HO00008101\",\"hoCode\":\"A000009187\",\"eventId\":null,\"distributorName\":\"ENTERTAINMENT FILM DISTRIBUTOR\"},{\"id\":\"HO00008189\",\"title\":{\"text\":\"28 Years Later: The Bone Temple\",\"translations\":[]},\"synopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later: The Bone Temple. In a continuation of the epic story, Dr. Kelson (Ralph Fiennes) finds himself in a shocking new relationship - with consequences that could change the world as they know it - and Spike's (Alfie Williams) encounter with Jimmy Crystal (Jack O'Connell) becomes a nightmare he can't escape. In the world of The Bone Temple, the infected are no longer the greatest threat to survival - the inhumanity of the survivors can be stranger and more terrifying.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong gory violence, injury detail, very strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-14\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=wyYliP8dPWU\",\"displayPriority\":9,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000097\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000442\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002404\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002653\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005575\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014011\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014577\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017356\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000576\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"12790418-6492-492a-814c-53673bc1ab1a\",\"corporateId\":null},\"hopk\":\"HO00008189\",\"hoCode\":\"A000009281\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008195\",\"title\":{\"text\":\"Is This Thing On?\",\"translations\":[]},\"synopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family — forcing them to navigate co-parenting, identity, and whether love can take a new form.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":121,\"trailerUrl\":\"https://www.youtube.com/watch?v=ngmu5zGOa7s\",\"displayPriority\":11,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000027\",\"roles\":[\"Actor\",\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000883\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000002332\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004642\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017365\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017366\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017367\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"30\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c59e6ef3-faa4-469e-9fc7-2d8997cff25e\",\"corporateId\":null},\"hopk\":\"HO00008195\",\"hoCode\":\"A000009287\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008237\",\"title\":{\"text\":\"Shelter\",\"translations\":[]},\"synopsis\":{\"text\":\"On a remote coastal island, a man living in self-imposed exile rescues a young girl from a deadly storm. This action sets off a chain of events, bringing him out of seclusion and both into harm’s way. As their lives intertwine, he must navigate protecting the orphaned girl while battling enemies from is past - setting them both on a breathless odyssey for survival and a deeper journey toward redemption.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"On a remote coastal island, a man living in self-imposed exile rescues a young girl from a deadly storm.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":107,\"trailerUrl\":null,\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000262\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001557\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002147\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014866\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016569\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017459\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000088\",\"roles\":[\"Producer\"]},