true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"593-78-HO00008728\"}],\"relatedData\":{\"sites\":[{\"id\":\"593\",\"name\":{\"text\":\"Uxbridge\",\"translations\":[]},\"location\":{\"latitude\":51.545,\"longitude\":-0.4757},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Uxbridge@odeonuk.com\",\"address\":{\"line1\":\"302 The Chimes Shopping Centre\",\"line2\":\"\",\"city\":\"Uxbridge\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00005888\",\"title\":{\"text\":\"Scream Unseen (4 August)\",\"translations\":[]},\"synopsis\":{\"text\":\"Screen Unseen's terrifying little sister...\\r\\n\\r\\nODEON Scream Unseen offers an exclusive screening with a twist!  Just like Screen Unseen, you book in advance not knowing what you’re watching until it starts – but this time, not only will you be the first cinema audience to see it, we aim to scare your socks off! \\r\\n\\r\\nLooking for something to quench your horror thirst? See pre-release screenings from just £6*\\r\\n\\r\\nMake sure you keep an eye on Facebook and Twitter for clues and hints on the spine-chilling, pre-release film we will be showcasing.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"ODEON Scream Unseen offers an exclusive screening with a twist!  Just like Screen Unseen, you book in advance not knowing what you’re watching until it starts \",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-04\",\"runtimeInMinutes\":120,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":\"A000000147\"},\"hopk\":\"HO00005888\",\"hoCode\":\"A000006750\",\"eventId\":null,\"distributorName\":\"ODEON/UCI (Dummy Distributor)\"},{\"id\":\"HO00008728\",\"title\":{\"text\":\"Spider-Man: Brand New Day\",\"translations\":[]},\"synopsis\":{\"text\":\"It's a BRAND NEW DAY for Peter Parker. Fighting crime full-time as Spider-Man in a world that doesn’t remember him -- and the pressure of seeing his old friends move on without him -- sparks a change in Peter he may not have the power to control. But that transformation might also be the only thing that can stop a shocking new threat to the city and those he loves - a powerful villain no one can even see.\\n\\nThe world may have forgotten Peter Parker, but he hasn’t forgotten them.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It's a BRAND NEW DAY for Peter Parker. Fighting crime full-time as Spider-Man in a world that doesn’t remember him sparks a change he may not have the power to control.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-29\",\"runtimeInMinutes\":140,\"trailerUrl\":\"https://www.youtube.com/watch?v=qwVAc2MmlwU\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000122\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000212\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003682\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007703\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010992\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018489\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018490\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000263\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000267\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000807\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000969\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00002248\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000003\",\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"db62eee0-9bc4-4169-8b2c-be507018ab7e\",\"corporateId\":null},\"hopk\":\"HO00008728\",\"hoCode\":\"A000009856\",\"eventId\":n