CrewMemberId\":\"0000002933\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004242\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009613\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010641\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017418\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017419\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"7850\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000222\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002742\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e4e53d03-846a-4c4b-a95f-af4af0f815b4\",\"corporateId\":null},\"hopk\":\"HO00008218\",\"hoCode\":\"A000009312\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008744\",\"title\":{\"text\":\"Obsession\",\"translations\":[]},\"synopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for but soon discovers that some desires come at a dark, sinister price.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong violence, gore\",\"translations\":[]},\"releaseDate\":\"2026-05-15\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=fWLaCC8L6Jo\",\"displayPriority\":10,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002047\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006579\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018515\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018516\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018517\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018518\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018519\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018520\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000018521\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a6a25d26-497a-4daa-a5ff-b5fc9719faca\",\"corporateId\":null},\"hopk\":\"HO00008744\",\"hoCode\":\"A000009874\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008916\",\"title\":{\"text\":\"The Odyssey\",\"translations\":[]},\"synopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. The film brings Homer’s foundational saga to IMAX® film screens for the first time. \\n\\nThe Odyssey stars Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson and Lupita Nyong’o, with Zendaya and Charlize Theron.\\n\\nThe Odyssey is produced by Emma Thomas and Christopher Nolan for their company, Syncopy. The executive producer is Thomas Hayslip.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":173,\"trailerUrl\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000008\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000150\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000155\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000018948\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000018\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000064\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000267\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002248\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b63dbbaf-6c0e-4622-b9b1-698037e6247e\",\"corporateId\":null},\"hopk\":\"HO00008916\",\"hoCode\":\"A000010058\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008964\",\"title\":{\"text\":\"Evil Dead Burn\",\"translations\":[]},\"synopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. After the loss of her husband, a woman seeks solace with her in-laws in their secluded family home. As one by one they are transformed into Deadites—turning the gathering into a family reunion from hell—she comes to discover that the vows she took in life... live on even in death.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. \",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong bloody violence, gore\",\"translations\":[]},\"releaseDate\":\"2026-07-09\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=YYkUkyfjUKg\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000008177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009258\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019021\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019022\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019023\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019024\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000303\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"3c50ff95-67b2-4152-9965-ad2431794116\",\"corporateId\":null},\"hopk\":\"HO00008964\",\"hoCode\":\"A000010114\",\"eventId\":null,\"distributorName\":\"STUDIOCANAL\"},{\"id\":\"HO00009027\",\"title\":{\"text\":\"Inception\",\"translations\":[]},\"synopsis\":{\"text\":\"Dom Cobb is a skilled thief, the absolute best in the dangerous art of extraction, stealing valuable secrets from deep within the subconscious during the dream state, when the mind is at its most vulnerable. Cobb's rare ability has made him a coveted player in this treacherous new world of corporate espionage, but it has also made him an international fugitive and cost him everything he has ever loved. Now Cobb is being offered a chance at redemption. One last job could give him his life back but only if he can accomplish the impossible, inception. Instead of the perfect heist, Cobb and his team of specialists have to pull off the reverse: their task is not to steal an idea, but to plant one. If they succeed, it could be the perfect crime. But no amount of careful planning or expertise can prepare the team for the dangerous enemy that seems to predict their every move. An enemy that only Cobb could have seen coming.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A thief who steals corporate secrets through the use of dream-sharing technology is given the inverse task of planting an idea into the mind of a C.E.O.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"Contains moderate violence\",\"translations\":[]},\"releaseDate\":\"2026-06-05\",\"runtimeInMinutes\":148,\"trailerUrl\":\"https://www.youtube.com/watch?v=W7OTkEY1tMI\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000148\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000155\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000156\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000218\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000734\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001160\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001174\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001755\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002345\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002346\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002347\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002348\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000020\",\"0000000045\"],\"externalIds\":{\"moviexchangeReleaseId\":\"21f68d3c-d4f1-447c-ab24-cdc95c6ba2cf\",\"corporateId\":null},\"hopk\":\"HO00009027\",\"hoCode\":\"A000010180\",\"eventId\":null,\"distributorName\":\"WARNER BROS DISTRIBUTORS LTD\"},{\"id\":\"HO00009029\",\"title\":{\"text\":\"Interstellar\",\"translations\":[]},\"synopsis\":{\"text\":\"A team of explorers travel through a wormhole in space in an attempt to ensure humanity's survival.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A team of explorers travel through a wormhole in space in an attempt to ensure humanity's survival.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate threat, violence\",\"translations\":[]},\"releaseDate\":\"2026-06-05\",\"runtimeInMinutes\":166,\"trailerUrl\":\"https://www.youtube.com/watch?v=LY19rHKAaAg\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000148\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000155\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000156\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000736\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000737\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000738\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000064\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000805\",\"roles\":[