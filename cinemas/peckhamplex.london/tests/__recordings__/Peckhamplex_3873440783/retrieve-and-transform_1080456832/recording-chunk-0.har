forEach((csCta) => {\n            csCta.style.display = 'none';\n          });\n        }\n\n        function doCheckCsCats(cats) {\n          if(cats.includes('targeting')) {\n            doRemoveCsCtas();\n          }\n        }\n\n        window.addEventListener('CookieScriptLoaded', function(event) {\n          var csState = CookieScript.instance.currentState();\n          doCheckCsCats(csState.categories);\n          CookieScript.instance.onAcceptAll = function (data) {\n            if(csCtas.length > 0) {\n              doRemoveCsCtas();\n            }\n          }\n        })\n  })\n</script>\n\n<script type=\"application/ld+json\">\n  {\n    \"@context\": \"http://schema.org\",\n    \"@type\": \"MovieTheater\",\n    \"description\": \"Multi-screen cinema showing the latest blockbuster and 3D film releases, with cheap tickets all day.\",\n    \"name\": \"Peckhamplex Cinema\",\n    \"logo\": \"https://www.peckhamplex.london/imgs/generic/peckhamplex-title-treatment.png\",\n    \"image\": \"https://www.peckhamplex.london/imgs/generic/pecky-frontage-sign.jpg\",\n    \"email\": \"managers@peckhamplex.net\",\n    \"telephone\": \"0844567727742\",\n    \"url\": \"https://www.peckhamplex.london\",\n    \"address\": {\n      \"@type\": \"PostalAddress\",\n      \"addressLocality\": \"London\",\n      \"addressRegion\": \"London\",\n      \"postalCode\": \"SE15 4ST\",\n      \"streetAddress\": \"95A Rye Lane\"\n    },\n    \"openingHours\": \"Mo,Tu,We,Th,Fr, Sa,Su 11:00-00:00\",\n    \"priceRange\": \"£4.99 - £9.99\",\n    \"geo\": {\n      \"@type\": \"GeoCoordinates\",\n      \"latitude\": \"51.4708403\",\n      \"longitude\": \"-0.0704681\"\n    },\n    \"sameAs\": [\"https://www.twitter.com/PeckhamPlex\",\n      \"https://www.facebook.com/PeckhamPlex\"\n    ],\n    \"hasMap\": \"https://www.google.co.uk/maps/place/Peckhamplex/@51.4708403,-0.0704681,17z/data=!3m1!4b1!4m2!3m1!1s0x487603a04ed28a3b:0x281104011b747159\"\n  }\n</script>\n\n    </div>\n    <link rel=\"sty