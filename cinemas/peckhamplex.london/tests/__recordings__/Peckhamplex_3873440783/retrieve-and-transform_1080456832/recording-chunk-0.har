">\n        <link itemprop=\"url\" href=\"https://www.peckhamplex.london/film/tfff-captain-america\" />\n\n        <h1 class=\"page-title\" itemprop=\"name\">TFFF: Captain America</h1>\n        <!-- Film Details -->\n        <div class=\"inner-content-wrapper\">\n            <div class=\"details-wrapper\">\n                <div class=\"info-section\">\n                    <div class=\"poster-wrapper\">\n                        <div class=\"poster\">\n                                                        <img itemprop=\"image\" src=\"/imgs/posters/large/tfff-captain-america.jpg\" alt=\"TFFF: Captain America\" title=\"TFFF: Captain America\" />\n                        </div>\n                    </div>\n                    <div class=\"info\">\n                        <p><b>Format:</b> 2D Digital\n                                                    </p>\n                        <p><b>Genre:</b> Adventure</p>\n                        <p><b>Running Time:</b> 2 hours</p>\n                        <p><b>Rate:</b> PG<br /></p>\n                        <br />\n                        <p><i class=\"fa fa-info-circle\"></i> Free List Suspended</p>                        <p><i class=\"fa fa-wheelchair\"></i> Wheelchair/Disabled Access</p>                                                <p class=\"more-info\">For more cinema access information <br class=\"show-on-ip\"><a href=\"https://www.peckhamplex.london/cinema/access\">click here</a>.\n                        <meta itemprop=\"dateCreated\" content=\"01-01-1970\">\n                    </div>\n\n                </div><!-- end of poster -->\n                <div class=\"content\">\n                    <!-- synopsis -->\n                                        <div class=\"synopsis\">\n                        <h3>TFFF: Captain America Synopsis</h3>\n                        <p itemprop=\"description\">The Final Film festival 7-9 Aug 26<br />\r\nSee events page for information<br />\r\n<br />\r\nCaptain America (1990)<br />\r\n<br />\r\nDuring World War II, a brave, patriotic American Soldier undergoes experiments to become a new supersoldier, \"Captain America\". Racing to Germany to sabotage the rockets of Nazi baddie \"Red Skull\", Captain America winds up frozen until the 1990s. He reawakens to find that the Red Skull has changed identities and is now planning to kidnap the President of the United States.<br />\r\n<br />\r\nThis screening will be preceded by an intro.</p>\n                                                                    </div><!-- end of synopsis -->\n                                        <a name=\"watchwithbaby\" id=\"watchwithbaby\"></a>\n\n                    \n                    <!-- Book Tickets -->\n                                        <div class=\"book-tickets\">\n        <h3>Book Tickets</h3>\n    <div class=\"book-tickets-listings\">\n\n                        <div class=\"date-wrapper\">\n            <p class=\"ticket-date\">Saturday 8th August 2026</p>\n            <div class=\"btn-group\" role=\"group\">\n                                                <a class=\"btn btn-info\" onclick=\"gtag('event', 'click', {'event_category' :'book tickets', 'event_label': 'TFFF: Captain America : Saturday 8th August 2026 at 21:00'})\" href=\"https://ticketing.eu.veezi.com/purchase/81481?siteToken=zkD3Bh7H%2fkuZI9VTgCj%2bgg%3d%3d\" target=\"_blank\"><time datetime=\"2026-08-08T21:00\">21:00</time></a>\n                                            </div>\n        </div>\n        \n        \n        \n    </div>\n    <br />\n</div><!-- end of book-tickets -->                                                            <!-- Book Tickets -->\n\n                    <!-- Cast Crew -->\n                                        <!-- end of Cast Crew -->\n\n                    <br />\n                    <!-- Social Sharing -->\n<div class=\"social-share-wrapper\">\n        <!-- Facebook -->\n        <div class=\"fb-share-button\" data-href=\"https://www.peckhamplex.london