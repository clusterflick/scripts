"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/></g></svg>\n        </a>\n    </div>\n</div>        </div>\n      </div>\n          </div>\n    <!-- end of right-content -->\n  </div>\n</footer>\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n        //Cookie Script\n        var csCtas = document.querySelectorAll('.cookie-inf');\n        //Remove Cookie Guard if there is no video\n        let checkElem = setInterval(() => {\n          if(document.querySelector('.rsContent')) {\n            let elemChildren = document.querySelector('.rsContent').children.length\n            console.log(elemChildren)\n            if( elemChildren === 4 ) {\n              doRemoveCsCtas()\n              clearInterval(checkElem)\n            }\n            else {\n              clearInterval(checkElem)\n            }\n          }\n          else {\n            clearInterval(checkElem)\n          }\n        }, 500);\n\n        function doRemoveCsCtas() {\n          csCtas.forEach((csCta) => {\n            csCta.style.display = 'none';\n          });\n        }\n\n        function doCheckCsCats(cats) {\n          if(cats.includes('targeting')) {\n            doRemoveCsCtas();\n          }\n        }\n\n        window.addEventListener('CookieScriptLoaded', function(event) {\n          var csState = CookieScript.instance.currentState();\n          doCheckCsCats(csState.categories);\n          CookieScript.instance.onAcceptAll = function (data) {\n            if(csCtas.length > 0) {\n              doRemoveCsCtas();\n            }\n          }\n        })\n  })\n</script>\n\n<script type=\"application/ld+json\">\n  {\n    \"@context\": \"http://schema.org\",\n    \"@type\": \"MovieTheater\",\n    \"description\": \"Multi-screen cinema showing the latest blockbuster and 3D film releases, with cheap tickets all day.\",\n    \"name\": \"Peckhamplex Cinema\",\n    \"logo\": \"https://www.peckhamplex.london/imgs/generic/peckhamplex-title-treatment.png\",\n    \"imag