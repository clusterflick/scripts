lex.london/film/evil-dead-burn\" />\n\n        <h1 class=\"page-title\" itemprop=\"name\">Evil Dead Burn</h1>\n        <!-- Film Details -->\n        <div class=\"inner-content-wrapper\">\n            <div class=\"details-wrapper\">\n                <div class=\"info-section\">\n                    <div class=\"poster-wrapper\">\n                        <div class=\"poster\">\n                                                        <img itemprop=\"image\" src=\"/imgs/posters/large/evil-dead-burn.jpg\" alt=\"Evil Dead Burn\" title=\"Evil Dead Burn\" />\n                        </div>\n                    </div>\n                    <div class=\"info\">\n                        <p><b>Format:</b> 2D Digital\n                                                    </p>\n                        <p><b>Genre:</b> Horror</p>\n                        <p><b>Running Time:</b> 1 hour 49 minutes</p>\n                        <p><b>Rate:</b> 18<br />strong bloody violence, gore</p>\n                        <br />\n                        <p><i class=\"fa fa-info-circle\"></i> Free List Suspended</p>                        <p><i class=\"fa fa-wheelchair\"></i> Wheelchair/Disabled Access</p>                                                <p class=\"more-info\">For more cinema access information <br class=\"show-on-ip\"><a href=\"https://www.peckhamplex.london/cinema/access\">click here</a>.\n                        <meta itemprop=\"dateCreated\" content=\"01-01-1970\">\n                    </div>\n\n                </div><!-- end of poster -->\n                <div class=\"content\">\n                    <!-- synopsis -->\n                                        <div class=\"synopsis\">\n                        <h3>Evil Dead Burn Synopsis</h3>\n                        <p itemprop=\"description\">After the loss of her husband, a woman seeks solace with her in-laws. As one by one they transform into deadites, she comes to discover that the vows she took in life - survive even in death.</p>\n                                                                    </div><!-- end of synopsis -->\n                                        <a name=\"watchwithbaby\" id=\"watchwithbaby\"></a>\n\n                    \n                    <!-- Book Tickets -->\n                                        <div class=\"book-tickets\">\n        <h3>Book Tickets</h3>\n    <div class=\"book-tickets-listings\">\n\n                                        <div class=\"date-wrapper\">\n            <p class=\"ticket-date\">Saturday 11th July 2026</p>\n            <div class=\"btn-group\" role=\"group\">\n                                                <a class=\"btn btn-info\" onclick=\"gtag('event', 'click', {'event_category' :'book tickets', 'event_label': 'Evil Dead Burn : Saturday 11th July 2026 at 18:30'})\" href=\"https://ticketing.eu.veezi.com/purchase/81492?siteToken=zkD3Bh7H%2fkuZI9VTgCj%2bgg%3d%3d\" target=\"_blank\"><time datetime=\"2026-07-11T18:30\">18:30</time></a>\n                                                                <a class=\"btn btn-info\" onclick=\"gtag('event', 'click', {'event_category' :'book tickets', 'event_label': 'Evil Dead Burn : Saturday 11th July 2026 at 21:00'})\" href=\"https://ticketing.eu.veezi.com/purchase/81509?siteToken=zkD3Bh7H%2fkuZI9VTgCj%2bgg%3d%3d\" target=\"_blank\"><time datetime=\"2026-07-11T21:00\">21:00</time></a>\n                                            </div>\n        </div>\n                                        <div class=\"date-wrapper\">\n            <p class=\"ticket-date\">Sunday 12th July 2026</p>\n            <div class=\"btn-group\" role=\"group\">\n                                                <a class=\"btn btn-info\" onclick=\"gtag('event', 'click', {'event_category' :'book tickets', 'event_label': 'Evil Dead Burn : Sunday 12th July 2026 at 16:00'})\" href=\"https://ticketing.eu.veezi.com/purchase/81544?siteToken=zkD3Bh7H%2fkuZI9VTgCj%2bgg%3d%3d\" target=\"_blank\"><time datetime=\"2026-07-12T16:00\">