div>\n<!-- end of HP: Top -->\n    <!-- end of Top Section -->\n    <div class=\"film-details-wrapper\" itemscope itemtype=\"http://schema.org/Movie\">\n        <link itemprop=\"url\" href=\"https://www.peckhamplex.london/film/out-of-print\" />\n\n        <h1 class=\"page-title\" itemprop=\"name\">Out Of Print</h1>\n        <!-- Film Details -->\n        <div class=\"inner-content-wrapper\">\n            <div class=\"details-wrapper\">\n                <div class=\"info-section\">\n                    <div class=\"poster-wrapper\">\n                        <div class=\"poster\">\n                                                        <img itemprop=\"image\" src=\"/imgs/posters/large/out-of-print.jpg\" alt=\"Out Of Print\" title=\"Out Of Print\" />\n                        </div>\n                    </div>\n                    <div class=\"info\">\n                        <p><b>Format:</b> 2D Digital\n                                                    </p>\n                        <p><b>Genre:</b> Documentary</p>\n                        <p><b>Running Time:</b> 1 hour 30 minutes</p>\n                        <p><b>Rate:</b> 18<br /></p>\n                        <br />\n                        <p><i class=\"fa fa-info-circle\"></i> Free List Suspended</p>                        <p><i class=\"fa fa-wheelchair\"></i> Wheelchair/Disabled Access</p>                                                <p class=\"more-info\">For more cinema access information <br class=\"show-on-ip\"><a href=\"https://www.peckhamplex.london/cinema/access\">click here</a>.\n                        <meta itemprop=\"dateCreated\" content=\"01-01-1970\">\n                    </div>\n\n                </div><!-- end of poster -->\n                <div class=\"content\">\n                    <!-- synopsis -->\n                                        <div class=\"synopsis\">\n                        <h3>Out Of Print Synopsis</h3>\n                        <p itemprop=\"description\">DOCUMENTARY SEASON PRESENTS<br />\r\n10th Anniversary Screening<br />\r\n<br />\r\nOut of Print is a love letter to watching movies on film, in independent cinemas, with an audience. The documentary features Los Angeles’ iconic New Beverly Cinema and London’s legendary Prince Charles Cinema as stand-ins for the thousands of extraordinary movie houses around the globe that keep cinema's rich culture alive.  <br />\r\n<br />\r\n<br />\r\nSee events page for ore detail</p>\n                                                                    </div><!-- end of synopsis -->\n                                        <a name=\"watchwithbaby\" id=\"watchwithbaby\"></a>\n\n                    \n                    <!-- Book Tickets -->\n                                        <div class=\"book-tickets\">\n        <h3>Book Tickets</h3>\n    <div class=\"book-tickets-listings\">\n\n                        <div class=\"date-wrapper\">\n            <p class=\"ticket-date\">Monday 13th July 2026</p>\n            <div class=\"btn-group\" role=\"group\">\n                                                <a class=\"btn btn-info\" onclick=\"gtag('event', 'click', {'event_category' :'book tickets', 'event_label': 'Out Of Print : Monday 13th July 2026 at 18:30'})\" href=\"https://ticketing.eu.veezi.com/purchase/81075?siteToken=zkD3Bh7H%2fkuZI9VTgCj%2bgg%3d%3d\" target=\"_blank\"><time datetime=\"2026-07-13T18:30\">18:30</time></a>\n                                            </div>\n        </div>\n        \n        \n        \n    </div>\n    <br />\n</div><!-- end of book-tickets -->                                                            <!-- Book Tickets -->\n\n                    <!-- Cast Crew -->\n                                        <!-- end of Cast Crew -->\n\n                    <br />\n                    <!-- Social Sharing -->\n<div class=\"social-share-wrapper\">\n        <!-- Facebook -->\n        <div class=\"fb-share-button\" data-href=\"https://www.peckhamplex.london/film/out-of-pri