\n\n        <h1 class=\"page-title\" itemprop=\"name\">La Traviata on Sydney Harbour</h1>\n        <!-- Film Details -->\n        <div class=\"inner-content-wrapper\">\n            <div class=\"details-wrapper\">\n                <div class=\"info-section\">\n                    <div class=\"poster-wrapper\">\n                        <div class=\"poster\">\n                                                        <img itemprop=\"image\" src=\"/imgs/posters/large/la-traviata.jpg\" alt=\"La Traviata on Sydney Harbour\" title=\"La Traviata on Sydney Harbour\" />\n                        </div>\n                    </div>\n                    <div class=\"info\">\n                        <p><b>Format:</b> 2D Digital\n                                                    </p>\n                        <p><b>Genre:</b> Opera</p>\n                        <p><b>Running Time:</b> 2 hours 40 minutes</p>\n                        <p><b>Rate:</b> PG<br /></p>\n                        <br />\n                        <p><i class=\"fa fa-info-circle\"></i> Free List Suspended</p>                        <p><i class=\"fa fa-wheelchair\"></i> Wheelchair/Disabled Access</p>                                                <p class=\"more-info\">For more cinema access information <br class=\"show-on-ip\"><a href=\"https://www.peckhamplex.london/cinema/access\">click here</a>.\n                        <meta itemprop=\"dateCreated\" content=\"01-01-1970\">\n                    </div>\n\n                </div><!-- end of poster -->\n                <div class=\"content\">\n                    <!-- synopsis -->\n                                        <div class=\"synopsis\">\n                        <h3>La Traviata on Sydney Harbour Synopsis</h3>\n                        <p itemprop=\"description\">La Traviata on Sydney Harbour<br />\r\nVerdi’s hugely popular La Traviata returns to the Sydney Harbour water stage featuring a<br />\r\nbreath-taking soaring 9 metre high, 3.5 ton chandelier covered in 10,000 shimmering Swarovski<br />\r\ncrystals. This glamorous production was captured on location on Sydney Harbour in 2021 in<br />\r\nfront of a sold out audience. La Traviata features timeless romantic arias, lively choreography,<br />\r\nbeautiful costumes and spectacular fireworks.</p>\n                                                                    </div><!-- end of synopsis -->\n                                        <a name=\"watchwithbaby\" id=\"watchwithbaby\"></a>\n\n                    \n                    <!-- Book Tickets -->\n                                        <div class=\"book-tickets\">\n        <h3>Book Tickets</h3>\n    <div class=\"book-tickets-listings\">\n\n                        <div class=\"date-wrapper\">\n            <p class=\"ticket-date\">Wednesday 2nd September 2026</p>\n            <div class=\"btn-group\" role=\"group\">\n                                                <a class=\"btn btn-info\" onclick=\"gtag('event', 'click', {'event_category' :'book tickets', 'event_label': 'La Traviata on Sydney Harbour : Wednesday 2nd September 2026 at 19:45'})\" href=\"https://ticketing.eu.veezi.com/purchase/80790?siteToken=zkD3Bh7H%2fkuZI9VTgCj%2bgg%3d%3d\" target=\"_blank\"><time datetime=\"2026-09-02T19:45\">19:45</time></a>\n                                            </div>\n        </div>\n        \n        \n        \n    </div>\n    <br />\n</div><!-- end of book-tickets -->                                                            <!-- Book Tickets -->\n\n                    <!-- Cast Crew -->\n                                        <!-- end of Cast Crew -->\n\n                    <br />\n                    <!-- Social Sharing -->\n<div class=\"social-share-wrapper\">\n        <!-- Facebook -->\n        <div class=\"fb-share-button\" data-href=\"https://www.peckhamplex.london/film/la-traviata\" data-layout=\"button\"></div>\n        <!-- Twitter -->\n        <a href=\"https://twitter.com/share\" \n            class=\"twitter-share-button\" \n            data-url=\"https://www.peckhamplex.london/film/la-traviata\" \n            data-text=\"La Traviata on Sydney Harbour\" \n            data-hashtags=\"peckhamplex,movies,cinema\">Tweet</a>\n        <!-- Google -->\n        <div class=\"g-plus\" data-action=\"share\" data-annotation=\"none\" data-height=\"20\"></div>\n</div>\n<!-- end of Social Sharing -->\n\n\n                </div><!-- end of content -->\n\n            </div><!-- end of details-wrapper -->\n        </div><!-- end of inner-content-wrapper -->\n\n    </div><!-- end of film-details-wrapper -->\n\n</div><!-- end of inner-content -->\n                </main>\n                <!-- End of Main Content -->\n            </div>\n             <!-- end of content wrapper-->\n            <!-- right skyscroaer ad -->\n           <div  id=\"skyscraper\" class=\"skyscraper-right\">\n   <div class=\"a-d-wrapper\">\n<div id='div-gpt-ad-1680277686448-0' style='min-width: 120px; min-height: 600px;'>\n  <script>\n    googletag.cmd.push(function() { googletag.display('div-gpt-ad-1680277686448-0'); });\n  </script>\n</div>\n   </div>\n</div>\n        </div>\n        <!-- end of ads wrapper -->\n                         <!-- SU: form -->\n        <div class=\"membership-wrapper\">\n        <div class=\"membership-txt\">Subscribe to the Peckhamplex newsletter to receive our latest film news, events & releases.</div>\n        <div class=\"membership-btn\"><a href=\"/newsletter/subscribe\">Subscribe</a></div>\n</div>\n         <!-- end of SU: form -->\n                  <!-- Footer -->\n        <footer>\n  <div class=\"footer-wrapper\">\n    <!-- left-content -->\n    <div class=\"left-content-wrapper\">\n      <!-- Side Nav -->\n      <nav role=\"quick-links\">\n                <ul>\n          <li class=\"\"><a href=\"https://www.peckhamplex.london\">Home</a></li>\n          <li class=\"\"><a href=\"https://www.peckhamplex.london/films/out-now\">Films Out Now</a></li>\n          <li class=\"