                   <div class=\"poster\">\n                                                        <img itemprop=\"image\" src=\"/imgs/posters/large/never-had-a-chance.jpg\" alt=\"Never Had a Chance\" title=\"Never Had a Chance\" />\n                        </div>\n                    </div>\n                    <div class=\"info\">\n                        <p><b>Format:</b> 2D Digital\n                                                    </p>\n                        <p><b>Genre:</b> Drama</p>\n                        <p><b>Running Time:</b> 1 hour 42 minutes</p>\n                        <p><b>Rate:</b> 18<br />very strong language, strong injury detail</p>\n                        <br />\n                        <p><i class=\"fa fa-info-circle\"></i> Free List Suspended</p>                        <p><i class=\"fa fa-wheelchair\"></i> Wheelchair/Disabled Access</p>                                                <p class=\"more-info\">For more cinema access information <br class=\"show-on-ip\"><a href=\"https://www.peckhamplex.london/cinema/access\">click here</a>.\n                        <meta itemprop=\"dateCreated\" content=\"01-01-1970\">\n                    </div>\n\n                </div><!-- end of poster -->\n                <div class=\"content\">\n                    <!-- synopsis -->\n                                        <div class=\"synopsis\">\n                        <h3>Never Had a Chance Synopsis</h3>\n                        <p itemprop=\"description\">When Ravi meets Sukhi, he wants to settle down and have a 'normal' life. But his best mate Jay has other plans and soon he's dragged back to the reality of the streets.</p>\n                                                                    </div><!-- end of synopsis -->\n                                        <a name=\"watchwithbaby\" id=\"watchwithbaby\"></a>\n\n                    \n                    <!-- Book Tickets -->\n                                        <p>There are currently no dates/times available for this film.</p>\n                                                            <!-- Book Tickets -->\n\n                    <!-- Cast Crew -->\n                                        <div class=\"cast-crew\">\n\t<h3>Cast &amp; Crew</h3>\n\t<!-- Directors -->\n\t\t<div class=\"cast-crew-wrapper\">\n\t\t<div class=\"cast-crew-title\">\n\t\t\t Director \t\t</div>\n\t\t<div class=\"cast-crew-names\">\n\t\t\t\t\t\t<span class=\"cast-crew-names\" itemprop=\"director\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Jazz Bhalla</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t</div>\n\t</div>\n\t\t<!-- Actors -->\n\t\t<div class=\"cast-crew-wrapper\">\n\t\t<div class=\"cast-crew-title\">\n\t\t\t Actors \t\t</div>\n\t\t<div class=\"cast-crew-names\">\n\t\t\t\t\t\t<span class=\"cast-crew-names\" itemprop=\"actors\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Bhasker Patel</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t\t<span class=\"cast-crew-names\" itemprop=\"actors\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Tina Sharma</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t\t<span class=\"cast-crew-names\" itemprop=\"actors\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Amar Chaggar</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t\t<span class=\"cast-crew-names\" itemprop=\"actors\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Jayant Singh</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t</div>\n\t</div>\n\t\t<!-- Producers -->\n\t\t<div class=\"cast-crew-wrapper\">\n\t\t<div class=\"cast-crew-title\">\n\t\t\t Producers \t\t</div>\n\t\t<div class=\"cast-crew-names\">\n\t\t\t\t\t\t<span class=\"cast-crew-names\" itemprop=\"producer\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Jazz Bhalla</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t\t<span class=\"cast-crew-names\" itemprop=\"prod