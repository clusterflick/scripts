tion -->\n    <div class=\"film-details-wrapper\" itemscope itemtype=\"http://schema.org/Movie\">\n        <link itemprop=\"url\" href=\"https://www.peckhamplex.london/film/wham-10-days-in-china\" />\n\n        <h1 class=\"page-title\" itemprop=\"name\">Wham! 10 Days in China</h1>\n        <!-- Film Details -->\n        <div class=\"inner-content-wrapper\">\n            <div class=\"details-wrapper\">\n                <div class=\"info-section\">\n                    <div class=\"poster-wrapper\">\n                        <div class=\"poster\">\n                                                        <img itemprop=\"image\" src=\"/imgs/posters/large/wham-10-days-in-china.jpg\" alt=\"Wham! 10 Days in China\" title=\"Wham! 10 Days in China\" />\n                        </div>\n                    </div>\n                    <div class=\"info\">\n                        <p><b>Format:</b> 2D Digital\n                                                    </p>\n                        <p><b>Genre:</b> Documentary</p>\n                        <p><b>Running Time:</b> 1 hour 30 minutes</p>\n                        <p><b>Rate:</b> 12A<br /></p>\n                        <br />\n                        <p><i class=\"fa fa-info-circle\"></i> Free List Suspended</p>                        <p><i class=\"fa fa-wheelchair\"></i> Wheelchair/Disabled Access</p>                                                <p class=\"more-info\">For more cinema access information <br class=\"show-on-ip\"><a href=\"https://www.peckhamplex.london/cinema/access\">click here</a>.\n                        <meta itemprop=\"dateCreated\" content=\"01-01-1970\">\n                    </div>\n\n                </div><!-- end of poster -->\n                <div class=\"content\">\n                    <!-- synopsis -->\n                                        <div class=\"synopsis\">\n                        <h3>Wham! 10 Days in China Synopsis</h3>\n                        <p itemprop=\"description\">George Michael and Andrew Ridgeley's concerts in Beijing and Guangzhou introduced live Western pop to Chinese audiences and marked a turning point for the band. For WHAM!, the tour was more than music; it was a bold move to capture American attention and launch them into global superstardom. Now, newly remastered, this film shows China on the cusp of change, told through the band's journey and the voices of fans experiencing pop culture for the first time. This is the untold story of WHAM! at a singular moment in history, East meets West, pop meets politics, and two young stars coming of age on the world stage.</p>\n                                                                    </div><!-- end of synopsis -->\n                                        <a name=\"watchwithbaby\" id=\"watchwithbaby\"></a>\n\n                    \n                    <!-- Book Tickets -->\n                                        <div class=\"book-tickets\">\n        <h3>Book Tickets</h3>\n    <div class=\"book-tickets-listings\">\n\n                        <div class=\"date-wrapper\">\n            <p class=\"ticket-date\">Tuesday 28th July 2026</p>\n            <div class=\"btn-group\" role=\"group\">\n                                                <a class=\"btn btn-info\" onclick=\"gtag('event', 'click', {'event_category' :'book tickets', 'event_label': 'Wham! 10 Days in China : Tuesday 28th July 2026 at 20:30'})\" href=\"https://ticketing.eu.veezi.com/purchase/81221?siteToken=zkD3Bh7H%2fkuZI9VTgCj%2bgg%3d%3d\" target=\"_blank\"><time datetime=\"2026-07-28T20:30\">20:30</time></a>\n                                            </div>\n        </div>\n        \n        \n        \n    </div>\n    <br />\n</div><!-- end of book-tickets -->                                                            <!-- Book Tickets -->\n\n                    <!-- Cast Crew -->\n                                        <!-- end of Cast Crew -->\n\n                    <br />\n                    <!-- Social Sharing --