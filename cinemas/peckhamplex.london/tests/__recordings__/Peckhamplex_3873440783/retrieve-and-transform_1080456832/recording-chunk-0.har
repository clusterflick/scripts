</div>\n            <!-- end of Ad: MPU -->\n    </div>\n    <!-- end of Side Details -->\n</div>\n<!-- end of HP: Top -->\n    <!-- end of Top Section -->\n    <div class=\"film-details-wrapper\" itemscope itemtype=\"http://schema.org/Movie\">\n        <link itemprop=\"url\" href=\"https://www.peckhamplex.london/film/the-sheep-detectives\" />\n\n        <h1 class=\"page-title\" itemprop=\"name\">The Sheep Detectives</h1>\n        <!-- Film Details -->\n        <div class=\"inner-content-wrapper\">\n            <div class=\"details-wrapper\">\n                <div class=\"info-section\">\n                    <div class=\"poster-wrapper\">\n                        <div class=\"poster\">\n                                                        <img itemprop=\"image\" src=\"/imgs/posters/large/the-sheep-detectives.jpg\" alt=\"The Sheep Detectives\" title=\"The Sheep Detectives\" />\n                        </div>\n                    </div>\n                    <div class=\"info\">\n                        <p><b>Format:</b> 2D Digital\n                                                    </p>\n                        <p><b>Genre:</b> Action</p>\n                        <p><b>Running Time:</b> 1 hour 50 minutes</p>\n                        <p><b>Rate:</b> PG<br />mild violence, threat, brief language</p>\n                        <br />\n                        <p><i class=\"fa fa-info-circle\"></i> Free List Suspended</p>                        <p><i class=\"fa fa-wheelchair\"></i> Wheelchair/Disabled Access</p>                                                <p class=\"more-info\">For more cinema access information <br class=\"show-on-ip\"><a href=\"https://www.peckhamplex.london/cinema/access\">click here</a>.\n                        <meta itemprop=\"dateCreated\" content=\"01-01-1970\">\n                    </div>\n\n                </div><!-- end of poster -->\n                <div class=\"content\">\n                    <!-- synopsis -->\n                                        <div class=\"synopsis\">\n                        <h3>The Sheep Detectives Synopsis</h3>\n                        <p itemprop=\"description\">In this witty, new breed of mystery, George (Hugh Jackman) is a shepherd who reads detective novels to his beloved sheep every night, assuming they can’t possibly understand. But when a mysterious incident disrupts life on the farm, the sheep realise they must become the detectives. As they follow the clues and investigate human suspects, they prove that even sheep can be brilliant crime-solvers.</p>\n                                                                    </div><!-- end of synopsis -->\n                                        <a name=\"watchwithbaby\" id=\"watchwithbaby\"></a>\n\n                    \n                    <!-- Book Tickets -->\n                                        <p>There are currently no dates/times available for this film.</p>\n                                                            <!-- Book Tickets -->\n\n                    <!-- Cast Crew -->\n                                        <div class=\"cast-crew\">\n\t<h3>Cast &amp; Crew</h3>\n\t<!-- Directors -->\n\t\t<div class=\"cast-crew-wrapper\">\n\t\t<div class=\"cast-crew-title\">\n\t\t\t Director \t\t</div>\n\t\t<div class=\"cast-crew-names\">\n\t\t\t\t\t\t<span class=\"cast-crew-names\" itemprop=\"director\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Kyle Balda</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t</div>\n\t</div>\n\t\t<!-- Actors -->\n\t\t<div class=\"cast-crew-wrapper\">\n\t\t<div class=\"cast-crew-title\">\n\t\t\t Actors \t\t</div>\n\t\t<div class=\"cast-crew-names\">\n\t\t\t\t\t\t<span class=\"cast-crew-names\" itemprop=\"actors\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Bryan Cranston</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t\t<span class=\"cast-crew-names\" itemprop=\"actors\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\