</div>\n    <div class=\"title-treatment\">\n        <a href=\"https://www.peckhamplex.london\"><img src=\"https://www.peckhamplex.london/imgs/generic/peckhamplex-title-treatment.png\" alt=\"Peckhamplex London logo\" title=\"Peckhamplex, London\" /></a>\n        <a href=\"https://www.timeout.com/london/news/our-favourite-venues-in-london-right-now-time-outs-2024-recommended-stickers-have-hit-the-streets-121724\" target=\"_blank\"><img src=\"/imgs/generic/timeout-award-2024.jpg\" alt=\"Time Out The Best of The City 2024 Award\" title=\"We are very proud to receive the Time Out Award for The Best of The City 2024\" class=\"header-award\" /></a>\n        <!--<a href=\"https://www.peckhamplex.london\"><img src=\"https://www.peckhamplex.london/imgs/generic/peckhamplex-title-treatment.png\" alt=\"Peckhamplex London logo\" title=\"Peckhamplex, London\" /></a>\n        <a href=\"https://www.timeout.com/london/cinemas/peckhamplex\" target=\"_blank\"><img src=\"/imgs/generic/uk-london-badge-black-2018.png\" alt=\"Time Out Love London Award 2018 badge\" alt=\"Peckhamplex is proud to receive a Time Out Love London Award 2018\" class=\"header-award\" /></a>\n        <a href=\"https://www.timeout.com/london/news/our-favourite-venues-in-london-right-now-time-outs-2024-recommended-stickers-have-hit-the-streets-121724\" target=\"_blank\"><img src=\"/imgs/generic/timeout-2024.png\" alt=\"Time Out London Award 2024 badge\" alt=\"Peckhamplex is proud to receive a Time Out The Best of The City 2024 Award\" class=\"header-award\" /></a>-->\n    </div>\n    <!-- New Ticket Price Info. Added 21-07-2017 -->\n    <div class=\"ticket-info-wrapper\">\n        <p style=\"font-size: 20px;\">ALL TICKETS <span style=\"color: #bf4495;\">&pound;6.99</span> PLUS A 60P PER TICKET BOOKING FEE<br />(Total ticket price £7.59)</p>\n        <p style=\"font-size: 14px;\">(Additional &pound;1 supplement for 3D features)</p>\n    </div>\n    <!-- New Ticket Price Info. Added 21-07-2017 -->\n    <!-- dont load if on browser udpate page -->\n        <!-- Ad: Leaderboard -->\n    <div id=\"header-a-d\" class=\"leaderboard\">\n        <div class=\"a-d-wrapper\" style=\"max-height: 250px\">\n<div id='div-gpt-ad-1734906484118-0' style='min-width: 300px; min-height: 50px;'>\n  <script>\n    googletag.cmd.push(function() { googletag.display('div-gpt-ad-1734906484118-0'); });\n  </script>\n</div>\n\n</div>    </div>\n    <!-- end of Ad: Leaderboard -->\n    <!-- Navigation -->\n    <div class=\"nav-wrapper\">\n    <button class=\"close-btn\"><svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\" /></svg></button>\n    <nav role=\"main-navigation\">\n        <ul>\n            <li class=\"\"><a href=\"https://www.peckhamplex.london\">Home</a></li>\n            <li class=\"\"><a href=\"https://www.peckhamplex.london/films/out-now\">Films Out Now</a></li>\n            <li class=\"\"><a href=\"https://www.peckhamplex.london/films/coming-soon\">Films Coming Soon</a></li>\n            <li class=\"mobile-show \"><a href=\"https://www.peckhamplex.london/films/watch-with-baby\">Watch With Baby</a></li>\n            <li class=\"mobile-show \"><a href=\"https://www.peckhamplex.london/films/hard-of-hearing\">Subtitled for the Hard of Hearing</a></li>\n            <li class=\"mobile-show \"><a href=\"https://www.peckhamplex.london/films/autism-friendly\">Autism Friendly Films</a></li>\n\t\t\t<li class=\"\"><a href=\"https://www.peckhamplex.london/about-us\">About Us</a></li>\n            <li class=\"\"><a href=\"https://www.peckhamplex.london/cinema/information\">Cinema Info</a></li>\n            <li class=\"\"><a href=\"https://www.peckhamplex.london/scholarships\">Scholarships</a></li>\n            <li class=\"\"><a href=\"https://www.peckhamplex.london/news-and-events\">News &amp; Events</a></li>\n        </ul>\n    </nav>\n</div>\n    <!-- end of Navigation -->\n    \n        <a href=\"/the-final-film-festival\">\n        <div style=\"width:100%;height:40px;display:flex;justify-content:center;align-items:center;text-center;background-color:#bf4495;padding:4px;color:white;font-size:18px;font-weight:bold;margin-bottom:16px;\">\n            THE FINAL FILM FESTIVAL\n        </div>\n    </a>\n    \n</header>\n        \n        <!-- ads wrapper -->\n        <div class=\"outer-wrapper\">\n            <!-- left skyscroaer ad -->\n                <div  id=\"skyscraper\" class=\"skyscraper-left\">\n    <div class=\"a-d-wrapper\">\n<div id='div-gpt-ad-1680277312471-0' style='min-width: 120px; min-height: 600px;'>\n  <script>\n    googletag.cmd.push(function() { googletag.display('div-gpt-ad-1680277312471-0'); });\n  </script>\n</div>\n    </div>\n</div>\n            <!-- content wrapper -->\n            <div class=\"content-wrapper\">\n                <!-- Main Content -->\n                <main class=\"main-content\">\n                    <div class=\"inner-content\" id=\"film-details-page\">\n    <!-- Top Section -->\n    <!-- HP: Top -->\n<div class=\"top-block-wrapper clearfix\">\n    <!-- Carousel -->\n    <div class=\"carousel-block\">\n        <div class=\"choose-film-wrapper\">\n   <div class=\"choose-film-box\" id=\"choose-film-options\" data-site-token=\"zkD3Bh7H%2fkuZI9VTgCj%2bgg%3d%3d\">\n      <div class=\"film-by-title\">\n          <button id=\"choose-by-title\" type=\"button\" class=\"btn btn-lg\"\n                  data-url=\"https://www.peckhamplex.london/api/v1/film/by/title\"\n                  data-option=\"by-title\">Choose Film<span><br /></span> by Title</button>\n      </div>\n      <div class=\"film-by-date\">\n          <button id=\"choose-by-date\" type=\"button\" class=\"btn btn-lg\"\n                  data-url=\"https://www.peckhamplex.london/api/v1/film/by/dates\"\n                  data-option=\"by-date\">Choose Film<span><br /></span> by Date</button>\n      </div>\n      <div class=\"film-by-date\">\n          <button type=\"button\" class=\"btn btn-lg\" onclick=\"location.href='https://www.peckhamplex.london/films/listings'\">Weekly Film<span><br /></span> Listings</button>\n      </div>\n  </div>\n</div>\n        <div class=\"carousel-player-wrapper\">\n            <!--Cookie Notice-->\n            <div class=\"cookie-inf\" style=\"position:absolute;z-index:9999;width:100%;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:flex-end;user-select:none;\">\n                <div style=\"box-sizing:border-box;width:100%;padding:30px;background-color:#bf4495;text-align:center\">\n                    Please accept targeting cookies to watch this video content.<br />\n                    <a href=\"javascript:CookieScript.instance.show()\">Click here to change your cookie preferences</a>.\n                </div>\n            </div>\n            <!--Cookie Notice-->\n                <!-- Carousel Player Wrapper -->\n<div class=\"carousel-player-wrapper\">\n    <!-- Royalslider Wrapper -->\n    <div id=\"site-carousel\" class=\"royalSlider rsMinW\">\n                    <!-- Image -->\n            <div class=\"rsContent\" itemscope itemtype=\"http://schema.org/ImageObject\">\n                <img class=\"rsImg\" src=\"/imgs/posters/trailers/tfff-city-wide-fever.jpg\" alt=\"TFFF: City Wide Fever\">\n                <meta itemprop=\"name\" content=\"TFFF: City Wide Fever\">\n                <link itemprop=\"image\" href=\"/imgs/posters/trailers/tfff-city-wide-fever.jpg\" />\n                    <meta itemprop=\"description\" content=\"The Final Film Festival 7-9 Aug 26\r\nSee events page for information\r\n\r\nCity Wide Fever (2025)\r\n\r\nSam, a young film student, discovers a hard drive detailing the life and career of forgotten Giallo Italian horror director Saturnino Barresi. As she begins to investigate his mysterious disappearance, Sam finds herself pulled into a violent conspiracy eerily similar to those of the films she adores.\r\n\r\nWhen Sam finds a USB dossier on the mysterious Italian auteur Saturnino Barresi, she sets out on a hunt across New York City for his unfinished final masterpiece 'City Wide Fever' and the secret behind his disappearance. But the line between reality and the violent films she loves starts to blur - a maniac is on the loose and anyone who tries to unpick the conspiracy soon winds up dead. City Wide Fever is a gleeful homage to the Giallo genre that revels in all the sordid trappings of its source material with a knowing wink to its audience.\r\n\r\nDirector Josh Heaps' debut feature, executive produced by Guy Maddin, is full of self-aware cinephilic nostalgia and lovingly employs the garish Giallo aesthetics that you might expect - but its iPhone-era sensibility (this black-gloved killer dons a hot-pink ski-mask) and scuzzy shot-on-video DIY approach elevates it from pastiche to anachronistic gem, dragging the genre into the modern day without any apology for the sex, violence, and sleaze that comes with it.\r\n\r\nThis screening will be followed by a video Q&A with director Josh Heaps and actress Diletta Guglielmi.\r\n\r\n- Jack Higgins\">\n               \n            </div><!-- end of image -->\n        \n     </div>\n    <!-- End of Royalslider Wrapper -->\n</div>\n<!-- End of Carousel Player Wrapper -->\n<a name=\"booktickets\" id=\"booktickets\"></a>        </div>\n    </div>\n    <!-- end of Carousel -->\n    <!-- Side Details -->\n    <div class=\"side-details\">\n        <!-- company-details -->\n        <div class=\"company-details\">\n            <div class=\"cp-address\">\n    <small>Peckhamplex 95a Rye Lane, London, SE15 4ST</small><br />\n    <a class=\"phone\" href=\"tel:0844 567 2742\">0844 567 2742<sup>*</sup></a><br />\n    <a class=\"email\" href=\"mailTo:managers@peckhamplex.net\">managers@peckhamplex.net</a>\n</div>\n<!-- -->\n<div class=\"cp-statement\">\n\n    <p>Your friendly independent, licensed, multiplex cinema in South London and home to the £6.99 cinema ticket.</p>\n\n</div>\n<!-- -->\n<div class=\"social-strip-wrapper\">\n    <div class=\"social-outer-wrapper\">\n    <p>Follow Us on</p>\n    <div class=\"social-wrapper\">\n        <a href=\"https://www.facebook.com/PeckhamPlex\" class=\"facebook\" target=\"_blank\" rel=\"noopener\" class=\"m-0 p-0 text-gray-400 hover:text-accent focus:text-accent\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 12 21\"><title>Following us on Facebook</title><path d=\"M18,2H15a5,5,0,0,0-5,5v3H7v4h3v8h4V14h3l1-4H14V7a1,1,0,0,1,1-1h3Z\" transform=\"translate(-6.5 -1.5)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/></svg>\n        </a>\n        <a href=\"https://www.twitter.com/PeckhamPlex\" class=\"twitter\" target=\"_blank\" rel=\"noopener\" class=\"m-0 p-0 text-gray-400 hover:text-accent focus:text-accent\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 25.521 21.207\"><title>Following us on Twitter</title><path d=\"M25.521,3a12.149,12.149,0,0,1-3.5,1.705A4.993,4.993,0,0,0,13.26,8.05V9.165A11.881,11.881,0,0,1,3.229,4.116S-1.229,14.147,8.8,18.605A12.974,12.974,0,0,1,1,20.835c10.031,5.573,22.292,0,22.292-12.818a5.016,5.016,0,0,0-.089-.925A8.6,8.6,0,0,0,25.521,3Z\" transform=\"translate(-0.5 -2.412)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/></svg>\n        \n        </a>\n        <a href=\"https://www.instagram.com/peckhamplexcinema/\" class=\"instagram\" target=\"_blank\" rel=\"noopener\" class=\"m-0 p-0 text-gray-400 hover:text-accent focus:text-accent\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 21 21\"><title>Following us on Instagram</title><g transform=\"translate(-1.5 -1.5)\"><rect width=\"20\" height=\"20\" rx=\"5\" transform=\"translate(2 2)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/><path d=\"M16,11.37A4,4,0,1,1,12.63,8,4,4,0,0,1,16,11.37Z\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/><line x2=\"0.01\" transform=\"translate(17.5 6.5)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/></g></svg>\n        </a>\n    </div>\n</div></div>        </div>\n        <!-- end of company-details-->\n        <!-- Ad: MPU -->\n        <div id=\"mpu-a-d\" class=\"mpu\">\n            <div class=\"a-d-wrapper\">\n<div id='div-gpt-ad-1734906484118-0' style='min-width: 300px; min-height: 50px;'>\n  <script>\n    googletag.cmd.push(function() { googletag.display('div-gpt-ad-1734906484118-0'); });\n  </script>\n</div>\n</div>\n        </div>\n            <!-- end of Ad: MPU -->\n    </div>\n    <!-- end of Side Details -->\n</div>\n<!-- end of HP: Top -->\n    <!-- end of Top Section -->\n    <div class=\"film-details-wrapper\" itemscope itemtype=\"http://schema.org/Movie\">\n        <link itemprop=\"url\" href=\"https://www.peckhamplex.london/film/tfff-city-wide-fever\" />\n\n        <h1 class=\"page-title\" itemprop=\"name\">TFFF: City Wide Fever</h1>\n        <!-- Film Details -->\n        <div class=\"inner-content-wrapper\">\n            <div class=\"details-wrapper\">\n                <div class=\"info-section\">\n                    <div class=\"poster-wrapper\">\n                        <div class=\"poster\">\n                                                        <img itemprop=\"image\" src=\"/imgs/posters/large/tfff-city-wide-fever.jpg\" alt=\"TFFF: City Wide Fever\" title=\"TFFF: City Wide Fever\" />\n                        </div>\n                    </div>\n                    <div class=\"info\">\n                        <p><b>Format:</b> 2D Digital\n                                                    </p>\n                        <p><b>Genre:</b> Horror</p>\n                        <p><b>Running Time:</b> 1 hour 13 minutes</p>\n                        <p><b>Rate:</b> 18<br /></p>\n                        <br />\n                        <p><i class=\"fa fa-info-circle\"></i> Free List Suspended</p>                        <p><i class=\"fa fa-wheelchair\"></i> Wheelchair/Disabled Access</p>                                                <p class=\"more-info\">For more cinema access information <br class=\"show-on-ip\"><a href=\"https://www.peckhamplex.london/cinema/access\">click here</a>.\n                        <meta itemprop=\"dateCreated\" content=\"01-01-1970\">\n                    </div>\n\n                </div><!-- end of poster -->\n                <div class=\"content\">\n                    <!-- synopsis -->\n                                        <div class=\"synopsis\">\n                        <h3>TFFF: City Wide Fever Synopsis</h3>\n                        <p itemprop=\"description\">The Final Film Festival 7-9 Aug 26<br />\r\nSee events page for information<br />\r\n<br />\r\nCity Wide Fever (2025)<br />\r\n<br />\r\nSam, a young film student, discovers a hard drive detailing the life and career of forgotten Giallo Italian horror director Saturnino Barresi. As she begins to investigate his mysterious disappearance, Sam finds herself pulled into a violent conspiracy eerily similar to those of the films she adores.<br />\r\n<br />\r\nWhen Sam finds a USB dossier on the mysterious Italian auteur Saturnino Barresi, she sets out on a hunt across New York City for his unfinished final masterpiece 'City Wide Fever' and the secret behind his disappearance. But the line between reality and the violent films she loves starts to blur - a maniac is on the loose and anyone who tries to unpick the conspiracy soon winds up dead. City Wide Fever is a gleeful homage to the Giallo genre that revels in all the sordid trappings of its source material with a knowing wink to its audience.<br />\r\n<br />\r\nDirector Josh Heaps' debut feature, executive produced by Guy Maddin, is full of self-aware cinephilic nostalgia and lovingly employs the garish Giallo aesthetics that you might expect - but its iPhone-era sensibility (this black-gloved killer dons a hot-pink ski-mask) and scuzzy shot-on-video DIY approach elevates it from pastiche to anachronistic gem, dragging the genre into the modern day without any apology for the sex, violence, and sleaze that comes with it.<br />\r\n<br />\r\nThis screening will be followed by a video Q&A with director Josh Heaps and actress Diletta Guglielmi.<br />\r\n<br />\r\n- Jack Higgins</p>\n                                                                    </div><!-- end of synopsis -->\n                                        <a name=\"watchwithbaby\" id=\"watchwithbaby\"></a>\n\n                    \n                    <!-- Book Tickets -->\n                                        <div class=\"book-tickets\">\n        <h3>Book Tickets</h3>\n    <div class=\"book-tickets-listings\">\n\n                        <div class=\"date-wrapper\">\n            <p class=\"ticket-date\">Friday 7th August 2026</p>\n            <div class=\"btn-group\" role=\"group\">\n                                                <a class=\"btn btn-info\" onclick=\"gtag('event', 'click', {'event_category' :'book tickets', 'event_label': 'TFFF: City Wide Fever : Friday 7th August 2026 at 20:00'})\" href=\"https://ticketing.eu.veezi.com/purchase/81478?siteToken=zkD3Bh7H%2fkuZI9VTgCj%2bgg%3d%3d\" target=\"_blank\"><time datetime=\"2026-08-07T20:00\">20:00</time></a>\n                                            </div>\n        </div>\n        \n        \n        \n    </div>\n    <br />\n</div><!-- end of book-tickets -->                                                            <!-- Book Tickets -->\n\n                    <!-- Cast Crew -->\n                                        <!-- end of Cast Crew -->\n\n                    <br />\n                    <!-- Social Sharing -->\n<div class=\"social-share-wrapper\">\n        <!-- Facebook -->\n        <div class=\"fb-share-button\" data-href=\"https://www.peckhamplex.london/film/tfff-city-wide-fever\" data-layout=\"button\"></div>\n        <!-- Twitter -->\n        <a href=\"https://twitter.com/share\" \n            class=\"twitter-share-button\" \n            data-url=\"https://www.peckhamplex.london/film/tfff-city-wide-fever\" \n            data-text=\"TFFF: City Wide Fever\" \n            data-hashtags=\"peckhamplex,movies,cinema\">Tweet</a>\n        <!-- Google -->\n        <div class=\"g-plus\" data-action=\"share\" data-annotation=\"none\" data-height=\"20\"></div>\n</div>\n<!-- end of Social Sharing -->\n\n\n                </div><!-- end of content -->\n\n            </div><!-- end of details-wrapper -->\n        </div><!-- end of inner-content-wrapper -->\n\n    </div><!-- end of film-details-wrapper -->\n\n</div><!-- end of inner-content -->\n                </main>\n                <!-- End of Main Content -->\n            </div>\n             <!-- end of content wrapper-->\n            <!-- right skyscroaer ad -->\n           <div  id=\"skyscraper\" class=\"skyscraper-right\">\n   <div class=\"a-d-wrapper\">\n<div id='div-gpt-ad-1680277686448-0' style='min-width: 120px; min-height: 600px;'>\n  <script>\n    googletag.cmd.push(function() { googletag.display('div-gpt-ad-1680277686448-0'); });\n  </script>\n</div>\n   </div>\n</div>\n        </div>\n        <!-- end of ads wrapper -->\n                         <!-- SU: form -->\n        <div class=\"membership-wrapper\">\n        <div class=\"membership-txt\">Subscribe to the Peckhamplex newsletter to receive our latest film news, events & releases.</div>\n        <div class=\"membership-btn\"><a href=\"/newsletter/subscribe\">Subscribe</a></div>\n</div>\n         <!-- end of SU: form -->\n                  <!-- Footer -->\n        <footer>\n  <div class=\"footer-wrapper\">\n    <!-- left-content -->\n    <div class=\"left-content-wrapper\">\n      <!-- Side Nav -->\n      <nav role=\"quick-links\">\n                <ul>\n          <li class=\"\"><a href=\"https://www.peckhamplex.london\">Home</a></li>\n          <li class=\"\"><a href=\"https://www.peckhamplex.london/films/out-now\">Films Out Now</a></li>\n          <li class=\"\"><a href=\"https://www.peckhamplex.london/films/coming-soon\">Films Coming Soon</a></li>\n\t\t  <li class=\"\"><a href=\"https://www.peckhamplex.london/about-us\">About Us</a></li>\n          <li class=\"\"><a href=\"https://www.peckhamplex.london/cinema/information\">Cinema Info</a></li>\n          <li class=\"\"><a href=\"https://www.peckhamplex.london/scholarships\">Peckhamplex Scholarships</a></li>\n          <li class=\"\"><a href=\"https://www.peckhamplex.london/news-and-events\">News &amp; Events</a></li>\n        </ul>\n                <div class=\"address\">\n          Peckhamplex <br class=\"hide\" />\n          95a Rye Lane, Peckham <br class=\"hide\" />\n          London SE15 4ST <br class=\"hide\" />\n          <a href=\"mailTo:managers@peckhamplex.net\">managers@peckhamplex.net</a> <br class=\"hided\" />\n          <a href=\"tel:0844 567 2742\">0844 567 2742*</a>\n          <p class=\"call-cost\">*Calls cost 7p per minute, plus your phone company's access charge.</p>\n        </div>\n      </nav>\n      <!--end of  Side Nav -->\n    </div>\n    <!-- end of left-content -->\n    <!-- right-content -->\n    <div class=\"right-content-wrapper\">\n      <!-- dont load if on browser udpate page -->\n            <div id=\"footer-a-d\" class=\"leaderboard\">\n        <div class=\"a-d-wrapper\" style=\"max-height: 250px\">\n<div id='div-gpt-ad-1680276848743-0' style='min-width: 320px; min-height: 50px;'>\n  <script>\n    googletag.cmd.push(function() { googletag.display('div-gpt-ad-1680276848743-0'); });\n  </script>\n</div>\n  \n</div>      </div>\n\n      <div class=\"legal\">\n        <p><br />\n          <a class=\"\" href=\"https://www.peckhamplex.london/terms-and-conditions\">Terms &amp; Conditions</a> /\n          <a class=\"\" href=\"https://www.peckhamplex.london/privacy-and-cookies-policy\">Privacy &amp; Cookies Policy</a> /\n          <a class=\"\" href=\"https://www.peckhamplex.london/data-subject-response-procedures\">Data Subject Response Procedures</a><br /><br />\n          &copy;2026 Peckhamplex Ltd / <a class=\"\" href=\"https://www.peckhamplex.london/site-map\">Sitemap</a> /\n          <a href=\"https://2smallfeet.com\" target=\"_blank\">Site By 2smallfeet</a> </p>\n        <div class=\"social-strip-wrapper\">\n          <div class=\"social-outer-wrapper\">\n    <p>Follow Us on</p>\n    <div class=\"social-wrapper\">\n        <a href=\"https://www.facebook.com/PeckhamPlex\" class=\"facebook\" target=\"_blank\" rel=\"noopener\" class=\"m-0 p-0 text-gray-400 hover:text-accent focus:text-accent\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 12 21\"><title>Following us on Facebook</title><path d=\"M18,2H15a5,5,0,0,0-5,5v3H7v4h3v8h4V14h3l1-4H14V7a1,1,0,0,1,1-1h3Z\" transform=\"translate(-6.5 -1.5)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/></svg>\n        </a>\n        <a href=\"https://www.twitter.com/PeckhamPlex\" class=\"twitter\" target=\"_blank\" rel=\"noopener\" class=\"m-0 p-0 text-gray-400 hover:text-accent focus:text-accent\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 25.521 21.207\"><title>Following us on Twitter</title><path d=\"M25.521,3a12.149,12.149,0,0,1-3.5,1.705A4.993,4.993,0,0,0,13.26,8.05V9.165A11.881,11.881,0,0,1,3.229,4.116S-1.229,14.147,8.8,18.605A12.974,12.974,0,0,1,1,20.835c10.031,5.573,22.292,0,22.292-12.818a5.016,5.016,0,0,0-.089-.925A8.6,8.6,0,0,0,25.521,3Z\" transform=\"translate(-0.5 -2.412)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/></svg>\n        \n        </a>\n        <a href=\"https://www.instagram.com/peckhamplexcinema/\" class=\"instagram\" target=\"_blank\" rel=\"noopener\" class=\"m-0 p-0 text-gray-400 hover:text-accent focus:text-accent\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 21 21\"><title>Following us on Instagram</title><g transform=\"translate(-1.5 -1.5)\"><rect width=\"20\" height=\"20\" rx=\"5\" transform=\"translate(2 2)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/><path d=\"M16,11.37A4,4,0,1,1,12.63,8,4,4,0,0,1,16,11.37Z\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/><line x2=\"0.01\" transform=\"translate(17.5 6.5)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/></g></svg>\n        </a>\n    </div>\n</div>        </div>\n      </div>\n          </div>\n    <!-- end of right-content -->\n  </div>\n</footer>\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n        //Cookie Script\n        var csCtas = document.querySelectorAll('.cookie-inf');\n        //Remove Cookie Guard if there is no video\n        let checkElem = setInterval(() => {\n          if(document.querySelector('.rsContent')) {\n            let elemChildren = document.querySelector('.rsContent').children.length\n            console.log(elemChildren)\n            if( elemChildren === 4 ) {\n              doRemoveCsCtas()\n              clearInterval(checkElem)\n            }\n            else {\n              clearInterval(checkElem)\n            }\n          }\n          else {\n            clearInterval(checkElem)\n          }\n        }, 500);\n\n        function doRemoveCsCtas() {\n          csCtas.forEach((csCta) => {\n            csCta.style.display = 'none';\n          });\n        }\n\n        function doCheckCsCats(cats) {\n          if(cats.includes('targeting')) {\n            doRemoveCsCtas();\n          }\n        }\n\n        window.addEventListener('CookieScript