etails-wrapper\">\n                <div class=\"info-section\">\n                    <div class=\"poster-wrapper\">\n                        <div class=\"poster\">\n                                                        <img itemprop=\"image\" src=\"/imgs/posters/large/tfff-surprise-film-7826.jpg\" alt=\"TFFF: Surprise Film 7.8.26\" title=\"TFFF: Surprise Film 7.8.26\" />\n                        </div>\n                    </div>\n                    <div class=\"info\">\n                        <p><b>Format:</b> 2D Digital\n                                                    </p>\n                        <p><b>Genre:</b> Mystery</p>\n                        <p><b>Running Time:</b> 1 hour 30 minutes</p>\n                        <p><b>Rate:</b> <br /></p>\n                        <br />\n                        <p><i class=\"fa fa-info-circle\"></i> Free List Suspended</p>                        <p><i class=\"fa fa-wheelchair\"></i> Wheelchair/Disabled Access</p>                                                <p class=\"more-info\">For more cinema access information <br class=\"show-on-ip\"><a href=\"https://www.peckhamplex.london/cinema/access\">click here</a>.\n                        <meta itemprop=\"dateCreated\" content=\"01-01-1970\">\n                    </div>\n\n                </div><!-- end of poster -->\n                <div class=\"content\">\n                    <!-- synopsis -->\n                                        <div class=\"synopsis\">\n                        <h3>TFFF: Surprise Film 7.8.26 Synopsis</h3>\n                        <p itemprop=\"description\">The Final Film Festival 7-9 Aug 26<br />\r\n<br />\r\n<br />\r\n7 Aug 26<br />\r\n<br />\r\nThe Final Film Festival presents a special repertory Surprise Screening in partnership with South London's Peckhamplex.</p>\n                                                                    </div><!-- end of synopsis -->\n                                        <a name=\"watchwithbaby\" id=\"watch