        <link itemprop=\"url\" href=\"https://www.peckhamplex.london/film/the-odyssey\" />\n\n        <h1 class=\"page-title\" itemprop=\"name\">The Odyssey</h1>\n        <!-- Film Details -->\n        <div class=\"inner-content-wrapper\">\n            <div class=\"details-wrapper\">\n                <div class=\"info-section\">\n                    <div class=\"poster-wrapper\">\n                        <div class=\"poster\">\n                                                        <img itemprop=\"image\" src=\"/imgs/posters/large/the-odyssey.jpg\" alt=\"The Odyssey\" title=\"The Odyssey\" />\n                        </div>\n                    </div>\n                    <div class=\"info\">\n                        <p><b>Format:</b> 2D Digital\n                                                    </p>\n                        <p><b>Genre:</b> Drama</p>\n                        <p><b>Running Time:</b> 2 hours 52 minutes</p>\n                        <p><b>Rate:</b> 15<br />strong violence</p>\n                        <br />\n                        <p><i class=\"fa fa-info-circle\"></i> Free List Suspended</p>                        <p><i class=\"fa fa-wheelchair\"></i> Wheelchair/Disabled Access</p>                                                <p class=\"more-info\">For more cinema access information <br class=\"show-on-ip\"><a href=\"https://www.peckhamplex.london/cinema/access\">click here</a>.\n                        <meta itemprop=\"dateCreated\" content=\"01-01-1970\">\n                    </div>\n\n                </div><!-- end of poster -->\n                <div class=\"content\">\n                    <!-- synopsis -->\n                                        <div class=\"synopsis\">\n                        <h3>The Odyssey Synopsis</h3>\n                        <p itemprop=\"description\">The Odyssey (2026), Christopher Nolan’s epic adaptation of Homer’s classic, follows Greek hero Odysseus on a perilous journey home after the Trojan War, encountering gods, monsters, and treacherous seas while his family faces turmoil in Ithaca<br />\r\n<br />\r\nPhoto Id may required for 15 certificate films</p>\n                                                                    </div><!-- end of synopsis -->\n                                        <a name=\"watchwithbaby\" id=\"watchwithbaby\"></a>\n\n                    \n                    <!-- Book Tickets -->\n                                        <p>There are currently no dates/times available for this film.</p>\n                                                            <!-- Book Tickets -->\n\n                    <!-- Cast Crew -->\n                                        <div class=\"cast-crew\">\n\t<h3>Cast &amp; Crew</h3>\n\t<!-- Directors -->\n\t\t<div class=\"cast-crew-wrapper\">\n\t\t<div class=\"cast-crew-title\">\n\t\t\t Director \t\t</div>\n\t\t<div class=\"cast-crew-names\">\n\t\t\t\t\t\t<span class=\"cast-crew-names\" itemprop=\"director\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Christopher Nolan</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t</div>\n\t</div>\n\t\t<!-- Actors -->\n\t\t<div class=\"cast-crew-wrapper\">\n\t\t<div class=\"cast-crew-title\">\n\t\t\t Actors \t\t</div>\n\t\t<div class=\"cast-crew-names\">\n\t\t\t\t\t\t<span class=\"cast-crew-names\" itemprop=\"actors\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Tom Holland</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t\t<span class=\"cast-crew-names\" itemprop=\"actors\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Lupita Nyong'o</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t\t<span class=\"cast-crew-names\" itemprop=\"actors\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Zendaya </span>\n\t\t\t</span>\n\t\t\t<br /> \t\t\t<span class=\"cast-crew-names\" itemprop=\"actors\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Matt Da