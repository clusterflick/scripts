on\" content=\"The Mandalorian and Grogu embark on their most thrilling mission yet. The evil Empire has fallen, and Imperial warlords remain scattered throughout the galaxy. As the fledgling New Republic works to protect everything the Rebellion fought for, they have enlisted the help of legendary Mandalorian bounty hunter Din Djarin (Pedro Pascal) and his young apprentice Grogu. .\r\n\r\n\r\n\r\n\r\n\r\n\"STAR WARS: THE MANDALORIAN AND GROGU contains several sequences with flashing lights that may affect those who are susceptible to photosensitive epilepsy or have other photosensitivities.\"\">\n                    \n                </div><!-- end o trailer -->\n        \n        \n     </div>\n    <!-- End of Royalslider Wrapper -->\n</div>\n<!-- End of Carousel Player Wrapper -->\n<a name=\"booktickets\" id=\"booktickets\"></a>        </div>\n    </div>\n    <!-- end of Carousel -->\n    <!-- Side Details -->\n    <div class=\"side-details\">\n        <!-- company-details -->\n        <div class=\"company-details\">\n            <div class=\"cp-address\">\n    <small>Peckhamplex 95a Rye Lane, London, SE15 4ST</small><br />\n    <a class=\"phone\" href=\"tel:0844 567 2742\">0844 567 2742<sup>*</sup></a><br />\n    <a class=\"email\" href=\"mailTo:managers@peckhamplex.net\">managers@peckhamplex.net</a>\n</div>\n<!-- -->\n<div class=\"cp-statement\">\n\n    <p>Your friendly independent, licensed, multiplex cinema in South London and home to the £6.99 cinema ticket.</p>\n\n</div>\n<!-- -->\n<div class=\"social-strip-wrapper\">\n    <div class=\"social-outer-wrapper\">\n    <p>Follow Us on</p>\n    <div class=\"social-wrapper\">\n        <a href=\"https://www.facebook.com/PeckhamPlex\" class=\"facebook\" target=\"_blank\" rel=\"noopener\" class=\"m-0 p-0 text-gray-400 hover:text-accent focus:text-accent\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 12 21\"><title>Following us on Facebook</title><path d=\"M18,2H15a5,5,0,0,0-5,5v3H7v4h3v8h4V14