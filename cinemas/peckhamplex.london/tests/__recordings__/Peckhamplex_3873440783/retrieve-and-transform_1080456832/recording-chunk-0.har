\"mpu-a-d\" class=\"mpu\">\n            <div class=\"a-d-wrapper\">\n<div id='div-gpt-ad-1734906484118-0' style='min-width: 300px; min-height: 50px;'>\n  <script>\n    googletag.cmd.push(function() { googletag.display('div-gpt-ad-1734906484118-0'); });\n  </script>\n</div>\n</div>\n        </div>\n            <!-- end of Ad: MPU -->\n    </div>\n    <!-- end of Side Details -->\n</div>\n<!-- end of HP: Top -->\n    <!-- end of Top Section -->\n    <div class=\"film-details-wrapper\" itemscope itemtype=\"http://schema.org/Movie\">\n        <link itemprop=\"url\" href=\"https://www.peckhamplex.london/film/the-magic-faraway-tree\" />\n\n        <h1 class=\"page-title\" itemprop=\"name\">The Magic Faraway Tree</h1>\n        <!-- Film Details -->\n        <div class=\"inner-content-wrapper\">\n            <div class=\"details-wrapper\">\n                <div class=\"info-section\">\n                    <div class=\"poster-wrapper\">\n                        <div class=\"poster\">\n                                                        <img itemprop=\"image\" src=\"/imgs/posters/large/the-magic-faraway-tree.jpg\" alt=\"The Magic Faraway Tree\" title=\"The Magic Faraway Tree\" />\n                        </div>\n                    </div>\n                    <div class=\"info\">\n                        <p><b>Format:</b> 2D Digital\n                                                    </p>\n                        <p><b>Genre:</b> Adventure</p>\n                        <p><b>Running Time:</b> 1 hour 50 minutes</p>\n                        <p><b>Rate:</b> U<br />very mild threat, rude humour, slapstick, language</p>\n                        <br />\n                        <p><i class=\"fa fa-info-circle\"></i> Free List Suspended</p>                        <p><i class=\"fa fa-wheelchair\"></i> Wheelchair/Disabled Access</p>                                                <p class=\"more-info\">For more cinema access information <br class=\"show-on-ip\"><a href=\"https://www.peckhamplex.london/cinema/access\">click here</a>.\n                        <meta itemprop=\"dateCreated\" content=\"01-01-1970\">\n                    </div>\n\n                </div><!-- end of poster -->\n                <div class=\"content\">\n                    <!-- synopsis -->\n                                        <div class=\"synopsis\">\n                        <h3>The Magic Faraway Tree Synopsis</h3>\n                        <p itemprop=\"description\">The Magic Faraway Tree follows Polly (Claire Foy), Tim (Andrew Garfield) and their three children - a modern family forced to relocate to the remote English countryside. As they adapt to their new lives, the children discover a magical tree and its extraordinary and eccentric residents including treasured characters Moonface (Nonso Anozie), Silky (Nicola Coughlan), Dame Washalot (Jessica Gunning) and Saucepan Man (Dustin Demri-Burns). At the top of the tree, they are transported to spectacular and fantastical lands and, through the joys and challenges of their adventures, the family learn to reconnect and value each other for the first time in years.</p>\n                                                                    </div><!-- end of synopsis -->\n                                        <a name=\"watchwithbaby\" id=\"watchwithbaby\"></a>\n\n                    \n                    <!-- Book Tickets -->\n                                        <div class=\"book-tickets\">\n        <h3>Book Tickets</h3>\n    <div class=\"book-tickets-listings\">\n\n                        <div class=\"date-wrapper\">\n            <p class=\"ticket-date\">Sunday 12th July 2026</p>\n            <div class=\"btn-group\" role=\"group\">\n                                                <a class=\"btn btn-info\" onclick=\"gtag('event', 'click', {'event_category' :'book tickets', 'event_label': 'The Magic Faraway Tree : Sunday 12th July 2026 at 13:15'})\" href=\"https://ticketing.eu.veezi.com/purchase/81534?siteToken=zkD3Bh7H%2fkuZI9VTgCj%2bgg%3d%3d\" target=\"_blank\"><time datetime=\"2026-07-12T13:15\">13:15</time></a>\n                                            </div>\n        </div>\n        \n        \n        \n    </div>\n    <br />\n</div><!-- end of book-tickets -->                                                            <!-- Book Tickets -->\n\n                    <!-- Cast Crew -->\n                                        <div class=\"cast-crew\">\n\t<h3>Cast &amp; Crew</h3>\n\t<!-- Directors -->\n\t\t<div class=\"cast-crew-wrapper\">\n\t\t<div class=\"cast-crew-title\">\n\t\t\t Director \t\t</div>\n\t\t<div class=\"cast-crew-names\">\n\t\t\t\t\t\t<span class=\"cast-crew-names\" itemprop=\"director\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Ben Gregor</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t</div>\n\t</div>\n\t\t<!-- Actors -->\n\t\t<div class=\"cast-crew-wrapper\">\n\t\t<div class=\"cast-crew-title\">\n\t\t\t Actors \t\t</div>\n\t\t<div class=\"cast-crew-names\">\n\t\t\t\t\t\t<span class=\"cast-crew-names\" itemprop=\"actors\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Andrew Garfield</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t\t<span class=\"cast-crew-names\" itemprop=\"actors\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Michael Palin</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t\t<span class=\"cast-crew-names\" itemprop=\"actors\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Jennifer Saunders</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t\t<span class=\"cast-crew-names\" itemprop=\"actors\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Rebecca Ferguson</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t\t<span class=\"cast-crew-names\" itemprop=\"actors\" itemscope itemtype=\"http://schema.org/Person\">\n\t\t\t\t<span itemprop=\"name\">Nicola Coughlan</span>\n\t\t\t</span>\n\t\t\t<br /> \t\t\t<span c