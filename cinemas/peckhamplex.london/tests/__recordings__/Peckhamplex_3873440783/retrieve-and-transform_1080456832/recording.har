ransform=\"translate(-6.5 -1.5)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/></svg>\n        </a>\n        <a href=\"https://www.twitter.com/PeckhamPlex\" class=\"twitter\" target=\"_blank\" rel=\"noopener\" class=\"m-0 p-0 text-gray-400 hover:text-accent focus:text-accent\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 25.521 21.207\"><title>Following us on Twitter</title><path d=\"M25.521,3a12.149,12.149,0,0,1-3.5,1.705A4.993,4.993,0,0,0,13.26,8.05V9.165A11.881,11.881,0,0,1,3.229,4.116S-1.229,14.147,8.8,18.605A12.974,12.974,0,0,1,1,20.835c10.031,5.573,22.292,0,22.292-12.818a5.016,5.016,0,0,0-.089-.925A8.6,8.6,0,0,0,25.521,3Z\" transform=\"translate(-0.5 -2.412)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/></svg>\n        \n        </a>\n        <a href=\"https://www.instagram.com/peckhamplexcinema/\" class=\"instagram\" target=\"_blank\" rel=\"noopener\" class=\"m-0 p-0 text-gray-400 hover:text-accent focus:text-accent\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 21 21\"><title>Following us on Instagram</title><g transform=\"translate(-1.5 -1.5)\"><rect width=\"20\" height=\"20\" rx=\"5\" transform=\"translate(2 2)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/><path d=\"M16,11.37A4,4,0,1,1,12.63,8,4,4,0,0,1,16,11.37Z\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/><line x2=\"0.01\" transform=\"translate(17.5 6.5)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/></g></svg>\n        </a>\n    </div>\n</div>        </div>\n      </div>\n          </div>\n    <!-- end of right-content -->\n  </div>\n</footer>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n        //Cookie Script\n        var csCtas = document.querySelectorAll('.cookie-inf');\n        //Remove Cookie Guard if there is no video\n        let checkElem = setInterval(() => {\n          if(document.querySelector('.rsContent')) {\n            let elemChildren = document.querySelector('.rsContent').children.length\n            console.log(elemChildren)\n            if( elemChildren === 4 ) {\n              doRemoveCsCtas()\n              clearInterval(checkElem)\n            }\n            else {\n              clearInterval(checkElem)\n            }\n          }\n          else {\n            clearInterval(checkElem)\n          }\n        }, 500);\n\n        function doRemoveCsCtas() {\n          csCtas.forEach((csCta) => {\n            csCta.style.display = 'none';\n          });\n        }\n\n        function doCheckCsCats(cats) {\n          if(cats.includes('targeting')) {\n            doRemoveCsCtas();\n          }\n        }\n\n        window.addEventListener('CookieScriptLoaded', function(event) {\n          var csState = CookieScript.instance.currentState();\n          doCheckCsCats(csState.categories);\n          CookieScript.instance.onAcceptAll = function (data) {\n            if(csCtas.length > 0) {\n              doRemoveCsCtas();\n            }\n          }\n        })\n  })\n</script>\n\n<script type=\"application/ld+json\">\n  {\n    \"@context\": \"http://schema.org\",\n    \"@type\": \"MovieTheater\",\n    \"description\": \"Multi-screen cinema showing the latest blockbuster and 3D film releases, with cheap tickets all day.\",\n    \"name\": \"Peckhamplex Cinema\",\n    \"logo\": \"https://www.peckhamplex.london/imgs/generic/peckhamplex-title-treatment.png\",\n    \"image\": \"https://www.peckhamplex.london/imgs/generic/pecky-frontage-sign.jpg\",\n    \"email\": \"managers@peckhamplex.net\",\n    \"telephone\": \"0844567727742\",\n    \"url\": \"https://www.peckhamplex.london\",\n    \"address\": {\n      \"@type\": \"PostalAddress\",\n      \"addressLocality\": \"London\",\n      \"addressRegion\": \"London\",\n      \"postalCode\": \"SE15 4ST\",\n      \"streetAddress\": \"95A Rye Lane\"\n    },\n    \"openingHours\": \"Mo,Tu,We,Th,Fr, Sa,Su 11:00-00:00\",\n    \"priceRange\": \"£4.99 - £9.99\",\n    \"geo\": {\n      \"@type\": \"GeoCoordinates\",\n      \"latitude\": \"51.4708403\",\n      \"longitude\": \"-0.0704681\"\n    },\n    \"sameAs\": [\"https://www.twitter.com/PeckhamPlex\",\n      \"https://www.facebook.com/PeckhamPlex\"\n    ],\n    \"hasMap\": \"https://www.google.co.uk/maps/place/Peckhamplex/@51.4708403,-0.0704681,17z/data=!3m1!4b1!4m2!3m1!1s0x487603a04ed28a3b:0x281104011b747159\"\n  }\n</script>\n\n    </div>\n    <link rel=\"stylesheet\" href=\"https://www.peckhamplex.london/css/s/footer.min.css\" />\n\n    <script src=\"https://www.peckhamplex.london/js/s/search.min.js\"></script>\n    <script src=\"https://www.peckhamplex.london/js/s/app.min.js\"></script>\n    <script src=\"https://www.peckhamplex.london/js/s/trailers.min.js\"></script>\n<script>\n    (function() {\n        App.Generic();\n    })();\n</script>\n    <!-- Choose A Film By Title Pop Up -->\n    <!-- Modal -->\n<div class=\"modal fade\" id=\"chooseAFilmByTitle\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"chooseAFilmByTitle\" aria-hidden=\"true\">\n  <div class=\"modal-dialog\">\n      <div class=\"modal-content\">\n          <div class=\"modal-header\">\n              <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">&times;</button>\n              <h4 class=\"modal-title\">Choose Film By Title</h4>\n          </div>\n          <div class=\"modal-body\">\n              <!-- Film Title listings -->\n              <p>Please select a film title from the options below.</p>\n\n               <div class=\"film-by-title\"></div>\n               <br />\n\n              <!-- Film Dates Listings -->\n\n              <div class=\"film-by-dates\"></div>\n              <br />\n\n              <!-- Film Times Listings -->\n\n              <div class=\"film-by-times\"></div>\n                <hr />\n              <p class=\"booking-info\"><b>Please Note:</b><br /> These films <b>DO NOT</b> include the <a href=\"https://www.peckhamplex.london/films/watch-with-baby\">Watch With Baby</a> dates &amp; times.\n                   <br /><span class=\"icon\" title=\"Hard of Hearing screening\"><i class=\"fa fa-volume-up\"></i></span> - Denotes a <a href=\"https://www.peckhamplex.london/films/hard-of-hearing\">Hard of Hearing</a> Film.<br /><span class=\"icon\" title=\"Autism Friendly screening\"><i class=\"fa fa-universal-access\"></i></span> - Denotes a <a href=\"https://www.peckhamplex.london/films/autism-friendly\">Autism Friendly</a> Film.</p>\n\n              <div class=\"film-submit hide\">\n                  <!-- <hr /> -->\n\n                  <button id=\"rest-form\" type=\"button\">Reset</button>\n              </div>\n\n\n\n          </div>\n\n      </div>\n  </div>\n</div>\n    <!-- Choose A Film By Date Pop Up -->\n    <!-- Modal -->\n<div class=\"modal fade\" id=\"chooseAFilmByDate\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"chooseAFilmByDate\" aria-hidden=\"true\">\n  <div class=\"modal-dialog\">\n      <div class=\"modal-content\">\n          <div class=\"modal-header\">\n              <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">&times;</button>\n              <h4 class=\"modal-title\">Choose Film By Date</h4>\n          </div>\n          <div class=\"modal-body\">\n\n            <!-- Film Dates listings -->\n             <p>Please select a date from the options below.</p>\n             <div class=\"film-by-date\"></div>\n             <br />\n\n            <!-- Film Titles Listings -->\n\n            <div class=\"film-by-title\"></div>\n            <br />\n\n            <!-- Film Times Listings -->\n\n            <div class=\"film-by-times\"></div>\n\n            <hr />\n              <p class=\"booking-info\"><b>Pl