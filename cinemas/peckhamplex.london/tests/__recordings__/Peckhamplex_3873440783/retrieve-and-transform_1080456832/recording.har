v>\n    </div>\n    <div class=\"title-treatment\">\n        <a href=\"https://www.peckhamplex.london\"><img src=\"https://www.peckhamplex.london/imgs/generic/peckhamplex-title-treatment.png\" alt=\"Peckhamplex London logo\" title=\"Peckhamplex, London\" /></a>\n        <a href=\"https://www.timeout.com/london/news/our-favourite-venues-in-london-right-now-time-outs-2024-recommended-stickers-have-hit-the-streets-121724\" target=\"_blank\"><img src=\"/imgs/generic/timeout-award-2024.jpg\" alt=\"Time Out The Best of The City 2024 Award\" title=\"We are very proud to receive the Time Out Award for The Best of The City 2024\" class=\"header-award\" /></a>\n        <!--<a href=\"https://www.peckhamplex.london\"><img src=\"https://www.peckhamplex.london/imgs/generic/peckhamplex-title-treatment.png\" alt=\"Peckhamplex London logo\" title=\"Peckhamplex, London\" /></a>\n        <a href=\"https://www.timeout.com/london/cinemas/peckhamplex\" target=\"_blank\"><img src=\"/imgs/generic/uk-london-badge-black-2018.png\" alt=\"Time Out Love London Award 2018 badge\" alt=\"Peckhamplex is proud to receive a Time Out Love London Award 2018\" class=\"header-award\" /></a>\n        <a href=\"https://www.timeout.com/london/news/our-favourite-venues-in-london-right-now-time-outs-2024-recommended-stickers-have-hit-the-streets-121724\" target=\"_blank\"><img src=\"/imgs/generic/timeout-2024.png\" alt=\"Time Out London Award 2024 badge\" alt=\"Peckhamplex is proud to receive a Time Out The Best of The City 2024 Award\" class=\"header-award\" /></a>-->\n    </div>\n    <!-- New Ticket Price Info. Added 21-07-2017 -->\n    <div class=\"ticket-info-wrapper\">\n        <p style=\"font-size: 20px;\">ALL TICKETS <span style=\"color: #bf4495;\">&pound;6.99*</span> EVERY DAY <span style=\"font-size:14px\">(*60p booking fee)</span></p>\n        <p style=\"font-size: 14px;\">(Additional &pound;1 supplement for 3D features)</p>\n    </div>\n    <!-- New Ticket Price Info. Added 21-07-2017 -->\n    <!--