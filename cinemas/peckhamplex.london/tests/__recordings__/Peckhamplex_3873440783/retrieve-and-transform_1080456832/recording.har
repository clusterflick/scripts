mn;justify-content:flex-end;align-items:flex-end;user-select:none;\">\n                <div style=\"box-sizing:border-box;width:100%;padding:30px;background-color:#bf4495;text-align:center\">\n                    Please accept targeting cookies to watch this video content.<br />\n                    <a href=\"javascript:CookieScript.instance.show()\">Click here to change your cookie preferences</a>.\n                </div>\n            </div>\n            <!--Cookie Notice-->\n                <!-- Carousel Player Wrapper -->\n<div class=\"carousel-player-wrapper\">\n    <!-- Royalslider Wrapper -->\n    <div id=\"site-carousel\" class=\"royalSlider rsMinW\">\n                    <!-- Trailer -->\n            <div class=\"rsContent\" itemscope itemtype=\"http://schema.org/VideoObject\">\n                    <img class=\"rsImg\" data-rsVideo=\"https://youtu.be/eLgAL70FzLE\"  src=\"/imgs/posters/trailers/a-tooth-fairy-tale.jpg\" alt=\"A Tooth Fairy Tale\">\n                    <meta itemprop=\"embedURL\" content=\"https://youtu.be/eLgAL70FzLE\" />\n                     <meta itemprop=\"uploadDate\" content=\"2025-10-20T10:49:08+01:00\">\n                    <meta itemprop=\"name\" content=\"A Tooth Fairy Tale\">\n                    <meta  itemprop=\"thumbnailURL\" content=\"/imgs/posters/trailers/a-tooth-fairy-tale.jpg\" />\n                    <meta itemprop=\"caption\" content=\"A Tooth Fairy Tale\">\n                    <meta itemprop=\"description\" content=\"Van is a teenage tooth fairy with a taste for adventure, who wishes to explore life beyond the boundaries of his secluded civilization and rigid traditions. Upon meeting Gemma, a daring goblin girl with a knack for science, the pair realise that they have a lot in common, despite the ancient disputes between their two tribes. Together, with the help of Rupee (the world’s cutest troll!), they decide to embark on a mission to reunite their magical kingdoms for good. However, hot on their trail is the greedy Spider Queen and her minions, who will stop at nothing to put an end to their plans.\r\n\r\nA stunning animation that will spark the imagination of the whole family, it stars Booboo Stewart (The Twilight Saga, Descendants), Larkin Bell (Stranger Things), Vivica A. Fox (Ella Enchanted), Jon Lovitz (Matilda, Hotel Transylvania), and Fran Drescher (Hotel Transylvania).\">\n                    \n                </div><!-- end o trailer -->\n        \n        \n     </div>\n    <!-- End of Royalslider Wrapper -->\n</div>\n<!-- End of Carousel Player Wrapper -->\n<a name=\"booktickets\" id=\"booktickets\"></a>        </div>\n    </div>\n    <!-- end of Carousel -->\n    <!-- Side Details -->\n    <div class=\"side-details\">\n        <!-- company-details -->\n        <div class=\"company-details\">\n            <div class=\"cp-address\">\n    <small>Peckhamplex 95a Rye Lane, London, SE15 4ST</small><br />\n    <a class=\"phone\" href=\"tel:0844 567 2742\">0844 567 2742<sup>*</sup></a><br />\n    <a class=\"email\" href=\"mailTo:managers@peckhamplex.net\">managers@peckhamplex.net</a>\n</div>\n<!-- -->\n<div class=\"cp-statement\">\n\n    <p>Your friendly independent, licensed, multiplex cinema in South London and home to the £6.99 cinema ticket.</p>\n\n</div>\n<!-- -->\n<div class=\"social-strip-wrapper\">\n    <div class=\"social-outer-wrapper\">\n    <p>Follow Us on</p>\n    <div class=\"social-wrapper\">\n        <a href=\"https://www.facebook.com/PeckhamPlex\" class=\"facebook\" target=\"_blank\" rel=\"noopener\" class=\"m-0 p-0 text-gray-400 hover:text-accent focus:text-accent\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 12 21\"><title>Following us on Facebook</title><path d=\"M18,2H15a5,5,0,0,0-5,5v3H7v4h3v8h4V14h3l1-4H14V7a1,1,0,0,1,1-1h3Z\" transform=\"translate(-6.5 -1.5)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/></svg>\n        </a>\n        <a href=\"https://www.twitter.com/PeckhamPlex\" class=\"twitter\" target=\"_blank\" rel=\"noopener\" class=\"m-0 p-0 text-gray-400 hover:text-accent focus:text-accent\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 25.521 21.207\"><title>Following us on Twitter</title><path d=\"M25.521,3a12.149,12.149,0,0,1-3.5,1.705A4.993,4.993,0,0,0,13.26,8.05V9.165A11.881,11.881,0,0,1,3.229,4.116S-1.229,14.147,8.8,18.605A12.974,12.974,0,0,1,1,20.835c10.031,5.573,22.292,0,22.292-12.818a5.016,5.016,0,0,0-.089-.925A8.6,8.6,0,0,0,25.521,3Z\" transform=\"translate(-0.5 -2.412)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/></svg>\n        \n        </a>\n        <a href=\"https://www.instagram.com/peckhamplexcinema/\" class=\"instagram\" target=\"_blank\" rel=\"noopener\" class=\"m-0 p-0 text-gray-400 hover:text-accent focus:text-accent\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 21 21\"><title>Following us on Instagram</title><g transform=\"translate(-1.5 -1.5)\"><rect width=\"20\" height=\"20\" rx=\"5\" transform=\"translate(2 2)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/><path d=\"M16,11.37A4,4,0,1,1,12.63,8,4,4,0,0,1,16,11.37Z\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/><line x2=\"0.01\" transform=\"translate(17.5 6.5)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/></g></svg>\n        </a>\n    </div>\n</div></div>        </div>\n        <!-- end of company-details-->\n        <!-- Ad: MPU -->\n        <div id=\"mpu-a-d\" class=\"mpu\">\n            <div class=\"a-d-wrapper\">\n<div id='div-gpt-ad-1734906484118-0' style='min-width: 300px; min-height: 50px;'>\n  \n</div>\n</div>\n        </div>\n            <!-- end of Ad: MPU -->\n    </div>\n    <!-- end of Side Details -->\n</div>\n<!-- end of HP: Top -->\n    <!-- end of Top Section -->\n    <div class=\"film-details-wrapper\" itemscope itemtype=\"http://schema.org/Movie\">\n        <link itemprop=\"url\" href=\"https://www.peckhamplex.london/film/a-tooth-fairy-tale\" />\n\n        <h1 class=\"page-title\" itemprop=\"name\">A Tooth Fairy Tale</h1>\n        <!-- Film Details -->\n        <div class=\"inner-content-wrapper\">\n            <div class=\"details-wrapper\">\n                <div class=\"info-section\">\n                    <div class=\"poster-wrapper\">\n                        <div class=\"poster\">\n                                                        <img itemprop=\"image\" src=\"/imgs/posters/large/a-tooth-fairy-tale.jpg\" alt=\"A Tooth Fairy Tale\" title=\"A Tooth Fairy Tale\" />\n                        </div>\n                    </div>\n                    <div class=\"info\">\n                        <p><b>Format:</b> 2D Digital\n                                                    </p>\n                        <p><b>Genre:</b> Animated </p>\n                        <p><b>Running Time:</b> 1 hour 29 minutes</p>\n                        <p><b>Rate:</b> PG<br />mild fantasy violence</p>\n                        <br />\n                        <p><i class=\"fa fa-info-circle\"></i> Free List Suspended</p>                        <p><i class=\"fa fa-wheelchair\"></i> Wheelchair/Disabled Access</p>                                                <p class=\"more-info\">For more cinema access information <br class=\"show-on-ip\"><a href=\"https://www.peckhamplex.london/cinema/access\">click here</a>.\n                        <meta itemprop=\"dateCreated\" content=\"01-01-1970\">\n                    </div>\n\n                </div><!-- end of poster -->\n                <div class=\"content\">\n                    <!-- synopsis -->\n                                        <div class=\"synopsis\">\n                        <h3>A Tooth Fairy Tale Synopsis</h3>\n                        <p itemprop=\"description\">Van is a teenage tooth fairy with a taste for adventure, who wishes to explore life beyond the boundaries of his secluded civilization and rigid traditions. Upon meeting Gemma, a daring goblin girl with a knack for science, the pair realise that they have a lot in common, despite the ancient disputes between their two tribes. Together, with the help of Rupee (the world’s cutest troll!), they decide to embark on a mission to reunite their magical kingdoms for good. However, hot on their trail is the greedy Spider Queen and her minions, who will stop at nothing to put an end to their plans.<br />\r\n<br />\r\nA stunning animation that will spark the imagination of the whole family, it stars Booboo Stewart (The Twilight Saga, Descendants), Larkin Bell (Stranger Things), Vivica A. Fox (Ella Enchanted), Jon Lovitz (Matilda, Hotel Transylvania), and Fran Drescher (Hotel Transylvania).</p>\n                                                                    </div><!-- end of synopsis -->\n                                        <a name=\"watchwithbaby\" id=\"watchwithbaby\"></a>\n\n                    \n                    <!-- Book Tickets -->\n                                        <div class=\"book-tickets\">\n        <h3>Book Tickets</h3>\n    <div class=\"book-tickets-listings\">\n\n                                        <div class=\"date-wrapper\">\n            <p class=\"ticket-date\">Monday 27th October 2025</p>\n            <div class=\"btn-group\" role=\"group\">\n                                                <a class=\"btn btn-info\" onclick=\"gtag('event', 'click', {'event_category' :'book tickets', 'event_label': 'A Tooth Fairy Tale : Monday 27th October 2025 at 15:20'})\" href=\"https://ticketing.eu.veezi.com/purchase/75775?siteToken=zkD3Bh7H%2fkuZI9VTgCj%2bgg%3d%3d\" target=\"_blank\"><time datetime=\"2025-10-27T15:20\">15:20</time></a>\n                                            </div>\n        </div>\n                                        <div class=\"date-wrapper\">\n            <p class=\"ticket-date\">Tuesday 28th October 2025</p>\n            <div class=\"btn-group\" role=\"group\">\n                                                <a class=\"btn btn-info\" onclick=\"gtag('event', 'click', {'event_category' :'book tickets', 'event_label': 'A Tooth Fairy Tale : Tuesday 28th October 2025 at 12:35'})\" href=\"https://ticketing.eu.veezi.com/purchase/75791?siteToken=zkD3Bh7H%2fkuZI9VTgCj%2bgg%3d%3d\" target=\"_blank\"><time datetime=\"2025-10-28T12:35\">12:35</time></a>\n                                                                <a class=\"btn btn-info\" onclick=\"gtag('event', 'click', {'event_category' :'book tickets', 'event_label': 'A Tooth Fairy Tale : Tuesday 28th October 2025 at 15:20'})\" href=\"https://ticketing.eu.veezi.com/purchase/75799?siteToken=zkD3Bh7H%2fkuZI9VTgCj%2bgg%3d%3d\" target=\"_blank\"><time datetime=\"2025-10-28T15:20\">15:20</time></a>\n                                            </div>\n        </div>\n                                        <div class=\"date-wrapper\">\n            <p class=\"ticket-date\">Wednesday 29th October 2025</p>\n            <div class=\"btn-group\" role=\"group\">\n                                                <a class=\"btn btn-info\" onclick=\"gtag('event', 'click', {'event_category' :'book tickets', 'event_label': 'A Tooth Fairy Tale : Wednesday 29th October 2025 at 12:35'})\" href=\"https://ticketing.eu.veezi.com/purchase/75815?siteToken=zkD3Bh7H%2fkuZI9VTgCj%2bgg%3d%3d\" target=\"_blank\"><time datetime=\"2025-10-29T12:35\">12:35</time></a>\n                                                                <a class=\"btn btn-info\" onclick=\"gtag('event', 'click', {'event_category' :'book tickets', 'event_label': 'A Tooth Fairy Tale : Wednesday 29th October 2025 at 15:20'})\" href=\"https://ticketing.eu.veezi.com/purchase/75823?siteToken=zkD3Bh7H%2fkuZI9VTgCj%2bgg%3d%3d\" target=\"_blank\"><time datetime=\"2025-10-29T15:20\">15:20</t