i>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/visit/memberships/\">Memberships</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/trusts-and-foundations/\">Trusts and Foundations</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/star-supporters/\">Star Supporters</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/corporate-partners/\">Corporate Partners</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/meet-our-supporters/\">Our Supporters</a></li>\n</ul>\n</li>\n</ul></div>\t\t\t\t\t\t\t</nav><!-- #site-navigation -->\n\n\t\t\t\t\t\t\t<div class=\"subnav\" > <!-- Sub Nav -->\n\t\t\t\t\t\t\t\t<div class=\"subnav__links\" > <!-- Links -->\n\t\t\t\t\t\t\t\t\t<div class=\"basket_icon\" >\n\t\t\t\t\t\t\t\t\t\t<a href=\"/basket/\" class=\"basket\" >\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/basket.svg\" alt=\"basket - Checkout\" />\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"login_icon\" >\n\t\t\t\t\t\t\t\t\t\t<a href=\"/my-account/\" class=\"login\" >\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/user.svg\" alt=\"user - Login\" />\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"search_icon\" tabindex=\"-1\" > <!-- Site Search Icon -->\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"#search_form\" role=\"button\" title=\"Search Bar\" aria-label=\"Search Bar\" aria-controls=\"search_form\" aria-expanded=\"false\" aria-haspopup=\"true\" >\n\t\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/search.svg\" alt=\"search icon\" />\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t</div> <!-- / Site Search Icon -->\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div> <!-- / Links -->\n\t\t\t\t\t\t\t\t<div class=\"subnav__menu\"  > <!-- Menu -->\n\t\t\t\t\t\t\t\t\t<a href=\"#menu-popout\" class=\"subnav__menu-hamburger toggleButton\" aria-controls=\"navigation\" aria-expanded=\"false\" aria-haspopup=\"true\" ><img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" /></a>\n\t\t\t\t\t\t\t\t</div> <!-- / Menu -->\n\t\t\t\t\t\t\t</div> <!-- / Sub Nav -->\n\n\t\t\t\t\t\t</div> <!-- / Main Nav -->\n\n\t\t\t\t\t\t<div class=\"nav_icon\"><!-- Nav Icon -->\n\t\t\t\t\t\t\t<a href=\"#mobile-navigation\">\n\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" />\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div> <!-- / Nav Icon -->\n\n\t\t\t\t\t</div> <!-- / Nav Wrapper -->\n\n\t\t\t\t\t\n\t\t\t\t\t</div> <!-- / Logo Nav Holder -->\n\n\t\t\t\t</div> <!-- / Max Width -->\n\t\t\t</div> <!-- / Full Content -->\n\n\t\t</header><!-- #masthead -->\n\n\t\t<div id=\"content\" class=\"site-content\">\n\n\t\t<div id=\"primary\" class=\"content-area event\">\n    <main id=\"main\" class=\"site-main\">\n\n    \n        \n<section class=\"event_header\"> <!-- Event Header -->\n        <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/BushTheatre_Attention_Website_1920x1080px.jpg\" alt=\"Attention\" class=\"event_header__image event_header__image--center\">\n            <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/BushTheatre_Attention_Website_1200x1900px.jpg\" alt=\"Attention\" class=\"event_header__image event_header__image--center show_mob\">\n    \n    <div class=\"event_header__intro\"> <!-- Event Intro -->\n        <div class=\"event_header__intro_holder\">\n            <div class=\"event_header__intro_text\">\n                <h1 class=\"alt_heading\">ATTENTION</h1>\n\n                                    <p>Co-created by Jules Head and Georgia Bruce</p>\n                \n                                    <p class=\"event_header__date\">\n                                                                                                                                                                                                                                                            \n                                                                    <p>19 Nov to 23 Dec</p>\n                                \n                            \n                                                                            <p>Studio</p>\n                                            </p>\n                            </div>\n\n            <div class=\"event_header__intro_btn\">\n                                                                                                                                                <a href=\"#book\" class=\"btn\">Book tickets</a>\n                                                                        </div>\n        </div>\n    </div> <!-- / Event Intro -->\n\n</section> <!-- / Event Header -->\n\n<div class=\"event_nav\"> <!-- Event Nav -->\n    <div class=\"event_nav__width\">\n        <div class=\"event_nav__anchors\">\n            <a href=\"#about\" class=\"event_nav__item\">About</a>\n            <a href=\"#Cast &amp; Creatives\" class=\"event_nav__item\">Cast &amp; Creatives</a>\n        </div>\n                    <div class=\"event_nav__book\">\n                                    <a href=\"#book\" class=\"event_nav__item--book btn small btn_no_arrow\">Book tickets</a>\n                            </div>\n            </div>\n</div> <!-- / Event Header -->\n\n<div class=\"event_internal\">\n    <section class=\"full_content dark_bg event_about pt_lrg pb_lrg\" aria-label=\"About Event\" id=\"about\">\n        <div class=\"event_about__row mw_1200\">\n\n            \n                <div class=\"event_about__details green_bg\"> <!-- Details -->\n                    <p class=\"h3 dark\">Details</p>\n\n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Venue</p>\n                            <p class=\"row_value\">Studio</p>\n                        </div>\n                    \n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Dates</p>\n                        <p class=\"row_value\">\n                                                                                                                                                \n                                                                    <p>19 Nov to 23 Dec</p>\n                                                                                    </p>\n                    </div>\n\n                    \n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Age Guidance</p>\n                            <p class=\"row_value\">14+</p>\n                        </div>\n                    \n                     <!-- Button Repeater -->\n                        <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Content Guidance</p>\n                            <div class=\"btns_container\">\n                                                                                                        <a class=\"btn small\" href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Attention-self-care-guide-2026.pdf\" target=\"_blank\">Self-care guide &amp; content warnings</a>\n                                    \n                                                            </div>\n                        </div>\n                     <!-- / Button Repeater -->\n\n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Price</p>\n                        <p class=\"row_value\">\n                                                            £15.00 to £25.00                                                    </p>\n                    </div>\n\n                </div> <!-- / Details -->\n\n            \n            <div class=\"event_about__desc\">\n                <p class=\"h2\">About</p>\n                <div id=\"\">\n<p><b><i>“Because in the middle of all that fucking work is something, is our thing. That’s good, isn’t it? Isn’t it good?”</i></b></p>\n<p><span style=\"font-weight: 400\">They stand at the edge of a circle. They look across at her, standing there too. Every day, for the last seven years, they’ve both stepped inside. Together. Again and again and again. And today, they go again.</span></p>\n<p>A queer play about why and how we choose to pay attention.<br />\nAbout the effort and sweat needed to build a life with someone.<br />\nAbout whether love is enough to save us.</p>\n<p><span style=\"font-weight: 400\">Every night the actors will choose how to tell the story &#8211; they might restart, fast-forward, stop altogether. Every night, they navigate the truth of their relationship like a match between two players. Every night, they try to end on the same page.</span></p>\n<p><span style=\"font-weight: 400\">Co-created by acclaimed director </span><b>Jules Head</b><span style=\"font-weight: 400\"> and Bruntwood Prize shortlisted writer </span><b>Georgia Bruce</b><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">ATTENTION</span></i><span style=\"font-weight: 400\"> was nominated for 7 awards at the Dublin Fringe Awards, including Best Production and the Radical Spirit Award. Original cast members </span><b>Bláithín Mac Gabhann</b><span style=\"font-weight: 400\"> and </span><b>Norah Lopez Holden</b><span style=\"font-weight: 400\"> return.</span></p>\n</div>\n\n            </div>\n\n        </div>\n\n                    <div class=\"mw_1200 event_about__desc_extra\">\n                <p class=\"small\">\n                    Presented by Tilly Taylor in association with Bush Theatre. Co-created by Jules Head and Georgia Bruce, with Tilly Taylor, Bláithín Mac Gabhann and Norah Lopez Holden.                </p>\n            </section>\n\n    \n\n\n<section \n        class=\"full_content testimonial-block\"\n>\n    <!-- Full Content -->\n    <!-- Testimonial Slider -->\n    <div class=\"testimonial-block__slider\">\n                                                    <div class=\"testimonial-block__item green dark_bg\">\n                    <!-- Item -->\n                    \n                    <div class=\"testimonial-block__slide-wrap mw_960 pt_none pb_sm\">\n                                                                                <div class=\"testimonial-block__rating\">\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                            </div>\n                        \n                        <div class=\"testimonial-block__text\">\n                            <!-- Slide -->\n                                                            <blockquote class=\"testimonial-block__text-quote h1 green_border\">\n                                    <!-- Text Quote -->\n                                    “Georgia Bruce’s swooning play features one of the best duets of the year.”                                 </blockquote>\n                            \n                                                            <p class=\"testimonial-block__text-author\">\n                                    <!-- Text Author -->\n                                    &#8211; Feeling Good                                </p>\n                                                    </div>\n                    </div>\n                </div>\n                        </div><!-- .testimonial-block__slider -->\n</section>\n\n\n\r\n\r\n\r\n<section\r\n  aria-label=\"Cast &#038; Creatives\"id=\"Cast &#038; Creatives\"  class=\"full_content team-listing light_bg pt_sm pb_sm\"\r\n> <!-- Full Content -->\r\n\r\n  <div class=\"mw_1200 no_text_center\"> <!-- MW -->\r\n\r\n    <p class=\"h2\">Creatives</p><div class=\"team-listing__spacer\" ></div>\r\n    \r\n    \r\n    \r\n              <ul class=\"team-listing__grid horizontal\" > <!-- Grid -->\r\n                      <li class=\"team-listing__post horizontal\" > <!-- Post -->\r\n                                  <div class=\"team-listing__post-image horizontal\" > <!-- Image Container -->\r\n                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Copy-of-Blaithin-Mac-Gabhann-320x480.jpg\" alt=\"\" />\r\n                  </div> <!-- / Image Container -->\r\n                                <div class=\"team-listing__post-info\" > <!-- Info Container -->\r\n                  <div>\r\n                    <div class=\"heading\" >\r\n                      <p class=\"title\" >Bláithín Mac Gabhann</p>\r\n                                              <p>Cast Member</p>\r\n                                          </div>\r\n                                          <p class=\"small_text\" >Bláithín (she/they) has most recently been cast as Mary Louise in BÁN by Carys D. Coburn, directed by Claire O’Reilly for the Abbey Theatre, Ireland’s National Theatre; and as B&hellip;</p>\r\n                                      </div>\r\n                  <div>\r\n                    <a href=\"#team-listing-item-15388\" class=\"link alt team-listing__popup-link\" >Read More</a>\r\n\r\n                    <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15388\" > <!-- Pop-up -->\r\n                      <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                        <span>X</span>\r\n                      </button>\r\n                      <div class=\"team-listing__popup-content horizontal\" > <!-- Content -->\r\n                                                  <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                            <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Copy-of-Blaithin-Mac-Gabhann-320x480.jpg\" alt=\"\" />\r\n                          </div> <!-- / Image Container -->\r\n                                                <p class=\"h3\" >Bláithín Mac Gabhann</p>\r\n                                                  <p class=\"h5\" >Cast Member</p>\r\n                                                <div class=\"divider\" ></div>\r\n                                                  <p><span style=\"font-weight: 400\"><strong>Bláithín</strong> (she/they) has most recently been cast as Mary Louise in </span><i><span style=\"font-weight: 400\">BÁN</span></i><span style=\"font-weight: 400\"> by Carys D. Coburn, directed by Claire O’Reilly for the Abbey Theatre, Ireland’s National Theatre; and as B in </span><i><span style=\"font-weight: 400\">ATTENTION</span></i><span style=\"font-weight: 400\"> directed by Jules Head for Dublin Fringe Festival. Further recent stage credits include </span><i><span style=\"font-weight: 400\">AMELIA</span></i><span style=\"font-weight: 400\"> by Dee Roycroft at Project Arts Centre for Dublin Fringe Festival; the role of Rose in Brian Friel’s </span><i><span style=\"font-weight: 400\">DANCING AT LUGHNASA</span></i><span style=\"font-weight: 400\"> directed by Josie Rourke at the National Theatre, London; and </span><i><span style=\"font-weight: 400\">HOTHOUSE</span></i><span style=\"font-weight: 400\"> directed by Claire O’Reilly for Malaprop.</span></p>\n<p><span style=\"font-weight: 400\">Bláithín won Best Supporting Actor at the Irish Times Irish Theatre Awards (June 2022) for their performance in Nancy Harris’s </span><i><span style=\"font-weight: 400\">OUR NEW GIRL</span></i><span style=\"font-weight: 400\"> directed by Annabelle Comyn for the Gate Theatre; and for their role as Mary (Masha) in Thomas Kilroy’s </span><i><span style=\"font-weight: 400\">THE SEAGULL</span></i><span style=\"font-weight: 400\"> (after Chekhov) directed by Garry Hynes for Druid Theatre Co.</span></p>\n<p><span style=\"font-weight: 400\">Further credits include: the role of the Outsider in </span><i><span style=\"font-weight: 400\">THE WAY OUT</span></i><span style=\"font-weight: 400\"> directed by Suri Krishnamma as part of the Performance Live collaboration between the BBC, Arts Council England, and BAC; </span><i><span style=\"font-weight: 400\">PENANCE</span></i><span style=\"font-weight: 400\"> directed by Maurice Sweeney for Channel 5;</span><i><span style=\"font-weight: 400\"> NORMAL PEOPLE </span></i><span style=\"font-weight: 400\">directed by Lenny Abrahamson and Hettie Macdonald; Carys Coburn’s Verity Bargate Award-winning play </span><i><span style=\"font-weight: 400\">CITYSONG</span></i><span style=\"font-weight: 400\">, directed by Caitriona McLaughlin for the Abbey Theatre, the Soho Theatre London, and the Galway International Arts Festival (2019).</span></p>\n<p>&nbsp;</p>\n                                                <div class=\"clear\"></div>\r\n                      </div> <!-- / Content -->\r\n                    </div> <!-- / Pop-up -->\r\n\r\n                  </div>\r\n                </div> <!-- / Info Container -->\r\n            </li> <!-- / Post -->\r\n                      <li class=\"team-listing__post horizontal\" > <!-- Post -->\r\n                                  <div class=\"team-listing__post-image horizontal\" > <!-- Image Container -->\r\n                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Copy-of-NORAH-LOPEZ-HOLDEN-320x480.jpg\" alt=\"\" />\r\n                  </div> <!-- / Image Container -->\r\n                                <div class=\"team-listing__post-info\" > <!-- Info Container -->\r\n                  <div>\r\n                    <div class=\"heading\" >\r\n                      <p class=\"title\" >Norah Lopez Holden</p>\r\n                                              <p>Cast Member</p>\r\n                                          </div>\r\n                                          <p class=\"small_text\" >Norah Lopez Holden trained and graduated from RADA.  Previous theatre credits include: Loves Labour’s Lost, Winters Tale, Eyam (Shakespeare´s Globe); Gunter (Royal Court); Shed: Exploded View, The Almighty Sometimes, Our&hellip;</p>\r\n                                      </div>\r\n                  <div>\r\n                    <a href=\"#team-listing-item-15390\" class=\"link alt team-listing__popup-link\" >Read More</a>\r\n\r\n                    <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15390\" > <!-- Pop-up -->\r\n                      <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                        <span>X</span>\r\n                      </button>\r\n                      <div class=\"team-listing__popup-content horizontal\" > <!-- Content -->\r\n                                                  <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                            <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Copy-of-NORAH-LOPEZ-HOLDEN-320x480.jpg\" alt=\"\" />\r\n                          </div> <!-- / Image Container -->\r\n                                                <p class=\"h3\" >Norah Lopez Holden</p>\r\n                                                  <p class=\"h5\" >Cast Member</p>\r\n                                                <div class=\"divider\" ></div>\r\n                                                  <p><span style=\"font-weight: 400\"><strong>Norah Lopez Holden</strong> trained and graduated from RADA. </span></p>\n<p><span style=\"font-weight: 400\">Previous theatre credits include: </span><i><span style=\"font-weight: 400\">Loves Labour’s Lost, Winters Tale, Eyam</span></i><span style=\"font-weight: 400\"> (Shakespeare´s Globe); </span><i><span style=\"font-weight: 400\">Gunter</span></i><span style=\"font-weight: 400\"> (Royal Court); </span><i><span style=\"font-weight: 400\">Shed: Exploded View, The Almighty Sometimes, Our Town </span></i><span style=\"font-weight: 400\">(Royal Exchange Manchester);  </span><i><span style=\"font-weight: 400\">The Flea </span></i><span style=\"font-weight: 400\">(Yard Theatre) </span><i><span style=\"font-weight: 400\">Hamlet</span></i><span style=\"font-weight: 400\"> (Young Vic); </span><i><span style=\"font-weight: 400\">Equus</span></i><span style=\"font-weight: 400\"> (Trafalgar Studios/Theatre Royal Stratford East, ETT); </span><i><span style=\"font-weight: 400\">Othello</span></i><span style=\"font-weight: 400\"> (Shakespeare at the Tobacco Factory/ETT); </span><i><span style=\"font-weight: 400\">The Art of Illusion</span></i><span style=\"font-weight: 400\"> (Hampstead); </span><i><span style=\"font-weight: 400\">Horneblende</span></i><span style=\"font-weight: 400\"> (Cut The Cord); </span><i><span style=\"font-weight: 400\">Curse of the Crackles </span></i><span style=\"font-weight: 400\">(Shoreditch Town Hall); </span><i><span style=\"font-weight: 400\">A Christmas Carol </span></i><span style=\"font-weight: 400\">(Storyhouse); </span><i><span style=\"font-weight: 400\">Ghosts</span></i><span style=\"font-weight: 400\"> (HOME Theatre); </span><i><span style=\"font-weight: 400\">Epic Love And Pop Songs</span></i><span style=\"font-weight: 400\"> (Pleasance).</span></p>\n<p><span style=\"font-weight: 400\">Screen credits include: </span><i><span style=\"font-weight: 400\">Criminal Record Season 2</span></i><span style=\"font-weight: 400\"> (AppleTV)</span></p>\n                                                <div class=\"clear\"></div>\r\n                      </div> <!-- / Content -->\r\n                    </div> <!-- / Pop-up -->\r\n\r\n                  </div>\r\n                </div> <!-- / Info Container -->\r\n            </li> <!-- / Post -->\r\n                  </ul>\r\n      \r\n    \r\n  </div> <!-- / MW -->\r\n\r\n</section> <!-- / Full Content -->\n\n\r\n\r\n\r\n<section\r\n  aria-label=\"Creatives\"  class=\"full_content team-listing light_bg pt_sm pb_sm\"\r\n> <!-- Full Content -->\r\n\r\n  <div class=\"mw_1200 no_text_center\"> <!-- MW -->\r\n\r\n    <p class=\"h2\">Creatives</p><div class=\"team-listing__spacer\" ></div>\r\n    \r\n    \r\n    \r\n              <ul class=\"team-listing__minimal-grid\" > <!-- Minimal Grid -->\r\n                      <li>\r\n              <a href=\"#team-listing-item-15200\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Georgia Bruce</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Writer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15200\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                          <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                        <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/GEORGIA-BRUCE-320x480.png\" alt=\"\" />\r\n                      </div> <!-- / Image Container -->\r\n                                        <p class=\"h3\" >Georgia Bruce</p>\r\n                                          <p class=\"h5\" >Writer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Georgia Bruce</strong> is a writer and actor from London.</p>\n<p>Their first play, <em>Time Like the Sea</em>, was shortlisted for the Bruntwood Prize, the George Devine Award, the Papatango Prize for Playwriting, the Theatre503 International Playwriting Award and the Women’s Prize for Playwriting. Their play <em>The Castle: or Imagine K Happy</em>, co-created with Jules Head, is running through 2026 at the Berliner Ensemble.</p>\n<p>Other credits include <em>Attention</em>, which debuted at the Dublin Fringe Festival in 2025, and <em>Nostos: after the Odyssey</em> which was commissioned by Oxford School of Drama and performed at the Southwark Playhouse. Between 2023-2025 Georgia was part of the Genesis Almeida New Writers Programme. They were also a member of the Royal Court Writers’ Group (2026) and BBC Voices (2024).</p>\n<p>As an actor, their theatre credits include <em>A Midsummer Night&#8217;s Dream</em> (Regent&#8217;s Park Open Air), <em>Fiddler on the Roof</em> (Regent&#8217;s Park Open Air/Barbican/UK Tour), <em>Wuthering Heights</em> (USA tour), <em>Robin Hood</em> (Watermill Theatre) and for television <em>It&#8217;s a Sin</em> (Channel 4).</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15203\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Jules Head</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15203\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                          <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                        <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Jules-Head-320x480.png\" alt=\"\" />\r\n                      </div> <!-- / Image Container -->\r\n                                        <p class=\"h3\" >Jules Head</p>\r\n                                          <p class=\"h5\" >Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Jules Head</strong> is a director of theatre, audio and film from Bristol, UK. Their work investigates RULES (too many) and TIME (never enough) and how people exist together in opposition to both.</p>\n<p>Jules was one of the WORX International Directors at the Berliner Ensemble for 2025-26. They directed the world premiere of <em>Archiv Der Träume (In The Dream House)</em> by Carmen Maria Machado and <em>Das Schloss (The Castle)</em> by Kafka in a new version by Georgia Bruce. Both shows are currently running in rep at Berliner Ensemble. Their play <em>Attention</em> co-created with Georgia Bruce premiered at Dublin Fringe Festival in 2025 and was nominated for 7 awards.</p>\n<p>Their debut production <em>Wild Swimming</em> won the Pleasance Regional Partnership award, the Ronald Duncan Award and was selected for Brits Off Broadway in 2020. Their short film, <em>Son of Helios</em> was selected for Prague Indie International Festival, and Manchester Lift Off Festival in 2023.</p>\n<p>Jules was an Associate Artist at Bristol Old Vic from 2019-2023 where they founded Young SixSix, a company that collaborates long-term with young people. They were a Headlong Origins Director in 2021, they were part of Buzz Artists Lab in Bremen, Germany in 2022 and trained on the National Theatre Directors Course in 2023.</p>\n<p>Recent Credits include: <em>Lessons</em> (Almeida), <em>Flies</em> by Charlie Josephine (Shoreditch Town Hall), <em>Romeo and Juliet</em> (Bristol Old Vic), <em>MASSIVE</em> by Charlie Josephine (Audible Original Productions).</p>\n<p>&nbsp;</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15379\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Tilly Taylor</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Creative Producer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15379\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Tilly Taylor</p>\r\n                                          <p class=\"h5\" >Creative Producer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Tilly</strong> is a Dublin-based Producer working across theatre, dance, and multidisciplinary performance. She is Producer for Dead Centre, one of Ireland’s foremost contemporary theatre companies, as well as creating new works as an Independent Producer.</p>\n<p>Recent projects include: <em>Deaf Republic</em> (Royal Court, Dublin Theatre Festival); <em>ATTENTION</em> (Dublin Fringe Festival); <em>Illness as Metaphor</em> (Dublin Fringe Festival, Viernulvier); <em>To Be a Machine</em> (Version 2.0) (Dublin Theatre Festival, Comédie de Reims, Theater Heilbronn); <em>Queen of the Meadows</em> (Backstage Theatre, Project Arts Centre for Live Collision Intl. Festival); <em>MOSH</em> (Dublin Fringe Festival, Norfolk &amp; Norwich Festival, Irish National Tour); <em>Glimmer</em> (Live Collision Intl. Festival); <em>Heat Sink</em> (Dublin Theatre Festival).</p>\n<p>Prior to establishing an independent practice, Tilly worked at Headlong, where she was Assistant Producer across the company&#8217;s stage productions and short films. Other companies she has produced with include Dublin Dance Festival, Landmark Productions, Junk Ensemble, Murmuration, New York Live Arts, Live Collision International Festival, Amanda Coogan, and Dublin Theatre of the Deaf.</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15382\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Suzie Cummins</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Lighting Designer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15382\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Suzie Cummins</p>\r\n                                          <p class=\"h5\" >Lighting Designer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15384\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n               