screen-reader-text\">Support Us sub navigation icon</span></a></div></div>\n<ul class=\"sub-menu\">\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/donate/\">Donate</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/visit/memberships/\">Memberships</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/trusts-and-foundations/\">Trusts and Foundations</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/star-supporters/\">Star Supporters</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/corporate-partners/\">Corporate Partners</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/meet-our-supporters/\">Our Supporters</a></li>\n</ul>\n</li>\n</ul></div>\t\t\t\t\t\t\t</nav><!-- #site-navigation -->\n\n\t\t\t\t\t\t\t<div class=\"subnav\" > <!-- Sub Nav -->\n\t\t\t\t\t\t\t\t<div class=\"subnav__links\" > <!-- Links -->\n\t\t\t\t\t\t\t\t\t<div class=\"basket_icon\" >\n\t\t\t\t\t\t\t\t\t\t<a href=\"/basket/\" class=\"basket\" >\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/basket.svg\" alt=\"basket - Checkout\" />\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"login_icon\" >\n\t\t\t\t\t\t\t\t\t\t<a href=\"/my-account/\" class=\"login\" >\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/user.svg\" alt=\"user - Login\" />\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"search_icon\" tabindex=\"-1\" > <!-- Site Search Icon -->\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"#search_form\" role=\"button\" title=\"Search Bar\" aria-label=\"Search Bar\" aria-controls=\"search_form\" aria-expanded=\"false\" aria-haspopup=\"true\" >\n\t\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/search.svg\" alt=\"search icon\" />\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t</div> <!-- / Site Search Icon -->\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div> <!-- / Links -->\n\t\t\t\t\t\t\t\t<div class=\"subnav__menu\"  > <!-- Menu -->\n\t\t\t\t\t\t\t\t\t<a href=\"#menu-popout\" class=\"subnav__menu-hamburger toggleButton\" aria-controls=\"navigation\" aria-expanded=\"false\" aria-haspopup=\"true\" ><img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" /></a>\n\t\t\t\t\t\t\t\t</div> <!-- / Menu -->\n\t\t\t\t\t\t\t</div> <!-- / Sub Nav -->\n\n\t\t\t\t\t\t</div> <!-- / Main Nav -->\n\n\t\t\t\t\t\t<div class=\"nav_icon\"><!-- Nav Icon -->\n\t\t\t\t\t\t\t<a href=\"#mobile-navigation\">\n\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" />\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div> <!-- / Nav Icon -->\n\n\t\t\t\t\t</div> <!-- / Nav Wrapper -->\n\n\t\t\t\t\t\n\t\t\t\t\t</div> <!-- / Logo Nav Holder -->\n\n\t\t\t\t</div> <!-- / Max Width -->\n\t\t\t</div> <!-- / Full Content -->\n\n\t\t</header><!-- #masthead -->\n\n\t\t<div id=\"content\" class=\"site-content\">\n\n\t\t<div id=\"primary\" class=\"content-area event\">\n    <main id=\"main\" class=\"site-main\">\n\n    \n        \n<section class=\"event_header\"> <!-- Event Header -->\n        <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/HIGAM-BUSH-IMAGE1-e1782225422226.png\" alt=\"\" class=\"event_header__image event_header__image--center\">\n            <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/HIGAM-Option2-Photo-by-Abdulisms-e1782312564138.png\" alt=\"\" class=\"event_header__image event_header__image--center show_mob\">\n    \n    <div class=\"event_header__intro\"> <!-- Event Intro -->\n        <div class=\"event_header__intro_holder\">\n            <div class=\"event_header__intro_text\">\n                <h1 class=\"alt_heading\">ALT B: How I Grew a Moustache (Work In Progress)</h1>\n\n                                    <p>By Riwa Saab</p>\n                \n                                    <p class=\"event_header__date\">\n                                                                                                                                                                                                                                                                                            <p class=\"few_dates\">\n                                    17 Jul, 18 Jul                                </p>\n                            \n                                                                            <p>Studio</p>\n                                            </p>\n                            </div>\n\n            <div class=\"event_header__intro_btn\">\n                                                                                                                                                <a href=\"#book\" class=\"btn\">Book tickets</a>\n                                                                        </div>\n        </div>\n    </div> <!-- / Event Intro -->\n\n</section> <!-- / Event Header -->\n\n<div class=\"event_nav\"> <!-- Event Nav -->\n    <div class=\"event_nav__width\">\n        <div class=\"event_nav__anchors\">\n            <a href=\"#about\" class=\"event_nav__item\">About</a>\n            <a href=\"#Crestives\" class=\"event_nav__item\">Creatives</a>\n        </div>\n                    <div class=\"event_nav__book\">\n                                    <a href=\"#book\" class=\"event_nav__item--book btn small btn_no_arrow\">Book tickets</a>\n                            </div>\n            </div>\n</div> <!-- / Event Header -->\n\n<div class=\"event_internal\">\n    <section class=\"full_content dark_bg event_about pt_lrg pb_lrg\" aria-label=\"About Event\" id=\"about\">\n        <div class=\"event_about__row mw_1200\">\n\n            \n                <div class=\"event_about__details green_bg\"> <!-- Details -->\n                    <p class=\"h3 dark\">Details</p>\n\n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Venue</p>\n                            <p class=\"row_value\">Studio</p>\n                        </div>\n                    \n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Dates</p>\n                        <p class=\"row_value\">\n                                                                                                                                                                                <p class=\"few_dates\">17 Jul, 18 Jul</p>\n                                                    </p>\n                    </div>\n\n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Running time</p>\n                            <p class=\"row_value\">\n                                1 hour                                                            </p>\n                        </div>\n                    \n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Age Guidance</p>\n                            <p class=\"row_value\">14+</p>\n                        </div>\n                    \n                     <!-- / Button Repeater -->\n\n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Price</p>\n                        <p class=\"row_value\">\n                                                            £10.00 to £20.00                                                    </p>\n                    </div>\n\n                </div> <!-- / Details -->\n\n            \n            <div class=\"event_about__desc\">\n                <p class=\"h2\">About</p>\n                <div id=\"\"></div>\n<div>In a pursuit of better understanding her father, Riwa finds a letter he sent to his own late dad. With this discovery, she unlocks a quest that travels through timelines and across conversations with family members, piecing together a puzzle around personal and shared histories.</div>\n<div></div>\n<div>Pulling in puppetry, silhouettes, and verbatim audio, How I Grew a Moustache explores how grief and silence travel across generations, and what it means to inherit stories that are left untold. At its heart, the work asks how diasporic families carry love, loss and memory across time.</div>\n<div></div>\n<div></div>\n\n            </div>\n\n        </div>\n\n                    <div class=\"mw_1200 event_about__desc_extra\">\n                <p class=\"small\">\n                    Developed with Artsadmin, with support from Arts Council England, Counterpoints Arts, Guildhall School of Music &amp; Drama and Shubbak.                </p>\n            </section>\n\n    \r\n\r\n\r\n<section\r\n  aria-label=\"Creatives\"id=\"Crestives\"  class=\"full_content team-listing light_bg pt_sm pb_sm\"\r\n> <!-- Full Content -->\r\n\r\n  <div class=\"mw_1200 no_text_center\"> <!-- MW -->\r\n\r\n    <p class=\"h2\">Creatives</p><div class=\"team-listing__spacer\" ></div>\r\n    \r\n    \r\n    \r\n              <ul class=\"team-listing__minimal-grid\" > <!-- Minimal Grid -->\r\n                      <li>\r\n              <a href=\"#team-listing-item-15973\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Riwa Saab</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Writer &amp; Performer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15973\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Riwa Saab</p>\r\n                                          <p class=\"h5\" >Writer &amp; Performer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Riwa</strong> is a theatre-maker, sound designer, poet and puppeteer. With her hands in different writing/composing and performance disciplines, she works in both creative and backstage capacities. Her art puts people and our relationships at the centre of the political narratives we inhabit, with recent explorations including the unpacking of generational and familial baggage, and the politics of pop princesses.</p>\n<p>She has assistant directed on a number of noteworthy theatre productions, including <em>You Bury Me</em> (Orange Tree/Bristol Old Vic/Edinburgh Lyceum) and <em>Nowhere</em> (Battersea Arts Centre). Among others, her sound design has scored productions at the Bush, Regent’s Park Open Air, and Soho, as well as for podcasts and short films, including <em>Sugar Shots</em>. An alumnus of the Barbican Young Poets collective and a Roundhouse Slam Finalist, her poetry has been published in <em>And Other Poems</em>, <em>Rusted Radishes</em>, and <em>Sukoon</em> magazine.</p>\n<p>As a puppeteer, she has trained at the Curious School of Puppetry.</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-16043\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Jemima Yong</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Puppetry Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-16043\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Jemima Yong</p>\r\n                                          <p class=\"h5\" >Puppetry Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Jemima</strong> is an award-winning artist working in live performance, photography and publishing. Uninterested in creating anything she can imagine on her own, she works exclusively in collaboration with others. Some of her current interests include voice in performance, archiving as an act of alternative political story-making and non-human animal perception.</p>\n<p>Jemima is part of the team at Curious School of Puppetry and Creative Director of the Kneehigh Legacy Project. She is interested in artist leadership and collective models of organising, and has collaborated with artists including <strong>Alan Fielden</strong>, <strong>Karen Christopher</strong> and <strong>Tara Fatehi</strong>. Alongside <strong>Anahí Saravia Herrera</strong> and <strong>Anna Corfa</strong>, she stewards slow+dirty press at House of Annetta, a centre for learning about the ways ownership of land shapes our lives and the world around us.</p>\n<p>Recent works include <em>Container; Skywater</em>; <em>Facewater</em>; <em>Underwater Waltz</em> and the photographic series <em>Field</em> (2020), which will soon be on permanent display at London Museum.</p>\n<p>&nbsp;</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-16041\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Mallika Joy</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Puppeteer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-16041\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Mallika Joy</p>\r\n                                          <p class=\"h5\" >Puppeteer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Mallika</strong> is a South London-based puppeteer, artist and facilitator working across puppetry, performance, installation and participatory arts.</p>\n<p>A graduate of Central Saint Martins with First Class Honours in Performance: Design and Practice, they recently received an Arts Council England Developing Your Creative Practice award to expand their interdisciplinary practice. Alongside their work as a freelance puppet maker, performer and workshop facilitator with Little Angel Theatre, Mallika has performed and exhibited work in theatres, galleries, festivals and public spaces across the UK. Their training includes Curious School of Puppetry, Ghost River Theatre, Kneehigh and TamTam.</p>\n<p>As Co-creative Director of Pure Imagination Collective, they produce experimental cabaret, puppetry and community-focused events that champion collaboration and collective imagination. Their facilitation work spans organisations including DreamArts, Les Enfants Terribles, Smoking Apples Theatre and Wild Rumpus.</p>\n<p>Mallika&#8217;s practice explores contemporary folklore, ecology, collective storytelling and the transformative potential of objects, materials and live performance.</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                  </ul> <!-- / Minimal Grid -->\r\n      \r\n    \r\n  </div> <!-- / MW -->\r\n\r\n</section> <!-- / Full Content -->\n                        <section class=\"full_content light_bg show pt_lrg pb_lrg\" aria-label=\"Book Tickets\" id=\"book\">\n                <div class=\"mw_1200\">\n                    <p class=\"h2\">Book tickets</p>\n\n\n                        \n                    \n                    <div class=\"instance_table\"> <!-- Instance Table -->\n\n                        \n                            \n                            <div class=\"instance_table__row\" data-filter=\"\"> <!-- Instance Table Row -->\n                                <div class=\"instance_table__col instance_table__col--date\"><time>Fri 17 July</time></div>\n                                <div class=\"instance_table__col instance_table__col--time\"><time>8:00pm</time></div>\n\n                                                                    <div class=\"instance_table__col instance_table__col--price\">&pound;10.00 to &pound;20.00</div>\n                                \n                                <div class=\"instance_table__col\">\n                                    <div class=\"icon_holder\">\n                                                                                                                                                            </div>\n                                </div>\n\n                                <div class=\"instance_table__col instance_table__col--book\">\n\n                                                                                                                \n                                                                                                                                                                                        <a href=\"https://www.bushtheatre.co.uk/book/?show=319532ABCLTMNCMKDMJMCSNTLPCNBCNQL\"\n                                        class=\"btn btn_no_arrow\">Book now</a>\n                                    \n                                </div>\n\n                            </div> <!-- / Show Row -->\n\n                        \n                            \n                            <div class=\"instance_table__row\" data-filter=\"\"> <!-- Instance Table Row -->\n                                <div class=\"instance_table__col instance_table__col--date\"><time>Sat 18 July</time></div>\n                                <div class=\"instance_table__col instance_table__col--time\"><time>8:00pm</time></div>\n\n                