nu -->\n\t\t\t\t\t\t\t\t\t<a href=\"#menu-popout\" class=\"subnav__menu-hamburger toggleButton\" aria-controls=\"navigation\" aria-expanded=\"false\" aria-haspopup=\"true\" ><img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" /></a>\n\t\t\t\t\t\t\t\t</div> <!-- / Menu -->\n\t\t\t\t\t\t\t</div> <!-- / Sub Nav -->\n\n\t\t\t\t\t\t</div> <!-- / Main Nav -->\n\n\t\t\t\t\t\t<div class=\"nav_icon\"><!-- Nav Icon -->\n\t\t\t\t\t\t\t<a href=\"#mobile-navigation\">\n\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" />\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div> <!-- / Nav Icon -->\n\n\t\t\t\t\t</div> <!-- / Nav Wrapper -->\n\n\t\t\t\t\t\n\t\t\t\t\t</div> <!-- / Logo Nav Holder -->\n\n\t\t\t\t</div> <!-- / Max Width -->\n\t\t\t</div> <!-- / Full Content -->\n\n\t\t</header><!-- #masthead -->\n\n\t\t<div id=\"content\" class=\"site-content\">\n\n\t\t<div id=\"primary\" class=\"content-area event\">\n    <main id=\"main\" class=\"site-main\">\n\n    \n        \n<section class=\"event_header\"> <!-- Event Header -->\n        <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/BushTheatre_TheHungryGhost_Website_1920x1080px_V3.jpg\" alt=\"An east Asian woman looks directly at the camera with her tongue out. The image is sliced and repeated so her tongue appears really long.\" class=\"event_header__image event_header__image--center\">\n            <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/BushTheatre_TheHungryGhost_Website_1200x1900px.jpg\" alt=\"An east Asian woman looks directly at the camera with her tongue out. The image is sliced and repeated so her tongue appears really long.\" class=\"event_header__image event_header__image--center show_mob\">\n    \n    <div class=\"event_header__intro\"> <!-- Event Intro -->\n        <div class=\"event_header__intro_holder\">\n            <div class=\"event_header__intro_text\">\n                <h1 class=\"alt_heading\">The Hungry Ghost</h1>\n\n                                    <p>by Mei Leng Yew</p>\n                \n                                    <p class=\"event_header__date\">\n                                                                                                                                                                                                                                                            \n                                                                    <p>1 Oct to 31 Oct</p>\n                                \n                            \n                                                                            <p>Studio</p>\n                                            </p>\n                            </div>\n\n            <div class=\"event_header__intro_btn\">\n                                                                                                                                                <a href=\"#book\" class=\"btn\">Book tickets</a>\n                                                                        </div>\n        </div>\n    </div> <!-- / Event Intro -->\n\n</section> <!-- / Event Header -->\n\n<div class=\"event_nav\"> <!-- Event Nav -->\n    <div class=\"event_nav__width\">\n        <div class=\"event_nav__anchors\">\n            <a href=\"#about\" class=\"event_nav__item\">About</a>\n            <a href=\"#Cast &amp; Creatives\" class=\"event_nav__item\">Cast &amp; Creatives</a>\n        </div>\n                    <div class=\"event_nav__book\">\n                                    <a href=\"#book\" class=\"event_nav__item--book btn small btn_no_arrow\">Book tickets</a>\n                            </div>\n            </div>\n</div> <!-- / Event Header -->\n\n<div class=\"event_internal\">\n    <section class=\"full_content dark_bg event_about pt_lrg pb_lrg\" aria-label=\"About Event\" id=\"about\">\n        <div class=\"event_about__row mw_1200\">\n\n            \n                <div class=\"event_about__details green_bg\"> <!-- Details -->\n                    <p class=\"h3 dark\">Details</p>\n\n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Venue</p>\n                            <p class=\"row_value\">Studio</p>\n                        </div>\n                    \n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Dates</p>\n                        <p class=\"row_value\">\n                                                                                                                                                \n                                                                    <p>1 Oct to 31 Oct</p>\n                                                                                    </p>\n                    </div>\n\n                    \n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Age Guidance</p>\n                            <p class=\"row_value\">16+</p>\n                        </div>\n                    \n                     <!-- Button Repeater -->\n                        <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Content Guidance</p>\n                            <div class=\"btns_container\">\n                                                                                                        <a class=\"btn small\" href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/The-Hungry-Ghost-self-care-guide.pdf\" target=\"_blank\">Self-care guide &amp; content warnings</a>\n                                    \n                                                            </div>\n                        </div>\n                     <!-- / Button Repeater -->\n\n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Price</p>\n                        <p class=\"row_value\">\n                                                            £15.00 to £25.00                                                    </p>\n                    </div>\n\n                </div> <!-- / Details -->\n\n            \n            <div class=\"event_about__desc\">\n                <p class=\"h2\">About</p>\n                <div id=\"\">\n<p><em><strong>“I feel like a newborn out in the world for the first time. I feel… ravenous.”</strong></em></p>\n<p>Tonight’s the night. She’s got a plan. And it involves her (secret) girlfriend, and the house they&#8217;re about to move into together.</p>\n<p>And it doesn’t matter to her that her mum warns tonight is the first night of the ghost month. Because parents will say anything to keep you home.</p>\n<p>Swiping an orange from the family altar and pocketing a coin she finds on her way over to the new place, she steps through the doorway &#8211; and unwittingly invites a hungry ghost into both of their lives. As the ghost starts to take over and she wrestles for control of her own body, her carefully constructed house of lies comes tumbling down around her.</p>\n<p>A sexy horror rom-com exploring what takes root in the space between superstition and rationality. Starring Olivier Award nominee <strong>Mei Mac</strong>, <em>The Hungry Ghost</em> is the debut play from <strong>Mei Leng Yew</strong>, directed by New Earth Theatre Artistic Director <strong>Ailin Conant</strong>.</p>\n<p><em>(Further casting to be announced)</em></p>\n</div>\n\n            </div>\n\n        </div>\n\n                    <div class=\"mw_1200 event_about__desc_extra\">\n                <p class=\"small\">\n                    Presented by New Earth Theatre in association with Bush Theatre.                </p>\n            </section>\n\n    \r\n\r\n\r\n<section\r\n  aria-label=\"Cast &#038; Creatives\"id=\"Cast &#038; Creatives\"  class=\"full_content team-listing white_bg pt_lrg pb_sm\"\r\n> <!-- Full Content -->\r\n\r\n  <div class=\"mw_1200 no_text_center\"> <!-- MW -->\r\n\r\n    <p class=\"h2\">Cast &#038; Creatives</p><div class=\"team-listing__spacer\" ></div>\r\n    \r\n    \r\n    \r\n              <ul class=\"team-listing__grid horizontal\" > <!-- Grid -->\r\n                      <li class=\"team-listing__post horizontal\" > <!-- Post -->\r\n                                  <div class=\"team-listing__post-image horizontal\" > <!-- Image Container -->\r\n                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Mei-Mac-Headshot-320x480.jpg\" alt=\"\" />\r\n                  </div> <!-- / Image Container -->\r\n                                <div class=\"team-listing__post-info\" > <!-- Info Container -->\r\n                  <div>\r\n                    <div class=\"heading\" >\r\n                      <p class=\"title\" >Mei Mac</p>\r\n                                              <p>The Girl</p>\r\n                                          </div>\r\n                                          <p class=\"small_text\" >Mei is an Olivier Award nominee for Best Actress in a Play and WhatsOnStage Award nominee for Best Performer in a Play. Theatre Includes: Dracula (Lyric Hammersmith); My Neighbour Totoro&hellip;</p>\r\n                                      </div>\r\n                  <div>\r\n                    <a href=\"#team-listing-item-15359\" class=\"link alt team-listing__popup-link\" >Read More</a>\r\n\r\n                    <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15359\" > <!-- Pop-up -->\r\n                      <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                        <span>X</span>\r\n                      </button>\r\n                      <div class=\"team-listing__popup-content horizontal\" > <!-- Content -->\r\n                                                  <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                            <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Mei-Mac-Headshot-320x480.jpg\" alt=\"\" />\r\n                          </div> <!-- / Image Container -->\r\n                                                <p class=\"h3\" >Mei Mac</p>\r\n                                                  <p class=\"h5\" >The Girl</p>\r\n                                                <div class=\"divider\" ></div>\r\n                                                  <p><strong>Mei</strong> is an Olivier Award nominee for Best Actress in a Play and WhatsOnStage Award nominee for Best Performer in a Play.</p>\n<p>Theatre Includes: <em>Dracula</em> (Lyric Hammersmith);<em> My Neighbour Totoro</em> (Barbican &amp; RSC),<em> Untitled F*ck M*ss S**gon Play</em> (Manchester Royal Exchange, Young Vic);<em> Dear Elizabeth</em> (Gate);<em> Five Plays &#8211; Tongue</em> (Young Vic);<em> The Lion, The Witch and the Wardrobe</em> (Bridge);<em> A Midsummer Night’s Dream</em> (Regent’s Park);<em> Under the Umbrella, The BFG</em> (Birmingham Rep);<em> Jackie the Baboon</em> (Brunskill and Grimes);<em> Romeo and Juliet</em> (Papergang);<em> Summer Times</em> (West Yorkshire Playhouse); <em>Peter Pan in Scarlet</em> (Oxford Playhouse / New Vic);<em> Snow Child</em> (International Tour / York Theatre Royal);<em> If The Lights Are Too Bright</em> (Ovalhouse); <em>Princess Mononoke</em> (International Tour/ AiiA Theater Tokyo/ Whole Hog Theatre); <em>Wild Swans</em> (Young Vic/American Repertory Theater)</p>\n<p>TV Includes: <em>War</em> (HBO),<em> The War Between the Land and the Sea</em> (Disney+ / BBC),<em> Blue Lights</em> (BBC),<em> Horrible Science</em> (BBC), <em>East Mode</em> (Comedy Central),<em> Call the Midwife</em> (BBC)</p>\n<p>Film Includes: <em>Sacrifice, My Country</em></p>\n                                                <div class=\"clear\"></div>\r\n                      </div> <!-- / Content -->\r\n                    </div> <!-- / Pop-up -->\r\n\r\n                  </div>\r\n                </div> <!-- / Info Container -->\r\n            </li> <!-- / Post -->\r\n                  </ul>\r\n      \r\n    \r\n  </div> <!-- / MW -->\r\n\r\n</section> <!-- / Full Content -->\n\n\r\n\r\n\r\n<section\r\n    class=\"full_content team-listing white_bg pt_none pb_md\"\r\n> <!-- Full Content -->\r\n\r\n  <div class=\"mw_1200 no_text_center\"> <!-- MW -->\r\n\r\n    <div class=\"team-listing__spacer\" ></div>\r\n    \r\n    \r\n    \r\n              <ul class=\"team-listing__minimal-grid\" > <!-- Minimal Grid -->\r\n                      <li>\r\n              <a href=\"#team-listing-item-15361\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Mei Leng Yew</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Writer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15361\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Mei Leng Yew</p>\r\n                                          <p class=\"h5\" >Writer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Mei Leng Yew</strong> is British writer of Malaysian-Chinese heritage. She is passionate about stories that are set in unique, highly personal worlds with characters who find joy in unusual places.</p>\n<p>In 2025, was shortlisted for the Women’s Play for Playwriting in 2025 for her play Down Side Up. Her short film Safiyah Flies Across the Ocean was funded by Film London and subsequently screened at BAFTA-qualifying film festivals.</p>\n<p>She is an alumni of the Soho Theatre Writers’ Lab, the Royal Court Intro to Playwriting Group and New Earth Theatre’s Writers Plus Academy. She is also a trustee for MAMA Youth Project, a charity that empowers diverse young people to work in Film &amp; TV.</p>\n<p>&nbsp;</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15363\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Ailin Conant</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15363\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Ailin Conant</p>\r\n                                          <p class=\"h5\" >Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Ailin</strong> is the Artistic Director of New Earth. Prior to this role, she was founding artistic director of Theatre Témoin, with commissions from The Lowry, The Everyman Cheltenham, and Without Walls, and productions in Rwanda, Israel, Kashmir, Lebanon, France, and the USA.</p>\n<p>As a freelancer, Ailin is Senior Associate Director on <em>My Neighbour Totoro</em> with the RSC and Improbable, and has previously worked for the The Royal Court, Bush Theatre, Theatre503, Kansas City Rep (USA), Ayyam Al-Masrah (Gaza), Clown Me In (Lebanon), and The Catalyst (Switzerland).</p>\n<p>As a twice-migrant and dual-heritage nomad, Ailin is passionate about cross-cultural and intercultural creative exchange, and is a board member of Projekt Europa.</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15367\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>New Earth Theatre</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Producer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15367\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >New Earth Theatre</p>\r\n                                          <p class=\"h5\" >Producer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\">Founded in 1995, <strong>New Earth Theatre</strong> (formerly Yellow Earth) is the UK&#8217;s leading BESEA (British East and Southeast Asian) theatre company and a National Portfolio Organisation of Arts Council England. Under new Artistic Director Ailin Conant, the company has expanded its creative partnerships, co-commissioning and developing new work with Headlong, Shakespeare&#8217;s Globe, Feng Ling, Liverpool Everyman and Playhouse, and Zoo Co, while investing in the freelance ecology through seed commissions for ten companies representing over 50 BESEA artists. </span></p>\n<p><i><span style=\"font-weight: 400\">The Hungry Ghost</span></i><span style=\"font-weight: 400\"> is New Earth&#8217;s first full production under Ailin&#8217;s leadership.</span><span style=\"font-weight: 400\"> </span></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15854\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Yimei Zhao</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Set &amp; Costume Designer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15854\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Yimei Zhao</p>\r\n                                          <p class=\"h5\" >Set &amp; Costume Designer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><b>Yimei Zhao</b> is a set and costume designer based in London. She graduated from the Royal Central School of Speech and Drama with a first class in Design for Performance. She is one of the 2023 Linbury Prize winners and she was also a resident design assistant at the National Theatre Design Studio in 2024.</p>\n<p>As Designer: <em>Porn Play</em> (Royal Court); <em>THE HEAT</em> (Sadler&#8217;s Wells, The Lowry, South East Dance); <em>The Society For New Cuisine</em> (Omnibus Theatre); <em>Before After</em> (Southwark Playhouse).</p>\n<p>As Associate Designer: <em>The Hot Wing King</em> (National Theatre); <em>Bengal Tiger at the Baghdad Zoo</em> (Young Vic).</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                  </ul> <!-- / Minimal Grid -->\r\n      \r\n    \r\n  </div> <!-- / MW -->\r\n\r\n</section> <!-- / Full Content -->\n                        <section class=\"full_content light_bg show pt_lrg pb_lrg\" aria-label=\"Book Tickets\" id=\"book\">\n                <div class=\"mw_1200\">\n                    <p class=\"h2\">Book tickets</p>\n\n\n                        \n                                            <div class=\"event_filter\">\n                            <div class=\"event_filter__container\">\n                                <p class=\"h4\">Filter events:</p>\n                                <div class=\"event_filter__buttons\">\n                                    <a href=\"#\" class=\"event_filter__item\" id=\"filter_all\" data-filter=\"\">All</a>\n                                    <a href=\"#\" class=\"event_filter__item preview\" data-filter=\"preview\">Preview</a><a href=\"#\" class=\"event_filter__item press_night\" data-filter=\"press_night\">Press Night</a><a href=\"#\" class=\"event_filter__item matinee\" data-filter=\"matinee\">Matinee</a><a href=\"#\" class=\"event_filter__item chilled\" data-filter=\"chilled\">Chilled Performance</a><a href=\"#\" class=\"event_filter__item captioned\" data-filter=\"captioned\">Captioned Performance</a><a href=\"#\" class=\"event_filter__item audio_described\" data-filter=\"audio_described\">Audio Described</a>                                </div>\n                            </div>\n                        </div>\n                    \n                    <div class=\"instance_table\"> <!-- Instance Table -->\n\n                        \n                            \n                            <div class=\"instance_table__row\" data-filter=\"preview\"> <!-- Instance Table Row -->\n                                <div class=\"instance_table__col instance_table__col--date\"><time>Thu 1 October</time></div>\n                                <div class=\"instance_table__col instance_table__col--time\"><time>8:00pm</time></div>\n\n                                                                    \n                                \n                                <div class=\"instance_table__col\">\n                                    <div class=\"icon_holder\">\n                                                                                                                                                                                                                    <span data-tooltip=\"Preview\">\n                                                    <img class=\"icon\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images