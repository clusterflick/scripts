search.svg\" alt=\"search icon\" />\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t</div> <!-- / Site Search Icon -->\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div> <!-- / Links -->\n\t\t\t\t\t\t\t\t<div class=\"subnav__menu\"  > <!-- Menu -->\n\t\t\t\t\t\t\t\t\t<a href=\"#menu-popout\" class=\"subnav__menu-hamburger toggleButton\" aria-controls=\"navigation\" aria-expanded=\"false\" aria-haspopup=\"true\" ><img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" /></a>\n\t\t\t\t\t\t\t\t</div> <!-- / Menu -->\n\t\t\t\t\t\t\t</div> <!-- / Sub Nav -->\n\n\t\t\t\t\t\t</div> <!-- / Main Nav -->\n\n\t\t\t\t\t\t<div class=\"nav_icon\"><!-- Nav Icon -->\n\t\t\t\t\t\t\t<a href=\"#mobile-navigation\">\n\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" />\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div> <!-- / Nav Icon -->\n\n\t\t\t\t\t</div> <!-- / Nav Wrapper -->\n\n\t\t\t\t\t\n\t\t\t\t\t</div> <!-- / Logo Nav Holder -->\n\n\t\t\t\t</div> <!-- / Max Width -->\n\t\t\t</div> <!-- / Full Content -->\n\n\t\t</header><!-- #masthead -->\n\n\t\t<div id=\"content\" class=\"site-content\">\n\n\t\t<div id=\"primary\" class=\"content-area event\">\n    <main id=\"main\" class=\"site-main\">\n\n    \n        \n<section class=\"event_header\"> <!-- Event Header -->\n        <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/before-we-forget-web-1.png\" alt=\"\" class=\"event_header__image event_header__image--center\">\n            <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/BushTheatre_BeforeWeForget_Website_1200x1900px.jpg\" alt=\"\" class=\"event_header__image event_header__image--center show_mob\">\n    \n    <div class=\"event_header__intro\"> <!-- Event Intro -->\n        <div class=\"event_header__intro_holder\">\n            <div class=\"event_header__intro_text\">\n                <h1 class=\"alt_heading\">Before We Forget</h1>\n\n                                    <p>Created by the 18-25 Bush Young Company and Amber Ruby</p>\n                \n                                    <p class=\"event_header__date\">\n                                                                                                                                                                                                                                                            \n                                                                    <p>18 Aug to 22 Aug</p>\n                                \n                            \n                                                                            <p>Holloway Theatre (Bush Theatre's Main Space)</p>\n                                            </p>\n                            </div>\n\n            <div class=\"event_header__intro_btn\">\n                                                                                                                                                <a href=\"#book\" class=\"btn\">Book tickets</a>\n                                                                        </div>\n        </div>\n    </div> <!-- / Event Intro -->\n\n</section> <!-- / Event Header -->\n\n<div class=\"event_nav\"> <!-- Event Nav -->\n    <div class=\"event_nav__width\">\n        <div class=\"event_nav__anchors\">\n            <a href=\"#about\" class=\"event_nav__item\">About</a>\n            <a href=\"#Creative team\" class=\"event_nav__item\">Creative team</a>\n        </div>\n                    <div class=\"event_nav__book\">\n                                    <a href=\"#book\" class=\"event_nav__item--book btn small btn_no_arrow\">Book tickets</a>\n                            </div>\n            </div>\n</div> <!-- / Event Header -->\n\n<div class=\"event_internal\">\n    <section class=\"full_content dark_bg event_about pt_lrg pb_lrg\" aria-label=\"About Event\" id=\"about\">\n        <div class=\"event_about__row mw_1200\">\n\n            \n                <div class=\"event_about__details green_bg\"> <!-- Details -->\n                    <p class=\"h3 dark\">Details</p>\n\n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Venue</p>\n                            <p class=\"row_value\">Holloway Theatre (Bush Theatre's Main Space)</p>\n                        </div>\n                    \n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Dates</p>\n                        <p class=\"row_value\">\n                                                                                                                                                \n                                                                    <p>18 Aug to 22 Aug</p>\n                                                                                    </p>\n                    </div>\n\n                    \n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Age Guidance</p>\n                            <p class=\"row_value\">12+</p>\n                        </div>\n                    \n                     <!-- / Button Repeater -->\n\n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Price</p>\n                        <p class=\"row_value\">\n                                                            £2.50 to £30.00                                                    </p>\n                    </div>\n\n                </div> <!-- / Details -->\n\n            \n            <div class=\"event_about__desc\">\n                <p class=\"h2\">About</p>\n                <div id=\"\">\n<p><b><i>What would you give to remember?<br />\n</i></b><b><i>What parts of us are already forgotten? </i></b></p>\n<p><span style=\"font-weight: 400\">On the brink of a data collapse, a group of friends has to decide how to keep hold of their memories. With new data centres taking over, and the whole system becoming increasingly monetised, they must decide what parts of their humanity are worth saving.</span></p>\n<p><span style=\"font-weight: 400\">An urgent new piece from our celebrated </span><b>18-25 Young Company</b><span style=\"font-weight: 400\"> that asks how we prepare for impending change. </span><i><span style=\"font-weight: 400\">Before We Forget </span></i><span style=\"font-weight: 400\">is a celebration of what makes us human in an increasingly virtual world, created by the company and directed by </span><b>Amber Ruby.</b></p>\n<p><span style=\"font-weight: 400\">The 18-25 Bush Young Company is a training ground for some of the most exciting new talent in the theatre industry. Previous members have gone on to work at companies including the RSC, Almeida and the Royal Court, and have plays commissioned by the Bush Theatre.</span></p>\n</div>\n\n            </div>\n\n        </div>\n\n                    <div class=\"mw_1200 event_about__desc_extra\">\n                <p class=\"small\">\n                    A Bush Theatre Community production from the 18 - 25 Young Company. Bush Young Company is generously supported by John Lyon's Charity and Buffini Chao Foundation.                </p>\n            </section>\n\n    \r\n\r\n\r\n<section\r\n  aria-label=\"Creative team\"id=\"Creative team\"  class=\"full_content team-listing white_bg pt_lrg pb_lrg\"\r\n> <!-- Full Content -->\r\n\r\n  <div class=\"mw_1200 no_text_center\"> <!-- MW -->\r\n\r\n    <p class=\"h2\">Creative team</p><div class=\"team-listing__spacer\" ></div>\r\n    \r\n    \r\n    \r\n              <ul class=\"team-listing__minimal-grid\" > <!-- Minimal Grid -->\r\n                      <li>\r\n              <a href=\"#team-listing-item-15260\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Amber Ruby</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15260\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Amber Ruby</p>\r\n                                          <p class=\"h5\" >Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Amber Ruby</strong> is a participatory theatre-maker whose practice centres young people, collaboration, and theatre as a place of agency, care, and joy.</p>\n<p>They are currently Resident Director on <em>Dracula</em> at the Noël Coward Theatre. They were previously Resident Director on the UK and International Tour of <em>Six The Musical</em> and an Associate Artist at Company Three.</p>\n<p>As Associate / Assistant Director, their work includes: <em>Witness for the Prosecution</em> (County Hall, West End); <em>Alice in Wonderland</em> (Brixton House); <em>Red Pitch</em> (Soho Place); <em>When This Is Over</em> (Company Three, The Yard); <em>Groove</em> (Shoreditch Town Hall); <em>Black Is</em> (Company Three, New Diorama); and <em>Athena</em> (The Yard).</p>\n<p>As Director, their work includes: <em>Grow Up</em> (Company Three, Park);<em> The Body Remembers</em> (The Albany); and <em>Spores</em> (BRIT School / New Diorama).</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                  </ul> <!-- / Minimal Grid -->\r\n      \r\n    \r\n  </div> <!-- / MW -->\r\n\r\n</section> <!-- / Full Content -->\n                        <section class=\"full_content light_bg show pt_lrg pb_lrg\" aria-label=\"Book Tickets\" id=\"book\">\n                <div class=\"mw_1200\">\n                    <p class=\"h2\">Book tickets</p>\n\n\n                        \n                                            <div class=\"event_filter\">\n                            <div class=\"event_filter__container\">\n                                <p class=\"h4\">Filter events:</p>\n                                <div class=\"event_filter__buttons\">\n                                    <a href=\"#\" class=\"event_filter__item\" id=\"filter_all\" data-filter=\"\">All</a>\n                                    <a href=\"#\" class=\"event_filter__item preview\" data-filter=\"preview\">Preview</a><a href=\"#\" class=\"event_filter__item press_night\" data-filter=\"press_night\">Press Night</a>                                </div>\n                            </div>\n                        </div>\n                    \n                    <div class=\"instance_table\"> <!-- Instance Table -->\n\n                        \n                            \n                            <div class=\"instance_table__row\" data-filter=\"preview\"> <!-- Instance Table Row -->\n                                <div class=\"instance_table__col instance_table__col--date\"><time>Tue 18 August</time></div>\n                                <div class=\"instance_table__col instance_table__col--time\"><time>7:30pm</time></div>\n\n                                                                    <div class=\"instance_table__col instance_table__col--price\">&pound;5.00 to &pound;30.00</div>\n                          