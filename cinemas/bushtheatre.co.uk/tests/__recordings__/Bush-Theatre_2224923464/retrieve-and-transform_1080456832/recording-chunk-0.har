purple_border\">\n                                    <!-- Text Quote -->\n                                    &#8220;A time-travel love story with thermonuclear charisma&#8221;                                </blockquote>\n                            \n                                                            <p class=\"testimonial-block__text-author\">\n                                    <!-- Text Author -->\n                                    &#8211; The Times                                </p>\n                                                    </div>\n                    </div>\n                </div>\n                        </div><!-- .testimonial-block__slider -->\n</section>\n\n                \n            <section aria-label=\"Related Articles\" id=\"relatedArticles\">\n            <div class=\"news-single__related full_content pt_lrg pb_lrg white_bg\" > <!-- / Related -->\n                <div class=\"mw_1200\" >\n                    <p class=\"h2\" >Related articles</p>\n                    <ul class=\"news-listing__listing-container\" >\n                                                                                    <li class=\"news-listing__post\" > <!-- Post -->\n                                    <a href=\"https://www.bushtheatre.co.uk/news/shifting-the-narrative-radical-love-commissions/\" class=\"red_bg\" >\n                                                                                    <div class=\"news-listing__post-image\" > <!-- Image -->\n                                                <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2025/03/Shifters-PROD-5957-Enhanced-NR-scaled-1-900x600.jpg\" alt=\"\" />\n                                            </div> <!-- / Image -->\n                                                                                <div class=\"news-listing__post-info\" > <!-- Info -->\n                                            <div>\n                                                <p class=\"date\" >28 Aug 2024</p>\n                                                <h2 class=\"h3\" >Shifting the Narrative: Radical Love Commissions</h2>\n                                                                                                    <ul class=\"categories\" >\n                                                                                                                    <li>Our Plays</li>\n                                                                                                                    <li>Playwriting</li>\n                                                                                                            </ul>\n                                                                                            </div>\n                                            <div class=\"news-listing__arrow\" >\n                                                <img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" class=\"arrow\" />\n                                            </div>\n                                        </div> <!-- / Info -->\n                                    </a>\n                                </li> <!-- / Post -->\n                                                            <li class=\"news-listing__post\" > <!-- Post -->\n                                    <a href=\"https://www.bushtheatre.co.uk/news/charles-holloway-obe-from-west-london-to-the-west-end/\" class=\"cyan_bg\" >\n                                                                                    <div class=\"news-listing__post-image\" > <!-- Image -->\n                                                <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2025/03/Charles-Holloway-1-scaled-1-900x600.jpg\" alt=\"\" />\n                                            </div> <!-- / Image -->\n                                                                                <div class=\"news-listing__post-info\" > <!-- Info -->\n                                            <div>\n                                                <p class=\"date\" >31 Oct 2024</p>\n                                                <h2 class=\"h3\" >Charles Holloway OBE: From West London to the West End</h2>\n                                                                                                    <ul class=\"categories\" >\n                                                                                                                    <li>Uncategorized</li>\n                                                                                                            </ul>\n                                                                                            </div>\n                                            <div class=\"news-listing__arrow\" >\n                                                <img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" class=\"arrow\" />\n                                            </div>\n                                        </div> <!-- / Info -->\n                                    </a>\n                                </li> <!-- / Post -->\n                                                            <li class=\"news-listing__post\" > <!-- Post -->\n                                    <a href=\"https://www.bushtheatre.co.uk/news/in-celebration-of-benedict-lombe/\" class=\"yellow_bg\" >\n                                                                                    <div class=\"news-listing__post-image\" > <!-- Image -->\n                                                <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2025/03/FQI-DB3WQAQg7Rv-scaled-1-900x600.jpg\" alt=\"\" />\n                                            </div> <!-- / Image -->\n                                                                                <div class=\"news-listing__post-info\" >