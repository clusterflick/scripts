t\t\t<span class=\"gdpr-icon moovegdpr-arrow-close\"></span>\n\t\t</button>\n\t\t\t\t<div class=\"moove-gdpr-modal-left-content\">\n\t\t\n<div class=\"moove-gdpr-company-logo-holder\">\n\t<img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2025/03/bush2022-logo-vector-green-300x50.png\" alt=\"Bush Theatre. Green text logo.\"   width=\"300\"  height=\"50\"  class=\"img-responsive\" />\n</div>\n<!--  .moove-gdpr-company-logo-holder -->\n\t\t<ul id=\"moove-gdpr-menu\">\n\t\t\t\n<li class=\"menu-item-on menu-item-privacy_overview menu-item-selected\">\n\t<button data-href=\"#privacy_overview\" class=\"moove-gdpr-tab-nav\" aria-label=\"Privacy Overview\">\n\t<span class=\"gdpr-nav-tab-title\">Privacy Overview</span>\n\t</button>\n</li>\n\n\t<li class=\"menu-item-strict-necessary-cookies menu-item-off\">\n\t<button data-href=\"#strict-necessary-cookies\" class=\"moove-gdpr-tab-nav\" aria-label=\"Strictly Necessary Cookies\">\n\t\t<span class=\"gdpr-nav-tab-title\">Strictly Necessary Cookies</span>\n\t</button>\n\t</li>\n\n\n\t<li class=\"menu-item-off menu-item-third_party_cookies\">\n\t<button data-href=\"#third_party_cookies\" class=\"moove-gdpr-tab-nav\" aria-label=\"Analytics\">\n\t\t<span class=\"gdpr-nav-tab-title\">Analytics</span>\n\t</button>\n\t</li>\n\n\n\n\t\t</ul>\n\t\t\n<div class=\"moove-gdpr-branding-cnt\">\n\t\t\t<a href=\"https://wordpress.org/plugins/gdpr-cookie-compliance/\" rel=\"noopener noreferrer\" target=\"_blank\" class='moove-gdpr-branding'>Powered by&nbsp; <span>GDPR Cookie Compliance</span></a>\n\t\t</div>\n<!--  .moove-gdpr-branding -->\n\t\t</div>\n\t\t<!--  .moove-gdpr-modal-left-content -->\n\t\t<div class=\"moove-gdpr-modal-right-content\">\n\t\t<div class=\"moove-gdpr-modal-title\">\n\t\t\t \n\t\t</div>\n\t\t<!-- .moove-gdpr-modal-ritle -->\n\t\t<div class=\"main-modal-content\">\n\n\t\t\t<div class=\"moove-gdpr-tab-content\">\n\t\t\t\n<div id=\"privacy_overview\" class=\"moove-gdpr-tab-main\">\n\t\t<span class=\"tab-title\">Priv