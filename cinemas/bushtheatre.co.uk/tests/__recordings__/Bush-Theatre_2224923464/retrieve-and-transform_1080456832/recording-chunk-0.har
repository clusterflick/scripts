ion                                </p>\n                                                    </div>\n                    </div>\n                </div>\n                        </div><!-- .testimonial-block__slider -->\n</section>\n\n\n\r\n\r\n\r\n<section\r\n    class=\"full_content\"\r\n> <!-- Full Content -->\r\n\r\n  \r\n  <div class=\"gallery\"> <!-- Gallery -->\r\n\r\n    \r\n                <ul class=\"gallery__images\">\r\n                          <li>\r\n                <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/05/Shifters-west-end-2.png\" title=\"\">\r\n                  <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/05/Shifters-west-end-2-900x600.png\" alt=\"\" />\r\n                </a>\r\n              </li>\r\n                          <li>\r\n                <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/05/Shifters-west-end-3.png\" title=\"\">\r\n                  <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/05/Shifters-west-end-3-900x600.png\" alt=\"\" />\r\n                </a>\r\n              </li>\r\n                          <li>\r\n                <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/05/Shifters-west-end-9.png\" title=\"\">\r\n                  <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/05/Shifters-west-end-9-900x600.png\" alt=\"\" />\r\n                </a>\r\n              </li>\r\n                          <li>\r\n                <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/05/Shifters-west-end-5.png\" title=\"\">\r\n                  <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/05/Shifters-west-end-5-900x600.png\" alt=\"\" />\r\n                </a>\r\n              </li>\r\n                          <li>\r\n                <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/05/Shifters-wes