v class=\"subnav__menu\"  > <!-- Menu -->\n\t\t\t\t\t\t\t\t\t<a href=\"#menu-popout\" class=\"subnav__menu-hamburger toggleButton\" aria-controls=\"navigation\" aria-expanded=\"false\" aria-haspopup=\"true\" ><img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" /></a>\n\t\t\t\t\t\t\t\t</div> <!-- / Menu -->\n\t\t\t\t\t\t\t</div> <!-- / Sub Nav -->\n\n\t\t\t\t\t\t</div> <!-- / Main Nav -->\n\n\t\t\t\t\t\t<div class=\"nav_icon\"><!-- Nav Icon -->\n\t\t\t\t\t\t\t<a href=\"#mobile-navigation\">\n\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" />\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div> <!-- / Nav Icon -->\n\n\t\t\t\t\t</div> <!-- / Nav Wrapper -->\n\n\t\t\t\t\t\n\t\t\t\t\t</div> <!-- / Logo Nav Holder -->\n\n\t\t\t\t</div> <!-- / Max Width -->\n\t\t\t</div> <!-- / Full Content -->\n\n\t\t</header><!-- #masthead -->\n\n\t\t<div id=\"content\" class=\"site-content\">\n\n\t\t<div id=\"primary\" class=\"content-area event\">\n    <main id=\"main\" class=\"site-main\">\n\n    \n        \n<section class=\"event_header\"> <!-- Event Header -->\n        <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Arab-Film-Club-Turns-6.jpg\" alt=\"\" class=\"event_header__image event_header__image--center\">\n    \n    <div class=\"event_header__intro\"> <!-- Event Intro -->\n        <div class=\"event_header__intro_holder\">\n            <div class=\"event_header__intro_text\">\n                <h1 class=\"alt_heading\">ALT B: Arab Film Club Turns 6</h1>\n\n                                    <p>The Arab Film Club</p>\n                \n                                    <p class=\"event_header__date\">\n                                                                                                                                                                                                                                                                                            <p class=\"few_dates\">\n                                    25 Jul                                </p>\n                            \n                                                                    </p>\n                            </div>\n\n            <div class=\"event_header__intro_btn\">\n                                                                                                                                                <a href=\"#book\" class=\"btn\">Book tickets</a>\n                                                                        </div>\n        </div>\n    </div> <!-- / Event Intro -->\n\n</section> <!-- / Event Header -->\n\n<div class=\"event_nav\"> <!-- Event Nav -->\n    <div class=\"event_nav__width\">\n        <div class=\"event_nav__anchors\">\n            <a href=\"#about\" class=\"event_nav__item\">About</a>\n            \n        </div>\n                    <div class=\"event_nav__book\">\n                                    <a href=\"#book\" class=\"event_nav__item--book btn small btn_no_arrow\">Book tickets</a>\n                            </div>\n            </div>\n</div> <!-- / Event Header -->\n\n<div class=\"event_internal\">\n    <section class=\"full_content dark_bg event_about pt_lrg pb_lrg\" aria-label=\"About Event\" id=\"about\">\n        <div class=\"event_about__row mw_1200\">\n\n            \n                <div class=\"event_about__details green_bg\"> <!-- Details -->\n                    <p class=\"h3 dark\">Details</p>\n\n                    \n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Dates</p>\n                        <p class=\"row_value\">\n                                                                                                                                                                                <p class=\"few_dates\">25 Jul</p>\n                                                    </p>\n                    </div>\n\n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Running time</p>\n                            <p class=\"row_value\">\n                                2 hours                                                            </p>\n                        </div>\n                    \n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Age Guidance</p>\n                            <p class=\"row_value\">14+</p>\n                        </div>\n                    \n                     <!-- / Button Repeater -->\n\n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Price</p>\n                        <p class=\"row_value\">\n                                                                                                20.00                                                                                    </p>\n                    </div>\n\n                </div> <!-- / Details -->\n\n            \n            <div class=\"event_about__desc\">\n                <p class=\"h2\">About</p>\n                <p>The Arab Film Club celebrates 6 years with cake, popcorn and a special screening of short films.</p>\n<p><strong>Programme:</strong></p>\n<p><em><strong>Are You Ok?</strong></em> by <strong>Mo Zediah</strong> (2 minutes)<br />\nA micro short about assimilating into London after arriving from Gaza.</p>\n<p><em><strong>When The Tiles Spoke</strong></em> by <strong>Soudade Kaadan</strong> (15 mins)<br />\nA beautiful fiction blending magical realism and dreamscape, taking viewers on an immersive journey of the historic Arab Hall at Leighton House.</p>\n<p><em><strong>Born A Celebrity</strong></em> by <strong>Luay Awwad</strong> (13 minutes)<br />\nFeeling confined in his small Palestinian town and close-knit community, Kamel embarks on a journey to discover his personal freedom and privacy.</p>\n<p><em><strong>Wooden Hand</strong></em> by <strong>Kaouther Ben Hania</strong> (23 minutes)<br />\n5-year-old Amira does not like Quranic school. In order to avoid going she finds an unstoppable idea that goes beyond her expectations.</p>\n<p>Curated by Sarah Agha.</p>\n<p>After the screening a reception will be held in the Attic for members to mingle.</p>\n\n            </div>\n\n        </div>\n\n            </section>\n\n    \n                        <section class=\"full_content light_bg show pt_lrg pb_lrg\" aria-label=\"Book Tickets\" id=\"book\">\n                <div class=\"mw_1200\">\n                    <p class=\"h2\">Book tickets</p>\n\n\n                        \n                    \n                    <div class=\"instance_table\"> <!-- Instance Table -->\n\n                        \n                            \n                            <div class=\"instance_table__row\" data-filter=\"\"> <!-- Instance Table Row -->\n                                <div class=\"instance_table__col instance_table__col--date\"><time>Sat 25 July</time></div>\n                                <div class=\"instance_table__col instance_table__col--time\"><time>8:00pm</time></div>\n\n                                                                    \n                                \n                                <div class=\"instance_table__col\">\n                                    <div class=\"icon_holder\">\n                                                                                                                                                            </div>\n                                </div>\n\n                                <div class=\"instance_table__col instance_table__col--book\">\n\n                                                                                                                \n                                                                                                                                                                                        <a href=\"https://www.bushtheatre.co.uk/book/?show=319932APQPDQVJDRVPQMCLPMPHHJGBQGR\"\n                                        class=\"btn btn_no_arrow\">Book now</a>\n                                    \n                                </div>\n\n                            </div> <!-- / Show Row -->\n\n                        \n                    </div> <!-- / Instance Table -->\n                </div>\n            </section>\n            \n            <section aria-label=\"Related Articles\" id=\"relatedArticles\">\n            <div class=\"news-single__related full_content pt_lrg pb_lrg white_bg\" > <!-- / Related -->\n                <div class=\"mw_1200\" >\n                    <p class=\"h2\" >Related articles</p>\n                    <ul class=\"news-listing__listing-container\" >\n                                                                                        <li class=\"news-listing__post\" > <!-- Post -->\n                                        <a href=\"https://www.bushtheatre.co.uk/news/it-starts-here-our-artistic-team/\" class=\"purple_bg\" >\n                                                                                            <div class=\"news-listing__post-image\" > <!-- Image -->\n                                                    <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/BUSHARTISTICTEAMFINAL_WithText-e1781543498165-900x600.jpg\" alt=\"\" />\n                                                </div> <!-- / Image -->\n                                                                                        <div class=\"news-listing__post-info\" > <!-- Info -->\n                                                <div>\n                                                    <p class=\"date\" >18 Jun 2026</p>\n                                                    <h2 class=\"h3\" >It starts here: our artistic team</h2>\n                                                                                                            <ul class=\"categories\" >\n                                                                                                                            <li>Our People</li>\n                                                                                                                    </ul>\n                                                                                                    </div>\n                                                <div class=\"news-listing__arrow\" >\n                                                    <img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" class=\"arrow\" />\n                                                </div>\n                                            </div> <!-- / Info -->\n                                        </a>\n                                    </li> <!-- / Post -->\n                                                                <li class=\"news-listing__post\" > <!-- Post -->\n                                        <a href=\"https://www.bushtheatre.co.uk/news/i-love-the-simpsons-does-it-get-better-meet-piers-black/\" class=\"red_bg\" >\n                                                                                            <div class=\"news-listing__post-image\" > <!-- Image -->\n                                                    <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Piers-900x600.png\" alt=\"\" />\n                                                </div> <!-- / Image -->\n                                                                                        <div class=\"news-listing__post-info\" > <!-- Info -->\n                                                <div>\n                                                    <p class=\"date\" >2 Jun 2026</p>\n           