t/trusts-and-foundations/\">Trusts and Foundations</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/star-supporters/\">Star Supporters</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/corporate-partners/\">Corporate Partners</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/meet-our-supporters/\">Our Supporters</a></li>\n</ul>\n</li>\n</ul></div>\t\t\t\t\t\t\t</nav><!-- #site-navigation -->\n\n\t\t\t\t\t\t\t<div class=\"subnav\" > <!-- Sub Nav -->\n\t\t\t\t\t\t\t\t<div class=\"subnav__links\" > <!-- Links -->\n\t\t\t\t\t\t\t\t\t<div class=\"basket_icon\" >\n\t\t\t\t\t\t\t\t\t\t<a href=\"/basket/\" class=\"basket\" >\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/basket.svg\" alt=\"basket - Checkout\" />\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"login_icon\" >\n\t\t\t\t\t\t\t\t\t\t<a href=\"/my-account/\" class=\"login\" >\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/user.svg\" alt=\"user - Login\" />\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"search_icon\" tabindex=\"-1\" > <!-- Site Search Icon -->\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"#search_form\" role=\"button\" title=\"Search Bar\" aria-label=\"Search Bar\" aria-controls=\"search_form\" aria-expanded=\"false\" aria-haspopup=\"true\" >\n\t\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/search.svg\" alt=\"search icon\" />\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t</div> <!-- / Site Search Icon -->\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div> <!-- / Links -->\n\t\t\t\t\t\t\t\t<div class=\"subnav__menu\"  > <!-- Menu -->\n\t\t\t\t\t\t\t\t\t<a href=\"#menu-popout\" class=\"subnav__menu-hamburger toggleButton\" aria-controls=\"navigation\" aria-expanded=\"false\" aria-haspopup=\"true\" ><img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" /></a>\n\t\t\t\t\t\t\t\t</div> <!-- / Menu -->\n\t\t\t\t\t\t\t</div> <!-- / Sub Nav -->\n\n\t\t\t\t\t\t</div> <!-- / Main Nav -->\n\n\t\t\t\t\t\t<div class=\"nav_icon\"><!-- Nav Icon -->\n\t\t\t\t\t\t\t<a href=\"#mobile-navigation\">\n\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" />\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div> <!-- / Nav Icon -->\n\n\t\t\t\t\t</div> <!-- / Nav Wrapper -->\n\n\t\t\t\t\t\n\t\t\t\t\t</div> <!-- / Logo Nav Holder -->\n\n\t\t\t\t</div> <!-- / Max Width -->\n\t\t\t</div> <!-- / Full Content -->\n\n\t\t</header><!-- #masthead -->\n\n\t\t<div id=\"content\" class=\"site-content\">\n\n\t\t<div id=\"primary\" class=\"content-area event\">\n    <main id=\"main\" class=\"site-main\">\n\n    \n        \n<section class=\"event_header\"> <!-- Event Header -->\n        <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/BushTheatre_Ripples_Website_1920x1080px.jpg\" alt=\"Ripples\" class=\"event_header__image event_header__image--center\">\n            <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/BushTheatre_Ripples_Website_1200x1900px.jpg\" alt=\"Ripples\" class=\"event_header__image event_header__image--center show_mob\">\n    \n    <div class=\"event_header__intro\"> <!-- Event Intro -->\n        <div class=\"event_header__intro_holder\">\n            <div class=\"event_header__intro_text\">\n                <h1 class=\"alt_heading\">Ripples</h1>\n\n                                    <p>By Tafadzwa Muchenje and Rosie MacPherson</p>\n                \n                                    <p class=\"event_header__date\">\n                                                                                                                                                                                                                                                            \n                                                                    <p>21 Jan to 27 Feb</p>\n                                \n                            \n                                                                            <p>Studio</p>\n                                            </p>\n                            </div>\n\n            <div class=\"event_header__intro_btn\">\n                                                                                                                                                <a href=\"#book\" class=\"btn\">Book tickets</a>\n                                                                        </div>\n        </div>\n    </div> <!-- / Event Intro -->\n\n</section> <!-- / Event Header -->\n\n<div class=\"event_nav\"> <!-- Event Nav -->\n    <div class=\"event_nav__width\">\n        <div class=\"event_nav__anchors\">\n            <a href=\"#about\" class=\"event_nav__item\">About</a>\n            <a href=\"#Cast &amp; Creatives\" class=\"event_nav__item\">Cast &amp; Creatives</a>\n        </div>\n                    <div class=\"event_nav__book\">\n                                    <a href=\"#book\" class=\"event_nav__item--book btn small btn_no_arrow\">Book tickets</a>\n                            </div>\n            </div>\n</div> <!-- / Event Header -->\n\n<div class=\"event_internal\">\n    <section class=\"full_content dark_bg event_about pt_lrg pb_lrg\" aria-label=\"About Event\" id=\"about\">\n        <div class=\"event_about__row mw_1200\">\n\n            \n                <div class=\"event_about__details green_bg\"> <!-- Details -->\n                    <p class=\"h3 dark\">Details</p>\n\n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Venue</p>\n                            <p class=\"row_value\">Studio</p>\n                        </div>\n                    \n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Dates</p>\n                        <p class=\"row_value\">\n                                                                                                                                                \n                                                                    <p>21 Jan to 27 Feb</p>\n                                                                                    </p>\n                    </div>\n\n                    \n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Age Guidance</p>\n                            <p class=\"row_value\">14+</p>\n                        </div>\n                    \n                     <!-- Button Repeater -->\n                        <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Content Guidance</p>\n                            <div class=\"btns_container\">\n                                                                                                        <a class=\"btn small\" href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Ripples-self-care-guide.pdf\" target=\"_blank\">Self-care guide &amp; content warnings</a>\n                                    \n                                                            </div>\n                        </div>\n                     <!-- / Button Repeater -->\n\n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Price</p>\n                        <p class=\"row_value\">\n                                                            £15.00 to £25.00                                                    </p>\n                    </div>\n\n                </div> <!-- / Details -->\n\n            \n            <div class=\"event_about__desc\">\n                <p class=\"h2\">About</p>\n                <div id=\"\">\n<p><b><i>“I have a story they don’t want me to tell.”</i></b></p>\n<p><span style=\"font-weight: 400\">Finish school, move to the big city, change the world. Life is just getting going.</span></p>\n<p><span style=\"font-weight: 400\">But then the letter arrives, and the van turns up. And everything stops. Ripped from his family, he’s about to be deported.</span></p>\n<p><span style=\"font-weight: 400\">Lost in a world of surveillance and suspicion, one man fights to hold on to who he is and right this wrong.</span></p>\n<p><span style=\"font-weight: 400\">Based on true events, from debut writer </span><b>Tafadzwa Muchenje</b><span style=\"font-weight: 400\"> and Stand and Be Counted’s Artistic Director </span><b>Rosie MacPherson</b><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Ripples</span></i><span style=\"font-weight: 400\"> is an urgent and electrifying interrogation of Britain’s treatment of migrants and the relentless power of hope. </span></p>\n<p>Presented by the UK’s first Theatre Company of Sanctuary, <strong>Stand and Be Counted</strong>, in support of the Lift the Ban campaign.</p>\n</div>\n\n            </div>\n\n        </div>\n\n                    <div class=\"mw_1200 event_about__desc_extra\">\n                <p class=\"small\">\n                    Presented by Stand &amp; Be Counted in association with Bush Theatre.                </p>\n            </section>\n\n    \r\n\r\n\r\n<section\r\n  aria-label=\"Cast &#038; Creatives\"id=\"Cast &#038; Creatives\"  class=\"full_content team-listing white_bg pt_sm pb_sm\"\r\n> <!-- Full Content -->\r\n\r\n  <div class=\"mw_1200 no_text_center\"> <!-- MW -->\r\n\r\n    <p class=\"h2\">Cast &#038; Creatives</p><div class=\"team-listing__spacer\" ></div>\r\n    \r\n    \r\n    \r\n              <ul class=\"team-listing__grid horizontal\" > <!-- Grid -->\r\n                      <li class=\"team-listing__post horizontal\" > <!-- Post -->\r\n                                  <div class=\"team-listing__post-image horizontal\" > <!-- Image Container -->\r\n                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Tafadzwa-Muchenje_Headshots_SmartJervasBanda-05367.jpg\" alt=\"\" />\r\n                  </div> <!-- / Image Container -->\r\n                                <div class=\"team-listing__post-info\" > <!-- Info Container -->\r\n                  <div>\r\n                    <div class=\"heading\" >\r\n                      <p class=\"title\" >Tafadzwa Muchenje</p>\r\n                                              <p>Co-Writer &amp; Performer</p>\r\n                                          </div>\r\n                                          <p class=\"small_text\" >Tafadzwa Muchenje is a bold and dynamic new voice in British theatre. A writer, actor, and multidisciplinary artist, his work explores identity, migration, masculinity, and belonging with raw honesty and&hellip;</p>\r\n                                      </div>\r\n                  <div>\r\n                    <a href=\"#team-listing-item-15222\" class=\"link alt team-listing__popup-link\" >Read More</a>\r\n\r\n                    <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15222\" > <!-- Pop-up -->\r\n                      <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                        <span>X</span>\r\n                      </button>\r\n                      <div class=\"team-listing__popup-content horizontal\" > <!-- Content -->\r\n                                                  <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                            <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Tafadzwa-Muchenje_Headshots_SmartJervasBanda-05367.jpg\" alt=\"\" />\r\n                          </div> <!-- / Image Container -->\r\n                                                <p class=\"h3\" >Tafadzwa Muchenje</p>\r\n                                                  <p class=\"h5\" >Co-Writer &amp; Performer</p>\r\n                                                <div class=\"divider\" ></div>\r\n                                                  <p><strong>Tafadzwa Muchenje</strong> is a bold and dynamic new voice in British theatre.</p>\n<p>A writer, actor, and multidisciplinary artist, his work explores identity, migration, masculinity, and belonging with raw honesty and energy. He began his creative journey with Stand &amp; Be Counted Theatre in 2017, starring in the national tour of <em>Where We Began</em>. He gained a social media apprenticeship at Channel 4 in 2019, progressing to become a senior marketing executive leading on a range of campaigns across multiple genres, and shows such as <em>Taskmaster, Married at First Sight UK</em> &amp;<em> Australia</em>, <em>Alone UK, Tempting Fortune, Election 2024</em>. Whilst building his career behind the scenes, he continued telling stories &#8211; starring in<em> The Calling</em>, a campaign with the Department for Education and SBTV, and appearing in a Guardian Labs short film in which Jamal Edwards explored Taf’s life and rise through apprenticeships.</p>\n<p>As Associate Artist, Taf has continued collaborating with <em>Stand &amp; Be Counted</em> on a wide range of projects including the documentary <em>Where We Are</em>, winner of the New York City IO Film Festival ‘Civil Rights Award’ in 2020. He contributed to <em>Not A Chance Encounter</em> (2022) an outdoor exhibition commissioned by ArtReach for the Liberty EU programme, exploring the role of artists in working with immigration stories, weaving together their lived experience with those of young refugees and asylum seekers across Europe and the UK. Taf is passionate about developing socially charged, thought-provoking work.</p>\n                                                <div class=\"clear\"></div>\r\n                      </div> <!-- / Content -->\r\n                    </div> <!-- / Pop-up -->\r\n\r\n                  </div>\r\n                </div> <!-- / Info Container -->\r\n            </li> <!-- / Post -->\r\n                  </ul>\r\n      \r\n    \r\n  </div> <!-- / MW -->\r\n\r\n</section> <!-- / Full Content -->\n\n\r\n\r\n\r\n<section\r\n    class=\"full_content team-listing white_bg pt_sm pb_sm\"\r\n> <!-- Full Content -->\r\n\r\n  <div class=\"mw_1200 no_text_center\"> <!-- MW -->\r\n\r\n    <div class=\"team-listing__spacer\" ></div>\r\n    \r\n    \r\n    \r\n              <ul class=\"team-listing__minimal-grid\" > <!-- Minimal Grid -->\r\n                      <li>\r\n              <a href=\"#team-listing-item-15215\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Rosie MacPherson </h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Co-Writer &amp; Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15215\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                          <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                        <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Rosie-MacPherson-headshot-320x480.jpg\" alt=\"\" />\r\n                      </div> <!-- / Image Container -->\r\n                                        <p class=\"h3\" >Rosie MacPherson </p>\r\n                                          <p class=\"h5\" >Co-Writer &amp; Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Rosie MacPherson</strong> is a writer, director and activist. She is Artistic Director and joint CEO of <em>Stand &amp; Be Counted</em>; the UK’s first Theatre Company of Sanctuary, committed to making work with and for people seeking sanctuary (asylum seekers, refugees and migrants). Her writing was nominated for a Fringe First, Bobby Award and Carol Tambor Best of Edinburgh Award, super shortlisted for BBC Comedy Room, a finalist of Box of Tricks and Sky Studios Screen/Play Award, and longlisted for the Women’s Prize for Playwriting.</p>\n<p>She is the winner of the British Independent Film Festival’s Best Actress Award and New York City IO Film<br />\nfestival ‘Civil Rights Award’. Rosie wrote Stand &amp; Be Counted’s groundbreaking production <em>Tanja</em> led by Emily Ntshangase. The show enjoyed two sold-out national tours and was presented at The Houses of Parliament to hundreds of cross-party MPs and campaigners. She co-wrote and directed <em>Have Your Passport Ready</em>, a gaming adventure navigating the UK’s hostile environment led by Syrian brothers Khaled and Mohammad Aljawad. Have Your Passport Ready was named ‘Game of the Week’ by The Observer. It has been played in 97 countries.</p>\n<p>Further credits include:</p>\n<p>Writer: <em>For Stand &amp; Be Counted &#8211; Where We Began</em> (national tour); <em>Posta Aerea</em> (Paines Plough, Elsinore Theatre Milan); <em>Inside</em> (Gilded Balloon Edinburgh Fringe, national tour); <em>Century</em> (Sheffield Theatres) and <em>Mother of the Revolution</em>, <em>Santa Must Die, An Act of Care</em> (for archipelago arts collective)</p>\n<p>Director: <em>For Stand &amp; Be Counted &#8211; Secret Summer</em> (The Space, Theatre in the Mill); <em>Where</em><br />\n<em>We Are</em> (documentary); <em>Can You Hear Me Now?</em> (Coventry UK City of Culture 2021).</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15404\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Lee Affen</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Composer &amp; Sound Designer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15404\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Lee Affen</p>\r\n                                          <p class=\"h5\" >Composer &amp; Sound Designer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15406\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Tom Robbins</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Technical Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15406\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Tom Robbins</p>\r\n                                          <p class=\"h5\" >Technical Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15408\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Zoe Katsilerou</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Movement Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15408\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Zoe Katsilerou</p>\r\n                                          <p class=\"h5\" >Movement Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-4898\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Matt Powell</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Video Designer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-4898\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Matt Powell</p>\r\n                                          <p class=\"h5\" >Video Designer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Matt Powell</strong> (they/she/he) is a non-binary, Offie-finalist video designer, musical theatre creative and queer practitioner based in the East Midlands. They are a PhD candidate exploring LGBTQ+ representation in musical theatre at the University of Wolverhampton.</p>\n<p>Video Design and Digital credits include:<em> New Year</em> (Birmingham Opera);<em> Marie Curie – A New Musical, Rebecca</em> (Charing Cross);<em> Laughing Boy</em> (Jermyn Street / Theatre Royal Bath);<em> Sherlock Holmes and the Poison Wood</em> (Watermill);<em> EXhibitionists</em> (King’s Head);<em> I Really Do Think That This Will Change Your Life</em> (Mercury Theatre / Colchester &#8211; Finalist The Stage Award for Innovation):<em> Gypsy in Concert</em> (Manchester Opera House for Hope Mill Theatre); <em>Ride</em> (The Old Globe / Curve / Southwark); <em>Animal</em> (Hope Mill / Park &#8211; Offie Finalist);<em> Accidental Death of an Anarchist</em> (Theatre Royal Haymarket / Sheffield / Lyric Hammersmith);<em> Blow Down</em> (Leeds Playhouse);<em> Rumi: The Musical</em> (D’asha Performing Arts Festival / London Coliseum);<em> How A City Can Save the World</em> (Sheffield);<em> A-Typical Rainbow</em> (Turbine);<em> Flight</em> (RCM);<em> But What If You Die</em> (Camden People’s Theatre);<em> Old Friends</em> (Digital);<em> Bloody Difficult Women</em> (Riverside);<em> Santa Must Die</em> (Alphabetti); <em>Magdalene</em> (Arcola Outside);<em> Snowflake</em> (Lowry);<em> 34</em> (Aria Entertainment / Lowry); <em>Public Domain</em> (Vaudeville / Southwark); <em>The Blazing World</em> (University of the Arts, Philadelphia);<em> On Hope: A Digital Song Cycle</em> (Other Palace);<em> Plaza</em> (Royal Central School of Speech and Drama); <em>American Idiot</em> (Derby).</p>\n<p>Directing credits include: <em>Rent</em> (May Hall); <em>Santa Must Die</em> (Leeds Playhouse / Red Ladder);<em> Nativity: The Musical, Crazy for You</em> (Derby);<em> The Unconventionals</em> (VAULT);<em> Is He Musical</em> (Curve / Other Palace).</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15411\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Charly Dunford</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Lighting Designer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15411\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Charly Dunford</p>\r\n                                          <p class=\"h5\" >Lighting Designer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15413\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Joe Bunce</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Technical Stage Manager</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15413\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Joe Bunce</p>\r\n                                          <p class=\"h5\" >Technical Stage Manager</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15416\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Stand &amp; Be Counted</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Producer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15416\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Stand &amp; Be Counted</p>\r\n                                          <p class=\"h5\" >Producer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\"><strong>Stand &amp; Be Counted</strong> is the UK’s first Theatre Company of Sanctuary, and arts charity, committed to making work with and for people seeking sanctuary (refugees, asylum seekers and migrants). They proudly sit at the intersection of arts, culture &amp; social activism. Through a rigorous and adventurous co-creation programme, they provide thousands of people seeking sanctuary with regular, long-term creative and career development opportunities to celebrate, platform, and ensure equality of opportunity. </span></p>\n<p><span style=\"font-weight: 400\">They make live &amp; digital works to instigate change with a proud record for platforming new artists and welcoming new audiences. Founded in 2010, their work is innovative, adventurous and political, merging lived experience with new ideas. </span></p>\n<p><strong>Producer &#8211; John Tomlinson<br />\nAssociate Producer &#8211; Muetesim Abdel</strong></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                  </ul> <!-- / Minimal Grid -->\r\n      \r\n    \r\n  </div> <!-- / MW -->\r\n\r\n</section> <!-- / Full Content -->\n                        <section class=\"full_content light_bg show pt_lrg pb_lrg\" aria-label=\"Book Tickets\" id=\"book\">\n                <div class=\"mw_1200\">\n                    <p class=\"h2\">Book tickets</p>\n\n\n                        \n                                            <div class=\"event_filter\">\n                            <div class=\"event_filter__container\">\n                                <p class=\"h4\">Filter events:</p>\n                                <div class=\"event_filter__buttons\">\n                                    <a href=\"#\" class=\"event_filter__item\" id=\"filter_all\" data-filter=\"\">All</a>\n                                    <a hr