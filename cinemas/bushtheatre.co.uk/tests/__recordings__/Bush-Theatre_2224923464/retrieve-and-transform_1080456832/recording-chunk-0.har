nd;25.00</div>\n                                \n                                <div class=\"instance_table__col\">\n                                    <div class=\"icon_holder\">\n                                                                                                                                                                                                                    <span data-tooltip=\"Preview\">\n                                                    <img class=\"icon\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/access-icons/icon_preview_dark.svg\" alt=\"Preview\">\n                                                </span>\n                                                                                                                                                                                                                </div>\n                                </div>\n\n                                <div class=\"instance_table__col instance_table__col--book\">\n\n                                                                                                                \n                                                                                                                                                                                        <a href=\"https://www.bushtheatre.co.uk/book/?show=307332AVHVJTHTJHTBLVLJQQDHSSNKTMR\"\n                                        class=\"btn btn_no_arrow\">Book now</a>\n                                    \n                                </div>\n\n                            </div> <!-- / Show Row -->\n\n                        \n                            \n                            <div class=\"instance_table__row\" data-filter=\"preview\"> <!-- Instance Table Row -->\n                                <div class=\"instance_table__col instance_table__col--date\"><time>Tue 8 September</time></div>\n                                <div class=\"instan