ef=\"https://www.bushtheatre.co.uk/support/donate/\">Donate</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/visit/memberships/\">Memberships</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/trusts-and-foundations/\">Trusts and Foundations</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/star-supporters/\">Star Supporters</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/corporate-partners/\">Corporate Partners</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/meet-our-supporters/\">Our Supporters</a></li>\n</ul>\n</li>\n</ul></div>\t\t\t\t\t\t\t</nav><!-- #site-navigation -->\n\n\t\t\t\t\t\t\t<div class=\"subnav\" > <!-- Sub Nav -->\n\t\t\t\t\t\t\t\t<div class=\"subnav__links\" > <!-- Links -->\n\t\t\t\t\t\t\t\t\t<div class=\"basket_icon\" >\n\t\t\t\t\t\t\t\t\t\t<a href=\"/basket/\" class=\"basket\" >\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/basket.svg\" alt=\"basket - Checkout\" />\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"login_icon\" >\n\t\t\t\t\t\t\t\t\t\t<a href=\"/my-account/\" class=\"login\" >\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/user.svg\" alt=\"user - Login\" />\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"search_icon\" tabindex=\"-1\" > <!-- Site Search Icon -->\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"#search_form\" role=\"button\" title=\"Search Bar\" aria-label=\"Search Bar\" aria-controls=\"search_form\" aria-expanded=\"false\" aria-haspopup=\"true\" >\n\t\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/search.svg\" alt=\"search icon\" />\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t</div> <!-- / Site Search Icon -->\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div> <!-- / Links -->\n\t\t\t\t\t\t\t\t<div class=\"subnav__menu\"  > <!-- Menu -->\n\t\t\t\t\t\t\t\t\t<a href=\"#menu-popout\" class=\"subnav__menu-hamburger toggleButton\" aria-controls=\"navigation\" aria-expanded=\"false\" aria-haspopup=\"true\" ><img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" /></a>\n\t\t\t\t\t\t\t\t</div> <!-- / Menu -->\n\t\t\t\t\t\t\t</div> <!-- / Sub Nav -->\n\n\t\t\t\t\t\t</div> <!-- / Main Nav -->\n\n\t\t\t\t\t\t<div class=\"nav_icon\"><!-- Nav Icon -->\n\t\t\t\t\t\t\t<a href=\"#mobile-navigation\">\n\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" />\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div> <!-- / Nav Icon -->\n\n\t\t\t\t\t</div> <!-- / Nav Wrapper -->\n\n\t\t\t\t\t\n\t\t\t\t\t</div> <!-- / Logo Nav Holder -->\n\n\t\t\t\t</div> <!-- / Max Width -->\n\t\t\t</div> <!-- / Full Content -->\n\n\t\t</header><!-- #masthead -->\n\n\t\t<div id=\"content\" class=\"site-content\">\n\n\t\t<div id=\"primary\" class=\"content-area event\">\n    <main id=\"main\" class=\"site-main\">\n\n    \n        \n<section class=\"event_header\"> <!-- Event Header -->\n        <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/BushTheatre_GlobalMajority_Website_1920x1080px_Clean.jpg\" alt=\"Global Majority\" class=\"event_header__image event_header__image--center\">\n            <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/BushTheatre_GlobalMajority_Website_1200x1900px_Clean.jpg\" alt=\"Global Majority\" class=\"event_header__image event_header__image--center show_mob\">\n    \n    <div class=\"event_header__intro\"> <!-- Event Intro -->\n        <div class=\"event_header__intro_holder\">\n            <div class=\"event_header__intro_text\">\n                <h1 class=\"alt_heading\">Global Majority</h1>\n\n                                    <p>By Chris Fung</p>\n                \n                                    <p class=\"event_header__date\">\n                                                                                                                                                                                                                                                            \n                                                                    <p>25 Nov to 16 Jan</p>\n                                \n                            \n                                                                            <p>Holloway Theatre (Bush Theatre's Main Space)</p>\n                                            </p>\n                            </div>\n\n            <div class=\"event_header__intro_btn\">\n                                                                                                                                                <a href=\"#book\" class=\"btn\">Book tickets</a>\n                                                                        </div>\n        </div>\n    </div> <!-- / Event Intro -->\n\n</section> <!-- / Event Header -->\n\n<div class=\"event_nav\"> <!-- Event Nav -->\n    <div class=\"event_nav__width\">\n        <div class=\"event_nav__anchors\">\n            <a href=\"#about\" class=\"event_nav__item\">About</a>\n            <a href=\"#Creative team\" class=\"event_nav__item\">Creative team</a>\n        </div>\n                    <div class=\"event_nav__book\">\n                                    <a href=\"#book\" class=\"event_nav__item--book btn small btn_no_arrow\">Book tickets</a>\n                            </div>\n            </div>\n</div> <!-- / Event Header -->\n\n<div class=\"event_internal\">\n    <section class=\"full_content dark_bg event_about pt_lrg pb_lrg\" aria-label=\"About Event\" id=\"about\">\n        <div class=\"event_about__row mw_1200\">\n\n            \n                <div class=\"event_about__details green_bg\"> <!-- Details -->\n                    <p class=\"h3 dark\">Details</p>\n\n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Venue</p>\n                            <p class=\"row_value\">Holloway Theatre (Bush Theatre's Main Space)</p>\n                        </div>\n                    \n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Dates</p>\n                        <p class=\"row_value\">\n                                                                                                                                                \n                                                                    <p>25 Nov to 16 Jan</p>\n                                                                                    </p>\n                    </div>\n\n                    \n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Age Guidance</p>\n                            <p class=\"row_value\">16+</p>\n                        </div>\n                    \n                     <!-- Button Repeater -->\n                        <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Content Guidance</p>\n                            <div class=\"btns_container\">\n                                                                                                        <a class=\"btn small\" href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Global-Majority-self-care-guide.pdf\" target=\"_blank\">Self-care guide &amp; content warnings</a>\n                                    \n                                                            </div>\n                        </div>\n                     <!-- / Button Repeater -->\n\n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Price</p>\n                        <p class=\"row_value\">\n                                                            £10.00 to £45.00                                                    </p>\n                    </div>\n\n                </div> <!-- / Details -->\n\n            \n            <div class=\"event_about__desc\">\n                <p class=\"h2\">About</p>\n                <div id=\"\">\n<p><b><i>&#8220;Can you feel the revolt? It’s coming.&#8221;</i></b></p>\n<p><span style=\"font-weight: 400\">A chair, a candidate, a thousand eyes.</span></p>\n<p><span style=\"font-weight: 400\">Brian Tran is being interviewed. Succeed, and he could become the most powerful leader in the world. But, as the interview tests become increasingly brutal, Brian is forced to face what might happen if he fails.</span></p>\n<p><i><span style=\"font-weight: 400\">Black Mirror</span></i><span style=\"font-weight: 400\"> meets</span><i><span style=\"font-weight: 400\"> Succession</span></i><span style=\"font-weight: 400\"> in this tale of twisted family loyalty, cabalistic elites, and what we’re prepared to sacrifice for proximity to power.</span></p>\n<p><span style=\"font-weight: 400\">An exhilarating, unflinching thriller from Tony Craze award-winning writer </span><b>Chris Fung</b><span style=\"font-weight: 400\"> (</span><i><span style=\"font-weight: 400\">The Society for New Cuisine</span></i><span style=\"font-weight: 400\">) and director </span><b>Rupert Hands</b><span style=\"font-weight: 400\"> (</span><i><span style=\"font-weight: 400\">End of the Rainbow</span></i><span style=\"font-weight: 400\">). </span></p>\n</div>\n\n            </div>\n\n        </div>\n\n                    <div class=\"mw_1200 event_about__desc_extra\">\n                <p class=\"small\">\n                    A Fun Guy Theatre, Gabriella Sills Productions and Bush Theatre co-production.                </p>\n            </section>\n\n    \n\n\n<section \n        class=\"full_content testimonial-block\"\n>\n    <!-- Full Content -->\n    <!-- Testimonial Slider -->\n    <div class=\"testimonial-block__slider\">\n                                                    <div class=\"testimonial-block__item green dark_bg\">\n                    <!-- Item -->\n                    \n                    <div class=\"testimonial-block__slide-wrap mw_960 pt_none pb_sm\">\n                        \n                        <div class=\"testimonial-block__text\">\n                            <!-- Slide -->\n                                                            <blockquote class=\"testimonial-block__text-quote h1 green_border\">\n                                    <!-- Text Quote -->\n                                    &#8220;Chris Fung’s masterful debut marks him out as one to watch. Dark, sharp, and delicious. There is now absolutely an appetite for whatever he serves up next.”                                </blockquote>\n                            \n                                                            <p class=\"testimonial-block__text-author\">\n                                    <!-- Text Author -->\n                                    &#8211;  The Scotsman on The Society for New Cuisine                                </p>\n                                                    </div>\n                    </div>\n                </div>\n                        </div><!-- .testimonial-block__slider -->\n</section>\n\n\n\r\n\r\n\r\n<section\r\n  aria-label=\"Creative team\"id=\"Creative team\"  class=\"full_content team-listing white_bg pt_sm pb_sm\"\r\n> <!-- Full Content -->\r\n\r\n  <div class=\"mw_1200 no_text_center\"> <!-- MW -->\r\n\r\n    <p class=\"h2\">Creative team</p><div class=\"team-listing__spacer\" ></div>\r\n    \r\n    \r\n    \r\n              <ul class=\"team-listing__minimal-grid\" > <!-- Minimal Grid -->\r\n                      <li>\r\n              <a href=\"#team-listing-item-15227\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Chris Fung</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Writer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15227\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                          <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                        <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Chris-Fung-Writer-Headshot-320x480.jpg\" alt=\"\" />\r\n                      </div> <!-- / Image Container -->\r\n                                        <p class=\"h3\" >Chris Fung</p>\r\n                                          <p class=\"h5\" >Writer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Chris Fung</strong> is the resident Associate Artist for Ransack Theatre 26/27.</p>\n<p>As Writer:<br />\n<em>The Society for New Cuisine</em> dir. Rupert Hands (EdFringe ‘23, Omnibus ’25); <em>Frank and Je</em>n dir. Roy Alexander Weise MBE &#8211; in development; <em>Around the World in 80 Days</em> dir. Tara Noonan (UK Tour &#8217;26); <em>Those Who Can’t Teach</em> &#8211; in development.</p>\n<p>As Performer:<br />\n<em>The Society for New Cuisine</em> (EdFringe and Omnibus); <em>Frozen</em> (West End); C<em>yrano de Bergerac</em> (West End and NT Live); <em>Your Lie in April</em> (West End); <em>The King and I</em> (Au Tour).</p>\n<p>Writing Schemes and Awards:<br />\nTony Craze Award Winner 2026 (for Frank and Jen)<br />\nThe Ilfeld Prize Winner 2026 (for Global Majority)<br />\nOffies Assessor’s Choice 2025 (for Society for New Cuisine)</p>\n<p>Criterion New Writing Program ’26; Soho Writers Lab 25/26, New Earth Writers 25; ATG Musical Theatre Writers ‘26; Offies Assessor’s Choice 2025; 5 Fringe Theatre Award Nominations; OffFest Best Solo Show Nom 2023 (all for The Society for New Cuisine); Rafia Hussain Productions Early Commission (for Frank and Jen); Affiliate Playwright Pint-Sized Theatre; Junior Member &#8211; League of Independent Producers, Projekt Europa &#8211; Mentorship Scheme 26/27.</p>\n<p>Chris is the director of Camino Meets, a free dramaturgical development community for low socioeconomic London Playwrights.</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15231\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Rupert Hands</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15231\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                          <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                        <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Rupert-Hands-320x480.jpg\" alt=\"\" />\r\n                      </div> <!-- / Image Container -->\r\n                                        <p class=\"h3\" >Rupert Hands</p>\r\n                                          <p class=\"h5\" >Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p>As Director: <em>End of the Rainbow</em> (Soho Walthamstow); The Phantom of the Opera (ArtsEd); <em>American Saviour</em> (NYC, Workshop); Roam (Shaftesbury); <em>West Side Story</em> (Birmingham Hippodrome); <em>Dirty Rotten Scoundrels</em> (London Palladium/Tokyu Theatre Orb); <em>Wendy and Peter Pan</em> (Leeds Playhouse); <em>Love Life</em> (Theatre Royal Drury Lane); <em>The Society for New Cuisine</em> (Omnibus); <em>Otto Weidt</em> (Workshop, Leeds Playhouse);<em> Global Majority</em> (Workshop); <em>Dirty Hearts</em> (Old Red Lion); <em>Blackbird</em> (The Other Room); <em>The Secret Garden</em> (Ambassadors);<em> Crazy For You, High Society</em> (ArtsEd); <em>Songs For a New World, Six Characters in Search of an Author, Oh What a Lovely War, Candide</em> (all Mountview);<em> Carrie, Edward II, Spring Awakening, Company, Between Riverside and Crazy</em> (all RWCMD); <em>Pericles, Greenland</em> (LAMDA).</p>\n<p>As Associate Director: <em>Evita</em> (Palladium); <em>Sunset Boulevard</em> (St.James, Broadway/Savoy); Cyrano de Bergerac (Playhouse/Pinter).</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15340\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Fun Guy Theatre</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Co-Producer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15340\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Fun Guy Theatre</p>\r\n                                          <p class=\"h5\" >Co-Producer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\"><strong>Fun Guy Theatre</strong> is an award-winning, artist-led collective founded by East Asian migrant Chris Fung, dedicated to unearthing visceral new narratives that challenge the boundaries of contemporary British playwriting. Since its inception, the company has established a reputation for &#8220;audacious, genre-defying&#8221; work that prioritises urgent social commentary and experimental form, often collaborating with emerging voices from underrepresented Global Majority backgrounds.</span></p>\n<p><span style=\"font-weight: 400\">Fun Guy Theatre’s previous productions have garnered critical acclaim for their sharp wit and uncompromising emotional depth. As they continue to bridge the gap between grassroots activism, through initiatives like Camino Meets and large-scale performance. The company remains a vital force in the UK’s theatrical landscape, consistently interrogating the stories we tell and the means by which we tell them.</span><span style=\"font-weight: 400\"> </span></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15343\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Gabriella Sills Productions</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Co-Producer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15343\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Gabriella Sills Productions</p>\r\n                                          <p class=\"h5\" >Co-Producer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\"><strong>Gabriella Sills Productions</strong> is the official theatre production company of Gabbie Sills, with a strong focus on bringing new writing to the Off West End and beyond. It is also the home of the open-air touring theatre troupe Alfresco Actors. They believe in the power theatre has to inspire, educate &#8211; perhaps entertain &#8211; and take us beyond comfortable existence.</p>\n<p></span><span style=\"font-weight: 400\">The company&#8217;s shows have been nominated for Off West End &amp; Stage Debut Awards, won Best Production at the Scottish Theatre Awards, and received a plethora of five and four-star reviews. </span></p>\n<p><span style=\"font-weight: 400\">Gabbie is a recipient of the prestigious Stage One Bursary, a mentor for Westminster City Lions, and on the Board of the League of Independent Producers.</p>\n<p></span><span style=\"font-weight: 400\">Recent Productions Include </span><b>&#8211;</b> <i><span style=\"font-weight: 400\">Breeding </span></i><span style=\"font-weight: 400\">(King’s Head Theatre, produced with Seabright Live in association with Mark Gatiss); </span><i><span style=\"font-weight: 400\">Agatha </span></i><span style=\"font-weight: 400\">(Theatre503); </span><i><span style=\"font-weight: 400\">Starry </span></i><span style=\"font-weight: 400\">(Associate Producer, London Workshop, The Other Palace); </span><i><span style=\"font-weight: 400\">1902 </span></i><span style=\"font-weight: 400\">(Union Theatre, UK Tour); </span><i><span style=\"font-weight: 400\">Blackout </span></i><span style=\"font-weight: 400\">(Theatre503, Old Joint Stock); </span><i><span style=\"font-weight: 400\">Bits ‘N’ Pieces</span></i><span style=\"font-weight: 400\"> (Leith Arches); </span><i><span style=\"font-weight: 400\">Around the World in 80 Days</span></i><span style=\"font-weight: 400\"> (UK Tour); </span><i><span style=\"font-weight: 400\">Kaspar: Prince of Cats </span></i><span style=\"font-weight: 400\">(UK Tour); </span><i><span style=\"font-weight: 400\">The Great Gatsby</span></i><span style=\"font-weight: 400\"> (UK Tour); </span><i><span style=\"font-weight: 400\">Stiff Upper Lip, Jeeves</span></i><span style=\"font-weight: 400\"> (UK Tour); </span><i><span style=\"font-weight: 400\">The Railway Children</span></i><span style=\"font-weight: 400\"> (UK Tour); </span><i><span style=\"font-weight: 400\">Doctor Dolittle</span></i><span style=\"font-weight: 400\"> (UK Tour).</span></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                  </ul> <!-- / Minimal Grid -->\r\n      \r\n    \r\n  </div> <!-- / MW -->\r\n\r\n</section> <!-- / Full Content -->\n                        <section class=\"full_content light_bg show pt_lrg pb_lrg\" aria-label=\"Book Tickets\" id=\"book\">\n                <div class=\"mw_1200\">\n                    <p class=\"h2\">Book tickets</p>\n\n\n                        \n                                            <div class=\"event_filter\">\n                            <div class=\"event_filter__container\">\n                                <p class=\"h4\">Filter events:</p>\n                                <div class=\"event_filter__buttons\">\n                                    <a href=\"#\" class=\"event_filter__item\" id=\"filter_all\" data-filter=\"\">All</a>\n                                    <a href=\"#\" class=\"event_filter__item preview\" data-filter=\"preview\">Preview</a><a href=\"#\" class=\"event_filter__item press_night\" data-filter=\"press_night\">Press Night</a><a href=\"#\" class=\"event_filter__item matinee\" data-filter=\"matinee\">Matinee</a><a href=\"#\" class=\"event_filter__item relaxed_performance\" data-filter=\"relaxed_performance\">Relaxed Performance</a><a href=\"#\" class=\"event_filter__item bsl_interpreted\" data-filter=\"bsl_interpreted\">BSL Interpreted</a><a href=\"#\" class=\"event_filter__item captioned\" data-filter=\"captioned\">Captioned Performance</a><a href=\"#\" class=\"event_filter__item audio_described\" data-filter=\"audio_descri