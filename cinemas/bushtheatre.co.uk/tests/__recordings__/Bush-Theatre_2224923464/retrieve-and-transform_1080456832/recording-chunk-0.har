pan class=\"screen-reader-text\">Support Us sub navigation icon</span></a></div></div>\n<ul class=\"sub-menu\">\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/donate/\">Donate</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/visit/memberships/\">Memberships</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/trusts-and-foundations/\">Trusts and Foundations</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/star-supporters/\">Star Supporters</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/corporate-partners/\">Corporate Partners</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/meet-our-supporters/\">Our Supporters</a></li>\n</ul>\n</li>\n</ul></div>\t\t\t\t\t\t\t</nav><!-- #site-navigation -->\n\n\t\t\t\t\t\t\t<div class=\"subnav\" > <!-- Sub Nav -->\n\t\t\t\t\t\t\t\t<div class=\"subnav__links\" > <!-- Links -->\n\t\t\t\t\t\t\t\t\t<div class=\"basket_icon\" >\n\t\t\t\t\t\t\t\t\t\t<a href=\"/basket/\" class=\"basket\" >\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/basket.svg\" alt=\"basket - Checkout\" />\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"login_icon\" >\n\t\t\t\t\t\t\t\t\t\t<a href=\"/my-account/\" class=\"login\" >\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/user.svg\" alt=\"user - Login\" />\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"search_icon\" tabindex=\"-1\" > <!-- Site Search Icon -->\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"#search_form\" role=\"button\" title=\"Search Bar\" aria-label=\"Search Bar\" aria-controls=\"search_form\" aria-expanded=\"false\" aria-haspopup=\"true\" >\n\t\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/search.svg\" alt=\"search icon\" />\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t</div> <!-- / Site Search Icon -->\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div> <!-- / Links -->\n\t\t\t\t\t\t\t\t<div class=\"subnav__menu\"  > <!-- Menu -->\n\t\t\t\t\t\t\t\t\t<a href=\"#menu-popout\" class=\"subnav__menu-hamburger toggleButton\" aria-controls=\"navigation\" aria-expanded=\"false\" aria-haspopup=\"true\" ><img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" /></a>\n\t\t\t\t\t\t\t\t</div> <!-- / Menu -->\n\t\t\t\t\t\t\t</div> <!-- / Sub Nav -->\n\n\t\t\t\t\t\t</div> <!-- / Main Nav -->\n\n\t\t\t\t\t\t<div class=\"nav_icon\"><!-- Nav Icon -->\n\t\t\t\t\t\t\t<a href=\"#mobile-navigation\">\n\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" />\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div> <!-- / Nav Icon -->\n\n\t\t\t\t\t</div> <!-- / Nav Wrapper -->\n\n\t\t\t\t\t\n\t\t\t\t\t</div> <!-- / Logo Nav Holder -->\n\n\t\t\t\t</div> <!-- / Max Width -->\n\t\t\t</div> <!-- / Full Content -->\n\n\t\t</header><!-- #masthead -->\n\n\t\t<div id=\"content\" class=\"site-content\">\n\n\t\t<div id=\"primary\" class=\"content-area event\">\n    <main id=\"main\" class=\"site-main\">\n\n    \n        \n<section class=\"event_header\"> <!-- Event Header -->\n        <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/BushTheatre_InsaneAsylumSeekers_Website_1920x1080px.jpg\" alt=\"Insane Asylum Seekers\" class=\"event_header__image event_header__image--center\">\n            <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/BushTheatre_InsaneAsylumSeekers_Website_1200x1900px.jpg\" alt=\"Insane Asylum Seekers\" class=\"event_header__image event_header__image--center show_mob\">\n    \n    <div class=\"event_header__intro\"> <!-- Event Intro -->\n        <div class=\"event_header__intro_holder\">\n            <div class=\"event_header__intro_text\">\n                <h1 class=\"alt_heading\">Insane Asylum Seekers</h1>\n\n                                    <p>By Laith Elzubaidi</p>\n                \n                                    <p class=\"event_header__date\">\n                                                                                                                                                                                                                                                            \n                                                                    <p>12 Feb to 20 Mar</p>\n                                \n                            \n                                                                            <p>Holloway Theatre (Bush Theatre's Main Space)</p>\n                                            </p>\n                            </div>\n\n            <div class=\"event_header__intro_btn\">\n                                                                                                                                                <a href=\"#book\" class=\"btn\">Book tickets</a>\n                                                                        </div>\n        </div>\n    </div> <!-- / Event Intro -->\n\n</section> <!-- / Event Header -->\n\n<div class=\"event_nav\"> <!-- Event Nav -->\n    <div class=\"event_nav__width\">\n        <div class=\"event_nav__anchors\">\n            <a href=\"#about\" class=\"event_nav__item\">About</a>\n            <a href=\"#Videos\" class=\"event_nav__item\">Videos</a><a href=\"#Creative team\" class=\"event_nav__item\">Creative team</a>\n        </div>\n                    <div class=\"event_nav__book\">\n                                    <a href=\"#book\" class=\"event_nav__item--book btn small btn_no_arrow\">Book tickets</a>\n                            </div>\n            </div>\n</div> <!-- / Event Header -->\n\n<div class=\"event_internal\">\n    <section class=\"full_content dark_bg event_about pt_lrg pb_lrg\" aria-label=\"About Event\" id=\"about\">\n        <div class=\"event_about__row mw_1200\">\n\n            \n                <div class=\"event_about__details green_bg\"> <!-- Details -->\n                    <p class=\"h3 dark\">Details</p>\n\n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Venue</p>\n                            <p class=\"row_value\">Holloway Theatre (Bush Theatre's Main Space)</p>\n                        </div>\n                    \n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Dates</p>\n                        <p class=\"row_value\">\n                                                                                                                                                \n                                                                    <p>12 Feb to 20 Mar</p>\n                                                                                    </p>\n                    </div>\n\n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Running time</p>\n                            <p class=\"row_value\">\n                                1 hour 15 minutes                                                            </p>\n                        </div>\n                    \n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Age Guidance</p>\n                            <p class=\"row_value\">14+</p>\n                        </div>\n                    \n                     <!-- Button Repeater -->\n                        <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Content Guidance</p>\n                            <div class=\"btns_container\">\n                                                                                                        <a class=\"btn small\" href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/IAS-self-care-guide.pdf\" target=\"_blank\">Self-care guide &amp; content warnings</a>\n                                    \n                                                            </div>\n                        </div>\n                     <!-- / Button Repeater -->\n\n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Price</p>\n                        <p class=\"row_value\">\n                                                            £10.00 to £35.00                                                    </p>\n                    </div>\n\n                </div> <!-- / Details -->\n\n            \n            <div class=\"event_about__desc\">\n                <p class=\"h2\">About</p>\n                <p><b><i>“At 27, my dad had escaped multiple bloodthirsty dictatorships. I’m 27, I had a panic attack watching the final episode of ‘Succession.”</i></b></p>\n<p><span style=\"font-weight: 400\">Laith is in serious trouble &#8211; but he can’t tell you why. He’s spent years keeping a secret, perfecting the art of hiding it. </span></p>\n<p><span style=\"font-weight: 400\">But now, it’s catching up with him. </span></p>\n<p><span style=\"font-weight: 400\">And as if that weren’t enough, Laith’s mum won’t stop throwing things at seagulls, and his dad keeps wandering off during life-threatening situations. </span></p>\n<p><span style=\"font-weight: 400\">Laith’s parents escaped Iraq 30 years ago, which he reckons is the reason he’s in this whole mess to begin with. </span><span style=\"font-weight: 400\">Side-splittingly funny and deeply moving, </span><i><span style=\"font-weight: 400\">Insane Asylum Seekers</span></i><span style=\"font-weight: 400\"> transfers to the Bush Theatre’s main stage following a sold-out Studio run. Written by </span><b>Laith Elzubaidi </b><span style=\"font-weight: 400\">and directed by Olivier Award-nominee </span><b>Emily Ling Williams</b><span style=\"font-weight: 400\"> (</span><i><span style=\"font-weight: 400\">A Playlist for the Revolution</span></i><span style=\"font-weight: 400\">).</span></p>\n\n            </div>\n\n        </div>\n\n                    <div class=\"mw_1200 event_about__desc_extra\">\n                <p class=\"small\">\n                    Presented by Samia Djilli and Sarah Allen in association with Bush Theatre.                </p>\n            </section>\n\n    \n\n\n<section \n        class=\"full_content testimonial-block\"\n>\n    <!-- Full Content -->\n    <!-- Testimonial Slider -->\n    <div class=\"testimonial-block__slider\">\n                                                    <div class=\"testimonial-block__item green dark_bg\">\n                    <!-- Item -->\n                    \n                    <div class=\"testimonial-block__slide-wrap mw_960 pt_none pb_sm\">\n                                                                                <div class=\"testimonial-block__rating\">\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                            </div>\n                        \n                        <div class=\"testimonial-block__text\">\n                            <!-- Slide -->\n                                                            <blockquote class=\"testimonial-block__text-quote h1 green_border\">\n                                    <!-- Text Quote -->\n                                    “This show is worth the hype”                                 </blockquote>\n                            \n                                                            <p class=\"testimonial-block__text-author\">\n                                    <!-- Text Author -->\n                                    &#8211; Broadway World                                </p>\n                                                    </div>\n                    </div>\n                </div>\n                        </div><!-- .testimonial-block__slider -->\n</section>\n\n\n\r\n\r\n\r\n<section\r\n  aria-label=\"Videos\"id=\"Videos\"  class=\"full_content dark_bg pt_sm pb_sm\"\r\n> <!-- Full Content -->\r\n\r\n  <div class=\"embed mw_960 no_text_center\"> <!-- MW -->\r\n\r\n    \r\n    \r\n          <div class=\"embed__video\"><iframe title=\"Insane Asylum Seekers | Audience Reactions\" width=\"640\" height=\"360\" src=\"https://www.youtube.com/embed/7jTMykj8xis?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe></div>\r\n    \r\n  </div> <!-- / MW -->\r\n\r\n</section> <!-- / Full Content -->\n\n\r\n\r\n\r\n<section\r\n  aria-label=\"Creative team\"id=\"Creative team\"  class=\"full_content team-listing white_bg pt_sm pb_sm\"\r\n> <!-- Full Content -->\r\n\r\n  <div class=\"mw_1200 no_text_center\"> <!-- MW -->\r\n\r\n    <div class=\"team-listing__spacer\" ></div>\r\n          <p class=\"h3\" >Creative team</p>\r\n    \r\n    \r\n    \r\n              <ul class=\"team-listing__minimal-grid\" > <!-- Minimal Grid -->\r\n                      <li>\r\n              <a href=\"#team-listing-item-9775\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Laith Elzubaidi</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Writer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-9775\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                          <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                        <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2025/03/Laith-320x480.png\" alt=\"\" />\r\n                      </div> <!-- / Image Container -->\r\n                                        <p class=\"h3\" >Laith Elzubaidi</p>\r\n                                          <p class=\"h5\" >Writer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <div id=\"docs-editor-container\" dir=\"ltr\">\n<div id=\"docs-editor\" class=\"\">\n<div id=\"waffle-grid-container\" dir=\"ltr\">\n<div id=\"2002627833-grid-container\" class=\"grid-container\" dir=\"ltr\">\n<div id=\"2002627833-grid-table-container\">\n<div class=\"grid-table-container\">\n<div id=\"2002627833-scrollable\" class=\"grid-scrollable-wrapper\">\n<div class=\"goog-inline-block grid4-inner-container\">\n<div class=\"waffle-background-container\"><strong>Laith Elzubaidi</strong> is a British-Iraqi screenwriter, playwright and community organiser based in London. Laith’s Tony Craze Award-winning play <em>Insane Asylum Seekers</em> was produced at the Bush Theatre for a month-long run in May 2025, directed by Olivier Award-nominated director Emily Ling Williams, and is now transferring to the main house of the Bush Theatre in February 2027. The production became the fastest-selling show in the history of the Bush Theatre Studio, selling out its entire run within two weeks.</div>\n<div></div>\n<div class=\"waffle-background-container\">He is now developing a TV adaptation of the show with production company The Story Collective. Laith is currently writing a feature film for Imaginarium Productions and is under a seed commission for his latest play with Good Chance Theatre. Previously, he has participated in writers rooms for the BBC&#8217;s <em>Bad Education</em> and BAFTA-award winning <em>Crongton. </em></div>\n<div></div>\n<div class=\"waffle-background-container\">Laith is the founder of the British-Arab Writers Group, a collective of over 250 Arab writers based in the UK. The group organises writers’ rooms, industry talks, workshops, and social events, fostering a sense of community and shared growth. Laith&#8217;s recent achievements include being selected for the BBC Comedy Collective Supercharged Bursary Scheme, which included a prize of £15k and paid shadowing opportunities on BBC productions’ writers rooms; and winning a bursary at the Screenshot Showcase produced by Sister Pictures and SOTR Productions.</div>\n<div></div>\n<div class=\"waffle-background-container\">He also produces the viral online show <em>Food I Can’t Read,</em> where his friend Faz eats food he can’t read. It has inexplicably racked up over 50 million total views since the show’s launch in 2025.</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-3939\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Emily Ling Williams</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-3939\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                          <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                        <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2025/03/headshot-emily-ling-williams-scaled-1-320x480.jpg\" alt=\"\" />\r\n                      </div> <!-- / Image Container -->\r\n                                        <p class=\"h3\" >Emily Ling Williams</p>\r\n                                          <p class=\"h5\" >Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Emily Ling Williams&#8217;</strong> work has been nominated for an Olivier Award and she was the recipient of the 2023 Stage Debut Award for Best Director.</p>\n<p>As Director: <em>No Such Thing As Wolves</em> (Birmingham Hippodrome); <em>Romeo &amp; Juliet</em> (Stratford East); <em>Insane Asylum Seekers, A Playlist For The Revolution</em> (Bush Theatre); <em>Sam Wu is NOT Afraid of Ghosts</em> (Polka Theatre); <em>More Ghost Stories by Candlelight</em> (Hightide/ Globe Theatre); Polko (Roundabout); <em>Wasted</em> (Lyric Hammersmith); <em>The Full Works; The Key Workers Cycle</em> (Almeida), <em>text me when you’re home; 5 Plays</em> (Young Vic); <em>The Watsons, Her Naked Skin, Appropriate, The Sign In Sidney Brustein’s Window</em> (RWCMD); <em>Turbines</em> (Paines Plough/ RWCMD/ Gate Theatre).</p>\n<p>As Assistant/Associate Director:<em> Small Hotel</em> (Theatre Royal Bath); <em>A View From The Bridge</em> (Headlong/ Octagon/ CFT/ Rose); <em>The House Of Shades</em> (Almeida); <em>Blood Wedding</em> (Young Vic), <em>The Meeting, The Chalk Garden</em> (CFT), <em>Black Mountain, Out Of Love, How To Be A Kid</em> (Paines Plough/ Theatr Clwyd/ Orange Tree); <em>The Apology, The Island Nation</em> (Arcola).</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15352\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Samia Djilli</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Producer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15352\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Samia Djilli</p>\r\n                                          <p class=\"h5\" >Producer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\"><strong>Samia Djilli</strong> is a British-Algerian producer working across the subsidised and commercial theatre sectors. She has worked with organisations including Kali Theatre, Tamasha, Shubbak Festival and Zoo Co, where she is currently Producer.</span></p>\n<p><span style=\"font-weight: 400\">Alongside Sarah Allen, Samia produced the 2024 Soho Theatre production </span><i><span style=\"font-weight: 400\">Vitamin D</span></i><span style=\"font-weight: 400\">. She has trained with Stage One, was selected for the Stage One New York Producers Exchange in 2024, and is a current Stage One bursary recipient.</span></p>\n<p><span style=\"font-weight: 400\">Her work is particularly focused on championing Arab, SWANA and Muslim stories, supporting artists and productions that broaden representation and bring underrepresented voices to new audiences.</span></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-5572\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Sarah Allen</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Producer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-5572\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                          <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                        <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2025/03/Sarah-Allen-320x480.jpeg\" alt=\"\" />\r\n                      </div> <!-- / Image Container -->\r\n                                        <p class=\"h3\" >Sarah Allen</p>\r\n                                          <p class=\"h5\" >Producer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\">Sarah Allen is a producer from Somerset based in London. In 2020, she graduated from The Royal Central School of Speech and Drama with an MA in Creative Producing. She currently works for ATG Entertainment. </span></p>\n<p><span style=\"font-weight: 400\">Previous theatre work includes </span><i><span style=\"font-weight: 400\">Dreaming and Drowning </span></i><span style=\"font-weight: 400\">(Bush Theatre), </span><i><span style=\"font-weight: 400\">Vitamin D </span></i><span style=\"font-weight: 400\">(national tour), </span><i><span style=\"font-weight: 400\">Ladyfriends </span></i><span style=\"font-weight: 400\">(Hope Mill, Shakespeare North Playhouse), </span><i><span style=\"font-weight: 400\">Fame Whore </span></i><span style=\"font-weight: 400\">(King’s Head Theatre), </span><i><span style=\"font-weight: 400\">All The Happy Things </span></i><span style=\"font-weight: 400\">(Theatre503), </span><i><span style=\"font-weight: 400\">Drop It </span></i><span style=\"font-weight: 400\">R&amp;D (Lighthouse Poole), </span><i><span style=\"font-weight: 400\">Acid’s Reign </span></i><span style=\"font-weight: 400\">(VAULT Festival 2023).</span></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                  </ul> <!-- / Minimal Grid -->\r\n      \r\n    \r\n  </div> <!-- / MW -->\r\n\r\n</section> <!-- / Full Content -->\n                        <section class=\"full_content light_bg show pt_lrg pb_lrg\" aria-label=\"Book Tickets\" id=\"book\">\n                <div class=\"mw_1200\">\n                    <p class=\"h2\">Book tickets</p>\n\n\n                        \n                                            <div class=\"event_filter\">\n                            <div cl