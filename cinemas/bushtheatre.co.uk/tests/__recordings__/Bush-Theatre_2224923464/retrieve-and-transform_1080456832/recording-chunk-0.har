ed=\"false\" aria-haspopup=\"true\" >\n\t\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/search.svg\" alt=\"search icon\" />\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t</div> <!-- / Site Search Icon -->\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div> <!-- / Links -->\n\t\t\t\t\t\t\t\t<div class=\"subnav__menu\"  > <!-- Menu -->\n\t\t\t\t\t\t\t\t\t<a href=\"#menu-popout\" class=\"subnav__menu-hamburger toggleButton\" aria-controls=\"navigation\" aria-expanded=\"false\" aria-haspopup=\"true\" ><img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" /></a>\n\t\t\t\t\t\t\t\t</div> <!-- / Menu -->\n\t\t\t\t\t\t\t</div> <!-- / Sub Nav -->\n\n\t\t\t\t\t\t</div> <!-- / Main Nav -->\n\n\t\t\t\t\t\t<div class=\"nav_icon\"><!-- Nav Icon -->\n\t\t\t\t\t\t\t<a href=\"#mobile-navigation\">\n\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" />\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div> <!-- / Nav Icon -->\n\n\t\t\t\t\t</div> <!-- / Nav Wrapper -->\n\n\t\t\t\t\t\n\t\t\t\t\t</div> <!-- / Logo Nav Holder -->\n\n\t\t\t\t</div> <!-- / Max Width -->\n\t\t\t</div> <!-- / Full Content -->\n\n\t\t</header><!-- #masthead -->\n\n\t\t<div id=\"content\" class=\"site-content\">\n\n\t\t<div id=\"primary\" class=\"content-area event\">\n    <main id=\"main\" class=\"site-main\">\n\n    \n        \n<section class=\"event_header\"> <!-- Event Header -->\n        <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/05/im-not-being-funny-web-2.png\" alt=\"\" class=\"event_header__image event_header__image--center\">\n    \n    <div class=\"event_header__intro\"> <!-- Event Intro -->\n        <div class=\"event_header__intro_holder\">\n            <div class=\"event_header__intro_text\">\n                <h1 class=\"alt_heading\">Shifters (New York)</h1>\n\n                                    <p>by Benedict Lombe</p>\n                \n                                    <p class=\"event_header__date\">\n                                                                                                                                                                                                                                                                                            <p class=\"few_dates\">\n                                    30 Aug                                </p>\n                            \n                                                                            <p>Cherry Lane Theatre, New York</p>\n                                            </p>\n                            </div>\n\n            <div class=\"event_header__intro_btn\">\n                                                                                                                                                <a href=\"https://cherrylanetheatre.org/shows/shifters\" class=\"btn\" target=\"_blank\" >Book tickets</a>\n                                                                        </div>\n        </div>\n    </div> <!-- / Event Intro -->\n\n</section> <!-- / Event Header -->\n\n<div class=\"event_nav\"> <!-- Event Nav -->\n    <div class=\"event_nav__width\">\n        <div class=\"event_nav__anchors\">\n            <a href=\"#about\" class=\"event_nav__item\">About</a>\n            \n        </div>\n                    <div class=\"event_nav__book\">\n                                    <a href=\"#book\" class=\"event_nav__item--book btn small btn_no_arrow\">Book tickets</a>\n                            </div>\n            </div>\n</div> <!-- / Event Header -->\n\n<div class=\"event_internal\">\n    <section class=\"full_content dark_bg event_about pt_lrg pb_lrg\" aria-label=\"About Event\" id=\"about\">\n        <div class=\"event_about__row mw_1200\">\n\n            \n                <div class=\"event_about__details green_bg\"> <!-- Details -->\n                    <p class=\"h3 dark\">Details</p>\n\n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Venue</p>\n                            <p class=\"row_value\">Cherry Lane Theatre, New York</p>\n                        </div>\n                    \n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Dates</p>\n                        <p class=\"row_value\">\n                                                                                                                                                                                <p class=\"few_dates\">30 Aug</p>\n                                                    </p>\n                    </div>\n\n                    \n                    \n                     <!-- / Button Repeater -->\n\n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Price</p>\n                        <p class=\"row_value\">\n                                                                                                                                                                                    </p>\n                    </div>\n\n                </div> <!-- / Details -->\n\n            \n            <div class=\"event_about__desc\">\n                <p class=\"h2\">About</p>\n                <h3>Following sold-out runs at the Bush Theatre and in the West End, our electrifying production transfers to New York.</h3>\n<p>Meet Dre and Des, they are young, gifted, Black. He stayed. She left. Years later they come crashing back into each other’s lives, carrying new secrets and old scars. Caught in the space between memory and reality, they struggle to navigate the shifting borders that threaten to rewrite their past and reshape their future.</p>\n<p>This epic and universal love story is about the enduring power of memory and young love. Olivier-nominee <strong>Heather Agyepong</strong> (<em>The Power</em>) reprises her role as Des. <strong>Daniel Ezra</strong> (<em>All American, The Running Man</em>) takes on the role of Dre.</p>\n<p>Written by Bush Emerging Writers&#8217; Group alum <strong>Benedict Lombe</strong> (<em>Lava</em>), directed by <strong>Lynette Linton</strong> (<em>Not Your Superwoman</em>), <em>Shifters</em> &#8220;<strong>redefines the romcom</strong>&#8221; (Financial Times)</p>\n<p>Previews begin 6 July, performances until 30 August 2026, at Cherry Lane Theatre, New York’s oldest Off-Broadway theatre.</p>\n\n            </div>\n\n        </div>\n\n                    <div class=\"mw_1200 event_about__desc_extra\">\n                <p class=\"small\">\n                    Produced by Eleanor Lloyd Productions and Chuchu Nwagu Productions, in association with Sonia Friedman Productions. Originally produced and commissioned by the Bush Theatre, with support from Jerwood Foundation and Charles Holloway OBE.                </p>\n            </section>\n\n    \n\n\n<section \n        class=\"full_content testimonial-block\"\n>\n    <!-- Full Content -->\n    <!-- Testimonial Slider -->\n    <div class=\"testimonial-block__slider\">\n                                                    <div class=\"testimonial-block__item purple dark_bg\">\n                    <!-- Item -->\n                    \n                    <div class=\"testimonial-block__slide-wrap mw_960 pt_none pb_sm\">\n                                                                                <div class=\"testimonial-block__rating\">\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\"