h_theatre/images/search.svg\" alt=\"search icon\" />\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t</div> <!-- / Site Search Icon -->\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div> <!-- / Links -->\n\t\t\t\t\t\t\t\t<div class=\"subnav__menu\"  > <!-- Menu -->\n\t\t\t\t\t\t\t\t\t<a href=\"#menu-popout\" class=\"subnav__menu-hamburger toggleButton\" aria-controls=\"navigation\" aria-expanded=\"false\" aria-haspopup=\"true\" ><img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" /></a>\n\t\t\t\t\t\t\t\t</div> <!-- / Menu -->\n\t\t\t\t\t\t\t</div> <!-- / Sub Nav -->\n\n\t\t\t\t\t\t</div> <!-- / Main Nav -->\n\n\t\t\t\t\t\t<div class=\"nav_icon\"><!-- Nav Icon -->\n\t\t\t\t\t\t\t<a href=\"#mobile-navigation\">\n\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" />\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div> <!-- / Nav Icon -->\n\n\t\t\t\t\t</div> <!-- / Nav Wrapper -->\n\n\t\t\t\t\t\n\t\t\t\t\t</div> <!-- / Logo Nav Holder -->\n\n\t\t\t\t</div> <!-- / Max Width -->\n\t\t\t</div> <!-- / Full Content -->\n\n\t\t</header><!-- #masthead -->\n\n\t\t<div id=\"content\" class=\"site-content\">\n\n\t\t<div id=\"primary\" class=\"content-area event\">\n    <main id=\"main\" class=\"site-main\">\n\n    \n        \n<section class=\"event_header\"> <!-- Event Header -->\n        <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/03/Tender-web.png\" alt=\"\" class=\"event_header__image event_header__image--center\">\n            <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/03/tender-story-web-1.png\" alt=\"\" class=\"event_header__image event_header__image--center show_mob\">\n    \n    <div class=\"event_header__intro\"> <!-- Event Intro -->\n        <div class=\"event_header__intro_holder\">\n            <div class=\"event_header__intro_text\">\n                <h1 class=\"alt_heading\">Tender</h1>\n\n                                    <p>by Eleanor Tindall</p>\n                \n                                    <p class=\"event_header__date\">\n                                                                                                                                                                                                                                                            \n                                                                    <p>Until 1 Aug</p>\n                                \n                            \n                                                                            <p>Holloway Theatre (Bush Theatre's main house)</p>\n                                            </p>\n                            </div>\n\n            <div class=\"event_header__intro_btn\">\n                                                                                                                                                <a href=\"#book\" class=\"btn\">Book tickets</a>\n                                                                        </div>\n        </div>\n    </div> <!-- / Event Intro -->\n\n</section> <!-- / Event Header -->\n\n<div class=\"event_nav\"> <!-- Event Nav -->\n    <div class=\"event_nav__width\">\n        <div class=\"event_nav__anchors\">\n            <a href=\"#about\" class=\"event_nav__item\">About</a>\n            <a href=\"#Gallery\" class=\"event_nav__item\">Gallery</a><a href=\"#Cast &amp; Creatives\" class=\"event_nav__item\">Cast &amp; Creatives</a>\n        </div>\n                    <div class=\"event_nav__book\">\n                                    <a href=\"#book\" class=\"event_nav__item--book btn small btn_no_arrow\">Book tickets</a>\n                            </div>\n            </div>\n</div> <!-- / Event Header -->\n\n<div class=\"event_internal\">\n    <section class=\"full_content dark_bg event_about pt_lrg pb_lrg\" aria-label=\"About Event\" id=\"about\">\n        <div class=\"event_about__row mw_1200\">\n\n            \n                <div class=\"event_about__details green_bg\"> <!-- Details -->\n                    <p class=\"h3 dark\">Details</p>\n\n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Venue</p>\n                            <p class=\"row_value\">Holloway Theatre (Bush Theatre's main house)</p>\n                        </div>\n                    \n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Dates</p>\n                        <p class=\"row_value\">\n                                                                                                                                                \n                                                                    <p>Until 1 Aug</p>\n                                                                                    </p>\n                    </div>\n\n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Running time</p>\n                            <p class=\"row_value\">\n                                1 hour 25 minutes                                                            </p>\n                        </div>\n                    \n                    \n                     <!-- Button Repeater -->\n                        <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Content Guidance</p>\n                            <div class=\"btns_container\">\n                                                                                                        <a class=\"btn small\" href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/Tender-Self-Care-Guide-2026-1.pdf\" target=\"_self\">Self Care Guide &amp; Content Guidance</a>\n                                    \n                                                            </div>\n                        </div>\n                     <!-- / Button Repeater -->\n\n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Price</p>\n                        <p class=\"row_value\">\n                                                            £10.00 to £35.00                                                    </p>\n                    </div>\n\n                </div> <!-- / Details -->\n\n            \n            <div class=\"event_about__desc\">\n                <p class=\"h2\">About</p>\n                <h3>Thriller-come-romance <em>Tender</em> transfers to the Bush Theatre’s main house.</h3>\n<p><strong>By turns thrilling and surreal,<em> Tender</em> promises to subvert your expectations of queer love stories. Stars Francesca Amewudah-Rivers (Jamie Lloyd&#8217;s <em>Romeo &amp; Juliet</em>) and Nadi Kemp-Sayfi.</strong></p>\n<p><em>“My daydreams are just her now. She is in every corner of my brain, waiting.” </em></p>\n<p>Ivy has life sorted; she’s got a flat, a boyfriend and she knows exactly where it’s all headed. Except there is this thing that she tries not to think about. The thing she left in her childhood bedroom.</p>\n<p>Ash should be having the time of her life. But, fresh out of a bad relationship, she’s full of things she can’t leave behind. And there&#8217;s something off about her new flat. The wallpaper pulses and sometimes it sounds like a heartbeat.</p>\n<p>Two women. A chance encounter that tumbles into infatuation. And an undeniable force waiting just out of sight, ready to wreck it all.</p>\n<p>Playing for a strictly limited run, this upscaled production reunites the original creative team behind the 2024 sold-out Studio hit. The dazzling and moving play by <strong>Eleanor Tindall</strong> (<em>Before I Was A Bear</em>, Soho Theatre) is directed by<strong> Emily Aboud</strong> (<em>Lady Dealer</em>, Bush Theatre).</p>\n\n            </div>\n\n        </div>\n\n                    <div class=\"mw_1200 event_about__desc_extra\">\n                <p class=\"small\">\n                    Presented by Jessie Anand Productions in association with Broccoli Arts and the Bush Theatre.                </p>\n            </section>\n\n    \n\n\n<section \n        class=\"full_content testimonial-block\"\n>\n    <!-- Full Content -->\n    <!-- Testimonial Slider -->\n    <div class=\"testimonial-block__slider\">\n                                                    <div class=\"testimonial-block__item green dark_bg\">\n                    <!-- Item -->\n                    \n                    <div class=\"testimonial-block__slide-wrap mw_960 pt_sm pb_md\">\n                                                                                <div class=\"testimonial-block__rating\">\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                            </div>\n                        \n                        <div class=\"testimonial-block__text\">\n                            <!-- Slide -->\n                                                            <blockquote class=\"testimonial-block__text-quote h1 green_border\">\n                                    <!-- Text Quote -->\n                                    &#8220;Deeply entertaining. Combines the sweetness of a contemporary queer rom-com with the dark underbelly of body horror&#8221;                                </blockquote>\n                            \n                                                            <p class=\"testimonial-block__text-author\">\n                                    <!-- Text Author -->\n                                    &#8211; BroadwayWorld                                </p>\n                                                    </div>\n                    </div>\n                </div>\n                        </div><!-- .testimonial-block__slider -->\n</section>\n\n\n\r\n\r\n\r\n<section\r\n  aria-label=\"Gallery\"id=\"Gallery\"  class=\"full_content\"\r\n> <!-- Full Content -->\r\n\r\n  \r\n  <div class=\"gallery\"> <!-- Gallery -->\r\n\r\n    \r\n      <div class=\"gallery__slider\"> <!-- Gallery Slider -->\r\n\r\n                            <div class=\"gallery__slider_item\"> <!-- Gallery Slider Item -->\r\n              <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/1.png\" title=\"\">\r\n                <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/1-900x600.png\" alt=\"Francesca Amewudah-Rivers sits on a chair holding a script.\" />\r\n              </a>\r\n            </div> <!-- / Gallery Slider Item -->\r\n                      <div class=\"gallery__slider_item\"> <!-- Gallery Slider Item -->\r\n              <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/3.png\" title=\"\">\r\n                <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/3-900x600.png\" alt=\"Nadi Kemp-Sayfi hold s a script in a rehearsal room. Francesca Amewudah-Rivers faces away in the background.\" />\r\n              </a>\r\n            </div> <!-- / Gallery Slider Item -->\r\n                      <div class=\"gallery__slider_item\"> <!-- Gallery Slider Item -->\r\n              <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/12.png\" title=\"\">\r\n                <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/12-900x600.png\" alt=\"Emily Aboud looks towards Nadi Kemp-Sayfi in a rehearsal room.\" />\r\n              </a>\r\n            </div> <!-- / Gallery Slider Item -->\r\n                      <div class=\"gallery__slider_item\"> <!-- Gallery Slider Item -->\r\n              <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/11.png\" title=\"\">\r\n                <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/11-900x600.png\" alt=\"Francesca Amewudah-Rivers sits cross-legged on a chair. Nadi Kemp-Sayfi sits in the foreground.\" />\r\n              </a>\r\n            </div> <!-- / Gallery Slider Item -->\r\n                      <div class=\"gallery__slider_item\"> <!-- Gallery Slider Item -->\r\n              <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/14.png\" title=\"\">\r\n                <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/14-900x600.png\" alt=\"Rehearsal photo: Nadi Kemp-Sayfi sits on the floor in a rehearsal room.\" />\r\n              </a>\r\n            </div> <!-- / Gallery Slider Item -->\r\n                      <div class=\"gallery__slider_item\"> <!-- Gallery Slider Item -->\r\n              <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/7.png\" title=\"\">\r\n                <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/7-900x600.png\" alt=\"Francesca Amewudah-Rivers sits on a chair holding a script.\" />\r\n              </a>\r\n            </div> <!-- / Gallery Slider Item -->\r\n                      <div class=\"gallery__slider_item\"> <!-- Gallery Slider Item -->\r\n              <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/13.png\" title=\"\">\r\n                <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/13-900x600.png\" alt=\"Nadi Kemp-Sayfi smils towards Francesca Amewudah-Rivers in a rehearsal room. Emily Aboud sits in the background.\" />\r\n              </a>\r\n            </div> <!-- / Gallery Slider Item -->\r\n                      <div class=\"gallery__slider_item\"> <!-- Gallery Slider Item -->\r\n              <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/10.png\" title=\"\">\r\n                <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/10-900x600.png\" alt=\"Francesca Amewudah-Rivers sits on a chair holding a script. Emily Aboud and Nadi-Kemp-Sayfi stand in the foreground.\" />\r\n              </a>\r\n            </div> <!-- / Gallery Slider Item -->\r\n                      <div class=\"gallery__slider_item\"> <!-- Gallery Slider Item -->\r\n              <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/8.png\" title=\"\">\r\n                <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/8-900x600.png\" alt=\"Nadi Kemp-Sayfi sits on the floor of a rehearsal room, speaking to Francesca Amewudah-Rivers.\" />\r\n              </a>\r\n            </div> <!-- / Gallery Slider Item -->\r\n                      <div class=\"gallery__slider_item\"> <!-- Gallery Slider Item -->\r\n              <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/9.png\" title=\"\">\r\n                <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/9-900x600.png\" alt=\"Emily Aboud looks towards Francesca Amewudah-Rivers.\" />\r\n              </a>\r\n            </div> <!-- / Gallery Slider Item -->\r\n                      <div class=\"gallery__slider_item\"> <!-- Gallery Slider Item -->\r\n              <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/6.png\" title=\"\">\r\n                <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/6-900x600.png\" alt=\"Rehearsal photo: Nadi Kemp-Sayfi sits on the floor in a rehearsal room, speaking on a phone.\" />\r\n              </a>\r\n            </div> <!-- / Gallery Slider Item -->\r\n                      <div class=\"gallery__slider_item\"> <!-- Gallery Slider Item -->\r\n              <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/4.png\" title=\"\">\r\n                <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/4-900x600.png\" alt=\"Francesca Amewudah-Rivers stands smiling in a rehearsal room.\" />\r\n              </a>\r\n            </div> <!-- / Gallery Slider Item -->\r\n                      <div class=\"gallery__slider_item\"> <!-- Gallery Slider Item -->\r\n              <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/5.png\" title=\"\">\r\n                <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/5-900x600.png\" alt=\"Rehearsal photo: Nadi Kemp-Sayfi sits on the floor in a rehearsal room.\" />\r\n              </a>\r\n            </div> <!-- / Gallery Slider Item -->\r\n                      <div class=\"gallery__slider_item\"> <!-- Gallery Slider Item -->\r\n              <a href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/2.png\" title=\"\">\r\n                <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/07/2-900x600.png\" alt=\"Emily Aboud speaks to Nadi Kemp-Sayfi in a rehearsal room. Nadi holds a script.\" />\r\n              </a>\r\n            </div> <!-- / Gallery Slider Item -->\r\n                  \r\n      </div> <!-- / Gallery Slider -->\r\n\r\n    \r\n  </div> <!-- / Gallery -->\r\n\r\n</section> <!-- / Full Content -->\n\n\n\n\n<section \n        class=\"full_content testimonial-block\"\n>\n    <!-- Full Content -->\n    <!-- Testimonial Slider -->\n    <div class=\"testimonial-block__slider\">\n                                                    <div class=\"testimonial-block__item green dark_bg\">\n                    <!-- Item -->\n                    \n                    <div class=\"testimonial-block__slide-wrap mw_960 pt_md pb_md\">\n                                                                                <div class=\"testimonial-block__rating\">\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                                    <svg id=\"Layer_2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 315.77 300.62\">\n                                        <defs>\n                                            <style>.cls-1{fill:currentColor;}</style>\n                                        </defs>\n                                        <g id=\"Layer_1-2\">\n                                            <polygon class=\"cls-1\" points=\"256.05 300.01 158.28 238.89 60.89 300.62 88.81 188.75 0 115.21 115.03 107.19 157.53 0 200.7 106.92 315.77 114.22 227.43 188.31 256.05 300.01\"></polygon>\n                                        </g>\n                                    </svg>\n                                                            </div>\n                        \n                        <div class=\"testimonial-block__text\">\n                            <!-- Slide -->\n                                                            <blockquote class=\"testimonial-block__text-quote h1 green_border\">\n                                    <!-- Text Quote -->\n                                    “An engrossing exploration of repressed sexuality, self-discovery, and the search for belonging”                                 </blockquote>\n                            \n                                                            <p class=\"testimonial-block__text-author\">\n                                    <!-- Text Author -->\n                                    &#8211; The Voice Magazine                                </p>\n                                                    </div>\n                    </div>\n                </div>\n                        </div><!-- .testimonial-block__slider -->\n</section>\n\n\n\r\n\r\n\r\n<section\r\n    class=\"full_content dark_bg pt_sm pb_sm\"\r\n> <!-- Full Content -->\r\n\r\n  <div class=\"embed mw_960 text_center\"> <!-- MW -->\r\n\r\n    \r\n    \r\n          <div class=\"embed__code\"><iframe width=\"315\" height=\"560\"\r\nsrc=\"https://www.youtube.com/embed/3GIzX2YQSV4\"\r\ntitle=\"YouTube video player\"\r\nframeborder=\"0\"\r\nallow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\r\nallowfullscreen></iframe></div>\r\n    \r\n  </div> <!-- / MW -->\r\n\r\n</section> <!-- / Full Content -->\n\n\r\n\r\n\r\n<section\r\n  aria-label=\"Cast &#038; Creatives\"id=\"Cast &#038; Creatives\"  class=\"full_content team-listing light_bg pt_md pb_sm\"\r\n> <!-- Full Content -->\r\n\r\n  <div class=\"mw_1200 no_text_center\"> <!-- MW -->\r\n\r\n    <p class=\"h2\">Cast &#038; Creatives</p><div class=\"team-listing__spacer\" ></div>\r\n    \r\n    \r\n    \r\n              <ul class=\"team-listing__grid horizontal\" > <!-- Grid -->\r\n                      <li class=\"team-listing__post horizontal\" > <!-- Post -->\r\n                                  <div class=\"team-listing__post-image horizontal\" > <!-- Image Container -->\r\n                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2025/03/77-320x480.png\" alt=\"Headshot of Francesca Amewudah-Rivers.\" />\r\n                  </div> <!-- / Image Container -->\r\n                                <div class=\"team-listing__post-info\" > <!-- Info Container -->\r\n                  <div>\r\n                    <div class=\"heading\" >\r\n                      <p class=\"title\" >Francesca Amewudah-Rivers</p>\r\n                                              <p>Cast Member</p>\r\n                                          </div>\r\n                                          <p class=\"small_text\" >Francesca won the Ian Charleson Award in 2025 for her performance as Juliet in Romeo and Juliet (Jamie Lloyd Company / West End). She also won the award for Best Newcomer at&hellip;</p>\r\n                                      </div>\r\n                  <div>\r\n                    <a href=\"#team-listing-item-4021\" class=\"link alt team-listing__popup-link\" >Read More</a>\r\n\r\n                    <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-4021\" > <!-- Pop-up -->\r\n                      <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                        <span>X</span>\r\n                      </button>\r\n                      <div class=\"team-listing__popup-content horizontal\" > <!-- Content -->\r\n                                                  <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                            <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2025/03/77-320x480.png\" alt=\"Headshot of Francesca Amewudah-Rivers.\" />\r\n                          </div> <!-- / Image Container -->\r\n                                                <p class=\"h3\" >Francesca Amewudah-Rivers</p>\r\n                                                  <p class=\"h5\" >Cast Member</p>\r\n                                                <div class=\"divider\" ></div>\r\n                                                  <p><span style=\"font-weight: 400\">Francesca won the Ian Charleson Award in 2025 for her performance as Juliet in </span><i><span style=\"font-weight: 400\">Romeo and Juliet </span></i><span style=\"font-weight: 400\">(Jamie Lloyd Company / West End). She also won the award for Best Newcomer at the 2025 Critics’ Circle Theatre Awards. </span></p>\n<p><strong>Other theatre includes: </strong><i><span style=\"font-weight: 400\">The Line of Beauty</span></i><span style=\"font-weight: 400\"> (Almeida); </span><i><span style=\"font-weight: 400\">School Girls; or, The African Mean Girls Play</span></i><span style=\"font-weight: 400\"> (Lyric Hammersmith); </span><i><span style=\"font-weight: 400\">Macbeth </span></i><span style=\"font-weight: 400\">(Shakespeare’s Globe) and </span><i><span style=\"font-weight: 400\">The Kola Nut Does Not Speak English</span></i><span style=\"font-weight: 400\"> (Bush Theatre). </span></p>\n<p><span style=\"font-weight: 400\"><strong>Screen work includes:</strong> </span><i><span style=\"font-weight: 400\">Bad Education;</span></i><i><span style=\"font-weight: 400\"> Jobless</span></i><span style=\"font-weight: 400\"> (short); </span><i><span style=\"font-weight: 400\">Earl Grey </span></i><span style=\"font-weight: 400\">and</span><i><span style=\"font-weight: 400\"> Notice Me</span></i><span style=\"font-weight: 400\"> (short).</span></p>\n<p><span style=\"font-weight: 400\">Francesca trained with the NYT Rep Company.</span></p>\n                                                <div class=\"clear\"></div>\r\n                      </div> <!-- / Content -->\r\n                    </div> <!-- / Pop-up -->\r\n\r\n                  </div>\r\n                </div> <!-- / Info Container -->\r\n            </li> <!-- / Post -->\r\n                      <li class=\"team-listing__post horizontal\" > <!-- Post -->\r\n                                  <div class=\"team-listing__post-image horizontal\" > <!-- Image Container -->\r\n                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2025/03/76-320x480.png\" alt=\"Headshot of Nadi Kemp-Sayfi.\" />\r\n                  </div> <!-- / Image Container -->\r\n                                <div class=\"team-listing__post-info\" > <!-- Info Container -->\r\n                  <div>\r\n                    <div class=\"heading\" >\r\n                      <p class=\"title\" >Nadi Kemp-Sayfi</p>\r\n                                              <p>Cast Member</p>\r\n                                          </div>\r\n                                          <p class=\"small_text\" >Theatre includes: Sherlock Holmes (Regent’s Park Open Air); Cymbeline, Hakawatis, The Tempest, Much Ado About Nothing, Hamlet, Twelfth Night, A Midsummer Night’s Dream, As You Like It, Hansel and Gretel&hellip;</p>\r\n                                      </div>\r\n                  <div>\r\n                    <a href=\"#team-listing-item-5045\" class=\"link alt team-listing__popup-link\" >Read More</a>\r\n\r\n                    <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-5045\" > <!-- Pop-up -->\r\n                      <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                        <span>X</span>\r\n                      </button>\r\n                      <div class=\"team-listing__popup-content horizontal\" > <!-- Content -->\r\n                                                  <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                            <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2025/03/76-320x480.png\" alt=\"Headshot of Nadi Kemp-Sayfi.\" />\r\n                          </div> <!-- / Image Container -->\r\n                                                <p class=\"h3\" >Nadi Kemp-Sayfi</p>\r\n                                                  <p class=\"h5\" >Cast Member</p>\r\n                                                <div class=\"divider\" ></div>\r\n                                                  <p><span style=\"font-weight: 400\"><strong>Theatre includes:</strong> </span><i><span style=\"font-weight: 400\">Sherlock Holmes</span></i><span style=\"font-weight: 400\"> (Regent’s Park Open Air); </span><i><span style=\"font-weight: 400\">Cymbeline</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Hakawatis</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">The Tempest</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Much Ado About Nothing</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Hamlet</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Twelfth Night</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">A Midsummer Night’s Dream</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">As You Like It</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Hansel and Gretel</span></i><span style=\"font-weight: 400\"> (all Shakespeare’s Globe); </span><i><span style=\"font-weight: 400\">Julius Caesar</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">The Whip</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">A Museum in Baghdad</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">King John</span></i><span style=\"font-weight: 400\"> (all RSC); </span><i><span style=\"font-weight: 400\">101 Dalmatians</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Between The Two</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Three Wheels on the Wagon</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">The Witches’ Promise</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Under The Stars</span></i><span style=\"font-weight: 400\"> (all Birmingham Rep); </span><i><span style=\"font-weight: 400\">Macbeth</span></i><span style=\"font-weight: 400\"> (Donmar Warehouse); </span><i><span style=\"font-weight: 400\">Tender</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Hijabi Monologues</span></i><span style=\"font-weight: 400\"> (both Bush); </span><i><span style=\"font-weight: 400\">Macbeth</span></i><span style=\"font-weight: 400\"> (ETT); </span><i><span style=\"font-weight: 400\">Bedroom Farce</span></i><span style=\"font-weight: 400\"> (Queen’s Theatre Hornchurch).</span></p>\n<p><strong>TV includes: </strong><i><span style=\"font-weight: 400\">EastEnders</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Charity Shop Sue</span></i><span style=\"font-weight: 400\">.</span></p>\n<p><strong>Radio includes: </strong><i><span style=\"font-weight: 400\">The Archers</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Words and Music</span></i><span style=\"font-weight: 400\">.</span></p>\n                                                <div class=\"clear\"></div>\r\n                      </div> <!-- / Content -->\r\n                    </div> <!-- / Pop-up -->\r\n\r\n                  </div>\r\n                </div> <!-- / Info Container -->\r\n            </li> <!-- / Post -->\r\n                  </ul>\r\n      \r\n    \r\n  </div> <!-- / MW -->\r\n\r\n</section> <!-- / Full Content -->\n\n\r\n\r\n\r\n<section\r\n    class=\"full_content team-listing light_bg pt_none pb_sm\"\r\n> <!-- Full Content -->\r\n\r\n  <div class=\"mw_1200 no_text_center\"> <!-- MW -->\r\n\r\n    <div class=\"team-listing__spacer\" ></div>\r\n    \r\n    \r\n    \r\n              <ul class=\"team-listing__minimal-grid\" > <!-- Minimal Grid -->\r\n                      <li>\r\n              <a href=\"#team-listing-item-3903\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Eleanor Tindall</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Writer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-3903\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                          <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                        <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2025/03/elly-portrait-edit-2-of-6-scaled-1-320x480.jpg\" alt=\"\" />\r\n                      </div> <!-- / Image Container -->\r\n                                        <p class=\"h3\" >Eleanor Tindall</p>\r\n                                          <p class=\"h5\" >Writer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\">Eleanor is a writer from London. </span></p>\n<p><strong>Theatre includes: </strong><i><span style=\"font-weight: 400\">Before I Was A Bear </span></i><span style=\"font-weight: 400\">(Soho); </span><i><span style=\"font-weight: 400\">Macbeth</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Something Wicked</span></i><span style=\"font-weight: 400\"> (Donmar Warehouse Schools Tour); </span><i><span style=\"font-weight: 400\">Tender</span></i><span style=\"font-weight: 400\"> (Bush); </span><i><span style=\"font-weight: 400\">I Am Asking You To Touch Me</span></i><span style=\"font-weight: 400\"> (National Youth Theatre).</span></p>\n<p><span style=\"font-weight: 400\">Previously, Eleanor’s play </span><i><span style=\"font-weight: 400\">What If Orpheus Was Four Sad Women</span></i><span style=\"font-weight: 400\"> was one of five plays shortlisted for the 2024 Verity Bargate Award, and was longlisted for the 2025 Bruntwood Prize and commissioned by Soho Theatre as part of their ReDraft scheme. She has been a member of various writers’ programmes, including Soho Theatre Writers Lab, and was part of the BBC Voices cohort in 2024. She was nominated for Best Writer at the Stage Debut Awards in 2020 for her first play </span><i><span style=\"font-weight: 400\">Before I Was A Bear</span></i><span style=\"font-weight: 400\">. </span></p>\n<p><i><span style=\"font-weight: 400\">Tender</span></i><span style=\"font-weight: 400\"> was a finalist for the Ambassador Theatre Group’s Playwriting Prize in association with Platform Presents.</span></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-3932\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Emily Aboud</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-3932\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                          <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                        <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2025/03/Emily-Aboud-320x480.jpg\" alt=\"\" />\r\n                      </div> <!-- / Image Container -->\r\n                                        <p class=\"h3\" >Emily Aboud</p>\r\n                                          <p class=\"h5\" >Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\">Emily is a Trinidadian theatre director and playwright. </span></p>\n<p><span style=\"font-weight: 400\">She was shortlisted for RTST Peter Hall Award in 2025 and 2023 and shortlisted for the JMK Award in 2022 and 2021. She is a recipient of the Evening Standard Future Theatre Award, and wrote </span><i><span style=\"font-weight: 400\">Insurrection: A Work in Progress</span></i><span style=\"font-weight: 400\"> for the Royal Opera House. As a Caribbean theatre maker, her work draws inspiration from the political community theatre she grew up making in Trinidad – a combination of music, movement, direct audience address and theatricality.</span></p>\n<p><strong>Theatre includes:</strong></p>\n<p><strong>As Director: </strong><i><span style=\"font-weight: 400\">Nine Sixteenths</span></i><span style=\"font-weight: 400\"> (Brixton House); </span><i><span style=\"font-weight: 400\">Disco Inferno </span></i><span style=\"font-weight: 400\">(National Youth Theatre); </span><i><span style=\"font-weight: 400\">Omeros</span></i><span style=\"font-weight: 400\"> (Jermyn Street); </span><i><span style=\"font-weight: 400\">Sweet Charity</span></i><span style=\"font-weight: 400\"> (Mountview); </span><i><span style=\"font-weight: 400\">Rock DJ and Three </span></i><i><span style=\"font-weight: 400\">Other Songs That Saved the World</span></i><span style=\"font-weight: 400\"> (New Diorama); </span><i><span style=\"font-weight: 400\">FLIP!</span></i><span style=\"font-weight: 400\"> (Regional tour / Soho); </span><i><span style=\"font-weight: 400\">Lady Dealer</span></i><span style=\"font-weight: 400\"> (Paines Plough Roundabout / Bush); </span><i><span style=\"font-weight: 400\">SPLINTERED </span></i><span style=\"font-weight: 400\">(Soho Main House, also writer); </span><i><span style=\"font-weight: 400\">BOGEYMAN</span></i><span style=\"font-weight: 400\"> (Edinburgh Fringe 2022, also writer); </span><i><span style=\"font-weight: 400\">Pink Lemonade </span></i><span style=\"font-weight: 400\">(Bush).</span></p>\n<p><span style=\"font-weight: 400\"><strong>As Associate Director:</strong> </span><i><span style=\"font-weight: 400\">The Harder They Come</span></i><span style=\"font-weight: 400\"> (Stratford East); </span><i><span style=\"font-weight: 400\">The Story</span></i><span style=\"font-weight: 400\"> (National Theatre); </span><i><span style=\"font-weight: 400\">Going Through</span></i><span style=\"font-weight: 400\"> (Bush);</span><i><span style=\"font-weight: 400\"> Tijean and His Brothers</span></i><span style=\"font-weight: 400\"> (Queen’s Hall, Trinidad).</span></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-2981\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Alys Whitehead</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Set and Costume Designer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-2981\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Alys Whitehead</p>\r\n                                          <p class=\"h5\" >Set and Costume Designer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\">Alys is a Set and Costume Designer who trained at Central Saint Martins. She was a Resident Designer at the New Diorama Broadgate studios and was a 2024 JMK finalist. </span></p>\n<p><strong>Theatre includes:</strong></p>\n<p><span style=\"font-weight: 400\"><strong>As Designer:</strong> </span><i><span style=\"font-weight: 400\">Welcome to Pemfort</span></i><span style=\"font-weight: 400\"> (Soho); </span><i><span style=\"font-weight: 400\">Dido and Aeneas</span></i><span style=\"font-weight: 400\"> (Longborough Festival Opera); </span><i><span style=\"font-weight: 400\">Gullivers Reisen</span></i><span style=\"font-weight: 400\"> (Co-Costume Designer with Rosanna Vize, Deutsches Nationaltheater and Staatskapelle Weimar); </span><i><span style=\"font-weight: 400\">Revenge: After the Levoyah</span></i><span style=\"font-weight: 400\"> (The Yard / Soho); </span><i><span style=\"font-weight: 400\">The Da Vinci Code</span></i><span style=\"font-weight: 400\"> (Salisbury Playhouse / Mercury Theatre Colchester); </span><i><span style=\"font-weight: 400\">The Habits </span></i><span style=\"font-weight: 400\">(Hampstead); </span><i><span style=\"font-weight: 400\">Tender</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">This Might Not Be It</span></i><span style=\"font-weight: 400\"> (both Bush); </span><i><span style=\"font-weight: 400\">Bedroom Farce</span></i><span style=\"font-weight: 400\"> (Queen’s Theatre Hornchurch); </span><i><span style=\"font-weight: 400\">The Angry Brigade</span></i><span style=\"font-weight: 400\"> (LAMDA); </span><i><span style=\"font-weight: 400\">Sorry We Didn’t Die At Sea</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Snowflakes</span></i><span style=\"font-weight: 400\"> (both Park); </span><i><span style=\"font-weight: 400\">Lysistrata</span></i><span style=\"font-weight: 400\"> (Lyric Hammersmith); </span><i><span style=\"font-weight: 400\">SAD</span></i><span style=\"font-weight: 400\"> (Omnibus); </span><i><span style=\"font-weight: 400\">Maddie</span></i><span style=\"font-weight: 400\"> (Arcola). </span></p>\n<p><span style=\"font-weight: 400\"><strong>As Associate Designer:</strong> </span><i><span style=\"font-weight: 400\">Macbeth</span></i><span style=\"font-weight: 400\"> (Pinter); </span><i><span style=\"font-weight: 400\">The Glass Menagerie</span></i><span style=\"font-weight: 400\"> (Rose / Belgrade / Alexandra Palace / UK tour); </span><i><span style=\"font-weight: 400\">Earthworks</span></i><span style=\"font-weight: 400\"> (Young Vic); </span><i><span style=\"font-weight: 400\">Wordplay</span></i><span style=\"font-weight: 400\"> (Royal Court). </span></p>\n<p>&nbsp;</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-3764\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>David Doyle</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Lighting Designer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-3764\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >David Doyle</p>\r\n                                          <p class=\"h5\" >Lighting Designer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\">David is a multi-award-winning lighting designer from Ireland.</span></p>\n<p><strong>Lighting work includes: </strong><i><span style=\"font-weight: 400\">Tender</span></i><span style=\"font-weight: 400\"> (Bush); </span><i><span style=\"font-weight: 400\">Outlying Islands</span></i><span style=\"font-weight: 400\"> (Jermyn Street);</span><i><span style=\"font-weight: 400\"> Bellringers </span></i><span style=\"font-weight: 400\">(Hampstead / Paines Plough Roundabout); </span><i><span style=\"font-weight: 400\">Bullring Techno Makeout Jamz</span></i><span style=\"font-weight: 400\"> (Royal Court / Paines Plough Roundabout / UK tour); </span><i><span style=\"font-weight: 400\">we were promised honey! </span></i><span style=\"font-weight: 400\">(59E59 / Paines Plough Roundabout / UK and International tour); </span><i><span style=\"font-weight: 400\">Life According to Saki</span></i><span style=\"font-weight: 400\"> (New York Theatre Workshop / Edinburgh Fringe); </span><i><span style=\"font-weight: 400\">Skye: A Thriller</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Baby in the Mirror</span></i><span style=\"font-weight: 400\">,</span><i><span style=\"font-weight: 400\"> Instructions</span></i><span style=\"font-weight: 400\">,</span><i><span style=\"font-weight: 400\"> Little Deaths</span></i><span style=\"font-weight: 400\"> (all Summerhall, Edinburgh Fringe);</span><i><span style=\"font-weight: 400\"> SAP</span></i><span style=\"font-weight: 400\"> (Paines Plough Roundabout / Soho / UK tour); </span><i><span style=\"font-weight: 400\">Nation </span></i><span style=\"font-weight: 400\">(Paines Plough Roundabout); </span><i><span style=\"font-weight: 400\">Boy in Da Korma</span></i><span style=\"font-weight: 400\"> (Jermyn Street / Pleasance); </span><i><span style=\"font-weight: 400\">Fabulous Creatures</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Anna Bella Eema</span></i><span style=\"font-weight: 400\"> (both Arcola); </span><i><span style=\"font-weight: 400\">Carmen</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">EAST</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Outlying Islands</span></i><span style=\"font-weight: 400\"> (all King’s Head); </span><i><span style=\"font-weight: 400\">The Last Show Before We Die</span></i><span style=\"font-weight: 400\"> (The Yard / Bristol Old Vic / Paines Plough Roundabout); </span><i><span style=\"font-weight: 400\">Douze</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">The Power of Wow</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Confirmation</span></i><span style=\"font-weight: 400\"> (UK and Ireland tour); </span><i><span style=\"font-weight: 400\">ADMIN </span></i><span style=\"font-weight: 400\">(Project Arts Centre / Irish tour); </span><i><span style=\"font-weight: 400\">Brendan Galileo For Europe</span></i><span style=\"font-weight: 400\"> (Irish tour); </span><i><span style=\"font-weight: 400\">Richard Carpenter is Close to You</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">My Name is Saoirse</span></i><span style=\"font-weight: 400\"> (both International tour).</span></p>\n<p><span style=\"font-weight: 400\">David also works as a producer and is currently the Co-Artistic Director and </span><span style=\"font-weight: 400\">Executive Producer for Jermyn Street Theatre.</span></p>\n<p>&nbsp;</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-3920\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Ellie Isherwood</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Sound Designer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-3920\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Ellie Isherwood</p>\r\n                                          <p class=\"h5\" >Sound Designer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\">Ellie is a sound designer, composer, actor-musician and synth-pop artist (BYFYN). Her “dynamic” and “quietly ground breaking” work spans musicals and straight plays alike, embracing an array of forms from site-specific theatre to immersive binaural audio experiences. </span></p>\n<p><span style=\"font-weight: 400\">This year, Ellie was made the Associate Artist for the New Wolsey Theatre and was selected as a finalist for the prestigious Stiles and Drewe Best New Song Prize with her song “Nice Girls Never Win” from the upcoming new musical, </span><i><span style=\"font-weight: 400\">VAMP</span></i><span style=\"font-weight: 400\">. </span></p>\n<p><span style=\"font-weight: 400\">Recent work includes performance and composition for the stage adaptation of Lemony Snicket’s </span><i><span style=\"font-weight: 400\">The Dark </span></i><span style=\"font-weight: 400\">and composition and sound design for </span><i><span style=\"font-weight: 400\">Dweeb-A-Mania</span></i><span style=\"font-weight: 400\"> at Polka.  </span></p>\n<p><strong>Other theatre includes: </strong><i><span style=\"font-weight: 400\">Scenes from a Friendship</span></i><span style=\"font-weight: 400\"> (Nottingham Playhouse); </span><i><span style=\"font-weight: 400\">Alice’s Adventures in Wonderland</span></i><span style=\"font-weight: 400\"> (Orange Tree); </span><i><span style=\"font-weight: 400\">Disco Inferno</span></i><span style=\"font-weight: 400\"> (National Youth Theatre); </span><i><span style=\"font-weight: 400\">The Sleep Show</span></i><span style=\"font-weight: 400\">,</span><i><span style=\"font-weight: 400\"> The Intrusion</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Ruby Wax: I&#8217;m Not As Well As I Thought I Was</span></i><span style=\"font-weight: 400\"> (all UK tours); </span><i><span style=\"font-weight: 400\">Cartoonopolis</span></i><span style=\"font-weight: 400\">,</span><i><span style=\"font-weight: 400\"> The Glass Ceiling Beneath the Stars</span></i><span style=\"font-weight: 400\"> (Pleasance); </span><i><span style=\"font-weight: 400\">The Gel</span></i><span style=\"font-weight: 400\"> (New Diorama); </span><i><span style=\"font-weight: 400\">Tender</span></i><span style=\"font-weight: 400\"> (Bush); </span><i><span style=\"font-weight: 400\">The Fir Tree</span></i><span style=\"font-weight: 400\"> (artsdepot); </span><i><span style=\"font-weight: 400\">Son of a Bitch</span></i><span style=\"font-weight: 400\"> (Summerhall, Edinburgh Fringe); </span><i><span style=\"font-weight: 400\">The Odyssey</span></i><span style=\"font-weight: 400\"> (Unicorn); </span><i><span style=\"font-weight: 400\">The Light Princess</span></i><span style=\"font-weight: 400\"> (The Albany, Deptford / ARC – Stockton Arts Centre).</span></p>\n<p>&nbsp;</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-5909\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Tommy Ross-Williams</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Intimacy Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-5909\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Tommy Ross-Williams</p>\r\n                                          <p class=\"h5\" >Intimacy Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\">Tommy (they/them) came to intimacy direction through their extensive experience in developing safer spaces in the arts and their commitment to embodied practice. They are a BECTU IC Registry Level 2 Intimacy Coordinator and former chair of the IC BECTU branch.</span></p>\n<p><strong>Theatre includes: </strong><i><span style=\"font-weight: 400\">Broken Glass</span></i><span style=\"font-weight: 400\"> (Young Vic); </span><i><span style=\"font-weight: 400\">Brokeback Mountain</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">The Little Big Things</span></i><span style=\"font-weight: 400\"> (@SohoPlace); </span><i><span style=\"font-weight: 400\">Two Gentlemen of Verona</span></i><span style=\"font-weight: 400\"> (RSC); </span><i><span style=\"font-weight: 400\">Positive</span></i><span style=\"font-weight: 400\"> (Southwark Playhouse); </span><i><span style=\"font-weight: 400\">Tender</span></i><span style=\"font-weight: 400\"> (Bush); </span><i><span style=\"font-weight: 400\">The Glass Menagerie</span></i><span style=\"font-weight: 400\"> (Rose Theatre Kingston / UK tour); </span><i><span style=\"font-weight: 400\">Just For One Day</span></i><span style=\"font-weight: 400\"> (Old Vic); </span><i><span style=\"font-weight: 400\">As You Like It</span></i><span style=\"font-weight: 400\"> (Shakespeare’s Globe);</span><i><span style=\"font-weight: 400\"> Salty Irina </span></i><span style=\"font-weight: 400\">(Roundabout @ Summerhall, Edinburgh Fringe).  </span><span style=\"font-weight: 400\"><br />\n</span><span style=\"font-weight: 400\"><br />\n</span><strong>Television includes: </strong><i><span style=\"font-weight: 400\">Love Is Blind UK</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Married at First Sight UK</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Honey</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Knight of the Seven Kingdoms</span></i><span style=\"font-weight: 400\">;</span><i><span style=\"font-weight: 400\"> I, Jack Wright</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Sweetpea</span></i><span style=\"font-weight: 400\">;</span><i><span style=\"font-weight: 400\"> Juice</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Slow Horses</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Citadel</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Outrageous</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Human</span></i><span style=\"font-weight: 400\">.</span><span style=\"font-weight: 400\"><br />\n</span><span style=\"font-weight: 400\"><br />\n</span><strong>Film includes: </strong><i><span style=\"font-weight: 400\">The Fantastic Four</span></i><span style=\"font-weight: 400\">: </span><i><span style=\"font-weight: 400\">First Steps</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Black Church Bay</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Ish</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Love and Rage: Munroe Bergdorf</span></i><span style=\"font-weight: 400\">. </span></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-16094\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Sophie Cooch</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Associate Intimacy Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-16094\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Sophie Cooch</p>\r\n                                          <p class=\"h5\" >Associate Intimacy Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\">Sophie is an Intimacy Director and Intimacy Coordinator working across theatre, television, film, audio and performance art. She trained and certified with Intimacy Directors and Coordinators (IDC) in New York under industry pioneers Alicia Rodis and Claire Warden. As an Intimacy Coordinator, Sophie has worked on productions for HBO, Amazon, Apple, Disney, Paramount, Netflix and BBC.</span></p>\n<p><span style=\"font-weight: 400\">Before specialising in intimacy, Sophie spent over a decade working across stage and screen as a professional actor, theatre maker and movement performer, which provided the solid foundation for her work choreographing intimate scenes.</span></p>\n<p><b>Theatre includes: </b><i><span style=\"font-weight: 400\">Romeo &amp; Juliet</span></i><span style=\"font-weight: 400\"> (Stratford East / Sadler&#8217;s Wells); </span><i><span style=\"font-weight: 400\">Les Liaisons Dangereuses</span></i><span style=\"font-weight: 400\"> (Oxford Playhouse); </span><i><span style=\"font-weight: 400\">Blandy</span></i><span style=\"font-weight: 400\"> (Edinburgh Fringe); </span><i><span style=\"font-weight: 400\">Paper Cut</span></i><span style=\"font-weight: 400\"> (Park); </span><i><span style=\"font-weight: 400\">The Frontline</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Chaos</span></i><span style=\"font-weight: 400\"> (both LAMDA); </span><i><span style=\"font-weight: 400\">A Midsummer Night&#8217;s Dream</span></i><span style=\"font-weight: 400\"> (Jesus College, Oxford); </span><i><span style=\"font-weight: 400\">The Lover</span></i><span style=\"font-weight: 400\"> (Keble O’Reilly Theatre); </span><i><span style=\"font-weight: 400\">Spring Awakening</span></i><span style=\"font-weight: 400\"> (OUDS).</span></p>\n<p><b>Screen work includes: </b><i><span style=\"font-weight: 400\">A Knight of the Seven Kingdoms</span></i><span style=\"font-weight: 400\"> S2; </span><i><span style=\"font-weight: 400\">The Lord of the Rings: The Rings of Power</span></i><span style=\"font-weight: 400\"> S3; </span><i><span style=\"font-weight: 400\">Cunk on Life</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Geek Girl</span></i><span style=\"font-weight: 400\">.</span></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-4416\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Jessie Anand Productions</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Producer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-4416\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Jessie Anand Productions</p>\r\n                                          <p class=\"h5\" >Producer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\">Jessie Anand Productions makes theatre and opera that is fresh and playful. Since it was founded in 2018, the company has premiered nine new plays: </span><i><span style=\"font-weight: 400\">Bungalow</span></i><span style=\"font-weight: 400\"> (Theatre503); </span><i><span style=\"font-weight: 400\">Tender</span></i><span style=\"font-weight: 400\"> and </span><i><span style=\"font-weight: 400\">This Might Not Be It</span></i><span style=\"font-weight: 400\"> (both Bush); Tiger (Omnibus); </span><i><span style=\"font-weight: 400\">Orlando</span></i><span style=\"font-weight: 400\"> (59E59, New York / Pleasance, Edinburgh / VAULT Festival); </span><i><span style=\"font-weight: 400\">Pennyroyal </span></i><span style=\"font-weight: 400\">(Finborough); </span><i><span style=\"font-weight: 400\">Yellowfin</span></i><span style=\"font-weight: 400\"> (Southwark Playhouse);</span><i><span style=\"font-weight: 400\"> MAGDALENE</span></i><span style=\"font-weight: 400\"> (Arcola) and </span><i><span style=\"font-weight: 400\">Blue Thunder</span></i><span style=\"font-weight: 400\"> (VAULT Festival). </span></p>\n<p><span style=\"font-weight: 400\">Other productions include the national premieres of Angus Cerini’s Griffin Award-winning play </span><i><span style=\"font-weight: 400\">The Bleeding Tree</span></i><span style=\"font-weight: 400\"> (Southwark Playhouse) and Amy Beach’s 1932 opera </span><i><span style=\"font-weight: 400\">Cabildo</span></i><span style=\"font-weight: 400\"> (Wilton’s Music Hall / Arcola). </span></p>\n<p><span style=\"font-weight: 400\">Jessie Anand Productions is thirteen times Offie-nominated and is supported by Stage One. The company returns to the Bush following the recent success of </span><i><span style=\"font-weight: 400\">Maggots</span></i><span style=\"font-weight: 400\"> in the Studio.</span></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-3564\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Broccoli Arts</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Associate Producer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-3564\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Broccoli Arts</p>\r\n                                          <p class=\"h5\" >Associate Producer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\">Broccoli Arts is a new writing company producing work for and by lesbian, bisexual and queer people who experience misogyny. </span></p>\n<p><strong>Broccoli productions include: </strong><i><span style=\"font-weight: 400\">Tender</span></i><span style=\"font-weight: 400\"> by Eleanor Tindall, </span><i><span style=\"font-weight: 400\">This Might Not Be It</span></i><span style=\"font-weight: 400\"> by Sophia Chetin-Leuner (Bush); </span><i><span style=\"font-weight: 400\">Salty Irina</span></i><span style=\"font-weight: 400\"> by Eve Leigh (Paines Plough Roundabout / Summerhall, Edinburgh Fringe); </span><i><span style=\"font-weight: 400\">Before I Was a Bear</span></i><span style=\"font-weight: 400\"> by Eleanor Tindall (Soho / Bunker). </span></p>\n<p><span style=\"font-weight: 400\">Broccoli was founded by Salome Wagaine and is run by Eve Allin. </span></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-16097\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Titch Gosling</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Production Manager</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-16097\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Titch Gosling</p>\r\n                                          <p class=\"h5\" >Production Manager</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\">Titch has worked as a Production Manager and as a Stage Manager in the West End and on UK and international tours for 19 years.</span></p>\n<p><span style=\"font-weight: 400\"><strong>Theatre includes:</strong> </span><i><span style=\"font-weight: 400\">Public – The Musical</span></i><span style=\"font-weight: 400\"> (Leicester Curve Studio); </span><i><span style=\"font-weight: 400\">Lifeline The Musical</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Maiden Voyage</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">This Is My Family </span></i><span style=\"font-weight: 400\">(all Southwark Playhouse Elephant); </span><i><span style=\"font-weight: 400\">Mrs Armitage on Wheels</span></i><span style=\"font-weight: 400\"> (Royal Festival Hall); </span><i><span style=\"font-weight: 400\">Beautiful Little Fool</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Then, Now &amp; Next</span></i><span style=\"font-weight: 400\"> (both Southwark Playhouse Borough); </span><i><span style=\"font-weight: 400\">Circus 1903</span></i><span style=\"font-weight: 400\"> (Jeddah / Dubai / Dammam / London and UK tour); </span><i><span style=\"font-weight: 400\">How To Fight Loneliness</span></i><span style=\"font-weight: 400\"> (Park); </span><i><span style=\"font-weight: 400\">Rob Brydon: A Night of Songs and Laughter</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">The 13-Storey Treehouse</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Unfortunate</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Black Blues Brothers</span></i> <i><span style=\"font-weight: 400\">Holes</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Avenue Q</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Mr Men</span></i><span style=\"font-weight: 400\">; </span><i><span style=\"font-weight: 400\">Bing Live!</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Egusi Soup </span></i><span style=\"font-weight: 400\">(all UK tour); </span><i><span style=\"font-weight: 400\">Cyrano</span></i><span style=\"font-weight: 400\"> (Park / Edinburgh Fringe Festival); </span><i><span style=\"font-weight: 400\">Duckpond</span></i><span style=\"font-weight: 400\"> (Royal Festival Hall); </span><i><span style=\"font-weight: 400\">Tubular Bells</span></i><span style=\"font-weight: 400\"> (UK &amp; EU tour); </span><i><span style=\"font-weight: 400\">Outlier</span></i><span style=\"font-weight: 400\"> (Theatre Royal, Plymouth); </span><i><span style=\"font-weight: 400\">Kathy and Stella Solve a Murder</span></i><span style=\"font-weight: 400\"> (Edinburgh Fringe / UK Tour / Ambassadors); </span><i><span style=\"font-weight: 400\">Acis &amp; Galatea</span></i><span style=\"font-weight: 400\"> (Stone Nest); </span><i><span style=\"font-weight: 400\">The Night of the Iguana</span></i><span style=\"font-weight: 400\"> (Noel Coward); </span><i><span style=\"font-weight: 400\">Guys and Dolls</span></i><span style=\"font-weight: 400\"> (Royal Albert Hall); </span><i><span style=\"font-weight: 400\">Young Frankenstein</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">The Miser</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Kenneth Branagh Season</span></i><span style=\"font-weight: 400\"> (all Garrick); </span><i><span style=\"font-weight: 400\">Carousel</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">Amour </span></i><span style=\"font-weight: 400\">(Royal Academy of Music); </span><i><span style=\"font-weight: 400\">One Man, Two Guvnors</span></i><span style=\"font-weight: 400\"> (UK / International tour / Haymarket Theatre); </span><span style=\"font-weight: 400\">Watch This Space Festival</span><span style=\"font-weight: 400\"> (National Theatre); </span><i><span style=\"font-weight: 400\">The Little Witch</span></i><span style=\"font-weight: 400\"> (The Place).</span></p>\n<p><span style=\"font-weight: 400\"><strong>TV includes:</strong> Olivier Awards (</span><i><span style=\"font-weight: 400\">Young Frankenstein</span></i><span style=\"font-weight: 400\">); Olivier Awards (Kenneth Branagh Season); </span><i><span style=\"font-weight: 400\">The Phantom of the Opera</span></i><span style=\"font-weight: 400\"> at the Royal Albert Hall (25</span><span style=\"font-weight: 400\">th</span><span style=\"font-weight: 400\"> anniversary performances).</span></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-5142\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Nikita Bala</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Company Stage Manager on Book</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-5142\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Nikita Bala</p>\r\n                                          <p class=\"h5\" >Company Stage Manager on Book</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\"><strong>Theatre includes:</strong> </span><i><span style=\"font-weight: 400\">Godot’s To-Do List</span></i><span style=\"font-weight: 400\"> (Royal Court); </span><i><span style=\"font-weight: 400\">Bengal Tiger at the Baghdad Zoo</span></i><span style=\"font-weight: 400\"> (Young Vic); </span><i><span style=\"font-weight: 400\">The Sleep Show</span></i><span style=\"font-weight: 400\"> (Peut-Être / tour); </span><i><span style=\"font-weight: 400\">Nowhere</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">There’s a Bear on my Chair</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">FLIP!</span></i><span style=\"font-weight: 400\"> (Fuel); </span><i><span style=\"font-weight: 400\">Next Generation: Timon of Athens</span></i><span style=\"font-weight: 400\"> (RSC); </span><i><span style=\"font-weight: 400\">Lady Dealer</span></i><span style=\"font-weight: 400\"> (Grace Dickson, Bush); </span><i><span style=\"font-weight: 400\">The Wolf, the Duck and the Mouse</span></i><span style=\"font-weight: 400\"> (Unicorn); </span><i><span style=\"font-weight: 400\">Godot is a Woman</span></i><span style=\"font-weight: 400\"> (Silent Faces); </span><i><span style=\"font-weight: 400\">Splintered</span></i><span style=\"font-weight: 400\"> (Soho); </span><i><span style=\"font-weight: 400\">Bootycandy</span></i><span style=\"font-weight: 400\"> (Gate).</span></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-16100\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Frankie Neville</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Assistant Stage Manager</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-16100\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Frankie Neville</p>\r\n                                          <p class=\"h5\" >Assistant Stage Manager</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\">Frankie is a freelance stage manager, specialising in assistant stage management and props. They trained at Bristol Old Vic Theatre School.</span></p>\n<p><strong>Theatre includes:</strong></p>\n<p><strong>As Assistant Stage Manager:</strong><i><span style=\"font-weight: 400\"> The Étienne Sisters/dirty butterfly</span></i><span style=\"font-weight: 400\">, </span><i><span style=\"font-weight: 400\">The Beautiful Future is Coming </span></i><span style=\"font-weight: 400\">(both Bristol Old Vic); </span><i><span style=\"font-weight: 400\">Cable Street</span></i><span style=\"font-weight: 400\"> (Marylebone).</span></p>\n<p><strong>As Company Stage Manager: </strong><i><span style=\"font-weight: 400\">The Emu War: Concert Tour</span></i><span style=\"font-weight: 400\"> (National tour).</span></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                  </ul> <!-- / Minimal Grid -->\r\n      \r\n    \r\n  </div> <!-- / MW -->\r\n\r\n</section> <!-- / Full Content -->\n                        <section class=\"full_content light_bg show pt_lrg pb_lrg\" aria-label=\"Book Tickets\" id=\"book\">\n                <div class=\"mw_1200\">\n                    <p class=\"h2\">Book tickets</p>\n\n\n                        \n                                            <div class=\"event_filter\">\n                            <div class=\"event_filter__container\">\n                                <p class=\"h4\">Filter events:</p>\n                                <div class=\"event_filter__buttons\">\n                                    <a href=\"#\" class=\"event_filter__item\" id=\"filter_all\" data-filter=\"\">All</a>\n                                    <a href=\"#\" class=\"event_filter__item press_night\" data-filter=\"press_night\">Press Night</a><a href=\"#\" class=\"event_filter__item matinee\" data-filter=\"matinee\">Matinee</a><a href=\"#\" class=\"event_filter__item relaxed_performance\" data-filter=\"relaxed_performance\">Relaxed Performance</a><a href=\"#\" class=\"event_filter__item captioned\" data-filter=\"capti