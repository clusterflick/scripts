\t<a href=\"#menu-popout\" class=\"subnav__menu-hamburger toggleButton\" aria-controls=\"navigation\" aria-expanded=\"false\" aria-haspopup=\"true\" ><img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" /></a>\n\t\t\t\t\t\t\t\t</div> <!-- / Menu -->\n\t\t\t\t\t\t\t</div> <!-- / Sub Nav -->\n\n\t\t\t\t\t\t</div> <!-- / Main Nav -->\n\n\t\t\t\t\t\t<div class=\"nav_icon\"><!-- Nav Icon -->\n\t\t\t\t\t\t\t<a href=\"#mobile-navigation\">\n\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" />\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div> <!-- / Nav Icon -->\n\n\t\t\t\t\t</div> <!-- / Nav Wrapper -->\n\n\t\t\t\t\t\n\t\t\t\t\t</div> <!-- / Logo Nav Holder -->\n\n\t\t\t\t</div> <!-- / Max Width -->\n\t\t\t</div> <!-- / Full Content -->\n\n\t\t</header><!-- #masthead -->\n\n\t\t<div id=\"content\" class=\"site-content\">\n\n\t\t<div id=\"primary\" class=\"content-area event\">\n    <main id=\"main\" class=\"site-main\">\n\n    \n        \n<section class=\"event_header\"> <!-- Event Header -->\n        <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/EC_BushTheatre_DigitalRollout_Website_1920x1080px.jpg\" alt=\"The Bridge\" class=\"event_header__image event_header__image--center\">\n            <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/EC_BushTheatre_DigitalRollout_Website_1200x1900px.jpg\" alt=\"The Bridge\" class=\"event_header__image event_header__image--center show_mob\">\n    \n    <div class=\"event_header__intro\"> <!-- Event Intro -->\n        <div class=\"event_header__intro_holder\">\n            <div class=\"event_header__intro_text\">\n                <h1 class=\"alt_heading\">The Bridge</h1>\n\n                                    <p>By Alaa Shehada and Sam Beale</p>\n                \n                                    <p class=\"event_header__date\">\n                                                                                                                                                                                                                                                            \n                                                                    <p>28 Oct to 11 Nov</p>\n                                \n                            \n                                                                            <p>Holloway Theatre (Bush Theatre's Main Space)</p>\n                                            </p>\n                            </div>\n\n            <div class=\"event_header__intro_btn\">\n                                                                                                                                                <a href=\"#book\" class=\"btn\">Book tickets</a>\n                                                                        </div>\n        </div>\n    </div> <!-- / Event Intro -->\n\n</section> <!-- / Event Header -->\n\n<div class=\"event_nav\"> <!-- Event Nav -->\n    <div class=\"event_nav__width\">\n        <div class=\"event_nav__anchors\">\n            <a href=\"#about\" class=\"event_nav__item\">About</a>\n            <a href=\"#Cast &amp; Creatives\" class=\"event_nav__item\">Cast &amp; Creatives</a>\n        </div>\n                    <div class=\"event_nav__book\">\n                                    <a href=\"#book\" class=\"event_nav__item--book btn small btn_no_arrow\">Book tickets</a>\n                            </div>\n            </div>\n</div> <!-- / Event Header -->\n\n<div class=\"event_internal\">\n    <section class=\"full_content dark_bg event_about pt_lrg pb_lrg\" aria-label=\"About Event\" id=\"about\">\n        <div class=\"event_about__row mw_1200\">\n\n            \n                <div class=\"event_about__details green_bg\"> <!-- Details -->\n                    <p class=\"h3 dark\">Details</p>\n\n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Venue</p>\n                            <p class=\"row_value\">Holloway Theatre (Bush Theatre's Main Space)</p>\n                        </div>\n                    \n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Dates</p>\n                        <p class=\"row_value\">\n                                                                                                                                                \n                                                                    <p>28 Oct to 11 Nov</p>\n                                                                                    </p>\n                    </div>\n\n                    \n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Age Guidance</p>\n                            <p class=\"row_value\">12+</p>\n                        </div>\n                    \n                     <!-- Button Repeater -->\n                        <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Content Guidance</p>\n                            <div class=\"btns_container\">\n                                                                                                        <a class=\"btn small\" href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/The-Bridge-self-care-guide-2026.pdf\" target=\"_blank\">Self-care guide &amp; content warnings</a>\n                                    \n                                                            </div>\n                        </div>\n                     <!-- / Button Repeater -->\n\n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Price</p>\n                        <p class=\"row_value\">\n                                                            £10.00 to £45.00                                                    </p>\n                    </div>\n\n                </div> <!-- / Details -->\n\n            \n            <div class=\"event_about__desc\">\n                <p class=\"h2\">About</p>\n                <div id=\"\">\n<p><b>Palestinian actor and comedian Alaa Shehada returns following his heartfelt and hilarious Scotsman Fringe First winning debut,</b><b><i> The Horse of Jenin</i></b><b>. </b></p>\n<p><span style=\"font-weight: 400\">Every year, Alaa’s mother sends a gift of separation from her home in Jenin to her sister in Amman. A container of olive oil made from his grandfather’s olive trees. And this year, as every year, Alaa is delivering it himself. </span></p>\n<p><span style=\"font-weight: 400\">Carrying a large yellow container, he leaves his home alongside thousands of other Palestinians. To make this journey he must cross ‘the bridge’ in the heart of Jordan Valley &#8211; the only way Palestinians in the West Bank are permitted to leave or return home. But the container leaks, dripping oil throughout its journey through border crossings, Israeli occupation, and into Jordan.</span></p>\n<p><i><span style=\"font-weight: 400\">The Bridge</span></i><span style=\"font-weight: 400\"> is a very human tale of family and connection, hope and joy, set against the brutal truths of the impacts of colonialism and the broken promises of the British in Palestine. Writer and performer </span><b>Alaa Shehada </b><span style=\"font-weight: 400\">brings his high-energy mix of storytelling, stand-up and physical comedy to the story of his own journey, and the journeys of other travellers who join him on this bizarre road trip. Co-written with and directed by </span><b>Sam Beale</b><span style=\"font-weight: 400\">.</span></p>\n</div>\n\n            </div>\n\n        </div>\n\n                    <div class=\"mw_1200 event_about__desc_extra\">\n                <p class=\"small\">\n                    Presented by Palestine Comedy Club in association with Bush Theatre.                </p>\n            </section>\n\n    \r\n\r\n\r\n<section\r\n  aria-label=\"Cast &#038; Creatives\"id=\"Cast &#038; Creatives\"  class=\"full_content team-listing white_bg pt_sm pb_sm\"\r\n> <!-- Full Content -->\r\n\r\n  <div class=\"mw_1200 no_text_center\"> <!-- MW -->\r\n\r\n    <p class=\"h2\">Cast &#038; Creatives</p><div class=\"team-listing__spacer\" ></div>\r\n    \r\n    \r\n    \r\n              <ul class=\"team-listing__minimal-grid\" > <!-- Minimal Grid -->\r\n                      <li>\r\n              <a href=\"#team-listing-item-9788\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Alaa Shehada</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Writer &amp; Performer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-9788\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                          <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                        <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2025/03/The-Bridge-Brochure-Image-320x480.jpeg\" alt=\"\" />\r\n                      </div> <!-- / Image Container -->\r\n                                        <p class=\"h3\" >Alaa Shehada</p>\r\n                                          <p class=\"h5\" >Writer &amp; Performer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Alaa Shehada</strong> is a Palestinian theatre maker whose work blends physical comedy, storytelling, stand-up and mask performance. A graduate of The Freedom Theatre Acting School in Jenin Refugee Camp – an institution nominated for the Nobel Peace Prize in 2024 – Alaa’s award-winning performances amplify Palestinian experiences on global stages.</p>\n<p>The Horse of Jenin, his &#8220;funny, haunting coming-of-age tale&#8221; (The Guardian) has received international critical acclaim. The show was awarded The Scotsman Fringe First Award and The Outwith Award for international talent at the 2025 Edinburgh Fringe Festival. In 2025, Alaa also joined comedian Bassem Youssef on stage and delivered a TEDx London talk alongside comedian Nish Kumar.</p>\n<p>Alaa is the co-founder and co-artistic director of the Palestine Comedy Club, a pioneering platform for Palestinian comedians to share their stories and culture.</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-13404\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Sam Beale</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Co-writer &amp; Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-13404\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                          <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                        <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2025/11/Sam-Beale-320x480.jpeg\" alt=\"\" />\r\n                      </div> <!-- / Image Container -->\r\n                                        <p class=\"h3\" >Sam Beale</p>\r\n                                          <p class=\"h5\" >Co-writer &amp; Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Dr Sam Beale</strong> is a comedy director, writer, teacher and researcher. She regularly collaborates internationally with comedians, theatre companies and festivals to create comedy/theatre performances and facilitate comedy projects.</p>\n<p>Sam is co-founder/co-artistic director of Palestine Comedy Club co-creating and touring comedy and theatre shows to share Palestinians’ stories internationally. She co-wrote The Horse of Jenin (2025), Alaa Shehada’s internationally acclaimed and Edinburgh Fringe First<br />\nAward winning solo show, and directed Sami Abu Wardeh’s award winning Palestine: Peace de Resistance (2025).</p>\n<p>As founder/director of Funny Side Collective Sam also teaches stand-up comedy and solo performance practices and regularly writes and speaks internationally about socially engaged comedy. Recent publications include Beyond A Joke: comedy and social change in the UK (2026) and ‘You Can’t Stop a Girl from Thinking’ in Humour Across Victoriana (Routledge, 2025).</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15327\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Micaela Miranda</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Movement Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15327\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Micaela Miranda</p>\r\n                                          <p class=\"h5\" >Movement Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15329\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Julius Pollux Rothlaender</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Composer &amp; Sound Designer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15329\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Julius Pollux Rothlaender</p>\r\n                                          <p class=\"h5\" >Composer &amp; Sound Designer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15331\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Lily Dawford</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Lighting Designer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15331\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Lily Dawford</p>\r\n                                          <p class=\"h5\" >Lighting Designer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Lily Dawford</strong> is a London-based lighting designer (and fool) whose work has taken them from Edinburgh Fringe to the West End and back, with more than a few international escapades along the way. Lily studied at Goldsmiths, University of London where their love of all things beautifully strange was solidified. They thrive on creating work that pushes the boundaries of conventional design to build powerful, thought provoking spaces.</p>\n<p>They have worked as a lighting designer for productions such as <em>Classic Penguins</em> (Garry Starr); <em>ha ha ha ha ha ha ha</em> (Julia Masli); <em>Weer</em> (Natalie Palamides); <em>Philosophy of the World</em> (In Bed With My Brother); <em>CAttS , Body Show</em> (Frankie Thompson); <em>Body Show, Swarm , Jack the Mack</em> (Liv Ello); <em>Inside Everyone</em> (Adrian Bliss); <em>Stamptown, Jack Tucker</em> (Zach Zucker/Stamptown Comedy).</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15185\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Palestine Comedy Club</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Producer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15185\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Palestine Comedy Club</p>\r\n                                          <p class=\"h5\" >Producer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\">Palestine Comedy Club (PalCom) is a comedy production company established in Palestine and the UK by Palestinian actor and comedian Alaa Shehada, UK comedy writer and director Sam Beale, and film producer Charlotte Knowles. Palestine Comedy Club works with Palestinian artists to co-create and tour stand-up and comedy/theatre shows, amplifying Palestinian voices internationally. The club also facilitates community workshops and programmes that teach stand-up skills throughout Palestine, enabling local people to share stories and explore the power of comedy as a form of cultural expression and resistance. An award-winning documentary about the project Palestine Comedy Club is currently touring internationally.</span></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                  </ul> <!-- / Minimal Grid -->\r\n      \r\n    \r\n  </div> <!-- / MW -->\r\n\r\n</section> <!-- / Full Content -->\n                        <section class=\"full_content light_bg show pt_lrg pb_lrg\" aria-label=\"Book Tickets\" id=\"book\">\n                <div class=\"mw_1200\">\n                    <p class=\"h2\">Book tickets</p>\n\n\n                        \n                                            <div class=\"event_filter\">\n                            <div class=\"event_filter__container\">\n                                <p class=\"h4\">Filter events:</p>\n                                <div class=\"event_filter__buttons\">\n                          