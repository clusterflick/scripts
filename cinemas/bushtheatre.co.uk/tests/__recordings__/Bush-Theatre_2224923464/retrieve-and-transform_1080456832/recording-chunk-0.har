k/about-us/environmental-sustainability/\" class=\"sublink\" >Environmental Sustainability</a>\n                                    </li>\n                                                                        <li>\n                                        <a href=\"https://www.bushtheatre.co.uk/about-us/social-media-community-guidelines/\" class=\"sublink\" >Social Media Community Guidelines</a>\n                                    </li>\n                                                                        <li>\n                                        <a href=\"https://www.bushtheatre.co.uk/about-us/recent-awards/\" class=\"sublink\" >Recent Awards</a>\n                                    </li>\n                                                                        <li>\n                                        <a href=\"https://www.bushtheatre.co.uk/about-us/job-vacancies/\" class=\"sublink\" >Job Vacancies</a>\n                                    </li>\n                                                                    </ul>\n                                                                        </div> <!-- / Group -->\n                \n            </div> <!-- / Column -->\n\n        </div> <!-- / Grid -->\n    </div> <!-- / Container -->\n    <a href=\"#\" class=\"secondary-navigation__close toggleButton\" >Close</a>\n</div> <!-- / Wrapper -->\n\t\t</nav> <!-- / Secondary Navigation -->\n\n\t\t\t<div class=\"full_content site-nav dark_bg\" > <!-- Full Content -->\n\n\t\t\t\t<div class=\"mw_none\" > <!-- Max Width -->\n\n\t\t\t\t<div class=\"logo_nav_holder\"> <!-- Logo Nav Holder -->\n\n\t\t\t\t\t<div class=\"logo\">\n\t\t\t\t\t\t<a href=\"https://www.bushtheatre.co.uk/\" rel=\"home\" >\n\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/bush_nav_logo_green.png\" alt=\"Bush Theatre - Home\" />\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"nav_wrapper\" > <!-- Nav Wrapper -->\n\n\t\t\t\t\t\t<div class=\"main_nav\"> <!-- Main Nav -->\n\n\t\t\t\t\t\t\t<nav id=\"site-navigation\" class=\"main-navigation click_sub_nav\">\n\t\t\t\t\t\t\t\t<div class=\"menu-main-menu-container\"><ul id=\"primary-menu\" class=\"menu\"><li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/whats-on/\">What’s On</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page menu-item-has-children'><div class=\"item-has-sub-nav\"><a href=\"https://www.bushtheatre.co.uk/visit/\">Your Visit</a><div class=\"sub-nav-icon\"><a href=\"#\" aria-expanded=\"false\" aria-haspopup=\"true\"><span class=\"screen-reader-text\">Your Visit sub navigation icon</span></a></div></div>\n<ul class=\"sub-menu\">\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/visit/getting-here/\">Getting Here</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/visit/booking-tickets/\">Booking Tickets</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/visit/ways-to-save/\">Ways to Save</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/visit/accessibility/\">Accessibility</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/visit/library-bar/\">Library Bar</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/visit/facilities/\">Facilities</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/visit/faqs/\">FAQs</a></li>\n</ul>\n</li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page menu-item-has-children'><div class=\"item-has-sub-nav\"><a href=\"https://www.bushtheatre.co.uk/get-involved/\">Get Involved</a><div class=\"sub-nav-icon\"><a href=\"#\" aria-expanded=\"false\" aria-haspopup=\"true\"><span class=\"screen-reader-text\">Get Involved sub navigation icon</span></a></div></div>\n<ul class=\"sub-menu\">\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/about-us/job-vacancies/\">Jobs & Opportunities</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/visit/memberships/\">Memberships</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/local-community/\">Our Local Community</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/young-people/bush-young-companies/\">Bush Young Companies</a></li>\n</ul>\n</li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/venue-hire/\">Venue Hire</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page menu-item-has-children'><div class=\"item-has-sub-nav\"><a href=\"https://www.bushtheatre.co.uk/support/\">Support Us</a><div class=\"sub-nav-icon\"><a href=\"#\" aria-expanded=\"false\" aria-haspopup=\"true\"><span class=\"screen-reader-text\">Support Us sub navigation icon</span></a></div></div>\n<ul class=\"sub-menu\">\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/donate/\">Donate</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/visit/memberships/\">Memberships</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/trusts-and-foundations/\">Trusts and Foundations</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/star-supporters/\">Star Supporters</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/corporate-partners/\">Corporate Partners</a></li>\n<li class=' menu-item menu-item-type-post_type menu-item-object-page'><a href=\"https://www.bushtheatre.co.uk/support/meet-our-supporters/\">Our Supporters</a></li>\n</ul>\n</li>\n</ul></div>\t\t\t\t\t\t\t</nav><!-- #site-navigation -->\n\n\t\t\t\t\t\t\t<div class=\"subnav\" > <!-- Sub Nav -->\n\t\t\t\t\t\t\t\t<div class=\"subnav__links\" > <!-- Links -->\n\t\t\t\t\t\t\t\t\t<div class=\"basket_icon\" >\n\t\t\t\t\t\t\t\t\t\t<a href=\"/basket/\" class=\"basket\" >\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/basket.svg\" alt=\"basket - Checkout\" />\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"login_icon\" >\n\t\t\t\t\t\t\t\t\t\t<a href=\"/my-account/\" class=\"login\" >\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/user.svg\" alt=\"user - Login\" />\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"search_icon\" tabindex=\"-1\" > <!-- Site Search Icon -->\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"#search_form\" role=\"button\" title=\"Search Bar\" aria-label=\"Search Bar\" aria-controls=\"search_form\" aria-expanded=\"false\" aria-haspopup=\"true\" >\n\t\t\t\t\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/search.svg\" alt=\"search icon\" />\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t</div> <!-- / Site Search Icon -->\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div> <!-- / Links -->\n\t\t\t\t\t\t\t\t<div class=\"subnav__menu\"  > <!-- Menu -->\n\t\t\t\t\t\t\t\t\t<a href=\"#menu-popout\" class=\"subnav__menu-hamburger toggleButton\" aria-controls=\"navigation\" aria-expanded=\"false\" aria-haspopup=\"true\" ><img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" /></a>\n\t\t\t\t\t\t\t\t</div> <!-- / Menu -->\n\t\t\t\t\t\t\t</div> <!-- / Sub Nav -->\n\n\t\t\t\t\t\t</div> <!-- / Main Nav -->\n\n\t\t\t\t\t\t<div class=\"nav_icon\"><!-- Nav Icon -->\n\t\t\t\t\t\t\t<a href=\"#mobile-navigation\">\n\t\t\t\t\t\t\t\t<img src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/hamburger.png\" alt=\"menu icon\" />\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div> <!-- / Nav Icon -->\n\n\t\t\t\t\t</div> <!-- / Nav Wrapper -->\n\n\t\t\t\t\t\n\t\t\t\t\t</div> <!-- / Logo Nav Holder -->\n\n\t\t\t\t</div> <!-- / Max Width -->\n\t\t\t</div> <!-- / Full Content -->\n\n\t\t</header><!-- #masthead -->\n\n\t\t<div id=\"content\" class=\"site-content\">\n\n\t\t<div id=\"primary\" class=\"content-area event\">\n    <main id=\"main\" class=\"site-main\">\n\n    \n        \n<section class=\"event_header\"> <!-- Event Header -->\n        <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/BushTheatre_Darkling_Website_1920x1080px_V2.jpg\" alt=\"A south Asian woman with long black hair looks directly ahead. The photo is damaged with staining and scratches, with a large tear through her eye.\" class=\"event_header__image event_header__image--center\">\n            <img src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/BushTheatre_Darkling_Website_1200x1900px.jpg\" alt=\"A south Asian woman with long black hair looks directly ahead. The photo is damaged with staining and scratches, with a large tear through her eye.\" class=\"event_header__image event_header__image--center show_mob\">\n    \n    <div class=\"event_header__intro\"> <!-- Event Intro -->\n        <div class=\"event_header__intro_holder\">\n            <div class=\"event_header__intro_text\">\n                <h1 class=\"alt_heading\">Darkling</h1>\n\n                                    <p>By Titas Halder</p>\n                \n                                    <p class=\"event_header__date\">\n                                                                                                                                                                                                                                                            \n                                                                    <p>5 Sep to 24 Oct</p>\n                                \n                            \n                                                                            <p>Holloway Theatre (Bush Theatre's Main Space)</p>\n                                            </p>\n                            </div>\n\n            <div class=\"event_header__intro_btn\">\n                                                                                                                                                <a href=\"#book\" class=\"btn\">Book tickets</a>\n                                                                        </div>\n        </div>\n    </div> <!-- / Event Intro -->\n\n</section> <!-- / Event Header -->\n\n<div class=\"event_nav\"> <!-- Event Nav -->\n    <div class=\"event_nav__width\">\n        <div class=\"event_nav__anchors\">\n            <a href=\"#about\" class=\"event_nav__item\">About</a>\n            <a href=\"#Creative team\" class=\"event_nav__item\">Creative team</a>\n        </div>\n                    <div class=\"event_nav__book\">\n                                    <a href=\"#book\" class=\"event_nav__item--book btn small btn_no_arrow\">Book tickets</a>\n                            </div>\n            </div>\n</div> <!-- / Event Header -->\n\n<div class=\"event_internal\">\n    <section class=\"full_content dark_bg event_about pt_lrg pb_lrg\" aria-label=\"About Event\" id=\"about\">\n        <div class=\"event_about__row mw_1200\">\n\n            \n                <div class=\"event_about__details green_bg\"> <!-- Details -->\n                    <p class=\"h3 dark\">Details</p>\n\n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Venue</p>\n                            <p class=\"row_value\">Holloway Theatre (Bush Theatre's Main Space)</p>\n                        </div>\n                    \n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Dates</p>\n                        <p class=\"row_value\">\n                                                                                                                                                \n                                                                    <p>5 Sep to 24 Oct</p>\n                                                                                    </p>\n                    </div>\n\n                    \n                                            <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Age Guidance</p>\n                            <p class=\"row_value\">16+</p>\n                        </div>\n                    \n                     <!-- Button Repeater -->\n                        <div class=\"event_about__details_row\">\n                            <p class=\"row_title\">Content Guidance</p>\n                            <div class=\"btns_container\">\n                                                                                                        <a class=\"btn small\" href=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Darkling-self-care-guide.pdf\" target=\"_blank\">Self-care guide &amp; content warnings</a>\n                                    \n                                                            </div>\n                        </div>\n                     <!-- / Button Repeater -->\n\n                    <div class=\"event_about__details_row\">\n                        <p class=\"row_title\">Price</p>\n                        <p class=\"row_value\">\n                                                            £10.00 to £45.00                                                    </p>\n                    </div>\n\n                </div> <!-- / Details -->\n\n            \n            <div class=\"event_about__desc\">\n                <p class=\"h2\">About</p>\n                <div id=\"\">\n<p><b><i>I walk home. The skyline is changed.<br />\n</i></b><b><i>The skeleton is fast becoming a huge metal creature.<br />\n</i></b><b><i>They have built a behemoth here.</i></b></p>\n<p><span style=\"font-weight: 400\">Bhopal. India. 1984.</span></p>\n<p><span style=\"font-weight: 400\">Born under a blue sky in a city of lakes, a girl grows up with her father and sister. The three of them together, always.</span></p>\n<p><span style=\"font-weight: 400\">But as she grows, the land begins to change. A giant factory rises over her town. Her mother always wanted more for them &#8211; now the girl wants more too.</span></p>\n<p><span style=\"font-weight: 400\">Then comes the night that tears everything apart.</span></p>\n<p><span style=\"font-weight: 400\">Ferocious, brutal and damning, this epic story of a life ravaged by ecological disaster is written by </span><b>Titas Halder</b><span style=\"font-weight: 400\"> (</span><i><span style=\"font-weight: 400\">Foal</span></i><span style=\"font-weight: 400\">, Finborough) and directed by </span><b>Matthew Xia </b><span style=\"font-weight: 400\">(</span><i><span style=\"font-weight: 400\">Tambo &amp; Bones</span></i><span style=\"font-weight: 400\">, ATC / Stratford East).</span></p>\n</div>\n\n            </div>\n\n        </div>\n\n                    <div class=\"mw_1200 event_about__desc_extra\">\n                <p class=\"small\">\n                    A Bush Theatre and Actors Touring Company co-production. This production is made possible with generous support from Cockayne Grants for the Arts, Royal Victoria Hall Foundation, Esmée Fairbairn Foundation, John Ellerman Foundation and the Wates Foundation.                </p>\n            </section>\n\n    \r\n\r\n\r\n<section\r\n  aria-label=\"Creative team\"id=\"Creative team\"  class=\"full_content team-listing white_bg pt_sm pb_sm\"\r\n> <!-- Full Content -->\r\n\r\n  <div class=\"mw_1200 no_text_center\"> <!-- MW -->\r\n\r\n    <p class=\"h2\">Creative team</p><div class=\"team-listing__spacer\" ></div>\r\n    \r\n    \r\n    \r\n              <ul class=\"team-listing__minimal-grid\" > <!-- Minimal Grid -->\r\n                      <li>\r\n              <a href=\"#team-listing-item-15165\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Titas Halder</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Writer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15165\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                          <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                        <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/Titas-e1781775475464-320x480.jpg\" alt=\"\" />\r\n                      </div> <!-- / Image Container -->\r\n                                        <p class=\"h3\" >Titas Halder</p>\r\n                                          <p class=\"h5\" >Writer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Titas Halder</strong> is a writer and director working across Theatre, Film and Music. He is currently Associate Artistic Director at the Donmar Warehouse. As a writer he trained on the Royal Court Theatre Young Writers’ Programme.</p>\n<p>His first two plays <em>Run the Beast Down</em> and <em>Escape the Scaffold</em> saw him nominated for Best Writer at the inaugural Stage Debut Awards and acclaimed as a rising star playwright. The same year, his play The Basement was a finalist for the Verity Bargate Award.</p>\n<p>His next play Replica premiered at the National Theatre as part of NT Connections, and was also produced at Riksteatern&#8217;s Länk Festival in Stockholm. His latest play<em> Foal</em> premiered at the Finborough Theatre in London in 2026. He was selected for BBC Voices 2024 and is currently writing his first feature film for Storyteller.</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15145\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Matthew Xia</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15145\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                          <div class=\"team-listing__popup-image\" > <!-- Image Container -->\r\n                        <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/uploads/2026/06/matthewxia-320x480.jpg\" alt=\"\" />\r\n                      </div> <!-- / Image Container -->\r\n                                        <p class=\"h3\" >Matthew Xia</p>\r\n                                          <p class=\"h5\" >Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p>Matthew Xia is a multiple award-winning theatre director, cultural leader, and multi-disciplinary artist whose work moves fluidly between stages, streets, and communities. Matthew began his career at Stratford East as a young actor and DJ under the name Excalibah; this unorthodox path through performance, music, and a love of audiences continues to inform his distinctive approach to making work.</p>\n<p>Matthew Xia is the Artistic Director of ATC (Actors Touring Company). He was previously Associate Artistic Director at the Royal Exchange Theatre, Manchester, where he established OPEN EXCHANGE, an artist development scheme for more than 400 next generation theatre-makers; Director-in-Residence at Liverpool Everyman &amp; Playhouse; and Associate Director at Theatre Royal Stratford East. He was also Associate Artist at Nottingham Playhouse alongside James Graham and Amanda Whittington.</p>\n<p>Across his career, Matthew has directed some of the UK’s most talented actors, including Daniel Kaluuya, Cynthia Erivo, Joseph Quinn, Erin Doherty, Malachi Kirby, Maxine Peake, David Haig, Samuel Barnett, Matt Henry, Karl Collins, Martina Laird, Christopher Colquhoun, and David Moorst.</p>\n<p>His directing credits include: <em>Tender</em> (Soho Theatre); <em>Small Island</em> (Leeds Playhouse / Birmingham REP / Nottingham Playhouse / ATC); <em>The Harder They Come</em> (Stratford East); <em>Bodies of Water</em> (ATC / GDIF); <em>Skeleton Crew</em> (Donmar Warehouse); <em>The Architect</em> (GDIF / ATC / Stephen Lawrence Day Foundation); <em>Tambo &amp; Bones</em> (ATC / Theatre Royal Stratford East); the Olivier Award-winning <em>Hey Duggee – The Live Theatre Show</em> (Kenny Wax Family Entertainment / Cuffe &amp; Taylor); the Fringe First Award-winning <em>Feeling Afraid as if Something Terrible is Going to Happen</em> (Francesca Moody Productions / Bush Theatre); <em>Rice</em> (ATC / Orange Tree); <em>The Wiz</em> (Ameena Hamid Productions / Hope Mill / BBC Big Night of Musicals); <em>Family Tree</em> (GDIF / ATC / Belgrade / Brixton House); <em>846Live</em> (Stratford East / GDIF); Amsterdam (ATC / Orange Tree / Theatre Royal Plymouth); Blood Knot (Orange Tree); <em>Eden</em> (Hampstead Theatre); <em>One Night In Miami…</em> (Nottingham Playhouse / Bristol Old Vic / HOME); <em>Into The Woods</em> and <em>Frankenstein</em> (Royal Exchange); <em>Wish List</em> (Royal Exchange / Royal Court); <em>Shebeen</em> (Nottingham Playhouse / Stratford East); <em>Sleeping Beauty and The Blacks</em> (Stratford East); <em>Dublin Carol</em> (Sherman Theatre); <em>Blue/Orange </em>and <em>The Sound of Yellow</em> (Young Vic); <em>Sizwe Banzi is Dead</em> (Young Vic / Eclipse); <em>I Was Looking at the Ceiling and Then I Saw the Sky</em> (co-director, Stratford East / Barbican); and <em>Suckerpunch Boom Suite</em> (Barbican / NitroBEAT).</p>\n<p>As both director and dramaturg, Matthew has worked with an array of renowned writers including Suzan-Lori Parks, Dominique Morisseau, Arinze Kene, April De Angelis, Joe Penhall, Vikki Stone, Katherine Soper, David Levi-Addai, Yasmin Joseph, Mojisola Adebayo, and Nessah Muthy. He has also been a respected panelist for the Evening Standard Future Fund, the Yale Drama Series, the Alfred Fagon Award, BEAM, the Bruntwood Prize, and, most recently, the Eurovision Song Contest.</p>\n<p>Beyond directing, Matthew’s practice spans music, sound, and live event culture. His work as a DJ, composer and sound designer includes presenting an award-winning hip-hop show on BBC 1Xtra; DJing for the London 2012 Paralympic Games Opening Ceremony; and creating work for productions including <em>The People Are Singing</em> (Royal Exchange), <em>Free Run</em> (Underbelly), <em>That’s The Way To Do It</em> (TimeWon’tWait), <em>Pass The Baton</em> and <em>Bolero Remixed</em> (New London Orchestra), and <em>Da Boyz</em>, <em>Family Man</em>, <em>The Snow Queen</em>, <em>Hansel &amp; Gretel</em>, <em>Medea</em>, and <em>Squid</em> (Stratford East).</p>\n<p>Matthew was a founding member of Act for Change. In 2019, he was awarded an Honorary Doctorate from the University of the Arts London in recognition of his work to make theatre more accessible and to champion minority groups as leaders, makers, and audiences within the industry.</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15310\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Simon Kenny</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Designer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15310\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Simon Kenny</p>\r\n                                          <p class=\"h5\" >Designer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-5350\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Rajiv Pattani</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Lighting Designer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-5350\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Rajiv Pattani</p>\r\n                                          <p class=\"h5\" >Lighting Designer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <div dir=\"ltr\">\n<p>Rajiv graduated from LAMDA in 2014 with qualifications in Stage Management and Technical Theatre, specialising in Lighting, Sound and AV. Recent design work for the Bush includes the reopening event <em>Black Lives, Black Words</em>, Edinburgh Fringe First winner 2017 <em>NASSIM </em> (Traverse 2 / Bush Theatre / International Tour), <em>Ramona Tells Jim</em> directed by Mel Hillyard and <em>Hijabi Monologues</em> <em>London. </em></p>\n<p>Other lighting design credits include: Network Theatre’s <em>STUD</em> (Vault Festival 2018); <em>Screaming Secrets &amp; Glass Roots</em> (Tristan Bates Theatre); Tom Stoppard’s <em>On the Razzle</em> and Nina Raine’s <em>Rabbit</em> (Pleasance Theatre for LAMDA productions); <em>Blood Wedding</em> (Bread &amp; Roses Theatre); <em>Might Never Happen</em> (Doll’s Eye Theatre Company); <em>Primadonna</em> (VAULT Festival 2016); as well as various projects at the Arcola, Hampstead and the Unicorn. Rajiv was also Production Electrician on <em>4 Minutes 12 Seconds</em> at Trafalgar Studios.</p>\n</div>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15322\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Beth Duke</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Sound Designer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15322\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Beth Duke</p>\r\n                                          <p class=\"h5\" >Sound Designer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-5154\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Niraj Chag</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Composer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-5154\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Niraj Chag</p>\r\n                                          <p class=\"h5\" >Composer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><strong>Niraj Chag</strong> is a London-based composer and artist whose work spans a wide range from albums, to TV &amp; film scores, theatre and live events.</p>\n<p>Niraj’s television and film soundtracks have reached a worldwide audience. These include <em>One Night in Bhopal</em> (BBC1), Bafta &amp; Emmy winning Simon Schama’s <em>The Power of Art</em> (BBC Worldwide), <em>The Age of Terror</em> (BBC2), Andrew Marr’s <em>Darwin&#8217;s Dangerous Idea</em> (BBC2), <em>Sex and the City</em> (HBO), <em>Origins of Us</em> (BBC2), <em>The Rise of the Continents</em> (Discovery Channel),<em> All in Good Time</em> (Studio Canal), <em>Our Girl</em> (BBC1).</p>\n<p>By contrast, Niraj&#8217;s album work allows him to explore and bring to life his own narrative. Albums include the critically acclaimed ‘Along The Dusty Road’, ‘The Lost Souls’ and ‘Mud Doll’.</p>\n<p>Other work includes the score for the official Olympic Torch event on London&#8217;s South Bank (SBC). Musical <em>Wah! Wah! Girls</em> (Sadler&#8217;s Wells), The Olivier Award winning <em>Rafta Rafta</em> (National Theatre), <em>Much Ado About Nothing</em> (RSC), <em>Dara</em> (National Theatre), <em>Captive Queen</em> (Shakespeare’s Globe), <em>The Ramayana</em> (Radio 4). In addition, Niraj has scored over 20 dance productions including Shobana Jeyasinghs <em>Classic Cuts</em> (Royal Opera House).</p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15313\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Anjali Mehra</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Movement Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15313\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Anjali Mehra</p>\r\n                                          <p class=\"h5\" >Movement Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15315\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Shaheen Baig</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Casting Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15315\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Shaheen Baig</p>\r\n                                          <p class=\"h5\" >Casting Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15317\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Sara Aniqah Malik</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Associate Director</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15317\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Sara Aniqah Malik</p>\r\n                                          <p class=\"h5\" >Associate Director</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                      <li>\r\n              <a href=\"#team-listing-item-15319\" class=\"team-listing__minimal-post team-listing__popup-link\" > <!-- Minimal Post -->\r\n                <h4>Actors Touring Company</h4>\r\n                <div class=\"team-listing__minimal-flex\" >\r\n                                      <p>Co-Producer</p>\r\n                                    <img decoding=\"async\" src=\"https://www.bushtheatre.co.uk/wp-content/themes/bush_theatre/images/button_bg_arrow_dark.svg\" alt=\"\" />\r\n                </div>\r\n              </a> <!-- / Minimal Post -->\r\n\r\n              <div class=\"team-listing__popup mfp-hide\" id=\"team-listing-item-15319\" > <!-- Pop-up -->\r\n                  <button class=\"mfp-close\" type=\"button\" title=\"Close Pop-up\" >\r\n                    <span>X</span>\r\n                  </button>\r\n                  <div class=\"team-listing__popup-content \" > <!-- Content -->\r\n                                        <p class=\"h3\" >Actors Touring Company</p>\r\n                                          <p class=\"h5\" >Co-Producer</p>\r\n                                        <div class=\"divider\" ></div>\r\n                                          <p><span style=\"font-weight: 400\"><strong>Actors Touring Company</strong> (ATC) is a portable portal to the world. Through their work, they connect global artistic voices to local communities across the UK and beyond.</span></p>\n<p><span style=\"font-weight: 400\">ATC is the UK’s leading theatre producer of international plays. They source, commission and produce work from around the world and from the global cultures that exist within the UK. They create dialogue between here and the rest of the world, amplifying voices that have often been overlooked in British theatre.</span></p>\n<p><span style=\"font-weight: 400\">They explore global systems experienced at a human level: who gets to speak, who is seen, and who is centred. They are passionate about giving voice to the ‘outsider within’, turning barriers into bridges, and taking storytelling and theatre everywhere, for everyone. </span></p>\n                                        <div class=\"clear\"></div>\r\n                  </div> <!-- / Content -->\r\n                </div> <!-- / Pop-up -->\r\n\r\n            </li>\r\n                  </ul> <!-- / Minimal Grid -->\r\n      \r\n    \r\n  </div> <!-- / MW -->\r\n\r\n</section> <!-- / Full Content -->\n                        <section class=\"full_content light_bg show pt_lrg pb_lrg\" aria-label=\"Book Tickets\" id=\"book\">\n                <div class=\"mw_1200\">\n                    <p class=\"h2\">Book tickets</p>\n\n\n                        \n                                            <div class=\"event_filter\">\n                            <div class=\"event_filter__container\">\n                                <p class=\"h4\">Filter events:</p>\n                                <div class=\"event_filter__buttons\">\n                                    <a href=\"#\" class=\"event_filter__item\" id=\"filter_all\" data-filter=\"\">All</a>\n                                    <a href=\"#\" class=\"event_filter__item preview\" data-filter=\"preview\">Preview</a><a href=\"#\" class=\"event_filter__item press_night\" data-filter=\"press_night\">Press Night</a><a href=\"#\" class=\"event_filter__item matinee\" data-filter=\"matinee\">Matinee</a><a href=\"#\" class=\"event_filter__item relaxed_performance\" data-filter=\"relaxed_performance\">Relaxed Performance</a><a href=\"#\" class=\"event_filter__item captioned\" data-filter=\"captioned\">Captioned Performance</a><a href=\"#\" class=\"event_filter__item audio_described\" data-filter=\"audio_described\">Audio Described</a>                                </div>\n                            </div>\n                        </div>\n                    \n                    <div class=\"instance_table\"> <!-- Instance Table -->\n\n                        \n                            \n                            <div class=\"instance_table__row\" data-filter=\"preview\"> <!-- Instance Table Row -->\n                                <div class=\"instance_table__col instance_table__col--date\"><time>Sat 5 September</time></div>\n                                <div class=\"instance_table__col instance_table__col--time\"><time>7:30pm</time></div>\n\n                                                                    <div class=\"instance_table__col instance_table__col--price\">&pound;10.00 to &pound;25.00</div>\n                                \n                                <div class=\"instance_table__col\">\n                                    <div class=\"icon_holder\">\n                                     