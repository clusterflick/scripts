            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014534\",\"name\":\"Disclosure Day\",\"originalName\":\"Disclosure Day\",\"length\":145,\"posterLink\":\"https://regalcdn.azureedge.net/CW/DisclosureDay/HO00014534/TV_SmallPosterImage/20260402-042035921.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/DisclosureDay/HO00014534/TV_LargePosterImage/20260402-041918154.jpg\",\"videoLink\":\"https://youtu.be/SCYT8vb2siQ\",\"link\":\"https://www.cineworld.co.uk/films/disclosure-day/ho00014534\",\"weight\":-9,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Emily Blunt, Colman Domingo, Colin Firth, Eve Hewson, Josh O'Connor\",\"directors\":\"Steven Spielberg\",\"synopsis\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming close to … Disclosure Day.\",\"dateStarted\":\"2026-06-10T00:00:00\",\"eventCount\":645,\"categoriesAttributes\":[],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"audio-described\",\"cineseniors\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/DisclosureDay/HO00014534/TV_TopShelfPosterImage/20260402-041918154.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/DisclosureDay/HO00014534/TV_SmallPosterImage/20260402-042035921.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"ur