ass=\"performance  columns is-multiline\">\r\n<span class=\"date column is-12\">Thu 5 Feb</span>\r\n<div class=\"column\">\r\n<a id=\"Performance_9496627\" class=\"button booking \" href=\"Booking?Booking=TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_9496627.TcsSection_5209705\" role=\"button\" aria-label=\"Go to booking for 18:10\">\r\n<i id=\"Ticket_9496627\" class=\"fa fa-ticket-alt\"></i>\r\n<span id=\"PerformanceTime_9496627\" class=\"time\">18:10</span>\r\n<span class=\"tag screen screen1\" data-tooltip=\"Screen 1\">S1</span>\r\n</a>\r\n</div>\r\n</li>\r\n</ul>\r\n        </div>\r\n      </div>\r\n      <h3 class=\"subtitle is-underlined\"><span>Details</span></h3>\r\n<div id=\"TheVideo\" onclick=\"thevid=document.getElementById('thevideo')\r\nthevid.style.display='block'; this.style.display='none';\r\ndocument.getElementById('ytplayer').src =\r\ndocument.getElementById('ytplayer').src.replace('autoplay=0','autoplay=1');\">\r\n<img style=\"cursor: pointer;\" src=\"https://images.savoysystems.co.uk/TLC/9496609.png\" alt=\"\" /><div class=\"play\" role=\"button\" aria-label=\"play trailer\" tabindex=0></div>\r\n</div>\r\n<div id=\"thevideo\" style=\"display: none;\">\r\n<iframe id=\"ytplayer\" rel=\"_Nk8TrBHOrA\" type=\"text/html\" width=\"100%\" height=\"350\"src=\"https://www.youtube.com/embed/_Nk8TrBHOrA?fs=1&autoplay=0&modestbranding=1&rel=0&showinfo=0&theme=light\"frameborder=\"0\" allowfullscreen></iframe>\r\n</div>\r\n      <ul class=\"info is-hidden-mobile\">\r\n        <li>Runtime: 101 minutes</li>\r\n        <li>Director: Clint Bentley</li>\r\n        <li>Cast: Joel Edgerton, Clifton Collins Jr., Felicity Jones</li>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n        <li>Rating: (12A)</li>\r\n      </ul>\r\n<ul class=\"tags is-relative\">\r\n<li><span class=\"tag programme-type-611\">Film</span></li>\r\n</ul>\r\n    </div>\r\n    <div class=\"column programme-synopsis\">\r\n      <h1 class=\"title\">Train Dreams</h1>\r\n<p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\">Based on the beloved novella by Denis Johnson, Train Dreams is the moving portrait of Robert Grainier (Edgerton), whose life unfolds during an era of unprecedented change in early 20th-century America.</span></p>\r\n<p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: normal; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p>\r\n<p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: italic; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\">Please arrive promptly - we show 10 minutes of trailers before each film and do not show adverts.&nbsp;</span></p>\r\n<p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: italic; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;\"><br /></span></p>\r\n<p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;\"><span style=\" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: underline;\">Talking Pictures</span></p>\r\n<p style=\"text-ali