ary to March.    You can find the other films in the sea...</div>\r\n\t\t\t\t\t\t<ul class=\"buttons\">\r\n\t\t\t\t\t\t\t<li><a href=\"https://thelexicinema.co.uk/TheLexiCinema.dll/WhatsOn?f=9386852\" class=\"button\" role=\"button\" aria-label=\"More Info\">More Info</a></li>\r\n\t\t\t\t\t\t\t<li><a href=\"https://thelexicinema.co.uk/TheLexiCinema.dll/WhatsOn?f=9386852\" class=\"button action\" role=\"button\" aria-label=\"Book now\">Book Now</a></li>\r\n\t\t\t\t\t\t</ul>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<img class=\"carousel-film-image image\" src=\"https://images.savoysystems.co.uk/TLC/9386864.png\" alt=\"Annemarie Jacir: Wajib \"/>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t\t<!-- End Carousel -->\r\n\t\t<!--/Carousel-->\r\n<script>\r\n  ////////////////////////////////////////////\r\n  //Carousel\r\n  ////////////////////////////////////////////\r\n  bulmaCarousel.attach(\"#Banner_SeasonsScroller\", {\r\n    initialSlide: 0,\r\n    slidesToScroll: 1,\r\n    slidesToShow: 4,\r\n    autoplay: true,\r\n    pagination: false,\r\n    effect: \"translate\",\r\n    duration: 300,\r\n    autoplaySpeed: 5000,\r\n    loop: true\r\n  });\r\n</script>\r\n<div class=\"columns is-ancestor\">\r\n<div class=\"column has-text-centered\">\r\n<a class=\"button\" href=\"WhatsOn\">View All</a>\r\n</div>\r\n</div>\r\n</div>\r\n</section>\r\n    <section id=\"SeasonsScrollSection\" class=\"is-shadow\">\r\n      <div id=\"\" class=\"container banner-container\">\r\n        <div id=\"\" class=\"is-ancestor\">\r\n<h2 class=\"title is-underlined has-text-centered\"><span>Seasons &amp; Strands</span></h2>\r\n\t\t<!--Carousel-->\r\n\t\t\t<!-- Start Carousel -->\r\n\t\t\t<div id=\"Banner_SeasonsScroller\" class=\"carousel tile is-child\">\r\n\t\t\t\t<div class=\"item item-0\">\r\n\t\t\t\t\t<div class=\"carousel-slide-overlay\">\r\n\t\t\t\t\t\t<h3 class=\"film-title\">Films</h3>\r\n\t\t\t\t\t\t<h4 class=\"subtitle\"><p style=\"text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margi