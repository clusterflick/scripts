/show>\n      <show id=\"1173670608\">\n        <name>\n          <![CDATA[ROOFMAN]]>\n        </name>\n        <description>\n          <![CDATA[<p><span><b><font size=\"5\">Roofman&nbsp;</font></b></span><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/4qgy6uumlu5cxoi7pb4alm9yv6m0/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\"></p>\n\n<p><span><font size=\"3\">Comedy | Drama</font></span></p><p><span><font size=\"3\">2025 USA 126 mins</font></span></p>\n\n\n\n<p><font size=\"3\">Director: Derek Cianfrance</font></p>\n\n<p><font size=\"3\">Stars: Channing Tatum, Kirsten\nDunst, Peter Dinklage, Lakeith Standfield</font></p>\n\n\n\n<p><font size=\"3\"><b><i><strong><span>Roofman</span></strong></i></b>\nis a comedy-drama based on the unbelievable but true tale of Jeffrey\nManchester, an escaped prisoner.Jeffrey, played by Channing Tatum, finds the perfect hiding spot&mdash;inside\na <strong><span>Toys\n&ldquo;R&rdquo; Us store</span></strong>. By day, he keeps out of sight; by night, he raids\nthe aisles like a kid in the ultimate candy store. His bizarre double life\ntakes a twist when he meets a charming employee, played by Kirsten Dunst, and\nsparks fly. Mischief, romance, and toy-store hijinks collide in this\nstranger-than-fiction adventure.</font></p><p><font size=\"3\"><b>Our 2:30pm screening includes &quot;descriptive subtitles&quot; for the heard of hearing.</b></font></p>]]>\n        </description>\n        <event_category>film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173670608/events</url>\n        <version>47</version>\n        <tags>\n          <tag>comedy</tag>\n          <tag>drama</tag>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/a0lq21yyhdw3b11bjghqkop20dem/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/a0lq21yyhdw3b11bjghqkop20dem/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/a0lq21yyhdw3b11bjghqkop20dem/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/4qgy6uumlu5cxoi7pb4alm9yv6m0/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/4qgy6uumlu5cxoi7pb4alm9yv6m0/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/4qgy6uumlu5cxoi7pb4alm9yv6m0/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=GXecSGmQDEI</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428765661\">\n            <name>\n              <![CDATA[20 Nov 2025 - 14:30 @ David Lean Cinema - (opening time 13:45) ROOFMAN]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-20T14:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-20T13:45:00+00:00</opening_time_iso>\n            <event_number>428765661</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute>HoH Subtitled</event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670608/events/428765661/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670608/events/428765661.xml</url>\n            </feed>\n          </event>\n          <event id=\"428765662\">\n            <name>\n              <![CDATA[20 Nov 2025 - 19:30 @ David Lean Cinema - (opening time 18:45) ROOFMAN]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-20T19:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-20T18:45:00+00:00</opening_time_iso>\n            <event_number>428765662</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670608/events/428765662/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670608/events/428765662.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173670600\">\n        <name>\n          <![CDATA[SOULEYMANE'S STORY]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><span><font size=\"5\">Souleymane&rsquo;s\nStory&nbsp;</font></span></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/84ioptotrflp4cvkzj50cpz3gxno/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\"></p>\n\n\n\n<p><span><font size=\"3\">Drama</font></span></p><p><span><font size=\"3\">2024 France\n92 mins (<b>French with English subtitles</b>)</font></span></p>\n\n\n\n<p><span><font size=\"3\">Director:&nbsp;Boris\nLojkine</font></span></p>\n\n<p><span><font size=\"3\">Stars:&nbsp;Abou Sangar&eacute;,\nAlpha Oumar Sow, Nina Meurisse</font></span></p>\n\n<p><span><font size=\"3\">Set over a tense 48 hours, Abou Sangare plays Guinean asylum\nseeker Souleymane as he prepares his testimony for a decisive asylum interview\nthat could secure his future in France. By day and night, we follow him through\nthe shadowy streets of Paris as a food delivery rider, drifting between\nhostels, and piecing together his story. Boris Lojkine&rsquo;s portrait of a modern\nmigrant propels us into the precarious existence of society&rsquo;s invisible man. As\nSouleymane recounts his past, the pressure intensifies, building to a date with\ndestiny that will shape the rest of his life.</font></span></p>]]>\n        </description>\n        <event_category>film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173670600/events</url>\n        <version>46</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/9hgqzsplmvzc0zo5lykcvi6l0ubf/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/9hgqzsplmvzc0zo5lykcvi6l0ubf/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/9hgqzsplmvzc0zo5lykcvi6l0ubf/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/84ioptotrflp4cvkzj50cpz3gxno/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/84ioptotrflp4cvkzj50cpz3gxno/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/84ioptotrflp4cvkzj50cpz3gxno/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=Rbs53_uMw9o</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428765639\">\n            <name>\n              <![CDATA[11 Nov 2025 - 14:30 @ David Lean Cinema - (opening time 13:45) SOULEYMANE'S STORY]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-11T14:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-11T13:45:00+00:00</opening_time_iso>\n            <event_number>428765639</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670600/events/428765639/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670600/events/428765639.xml</url>\n            </feed>\n          </event>\n          <event id=\"428765640\">\n            <name>\n              <![CDATA[11 Nov 2025 - 19:30 @ David Lean Cinema - (opening time 18:45) SOULEYMANE'S STORY]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-11T19:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-11T18:45:00+00:00</opening_time_iso>\n            <event_number>428765640</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670600/events/428765640/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670600/events/428765640.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173669688\">\n        <name>\n          <![CDATA[SUMMER OF SOUL]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><font size=\"5\">Summer\nof Soul&nbsp;</font></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/20wvxnkfp2fi1olga9qjt0nip6gs/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\"></p>\n\n\n\n<p><span><font size=\"3\">Documentary</font></span></p><p><span><font size=\"3\">2021\nUSA 118 mins</font></span></p>\n\n\n\n<p><span><font size=\"3\">Director:\nQuestlove</font></span></p>\n\n\n\n<p><b><i>Black History Month screening in conjunction with Croydon Black History Partnership</i></b>.&nbsp;<b><i>Tickets &pound;6.</i></b><span><font size=\"3\"></font></span></p><p><span><font size=\"3\">Taking\nplace at the same time as the Woodstock festival, the 1969 Harlem Cultural\nFestival was also filmed, but with no Hollywood backing the tapes languished in\nstorage. They now form the basis of this documentary, subtitled &lsquo;When the\nRevolution Could Not Be Televised&rsquo;, which mixes historical perspectives with\nmusical performances by Sly and the Family Stone, Nina Simone, B.B. King,\nStevie Wonder, The Staples Singers, Mahalia Jackson, Gladys Knight and the\nPips, Hugh Masekela and many more.&nbsp;</font></span></p><p><br></p>]]>\n        </description>\n        <event_category>documentary</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173669688/events</url>\n        <version>72</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/ryo8yaeqaif01bgn7p7bdn85zvv9/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/ryo8yaeqaif01bgn7p7bdn85zvv9/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/ryo8yaeqaif01bgn7p7bdn85zvv9/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/20wvxnkfp2fi1olga9qjt0nip6gs/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/20wvxnkfp2fi1olga9qjt0nip6gs/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/20wvxnkfp2fi1olga9qjt0nip6gs/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=slFiJpAxZyQ</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428751380\">\n            <name>\n              <![CDATA[28 Oct 2025 - 14:30 @ David Lean Cinema - (opening time 13:45) SUMMER OF SOUL]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-10-28T14:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-10-28T13:45:00+00:00</opening_time_iso>\n            <event_number>428751380</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173669688/events/428751380/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173669688/events/428751380.xml</url>\n            </feed>\n          </event>\n          <event id=\"428751396\">\n            <name>\n              <![CDATA[28 Oct 2025 - 19:30 @ David Lean Cinema - (opening time 18:45) SUMMER OF SOUL]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-10-28T19:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-10-28T18:45:00+00:00</opening_time_iso>\n            <event_number>428751396</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173669688/events/428751396/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173669688/events/428751396.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173670605\">\n        <name>\n          <![CDATA[THE MARBLES]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><span><font size=\"5\">The Marbles&nbsp;</font></span></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/yxr90uicqt7i5s9aqmcvf4werv6e/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\"></p>\n\n<p><span><font size=\"3\">2025 UK 113 mins</font></span></p>\n\n<p><span><font size=\"3\">Director: David Wilkinson</font></span></p><p><span style=\"background-color:rgb(255, 255, 0);\"><font size=\"3\"><b>Our 7pm screening includes a Q&amp;A with the Director (see bio below).</b></font></span></p>\n\n<p><font size=\"3\">In the early 19th century, agents of the 7th Earl of Elgin\nshipped many of the sculptures from the Parthenon and other buildings on the\nAcropolis in Athens to Britain. Elgin said he had permission of the Ottoman\ngovernment of the time, but this has long been disputed, and for the last 50\nyears the likes of Melina Mercouri and other members of the Greek government\nhave argued forcefully for their return. This film presents the arguments from\nboth sides while advocating for the reunification of the Marbles with the rest\nof the remains in the museum especially designed for this purpose in Athens. </font></p><p><font size=\"3\"><br></font></p><div>\n<strong>David Nicholas Wilkinson&nbsp;</strong>(director/producer/writer) Directed, produced, co-wrote,&nbsp;and presented THE FIRST FILM, POSTCARDS FROM THE 48%, and was an&nbsp;<br>executive producer of HOW TO CHANGE THE WORLD. His three-hour Holocaust&nbsp;documentary GETTING AWAY WITH MURDER(S) was voted by the Guardian the&nbsp;No17 Best Film in 2021 in the UK. By default, it was the highest-placed documentary on&nbsp;the list. &nbsp;&nbsp;</div><div><br></div><div>He has also produced almost 50 documentaries and dramas. Wilkinson has also&nbsp;<br>distributed 120 films in the UK and Ireland in the cinema, on video/DVD, on television,&nbsp;and online. Since 1998, apart from Alex Gibney&rsquo;s ZERO DAYS and Lasse&nbsp;<br>Hallstr&ouml;m&rsquo;s HILMA, these have been purposely only British and Irish films. &nbsp;</div><div>He started his career as an actor in 1970, and for the next ten years, he acted in&nbsp;<br>over 40 theatre, television and film productions. In 1982, he became, by accident,&nbsp;the first true independent producer to work with the BBC with a film of Virginia&nbsp;Woolf&apos;s TO THE LIGHTHOUSE, which starred Sir Kenneth Branagh and was&nbsp;nominated for a BAFTA award.&nbsp;</div>]]>\n        </description>\n        <event_category>documentary</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173670605/events</url>\n        <version>48</version>\n        <tags>\n          <tag>documentary</tag>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/hqm70ul6wcgvw84at7dndef6xpfb/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/hqm70ul6wcgvw84at7dndef6xpfb/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/hqm70ul6wcgvw84at7dndef6xpfb/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/yxr90uicqt7i5s9aqmcvf4werv6e/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/yxr90uicqt7i5s9aqmcvf4werv6e/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/yxr90uicqt7i5s9aqmcvf4werv6e/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n        </properties>\n        <events>\n          <event id=\"428765656\">\n            <name>\n              <![CDATA[13 Nov 2025 - 14:30 @ David Lean Cinema - (opening time 13:45) THE MARBLES]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-13T14:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-13T13:45:00+00:00</opening_time_iso>\n            <event_number>428765656</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670605/events/428765656/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670605/events/428765656.xml</url>\n            </feed>\n          </event>\n          <event id=\"428765657\">\n            <name>\n              <![CDATA[13 Nov 2025 - 19:00 @ David Lean Cinema - (opening time 18:15) THE MARBLES]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-13T19:00:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-13T18:15:00+00:00</opening_time_iso>\n            <event_number>428765657</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[Following the screening there will be a post film Q&A with the documentary's director, David Wilkinson.]]>\n            </comment>\n            <event_attribute>&amp; Q&amp;A</event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670605/events/428765657/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670605/events/428765657.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173670598\">\n        <name>\n          <![CDATA[THE ROSES - Babes-In-Arms Screening]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><font size=\"5\">The\nRoses</font><font size=\"3\">&nbsp;</font></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/6rk0drjwjqdagvpux7o4vee8y2co/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">&nbsp;</p><p><font size=\"3\" style=\"background-color:rgb(255, 255, 0);\">Babes-In Arms Relaxed screening</font></p><p><b style=\"background-color:rgb(255, 255, 0);\">THE ROSES contains several sequences with flashing lights that may affect those who are susceptible to photosensitive epilepsy or have other photosensitivities.<font size=\"3\"></font></b></p><p><font size=\"3\">Comedy</font></p>\n\n\n\n<p><span><font size=\"3\">2025\nUSA 105 mins </font></span></p>\n\n\n\n<p><span><font size=\"3\">Director:\nJay Roach</font></span></p>\n\n\n\n<p><span><font size=\"3\">Stars: Olivia\nColman, Benedict Cumberbatch, Kate McKinnon, Andy Samberg</font></span></p>\n\n<p><b><font size=\"3\"><i></i></font></b></p>\n\n<p><span><font size=\"3\"><em><b><span>The Roses</span></b></em>\nputs Olivia Colman and Benedict Cumberbatch at the heart of a gloriously messy,\nlaugh-out-loud marital meltdown. What begins as the perfect partnership soon\ncollapses into a full-scale domestic war, with smashed egos, outrageous\none-upmanship, and a battle for the house that&rsquo;s as hilarious as it is vicious.\nWith Kate McKinnon, Andy Samberg and Alison Janney in the supporting cast, this\nupdate of the 1989 classic &ndash; The War of the Roses - serves up razor-sharp black\ncomedy, proving that when love goes sour, revenge can be riotously\nentertaining.</font></span></p><p><span style=\"background-color:rgb(255, 255, 0);font-family:inherit;font-size:small;\">Our Babes-in-Arms screenings are relaxed events allowing parents of babies 12 months &amp; under to watch a great movie without having to worry about what other customers think. We have space to securely park your buggies  and our Arts Bar is also open for refreshments you can take inside with you.</span></p>]]>\n        </description>\n        <event_category>Babes-In-Arms</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173670598/events</url>\n        <version>59</version>\n        <tags>\n          <tag>comedy</tag>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/yw47e2cx8908yqfubsyps8wq74rt/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/yw47e2cx8908yqfubsyps8wq74rt/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/yw47e2cx8908yqfubsyps8wq74rt/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/6rk0drjwjqdagvpux7o4vee8y2co/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/6rk0drjwjqdagvpux7o4vee8y2co/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/6rk0drjwjqdagvpux7o4vee8y2co/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=XkgMaS5gbaA</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428765632\">\n            <name>\n              <![CDATA[07 Nov 2025 - 11:00 @ David Lean Cinema - (opening time 10:15) THE ROSES - Babes-In-Arms Screening]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-07T11:00:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-07T10:15:00+00:00</opening_time_iso>\n            <event_number>428765632</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[Our Babes-in-Arms screenings are relaxed events allowing parents of babies 12 months & under to watch a great movie without having to worry about what other customers think. We have space to securely park your buggies  and our Arts Bar is also open for refreshments you can take inside with you.]]>\n            </comment>\n            <event_attribute>BiAs</event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670598/events/428765632/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670598/events/428765632.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173669696\">\n        <name>\n          <![CDATA[URCHIN]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><font size=\"5\">Urchin</font><font size=\"3\">&nbsp;</font></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/1becv3hogyvlmxyldsaglw3y68tc/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\"></p>\n\n\n\n<p><span><font size=\"3\">2025\nUK 99 mins </font></span></p>\n\n\n\n<p><span><font size=\"3\">Director: Harris Dickinson</font></span></p>\n\n\n\n<p><span><font size=\"3\">Stars: Frank Dillane, Megan Northam, Amr Waked </font></span></p>\n\n\n\n<p><font size=\"3\"><b><i><span>Urchin </span></i></b><span>is\nthe directorial debut of actor Harris Dickinson. The film tells the story of\nMike, a man living on the streets of London, trying to overcome addiction.\nStuck in a cycle of dependency, he makes repeated efforts to get clean while\nfacing the harsh realities of homelessness. With a gritty, unadorned approach,\nUrchin follows Mike&rsquo;s personal struggle to find stability and a sense of hope\nwhile living on the fringes of modern British society.</span></font></p><p><font size=\"3\"><span><i><b>Our 7:30pm screening includes descriptive subtitles for the hard of hearing.</b></i></span></font></p>]]>\n        </description>\n        <event_category>film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173669696/events</url>\n        <version>76</version>\n        <tags>\n          <tag>drama</tag>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/7ra502sf58zayr3ofp8kb2wvbe65/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/7ra502sf58zayr3ofp8kb2wvbe65/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/7ra502sf58zayr3ofp8kb2wvbe65/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-as