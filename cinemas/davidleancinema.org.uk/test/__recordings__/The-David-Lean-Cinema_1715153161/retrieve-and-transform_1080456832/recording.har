        "response": {
          "bodySize": 96010,
          "content": {
            "mimeType": "application/xml; charset=utf-8",
            "size": 96010,
            "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<venues>\n  <venue id=\"426566287\">\n    <name>\n      <![CDATA[David Lean Cinema]]>\n    </name>\n    <shows>\n      <show id=\"1173670606\">\n        <name>\n          <![CDATA[1984]]>\n        </name>\n        <description>\n          <![CDATA[<p><font size=\"5\"><b>1984&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/o7sxiggwyeubtzdn6syqzfv7upbe/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\"></p>\n\n<p><span><font size=\"3\">1988 UK/Netherlands/Germany 113 mins </font></span></p>\n\n<p><span><font size=\"3\">Director: Michael Radford</font></span></p>\n\n<p><span><font size=\"3\">Stars: John Hurt, Richard Burton, Suzanna Hamilton</font></span></p>\n\n<p><span><font size=\"3\">The\nrise of authoritarian regimes and misuse of social media and digital technology\nhave arguably made Orwell&rsquo;s classic more relevant than when this fine\nadaptation was released. Radford&rsquo;s film is beautifully photographed by Roger\nDeakins and features great performances from John Hurt as Winston Smith, and\nespecially from Richard Burton, who was born 100 years ago, as O&rsquo;Brien &ndash; this\nwas his last film.&nbsp;</font></span></p><p><span><b><i><font size=\"3\">A 35mm presentation in association with</font><font size=\"4\">&nbsp;</font></i></b></span><font size=\"4\"><a href=\"http://www.cinemamuseum.org.uk/\">The Cinema Museum</a><span><b><i>.</i></b></span></font></p>]]>\n        </description>\n        <event_category>35mm Film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173670606/events</url>\n        <version>56</version>\n        <tags>\n          <tag>drama</tag>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/8ppbwitp9gd97albx2ib43y2580n/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/8ppbwitp9gd97albx2ib43y2580n/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/8ppbwitp9gd97albx2ib43y2580n/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/o7sxiggwyeubtzdn6syqzfv7upbe/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/o7sxiggwyeubtzdn6syqzfv7upbe/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/o7sxiggwyeubtzdn6syqzfv7upbe/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=SXq3yMhobEU</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428765658\">\n            <name>\n              <![CDATA[15 Nov 2025 - 14:00 @ David Lean Cinema - (opening time 13:15) 1984]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-15T14:00:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-15T13:15:00+00:00</opening_time_iso>\n            <event_number>428765658</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[A 35mm film presentation in association with The Cinema Museum. ]]>\n            </comment>\n            <event_attribute>35mm film</event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670606/events/428765658/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670606/events/428765658.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173670587\">\n        <name>\n          <![CDATA[A BAND CALLED DEATH]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><font size=\"5\">A Band\nCalled Death</font><font size=\"3\"> (12A)</font></b><span style=\"font-size:medium;\">&nbsp;</span></p><p><span><font size=\"3\">Documentary</font></span></p><p><span><font size=\"3\">2012 USA 96 mins </font></span></p>\n\n<p><span><font size=\"3\">Directors:\nMark Covino, Jeff Howlett \nFeaturing: Death, Alice Cooper, Henry Rollins </font></span></p>\n\n<p><span><font size=\"3\">We&apos;re marking the second anniversary\nof our Punk Film Festival with a highly-acclaimed documentary virtually unseen\nin UK cinemas. Death was formed in Detroit in the early 1970s by three black\nbrothers: Bobby, Dannis and David Hackney. They grew up in a spiritual,\nMotown-loving household, but seeing The Who inspired them to embrace rock.\nTheir raw debut album is now considered groundbreaking proto-punk, but was\nunreleased for decades because their prospective record company rejected their\nname! Bobby and Dannis reminisce with charm and humour, and the uplifting\nsecond half explores Death&rsquo;s rediscovery and revival. &ldquo;Rewrites punk history\nand tells an emotional story of faith and family&rdquo; (<i>The Playlist</i>).</font></span></p>]]>\n        </description>\n        <event_category>documentary</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173670587/events</url>\n        <version>49</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/wt6xcb5bxummfzsh76jivpxanern/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/wt6xcb5bxummfzsh76jivpxanern/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/wt6xcb5bxummfzsh76jivpxanern/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=RDPDm9_nX0o</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428765580\">\n            <name>\n              <![CDATA[05 Nov 2025 - 19:30 @ David Lean Cinema - (opening time 14:00) A BAND CALLED DEATH]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-05T19:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-05T14:00:00+00:00</opening_time_iso>\n            <event_number>428765580</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670587/events/428765580/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670587/events/428765580.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173670597\">\n        <name>\n          <![CDATA[A HOUSE OF DYNAMITE]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><font size=\"5\">A\nHouse of Dynamite&nbsp;</font></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/a1y6bwdfs1soa3ua8dnv4i160zo0/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\"></p>\n\n\n\n<p><span><font size=\"3\">Drama | Thriller</font></span></p><p><span><font size=\"3\">2025 USA 112 mins</font></span></p>\n\n<p><span><font size=\"3\">Director: Kathryn Bigelow</font></span></p>\n\n<p><span><font size=\"3\">Stars: Idris Elba, Rebecca Ferguson, Gabriel Basso</font></span></p>\n\n<p><font size=\"3\"><span>A missile\nhas been launched at the United States. No one knows who is behind it, or\nwhether more are on the way &mdash; only that in less than 20 minutes a major\nAmerican city could be obliterated. Told through three converging strands: in\nthe White House Situation Room and a US military base racing to launch an\nintercept; among security advisors scrambling to brief their superiors; and\nwith the President and political leaders as they face impossible decisions -\nescalate or de-escalate? Kathryn Bigelow &mdash; director of the\nOscar-winning&nbsp;The <i>Hurt Locker</i>&nbsp;(2008) and&nbsp;<i>Zero Dark\nThirty</i>&nbsp;(2012) &mdash; once again blends excruciating tension with her\nhallmark commitment to military and political authenticity.</span></font></p><p><font size=\"3\"><span><b>Our 7:30pm screening includes &quot;descriptive subtitles&quot; for the hard of hearing.</b></span></font></p>]]>\n        </description>\n        <event_category>film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173670597/events</url>\n        <version>49</version>\n        <tags>\n          <tag>drama</tag>\n          <tag>thriller</tag>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/cv8g95ditci6xrdk51ff6ntn0yhs/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/cv8g95ditci6xrdk51ff6ntn0yhs/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/cv8g95ditci6xrdk51ff6ntn0yhs/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/a1y6bwdfs1soa3ua8dnv4i160zo0/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/a1y6bwdfs1soa3ua8dnv4i160zo0/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/a1y6bwdfs1soa3ua8dnv4i160zo0/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=_wpw2QHJNco</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428765629\">\n            <name>\n              <![CDATA[06 Nov 2025 - 14:30 @ David Lean Cinema - (opening time 13:45) A HOUSE OF DYNAMITE]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-06T14:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-06T13:45:00+00:00</opening_time_iso>\n            <event_number>428765629</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670597/events/428765629/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670597/events/428765629.xml</url>\n            </feed>\n          </event>\n          <event id=\"428765630\">\n            <name>\n              <![CDATA[06 Nov 2025 - 19:30 @ David Lean Cinema - (opening time 18:45) A HOUSE OF DYNAMITE]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-06T19:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-06T18:45:00+00:00</opening_time_iso>\n            <event_number>428765630</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute>HoH Subtitled</event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670597/events/428765630/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670597/events/428765630.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173669700\">\n        <name>\n          <![CDATA[CHILDREN OF THE WICKER MAN]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><font size=\"5\">Children of The Wicker Man</font><font size=\"3\">&nbsp;</font><font size=\"5\">+ Q&amp;A + Book Launch&nbsp;</font><font size=\"3\">(Council Cert 15)</font></b></p>\n\n\n\n<p><span><font size=\"3\">Documentary</font></span></p><p><span><font size=\"3\">2024\nUK 92 mins&nbsp;&nbsp;</font></span></p>\n\n\n\n<p><span><font size=\"3\">Directors:\nJustin Hardy, Dominic Hardy</font></span></p><p><font size=\"3\"><b><i><span style=\"background-color:rgb(255, 255, 0);\">We&apos;re delighted that directors Justin and Dominic Hardy, and producer Dr Chris Nunn, will join us for a Q&amp;A following the screening.&nbsp;</span></i></b></font><font><em><b><font size=\"3\" style=\"background-color:rgb(255, 255, 0);\">A new book accompanying the film will be launched the same evening at the David Lean, and&nbsp;copies signed by Justin, Dominic and Chris will be available. Further details of the book can be seen</font><font size=\"4\" color=\"#0000ff\" style=\"background-color:rgb(255, 255, 0);\">&nbsp;</font></b></em></font><font size=\"4\" color=\"#0000ff\"><b><a href=\"https://thehistorypress.co.uk/publication/children-of-the-wicker-man\" target=\"_blank\" title=\"HERE\"><i style=\"background-color:rgb(255, 255, 0);\">here</i></a><font><em><span style=\"background-color:rgb(255, 255, 0);\">.&nbsp;</span></em><span style=\"background-color:rgb(255, 255, 0);\">&nbsp;</span></font></b></font></p><p><i style=\"font-family:inherit;font-size:medium;\">Halloween\nscreening.</i><i style=\"font-family:inherit;font-size:medium;\"> The Wicker\nMan</i><span style=\"font-family:inherit;font-size:medium;\">\n(1973) is revered as &ldquo;The <i>Citizen Kane</i>\nof horror movies&rdquo; (<i>Cinefantastique</i>),\nand stories linked to its making are a key part of its mystique. This\nextraordinary new documentary offers revealing insights from participants such\nas producer Peter Snell, but it&rsquo;s also deeply moving, as director Robin Hardy&rsquo;s\nsons Justin and Dominic contemplate their memories while visiting locations,\nhaving inherited a large box of their father&rsquo;s papers. Hardy&rsquo;s desire to make\nhis debut film had devastating consequences for his family, so can the two\nbrothers be reconciled to its legacy and conclude it was worth it?&nbsp; &nbsp;</span></p>]]>\n        </description>\n        <event_category>documentary</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173669700/events</url>\n        <version>92</version>\n        <tags>\n          <tag>documentary</tag>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/y7jog26xo2khbxtwhst1eurt3mxv/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/y7jog26xo2khbxtwhst1eurt3mxv/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/y7jog26xo2khbxtwhst1eurt3mxv/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=Lnjx6OjX050</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428751410\">\n            <name>\n              <![CDATA[31 Oct 2025 - 19:00 @ David Lean Cinema - (opening time 18:15) CHILDREN OF THE WICKER MAN]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-10-31T19:00:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-10-31T18:15:00+00:00</opening_time_iso>\n            <event_number>428751410</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[Please note the earlier start time due to a Q&A session following the screening.]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173669700/events/428751410/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173669700/events/428751410.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173669684\">\n        <name>\n          <![CDATA[DOWNTON ABBEY: THE GRAND FINAL]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><font size=\"5\">Downton\nAbbey: The Grand Finale&nbsp;</font></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/2o68n66hxs5pbcixumm9q71piwnd/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\"></p>\n\n\n\n<p><span><font size=\"3\">Drama</font></span></p><p><span><font size=\"3\">2025\nUK 123 mins<b></b></font></span></p>\n\n\n\n<p><span><font size=\"3\">Director:\nSimon Curtis </font></span></p>\n\n\n\n<p><span><font size=\"3\">Stars:\nHugh Bonneville, Jim Carter, Michelle Dockery, Paul Giamatti, Dominic West,\nElizabeth McGovern, Penelope Wilton</font></span></p>\n\n<p><b><font size=\"3\"><i></i></font></b></p>\n\n<p><font size=\"3\"><span>The beloved aristocratic Crawley family and their\ndevoted staff return to the big screen for one final, heart-warming chapter of\nDownton Abbey. Set in the early 1930s, the film follows Lady Mary (Michelle\nDockery) as she faces a public scandal brought on by her divorce, while the\nfamily contends with mounting financial pressures and the looming threat of\nsocial disgrace. Amidst the challenges, there are tender moments, sparkling\nwit, and the comforting charm of familiar faces, along with some delightful new\narrivals. With grand British locations, glamorous homes, and a sense of\nnostalgia, this cinematic farewell celebrates the enduring spirit of Downton as\nthe next generation carries the legacy forward.</span></font></p><p><font size=\"2\"><b><i>Our 2:30pm screening includes descriptive subtitles for the hard of hearing.</i></b></font></p>]]>\n        </description>\n        <event_category>film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173669684/events</url>\n        <version>93</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/jq2rngl6y5vw95331yqvfmtylwuh/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/jq2rngl6y5vw95331yqvfmtylwuh/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/jq2rngl6y5vw95331yqvfmtylwuh/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/2o68n66hxs5pbcixumm9q71piwnd/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/2o68n66hxs5pbcixumm9q71piwnd/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/2o68n66hxs5pbcixumm9q71piwnd/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=P_30wFRxlnA</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428764825\">\n            <name>\n              <![CDATA[25 Oct 2025 - 14:00 @ David Lean Cinema - (opening time 13:15) DOWNTON ABBEY: THE GRAND FINAL]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"IST\">2025-10-25T14:00:00+01:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"IST\">2025-10-25T13:15:00+01:00</opening_time_iso>\n            <event_number>428764825</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173669684/events/428764825/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173669684/events/428764825.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173670610\">\n        <name>\n          <![CDATA[FRANKENSTEIN]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><span><font size=\"5\">Frankenstein (Cert TBC)</font></span></b></p>\n\n<p><font size=\"3\"><span>Drama</span></font></p><p><font size=\"3\"><span>2025 </span><span>USA</span><span> 149 mins </span></font></p>\n\n<p><font size=\"3\"><span><a href=\"https://www.google.com/search?sca_esv=6cbca24adcd9a5c8&rlz=1C5MACD_enGB1077GB1077&sxsrf=AE3TifP0Ghh3EAbSuQYNObkp_1cp3z_H6g:1755508731157&q=urchin+film&si=AMgyJEsS9yFPUNnJcpkaSNMRXqlE0YaJTIXYThjblyvVE2JL_oFLjZeXkuHL-UcFGUvNgL5buITa_afPpj-dOk9I4DGjB0A5AxDnRYQf-5r7_S8uDN0yShg%3D&sa=X&sqi=2&ved=2ahUKEwjojMjSg5SPAxUk0wIHHUB8IoQQyNoBKAB6BAgjEAA&ictx=1\"></a></span><span>Director: Guillermo del Toro</span></font></p>\n\n<p><span><font size=\"3\">Stars: Oscar Isaac, Jacob Elordi, Mia\nGoth, Christoph Waltz </font></span></p>\n\n\n\n<p><span><font size=\"3\">Guillermo del Toro reanimates Mary Shelley&rsquo;s timeless horror\nmasterpiece with his signature dark artistry. Dr. Victor Frankenstein, played\nby Oscar Isaac, is a brilliant but tormented scientist who defies nature by\ncreating life from death. His monstrous creation, portrayed by Jacob Elordi, is\nboth terrifying and tragically human.With Mia Goth as Victor&rsquo;s love interest, this chilling adaptation\nbreathes new life into a Gothic classic, reminding us that true horror lies not\nonly in monsters, but in their makers.</font></span></p>]]>\n        </description>\n        <event_category>film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173670610/events</url>\n        <version>43</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/t5ue871famjp0z1onpanq9c8liof/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/t5ue871famjp0z1onpanq9c8liof/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/t5ue871famjp0z1onpanq9c8liof/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=x--N03NO130</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428765665\">\n            <name>\n              <![CDATA[19 Nov 2025 - 17:30 @ David Lean Cinema - (opening time 16:45) FRANKENSTEIN]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-19T17:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-19T16:45:00+00:00</opening_time_iso>\n            <event_number>428765665</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670610/events/428765665/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670610/events/428765665.xml</url>\n            </feed>\n          </event>\n          <event id=\"428765666\">\n            <name>\n              <![CDATA[22 Nov 2025 - 14:00 @ David Lean Cinema - (opening time 13:15) FRANKENSTEIN]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-22T14:00:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-22T13:15:00+00:00</opening_time_iso>\n            <event_number>428765666</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670610/events/428765666/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670610/events/428765666.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173670612\">\n        <name>\n          <![CDATA[I SWEAR]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><font size=\"5\">I Swear&nbsp;</font></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/jqfbm3vfr9e8vk2gf8qeajexgq5e/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\"></p>\n\n<p><font size=\"3\">Comedy | Drama</font></p><p><font size=\"3\">2025 UK 121 mins </font></p>\n\n<p><font size=\"3\">Director: Kirk Jones</font></p>\n\n<p><font size=\"3\">Stars: Robert Aramayo, Maxine Peake, Shirley Henderson</font></p>\n\n<p><font size=\"3\"><i><b>I Swear</b></i> is the emotional, compassionate yet\nhumorous journey of Tourette&apos;s activist John Davidson, who was diagnosed at a\nyoung age. Initially alienated from his peers and family, and struggling with a\ncondition few people had witnessed, Davidson persevered in his desire to live a\n&apos;normal&apos; life against the odds and finds some unlikely champions. The film is\nabout identity, dignity, and the real work of advocacy, bringing both tears and\nlaughter to this extraordinary true-life story.</font></p><p><font size=\"3\">Our 2pm screening includes &quot;descriptive subtitles&quot; for those with hearing loss</font></p><p><span style=\"background-color:rgb(255, 255, 0);\"><span style=\"font-size:medium;\">Following the 2pm screening, </span><span style=\"font-size:medium;\">the Croydon U3A Film Group will hold a</span><font size=\"3\">&nbsp;post-film discussion. Anyone is welcome to stay and listen/take part.</font></span></p>]]>\n        </description>\n        <event_category>film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173670612/events</url>\n        <version>63</version>\n        <tags>\n          <tag>comedy</tag>\n          <tag>drama</tag>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/x8zkyvg67xal2daorg07392n2gw0/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/x8zkyvg67xal2daorg07392n2gw0/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/x8zkyvg67xal2daorg07392n2gw0/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/jqfbm3vfr9e8vk2gf8qeajexgq5e/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/jqfbm3vfr9e8vk2gf8qeajexgq5e/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/jqfbm3vfr9e8vk2gf8qeajexgq5e/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=oeWqQN3snCU</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428765669\">\n            <name>\n              <![CDATA[27 Nov 2025 - 14:00 @ David Lean Cinema - (opening time 13:15) I SWEAR]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-27T14:00:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-27T13:15:00+00:00</opening_time_iso>\n            <event_number>428765669</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[Following the screening, the Croydon U3A film group will hold a post film discussion. Everyone is welcome to stay and take part.]]>\n            </comment>\n            <event_attribute>HoH Subtitled</event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670612/events/428765669/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670612/events/428765669.xml</url>\n            </feed>\n          </event>\n          <event id=\"428765670\">\n            <name>\n              <![CDATA[27 Nov 2025 - 19:30 @ David Lean Cinema - (opening time 18:45) I SWEAR]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-27T19:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-27T18:45:00+00:00</opening_time_iso>\n            <event_number>428765670</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670612/events/428765670/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670612/events/428765670.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173670607\">\n        <name>\n          <![CDATA[KONTINENTAL 25]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><span><font size=\"5\">Kontinental &apos;25&nbsp;</font></span></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/mlp13es6nk4tya1vacq2rm694r5f/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\"></p><p><font size=\"3\">Drama</font></p>\n\n<p><span><font size=\"3\">2025\nRomania/Brazil/Switzerland/UK/Luxembourg 109 mins (<b>Romanian with English subtitles</b>)</font></span></p>\n\n<p><span><font size=\"3\">Director: Radu Jude</font></span></p>\n\n<p><span><font size=\"3\">Stars: Eszter Tompa, Gabriel Spahiu,\nAdonis Tanța</font></span></p>\n\n<p><font size=\"3\"><b><i><span>Kontinental &rsquo;25</span></i></b><span>&nbsp;marks\nthe return of art-house enfant terrible Radu Jude, who draws inspiration from\nRoberto Rossellini for his follow-up to 2023&rsquo;s cult hit&nbsp;<i>Do Not Expect\nToo Much from the End of the World</i>. After evicting a homeless man from his\nbasement, a Transylvanian bailiff becomes wracked with guilt, causing her to\nspiral into a desperate moral crisis. The ever-provocative director blends the\npersonal and the political to explore social responsibility, inequality, and\nthe ever-growing list of crises facing Europe &ndash; exactly the kind of material\nthat usually fires what can only be called Jude&rsquo;s&nbsp;<i>unique</i>&nbsp;sense\nof humour.</span></font></p>]]>\n        </description>\n        <event_category>film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173670607/events</url>\n        <version>42</version>\n        <tags>\n          <tag>drama</tag>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/v1tlbrloswrrppkjstur9opy2pen/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/v1tlbrloswrrppkjstur9opy2pen/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/v1tlbrloswrrppkjstur9opy2pen/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/mlp13es6nk4tya1vacq2rm694r5f/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/mlp13es6nk4tya1vacq2rm694r5f/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/mlp13es6nk4tya1vacq2rm694r5f/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=RknMLPTbMFs</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428765659\">\n            <name>\n              <![CDATA[18 Nov 2025 - 14:30 @ David Lean Cinema - (opening time 13:45) KONTINENTAL 25]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-18T14:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-18T13:45:00+00:00</opening_time_iso>\n            <event_number>428765659</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670607/events/428765659/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670607/events/428765659.xml</url>\n            </feed>\n          </event>\n          <event id=\"428765660\">\n            <name>\n              <![CDATA[18 Nov 2025 - 19:30 @ David Lean Cinema - (opening time 18:45) KONTINENTAL 25]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-18T19:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-18T18:45:00+00:00</opening_time_iso>\n            <event_number>428765660</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670607/events/428765660/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670607/events/428765660.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173670583\">\n        <name>\n          <![CDATA[LITTLE SHOP OF HORRORS]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><font size=\"5\">Little Shop of Horrors&nbsp;</font></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/yfc63mpaa7d55dkwuq4wifnh5zup/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\"></p>\n\n<p><span><font size=\"3\">Musical Comedy</font></span></p><p><span><font size=\"3\">1996\nUSA 94 mins</font></span></p>\n\n<p><font size=\"3\"><span>Director:\n</span>Frank Oz</font></p>\n\n<p><font size=\"3\"><span>Stars:\n</span>Rick Moranis, Ellen Greene, Steve Martin</font></p>\n\n<p><font size=\"3\">Flower shop assistant Seymour can&rsquo;t express his feelings for fellow\nworker Audrey. One night he discovers a talking carnivorous plant in the shop,\nwhich he christens Audrey II; but the plant develops a taste for human flesh,\nwhich Seymour is forced to supply&hellip; A musical treatment of Roger Corman&rsquo;s\nzero-budget comedy cult classic, it features a brilliant score (Audrey II is\nvoiced by Levi Stubbs of The Four Tops) and a truly over-the-top turn from\nSteve Martin as the sadistic biker dentist!</font></p>]]>\n        </description>\n        <event_category>Dementia-Friendly</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173670583/events</url>\n        <version>57</version>\n        <tags>\n          <tag>comedy</tag>\n          <tag>musical</tag>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/i483mruug88fhk9a868ri85an3yz/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/i483mruug88fhk9a868ri85an3yz/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/i483mruug88fhk9a868ri85an3yz/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/yfc63mpaa7d55dkwuq4wifnh5zup/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/yfc63mpaa7d55dkwuq4wifnh5zup/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/yfc63mpaa7d55dkwuq4wifnh5zup/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=z-wMvmAcshM</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428765571\">\n            <name>\n              <![CDATA[04 Nov 2025 - 11:00 @ David Lean Cinema - (opening time 10:15) LITTLE SHOP OF HORRORS]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-04T11:00:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-04T10:15:00+00:00</opening_time_iso>\n            <event_number>428765571</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[This is a relaxed screening for those living with dementia but all are welcome.]]>\n            </comment>\n            <event_attribute>Dementia-friendly</event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670583/events/428765571/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670583/events/428765571.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173670599\">\n        <name>\n          <![CDATA[LITTLE SHOP OF HORRORS - Relaxed Screening]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><font size=\"5\">Little Shop of Horrors&nbsp;</font></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/ek5b4qw4aqgnfowf0e5ghwbyxem6/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\"></p><p><font size=\"3\">Musical Comedy</font></p><p><font size=\"3\">1996 USA 94 mins</font></p><p><font size=\"3\">Director: Frank Oz</font></p><p><font size=\"3\">Stars: Rick Moranis, Ellen Greene, Steve Martin</font></p><p><font size=\"3\">Flower shop assistant Seymour can&rsquo;t express his feelings for fellow worker Audrey. One night he discovers a talking carnivorous plant in the shop, which he christens Audrey II; but the plant develops a taste for human flesh, which Seymour is forced to supply&hellip; A musical treatment of Roger Corman&rsquo;s zero-budget comedy cult classic, it features a brilliant score (Audrey II is voiced by Levi Stubbs of The Four Tops) and a truly over-the-top turn from Steve Martin as the sadistic biker dentist!</font></p><p><span style=\"background-color:rgb(255, 255, 0);font-family:inherit;font-size:medium;\">Relaxed Screening for members of the Neurodiverse Community</span></p>]]>\n        </description>\n        <event_category>Relaxed Screening</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173670599/events</url>\n        <version>82</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/20fqz79j7n5mdvgrv213t6oymkd9/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/20fqz79j7n5mdvgrv213t6oymkd9/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/20fqz79j7n5mdvgrv213t6oymkd9/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/ek5b4qw4aqgnfowf0e5ghwbyxem6/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/ek5b4qw4aqgnfowf0e5ghwbyxem6/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/ek5b4qw4aqgnfowf0e5ghwbyxem6/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=QqFZuR6UzjA</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428767206\">\n            <name>\n              <![CDATA[08 Nov 2025 - 11:00 @ David Lean Cinema - (opening time 10:15) LITTLE SHOP OF HORRORS - Relaxed Screening]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-08T11:00:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-08T10:15:00+00:00</opening_time_iso>\n            <event_number>428767206</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[This is a relaxed screening for those members of the neurodiverse community, but all are welcome.]]>\n            </comment>\n            <event_attribute>Relaxed Screening</event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670599/events/428767206/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670599/events/428767206.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173669693\">\n        <name>\n          <![CDATA[NT LIVE: MRS WARREN'S PROFESSION]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><font size=\"5\">NT\nLive: Mrs. Warren&rsquo;s Profession</font><font size=\"3\"> (TBC)</font></b></p>\n\n<p><font size=\"3\"><b></b></font></p>\n\n<p><span><font size=\"3\">2025\nUK 105 mins<br>\n\n</font></span></p>\n\n<p><span><font size=\"3\">Director:\nDominic Cooke</font></span></p>\n\n\n\n<p><span><font size=\"3\">Stars:\nImelda Staunton, Bessie Carter, Kevin Doyle, Robert Glenister</font></span></p>\n\n\n\n<p><span><font size=\"3\">Five-time\nOlivier Award winner Imelda Staunton (<i>The Crown</i>) joins forces with her\nreal-life daughter Bessie Carter (<i>Bridgerton</i>) for the very first time,\nplaying mother and daughter in Bernard Shaw&rsquo;s incendiary moral classic. Vivie\nWarren is a woman ahead of her time. Her mother, however, is a product of that\nold patriarchal order. Exploiting it has earned Mrs. Warren a fortune &ndash; but at\nwhat cost? Filmed live from the West End, this new production reunites Staunton\nwith director Dominic Cooke (<i>Follies</i>, <i>Good</i>), exploring the clash\nbetween morality and independence, traditions and progress. </font></span></p>]]>\n        </description>\n        <event_category>performance</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173669693/events</url>\n        <version>85</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/sg7120t2qun7ez9vyyv1hcq97dsb/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/sg7120t2qun7ez9vyyv1hcq97dsb/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/sg7120t2qun7ez9vyyv1hcq97dsb/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n        </properties>\n        <events>\n          <event id=\"428751397\">\n            <name>\n              <![CDATA[29 Oct 2025 - 18:30 @ David Lean Cinema - (opening time 17:45) NT LIVE: MRS WARREN'S PROFESSION]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-10-29T18:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-10-29T17:45:00+00:00</opening_time_iso>\n            <event_number>428751397</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[Please note, there is no interval in this performance.]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173669693/events/428751397/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173669693/events/428751397.xml</url>\n            </feed>\n          </event>\n          <event id=\"428767197\">\n            <name>\n              <![CDATA[26 Nov 2025 - 19:30 @ David Lean Cinema - (opening time 18:45) NT LIVE: MRS WARREN'S PROFESSION]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-26T19:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-26T18:45:00+00:00</opening_time_iso>\n            <event_number>428767197</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[Please note, there is no interval in this performance.]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173669693/events/428767197/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173669693/events/428767197.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173670582\">\n        <name>\n          <![CDATA[ONE FLEW OVER THE CUCKOO'S NEST]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><font size=\"5\">One Flew Over the Cuckoo&rsquo;s Nest&nbsp;</font></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/x564r7c0ufzdu3b28kqqtabuf8aj/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\"></p>\n\n<p><span><font size=\"3\">Drama</font></span></p><p><span><font size=\"3\">1975\nUSA 133 mins</font></span></p>\n\n<p><font size=\"3\"><span>Director:\n</span>Milos Forman</font></p>\n\n<p><font size=\"3\"><span>Stars:\n</span>Jack Nicholson, Louise Fletcher, Will Sampson</font></p>\n\n<p><font size=\"3\">Following our successful screening of Milos Forman&rsquo;s\nmulti-Oscar winner <i>Amadeus</i>, we are delighted to present a restoration of\nhis other Academy Award winner, which gained the five top Oscars in 1975. Jack\nNicholson plays McMurphy, a small-time criminal who feigns mental illness in\norder to avoid jail for the &lsquo;soft option&rsquo; of a mental hospital. He soon becomes\na hero to his fellow inmates, but cannot outwit Nurse Ratched, the chief nurse\nin the ward. Ken Kesey&rsquo;s counter-culture bestseller was in safe hands with\nForman, who Kirk Douglas had asked to direct it back in 1962, before his son\nMichael produced the film over a decade later.</font></p>]]>\n        </description>\n        <event_category></event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173670582/events</url>\n        <version>51</version>\n        <tags>\n          <tag>drama</tag>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/suicaaxmbq5a9tlz7bpzpkv9qo2h/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/suicaaxmbq5a9tlz7bpzpkv9qo2h/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/suicaaxmbq5a9tlz7bpzpkv9qo2h/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/x564r7c0ufzdu3b28kqqtabuf8aj/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/x564r7c0ufzdu3b28kqqtabuf8aj/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/x564r7c0ufzdu3b28kqqtabuf8aj/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=NWZXL_anruA</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428765570\">\n            <name>\n              <![CDATA[01 Nov 2025 - 14:00 @ David Lean Cinema - (opening time 13:15) ONE FLEW OVER THE CUCKOO'S NEST]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-01T14:00:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-01T13:15:00+00:00</opening_time_iso>\n            <event_number>428765570</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute>35mm film</event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670582/events/428765570/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670582/events/428765570.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173670584\">\n        <name>\n          <![CDATA[PASSIONS: CHI-CHI NWANOKU ON SAMUEL COLERIDGE-TAYLOR]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><font size=\"5\">Passions: Chi-Chi Nwanoku on Samuel Coleridge-Taylor&nbsp;</font></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/y8zlf1ckmrbr8gi2v2ro9ggvu2au/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\"></p>\n\n<p><span><font size=\"3\">Documentary | Performance | Q&amp;A</font></span></p><p><span><font size=\"3\">2017 UK 45 mins </font></span></p>\n\n<p><span><font size=\"3\">Director: Len\nBrown</font></span></p>\n\n\n\n<p><font size=\"3\"><span>To celebrate the\n150th anniversary of his birth, the David Lean is devoting a special evening to\ncelebrate Samuel Coleridge-Taylor, one of the most pre-eminent composers of his\nday who lived in Croydon for most of his short life. The evening will include a\nlive performance of some of his music, the screening of a 2017 Sky Arts\ndocumentary fronted by </span>Chi-Chi Nwanoku CBE, the Founder of the Chineke!\nOrchestra<span>,\nand a Q&amp;A discussing Coleridge-Taylor&rsquo;s legacy with </span>Chi-Chi and\nothers.<span>&nbsp;</span></font></p><p><font size=\"3\"><span><b>Tickets\n&pound;15.</b></span></font></p>]]>\n        </description>\n        <event_category>performance</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173670584/events</url>\n        <version>45</version>\n        <tags>\n          <tag>documentary</tag>\n          <tag>performance</tag>\n          <tag>template:event</tag>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/9f9jm1giz3vue6u5peq5sm2p6pdp/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/9f9jm1giz3vue6u5peq5sm2p6pdp/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/9f9jm1giz3vue6u5peq5sm2p6pdp/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/y8zlf1ckmrbr8gi2v2ro9ggvu2au/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/y8zlf1ckmrbr8gi2v2ro9ggvu2au/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/y8zlf1ckmrbr8gi2v2ro9ggvu2au/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=oepETzk0YLU</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428765575\">\n            <name>\n              <![CDATA[04 Nov 2025 - 19:30 @ David Lean Cinema - (opening time 17:30) PASSIONS: CHI-CHI NWANOKU ON SAMUEL COLERIDGE-TAYLOR]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-04T19:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2025-11-04T17:30:00+00:00</opening_time_iso>\n            <event_number>428765575</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[We hope to be able to offer ticket holders a curated tour of the Samuel Taylor Coleridge exhibition before the screening. Details will be e-mailed to customers nearer the time.]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173670584/events/428765575/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173670584/events/428765575.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173670611\">\n        <name>\n          <![CDATA[PLAINCLOTHES]]>\n        </name>\n        <description>\n          <![CDATA[<p><b><font size=\"5\">Plainclothes</font><font size=\"3\">&nbsp;</font></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/1n1ad6jffsbawypyymrnty3qgq6w/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\"></p>\n\n<p><b style=\"background-color:rgb(255, 255, 0);\">Plainclothes contains a sequence of flashing lights, which might affect viewers with photosensitive epilepsy</b><font size=\"3\"><br></font></p><p><font size=\"3\">Drama | Thriller</font></p><p><font size=\"3\">2025 USA 97 mins</font></p>\n\n<p><font size=\"3\">Director: Carmen Emmi</font></p>\n\n<p><font size=\"3\">Stars: Russell Tovey, Tom Blyth, Maria Dizzia</font></p>\n\n<p><font size=\"3\"><span>In the\nlate nineties, New York City cop Lucas (Tom Blyth) is struggling with his\nongoing assignment of targeting and arresting gay men in public bathrooms. His\nbeat is complicated when he meets Andrew (Russell Tovey), setting up a stylish\nand seductive game of cat-and-mouse which sees Lucas torn between desire and\nduty. An intense, thrilling debut from writer/director Carmen Emmi,&nbsp;<b><i>Plainclothes</i></b>&nbsp;is\npart gritty police drama, part anxious voyage of discovery.</span></font></p><p><font size=\"3\"><span>Our 2:30pm screening includes &ldquo;descriptive subtitles&quot; for the hard of hearing.</span></font></p>]]>\n        </description>\n        <event_category>film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173670611/events</url>\n        <version>46</version>\n        <tags>\n          <tag>drama</tag>\n          <tag>thriller</tag>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/t700woupkwvgjar2uqlsl99v9vba/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/t700woupkwvgjar2uqlsl99v9vba/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/t700woupkwvgjar2uqlsl99v9vba/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/1n1ad6jffsbawypyymrnty3qgq6w/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/1n1ad6jffsbawypyymrnty3qgq6w/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/1n1ad6jffsbawypyymrnty3qgq6w/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=gsjULVBjlMk</value>\n          </p