tk-block-column stk-column stk-block stk-a6fa1f5\" data-v=\"4\" data-block-id=\"a6fa1f5\"><style>@media screen and (min-width: 768px){.stk-a6fa1f5 {flex:var(--stk-flex-grow, 1) 1 66.7% !important;}}</style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-a6fa1f5-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-a6fa1f5-inner-blocks\">\n<div class=\"wp-block-group event-title is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-84d39786 wp-block-group-is-layout-flex\"><h1 style=\"font-style:normal;font-weight:600\" class=\"wp-block-post-title has-xx-large-font-size\">Teenage Sex and Death at Camp Miasma</h1>\n\n<p><img src=\"https://www.davidleancinema.org.uk/wp-content/themes/davidleancinema/img/15-icon.svg\" alt=\"15 certificate\" class=\"age-rating-icon\"></p>\n</div>\n\n\n\n<div class=\"wp-block-group event-meta has-white-color has-text-color has-link-color wp-elements-1 is-nowrap is-layout-flex wp-container-core-group-is-layout-36730ca6 wp-block-group-is-layout-flex\" style=\"font-size:clamp(0.929rem, 0.929rem + ((1vw - 0.2rem) * 0.856), 1.4rem);font-style:normal;font-weight:600;text-transform:none\">\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-2 wp-block-paragraph\">2026</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-3 wp-block-paragraph\">|</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-4 wp-block-paragraph\" style=\"text-transform:uppercase\">USA</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-5 wp-block-paragraph\">|</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-6 wp-block-paragraph\">112 min</p>\n</div>\n\n\n\n<div class=\"wp-block-group event-date has-white-color has-text-color has-link-color wp-elements-7 is-nowrap is-layout-flex wp-container-core-group-is-layout-36730ca6 wp-block-group-is-layout-flex\" style=\"font-size:clamp(0.929rem, 0.929rem + ((1vw - 0.2rem) * 0.856), 1.4rem);font-style:normal;font-weight:600;text-transform:none\">\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-8 wp-block-paragraph\">Tuesday 29 September</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-9 wp-block-paragraph\">at</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-10 wp-block-paragraph\">2.30pm and 7.30pm*</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-4a5f3f6b wp-block-group-is-layout-flex\" style=\"border-style:none;border-width:0px;margin-top:var(--wp--preset--spacing--20);margin-bottom:var(--wp--preset--spacing--20);padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\"><div style=\"line-height:1;text-transform:uppercase;padding-top:0px;padding-bottom:0px;padding-left:0px;padding-right:0px\" class=\"taxonomy-event-category wp-block-post-terms\">*Captioned</div></div>\n\n\n\n<div class=\"wp-block-group director-block is-nowrap is-layout-flex wp-container-core-group-is-layout-3e93bdf3 wp-block-group-is-layout-flex\" style=\"margin-top:0;margin-bottom:0;font-style:normal;font-weight:500\">\n<p class=\"wp-block-paragraph\" style=\"font-style:normal;font-weight:600\">Directed by:  Jane Schoenbrun</p>\n</div>\n\n\n\n<div class=\"wp-block-group stars-block is-nowrap is-layout-flex wp-container-core-group-is-layout-04822461 wp-block-group-is-layout-flex\">\n<p class=\"inline-para wp-block-paragraph\" style=\"font-style:normal;font-weight:600\">Stars: Hannah Einbinder, Gillian Anderson, Patrick Fischler</p>\n</div>\n\n\n<div style=\"padding-right:0px;padding-left:0px;margin-top:15px\" class=\"entry-content alignfull wp-block-post-content has-global-padding is-layout-constrained wp-container-core-post-content-is-layout-e5d1e14d wp-block-post-content-is-layout-constrained\">\n<p class=\"wp-block-paragraph\">When up-and-coming director Kris (Hannah Einbinder) gets the chance to reboot the long-dormant &#8220;Camp Miasma&#8221; horror franchise, she&#8217;s determined to do the series justice. Her first step is to convince the original movie&#8217;s &#8220;final girl&#8221;, the reclusive Billy Presley (Gillian Anderson) to return after decades away from the spotlight. Winning the Queer Palm at Cannes, the third film from cult auteur Jane Schoenbrun (I Saw the TV Glow) is a dazzling horror romance that pays barbed tribute to how our formative pop culture experiences can shape our lives &#8211; for good and evil.</p>\n</div>\n\n\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"margin-top:var(--wp--preset--spacing--30);margin-bottom:var(--wp--preset--spacing--30)\"><div class=\"ticket-buttons\"><a href=\"https://tinyurl.com/2r94chfh\" class=\"ticket-button\" target=\"_blank\" rel=\"noopener noreferrer\">BOOK NOW FOR 2.30PM</a><a href=\"https://tinyurl.com/2p9uhvwk\" class=\"ticket-button\" target=\"_blank\" rel=\"noopener noreferrer\">BOOK NOW FOR 7.30PM</a></div>\n</div>\n\n\n\n<div class=\"wp-block-group trailer-block has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"margin-top:15px\"><div class=\"youtube-responsive-wrapper\">\n        <iframe\n            src=\"https://www.youtube.com/embed/dimCiC_hdoA\"\n            title=\"YouTube video player\"\n            frameborder=\"0\"\n\t\t\treferrerpolicy=\"strict-origin-when-cross-origin\"\n            allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n            allowfullscreen><br />\n        </iframe>\n    </div>\n</div>\n</div></div></div>\n\n\n\n<div class=\"wp-block-stackable-column stk-block-column stk-column stk-block stk-3513d07\" data-v=\"4\" data-block-id=\"3513d07\"><style>@media screen and (min-width: 768px){.stk-3513d07 {flex:var(--stk-flex-grow, 1) 1 33.3% !important;}}@media screen and (max-width: 1023px){.stk-3513d07 {padding-top:30px !important;}}</style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-3513d07-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-3513d07-inner-blocks\">\n<p class=\"has-text-align-right has-roboto-condensed-font-family wp-block-paragraph\" style=\"font-style:normal;font-weight:700\">BACK TO: <a href=\"https://www.davidleancinema.org.uk/\" data-type=\"page\" data-id=\"7\">WHAT&#8217;S ON</a></p>\n\n\n\n<div class=\"wp-block-group event-poster-image has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"margin-bottom:15px\">\n<div class=\"wp-block-stackable-image stk-block-image stk-block stk-027db97\" data-block-id=\"027db97\"><figure><span class=\"stk-img-wrapper stk-image--shape-stretch stk--has-lightbox\"><img class=\"stk-img\" src=\"https://www.davidleancinema.org.uk/wp-content/uploads/2026/08/tsadacm-sheet.png\" width=\"150\" height=\"300\" alt=\"Film poster\"/></span></figure></div>\n</div>\n</div></div></div>\n</div></div>\n</div>\n</main>\n\n\n<footer class=\"wp-block-template-part\">\n<div class=\"wp-block-group has-mid-gold-background-color has-background is-layout-flow wp-block-group-is-layout-flow\" style=\"padding-top:0px;padding-bottom:var(--wp--preset--spacing--30)\">\n<div class=\"wp-block-group has-navy-background-color has-background has-global-padding is-layout-constrained wp-container-core-group-is-layout-154a3b34 wp-block-group-is-layout-constrained\" style=\"margin-bottom:20px;padding-top:30px;padding-bottom:30px\">\n<h2 class=\"wp-block-heading mail-strap has-gold-color has-text-color has-link-color wp-elements-11\" style=\"font-style:normal;font-weight:400;letter-spacing:1px\"><strong>SEE THE WORLD.</strong> <br>ONE FILM AT A TIME.</h2>\n\n\n\n<p class=\"has-white-color has-text-color has-link-color wp-elements-12 wp-block-paragraph\">Get our weekly updates by em