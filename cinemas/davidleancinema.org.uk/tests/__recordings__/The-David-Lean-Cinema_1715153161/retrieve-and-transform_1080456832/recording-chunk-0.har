            "text": "<!DOCTYPE html>\n<html lang=\"en-GB\">\n<head>\n\t<meta charset=\"UTF-8\" />\n\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<meta name='robots' content='index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' />\n\n\t<!-- This site is optimized with the Yoast SEO plugin v28.6 - https://yoast.com/product/yoast-seo-wordpress/ -->\n\t<meta name=\"description\" content=\"Beautifully photographed in Nepal, this story of Sir John Hunt’s expedition to conquer the highest mountain in the world concentrates on Nepalese-Indian sherpa Tenzing Norgay, who, with New Zealander Edmund Hillary, reached the summit of Everest in May 1953.\" />\n\t<link rel=\"canonical\" href=\"https://www.davidleancinema.org.uk/event/tenzing/\" />\n\t<meta property=\"og:locale\" content=\"en_GB\" />\n\t<meta property=\"og:type\" content=\"article\" />\n\t<meta property=\"og:title\" content=\"Tenzing - David Lean Cinema\" />\n\t<meta property=\"og:description\" content=\"Beautifully photographed in Nepal, this story of Sir John Hunt’s expedition to conquer the highest mountain in the world concentrates on Nepalese-Indian sherpa Tenzing Norgay, who, with New Zealander Edmund Hillary, reached the summit of Everest in May 1953.\" />\n\t<meta property=\"og:url\" content=\"https://www.davidleancinema.org.uk/event/tenzing/\" />\n\t<meta property=\"og:site_name\" content=\"David Lean Cinema\" />\n\t<meta property=\"article:publisher\" content=\"https://www.facebook.com/LeanCampaign/\" />\n\t<meta property=\"article:modified_time\" content=\"2026-09-27T09:07:08+00:00\" />\n\t<meta property=\"og:image\" content=\"https://dreamabstract.davidleancinema.uk/wp-content/uploads/2026/09/imresizer-resize-tenzing-leads-1152760691.jpg\" />\n\t<meta property=\"og:image:width\" content=\"1920\" />\n\t<meta property=\"og:image:height\" content=\"1080\" />\n\t<meta property=\"og:image:type\" content=\"image/jpeg\" />\n\t<meta name=\"twitter:card\" co