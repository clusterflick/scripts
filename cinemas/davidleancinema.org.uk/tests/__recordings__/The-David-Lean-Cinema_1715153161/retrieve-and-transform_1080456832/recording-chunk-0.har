1\" zone=\"GMT\">2026-11-12T14:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-12T13:45:00+00:00</opening_time_iso>\n            <event_number>428911982</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173692830/events/428911982/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173692830/events/428911982.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173692832\">\n        <name>\n          <![CDATA[QUEEN AT SEA]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font size=\"5\"><b>Queen at Sea&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/ay5pgie0yriknw5ajana4v4l0r2l/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Drama/Thriller</font></div><div><font size=\"3\">UK/USA | 2026 | 121 mins</font></div><div><font size=\"3\">Director:&nbsp;Lance Hammer</font></div><div><font size=\"3\">Stars:&nbsp;Juliette Binoche, Tom Courtenay, Anna\nCalder-Marshall</font></div><div><p><font size=\"3\">A major prize winner at its premier at the Berlin\nFilm Festival, Hammer&rsquo;s film follows Binoche&rsquo;s mother as she decides what is\nbest for the care of her mother Leslie, who has dementia, and is cared for by\nher step-father. Daughter and step-father clash over her care, while Leslie&rsquo;s\ncondition deteriorates, and her grand-daughter looks on, demused and side-lined\nby her mother. Anchored by the excellent performances of the three principal\nactors, <b>Queen at Sea</b> &ldquo;offers\na supremely nuanced illustration of a very real dilemma&rdquo; (</font><a href=\"https://www.bfi.org.uk/sight-and-sound/reviews/queen-sea-nuanced-unshowy-drama-about-moral-dilemmas-that-arise-with-dementia\"><font size=\"3\">Sight and Sound</font></a><font size=\"3\">).</font></p></div><div><br></div>]]>\n        </description>\n        <event_category></event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://www.davidleancinema.uk/#whatson</url>\n        <version>53</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/80aehp5wqug5x07yvmzcakd6fc6k/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/80aehp5wqug5x07yvmzcakd6fc6k/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/80aehp5wqug5x07yvmzcakd6fc6k/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/ay5pgie0yriknw5ajana4v4l0r2l/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/ay5pgie0yriknw5ajana4v4l0r2l/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/ay5pgie0yriknw5ajana4v4l0r2l/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            