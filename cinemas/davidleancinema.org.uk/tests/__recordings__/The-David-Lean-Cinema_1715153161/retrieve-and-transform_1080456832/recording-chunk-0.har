dal-left-content\">\n\t\t\n<div class=\"moove-gdpr-company-logo-holder\">\n\t<img src=\"https://www.davidleancinema.org.uk/wp-content/uploads/2026/07/DLC-logo-rgb.svg\" alt=\"\"   width=\"1\"  height=\"1\"  class=\"img-responsive\" />\n</div>\n<!--  .moove-gdpr-company-logo-holder -->\n\t\t<ul id=\"moove-gdpr-menu\" role=\"tablist\" aria-label=\"Cookie categories\">\n\t\t\t\n<li class=\"menu-item-on menu-item-privacy_overview menu-item-selected\" role=\"presentation\">\n\t<button data-href=\"#privacy_overview\" id=\"gdpr-tab-privacy_overview\" class=\"moove-gdpr-tab-nav\" role=\"tab\" aria-selected=\"true\" aria-controls=\"privacy_overview\" aria-label=\"Privacy Overview\">\n\t<span class=\"gdpr-nav-tab-title\">Privacy Overview</span>\n\t</button>\n</li>\n\n\t<li class=\"menu-item-strict-necessary-cookies menu-item-off\" role=\"presentation\">\n\t<button data-href=\"#strict-necessary-cookies\" id=\"gdpr-tab-strict-necessary-cookies\" class=\"moove-gdpr-tab-nav\" role=\"tab\" aria-selected=\"false\" aria-controls=\"strict-necessary-cookies\" tabindex=\"-1\" aria-label=\"Strictly Necessary Cookies\">\n\t\t<span class=\"gdpr-nav-tab-title\">Strictly Necessary Cookies</span>\n\t</button>\n\t</li>\n\n\n\t<li class=\"menu-item-off menu-item-third_party_cookies\" role=\"presentation\">\n\t<button data-href=\"#third_party_cookies\" id=\"gdpr-tab-third_party_cookies\" class=\"moove-gdpr-tab-nav\" role=\"tab\" aria-selected=\"false\" aria-controls=\"third_party_cookies\" tabindex=\"-1\" aria-label=\"Analytics\">\n\t\t<span class=\"gdpr-nav-tab-title\">Analytics</span>\n\t</button>\n\t</li>\n\n\n\n\t\t</ul>\n\t\t\n<div class=\"moove-gdpr-branding-cnt\">\n\t\t\t<a href=\"https://wordpress.org/plugins/gdpr-cookie-compliance/\" rel=\"noopener noreferrer\" target=\"_blank\" class='moove-gdpr-branding'>Powered by&nbsp; <span>GDPR Cookie Compliance</span><span class=\"gdpr-sr-only\"> (opens in a new tab)</span></a>\n\t\t</div>\n<!--  .moove-gdpr-branding -->\n\t\t</div>\n\t\t<!--  .moove-gdpr-modal-left-content -->\n\t\t<div class=\"moove-gdpr-modal-right-content\">\n\t\t<div class=\"moove-gdpr-modal-title\">\n\t\t\t \n\t\t</div>\n\t\t<!-- .moove-gdpr-modal-ritle -->\n\t\t<div class=\"main-modal-content\">\n\n\t\t\t<div class=\"moove-gdpr-tab-content\">\n\t\t\t\n<div id=\"privacy_overview\" class=\"moove-gdpr-tab-main\">\n\t\t\t<div class=\"tab-title\" role=\"heading\" aria-level=\"2\"><span class=\"gdpr-tab-title-text\">Privacy Overview</span></div>\n\t\t<div class=\"moove-gdpr-tab-main-content\">\n\t<p>This website uses cookies so that we can provide you with the best user experience possible. Cookie information is stored in your browser and performs functions such as recognising you when you return to our website and helping our team to understand which sections of the website you find most interesting and useful.</p>\n\t\t</div>\n\t<!--  .moove-gdpr-tab-main-content -->\n\n</div>\n<!-- #privacy_overview -->\n\t\t\t\n  <div id=\"strict-necessary-cookies\" class=\"moove-gdpr-tab-main\" style=\"display:none\">\n        <div class=\"tab-title\" role=\"heading\" aria-level=\"2\"><span class=\"gdpr-tab-title-text\">Strictly Necessary Cookies</span></div>\n    <div class=\"moove-gdpr-tab-main-content\">\n      <p>Strictly Necessary Cookie should be enabled at all times so that we can save your preferences for cookie settings.</p>\n      <div class=\"moove-gdpr-status-bar \">\n        <div class=\"gdpr-cc-form-wrap\">\n          <div class=\"gdpr-cc-form-fieldset\">\n            <label class=\"cookie-switch\" for=\"moove_gdpr_strict_cookies\">    \n              <input type=\"checkbox\" aria-label=\"Strictly Necessary Cookies\"  value=\"check\" name=\"moove_gdpr_strict_cookies\" id=\"moove_gdpr_strict_cookies\">\n              <span class=\"cookie-slider cookie-round gdpr-sr\" aria-hidden=\"true\" data-text-enable=\"Enabled\" data-text-disabled=\"Disabled\">\n                <span class=\"gdpr-sr-label\">\n                  <span class=\"gdpr-sr-e