         <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173692833/events/428890962/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173692833/events/428890962.xml</url>\n            </feed>\n          </event>\n          <event id=\"428890963\">\n            <name>\n              <![CDATA[28 Oct 2026 - 19:30 @ David Lean Cinema - (opening time 18:45) THE CYCLE OF LOVE]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-10-28T19:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-10-28T18:45:00+00:00</opening_time_iso>\n            <event_number>428890963</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173692833/events/428890963/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173692833/events/428890963.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173692834\">\n        <name>\n          <![CDATA[THE DOG STARS]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font size=\"5\"><b>The Dog Stars&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/y5fxtcqsvqdih96cmd96ch3f91m4/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Action/Adventure/Sci-Fi/Thriller</font></div><div><font size=\"3\">USA/UK | 2026 | 118 mins</font></div><div><font size=\"3\">Director:&nbsp;Ridley Scott</font></div><div><font size=\"3\">Stars:&nbsp;Jacob Elordi, Josh Brolin, Margaret Qualley</font></div><div><font size=\"2\"><b style=\"background-color:rgb(255, 255, 0);\"><i>Our 2:30pm screening includes captioned subtitles for those with hearing loss.</i></b></font></div><div><b style=\"background-color:rgb(255, 255, 0);\"><font size=\"2\"><i>This film contains flashing images which may affect viewers who are susceptible to photosensitive epilepsy.</i></font><font size=\"2\"></font></b></div><div><p><font size=\"3\">In a world ravaged by a virus that has wiped out most of\nhumanity, Jacob Elordi plays Hig, a pilot who lost everyone he loved. Living in\na small community, he and the other survivors stay ever wary of the ruthless\nscavengers who terrorise the few left alive. When a radio transmission crackles\nthrough the silence, it stirs a fragile hope that a better life might exist and\nHig risks everything on a chance at salvation. Margaret Qualley and Josh Brolin\nco-star in Ridley Scott&apos;s post-apocalyptic vision of the end of the world.</font></p></div>]]>\n        </description>\n        <event_category></event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://www.davidleancinema.uk/#whatson</url>\n        <version>61</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/vuycslrqireol58gx93ug66vege3/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/vuycslrqireol58gx93ug66vege3/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/vuycslrqireol58gx93ug66vege3/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <imag