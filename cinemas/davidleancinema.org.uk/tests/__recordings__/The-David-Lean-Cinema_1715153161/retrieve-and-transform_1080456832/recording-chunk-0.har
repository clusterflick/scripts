            "mimeType": "application/xml; charset=utf-8",
            "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<venues>\n  <venue id=\"426566287\">\n    <name>\n      <![CDATA[David Lean Cinema]]>\n    </name>\n    <shows>\n      <show id=\"1173681157\">\n        <name>\n          <![CDATA[A PRIVATE LIFE]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<b><font size=\"5\">A Private Life</font><font size=\"3\">&nbsp;</font></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/otw9xvbu6gsf6a5wwnvqdzdonxq8/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Drama/Mystery</font></div><div><font size=\"3\">France | 2026 | 107 mins (French with <b>English Subtitles</b>)</font></div><div><font size=\"3\">Director:&nbsp;Rebecca Zlotowski</font></div><div><font size=\"3\">Cast:&nbsp;Jodie Foster, Daniel Auteuil, Virginie Efira</font></div><div><p><font size=\"3\">Foster plays Lilian\nSteiner, an American\npsychiatrist adrift in Paris &mdash;\ndivorced, estranged from her son, and losing herself in her patients&apos; troubles.\nWhen one of her patients is found dead in an apparent suicide, Steiner can&apos;t let it go. Armed with little more\nthan professional instinct and the reluctant company of her ex-husband played\nby Daniel Auteil, she begins to dig. What unfolds is part Hitchcockian thriller\nand part wry relationship comedy.</font></p></div>]]>\n        </description>\n        <event_category>film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173681157/events</url>\n        <version>54</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/rnzvvqkwmnz0vso1ek2gbkm5wv2o/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/rnzvvqkwmnz0vso1ek2gbkm5wv2o/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/rnzvvqkwmnz0vso1ek2gbkm5wv2o/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/otw9xvbu6gsf6a5wwnvqdzdonxq8/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/otw9xvbu6gsf6a5wwnvqdzdonxq8/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/otw9xvbu6gsf6a5wwnvqdzdonxq8/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=HbIEbJbEpF4</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428839338\">\n            <name>\n              <![CDATA[30 Jul 2026 - 14:30 @ David Lean Cinema - (opening time 18:15) A PRIVATE LIFE]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"IST\">2026-07-30T14:30:00+01:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"IST\">2026-07-30T18:15:00+01:00</opening_time_iso>\n            <event_number>428839338</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173681157/events/428839338/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173681157/events/428839338.xml</url>\n            </feed>\n          </event>\n          <event id=\"428839339\">\n            <name>\n              <![CDATA[30 Jul 2026 - 19:30 @ David Lean Cinema - (opening time 18:45) A PRIVATE LIFE]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"IST\">2026-07-30T19:30:00+01:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"IST\">2026-07-30T18:45:00+01:00</opening_time_iso>\n            <event_number>428839339</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173681157/events/428839339/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173681157/events/428839339.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173687385\">\n        <name>\n          <![CDATA[ALL OF US STRANGERS]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font><b><font size=\"5\">All of Us Strangers&nbsp;</font></b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/tftjoh9p4gnxmj3hogglsz99wgqm/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\">&nbsp;<font><font size=\"3\">&amp; Q&amp;A with Author, John Grindod</font></font>\n</div><div><font size=\"3\">Genre(s): Drama/Fantasy/Romance</font></div><div><font size=\"3\">UK/USA| 2023 | 105 mins</font></div><div><font size=\"3\">Director: <font>Andrew Haigh</font></font></div><div>\n<font size=\"3\">Stars:&nbsp;</font><font size=\"3\">Andrew Scott, Paul Mescal, Jamie Bell, Claire Foy</font>\n</div><div>\n<p><font size=\"3\">A special screening of Andrew\nHaigh&apos;s&nbsp;<em><b>All of Us Strangers</b></em>, a film beloved of queer\nCroydonians, not least because it was set and shot in the borough. The\nscreening will be followed by a Q&amp;A with Croydon-born writer John Grindrod\ndiscussing the film and the many themes it shares with his new book,&nbsp;<em>Tales\nof the Suburbs: LGBTQ+ Lives Behind Net Curtains</em>. Discover stories\nof isolation and escape, love and community; and prepare to be devastated all\nover again by one of the great modern movies, back in its spiritual home.&nbsp;</font></p>\n<p><font size=\"4\"><b style=\"background-color:rgb(255, 255, 0);\">Followed by Q&amp;A with author John Grindrod, in partnership with Croydon Pride.</b></font></p>\n<p><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/kddthsb4jqtbeoy61ggedpl22feb/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\"><span style=\"font-family:inherit;font-size:medium;\"></span></p>\n<p><span style=\"font-family:inherit;font-size:medium;\">John Grindrod is a social historian of modern places. From\nNew Addington, he is the author of four books: Tales of the Suburbs: LGBTQ+ Lives\nBehind Net Curtains, Concretopia, Outskirts and Iconicon. All his books touch\non his beloved Croydon. He also runs the podcast Monstrosities Mon Amour where guests share their love of places\neveryone else hates. </span><a href=\"http://johngrindrod.co.uk/\" style=\"font-family:inherit;font-size:medium;\">johngrindrod.co.uk</a></p>\n<p><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/pc92totaj9xrrh8mu6mlgkkv325g/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\"><font size=\"3\"></font></p>\n<p><font size=\"3\">About Tales of the Suburbs: LGBTQ+ Lives Behind Net\nCurtains\n&apos;[A] fantastically entertaining alternative history of queer life in Britain .\n. .worthy of Victoria Wood.&apos;&nbsp;</font><a href=\"https://www.theguardian.com/books/2026/mar/05/tales-of-the-suburbs-by-john-grindrod-review-an-entertaining-alternative-history-of-queer-britain\" style=\"font-size:0.875rem;\">Guardian</a></p>\n<p><span style=\"font-family:inherit;font-size:medium;\">Throughout LGBTQ+ history, suburbia has been seen as\nsomewhere to escape from: a place where heterosexuality rules; where difference\nwill not be tolerated; where you&apos;ll never find a soulmate. But for many, those\nstreets of twitching curtains and pebble-dashed semis were - or still are - a\nplace to call home.</span></p>\n<p><span style=\"font-family:inherit;font-size:medium;\">From Addlestone to Wilmslow,&nbsp;Tales of the Suburbs:\nLGBTQ+ Lives Behind Net Curtains&nbsp;explores the relatively untold twentieth\ncentury tale of lesbian, gay, bisexual, trans and queer people in small towns\nand suburbia. Through remarkable archive material (much of which follows the\nfortunes of the Croydon Area Gay Society from the 1970s onwards) and original\ninterviews, social historian John Grindrod reveals stories that are messy and\nmoving, dark and funny, uplifting and extraordinary. Together, they reclaim\nsuburbia as a space for all - or those that want it - where counter-cultural\nexpression thrives despite the Neighbourhood Watch, and queer love and\nfriendship bloom against the odds.</span></p>\n</div><div>\n<blockquote>\n<div><div>\n</div></div>\n<blockquote>\n</blockquote>\n</blockquote>\n</div>]]>\n        </description>\n        <event_category>film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173687385/events</url>\n        <version>84</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/cyauyg2640tugu5r92dzlamv5lw5/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/cyauyg2640tugu5r92dzlamv5lw5/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/cyauyg2640tugu5r92dzlamv5lw5/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"10\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/tftjoh9p4gnxmj3hogglsz99wgqm/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/tftjoh9p4gnxmj3hogglsz99wgqm/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/tftjoh9p4gnxmj3hogglsz99wgqm/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/pc92totaj9xrrh8mu6mlgkkv325g/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/pc92totaj9xrrh8mu6mlgkkv325g/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/pc92totaj9xrrh8mu6mlgkkv325g/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/kddthsb4jqtbeoy61ggedpl22feb/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/kddthsb4jqtbeoy61ggedpl22feb/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/kddthsb4jqtbeoy61ggedpl22feb/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=O97iSjvqBlY</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428859662\">\n            <name>\n              <![CDATA[05 Aug 2026 - 19:00 @ David Lean Cinema - (opening time 18:15) ALL OF US STRANGERS]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-05T19:00:00+01:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-05T18:15:00+01:00</opening_time_iso>\n            <event_number>428859662</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[Our Arts bar will reopen after the film finishes to allow customers to purchase drinks and snacks to take back into the cinema before our guest speaker starts his Q&A session.]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173687385/events/428859662/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173687385/events/428859662.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173681493\">\n        <name>\n          <![CDATA[ARCO]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font size=\"5\">ARCO</font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/mymilmfr9zq1pgnncnzduuwex57q/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Animation</font></div><div><font size=\"3\">USA | 2026 | 88 mins</font></div><div><font size=\"3\">Director: Ugo Bienvenu</font></div><div><b><i style=\"background-color:rgb(255, 255, 0);\"><font size=\"3\">Family Film Club screening in association with Croydon Family Hubs: Tickets &pound;6</font></i></b></div><div>\n<font size=\"3\">In 2075, 10-year-old Iris sees a mysterious boy\nin a rainbow jumpsuit falling from the sky. Arco comes from a distant, idyllic\nfuture where time travel is possible. Iris takes Arco in and will do whatever\nit takes to help him return home. This Oscar and BAFTA nominated hand-drawn\nanimation is an uplifting film full of colour and excitement. &ldquo;Director\nBienvenu&hellip; has crafted a family film that&rsquo;s offbeat and full of heart&rdquo; (Time\nOut)<b><i>.&nbsp;</i></b></font>\n</div>]]>\n        </description>\n        <event_category></event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173681493/events</url>\n        <version>51</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/if3z8s3ojn6nkfyvz18fy4xxoa4h/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/if3z8s3ojn6nkfyvz18fy4xxoa4h/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/if3z8s3ojn6nkfyvz18fy4xxoa4h/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n  