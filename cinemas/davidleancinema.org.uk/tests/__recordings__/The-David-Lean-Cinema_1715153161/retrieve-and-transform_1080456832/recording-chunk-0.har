>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173681150/events/428839327/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173681150/events/428839327.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173687762\">\n        <name>\n          <![CDATA[COME SEE ME IN THE GOOD LIGHT]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font size=\"5\"><b>Come See Me In the Good Light&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/kzeyacfi9fg9lz9onu2c0vpfrurz/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Documentary</font></div><div><font size=\"3\">USA | 2025 ! 104 mins</font></div><div><font size=\"3\">Director:&nbsp;Ryan\nWhite</font></div><div><font size=\"3\"><font>Cast:&nbsp;</font>Megan Falley, Andrea Gibson</font></div><div>\n<p><font size=\"3\"><b>Introduction and Q&amp;A with Jo Scanlan&nbsp;</b><b>and Mia Bayes, Director of BFI Filmmaking Fund</b></font></p>\n<p><b style=\"background-color:rgb(255, 255, 0);\">Tickets are free but please consider making a donation to the cinema when booking.</b></p>\n</div><div>\n<p><font size=\"3\">This Oscar-nominated\ndocumentary tells the story of poets and lovers Andrea Gibson and Megan Falley,\nand how they deal with the former&rsquo;s diagnosis of ovarian cancer. Through the\nhighs and lows of the ongoing treatment, the partners attempt to live a full\nand happy life, which the film reflects through their poetry, prose, raunchy\njokes and bedtime whispers. A celebration of queer love under the deepest of\ntraumas.&nbsp;</font><span style=\"font-size:0.875rem;\">&nbsp;</span></p>\n</div>]]>\n        </description>\n        <event_category>documentary</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173687762/events</url>\n        <version>28</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/3cl55q7x8lcpeipgdxqawlafcglp/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/3cl55q7x8lcpeipgdxqawlafcglp/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/3cl55q7x8lcpeipgdxqawlafcglp/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/kzeyacfi9fg9lz9onu2c0vpfrurz/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/kzeyacfi9fg9lz9onu2c0vpfrurz/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/kzeyacfi9fg9lz9onu2c0vpfrurz/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=K0UB32fvru0</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428859696\">\n            <name>\n              <![CDATA[18 Aug 2026 - 19:00 @ David Lean Cinema - (opening time 18:15) COME SEE ME IN THE GOOD LIGHT]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-18T19:00:00+01:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-18T18:15:00+01:00</opening_time_iso>\n            <event_number>428859696</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173687762/events/428859696/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173687762/events/428859696.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173681153\">\n        <name>\n          <![CDATA[DISCLOSURE DAY]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font size=\"5\"><b>Disclosure Day&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/3z202yply50sgtsu86dfn8q1cm6p/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Drama/Sc-Fi/Thriller</font></div><div><font size=\"3\">USA | 2026 | 145 mins</font></div><div><font size=\"3\">Director:&nbsp;Steven Spielberg</font></div><div><font size=\"3\">Cast: Emily Blunt, Josh O&apos;Connor, Colin Firth.</font></div><div><b><i><font size=\"2\">Our Thursday 2:30pm screening includes descriptive subtitles for those&nbsp; with hearing loss</font></i></b></div><div><p><font size=\"3\">Spielberg, the\ndirector of <i>Close Encounters of the Third Kind</i>, <i>ET</i> and <i>War of\nthe Worlds</i>, continues with his fascination for the extra terrestrial with\nthis sci-fi thriller. When TV weather presenter Emily Blunt is seized by an\notherworldly force live on air, a terrifying chain of events is set in motion\nacross the globe. Josh O&rsquo;Connor and Colin Firth also star as a whistleblower\nand a ruthless government operative. Seven billion people. One explosive truth.\n<b><i>Disclosure Day</i></b> is coming.</font></p></div>]]>\n        </description>\n        <event_category>film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173681153/events</url>\n        <version>68</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/wcwzpe2nlyesmyu59v56gizgff84/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/wcwzpe2nlyesmyu59v56gizgff84/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/wcwzpe2nlyesmyu59v56gizgff84/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/3z202yply50sgtsu86dfn8q1cm6p/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/3z202yply50sgtsu86dfn8q1cm6p/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/3z202yply50sgtsu86dfn8q1cm6p/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n  