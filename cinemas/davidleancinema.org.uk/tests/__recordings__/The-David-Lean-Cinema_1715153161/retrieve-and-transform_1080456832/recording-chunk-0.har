;}}@media screen and (max-width: 767px){.stk-138c80e .stk--svg-wrapper .stk--inner-svg svg:last-child{height:30px !important;width:30px !important;}}</style><a class=\"stk-link\" href=\"https://davidleancinema.ticketsolve.com/ticketbooth/checkout/cart\" target=\"_blank\" rel=\"noreferrer noopener\"><span class=\"stk--svg-wrapper\"><div class=\"stk--inner-svg\"><svg style=\"height:0;width:0\"><defs><linearGradient id=\"linear-gradient-138c80e\" x1=\"0\" x2=\"100%\" y1=\"0\" y2=\"0\"><stop offset=\"0%\" style=\"stop-opacity:1;stop-color:var(--linear-gradient-138-c-80-e-color-1)\"></stop><stop offset=\"100%\" style=\"stop-opacity:1;stop-color:var(--linear-gradient-138-c-80-e-color-2)\"></stop></linearGradient></defs></svg><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 576 512\" aria-hidden=\"true\" width=\"32\" height=\"32\"><path d=\"M0 24C0 10.7 10.7 0 24 0H69.5c22 0 41.5 12.8 50.6 32h411c26.3 0 45.5 25 38.6 50.4l-41 152.3c-8.5 31.4-37 53.3-69.5 53.3H170.7l5.4 28.5c2.2 11.3 12.1 19.5 23.6 19.5H488c13.3 0 24 10.7 24 24s-10.7 24-24 24H199.7c-34.6 0-64.3-24.6-70.7-58.5L77.4 54.5c-.7-3.8-4-6.5-7.9-6.5H24C10.7 48 0 37.3 0 24zM128 464a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm336-48a48 48 0 1 1 0 96 48 48 0 1 1 0-96z\"/></svg></div></span></a></div>\n</div>\n</div>\n</div>\n</div>\n</header></div>\n\n\n\n<main id=\"wp--skip-link--target\" class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"margin-top:0\">\n<div class=\"wp-block-group alignfull has-light-gold-background-color has-background has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"padding-top:40px;padding-bottom:50px\">\n<div class=\"wp-block-stackable-columns stk-block-columns stk-block stk-60bfbb8\" data-block-id=\"60bfbb8\"><style>.stk-60bfbb8-column{--stk-columns-spacing:0px !important;--stk-column-gap:20px !important;}</style><div class=\"stk-row stk-inner-blocks stk-block-content stk-content-align stk-60bfbb8-column\">\n<div class=\"wp-block-stackable-column stk-block-column stk-column stk-block stk-a6fa1f5\" data-v=\"4\" data-block-id=\"a6fa1f5\"><style>@media screen and (min-width: 768px){.stk-a6fa1f5 {flex:var(--stk-flex-grow, 1) 1 66.7% !important;}}</style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-a6fa1f5-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-a6fa1f5-inner-blocks\">\n<div class=\"wp-block-group event-title is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-84d39786 wp-block-group-is-layout-flex\"><h1 style=\"font-style:normal;font-weight:600\" class=\"wp-block-post-title has-xx-large-font-size\">Crollywood Tour &amp; Heads of State: Redux premier</h1>\n\n<p><img src=\"https://www.davidleancinema.org.uk/wp-content/themes/davidleancinema/img/tbc.png\" alt=\"TBC certificate\" class=\"age-rating-icon\"></p>\n</div>\n\n\n\n<div class=\"wp-block-group event-meta has-white-color has-text-color has-link-color wp-elements-1 is-nowrap is-layout-flex wp-container-core-group-is-layout-36730ca6 wp-block-group-is-layout-flex\" style=\"font-size:clamp(0.929rem, 0.929rem + ((1vw - 0.2rem) * 0.856), 1.4rem);font-style:normal;font-weight:600;text-transform:none\">\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-2 wp-block-paragraph\">2026</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-3 wp-block-paragraph\">|</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-4 wp-block-paragraph\" style=\"text-transform:uppercase\">UK</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-5 wp-block-paragraph\">|</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-6 wp-block-paragraph\">5 mins</p>\n</div>\n\n\n\n<div class=\"wp-block-group event-date has-white-color has-text-color has-link-color wp-elements-7 is-nowrap is-layout-flex wp-container-core-group-is-layout-36730ca6 wp-block-group-is-layout-flex\" style=\"font-size:clamp(0.929rem, 0.929rem + ((1vw - 0.2rem) * 0.856), 1.4rem);font-style:normal;font-weight:600;text-transform:none\">\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-8 wp-block-paragraph\">Saturday 14 November</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-9 wp-block-paragraph\">at</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-10 wp-block-paragraph\">2pm</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-4a5f3f6b wp-block-group-is-layout-flex\" style=\"border-style:none;border-width:0px;margin-top:var(--wp--preset--spacing--20);margin-bottom:var(--wp--preset--spacing--20);padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\"></div>\n\n\n\n<div class=\"wp-block-group director-block is-nowrap is-layout-flex wp-container-core-group-is-layout-3e93bdf3 wp-block-group-is-layout-flex\" style=\"margin-top:0;margin-bottom:0;font-style:normal;font-weight:500\">\n<p class=\"wp-block-paragraph\" style=\"font-style:normal;font-weight:600\">Directed by: Richard DeDomenici</p>\n</div>\n\n\n\n\n<div style=\"padding-right:0px;padding-left:0px;margin-top:15px\" class=\"entry-content alignfull wp-block-post-content has-global-padding is-layout-constrained wp-container-core-post-content-is-layout-e5d1e14d wp-block-post-content-is-layout-constrained\">\n<p class=\"wp-block-paragraph\">Join us for an afternoon celebrating Crollywood with a walking tour of famous Croydon film locations (including <em>Batman, The Da Vinci Code, Criminal, Black Mirror </em>and Taylor Swift’s <em>Opalite</em>) followed by the premiere of <em>Heads of State: Redux</em> at the David Lean Cinema.</p>\n\n\n\n<p class=\"wp-block-paragraph\">In 2018, Croydonites commissioned artist Richard DeDomenici to make a low-budget recreation of scenes from the Hollywood movie&nbsp;<em>American Assassin</em>, set in Istanbul, but actually filmed on St George’s Walk, Croydon. The Redux, a shot-for-shot 4 minute long remake was filmed with local participants in the original locations. Richard returned in 2024 to Redux award-winning romantic fantasy&nbsp;<em>All of Us Strangers</em>&nbsp;in leafy Sanderstead.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Now he&#8217;s back with a new Redux of the high-octane action movie&nbsp;<em>Heads of State,</em>&nbsp;starring Idris Elba, John Cena and Priyanka Chopra &#8211; specifically the Warsaw chase scenes, actually filmed in Croydon Town Centre.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>In partnership with Croydonites. Tickets £15. </strong></p>\n</div>\n\n\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"margin-top:var(--wp--preset--spacing--30);margin-bottom:var(--wp--preset--spacing--30)\"><div class=\"ticket-buttons\"><a href=\"https://www.ticketsource.com/croydonites/richard-dedomenici-redux-heads-of-state/e-yrkkxd\" class=\"ticket-button\" target=\"_blank\" rel=\"noopener noreferrer\">DETAILS HERE</a></div>\n</div>\n\n\n\n<div class=\"wp-block-group trailer-block has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"margin-top:15px\"></div>\n</div></div></div>\n\n\n\n<div class=\"wp-block-stackable-column stk-block-column stk-column stk-block stk-3513d07\" data-v=\"4\" data-block-id=\"3513d07\"><style>@media screen and (min-width: 768px){.stk-3513d07 {flex:var(--stk-flex-grow, 1) 1 33.3% !important;}}@media screen and (max-width: 1023px){.stk-3513d07 {padding-top:30px !important;}}</style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-3513d07-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-3513d07-inner-blocks\">\n<p class=\"has-text-align-right has-roboto-condensed-font-family wp-block-paragraph\" style=\"font-style:normal;font-weight:700\">BACK TO: <a href=\"https://www.davidleancinema.org.uk/\" data-type=\"page\" data-id=\"7\">WHAT&#8217;S ON</a></p>\n\n\n\n<div class=\"wp-block-group event-poster-image has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"margin-bottom:15px\">\n<div class=\"wp-block-stackable-image stk-block-image stk-block stk-027db97\" data-block-id=\"027db97\"><figure><span class=\"stk-img-wrapper stk-image--shape-stretch stk--has-lightbox\"><img class=\"stk-img\" src=\"https://www.davidleancinema.org.uk/wp-content/uploads/2026/09/Heads-of-State-poster.jpg\" width=\"150\" height=\"300\" alt=\"Film poster\"/></span></figure></div>\n</div>\n</div></div></div>\n</div></div>\n</div>\n</main>\n\n\n<footer class=\"wp-block-template-part\">\n<div class=\"wp-block-group has-mid-gold-background-color has-background is-layout-flow wp-block-group-is-layout-flow\" style=\"padding-top:0px;padding-bottom:var(--wp--preset--spacing--30)\">\n<div class=\"wp-block-group has-navy-background-color has-background has-global-padding is-layout-constrained wp-container-core-group-is-layout-154a3b34 wp-block-group-is-layout-constrained\" style=\"margin-bottom:20px;padding-top:30px;padding-bottom:30px\">\n<h2 class=\"wp-block-heading mail-strap has-gold-color has-text-color has-link-color wp-elements-11\" style=\"font-style:normal;font-weight:400;letter-spacing:1px\"><strong>SEE THE WORLD.</strong> <br>ONE FILM AT A TIME.</h2>\n\n\n\n<p class=\"has-white-color has-text-color has-link-color wp-elements-12 wp-block-paragraph\">Get our weekly updates by email</p>\n\n\n\n<div class=\"wp-block-group is-content-justification-space-between is-nowrap is-layout-flex wp-container-core-group-is-layout-e3289ce6 wp-block-group-is-layout-flex\"><p><script>(function() {\n\twindow.mc4wp = window.mc4wp || {\n\t\tlisteners: [],\n\t\tforms: {\n\t\t\ton: function(evt, cb) {\n\t\t\t\twindow.mc4wp.listeners.push(\n\t\t\t\t\t{\n\t\t\t\t\t\tevent   : evt,\n\t\t\t\t