 <url>https://davidleancinema.ticketsolve.com/shows/1173693764/events/428897756/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173693764/events/428897756.xml</url>\n            </feed>\n          </event>\n          <event id=\"428897757\">\n            <name>\n              <![CDATA[04 Nov 2026 - 19:30 @ David Lean Cinema - (opening time 18:45) BABYSTAR]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-04T19:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-04T18:45:00+00:00</opening_time_iso>\n            <event_number>428897757</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173693764/events/428897757/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173693764/events/428897757.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173692748\">\n        <name>\n          <![CDATA[BAD APPLES]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font size=\"5\"><b>Bad Apples&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/nupi93dgbidkvp6jns75w73s46oz/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Comedy/Thriller</font></div><div><font size=\"3\">USA/UK | 2025| 100 mins</font></div><div><font size=\"3\">Director:&nbsp;Jonathan Etzler</font></div><div><font size=\"3\">Stars:&nbsp;Jacob Anderson, Saoirse Ronan, Robert Emms</font></div><div><font size=\"3\"><b>Our Tuesday 7:30pm screening contains captioned subtitles for those with hearing loss.</b></font></div><div><p><font size=\"3\">A blackly comic British thriller,\nadapted from the Swedish novel <i>De O&ouml;nskare</i> (The Unwanted), and starring\nSaoirse Ronan as struggling primary school teacher Maria. After a behavioural\nincident on a school trip, she makes an escalating series of bad choices.\nSurprised however by the knock-on effects of these decisions, the audience is\nultimately left to decide the fallout from Maria&apos;s extreme approach to\nclassroom management. Featuring some incredibly realistic classroom scenes and\nfantastic performances from Oscar nominee Ronan and her students played by\nEddie Waller and Nia Brown, this 2025 festival favourite is a must watch this\nterm.&nbsp;</font></p></div>]]>\n        </description>\n        <event_category></event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://www.davidleancinema.uk/#whatson</url>\n        <version>63</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/m7948jmwtfardwslandaajlxsjht/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/m7948jmwtfardwslandaajlxsjht/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/m7948jmwtfardwslandaajlxsjht/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/nupi93dgbidkvp6jns75w73s46oz/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            