    </name>\n        <description>\n          <![CDATA[]]>\n        </description>\n        <event_category>performance</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://www.davidleancinema.uk/#whatson</url>\n        <version>8</version>\n        <tags>\n        </tags>\n        <images>\n        </images>\n        <properties>\n        </properties>\n        <events>\n          <event id=\"428897777\">\n            <name>\n              <![CDATA[25 Nov 2026 - 18:30 @ David Lean Cinema - (opening time 17:45) NT LIVE: GOLDERN BOY]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-25T18:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-25T17:45:00+00:00</opening_time_iso>\n            <event_number>428897777</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute>NT Live</event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173693775/events/428897777/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173693775/events/428897777.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173692830\">\n        <name>\n          <![CDATA[PRESSURE]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font size=\"5\"><b>Pressure&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/e8jcwebuqp2na810t8ukyybm06cv/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Drama</font></div><div><font size=\"3\">UK/France/USA | 2026 | 100 mins</font></div><div><font size=\"3\">Director:&nbsp;Anthony Maras&nbsp;</font></div><div><font size=\"3\">Stars:&nbsp;Andrew Scott, Brendan Fraser, Kerry Condon&nbsp;</font></div><div><font size=\"2\"><b style=\"background-color:rgb(255, 255, 0);\">Our Thursday 22nd Oct 2pm screening contains captioned subtitles for those with hearing loss and a post-screening discussion facilitated by the Croydon u3a Film Group. Anyone is welcome to stay behind for a fun chat.</b></font></div><div><p><font size=\"3\"><b><i>Pressure </i></b>tells the\nremarkable untold story behind one of the most important decisions of the\nSecond World War. In the tense 72 hours before D-Day, Britain&rsquo;s chief\nmeteorological officer, Captain James Stagg (Scott), must convince Allied\ncommanders, including General Eisenhower (Fraser), whether the weather will\nallow the largest and most dangerous seaborne invasion in history to proceed.\nWith the fate of millions hanging in the balance, this is a fascinating look at\nthe people, decisions and the uncertainty that helped shape the course of\nhistory. Gripping, intelligent and led by a stellar cast.&nbsp;</font></p></div><div><br></div>]]>\n        </description>\n        <event_category></event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://www.davidleancinema.uk/#whatson</url>\n        <version>74</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/p8z31mhc81zle3pbg6ocmuo924o6/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/p8z31mhc81zle3pbg6ocmuo924o6/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/p8z31mhc81zle3pbg6ocmuo924o6/7c367cff06fd518c1c