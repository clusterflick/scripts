        </feed>\n          </event>\n          <event id=\"428897776\">\n            <name>\n              <![CDATA[28 Nov 2026 - 14:00 @ David Lean Cinema - (opening time 13:15) CASE 137]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-28T14:00:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-28T13:15:00+00:00</opening_time_iso>\n            <event_number>428897776</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173693774/events/428897776/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173693774/events/428897776.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173692751\">\n        <name>\n          <![CDATA[COTTON QUEEN]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font size=\"5\"><b>Cotton Queen&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/sz60espkpm2c38e8sdem0djzddl4/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Drama</font></div><div><font size=\"3\">SUD/GER/FRA/PAL/EGY/QAT/SAU | 2025 | 93 Mins (Arabic with English Subtitles)</font></div><div><font size=\"3\">Director:&nbsp;Suzannah Mirghani</font></div><div><font size=\"3\">Stars:&nbsp;Mihad Murtada, Rabha Mohamed Mahmoud, Talaat\nFareed</font></div><div>\n<p><font size=\"3\">Mirghani&rsquo;s\ndebut feature, a mixture of coming-of-age drama and post-colonial critique,\nfocusses on teenager Nafisa. Having grown up with her grandmother&rsquo;s tales of\noutsmarting the British, she works in the cotton fields of Sudan with her\nfriends. She is friendly with a local lad, but her mother has her sights set on\nher marriage to Nadir, a British businessman eager to sell his genetically\nmodified cotton seed to the local farmers. Old practices such as FGM come\nface-to-face with the modern world of corporate business and mobile phones in\nthis beautifully shot,</font> arresting film.</p>\n<p><span style=\"background-color:rgb(255, 255, 0);\"><b></b><b><i>Black History Month screening in conjunction with Croydon\nBlack History Partnership.</i></b></span></p>\n</div>]]>\n        </description>\n        <event_category></event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://www.davidleancinema.uk/#whatson</url>\n        <version>57</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/vnwjfobn7f2i3orwujhg9o0k7rwj/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/vnwjfobn7f2i3orwujhg9o0k7rwj/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/vnwjfobn7f2i3orwujhg9o0k7rwj/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/sz60espkpm2c38e8sdem0djzddl4/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/sz60espkpm2c38e8sdem0djzddl4/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3