ibute>35mm</event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173692837/events/428890968/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173692837/events/428890968.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173693762\">\n        <name>\n          <![CDATA[ELVIS: THAT'S THE WAY IT IS]]>\n        </name>\n        <description>\n          <![CDATA[]]>\n        </description>\n        <event_category>Dementia-Friendly</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://www.davidleancinema.uk/#whatson</url>\n        <version>9</version>\n        <tags>\n        </tags>\n        <images>\n        </images>\n        <properties>\n        </properties>\n        <events>\n          <event id=\"428897753\">\n            <name>\n              <![CDATA[03 Nov 2026 - 11:00 @ David Lean Cinema - (opening time 10:15) ELVIS: THAT'S THE WAY IT IS]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-03T11:00:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-03T10:15:00+00:00</opening_time_iso>\n            <event_number>428897753</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[This is a relaxed screening for those living with dementia but all are welcome.]]>\n            </comment>\n            <event_attribute>Dementia Friendly</event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173693762/events/428897753/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173693762/events/428897753.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173692749\">\n        <name>\n          <![CDATA[ENGLISH NATIONAL BALLET PRESENTS THE SLEEPING BEAUTY]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font><b><font size=\"5\">English Nation Ballet Presents Sleeping Beauty&nbsp;</font></b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/7fjclcnuwocofz62l0543bdf3apk/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre: Performance</font></div><div><font size=\"3\">UK | 2026 | 160 mins</font></div><div><font size=\"3\">Directors: Ross MacGibbon, Kenneth MacMillan</font></div><div>\n<p><font size=\"3\">This classic fairytale ballet with a famous Tchaikovsky\nscore, is choreographed by Sir Kenneth MacMillan and filmed from a limited run\nat The Royal Albert Hall. As a baby, Princess Aurora is cursed by the wicked\nCarabosse: on her 16th birthday, she will prick her finger and die. Her\ngodmother the Lilac Fairy alters the spell so Aurora will not die, but sleep\nfor 100 years. Only a true love&rsquo;s kiss can break the spell and awaken her. An\nexquisite version of one of the world&rsquo;s favourite stories.&nbsp;</font></p>\n<p><font size=\"3\"><b>Tickets &pound;15.</b></font></p>\n</div>]]>\n        </description>\n        <event_category>performance</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://www.davidleancinema.uk/#whatson</url>\n        <version>57</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/ysv7oaezqxbm228k8cix4469deb2/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net