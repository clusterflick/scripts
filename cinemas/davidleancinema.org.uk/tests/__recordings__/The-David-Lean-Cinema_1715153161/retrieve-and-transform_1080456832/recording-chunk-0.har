            "mimeType": "text/html; charset=UTF-8",
            "text": "<!DOCTYPE html>\n<html lang=\"en-GB\">\n<head>\n\t<meta charset=\"UTF-8\" />\n\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<meta name='robots' content='index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' />\n\n\t<!-- This site is optimized with the Yoast SEO plugin v28.6 - https://yoast.com/product/yoast-seo-wordpress/ -->\n\t<meta name=\"description\" content=\"Finn and his brother Charlie run away from their Yorkshire home to escape the turmoil of their fractured family life and avoid being separated from each other by their divorcing parents. Carried along by their own quick wits and the kindness of strangers, they head to the wild west coast of Ireland, the home of their beloved but estranged grandfather. This life affirming road movie is cleverly interwoven with flashbacks of joyful memories and features outstanding performances from a multi generational cast.\" />\n\t<link rel=\"canonical\" href=\"https://www.davidleancinema.org.uk/event/500-miles/\" />\n\t<meta property=\"og:locale\" content=\"en_GB\" />\n\t<meta property=\"og:type\" content=\"article\" />\n\t<meta property=\"og:title\" content=\"500 Miles - David Lean Cinema\" />\n\t<meta property=\"og:description\" content=\"Finn and his brother Charlie run away from their Yorkshire home to escape the turmoil of their fractured family life and avoid being separated from each other by their divorcing parents. Carried along by their own quick wits and the kindness of strangers, they head to the wild west coast of Ireland, the home of their beloved but estranged grandfather. This life affirming road movie is cleverly interwoven with flashbacks of joyful memories and features outstanding performances from a multi generational cast.\" />\n\t<meta property=\"og:url\" content=\"https://www.davidleancinema.org.uk/event/500-miles/\" />\n\t<meta property=\"og:site_name\" content=\"David Lean Cinema\" />\n\t<meta property=\"article:publish