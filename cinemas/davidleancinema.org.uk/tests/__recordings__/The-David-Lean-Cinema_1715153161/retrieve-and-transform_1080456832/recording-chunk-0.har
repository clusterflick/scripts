 id=\"moove_gdpr_cookie_info_bar\" class=\"moove-gdpr-info-bar-hidden moove-gdpr-align-center moove-gdpr-dark-scheme gdpr_infobar_postion_bottom\" aria-labelledby=\"moove_gdpr_cookie_info_bar_title\" tabindex=\"-1\" style=\"display: none;\">\n\t<div class=\"moove-gdpr-info-bar-container\">\n\t\t\t\t<div id=\"moove_gdpr_cookie_info_bar_title\" class=\"gdpr-sr-only\" role=\"heading\" aria-level=\"2\">GDPR Cookie Banner</div>\n\t\t<div class=\"moove-gdpr-info-bar-content\">\n\t\t\n<div class=\"moove-gdpr-cookie-notice\">\n  <p>We are using cookies to give you the best experience on our website.</p>\n<p>You can find out more about which cookies we are using or switch them off in <button  aria-haspopup=\"dialog\" data-href=\"#moove_gdpr_cookie_modal\" class=\"change-settings-button gdpr-settings-btn-style-2\">settings</button>.</p>\n</div>\n<!--  .moove-gdpr-cookie-notice -->\n\t\t\n<div class=\"moove-gdpr-button-holder\">\n\t\t\t<button class=\"mgbutton moove-gdpr-infobar-allow-all gdpr-fbo-0\" aria-label=\"Accept\" >Accept</button>\n\t\t\t\t\t\t<button class=\"mgbutton moove-gdpr-infobar-reject-btn gdpr-fbo-1 \"  aria-label=\"Reject\">Reject</button>\n\t\t\t</div>\n<!--  .button-container -->\n\t\t</div>\n\t\t<!-- moove-gdpr-info-bar-content -->\n\t</div>\n\t<!-- moove-gdpr-info-bar-container -->\n\t</aside>\n\t<!-- #moove_gdpr_cookie_info_bar -->\n\t<!--/copyscapeskip-->\n\t<script>\n\t\tdocument.addEventListener('facetwp-loaded', function () {\n\t\t\tconst message = document.body.classList.contains('tax-event-category')\n\t\t\t\t? 'Nothing in the current programme — but more are coming soon.'\n\t\t\t\t: 'Nothing on today — but there’s plenty coming up.';\n\n\t\t\tdocument.querySelectorAll('.facetwp-no-results p').forEach(function (el) {\n\t\t\t\tel.textContent = message;\n\t\t\t});\n\t\t});\n\t</script>\n\t\n    <style>\n    .trailer-modal {\n        position: fixed;\n        inset: 0;\n        display: none;\n        z-index: 99999;\n    }\n\n    .trailer-modal.active {\n        display: block;\n    }\n\n    .trailer-modal-overlay {\n        position: absolute;\n        inset: 0;\n        background: rgba(0,0,0,0.85);\n        cursor: pointer;\n    }\n\n    .trailer-modal-content {\n        position: relative;\n        width: 90%;\n        max-width: 960px;\n        margin: 5vh auto;\n        background: #000;\n        border-radius: 8px;\n        overflow: hidden;\n    }\n\n    .trailer-video-wrapper {\n        position: relative;\n        width: 100%;\n        padding-bottom: 56.25%;\n        height: 0;\n    }\n\n    .trailer-video-wrapper iframe {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        border: 0;\n    }\n\n    .trailer-modal-close {\n        position: absolute;\n        top: 10px;\n        right: 10px;\n        z-index: 10;\n        width: 40px;\n        height: 40px;\n        border: 0;\n        border-radius: 50%;\n        background: #fff;\n        color: #000;\n        font-size: 28px;\n        line-height: 1;\n        cursor: pointer;\n    }\n\n    </style>\n\n\n    <script>\n    document.addEventListener('DOMContentLoaded', function() {\n\n        const modal = document.createElement('div');\n\n        modal.className = 'trailer-modal';\n\n        modal.innerHTML = `\n            <div class=\"trailer-modal-overlay\"></div>\n            <div class=\"trailer-modal-content\">\n                <button class=\"trailer-modal-close\" aria-label=\"Close trailer\">&times;</button>\n                <div class=\"trailer-video-wrapper\"></div>\n            </div>\n        `;\n\n        document.body.appendChild(modal);\n\n\n        const videoWrapper = modal.querySelector('.trailer-video-wrapper');\n\n\n        function getYoutubeId(url) {\n\n            const regex = /(?:youtube\\.com\\/(?:watch\\?v=|embed\\/)|youtu\\.be\\/)([^&?#]+)/;\n\n            const match = url.match(regex);\n\n            return match ? match[1] : null;\n        }\n\n\n        document.addEventListener('click', function(e) {\n\n            const trigger = e.target.closest('.load-trailer');\n\n\n            if (trigger) {\n\n                const link = trigger.querySelector('a');\n\n                if (!link) {\n                    return;\n                }\n\n                e.preventDefault();\n\n                const videoId = getYoutubeId(link.href);\n\n\n                if (!videoId) {\n                    return;\n                }\n\n\n                videoWrapper.innerHTML = `\n                    <iframe\n                        src=\"https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0\"\n                        title=\"YouTube trailer\"\n                        allow=\"autoplay; encrypted-media; picture-in-picture\"\n\t\t\t\t\t\treferrerpolicy=\"strict-origin-when-cross-origin\"\n                        allowfullscreen>\n                    </iframe>\n                `;\n\n\n                modal.classList.add('active');\n\n            }\n\n\n            if (\n                e.target.classList.contains('trailer-modal-overlay') ||\n                e.target.classList.contains('trailer-modal-close')\n            ) {\n\n                modal.classList.remove('active');\n\n                videoWrapper.innerHTML = '';\n\n            }\n\n        });\n\n\n        document.addEventListener('keydown', function(e) {\n\n            if (e.key === 'Escape') {\n\n                modal.classList.remove('active');\n\n                videoWrapper.innerHTML = '';\n\n            }\n\n        });\n\n\n    });\n    </script>\n\n    <script data-wp-router-options=\"{&quot;loadOnClientNavigation&quot;:true}\" fetchpriority=\"low\" id=\"@wordpress/block-library/navigation/view-js-module\" src=\"https://www.davidleancinema.org.uk/wp-includes/js/dist/script-modules/block-library/navigation/view.min.js?ver=1bf28ded04f9f188bdcb\" type=\"module\"></script>\n<script>requestAnimationFrame(() => document.body.classList.add( \"stk--anim-init\" ))</script><script id=\"