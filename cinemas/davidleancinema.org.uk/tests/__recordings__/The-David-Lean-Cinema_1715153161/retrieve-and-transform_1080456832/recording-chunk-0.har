n War is won, but for Odysseus,\nKing of Ithaca, the greatest battle lies ahead. Tormented by vengeful gods and\nhunted by fearsome monsters, he must brave an unforgiving sea to reclaim his\nhomeland and reunite with his beloved wife Penelope. Academy Award-winning\ndirector Christopher Nolan brings Homer&apos;s immortal epic to life with an\nextraordinary cast led by Matt Damon, Tom Holland, Anne Hathaway and Robert\nPattinson, <b><i>The Odyssey</i></b> is set to be one of the biggest\nblockbusters of 2026.</font>\n<br></p></div>]]>\n        </description>\n        <event_category></event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173687754/events</url>\n        <version>28</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/0zxieoe1y7t3t4c5bs8iva0e1hbr/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/0zxieoe1y7t3t4c5bs8iva0e1hbr/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/0zxieoe1y7t3t4c5bs8iva0e1hbr/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=f_bKjZeJBBI</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428859686\">\n            <name>\n              <![CDATA[26 Aug 2026 - 17:30 @ David Lean Cinema - (opening time 16:45) THE ODYSSEY]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-26T17:30:0