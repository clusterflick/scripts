            "mimeType": "text/html; charset=UTF-8",
            "text": "<!DOCTYPE html>\n<html lang=\"en-GB\">\n<head>\n\t<meta charset=\"UTF-8\" />\n\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<meta name='robots' content='index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' />\n\n\t<!-- This site is optimized with the Yoast SEO plugin v28.6 - https://yoast.com/product/yoast-seo-wordpress/ -->\n\t<meta name=\"description\" content=\"Industrialist John Hammond and his team have created a wildlife park inhabited by re-created prehistoric animals. He invites a group of scientists to visit the park, but following a major power outage, the visitors have to battle the animals and escape the island. A 35mm presentation in association with The Cinema Museum.\" />\n\t<link rel=\"canonical\" href=\"https://www.davidleancinema.org.uk/event/jurassic-park/\" />\n\t<meta property=\"og:locale\" content=\"en_GB\" />\n\t<meta property=\"og:type\" content=\"article\" />\n\t<meta property=\"og:title\" content=\"Jurassic Park - David Lean Cinema\" />\n\t<meta property=\"og:description\" content=\"Industrialist John Hammond and his team have created a wildlife park inhabited by re-created prehistoric animals. He invites a group of scientists to visit the park, but following a major power outage, the visitors have to battle the animals and escape the island. A 35mm presentation in association with The Cinema Museum.\" />\n\t<meta property=\"og:url\" content=\"https://www.davidleancinema.org.uk/event/jurassic-park/\" />\n\t<meta property=\"og:site_name\" content=\"David Lean Cinema\" />\n\t<meta property=\"article:publisher\" content=\"https://www.facebook.com/LeanCampaign/\" />\n\t<meta property=\"article:modified_time\" content=\"2026-09-27T09:15:35+00:00\" />\n\t<meta property=\"og:image\" content=\"https://dreamabstract.davidleancinema.uk/wp-content/uploads/2026/09/Jurassic-Park-1993-still-1.jpg\" />\n\t<meta property=\"og:image:width\" content=\"1920\" />\n\t<meta property=\"