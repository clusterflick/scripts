28859681/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173687750/events/428859681.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173687717\">\n        <name>\n          <![CDATA[MINIONS & MONSTERS]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font size=\"5\"><b>Minions &amp; Monsters&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/0enf56xjofg5s60ulrmd71dxprg5/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Animation</font></div><div><font size=\"3\">USA/UK | 2026 | 120 mins</font></div><div><font size=\"3\">Director:&nbsp;Pierre Coffin</font></div><div><font size=\"3\">Stars:&nbsp;Zoey Deutch, Allison Janney, Bobby Moynihan, Jesse Eisenberg, Jeff Bridges</font></div><div><font style=\"background-color:rgb(255, 255, 0);\" size=\"2\"><b>Screened in collaboration with Croydon Family Hubs, all tickets are &pound;6</b></font></div><div><p><font size=\"3\">In 1920s Hollywood, Minions are enjoying wild success as\nsilent movie stars - until the &lsquo;talkies&rsquo; arrive. James and Henry decide to make\ntheir own movie and summon fearsome monsters from a mysterious spellbook to\nplay the villains. Lovecraftian creature Goomi leads them on a quest to find\nthe ultimate monster, but when things go haywire, all Minions must band\ntogether to save the world. Look out for silent film star cameos and an\nall-star voice cast in this hugely enjoyable prequel to Minions (2015) and Minions:\nThe Rise of Gru (2022).</font></p></div>]]>\n        </description>\n        <event_category>Animated Film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173687717/events</url>\n        <version>23</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/5l538udzd5no6jndim9s873xausu/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/5l538udzd5no6jndim9s873xausu/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/5l538udzd5no6jndim9s873xausu/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/0enf56xjofg5s60ulrmd71dxprg5/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/0enf56xjofg5s60ulrmd71dxprg5/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/0enf56xjofg5s60ulrmd71dxprg5/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=V-O-uBaHk3c&amp;t=1s</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428859589\">\n            <name>\n              <![CDATA[13 Aug 2026 - 14:00 @ David Lean Cinema - (opening time 13:15) MINIONS & MONSTERS]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-13T14:00:00+01:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-13T13:15:00+01:00</opening_time_iso>\n            <event_number>428859589</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173687717/events/428859589/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173687717/events/428859589.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173687745\">\n        <name>\n          <![CDATA[NINO]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font size=\"5\"><b>Nino&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/owof4zpxw3xmuxv6jozujcgkeph3/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Drama</font></div><div><font size=\"3\">France | 2025 | 97 mins (French with <b>English Subtitles</b>)</font></div><div><font size=\"3\">Director:&nbsp;Pauline Loqu&egrave;s</font></div><div><font size=\"3\">Stars:&nbsp;Th&eacute;odore Pellerin, William Lebghil, Salom&eacute;\nDewaels</font></div><div>\n<b><i style=\"background-color:rgb(255, 255, 0);\">NINO contains a sequence of flashing lights, \nwhich might affect viewers with photosensitive epilepsy.</i></b><font size=\"3\"></font>\n</div><div><p><font size=\"3\">One Friday in Paris, his 29th birthday, <b><i>Nino</i></b>\nreceives an unexpected cancer diagnosis. With chemotherapy due to start on\nMonday, he is given the delicate task of producing a sperm sample in case the\ntreatment leaves him infertile. This incredibly moving and often funny French\ndrama sees <b><i>Nino</i></b> spend the weekend adrift in Paris, attempting to\nreconnect with others and stumbling over the words to share his shocking news.\nTh&eacute;odore Pellerin&apos;s tender performance won prizes at both Cannes and the C&eacute;sars\nin this promising debut feature.</font></p></div>]]>\n        </description>\n        <event_category></event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173687745/events</url>\n        <version>28</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/lxytb6qqwx3whwfn5g7ad52friaw/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/lxytb6qqwx3whwfn5g7ad52friaw/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/lxytb6qqwx3whwfn5g7ad52friaw/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/owof4zpxw3xmuxv6jozujcgkeph3/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/owof4zpxw3xmuxv6jozujcgkeph3/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/owof4zpxw3xmuxv6jozujcgkeph3/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=wGGFce0vQoc</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428859671\">\n            <name>\n              <![CDATA[18 Aug 2026 - 14:30 @ David Lean Cinema - (opening time 13:45) NINO]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-18T14:30:00+01:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-18T13:45:00+01:00</opening_time_iso>\n            <event_number>428859671</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173687745/events/428859671/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173687745/events/428859671.xml</url>\n            </feed>\n          </event>\n          <event id=\"428859670\">\n            <name>\n              <![CDATA[19 Aug 2026 - 19:30 @ David Lean Cinema - (opening time 18:45) NINO]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-19T19:30:00+01:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-19T18:45:00+01:00</opening_time_iso>\n            <event_number>428859670</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173687745/events/428859670/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173687745/events/428859670.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173687715\">\n        <name>\n          <![CDATA[NT LIVE: LES LIAISONS DANGEREUSES]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font size=\"5\"><b>NT Live: Les Liaisons Dangereuses&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/bij2upjgkqrqjou9lifru2y2g5fk/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre: Theatrical Performance</font></div><div><font size=\"3\">UK | 2026 | 180 mins</font></div><div><font size=\"3\">Director:&nbsp;Marianne Elliott</font></div><div><font size=\"3\">Stars:&nbsp;Lesley Manville, Aidan Turner, Monica Barbaro</font></div><div>\n<p><font size=\"3\">BAFTA Award-winner Lesley Manville (Phantom Thread) joins\nAidan Turner (Rivals) in a striking new staging of Christopher Hampton&rsquo;s\ncelebrated adaptation of the classic novel, where among the glittering salons\nof the super-rich, one misstep can mean ruin.&nbsp; Marquise de Merteuil is a\nmaster in the art of survival. Alongside the magnetic Vicomte de Valmont, they\nturn seduction into strategy and weaponise desire. But when their alliance\ncollapses into rivalry, the battle between them threatens to destroy everyone\nin their path. Filmed live on stage at the National Theatre, Marianne Elliott (Angels\nin America) directs this thrilling game of love, lies, and social warfare.</font></p>\n<p><font size=\"2\"><b style=\"background-color:rgb(255, 255, 0);\">There will be a 15 minute interval at the end of act 1. Our Arts Bar will reopen to allow customers to purchase drinks and snacks to take into the cinema.</b></font></p>\n</div>]]>\n        </description>\n        <event_category>performance</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173687715/events</url>\n        <version>20</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/j3pqqiupfm0z2divgcpkm1drhfjc/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/j3pqqiupfm0z2divgcpkm1drhfjc/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/j3pqqiupfm0z2divgcpkm1drhfjc/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/bij2upjgkqrqjou9lifru2y2g5fk/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/bij2upjgkqrqjou9lifru2y2g5fk/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/bij2upjgkqrqjou9lifru2y2g5fk/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=wq5l5VV51sU</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428859586\">\n            <name>\n              <![CDATA[12 Aug 2026 - 18:30 @ David Lean Cinema - (opening time 17:45) NT LIVE: LES LIAISONS DANGEREUSES]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-12T18:30:00+01:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-12T17:45:00+01:00</opening_time_iso>\n            <event_number>428859586</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[There will be a 15 minute interval at the end of the first act. Our Arts Bar will reopen to serve drinks and refreshments that you can take into the cinema.]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173687715/events/428859586/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173687715/events/428859586.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173687539\">\n        <name>\n          <![CDATA[SAVAGE HOUSE]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font size=\"5\"><b>Savage House&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/niuopchqfp2wengy6j5lbnizessr/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Comedy/Drama</font></div><div><font size=\"3\">UK | 2025 | 114 mins</font></div><div><font size=\"3\">Director: Peter Glanz</font></div><div><font size=\"3\">Stars: Richard E Grant, Claire Foy, Jack Farthing, Bel Powley</font></div><div><b style=\"font-family:inherit;font-size:small;\"><i>Our 2:30pm screening includes Descriptive subtitles for those with hearing difficulties.</i></b></div><div><p><font size=\"3\">England,\n1740. Lady Vane and Lord Ashwick will do anything to claw their way to the top\nof society - lie, scheme, blackmail, and butcher their way through polite\ncompany if they must. Claire Foy and Richard E. Grant star in this deliciously\nvicious period romp, where corsets are tight, morals are loose, and the body\ncount keeps rising. Sharp-tongued, blood-splattered, and wickedly funny, <b><i>Savage\nHouse </i></b>skewers the brutal absurdity of class obsession with gleeful,\nunapologetic savagery.</font></p></div>]]>\n        </description>\n        <event_category></event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173687539/events</url>\n        <version>35</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/zbumr6u975q7tokoagfb90qf8mv4/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/zbumr6u975q7tokoagfb90qf8mv4/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/zbumr6u975q7tokoagfb90qf8mv4/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/niuopchqfp2wengy6j5lbnizessr/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/niuopchqfp2wengy6j5lbnizessr/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/niuopchqfp2wengy6j5lbnizessr/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=4VIIZlzqdKE</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428859581\">\n            <name>\n              <![CDATA[06 Aug 2026 - 14:30 @ David Lean Cinema - (opening time 13:45) SAVAGE HOUSE]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-06T14:30:00+01:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-06T13:45:00+01:00</opening_time_iso>\n            <event_number>428859581</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute>HoH Subtitled</event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173687539/events/428859581/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173687539/events/428859581.xml</url>\n            </feed>\n          </event>\n          <event id=\"428859582\">\n            <name>\n              <![CDATA[06 Aug 2026 - 19:30 @ David Lean Cinema - (opening time 18:45) SAVAGE HOUSE]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-06T19:30:00+01:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"IST\">2026-08-06T18:45:00+01:00</opening_time_iso>\n            <event_number>428859582</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173687539/events/428859582/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173687539/events/428859582.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173687567\">\n        <name>\n          <![CDATA[STAND BY ME]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font size=\"5\"><b>Stand By Me&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/u0sg1iy73h1lybjsmigndr789vq1/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Adventure| Comedy | Drama</font></div><div><font size=\"3\">USA 1986 | 88 mins</font></div><div><font size=\"3\">Director: Rob Reiner</font></div><div><font size=\"3\">Stars:&nbsp;Wil Wheaton, River Phoenix, Corey Feldman, Jerry O&apos;Connell, Kiefer Sutherland.</font></div><div><font size=\"3\"><br></font></div><div><font size=\"2\"><b><i>Our 2pm screening will be followed by a post-film discussion hosted by the U3A film club. Everyone is welcome to stay and join in.</i></b></font></div><div><p><font size=\"3\">The late Rob Reiner directed this version of\nStephen King&rsquo;s novella The Body to great critical and popular acclaim. A writer\n(played by Richard Dreyfuss) looks back to the time when he and three friends\nset out on a journey to find the body of a missing boy. The friends hope\nfinding the body will make them heroes, but instead their friendship is\nstrengthened. The film pays tribute to the icons and beliefs of the fifties,\nbut still remains well-observed without falling to over-used nostalgia. &ldquo;A masterclass\nin directing, storytelling and acting&rdquo; (</font><a href=\"https://www.theguardian.com/film/2026/apr/08/stand-by-me-review-40th-anniversary-rob-reiner-river-phoenix-corey-feldman-wil-wheaton-stephen-king\"><font size=\"3\">The Guardian</font></a><font size=\"3\">).<em></em></font></p></div><div><br></div>]]>\n        </description>\n        <event_category></event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173687567/events</url>\n        <version>37</version>\n        <tags>\n        </tag