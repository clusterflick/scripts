vid Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173693776/events/428897778/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173693776/events/428897778.xml</url>\n            </feed>\n          </event>\n          <event id=\"428897779\">\n            <name>\n              <![CDATA[26 Nov 2026 - 19:30 @ David Lean Cinema - (opening time 18:45) KLARA AND THE SUN]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-26T19:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-26T18:45:00+00:00</opening_time_iso>\n            <event_number>428897779</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173693776/events/428897779/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173693776/events/428897779.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173680620\">\n        <name>\n          <![CDATA[MICHAEL]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font size=\"5\"><b>Michael&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/ur885z4bhvy01fbe0hg38khrdq55/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genres: Biography | Drama | Music</font></div><div><font size=\"3\">2025 | USA | 127 mins&nbsp;</font></div><div><font size=\"3\">Director:&nbsp;Antoine Fuqua</font></div><div><font size=\"3\">Cast:&nbsp;Jaafar Jackson, Juliano Valdi, Colman Domingo, Jayden Harville</font></div><div>\n<p><font size=\"3\">Tracing the early life and meteoric\nrise of one of the most influential artists of the 20th century,&nbsp;<b><i>Michael</i></b>&nbsp;charts\nthe journey of Michael Jackson from his beginnings as the precociously talented\nlead singer of the Jackson 5 to his emergence as a global superstar during the\nera of his landmark&nbsp;Bad&nbsp;tour. Portrayed by his nephew Jaafar Jackson,\nthe film explores the ambition, creativity and pressures that shaped his\nascent. Blending intimate moments with recreations of iconic performances, it\noffers a portrait of the artist behind the phenomenon &mdash; capturing both the\nbrilliance and the drive that defined his early career.</font></p>\n<p><b><i><font color=\"#000000\" style=\"background-color:rgb(255, 255, 0);\">Black History Month\nscreening in conjunction with Croydon Black History Partnership.</font></i></b></p>\n</div>]]>\n        </description>\n        <event_category>film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://www.davidleancinema.uk/#whatson</url>\n        <version>122</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/r2jsen06czo9zgbam5fjisrxx6x2/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/r2jsen06czo9zgbam5fjisrxx6x2/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/r2jsen06czo9zgbam5fjisrxx6x2/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <