ments-1 is-nowrap is-layout-flex wp-container-core-group-is-layout-36730ca6 wp-block-group-is-layout-flex\" style=\"font-size:clamp(0.929rem, 0.929rem + ((1vw - 0.2rem) * 0.856), 1.4rem);font-style:normal;font-weight:600;text-transform:none\">\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-2 wp-block-paragraph\">1958</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-3 wp-block-paragraph\">|</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-4 wp-block-paragraph\" style=\"text-transform:uppercase\">UK</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-5 wp-block-paragraph\">|</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-6 wp-block-paragraph\">83 mins</p>\n</div>\n\n\n\n<div class=\"wp-block-group event-date has-white-color has-text-color has-link-color wp-elements-7 is-nowrap is-layout-flex wp-container-core-group-is-layout-36730ca6 wp-block-group-is-layout-flex\" style=\"font-size:clamp(0.929rem, 0.929rem + ((1vw - 0.2rem) * 0.856), 1.4rem);font-style:normal;font-weight:600;text-transform:none\">\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-8 wp-block-paragraph\">Saturday 31 October</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-9 wp-block-paragraph\">at</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-10 wp-block-paragraph\">6:00pm</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-4a5f3f6b wp-block-group-is-layout-flex\" style=\"border-style:none;border-width:0px;margin-top:var(--wp--preset--spacing--20);margin-bottom:var(--wp--preset--spacing--20);padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\"></div>\n\n\n\n<div class=\"wp-block-group director-block is-nowrap is-layout-flex wp-container-core-group-is-layout-3e93bdf3 wp-block-group-is-layout-flex\" style=\"margin-top:0;margin-bottom:0;font-style:normal;font-weight:500\">\n<p class=\"wp-block-paragraph\" style=\"font-style:normal;font-weight:600\">Directed by: Terence Fisher</p>\n</div>\n\n\n\n<div class=\"wp-block-group stars-block is-nowrap is-layout-flex wp-container-core-group-is-layout-04822461 wp-block-group-is-layout-flex\">\n<p class=\"inline-para wp-block-paragraph\" style=\"font-style:normal;font-weight:600\">Stars: Peter Cushing, Christopher Lee, Michael Gough</p>\n</div>\n\n\n<div style=\"padding-right:0px;padding-left:0px;margin-top:15px\" class=\"entry-content alignfull wp-block-post-content has-global-padding is-layout-constrained wp-container-core-post-content-is-layout-e5d1e14d wp-block-post-content-is-layout-constrained\">\n<p class=\"wp-block-paragraph\">A landmark in English Gothic horror,&nbsp;<strong><em>Dracula</em></strong>&nbsp;made Christopher Lee an international star, and caused major American distributors to compete to release Hammer’s films. Elegant but shocking, this first colour adaptation of Bram Stoker’s novel offered Lee’s physicality and seductive menace, opposite Peter Cushing’s fearless Van Helsing. Now, following the discovery of film elements in a Warner Bros. warehouse, a brand new restoration brings the original uncut version (previously only seen in Japan in 1958) to UK cinemas for the first time! Halloween screening, with support from Croydon Council.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Plus a short (10 mins) exploring the film’s restoration.</strong></p>\n\n\n\n<p class=\"wp-block-paragraph\"><em><strong>SPECIAL OFFER:</strong></em> <strong>Save £2 by booking both Halloween Dracula films at the same time. Ensure that both have been added to your basket before checking out.</strong></p>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n</div>\n\n\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"margin-top:var(--wp--preset--spacing--30);margin-bottom:var(--wp--preset--spacing--30)\"><div class=\"ticket-buttons\"><a href=\"https://davidleancinema.ticketsolve.com/ticketbooth/shows/1173692836/events/428890967/seats?zone=David%20Lean%20Cinema\" class=\"ticket-button\" target=\"_blank\" rel=\"noopener noreferrer\">BOOK NOW 6:00pm</a></div>\n</div>\n\n\n\n<div class=\"wp-block-group trailer-block has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"margin-top:15px\"><div class=\"youtube-responsive-wrapper\">\n        <iframe\n            src=\"https://www.youtube.com/embed/1TaWGqgxmSU\"\n            title=\"YouTube video player\"\n            frameborder=\"0\"\n\t\t\treferrerpolicy=\"strict-origin-when-cross-origin\"\n            allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n            allowfullscreen><br />\n        </iframe>\n    </div>\n</div>\n</div></div></div>\n\n\n\n<div class=\"wp-block-stackable-column stk-block-column stk-column stk-block stk-3513d07\" data-v=\"4\" data-block-id=\"3513d07\"><style>@media screen and (min-width: 768px){.stk-3513d07 {flex:var(--stk-flex-grow, 1) 1 33.3% !important;}}@media screen and (max-width: 1023px){.stk-3513d07 {padding-top:30px !important;}}</style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-3513d07-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-3513d07-inner-blocks\">\n<p class=\"has-text-align-right has-roboto-condensed-font-family wp-block-paragraph\" style=\"font-style:normal;font-weight:700\">BACK TO: <a href=\"https://www.davidleancinema.org.uk/\" data-type=\"page\" data-id=\"7\">WHAT&#8217;S ON</a></p>\n\n\n\n<div class=\"wp-block-group event-poster-image has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"margin-bottom:15px\">\n<div class=\"wp-block-stackable-image stk-block-image stk-block stk-027db97\" data-block-id=\"027db97\"><figure><span class=\"