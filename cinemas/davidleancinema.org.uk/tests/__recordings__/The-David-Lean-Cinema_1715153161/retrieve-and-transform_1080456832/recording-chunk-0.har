escription>\n          <![CDATA[<div>\n<font size=\"5\"><b>Backrooms&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/pdr0ynh87jfe2c37ur05wmimxjrw/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Horror/Sc-Fi</font></div><div><font size=\"3\">USA | 2026 | 105 mins</font></div><div><font size=\"3\">Director:&nbsp;Kane Parsons</font></div><div><font size=\"3\">Cast:&nbsp;Chiwetel Ejiofor, Renate Reinsve, Mark Duplass.</font></div><div><p><font size=\"3\">Clark, a furniture showroom\nowner discovers a mysterious doorway in his basement leading to the Backrooms &mdash;\nan endless maze of empty, eerie rooms. Drawn into the strange alternate\ndimension, he becomes increasingly obsessed, returning night after night to\nexplore its depths. When Clark\nconfides in his therapist, Dr Mary Kline, she struggles to believe his claims.\nBut after Clark disappears while attempting to document the Backrooms with\nfriends, Dr Kline is forced to venture into the unsettling labyrinth herself in\nsearch of her missing patient.</font></p></div><div><br></div>]]>\n        </description>\n        <event_category>film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173681152/events</url>\n        <version>54</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/sqquv9lv1u955y6gur5uijfv9zxf/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/sqquv9lv1u955y6gur5uijfv9zxf/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/sqquv9lv1u955y6gur5uijfv9zxf/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/pdr0ynh87jfe2c37ur05wmimxjrw/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/pdr0ynh87jfe2c37ur05wmimxjrw/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/pdr0ynh87jfe2c37ur05wmimxjrw/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=2z6a6NUFlsU</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428839330\">\n            <name>\n              <![CDATA[21 Jul 2026 - 19:30 @ David Lean Cinema - (opening time 18:45) BACKROOMS]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"IST\">2026-07-21T19:30:00+01:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"IST\">2026-07-21T18:45:00+01:00</opening_time_iso>\n            <event_number>428839330</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173681152/events/428839330/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173681152/events/428839330.xml</url>\n            </feed>\n          </event>\n          <event id=\"428839335\">\n            <name>\n              <![CDATA[25 Jul 2026 - 14:00 @ David Lean Cinema - (opening time 13:15) BACKROOMS]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"IST\">2026-07-25T14:00:00+01:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"IST\">2026-07-25T13:15:00+01:00</opening_time_iso>\n            <event_number>428839335</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173681152/events/428839335/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173681152/events/428839335.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173681150\">\n        <name>\n          <![CDATA[BLUE HERON]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font size=\"5\"><b>Blue Heron&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/qra2r7zd8gu9gy904rbarbes4aax/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\"><font size=\"5\"><b>&nbsp;</b></font>\n</div><div><font size=\"3\">Genre(s): Drama</font></div><div><font size=\"3\">Canada/Hungary | 2025 | 90 mins</font></div><div><font size=\"3\">Director:&nbsp;Sophy Romvari</font></div><div><font size=\"3\">Cast:&nbsp;<font>Eylul Guven,&nbsp;<span style=\"color:rgb(0, 0, 0);background-color:rgb(248, 249, 250);\">Amy Zimmer,&nbsp;</span><span style=\"color:rgb(0, 0, 0);background-color:rgb(248, 249, 250);\">&Aacute;d&aacute;m Tompa, Edik Beddoes.</span></font></font></div><div><p><font size=\"3\">Set in the late 1990s, this\nsemi-autobiographical drama follows eight-year-old Sasha&nbsp;and her Hungarian\nimmigrant family after they relocate to Vancouver Island. As the family settles\ninto their new life, Sasha becomes increasingly aware of her older brother\nJeremy&rsquo;s troubling and unpredictable behaviour, which begins to place growing\nstrain on the household. Unnamed and played by Iring&oacute; R&eacute;ti and &Aacute;d&aacute;m Tompa,\nJeremy and Sasha&rsquo;s parents face every new development with Jeremy with love and\nconcern, but there&rsquo;s only so much they can do.&nbsp;</font></p></div><div><font size=\"3\"><font><span style=\"color:rgb(0, 0, 0);background-color:rgb(248, 249, 250);\"><br></span></font></font></div><div><font size=\"3\"><font><span style=\"color:rgb(0, 0, 0);background-color:rgb(248, 249, 250);\"><br></span></font></font></div>]]>\n        </description>\n        <event_category>film</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173681150/events</url>\n        <version>57</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/4626b1bor4tnqcu061h5tmcogelj/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/4626b1bor4tnqcu061h5tmcogelj/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/4626b1bor4tnqcu061h5tmcogelj/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/qra2r7zd8gu9gy904rbarbes4aax/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8