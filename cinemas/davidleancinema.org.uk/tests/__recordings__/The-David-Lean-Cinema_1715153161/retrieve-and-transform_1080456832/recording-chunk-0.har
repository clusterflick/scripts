ex-grow, 1) 1 66.7% !important;}}</style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-a6fa1f5-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-a6fa1f5-inner-blocks\">\n<div class=\"wp-block-group event-title is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-84d39786 wp-block-group-is-layout-flex\"><h1 style=\"font-style:normal;font-weight:600\" class=\"wp-block-post-title has-xx-large-font-size\">Bitter Christmas</h1>\n\n<p><img src=\"https://www.davidleancinema.org.uk/wp-content/themes/davidleancinema/img/15-icon.svg\" alt=\"15 certificate\" class=\"age-rating-icon\"></p>\n</div>\n\n\n\n<div class=\"wp-block-group event-meta has-white-color has-text-color has-link-color wp-elements-1 is-nowrap is-layout-flex wp-container-core-group-is-layout-36730ca6 wp-block-group-is-layout-flex\" style=\"font-size:clamp(0.929rem, 0.929rem + ((1vw - 0.2rem) * 0.856), 1.4rem);font-style:normal;font-weight:600;text-transform:none\">\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-2 wp-block-paragraph\">2026</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-3 wp-block-paragraph\">|</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-4 wp-block-paragraph\" style=\"text-transform:uppercase\">Spain</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-5 wp-block-paragraph\">|</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-6 wp-block-paragraph\">112 mins</p>\n</div>\n\n\n\n<div class=\"wp-block-group event-date has-white-color has-text-color has-link-color wp-elements-7 is-nowrap is-layout-flex wp-container-core-group-is-layout-36730ca6 wp-block-group-is-layout-flex\" style=\"font-size:clamp(0.929rem, 0.929rem + ((1vw - 0.2rem) * 0.856), 1.4rem);font-style:normal;font-weight:600;text-transform:none\">\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-8 wp-block-paragraph\">Thursday 15 October</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-9 wp-block-paragraph\">at</p>\n\n\n\n<p class=\"has-navy-color has-text-color has-link-color wp-elements-10 wp-block-paragraph\">2.30 &amp; 7.30pm</p>\n</div>\n\n\n\n<div class=\"wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-4a5f3f6b wp-block-group-is-layout-flex\" style=\"border-style:none;border-width:0px;margin-top:var(--wp--preset--spacing--20);margin-bottom:var(--wp--preset--spacing--20);padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\"><div style=\"line-height:1;text-transform:uppercase;padding-top:0px;padding-bottom:0px;padding-left:0px;padding-right:0px\" class=\"taxonomy-event-category wp-block-post-terms\">*Subtitled</div></div>\n\n\n\n<div class=\"wp-block-group director-block is-nowrap is-layout-flex wp-container-core-group-is-layout-3e93bdf3 wp-block-group-is-layout-flex\" style=\"margin-top:0;margin-bottom:0;font-style:normal;font-weight:500\">\n<p class=\"wp-block-paragraph\" style=\"font-style:normal;font-weight:600\">Directed by: Pedro Almodóvar</p>\n</div>\n\n\n\n<div class=\"wp-block-group stars-block is-nowrap is-layout-flex wp-container-core-group-is-layout-04822461 wp-block-group-is-layout-flex\">\n<p class=\"inline-para wp-block-paragraph\" style=\"font-style:normal;font-weight:600\">Stars: Bárbara Lennie, Leonardo Sbaraglia, Aitana Sánchez-Gijón</p>\n</div>\n\n\n<div style=\"padding-right:0px;padding-left:0px;margin-top:15px\" class=\"entry-content alignfull wp-block-post-content has-global-padding is-layout-constrained wp-container-core-post-content-is-layout-e5d1e14d wp-block-post-content-is-layout-constrained\">\n<p class=\"wp-block-paragraph\">* In Spanish with English Subtitles</p>\n\n\n\n<p class=\"wp-block-paragraph\">From acclaimed Spanish director Pedro Almodóvar comes <strong><em>Bitter Christmas</em></strong>. This witty and bittersweet comedy-drama intertwines the stories of Raúl and Elsa: Raúl is a filmmaker, writing his next screenplay; Elsa is his imaginary alter ego. As Raúl struggles with writer’s block, he shamelessly mines the lives of the people closest to him, blurring the boundaries between art and reality. Almodóvar’s vibrant visual style and trademark wit create a playful, provocative portrait of love, creativity and the stories we steal to tell our own.</p>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n</div>\n\n\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"margin-top:var(--wp--preset--spacing--30);margin-bottom:var(--wp--preset--spacing--30)\"><div class=\"ticket-buttons\"><a href=\"https://davidleancinema.ticketsolve.com/ticketbooth/shows/1173692750/events/428890590/seats?zone=David%20Lean%20Cinema\" class=\"ticket-button\" target=\"_blank\" rel=\"noopener noreferrer\">BOOK NOW 2:30pm</a><a href=\"https://davidleancinema.ticketsolve.com/ticketbooth/shows/1173692750/events/428890591/seats?zone=David%20Lean%20Cinema\" class=\"ticket-button\" target=\"_blank\" rel=\"noopener noreferrer\">BOOK NOW 7:30pm</a></div>\n</div>\n\n\n\n<div class=\"wp-block-group trailer-block has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"margin-top:15px\"><div class=\"youtube-responsive-wrapper\">\n        <iframe\n            src=\"https://www.youtube.com/embed/NUvdMKtFXBw\"\n            title=\"YouTube video player\"\n            frameborder=\"0\"\n\t\t\treferrerpolicy=\"strict-origin-when-cross-origin\"\n            allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n            allowfullscreen><br />\n        </iframe>\n    </div>\n</div>\n</div></div></div>\n\n\n\n<div class=\"wp-block-stackable-column stk-block-column stk-column stk-block stk-3513d07\" data-v=\"4\" data-block-id=\"3513d07\"><style>@media screen and (min-width: 7