lve.com/shows/1173687384/events/428859578/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173687384/events/428859578.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173681149\">\n        <name>\n          <![CDATA[EOS: FRIDA KAHLO 2026]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<b><font size=\"5\">Exhibition On Screen: Frida Kahlo 2026 Encore&nbsp;</font></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/1576t31ukutn5ft9wm494orwv6uh/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Documentary&nbsp;</font></div><div><font size=\"3\">UK | 2026 | 90 mins</font></div><div><font size=\"3\">Director: Ali Ray</font></div><div><b><i style=\"background-color:rgb(255, 255, 0);\">Our 2:30pm screening includes descriptive subtitles for those with hearing loss.</i></b></div><div><b><i><br></i></b></div><div><font size=\"3\"><b><i>Exhibition on Screen</i></b> returns to the DLC with a celebration of the\nlife and work of surrealist icon Frida Kahlo. You may recognise her work, or\neven just her legendary eyebrows, but how much do you really know about\nMexico&rsquo;s most famous artist? Taking in some of her key works, unseen treasures\nfrom her archives and insights from curators and experts, understand Frida\nKahlo better than you ever thought possible. Don&rsquo;t miss this encore\npresentation with brand new material, in anticipation of a new retrospective of\nher work at the Tate Modern this year.</font></div><div><br></div>]]>\n        </description>\n        <event_category>documentary</event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://davidleancinema.ticketsolve.com/shows/1173681149/events</url>\n        <version>54</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/x8qgra3yle28b9vtdqn2z2ejjej5/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/x8qgra3yle28b9vtdqn2z2ejjej5/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/x8qgra3yle28b9vtdqn2z2ejjej5/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/1576t31ukutn5ft9wm494orwv6uh/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/1576t31ukutn5ft9wm494orwv6uh/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/1576t31ukutn5ft9wm494orwv6uh/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n        </images>\n        <properties>\n          <property>\n            <name>Trailer</name>\n            <value>https://www.youtube.com/watch?v=UUaTrnO1Ww8</value>\n          </property>\n        </properties>\n        <events>\n          <event id=\"428839324\">\n            <name>\n              <![CDATA[14 Jul 2026 - 14:30 @ David Lean Cinema - (opening time 13:45) EOS: FRIDA KAHLO 2026]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"IST\">2026-07-14T14:30:00+01:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"IST\">2026-07-14T13:45:00+01:00</o