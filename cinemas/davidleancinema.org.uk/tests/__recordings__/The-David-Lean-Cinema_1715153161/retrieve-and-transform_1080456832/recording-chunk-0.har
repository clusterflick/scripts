/images>\n        <properties>\n        </properties>\n        <events>\n          <event id=\"428897765\">\n            <name>\n              <![CDATA[13 Nov 2026 - 11:00 @ David Lean Cinema - (opening time 10:15) BAD APPLES (Babes-In-Arms)]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-13T11:00:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-13T10:15:00+00:00</opening_time_iso>\n            <event_number>428897765</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[Our Babes-in-Arms screenings are relaxed events allowing parents of babies 12 months & under to watch a great movie without having to worry about what other customers think. We have space to securely park your buggies  and our Arts Bar is also open for refreshments you can take inside with you.]]>\n            </comment>\n            <event_attribute>BiAs</event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173693769/events/428897765/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173693769/events/428897765.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173692750\">\n        <name>\n          <![CDATA[BITTER CHRISTMAS]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<font size=\"5\"><b>Bitter Christmas&nbsp;</b></font><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/p5t6n07mj3vtk0i7srz7qerby5tc/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Comedy/Drama</font></div><div><font size=\"3\">Spain | 2025 | 111 mins (Spanish with <b>English Subtitles</b>)</font></div><div><font size=\"3\">Director: Pedro&nbsp;Almod&oacute;var</font></div><div><font size=\"3\">Stars:&nbsp;B&aacute;rbara Lennie, Leonardo Sbaraglia, Aitana S&aacute;nchez-Gij&oacute;n</font></div><div><p><font size=\"3\">From acclaimed Spanish director Pedro Almod&oacute;var comes <b><i>Bitter\nChristmas.</i></b> This witty and bittersweet comedy-drama intertwines the\nstories of Ra&uacute;l and Elsa: Ra&uacute;l is a filmmaker, writing his next screenplay;\nElsa is his imaginary alter ego. As Ra&uacute;l struggles with writer&rsquo;s block, he\nshamelessly mines the lives of the people closest to him, blurring the\nboundaries between art and reality. Almod&oacute;var&rsquo;s vibrant visual style and\ntrademark wit create a playful, provocative portrait of love, creativity and\nthe stories we steal to tell our own.</font></p></div>]]>\n        </description>\n        <event_category></event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://www.davidleancinema.uk/#whatson</url>\n        <version>57</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/h8a7k5lg3hd60fyshkfxs1el1twn/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/h8a7k5lg3hd60fyshkfxs1el1twn/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/h8a7k5lg3hd60fyshkfxs1el1twn/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/p5t6n07mj3vtk0i7srz7qerby5tc/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medi