            "mimeType": "application/xml; charset=utf-8",
            "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<venues>\n  <venue id=\"426566287\">\n    <name>\n      <![CDATA[David Lean Cinema]]>\n    </name>\n    <shows>\n      <show id=\"1173693770\">\n        <name>\n          <![CDATA[1 IN 2]]>\n        </name>\n        <description>\n          <![CDATA[]]>\n        </description>\n        <event_category></event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://www.davidleancinema.uk/#whatson</url>\n        <version>14</version>\n        <tags>\n        </tags>\n        <images>\n        </images>\n        <properties>\n        </properties>\n        <events>\n          <event id=\"428897766\">\n            <name>\n              <![CDATA[17 Nov 2026 - 14:30 @ David Lean Cinema - (opening time 13:45) 1 IN 2]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-17T14:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-17T13:45:00+00:00</opening_time_iso>\n            <event_number>428897766</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173693770/events/428897766/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173693770/events/428897766.xml</url>\n            </feed>\n          </event>\n          <event id=\"428897767\">\n            <name>\n              <![CDATA[17 Nov 2026 - 18:30 @ David Lean Cinema - (opening time 17:45) 1 IN 2]]>\n            </name>\n            <date_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-17T18:30:00+00:00</date_time_iso>\n            <opening_time_iso format=\"ISO 8601\" zone=\"GMT\">2026-11-17T17:45:00+00:00</opening_time_iso>\n            <event_number>428897767</event_number>\n            <venue_layout>David Lean Cinema</venue_layout>\n            <comment>\n              <![CDATA[]]>\n            </comment>\n            <event_attribute></event_attribute>\n            <url>https://davidleancinema.ticketsolve.com/shows/1173693770/events/428897767/seats</url>\n            <status>available</status>\n            <feed>\n              <url>https://davidleancinema.ticketsolve.com/shows/1173693770/events/428897767.xml</url>\n            </feed>\n          </event>\n        </events>\n        <status>available</status>\n      </show>\n      <show id=\"1173691031\">\n        <name>\n          <![CDATA[500 MILES]]>\n        </name>\n        <description>\n          <![CDATA[<div>\n<b><font size=\"5\">500 Miles&nbsp;</font></b><img src=\"https://d1bry8u3byci8.cloudfront.net/as-assets/variants/uj1ckbj97oh6rgohexwm12fxezvs/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd\" style=\"font-size:0.875rem;\">\n</div><div><font size=\"3\">Genre(s): Drama</font></div><div><font size=\"3\">UK/Ireland/Cyprus | 2026 | 112 mins</font></div><div><font size=\"3\">Director:&nbsp;Morgan Matthews</font></div><div><font size=\"3\">Stars:&nbsp;Lor&eacute; Adewusi, Dexter Sol Ansell, Eoin Duffy, Clare Dunne, Roman Griffin Davis, Deirdre Monaghan, Bill Nighy, David Ryan, Harleen Sahota, Michael Socha.</font></div><div><span style=\"font-family:inherit;font-size:medium;\"><b><i>The 2pm screening on Tuesday 2nd Sept includes descriptive subtitles for those with hearing loss and will be followed by a post-film discussion facilitated by the U3A film club. Everyone is welcome to stay and chat about the film.</i></b></span></div><div><span style=\"font-family:inherit;font-size:medium;\"><br></span></div><div><span style=\"font-family:inherit;font-size:medium;\">In this emotional and involving drama, Finn and his brother\nCharlie run away from their Yorkshire home to escape the turmoil of their\nfractured family life and avoid being separated from each other by their\ndivorcing parents. Carried along by their own quick wits and the kindness of\nstrangers, they head to the wild west coast of Ireland, the home of their\nbeloved but estranged grandfather. This life affirming road movie is cleverly\ninterwoven with flashbacks of joyful memories and features outstanding performances\nfrom a multi generational cast.&nbsp;</span></div>]]>\n        </description>\n        <event_category></event_category>\n        <production_company_name></production_company_name>\n        <priority>0</priority>\n        <url>https://www.davidleancinema.uk/#whatson</url>\n        <version>100</version>\n        <tags>\n        </tags>\n        <images>\n          <image priority=\"90\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/qqkkgak8ixjdh1voswcqgry3o9mp/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/qqkkgak8ixjdh1voswcqgry3o9mp/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/qqkkgak8ixjdh1voswcqgry3o9mp/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\n            <alt/>\n          </image>\n          <image priority=\"0\">\n            <url size=\"large\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/uj1ckbj97oh6rgohexwm12fxezvs/a6206d8b8848d1f5f779dd436f25589e3a792fee204effd13dccee565e881abd</url>\n            <url size=\"medium\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/uj1ckbj97oh6rgohexwm12fxezvs/6428308680a2820b32ca9af5ca523d295e68c5119095c3d9f4a769458f8227e4</url>\n            <url size=\"thumb\">https://d1bry8u3byci8.cloudfront.net/as-assets/variants/uj1ckbj97oh6rgohexwm12fxezvs/7c367cff06fd518c1ca8f9254efb0ec25a25cd43a892ea5364918efafd429189</url>\