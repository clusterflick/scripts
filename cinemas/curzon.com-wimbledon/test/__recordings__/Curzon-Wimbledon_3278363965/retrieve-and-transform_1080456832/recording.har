s\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"WIM01-85-HO00006204\"}],\"relatedData\":{\"sites\":[{\"id\":\"WIM01\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4204,\"longitude\":-0.2055},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006099\",\"title\":{\"text\":\"The Ballad of Wallis Island\",\"translations\":[]},\"synopsis\":{\"text\":\"Eccentric lottery winner Charles dreams of getting his favorite musicians, McGwyer Mortimer, back together. The fantasy becomes real when the bandmates and former lovers agree to play a private show at his home on Wallis Island. Old tensions resurface as Charles tries desperately to salvage his dream gig.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Eccentric lottery winner Charles dreams of getting his favorite musicians, McGwyer Mortimer, back together. \",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"moderate bad language\",\"translations\":[]},\"releaseDate\":\"2025-05-30\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=T9smxlnKNz0\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003501\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003970\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004380\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011120\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011121\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011122\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011123\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4c563f44-cfa4-4914-86b1-b510771045c8\",\"corporateId\":null},\"hopk\":\"HO00006099\",\"hoCode\":\"A000007519\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006101\",\"title\":{\"text\":\"The Salt Path\",\"translations\":[]},\"synopsis\":{\"text\":\"THE SALT PATH is the profound true story of husband and wife, Raynor and Moth Winn’s 630-mile trek along the beautiful but rugged Cornish, Devon and Dorset coastline. After being forcibly removed from their home, they make the desperate decision to walk in the hope that, in nature, they will find solace and a sense of acceptance. With depleted resources, only a tent and some essentials between them, every step along the path is a testament to their growing strength and determination. THE SALT PATH is a journey that is exhilarating, challenging, and liberating in equal measure. A portrayal of home, how it can be lost and rediscovered in the most unexpected ways.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE SALT PATH is the profound true story of husband and wife, Raynor and Moth Winn’s 630-mile trek along the beautiful but rugged Cornish, Devon and Dorset coastline. \",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate sex, drug misuse\",\"translations\":[]},\"releaseDate\":\"2025-05-30\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=UQ7RJCOm-c8\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001890\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001891\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002998\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004583\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011130\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011131\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011132\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011133\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011134\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011135\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011136\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011137\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011138\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011139\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b7f9da6c-7b33-44f6-8667-f9f496405624\",\"corporateId\":null},\"hopk\":\"HO00006101\",\"hoCode\":\"A000007521\",\"eventId\":null,\"distributorName\":\"Black Bear\"},{\"id\":\"HO00006204\",\"title\":{\"text\":\"28 Years Later\",\"translations\":[]},\"synopsis\":{\"text\":\"Academy Award®-winning director Danny Boyle and Academy Award®-nominated writer Alex Garland reunite for 28 Years Later, a terrifying new story set in the world created by 28 Days Later. It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine, some have found ways to exist amidst the infected. One such group of survivors lives on a small island connected to the mainland by a single, heavily-defended causeway. When one of the group leaves the island on a mission into the dark heart of the mainland, he discovers secrets, wonders, and horrors that have mutated not only the infected but other survivors as well.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine...\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-19\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=poEFz8Ivzug\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000313\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001100\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001270\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003206\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003678\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010558\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011257\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000011418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011419\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a7823fd3-66f7-47af-87ba-d36ef45b168c\",\"corporateId\":null},\"hopk\":\"HO00006204\",\"hoCode\":\"A000007660\",\"eventId\":null,\"distributorName\":\"Sony Pictures\"},{\"id\":\"HO00006211\",\"title\":{\"text\":\"From Hilde, With Love\",\"translations\":[]},\"synopsis\":{\"text\":\"Berlin, 1942. A shy Hilde falls in love with Hans and gradually finds her place in the \\nresistance group that would come to be known as the “Red Orchestra”. Together, \\nthey spend a beautiful summer where their relationship entwines with quiet acts \\nof defiance. But when the Gestapo arrests members of the group, Hilde and Hans \\nare among their numbers and must find the strength to confront their situation. \\nInspired by an incredible true story set against the backdrop of a country torn by \\nconflict, FROM HILDE, WITH LOVE is a powerful tale of love and resistance. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Inspired by an incredible true story set against the backdrop of a country torn by \\nconflict, FROM HILDE, WITH LOVE is a powerful tale of love and resistance. \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-27\",\"runtimeInMinutes\":125,\"trailerUrl\":null,\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007133\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008837\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011456\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011457\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011458\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011459\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011460\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011461\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b19e5bb9-996d-4ea7-b588-04b4f0aa48da\",\"corporateId\":null},\"hopk\":\"HO00006211\",\"hoCode\":\"A000007667\",\"eventId\":null,\"distributorName\":\"Picturehouse Entertainment\"},{\"id\":\"HO00006110\",\"title\":{\"text\":\"F1® The Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career. Thirty years later, he’s a nomadic racer-for-hire when he’s approached by his former teammate Ruben Cervantes (Javier Bardem), owner of a struggling FORMULA 1 team that is on the verge of collapse. Ruben convinces Sonny to come back to FORMULA 1 for one last shot at saving the team and being the best in the world. He’ll drive alongside Joshua Pearce (Damson Idris), the team's hotshot rookie intent on setting his own pace. But as the engines roar, Sonny’s past catches up with him and he finds that in FORMULA 1, your teammate is your fiercest competition—and the road to redemption is not something you can travel alone.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate threat\",\"translations\":[]},\"releaseDate\":\"2025-06-25\",\"runtimeInMinutes\":156,\"trailerUrl\":\"https://www.youtube.com/watch?v=TZGY2CWPXeU\",\"displayPriority\":1,\"cast