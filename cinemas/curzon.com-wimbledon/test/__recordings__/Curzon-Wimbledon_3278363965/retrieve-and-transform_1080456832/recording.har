            "text": "{\"name\":\"Wimbledon\",\"urlSegment\":\"wimbledon\",\"url\":\"/venues/wimbledon/\",\"nodeId\":1814,\"alias\":\"cinema\",\"createDate\":\"2024-08-13T14:58:55\\u002B01:00\",\"updateDate\":\"2025-06-24T08:25:48\\u002B01:00\",\"robotsNoIndex\":false,\"robotsNoFollow\":false,\"masterCanonicalUrl\":null,\"excludeCanonicalUrl\":false,\"seoImage\":null,\"metaKeywords\":\"\",\"metaDescription\":\"Find out what\\u0027s on at Curzon Cinema in Wimbledon. Check out the latest blockbuster movies, new Indie film releases and the best of world cinema out now.\",\"seoPageTitle\":\"Curzon Wimbledon Cinema Showtimes \\u0026 Film Listings\",\"oGType\":\"\",\"twitterCard\":\"\",\"seoUrl\":\"\",\"oGLocale\":\"\",\"excludeFromXmlSitemap\":false,\"excludeFromSiteSearch\":false,\"pageTitle\":\"Curzon Wimbledon Cinema Showtimes \\u0026 Film Listings\",\"hideTitle\":false,\"grid\":[],\"redirectDetailsElement\":{\"redirect\":false,\"permanent\":false},\"heroCarouselDetailsElement\":[{\"image\":{\"mobile\":\"/media/t5vjlgdo/wimbledon-bar2.jpg?width=393\\u0026height=169\\u0026v=1dbdd01fbb23e70\",\"tablet\":\"/media/t5vjlgdo/wimbledon-bar2.jpg?width=782\\u0026height=315\\u0026v=1dbdd01fbb23e70\",\"desktop\":\"/media/t5vjlgdo/wimbledon-bar2.jpg?width=1216\\u0026height=523\\u0026v=1dbdd01fbb23e70\",\"alt\":\"\"},\"textHeading\":\"Welcome to Curzon Wimbledon\"},{\"image\":{\"mobile\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=393\\u0026height=169\\u0026v=1dbe4e025633ef0\",\"tablet\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=782\\u0026height=315\\u0026v=1dbe4e025633ef0\",\"desktop\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=1216\\u0026height=523\\u0026v=1dbe4e025633ef0\",\"alt\":\"\"},\"textHeading\":\"Support Stonewall on your Curzon cinema visit\",\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/qdydgzxw/dips-web.jpg?width=393\\u0026height=169\\u0026v=1dbb9e5e6e5c9b0\",\"tablet\":\"/media/qdydgzxw/dips-web.jpg?width=782\\u0026height=315\\u0026v=1dbb9e5e6e5c9b0\",\"desktop\":\"/media/qdydgzxw/dips-web.jpg?width=1216\\u0026height=523\\u0026v=1dbb9e5e6e5c9b0\",\"alt\":\"\"},\"textHeading\":\"Food and Drink\",\"actionLink\":{\"name\":\"view Menu\",\"target\":\"_blank\",\"url\":\"/media/i3kpivuc/menu-4.pdf\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/yquptpik/ph-wimbledon.jpg?width=393\\u0026height=169\\u0026v=1dbdd022682a1d0\",\"tablet\":\"/media/yquptpik/ph-wimbledon.jpg?width=782\\u0026height=315\\u0026v=1dbdd022682a1d0\",\"desktop\":\"/media/yquptpik/ph-wimbledon.jpg?width=1216\\u0026height=523\\u0026v=1dbdd022682a1d0\",\"alt\":\"\"},\"textHeading\":\"HIRE THIS SPACE\",\"actionLink\":{\"name\":\"Contact us\",\"url\":\"/private-hire/#enquiry\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/0lphu1ob/wimbledon-carousel-3.jpg?width=393\\u0026height=169\\u0026v=1dbdd023746edf0\",\"tablet\":\"/media/0lphu1ob/wimbledon-carousel-3.jpg?width=782\\u0026height=315\\u0026v=1dbdd023746edf0\",\"desktop\":\"/media/0lphu1ob/wimbledon-carousel-3.jpg?width=1216\\u0026height=523\\u0026v=1dbdd023746edf0\",\"alt\":\"\"}},{\"image\":{\"mobile\":\"/media/ee5dtfks/wimbledon-carousel-4.jpg?width=393\\u0026height=169\\u0026v=1dbdd02465c78a0\",\"tablet\":\"/media/ee5dtfks/wimbledon-carousel-4.jpg?width=782\\u0026height=315\\u0026v=1dbdd02465c78a0\",\"desktop\":\"/media/ee5dtfks/wimbledon-carousel-4.jpg?width=1216\\u0026height=523\\u0026v=1dbdd02465c78a0\",\"alt\":\"\"}},{\"image\":{\"mobile\":\"/media/wyzprdna/wimbledon-bar.jpg?width=393\\u0026height=169\\u0026v=1dbdd025b4ce240\",\"tablet\":\"/media/wyzprdna/wimbledon-bar.jpg?width=782\\u0026height=315\\u0026v=1dbdd025b4ce240\",\"desktop\":\"/media/wyzprdna/wimbledon-bar.jpg?width=1216\\u0026height=523\\u0026v=1dbdd025b4ce240\",\"alt\":\"\"}}],\"cinemaLocationDetailsElement\":{\"venueCardImage\":{\"mobile\":\"/media/j4yki2lq/cinema-venues-_wimbledon.jpg?width=300\\u0026height=160\\u0026v=1db998a64af2ca0\",\"alt\":\"\"},\"addressLine1\":\"23 The Broadway\",\"city\":\"London\",\"postcode\":\"SW19 1RE\",\"nearestStationName\":\"Wimbledon\",\"nearestStationType\":\"underground\"},\"vistaCinema\":{\"key\":\"WIM01\",\"value\":\"Wimbledon\"},\"informationTabAccordions\":[{\"heading\":\"CINEMA INFORMATION\",\"body\":\"\\u003Cp\\u003ECurzon Wimbledon is a sumptuous, three-screen cinema that captures the wide-ranging tastes of the local community with its expansive film programme. The snug caf\\u00E9 and bar area handily serves a dual function: during the day, it is a quiet place to enjoy a coffee, and at night it transforms into a bustling hangout where you can sit back with a glass of wine.\\u003C/p\\u003E\"},{\"heading\":\"Opening times\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EMonday to Saturday:\\u003C/strong\\u003E The cinema opens 30 minutes before the first show\\u0027s programme begins and closes at midnight.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESunday:\\u003C/strong\\u003E Closes at 11.30pm.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cem\\u003EPlease be aware opening and closing times may be subject to change.\\u003C/em\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Screen info\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003ERed Screen\\u003Cbr\\u003E\\u003C/strong\\u003E103 seats, 2 wheelchair spaces\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EBlue Screen\\u003Cbr\\u003E\\u003C/strong\\u003E91 seats, 2 wheelchair spaces\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EGreen Screen\\u003Cbr\\u003E\\u003C/strong\\u003E71 seats, 2 wheelchair spaces\\u003C/p\\u003E\"},{\"heading\":\"Accessibility\",\"body\":\"\\u003Cp\\u003EAll screens are accessible by lift, each screen has two wheelchair spaces. There is a wheelchair-accessible bathroom.\\u003C/p\\u003E\"},{\"heading\":\"Food and Drink\",\"body\":\"\\u003Cp\\u003EOur drinks menu includes a wide selection of cocktails, wine, craft beer, soft drinks and hot drinks.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022https://www.curzon.com/media/i3kpivuc/menu-4.pdf\\u0022 target=\\u0022_blank\\u0022 title=\\u0022View Menu\\u0022\\u003EView the full menu here.\\u003C/a\\u003E\\u003C/span\\u003E\\u003C/p\\u003E\"},{\"heading\":\"HAPPY HOUR INFORMATION\",\"body\":\"\\u003Cp\\u003EAt this venue Happy Hour is 5pm to 10pm every day, 2 for \\u00A316 on all cocktails.\\u003C/p\\u003E\"},{\"heading\":\"Private hires\",\"body\":\"\\u003Cp\\u003EOur screens are available to rent for your private functions, email \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca href=\\u0022mailto:privatehires@curzon.com\\u0022 title=\\u0022Email private hires\\u0022\\u003Eprivatehires@curzon.com\\u003C/a\\u003E\\u003C/span\\u003E for more information.\\u003C/p\\u003E\\n\\u003Cp\\u003ETo find out more, visit our \\u003Ca href=\\u0022https://www.curzon.com/private-hire/wimbledon/\\u0022 title=\\u0022Wimbledon Private Hire Page\\u0022\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003EPrivate Hires page\\u003C/span\\u003E.\\u003C/a\\u003E\\u003C/p\\u003E\"}],\"informationTabDescription\":\"\",\"menuTabAccordions\":[{\"heading\":\"sharing plates\",\"body\":\"\\u003Ctable border=\\u00221\\u0022 style=\\u0022border-collapse: collapse; width: 100%; height: 72px;\\u0022\\u003E\\n\\u003Ctbody\\u003E\\n\\u003Ctr style=\\u0022height: 18px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18px;\\u0022\\u003ENocellara Olives (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18px; text-align: right;\\u0022\\u003E\\u00A34.75\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18px;\\u0022\\u003EGuacamole \\u0026amp; Tortilla Chips (Vg)\\u003C/td\\u003E\\n\