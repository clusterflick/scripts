          "bodySize": 4533,
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 4533,
            "text": "{\"businessDate\":\"2026-01-10\",\"showtimes\":[{\"id\":\"WIM01-53518\",\"schedule\":{\"businessDate\":\"2026-01-10\",\"startsAt\":\"2026-01-10T18:00:00+00:00\",\"endsAt\":\"2026-01-10T22:20:00+00:00\",\"filmStartsAt\":\"2026-01-10T18:25:00+00:00\",\"filmEndsAt\":\"2026-01-10T22:20:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM01-1-7\",\"filmId\":\"HO00006240\",\"siteId\":\"WIM01\",\"screenId\":\"WIM01-1\",\"areaCategories\":[{\"areaCategoryId\":\"WIM01-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"WIM01\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4204,\"longitude\":-0.2055},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006240\",\"title\":{\"text\":\"Met Opera 2025-26: I Puritani\",\"translations\":[]},\"synopsis\":{\"text\":\"For gorgeous melody, spellbinding coloratura, and virtuoso vocal fireworks, I Puritani has few equals. On January 10, the first new Met production of Bellini’s final masterpiece in nearly 50 years—a striking staging by Charles Edwards, who makes his company directorial debut after many successes as a set designer—arrives in cinemas worldwide. The Met has assembled a world-beating quartet of stars, conducted by Marco Armiliato, for the demanding principal roles. Soprano Lisette Oropesa and tenor Lawrence Brownlee are Elvira and Arturo, brought together by love and torn apart by the political rifts of the English Civil War, with baritone Artur Ruciński as Riccardo, betrothed to Elvira against her will, and bass-baritone Christian Van Horn as Elvira’s sympathetic uncle, Giorgio.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"For gorgeous melody, spellbinding coloratura, and virtuoso vocal fireworks, I Puritani has few equals. \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-10\",\"runtimeInMinutes\":235,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001488\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003808\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000296\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000539\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000632\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000633\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"326f1551-03d5-4b22-ad3f-cda83d151748\",\"corporateId\":null},\"hopk\":\"HO00006240\",\"hoCode\":\"A000007698\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000001488\",\"name\":{\"givenName\":\"Lisette\",\"familyName\":\"Oropesa\",\"middleName\":null}},{\"id\":\"0000003808\",\"name\":{\"givenName\":\"Marco\",\"familyName\":\"Armiliato\",\"middleName\":null}},{\"id\":\"HO00000296\",\"name\":{\"givenName\":\"Lawrence\",\"familyName\":\"Brownlee\",\"middleName\":null}},{\"id\":\"HO00000539\",\"name\":{\"givenName\":\"Christian\",\"familyName\":\"Van Horn\",\"middleName\":null}},{\"id\":\"HO00000632\",\"name\":{\"givenName\":\"Artur\",\"familyName\":\"Ruciński\",\"middleName\":null}},{\"id\":\"HO00000633\",\"name\":{\"givenName\":\"Charles\",\"familyName\":\"Edwards\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[],\"screens\":[{\"id\":\"WIM01-1\",\"name\":{\"text\":\"Red\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000043\",\"name\":{\"text\":\"THE MET: LIVE IN HD\",\"translations\":[]},\"shortName\":{\"text\":\"THE MET\",\"translations\":[]},\"description\":{\"text\":\"The Met Opera returns to Curzon featuring performances transmitted live from the New York stage to cinemas worldwide.\",\"translations\":[]},\"schedule\":{\"startDate\":\"2024-10-05\",\"endDate\":\"2026-06-30\"},\"siteIds\":[\"BLO1\",\"CAM1\",\"CAN01\",\"COL1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SHE1\",\"VIC1\",\"WIM01\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"WIM01-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}"
