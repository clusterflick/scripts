            "text": "{\"businessDate\":\"2025-12-14\",\"showtimes\":[{\"id\":\"WIM01-53614\",\"schedule\":{\"businessDate\":\"2025-12-14\",\"startsAt\":\"2025-12-14T14:00:00+00:00\",\"endsAt\":\"2025-12-14T17:55:00+00:00\",\"filmStartsAt\":\"2025-12-14T14:25:00+00:00\",\"filmEndsAt\":\"2025-12-14T17:55:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM01-1-7\",\"filmId\":\"HO00006228\",\"siteId\":\"WIM01\",\"screenId\":\"WIM01-1\",\"areaCategories\":[{\"areaCategoryId\":\"WIM01-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000042\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"WIM01\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4204,\"longitude\":-0.2055},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006228\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: The Nutcracker\",\"translations\":[]},\"synopsis\":{\"text\":\"The magician Herr Drosselmeyer needs to save his nephew. Hans-Peter has been transformed into a Nutcracker; the only way to save him is for the Nutcracker to defeat the Mouse King and find a girl to love and care for him. A flicker of hope comes in the form of the young Clara, whom Drosselmeyer meets at a Christmas party. With some magic, a cosy Christmas gathering turns into a marvellous adventure. \\nPeter Wright’s The Nutcracker has enchanted audiences since its 1984 premiere by the Company. Featuring Tchaikovsky’s most familiar melodies and brought to life by Julia Trevelyan Oman’s exquisite designs, The Nutcracker is sure to be a festive firecracker for all ages.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The magician Herr Drosselmeyer needs to save his nephew. Hans-Peter has been transformed into a Nutcracker.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-10\",\"runtimeInMinutes\":210,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"HO00000292\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b3549712-da50-415c-811f-783459340cae\",\"corporateId\":null},\"hopk\":\"HO00006228\",\"hoCode\":\"A000007685\",\"eventId\":\"0000000042\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"HO00000292\",\"name\":{\"givenName\":\"Peter \",\"familyName\":\"Wright\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Encore\",\"translations\":[]},\"shortName\":{\"text\":\"Encore\",\"translations\":[]},\"description\":{\"text\":\"Encore\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"WIM01-1\",\"name\":{\"text\":\"Red\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000042\",\"name\":{\"text\":\"Royal Ballet and Opera\",\"translations\":[]},\"shortName\":{\"text\":\"RB&O\",\"translations\":[]},\"description\":{\"text\":\"The Royal Ballet and Opera brings the thrill of world-class theatre to cinema screens right around the globe. \\n\\nWith productions across both Companies, the programme includes beloved classics as well as new productions.\\n\\nOffering audiences a view from the best seat in the house, the programme shares the joy of live performance, and the beauty of world-class art with cinemagoers in more than 1,500 cinemas and 50 countries around the world.\\n\",\"translations\":[]},\"schedule\":{\"startDate\":\"2024-09-01\",\"endDate\":\"2026-06-30\"},\"siteIds\":[\"ALD1\",\"BLO1\",\"CAM1\",\"CAN01\",\"CAN2\",\"COL1\",\"HOX1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SHE1\",\"SOH1\",\"VIC1\",\"WIM01\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"WIM01-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}"
