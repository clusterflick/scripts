ress\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006677\",\"title\":{\"text\":\"Hamnet\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"distressing scenes, brief moderate sex\",\"translations\":[]},\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":126,\"trailerUrl\":\"https://www.youtube.com/watch?v=Y9Tv9wGPxIw\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000175\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001040\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001087\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002138\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002310\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004702\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004703\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005314\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007765\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c566d7dc-50bb-4d55-984b-c4c65751933e\",\"corporateId\":null},\"hopk\":\"HO00006677\",\"hoCode\":\"A000008241\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006686\",\"title\":{\"text\":\"H is for Hawk\",\"translations\":[]},\"synopsis\":{\"text\":\"When Helen's beloved father passes away, she is knocked sideways by grief and loses herself in memories of their time birding and exploring the natural world together. She becomes obsessed with the idea of training her own goshawk, and so she brings the fearsome bird Mabel home to her life as a graduate fellow at Cambridge. Helen fills the freezer with hawk food and turns off her phone, ready to embark on the long, strange business of trying to train this wildest of animals. But as she labours to tame Mabel, a grieving Helen undergoes an untaming of her own. A record of a spiritual journey, H IS FOR HAWK is a story about memory and nature and how it might be possible to reconcile death with life and love.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When Helen's beloved father passes away, she is knocked sideways by grief and loses herself in memories of their time birding and exploring the natural world together.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, drug misuse, injury detail, sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=RJ29BBXfN64\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000166\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000167\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000254\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002250\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007943\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012811\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012812\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012813\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012814\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012815\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e652fb82-1635-4421-a615-6bd0166c8771\",\"corporateId\":null},\"hopk