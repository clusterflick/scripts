            "text": "{\"businessDate\":\"2026-02-24\",\"showtimes\":[{\"id\":\"WIM01-56035\",\"schedule\":{\"businessDate\":\"2026-02-24\",\"startsAt\":\"2026-02-24T11:00:00+00:00\",\"endsAt\":\"2026-02-24T13:43:00+00:00\",\"filmStartsAt\":\"2026-02-24T11:25:00+00:00\",\"filmEndsAt\":\"2026-02-24T13:43:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM01-3-12\",\"filmId\":\"HO00006735\",\"siteId\":\"WIM01\",\"screenId\":\"WIM01-3\",\"areaCategories\":[{\"areaCategoryId\":\"WIM01-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"WIM01\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4204,\"longitude\":-0.2055},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006735\",\"title\":{\"text\":\"The Age of Innocence\",\"translations\":[]},\"synopsis\":{\"text\":\"Society scion Newland Archer is engaged to May Welland, but his well-ordered life is upset when he meets May's unconventional cousin, the Countess Olenska. At first, Newland becomes a defender of the Countess, whose separation from her abusive husband makes her a social outcast in the restrictive high society of late-19th Century New York, but he finds in her a companion spirit and they fall in love.\\r\\n\\r\\nSilver Screen: These screenings provide an inclusive and enjoyable cinema experience for senior citizens, where we will be showing classic films as well as recent releases.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Society scion Newland Archer is engaged to May Welland, but his well-ordered life is upset when he meets May's unconventional cousin, the Countess Olenska.\",\"translations\":[]},\"c