s3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"WIM01-56405\",\"schedule\":{\"businessDate\":\"2026-02-14\",\"startsAt\":\"2026-02-14T17:50:00+00:00\",\"endsAt\":\"2026-02-14T20:31:00+00:00\",\"filmStartsAt\":\"2026-02-14T18:15:00+00:00\",\"filmEndsAt\":\"2026-02-14T20:31:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM01-1-10\",\"filmId\":\"HO00006762\",\"siteId\":\"WIM01\",\"screenId\":\"WIM01-1\",\"areaCategories\":[{\"areaCategoryId\":\"WIM01-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"WIM01-1113-HO00006762\"},{\"id\":\"WIM01-56404\",\"schedule\":{\"businessDate\":\"2026-02-14\",\"startsAt\":\"2026-02-14T20:00:00+00:00\",\"endsAt\":\"2026-02-14T22:41:00+00:00\",\"filmStartsAt\":\"2026-02-14T20:25:00+00:00\",\"filmEndsAt\":\"2026-02-14T22:41:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM01-2-11\",\"filmId\":\"HO00006762\",\"siteId\":\"WIM01\",\"screenId\":\"WIM01-2\",\"areaCategories\":[{\"areaCategoryId\":\"WIM01-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"WIM01-1113-HO00006762\"}],\"relatedData\":{\"sites\":[{\"id\":\"WIM01\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4204,\"longitude\":-0.2055},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006810\",\"title\":{\"text\":\"Film Club: Sleepless in Seattle\",\"translations\":[]},\"synopsis\":{\"text\":\"After his wife Maggie passes away, Sam Baldwin and his 8-year-old son Jonah relocate from Chicago to Seattle to escape the grief associated with Maggie's death. Eighteen months later Sam is still grieving and can't sleep. Although Jonah misses his mother, he wants his father to get a new wife despite Sam having not even contemplated dating again. On Christmas Eve, Sam (on Jonah's initiative) ends up pouring his heart out on a national radio talk show about his magical and perfect marriage to Maggie, and how much he still misses her. Among the many women who hear Sam's story and fall in love with him solely because of it is Annie Reed, a Baltimore-based newspaper writer. Annie's infatuation with Sam's story and by association Sam himself is despite being already engaged. But Annie's relationship with her straight-laced fiance Walter is unlike her dream love life in the movie An Affair to Remember (1957)\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A recently widowed man's son calls a radio talk-show in an attempt to find his father a partner.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":{\"text\":\"mild sex references, language\",\"translations\":[]},\"releaseDate\":\"2026-02-14\",\"runtimeInMinutes\":101,\"trailerUrl\":\"https://www.youtube.com/watch?v=ui560tsUX6k\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003325\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004764\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007032\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008528\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009421\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013279\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013280\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006810\",\"hoCode\":\"A000008401\",\"eventId\":null,\"distributorName\":\"Park Circus\"},{\"id\":