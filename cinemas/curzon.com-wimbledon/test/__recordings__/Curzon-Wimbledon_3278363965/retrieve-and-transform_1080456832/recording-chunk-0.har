            "mimeType": "application/json; charset=utf-8",
            "text": "{\"name\":\"Wimbledon\",\"urlSegment\":\"wimbledon\",\"url\":\"/venues/wimbledon/\",\"nodeId\":1814,\"alias\":\"cinema\",\"createDate\":\"2024-08-13T14:58:55\\u002B01:00\",\"updateDate\":\"2026-01-28T09:54:27\\u002B00:00\",\"versions\":{\"\":\"https://www.curzon.com/venues/wimbledon/\"},\"robotsNoIndex\":false,\"robotsNoFollow\":false,\"masterCanonicalUrl\":null,\"excludeCanonicalUrl\":false,\"seoImage\":null,\"metaKeywords\":\"\",\"metaDescription\":\"Find out what\\u0027s on at Curzon Cinema in Wimbledon. Check out the latest blockbuster movies, new Indie film releases and the best of world cinema out now.\",\"seoPageTitle\":\"Curzon Wimbledon Cinema Showtimes \\u0026 Film Listings\",\"oGType\":\"\",\"twitterCard\":\"\",\"seoUrl\":\"\",\"oGLocale\":\"\",\"excludeFromXmlSitemap\":false,\"excludeFromSiteSearch\":false,\"pageTitle\":\"Curzon Wimbledon Cinema Showtimes \\u0026 Film Listings\",\"hideTitle\":false,\"grid\":[],\"redirectDetailsElement\":{\"redirect\":false,\"permanent\":false},\"heroCarouselDetailsElement\":[{\"image\":{\"mobile\":\"/media/v3bmqdhf/open.webp?width=393\\u0026height=169\\u0026v=1dc903b9a6542f0\",\"tablet\":\"/media/v3bmqdhf/open.webp?width=782\\u0026height=315\\u0026v=1dc903b9a6542f0\",\"desktop\":\"/media/v3bmqdhf/open.webp?width=1216\\u0026height=523\\u0026v=1dc903b9a6542f0\",\"alt\":\"\"},\"textHeading\":\"ON TUESDAY 3 FEBRUARY OUR VENUES WILL OPEN AT 12PM\"},{\"image\":{\"mobile\":\"/media/f2jnmdx3/wimbledon-2-2025.webp?width=393\\u0026height=169\\u0026v=1dc2ede24027330\",\"tablet\":\"/media/f2jnmdx3/wimbledon-2-2025.webp?width=782\\u0026height=315\\u0026v=1dc2ede24027330\",\"desktop\":\"/media/f2jnmdx3/wimbledon-2-2025.webp?width=1216\\u0026height=523\\u0026v=1dc2ede24027330\",\"alt\":\"\"},\"textHeading\":\"WELCOME TO CURZON WIMBLEDON\"},{\"image\":{\"mobile\":\"/media/px2iem4l/st-mungos-web.jpg?width=393\\u0026height=169\\u0026v=1dc44fc6573af80\",\"tablet\":\"/media/px2iem4l/st-mungos-web.jpg?width=782\\u0026height=315\\u0026v=1dc44fc6573af80\",\"desktop\":\"/media/px2iem4l/st-mungos-web.jpg?width=1216\\u0026height=523\\u0026v=1dc44fc6573af80\",\"alt\":\"\"},\"textHeading\":\"Support St Mungo\\u0027s on your Curzon cinema visit\",\"actionLink\":{\"name\":\"FIND OUT MORE\",\"url\":\"https://www.curzon.com/charity/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/qdydgzxw/dips-web.jpg?width=393\\u0026height=169\\u0026v=1dbb9e5e6e5c9b0\",\"tablet\":\"/media/qdydgzxw/dips-web.jpg?width=782\\u0026height=315\\u0026v=1dbb9e5e6e5c9b0\",\"desktop\":\"/media/qdydgzxw/dips-web.jpg?width=1216\\u0026height=523\\u0026v=1dbb9e5e6e5c9b0\",\"alt\":\"\"},\"textHeading\":\"FOOD \\u0026 DRINK\",\"actionLink\":{\"name\":\"VIEW MENU\",\"target\":\"_blank\",\"url\":\"/media/gkmfs5jo/menu-6_oct2025_updated.pdf\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/5nujqtyh/wimbledon1-2025.webp?width=393\\u0026height=169\\u0026v=1dc2ede2435df40\",\"tablet\":\"/media/5nujqtyh/wimbledon1-2025.webp?width=782\\u0026height=315\\u0026v=1dc2ede2435df40\",\"desktop\":\"/media/5nujqtyh/wimbledon1-2025.webp?width=1216\\u0026height=523\\u0026v=1dc2ede2435df40\",\"alt\":\"\"},\"textHeading\":\"THREE NEWLY REFURBISHED SCREENS\"}],\"cinemaLocationDetailsElement\":{\"venueCardImage\":{\"mobile\":\"/media/4ypeoexv/wimbledon-web.webp?width=300\\u0026height=160\\u0026v=1dc295049a5d700\",\"alt\":\"\"},\"addressLine1\":\"23 The Broadway\",\"city\":\"London\",\"postcode\":\"SW19 1RE\",\"nearestStationName\":\"Wimbledon\",\"nearestStationType\":\"underground\"},\"vistaCinema\":{\"key\":\"WIM01\",\"value\":\"Wimbledon\"},\"informationTabAccordions\":[{\"heading\":\"Opening times\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EMonday to Saturday:\\u003C/strong\\u003E The cinema opens 30 minutes before the first show\\u0027s programme begins and closes at midnight.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESunday:\\u003C/strong\\u003E Closes at 11.30pm.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cem\\u003EPlease be aware opening and closing times may be subject to change.\\u003C/em\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Screen info\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EScreen One\\u003Cbr\\u003E\\u003C/strong\\u003E73 seats, 1 wheelchair space\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen Two\\u003Cbr\\u003E\\u003C/strong\\u003E62 seats, 2 wheelchair spaces\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen Three\\u003Cbr\\u003E\\u003C/strong\\u003E46 seats, 2 wheelchair spaces\\u003C/p\\u003E\"},{\"heading\":\"Accessibility\",\"body\":\"\\u003Cp\\u003EAll screens are accessible by lift, each screen has wheelchair spaces. The lift has a maximum weight limit of 630 kg. There is a wheelchair-accessible bathroom.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen One\\u003Cbr\\u003E\\u003C/strong\\u003E1 wheelchair space\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen Two\\u003Cbr\\u003E\\u003C/strong\\u003E2 wheelchair spaces\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen Three\\u003Cbr\\u003E\\u003C/strong\\u003E2 wheelchair spaces\\u003C/p\\u003E\"},{\"heading\":\"Food and Drink\",\"body\":\"\\u003Cp\\u003EOur drinks menu includes a wide selection of cocktails, wine, craft beer, soft drinks and hot drinks.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022/media/gkmfs5jo/menu-6_oct2025_updated.pdf\\u0022 target=\\u0022_blank\\u0022 title=\\u0022Menu 6 Oct2025 Updated\\u0022\\u003EView the full menu here.\\u003C/a\\u003E\\u003C/span\\u003E\\u003C/p\\u003E\"},{\"heading\":\"HAPPY HOUR INFORMATION\",\"body\":\"\\u003Cp\\u003EAt this venue Happy Hour is 5pm to 10pm every day, 2 for \\u00A318 on all cocktails.\\u003C/p\\u003E\"},{\"heading\":\"Private hires\",\"body\":\"\\u003Cp\\u003EOur screens are available to rent for your private functions, email \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca href=\\u0022mailto:privatehires@curzon.com\\u0022 title=\\u0022Email private hires\\u0022\\u003Eprivatehires@curzon.com\\u003C/a\\u003E\\u003C/span\\u003E for more information.\\u003C/p\\u003E\\n\\u003Cp\\u003ETo find out more, visit our \\u003Ca href=\\u0022https://www.curzon.com/private-hire/wimbledon/\\u0022 title=\\u0022Wimbledon Private Hire Page\\u0022\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003EPrivate Hires page\\u003C/span\\u003E.\\u003C/a\\u003E\\u003C/p\\u003E\"}],\"informationTabDescription\":\"\\u003Cp\\u003ECurzon Wimbledon is a sumptuous, three-screen cinema that captures the wide-ranging tastes of the local community with its expansive film programme. The snug caf\\u00E9 and bar area handily serves a dual function: during the day, it is a quiet place to enjoy a coffee, and at night it transforms into a bustling hangout where you can sit back with a glass of wine.\\u003C/p\\u003E\",\"menuTabAccordions\":[{\"heading\":\"Pizza\",\"body\":\"\\u003Ctable border=\\u00221\\u0022 style=\\u0022border-collapse: collapse; width: 100%; height: 382px;\\u0022\\u003E\\n\\u003Ctbody\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EMargherita (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A311.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EPepperoni \\u0026amp; Honey\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003E\\u0027Nduja\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EGoat\\u0027s Cheese \\u0026amp; Caramelised Onion (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.80\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EMushroom \\u0026amp; Truffle Oil (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.80\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EVegan Margherita (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A311.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EVegan Mushroom \\u0026amp; Truffle Oil (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.80\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003ETomato \\u0026amp; Pesto Flatbread (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A38.00\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EGarlic Flatbread (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; height: 18.5px; text-al