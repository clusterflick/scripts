          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-12-05\",\"showtimes\":[{\"id\":\"WIM1-58343\",\"schedule\":{\"businessDate\":\"2026-12-05\",\"startsAt\":\"2026-12-05T17:00:00+00:00\",\"endsAt\":\"2026-12-05T21:19:00+00:00\",\"filmStartsAt\":\"2026-12-05T17:25:00+00:00\",\"filmEndsAt\":\"2026-12-05T21:19:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM1-1-10\",\"filmId\":\"HO00007137\",\"siteId\":\"WIM1\",\"screenId\":\"WIM1-1\",\"areaCategories\":[{\"areaCategoryId\":\"WIM1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"WIM1\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4203987121582,\"longitude\":-0.20550000667572},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"WIM1@curzon.com\",\"address\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007137\",\"title\":{\"text\":\"Met Opera 2026-27: Samson et Dalila\",\"translations\":[]},\"synopsis\":{\"text\":\"Saint-Saëns’s spectacular take on the biblical hero of legendary strength and the seductive Philistine whose beauty overpowers him returns in the Met’s larger-than-life production. Featuring a massive orchestra and chorus and some of opera’s most spellbinding tunes, this masterpiece is a feast for the eyes and ears. Giacomo Sagripanti conducts an electrifying cast led by the formidable star pairing of mezzo-soprano Aigul Akhmetshina and tenor Clay Hilley, broadcast live to cinemas worldwide.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Saint-Saëns’s spectacular take on the biblical hero of legendary strength and the seductive Philistine whose beauty overpowers him returns in the Met’s larger-than-life\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-12-05\",\"runtimeInMinutes\":234,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000917\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000298\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000543\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000768\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000769\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000770\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000917\"},{\"castAndCrewMemberId\":\"0000001576\"},{\"castAndCrewMemberId\":\"HO00000298\"},{\"castAndCrewMemberId\":\"HO00000543\"},{\"castAndCrewMemberId\":\"HO00000768\"},{\"castAndCrewMemberId\":\"HO00000769\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000000920\"}],\"producers\":[{\"castAndCrewMemberId\":\"HO00000770\"}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"95312d93-a009-4b83-906c-7c9079bfc829\",\"corporateId\":null},\"hopk\":\"HO00007137\",\"hoCode\":\"A000008788\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000917\",\"name\":{\"givenName\":\"Alfred\",\"familyName\":\"Walker\",\"middleName\":null}},{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000001576\",\"name\":{\"givenName\":\"Quinn\",\"familyName\":\"Kelsey\",\"middleName\":null}},{\"id\":\"HO00000298\",\"name\":{\"givenName\":\"Aigul\",\"familyName\":\"Akhmetshina\",\"middleName\":null}},{\"id\":\"HO00000543\",\"name\":{\"givenName\":\"Morris\",\"familyName\":\"Robinson\",\"middleName\":null}},{\"id\":\"HO00000768\",\"name\":{\"givenName\":\"Giacomo\",\"familyName