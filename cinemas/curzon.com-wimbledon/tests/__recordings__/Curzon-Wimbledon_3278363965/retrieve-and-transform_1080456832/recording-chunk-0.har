          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-10-03\",\"showtimes\":[{\"id\":\"WIM1-58341\",\"schedule\":{\"businessDate\":\"2026-10-03\",\"startsAt\":\"2026-10-03T18:00:00+01:00\",\"endsAt\":\"2026-10-03T22:22:00+01:00\",\"filmStartsAt\":\"2026-10-03T18:25:00+01:00\",\"filmEndsAt\":\"2026-10-03T22:22:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM1-1-10\",\"filmId\":\"HO00007131\",\"siteId\":\"WIM1\",\"screenId\":\"WIM1-1\",\"areaCategories\":[{\"areaCategoryId\":\"WIM1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"WIM1\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4203987121582,\"longitude\":-0.20550000667572},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"WIM1@curzon.com\",\"address\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007131\",\"title\":{\"text\":\"Met Opera 2026-27: Così fan tutte\",\"translations\":[]},\"synopsis\":{\"text\":\"The Met: Live in HD season continues with Mozart’s satirical comedy of fickle young love. Phelim McDermott’s “colorful, inventive” (The New York Times) staging, inspired by Coney Island in the 1950s, sets the uproarious story at a boardwalk amusement park, where the two pairs of lovers at the heart of the tale find themselves on one emotional—and literal—thrill ride after another. Soprano Federica Lombardi and mezzo-soprano Samantha Hankey sing Fiordiligi and Dorabella, opposite tenor Duke Kim and baritone Andrey Zhilikhovsky as Ferrando and Guglielmo. Bass-baritone Gerald Finley reprises his portrayal of the cynical Don Alfonso, with soprano Ana María Martínez as the witty maid Despina.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Met: Live in HD season continues with Mozart’s satirical comedy of fickle young love. Phelim McDermott’s “colorful, inventive” (The New York Times) staging\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-10-03\",\"runtimeInMinutes\":237,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000003516\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003807\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003829\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014099\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014100\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014101\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000310\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000003516\"},{\"castAndCrewMemberId\":\"0000003829\"},{\"castAndCrewMemberId\":\"0000014099\"},{\"castAndCrewMemberId\":\"0000014100\"},{\"castAndCrewMemberId\":\"0000014101\"},{\"castAndCrewMemberId\":\"HO00000310\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000000920\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000003807\"}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"02e51e1b-5e8f-4a11-96e1-b74f5c968d29\",\"corporateId\":null},\"hopk\":\"HO00007131\",\"hoCode\":\"A000008782\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000003516\",\"name\":{\"givenName\":\"Andrey\",\"familyName\":\"Zhilikhovsky\",\"middleName\":null}},{\"id\":\"0000003807\",\"name\":{\"givenName\":\"Phelim \",\"familyName\":\"McDermott\",\"middleName\":null}},{\"id\":\"0000003829\",\"name\":{\"givenName\":\"Ana María\",\"familyName\":\"Martínez\",\"middleName\":null}},{\"id\":\"0000014099\",\"name\":{\"givenName\":\"Nimrod David\",\"familyName\":\"Pfeffer\",\"middleName\":null}},{\"id\":\"0000014100\",\"name\":{\"givenName\":\"Samantha\",\"familyName\":\"Hankey\",\"middleName\":null}},{\"id\":\"0000014101\",\"name\":{\"givenName\":\"Duke\",\"familyName\":\"Kim\",\"middleName\":null}},{\"id\":\"HO00000310\",\"name\":{\"givenName\":\"Federica\",\"familyName\":\"Lombardi\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[],\"screens\":[{\"id\":\"WIM1-1\",\"name\":{\"text\":\"Screen One\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000043\",\"name\":{\"text\":\"THE MET: LIVE IN HD\",\"translations\":[]},\"shortName\":{\"text\":\"THE MET\",\"translations\":[]},\"description\":{\"text\":\"The Met Opera returns to Curzon featuring performances transmitted live from the New York stage to cinemas worldwide.\",\"translations\":[]},\"schedule\":{\"startDate\":\"2025-10-18\",\"endDate\":\"2027-12-31\"},\"siteIds\":[\"BLO1\",\"CAM1\",\"CAN2\",\"COL1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"VIC1\",\"WIM1\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"WIM1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
