d\":\"0000003325\"},{\"castAndCrewMemberId\":\"0000005692\"},{\"castAndCrewMemberId\":\"0000006291\"},{\"castAndCrewMemberId\":\"0000009763\"},{\"castAndCrewMemberId\":\"0000013314\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000013297\"},{\"castAndCrewMemberId\":\"0000013315\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000013298\"},{\"castAndCrewMemberId\":\"0000013316\"}],\"genreIds\":[\"0000000003\",\"0000000007\",\"0000000025\"],\"externalIds\":{\"moviexchangeReleaseId\":\"3e6d64d4-c466-4c58-93cd-ce8d7c41f210\",\"corporateId\":null},\"hopk\":\"HO00006825\",\"hoCode\":\"A000008421\",\"eventId\":null,\"distributorName\":\"Walt Disney Studios Motion Pictures - UK\"},{\"id\":\"HO00006931\",\"title\":{\"text\":\"Disclosure Day\",\"translations\":[]},\"synopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming close to … Disclosure Day.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-10\",\"runtimeInMinutes\":145,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/920be864-1bc7-4cfd-aa64-b828b3c90b38/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=pFz8czbdPdU\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=pFz8czbdPdU\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000341\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001072\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002138\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000002139\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008293\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013627\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000341\"},{\"castAndCrewMemberId\":\"0000000418\"},{\"castAndCrewMemberId\":\"0000001072\"},{\"castAndCrewMemberId\":\"0000008293\"},{\"castAndCrewMemberId\":\"0000013627\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000002138\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000002138\"},{\"castAndCrewMemberId\":\"0000002139\"}],\"genreIds\":[\"0000000035\"],\"externalIds\":{\"moviexchangeReleaseId\":\"920be864-1bc7-4cfd-aa64-b828b3c90b38\",\"corporateId\":null},\"hopk\":\"HO00006931\",\"hoCode\":\"A000008544\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006966\",\"title\":{\"text\":\"Tuner\",\"translations\":[]},\"synopsis\":{\"text\":\"In Tuner, Academy Award-winning director Daniel Roher’s first narrative feature, Leo Woodall stars as a gifted young piano tuner whose heightened sense of hearing draws the attention of criminals, who see his talents as useful for opening safes as for tuning Steinways. With his once-promising musical career over, he works across New York with his mentor Harry Horowitz (Academy Award-winner Dustin Hoffman), encountering a range of characters, including composition student Ruthie (Havana Rose Liu), with whom he forges an unexpected connection. Niki’s safecracking work threatens his budding romance with Ruthie and pulls him into increasingly dangerous territory. Blending romance, drama, and the taut suspense of a heist thriller, TUNER also features performances from Tony Award-winner Tovah Feldshuh, Jean Reno, and Lior Raz.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A gifted piano tuner's meticulous skills for tuning pianos lead him to discover an unexpected aptitude for cracking safes, turning his life upside down.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, drug misuse, violence, brief sexual images\",\"translations\":[]},\"releaseDate\":\"2026-05-29\",\"runtimeInMinutes\":107,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/efa7eb63-8966-49c2-8b50-4331964273a5/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=AfcmVGybiNQ\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=AfcmVGybiNQ\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001921\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002284\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003061\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000004445\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007256\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008227\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009690\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010409\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010518\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013781\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013782\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000004445\"},{\"castAndCrewMemberId\":\"0000007256\"},{\"castAndCrewMemberId\":\"0000008227\"},{\"castAndCrewMemberId\":\"0000009690\"},{\"castAndCrewMemberId\":\"0000010409\"},{\"castAndCrewMemberId\":\"0000010518\"},{\"castAndCrewMemberId\":\"0000013781\"},{\"castAndCrewMemberId\":\"0000013782\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000003061\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000001921\"},{\"castAndCrewMemberId\":\"0000002284\"}],\"genreIds\":[\"0000000002\",\"0000000026\"],\"externalIds\":{\"moviexchangeReleaseId\":\"efa7eb63-8966-49c2-8b50-4331964273a5\",\"corporateId\":null},\"hopk\":\"HO00006966\",\"hoCode\":\"A000008583\",\"eventId\":null,\"distributorName\":\"Black Bear\"},{\"id\":\"HO00007050\",\"title\":{\"text\