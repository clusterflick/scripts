          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-11-10\",\"showtimes\":[{\"id\":\"WIM1-58331\",\"schedule\":{\"businessDate\":\"2026-11-10\",\"startsAt\":\"2026-11-10T19:00:00+00:00\",\"endsAt\":\"2026-11-10T23:00:00+00:00\",\"filmStartsAt\":\"2026-11-10T19:25:00+00:00\",\"filmEndsAt\":\"2026-11-10T23:00:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM1-1-10\",\"filmId\":\"HO00007122\",\"siteId\":\"WIM1\",\"screenId\":\"WIM1-1\",\"areaCategories\":[{\"areaCategoryId\":\"WIM1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000042\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"WIM1\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4203987121582,\"longitude\":-0.20550000667572},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"WIM1@curzon.com\",\"address\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007122\",\"title\":{\"text\":\"RBO Cinema Season 2026-27: Carmen\",\"translations\":[]},\"synopsis\":{\"text\":\"Under the oppressive heat of the Spanish sun, the fiercely independent Carmen attracts the attention of Don José. She warns him not to fall in love with her, but his obsession knows no bounds. Damiano Michieletto’s searing production returns, casting scorching light on the lust, violence and destructive desire of Bizet’s ever-popular opera. \\nAn all-star cast brings this white-hot drama to life, with Ginger Costa-Jackson in the fiery title role, alongside Russell Thomas as the jealous and despairing Don José. Following his 2023 Royal Opera debut, Sesto Quatrini returns to conduct Bizet’s electrifying and sensual score.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Under the oppressive heat of the Spanish sun, the fiercely independent Carmen attracts the attention of Don José. She warns him not to fall in love with her\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-11-10\",\"runtimeInMinutes\":215,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000922\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014096\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014097\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014098\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000379\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000601\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000922\"},{\"castAndCrewMemberId\":\"0000014096\"},{\"castAndCrewMemberId\":\"0000014097\"},{\"castAndCrewMemberId\":\"0000014098\"},{\"castAndCrewMemberId\":\"HO00000601\"}],\"directors\":[{\"castAndCrewMemberId\":\"HO00000379\"}],\"producers\":[],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"f7e080d9-f84e-45f2-898b-630570ea943a\",\"corporateId\":null},\"hopk\":\"HO00007122\",\"hoCode\":\"A000008773\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000922\",\"name\":{\"givenName\":\"Alexander \",\"familyName\":\"Vinogradov\",\"middleName\":null}},{\"id\":\"0000014096\",\"name\":{\"givenName\":\"Ginger\",\"familyName\":\"Costa-Jackson\",\"middleName\":null}},{\"id\":\"0000014097\",\"name\":{\"givenName\":\"Russell\",\"familyName\":\"Thomas\",\"middleName\":null}},{\"id\":\"0000014098\",\"name\":{\"givenName\":\"Adriana\",\"familyName\":\"González\",\"middleName\":null}},{\"id\":\"HO00000379\",\"name\":{\"givenName\":\"Damiano \",\"familyName\":\"Michieletto\",\"middleName\":null}},{\"id\":\"HO00000601\",\"name\":{\"givenName\":\"Barnaby\",\"familyName\":\"Rea\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\"