          "redirectURL": "",
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2027-02-03\",\"showtimes\":[{\"id\":\"WIM1-58334\",\"schedule\":{\"businessDate\":\"2027-02-03\",\"startsAt\":\"2027-02-03T16:45:00+00:00\",\"endsAt\":\"2027-02-03T23:00:00+00:00\",\"filmStartsAt\":\"2027-02-03T17:10:00+00:00\",\"filmEndsAt\":\"2027-02-03T23:00:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM1-3-12\",\"filmId\":\"HO00007125\",\"siteId\":\"WIM1\",\"screenId\":\"WIM1-3\",\"areaCategories\":[{\"areaCategoryId\":\"WIM1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000042\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"WIM1\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4203987121582,\"longitude\":-0.20550000667572},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"WIM1@curzon.com\",\"address\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007125\",\"title\":{\"text\":\"RBO Cinema Season 2026-27: Götterdämmerung\",\"translations\":[]},\"synopsis\":{\"text\":\"An earth in ruin. The twilight of the Gods. \\nDeception leads to treachery, then devastation, when Siegfried is tricked into betraying Brünnhilde. Learning the truth of her beloved’s innocence, Brünnhilde at last returns the ring to the Rhinemaidens, before ordering that Valhalla be swallowed in flames. For the long-awaited finale of Wagner’s epic saga, director Barrie Kosky situates the rich apocalyptic drama in a contemporary world of dream-like turmoil. Antonio Pappano, Conductor Laureate of The Royal Opera, returns to take on the impassioned, otherworldly music – including Siegfried’s transporting Funeral March and Brünnhilde’s electrifying Immolation Scene. The brilliant cast is led by Elisabet Strid, Andreas Schager and Mika Kares, who together with the full forces of the Orchestra of the Royal Opera House and the Royal Opera Chorus bring opera’s greatest journey to its shattering end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"An earth in ruin. The twilight of the Gods. \\nDeception leads to treachery, then devastation, when Siegfried is tricked into betraying Brünnhilde. \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2027-02-03\",\"runtimeInMinutes\":350,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000006115\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006116\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000490\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000606\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000734\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000735\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000736\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000737\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000738\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000739\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000740\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000741\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000742\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000743\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000006115\"},{\"castAndCrewMemberId\":\"HO00000490\"},{\"castAndCrewMemberId\":\"HO00000606\"},{\"castAndCrewMemberId\":\"HO00000734\"},{\"castAndCrewMemberId\":\"HO00000735\"},{\"castAndCrewMemberId\":\"HO00000736\"},{\"castAndCrewMemberId\":\"HO00000737\"},{\"castAndCrewMemberId\":\"HO00000738\"},{\"castAndCrewMemberId\":\"HO00000739\"},{\"castAndCrewMemberId\":\"HO00000740\"},{\"castAndCrewMemberId\":\"HO00000741\"},{\"castAndCrewMe