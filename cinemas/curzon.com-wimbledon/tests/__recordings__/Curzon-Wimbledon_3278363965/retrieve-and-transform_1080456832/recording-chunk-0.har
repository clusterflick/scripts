\":{\"text\":\"At a cosy Christmas party, young Clara meets the mysterious magician Drosselmeyer, who gives her a nutcracker doll. \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-12-01\",\"runtimeInMinutes\":140,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011530\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3643\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3646\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000732\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000733\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000011530\"},{\"castAndCrewMemberId\":\"3643\"},{\"castAndCrewMemberId\":\"3646\"},{\"castAndCrewMemberId\":\"HO00000732\"},{\"castAndCrewMemberId\":\"HO00000733\"}],\"directors\":[],\"producers\":[],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"cf10965f-7f6b-4fc9-82bb-c7433bd1a7de\",\"corporateId\":null},\"hopk\":\"HO00007123\",\"hoCode\":\"A000008774\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000011530\",\"name\":{\"givenName\":\"James\",\"familyName\":\"Hay\",\"middleName\":null}},{\"id\":\"3643\",\"name\":{\"givenName\":\"Reece\",\"familyName\":\"Clarke\",\"middleName\":null}},{\"id\":\"3646\",\"name\":{\"givenName\":\"Mayara\",\"familyName\":\"Magri\",\"middleName\":null}},{\"id\":\"HO00000732\",\"name\":{\"givenName\":\"Marianna\",\"familyName\":\"Tsembenhoi\",\"middleName\":null}},{\"id\":\"HO00000733\",\"name\":{\"givenName\":\"Taisuke\",\"familyName\":\"Nakao\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Encore\",\"translations\":[]},\"shortName\":{\"text\":\"Encore\",\"translations\":[]},\"description\":{\"text\":\"Encore\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false},{\"id\":\"0000000010\",\"name\":{\"text\":\"Satellite Event\",\"translations\":[]},\"shortName\":{\"text\":\"Sat event\",\"translations\":[]},\"description\":{\"text\":\"Live Via Satellite\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"WIM1-1\",\"name\":{\"text\":\"Screen One\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000042\",\"name\":{\"text\":\"Royal Ballet and Opera\",\"translations\":[]},\"shortName\":{\"text\":\"RB&O\",\"translations\":[]},\"description\":{\"text\":\"The Royal Ballet and Opera brings the thrill of world-class theatre to cinema screens right around the globe. \\n\\nWith productions across both Companies, the programme includes beloved classics as well as new productions.\\n\\nOffering audiences a view from the best seat in the house, the programme shares the joy of live performance, and the beauty of world-class art with cinemagoers in more than 1,500 cinemas and 50 countries around the world.\\n\",\"translations\":[]},\"schedule\":{\"startDate\":\"2025-01-01\",\"endDate\":\"2027-12-31\"},\"siteIds\":[\"ALD1\",\"BLO1\",\"CAM1\",\"CAN2\",\"COL1\",\"HOX1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SOH1\",\"VIC1\",\"WIM1\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"WIM1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
