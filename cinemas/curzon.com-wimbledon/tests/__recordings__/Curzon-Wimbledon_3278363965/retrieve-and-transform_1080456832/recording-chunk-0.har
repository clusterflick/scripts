          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-09-22\",\"showtimes\":[{\"id\":\"WIM1-58586\",\"schedule\":{\"businessDate\":\"2026-09-22\",\"startsAt\":\"2026-09-22T18:00:00+01:00\",\"endsAt\":\"2026-09-22T20:40:00+01:00\",\"filmStartsAt\":\"2026-09-22T18:10:00+01:00\",\"filmEndsAt\":\"2026-09-22T20:40:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM1-1-10\",\"filmId\":\"HO00007173\",\"siteId\":\"WIM1\",\"screenId\":\"WIM1-1\",\"areaCategories\":[{\"areaCategoryId\":\"WIM1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000017\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000031\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"WIM1\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4203987121582,\"longitude\":-0.20550000667572},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"WIM1@curzon.com\",\"address\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007173\",\"title\":{\"text\":\"National Theatre Live: The Misanthrope\",\"translations\":[]},\"synopsis\":{\"text\":\"Award-winner Sandra Oh (Killing Eve) plays the title role in this razor-sharp reimagining of Molière’s classic dark comedy. Telling the truth isn’t always that simple. Alice, a brilliant novelist, despises the carefully constructed lies of modern society. But the more she challenges those around her, the fiercer the backlash becomes. Soon, she must confront the price of speaking her truth in a world that would rather silence her. Filmed live on stage at the National Theatre, Indhu Rubasingham directs Martin Crimp’s (Cyrano de Bergerac) highly anticipated play.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Award-winner Sandra Oh (Killing Eve) plays the title role in this razor-sharp reimagining of Molière’s classic dark comedy.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-09-22\",\"runtimeInMinutes\":150,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000643\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010780\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014196\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014197\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014198\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"14232\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"14233\",\"roles\":[\"Director\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000010780\"},{\"castAndCrewMemberId\":\"0000014196\"},{\"castAndCrewMemberId\":\"0000014197\"},{\"castAndCrewMemberId\":\"0000014198\"},{\"castAndCrewMemberId\":\"14232\"}],\"directors\":[{\"castAndCrewMemberId\":\"14233\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000000643\"}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"323fcfab-1fcc-48ba-8654-8a4e7d861cc2\",\"corporateId\":null},\"hopk\":\"HO00007173\",\"hoCode\":\"A000008828\",\"eventId\":null,\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"0000000643\",\"name\":{\"givenName\":\"National Theatre\",\"familyName\":\"Live\",\"middleName\":null}},{\"id\":\"0000010780\",\"name\":{\"givenName\":\"Sandra\",\"familyName\":\"Oh\",\"middleName\":null}},{\"id\":\"0000014196\",\"name\":{\"givenName\":\"Paul\",\"familyName\":\"Chahidi\",\"middleName\":null}},{\"id\":\"0000014197\",\"name\":{\"givenName\":\"Tom\",\"familyName\":\"Mison\",\"middleName\":null}},{\"id\":\"0000014198\",\"name\":{\"givenName\":\"Abigail\",\"familyName\":\"Cruttenden\",\"middleName\":null}},{\"id\":\"14232\",\"name\":{\"givenName\":\"Jemima\",\"familyName\":\"Rooper\",\"middleName\":null}},{\"id\":\"14233\",\"name\":{\"givenName\":\"Indhu\",\"familyName\":\"Rubasingham\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000017\",\"name\":{\"text\":\"Members preview\",\"translations\":[]},\"shortName\":{\"text\":\"Members\",\"translations\":[]},\"description\":{\"text\":\"Members' only preview screening / Members' Priority Booking.\",\"translations\":[]},\"importantMessage\":{\"text\":\"Members' only preview screening / Members' Priority Booking.\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"WIM1-1\",\"name\":{\"text\":\"Screen One\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000031\",\"name\":{\"text\":\"NT Live\",\"translations\":[]},\"shortName\":{\"text\":\"NT Live\",\"translations\":[]},\"description\":{\"text\":\"National Theatre Live brings the best of British theatre to cinema screens across the UK and around the world. With state-of-the-art filming techniques, tailored to every play, we bring you each performance as it happens, in all its glory. From close-ups that capture every flicker of emotion, to sweeping wide shots of the stage. Whether you come along to the live broadcast, or catch one of many replays, you’ll have the best seats in the house.\",\"translations\":[]},\"schedule\":{\"startDate\":\"2024-01-01\",\"endDate\":\"2099-12-31\"},\"siteIds\":[\"ALD1\",\"BLO1\",\"CAM1\",\"CAN2\",\"COL1\",\"HOX1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SOH1\",\"VIC1\",\"WIM1\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"WIM1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
