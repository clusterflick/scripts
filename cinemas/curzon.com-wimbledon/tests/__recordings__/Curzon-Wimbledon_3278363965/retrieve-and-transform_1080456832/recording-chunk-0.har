          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-04-16\",\"showtimes\":[{\"id\":\"WIM01-56431\",\"schedule\":{\"businessDate\":\"2026-04-16\",\"startsAt\":\"2026-04-16T18:00:00+01:00\",\"endsAt\":\"2026-04-16T20:40:00+01:00\",\"filmStartsAt\":\"2026-04-16T18:25:00+01:00\",\"filmEndsAt\":\"2026-04-16T20:40:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM01-1-10\",\"filmId\":\"HO00006787\",\"siteId\":\"WIM01\",\"screenId\":\"WIM01-1\",\"areaCategories\":[{\"areaCategoryId\":\"WIM01-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000017\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"WIM01\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4204,\"longitude\":-0.2055},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006787\",\"title\":{\"text\":\"NT Live: All My Sons\",\"translations\":[]},\"synopsis\":{\"text\":\"\\r\\nBryan Cranston (Breaking Bad) and Marianne Jean-Baptiste (Hard Truths) feature in a five-star, triumphantly acclaimed new production of Arthur Miller\u2019s classic play, from visionary director Ivo Van Hove (A View from the Bridge). \u00a0  One family, the heart of the American dream. When wartime delivers profits for Joe, it comes at a price when his partner is charged with criminal manufacturing deals, and his eldest son goes missing in action. Will peacetime bring peace of mind, or will he be confronted by the consequence of his actions? \u00a0  Filmed live from the West End, Paapa Essiedu (I May Destroy You), Tom Glynn-Carney (House of the Dragon), and Hayley Squires (I, Daniel Blake) also feature in this disturbingly prescient play.\u00a0\\r\\n\\r\\nCUSTOMER NOTICE: Please note that All My Sons contains strobe lighting, which may impact customers with photosensitive epilepsy. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Bryan Cranston and Marianne Jean-Baptiste feature in a five-star, triumphantly acclaimed new production of Arthur Miller\u2019s classic play. \u00a0\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-04-16\",\"runtimeInMinutes\":135,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000381\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003205\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003832\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007817\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013206\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"d330f82a-7d24-47b1-8400-ba9f05d687fe\",\"corporateId\":null},\"hopk\":\"HO00006787\",\"hoCode\":\"A000008372\",\"eventId\":null,\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"0000000381\",\"name\":{\"givenName\":\"Hayley\",\"familyName\":\"Squires\",\"middleName\":null}},{\"id\":\"0000003205\",\"name\":{\"givenName\":\"Paapa\",\"familyName\":\"Essiedu\",\"middleName\":null}},{\"id\":\"0000003832\",\"name\":{\"givenName\":\"Ivo\",\"familyName\":\"van Hove\",\"middleName\":null}},{\"id\":\"0000005698\",\"name\":{\"givenName\":\"Bryan\",\"familyName\":\"Cranston\",\"middleName\":null}},{\"id\":\"0000007817\",\"name\":{\"givenName\":\"Marianne\",\"familyName\":\"Jean-Baptiste\",\"middleName\":null}},{\"id\":\"0000013206\",\"name\":{\"givenName\":\"Tom\",\"familyName\":\"Glynn-Carney\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"c