          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-19\",\"showtimes\":[{\"id\":\"WIM1-58898\",\"schedule\":{\"businessDate\":\"2026-08-19\",\"startsAt\":\"2026-08-19T18:00:00+01:00\",\"endsAt\":\"2026-08-19T19:55:00+01:00\",\"filmStartsAt\":\"2026-08-19T18:25:00+01:00\",\"filmEndsAt\":\"2026-08-19T19:55:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM1-3-12\",\"filmId\":\"HO00007231\",\"siteId\":\"WIM1\",\"screenId\":\"WIM1-3\",\"areaCategories\":[{\"areaCategoryId\":\"WIM1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"WIM1\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4203987121582,\"longitude\":-0.20550000667572},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"WIM1@curzon.com\",\"address\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007231\",\"title\":{\"text\":\"Curzon Film 50: Orlando\",\"translations\":[]},\"synopsis\":{\"text\":\"In 1600, nobleman Orlando (Tilda Swinton) inherits his parents' house, thanks to Queen Elizabeth I (Quentin Crisp), who commands the young man to never change. After a disastrous affair with Russian princess Sasha (Charlotte Valandrey), Orlando looks for solace in the arts before being appointed ambassador to Constantinople in 1700, where war is raging. One morning, Orlando is shocked to wake up as a woman and returns home, struggling as a female to retain her property as the centuries roll by.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After Queen Elizabeth I commands him not to grow old, a young nobleman struggles with love and his place in the world.\",\"translations\":[]},\"censorRati