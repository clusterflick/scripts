id\":\"HO00006680\",\"title\":{\"text\":\"Rental Family\",\"translations\":[]},\"synopsis\":{\"text\":\"A down-and-out actor living in Tokyo is hired as a token American guy for a Japanese rental-family company, leading him on an unexpected journey of self-discovery through the roles he plays in other people\u2019s lives.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A down-and-out actor living in Tokyo is hired as a token American guy for a Japanese rental-family company, leading him on an unexpected journey of self-discovery.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":103,\"trailerUrl\":\"https://www.youtube.com/watch?v=sZT37sM2VgE\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004929\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008380\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008381\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012803\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012804\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012806\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000012807\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5675d1e4-8525-4a12-8283-5e88dcc4e188\",\"corporateId\":null},\"hopk\":\"HO00006680\",\"hoCode\":\"A000008244\",\"eventId\":null,\"distributorName\":\"Walt Disney Studios Motion Pictures - UK\"},{\"id\":\"HO00006686\",\"title\":{\"text\":\"H is for Hawk\",\"translations\":[]},\"synopsis\":{\"text\":\"When Helen's beloved father passes away, she is knocked sideways by grief and loses herself in memories of their time birding and exploring the natural world together. She becomes obsessed with the idea of training her own goshawk, and so she brings the fearsome bird Mabel home to her life as a graduate fellow at Cambridge. Helen fills the freezer with hawk food and turns off her phone, ready to embark on the long, strange business of trying to train this wildest of animals. But as she labours to tame Mabel, a grieving Helen undergoes an untaming of her own. A record of a spiritual journey, H IS FOR HAWK is a story about memory and nature and how it might be possible to reconcile death with life and love.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When Helen's beloved father passes away, she is knocked sideways by grief and loses herself in memories of their time birding and exploring the natural world together.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, drug misuse, injury detail, sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=RJ29BBXfN64\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000166\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000167\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000254\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002250\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007943\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012811\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012812\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012813\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012814\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012815\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e652fb82-1635-4421-a615-6bd0166c8771\",\"corporateId\":null},\"hopk\":\"HO00006686\",\"hoCode\":\"A000008251\",\"eventId\":null,\"distributorName\":\"Lionsgate\"},{\"id\":\"HO00006689\",\"title\":{\"text\":\"No Other Choice\",\"translatio