          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2027-04-03\",\"showtimes\":[{\"id\":\"WIM1-58346\",\"schedule\":{\"businessDate\":\"2027-04-03\",\"startsAt\":\"2027-04-03T17:00:00+01:00\",\"endsAt\":\"2027-04-03T21:50:00+01:00\",\"filmStartsAt\":\"2027-04-03T17:25:00+01:00\",\"filmEndsAt\":\"2027-04-03T21:50:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM1-1-10\",\"filmId\":\"HO00007134\",\"siteId\":\"WIM1\",\"screenId\":\"WIM1-1\",\"areaCategories\":[{\"areaCategoryId\":\"WIM1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"WIM1\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4203987121582,\"longitude\":-0.20550000667572},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"WIM1@curzon.com\",\"address\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007134\",\"title\":{\"text\":\"Met Opera 2026-27: Manon\",\"translations\":[]},\"synopsis\":{\"text\":\"Following her radiant performance in Gounod’s Roméo et Juliette—which garnered raves for “high notes that spun like liquid gold … Sierra touched the operatic firmament” (The New York Times)—superstar soprano Nadine Sierra takes on another alluring French heroine, the irresistible title character of Massenet’s passionate drama, live from the Met stage to cinemas worldwide. Leading tenor Matthew Polenzani is her idealistic lover, the Chevalier des Grieux, with rising-star baritone Andrzej Filończyk as her stalwart cousin, Lescaut, in a breathtaking staging by director Laurent Pelly.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Following her radiant performance in Gounod’s Roméo et Juliette—which garnered raves for “high notes that spun like liquid gold … Sierra touched the operatic firmament”\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2027-04-03\",\"runtimeInMinutes\":265,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001582\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001591\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001594\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003504\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000381\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000762\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000763\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000764\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001582\"},{\"castAndCrewMemberId\":\"0000001591\"},{\"castAndCrewMemberId\":\"0000001594\"},{\"castAndCrewMemberId\":\"0000003504\"},{\"castAndCrewMemberId\":\"HO00000762\"},{\"castAndCrewMemberId\":\"HO00000763\"},{\"castAndCrewMemberId\":\"HO00000764\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000000920\"}],\"producers\":[{\"castAndCrewMemberId\":\"HO00000381\"}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5181796c-61ee-453a-b5e1-0b73ea664913\",\"corporateId\":null},\"hopk\":\"HO00007134\",\"hoCode\":\"A000008785\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000001582\",\"name\":{\"givenName\":\"Matthew\",\"familyName\":\"Polenzani\",\"middleName\":null}},{\"id\":\"0000001591\",\"name\":{\"givenName\":\"Nadine \",\"familyName\":\"Sierra\",\"middleName\":null}},{\"id\":\"0000001594\",\"name\":{\"givenName\":\"Rod\",\"familyName\":\"Gilfry\",\"middleName\":nul