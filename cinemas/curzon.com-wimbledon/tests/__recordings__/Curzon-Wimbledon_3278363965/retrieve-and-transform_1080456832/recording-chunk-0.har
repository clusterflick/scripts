          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-07-11\",\"showtimes\":[{\"id\":\"WIM1-58828\",\"schedule\":{\"businessDate\":\"2026-07-11\",\"startsAt\":\"2026-07-11T19:50:00+01:00\",\"endsAt\":\"2026-07-11T22:40:00+01:00\",\"filmStartsAt\":\"2026-07-11T20:15:00+01:00\",\"filmEndsAt\":\"2026-07-11T22:40:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM1-3-12\",\"filmId\":\"HO00006931\",\"siteId\":\"WIM1\",\"screenId\":\"WIM1-3\",\"areaCategories\":[{\"areaCategoryId\":\"WIM1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"WIM1-1124-HO00006931\"},{\"id\":\"WIM1-58829\",\"schedule\":{\"businessDate\":\"2026-07-11\",\"startsAt\":\"2026-07-11T20:10:00+01:00\",\"endsAt\":\"2026-07-11T22:22:00+01:00\",\"filmStartsAt\":\"2026-07-11T20:35:00+01:00\",\"filmEndsAt\":\"2026-07-11T22:22:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM1-2-11\",\"filmId\":\"HO00006966\",\"siteId\":\"WIM1\",\"screenId\":\"WIM1-2\",\"areaCategories\":[{\"areaCategoryId\":\"WIM1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"WIM1-58824\",\"schedule\":{\"businessDate\":\"2026-07-11\",\"startsAt\":\"2026-07-11T20:40:00+01:00\",\"endsAt\":\"2026-07-11T22:51:00+01:00\",\"filmStartsAt\":\"2026-07-11T21:05:00+01:00\",\"filmEndsAt\":\"2026-07-11T22:51:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM1-1-10\",\"filmId\":\"HO00007147\",\"siteId\":\"WIM1\",\"screenId\":\"WIM1-1\",\"areaCategories\":[{\"areaCategoryId\":\"WIM1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"WIM1\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4203987121582,\"longitude\":-0.20550000667572},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"WIM1@curzon.com\",\"address\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00006931\",\"title\":{\"text\":\"Disclosure Day\",\"translations\":[]},\"synopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming close to … Disclosure Day.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-10\",\"runtimeInMinutes\":145,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/920be864-1bc7-4cfd-aa64-b828b3c90b38/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=pFz8czbdPdU\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=pFz8czbdPdU\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000341\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001072\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002138\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000002139\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008293\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013627\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000341\"},{\"castAndCrewMemberId\":\"0000000418\"},{\"castAndCrewMemberId\":\"0000001072\"},{\"castAndCrewMemberId\":\"0000008293\"},{\"castAndCrewMemberId\":\"0000013627\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000002138\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000002138\"},{\"castAndCrewMemberId\":\"0000002139\"}],\"genreIds\":[\"0000000035\"],\"externalIds\":{\"moviexchangeReleaseId\":\"920be864-1bc7-4cfd-aa64-b828b3c90b38\",\"corporateId\":null},\"hopk\":\"HO00006931\",\"hoCode\":\"A000008544\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006966\",\"title\":{\"text\":\"Tuner\",\"translations\":[]},\"synopsis\":{\"text\":\"In Tuner, Academy Award-winning director Daniel Roher’s first narrative feature, Leo Woodall stars as a gifted young piano tuner whose heightened sense of hearing draws the attention of criminals, who see his talents as useful for opening safes as for tuning Steinways. With his once-promising musical career over, he works across New York with his mentor Harry Horowitz (Academy Award-winner Dustin Hoffman), encountering a range of characters, including composition student Ruthie (Havana Rose Liu), with whom he forges an unexpected connection. Niki’s safecracking work threatens his budding romance with Ruthie and pulls him into increasingly dangerous territory. Blending romance, drama, and the taut suspense of a heist thriller, TUNER also features performances from Tony Award-winner Tovah Feldshuh, Jean Reno, and Lior Raz.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A gifted piano tuner's meticulous skills for tuning pianos lead him to discover an unexpected aptitude for cracking safes, turning his life upside down.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, drug misuse, violence, brief sexual images\",\"translations\":[]},\"releaseDate\":\"2026-05-29\",\"runtimeInMinutes\":107,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https: