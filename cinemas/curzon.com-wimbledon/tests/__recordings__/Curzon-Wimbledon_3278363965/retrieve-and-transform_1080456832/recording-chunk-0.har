          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-09-30\",\"showtimes\":[{\"id\":\"WIM1-58903\",\"schedule\":{\"businessDate\":\"2026-09-30\",\"startsAt\":\"2026-09-30T17:40:00+01:00\",\"endsAt\":\"2026-09-30T19:36:00+01:00\",\"filmStartsAt\":\"2026-09-30T18:05:00+01:00\",\"filmEndsAt\":\"2026-09-30T19:36:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM1-3-12\",\"filmId\":\"HO00007220\",\"siteId\":\"WIM1\",\"screenId\":\"WIM1-3\",\"areaCategories\":[{\"areaCategoryId\":\"WIM1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"WIM1\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4203987121582,\"longitude\":-0.20550000667572},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"WIM1@curzon.com\",\"address\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007220\",\"title\":{\"text\":\"Curzon Film 50: Enemy\",\"translations\":[]},\"synopsis\":{\"text\":\"Directed by Denis Villenueve (Prisoners) and starring Oscar-nominee Jake Gyllenhaal (Nightcrawler, Source Code), Enemy is a mesmerising psychological thriller based on the novel ‘The Double’ by Nobel laureate José Saramago.\\n\\nJake Gyllenhaal plays Adam, a university lecturer nearing the end of his relationship with girlfriend Mary (Mélanie Laurent). One night, while watching a film, Adam spots a minor actor who looks just like him. Consumed by the desire to meet his double, Adam tracks down the actor and engages him in a complex and dangerous struggle…\\n\\nDark, gripping and pulsating with atmosphere, Enemy is a haunting and provocative psychosexual thriller that has drawn comparisons to both Lynch and Cronenberg.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"One night, while watching a film, Adam spots a minor actor who looks just like him. Consumed by the desire to meet his double, Adam tracks down the actor.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong sex, strong language\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":91,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=xgpHZ7cjUfU\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=xgpHZ7cjUfU\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001699\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000004180\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004970\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006873\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000154\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000798\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000799\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000004180\"},{\"castAndCrewMemberId\":\"0000004970\"},{\"castAndCrewMemberId\":\"HO00000154\"},{\"castAndCrewMemberId\":\"HO00000798\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000001699\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000006873\"},{\"castAndCrewMemberId\":\"HO00000799\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007220\",\"hoCode\":\"A000008885\",\"eventId\":\"0000000068\",\"distributorName\":\"Curzon\"}],\"castAndCrew\":[{\"id\":\"0000001699\",\"name\":{\"givenName\":\"Denis\",\"familyName\":\"Villeneuve\",\"middleName\":null}},{\"id\":\"0000004180\",\"name\":{\"givenName\":\"Sarah\",\"familyName\":\"Gadon\",\"middleName\":null}},{\"id\":\"0000004970\",\"name\":{\"givenName\":\"Isabella \",\"familyName\":\"Rossellini\",\"middleName\":null}},{\"id\":\"0000006873\",\"name\":{\"give