          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2027-03-23\",\"showtimes\":[{\"id\":\"WIM1-58336\",\"schedule\":{\"businessDate\":\"2027-03-23\",\"startsAt\":\"2027-03-23T19:15:00+00:00\",\"endsAt\":\"2027-03-23T22:30:00+00:00\",\"filmStartsAt\":\"2027-03-23T19:40:00+00:00\",\"filmEndsAt\":\"2027-03-23T22:30:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"WIM1-1-10\",\"filmId\":\"HO00007127\",\"siteId\":\"WIM1\",\"screenId\":\"WIM1-1\",\"areaCategories\":[{\"areaCategoryId\":\"WIM1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000042\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"WIM1\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4203987121582,\"longitude\":-0.20550000667572},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"WIM1@curzon.com\",\"address\":{\"line1\":\"23 The Broadway,\",\"line2\":\"London,\",\"city\":\"SW19 1RE\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007127\",\"title\":{\"text\":\"RBO 2026-27: Alice's Adventures in Wonderland\",\"translations\":[]},\"synopsis\":{\"text\":\"At a garden party on a sunny afternoon, Alice is surprised to see her parents’ friend Lewis Carroll transform into a white rabbit. When she follows him down a rabbit hole, events become curiouser and curiouser…As Alice journeys through Wonderland, she encounters countless strange creatures. She’s swept off her feet by the charming Knave of Hearts, who’s on the run for stealing the tarts. Confusion piles upon confusion. Then Alice wakes with a start. Was it all a daydream? \\nChristopher Wheeldon’s Alice’s Adventures in Wonderland burst onto the stage in 2011 in an explosion of colour, stage magic and inventive, sophisticated choreography. Joby Talbot’s score combines contemporary soundworlds with sweeping melodies that gesture to ballet scores of the 19th century. Bob Crowley’s wildly imaginative, eye-popping designs draw on everything from puppetry to projections to make Wonderland wonderfully real. The result shows The Royal Ballet at its best, bringing together world-class dance with enchanting family entertainment and ingenious music and design.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"At a garden party on a sunny afternoon, Alice is surprised to see her parents’ friend Lewis Carroll transform into a white rabbit.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2027-03-23\",\"runtimeInMinutes\":170,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001507\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011529\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011530\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3642\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000290\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000293\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000748\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000749\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001507\"},{\"castAndCrewMemberId\":\"0000011529\"},{\"castAndCrewMemberId\":\"0000011530\"},{\"castAndCrewMemberId\":\"3642\"},{\"castAndCrewMemberId\":\"HO00000290\"},{\"castAndCrewMemberId\":\"HO00000293\"},{\"castAndCrewMemberId\":\"HO00000748\"},{\"castAndCrewMemberId\":\"HO00000749\"}],\"directors\":[],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b7823ec2-abd4-49b8-876f-6a43fd49ccb0\",\"corporateId\":null},\"hopk\":\"HO00007127\",\"hoCode\":\"A000008778\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000001507\",\"name\":{\"givenName\":\"Lauren \",\"familyName\":\"Cuthbertson\",\"middleName\":null}},{\"id\":\"0000011529\",\"name\":{\"givenName\":\"Bennet\",\"familyName\":\"Gartside\",\"middleName\":null}},{\"id\":\"0000011530\",\"name\":{\"givenName\":\"James\",\"familyName\":\"Hay\",\"middleName\":null}},{\"id\":\"3642\",\"name\":{\"givenName\":\"Gary\",\"familyName\":\"Avis\",\"middleName\":null}},{\"id\":\"HO00000290\",\"name\":{\"givenName\":\"William\",\"familyName\":\"Bracewell\",\"middleName\":null}},{\"id\":\"HO00000293\",\"name\":{\"givenName\":\"Francesca\",\"familyName\":\"Hayward\",\"middleName\":null}},{\"id\":\"HO00000748\",\"name\":{\"givenName\":\"Steven\",\"familyName\":\"McRae\",\"middleName\":null}},{\"id\":\"HO00000749\",\"name\":{\"givenName\":\"Nicol\",\"familyName\":\"Edmonds\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000010\",\"name\":{\"text\":\"Satellite Event\",\"translations\":[]},\"shortName\":{\"text\":\"Sat event\",\"translations\":[]},\"description\":{\"text\":\"Live Via Satellite\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"WIM1-1\",\"name\":{\"text\":\"Screen One\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000042\",\"name\":{\"text\":\"Royal Ballet and Opera\",\"translations\":[]},\"shortName\":{\"text\":\"RB&O\",\"translations\":[]},\"description\":{\"text\":\"The Royal Ballet and Opera brings the thrill of world-class theatre to cinema screens right around the globe. \\n\\nWith productions across both Companies, the programme includes beloved classics as well as new productions.\\n\\nOffering audiences a view from the best seat in the house, the programme shares the joy of live performance, and the beauty of world-class art with cinemagoers in more than 1,500 cinemas and 50 countries around the world.\\n\",\"translations\":[]},\"schedule\":{\"startDate\":\"2025-01-01\",\"endDate\":\"2027-12-31\"},\"siteIds\":[\"ALD1\",\"BLO1\",\"CAM1\",\"CAN2\",\"COL1\",\"HOX1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SOH1\",\"VIC1\",\"WIM1\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"WIM1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
