\"lazy\">\n\t\t</picture>\n\t</div>\n\n\t<noscript><img src=\"https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/Picasso_The_Three_Dancers.max-500x500.jpg\" alt=\"\" /></noscript>\n\n\n            \n        </div>\n    </div>\n    \n    \n\n    <div class=\"card-content\">\n        \n        \n                <div class=\"card-content__inner\">\n\n                    \n                        <div class=\"card-tags\">\n                            \n                                <span>Exhibition</span>\n                            \n                            \n                            \n                        </div>\n                    \n\n                    <h2 class=\"card__title\">\n                        <span class=\"card__title--maintitle\">Theatre Picasso</span>\n                    </h2>\n\n                    \n                    \n                </div>\n        \n    \n    \n        <div class=\"card-icons\">\n            <div class=\"event-info event-info__venue\">\n                <div class=\"event-icon\">\n                    <i class=\"icon--location\"></i>\n                </div>\n                <span>Tate Modern</span>\n            </div>\n\n            <div class=\"event-info event-info__date\">\n                <div class=\"event-icon\">\n                    <i class=\"icon--calendar\"></i>\n                </div>\n                <span>Until 12 Apr 2026</span>\n            </div>\n            \n                <div class=\"event-info event-info__price\">\n                    <!--\n                    <div class=\"event-icon\">    \n                        <i class=\"icon--ticket\"></i>\n                    </div>\n                    \n                    <span> \n                            £15 / Free for Members \n                        </span>-->\n                </div> \n                               \n        </div>\n    \n    </div>\n    \n\n    \n    \n    </a>\n</div>\n\n    </div>\n\n\n        \n    </div>\n</div>\n\n                                        </div>\n                                    \n                                </div>\n                            </div>\n                        </form>\n                    </div>\n\n                    <div class=\"header-nav__item header-nav__join\">\n                        <a href=\"https://shop.tate.org.uk/membership\" class=\"btn btn--type__no-bg btn--size__small btn--style__text\" data-gtm-name=\"Navigation-header\" aria-label=\"Tate Join\">\n                            <span class=\"btn__text\">Become a Member</span>\n                        </a>\n                    </div>\n\n\n                </div>\n                \n                \n\n                \n            </div>\n\n        </div>\n    </header>\n    \n\n    <script>if(typeof(window.tatePopulateBasket)!=='undefined')window.tatePopulateBasket();</script>\n    \n\n    \n\n    \n    \n\n    <main id=\"content\" itemscope=\"\" itemtype=\"https://schema.org/WebPage\" class=\"container-16 \">\n        \n<article class=\"event event--film\">\n    \n\n\n\n\n<header class=\"content-header splash-header  splash-header--with-cta\">\n    <div class=\"container\">\n        <div class=\"container__inner\">\n            \n            \n            \n            \n\n\n            <div class=\"splash-main\">\n                <div class=\"splash-header__primary-info\">\n\n                    \n                        <span class=\"splash-header__status\">Now booking</span>\n                    \n\n\n                    \n                        <span class=\"splash-header__venue\" itemprop=\"location\">Tate Britain</span>\n                    \n\n                    \n                        <span class=\"splash-header__type\">Film</span>\n                    \n\n                    <h1 class=\"splash-header__fulltitle\" itemprop=\"name\">\n                        \n                            <span class=\"splash-header__surtitle\">Members Screening</span>\n                        \n                            <span class=\"\">Exhibition on Screen: Turner & Constable</span>\n                        \n                    </h1>\n\n                    \n                    \n\n                    \n\n                    \n\n                    \n\n                    <div class=\"splash-header__footer\">\n                        <div>\n                            \n                                \n                                    <span class=\"splash-header__dates\">28 February 2026 at 14.00–16.00</span>\n                                \n                            \n\n                            \n                              <p>Free with ticket for Members</p>\n                            \n\n\n                        </div>\n\n                        \n                        \n                        <div class=\"btn-group splash-header__action-buttons\">\n                            <div class=\"btn-row\">\n                                \n                                <a href=\"https://shop.tate.org.uk/ticket/date?cgid=375048\" class=\"btn btn--type__primary btn--size__xl btn--shape__circle btn--style__text\">\n                                    <i class=\"btn__icon\"></i>\n                                    \n                                    <span class=\"btn__text\">Book tickets</span>\n                                    \n                                </a>\n                                \n                                \n                                <a href=\"https://shop.tate.org.uk/membership\" class=\"btn btn--type__secondary btn--size__xl btn--shape__circle btn--style__text\">\n                                    <i class=\"btn__icon\"></i>\n                                    <span class=\"btn__text\">Become a Member</span>\n                                </a>\n                                \n                            </div>\n                        </div>\n                        \n\n                    </div>\n\n                </div>\n                <div class=\"splash-header__media\">\n                    <div class=\"splash-header__media--inner responsive-container\">\n                        \n                            \n\n\n    \n    <picture\n        >\n        <source srcset=\"\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/Turner_Constable_exhibition_on_screen.width-420.jpg 420w,\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/Turner_Constable_exhibition_on_screen.width-540.jpg 540w,\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/Turner_Constable_exhibition_on_screen.width-840.jpg 840w,\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/Turner_Constable_exhibition_on_screen.width-1200.jpg 1200w,\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/Turner_Constable_exhibition_on_screen.width-1440.jpg 1440w,\n            \"\n        sizes=\"\n            (max-width: 479px) 420px,\n            (max-width: 600px) 540px,\n            (max-width: 1023px) 840px,\n            (max-width: 1440px) 1200px,\n            1440px,\n            \"\n        >\n        <img\n            alt=\"A film camera set up in front of a cottage and a lake\"\n            src=\"https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/Turner_Constable_exhibition_on_screen.width-420.jpg\"\n            loading=\"lazy\"\n            width=\"420\"\n            height=\"315\"\n            \n            \n        >\n    </picture>\n\n    \n\n    \n\n\n\n                        \n                    </div>\n                </div>\n            </div>\n            \n                <div class=\"splash-header__image-caption\">\n                    <p data-block-key=\"m0y2z\">Image courtesy of Exhibition on Screen</p>\n                </div>\n            \n        </div>\n    </div>\n</header>\n\n\n\n    <section class=\"content-main\">\n\n        <div class=\"container container--primary-content\">\n            <div class=\"container__inner\">\n                <div class=\"grid-outer\">\n                    <div class=\"grid-col--66\">\n                        \n                        <div class=\"content__standfirst\"><p data-block-key=\"q5pq9\">Join us for the premiere of <i>Exhibition on Screen: Turner &amp; Constable</i></p></div>\n\n                        \n\n\n                        <div class=\"content__body-text\" itemprop=\"mainContentOfPage\">\n\n                            \n                            \n                                    \n<div class=\"event-outer\n    container\">\n    <div class=\"event-inner\n        container__inner\">\n        <div class=\"block-rich_text\"><p data-block-key=\"jmmr9\">Two of Britain’s greatest painters, <a href=\"https://www.tate.org.uk/art/artists/joseph-mallord-william-turner-558\">J.M.W. Turner</a> and <a href=\"https://www.tate.org.uk/art/artists/john-constable-108\">John Constable</a> were also the greatest of rivals. Born within a year of each other, both used landscape painting to reflect the changing world around them. Constable represents the very best of pastoral nostalgia; Turner, an exciting new way of depicting emotion through landscape. Critics of the time compared their starkly different styles to a clash of ‘fire and water’.</p><p data-block-key=\"fjlqh\">Now, these two greats are reuniting at Tate Britain, and Exhibition on Screen has exclusive access to bring the <a href=\"https://www.tate.org.uk/whats-on/tate-britain/turner-and-constable\">groundbreaking exhibition</a> and the remarkable stories behind the art to the big screen. Don’t miss this opportunity to see these astonishing artists side-by-side, as they so often were in life, on the big screen for the first time.</p><p data-block-key=\"cqpj8\">A special Q&amp;A session with the director, producer and key interviewees will follow the screening.</p></div>\n<div class=\"block-accordion\">\n<div class=\"accordion__container\" data-accordion>\n    <div class=\"accordion\">\n        \n            \n<div class=\"accordion__item\">\n    <h2 id=\"accessibility\" class=\"accordion__header\">\n        <button\n            id=\"h.accessibility-9eSVH\"\n            class=\"accordion__button\"\n            data-accordion-question\n            aria-controls=\"c.accessibility-9eSVH\"\n            aria-expanded=\"false\">\n            \n            <span class=\"accordion__title\">\n                Accessibility\n            </span>\n        </button>\n    </h2>\n    <div\n        id=\"c.accessibility-9eSVH\"\n        data-accordion-answer\n        class=\"accordion__content\"\n        aria-labelledby=\"h.accessibility-9eSVH\">\n        <div class=\"block-rich_text\"><p data-block-key=\"vr94f\">Tate Britain's step-free entrance is on Atterbury Street. It has automatic sliding doors and there is a ramp down to the entrance with central handrails.</p><p data-block-key=\"eol4d\">The Exhibition is on the Lower floor of the gallery.</p><ul><li data-block-key=\"6f4a1\">Accessible, standard and Changing Places toilets are located on the Lower floor.</li><li data-block-key=\"3non5\">Ear defenders can be borrowed from the ticket desk on the Lower floor.</li></ul><p data-block-key=\"ftget\">To help plan your visit to Tate Britain, have a look at our <a href=\"https://www.tate.org.uk/visit/tate-britain/visual-story\">visual story</a>. It includes photographs and information about what you can expect from a visit to the gallery.</p><p data-block-key=\"9q45o\"><a href=\"https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/galleries/TB_map.pdf\">Download Tate Britain map</a></p><p data-block-key=\"4sg9o\">For more information before your visit:</p><ul><li data-block-key=\"dfguk\">Email <a href=\"mailto:hello@tate.org.uk\">hello@tate.org.uk</a></li><li data-block-key=\"c59r2\">Call +44 (0)20 7887 8888 (daily 10.00–17.00)</li></ul><p data-block-key=\"3efp0\"><a href=\"https://www.tate.org.uk/visit/tate-britain#accessibility\">Check all Tate Britain accessibility information</a></p></div>\n    </div>\n</div>\n\n        \n    </div>\n</div>\n</div>\n        \n    </div>\n</div>\n\n                            \n\n                        </div>\n\n                    </div>\n                    <div class=\"grid-col--33\">\n                        \n                        <div class=\"content-block content-block--location venue-block\">\n\n                            \n                                <h2 class=\"content-block__title\">Tate Britain</h2>\n                                <div class=\"location\">\n                                    \n                                        <p class=\"venue__title\"><a href=\"/visit/tate-britain/clore-auditorium\" class=\"text-link\">The Clore Auditorium</a></p>\n                                    \n                                    \n                                    <span class=\"location__row\">Millbank</span><br /><span class=\"location__row\">London SW1P 4RG</span><br />\n                                    \n    \t                            <a href=\"https://www.tate.org.uk/visit/tate-britain\" class=\"location__link text-link\">Plan your visit</a>\n                                    \n                                </div>\n                            \n                        </div>\n                        \n                        \n                        <div class=\"content-block content-block--dates\">\n\n                            <h2 class=\"content-block__title\">Date &amp; Time</h2>\n\n                                \n\n                                    \n                                        <p class=\"content-block--dates__item\">28 February 2026 at 14.00–16.00</p>\n                                    \n\n                                \n\n                            \n                        </div>\n                        \n\n                        \n\n                            <div class=\"content-block content-block--price\">\n                                \n                                    <h2 class=\"content-block__title\">Pricing</h2>\n                                \n                                \n\n                                    \n                                    <p><span class=\"price\">Free with ticket for Members</span></p>\n                                    \n\n                                    \n\n                                    \n\n                                        <div class=\"btn-row\">\n                                            \n                                            <a href=\"https://shop.tate.org.uk/ticket/date?cgid=375048\" class=\"btn btn--type__primary btn--style__text\">\n                                                <i class=\"btn__icon\"></i>\n                                                \n                                                <span class=\"btn__text\">Book tickets</span>\n                                                \n                                            </a>\n                                            \n                                            \n                                                <a href=\"https://shop.tate.org.uk/membership\" class=\"btn btn--type__secondary btn--style__text\">\n                                                    <i class=\"btn__icon\"></i>\n                                                    <span class=\"btn__text\">Become a Member</span>\n                                                </a>\n                                            \n                                        </div>\n\n                                    \n\n                                \n                            </div>\n                        \n\n                        \n\n                        \n                    </div>\n                <