\ttype=\"image/jpeg\"\n\t\t\t>\n\t\t\t\n\t\t\t<img alt=\"\"\n\t\t\t\tsrc=\"/static/images/placeholder/placeholder-4x3.b312143b17e7.gif\"\n\t\t\t\tloading=\"lazy\">\n\t\t</picture>\n\t</div>\n\n\t<noscript><img src=\"https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/Hawksbill_Bay_2020__Hurvin_Anderson._Courtes.max-500x500.jpg\" alt=\"\" /></noscript>\n\n\n            \n        </div>\n    </div>\n    \n    \n\n    <div class=\"card-content\">\n        \n        \n                <div class=\"card-content__inner\">\n\n                    \n                        <div class=\"card-tags\">\n                            \n                                <span>Exhibition</span>\n                            \n                            \n                            \n                        </div>\n                    \n\n                    <h2 class=\"card__title\">\n                        <span class=\"card__title--maintitle\">Hurvin Anderson</span>\n                    </h2>\n\n                    \n                    \n                </div>\n        \n    \n    \n        <div class=\"card-icons\">\n            <div class=\"event-info event-info__venue\">\n                <div class=\"event-icon\">\n                    <i class=\"icon--location\"></i>\n                </div>\n                <span>Tate Britain</span>\n            </div>\n\n            <div class=\"event-info event-info__date\">\n                <div class=\"event-icon\">\n                    <i class=\"icon--calendar\"></i>\n                </div>\n                <span>Until 23 Aug 2026</span>\n            </div>\n            \n                <div class=\"event-info event-info__price\">\n                    <div class=\"event-icon\">\n                        <i class=\"icon--ticket\"></i>\n                    </div>\n                    <span> FREE FOR MEMBERS</span>\n                </div> \n            \n        </div>\n    \n    </div>\n    \n\n    \n    \n    </a>\n</div>\n\n    </div>\n\n\n        \n    </div>\n</div>\n\n                                        </div>\n                                    \n                                </div>\n                            </div>\n                        </form>\n                    </div>\n\n                    <div class=\"header-nav__item header-nav__join\">\n                        <a href=\"https://shop.tate.org.uk/membership\" class=\"btn btn--type__no-bg btn--size__small btn--style__text\" data-gtm-name=\"Navigation-header\">\n                            <span class=\"btn__text\">Become a Member</span>\n                        </a>\n                    </div>\n\n\n                </div>\n                \n                \n\n                \n            </div>\n\n        </div>\n    </header>\n    \n\n    \n    \n\n\n\n\n\n    <script>if(typeof(window.tatePopulateBasket)!=='undefined')window.tatePopulateBasket();</script>\n    \n\n    \n\n    <main id=\"content\" itemscope=\"\" itemtype=\"https://schema.org/WebPage\" class=\"container-16 \">\n        \n<article class=\"event event--film\">\n    \n\n\n\n\n<header class=\"content-header splash-header  splash-header--with-cta\">\n    <div class=\"container\">\n        <div class=\"container__inner\">\n            \n            \n            \n            \n\n\n            <div class=\"splash-main\">\n                <div class=\"splash-header__primary-info\">\n\n                    \n                        <span class=\"splash-header__status\">Now booking</span>\n                    \n\n\n                    \n                        <span class=\"splash-header__venue\" itemprop=\"location\">Tate Britain</span>\n                    \n\n                    \n                        <span class=\"splash-header__type\">Film</span>\n                    \n\n                    <h1 class=\"splash-header__fulltitle\" itemprop=\"name\">\n                        \n                            <span class=\"\">African Cinema Speaks: Screenings and Seminar</span>\n                        \n                    </h1>\n\n                    \n                    \n\n                    \n\n                    \n\n                    \n\n                    <div class=\"splash-header__footer\">\n                        <div>\n                            \n                                \n                                    <span class=\"splash-header__dates\">12 September 2026 at 10.30–17.30</span>\n                                \n                            \n\n                            \n\n\n                        </div>\n\n                        \n                        \n                        <div class=\"btn-group splash-header__action-buttons\">\n                            <div class=\"btn-row\">\n                                \n                                <a href=\"https://shop.tate.org.uk/ticket/date?cgid=394558\" class=\"btn btn--type__primary btn--size__xl btn--shape__circle btn--style__text\">\n                                    <i class=\"btn__icon\"></i>\n                                    \n                                    <span class=\"btn__text\">Book tickets</span>\n                                    \n                                </a>\n                                \n                                \n                            </div>\n                        </div>\n                        \n\n                    </div>\n\n                </div>\n                <div class=\"splash-header__media\">\n                    <div class=\"splash-header__media--inner responsive-container\">\n                        \n                            \n\n\n    \n    <picture\n        >\n        <source srcset=\"\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/image-03.width-420.jpg 420w,\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/image-03.width-540.jpg 540w,\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/image-03.width-840.jpg 768w,\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/image-03.width-1200.jpg 768w,\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/image-03.width-1440.jpg 768w,\n            \"\n        sizes=\"\n            (max-width: 479px) 420px,\n            (max-width: 600px) 540px,\n            (max-width: 1023px) 840px,\n            (max-width: 1440px) 1200px,\n            1440px,\n            \"\n        >\n        <img\n            alt=\"\"\n            src=\"https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/image-03.width-420.jpg\"\n            loading=\"lazy\"\n            width=\"420\"\n            height=\"315\"\n            \n            \n        >\n    </picture>\n\n    \n\n    \n\n\n\n                        \n                    </div>\n                </div>\n            </div>\n            \n                <div class=\"splash-header__image-caption\">\n                    <p data-block-key=\"dkdh8\">Film Still from <i>Mouna: The Dream of an Artist</i>, Henri Duparc, 1969 (Guinea) Courtesy of the French Institute</p>\n                </div>\n            \n        </div>\n    </div>\n</header>\n\n\n\n    <section class=\"content-main\">\n\n        <div class=\"container container--primary-content\">\n            <div class=\"container__inner\">\n                <div class=\"grid-outer\">\n                    <div class=\"grid-col--66\">\n                        \n                        <div class=\"content__standfirst\"><p data-block-key=\"pxkzp\">Experience the unmissable chance to hear leading voices in African cinema and watch films unseen in the UK</p></div>\n\n                        \n\n\n                        <div class=\"content__body-text\" itemprop=\"mainContentOfPage\">\n\n                            \n                            \n                                    \n<div class=\"event-outer\n    container\">\n    <div class=\"event-inner\n        container__inner\">\n        <div class=\"block-rich_text\"><p data-block-key=\"a5gae\">Join artist <a href=\"https://www.tate.org.uk/art/artists/zineb-sedira-4956\">Zineb Sedira</a> alongside African film specialists Roisin Tapponi and Abiba Coulibaly for a rare screening and discussion of seven short African films from the 1960s and early 1970s.</p><p data-block-key=\"dg6ik\">These films emerged during a period when many African nations gained independence from European colonial rule. Activist filmmakers turned to cinema as a powerful way to share political ideas and visions for the future.</p><p data-block-key=\"brtva\">All films will have English subtitles.</p><p data-block-key=\"7b2ik\"><i>With kind support from the Cinémathèque Afrique, Paris, and the Film University Babelsberg KONRAD WOLF.</i></p></div>\n<div class=\"block-accordion\">\n<div class=\"accordion__container\" data-accordion>\n    <div class=\"accordion\">\n        \n            \n<div class=\"accordion__item\">\n    <h2 id=\"programme\" class=\"accordion__header\">\n        <button\n            id=\"h.programme-akxvg\"\n            class=\"accordion__button\"\n            data-accordion-question\n            aria-controls=\"c.programme-akxvg\"\n            aria-expanded=\"false\">\n            \n            <span class=\"accordion__title\">\n                Programme\n            </span>\n        </button>\n    </h2>\n    <div\n        id=\"c.programme-akxvg\"\n        data-accordion-answer\n        class=\"accordion__content\"\n        aria-labelledby=\"h.programme-akxvg\">\n        <div class=\"block-rich_text\"><p data-block-key=\"1aeoj\">10:30 Event starts</p><p data-block-key=\"3m496\">Screenings - 2hrs and 33 min including 2 x 5 min comfort breaks:</p><ol><li data-block-key=\"baghf\"><i>Mouna ou le rêve d’un artiste</i>, Henri Duparc, 1969 (Guinée) - 55 min</li><li data-block-key=\"8ku43\"><i>À nous deux, France</i>, Désiré Ecaré, 1970 (Côte d’Ivoire) - 60 min</li><li data-block-key=\"2ofgv\"><i>Kaka Yo</i>, Sébastien Kamba, 1966 (République du Congo) - 28 min</li></ol><p data-block-key=\"a5ann\">Discussion and Q&amp;A</p><p data-block-key=\"8s1n5\">13:35-14:20 Lunch break and time to visit commission</p><p data-block-key=\"4277t\">14:20 Welcome back</p><p data-block-key=\"27hi8\">14:25-16:25 Screenings – 2 hours including 2 x 5 min comfort breaks:</p><ol><li data-block-key=\"8gar6\"><i>Die Frage</i>, Mr Ali-Yahia (Algeria) – 16 mins</li><li data-block-key=\"cv9dd\"><i>Nationalité: immigré</i>, Sydney Sokhona, 1976 (Mauritanie) – 70 min</li><li data-block-key=\"53v18\"><i>Afrique sur Seine</i>, Paulin S. Vieyra, 1955 (Sénégal) – 21 min</li></ol><p data-block-key=\"23q91\">Discussion and Q&amp;A</p><p data-block-key=\"126sm\">17:30 Finish</p></div>\n    </div>\n</div>\n\n        \n            \n<div class=\"accordion__item\">\n    <h2 id=\"accessibility\" class=\"accordion__header\">\n        <button\n            id=\"h.accessibility-W3GoE\"\n            class=\"accordion__button\"\n            data-accordion-question\n            aria-controls=\"c.accessibility-W3GoE\"\n            aria-expanded=\"false\">\n            \n            <span class=\"accordion__title\">\n                Accessibility\n            </span>\n        </button>\n    </h2>\n    <div\n        id=\"c.accessibility-W3GoE\"\n        data-accordion-answer\n        class=\"accordion__content\"\n        aria-labelledby=\"h.accessibility-W3GoE\">\n        <div class=\"block-rich_text\"><p data-block-key=\"7om63\">Tate Britain's step-free entrance is on Atterbury Street. It has automatic sliding doors and there is a ramp down to the entrance with central handrails.</p><ul><li data-block-key=\"1fvpd\">Accessible, standard and Changing Places toilets are located on the Lower floor.</li><li data-block-key=\"47omt\">Ear defenders can be borrowed from the ticket desk on the Lower floor.</li></ul><p data-block-key=\"4nifc\">The exhibition is on the Upper Floor of the gallery.</p><p data-block-key=\"9r4ih\">To help plan your visit to Tate Britain, have a look at our <a href=\"https://www.tate.org.uk/visit/tate-britain/visual-story\">visual story</a>. It includes photographs and information about what you can expect from a visit to the gallery.</p><p data-block-key=\"2eo2t\"><a href=\"https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/galleries/TB_map.pdf\">Download Tate Britain map</a></p><p data-block-key=\"9v18c\">For more information before your visit:</p><ul><li data-block-key=\"eoptl\">Email <a href=\"mailto:hello@tate.org.uk\">hello@tate.org.uk</a></li><li data-block-key=\"adlmh\">Call +44 (0)20 7887 8888 (daily 10.00–17.00)</li></ul><p data-block-key=\"898hg\"><a href=\"https://www.tate.org.uk/visit/tate-britain#accessibility\">Check all Tate Britain accessibility information</a></p></div>\n    </div>\n</div>\n\n        \n    </div>\n</div>\n</div>\n        \n    </div>\n</div>\n\n                            \n\n                        </div>\n\n                    </div>\n                    <div class=\"grid-col--33\">\n                        \n                        <div class=\"content-block content-block--location venue-block\">\n\n                            \n                                <h2 class=\"content-block__title\">Tate Britain</h2>\n                                <div class=\"location\">\n                                    \n                                        <p class=\"venue__title\"><a href=\"/visit/tate-britain/clore-auditorium\" class=\"text-link\">The Clore Auditorium</a></p>\n                                    \n                                    \n                                    <span class=\"location__row\">Millbank</span><br /><span class=\"location__row\">London SW1P 4RG</span><br />\n                                    \n    \t                            <a href=\"https://www.tate.org.uk/visit/tate-britain\" class=\"location__link text-link\">Plan your visit</a>\n                                    \n                                </div>\n                            \n                        </div>\n                        \n                        \n                        <div class=\"content-block content-block--dates\">\n\n                            <h2 class=\"content-block__title\">Date &amp; Time</h2>\n\n                                \n\n                                    \n                                        <p class=\"content-block--dates__item\">12 September 2026 at 10.30–17.30</p>\n                                    \n\n                                \n\n                            \n                        </div>\n                        \n\n                        \n\n                            <div class=\"content-block content-block--price\">\n                                \n                                    <h2 class=\"content-block__title\">Pricing</h2>\n                                \n                                \n\n                                    \n                                    <p><span class=\"price\">£18</span></p>\n                                    \n\n                                    <p data-block-key=\"tie2c\">£15 Concessions</p><p data-block-key=\"3bcl1\">£5 for <a href=\"https://www.tate.org.uk/tate-collective\">Tate Collective</a>. 16–25? Sign up and <a href=\"https://shop.tate.org.uk/login\">log in</a> to book</p>\n\n                                    \n\n                                        <div class=\"btn-row\">\n                                            \n                                            <a href=\"https://shop.tate.org.uk/ticket/date?cgid=394558\" class=\"btn btn--type__primary btn--style__text\">\n                                                <i class=\"btn__icon\"></i>\n                                                \n                                                <span class=\"btn__text\">Book tickets</span>\n                                                \n                                            </a>\n                                            \n                                            \n                                        </div>\n\n                                    \n\n                                \n                            </div>\n                        \n\n                        \n                            \n                                \n<div class=\"content__info-extra info_extra_red\">\n    \n    <div>\n        <p data-block-key=\"zsfuj\">Content guidance: references to racial discrimination, slurs, stereotypes, violence, death and non-explicit references to torture and rape.</p>\n        \n    </div>\n</div>\n                            \n                        \n\n                        \n                        <div class=\"content-block content-block--partner partner-block\">\n    \n    \n    <div class=\"partner-group\">\n        <h2 class=\"content-block__title\">Supported by</h2>\n        \n        \n\n\n\n<div class=\"partner\">\n    <div class=\"partner__inner responsive-container\">\n        \n        \n            <div class=\"partner__content\">\n                \n                    <h3 class=\"partner__title\">\n                        \n                            Cinémathèque Afrique Paris\n                        \n                    </h3>\n                \n                \n            </div>\n        \n    </div>\n</div>\n\n        \n        \n\n\n\n<div class=\"partner\">\n    <div class=\"partner__inner responsive-container\">\n        \n        \n            <div class=\"partner__content\">\n                \n                    <h3 class=\"partner__title\">\n                        \n                            Film University Babelsberg KONRAD WOLF\n                        \n                    </h3>\n                \n                \n            </div>\n        \n    </div>\n</div>\n\n        \n    </div>\n    \n    \n</div>\n\n                        \n                    </div>\n                </div>\n            </div>\n        </div>\n\n\n        \n\n        <div class=\"block-heading\"><div class=\"event-outercontainer\">\n    <div class=\"event-innercontainer__inner\">\n        <h2 id=\"related-events\" class=\"section__title\">We recommend</h2>\n\n\n    </div>\n</div>\n</div>\n<div class=\"block-strip\">\n\n\n\n\n\n\n\n\n<div class=\"article-strip container \">\n    <div class=\"article-strip__content container__inner\">\n\n        \n            \n            \n        \n\n        \n            <div class=\"card-group card--carousel\">\n                \n                    \n                        <div class=\"carousel__button-group\">\n                            <button class=\"carousel--left btn btn--style__icon\" data-gtm-name=\"Carousel-left\">\n                                <i class=\"btn__icon icon--arrow-left\"></i>\n                                <span class=\"btn__text\">Left</span>\n                            </button>\n                            <button class=\"carousel--right btn btn--style__icon\" data-gtm-name=\"Carousel-right\">\n                                <i class=\"btn__icon icon--arrow-right\"></i>\n                                <span class=\"btn__text\">Right</span>\n                            </button>\n                        </div>\n                    \n                                \n\n                \n                   <div class=\"card-list cards card-list--type__portrait card-list--type__carousel  card-list--3col\">\n                        \n                        \n                            \n                                    \n                                    \n                                        \n                                            \n\n\n\n\n\n\n    \n     <div class=\"card card--event  \"  tabindex=\"-1\">\n\n\n\n    \n    \n    \n\n    \n    \n    \n    <a href=\"https://www.tate.org.