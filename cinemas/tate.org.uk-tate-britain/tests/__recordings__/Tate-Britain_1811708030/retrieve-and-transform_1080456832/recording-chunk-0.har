\n\n        \n        <div class=\"card-list card-list--4col card-list--type__image-canvas\"\n             data-current-page=\"1\" data-page-size=\"20\"\n             data-total-results=\"1\" data-page-count=\"1\">\n\n    \n\n\n\n    \n    \n        \n            \n    <div class=\"card\">\n        \n\n\n\n\n\n\n\n\n\n<div class=\"card__inner\">\n  \n  <a href=\"/whats-on/tate-britain/zineb-sedira/african-cinema-speaks-screenings-and-seminar\" aria-label=\"African Cinema Speaks: Screenings and Seminar\" data-gtm-name=\"card_link_title\" data-gtm-destination=\"\">\n    \n\n    <div class=\"card-media card-media--image\">\n        <div class=\"card-media__inner responsive-container\">\n            \n                \n\n\t<div class=\"\">\n\t\t<picture>\n\t\t\t<source srcset=\"\n\t\t\t\t\n\t\t\t\t\thttps://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/image-03.max-500x500.jpg    500w,\n\t\t\t\t\t\n\t\t\t\t\n\t\t\t\"\n\t\t\tsizes=\"\n\t\t\t\t\n\t\t\t\t\t500px \n\t\t\t\t\t\n\t\t\t\t\n\t\t\t\"\n\t\t\ttype=\"image/jpeg\"\n\t\t\t>\n\t\t\t\n\t\t\t<img alt=\"\"\n\t\t\t\tsrc=\"/static/images/placeholder/placeholder-4x3.b312143b17e7.gif\"\n\t\t\t\tloading=\"lazy\">\n\t\t</picture>\n\t</div>\n\n\t<noscript><img src=\"https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/image-03.max-500x500.jpg\" alt=\"\" /></noscript>\n\n\n            \n        </div>\n    </div>\n    \n    \n\n    <div class=\"card-content\">\n        \n        \n                <div class=\"card-content__inner\">\n\n                    \n                        <div class=\"card-tags\">\n                            \n                                <span>Film</span>\n                            \n                            \n                            \n                        </div>\n                    \n\n                    <h2 class=\"card__title\">\n                        <span class=\"card__title--maintitle\">African Cinema Speaks: Screenings and Seminar</span>\n                    </h2>\n\n                    \n                                            \n                            <div class=\"card__description\"><p data-block-key=\"pxkzp\">Experience the unmissable chance to hear leading voices in African cinema and watch films unseen in the UK</p></div>\n                        \n                                            \n                    \n                    \n                </div>\n        \n    \n    \n        <div class=\"card-icons\">\n            <div class=\"event-info event-info__venue\">\n                <div class=\"event-icon\">\n                    <i class=\"icon--location\"></i>\n                </div>\n                <span>Tate Britain</span>\n            </div>\n\n            <div class=\"event-info event-info__date\">\n                <div class=\"event-icon\">\n                    <i class=\"icon--calendar\"></i>\n                </div>\n                <span>12 Sep 2026</span>\n            </div>\n            \n        </div>\n    \n    </div>\n    \n\n    \n    \n    </a>\n</div>\n\n    </div>\n\n\n        \n    \n\n\n\n\n\n    \n        </div>\n        \n    \n\n\n\n    </div>\n\n\n                            </div>\n                        </div>\n                    \n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<script src=\"/static/js/apps/DatePicker.6d204e0213fe.js\"></script>\n<script>\n    document.addEventListener(\"DOMContentLoaded\", function() {\n        const elements = document.querySelectorAll(\".featured-strip__cards, #whatson-results\");\n        elements.forEach(function(element) {\n            element.addEventListener(\"mousedown\", function(event) {\n                const link = event.target.closest(\"a\");\n                if(link && !event.target.parentElement.classList.contains(\"pager__item\")){\n                    if(event.button == 1 || event.button == 2)  {\n                        dataLayer.push({\n                           'link': link.getAttribute(\"href\").replace(\"https://www.tate.org.uk\", \"\"),\n                           'buttontype': 'card',\n                           'event': 'non_left_click'\n                         })\n                    }\n                }\n            });\n        });\n    });\n</script>\n\n\n          \n    </main>\n\n\n    <div id=\"Tate-lightbox\" class=\"TateUI-lightbox p-1\" role=\"dialog\" aria-labelledby=\"lightbox-title\" aria-describedby=\"lightbox-description\" tabindex=\"-1\">\n  <!-- Hidden focusable element at the beginning (to create a Focus Trap) -->\n  <div tabindex=\"0\" class=\"focus-trap-start\"></div>\n\n  <img class=\"bg-blur\" alt=\"Artwork\">\n  \n  <div class=\"container__inner relative\">\n\n    <div class=\"grid-container\">\n\n      \n      <div class=\"grid-item p-4 sm-12 md-12 lg-12 xl-12\">\n        <picture>\n            <source class=\"TateUI-lightbox__source\">\n            <img\n                class=\"TateUI-lightbox__image\"\n                loading=\"lazy\"\n            >\n        </picture>\n        <div class=\"TateUI-lightbox__caption\"></div>\n      </div>\n\n    </div>\n\n    <div class=\"absolute top-3 right-0 op-1\" tabindex=\"-1\">\n      <i tabindex=\"0\" aria-label=\"Close lightbox\" role=\"button\" class=\"Tate-lightbox__close TateUI-icon icon icon--cross TateUI-icon__size--default no-margin rounded \"></i>\n    </div>\n\n  </div>\n\n  <!-- Hidden focusable element at the end (to create a Focus Trap) -->\n  <div tabindex=\"0\" class=\"focus-trap-end\"></div>\n\n</div>\n    <div id=\"video-lightbox\">\n  <div class=\"btn video-lightbox__close-btn\">Close <i class=\"icon btn__icon icon--cross\" role=\"button\" tabindex=\"0\"></i></div>\n  <div class=\"article-body video-container\">   \n    <div class=\"container__inner\">\n      <iframe src=\"\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen></iframe>\n    </div>\n  </div>\n</div>\n    \n\n<div id=\"global-TateUI-modal\" class=\"TateUI-modal\" style=\"display:none;\" aria-modal=\"true\" role=\"dialog\" tabindex=\"-1\">\n    <div class=\"TateUI-modal__overlay\" data-modal-close></div>\n    <div class=\"TateUI-modal__content\">\n        \n        <div class=\"TateUI-modal__image\"></div>\n        <div class=\"TateUI-modal__container\">\n            <h3 class=\"TateUI-typography TateUI-typography__variant--h3 TateUI-typography__color--primary TateUI-typography__align--center TateUI-modal__title\"></h3>\n            <div class=\"TateUI-modal__body\"></div>\n            <div class=\"TateUI-modal__ctas\"></div>\n        </div>\n    </div>\n</div>\n\n\n\n    <footer id=\"footer\" itemscope=\"\" itemtype=\"https://schema.org/WPFooter\">\n        \n        \n        <div class=\"container inc__bt--solid footer__primary\">\n            <div class=\"container__inner\">\n                <div class=\"grid-outer\">\n                    <div class=\"grid-col--50 footer__follow-us\">\n                        <div class=\"footer__social-links\"><div class=\"list-wrapper\"><h2 class=\"list__title block__title\">Join in</h2><ul class=\"list list--inline list--social list--social--blue\"><li class=\"list__item list__item--social list__item--twitter list__item--first\"><a href=\"https://twitter.com/tate\" title=\"Twitter\" data-gtm-name=\"Social-footer\">Twitter</a></li><li class=\"list__item list__item--social list__item--facebook\"><a href=\"https://www.facebook.com/tategallery\" title=\"Facebook\" data-gtm-name=\"Social-footer\">Facebook</a></li><li class=\"list__item list__item--social list__item--youtube\"><a href=\"https://www.youtube.com/user/tate\" title=\"Youtube\" data-gtm-name=\"Social-footer\">YouTube</a></li><li class=\"list__item list__item--social list__item--instagram\"><a href=\"https://www.instagram.com/tate\" title=\"Instagram\" data-gtm-name=\"Social-footer\">Instagram</a></li><li class=\"list_