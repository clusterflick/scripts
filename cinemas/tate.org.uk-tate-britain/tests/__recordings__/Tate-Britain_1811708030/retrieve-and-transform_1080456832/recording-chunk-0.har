     \n        \n                <div class=\"card-content__inner\">\n\n                    \n                        <div class=\"card-tags\">\n                            \n                                <span>Exhibition</span>\n                            \n                            \n                            \n                        </div>\n                    \n\n                    <h2 class=\"card__title\">\n                        <span class=\"card__title--maintitle\">Theatre Picasso</span>\n                    </h2>\n\n                    \n                    \n                </div>\n        \n    \n    \n        <div class=\"card-icons\">\n            <div class=\"event-info event-info__venue\">\n                <div class=\"event-icon\">\n                    <i class=\"icon--location\"></i>\n                </div>\n                <span>Tate Modern</span>\n            </div>\n\n            <div class=\"event-info event-info__date\">\n                <div class=\"event-icon\">\n                    <i class=\"icon--calendar\"></i>\n                </div>\n                <span>Until 12 Apr 2026</span>\n            </div>\n            \n                <div class=\"event-info event-info__price\">\n                    <!--\n                    <div class=\"event-icon\">    \n                        <i class=\"icon--ticket\"></i>\n                    </div>\n                    \n                    <span> \n                            £15 / Free for Members \n                        </span>-->\n                </div> \n                               \n        </div>\n    \n    </div>\n    \n\n    \n    \n    </a>\n</div>\n\n    </div>\n\n\n        \n    </div>\n</div>\n\n                                        </div>\n                                    \n                                </div>\n                            </div>\n                        </form>\n                    </div>\n\n                    <div class=\"header-nav__item header-nav__join\">\n                        <a href=\"https://shop.tate.org.uk/membership\" class=\"btn btn--type__no-bg btn--size__small btn--style__text\" data-gtm-name=\"Navigation-header\" aria-label=\"Tate Join\">\n                            <span class=\"btn__text\">Become a Member</span>\n                        </a>\n                    </div>\n\n\n                </div>\n                \n                \n\n                \n            </div>\n\n        </div>\n    </header>\n    \n\n    <script>if(typeof(window.tatePopulateBasket)!=='undefined')window.tatePopulateBasket();</script>\n    \n\n    \n\n    \n    \n\n    <main id=\"content\" itemscope=\"\" itemtype=\"https://schema.org/WebPage\" class=\"container-16 \">\n        \n<article class=\"event event--talk\">\n    \n\n\n\n\n<header class=\"content-header splash-header  splash-header--with-cta\">\n    <div class=\"container\">\n        <div class=\"container__inner\">\n            \n            \n            \n            \n\n\n            <div class=\"splash-main\">\n                <div class=\"splash-header__primary-info\">\n\n                    \n                        <span class=\"splash-header__status\">Now booking</span>\n                    \n\n\n                    \n                        <span class=\"splash-header__venue\" itemprop=\"location\">Tate Britain</span>\n                    \n\n                    \n                        <span class=\"splash-header__type\">Talk | Film</span>\n                    \n\n                    <h1 class=\"splash-header__fulltitle\" itemprop=\"name\">\n                        \n                            <span class=\"\">Deep Blue Love</span>\n                        \n                            <span class=\"splash-header__subtitle\">Luke Fowler, Derek Jarman, Sarah Wood</span>\n                        \n                    </h1>\n\n                    \n                    \n\n                    \n\n                    \n\n                    \n\n                    <div class=\"splash-header__footer\">\n                        <div>\n                            \n                                \n                                    <span class=\"splash-header__dates\">30 January 2026 at 19.00–21.30</span>\n                                \n                            \n\n                            \n\n\n                        </div>\n\n                        \n                        \n                        <div class=\"btn-group splash-header__action-buttons\">\n                            <div class=\"btn-row\">\n                                \n                                <a href=\"https://shop.tate.org.uk/ticket/date?cgid=374877\" class=\"btn btn--type__primary btn--size__xl btn--shape__circle btn--style__text\">\n                                    <i class=\"btn__icon\"></i>\n                                    \n                                    <span class=\"btn__text\">Book tickets</span>\n                                    \n                                </a>\n                                \n                                \n                                <a href=\"https://shop.tate.org.uk/membership\" class=\"btn btn--type__secondary btn--size__xl btn--shape__circle btn--style__text\">\n                                    <i class=\"btn__icon\"></i>\n                                    <span class=\"btn__text\">Become a Member</span>\n                                </a>\n                                \n                            </div>\n                        </div>\n                        \n\n                    </div>\n\n                </div>\n                <div class=\"splash-header__media\">\n                    <div class=\"splash-header__media--inner responsive-container\">\n                        \n                            \n\n\n    \n    <picture\n        >\n        <source srcset=\"\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/PROSPECT_Blast_Torn_Skies.width-420.jpg 420w,\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/PROSPECT_Blast_Torn_Skies.width-540.jpg 540w,\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/PROSPECT_Blast_Torn_Skies.width-840.jpg 840w,\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/PROSPECT_Blast_Torn_Skies.width-1200.jpg 1200w,\n            https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/PROSPECT_Blast_Torn_Skies.width-1440.jpg 1278w,\n            \"\n        sizes=\"\n            (max-width: 479px) 420px,\n            (max-width: 600px) 540px,\n            (max-width: 1023px) 840px,\n            (max-width: 1440px) 1200px,\n            1440px,\n            \"\n        >\n        <img\n            alt=\"A bright orange sky, with text overlaid. Text reads &#x27;ABOVE US, BLAST- TORN SKIES HISTORY&#x27;S EVER, EVER REPRISE&#x27;\"\n            src=\"https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/images/PROSPECT_Blast_Torn_Skies.width-420.jpg\"\n            loading=\"lazy\"\n            width=\"420\"\n            height=\"315\"\n            \n            \n        >\n    </picture>\n\n    \n\n    \n\n\n\n                        \n                    </div>\n                </div>\n            </div>\n            \n                <div class=\"splash-header__image-caption\">\n                    <p data-block-key=\"5p7t3\"><i>Prospect</i>, Sarah Wood, 2025</p>\n                </div>\n            \n        </div>\n    </div>\n</header>\n\n\n\n    <section class=\"content-main\">\n\n        <div class=\"container container--primary-content\">\n            <div class=\"container__inner\">\n                <div class=\"grid-outer\">\n                    <div class=\"grid-col--66\">\n                        \n                        <div class=\"content__standfirst\"><p data-block-key=\"e3ubz\">Reflect on queer landscape and memory with screenings and conversation</p></div>\n\n                        \n\n\n                        <div class=\"content__body-text\" itemprop=\"mainContentOfPage\">\n\n                            \n                            \n                                    \n<div class=\"event-outer\n    container\">\n    <div class=\"event-inner\n        container__inner\">\n        <div class=\"block-rich_text\"><p data-block-key=\"jg1w4\"><a href=\"https://www.tate.org.uk/art/artists/derek-jarman-2327\">Derek Jarman</a>’s final film <i>Blue</i> (1993) contemplates losing sight, community and colour in the midst of the AIDS Crisis. Jarman described the film as “The first feature film to embrace the intellectual imperative of abstraction” with a single blue image projected for the full film. Jarman narrates the film alongside Tilda Swinton, Nigel Terry and John Quentin.</p><p data-block-key=\"aetal\">Since its first screening, many artists have been inspired by <i>Blue -</i> including Luke Fowler and Sarah Wood.</p><p data-block-key=\"gga5\">At this special event, Fowler and Wood will present their films <i>Being Blue</i> and <i>Prospect,</i> followed by a conversation chaired by Assistant Curator Isabel Tovey. The evening will then conclude with a screening of Jarman's <i>Blue.</i></p></div>\n<div class=\"block-accordion\">\n<div class=\"accordion__container\" data-accordion>\n    <div class=\"accordion\">\n        \n            \n<div class=\"accordion__item\">\n    <h2 id=\"biographies\" class=\"accordion__header\">\n        <button\n            id=\"h.biographies-Io1Sb\"\n            class=\"accordion__button\"\n            data-accordion-question\n            aria-controls=\"c.biographies-Io1Sb\"\n            aria-expanded=\"false\">\n            \n            <span class=\"accordion__title\">\n                Biographies\n            </span>\n        </button>\n    </h2>\n    <div\n        id=\"c.biographies-Io1Sb\"\n        data-accordion-answer\n        class=\"accordion__content\"\n        aria-labelledby=\"h.biographies-Io1Sb\">\n        <div class=\"block-rich_text\"><h4 data-block-key=\"a0ip9\">Luke Fowler</h4><p data-block-key=\"5t85v\"><a href=\"https://www.tate.org.uk/art/artists/luke-fowler-9061\">Luke Fowler</a> is an artist, 16mm filmmaker and musician based in Glasgow. He creates cinematic collages that have often been linked to the British Free Cinema movement of the 1950s. His para-documentary films have explored counter cultural figures including Scottish psychiatrist R. D. Laing, English composer Cornelius Cardew and Marxist-Historian E. P. Thompson. As well as portraits of musicians and composers he has also made films and installations that deal with the nature of sound itself.</p><h4 data-block-key=\"fmgb4\">Derek Jarman</h4><p data-block-key=\"7sc6a\"><a href=\"https://www.tate.org.uk/art/artists/derek-jarman-2327\">Michael Derek Elworthy Jarman</a> (31 January 1942 – 19 February 1994) was an English artist, film maker, costume designer, stage designer, writer, poet, gardener, and gay rights activist.</p><h4 data-block-key=\"6c9a7\">Sarah Wood</h4><p data-block-key=\"7nffe\">Sarah Wood is an artist-filmmaker, writer and curator. She works primarily with the still and moving image to explore the role the documentary archival plays in the narration of history. Since she began working in artists’ film in 2000 her ambition has been to generate a cinema of ideas – experimenting with film form to offer renewing space for viewers to consider some of the key social and political issues of our time.</p></div>\n    </div>\n</div>\n\n        \n            \n<div class=\"accordion__item\">\n    <h2 id=\"accessibility\" class=\"accordion__header\">\n        <button\n            id=\"h.accessibility-iJ0NE\"\n            class=\"accordion__button\"\n            data-accordion-question\n            aria-controls=\"c.accessibility-iJ0NE\"\n            aria-expanded=\"false\">\n            \n            <span class=\"accordion__title\">\n                Accessibility\n            </span>\n        </button>\n    </h2>\n    <div\n        id=\"c.accessibility-iJ0NE\"\n        data-accordion-answer\n        class=\"accordion__content\"\n        aria-labelledby=\"h.accessibility-iJ0NE\">\n        <div class=\"block-rich_text\"><p data-block-key=\"96gza\">There is step-free access from Millbank, through the Clore Entrance and into the rear of the Auditorium.</p><ul><li data-block-key=\"ei7pp\">Accessible, standard and Changing Places toilets are located on the Lower floor.</li></ul><p data-block-key=\"7e7pv\">To help plan your visit to Tate Britain, have a look at our <a href=\"https://www.tate.org.uk/visit/tate-britain/visual-story\">visual story</a>. It includes photographs and information about what you can expect from a visit to the gallery.<a href=\"https://media.tate.org.uk/aztate-prd-ew-dg-wgtail-st1-ctr-data/galleries/TB_map.pdf\">Download Tate Britain map</a> For more information before your visit:</p><ul><li data-block-key=\"2ep9e\">Email <a href=\"mailto:hello@tate.org.uk\">hello@tate.org.uk</a></li><li data-block-key=\"6t1te\">Call +44 (0)20 7887 8888 (daily 10.00–17.00)</li></ul><p data-block-key=\"1tbhc\"><a href=\"https://www.tate.org.uk/visit/tate-britain#accessibility\">Check all Tate Britain accessibility information</a></p></div>\n    </div>\n</div>\n\n        \n    </div>\n</div>\n</div>\n        \n    </div>\n</div>\n\n                            \n\n                        </div>\n\n                    </div>\n                    <div class=\"grid-col--33\">\n                        \n                        <div class=\"content-block content-block--location venue-block\">\n\n                            \n                                <h2 class=\"content-block__title\">Tate Britain</h2>\n                                <div class=\"location\">\n                                    \n                                        <p class=\"venue__title\"><a href=\"/visit/tate-britain/clore-auditorium\" class=\"text-link\">The Clore Auditorium</a></p>\n                                    \n                                    <p data-block-key=\"t3317\">Please use the Clore Auditorium Entrance at the eastern end of the building</p>\n                                    <span class=\"location__row\">Millbank</span><br /><span class=\"location__row\">London SW1P 4RG</span><br />\n                                    \n    \t                            <a href=\"https://www.tate.org.uk/visit/tate-britain\" class=\"location__link text-link\">Plan your visit</a>\n                                    \n                                </div>\n                            \n                        </div>\n                        \n                        \n                        <div class=\"content-block content-block--dates\">\n\n                            <h2 class=\"content-block__title\">Date &amp; Time</h2>\n\n                                \n\n                                    \n                                        <p class=\"content-block--dates__item\">30 January 2026 at 19.00–21.30</p>\n                                    \n\n                                \n\n                            \n                        </div>\n                        \n\n                        \n\n                            <div class=\"content-block content-block--price\">\n                                \n                                    <h2 class=\"content-block__title\">Pricing</h2>\n                                \n                                \n\n                                    \n                                    <p><span class=\"price\">£15 / £13 for Members</span></p>\n                                    \n\n                                    <p data-block-key=\"daymb\">£5 for <a href=\"https://www.tate.org.uk/tate-collective\">Tate Collective</a>. 16–25? Sign up and <a href=\"https://shop.tate.org.uk/login\">log in</a> to book</p><p data-block-key=\"2ht80\">£13 Concessions / £5 Universal and Pension Credit recipients</p>\n\n                                    \n\n                                        <div class=\"btn-row\">\n                                            \n                                            <a href=\"https://shop.tate.org.uk/ticket/date?cgid=374877\" class=\"btn btn--type__primary btn--style__text\">\n                                                <i class=\"btn__icon\"></i>\n                                                \n                                                <span class=\"btn__text\">Book tickets</span>\n                                                \n                                            </a>\n                                            \n                                            \n                                                <a href=\"https://shop.tate.org.uk/membership\" class=\"btn btn--type__secondary btn--style__text\">\n                                                    <i class=\"btn__icon\"></i>\n                                                    <span class=\"btn__text\">Become a Member</span>\n                                                </a>\n                                            \n                                        </div>\n\n                                    \n\n                                \n                            </div>\n                        \n\n                        \n\n                        \n                    </div>\n                </div>\n            </div>\n        </div>\n\n\n        \n\n        <div class=\"block-heading\"><div class=\"event-outercontainer\">\n    <div class=\"event-innercontainer__inner\">\n        <h2 id=\"we-recommend\" class=\"section__title\">We recommend</h2>\n\n\n    </div>\n</div>\n</div>\n<div class=\"block-strip\">\n\n\n\n\n<div class=\"article-strip container \">\n    <div class=\"article-strip__content container__inner\">\n\n        \n            \