.5,0.5c-11.6,0-21,9.4-21,21s9.4,21,21,21s21-9.4,21-21S33.1,0.5,21.5,0.5z\"/>\n\t</g>\n</svg>\n      </a>\n                        \n                              <a aria-label=\"Visit our Tiktok page\" href=\"https://www.tiktok.com/@eventimapollo\" target=\"blank\">\n        <svg class=\"social-icon social-links__icon\" width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M20 0C8.95 0 0 8.95 0 20C0 31.05 8.95 40 20 40C31.05 40 40 31.05 40 20C40 8.95 31.05 0 20 0ZM24.65 14.6V15.24V23.89C24.65 25.95 23.84 27.91 22.38 29.37C20.92 30.83 18.96 31.64 16.9 31.64C14.84 31.64 12.88 30.83 11.42 29.37C9.96 27.91 9.15 25.95 9.15 23.89C9.15 21.83 9.96 19.87 11.42 18.41C12.88 16.95 14.84 16.14 16.9 16.14H18.34V20.22H16.9C15.92 20.22 14.99 20.6 14.3 21.3C13.61 21.99 13.22 22.92 13.22 23.9C13.22 24.88 13.6 25.81 14.3 26.5C14.99 27.19 15.92 27.58 16.9 27.58C17.88 27.58 18.81 27.19 19.5 26.5C20.19 25.81 20.58 24.88 20.58 23.91V8.36H24.64L24.84 8.74C25.47 9.91 26.32 11.02 27.38 11.84C28.2 12.47 29.12 12.92 30.14 13.1L30.86 13.23L30.08 17.16L29.39 17.04C28.56 16.89 27.75 16.64 26.99 16.28C26.12 15.87 25.31 15.31 24.65 14.61V14.6Z\" fill=\"#142E4C\"/>\n</svg>\n      </a>\n          </p>\n  </div>\n  </div>\n</nav>\n<!-- // Off-Canvas (Burger Menu) Navigation END -->\n\n<div class=\"off-canvas__click-block\"></div>\n\n\n  <main id=\"main\" class=\"page-home\" data-page-handle=\"events\">\n\n    <div class=\"bg-white pb-[8rem] md:pb-[10rem]\">\n      \n    \n    \n<div class=\"event-hero bg-eventim-navy\">\n  <div class=\"container\">\n\n    <div class=\"grid grid-cols-12 md:gap-sm\">\n      <div class=\"col-span-12 md:col-span-7\">\n                          <p class=\"date variable-color\">Thursday 12th February 2026</p>\n        \n        <h1 class=\"h2 variable-color event-hero__title\">Twilight in Concert: The Film with Live Band</h1>\n        \n\n                                                                <p class=\"variable-color\" data-hide-on-date=\"2025-05-23T10:00:00+01:00\">TICKETS ON SALE: 23 May 2025 AT 10:00am</p>\n                  \n                <div class=\"mt-sm\">\n          \n                      \n              <div class=\"inline-block\" data-hide-on-date=\"2025-05-23T10:00:00+01:00\">\n                <a class=\"btn btn--tickets disabled\" href=\"https://www.eventim.co.uk/event/twilight-in-concert-the-film-with-live-eventim-apollo-20105519/?affiliate=HAL\" target=\"blank\">On sale soon</a>              </div>\n\n              <div class=\"inline-block\" data-show-on-date=\"2025-05-23T10:00:00+01:00\">\n                <a class=\"btn btn--tickets \" href=\"https://www.eventim.co.uk/event/twilight-in-concert-the-film-with-live-eventim-apollo-20105519/?affiliate=HAL\" target=\"blank\">Buy tickets</a>              </div>\n                      \n            \n                      <a class=\"btn btn--on-navy ml-2\" href=\"https://www.eventim.co.uk/event/lounge-pass-upgrade-eventim-apollo-20105580/?affiliate=HAL\" target=\"_self\">Upgrade your night</a>                  </div>\n\n        <div class=\"col-span-12 md:col-span-5 block md:hidden mt-sm\">\n                      <div class=\"event-hero__image\">\n              \n    \n      \n\n  \n        <picture class=\"  \" style=\"\">\n                                                                  <source media=\"(min-width: 1920px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=1067&amp;height=1067&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <source media=\"(min-width: 1920px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=1067&amp;height=1067&amp;focus_crop=1080,1080,0.5,0.5\">\n                                                                  <source media=\"(min-width: 1024px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=800&amp;height=800&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <source media=\"(min-width: 1024px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=800&amp;height=800&amp;focus_crop=1080,1080,0.5,0.5\">\n                                                                  <source media=\"(min-width: 600px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=500&amp;height=500&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <source media=\"(min-width: 600px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=500&amp;height=500&amp;focus_crop=1080,1080,0.5,0.5\">\n                                                                  <source media=\"\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=768&amp;height=768&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <source media=\"\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=768&amp;height=768&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <img src=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=768&amp;height=768&amp;focus_crop=1080,1080,0.5,0.5\"\n          alt=\"TWILIGHT26 Evenitm Square 1080x1080\"\n          style=\"\"\n          decoding=\"async\"\n          loading=\"lazy\"\n          width=\"1066\"\n          height=\"1066\"\n                    >\n    </picture>\n  \n\n            </div>\n                  </div>\n\n\n                  <div class=\"variable-color mt-sm\">\n            <p>Experience the legendary romance saga as an epic live-to-film concert event, surrounded by the beauty of 1,000 candles illuminating the stage.</p>\n<p>Twilight in Concert returns to Eventim Apollo in February 2026. Celebrating 20 years since the publication of the first book, this live-to-film concert experience features a 12-piece ensemble of rock and orchestral musicians, and will transport audiences on a journey deep into the heart of ‘forever’.</p>\n<p>Set in an enchanting candlelit setting, Twilight In Concert offers a unique opportunity for audiences to re-live the film that started it all. Musicians will take the stage to perform the beloved film score in perfect synchronization with the original movie presented in its entirety on a cinema size screen, setting the tone for a truly romantic evening.</p>\n<p><strong>Age restriction: </strong><strong>Strictly 12+, Under 16s to be accompanied by an adult 18+</strong><br /></p>\n          </div>\n              </div>\n\n      <div class=\"col-span-12 md:col-span-5 hidden md:block\">\n                  <div class=\"event-hero__image\">\n            \n    \n      \n\n  \n        <picture class=\"  \" style=\"\">\n                                                                  <source media=\"(min-width: 1920px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=1067&amp;height=1067&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <source media=\"(min-width: 1920px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=1067&amp;height=1067&amp;focus_crop=1080,1080,0.5,0.5\">\n                                                                  <source media=\"(min-width: 1024px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=800&amp;height=800&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <source media=\"(min-width: 1024px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=800&amp;height=800&amp;focus_crop=1080,1080,0.5,0.5\">\n                                                                  <source media=\"(min-width: 600px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=500&amp;height=500&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <source media=\"(min-width: 600px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=500&amp;height=500&amp;focus_crop=1080,1080,0.5,0.5\">\n                                                                  <source media=\"\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=768&amp;height=768&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <source media=\"\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=768&amp;height=768&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <img src=\"https://aeg-media-assets.b-cdn.net/eventim/images/TWILIGHT26_Evenitm-Square_1080x1080.png?width=768&amp;height=768&amp;focus_crop=1080,1080,0.5,0.5\"\n          alt=\"TWILIGHT26 Evenitm Square 1080x1080\"\n          style=\"\"\n          decoding=\"async\"\n          loading=\"lazy\"\n          width=\"1066\"\n          height=\"1066\"\n                    >\n    </picture>\n  \n\n          </div>\n\n                      <p class=\"variable-color text-right event-hero__caption hidden\">Twilight in Concert</p>\n                        </div>\n    </div>\n\n\n  </div>\n</div>\n      \n      \n\n      \n      <div class=\"showings\" id=\"information-section\">\n        <div class=\" bg-eventim-navy text-white\">\n          <div class=\"container\">\n            <h2 class=\"py-10\">Showings</h2>\n          </div>\n        </div>\n        <div class=\"container\">\n          <div class=\"showings__table\">\n                                      <div class=\"showings__table-top grid md:grid-cols-4 relative\">\n                <div class=\"\">Date <s