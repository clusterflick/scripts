.4L26,14.6c0,0-0.9-0.3-1.7-0.3c-0.8,0-1.6,0.3-1.6,1.1v2.5\n\t\t\tC22.7,17.9,26.1,17.9,26.1,17.9z M21.5,0.5c-11.6,0-21,9.4-21,21s9.4,21,21,21s21-9.4,21-21S33.1,0.5,21.5,0.5z\"/>\n\t</g>\n</svg>\n      </a>\n                        \n                              <a aria-label=\"Visit our Tiktok page\" href=\"https://www.tiktok.com/@eventimapollo\" target=\"blank\">\n        <svg class=\"social-icon social-links__icon\" width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M20 0C8.95 0 0 8.95 0 20C0 31.05 8.95 40 20 40C31.05 40 40 31.05 40 20C40 8.95 31.05 0 20 0ZM24.65 14.6V15.24V23.89C24.65 25.95 23.84 27.91 22.38 29.37C20.92 30.83 18.96 31.64 16.9 31.64C14.84 31.64 12.88 30.83 11.42 29.37C9.96 27.91 9.15 25.95 9.15 23.89C9.15 21.83 9.96 19.87 11.42 18.41C12.88 16.95 14.84 16.14 16.9 16.14H18.34V20.22H16.9C15.92 20.22 14.99 20.6 14.3 21.3C13.61 21.99 13.22 22.92 13.22 23.9C13.22 24.88 13.6 25.81 14.3 26.5C14.99 27.19 15.92 27.58 16.9 27.58C17.88 27.58 18.81 27.19 19.5 26.5C20.19 25.81 20.58 24.88 20.58 23.91V8.36H24.64L24.84 8.74C25.47 9.91 26.32 11.02 27.38 11.84C28.2 12.47 29.12 12.92 30.14 13.1L30.86 13.23L30.08 17.16L29.39 17.04C28.56 16.89 27.75 16.64 26.99 16.28C26.12 15.87 25.31 15.31 24.65 14.61V14.6Z\" fill=\"#142E4C\"/>\n</svg>\n      </a>\n          </p>\n  </div>\n  </div>\n</nav>\n<!-- // Off-Canvas (Burger Menu) Navigation END -->\n\n<div class=\"off-canvas__click-block\"></div>\n\n\n  <main id=\"main\" class=\"page-home\" data-page-handle=\"events\">\n\n    <div class=\"bg-white pb-[8rem] md:pb-[10rem]\">\n      \n    \n    \n<div class=\"event-hero bg-eventim-navy\">\n  <div class=\"container\">\n\n    <div class=\"grid grid-cols-12 md:gap-sm\">\n      <div class=\"col-span-12 md:col-span-7\">\n                          <p class=\"date variable-color\">Sunday 8th March 2026</p>\n        \n        <h1 class=\"h2 variable-color event-hero__title\">Terminator 2 Live</h1>\n        \n\n                                                                <p class=\"variable-color\" data-hide-on-date=\"2025-11-21T10:00:00+00:00\">TICKETS ON SALE: 21 Nov 2025 AT 10:00am</p>\n                  \n                <div class=\"mt-sm\">\n          \n                      \n              <div class=\"inline-block\" data-hide-on-date=\"2025-11-21T10:00:00+00:00\">\n                <a class=\"btn btn--tickets disabled\" href=\"https://www.eventim.co.uk/event/terminator-2-judgment-day-eventim-apollo-20950510/?affiliate=HAL\" target=\"blank\">On sale soon</a>              </div>\n\n              <div class=\"inline-block\" data-show-on-date=\"2025-11-21T10:00:00+00:00\">\n                <a class=\"btn btn--tickets \" href=\"https://www.eventim.co.uk/event/terminator-2-judgment-day-eventim-apollo-20950510/?affiliate=HAL\" target=\"blank\">Buy tickets</a>              </div>\n                      \n            \n                      <a class=\"btn btn--on-navy ml-2\" href=\"https://www.eventim.co.uk/event/lounge-pass-upgrade-eventim-apollo-20950529/?affiliate=HAL\" target=\"_self\">Upgrade your night</a>                  </div>\n\n        <div class=\"col-span-12 md:col-span-5 block md:hidden mt-sm\">\n                      <div class=\"event-hero__image\">\n              \n    \n      \n\n  \n        <picture class=\"  \" style=\"\">\n                                                                  <source media=\"(min-width: 1920px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=1067&amp;height=1067&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <source media=\"(min-width: 1920px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=1067&amp;height=1067&amp;focus_crop=1080,1080,0.5,0.5\">\n                                                                  <source media=\"(min-width: 1024px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=800&amp;height=800&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <source media=\"(min-width: 1024px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=800&amp;height=800&amp;focus_crop=1080,1080,0.5,0.5\">\n                                                                  <source media=\"(min-width: 600px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=500&amp;height=500&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <source media=\"(min-width: 600px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=500&amp;height=500&amp;focus_crop=1080,1080,0.5,0.5\">\n                                                                  <source media=\"\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=768&amp;height=768&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <source media=\"\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=768&amp;height=768&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <img src=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=768&amp;height=768&amp;focus_crop=1080,1080,0.5,0.5\"\n          alt=\"T2 1080 no url\"\n          style=\"\"\n          decoding=\"async\"\n          loading=\"lazy\"\n          width=\"1066\"\n          height=\"1066\"\n                    >\n    </picture>\n  \n\n            </div>\n                  </div>\n\n\n                  <div class=\"variable-color mt-sm\">\n            <p><strong>Terminator 2: Judgment Day Live in Concert</strong> celebrates James Cameron’s 1991 ground-breaking sequel to his original 1984 sci-fi classic. Experience Brad Fiedel’s powerful, industrial soundscape performed by a live 8-musician ensemble in-sync with the film that redefined the action genre.</p>\n<p>Building on his iconic themes from <em>The Terminator</em>, Fiedel expands the score into a sweeping, emotional journey, combining metallic percussion, pulsing synthesizers, and haunting melodic textures. The result is a sound world that perfectly captures the film’s fusion of human emotion and machine precision.</p>\n<p>A triumph of storytelling, visual effects, and music, <em>Terminator 2: Judgment Day </em>reunites Arnold Schwarzenegger as the Terminator, now reprogrammed to protect young John Connor (Edward Furlong) from a relentless new enemy, the shape-shifting T-1000 (Robert Patrick). Together with John's mother, Sarah Connor (Linda Hamilton), they fight to prevent Judgment Day and the rise of the machines.</p>\n<p>An evolution of sound and spectacle, <em>Terminator 2: Judgment Day Live in Concert</em> brings Brad Fiedel’s unforgettable score to life in real time - an electrifying, immersive experience that amplifies every moment in one of cinema’s greatest sequels.</p>\n          </div>\n              </div>\n\n      <div class=\"col-span-12 md:col-span-5 hidden md:block\">\n                  <div class=\"event-hero__image\">\n            \n    \n      \n\n  \n        <picture class=\"  \" style=\"\">\n                                                                  <source media=\"(min-width: 1920px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=1067&amp;height=1067&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <source media=\"(min-width: 1920px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=1067&amp;height=1067&amp;focus_crop=1080,1080,0.5,0.5\">\n                                                                  <source media=\"(min-width: 1024px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=800&amp;height=800&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <source media=\"(min-width: 1024px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=800&amp;height=800&amp;focus_crop=1080,1080,0.5,0.5\">\n                                                                  <source media=\"(min-width: 600px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=500&amp;height=500&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <source media=\"(min-width: 600px)\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=500&amp;height=500&amp;focus_crop=1080,1080,0.5,0.5\">\n                                                                  <source media=\"\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=768&amp;height=768&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <source media=\"\" srcset=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=768&amp;height=768&amp;focus_crop=1080,1080,0.5,0.5\">\n                        <img src=\"https://aeg-media-assets.b-cdn.net/eventim/images/T2-1080_no-url.jpg?width=768&amp;height=768&amp;focus_crop=1080,1080,0.5,0.5\"\n          alt=\"T2 1080 no url\"\n          style=\"\"\n          decoding=\"async\"\n          loading=\"lazy\"\n          width=\"1066\"\n          height=\"1066\"\n                    >\n    </picture>\n  \n\n          </div>\n\n                        </div>\n    </div>\n\n\n  </div>\n</div>\n      \n      \n\n      \n      <div class=\"showings\" id=\"information-section\">\n        <div class=\" bg-eventim-navy text-white\">\n          <div class=\"container\">\n            <h2 class=\"py-10\">Showings</h2>\n          </div>\n        </div>\n        <div class=\"container\">\n          <div class=\"showings__table\">\n                                      <div class=\"showings__table-top grid md:grid-cols-4 relative\">\n                <div class=\"\">Date <span class=\"md:hidden\">&</span></div>\n                <div class=\"\">Showtime</div>\n                <div class=\"showing__doors 