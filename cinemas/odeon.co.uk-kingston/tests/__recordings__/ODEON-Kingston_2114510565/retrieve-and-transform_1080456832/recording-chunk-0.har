          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-03-02\",\"showtimes\":[{\"id\":\"536-114240\",\"schedule\":{\"businessDate\":\"2026-03-02\",\"startsAt\":\"2026-03-02T19:00:00+00:00\",\"endsAt\":\"2026-03-02T20:54:00+00:00\",\"filmStartsAt\":\"2026-03-02T19:25:00+00:00\",\"filmEndsAt\":\"2026-03-02T20:54:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"536-3-166\",\"filmId\":\"HO00008444\",\"siteId\":\"536\",\"screenId\":\"536-3\",\"areaCategories\":[{\"areaCategoryId\":\"536-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000048\",\"0000000022\",\"0000000083\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"536-111186\",\"schedule\":{\"businessDate\":\"2026-03-02\",\"startsAt\":\"2026-03-02T19:15:00+00:00\",\"endsAt\":\"2026-03-02T22:40:00+00:00\",\"filmStartsAt\":\"2026-03-02T19:40:00+00:00\",\"filmEndsAt\":\"2026-03-02T22:40:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"536-10-173\",\"filmId\":\"HO00008184\",\"siteId\":\"536\",\"screenId\":\"536-10\",\"areaCategories\":[{\"areaCategoryId\":\"536-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"536\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.4117,\"longitude\":-0.2992},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Kingston@odeonuk.com\",\"address\":{\"line1\":\"The Rotunda\",\"line2\":\"Clarence Street\",\"city\":\"Kingston-upon-Thames\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008184\",\"title\":{\"text\":\"National Theatre Live: The Audience (Rerelease)\",\"translations\":[]},\"synopsis\":{\"text\":\"Returning to cinemas for the first time in over a decade, Helen Mirren plays Queen Elizabeth II in the Olivier and Tony Award® -winning hit production, directed by Stephen Daldry. For 60 years, Queen Elizabeth II met with each of her 12 prime ministers in a private weekly meeting. This meeting is known as The Audience. From Winston Churchill to Margaret Thatcher and David Cameron, the Queen advised her prime ministers on matters both public and personal. Through these private audiences, we see glimpses of the woman behind the crown and witness the moments that shaped a monarch. Peter Morgan’s Netflix phenomenon The Crown was based on this hit play that was captured live from London’s West End in 2013 and went on to become one of the most-watched NT Live productions.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Academy Award-winner Helen Mirren plays Queen Elizabeth II in the much-anticipated return of the Olivier Award–winning hit production, that inspired Netflix’s The Crown.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-26\",\"runtimeInMinutes\":180,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000328\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000004641\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017347\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017348\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000137\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000447\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000039\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9131253f-ec7c-4f61-b9e3-bbea8ddf1cd3\",\"corporateId\":null},\"hopk\":\"HO00008184\",\"hoCode\":\"A000009276\",\"eventId\":\"0000000001\",\"distributorName\":\"National Theatre\"},{\"id\":\"HO00008444\",\"title\":{\"text\":\"ODEON Pride Nights - Fine Young Men\",\"translations\":[]},\"synopsis\":{\"text\":\"Alf is a privileged teenager who returns to study at his Catholic school after being away for a year. He no longer identifies with his usual friends, the athletes and popular kids, but begins to feel attracted to Oliver, a new student who is completely different from the rest of the boys. When Alf tries to kiss Oliver and he rejects him, he feels uncomfortable and distances himself from his new friend. Alf will try to silence any rumors about his orientation by allying with his old friends. Together, in their excesses and arrogance, they will end up becoming criminals.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When Alf returns to school after a year away, he bonds with new student Oliver. Their relationship becomes deeply damaged as Alf becomes embroiled in a life of crime.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-03-02\",\"runtimeInMinutes\":89,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000017849\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017850\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017851\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017852\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017853\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017854\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017855\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017856\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017857\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017858\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017859\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000020\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"fd967b73-af62-48d7-9a41-217eb1bb0ed1\",\"corporateId\":null},\"hopk\":\"HO00008444\",\"hoCode\":\"A