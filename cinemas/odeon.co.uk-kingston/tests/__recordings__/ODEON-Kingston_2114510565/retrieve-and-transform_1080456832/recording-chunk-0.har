MemberId\":\"0000017171\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"17172\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17173\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17174\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"2227\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000258\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"90e71dd1-a916-4807-8aff-0dd9f141e72d\",\"corporateId\":null},\"hopk\":\"HO00008101\",\"hoCode\":\"A000009187\",\"eventId\":null,\"distributorName\":\"ENTERTAINMENT FILM DISTRIBUTOR\"},{\"id\":\"HO00008187\",\"title\":{\"text\":\"Song Sung Blue\",\"translations\":[]},\"synopsis\":{\"text\":\"Based on a true story, two down-on-their-luck musicians (Hugh Jackman and Kate Hudson) form a joyous Neil Diamond tribute band, proving it's never too late to find love and follow your dreams.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Based on a true story, two down-on-their-luck musicians (Hugh Jackman and Kate Hudson) form a joyous Neil Diamond tribute band, proving it's never too late.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-01\",\"runtimeInMinutes\":132,\"trailerUrl\":\"https://www.youtube.com/watch?v=o2v5EDUE_6I\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004299\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006974\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014437\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017352\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017353\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017354\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"779\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000235\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001659\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001660\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001844\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002247\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a9c1b2ab-674b-4dbe-b73f-d987ed90e080\",\"corporateId\":null},\"hopk\":\"HO00008187\",\"hoCode\":\"A000009279\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008189\",\"title\":{\"text\":\"28 Years Later: The Bone Temple\",\"translations\":[]},\"synopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later: The Bone Temple. In a continuation of the epic story, Dr. Kelson (Ralph Fiennes) finds himself in a shocking new relationship - with consequences that could change the world as they know it - and Spike's (Alfie Williams) encounter with Jimmy Crystal (Jack O'Connell) becomes a nightmare he can't escape. In the world of The Bone Temple, the infected are no longer the greatest threat to survival - the inhumanity of the survivors can be stranger and more terrifying.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong gory violence, injury detail, very strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-14\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=wyYliP8dPWU\",\"displayPriority\":9,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000097\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000442\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002404\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002653\",\"roles\":[\"Produ