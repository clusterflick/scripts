d\":\"536-2-142\",\"filmId\":\"HO00008916\",\"siteId\":\"536\",\"screenId\":\"536-2\",\"areaCategories\":[{\"areaCategoryId\":\"536-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000147\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"536-77-HO00008916\"},{\"id\":\"536-124276\",\"schedule\":{\"businessDate\":\"2026-07-26\",\"startsAt\":\"2026-07-26T18:30:00+01:00\",\"endsAt\":\"2026-07-26T21:48:00+01:00\",\"filmStartsAt\":\"2026-07-26T18:55:00+01:00\",\"filmEndsAt\":\"2026-07-26T21:48:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"536-15-136\",\"filmId\":\"HO00008916\",\"siteId\":\"536\",\"screenId\":\"536-15\",\"areaCategories\":[{\"areaCategoryId\":\"536-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000021\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000021\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"536-77-HO00008916\"},{\"id\":\"536-124256\",\"schedule\":{\"businessDate\":\"2026-07-26\",\"startsAt\":\"2026-07-26T20:00:00+01:00\",\"endsAt\":\"2026-07-26T23:18:00+01:00\",\"filmStartsAt\":\"2026-07-26T20:25:00+01:00\",\"filmEndsAt\":\"2026-07-26T23:18:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"536-13-158\",\"filmId\":\"HO00008916\",\"siteId\":\"536\",\"screenId\":\"536-13\",\"areaCategories\":[{\"areaCategoryId\":\"536-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000030\",\"0000000194\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"536-77-HO00008916\"},{\"id\":\"536-124268\",\"schedule\":{\"businessDate\":\"2026-07-26\",\"startsAt\":\"2026-07-26T21:30:00+01:00\",\"endsAt\":\"2026-07-27T00:48:00+01:00\",\"filmStartsAt\":\"2026-07-26T21:55:00+01:00\",\"filmEndsAt\":\"2026-07-27T00:48:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"536-2-142\",\"filmId\":\"HO00008916\",\"siteId\":\"536\",\"screenId\":\"536-2\",\"areaCategories\":[{\"areaCategoryId\":\"536-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000147\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"536-77-HO00008916\"}],\"relatedData\":{\"sites\":[{\"id\":\"536\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.4117,\"longitude\":-0.2992},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Kingston@odeonuk.com\",\"address\":{\"line1\":\"The Rotunda\",\"line2\":\"Clarence Street\",\"city\":\"Kingston-upon-Thames\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008216\",\"title\":{\"text\":\"The Super Mario Galaxy Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"The Super Mario Galaxy Movie is an animated film based on the world of Super Mario Bros., and follows The Super Mario Bros. Movie, which was released in 2023 and earned more than $1.3 billion worldwide. Both the 2023 film and The Super Mario Galaxy Movie are produced by Chris Meledandri of Illumination and Shigeru Miyamoto of Nintendo.\\n\\nThe film will be co-financed by Universal Pictures and Nintendo and will be released worldwide by Universal Pictures.\\n\\nThe Super Mario Galaxy Movie is directed by returning filmmakers Aaron Horvath and Michael Jelenic, from a screenplay by returning screenwriter Matthew Fogel, with Brian Tyler returning to compose the score.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Super Mario Galaxy Movie is an animated film based on the world of Super Mario Bros., and follows The Super Mario Bros. Movie, which was released in 2023. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild violence, threat\",\"translations\":[]},\"releaseDate\":\"2026-04-01\",\"runtimeInMinutes\":98,\"trailerUrl\":\"https://www.youtube.com/watch?v=n3Ux0FpICF8\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000882\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004594\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006526\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007692\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000007693\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000007694\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017412\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000101\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000277\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000964\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000982\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001209\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000004\",\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9108e0f0-b223-4e5d-9dec-6e4650b0b27b\",\"corporateId\":null},\"hopk\":\"HO00008216\",\"hoCode\":\"A000009309\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008565\",\"title\":{\"text\":\"Minions & Monsters\",\"translations\":[]},\"synopsis\":{\"text\":\"Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe with a riotous new chapter, featuring all-new characters, in the biggest global animated franchise in history: Minions & Monsters.\\n\\nThis is the rambunctious, ridiculous and totally true story of how the Minions conquered Hollywood, became movie stars, lost everything, unleashed monsters onto the world and then banded together to try and save the planet from the mayhem they had just created.\\n\\nMinions & Monsters is directed by Academy Award® nominee Pierre Coffin, a director of the first three Despicable Me films and the first Minions film. Coffin has also provided the voice for the Minions since their film debut in 2010. The film is written by Brian Lynch (Minions, The Secret Life of Pets films) and Pierre Coffin and is produced by Illumination’s Academy Award® nominated founder and CEO Chris Meledandri and by Bill Ryan (executive producer, The Super Mario Bros. Movie). The executive producer is Brian Lynch.\\n\\nMore than ten years after their creation, the Minions have become the most iconic animated characters of their generation. Globally recognised and beloved by fans of all ages, they have propelled Illumination’s Despicable Me and Minions to a global box office of more than $5.6 billion.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe \",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":{\"text\":\"very mild comic violence, threat, rude humour\",\"translations\":[]},\"releaseDate\":\"2026-07-01\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=drr0on3W0K8\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002922\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017409\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018101\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"18969\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000015\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000542\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001046\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"HO00001049\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001410\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"1051448b-9ebc-4ce8-b9e7-c007182dbdca\",\"corporateId\":null},\"hopk\":\"HO00008565\",\"hoCode\":\"A000009677\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008916\",\"title\":{\"text\":\"The Odyssey\",\"translations\":[]},\"synopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. The film brings Homer’s foundational saga to IMAX® film screens for the first time. \\n\\nThe Odyssey stars Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson and Lupita Nyong’o, with Zendaya and Charlize Theron.\\n\\nThe Odyssey is produced by Emma Thomas and Christopher Nolan for their company, Syncopy. The executive producer is Thomas Hayslip.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":173,\"trailerUrl\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000008\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000150\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000155\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000018948\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000018\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000064\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000267\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002248\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b63dbbaf-6c0e-4622-b9b1-698037e6247e\",\"corporateId\":null},\"hopk\":\"HO00008916\",\"hoCode\":\"A000010058\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00009078\",\"title\":{\"text\":\"Sia: Nostalgic For The Present\",\"translations\":[]},\"synopsis\":{\"text\":\"One voice. One unforgettable spectacle.\\n\\nSia: Nostalgic for the Present - a bold, genre-defying experience that trades pop pageantry for pure artistry. Awe-inspiring vocals, breathtaking choreography, and iconic performances, captured cinematically and soundtracked by an unmatched catalog of hits.\\n\\nIn 2016, Sia toured the world mirroring this film live on stage, frame for frame. Remastered for its tenth anniversary, it stands alone for the first time - not as a concert film, but as a visual masterpiece unlike anything in music since.\\n\\nStarring Maddie Ziegler, Kristen Wiig, Paul Dano, Ben Mendelsohn, Gaby Hoffmann, and Tig Notaro. Choreographed by Ryan Heffington. Directed by Sia and Daniel Askill.\\n\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"One voice. One unforgettable spectacle.\\n\\nSia: Nostalgic for the Present - a bold, genre-defying experience that trades pop pageantry for pure artistry. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-23\",\"runtimeInMinutes\":75,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004450\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013362\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019332\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"0000019333\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019334\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019335\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000266\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001004\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002746\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"eccb800d-1061-4261-bd3c-9b69ad9d3283\",\"corporateId\":null},\"hopk\":\"HO00009078\",\"hoCode\":\"A000010236\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"},{\"id\":\"HO00009148\",\"title\":{\"text\":\"Talking Tom Heroes on the Big Screen\",\"translations\":[]},\"synopsis\":{\"text\":\"Talking Tom and his superhero friends are coming to the big screen for the first time ever! It’s an hour-long show featuring your very favorite episodes of the hit series “Talking Tom Heroes: Suddenly Super” - and also some never-before-seen surprises. You’ll even get a chance to become part of the action as you play interactive games, shout at the screen, and sing along to Tom’s hero theme. Get ready to get super, because you’ve never seen the heroes like this!\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Talking Tom and his superhero friends are coming to the big screen for the first time ever! It’s an hour-long show featuring your very favorite episodes of the hit series\",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":null,\"releaseDate\":\"2