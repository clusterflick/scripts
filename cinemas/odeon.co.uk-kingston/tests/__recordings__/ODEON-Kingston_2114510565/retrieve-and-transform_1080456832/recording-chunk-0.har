            "text": "{\"businessDate\":\"2026-07-26\",\"showtimes\":[{\"id\":\"536-124264\",\"schedule\":{\"businessDate\":\"2026-07-26\",\"startsAt\":\"2026-07-26T09:30:00+01:00\",\"endsAt\":\"2026-07-26T12:48:00+01:00\",\"filmStartsAt\":\"2026-07-26T09:55:00+01:00\",\"filmEndsAt\":\"2026-07-26T12:48:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"536-2-142\",\"filmId\":\"HO00008916\",\"siteId\":\"536\",\"screenId\":\"536-2\",\"areaCategories\":[{\"areaCategoryId\":\"536-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000147\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"536-77-HO00008916\"},{\"id\":\"536-126812\",\"schedule\":{\"businessDate\":\"2026-07-26\",\"startsAt\":\"2026-07-26T09:30:00+01:00\",\"endsAt\":\"2026-07-26T10:46:00+01:00\",\"filmStartsAt\":\"2026-07-26T09:40:00+01:00\",\"filmEndsAt\":\"2026-07-26T10:46:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"536-4-167\",\"filmId\":\"HO00009148\",\"siteId\":\"536\",\"screenId\":\"536-4\",\"areaCategories\":[{\"areaCategoryId\":\"536-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"536-79-HO00009148\"},{\"id\":\"536-126827\",\"schedule\":{\"businessDate\":\"2026-07-26\",\"startsAt\":\"2026-07-26T09:50:00+01:00\",\"endsAt\":\"2026-07-26T11:38:00+01:00\",\"filmStartsAt\":\"2026-07-26T10:00:00+01:00\",\"filmEndsAt\":\"2026-07-26T11:38:00+01: