"Europe/London\"}],\"films\":[{\"id\":\"HO00008728\",\"title\":{\"text\":\"Spider-Man: Brand New Day\",\"translations\":[]},\"synopsis\":{\"text\":\"It's a BRAND NEW DAY for Peter Parker. Fighting crime full-time as Spider-Man in a world that doesn’t remember him -- and the pressure of seeing his old friends move on without him -- sparks a change in Peter he may not have the power to control. But that transformation might also be the only thing that can stop a shocking new threat to the city and those he loves - a powerful villain no one can even see.\\n\\nThe world may have forgotten Peter Parker, but he hasn’t forgotten them.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It's a BRAND NEW DAY for Peter Parker. Fighting crime full-time as Spider-Man in a world that doesn’t remember him sparks a change he may not have the power to control.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-29\",\"runtimeInMinutes\":140,\"trailerUrl\":\"https://www.youtube.com/watch?v=qwVAc2MmlwU\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000122\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000212\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003682\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007703\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010992\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018489\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018490\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000263\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000267\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000807\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000969\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00002248\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000003\",\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"db62eee0-9bc4-4169-8b2c-be507018ab7e\",\"corporateId\":null},\"hopk\":\"HO00008728\",\"hoCode\":\"A000009856\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00009045\",\"title\":{\"text\":\"David Byrne's American Utopia\",\"translations\":[]},\"synopsis\":{\"text\":\"‘Do we get stupider as we grow up?’ In his wildly popular Broadway show American Utopia, David Byrne reflects on human connections, life and how on earth we work through it. He joins the dots with his music and it all starts making sense. Spike Lee here transforms the production into immersive, dynamic cinema that radiates with astounding performances, inventive contemporary dance and political urgency. American Utopia flows like an iridescent dream vision. Work by James Baldwin, Janelle Monáe and Kurt Schwitters is highlighted among exhilarating renditions of Byrne’s solo work, as well as Talking Heads classics. According to the multi-hyphenate, we love looking at humans more than anything else. Anti-fascist and anti-racist, Byrne illuminates our responsibility to care for one another as he and his co-performers burn down the house.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Spike Lee documents the former Talking Heads frontman's brilliant, timely 2019 Broadway show, based on his album and tour of the same name.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-08-05\",\"runtimeInMinutes\":105,\"trailerUrl\":\"https://www.youtube.com/watch?v=WZ2I-A4kNfM\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001330\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000009832\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000008\",\"0000000015\"],\"externalIds\":{\"moviexchangeReleaseId\":\"3758e79a-86c0-4035-be5c-63230e1d2c8c\",\"corporateId\":null},\"hopk\":\"HO00009045\",\"hoCode\":\"A000010199\",\"eventId\":null,\"distributorName\":\"DOGWOOF PICTURES\"}],\"castAndCrew\":[{\"id\":\"0000000122\",\"name\":{\"givenName\":\"Kevin\",\"familyName\":\"Feige\",\"middleName\":null}},{\"id\":\"0000000212\",\"name\":{\"givenName\":\"Avi\",\"familyName\":\"Arad\",\"middleName\":null}},{\"id\":\"0000003682\",\"name\":{\"givenName\":\"Jacob\",\"familyName\":\"Batalon\",\"middleName\":null}},{\"id\":\"0000007703\",\"name\":{\"givenName\":\"Sadie\",\"familyName\":\"Sink\",\"middleName\":null}},{\"id\":\"0000010992\",\"name\":{\"givenName\":\"Rachel\",\"familyName\":\"O'Connor\",\"middleName\":null}},{\"id\":\"0000018489\",\"name\":{\"givenName\":\"Tramell\",\"familyName\":\"Tillman\",\"middleName\":null}},{\"id\":\"0000018490\",\"name\":{\"givenName\":\"Michael\",\"familyName\":\"Mando\",\"middleName\":null}},{\"id\":\"HO00000063\",\"name\":{\"givenName\":\"Jon\",\"familyName\":\"Bernthal\",\"middleName\":null}},{\"id\":\"HO00000263\",\"name\":{\"givenName\":\"Amy\",\"familyName\":\"Pascal\",\"middleName\":null}},{\"id\":\"HO00000267\",\"name\":{\"givenName\":\"Tom \",\"familyName\":\"Holland\",\"middleName\":null}},{\"id\":\"HO00000807\",\"name\":{\"givenName\":\"Mark\",\"familyName\":\"Ruffalo\",\"middleName\":null}},{\"id\":\"HO00000969\",\"name\":{\"givenName\":\"Destin Daniel \",\"familyName\":\"Cretton\",\"middleName\":null}},{\"id\":\"HO00002248\",\"name\":{\"givenName\":\"Zendaya\",\"familyName\":\"\",\"middleName\":null}},{\"id\":\"0000001330\",\"name\":{\"givenName\":\"Spike\",\"familyName\":\"Lee\",\"middleName\":null}},{\"id\":\"0000009832\",\"name\":{\"givenName\":\"David\",\"familyName\":\"Byrne\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000001\",\"name\":{\"text\":\"Action\",\"translations\":[]},\"description\":null},{\"id\":\"0000000003\",\"name\":{\"text\":\"Adventure\",\"translations\":[]},\"description\":null},{\"id\":\"0000000008\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null},{\"id\":\"0000000015\",\"na