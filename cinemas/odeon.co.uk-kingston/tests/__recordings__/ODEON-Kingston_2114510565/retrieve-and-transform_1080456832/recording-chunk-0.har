001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000147\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"536-77-HO00008916\"},{\"id\":\"536-124799\",\"schedule\":{\"businessDate\":\"2026-07-16\",\"startsAt\":\"2026-07-17T00:01:00+01:00\",\"endsAt\":\"2026-07-17T03:19:00+01:00\",\"filmStartsAt\":\"2026-07-17T00:26:00+01:00\",\"filmEndsAt\":\"2026-07-17T03:19:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"536-15-136\",\"filmId\":\"HO00008916\",\"siteId\":\"536\",\"screenId\":\"536-15\",\"areaCategories\":[{\"areaCategoryId\":\"536-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000021\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000021\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"536-77-HO00008916\"}],\"relatedData\":{\"sites\":[{\"id\":\"536\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.4117,\"longitude\":-0.2992},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Kingston@odeonuk.com\",\"address\":{\"line1\":\"The Rotunda\",\"line2\":\"Clarence Street\",\"city\":\"Kingston-upon-Thames\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008218\",\"title\":{\"text\":\"Toy Story 5\",\"translations\":[]},\"synopsis\":{\"text\":\"The toys are back in Disney and Pixar’s “Toy Story 5,” and this time around it’s Toy meets Tech. Buzz, Woody, Jessie and the rest of the gang’s jobs get exponentially harder when they go head to head with this all-new threat to playtime.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The toys are back in Disney and Pixar’s “Toy Story 5,” and this time around it’s Toy meets Tech. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-19\",\"runtimeInMinutes\":102,\"trailerUrl\":\"https://www.youtube.com/watch?v=RFm6wN7IhtY\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002721\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002933\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004242\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009613\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010641\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017418\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017419\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"7850\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000222\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002742\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e4e53d03-846a-4c4b-a95f-af4af0f815b4\",\"corporateId\":null},\"hopk\":\"HO00008218\",\"hoCode\":\"A000009312\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008246\",\"title\":{\"text\":\"Project Hail Mary\",\"translations\":[]},\"synopsis\":{\"text\":\"Science teacher Ryland Grace (Ryan Gosling) wakes up on a spaceship light years from home with no recollection of who he is or how he got there. As his memory returns, he begins to uncover his mission: solve the riddle of the mysterious substance causing the sun to die out. He must call on his scientific knowledge and unorthodox ideas to save everything on Earth from extinction… but an unexpected friendship means he may not have to do it alone.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Science teacher Ryland Grace (Ryan Gosling) wakes up on a spaceship light years from home with no recollection of who he is or how he got there.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate threat, rude humour, drug references, implied strong language\",\"translations\":[]},\"releaseDate\":\"2026-03-19\",\"runtimeInMinutes\":156,\"trailerUrl\":\"https://www.youtube.com/watch?v=NJGdoaI2VKY\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000556\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000557\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000910\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002808\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010992\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017480\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017481\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017482\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000263\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001953\",\"roles\":[\"Actor\",\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000045\"],\"externalIds\":{\"moviexchangeReleaseId\":\"d6d9381c-63a6-4a6e-8cf1-4989e69890c2\",\"corporateId\":null},\"hopk\":\"HO00008246\",\"hoCode\":\"A000009340\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008413\",\"title\":{\"text\":\"Supergirl\",\"translations\":[]},\"synopsis\":{\"text\":\"When an unexpected and ruthless adversary strikes too close to home, Kara Zor-El, aka Supergirl, reluctantly joins forces with an unlikely companion on an epic, interstellar journey of vengeance and justice.\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It follows Kara Zor-El's story and her darker origin before she finally made her way to Earth.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-25\",\"runtimeInMinutes\":108,\"trailerUrl\":\"https://www.youtube.com/watch?v=wxTiyxH9eZw\",\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007748\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014392\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017778\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001118\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001286\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001846\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002429\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002629\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000001\",\"0000000003\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dbd619f1-56eb-431b-8c89-2eb427edd34f\",\"corporateId\":null},\"hopk\":\"HO00008413\",\"hoCode\":\"A000009517\",\"eventId\":null,\"distributorName\":\"WARNER BROS DISTRIBUTORS LTD\"},{\"id\":\"HO00008415\",\"title\":{\"text\":\"Moana\",\"translations\":[]},\"synopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyages beyond the reef of her island of Motunui with the infamous demigod Maui (Dwayne Johnson) on an unforgettable journey to restore prosperity to her people. The film is directed by Emmy® and Tony Award® winner Thomas Kail (“Hamilton”); produced by Dwayne Johnson, Dany Garcia, Beau Flynn, Hiram Garcia and Lin-Manuel Miranda; and executive produced by Thomas Kail, Scott Sheldon, Charles Newirth and Auliʻi Cravalho, who voiced Moana in the animated features “Moana” and “Moana 2.”\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyage\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=zQjHSoVCQLs\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000117\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001075\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009582\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016273\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017779\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017780\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000102\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000113\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000114\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001036\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"6d579a6e-0609-4ead-992c-190cf5e0fd6f\",\"corporateId\":null},\"hopk\":\"HO00008415\",\"hoCode\":\"A000009519\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008466\",\"title\":{\"text\":\"Masters of the Universe\",\"translations\":[]},\"synopsis\":{\"text\":\"In MASTERS OF THE UNIVERSE, Director Travis Knight brings the legendary franchise back to the big screen in this epic live-action adventure. After being separated for 15 years, the Sword of Power leads Prince Adam (Nicholas Galitzine) back to Eternia where he discovers his home shattered under the fiendish rule of Skeletor (Jared Leto). To save his family and his world, Adam must join forces with his closest allies, Teela (Camila Mendes) and Duncan/Man-At-Arms (Idris Elba), and embrace his true destiny as He-Man — the most powerful man in the universe.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In MASTERS OF THE UNIVERSE, Director Travis Knight brings the legendary franchise back to the big screen in this epic live-action adventure. \",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate fantasy violence, innuendo, language\",\"translations\":[]},\"releaseDate\":\"2026-06-03\",\"runtimeInMinutes\":141,\"trailerUrl\":\"https://www.youtube.com/watch?v=8R-N0NDdvww\",\"displayPriority\":11,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000207\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007179\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009132\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017897\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017898\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000141\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001004\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001016\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001690\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001820\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001821\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001822\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002423\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00002675\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002722\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000009\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5b57ae1f-ac97-4f6c-8af7-1c0fb9741a29\",\"corporateId\":null},\"hopk\":\"HO00008466\",\"hoCode\":\"A000009574\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008468\",\"title\":{\"text\":\"Disclosure Day\",\"translations\":[]},\"synopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming close to … Disclosure Day.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate threat, violence, injury detail, infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-06-10\",\"runtimeInMinutes\":145,\"trailerUrl\":\"https://www.youtube.com/watch?v=WnW25gFk2Mk\",\"displayPriority\":9,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000219\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000635\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010990\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000216\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000318\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001974\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002474\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"1f2756b4-b117-4f07-b240-55d7611c2d78\",\"corporateId\":null},\"hopk\":\"HO00008468\",\"hoCode\":\"A000009576\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008527\",\"title\":{\"text\":\"Michael\",\"translations\":[]},\"synopsis\":{\"text\":\"Michael is the cinematic portrayal of the life and legacy of one of the most influential artists the world has ever known.\\n\\nThe film tells the story of Michael Jackson’s life beyond the music, tracing his journey from the discovery of his extraordinary talent as the lead of the Jackson Five, to the visionary artist whose creative ambition fuelled a relentless pursuit to become the biggest entertainer in the world.\\n\\nHighlighting both his life off-stage and some of the most iconic performances from his early solo career, the film gives audiences a front-row seat to Michael Jackson as never before. This is where his story begins.\\n\\nMichael stars Jaafar Jackson in his feature film debut, Nia Long (Empire, The Best Man franchise), Laura Harrier (BlacKkKlansman, Spider-Man: Homecoming) and Juliano Krue Valdi (The Loud House, Arco), with Miles Teller (Top Gun: Maverick, Whiplash) and two-time Academy Award® nominee Colman Domingo (Sing Sing, Rustin).\\n\\nDirected by Antoine Fuqua, the award-winning filmmaker of Training Day, Olympus Has Fallen and The Equalizer franchise, from a screenplay by three-time Academy Award® nominee John Logan (Gladiator, The Aviator), the film is produced by Academy Award® winner Graham King (The Departed, Bohemian Rhapsody), John Branca (executive producer This Is It, Thriller 40) and John McClain (executive producer This Is It, Michael Jackson Live at Wembley July 16, 1988).\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Michael is the cinematic portrayal of the life and legacy of one of the most influential artists the world has ever known.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate threat, domestic abuse\",\"translations\":[]},\"releaseDate\":\"2026-04-22\",\"runtimeInMinutes\":127,\"trailerUrl\":\"https://www.youtube.com/watch?v=spOtvnAzBh8\",\"displayPriority\":15,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001329\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002474\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018002\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018003\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018004\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018005\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000216\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001050\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001665\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00002257\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000005\",\"0000000009\",\"0000000013\"],\"externalIds\":{\"moviexchangeReleaseId\":\"f466f587-8251-4c2f-b18d-5daf4f24ec8a\",\"corporateId\":null},\"hopk\":\"HO00008527\",\"hoCode\":\"A000009639\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008565\",\"title\":{\"text\":\"Minions & Monsters\",\"translations\":[]},\"synopsis\":{\"text\":\"Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe with a riotous new chapter, featuring all-new characters, in the biggest global animated franchise in history: Minions & Monsters.\\n\\nThis is the rambunctious, ridiculous and totally true story of how the Minions conquered Hollywood, became movie stars, lost everything, unleashed monsters onto the world and then banded together to try and save the planet from the mayhem they had just created.\\n\\nMinions & Monsters is directed by Academy Award® nominee Pierre Coffin, a director of the first three Despicable Me films and the first Minions film. Coffin has also provided the voice for the Minions since their film debut in 2010. The film is written by Brian Lynch (Minions, The Secret Life of Pets films) and Pierre Coffin and is produced by Illumination’s Academy Award® nominated founder and CEO Chris Meledandri and by Bill Ryan (executive producer, The Super Mario Bros. Movie). The executive producer is Brian Lynch.\\n\\nMore than ten years after their creation, the Minions have become the most iconic animated characters of their generation. Globally recognised and beloved by fans of all ages, they have propelled Illumination’s Despicable Me and Minions to a global box office of more than $5.6 billion.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe \",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":{\"text\":\"very mild comic violence, threat, rude humour\",\"translations\":[]},\"releaseDate\":\"2026-07-01\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=drr0on3W0K8\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002922\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017409\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018101\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"18969\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000015\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000542\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001046\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"HO00001049\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001410\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"1051448b-9ebc-4ce8-b9e7-c007182dbdca\",\"corporateId\":null},\"hopk\":\"HO00008565\",\"hoCode\":\"A000009677\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008587\",\"title\":{\"text\":\"Star Wars: The Mandalorian and Grogu\",\"translations\":[]},\"synopsis\":{\"text\":\"The Mandalorian and Grogu embark on their most thrilling mission yet in Lucasfilm’s “Star Wars: The Mandalorian and Grogu,” an all-new Star Wars adventure opening exclusively in theaters May 22, 2026. The evil Empire has fallen, and Imperial warlords remain scattered throughout the galaxy. As the fledgling New Republic works to protect everything the Rebellion fought for, they have enlisted the help of legendary Mandalorian bounty hunter Din Djarin (Pedro Pascal) and his young apprentice Grogu. Directed by Jon Favreau, “Star Wars: The Mandalorian and Grogu” also stars Sigourney Weaver and is produced by Jon Favreau, Kathleen Kennedy, Dave Filoni, and Ian Bryce, with music composed by Ludwig Göransson.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Mandalorian and Grogu embark on their most thrilling mission yet in Lucasfilm’s “Star Wars: The Mandalorian and Grogu,” an all-new Star Wars adventure \",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate violence, threat, injury detail\",\"translations\":[]},\"releaseDate\":\"2026-05-22\",\"runtimeInMinutes\":132,\"trailerUrl\":\"https://www.youtube.com/watch?v=afVMXehjc0k\",\"displayPriority\":14,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000015\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001725\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010950\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018131\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000349\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001007\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002464\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000010\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"377f5941-3fa2-4f9d-960d-3cfd938f73d6\",\"corporateId\":null},\"hopk\":\"HO00008587\",\"hoCode\":\"A000009702\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008744\",\"title\":{\"text\":\"Obsession\",\"translations\":[]},\"synopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for but soon discovers that some desires come at a dark, sinister price.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong violence, gore\",\"translations\":[]},\"releaseDate\":\"2026-05-15\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=fWLaCC8L6Jo\",\"displayPriority\":10,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002047\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006579\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018515\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018516\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018517\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018518\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018519\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018520\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000018521\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a6a25d26-497a-4daa-a5ff-b5fc9719faca\",\"corporateId\":null},\"hopk\":\"HO00008744\",\"hoCode\":\"A000009874\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008769\",\"title\":{\"text\":\"Time Hoppers: The Silk Road\",\"translations\":[]},\"synopsis\":{\"text\":\"Four gifted children accidentally travel back in time to the historic Silk Road, where they encounter an evil alchemist that is determined to erase the foundations of science. If he succeeds, great inventions like the camera, computer, and astrolabe will never be created!  The kids will have to use all their wits to thwart his plans as the future of science and technology hangs in the balance.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Four gifted children journey through time to stop a vengeful alchemist whose plans threaten the future of science and technology.\",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":{\"text\":\"very mild threat, violence, language, upsetting scenes\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":81,\"trailerUrl\":\"https://www.youtube.com/watch?v=H-1todq4l54\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000018581\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018582\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018583\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018584\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018585\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018586\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018587\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018588\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000018589\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000003\",\"0000000004\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2e92e915-ef4e-4c31-83ea-a0b90c48f91a\",\"corporateId\":null},\"hopk\":\"HO00008769\",\"hoCode\":\"A000009900\",\"eventId\":null,\"distributorName\":\"MIRACLE COMMUNICATIONS LTD\"},{\"id\":\"HO00008912\",\"title\":{\"text\":\"Scary Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"Twenty-six years after outrunning a suspiciously familiar masked killer (“Ghostface”), the Core Four are back in the killer’s crosshairs and no horror movie IP is safe. Marlon Wayans (“Shorty”), Shawn Wayans (“Ray”), Anna Faris (“Cindy”), and Regina Hall (“Brenda”) reunite in Scary Movie alongside returning favorites and fresh faces to slash through reboots, remakes, requels, prequels, sequels, spin-offs, elevated horror, origin stories, anything with the word legacy in it, and every “final chapter” that absolutely isn’t final. Nothing is sacred. No trope survives. Every line gets crossed.  The Wayans are back to cancel the Cancel Culture.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Twenty-six years after outrunning a suspiciously familiar masked killer (“Ghostface”), the Core Four are back in the killer’s crosshairs and no horror movie IP is safe.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, sex references, drug misuse, violence, nudity\",\"translations\":[]},\"releaseDate\":\"2026-06-05\",\"runtimeInMinutes\":96,\"trailerUrl\":\"https://www.youtube.com/watch?v=_4CvRre-Rb8\",\"displayPriority\":13,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004846\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018926\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000018927\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018928\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018929\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018930\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018931\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018932\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018933\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018934\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018935\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018936\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018937\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018938\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018939\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018940\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000018941\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018942\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018943\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001258\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002366\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002485\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5c55d281-233a-49e5-b907-c1728bb2c5c9\",\"corporateId\":null},\"hopk\":\"HO00008912\",\"hoCode\":\"A000010054\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00008914\",\"title\":{\"text\":\"jackass: best and last\",\"translations\":[]},\"synopsis\":{\"text\":\"Johnny Knoxville and the gang return for one final fling at the big screen. Featuring all-new stunts and stupidity along with the greatest hits and biggest laughs from the past, jackass: best and last is a joyously raucous celebration of all the mischievous camaraderie that you’ve come to love and expect from these idiots over the past 25 years. So, grab your dumb little buddies, raise your glasses, and come experience the cinematic event that promises to be the last time you’ll ever laugh this hard in a theatre.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Johnny Knoxville and the gang return for one final fling at the big screen. Featuring all-new stunts and stupidity along with the greatest hits and biggest laughs.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-26\",\"runtimeInMinutes\":92,\"trailerUrl\":\"https://www.youtube.com/watch?v=erztPGWNkY4\",\"displayPriority\":7,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002327\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000002329\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002330\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000018944\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018945\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018946\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018947\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"3163\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3164\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3165\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3167\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3178\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"3195\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"434e102b-e02e-431e-aff7-3ea7cd362f6b\",\"corporateId\":null},\"hopk\":\"HO00008914\",\"hoCode\":\"A000010056\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00008916\",\"title\":{\"text\":\"The Odyssey\",\"translations\":[]},\"synopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. The film brings Homer’s foundational saga to IMAX® film screens for the first time. \\n\\nThe Odyssey stars Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson and Lupita Nyong’o, with Zendaya and Charlize Theron.\\n\\nThe Odyssey is produced by Emma Thomas and Christopher Nolan for their company, Syncopy. The executive producer is Thomas Hayslip.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":173,\"trailerUrl\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000008\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000150\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000155\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000018948\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000018\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000064\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000267\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002248\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b63dbbaf-6c0e-4622-b9b1-698037e6247e\",\"corporateId\":null},\"hopk\":\"HO00008916\",\"hoCode\":\"A000010058\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008964\",\"title\":{\"text\":\"Evil Dead Burn\",\"translations\":[]},\"synopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. After the loss of her husband, a woman seeks solace with her in-laws in their secluded family home. As one by one they are transformed into Deadites—turning the gathering into a family reunion from hell—she comes to discover that the vows she took in life... live on even in death.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. \",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong bloody violence, gore\",\"translations\":[]},\"releaseDate\":\"2026-07-09\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=YYkUkyfjUKg\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000008177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009258\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019021\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019022\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019023\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019024\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000303\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"3c50ff95-67b2-4152-9965-ad2431794116\",\"corporateId\":null},\"hopk\":\"HO00008964\",\"hoCode\":\"A000010114\",\"eventId\":null,\"distributorName\":\"STUDIOCANAL\"},{\"id\":\"HO00009072\",\"title\":{\"text\":\"The Invite\",\"translations\":[]},\"synopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \\nHave they reignited the spark or lit the match that burns it all down?\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"very strong language, strong sex references, drug misuse\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":106,\"trailerUrl\":\"https://www.youtube.com/watch?v=7YIHRhRMn94\",\"displayPriority\":8,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000785\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004368\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019329\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019330\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000241\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001028\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001154\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"HO00002297\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a87bd21e-c69e-4d0b-b7d0-18dabf2eeb9f\",\"corporateId\":null},\"hopk\":\"HO00009072\",\"hoCode\":\"A000010230\",\"eventId\":null,\"distributorName\":\"Black Bear Pictures\"},{\"id\":\"HO00009089\",\"title\":{\"text\":\"Dear You (Teochew with CH/EN subtitles)\",\"translations\":[]},\"synopsis\":{\"text\":\"For years, Grandma Shurou from Chaoshan lived on the letters and remittances from her husband who left for Nanyang to survive the war and never returned. When her debt-ridden grandson Xiaowei secretly travels to Thailand to find his rumoured “millionaire” grandpa, he returns with shocking news: his grandpa is long gone, and the person Grandma had exchanged letters with for years was a stranger. As Xiaowei digs deeper, a long-buried misunderstanding spanning three generations begins to unravel, revealing a truth that binds two families across borders and time.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"For years, Grandma Shurou from Chaoshan lived on the letters and remittances from her husband who left for Nanyang to survive the war and never returned.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, violence\",\"translations\":[]},\"releaseDate\":\"2026-06-26\",\"runtimeInMinutes\":118,\"trailerUrl\":\"https://www.youtube.com/watch?v=qIjOCYltUqA\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000019352\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019353\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019354\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019356\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019357\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019358\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"fdea5aba-8ee5-45d5-9962-39c2b5f62b31\",\"corporateId\":null},\"hopk\":\"HO00009089\",\"hoCode\":\"A000010248\",\"eventId\":null,\"distributorName\":\"Trinity Filmed Entertainment\"},{\"id\":\"HO00009122\",\"title\":{\"text\":\"The Last Viking\",\"translations\":[]},\"synopsis\":{\"text\":\"After serving fifteen years in prison, bank robber Anker (Nikolaj Lie Kaas) is determined to recover the stolen money his brother Manfred (Mads Mikkelsen) buried years earlier. There’s just one problem: Manfred, caught in an identity crisis and convinced he is John Lennon, can no longer remember where it is hidden. The brothers set off on an increasingly chaotic hunt for the missing fortune, digging up old family secrets on the way.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After serving fifteen years in prison, bank robber Anker (Nikolaj Lie Kaas) is determined to recover the stolen money his brother Manfred (Mads Mikkelsen) buried.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, bloody images, domestic abuse, threat, language\",\"translations\":[]},\"releaseDate\":\"2026-06-26\",\"runtimeInMinutes\":116,\"trailerUrl\":\"https://www.youtube.com/watch?v=YdFbqryfdxg\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003145\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003151\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001408\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\",\"0000000029\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"49c3016f-cc64-47b0-8ac1-d77fc7b7d619\",\"corporateId\":null},\"hopk\":\"HO00009122\",\"hoCode\":\"A000010286\",\"eventId\":null,\"distributorName\":\"Picturehouse Entertainment Ltd\"},{\"id\":\"HO00009145\",\"title\":{\"text\":\"Backrooms: Everything Must Go w/Bonus Footage\",\"translations\":[]},\"synopsis\":{\"text\":\"A strange doorway appears in the basement of a furniture showroom.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A strange doorway appears in the basement of a furniture showroom.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, violence, injury detail, horror\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":136,\"trailerUrl\":\"https://www.youtube.com/watch?v=tKGhxMi50y8\",\"displayPriority\":12,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000005236\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009091\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009092\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012651\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012936\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014875\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018787\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000018788\"