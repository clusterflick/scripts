catedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"536\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.4117,\"longitude\":-0.2992},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Kingston@odeonuk.com\",\"address\":{\"line1\":\"The Rotunda\",\"line2\":\"Clarence Street\",\"city\":\"Kingston-upon-Thames\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008201\",\"title\":{\"text\":\"GOAT\",\"translations\":[]},\"synopsis\":{\"text\":\"From Sony Pictures Animation, the studio behind Spider-Man TM: Across the Spider-Verse and the artists that made KPop Demon Hunters, comes GOAT, an original action-comedy set in an all-animal world. The story follows Will, a small goat with big dreams who gets a once-in-a-lifetime shot to join the pros and play roarball–a high-intensity, co-ed, full-contact sport dominated by the fastest, fiercest animals in the world. Will’s new teammates aren’t thrilled about having a little goat on their roster, but Will is determined to revolutionize the sport and prove once and for all that “smalls can ball!”\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Sony Pictures Animation, the studio behind Spider-Man TM: Across the Spider-Verse and the artists that made KPop Demon Hunters, comes GOAT, an original action-comedy\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild violence, rude humour, language\",\"translations\":[]},\"releaseDate\":\"2026-02-13\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=kmY-rYS7yng\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000119\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002189\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006525\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009120\",\"roles\":[\"Actor\"]