Id\":null},\"hopk\":\"HO00008273\",\"hoCode\":\"A000009367\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00008310\",\"title\":{\"text\":\"Send Help\",\"translations\":[]},\"synopsis\":{\"text\":\"Two colleagues become stranded on a deserted island, the only survivors of a plane crash. On the island, they must overcome past grievances and work together to survive, but ultimately, it's a battle of wills and wits to make it out alive.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Two colleagues become stranded on a deserted island, the only survivors of a plane crash. On the island, they must overcome past grievances and work together to survive. \",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-05\",\"runtimeInMinutes\":113,\"trailerUrl\":\"https://www.youtube.com/watch?v=NwR6J0W4XN0\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000005399\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008617\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009978\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000303\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001664\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001891\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"d6fe525e-3f8f-4e06-ba6b-7bcad91081ff\",\"corporateId\":null},\"hopk\":\"HO00008310\",\"hoCode\":\"A000009406\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008325\",\"title\":{\"text\":\"Return to Silent Hill\",\"translations\":[]},\"synopsis\":{\"text\":\"When a mysterious letter calls him back to Silent Hill in search of his lost love, James finds a once-recognizable town and encounters terrifying figures both familiar and new, and begins to question his own sanity.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When a mysterious letter calls him back to Silent Hill in search of his lost love, James finds a once-recognizable town and encounters terrifying figures.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong horror, gore, language\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":105,\"trailerUrl\":null,\"displayPriority\":11,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003901\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004117\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012885\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012886\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017616\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017617\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017618\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"0004c65f-7fef-466d-afe4-7bab15b10fa6\",\"corporateId\":null},\"hopk\":\"HO00008325\",\"hoCode\":\"A000009423\",\"eventId\":null,\"distributorName\":\"ENTERTAINMENT FILM DISTRIBUTOR\"},{\"id\":\"HO00008327\",\"title\":{\"text\":\"No Other Choice\",\"translations\":[]},\"synopsis\":{\"text\":\"Man-su (Lee Byung Hun), a specialist in paper manufacturing with 25 years of experience, is so satisfied with life that he can truthfully tell himself, “I’ve got it all.” While happily passing his days with his wife Miri (Son Yejin), their two children and two dogs, Man-su is suddenly informed by his company that he has been fired.\\n“We’re sorry. We have no other choice.”\\nFeeling shocked as if his head had been cut off by an ax, Man-su vows to find himself a new job within the next three months for the sake of his family. Despite his firm resolve to turn his life around, Man-su spends over a year drifting from one job interview after another, and working at a retail store. He eventually finds himself in danger of losing the very house that he struggled so hard to buy.\\nDesperate, he visits Moon Paper out of the blue and tries to hand over his CV, but he just ends up getting humiliated by line manager Choi Sun-chul (Park Hee Soon). Man-su knows he is better qualified than anyone to work at Moon Paper, so he comes to a certain decision.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, violence, injury detail, sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":139,\"trailerUrl\":null,\"displayPriority\":13,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000010701\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016863\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017619\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017620\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017621\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017622\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000009\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e660de4a-88af-472a-a1e1-57ffb9dcbb49\",\"corporateId\":null},\"hopk\":\"HO00008327\",\"hoCode\":\"A000009425\",\"eventId\":null,\"distributorName\":\"MUBI UK Ltd\"},{\"id\":\"HO00008358\",\"title\":{\"text\":\"Nouvelle Vague\",\"translations\":[]},\"synopsis\":{\"text\":\"A playful, poignant love letter to cinema, Nouvelle Vague reimagines the making of Jean-Luc Godard’s Breathless in an exuberant exploration of the youthful rebellion and creative chaos that shaped the French New Wave.\\n\\nDirected by Richard Linklater, starring Zoey Deutch, Guillaume Marbeck, and Aubry Dullin.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A playful, poignant love letter to cinema, Nouvelle Vague reimagines the making of Jean-Luc Godard’s Breathless in an exuberant exploration of the youthful rebellion.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":106,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002938\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017657\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017658\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017659\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017660\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017661\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017662\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017663\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000009\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"83a62a86-a59e-4457-a8fb-ed533cce124e\",\"corporateId\":null},\"hopk\":\"HO00008358\",\"hoCode\":\"A000009458\",\"eventId\":null,\"distributorName\":\"ALTITUDE\"},{\"id\":\"HO00008359\",\"title\":{\"text\":\"The Voice of Hind Rajab\",\"translations\":[]},\"synopsis\":{\"text\":\"January 29, 2024. Red Crescent volunteers receive an emergency call. A 6-year old girl is trapped in a car under fire in Gaza, pleading for rescue. While trying to keep her on the line, they do everything they can to get an ambulance to her. Her name was Hind Rajab.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Red Crescent volunteers receive an emergency call. A 6-year old girl is trapped in a car under IDF fire in Gaza, pleading for rescue. Her name was Hind Rajab.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"distressing scenes, strong threat, images of real dead bodies\",\"translations\":[]},\"releaseDate\":\"2026-01-16\",\"runtimeInMinutes\":89,\"trailerUrl\":\"https://www.youtube.com/watch?v=7udC9c6Cfis\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000204\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003817\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017664\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017665\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017666\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017667\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017668\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017669\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e118aebf-d685-4703-8fb5-88305b5e28da\",\"corporateId\":null},\"hopk\":\"HO00008359\",\"hoCode\":\"A000009459\",\"eventId\":null,\"distributorName\":\"ALTITUDE\"},{\"id\":\"HO00008366\",\"title\":{\"text\":\"Melania\",\"translations\":[]},\"synopsis\":{\"text\":\"Offering unprecedented access to the 20 days leading up to the 2025 Presidential Inauguration — through the eyes of the First Lady-elect herself — step inside Melania Trump's world as she orchestrates inauguration plans, navigates the complexities of the White House transition, and reenters public life with her family. With exclusive footage capturing critical meetings, private conversations, and never-before-seen environments, Mrs. Trump returns to one of the world's most powerful roles.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Offering unprecedented access to the 20 days leading up to the 2025 Presidential Inauguration — through the eyes of the First Lady-elect herself.\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild bad language, upsetting scenes, brief sexual violence references\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":104,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId