\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000082\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000488\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002397\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"87004e42-c4bd-4468-8b83-00f122c59dd9\",\"corporateId\":null},\"hopk\":\"HO00007316\",\"hoCode\":\"A000008328\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00007533\",\"title\":{\"text\":\"Avatar: Fire and Ash\",\"translations\":[]},\"synopsis\":{\"text\":\"Jake and Neytiri's family grapples with grief after Neteyam's death, encountering a new, aggressive Na'vi tribe, the Ash People, who are led by the fiery Varang, as the conflict on Pandora escalates and a new moral focus emerges.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Jake and Neytiri's family grapples with grief after Neteyam's death, encountering a new, aggressive Na'vi tribe, the Ash People, who are led by the fiery Varang.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-19\",\"runtimeInMinutes\":197,\"trailerUrl\":null,\"displayPriority\":8,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000560\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002207\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002294\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005786\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005787\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007837\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17711\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17712\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17713\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000042\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000349\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000696\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002427\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000010\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a4cb369f-77c4-4fe1-8f85-dd5e76b195dd\",\"corporateId\":null},\"hopk\":\"HO00007533\",\"hoCode\":\"A000008563\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00007638\",\"title\":{\"text\":\"The SpongeBob Movie: Search for Squarepants\",\"translations\":[]},\"synopsis\":{\"text\":\"SpongeBob and his Bikini Bottom friends set sail in their biggest, all-new, can’t miss cinematic event ever…The SpongeBob Movie: Search for SquarePants. Desperate to be a big guy, SpongeBob sets out to prove his bravery to Mr. Krabs by following The Flying Dutchman – a mysterious swashbuckling ghost pirate – on a seafaring comedy- adventure that takes him to the deepest depths of the deep sea, where no Sponge has gone before.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"SpongeBob and his Bikini Bottom friends set sail in their biggest, all-new, can’t miss cinematic event ever…The SpongeBob Movie: Search for SquarePants.\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat, violence, rude humour\",\"translations\":[]},\"releaseDate\":\"2025-12-20\",\"runtimeInMinutes\":96,\"trailerUrl\":\"https://www.youtube.com/watch?v=4-k8Hg7SZas\",\"displayPriority\":15,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000003\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001112\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002204\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016137\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016138\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016139\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016140\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016141\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"9353\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001014\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001107\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001108\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001109\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002485\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002508\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002640\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e5808809-5d74-4074-ba7d-547c6d87a1b4\",\"corporateId\":null},\"hopk\":\"HO00007638\",\"hoCode\":\"A000008678\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00007891\",\"title\":{\"text\":\"A Tooth Fairy Tale\",\"translations\":[]},\"synopsis\":{\"text\":\"Van is a teenage tooth fairy with a taste for adventure, who wishes to explore life beyond the boundaries of his secluded civilization and rigid traditions. Upon meeting Gemma, a daring goblin girl with a knack for science, the pair realise that they have a lot in common, despite the ancient disputes between their two tribes. Together, with the help of Rupee (the world’s cutest troll!), they decide to embark on a mission to reunite their magical kingdoms for good. However, hot on their trail is the greedy Spider Queen and her minions, who will stop at nothing to put an end to their plans.\\n\\nA stunning animation that will spark the imagination of the whole family, it stars Booboo Stewart (The Twilight Saga, Descendants), Larkin Bell (Stranger Things), Vivica A. Fox (Ella Enchanted), Jon Lovitz (Matilda, Hotel Transylvania), and Fran Drescher (Hotel Transylvania).\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Van is a teenage tooth fairy with a taste for adventure, who wishes to explore life beyond the boundaries of his secluded civilization and rigid traditions. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild fantasy violence\",\"translations\":[]},\"releaseDate\":\"2025-10-17\",\"runtimeInMinutes\":88,\"trailerUrl\":\"https://www.youtube.com/watch?v=eLgAL70FzLE\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001634\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002728\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005183\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016119\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016728\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016729\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016730\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"2227\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"21af7487-fc4d-4b39-a8e9-e0607032c85d\",\"corporateId\":null},\"hopk\":\"HO00007891\",\"hoCode\":\"A000008958\",\"eventId\":null,\"distributorName\":\"Kaleidoscope Home Entertainmen\"},{\"id\":\"HO00007903\",\"title\":{\"text\":\"Night of the Zoopocalypse\",\"translations\":[]},\"synopsis\":{\"text\":\"When a meteor crashes into Colepepper Zoo, it unleashes a virus that transforms the zoo animals into zombies. Gracie, a quirky young wolf, teams up with a gruff mountain lion named Dan to lead a wacky team of animals on a perilous mission to escape the virus and rescue their zoo, on one spooky NIGHT OF THE ZOOPOCALYPSE!\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When a meteor crashes into Colepepper Zoo, it unleashes a virus that transforms the zoo animals into zombies. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild scary scenes, threat, violence\",\"translations\":[]},\"releaseDate\":\"2025-10-10\",\"runtimeInMinutes\":92,\"trailerUrl\":\"https://www.youtube.com/watch?v=4uSwmWVomCo\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000119\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016089\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016090\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016091\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016092\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016093\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016094\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016095\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2601ff0a-6be8-47ec-8604-9ccf2e4c9306\",\"corporateId\":null},\"hopk\":\"HO00007903\",\"hoCode\":\"A000008974\",\"eventId\":null,\"distributorName\":\"Kazoo Films\"},{\"id\":\"HO00008012\",\"title\":{\"text\":\"The Housemaid\",\"translations\":[]},\"synopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous — a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, sex, sexual violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-12-22\",\"runtimeInMinutes\":131,\"trailerUrl\":\"https://www.youtube.com/watch?v=kdDdlY2VPxw\",\"displayPriority\":2,\"castAndCr