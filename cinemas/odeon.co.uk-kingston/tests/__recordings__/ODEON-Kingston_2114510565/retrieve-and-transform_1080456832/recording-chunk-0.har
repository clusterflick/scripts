:\"536-13-158\",\"filmId\":\"HO00008916\",\"siteId\":\"536\",\"screenId\":\"536-13\",\"areaCategories\":[{\"areaCategoryId\":\"536-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000030\",\"0000000194\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"536-77-HO00008916\"},{\"id\":\"536-124266\",\"schedule\":{\"businessDate\":\"2026-07-24\",\"startsAt\":\"2026-07-24T22:30:00+01:00\",\"endsAt\":\"2026-07-25T01:48:00+01:00\",\"filmStartsAt\":\"2026-07-24T22:55:00+01:00\",\"filmEndsAt\":\"2026-07-25T01:48:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"536-2-142\",\"filmId\":\"HO00008916\",\"siteId\":\"536\",\"screenId\":\"536-2\",\"areaCategories\":[{\"areaCategoryId\":\"536-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000147\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"536-77-HO00008916\"}],\"relatedData\":{\"sites\":[{\"id\":\"536\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.4117,\"longitude\":-0.2992},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Kingston@odeonuk.com\",\"address\":{\"line1\":\"The Rotunda\",\"line2\":\"Clarence Street\",\"city\":\"Kingston-upon-Thames\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008216\",\"title\":{\"text\":\"The Super Mario Galaxy Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"The Super Mario Galaxy Movie is an animated film based on the world of Super Mario Bros., and follows The Super Mario Bros. Movie, which was released in 2023 and earned more than $1.3 billion worldwide. Both the 2023 film and The Super Mario Galaxy Movie are produced by Chris Meledandri of Illumination and Shigeru Miyamoto of Nintendo.\\n\\nThe film will be co-financed by Universal Pictures and Nintendo and will be released worldwide by Universal Pictures.\\n\\nThe Super Mario Galaxy Movie is directed by returning filmmakers Aaron Horvath and Michael Jelenic, from a screenplay by returning screenwriter Matthew Fogel, with Brian Tyler returning to compose the score.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Super Mario Galaxy Movie is an animated film based on the world of Super Mario Bros., and follows The Super Mario Bros. Movie, which was released in 2023. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild violence, threat\",\"translations\":[]},\"releaseDate\":\"2026-04-01\",\"runtimeInMinutes\":98,\"trailerUrl\":\"https://www.youtube.com/watch?v=n3Ux0FpICF8\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000882\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004594\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006526\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007692\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000007693\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000007694\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017412\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000101\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000277\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000964\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000982\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001209\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000004\",\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9108e0f0-b223-4e5d-9dec-6e4650b0b27b\",\"corporateId\":null},\"hopk\":\"HO00008216\",\"hoCode\":\"A000009309\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008916\",\"title\":{\"text\":\"The Odyssey\",\"translations\":[]},\"synopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. The film brings Homer’s foundational saga to IMAX® film screens for the first time. \\n\\nThe Odyssey stars Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson and Lupita Nyong’o, with Zendaya and Charlize Theron.\\n\\nThe Odyssey is produced by Emma Thomas and Christopher Nolan for their company, Syncopy. The executive producer is Thomas Hayslip.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":173,\"trailerUrl\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000008\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000150\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000155\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000018948\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000018\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000064\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000267\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002248\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b63dbbaf-6c0e-4622-b9b1-698037e6247e\",\"corporateId\":null},\"hopk\":\"HO00008916\",\"hoCode\":\"A000010058\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00009148\",\"title\":{\"text\":\"Talking Tom Heroes on the Big Screen\",\"translations\":[]},\"synopsis\":{\"text\":\"Talking Tom and his superhero friends are coming to the big screen for the first time ever! It’s an hour-long show featuring your very favorite episodes of the hit series “Talking Tom Heroes: Suddenly Super” - and also some never-before-seen surprises. You’ll even get a chance to become part of the action as you play interactive games, shout at the screen, and sing along to Tom’s hero theme. Get ready to get super, because you’ve never seen the heroes like this!\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Talking Tom and his superhero friends are coming to the big screen for the first time ever! It’s an hour-long show featuring your very favorite episodes of the hit series\",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-24\",\"runtimeInMinutes\":66,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000019487\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019488\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019489\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019490\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019491\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"03714ba9-83dd-4e66-b9ce-b829ba828b78\",\"corporateId\":null},\"hopk\":\"HO00009148\",\"hoCode\":\"A000010312\",\"eventId\":null,\"distributorName\":\"Alileo Media Limited\"}],\"castAndCrew\":[{\"id\":\"0000000882\",\"name\":{\"givenName\":\"Charlie\",\"familyName\":\"Day\",\"middleName\":null}},{\"id\":\"0000004594\",\"name\":{\"givenName\":\"Benny \",\"famil