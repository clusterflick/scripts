stAndCrewMemberId\":\"HO00000355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001794\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001974\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000005\"],\"externalIds\":{\"moviexchangeReleaseId\":\"37b2b94f-65a0-481e-9d3c-bde2445c99a4\",\"corporateId\":null},\"hopk\":\"HO00008080\",\"hoCode\":\"A000009165\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008101\",\"title\":{\"text\":\"Marty Supreme\",\"translations\":[]},\"synopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, sex, nudity, injury detail, violence\",\"translations\":[]},\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":150,\"trailerUrl\":\"https://www.youtube.com/watch?v=s9gSuKaKcqM\",\"displayPriority\":7,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001370\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012950\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014188\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014753\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017170\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017171\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"17172\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17173\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17174\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"2227\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000258\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"90e71dd1-a916-4807-8aff-0dd9f141e72d\",\"corporateId\":null},\"hopk\":\"HO00008101\",\"hoCode\":\"A000009187\",\"eventId\":null,\"distributorName\":\"ENTERTAINMENT FILM DISTRIBUTOR\"},{\"id\":\"HO00008177\",\"title\":{\"text\":\"Giant\",\"translations\":[]},\"synopsis\":{\"text\":\"Based on the remarkable true story of legendary British-Yemeni boxing champion Prince Naseem \\\"Naz\\\" Hamed and his relationship with Irish boxing trainer Brendan Ingle, GIANT charts Naz’s inspiring rags-to-riches underdog tale from his humble beginnings in Sheffield to becoming champion of the world.\\n\\nWith his unorthodox style, cocky persona and sheer dominance of the sport, Naseem faced down the abhorrent racism and islamophobia that swept Britain in the 80’s and 90’s, to become a global sporting icon, both inside and outside of the ring.\\n\\nThe film explores the unlikely and tender relationship between Naz and his trainer Ingle – a steel industry worker who ran a humble boxing gym in a church hall in the North of England; and the instrumental role that Ingle played on Naz’s road to success. With exhilarating and visceral scenes in the ring, coupled with deeply moving and intimate moments behind the curtain, GIANT is an inspiring biopic of one of the greatest showmen the sporting world has even seen – the untold true story of the boy behind The Prince.\\n\\nPierce Brosnan (James Bond franchise, Mamma Mia!, The Love Punch, Mobland) stars as Brendan Ingle, with Amir El-Masry (The Night Manager, Limbo, The Crown, SAS: Rogue Heroes) playing Naseem Hamed. From executive producer Sylvester Stallone (Rocky, Creed), GIANT is written and directed by film-maker Rowan Athale (Gangs of London).\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The remarkable real-life story of legendary British-Yemeni boxer Prince Naseem \\\"Naz\\\" Hamed.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, discrimination\",\"translations\":[]},\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":110,\"trailerUrl\":\"https://www.youtube.com/watch?v=iUYO2kk1Fek\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000949\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003156\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017331\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017332\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017333\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001836\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000023\"],\"externalIds\":{\"moviexchangeReleaseId\":\"1c43a4ae-d161-4502-9f9e-6ae2973ddcd3\",\"corporateId\":null},\"hopk\":\"HO00008177\",\"hoCode\":\"A000009268\",\"eventId\":null,\"distributorName\":\"True Brit Entertainment LTD\"},{\"id\":\"HO00008187\",\"title\":{\"text\":\"Song Sung Blue\",\"translations\":[]},\"synopsis\":{\"text\":\"Based on a true story, two down-on-their-luck musicians (Hugh Jackman and Kate Hudson) form a joyous Neil Diamond tribute band, proving it's never too late to find love and follow your dreams.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Based on a true story, two down-on-their-luck musicians (Hugh Jackman and Kate Hudson) form a joyous Neil Diamond tribute band, proving it's never too late.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-01\",\"runtimeInMinutes\":132,\"trailerUrl\":\"https://www.youtube.com/watch?v=o2v5EDUE_6I\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004299\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006974\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014437\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017352\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017353\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017354\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"779\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000235\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001659\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001660\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001844\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002247\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a9c1b2ab-674b-4dbe-b73f-d987ed90e080\",\"corporateId\":null},\"hopk\":\"HO00008187\",\"hoCode\":\"A000009279\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008189\",\"title\":{\"text\":\"28 Years Later: The Bone Temple\",\"translations\":[]},\"synopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later: The Bone Temple. In a continuation of the epic story, Dr. Kelson (Ralph Fiennes) finds himself in a shocking new relationship - with consequences that could change the world as they know it - and Spike's (Alfie Williams) encounter with Jimmy Crystal (Jack O'Connell) becomes a nightmare he can't escape. In the world of The Bone Temple, the infected are no longer the greatest threat to survival - the inhumanity of the survivors can be stranger and more terrifying.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong gory violence, injury detail, very strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-14\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=wyYliP8dPWU\",\"displayPriority\":9,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000097\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000442\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002404\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002653\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005575\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014011\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014577\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017356\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000576\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"12790418-6492-492a-814c-53673bc1ab1a\",\"corporateId\":null},\"hopk\":\"HO00008189\",\"hoCode\":\"A000009281\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008191\",\"title\":{\"text\":\"Rental Family\",\"translations\":[]},\"synopsis\":{\"text\":\"A down-and-out actor living in Tokyo is hired as a token American guy for a Japanese rental-family company, leading him on an unexpected journey of self-discovery through the roles he plays in other people’s lives.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A down-and-out actor living in Tokyo is hired as a token American guy for a Japanese rental-family company, leading him on an unexpected journey of self-discovery.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-16\",\"runtimeInMinutes\":110,\"trailerUrl\":\"https://www.youtube.com/watch?v=sZT37sM2VgE\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007702\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008791\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008792\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017357\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017358\",\"roles\":[\"Actor\"]},{\"castAndC