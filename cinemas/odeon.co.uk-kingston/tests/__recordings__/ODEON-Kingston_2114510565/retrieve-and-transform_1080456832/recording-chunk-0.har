r\"]},{\"castAndCrewMemberId\":\"HO00001844\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002247\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a9c1b2ab-674b-4dbe-b73f-d987ed90e080\",\"corporateId\":null},\"hopk\":\"HO00008187\",\"hoCode\":\"A000009279\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008189\",\"title\":{\"text\":\"28 Years Later: The Bone Temple\",\"translations\":[]},\"synopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later: The Bone Temple. In a continuation of the epic story, Dr. Kelson (Ralph Fiennes) finds himself in a shocking new relationship - with consequences that could change the world as they know it - and Spike's (Alfie Williams) encounter with Jimmy Crystal (Jack O'Connell) becomes a nightmare he can't escape. In the world of The Bone Temple, the infected are no longer the greatest threat to survival - the inhumanity of the survivors can be stranger and more terrifying.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong gory violence, injury detail, very strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-14\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=wyYliP8dPWU\",\"displayPriority\":9,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000097\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000442\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002404\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002653\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005575\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014011\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014577\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017356\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000576\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"12790418-6492-492a-814c-53673bc1ab1a\",\"corporateId\":null},\"hopk\":\"HO00008189\",\"hoCode\":\"A000009281\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008191\",\"title\":{\"text\":\"Rental Family\",\"translations\":[]},\"synopsis\":{\"text\":\"A down-and-out actor living in Tokyo is hired as a token American guy for a Japanese rental-family company, leading him on an unexpected journey of self-discovery through the roles he plays in other people’s lives.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A down-and-out actor living in Tokyo is hired as a token American guy for a Japanese rental-family company, leading him on an unexpected journey of self-discovery.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-16\",\"runtimeInMinutes\":110,\"trailerUrl\":\"https://www.youtube.com/watch?v=sZT37sM2VgE\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007702\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008791\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008792\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017357\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017358\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017359\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017360\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017361\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"2617\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a2ea80c3-a876-47ff-9c5c-0cddaeae7ddd\",\"corporateId\":null},\"hopk\":\"HO00008191\",\"hoCode\":\"A000009283\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008193\",\"title\":{\"text\":\"Mercy\",\"translations\":[]},\"synopsis\":{\"text\":\"In the near future, a detective (Chris Pratt) stands on trial accused of murdering his wife. He has 90 minutes to prove his innocence to the advanced A.I. Judge (Rebecca Ferguson) he once championed, before it determines his fate.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In the near future, a detective (Chris Pratt) stands on trial accused of murdering his wife. He has 90 minutes to prove his innocence to the advanced A.I. Judge.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate violence, threat, injury detail, drug misuse, strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=sN-C09dfczY\",\"displayPriority\":12,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003235\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000009008\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017362\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017363\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017364\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000086\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000825\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000982\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001684\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002432\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"eea3fe00-3e2b-4dcc-9150-aedd76790a42\",\"corporateId\":null},\"hopk\":\"HO00008193\",\"hoCode\":\"A000009285\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008195\",\"title\":{\"text\":\"Is This Thing On?\",\"translations\":[]},\"synopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family — forcing them to navigate co-parenting, identity, and whether love can take a new form.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":121,\"trailerUrl\":\"https://www.youtube.com/watch?v=ngmu5zGOa7s\",\"displayPriority\":11,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000027\",\"roles\":[\"Actor\",\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000883\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000002332\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004642\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017365\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017366\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017367\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"30\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c59e6ef3-faa4-469e-9fc7-2d8997cff25e\",\"corporateId\":null},\"hopk\":\"HO00008195\",\"hoCode\":\"A000009287\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008222\",\"title\":{\"text\":\"Saipan\",\"translations\":[]},\"synopsis\":{\"text\":\"SAIPAN explores the explosive clash between soccer star Roy Keane and manager Mick McCarthy before the 2002 FIFA World Cup. Their feud, rooted in clashing standards and personalities, erupted on the island of Saipan, shaking the Irish team and nation. As Keane walked out, McCarthy faced chaos. This gripping true story goes beyond sport, it’s a dramatic, often comic tale of leadership, loyalty, and a rivalry that captured global attention.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"SAIPAN explores the explosive clash between soccer star Roy Keane and manager Mick McCarthy before the 2002 FIFA World Cup.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"very strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=s4TzwHPsq_s\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000111\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000000112\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012549\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017369\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017420\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017421\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"15f1abd4-8ed9-44f9-bb19-c7de8145ff5e\",\"corporateId\":null},\"hopk\":\"HO00008222\",\"hoCode\":\"A000009316\",\"eventId\":null,\"distributorName\":\"VERTIGO RELEASING LIMITED\"},{\"id\":\"HO00008237\",\"title\":{\"text\":\"Shelter\",\"translations\":[]},\"synopsis\":{\"text\":\"On a remote coastal island, a man living in self-imposed exile rescues a young girl from a deadly storm. This action sets off a chain of events, bringing him out of seclusion and both into harm’s way. As their lives intertwine, he must navigate protecting the orphaned girl while battling enemies from is past - setting them both on a breathless odyssey for survival and a deeper journey toward redemption.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"On a remote coastal island, a man living in self-imposed exile rescues a young girl from a deadly storm.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":107,\"trailerUrl\":null,\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000262\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001557\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002147\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014866\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016569\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017459\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000088\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000251\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001694\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001819\",\"roles\":[\"Actor\",\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000007\",\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9e3b2fd7-c5b2-4dee-857d-9dc3d230e4cd\",\"corporateId\":null},\"hopk\":\"HO00008237\",\"hoCode\":\"A000009331\",\"eventId\":null,\"distributorName\":\"Black Bear Pictures\"},{\"id\":\"HO00008239\",\"title\":{\"text\":\"Kangaroo\",\"translations\":[]},\"synopsis\":{\"text\":\"KANGAROO is a heart-warming family comedy about ex TV personality, Chris Masterman, who becomes stranded in an Outback town outside Alice Springs. There, he teams up with 12-year-old Indigenous girl Charlie. The pair form an unlikely friendship and work together to rescue and rehabilitate orphaned joeys in the remote but stunning Outback community - an endeavour that proves to be life-changing for them both.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"KANGAROO is a heart-warming family comedy about an ex-TV personality Chris Masterman, who becomes stranded in an Outback town after a car accident on his way to Broome. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild bad language, threat, violence\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":107,\"trailerUrl\":\"https://www.youtube.com/watch?v=BAwuJ74KP6U\",\"displayPriority\":12,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002636\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006784\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011449\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011614\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012011\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016712\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016713\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000016714\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016715\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016716\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016717\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016718\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016719\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016720\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016721\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016722\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016723\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016724\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016725\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002378\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2190fa2f-4101-475d-848f-b328ee1f0b8d\",\"corporateId\":null},\"hopk\":\"HO00008239\",\"hoCode\":\"A000009333\",\"eventId\":null,\"distributorName\":\"STUDIOCANAL\"},{\"id\":\"HO00008241\",\"title\":{\"text\":\"Stitch Head\",\"translations\":[]},\"synopsis\":{\"text\":\"It’s monster time! In a castle laboratory high above a little town, a Mad Professor brings … then promptly forgets all about them. So who looks monstrous creations to (almost)-LIFE after the castle? Who takes care of the monsters? Who teaches them NOT to be monstrous, so the townsfolk don’t form an Angry Mob and burn the castle to the ground? Meet Stitch Head the professor’s very first creation.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Meet Stitch Head, the first of many monstrous creations of a mad professor, who’s about to break out of his castle home to find fame and fortune! \",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":{\"text\":\"very mild threat, rude humour, upsetting scenes, violence, language\",\"translations\":[]},\"releaseDate\":\"2026-02-13\",\"runtimeInMinutes\":91,\"trailerUrl\":\"https://www.youtube.com/watch?v=SlHrSRmobKQ\",\"displayPriority\":14,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000645\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001141\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003295\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010210\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017460\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017461\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017462\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017463\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017464\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017465\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001278\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2951842e-577b-4cfb-a291-a57668c68ee0\",\"corporateId\":null},\"hopk\":\"HO00008241\",\"hoCode\":\"A000009335\",\"eventId\":null,\"distributorName\":\"Kazoo Films\"},{\"id\":\"HO00008273\",\"title\":{\"text\":\"Primate\",\"translations\":[]},\"synopsis\":{\"text\":\"In PRIMATE, a group of friends’ tropical vacation turns into a terrifying, primal tale of horror and survival.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In PRIMATE, a group of friends’ tropical vacation turns into a terrifying, primal tale of horror and survival.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong bloody violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":89,\"trailerUrl\":\"https://www.youtube.com/watch?v=L9Odp8RvbLo\",\"displayPriority\":10,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000017524\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017525\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017526\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017527\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017528\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017529\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017530\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017532\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017533\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002732\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"67aa2582-ac18-4747-8f49-005d24853af3\",\"corporateId\":null},\"hopk\":\"HO00008273\",\"hoCode\":\"A000009367\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00008280\",\"title\":{\"text\":\"LOTR: The Two Towers - Extended Edition\",\"translations\":[]},\"synopsis\":{\"text\":\"While Frodo and Sam edge closer to Mordor with the help of the shifty Gollum, the divided fellowship makes a stand against Sauron's new ally, Saruman, and his hordes of Isengard.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"While Frodo and Sam edge closer to Mordor with the help of the shifty Gollum, the divided fellowship makes a stand against Sauron's new ally, Saruman, and his hordes...\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-16\",\"runtimeInMinutes\":235,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000675\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000857\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000858\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000859\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000860\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000861\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000862\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000863\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000864\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000866\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000867\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000868\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000869\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000871\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000872\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009623\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000138\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002394\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000009\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00008280\",\"hoCode\":\"A000009374\",\"eventId\":null,\"distributorName\":\"WARNER BROS DISTRIBUTORS LTD\"},{\"id\":\"HO00008325\",\"title\":{\"text\":\"Return to Silent Hill\",\"translations\":[]},\"synopsis\":{\"text\":\"When a mysterious letter calls him back to Silent Hill in search of his lost love, James finds a once-recognizable town and encounters terrifying figures both familiar and new, and begins to question his own sanity.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When a mysterious letter calls him back to Silent Hill in search of his lost love, James finds a once-recognizable town and encounters terrifying figures.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong horror, gore, language\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":105,\"trailerUrl\":null,\"displayPriority\":11,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003901\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004117\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012885\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012886\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017616\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017617\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017618\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"0004c65f-7fef-466d-afe4-7bab15b10fa6\",\"corporateId\":null},\"hopk\":\"HO00008325\",\"hoCode\":\"A000009423\",\"eventId\":null,\"distributorName\":\"ENTERTAINMENT FILM DISTRIBUTOR\"},{\"id\":\"HO00008327\",\"title\":{\"text\":\"No Other Choice\",\"translations\":[]},\"synopsis\":{\"text\":\"Man-su (Lee Byung Hun), a specialist in paper manufacturing with 25 years of experience, is so satisfied with life that he can truthfully tell himself, “I’ve got it all.” While happily passing his days with his wife Miri (Son Yejin), their two children and two dogs, Man-su is suddenly informed by his company that he has been fired.\\n“We’re sorry. We have no other choice.”\\nFeeling shocked as if his head had been cut off by an ax, Man-su vows to find himself a new job within the next three months for the sake of his family. Despite his firm resolve to turn his life around, Man-su spends over a year drifting from one job interview after another, and working at a retail store. He eventually finds himself in danger of losing the very house that he struggled so hard to buy.\\nDesperate, he visits Moon Paper out of the blue and tries to hand over his CV, but he just ends up getting humiliated by line manager Choi Sun-chul (Park Hee Soon). Man-su knows he is better qualified than anyone to work at Moon Paper, so he comes to a certain decision.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, violence, injury detail, sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":139,\"trailerUrl\":null,\"displayPriority\":13,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000010701\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016863\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017619\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017620\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017621\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017622\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000009\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e660de4a-88af-472a-a1e1-57ffb9dcbb49\",\"corporateId\":null},\"hopk\":\"HO00008327\",\"hoCode\":\"A000009425\",\"eventId\":null,\"distributorName\":\"MUBI UK Ltd\"},{\"id\":\"HO00008344\",\"title\":{\"text\":\"Infinite Icon: A Visual Memoir\",\"translations\":[]},\"synopsis\":{\"text\":\"Infinite Icon: A Visual Memoir brings us an intimate, nuanced and candid portrait of Paris Hilton, one of the most famous figures of 21st century pop culture, and one of its most misunderstood. When Hilton first gained notice as a club kid in the late 1990s, people didn’t know what to make of her. With no template for this new kind of celebrity, the paparazzi and the public wrote her off as nothing more than a spoiled party girl. The reality was more complicated: for the painfully shy Hilton, nightclubs were a refuge, a place where music provided escape, joy, acceptance and community.  \\nDirectors Bruce Robertson and JJ Duncan’s artfully crafted documentary follows Hilton as she returns to music in 2024 with her first-ever concert at the Hollywood Palladium and places the event in the larger context of her life as a public figure who was by turns idolized and vilified. Drawing on decades of personal archives, intimate interviews, vérité documentary footage, and the concert itself, the film uncovers the ways Hilton has navigated both cultural adoration and cruelty. Infinite Icon: A Visual Memoir finds Hilton speaking her truth while exploring how music –as inspiration, aspiration, lifeline –became the throughline that has sustained her survival, reinvention, and resilience. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Infinite Icon: A Visual Memoir brings us an intimate, nuanced and candid portrait of Paris Hilton, one of the most famous figures of 21st century pop culture.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate sex references, language, references to sexually abusive behaviour\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":118,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000017638\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017639\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017640\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017641\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017642\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017643\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017644\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017645\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017646\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000005\",\"0000000008\",\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e1e7ed73-30cc-4b9e-9bce-5363dd2c84aa\",\"corporateId\":null},\"hopk\":\"HO00008344\",\"hoCode\":\"A000009442\",\"eventId\":\"0000000001\",\"distributorName\":\"CinemaLive Limited\"},{\"id\":\"HO00008348\",\"title\":{\"text\":\"Another World (Cantonese)\",\"translations\":[]},\"synopsis\":{\"text\":\"After death and before reincarnation, the souls of the deceased pass through a fantastical realm known as, Another World. GUDO is a spirit tasked with guiding these transient souls to their next life. \\nWhile helping a young girl named YURI, he learns that humans have emotions that he does not understand, and his curiosity is stirred. He befriends Yuri and promises to always be with her through her difficult journey. \\nHowever, Yuri harbors a rare curse that could threaten humanity and upset the balance of the universe if she is fully consumed by anger. Through Gudo’s revelation, Yuri discovers a grave sin she committed in her past life. Unable to forgive herself, her growing anger risks unleashing the hidden curse. Charged by Goddess Mira to prevent this threat, Gudo embarks on a perilous thousand-year mission. \\nDespite constant conflicts with his guardian, Dark Sky, Gudo insists on giving Yuri a second chance at the risk of his life. He learns that forgiveness and inner peace is the only way to overcome the anger within and heal a broken world. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Tasked to help transient souls through Another World to their reincarnation, the spirit GUDO meets a young girl called YURI, and embarks on a dangerous journey.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, suicide\",\"translations\":[]},\"releaseDate\":\"2026-01-29\",\"runtimeInMinutes\":111,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007432\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010662\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011602\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017652\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017653\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017654\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017655\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"17714\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000011\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"3dceaa5a-a39d-4c4c-96fc-f1219e6c2820\",\"corporateId\":null},\"hopk\":\"HO00008348\",\"hoCode\":\"A000009446\",\"eventId\":null,\"distributorName\":\"Central City Media LTD\"},{\"id\":\"HO00008358\",\"title\":{\"text\":\"Nouvelle Vague\",\"translations\":[]},\"synopsis\":{\"text\":\"A playful, poignant love letter to cinema, Nouvelle Vague reimagines the making of Jean-Luc Godard’s Breathless in an exuberant exploration of the youthful rebellion and creative chaos that shaped the French New Wave.\\n\\nDirected by Richard Linklater, starring Zoey Deutch, Guillaume Marbeck, and Aubry Dullin.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A playful, poignant love letter to cinema, Nouvelle Vague reimagines the making of Jean-Luc Godard’s Breathless in an exuberant exploration of the youthful rebellion.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":106,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002938\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017657\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017658\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017659\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017660\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017661\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017662\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017663\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000009\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"83a62a86-a59e-4457-a8fb-ed533cce124e\",\"corporateId\":null},\"hopk\":\"HO00008358\",\"hoCode\":\"A000009458\",\"eventId\":null,\"distributorName\":\"ALTITUDE\"},{\"id\":\"HO00008366\",\"title\":{\"text\":\"Melania\",\"translations\":[]},\"synopsis\":{\"text\":\"Offering unprecedented access to the 20 days leading up to the 2025 Presidential Inauguration — through the eyes of the First Lady-elect herself — step inside Melania Trump's world as she orchestrates inauguration plans, navigates the complexities of the White House transition, and reenters public life with her family. With exclusive footage capturing critical meetings, private conversations, and never-before-seen environments, Mrs. Trump returns to one of the world's most powerful roles.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Offering unprecedented access to the 20 days leading up to the 2025 Presidential Inauguration — through the eyes of the First Lady-elect herself.\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild bad language, upsetting scenes, brief sexual violence references\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":104,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002852\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017676\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017677\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000008\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e0b807dc-6fff-41b2-90d7-5637351348c3\",\"corporateId\":null},\"hopk\":\"HO00008366\",\"hoCode\":\"A000009466\",\"eventId\":null,\"distributorName\":\"SHEAR ENTERTAINMENT\"},{\"id\":\"HO00008390\",\"title\":{\"text\":\"Iron Lung\",\"translations\":[]},\"synopsis\":{\"text\":\"The stars are gone. The planets have disappeared. Only individuals aboard space stations or starships were left to give the end a name - The Quiet Rapture. After decades of decay and crumbling infrastructure, the Consolidation of Iron has made a discovery on a barren moon designated AT-5. An ocean of blood.\\u2028 Hoping to discover desperately needed resources they immediately launch an expedition. A submarine is crafted and a convict is welded inside. Due to the pressure and depth of the ocean the forward viewport has been encased in metal. If successful, they will earn their freedom. If not, another will follow. This will be the 13th expedition.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The stars are gone. The planets have disappeared. Only those on space stations or starships were left to give the end a name. The Quiet Rapture. The universe dims.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, bloody images, threat\",\"translations\":[]},\"releaseDate\":\"2026-01-29\",\"runtimeInMinutes\":125,\"trailerUrl\":null,\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000017729\",\"roles\":[\"Actor\",\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000014\",\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4187d757-ba5e-42e9-9ba3-f3aa56e6b45f\",\"corporateId\":null},\"hopk\":\"HO00008390\",\"hoCode\":\"A000009492\",\"eventId\":null,\"distributorName\":\"(New) Iron Lung Inc\"}],\"castAndCrew\":[{\"id\":\"0000003440\",\"name\":{\"givenName\":\"Byron\",\"familyName\":\"Howard\",\"middleName\":null}},{\"id\":\"0000003441\",\"name\":{\"givenName\":\"Jared\",\"familyName\":\"Bush\",\"middleName\":null}},{\"id\":\"0000003443\",\"name\":{\"givenName\":\"Yvett Merino\",\"familyName\":\"Flores\",\"middleName\":null}},{\"id\":\"0000006395\",\"name\":{\