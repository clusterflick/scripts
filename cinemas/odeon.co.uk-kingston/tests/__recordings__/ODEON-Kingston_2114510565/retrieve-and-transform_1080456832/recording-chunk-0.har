            "text": "{\"businessDate\":\"2026-08-11\",\"showtimes\":[{\"id\":\"536-121760\",\"schedule\":{\"businessDate\":\"2026-08-11\",\"startsAt\":\"2026-08-11T19:15:00+01:00\",\"endsAt\":\"2026-08-11T22:25:00+01:00\",\"filmStartsAt\":\"2026-08-11T19:40:00+01:00\",\"filmEndsAt\":\"2026-08-11T22:25:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"536-5-150\",\"filmId\":\"HO00008932\",\"siteId\":\"536\",\"screenId\":\"536-5\",\"areaCategories\":[{\"areaCategoryId\":\"536-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"536-126825\",\"schedule\":{\"businessDate\":\"2026-08-11\",\"startsAt\":\"2026-08-11T19:30:00+01:00\",\"endsAt\":\"2026-08-11T21:51:00+01:00\",\"filmStartsAt\":\"2026-08-11T19:55:00+01:00\",\"filmEndsAt\":\"2026-08-11T21:51:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"536-1-163\",\"filmId\":\"HO00009197\",\"siteId\":\"536\",\"screenId\":\"536-1\",\"areaCategories\":[{\"areaCategoryId\":\"536-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"536-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000187\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"536\",\"name\":{\"text\":\"Kingston\",\"translations\":[]},\"location\":{\"latitude\":51.4117,\"longitude\":-0.2992},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Kingston@odeonuk.com\",\"address\":{\"line1\":\"The Rotunda\",\"line2\":\"Clarence Street\",\"city\":\"Kingston-upon-Thames\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008932\",\"title\":{\"text\":\"Andre Rieu - Summer 2026: Viva Maastricht!\",\"translations\":[]},\"synopsis\":{\"text\":\"This year, André Rieu celebrates a spectacular milestone — the 20th anniversary of his iconic summer concerts on the magnificent Vrijthof square. Captured live in his beloved hometown, this brand-new cinema event marks two decades of music and unforgettable magical summer nights. Viva Maastricht! is a joyful tribute to the city where it all began. Joined by his world-renowned Johann Strauss Orchestra and a vibrant ensemble of artists, André brings the spirit, culture, and warmth of his hometown to life in a dazzling new concert filled with emotion and wonder. From timeless waltzes to soul-stirring classics, this landmark anniversary concert promises an evening of passion, joy, and togetherness. Be part of this historic celebration as the Vrijthof once again transforms into a breathtaking open-air ballroom — only in cinemas this summer.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"This year, André Rieu celebrates a spectacular milestone — the 20th anniversary of his iconic summer concerts on the magnificent Vrijthof square.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-07\",\"runtimeInMinutes\":165,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"HO00000335\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000336\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a73b32c9-cde1-4f0c-9969-473043393c2b\",\"corporateId\":null},\"hopk\":\"HO00008932\",\"hoCode\":\"A000010077\",\"eventId\":\"0000000001\",\"distributorName\":\"PIECE OF MAGIC\"},{\"id\":\"HO00009197\",\"title\":{\"text\":\"Nimrods: A Green Day Comedy\",\"translations\":[]},\"synopsis\":{\"text\":\"When Tommy receives a phone call inviting his band to open for Green Day on New Years Eve, he doesn’t realise it’s an elaborate prank by his older brother, Wayne. Desperate to believe his life is about to change, Tommy steals Wayne's car and begins driving his band from Kansas City to Los Angeles, hell bent on getting there in three days. What follows is a rowdy and uproarious road trip across America, inspired by Green Day’s early days of touring in a van, years before the release of their breakout record Dookie.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Three high school friends go on a road trip thinking that their band is opening for Green Day on New Year’s Eve. Inspired by Green Day’s real-life adventures...\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-11\",\"runtimeInMinutes\":116,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004766\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007690\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010773\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019627\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019628\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019629\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019630\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019631\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019632\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019633\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019634\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019635\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019636\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019637\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000929\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4c4d85ca-bbaa-49b3-8