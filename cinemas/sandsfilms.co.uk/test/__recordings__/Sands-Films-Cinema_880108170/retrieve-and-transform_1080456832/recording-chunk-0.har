or_new_virtual_content\":true,\"livestream_mode\":\"embedded\",\"livestream_embed_code\":\"<div itemscope itemtype=\\\"https://schema.org/VideoObject\\\" style=\\\"position:relative;padding-bottom:56.25%;\\\"><meta itemprop=\\\"name\\\" content=\\\"Land &amp; Freedom\\\"><meta itemprop=\\\"description\\\" content=\\\"This is the live stream from Sands Films Cinema Club\\\"><meta itemprop=\\\"uploadDate\\\" content=\\\"2026-06-23T18:42:10.000Z\\\"><meta itemprop=\\\"thumbnailUrl\\\" content=\\\"https://s1.dmcdn.net/v/btA-w1gElaFReWFVE/x1080\\\"><meta itemprop=\\\"duration\\\" content=\\\"P8964S\\\"><meta itemprop=\\\"embedUrl\\\" content=\\\"https://geo.dailymotion.com/player/x15jgk.html?video=k3VnIH6yznzShAGZjIe\\\"><meta itemprop=\\\"contentUrl\\\" content=\\\"https://www.dailymotion.com/crawler/video/xai6yt6\\\"><iframe frameborder=\\\"0\\\" width=\\\"100%\\\" height=\\\"100%\\\" style=\\\"width:100%;height:100%;position:absolute;left:0px;top:0px;overflow:hidden;\\\" src=\\\"https://geo.dailymotion.com/player/x15jgk.html?video=k3VnIH6yznzShAGZjIe&playlist=x7ilc3\\\" allowfullscreen allow=\\\"autoplay; fullscreen; picture-in-picture; web-share\\\" title=\\\"Dailymotion video player – Land &amp; Freedom\\\"></iframe></div>\"}],\"updated_at\":\"2026-06-23T21:41:20.514Z\",\"is_virtual\":true,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":true,\"allow_preorder\":true,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_closed\":false,\"virtual_balloting_inline_during_playback\":false,\"virtual_balloting_consolidated\":false,\"use_default_event_bucket_preroll\":false,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":false,\"use_default_event_bucket_postroll\":false,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":false,\"virtual_show_donate_prompt\":true,\"virtual_donate_message\":\"Support Sands Films Cinema Club and help cover our costs with an optional donation.\",\"virtual_intervals\":null,\"display_ads\":[{\"url\":null,\"image\":\"https://static-a.eventive.org/0cd8cbc4f3765d7ed2b39776eeb50f77.png\"},{\"url\":null,\"image\":\"https://static-a.eventive.org/ba99459bad4866fcb064527ed382b2c0.png\"}],\"images\":{\"still\":\"https://static-a.eventive.org/1779390628774temp-1779390628731-default.jpg\"},\"custom_email_text\":\"<p><strong>Thank you for booking this online presentation.</strong></p><p><br></p><p><strong>The link will be live some 15 minutes before the advertised time; it will remain active for 7 days for you to complete watching.</strong></p><p><strong>The Cinema Club has an alternative back up stream here: </strong><a href=\\\"https://www.sandsfilms.co.uk/the-cinema-club/next-screening-watch-live.html\\\" target=\\\"_blank\\\"><strong>https://www.sandsfilms.co.uk/the-cinema-club/next-screening-watch-live.html</strong></a></p><p><br></p><p><br></p><p><strong><u>Please feel free to send feedbacks, comments or complaints:</u> filmclub@sandsfilms.co.uk</strong></p>\",\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a3a95760bf3c799594d1f27\",\"event_bucket\":\"6161a93f49ddeb00acf3f48c\",\"timezone\":\"Europe/London\",\"name\":\"Caudillo: Sands Films Cinema Club online presentation\",\"description\":\"<p class=\\\"ql-align-center\\\">This page is to obtain access to the broadcast of this Sands Films Cinema Club presentation</p><p class=\\\"ql-align-center\\\"><br></p><h1 class=\\\"ql-align-center\\\">CAUDILLO</h1><p class=\\\"ql-align-center\\\">This is an important Spanish documentary made in the early 70's in semi clandestinity and released immediately after Franco's death.</p><p class=\\\"ql-align-center\\\"><strong class=\\\"ql-size-large\\\">Notice: The subtitles of this film are not perfect.</strong></p><p><br></p><p class=\\\"ql-align-center\\\"><br></p><h2>Films about the Spanish Civil War</h2><p><img src=\\\"https://storage.googleapis.com/eventive-static/b4747d9cff5ee95ffeddb1a030785800.png\\\">2026 marks the 90th anniversary of the start of the Spanish Civil War; Sands Films Cinema Club presents three series of films about this tragedy. The first series will look at the war as seen from outside, by non-Spanish filmmakers. The second selection of films will introduce films about the war made in Spain under Franco. The final series will look a the representation of the war by Spanish filmmakers, after Franco.</p><p><br></p><p>Caudillo is a documentary film by Spanish film director Basilio Martín Patino. It follows the military and political career of Francisco Franco and the most important moments of the Spanish Civil War. It uses footage from both sides of the war, music from the period and voice-over testimonies of various people.</p><p><br></p><ul><li><em>Year:</em></li><li>1977</li><li><em>Runtime:</em></li><li>105&nbsp;minutes</li><li><em>Language:</em></li><li>Spanish</li><li><em>Director:</em></li><li>Basilio Martín Patino</li><li><em>Screenwriter:</em></li><li>Basilio Martín Patino, José Luis García Sánchez</li><li><em>Cast:</em></li><li>Carlos Revilla, Francisco Franco, Vladimir Lenin</li><li><em>Cinematographer:</em></li><li>Alfredo Mayo</li><li><em>Editor:</em></li><li>José Luis Peláez</li></ul><h1 class=\\\"ql-align-center\\\"><br></h1>\",\"short_description\":\"The Spanish Civil War seen from within\",\"venue\":{},\"is_dated\":true,\"start_time\":\"2026-06-30T18:30:00.000Z\",\"end_time\":\"2026-07-31T19:30:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6a00e1c17e9ee528f15d8298\",\"name\":\"The Spanish Civil War\",\"color\":\"#608ea4\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_u