_content_postroll_visible\":false,\"virtual_show_donate_prompt\":true,\"virtual_donate_message\":\"Support Sands Films Cinema Club and help cover our costs with an optional donation.\",\"virtual_intervals\":null,\"display_ads\":[{\"url\":null,\"image\":\"https://static-a.eventive.org/881c138298fe18dd7f0396050e72d4a0.png\"}],\"images\":{\"still\":\"https://static-a.eventive.org/1766856795379temp-1766856795344-default.jpg\"},\"custom_email_text\":\"<p><strong>Thank you for booking this online presentation.</strong></p><p><br></p><p><strong>The link will be live some 15 minutes before the advertised time; it will remain active for 7 days for you to complete watching.</strong></p><p><strong>The Cinema Club has an alternative back up stream here: </strong><a href=\\\"https://www.sandsfilms.co.uk/the-cinema-club/next-screening-watch-live.html\\\" target=\\\"_blank\\\"><strong>https://www.sandsfilms.co.uk/the-cinema-club/next-screening-watch-live.html</strong></a></p><p><br></p><p><br></p><p><strong><u>Please feel free to send feedbacks, comments or complaints:</u> filmclub@sandsfilms.co.uk</strong></p>\",\"ledger_tags\":[],\"rules\":[]},{\"id\":\"694ededd6752c5d0cd2bcd77\",\"event_bucket\":\"6161a93f49ddeb00acf3f48c\",\"timezone\":\"Europe/London\",\"name\":\"1956: BABY DOLL: Sands Films Cinema Club online presentation\",\"description\":\"<p class=\\\"ql-align-center\\\">This page is to obtain access to the broadcast of this Sands Films Cinema Club presentation</p><h1 class=\\\"ql-align-center\\\"><strong>1956: BABY DOLL</strong></h1><p><br></p><h1 class=\\\"ql-align-center\\\"><strong>Elia Kazan began as an actor with the influential Group Theater in New York. He began directing, and he was on Broadway at a time of enormous change in the American theater, helping guide it with his direction of plays by the two ranking giants among playwrights,&nbsp;</strong>Tennessee Williams&nbsp;and&nbsp;Arthur Miller. 70 years ago, already world famous for his \\\"On The Waterfront\\\", \\\"A Streetcar Named Desire\\\" and \\\"East of Eden\\\" he directed Tennessee Williams' script of another highly controversial film: BABY DOLL.</h1><p class=\\\"ql-align-center\\\"><br></p>\",\"short_description\":\"1956: Elia Kazan and Tennessee Williams BABY DOLL\",\"venue\":{},\"is_dated\":true,\"start_time\":\"2026-01-27T19:45:00.000Z\",\"end_time\":\"2026-03-02T21:45:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"694946b284d0316a62c55fa4\",\"name\":\"Films of 1956\",\"color\":\"#08a6f1\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"trailer_url\":\"\",\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":0,\"ticket_buckets\":[{\"id\":\"694ededd6752c5d0cd2bcd78\",\"name\":\"Watch online, Please make a donation to help us cover costs.\",\"price\":100,\"unlimited\":true,\"quantity_sold\":56,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"max_quantity_per_person\":null,\"variable_price\":true,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true}],\"films\":[{\"id\":\"694ededd6752c5d0cd2bcd7e\",\"type\":\"livestream\",\"event_bucket\":\"6161a93f49ddeb00acf3f48c\",\"event_bucket_name\":\"Sands Films Studio\",\"owner_id\":\"60b1303f5955f7009b7cdff3\",\"name\":\"1956: BABY DOLL: Sands Films Cinema Club online presentation\",\"sort_key\":\"1956: BABY DOLL: Sands Films Cinema Club online presentation\",\"short_description\":\"1956: Elia Kazan and Tennessee Williams BABY DOLL\",\"unballoted\":tr