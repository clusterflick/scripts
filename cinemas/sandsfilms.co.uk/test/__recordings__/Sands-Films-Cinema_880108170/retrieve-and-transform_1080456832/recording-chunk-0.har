false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"653a28fed93ee8007364add5\"],\"is_active\":true}],\"films\":[{\"id\":\"695022d9706847bc8d5a69b5\",\"type\":\"film\",\"event_bucket\":\"6161a93f49ddeb00acf3f48c\",\"event_bucket_name\":\"Sands Films Studio\",\"owner_id\":\"60b1303f5955f7009b7cdff3\",\"name\":\"The Ogre of Athens\",\"sort_key\":\"Ogre of Athens, The\",\"description\":\"On New Year’s Eve, a timid bank clerk is mistaken for a notorious criminal mastermind who rules the streets of Athens. Embracing his mistaken identity comes with a price though, as his unwitting white lie begins to unravel.\",\"cover_image\":\"https://static-a.eventive.org/f9d4bdeebc4287d8606dc57873b6619f.jpg?fit=crop&w=960&h=380\",\"poster_image\":\"https://static-a.eventive.org/0994482cadead44a0a127f4d7ae0201e.jpg?w=300\",\"still_image\":\"https://static-a.eventive.org/36106f38168ec32333b87535b87ea8f0.jpg\",\"unballoted\":false,\"details\":{\"language\":\"Greek\",\"runtime\":\"104\",\"year\":\"1956\"},\"credits\":{\"animator\":null,\"cast\":\"Dinos Iliopoulos, Margarita Papageorgiou, Giannis Argyris\",\"cinematographer\":null,\"co_producer\":null,\"composer\":\"Manos Hatzidakis\",\"director\":\"Nikos Koundouros\",\"editor\":\"Giorgos Tsaoulis, Nikos Koundouros\",\"executive_producer\":null,\"filmmaker\":null,\"music\":null,\"producer\":null,\"production_design\":null,\"screenwriter\":\"Iakovos Kabanellis\",\"sound_design\":null},\"expanded_credits\":[],\"tags\":[],\"imdb_id\":\"tt0124437\",\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2025-12-27T18:18:01.822Z\",\"updated_at\":\"2025-12-27T18:18:14.624Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2025-12-27T18:36:55.715Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{\"cover\":\"https://static-a.eventive.org/1766860105299temp-1766860105252-cover.jpg\",\"avatar\":\"https://static-a.eventive.org/1766860105480temp-1766860105446-avatar.jpg\"},\"custom_email_text\":\"<p>Thank you for reserving a seat at Sands Films Cinema Club.</p><p><br></p><p>Should you decide to cancel your attendance please email <a href=\\\"mailto:filmclub@sandsfilms.co.uk\\\" target=\\\"_blank\\\">filmclub@sandsfilms.co.uk</a></p><p>We will send you an online access instead so you can watch the film live or later at a convenient time and will make your seat available to someone else.</p><p>Thank you for your support and your donation.</p><p><br></p>\",\"ledger_tags\":[],\"rules\":[]},{\"id\":\"69502121e4aeacb78e40f8d7\",\"event_bucket\":\"6161a93f49ddeb00acf3f48c\",\"timezone\":\"Europe/London\",\"name\":\"1956: MAN ON THE TRACKS: Sands Films Cinema Club online presentation\",\"description\":\"<p class=\\\"ql-align-center\\\">This page is to obtain access to the broadcast of this Sands Films Cinema Club presentation</p><h1 class=\\\"ql-align-center\\\"><strong class=\\\"ql-size-large\\\">1956: MAN ON THE TRACKS</strong></h1><p><strong class=\\\"ql-size-large\\\"><em>Man on the Tracks</em>&nbsp;begins famously with a man’s death. The man is Orzechowski, a former railway conductor—an older man, who haunts the local station post. He is run down on the tracks by the very train he used to engineer, which his replacement, recognizing him, brings to a screeching halt. How did this happen? Two possibilities are suicide and sabotage.</strong></p><p class=\\\"ql-align-center\\\"><strong class=\\\"ql-size-large\\\">Director Andrzej Munk died in a road accident in 1961, ending the career of the Polish filmmaker whom Roman Polanski considered his mentor.</strong></p>\",\"short_description\":\"1956: MAN ON THE TRACKS, a classic of modern Polish cinema\",\"venue\":{},\"is_dated\":true,\"start_time\":\"2026-02-17T19:45:00.000Z\",\"end_time\":\"2026-03-23T21:45:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"694946b284d0316a62c55fa4\",\"name\":\"Films of 1956\",\"color\":\"#08a6f1\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"trailer_url\":\"\",\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":0,\"ticket_buckets\":[{\"id\":\"69502121e4aeacb78e40f8d8\",\"name\":\"Watch online, Please make a donation to help us cover costs.\",\"price\":100,\"unlimited\":true,\"quantity_sold\":6,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"max_quantity_per_person\":null,\"variable_price\":true,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true}],\"films\":[{\"id\":\"69502121e4aeacb78e40f8de\",\"type\":\"livestream\",\"event_bucket\":\"6161a93f49ddeb00acf3f48c\",\"event_bucket_name\":\"Sands Films Studio\",\"owner_id\":\"60b1303f5955f7009b7cdff3\",\"name\":\"1956: MAN ON THE TRACKS: Sands Films Cinema Club online presentation\",\"sort_key\":\"1956: MAN ON THE TRACKS: Sands Films Cinema Club online presentation\",\"short_description\":\"1956: MAN ON THE TRACKS, a classic of mode