:0,\"unlimited\":true,\"quantity_sold\":0,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"653a28fed93ee8007364add5\"],\"is_active\":true}],\"films\":[{\"id\":\"68d4f0954a3cb4d4fa5edba6\",\"type\":\"film\",\"event_bucket\":\"6161a93f49ddeb00acf3f48c\",\"event_bucket_name\":\"Sands Films Studio\",\"owner_id\":\"60b1303f5955f7009b7cdff3\",\"name\":\"Yallah Gaza\",\"sort_key\":\"Yallah Gaza\",\"description\":\"Gaza is a small palestinian territory where more than 2 millions people live. Completely locked up by Israel since 2007, its society is still structured and organized, but for how many more times ?\",\"poster_image\":\"https://static-a.eventive.org/66477c75e21fbbf6d1688ad94dd79f2d.jpg?w=300\",\"unballoted\":false,\"details\":{\"language\":\"Arabic, English, French\",\"runtime\":\"101\",\"year\":\"2023\"},\"credits\":{\"animator\":null,\"cast\":null,\"cinematographer\":null,\"co_producer\":null,\"composer\":null,\"director\":\"Roland Nurier\",\"editor\":null,\"executive_producer\":null,\"filmmaker\":null,\"music\":null,\"producer\":null,\"production_design\":null,\"screenwriter\":\"Roland Nurier\",\"sound_design\":null},\"expanded_credits\":[],\"tags\":[],\"imdb_id\":\"tt29381478\",\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2025-09-25T07:34:45.800Z\",\"updated_at\":\"2025-09-25T07:35:02.936Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"68d4ef17467dba04200a1eec\",\"type\":\"film\",\"event_bucket\":\"6161a93f49ddeb00acf3f48c\",\"event_bucket_name\":\"Sands Films Studio\",\"owner_id\":\"60b1303f5955f7009b7cdff3\",\"name\":\"London Palestine Film Festival 2025\",\"sort_key\":\"London Palestine Film Festival 2025\",\"description\":\"<p class=\\\"ql-align-center\\\"><strong>LONDON PALESTINE FILM FESTIVAL 2025</strong></p><p class=\\\"ql-align-center\\\"><strong>NOVEMBER 14 - 28</strong></p><p class=\\\"ql-align-center\\\"><a href=\\\"https://www.palestinefilm.org.uk\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\"><strong>FULL LISTING OF THE FESTIVAL CLICK HERE</strong></a></p><p class=\\\"ql-align-center\\\">London Palestine Film Festival (LPFF) was established in the late 90s and continued to run until it took a hiatus in 2014. The festival returned bigger and better in 2018.</p><p class=\\\"ql-align-center\\\">Sands Films Cinema Club are proud to make a small contribution to the London Palestine Festival by screening two documentaries by French filmmaker Roland Nurier.</p>\",\"cover_image\":\"https://static-a.eventive.org/17587875040984bd5990b3d6ffb3ad120.jpg\",\"poster_image\":\"https://static-a.eventive.org/1758785620813e7d387221de3299d1b4a.jpg\",\"still_image\":\"https://static-a.eventive.org/17587856352519230df70bd45031af0bd.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2025\"},\"credits\":{},\"expanded_credits\":[],\"tags\":[{\"id\":\"66fd457865cb3f003a8b44b2\",\"name\":\"Palestine & Middle East\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"66fd459245ac6a0099e8c4f6\",\"name\":\"Special Event\",\"color\":\"#7fff36\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2025-09-25T07:28:23.816Z\",\"updated_at\":\"2025-09-25T08:05:04.253Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2025-09-25T08:27:06.514Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_ev