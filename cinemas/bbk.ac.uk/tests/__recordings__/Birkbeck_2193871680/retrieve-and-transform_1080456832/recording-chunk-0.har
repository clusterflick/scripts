\n    \n      \n    \n      \n        <li>\n          <a href=\"/\">Birkbeck, University of London</a>\n        </li>\n      \n    \n    <li class=\"menu-text\">Events</li>\n  </ol>\n</nav>\n\n\n    <div class=\"page-topper\"></div>\n\n    <h1 class=\"row column v-space-1\">Events</h1>\n\n    <div class=\"row column\"><hr /></div>\n\n    \n    <div class=\"row\">\n    <div class=\"column medium-4\">\n      <h2 class=\"h4-size\">Filter</h2>\n    </div>\n    <div class=\"column medium-7 large-6\">\n      <form action=\"\">\n        \n        <label class=\"show-for-sr\" for=\"tags\">Filter by tags</label>\n        <select name=\"tag\"\n        class=\"js-chosen\"\n        id=\"tags\"\n        data-placeholder=\"Select some tags\"\n        multiple=\"True\"\n        >\n    \n        <optgroup label=\"Schools\">\n        \n            <option\n                value=\"767\"\n                \n                \n            >\n                Birkbeck Business School\n            </option>\n        \n            <option\n                value=\"764\"\n                \n                \n            >\n                Birkbeck Centre for Counselling\n            </option>\n        \n            <option\n                value=\"420\"\n                \n                \n            >\n                Birkbeck Graduate Research School (BGRS)\n            </option>\n        \n            <option\n                value=\"766\"\n                \n                \n            >\n                Birkbeck Law School\n            </option>\n        \n            <option\n                value=\"762\"\n                \n                \n            >\n                Faculty of Business and Law\n            </option>\n        \n            <option\n                value=\"761\"\n                \n                \n            >\n                Faculty of Humanities and Social Sciences\n            </option>\n        \n            <option\n                value=\"760\"\n           