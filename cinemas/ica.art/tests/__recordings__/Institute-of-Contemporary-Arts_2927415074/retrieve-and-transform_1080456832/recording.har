aded event: ' + parseInt(d * 10000) / 10000  + ' seconds');\n                })\n                window.addEventListener('load', ()=>{\n                        let d = Date.now() / 1000 - request_time_float;\n                        console.log('load event: ' + parseInt(d * 10000) / 10000  + ' seconds');\n                })\n        </script>\n\t</div>\n\t</body>\n</html>\n"
