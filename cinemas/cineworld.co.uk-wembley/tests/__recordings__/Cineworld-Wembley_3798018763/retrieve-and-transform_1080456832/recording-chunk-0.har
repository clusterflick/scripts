web.img.acsta.net/medias/nmedia/18/87/85/79/19973235.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/85/79/19973234.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/85/79/19973233.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/85/79/19973232.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/85/79/19973231.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/85/79/19973230.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/85/79/19973229.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/85/79/19973228.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/85/79/19973227.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/00/02/33/92/autres4.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Alejandro\",\"lastName\":\"Amenábar\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"The Others\",\"synopsis\":\"On the secluded Isle of Jersey in the final days of World War II, a young woman waits in vain for her beloved husband to return from the front. Grace has been raising her two young children alone in her beautiful, cavernous Victorian mansion, the one place she believes them to be safe. But they are not safe. Not anymore. When a new trio of servants arrives to replace the crew that inexplicably disappeared, startling events begin to unfold. Grace's daughter reveals she has been communicating with unexplained apparitions that come and go in every room of the house. At first, Grace refuses to believe in her children's scary sightings, but soon, she too begins to sense that intruders are at large. Who are these numinous trespassers? And what do they want from Grace's family? In order to discover the truth, Grace must abandon all of her fears and beliefs and enter the otherworldly heart of the supernatural.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/0c/f6/0cf6864db644188e79f693a75762c193.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nicole\",\"lastName\":\"Kidman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elaine\",\"lastName\":\"Cassidy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christopher\",\"lastName\":\"Eccleston\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Fionnula\",\"lastName\":\"Flanagan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alakina\",\"lastName\":\"Mann\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Eric\",\"lastName\":\"Sykes\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"James\",\"lastName\":\"Bentley\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Renée\",\"lastName\":\"Asherson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gordon\",\"lastName\":\"Reid\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Keith\",\"lastName\":\"Allen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2001-11-02T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[],\"localRatings\":[],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":\"Horror Season 2026 The Others\",\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Others\",\"synopsis\":\"On the secluded Isle of Jersey in the final days of World War II, a young woman waits in vain for her beloved husband to return from the front. Grace has been raising her two young children alone in her beautiful, cavernous Victorian mansion, the one place she believes them to be safe. But they are not safe. Not anymore. When a new trio of servants arrives to replace the crew that inexplicably disappeared, startling events begin to unfold. Grace's daughter reveals she has been communicating with unexplained apparitions that come and go in every room of the house. At first, Grace refuses to believe in her children's scary sightings, but soon, she too begins to sense that intruders are at large. Who are these numinous trespassers? And what do they want from Grace's family? In order to discover the truth, Grace must abandon all of her fears and beliefs and enter the otherworldly heart of the supernatural.\",\"certificate\":\"12A\",\"casting\":[\"Nicole Kidman\",\"Elaine Cassidy\",\"Christopher Eccleston\",\"Fionnula Flanagan\",\"Alakina Mann\",\"Eric Sykes\",\"James Bentley\",\"Renée Asherson\",\"Gordon Reid\",\"Keith Allen\"],\"direction\":[\"Alejandro Amenábar\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.