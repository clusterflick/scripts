ull,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Enna Vilai\",\"synopsis\":\"The story follows Thavasi, a humble fisherman from Rameswaram who lives a quiet life with his family until he finds a gold pendant washed ashore. What initially seems like a blessing soon turns into a nightmare when false accusations threaten his peace and dignity, forcing him to stand up against a powerful system.\",\"certificate\":\"12A\",\"casting\":[\"Poornima Jayaram\",\"Kamalesh\",\"Karunas\",\"J S Kavi\",\"Kottachi\",\"Chethan Kumar\",\"Y.G. Mahendran\",\"Praveena\",\"Motta Rajendran\",\"Nizhalgal Ravi\"],\"direction\":[\"Sajeev Pazhoor\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-09-17T00:00:00.000Z\",\"advisory\":\"moderate violence, suicide references\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Lights On Entertainment\"},\"orderIndex\":66},{\"id\":\"1000050510\",\"title\":\"Epic - First Semester\",\"runtime\":9000,\"genres\":\"Comedy, Drama, Romance, Musical\",\"poster\":\"https://all.web.img.acsta.net/img/8d/aa/8daa687270325c6a372c1a91d6fe4c37.jpg\",\"__typename\":\"Movie\",\"altId\":[\"423678\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Aditya\",\"lastName\":\"Haasan\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Epic - First Semester\",\"synopsis\":\"EPIC - FIRST SEMESTER is a coming-of-age romantic drama set against the backdrop of student life abroad. It follows a young, introverted student whose life takes an unexpected turn when he meets a lively and contrasting personality, leading to love, friendship, and emotional challenges. The film explores first love, youthful dreams, family expectations, and the struggles of finding yourself while living away from home.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/8d/aa/8daa687270325c6a372c1a91d6fe4c37.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/b1594f5ed7e79c0d7b9421ef0348e03c.jpg\",\"__typename\":\"BOAppImage\"}]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anand\",\"lastName\":\"Deverakonda\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":null,\"lastName\":\"Sivaji\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Vaishnavi\",\"lastName\":\"Chaitanya\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Vasuki\",\"lastName\":null,\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Johannes\",\"lastName\":\"Imomoh\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-09-11T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"1000118530\",\"name\":\"Prathyangira Cinemas\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"infrequent strong language, moderate sex references\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Epic - First Semester\",\"synopsis\":\"EPIC - FIRST SEMESTER is a coming-of-age romantic drama set against the backdrop of student life abroad. It follows a young, introverted student whose life takes an unexpected turn when he meets a lively and contrasting personality, leading to love, friendship, and emotional challenges. The film explores first love, youthful dreams, family expectations, and the struggles of finding yourself while living away from home.\",\"certificate\":\"12A\",\"casting\":[\"Anand Deverakonda\",\"Sivaji\",\"Vaishnavi Chaitanya\",\"Vasuki\",\"Johannes Imomoh\"],\"direction\":[\"Aditya Haasan\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/b1594f5ed7e79c0d7b9421ef0348e03c.jpg\"],\"release\":\"2026-09-11T00:00:00.000Z\",\"advisory\":\"infrequent strong language, moderate sex references\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Prathyangira Cinemas\"},\"orderIndex\":68},{\"id\":\"314497\",\"title\":\"Fall 2: Deadpoint\",\"runtime\":6000,\"genres\":\"Thriller, Adventure\",\"__typename\":\"Movie\",\"altId\":[\"363655\"],\"poster\":\"https://all.web.img.acsta.net/img/14/1c/141cdbfb03d59276de6484b68b094219.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/3f/24/3f24821f41c46376ece469d4b3aa8a68.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/82/1a/821a7d0c1fa5a9ccd94d337a5b3b10ff.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/72/66/72664b5d8d7cb6ecf4bd134bd2f230d0.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ee/d1/eed19b75bb921ea509ea4806a534dc1d.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/dc/af/dcaf61ec7cb0590a67c6eb680ac5832d.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/68/d6/68d6e6d92b42263be17e2bbf80a7e99a.jpg\",\"__typename\":\"Image\"}],\"quadImages\":[\"https://all.web.img.acsta.net/img/e9/83/e983db3db9f561de02000159e38eb6db.jpg\"],\"direc