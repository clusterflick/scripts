a/18/73/27/10/19196673.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/73/27/10/19196672.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/73/27/10/19196671.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/73/27/10/19196670.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/73/27/10/19196669.jpg\"],\"heroImages\":[],\"release\":\"1996-08-09T00:00:00.000Z\",\"advisory\":\"Contains moderate horror and one use of strong language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"14396\",\"title\":\"Cineworld 30: Jerry Maguire\",\"runtime\":8280,\"genres\":\"Comedy drama, Romance\",\"__typename\":\"Movie\",\"altId\":[\"6915\"],\"poster\":\"https://all.web.img.acsta.net/img/9b/67/9b676127fafc8600b7ca37c40e6daf45.webp\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/09/80/19890461.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/09/80/19890460.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/09/80/19890457.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/09/80/19890455.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/09/80/19890454.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/09/80/19890452.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/62/39/18956388.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/62/39/18956387.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/62/39/18956386.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/62/39/18956385.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Cameron\",\"lastName\":\"Crowe\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Jerry Maguire\",\"synopsis\":\"Jerry Maguire is a man who knows the score. As a top agent at Sports Management International, Jerry is unquestionably a master of his universe. Trouble is -- Jerry's mind, mouth and soul are usually on automatic pilot. He's good at friendship, but (as his numerous ex-girlfriends testify) bad at intimacy. Still, there's absolutely nothing wrong with Jerry that a sudden dose of failure can't cure. A week after spontaneously writing a stirring, visionary mission statement for SMI entitled 'The Things We Think And Do Not Say: The Future of Our Business,' he's unceremoniously fired. Stripped of his job and a good measure of his identity, the tenacious but hanging-by-a-thread Jerry is forced to start from scratch. He's joined on his journey to redemption by two unlikely allies: Rod Tidwell, a second-tier wide receiver for the Arizona Cardinals; and Dorothy Boyd, a wistful 26-year-old single mother who departs her accountancy position with SMI for a very uncertain future with her new boss.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/9b/67/9b676127fafc8600b7ca37c40e6daf45.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/3c885a74c0ec128e9e3cb688d4e0624d.jpg\",\"__typename\":\"BOAppImage\"}]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tom\",\"lastName\":\"Cruise\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cuba\",\"lastName\":\"Gooding Jr.\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Renée\",\"lastName\":\"Zellweger\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kelly\",\"lastName\":\"Preston\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jerry\",\"lastName\":\"O'Connell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jay\",\"lastName\":\"Mohr\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bonnie\",\"lastName\":\"Hunt\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Regina\",\"lastName\":\"King\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jonathan\",\"lastName\":\"Lipnicki\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Eric\",\"lastName\":\"Stoltz\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"1997-01-13T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":\"Cineworld 30: Jerry Maguire\",\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Jerry Maguire\",\"synopsis\":\"Jerry Maguire is a man who knows the score. As a top agent at Sports Management International, Jerry is unquestionably a master of his universe. Trouble is -- Jerry's mind, mouth and soul are usually on automatic pilot. He's good at friendship, but (as his numerous ex-girlfriends testify) bad at intimacy. Still, there's absolutely nothing wrong with Jerry that a sudden dose of failure can't cure. A week after spontaneously writing a stirring, visionary mission statement for SMI entitled 'The Things We Think And Do Not Say: The Future of Our Business,' he's unceremoniously fired. Stripped of his job and a good measure of his identity, the tenacious but hanging-by-a-thread Jerry is forced to start from scratch. He's joined on his journey to redemption by two unlikely allies: Rod Tidwell, a second-tier wide receiver for the Arizona Cardinals; and Dorothy Boyd, a wistful 26-year-old single mother who departs her accountancy position with SMI for a very uncertain future with her new boss.\",\"certificate\":\"15\",\"casting\":[\"Tom Cruise\",\"Cuba Gooding Jr.\",\"Renée Zellweger\",\"Kelly Preston\",\"Jerry O'Connell\",\"Jay Mohr\",\"Bonnie Hunt\",\"Regina King\",\"Jonathan Lipnicki\",\"Eric Stoltz\"],\"direction\":[\"Cameron Crowe\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/medias/nmedia/18/87/09/80/19890461.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/09/80/19890460.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/09/80/19890457.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/09/80/19890455.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/09/80/19890454.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/09/80/19890452.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/66/62/39/18956388.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/66/62/39/18956387.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/66/62/39/18956386.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/66/62/39/18956385.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/3c885a74c0ec128e9e3cb688d4e0624d.jpg\"],\"release\":\"1997-01-13T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures UK\"},\"orderIndex\":23},{\"id\":\"182120\",\"title\":\"Cineworld 30: Perks of Being a Wallflower\",\"runtime\":6180,\"genres\":\"Comedy drama, Romance\",\"poster\":\"https://all.web.img.acsta.net/img/b4/86/b4868caffa513b9f937b7125574518ad.jpg\",\"__typename\":\"Movie\",\"altId\":[\"129907\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/91/06/13/20164328.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/93/52/64/20413257.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/93/52/64/20413256.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/93/52/64/20413255.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/93/52/64/20413254.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/93/52/64/20413253.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/93/52/64/20413252.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/93/52/64/20413251.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/93/52/64/20413250.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/93/52/64/20413249.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Stephen\",\"lastName\":\"Chbosky\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"The Perks of Being a Wallflower\",\"synopsis\":\"A funny and touching coming-of-age story based on the beloved best-selling novel by Stephen Chbosky, THE PERKS OF BEING A WALLFLOWER is a modern classic that captures the dizzying highs and crushing lows of growing up.  Starring Logan Lerman, Emma Watson and Ezra Miller, THE PERKS OF BEING A WALLFLOWER is a moving tale of love, loss, fear and hopeand the unforgettable friends that help us through life.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/b4/86/b4868caffa513b9f937b7125574518ad.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/129907_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Logan\",\"lastName\":\"Lerman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emma\",\"lastName\":\"Watson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ezra\",\"lastName\":\"Miller\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Erin\",\"lastName\":\"Wilhelmi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mae\",\"lastName\":\"Whitman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Paul\",\"lastName\":\"Rudd\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nina\",\"lastName\":\"Dobrev\",\"__typename\":\"Person\"},\"originalVoiceActor\"