ull,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":null,\"lastName\":\"Sathyaraj\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mahima\",\"lastName\":\"Nambiar\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mithun\",\"lastName\":\"Jai Sankar\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ravindra\",\"lastName\":\"Vijay\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bala\",\"lastName\":\"Saravanan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Stun\",\"lastName\":\"Siva\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Achyuth\",\"lastName\":\"Kumar\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-09-10T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"1000136327\",\"name\":\"TGS Cinemas Limited\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"moderate violence, injury detail, threat\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Mandaadi\",\"synopsis\":\"Mandaadi (Sea Wanderer) revolves around the lives, culture, and high-stakes survival of fishing communities along the southern coast of Tamil Nadu\",\"certificate\":\"12A\",\"casting\":[\"Soori\",\"Suhas\",\"Krish Hassan\",\"Sathyaraj\",\"Mahima Nambiar\",\"Mithun Jai Sankar\",\"Ravindra Vijay\",\"Bala Saravanan\",\"Stun Siva\",\"Achyuth Kumar\"],\"direction\":[\"Pugazhendhi Mathimaran\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-09-10T00:00:00.000Z\",\"advisory\":\"moderate violence, injury detail, threat\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"TGS Cinemas Limited\"}},{\"id\":\"1000043022\",\"title\":\"Met Opera 2026-27: Così fan tutte\",\"runtime\":14220,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"414792\"],\"poster\":\"https://all.web.img.acsta.net/img/e6/2c/e62cf35bf686af38ddd405e73b539023.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Phelim\",\"lastName\":\"McDermott\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Met Opera 2026-27: Così fan tutte\",\"synopsis\":\"The Met: Live in HD season continues with Mozart's satirical comedy of fickle young love. Phelim McDermott's \\\"colorful, inventive\\\" (The New York Times) staging, inspired by Coney Island in the 1950s, sets the uproarious story at a boardwalk amusement park, where the two pairs of lovers at the heart of the tale find themselves on one emotional—and literal—thrill ride after another. Soprano Federica Lombardi and mezzo-soprano Samantha Hankey sing Fiordiligi and Dorabella, opposite tenor Duke Kim and baritone Andrey Zhilikhovsky as Ferrando and Guglielmo. Bass-baritone Gerald Finley reprises his portrayal of the cynical Don Alfonso, with soprano Ana María Martínez as the witty maid Despina.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/e6/2c/e62cf35bf686af38ddd405e73b539023.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Federica\",\"lastName\":\"Lombardi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Samantha\",\"lastName\":\"Hankey\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ana María\",\"lastName\":\"Martínez (II)\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Duke\",\"lastName\":\"Kim\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Andrey\",\"lastName\":\"Zhilikhovsky\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gerald\",\"lastName\":\"Finley\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-10-03T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Metropolitan Opera: Così fan tutte (2026)\",\"synopsis\":\"The Met: Live in HD season continues with Mozart's satirical comedy of fickle young love. Phelim McDermott's \\\"colorful, inventive\\\" (The New York Times) staging, inspired by Coney Island in the 1950s, sets the uproarious story at a boardwalk amusement park, where the two pairs of lovers at the heart of the tale find themselves on one emotional—and literal—thrill ride after another. Soprano Federica Lombardi and mezzo-soprano Samantha Hankey sing Fiordiligi and Dorabella, opposite tenor Duke Kim and baritone Andrey Zhilikhovsky as Ferrando and Guglielmo. Bass-baritone Gerald Finley reprises his portrayal of the cynical Don Alfonso, with soprano Ana María Martínez as the witty maid Despina.\",\"certificate\":null,\"casting\":[\"Federica Lombardi\",\"Samantha Hankey\",\"Ana María Martínez (II)\",\"Duke Kim\",\"Andrey Zhilikhovsky\",\"Gerald Finley\"],\"direction\":[\"Phelim McDermott\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-10-03T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000043023\",\"title\":\"Met Opera 2026-27: La Fanciulla del West\",\"runtime\":11700,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"414793\"],\"poster\":\"https://all.web.img.acsta.net/img/fd/76/fd76c385312b3e038f64dd102419fb91.webp\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Richard\",\"lastName\":\"Jones\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Met Opera 2026-27: La Fanciulla del West\",\"synopsis\":\"Puccini's exhilarating drama of the Wild West returns in a new staging by Richard Jones, marking the company's first new production of La Fanciulla del West in more than 30 years. Soprano Sondra Radvanovsky makes her role debut as Minnie, the tough tavern owner with a heart of gold who finds love when she least expects it. Tenor SeokJong Baek is the dashing bandit who rambles into the remote California mining town to steal her heart, opposite baritone Christopher Maltman as the lawman determined to deliver justice—and win Minnie for himself. Maestro Keri-Lynn Wilson takes the podium to conduct one of opera's most action-packed adventures, live from the Met stage to cinemas worldwide.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/fd/76/fd76c385312b3e038f64dd102419fb91.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Vida\",\"lastName\":\"Miknevičiūtė\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"SeokJong\",\"lastName\":\"Baek\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christopher\",\"lastName\":\"Maltman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2027-01-23T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Metropolitan Opera: La Fanciulla Del West (2027)\",\"synopsis\":\"Puccini's exhilarating drama of the Wild West returns in a new staging by Richard Jones, marking the company's first new production of La Fanciulla del West in more than 30 years. Soprano Sondra Radvanovsky makes her role debut as Minnie, the tough tavern owner with a heart of gold who finds love when she least expects it. Tenor SeokJong Baek is the dashing bandit who rambles into the remote California mining town to steal her heart, opposite baritone Christopher Maltman as the lawman determined to deliver justice—and win Minnie for himself. Maestro Keri-Lynn Wilson takes the podium to conduct one of opera's most action-packed adventures, live from the Met stage to cinemas worldwide.\",\"certificate\":null,\"casting\":[\"Vida Miknevičiūtė\",\"SeokJong Baek\",\"Christopher Maltman\"],\"direction\":[\"Richard Jones\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2027-01-23T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000043020\",\"title\":\"Met Opera 2026-27: Macbeth\",\"runtime\":12540,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"414790\"],\"poster\":\"https://all.web.img.acsta.net/img/a1/f2/a1f2763211978c4f72c9b22aa02cce29.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Louisa\",\"lastName\":\"Proske\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Met Opera 2026-27: Macbeth\",\"synopsis\":\"Two of opera's most extraordinary artists return to The Met: Live in HD for Verdi's thrilling take on the immortal Shakespearean tale of the scheming couple determined to seize power at any cost. Baritone Quinn Kelsey is the Scottish king haunted by the ghosts of his murderous ascent to the throne, opposite soprano Lise Davidsen as the power-mad Lady Macbeth, whose ruinous ambition damns them both. Met Music Director Yannick Nézet-Séguin takes the podium for a penetrating production by Louisa Proske. Rounding out the all-star cast are tenor Freddie De Tommaso as Macduff and bass-baritone Ryan Speedo Green as Banquo.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/a1/f2/a1f2763211978c4f72c9b22aa02cce29.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lise\",\"lastName\":\"Davidsen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Freddie\",\"lastName\":\"De Tommaso\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Quinn\",\"lastName\":\"Kelsey\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ryan Speedo\",\"lastName\":\"Green\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-10-17T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Metropolitan Opera: Macbeth (2026)\",\"synopsis\":\"Two of opera's most extraordinary artists return to The Met: Live in HD for Verdi's thrilling take on the immortal Shakespearean tale of the scheming couple determined to seize power at any cost. Baritone Quinn Kelsey is the Scottish king haunted by the ghosts of his murderous ascent to the throne, opposite soprano Lise Davidsen as the power-mad Lady Macbeth, whose ruinous ambition damns them both. Met Music Director Yannick Nézet-Séguin takes the podium for a penetrating production by Louisa Proske. Rounding out the all-star cast are tenor Freddie De Tommaso as Macduff and bass-baritone Ryan Speedo Green as Banquo.\",\"certificate\":null,\"casting\":[\"Lise Davidsen\",\"Freddie De Tommaso\",\"Quinn Kelsey\",\"Ryan Speedo Green\"],\"direction\":[\"Louisa Proske\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-10-17T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000043025\",\"title\":\"Met Opera 2026-27: Manon\",\"runtime\":15840,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"414795\"],\"poster\":\"https://all.web.img.acsta.net/img/87/b5/87b5056eeb3dbbf42b1c4a344f173111.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Laurent\",\"lastName\":\"Pelly\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Met Opera 2026-27: Manon\",\"synopsis\":\"Following her radiant performance in Gounod's Roméo et Juliette which garnered raves for \\\"high notes that spun like liquid gold ... Sierra touched the operatic firmament\\\" (The New York Times) superstar soprano Nadine Sierra takes on another alluring French heroine, the irresistible title character of Massenet's passionate drama, live from the Met stage to cinemas worldwide. Leading tenor Matthew Polenzani is her idealistic lover, the Chevalier des Grieux, with rising-star baritone Andrzej Filończyk as her stalwart cousin, Lescaut, in a breathtaking staging by director Laurent Pelly.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/87/b5/87b5056eeb3dbbf42b1c4a344f173111.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nadine\",\"lastName\":\"Sierra\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Matthew\",\"lastName\":\"Polenzani\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Carlo\",\"lastName\":\"Bosi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Andrzej\",\"lastName\":\"Filończyk\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rod\",\"lastName\":\"Gilfry\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jean\",\"lastName\":\"Teitgen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2027-04-03T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Metropolitan Opera: Manon (2027)\",\"synopsis\":\"Following her radiant performance in Gounod's Roméo et Juliette which garnered raves for \\\"high notes that spun like liquid gold ... Sierra touched the operatic firmament\\\" (The New York Times) superstar soprano Nadine Sierra takes on another alluring French heroine, the irresistible title character of Massenet's passionate drama, live from the Met stage to cinemas worldwide. Leading tenor Matthew Polenzani is her idealistic lover, the Chevalier des Grieux, with rising-star baritone Andrzej Filończyk as her stalwart cousin, Lescaut, in a breathtaking staging by director Laurent Pelly.\",\"certificate\":null,\"casting\":[\"Nadine Sierra\",\"Matthew Polenzani\",\"Carlo Bosi\",\"Andrzej Filończyk\",\"Rod Gilfry\",\"Jean Teitgen\"],\"direction\":[\"Laurent Pelly\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2027-04-03T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000043026\",\"title\":\"Met Opera 2026-27: Otello\",\"runtime\":12060,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"414796\"],\"poster\":\"https://all.web.img.acsta.net/img/ee/0d/ee0d8b22e97d5017882cac6b6d0a4180.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Bartlett\",\"lastName\":\"Sher\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Met Opera 2026-27: Otello\",\"synopsis\":\"One of today's leading dramatic tenors, Brian Jagde, takes on the tour-de-force title role of what many consider the ultimate Italian opera, live to cinemas worldwide. Verdi's monumental Shakespearean tragedy also features soprano Ailyn Pérez in her company role debut as the long-suffering Desdemona, alongside baritone Artur Ruciński as the sinister Iago. Michele Mariotti leads the full forces of the Met Orchestra and Chorus in the exhilarating score.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/ee/0d/ee0d8b22e97d5017882cac6b6d0a4180.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ailyn\",\"lastName\":\"Pérez\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brian\",\"lastName\":\"Jagde\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Artur\",\"lastName\":\"Rucinski\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Deborah\",\"lastName\":\"Nansteel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Piotr\",\"lastName\":\"Buszewski\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Vitalij\",\"lastName\":\"Kowaljow\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2027-04-24T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Metropolitan Opera: Otello (2027)\",\"synopsis\":\"One of today's leading dramatic tenors, Brian Jagde, takes on the tour-de-force title role of what many consider the ultimate Italian opera, live to cinemas worldwide. Verdi's monumental Shakespearean tragedy also features soprano Ailyn Pérez in her company role debut as the long-suffering Desdemona, alongside baritone Artur Ruciński as the sinister Iago. Michele Mariotti leads the full forces of the Met Orchestra and Chorus in the exhilarating score.\",\"certificate\":null,\"casting\":[\"Ailyn Pérez\",\"Brian Jagde\",\"Artur Rucinski\",\"Deborah Nansteel\",\"Piotr Buszewski\",\"Vitalij Kowaljow\"],\"direction\":[\"Bartlett Sher\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2027-04-24T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000043027\",\"title\":\"Met Opera 2026-27: Parsifal\",\"runtime\":21900,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"414797\"],\"poster\":\"https://all.web.img.acsta.net/img/e0/64/e064e85d6fb9741be53e4188a52f0f92.webp\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"François\",\"lastName\":\"Girard\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Met Opera 2026-27: Parsifal\",\"synopsis\":\"A profound philosophical meditation on compassion and reconciliation, this transcendent rendering of a medieval knight's heroic quest for the Holy Grail returns to the big screen in François Girard's celebrated production, a \\\"thoughtful and intrepid staging, full of striking imagery\\\" (The New York Times). Yannick Nézet-Séguin conducts a cast of Wagnerian superstars, including tenor Piotr Beczała in the title role, mezzo-soprano Elīna Garanča as the enigmatic Kundry, baritone Peter Mattei as the ailing Amfortas, bass-baritone Ryan Speedo Green as the sorcerer Klingsor, and bass Jongmin Park as the wise Gurnemanz.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/e0/64/e064e85d6fb9741be53e4188a52f0f92.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elīna\",\"lastName\":\"Garanča\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Piotr\",\"lastName\":\"Beczala\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Peter\",\"lastName\":\"Mattei\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ryan Speedo\",\"lastName\":\"Green\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jongmin\",\"lastName\":\"Park\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alfred\",\"lastName\":\"Walker\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2027-06-05T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Metropolitan Opera: Parsifal (2027)\",\"synopsis\":\"A profound philosophical meditation on compassion and reconciliation, this transcendent rendering of a medieval knight's heroic quest for the Holy Grail returns to the big screen in François Girard's celebrated production, a \\\"thoughtful and intrepid staging, full of striking imagery\\\" (The New York Times). Yannick Nézet-Séguin conducts a cast of Wagnerian superstars, including tenor Piotr Beczała in the title role, mezzo-soprano Elīna Garanča as the enigmatic Kundry, baritone Peter Mattei as the ailing Amfortas, bass-baritone Ryan Speedo Green as the sorcerer Klingsor, and bass Jongmin Park as the wise Gurnemanz.\",\"certificate\":null,\"casting\":[\"Elīna Garanča\",\"Piotr Beczala\",\"Peter Mattei\",\"Ryan Speedo Green\",\"Jongmin Park\",\"Alfred Walker\"],\"direction\":[\"François Girard\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2027-06-05T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000043021\",\"title\":\"Met Opera 2026-27: Samson et Dalila\",\"runtime\":14040,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"414791\"],\"poster\":\"https://all.web.img.acsta.net/img/fd/2b/fd2b3af79196cc65a574a81876065fb3.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Darko\",\"lastName\":\"Tresnjak\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Met Opera 2026-27: Samson et Dalila\",\"synopsis\":\"Saint-Saëns's spectacular take on the biblical hero of legendary strength and the seductive Philistine whose beauty overpowers him returns in the Met's larger-than-life production. Featuring a massive orchestra and chorus and some of opera's most spellbinding tunes, this masterpiece is a feast for the eyes and ears. Giacomo Sagripanti conducts an electrifying cast led by the formidable star pairing of mezzo- soprano Aigul Akhmetshina and tenor Clay Hilley, transmitted live to cinemas worldwide.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/fd/2b/fd2b3af79196cc65a574a81876065fb3.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Aigul\",\"lastName\":\"Akhmetshina\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Clay\",\"lastName\":\"Hilley\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Quinn\",\"lastName\":\"Kelsey\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alfred\",\"lastName\":\"Walker\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Morris\",\"lastName\":\"Robinson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-12-05T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Metropolitan Opera: Samson et Dalila (2026)\",\"synopsis\":\"Saint-Saëns's spectacular take on the biblical hero of legendary strength and the seductive Philistine whose beauty overpowers him returns in the Met's larger-than-life production. Featuring a massive orchestra and chorus and some of opera's most spellbinding tunes, this masterpiece is a feast for the eyes and ears. Giacomo Sagripanti conducts an electrifying cast led by the formidable star pairing of mezzo- soprano Aigul Akhmetshina and tenor Clay Hilley, transmitted live to cinemas worldwide.\",\"certificate\":null,\"casting\":[\"Aigul Akhmetshina\",\"Clay Hilley\",\"Quinn Kelsey\",\"Alfred Walker\",\"Morris Robinson\"],\"direction\":[\"Darko Tresnjak\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-12-05T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000043024\",\"title\":\"Met Opera 2026-27: Silent Night\",\"runtime\":10800,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"414794\"],\"poster\":\"https://all.web.img.acsta.net/img/46/3c/463cce8b10be42d5f0f448b35f2fb8e7.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"James\",\"lastName\":\"Robinson (III)\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Met Opera 2026-27: Silent Night\",\"synopsis\":\"Following his smash-hit company debut with The Hours, composer Kevin Puts returns to the Met with his Pulitzer Prize-winning opera, inspired by the true events of the 1914 Christmas truce. A poignant depiction of shared humanity in the most inhumane circumstances, Puts's grand, cinematic opera―with a libretto in English, French, and German by Mark Campbell has been widely acclaimed since its 2011 premiere, hailed as “an overwhelming emotive experience\\\" by The Guardian. The evocative staging by James Robinson takes the audience directly to the battlefields of the Western Front with a star-studded cast, featuring soprano Elza van den Heever and tenors Ben Bliss and Rolando Villazón, conducted by Maestro Dalia Stasevska live from the Met to cinemas worldwide.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/46/3c/463cce8b10be42d5f0f448b35f2fb8e7.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elza\",\"lastName\":\"van den Heever\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ben\",\"lastName\":\"Bliss\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rolando\",\"lastName\":\"Villazón\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ben\",\"lastName\":\"Reisinger\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mattia\",\"lastName\":\"Olivieri\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2027-03-20T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Metropolitan Opera: Silent Night (2027)\",\"synopsis\":\"Following his smash-hit company debut with The Hours, composer Kevin Puts returns to the Met with his Pulitzer Prize-winning opera, inspired by the true events of the 1914 Christmas truce. A poignant depiction of shared humanity in the most inhumane circumstances, Puts's grand, cinematic opera―with a libretto in English, French, and German by Mark Campbell has been widely acclaimed since its 2011 premiere, hailed as “an overwhelming emotive experience\\\" by The Guardian. The evocative staging by James Robinson takes the audience directly to the battlefields of the Western Front with a star-studded cast, featuring soprano Elza van den Heever and tenors Ben Bliss and Rolando Villazón, conducted by Maestro Dalia Stasevska live from the Met to cinemas worldwide.\",\"certificate\":null,\"casting\":[\"Elza van den Heever\",\"Ben Bliss\",\"Rolando Villazón\",\"Ben Reisinger\",\"Mattia Olivieri\"],\"direction\":[\"James Robinson (III)\"],\"coDirection\":[],\"pictures\"