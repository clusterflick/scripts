__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/5b/ee/5bee03e6913ead5042f7207f6755b9d5.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/76/d8/76d8cc6a80942d1ea27f9563fb229ad7.jpg\",\"__typename\":\"Image\"}],\"locale\":{\"title\":\"The Royal Ballet: The Nutcracker\",\"synopsis\":\"Join Clara at a delightful Christmas Eve party that becomes a magical adventure once everyone else is tucked up in bed. Marvel at the brilliance of Tchaikovsky’s score, as Clara and her enchanted Nutcracker fight the Mouse King and visit the Sugar Plum Fairy in the glittering Kingdom of Sweets. Peter Wright’s much-loved production for The Royal Ballet, with gorgeous period designs by Julia Trevelyan Oman, keeps true to the spirit of this festive ballet classic, combining the thrill of the fairy tale with spectacular dancing.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/9a/70/9a70a8562b60593e35628e4d1a94ef02.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Peter\",\"lastName\":\"Wright\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sophie\",\"lastName\":\"Allnatt\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Leo\",\"lastName\":\"Dixon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anne\",\"lastName\":\"O'Sullivan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Thomas\",\"lastName\":\"Whitehead\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marcelino\",\"lastName\":\"Sambé\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2024-12-17T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"no material likely to offend or harm\",\"__typename\":\"Rating\",\"certificate\":\"U\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Royal Ballet: The Nutcracker (2024)\",\"synopsis\":\"Join Clara at a delightful Christmas Eve party that becomes a magical adventure once everyone else is tucked up in bed. Marvel at the brilliance of Tchaikovsky’s score, as Clara and her enchanted Nutcracker fight the Mouse King and visit the Sugar Plum Fairy in the glittering Kingdom of Sweets. Peter Wright’s much-loved production for The Royal Ballet, with gorgeous period designs by Julia Trevelyan Oman, keeps true to the spirit of this festive ballet classic, combining the thrill of the fairy tale with spectacular dancing.\",\"certificate\":\"U\",\"casting\":[\"Sophie Allnatt\",\"Leo Dixon\",\"Anne O'Sullivan\",\"Thomas Whitehead\",\"Marcelino Sambé\"],\"direction\":[\"Peter Wright\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/8e/41/8e415bdaf9ff7bd94dd4f876f802f520.jpg\",\"https://all.web.img.acsta.net/img/5b/ee/5bee03e6913ead5042f7207f6755b9d5.jpg\",\"https://all.web.img.acsta.net/img/76/d8/76d8cc6a80942d1ea27f9563fb229ad7.jpg\"],\"heroImages\":[],\"release\":\"2024-12-17T00:00:00.000Z\",\"advisory\":\"no material likely to offend or harm\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000041561\",\"title\":\"The Secret World of Arrietty 4K\",\"runtime\":5700,\"genres\":\"Animation\",\"__typename\":\"Movie\",\"altId\":[\"413172\",\"413173\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Hiromasa\",\"lastName\":\"Yonebayashi\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"The Secret World of Arrietty 4K\",\"synopsis\":\"In a secret world hidden beneath the floorboards, tiny people called Borrowers live out of sight of humans. But when brave Arrietty is out gathering supplies, she is discovered by Shawn, a human boy, and they begin to form a friendship that blossoms into a heartwarming adventure. This sumptuously animated and heartwarming story features the voices of Bridgit Mendler, David Henrie, Amy Poehler, Will Arnett, Moises Arias and Carol Burnett.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2026-10-14T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Bridgit\",\"lastName\":\"Mendler\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"David\",\"lastName\":\"Henrie\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Amy\",\"lastName\":\"Poehler\",\"__typename\":\"Person\"}}]},\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poste