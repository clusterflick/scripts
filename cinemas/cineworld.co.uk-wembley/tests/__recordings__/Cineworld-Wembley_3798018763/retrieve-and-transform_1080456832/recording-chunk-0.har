\"lastName\":\"Forrt\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Neeraja\",\"lastName\":\"Rajendran\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Varun\",\"lastName\":\"Pande\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-09-03T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"1000121107\",\"name\":\"Magic Rays\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong language, violence, injury detail\",\"__typename\":\"Rating\",\"certificate\":\"15\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"I'm Game\",\"synopsis\":\"A fearless gambler who trusts luck more than life gets caught in a series of crazy and unexpected events that turn his world upside down. What follows is a thrilling ride filled with fun, surprises, action, and unforgettable moments must confront an evil far more powerful than he imagined to protect his family and survive the wedding that could seal their fate.\",\"certificate\":\"15\",\"casting\":[\"Dulquer Salmaan\",\"Antony Varghese\",\"Samyuktha Viswanathan\",\"Mysskin\",\"Kathir\",\"Kayadu Lohar\",\"Parth Tiwari\",\"Vinay Forrt\",\"Neeraja Rajendran\",\"Varun Pande\"],\"direction\":[\"Nahas Hidayath\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/2a50f700ec0290151d5e9a883153e68d.jpg\"],\"release\":\"2026-09-03T00:00:00.000Z\",\"advisory\":\"strong language, violence, injury detail\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Magic Rays\"}},{\"id\":\"1000016503\",\"title\":\"Insidious: Out of the Further\",\"runti