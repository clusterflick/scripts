alVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hanumanth\",\"lastName\":\"Reddy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Shashank\",\"lastName\":\"Patil\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Shree\",\"lastName\":\"Vaishnav\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-07-31T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"1000118530\",\"name\":\"Prathyangira Cinemas\",\"__typename\":\"Company\"}]},{\"releasedAt\":\"2026-09-18T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"1000118530\",\"name\":\"Prathyangira Cinemas\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"418\",\"synopsis\":\"Set in a medical college in a dread-stricken village, the film confronts the science behind superstitions, the superstitions in science, and an anomaly that neither can explain.\",\"certificate\":null,\"casting\":[\"Charan Lakkaraju\",\"Preethi Pagadala\",\"Surya Raj\",\"Hanumanth Reddy\",\"Shashank Patil\",\"Shree Vaishnav\"],\"direction\":[\"Kirtan Nadagouda\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-07-31T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Prathyangira Cinemas\"}},{\"id\":\"326675\",\"title\":\"500 Miles\",\"runtime\":6120,\"genres\":\"Drama, Comedy\",\"poster\":\"https://all.web.img.acsta.net/img/1c/ef/1cef9210b67e00af75d028b76f66c3a3.jpg\",\"__typename\":\"Movie\",\"altId\":[\"386762\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Morgan\",\"lastName\":\"Matthews\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"500 Miles\",\"synopsis\":\"500 MILES is a poetic, life-affirming road movie and celebration of the human spirit that follows a broken family who are forced to come together when two young brothers run away from home.\\n\\nWhile their fighting parents (Clare Dunne & Michael Socha) tear their hair out with worry, runaways Finn (Roman Griffin Davis) and his live-wire younger brother Charlie (Dexter Sol Ansell) embark on an epic adventure from Yorkshire, over land and sea, to the Wild West coast of Ireland. With the free-spirited busker Cate (Maisie Williams) helping the young boys along the way, their destination is Dingle, County Kerry, and their estranged, beloved Grandfather (BAFTA-award winner Bill Nighy), who their parents haven’t spoken to since the fateful events of the previous summer.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/1c/ef/1cef9210b67e00af75d028b76f66c3a3.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/386762_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/386762_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bill\",\"lastName\":\"Nighy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Roman Griffin\",\"lastName\":\"Davis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maisie\",\"lastName\":\"Williams\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dexter\",\"lastName\":\"Sol Ansell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Clare\",\"lastName\":\"Dunne\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Socha\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-06-26T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"1000112319\",\"name\":\"True Brit Entertainment Ltd.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"infrequent strong language\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"500 Miles\",\"synopsis\":\"500 MILES is a poetic, life-affirming road movie and celebration of the human spirit that follows a broken family who are forced to come together when two young brothers run away from home.\\n\\nWhile their fighting parents (Clare Dunne & Michael Socha) tear their hair out with worry, runaways Finn (Roman Griffin Davis) and his live-wire younger brother Charlie (Dexter Sol Ansell) embark on an epic adventure from Yorkshire, over land and sea, to the Wild West coast of Ireland. With the free-spirited busker Cate (Maisie Williams) helping the young boys along the way, their destination is Dingle, County Kerry, and their estranged, beloved Grandfather (BAFTA-award winner Bill Nighy), who their parents haven’t spoken to since the fateful events of the previous summer.\",\"certificate\":\"12A\",\"casting\":[\"Bill Nighy\",\"Roman Griffin Davis\",\"Maisie Williams\",\"Dexter Sol Ansell\",\"Clare Dunne\",\"Michael Socha\"],\"direction\":[\"Morgan Matthews\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-06-26T00:00:00.000Z\",\"advisory\":\"infrequent strong language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/386762_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/386762_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"True Brit Entertainment Ltd.\"}},{\"id\":\"1000049428\",\"title\":\"Always Lalisa\",\"runtime\":5880,\"genres\":\"Documentary, Music\",\"__typename\":\"Movie\",\"altId\":[\"422452\",\"424943\"],\"poster\":\"https://all.web.img.acsta.net/img/2c/d5/2cd578b2ba7615fba04cc5e7c232142d.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/37/32/3732fd82bc5d97a4d9ecbd1f5287cba1.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/a4/f9/a4f96653738260f957f811e12fe4b6ec.jpg\",\"__typename\":\"Image\"}],\"quadImages\":[\"https://all.web.img.acsta.net/img/be/54/be54d815bfb7e86812d17f6bef4b644a.jpg\"],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Sue\",\"lastName\":\"Kim (II)\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Always Lalisa\",\"synopsis\":\"Always Lalisa is a feature-length documentary following global superstar LISA during a transformative year away from Blackpink, the K-pop phenomenon that made her one of the world's most recognizable performers. As the group pauses activities, LISA embarks on the first true chapter of her solo career, confronting the question of who she is beyond\\nBlackpink.\\n\\nThe film follows LISA as she writes, records, and releases her debut solo album, Alter Ego, makes her acting debut in the third season of The White Lotus, and prepares for her first major solo performance at the 2025 Coachella Music Festival. Born and raised in Thailand, LISA left home at fourteen to train in South Korea's demanding K-pop system, ultimately\\nrising to global superstardom. But forging her own path, particularly in the Western music market, brings new pressures, relentless scrutiny, and the challenge of redefining herself on her own terms.\\n\\nIntimate, emotional, and revealing, Always Lalisa captures an artist at a crossroads, documenting a year of risk, reinvention, and self-discovery as LISA begins to define not only her next chapter, but the woman and artist she wants to become.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/2c/d5/2cd578b2ba7615fba04cc5e7c232142d.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lalisa\",\"lastName\":\"Manobal\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-10-12T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Always Lalisa\",\"synopsis\":\"Always Lalisa is a feature-length documentary following global superstar LISA during a transformative year away from Blackpink, the K-pop phenomenon that made her one of the world's most recognizable performers. As the group pauses activities, LISA embarks on the first true chapter of her solo career, confronting the question of who she is beyond\\nBlackpink.\\n\\nThe film follows LISA as she writes, records, and releases her debut solo album, Alter Ego, makes her acting debut in the third season of The White Lotus, and prepares for her first major solo performance at the 2025 Coachella Music Festival. Born and raised in Thailand, LISA left home at fourteen to train in South Korea's demanding K-pop system, ultimately\\nrising to global superstardom. But forging her own path, particularly in the Western music market, brings new pressures, relentless scrutiny, and the challenge of redefining herself on her own terms.\\n\\nIntimate, emotional, and revealing, Always Lalisa captures an artist at a crossroads, documenting a year of risk, reinvention, and self-discovery as LISA begins to define not only her next chapter, but the woman and artist she wants to become.\",\"certificate\":null,\"casting\":[\"Lalisa Manobal\"],\"direction\":[\"Sue Kim (II)\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/37/32/3732fd82bc5d97a4d9ecbd1f5287cba1.jpg\",\"https://all.web.img.acsta.net/img/a4/f9/a4f96653738260f957f811e12fe4b6ec.jpg\"],\"heroImages\":[],\"release\":\"2026-10-12T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"},\"orderIndex\":51},{\"id\":\"1000042502\",\"title\":\"André Rieu's 2026 Christmas Concert: Let it snow!\",\"runtime\":9900,\"genres\":\"Concert\",\"poster\":\"https://all.web.img.acsta.net/img/d0/92/d092954197573230d4198c8810298241.jpg\",\"__typename\":\"Movie\",\"altId\":[\"414209\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"locale\":{\"title\":\"André Rieu's 2026 Christmas Concert: Let it snow!\",\"synopsis\":\"Celebrate the most magical time of the year with André Rieu?s spectacular Christmas concerts in December 2026. The ?King of the Waltz? will transform his hometown once again into a sparkling winter fairytale, filling the grand stage with festive decorations, twinkling lights, and a warm, joyous atmosphere. Together with his Johann Strauss Orchestra, world-class soloists, and special guests, André brings to life a heartwarming program of waltzes, beloved Christmas carols, and seasonal classics that will have you singing, swaying, and smiling from the very first note. This annual tradition is more than just a concert?it is an unforgettable experience full of laughter, emotion, and holiday magic. Families, friends, and music lovers from around the world gather to share in the beauty of music and the spirit of Christmas, creating memories that last a lifetime. Whether it is your first time or a cherished yearly visit, André Rieu?s Christmas concerts promise a festive celebration unlike any other.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/d0/92/d092954197573230d4198c8810298241.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"André\",\"lastName\":\"Rieu\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"André\",\"lastName\":\"Rieu\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-12-05T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"43134\",\"name\":\"Piece of Magic Entertainment\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"André Rieu's 2026 Christmas Concert: Let It Snow!\",\"synopsis\":\"Celebrate the most magical time of the year with André Rieu?s spectacular Christmas concerts in December 2026. The ?King of the Waltz? will transform his hometown once again into a sparkling winter fairytale, filling the grand stage with festive decorations, twinkling lights, and a warm, joyous atmosphere. Together with his Johann Strauss Orchestra, world-class soloists, and special guests, André brings to life a heartwarming program of waltzes, beloved Christmas carols, and seasonal classics that will have you singing, swaying, and smiling from the very first note. This annual tradition is more than just a concert?it is an unforgettable experience full of laughter, emotion, and holiday magic. Families, friends, and music lovers from around the world gather to share in the beauty of music and the spirit of Christmas, creating memories that last a lifetime. Whether it is your first time or a cherished yearly visit, André Rieu?s Christmas concerts promise a festive celebration unlike any other.\",\"certificate\":null,\"casting\":[\"André Rieu\"],\"direction\":[\"André Rieu\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-12-05T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Piece of Magic Entertainment\"}},{\"id\":\"1000036867\",\"title\":\"Avengers: Endgame (Re-Release)\",\"runtime\":11100,\"genres\":\"Action, Adventure, Science fiction\",\"__typename\":\"Movie\",\"altId\":[\"407607\",\"423996\",\"423997\",\"423998\"],\"poster\":\"https://all.web.img.acsta.net/img/53/bf/53bf3cfef6771eeac158613029d05d1a.jpeg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/75/da/75da009cb8f8782e10c639b1272f6a63.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/27/36/27365d2ef7421e90ca86b39f3c8f5f63.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/89/a3/89a3cff5a891c32eaf39610f47084b47.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/84/07/8407504467ca5bb999ed9151626645c5.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/10/cb/10cbbc9d65343da69d5758aff011a0bf.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/81/a4/81a434b8a3870d08e4480ba77b5f8452.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/d6/0b/d60b4224432a909dc6699466d0100290.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c9/fd/c9fd0a87e67ea770652bd53e8aa00fb5.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/04/31/0431fffc18bc2e8b44d843531c2aa792.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/26/19/26197ceb5cec81ce9a3748c8495ef99f.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Joe\",\"lastName\":\"Russo\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Anthony\",\"lastName\":\"Russo\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Avengers: Endgame (Re-Release)\",\"synopsis\":\"The epic conclusion to the Infinity Saga returns to theaters as Avengers Endgame: Encore on September 25, 2026. After devastating events wiped out half the world’s population, the remaining heroes struggle to move forward. Ultimately, they must come together to restore order and harmony in the universe and bring their loved ones back in a dramatic showdown against Thanos.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/53/bf/53bf3cfef6771eeac158613029d05d1a.jpeg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",