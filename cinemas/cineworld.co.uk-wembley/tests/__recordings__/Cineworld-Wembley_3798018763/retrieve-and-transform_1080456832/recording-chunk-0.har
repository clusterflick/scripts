er\":{\"SD\":\"https://m.boxoffice.media/mp4/359634_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/359634_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Curzon\"}},{\"id\":\"1000050836\",\"title\":\"Queen Budapest\",\"runtime\":5820,\"genres\":\"Concert\",\"__typename\":\"Movie\",\"altId\":[\"424024\",\"424036\"],\"poster\":\"https://all.web.img.acsta.net/img/a1/d9/a1d93da564046502d8abe2da0be06c1c.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/7b/fa/7bfa5e5d3bfc750055bd47d9c73da7e3.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/55/9a/559ab6c5c54d8d635c58de94c5bdd83d.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/62/9a/629a5a360d2c88da763a436baaae0c84.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/05/f7/05f73c4d6462162287b1ed5c022647e6.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ab/31/ab316ecee04b74538f7191c21c0eb1ee.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c2/68/c268bf90870af6e58d584539ee86d1a0.png\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c0/d3/c0d3945f47a340466ca5b6b9d8ffa848.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/81/58/81587aa41de25ff2431793eb838d61ca.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/fc/3d/fc3df2d58bf220f8c8387b95d14451f4.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/d1/9e/d19e8e68ee479e9589e5128539281303.jpg\",\"__typename\":\"Image\"}],\"quadImages\":[\"https://all.web.img.acsta.net/img/67/86/6786ba1afa0f715e5f0d2ba4eac284ee.jpg\"],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"János\",\"lastName\":\"Zsombolyai\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Queen Budapest\",\"synopsis\":\"On July 27, 1986, Queen performed the largest-ever stadium concert at the Népstadion in Budapest in front of 80,000 ecstatic fans. The concert was part of the famed Magic Tour, which was the last time the band toured with lead singer Freddie Mercury. Now, this original concert film has been beautifully rescanned and remastered in 4K alongside a dynamic new audio mix, featuring many of Queen's favorite tracks— \\\"Bohemian Rhapsody,” \\\"Crazy Little Thing Called Love,\\\" \\\"I Want To Break Free” and \\\"We Are The Champions.\\\" With three years to go before the fall of the Berlin Wall, this was the first Western rock concert performed in a stadium behind the then Iron Curtain. It was of such significance to the Hungarian authorities and film industry that a group of the country’s top film cameramen and technicians were brought together to film it for posterity.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/a1/d9/a1d93da564046502d8abe2da0be06c1c.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":null,\"lastName\":\"Queen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Deacon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brian\",\"lastName\":\"May\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Freddie\",\"lastName\":\"Mercury\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Roger\",\"lastName\":\"Taylor\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-10-07T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Queen Budapest\",\"synopsis\":\"On July 27, 1986, Queen performed the largest-ever stadium concert at the Népstadion in Budapest in front of 80,000 ecstatic fans. The concert was part of the famed Magic Tour, which was the last time the band toured with lead singer Freddie Mercury. Now, this original concert film has been beautifully rescanned and remastered in 4K alongside a dynamic new audio mix, featuring many of Queen's favorite tracks— \\\"Bohemian Rhapsody,” \\\"Crazy Little Thing Called Love,\\\" \\\"I Want To Break Free” and \\\"We Are The Champions.\\\" With three years to go before the fall of the Berlin Wall, this was the first Western rock concert performed in a stadium behind the then Iron Curtain. It was of such significance to the Hungarian authorities and film industry that a group of the country’s top film cameramen and technicians were brought together to film it for posterity.\",\"certificate\":null,\"casting\":[\"Queen\",\"John Deacon\",\"Brian May\",\"Freddie Mercury\",\"Roger Taylor\"],\"direction\":[\"János Zsombolyai\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/7b/fa/7bfa5e5d3bfc750055bd47d9c73da7e3.jpg\",\"https://all.web.img.acsta.net/img/55/9a/559ab6c5c54d8d635c58de94c5bdd83d.jpg\",\"https://all.web.img.acsta.net/img/62/9a/629a5a360d2c88da763a436baaae0c84.jpg\",\"https://all.web.img.acsta.net/img/05/f7/05f73c4d6462162287b1ed5c022647e6.jpg\",\"https://all.web.img.acsta.net/img/ab/31/ab316ecee04b74538f7191c21c0eb1ee.jpg\",\"https://all.web.img.acsta.net/img/c2/68/c268bf90870af6e58d584539ee86d1a0.png\",\"https://all.web.img.acsta.net/img/c0/d3/c0d3945f47a340466ca5b6b9d8ffa848.jpg\",\"https://all.web.img.acsta.net/img/81/58/81587aa41de25ff2431793eb838d61ca.jpg\",\"https://all.web.img.acsta.net/img/fc/3d/fc3df2d58bf220f8c8387b95d14451f4.jpg\",\"https://all.web.img.acsta.net/img/d1/9e/d19e8e68ee479e9589e5128539281303.jpg\"],\"heroImages\":[],\"release\":\"2026-10-07T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"},\"orderIndex\":53},{\"id\":\"1000045316\",\"title\":\"RBO Cinema Season 2026-27: Carmen\",\"runtime\":12900,\"genres\":\"Opera\",\"poster\":\"https://all.web.img.acsta.net/img/a9/6a/a96ae231e459a673ac8552bf788b33a4.webp\",\"__typename\":\"Movie\",\"altId\":[\"417416\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Damiano\",\"lastName\":\"Michieletto\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"RBO Cinema Season 2026-27: Carmen\",\"synopsis\":\"In a remote Spanish town, the free-spirited Carmen declares that any man she loves should beware. But even she is unprepared for what happens when she decides to seduce police officer Don José. Though initially uninterested in Carmen’s charms, Don José – against the wishes of his mother and of Micaëla, the woman who loves him – soon abandons his respectable career for a life of danger with Carmen. But she soon grows weary of Don José's possessiveness, longing to return to a life of independence. When Carmen turns her attention to the celebrated toreador Escamillo, Don José’s jealousy and despair threaten to violently erupt.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/a9/6a/a96ae231e459a673ac8552bf788b33a4.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ginger\",\"lastName\":\"Costa-Jackson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Russell\",\"lastName\":\"Thomas\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-11-10T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Royal Ballet and Opera: Carmen\",\"synopsis\":\"In a remote Spanish town, the free-spirited Carmen declares that any man she loves should beware. But even she is unprepared for what happens when she decides to seduce police officer Don José. Though initially uninterested in Carmen’s charms, Don José – against the wishes of his mother and of Micaëla, the woman who loves him – soon abandons his respectable career for a life of danger with Carmen. But she soon grows weary of Don José's possessiveness, longing to return to a life of independence. When Carmen turns her attention to the celebrated toreador Escamillo, Don José’s jealousy and despair threaten to violently erupt.\",\"certificate\":null,\"casting\":[\"Ginger Costa-Jackson\",\"Russell Thomas\"],\"direction\":[\"Damiano Michieletto\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-11-10T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000045315\",\"title\":\"RBO Cinema Season 2026-27: Manon\",\"runtime\":11400,\"genres\":\"Ballet\",\"poster\":\"https://all.web.img.acsta.net/img/59/ff/59ffb8bcc466f2fca12e7157dfc8ee1a.jpg\",\"__typename\":\"Movie\",\"altId\":[\"417415\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Kenneth\",\"lastName\":\"MacMillan\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"RBO Cinema Season 2026-27: Manon\",\"synopsis\":\"In the seedy underbelly of 18th-century Paris, money is king. Nothing is sacred – even love itself can be bought for the right price. A native of this hedonistic underworld, Manon is caught between twin desires when she falls in love with the student Des Grieux. Steadfast and devoted, he offers the possibility of an honourable life – but the riches promised by the world of Parisian society remain tempting...\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/59/ff/59ffb8bcc466f2fca12e7157dfc8ee1a.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Yasmine\",\"lastName\":\"Naghdi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"William\",\"lastName\":\"Bracewell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-10-27T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Royal Ballet and Opera: Manon\",\"synopsis\":\"In the seedy underbelly of 18th-century Paris, money is king. Nothing is sacred – even love itself can be bought for the right price. A native of this hedonistic underworld, Manon is caught between twin desires when she falls in love with the student Des Grieux. Steadfast and devoted, he offers the possibility of an honourable life – but the riches promised by the world of Parisian society remain tempting...\",\"certificate\":null,\"casting\":[\"Yasmine Naghdi\",\"William Bracewell\"],\"direction\":[\"Kenneth MacMillan\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-10-27T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000045314\",\"title\":\"RBO Cinema Season 2026-27: Swan Lake\",\"runtime\":12300,\"genres\":\"Ballet\",\"poster\":\"https://all.web.img.acsta.net/img/a9/45/a9454e97880a12c55d76e386ecec1904.webp\",\"__typename\":\"Movie\",\"altId\":[\"417414\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Marius\",\"lastName\":\"Petipa\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"RBO Cinema Season 2026-27: Swan Lake\",\"synopsis\":\"Princess Odette is bound by a terrible curse: transformed into a swan by day by the evil sorcerer Von Rothbart. The spell can only be broken with a pledge of eternal love. When she meets Prince Siegfried, he is immediately enamoured by her fragile beauty and vows to free her. But Von Rothbart conspires to thwart the lovers’ plans.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/a9/45/a9454e97880a12c55d76e386ecec1904.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"releases\":[{\"releasedAt\":\"2027-04-22T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Royal Ballet and Opera: Swan Lake\",\"synopsis\":\"Princess Odette is bound by a terrible curse: transformed into a swan by day by the evil sorcerer Von Rothbart. The spell can only be broken with a pledge of eternal love. When she meets Prince Siegfried, he is immediately enamoured by her fragile beauty and vows to free her. But Von Rothbart conspires to thwart the lovers’ plans.\",\"certificate\":null,\"casting\":[],\"direction\":[\"Marius Petipa\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2027-04-22T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000046229\",\"title\":\"RBO Cinema Season 2026-27: The Nutcracker\",\"runtime\":10200,\"genres\":\"Ballet\",\"__typename\":\"Movie\",\"altId\":[\"418519\"],\"poster\":\"https://all.web.img.acsta.net/img/8d/ff/8dff921a65f68039243632bd26b46d38.webp\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[\"https://all.web.img.acsta.net/img/ac/e2/ace29e5ccdb431bc8d024369f798a25b.jpg\"],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Peter\",\"lastName\":\"Wright\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Julia\",\"lastName\":\"Trevelyan Oman\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"RBO Cinema Season 2026-27: The Nutcracker\",\"synopsis\":\"At a cosy Christmas party, young Clara meets the mysterious magician Drosselmeyer, who gives her a nutcracker doll. When the guests have departed and the house is asleep, Clara sneaks downstairs in search of her favourite gift. Instead, she finds Drosselmeyer, who whisks her away on a journey into a whole world of enchantment: fantastical landscapes of flurried snow and glittering confection where toys come alive and the magic never stops.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/8d/ff/8dff921a65f68039243632bd26b46d38.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mayara\",\"lastName\":\"Magri\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Reece\",\"lastName\":\"Clarke\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"James\",\"lastName\":\"Hay\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-12-01T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Royal Ballet and Opera: The Nutcracker (2026) (INACTIVE)\",\"synopsis\":\"At a cosy Christmas party, young Clara meets the mysterious magician Drosselmeyer, who gives her a nutcracker doll. When the guests have departed and the house is asleep, Clara sneaks downstairs in search of her favourite gift. Instead, she finds Drosselmeyer, who whisks her away on a journey into a whole world of enchantment: fantastical landscapes of flurried snow and glittering confection where toys come alive and the magic never stops.\",\"certificate\":null,\"casting\":[\"Mayara Magri\",\"Reece Clarke\",\"James Hay\"],\"direction\":[\"Peter Wright\",\"Julia Trevelyan Oman\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-12-01T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000047648\",\"title\":\"Raiders of the Lost Ark (45th Anniversary)\",\"runtime\":6960,\"genres\":\"Adventure, Action\",\"poster\":\"https://all.web.img.acsta.net/img/af/c8/afc84be81c1032660ce3dae20caecaa7.jpeg\",\"__typename\":\"Movie\",\"altId\":[\"420238\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[\"https://all.web.img.acsta.net/img/5d/20/5d20e3366ccbf6163602ae048be18214.jpeg\"],\"locale\":{\"title\":\"Raiders of the Lost Ark (45th Anniversary)\",\"synopsis\":\"As the Third Reich continues its reign of terror, Adolf Hitler is on a quest for the legendary Ark of the Covenenant- resting place of the Ten Commandments- whose supernatural powers, legend says, can wipe out entire armies. The U.S. Government turns to Dr. Indiana Jones, for the mission.  Relentlessly pursued by Hitler's henchmen, Indy infiltrates their massive digging operation in a race against time to discover the Well of the Souls, where the Ark has lain undisturbed for centuries.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"