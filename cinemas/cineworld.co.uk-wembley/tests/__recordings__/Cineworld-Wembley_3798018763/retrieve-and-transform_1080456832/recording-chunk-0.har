on\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Edwin\",\"lastName\":\"Sykes\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-10-16T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Others - 4k Restoration\",\"synopsis\":\"n 1945, Grace Stewart (Kidman) and her two children live an unusually isolated existence in a secluded mansion on one of the Channel Islands. The arrival of mysterious new servants (Fionnula Flanagan, Ed Sykes) and her apparently war-fatigued husband Charles (Christopher Eccleston), raise the unworldly feeling that there is far more to this house than can be seen, provoking Grace into a terrifying fight to save her children and preserve her sanity.\",\"certificate\":null,\"casting\":[\"Nicole Kidman\",\"Fionnula Flanagan\",\"Christopher Eccleston\",\"Edwin Sykes\"],\"direction\":[\"Alejandro Amenábar\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-10-16T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"1000020779\",\"title\":\"The Paradise\",\"runtime\":9900,\"genres\":\"Action, Adventure, Drama\",\"__typename\":\"Movie\",\"altId\":[\"387853\"],\"poster\":\"https://all.web.img.acsta.net/img/2a/44/2a44575dae979b218f4e00b73710e4ab.jpg\",\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Srikanth\",\"lastName\":\"Odela\",\"__typename\":\"Person\"}}]