            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014862\",\"name\":\"Paw Patrol: The Dino Movie\",\"originalName\":\"Paw Patrol: The Dino Movie\",\"length\":90,\"posterLink\":\"https://regalcdn.azureedge.net/CW/PawPatrolTheDinoMovie/HO00014862/TV_SmallPosterImage/20260623-113302097.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/PawPatrolTheDinoMovie/HO00014862/TV_LargePosterImage/20260623-113302097.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/paw-patrol-the-dino-movie/ho00014862\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Terry Crews, Paris Hilton, Jennifer Hudson, Snoop Dogg, Jameela Jamil, Fortune Feimster, Ron Pardo, Nylan Parthipan, McKenna Grace, Carter Young, Meredith MacNeill, Hayden Chemberlen, Rain Janjua, Bill Nye, Lucien Duncan-Reid, William Desrosiers, Henry Bolan\",\"directors\":\"Cal Brunker\",\"synopsis\":\"After their ship gets caught in a mysterious storm, the PAW Patrol pups crash land on an uncharted tropical island filled with dinosaurs. They meet Rex, a pup who has been stranded on the island for years and has become an expert in all things dino-related. When the PAW Patrol's archrival, Mayor Humdinger, begins recklessly mining in hopes of exploiting the island for its natural resources, he inadvertently causes a huge, dormant volcano to erupt. The PAW Patrol pups are thrown into a series of high-stakes, dino-sized rescues bigger than anything they've done before, as they must stop Humdinger before everything on the island goes extinct.\",\"dateStarted\":\"2026-08-07T00:00:00\",\"eventCount\":2062,\"categoriesAttributes\":[\"action\",\"animation\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"audio-described\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/U.png\",\"ageRestrictionName\":\"u\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/PawPatrolTheDinoMovie/HO00014862/TV_TopShelfPosterImage/20260623-113302097.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/PawPatrolTheDinoMovie/HO00014862/TV_SmallPosterImage/20260623-113302097.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/PawPatrolTheDinoMovie/HO00014862/Mobile_MovieThumbnail/20260623-113302097.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/PawPatrolTheDinoMovie/HO00014862/TV_LargePosterImage/20260623-113302097.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/PawPatrolTheDinoMovie/HO00014862/Mobile_MovieFeed/20260623-113331764.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"PARAMOUNT\"}}}",
