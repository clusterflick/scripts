832\",\"name\":\"Lionsgate UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"infrequent strong language, moderate violence\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Glenrothan\",\"synopsis\":\"Two brothers following a violent exchange with their father on the day of their mother's funeral, the younger of the two left their Highland home for America. After forty years they reunite in the land of their birth.\",\"certificate\":\"12A\",\"casting\":[\"Alan Cumming\",\"Brian Cox\",\"Alexandra Shipp\",\"Shirley Henderson\",\"Nicole Ansari-Cox\",\"Jess Douglas-Welsh\",\"Aidan Redmond\",\"Zbigniew Piotrowicz\"],\"direction\":[\"Brian Cox\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-04-17T00:00:00.000Z\",\"advisory\":\"infrequent strong language, moderate violence\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/378042_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/378042_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Lionsgate UK\"}},{\"id\":\"1000045607\",\"title\":\"Hadestown: The Musical\",\"runtime\":8460,\"genres\":\"Musical\",\"__typename\":\"Movie\",\"altId\":[\"417776\"],\"poster\":\"https://all.web.img.acsta.net/img/e8/15/e815daf5303f92b26572bbdbaca71b58.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[\"https://all.web.img.acsta.net/img/b7/d6/b7d65f3306f0440b4b71f6bd0e07a6be.jpg\"],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Brett\",\"lastName\":\"Sullivan\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Hadestown: The Musical\",\"synopsis\":\"The international hit musical comes to the big screen! Winner of eight Tony Awards in 2019 including Best Musical and the 2020 Grammy Award for Best Musical Theater Album, HADESTOWN: THE MUSICAL is the genre-defying musical blending modern American folk music with New Orleans-inspired jazz to reimagine a sweeping ancient tale of two intertwining love stories, that of young dreamers Orpheus and Eurydice, and King Hades and his wife Persephone. Filmed live on stage in London’s West End and featuring the original Broadway stars, HADESTOWN: THE MUSICAL invites audiences on a hell-raising journey to the underworld and back.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/e8/15/e815daf5303f92b26572bbdbaca71b58.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/ce2081267f37a6710c62c1c706bbcb8e.jpg\",\"__typename\":\"BOAppImage\"}]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Reeve\",\"lastName\":\"Carney\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Eva\",\"lastName\":\"Noblezada\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Patrick\",\"lastName\":\"Page\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Andre\",\"lastName\":\"de Shields\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Amber\",\"lastName\":\"Gray\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bella\",\"lastName\":\"Brown\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Madeline\",\"lastName\":\"Charlemagne\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Allie\",\"lastName\":\"Daniel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lauren\",\"lastName\":\"Azania\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tiago\",\"lastName\":\"Dhondt Bamberger\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-10-13T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Hadestown: The Musical\",\"synopsis\":\"The international hit musical comes to the big screen! Winner of eight Tony Awards in 2019 including Best Musical and the 2020 Grammy Award for Best Musical Theater Album, HADESTOWN: THE MUSICAL is the genre-defying musical blending modern American folk music with New Orleans-inspired jazz to reimagine a sweeping ancient tale of two intertwining love stories, that of young dreamers Orpheus and Eurydice, and King Hades and his wife Persephone. Filmed live on stage in London’s West End and featuring the original Broadway stars, HADESTOWN: THE MUSICAL invites audiences on a hell-raising journey to the underworld and back.\",\"certificate\":null,\"casting\":[\"Reeve Carney\",\"Eva Noblezada\",\"Patrick Page\",\"Andre de Shields\",\"Amber Gray\",\"Bella Br