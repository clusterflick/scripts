,\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Indhu\",\"lastName\":\"Rubasingham\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"National Theatre Live: The Misanthrope\",\"synopsis\":\"Alice, a brilliant novelist, despises the hollow contemporary mantras of kindness and respect. But the bolder she becomes in speaking out, the more colleagues avoid her, and the more her personal relationships begin to fracture.\\n\\nAs she challenges fashionable ideas and lends her voice to causes others are afraid to touch, she faces intense criticism and backlash. Alice will soon learn the price she must pay as an artist and as a woman for daring to speak her mind.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/d4/6e/d46e168f03978cdacc702a4b4a0304e2.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/e28408a3d0e25e4399ebffa9836a8216.jpg\",\"__typename\":\"BOAppImage\"}]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sandra\",\"lastName\":\"Oh\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Paul\",\"lastName\":\"Chahidi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tom\",\"lastName\":\"Mison\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jemima\",\"lastName\":\"Rooper\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Abigail\",\"lastName\":\"Cruttenden\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Imogen\",\"lastName\":\"Elliott\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Freddie\",\"lastName\":\"MacBruce\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rina\",\"lastName\":\"Fatania\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Poppy\",\"lastName\":\"Townsend White\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Teddy\",\"lastName\":\"Holton-Frances\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-09-22T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"7215\",\"name\":\"National Theatre\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong language, sex references\",\"__typename\":\"Rating\",\"certificate\":\"15\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"National Theatre Live: The Misanthrope\",\"synopsis\":\"Alice, a brilliant novelist, despises the hollow contemporary mantras of kindness and respect. But the bolder she becomes in speaking out, the more colleagues avoid her, and the more her personal relationships begin to fracture.\\n\\nAs she challenges fashionable ideas and lends her voice to causes others are afraid to touch, she faces intense criticism and backlash. Alice will soon learn the price she must pay as an artist and as a woman for daring to speak her mind.\",\"certificate\":\"15\",\"casting\":[\"Sandra Oh\",\"Paul Chahidi\",\"Tom Mison\",\"Jemima Rooper\",\"Abigail Cruttenden\",\"Imogen Elliott\",\"Freddie MacBruce\",\"Rina Fatania\",\"Poppy Townsend White\",\"Teddy Holton-Frances\"],\"direction\":[\"Indhu Rubasingham\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/e28408a3d0e25e4399ebffa9836a8216.jpg\"],\"release\":\"2026-09-22T00:00:00.000Z\",\"advisory\":\"strong language, sex references\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"National Theatre\"},\"orderIndex\":56},{\"id\":\"1000036236\",\"title\":\"National Theatre Live: The Playboy of the Western World\",\"runtime\":9420,\"genres\":\"Drama, Comedy\",\"poster\":\"https://all.web.img.acsta.net/img/5d/24/5d2458d96b970a8767c326fda23fae92.jpg\",\"__typename\":\"Movie\",\"altId\":[\"406841\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"John\",\"lastName\":\"Millington Synge\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"National Theatre Live: The Playboy of the Western World\",\"synopsis\":\"Pegeen Flaherty’s life is turned upside down when a young man walks into her pub claiming that he’s killed his father. Instead of being shunned, the killer becomes a local hero and begins to win hearts, that is until a second man unexpectedly arrives on the scene…\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/5d/24/5d2458d96b970a8767c326fda23fae92.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nicola\",\"lastName\":\"Coughlan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Éanna\",\"lastName\":\"Hardwicke\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Siobhán\",\"lastName\":\"McSweeney\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Declan\",\"lastName\":\"Conlon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-05-28T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"7215\",\"name\":\"National Theatre\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"moderate injury detail, violence references\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"National Theatre Live: The Playboy of the Western World\",\"synopsis\":\"Pegeen Flaherty’s life is turned upside down when a young man walks into her pub claiming that he’s killed his father. Instead of being shunned, the killer becomes a local hero and begins to win hearts, that is until a second man unexpectedly arrives on the scene…\",\"certificate\":\"12A\",\"casting\":[\"Nicola Coughlan\",\"Éanna Hardwicke\",\"Siobhán McSweeney\",\"Declan Conlon\"],\"direction\":[\"John Millington Synge\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-05-28T00:00:00.000Z\",\"advisory\":\"moderate injury detail, violence references\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"National Theatre\"}},{\"id\":\"1000021803\",\"title\":\"Oasis: Don’t Look Back In Anger\",\"runtime\":7680,\"genres\":\"Documentary\",\"__typename\":\"Movie\",\"altId\":[\"389147\",\"423883\"],\"poster\":\"https://all.web.img.acsta.net/img/fc/3a/fc3a3a7d2f7ac9aea34b3a466032299e.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/b6/04/b604e6a351b0525bca2490424fcfe4fb.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Dylan\",\"lastName\":\"Southern\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Will\",\"lastName\":\"Lovelace\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Oasis: Don’t Look Back In Anger\",\"synopsis\":\"“Don’t Look Back In Anger” charts Liam and Noel Gallagher’s triumphant reunion tour, Oasis Live ‘25, one of the most anticipated rock ‘n’ roll comebacks of our time. The film is an unapologetically uplifting account of the biggest musical event of 2025, capturing the experience and emotions of the band and their fans across the world. The unique perspective includes rehearsal, backstage, and onstage access as well as the first joint interviews with Noel and Liam in over 20 years. Alongside the band’s sold-out world tour, the film also explores the profound emotional impact of this phenomenal global cultural moment and what their music means to audiences and generations worldwide.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/fc/3a/fc3a3a7d2f7ac9aea34b3a466032299e.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/ba57f4b1880ec15132a6aaaee194eb04.jpg\",\"__typename\":\"BOAppImage\"}]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"_