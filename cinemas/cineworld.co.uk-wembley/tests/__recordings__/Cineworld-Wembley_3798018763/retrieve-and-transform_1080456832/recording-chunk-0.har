ease\":\"2026-09-19T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{},\"orderIndex\":57},{\"id\":\"284837\",\"title\":\"Twisters\",\"runtime\":7320,\"genres\":\"Action, Thriller, Adventure\",\"__typename\":\"Movie\",\"altId\":[\"342005\",\"356697\"],\"poster\":\"https://all.web.img.acsta.net/img/24/e4/24e423c11fb10f24675fbdcd3b58ca53.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/a2/7c/a27cc3e01cc006de1ea7450c2f9cc9c2.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/24/02/15/11/09/2571056.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/24/02/15/11/09/2842893.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/68/1f/681fb7bebe2de44d1d5cf623deedc8b5.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/34/60/3460d215e15f8ad27daceebbe9a7affd.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/b9/9d/b99d062b3a2d2f0bb0b4d836a69238d5.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/19/f4/19f43967174a60a87ee9aaa0f03e323b.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/06/03/06032c9572245211cbce833cbc32ed0e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/24/02/15/11/09/2936629.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/19/57/1957259af5c1ec50e6e0425ada508d6c.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Lee Isaac\",\"lastName\":\"Chung\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Twisters\",\"synopsis\":\"From the producers of the Jurassic, Bourne and Indiana Jones series comes Twisters, a current-day chapter of the 1996 blockbuster, Twister. Daisy Edgar-Jones stars as Kate Cooper, a former storm chaser haunted by a devastating encounter with a tornado during her college years who now studies storm patterns on screens safely in New York City. She is lured back to the open plains by her friend Javi to test a groundbreaking new tracking system. There, she crosses paths with Tyler Owens, the charming and reckless social-media superstar who thrives on posting his storm-chasing adventures with his raucous crew, the more dangerous the better. As storm season intensifies, terrifying phenomena never seen before are unleashed, and Kate, Tyler and their competing teams find themselves squarely in the paths of multiple storm systems converging over central Oklahoma in the fight of their lives.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/24/e4/24e423c11fb10f24675fbdcd3b58ca53.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/342005_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/342005_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Daisy\",\"lastName\":\"Edgar-Jones\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Glen\",\"lastName\":\"Powell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anthony\",\"lastName\":\"Ramos\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maura\",\"lastName\":\"Tierney\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__type