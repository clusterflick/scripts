n\":[\"Sang-Ho Yeon\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/pictures/16/05/09/12/15/003009.jpg\",\"https://all.web.img.acsta.net/pictures/16/07/08/12/22/088547.jpg\",\"https://all.web.img.acsta.net/pictures/16/05/09/12/15/003946.jpg\",\"https://all.web.img.acsta.net/pictures/16/07/08/12/22/089328.jpg\",\"https://all.web.img.acsta.net/pictures/16/07/08/12/22/088078.jpg\",\"https://all.web.img.acsta.net/pictures/16/07/08/12/22/088859.jpg\",\"https://all.web.img.acsta.net/pictures/16/07/08/12/22/089797.jpg\",\"https://all.web.img.acsta.net/pictures/16/07/08/12/22/090578.jpg\",\"https://all.web.img.acsta.net/pictures/16/11/23/12/22/150552.jpg\",\"https://all.web.img.acsta.net/pictures/16/11/23/12/22/151333.jpg\"],\"heroImages\":[],\"release\":\"2016-09-20T00:00:00.000Z\",\"advisory\":\"strong bloody violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"StudioCanal UK\"},\"orderIndex\":31},{\"id\":\"313481\",\"title\":\"How to Train Your Dragon\",\"runtime\":7500,\"genres\":\"Adventure, Fantasy, Action\",\"__typename\":\"Movie\",\"altId\":[\"343735\",\"380694\",\"380695\",\"380696\"],\"poster\":\"https://all.web.img.acsta.net/img/cb/c1/cbc10fab7a11505fc74ff8546e3d458e.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/68/cc/68ccf1a8b1700da565437680a59c4c48.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/bf/d7/bfd70c215d7ef2e4cd8edf3a66b0aa82.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/7c/0d/7c0d28d27f269165983063580401f67c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/7b/1a/7b1ac6e1236e6f203462e648b496dc35.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/2d/9d/2d9d5c0407184fa787516c6ac5c416cd.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/cd/6c/cd6c95ec1a4ebfbce069bc7a22718f2f.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/5a/51/5a51ea97479fb73237d5291b1ed646c0.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/2a/a5/2aa59a080860eb34ac1aecccb3ff6208.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/36/d9/36d9208b8e50f7b2e72c26707a2e483d.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Dean\",\"lastName\":\"DeBlois\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"How to Train Your Dragon\",\"synopsis\":\"On the rugged isle of Berk, where Vikings and dragons have been bitter enemies for generations, Hiccup (Mason Thames; The Black Phone, For All Mankind) stands apart. The inventive yet overlooked son of Chief Stoick the Vast (Gerard Butler, reprising his voice role from the animated franchise), Hiccup defies centuries of tradition when he befriends Toothless, a feared Night Fury dragon. Their unlikely bond reveals the true nature of dragons, challenging the very foundations of Viking society. \\n\\nWith the fierce and ambitious Astrid (BAFTA nominee Nico Parker; Dumbo, The Last of Us) and the village’s quirky blacksmith Gobber (Nick Frost; Snow White and the Huntsman, Shaun of the Dead) by his side, Hiccup confronts a world torn by fear and misunderstanding. \\nAs an ancient threat emerges, endangering both Vikings and dragons, Hiccup’s friendship with Toothless becomes the key to forging a new future. Together, they must navigate the delicate path toward peace, soaring beyond the boundaries of their worlds and redefining what it means to be a hero and a leader.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/cb/c1/cbc10fab7a11505fc74ff8546e3d458e.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/343735_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/343735_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/3832516832156bf5bab3cc4c9603c850.jpg\",\"__typename\":\"BOAppImage\"}]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mason\",\"lastName\":\"Thames\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gerard\",\"lastName\":\"Butler\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nico\",\"lastName\":\"Parker\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nick\",\"lastName\":\"Frost\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gabriel\",\"lastName\":\"Howell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Julian\",\"lastName\":\"Dennison\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bronwyn\",\"lastName\":\"James\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Harry\",\"lastName\":\"Trevaldwyn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ruth\",\"lastName\":\"Codd\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Peter\",\"lastName\":\"Serafinowicz\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-06-09T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"26962\",\"name\":\"Universal Pictures International\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild threat, scary scenes, violence, language\",\"__typename\":\"Rating\",\"certificate\":\"PG\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"How To Train Your Dragon\",\"synopsis\":\"On the rugged isle of Berk, where Vikings and dragons have been bitter enemies for generations, Hiccup (Mason Thames; The Black Phone, For All Mankind) stands apart. The inventive yet overlooked son of Chief Stoick the Vast (Gerard Butler, reprising his voice role from the animated franchise), Hiccup defies centuries of tradition when he befriends Toothless, a feared Night Fury dragon. Their unlikely bond reveals the true nature of dragons, challenging the very foundations of Viking society. \\n\\nWith the fierce and ambitious Astrid (BAFTA nominee Nico Parker; Dumbo, The Last of Us) and the village’s quirky blacksmith Gobber (Nick Frost; Snow White and the Huntsman, Shaun of the Dead) by his side, Hiccup confronts a world torn by fear and misunderstanding. \\nAs an ancient threat emerges, endangering both Vikings and dragons, Hiccup’s friendship with Toothless becomes the key to forging a new future. Together, they must navigate the delicate path toward peace, soaring beyond the boundaries of their worlds and redefining what it means to be a hero and a leader.\",\"certificate\":\"PG\",\"casting\":[\"Mason Thames\",\"Gerard Butler\",\"Nico Parker\",\"Nick Frost\",\"Gabriel Howell\",\"Julian Dennison\",\"Bronwyn James\",\"Harry Trevaldwyn\",\"Ruth Codd\",\"Peter Serafinowicz\"],\"direction\":[\"Dean DeBlois\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/68/cc/68ccf1a8b1700da565437680a59c4c48.jpg\",\"https://all.web.img.acsta.net/img/bf/d7/bfd70c215d7ef2e4cd8edf3a66b0aa82.jpg\",\"https://all.web.img.acsta.net/img/7c/0d/7c0d28d27f269165983063580401f67c.jpg\",\"https://all.web.img.acsta.net/img/7b/1a/7b1ac6e1236e6f203462e648b496dc35.jpg\",\"https://all.web.img.acsta.net/img/2d/9d/2d9d5c0407184fa787516c6ac5c416cd.jpg\",\"https://all.web.img.acsta.net/img/cd/6c/cd6c95ec1a4ebfbce069bc7a22718f2f.jpg\",\"https://all.web.img.acsta.net/img/5a/51/5a51ea97479fb73237d5291b1ed646c0.jpg\",\"https://all.web.img.acsta.net/img/2a/a5/2aa59a080860eb34ac1aecccb3ff6208.jpg\",\"https://all.web.img.acsta.net/img/36/d9/36d9208b8e50f7b2e72c26707a2e483d.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/3832516832156bf5bab3cc4c9603c850.jpg\"],\"release\":\"2025-06-09T00:00:00.000Z\",\"advisory\":\"mild threat, scary scenes, violence, language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/343735_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/343735_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Universal Pictures International\"}},{\"id\":\"1000036604\",\"title\":\"I'm Game\",\"runtime\":10260,\"genres\":\"Drama, Action, Thriller\",\"__typename\":\"Movie\",\"altId\":[\"407288\"],\"poster\":\"https://all.web.img.acsta.net/img/e8/d3/e8d347ca4da2e3734d94beb2bd6c5a5a.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Nahas\",\"lastName\":\"Hidayath\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"I'm Game\",\"synopsis\":\"A fearless gambler who trusts luck more than life gets caught in a series of crazy and unexpected events that turn his world upside down. What follows is a thrilling ride fille