            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014579\",\"name\":\"Spider-Man: Brand New Day\",\"originalName\":\"Spider-Man: Brand New Day\",\"length\":144,\"posterLink\":\"https://regalcdn.azureedge.net/CW/SpiderManBrandNewDay/HO00014579/TV_SmallPosterImage/20260603-082616564.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/SpiderManBrandNewDay/HO00014579/TV_LargePosterImage/20260603-082411718.jpg\",\"videoLink\":\"https://youtu.be/qwVAc2MmlwU\",\"link\":\"https://www.cineworld.co.uk/films/spider-man-brand-new-day/ho00014579\",\"weight\":-17,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Jon Bernthal, Tom Holland, Mark Ruffalo, Zendaya, Jacob Batalon, Sadie Sink, Tramell Tillman, Michael Mando\",\"directors\":\"Destin Daniel Cretton\",\"synopsis\":\"It's a BRAND NEW DAY for Peter Parker. Fighting crime full-time as Spider-Man in a world that doesn’t remember him -- and the pressure of seeing his old friends move on without him -- sparks a change in Peter he may not have the power to control. But that transformation might also be the only thing that can stop a shocking new threat to the city and those he loves - a powerful villain no one can even see.\\nThe world may have forgotten Peter Parker, but he hasn’t forgotten them.\",\"dateStarted\":\"2026-07-29T00:00:00\",\"eventCount\":12481,\"categoriesAttributes\":[\"action\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"3d\",\"4dx\",\"audio-described\",\"laser\",\"recliner\",\"reserved-selected\",\"sc\",\"screenx\",\"subbed\",\"superscreen\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/TBC.png\",\"ageRestrictionName\":\"tbc\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/SpiderManBrandNewDay/HO00014579/TV_TopShelfPosterImage/20260603-082411718.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/SpiderManBrandNewDay/HO00014579/TV_SmallPosterImage/20260603-082616564.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/SpiderManBrandNewDay/HO00014579/Mobile_MovieThumbnail/20260603-082411718.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/SpiderManBrandNewDay/HO00014579/TV_LargePosterImage/20260603-082411718.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/SpiderManBrandNewDay/HO00014579/Mobile_MovieFeed/20260603-082526798.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"},{\"type\":\"Video\",\"subType\":\"Trailer_Youtube\",\"url\":\"https://youtu.be/qwVAc2MmlwU\",\"dimensionHeight\":null,\"dimensionWidth\":null}],\"specialMessage\":null,\"distributorName\":\"SONY PICTURES\"}}}",
