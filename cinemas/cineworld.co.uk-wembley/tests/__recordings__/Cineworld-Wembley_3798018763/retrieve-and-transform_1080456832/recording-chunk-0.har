\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/68/dd/68ddc37ed2e488ba6871b215968dee1c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/54/d1/54d1ca0aaab3dc103031ecc3382b04f6.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/6d/82/6d82b786c01d52be69d38588f214056b.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Thomas\",\"lastName\":\"Kail\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Moana\",\"synopsis\":\"In Disney’s live-action reimagining of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyages beyond the reef of her island of Motunui with the infamous demigod Maui (Dwayne Johnson) on an unforgettable journey to restore prosperity to her people. The film is directed by Emmy® and Tony Award® winner Thomas Kail (“Hamilton”); produced by Dwayne Johnson, Beau Flynn, Dany Garcia, Hiram Garcia and Lin-Manuel Miranda; and executive produced by Thomas Kail, Scott Sheldon, Charles Newirth and Auliʻi Cravalho, who voiced Moana in the animated features “Moana” and “Moana 2.” Audiences can experience the brilliant cinematic sights, sounds and songs of “Moana” in cinemas in July 2026.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/e2/c8/e2c88707bfc3c5e740ce811b785dd022.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/348229_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/348229_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/fedd3918dd3e5345de29cb9565b03bc2.jpg\",\"__typename\":\"BOAppImage\"}]}},\"cast\":{