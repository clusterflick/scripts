s\":[],\"heroImages\":[],\"release\":\"2026-08-25T00:00:00.000Z\",\"advisory\":\"strong bloody violence, injury detail, language, threat\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Signature Entertainment\"}},{\"id\":\"1000050274\",\"title\":\"Romanchakam\",\"runtime\":8400,\"genres\":\"Drama, Romance\",\"__typename\":\"Movie\",\"altId\":[\"423435\"],\"poster\":\"https://all.web.img.acsta.net/img/16/2f/162fe76ac09335e58c2d01a34d4657f2.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Venu\",\"lastName\":\"Gopal Reddy\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Romanchakam\",\"synopsis\":\"A cocky engineering grad starts a dating app to prove he can succeed at anything. But a mysterious online connection turns his world upside down. Between a failed startup, money trouble, and crazy moments with his friends, things get messy when a strange encounter hints at something darker. What starts as a desperate chase for a girl becomes a tough journey inward--where he learns the hardest person to understand isn't someone else, but himself.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/16/2f/162fe76ac09335e58c2d01a34d4657f2.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Upendra\",\"lastName\":\"Limaye\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ananthika\",\"lastName\":\"Sanilkumar\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sumanth\",\"lastName\":\"Prabhas\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Venkatesh\",\"lastName\":\"Kakumanu\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Narendra\",\"lastName\":\"Ravi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-09-03T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"1000105686\",\"name\":\"Dreamz Entertainment\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"suicide references, moderate sex references, violence, rude gestures\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}},{\"releasedAt\":\"2026-09-02T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"1000105686\",\"name\":\"Dreamz Entertainment\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"suicide references, moderate sex references, violence, rude gestures\",\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Romanchakam\",\"synopsis\":\"A cocky engineering grad starts a dating app to prove he can succeed at anything. But a mysterious online connection turns his world upside down. Between a failed startup, money trouble, and crazy moments with his friends, things get messy when a strange encounter hints at something darker. What starts as a desperate chase for a girl becomes a tough journey inward--where he learns the hardest person to understand isn't someone else, but himself.\",\"certificate\":\"12A\",\"casting\":[\"Upendra Limaye\",\"Ananthika Sanilkumar\",\"Sumanth Prabhas\",\"Venkatesh Kakumanu\",\"Narendra Ravi\"],\"direction\":[\"Venu Gopal Reddy\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2026-09-02T00:00:00.000Z\",\"advisory\":\"suicide references, moderate sex references, violence, rude gestures\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Dreamz Entertainment\"}},{\"id\":\"1000013229\",\"title\":\"Royal Ballet and Opera: Alice’s Adventures in Wonderland\",\"runtime\":10200,\"genres\":\"Ballet\",\"__typename\":\"Movie\",\"altId\":[\"377468\"],\"poster\":\"https://all.web.img.acsta.net/img/e5/f9/e5f92bf27b5b6d0fab1261f83fd55c42.webp\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Christopher\",\"lastName\":\"Wheeldon\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Royal Ballet and Opera: Alice’s Adventures in Wonderland\",\"synopsis\":\"At a garden party on a sunny afternoon, Alice is surprised to see her parents’ friend Lewis Carroll transform into a white rabbit. When she follows him down a rabbit hole, events become curiouser and curiouser…As Alice journeys through Wonderland, she encounters countless strange creatures. She’s swept off her feet by the charming Knave of Hearts, who’s on the run for stealing the tarts. Confusion piles upon confusion. Then Alice wakes with a start. Was it all a daydream? Christopher Wheeldon’s Alice’s Adventures in Wonderland burst onto the stage in 2011 in an explosion of colour, stage magic and inventive, sophisticated choreography. Joby Talbot’s score combines contemporary soundworlds with sweeping melodies that gesture to ballet scores of the 19th century. Bob Crowley’s wildly imaginative, eye-popping designs draw on everything from puppetry to projections to make Wonderland wonderfully real. The result shows The Royal Ballet at its best, bringing together world-class dance with enchanting family entertainment and ingenious music and design.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/e5/f9/e5f92bf27b5b6d0fab1261f83fd55c42.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marcelino\",\"lastName\":\"Sambé\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"William\",\"lastName\":\"Bracewell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Matthew\",\"lastName\":\"Ball\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Francesca\",\"lastName\":\"Hayward\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2027-03-23T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Royal Ballet and Opera: Alice's Adventures in Wonderland (INACTIVE)\",\"synopsis\":\"At a garden party on a sunny afternoon, Alice is surprised to see her parents’ friend Lewis Carroll transform into a white rabbit. When she follows him down a rabbit hole, events become curiouser and curiouser…As Alice journeys through Wonderland, she encounters countless strange creatures. She’s swept off her feet by the charming Knave of Hearts, who’s on the run for stealing the tarts. Confusion piles upon confusion. Then Alice wakes with a start. Was it all a daydream? Christopher Wheeldon’s Alice’s Adventures in Wonderland burst onto the stage in 2011 in an explosion of colour, stage magic and inventive, sophisticated choreography. Joby Talbot’s score combines contemporary soundworlds with sweeping melodies that gesture to ballet scores of the 19th century. Bob Crowley’s wildly imaginative, eye-popping designs draw on everything from puppetry to projections to make Wonderland wonderfully real. The result shows The Royal Ballet at its best, bringing together world-class dance with enchanting family entertainment and ingenious music and design.\",\"certificate\":null,\"casting\":[\"Marcelino Sambé\",\"William Bracewell\",\"Matthew Ball\",\"Francesca Hayward\"],\"direction\":[\"Christopher Wheeldon\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2027-03-23T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000045318\",\"title\":\"Royal Ballet and Opera: Così fan tutte\",\"runtime\":12600,\"genres\":\"Opera\",\"poster\":\"https://all.web.img.acsta.net/img/43/04/43042daafaaf616b7eb6c998fb79859f.webp\",\"__typename\":\"Movie\",\"altId\":[\"417418\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Netia\",\"lastName\":\"Jones\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Royal Ballet and Opera: Così fan tutte\",\"synopsis\":\"Spurred on by a bet, two young men hatch a plan to test the fidelity of their girlfriends. What follows is a slippery game of seduction and power, the four lovers plunging into a dizzying world of shifting reality, where truth becomes increasingly unstable.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/43/04/43042daafaaf616b7eb6c998fb79859f.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Louise\",\"lastName\":\"Alder\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Simone\",\"lastName\":\"McIntosh\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mingjie\",\"lastName\":\"Lei\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Huw\",\"lastName\":\"Montague Rendall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gerald\",\"lastName\":\"Finley\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emily\",\"lastName\":\"Pogorelc\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2027-02-23T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Royal Ballet and Opera: Così fan tutte\",\"synopsis\":\"Spurred on by a bet, two young men hatch a plan to test the fidelity of their girlfriends. What follows is a slippery game of seduction and power, the four lovers plunging into a dizzying world of shifting reality, where truth becomes increasingly unstable.\",\"certificate\":null,\"casting\":[\"Louise Alder\",\"Simone McIntosh\",\"Mingjie Lei\",\"Huw Montague Rendall\",\"Gerald Finley\",\"Emily Pogorelc\"],\"direction\":[\"Netia Jones\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2027-02-23T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000045317\",\"title\":\"Royal Ballet and Opera: Götterdämmerung\",\"runtime\":21000,\"genres\":\"Opera\",\"poster\":\"https://all.web.img.acsta.net/img/29/46/2946a5df7babe00d9ca1b7f01359b7b9.webp\",\"__typename\":\"Movie\",\"altId\":[\"417417\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Barrie\",\"lastName\":\"Kosky\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Royal Ballet and Opera: Götterdämmerung\",\"synopsis\":\"Deception leads to treachery, then devastation, when Siegfried is tricked into betraying Brünnhilde. Learning the truth of her beloved’s innocence, Brünnhilde at last returns the ring to the Rhinemaidens, before ordering that Valhalla be swallowed in flames. Impassioned, otherworldly music – including Siegfried’s transporting Funeral March and Brünnhilde’s electrifying Immolation Scene – pairs with unmatched drama in the all-consuming conclusion of Wagner’s unforgettable saga.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/29/46/2946a5df7babe00d9ca1b7f01359b7b9.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elisabet\",\"lastName\":\"Strid\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Andreas\",\"lastName\":\"Schager\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mika\",\"lastName\":\"Kares\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2027-02-03T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Royal Ballet and Opera: Götterdämmerung\",\"synopsis\":\"Deception leads to treachery, then devastation, when Siegfried is tricked into betraying Brünnhilde. Learning the truth of her beloved’s innocence, Brünnhilde at last returns the ring to the Rhinemaidens, before ordering that Valhalla be swallowed in flames. Impassioned, otherworldly music – including Siegfried’s transporting Funeral March and Brünnhilde’s electrifying Immolation Scene – pairs with unmatched drama in the all-consuming conclusion of Wagner’s unforgettable saga.\",\"certificate\":null,\"casting\":[\"Elisabet Strid\",\"Andreas Schager\",\"Mika Kares\"],\"direction\":[\"Barrie Kosky\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2027-02-03T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000046230\",\"title\":\"Royal Ballet and Opera: Romeo and Juliet\",\"runtime\":10200,\"genres\":\"Ballet\",\"__typename\":\"Movie\",\"altId\":[\"418520\"],\"poster\":\"https://all.web.img.acsta.net/img/0b/26/0b2607691b5d4d3bdc45837857ce68d3.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[\"https://all.web.img.acsta.net/img/b7/03/b703e55a7596f9924f7893e257f6a813.jpg\"],\"locale\":{\"title\":\"Royal Ballet and Opera: Romeo and Juliet\",\"synopsis\":\"The Capulets and Montagues are sworn enemies. Yet it is love at first sight for Romeo Montague and Juliet Capulet when they meet each other at the Capulet ball, into which Romeo has snuck. The two fall in love and they profess their devotion to each other at Juliet’s balcony. They secretly get married.\\n\\nThe stakes are raised for the young couple when Romeo avenges the death of his friend Mercutio who has been killed by Tybalt, Juliet’s cousin. For this, Romeo is exiled from Verona. Meanwhile, Juliet’s parents are forcing her to marry another suitor. In order to be together, Romeo and Juliet must risk it all.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/0b/26/0b2607691b5d4d3bdc45837857ce68d3.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Kenneth\",\"lastName\":\"MacMillan\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Fumi\",\"lastName\":\"Kaneko\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Vadim\",\"lastName\":\"Muntagirov\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Francisco\",\"lastName\":\"Serrano\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2027-05-25T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Royal Ballet and Opera: Romeo and Juliet (INACTIVE)\",\"synopsis\":\"The Capulets and Montagues are sworn enemies. Yet it is love at first sight for Romeo Montague and Juliet Capulet when they meet each other at the Capulet ball, into which Romeo has snuck. The two fall in love and they profess their devotion to each other at Juliet’s balcony. They secretly get married.\\n\\nThe stakes are raised for the young couple when Romeo avenges the death of his friend Mercutio who has been killed by Tybalt, Juliet’s cousin. For this, Romeo is exiled from Verona. Meanwhile, Juliet’s parents are forcing her to marry another suitor. In order to be together, Romeo and Juliet must risk it all.\",\"certificate\":null,\"casting\":[\"Fumi Kaneko\",\"Vadim Muntagirov\",\"Francisco Serrano\"],\"direction\":[\"Kenneth MacMillan\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2027-05-25T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000046138\",\"title\":\"Royal Ballet and Opera: Tosca\",\"runtime\":11700,\"genres\":\"Opera\",\"poster\":\"https://all.web.img.acsta.net/img/5b/f3/5bf3174d5778afcc676a162e0cc0c033.webp\",\"__typename\":\"Movie\",\"altId\":[\"418415\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Oliver\",\"lastName\":\"Mears\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Royal Ballet and Opera: Tosca\",\"synopsis\":\"Floria Tosca and Mario Cavaradossi live for each other and for their art. But when Cavaradossi helps an escaped prisoner, the lovers make a deadly enemy in the form of Baron Scarpia, Chief of Police. At the mercy of Scarpia’s twisted desires, Tosca is forced to make a horrific bargain: sleeping with the man she hates, in order to save the man she loves. Can she find a way out? Oliver Mears’s acclaimed production returns, setting Puccini’s operatic thriller in a contemporary, war-torn Rome. Daniel Oren conducts Aleksandra Kurzak, who returns to the title role, joined by Saimir Pirgu as Cavaradossi and Christopher Maltman as Baron Scarpia.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/5b/f3/5bf3174d5778afcc676a162e0cc0c033.webp\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Aleksandra\",\"lastName\":\"Kurzak\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Saimir\",\"lastName\":\"Pirgu\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christopher\",\"lastName\":\"Maltman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2027-05-05T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Royal Ballet and Opera: Tosca\",\"synopsis\":\"Floria Tosca and Mario Cavaradossi live for each other and for their art. But when Cavaradossi helps an escaped prisoner, the lovers make a deadly enemy in the form of Baron Scarpia, Chief of Police. At the mercy of Scarpia’s twisted desires, Tosca is forced to make a horrific bargain: sleeping with the man she hates, in order to save the man she loves. Can she find a way out? Oliver Mears’s acclaimed production returns, setting Puccini’s operatic thriller in a contemporary, war-torn Rome. Daniel Oren conducts Aleksandra Kurzak, who returns to the title role, joined by Saimir Pirgu as Cavaradossi and Christopher Maltman as Baron Scarpia.\",\"certificate\":null,\"casting\":[\"Aleksandra Kurzak\",\"Saimir Pirgu\",\"Christopher Maltman\"],\"direction\":[\"Oliver Mears\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2027-05-05T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000014093\",\"title\":\"Runner\",\"runtime\":5820,\"genres\":\"Action, Thriller, Comedy\",\"__typename\":\"Movie\",\"altId\":[\"378684\"],\"poster\":\"https://all.web.img.acsta.net/img/8c/c4/8cc4ce613dfeba54e66c479f9308d01e.png\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/ac/12/ac12e922be20596c74528935357bf090.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c1/35/c135cca6c09c5c1642b8f6ea42dd38aa.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/1b/bd/1bbd3abe1426303e7c3caca8c7c44acb.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e3/dc/e3dcedcf0aa213194aba9a56585afcd1.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/6b/1f/6b1f77b17ecb5fae30eb62f34fa69119.j