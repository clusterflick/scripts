ame\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/4b/2a/4b2a2ca08583d0584a93b8afa57b25db.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/01/16/0116df1f42b3ae57a234b8ca72d8312f.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/cb/9c/cb9c73c42f0674626682e6545589431c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/6f/d4/6fd4d7dbc399bb540f1eff5f8de5862c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/91/65/9165f81e2a6d7992a122cab443479783.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ba/da/badadf9f50244d1b9782312bf76fd7e6.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c0/97/c097ccd9b07e1f27a0960b696351a8fb.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/9e/2a/9e2a4982f7600d14fb6061e0df038725.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/8c/0d/8c0d1f7c71eeeff20fe9c5ea36bcfec8.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/68/b9/68b9b307cdf88b0ea3763abd0b603736.jpg\",\"__typename\":\"Image\"}],\"locale\":{\"title\":\"The Transformers: The Movie 40th Anniversary\",\"synopsis\":\"In 1986, THE TRANSFORMERS: THE MOVIE rolled into theaters and changed the franchise forever. Unicron arrives as a planet-sized threat to the universe, heroes rise, legends are forged and an entire generation of kids were changed forever by THAT moment, which still hits like a truck. Featuring an iconic voice cast, unforgettable animation and a soundtrack that had absolutely no business going that hard, the film remains one of the boldest animated classics of its era. Now, forty years later, it returns to theaters in 4K for a special anniversary celebration of the battle, the music and the legacy. Stay through the credits...because as this journey ends, a new one begins.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/6f/c2/6fc27e7a4fc0f32ec8c31930509f6889.png\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/4371534488dacab365527556737cb6f0.jpg\",\"__typename\":\"BOAppImage\"}]}},\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Nelson\",\"lastName\":\"Shin\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2026-09-17T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"1000109904\",\"name\":\"Fathom Entertainment\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"12A\"}}],\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Peter\",\"lastName\":\"Cullen\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Frank\",\"lastName\":\"Welker\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Orson\",\"lastName\":\"Welles\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Jack\",\"lastName\":\"Angel\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Michael\",\"lastName\":\"Bell\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Norman\",\"lastName\":\"Alden\",\"__typename\":