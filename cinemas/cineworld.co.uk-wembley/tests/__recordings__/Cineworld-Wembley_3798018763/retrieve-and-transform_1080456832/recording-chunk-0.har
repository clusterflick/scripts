            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014569\",\"name\":\"Supergirl (2026)\",\"originalName\":\"Supergirl (2026)\",\"length\":108,\"posterLink\":\"https://regalcdn.azureedge.net/CW/Supergirl2026/HO00014569/TV_SmallPosterImage/20260618-081838300.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/Supergirl2026/HO00014569/TV_LargePosterImage/20260618-081752541.jpg\",\"videoLink\":\"https://youtu.be/GMhydAtN5dM\",\"link\":\"https://www.cineworld.co.uk/films/supergirl-2026/ho00014569\",\"weight\":-12,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Emily Beecham, David Krumholtz, Jason Momoa, Matthias Schoenaerts, Milly Alcock, Eve Ridley\",\"directors\":\"Craig Gillespie\",\"synopsis\":\"When an unexpected and ruthless adversary strikes too close to home, Kara Zor-El, aka Supergirl, reluctantly joins forces with an unlikely companion on an epic, interstellar journey of vengeance and justice.\\n\",\"dateStarted\":\"2026-06-25T00:00:00\",\"eventCount\":1348,\"categoriesAttributes\":[\"action\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"3d\",\"4dx\",\"audio-described\",\"laser\",\"recliner\",\"reserved-selected\",\"subbed\",\"superscreen\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Video\",\"subType\":\"Trailer_Youtube\",\"url\":\"https://youtu.be/GMhydAtN5dM\",\"dimensionHeight\":null,\"dimensionWidth\":null},{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/Supergirl2026/HO00014569/TV_TopShelfPosterImage/20260618-081752541.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"ht