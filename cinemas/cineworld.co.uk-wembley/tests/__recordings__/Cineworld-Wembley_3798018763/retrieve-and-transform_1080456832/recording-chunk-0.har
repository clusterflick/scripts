lVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Eileen\",\"lastName\":\"Nicholas\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-08-21T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"18\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Trainspotting 30th Anniversary\",\"synopsis\":\"Doesn't it make you proud to be Scottish?\\n\\nChoose a classic and satisfy your lust for life as Renton, Spud, Sick Boy, and Begbie return to the big screen. Among the most popular, ground-breaking, and influential films of the ‘90s, Trainspotting is back on the big screen from 24 May 2024 in brand new 4K restoration – supervised by director Danny Boyle and supported by new marketing materials.\",\"certificate\":\"18\",\"casting\":[\"Ewan McGregor\",\"Ewen Bremner\",\"Jonny Lee Miller\",\"Kevin McKidd\",\"Robert Carlyle\",\"Kelly Macdonald\",\"Shirley Henderson\",\"Peter Mullan\",\"James Cosmo\",\"Eileen Nicholas\"],\"direction\":[\"Danny Boyle\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/4451715742902430a62d8e981c5a2a8d.jpg\"],\"release\":\"2026-08-21T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"1000010215\",\"title\":\"Tuner\",\"runtime\":6540,\"genres\":\"Thriller\",\"__typename\":\"Movie\",\"altId\":[\"373577\"],\"poster\":\"https://all.web.img.acsta.net/img/3c/91/3c91d18a0094e91ce71e588ab84673a9.jfif\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/74/81/74817023520230ae1e6a227ef19139c4.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/d4/7e/d47e400652207ecb89c4eef654933ba6.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/83/02/8302b443efe0775d3031a6a5f6af87da.jpeg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/91/17/911701deb500338cc57866fbc52d797e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/61/3f/613ffe7bd175712746705e2710889a10.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/eb/23/eb235a2275a008012de6fcda74441cae.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/fb/42/fb4252d958a4c9fa50de90d94ab21afe.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/1b/09/1b094d0fc0ca232c1f85b9187baaf153.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/5b/f0/5bf082fc30a0a03035b486df48c9ca47.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e3/4c/e34cf1c0f6924621f89d824002fb0958.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Daniel\",\"lastName\":\"Roher\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Tuner\",\"synopsis\":\"In Tuner, Academy Award-winning director Daniel Roher’s first narrative feature, Leo Woodall stars as a gifted young piano tuner whose heightened sense of hearing draws the attention of criminals, who see his talents as useful for opening safes as well as for tuning Steinways. With his once-promising musical career over, he works across New York with his mentor Harry Horowitz (Academy Award-winner Dustin Hoffman), encountering a range of characters, including composition student Ruthie (Havana Rose Liu), with whom he forges an unexpected connection. Niki’s safecracking work threatens his budding romance with Ruthie and pulls him into increasingly dangerous territory. Blending romance, drama, and the taut suspense of a heist thriller, Tuner also features performances from Tony Award-winner Tovah Feldshuh, Lior Raz, and Jean Reno.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/3c/91/3c91d18a0094e91ce71e588ab84673a9.jfif\",\"__typename\":\"Image\"},\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/373577_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/373577_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/646a4a912b233e2ec3aad282868da81e.jpg\",\"__typename\":\"BOAppImage\"}]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Leo\",\"lastName\":\"Woodall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dustin\",\"lastName\":\"Hoffman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Havana Rose\",\"lastName\":\"Liu\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lior\",\"lastName\":\"Raz\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jean\",\"lastName\":\"Reno\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tovah\",\"lastName\":\"Feldshuh\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"C.S.\",\"lastName\":\"Lee\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nissan\",\"lastName\":\"Sakira\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gil\",\"lastName\":\"Cohen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":null,\"lastName\":\"Rekstizzy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-05-29T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"1000110350\",\"name\":\"Black Bear Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong language, drug misuse, violence, brief sexual images\",\"__typename\":\"Rating\",\"certificate\":\"15\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Tuner\",\"synopsis\":\"In Tuner, Academy Award-winning director Daniel Roher’s first narrative feature, Leo Woodall stars as a gifted young piano tuner whose heightened sense of hearing draws the attention of criminals, who see his talents as useful for opening safes as well as for tuning Steinways. With his once-promising musical career over, he works across New York with his mentor Harry Horowitz (Academy Award-winner Dustin Hoffman), encountering a range of characters, including composition student Ruthie (Havana Rose Liu), with whom he forges an unexpected connection. Niki’s safecracking work threatens his budding romance with Ruthie and pulls him into increasingly dangerous territory. Blending romance, drama, and the taut suspense of a heist thriller, Tuner also features performances from Tony Award-winner Tovah Feldshuh, Lior Raz, and Jean Reno.\",\"certificate\":\"15\",\"casting\":[\"Leo Woodall\",\"Dustin Hoffman\",\"Havana Rose Liu\",\"Lior Raz\",\"Jean Reno\",\"Tovah Feldshuh\",\"C.S. Lee\",\"Nissan Sakira\",\"Gil Cohen\",\"Rekstizzy\"],\"direction\":[\"Daniel Roher\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/74/81/74817023520230ae1e6a227ef19139c4.jpg\",\"https://all.web.img.acsta.net/img/d4/7e/d47e400652207ecb89c4eef654933ba6.jpg\",\"https://all.web.img.acsta.net/img/83/02/8302b443efe0775d3031a6a5f6af87da.jpeg\",\"https://all.web.img.acsta.net/img/91/17/911701deb500338cc57866fbc52d797e.jpg\",\"https://all.web.img.acsta.net/img/61/3f/613ffe7bd175712746705e2710889a10.jpg\",\"https://all.web.img.acsta.net/img/eb/23/eb235a2275a008012de6fcda74441cae.jpg\",\"https://all.web.img.acsta.net/img/fb/42/fb4252d958a4c9fa50de90d94ab21afe.jpg\",\"https://all.web.img.acsta.net/img/1b/09/1b094d0fc0ca232c1f85b9187baaf153.jpg\",\"https://all.web.img.acsta.net/img/5b/f0/5bf082fc30a0a03035b486df48c9ca47.jpg\",\"https://all.web.img.acsta.net/img/e3/4c/e34cf1c0f6924621f89d824002fb0958.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/646a4a912b233e2ec3aad282868da81e.jpg\"],\"release\":\"2026-05-29T00:00:00.000Z\",\"advisory\":\"strong language, drug misuse, violence, brief sexual images\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/373577_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/373577_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Black Bear Pictures\"}},{\"id\":\"1000044545\",\"title\":\"Twenty Years of the Met in Cinemas\",\"runtime\":9000,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"416519\"],\"poster\":\"https://all.web.img.acsta.net/img/26/5c/265cec760bce8a605ca2768a6754f59b.jpg\",\"directors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"locale\":{\"title\":\"Twenty Years of the Met in Cinemas\",\"synopsis\":\"Twenty Years of the Met in Cinemas is a celebration of the Met's two decades of onstage glory as experienced in movie theaters, featuring highlights from the company's collection of more than 185 extraordinary onscreen performances. With star soprano Renée Fleming as host, this special presentation will showcase unforgettable moments from some of opera's greatest stars, culled from the series' vast archive of transmissions.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/26/5c/265cec760bce8a605ca2768a6754f59b.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/4e613581da3d20e9e2b864fa1d7a905d.jpg\",\"__typename\":\"BOAppImage\"}]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Renée\",\"lastName\":\"Fleming\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lise\",\"lastName\":\"Davidsen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Asmik\",\"lastName\":\"Grigorian\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joyce\",\"lastName\":\"DiDonato\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elīna\",\"lastName\":\"Garanča\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nadine\",\"lastName\":\"Sierra\",\"__typename\":\"Person\"},\"originalVoiceActor\":null