{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rose\",\"lastName\":\"Flanagan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-09-02T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"31124\",\"name\":\"Picturehouse Entertainment\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong violence, injury detail, horror, sex, very strong language\",\"__typename\":\"Rating\",\"certificate\":\"15\"}},{\"releasedAt\":\"2026-09-04T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"31124\",\"name\":\"Picturehouse Entertainment\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Leviticus\",\"synopsis\":\"Two teens try to escape from a violent entity that takes the form of the person they desire most.\",\"certificate\":\"15\",\"casting\":[\"Joe Bird\",\"Stacy Clausen\",\"Mia Wasikowska\",\"Jeremy Blewitt\",\"Ewen Leslie\",\"Davida McKenzie\",\"Shannon Berry\",\"Nicholas Hope\",\"Tyallah Bullock\",\"Rose Flanagan\"],\"direction\":[\"Adrian Chiarella\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/cf/86/cf868fca8d1a26f81f15d3fb48f4d598.jpeg\",\"https://all.web.img.acsta.net/img/cc/bc/ccbc2bb3056549abdee5b8781276d316.jpeg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/a072ef292ff8ab8c8f6a0b51606bc98b.jpg\"],\"release\":\"2026-09-02T00:00:00.000Z\",\"advisory\":\"strong violence, injury detail, horror, sex, very strong language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Picturehouse Entertainment\"}},{\"id\":\"1000049814\",\"title\":\"Linkin Park: Unshatter\",\"runtime\":6780,\"genres\":\"Music, Concert, Documentary\",\"__typename\":\"Movie\",\"altId\":[\"422877\"],\"poster\":\"https://all.web.img.acsta.net/img/60/c9/60c9891f8decc111e89b92f96e6dde9f.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/b4/ab/b4ab7999790d01e51e4a09da8f58afea.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Joe\",\"lastName\":\"Hahn\",\"__typename\":\"Person\"}}]},\"locale\":{\"title\":\"Linkin Park: Unshatter\",\"synopsis\":\"The hardest part of ending is starting again.\\n\\nAfter a seven-year hiatus following the devastating loss of their beloved bandmate Chester Bennington, LINKIN PARK’S remaining members struggle to find their way forward. Their shared history and enduring friendship, combined with the fresh perspective of two new band members spark a renewed creative energy that leads them on a transformative journey of artistic reinvention.\\n\\nFollowing the band from intimate 2022 studio sessions through their explosive FROM ZERO album release and concert in São Paulo, the film UNSHATTER weaves together rare vault footage, electrifying performances from sold-out shows, and candid interviews with band members and fans—capturing the raw, honest story of what it means to start over.\",\"__typename\":\"MovieLocalized\",\"sdTeasers\":[],\"hdTeasers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/60/c9/60c9891f8decc111e89b92f96e6dde9f.jpg\",\"__typename\":\"Image\"},\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/49f45624fe1d594cc0bdf67afda7e977.jpg\",\"__typename\":\"BOAppImage\"}]}},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emily\",\"lastName\":\"Armstrong\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Colin\",\"lastName\":\"Brittain\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brad\",\"lastName\":\"Delson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dave \\\"Phoenix\\\"\",\"lastName\":\"Farrell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joseph\",\"lastName\":\"Hahn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mike\",\"lastName\":\"Shinoda\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alex\",\"lastName\":\"Feder\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-09-30T00:00:00.000Z\",\"__typename\":\"Release\",\"localRatings\":[],\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong language\",\"__typename\":\"Rating\",\"certificate\":\"15\"}}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Linkin Park: Unshatter\",\"synopsis\":\"The hardest part of ending is starting again.\\n\\nAfter a seven-year hiatus following the devastating loss of their beloved bandmate Chester Bennington, LINKIN PARK’S remaining members struggle to find their way forward. Their shared history and enduring friendship, combined with the fresh perspective of two new band members spark a renewed creative energy that leads them on a transformative journey of artistic reinvention.\\n\\nFollowing the band from intimate 2022 studio sessions through their explosive FROM ZERO album release and concert in São Paulo, the film UNSHATTER weaves together rare vault footage, electrifying performances from sold-out shows, and candid interviews with band members and fans—capturing the raw, honest story of what it means to start over.\",\"certificate\":\"15\",\"casting\":[\"Emily Armstrong\",\"Colin Brittain\",\"Brad Delson\",\"Dave \\\"Phoenix\\\" Farrell\",\"Joseph Hahn\",\"Mike Shinoda\",\"Alex Feder\"],\"direction\":[\"Joe Hahn\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/b4/ab/b4ab7999790d01e51e4a09da8f58afea.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/49f45624fe1d594cc0bdf67afda7e977.jpg\"],\"release\":\"2026-09-30T00:00:00.000Z\",\"advisory\":\"strong language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"},\"orderIndex\":52},{\"id\":\"1000026220\",\"title\":\"Little Monsters 2\",\"runtime\":5280,\"genres\":\"Adventure, Animation, Comedy, Family\",\"__typename\":\"Movie\",\"altId\":[\"394712\"],\"poster\":\"https://all.web.img.acsta.net/img/4f/af/4faffb8fc2aa9b1b61ee0cd0f1211b27.jpg\",\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/d3/2a/d32aa9e4271c5e513e7bd52ac75a5263.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/3b/98/3b98cf7670fdbeee4b149545225e325d.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/f0/d5/f0d55f24d21e89148870c9fdab2cb84b.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/63/7b/637b3f85b589a300a2ce4ea6288cd7ca.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ce/1e/ce1e54e8165c732cbde0f35cd3dfebe5.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://al