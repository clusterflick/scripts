            "text": "{\"cinemas\":{\"603\":{\"id\":603,\"vistaId\":\"0000000459\",\"title\":\"Portobello\",\"address\":\"191 Portobello Road, Notting Hill, London W11 2ED\",\"image\":false,\"link\":\"\\/portobello\\/\",\"url\":\"portobello\",\"areas\":{\"0000000002\":{\"id\":\"0000000002\",\"label\":\"Armchair\",\"isSofa\":false},\"0000000001\":{\"id\":\"0000000001\",\"label\":\"Front Row Bed (seats 2)\",\"isSofa\":true},\"0000000003\":{\"id\":\"0000000003\",\"label\":\"Back Row Sofa (seats 2)\",\"isSofa\":true}},\"home\":false},\"602\":{\"id\":602,\"vistaId\":\"0000000458\",\"title\":\"White City\",\"address\":\"2 Television Centre, 101 Wood Lane, London W12 7FR\",\"image\":false,\"link\":\"\\/white-city\\/\",\"url\":\"white-city\",\"areas\":{\"0000000001\":{\"id\":\"0000000001\",\"label\":\"Armchair\",\"isSofa\":false}},\"home\":false}},\"cinemaOrder\":[603,602],\"films\":{\"64172\":{\"vistaId\":\"ST00000424\",\"title\":\"Parent and Baby: Shoot the People\",\"image\":\"\\/wp-content\\/uploads\\/film\\/64172.backdrop_raw.jpg?v=7f5fc98af52eaf51e9659358d03e86b2\",\"link\":\"\\/film\\/parent-and-baby-shoot-the-people\\/\",\"rating\":\"12A\",\"short_synopsis\":\"Shoot the People is an intimate and urgent portrait of the Oscar-nominated documentarian Misan Harriman. Renowned for his wide-ragning work including powerful breatkthrough images from the 2020 Black Lives Matter protests and capturing the Palestinian liberation movement on film, Harriman also made history as the first Black man to photograph a British Vogue cover.\",\"premiere\":\"2026-07-10\",\"director\":\"Andy Mundy-Castle\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=DK-Nl7y4050\",\"screeningCinemas\":[\"602\"],\"screeningTypes\":[\"BABY\"],\"screenings\":{\"byCinema\":{\"602\":{\"2026-07-14\":[64197]}},\"byDateCinemaTime\":{\"2026-07-14\":{\"602\":[64197]}}},\"cinemas\":{\"602\":1}},\"64124\":{\"vistaId\":\"ST00000418\",\"title\":\"Parent and Baby: Disclosure Day\",\"image\":\"\\/wp-content\\/uploads\\/film\\/64124.backdrop_raw.jpg?v=7d0dda0178ff0bad96e183736dfb9c17\",\"link\":\"\\/film\\/parent-and-baby-disclosure-day-2\\/\",\"rating\":\"12A\",\"short_synopsis\":\"If you found out we weren\\u2019t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\r\\n\\r\\nWe are coming close to \\u2026 Disclosure Day.\",\"premiere\":\"2026-06-10\",\"director\":\"Steven Spielberg\",\"trailer\":\"https:\\/\\/youtu.be\\/Xxu3yzbvs6k\",\"screeningCinemas\":[\"603\"],\"screeningTypes\":[\"BABY\"],\"screenings\":{\"byCinema\":{\"603\":{\"2026-07-13\":[64129]}},\"byDateCinemaTime\":{\"2026-07-13\":{\"603\":[64129]}}},\"cinemas\":{\"603\":1}},\"64084\":{\"vistaId\":\"ST00000412\",\"title\":\"Shoot the People\",\"image\":\"\\/wp-content\\/uploads\\/film\\/64084.backdrop_raw.jpg?v=7f5fc98af52eaf51e9659358d03e86b2\",\"link\":\"\\/film\\/shoot-the-people-2\\/\",\"rating\":\"12A\",\"short_synopsis\":\"Shoot the People is an intimate and urgent portrait of the Oscar-nominated documentarian Misan Harriman. Renowned for his wide-ragning work including powerful breatkthrough images from the 2020 Black Lives Matter protests and capturing the Palestinian liberation movement on film, Harriman also made history as the first Black man to photograph a British Vogue cover.\",\"premiere\":\"2026-07-10\",\"director\":\"Andy Mundy-Castle\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=DK-Nl7y4050\",\"screeningCinemas\":[\"602\"],\"screeningTypes\":[\"\"],\"screenings\":{\"byCinema\":{\"602\":{\"2026-07-11\":[64194],\"2026-07-12\":[64216,64200],\"2026-07-13\":[64195],\"2026-07-14\":[64217],\"2026-07-15\":[64196],\"2026-07-16\":[64218]}},\"byDateCinemaTime\":{\"2026-07-11\":{\"602\":[64194]},\"2026-07-12\":{\"602\":[64216,64200]},\"2026-07-13\":{\"602\":[64195]},\"2026-07-14\":{\"602\":[64217]},\"2026-07-15\":{\"602\":[64196]},\"2026-07-16\":{\"602\":[64218]}}},\"cinemas\":{\"602\":1}},\"63637\":{\"vistaId\":\"ST00000410\",\"title\":\"Shoot the People + Q&A\",\"image\":\"\\/wp-content\\/uploads\\/film\\/63637.backdrop_raw.jpg?v=7f5fc98af52eaf51e9659358d03e86b2\",\"link\":\"\\/film\\/shoot-the-people\\/\",\"rating\":\"12A\",\"short_synopsis\":\"Join us for a very special screening, followed by a Q&A with director Andy Mundy-Castle and producer Wyn Baptiste.\\r\\n\\r\\nShoot the People is an intimate and urgent portrait of the Oscar-nominated documentarian Misan Harriman. Renowned for his wide-ragning work including powerful breatkthrough images from the 2020 Black Lives Matter protests and capturing the Palestinian liberation movement on film, Harriman also made history as the first Black man to photograph a British Vogue cover.\",\"premiere\":\"2026-07-10\",\"director\":\"Andy Mundy-Castle\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=DK-Nl7y4050\",\"screeningCinemas\":[\"603\"],\"screeningTypes\":[\"\"],\"screenings\":{\"byCinema\":{\"603\":{\"2026-07-13\":[63640]}},\"byDateCinemaTime\":{\"2026-07-13\":{\"603\":[63640]}}},\"cinemas\":{\"603\":1}},\"63011\":{\"vistaId\":\"ST00000404\",\"title\":\"Monster House\",\"image\":\"\\/wp-content\\/uploads\\/film\\/63011.backdrop_raw.jpg?v=718ef1a2e0837b96028670df3ca9dd6f\",\"link\":\"\\/film\\/monster-house\\/\",\"rating\":\"PG\",\"short_synopsis\":\"When three young teens try to convince those around them that a house nearby is haunted, their warnings fall on deaf ears. They must now do their best to protect young children from going there.\",\"premiere\":\"2006-08-11\",\"director\":\"Gil Kenan\",\"trailer\":\"https:\\/\\/www.youtube.com\\/watch?v=yB9vThNAIjs\",\"screeningCinemas\":[\"602\"],\"screeningTypes\":[\"KC\"],\"screenings\":{\"byCinema\":{\"602\":{\"2026-07-12\":[63385]}},\"byDateCinemaTime\":{\"2026-07-12\":{\"602\":[63385]}}},\"cinemas\":{\"602\":1}},\"61587\":{\"vistaId\":\"ST00000394\",\"title\":\"Spider-Man: Brand New Day\",\"image\":\"\\/wp-content\\/uploads\\/film\\/61587.backdrop_raw.jpg?v=23243aa7905f96a8a952e5f8abcd4eb5\",\"link\":\"\\/film\\/spider-man-brand-new-day\\/\",\"rating\":\"TBC\",\"short_synopsis\":\"Fighting crime full-time as Spider-Man in a world that doesn\\u2019t remember him -- and the pressure of seeing his old friends move on without him -- sparks a change in Peter he may not have the power to control. But that transformation might also be the only thing that can stop a shocking new threat to the city and those he loves - a powerful villain no one can even see.\\r\\n\\r\\nThe world may have forgotten Peter Parker, but he hasn\\u2019t forgotten them.\",\"premiere\":\"2026-07-29\",\"director\":\"Destin Daniel Cretton\",\"trailer\":\"https:\\/\\/youtu.be\\/F9a2tTP4_mk\",\"screeningCinemas\":[\"602\"],\"screeningTypes\":[\"\"],\"screenings\":{\"byCinema\":{\"602\":{\"2026-07-29\":[61590],\"2026-07-30\":[61600],\"2026-07-31\":[61592,61593],\"2026-08-01\":[61594,61595,61596],\"2026-08-02\":[61597,61598,61599]}},\"byDateCinemaTime\":{\"2026-07-29\":{\"602\":[61590]},\"2026-07-30\":{\"602\":[61600]},\"2026-07-31\":{\"602\":[61592,61593]},\"2026-08-01\":{\"602\":[61594,61595,61596]},\"2026-08-02\":{\"602\":[61597,61598,61599]}}},\"cinemas\":{\"602\":1}},\"61176\":{\"vistaId\":\"ST00000376\",\"title\":\"The Invite\",\"image\":\"\\/wp-content\\/uploads\\/film\\/61176.backdrop_raw.jpg?v=faad896cca821457efb8d4d19792c6f1\",\"link\":\"\\/film\\/the-invite\\/\",\"rating\":\"15\",\"short_synopsis\":\"A stellar cast: Edward Norton, Penelope Cruz, Seth Rogen and Director Olivia Wilde star in this new \\u2018sex-comedy\\u2019 penned by Rashida Jones.  Boldly shot in one location, a marriage is challenged by bohemian upstairs neighbours coming to dinner.  Squirm-inducing, not to be missed.\",\"premiere\":\"2026-07-03\",\"director\":\"Olivia Wilde\",\"trailer\":\"https:\\/\\/youtu.be\\/uvjVE_hjI1E\",\"screeningCinemas\":[\"603\",\"602\"],\"screeningTypes\":[\"\"],\"screenings\":{\"byCinema\":{\"603\":{\"2026-07-11\":[64109],\"2026-07-12\":[64110,64111],\"2026-07-13\":[64133],\"2026-07-14\":[64136],\"2026-07-15\":[64137],\"2026-07-16\":[64139]},\"602\":{\"2026-07-11\":[64190],\"2026-07-12\":[64212,64191],\"2026-07-13\":[64213],\"2026-07-14\":[64192],\"2026-07-15\":[64214],\"2026-07-16\":[64193]}},\"byDateCinemaTime\":{\"2026-07-11\":{\"603\":[64109],\"602\":[64190]},\"2026-07-12\":{\"603\":[64110,64111],\"602\":[64212,64191]},\"2026-07-13\":{\"602\":[64213],\"603\":[64133]},\"2026-07-14\":{\"602\":[64192],\"603\":[64136]},\"2026-07-15\":{\"603\":[64137],\"602\":[64214]},\"2026-07-16\":{\"603\":[64139],\"602\":[64193]}}},\"cinemas\":{\"603\":1,\"602\":1}},\"59112\":{\"vistaId\":\"ST00000372\",\"title\":\"The Odyssey\",\"image\":\"\\/wp-content\\/uploads\\/film\\/59112.backdrop_raw.jpg?v=2e15bcfbc8e969c108af4402a8f9e427\",\"link\":\"\\/film\\/the-odyssey\\/\",\"rating\":\"15\",\"short_synopsis\":\"Christopher Nolan's new vision of Homer's epic tale. Odysseus, king of Ithaca, embarks on a perilous journey to return home after the Trojan War...\",\"premiere\":\"2026-07-17\",\"director\":\"Christopher Nolan\",\"trailer\":\"https:\\/\\/youtu.be\\/f3sSj2yfvwQ\",\"screeningCinemas\":[\"603\",\"602\"],\"screeningTypes\":[\"\"],\"screenings\":{\"byCinema\":{\"603\":{\"2026-07-17\":[61142,61138],\"2026-07-18\":[61139,61140,61141]},\"602\":{\"2026-07-17\":[61144,61145],\"2026-07-18\":[61147,61148,61149],\"2026-07-19\":[61150,61151,61152]}},\"byDateCinemaTime\":{\"2026-07-17\":{\"603\":[61142,61138],\"602\":[61144,61145]},\"2026-07-18\":{\"603\":[61139,61140,61141],\"602\":[61147,61148,61149]},\"2026-07-19\":{\"602\":[61150,61151,61152]}}},\"cinemas\":{\"603\":1,\"602\":1}},\"59110\":{\"vistaId\":\"ST00000370\",\"title\":\"Toy Story 5\",\"image\":\"\\/wp-content\\/uploads\\/film\\/59110.backdrop_raw.jpg?v=81100224f2d2e546cac0d0c9b814c073\",\"link\":\"\\/film\\/toy-story-5\\/\",\"rating\":\"PG\",\"short_synopsis\":\"The toys are back in Disney and Pixar\\u2019s \\u201cToy Story 5,\\u201d and this time around it\\u2019s Toy meets Tech. Buzz, Woody, J