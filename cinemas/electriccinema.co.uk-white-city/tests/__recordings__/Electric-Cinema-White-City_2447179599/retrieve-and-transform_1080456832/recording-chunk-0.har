6\",\"55857\",\"57320\",\"64124\",\"63637\",\"59112\"],\"602\":[\"59110\",\"64084\",\"55857\",\"61176\",\"63011\",\"64172\",\"59112\",\"61587\"]},\"attributeNotes\":[],\"screeningTypes\":{\"BABY\":{\"title\":\"Parent & Baby\",\"popup\":true,\"popupTitle\":\"Parent & Baby\",\"popupText\":\"<p>Weekly screening of the latest releases to come along to with your baby (Under 2), with lower volume, subtitles and slightly raised lighting for a more relaxed feel so your little ones can be as loud as they want!<\\/p>\\n<p>For Parent &amp; Baby screenings at Electric White City, all buggies\\/prams must be stored outside of the screening room during the performance.<\\/p>\\n<p><strong>Please note, that all adults purchasing tickets for our parent &amp; baby performances must be accompanied by an infant under 2, otherwise they will be refused admission without refund.<\\/strong><\\/p>\\n\",\"menuOrder\":null,\"image\":\"https:\\/\\/www.electriccinema.co.uk\\/wp-content\\/uploads\\/2025\\/01\\/PB-Cream.png\",\"booking_intro_text\":\"\",\"booking_confirm_checkbox\":\"I understand that adults purchasing tickets for Parent & Baby performances must be accompanied by an infant under 2 years old. otherwise they will be refused admission without a refund. Please also note, that at White City, all buggies\\/prams must be stored outside the screening room for the performance.\",\"booking_confirm_severity\":\"critical\",\"showInBookingLink\":true},\"KC\":{\"title\":\"Electric Kids Club\",\"popup\":true,\"popupTitle\":\"Electric Kids Club\",\"popupText\":\"<p>Join us every Sunday at White City for discounted Children's cinema, ranging from family classics to newer releases to introduce the kids to the magic of the movies.<\\/p>\\n<p><strong>Please note, that adults who are unaccompanied by a child will not be admitted to Electric kids club performances.<\\/strong><\\/p>\\n\",\"menuOrder\":null,\"image\":\"https:\\/\\/www.electriccinema.co.uk\\/wp-content\\/uploads\\/2024\\/09\\/KC-CREAM.png\",\"booking_intro_text\":\"\",\"booking_confirm_checkbox\":\"I understand that adults purchasing tickets must be accompanied by a child, otherwise they will be refused admission without a refund.\",\"booking_confirm_severity\":\"critical\",\"showInBookingLink\":true},\"SE\":{\"title\":\"Electric Selects\",\"popup\":true,\"popupTitle\":\"Electric Selects\",\"popupText\":\"<p>A showcase of curated cinema, from recent releases to all-time cinematic classics, one-off performances and specially themed seasons back on the big screen at the Electrics.<\\/p>\\n\",\"menuOrder\":null,\"image\":\"https:\\/\\/www.electriccinema.co.uk\\/wp-content\\/uploads\\/2025\\/01\\/SELECTS-CREAM.png\",\"booking_intro_text\":\"\",\"booking_confirm_checkbox\":\"\",\"booking_confirm_severity\":\"note\",\"showInBookingLink\":true},\"EA\":{\"title\":\"Electric Subtitled\",\"popup\":true,\"popupTitle\":\"Electric Subtitled\",\"popupText\":\"<p>Weekly screenings of the latest releases with full captions for the hearing impaired.<\\/p>\\n\",\"menuOrder\":null,\"image\":\"https:\\/\\/www.electriccinema.co.uk\\/wp-content\\/uploads\\/2024\\/09\\/SUBTITLED-CREAM.png\",\"booking_intro_text\":\"\",\"booking_confirm_checkbox\":\"I understand that this is an Electric Subtitled screening for the hearing impaired and screenings will be shown with subtitles.\",\"booking_confirm_severity\":\"caution\",\"showInBookingLink\":true}},\"id\":\"6a527a343fa87\",\"isMember\":false,\"messages\":[]}",
