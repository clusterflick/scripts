eschafft\",[],{\"_key\":3083,\"_type\":1600,\"children\":3356,\"level\":1318,\"listItem\":2868,\"markDefs\":3361,\"style\":1608},[3357],{\"_key\":3358,\"_type\":1604,\"marks\":3359,\"text\":3360},\"0366b7fc8811\",[],\"Ein linkes Fass bekommen\",[],{\"_key\":3091,\"_type\":1600,\"children\":3363,\"level\":1318,\"listItem\":2868,\"markDefs\":3368,\"style\":1608},[3364],{\"_key\":3365,\"_type\":1604,\"marks\":3366,\"text\":3367},\"aea1934cf7ec\",[],\"Verstehen, was „Bring deinen Schnorchel mit, Kumpel!“ bedeutet.\",[],{\"src\":25},{\"_type\":2932,\"fetchMode\":2933,\"filterId\":2934,\"filterName\":2934,\"mediaItems\":3371},[3372],{\"_key\":3373,\"_type\":1539,\"altText\":3374,\"center\":3375,\"description\":3387,\"height\":2956,\"id\":3373,\"name\":3388,\"pathCdn\":3389,\"preferredCenter\":3378,\"type\":1565,\"width\":3390},\"1dc671oJu7qlWRqhR6vrkAtvVSQGw7nTs-2c29c4e2dffef64c6ce2fed01aa51640.jpg\",\"A man wearing a Norrøna jacket and sunglasses smiles while standing in a snowy mountain landscape. \\n\",[3376,3379,3383],{\"_key\":3377,\"_type\":2942,\"aspectRatio\":1318,\"bottomRightX\":1547,\"bottomRightY\":1546,\"fileId\":3373,\"id\":3378,\"isManual\":26,\"topLeftX\":1545,\"topLeftY\":1531},\"160141\",160141,{\"_key\":3380,\"_type\":2942,\"aspectRatio\":1330,\"bottomRightX\":1559,\"bottomRightY\":3381,\"fileId\":3373,\"id\":3382,\"isManual\":26,\"topLeftX\":1531,\"topLeftY\":1531},\"160142\",0.6667,160142,{\"_key\":3384,\"_type\":2942,\"aspectRatio\":1556,\"bottomRightX\":3385,\"bottomRightY\":1546,\"fileId\":3373,\"id\":3386,\"isManual\":26,\"topLeftX\":1661,\"topLeftY\":1531},\"160143\",0.625,160143,\"Sverre Hjørnevik, Emil Leenderts\",\"FW2526-femund-norrona_femunden_winter_sjut_sverrehjornevik-4086.jpg\",\"Auto\\u002FFW2526-femund-norrona_femunden_winter_sjut_sverrehjornevik-4086\",7680,\"Volda\",[3393,3395],{\"_key\":3394,\"_type\":1519,\"label\":3394,\"value\":3394},\"Photography\",{\"_key\":3396,\"_type\":1519,\"label\":3396,\"value\":3396},\"Filmmaking\",[3398,3399],{\"_key\":517,\"_type\":1519,\"label\":517,\"value\":517},{\"_key\":2971,\"_type\":1519,\"label\":2971,\"value\":2971},{\"_id\":2984,\"title\":2985,\"value\":3401},{\"_type\":1530,\"current\":2987},{\"_type\":1530,\"current\":3403},\"emil-leenderts\",[3405,3408],{\"_key\":3406,\"_type\":2994,\"platform\":2995,\"url\":3407},\"38e2cd4a4cc5\",\"https:\\u002F\\u002Fwww.instagram.com\\u002Femil.i.lonneberget\",{\"_key\":3409,\"_type\":2994,\"platform\":3410,\"url\":3411},\"aee40073c7e3\",\"youtube\",\"https:\\u002F\\u002Fwww.youtube.com\\u002F@emil.i.lonneberget\",{\"lead\":3413,\"subTitle\":3414},\"Emil Leenderts describes himself as a semi‑professional snowboarder, surfer and filmmaker and spends most of his time in the mountains and in the ocean.\",\"Snowboarder\",\"Emil Leenderts\",[3417,3425,3435,3443,3458,3466,3486,3494,3510,3518,3526,3534,3542,3558,3566,3574,3582,3599,3607,3615,3623,3631,3639,3647,3674],{\"_key\":3418,\"_type\":1600,\"children\":3419,\"markDefs\":3424,\"style\":1608},\"07227cb52784\",[3420],{\"_key\":3421,\"_type\":1604,\"marks\":3422,\"text\":3423},\"26e1683c2627\",[],\"Together, we'll premiere three remarkable Norwegian ski films that remind us why we keep chasing winter, year after year. An evening dedicated to deep powder, towering mountains, unforgettable stories, and the people who live for winter.\",[],{\"_key\":3426,\"_type\":1600,\"children\":3427,\"markDefs\":3433,\"style\":3434},\"12896221eead\",[3428],{\"_key\":3429,\"_type\":1604,\"marks\":3430,\"text\":3432},\"89042a302840\",[3431],\"strong\",\"“Ferryland”\",[],\"h4\",{\"_key\":3436,\"_type\":1600,\"children\":3437,\"markDefs\":3442,\"style\":1608},\"08348f27a967\",[3438],{\"_key\":3439,\"_type\":1604,\"marks\":3440,\"text\":3441},\"6568ce414be1\",[],\"Hidden in the middle of Norway's spectacular Hjørundfjord lies a tiny village with no road in or out – only mountains rising straight from the sea.\",[],{\"_key\":3444,\"_type\":1600,\"children\":3445,\"markDefs\":3457,\"style\":1608},\"254742f08c9d\",[3446,3450,3453],{\"_key\":3447,\"_type\":1604,\"marks\":3448,\"text\":3449},\"7875c60d6677\",[],\"Norrøna ambassador and professional snowboarder \",{\"_key\":3451,\"_type\":1604,\"marks\":3452,\"text\":3415},\"00461d6fc503\",[3431],{\"_key\":3454,\"_type\":1604,\"marks\":3455,\"text\":3456},\"4eb3a65a7002\",[],\" gathers a crew of close friends and heads into this extraordinary landscape in search of steep lines, deep snow, and the kind of skiing and snowboarding most people only dream about.\",[],{\"_key\":3459,\"_type\":1600,\"children\":3460,\"markDefs\":3465,\"style\":1608},\"f83d0ea3e39b\",[3461],{\"_key\":3462,\"_type\":1604,\"marks\":3463,\"text\":3464},\"e6994379c6c3\",[],\"This is a celebration of friendship, freedom, and the endless possibilities waiting beyond the map. \",[],{\"_key\":3467,\"_type\":1600,\"children\":3468,\"markDefs\":3485,\"style\":1608},\"d36b44c3f4dd\",[3469,3473,3477,3481],{\"_key\":3470,\"_type\":1604,\"marks\":3471,\"text\":3472},\"af276ed2b3da\",[],\"The film was also \",{\"_key\":3474,\"_type\":1604,\"marks\":3475,\"text\":3476},\"44e45f552a45\",[3431],\"awarded\",{\"_key\":3478,\"_type\":1604,\"marks\":3479,\"text\":3480},\"2d2a6b363970\",[],\" \",{\"_key\":3482,\"_type\":1604,\"marks\":3483,\"text\":3484},\"ac5b7d92a7a3\",[3431],\"Best Cinematography at iF3.\",[],{\"_key\":3487,\"_type\":1600,\"children\":3488,\"markDefs\":3493,\"style\":3434},\"c038a092d2d8\",[3489],{\"_key\":3490,\"_type\":1604,\"marks\":3491,\"text\":3492},\"18e4fb8128b7\",[3431],\"“A DERAILED HUMAN DREAM”\",[],{\"_key\":3495,\"_type\":1600,\"children\":3496,\"markDefs\":3509,\"style\":1608},\"061fb4b6ffa7\",[3497,3501,3505],{\"_key\":3498,\"_type\":1604,\"marks\":3499,\"text\":3500},\"cc0eb9a87de6\",[],\"Professional skier and Norrøna ambassador \",{\"_key\":3502,\"_type\":1604,\"marks\":3503,\"text\":3504},\"fdb888be3f67\",[3431],\"Fien van Zwieten\",{\"_key\":3506,\"_type\":1604,\"marks\":3507,\"text\":3508},\"fbce954c5425\",[],\" has become one of the most original voices in modern freeskiing.\",[],{\"_key\":3511,\"_type\":1600,\"children\":3512,\"markDefs\":3517,\"style\":1608},\"bdb9bb67c14e\",[3513],{\"_key\":3514,\"_type\":1604,\"marks\":3515,\"text\":3516},\"0dfb942623df\",[],\"In this deeply personal film, she combines breathtaking skiing with an honest exploration of what it's like to live – and ski – with ADHD.\",[],{\"_key\":3519,\"_type\":1600,\"children\":3520,\"markDefs\":3525,\"style\":1608},\"1e938ab25c13\",[3521],{\"_key\":3522,\"_type\":1604,\"marks\":3523,\"text\":3524},\"e09fba565aa8\",[],\"Raw, emotional, creative, and beautifully filmed, this is far more than a ski movie. It's a story about seeing the world differently – and turning that difference into your greatest strength.\",[],{\"_key\":3527,\"_type\":1600,\"children\":3528,\"markDefs\":3533,\"style\":3434},\"7beba3aeb1e3\",[3529],{\"_key\":3530,\"_type\":1604,\"marks\":3531,\"text\":3532},\"a42eb6559ac6\",[3431],\"“The Maiden Voyage”\",[],{\"_key\":3535,\"_type\":1600,\"children\":3536,\"markDefs\":3541,\"style\":1608},\"94673c60a0c3\",[3537],{\"_key\":3538,\"_type\":1604,\"marks\":3539,\"text\":3540},\"9265b70e4edc\",[],\"What happens when you combine a beautifully restored expedition sailing yacht with a team of elite skiers and snowboarders, the Arctic Ocean, and a collection of remote Norwegian islands few people have ever explored in winter?\",[],{\"_key\":3543,\"_type\":1600,\"children\":3544,\"markDefs\":3557,\"style\":1608},\"b59e1ed47c59\",[3545,3549,3553],{\"_key\":3546,\"_type\":1604,\"marks\":3547,\"text\":3548},\"7dd1d1e2509d\",[],\"You get \",{\"_key\":3550,\"_type\":1604,\"marks\":3551,\"text\":3552},\"dcb2c007b3e7\",[3431],\"VARG\",{\"_key\":3554,\"_type\":1604,\"marks\":3555,\"text\":3556},\"003e97ada3fe\",[],\".\",[],{\"_key\":3559,\"_type\":1600,\"children\":3560,\"markDefs\":3565,\"style\":1608},\"c018f203ed46\",[3561],{\"_key\":3562,\"_type\":1604,\"marks\":3563,\"text\":3564},\"e5c5a35c54b3\",[],\"In February 2026, Norrøna's expedition yacht carried its first winter expedition into the far north, unlocking spectacular terrain that simply can't be reached any other way.\",[],{\"_key\":3567,\"_type\":1600,\"children\":3568,\"markDefs\":3573,\"style\":1608},\"418ac4ae6f18\",[3569],{\"_key\":3570,\"_type\":1604,\"marks\":3571,\"text\":3572},\"9bea28070460\",[3431],\"This adventure isn't just something you can watch. It's something you can experience yourself.\",[],{\"_key\":3575,\"_type\":1600,\"children\":3576,\"markDefs\":3581,\"style\":1608},\"904d6f2c7f18\",[3577],{\"_key\":3578,\"_type\":1604,\"marks\":3579,\"text\":3580},\"c1b8160c9206\",[],\"Throughout the evening you'll also enjoy:\",[],{\"_key\":3583,\"_type\":1600,\"children\":3584,\"level\":1318,\"listItem\":2868,\"markDefs\":3598,\"style\":1608},\"64607dddd10d\",[3585,3589,3594],{\"_key\":3586,\"_type\":1604,\"marks\":3587,\"text\":3588},\"18fc4c5605c6\",[3431],\"Live conversations with the filmmakers and athletes, hosted by \",{\"_key\":3590,\"_type\":1604,\"marks\":3591,\"text\":3593},\"eee3efc159ca\",[3592,3431],\"em\",\"Norrøna Magazine\",{\"_key\":3595,\"_type\":1604,\"marks\":3596,\"text\":3597},\"795d18feff54\",[3431],\" editor Eivind Eidslott.\",[],{\"_key\":3600,\"_type\":1600,\"children\":3601,\"level\":1318,\"listItem\":2868,\"markDefs\":3606,\"style\":1608},\"b0e2dc74895c\",[3602],{\"_key\":3603,\"_type\":1604,\"marks\":3604,\"text\":3605},\"d04c8bc6cdc9\",[],\"Drinks, snacks, and the chance to meet fellow skiers, snowboarders, filmmakers, ambassadors, and mountain people from across the Norrøna community.\",[],{\"_key\":3608,\"_type\":1600,\"children\":3609,\"markDefs\":3614,\"style\":1608},\"51411034fe14\",[3610],{\"_key\":3611,\"_type\":1604,\"marks\":3612,\"text\":3613},\"154e8bc6a623\",[],\"Welcome to an unforgettable night – and to what we hope will be the greatest winter yet. We can't wait to celebrate with you!\",[],{\"_key\":3616,\"_type\":1600,\"children\":3617,\"markDefs\":3622,\"style\":1608},\"3248e39be850\",[3618],{\"_key\":3619,\"_type\":1604,\"marks\":3620,\"text\":3621},\"bf94aacc3262\",[3431],\"Practical info\",[],{\"_key\":3624,\"_type\":1600,\"children\":3625,\"level\":1318,\"listItem\":2868,\"markDefs\":3630,\"style\":1608},\"b82ad4a7e765\",[3626],{\"_key\":3627,\"_type\":1604,\"marks\":3628,\"text\":3629},\"cb327fe225c0\",[],\"When: 2nd of December at 19:30\",[],{\"_key\":3632,\"_type\":1600,\"children\":3633,\"level\":1318,\"listItem\":2868,\"markDefs\":3638,\"style\":1608},\"c779ad594e7a\",[3634],{\"_key\":3635,\"_type\":1604,\"marks\":3636,\"text\":3637},\"93ed2a0d673e\",[],\"Where: Norrøna London, 15 Regent Street, London\",[],{\"_key\":3640,\"_type\":1600,\"children\":3641,\"markDefs\":3646,\"style\":1608},\"150f9943a7b1\",[3642],{\"_key\":3643,\"_type\":1604,\"marks\":3644,\"text\":3645},\"976222fbcbaa\",[],\"Some snacks and drinks will be served.\",[],{\"_key\":3648,\"_type\":3649,\"image\":3650},\"0a94379fa5be\",\"contentImage\",{\"_type\":2932,\"mediaItems\":3651},[3652],{\"_key\":3653,\"_type\":1539,\"altText\":3654,\"center\":3655,\"height\":3670,\"id\":3653,\"name\":3671,\"pathCdn\":3672,\"type\":1565,\"width\":3673},\"1cbdGJDaOdESxm5ZjDvSJz8OBKX2hAc3S-f34c9286e2dd6bc995efd63621f17403.jpg\",\"Presenters in Norrøna clothing stand by a screen showing 'ADHD' before a seated audience in a dark venue.\",[3656,3661,3666],{\"_key\":3657,\"_type\":2942,\"aspectRatio\":1318,\"bottomRightX\":3658,\"bottomRightY\":1546,\"fileId\":3653,\"id\":3659,\"isManual\":26,\"topLeftX\":3660,\"topLeftY\":1531},\"220943\",0.9,220943,0.0992,{\"_key\":3662,\"_type\":2942,\"aspectRatio\":1330,\"bottomRightX\":1559,\"bottomRightY\":3663,\"fileId\":3653,\"id\":3664,\"isManual\":26,\"topLeftX\":1531,\"topLeftY\":3665},\"220944\",0.8125,220944,0.1875,{\"_key\":3667,\"_type\":2942,\"aspectRatio\":1556,\"bottomRightX\":3668,\"bottomRightY\":1546,\"fileId\":3653,\"id\":3669,\"isManual\":26,\"topLeftX\":1661,\"topLeftY\":1531},\"220945\",0.65,220