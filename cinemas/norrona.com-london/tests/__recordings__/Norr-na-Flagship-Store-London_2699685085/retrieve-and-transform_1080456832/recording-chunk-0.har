,\"Drinks curated by world-renowned Norwegian cocktail bar HIMKOK\",[],{\"_key\":2203,\"_type\":1926,\"children\":2204,\"level\":34,\"listItem\":2176,\"markDefs\":2209,\"style\":1934},\"5668036f3578\",[2205],{\"_key\":2206,\"_type\":1930,\"marks\":2207,\"text\":2208},\"30776ed3134f\",[],\"Canapés\",[],{\"_key\":2211,\"_type\":1926,\"children\":2212,\"level\":34,\"listItem\":2176,\"markDefs\":2217,\"style\":1934},\"6ce5da4d53a0\",[2213],{\"_key\":2214,\"_type\":1930,\"marks\":2215,\"text\":2216},\"126712882167\",[],\"DJ set by Jojo Deevoy\",[],{\"_key\":2219,\"_type\":1926,\"children\":2220,\"level\":34,\"listItem\":2176,\"markDefs\":2225,\"style\":1934},\"f6978c4e5b32\",[2221],{\"_key\":2222,\"_type\":1930,\"marks\":2223,\"text\":2224},\"6df7555f7fed\",[],\"Interactive workshop with Lewis Smart\",[],{\"_key\":2227,\"_type\":1926,\"children\":2228,\"level\":34,\"listItem\":2176,\"markDefs\":2233,\"style\":1934},\"70310b164b0f\",[2229],{\"_key\":2230,\"_type\":1930,\"marks\":2231,\"text\":2232},\"ee0e95ae49b4\",[],\"Prize raffle\",[],{\"_key\":2235,\"_type\":1926,\"children\":2236,\"markDefs\":2245,\"style\":1934},\"1eaf8219571f\",[2237,2241],{\"_key\":2238,\"_type\":1930,\"marks\":2239,\"text\":2240},\"33389ff33512\",[2135],\"What is your all time favorite Norrøna product and why?\",{\"_key\":2242,\"_type\":1930,\"marks\":2243,\"text\":2244},\"ef161d48bbd0\",[],\"\\nYou can answer in one sentence or with a novel. As long as the love for your favorite product is loud and clear.\",[],{\"_key\":2247,\"_type\":1926,\"children\":2248,\"markDefs\":2253,\"style\":1934},\"81d589b981d1\",[2249],{\"_key\":2250,\"_type\":1930,\"marks\":2251,\"text\":2252},\"60ca135a8a45\",[2135],\"Opening hours:\",[],{\"_key\":2255,\"_type\":1926,\"children\":2256,\"level\":34,\"listItem\":2176,\"markDefs\":2261,\"style\":1934},\"6809d99405f3\",[2257],{\"_key\":2258,\"_type\":1930,\"marks\":2259,\"text\":2260},\"32b67286ead0\",[],\"When: Thursday, November 19th\",[],{\"_key\":2263,\"_type\":1926,\"children\":2264,\"level\":34,\"listItem\":2176,\"markDefs\":2268,\"style\":1934},\"9f76eba2ef62\",[2265],{\"_key\":2258,\"_type\":1930,\"marks\":2266,\"text\":2267},[],\"Doors opening: 18:00\",[],{\"_key\":2270,\"_type\":1926,\"children\":2271,\"level\":34,\"listItem\":2176,\"markDefs\":2276,\"style\":1934},\"b46e2aab54cc\",[2272],{\"_key\":2273,\"_type\":1930,\"marks\":2274,\"text\":2275},\"50dfdeb9ab7b\",[],\"Where: 15 Regent Street, London\",[],{\"_key\":2278,\"_type\":1926,\"children\":2279,\"markDefs\":2284,\"style\":1934},\"3262f9a9be13\",[2280],{\"_key\":2281,\"_type\":1930,\"marks\":2282,\"text\":2283},\"2977202b8377\",[],\"We would be thrilled to celebrate this global event with you!\",[],{\"_key\":2286,\"_type\":1926,\"children\":2287,\"markDefs\":2293,\"style\":1934},\"cbe8de343589\",[2288],{\"_key\":2289,\"_type\":1930,\"marks\":2290,\"text\":2292},\"c41ab0979ddc\",[2291],\"em\",\"Winners will be contacted on the 12th of November by email. \",[],{\"_key\":2295,\"_type\":2296,\"displayStyle\":2297,\"image\":2298},\"ede0c50c0661\",\"contentImage\",\"carousel\",{\"_type\":1821,\"mediaItems\":2299},[2300,2325],{\"_key\":2301,\"_type\":1721,\"altText\":2302,\"center\":2305,\"height\":2321,\"id\":2301,\"name\":2322,\"pathCdn\":2323,\"type\":1748,\"width\":2324},\"042ccdd3ece6fc41939ce89385687f51.jpg\",[2303],{\"_key\":1874,\"_type\":1897,\"language\":1874,\"value\":2304},\"A man speaking into a microphone in a Norrøna store, surrounded by other people.  A red Norrøna jacket hangs on a rack in the background. \\n\",[2306,2311,2316],{\"_key\":2307,\"_type\":1829,\"aspectRatio\":1739,\"bottomRightX\":2308,\"bottomRightY\":1742,\"fileId\":2301,\"id\":2309,\"isManual\":84,\"topLeftX\":2310,\"topLeftY\":1727},\"45867\",0.9002,45867,0.1491,{\"_key\":2312,\"_type\":1829,\"aspectRatio\":34,\"bottomRightX\":2066,\"bottomRightY\":2313,\"fileId\":2301,\"id\":2314,\"isManual\":84,\"topLeftX\":1727,\"topLeftY\":2315},\"45869\",0.8328,45869,0.1672,{\"_key\":2317,\"_type\