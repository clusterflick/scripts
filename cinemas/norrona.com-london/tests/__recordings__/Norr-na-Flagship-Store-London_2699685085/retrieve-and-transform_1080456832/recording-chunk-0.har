center/b_rgb:fcfcfc/c_pad,f_auto,d_imgmissing.jpg,fl_progressive.lossy,q_auto,w_4666,h_4666/Auto%2FSki26_Japan_tuckerscreative_2-3-57.jpg\" srcset=\"https://res.cloudinary.com/norrona/image/upload/x_2333,y_3033,w_4666,h_4666,c_crop,g_xy_center/b_rgb:fcfcfc/c_pad,f_auto,d_imgmissing.jpg,fl_progressive.lossy,q_auto,w_220,h_220/Auto%2FSki26_Japan_tuckerscreative_2-3-57.jpg 220w,https://res.cloudinary.com/norrona/image/upload/x_2333,y_3033,w_4666,h_4666,c_crop,g_xy_center/b_rgb:fcfcfc/c_pad,f_auto,d_imgmissing.jpg,fl_progressive.lossy,q_auto,w_275,h_275/Auto%2FSki26_Japan_tuckerscreative_2-3-57.jpg 275w\" sizes=\"80px\" width=\"4666\" height=\"4666\" alt=\"Smiling skier wearing a Norrøna jacket and goggles holds a snack in the snow.\" style=\"aspect-ratio:var(--media-ratio, 1);\" decoding=\"async\"></picture><!----></figure></div></div><div><p class=\"font-responsive-small -small-caps\">Featured Host</p><p class=\"person-teaser-name font-responsive-body\">Maggie Voisin</p><p class=\"font-responsive-small m-t-6\">Skier</p></div></div></a><!----><!----></section><section class=\"person-teaser font-responsive-body m-b-18 -large -linkable -details-only person-featured-body\"><!----><div class=\"person-teaser-bio font-responsive-small\"><p class=\"-clamped\">Maggie Voisin is a professional freeskier who&#39;s a multiple X Games medalist and Olympian. By 15 years old, she became the youngest American to qualify for a Winter Olympics since 1972.</p></div><div class=\"person-teaser-details font-responsive-small\"><!----><!--[--><!----><div class=\"person-teaser-footer d-flex justify-content-between align-items-center\"><!----><a href=\"/gb/en/ambassador/maggie-voisin\" class=\"-underline -clickable\">Show full profile</a></div><!--]--></div></section></div><div class=\"person-featured-card font-responsive-body\"><hr class=\"person-featured-rule\"><section class=\"person-teaser font-responsive-body m-b-18 -linkable person-featured-summary\"><a href=\"/gb/en/ambassador/teal-harle\" class=\"-black\"><div class=\"d-flex flex-gap\"><div class=\"person-teaser-avatar m-b-12\"><div class=\"media-wrapper\" style=\"--media-ratio-sm:1;\"><figure><picture><!--[--><!--]--><img loading=\"lazy\" loading=\"lazy\" class=\"base-image base-image-lazy\" src=\"https://res.cloudinary.com/norrona/image/upload/x_2332,y_2333,w_4666,h_4666,c_crop,g_xy_center/b_rgb:fcfcfc/c_pad,f_auto,d_imgmissing.jpg,fl_progressive.lossy,q_auto,w_4666,h_4666/Auto%2FSki26_Japan_tuckerscreative_2-3-36.jpg\" srcset=\"https://res.cloudinary.com/norrona/image/upload/x_2332,y_2333,w_4666,h_4666,c_crop,g_xy_center/b_rgb:fcfcfc/c_pad,f_auto,d_imgmissing.jpg,fl_progressive.lossy,q_auto,w_220,h_220/Auto%2FSki26_Japan_tuckerscreative_2-3-36.jpg 220w,https://res.cloudinary.com/norrona/image/upload/x_2332,y_2333,w_4666,h_4666,c_crop,g_xy_center/b_rgb:fcfcfc/c_pad,f_auto,d_imgmissing.jpg,fl_progressive.lossy,q_auto,w_275,h_275/Auto%2FSki26_Japan_tuckerscreative_2-3-36.jpg 275w\" sizes=\"80px\" width=\"4666\" height=\"4666\" alt=\"Skier wearing a beige Norrøna jacket, helmet, and red goggles, holding ski poles.\" style=\"aspect-ratio:var(--media-ratio, 1);\" decoding=\"async\"></picture><!----></figure></div></div><div><p class=\"font-responsive-small -small-caps\">Featured Host</p><p class=\"person-teaser-name font-responsive-body\">Teal Harle</p><p class=\"font-responsive-small m-t-6\">Skier</p></div></div></a><!----><!----></section><section class=\"person-teaser font-responsive-body m-b-18 -large -linkable -details-only person-featured-body\"><!----><div class=\"person-teaser-bio font-responsive-small\"><p class=\"-clamped\">Teal Harle is a professional Canadian freestyle skier raised in Campbell River, BC. He is now based in Pemberton, where he is known for a creative and technical style in big-mountain freeriding and backcountry exploration.\n\n</p></div><div class=\"person-teaser-details font-responsive-small\"><!----><!--[--><!----><div class=\"person-teaser-footer d-flex justify-content-between align-items-center\"><!----><a href=\"/gb/en/ambassador/teal-harle\" class=\"-underline -clickable\">Show full profile</a></div><!--]--></div></section></div><!--]--></div><!--]--></div></div></section></section><!--]--></section><section class=\"g-12 g-md-7-6\"><section class=\"m-b-36\" data-sanity=\"id=b8cd36c0-3fc1-5f7e-9c71-c3d6d2a51acd;type=eventPage;path=leadText:en.value;base=%2F\"><div class=\"article-lead-text g-12 font-responsive-large -strong\"><!--[--><p>Join us for a screening of TGR’s 31st annual ski film, Actually, It Is Rocket Science at the Norrøna London store</p><!--]--></div></section><section class=\"content-area\"><div data-sanity=\"id=b8cd36c0-3fc1-5f7e-9c71-c3d6d2a51acd;type=eventPage;path=portableText:en.value;base=%2F\"><section class=\"content-area\" style=\"color:inherit;background-color:transparent;\"><div class=\"content-area-portable-text\"><!--[--><section class=\"\" data-sanity=\"id=b8cd36c0-3fc1-5f7e-9c71-c3d6d2a51acd;type=eventPage;path=portableText:en.value:9f01991ade67;base=%2F\"><p class=\"g-12 m-b-18\"><strong>About</strong></p></section><section class=\"\" data-sanity=\"id=b8cd36c0-3fc1-5f7e-9c71-c3d6d2a51acd;type=eventPage;path=portableText:en.value:b76fea5faa50;base=%2F\"><p class=\"g-12 m-b-18\">Teton Gravity Research (TGR) is one of the leading action sports filmmakers, capturing the worlds most iconic ski and snowboard moments. Now they are introducing their 31st annual film,<em> &quot;<a href=\"https://www.tetongravity.com/actually-it-is-rocket-science-tgr-film/\"><strong>Actually, It Is Rocket Science</strong></a>&quot;.</em></p></section><section class=\"\" data-sanity=\"id=b8cd36c0-3fc1-5f7e-9c71-c3d6d2a51acd;type=eventPage;path=portableText:en.value:91921e345efa;base=%2F\"><p class=\"g-12 m-b-18\">This year, TGR takes a literal approach to the science of skiing, following some of the world’s best skiers as they push the limits of speed, precision, creativity, and commitment across some of the most consequential terrain on the planet.</p></section><section class=\"\" data-sanity=\"id=b8cd36c0-3fc1-5f7e-9c71-c3d6d2a51acd;type=eventPage;path=portableText:en.value:19634d075d1d;base=%2F\"><p class=\"g-12 m-b-18\">We’re excited to see two of our Norrøna ambassadors, <a href=\"https://www.norrona.com/en-GB/about-norrona/our-ambassadors/teal-harle/\"><strong>Teal Harle </strong></a>and<a href=\"https://www.norrona.com/en-GB/about-norrona/our-ambassadors/maggie-voisin/\"><strong> Maggie Voisin</strong></a>, featured in the film.</p></section><section class=\"\" data-sanity=\"id=b8cd36c0-3fc1-5f7e-9c71-c3d6d2a51acd;type=eventPage;path=portableText:en.value:4c2cca266fb4;base=%2F\"><p class=\"g-12 m-b-18\">This is a film you truly don’t want to miss!</p></section><section class=\"\" data-sanity=\"id=b8cd36c0-3fc1-5f7e-9c71-c3d6d2a51acd;type=eventPage;path=portableText:en.value:553e347e3bac;base=%2F\"><p class=\"g-12 m-b-18\"><strong>After the film, </strong>stick around for <strong>drinks, snacks, </strong>and a chance to hang out with fellow skiers, snowboarders, and mountain people from across the Norrøna community.</p></section><section class=\"\" data-sanity=\"id=b8cd36c0-3fc1-5f7e-9c71-c3d6d2a51acd;type=eventPage;path=portableText:en.value:4b9debe49ca7;base=%2F\"><p class=\"g-12 m-b-18\"><strong>Practical info</strong></p></section><section class=\"\" data-sanity=\"id=b8cd36c0-3fc1-5f7e-9c71-c3d6d2a51acd;type=eventPage;path=portableText:en.value:b82ad4a7e765-parent;base=%2F\"><ul class=\"g-12 m-b-18 custom-ul\"><li class=\"list-bullet\" data-sanity=\"id=b8cd36c0-3fc1-5f7e-9c71-c3d6d2a51acd;type=eventPage;path=portableText:en.value:b82ad4a7e765;base=%2F\">When: 10th of December at 19:00</li><li class=\"list-bullet\" data-sanity=\"id=b8cd36c0-3fc1-5f7e-9c71-c3d6d2a51acd;type=eventPage;path=portableText:en.value:c779ad594e7a;base=%2F\">Where: Norrøna London</li><li class=\"list-bullet\" data-sanity=\"id=b8cd36c0-3fc1-5f7e-9c71-c3d6d2a51acd;type=eventPage;path=portableText:en.value:2f13b1732edc;base=%2F\">15 Regent Street, London</li></ul></section><section class=\"portable-text-image -carousel\" style=\"\" color=\"inherit\" data-sanity=\"id=b8cd36c0-3fc1-5f7e-9c71-c3d6d2a51acd;type=eventPage;path=portableText:en.value:61b08b2956a7;base=%2F\"><div class=\"m-b-18 m-b-md-36 -carousel\"><div class=\"\"><figure class=\"portable-text-image-carousel\"><div class=\"media-viewer\"><div class=\"media-navigation -solid\" style=\"\"><div class=\"media-navigation-hitarea -left\"></div><button class=\"media-navigation-icon -left\" tabindex=\"-1\" aria-hidden=\"true\"><svg width=\"16px\" height=\"16px\" viewbox=\"0 0 16 16\" version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" class=\"icon-chevron\" style=\"width:16px;min-width:16px;height:16px;\"><g id=\"icons/chevron/left-light\" stroke=\"none\" stroke-width=\"1\" fill=\"none\" fill-rule=\"evenodd\"><polygon id=\"bg\" points=\"0 0 16 0 16 16 0 16\"></polygon><g id=\"icons/chevron/down-light\" transform=\"translate(8.000000, 8.000000) rotate(90.000000) translate(-8.000000, -8.000000) \"><polygon id=\"bg\" points=\"0 0 16 0 16 16 0 16\"></polygon><polygon id=\"Stroke-2\" fill=\"currentColor\" fill-rule=\"evenodd\" points=\"14.7627063 3.76313355 15.8232937 4.82386645 8 12.6460875 0.176706277 4.82386645 1.23729372 3.76313355 8 10.5249125\"></polygon></g></g></svg></button><div class=\"media-navigation-hitarea -right\"></div><button class=\"media-navigation-icon -right\" tabindex=\"-1\" aria-hidden=\"true\"><svg width=\"16px\" height=\"16px\" viewbox=\"0 0 16 16\" version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" class=\"icon-chevron\" style=\"width:16px;min-width:16px;height:16px;\"><g id=\"icons/chevron/right-light\" stroke=\"none\" stroke-width=\"1\" fill=\"none\" fill-rule=\"evenodd\"><polygon id=\"bg\" points=\"0 0 16 0 16 16 0 16\"></polygon><g id=\"icons/chevron/down-light\" transform=\"translate(8.000000, 8.