53,2757,2760],{\"_key\":2754,\"_type\":1829,\"aspectRatio\":34,\"bottomRightX\":2755,\"bottomRightY\":2066,\"fileId\":2748,\"id\":2756,\"isManual\":84,\"topLeftX\":1727,\"topLeftY\":1727},\"207345\",0.6656,207345,{\"_key\":2758,\"_type\":1829,\"aspectRatio\":46,\"bottomRightX\":1742,\"bottomRightY\":2710,\"fileId\":2748,\"id\":2759,\"isManual\":84,\"topLeftX\":1727,\"topLeftY\":2712},\"207346\",207346,{\"_key\":2761,\"_type\":1829,\"aspectRatio\":1739,\"bottomRightX\":2762,\"bottomRightY\":2066,\"fileId\":2748,\"id\":2763,\"isManual\":84,\"topLeftX\":2075,\"topLeftY\":1727},\"207347\",0.5328,207347,4773,\"FW2627-lofoten-Andørja-Winter-@ChrisHolter-_DSC0351.jpg\",\"Auto\\u002FFW2627-lofoten-Andørja-Winter-@ChrisHolter-_DSC0351\",[2768,2773],{\"_key\":2769,\"color\":2770,\"concept\":9,\"gender\":2101,\"model\":2771,\"name\":2772,\"score\":1727},\"1006-25-6625-0\",\"6625\",\"1006-25\",\"Gore-Tex Pro Jacket\",{\"_key\":2774,\"color\":2775,\"concept\":9,\"gender\":2101,\"model\":2776,\"name\":2777,\"score\":1727},\"1007-25-6655-1\",\"6655\",\"1007-25\",\"Gore-Tex Pro Pants\",7160,{\"_key\":2377,\"_type\":2378,\"reference\":2780},{\"_ref\":2380,\"_type\":1657},[],{\"_type\":1996,\"metaDescriptionInternationalized\":2783,\"metaTitleInternationalized\":2787},[2784],{\"_key\":2785,\"_type\":1897,\"language\":1874,\"value\":2786},\"f75cfd749b3afdd4a3f3bf36149fdb10\",\"Discover Your Next Great Adventure in the North of Norway\",[2788],{\"_key\":2789,\"_type\":1897,\"language\":1874,\"value\":2790},\"7e340062eeeb975236a7f858aaa8a19f\",\"The Ultimate Adventure Evening at Norrøna London\",{\"_type\":1845,\"current\":2792},\"the-ultimate-adventure-evening-london-2026-11-25\",[],\"The Ultimate Adventure Evening\",{\"_createdAt\":2035,\"_id\":2796,\"_rev\":2037,\"_system\":2797,\"_type\":2041,\"_updatedAt\":2400,\"activityId\":1136,\"activityTags\":2800,\"attending\":2802,\"collectionTags\":2803,\"contentCategory\":2806,\"date\":2808,\"difficultyLevel\":1727,\"end\":2809,\"eventType\":1055,\"featuredMedia\":2810,\"id\":2834,\"invitationOnly\":84,\"isActive\":66,\"isApproximateDate\":84,\"languageId\":2106,\"leadText\":2835,\"location\":83,\"locationCity\":83,\"locationCountry\":83,\"locationGooglePlaceId\":83,\"locationLatitude\":83,\"locationLine1\":83,\"locationLine2\":83,\"locationLongitude\":83,\"locationPostalCode\":83,\"locationStateCode\":83,\"minimumAge\":83,\"persons\":2847,\"portableText\":2854,\"restrictions\":3116,\"seo\":3117,\"slug\":3126,\"start\":2808,\"status\":1727,\"storeExternalId\":1747,\"storeName\":1849,\"subTitle\":1849,\"tags\":3128,\"title\":3129,\"waiting\":1727},\"e3dbd002-8f61-525f-a433-242787ad7459\",{\"base\":2798},{\"id\":2796,\"rev\":2799},\"Wr5Xi1j8wZ7RtN8poHNRBf\",[2801],{\"_key\":1136,\"_type\":2045,\"label\":414,\"value\":1136},38,[2804,2805],{\"_key\":9,\"_type\":2045,\"label\":9,\"value\":9},{\"_key\":12,\"_type\":2045,\"label\":12,\"value\":12},{\"_createdAt\":2049,\"_id\":2050,\"_rev\":2051,\"_type\":2052,\"_updatedAt\":2053,\"title\":2054,\"value\":2807},{\"_type\":1845,\"current\":1042},\"2026-12-02T19:00:00\",\"2026-12-02T21:00:00\",{\"_key\":2811,\"_type\":1721,\"altText\":2812,\"center\":2813,\"height\":2829,\"id\":2811,\"name\":2830,\"pathCdn\":2831,\"products\":2832,\"width\":2833},\"1y7Qh5eWYVGMBRibee6jFyBvjaFqlCCJn-76dd50358c206d6948bf36172d2ec86c.jpg\",\"Norrøna Freeride Film Tour 2026 poster showing a skier in Norrøna gear carving down a snowy slope.\",[2814,2820,2825],{\"t\":2815},[2816,34,2817,1727,2818,2819],216203,0.05,0.6125,0.9986,{\"t\":2821},[2822,46,1727,2823,1742,2824],216204,0.0542,0.9444,{\"t\":2826},[2827,1739,2707,1727,2828,2819],216205,0.4312,1080,\"01 FilmTourPoster_2.jpg\",\"Auto\\u002F01 FilmTourPoster_2\",[],1920,\"d63c5196-fea2-4be1-8bfd-861a1e27add7\",[2836],{\"_key\":2837,\"_type\":2110,\"language\":1874,\"value\":2838},\"0260a8b35ce0c399813cbd9473d4a383\",[2839],{\"_key\":2840,\"_type\":1926,\"children\":2841,\"markDefs\":2846,\"style\":1934},\"6bead55e1e15\",[2842],{\"_key\":2843,\"_type\":1930,\"marks\":2844,\"text\":2845},\"cea217ad3921\",[],\"Join us at the Norrøna London store as we launch the 2026\\u002F27 winter season with three remarkable films.\",[],[2848,2851],{\"_key\":2849,\"_ref\":2850,\"_type\":1657},\"a1a6b8fe4761\",\"11226199-f566-40b2-8722-b4f9434d0e70\",{\"_key\":2852,\"_ref\":2853,\"_type\":1657},\"9969c67d0688\",\"bc4c41bb-edd3-44f3-8601-56f249253468\",[2855],{\"_key\":2856,\"_type\":2127,\"language\":1874,\"value\":2857},\"9ee1a078d2e7315e6c9f9f9a3f51f214\",[2858,2866,2874,2882,2898,2906,2926,2934,2950,2958,2966,2974,2982,2997,3005,3013,3021,3037,3045,3053,3061,3069,3077,3085,3114],{\"_key\":2859,\"_type\":1926,\"children\":2860,\"markDefs\":2865,\"style\":1934},\"07227cb52784\",[2861],{\"_key\":2862,\"_type\":1930,\"marks\":2863,\"text\":2864},\"26e1683c2627\",[],\"Together, we'll premiere three remarkable Norwegian ski films that remind us why we keep chasing winter, year after year. An evening dedicated to deep powder, towering mountains, unforgettable stories, and the people who live for winter.\",[],{\"_key\":2867,\"_type\":1926,\"children\":2868,\"markDefs\":2873,\"style\":2463},\"12896221eead\",[2869],{\"_key\":2870,\"_type\":1930,\"marks\":2871,\"text\":2872},\"89042a302840\",[2135],\"“Ferryland”\",[],{\"_key\":2875,\"_type\":1926,\"children\":2876,\"markDefs\":2881,\"style\":1934},\"08348f27a967\",[2877],{\"_key\":2878,\"_type\":1930,\"marks\":2879,\"text\":2880},\"6568ce414be1\",[],\"Hidden in the middle of Norway's spectacular Hjørundfjord lies a tiny village with no road in or out – only mountains rising straight from the sea.\",[],{\"_key\":2883,\"_type\":1926,\"children\":2884,\"markDefs\":2897,\"style\":1934},\"254742f08c9d\",[2885,2889,2893],{\"_key\":2886,\"_type\":1930,\"marks\":2887,\"text\":2888},\"7875c60d6677\",[],\"Norrøna ambassador and professional snowboarder \",{\"_key\":2890,\"_type\":1930,\"marks\":2891,\"text\":2892},\"00461d6fc503\",[2135],\"Emil Leenderts\",{\"_key\":2894,\"_type\":1930,\"marks\":2895,\"text\":2896},\"4eb3a65a7002\",[],\" gathers a crew of close friends and heads into this extraordinary landscape in search of steep lines, deep snow, and the kind of skiing and snowboarding most people only dream about.\",[],{\"_key\":2899,\"_type\":1926,\"children\":2900,\"markDefs\":2905,\"style\":1934},\"f83d0ea3e39b\",[2901],{\"_key\":2902,\"_type\":1930,\"marks\":2903,\"text\":2904},\"e6994379c6c3\",[],\"This is a celebration of friendship, freedom, and the endless possibilities waiting beyond the map. \",[],{\"_key\":2907,\"_type\":1926,\"children\":2908,\"markDefs\":2925,\"style\":1934},\"d36b44c3f4dd\",[2909,2913,2917,2921],{\"_key\":2910,\"_type\":1930,\"marks\":2911,\"text\":2912},\"af276ed2b3da\",[],\"The film was also \",{\"_key\":2914,\"_type\":1930,\"marks\":2915,\"text\":2916},\"44e45f552a45\",[2135],\"awarded\",{\"_key\":2918,\"_type\":1930,\"marks\":2919,\"text\":2920},\"2d2a6b363970\",[],\" \",{\"_key\":2922,\"_type\":1930,\"marks\":2923,\"text\":2924},\"ac5b7d92a7a3\",[2135],\"Best Cinematography at iF3.\",[],{\"_key\":2927,\"_type\":1926,\"children\":2928,\"markDefs\":2933,\"style\":2463},\"c038a092d2d8\",[2929],{\"_key\":2930,\"_type\":1930,\"marks\":2931,\"text\":2932},\"18e4fb8128b7\",[2135],\"“A DERAILED HUMAN DREAM”\",[],{\"_key\":2935,\"_type\":1926,\"children\":2936,\"markDefs\":2949,\"style\":1934},\"061fb4b6ffa7\",[2937,2941,2945],{\"_key\":2938,\"_type\":1930,\"marks\":2939,\"text\":2940},\"cc0eb9a87de6\",[],\"Professional skier and Norrøna ambassador \",{\"_key\":2942,\"_type\":1930,\"marks\":2943,\"text\":2944},\"fdb888be3f67\",[2135],\"Fien van Zwieten\",{\"_key\":2946,\"_type\":1930,\"marks\":2947,\"text\":2948},\"fbce954c5425\",[],\" has become one of the most original voices in modern freeskiing.\",[],{\"_key\":2951,\"_type\":1926,\"children\":2952,\"markDefs\":2957,\"style\":1934},\"bdb9bb67c14e\",[2953],{\"_key\":2954,\"_type\":1930,\"marks\":2955,\"text\":2956},\"0dfb942623df\",[],\"In this deeply personal film, she combines breathtaking skiing with an honest exploration of what it's like to live – and ski – with ADHD.\",[],{\"_key\":2959,\"_type\":1926,\"children\":2960,\"markDefs\":2965,\"style\":1934},\"1e938ab25c13\",[2961],{\"_key\":2962,\"_type\":1930,\"marks\":2963,\"text\":2964},\"e09fba565aa8\",[],\"Raw, emotional, creative, and beautifully filmed, this is far more than a ski movie. It's a story about seeing the world differently – and turning that difference into your greatest strength.\",[],{\"_key\":2967,\"_type\":1926,\"children\":2968,\"markDefs\":2973,\"style\":2463},\"7beba3aeb1e3\",[2969],{\"_key\":2970,\"_type\":1930,\"marks\":2971,\"text\":2972},\"a42eb6559ac6\",[2135],\"“The Maiden Voyage”\",[],{\"_key\":2975,\"_type\":1926,\"children\":2976,\"markDefs\":2981,\"style\":1934},\"94673c60a0c3\",[2977],{\"_key\":2978,\"_type\":1930,\"marks\":2979,\"text\":2980},\"9265b70e4edc\",[],\"What happens when you combine a beautifully restored expedition sailing yacht with a team of elite skiers and snowboarders, the Arctic Ocean, and a collection of remote Norwegian islands few people have ever explored in winter?\",[],{\"_key\":2983,\"_type\":1926,\"children\":2984,\"markDefs\":2996,\"style\":1934},\"b59e1ed47c59\",[2985,2989,2993],{\"_key\":2986,\"_type\":1930,\"marks\":2987,\"text\":2988},\"7dd1d1e2509d\",[],\"You get \",{\"_key\":2990,\"_type\":1930,\"marks\":2991,\"text\":2992},\"dcb2c007b3e7\",[2135],\"VARG\",{\"_key\":2994,\"_type\":1930,\"marks\":2995,\"text\":2175},\"003e97ada3fe\",[],[],{\"_key\":2998,\"_type\":1926,\"children\":2999,\"markDefs\":3004,\"style\":1934},\"c018f203ed46\",[3000],{\"_key\":3001,\"_type\":1930,\"marks\":3002,\"text\":3003},\"e5c5a35c54b3\",[],\"In February 2026, Norrøna's expedition yacht carried its first winter expedition into the far north, unlocking spectacular terrain that simply can't be reached any other way.\",[],{\"_key\":3006,\"_type\":1926,\"children\":3007,\"markDefs\":3012,\"style\":1934},\"418ac4ae6f18\",[3008],{\"_key\":3009,\"_type\":1930,\"marks\":3010,\"text\":3011},\"9bea28070460\",[2135],\"This adventure isn't just something you can watch. It's something you can experience yourself.\",[],{\"_key\":3014,\"_type\":1926,\"children\":3015,\"markDefs\":3020,\"style\":1934},\"904d6f2c7f18\",[3016],{\"_key\":3017,\"_type\":1930,\"marks\":3018,\"text\":3019},\"c1b8160c9206\",[],\"Throughout the evening you'll also enjoy:\",[],{\"_key\":3022,\"_type\":1926,\"children\":3023,\"level\":34,\"listItem\":2176,\"markDefs\":3036,\"style\":1934},\"64607dddd10d\",[3024,3028,3032],{\"_key\":3025,\"_type\":1930,\"marks\":3026,\"text\":3027},\"18fc4c5605c6\",[2135],\"Live conversations with the filmmakers and athletes, hosted by \",{\"_key\":3029,\"_type\":1930,\"marks\":3030,\"text\":3031},\"eee3efc159ca\",[2291,2135],\"Norrøna Magazine\",{\"_key\":3033,\"_type\":1930,\"marks\":3034,\"text\":3035},\"795d18feff54\",[2135],\" editor Eivind Eidslott.\",[],{\"_key\":3038,\"_type\":1926,\"children\":3039,\"level\":34,\"listItem\":2176,\"markDefs\":3044,\"style\":1934},\"b0e2dc74895c\",[3040],{\"_key\":3041,\"_type\":1930,\"marks\":3042,\"text\":3043},\"d04c8bc6cdc9\",[],\"Drinks, snacks, and the chance to meet fellow skiers, snowboarders, filmmakers, ambassadors, and mountain people from across the Norrøna community.\",[],{\"_key\":3046,\"_type\":1926,\"children\":3047,\"markDefs\":3052,\"style\":1934},\"51411034fe14\",[3048],{\"_key\":3049,\"_type\":1930,\"marks\":3050,\"text\":3051},\"154e8bc6a623\",[],\"Welcome to an unforgettable night – and to what we hope will be the greatest winter yet. We can't wait to celebrate with you!\",[],{\"_key\":3054,\"_type\":1926,\"children\":3055,\"markDefs\":3060,\"style\":1934},\"3248e39be850\",[3056],{\"_key\":3057,\"_type\":1930,\"marks\":3058,\"text\":3059},\"bf94aacc3262\",[2135],\"Practical info\",[],{\"_key\":3062,\"_type\":1926,\"children\":3063,\"level\":34,\"listItem\":2176,\"markDefs\":3068,\"style\":1934},\"b82ad4a7e765\",[3064],{\"_key\":3065,\"_type\":1930,\"marks\":3066,\"text\":3067},\"cb327fe225c0\",[],\"When: 2nd of December at 19:30\",[],{\"_key\":3070,\"_type\":1926,\"children\":3071,\"level\":34,\"listItem\":2176,\"markDefs\":3076,\"style\":1934},\"c779ad594e7a\",[3072],{\"_key\":3073,\"_type\":1930,\"marks\":3074,\"text\":3075},\"93ed2a0d673e\",[],\"Where: Norrøna London, 15 Regent Street, London\",[],{\"_key\":3078,\"_type\":1926,\"children\":3079,\"markDefs\":3084,\"style\":1934},\"150f9943a7b1\",[3080],{\"_key\":3081,\"_type\":1930,\"marks\":3082,\"text\":3083},\"976222fbcbaa\",[],\"Some snacks and drinks will be served.\",[],{\"_key\":3086,\"_type\":2296,\"image\":3087},\"0a94379fa5be\",{\"_type\":1821,\"mediaItems\":3088},[3089],{\"_key\":3090,\"_type\":1721,\"altText\":3091,\"center\":3094,\"height\":3110,\"id\":3090,\"name\":3111,\"pathCdn\":3112,\"type\":1748,\"width\":3113},\"1cbdGJDaOdESxm5ZjDvSJz8OBKX2hAc3S-f34c9286e2dd6bc995efd63621f17403.jpg\",[3092],{\"_key\":1874,\"_type\":1897,\"language\":1874,\"value\":3093},\"Presenters in Norrøna clothing stand by a screen showing 'ADHD' before a seated audience in a dark venue.\",[3095,3100,3105],{\"_key\":3096,\"_type\":1829,\"aspectRatio\":34,\"bottomRightX\":3097,\"bottomRightY\":1729,\"fileId\":3090,\"id\":3098,\"isManual\":84,\"topLeftX\":3099,\"topLeftY\":1727},\"220943\",0.9,220943,0.0992,{\"_key\":3101,\"_type\":1829,\"aspectRatio\":46,\"bottomRightX\":1742,\"bottomRightY\":3102,\"fileId\":3090,\"id\":3103,\"isManual\":84,\"topLeftX\":1727,\"topLeftY\":3104},\"220944\",0.8125,220944,0.1875,{\"_key\":3106,\"_type\":1829,\"aspectRatio\":1739,\"bottomRightX\":3107,\"bottomRightY\":1729,\"fileId\":3090,\"id\":3108,\"isManual\":84,\"topLeftX\":3109,\"topLeftY\":1727},\"220945\",0.65,220945,0.25,3944,\"Film-tour-Munich-adhd.jpg\",\"Auto\\u002FFilm-tour-Munich-adhd\",4930,{\"_key\":2377,\"_type\":2378,\"reference\":3115},{\"_ref\":2380,\"_type\":1657},[],{\"_type\":1996,\"metaDescriptionInternationalized\":3118,\"metaTitleInternatio