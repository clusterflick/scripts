fft\",[],{\"_key\":3068,\"_type\":1586,\"children\":3341,\"level\":1327,\"listItem\":2853,\"markDefs\":3346,\"style\":1594},[3342],{\"_key\":3343,\"_type\":1590,\"marks\":3344,\"text\":3345},\"0366b7fc8811\",[],\"Ein linkes Fass bekommen\",[],{\"_key\":3076,\"_type\":1586,\"children\":3348,\"level\":1327,\"listItem\":2853,\"markDefs\":3353,\"style\":1594},[3349],{\"_key\":3350,\"_type\":1590,\"marks\":3351,\"text\":3352},\"aea1934cf7ec\",[],\"Verstehen, was „Bring deinen Schnorchel mit, Kumpel!“ bedeutet.\",[],{\"src\":28},{\"_type\":2917,\"fetchMode\":2918,\"filterId\":2919,\"filterName\":2919,\"mediaItems\":3356},[3357],{\"_key\":3358,\"_type\":1541,\"altText\":3359,\"center\":3360,\"description\":3372,\"height\":2941,\"id\":3358,\"name\":3373,\"pathCdn\":3374,\"preferredCenter\":3363,\"type\":1524,\"width\":3375},\"1dc671oJu7qlWRqhR6vrkAtvVSQGw7nTs-2c29c4e2dffef64c6ce2fed01aa51640.jpg\",\"A man wearing a Norrøna jacket and sunglasses smiles while standing in a snowy mountain landscape. \\n\",[3361,3364,3368],{\"_key\":3362,\"_type\":2927,\"aspectRatio\":1327,\"bottomRightX\":1549,\"bottomRightY\":1548,\"fileId\":3358,\"id\":3363,\"isManual\":29,\"topLeftX\":1547,\"topLeftY\":1533},\"160141\",160141,{\"_key\":3365,\"_type\":2927,\"aspectRatio\":1339,\"bottomRightX\":1561,\"bottomRightY\":3366,\"fileId\":3358,\"id\":3367,\"isManual\":29,\"topLeftX\":1533,\"topLeftY\":1533},\"160142\",0.6667,160142,{\"_key\":3369,\"_type\":2927,\"aspectRatio\":1558,\"bottomRightX\":3370,\"bottomRightY\":1548,\"fileId\":3358,\"id\":3371,\"isManual\":29,\"topLeftX\":1647,\"topLeftY\":1533},\"160143\",0.625,160143,\"Sverre Hjørnevik, Emil Leenderts\",\"FW2526-femund-norrona_femunden_winter_sjut_sverrehjornevik-4086.jpg\",\"Auto\\u002FFW2526-femund-norrona_femunden_winter_sjut_sverrehjornevik-4086\",7680,\"Volda\",[3378,3380],{\"_key\":3379,\"_type\":1520,\"label\":3379,\"value\":3379},\"Photography\",{\"_key\":3381,\"_type\":1520,\"label\":3381,\"value\":3381},\"Filmmaking\",[3383,3384],{\"_key\":520,\"_type\":1520,\"label\":520,\"value\":520},{\"_key\":2956,\"_type\":1520,\"label\":2956,\"value\":2956},{\"_id\":2969,\"title\":2970,\"value\":3386},{\"_type\":1532,\"current\":2972},{\"_type\":1532,\"current\":3388},\"emil-leenderts\",[3390,3393],{\"_key\":3391,\"_type\":2979,\"platform\":2980,\"url\":3392},\"38e2cd4a4cc5\",\"https:\\u002F\\u002Fwww.instagram.com\\u002Femil.i.lonneberget\",{\"_key\":3394,\"_type\":2979,\"platform\":3395,\"url\":3396},\"aee40073c7e3\",\"youtube\",\"https:\\u002F\\u002Fwww.youtube.com\\u002F@emil.i.lonneberget\",{\"lead\":3398,\"subTitle\":3399},\"Emil Leenderts describes himself as a semi‑professional snowboarder, surfer and filmmaker and spends most of his time in the mountains and in the ocean.\",\"Snowboarder\",\"Emil Leenderts\",[3402,3410,3420,3428,3443,3451,3471,3479,3495,3503,3511,3519,3527,3543,3551,3559,3567,3584,3592,3600,3608,3616,3624,3632,3659,3694],{\"_key\":3403,\"_type\":1586,\"children\":3404,\"markDefs\":3409,\"style\":1594},\"07227cb52784\",[3405],{\"_key\":3406,\"_type\":1590,\"marks\":3407,\"text\":3408},\"26e1683c2627\",[],\"Together, we'll premiere three remarkable Norwegian ski films that remind us why we keep chasing winter, year after year. An evening dedicated to deep powder, towering mountains, unforgettable stories, and the people who live for winter.\",[],{\"_key\":3411,\"_type\":1586,\"children\":3412,\"markDefs\":3418,\"style\":3419},\"12896221eead\",[3413],{\"_key\":3414,\"_type\":1590,\"marks\":3415,\"text\":3417},\"89042a302840\",[3416],\"strong\",\"“Ferryland”\",[],\"h4\",{\"_key\":3421,\"_type\":1586,\"children\":3422,\"markDefs\":3427,\"style\":1594},\"08348f27a967\",[3423],{\"_key\":3424,\"_type\":1590,\"marks\":3425,\"text\":3426},\"6568ce414be1\",[],\"Hidden in the middle of Norway's spectacular Hjørundfjord lies a tiny village with no road in or out – only mountains rising straight from the sea.\",[],{\"_key\":3429,\"_type\":1586,\"children\":3430,\"markDefs\":3442,\"style\":1594},\"254742f08c9d\",[3431,3435,3438],{\"_key\":3432,\"_type\":1590,\"marks\":3433,\"text\":3434},\"7875c60d6677\",[],\"Norrøna ambassador and professional snowboarder \",{\"_key\":3436,\"_type\":1590,\"marks\":3437,\"text\":3400},\"00461d6fc503\",[3416],{\"_key\":3439,\"_type\":1590,\"marks\":3440,\"text\":3441},\"4eb3a65a7002\",[],\" gathers a crew of close friends and heads into this extraordinary landscape in search of steep lines, deep snow, and the kind of skiing and snowboarding most people only dream about.\",[],{\"_key\":3444,\"_type\":1586,\"children\":3445,\"markDefs\":3450,\"style\":1594},\"f83d0ea3e39b\",[3446],{\"_key\":3447,\"_type\":1590,\"marks\":3448,\"text\":3449},\"e6994379c6c3\",[],\"This is a celebration of friendship, freedom, and the endless possibilities waiting beyond the map. \",[],{\"_key\":3452,\"_type\":1586,\"children\":3453,\"markDefs\":3470,\"style\":1594},\"d36b44c3f4dd\",[3454,3458,3462,3466],{\"_key\":3455,\"_type\":1590,\"marks\":3456,\"text\":3457},\"af276ed2b3da\",[],\"The film was also \",{\"_key\":3459,\"_type\":1590,\"marks\":3460,\"text\":3461},\"44e45f552a45\",[3416],\"awarded\",{\"_key\":3463,\"_type\":1590,\"marks\":3464,\"text\":3465},\"2d2a6b363970\",[],\" \",{\"_key\":3467,\"_type\":1590,\"marks\":3468,\"text\":3469},\"ac5b7d92a7a3\",[3416],\"Best Cinematography at iF3.\",[],{\"_key\":3472,\"_type\":1586,\"children\":3473,\"markDefs\":3478,\"style\":3419},\"c038a092d2d8\",[3474],{\"_key\":3475,\"_type\":1590,\"marks\":3476,\"text\":3477},\"18e4fb8128b7\",[3416],\"“A DERAILED HUMAN DREAM”\",[],{\"_key\":3480,\"_type\":1586,\"children\":3481,\"markDefs\":3494,\"style\":1594},\"061fb4b6ffa7\",[3482,3486,3490],{\"_key\":3483,\"_type\":1590,\"marks\":3484,\"text\":3485},\"cc0eb9a87de6\",[],\"Professional skier and Norrøna ambassador \",{\"_key\":3487,\"_type\":1590,\"marks\":3488,\"text\":3489},\"fdb888be3f67\",[3416],\"Fien van Zwieten\",{\"_key\":3491,\"_type\":1590,\"marks\":3492,\"text\":3493},\"fbce954c5425\",[],\" has become one of the most original voices in modern freeskiing.\",[],{\"_key\":3496,\"_type\":1586,\"children\":3497,\"markDefs\":3502,\"style\":1594},\"bdb9bb67c14e\",[3498],{\"_key\":3499,\"_type\":1590,\"marks\":3500,\"text\":3501},\"0dfb942623df\",[],\"In this deeply personal film, she combines breathtaking skiing with an honest exploration of what it's like to live – and ski – with ADHD.\",[],{\"_key\":3504,\"_type\":1586,\"children\":3505,\"markDefs\":3510,\"style\":1594},\"1e938ab25c13\",[3506],{\"_key\":3507,\"_type\":1590,\"marks\":3508,\"text\":3509},\"e09fba565aa8\",[],\"Raw, emotional, creative, and beautifully filmed, this is far more than a ski movie. It's a story about seeing the world differently – and turning that difference into your greatest strength.\",[],{\"_key\":3512,\"_type\":1586,\"children\":3513,\"markDefs\":3518,\"style\":3419},\"7beba3aeb1e3\",[3514],{\"_key\":3515,\"_type\":1590,\"marks\":3516,\"text\":3517},\"a42eb6559ac6\",[3416],\"“The Maiden Voyage”\",[],{\"_key\":3520,\"_type\":1586,\"children\":3521,\"markDefs\":3526,\"style\":1594},\"94673c60a0c3\",[3522],{\"_key\":3523,\"_type\":1590,\"marks\":3524,\"text\":3525},\"9265b70e4edc\",[],\"What happens when you combine a beautifully restored expedition sailing yacht with a team of elite skiers and snowboarders, the Arctic Ocean, and a collection of remote Norwegian islands few people have ever explored in winter?\",[],{\"_key\":3528,\"_type\":1586,\"children\":3529,\"markDefs\":3542,\"style\":1594},\"b59e1ed47c59\",[3530,3534,3538],{\"_key\":3531,\"_type\":1590,\"marks\":3532,\"text\":3533},\"7dd1d1e2509d\",[],\"You get \",{\"_key\":3535,\"_type\":1590,\"marks\":3536,\"text\":3537},\"dcb2c007b3e7\",[3416],\"VARG\",{\"_key\":3539,\"_type\":1590,\"marks\":3540,\"text\":3541},\"003e97ada3fe\",[],\".\",[],{\"_key\":3544,\"_type\":1586,\"children\":3545,\"markDefs\":3550,\"style\":1594},\"c018f203ed46\",[3546],{\"_key\":3547,\"_type\":1590,\"marks\":3548,\"text\":3549},\"e5c5a35c54b3\",[],\"In February 2026, Norrøna's expedition yacht carried its first winter expedition into the far north, unlocking spectacular terrain that simply can't be reached any other way.\",[],{\"_key\":3552,\"_type\":1586,\"children\":3553,\"markDefs\":3558,\"style\":1594},\"418ac4ae6f18\",[3554],{\"_key\":3555,\"_type\":1590,\"marks\":3556,\"text\":3557},\"9bea28070460\",[3416],\"This adventure isn't just something you can watch. It's something you can experience yourself.\",[],{\"_key\":3560,\"_type\":1586,\"children\":3561,\"markDefs\":3566,\"style\":1594},\"904d6f2c7f18\",[3562],{\"_key\":3563,\"_type\":1590,\"marks\":3564,\"text\":3565},\"c1b8160c9206\",[],\"Throughout the evening you'll also enjoy:\",[],{\"_key\":3568,\"_type\":1586,\"children\":3569,\"level\":1327,\"listItem\":2853,\"markDefs\":3583,\"style\":1594},\"64607dddd10d\",[3570,3574,3579],{\"_key\":3571,\"_type\":1590,\"marks\":3572,\"text\":3573},\"18fc4c5605c6\",[3416],\"Live conversations with the filmmakers and athletes, hosted by \",{\"_key\":3575,\"_type\":1590,\"marks\":3576,\"text\":3578},\"eee3efc159ca\",[3577,3416],\"em\",\"Norrøna Magazine\",{\"_key\":3580,\"_type\":1590,\"marks\":3581,\"text\":3582},\"795d18feff54\",[3416],\" editor Eivind Eidslott.\",[],{\"_key\":3585,\"_type\":1586,\"children\":3586,\"level\":1327,\"listItem\":2853,\"markDefs\":3591,\"style\":1594},\"b0e2dc74895c\",[3587],{\"_key\":3588,\"_type\":1590,\"marks\":3589,\"text\":3590},\"d04c8bc6cdc9\",[],\"Drinks, snacks, and the chance to meet fellow skiers, snowboarders, filmmakers, ambassadors, and mountain people from across the Norrøna community.\",[],{\"_key\":3593,\"_type\":1586,\"children\":3594,\"markDefs\":3599,\"style\":1594},\"51411034fe14\",[3595],{\"_key\":3596,\"_type\":1590,\"marks\":3597,\"text\":3598},\"154e8bc6a623\",[],\"Welcome to an unforgettable night – and to what we hope will be the greatest winter yet. We can't wait to celebrate with you!\",[],{\"_key\":3601,\"_type\":1586,\"children\":3602,\"markDefs\":3607,\"style\":1594},\"3248e39be850\",[3603],{\"_key\":3604,\"_type\":1590,\"marks\":3605,\"text\":3606},\"bf94aacc3262\",[3416],\"Practical info\",[],{\"_key\":3609,\"_type\":1586,\"children\":3610,\"level\":1327,\"listItem\":2853,\"markDefs\":3615,\"style\":1594},\"b82ad4a7e765\",[3611],{\"_key\":3612,\"_type\":1590,\"marks\":3613,\"text\":3614},\"cb327fe225c0\",[],\"When: 2nd of December at 19:30\",[],{\"_key\":3617,\"_type\":1586,\"children\":3618,\"level\":1327,\"listItem\":2853,\"markDefs\":3623,\"style\":1594},\"c779ad594e7a\",[3619],{\"_key\":3620,\"_type\":1590,\"marks\":3621,\"text\":3622},\"93ed2a0d673e\",[],\"Where: Norrøna London, 15 Regent Street, London\",[],{\"_key\":3625,\"_type\":1586,\"children\":3626,\"markDefs\":3631,\"style\":1594},\"150f9943a7b1\",[3627],{\"_key\":3628,\"_type\":1590,\"marks\":3629,\"text\":3630},\"976222fbcbaa\",[],\"Some snacks and drinks will be served.\",[],{\"_key\":3633,\"_type\":3634,\"image\":3635},\"0a94379fa5be\",\"contentImage\",{\"_type\":2917,\"mediaItems\":3636},[3637],{\"_key\":3638,\"_type\":1541,\"altText\":3639,\"center\":3640,\"height\":3655,\"id\":3638,\"name\":3656,\"pathCdn\":3657,\"type\":1524,\"width\":3658},\"1cbdGJDaOdESxm5ZjDvSJz8OBKX2hAc3S-f34c9286e2dd6bc995efd63621f17403.jpg\",\"Presenters in Norrøna clothing stand by a screen showing 'ADHD' before a seated audience in a dark venue.\",[3641,3646,3651],{\"_key\":3642,\"_type\":2927,\"aspectRatio\":1327,\"bottomRightX\":3643,\"bottomRightY\":1548,\"fileId\":3638,\"id\":3644,\"isManual\":29,\"topLeftX\":3645,\"topLeftY\":1533},\"220943\",0.9,220943,0.0992,{\"_key\":3647,\"_type\":2927,\"aspectRatio\":1339,\"bottomRightX\":1561,\"bottomRightY\":3648,\"fileId\":3638,\"id\":3649,\"isManual\":29,\"topLeftX\":1533,\"topLeftY\":3650},\"220944\",0.8125,220944,0.1875,{\"_key\":3652,\"_type\":2927,\"aspectRatio\":1558,\"bottomRightX\":3653,\"bottomRightY\":1548,\"fileId\":3638,\"id\":3654,\"isManual\":29,\"topLeftX\":1647,\"topLeftY\":1533},\"220945\",0.65,220