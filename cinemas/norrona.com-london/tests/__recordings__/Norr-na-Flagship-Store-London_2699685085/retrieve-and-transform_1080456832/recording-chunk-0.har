f3c8762b\",[],\", alongside Outdoor Leader \",{\"_key\":3340,\"_type\":1618,\"marks\":3341,\"text\":3342},\"03cfded02779\",[3306],\"Will Renwick\",{\"_key\":3344,\"_type\":1618,\"marks\":3345,\"text\":3346},\"c0aef275c1aa\",[],\".\",[],{\"_key\":3349,\"_type\":1614,\"children\":3350,\"level\":34,\"listItem\":2883,\"markDefs\":3362,\"style\":1622},\"8bf593110d3b\",[3351,3355,3358],{\"_key\":3352,\"_type\":1618,\"marks\":3353,\"text\":3354},\"9bbfa2ab40d4\",[],\"Meet Norrøna ambassador and climbing legend \",{\"_key\":3356,\"_type\":1618,\"marks\":3357,\"text\":3298},\"35322b89717c\",[3306],{\"_key\":3359,\"_type\":1618,\"marks\":3360,\"text\":3361},\"cfe3bcb531f1\",[],\", plus local London Norrøna athletes\",[],{\"_key\":3364,\"_type\":1614,\"children\":3365,\"level\":34,\"listItem\":2883,\"markDefs\":3370,\"style\":1622},\"2d8bf5d116da\",[3366],{\"_key\":3367,\"_type\":1618,\"marks\":3368,\"text\":3369},\"f1a98b4761b2\",[],\"Drinks curated by world-renowned Norwegian cocktail bar HIMKOK\",[],{\"_key\":3372,\"_type\":1614,\"children\":3373,\"level\":34,\"listItem\":2883,\"markDefs\":3378,\"style\":1622},\"5668036f3578\",[3374],{\"_key\":3375,\"_type\":1618,\"marks\":3376,\"text\":3377},\"30776ed3134f\",[],\"Canapés\",[],{\"_key\":3380,\"_type\":1614,\"children\":3381,\"level\":34,\"listItem\":2883,\"markDefs\":3386,\"style\":1622},\"6ce5da4d53a0\",[3382],{\"_key\":3383,\"_type\":1618,\"marks\":3384,\"text\":3385},\"126712882167\",[],\"DJ set by Jojo Deevoy\",[],{\"_key\":3388,\"_type\":1614,\"children\":3389,\"level\":34,\"listItem\":2883,\"markDefs\":3394,\"style\":1622},\"f6978c4e5b32\",[3390],{\"_key\":3391,\"_type\":1618,\"marks\":3392,\"text\":3393},\"6df7555f7fed\",[],\"Interactive workshop with Lewis Smart\",[],{\"_key\":3396,\"_type\":1614,\"children\":3397,\"level\":34,\"listItem\":2883,\"markDefs\":3402,\"style\":1622},\"70310b164b0f\",[3398],{\"_key\":3399,\"_type\":1618,\"marks\":3400,\"text\":3401},\"ee0e95ae49b4\",[],\"Prize raffle\",[],{\"_key\":3404,\