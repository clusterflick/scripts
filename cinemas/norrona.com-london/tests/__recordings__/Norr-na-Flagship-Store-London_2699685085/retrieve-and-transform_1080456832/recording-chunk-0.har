n-map m-t-12\"><hr><div class=\"drawer-header justify-content-between align-items-center -clickable\"><!--[--><div class=\"event-location-byline\"><span class=\"event-location-byline-image\" aria-hidden=\"true\"><div class=\"media-wrapper\" style=\"--media-ratio-sm:1;\"><figure><picture><!--[--><!--]--><img loading=\"lazy\" loading=\"lazy\" class=\"base-image base-image-lazy\" src=\"https://res.cloudinary.com/norrona/image/upload/x_1510,y_1915,w_3021,h_3021,c_crop,g_xy_center/b_rgb:fcfcfc/c_pad,f_auto,d_imgmissing.jpg,fl_progressive.lossy,q_auto,w_3021,h_3021/Auto%2FFlagship_london-norrona-storefront-1-no-people_2-edited.jpg\" srcset=\"https://res.cloudinary.com/norrona/image/upload/x_1510,y_1915,w_3021,h_3021,c_crop,g_xy_center/b_rgb:fcfcfc/c_pad,f_auto,d_imgmissing.jpg,fl_progressive.lossy,q_auto,w_220,h_220/Auto%2FFlagship_london-norrona-storefront-1-no-people_2-edited.jpg 220w\" sizes=\"32px\" width=\"3021\" height=\"3021\" alt=\"Norrøna storefront with a poster of a man in a Norrøna jacket next to an opening soon sign.\" style=\"aspect-ratio:var(--media-ratio, 1);\" decoding=\"async\"></picture><!----></figure></div></span><span class=\"font-responsive-small\"><span class=\"d-block -small-caps\">Event location</span><span class=\"event-location-byline-name\">Norrøna Flagship Store London</span></span></div><!--]--><button class=\"stripped-btn -black chevron-wrapper\" type=\"button\" aria-expanded=\"false\" aria-label=\"Event location\"><svg version=\"1.1\" viewbox=\"0 0 16 16\" xmlns=\"http://www.w3.org/2000/svg\" class=\"icon-chevron\" style=\"width:16px;min-width:16px;height:16px;\"><g fill=\"none\" fill-rule=\"evenodd\"><polygon points=\"0 0 16 0 16 16 0 16\"></polygon><polygon points=\"8 10.171 14.586 3.5863 16 5.0007 8 13 -5.8298e-5 5.0007 1.4141 3.5863\" fill=\"#1D1D1D\"></polygon></g></svg></button></div><div class=\"drawer-content\"><div class=\"drawer-inner\"><!--[--><div class=\"event-location-map-body\"><p class=\"event-location-address font-responsive-small\">15th Regent Street, SW1Y 4LR, London</p><div class=\"event-location-map-canvas-wrap\"><!----></div><a href=\"https://www.google.com/maps/dir/?api=1&amp;destination=51.50882133721951%2C-0.13411191233148045&amp;destination_place_id=ChIJHUqC1ygFdkgRw-goNXWgCUk\" target=\"_blank\" rel=\"noopener\" class=\"event-location-map-route font-responsive-small\">Calculate route</a><a href=\"/gb/en/store/norrona-flagship-store-london\" class=\"event-location-store-link font-responsive-small\">Norrøna Flagship Store London</a><div class=\"event-location-store-wrap\"><hr class=\"event-location-store-rule\"><a href=\"/gb/en/store/norrona-flagship-store-london\" class=\"event-location-store -black\"><span class=\"event-location-store-image\"><div class=\"media-wrapper\" style=\"--media-ratio-sm:1;\"><figure><picture><!--[--><!--]--><img loading=\"lazy\" loading=\"lazy\" class=\"base-image base-image-lazy\" src=\"https://res.cloudinary.com/norrona/image/upload/x_1510,y_1915,w_3021,h_3021,c_crop,g_xy_center/b_rgb:fcfcfc/c_pad,f_auto,d_imgmissing.jpg,fl_progressive.lossy,q_auto,w_3021,h_3021/Auto%2FFlagship_london-norrona-storefront-1-no-people_2-edited.jpg\" srcset=\"https://res.cloudinary.com/norrona/image/upload/x_1510,y_1915,w_3021,h_3021,c_crop,g_xy_center/b_rgb:fcfcfc/c_pad,f_auto,d_imgmissing.jpg,fl_progressive.lossy,q_auto,w_220,h_220/Auto%2FFlagship_london-norrona-storefront-1-no-people_2-edited.jpg 220w,https://res.cloudinary.com/norrona/image/upload/x_1510,y_1915,w_3021,h_3021,c_crop,g_xy_center/b_rgb:fcfcfc/c_pad,f_auto,d_imgmissing.jpg,fl_progressive.lossy,q_auto,w_275,h_275/Auto%2FFlagship_london-norrona-storefront-1-no-people_2-edited.jpg 275w\" sizes=\"80px\" width=\"3021\" height=\"3021\" alt=\"Norrøna storefront with a poster of a man in a Norrøna jacket next to an opening soon sign.\" style=\"aspect-ratio:var(--media-ratio, 1);\" decoding=\"async\"></picture><!----></figure></div></span><span><span class=\"d-block font-responsive-small -small-caps\">Event location</span><span class=\"d-block font-responsive-body\">Norrøna Flagship Store London</span><span class=\"d-block font-responsive-small m-t-6\">15th Regent Street, SW1Y 4LR, London</span></span></a></div></div><!--]--></div></div></section><!----><!----><!--]--></section><section class=\"g-12 g-md-7-6\"><section class=\"m-b-36\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=leadText:en.value;base=%2F\"><div class=\"article-lead-text g-12 font-responsive-large -strong\"><!--[--><p><strong>Discover Northern Norway&#39;s most incredible adventures!</strong></p><!--]--></div></section><section class=\"content-area\"><div data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value;base=%2F\"><section class=\"content-area\" style=\"color:inherit;background-color:transparent;\"><div class=\"content-area-portable-text\"><!--[--><section class=\"m-b-6\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:a4d93c6494e0;base=%2F\"><h4 class=\"g-12 font-responsive-large\">What can you expect:</h4></section><section class=\"\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:d29d63bf5870-parent;base=%2F\"><ul class=\"g-12 m-b-18 custom-ul\"><li class=\"list-bullet\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:d29d63bf5870;base=%2F\">Listen to legendary ski guide <strong>Asbjørn Eggebø Næss</strong> and Norrøna Varg Sailing Yacht skipper and adventure expert, <strong>Jan Fasting, </strong>as they introduce the brand new Norrøna Andørja Lodge and <strong>The Arctic Voyage.</strong></li><li class=\"list-bullet\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:9a86442ab710;base=%2F\">Watch the new Norrøna ski film from last years ski and sail expedition in Northern Norway: <em>The Maiden Voyage.</em></li><li class=\"list-bullet\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:6582e18f670c;base=%2F\">Join this event for a <strong>chance to win a stay at Norrøna Andørja Lodge and Norrøna gear!</strong></li></ul></section><section class=\"m-b-6\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:2aa37256cb4d;base=%2F\"><h4 class=\"g-12 font-responsive-large\">Discover Your Next Great Adventure in the North</h4></section><section class=\"\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:2998d1918095;base=%2F\"><p class=\"g-12 m-b-18\">Imagine waking up to mountains rising straight out of the fjord. Traveling by sea to reach untouched snow. Climbing magnificent peaks with good friends. Sailing between islands and through fjords in search of extraordinary adventures.</p></section><section class=\"\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:1197a83491ac;base=%2F\"><p class=\"g-12 m-b-18\">Discover how you can join these unique adventures throughout the year. In the spectacular wilderness of Northern Norway, we now offer ski touring, hiking, alpine scrambling, trail running, mountain biking, Northern Lights experiences, Arctic exploration, and unforgettable adventures in nature!</p></section><section class=\"\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:91e4fe058c59;base=%2F\"><p class=\"g-12 m-b-18\">Joining Asbjørn is <strong>Jan Fasting. </strong>Over the years, he has helped create some of the country’s most remarkable outdoor destinations – including our unique Canvas hotel, hidden deep in the forests of Telemark. Jan knows the Norwegian coastline like the back of his hand and today, he’s helping shape The Arctic Voyage.</p></section><section class=\"m-b-6\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:38040dbad2d9;base=%2F\"><h4 class=\"g-12 font-responsive-large\">Get Ready for This Winter&#39;s Ski Touring Adventures</h4></section><section class=\"\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:6cbfb93eba29;base=%2F\"><p class=\"g-12 m-b-18\">What&#39;s the smartest way to pack for a ski tour? What essential gear should you always carry in your backpack? And how do you plan a safe and successful adventure in the Norwegian winter mountains?</p></section><section class=\"\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:625b191c2f28;base=%2F\"><p class=\"g-12 m-b-18\">Asbjørn will reveal his favorite packing tips, share experiences from the mountains, and offer valuable insights into winter mountain safety. You&#39;ll leave with practical knowledge to bring along on your own ski adventures this winter.</p></section><section class=\"m-b-6\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:901a31a06da8;base=%2F\"><h4 class=\"g-12 font-responsive-large\">Experience <em>The Maiden Voyage</em> on the Big Screen</h4></section><section class=\"\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:fd4e76ec0ac2;base=%2F\"><p class=\"g-12 m-b-18\">One of Norway&#39;s leading movie production companies, Field Productions, joined some of Norway´s best skiers and snowboarders as they boarded the sailing yacht Varg S/Y in Tromsø in February 2026.</p></section><section class=\"\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:5cf3137050eb;base=%2F\"><p class=\"g-12 m-b-18\">This was the very first Ski &amp; Sail adventure aboard Norrøna&#39;s new sailing yacht. In the breathtaking film <em>The Maiden Voyage</em>, you&#39;ll join the search for untouched snow and potential first descents in the magnificent coastal mountains of Troms.</p></section><section class=\"\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:b26e176962af;base=%2F\"><p class=\"g-12 m-b-18\">Packed with adventure, spectacular scenery, and unforgettable skiing, this film captures Northern Norway at its wildest!</p></section><section class=\"m-b-6\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:9fabe256521c;base=%2F\"><h4 class=\"g-12 font-responsive-large\">Win Amazing Prizes – Including a Stay for Two at Andørja Lodge!</h4></section><section class=\"\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:870511d08895;base=%2F\"><p class=\"g-12 m-b-18\">We&#39;ll draw one lucky winner of a free Norrøna product from everyone attending this event.</p></section><section class=\"\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:e6cfe61ab992;base=%2F\"><p class=\"g-12 m-b-18\">But that&#39;s not all!</p></section><section class=\"\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:ffd231602a30;base=%2F\"><p class=\"g-12 m-b-18\"><strong>Everyone attending our Arctic Voyage events this fall – in Norway and around the world – will also be entered into one grand prize drawing: A stay for two at the brand-new Norrøna Andørja Lodge in summer 2027!</strong></p></section><section class=\"\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:cad4ccbc56eb;base=%2F\"><p class=\"g-12 m-b-18\">The grand prize winner will be selected from participants across all our Arctic Voyage events after the fall event series concludes in December.</p></section><section class=\"\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:d45ba6bf982e;base=%2F\"><p class=\"g-12 m-b-18\">The lucky winner can bring a friend or loved one to experience our new adventure lodge in the North.</p></section><section class=\"\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:b42db89c3c4a;base=%2F\"><p class=\"g-12 m-b-18\"><em>Round-trip travel to and from Harstad/Narvik Airport, Evenes, Norway, must be arranged and paid for by the winner and their guest.</em></p></section><section class=\"\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:409eaeb3c3f0;base=%2F\"><p class=\"g-12 m-b-18\"><strong>Secure Your Spot – and Let Your Next Adventure Begin!</strong></p></section><section class=\"practical-info\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:practical-info;base=%2F\"><h2 class=\"font-responsive-body m-b-12\"><strong>Practical info</strong></h2><ul class=\"practical-info-rows\"><li class=\"practical-info-row\"><svg width=\"16\" height=\"16\" viewbox=\"0 0 16 16\" xmlns=\"http://www.w3.org/2000/svg\" name=\"Calendar\" active=\"false\" outline=\"false\" keep-color=\"true\" fill=\"transparent\" stroke=\"false\" small=\"false\"><g fill=\"#1D1D1D\" fill-rule=\"evenodd\"><path class=\"svgfill\" d=\"M4 0h1.5v2h5V0H12v2h1.5A1.5 1.5 0 0 1 15 3.5v11a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 1 14.5v-11A1.5 1.5 0 0 1 2.5 2H4V0ZM2.5 6v8.5h11V6h-11Z\"></path></g></svg><div>Wednesday 25 November, 19:00 <!----></div></li><li class=\"practical-info-row\"><svg width=\"16\" height=\"16\" viewbox=\"0 0 16 16\" xmlns=\"http://www.w3.org/2000/svg\" name=\"Pin\" active=\"false\" outline=\"false\" keep-color=\"true\" fill=\"transparent\" stroke=\"false\" small=\"false\"><g fill=\"#1D1D1D\" fill-rule=\"evenodd\" transform=\"translate(2 0)\"><path class=\"svgfill\" d=\"M6 0C2.69 0 0 2.69 0 6c0 4.5 6 10 6 10s6-5.5 6-10c0-3.31-2.69-6-6-6zm0 8.5A2.5 2.5 0 1 1 6 3.5a2.5 2.5 0 0 1 0 5z\"></path></g></svg><a href=\"/gb/en/store/norrona-flagship-store-london\" class=\"practical-info-link\">Norrøna Flagship Store London</a></li><li class=\"practical-info-row\"><svg width=\"16\" height=\"16\" viewbox=\"0 0 16 16\" xmlns=\"http://www.w3.org/2000/svg\" name=\"Globe\" active=\"false\" outline=\"false\" keep-color=\"true\" fill=\"transparent\" stroke=\"false\" small=\"false\"><g fill=\"none\" stroke=\"#1D1D1D\" stroke-width=\"1.3\"><circle cx=\"8\" cy=\"8\" r=\"6.5\"></circle><ellipse cx=\"8\" cy=\"8\" rx=\"2.75\" ry=\"6.5\"></ellipse><path d=\"M1.5 8h13\"></path></g></svg><span>Held in English</span></li><!----><!----><!--[--><!--]--></ul></section><section class=\"portable-text-image -textWidth\" style=\"\" color=\"inherit\" data-sanity=\"id=0c5b5fd5-5097-5c7a-b701-6e8ba19d7052;type=eventPage;path=portableText:en.value:6d92893651f4;base=%2F\"><div class=\"m-b-18 m-b-md-36 -textWidth\"><div class=\"\"><figure class=\"\"><div class=\"portable-text-image-media\"><div class=\"media-wrapper\" style=\"--media-ratio-sm:1.4998892580287928;\"><figure><picture><!--[--><!--]--><img loading=\"lazy\" loading=\"lazy\" class=\"base-image base-image-lazy\" src=\"https://res.cloudinary.com/norrona/image/upload/f_auto,d_imgmissing.jpg,fl_progressive.lossy,q_auto,b_rgb:fcfcfc,w_5000,h_3334/Auto%2FFW2627-VARG-WINTER-%40ChrisHolter_DSC4908.jpg\" srcset=\"https://res.cloudinary.com/norrona/image/upload/f_auto,d_imgmissing.jpg,fl_progressive.lossy,q_auto,b_rgb:fcfcfc,w_220,h_147/Auto%2FFW2627-VARG-WINTER-%40ChrisHolter_DSC4908.jpg 220w,https://res.cloudinary.com/norrona/image/upload/f_auto,d_imgmissing.jpg,fl_progressive.lossy,q_auto,b_rgb:fcfcfc,w_275,h_183/Auto%2FFW2627-VARG-WINTER-%40ChrisHolter_DSC4908.jpg 275w,https://res.cloudinary.com/norrona/image/upload/f_auto,d_imgmissing.jpg,fl_progressive.lossy,q_auto,b_rgb:fcfcfc,w_410,h_273/Auto%2FFW2627-VARG-WINTER-%40ChrisHolter_DSC4908.jpg 410w,https://res.cloudinary.com/norrona/image/upload/f_auto,d_imgmissing.jpg,fl_progressive.lossy,q_auto,b_rgb:fcfcfc,w_600,h_400/Auto%2FFW2627-VARG-WINTER-%40ChrisHolter_DSC4908.jpg 600w,https://res.cl