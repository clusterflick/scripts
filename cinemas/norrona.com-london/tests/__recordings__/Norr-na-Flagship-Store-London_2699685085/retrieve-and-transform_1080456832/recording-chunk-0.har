\":3226,\"_type\":3025,\"platform\":3026,\"url\":3227},\"b4313b497bed\",\"https:\\u002F\\u002Fwww.instagram.com\\u002Fteal_harle\\u002F\",{\"lead\":3229,\"subTitle\":3030},\"Teal Harle is a professional Canadian freestyle skier raised in Campbell River, BC. He is now based in Pemberton, where he is known for a creative and technical style in big-mountain freeriding and backcountry exploration.\\n\\n\",\"Teal Harle\",[3232,3240,3265,3273,3303,3311,3331,3339,3347,3355,3363,3385,3393],{\"_key\":3233,\"_type\":1600,\"children\":3234,\"markDefs\":3239,\"style\":1608},\"9f01991ade67\",[3235],{\"_key\":3236,\"_type\":1604,\"marks\":3237,\"text\":1238},\"c06e01bdb3c9\",[3238],\"strong\",[],{\"_key\":3241,\"_type\":1600,\"children\":3242,\"markDefs\":3261,\"style\":1608},\"b76fea5faa50\",[3243,3247,3252,3257],{\"_key\":3244,\"_type\":1604,\"marks\":3245,\"text\":3246},\"e69c0464ed6c\",[],\"Teton Gravity Research (TGR) is one of the leading action sports filmmakers, capturing the worlds most iconic ski and snowboard moments. Now they are introducing their 31st annual film,\",{\"_key\":3248,\"_type\":1604,\"marks\":3249,\"text\":3251},\"701243b947e5\",[3250],\"em\",\" \\\"\",{\"_key\":3253,\"_type\":1604,\"marks\":3254,\"text\":3256},\"6aef473490cd\",[3250,3255,3238],\"adc4b0f31209\",\"Actually, It Is Rocket Science\",{\"_key\":3258,\"_type\":1604,\"marks\":3259,\"text\":3260},\"45d293b8d191\",[3250],\"\\\".\",[3262],{\"_key\":3255,\"_type\":3263,\"href\":3264},\"link\",\"https:\\u002F\\u002Fwww.tetongravity.com\\u002Factually-it-is-rocket-science-tgr-film\\u002F\",{\"_key\":3266,\"_type\":1600,\"children\":3267,\"markDefs\":3272,\"style\":1608},\"91921e345efa\",[3268],{\"_key\":3269,\"_type\":1604,\"marks\":3270,\"text\":3271},\"d83bc8b2666c\",[],\"This year, TGR takes a literal approach to the science of skiing, following some of the world’s best skiers as they push the limits of speed, precision, creativity, and commitment across some of the most consequential terrain on th