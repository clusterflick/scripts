lug\":1563,\"street\":1564,\"title\":1565},\"994a01d7-ad55-5b08-9786-72a884570776\",\"London\",\"ChIJHUqC1ygFdkgRw-goNXWgCUk\",{\"_key\":1532,\"_type\":1533,\"altText\":1534,\"center\":1535,\"height\":1554,\"id\":1532,\"name\":1555,\"pathCdn\":1556,\"pathCdnCloudflare\":1557,\"storeId\":1558,\"type\":1559,\"width\":1560},\"1kRo5KbbKLEwcMFeGRMiYDgml7kPln0bQ-bdfa4e2f5f9763d57b3eb72b4ff5421c.jpg\",\"mediaDetails\",\"Norrøna storefront with a poster of a man in a Norrøna jacket next to an opening soon sign.\",[1536,1542,1547],{\"t\":1537},[1538,42,1525,1539,1540,1541],217409,0.1,0.999,0.85,{\"t\":1543},[1544,54,1525,1545,1540,1546],217410,0.4419782811168579,0.8169782811168579,{\"t\":1548},[1549,1550,1551,1525,1552,1553],217411,0.5,0.08351168182628857,0.7502116818262885,0.9992,4032,\"Flagship_london-norrona-storefront-1-no-people_2-edited.jpg\",\"Auto\\u002FFlagship_london-norrona-storefront-1-no-people_2-edited\",\"flagship_london-norrona-storefront-1-no-people_2-edited\",\"NORRONA_LONDON\",\"jpg\",3024,51.50882133721951,-0.13411191233148045,\"norrona-flagship-store-london\",\"15th Regent Street, SW1Y 4LR\",\"Norrøna Flagship Store London\",{\"_key\":1567,\"_type\":1533,\"altText\":250,\"center\":1568,\"height\":1569,\"id\":1567,\"name\":1570,\"pathCdn\":1571,\"type\":250,\"width\":1572},\"1l6MSO8cEBKE_p4Nm66_uZk4XqGLaBwkX-51f7c25eedec1a2366faa93d4120b541.mp4\",[],2160,\"Arctic Voyage 16x9_0309.mp4\",\"0c2ffc4603935f799626e1e73b929a9e\",3840,\"b1037e45-75b2-47f8-b6c0-20e33ab3ab5a\",\"EN\",[1576],{\"_key\":1577,\"_type\":1578,\"children\":1579,\"markDefs\":1586,\"style\":1587},\"d7fe25ebcb28\",\"block\",[1580],{\"_key\":1581,\"_type\":1582,\"marks\":1583,\"text\":1585},\"4feab3fea42e\",\"span\",[1584],\"strong\",\"Discover Northern Norway's most incredible adventures!\",[],\"normal\",[],[1590,1599,1628,1640,1652,1660,1668,1676,1692,1700,1708,1716,1732,1740,1755,1763,1771,1779,1787,1795,1803,1811,1819,1827,1830,1917],{\"_key\":1591,\"_type\":1578,\"children\":1592,\"markDefs\":1597,\"style\":1598},\"a4d93c6494e0\",[1593],{\"_key\":1594,\"_type\":1582,\"marks\":1595,\"text\":1596},\"c7cd25f7f05c\",[],\"What can you expect:\",[],\"h4\",{\"_key\":1600,\"_type\":1578,\"children\":1601,\"level\":42,\"listItem\":1626,\"markDefs\":1627,\"style\":1587},\"d29d63bf5870\",[1602,1606,1610,1614,1618,1622],{\"_key\":1603,\"_type\":1582,\"marks\":1604,\"text\":1605},\"4143b810ab05\",[],\"Listen to legendary ski guide \",{\"_key\":1607,\"_type\":1582,\"marks\":1608,\"text\":1609},\"235a1cfc4162\",[1584],\"Asbjørn Eggebø Næss\",{\"_key\":1611,\"_type\":1582,\"marks\":1612,\"text\":1613},\"7582f2d416e4\",[],\" and Norrøna Varg Sailing Yacht skipper and adventure expert, \",{\"_key\":1615,\"_type\":1582,\"marks\":1616,\"text\":1617},\"0f6091bfd0b9\",[1584],\"Jan Fasting, \",{\"_key\":1619,\"_type\":1582,\"marks\":1620,\"text\":1621},\"f7c7a512e0d6\",[],\"as they introduce the brand new Norrøna Andørja Lodge and \",{\"_key\":1623,\"_type\":1582,\"marks\":1624,\"text\":1625},\"0238270a3807\",[1584],\"The Arctic Voyage.\",\"bullet\",[],{\"_key\":1629,\"_type\":1578,\"children\":1630,\"level\":42,\"listItem\":1626,\"markDefs\":1639,\"style\":1587},\"9a86442ab710\",[1631,1634],{\"_key\":1603,\"_type\":1582,\"marks\":1632,\"text\":1633},[],\"Watch the new Norrøna ski film from last years ski and sail expedition in Northern Norway: \",{\"_key\":1635,\"_type\":1582,\"marks\":1636,\"text\":1638},\"152f32eb536c\",[1637],\"em\",\"The Maiden Voyage.\",[],{\"_key\":1641,\"_type\":1578,\"children\":1642,\"level\":42,\"listItem\":1626,\"markDefs\":1651,\"style\":1587},\"6582e18f670c\",[1643,1647],{\"_key\":1644,\"_type\":1582,\"marks\":1645,\"text\":1646},\"115e74cdae91\",[],\"Join this event for a \",{\"_key\":1648,\"_type\":1582,\"marks\":1649,\"text\":1650},\"99027eca93d4\",[1584],\"chance to win a stay at Norrøna Andørja Lodge and Norrøna gear!\",[],{\"_key\":1653,\"_type\":1578,\"children\":1654,\"markDefs\":1659,\"style\":1598},\"2aa37256cb4d\",[1655],{\"_key\":1656,\"_type\":1582,\"marks\":1657,\"text\":1658},\"22d667e6b559\",[],\"Discover Your Next Great Adventure in the North\",[],{\"_key\":1661,\"_type\":1578,\"children\":1662,\"markDefs\":1667,\"style\":1587},\"2998d1918095\",[1663],{\"_key\":1664,\"_type\":1582,\"marks\":1665,\"text\":1666},\"7c692998d480\",[],\"Imagine waking up to mountains rising straight out of the fjord. Traveling by sea to reach untouched snow. Climbing magnificent peaks with good friends. Sailing between islands and through fjords in search of extraordinary adventures.\",[],{\"_key\":1669,\"_type\":1578,\"children\":1670,\"markDefs\":1675,\"style\":1587},\"1197a83491ac\",[1671],{\"_key\":1672,\"_type\":1582,\"marks\":1673,\"text\":1674},\"42411b6ae01f\",[],\"Discover how you can join these unique adventures throughout the year. In the spectacular wilderness of Northern Norway, we now offer ski touring, hiking, alpine scrambling, trail running, mountain biking, Northern Lights experiences, Arctic exploration, and unforgettable adventures in nature!\",[],{\"_key\":1677,\"_type\":1578,\"children\":1678,\"markDefs\":1691,\"style\":1587},\"91e4fe058c59\",[1679,1683,1687],{\"_key\":1680,\"_type\":1582,\"marks\":1681,\"text\":1682},\"cc6a0d31c611\",[],\"Joining Asbjørn is \",{\"_key\":1684,\"_type\":1582,\"marks\":1685,\"text\":1686},\"f9b1062abfba\",[1584],\"Jan Fasting. \",{\"_key\":1688,\"_type\":1582,\"marks\":1689,\"text\":1690},\"4320c9ff5d3e\",[],\"Over the years, he has helped create some of the country’s most remarkable outdoor destinations – including our unique Canvas hotel, hidden deep in the forests of Telemark. Jan knows the Norwegian coastline like the back of his hand and today, he’s helping shape The Arctic Voyage.\",[],{\"_key\":1693,\"_type\":1578,\"children\":1694,\"markDefs\":1699,\"style\":1598},\"38040dbad2d9\",[1695],{\"_key\":1696,\"_type\":1582,\"marks\":1697,\"text\":1698},\"5a8a1d57cd7f\",[],\"Get Ready for This Winter's Ski Touring Adventures\",[],{\"_key\":1701,\"_type\":1578,\"children\":1702,\"markDefs\":1707,\"style\":1587},\"6cbfb93eba29\",[1703],{\"_key\":1704,\"_type\":1582,\"marks\":1705,\"text\":1706},\"d8143686f4c5\",[],\"What's the smartest way to pack for a ski tour? What essential gear should you always carry in your backpack? And how do you plan a safe and successful adventure in the Norwegian winter mountains?\",[],{\"_key\":1709,\"_type\":1578,\"children\":1710,\"markDefs\":1715,\"style\":1587},\"625b191c2f28\",[1711],{\"_key\":1712,\"_type\":1582,\"marks\":1713,\"text\":1714},\"2cd444a1b25a\",[],\"Asbjørn will reveal his favorite packing tips, share experiences from the mountains, and offer valuable insights into winter mountain safety. You'll leave with practical knowledge to bring along on your own ski adventures this winter.\",[],{\"_key\":1717,\"_type\":1578,\"children\":1718,\"markDefs\":1731,\"style\":1598},\"901a31a06da8\",[1719,1723,1727],{\"_key\":1720,\"_type\":1582,\"marks\":1721,\"text\":1722},\"21d79bb11d06\",[],\"Experience \",{\"_key\":1724,\"_type\":1582,\"marks\":1725,\"text\":1726},\"67be2dc2f2f3\",[1637],\"The Maiden Voyage\",{\"_key\":1728,\"_type\":1582,\"marks\":1729,\"text\":1730},\"004bea7e44f2\",[],\" on the Big Screen\",[],{\"_key\":1733,\"_type\":1578,\"children\":1734,\"markDefs\":1739,\"style\":1587},\"fd4e76ec0ac2\",[1735],{\"_key\":1736,\"_type\":1582,\"marks\":1737,\"text\":1738},\"b2ea4f27d086\",[],\"One of Norway's leading movie production companies, Field Productions, joined some of Norway´s best skiers and snowboarders as they boarded the sailing yacht Varg S\\u002FY in Tromsø in February 2026.\",[],{\"_key\":1741,\"_type\":1578,\"children\":1742,\"markDefs\":1754,\"style\":1587},\"5cf3137050eb\",[1743,1747,1750],{\"_key\":1744,\"_type\":1582,\"marks\":1745,\"text\":1746},\"7ad05990f984\",[],\"This was the very first Ski & Sail adventure aboard Norrøna's new sailing yacht. In the breathtaking film \",{\"_key\":1748,\"_type\":1582,\"marks\":1749,\"text\":1726},\"d723e780d98a\",[1637],{\"_key\":1751,\"_type\":1582,\"marks\":1752,\"text\":1753},\"598d1edffdfd\",[],\", you'll join the search for untouched snow and potential first descents in the magnificent coastal mountains of Troms.\",[],{\"_key\":1756,\"_type\":1578,\"children\":1757,\"markDefs\":1762,\"style\":1587},\"b26e176962af\",[1758],{\"_key\":1759,\"_type\":1582,\"marks\":1760,\"text\":1761},\"14a14c7888ba\",[],\"Packed with adventure, spectacular scenery, and unforgettable skiing, this film captures Northern Norway at its wildest!\",[],{\"_key\":1764,\"_type\":1578,\"children\":1765,\"markDefs\":1770,\"style\":1598},\"9fabe256521c\",[1766],{\"_key\":1767,\"_type\":1582,\"marks\":1768,\"text\":1769},\"0c9571876a4d\",[],\"Win Amazing Prizes – Including a Stay for Two at Andørja Lodge!\",[],{\"_key\":1772,\"_type\":1578,\"children\":1773,\"markDefs\":1778,\"style\":1587},\"870511d08895\",[1774],{\"_key\":1775,\"_type\":1582,\"marks\":1776,\"text\":1777},\"497806d6c5f1\",[],\"We'll draw one lucky winner of a free Norrøna product from everyone attending this event.\",[],{\"_key\":1780,\"_type\":1578,\"children\":1781,\"markDefs\":1786,\"style\":1587},\"e6cfe61ab992\",[1782],{\"_key\":1783,\"_type\":1582,\"marks\":1784,\"text\":1785},\"4a22f55c4593\",[],\"But that's not all!\",[],{\"_key\":1788,\"_type\":1578,\"children\":1789,\"markDefs\":1794,\"style\":1587},\"ffd231602a30\",[1790],{\"_key\":1791,\"_type\":1582,\"marks\":1792,\"text\":1793},\"0eca4a657e9c\",[1584],\"Everyone attending our Arctic Voyage events this fall – in Norway and around the world – will also be entered into one grand prize drawing: A stay for two at the brand-new Norrøna Andørja Lodge in summer 2027!\",[],{\"_key\":1796,\"_type\":1578,\"children\":1797,\"markDefs\":1802,\"style\":1587},\"cad4ccbc56eb\",[1798],{\"_key\":1799,\"_type\":1582,\"marks\":1800,\"text\":1801},\"5605f4d827cb\",[],\"The grand prize winner will be selected from participants across all our Arctic Voyage events after the fall event series concludes in December.\",[],{\"_key\":1804,\"_type\":1578,\"children\":1805,\"markDefs\":1810,\"style\":1587},\"d45ba6bf982e\",[1806],{\"_key\":1807,\"_type\":1582,\"marks\":1808,\"text\":1809},\"caa7f719a649\",[],\"The lucky winner can bring a friend or loved one to experience our new adventure lodge in the North.\",[],{\"_key\":1812,\"_type\":1578,\"children\":1813,\"markDefs\":1818,\"style\":1587},\"b42db89c3c4a\",[1814],{\"_key\":1815,\"_type\":1582,\"marks\":1816,\"text\":1817},\"b3f0659761a9\",[1637],\"Round-trip travel to and from Harstad\\u002FNarvik Airport, Evenes, Norway, must be arranged and paid for by the winner and their guest.\",[],{\"_key\":1820,\"_type\":1578,\"children\":1821,\"markDefs\":1826,\"style\":1587},\"409eaeb3c3f0\",[1822],{\"_key\":1823,\"_type\":1582,\"marks\":1824,\"text\":1825},\"aad22db614aa\",[1584],\"Secure Your Spot – and Let Your Next Adventure Begin!\",[],{\"_key\":1828,\"_type\":1829,\"facts\":250},\"practical-info\",\"practicalInfo\",{\"_key\":1831,\"_type\":1832,\"image\":1833},\"6d92893651f4\",\"contentImage\",{\"_type\":1834,\"mediaItems\":1835},\"imageCollector\",[1836,1862,1885],{\"_key\":1837,\"_type\":1533,\"altText\":1838,\"center\":1839,\"description\":1857,\"height\":1858,\"id\":1837,\"name\":1859,\"pathCdn\":1860,\"type\":1559,\"width\":1861},\"1DqFAz3ti7EdoomUgcQz4uvbaO3QD2Tax-4f29ca2609b06542ff14cb7ed42f9c70.jpg\",\"Two smiling men on a boat wearing Norrøna jackets and life vests. Water and mountains are in the background.\",[1840,1847,1852],{\"_key\":1841,\"_type\":1842,\"aspectRatio\":42,\"bottomRightX\":1843,\"bottomRightY\":1844,\"fileId\":1837,\"id\":1845,\"isManual\":104,\"topLeftX\":1846,\"topLeftY\":1525},\"202621\",\"centerPoint\",0.8156,0.9988,202621,0.15,{\"_key\":1848,\"_type\":1842,\"aspectRatio\":54,\"bottomRightX\":1553,\"bottomRightY\":1849,\"fileId\":1837,\"id\":1850,\"isManual\":104,\"topLeftX\":1525,\"topLeftY\":1851},\"202622\",0.8756,202622,0.1232,{\"_key\":1853,\"_type\":1842,\"aspectRatio\":155