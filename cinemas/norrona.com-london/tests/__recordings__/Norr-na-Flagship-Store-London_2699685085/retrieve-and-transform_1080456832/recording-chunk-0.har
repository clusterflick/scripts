unt\":1523,\"seriesDates\":1942,\"sources\":1943,\"start\":1944,\"status\":1523,\"storeExternalId\":1556,\"storeName\":1528,\"tags\":1945,\"title\":1946,\"upcomingEvents\":1947,\"waiting\":1523},\"0c5b5fd5-5097-5c7a-b701-6e8ba19d7052\",\"eventPage\",{\"pathCdn\":1517,\"type\":20},\"Auto\\u002FRenders_Norrøna_Andørja_NaturOgSpenning_www\",{\"_id\":1519,\"title\":1520,\"value\":1521},\"155f1e56-aa0c-4953-bc7b-817cc35b688d\",\"Event\",{\"_type\":1522,\"current\":993},\"slug\",0,\"2026-11-25T21:00:00\",{\"_id\":1526,\"city\":1527,\"contentCategorySlug\":78,\"googlePlaceId\":1528,\"image\":1529,\"latitude\":1559,\"longitude\":1560,\"slug\":1561,\"street\":1562,\"title\":1563},\"994a01d7-ad55-5b08-9786-72a884570776\",\"London\",\"\",{\"_key\":1530,\"_type\":1531,\"altText\":1532,\"center\":1533,\"height\":1552,\"id\":1530,\"name\":1553,\"pathCdn\":1554,\"pathCdnCloudflare\":1555,\"storeId\":1556,\"type\":1557,\"width\":1558},\"1kRo5KbbKLEwcMFeGRMiYDgml7kPln0bQ-bdfa4e2f5f9763d57b3eb72b4ff5421c.jpg\",\"mediaDetails\",\"Norrøna storefront with a poster of a man in a Norrøna jacket next to an opening soon sign.\",[1534,1540,1545],{\"t\":1535},[1536,1314,1523,1537,1538,1539],217409,0.1,0.999,0.85,{\"t\":1541},[1542,1326,1523,1543,1538,1544],217410,0.4419782811168579,0.8169782811168579,{\"t\":1546},[1547,1548,1549,1523,1550,1551],217411,0.5,0.08351168182628857,0.7502116818262885,0.9992,4032,\"Flagship_london-norrona-storefront-1-no-people_2-edited.jpg\",\"Auto\\u002FFlagship_london-norrona-storefront-1-no-people_2-edited\",\"flagship_london-norrona-storefront-1-no-people_2-edited\",\"NORRONA_LONDON\",\"jpg\",3024,51.50882133721951,-0.13411191233148045,\"norrona-flagship-store-london\",\"15th Regent Street\",\"Norrøna Flagship Store London\",{\"_key\":1565,\"_type\":1531,\"altText\":20,\"center\":1566,\"height\":1567,\"id\":1565,\"name\":1568,\"pathCdn\":1569,\"type\":20,\"width\":1570},\"1l6MSO8cEBKE_p4Nm66_uZk4XqGLaBwkX-51f7c25eedec1a2366faa93d4120b541.mp4\",[],2160,\"Arctic Voyage 16x9_0309.mp4\",\"0c2ffc4603935f799626e1e73b929a9e\",3840,\"b1037e45-75b2-47f8-b6c0-20e33ab3ab5a\",\"EN\",[1574],{\"_key\":1575,\"_type\":1576,\"children\":1577,\"markDefs\":1584,\"style\":1585},\"d7fe25ebcb28\",\"block\",[1578],{\"_key\":1579,\"_type\":1580,\"marks\":1581,\"text\":1583},\"4feab3fea42e\",\"span\",[1582],\"strong\",\"Discover Northern Norway's most incredible adventures!\",[],\"normal\",[],[1588,1597,1626,1638,1650,1658,1666,1674,1690,1698,1706,1714,1730,1738,1753,1761,1769,1777,1785,1793,1801,1809,1817,1825,1828,1915],{\"_key\":1589,\"_type\":1576,\"children\":1590,\"markDefs\":1595,\"style\":1596},\"a4d93c6494e0\",[1591],{\"_key\":1592,\"_type\":1580,\"marks\":1593,\"text\":1594},\"c7cd25f7f05c\",[],\"What can you expect:\",[],\"h4\",{\"_key\":1598,\"_type\":1576,\"children\":1599,\"level\":1314,\"listItem\":1624,\"markDefs\":1625,\"style\":1585},\"d29d63bf5870\",[1600,1604,1608,1612,1616,1620],{\"_key\":1601,\"_type\":1580,\"marks\":1602,\"text\":1603},\"4143b810ab05\",[],\"Listen to legendary ski guide \",{\"_key\":1605,\"_type\":1580,\"marks\":1606,\"text\":1607},\"235a1cfc4162\",[1582],\"Asbjørn Eggebø Næss\",{\"_key\":1609,\"_type\":1580,\"marks\":1610,\"text\":1611},\"7582f2d416e4\",[],\" and Norrøna Varg Sailing Yacht skipper and adventure expert, \",{\"_key\":1613,\"_type\":1580,\"marks\":1614,\"text\":1615},\"0f6091bfd0b9\",[1582],\"Jan Fasting, \",{\"_key\":1617,\"_type\":1580,\"marks\":1618,\"text\":1619},\"f7c7a512e0d6\",[],\"as they introduce the brand new Norrøna Andørja Lodge and \",{\"_key\":1621,\"_type\":1580,\"marks\":1622,\"text\":1623},\"0238270a3807\",[1582],\"The Arctic Voyage.\",\"bullet\",[],{\"_key\":1627,\"_type\":1576,\"children\":1628,\"level\":1314,\"listItem\":1624,\"markDefs\":1637,\"style\":1585},\"9a86442ab710\",[1629,1632],{\"_key\":1601,\"_type\":1580,\"marks\":1630,\"text\":1631},[],\"Watch the new Norrøna ski film from last years ski and sail expedition in Northern Norway: \",{\"_key\":1633,\"_type\":1580,\"marks\":1634,\"text\":1636},\"152f32eb536c\",[1635],\"em\",\"The Maiden Voyage.\",[],{\"_key\":1639,\"_type\":1576,\"children\":1640,\"level\":1314,\"listItem\":1624,\"markDefs\":1649,\"style\":1585},\"6582e18f670c\",[1641,1645],{\"_key\":1642,\"_type\":1580,\"marks\":1643,\"text\":1644},\"115e74cdae91\",[],\"Join this event for a \",{\"_key\":1646,\"_type\":1580,\"marks\":1647,\"text\":1648},\"99027eca93d4\",[1582],\"chance to win a stay at Norrøna Andørja Lodge and Norrøna gear!\",[],{\"_key\":1651,\"_type\":1576,\"children\":1652,\"markDefs\":1657,\"style\":1596},\"2aa37256cb4d\",[1653],{\"_key\":1654,\"_type\":1580,\"marks\":1655,\"text\":1656},\"22d667e6b559\",[],\"Discover Your Next Great Adventure in the North\",[],{\"_key\":1659,\"_type\":1576,\"children\":1660,\"markDefs\":1665,\"style\":1585},\"2998d1918095\",[1661],{\"_key\":1662,\"_type\":1580,\"marks\":1663,\"text\":1664},\"7c692998d480\",[],\"Imagine waking up to mountains rising straight out of the fjord. Traveling by sea to reach untouched snow. Climbing magnificent peaks with good friends. Sailing between islands and through fjords in search of extraordinary adventures.\",[],{\"_key\":1667,\"_type\":1576,\"children\":1668,\"markDefs\":1673,\"style\":1585},\"1197a83491ac\",[1669],{\"_key\":1670,\"_type\":1580,\"marks\":1671,\"text\":1672},\"42411b6ae01f\",[],\"Discover how you can join these unique adventures throughout the year. In the spectacular wilderness of Northern Norway, we now offer ski touring, hiking, alpine scrambling, trail running, mountain biking, Northern Lights experiences, Arctic exploration, and unforgettable adventures in nature!\",[],{\"_key\":1675,\"_type\":1576,\"children\":1676,\"markDefs\":1689,\"style\":1585},\"91e4fe058c59\",[1677,1681,1685],{\"_key\":1678,\"_type\":1580,\"marks\":1679,\"text\":1680},\"cc6a0d31c611\",[],\"Joining Asbjørn is \",{\"_key\":1682,\"_type\":1580,\"marks\":1683,\"text\":1684},\"f9b1062abfba\",[1582],\"Jan Fasting. \",{\"_key\":1686,\"_type\":1580,\"marks\":1687,\"text\":1688},\"4320c9ff5d3e\",[],\"Over the years, he has helped create some of the country’s most remarkable outdoor destinations – including our unique Canvas hotel, hidden deep in the forests of Telemark. Jan knows the Norwegian coastline like the back of his hand and today, he’s helping shape The Arctic Voyage.\",[],{\"_key\":1691,\"_type\":1576,\"children\":1692,\"markDefs\":1697,\"style\":1596},\"38040dbad2d9\",[1693],{\"_key\":1694,\"_type\":1580,\"marks\":1695,\"text\":1696},\"5a8a1d57cd7f\",[],\"Get Ready for This Winter's Ski Touring Adventures\",[],{\"_key\":1699,\"_type\":1576,\"children\":1700,\"markDefs\":1705,\"style\":1585},\"6cbfb93eba29\",[1701],{\"_key\":1702,\"_type\":1580,\"marks\":1703,\"text\":1704},\"d8143686f4c5\",[],\"What's the smartest way to pack for a ski tour? What essential gear should you always carry in your backpack? And how do you plan a safe and successful adventure in the Norwegian winter mountains?\",[],{\"_key\":1707,\"_type\":1576,\"children\":1708,\"markDefs\":1713,\"style\":1585},\"625b191c2f28\",[1709],{\"_key\":1710,\"_type\":1580,\"marks\":1711,\"text\":1712},\"2cd444a1b25a\",[],\"Asbjørn will reveal his favorite packing tips, share experiences from the mountains, and offer valuable insights into winter mountain safety. You'll leave with practical knowledge to bring along on your own ski adventures this winter.\",[],{\"_key\":1715,\"_type\":1576,\"children\":1716,\"markDefs\":1729,\"style\":1596},\"901a31a06da8\",[1717,1721,1725],{\"_key\":1718,\"_type\":1580,\"marks\":1719,\"text\":1720},\"21d79bb11d06\",[],\"Experience \",{\"_key\":1722,\"_type\":1580,\"marks\":1723,\"text\":1724},\"67be2dc2f2f3\",[1635],\"The Maiden Voyage\",{\"_key\":1726,\"_type\":1580,\"marks\":1727,\"text\":1728},\"004bea7e44f2\",[],\" on the Big Screen\",[],{\"_key\":1731,\"_type\":1576,\"children\":1732,\"markDefs\":1737,\"style\":1585},\"fd4e76ec0ac2\",[1733],{\"_key\":1734,\"_type\":1580,\"marks\":1735,\"text\":1736},\"b2ea4f27d086\",[],\"One of Norway's leading movie production companies, Field Productions, joined some of Norway´s best skiers and snowboarders as they boarded the sailing yacht Varg S\\u002FY in Tromsø in February 2026.\",[],{\"_key\":1739,\"_type\":1576,\"children\":1740,\"markDefs\":1752,\"style\":1585},\"5cf3137050eb\",[1741,1745,1748],{\"_key\":1742,\"_type\":1580,\"marks\":1743,\"text\":1744},\"7ad05990f984\",[],\"This was the very first Ski & Sail adventure aboard Norrøna's new sailing yacht. In the breathtaking film \",{\"_key\":1746,\"_type\":1580,\"marks\":1747,\"text\":1724},\"d723e780d98a\",[1635],{\"_key\":1749,\"_type\":1580,\"marks\":1750,\"text\":1751},\"598d1edffdfd\",[],\", you'll join the search for untouched snow and potential first descents in the magnificent coastal mountains of Troms.\",[],{\"_key\":1754,\"_type\":1576,\"children\":1755,\"markDefs\":1760,\"style\":1585},\"b26e176962af\",[1756],{\"_key\":1757,\"_type\":1580,\"marks\":1758,\"text\":1759},\"14a14c7888ba\",[],\"Packed with adventure, spectacular scenery, and unforgettable skiing, this film captures Northern Norway at its wildest!\",[],{\"_key\":1762,\"_type\":1576,\"children\":1763,\"markDefs\":1768,\"style\":1596},\"9fabe256521c\",[1764],{\"_key\":1765,\"_type\":1580,\"marks\":1766,\"text\":1767},\"0c9571876a4d\",[],\"Win Amazing Prizes – Including a Stay for Two at Andørja Lodge!\",[],{\"_key\":1770,\"_type\":1576,\"children\":1771,\"markDefs\":1776,\"style\":1585},\"870511d08895\",[1772],{\"_key\":1773,\"_type\":1580,\"marks\":1774,\"text\":1775},\"497806d6c5f1\",[],\"We'll draw one lucky winner of a free Norrøna product from everyone attending this event.\",[],{\"_key\":1778,\"_type\":1576,\"children\":1779,\"markDefs\":1784,\"style\":1585},\"e6cfe61ab992\",[1780],{\"_key\":1781,\"_type\":1580,\"marks\":1782,\"text\":1783},\"4a22f55c4593\",[],\"But that's not all!\",[],{\"_key\":1786,\"_type\":1576,\"children\":1787,\"markDefs\":1792,\"style\":1585},\"ffd231602a30\",[1788],{\"_key\":1789,\"_type\":1580,\"marks\":1790,\"text\":1791},\"0eca4a657e9c\",[1582],\"Everyone attending our Arctic Voyage events this fall – in Norway and around the world – will also be entered into one grand prize drawing: A stay for two at the brand-new Norrøna Andørja Lodge in summer 2027!\",[],{\"_key\":1794,\"_type\":1576,\"children\":1795,\"markDefs\":1800,\"style\":1585},\"cad4ccbc56eb\",[1796],{\"_key\":1797,\"_type\":1580,\"marks\":1798,\"text\":1799},\"5605f4d827cb\",[],\"The grand prize winner will be selected from participants across all our Arctic Voyage events after the fall event series concludes in December.\",[],{\"_key\":1802,\"_type\":1576,\"children\":1803,\"markDefs\":1808,\"style\":1585},\"d45ba6bf982e\",[1804],{\"_key\":1805,\"_type\":1580,\"marks\":1806,\"text\":1807},\"caa7f719a649\",[],\"The lucky winner can bring a friend or loved one to experience our new adventure lodge in the North.\",[],{\"_key\":1810,\"_type\":1576,\"children\":1811,\"markDefs\":1816,\"style\":1585},\"b42db89c3c4a\",[1812],{\"_key\":1813,\"_type\":1580,\"marks\":1814,\"text\":1815},\"b3f0659761a9\",[1635],\"Round-trip travel to and from Harstad\\u002FNarvik Airport, Evenes, Norway, must be arranged and paid for by the winner and their guest.\",[],{\"_key\":1818,\"_type\":1576,\"children\":1819,\"markDefs\":1824,\"style\":1585},\"409eaeb3c3f0\",[1820],{\"_key\":1821,\"_type\":1580,\"marks\":1822,\"text\":1823},\"aad22db614aa\",[1582],\"Secure Your Spot – and Let Your Next Adventure Begin!\",[],{\"_key\":1826,\"_type\":1827,\"facts\":20},\"practical-info\",\"practicalInfo\",{\"_key\":1829,\"_type\":1830,\"image\":1831},\"6d92893651f4\",\"contentImage\",{\"_type\":1832,\"mediaItems\":1833},\"imageCollector\",[1834,1860,1883],{\"_key\":1835,\"_type\":1531,\"altText\":1836,\"center\":1837,\"description\":1855,\"height\":1856,\"id\":1835,\"name\":1857,\"pathCdn\":1858,\"type\":1557,\"width\":1859},\"1DqFAz3ti7EdoomUgcQz4uvbaO3QD2Tax-4f29ca2609b06542ff14cb7ed42f9c70.jpg\",\"Two s