start\":2403,\"status\":1727,\"storeExternalId\":1747,\"storeName\":1849,\"subTitle\":1849,\"tags\":2793,\"title\":2794,\"waiting\":1727},\"2026-10-30T13:02:13Z\",\"0c5b5fd5-5097-5c7a-b701-6e8ba19d7052\",{\"base\":2398},{\"id\":2396,\"rev\":2399},\"jGgh7CU8v8JSnfJnTSdBAK\",\"2026-11-03T09:48:22Z\",{\"_createdAt\":2049,\"_id\":2050,\"_rev\":2051,\"_type\":2052,\"_updatedAt\":2053,\"title\":2054,\"value\":2402},{\"_type\":1845,\"current\":1042},\"2026-11-25T19:00:00\",\"2026-11-25T21:00:00\",{\"_key\":2406,\"_type\":1721,\"altText\":2407,\"center\":2408,\"height\":2435,\"id\":2406,\"name\":2436,\"pathCdn\":2437,\"products\":2438,\"width\":2104},\"1TvYEx7riF8rZwd9VTSz-R_yKIFFddgqp-ee2dc6d6218ff8c7f03ca610f4c36f28.jpg\",\"Illuminated modern cabins on a rocky coast with stormy ocean waves crashing, set against misty mountains.\",[2409,2413,2418,2423,2429],{\"t\":2410},[2411,34,2412,1727,1742,1902],210361,0.2938,{\"t\":2414},[2415,46,1727,2416,1742,2417],210362,0.00835955056179774,0.7163595505617977,{\"t\":2419},[2420,1739,2421,1727,2422,1902],210363,0.2846457865168539,0.637745786516854,{\"t\":2424},[2425,2426,1727,2427,34,2428],214943,1.78,0.04915730337078652,0.8452229699431046,{\"t\":2430},[2431,2432,2433,1727,2434,34],214944,0.8,0.26894466292134833,0.8342246629213483,3533,\"Renders_Norrøna_Andørja_NaturOgSpenning_www.mir.no.jpg\",\"Auto\\u002FRenders_Norrøna_Andørja_NaturOgSpenning_www\",[],\"b1037e45-75b2-47f8-b6c0-20e33ab3ab5a\",[2441],{\"_key\":2442,\"_type\":2110,\"language\":1874,\"value\":2443},\"d3c8e924af94b631470796f6716b899a\",[2444],{\"_key\":2445,\"_type\":1926,\"children\":2446,\"markDefs\":2451,\"style\":1934},\"d7fe25ebcb28\",[2447],{\"_key\":2448,\"_type\":1930,\"marks\":2449,\"text\":2450},\"4feab3fea42e\",[2135],\"Discover Northern Norway's most incredible adventures!\",[],[2453],{\"_key\":1874,\"_type\":2127,\"language\":1874,\"value\":2454},[2455,2464,2492,2503,2515,2523,2531,2539,2555,2563,2571,2579,2595,2603,2618,2626,2634,2642,2650,2658,2666,2674,2682,2690,2693,2779],{\"_key\":2456,\"_type\":1926,\"children\":2457,\"markDefs\":2462,\"style\":2463},\"a4d93c6494e0\",[2458],{\"_key\":2459,\"_type\":1930,\"marks\":2460,\"text\":2461},\"c7cd25f7f05c\",[],\"What can you expect:\",[],\"h4\",{\"_key\":2465,\"_type\":1926,\"children\":2466,\"level\":34,\"listItem\":2176,\"markDefs\":2491,\"style\":1934},\"d29d63bf5870\",[2467,2471,2475,2479,2483,2487],{\"_key\":2468,\"_type\":1930,\"marks\":2469,\"text\":2470},\"4143b810ab05\",[],\"Listen to legendary ski guide \",{\"_key\":2472,\"_type\":1930,\"marks\":2473,\"text\":2474},\"235a1cfc4162\",[2135],\"Asbjørn Eggebø Næss\",{\"_key\":2476,\"_type\":1930,\"marks\":2477,\"text\":2478},\"7582f2d416e4\",[],\" and Norrøna Varg Sailing Yacht skipper and adventure expert, \",{\"_key\":2480,\"_type\":1930,\"marks\":2481,\"text\":2482},\"0f6091bfd0b9\",[2135],\"Jan Fasting, \",{\"_key\":2484,\"_type\":1930,\"marks\":2485,\"text\":2486},\"f7c7a512e0d6\",[],\"as they introduce the brand new Norrøna Andørja Lodge and \",{\"_key\":2488,\"_type\":1930,\"marks\":2489,\"text\":2490},\"0238270a3807\",[2135],\"The Arctic Voyage.\",[],{\"_key\":2493,\"_type\":1926,\"children\":2494,\"level\":34,\"listItem\":2176,\"markDefs\":2502,\"style\":1934},\"9a86442ab710\",[2495,2498],{\"_key\":2468,\"_type\":1930,\"marks\":2496,\"text\":2497},[],\"Watch the new Norrøna ski film from last years ski and sail expedition in Northern Norway: \",{\"_key\":2499,\"_type\":1930,\"marks\":2500,\"text\":2501},\"152f32eb536c\",[2291],\"The Maiden Voyage.\",[],{\"_key\":2504,\"_type\":1926,\"children\":2505,\"level\":34,\"listItem\":2176,\"markDefs\":2514,\"style\":1934},\"6582e18f670c\",[2506,2510],{\"_key\":2507,\"_type\":1930,\"marks\":2508,\"text\":2509},\"115e74cdae91\",[],\"Join this event for a \",{\"_key\":2511,\"_type\":1930,\"marks\":2512,\"text\":2513},\"99027eca93d4\",[2135],\"chance to win a stay at Norrøna Andørja Lodge and Norrøna gear!\",[],{\"_key\":2516,\"_type\":1926,\"children\":2517,\"markDefs\":2522,\"style\":2463},\"2aa37256cb4d\",[2518],{\"_key\":2519,\"_type\":1930,\"marks\":2520,\"text\":2521},\"22d667e6b559\",[],\"Discover Your Next Great Adventure in the North\",[],{\"_key\":2524,\"_type\":1926,\"children\":2525,\"markDefs\":2530,\"style\":1934},\"2998d1918095\",[2526],{\"_key\":2527,\"_type\":1930,\"marks\":2528,\"text\":2529},\"7c692998d480\",[],\"Imagine waking up to mountains rising straight out of the fjord. Traveling by sea to reach untouched snow. Climbing magnificent peaks with good friends. Sailing between islands and through fjords in search of extraordinary adventures.\",[],{\"_key\":2532,\"_type\":1926,\"children\":2533,\"markDefs\":2538,\"style\":1934},\"1197a83491ac\",[2534],{\"_key\":2535,\"_type\":1930,\"marks\":2536,\"text\":2537},\"42411b6ae01f\",[],\"Discover how you can join these unique adventures throughout the year. In the spectacular wilderness of Northern Norway, we now offer ski touring, hiking, alpine scrambling, trail running, mountain biking, Northern Lights experiences, Arctic exploration, and unforgettable adventures in nature!\",[],{\"_key\":2540,\"_type\":1926,\"children\":2541,\"markDefs\":2554,\"style\":1934},\"91e4fe058c59\",[2542,2546,2550],{\"_key\":2543,\"_type\":1930,\"marks\":2544,\"text\":2545},\"cc6a0d31c611\",[],\"Joining Asbjørn is \",{\"_key\":2547,\"_type\":1930,\"marks\":2548,\"text\":2549},\"f9b1062abfba\",[2135],\"Jan Fasting. \",{\"_key\":2551,\"_type\":1930,\"marks\":2552,\"text\":2553},\"4320c9ff5d3e\",[],\"Over the years, he has helped create some of the country’s most remarkable outdoor destinations – including our unique Canvas hotel, hidden deep in the forests of Telemark. Jan knows the Norwegian coastline like the back of his hand and today, he’s helping shape The Arctic Voyage.\",[],{\"_key\":2556,\"_type\":1926,\"children\":2557,\"markDefs\":2562,\"style\":2463},\"38040dbad2d9\",[2558],{\"_key\":2559,\"_type\":1930,\"marks\":2560,\"text\":2561},\"5a8a1d57cd7f\",[],\"Get Ready for This Winter's Ski Touring Adventures\",[],{\"_key\":2564,\"_type\":1926,\"children\":2565,\"markDefs\":2570,\"style\":1934},\"6cbfb93eba29\",[2566],{\"_key\":2567,\"_type\":1930,\"marks\":2568,\"text\":2569},\"d8143686f4c5\",[],\"What's the smartest way to pack for a ski tour? What essential gear should you always carry in your backpack? And how do you plan a safe and successful adventure in the Norwegian winter mountains?\",[],{\"_key\":2572,\"_type\":1926,\"children\":2573,\"markDefs\":2578,\"style\":1934},\"625b191c2f28\",[2574],{\"_key\":2575,\"_type\":1930,\"marks\":2576,\"text\":2577},\"2cd444a1b25a\",[],\"Asbjørn will reveal his favorite packing tips, share experiences from the mountains, and offer valuable insights into winter mountain safety. You'll leave with practical knowledge to bring along on your own ski adventures this winter.\",[],{\"_key\":2580,\"_type\":1926,\"children\":2581,\"markDefs\":2594,\"style\":2463},\"901a31a06da8\",[2582,2586,2590],{\"_key\":2583,\"_type\":1930,\"marks\":2584,\"text\":2585},\"21d79bb11d06\",[],\"Experience \",{\"_key\":2587,\"_type\":1930,\"marks\":2588,\"text\":2589},\"67be2dc2f2f3\",[2291],\"The Maiden Voyage\",{\"_key\":2591,\"_type\":1930,\"marks\":2592,\"text\":2593},\"004bea7e44f2\",[],\" on the Big Screen\",[],{\"_key\":2596,\"_type\":1926,\"children\":2597,\"markDefs\":2602,\"style\":1934},\"fd4e76ec0ac2\",[2598],{\"_key\":2599,\"_type\":1930,\"marks\":2600,\"text\":2601},\"b2ea4f27d086\",[],\"One of Norway's leading movie production companies, Field Productions, joined some of Norway´s best skiers and snowboarders as they boarded the sailing yacht Varg S\\u002FY in Tromsø in February 2026.\",[],{\"_key\":2604,\"_type\":1926,\"children\":2605,\"markDefs\":2617,\"style\":1934},\"5cf3137050eb\",[2606,2610,2613],{\"_key\":2607,\"_type\":1930,\"marks\":2608,\"text\":2609},\"7ad05990f984\",[],\"This was the very first Ski & Sail adventure aboard Norrøna's new sailing yacht. In the breathtaking film \",{\"_key\":2611,\"_type\":1930,\"marks\":2612,\"text\":2589},\"d723e780d98a\",[2291],{\"_key\":2614,\"_type\":1930,\"marks\":2615,\"text\":2616},\"598d1edffdfd\",[],\", you'll join the search for untouched snow and potential first descents in the magnificent coastal mountains of Troms.\",[],{\"_key\":2619,\"_type\":1926,\"children\":2620,\"markDefs\":2625,\"style\":1934},\"b26e176962af\",[2621],{\"_key\":2622,\"_type\":1930,\"marks\":2623,\"text\":2624},\"14a14c7888ba\",[],\"Packed with adventure, spectacular scenery, and unforgettable skiing, this film captures Northern Norway at its wildest!\",[],{\"_key\":2627,\"_type\":1926,\"children\":2628,\"markDefs\":2633,\"style\":2463},\"9fabe256521c\",[2629],{\"_key\":2630,\"_type\":1930,\"marks\":2631,\"text\":2632},\"0c9571876a4d\",[],\"Win Amazing Prizes – Including a Stay for Two at Andørja Lodge!\",[],{\"_key\":2635,\"_type\":1926,\"children\":2636,\"markDefs\":2641,\"style\":1934},\"870511d08895\",[2637],{\"_key\":2638,\"_type\":1930,\"marks\":2639,\"text\":2640},\"497806d6c5f1\",[],\"We'll draw one lucky winner of a free Norrøna product from everyone attending this event.\",[],{\"_key\":2643,\"_type\":1926,\"children\":2644,\"markDefs\":2649,\"style\":1934},\"e6cfe61ab992\",[2645],{\"_key\":2646,\"_type\":1930,\"marks\":2647,\"text\":2648},\"4a22f55c4593\",[],\"But that's not all!\",[],{\"_key\":2651,\"_type\":1926,\"children\":2652,\"markDefs\":2657,\"style\":1934},\"ffd231602a30\",[2653],{\"_key\":2654,\"_type\":1930,\"marks\":2655,\"text\":2656},\"0eca4a657e9c\",[2135],\"Everyone attending our Arctic Voyage events this fall – in Norway and around the world – will also be entered into one grand prize drawing: A stay for two at the brand-new Norrøna Andørja Lodge in summer 2027!\",[],{\"_key\":2659,\"_type\":1926,\"children\":2660,\"markDefs\":2665,\"style\":1934},\"cad4ccbc56eb\",[2661],{\"_key\":2662,\"_type\":1930,\"marks\":2663,\"text\":2664},\"5605f4d827cb\",[],\"The grand prize winner will be selected from participants across all our Arctic Voyage events after the fall event series concludes in December.\",[],{\"_key\":2667,\"_type\":1926,\"children\":2668,\"markDefs\":2673,\"style\":1934},\"d45ba6bf982e\",[2669],{\"_key\":2670,\"_type\":1930,\"marks\":2671,\"text\":2672},\"caa7f719a649\",[],\"The lucky winner can bring a friend or loved one to experience our new adventure lodge in the North.\",[],{\"_key\":2675,\"_type\":1926,\"children\":2676,\"markDefs\":2681,\"style\":1934},\"b42db89c3c4a\",[2677],{\"_key\":2678,\"_type\":1930,\"marks\":2679,\"text\":2680},\"b3f0659761a9\",[2291],\"Round-trip travel to and from Harstad\\u002FNarvik Airport, Evenes, Norway, must be arranged and paid for by the winner and their guest.\",[],{\"_key\":2683,\"_type\":1926,\"children\":2684,\"markDefs\":2689,\"style\":1934},\"409eaeb3c3f0\",[2685],{\"_key\":2686,\"_type\":1930,\"marks\":2687,\"text\":2688},\"aad22db614aa\",[2135],\"Secure Your Spot – and Let Your Next Adventure Begin!\",[],{\"_key\":2691,\"_type\":2692},\"practical-info\",\"practicalInfo\",{\"_key\":2694,\"_type\":2296,\"image\":2695},\"6d92893651f4\",{\"_type\":1821,\"mediaItems\":2696},[2697,2723,2747],{\"_key\":2698,\"_type\":1721,\"altText\":2699,\"center\":2702,\"description\":2718,\"height\":2719,\"id\":2698,\"name\":2720,\"pathCdn\":2721,\"type\":1748,\"width\":2722},\"1DqFAz3ti7EdoomUgcQz4uvbaO3QD2Tax-4f29ca2609b06542ff14cb7ed42f9c70.jpg\",[2700],{\"_key\":1874,\"_type\":1897,\"language\":1874,\"value\":2701},\"Two smiling men on a boat wearing Norrøna jackets and life vests. Water and mountains are in the background.\",[2703,2708,2713],{\"_key\":2704,\"_type\":1829,\"aspectRatio\":34,\"bottomRightX\":2705,\"bottomRightY\":2066,\"fileId\":2698,\"id\":2706,\"isManual\":84,\"topLeftX\":2707,\"topLeftY\":1727},\"202621\",0.8156,202621,0.15,{\"_key\":2709,\"_type\":1829,\"aspectRatio\":46,\"bottomRightX\":1742,\"bottomRightY\":2710,\"fileId\":2698,\"id\":2711,\"isManual\":84,\"topLeftX\":1727,\"topLeftY\":2712},\"202622\",0.8756,202622,0