lmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"HOX1-85-HO00006204\"}],\"relatedData\":{\"sites\":[{\"id\":\"HOX1\",\"name\":{\"text\":\"Hoxton\",\"translations\":[]},\"location\":{\"latitude\":51.529,\"longitude\":-0.0837},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"55 Pitfield Street,\",\"line2\":\"London,\",\"city\":\"N1 6BU\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006099\",\"title\":{\"text\":\"The Ballad of Wallis Island\",\"translations\":[]},\"synopsis\":{\"text\":\"Eccentric lottery winner Charles dreams of getting his favorite musicians, McGwyer Mortimer, back together. The fantasy becomes real when the bandmates and former lovers agree to play a private show at his home on Wallis Island. Old tensions resurface as Charles tries desperately to salvage his dream gig.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Eccentric lottery winner Charles dreams of getting his favorite musicians, McGwyer Mortimer, back together. \",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"moderate bad language\",\"translations\":[]},\"releaseDate\":\"2025-05-30\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=T9smxlnKNz0\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003501\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003970\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004380\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011120\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011121\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011122\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011123\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4c563f44-cfa4-4914-86b1-b510771045c8\",\"corporateId\":null},\"hopk\":\"HO00006099\",\"hoCode\":\"A000007519\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006286\",\"title\":{\"text\":\"Kids Club: Turbo\",\"translations\":[]},\"synopsis\":{\"text\":\"After a freak accident infuses him with the power of super-speed, Turbo kicks into overdrive and embarks on an extraordinary journey to achieve the seemingly impossible: competing in the world's fastest race, the Indianapolis 500. With the help of his tricked-out streetwise snail crew, this ultimate underdog puts his heart and shell on the line to prove that no dream is too big, and no dreamer too small.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A freak accident might just help an everyday garden snail achieve his biggest dream: winning the Indy 500. \",\"translations\":[]},\"censorRatingId\":\"HO00000001\",\"censorRatingNote\":{\"text\":\"Contains mild threat\",\"translations\":[]},\"releaseDate\":\"2013-10-17\",\"runtimeInMinutes\":92,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000301\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000621\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000681\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001010\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001028\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002664\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002680\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011688\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000003\",\"0000000007\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5b5d7013-c65f-46b2-8d30-cb40478a5a0c\",\"corporateId\":null},\"hopk\":\"HO00006286\",\"hoCode\":\"A000007755\",\"eventId\":null,\"distributorName\":\"Park Circus\"},{\"id\":\"HO00006204\",\"title\":{\"text\":\"28 Years Later\",\"translations\":[]},\"synopsis\":{\"text\":\"Academy Award®-winning director Danny Boyle and Academy Award®-nominated writer Alex Garland reunite for 28 Years Later, a terrifying new story set in the world created by 28 Days Later. It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine, some have found ways to exist amidst the infected. One such group of survivors lives on a small island connected to the mainland by a single, heavily-defended causeway. When one of the group leaves the island on a mission into the dark heart of the mainland, he discovers secrets, wonders, and horrors that have mutated not only the infected but other survivors as well.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine...\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-19\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=poEFz8Ivzug\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000313\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001100\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001270\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003206\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003678\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010558\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011257\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000011418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011419\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a7823fd3-66f7-47af-87ba-d36ef45b168c\",\"corporateId\":null},\"hopk\":\"HO00006204\",\"hoCode\":\"A000007660\",\"eventId\":null,\"distributorName\":\"Sony Pictures\"},{\"id\":\"HO00006215\",\"title\":{\"text\":\"Ran (40th Anniversary)\",\"translations\":[]},\"synopsis\":{\"text\":\"In Medieval Japan, an elderly warlord retires, handing over his empire to his three sons. However, he vastly underestimates how the new-found power will corrupt them and cause them to turn on each other...and him.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In Medieval Japan, an elderly warlord retires, handing over his empire to his three sons. However, he vastly underestimates how the new-found power will corrupt them.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong bloody violence\",\"translations\":[]},\"releaseDate\":\"2025-06-27\",\"runtimeInMinutes\":161,\"trailerUrl\":null,\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003969\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009033\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011481\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011482\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011483\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011484\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011485\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011486\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011487\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011488\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"83bc0a5a-d0fb-424a-90e7-a799ebf5230e\",\"corporateId\":null},\"hopk\":\"HO00006215\",\"hoCode\":\"A000007671\",\"eventId\":null,\"distributorName\":\"Studio Canal\"},{\"id\":\"HO00006110\",\"title\":{\"text\":\"F1® The Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career. Thirty years later, he’s a nomadic racer-for-hire when he’s approached by his former teammate Ruben Cervantes (Javier Bardem), owner of a struggling FORMULA 1 team that is on the verge of collapse. Ruben convinces Sonny to come back to FORMULA 1 for one last shot at saving the team and being the best in the world. He’ll drive alongside Joshua Pearce (Damson Idris), the team's hotshot rookie intent on setting his own pace. But as the engines roar, Sonny’s past catches up with him and he finds that in FORMULA 1, your teammate is your fiercest competition—and the road to redemption is not something you can travel alone.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate threat\",\"translations\":[]},\"releaseDate\":\"2025-06-25\",\"runtimeInMinutes\":156,\"trailerUrl\":\"https://www.youtube.com/watch?v=TZGY2CWPXeU\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000166\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000167\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001693\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002986\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003190\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003191\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008544\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008790\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011188\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"90334335-0de9-4985-8924-9942f4379b60\",\"corporateId\":null},\"hopk\":\"HO00006110\",\"hoCode\":\"A000007