            "text": "{\"businessDate\":\"2025-08-02\",\"showtimes\":[{\"id\":\"HOX1-22149\",\"schedule\":{\"businessDate\":\"2025-08-02\",\"startsAt\":\"2025-08-02T10:30:00+01:00\",\"endsAt\":\"2025-08-02T12:24:00+01:00\",\"filmStartsAt\":\"2025-08-02T10:55:00+01:00\",\"filmEndsAt\":\"2025-08-02T12:24:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"HOX1-3-6\",\"filmId\":\"HO00006163\",\"siteId\":\"HOX1\",\"screenId\":\"HOX1-3\",\"areaCategories\":[{\"areaCategoryId\":\"HOX1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000004\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"HOX1\",\"name\":{\"text\":\"Hoxton\",\"translations\":[]},\"location\":{\"latitude\":51.529,\"longitude\":-0.0837},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"55 Pitfield Street,\",\"line2\":\"London,\",\"city\":\"N1 6BU\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006163\",\"title\":{\"text\":\"Kids Club: Dog Man\",\"translations\":[]},\"synopsis\":{\"text\":\"From DreamWorks Animation—creators of the beloved blockbuster franchises Kung Fu Panda, How to Train Your Dragon and The Boss Baby—comes the canine-crime-fighting film adaptation of Dav Pilkey’s New York Times bestselling literary phenomenon: Dog Man.\\n\\nWhen a faithful police dog and his human police officer owner are injured together on the job, a harebrained but life-saving surgery fuses the two of them together and Dog Man is born. Dog Man is sworn to protect and serve—and fetch, sit and roll over.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When a faithful police dog and his human police officer owner are injured together on the job, a harebrained but life-saving surgery fuses the two of them together.\",\"translations\":[]},\"censorRatingId\":\"HO00000001\",\"censorRatingNote\":{\"text\":\"ver