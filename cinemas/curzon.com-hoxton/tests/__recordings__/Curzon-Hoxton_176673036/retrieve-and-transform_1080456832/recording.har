\":{\"text\":\"It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine...\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-19\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=poEFz8Ivzug\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000313\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001100\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001270\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003206\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003678\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010558\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011257\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000011418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011419\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a7823fd3-66f7-47af-87ba-d36ef45b168c\",\"corporateId\":null},\"hopk\":\"HO00006204\",\"hoCode\":\"A000007660\",\"eventId\":null,\"distributorName\":\"Sony Pictures\"},{\"id\":\"HO00006215\",\"title\":{\"text\":\"Ran (40th Anniversary)\",\"translations\":[]},\"synopsis\":{\"text\":\"In Medieval Japan, an elderly warlord retires, handing over his empire to his three sons. However, he vastly underestimates how the new-found power will corrupt them and cause them to turn on each other...and him.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In Medieval Japan, an elderly warlord retires, handing over his empire to his three sons. However, he vastly underestimates how the new-found power will corrupt them.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong bloody violence\",\"translations\":[]},\"releaseDate\":\"2025-06-27\",\"runtimeInMinutes\":161,\"trailerUrl\":null,\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003969\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009033\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011481\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011482\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011483\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011484\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011485\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011486\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011487\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011488\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"83bc0a5a-d0fb-424a-90e7-a799ebf5230e\",\"corporateId\":null},\"hopk\":\"HO00006215\",\"hoCode\":\"A000007671\",\"eventId\":null,\"distributorName\":\"Studio Canal\"},{\"id\":\"HO00006110\",\"title\":{\"text\":\"F1® The Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career. Thirty years later, he’s a nomadic racer-for-hire when he’s approached by his former teammate Ruben Cervantes (Javier Bardem), owner of a struggling FORMULA 1 team that is on the verge of collapse. Ruben convinces Sonny to come back to FORMULA 1 for one last shot at saving the team and being the best in the world. He’ll drive alongside Joshua Pearce (Damson Idris), the team's hotshot rookie intent on setting his own pace. But as the engines roar, Sonny’s past catches up with him and he finds that in FORMULA 1, your teammate is your fiercest competition—and the road to redemption is not something you can travel alone.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate threat\",\"translations\":[]},\"releaseDate\":\"2025-06-25\",\"runtimeInMinutes\":156,\"trailerUrl\":\"https://www.youtube.com/watch?v=TZGY2CWPXeU\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000166\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000167\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001693\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002986\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003190\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003191\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008544\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008790\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011188\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"90334335-0de9-4985-8924-9942f4379b60\",\"corporateId\":null},\"hopk\":\"HO00006110\",\"hoCode\":\"A000007538\",\"eventId\":null,\"distributorName\":\"Warners\"}],\"castAndCrew\":[{\"id\":\"0000000313\",\"name\":{\"givenName\":\"Andrew \",\"familyName\":\"Macdonald\",\"middleName\":null}},{\"id\":\"0000001100\",\"name\":{\"givenName\":\"Jodie\",\"familyName\":\"Comer\",\"middleName\":null}},{\"id\":\"0000001270\",\"name\":{\"givenName\":\"Ralph\",\"familyName\":\"Fiennes\",\"middleName\":null}},{\"id\":\"0000003206\",\"name\":{\"givenName\":\"Alex\",\"familyName\":\"Garland\",\"middleName\":null}},{\"id\":\"0000003678\",\"name\":{\"givenName\":\"Aaron\",\"familyN