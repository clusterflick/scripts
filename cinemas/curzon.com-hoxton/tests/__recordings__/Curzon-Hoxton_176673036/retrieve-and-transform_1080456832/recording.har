            "text": "{\"name\":\"Hoxton\",\"urlSegment\":\"hoxton\",\"url\":\"/venues/hoxton/\",\"nodeId\":1805,\"alias\":\"cinema\",\"createDate\":\"2024-08-13T14:57:42\\u002B01:00\",\"updateDate\":\"2025-06-24T08:23:05\\u002B01:00\",\"robotsNoIndex\":false,\"robotsNoFollow\":false,\"masterCanonicalUrl\":null,\"excludeCanonicalUrl\":false,\"seoImage\":null,\"metaKeywords\":\"\",\"metaDescription\":\"Find out what\\u0027s on at Curzon Cinema in Hoxton. Check out the latest blockbuster movies, new Indie film releases and the best of world cinema out now.\",\"seoPageTitle\":\"Curzon Hoxton Cinema Showtimes \\u0026 Film Listings\",\"oGType\":\"\",\"twitterCard\":\"\",\"seoUrl\":\"\",\"oGLocale\":\"\",\"excludeFromXmlSitemap\":false,\"excludeFromSiteSearch\":false,\"pageTitle\":\"Curzon Hoxton Cinema Showtimes \\u0026 Film Listings\",\"hideTitle\":false,\"grid\":[],\"redirectDetailsElement\":{\"redirect\":false,\"permanent\":false},\"heroCarouselDetailsElement\":[{\"image\":{\"mobile\":\"/media/vz1o04xa/hoxton3.jpg?width=393\\u0026height=169\\u0026v=1dba25ace9c55b0\",\"tablet\":\"/media/vz1o04xa/hoxton3.jpg?width=782\\u0026height=315\\u0026v=1dba25ace9c55b0\",\"desktop\":\"/media/vz1o04xa/hoxton3.jpg?width=1216\\u0026height=523\\u0026v=1dba25ace9c55b0\",\"alt\":\"\"},\"textHeading\":\"WELCOME TO CURZON HOXTON\",\"actionLink\":{\"name\":\"take a tour\",\"target\":\"_blank\",\"url\":\"https://tours.360virtualtours.co.uk/curzon/hoxton/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=393\\u0026height=169\\u0026v=1dbe4e025633ef0\",\"tablet\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=782\\u0026height=315\\u0026v=1dbe4e025633ef0\",\"desktop\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=1216\\u0026height=523\\u0026v=1dbe4e025633ef0\",\"alt\":\"\"},\"textHeading\":\"Support Stonewall on your Curzon cinema visit\",\"actionLink\":{\"name\":\"FIND OUT MORE\",\"url\":\"https://www.curzon.com/charity/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/pjsj0oss/pepperoni.jpg?width=393\\u0026height=169\\u0026v=1daf1d80a3f4700\",\"tablet\":\"/media/pjsj0oss/pepperoni.jpg?width=782\\u0026height=315\\u0026v=1daf1d80a3f4700\",\"desktop\":\"/media/pjsj0oss/pepperoni.jpg?width=1216\\u0026height=523\\u0026v=1daf1d80a3f4700\",\"alt\":\"\"},\"textHeading\":\"Food and drink\",\"actionLink\":{\"name\":\"View Menu\",\"target\":\"_blank\",\"url\":\"https://www.curzon.com/media/j4gbe2nc/menu-1.pdf\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/u1tpev4b/ph-hoxton.jpg?width=393\\u0026height=169\\u0026v=1dba25ae5092620\",\"tablet\":\"/media/u1tpev4b/ph-hoxton.jpg?width=782\\u0026height=315\\u0026v=1dba25ae5092620\",\"desktop\":\"/media/u1tpev4b/ph-hoxton.jpg?width=1216\\u0026height=523\\u0026v=1dba25ae5092620\",\"alt\":\"\"},\"textHeading\":\"HIRE THIS SPACE\",\"actionLink\":{\"name\":\"CONTACT US\",\"url\":\"/private-hire/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/325huqma/hoxton4.jpg?width=393\\u0026height=169\\u0026v=1dba25af4242f10\",\"tablet\":\"/media/325huqma/hoxton4.jpg?width=782\\u0026height=315\\u0026v=1dba25af4242f10\",\"desktop\":\"/media/325huqma/hoxton4.jpg?width=1216\\u0026height=523\\u0026v=1dba25af4242f10\",\"alt\":\"\"}},{\"image\":{\"mobile\":\"/media/yzehnils/cocktail-image.webp?width=393\\u0026height=169\\u0026v=1daf1d80a3a3df0\",\"tablet\":\"/media/yzehnils/cocktail-image.webp?width=782\\u0026height=315\\u0026v=1daf1d80a3a3df0\",\"desktop\":\"/media/yzehnils/cocktail-image.webp?width=1216\\u0026height=523\\u0026v=1daf1d80a3a3df0\",\"alt\":\"\"}},{\"image\":{\"mobile\":\"/media/3cep3bof/hoxton1.jpg?width=393\\u0026height=169\\u0026v=1dba25b07f5bb30\",\"tablet\":\"/media/3cep3bof/hoxton1.jpg?width=782\\u0026height=315\\u0026v=1dba25b07f5bb30\",\"desktop\":\"/media/3cep3bof/hoxton1.jpg?width=1216\\u0026height=523\\u0026v=1dba25b07f5bb30\",\"alt\":\"\"}}],\"cinemaLocationDetailsElement\":{\"venueCardImage\":{\"mobile\":\"/media/20gmcxgg/cinema-venues-_hoxton.jpg?width=300\\u0026height=160\\u0026v=1db998942762590\",\"alt\":\"\"},\"addressLine1\":\"55 Pitfield St\",\"city\":\"London\",\"postcode\":\"N1 6BU\",\"nearestStationName\":\"Hoxton\",\"nearestStationType\":\"national-rail\"},\"vistaCinema\":{\"key\":\"HOX1\",\"value\":\"Hoxton\"},\"informationTabAccordions\":[{\"heading\":\"Opening times\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EMonday to Saturday:\\u003C/strong\\u003E The cinema opens 30 minutes before the first show\\u0027s programme begins and closes at midnight.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESunday:\\u003C/strong\\u003E Closes at 11.30pm.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cem\\u003EPlease be aware opening and closing times may be subject to change.\\u003C/em\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Screen info\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 1\\u003Cbr\\u003E\\u003C/strong\\u003E119 seats, 2 wheelchair spaces\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 2\\u003Cbr\\u003E\\u003C/strong\\u003E66 seats, 2 wheelchair spaces\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 3\\u003Cbr\\u003E\\u003C/strong\\u003E60 seats, 2 wheelchair spaces\\u003C/p\\u003E\"},{\"heading\":\"Accessibility\",\"body\":\"\\u003Cp\\u003EAll screens are accessible by lift, and each one has two wheelchair spaces. There is a wheelchair-accessible bathroom.\\u003C/p\\u003E\\n\\u003Cp\\u003EAudio Description and hearing-assist headsets are available on request.\\u003C/p\\u003E\"},{\"heading\":\"Food and Drink\",\"body\":\"\\u003Cp\\u003EFresh coffee, teas and pastries alongside an all day menu of pizza and bar food with vegan and vegetarian options available. The drinks menu includes a wide selection of cocktails, wine, craft beer and soft drinks.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022https://www.curzon.com/media/j4gbe2nc/menu-1.pdf\\u0022 target=\\u0022_blank\\u0022 title=\\u0022View Menu\\u0022\\u003ESee our full menu here.\\u003C/a\\u003E\\u003C/span\\u003E\\u003C/p\\u003E\"},{\"heading\":\"HAPPY HOUR INFORMATION\",\"body\":\"\\u003Cp\\u003EAt this venue Happy Hour is 5pm to 10pm every day, 2 for \\u00A316 on all cocktails.\\u003C/p\\u003E\"},{\"heading\":\"Private hires\",\"body\":\"\\u003Cp\\u003EOur screens are available to rent for your private functions, email \\u003Ca href=\\u0022mailto:privatehires@curzon.com\\u0022 title=\\u0022Email private hires\\u0022\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003Eprivatehires@curzon.com\\u003C/span\\u003E\\u003C/a\\u003E for more information.\\u003C/p\\u003E\\n\\u003Cp\\u003ETo find out more, visit our \\u003Ca href=\\u0022https://www.curzon.com/private-hire/hoxton/\\u0022 title=\\u0022Hoxton Private Hires\\u0022\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003EPrivate Hires page\\u003C/span\\u003E.\\u003C/a\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Social Media\",\"body\":\"\\u003Cp\\u003EInstagram: \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022https://www.instagram.com/curzonhoxton?igsh=MWd0MWIxa3BmbzZ6ZQ==\\u0022 target=\\u0022_blank\\u0022 title=\\u0022Curzon Hoxton Instagram\\u0022 data-anchor=\\u0022?igsh=MWd0MWIxa3BmbzZ6ZQ==\\u0022\\u003Ecurzonhoxton\\u003C/a\\u003E\\u003C/span\\u003E\\u003C/p\\u003E\"}],\"informationTabDescription\":\"\\u003Cp\\u003ELocated just off Old Street roundabout, Curzon Hoxton is a thoroughly modern east-London venue with an all-encompassing programme. Its striking minimalist design \\u2013 as evidenced in its inviting ground-floor caf\\u00E9 \\u2013 showcases the beauty of natural materials, and the three screening rooms boast front-seat recliners for endless comfort.\\u003C/p\\u003E\",\"menuTabAccordions\":[{\"heading\":\"Pizza\",\"body\":\"\\u003Ctable border=\\u00221\\u0022 style=\\u0022border-collapse: collapse; width: 100%; height: 382px;\\u0022\\u003E\\n\\u003Ctbody\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EMargherita (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A311.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EPepperoni \\u0026amp; Honey\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003E\\u0027Nduja\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EGoat\\u0027s Cheese \\u0026amp; Caramelised Onion (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.80\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EMushroom \\u0026amp; Truffle Oil (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.80\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EVegan Margherita (Vg)\\u003C/td\\u003E\\n\\u00