          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-13\",\"showtimes\":[{\"id\":\"HOX1-28530\",\"schedule\":{\"businessDate\":\"2026-08-13\",\"startsAt\":\"2026-08-13T18:00:00+01:00\",\"endsAt\":\"2026-08-13T19:53:00+01:00\",\"filmStartsAt\":\"2026-08-13T18:25:00+01:00\",\"filmEndsAt\":\"2026-08-13T19:53:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"HOX1-3-6\",\"filmId\":\"HO00007219\",\"siteId\":\"HOX1\",\"screenId\":\"HOX1-3\",\"areaCategories\":[{\"areaCategoryId\":\"HOX1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"HOX1\",\"name\":{\"text\":\"Hoxton\",\"translations\":[]},\"location\":{\"latitude\":51.5289993286133,\"longitude\":-0.0837000012397766},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"HOX1@curzon.com\",\"address\":{\"line1\":\"55 Pitfield Street,\",\"line2\":\"London,\",\"city\":\"N1 6BU\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007219\",\"title\":{\"text\":\"Curzon Film 50: Cold War\",\"translations\":[]},\"synopsis\":{\"text\":\"Paweł Pawlikowski follows his Oscar-winning Ida with the stunning Cold War, an epic romance set against the backdrop of Europe after World War II. Sumptuously shot in luminous black and white, it spans decades and nations to tell a love story that is as tragic as it is moving, and as transportive as it is honest.\\n\\nIn the ruins of post-war Poland, Wiktor (Tomasz Kot) and Zula (Joanna Kulig) fall deeply, obsessively and destructively in love. As performing musicians forced to play into the Soviet propaganda machine, they dream of escaping to the creative freedom of the West. But one day, as they spot their chance to make a break for Paris, both make a split decision that will mark their lives forever. As the years march on in the wake of that moment, Wiktor and Zula watch the world changing around them, always struggling to find their moment in time.\\n\\nWinner of the Best Director award at the Cannes Film Festival 2018, Pawlikowski melds the personal with the political to exquisite effect. Set to a soundtrack that takes you from the rustic folk songs of rural Poland to the sultry jazz of a Paris basement bar, it’s a wistful and dreamlike journey through a divided continent – and a heartbreaking portrait of ill-fated love.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A passionate love story between two people of different backgrounds and temperaments, who are fatally mismatched, set against the background of the Cold War in the 1950s.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"Strong language\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":88,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=BvPkDdFeTk8\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=BvPkDdFeTk8\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002100\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004635\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009917\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010070\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010071\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000102\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000796\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000797\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000009917\"},{\"castAndCrewMemberId\":\"0000010070\"},{\"castAndCrewMemberId\":\"HO00000102\"},{\"castAndCrewMemberId\":\"HO00000796\"},{\"castAndCrewMemberId\":\"HO00000797\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000010071\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000002100\"},{\"cas