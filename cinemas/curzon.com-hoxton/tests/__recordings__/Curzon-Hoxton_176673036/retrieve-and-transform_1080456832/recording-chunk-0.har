,\"filmAdvanceBookingRuleId\":\"HOX1-124-HO00006951\"},{\"id\":\"HOX1-28449\",\"schedule\":{\"businessDate\":\"2026-07-11\",\"startsAt\":\"2026-07-11T21:20:00+01:00\",\"endsAt\":\"2026-07-11T23:31:00+01:00\",\"filmStartsAt\":\"2026-07-11T21:45:00+01:00\",\"filmEndsAt\":\"2026-07-11T23:31:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"HOX1-1-7\",\"filmId\":\"HO00007147\",\"siteId\":\"HOX1\",\"screenId\":\"HOX1-1\",\"areaCategories\":[{\"areaCategoryId\":\"HOX1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"HOX1\",\"name\":{\"text\":\"Hoxton\",\"translations\":[]},\"location\":{\"latitude\":51.5289993286133,\"longitude\":-0.0837000012397766},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"HOX1@curzon.com\",\"address\":{\"line1\":\"55 Pitfield Street,\",\"line2\":\"London,\",\"city\":\"N1 6BU\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00006931\",\"title\":{\"text\":\"Disclosure Day\",\"translations\":[]},\"synopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming close to … Disclosure Day.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-10\",\"runtimeInMinutes\":145,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/920be864-1bc7-4cfd-aa64-b828b3c90b38/media/TrailerVideo\"},{\"provider\":\"Externa