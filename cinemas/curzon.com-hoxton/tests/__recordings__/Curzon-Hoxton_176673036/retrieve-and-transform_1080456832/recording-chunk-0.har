            "text": "{\"businessDate\":\"2026-09-10\",\"showtimes\":[{\"id\":\"HOX1-28534\",\"schedule\":{\"businessDate\":\"2026-09-10\",\"startsAt\":\"2026-09-10T18:00:00+01:00\",\"endsAt\":\"2026-09-10T19:55:00+01:00\",\"filmStartsAt\":\"2026-09-10T18:25:00+01:00\",\"filmEndsAt\":\"2026-09-10T19:55:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"HOX1-3-6\",\"filmId\":\"HO00007231\",\"siteId\":\"HOX1\",\"screenId\":\"HOX1-3\",\"areaCategories\":[{\"areaCategoryId\":\"HOX1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"HOX1\",\"name\":{\"text\":\"Hoxton\",\"translations\":[]},\"location\":{\"latitude\":51.5289993286133,\"longitude\":-0.0837000012397766},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"HOX1@curzon.com\",\"address\":{\"line1\":\"55 Pitfield Street,\",\"line2\":\"London,\",\"city\":\"N1 6BU\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007231\",\"title\":{\"text\":\"Curzon Film 50: Orlando\",\"translations\":[]},\"synopsis\":{\"text\":\"In 1600, nobleman Orlando (Tilda Swinton) inherits his parents' house, thanks to Queen Elizabeth I (Quentin Crisp), who commands the young man to never change. After a disastrous affair with Russian princess Sasha (Charlotte Valandrey), Orlando looks for solace in the arts before being appointed ambassador to Constantinople in 1700, where war is raging. One morning, Orlando is shocked to wake up as a woman and returns home, struggling as a female to retain her property as the centuries roll by.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After Queen Elizabeth I commands him not to grow old, a young nobleman struggles with love and his place in the world.\",\"translations\":[]},\"censorRatin