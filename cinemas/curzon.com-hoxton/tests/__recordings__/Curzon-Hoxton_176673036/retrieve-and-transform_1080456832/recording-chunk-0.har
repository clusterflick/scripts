          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-20\",\"showtimes\":[{\"id\":\"HOX1-28531\",\"schedule\":{\"businessDate\":\"2026-08-20\",\"startsAt\":\"2026-08-20T18:00:00+01:00\",\"endsAt\":\"2026-08-20T20:04:00+01:00\",\"filmStartsAt\":\"2026-08-20T18:25:00+01:00\",\"filmEndsAt\":\"2026-08-20T20:04:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"HOX1-3-6\",\"filmId\":\"HO00007216\",\"siteId\":\"HOX1\",\"screenId\":\"HOX1-3\",\"areaCategories\":[{\"areaCategoryId\":\"HOX1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"HOX1\",\"name\":{\"text\":\"Hoxton\",\"translations\":[]},\"location\":{\"latitude\":51.5289993286133,\"longitude\":-0.0837000012397766},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"HOX1@curzon.com\",\"address\":{\"line1\":\"55 Pitfield Street,\",\"line2\":\"London,\",\"city\":\"N1 6BU\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007216\",\"title\":{\"text\":\"Curzon Film 50: Babette's Feast\",\"translations\":[]},\"synopsis\":{\"text\":\"When Babette, a beautiful and mysterious French refugee, arrives in a remote Danish town, the tight-knit, puritanical community begrudgingly let her in, providing her with shelter and work. But after the town patriarch passes away and Babette insists on preparing a feast in his honour, a magical world of sensory revelations is thrown open to the villagers, changing their lives forever..\\n\\nEvoking the work of other great Scandinavian directors such as Ingmar Bergman and Carl Theodor Dreyer, but with a uniquely joyous, exuberant touch, this 1988 Oscar for Best Foreign Language Film winning tale of everyday passion - of the human capacity to create and to love - is a mouthwatering ode to the glory of life from one of cinema's true originals.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"During the late 19th century, a strict religious community in a Danish village takes in a French refugee from the Franco-Prussian War as a servant to the late pastor.\",\"translations\":[]},\"censorRatingId\":\"HO00000001\",\"censorRatingNote\":{\"text\":\"Contains no material likely to offend or harm\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":99,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=AgxXGnuoTk8\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=AgxXGnuoTk8\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003966\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006705\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007143\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007179\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007180\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007181\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007182\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007183\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000007184\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000007185\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000003966\"},{\"castAndCrewMemberId\":\"0000006705\"},{\"castAndCrewMemberId\":\"0000007143\"},{\"castAndCrewMemberId\":\"0000007179\"},{\"castAndCrewMemberId\":\"0000007180\"},{\"castAndCrewMemberId\":\"0000007181\"},{\"castAndCrewMemberId\":\"0000007182\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000007183\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000007184\"},{\"castAndCrewMemberId\":\"0000007185\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007216\",\"hoCode\":\"A000008878\",\"eventId\":\"0000000068\",\"distributorName\":\"Curzon\"}],\"castA