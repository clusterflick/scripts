            "text": "{\"businessDate\":\"2026-09-03\",\"showtimes\":[{\"id\":\"HOX1-28533\",\"schedule\":{\"businessDate\":\"2026-09-03\",\"startsAt\":\"2026-09-03T18:00:00+01:00\",\"endsAt\":\"2026-09-03T20:24:00+01:00\",\"filmStartsAt\":\"2026-09-03T18:25:00+01:00\",\"filmEndsAt\":\"2026-09-03T20:24:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"HOX1-3-6\",\"filmId\":\"HO00007229\",\"siteId\":\"HOX1\",\"screenId\":\"HOX1-3\",\"areaCategories\":[{\"areaCategoryId\":\"HOX1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"HOX1\",\"name\":{\"text\":\"Hoxton\",\"translations\":[]},\"location\":{\"latitude\":51.5289993286133,\"longitude\":-0.0837000012397766},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"HOX1@curzon.com\",\"address\":{\"line1\":\"55 Pitfield Street,\",\"line2\":\"London,\",\"city\":\"N1 6BU\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007229\",\"title\":{\"text\":\"Curzon Film 50: Only You\",\"translations\":[]},\"synopsis\":{\"text\":\"Elena (Laia Costa), 35, and Jake (Josh O'Connor), 26, meet by chance on New Year's Eve, fighting for the same taxi. But, instead of going their separate ways after a shared ride, they start a passionate relationship. Within weeks they are living together, and not long after they talk about starting a family.\\n\\nBut, as the seasons' pass, reality catches up with them. Falling in love was the easy part, but can they remain in love when life doesn’t give them everything they hoped for?\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Elena and Jake meet by chance on New Years' Eve, arguing for the same taxi, and start a passionate relationship.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"very strong language, strong sex\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":119,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=D6R_HGs4qgw\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=D6R_HGs4qgw\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000287\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000424\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003032\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000004337\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008293\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009184\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013195\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013543\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000821\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000822\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000823\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000824\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000825\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000008293\"},{\"castAndCrewMemberId\":\"0000013543\"},{\"castAndCrewMemberId\":\"HO00000821\"},{\"castAndCrewMemberId\":\"HO00000822\"},{\"castAndCrewMemberId\":\"HO00000823\"},{\"castAndCrewMemberId\":\"HO00000824\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000003032\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000000287\"},{\"castAndCrewMemberId\":\"0000000424\"},{\"castAndCrewMemberId\":\"0000004337\"},{\"castAndCrewMemberId\":\"0000009184\"},{\"castAndCrewMemberId\":\"0000013195\"},{\"castAndCrewMemberId\":\"HO00000825\"}],\"genreIds\":[\"0000000002\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007229\",\"hoCode\":\"A000008893\",\"eventId\":\"0000000068\",\"distributorName\":\"Curzon\"}],\"c