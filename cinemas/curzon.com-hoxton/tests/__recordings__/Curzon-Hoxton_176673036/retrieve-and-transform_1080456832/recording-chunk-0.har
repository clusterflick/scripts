          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-03-04\",\"showtimes\":[{\"id\":\"HOX1-25856\",\"schedule\":{\"businessDate\":\"2026-03-04\",\"startsAt\":\"2026-03-04T18:20:00+00:00\",\"endsAt\":\"2026-03-04T20:04:00+00:00\",\"filmStartsAt\":\"2026-03-04T18:45:00+00:00\",\"filmEndsAt\":\"2026-03-04T20:04:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"HOX1-3-6\",\"filmId\":\"HO00006797\",\"siteId\":\"HOX1\",\"screenId\":\"HOX1-3\",\"areaCategories\":[{\"areaCategoryId\":\"HOX1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"HOX1\",\"name\":{\"text\":\"Hoxton\",\"translations\":[]},\"location\":{\"latitude\":51.529,\"longitude\":-0.0837},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"55 Pitfield Street,\",\"line2\":\"London,\",\"city\":\"N1 6BU\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006797\",\"title\":{\"text\":\"Film Club: Dreamers\",\"translations\":[]},\"synopsis\":{\"text\":\"After fleeing home, Nigerian migrant Isio (Ronk\u1eb9 Ad\u00e9k\u1ecdlu\u1eb9\u0301j\u1ecd\u0301) is sent to Hatchworth Removal Centre, where she hopes her asylum plea will receive a fair hearing. Isio believes the only way out is to play by the rules, convinced that presenting the truth about the homophobic persecution she experienced will secure her freedom. Her charismatic new roommate, Farah (Ann Akinjirin), warns her otherwise, having lost faith in a system she knows is stacked against them. \\n\\nDespite their differing outlooks, within the confines of detention Farah\u2019s friendship brings colour to Isio\u2019s world. As days turn into weeks, the two women form an unexpected bond that blossoms into romance, offering them reason to hope despite the waiting. But with Isio\u2019s case lingering in limbo and Farah\u2019s own appeals running out, the threat of separation grows ever closer. Isio must decide whether to continue trusting in a broken system that threatens to tear them apart or dare to follow Farah into a risky plan that could cost them everything.\\n\\nAcclaimed producer Joy Gharoro-Akpojotor\u2019s (Blue Story, Boxing Day) visually bold and deeply moving directorial debut is a tender story of defiance, which insists that love can endure even in the most hostile places.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In a UK immigration removal centre, Nigerian migrant Isio finds hope in an unexpected love that gives her the strength to fight a broken system.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong sex\",\"translations\":[]},\"releaseDate\":\"2026-03-04\",\"runtimeInMinutes\":79,\"trailerUrl\":\"https://www.youtube.com/watch?v=P68gG8qQCEw\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000425\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006002\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012631\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012632\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012633\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012634\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012635\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012636\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012637\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012638\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012639\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006797\",\"hoCode\":\"A000008386\",\"eventId\":null,\"distributorName\":\"We Are Parable\"}],\"castAndCrew\":[{\"id\":\"0000000425\",\"name\":{\"givenName\":\"Emily \",\"familyName\":\"Morgan\",\"middleName\":null}},{