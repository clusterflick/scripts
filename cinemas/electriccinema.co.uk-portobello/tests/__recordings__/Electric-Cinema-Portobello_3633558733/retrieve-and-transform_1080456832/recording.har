alse,\"link\":\"\\/tickets\\/10424\",\"message\":\"Please book by calling the Box Office on 020 7908 9696.\"},\"10434\":{\"id\":10434,\"film\":10432,\"d\":\"2025-09-07\",\"t\":\"13:00\",\"cinema\":603,\"st\":\"SE\",\"sn\":\"1\",\"r\":\"76\",\"bookable\":true,\"link\":\"\\/tickets\\/10434\",\"message\":\"\"},\"10435\":{\"id\":10435,\"film\":10432,\"d\":\"2025-09-08\",\"t\":\"10:30\",\"cinema\":603,\"st\":\"ES\",\"sn\":\"1\",\"r\":\"76\",\"bookable\":false,\"link\":\"\\/tickets\\/10435\",\"message\":\"This screening is not bookable from the website\"}},\"screeningsByDate\":{\"2025-08-01\":[9942,9943,9940,9941,9944,9919,9920],\"2025-08-02\":[9921,9939,9937,9938,9948,9949,9950,9945,9952,9947,9951,9946],\"2025-08-03\":[9719,9956,9957,9953,9954,9955,9958,9959,9960,9491,9922],\"2025-08-04\":[9923,9924,9926,9925,9965,9966,10040,10041,9963,9964],\"2025-08-05\":[9967,9968,9969,9972,9970,9971,9927,9928],\"2025-08-06\":[9977,9978,9973,9975,9976,9974,9929,9930],\"2025-08-07\":[9979,9980,9981,9983,9984,9982,9931,9932,9933],\"2025-08-08\":[10421],\"2025-08-10\":[9720,10420],\"2025-08-11\":[10422],\"2025-08-13\":[10132,9987],\"2025-08-14\":[9988,10131],\"2025-08-15\":[10119,10009],\"2025-08-16\":[10116,10117],\"2025-08-17\":[9721,9507],\"2025-08-18\":[10120,10121],\"2025-08-19\":[10122],\"2025-08-21\":[10133,9508],\"2025-08-22\":[10118],\"2025-08-28\":[9509],\"2025-08-29\":[10138,10139],\"2025-08-30\":[10423,10140,10141,10142,10134],\"2025-08-31\":[9510,10143,10144],\"2025-09-01\":[10145,10146,10147,10148],\"2025-09-02\":[10149,10150],\"2025-09-03\":[10151,10152],\"2025-09-04\":[10153,10135],\"2025-09-06\":[10424],\"2025-09-07\":[10434],\"2025-09-08\":[10435]},\"filmOrder\":[9739,8913,9270,620,9935,1154,9257,2355,9917,5449,10414,9985,2249,9496,9493,631,9497,10136,10413,3471,9495,10415,10432],\"filmOrderByCinema\":{\"603\":[8913,620,1154,9257,2355,9917,10414,9985,9496,9493,631,9497,10136,10413,3471,9495,10415,10432],\"602\":[9739,8913,9270,9935,1154,5449,2249]},\"attributeNotes\":[],\"screeningTypes\":{\"SE\":{\"title\":\"Electric Selects\",\"popup\":true,\"popupTitle\":\"Electric Selects\",\"popupText\":\"<p>A showcase of curated cinema, from recent releases to all-time cinematic classics, one-off performances and specially themed seasons back on the big screen at the Electrics.<\\/p>\\n\",\"menuOrder\":0,\"image\":\"https:\\/\\/www.electriccinema.co.uk\\/wp-content\\/uploads\\/2025\\/01\\/SELECTS-CREAM.png\",\"booking_intro_text\":\"\",\"booking_confirm_checkbox\":\"I understand that valid photo ID may be required for age restricted films. Failure to produce this when requested by cinema staff will result in being refused admission, without refund.\",\"showInBookingLink\":true},\"MF\":{\"title\":\"Main Feature\",\"popup\":true,\"popupTitle\":\"Main Feature\",\"popupText\":\"<p>Our main feature presentation programme across both Electric Cinemas.<\\/p>\\n\",\"menuOrder\":0,\"image\":\"https:\\/\\/www.electriccinema.co.uk\\/wp-content\\/uploads\\/2025\\/01\\/FEATURE-CREAM.png\",\"booking_intro_text\":\"\",\"booking_confirm_checkbox\":\"I understand that valid photo ID may be required for age restricted films. Failure to produce this when requested by cinema staff will result in being refused admission, without refund.\",\"showInBookingLink\":false},\"KC\":{\"title\":\"Electric Kids Club\",\"popup\":true,\"popupTitle\":\"Electric Kids Club\",\"popupText\":\"<p>Join us every Saturday at Portobello and Sunday at White City for discounted Childrens cinema, ranging from family classics to newer releases to introduce the kids to the magic of the movies. Electric House or Every House members can also claim 2 complimentary tickets for Kids Club screenings with each Adult ticket purchased (Applicable at Portobello only). Tickets for Portobello are only available by calling the box office on 02079089696.<\\/p>\\n<p>Please note, that adults who are unaccompanied by a child will not be admitted to Electric kids club performances.<\\/p>\\n\",\"menuOrder\":0,\"image\":\"https:\\/\\/www.electriccinema.co.uk\\/wp-content\\/uploads\\/2024\\/09\\/KC-CREAM.png\",\"booking_intro_text\":\"\",\"booking_confirm_checkbox\":\"I understand that adults purchasing tickets will not be admitted unless accompanied by a child.\",\"showInBookingLink\":false},\"ES\":{\"title\":\"Electric Scream!\",\"popup\":true,\"popupTitle\":\"Electric Scream!\",\"popupText\":\"<p>Weekly screenings of the latest releases to come along to with your baby (Under 2), with lower volume, subtitles and slightly raised lighting for a more relaxed feel so your little ones can be as loud as they want! Please note that unaccompanied adults will not be admitted to Electric Scream! performances. Please call the box office to book tickets on 02079089696.<\\/p>\\n\",\"menuOrder\":0,\"image\":\"https:\\/\\/www.electriccinema.co.uk\\/wp-content\\/uploads\\/2025\\/01\\/SCREAM-CREAM.png\",\"booking_intro_text\":\"\",\"booking_confirm_checkbox\":\"I understand that adults purchasing tickets for Electric Scream! screenings must be accompanied by a baby or they will not be admitted and that prams or buggies must be left outside the auditorium at Electric White City.\",\"showInBookingLink\":true},\"EA\":{\"title\":\"Electric Subtitled\",\"popup\":true,\"popupTitle\":\"Electric Subtitled\",\"popupText\":\"<div class=\\\"programme-filters__type-intro__text\\\">Weekly screenings of the latest releases with full captions for the hearing impaired.<\\/div>\\n\",\"menuOrder\":0,\"image\":\"https:\\/\\/www.electriccinema.co.uk\\/wp-content\\/uploads\\/2024\\/09\\/SUBTITLED-CREAM.png\",\"booking_intro_text\":\"\",\"booking_confirm_checkbox\":\"I understand that this is an Electric Subtitled screening for the hearing impaired and screenings will be shown with subtitles.\",\"showInBookingLink\":true}},\"id\":\"688c016eaf39f\",\"isMember\":false,\"messages\":[]}"
