          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-05-05\",\"showtimes\":[{\"id\":\"888-40281\",\"schedule\":{\"businessDate\":\"2026-05-05\",\"startsAt\":\"2026-05-05T18:00:00+01:00\",\"endsAt\":\"2026-05-05T22:30:00+01:00\",\"filmStartsAt\":\"2026-05-05T18:25:00+01:00\",\"filmEndsAt\":\"2026-05-05T22:30:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"888-3-66\",\"filmId\":\"HO00007284\",\"siteId\":\"888\",\"screenId\":\"888-3\",\"areaCategories\":[{\"areaCategoryId\":\"888-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"888-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"888\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4583,\"longitude\":-0.3052},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Richmond@odeonuk.com\",\"address\":{\"line1\":\"72 Hill Street\",\"line2\":\"\",\"city\":\"Richmond\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007284\",\"title\":{\"text\":\"The Met: Live in HD 2025-26 Season: Eugene Oneg\",\"translations\":[]},\"synopsis\":{\"text\":\"Following her acclaimed 2024 company debut in Puccini’s Madama Butterfly, soprano Asmik Grigorian returns to the Met as Tatiana, the lovestruck young heroine in this ardent operatic adaptation of Pushkin, which will be transmitted live from the Metropolitan Opera stage to cinemas worldwide on May 2. Baritone Igor Golovatenko reprises his portrayal of the urbane Onegin, who realizes his affection for her all too late. The Met’s evocative production, directed by Tony Award–winner Deborah Warner, “offers a beautifully detailed reading of … Tchaikovsky’s lyrical romance” (The Telegraph).\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Following her acclaimed 2024 company debut in Puccini’s Madama Butterfly, soprano Asmik Grigorian returns to the Met as Tatiana, the lovestruck young heroine.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-05-02\",\"runtimeInMinutes\":245,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003741\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009378\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009558\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015515\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015516\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015517\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000368\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001924\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002862\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000043\"],\"externalIds\":{\"moviexchangeReleaseId\":\"d7ed6bd5-c3fe-4f19-ad7f-7a0f33af014f\",\"corporateId\":null},\"hopk\":\"HO00007284\",\"hoCode\":\"A000008291\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000003741\",\"name\":{\"givenName\":\"Stephanie \",\"familyName\":\"Blythe\",\"middleName\":null}},{\"id\":\"0000009378\",\"name\":{\"givenName\":\"Maria\",\"familyName\":\"Barakova\",\"middleName\":null}},{\"id\":\"0000009558\",\"name\":{\"givenName\":\"Asmik\",\"familyName\":\"Grigorian\",\"middleName\":null}},{\"id\":\"0000015515\",\"name\":{\"givenName\":\"Timur\",\"familyName\":\"Zangiev\",\"middleName\":null}},{\"id\":\"0000015516\",\"name\":{\"givenName\":\"Igor\",\"familyName\":\"Golovatenko\",\"middleName\":null}},{\"id\":\"0000015517\",\"name\":{\"givenName\":\"Deborah\",\"familyName\":\"Warner\",\"middleName\":null}},{\"id\":\"HO00000368\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"HO00001924\",\"name\":{\"givenName\":\"Stanislas\",\"fami