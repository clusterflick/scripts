00\",\"filmStartsAt\":\"2026-02-05T21:05:00+00:00\",\"filmEndsAt\":\"2026-02-05T22:58:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"888-1-64\",\"filmId\":\"HO00008310\",\"siteId\":\"888\",\"screenId\":\"888-1\",\"areaCategories\":[{\"areaCategoryId\":\"888-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"888-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"888-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"888-48211\",\"schedule\":{\"businessDate\":\"2026-02-05\",\"startsAt\":\"2026-02-05T20:50:00+00:00\",\"endsAt\":\"2026-02-05T23:02:00+00:00\",\"filmStartsAt\":\"2026-02-05T21:15:00+00:00\",\"filmEndsAt\":\"2026-02-05T23:02:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"888-2-65\",\"filmId\":\"HO00008237\",\"siteId\":\"888\",\"screenId\":\"888-2\",\"areaCategories\":[{\"areaCategoryId\":\"888-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"888-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"888-48197\",\"schedule\":{\"businessDate\":\"2026-02-05\",\"startsAt\":\"2026-02-05T21:00:00+00:00\",\"endsAt\":\"2026-02-05T23:14:00+00:00\",\"filmStartsAt\":\"2026-02-05T21:25:00+00:00\",\"filmEndsAt\":\"2026-02-05T23:14:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"888-3-66\",\"filmId\":\"HO00008189\",\"siteId\":\"888\",\"screenId\":\"888-3\",\"areaCategories\":[{\"areaCategoryId\":\"888-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"888-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"888\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4583,\"longitude\":-0.3052},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Richmond@odeonuk.com\",\"address\":{\"line1\":\"72 Hill Street\",\"line2\":\"\",\"city\":\"Richmond\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007331\",\"title\":{\"text\":\"R.E.M. X Buster Keaton's Sherlock Jr.\",\"translations\":[]},\"synopsis\":{\"text\":\"Silents Synced pairs classic silent movies with epic rock music to bring audiences a unique big screen experience. Buster Keaton’s 1924 comedy classic is reimagined with R.E.M. 's alt-rock masterpieces Monster (1994) and New Adventures in Hi-Fi (1996). \\n\\nIn this sublime comedy teetering between reality and illusion, Buster Keaton stars as a film projectionist who dreams of becoming a detective. He uses his limited skills when he is framed by a rival for stealing his girlfriend’s father’s pocket watch. Keaton reportedly broke his neck performing one of the many dangerous practical stunts in the film. Whether you’re a movie lover or a rock music fan this is an experience you won’t want to miss!!\\n\\nSherlock Jr. will be preceded by a special presentation of one of Keaton’s classic short film works, The Balloonatic(1923), soundtracked by a new composition by renowned Brazilian electronic artist, Amon Tobin.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Silents Synced pairs classic silent movies with epic rock music to bring audiences a unique big screen experience.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate sex references\",\"translations\":[]},\"releaseDate\":\"2026-02-05\",\"runtimeInMinutes\":72,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"6862c9ac-cc5c-46e7-a2fa-a058a8f70212\",\"corporateId\":null},\"hopk\":\"HO00007331\",\"hoCode\":\"A000008347\",\"eventId\":\"0000000001\",\"distributorName\":\"CinemaLive Limited\"},{\"id\":\"HO00008012\",\"title\":{\"text\":\"The Housemaid\",\"translations\":[]},\"synopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous — a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, sex, sexual violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-12-22\",\"runtimeInMinutes\":131,\"trailerUrl\":\"https://www.youtube.com/watch?v=kdDdlY2VPxw\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000009161\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012707\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016976\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016977\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000031\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000135\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000814\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001305\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dc7be94d-5ba5-4a79-accd-48ed4d19a3b6\",\"corporateId\":null},\"hopk\":\"HO00008012\",\"hoCode\":\"A000009092\",\"eventId\":null,\"distributorName\":\"LIONSGATE INTERNATIONAL\"},{\"id\":\"HO00008080\",\"title\":{\"text\":\"Hamnet\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"distressing scenes, brief moderate sex\",\"translations\":[]},\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":126,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003903\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011027\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017134\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000116\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000321\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000322\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001794\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001974\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000005\"],\"externalIds\":{\"moviexchangeReleaseId\":\"37b2b94f-65a0-481e-9d3c-bde2445c99a4\",\"corporateId\":null},\"hopk\":\"HO00008080\",\"hoCode\":\"A000009165\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008101\",\"title\":{\"text\":\"Marty Supreme\",\"translations\":[]},\"synopsis\":{\