          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-02-26\",\"showtimes\":[{\"id\":\"888-46659\",\"schedule\":{\"businessDate\":\"2026-02-26\",\"startsAt\":\"2026-02-26T19:00:00+00:00\",\"endsAt\":\"2026-02-26T22:25:00+00:00\",\"filmStartsAt\":\"2026-02-26T19:25:00+00:00\",\"filmEndsAt\":\"2026-02-26T22:25:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"888-2-65\",\"filmId\":\"HO00008184\",\"siteId\":\"888\",\"screenId\":\"888-2\",\"areaCategories\":[{\"areaCategoryId\":\"888-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"888-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"888-47807\",\"schedule\":{\"businessDate\":\"2026-02-26\",\"startsAt\":\"2026-02-26T19:30:00+00:00\",\"endsAt\":\"2026-02-26T21:54:00+00:00\",\"filmStartsAt\":\"2026-02-26T19:55:00+00:00\",\"filmEndsAt\":\"2026-02-26T21:54:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"888-3-59\",\"filmId\":\"HO00008387\",\"siteId\":\"888\",\"screenId\":\"888-3\",\"areaCategories\":[{\"areaCategoryId\":\"888-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"888-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"888-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"888-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000187\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"888\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4583,\"longitude\":-0.3052},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Richmond@odeonuk.com\",\"address\":{\"line1\":\"72 Hill Street\",\"line2\":\"\",\"city\":\"Richmond\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008184\",\"title\":{\"text\":\"National Theatre Live: The Audience (Rerelease)\",\"translations\":[]},\"synopsis\":{\"text\":\"Returning to cinemas for the first time in over a decade, Helen Mirren plays Queen Elizabeth II in the Olivier and Tony Award® -winning hit production, directed by Stephen Daldry. For 60 years, Queen Elizabeth II met with each of her 12 prime ministers in a private weekly meeting. This meeting is known as The Audience. From Winston Churchill to Margaret Thatcher and David Cameron, the Queen advised her prime ministers on matters both public and personal. Through these private audiences, we see glimpses of the woman behind the crown and witness the moments that shaped a monarch. Peter Morgan’s Netflix phenomenon The Crown was based on this hit play that was captured live from London’s West End in 2013 and went on to become one of the most-watched NT Live productions.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Academy Award-winner Helen Mirren plays Queen Elizabeth II in the much-anticipated return of the Olivier Award–winning hit production, that inspired Netflix’s The Crown.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-26\",\"runtimeInMinutes\":180,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000328\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000004641\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017347\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017348\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000137\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000447\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000039\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9131253f-ec7c-4f61-b9e3-bbea8ddf1cd3\",\"corporateId\":null},\"hopk\":\"HO00008184\",\"hoCode\":\"A000009276\",\"eventId\":\"0000000001\",\"distributorName\":\"National Theatre\"},{\"id\":\"HO00008387\",\"title\":{\"text\":\"Twenty One Pilots: More Than We Ever Imagined\",\"translations\":[]},\"synopsis\":{\"text\":\"Experience the electrifying concert film capturing Twenty One Pilots at a career-defining moment: their monumental Mexico City headline show, performing in front of 65,000 fans at Estadio GNP Seguros during The Clancy World Tour. \\n\\nSet against the vibrant pulse of one of the world’s most iconic music capitals, the film blends cinematic high-energy performance footage with intimate, behind-the-scenes access, revealing the heart, humor, and humanity of the artists as they prepare for one of the biggest shows of their career. \\n\\nViewers follow the band from their arrival in Mexico City to the stage, sharing in the preparation and anticipation that build as showtime approaches. Exclusive commentary from Tyler and Josh offer personal reflections on the journey that brought them to this historic stage and the deep connection with their fans who make it all possible.\\n\\nThe film pulls audiences into the full spectacle of the night. Sweeping aerials of the stadium, on-stage cameras, and crowd-level shots place viewers right at the center of the experience, seeing the show from every angle.  The result is a thrilling, emotional celebration of music, community, and achievement - an unforgettable portrait of Twenty One Pilots, performing a show that will echo through their legacy.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Experience the electrifying concert film capturing Twenty One Pilots at a career-defining moment: their monumental Mexico City headline show.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-25\",\"runtimeInMinutes\":119,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000005569\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005570\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013680\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017715\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017716\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017717\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017718\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a81251d1-868e-4b61-bbc3-6f1257804775\",\"corporateId\":null},\"hopk\":\"HO00008387\",\"hoCode\":\"A000009489\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000000328\",\"name\":{\"givenName\":\"Stephen\",\"familyName\":\"Daldry\",\"middleName\":null}},{\"id\":\"0000004641\",\"name\":{\"givenName\":\"Paul\",\"familyName\":\"Ritter\",\"middleName\":null}},{\"id\":\"0000017347\",\"name\":{\"givenName\":\"Edward\",\"familyName\":\"Fox\",\"middleName\":null}},{\"id\":\"0000017348\",\"name\":{\"givenName\":\"Daniel\",\"familyName\":\"McCabe\",\"middleName\":null}},{\"id\":\"HO00000137\",\"name\":{\"givenName\":\"Helen\",\"familyName\":\"Mirren\",\"middleName\":null}},{\"id\":\"HO00000447\",\"name\":{\"givenName\":\"National Theatre\",\"familyName\":\"Live\",\"middleName\":null}},{\"id\":\"0000005569\",\"name\":{\"givenName\":\"Tyler\",\"familyName\":\"Joseph\",\"middleName\":null}},{\"id\":\"0000005570\",\"name\":{\"givenName\":\"Josh\",\"familyName\":\"Dun\",\"middleName\":null}},{\"id\":\"0000013680\",\"name\":{\"givenName\":\"Devin\",\"familyName\":\"Dehaven\",\"middleName\":null}},{\"id\":\"0000017715\",\"name\":{\"givenName\":\"Mark\",\"familyName\":\"Eshleman\",\"middleName\":null}},{\"id\":\"0000017716\",\"name\":{\"givenName\":\"Nathan\",\"familyName\":\"Bielski\",\"middleName\":null}},{\"id\":\"0000017717\",\"name\":{\"givenName\":\"Aldo\",\"familyName\":\"Ballesteros\",\"middleName\":null}},{\"id\":\"0000017718\",\"name\":{\"givenName\":\"Chris\",\"familyName\":\"Woltman\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000009\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":null},{\"id\":\"0000000039\",\"name\":{\"text\":\"Live Theatre\",\"translations\":[]},\"description\":null},{\"id\":\"0000000055\",\"name\":{\"text\":\"Music\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}},{\"id\":\"0000000001\",\"classification\":{\"text\":\"12A\",\"translations\":[]},\"classificationDescription\":{\"text\":\"12A with Parental Guidance\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true},{\"id\":\"0000000030\",\"name\":{\"text\":\"Wheelchair Accessible\",\"translations\":[]},\"shortName\":{\"text\":\"Wheelchair\",\"translations\":[]},\"description\":{\"text\":\"This auditorium has bays for wheelchair users with seats beside them for accompanying guests.\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":10,\"isPromoted\":false},{\"id\":\"0000000187\",\"name\":{\"text\":\"Flash Warning\",\"translations\":[]},\"shortName\":{\"text\":\"Flash\",\"translations\":[]},\"description\":{\"text\":\"This title has been issued a Guest Warning by the BBFC - it contains a sequence of flashing lights which might affect customers who are susceptible to photosensitive epilepsy.\\r\\n\",\"translations\":[]},\"importantMessage\":{\"text\":\"This title has been issued a Guest Warning by the BBFC - it contains a sequence of flashing lights which might affect customers who are susceptible to photosensitive epilepsy.\",\"translations\":[]},\"displayPriority\":3,\"isPromoted\":false}],\"screens\":[{\"id\":\"888-2\",\"name\":{\"text\":\"Screen 2\",\"translations\":[]}},{\"id\":\"888-3\",\"name\":{\"text\":\"Screen 3\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000001\",\"name\":{\"text\":\"Event\",\"translations\":[]},\"shortName\":{\"text\":\"Event\",\"translations\":[]},\"description\":null,\"schedule\":{\"startDate\":null,\"endDate\":null},\"siteIds\":[\"017\",\"019\",\"031\",\"033\",\"040\",\"044\",\"050\",\"061\",\"071\",\"072\",\"073\",\"074\",\"075\",\"076\",\"077\",\"078\",\"086\",\"090\",\"124\",\"125\",\"153\",\"155\",\"158\",\"159\",\"200\",\"209\",\"220\",\"244\",\"282\",\"355\",\"380\",\"395\",\"430\",\"440\",\"453\",\"475\",\"484\",\"486\",\"498\",\"500\",\"505\",\"508\",\"510\",\"512\",\"515\",\"522\",\"530\",\"536\",\"546\",\"555\",\"560\",\"568\",\"570\",\"590\",\"593\",\"598\",\"600\",\"615\",\"694\",\"695\",\"734\",\"750\",\"755\",\"756\",\"757\",\"758\",\"759\",\"760\",\"761\",\"800\",\"806\",\"824\",\"838\",\"841\",\"842\",\"843\",\"845\",\"846\",\"847\",\"848\",\"849\",\"850\",\"851\",\"852\",\"853\",\"854\",\"856\",\"857\",\"858\",\"859\",\"860\",\"888\",\"912\",\"915\",\"916\",\"917\",\"920\",\"923\",\"925\",\"929\",\"930\",\"948\",\"949\",\"953\",\"954\",\"955\",\"957\",\"961\",\"962\",\"963\",\"980\",\"985\",\"995\",\"998\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"888-0000000001\",\"name\":{\"text\":\"Classic Saver\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false},{\"id\":\"888-0000000002\",\"name\":{\"text\":\"Premier\",\"translations\":[]},\"hopk\":\"0000000001\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false},{\"id\":\"888-0000000017\",\"name\":{\"text\":\"Classic Popular\",\"translations\":[]},\"hopk\":\"0000000025\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false},{\"id\":\"888-0000000020\",\"name\":{\"text\":\"Classic\",\"translations\":[]},\"hopk\":\"0000000028\",\"isAllocatedSeati