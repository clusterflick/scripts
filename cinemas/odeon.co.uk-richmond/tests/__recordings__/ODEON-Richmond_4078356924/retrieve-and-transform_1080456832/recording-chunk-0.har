          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-03-03\",\"showtimes\":[{\"id\":\"888-40278\",\"schedule\":{\"businessDate\":\"2026-03-03\",\"startsAt\":\"2026-03-03T19:15:00+00:00\",\"endsAt\":\"2026-03-03T23:10:00+00:00\",\"filmStartsAt\":\"2026-03-03T19:40:00+00:00\",\"filmEndsAt\":\"2026-03-03T23:10:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"888-3-66\",\"filmId\":\"HO00007278\",\"siteId\":\"888\",\"screenId\":\"888-3\",\"areaCategories\":[{\"areaCategoryId\":\"888-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"888-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"888\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4583,\"longitude\":-0.3052},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Richmond@odeonuk.com\",\"address\":{\"line1\":\"72 Hill Street\",\"line2\":\"\",\"city\":\"Richmond\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007278\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: Giselle\",\"translations\":[]},\"synopsis\":{\"text\":\"The peasant girl Giselle has fallen in love with Albrecht. When she discovers that he is actually a nobleman promised to another, she kills herself in despair. Her spirit joins the Wilis: the vengeful ghosts of women hell-bent on killing any man who crosses their path in a dance to the death. Wracked with guilt, Albrecht visits Giselle’s grave, where he must face the Wilis – and Giselle’s ghost. \\nPeter Wright’s 1985 production of this quintessential Romantic ballet is a classic of The Royal Ballet repertory. Set to Adolphe Adam’s evocative score and with atmospheric designs by John Macfarlane, Giselle conjures up the earthly and otherworldly realms in a tale of love, betrayal and redemption.\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The peasant girl Giselle has fallen in love with Albrecht. When she discovers that he is actually a nobleman promised to another, she kills herself in despair.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-03-03\",\"runtimeInMinutes\":210,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":\"851bfa77-2c0c-449c-8afb-600b60c8decb\",\"corporateId\":null},\"hopk\":\"HO00007278\",\"hoCode\":\"A000008284\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[],\"genres\":[{\"id\":\"0000000028\",\"name\":{\"text\":\"Ballet\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true},{\"id\":\"0000000030\",\"name\":{\"text\":\"Wheelchair Accessible\",\"translations\":[]},\"shortName\":{\"text\":\"Wheelchair\",\"translations\":[]},\"description\":{\"text\":\"This auditorium has bays for wheelchair users with seats beside them for accompanying guests.\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":10,\"isPromoted\":false}],\"screens\":[{\"id\":\"888-3\",\"name\":{\"text\":\"Screen 3\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000001\",\"name\":{\"text\":\"Event\",\"translations\":[]},\"shortName\":{\"text\":\"Event\",\"translations\":[]},\"description\":null,\"schedule\":{\"startDate\":null,\"endDate\":null},\"siteIds\":[\"017\",\"019\",\"031\",\"033\",\"040\",\"0