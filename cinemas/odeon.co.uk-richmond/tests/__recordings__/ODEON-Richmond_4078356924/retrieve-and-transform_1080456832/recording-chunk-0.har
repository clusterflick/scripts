":[\"0000000006\",\"0000000187\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"888-77-HO00008916\"}],\"relatedData\":{\"sites\":[{\"id\":\"888\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4583,\"longitude\":-0.3052},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Richmond@odeonuk.com\",\"address\":{\"line1\":\"72 Hill Street\",\"line2\":\"\",\"city\":\"Richmond\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008916\",\"title\":{\"text\":\"The Odyssey\",\"translations\":[]},\"synopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. The film brings Homer’s foundational saga to IMAX® film screens for the first time. \\n\\nThe Odyssey stars Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson and Lupita Nyong’o, with Zendaya and Charlize Theron.\\n\\nThe Odyssey is produced by Emma Thomas and Christopher Nolan for their company, Syncopy. The executive producer is Thomas Hayslip.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":173,\"trailerUrl\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000008\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000150\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000155\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000018948\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000018\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000064\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000267\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002248\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b63dbbaf-6c0e-4622-b9b1-698037e6247e\",\"corporateId\":null},\"hopk\":\"HO00008916\",\"hoCode\":\"A000010058\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00009078\",\"title\":{\"text\":\"Sia: Nostalgic For The Present\",\"translations\":[]},\"synopsis\":{\"text\":\"One voice. One unforgettable spectacle.\\n\\nSia: Nostalgic for the Present - a bold, genre-defying experience that trades pop pageantry for pure artistry. Awe-inspiring vocals, breathtaking choreography, and iconic performances, captured cinematically and soundtracked by an unmatched catalog of hits.\\n\\nIn 2016, Sia toured the world mirroring this film live on stage, frame for frame. Remastered for its tenth anniversary, it stands alone for the first time - not as a concert film, but as a visual masterpiece unlike anything in music since.\\n\\nStarring Maddie Ziegler, Kristen Wiig, Paul Dano, Ben Mendelsohn, Gaby Hoffmann, and Tig Notaro. Choreographed by Ryan Heffington. Directed by Sia and Daniel Askill.\\n\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"One voice. One unforgettable spectacle.\\n\\nSia: Nostalgic for the Present - a bold, genre-defying experience that trades pop pageantry for pure artistry. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-23\",\"runtimeInMinutes\":75,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004450\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013362\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019332\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"0000019333\",\"roles\":[\"Actor\"]},{\"castAnd