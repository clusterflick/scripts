:[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004642\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017365\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017366\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017367\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"30\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c59e6ef3-faa4-469e-9fc7-2d8997cff25e\",\"corporateId\":null},\"hopk\":\"HO00008195\",\"hoCode\":\"A000009287\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008207\",\"title\":{\"text\":\"Sentimental Value\",\"translations\":[]},\"synopsis\":{\"text\":\"Nora Borg (Renate Reinsve) is an established Oslo stage actress; her younger sister Agnes (Inga Ibsdotter Lilleaas) has chosen family life with her young son. Though markedly different, the two are close and deeply intertwined, having been raised by a single mother after their filmmaker father’s departure years earlier. When the once renowned Gustav (Stellan Skarsgård) attempts to cast Nora in his comeback film, old wounds bleed anew; \\\"Nora rejects his offer, prompting the isolated patriarch to cast American star Rachel Kemp (Elle Fanning), who gradually comes to realize she has unwittingly become part of a deeply personal film drama. Agnes, meanwhile, delves deeper into the family history as Gustav and Nora attempt rapprochement; but the cracks at the base of the family home run deeper than any Borg can grasp, threatening to topple an already shaky foundation.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Sisters Nora and Agnes reunite with their estranged father, the charismatic Gustav, a once renowned director who offers stage actress Nora a role.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, suicide references\",\"translations\":[]},\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":133,\"trailerUrl\":\"https://www.youtube.com/watch?v=Gb1sSfWb1Og\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003152\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003506\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004112\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004113\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005236\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005239\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005240\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017393\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017394\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017395\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017396\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017397\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000002\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000943\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"314313bc-8700-4c13-9204-ea7971d5ba6f\",\"corporateId\":null},\"hopk\":\"HO00008207\",\"hoCode\":\"A000009300\",\"eventId\":null,\"distributorName\":\"MUBI UK Ltd\"},{\"id\":\"HO00008237\",\"title\":{\"text\":\"Shelter\",\"translations\":[]},\"synopsis\":{\"text\":\"On a remote coastal island, a man living in self-imposed exile rescues a young girl from a deadly storm. This action sets off a chain of events, bringing him out of seclusion and both into harm’s way. As their lives intertwine, he must navigate protecting the orphaned girl while battling enemies from is past - setting them both on a breathless odyssey for survival and a deeper journey toward redemption.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"On a remote coastal island, a man living in self-imposed exile rescues a young girl from a deadly storm.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":107,\"trailerUrl\":null,\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000262\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001557\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002147\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014866\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016569\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017459\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000088\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000251\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001694\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001819\",\"roles\":[\"Actor\",\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000007\",\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9e3b2fd7-c5b2-4dee-857d-9dc3d230e4cd\",\"corporateId\":null},\"hopk\":\"HO00008237\",\"hoCode\":\"A000009331\",\"eventId\":null,\"distributorName\":\"Black Bear Pictures\"},{\"id\":\"HO00008239\",\"title\":{\"text\":\"Kangaroo\",\"translations\":[]},\"synopsis\":{\"text\":\"KANGAROO is a heart-warming family comedy about ex TV personality, Chris Masterman, who becomes stranded in an Outback town outside Alice Springs. There, he teams up with 12-year-old Indigenous girl Charlie. The pair form an unlikely friendship and work together to rescue and rehabilitate orphaned joeys in the remote but stunning Outback community - an endeavour that proves to be life-changing for them both.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"KANGAROO is a heart-warming family comedy about an ex-TV personality Chris Masterman, who becomes stranded in an Outback town after a car accident on his way to Broome. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild bad language, threat, violence\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":107,\"trailerUrl\":\"https://www.youtube.com/watch?v=BAwuJ74KP6U\",\"displayPriority\":12,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002636\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006784\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011449\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011614\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012011\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016712\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016713\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000016714\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016715\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016716\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016717\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016718\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016719\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016720\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016721\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016722\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016723\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016724\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016725\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002378\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2190fa2f-4101-475d-848f-b328ee1f0b8d\",\"corporateId\":null},\"hopk\":\"HO00008239\",\"hoCode\":\"A000009333\",\"eventId\":null,\"distributorName\":\"STUDIOCANAL\"},{\"id\":\"HO00008273\",\"title\":{\"text\":\"Primate\",\"translations\":[]},\"synopsis\":{\"text\":\"In PRIMATE, a group of friends’ tropical vacation turns into a terrifying, primal tale of horror and survival.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In PRIMATE, a group of friends’ tropical vacation turns into a terrifying, primal tale of horror and survival.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong bloody violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":89,\"trailerUrl\":\"https://www.youtube.com/watch?v=L9Odp8RvbLo\",\"displayPriority\":10,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000017524\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017525\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017526\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017527\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017528\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017529\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017530\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017532\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017533\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002732\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"67aa2582-ac18-4747-8f49-005d24853af3\",\"corporateId\":null},\"hopk\":\"HO00008273\",\"hoCode\":\"A000009367\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00008327\",\"title\":{\"text\":\"No Other Choice\",\"translations\":[]},\"synopsis\":{\"text\":\"Man-su (Lee Byung Hun), a specialist in paper manufacturing with 25 years of experience, is so satisfied with life that he can truthfully tell himself, “I’ve got it all.” While happily passing his days with his wife Miri (Son Yejin), their two children and two dogs, Man-su is suddenly informed by his company that he has been fired.\\n“We’re sorry. We have no other choice.”\\nFeeling shocked as if his head had been cut off by an ax, Man-su vows to find himself a new job within the next three months for the sake of his family. Despite his firm resolve to turn his life around, Man-su spends over a year drifting from one job interview after another, and working at a retail store. He eventually finds himself in danger of losing the very house that he struggled so hard to buy.\\nDesperate, he visits Moon Paper out of the blue and tries to hand over his CV, but he just ends up getting humiliated by line manager Choi Sun-chul (Park Hee Soon). Man-su knows he is better qualified than anyone to work at Moon Paper, so he comes to a certain decision.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, violence, injury detail, sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":139,\"trailerUrl\":null,\"displayPriority\":13,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000010701\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016863\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017619\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017620\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017621\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017622\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000009\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e660de4a-88af-472a-a1e1-57ffb9dcbb49\",\"corporateId\":null},\"hopk\":\"HO00008327\",\"hoCode\":\"A000009425\",\"eventId\":null,\"distributorName\":\"MUBI UK Ltd\"},{\"id\":\"HO00008390\",\"title\":{\"text\":\"Iron Lung\",\"translations\":[]},\"synopsis\":{\"text\":\"The stars are gone. The planets have disappeared. Only individuals aboard space stations or starships were left to give the end a name - The Quiet Rapture. After decades of decay and crumbling infrastructure, the Consolidation of Iron has made a discovery on a barren moon designated AT-5. An ocean of blood.\\u2028 Hoping to discover desperately needed resources they immediately launch an expedition. A submarine is crafted and a convict is welded inside. Due to the pressure and depth of the ocean the forward viewport has been encased in metal. If successful, they will earn their freedom. If not, another will follow. This will be the 13th expedition.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The stars are gone. The planets have disappeared. Only those on space stations or starships were left to give the end a name. The Quiet Rapture. The universe dims.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, bloody images, threat\",\"translations\":[]},\"releaseDate\":\"2026-01-29\",\"runtimeInMinutes\":125,\"trailerUrl\":null,\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000017729\",\"roles\":[\"Actor\",\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000014\",\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4187d757-ba5e-42e9-9ba3-f3aa56e6b45f\",\"corporateId\":null},\"hopk\":\"HO00008390\",\"hoCode\":\"A000009492\",\"eventId\":null,\"distributorName\":\"(New) Iron Lung Inc\"}],\"castAndCrew\":[{\"id\":\"0000003440\",\"name\":{\"givenName\":\"Byron\",\"familyName\":\"Howard\",\"middleName\":null}},{\"id\":\"0000003441\",\"name\":{\"givenName\":\"Jared\",\"familyName\":\"Bush\",\"middleName\":null}},{\"id\":\"0000003443\",\"name\":{\"givenName\":\"Yvett Merino\",\"familyName\":\"Flores\",\"middleName\":null}},{\"id\":\"0000006395\",\"name\":{\"givenName\":\"Jason\",\"familyName\":\"Bateman\",\"middleName\":null}},{\"id\":\"0000008394\",\"name\":{\"givenName\":\"Ginnifer\",\"familyName\":\"Goodwin\",\"middleName\":null}},{\"id\":\"0000015583\",\"name\":{\"givenName\":\"Rolando\",\"familyName\":\"Davila-Beltran\",\"middleName\":null}},{\"id\":\"0000015584\",\"name\":{\"givenName\":\"Fortune\",\"familyName\":\"Feimster\",\"middleName\":null}},{\"id\":\"HO00000082\",\"name\":{\"givenName\":\"Jennifer\",\"familyName\":\"L