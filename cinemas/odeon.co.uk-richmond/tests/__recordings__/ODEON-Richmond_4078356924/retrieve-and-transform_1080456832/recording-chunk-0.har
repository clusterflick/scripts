            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-02-28\",\"showtimes\":[{\"id\":\"888-47808\",\"schedule\":{\"businessDate\":\"2026-02-28\",\"startsAt\":\"2026-02-28T14:00:00+00:00\",\"endsAt\":\"2026-02-28T16:24:00+00:00\",\"filmStartsAt\":\"2026-02-28T14:25:00+00:00\",\"filmEndsAt\":\"2026-02-28T16:24:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"888-5-61\",\"filmId\":\"HO00008387\",\"siteId\":\"888\",\"screenId\":\"888-5\",\"areaCategories\":[{\"areaCategoryId\":\"888-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"888-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"888-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000187\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"888\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4583,\"longitude\":-0.3052},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Richmond@odeonuk.com\",\"address\":{\"line1\":\"72 Hill Street\",\"line2\":\"\",\"city\":\"Richmond\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008387\",\"title\":{\"text\":\"Twenty One Pilots: More Than We Ever Imagined\",\"translations\":[]},\"synopsis\":{\"text\":\"Experience the electrifying concert film capturing Twenty One Pilots at a career-defining moment: their monumental Mexico City headline show, performing in front of 65,000 fans at Estadio GNP Seguros during The Clancy World Tour. \\n\\nSet against the vibrant pulse of one of the world’s most iconic music capitals, the film blends cinematic high-energy performance footage with intimate, behind-the-scenes access, revealing the heart, humor, and humanity of the artists as they prepare for one of the biggest shows of their career. \\n\\nViewers follow the band from their arrival in Mexico City to the stage, sharing in the preparation and anticipation that build as showtime approaches. Exclusive commentary from Tyler and Josh offer personal reflections on the journey that brought them to this historic stage and the deep connection with their fans who make it all possible.\\n\\nThe film pulls audiences into the full spectacle of the night. Sweeping aerials of the stadium, on-stage cameras, and crowd-level shots place viewers right at the center of the experience, seeing the show from every angle.  The result is a thrilling, emotional celebration of music, community, and achievement - an unforgettable portrait of Twenty One Pilots, performing a show that will echo through their legacy.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Experience the electrifying concert film capturing Twenty One Pilots at a career-defining moment: their monumental Mexico City headline show.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-25\",\"runtimeInMinutes\":119,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000005569\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005570\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013680\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017715\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017716\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017717\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017718\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a81251d1-868e-4b61-bbc3-6f1257804775\",\"corporateId\":null},\"hopk\":\"HO00008387\",\"hoCode\":\"A000009489\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000005569\",\"name\":{\"givenName\":\"Tyler\",\"familyName\":\"Joseph\",\"middleName\":null}},{\"id\":\"0000005570\",\"name\":{\"givenName\":\"Josh\",\"familyName