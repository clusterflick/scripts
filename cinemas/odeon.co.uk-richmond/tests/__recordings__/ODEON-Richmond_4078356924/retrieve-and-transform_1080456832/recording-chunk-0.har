ext\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4583,\"longitude\":-0.3052},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Richmond@odeonuk.com\",\"address\":{\"line1\":\"72 Hill Street\",\"line2\":\"\",\"city\":\"Richmond\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008836\",\"title\":{\"text\":\"Paw Patrol: The Dino Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"After their ship gets caught in a mysterious storm, the PAW Patrol pups crash land on an uncharted tropical island filled with dinosaurs. They meet Rex, a pup who has been stranded on the island for years and has become an expert in all things dino-related. When the PAW Patrol's archrival, Mayor Humdinger, begins recklessly mining in hopes of exploiting the island for its natural resources, he inadvertently causes a huge, dormant volcano to erupt. The PAW Patrol pups are thrown into a series of high-stakes, dino-sized rescues bigger than anything they've done before, as they must stop Humdinger before everything on the island goes extinct.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After their ship gets caught in a mysterious storm, the PAW Patrol pups crash land on an uncharted tropical island filled with dinosaurs. They meet Rex.\",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-06\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=W6q8uzqfB5k\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002221\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002222\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003857\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004749\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009450\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009456\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009459\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009460\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000015584\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017638\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018717\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018718\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018719\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018720\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018721\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018722\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018723\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018724\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17105\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000929\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000004\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"83cbd022-4773-4c59-b054-5381ed21ba1f\",\"corporateId\":null},\"hopk\":\"HO00008836\",\"hoCode\":\"A000009972\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00008932\",\"title\":{\"text\":\"Andre Rieu - Summer 2026: Viva Maastricht!\",\"translations\":[]},\"synopsis\":{\"text\":\"This year, André Rieu celebrates a spectacular milestone — the 20th anniversary of his iconic summer concerts on the magnificent Vrijthof square. Captured live in his beloved hometown, this brand-new cinema event marks two decades of music and unforgettable magical summer nights. Viva Maastricht! is a joyful tribute to the city where it all began. Joined by his world-renowned Johann Strauss Orchestra and a vibrant ensemble of artists, André brings the spirit, culture, and warmth of his hometown to life in a dazzling new concert filled with emotion and wonder. From timeless waltzes to soul-stirring classics, this landmark anniversary concert promises an evening of passion, joy, and togetherness. Be part of this historic celebration as the Vrijthof once again transforms into a breathtaking open-air ballroom — only in cinemas this summer.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"This year, André Rieu celebrates a spectacular milestone — the 20th anniversary of his iconic summer concerts on the magnificent Vrijthof square.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-07\",\"runtimeInMinutes\":165,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"HO00000335\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000336\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a73b32c9-cde1-4f0c-9969-473043393c2b\",\"corporateId\":null},\"hopk\":\"HO00008932\",\"hoCode\":\"A000010077\",\"eventId\":\"0000000001\",\"distributorName\":\"PIECE OF MAGIC\"}],\"castAndCrew\":[{\"id\":\"0000002221\",\"name\":{\"givenName\":\"Cal\",\"familyName\":\"Brunker\",\"middleName\":null}},{\"id\":\"0000002222\",\"name\":{\"givenName\":\"Jennifer\",\"familyName\":\"Dodge\",\"middleName\":null}},{\"id\":\"0000003857\",\"name\":{\"givenName\":\"Snoop\",\"familyName\":\"Dogg\",\"middleName\":null}},{\"id\":\"0000004749\",\"name\":{\"givenName\":\"Jameela\",\"familyName\":\"Jamil\",\"middleName\":null}},{\"id\":\"0000009450\",\"name\":{\"givenName\":\"Ron\",\"familyName\":\"Pardo\",\"middleName\":null}},{\"id\":\"0000009456\",\"name\":{\"givenName\":\"Nylan\",\"familyName\":\"Parthipan\",\"middleName\":null}},{\"id\":\"0000009459\",\"name\":{\"givenName\":\"Laura\",\"familyName\":\"Clunie\",\"middleName\":null}},{\"id\":\"0000009460\",\"name\":{\"givenName\":\"Toni\",\"familyName\":\"Stevens\",\"middleName\":null}},{\"id\":\"0000015584\",\"name\":{\"givenName\":\"Fortune\",\"familyName\":\"Feimster\",\"middleName\":null}},{\"id\":\"0000017638\",\"name\":{\"givenName\":\"Paris\",\"familyName\":\"Hilton\",\"middleName\":null}},{\"id\":\"00000187