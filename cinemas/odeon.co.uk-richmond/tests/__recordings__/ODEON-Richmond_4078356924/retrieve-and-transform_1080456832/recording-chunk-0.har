ndCrew\":[{\"castAndCrewMemberId\":\"0000000560\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002207\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002294\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005786\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005787\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007837\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17711\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17712\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17713\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000042\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000349\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000696\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002427\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000010\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a4cb369f-77c4-4fe1-8f85-dd5e76b195dd\",\"corporateId\":null},\"hopk\":\"HO00007533\",\"hoCode\":\"A000008563\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00007638\",\"title\":{\"text\":\"The SpongeBob Movie: Search for Squarepants\",\"translations\":[]},\"synopsis\":{\"text\":\"SpongeBob and his Bikini Bottom friends set sail in their biggest, all-new, can’t miss cinematic event ever…The SpongeBob Movie: Search for SquarePants. Desperate to be a big guy, SpongeBob sets out to prove his bravery to Mr. Krabs by following The Flying Dutchman – a mysterious swashbuckling ghost pirate – on a seafaring comedy- adventure that takes him to the deepest depths of the deep sea, where no Sponge has gone before.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"SpongeBob and his Bikini Bottom friends set sail in their biggest, all-new, can’t miss cinematic event ever…The SpongeBob Movie: Search for SquarePants.\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat, violence, rude humour\",\"translations\":[]},\"releaseDate\":\"2025-12-20\",\"runtimeInMinutes\":96,\"trailerUrl\":\"https://www.youtube.com/watch?v=4-k8Hg7SZas\",\"displayPriority\":15,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000003\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001112\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002204\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016137\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016138\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016139\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016140\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016141\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"9353\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001014\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001107\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001108\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001109\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002485\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002508\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002640\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e5808809-5d74-4074-ba7d-547c6d87a1b4\",\"corporateId\":null},\"hopk\":\"HO00007638\",\"hoCode\":\"A000008678\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00007891\",\"title\":{\"text\":\"A Tooth Fairy Tale\",\"translations\":[]},\"synopsis\":{\"text\":\"Van is a teenage tooth fairy with a taste for adventure, who wishes to explore life beyond the boundaries of his secluded civilization and rigid traditions. Upon meeting Gemma, a daring goblin girl with a knack for science, the pair realise that they have a lot in common, despite the ancient disputes between their two tribes. Together, with the help of Rupee (the world’s cutest troll!), they decide to embark on a mission to reunite their magical kingdoms for good. However, hot on their trail is the greedy Spider Queen and her minions, who will stop at nothing to put an end to their plans.\\n\\nA stunning animation that will spark the imagination of the whole family, it stars Booboo Stewart (The Twilight Saga, Descendants), Larkin Bell (Stranger Things), Vivica A. Fox (Ella Enchanted), Jon Lovitz (Matilda, Hotel Transylvania), and Fran Drescher (Hotel Transylvania).\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Van is a teenage tooth fairy with a taste for adventure, who wishes to explore life beyond the boundaries of his secluded civilization and rigid traditions. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild fantasy violence\",\"translations\":[]},\"releaseDate\":\"2025-10-17\",\"runtimeInMinutes\":88,\"trailerUrl\":\"https://www.youtube.com/watch?v=eLgAL70FzLE\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001634\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002728\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005183\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016119\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016728\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016729\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016730\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"2227\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"21af7487-fc4d-4b39-a8e9-e0607032c85d\",\"corporateId\":null},\"hopk\":\"HO00007891\",\"hoCode\":\"A000008958\",\"eventId\":null,\"distributorName\":\"Kaleidoscope Home Entertainmen\"},{\"id\":\"HO00008012\",\"title\":{\"text\":\"The Housemaid\",\"translations\":[]},\"synopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous — a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, sex, sexual violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-12-22\",\"runtimeInMinutes\":131,\"trailerUrl\":\"https://www.youtube.com/watch?v=kdDdlY2VPxw\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000009161\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012707\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016976\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016977\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000031\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000135\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000814\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001305\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dc7be94d-5ba5-4a79-accd-48ed4d19a3b6\",\"corporateId\":null},\"hopk\":\"HO00008012\",\"hoCode\":\"A000009092\",\"eventId\":null,\"distributorName\":\"LIONSGATE INTERNATIONAL\"},{\"id\":\"HO00008080\",\"title\":{\"text\":\"Hamnet\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"distressing scenes, brief moderate sex\",\"translations\":[]},\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":126,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003903\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011027\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017134\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000116\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000321\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000322\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001794\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001974\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000005\"],\"externalIds\":{\"moviexchangeReleaseId\":\"37b2b94f-65a0-481e-9d3c-bde2445c99a4\",\"corporateId\":null},\"hopk\":\"HO00008080\",\"hoCode\":\"A000009165\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008101\",\"title\":{\"text\":\"Marty Supreme\",\"translations\":[]},\"synopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, sex, nudity, injury detail, violence\",\"translations\":[]},\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":150,\"trailerUrl\":\"https://www.youtube.com/watch?v=s9gSuKaKcqM\",\"displayPriority\":7,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001370\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012950\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014188\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014753\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017170\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017171\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"17172\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17173\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17174\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"2227\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000258\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"90e71dd1-a916-4807-8aff-0dd9f141e72d\",\"corporateId\":null},\"hopk\":\"HO00008101\",\"hoCode\":\"A000009187\",\"eventId\":null,\"distributorName\":\"ENTERTAINMENT FILM DISTRIBUTOR\"},{\"id\":\"HO00008189\",\"title\":{\"text\":\"28 Years Later: The Bone Temple\",\"translations\":[]},\"synopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later: The Bone Temple. In a continuation of the epic story, Dr. Kelson (Ralph Fiennes) finds himself in a shocking new relationship - with consequences that could change the world as they know it - and Spike's (Alfie Williams) encounter with Jimmy Crystal (Jack O'Connell) becomes a nightmare he can't escape. In the world of The Bone Temple, the infected are no longer the greatest threat to survival - the inhumanity of the survivors can be stranger and more terrifying.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong gory violence, injury detail, very strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-14\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=wyYliP8dPWU\",\"displayPriority\":9,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000097\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000442\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002404\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002653\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005575\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014011\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014577\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017356\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000576\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"12790418-6492-492a-814c-53673bc1ab1a\",\"corporateId\":null},\"hopk\":\"HO00008189\",\"hoCode\":\"A000009281\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008191\",\"title\":{\"text\":\"Rental Family\",\"translations\":[]},\"synopsis\":{\"text\":\"A down-and-out actor living in Tokyo is hired as a token American guy for a Japanese rental-family company, leading him on an unexpected journey of self-discovery through the roles he plays in other people’s lives.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A down-and-out actor living in Tokyo is hired as a token American guy for a Japanese rental-family company, leading him on an unexpected journey of self-discovery.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-16\",\"runtimeInMinutes\":110,\"trailerUrl\":\"https://www.youtube.com/watch?v=sZT37sM2VgE\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007702\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008791\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008792\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017357\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017358\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017359\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017360\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017361\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"2617\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a2ea80c3-a876-47ff-9c5c-0cddaeae7ddd\",\"corporateId\":null},\"hopk\":\"HO00008191\",\"hoCode\":\"A000009283\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008193\",\"title\":{\"text\":\"Mercy\",\"translations\":[]},\"synopsis\":{\"text\":\"In the near future, a detective (Chris Pratt) stands on trial accused of murdering his wife. He has 90 minutes to prove his innocence to the advanced A.I. Judge (Rebecca Ferguson) he once championed, before it determines his fate.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In the near future, a detective (Chris Pratt) stands on trial accused of murdering his wife. He has 90 minutes to prove his innocence to the advanced A.I. Judge.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate violence, threat, injury detail, drug misuse, strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=sN-C09dfczY\",\"displayPriority\":12,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003235\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000009008\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017362\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017363\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017364\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000086\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000825\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000982\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001684\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002432\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"eea3fe00-3e2b-4dcc-9150-aedd76790a42\",\"corporateId\":null},\"hopk\":\"HO00008193\",\"hoCode\":\"A000009285\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008195\",\"title\":{\"text\":\"Is This Thing On?\",\"translations\":[]},\"synopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family — forcing them to navigate co-parenting, identity, and whether love can take a new form.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":121,\"trailerUrl\":\"https://www.youtube.com/watch?v=ngmu5zGOa7s\",\"displayPriority\":11,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000027\",\"roles\":[\"Actor\",\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000883\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000002332\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004642\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017365\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017366\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017367\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"30\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c59e6ef3-faa4-469e-9fc7-2d8997cff25e\",\"corporateId\":null},\"hopk\":\"HO00008195\",\"hoCode\":\"A000009287\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008207\",\"title\":{\"text\":\"Sentimental Value\",\"translations\":[]},\"synopsis\":{\"text\":\"Nora Borg (Renate Reinsve) is an established Oslo stage actress; her younger sister Agnes (Inga Ibsdotter Lilleaas) has chosen family life with her young son. Though markedly different, the two are close and deeply intertwined, having been raised by a single mother after their filmmaker father’s departure years earlier. When the once renowned Gustav (Stellan Skarsgård) attempts to cast Nora in his comeback film, old wounds bleed anew; \\\"Nora rejects his offer, prompting the isolated patriarch to cast American star Rachel Kemp (Elle Fanning), who gradually comes to realize she has unwittingly become part of a deeply personal film drama. Agnes, meanwhile, delves deeper into the family history as Gustav and Nora attempt rapprochement; but the cracks at the base of the family home run deeper than any Borg can grasp, threatening to topple an already shaky foundation.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Sisters Nora and Agnes reunite with their estranged father, the charismatic Gustav, a once renowned director who offers stage actress Nora a role.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, suicide references\",\"translations\":[]},\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":133,\"trailerUrl\":\"https://www.youtube.com/watch?v=Gb1sSfWb1Og\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003152\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003506\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004112\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004113\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005236\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005239\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005240\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017393\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017394\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017395\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017396\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017397\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000002\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000943\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"314313bc-8700-4c13-9204-ea7971d5ba6f\",\"corporateId\":null},\"hopk\":\"HO00008207\",\"hoCode\":\"A000009300\",\"eventId\":null,\"distributorName\":\"MUBI UK Ltd\"},{\"id\":\"HO00008237\",\"title\":{\"text\":\"Shelter\",\"translations\":[]},\"synopsis\":{\"text\":\"On a remote coastal island, a man living in self-imposed exile rescues a young girl from a deadly storm. This action sets off a chain of events, bringing him out of seclusion and both into harm’s way. As their lives intertwine, he must navigate protecting the orphaned girl while battling enemies from is past - setting them both on a breathless odyssey for survival and a deeper journey toward redemption.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"On a remote coastal island, a man living in self-imposed exile rescues a young girl from a deadly storm.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":107,\"trailerUrl\":null,\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000262\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001557\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002147\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014866\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016569\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017459\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000088\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000251\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001694\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001819\",\"roles\":[\"Actor\",\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000007\",\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9e3b2fd7-c5b2-4dee-857d-9dc3d230e4cd\",\"corporateId\":null},\"hopk\":\"HO00008237\",\"hoCode\":\"A000009331\",\"eventId\":null,\"distributorName\":\"Black Bear Pictures\"},{\"id\":\"HO00008239\",\"title\":{\"text\":\"Kangaroo\",\"translations\":[]},\"synopsis\":{\"text\":\"KANGAROO is a heart-warming family comedy about ex TV personality, Chris Masterman, who becomes stranded in an Outback town outside Alice Springs. There, he teams up with 12-year-old Indigenous girl Charlie. The pair form an unlikely friendship and work together to rescue and rehabilitate orphaned joeys in the remote but stunning Outback community - an endeavour that proves to be life-changing for them both.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"KANGAROO is a heart-warming family comedy about an ex-TV personality Chris Masterman, who becomes stranded in an Outback town after a car accident on his way to Broome. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild bad language, threat, violence\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":107,\"trailerUrl\":\"https://www.youtube.com/watch?v=BAwuJ74KP6U\",\"displayPriority\":12,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002636\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006784\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011449\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011614\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012011\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016712\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016713\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000016714\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016715\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016716\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016717\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016718\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016719\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016720\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016721\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016722\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016723\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016724\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016725\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002378\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2190fa2f-4101-475d-848f-b328ee1f0b8d\",\"corporateId\":null},\"hopk\":\"HO00008239\",\"hoCode\":\"A000009333\",\"eventId\":null,\"distributorName\":\"STUDIOCANAL\"},{\"id\":\"HO00008273\",\"title\":{\"text\":\"Primate\",\"translations\":[]},\"synopsis\":{\"text\":\"In PRIMATE, a group of friends’ tropical vacation turns into a terrifying, primal tale of horror and survival.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In PRIMATE, a group of friends’ tropical vacation turns into a terrifying, primal tale of horror and survival.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong bloody violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":89,\"trailerUrl\":\"https://www.youtube.com/watch?v=L9Odp8RvbLo\",\"displayPriority\":10,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000017524\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017525\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017526\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017527\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017528\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017529\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017530\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017532\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017533\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002732\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"67aa2582-ac18-4747-8f49-005d24853af3\",\"corporateId\":null},\"hopk\":\"HO00008273\",\"hoCode\":\"A000009367\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00008327\",\"title\":{\"text\":\"No Other Choice\",\"translations\":[]},\"synopsis\":{\"text\":\"Man-su (Lee Byung Hun), a specialist in paper manufacturing with 25 years of experience, is so satisfied with life that he can truthfully tell himself, “I’ve got it all.” While happily passing his days with his wife Miri (Son Yejin), their two children and two dogs, Man-su is suddenly informed by his company that he has been fired.\\n“We’re sorry. We have no other choice.”\\nFeeling shocked as if his head had been cut off by an ax, Man-su vows to find himself a new job within the next three months for the sake of his family. Despite his firm resolve to turn his life around, Man-su spends over a year drifting from one job interview after another, and working at a retail store. He eventually finds himself in danger of losing the very house that he struggled so hard to buy.\\nDesperate, he visits Moon Paper out of the blue and tries to hand over his CV, but he just ends up getting humiliated by line manager Choi Sun-chul (Park Hee Soon). Man-su knows he is better qualified than anyone to work at Moon Paper, so he comes to a certain decision.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, violence, injury detail, sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":139,\"trailerUrl\":null,\"displayPriority\":13,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000010701\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016863\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017619\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017620\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017621\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017622\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000009\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e660de4a-88af-472a-a1e1-57ffb9dcbb49\",\"corporateId\":null},\"hopk\":\"HO00008327\",\"hoCode\":\"A000009425\",\"eventId\":null,\"distributorName\":\"MUBI UK Ltd\"},{\"id\":\"HO00008390\",\"title\":{\"text\":\"Iron Lung\",\"translations\":[]},\"synopsis\":{\"text\":\"The stars are gone. The planets have disappeared. Only individuals aboard space stations or starships were left to give the end a name - The Quiet Rapture. After decades of decay and crumbling infrastructure, the Consolidation of Iron has made a discovery on a barren moon designated AT-5. An ocean of blood.\\u2028 Hoping to discover desperately needed resources they immediately launch an expedition. A submarine is crafted and a convict is welded inside. Due to the pressure and depth of the ocean the forward viewport has been encased in metal. If successful, they will earn their freedom. If not, another will follow. This will be the 13th expedition.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The stars are gone. The planets have disappeared. Only those on space stations or starships were left to give the end a name. The Quiet Rapture. The universe dims.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, bloody images, threat\",\"translations\":[]},\"releaseDate\":\"2026-01-29\",\"runtimeInMinutes\":125,\"trailerUrl\":null,\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000017729\",\"roles\":[\"Actor\",\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000014\",\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4187d757-ba5e-42e9-9ba3-f3aa56e6b45f\",\"corporateId\":null},\"hopk\":\"HO00008390\",\"hoCode\":\"A000009492\",\"eventId\":null,\"distributorName\":\"(New) Iron Lung Inc\"}],\"castAndCrew\":[{\"id\":\"0000003440\",\"name\":{\"givenName\":\"Byron\",\"familyName\":\"Howard\",\"middleName\":null}},{\"id\":\"0000003441\",\"name\":{\"givenName\":\"Jared\",\"familyName\":\"Bush\",\"middleName\":null}},{\"id\":\"0000003443\",\"name\":{\"givenName\":\"Yvett Merino\",\"familyName\":\"Flores\",\"middleName\":null}},{\"id\":\"0000006395\",\"name\":{\"givenName\":\"Jason\",\"familyName\":\"Bateman\",\"middleName\":null}},{\"id\":\"0000008394\",\"name\":{\"givenName\":\"Ginnifer\",\"familyName\":\"Goodwin\",\"middleName\":null}},{\"id\":\"0000015583\",\"name\":{\"givenName\":\"Rolando\",\"familyName\":\"Davila-Beltran\",\"middleName\":null}},{\"id\":\"0000015584\",\"name\":{\"givenName\":\"Fortune\",\"familyName\":\"Feimster\",\"middleName\":null}},{\"id\":\"HO00000082\",\"name\":{\"givenName\":\"Jennifer\",\"familyName\":\"Lee\",\"middleName\":null}},{\"id\":\"HO00