ries\":[{\"areaCategoryId\":\"888-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"888-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"888-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"888-53645\",\"schedule\":{\"businessDate\":\"2026-08-07\",\"startsAt\":\"2026-08-07T17:00:00+01:00\",\"endsAt\":\"2026-08-07T18:55:00+01:00\",\"filmStartsAt\":\"2026-08-07T17:25:00+01:00\",\"filmEndsAt\":\"2026-08-07T18:55:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"888-7-54\",\"filmId\":\"HO00008836\",\"siteId\":\"888\",\"screenId\":\"888-7\",\"areaCategories\":[{\"areaCategoryId\":\"888-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"888-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"888-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"888\",\"name\":{\"text\":\"Richmond\",\"translations\":[]},\"location\":{\"latitude\":51.4583,\"longitude\":-0.3052},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Richmond@odeonuk.com\",\"address\":{\"line1\":\"72 Hill Street\",\"line2\":\"\",\"city\":\"Richmond\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008836\",\"title\":{\"text\":\"Paw Patrol: The Dino Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"After their ship gets caught in a mysterious storm, the PAW Patrol pups crash land on an uncharted tropical island filled with dinosaurs. They meet Rex, a pup who has been stranded on the island for years and has become an expert in all things dino-related. When the PAW Patrol's archrival, Mayor Humdinger, begins recklessly mining in hopes of exploiting the island for its natural resources, he inadvertently causes a huge, dormant volcano to erupt. The PAW Patrol pups are thrown into a series of high-stakes, dino-sized rescues bigger than anything they've done before, as they must stop Humdinger before everything on the island goes extinct.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After their ship gets caught in a mysterious storm, the PAW Patrol pups crash land on an uncharted tropical island filled with dinosaurs. They meet Rex.\",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-06\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=W6q8uzqfB5k\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002221\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002222\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003857\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004749\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009450\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009456\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009459\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009460\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000015584\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017638\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018717\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018718\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018719\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018720\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018721\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018722\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018723\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018724\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17105\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\