            "text": "{\"id\":506,\"filmId\":19,\"screeningDate\":\"2026-07-17T21:00\",\"doorsTime\":\"8:30pm\",\"filmTime\":\"9:00pm\",\"capacity\":37,\"ticketsSold\":5,\"price\":1100,\"format\":\"Digital\",\"excludeFromGiftVouchers\":false,\"isPrivate\":false,\"memberOnly\":false,\"film\":{\"id\":19,\"title\":\"MYSTERY MOVIE\",\"description\":\"Not for the easily offended, and strictly programmed for adult audiences only - our mystery films are eye-popping forays into the bold and bonkers world of psychotronic cinema. Expect the unacceptable.\\n\\n**Please consider yourself forewarned that these films may (and probably will) contain offensive and upsetting content. Do not attend if you are of a sensitive disposition.**\",\"runtime\":null,\"year\":null,\"country\":\"?\",\"director\":\"?\",\"imageUrl\":\"https://yxvwcvyczjjes5ua.public.blob.vercel-storage.com/myst.png\",\"imageCropX\":50,\"imageCropY\":50,\"ageCertificate\":\"18\"}}",
