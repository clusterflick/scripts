\\\"#000000\\\"}]]\\n9:null\\n\"])</script><script>self.__next_f.push([1,\"13:I[622,[],\\\"IconMark\\\"]\\n\"])</script><script>self.__next_f.push([1,\"b:{\\\"metadata\\\":[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"The Nickel | Independent Cinema in Clerkenwell, London\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"A fully licensed grindhouse cinema, bar and video shop in the heart of Clerkenwell, London. Experience cult classics, horror marathons, and rare film screenings in an intimate 40-seat venue.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"2\\\",{\\\"name\\\":\\\"application-name\\\",\\\"content\\\":\\\"The Nickel\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"name\\\":\\\"author\\\",\\\"content\\\":\\\"The Nickel Cinema\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"name\\\":\\\"keywords\\\",\\\"content\\\":\\\"independent cinema London,Clerkenwell cinema,grindhouse cinema,cult film screenings,horror cinema London,video shop London,film bar London,rare film screenings,B-movie cinema,The Nickel,EC1 cinema,arthouse cinema London\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"name\\\":\\\"creator\\\",\\\"content\\\":\\\"The Nickel Cinema\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"6\\\",{\\\"name\\\":\\\"publisher\\\",\\\"content\\\":\\\"The Nickel Cinema\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"name\\\":\\\"robots\\\",\\\"content\\\":\\\"index, follow\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"8\\\",{\\\"name\\\":\\\"googlebot\\\",\\\"content\\\":\\\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"9\\\",{\\\"name\\\":\\\"category\\\",\\\"content\\\":\\\"entertainment\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"10\\\",{\\\"name\\\":\\\"geo.region\\\",\\\"content\\\":\\\"GB-LND\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"11\\\",{\\\"name\\\":\\\"geo.placename\\\",\\\"content\\\":\\\"London\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"12\\\",{\\\"name\\\":\\\"geo.position\\\",\\\"content\\\":\\\"51.5226;-0.1052\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"13\\\",{\\\"name\\\":\\\"ICBM\\\",\\\"content\\\":\\\"51.5226, -0.1052\\\"}],[\\\"$\\\",\\\"link\\\",\\\"14\\\",{\\\"rel\\\":\\\"canonical\\\",\\\"href\\\":\\\"https://thenickel.co.uk\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"15\\\",{\\\"property\\\":\\\"og:title\\\",\\\"content\\\":\\\"The Nickel | Independent Cinema in Clerkenwell, London\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"16\\\",{\\\"property\\\":\\\"og:description\\\",\\\"content\\\":\\\"A fully licensed grindhouse cinema, bar and video shop. Cult classics, horror marathons, and rare film screenings in an intimate 40-seat venue.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"17\\\",{\\\"property\\\":\\\"og:url\\\",\\\"content\\\":\\\"https://thenickel.co.uk\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"18\\\",{\\\"property\\\":\\\"og:site_name\\\",\\\"content\\\":\\\"The Nickel\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"19\\\",{\\\"property\\\":\\\"og:locale\\\",\\\"content\\\":\\\"en_GB\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"20\\\",{\\\"property\\\":\\\"og:image\\\",\\\"content\\\":\\\"https://thenickel.co.uk/logo.png\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"21\\\",{\\\"property\\\":\\\"og:image:width\\\",\\\"content\\\":\\\"800\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"22\\\",{\\\"property\\\":\\\"og:image:height\\\",\\\"content\\\":\\\"600\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"23\\\",{\\\"property\\\":\\\"og:image:alt\\\",\\\"content\\\":\\\"The Nickel Cinema Logo\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"24\\\",{\\\"property\\\":\\\"og:type\\\",\\\"content\\\":\\\"website\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"25\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary_large_image\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"26\\\",{\\\"name\\\":\\\"twitter:site\\\",\\\"content\\\":\\\"@thenickelcinema\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"27\\\",{\\\"name\\\":\\\"twitter:creator\\\",\\\"content\\\":\\\"@thenickelcinema\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"28\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"The Nickel | Independent Cinema in Clerkenwell, London\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"29\\\",{\\\"name\\\":\\\"twitter:description\\\",\\\"content\\\":\\\"Grindhouse cinema, bar and video shop. Cult classics and rare film screenings in an intimate venue.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"30\\\",{\\\"name\\\":\\\"twitter:image\\\",\\\"content\\\":\\\"https://thenickel.co.uk/logo.png\\\"}],[\\\"$\\\",\\\"link\\\",\\\"31\\\",{\\\"rel\\\":\\\"shortcut icon\\\",\\\"href\\\":\\\"https://yxvwcvyczjjes5ua.public.blob.vercel-storage.com/favicon.ico\\\"}],[\\\"$\\\",\\\"link\\\",\\\"32\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"sizes\\\":\\\"any\\\"}],[\\\"$\\\",\\\"link\\\",\\\"33\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"https://yxvwcvyczjjes5ua.public.blob.vercel-storage.com/favicon.ico\\\"}],[\\\"$\\\",\\\"link\\\",\\\"34\\\",{\\\"rel\\\":\\\"apple-touch-icon\\\",\\\"href\\\":\\\"https://yxvwcvyczjjes5ua.public.blob.vercel-storage.com/favicon.ico\\\"}],[\\\"$\\\",\\\"$L13\\\",\\\"35\\\",{}]],\\\"error\\\":null,\\\"digest\\\":\\\"$undefined\\\"}\\n\"])</script><script>self.__next_f.push([1,\"12:\\\"$b:metadata\\\"\\n\"])</script><script>self.__next_f.push([1,\"14:I[3123,[\\\"2619\\\",\\\"static/chunks/2619-3c9e02e22d10480a.js\\\",\\\"8720\\\",\\\"static/chunks/8720-d7f67a5726cf715d.js\\\",\\\"1728\\\",\\\"static/chunks/1728-cbf7a4f956993280.js\\\",\\\"5239\\\",\\\"static/chunks/5239-9c05ef5316a23271.js\\\",\\\"3123\\\",\\\"static/chunks/3123-6349cd95c447b0cc.js\\\",\\\"8974\\\",\\\"static/chunks/app/page-c1001dbb9e8ccbcc.js\\\"],\\\"default\\\"]\\n15:I[6040,[\\\"2619\\\",\\\"static/chunks/2619-3c9e02e22d10480a.js\\\",\\\"8720\\\",\\\"static/chunks/8720-d7f67a5726cf715d.js\\\",\\\"1728\\\",\\\"static/chunks/1728-cbf7a4f956993280.js\\\",\\\"5239\\\",\\\"static/chunks/5239-9c05ef5316a23271.js\\\",\\\"3123\\\",\\\"static/chunks/3123-6349cd95c447b0cc.js\\\",\\\"8974\\\",\\\"static/chunks/app/page-c1001dbb9e8ccbcc.js\\\"],\\\"default\\\"]\\n16:T433,\"])</script><script>self.__next_f.push([1,\"In a single night inside a Tokyo love hotel, two damaged lives intersect under the pressure of desperation, fantasy, and self-erasure. A failed businessman planning his own death hires a call girl, only for their transaction to unravel into something unstable and emotionally raw. Love Hotel operates within the framework of pink cinema, yet consistently resists its expectations, redirecting erotic spectacle toward exhaustion, confession, and psychological exposure. Sex here is not titillation but a temporary suspension of consequence—a space where shame can be voiced without permanence.\\n\\nSōmai’s long takes and restless camera movement trap the characters in real time, refusing narrative shortcuts or moral framing. The hotel room becomes a liminal zone between performance and collapse, where power shifts moment to moment and intimacy feels both compulsory and unreachable. Stripped of glamour and redemption, Love Hotel presents desire as a survival mechanism already failing, and connection as something briefly possible only when nothing else remains intact.\"])</script><script>self.__next_f.push([1,\"17:T409,\"])</script><script>self.__next_f.push([1,\"In the sun-drenched interzones between Istanbul and the Spanish coast, a young woman becomes entangled with a hypnotic vampire whose erotic pull dissolves the boundaries between dream, desire, and death. Vampyros Lesbos abandons conventional horror mechanics in favour of atmosphere and repetition, drifting through nocturnal clubs, modernist interiors, and bloodless acts of seduction that feel more ritualistic than violent. Franco treats vampirism less as a curse than as a state of erotic dislocation—an endless present where pleasure overrides causality and identity slips out of focus. \\n\\nAnchored by Soledad Miranda’s uncanny screen presence and propelled by a hallucinatory jazz-funk score, the film occupies a singular space between exploitation cinema and avant-garde mood piece. Its languid pacing and fetishistic surfaces mask a deeper emptiness at the core, where liberation and annihilation become indistinguishable, and desire circulates without resolution.\\n\\n+ Introduction by Filmmaker \\u0026 Programmer, Craig Williams\"])</script><script>self.__next_f.push([1,\"18:T47d,\"])</script><script>self.__next_f.push([1,\"On the streets of Brooklyn, a cop’s pursuit of a psychopath who murdered his partner escalates into a one-man campaign of humiliation, intimidation, and retributive violence. Out for Justice strips the police thriller down to its rawest components: territorial masculinity, public dominance, and justice reduced to spectacle. Steven Seagal’s Gino Felino operates less as a lawman than as an unstoppable corrective force, moving through bars, alleys, and family spaces with absolute certainty and zero moral hesitation.\\n\\nFlynn frames the city as a hostile arena where order is imposed, not negotiated, and where legality is secondary to personal codes of loyalty and honour. The film’s notorious confrontations—played out in full view of the community—transform justice into a performance designed to shame as much as punish. Devoid of irony or self-reflection, Out for Justice embodies a particular early-90s fantasy of control: blunt, territorial, and brutally efficient, offering catharsis not through resolution, but through dominance asserted until resistance collapses.\\n\\nThis screening is presented by Scanners, Inc. from a 35mm scan.\"])</script><script>self.__next_f.push([1,\"19:T471,\"])</script><script>self.__next_f.push([1,\"In a decaying urban high school ruled by gangs, intimidation, and institutional collapse, an idealistic music teacher enters a system already beyond repair. Class of 1984 weaponises the teen delinquent film, escalating it into something closer to vigilante horror, where authority is systematically humiliated and civility proves to be a fatal weakness. Lester frames the school as a closed ecosystem of aggression—corridors as battlegrounds, classrooms as holding cells, where violence is not aberrant but structural.\\n\\nThe film’s moral universe is stark and unsentimental: attempts at reform are punished, empathy is exploited, and retaliation becomes the only language left intact. Its lurid set-pieces and confrontational tone reflect early-80s anxieties about social breakdown, youth nihilism, and the perceived failure of liberal restraint. Class of 1984 offers no rehabilitation narrative and no clean resolution—only the grim suggestion that once authority collapses, order can be restored only through force, leaving victory indistinguishable from surrender.\\n\\nThis screening is presented by Scanners, Inc. from a 35mm scan.\"])</script><script>self.__next_f.push([1,\"1a:T4a4,\"])</script><script>self.__next_f.push([1,\"When a devout Midwestern businessman travels to Los Angeles in search of his missing daughter, he descends into the commercialised labyrinth of the pornography industry, confronting a world that operates by entirely different moral and economic laws. Hardcore reframes the detective narrative as a spiritual crisis, charting not just a physical search but the collapse of a belief system unable to survive contact with late-70s American capitalism. Schrader’s direction is austere and punitive, refusing sensationalism even as it exposes exploitation, coercion, and commodified intimacy.\\n\\nThe film’s power lies in its refusal to grant moral superiority to any side: faith offers no protection, transgression offers no freedom, and revelation provides no cleansing. As the father pushes deeper into spaces he cannot control or comprehend, the film reveals the violence inherent in both repression and consumption. Hardcore ultimately presents America as a divided landscape held together by denial, where innocence is a constructed fantasy and exposure brings not salvation, but a quieter, more devastating form of loss.\\n\\nThis screening is presented by Scanners, Inc. from a 35mm scan.\"])</script><script>self.__next_f.push([1,\"7:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"min-h-screen bg-white text-black\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L14\\\",null,{}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-[1200px] mx-auto px-1 pt-[145px]\\\",\\\"children\\\":[\\\"$\\\",\\\"main\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$L15\\\",null,{\\\"initialScreenings\\\":[{\\\"id\\\":27,\\\"filmId\\\":18,\\\"screeningDate\\\":\\\"2026-01-02T18:30\\\",\\\"doorsTime\\\":\\\"6.00om\\\",\\\"filmTime\\\":\\\"6.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":37,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":18,\\\"title\\\":\\\"THE WASHING MACHINE\\\",\\\"description\\\":\\\"A young inspector arrives at the home of three sisters to investigate one of their disappearances. One of the girls claims to have seen her sisters body in the washing machine. But when the inspector checks its gone! Was it a horrifying vision or something more sinister?? As the inspector uncovers the mystery he becomes tangled in the sisters twisted sex games. A delightfully bizarre and incredibly sleazy giallo - filled with mystery, violence and one of a kind Italian charm.\\\",\\\"runtime\\\":90,\\\"year\\\":1993,\\\"country\\\":\\\"Italy\\\",\\\"director\\\":\\\"Ruggero Deodato\\\",\\\"imageUrl\\\":\\\"https://yxvwcvyczjjes5ua.public.blob.vercel-storage.com/washing-machine2.jpg\\\",\\\"imageCropX\\\":0,\\\"imageCropY\\\":50}},{\\\"id\\\":28,\\\"filmId\\\":19,\\\"screeningDate\\\":\\\"2026-01-02T21:00\\\",\\\"doorsTime\\\":\\\"8.30pm\\\",\\\"filmTime\\\":\\\"9.00pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":18,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":19,\\\"title\\\":\\\"MYSTERY MOVIE\\\",\\\"description\\\":\\\"Not for the easily offended, and strictly programmed for adult audiences only - our mystery films are eye-popping forays into the bold and bonkers world of psychotronic cinema. Expect the unacceptable.\\\",\\\"runtime\\\":null,\\\"year\\\":null,\\\"country\\\":\\\"?\\\",\\\"director\\\":\\\"?\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/8b8bc1295688524c286d059c89ec7cba6a86bb06efc976a6d00d9ff71c64241b/Screenshot-2025-11-30-at-19.15.39.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":29,\\\"filmId\\\":20,\\\"screeningDate\\\":\\\"2026-01-03T18:30\\\",\\\"doorsTime\\\":\\\"6.00pm\\\",\\\"filmTime\\\":\\\"6.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":37,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":20,\\\"title\\\":\\\"CAFE FLESH\\\",\\\"description\\\":\\\"In a post-apocalyptic world where most survivors are “sex negatives,” human intimacy has become a stage act performed for the immune few. At the surreal nightclub Café Flesh, performers cycle through bizarre, dreamlike routines while the uninfected audience watches with hungry detachment. When a man discovers he might not be “negative” after all, the revelation threatens the uneasy balance of desire and despair holding the place together.\\\\n\\\\n\\\\nA cult landmark of punk-infused erotica and midnight-movie surrealism, Café Flesh blends cabaret spectacle with dystopian melancholy. The result is a strange, intoxicating vision of lust, alienation, and performance at the end of the world.\\\",\\\"runtime\\\":75,\\\"year\\\":1982,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Stephen Sayadian\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/a774c3c2c9023dccca5fd62001d3231c0434bfcebde702fd4032714464168b6b/Screenshot-2025-11-27-at-21.50.59.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":30,\\\"filmId\\\":21,\\\"screeningDate\\\":\\\"2026-01-03T20:45\\\",\\\"doorsTime\\\":\\\"8.15pm\\\",\\\"filmTime\\\":\\\"8.45pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":16,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":21,\\\"title\\\":\\\"SQUALOR MOTEL\\\",\\\"description\\\":\\\"Newlywed Nancy checks into Squalor Motel, a twenty-dollar-a-night den of erotic excess and bizarre curiosities. Under the watchful eye of Manny, the sleazy proprietor, and with the help of Miss Clark and the eccentric Dr. Thumbs, she is drawn into a whirlwind of kink, humiliation, and surreal encounters.\\\\n\\\\n\\\\nCulminating in the sex-and-rock playground of The Reptile Room, Squalor Motel is a wild, audacious vision of 1980s adult cinema, blending sleaze, humour, and theatricality into a decadent, unforgettable experience.\\\",\\\"runtime\\\":80,\\\"year\\\":1985,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Kim Christy\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/786d597eabd98388ee1990907448452cc71dc56ee468535e79ed0319ff173ca9/Screenshot-2025-11-27-at-21.57.37.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":31,\\\"filmId\\\":14,\\\"screeningDate\\\":\\\"2026-01-04T17:00\\\",\\\"doorsTime\\\":\\\"4.30pm\\\",\\\"filmTime\\\":\\\"5pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":23,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":14,\\\"title\\\":\\\"STRANGE DAYS\\\",\\\"description\\\":\\\"Former policeman Lenny Nero has moved into a more lucrative trade: the illegal sale of virtual reality-like recordings that allow users to experience the emotions and past experiences of others. While they typically contain tawdry incidents, Nero is shocked when he receives one showing a murder.\\\\n\\\\nSleek, urgent, and morally tangled, Strange Days fuses cyberpunk aesthetics with deeply human concerns, capturing a society teetering between collapse and reinvention as the century turns.\\\",\\\"runtime\\\":145,\\\"year\\\":1995,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Kathryn Bigelow\\\",\\\"imageUrl\\\":\\\"https://images.mubicdn.net/images/film/17541/cache-12740-1745489673/image-w1280.jpg\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":32,\\\"filmId\\\":22,\\\"screeningDate\\\":\\\"2026-01-04T20:30\\\",\\\"doorsTime\\\":\\\"8pm\\\",\\\"filmTime\\\":\\\"8.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":37,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":22,\\\"title\\\":\\\"GLORIA\\\",\\\"description\\\":\\\"Gloria Swenson is a tough, self-reliant woman who has left her mob-connected past behind, only to be thrust into danger when a young boy’s family is brutally murdered. Tasked with protecting the traumatized child from relentless killers, Gloria navigates the gritty streets of New York with a mix of grit, cunning, and raw instinct. Every encounter tests her resilience as she fights to keep both of them alive.\\\\n\\\\n\\\\nA tense and stylish urban thriller, Gloria showcases Cassavetes’ trademark focus on character and emotion. Gena Rowlands delivers a fierce, magnetic performance, transforming Gloria into a modern antiheroine whose toughness is matched only by her humanity.\\\",\\\"runtime\\\":123,\\\"year\\\":1980,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"John Cassavetes\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/1f310490b75638fd25dcdac8b28c69e981feba8ef54aae98b2c28ad06330c685/Screenshot-2025-11-27-at-22.02.39.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":33,\\\"filmId\\\":23,\\\"screeningDate\\\":\\\"2026-01-06T18:30\\\",\\\"doorsTime\\\":\\\"6pm\\\",\\\"filmTime\\\":\\\"6.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":7,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":23,\\\"title\\\":\\\"LAKE OF DRACULA\\\",\\\"description\\\":\\\"Haunted by a childhood encounter with a pale, golden‑eyed vampire, schoolteacher Akiko faces renewed terror when a coffin appears near her lakeside home and victims begin turning up drained of blood.\\\\n\\\\n\\\\nA moody Gothic horror, Lake of Dracula blends Western vampire tropes with Japanese atmosphere, using eerie mansions and misty lakesides to craft a slow‑burn, unsettling tale of dread and nostalgia.\\\",\\\"runtime\\\":82,\\\"year\\\":1971,\\\"country\\\":\\\"Japan\\\",\\\"director\\\":\\\"Michio Yamamoto\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/84380a0e59a70058786055084bfca8fb49563a6b85fdd1ed93531a15057039ca/Screenshot-2025-11-27-at-22.17.35.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":34,\\\"filmId\\\":24,\\\"screeningDate\\\":\\\"2026-01-06T20:30\\\",\\\"doorsTime\\\":\\\"8pm\\\",\\\"filmTime\\\":\\\"8.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":6,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":24,\\\"title\\\":\\\"COLD FISH\\\",\\\"description\\\":\\\"Shy, downtrodden salesman Shamoto’s life is upended when he meets the charismatic and sinister Murata, owner of a tropical fish store. Drawn into Murata’s violent and manipulative world, Shamoto becomes complicit in crimes that escalate from petty fraud to shocking murder. As the pair spiral deeper into brutality, the line between predator and victim blurs, with devastating consequences.\\\\n\\\\n\\\\nA darkly comic and unflinching thriller, Cold Fish blends grotesque violence with sharp social satire, delivering a tense, morally twisted exploration of obsession, greed, and human depravity.\\\",\\\"runtime\\\":146,\\\"year\\\":2010,\\\"country\\\":\\\"Japan\\\",\\\"director\\\":\\\"Sion Sono\\\",\\\"imageUrl\\\":\\\"https://thirdwindowfilms.com/wp-content/uploads/2018/02/COLD_FISH-_Asuaka-Kurosawa.jpg\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":35,\\\"filmId\\\":26,\\\"screeningDate\\\":\\\"2026-01-07T18:30\\\",\\\"doorsTime\\\":\\\"6pm\\\",\\\"filmTime\\\":\\\"6.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":4,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":26,\\\"title\\\":\\\"MASSACRE MAFIA STYLE\\\",\\\"description\\\":\\\"When a small-time mobster witnesses the brutal murder of his family, he embarks on a violent quest for revenge against the city’s criminal underworld. As he systematically hunts down those responsible, the killings escalate into a bloody, relentless spiral, with loyalty, greed, and betrayal fueling the chaos.\\\\n\\\\n\\\\nA raw and gritty exploitation crime thriller, Massacre Mafia Style delivers unflinching violence and street-level realism, blending revenge‑driven action with the seedy glamour of 1970s Mafia culture.\\\",\\\"runtime\\\":82,\\\"year\\\":1974,\\\"country\\\":\\\"1974\\\",\\\"director\\\":\\\"Duke Mitchell\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/09923e933351d45603be1caab894fe9ba34e27095862b166ad331b65e77bc8b2/Screenshot-2025-11-27-at-22.27.51.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":36,\\\"filmId\\\":25,\\\"screeningDate\\\":\\\"2026-01-07T20:45\\\",\\\"doorsTime\\\":\\\"8.15pm\\\",\\\"filmTime\\\":\\\"8.45pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":2,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":25,\\\"title\\\":\\\"GONE WITH THE POPE\\\",\\\"description\\\":\\\"A small band of ex–special forces mercenaries, led by a ruthless Vietnam vet known as “Machine Gun” Kelly, scheme to kidnap the Pope and hold the Vatican for ransom. As that plan unravels, their desperation and internal betrayals send the plot spiraling into a chaotic cascade of violence.\\\\n\\\\n\\\\nA rough-edged grindhouse relic, Gone with the Pope is grim, gritty and unpolished — a brutal, unfiltered slice of 1970s exploitation cinema that trades subtlety for raw adrenaline and moral collapse.\\\",\\\"runtime\\\":83,\\\"year\\\":2010,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Duke Mitchell\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/39ce825ec654e5f3f93f6a8ccc93c9f91c12bca2b61269af0986a68ac45afa7c/Screenshot-2025-11-27-at-22.25.40.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":60,\\\"filmId\\\":45,\\\"screeningDate\\\":\\\"2026-01-08T18:30\\\",\\\"doorsTime\\\":\\\"6pm\\\",\\\"filmTime\\\":\\\"6.30om\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":3,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":45,\\\"title\\\":\\\"EYES OF FIRE\\\",\\\"description\\\":\\\"A group of settlers in 18th-century Appalachia flee their village after a mysterious tragedy, only to confront the forest itself, haunted, malevolent, and alive with supernatural forces. As fear and superstition deepen, their bonds fracture, and the wilderness becomes both a physical and psychological nightmare.\\\\n\\\\nA slow, atmospheric blend of folk horror and period drama, Eyes of Fire transforms the untamed landscape into a character itself, exploring human fragility, guilt, and the unseen terrors lurking in nature and the mind.\\\",\\\"runtime\\\":86,\\\"year\\\":1983,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Avery Crounse\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/c273e53a7b9b22d825d2328e6768de2f59d3a6d4035a3ac289de4c4a92ab6107/Screenshot-2025-11-30-at-20.35.42.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":39,\\\"filmId\\\":28,\\\"screeningDate\\\":\\\"2026-01-08T20:45\\\",\\\"doorsTime\\\":\\\"8.15pm\\\",\\\"filmTime\\\":\\\"8.45pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":9,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":28,\\\"title\\\":\\\"CORRUPTION\\\",\\\"description\\\":\\\"Williams receives a mysterious briefcase that grants immense power, but only if he renounces love. Drawn into a shadowy warehouse filled with disturbing sexual tableaux, he descends deeper into a hallucinatory world of control, desire, and moral decay.\\\\n\\\\n\\\\nA bleak and surreal blend of porn, horror, and art-film, Corruption uses stark visuals and minimal plot to craft a disorienting, unsettling journey through human depravity and obsession.\\\",\\\"runtime\\\":78,\\\"year\\\":1983,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Roger Watkins\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/61fec3abd170a74559f50523c9eb6822f4b4a0c4820a8135316f7bfb25947904/Screenshot-2025-11-27-at-22.33.11.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":40,\\\"filmId\\\":29,\\\"screeningDate\\\":\\\"2026-01-09T18:30\\\",\\\"doorsTime\\\":\\\"6pm\\\",\\\"filmTime\\\":\\\"6.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":10,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":29,\\\"title\\\":\\\"LAST HOUSE ON DEAD END STREET\\\",\\\"description\\\":\\\"After being expelled from film school, a disgruntled young man stages a series of increasingly brutal snuff-style murders to exact revenge on a society he despises. Filmed with a raw, guerrilla aesthetic, the killings blur the line between fiction and reality as he drags the audience into his dark, obsessive vision.\\\\n\\\\n\\\\nA grim and controversial exploitation film, Last House on Dead End Street combines amateurish grit with shocking violence, creating a disturbing, unforgettable descent into revenge, nihilism, and obsession.\\\",\\\"runtime\\\":78,\\\"year\\\":1977,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Roger Watkins\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/9ac9d273b7dddecf0724689bd51a06c7e08da9c7fa3ba9e9834bb7a0bcc215c8/Screenshot-2025-11-27-at-22.36.52.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":41,\\\"filmId\\\":19,\\\"screeningDate\\\":\\\"2026-01-09T20:45\\\",\\\"doorsTime\\\":\\\"8.15pm\\\",\\\"filmTime\\\":\\\"8.45pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":2,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":19,\\\"title\\\":\\\"MYSTERY MOVIE\\\",\\\"description\\\":\\\"Not for the easily offended, and strictly programmed for adult audiences only - our mystery films are eye-popping forays into the bold and bonkers world of psychotronic cinema. Expect the unacceptable.\\\",\\\"runtime\\\":null,\\\"year\\\":null,\\\"country\\\":\\\"?\\\",\\\"director\\\":\\\"?\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/8b8bc1295688524c286d059c89ec7cba6a86bb06efc976a6d00d9ff71c64241b/Screenshot-2025-11-30-at-19.15.39.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":42,\\\"filmId\\\":49,\\\"screeningDate\\\":\\\"2026-01-10T15:30\\\",\\\"doorsTime\\\":\\\"3pm\\\",\\\"filmTime\\\":\\\"3.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":5,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":49,\\\"title\\\":\\\"THE MAN WHO SLEEPS\\\",\\\"description\\\":\\\"A young man drifts through Paris in a state of quiet detachment, observing the city and its inhabitants while withdrawing from human connection. Days blend into nights, and routine becomes a meditative, almost hypnotic rhythm as he slips further into isolation.\\\\n\\\\nSparse, introspective, and hauntingly minimal, The Man Who Sleeps captures the alienation of modern life, turning the banality of existence into a profound reflection on solitude, identity, and the passage of time.\\\",\\\"runtime\\\":77,\\\"year\\\":1974,\\\"country\\\":\\\"France\\\",\\\"director\\\":\\\"Bernard Queysanne\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/2de1cfd4575f1beea7dd990e6c004805305d27b027265043bf4c9ba67fe36adc/Screenshot-2025-11-30-at-20.24.41.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":43,\\\"filmId\\\":31,\\\"screeningDate\\\":\\\"2026-01-10T18:00\\\",\\\"doorsTime\\\":\\\"5.30pm\\\",\\\"filmTime\\\":\\\"6pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":7,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":31,\\\"title\\\":\\\"FERAT VAMPIRE\\\",\\\"description\\\":\\\"A rally driver becomes entangled with a mysterious prototype car rumored to run not on fuel but on the lifeblood of its occupants. Drawn in by ambition and the corporation behind the machine, she slips into an obsession that blurs the line between mastery and surrender. Each race pulls her deeper into a world where technology feeds on human desire, and the cost of speed grows perilously high.\\\\n\\\\n\\\\nA sharp blend of satire and horror, Ferat Vampire uses automotive obsession to explore exploitation, seduction, and the illusion of control, building toward a chilling meditation on the price of progress.\\\",\\\"runtime\\\":93,\\\"year\\\":1982,\\\"country\\\":\\\"Czechoslovakia\\\",\\\"director\\\":\\\"Juraj Herz\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/66b6b9e5d2892904e9a5ecc874605daf587a86ca3409bded4ce7e8c5e648c077/Screenshot-2025-11-30-at-18.32.37.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":44,\\\"filmId\\\":30,\\\"screeningDate\\\":\\\"2026-01-10T20:30\\\",\\\"doorsTime\\\":\\\"8pm\\\",\\\"filmTime\\\":\\\"8.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":12,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":30,\\\"title\\\":\\\"THE CREMATOR\\\",\\\"description\\\":\\\"Karel, a mild-mannered crematorium worker, becomes increasingly obsessed with the idea of “cleansing” humanity through death, aligning his private rituals with the rise of Nazi ideology. As his moral compass erodes, he descends into madness, turning the people around him into victims of his delusional sense of duty.\\\\n\\\\n\\\\nA darkly comic and chilling horror, The Cremator blends psychological terror with surreal satire, offering a haunting meditation on complicity, obsession, and the banality of evil.\\\",\\\"runtime\\\":101,\\\"year\\\":1969,\\\"country\\\":\\\"Czechoslovakia\\\",\\\"director\\\":\\\"Juraj Herz\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/be427f4e70cbf9be82e962b08cb6377a23975a594f42c050d61920a65a030f59/Screenshot-2025-11-27-at-23.06.44.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":45,\\\"filmId\\\":33,\\\"screeningDate\\\":\\\"2026-01-11T16:00\\\",\\\"doorsTime\\\":\\\"3.30pm\\\",\\\"filmTime\\\":\\\"4pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":5,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":33,\\\"title\\\":\\\"REFLECTIONS OF EVIL\\\",\\\"description\\\":\\\"A rage-filled street vendor wanders through a warped Los Angeles, stumbling into encounters that twist the city into a feverish labyrinth of paranoia, failed dreams, and collapsing timelines. Haunted by the ghost of his sister and tormented by forces both mundane and uncanny, he barrels through the chaos in a spiral of frustration that borders on apocalyptic.\\\\n\\\\nA ferocious blend of abrasive satire and surreal nightmare, Reflections of Evil channels cultural decay into an overwhelming sensory assault. The film becomes a darkly comic and disorienting vision of obsession, alienation, and a world fraying at every edge.\\\",\\\"runtime\\\":138,\\\"year\\\":2002,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Damon Packard\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/3e99d2a6c76fba2cb47effd6cfe2a1705af7ac35d3b8a0e26230fe087a6fe201/Screenshot-2025-11-30-at-18.38.57.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":46,\\\"filmId\\\":34,\\\"screeningDate\\\":\\\"2026-01-11T20:00\\\",\\\"doorsTime\\\":\\\"7.30pm\\\",\\\"filmTime\\\":\\\"8pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":2,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":34,\\\"title\\\":\\\"HOLLYWOOD 90028\\\",\\\"description\\\":\\\"A lonely, struggling cameraman named Mark moves to Hollywood hoping to break into serious film — but the only jobs he finds are shooting sleazy adult loops. Alienated and sexually frustrated, Mark begins strangling the women he hurts the most. As his grip on reality loosens, his attempt at a fragile connection with a porn actress spirals into horror.\\\\n\\\\n\\\\nBleak and unnerving, Hollywood 90028 submerges you in the underbelly of 1970s Los Angeles — a grim portrait of despair, isolation, and the darkness that festers behind ambition.\\\",\\\"runtime\\\":88,\\\"year\\\":1973,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Christina Hornisher\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/dda5b82163d69980b1422ccb671d751f2471e4aec53db125989fc99649ccc1c7/Screenshot-2025-11-30-at-18.40.41.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":47,\\\"filmId\\\":35,\\\"screeningDate\\\":\\\"2026-01-13T18:30\\\",\\\"doorsTime\\\":\\\"6pm\\\",\\\"filmTime\\\":\\\"6.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":8,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":35,\\\"title\\\":\\\"SHRIME TIME: A NIGHT OF BIZARRO UNDERSEEN ANIME\\\",\\\"description\\\":\\\"From radical student animation collectives to sun-bleached techno-dystopias and gore-drenched horror, Shrime Time shines where the sun daren’t: revealing the backside of seldom-seen Japanese visual culture.\\\\nExpect screenings from the 1960s to the present day, paired with special guests: musicians, artists, researchers and those obsessed with the outermost edges of Japan’s visual imagination.\\\\n\\\\nThe Shirime a y?kai (Japanese folkloric spirit and the evenings conveniently misspelled namesake) whose sole purpose is to startle unsuspecting samurai by revealing an eyeball in place of an arsehole. In his sick, twisted way, Shirime embodies the very spirit of B-cinema - a flash of grotesque brilliance, whose origin and intent remain a mystery, leaving the path forever altered.\\\\n\\\\nSo come. Sit still in the dark.\\\\nLet the rectacular eye stare deep into your curious soul.\\\\n\\\\nThe Shirime is watching.\\\",\\\"runtime\\\":null,\\\"year\\\":null,\\\"country\\\":\\\"Japan\\\",\\\"director\\\":\\\"?\\\",\\\"imageUrl\\\":\\\"https://ticketlab.co.uk/index.php/uploads/37428/Screenshot-2025-08-19-at-11_35806-760x0.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":48,\\\"filmId\\\":36,\\\"screeningDate\\\":\\\"2026-01-13T20:45\\\",\\\"doorsTime\\\":\\\"8.15pm\\\",\\\"filmTime\\\":\\\"8.45pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":4,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":36,\\\"title\\\":\\\"SHORT EYES\\\",\\\"description\\\":\\\"In Manhattan’s House of Detention, the arrival of Clark Davis, accused of a reviled crime, unsettles the fragile balance of an already tense cellblock. As rumours spread, he becomes the focus of a dangerous mix of fear, judgment, and mounting hostility.\\\\n\\\\nA stark and gripping adaptation of Miguel Piñero’s play, Short Eyes captures prison life with raw immediacy and unvarnished honesty, revealing a world where survival depends on shifting loyalties and morality is anything but clear.\\\",\\\"runtime\\\":97,\\\"year\\\":1977,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Robert M. Young\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/078b38526c0318fb71623243dd4a5aa8e789b2ada8af792e5d8859679ec3ef2e/Screenshot-2025-11-27-at-21.39.44.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":49,\\\"filmId\\\":37,\\\"screeningDate\\\":\\\"2026-01-14T18:00\\\",\\\"doorsTime\\\":\\\"5.30pm\\\",\\\"filmTime\\\":\\\"6pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":2,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":37,\\\"title\\\":\\\"NANG NAK\\\",\\\"description\\\":\\\"After returning from war, a young man reunites with his devoted wife in their riverside home, unaware that she died during childbirth and now lingers as a spirit bound by love and sorrow. As neighbors whisper and fear grows, the truth pushes toward a heartbreaking revelation that tests the limits of devotion.\\\\n\\\\nA haunting blend of romance and folklore, Nang Nak transforms a classic Thai legend into a tender and atmospheric tale about loyalty, loss, and the power of longing that refuses to fade.\\\\n\\\\nProgrammed and introduced by Harry Thorfinn-George\\\",\\\"runtime\\\":111,\\\"year\\\":1999,\\\"country\\\":\\\"Thailand\\\",\\\"director\\\":\\\"Nonzee Nimibutr\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/dce1830431a288a4eaaf3caa33671a5848ad02c1f72bcc530f28e597ede2dda7/Screenshot-2025-11-30-at-18.47.31.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":62,\\\"filmId\\\":38,\\\"screeningDate\\\":\\\"2026-01-14T20:45\\\",\\\"doorsTime\\\":\\\"8.15pm\\\",\\\"filmTime\\\":\\\"8.45pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":19,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":38,\\\"title\\\":\\\"DANCE FREAK + VIDEO INTRO\\\",\\\"description\\\":\\\"On the worst day of his life, an unassuming man crosses paths with a feral, hypnotic stranger who looks exactly like him. The encounter detonates his reality: violence erupts, memories collapse, and he wakes days later implicated in crimes he doesn’t understand. As his identity splinters and the city turns hostile, the question isn’t how to clear his name, but whether he can prove he’s even himself.\\\\n\\\\nCo-directed by Alan Resnick and Robby Rackleff, Dance Freak is a low-budget, high-intensity descent into psychological chaos. Blending abrasive humor, stark black-and-white imagery, and a relentless audiovisual assault, the film channels their shared lineage of unsettling genre work into something lean, volatile, and deliberately unhinged.\\\",\\\"runtime\\\":90,\\\"year\\\":2025,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Alan Resnick, Robby Rackleff\\\",\\\"imageUrl\\\":\\\"https://newnextfilmfest.com/wp-content/uploads/2025/09/Dance-Freak-NEWNEXT_1_resize.jpg\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":50,\\\"filmId\\\":39,\\\"screeningDate\\\":\\\"2026-01-15T18:00\\\",\\\"doorsTime\\\":\\\"5.30pm\\\",\\\"filmTime\\\":\\\"6pm\\\",\\\"capacity\\\":33,\\\"ticketsSold\\\":33,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":39,\\\"title\\\":\\\"BULK + Q\\u0026A\\\",\\\"description\\\":\\\"Freelance journalist Corey Harlan is pulled into a bizarre experiment gone wrong when a string‑theory brane explodes, sending him to rescue its creator. Each door he opens leads to another reality, another genre, and a world where names, relationships, and even physics shift unpredictably.\\\\n\\\\nA feverish kaleidoscope of sci‑fi, noir, and genre parody, Bulk is a handcrafted midnight‑movie vortex where chaos reigns and the rules of reality are optional.\\\\n\\\\n+ Q\\u0026A WITH DIRECTOR, BEN WHEATLEY!\\\",\\\"runtime\\\":95,\\\"year\\\":2025,\\\"country\\\":\\\"United Kingdom\\\",\\\"director\\\":\\\"Ben Wheatley\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/5437a8ddf2a823a9216934af492bcd5631445dbc0930c515bca7f4494c7db0ab/Screenshot-2025-11-30-at-18.58.43.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":51,\\\"filmId\\\":48,\\\"screeningDate\\\":\\\"2026-01-16T18:30\\\",\\\"doorsTime\\\":\\\"6pm\\\",\\\"filmTime\\\":\\\"6.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":5,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":48,\\\"title\\\":\\\"NEKROMANTIK\\\",\\\"description\\\":\\\"A young man works for a company that cleans up after traffic accidents, but his obsession with death takes a darker turn when he brings home a corpse to share with his girlfriend. As their macabre fascination deepens, love, desire, and mortality collide in increasingly shocking and taboo ways.\\\\n\\\\n\\\\nUnflinching and transgressive, Nekromantik is a confrontational exploration of obsession, eroticism, and the grotesque, challenging viewers to confront the limits of morality and the allure of the forbidden.\\\",\\\"runtime\\\":71,\\\"year\\\":1988,\\\"country\\\":\\\"Germany\\\",\\\"director\\\":\\\"Jörg Buttgereit\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/ab9ef5cb91b65eac4d0712543b5c8a2ba4c684d7f4887e67042777f6f2831af1/Screenshot-2025-11-30-at-19.27.26.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":52,\\\"filmId\\\":19,\\\"screeningDate\\\":\\\"2026-01-16T20:45\\\",\\\"doorsTime\\\":\\\"8.15pm\\\",\\\"filmTime\\\":\\\"8.45pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":0,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":19,\\\"title\\\":\\\"MYSTERY MOVIE\\\",\\\"description\\\":\\\"Not for the easily offended, and strictly programmed for adult audiences only - our mystery films are eye-popping forays into the bold and bonkers world of psychotronic cinema. Expect the unacceptable.\\\",\\\"runtime\\\":null,\\\"year\\\":null,\\\"country\\\":\\\"?\\\",\\\"director\\\":\\\"?\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/8b8bc1295688524c286d059c89ec7cba6a86bb06efc976a6d00d9ff71c64241b/Screenshot-2025-11-30-at-19.15.39.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":53,\\\"filmId\\\":40,\\\"screeningDate\\\":\\\"2026-01-17T15:30\\\",\\\"doorsTime\\\":\\\"3pm\\\",\\\"filmTime\\\":\\\"3.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":6,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":40,\\\"title\\\":\\\"SANTA SANGRE\\\",\\\"description\\\":\\\"Freakishly scarred by a traumatic childhood, young Fenix grows up under the oppressive influence of his circus-performer parents. When tragedy strikes, he becomes the puppet of his mother’s murderous obsession, carrying out brutal acts while trapped between guilt, devotion, and desire. The lines between reality, hallucination, and ritual blur in a kaleidoscopic descent into violence and surreal spectacle.\\\\n\\\\nA hypnotic fusion of horror, surrealism, and carnival grotesque, Santa Sangre explores obsession, trauma, and the intoxicating power of performance in a world where blood and devotion are inseparable.\\\",\\\"runtime\\\":122,\\\"year\\\":1989,\\\"country\\\":\\\"Mexico/Italy\\\",\\\"director\\\":\\\"Alejandro Jodorowsky\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/0e4823be223e5c0ef8727b77c116f89e07b4806928c25d90ab76af996bb07a0d/Screenshot-2025-11-30-at-19.24.59.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":54,\\\"filmId\\\":41,\\\"screeningDate\\\":\\\"2026-01-17T18:30\\\",\\\"doorsTime\\\":\\\"6pm\\\",\\\"filmTime\\\":\\\"6.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":7,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":41,\\\"title\\\":\\\"TRASH HUMPERS\\\",\\\"description\\\":\\\"Follow a small group of elderly “Peeping Toms” through the shadows and margins of an unfamiliar world. Crudely documented by the participants themselves, we follow the debased and shocking actions of a group of true sociopaths the likes of which have never been seen before. Inhabiting a world of broken dreams and beyond the limits of morality, they crash against a torn and frayed America.\\\",\\\"runtime\\\":78,\\\"year\\\":2009,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Harmony Korine\\\",\\\"imageUrl\\\":\\\"https://res.cloudinary.com/flatpack/image/upload/c_fill,f_auto,h_1020,q_90,w_1800/v1/from_wordpress/hump.jpg\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":55,\\\"filmId\\\":42,\\\"screeningDate\\\":\\\"2026-01-17T20:30\\\",\\\"doorsTime\\\":\\\"8pm\\\",\\\"filmTime\\\":\\\"8.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":6,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":42,\\\"title\\\":\\\"MEET THE FEEBLES\\\",\\\"description\\\":\\\"Heidi, star of the “Meet The Feebles Variety Hour” discovers her lover Bletch the Walrus is cheating on her. And with all the world waiting for the show, the assorted co-stars must contend with drug addiction, extortion, robbery, disease, drug dealing, and murder.\\\",\\\"runtime\\\":93,\\\"year\\\":1989,\\\"country\\\":\\\"New Zealand\\\",\\\"director\\\":\\\"Peter Jackson\\\",\\\"imageUrl\\\":\\\"https://d32qys9a6wm9no.cloudfront.net/images/movies/backdrop/7d/df4c6653e5cef8de66bd9f701b1c6b3c_1280x720.jpg?t=1683848468\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":56,\\\"filmId\\\":43,\\\"screeningDate\\\":\\\"2026-01-18T17:00\\\",\\\"doorsTime\\\":\\\"4.30pm\\\",\\\"filmTime\\\":\\\"5pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":4,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":43,\\\"title\\\":\\\"DELETED SCENES PRESENTS: BARBARELLA\\\",\\\"description\\\":\\\"SEX PILLS! SEX MACHINES! HAIRY GUYS! HAIRLESS GUYS! LOVE!\\\\n\\\\nIn the distant future, sex has fallen out of fashion. Space adventurer Barbarella is tasked by the Earth’s president to travel to another planetary system to retrieve the positronic ray, a powerful weapon of potential mass destruction. Barbarella’s on a mission and nothing will get in her way, except perhaps her sex drive and everyone’s sexual ambition. She’ll help the blind angel Pygar rediscover the will to fly (by having sex with him), and defeat torture device The Excessive Machine (destroying it by outlasting its death-inducing orgasm).\\\\n\\\\nJane Fonda’s fourth and final collaboration with her then-husband Roger Vadim created one of film’s most memorable characters and sex symbols, placing Fonda at the epicentre of 60s culture and turning her into a true icon and poster child of the decade’s sexual freedom.\\\\n\\\\nThis screening is part of I LOVE YOU JANE FONDA!, the first double bill night by Deleted Scenes.\\\",\\\"runtime\\\":98,\\\"year\\\":1968,\\\"country\\\":\\\"France/Italy\\\",\\\"director\\\":\\\"Roger Vadim\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/351dd116039177600a25b1ab7dd48c3ca5572250f86e7d7c6d66d9c143f2f0ec/Screenshot-2025-11-30-at-20.30.23.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":57,\\\"filmId\\\":44,\\\"screeningDate\\\":\\\"2026-01-18T19:30\\\",\\\"doorsTime\\\":\\\"7pm\\\",\\\"filmTime\\\":\\\"7.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":6,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":44,\\\"title\\\":\\\"DELETED SCENES PRESENTS: WALK ON THE WILD SIDE\\\",\\\"description\\\":\\\"Dove Linkhorn (Laurence Harvey) meets teen rebel Kitty Twist (Jane Fonda) hitchhiking and train-hopping from Texas to Louisiana in search of his long-lost love Hallie Gerard (Capucine). When they reach New Orleans, he finds Hallie working at a brothel. Dove wants to whisk her away, but he’ll have to go through madam Jo Courtney (Barbara Stanwyck) first, who’s obsessed with Hallie and also lures Kitty in, enlisting her as the brothel’s youngest girl with far-reaching consequences. \\\\n\\\\nJane Fonda is a bombshell in her second role in this film noir, an early showcase of her magnetic screen presence and a foreshadowing of the sex-on-legs icon she’d become throughout the decade with films like Joy House, Circle of Love and Barbarella.\\\\n\\\\nThis screening is part of I LOVE YOU JANE FONDA!, the first double bill night by Deleted Scenes.\\\",\\\"runtime\\\":114,\\\"year\\\":1962,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Edward Dmytryk\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/9de4658f75be2d2adec55ebcbd6b4ba6ee786674298460faa57bb616de994d43/Screenshot-2025-11-30-at-20.32.19.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":85,\\\"filmId\\\":71,\\\"screeningDate\\\":\\\"2026-01-20T18:30\\\",\\\"doorsTime\\\":\\\"6pm\\\",\\\"filmTime\\\":\\\"6.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":5,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":71,\\\"title\\\":\\\"BEYOND THE INFINITE TWO MINUTES\\\",\\\"description\\\":\\\"In a small café, a seemingly ordinary television reveals a glimpse of the future: exactly two minutes ahead. The café owner and his friends experiment with this time loop, only for simple curiosity to cascade into chaos, comedy, and escalating temporal confusion. Beyond the Infinite Two Minutes transforms a low-stakes premise into a labyrinth of cause and effect, where every action multiplies and timelines overlap in unexpected ways.\\\\n\\\\nYamaguchi’s long-take cinematography and meticulous real-time framing create a kinetic, immersive experience, trapping characters—and viewers—in the cascading logic of near-future sight. What begins as a playful experiment becomes a study of consequence, improvisation, and human desire to control the uncontrollable. Time here is both a tool and a trap, and connection feels urgent, fleeting, and perpetually one step ahead of itself.\\\",\\\"runtime\\\":87,\\\"year\\\":2020,\\\"country\\\":\\\"Japan\\\",\\\"director\\\":\\\"Junta Yamaguchi\\\",\\\"imageUrl\\\":\\\"https://thatshelf.com/wp-content/uploads/2021/08/BEYOND-THE-INFINITE-2-MINUTES.jpg\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":86,\\\"filmId\\\":70,\\\"screeningDate\\\":\\\"2026-01-20T20:45\\\",\\\"doorsTime\\\":\\\"8.15pm\\\",\\\"filmTime\\\":\\\"8.45\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":7,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":70,\\\"title\\\":\\\"LOVE HOTEL\\\",\\\"description\\\":\\\"$16\\\",\\\"runtime\\\":88,\\\"year\\\":1985,\\\"country\\\":\\\"Japan\\\",\\\"director\\\":\\\"Shinji Sōmai\\\",\\\"imageUrl\\\":\\\"https://www.siff.net/images/CINEMA/2025/Film%20Jun-Dec/CIN_LoveHotel_1600x900.jpg\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":58,\\\"filmId\\\":47,\\\"screeningDate\\\":\\\"2026-01-21T18:30\\\",\\\"doorsTime\\\":\\\"6pm\\\",\\\"filmTime\\\":\\\"6.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":8,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":47,\\\"title\\\":\\\"THE FALL OF THE HOUSE OF USHER + LIVE SCORE\\\",\\\"description\\\":\\\"Jean Epstein’s silent adaptation of Poe’s tale is a masterclass in early cinematic expressionism, merging abstract imagery with atmospheric tension. The decaying Usher estate, filmed in shadowed chiaroscuro, embodies psychological collapse, while the film’s experimental editing and camera movement intensify the narrative’s dreamlike terror. A touchstone of avant-garde horror, it remains visually hypnotic nearly a century later.\\\\n\\\\nPresented from a unique 35mm film print scan with a live score by Marika Tyler-Clark\\\",\\\"runtime\\\":63,\\\"year\\\":1928,\\\"country\\\":\\\"France\\\",\\\"director\\\":\\\"Jean Epstein\\\",\\\"imageUrl\\\":\\\"https://yxvwcvyczjjes5ua.public.blob.vercel-storage.com/Screenshot%202025-12-31%20at%2000.57.00.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":63,\\\"filmId\\\":50,\\\"screeningDate\\\":\\\"2026-01-22T18:30\\\",\\\"doorsTime\\\":\\\"6pm\\\",\\\"filmTime\\\":\\\"6.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":2,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":50,\\\"title\\\":\\\"THE WITCH THAT CAME FROM THE SEA\\\",\\\"description\\\":\\\"A troubled woman named Molly works nights as a waitress at a seaside bar while caring for her young nephews by day. Haunted by memories of childhood abuse at the hands of her sea‑captain father, she becomes increasingly tormented by nightmares and fantasies. As her grip on reality slips, she begins seducing men and enacting a brutal, vengeful murder spree.\\\\n\\\\nBleak and disturbing, The Witch Who Came from the Sea is more psychological horror than supernatural — a grim portrait of trauma, repression, and rage that turns intimacy into terror and the ocean’s memory into a twisted obsession.\\\",\\\"runtime\\\":88,\\\"year\\\":1976,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Matt Cimber\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/847896a07f572fb73a4431958de843c91ec46f3a02a54e18acd98cf2dc751bde/Screenshot-2025-11-30-at-20.55.50.png\\\",\\\"imageCropX\\\":99,\\\"imageCropY\\\":50}},{\\\"id\\\":64,\\\"filmId\\\":51,\\\"screeningDate\\\":\\\"2026-01-22T20:45\\\",\\\"doorsTime\\\":\\\"8.15pm\\\",\\\"filmTime\\\":\\\"8.45pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":5,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":51,\\\"title\\\":\\\"BEAUTY AND THE BEAST\\\",\\\"description\\\":\\\"A humble village girl becomes the captive of a grotesque Beast, a figure both terrifying and tragic. As she navigates his eerie, shadow-filled castle, fear gives way to curiosity and compassion, revealing the humanity hidden beneath his monstrous exterior.\\\\n\\\\nA darkly gothic and visually striking fairy tale, Juraj Herz’s Beauty and the Beast blends horror and romance, exploring obsession, transformation, and the thin line between terror and tenderness.\\\",\\\"runtime\\\":91,\\\"year\\\":1978,\\\"country\\\":\\\"Czechoslovakia\\\",\\\"director\\\":\\\"Juraj Herz\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/76a26d5324354b104c7d85e4dc2610a4c346d366d39c7bfca06339de6d2ff3f6/Screenshot-2025-11-30-at-21.03.55.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":65,\\\"filmId\\\":38,\\\"screeningDate\\\":\\\"2026-01-23T18:30\\\",\\\"doorsTime\\\":\\\"6pm\\\",\\\"filmTime\\\":\\\"6.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":5,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":38,\\\"title\\\":\\\"DANCE FREAK + VIDEO INTRO\\\",\\\"description\\\":\\\"On the worst day of his life, an unassuming man crosses paths with a feral, hypnotic stranger who looks exactly like him. The encounter detonates his reality: violence erupts, memories collapse, and he wakes days later implicated in crimes he doesn’t understand. As his identity splinters and the city turns hostile, the question isn’t how to clear his name, but whether he can prove he’s even himself.\\\\n\\\\nCo-directed by Alan Resnick and Robby Rackleff, Dance Freak is a low-budget, high-intensity descent into psychological chaos. Blending abrasive humor, stark black-and-white imagery, and a relentless audiovisual assault, the film channels their shared lineage of unsettling genre work into something lean, volatile, and deliberately unhinged.\\\",\\\"runtime\\\":90,\\\"year\\\":2025,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Alan Resnick, Robby Rackleff\\\",\\\"imageUrl\\\":\\\"https://newnextfilmfest.com/wp-content/uploads/2025/09/Dance-Freak-NEWNEXT_1_resize.jpg\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":66,\\\"filmId\\\":19,\\\"screeningDate\\\":\\\"2026-01-23T20:45\\\",\\\"doorsTime\\\":\\\"8.15pm\\\",\\\"filmTime\\\":\\\"8.45pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":4,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":19,\\\"title\\\":\\\"MYSTERY MOVIE\\\",\\\"description\\\":\\\"Not for the easily offended, and strictly programmed for adult audiences only - our mystery films are eye-popping forays into the bold and bonkers world of psychotronic cinema. Expect the unacceptable.\\\",\\\"runtime\\\":null,\\\"year\\\":null,\\\"country\\\":\\\"?\\\",\\\"director\\\":\\\"?\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/8b8bc1295688524c286d059c89ec7cba6a86bb06efc976a6d00d9ff71c64241b/Screenshot-2025-11-30-at-19.15.39.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":67,\\\"filmId\\\":52,\\\"screeningDate\\\":\\\"2026-01-24T16:00\\\",\\\"doorsTime\\\":\\\"3.30pm\\\",\\\"filmTime\\\":\\\"4pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":9,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":52,\\\"title\\\":\\\"POINT BLANK\\\",\\\"description\\\":\\\"After being double-crossed and left for dead, a mysterious man named Walker single-mindedly tries to retrieve the rather inconsequential sum of money that was stolen from him.\\\",\\\"runtime\\\":91,\\\"year\\\":1967,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"John Boorman\\\",\\\"imageUrl\\\":\\\"https://assets.mubicdn.net/images/film/2442/image-w1280.jpg?1745489551\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":68,\\\"filmId\\\":56,\\\"screeningDate\\\":\\\"2026-01-24T18:15\\\",\\\"doorsTime\\\":\\\"5.45pm\\\",\\\"filmTime\\\":\\\"6.15pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":7,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":56,\\\"title\\\":\\\"PRIME CUT\\\",\\\"description\\\":\\\"A seasoned mob enforcer is sent from Chicago to rural Missouri to settle a dispute with a sadistic meatpacking boss whose criminal empire runs as brutally as his slaughterhouses. As the job spirals into a collision of organised crime, forced labour, and industrial violence, the boundaries between urban professionalism and pastoral brutality collapse. Hard-edged and deeply unsettling, Michael Ritchie’s Prime Cut exposes an America where exploitation is systemic and bodies are commodities, blending crime thriller conventions with a bleak, often surreal vision of power, corruption, and survival on the margins.\\\",\\\"runtime\\\":88,\\\"year\\\":1972,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Michael Ritchie\\\",\\\"imageUrl\\\":\\\"https://quadcinema.com/wp-content/uploads/2017/05/Prime-Cut-1400x619.jpg\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":73,\\\"filmId\\\":60,\\\"screeningDate\\\":\\\"2026-01-24T20:45\\\",\\\"doorsTime\\\":\\\"8.15pm\\\",\\\"filmTime\\\":\\\"8.45pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":3,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":60,\\\"title\\\":\\\"IN A GLASS CAGE\\\",\\\"description\\\":\\\"In a secluded coastal villa, a former Nazi doctor—now paralysed and confined to an iron lung—exists in a state of physical ruin and moral stasis. When a mysterious young man enters the household as his carer, the relationship that forms becomes a disturbing excavation of past crimes, suppressed desires, and inherited violence. As power shifts between captor and captive, In a Glass Cage refuses the comfort of redemption or psychological distance, instead staging cruelty as something intimate, cyclical, and disturbingly ordinary. \\\\n\\\\nVillaronga’s debut is among the most confrontational works of post-Franco Spanish cinema: a cold, austere meditation on fascism’s afterlife, where punishment offers no cleansing and innocence is revealed as a fragile fiction. Its clinical compositions and relentless quietude trap the viewer in a moral vacuum, forcing an encounter with evil not as spectacle, but as a lingering condition that survives its perpetrators.\\\",\\\"runtime\\\":112,\\\"year\\\":1986,\\\"country\\\":\\\"Spain\\\",\\\"director\\\":\\\"Agustí Villaronga\\\",\\\"imageUrl\\\":\\\"https://assets.poff.ee/img/F_1_In_A_Glass_Cage_5b391d1208_big_16_9.jpeg\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":69,\\\"filmId\\\":57,\\\"screeningDate\\\":\\\"2026-01-25T15:30\\\",\\\"doorsTime\\\":\\\"3pm\\\",\\\"filmTime\\\":\\\"3.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":6,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":57,\\\"title\\\":\\\"HARD TO BE A GOD\\\",\\\"description\\\":\\\"A group of scientists observe a distant planet locked in a perpetual medieval state, where brutality, ignorance, and superstition dominate everyday life. Disguised as nobles and forbidden to intervene, one emissary moves through a world of mud, violence, and oppression, increasingly consumed by the moral cost of detachment. Monumental, abrasive, and relentlessly immersive, Aleksei German’s Hard to Be a God dismantles the conventions of science fiction, using historical grotesquerie to interrogate power, responsibility, and the limits of enlightenment in the face of human cruelty.\\\",\\\"runtime\\\":177,\\\"year\\\":2013,\\\"country\\\":\\\"Russia/Germany\\\",\\\"director\\\":\\\"Aleksei German\\\",\\\"imageUrl\\\":\\\"https://newcityfilm.com/wp-content/uploads/2015/05/Hard-to-be-a-god.jpg\\\",\\\"imageCropX\\\":0,\\\"imageCropY\\\":50}},{\\\"id\\\":70,\\\"filmId\\\":58,\\\"screeningDate\\\":\\\"2026-01-25T19:30\\\",\\\"doorsTime\\\":\\\"7pm\\\",\\\"filmTime\\\":\\\"7.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":6,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":58,\\\"title\\\":\\\"CHRISTIANE F.\\\",\\\"description\\\":\\\"A thirteen-year-old girl drifts from adolescent boredom into the underground world of drugs, prostitution, and petty crime that surrounds Berlin’s Bahnhof Zoo. What begins as experimentation quickly hardens into dependency, as friendships, family structures, and any sense of safety erode under the pressures of addiction. Stark, unsentimental, and closely rooted in lived testimony, Uli Edel’s Christiane F. documents youth culture at the point of collapse, presenting a bleak social landscape shaped by neglect, urban anonymity, and the quiet brutality of survival at the margins.\\\",\\\"runtime\\\":131,\\\"year\\\":1981,\\\"country\\\":\\\"Germany\\\",\\\"director\\\":\\\"Uli Edel\\\",\\\"imageUrl\\\":\\\"https://s3.amazonaws.com/criterion-production/janus_stills/6740-/28912id_095_0004_28912id_126_w1600.jpg\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":71,\\\"filmId\\\":22,\\\"screeningDate\\\":\\\"2026-01-27T18:00\\\",\\\"doorsTime\\\":\\\"5.30pm\\\",\\\"filmTime\\\":\\\"6pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":11,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":22,\\\"title\\\":\\\"GLORIA\\\",\\\"description\\\":\\\"Gloria Swenson is a tough, self-reliant woman who has left her mob-connected past behind, only to be thrust into danger when a young boy’s family is brutally murdered. Tasked with protecting the traumatized child from relentless killers, Gloria navigates the gritty streets of New York with a mix of grit, cunning, and raw instinct. Every encounter tests her resilience as she fights to keep both of them alive.\\\\n\\\\n\\\\nA tense and stylish urban thriller, Gloria showcases Cassavetes’ trademark focus on character and emotion. Gena Rowlands delivers a fierce, magnetic performance, transforming Gloria into a modern antiheroine whose toughness is matched only by her humanity.\\\",\\\"runtime\\\":123,\\\"year\\\":1980,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"John Cassavetes\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/1f310490b75638fd25dcdac8b28c69e981feba8ef54aae98b2c28ad06330c685/Screenshot-2025-11-27-at-22.02.39.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":75,\\\"filmId\\\":61,\\\"screeningDate\\\":\\\"2026-01-27T20:45\\\",\\\"doorsTime\\\":\\\"8.15pm\\\",\\\"filmTime\\\":\\\"8.45pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":11,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":61,\\\"title\\\":\\\"EVOLUTION OF HORROR PRESENTS: FLESH FOR FRANKENSTEIN 3D\\\",\\\"description\\\":\\\"A deranged scientist and his accomplice attempt to create the perfect human by assembling parts from the dead, infusing their monstrous creations with life and desire. As their experiments spiral out of control, chaos, grotesque humor, and erotic excess collide in a spectacle of shocking decadence.\\\\n\\\\nA campy and transgressive fusion of horror and satire, Flesh for Frankenstein revels in grotesque excess, merging body horror, dark comedy, and surreal commentary on obsession, creation, and human vice.\\\\n+ POST FILM DISCUSSION WITH EVOLUTION OF HORROR\\\",\\\"runtime\\\":95,\\\"year\\\":1973,\\\"country\\\":\\\"Italy/France\\\",\\\"director\\\":\\\"Paul Morrissey \\u0026 Andy Warhol\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/600/q/75/i/06d6f064bf4fbcc436c74dd626d58b9e70e9b085545097e917ca11c85873ab11/Screenshot-2025-11-30-at-21.19.52.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":76,\\\"filmId\\\":62,\\\"screeningDate\\\":\\\"2026-01-28T18:30\\\",\\\"doorsTime\\\":\\\"6pm\\\",\\\"filmTime\\\":\\\"6.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":3,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":62,\\\"title\\\":\\\"CINEMANIA\\\",\\\"description\\\":\\\"A group of obsessive cinephiles navigate New York City in search of screenings, cataloging every film and obsessing over schedules, stars, and trivia. Their lives are consumed by cinema, blending daily routine, personal quirks, and unrelenting devotion to the art form.\\\\n\\\\nA charming and eccentric documentary, Cinemania celebrates obsession, fandom, and the transformative power of movies, offering an intimate glimpse into lives lived entirely through the lens of film.\\\",\\\"runtime\\\":79,\\\"year\\\":2002,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Angela Christlieb \\u0026 Stephen Kijak\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/600/q/75/i/05092e887b3fb3057313292d1e05ca04f027cbb5b97b1f12d7960568fa44f577/Screenshot-2025-11-30-at-21.24.25.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":77,\\\"filmId\\\":55,\\\"screeningDate\\\":\\\"2026-01-28T20:45\\\",\\\"doorsTime\\\":\\\"8.15pm\\\",\\\"filmTime\\\":\\\"8.45pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":9,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":55,\\\"title\\\":\\\"AMERICAN MOVIE\\\",\\\"description\\\":\\\"Mark Borchardt, an aspiring filmmaker in Wisconsin, struggles to complete his low-budget horror film Coven, juggling financial woes, personal setbacks, and relentless ambition. Friends and family become both collaborators and obstacles as he chases his dream against overwhelming odds.\\\\n\\\\nFunny, inspiring, and at times heartbreaking, American Movie is a documentary about obsession, creativity, and the eccentric determination required to make art, capturing the highs and lows of pursuing a passion with unflinching honesty.\\\",\\\"runtime\\\":107,\\\"year\\\":1999,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Chris Smith\\\",\\\"imageUrl\\\":\\\"https://freight.cargo.site/w/800/q/75/i/012e3dfeecedc5cbc88d4caa501c2a4c97c03bb3f65dae6997c15d2f40b0e18c/Screenshot-2025-11-30-at-21.27.18.png\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":78,\\\"filmId\\\":64,\\\"screeningDate\\\":\\\"2026-01-29T18:30\\\",\\\"doorsTime\\\":\\\"6pm\\\",\\\"filmTime\\\":\\\"6.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":4,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":64,\\\"title\\\":\\\"FASCINATION\\\",\\\"description\\\":\\\"In the isolated countryside outside Paris, a fugitive thief seeks refuge in a remote château, only to find himself ensnared in a ritualistic world governed by enigmatic women and unspoken rules. Fascination distils Jean Rollin’s obsessions into their most austere form: minimal dialogue, heightened gestures, and eroticism drained of warmth. \\\\n\\\\nVampirism here is less a narrative engine than a social order—formal, aristocratic, and terminally bored—where violence is ceremonial and desire is rigidly choreographed. Rollin’s camera lingers on bodies and interiors with clinical detachment, emphasising repetition over suspense and atmosphere over causality. The film’s spare structure and sudden brutality converge in a conclusion that rejects romanticism entirely, presenting immortality not as excess or ecstasy, but as a hollow system sustained by habit, blood, and decay.\\\\n\\\\n+ Introduction by Filmmaker \\u0026 Programmer, Craig Williams\\\",\\\"runtime\\\":82,\\\"year\\\":1979,\\\"country\\\":\\\"France\\\",\\\"director\\\":\\\"Jean Rollin\\\",\\\"imageUrl\\\":\\\"https://player.bfi.org.uk/sites/default/files/hero-images/de75422e2765f34a830f2c7a5fd2f3f8.jpg\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":79,\\\"filmId\\\":63,\\\"screeningDate\\\":\\\"2026-01-29T20:45\\\",\\\"doorsTime\\\":\\\"8.15pm\\\",\\\"filmTime\\\":\\\"8.45pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":6,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":63,\\\"title\\\":\\\"VAMPYROS LESBOS\\\",\\\"description\\\":\\\"$17\\\",\\\"runtime\\\":90,\\\"year\\\":1971,\\\"country\\\":\\\"West Germany/Spain\\\",\\\"director\\\":\\\"Jesús Franco\\\",\\\"imageUrl\\\":\\\"https://a.ltrbxd.com/resized/sm/upload/7l/bl/6z/kh/vampyros-lesbos-1200-1200-675-675-crop-000000.jpg?v=440f4ddb75\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":80,\\\"filmId\\\":65,\\\"screeningDate\\\":\\\"2026-01-30T18:30\\\",\\\"doorsTime\\\":\\\"6pm\\\",\\\"filmTime\\\":\\\"6.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":2,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":65,\\\"title\\\":\\\"SCANNERS INC. PRESENTS: KILLING ZOE\\\",\\\"description\\\":\\\"In the suffocating heat of Paris, an American safecracker is drawn into a botched bank robbery that spirals into nihilistic excess, chemical detachment, and self-annihilation. Killing Zoe captures the early-90s collision of cinephilia and disaffection: a film obsessed with its own cool, yet unable to escape the violence and emptiness it performs. Avary stages crime as a closed circuit of bravado and decay, where loyalty erodes under narcotics and adrenaline, and style becomes a form of denial rather than control.\\\\n\\\\nThis screening is presented by Scanners, Inc. from a 35mm scan overseen by Peter Aldanmaz (aka NC-17), responsible for the film’s recent restoration. Drawn from release prints, the scan preserves the texture of the original theatrical experience—grain intact, reel-change marks visible, and damage left unpolished.\\\",\\\"runtime\\\":96,\\\"year\\\":1993,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Roger Avary\\\",\\\"imageUrl\\\":\\\"https://substackcdn.com/image/fetch/$s_!4DBc!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fdd9603c0-b686-400a-8ec5-24e7a0ea1199_1280x688.jpeg\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":81,\\\"filmId\\\":66,\\\"screeningDate\\\":\\\"2026-01-30T20:45\\\",\\\"doorsTime\\\":\\\"8.15pm\\\",\\\"filmTime\\\":\\\"8.45pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":9,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":66,\\\"title\\\":\\\"SCANNERS INC. PRESENTS: THE RULES OF ATTRACTION\\\",\\\"description\\\":\\\"Set within the insulated sprawl of an East Coast liberal arts college, The Rules of Attraction fractures youth into overlapping monologues of desire, resentment, and emotional vacancy. Characters orbit one another without alignment, mistaking proximity for intimacy and indulgence for meaning. Avary adapts Bret Easton Ellis with a cold formalism that mirrors the film’s worldview: time loops, perspectives contradict, and events recur without consequence. Romance is transactional, sex is anesthetic, and connection is endlessly deferred. What emerges is not a cautionary tale but a system—self-contained, performative, and quietly brutal—where everyone is both observer and casualty.\\\\n\\\\nThis screening is presented by Scanners, Inc. from a 35mm scan.\\\",\\\"runtime\\\":110,\\\"year\\\":2002,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Roger Avary\\\",\\\"imageUrl\\\":\\\"https://images.mubicdn.net/images/film/14708/cache-50923-1745491083/image-w1280.jpg\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":82,\\\"filmId\\\":68,\\\"screeningDate\\\":\\\"2026-01-31T15:30\\\",\\\"doorsTime\\\":\\\"3pm\\\",\\\"filmTime\\\":\\\"3.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":4,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":68,\\\"title\\\":\\\"SCANNERS INC. PRESENTS: OUT FOR JUSTICE\\\",\\\"description\\\":\\\"$18\\\",\\\"runtime\\\":91,\\\"year\\\":1989,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"John Flynn\\\",\\\"imageUrl\\\":\\\"https://play-lh.googleusercontent.com/proxy/UQ0Sfg4o-p1lKrjrXauQwvhRbkEYHO7iEGEZ93aJcP4hRGN-DBUHBDDWW71l8hQfEpE-WWGXcxsDlt_DNbT688h1U4eo3tvv4OFdnrZ3yrrp_4U=s1920-w1920-h1080\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":83,\\\"filmId\\\":67,\\\"screeningDate\\\":\\\"2026-01-31T18:00\\\",\\\"doorsTime\\\":\\\"5.30pm\\\",\\\"filmTime\\\":\\\"6pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":2,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":67,\\\"title\\\":\\\"SCANNERS INC. PRESENTS: CLASS OF 1984\\\",\\\"description\\\":\\\"$19\\\",\\\"runtime\\\":98,\\\"year\\\":1982,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Mark L. Lester\\\",\\\"imageUrl\\\":\\\"https://thespool.net/wp-content/uploads/2022/08/CLASS-OF-1984-featured.jpg\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}},{\\\"id\\\":84,\\\"filmId\\\":69,\\\"screeningDate\\\":\\\"2026-01-31T20:30\\\",\\\"doorsTime\\\":\\\"8pm\\\",\\\"filmTime\\\":\\\"8.30pm\\\",\\\"capacity\\\":37,\\\"ticketsSold\\\":1,\\\"format\\\":\\\"Digital\\\",\\\"film\\\":{\\\"id\\\":69,\\\"title\\\":\\\"SCANNERS INC. PRESENTS: HARDCORE\\\",\\\"description\\\":\\\"$1a\\\",\\\"runtime\\\":108,\\\"year\\\":1979,\\\"country\\\":\\\"USA\\\",\\\"director\\\":\\\"Paul Schrader\\\",\\\"imageUrl\\\":\\\"https://substackcdn.com/image/fetch/$s_!HKQm!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F383bcd58-e012-4d31-8d09-ad74302ef021_970x545.jpeg\\\",\\\"imageCropX\\\":50,\\\"imageCropY\\\":50}}]}]}]}]]}]\\n\"])</script></body></html>",
