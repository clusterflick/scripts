eSpecification\\\",\\\"name\\\":\\\"Licensed Bar\\\",\\\"value\\\":true},{\\\"@type\\\":\\\"LocationFeatureSpecification\\\",\\\"name\\\":\\\"Video Shop\\\",\\\"value\\\":true},{\\\"@type\\\":\\\"LocationFeatureSpecification\\\",\\\"name\\\":\\\"35mm Projection\\\",\\\"value\\\":true}]},{\\\"@type\\\":\\\"WebSite\\\",\\\"@id\\\":\\\"https://thenickel.co.uk/#website\\\",\\\"url\\\":\\\"https://thenickel.co.uk\\\",\\\"name\\\":\\\"The Nickel\\\",\\\"description\\\":\\\"Independent cinema, bar and video shop in Clerkenwell, London\\\",\\\"publisher\\\":{\\\"@id\\\":\\\"https://thenickel.co.uk/#organization\\\"},\\\"potentialAction\\\":{\\\"@type\\\":\\\"SearchAction\\\",\\\"target\\\":{\\\"@type\\\":\\\"EntryPoint\\\",\\\"urlTemplate\\\":\\\"https://thenickel.co.uk/?search={search_term_string}\\\"},\\\"query-input\\\":\\\"required name=search_term_string\\\"}}]}\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"b\\\":\\\"Q2onHGwX_VnQoFJ6M4xPL\\\",\\\"p\\\":\\\"\\\",\\\"c\\\":[\\\"\\\",\\\"index\\\"],\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]},\\\"$undefined\\\",\\\"$undefined\\\",true],[\\\"\\\",[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/css/8d04d19f65970b6e.css?dpl=dpl_DMUS3nsZWTmau1dVU7wq9rCWjNnc\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"html\\\",null,{\\\"lang\\\":\\\"en\\\",\\\"children\\\":[[\\\"$\\\",\\\"head\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$2\\\"}}],[\\\"$\\\",\\\"link\\\",null,{\\\"rel\\\":\\\"preconnect\\\",\\\"href\\\":\\\"https://fonts.googleapis.com\\\"}],[\\\"$\\\",\\\"link\\\",null,{\\\"rel\\\":\\\"preconnect\\\",\\\"href\\\":\\\"https://fonts.gstatic.com\\\",\\\"crossOrigin\\\":\\\"anonymous\\\"}],[