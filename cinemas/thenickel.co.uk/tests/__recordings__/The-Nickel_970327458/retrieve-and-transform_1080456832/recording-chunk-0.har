https://twitter.com/thenickelcinema\">X</a> | <a href=\"mailto:info@thenickel.co.uk\">Email</a>\n<br><br>\n<br><a href=\"Home-page\" rel=\"history\">Trailer ︎︎︎</a><br>\n \n<a href=\"Main-Listings-1\" rel=\"history\">Listings ︎︎︎ </a><br><a href=\"About\" rel=\"history\">About ︎︎︎</a><br>\n \n<a href=\"Press\" rel=\"history\">Press ︎︎︎</a><br>\n\n<a href=\"Hire\" rel=\"history\">Hire ︎︎︎<br></a>\n  <br>\n<a href=\"https://dashboard.mailerlite.com/forms/544477/155191597280003603/share\" target=\"_blank\">Mailing list</a><a href=\"https://dashboard.mailerlite.com/forms/544477/155191597280003603/share\" class=\"icon-link\" target=\"_blank\"> ︎︎︎</a>\n  <br>\n  <br>\n      <script src=\"https://groot.mailerlite.com/js/w/webforms.min.js?v176e10baa5e7ed80d35ae235be3d5024\" type=\"text/javascript\"></script><br>\n        <a href=\"http://mailerlite.com/forms/544477/155191597280003603/share\" target=\"_blank\"></a>\n<br><script>\n            fetch(\"https://assets.mailerlite.com/jsonp/544477/forms/155191597280003603/takel\")\n        </script></projectcontent>\n\t\t\t</div>\n\n\t\t\t\n\t\t</bodycopy>\n\t</div>\n\t<div class=\"page_background\"></div>\n\t<style class=\"local-css\" data-target=\"33419197\">\n\t\t[local-style=\"33419197\"] .container_width {\n\twidth: 30% /*!variable_defaults*/;\n}\n\n[local-style=\"33419197\"] body {\n}\n\n[local-style=\"33419197\"] .backdrop {\n}\n\n[local-style=\"33419197\"] .page {\n\tmin-height: 100vh /*!page_height_100vh*/;\n}\n\n[local-style=\"33419197\"] .page_background {\n\tbackground-color: initial /*!page_container_bgcolor*/;\n}\n\n[local-style=\"33419197\"] .content_padding {\n\tpadding-top: 1.9rem /*!main_margin*/;\n\tpadding-bottom: 1.9rem /*!main_margin*/;\n\tpadding-left: 1.9rem /*!main_margin*/;\n\tpadding-right: 1.9rem /*!main_margin*/;\n}\n\n[data-predefined-style=\"true\"] [local-style=\"33419197\"] bodycopy {\n}\n\n[data-predefined-style=\"true\"] [local-style=\"33419197\"] bodycopy a {\n}\n\n[data-predefined-style=