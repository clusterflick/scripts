          "content": {
            "mimeType": "application/json",
            "text": "{\"id\":76,\"filmId\":62,\"screeningDate\":\"2026-01-28T18:30\",\"doorsTime\":\"6pm\",\"filmTime\":\"6.30pm\",\"capacity\":37,\"ticketsSold\":20,\"price\":1100,\"format\":\"Digital\",\"excludeFromGiftVouchers\":false,\"film\":{\"id\":62,\"title\":\"CINEMANIA\",\"description\":\"A group of obsessive cinephiles navigate New York City in search of screenings, cataloging every film and obsessing over schedules, stars, and trivia. Their lives are consumed by cinema, blending daily routine, personal quirks, and unrelenting devotion to the art form.\\n\\nA charming and eccentric documentary, Cinemania celebrates obsession, fandom, and the transformative power of movies, offering an intimate glimpse into lives lived entirely through the lens of film.\",\"runtime\":79,\"year\":2002,\"country\":\"USA\",\"director\":\"Angela Christlieb & Stephen Kijak\",\"imageUrl\":\"https://freight.cargo.site/w/600/q/75/i/05092e887b3fb3057313292d1e05ca04f027cbb5b97b1f12d7960568fa44f577/Screenshot-2025-11-30-at-21.24.25.png\",\"imageCropX\":50,\"imageCropY\":50,\"ageCertificate\":\"12A\"}}",
