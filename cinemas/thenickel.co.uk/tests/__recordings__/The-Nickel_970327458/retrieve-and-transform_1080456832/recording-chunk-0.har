            "text": "{\"id\":101,\"filmId\":19,\"screeningDate\":\"2026-02-06T21:15\",\"doorsTime\":\"8.45pm\",\"filmTime\":\"9.15pm\",\"capacity\":37,\"ticketsSold\":0,\"price\":1100,\"format\":\"Digital\",\"excludeFromGiftVouchers\":false,\"film\":{\"id\":19,\"title\":\"MYSTERY MOVIE\",\"description\":\"Not for the easily offended, and strictly programmed for adult audiences only - our mystery films are eye-popping forays into the bold and bonkers world of psychotronic cinema. Expect the unacceptable.\",\"runtime\":null,\"year\":null,\"country\":\"?\",\"director\":\"?\",\"imageUrl\":\"https://freight.cargo.site/w/800/q/75/i/8b8bc1295688524c286d059c89ec7cba6a86bb06efc976a6d00d9ff71c64241b/Screenshot-2025-11-30-at-19.15.39.png\",\"imageCropX\":50,\"imageCropY\":50,\"ageCertificate\":\"18\"}}",
