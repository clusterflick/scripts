tId&quot;:50312,&quot;numberOfInstances&quot;:1,&quot;allowFacilitatedBooking&quot;:false}\"\n      :import-data=\"{&quot;importId&quot;:&quot;1852402AKJHJCLCBKSNBJVDKQQHMSBBRV&quot;,&quot;importUrl&quot;:&quot;https:\\/\\/tickets.richmix.org.uk\\/richmix&quot;}\"\n      :availability-data=\"{&quot;availabilityOverride&quot;:&quot;syncValue&quot;}\"\n      :button-data=\"{&quot;buttonPreset&quot;:&quot;none&quot;,&quot;buttonTextOverride&quot;:null,&quot;buttonStateOverride&quot;:{&quot;label&quot;:&quot;Sync value&quot;,&quot;value&quot;:&quot;useSyncValue&quot;,&quot;selected&quot;:true,&quot;valid&quot;:true,&quot;icon&quot;:null,&quot;color&quot;:null},&quot;buttonHrefOverride&quot;:null,&quot;buttonDefaultText&quot;:&quot;Book now&quot;,&quot;buttonDefaultUrl&quot;:&quot;https:\\/\\/richmix.org.uk\\/book\\/instance\\/1852402&quot;}\"\n      class=\"\"\n    ><template v-slot:default=\"{dataReady,availability,eligibility,buttonData,onSale,numberOfInstances}\"><em-button class=\"\" :numberOfInstances=\"numberOfInstances\" :data-ready=\"dataReady\" :availability=\"availability\" :eligibility=\"eligibility\" :overrides=\"buttonData\" v-if=\"onSale\"></em-button></template></event-manager></div></div></div></header></div><div class=\"o-sidebar-grid__container\n\t\t\t\t\t\t o-grid o-grid--flush\"\n\t\t\t\t\t\t\tid=\"page-container\"\n\t\t\t\t\t\t><div class=\"o-sidebar-grid__menu\" id=\"page-menu\"></div><aside class=\"o-sidebar-grid__sidebar \"></aside><div class=\"o-sidebar-grid__content\" id=\"page-content\"><section class=\"o-grid\"><h2 class=\"h-accessibility\">About Film Stories Live with Simon Brew</h2><div  id=\"block-50394\" class=\"o-block o-text o-text-block o-grid__item \t\n\t\t\th-colstart--1 h-colend--9 h-phone-colstart--1 h-phone-colend--13 has-h-col\n\t o-block--row-1\" data-block='[]'><h2>A 90 minute live show, with award-winning writer and podcaster Simon Brew. </h2><p>Film Stories Live is a lively, entertaining celebration of the movies. And in 2026, it’s going on tour! Each show is a nerdy dive into cinema, with plenty of laughs, lots of geeking out, and a bunch of stories about the movies. Plus: filmmaking guests, and terrible money-can-buy prizes at the end. Each show will also be filmed and recorded, too.</p><p><a href=\"https://www.instagram.com/simon.brew/\"><strong>Simon Brew Instagram</strong></a></p></div></section></div><aside class=\"o-sidebar-grid__sidebar \" id=\"page-sidebar\"><div class=\"c-meta o-block\"><h2 class=\"c-meta__heading\">Details</h2><dl class=\"c-meta__list\"><div class=\"c-meta__item\"><dt class=\"c-meta__key\">Certificate</dt><dd class=\"c-meta__value\"></dd></div><div class=\"c-meta__item\"><dt class=\"c-meta__key\">Duration</dt><dd class=\"c-meta__value\">90 minutes</dd></div><div class=\"c-meta__item\"><dt class=\"c-meta__key\">Venue</dt><dd class=\"c-meta__value\">SCREEN 1</dd></div></dl></div><section ><div id=\"\" class=\"c-banner c-banner--featured c-banner--small h-theme--white\" data-sc-gtm-category=\"Banner\" data-sc-gtm-label=\"Accessibility\" data-sc-gtm-value=\"\"><h2 class=\"c-banner__title\">Accessibility</h2><div class=\"c-banner__text\"><p>If you have any access requirements, please contact our box office team on<strong> 020 7613 7498 </strong>or email <a href=\"mailto:boxoffice@richmix.org.uk\">boxoffice@richmix.org.uk.</a></p><p><a href=\"https://richmix.org.uk/visit-us/access\">Find all accessibility info for Rich Mix</a>.</p></div></div></section></aside><div class=\"o-sidebar-grid__footer\" id=\"page-footer\"></div></div></main><footer class=\"c-site-footer o-grid h-theme--black\"><div class=\"c-site-footer__container o-grid__item\"><div class=\"c-site-footer__logo\"><div class=\"c-site-logo c-site-logo--footer\"><span class=\"c-site-logo__name h-accessibility\">\n\t\t\t\t\tRich Mix\n\t\t\t\t</span><span class=\"c-site-logo__image\"></span></div></div><span class=\"c-site-footer__tagline\">We are a charity. All our profit serves our mission. </span><div clas