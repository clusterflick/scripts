\"c-page-header__datetime \">From Fri 17 Jul</span><div class=\"c-page-header__action\"><event-manager\n      type=\"event\"\n      :instance-data=\"{&quot;instanceId&quot;:49256,&quot;instanceUrlId&quot;:&quot;1906815&quot;,&quot;stopSellingDate&quot;:&quot;&quot;}\"\n      :event-data=\"{&quot;eventName&quot;:&quot;The Odyssey&quot;,&quot;eventId&quot;:48407,&quot;numberOfInstances&quot;:28,&quot;allowFacilitatedBooking&quot;:false}\"\n      :import-data=\"{&quot;importId&quot;:&quot;1906815AVNJDTTPQJCMJHBGJVBTCQBSSS&quot;,&quot;importUrl&quot;:&quot;https:\\/\\/tickets.richmix.org.uk\\/richmix&quot;}\"\n      :availability-data=\"{&quot;availabilityOverride&quot;:&quot;syncValue&quot;}\"\n      :button-data=\"{&quot;buttonPreset&quot;:&quot;none&quot;,&quot;buttonTextOverride&quot;:null,&quot;buttonStateOverride&quot;:{&quot;label&quot;:&quot;Sync value&quot;,&quot;value&quot;:&quot;useSyncValue&quot;,&quot;selected&quot;:true,&quot;valid&quot;:true,&quot;icon&quot;:null,&quot;color&quot;:null},&quot;buttonHrefOverride&quot;:null,&quot;buttonDefaultText&quot;:&quot;Book now&quot;,&quot;buttonDefaultUrl&quot;:&quot;https:\\/\\/richmix.org.uk\\/cinema\\/the-odyssey-12a#dates-and-times&quot;}\"\n      class=\"\"\n    ><template v-slot:default=\"{dataReady,availability,eligibility,buttonData,onSale,numberOfInstances}\"><em-button class=\"\" :numberOfInstances=\"numberOfInstances\" :data-ready=\"dataReady\" :availability=\"availability\" :eligibility=\"eligibility\" :overrides=\"buttonData\" v-if=\"onSale\"></em-button></template></event-manager></div></div></div></header></div><div class=\"o-sidebar-grid__container\n\t\t\t\t\t\t o-grid o-grid--flush\"\n\t\t\t\t\t\t\tid=\"page-container\"\n\t\t\t\t\t\t><div class=\"o-sidebar-grid__menu\" id=\"page-menu\"></div><aside class=\"o-sidebar-grid__sidebar \"></aside><div class=\"o-sidebar-grid__content\" id=\"page-content\"><section class=\"o-grid\"><h2 class=\"h-accessibility\">About The Odyssey</h2><div  id=\"block-48507\" class=\"o-block o-text o-text-block o-grid__item \t\n\t\t\th-colstart--1 h-colend--9 h-phone-colstart--1 h-phone-colend--13 has-h-col\n\t o-block--row-1\" data-block='[]'><h2>Defy the gods.</h2><p>Odysseus (<strong>Matt Damon</strong>), the legendary King of Ithaca, embarks on a long and perilous journey home following the Trojan War. Throughout his voyage, he is forced to confront the whims of gods, mythological monsters, and trials that stretch both his cunning and his humanity to the breaking point.</p></div><div  id=\"block-48508\" class=\"o-block o-grid__item \t\n\t\t\th-colstart--1 h-colend--9 h-phone-colstart--1 h-phone-colend--13 has-h-col\n\t o-block--row-2\" data-block='[\"text\"]'><div class=\"c-embed\" style=\"--aspect-ratio: 1.77;\"><v-embed\n\t\t\t\tembed-code=\"&quot;&lt;div class=\\&quot;fetch  fetch--youtube\\&quot;&gt;&lt;iframe title=\\&quot;youtube embed\\&quot;  width=\\&quot;200\\&quot; height=\\&quot;113\\&quot; src=\\&quot;https:\\/\\/www.youtube.com\\/embed\\/Mzw2ttJD2qQ?feature=oembed&amp;wmode=transparent\\&quot; frameborder=\\&quot;0\\&quot; allow=\\&quot;accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\\&quot; referrerpolicy=\\&quot;strict-origin-when-cross-origin\\&quot; allowfullscreen title=\\&quot;The Odyssey | Official Trailer\\&quot; &gt;&lt;\\/iframe&gt;&lt;\\/div&gt;&quot;\"\n\t\t\t\t:required-cookie-categories=\"[]\"></v-embed></div></div><div  id=\"block-48509\" class=\"o-block o-text o-text-block o-grid__item \t\n\t\t\th-colstart--1 h-colend--9 h-phone-colstart--1 h-phone-colend--13 has-h-col\n\t o-block--row-3\" data-block='[\"embed\"]'><p>This film is distributed by <a href=\"https://www.universalpictures.co.uk/\"><strong>Universal Pictures</strong></a>. </p></div></section></div><aside class=\"o-sidebar-grid__sidebar \" id=\"page-sidebar\"><div class=\"c-meta o-block\"><h2 class=\"c-meta__heading\">Details</h2><dl class=\"c-meta__list\"><div class=\"c-meta__item\"><dt class=\"c-meta__key\">Certificate</dt><dd class=\"c-meta__value\">12A</dd></div><div class=\"c-meta__item\"><dt class=\"c-meta__key\">Duration</dt><dd class=\"c-meta__value\">172 minutes</dd></div><div class=\"c-meta__item\"><dt class=\"c-meta__key\">Director</dt><dd class=\"c-meta__value\">Christopher Nolan</dd></div><div class=\"c-meta__item\"><dt class=\"c-meta__key\">Venue</dt><dd class=\"c-meta__value\">SCREEN 1</dd></div></dl></div><section ><div id=\"\" class=\"c-banner c-banner--featured c-banner--small h-theme--white\" data-sc-gtm-category=\"Banner\" data-sc-gtm-label=\"Accessibility\" data-sc-gtm-value=\"\"><h2 class=\"c-banner__title\">Accessibility</h2><div class=\"c-banner__text\"><p>If you have any access requirements, please contact our box office team on<strong> 020 7613 7498 </strong>or email <a href=\"mailto:boxoffice@richmix.org.uk\">boxoffice@richmix.org.uk.</a></p><p><a href=\"https://richmix.org.uk/visit-us/access\">Find all accessibility info for Rich Mix</a>.</p></div></div></section><section ><h3 class=\"h-accessibility\">Upsells</h3><ul class=\"o-list\"><li class=\"o-list__item o-grid__item\"><a id=\"\" class=\"c-banner c-banner--deco-two c-banner--featured c-banner--small h-theme--red\" href=\"https://richmix-prod.servd.supercooldesign.dev/membership\" data-sc-gtm-category=\"Banner\" data-sc-gtm-label=\"Rich Mix members enjoy...\" data-sc-gtm-value=\"\"><h2 class=\"c-banner__title\">Rich Mix members enjoy...</h2><div class=\"c-banner__text\"><p>Free tickets on joining &amp; discounted tickets on every visit – plus, no booking fees. </p></div><div class=\"c-banner__action o-button o-button--regular\">Find out more</div><div class=\"c-banner__image\"><div class=\"o-image\"><img class=\"o-image__img\" src=\"https://rich-mix.transforms.svdcdn.com/production/Cinema/Audience-pic.png?w=540&amp;h=360&amp;q=100&amp;auto=format&amp;fit=crop&amp;dm=1781531316&amp;s=18084a2fbd9fbcaaf454ab52aec2f837\" width=\"540\" height=\"360\" alt=\"A group of three women sat in a dimly lit cinema screen, laughing amongst each other, holding drinks and popcorn.\" loading=\"lazy\" style=\"--object-position: 50% 50%;\"></div></div></a></li></ul></section></aside><div class=\"o-sidebar-grid__footer\" id=\"page-footer\"><section class=\"o-grid o-panel h-theme--black o-block\"><div class=\"o-panel__container o-grid__item\"><h3 id=\"dates-and-times\" class=\"o-panel__heading o-panel__heading--subheading\">Dates and Times</h3><div class=\"o-panel__content\"><ul class=\"c-instance-list o-list\"><li class=\"o-list__item c-instance-list__item\"><h2 class=\"c-instance-list__heading\">Friday 17 July</h2><ul class=\"c-instance-list__content o-list\"><li class=\"c-instance-list__subitem o-list__item\"><event-manager\n      type=\"instance\"\n      :instance-data=\"{&quot;instanceId&quot;:48379,&quot;instanceUrlId&quot;:&quot;1904602&quot;,&quot;stopSellingDate&quot;:&quot;&quot;}\"\n      :event-data=\"{&quot;eventName&quot;:&quot;The Odyssey&quot;,&quot;eventId&quot;:48407,&quot;numberOfInstances&quot;:28,&quot;allowFacilitatedBooking&quot;:false}\"\n      :import-data=\"{&quot;importId&quot;:&quot;1904602ANMRPKPNDBKBVBMKVLQVTSPPBR&quot;,&quot;importUrl&quot;:&quot;https:\\/\\/tickets.richmix.org.uk\\/richmix&quot;}\"\n      :availability-data=\"{&quot;availabilityOverride&quot;:&quot;syncValue&quot;}\"\n      :button-data=\"{&quot;buttonPreset&quot;:&quot;none&quot;,&quot;buttonTextOverride&quot;:null,&quot;buttonStateOverride&quot;:{&quot;label&quot;:&quot;Sync value&quot;,&quot;value&quot;:&quot;useSyncValue&quot;,&quot;selected&quot;:true,&quot;valid&quot;:true,&quot;icon&quot;:null,&quot;color&quot;:null},&quot;buttonHrefOverride&quot;:null,&quot;buttonDefaultText&quot;:&quot;Book now&quot;,&quot;buttonDefaultUrl&quot;:&quot;https:\\/\\/richmix.org.uk\\/book\\/instance\\/1904602&quot;}\"\n      class=\"\"\n    ><template v-slot:default=\"{dataReady,eligibility,availability,availabilityLabel,buttonData,onSale}\"><div class=\"c-instance\"><