mb__link--no-link\" itemtype=\"http://schema.org/Thing\" itemprop=\"item\"><span itemprop=\"name\">Black in season film club: Juice</span></span></li></ol></nav></div></div><div class=\"c-page-header__bar c-page-header__bar--bottom o-grid\"><div class=\"c-page-header__container c-page-header__container--bottom o-grid__item\"><div class=\"c-page-header__media\"><picture class=\"o-image o-image--picture\"><source srcset=\"https://rich-mix.transforms.svdcdn.com/production/Cinema/juice-1.jpg?w=1350&amp;h=834&amp;q=100&amp;auto=format&amp;fit=crop&amp;dm=1782918238&amp;s=af3ddf4b56cc862016f091e20cfc53f7\" width=\"1350\" height=\"834\" media=\"(min-width: 900px)\"><source srcset=\"https://rich-mix.transforms.svdcdn.com/production/Cinema/juice-1.jpg?w=900&amp;h=556&amp;q=100&amp;auto=format&amp;fit=crop&amp;dm=1782918238&amp;s=6fc1bd4eaf28de581c5e8a06bc886dec\" width=\"900\" height=\"556\" media=\"(min-width: 600px)\"><img class=\"o-image__img\" src=\"https://rich-mix.transforms.svdcdn.com/production/Cinema/juice-1.jpg?w=600&amp;h=371&amp;q=100&amp;auto=format&amp;fit=crop&amp;dm=1782918238&amp;s=a67eed209f01dfd748917a80677c6708\" width=\"600\" height=\"371\" alt=\"\" loading=\"lazy\"></picture></div><h1 class=\"c-page-header__title \">\n\t\t\t\t\tBlack in season film club: Juice\n\t\t\t\t</h1><span class=\"c-page-header__rating c-tag c-tag--rating\" aria-label=\"Certificate:\">15</span><span class=\"c-page-header__datetime \"><time datetime=\"2026-07-24T19:00:00+01:00\" itemprop=\"startDate\">Fri 24 Jul, 7:00pm</time></span><div class=\"c-page-header__action\"><event-manager\n      type=\"instance\"\n      :instance-data=\"{&quot;instanceId&quot;:50573,&quot;instanceUrlId&quot;:&quot;1909602&quot;,&quot;stopSellingDate&quot;:&quot;&quot;}\"\n      :event-data=\"{&quot;eventName&quot;:&quot;Black in season film club: Juice&quot;,&quot;eventId&quot;:50581,&quot;numberOfInstances&quot;:1,&quot;allowFacilitatedBooking&quot;:false}\"\n      :import-data=\"{&quot;importId&quot;:&quot;1909602ASVJCBVDQHQNQGGCTNKSBJQLVQ&quot;,&quot;importUrl&quot;:&quot;https:\\/\\/tickets.richmix.org.uk\\/richmix&quot;}\"\n      :availability-data=\"{&quot;availabilityOverride&quot;:&quot;syncValue&quot;}\"\n      :button-data=\"{&quot;buttonPreset&quot;:&quot;none&quot;,&quot;buttonTextOverride&quot;:null,&quot;buttonStateOverride&quot;:{&quot;label&quot;:&quot;Sync value&quot;,&quot;value&quot;:&quot;useSyncValue&quot;,&quot;selected&quot;:true,&quot;valid&quot;:true,&quot;icon&quot;:null,&quot;color&quot;:null},&quot;buttonHrefOverride&quot;:null,&quot;buttonDefaultText&quot;:&quot;Book now&quot;,&quot;buttonDefaultUrl&quot;:&quot;https:\\/\\/richmix.org.uk\\/book\\/instance\\/1909602&quot;}\"\n      class=\"\"\n    ><template v-slot:default=\"{dataReady,availability,eligibility,buttonData,onSale,numberOfInstances}\"><em-button class=\"\" :numberOfInstances=\"numberOfInstances\" :data-ready=\"dataReady\" :availability=\"availability\" :eligibility=\"eligibility\" :overrides=\"buttonData\" v-if=\"onSale\"></em-button></template></event-manager></div></div></div></header></div><div class=\"o-sidebar-grid__container\n\t\t\t\t\t\t o-grid o-grid--flush\"\n\t\t\t\t\t\t\tid=\"page-container\"\n\t\t\t\t\t\t><div class=\"o-sidebar-grid__menu\" id=\"page-menu\"></div><aside class=\"o-sidebar-grid__sidebar \"></aside><div class=\"o-sidebar-grid__content\" id=\"page-content\"><section class=\"o-grid\"><h2 class=\"h-accessibility\">About Black in season film club: Juice</h2><div  id=\"block-50625\" class=\"o-block o-text o-text-block o-grid__item \t\n\t\t\th-colstart--1 h-colend--9 h-phone-colstart--1 h-phone-colend--13 has-h-col\n\t o-block--row-1\" data-block='[]'><h2>In the Ghettos of Harlem you don’t buy respect… you earn it.</h2><p>Four Harlem friends – Bishop (<strong>Tupac Shakur</strong>), Q (<strong>Omar Epps</strong>), Steel (<strong>Jermaine Hopkins</strong>) and Raheem (<strong>Khalil Kain</strong>), who dabble in petty crime, decide to go big by robbing a convenience store.</p><p>How far will they go to get 'the juice'?</p></div><div  id=\"block-50626\" class=\"o-block o-grid__item \t\n\t\t\th-colstart--1 h-colend--9 h-phone-colstart--1 h-phone-colend--13 has-h-col\n\t o-block--row-2\" data-block='[\"text\"]'><div class=\"c-embed\" style=\"--aspect-ratio: 1.77;\"><v-embed\n\t\t\t\tembed-code=\"&quot;&lt;div class=\\&quot;fetch  fetch--youtube\\&quot;&gt;&lt;iframe title=\\&quot;youtube embed\\&quot;  width=\\&quot;200\\&quot; height=\\&quot;113\\&quot; src=\\&quot;https:\\/\\/www.youtube.com\\/embed\\/QsWto8p7t1E?feature=oembed&amp;wmode=transparent\\&quot; frameborder=\\&quot;0\\&quot; allow=\\&quot;accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\\&quot; referrerpolicy=\\&quot;strict-origin-when-cross-origin\\&quot; allowfullscreen title=\\&quot;Juice - Trailer\\&quot; &gt;&lt;\\/iframe&gt;&lt;\\/div&gt;&quot;\"\n\t\t\t\t:required-cookie-categories=\"[]\"></v-embed></div></div></section></div><aside class=\"o-sidebar-grid__sidebar \" id=\"page-sidebar\"><div class=\"c-meta o-block\"><h2 class=\"c-meta__heading\">Details</h2><dl class=\"c-meta__list\"><div class=\"c-meta__item\"><dt class=\"c-meta__key\">Certificate</dt><dd class=\"c-meta__value\">15</dd></div><div class=\"c-meta__item\"><dt class=\"c-meta__key\">Duration</dt><dd class=\"c-meta__value\">180 minutes</dd></div><div class=\"c-meta__item\"><dt class=\"c-meta__key\">Director</dt><dd class=\"c-meta__value\">Ernest R. Dickerson</dd></div><div class=\"c-meta__item\"><dt class=\"c-meta__key\">Venue</dt><dd class=\"c-meta__value\">SCREEN 2</dd></div></dl></div><section ><div id=\"\" class=\"c-banner c-banner--featured c-banner--small h-theme--white\" data-sc-gtm-category=\"Banner\" data-sc-gtm-label=\"Accessibility\" data-sc-gtm-value=\"\"><h2 class=\"c-banner__title\">Accessibility</h2><div class=\"c-banner__text\"><p>If you have any access requirements, please contact our box office team on<strong> 020 7613 7498 </strong>or email <a href=\"mailto:boxoffice@richmix.org.uk\">boxoffice@richmix.org.uk.</a></p><p><a href=\"https://richmix.org.uk/visit-us/access\">Find all accessibility info for Rich Mix</a>.</p></div></div></section></aside><div class=\"o-sidebar-grid__footer\" id=\"page-footer\"></div></div></main><footer class=\"c-site-footer o-grid h-theme--black\"><div class=\"c-site-footer__container o-grid__item\"><div class=\"c-site-footer__logo\"><div class=\"c-site-logo c-site-logo--footer\"><span class=\"c-site-logo__name h-accessibility\">\n\t\t\t\t\tRich Mix\n\t\t\t\t</span><span class=\"c-site-logo__image\"></span></div></div><span class=\"c-site-footer__tagline\">We are a charity. All our profit serves our mission. </span><div class=\"c-site-footer__social\"><nav class=\"c-site-social \" aria-label=\"Social Media Links\"><ul class=\"c-site-social__list\"><li class=\"c-site-social__item\"><a class=\"c-site-social__link\" href=\"https://www.instagram.com/richmixlondon\" rel=\"noreferrer\"><span class=\"h-accessibility\">Instagram</span><span class=\"c-site-social__icon icon i-social\" aria-hidden=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"70\" height=\"70\" fill=\"currentColor\" viewBox=\"0 0 70 70\"><g clip-path=\"url(#a)\"><path fill-rule=\"evenodd\" d=\"M35 15c-5.432 0-6.113.023-8.246.12-2.129.097-3.583.436-4.855.93a9.802 9.802 0 0 0-3.542 2.307 9.802 9.802 0 0 0-2.307 3.542c-.494 1.272-.833 2.726-.93 4.855C15.023 28.887 15 29.568 15 35s.023 6.113.12 8.246c.097 2.129.436 3.583.93 4.855a9.802 9.802 0 0 0 2.307 3.542 9.804 9.804 0 0 0 3.542 2.307c1.272.494 2.726.833 4.855.93 2.133.097 2.814.12 8.246.12s6.113-.023 8.246-.12c2.129-.097 3.583-.436 4.855-.93a9.804 9.804 0 0 0 3.542-2.307 9.804 9.804 0 0 0 2.307-3.542c.494-1.272.833-2.726.93-4.855.097-2.133.12-2.814.12-8.246s-.023-6.113-.12-8.246c-.097-2.129-.436-3.583-.93-4.855a9.804 9.804 0 0 0-2.307-3.542 9.802 9.802 0 0 0-3.542-2.307c-1.272-.494-2.726-.833-4.855-.93C41.113 15.023 40.432 15 35 