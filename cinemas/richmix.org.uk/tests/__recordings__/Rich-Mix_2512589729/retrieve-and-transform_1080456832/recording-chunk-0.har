leLanguage\": \"English\"\n    }\n] \n\n  }\n  </script><script type=\"application/ld+json\">\n      {\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"Event\",\n        \"name\": \"Black in season film club: Juice\",\n        \"startDate\": \"2026-07-24T19:00:00+01:00\",\n        \"image\": [\"https://rich-mix.transforms.svdcdn.com/production/Cinema/juice-1.jpg?w=1200&h=600&q=100&auto=format&fit=crop&dm=1782918238&s=2482f0d6c22f7b2e54972ea537274020\",\"https://rich-mix.transforms.svdcdn.com/production/Cinema/juice-1.jpg?w=800&h=600&q=100&auto=format&fit=crop&dm=1782918238&s=3f9fdb03e20cfa9ee7c9c1106c7c8dad\",\"https://rich-mix.transforms.svdcdn.com/production/Cinema/juice-1.jpg?w=600&h=600&q=100&auto=format&fit=crop&dm=1782918238&s=db7a056bd6a36edbf8bb2d34e25cca84\"],\n        \"description\": \"\nIn the Ghettos of Harlem you don’t buy respect… you earn it.Four Harlem friends – Bishop (Tupac Shakur), Q (Omar Epps), Steel (Jermaine Hopkins) and Raheem (Khalil Kain), who dabble in petty crime, decide to go big by robbing a convenience store.How far will they go to get &amp;#039;the juice&amp;#039;?\",\n        \"location\": {\n          \"@type\": \"Place\",\n          \"name\": \"Rich Mix\",\n          \n\n\n\n        }\n      }\n    </script><!-- dev only edit buttons --></body></html>\n",
