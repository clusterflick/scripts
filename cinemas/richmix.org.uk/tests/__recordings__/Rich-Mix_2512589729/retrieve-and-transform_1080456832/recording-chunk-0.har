tonData\" v-if=\"onSale\"></em-button></template></event-manager></div></div></div></header></div><div class=\"o-sidebar-grid__container\n\t\t\t\t\t\t o-grid o-grid--flush\"\n\t\t\t\t\t\t\tid=\"page-container\"\n\t\t\t\t\t\t><div class=\"o-sidebar-grid__menu\" id=\"page-menu\"></div><aside class=\"o-sidebar-grid__sidebar \"></aside><div class=\"o-sidebar-grid__content\" id=\"page-content\"><section class=\"o-grid\"><h2 class=\"h-accessibility\">About Toy Story 5</h2><div  id=\"block-48116\" class=\"o-block o-text o-text-block o-grid__item \t\n\t\t\th-colstart--1 h-colend--9 h-phone-colstart--1 h-phone-colend--13 has-h-col\n\t o-block--row-1\" data-block='[]'><h2>Buzz and Woody reunite for the next chapter in this beloved series.</h2><p>When Bonnie receives a Lilypad (<strong>Greta Lee</strong>) and becomes completely obsessed, Buzz (<strong>Tim Allen</strong>), Woody (<strong>Tom Hanks</strong>), Jessie (<strong>Joan Cusack</strong>) and the rest of the gang face their biggest challenge yet. With playtime under threat, they'll have to take on an all-new rival for Bonnie's attention.</p></div><div  id=\"block-48117\" class=\"o-block o-grid__item \t\n\t\t\th-colstart--1 h-colend--9 h-phone-colstart--1 h-phone-colend--13 has-h-col\n\t o-block--row-2\" data-block='[\"text\"]'><div class=\"c-embed\" style=\"--aspect-ratio: 1.77;\"><v-embed\n\t\t\t\tembed-code=\"&quot;&lt;div class=\\&quot;fetch  fetch--youtube\\&quot;&gt;&lt;iframe title=\\&quot;youtube embed\\&quot;  width=\\&quot;200\\&quot; height=\\&quot;113\\&quot; src=\\&quot;https:\\/\\/www.youtube.com\\/embed\\/c51ND9Hdbw0?feature=oembed&amp;wmode=transparent\\&quot; frameborder=\\&quot;0\\&quot; allow=\\&quot;accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\\&quot; referrerpolicy=\\&quot;strict-origin-when-cross-origin\\&quot; allowfullscreen title=\\&quot;Toy Story 5 | Official Trailer | In Theaters June 19\\&quot; &gt;&lt;\\/iframe&gt;&lt;\\/div&gt;&quot;\"\n\t\t\t\t:required-cookie-categories=\"[]\"></v-embed></div></div><div  id=\"block-48118\" class=\"o-block o-text o-text-block o-grid__item \t\n\t\t\th-colstart--1 h-colend--9 h-phone-colstart--1 h-phone-colend--13 has-h-col\n\t o-block--row-3\" data-block='[\"embed\"]'><p>This film is distributed by <a href=\"https://www.disney.co.uk/\"><strong>Disney</strong></a>.</p></div></section></div><aside class=\"o-sidebar-grid__sidebar \" id=\"page-sidebar\"><div class=\"c-meta o-block\"><h2 class=\"c-meta__heading\">Details</h2><dl class=\"c-meta__list\"><div class=\"c-meta__item\"><dt class=\"c-meta__key\">Certificate</dt><dd class=\"c-meta__value\">PG</dd></div><div class=\"c-meta__item\"><dt class=\"c-meta__key\">Duration</dt><dd class=\"c-meta__value\">102 minutes</dd></div><div class=\"c-meta__item\"><dt class=\"c-meta__key\">Director</dt><dd class=\"c-meta__value\">Andrew Stanton</dd></div><div class=\"c-meta__item\"><dt class=\"c-meta__key\">Venue</dt><dd class=\"c-meta__value\">SCREEN 2</dd></div></dl></div><section ><div id=\"\" class=\"c-banner c-banner--featured c-banner--small h-theme--white\" data-sc-gtm-category=\"Banner\" data-sc-gtm-label=\"Accessibility\" data-sc-gtm-value=\"\"><h2 class=\"c-banner__title\">Accessibility</h2><div class=\"c-banner__text\"><p>If you have any access requirements, please contact our box office team on<strong> 020 7613 7498 </strong>or email <a href=\"mailto:boxoffice@richmix.org.uk\">boxoffice@richmix.org.uk.</a></p><p><a href=\"https://richmix.org.uk/visit-us/access\">Find all accessibility info for Rich Mix</a>.</p></div></div></section><section ><h3 class=\"h-accessibility\">Upsells</h3><ul class=\"o-list\"><li class=\"o-list__item o-grid__item\"><a id=\"\" class=\"c-banner c-banner--deco-two c-banner--featured c-banner--small h-theme--red\" href=\"https://richmix.org.uk/tickets-bookings-offers/\" data-sc-gtm-category=\"Banner\" data-sc-gtm-label=\"Family ticket offers\" data-sc-gtm-value=\"\"><h2 class=\"c-banner__title\">F