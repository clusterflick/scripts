edSeating\":true},{\"areaCategoryId\":\"694-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"694-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"694-78-HO00008728\"},{\"id\":\"694-63402\",\"schedule\":{\"businessDate\":\"2026-08-02\",\"startsAt\":\"2026-08-02T20:40:00+01:00\",\"endsAt\":\"2026-08-02T23:25:00+01:00\",\"filmStartsAt\":\"2026-08-02T21:05:00+01:00\",\"filmEndsAt\":\"2026-08-02T23:25:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"694-6-82\",\"filmId\":\"HO00008728\",\"siteId\":\"694\",\"screenId\":\"694-6\",\"areaCategories\":[{\"areaCategoryId\":\"694-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"694-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"694-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"694-78-HO00008728\"},{\"id\":\"694-63405\",\"schedule\":{\"businessDate\":\"2026-08-02\",\"startsAt\":\"2026-08-02T21:20:00+01:00\",\"endsAt\":\"2026-08-03T00:05:00+01:00\",\"filmStartsAt\":\"2026-08-02T21:45:00+01:00\",\"filmEndsAt\":\"2026-08-03T00:05:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"694-3-79\",\"filmId\":\"HO00008728\",\"siteId\":\"694\",\"screenId\":\"694-3\",\"areaCategories\":[{\"areaCategoryId\":\"694-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"694-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"694-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"694-78-HO00008728\"}],\"relatedData\":{\"sites\":[{\"id\":\"694\",\"name\":{\"text\":\"Streatham\",\"translations\":[]},\"location\":{\"latitude\":51.4321,\"longitude\":-0.1286},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Streatham@odeonuk.com\",\"address\":{\"line1\":\"47-49 High Road\",\"line2\":\"Streatham\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008568\",\"title\":{\"text\":\"Charlie the Wonderdog\",\"translations\":[]},\"synopsis\":{\"text\":\"The all-new animated family adventure, Charlie the Wonderdog: features Owen Wilson (the voice of Lightning McQueen from CARS) as the voice of Charlie, a lovable dog with superpowers!\\n\\nWhen Danny’s loyal, four-legged best friend is mysteriously abducted by aliens, Charlie returns home with incredible new abilities and a mission to protect the people he loves. As his nemesis neighbourhood cat Puddy sets out to take over the world, it’s up to Charlie the Wonderdog to discover the true meaning of heroism and save the day!\\n\\nFunny, heartfelt, and packed with adventure, Charlie the Wonderdog is a story for everyone who has ever loved a dog — and for every dog who has ever loved them back.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When Danny’s four-legged best friend is mysteriously abducted by aliens, Charlie returns home with incredible superpowers and a mission to protect the people he loves.\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild bad language\",\"translations\":[]},\"releaseDate\":\"2026-05-22\",\"runtimeInMinutes\":92,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000565\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018114\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000018115\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018116\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"67a4ecdd-e8d2-4de6-a38a-0aece801e7ad\",\"corporateId\":null},\"hopk\":\"HO00008568\",\"hoCode\":\"A000009681\",\"eventId\":null,\"distributorName\":\"ALTITUDE\"},{\"id\":\"HO00008728\",\"title\":{\"text\":\"Spider-Man: Brand New Day\",\"translations\":[]},\"synopsis\":{\"text\":\"It's a BRAND NEW DAY for Peter Parker. Fighting crime full-time as Spider-Man in a world that doesn’t remember him -- and the pressure of seeing his old friends move on without him -- sparks a change in Peter he may not have the power to control. But that transformation might also be the only thing that can stop a shocking new threat to the city and those he loves - a powerful villain no one can even see.\\n\\nThe world may have forgotten Peter Parker, but he hasn’t forgotten them.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It's a BRAND NEW DAY for Peter Parker. Fighting crime full-time as Spider-Man in a world that doesn’t remember him sparks a change he may not have the power to control.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-29\",\"runtimeInMinutes\":140,\"trailerUrl\":\"https://www.youtube.com/watch?v=qwVAc2MmlwU\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000122\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000212\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003682\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007703\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010992\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018489\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018490\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000263\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000267\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000807\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000969\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00002248\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000003\",\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"db62eee0-9bc4-4169-8b2c-be507018ab7e\",\"corporateId\":null},\"hopk\":\"HO00008728\",\"hoCode\":\"A000009856\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00009074\",\"title\":{\"text\":\"Medicinema - Paw Patrol 3: The Dino Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"After their ship gets caught in a mysterious storm, the PAW Patrol pups crash land on an uncharted tropical island filled with dinosaurs. They meet Rex, a pup who has been stranded on the island for years and has become an expert in all things dino-related. When the PAW Patrol's archrival, Mayor Humdinger, begins recklessly mining in hopes of exploiting the island for its natural resources, he inadvertently causes a huge, dormant volcano to erupt. The PAW Patrol pups are thrown into a series of high-stakes, dino-sized rescues bigger than anything they've done before, as they must stop Humdinger before everything on the island goes extinct.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After their ship gets caught in a mysterious storm, the PAW Patrol pups crash land on an uncharted tropical island filled with dinosaurs. They meet Rex.\",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-02\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=W6q8uzqfB5k\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002221\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002222\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003857\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004749\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009450\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009456\",\"roles\":[\"Actor\"]},{\"ca