AdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"694-78-HO00008728\"},{\"id\":\"694-63458\",\"schedule\":{\"businessDate\":\"2026-08-01\",\"startsAt\":\"2026-08-01T22:00:00+01:00\",\"endsAt\":\"2026-08-02T00:45:00+01:00\",\"filmStartsAt\":\"2026-08-01T22:25:00+01:00\",\"filmEndsAt\":\"2026-08-02T00:45:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"694-2-78\",\"filmId\":\"HO00008728\",\"siteId\":\"694\",\"screenId\":\"694-2\",\"areaCategories\":[{\"areaCategoryId\":\"694-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"694-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"694-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"694-78-HO00008728\"}],\"relatedData\":{\"sites\":[{\"id\":\"694\",\"name\":{\"text\":\"Streatham\",\"translations\":[]},\"location\":{\"latitude\":51.4321,\"longitude\":-0.1286},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Streatham@odeonuk.com\",\"address\":{\"line1\":\"47-49 High Road\",\"line2\":\"Streatham\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008568\",\"title\":{\"text\":\"Charlie the Wonderdog\",\"translations\":[]},\"synopsis\":{\"text\":\"The all-new animated family adventure, Charlie the Wonderdog: features Owen Wilson (the voice of Lightning McQueen from CARS) as the voice of Charlie, a lovable dog with superpowers!\\n\\nWhen Danny’s loyal, four-legged best friend is mysteriously abducted by aliens, Charlie returns home with incredible new abilities and a mission to protect the people he loves. As his nemesis neighbourhood cat Puddy sets out to take over the world, it’s up to Charlie the Wonderdog to discover the true meaning of heroism and save the day!\\n\\nFunny, heartfelt, and packed with adventure, Charlie the Wonderdog is a story for everyone who has ever loved a dog — and for every dog who has ever loved them back.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When Danny’s four-legged best friend is mysteriously abducted by aliens, Charlie returns home with incredible superpowers and a mission to protect the people he loves.\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild bad language\",\"translations\":[]},\"releaseDate\":\"2026-05-22\",\"runtimeInMinutes\":92,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000565\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018114\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000018115\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018116\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"67a4ecdd-e8d2-4de6-a38a-0aece801e7ad\",\"corporateId\":null},\"hopk\":\"HO00008568\",\"hoCode\":\"A000009681\",\"eventId\":null,\"distributorName\":\"ALTITUDE\"},{\"id\":\"HO00008728\",\"title\":{\"text\":\"Spider-Man: Brand New Day\",\"translations\":[]},\"synopsis\":{\"text\":\"It's a BRAND NEW DAY for Peter Parker. Fighting crime full-time as Spider-Man in a world that doesn’t remember him -- and the pressure of seeing his old friends move on without him -- sparks a change in Peter he may not have the power to control. But that transformation might also be the only thing that can stop a shocking new threat to the city and those he loves - a powerful villain no one can even see.\\n\\nThe world may have forgotten Peter Parker, but he hasn’t forgotten them.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It's a BRAND NEW DAY for Peter Parker. Fighting crime full-time as Spider-Man in a world that doesn’t remember him sparks a change he may not have the power to control.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-29\",\"runtimeInMinutes\":140,\"trailerUrl\":\"https://www.youtube.com/watch?v=qwVAc2MmlwU\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000122\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000212\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003682\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007703\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010992\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018489\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018490\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000263\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000267\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000807\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000969\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00002248\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000003\",\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"db62eee0-9bc4-4169-8b2c-be507018ab7e\",\"corporateId\":null},\"hopk\":\"HO00008728\",\"hoCode\":\"A000009856\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"}],\"castAndCrew\":[{\"id\":\"0000000565\",\"name\":{\"givenName\":\"Owen\",\"familyName\":\"Wilson\",\"middleName\":null}},{\"id\":\"0000018114\",\"name\":{\"givenName\":\"Shea\",\"familyName\":\"Wageman\",\"middleName\":null}},{\"id\":\"0000018115\",\"name\":{\"givenName\":\"Carson\",\"familyName\":\"Loveday\",\"middleName\":null}},{\"id\":\"0000018116\",\"name\":{\"givenName\":\"Jenn\",\"familyName\":\"Rogan\",\"middleName\":null}},{\"id\":\"0000000122\",\"name\":{\"givenName\":\"Kevin\",\"familyName\":\"Feige\",\"middleName\":null}},{\"id\":\"0000000212\",\"name\":{\"givenName\":\"Avi\",\"familyName\":\"Arad\",\"middleName\":null}},{\"id\":\"0000003682\",\"name\":{\"givenName\":\"Jacob\",\"familyName\":\"Batalon\",\"middleName\":