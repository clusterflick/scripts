8 nav-item\" role=\"menuitem\"><a title=\"Support Us\" href=\"https://www.alexandrapalace.com/support-us/\" class=\"nav-link\">Support Us</a></li>\n<li itemscope=\"itemscope\" itemtype=\"https://www.schema.org/SiteNavigationElement\" id=\"menu-item-38069\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-38069 nav-item\" role=\"menuitem\"><a title=\"Venue Hire\" href=\"https://www.alexandrapalace.com/venue-hire/spaces/\" class=\"nav-link\">Venue Hire</a></li>\n<li itemscope=\"itemscope\" itemtype=\"https://www.schema.org/SiteNavigationElement\" id=\"menu-item-38070\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-38070 nav-item\" role=\"menuitem\"><a title=\"Contact\" href=\"/contact/get-in-touch\" class=\"nav-link\">Contact</a></li>\n<li itemscope=\"itemscope\" itemtype=\"https://www.schema.org/SiteNavigationElement\" id=\"menu-item-38071\" class=\"d-block d-lg-none mobile_mailing menu-item menu-item-type-custom menu-item-object-custom menu-item-38071 nav-item\" role=\"menuitem\"><a title=\"Join our mailing list\" href=\"/contact/get-in-touch/#footer-newsletter-form\" class=\"nav-link\">Join our mailing list</a></li>\n</ul></div>        </div>\n      </nav>\n      <!-- End Mobile Nav -->\n    </div>\n  </header>\n\n  <div class=\"search\" id=\"search_container\">\n    <div class=\"search_content\">\n      <div class=\"container\">\n        <header>\n          <h1 class=\"screen-reader-text\">Search</h1>\n          <h2 class=\"h1\">What are you looking for?</h2>\n        </header>\n\n        <button id=\"btn-search-close\" class=\"btn btn--search-close\" aria-label=\"Close search form\">Close <span></span></button>\n        <label class=\"screen-reader-text\" for=\"search-input\">Search:</label>\n        <form class=\"search__form\" action=\"/search\" method=\"get\" role=\"search\">\n          <input type=\"text\" class=\"search__input\" id=\"search-input\" name=\"search\" type=\"search\" placeholder=\"Start typing...\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"off\" spellcheck=\"false\" value=\"\" />\n          <button class=\"btn btn--search\"><i class=\"sprite sprite_search_white\"></i><span class=\"screen-reader-text\">Search</span></button>\n        </form>\n\n        <div class=\"search__suggested\">\n          <h3 class=\"text-uppercase\">You might be looking for…</h3>\n          <ul class=\"search_tags\">\n            <li class=\"search_tag\"><a href=\"/visitor-information/opening-times/\">OPENING HOURS</a></li>\n            <li class=\"search_tag\"><a href=\"/visitor-information/get-here/\">PARKING</a></li>\n            <li class=\"search_tag\"><a href=\"/whats-on/#sport\">SPORT</a></li>\n            <li class=\"search_tag\"><a href=\"/whats-on/#live-events\">LIVE EVENTS</a></li>\n            <li class=\"search_tag\"><a href=\"/about-us/blog/\">BLOG</a></li>\n          </ul>\n        </div>\n\n        <div class=\"search__related\">\n          <div class=\"row\">\n            <div class=\"col-md-12\">\n              <h3 class=\"text-uppercase\">Top results</h3>\n            </div>\n            <div class=\"col-md-6 search_suggestions\"></div>\n\n            <div class=\"col-md-6\">\n              <a href=\"#\" class=\"btn btn-ap btn-pink btn_results pull-right\">All results <i class=\"sprite sprite_btn_arrow_blue\"></i></a>\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </div>\n  <main class=\"content\" id=\"primary\">\n    <div class=\"header_media proportional_container container--header_media\">\n    <img width=\"1920\" height=\"700\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2026/07/1920x700.png\" class=\"header_image_desktop\" alt=\"\" decoding=\"async\" fetchpriority=\"high\" srcset=\"https://www.alexandrapalace.com/wp-content/uploads/2026/07/1920x700.png 1920w, https://www.alexandrapalace.com/wp-content/uploads/2026/07/1920x700-650x237.png 650w, https://www.alexandrapalace.com/wp-content/uploads/2026/07/1920x700-1620x591.png 1620w, https://www.alexandrapalace.com/wp-content/uploads/2026/07/1920x700-768x280.png 768w, https://www.alexandrapalace.com/wp-content/uploads/2026/07/1920x700-1536x560.png 1536w\" sizes=\"(max-width: 1920px) 100vw, 1920px\" />    <img width=\"560\" height=\"700\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2026/07/1080x1080-560x700.png\" class=\"header_image_mobile\" alt=\"\" decoding=\"async\" /></div><div class=\"margins\">\n        <nav aria-label=\"Breadcrumb\" class=\"breadcrumbs\">\n        <ol>\n            <li class=\"crumb\">\n                <a href=\"https://www.alexandrapalace.com\">Home</a>\n            </li>\n                        <li class=\"crumb\"><a href=\"https://www.alexandrapalace.com/whats-on/\">What&#8217;s On</a></li>            <li class=\"crumb--current\">\n                <span aria-current=\"page\">London Bollywood Orchestra &#8211; Sounds Of Mumbai</span>\n            </li>\n        </ol>\n    </nav>\n</div>\n\n<div id=\"event_content\" class=\"margins grid grid--3_1 component\">\n    <div class=\"grid--item grid--item--1\">\n        <h1>London Bollywood Orchestra &#8211; Sounds Of Mumbai</h1>\n            </div>      \n    <div class=\"event_sidebar grid--item grid--item--2\">\n        <div class=\"event_details\"><p class=\"text-uppercase\">30 Oct 2026</p><p>Doors open 18:30</p><p>Alexandra Palace Theatre</p><p>Duration: 2 hours 30 minutes</p></div>    </div>\n    <div class=\"grid--item grid--item--1\">      \n        <div class=\"ap_text_block\">\n    <p>This Diwali, experience the spectacular sound of Bollywood live at Alexandra Palace Theatre as the London Bollywood Orchestra returns with its dazzling new concert, <strong>Sounds of Mumbai</strong>.</p>\n<p>Following sold-out performances across London, a successful UK tour and a hugely acclaimed debut at the Royal Festival Hall, the London Bollywood Orchestra brings audiences an unforgettable celebration of the greatest Bollywood songs ever written. From timeless classics of the 1940s and 50s to modern chart-topping favourites, Sounds of Mumbai is a vibrant musical journey through the soundtrack of generations.</p>\n<p>Led by acclaimed Music Director <strong><em>Tim Pottier,</em></strong> whose credits include the BBC Prom celebrating Lata Mangeshkar, the City of Birmingham Symphony Orchestra’s Best of Bollywood, and Sonu Nigam’s Rafi Resurrected, the orchestra features some of London’s finest musicians from the West End, leading orchestras and the jazz world.</p>\n<p><strong>Age recommendation: 10+</strong></p>\n</div><div class=\"ap_embed_block ap_block\">\n    <iframe title=\"London Bollywood Orchestra - Sounds of Mumbai\" width=\"640\" height=\"360\" src=\"https://www.youtube.com/embed/uKjpdGlyXAo?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe></div>        <div class=\"row\"><div class=\"col-12 col-sm-12 col-md-7\"><table class=\"table event_timetable ap_table blue\" id=\"doors-opening-times\"><thead><tr><th scope=\"col\">Date</th><th scope=\"col\">Doors<br/>open</th><th scope=\"col\">Start<br/>time</th><th scope=\"col\">End<br/>time</th></tr></thead><tbody><tr>\n                <th scope=\"row\" class=\"text-uppercase\">30 Oct 2026</th><td>18:30</td><td>19:30</td><td>22:15</td></tr></tbody></table></div></div>    </div>                      \n    <div class=\"event_sidebar grid--item grid--item--2\">\n                   <ul class=\"event_buttons\">\n            <li class=\"tickets_btn\">\n                <a class=\"btn btn-pink btn_arrow btn-block spektrix-ticket\" href=\"#tickets\">Buy Tickets</a>\n            </li>\n        </ul>\n        <ul class=\"event_buttons\">\n                                            <li>\n                    <a class=\"btn btn-outline-blue\" href=\"/visitor-information/get-here/\" >How to get here</a>\n                </li>\n                                                                    <li>\n                    <a class=\"btn btn-outline-blue\" href=\"/faqs\" >FAQs</a>\n                </li>\n                                                <li>\n                    <a class=\"btn btn-outline-blue\" href=\"/asafeandsecureexperience/\" >Safe and secure</a>\n                </li>\n                                                <li>\n                    <a class=\"btn btn-outline-blue\" href=\"/visitor-information/accessibility/\" >Accessibility</a>\n                </li>\n                                                <li>\n                    <a class=\"btn btn-outline-blue\" href=\"https://booking.stay22.com/alexandrapalace/HNGxs49gSC\" target=\"_blank\">Accommodation</a>\n                </li>\n                        </ul>\n    </div>\n</div>\n\n    <div id=\"buy_tickets_component\" class=\"margins  component d-none\">\n        <div class=\"grid grid--3_1 buy_tickets--inner\">\n            <div id=\"basket-header\" class=\"grid--item grid--item--span grid grid--3_1\">\n                <div class=\"grid--item grid--item--1\">\n                    <div id=\"back-to-event-btn\">\n                        <button class=\"button ap_btn_fill bg-white blue\">back to event</button>\n                    </div>\n                </div>\n                <div class=\"event_sidebar grid--item grid--item--2\">\n                    <h1>London Bollywood Orchestra &#8211; Sounds Of Mumbai</h1>\n                </div>\n            </div>\n            <div class=\"grid--item grid--item--2\" id=\"basket-wrapper\">     \n                <div class=\"spektrix-basket-component\">\n                    <div class=\"spektrix-basket-component\">\n                        <spektrix-basket-summary client-name=\"alexandrapalace\" custom-domain=\"tickets.alexandrapalace.com\" >\n                            <h3>BASKET SUMMARY</h3>\n                                <span data-basket-item-count></span> item(s)\n                                <br />\n                                Discount:\n                                <span data-basket-summary-currency></span>\n                                <span data-basket-summary-discount-total></span>\n                                <div class=\"basket-summary-total\">\n                                    Total:\n                                    <span data-basket-summary-currency></span>\n                                    <span data-basket-summary-basket-total></span>\n                                </div>\n                        </spektrix-basket-summary>\n                    </div>                </div>\n            </div>\n            <div class=\"grid--item grid--item--span\">    \n                <iframe\n            name=\"SpektrixIFrame\"\n            id=\"SpektrixIFrame\"\n            frameborder=\"0\"\n            src=\"\"\n            data-src=\"https://tickets.alexandrapalace.com/alexandrapalace/website/ChooseSeats.aspx?EventInstanceId=959401&Optimise=mobile&stylesheet=spektrix-iframe-styles.css&resize=true\"\n            \n            style=\"width: 100%; height: 1000px;\"onload=\"window.onSpektrixIframeLoad && window.onSpektrixIframeLoad(event)\"\n        >\n        </iframe>            </div>\n        </div>\n    </div>\n<div id=\"event_secondary_content\">    \n            <div class=\"section full_width bg_aqua padding ap_block_related\">\n            <h2 class=\"color-blue\">You may also be interested in...</h2>\n                            <div class=\"flex flex_33\"  id=\"events-container\">\n                                            <div class=\"flex_item\">\n                            <div class=\"event_card_wrapper event_item event_card grid just-announced \"  >\n        <div class=\"event_img proportional_container container--fivefour\">\n             <img width=\"650\" height=\"650\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2026/06/Tina-1080x1080-whats-love-clean-650x650.jpg\" class=\"attachment-medium size-medium wp-post-image\" alt=\"\" loading=\"lazy\" decoding=\"async\" srcset=\"https://www.alexandrapalace.com/wp-content/uploads/2026/06/Tina-1080x1080-whats-love-clean-650x650.jpg 650w, https://www.alexandrapalace.com/wp-content/uploads/2026/06/Tina-1080x1080-whats-love-clean-768x768.jpg 768w, https://www.alexandrapalace.com/wp-content/uploads/2026/06/Tina-1080x1080-whats-love-clean.jpg 1080w\" sizes=\"auto, (max-width: 650px) 100vw, 650px\" />                             <div class=\"flash\">\n                    <span class=\"screen-reader-text\">just announced</span>\n                </div>\n                    </div>\n        <header class=\"event_details bg_white inner_padding\">\n            <p class=\"dates uc\"><strong>28 Feb 2027</strong></p>\n            <a href=\"https://www.alexandrapalace.com/whats-on/whats-love-got-to-do-with-it/\" class=\"event_target\"><h3>What&#8217;s Love Got To Do With It</h3>\n                            </a>\n        </header>\n        <footer class=\"event_item_footer bg_color_ap_blue\">\n            <div class=\"footer_content\">\n                <span target=\"_blank\" class=\"btn event_btn\">Info & Tickets <i class=\"sprite sprite_btn_arrow_white\"></i></span>\n            </div>\n                    </footer>\n    </a>\n</div>                        \n                        </div>\n                                            <div class=\"flex_item\">\n                            <div class=\"event_card_wrapper event_item event_card grid  \"  >\n        <div class=\"event_img proportional_container container--fivefour\">\n             <img width=\"650\" height=\"650\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2026/05/Rossini-MCO-AP-1080x1080-1-650x650.jpg\" class=\"attachment-medium size-medium wp-post-image\" alt=\"\" loading=\"lazy\" decoding=\"async\" srcset=\"https://www.alexandrapalace.com/wp-content/uploads/2026/05/Rossini-MCO-AP-1080x1080-1-650x650.jpg 650w, https://www.alexandrapalace.com/wp-content/uploads/2026/05/Rossini-MCO-AP-1080x1080-1-768x768.jpg 768w, https://www.alexandrapalace.com/wp-content/uploads/2026/05/Rossini-MCO-AP-1080x1080-1.jpg 1080w\" sizes=\"auto, (max-width: 650px) 100vw, 650px\" />                     </div>\n        <header class=\"event_details bg_white inner_padding\">\n            <p class=\"dates uc\"><strong>18 Sep 2026</strong></p>\n            <a href=\"https://www.alexandrapalace.com/whats-on/monteverdi-choir-rossini/\" class=\"event_target\"><h3>Monteverdi Choir &#8211; Rossini’s Petite Messe Solennelle</h3>\n                            </a>\n        </header>\n        <footer class=\"event_item_footer bg_color_ap_blue\">\n            <div class=\"footer_content\">\n                <span target=\"_blank\" class=\"btn event_btn\">Info & Tickets <i class=\"sprite sprite_btn_arrow_white\"></i></span>\n            </div>\n                    </footer>\n    </a>\n</div>                        \n                        </div>\n                                            <div class=\"flex_item\">\n                            <div class=\"event_card_wrapper event_item event_card grid  \"  >\n        <div class=\"event_img proportional_container container--fivefour\">\n             <img width=\"650\" height=\"650\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2025/03/MBS-1080-x-1080-650x650.png\" class=\"attachment-medium size-medium wp-post-image\" alt=\"\" loading=\"lazy\" decoding=\"async\" srcset=\"https://www.alexandrapalace.com/wp-content/uploads/2025/03/MBS-1080-x-1080-650x650.png 650w, https://www.alexandrapalace.com/wp-content/uploads/2025/03/MBS-1080-x-1080-768x768.png 768w, https://www.alexandrapalace.com/wp-content/uploads/2025/03/MBS-1080-x-1080.png 1080w\" sizes=\"auto, (max-width: 650px) 100vw, 650px\" />                     </div>\n        <header class=\"event_details bg_white inner_padding\">\n            <p class=\"dates uc\"><strong>16 - 18 Oct 2026</strong></p>\n            <a href=\"https://www.alexandrapalace.com/whats-on/mind-body-soul-experience/\" class=\"event_target\"><h3>Mind Body Soul Experience</h3>\n                            </a>\n        </header>\n        <footer class=\"event_item_footer bg_color_ap_blue\">\n            <div class=\"footer_content\">\n                <span target=\"_blank\" class=\"btn event_btn\">Info & Tickets <i class=\"sprite sprite_btn_arrow_white\"></i></span>\n            </div>\n                    </footer>\n    </a>\n</div>                        \n                        </div>\n                                    </div>\n                    </div>\n    <div class=\"full_width banner bg_image banner_single\">\n\n    <div class=\"container--banner overlay_bg\">\n\n        <img width=\"2560\" height=\"1707\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2025/10/R6LW4175-AllyPally-VIPROOM-120225-LloydWinters-scaled.jpg\" class=\"attachment-full size-full\" alt=\"\" loading=\"lazy\" decoding=\"async\" srcset=\"https://www.alexandrapalace.com/wp-content/uploads/2025/10/R6LW4175-AllyPally-VIPROOM-120225-LloydWinters-scaled.jpg 2560w, https://www.alexandrapalace.com/wp-content/uploads/2025/10/R6LW4175-AllyPally-VIPROOM-120225-LloydWinters-650x433.jpg 650w, https://www.alexandrapalace.com/wp-content/uploads/2025/10/R6LW4175-AllyPally-VIPROOM-120225-LloydWinters-1620x1080.jpg 1620w, https://www.alexandrapalace.com/wp-content/uploads/2025/10/R6LW4175-AllyPally-VIPROOM-120225-LloydWinters-768x512.jpg 768w, https://www.alexandrapalace.com/wp-content/uploads/2025/10/R6LW4175-AllyPally-VIPROOM-120225-LloydWinters-1536x1024.jpg 1536w, https://www.alexandrapalace.com/wp-content/uploads/2025/10/R6LW4175-AllyPally-VIPROOM-120225-LloydWinters-2048x1365.jpg 2048w\" sizes=\"auto, (max-width: 2560px) 100vw, 2560px\" />\n        <div class=\"banner__content padding\">\n\n           \n                        <h3 style=\"text-align: center\" class=\"white\" aria-level=\"2\">\n                            Skip the queues                        </h3> \n\n            \n            <h2 style=\"text-align: center\" class=\"white\" aria-level=\"3\">Raise a glass!</h2>\n            <p class=\"white\"> Pre-order your interval drinks online when booking your tickets, or at the bar before the show begins. \r\nFancy something more? Drop by the East Court Café for sweet treats, snacks, and daily hot specials.</p>\n\n                            <a class=\"ap_btn_fill bg-light-pink blue\" href=\"https://www.alexandrapalace.com/theatre/food-drink/\"  title=\"Raise a glass!\">Discover food & drink</a>\n                        \n        </div>\n\n    </div>\n   \n</div></div>  <div class=\"container-fluid section-footer-newsletter-form\" id=\"footer-newsletter-form\">\n    <div class=\"row\">\n      <div class=\"col-sm-12\">\n        <div class=\"container\">\n          <div class=\"row\">\n            <div class=\"col-sm-12\">\n              <h2 style=\"text-align: left\" class=\"vc_custom_heading\">Sign up to our newsletter</h2>\n              <p>\n                Join our mailing list for Ally Pally updates, news and exclusive access to pre-sale tickets\n              </p>\n                      <form data-action=\"https://www.alexandrapalace.com/wp-json/spektrix/v1/form_tags\" class=\"form-inline\" id=\"ap_form_tags\" data-redirect=\"https://www.alexandrapalace.com/thank-you-for-signing-up/\">\n            <input type=\"hidden\" id=\"Tags\" name=\"Tags\" value=\"17601ADSBKGQMMPTLRCMTNQVQJNSBPVNG\">\n            <input type=\"hidden\" id=\"form_tags_nonce\" name=\"form_tags_nonce\" value=\"6300675430\" /><input type=\"hidden\" name=\"_wp_http_referer\" value=\"/whats-on/london-bollywood-orchestra-sounds-of-mumbai/\" />            <div class=\"form-group name-group\">\n                <label for=\"FirstName\">Name</label>\n                <input name=\"FirstName\" id=\"FirstName\" type=\"text\" placeholder=\"Enter your first name\" required/>\n            </div>\n            <div class=\"form-group name-group lastname-group\">\n                <label for=\"LastName\">Surname</label>\n                <input name=\"LastName\" id=\"LastName\" type=\"text\" placeholder=\"Enter your surname\" required/>\n            </div>\n            <div class=\"form-group email-group\">\n                <label for=\"Email\">Email Address</label>\n                <input name=\"Email\" id=\"Email\" type=\"text\" placeholder=\"Enter your email address\" required/>\n            </div>\n            <div class=\"form-group control-group\">\n                <button type=\"submit\" class=\"ap_btn_fill_icon ap_btn_pink btn_subscribe\">Sign up</button>\n            </div>\n        </form>\n                    <div class=\"form-additional-text\"><p>Local to Ally Pally? <a href=\"https://alexandrapalace.com/community-sign-up/\">Sign up to our Community Newsletter</a></p></div>\n                <p class=\"signup_notice\">By signing up you are agreeing to our <a href=\"/privacy-policy/\">Privacy&nbsp;Policy</a></p>\n        <div id=\"ap_form_tags_response\"></div>\n                </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</main>\n<footer class=\"container-fluid site_footer\">\n  <div class=\"row\">\n    <div class=\"col-sm-12\">\n      <div class=\"container\">\n        <div class=\"row\">\n\n          <div class=\"col-md-3 order-md-1 footer_column\">\n            <h3 class=\"h5 text-uppercase\">social media</h5>\n              <ul class=\"list-inline social_icons\">\n                <li class=\"list-inline-item\">\n                  <a href=\"https://www.facebook.com/YourAllyPally\" target=\"_blank\" title=\"Ally Pally Facebook\"><span class=\"screen-reader-text\">Ally Pally Facebook</span><i class=\"sprite sprite_fb\"></i></a>\n                </li>\n                <li class=\"list-inline-item\">\n                  <a href=\"https://www.youtube.com/channel/UCokPPHKEjs_E6ipz549nueQ\" target=\"_blan