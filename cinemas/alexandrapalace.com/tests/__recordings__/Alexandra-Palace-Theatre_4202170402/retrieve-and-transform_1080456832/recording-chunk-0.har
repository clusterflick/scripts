le>loading</title>\n    <g id=\"Layer_2\" data-name=\"Layer 2\">\n      <g id=\"Layer_1-2\" data-name=\"Layer 1\">\n        <path class=\"cls-1\" d=\"M132.81,32.41h.61V0C74.6,0,25,36.05,6.8,92l30.08,9.77A101,101,0,0,1,132.81,32.41Z\" />\n        <path class=\"cls-2\" d=\"M31.81,133.41a100.69,100.69,0,0,1,5.07-31.65L6.8,92c-18.17,55.94.78,114.27,48.37,148.85l18.54-25.53A100.86,100.86,0,0,1,31.81,133.41Z\" />\n        <path class=\"cls-3\" d=\"M132.81,234.41a100.55,100.55,0,0,1-59.1-19.1L55.17,240.84c47.58,34.57,108.91,34.57,156.5,0l-19-26.11A100.5,100.5,0,0,1,132.81,234.41Z\" />\n        <path class=\"cls-4\" d=\"M260,92l-31.17,10.13a101.09,101.09,0,0,1-36.15,112.61l19,26.11C259.26,206.26,278.21,147.93,260,92Z\" />\n        <path class=\"cls-5\" d=\"M228.86,102.12,260,92C241.86,36.05,192.24,0,133.42,0V32.41A101,101,0,0,1,228.86,102.12Z\" />\n      </g>\n    </g>\n  </svg>\n</div>\n<div id=\"donation-footer-popup\">\n  <div class=\"container\">\n    <button class=\"btn btn-close\" aria-label=\"Close  donation pop up\" type=\"button\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"26.414\" height=\"26.414\" viewBox=\"0 0 26.414 26.414\" role=\"img\" aria-label=\"close x button\">\n        <g id=\"Group_516\" data-name=\"Group 516\" transform=\"translate(-896.793 -679.793)\">\n          <line id=\"Line_1\" data-name=\"Line 1\" x2=\"25\" y2=\"25\" transform=\"translate(897.5 680.5)\" fill=\"none\" stroke=\"#231f20\" stroke-width=\"2\" />\n          <line id=\"Line_2\" data-name=\"Line 2\" x1=\"25\" y2=\"25\" transform=\"translate(897.5 680.5)\" fill=\"none\" stroke=\"#231f20\" stroke-width=\"2\" />\n        </g>\n      </svg>\n    </button>\n\n    <div class=\"row\">\n      <div class=\"col-md-12 col-lg-6\">\n        <h2>We need<br />your help.</h2>\n      </div>\n      <div class=\"col-md-12 col-lg-6\">\n        <p>Alexandra Palace is run by a charity for the benefit of everyone. We’re working harder than ever to keep you entertained, care for the award-winni