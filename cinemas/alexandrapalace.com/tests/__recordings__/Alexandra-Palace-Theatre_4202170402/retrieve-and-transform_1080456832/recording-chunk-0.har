andrapalace.com/venue-hire/spaces/\" class=\"nav-link\">Venue Hire</a></li>\n<li itemscope=\"itemscope\" itemtype=\"https://www.schema.org/SiteNavigationElement\" id=\"menu-item-38070\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-38070 nav-item\" role=\"menuitem\"><a title=\"Contact\" href=\"/contact/get-in-touch\" class=\"nav-link\">Contact</a></li>\n<li itemscope=\"itemscope\" itemtype=\"https://www.schema.org/SiteNavigationElement\" id=\"menu-item-38071\" class=\"d-block d-lg-none mobile_mailing menu-item menu-item-type-custom menu-item-object-custom menu-item-38071 nav-item\" role=\"menuitem\"><a title=\"Join our mailing list\" href=\"/contact/get-in-touch/#footer-newsletter-form\" class=\"nav-link\">Join our mailing list</a></li>\n</ul></div>        </div>\n      </nav>\n      <!-- End Mobile Nav -->\n    </div>\n  </header>\n\n  <div class=\"search\" id=\"search_container\">\n    <div class=\"search_content\">\n      <div class=\"container\">\n        <header>\n          <h1 class=\"screen-reader-text\">Search</h1>\n          <h2 class=\"h1\">What are you looking for?</h2>\n        </header>\n\n        <button id=\"btn-search-close\" class=\"btn btn--search-close\" aria-label=\"Close search form\">Close <span></span></button>\n        <label class=\"screen-reader-text\" for=\"search-input\">Search:</label>\n        <form class=\"search__form\" action=\"/search\" method=\"get\" role=\"search\">\n          <input type=\"text\" class=\"search__input\" id=\"search-input\" name=\"search\" type=\"search\" placeholder=\"Start typing...\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"off\" spellcheck=\"false\" value=\"\" />\n          <button class=\"btn btn--search\"><i class=\"sprite sprite_search_white\"></i><span class=\"screen-reader-text\">Search</span></button>\n        </form>\n\n        <div class=\"search__suggested\">\n          <h3 class=\"text-uppercase\">You might be looking for…</h3>\n          <ul class=\"search_tags\">\n            <li class=\"search_tag\"><a href=\"/visitor-information/opening-times/\">OPENING HOURS</a></li>\n            <li class=\"search_tag\"><a href=\"/visitor-information/get-here/\">PARKING</a></li>\n            <li class=\"search_tag\"><a href=\"/whats-on/#sport\">SPORT</a></li>\n            <li class=\"search_tag\"><a href=\"/whats-on/#live-events\">LIVE EVENTS</a></li>\n            <li class=\"search_tag\"><a href=\"/about-us/blog/\">BLOG</a></li>\n          </ul>\n        </div>\n\n        <div class=\"search__related\">\n          <div class=\"row\">\n            <div class=\"col-md-12\">\n              <h3 class=\"text-uppercase\">Top results</h3>\n            </div>\n            <div class=\"col-md-6 search_suggestions\"></div>\n\n            <div class=\"col-md-6\">\n              <a href=\"#\" class=\"btn btn-ap btn-pink btn_results pull-right\">All results <i class=\"sprite sprite_btn_arrow_blue\"></i></a>\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </div>\n  <main class=\"content\" id=\"primary\">\n    <div class=\"header_media proportional_container container--header_media\">\n    <img width=\"2499\" height=\"950\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2026/08/AN2I1695-AllyPally-DonsofComedy-111124-LloydWinters-web-e1786541211408.jpg\" class=\"header_image_desktop\" alt=\"\" decoding=\"async\" fetchpriority=\"high\" srcset=\"https://www.alexandrapalace.com/wp-content/uploads/2026/08/AN2I1695-AllyPally-DonsofComedy-111124-LloydWinters-web-e1786541211408.jpg 2499w, https://www.alexandrapalace.com/wp-content/uploads/2026/08/AN2I1695-AllyPally-DonsofComedy-111124-LloydWinters-web-e1786541211408-650x247.jpg 650w, https://www.alexandrapalace.com/wp-content/uploads/2026/08/AN2I1695-AllyPally-DonsofComedy-111124-LloydWinters-web-e1786541211408-1620x616.jpg 1620w, https://www.alexandrapalace.com/wp-content/uploads/2026/08/AN2I1695-AllyPally-DonsofComedy-111124-LloydWinters-web-e1786541211408-768x292.jpg 768w, https://www.alexandrapalace.com/wp-content/uploads/2026/08/AN2I1695-AllyPally-DonsofComedy-111124-LloydWinters-web-e1786541211408-1536x584.jpg 1536w, https://www.alexandrapalace.com/wp-content/uploads/2026/08/AN2I1695-AllyPally-DonsofComedy-111124-LloydWinters-web-e1786541211408-2048x779.jpg 2048w\" sizes=\"(max-width: 2499px) 100vw, 2499px\" />    <img width=\"560\" height=\"700\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2026/08/ACAF-fundraiser-560x700.png\" class=\"header_image_mobile\" alt=\"\" decoding=\"async\" srcset=\"https://www.alexandrapalace.com/wp-content/uploads/2026/08/ACAF-fundraiser-560x700.png 560w, https://www.alexandrapalace.com/wp-content/uploads/2026/08/ACAF-fundraiser-520x650.png 520w, https://www.alexandrapalace.com/wp-content/uploads/2026/08/ACAF-fundraiser-768x960.png 768w, https://www.alexandrapalace.com/wp-content/uploads/2026/08/ACAF-fundraiser.png 1080w\" sizes=\"(max-width: 560px) 100vw, 560px\" /></div><div class=\"margins\">\n        <nav aria-label=\"Breadcrumb\" class=\"breadcrumbs\">\n        <ol>\n            <li class=\"crumb\">\n                <a href=\"https://www.alexandrapalace.com\">Home</a>\n            </li>\n                        <li class=\"crumb\"><a href=\"https://www.alexandrapalace.com/whats-on/\">What&#8217;s On</a></li>            <li class=\"crumb--current\">\n                <span aria-current=\"page\">Best of Both Worlds</span>\n            </li>\n        </ol>\n    </nav>\n</div>\n\n<div id=\"event_content\" class=\"margins grid grid--3_1 component\">\n    <div class=\"grid--item grid--item--1\">\n        <h1>Best of Both Worlds</h1>\n                    <h3 class=\"subheader\">ACAF Fundraiser</h3>\n            </div>      \n    <div class=\"event_sidebar grid--item grid--item--2\">\n        <div class=\"event_details\"><p class=\"text-uppercase\">24 Oct 2026</p><p>Doors open 18:30</p><p>Alexandra Palace Theatre</p></div>    </div>\n    <div class=\"grid--item grid--item--1\">      \n        <div class=\"ap_text_block\">\n    <p>Best of Both Worlds brings together some of the biggest names and most recognisable sounds in Black British music and comedy for a spectacular Black History Month celebration at Alexandra Palace Theatre this October.</p>\n<p>Presented by ACAF and Supreme Live in support of the African Caribbean Leukaemia Trust (ACLT), this one-night-only extravaganza journeys through reggae, Lovers Rock, soul, UK garage, funky house, gospel and comedy, bringing generations together under one roof. Leading the comedy charge is legendary comedian <strong>Curtis Walker</strong>, a veteran of all five original series of the groundbreaking BBC comedy classic <em>The Real McCoy</em>, alongside <strong>Junior Booker</strong>, bringing his distinctive brand of stand-up to our Theatre stage. The music line-up is packed with iconic voices and unforgettable anthems.<strong> Janet Kay</strong>, the undisputed Lovers Rock favourite and voice behind the timeless smash hit <em>Silly Games</em>, takes to the stage alongside UK Garage superstar <strong>Kele Le Roc</strong>, known for classics including <em>My Love</em> and <em>Little Bit of Lovin’</em>. <strong>Katie Pearl</strong>, the unmistakable voice behind the funky house favourite <em>In the Air</em>, brings the dancefloor energy, while former Lotto Boyzz star <strong>Imrhan</strong> brings his powerful vocals and contemporary gospel sound, adding a fresh, uplifting energy to an already spectacular line-up. A full Reggae Choir will add even more soul and atmosphere to the evening. Keeping the whole night moving are charismatic hosts and presenters <strong>Ibe Gantkiller</strong> and <strong>Terri Walker</strong>, guiding audiences through an unforgettable celebration of music, comedy and culture.</p>\n<p>Best of Both Worlds isn’t just a show: it’s a celebration of the sounds, laughter and artists that have shaped generations.</p>\n<p>As well as delivering a full night of live entertainment, the show supports the work of the African Caribbean Leukaemia Trust (ACLT), the UK charity dedicated to increasing the availability of potentially life-saving blood and stem cell donors for people from African and Caribbean communities.</p>\n<p><strong>Age recommendation: 16+</strong></p>\n</div><div class=\"ap_carousel carousel--layout ap_block\">\n    <div class=\"swiper-wrapper\">\n                    <div class=\"swiper-slide\">\n                                <div class=\"ap_image_block\">\n                    <img width=\"1080\" height=\"1080\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2026/08/Imrhan.jpg\" class=\"attachment-large size-large\" alt=\"\" decoding=\"async\" srcset=\"https://www.alexandrapalace.com/wp-content/uploads/2026/08/Imrhan.jpg 1080w, https://www.alexandrapalace.com/wp-content/uploads/2026/08/Imrhan-650x650.jpg 650w, https://www.alexandrapalace.com/wp-content/uploads/2026/08/Imrhan-768x768.jpg 768w\" sizes=\"(max-width: 1080px) 100vw, 1080px\" />                    \n                </div>\n                            </div>\n                    <div class=\"swiper-slide\">\n                                <div class=\"ap_image_block\">\n                    <img width=\"1080\" height=\"1080\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2026/08/621697.jpg\" class=\"attachment-large size-large\" alt=\"\" decoding=\"async\" loading=\"lazy\" srcset=\"https://www.alexandrapalace.com/wp-content/uploads/2026/08/621697.jpg 1080w, https://www.alexandrapalace.com/wp-content/uploads/2026/08/621697-650x650.jpg 650w, https://www.alexandrapalace.com/wp-content/uploads/2026/08/621697-768x768.jpg 768w\" sizes=\"auto, (max-width: 1080px) 100vw, 1080px\" />                    \n                </div>\n                            </div>\n                    <div class=\"swiper-slide\">\n                                <div class=\"ap_image_block\">\n                    <img width=\"1080\" height=\"1080\" src=\"https://w