" />\n          <button class=\"btn btn--search\"><i class=\"sprite sprite_search_white\"></i><span class=\"screen-reader-text\">Search</span></button>\n        </form>\n\n        <div class=\"search__suggested\">\n          <h3 class=\"text-uppercase\">You might be looking for…</h3>\n          <ul class=\"search_tags\">\n            <li class=\"search_tag\"><a href=\"/visitor-information/opening-times/\">OPENING HOURS</a></li>\n            <li class=\"search_tag\"><a href=\"/visitor-information/get-here/\">PARKING</a></li>\n            <li class=\"search_tag\"><a href=\"/whats-on/#sport\">SPORT</a></li>\n            <li class=\"search_tag\"><a href=\"/whats-on/#live-events\">LIVE EVENTS</a></li>\n            <li class=\"search_tag\"><a href=\"/about-us/blog/\">BLOG</a></li>\n          </ul>\n        </div>\n\n        <div class=\"search__related\">\n          <div class=\"row\">\n            <div class=\"col-md-12\">\n              <h3 class=\"text-uppercase\">Top results</h3>\n            </div>\n            <div class=\"col-md-6 search_suggestions\"></div>\n\n            <div class=\"col-md-6\">\n              <a href=\"#\" class=\"btn btn-ap btn-pink btn_results pull-right\">All results <i class=\"sprite sprite_btn_arrow_blue\"></i></a>\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </div>\n  <main class=\"content\" id=\"primary\">\n    <div class=\"header_media proportional_container container--header_media\">\n    <img width=\"2560\" height=\"1703\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2026/03/Bill-RyderJones-2010-06-08-LIVERPOOL-CHURCH-IF-recording-c-Sophie-Jarry-130-new-contrast-scaled.jpg\" class=\"header_image_desktop\" alt=\"\" decoding=\"async\" fetchpriority=\"high\" srcset=\"https://www.alexandrapalace.com/wp-content/uploads/2026/03/Bill-RyderJones-2010-06-08-LIVERPOOL-CHURCH-IF-recording-c-Sophie-Jarry-130-new-contrast-scaled.jpg 2560w, https://www.alexandrapalace.com/wp-content/uploads/2026/03/Bill-RyderJones-2010-06-08-LIVERPOOL-CHURCH-IF-recording-c-Sophie-Jarry-130-new-contrast-650x433.jpg 650w, https://www.alexandrapalace.com/wp-content/uploads/2026/03/Bill-RyderJones-2010-06-08-LIVERPOOL-CHURCH-IF-recording-c-Sophie-Jarry-130-new-contrast-1620x1078.jpg 1620w, https://www.alexandrapalace.com/wp-content/uploads/2026/03/Bill-RyderJones-2010-06-08-LIVERPOOL-CHURCH-IF-recording-c-Sophie-Jarry-130-new-contrast-768x511.jpg 768w, https://www.alexandrapalace.com/wp-content/uploads/2026/03/Bill-RyderJones-2010-06-08-LIVERPOOL-CHURCH-IF-recording-c-Sophie-Jarry-130-new-contrast-1536x1022.jpg 1536w, https://www.alexandrapalace.com/wp-content/uploads/2026/03/Bill-RyderJones-2010-06-08-LIVERPOOL-CHURCH-IF-recording-c-Sophie-Jarry-130-new-contrast-2048x1363.jpg 2048w\" sizes=\"(max-width: 2560px) 100vw, 2560px\" />    <img width=\"560\" height=\"700\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2026/03/Bill-RyderJones-2010-06-08-LIVERPOOL-CHURCH-IF-recording-c-Sophie-Jarry-130-new-contrast-560x700.jpg\" class=\"header_image_mobile\" alt=\"\" decoding=\"async\" /></div><div class=\"margins\">\n        <nav aria-label=\"Breadcrumb\" class=\"breadcrumbs\">\n        <ol>\n            <li class=\"crumb\">\n                <a href=\"https://www.alexandrapalace.com\">Home</a>\n            </li>\n                        <li class=\"crumb\"><a href=\"https://www.alexandrapalace.com/whats-on/\">What&#8217;s On</a></li>            <li class=\"crumb--current\">\n                <span aria-current=\"page\">Bill Ryder-Jones</span>\n            </li>\n        </ol>\n    </nav>\n</div>\n\n<div id=\"event_content\" class=\"margins grid grid--3_1 component\">\n    <div class=\"grid--item grid--item--1\">\n        <h1>Bill Ryder-Jones</h1>\n                    <h3 class=\"subheader\">and the Royal Liverpool Philharmonic Orchestra perform If… and other works</h3>\n            </div>      \n    <div class=\"event_sidebar grid--item grid--item--2\">\n        <div class=\"event_details\"><p class=\"text-uppercase\">14 Nov 2026</p><p>Doors open 18:30</p><p>Alexandra Palace Theatre</p></div>    </div>\n    <div class=\"grid--item grid--item--1\">      \n        <div class=\"ap_text_block\">\n    <p>Experience <strong>Bill Ryder-Jones</strong> and the <strong>Royal Liverpool Philharmonic Orchestra</strong> performing <em>If…</em> and other works live at <span class=\"hover:entity-accent entity-underline inline cursor-pointer align-baseline\"><span class=\"whitespace-normal\">Alexandra Palace Theatre &#8211; marking 15 years of his acclaimed debut with a rare full-album orchestral performance, plus new material and expanded favourites.</span></span></p>\n<p><span class=\"hover:entity-accent entity-underline inline cursor-pointer align-baseline\"><span class=\"whitespace-normal\">Bill Ryder-Jones</span></span> is a Wirral-born composer, producer and former guitarist of <span class=\"hover:entity-accent entity-underline inline cursor-pointer align-baseline\"><span class=\"whitespace-normal\">The Coral</span></span>. Renowned for his emotive solo work, he blends orchestral arrangements with indie songwriting, earning critical acclaim for albums including <em data-start=\"539\" data-end=\"544\">If…</em>, <em data-start=\"546\" data-end=\"573\">West Kirby County Primary</em> and <em data-start=\"578\" data-end=\"589\">Iechyd Da</em>.</p>\n<p><strong>Age restriction 16+</strong></p>\n</div><div class=\"ap_embed_block ap_block\">\n    <iframe title=\"Spotify Embed: Bill Ryder-Jones\" style=\"border-radius: 12px\" width=\"100%\" height=\"352\" frameborder=\"0\" allowfullscreen allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\" src=\"https://open.spotify.com/embed/artist/2E70ENJNHoACgzTkJ3QnO4?si=KeswiZBjR7SopCjSgmvTAw&amp;utm_source=oembed\"></iframe></div>            </div>                      \n    <div class=\"event_sidebar grid--item grid--item--2\">\n                   <ul class=\"event_buttons\">\n            <li class=\"tickets_btn\">\n                <a class=\"btn btn-pink btn_arrow btn-block \" href=\"https://link.dice.fm/n83f20a3d296\">Buy Tickets</a>\n            </li>\n        </ul>\n        <ul class=\"event_buttons\">\n                                            <li>\n                    <a class=\"btn btn-outline-blue\" href=\"/visitor-information/get-here/\" >How to get here</a>\n                </li>\n                                                                    <li>\n                    <a class=\"btn btn-outline-blue\" href=\"/faqs#theatre\" >FAQs</a>\n                </li>\n                                                <li>\n                    <a class=\"btn btn-outline-blue\" href=\"/asafeandsecureexperience/\" >Safe and secure</a>\n                </li>\n                                                <li>\n                    <a class=\"btn btn-outline-blue\" href=\"/visitor-information/accessibility/\" >Accessibility</a>\n                </li>\n                                                <li>\n                    <a class=\"btn btn-outline-blue\" href=\"https://booking.stay22.com/alexandrapalace/HNGxs49gSC\" target=\"_blank\">Accommodation</a>\n                </li>\n                        </ul>\n    </div>\n</div>\n\n<div id=\"event_secondary_content\">    \n    <div class=\"full_width banner bg_image banner_single\">\n\n    <div class=\"container--banner \">\n\n        <img width=\"1000\" height=\"666\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2021/11/Phoenix_Pub_Promo_Luke-Fullalove_-572.jpg\" class=\"attachment-full size-full\" alt=\"\" loading=\"lazy\" decoding=\"async\" />\n        <div class=\"banner__content padding\">\n\n           \n                        <h3 style=\"text-align: center\" class=\"white\" aria-level=\"2\">\n                            PHOENIX BAR & PIZZERIA                        </h3> \n\n            \n            <h2 style=\"text-align: center\" class=\"white\" aria-level=\"3\">You can’t have an incredible night out on an empty stomach</h2>\n            <p class=\"white\"> Get here early and soak up the atmosphere of our all-day Neighbourhood pizza pub – serving up Neapolitan stone-fired pizzas alongside rotating local craft beers, a weekly gin menu and a wide selection of cocktails.</p>\n\n                        \n        </div>\n\n    </div>\n   \n</div></div>  <div class=\"container-fluid section-footer-newsletter-form\" id=\"footer-newsletter-form\">\n    <div class=\"row\">\n      <div class=\"col-sm-12\">\n        <div class=\"container\">\n          <div class=\"row\">\n            <div class=\"col-sm-12\">\n              <h2 style=\"text-align: left\" class=\"vc_custom_heading\">Sign up to our newsletter</h2>\n              <p>\n                Join our mailing list for Ally Pally updates, news and exclusive access to pre-sale tickets\n              </p>\n                      <form data-action=\"https://www.alexandrapalace.com/wp-json/spektrix/v1/form_tags\" class=\"form-inline\" id=\"ap_form_tags\" data-redirect=\"https://www.alexandrapalace.com/thank-you-for-signing-up/\">\n            <input type=\"hidden\" id=\"Tags\" name=\"Tags\" value=\"17601ADSBKGQMMPTLRCMTNQVQJNSBPVNG\">\n            <input type=\"hidden\" id=\"form_tags_nonce\" name=\"form_tags_nonce\" value=\"6300675430\" /><input type=\"hidden\" name=\"_wp_http_referer\" value=\"/whats-on/bill-ryder-jones/\" />            <div class=\"form-group name-group\">\n                <label for=\"FirstName\">Name</label>\n                <input name=\"FirstName\" id=\"FirstName\" type=\"text\" placeholder=\"Enter your first name\" required/>\n            </div>\n            <div class=\"form-group name-group lastname-group\">\n                <label for=\"LastName\">Surname</label>\n                <input name=\"LastName\" id=\"LastName\" type=\"text\" placeholder=\"Enter your surname\" required/>\n            </div>\n            <div class=\"form-group email-group\">\n                <label for=\"Email\">Email Address</label>\n                <input name=\"Email\" id=\"Email\" type=\"text\" placeholder=\"Enter your email address\" required/>\n            </div>\n            <div class=\"form-group control-group\">\n                <button type=\"submit\" class=\"ap_btn_fill_icon ap_btn_pink btn_subscribe\">Sign up</button>\n            </div>\n        </form>\n                    <div class=\"form-additional-text\"><p>Local to Ally Pally? <a href=\"https://alexandrapalace.com/community-sign-up/\">Sign up to our Community Newsletter</a></p></div>\n                <p class=\"signup_notice\">By signing up you are agreeing to our <a href=\"/privacy-policy/\">Privacy&nbsp;Policy</a></p>\n        <div id=\"ap_form_tags_response\"></div>\n                </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</main>\n<footer class=\"container-fluid site_footer\">\n  <div class=\"row\">\n    <div class=\"col-sm-12\">\n      <div class=\"container\">\n        <div class=\"row\">\n\n          <div class=\"col-md-3 order-md-1 footer_column\">\n            <h3 class=\"h5 text-uppercase\">social media</h5>\n              <ul class=\"list-inline social_icons\">\n                <li class=\"list-inline-item\">\n                  <a href=\"https://www.facebook.com/YourAllyPally\" target=\"_blank\" title=\"Ally Pally Facebook\"><span class=\"screen-reader-text\">Ally Pally Facebook</span><i class=\"sprite sprite_fb\"></i></a>\n                </li>\n                <li class=\"list-inline-item\">\n                  <a href=\"https://www.youtube.com/channel/UCokPPHKEjs_E6ipz549nueQ\" target=\"_blank\" title=\"Ally Pally Youtube\"><span class=\"screen-reader-text\">Ally Pally Youtube</span><i class=\"sprite sprite_yt\"></i></a>\n                </li>\n                <li class=\"list-inline-item\">\n                  <a href=\"https://twitter.com/Yourallypally\" target=\"_blank\" title=\"Ally Pally X\" loading=\"lazy\"><span class=\"screen-reader-text\">Ally Pally X</span><img src=\"https://www.alexandrapalace.com/wp-content/uploads/2024/04/X-Twitter-Logo-01.png\" alt=\"x\" width=\"20\"></a>\n                </li>\n                <li class=\"list-inline-item\">\n                  <a href=\"https://www.instagram.com/YourAllyPally/\" target=\"_blank\" title=\"Ally Pally Instagram\"><span class=\"screen-reader-text\">Ally Pally Instagram</span><i class=\"sprite sprite_i\"></i></a>\n                </li>\n                <li class=\"list-inline-item\">\n                  <a href=\"https://www.linkedin.com/company/yourallypally\" target=\"_blank\" title=\"Ally Pally LinkedIn\"><span class=\"screen-reader-text\">Ally Pally LinkedIn</span><i class=\"sprite sprite_li\"></i></a>\n                </li>\n                <li class=\"list-inline-item\">\n                  <a href=\"https://link.dice.fm/venue/alexandra-palace\" target=\"_blank\" title=\"Ally Pally DICE\" loading=\"lazy\"><span class=\"screen-reader-text\">Ally Pally DICE</span><img src=\"https://www.alexandrapalace.com/wp-content/uploads/2023/06/Logo-DICE-2.png\" alt=\"dice\" width=\"45\"></a>\n                </li>\n                <li class=\"list-inline-item\">\n                  <a href=\"https://www.tiktok.com/place/Alexandra-Palace-22535796491653759\" target=\"_blank\" title=\"Ally Pally tiktok\" loading=\"lazy\"><span class=\"screen-reader-text\">Ally Pally tiktok</span><img src=\"https://www.alexandrapalace.com/wp-content/uploads/2024/04/AP_transparent-LAZER-BLUE-tiktok-app-logo_SMALL.png\" alt=\"tiktok\" width=\"28\"></a>\n                </li>\n              </ul>\n          </div>\n          <div class=\"col-md-2 order-md-2 footer_column\">\n            <h3 class=\"h5 text-uppercase\">contact</h5>\n              <ul class=\"list-unstyled\">\n                <li><a href=\"https://goo.gl/maps/7r8CqFTBNGmEUhtF8\" target=\"_blank\">Alexandra Palace<br />Alexandra Palace Way<br />London<br />N22 7AY</a></li>\n                <li