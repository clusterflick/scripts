itemtype=\"https://www.schema.org/SiteNavigationElement\" id=\"menu-item-38059\" class=\"mobile_sub_title menu-item menu-item-type-custom menu-item-object-custom menu-item-38059 nav-item\" role=\"menuitem\"><a title=\"Projects\" href=\"#\" class=\"dropdown-item\">Projects</a></li>\n\t<li itemscope=\"itemscope\" itemtype=\"https://www.schema.org/SiteNavigationElement\" id=\"menu-item-136179\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-136179 nav-item\" role=\"menuitem\"><a title=\"Strategic Plan\" href=\"https://www.alexandrapalace.com/strategic-plan/\" class=\"dropdown-item\">Strategic Plan</a></li>\n\t<li itemscope=\"itemscope\" itemtype=\"https://www.schema.org/SiteNavigationElement\" id=\"menu-item-45367\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-45367 nav-item\" role=\"menuitem\"><a title=\"East Wing Restoration\" href=\"https://www.alexandrapalace.com/restoration/overview/\" class=\"dropdown-item\">East Wing Restoration</a></li>\n\t<li itemscope=\"itemscope\" itemtype=\"https://www.schema.org/SiteNavigationElement\" id=\"menu-item-116441\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-116441 nav-item\" role=\"menuitem\"><a title=\"Sustainability\" href=\"https://www.alexandrapalace.com/the-park/sustainability/\" class=\"dropdown-item\">Sustainability</a></li>\n</ul>\n</li>\n<li itemscope=\"itemscope\" itemtype=\"https://www.schema.org/SiteNavigationElement\" id=\"menu-item-38068\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-38068 nav-item\" role=\"menuitem\"><a title=\"Support Us\" href=\"https://www.alexandrapalace.com/support-us/\" class=\"nav-link\">Support Us</a></li>\n<li itemscope=\"itemscope\" itemtype=\"https://www.schema.org/SiteNavigationElement\" id=\"menu-item-38069\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-38069 nav-item\" role=\"menuitem\"><a title=\"Venue Hire\" href=\"https://www.alexandrapalace.com/venue-hire/spaces/\" class=\"nav-link\">Venue Hire</a></li>\n<li itemscope=\"itemscope\" itemtype=\"https://www.schema.org/SiteNavigationElement\" id=\"menu-item-38070\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-38070 nav-item\" role=\"menuitem\"><a title=\"Contact\" href=\"/contact/get-in-touch\" class=\"nav-link\">Contact</a></li>\n<li itemscope=\"itemscope\" itemtype=\"https://www.schema.org/SiteNavigationElement\" id=\"menu-item-38071\" class=\"d-block d-lg-none mobile_mailing menu-item menu-item-type-custom menu-item-object-custom menu-item-38071 nav-item\" role=\"menuitem\"><a title=\"Join our mailing list\" href=\"/contact/get-in-touch/#footer-newsletter-form\" class=\"nav-link\">Join our mailing list</a></li>\n</ul></div>        </div>\n      </nav>\n      <!-- End Mobile Nav -->\n    </div>\n  </header>\n\n  <div class=\"search\" id=\"search_container\">\n    <div class=\"search_content\">\n      <div class=\"container\">\n        <header>\n          <h1 class=\"screen-reader-text\">Search</h1>\n          <h2 class=\"h1\">What are you looking for?</h2>\n        </header>\n\n        <button id=\"btn-search-close\" class=\"btn btn--search-close\" aria-label=\"Close search form\">Close <span></span></button>\n        <label class=\"screen-reader-text\" for=\"search-input\">Search:</label>\n        <form class=\"search__form\" action=\"/search\" method=\"get\" role=\"search\">\n          <input type=\"text\" class=\"search__input\" id=\"search-input\" name=\"search\" type=\"search\" placeholder=\"Start typing...\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"off\" spellcheck=\"false\" value=\"\" />\n          <button class=\"btn btn--search\"><i class=\"sprite sprite_search_white\"></i><span class=\"screen-reader-text\">Search</span></button>\n        </form>\n\n        <div class=\"search__suggested\">\n          <h3 class=\"text-uppercase\">You might be looking for…</h3>\n          <ul class=\"search_tags\">\n            <li class=\"search_tag\"><a href=\"/visitor-information/opening-times/\">OPENING HOURS</a></li>\n            <li class=\"search_tag\"><a href=\"/visitor-information/get-here/\">PARKING</a></li>\n            <li class=\"search_tag\"><a href=\"/whats-on/#sport\">SPORT</a></li>\n            <li class=\"search_tag\"><a href=\"/whats-on/#live-events\">LIVE EVENTS</a></li>\n            <li class=\"search_tag\"><a href=\"/about-us/blog/\">BLOG</a></li>\n          </ul>\n        </div>\n\n        <div class=\"search__related\">\n          <div class=\"row\">\n            <div class=\"col-md-12\">\n              <h3 class=\"text-uppercase\">Top results</h3>\n            </div>\n            <div class=\"col-md-6 search_suggestions\"></div>\n\n            <div class=\"col-md-6\">\n              <a href=\"#\" class=\"btn btn-ap btn-pink btn_results pull-right\">All results <i class=\"sprite sprite_btn_arrow_blue\"></i></a>\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </div>\n  <main class=\"content\" id=\"primary\">\n    <div class=\"header_media proportional_container container--header_media\">\n    <img width=\"1000\" height=\"1392\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2026/04/1.-TGA-STANDALONE-SINGLE-KasiaWozniak_Beth_Orton_006.jpg\" class=\"header_image_desktop\" alt=\"\" decoding=\"async\" fetchpriority=\"high\" srcset=\"https://www.alexandrapalace.com/wp-content/uploads/2026/04/1.-TGA-STANDALONE-SINGLE-KasiaWozniak_Beth_Orton_006.jpg 1000w, https://www.alexandrapalace.com/wp-content/uploads/2026/04/1.-TGA-STANDALONE-SINGLE-KasiaWozniak_Beth_Orton_006-467x650.jpg 467w, https://www.alexandrapalace.com/wp-content/uploads/2026/04/1.-TGA-STANDALONE-SINGLE-KasiaWozniak_Beth_Orton_006-768x1069.jpg 768w\" sizes=\"(max-width: 1000px) 100vw, 1000px\" />    <img width=\"560\" height=\"700\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2026/04/1.-TGA-STANDALONE-SINGLE-KasiaWozniak_Beth_Orton_006-560x700.jpg\" class=\"header_image_mobile\" alt=\"\" decoding=\"async\" /></div><div class=\"margins\">\n        <nav aria-label=\"Breadcrumb\" class=\"breadcrumbs\">\n        <ol>\n            <li class=\"crumb\">\n                <a href=\"https://www.alexandrapalace.com\">Home</a>\n            </li>\n                        <li class=\"crumb\"><a href=\"https://www.alexandrapalace.com/whats-on/\">What&#8217;s On</a></li>            <li class=\"crumb--current\">\n                <span aria-current=\"page\">Beth Orton</span>\n            </li>\n        </ol>\n    </nav>\n</div>\n\n<div id=\"event_content\" class=\"margins grid grid--3_1 component\">\n    <div class=\"grid--item grid--item--1\">\n        <h1>Beth Orton</h1>\n            </div>      \n    <div class=\"event_sidebar grid--item grid--item--2\">\n        <div class=\"event_details\"><p class=\"text-uppercase\">22 Oct 2026</p><p>Doors open 18:30</p><p>Alexandra Palace Theatre</p></div>    </div>\n    <div class=\"grid--item grid--item--1\">      \n        <div class=\"ap_text_block\">\n    <p>Folktronica pioneer Beth Orton brings her new album <em>The Ground Above </em>to Alexandra Palace Theatre this October.</p>\n<p>For more than three decades, Beth Orton has remained one of the most distinctive voices in contemporary music. Since her 1996 debut <em>Trailer Park</em>, she has built a catalogue marked by emotional clarity and constant evolution, from <em>Comfort of Strangers</em> to the spectral, self-produced <em>Weather Alive</em>. Released in 2022, <em>Weather Alive</em> became a major critical breakthrough, signaling not just a return but a reinvention. Her first self-produced album and debut for Partisan Records, it earned widespread acclaim, with The New York Times praising its “modal vocal phrases and marveling” storytelling, Pitchfork awarding Best New Music (8.7), and MOJO highlighting its richness and extraordinary writing. With <em>The Ground Above</em>, Orton returns with renewed urgency and conviction.</p>\n<p><strong>Age restriction 16+</strong></p>\n</div><div class=\"ap_embed_block ap_block\">\n    <iframe title=\"Spotify Embed: Beth Orton\" style=\"border-radius: 12px\" width=\"100%\" height=\"352\" frameborder=\"0\" allowfullscreen allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\" src=\"https://open.spotify.com/embed/artist/6cLEWhEKQl6nAvgr60M7zC?si=8IYaE61cR0eGPu_3ZVCfuQ&amp;utm_source=oembed\"></iframe></div><div class=\"ap_key_info_block ap_block\" id=\"upgrade-your-visit-with-theatre-lounge-access\">\n    <p class=\"ap_key_info_block__title\">Upgrade your visit with Theatre Lounge Access: </p>\n    <p><strong>This is not a theatre ticket – the upgrade only grants access to the Theatre Lounge</strong></p>\n<p id=\"upgrade\">Benefits include:</p>\n<ul>\n<li>Entry to Theatre Lounge with seating</li>\n<li>1 x complimentary drink on arrival (glass of prosecco, bottle of beer or soft drink)</li>\n<li>Access to private bar. Please note that entry to the Lounge is one hour prior to the start of the performance</li>\n<li>Accessible during interval</li>\n</ul>\n<p>T&amp;Cs</p>\n<ul>\n<li><strong>This upgrade only grants access to the Theatre Lounge and does not include a theatre ticket</strong></li>\n<li>Available Friday and Saturday evenings only</li>\n<li>Please select the date and time that matches the performance you are attending (mistakes cannot always be rectified due to limited capacity)</li>\n<li><strong>The Theatre Lounge is not currently wheelchair accessible, and requires the navigation of stairs. This is due to the structural limitations of our 150-year-old Grade II listed building, but we are actively working on plans to improve access as soon as possible. We apologise for any inconvenience caused</strong></li>\n</ul>\n</div>            </div>                      \n    <div class=\"event_sidebar grid--item grid--item--2\">\n                   <ul class=\"event_buttons\">\n            <li class=\"tickets_btn\">\n                <a class=\"btn btn-pink btn_arrow btn-block \" href=\"https://link.dice.fm/G99886a0a07e\">Buy Tickets</a>\n            </li>\n        </ul>\n        <ul class=\"event_buttons\">\n                                            <li>\n                    <a class=\"btn btn-outline-blue\" href=\"/visitor-information/get-here/\" >How to get here</a>\n                </li>\n                                                                    <li>\n                    <a class=\"btn btn-outline-blue\" href=\"/faqs#theatre\" >FAQs</a>\n                </li>\n                                                <li>\n                    <a class=\"btn btn-outline-blue\" href=\"/asafeandsecureexperience/\" >Safe and secure</a>\n                </li>\n                                                <li>\n                    <a class=\"btn btn-outline-blue\" href=\"/visitor-information/accessibility/\" >Accessibility</a>\n                </li>\n                                                <li>\n                    <a class=\"btn btn-outline-blue\" href=\"https://booking.stay22.com/alexandrapalace/HNGxs49gSC\" target=\"_blank\">Accommodation</a>\n                </li>\n                        </ul>\n    </div>\n</div>\n\n<div id=\"event_secondary_content\">    \n    <div class=\"full_width banner bg_image banner_single\">\n\n    <div class=\"container--banner overlay_bg\">\n\n        <img width=\"2560\" height=\"1707\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2025/10/R6LW4175-AllyPally-VIPROOM-120225-LloydWinters-scaled.jpg\" class=\"attachment-full size-full\" alt=\"\" loading=\"lazy\" decoding=\"async\" srcset=\"https://www.alexandrapalace.com/wp-content/uploads/2025/10/R6LW4175-AllyPally-VIPROOM-120225-LloydWinters-scaled.jpg 2560w, https://www.alexandrapalace.com/wp-content/uploads/2025/10/R6LW4175-AllyPally-VIPROOM-120225-LloydWinters-650x433.jpg 650w, https://www.alexandrapalace.com/wp-content/uploads/2025/10/R6LW4175-AllyPally-VIPROOM-120225-LloydWinters-1620x1080.jpg 1620w, https://www.alexandrapalace.com/wp-content/uploads/2025/10/R6LW4175-AllyPally-VIPROOM-120225-LloydWinters-768x512.jpg 768w, https://www.alexandrapalace.com/wp-content/uploads/2025/10/R6LW4175-AllyPally-VIPROOM-120225-LloydWinters-1536x1024.jpg 1536w, https://www.alexandrapalace.com/wp-content/uploads/2025/10/R6LW4175-AllyPally-VIPROOM-120225-LloydWinters-2048x1365.jpg 2048w\" sizes=\"auto, (max-width: 2560px) 100vw, 2560px\" />\n        <div class=\"banner__content padding\">\n\n           \n                        <h3 style=\"text-align: center\" class=\"white\" aria-level=\"2\">\n                            Skip the queues                        </h3> \n\n            \n            <h2 style=\"text-align: center\" class=\"white\" aria-level=\"3\">Raise a glass!</h2>\n            <p class=\"white\"> Pre-order your interval drinks online when booking your tickets, or at the bar before the show begins. \r\nFancy something more? Drop by the East Court Café for sweet treats, snacks, and daily hot specials.</p>\n\n                            <a class=\"ap_btn_fill bg-light-pink blue\" href=\"https://www.alexandrapalace.com/theatre/food-drink/\"  title=\"Raise a glass!\">Discover food & drink</a>\n                        \n        </div>\n\n    </div>\n   \n</div>        <div class=\"section full_width bg_aqua padding ap_block_related\">\n            <h2 class=\"color-blue\">You may also be interested in...</h2>\n                            <div class=\"flex flex_33\"  id=\"events-container\">\n                                            <div class=\"flex_item\">\n                            <div class=\"event_card_wrapper event_item event_card grid  \"  >\n        <div class=\"event_img proportional_container container--fivefour\">\n             <img width=\"650\" height=\"433\" src=\"https://www.alexandrapalace.com/wp-content/uploads/2026/03/Bill-RyderJones-2010-06-08-LIVERPOOL-CHURCH-IF-recording-c-Sophie-Jarry-130-new-contrast-650x433.jpg\" class=\"attachment-medium size-medium wp-post-image\" alt=\"\" loading=\"lazy\" decoding=\"async\" srcset=\"https://www.alexandrapalace.com/wp-content/uploads/2026/03/Bill-RyderJones-2010-06-08-LIVERPOOL-CHURCH-IF-recording-c-Sophie-Jarry-130-new-contrast-650x433.jpg 650w, https://www.alexandrapalace.com/wp-content/uploads/2026/03/Bill-RyderJones-2010-06-08-LIVERPOOL-CHURCH-IF-recording-c-Sophie-Jarry-130-new-contrast-1620x1078.jpg 1620w, https://www.alexandrapalace.com/wp-content/uploads/2026/03/Bill-RyderJones-2010-06-08-LIVERPOOL-CHURCH-IF-recording-c-Sophie-Jarry-130-new-contrast-768x511.jpg 768w, https://www.alexandrapalace.com/wp-content/uploads/2026/03/Bill-RyderJones-2010-06-08-LIVERPOOL-CHURCH-IF-recording-c-Sophie-Jarry-130-new-contrast-1536x1022.jpg 1536w, https://www.alexandrapalace.com/wp-content/uploads/2026/03/Bill-RyderJones-2010-06-08-LIVERPOOL-CHURCH-IF-recording-c-Sophie-Jarry-130-new-contrast-2048x1363.jpg 2048w\" sizes=\"auto, (max-width: 650px) 100vw, 650px\" />                     </div>\n        <header class=\"event_details bg_white inner_padding\">\n            <p class=\"dates uc\"><strong>14 Nov 2026</strong></p>\n            <a href=\"https://www.alexandrapalace.com/whats-on/bill-ryder-jones/\" class=\"event_target\"><h3>Bill Ryder-Jones</h3>\n                            </a>\n        </header>\n        <footer class=\"event_item_footer bg_color_ap_blue\">\n            <div class=\"footer_content\">\n                <span target=\"_blank\" class=\"btn event_btn\">Info & Tickets <i class=\"sprite sprite_btn_arrow_white\"></i></span>\n            </div>\n                    </footer>\n    </a>\n</div>                        \n                        </div>\n                                    </div>\n                    </div>\n    </div>  <div class=\"container-fluid section-footer-newsletter-form\" id=\"footer-newsletter-form\">\n    <div class=\"row\">\n      <div class=\"col-sm-12\">\n        <div class=\"container\">\n          <div class=\"row\">\n            <div class=\"col-sm-12\">\n              <h2 style=\"text-align: left\" class=\"vc_custom_heading\">Sign up to our newsletter</h2>\n              <p>\n                Join our mailing list for Ally Pally updates, news and exclusive access to pre-sale tickets\n              </p>\n                      <form data-action=\"https://www.alexandrapalace.com/wp-json/spektrix/v1/form_tags\" class=\"form-inline\" id=\"ap_form_tags\" data-redirect=\"https://www.alexandrapalace.com/thank-you-for-signing-up/\">\n            <input type=\"hidden\" id=\"Tags\" name=\"Tags\" value=\"17601ADSBKGQMMPTLRCMTNQVQJNSBPVNG\">\n            <input type=\"hidden\" id=\"form_tags_nonce\" name=\"form_tags_nonce\" value=\"6300675430\" /><input type=\"hidden\" name=\"_wp_http_referer\" value=\"/whats-on/beth-orton/\" />            <div class=\"form-group name-group\">\n                <label for=\"FirstName\">Name</label>\n                <input name=\"FirstName\" id=\"FirstName\" type=\"text\" placeholder=\"Enter your first name\" required/>\n            </div>\n            <div class=\"form-group name-group lastname-group\">\n                <label for=\"LastName\">Surname</label>\n                <input name=\"LastName\" id=\"LastName\" type=\"text\" placeholder=\"Enter your surname\" required/>\n            </div>\n            <div class=\"form-group email-group\">\n                <label for=\"Email\">Email Address</label>\n                <input name=\"Email\" id=\"Email\" type=\"text\" placeholder=\"Enter your email address\" required/>\n            </div>\n            <div class=\"form-group control-group\">\n                <button type=\"submit\" class=\"ap_btn_fill_icon ap_btn_pink btn_subscribe\">Sign up</button>\n            </div>\n        </form>\n                    <div class=\"form-additional-text\"><p>Local to Ally Pally? <a href=\"https://alexandrapalace.com/community-sign-up/\">Sign up to our Community Newsletter</a></p></div>\n                <p class=\"signup_notice\">By signing up you are agreeing to our <a href=\"/privacy-policy/\">Privacy&nbsp;Policy</a></p>\n        <div id=\"ap_form_tags_response\"></div>\n                </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</main>\n<footer class=\"container-fluid site_footer\">\n  <div class=\"row\">\n    <div class=\"col-sm-12\">\n      <div class=\"container\">\n        <div class=\"row\">\n\n          <div class=\"col-md-3 order-md-1 footer_column\">\n            <h3 class=\"h5 text-uppercase\">social media</h5>\n              <ul class=\"list-inline social_icons\">\n                <li class=\"list-inline-item\">\n                  <a href=\"https://www.facebook.com/YourAllyPally\" target=\"_blank\" title=\"Ally Pally Facebook\"><span class=\"screen-reader-text\">Ally Pally Facebook</span><i class=\"sprite sprite_fb\"></i></a>\n                </li>\n                <li class=\"list-inline-item\">\n                  <a href=\"https://www.youtube.com/channel/UCokPPHKEjs_E6ipz549nueQ\" target=\"_blank\" title=\"Ally Pally Youtube\"><span class=\"screen-reader-text\">Ally Pally Youtube</span><i class=\"sprite sprite_yt\"></i></a>\n                </li>\n                <li class=\"list-inline-item\">\n                  <a href=\"https://twitter.com/Yourallypally\" target=\"_blank\" title=\"Ally Pally X\" loading=\"lazy\"><span class=\"screen-reader-text\">Ally Pally X</span><img src=\"https://www.alexandrapalace.com/wp-content/uploads/2024/04/X-Twitter-Logo-01.png\" alt=\"x\" width=\"20\"></a>\n                </li>\n                <li class=\"list-inline-item\">\n                  <a href=\"https://www.instagram.com/YourAllyPally/\" target=\"_blank\" title=\"Ally Pally Instagram\"><span class=\"screen-reader-text\">Ally Pally Instagram</span><i class=\"sprite sprite_i\"></i></a>\n                </li>\n                <li class=\"list-inline-item\">\n                  <a href=\"https://www.