          "content": {
            "mimeType": "text/html; charset=UTF-8",
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">\n\n  <title>not/nowhere | Events</title>\n\n  <link href=\"https://www.not-nowhere.org/assets/dist/css/styles.css\" rel=\"stylesheet\">  <!-- UPDATE 0005 -->\n  <!-- Bnomei\\Fingerprint:: -->\n\n  <!-- Matomo -->\n  <script>\n    var _paq = window._paq = window._paq || [];\n    /* tracker methods like \"setCustomDimension\" should be called before \"trackPageView\" */\n    _paq.push(['trackPageView']);\n    _paq.push(['enableLinkTracking']);\n    (function() {\n      var u=\"https://stats.webarch7.co.uk/\";\n      _paq.push(['setTrackerUrl', u+'matomo.php']);\n      _paq.push(['setSiteId', '98']);\n      var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];\n      g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);\n    })();\n  </script>\n  <!-- End Matomo Code -->\n\n</head>\n<body>\n\n\n<nav class=\"navigation\" role=\"navigation\">\n  <ul class=\"menu\">\n    <ul class=\"menu-head\">\n      <li class=\"menu-logo\">\n                  <a id=\"menu-logo-full\" href=\"https://www.not-nowhere.org\" rel=\"home\">\n            <img src=\"https://www.not-nowhere.org/media/site/5b2b956b0e-1703984020/nnw_logo_1_green.png\" alt=\"\">\n          </a>\n                          <a id=\"menu-logo-circle\" href=\"https://www.not-nowhere.org\" rel=\"home\">\n            <img src=\"https://www.not-nowhere.org/media/site/690ef4cd61-1703984020/nnw_logo_2_green.png\" alt=\"\">\n          </a>\n              </li>\n      <li id=\"menu-toggle\">\n        <a class=\"shadow\">Menu</a>\n      </li>\n    </ul>\n    <ul id=\"menu-drop\">\n              <li class=\"menu-item\">\n          <a class=\"shadow  active\" href=\"https://www.not-nowhere.org/on\">Events</a>\n        </li>\n              <li class=\"menu-item\">\n          <a class=\"shadow \" href=\"https://www.not-nowhere.org/join\">Community</a>\n        </li>\n              <li class=\"menu-item\">\n          <a class=\"shadow \" href=\"https://www.not-nowhere.org/about\">About</a>\n        </li>\n              <li class=\"menu-item\">\n          <a class=\"shadow \" href=\"https://www.not-nowhere.org/hire\">Hire</a>\n        </li>\n            <li class=\"menu-item\">\n        <a class=\"snipcart-checkout shadow \" href=\"https://www.not-nowhere.org/hire\">Cart</a>\n      </li>\n    </ul>\n  </ul>\n</nav>\n\n\n<main class=\"main\">\n\n<h2>Upcoming Events</h2>\n  <div class=\"month upcoming\">\n          <div class=\"card shadow card-event on-item\">\n  <a href=\"https://www.not-nowhere.org/on/dear-diary\" class=\"no-a-style\">\n\n    <div class=\"card-info\">\n      <div class=\"card-text\">\n        <div class=\"card-text-dates\">\n          <div class=\"card-text-date\">\n            <span class=\"ft-small\">Sun</span>\n            <span class=\"ft-small\">8</span>\n            <span class=\"ft-small\">Mar</span>\n          </div>\n                  </div>\n\n        <div class=\"card-text-info\">\n                      <h3>Dear Diary...</h3>\n                    <p class=\"ft-small\">\n                          Sine Screen and not/nowhere are excited to present this screening and activity, exploring the diary film form.                      </p><br />\n          <div class=\"on-type\">\n                                  </div>\n        </div>\n      </div>\n    </div>\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/dear-diary/be3910f8a0-1770161617/sleeping05.png)\"></div>\n      </div>\n    \n  </a>\n</div>\n      </div>\n\n<h2>Past Events</h2>\n  <div class=\"month\">\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/1-aaton-ltr/c187da5bbd-1703984025/screenshot-2023-09-06-at-13.40.37.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Aaton LTR</h3>\n            <p class=\"ft-small\">\n                  In this one-day workshop, you will receive practical training in the use of the Aaton LTR camera, an industry-standard Super 16mm camera.              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/10-basic-bolex/42bf4218ce-1708612426/16mm-bw_-notations.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Basic Bolex H16 B&W</h3>\n            <p class=\"ft-small\">\n                  This workshop will be a basic introduction to the inner workings of the 16mm Bolex Camera.              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/11-writing-sentence-structure/4da9f3f85f-1703984051/img_8742.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Writing: Sentence Structure</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/12-super-8-no-processing/2743b94ee3-1703984043/images.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Super 8 (No Processing)</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/13-writing-with-performance-and-video/108751e1a3-1708502519/time.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Writing for Time Based Media</h3>\n            <p class=\"ft-small\">\n                  In this practice-oriented workshop we will explore playful approaches towards writing with a focus on time, pace, and rhythm.              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/14-one-to-one-writing-tutorials/4653bd867f-1703984022/3c8fafc8-79c3-4653-aa42-848e56cc175b.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>One-to-One Writing Tutorials</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/15-basic-budgeting/55450df3be-1703984034/screenshot-2021-07-12-at-11.16.34.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Basic Budgeting</h3>\n            <p class=\"ft-small\">\n                  Register for this finance literacy workshop to develop and use financial skills and tools in service of your values and goals              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/16-steenbeck-editing/57ddafe33b-1703984050/whatsapp-image-2023-03-07-at-14.27.00-1.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Steenbeck Editing</h3>\n            <p class=\"ft-small\">\n                  Learn to edit film on a Steenbeck editing Table.              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/17-super-8-online-workshop/bb1765ba49-1703984025/img_3774.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Super 8 Online Workshop</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/18-bolex-online-workshop/933f79b8c2-1703984023/still-1.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Bolex Online Workshop</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/19-writing-enunciation-cadence-and-play-part-2/6fa2076c45-1703984052/kamau.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Writing: Enunciation, Cadence and Play - Part 2</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/2-direct-animation-on-16mm-film/305890e0a0-1730142517/3_alternative-economies_2021_rz-resized.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Direct Animation on 16mm Film</h3>\n            <p class=\"ft-small\">\n                  Join artists Leena Habiballa, Ibrahim Kargbo and Rehana Zaman over 2 sessions for a camera-less film workshop.              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/20-cameraless-filmmaking-correspondence-workshop/678eb5a394-1703984031/rhea-workshop-2.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Cameraless Filmmaking via Correspondence</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/21-enunciation-cadence-and-play/d12fe2a6fb-1703984052/workshopimg.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Enunciation, Cadence and Play</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/3-feedback-sessions-with-an-artist/3979068d98-1708501780/solo-taxonomy-with-verbs.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Feedback Sessions with an Artist</h3>\n            <p class=\"ft-small\">\n                  Space for listening, reflection and conversation around next steps on your creative projects, at whatever stage of realisation.              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/4-a-film-without-images/8f9006fa4b-1703984042/sjp1.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>A Film Without Images</h3>\n            <p class=\"ft-small\">\n                  With guest artist Shenece Oretha, Sandra Jean Pierre explores sound possibilities in arts and research contexts.              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/5-analogue-short-film-screening/e8adaf11bf-1703984047/post-2-copy.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Analogue Short Film Screening</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/6-advanced-super-8/4aabaac4d0-1703984049/super-8-illustrated-lecture-still.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Advanced Super 8</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/7-basic-budgeting-june-2023/3aaa58c19e-1703984041/screenshot-2023-05-08-at-14.42.43.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Basic Budgeting</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/8-writing-about-me/37b8aa4245-1708501945/img_1487.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Writing: About Me (Online)</h3>\n            <p class=\"ft-small\">\n                  How are you going to write an artist bio that you feel good about if you struggle to say nice things about yourself?              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/9-basic-super-8/1ce64a4351-1703984031/screenshot-2023-09-26-at-13.51.08.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Basic Super 8</h3>\n            <p class=\"ft-small\">\n                  A one day workshop where you will be put into pairs to shoot your own footage, then a feedback session.              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/a-film-without-images-2/3c13e5d1f6-1707332085/sjp1.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>A Film Without Images 2</h3>\n            <p class=\"ft-small\">\n                  Explore and practice sound storytelling possibilities.              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/advanced-super8/e3494a6e5b-1708960779/ad-super8.jpeg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Advanced Super8</h3>\n            <p class=\"ft-small\">\n                  For participants who have a basic understanding of the Super8 camera.              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/analogue-in-depth-how-an-image-holds-time/55dbd144f8-1738013430/blue_threshold_colourised.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Analogue in Depth: How an Image Holds Time</h3>\n            <p class=\"ft-small\">\n                  Discuss film in depth, with a presentation about film, time and grief              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/basic-budgeting-online/eb33109baa-1707331283/pig.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Basic Budgeting (Online)</h3>\n            <p class=\"ft-small\">\n                  Are you an organiser, an artist, member of a community group or other projects, and interested in solidarity economy approaches to finances?              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/five-notations-screening-6-30pm1/eaec56b1af-1712747164/kobby-adi-_-music-for-skeletons.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Five Notations Screening - 6:30PM</h3>\n            <p class=\"ft-small\">\n                  This screening event, which accompanies the Bolex workshop on the 28th, frames films on print, capturing light and sound as notation.              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/hand-eco-processing/eadd0a8c27-1754318206/nn__dark_room_01.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Hand Eco-Processing</h3>\n            <p class=\"ft-small\">\n                  Learn the basics of developing black and white 16mm film as a negative with different eco developers.              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/intro-to-bolex-colour/0c513c0925-1710511219/16mm-colour_-notations.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Intro to Bolex: Colour</h3>\n            <p class=\"ft-small\">\n                  This workshop will be a basic introduction to the inner workings of the 16mm Bolex Camera, with colour film.              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/intro-to-photochemical-filmmaking/3c5df65b8f-1738014094/super-8-workshop-image.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Intro to Photochemical Filmmaking</h3>\n            <p class=\"ft-small\">\n                  After this workshop you’ll be able to pick up any film camera, from stills to films.              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/krasnogorsk-3-arriflex-sr2/148b43357a-1712666019/mv5byji1ywexodctzjzins00mddkltlkmwitogyymjuynwi1y2m4xkeyxkfqcgdeqxvymjuyndk2odc@._v1.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Krasnogorsk-3 & Arriflex SR2</h3>\n            <p class=\"ft-small\">\n                  This is a workshop demonstrating the Krasnogorsk-3 and the Arriflex SR2  - a small format artists’ camera and a set standard cinema camera.              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/storytelling-unlocking-narrative-through-five-act-structure/b3fe6368b6-1738014468/img_4211.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Storytelling: Unlocking Narrative Through Five-Act Structure</h3>\n            <p class=\"ft-small\">\n                  Participants will learn the fundamentals of storytelling, gaining practical tools to craft compelling narratives.              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/writing-about-me/217e33156d-1708960278/img_1487.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Writing About Me</h3>\n            <p class=\"ft-small\">\n                  How are you going to write an artist bio that you feel good about if you struggle to say nice things about yourself?              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/writing-value/52c2e812d5-1738010813/img_8401.jpeg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Writing: Value</h3>\n            <p class=\"ft-small\">\n                  A writing workshop by Daniella Valz Gen and Taylor Le Melle that asks, what are words worth?              </p><br />\n      <div class=\"on-type\">\n                  <img src='assets/dist/images/s_workshop.png' />\n          <p class=\"ft-small\">\n              Workshop          </p>\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/20181012-representation-and-praxis/f53e4a928d-1703984020/a-is-for-artist-eye-01.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Representation and Praxis</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/20190202-shenece-oretha/f60e6391e2-1703984024/1890x1060.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Shenece Oretha</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/20200313-tongues/2c58e9fb62-1703984039/img_8401.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Rehana Zaman / Taylor Le Melle in Conversation</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/20200321-freeyard/7bd67cec6a-1703984050/whatsapp-image-2020-02-04-at-13.54.48.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>SUBURBAN DESIRES - CANCELLED</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-exhibition on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/20200322-fy001/0daac345a1-1703984044/whatsapp-image-2020-02-04-at-13.54.48.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>SUBURBAN DESIRES - CANCELLED</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/20200407-job-treasurer/4bb99a44a6-1703984042/nnw_logo_1_green.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Job Opportunity - Cooperative Treasurer</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/20201129-autumn-newsletter/2ccbb413dc-1703984041/community-nn-2nd-draft.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Autumn Newsletter</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/20230105-seeking-trustees/8f3ef849a7-1703984020/s-l500.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Seeking Trustees</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/20230628-access-rider/46415fe568-1703984039/access-riders-wide.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Access Riders: Now What?</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/20231012-marasa-castle-cinema/d9340dd647-1703984020/artboard-21-copy-6.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Sounds Of Worships: A film screening night by Marasa</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/20231014-analogue-film-screening-5-45pm/6ba32f4907-1703984049/cookie-tin-2-with-cores-copy.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Analogue Short Film Screening 5:45pm</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/20231014-analogue-short-film-screening/a945c2fddd-1703984052/cookie-tin-2-with-cores-copy.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Analogue Short Film Screening 7:45pm</h3>\n            <p class=\"ft-small\">\n                                </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/20231019-film-screening-we-are-many/5306bf50d7-1703984042/cubitt_wam.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Film Screening: We Are Many</h3>\n            <p class=\"ft-small\">\n                  We stand in solidarity with the Palestinian people, their right to freedom, to land, to life, to dignity and empathy.              </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/submission-call-out-analogue-short-films-bipoc-folks-vol-2/5db9245e8a-1729262452/screenshot_2024-10-18_at_15.40.18.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Submission Call Out: Analogue Short Films: BIPOC Folks Vol 2</h3>\n            <p class=\"ft-small\">\n                  By Saturday 16th Nov 6pm, submit short films shot, directed and/or written by BIPOC artists/ filmmakers using 8mm, 16mm and 35mm.              </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/cinema-4-all-advanced-colour-bolex-how-an-image-holds-time/b3bf50723b-1730148152/blue_threshold_colourised-logo.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Cinema 4 All: Advanced Colour Bolex, How An Image Holds Time</h3>\n            <p class=\"ft-small\">\n                  This special edition workshop is supported by Cinema For All and will culminate with a ticketed public screening of participants’ films.              </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/submission-call-out-analogue-short-films-bipoc-folks-vol-2/5db9245e8a-1729262452/screenshot_2024-10-18_at_15.40.18.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Analogue Short Film Screening: BIPOC Folks Vol 2</h3>\n            <p class=\"ft-small\">\n                  Analogue Short Film Screening of short films shot, directed and/or written by BIPOC artists/ filmmakers using 8mm, 16mm and 35mm.              </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/cinema-4-all-screening/d81209d533-1730148589/beginning_threshold_colourised-layered-logo.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Cinema 4 All Screening</h3>\n            <p class=\"ft-small\">\n                  This special edition screening is supported by Cinema For All and is our closing event for 2024.              </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/open-studio-day/95c85b0576-1739701715/edit_sup01-scaled.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Open Studio Day</h3>\n            <p class=\"ft-small\">\n                  With Centre for the Conservation Art & Media at UCL East, we offer an open day exploring the network available to artists working in film.              </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/hiring-cooperative-financial-officer/02cba25974-1750854876/edit_sup01-scaled.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Hiring: Cooperative Financial Officer</h3>\n            <p class=\"ft-small\">\n                  Deadline Extended to 7 July! \nJob Vacancy, Freelance Cooperative Financial Officer. 14 hours/ Month. 27£/ hour. Based in London E9.              </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/screening-and-conversation-with-christopher-j-harris/6c88ff6658-1752307721/chris_h2.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>In Conversation with Christopher J. Harris</h3>\n            <p class=\"ft-small\">\n                  Join us for an exciting talk by celebrated artist-filmmaker Christopher J. Harris, journeying through his eclectic Black cinema influences.              </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/sound-as-a-tool-for-liberation/3394dfe51b-1752835274/logo-for-not_nowhere.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Sound as a Tool for Liberation</h3>\n            <p class=\"ft-small\">\n                  Audio workshop: sound as a tool for liberation by Tiny Lungs              </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/creative-lighting-mastering-tungsten-on-tape/cb60db4778-1753890272/creative-lighting.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Creative Lighting: Mastering Tungsten on Tape</h3>\n            <p class=\"ft-small\">\n                  Join our favourite gaffer, Cat Castro, for a 2-day session that looks at the fundamentals of lighting and its power to create an image.              </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/the-long-short-of-it/83a9fcdf95-1753890568/the-long-short-of-it.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>The Long & Short of It</h3>\n            <p class=\"ft-small\">\n                  Led by Alia Syed, this workshop will involve sharing memories through objects and the Bolex.              </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/bumping-into-the-frame-constructive-collisions-and-the-apparatus-of-cinema/3ac8cb55e1-1753892206/the-land-at-night-1.png)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Bumping into the Frame: Constructive Collisions and the Apparatus of Cinema</h3>\n            <p class=\"ft-small\">\n                  This program brings together seven handcrafted film works by Australian analogue experimentalists Richard Tuohy and Dianna Barrie.              </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-workshop-date on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/hand-eco-processing/eadd0a8c27-1754318206/nn__dark_room_01.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Hand Eco-Processing</h3>\n            <p class=\"ft-small\">\n                  Learn the basics of developing black and white 16mm film as a negative with different eco developers.              </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/the-works-of-lynn-loo-guy-sherwin/dbc917e55c-1753891135/the-works-of-lynn-loo-guy-sherwin.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>The Works of Lynn Loo & Guy Sherwin</h3>\n            <p class=\"ft-small\">\n                  A performance screening demonstrating the wide range of techniques used by moving image artists Lynn Loo & Guy Sherwin.              </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/the-art-of-projection/5d005833b2-1753891739/the-art-of-projection.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>The Art of Projection</h3>\n            <p class=\"ft-small\">\n                  A hands-on workshop on the techniques of projection.              </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n          <div class=\"card shadow card-event on-item no-hover\">\n\n          <div class=\"card-img-wrapper\">\n        <div class=\"card-img\" style=\"background-image: url(https://www.not-nowhere.org/media/pages/on/analogue-in-depth-why-shoot-analogue/22f724d385-1759166067/thumb.jpg)\"></div>\n      </div>\n        <div class=\"card-text\">\n              <h3>Analogue in Depth: Why Shoot Analogue</h3>\n            <p class=\"ft-small\">\n                  A dialogue between Jennifer Lauren Martin and Taylor Le Melle about films that depict black life and their relationship to black audiences.              </p><br />\n      <div class=\"on-type\">\n              </div>\n    </div>\n\n</div>\n      </div>\n\n\n</main>\n\n<footer class=\"footer\">\n  <div class=\"footer-connect\">\n    <h2 class=\"section-tag ft-small\">\n        Connect\n    </h2>\n    <div class=\"footer-connect-links\">\n      <a class=\"connect shadow\" href=\"https://www.instagram.com/not.nowhere\" target=\"_blank\"><svg version=\"1.1\" id=\"Layer_1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\"\n\t width=\"1000px\" height=\"1000px\" viewBox=\"0 0 1000 1000\" enable-background=\"new 0 0 1000 1000\" xml:space=\"preserve\">\n<path fill=\"black\" d=\"M500,96.623c131.379,0,146.939,0.502,198.828,2.869c47.973,2.189,74.023,10.203,91.363,16.941\n\tc21.371,7.888,40.703,20.465,56.574,36.807c16.342,15.871,28.919,35.203,36.807,56.574c6.738,17.338,14.754,43.391,16.941,91.363\n\tc2.367,51.885,2.869,67.445,2.869,198.828s-0.502,146.939-2.869,1