a = document.createElement(\"meta\");\n    meta.name = \"robots\";\n    meta.content = \"noindex, nofollow\";\n    document.head.appendChild(meta);\n  }\n})();\n</script>\n\n<!-- Cookie-first (disabled in staging)\n<script src=\"https://consent.cookiefirst.com/sites/fulhampierstaging.peoplevine.co.uk-b945cdf1-ce72-46fe-afd1-a24c486800ac/consent.js\"></script>\n-->\n\n<!-- Small global CSS fixes -->\n<style>\n  /* Prevent iOS font zoom */\n  * { -webkit-text-size-adjust: none !important; }\n  /* Ensure consent UI sits above all content */\n  .cookiefirst-root {\n    z-index: 9999999999999999999999 !important;\n    position: relative !important;\n  }\n  /* Hide the testing category (3644) */\n  .3644 { display: none !important; }\n</style>\n\n<!-- Google Tag Manager -->\n<script>\n(function(w,d,s,l,i){\n  w[l]=w[l]||[];\n  w[l].push({ \"gtm.start\": new Date().getTime(), event:\"gtm.js\" });\n  var f=d.getElementsByTagName(s)[0], j=d.createElement(s), dl=l!=\"dataLayer\"?\"&l=\"+l:\"\";\n  j.async=true; j.src=\"https://www.googletagmanager.com/gtm.js?id=\"+i+dl;\n  f.parentNode.insertBefore(j,f);\n})(window,document,\"script\",\"dataLayer\",\"GTM-TRZSXS3T\");\n</script>\n<!-- End Google Tag Manager -->\n\n<!--\n  UI: Invert nav on specific admin/custom pages once Alpine is ready\n-->\n<script>\ndocument.addEventListener(\"alpine:init\", () => {\n  const invertIds = [\n    \"custom_page-2921\",\n    \"admin_event_tickets\",\n    \"admin_customer_create\",\n    \"admin_customer_payment_information\",\n    \"custom_page-2953\",\n    \"admin_event_ticket_share\",\n    \"custom_page-2927\"\n  ];\n  if (invertIds.includes(document.body.id)) {\n    const nav = document.querySelector(\".fpr-section-navigation\");\n    if (nav) nav.classList.add(\"fpr-navigation-invert\");\n  }\n});\n</script>\n\n<!--\n  SEO/Routes:\n   - /news/* â†’ main site /news\n   - /event/{id} â†’ /whats-on/event?event_no={id}\n-->\n<script>\n// Redirect legacy news paths to main site news hub\nif (window.location.pathname.includes(\"/news/\")) {\n  window.location.href = \"https://fulhampier.com/news\";\n}\n\n// Redirect raw event detail to new what's-on route\n(function () {\n  const { pathname } = window.location;\n  const match = pathname.match(/^\\/event\\/(\\d+)\\/?$/);\n  if (match) {\n    const eventNo = match[1];\n    window.location.replace(`/whats-on/event?event_no=${eventNo}`);\n  }\n})();\n</script>\n\n<!--\n  One-off remap: when event_no=88911 â†’ 88903\n  (Keeps the rest of the URL intact)\n-->\n<script>\n(function () {\n  const url = new URL(window.location.href);\n  if (url.searchParams.get(\"event_no\") === \"88911\") {\n    url.searchParams.set(\"event_no\", \"88903\");\n    window.location.href = url.toString();\n  }\n})();\n</script>\n\n<!--\n  Route alias: /events â†’ /whats-on\n-->\n<script>\nif (window.location.pathname.includes(\"/events\")) {\n  window.location.href = window.location.href.replace(\"/events\", \"/whats-on\");\n}\n</script>\n\n<!--\n  Post-login flow: flag=passwordsent â†’ take users to confirmation page\n-->\n<script>\nwindow.addEventListener(\"load\", () => {\n  const params = new URLSearchParams(window.location.search);\n  if (params.get(\"flag\") === \"passwordsent\") {\n    window.location.href = \"/password-reset-notification?dontTrack=true&preview=2912\";\n  }\n});\n</script>\n\n<script>\n(function passwordResetRedirect() {\n  console.group(\"[PR] Password reset redirect check\");\n\n  const referrer = document.referrer;\n  console.log(\"[PR] Current URL:\", window.location.href);\n  console.log(\"[PR] document.referrer:\", referrer);\n\n  // Parse the referrer URL to check its query params\n  let refParams = null;\n  try {\n    refParams = new URL(referrer).searchParams;\n  } catch (err) {\n    console.log(\"[PR] No valid referrer URL â€” not a redirect from password reset\");\n    console.groupEnd();\n    return;\n  }\n\n  const referrerPath = new URL(referrer).pathname;\n  const passwordStatus = refParams.get(\"passsword\") || refParams.get(\"password\"); // typo-safe\n\n  console.log(\"[PR] Referrer pathname:\", referrerPath);\n  console.log(\"[PR] Referrer passsword param:\", passwordStatus);\n\n  // Both signals: referrer was the reset page AND its status was 'complete'\n  const fromResetPage = referrerPath.toLowerCase() === \"/password/reset\";\n  const isComplete = passwordStatus === \"complete\";\n\n  console.log(\"[PR] From /password/reset:\", fromResetPage);\n  console.log(\"[PR] Status is complete:\", isComplete);\n\n  if (fromResetPage && isComplete) {\n    // Guard against redirect loops â€” don't fire if we're already on the target\n    if (window.location.pathname.toLowerCase() === \"/password-reset-complete\") {\n      console.log(\"[PR] Already on /password-reset-complete â€” no action\");\n      console.groupEnd();\n      return;\n    }\n\n    console.log(\"%c[PR] âœ… Password reset complete â€” redirecting\", \"color: #4CAF50; font-weight: bold;\");\n    console.groupEnd();\n    window.location.replace(\"/password-reset-complete\");\n    return;\n  }\n\n  console.log(\"[PR] Not a completed password reset â€” no redirect\");\n  console.groupEnd();\n})();\n</script>\n\n<!--\n  Password reset (body#password_forgot):\n   - Hijack form submit â†’ POST via fetch â†’ on 200 OK go to /password-reset-complete\n-->\n<!--\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  if (document.body.id !== \"password_forgot\") return;\n  if (!window.curObj || !window.curObj.key) return;\n\n  const form = document.getElementById(\"mainForm\");\n  if (!form) return;\n\n  form.addEventListener(\"submit\", (event) => {\n    event.preventDefault();\n\n    const formData = new FormData(form);\n    const actionUrl = form.action;\n\n    fetch(actionUrl, { method: form.method, body: formData })\n      .then((res) => {\n        if (res.ok) {\n          const url = new URL(actionUrl);\n          url.pathname = \"/password-reset-complete\";\n          window.location.href = url.toString();\n        } else {\n          alert(\"There was an error submitting the form.\");\n        }\n      })\n      .catch((err) => {\n        console.error(\"Error:\", err);\n        alert(\"There was an error submitting the form.\");\n      });\n  });\n});\n</script>\n-->\n\n<!--\n  Checkout return:\n   - If localStorage.checkout_purchase exists, show loader then redirect back\n-->\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  const redirectUrl = localStorage.getItem(\"checkout_purchase\");\n  const loader = document.querySelector(\".fpr-loader-container\");\n\n  if (redirectUrl && loader) {\n    loader.style.display = \"flex\";\n    setTimeout(() => {\n      localStorage.removeItem(\"checkout_purchase\");\n      window.location.href = redirectUrl;\n    }, 2500); // 2.5s for a small UX pause\n  }\n});\n</script><link rel=\"stylesheet\" type=\"text/css\" href=\"https://peoplevineuk.blob.core.windows.net/files/41/style/208_css.min.css\">\n<script type=\"text/javascript\" src=\"https://www.fulhampier.com/scripts/bundle.min.js?build=20261001\"></script>\n<script type=\"text/javascript\">curObj['customer_no'] = 0;curObj['business_no'] = 0;curObj['page_style_no'] = 208;curObj['domain_no'] = 323;var user = { sessionID: 'zgtwh2nmaspae4ud0kbzsquw', ipAddress: '160.79.106.137'}</script><script>window.SETTINGS = {}; SETTINGS.PAGE_NAME = '/url_vanity.aspx'; SETTINGS.COMPANY_NO = 41; SETTINGS.TIMEZONE_OFFSET = 1; SETTINGS.COMPANY_NAME = 'Fulham Pier'; SETTINGS.EMAIL = 'hi@fulhampier.com'; SETTINGS.DATEFORMAT = 'dd/mm/yy'; SETTINGS.COUNTRYCODE = 'en-GB'; SETTINGS.CURRENCYSYMBOL = '£';</script><title>\n\tWhat's on at Fulham Pier\n</title><link href=\"https://core.service.elfsight.com\" rel=\"preconnect\" crossorigin=\"\"><style type=\"text/css\">div.eapps-widget{position:relative}div.eapps-widget.eapps-widget-show-toolbar:before{content:\"\";pointer-events:none;z-index:1;border:1px solid #0000;transition:border .3s;display:block;position