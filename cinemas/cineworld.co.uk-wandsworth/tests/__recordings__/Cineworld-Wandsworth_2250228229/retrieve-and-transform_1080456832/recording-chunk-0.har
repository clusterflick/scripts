          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014777\",\"name\":\"Met Opera 2026-27: Manon\",\"originalName\":\"Met Opera 2026-27: Manon\",\"length\":265,\"posterLink\":\"https://regalcdn.azureedge.net/CW/MetOpera202627Manon/HO00014777/TV_SmallPosterImage/20260604-050410503.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/MetOpera202627Manon/HO00014777/TV_LargePosterImage/20260604-045906097.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/met-opera-2026-27-manon/ho00014777\",\"weight\":0,\"releaseYear\":\"2027\",\"releaseCountry\":null,\"cast\":\"Matthew Polenzani, Nadine Sierra, Rod Gilfry, Yves Abel, Andrzej Filończyk, Jean Teitgen, Carlo Bosi\",\"directors\":\"The Metropolitan Opera\",\"synopsis\":\"Following her radiant performance in Gounod’s Roméo et Juliette—which garnered raves for “high notes that spun like liquid gold … Sierra touched the operatic firmament” (The New York Times)—superstar soprano Nadine Sierra takes on another alluring French heroine, the irresistible title character of Massenet’s passionate drama, live from the Met stage to cinemas worldwide. Leading tenor Matthew Polenzani is her idealistic lover, the Chevalier des Grieux, with rising-star baritone Andrzej Filończyk as her stalwart cousin, Lescaut, in a breathtaking staging by director Laurent Pelly.\",\"dateStarted\":\"2027-04-03T00:00:00\",\"eventCount\":43,\"categoriesAttributes\":[],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"alternative-content\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627Manon/HO00014777/TV_TopShelfPosterImage/20260604-045906097.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627Manon/HO00014777/TV_SmallPosterImage/20260604-050410503.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627Manon/HO00014777/Mobile_MovieThumbnail/20260604-045906097.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627Manon/HO00014777/TV_LargePosterImage/20260604-045906097.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627Manon/HO00014777/Mobile_MovieFeed/20260604-045945504.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"TRAFALGAR RELEASING\"}}}",
