            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014922\",\"name\":\"Talking Tom Heroes: Suddenly Super\",\"originalName\":\"Talking Tom Heroes: Suddenly Super\",\"length\":66,\"posterLink\":\"/xmedia/img/10108/film.placeholder.poster.jpg\",\"posterLinkLarge\":\"/xmedia/img/10108/film.placeholder.poster.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/talking-tom-heroes-suddenly-super/ho00014922\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Luke Halliwell, Julie-Ann Dean, Phillip Sacramento, David Holt, Kathryn Maccoll\",\"directors\":\"Paul Hunt\",\"synopsis\":\"Talking Tom and his superhero friends are coming to the big screen for the first time ever! It’s an hour-long show featuring your very favorite episodes of the hit series “Talking Tom Heroes: Suddenly Super” - and also some never-before-seen surprises. You’ll even get a chance to become part of the action as you play interactive games, shout at the screen, and sing along to Tom’s hero theme. Get ready to get super, because you’ve never seen the heroes like this!\",\"dateStarted\":\"2026-07-25T00:00:00\",\"eventCount\":432,\"categoriesAttributes\":[\"action\",\"animation\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"audio-described\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/TBC.png\",\"ageRestrictionName\":\"tbc\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[],\"specialMessage\":null,\"distributorName\":\"CINEWORLD CINEMAS\"}}}",
