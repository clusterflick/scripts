            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014891\",\"name\":\"Idhayam Murali (Tamil)\",\"originalName\":\"Idhayam Murali (Tamil)\",\"length\":164,\"posterLink\":\"https://regalcdn.azureedge.net/CW/IdhayamMuraliTamil/HO00014891/TV_SmallPosterImage/20260707-122312407.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/IdhayamMuraliTamil/HO00014891/TV_LargePosterImage/20260707-122312407.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/idhayam-murali-tamil/ho00014891\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Fahadh Faasil, Anju Kurian, Atharvaa Murali, Jonita Gandhi, Kayadu Lohar, Preity Mukundhan\",\"directors\":\"Aakash Baskaran, Senthil Kumar Kesavan\",\"synopsis\":\"The story follows a young man named Idhaya as he navigates the joys, heartbreak, and emotional maturity of one-sided love while balancing friendship, growing up, and life's unexpected turns.\",\"dateStarted\":\"2026-07-10T00:00:00\",\"eventCount\":95,\"categoriesAttributes\":[\"drama\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"laser\",\"reserved-selected\",\"subbed\",\"tamil\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/IdhayamMuraliTamil/HO00014891/TV_TopShelfPosterImage/20260707-122312407.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/IdhayamMuraliTamil/HO00014891/TV_SmallPosterImage/20260707-122312407.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"