          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014763\",\"name\":\"RBO Cinema Season 2026-27: La Fanciulla Del West\",\"originalName\":\"RBO Cinema Season 2026-27: La Fanciulla Del West\",\"length\":195,\"posterLink\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627LaFanciullaDelWest/HO00014763/TV_SmallPosterImage/20260528-061827006.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627LaFanciullaDelWest/HO00014763/TV_LargePosterImage/20260528-061704738.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/rbo-cinema-season-2026-27-la-fanciulla-del-west/ho00014763\",\"weight\":0,\"releaseYear\":\"2027\",\"releaseCountry\":null,\"cast\":\"Sondra Radvanovsky, Christopher Maltman, SeokJong Baek\",\"directors\":\"Richard Jones\",\"synopsis\":\"Puccini’s exhilarating drama of the Wild West returns in a new staging by celebrated British director Richard Jones, marking the company’s first new production of La Fanciulla del West in more than 30 years. Soprano Sondra Radvanovsky adds to her already remarkable Met repertoire, making her role debut as Minnie, the tough tavern owner with a heart of gold who finds love when she least expects it. Tenor SeokJong Baek is the dashing bandit who rambles into the remote California mining town to steal her heart, opposite baritone Christopher Maltman as the lawman determined to deliver rough justice—and win Minnie for himself. Maestro Keri-Lynn Wilson takes the podium to conduct one of opera’s most action-packed adventures, live from the Met stage to cinemas worldwide. This production is part of the Met’s award-winning Live in HD series, bringing opera to cinemas across the globe.\",\"dateStarted\":\"2027-01-26T00:00:00\",\"eventCount\":74,\"categoriesAttributes\":[],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"alternative-content\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627LaFanciullaDelWest/HO00014763/TV_TopShelfPosterImage/20260528-061704738.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627LaFanciullaDelWest/HO00014763/TV_SmallPosterImage/20260528-061827006.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627LaFanciullaDelWest/HO00014763/Mobile_MovieThumbnail/20260528-061704738.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627LaFanciullaDelWest/HO00014763/TV_LargePosterImage/20260528-061704738.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627LaFanciullaDelWest/HO00014763/Mobile_MovieFeed/20260528-061740994.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"TRAFALGAR RELEASING\"}}}",
