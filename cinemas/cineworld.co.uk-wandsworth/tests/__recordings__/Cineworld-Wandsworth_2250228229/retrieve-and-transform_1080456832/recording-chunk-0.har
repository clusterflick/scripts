            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014096\",\"name\":\"Jana Nayagan (Tamil)\",\"originalName\":\"Jana Nayagan (Tamil)\",\"length\":183,\"posterLink\":\"https://regalcdn.azureedge.net/CW/JanaNayaganTamil/HO00014096/TV_SmallPosterImage/20251222-051649042.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/JanaNayaganTamil/HO00014096/TV_LargePosterImage/20251222-051514259.jpg\",\"videoLink\":\"https://youtu.be/MKUDHKf_pkg\",\"link\":\"https://www.cineworld.co.uk/films/jana-nayagan-tamil/ho00014096\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Priyamani, Bobby Deol, Prakash Raj, Shruti Haasan, Pooja Hegde, Gautham Vasudev Menon, Vijay, Mamitha Baiju, Narain .\",\"directors\":\"H. Vinoth\",\"synopsis\":\"Two Ideologies: One truth, One thirst for control. A child's fear ignites a former police officer into a battle far beyond personal revenge.\",\"dateStarted\":\"2026-07-24T00:00:00\",\"eventCount\":415,\"categoriesAttributes\":[\"action\",\"drama\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"audio-described\",\"laser\",\"recliner\",\"reserved-selected\",\"subbed\",\"superscreen\",\"tamil\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/15.png\",\"ageRestrictionName\":\"15\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/JanaNayaganTamil/HO00014096/Mobile_MovieFeed/20251218-061740504.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"},{\"type\":\"Video\",\"subType\":\"Trailer_Youtube\",\"url\":\"https://youtu.be/MKUDHKf_pkg\",\"dimensionHeight\":null,\"dimensionWidth\":null},{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/JanaNaya