            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014901\",\"name\":\"£2 Family Films: Wallace & Gromit A Close/A Matter\",\"originalName\":\"£2 Family Films: Wallace & Gromit A Close/A Matter\",\"length\":62,\"posterLink\":\"/xmedia/img/10108/film.placeholder.poster.jpg\",\"posterLinkLarge\":\"/xmedia/img/10108/film.placeholder.poster.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/2-family-films-wallace-gromit-a-closea-matter/ho00014901\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Geraldine McEwan, Anne Reid, Peter Sallis, Justin Fletcher, Sally Lindsay, Melissa Collier, Ben Whitehead, Sarah Laborde\",\"directors\":\"Nick Park\",\"synopsis\":\"A Close Shave \\n\\nWallace's whirlwind romance with the owner of the local wool shop puts his head in a spin; Gromit is framed for sheep-rustling in a fiendish criminal plot.\\n\\nA Matter of Loaf & Death\\n\\nWallace and his dog, Gromit, open a bakery and get tied up with a murder mystery. But when Wallace falls in love, Gromit is left to solve the case.\",\"dateStarted\":\"2026-07-17T00:00:00\",\"eventCount\":300,\"categoriesAttributes\":[\"action\",\"animation\",\"movies-for-juniors\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"laser\",\"movies-for-juniors\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/U.png\",\"ageRestrictionName\":\"u\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[],\"specialMessage\":null,\"distributorName\":\"PARK CIRCUS FILMS\"}}}",
