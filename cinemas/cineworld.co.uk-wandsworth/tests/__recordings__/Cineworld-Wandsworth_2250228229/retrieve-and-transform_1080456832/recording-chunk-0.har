            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014756\",\"name\":\"Met Opera 2026-27: La Fanciulla del West\",\"originalName\":\"Met Opera 2026-27: La Fanciulla del West\",\"length\":195,\"posterLink\":\"https://regalcdn.azureedge.net/CW/MetOpera202627LaFanciulladelWest/HO00014756/TV_SmallPosterImage/20260604-045429466.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/MetOpera202627LaFanciulladelWest/HO00014756/TV_LargePosterImage/20260604-045251058.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/met-opera-2026-27-la-fanciulla-del-west/ho00014756\",\"weight\":0,\"releaseYear\":\"2027\",\"releaseCountry\":null,\"cast\":\"Christopher Maltman, SeokJong Baek, Vida Miknevičiūtė\",\"directors\":\"The Metropolitan Opera\",\"synopsis\":\"Puccini’s exhilarating drama of the Wild West returns in a new staging by Richard Jones, marking the company’s first new production of La Fanciulla del West in more than 30 years. Soprano Vida Miknevičiūtė makes her Met company debut singing the role of Minnie, the tough tavern owner with a heart of gold who finds love when she least expects it. Tenor SeokJong Baek is the dashing bandit who rambles into the remote California mining town to steal her heart, opposite baritone Christopher Maltman as the lawman determined to deliver justice—and win Minnie for himself. Maestro Keri-Lynn Wilson takes the podium to conduct one of opera’s most action-packed adventures, live from the Met stage to cinemas worldwide.\",\"dateStarted\":\"2027-01-23T00:00:00\",\"eventCount\":48,\"categoriesAttributes\":[],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"alternative-content\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/15.png\",\"ageRestrictionName\":\"15\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627LaFanciulladelWest/HO00014756/TV_TopShelfPosterImage/20260604-045251058.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627LaFanciulladelWest/HO00014756/TV_SmallPosterImage/20260604-045429466.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627LaFanciulladelWest/HO00014756/Mobile_MovieThumbnail/20260604-045251058.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627LaFanciulladelWest/HO00014756/TV_LargePosterImage/20260604-045251058.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627LaFanciulladelWest/HO00014756/Mobile_MovieFeed/20260604-045349122.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"TRAFALGAR RELEASING\"}}}",
