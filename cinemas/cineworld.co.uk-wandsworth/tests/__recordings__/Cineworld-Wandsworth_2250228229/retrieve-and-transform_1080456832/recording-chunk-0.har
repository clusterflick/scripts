          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014772\",\"name\":\"Met Opera 2026-27: Samson et Dalila\",\"originalName\":\"Met Opera 2026-27: Samson et Dalila\",\"length\":234,\"posterLink\":\"https://regalcdn.azureedge.net/CW/MetOpera202627SamsonetDalila/HO00014772/TV_SmallPosterImage/20260604-044927600.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/MetOpera202627SamsonetDalila/HO00014772/TV_LargePosterImage/20260604-044302419.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/met-opera-2026-27-samson-et-dalila/ho00014772\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Quinn Kelsey, Aigul Akhmetshina, Giacomo Sagripanti, Clay Hilley, Morris Robinson, Alfred Walker\",\"directors\":\"The Metropolitan Opera\",\"synopsis\":\"Saint-Saëns’s spectacular take on the biblical hero of legendary strength and the seductive Philistine whose beauty overpowers him returns in the Met’s larger-than-life production. Featuring a massive orchestra and chorus and some of opera’s most spellbinding tunes, this masterpiece is a feast for the eyes and ears. Giacomo Sagripanti conducts an electrifying cast led by the formidable star pairing of mezzo-soprano Aigul Akhmetshina and tenor Clay Hilley, broadcast live to cinemas worldwide.\",\"dateStarted\":\"2026-12-05T00:00:00\",\"eventCount\":45,\"categoriesAttributes\":[],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"alternative-content\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627SamsonetDalila/HO00014772/TV_TopShelfPosterImage/20260604-044302419.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627SamsonetDalila/HO00014772/TV_SmallPosterImage/20260604-044927600.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627SamsonetDalila/HO00014772/Mobile_MovieThumbnail/20260604-044302419.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627SamsonetDalila/HO00014772/TV_LargePosterImage/20260604-044302419.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627SamsonetDalila/HO00014772/Mobile_MovieFeed/20260604-044820833.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"TRAFALGAR RELEASING\"}}}",
