          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014770\",\"name\":\"The Met: An Anniversary Celebration\",\"originalName\":\"The Met: An Anniversary Celebration\",\"length\":210,\"posterLink\":\"https://regalcdn.azureedge.net/CW/TheMetAnAnniversaryCelebration/HO00014770/TV_SmallPosterImage/20260604-043110247.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/TheMetAnAnniversaryCelebration/HO00014770/TV_LargePosterImage/20260604-042914011.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/the-met-an-anniversary-celebration/ho00014770\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Natalie Dessay, Joyce DiDonato, Renée Fleming, Dmitri Hvorostovsky, Jonas Kaufmann, Peter Mattei, Matthew Polenzani, Sondra Radvanovsky, Lise Davidsen, Elīna Garanča, Nadine Sierra, Juan Diego Flórez\",\"directors\":\"The Metropolitan Opera\",\"synopsis\":\"Twenty Years of the Met in Cinemas is a celebration of the Met’s two decades of onstage glory as experienced in movie theaters, featuring highlights from the company’s collection of more than 185 extraordinary onscreen performances. \\nHosted by star soprano Renée Fleming, this special presentation will showcase unforgettable moments from some of opera’s greatest stars, culled from the series’ vast archive of transmissions, featuring such remarkable artists as Lise Davidsen, Natalie Dessay, Joyce DiDonato, Juan Diego Flórez, Elīna Garanča, Dmitri Hvorostovsky,  Jonas Kaufmann, Peter Mattei, Matthew Polenzani, Sondra Radvanovsky, Nadine Sierra, and, of course, Fleming herself.\",\"dateStarted\":\"2026-09-19T00:00:00\",\"eventCount\":45,\"categoriesAttributes\":[],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"alternative-content\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/TheMetAnAnniversaryCelebration/HO00014770/TV_TopShelfPosterImage/20260604-042914011.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/TheMetAnAnniversaryCelebration/HO00014770/TV_SmallPosterImage/20260604-043110247.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/TheMetAnAnniversaryCelebration/HO00014770/Mobile_MovieThumbnail/20260604-042914011.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/TheMetAnAnniversaryCelebration/HO00014770/TV_LargePosterImage/20260604-042914011.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/TheMetAnAnniversaryCelebration/HO00014770/Mobile_MovieFeed/20260604-043156709.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"TRAFALGAR RELEASING\"}}}",
