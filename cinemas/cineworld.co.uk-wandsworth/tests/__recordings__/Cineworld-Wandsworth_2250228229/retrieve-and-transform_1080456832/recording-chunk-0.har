          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014771\",\"name\":\"Met Opera 2026-27: Così fan tutte\",\"originalName\":\"Met Opera 2026-27: Così fan tutte\",\"length\":237,\"posterLink\":\"https://regalcdn.azureedge.net/CW/MetOpera202627Cosfantutte/HO00014771/TV_SmallPosterImage/20260604-044035931.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/MetOpera202627Cosfantutte/HO00014771/TV_LargePosterImage/20260604-043842638.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/met-opera-2026-27-cosi-fan-tutte/ho00014771\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Andrey Zhilikhovsky, Federica Lombardi, Nimrod David Pfeffer, Samantha Hankey, Duke Kim, Ana María Martínez\",\"directors\":\"The Metropolitan Opera\",\"synopsis\":\"The Met: Live in HD season continues with Mozart’s satirical comedy of fickle young love. Phelim McDermott’s “colorful, inventive” (The New York Times) staging, inspired by Coney Island in the 1950s, sets the uproarious story at a boardwalk amusement park, where the two pairs of lovers at the heart of the tale find themselves on one emotional—and literal—thrill ride after another. Soprano Federica Lombardi and mezzo-soprano Samantha Hankey sing Fiordiligi and Dorabella, opposite tenor Duke Kim and baritone Andrey Zhilikhovsky as Ferrando and Guglielmo. Bass-baritone Gerald Finley reprises his portrayal of the cynical Don Alfonso, with soprano Ana María Martínez as the witty maid Despina.\",\"dateStarted\":\"2026-10-03T00:00:00\",\"eventCount\":41,\"categoriesAttributes\":[],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"alternative-content\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627Cosfantutte/HO00014771/TV_TopShelfPosterImage/20260604-043842638.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627Cosfantutte/HO00014771/TV_SmallPosterImage/20260604-044035931.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627Cosfantutte/HO00014771/Mobile_MovieThumbnail/20260604-043842638.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627Cosfantutte/HO00014771/TV_LargePosterImage/20260604-043842638.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/MetOpera202627Cosfantutte/HO00014771/Mobile_MovieFeed/20260604-043957057.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"TRAFALGAR RELEASING\"}}}",
