        "response": {
          "bodySize": 5057,
          "content": {
            "mimeType": "application/json",
            "size": 5057,
            "text": "{\n  \"description\": \"Seven-time BAFTA Award-winner Steve Coogan (Alan Partridge, The Trip) plays four roles in the world premiere stage adaptation of Stanley Kubrick’s comedy masterpiece Dr. Strangelove. \\r\\n\\r\\nWhen a rogue U.S General triggers a nuclear attack, a surreal race takes place,seeing the Government and one eccentric scientist scramble to avert global destruction.\\r\\n\\r\\nThis explosively funny satire is led by a world-renowned creative team including Emmy Award-winner Armando Iannucci (The Thick of It, Veep) and Olivier Award-winner Sean Foley (The Upstart Crow, The Play What I Wrote).\\r\\n\\r\\n| Duration: 2 hours 30 minutes, Rating: TBC \\r\\n| All films will be preceded by 10-20 minutes of advertisements and trailers. \",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 250,\n  \"imageUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/e0ac1f91-3359-4970-a630-21b38957038b.jpg\",\n  \"isOnSale\": true,\n  \"name\": \"National Theatre Live: Dr Strangelove\",\n  \"instanceDates\": \"27 March-27 April\",\n  \"thumbnailUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/e0ac1f91-3359-4970-a630-21b38957038b-thumbnail.jpg\",\n  \"webEventId\": null,\n  \"id\": \"472401AHGGHJJNNQQDHDDRKKJMJDVPJGV\",\n  \"firstInstanceDateTime\": \"2025-03-27T19:00:00\",\n  \"lastInstanceDateTime\": \"2025-04-27T14:00:00\",\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"3407AVKPCVQSLVLLJHSHRNQMDJSNQJQVL\",\n      \"priceList\": {\n        \"id\": \"33601ABMMCLRHCDGJGLSCVTKRJSMDCMSS\"\n      },\n      \"event\": {\n        \"id\": \"472401AHGGHJJ