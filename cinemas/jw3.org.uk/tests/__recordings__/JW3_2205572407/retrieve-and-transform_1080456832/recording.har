        "response": {
          "bodySize": 6163,
          "content": {
            "mimeType": "application/json",
            "size": 6163,
            "text": "{\n  \"description\": \"An expansive and revelatory inside look at the 18 months John Lennon and Yoko Ono spent living in Greenwich Village in the early 1970s, One to One: John & Yoko, delivers an immersive cinematic experience that brings to life electrifying, never-before-seen material and newly restored footage of Lennon's only full-length, post-Beatles concert. With mind-blowing remastered audio overseen by their son, Sean Ono Lennon, the film is a seismic revelation that will challenge pre-existing notions of the iconic couple. | Rating: 15, Duration: 1h 40m | Films may be preceded by up to 20 minutes of advertisements and trailers. Specific timings will vary with each screening. We always recommend arriving on time. \",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 100,\n  \"imageUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/10493666-af3b-4ec7-ae57-57c27e07af5f.jpg\",\n  \"isOnSale\": true,\n  \"name\": \"One to One: John & Yoko\",\n  \"instanceDates\": \"4 May-8 May\",\n  \"thumbnailUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/10493666-af3b-4ec7-ae57-57c27e07af5f-thumbnail.jpg\",\n  \"webEventId\": null,\n  \"id\": \"506401AHJMJNVKHPRLTRRBCHPKDNCLNGD\",\n  \"firstInstanceDateTime\": \"2025-05-04T16:50:00\",\n  \"lastInstanceDateTime\": \"2025-05-08T14:00:00\",\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"3407AVKPCVQSLVLLJHSHRNQMDJSNQJQVL\",\n      \"priceList\": {\n        \"id\": \"149401ALSPNQKBLRBDJBKVKJLTNBBJLMB\"\n      },\n      \"event\": {\n        \"id\": \"506401AHJMJNVKHPRLTRRBCHPKDNCLNGD\"\n      },\n      \"s