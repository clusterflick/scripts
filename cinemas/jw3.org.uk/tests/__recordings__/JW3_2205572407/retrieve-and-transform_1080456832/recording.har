        "response": {
          "bodySize": 4258,
          "content": {
            "mimeType": "application/json",
            "size": 4258,
            "text": "{\n  \"description\": \"Margy Kinmonth’s feature documentary shines a light on the trailblazing role of women war artists, on the front lines round the world, championing the female perspective on conflict through art and asking: when it's life or death, what do women see that men don't?  Traditionally a male domain, war art by women has been largely unrecognised. Until now... \\r\\nCulture breaks the taboo, crosses borders - tells the truth to power. Artists featured include Dame Rachel Whiteread, Zhanna Kadyrova, Maggi Hambling, Assil Diab, Dame Laura Knight, Marcelle Hanselaar, Cornelia Parker, Maya Lin, Shirin Neshat and Lee Miller. An entirely female cast of contributors makes this film a unique undertaking – telling vital truths in turbulent times.  \\r\\nWar Paint – Women At War is the third instalment in Kinmonth’s trilogy of films about how artists depict war, following the acclaimed Eric Ravilious – Drawn To War and War Art with Eddie Redmayne. \\r\\n\\r\\n| Rating: 12A, Duration: 1h 29m  \\r\\n| All films will be preceded by 10-20 minutes of advertisements and trailers. \",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 89,\n  \"imageUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/6ab63387-f7e9-4ceb-854a-ffc81e6d72f1.jpg\",\n  \"isOnSale\": true,\n  \"name\": \"War Paint: Women at War\",\n  \"instanceDates\": \"15 April-16 April\",\n  \"thumbnailUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/6ab63387-f7e9-4ceb-854a-ffc81e6d72f1-thumbnail.jpg\",\n  \"webEventId\": null,\n  \"id\": \"500801ANDBLLHNBRTTKKLBNJHNJQRMNBG\",\n  \"firstInstanceDateTime\": \"2025-04-15T14:00:00\",\n  \"lastInstanceDateTime\": \"2025-04-16T11:00:00\",\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"3407AVKPCVQSLVLLJHSHRNQMDJSNQJQVL\",\n      \"priceList\": {\n        \"id\": \"148802AKTKTJGVTJVDRDBTJLHNRDTSPJP\"\n      },\n      \"event\": {\n        \"id\": \"500801ANDBLLHNBRTTKKLBNJHNJQRMNBG\"\n      },\n      \"start\": \"2025-04-15T14:00:00\",\n      \"startUtc\": \"2025-04-15T13:00:00\",\n      \"startSellingAtWeb\": \"2025-03-19T12:12:00\",\n      \"startSellingAtWebUtc\": \"2025-03-19T12:12:00Z\",\n      \"stopSellingAtWeb\": \"2025-04-15T14:00:00\",\n      \"stopSellingAtWebUtc\": \"2025-04-15T13:00:00Z\",\n      \"webInstanceId\": null,\n      \"cancelled\": false,\n      \"id\": \"875203ATBJJTLLVDKKMRQJVSVNHGMMJBD\",\n      \"hasBestAvailableOverlay\": false,\n      \"attribute_ASSupplementaryEvent\": false,\n      \"attribute_CallBoxOfficeToBook\": \"\",\n      \"attribute_SLFreeText\": \"\",\n      \"attribute_SLCaptioned\": false,\n      \"availability\": {\n        \"name\": \"JW3 Cinema\",\n        \"available\": 55,\n        \"wheelchairAvailable\": 0,\n        \"specialAvailable\": 0,\n        \"capacity\": 62,\n        \"inBasket\": 0,\n        \"unavailable\": 7,\n        \"lockInfoAvailable\": null,\n        \"lockInfoSpecialAvailable\": null\n      }\n    },\n    {\n      \"isOnSale\": true,\n      \"planId\": \"3407AVKPCVQSLVLLJHSHRNQMDJSNQJQVL\",\n      \"priceList\": {\n        \"id\": \"148802AKTKTJGVTJVDRDBTJLHNRDTSPJP\"\n      },\n      \"event\": {\n        \"id\": \"500801ANDBLLHNBRTTKKLBNJHNJQRMNBG\"\n      },\n      \"start\": \"2025-04-16T11:00:00\",\n      \"startUtc\": \"2025-04-16T10:00:00\",\n      \"startSellingAtWeb\": \"2025-03-19T12:12:00\",\n      \"startSellingAtWebUtc\": \"2025-03-19T12:12:00Z\",\n      \"stopSellingAtWeb\": \"2025-04-16T11:00:00\",\n      \"stopSellingAtWebUtc\": \"2025-04-16T10:00:00Z\",\n      \"webInstanceId\": null,\n      \"cancelled\": false,\n   