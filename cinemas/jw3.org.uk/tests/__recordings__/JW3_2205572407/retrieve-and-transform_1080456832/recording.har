          "content": {
            "mimeType": "application/json",
            "size": 3841,
            "text": "{\n  \"description\": \"Mr. Burton tells the true story of the relationship between Port Talbot schoolmaster Philip Burton and a wild young schoolboy called Richard Jenkins, the son of a wayward drunk. Richard dreamed of becoming an actor, but his ambitions were in danger of being derailed by a combination of family trouble, the pressure of war, and his own lack of discipline. Mr. Burton recognized the raw talent in his pupil, becoming his tutor, strict taskmaster and eventually his adoptive father. | Rating: 12A, Duration: 2h 4m | Films may be preceded by up to 20 minutes of advertisements and trailers. Specific timings will vary with each screening. We always recommend arriving on time. \",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 124,\n  \"imageUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/dc95501c-7948-4d87-b4f5-bdae6652a6bc.jpg\",\n  \"isOnSale\": true,\n  \"name\": \"Mr Burton\",\n  \"instanceDates\": \"21 May-22 May\",\n  \"thumbnailUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/dc95501c-7948-4d87-b4f5-bdae6652a6bc-thumbnail.jpg\",\n  \"webEventId\": null,\n  \"id\": \"506202ARNPTCKDHKJLSJDVBQQMSSCLTJD\",\n  \"firstInstanceDateTime\": \"2025-05-21T14:00:00\",\n  \"lastInstanceDateTime\": \"2025-05-22T16:40:00\",\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"3407AVKPCVQSLVLLJHSHRNQMDJSNQJQVL\",\n      \"priceList\": {\n        \"id\": \"148802AKTKTJGVTJVDRDBTJLHNRDTSPJP\"\n      },\n      \"event\": {\n        \"id\": \"506202ARNPTCKDHKJLSJDVBQQMSSCLTJD\"\n      },\n      \"start\": \"2025-05-21T14:00:00\",\n      \"star