ck-mainpagecontent\" class=\"m-block m-block--system m-block--system-main-block m-block__ m-\">\n\t\t\t\t\t\n\n<article  role=\"article\" about=\"/whats-on/art-waiting-qa\" class=\"o-node o-event o-full\">\n\n\t\n\t\t\n\t\t\t\t\t<div class=\"m-banner m-banner--event\" role=\"banner\">\n\n\t\t<div class=\"m-banner__copy\">\n\t\t\t<div class=\"grid\">\n\t\t\t\t<div class=\"col-sm-12\">\n\t\t\t\t\t  <nav class=\"a-breadcrumb\" role=\"navigation\" aria-labelledby=\"system-breadcrumb\">\n    <h2 id=\"system-breadcrumb\" class=\"visually-hidden\">Breadcrumb</h2>\n    <ol>\n          <li>\n                  <a href=\"/\">Home</a>\n              </li>\n          <li>\n                  <a href=\"/whats-on\">What&#039;s On</a>\n              </li>\n          <li> The Art of Waiting + Q&amp;A</li>\n    </ol>\n  </nav>\n\t\t\t\t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"grid align-end\">\n\t\t\t\t<div class=\"col-sm-8 col-lg-6 offset-lg-1\">\n\n                      Seret Film Festival 2025\n          \n\t\t\t\t\t\t\t\t\t\t\t<h1>\n\t\t\t\t\t\t\tThe Art of Waiting + Q&amp;A\n\t\t\t\t\t\t</h1>\n\t\t\t\t\t\n                      בשורות טובות\n          \n\t\t\t\t\t<div class=\"o-event__details\">\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span>90 minutes</span>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"o-event__details o-event__details-bold\">\n\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span>Fri 09 May 2025</span><span>11:00am</span>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span>£16</span>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\n\t\t\t\t</div>\n        <div class=\"col-sm-4 col-lg-3 offset-lg-1 m-banner__links\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://purchase.jw3.org.uk/ChooseSeats/879001\" class=\"a-btn\">Book Now</a>\n\t\t\t\t\t\t\t\t\t\t\t          <aside class=\"a-wishlist\"><span class=\"a-wishlist__msg\"></span><button class=\"a-wishlist__button\" title=\"Add to wishlist\" data-target=\"4430\">Add to wishlist</button></aside>\n        </div>\n\t\t\t</div>\n\t\t</div>\n\t\t\n\t\t<figure class=\"m-banner__image a-image a-image--full\">\n\t\t\t\n\n<picture>\n\t\t<source media=\"(max-width: 600px)\" srcset=\"/sites/default/files/styles/banner_image_sm/public/images/The%20Art%20of%20Waiting_0.jpg?itok=tZYueATA\" type=\"image/jpeg\">\n\t\t<source media=\"(max-width: 1000px)\" data-srcset=\"/sites/default/files/styles/banner_image_md/public/images/The%20Art%20of%20Waiting_0.jpg?itok=CF76D-3M\" type=\"image/jpeg\">\n\t\t<source data-srcset=\"/sites/default/files/styles/banner_image/public/images/The%20Art%20of%20Waiting_0.jpg?itok=3p99pqUq\" type=\"image/jpeg\">\n\t<img data-src=\"\" alt=\"The Art of Waiting + Q&amp;A\" class=\"lazy lazy-animate\" />\n</picture>\n\t\t\t\t\t</figure>\n\n\t</div>\n\n\n<div class=\"m-sticky-header\">\n\t<div class=\"grid justify-center\">\n\t\t<div class=\"col-sm-12 col-lg-10\">\n\t\t\t<div class=\"m-sticky-header__inner\">\n\t\t\t\t<aside>\n\t\t\t\t\t<h2>The Art of Waiting + Q&amp;A</h2>\n\n\t\t\t\t\t<div class=\"o-event__details o-event__details-bold\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span><time datetime=\"2025-05-09T10:00:00Z\" class=\"datetime\">9 May 2025</time>\n</span>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span>£16</span>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</aside>\n\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://purchase.jw3.org.uk/ChooseSeats/879001\" class=\"a-btn\">Book Now</a>\n\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t</div>\n\t</div>\n</div>\n<div class=\"grid\">\n\t<div class=\"col-sm-8 col-md-8 col-lg-6 order-1 order-sm-0 offset-lg-1\">\n\n\t\t\n\t\t\t\t\t<div class=\"m-entity m-entity__body\">\n\t\t\t\t<p>Join us for a special retrospective honoring Director Erez Tadmor, featuring the powerful film The Art of Waiting. Follow Liran and Tali, a couple in their thirties with hopes of starting a family.</p>\n<p>What begins as a straightforward dream quickly evolves into a journey filled with unexpected challenges when they are faced with the reality of fertility treatments. An intimate and thought-provoking story that beautifully explores the complexities of love, hope, and the path to parenthood.</p>\n<p>Followed by a Q&amp;A with director Erez Tadmor, and stars Roy Assaf and Nelly Tagar. </p>\n\n\t\t\t</div>\n\t\t\n\t\t\t\t\t\n<section class=\"m-entity m-entity__video\">\n\n  \n    <h3 class=\"a-title\">The Art of Waiting<span>&#x25A0;</span></h3>\n\n  \n  <div class=\"video-embed-field-provider-youtube video-embed-field-responsive-video\"><iframe width=\"854\" height=\"480\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\" src=\"https://www.youtube.com/embed/y9iAZkSwdtQ?autoplay=0&amp;start=0&amp;rel=0\"></iframe>\n</div>\n\n\n  \n\n\n</section>\n\n<section class=\"m-entity m-entity__accordion\">\n\n  \n  \n  <div class=\"js-accordion\">\n    <p class=\"js-accordion__header h3\">Credits</p>\n<div class=\"js-accordion__panel\">\n\t<p><strong>Director:</strong> Erez Tadmor<br />\n<strong>Writers: </strong>Roy Assaf, Erez Tadmor<br />\n<strong>Producers: </strong>Aviv Ben Shlush, Tsachi Cohen, Yaki Reisner, Shemi Shoenfeld, Moshe Edery, Leon Edery<br />\n<strong>Stars:</strong> Roy Assaf, Nelly Tagar</p>\n\n</div>\n\n  </div>\n\n\n</section>\n\n\t\t\n\t\t\t</div>\n\n\t<div class=\"col-sm-4 col-lg-3 order-0 order-sm-1 offset-lg-1 col-bleed\">\n\t\t\t\t\t  <div class=\"o-sidebar o-sidebar--event o-sidebar--dark m-entity a-focus\">\n    <h3>Please note</h3>\n    <p>This film is in Hebrew with English subtitles. </p>\n<p>A booking fee of £2 and a security levy of £1.50 will be added to all orders. More information can be found <em><a href=\"https://www.jw3.org.uk/booking-and-security-fees\" id=\"menur60q\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://www.jw3.org.uk/booking-and-security-fees\">here</a></em>. </p>\n\n  </div>\n\n<div class=\"o-sidebar o-sidebar--event m-entity\">\n  \n  \n      <strong>Date - Fri 09 May 2025 11:00am</strong>\n  \n  \n  <hr>\n\n      <h3>£16</h3>\n  \n      \n<div class=\"m-block m-block--block-content m-block--block-content95ac2687-564b-43db-8f9d-049edbcc2e7a m-block__default-booking-information m-default-booking-information\">\n\t\t\t\t<div class=\"m-booking-info\">\n  \n  </div>\n\t</div>\n\n  </div>\n\n  <div class=\"o-sidebar o-sidebar--event o-sidebar--highlight\">\n    \n<div class=\"m-block m-block--block-content m-block--block-contenta8df1267-4caa-41b6-842f-0230abfeeb5b m-block__friends-promo m-friends-promo\">\n\t\t\t\t<p>Become a JW3 Friend and save up to 10% on events!</p>\n<p><a href=\"/memberships\" title=\"Membership\">Join now</a></p>\n\n\t</div>\n\n  </div>\n\n  <div class=\"o-sidebar o-sidebar--event m-entity\">\n\n      <div class=\"o-sidebar__festival\">\n      <h3 class=\"h5\">Part of:</h3>\n      <div class=\"views-element-container\"><div class=\"view__festival_link m-entity m-entity__view\">\n  \n  \n  \n\n  \n  \n  \n\n    <div class=\"views-field views-field-title\"><span class=\"field-content\"><a href=\"/seret\" hreflang=\"en\">Seret Film Festival</a></span></div>\n\n  \n  \n\n  \n  \n\n  \n  \n</div>\n</div>\n\n    </div>\n  \n      <h3 class=\"h5\">Type:</h3>\n      <a href=\"/whats-on?date=&genre[3]=3&type=All\" class=\"a-tag a-tag--cinema\"><svg width=\"39\" height=\"38\" viewBox=\"0 0 39 38\" xmlns=\"http://www.w3.org/2000/svg\"><g fill=\"none\" fill-rule=\"evenodd\"><path fill=\"#EE7203\" d=\"M0 0h39v38H0z\"/><ellipse fill=\"#FFF\" cx=\"19.5\" cy=\"19.358\" rx=\"10.111\" ry=\"10.038\"/></g></svg>Cinema</a>\n\n    </div>\n\t\t\t</div>\n\n</div>\n\n\n\n\n\n\t\t\n\t  \n\n</article>\n\t</div>\n\n\n  </main>\n\n<footer class=\"o-footer\" role=\"contentinfo\">\n  <section class=\"o-footer__top\">\n    <div class=\"grid\">\n      <div class=\"col-sm-12\">\n\n        <div class=\"o-footer__top-inner\">\n          \n<div class=\"m-block m-block--block-content m-block--block-contentb99bc602-5791-4ff9-a92d-61be3be0bc59 m-block__footer---box-office m-footer---box-office\">\n\t\t\t\t<h3>Box Office</h3>\n<p>(020) 7433 8988</p>\n<p>341-351 Finchley Road, London, NW3 6ET</p>\n<p>JW3 - Helping to create a vibrant, diverse and proud community, inspired by and engaged in Jewish arts, culture and community</p>\n\n\t</div>\n\n          \n<div class=\"m-block m-block--block-content m-block--block-contentb1e46c97-db06-4c67-a5c1-b97f638629b4 m-block__footer---friends m-footer---friends\">\n\t\t\t\t<h4>JW3 Friends Get More</h4>\n<ul>\n<li>Save 10% on events, activities, classes &amp; courses</li>\n<li>Get a 10% discount at the Café</li>\n<li>Advance booking on selected events</li>\n</ul>\n<p><strong><a href=\"/memberships\" title=\"Membership\">JOIN NOW</a></strong></p>\n\n\t</div>\n\n          \n<div class=\"m-block m-block--block-content m-block--block-content8d66a62c-9384-439f-bfbd-7f9314d82294 m-block__bottom-right-block m-bottom-right-block\">\n\t\t\t\t<h3>Café @ JW3</h3>\n<p>Our in-house coffee shop is located in the bottom floor of JW3's building, next to the Piazza. It's the perfect spot to enjoy a hot or cold drink, savoury snacks and morish sweet treats &amp; pastries. </p>\n<p><strong>Open Sunday to Thursday from 10am</strong></p>\n<p> </p>\n\n\t</div>\n\n        </div>\n\n      </div>\n    </div>\n  </section>\n  <div class=\"grid\">\n    <div class=\"col-sm-12\">\n\n      <div class=\"m-footer-row m-footer-row--top\">\n        \n              <ul class=\"menu\">\n                    <li class=\"menu-item\">\n        <a href=\"/about-us\" data-drupal-link-system-path=\"node/338\">About us</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"https://www.venuehire.jw3.org.uk/\">Venue Hire</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"https://www.jw3.org.uk/jw3-tv\">JW3-TV</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"/your-visit/getting-us\" data-drupal-link-system-path=\"node