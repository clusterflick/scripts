        "response": {
          "bodySize": 7262,
          "content": {
            "mimeType": "application/json",
            "size": 7262,
            "text": "{\n  \"description\": \"Thibaut is an internationally renowned conductor who travels the world. When he learns he was adopted, he discovers the existence of a younger brother, Jimmy, who works in a school cafeteria and plays the trombone in a small marching band. Everything seems to set them apart, except their love of music. Sensing his brother's exceptional talent, Thibaut decides to remedy the injustice of fate. Jimmy begins to dream of a different life. | Film is in French with English subtitles | Rating 15, Duration: 1h 43m | Films may be preceded by up to 20 minutes of advertisements and trailers. Specific timings will vary with each screening. We always recommend arriving on time. \",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 103,\n  \"imageUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/0535c658-1ae6-4f64-a378-302949ecd184.jpg\",\n  \"isOnSale\": true,\n  \"name\": \"The Marching Band\",\n  \"instanceDates\": \"25 May-29 May\",\n  \"thumbnailUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/0535c658-1ae6-4f64-a378-302949ecd184-thumbnail.jpg\",\n  \"webEventId\": null,\n  \"id\": \"507202AQVTQPLNJPPGRGBRGNGKPKBJMQV\",\n  \"firstInstanceDateTime\": \"2025-05-25T16:15:00\",\n  \"lastInstanceDateTime\": \"2025-05-29T15:30:00\",\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"3407AVKPCVQSLVLLJHSHRNQMDJSNQJQVL\",\n      \"priceList\": {\n        \"id\": \"148802AKTKTJGVTJVDRDBTJLHNRDTSPJP\"\n      },\n      \"event\": {\n        \"id\": \"507202AQVTQPLNJPPGRGBRGNGKPKBJMQV\"\n      },\n      \"start\": \"2025-05-25T16:15:00\",\n     