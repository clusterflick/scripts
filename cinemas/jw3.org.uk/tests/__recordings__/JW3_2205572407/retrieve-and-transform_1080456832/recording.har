            "mimeType": "application/json",
            "size": 3570,
            "text": "{\n  \"description\": \"From the Academy Award-winner Bong Joon Ho, comes his next groundbreaking cinematic experience. The unlikely hero, Mickey Barnes has found himself in the extraordinary circumstance of working for an employer who demands the ultimate commitment to the job… to die, for a living. \\r\\n\\r\\n| Rating: 15, Duration: 2h 17m \\r\\n| All films will be preceded by 10-20 minutes of advertisements and trailers.\",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 137,\n  \"imageUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/c9696c1b-750f-49e5-81f1-60951dfb56a1.jpg\",\n  \"isOnSale\": true,\n  \"name\": \"Mickey 17\",\n  \"instanceDates\": \"6 April-10 April\",\n  \"thumbnailUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/c9696c1b-750f-49e5-81f1-60951dfb56a1-thumbnail.jpg\",\n  \"webEventId\": null,\n  \"id\": \"500601ABPSQLDCTCJGCCKMPBNBNBGJGPL\",\n  \"firstInstanceDateTime\": \"2025-04-06T19:50:00\",\n  \"lastInstanceDateTime\": \"2025-04-10T11:00:00\",\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"3407AVKPCVQSLVLLJHSHRNQMDJSNQJQVL\",\n      \"priceList\": {\n        \"id\": \"149401ALSPNQKBLRBDJBKVKJLTNBBJLMB\"\n      },\n      \"event\": {\n        \"id\": \"500601ABPSQLDCTCJGCCKMPBNBNBGJGPL\"\n      },\n      \"start\": \"2025-04-09T18:30:00\",\n      \"startUtc\": \"2025-04-09T17:30:00\",\n      \"startSellingAtWeb\": \"2025-03-19T12:06:00\",\n      \"startSellingAtWebUtc\": \"2025-03-19T12:06:00Z\",\n      \"stopSellingAtWeb\": \"2025-04-09T18:30:00\",\n      \"stopSellingAtWebUtc\": \"2025-04-09T17:30:00Z\",\n      \