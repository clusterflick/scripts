        "response": {
          "bodySize": 2971,
          "content": {
            "mimeType": "application/json",
            "size": 2971,
            "text": "{\n  \"description\": \"La Cocina captures the frenetic energy of the lunch rush at The Grill, a bustling restaurant in Manhattan's Times Square. When money goes missing from the till, suspicion falls on Pedro, an undocumented cook who dreams of a better life and is in love with Julia, an American waitress who cannot commit to a relationship. Rashid, the restaurant owner, has promised to help Pedro obtain legal status, but a shocking revelation about Julia compels Pedro to spiral into an act that threatens to shut down one of the city's busiest kitchens once and for all. The film is a comic and tragic tribute to the invisible people who keep our restaurants running and our stomachs full, all while chasing an elusive version of the American dream. \\r\\n\\r\\n| Rating: 15, Duration: 2h 19m\\r\\n| Films may be preceded by up to 20 minutes of advertisements and trailers. Specific timings will vary with each screening. We always recommend arriving on time. \",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 139,\n  \"imageUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/1543e7fb-0289-4b2e-9243-47f7caf0b51f.jpg\",\n  \"isOnSale\": true,\n  \"name\": \"La Cocina\",\n  \"instanceDates\": \"22 April-24 April\",\n  \"thumbnailUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/1543e7fb-0289-4b2e-9243-47f7caf0b51f-thumbnail.jpg\",\n  \"webEventId\": null,\n  \"id\": \"499201AVCKTTNTDMGTKJTPVMPCRDQVKVP\",\n  \"firstInstanceDateTime\": \"2025-04-22T18:50:00\",\n  \"lastInstanceDateTime\": \"2025-04-24T15:50:00\",\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId