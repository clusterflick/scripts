den\">\n  <a id=\"main-content\" tabindex=\"-1\"></a>\n</div>\n\n<main role=\"main\" class=\"wrapper wapper--main\">\n        <div data-drupal-messages-fallback class=\"hidden\"></div>\n<div id=\"block-mainpagecontent\" class=\"m-block m-block--system m-block--system-main-block m-block__ m-\">\n\t\t\t\t\t\n\n<article  role=\"article\" about=\"/whats-on/escape-extinction-rewilding\" class=\"o-node o-event o-full\">\n\n\t\n\t\t\n\t\t\t\t\t<div class=\"m-banner m-banner--event\" role=\"banner\">\n\n\t\t<div class=\"m-banner__copy\">\n\t\t\t<div class=\"grid\">\n\t\t\t\t<div class=\"col-sm-12\">\n\t\t\t\t\t  <nav class=\"a-breadcrumb\" role=\"navigation\" aria-labelledby=\"system-breadcrumb\">\n    <h2 id=\"system-breadcrumb\" class=\"visually-hidden\">Breadcrumb</h2>\n    <ol>\n          <li>\n                  <a href=\"/\">Home</a>\n              </li>\n          <li>\n                  <a href=\"/whats-on\">What&#039;s On</a>\n              </li>\n          <li> Escape from Extinction: Rewilding</li>\n    </ol>\n  </nav>\n\t\t\t\t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"grid align-end\">\n\t\t\t\t<div class=\"col-sm-8 col-lg-6 offset-lg-1\">\n\n          \n\t\t\t\t\t\t\t\t\t\t\t<h1>\n\t\t\t\t\t\t\tEscape from Extinction: Rewilding\n\t\t\t\t\t\t</h1>\n\t\t\t\t\t\n          \n\t\t\t\t\t<div class=\"o-event__details\">\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span>90 minutes</span>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span>12</span>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"o-event__details o-event__details-bold\">\n\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span><time datetime=\"2025-05-14T10:30:00Z\" class=\"datetime\">14 May 2025</time>\n - <time datetime=\"2025-05-15T12:15:00Z\" class=\"datetime\">15 May 2025</time>\n</span>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span>£9 / £15</span>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\n\t\t\t\t</div>\n        <div class=\"col-sm-4 col-lg-3 offset-lg-1 m-banner__links\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"/performances_modal/4457\" class=\"use-ajax a-btn\" data-dialog-type=\"modal\" data-dialog-options=\"{&quot;height&quot;:&quot;70%&quot;,&quot;width&quot;:&quot;80%&quot;}\">Book Now</a>\n\t\t\t\t\t\t\t\t\t\t\t          <aside class=\"a-wishlist\"><span class=\"a-wishlist__msg\"></span><button class=\"a-wishlist__button\" title=\"Add to wishlist\" data-target=\"4457\">Add to wishlist</button></aside>\n        </div>\n\t\t\t</div>\n\t\t</div>\n\t\t\n\t\t<figure class=\"m-banner__image a-image a-image--full\">\n\t\t\t\n\n<picture>\n\t\t<source media=\"(max-width: 600px)\" srcset=\"/sites/default/files/styles/banner_image_sm/public/images/Escape%20from%20Extinction.jpg?itok=sZCMzYA2\" type=\"image/jpeg\">\n\t\t<source media=\"(max-width: 1000px)\" data-srcset=\"/sites/default/files/styles/banner_image_md/public/images/Escape%20from%20Extinction.jpg?itok=48zBKYR6\" type=\"image/jpeg\">\n\t\t<source data-srcset=\"/sites/default/files/styles/banner_image/public/images/Escape%20from%20Extinction.jpg?itok=4m_FdOLm\" type=\"image/jpeg\">\n\t<img data-src=\"\" alt=\"Escape from Extinction: Rewilding\" class=\"lazy lazy-animate\" />\n</picture>\n\t\t\t\t\t</figure>\n\n\t</div>\n\n\n<div class=\"m-sticky-header\">\n\t<div class=\"grid justify-center\">\n\t\t<div class=\"col-sm-12 col-lg-10\">\n\t\t\t<div class=\"m-sticky-header__inner\">\n\t\t\t\t<aside>\n\t\t\t\t\t<h2>Escape from Extinction: Rewilding</h2>\n\n\t\t\t\t\t<div class=\"o-event__details o-event__details-bold\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span><time datetime=\"2025-05-14T10:30:00Z\" class=\"datetime\">14 May 2025</time>\n - <time datetime=\"2025-05-15T12:15:00Z\" class=\"datetime\">15 May 2025</time>\n</span>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span>£9 / £15</span>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</aside>\n\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"/performances_modal/4457\" class=\"use-ajax a-btn\" data-dialog-type=\"modal\" data-dialog-options=\"{&quot;height&quot;:&quot;70%&quot;,&quot;width&quot;:&quot;80%&quot;}\">Book Now</a>\n\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t</div>\n\t</div>\n</div>\n<div class=\"grid\">\n\t<div class=\"col-sm-8 col-md-8 col-lg-6 order-1 order-sm-0 offset-lg-1\">\n\n\t\t\n\t\t\t\t\t<div class=\"m-entity m-entity__body\">\n\t\t\t\t<p>The sequel to American Humane's award-winning documentary, Escape from Extinction, introduces rewilding - a proven method for sustainable conservation that has the potential to bring back hundreds of thousands of species from the brink of extinction.</p>\n<p>Narrated by Academy Award winner Meryl Streep, the film follows tireless conservation efforts of leading organizations implementing rewilding practices across a diverse array of species in equally diverse environments.</p>\n\n\t\t\t</div>\n\t\t\n\t\t\t\t\t\n<section class=\"m-entity m-entity__video\">\n\n  \n    <h3 class=\"a-title\">Escape from Extinction: Rewilding<span>&#x25A0;</span></h3>\n\n  \n  <div class=\"video-embed-field-provider-youtube video-embed-field-responsive-video\"><iframe width=\"854\" height=\"480\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\" src=\"https://www.youtube.com/embed/cb7iVXzGics?autoplay=0&amp;start=0&amp;rel=0\"></iframe>\n</div>\n\n\n  \n\n\n</section>\n\n<section class=\"m-entity m-entity__accordion\">\n\n  \n  \n  <div class=\"js-accordion\">\n    <p class=\"js-accordion__header h3\">Credits</p>\n<div class=\"js-accordion__panel\">\n\t<p><strong>Genre:</strong> Documentary  <br />\n<strong>Rating: </strong>12 <br />\n<strong>Director:</strong> Matthew R. Brady  <br />\n<strong>Stars: </strong>Meryl Streep (Narration)  </p>\n\n</div>\n\n  </div>\n\n\n</section>\n\n\t\t\n\t\t\t</div>\n\n\t<div class=\"col-sm-4 col-lg-3 order-0 order-sm-1 offset-lg-1 col-bleed\">\n\t\t\t\t\t  <div class=\"o-sidebar o-sidebar--event o-sidebar--dark m-entity a-focus\">\n    <h3>Please note</h3>\n    <p>A booking fee of £2 and a security levy of £1.50 will be added to all orders. More information can be found <em><a href=\"https://www.jw3.org.uk/booking-and-security-fees\" id=\"menur60q\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://www.jw3.org.uk/booking-and-security-fees\">here</a></em>. </p>\n\n  </div>\n\n<div class=\"o-sidebar o-sidebar--event m-entity\">\n      <strong>Age - 12</strong>\n  \n  \n      <strong>Dates - <time datetime=\"2025-05-14T10:30:00Z\" class=\"datetime\">14 May 2025</time>\n - <time datetime=\"2025-05-15T12:15:00Z\" class=\"datetime\">15 May 2025</time>\n</strong>\n  \n  \n  <hr>\n\n      <h3>£9 / £15</h3>\n  \n      \n<div class=\"m-block m-block--block-content m-block--block-content95ac2687-564b-43db-8f9d-049edbcc2e7a m-block__default-booking-information m-default-booking-information\">\n\t\t\t\t<div class=\"m-booking-info\">\n  \n  </div>\n\t</div>\n\n  </div>\n\n  <div class=\"o-sidebar o-sidebar--event o-sidebar--highlight\">\n    \n<div class=\"m-block m-block--block-content m-block--block-contenta8df1267-4caa-41b6-842f-0230abfeeb5b m-block__friends-promo m-friends-promo\">\n\t\t\t\t<p>Become a JW3 Friend and save up to 10% on events!</p>\n<p><a href=\"/memberships\" title=\"Membership\">Join now</a></p>\n\n\t</div>\n\n  </div>\n\n  <div class=\"o-sidebar o-sidebar--event m-entity\">\n\n  \n      <h3 class=\"h5\">Type:</h3>\n      <a href=\"/whats-on?date=&genre[3]=3&type=All\" class=\"a-tag a-tag--cinema\"><svg width=\"39\" height=\"38\" viewBox=\"0 0 39 38\" xmlns=\"http://www.w3.org/2000/svg\"><g fill=\"none\" fill-rule=\"evenodd\"><path fill=\"#EE7203\" d=\"M0 0h39v38H0z\"/><ellipse fill=\"#FFF\" cx=\"19.5\" cy=\"19.358\" rx=\"10.111\" ry=\"10.038\"/></g></svg>Cinema</a>\n\n    </div>\n\t\t\t</div>\n\n</div>\n\n\n\n\n\n\t\t\n\t  \n\n</article>\n\t</div>\n\n\n  </main>\n\n<footer class=\"o-footer\" role=\"contentinfo\">\n  <section class=\"o-footer__top\">\n    <div class=\"grid\">\n      <div class=\"col-sm-12\">\n\n        <div class=\"o-foo