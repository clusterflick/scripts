        "response": {
          "bodySize": 5162,
          "content": {
            "mimeType": "application/json",
            "size": 5162,
            "text": "{\n  \"description\": \"La Cocina captures the frenetic energy of the lunch rush at The Grill, a bustling restaurant in Manhattan's Times Square. When money goes missing from the till, suspicion falls on Pedro, an undocumented cook who dreams of a better life and is in love with Julia, an American waitress who cannot commit to a relationship. Rashid, the restaurant owner, has promised to help Pedro obtain legal status, but a shocking revelation about Julia compels Pedro to spiral into an act that threatens to shut down one of the city's busiest kitchens once and for all. The film is a comic and tragic tribute to the invisible people who keep our restaurants running and our stomachs full, all while chasing an elusive version of the American dream. \\r\\n\\r\\n| Rating: 15, Duration: 2h 19m\\r\\n| All films will be preceded by 10-20 minutes of advertisements and trailers. \",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 139,\n  \"imageUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/1543e7fb-0289-4b2e-9243-47f7caf0b51f.jpg\",\n  \"isOnSale\": true,\n  \"name\": \"La Cocina\",\n  \"instanceDates\": \"22 April-24 April\",\n  \"thumbnailUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/1543e7fb-0289-4b2e-9243-47f7caf0b51f-thumbnail.jpg\",\n  \"webEventId\": null,\n  \"id\": \"499201AVCKTTNTDMGTKJTPVMPCRDQVKVP\",\n  \"firstInstanceDateTime\": \"2025-04-22T18:50:00\",\n  \"lastInstanceDateTime\": \"2025-04-24T15:50:00\",\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"3407AVKPCVQSLVLLJHSHRNQMDJSNQJQVL\",\n      \"priceList\": {\n        \"id\": \"149401ALSPNQKBLRBDJBKVKJLTNBBJLMB\"\n      },\n      \"event\": {\n        \"id\": \"499201AVCKTTNTDMGTKJTPVMPCRDQVKVP\"\n      },\n      \"start\": \"2025-04-22T18:50:00\",\n      \"startUtc\": \"2025-04-22T17:50:00\",\n      \"startSellingAtWeb\": \"2025-03-19T09:49:00\",\n      \"startSellingAtWebUtc\": \"2025-03-19T09:49:00Z\",\n      \"stopSellingAtWeb\": \"2025-04-22T18:50:00\",\n      \"stopSellingAtWebUtc\": \"2025-04-22T17:50:00Z\",\n      \"webInstanceId\": null,\n      \"cancelled\": false,\n      \"id\": \"874602APRJSLGSMLGLHCBRMMBQGLLGCBT\",\n      \"hasBestAvailableOverlay\": false,\n      \"attribute_ASSupplementaryEvent\": false,\n      \"attribute_CallBoxOfficeToBook\": \"\",\n      \"attribute_SLFreeText\": \"\",\n      \"attribute_SLCaptioned\": false,\n      \"availability\": {\n        \"name\": \"JW3 Cinema\",\n        \"available\": 57,\n        \"wheelchairAvailable\": 0,\n        \"specialAvailable\": 0,\n        \"capacity\": 62,\n        \"inBasket\": 0,\n        \"unavailable\": 5,\n        \"lockInfoAvailable\": null,\n        \"lockInfoSpecialAvailable\": null\n      }\n    },\n    {\n      \"isOnSale\": true,\n      \"planId\": \"3407AVKPCVQSLVLLJHSHRNQMDJSNQJQVL\",\n      \"priceList\": {\n        \"id\": \"149401ALSPNQKBLRBDJBKVKJLTNBBJLMB\"\n      },\n      \"event\": {\n        \"id\": \"499201AVCKTTNTDMGTKJTPVMPCRDQVKVP\"\n      },\n      \"start\": \"2025-04-23T18:50:00\",\n      \"startUtc\": \"2025-04-23T17:50:00\",\n      \"startSellingAtWeb\": \"2025-03-19T09:49:00\",\n      \"startSellingAtWebUtc\": \"2025-03-19T09:49:00Z\",\n      \"stopSellingAtWeb\": \"2025-04-23T18:50:00\",\n      \"stopSellingAtWebUtc\": \"2025-04-23T17:50:00Z\",\n      \"webInstanceId\": null,\n      \"cancelled\": false,\n      \"id\": \"874603AKKBBHVKDLMTBVPHVVMGSDVCKLP\",\n      \"hasBestAvailableOverlay\": false,\n      \"attribute_ASSupplementaryEvent\": false,\n      \"attribute_CallBoxOfficeToBook\": \"\",\n      \"attribute_SLFreeText\": \"\"