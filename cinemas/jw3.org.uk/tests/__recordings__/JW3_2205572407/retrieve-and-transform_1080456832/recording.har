        "response": {
          "bodySize": 2864,
          "content": {
            "mimeType": "application/json",
            "size": 2864,
            "text": "{\n  \"description\": \"Seven-time BAFTA Award-winner Steve Coogan (Alan Partridge, The Trip) plays four roles in the world premiere stage adaptation of Stanley Kubrick’s comedy masterpiece Dr. Strangelove. \\r\\n\\r\\nWhen a rogue U.S General triggers a nuclear attack, a surreal race takes place,seeing the Government and one eccentric scientist scramble to avert global destruction.\\r\\n\\r\\nThis explosively funny satire is led by a world-renowned creative team including Emmy Award-winner Armando Iannucci (The Thick of It, Veep) and Olivier Award-winner Sean Foley (The Upstart Crow, The Play What I Wrote).\\r\\n\\r\\n| Duration: 2 hours 30 minutes, Rating: TBC \\r\\n| Films may be preceded by up to 20 minutes of advertisements and trailers. Specific timings will vary with each screening. We always recommend arriving on time. \",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 250,\n  \"imageUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/e0ac1f91-3359-4970-a630-21b38957038b.jpg\",\n  \"isOnSale\": true,\n  \"name\": \"National Theatre Live: Dr Strangelove\",\n  \"instanceDates\": \"27 March-27 April\",\n  \"thumbnailUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/e0ac1f91-3359-4970-a630-21b38957038b-thumbnail.jpg\",\n  \"webEventId\": null,\n  \"id\": \"472401AHGGHJJNNQQDHDDRKKJMJDVPJGV\",\n  \"firstInstanceDateTime\": \"2025-03-27T19:00:00\",\n  \"lastInstanceDateTime\": \"2025-04-27T14:00:00\",\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"3407AVKPCVQSLVLLJHSHRNQMDJSNQJQVL\",\n      \"priceList\": {\n        \"id\": \"33601ABMMCLRHCDGJGLSCVTKRJSMDCMSS\"\n      },\n      \"event\": {\n        \"id\": \"472401AHGGHJJNNQQDHDDRKKJMJDVPJGV\"\n      },\n      \"start\": \"2025-04-27T14:00:00\",\n      \"startUtc\": \"2025-04-27T13:00:00\",\n      \"startSellingAtWeb\": \"2024-12-17T16:09:00\",\n      \"startSellingAtWebUtc\": \"2024-12-17T16:09:00Z\",\n      \"stopSellingAtWeb\": \"2025-04-27T14:00:00\",\n      \"stopSellingAtWebUtc\": \"2025-04-27T13:00:00Z\",\n      \"webInstanceId\": null,\n      \"cancelled\": false,\n      \"id\": \"825402AGKLNRNQTCHVVLRKKCCQDDJDNVQ\",\n      \"hasBestAvailableOverlay\": false,\n      \"attribute_ASSupplementaryEvent\": false,\n      \"attribute_SLCaptioned\": true,\n      \"attribute_CallBoxOfficeToBook\": \"\",\n      \"attribute_SLFreeText\": \"\",\n      \"availability\": {\n        \"name\": \"JW3 Cinema\",\n        \"available\": 42,\n        \"wheelchairAvailable\": 0,\n        \"specialAvailable\": 0,\n        \"capacity\": 62,\n        \"inBasket\": 0,\n        \"unavailable\": 20,\n        \"lockInfoAvailable\": null,\n        \"lockInfoSpecialAvailable\": null\n      }\n    }\n  ]\n}"
