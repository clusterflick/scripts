lector=\"views-exposed-form-search-search\">\n\t\t\t\t<form action=\"/search\" method=\"get\" id=\"views-exposed-form-search-search\" accept-charset=\"UTF-8\">\n  <div class=\"js-form-item form-item js-form-type-textfield form-type-textfield js-form-item-for form-item-for\">\n      <label for=\"edit-for\">Search</label>\n        <input placeholder=\"Search JW3\" data-drupal-selector=\"edit-for\" type=\"text\" id=\"edit-for\" name=\"for\" value=\"\" size=\"30\" maxlength=\"128\" class=\"form-text\" />\n\n        </div>\n<div data-drupal-selector=\"edit-actions\" class=\"form-actions js-form-wrapper form-wrapper\" id=\"edit-actions\"><button data-twig-suggestion=\"search_results_submit\" class=\"a-btn button js-form-submit form-submit\" value=\"Search\" data-drupal-selector=\"edit-submit-search\" type=\"submit\" id=\"edit-submit-search\">\n  Search\n</button>\n</div>\n\n</form>\n\n\t</div>\n\n            \n<div class=\"m-block m-block--block-content m-block--block-content82a51303-2ddf-433b-aba8-4c93be2d8770 m-block__search-suggestions m-search-suggestions\">\n\t\t\n      <h5>We suggest</h5>\n  \n      <div class=\"m-search__suggestions\">\n          <a href=\"/search?for=comedy%20club\" title=\"\">Comedy Club</a>\n    <a href=\"/search?for=party%20on%20purim\" title=\"\">Party on Purim</a>\n    <a href=\"/search?for=wine%20tasting%20evening\" title=\"\">Wine Tasting Evening</a>\n    <a href=\"/search?for=open%20mic%20night\" title=\"\">Open Mic Night</a>\n    <a href=\"/search?for=celebrating%20don%20black\" title=\"\">Celebrating Don Black</a>\n    <a href=\"/search?for=israel%20update\" title=\"\">Israel Update</a>\n\n    </div>\n  \n</div>\n\n          </div>\n        </div>\n      </div>\n    </section>\n  </div>\n\n</header>\n\n\n<div class=\"visually-hidden\">\n  <a id=\"main-content\" tabindex=\"-1\"></a>\n</div>\n\n<main role=\"main\" class=\"wrapper wapper--main\">\n        <div data-drupal-messages-fallback class=\"hidden\"></div>\n<div id=\"block-mainpagecontent\" class=\"m-block m-block--system m-block--system-main-block m-block__ m-\">\n\t\t\t\t\t\n\n<article  role=\"article\" about=\"/whats-on/return-other-planet\" class=\"o-node o-event o-full\">\n\n\t\n\t\t\n\t\t\t\t\t<div class=\"m-banner m-banner--event\" role=\"banner\">\n\n\t\t<div class=\"m-banner__copy\">\n\t\t\t<div class=\"grid\">\n\t\t\t\t<div class=\"col-sm-12\">\n\t\t\t\t\t  <nav class=\"a-breadcrumb\" role=\"navigation\" aria-labelledby=\"system-breadcrumb\">\n    <h2 id=\"system-breadcrumb\" class=\"visually-hidden\">Breadcrumb</h2>\n    <ol>\n          <li>\n                  <a href=\"/\">Home</a>\n              </li>\n          <li>\n                  <a href=\"/whats-on\">What&#039;s On</a>\n              </li>\n          <li> The Return From the Other Planet </li>\n    </ol>\n  </nav>\n\t\t\t\t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"grid align-end\">\n\t\t\t\t<div class=\"col-sm-8 col-lg-6 offset-lg-1\">\n\n                      Seret Film Festival 2025\n          \n\t\t\t\t\t\t\t\t\t\t\t<h1>\n\t\t\t\t\t\t\tThe Return From the Other Planet \n\t\t\t\t\t\t</h1>\n\t\t\t\t\t\n                      החזרה מן הכוכב האחר\n          \n\t\t\t\t\t<div class=\"o-event__details\">\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span>81 minutes</span>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"o-event__details o-event__details-bold\">\n\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span>Tue 13 May 2025</span><span>6:00pm</span>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span>£14</span>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\n\t\t\t\t</div>\n        <div class=\"col-sm-4 col-lg-3 offset-lg-1 m-banner__links\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.jw3.org.uk/book/880002\" class=\"a-btn\">Book Now</a>\n\t\t\t\t\t\t\t\t\t\t\t          <aside class=\"a-wishlist\"><span class=\"a-wishlist__msg\"></span><button class=\"a-wishlist__button\" title=\"Add to wishlist\" data-target=\"4436\">Add to wishlist</button></aside>\n        </div>\n\t\t\t</div>\n\t\t</div>\n\t\t\n\t\t<figure class=\"m-banner__image a-image a-image--full\">\n\t\t\t\n\n<picture>\n\t\t<source media=\"(max-width: 600px)\" srcset=\"/sites/default/files/styles/banner_image_sm/public/images/The%20Return%20from%20the%20Other%20Planet.jpg?itok=ra4O0l0_\" type=\"image/jpeg\">\n\t\t<source media=\"(max-width: 1000px)\" data-srcset=\"/sites/default/files/styles/banner_image_md/public/images/The%20Return%20from%20the%20Other%20Planet.jpg?itok=BRHaHckr\" type=\"image/jpeg\">\n\t\t<source data-srcset=\"/sites/default/files/styles/banner_image/public/images/The%20Return%20from%20the%20Other%20Planet.jpg?itok=VjvUNWHA\" type=\"image/jpeg\">\n\t<img data-src=\"\" alt=\"The Return From the Other Planet \" class=\"lazy lazy-animate\" />\n</picture>\n\t\t\t\t\t</figure>\n\n\t</div>\n\n\n<div class=\"m-sticky-header\">\n\t<div class=\"grid justify-center\">\n\t\t<div class=\"col-sm-12 col-lg-10\">\n\t\t\t<div class=\"m-sticky-header__inner\">\n\t\t\t\t<aside>\n\t\t\t\t\t<h2>The Return From the Other Planet </h2>\n\n\t\t\t\t\t<div class=\"o-event__details o-event__details-bold\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span><time datetime=\"2025-05-13T17:00:00Z\" class=\"datetime\">13 May 2025</time>\n</span>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span>£14</span>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</aside>\n\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.jw3.org.uk/book/880002\" class=\"a-btn\">Book Now</a>\n\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t</div>\n\t</div>\n</div>\n<div class=\"grid\">\n\t<div class=\"col-sm-8 col-md-8 col-lg-6 order-1 order-sm-0 offset-lg-1\">\n\n\t\t\n\t\t\t\t\t<div class=\"m-entity m-entity__body\">\n\t\t\t\t<p>This documentary explores the life of Ka-Tzetnik, the mysterious writer who captivated millions with his haunting depiction of Auschwitz, famously calling it \"The Other Planet.\"</p>\n<p>However, when an experimental LSD treatment leads him to new insights, his revolutionary message is tragically overlooked. A powerful exploration of trauma, revelation, and the complexities of Ka-Tzetnik’s legacy.</p>\n<p>Winner of Best Documentary at the Jerusalem Film Festival. </p>\n<p>This screening will be preceded by the short film, <strong>Holding On. </strong></p>\n\n\t\t\t</div>\n\t\t\n\t\t\t\t\t\n<section class=\"m-entity m-entity__video\">\n\n  \n    <h3 class=\"a-title\">The Return From the Other Planet<span>&#x25A0;</span></h3>\n\n  \n  <div class=\"video-embed-field-provider-youtube video-embed-field-responsive-video\"><iframe width=\"854\" height=\"480\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\" src=\"https://www.youtube.com/embed/h5eD-CwzupE?autoplay=0&amp;start=0&amp;rel=0\"></iframe>\n</div>\n\n\n  \n\n\n</section>\n\n<section class=\"m-entity m-entity__accordion\">\n\n  \n  \n  <div class=\"js-accordion\">\n    <p class=\"js-accordion__header h3\">Credits</p>\n<div class=\"js-accordion__panel\">\n\t<p><strong>Genre:</strong> Documentary<br />\n<strong>Director:</strong> Assaf Lapid<br />\n<strong>Writer: </strong>Assaf Lapid, Naomi Levari, Saar Yogev<br />\n<strong>Producer:</strong> Saar Yogev, Naomi Levari, Guy Hodes, Michael Reuter, Harry Flöter, Jörg Siepmann</p>\n\n</div>\n\n  </div>\n\n\n</section>\n\n\t\t\n\t\t\t</div>\n\n\t<div class=\"col-sm-4 col-lg-3 order-0 order-sm-1 offset-lg-1 col-bleed\">\n\t\t\t\t\t  <div class=\"o-sidebar o-sidebar--event o-sidebar--dark m-entity a-focus\">\n    <h3>Please note</h3>\n    <p>This film is in Hebrew, English, and Yiddish with English subtitles. </p>\n<p>A booking fee of £2 and a security levy of £1.50 will be added to all orders. More information can be found <em><a href=\"https://www.jw3.org.uk/booking-and-security-fees\" id=\"menur60q\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://www.jw3.org.uk/booking-and-security-fees\">here</a></em>. </p>\n\n  </div>\n\n<div class=\"o-sidebar o-sidebar--event m-entity\">\n  \n  \n      <strong>Date - Tue 13 May 2025 6:00pm</strong>\n  \n  \n  <hr>\n\n      <h3>£14</h3>\n  \n      \n<div class=\"m-block m-block--block-content m-block--block-content95ac2687-564b-43db-8f9d-049edbcc2e7a m-block__default-booking-information m-default-booking-information\">\n\t\t\t\t<div class=\"m-booking-info\">\n  \n  </div>\n\t</div>\n\n  </div>\n\n  <div class=\"o-sidebar o-sidebar--event o-sidebar--highlight\">\n    \n<div class=\"m-block m-block--block-content m-block--block-contenta8df1267-4caa-41b6-842f-0230abfeeb5b m-block__friends-promo m-friends-promo\">\n\t\t\t\t<p>Become a JW3 Friend and save up to 10% on events!</p>\n<p><a href=\"/memberships\" title=\"Membership\">Join now</a></p>\n\n\t</div>\n\n  </div>\n\n  <div class=\"o-sidebar o-sidebar--event m-entity\">\n\n      <div class=\"o-sidebar__festival\">\n      <h3 class=\"h5\">Part of:</h3>\n      <div class=\"views-element-container\"><div class=\"view__festival_link m-entity m-entity__view\">\n  \n  \n  \n\n  \n  \n  \n\n    <div class=\"views-field views-field-title\"><span class=\"field-content\"><a href=\"/seret\" hreflang=\"en\">Seret Film Festival</a></span></div>\n\n  \n  \n\n  \n  \n\n  \n  \n</div>\n</div>\n\n    </div>\n  \n      <h3 class=\"h5\">Type:</h3>\n      <a href=\"/whats-on?date=&genre[3]=3&type=All\" class=\"a-tag a-tag--cinema\"><svg width=\"39\" height=\"38\" viewBox=\"0 0 39 38\" xmlns=\"http://www.w3.org/2000/svg\"><g fill=\"none\" fill-rule=\"evenodd\"><path fill=\"#EE7203\" d=\"M0 0h39v38H0z\"/><ellipse fill=\"#FFF\" cx=\"19.5\" cy=\"19.358\" rx=\"10.111\" ry=\"10.038\"/></g></svg>Cinema</a>\n\n    </div>\n\t\t\t</div>\n\n</div>\n\n\n\n\n\n\t\t\n\t  \n\n</article>\n\t</div>\n\n\n  </main>\n\n<footer class=\"o-footer\" role=\"contentinfo\">\n  <section class=\"o-footer__top\">\n    <div class=\"grid\">\n      <div class=\"col-sm-12\">\n\n        <div class=\"o-footer__top-inner\">\n          \n<div class=\"m-block m-block--block-content m-block--block-contentb99bc602-5791-4ff9-a92d-61be3be0bc59 m-block__footer---box-office m-footer---box-office\">\n\t\t\t\t<h3>Box Office</h3>\n<p>(020) 7433 8988</p>\n<p>341-351 Finchley Road, London, NW3 6ET</p>\n<p>JW3 - Helping to create a vibrant, diverse and proud community, inspired by and engaged in Jewish arts, culture and community</p>\n\n\t</div>\n\n          \n<div class=\"m-block m-block--block-content m-block--block-contentb1e46c97-db06-4c67-a5c1-b97f638629b4 m-block__footer---friends m-footer---friends\">\n\t\t\t\t<h4>JW3 Friends Get More</h4>\n<ul>\n<li>Save 10% on events, activities, classes &amp; courses</li>\n<li>Get a 10% discount at the Café</li>\n<li>Advance booking on selected events</li>\n</ul>\n<p><strong><a href=\"/memberships\" title=\"Membership\">JOIN NOW</a></strong></p>\n\n\t</div>\n\n          \n<div class=\"m-block m-block--block-content m-block--block-content8d66a62c-9384-439f-bfbd-7f9314d82294 m-block__bottom-right-block m-bottom-right-block\">\n\t\t\t\t<h3>Café @ JW3</h3>\n<p>Our in-house coffee shop is located in the bottom floor of JW3's building, next to the Piazza. It's the perfect spot to enjoy a hot or cold drink, savoury snacks and morish sweet treats &amp; pastries. </p>\n<p><strong>Open Sunday to Thursday from 10am</strong></p>\n<p> </p>\n\n\t</div>\n\n        </div>\n\n      </div>\n    </div>\n  </section>\n  <div class=\"grid\">\n    <div class=\"col-sm-12\">\n\n      <div class=\"m-footer-row m-footer-row--top\">\n        \n              <ul class=\"menu\">\n                    <li class=\"menu-item\">\n        <a href=\"/about-us\" data-drupal-link-system-path=\"node/338\">About us</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"https://www.venuehire.jw3.org.uk/\">Venue Hire</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"https://www.jw3.org.uk/jw3-tv\">JW3-TV</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"/your-visit/getting-us\" data-drupal-link-system-path=\"node/328\">Getting to us</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"/your-visit/box-office\" data-drupal-link-system-path=\"node/325\">Contact us</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"/support-us/volunteer\" data-drupal-link-system-path=\"node/57\">Volunteer</a>\n              </li>\n        </ul>\n  \n\n\n        \n<div class=\"m-block m-block--block-content m-block--block-contentd0c62609-0a2a-4757-90cc-f9724e48f8ed m-block__join-the-mailing-list m-join-the-mailing-list\">\n\t\t\t\t<h3>Join our mailing list</h3>\n<p><a href=\"/signup\">Sign up</a></p>\n\n\t</div>\n\n        \n<div class=\"m-block m-block--block-content m-block--block-contenta290b81e-fa3e-43e8-992b-d389d0597500 m-block__footer---social-links m-footer---social-links\">\n\t\t\n      <h3>Join the conversation</h3>\n  \n      <div class=\"m-social-links\">\n      <div class=\"m-author-links\">\n        <a href=\"https://www.facebook.com/JW3London/\" rel=\"noopener nofollow\" class=\"m-social-links__link\" aria-label=\"Open Facebook\" title=\"Open Facebook\" target=\"_blank\">\n    <svg width=\"11\" height=\"24\" viewBox=\"0 0 11 24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M10.806 8.074h-3.67V5.657c0-.908.6-1.12 1.022-1.12h2.59V.548L7.18.533c-3.96 0-4.86 2.976-4.86 4.881v2.66H.031v4.113h2.29v11.636h4.816V12.187h3.25l.42-4.113z\"/></svg>\n  </a>\n\n        <a href=\"https://twitter.com/JW3London\" rel=\"noopener nofollow\" class=\"m-social-links__link\" aria-label=\"Open Twitter\" title=\"Open Twitter\" target=\"_blank\">\n    <svg width=\"26\" height=\"22\" viewBox=\"0 0 26 22\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M25.226 3.002a9.801 9.801 0 01-2.893.816 5.172 5.172 0 002.215-2.87 9.912 9.912 0 01-3.2 1.26A4.965 4.965 0 0017.673.57c-2.782 0-5.038 2.322-5.038 5.186 0 .406.045.802.13 1.182-4.186-.217-7.899-2.28-10.384-5.419A5.277 5.277 0 001.7 4.127c0 1.8.889 3.