dy\" />\n<meta property=\"og:site_name\" content=\"JW3\" />\n<meta property=\"og:url\" content=\"https://www.jw3.org.uk/whats-on/pink-lady\" />\n<meta property=\"og:title\" content=\"Pink Lady\" />\n<meta property=\"og:description\" content=\"One of Nir Bergman&#039;s best films, this gripping drama unfolds in an ultra-Orthodox Jewish community in Jerusalem.\nBati seems to have the perfect life with her husband Lazer and their three children, but everything unravels when Lazer is blackmailed and Bati discovers his secret affair with his male study partner. Desperate to protect her family, she supports Lazer as he attempts to &quot;cure&quot; his homosexuality, while also uncovering her own hidden desires. A powerful exploration of love, identity, and self-discovery.\" />\n<meta property=\"og:image\" content=\"https://www.jw3.org.uk/sites/default/files/styles/meta_facebook/public/images/Pink%20Lady.jpg?itok=K2F0QePD\" />\n<meta property=\"og:image:width\" content=\"1200\" />\n<meta property=\"og:image:height\" content=\"630\" />\n<meta property=\"og:updated_time\" content=\"2025-04-02T17:32:28+01:00\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<meta name=\"twitter:site\" content=\"@JW3London\" />\n<meta name=\"twitter:title\" content=\"Pink Lady | JW3\" />\n<meta name=\"twitter:url\" content=\"https://www.jw3.org.uk/whats-on/pink-lady\" />\n<meta name=\"twitter:image:height\" content=\"500\" />\n<meta name=\"twitter:image:width\" content=\"1500\" />\n<meta name=\"twitter:image\" content=\"https://www.jw3.org.uk/sites/default/files/styles/meta_twitter/public/images/Pink%20Lady.jpg?itok=FPWMD0Sl\" />\n<meta name=\"Generator\" content=\"Drupal 9 (https://www.drupal.org)\" />\n<meta name=\"MobileOptimized\" content=\"width\" />\n<meta name=\"HandheldFriendly\" content=\"true\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<link rel=\"shortcut icon\" href=\"/themes/pippip/favicon.ico\" type=\"image/vnd.microsoft.icon\" />\n