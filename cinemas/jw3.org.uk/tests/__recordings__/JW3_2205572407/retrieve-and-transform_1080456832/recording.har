        "response": {
          "bodySize": 5515,
          "content": {
            "mimeType": "application/json",
            "size": 5515,
            "text": "{\n  \"description\": \"Wind, Tide & Oar is a compelling exploration of engineless sailing, shot on analogue film over three years. The film delves into the experiences of those who travel solely by harnessing the natural elements alone, following a diverse array of traditional boats and uncovering the unique rhythms and motivations of engineless navigation.\\r\\n\\r\\nJourneying through rivers, coastlines, and open seas, spanning the UK, the Netherlands, and France, Wind, Tide & Oar creates a contemplative space, addressing themes of ecology, heritage, traditional skills, and maritime history. Using a 1960s hand-wound camera, Wahl offers a poetic and intimate perspective on a millennia-old craft, upended by the invention of mechanised power.\\r\\n\\r\\nThrough the film’s reveries, sailing becomes a means to explore our interaction with and responsibility to the environment. It invites deep reflection on our relationship with nature, our understanding of and commitment to sustainability, and our care for the world around us. | Rating: PG, Duration: 1h 24m | Films may be preceded by up to 20 minutes of advertisements and trailers. Specific timings will vary with each screening. We always recommend arriving on time. \",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 84,\n  \"imageUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/ec9afcfd-8ae7-4674-b074-d12d572f1151.jpg\",\n  \"isOnSale\": true,\n  \"name\": \"Wind, Tide & Oar\",\n  \"instanceDates\": \"11 May-13 May\",\n  \"thumbnailUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/ec9afcfd-8ae7-4674-b074-d12d572f1151-thumbnail.jpg\",\n  \"webEventId\": null,\n  \"id\": \"506601ARQKJQVKDBVJTJPLKCTHPLVRNDV\",\n  \"firstInstanceDateTime\": \"2025-05-11T11:00:00\",\n  \"lastInstanceDateTime\": \"2025-05-13T10:30:00\",\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"3407AVKPCVQSLVLLJHSHRNQMDJSNQJQVL\",\n      \"priceList\": {\n        \"id\": \"148802AKTKTJGVTJVDRDBTJLHNRDTSPJP\"\n      },\n      \"event\": {\n        \"id\": \"506601ARQKJQVKDBVJTJPLKCTHPLVRNDV\"\n      },\n      \"start\": \"2025-05-11T11:00:00\",\n      \"startUtc\": \"2025-05-11T10:00:00\",\n      \"startSellingAtWeb\": \"2025-04-23T14:17:00\",\n      \"startSellingAtWebUtc\": \"2025-04-23T13:17:00Z\",\n      \"stopSellingAtWeb\": \"2025-05-11T11:00:00\",\n      \"stopSellingAtWebUtc\": \"2025-05-11T10:00:00Z\",\n      \"webInstanceId\": null,\n      \"cancelled\": false,\n      \"id\": \"887401AKRMTRRQNQKKBLLPQDDVTJGKCHR\",\n      \"hasBestAvailableOverlay\": false,\n      \"attribute_ASSupplementaryEvent\": false,\n      \"attribute_SLCaptioned\": false,\n      \"attribute_CallBoxOfficeToBook\": \"\",\n      \"attribute_SLFreeText\": \"\",\n      \"availability\": {\n        \"name\": \"JW3 Cinema\",\n        \"available\": 58,\n        \"wheelchairAvailable\": 0,\n        \"specialAvailable\": 0,\n        \"capacity\": 62,\n        \"inBasket\": 0,\n        \"unavailable\": 4,\n        \"lockInfoAvailable\": null,\n        \"lockInfoSpecialAvailable\": null\n      }\n    },\n    {\n      \"isOnSale\": true,\n      \"planId\": \"3407AVKPCVQSLVLLJHSHRNQMDJSNQJQVL\",\n      \"priceList\": {\n        \"id\": \"148802AKTKTJGVTJVDRDBTJLHNRDTSPJP\"\n      },\n      \"event\": {\n        \"id\": \"506601ARQKJQVKDBVJTJPLKCTHPLVRNDV\"\n      },\n      \"start\": \"2025-05-12T13:30:00\",\n      \"startUtc\": \"2025-05-12T12:30:00\",\n      \"startSellingAtWeb\": \"2025-04-23T14:17:00\",\n      \"startSellingAtWebUtc\": \"2025-04-23T13:17:00Z\",\n      \"stopSellingAtWeb\": \"2025-05-12T13:30:00\"