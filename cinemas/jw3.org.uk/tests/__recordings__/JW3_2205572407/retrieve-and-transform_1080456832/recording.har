        "response": {
          "bodySize": 8554,
          "content": {
            "mimeType": "application/json",
            "size": 8554,
            "text": "{\n  \"description\": \"Once upon a time, a poor woodcutter and his wife lived in a great forest. Cold, hunger, poverty and a war raging all around them meant their lives were very hard. One day, the woodcutter's wife rescues a baby. A baby girl thrown from one of the many trains that constantly pass through the forest. This baby, this \\\"most precious of cargoes\\\", will transform the lives of the poor woodcutter's wife and her husband, as well as those whose paths the child will cross - including the man who threw her from the train. And some will try to protect her, whatever the cost. Their story will reveal the worst and the best in the hearts of men. \\r\\n\\r\\n| This film is in French with English subtitles \\r\\n| Rating: 12A, Duration: 1h 21m  \\r\\n| All films will be preceded by 10-20 minutes of advertisements and trailers.\",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 81,\n  \"imageUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/a06a03bb-bfef-440c-8b60-49e25cdb2fab.jpg\",\n  \"isOnSale\": true,\n  \"name\": \"The Most Precious of Cargoes\",\n  \"instanceDates\": \"6 April-17 April\",\n  \"thumbnailUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/a06a03bb-bfef-440c-8b60-49e25cdb2fab-thumbnail.jpg\",\n  \"webEventId\": null,\n  \"id\": \"500401AMJGGSPVVMMTQDHQNLQSLHVSPHK\",\n  \"firstInstanceDateTime\": \"2025-04-06T11:30:00\",\n  \"lastInstanceDateTime\": \"2025-04-17T16:50:00\",\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"3407AVKPCVQSLVLLJHSHRNQMDJSNQJQVL\",\n      \"priceList\": {\n        \"id\": \"149401ALSPNQKBLR