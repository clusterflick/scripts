25 6.285 7.697 10.288.427.409.862.826 1.303 1.252.441-.426.876-.843 1.303-1.252C16.475 12.685 20 9.55 20 6.4c0-1.229-.44-2.201-1.142-2.88-.809-.784-1.943-1.178-3.086-1.178-1.501 0-3.037.687-3.912 2.16L11 5.95l-.86-1.45c-.878-1.48-2.409-2.168-3.906-2.168z\" stroke=\"#000\" stroke-width=\"2\"/></svg></a>\n\n            <button class=\"a-nav-toggle\" title=\"Toggle Nav\" aria-label=\"Toggle nav\">\n              <span class=\"a-nav-toggle__text\">Menu</span>\n              <span class=\"a-nav-toggle__icon\">\n                <span class=\"a-nav-toggle__icon-line a-nav-toggle__icon-line-1\"></span>\n                <span class=\"a-nav-toggle__icon-line a-nav-toggle__icon-line-2\"></span>\n                <span class=\"a-nav-toggle__icon-line a-nav-toggle__icon-line-3\"></span>\n              </span>\n            </button>\n          </div>\n        \n        </div>\n\n      </div>\n    </div>\n  </div>\n\n  <nav class=\"m-main-nav m-overlay\" role=\"navigation\">\n    <section data-simplebar>\n      <div class=\"grid\">\n        <div class=\"col-sm-12 col-bleed\">\n          \n          <div class=\"m-main-nav__inner\">\n            \n              <ul class=\"menu\">\n                    <li class=\"menu-item menu-item--expanded\">\n        <a href=\"/whats-on\" data-drupal-link-system-path=\"node/5\">What&#039;s On</a>\n                                <ul class=\"menu\">\n                    <li class=\"menu-item\">\n        <a href=\"/whats-on?date=&amp;type=69\" data-drupal-link-query=\"{&quot;date&quot;:&quot;&quot;,&quot;type&quot;:&quot;69&quot;}\" data-drupal-link-system-path=\"node/5\">In Building Events</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"/whats-on?date=&amp;type=70\" data-drupal-link-query=\"{&quot;date&quot;:&quot;&quot;,&quot;type&quot;:&quot;70&quot;}\" data-drupal-link-system-path=\"node/5\">Online Events</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"/whats-on/past-e