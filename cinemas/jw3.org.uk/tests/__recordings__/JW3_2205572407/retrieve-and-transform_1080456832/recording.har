        "response": {
          "bodySize": 5092,
          "content": {
            "mimeType": "application/json",
            "size": 5092,
            "text": "{\n  \"description\": \"A wondrous journey, through realms natural and mystical, Flow follows a courageous cat after his home is devastated by a great flood. Teaming up with a capybara, a lemur, a bird, and a dog to navigate a boat in search of dry land, they must rely on trust, courage, and wits to survive the perils of a newly aquatic planet. From the boundless imagination of the award-winning Gints Zilbalodis (Away) comes a thrilling animated spectacle as well as a profound meditation on the fragility of the environment and the spirit of friendship and community. Steeped in the soaring possibilities of visual storytelling, Flow is a feast for the senses and a treasure for the heart.\\r\\n\\r\\n| Rating: U, Duration: 1h 25m\\r\\n| All films will be preceded by 10-20 minutes of advertisements and trailers. \",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 85,\n  \"imageUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/3e7696cd-19db-43c6-a78e-e53f6855db04.jpg\",\n  \"isOnSale\": true,\n  \"name\": \"Flow\",\n  \"instanceDates\": \"22 April-24 April\",\n  \"thumbnailUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/3e7696cd-19db-43c6-a78e-e53f6855db04-thumbnail.jpg\",\n  \"webEventId\": null,\n  \"id\": \"499801AKKVSPMPPVTJGSPPTNHJNPKNLNL\",\n  \"firstInstanceDateTime\": \"2025-04-22T11:00:00\",\n  \"lastInstanceDateTime\": \"2025-04-24T11:00:00\",\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"3407AVKPCVQSLVLLJHSHRNQMDJSNQJQVL\",\n      \"priceList\": {\n        \"id\": \"148802AKTKTJGVTJVDRDBTJLHNRDTSPJP\"\n      },\n      \"event\": {\n 