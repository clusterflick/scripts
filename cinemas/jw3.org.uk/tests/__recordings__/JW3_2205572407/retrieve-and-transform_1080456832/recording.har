        "response": {
          "bodySize": 4089,
          "content": {
            "mimeType": "application/json",
            "size": 4089,
            "text": "{\n  \"description\": \"In Sister Midnight, the audacious debut feature from London based Indian artist and filmmaker Karan Kandhari, rebellious small-town misfit Uma arrives in Mumbai to find herself totally unsuited to life as a housewife. At odds with her prying neighbors and under the constant oppressive noise and heat of the city, she decides to break free from the shackles of domesticity and follow her own path in this bold, unpredictable, and darkly funny debut. Featuring an eclectic soundtrack and singular visual aesthetic, the film world-premiered in Cannes’ Directors Fortnight and won the award for Best Film in the Next Wave section at Fantastic Fest. \\r\\n\\r\\n| Film is in Hindi and English with English subtitles \\r\\n| Rating: 15, Duration: 1h 47m  \\r\\n| Films may be preceded by up to 20 minutes of advertisements and trailers. Specific timings will vary with each screening. We always recommend arriving on time. \",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 107,\n  \"imageUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/6446b9a0-7c08-4f84-b71b-62a421428376.jpg\",\n  \"isOnSale\": true,\n  \"name\": \"Sister Midnight\",\n  \"instanceDates\": \"27 April-28 April\",\n  \"thumbnailUrl\": \"https://sysfilessacbe149174fee.blob.core.windows.net/public-container/clients/jw3/files/6446b9a0-7c08-4f84-b71b-62a421428376-thumbnail.jpg\",\n  \"webEventId\": null,\n  \"id\": \"499001ARJMNSKCDGTBHRQMJKKLMBNQSLG\",\n  \"firstInstanceDateTime\": \"2025-04-27T17:00:00\",\n  \"lastInstanceDateTime\": \"2025-04-28T19:00:00\",\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"3407AVKPCVQSL