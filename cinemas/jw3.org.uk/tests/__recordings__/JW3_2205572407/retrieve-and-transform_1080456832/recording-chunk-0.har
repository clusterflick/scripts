          "content": {
            "mimeType": "application/json",
            "text": "{\n  \"description\": \"Anand, a 30-something city dweller compelled to spend a 10-day mourning period for his father in the rugged countryside of western India, tenderly bonds with a local farmer who is struggling to stay unmarried. As the mourning ends, forcing his return, Anand must decide the fate of his relationship born under duress. Duration: 112 minutes Rating: 15 Director: Rohan Kanawade Cast: Bhushaan Manoj, Suraaj Suman, Jayshri Jagtap Year: 2025 Language: Marathi Subtitles: English https://www.youtube.com/watch?v=ssjeFH1oyxY&pp=ygUUY2FjdHVzIHBlYXJzIHRyYWlsZXI%3D\",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 112,\n  \"imageUrl\": \"\",\n  \"isOnSale\": true,\n  \"name\": \"Cactus Pears\",\n  \"instanceDates\": \"3 July-14 July\",\n  \"thumbnailUrl\": \"\",\n  \"webEventId\": null,\n  \"id\": \"640202APVHTKQSNLCSJCTMBRBKBJTGMKB\",\n  \"firstInstanceDateTime\": \"2026-07-03T10:30:00\",\n  \"firstInstanceDateTimeUtc\": \"2026-07-03T09:30:00Z\",\n  \"lastInstanceDateTime\": \"2026-07-14T10:30:00\",\n  \"lastInstanceDateTimeUtc\": \"2026-07-14T09:30:00Z\",\n  \"altText\": \"\",\n  \"attribute_CinemaMembershipExclusion\": false,\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"4401APLLPBSHLDJVTLGBDQTQBHJDJSHCM\",\n      \"priceList\": {\n        \"id\": \"148802AKTKTJGVTJVDRDBTJLHNRDTSPJP\"\n      },\n      \"event\": {\n        \"id\": \"640202APVHTKQSNLCSJCTMBRBKBJTGMKB\"\n      },\n      \"start\": \"2026-07-13T13:15:00\",\n      \"startUtc\": \"2026-07-13T12:15:00\",\n      \"startSellingAtWeb\": \"2026-06-25T11:21:00\",\n      \"startSellingAtWebUtc\": \"2026-06-25T10:21:00Z\",\n      \"stopSellingAtWeb\": \"2026-07-13T1