          "content": {
            "mimeType": "text/html; charset=UTF-8",
            "text": "\n<!DOCTYPE html>\n\n<!--\n\n    Peppered is the leading saas online marketing solution\n    for venues in the BeNeLux, Scandinavia, the UK... the world!\n    Peppered is part of CultureSuite.\n\n    Join us!\n\n    https://www.culturesuite.co/about-us\n\n    -->\n\n<html\n    dir=\"ltr\"\n    lang=\"en\"\n    data-theme=\"system\"\n            >\n\n    <head>\n        <meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\n\n\n\n    <link rel=\"canonical\" href=\"https://www.jw3.org.uk/whats-on\">\n\n<title>Agenda | JW3</title>\n\n        <link rel=\"stylesheet\" href=\"/dist/site-lib.css?9f1b1dad0f2a6437496bcbfe2b3e82d2dbc1939a\">\n    <link rel=\"stylesheet\" href=\"/dist/site-bundle.css?9f1b1dad0f2a6437496bcbfe2b3e82d2dbc1939a\">\n\n\n<script type=\"application/ld+json\">\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"WebSite\",\n    \"url\": \"https://www.jw3.org.uk/\",\n    \"name\": \"JW3\",\n    \"potentialAction\": {\n        \"@type\": \"SearchAction\",\n        \"target\": \"/search?term=%7Bsearch_term%7D\",\n        \"query-input\": \"required name=search_term\"\n    }\n}\n</script>\n\n\n        \n<script>\n    var dataLayer = [{\"cookie_consent\":\"\",\"cookieConsent\":\"\",\"currency_code\":\"GBP\",\"location_category\":\"product_list\",\"order_code\":\"\",\"order_delivery_method\":\"\",\"order_items\":[],\"ga4_ecommerce_items\":[],\"order_payment_method\":\"\",\"order_status\":\"\",\"order_value\":0,\"visitor_is_logged_in\":false,\"detail_items\":[]}];\n</script>\n\n\n\n\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\n    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\n    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n    })(window,document,'script','dataLayer','GTM-W7HXRLZ');</script>\n\n    </head>\n\n    <bo