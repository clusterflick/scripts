            "mimeType": "application/json",
            "text": "{\n  \"description\": \"Marc Isaacs makes a deal with The Synthetic Sincerity Lab, an AI research project. There, researchers are investigating the possibility of teaching AI characters authenticity, using characters from Isaacs’ documentaries to do so. In return, they allow Isaacs to film the process. Duration: 72 minutes Rating: TBC Director: Marc Isaacs Year: 2025 https://www.youtube.com/watch?v=Ml-ZQMF4xfQ\",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 71,\n  \"imageUrl\": \"\",\n  \"isOnSale\": true,\n  \"name\": \"Babykino: A Synthetic Sincerity\",\n  \"instanceDates\": \"10 August-10 August\",\n  \"thumbnailUrl\": \"\",\n  \"webEventId\": null,\n  \"id\": \"656001AHMGTQMRLHBVCKCSKGHBBRDPNTM\",\n  \"firstInstanceDateTime\": \"2026-08-10T10:30:00\",\n  \"firstInstanceDateTimeUtc\": \"2026-08-10T09:30:00Z\",\n  \"lastInstanceDateTime\": \"2026-08-10T10:30:00\",\n  \"lastInstanceDateTimeUtc\": \"2026-08-10T09:30:00Z\",\n  \"altText\": \"\",\n  \"attribute_CinemaMembershipExclusion\": false,\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"4401APLLPBSHLDJVTLGBDQTQBHJDJSHCM\",\n      \"priceList\": {\n        \"id\": \"148802AKTKTJGVTJVDRDBTJLHNRDTSPJP\"\n      },\n      \"event\": {\n        \"id\": \"656001AHMGTQMRLHBVCKCSKGHBBRDPNTM\"\n      },\n      \"start\": \"2026-08-10T10:30:00\",\n      \"startUtc\": \"2026-08-10T09:30:00\",\n      \"startSellingAtWeb\": \"2026-07-23T12:10:00\",\n      \"startSellingAtWebUtc\": \"2026-07-23T11:10:00Z\",\n      \"stopSellingAtWeb\": \"2026-08-10T10:30:00\",\n      \"stopSellingAtWebUtc\": \"2026-08-10T09:30:00Z\",\n      \"webInstanceId\": null,\n      \"cancelled\": false,\n      \"id\":