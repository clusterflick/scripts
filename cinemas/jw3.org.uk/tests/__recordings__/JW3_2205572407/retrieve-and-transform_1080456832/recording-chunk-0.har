 viewBox='0 0 20 20' xml:space='preserve'><g transform='matrix(0.0347222,0,0,0.0347222,0,1.11111)'><path d='M528.12,301.319l47.273,-208c3.413,-15.018 -8.002,-29.319 -23.403,-29.319l-392.782,0l-9.166,-44.81c-2.284,-11.169 -12.112,-19.19 -23.513,-19.19l-102.529,0c-13.255,0 -24,10.745 -24,24l0,16c0,13.255 10.745,24 24,24l69.883,0l70.248,343.435c-16.806,9.665 -28.131,27.787 -28.131,48.565c0,30.928 25.072,56 56,56c30.928,0 56,-25.072 56,-56c0,-15.674 -6.447,-29.835 -16.824,-40l209.647,0c-10.376,10.165 -16.823,24.326 -16.823,40c0,30.928 25.072,56 56,56c30.928,0 56,-25.072 56,-56c0,-22.172 -12.888,-41.332 -31.579,-50.405l5.517,-24.276c3.413,-15.018 -8.002,-29.319 -23.403,-29.319l-268.418,0l-6.545,-32l293.145,0c11.206,0 20.92,-7.754 23.403,-18.681Z'/></g></svg></span>\n                    <span class='label'><span class='label'><span class=\"movie-time-start\">7:00 PM</span><span class='screenreader'>Tickets</span></span></span>\n                </a>\n\n            </div>\n</li>\n\n        \n        \n                                <li class=\"subshow type-info cost-message\">\n            <p>A booking fee of £2 and a security levy of £1.50 will be added to all orders. </p>\n        </li>\n    \n        \n                    </ul>\n\n\n                    </div>\n                </div>\n            </div>\n        \n    </div>\n</div>\n\n\t\t\n\t\t\t\t<span id=\"page_part_2\"></span>\n\n\t\t\t\t\n\t\t\t\t\n        <div  class=\"container-fluid teaserWrapper variant- align-\" style=\"padding-top: 60px; padding-bottom: 60px; background: var(--background2);\n\">\n\n        \n\n        <div class=\"container\">\n                    <div class=\"richtext\">\n            <p>The international hit musical comes to the big screen!</p>\n        </div>\n    \n        </div>\n\n        \n\n    </div>\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_3\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_4\"></span>\n\n\t\t\t\t\n\t\t\t\t\n                                            \n                        \n\n    \n<div class=\"container-fluid desc1Wrapper align- has-meta-info \" style=\"padding-top: 30px; padding-bottom: 30px; background: var(--background);\n\">\n    <div class=\"container\">\n                    <div class=\"desc1\">\n                <div class=\"richtext\"><p>The international hit musical comes to the big screen! Winner of eight Tony Awards in 2019 including Best Musical and the 2020 Grammy Award for Best Musical Theater Album, HADESTOWN: THE MUSICAL is the genre-defying musical blending modern American folk music with New Orleans-inspired jazz to reimagine a sweeping ancient tale of two intertwining love stories, that of young dreamers Orpheus and Eurydice, and King Hades and his wife Persephone. Filmed live on stage in London’s West End and featuring the original Broadway stars, HADESTOWN: THE MUSICAL invites audiences on a hell-raising journey to the underworld and back.</p></div>\n            </div>\n        \n                    <div class=\"metaWrapper\">\n                <div class=\"inner\">\n                                                                                                                                                <img class=\"poster\" src=\"https://img.jw3.org.uk/bSC4ofnGeCZO7P12Fi1QFF68hVLJ4hqKk9P_5CqXL4A/rs:fit:1920:800:1/aHR0cHM6Ly93d3cuanczLm9yZy51ay8vY21zX2ZpbGVzL3N5c3RlbS9pbWFnZXMvaW1nMTQyOV9vcmlnLmpwZw\" alt=\"Hadestown\">\n                    \n                                            <div class=\"infoList\">\n                            <dl>\n                                                                    <dt>Direction</dt>\n                                    <dd>Brett Sullivan (screen); Rachel Chavkin (stage)</dd>\n                                                                                                    <dt>Cast</dt>\n                                    <dd>Reeve Carney, André De Shields, Amber Gray, Eva Noblezada, Patrick Page</dd>\n                                                                                                    <dt>Duration</dt>\n                                    <dd>142 min</dd>\n                                                                                                                                                                                                                            </dl>\n\n                            \n                        </div>\n                    \n                    \n                                            <div class=\"extraInfo\">\n                            <p>£9 / £15</p>\n                        </div>\n                    \n                                        \n\n                                        \n\n                                                        </div>\n            </div>\n            </div>\n</div>\n\n\t\t\n\t\t\t\t<span id=\"page_part_161\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\t\t\n\t\t\t\t<span id=\"page_part_7\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_5\"></span>\n\n\t\t\t\t\n\t\t\t\t    \n\n\n    \n\t\t\n\t\t\t\t<span id=\"page_part_90\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_9\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t\t<span id=\"page_part_226\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t\t<span id=\"page_part_227\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t\t<span id=\"page_part_10\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_8\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_223\"></span>\n\n\t\t\t\t\n\t\t\t\t    \n\n\t\t\n\t\t\t\t<span id=\"page_part_114\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_11\"></span>\n\n\t\t\t\t\n\t\t\t\t\n    \n\n    <aside class=\"section section--suggestions container-fluid suggestionWrapper  variant-boxed arrows\" style=\"padding-top: 30px; padding-bottom: 30px; background: var(--background);\n\">\n        <div id=\"suggestionHeader\" class=\"sectio