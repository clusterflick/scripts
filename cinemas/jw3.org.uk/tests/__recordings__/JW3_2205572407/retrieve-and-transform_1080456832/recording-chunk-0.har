      <a href=\"https://www.linkedin.com/company/jcc-for-london/\" target=\"_blank\" class=\"socials__link\">\n                        <span class='peppered-icon icon-linkedin' aria-hidden='true'><svg version='1.1' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' x='0px' y='0px' width='40' height='40' viewBox='0 0 20 20' xml:space='preserve'><use xlink:href=\"/platform/images/socials.svg#linkedin\"></use></svg></span>\n                        <span class=\"screenreader\">linkedin</span>\n                    </a>\n                                    <a href=\"https://www.youtube.com/channel/UCBH2CQmx3dl7UOWdyoF7sGQ\" target=\"_blank\" class=\"socials__link\">\n                        <span class='peppered-icon icon-youtube' aria-hidden='true'><svg version='1.1' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' x='0px' y='0px' width='40' height='40' viewBox='0 0 20 20' xml:space='preserve'><use xlink:href=\"/platform/images/socials.svg#youtube\"></use></svg></span>\n                        <span class=\"screenreader\">youtube</span>\n                    </a>\n                                    </div>\n    \n    <div class=\"richtext\">\n        \n    </div>\n</div>\n\n                \n                                    </section>\n    </div>\n</div>\n\n\t\t\n\t\t\t\t<span id=\"sticky_part_7\"></span>\n\n\t\t\t\t\n\t\t\t\t\t\t\n\n\t\n\n<div id=\"postFooter\" class=\"variant-boxedLeftRight\">\n\t<div class=\"inner\">\n\t\t<section class=\"column\">\n\t\t\t\t\t\t\t&copy; JW3\n\t\t\t\t\t</section>\n\n\t\t\t\t\t<p>JW3 Trust Ltd is a registered charity, No. 1117644. | JW3 Trading Ltd, registered company No. 7686352 (England and Wales), is a wholly owned subsidiary of JW3 Trust Ltd.</p>\n\t\t\n\t\t\t\t\t<section class=\"column powered-by\">\n\t\t\t\tPowered by <a href=\"https://www.culturesuite.co/\" rel=\"external\">Peppered</a>\n\t\t\t</section>\n\t\t\t</div>\n</div>\n\n\t\n            </footer>\n        </div>\n\n\n                \n                \n\n\n\n                            <aside id=\"cookie-consent-banner\" class=\"cookieConsentBanner\" tabindex=\"0\">\n                \n<div class=\"cookieConsentForm\" data-cookie-domain=\"jw3.org.uk\">\n    <form name=\"cookieConsentOptions\">\n        <div class=\"spinner-wrapper\">\n            <div class=\"spinner\">\n\t<div class=\"rect1\"></div>\n\t<div class=\"rect2\"></div>\n\t<div class=\"rect3\"></div>\n\t<div class=\"rect4\"></div>\n\t<div class=\"rect5\"></div>\n</div>\n\n        </div>\n        <div class=\"inner\">\n            <h2>Cookies</h2>\n\n            <div class=\"content\">\n                <p>\n                                            We use cookies and similar techniques to analyze the use of the website, to make it possible to display third-party content such as videos, and for various other applications. These cookies are also placed by third parties.\n                    \n                                            <a class=\"more-link\" href=\"#more-cookiebanner\">More information&hellip;</a>\n                                    </p>\n                                    <div class=\"more\" id=\"more-cookiebanner\">\n                        <h3>Functional cookies</h3> <p>These are necessary for the website to function properly. This way your basket will be remembered and you can log in on the website with your account.</p> <h3>Minimal cookies</h3> <p>This option allows cookies to enrich your experience on the website. For example, media from third parties such as videos. We also keep statistics to continuously improve the site.</p> <h3>All cookies</h3> <p>With these cookies we collect further information to carry out our marketing activities, such as newsletters and advertisements, in the most efficient and personal way.</p>\n                    </div>\n                            </div>\n            <fieldset class=\"buttons\">\n                <ul>\n                    <li>\n                        <button type=\"button\" name=\"cookieConsentLevel\" value=\"default\" class=\"btn btn-reject\">\n                            Only functional cookies\n                        </button>\n                    </li>\n                    <li>\n                        <button type=\"button\" name=\"cookieConsentLevel\" value=\"limited\" class=\"btn btn-accept-limited\">\n                            Minimal cookies\n                        </button>\n                    </li>\n                    <li>\n                        <button type=\"button\" name=\"cookieConsentLevel\" value=\"all\" class=\"btn btn-accept-all\">\n                            All cookies\n                        </button>\n                    </li>\n                </ul>\n            </fieldset>\n        </div>\n    </form>\n</div>\n\n            </aside>\n        \n                                <div data-controller=\"modal\" data-action=\"modal:open@window->modal#open\" data-modal-id-value=\"waitinglistModal\">\n        <dialog id=\"waitinglistModal\" class=\"generic-modal waitinglist\" data-modal-target=\"modal\"  data-action=\"click-&gt;modal#closeOnBackdropClick\" id=\"waitinglistModal\" class=\"waitinglist\" title=\"Put me on the waiting list\">\n        <header class=\"generic-modal__header\">\n                            <h2 class=\"generic-modal__title\">Put me on the waiting list</h2>\n                        <button id=\"close\" type=\"button\" class=\"generic-modal__close-button\" aria-label=\"Close\" data-action=\"click->modal#close\" autofocus>\n                <div class='close-cross'><span class='screenreader'>Close</span><span class='icon'><span class='bar'></span><span class='bar'></span><span class='bar'></span></span></div></span>\n            </button>\n        </header>\n        <div class=\"generic-modal__content\">\n                    <div\n            class=\"waiting-list-modal\"\n            data-controller=\"waiting-list notifications\"\n            data-waiting-list-endpoint-value=\"/waitinglist/popup\"\n            data-action=\"waiting-list-button:addEvent@window->waiting-list#handleAddEvent modal:close@window->waiting-list#abort\"\n        >\n            <div class=\"waiting-list-modal__spinner\">\n                <div  class=\"spinner\">\n\t<div class=\"rect1\"></div>\n\t<div class=\"rect2\"></div>\n\t<div class=\"rect3\"></div>\n\t<div class=\"rect4\"></div>\n\t<div class=\"rect5\"></div>\n</div>\n\n            </div>\n            <div class=\"waiting-list-modal__container\">\n                <div data-waiting-list-target=\"placeholder\"></div>\n\n                <div id=\"notifications\"  class=\"notifications-wrapper waiting-list-modal__notifications\" data-controller=\"notifications\">\n                                                        \n        <div role=\"alert\" class=\"notification notification--success hidden\">\n            <span class='peppered-icon icon-success' aria-hidden='true'><svg version='1.1' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' x='0px' y='0px' width='20' height='20' viewBox='0 0 20 20' xml:space='preserve'><g transform='matrix(1,0,0,1,-189,9231)'><path style='fill: currentColor; fill-rule:nonzero;' d='M199,-9211C193.516,-9211.01 189.006,-9215.52 189,-9221C189.007,-9226.48 193.517,-9230.99 199,-9231C204.484,-9230.99 208.994,-9226.48 209,-9221C208.995,-9215.52 204.484,-9211.01 199,-9211ZM194.109,-9222.54C193.874,-9222.55 193.647,-9222.45 193.488,-9222.28L192.244,-9221.04C192.083,-9220.87 191.994,-9220.65 191.998,-9220.42C191.996,-9220.18 192.084,-9219.96 192.244,-9219.79L196.792,-9215.24C196.958,-9215.08 197.183,-9214.99 197.415,-9215C197.646,-9214.99 197.871,-9215.08 198.036,-9215.24L205.887,-9223.1C206.048,-9223.26 206.137,-9223.49 206.133,-9223.72C206.139,-9223.95 206.05,-9224.18 205.887,-9224.34L204.643,-9225.58C204.485,-9225.76 204.257,-9225.85 204.022,-9225.85C203.787,-9225.85 203.559,-9225.76 203.401,-9225.58L197.415,-9219.6L194.732,-9222.28C194.572,-92