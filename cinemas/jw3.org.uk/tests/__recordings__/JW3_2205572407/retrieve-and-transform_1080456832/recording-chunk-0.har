            "mimeType": "application/json",
            "text": "{\n  \"description\": \"At a moment of extraordinary musical achievement, jazz pianist Bill Evans is devastated by the death of his bassist, Scott LaFaro. Retreating from performance, he struggles with grief, addiction and the demands of family life. Grant Gee's intimate drama follows a musician searching for a way back to himself—and to the music that has defined him.\",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 102,\n  \"imageUrl\": \"\",\n  \"isOnSale\": true,\n  \"name\": \"Babykino: Everybody Digs Bill Evans\",\n  \"instanceDates\": \"19 October-19 October\",\n  \"thumbnailUrl\": \"\",\n  \"webUrl\": \"\",\n  \"webEventId\": null,\n  \"id\": \"664201APCJMJPRTBHJTPGSNHMHQPTDRMH\",\n  \"firstInstanceDateTime\": \"2026-10-19T11:00:00\",\n  \"firstInstanceDateTimeUtc\": \"2026-10-19T10:00:00Z\",\n  \"lastInstanceDateTime\": \"2026-10-19T11:00:00\",\n  \"lastInstanceDateTimeUtc\": \"2026-10-19T10:00:00Z\",\n  \"altText\": \"\",\n  \"attribute_CinemaMembershipExclusion\": false,\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"4401APLLPBSHLDJVTLGBDQTQBHJDJSHCM\",\n      \"priceList\": {\n        \"id\": \"148802AKTKTJGVTJVDRDBTJLHNRDTSPJP\"\n      },\n      \"event\": {\n        \"id\": \"664201APCJMJPRTBHJTPGSNHMHQPTDRMH\"\n      },\n      \"start\": \"2026-10-19T11:00:00\",\n      \"startUtc\": \"2026-10-19T10:00:00\",\n      \"startSellingAtWeb\": \"2026-09-18T11:41:00\",\n      \"startSellingAtWebUtc\": \"2026-09-18T10:41:00Z\",\n      \"stopSellingAtWeb\": \"2026-10-19T11:00:00\",\n      \"stopSellingAtWebUtc\": \"2026-10-19T10:00:00Z\",\n      \"webInstanceId\": null,\n      \"cancelled\": false,\n      \"id\": \"1154401AKHL