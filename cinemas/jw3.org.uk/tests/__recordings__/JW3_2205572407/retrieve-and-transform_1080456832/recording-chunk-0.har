          "content": {
            "mimeType": "application/json",
            "text": "{\n  \"description\": \"Joe and Angela's marriage is on thin ice. When they invite their enigmatic upstairs neighbors for a dinner party, the night spirals into unexpected places. Have they reignited the spark or lit the match that burns it all down? Duration: 107 minutes Rating: 15 Director: Olivia Wilde Cast: Seth Rogan, Olivia Wilde, Edward Norton, Penélope Cruz Year: 2026 https://www.youtube.com/watch?v=7YIHRhRMn94&pp=ygUVdGhlIGludml0ZSB1ayB0cmFpbGVy\",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 107,\n  \"imageUrl\": \"\",\n  \"isOnSale\": true,\n  \"name\": \"Babykino: The Invite\",\n  \"instanceDates\": \"20 July-20 July\",\n  \"thumbnailUrl\": \"\",\n  \"webEventId\": null,\n  \"id\": \"641401ATJJDJLHMPNNPCLBJHCSKLJMLQV\",\n  \"firstInstanceDateTime\": \"2026-07-20T11:00:00\",\n  \"firstInstanceDateTimeUtc\": \"2026-07-20T10:00:00Z\",\n  \"lastInstanceDateTime\": \"2026-07-20T11:00:00\",\n  \"lastInstanceDateTimeUtc\": \"2026-07-20T10:00:00Z\",\n  \"altText\": \"\",\n  \"attribute_CinemaMembershipExclusion\": false,\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"4401APLLPBSHLDJVTLGBDQTQBHJDJSHCM\",\n      \"priceList\": {\n        \"id\": \"148802AKTKTJGVTJVDRDBTJLHNRDTSPJP\"\n      },\n      \"event\": {\n        \"id\": \"641401ATJJDJLHMPNNPCLBJHCSKLJMLQV\"\n      },\n      \"start\": \"2026-07-20T11:00:00\",\n      \"startUtc\": \"2026-07-20T10:00:00\",\n      \"startSellingAtWeb\": \"2026-06-25T11:14:00\",\n      \"startSellingAtWebUtc\": \"2026-06-25T10:14:00Z\",\n      \"stopSellingAtWeb\": \"2026-07-20T11:00:00\",\n      \"stopSellingAtWebUtc\": \"2026-07-20T10:00:00Z\",\n      \"webInstanceId\": null,\n      \"can