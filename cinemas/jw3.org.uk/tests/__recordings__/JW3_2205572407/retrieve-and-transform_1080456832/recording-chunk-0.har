        <section class=\"column\">\n                            <div><p><a href=\"https://www.jw3.org.uk/our-policies-zpj4\">Our Policies</a> | <a href=\"https://www.jw3.org.uk/jobs-at-jw3-5xnz\">Jobs</a> | <a href=\"https://www.jw3.org.uk/accessibility-fmq7\">Accessibility</a> | <a href=\"https://www.jw3.org.uk/press-8jzs\">Press</a> | <a href=\"https://www.jw3.org.uk/contact-us-12br\">Contact Us</a></p>\r\n<p>JW3, 341-351 Finchley Road,<br>London, NW3 6ET</p></div>\n            </section>\n\n        \n\n        <section class=\"column\">\n                            <div class=\"socials\">\n            <h2>Follow us</h2>\n    \n            <div class=\"socials__wrapper\">\n                            \n                                    <a href=\"https://www.facebook.com/JW3London\" target=\"_blank\" class=\"socials__link\">\n                        <span class='peppered-icon icon-facebook' aria-hidden='true'><svg version='1.1' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' x='0px' y='0px' width='40' height='40' viewBox='0 0 20 20' xml:space='preserve'><use xlink:href=\"/platform/images/socials.svg#facebook\"></use></svg></span>\n                        <span class=\"screenreader\">facebook</span>\n                    </a>\n                                    <a href=\"https://www.instagram.com/jw3london\" target=\"_blank\" class=\"socials__link\">\n                        <span class='peppered-icon icon-instagram' aria-hidden='true'><svg version='1.1' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' x='0px' y='0px' width='40' height='40' viewBox='0 0 20 20' xml:space='preserve'><use xlink:href=\"/platform/images/socials.svg#instagram\"></use></svg></span>\n                        <span class=\"screenreader\">instagram</span>\n                    </a>\n                                    <a href=\"https://www.linkedin.com/company/jcc-for-london/\" target=\"_blank\" class=\"socials__link\">\n             