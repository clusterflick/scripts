            "mimeType": "application/json",
            "text": "{\n  \"description\": \"No one knows his real name; he is only known as Mr. Shoshani. He was an eternal nomad, a mad genius, who attracted disciples such as Nobel Prize winner Elie Wiesel. Mr. Shoshani figures among the 10 most mysterious people of all time.\",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 88,\n  \"imageUrl\": \"\",\n  \"isOnSale\": true,\n  \"name\": \"The Shoshani Riddle\",\n  \"instanceDates\": \"22 September-6 October\",\n  \"thumbnailUrl\": \"\",\n  \"webUrl\": \"\",\n  \"webEventId\": null,\n  \"id\": \"661403ANPRKSLPLKMGLJGNLNGSLNRHCQV\",\n  \"firstInstanceDateTime\": \"2026-09-22T13:15:00\",\n  \"firstInstanceDateTimeUtc\": \"2026-09-22T12:15:00Z\",\n  \"lastInstanceDateTime\": \"2026-10-06T19:30:00\",\n  \"lastInstanceDateTimeUtc\": \"2026-10-06T18:30:00Z\",\n  \"altText\": \"\",\n  \"attribute_CinemaMembershipExclusion\": false,\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"4401APLLPBSHLDJVTLGBDQTQBHJDJSHCM\",\n      \"priceList\": {\n        \"id\": \"149401ALSPNQKBLRBDJBKVKJLTNBBJLMB\"\n      },\n      \"event\": {\n        \"id\": \"661403ANPRKSLPLKMGLJGNLNGSLNRHCQV\"\n      },\n      \"start\": \"2026-09-30T17:30:00\",\n      \"startUtc\": \"2026-09-30T16:30:00\",\n      \"startSellingAtWeb\": \"2026-08-21T15:08:00\",\n      \"startSellingAtWebUtc\": \"2026-08-21T14:08:00Z\",\n      \"stopSellingAtWeb\": \"2026-09-30T17:30:00\",\n      \"stopSellingAtWebUtc\": \"2026-09-30T16:30:00Z\",\n      \"webInstanceId\": null,\n      \"cancelled\": false,\n      \"id\": \"1145204ATBRCBHTCQVGSGVHKQLCPPGBBS\",\n      \"hasBestAvailableOverlay\": false,\n      \"attribute_ASSupplementaryEvent\": false,\n      \"a