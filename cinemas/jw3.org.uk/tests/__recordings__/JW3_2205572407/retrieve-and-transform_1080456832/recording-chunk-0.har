347222,0,1.11111)'><path d='M528.12,301.319l47.273,-208c3.413,-15.018 -8.002,-29.319 -23.403,-29.319l-392.782,0l-9.166,-44.81c-2.284,-11.169 -12.112,-19.19 -23.513,-19.19l-102.529,0c-13.255,0 -24,10.745 -24,24l0,16c0,13.255 10.745,24 24,24l69.883,0l70.248,343.435c-16.806,9.665 -28.131,27.787 -28.131,48.565c0,30.928 25.072,56 56,56c30.928,0 56,-25.072 56,-56c0,-15.674 -6.447,-29.835 -16.824,-40l209.647,0c-10.376,10.165 -16.823,24.326 -16.823,40c0,30.928 25.072,56 56,56c30.928,0 56,-25.072 56,-56c0,-22.172 -12.888,-41.332 -31.579,-50.405l5.517,-24.276c3.413,-15.018 -8.002,-29.319 -23.403,-29.319l-268.418,0l-6.545,-32l293.145,0c11.206,0 20.92,-7.754 23.403,-18.681Z'/></g></svg></span>\n                    <span class='label'><span class='label'><span class=\"movie-time-start\">6:45 PM</span><span class='screenreader'>Tickets</span></span></span>\n                </a>\n\n            </div>\n</li>\n\n        \n        \n                    <li class=\"subshow type-info cost-message\">\n                <p>A booking fee of £2 and a security levy of £1.50 will be added to all orders. </p>\n            </li>\n        \n                    </ul>\n\n\n                    </div>\n                </div>\n            </div>\n        \n    </div>\n</div>\n\n\t\t\n\t\t\t\t<span id=\"page_part_2\"></span>\n\n\t\t\t\t\n\t\t\t\t\n    <div class=\"container-fluid teaserWrapper variant- align-\" style=\"padding-top: 60px; padding-bottom: 60px; background: var(--background2);\n\">\n\n        \n\n        <div class=\"container\">\n                    <div class=\"richtext\">\n            <p>A comic tale about the agony of a young Jewish boy whose bar mitzvah is scheduled for the day of the 1966 World Cup final at Wembley.&nbsp;</p>\n        </div>\n    \n        </div>\n\n        \n\n    </div>\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_3\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_4\"></span>\n\n\t\t\t\t\n\t\t\t\t\n                                            \n                        \n\n    \n<div class=\"container-fluid desc1Wrapper align- has-meta-info \" style=\"padding-top: 30px; padding-bottom: 30px; background: var(--background);\n\">\n    <div class=\"container\">\n                    <div class=\"desc1\">\n                <div class=\"richtext\"><p>Bernie Rubens has been gleefully looking forward to the big day throughout his childhood, but when England book their place in the final against West Germany, will his friends and family be able to resist World Cup fever and make it to the celebration?&nbsp;</p></div>\n            </div>\n        \n                    <div class=\"metaWrapper\">\n                <div class=\"inner\">\n                                                                                                                                                <img class=\"poster\" src=\"https://img.jw3.org.uk/XQARqFKzQcjld4mAHCk8rRRR8cYy4QLJ_e_YW3AGNG8/rs:fit:1920:800:1/aHR0cHM6Ly93d3cuanczLm9yZy51ay8vY21zX2ZpbGVzL3N5c3RlbS9pbWFnZXMvaW1nMDgyNF9vcmlnLmpwZw\" alt=\"Sixty Six\">\n                    \n                                            <div class=\"infoList\">\n                            <dl>\n                                                                    <dt>Direction</dt>\n                                    <dd>Paul Weiland</dd>\n                                                                                                    <dt>Cast</dt>\n                                    <dd>Helena Bonham Carter, Eddie Marsan, Gregg Sulkin</dd>\n                                                                                                    <dt>Duration</dt>\n                                    <dd>93 min</dd>\n                                                                                                                                    <dt>Year</dt>\n                                    <dd>2006</dd>\n                                                                                                                                                            </dl>\n\n                            \n                        </div>\n                    \n                    \n                    \n                                                                <div class=\"partof\">\n                                                                                        Part of<br>\n                                                        <ul>\n                                                                    <li>\n                                                                                                                        <a href=\"/theme/coming-of-age-film-season-bcdv\">\n                                            <span class='peppered-icon icon-arrow-right' aria-hidden='true'><svg version='1.1' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' x='0px' y='0px' width='20' height='20' viewBox='0 0 20 20' xml:space='preserve'><g transform='matrix(1,0,0,1,-220.399,9319.24)'><path style='fill: currentColor; fill-rule:nonzero;' d='M232.035,-9304.29C231.651,-9304.68 231.651,-9305.31 232.035,-9305.7L234.572,-9308.24L225.4,-9308.24C224.851,-9308.24 224.4,-9308.69 224.4,-9309.24C224.4,-9309.79 224.851,-9310.24 225.4,-9310.24L234.578,-9310.24L232.043,-9312.77C231.657,-9313.16 231.657,-9313.8 232.043,-9314.19C232.431,-9314.57 233.068,-9314.57 233.456,-9314.19L237.694,-9309.94C238.082,-9309.56 238.082,-9308.92 237.694,-9308.53L233.451,-9304.29C233.263,-9304.1 233.008,-9303.99 232.742,-9303.99C232.476,-9304 232.221,-9304.1 232.035,-9304.29Z'/></g></svg></span>\n                                            Coming of Age Film Season\n                                        </a>\n                                    </li>\n                                                            </ul>\n                        </div>\n                    \n\n                                        \n\n                                                     