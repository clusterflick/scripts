 Director Q&A</h1>\n                            <div class=\"subtitle\">Director Marc Isaac and writer Adam Ganz with Linda Marric</div>\n\n                            \n                                                            <div class=\"top-date\">\n                                                                        \n\n\n\n        <span class=\"start\">\n        Wed 22 Jul\n    </span>\n            <span class=\"time\">\n            \n            7:00 PM\n\n                                                -\n                    9:00 PM\n                                    </span>\n    \n\n\n                                </div>\n                            \n                                                                                                                                        \n\n                                                                                                \n                            \n                                                    </div>\n\n                        <div class=\"meta\">\n                                                            \n<ul class=\" genres \" data-genres-target=\"genresList\">\n            <li class=\"genres__item\" data-genres-target=\"genreItem\">\n            <a class=\"genres__link\" href=\"/whats-on/cinema\">Cinema</a>\n        </li>\n    </ul>\n                            \n                                                            \n                            \n                                                                                                                                                                                                                                    <div class=\"wishlist\">\n                                                                                                            \n                                                                                                    </div>\n                                                <div class=\"price\">\n                                                                                                            \n                                                                                                    </div>\n                                                                                                                                                                                    \n                            \n                                                                                                                                        <div class=\"buttonContainer\">\n                                            \n                                            \n                <a class='btn btn-active btn-order status-normaal'\n                    href='/spektrix/ChooseSeats?EventInstanceId=1113001AQSMVTLPHKHCNCMJNQPKDCSSRP'\n                    rel='external'>\n                    <span class='peppered-icon icon-cart' aria-hidden='true'><svg version='1.1' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' x='0px' y='0px' width='20' height='20' viewBox='0 0 20 20' xml:space='preserve'><g transform='matrix(0.0347222,0,0,0.0347222,0,1.11111)'><path d='M528.12,301.319l47.273,-208c3.413,-15.018 -8.002,-29.319 -23.403,-29.319l-392.782,0l-9.166,-44.81c-2.284,-11.169 -12.112,-19.19 -23.513,-19.19l-102.529,0c-13.255,0 -24,10.745 -24,24l0,16c0,13.255 10.745,24 24,24l69.883,0l70.248,343.435c-16.806,9.665 -28.131,27.787 -28.131,48.565c0,30.928 25.072,56 56,56c30.928,0 56,-25.072 56,-56c0,-15.674 -6.447,-29.835 -16.824,-40l209.647,0c-10.376,10.165 -16.823,24.326 -16.823,40c0,30.928 25.072,56 56,56c30.928,0 56,-25.072 56,-56c0,-22.172 -12.888,-41.332 -31.579,-50.405l5.517,-24.276c3.413,-15.018 -8.002,-29.319 -23.403,-29.319l-268.418,0l-6.545,-32l293.145,0c11.206,0 20.92,-7.754 23.403,-18.681Z'/></g></svg></span>\n                    <span class='label'><span class='label'>Tickets</span></span>\n                </a>\n\n                                        </div>\n                                                                                                                        </div>\n                    </div>\n                </div>\n\n                                    <div class=\"column dateContainer\">\n\n                                                                                                                        \n                                                                            \n\n\n\n<div class=\"datetime\">\n        <div class=\"date\">\n        <div class=\"start\">\n            Wed 22 Jul\n        </div>\n    </div>\n            <div class=\"time\">\n            <span class=\"start\">\n                7:00 PM\n            </span>\n\n                                            <span class=\"separator\">\n                    -\n                </span>\n                <span class=\"end\">\n                    9:00 PM\n                </span>\n                    </div>\n    \n\n</div>\n\n\n                                                                            \n                                    \n                <a class='btn btn-active btn-order status-normaal'\n                    href='/spektrix/ChooseSeats?EventInstanceId=1113001AQSMVTLPHKHCNCMJNQPKDCSSRP'\n                    rel='external'>\n                    <span class='peppered-icon icon-cart' aria-hidden='true'><svg version='1.1' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' x='0px' y='0px' width='20' height='20' viewBox='0 0 20 20' xml:space='preserve'><g transform='matrix(0.0347222,0,0,0.0347222,0,1.11111)'><path d='M528.12,301.319l47.273,-208c3.413,-15.018 -8.002,-29.319 -23.403,-29.319l-392.782,0l-9.166,-44.81c-2.284,-11.169 -12.112,-19.19 -23.513,-19.19l-102.529,0c-13.255,0 -24,10.745 -24,24l0,16c0,13.255 10.745,24 24,24l69.883,0l70.248,343.435c-16.806,9.665 -28.131,27.787 -28.131,48.565c0,30.928 25.072,56 56,56c30.928,0 56,-25.072 56,-56c0,-15.674 -6.447,-29.835 -16.824,-40l209.647,0c-10.376,10.165 -16.823,24.326 -16.823,40c0,30.928 25.072,56 56,56c30.928,0 56,-25.072 56,-56c0,-22.172 -12.888,-41.332 -31.579,-50.405l5.517,-24.276c3.413,-15.018 -8.002,-29.319 -23.403,-29.319l-268.418,0l-6.545,-32l293.145,0c11.206,0 20.92,-7.754 23.403,-18.681Z'/></g></svg></span>\n                    <span class='label'><span class='label'>Tickets</span></span>\n                </a>\n\n                                                            \n                                            </div>\n                            </div>\n        </div>\n        \n                                \n            <div>\n                <div id=\"show432Dates\" class=\"subshows \" >\n                    <div class=\"foldout movie\">\n                            <ul>\n        <li class=\"subshow type-info cost-message\">\n            <p>A booking fee of £2 and a security levy of £1.50 will be added to all orders. </p>\n        </li>\n    </ul>\n\n                    </div>\n                </div>\n            </div>\n        \n    </div>\n</div>\n\n\t\t\n\t\t\t\t<span id=\"page_part_2\"></span>\n\n\t\t\t\t\n\t\t\t\t\n    <div class=\"container-fluid teaserWrapper variant- align-\" style=\"padding-top: 60px; padding-bottom: 60px; background: var(--background2);\n\">\n\n        \n\n        <div class=\"container\">\n                    <div class=\"richtext\">\n            <p>Marc Isaacs (The Filmmaker&rsquo;s House) makes a deal with The Synthetic Sincerity Lab, an AI research project affiliated with the University of Southern England.&nbsp;</p>\n        </div>\n    \n        </div>\n\n        \n\n    </div>\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_3\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_4\"></span>\n\n\t\t\t\t\n\t\t\t\t\n                                            \n                        \n\n    \n<div class=\"container-fluid desc1Wrapper align- has-meta-info \" style=\"padding-top: 30px; padding-bottom: 30px; background: var(--background);\n\">\n    <div class=\"container\">\n                    <div class=\"desc1\">\n                <div class=\"richtext\"><p>There, researchers are investigating the possibility of teaching AI characters authenticity, using characters from Isaacs&rsquo; documentaries to do so. In return, they allow Isaacs to film the process.</p>\n<p>An AI avatar, created in collaboration with Romanian actress Illinca Manolache (seen in Do Not Expect Too Much from the End of the World by Radu Jude) guides him through this complex research world and sternly instructs him how to behave there.</p>\n<p>Isaacs films the work of the rebellious AI researcher Lynn, and follows an Uyghur chef who puts himself forward as a subject of study. Can this chef, in AI form, put into words what he is unable to express as a human being? Isaacs&rsquo; innovative narrative gradually blurs the line between fact and fiction.</p>\n<p>Synthetic Sincerity explores the relationship between humans and machines through a blend of documentary, fictional scenes, and gently absurd humor. How does the development of AI influence the way we look at human faces? And how might this technology affect cinema in the future?</p>\n<p>This screening will include a screening of director Marc Isaacs' award-winning short film <em>Lift </em>(2001), as well as a Q&amp;A with Marc Isaacs and writer Adam Ganz moderated by Linda Marric.</p></div>\n            </div>\n        \n                    <div class=\"metaWrapper\">\n                <div class=\"inner\">\n                                                                                                                                                <img class=\"poster\" src=\"https://img.jw3.org.uk/D8tQybUaM9Z4pWym7nHo51_Gtww5A-RB19C3QiERDxc/rs:fit:1920:800:1/aHR0cHM6Ly93d3cuanczLm9yZy51ay8vY21zX2ZpbGVzL3N5c3RlbS9pbWFnZXMvaW1nMTAxOV9vcmlnLmpwZw\" alt=\"Synthetic Sincerity: Preview Screening + Director Q&amp;A\">\n                    \n                                            <div class=\"infoList\">\n                            <dl>\n                                                                    <dt>Direction</dt>\n                                    <dd>Marc Isaacs</dd>\n                                                                                                                                    <dt>Duration</dt>\n                                    <dd>120 min</dd>\n                                                                                                                                                                                                                            </dl>\n\n                            \n                        </div>\n                    \n                    \n                                            <div class=\"extraInfo\">\n                            <p>&pound;16.50</p>\n                        </div>\n                    \n                                        \n\n                                        \n\n                                                        </div>\n            </div>\n            </div>\n</div>\n\n\t\t\n\t\t\t\t<span id=\"page_part_161\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\t\t\n\t\t\t\t<span id=\"page_part_7\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_5\"></span>\n\n\t\t\t\t\n\t\t\t\t    \n    \n\t\t\n\t\t\t\t<span id=\"page_part_90\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_9\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t\t<span id=\"page_part_226\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t\t<span id=\"page_part_227\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t\t<span id=\"page_part_10\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_8\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_223\"></span>\n\n\t\t\t\t\n\t\t\t\t    \n\n\t\t\n\t\t\t\t<span id=\"page_part_114\"></span>\n\n\t\t\t\t\n\t\t\t\t    \n\n\n