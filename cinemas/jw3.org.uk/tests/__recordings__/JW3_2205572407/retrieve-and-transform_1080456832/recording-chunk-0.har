            "mimeType": "application/json",
            "text": "{\n  \"description\": \"Ed Saxberger is a forgotten New York poet working at the post office when a young admirer unexpectedly turns up at his door. Welcomed into a circle of twentysomething writers who regard him as a rediscovered genius, Ed finds himself intoxicated by the attention — and by the enigmatic Gloria — before beginning to question the authenticity of his new literary world.\",\n  \"htmlDescription\": \"<div id>\\r\\n\\r\\n</div>\",\n  \"duration\": 90,\n  \"imageUrl\": \"\",\n  \"isOnSale\": true,\n  \"name\": \"Late Fame\",\n  \"instanceDates\": \"22 September-1 October\",\n  \"thumbnailUrl\": \"\",\n  \"webUrl\": \"\",\n  \"webEventId\": null,\n  \"id\": \"661401ABTGMNNCRRKNLNLGRDSNJTCSMHQ\",\n  \"firstInstanceDateTime\": \"2026-09-22T11:00:00\",\n  \"firstInstanceDateTimeUtc\": \"2026-09-22T10:00:00Z\",\n  \"lastInstanceDateTime\": \"2026-10-01T11:00:00\",\n  \"lastInstanceDateTimeUtc\": \"2026-10-01T10:00:00Z\",\n  \"altText\": \"\",\n  \"attribute_CinemaMembershipExclusion\": false,\n  \"attribute_Genre\": \"Cinema\",\n  \"attribute_Language\": \"\",\n  \"attribute_TessituraId\": \"\",\n  \"attribute_SeriesOrFestival\": \"\",\n  \"attribute_GatedEventFree\": \"\",\n  \"attribute_SeriesBooking\": \"\",\n  \"attribute_TeacherOrLecturer\": \"\",\n  \"instances\": [\n    {\n      \"isOnSale\": true,\n      \"planId\": \"4401APLLPBSHLDJVTLGBDQTQBHJDJSHCM\",\n      \"priceList\": {\n        \"id\": \"148802AKTKTJGVTJVDRDBTJLHNRDTSPJP\"\n      },\n      \"event\": {\n        \"id\": \"661401ABTGMNNCRRKNLNLGRDSNJTCSMHQ\"\n      },\n      \"start\": \"2026-10-01T11:00:00\",\n      \"startUtc\": \"2026-10-01T10:00:00\",\n      \"startSellingAtWeb\": \"2026-08-21T15:02:00\",\n      \"startSellingAtWebUtc\": \"2026-08-21T14:02:00Z\",\n      \"stopSellingAtWeb\": \"2026-10-01T11:00:00\",\n      \"stopSellingAtWebUtc\": \"2026-10-01T10:00:00Z\",\n      \"webInstanceId\": null,\n      \"cancelled\": false,\n      \"id\": \"1158401APTVCDDNPTR