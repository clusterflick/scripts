326 -16.823,40c0,30.928 25.072,56 56,56c30.928,0 56,-25.072 56,-56c0,-22.172 -12.888,-41.332 -31.579,-50.405l5.517,-24.276c3.413,-15.018 -8.002,-29.319 -23.403,-29.319l-268.418,0l-6.545,-32l293.145,0c11.206,0 20.92,-7.754 23.403,-18.681Z'/></g></svg></span>\n                    <span class='label'><span class='label'>Tickets</span></span>\n                </a>\n\n                                                            \n                                            </div>\n                            </div>\n        </div>\n        \n                                \n            <div>\n                <div id=\"show416Dates\" class=\"subshows \" >\n                    <div class=\"foldout movie\">\n                            <ul>\n        <li class=\"subshow type-info cost-message\">\n            <p>A booking fee of £2 and a security levy of £1.50 will be added to all orders. </p>\n        </li>\n    </ul>\n\n                    </div>\n                </div>\n            </div>\n        \n    </div>\n</div>\n\n\t\t\n\t\t\t\t<span id=\"page_part_2\"></span>\n\n\t\t\t\t\n\t\t\t\t\n    <div class=\"container-fluid teaserWrapper variant- align-\" style=\"padding-top: 60px; padding-bottom: 60px; background: var(--background2);\n\">\n\n        \n\n        <div class=\"container\">\n                    <div class=\"richtext\">\n            <p>How to Live on Earth is a visionary feature documentary that explores our vital connection to nature and its role in our future.</p>\n        </div>\n    \n        </div>\n\n        \n\n    </div>\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_3\"></span>\n\n\t\t\t\t\n\t\t\t\t\n    <div class=\"container-fluid videoWrapper variant- align-\" style=\"padding-top: 30px; padding-bottom: 30px; background: var(--background);\n\">\n\n        \n\n        <div class=\"container\">\n                                \n    <aside  class=\"cookieConsentPlaceholder\">\n        <div class=\"cookieConsentForm\" data-cookie-domain=\"jw3.org.uk\">\n            <form name=\"cookieConsentOptions\">\n                <div class=\"spinner-wrapper\">\n                    <div class=\"spinner\">\n\t<div class=\"rect1\"></div>\n\t<div class=\"rect2\"></div>\n\t<div class=\"rect3\"></div>\n\t<div class=\"rect4\"></div>\n\t<div class=\"rect5\"></div>\n</div>\n\n                </div>\n                <div class=\"inner\">\n                    <h2>Cookies</h2>\n\n                    <div class=\"content\">\n                        <p>\n                                                            We use services such as Youtube and Vimeo for videos and other media. To view this, you have to give permission to place cookies.\n                            \n                                                            <a class=\"more-link\" href=\"#more-page_part_3\">More information&hellip;</a>\n                                                    </p>\n                                                    <div class=\"more\" id=\"more-page_part_3\">\n                                <h3>Functional cookies</h3> <p>These are necessary for the website to function properly. This way your basket will be remembered and you can log in on the website with your account.</p> <h3>Minimal cookies</h3> <p>This option allows cookies to enrich your experience on the website. For example, media from third parties such as videos. We also keep statistics to continuously improve the site.</p> <h3>All cookies</h3> <p>With these cookies we collect further information to carry out our marketing activities, such as newsletters and advertisements, in the most efficient and personal way.</p>\n                            </div>\n                                            </div>\n                    <fieldset class=\"buttons\">\n                        <ul>\n                            <li>\n                                <button type=\"button\" name=\"cookieConsentLevel\" value=\"default\" class=\"btn btn-reject\">\n                                    Only functional cookies\n                                </button>\n                            </li>\n                            <li>\n                                <button type=\"button\" name=\"cookieConsentLevel\" value=\"limited\" class=\"btn btn-accept-limited\">\n                                    Minimal cookies\n                                </button>\n                            </li>\n                            <li>\n                                <button type=\"button\" name=\"cookieConsentLevel\" value=\"all\" class=\"btn btn-accept-all\">\n                                    All cookies\n                                </button>\n                            </li>\n                        </ul>\n                    </fieldset>\n                </div>\n            </form>\n        </div>\n    </aside>\n\n\n            \n        </div>\n\n        \n\n    </div>\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_4\"></span>\n\n\t\t\t\t\n\t\t\t\t\n                                            \n                        \n\n    \n<div class=\"container-fluid desc1Wrapper align- has-meta-info \" style=\"padding-top: 30px; padding-bottom: 30px; background: var(--background);\n\">\n    <div class=\"container\">\n                    <div class=\"desc1\">\n                <div class=\"richtext\"><p>How to Live on Earth is a visionary feature documentary that explores our vital connection to nature and its role in our future. Presented by Benedict Cumberbatch, this ultimate 'how-to guide' features inspirational, cutting-edge stories and powerful cinematography from around the world to reveal how humans are learning to team up with nature to solve our biggest challenges. Heart-warming, entertaining, energising, the film presents a hopeful vision of a future within reach – one in which nature thrives, and so do we.</p></div>\n            </div>\n        \n                    <div class=\"metaWrapper\">\n                <div class=\"inner\">\n                    \n                                            <div class=\"infoList\">\n                            <dl>\n                                                                    <dt>Direction</dt>\n                                    <dd>Fredi Devas</dd>\n                                                                                                    <dt>Cast</dt>\n                                    <dd>Benedict Cumberbatch, Xiye Bastida, Sam Kass</dd>\n                                                                                                    <dt>Duration</dt>\n                                    <dd>95 min</dd>\n                                                                                                                                                                                                                            </dl>\n\n                            \n                        </div>\n                    \n                    \n                                            <div class=\"extraInfo\">\n                            <p>£9 / £15</p>\n                        </div>\n                    \n                                        \n\n                                        \n\n                                                        </div>\n            </div>\n            </div>\n</div>\n\n\t\t\n\t\t\t\t<span id=\"page_part_161\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\t\t\n\t\t\t\t<span id=\"page_part_7\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_5\"></span>\n\n\t\t\t\t\n\t\t\t\t    \n    \n\t\t\n\t\t\t\t<span id=\"page_part_90\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_9\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t\t<span id=\"page_part_226\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t\t<span id=\"page_part_227\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t\t<span id=\"page_part_10\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\n\t\t\n\t\t\t\t<span id=\"page_part_8\"></span>\n\n\t\t\t\t\n\t\t\t\t\n\n\n\t\t\n\t\t\t\t<