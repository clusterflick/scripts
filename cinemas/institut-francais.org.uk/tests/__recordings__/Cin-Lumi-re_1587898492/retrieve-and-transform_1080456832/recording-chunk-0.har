iv>\n</article>\n<article class=\"card card--horizontal card--film\">\n    <a href=\"https://www.institut-francais.org.uk/cinema/the-kings-favourite-part-1-2/\" title=\"The King&#8217;s Favourite &#8211; Part 1 &amp; 2\" target=\"_blank\">\n        <div class=\"card__thumbnail\" style=\"--background: url( 'https://www.institut-francais.org.uk/app/uploads/2026/04/the-kings-favourite-460x275.jpg' );\"></div>\n    </a>\n\n    <div class=\"card__information\">\n        <div class=\"card__metadata\">\n                        <div class=\"card__terms\">\n                                <div class=\"tag\">Films</div>\n                                <div class=\"tag\">Festivals &amp; Series</div>\n                            </div>\n                                    <div class=\"card__dates\">\n                4 & 19 July            </div>\n                    </div>\n\n        <div class=\"card__content\" style=\"justify-content: space-between\">\n            <a href=\"https://www.institut-francais.org.uk/cinema/the-kings-favourite-part-1-2/\" title=\"The King&#8217;s Favourite &#8211; Part 1 &amp; 2\" target=\"_blank\">\n                <h3 class=\"card__title\">The King&#8217;s Favourite &#8211; Part 1 &amp; 2</h3>\n                <div class=\"card__text\">\n                    In the epic royal saga of the Valois-Angoulême dynasty, during the height of the Renaissance, one woman leads the way in the race for honours:&hellip;                </div>\n            </a>\n\n                    </div>\n    </div>\n</article>\n<article class=\"card card--horizontal card--film\">\n    <a href=\"https://www.institut-francais.org.uk/cinema/the-adjani-notebooks/\" title=\"The Adjani Notebooks\" target=\"_blank\">\n        <div class=\"card__thumbnail\" style=\"--background: url( 'https://www.institut-francais.org.uk/app/uploads/2026/04/the-adjani-notebooks-460x275.jpg' );\"></div>\n    </a>\n\n    <div class=\"card__information\">\n        <div class=\"card__metadata\">\n       