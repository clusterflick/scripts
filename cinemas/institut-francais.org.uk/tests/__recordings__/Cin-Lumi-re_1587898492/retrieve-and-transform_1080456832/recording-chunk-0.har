ut-francais.org.uk/festivals-and-series/isabelle-adjanis-journey-through-cinema/\" target=\"_blank\" title=\"Isabelle Adjani&#039;s Journey through Cinema\">\n\t\t                    \tIsabelle Adjani&#8217;s Journey through Cinema\t\t                    </a>\n\t\t                </div>\n\t\t                \t\t                <div class=\"tags__tag tag\">\n\t\t                \t<a href=\"https://www.institut-francais.org.uk/festivals-and-series/focus-on-the-cesar/\" target=\"_blank\" title=\"Focus on the César\">\n\t\t                    \tFocus on the César\t\t                    </a>\n\t\t                </div>\n\t\t                \t\t            </div>\n\t\t            \t\t\t\t</div>\n\n\t\t\t\t<div class=\"definition\">\n\t\t\t\t\t<div class=\"content-block rte\"><p>The Eye, a private investigator (Michel Serrault) becomes obsessed with the target of his investigation, a serial killer whom he suspects is his disappeared daughter (Isabelle Adjani). He follows her across Europe as she moves from one place and one victim to another. Switching gears to pitch black humour, this wild and surprising crime thriller, written by Michel and Jacques Audiard, features two outstanding leads alongside a remarkable supporting cast including Stéphane Audran, Macha Méril, and Guy Marchand.</p>\n<p>&nbsp;</p>\n<h5>Special discount: if you buy 3 or more tickets for films part of the César 2026 season, you’ll get a 20% discount that will apply automatically at checkout.</h5>\n<p><a class=\"button button-arrow\" href=\"https://www.institut-francais.org.uk/festivals-and-series/cesar-2026/#/\">César 2026</a></p></div>\n\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t<ul class=\"metadata\" style=\"background: #3558a2;\">\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-vidicon-2-line\"></i> Director(s): </strong>\n\t\t\t\t\t\tClaude Miller\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-team-line\"></i