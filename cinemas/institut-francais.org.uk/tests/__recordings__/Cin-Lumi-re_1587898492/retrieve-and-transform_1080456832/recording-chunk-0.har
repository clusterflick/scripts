ut-francais.org.uk/visit-contact-us/ticket-prices/\"><span>Ticket Prices</span></a></li>\n\t<li tabindex=\"0\"  class=\"menu-item menu-item-type-post_type menu-item-object-page menu-type-post_type\"><a data-page-id=\"630\"  href=\"https://www.institut-francais.org.uk/visit-contact-us/terms-conditions/\"><span>Terms &amp; Conditions</span></a></li>\n\t<li tabindex=\"0\"  class=\"menu-item menu-item-type-post_type menu-item-object-page menu-type-post_type\"><a data-page-id=\"43737\"  href=\"https://www.institut-francais.org.uk/visit-contact-us/cookies-policy/\"><span>Privacy &amp; Cookies Policy</span></a></li>\n\t<li tabindex=\"0\"  class=\"menu-item menu-item-type-post_type menu-item-object-page menu-type-post_type\"><a data-page-id=\"632\"  href=\"https://www.institut-francais.org.uk/visit-contact-us/faq/\"><span>FAQ</span></a></li>\n</ul>\n</li>\n        </ul>\n            </div>\n    </nav></header>        <main id=\"site-main\">\n<div class=\"film\">\n\t<section class=\"film-introduction\">\n\t\t<header>\n\t\t\t<section class=\"desktop leaderboard \">\n\t<div class=\"overlay\" aria-hidden=\"true\"></div>\n\t\t<div class=\"slide active position-middle-center\" style=\"--background: url('https://www.institut-francais.org.uk/app/uploads/2026/06/linda-linda-linda.jpg')\">\n\t\t\t\t\t</div>\n\t\t</section><section class=\"mobile leaderboard \">\n\t<div class=\"overlay\" aria-hidden=\"true\"></div>\n\t\t<div class=\"slide  active\">\n\t\t\n\t\t<div class=\"slide__illustration slide__illustration--mobile  position-middle-center\" style=\"--background: url('https://www.institut-francais.org.uk/app/uploads/2026/06/linda-linda-linda.jpg')\">\n\t\t\t\t\t</div>\n\n\t\t\n\t\t\n\t\t\t</div>\n\t\t</section>\n\t\t\t<div class=\"page-context\">\n\t\t\t\t<div class=\"title-dates\">\n\t\t\t\t\t<ul class=\"breadcrumbs\">\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk\" title=\"Home\">\n                Home            </a>\n            </li>\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk/cinema/\" title=\"Films\">\n                Films            </a>\n            </li>\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk/whats-on/\" title=\"What&#8217;s On\">\n                What&#8217;s On            </a>\n            </li>\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk/cinema/\" title=\"Ciné Lumière\">\n                Ciné Lumière            </a>\n            </li>\n        <li class=\"item\">\n                    <span class=\"link current\">Linda Linda Linda</span>\n            </li>\n    </ul>\n\t\t\t\t\t<h1>Linda Linda Linda</h1>\n\n\t\t\t\t\t\t\t\t\t\t<span class=\"start\">Sat 11 Jul</span>\n\t\t\t\t\t\n\t\t            \t\t            <div class=\"tags\">\n\t\t                \t\t                <div class=\"tags__tag tag\">\n\t\t                    Films\t\t                </div>\n\t\t                \t\t                <div class=\"tags__tag tag\">\n\t\t                    Special Screenings\t\t                </div>\n\t\t                \n\t\t                \t\t            </div>\n\t\t            \t\t\t\t</div>\n\n\t\t\t\t<div class=\"definition\">\n\t\t\t\t\t<div class=\"content-block rte\"><p>For Kei, Kyoko, and Nozomi, their dream of playing the final high school concert together is dashed when their lead vocalist quits the band. Desperate, they recruit the very first person they see: Korean exchange student Son, played by Doona Bae (<em>The Host</em>, <em>Broker</em>), whose comprehension of Japanese is limited at best. It’s a race against time as the group struggles to learn three songs in three days for the festival’s rock concert.</p>\n<p>&nbsp;</p>\n<p><a class=\"booking-url button button-arrow button-primary\" href=\"https://japanesefilm.club/seat-select/?scr_film=3479&amp;scr_id=6a0c41de21a2b\">Book your ticket(s) </a></p></div>\n\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t<ul class=\"metadata\" style=\"background: #3558a2;\">\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-vidicon-2-line\"></i> Director(s): </strong>\n\t\t\t\t\t\tNobuhiro Yamashita\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-team-line\"></i> Cast: </strong>\n\t\t\t\t\t\tDoona Bae, Aki Maeda, Yû Kashii, Shiori Sekine\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-map-pin-line\"></i> Country, year: </strong>\n\t\t\t\t\t\tJapan | 2005\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-time-line\"></i> Duration: </strong>\n\t\t\t\t\t\t114 mins\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-chat-1-line\"></i> Language: </strong>\n\t\t\t\t\t\tIn Japanese with English subtitles\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-settings-line\"></i> Cert.: </strong>\n\t\t\t\t\t\t15\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t</div>\n\t\t</header>\n\t</section>\n\n\t\t<section class=\"next-showing\">\n\t\t<h2>Next Showing</h2>\n\t\t<div class=\"timetable\">\n\t\t\t<div class=\"date\">\n\t\t\t\t<time datetime=\"2026-07-11\">\n\t                Saturday 11 July\t            </time>\n\t            \t                       \t</div>\n\n\t        \t        <time class=\"time\" datetime=\"18:00\">\n\t            18:00\t        </time>\n\t    \t\t    </div>\n\t\t\n\t\t\t</section>\n\t\n\t\n\t</div>\n\n<div class='yarpp yarpp-related yarpp-related-website yarpp-template-yarpp-template-ifru'>\n\n<section class=\"related-posts\">\n    <div class=\"inner\">\n        <h2 class=\"title\">See also</h2>\n\n        <div class=\"cards__wrapper\">\n            <div class=\"cards\">\n       