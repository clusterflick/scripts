enu-item menu-item-type-post_type menu-item-object-page menu-type-post_type\"><a data-page-id=\"630\"  href=\"https://www.institut-francais.org.uk/visit-contact-us/terms-conditions/\"><span>Terms &amp; Conditions</span></a></li>\n\t<li tabindex=\"0\"  class=\"menu-item menu-item-type-post_type menu-item-object-page menu-type-post_type\"><a data-page-id=\"43737\"  href=\"https://www.institut-francais.org.uk/visit-contact-us/cookies-policy/\"><span>Privacy &amp; Cookies Policy</span></a></li>\n\t<li tabindex=\"0\"  class=\"menu-item menu-item-type-post_type menu-item-object-page menu-type-post_type\"><a data-page-id=\"632\"  href=\"https://www.institut-francais.org.uk/visit-contact-us/faq/\"><span>FAQ</span></a></li>\n</ul>\n</li>\n        </ul>\n            </div>\n    </nav></header>        <main id=\"site-main\">\n<div class=\"film\">\n\t<section class=\"film-introduction\">\n\t\t<header>\n\t\t\t<section class=\"desktop leaderboard \">\n\t<div class=\"overlay\" aria-hidden=\"true\"></div>\n\t\t<div class=\"slide active position-middle-center\" style=\"--background: url('https://www.institut-francais.org.uk/app/uploads/2026/07/just-an-illusion.jpg')\">\n\t\t\t\t\t</div>\n\t\t</section><section class=\"mobile leaderboard \">\n\t<div class=\"overlay\" aria-hidden=\"true\"></div>\n\t\t<div class=\"slide  active\">\n\t\t\n\t\t<div class=\"slide__illustration slide__illustration--mobile  position-middle-center\" style=\"--background: url('https://www.institut-francais.org.uk/app/uploads/2026/07/just-an-illusion.jpg')\">\n\t\t\t\t\t</div>\n\n\t\t\n\t\t\n\t\t\t</div>\n\t\t</section>\n\t\t\t<div class=\"page-context\">\n\t\t\t\t<div class=\"title-dates\">\n\t\t\t\t\t<ul class=\"breadcrumbs\">\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk\" title=\"Home\">\n                Home            </a>\n            </li>\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk/cinema/\" title=\"Films\">\n                Films            </a>\n            </li>\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk/whats-on/\" title=\"What&#8217;s On\">\n                What&#8217;s On            </a>\n            </li>\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk/cinema/\" title=\"Ciné Lumière\">\n                Ciné Lumière            </a>\n            </li>\n        <li class=\"item\">\n                    <span class=\"link current\">Just an Illusion</span>\n            </li>\n    </ul>\n\t\t\t\t\t<h1>Just an Illusion</h1>\n\n\t\t\t\t\t\t\t\t\t\t<span class=\"start\">From Fri 11 to Thu 24 Sep</span>\n\t\t\t\t\t\n\t\t            \t\t            <div class=\"tags\">\n\t\t                \t\t                <div class=\"tags__tag tag\">\n\t\t                    Films\t\t                </div>\n\t\t                \t\t                <div class=\"tags__tag tag\">\n\t\t                    New Releases\t\t                </div>\n\t\t                \n\t\t                \t\t            </div>\n\t\t            \t\t\t\t</div>\n\n\t\t\t\t<div class=\"definition\">\n\t\t\t\t\t<div class=\"content-block rte\"><p>A 12-year-old boy in 1985 suburban Paris navigates life between his distant older brother and quarreling parents while grappling with identity, friendship, love, and understanding why adults seem lost.</p>\n<p>&nbsp;</p>\n<p>Eric Toledano and Olivier Nakache, the duo of directors behind hit film <em>Untouchable</em> return with this comedy starring Camille Cottin, Louis Garrel and Pierre Lottin.</p></div>\n\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t<ul class=\"metadata\" style=\"background: #3558a2;\">\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-vidicon-2-line\"></i> Director(s): </strong>\n\t\t\t\t\t\tEric Toledano, Olivier Nakache\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-team-line\"></i> Cast: </strong>\n\t\t\t\t\t\tCamille Cottin, Louis Garrel, Pierre Lottin, Simon Boublil\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-film-line\"></i> Original title: </strong>\n\t\t\t\t\t\tJuste une Illusion\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-map-pin-line\"></i> Country, year: </strong>\n\t\t\t\t\t\tFrance | 2026\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-time-line\"></i> Duration: </strong>\n\t\t\t\t\t\t119 mins\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-chat-1-line\"></i> Language: </strong>\n\t\t\t\t\t\tFrench, Italian with EN subtitles\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-settings-line\"></i> Cert.: </strong>\n\t\t\t\t\t\tTBC\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t</div>\n\t\t</header>\n\t</section>\n\n\t\t<section class=\"next-showing\">\n\t\t<h2>Next Showing</h2>\n\t\t<div class=\"timetable\">\n\t\t\t<div class=\"date\">\n\t\t\t\t<time datetime=\"2026-09-11\">\n\t                Friday 11 September\t            </time>\n\t                            <span class=\"location\">Ciné Lumière</span>\n\t            \t                       \t</div>\n\n\t        \t        <time class=\"time\" datetime=\"18:00\">\n\t            18:00\t        </time>\n\t    \t\t    </div>\n\t\t\n\t\t\t    <div class=\"actions\">\n\t    \t<a href=\"https://cinelumiere.savoysystems.co.uk/CineLumiere.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_600.TcsWebTab_601.TcsPerformance_6954669.TcsSection_6930861\" rel=\"nofollow\" target=\"_blank\" title=\"Book now\" class=\"button button-arrow\">Book now</a>\n\t    \t\t    \t<a href=\"#more-dates\" title=\"Check more dates\" data-fancybox class=\"b