ustom menu-type-custom\"><a data-page-id=\"45502\"  href=\"https://www.institut-francais.org.uk/about-us/#in-figures\"><span>In Figures</span></a></li>\n\t<li tabindex=\"0\"  class=\"menu-item menu-item-type-post_type menu-item-object-page menu-type-post_type\"><a data-page-id=\"616\"  href=\"https://www.institut-francais.org.uk/about-us/team/\"><span>The Team</span></a></li>\n\t<li tabindex=\"0\"  class=\"menu-item menu-item-type-custom menu-item-object-custom menu-type-custom\"><a data-page-id=\"44414\"  href=\"https://www.institut-francais.org.uk/about-us/\"><span>The Institut français in the World</span></a></li>\n\t<li tabindex=\"0\"  class=\"menu-item menu-item-type-post_type menu-item-object-page menu-type-post_type\"><a data-page-id=\"614\"  href=\"https://www.institut-francais.org.uk/about-us/press-room/\"><span>Press Room</span></a></li>\n\t<li tabindex=\"0\"  class=\"menu-item menu-item-type-post_type menu-item-object-page menu-type-post_type\"><a data-page-id=\"618\"  href=\"https://www.institut-francais.org.uk/about-us/jobs-applications/\"><span>Jobs &amp; Applications</span></a></li>\n\t<li tabindex=\"0\"  class=\"menu-item menu-item-type-post_type menu-item-object-page menu-type-post_type\"><a data-page-id=\"620\"  href=\"https://www.institut-francais.org.uk/about-us/useful-links/\"><span>Useful Links</span></a></li>\n</ul>\n</li>\n<li tabindex=\"0\"  class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-has-children menu-type-post_type menu-variation-header\"><a data-page-id=\"624\"  href=\"https://www.institut-francais.org.uk/visit-contact-us/\"><span>Visit &#038; Contact Us</span></a><button class=\"sub-menu-toggle\" title=\"Toggle the submenu\" aria-hidden=\"true\"><span class=\"icon icon-chevron-down-regular\" aria-hidden=\"true\"></span></button>\n<ul class=\"sub-menu\">\n\t<li tabindex=\"0\"  class=\"menu-item menu-item-type-post_type menu-item-object-page menu-type-post_type\"><a data-page-id=\"624\"  href=\"https://www.institut-francais.org.uk/visit-contact-us/\"><span>Visit &#038; Contact Us</span></a></li>\n\t<li tabindex=\"0\"  class=\"menu-item menu-item-type-post_type menu-item-object-page menu-type-post_type\"><a data-page-id=\"626\"  href=\"https://www.institut-francais.org.uk/visit-contact-us/cafe-restaurant/\"><span>Gazette Brasserie</span></a></li>\n\t<li tabindex=\"0\"  class=\"menu-item menu-item-type-post_type menu-item-object-page menu-type-post_type\"><a data-page-id=\"42568\"  href=\"https://www.institut-francais.org.uk/visit-contact-us/ticket-prices/\"><span>Ticket Prices</span></a></li>\n\t<li tabindex=\"0\"  class=\"menu-item menu-item-type-post_type menu-item-object-page menu-type-post_type\"><a data-page-id=\"630\"  href=\"https://www.institut-francais.org.uk/visit-contact-us/terms-conditions/\"><span>Terms &amp; Conditions</span></a></li>\n\t<li tabindex=\"0\"  class=\"menu-item menu-item-type-post_type menu-item-object-page menu-type-post_type\"><a data-page-id=\"43737\"  href=\"https://www.institut-francais.org.uk/visit-contact-us/cookies-policy/\"><span>Privacy &amp; Cookies Policy</span></a></li>\n\t<li tabindex=\"0\"  class=\"menu-item menu-item-type-post_type menu-item-object-page menu-type-post_type\"><a data-page-id=\"632\"  href=\"https://www.institut-francais.org.uk/visit-contact-us/faq/\"><span>FAQ</span></a></li>\n</ul>\n</li>\n        </ul>\n            </div>\n    </nav></header>        <main id=\"site-main\">\n<ul class=\"breadcrumbs\">\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk\" title=\"Home\">\n                Home            </a>\n            </li>\n        <li class=\"item\">\n                    <span class=\"link current\">What's on ?</span>\n            </li>\n    </ul>\n<header class=\"page-header\">\n    <h1>What&#8217;s On</h1>\n            <section class=\"page-content\">\n  \n  <p><span style=\"color:#ff9575;font-weight:bolder\">—</span>&nbsp; Filters below are here to help you to define your search.</p>\n  \n  <p><span style=\"color:#ff9575;font-weight:bolder\">—</span>&nbsp; If you wish to have an overview of our highlights, click <a style=\"color:#3558a2;text-decoration: underline #ff9575;font-weight:bolder;\" href=\"https://www.institut-francais.org.uk/festivals-and-series/highlights-of-the-month/#/\">here</a></p><br />\n\n\n  </section>\n    \n    <div class=\"tabs\">\n        <div class=\"inner tabs__inner tabs__navigation\">\n            <a class=\"tabs__handle  tabs__handle--active\" href=\"#\" data-tab=\"events\" title=\"Toggle the events section\">\n                Events            </a>\n            <a class=\"tabs__handle \" href=\"#\" data-tab=\"festivals\" title=\"Toggle the festivals section\">\n                Festivals & series            </a>\n        </div>\n    </div>\n</header>\n\n<form method=\"post\" action=\"https://www.institut-francais.org.uk/whats-on\" id=\"whats-on-form\">\n    <div class=\"filters\">\n        <div class=\"primary\">\n            <div id=\"type-wrapper\" class=\"type-wrapper refresheable\" data-label=\"Filter by type:\">\n                <select name=\"type\" class=\"filters__filter filters__filter--type\">\n                    <option value=\"0\" >Any</option><option value=\"73\" >Arts</option><option value=\"57\" >Books &amp; Ideas</option><option value=\"74\" >Classical Music</option><option value=\"75\" >Digital &amp; New Media</option><option value=\"342\" >Education</option><optgroup label=\"Films\"> selected='selected'<option value=\"72\"  selected='selected'>Films (All)</option><option value=\"89\" >CinéFamilies</option><option value=\"87\" >Classics</option><option value=\"90\" >Festivals &amp; Series</option><option value=\"86\" >New Releases</option><option value=\"88\" >Special Screenings</option></optgroup><option value=\"76\" >French Courses</option><option value=\"341\" >French language</option><option value=\"77\" >Gigs</option><option value=\"78\" >Kids &amp; Families</option><option value=\"80\" >Performances</option><option value=\"79\" >School Activities</option><option value=\"23\" >Talks</option><option value=\"81\" >Workshops</option>                </select>\n            </div>\n            <div id=\"period-wrapper\" class=\"period-wrapper refresheable\"  data-label=\"Filter by period:\">\n                                <div class=\"filters__filter filters__filter--period\">\n                    <select name=\"period\">\n                                                <option value=\"day\" >Day</option>\n                                                <option value=\"week\" >Week</option>\n                                                <option value=\"month\" >Month</option>\n                                                <option value=\"any\"  selected='selected'>Anytime</option>\n                                            </select>\n                </div>\n\n                <span data-label=\"Pick a date:\"> </span>\n                <label for=\"whats-on-date\">\n                    <input type=\"text\" class=\"datepicker\" name=\"date-display\" id=\"whats-on-date-display\" data-alt-field=\"date\" data-date-format=\"yy-mm-dd\" data-format=\"dd/mm/yy\" value=\"\">\n                    <input type=\"hidden\" name=\"date\" id=\"whats-on-date\" value=\"\">\n                </label>\n                <input type=\"hidden\" name=\"range\" id=\"whats-on-range\" value=\"\">\n                \n                                            </div>\n            <span id=\"whats-on-current-dates\" class=\"whats-on-current-dates refresheable\"></span>\n        </div>\n        <div class=\"secondary\">\n            <div class=\"whats-on-location pills\">\n                                <div class=\"radio-option\">\n                    <input name=\"location\" value=\"onsite\" id=\"whats-on-location-onsite\" type=\"radio\"  checked='checked'>\n                    <label for=\"whats-on-location-onsite\">Onsite</label>\n                </div>\n                                <div class=\"radio-option\">\n                    <input name=\"location\" value=\"online\" id=\"whats-on-location-online\" type=\"radio\" >\n                    <label for=\"whats-on-location-online\">Online</label>\n                </div>\n                                <div class=\"radio-option\">\n                    <input name=\"location\" value=\"beyond\" id=\"whats-on-location-beyond\" type=\"radio\" >\n                    <label for=\"whats-on-location-beyond\">Beyond</label>\n                </div>\n                            </div>\n        </div>\n    </div>\n</form>\n\n<div class=\"tab tab--active\" id=\"tab-events\">\n    <div id=\"whats-on-event-list\" class=\"card-list refresheable\">\n        <article class=\"card card--horizontal card--film\">\n    <a href=\"https://www.institut-francais.org.uk/cinema/the-most-precious-of-cargoes/\" title=\"The Most Precious of Cargoes\" target=\"_blank\">\n        <div class=\"card__thumbnail\" style=\"--background: url( 'https://www.institut-francais.org.uk/app/uploads/2025/02/most-precious-of-cargoes-1-460x275.jpg' );\"></div>\n    </a>\n\n    <div class=\"card__information\">\n        <div class=\"card__metadata\">\n                        <div class=\"card__terms\">\n                                <div class=\"tag\">Films</div>\n                                <div class=\"tag\">New Releases</div>\n                            </div>\n                                    <div class=\"card__dates\">\n                From 4 Apr            </div>\n                    </div>\n\n        <div class=\"card__content\" style=\"justify-content: space-between\">\n            <a href=\"https://www.institut-francais.org.uk/cinema/the-most-precious-of-cargoes/\" title=\"The Most Precious of Cargoes\" target=\"_blank\">\n                <h3 class=\"card__title\">The Most Precious of Cargoes</h3>\n                <div class=\"card__text\">\n                    With superb animation and a score by Academy Award winner Alexandre Desplat, this timeless and deeply moving tale is a powerful reminder that in the&hellip;                </div>\n            </a>\n\n                    </div>\n    </div>\n</article>\n<article class=\"card card--horizontal card--film\">\n    <a href=\"https://www.institut-francais.org.uk/cinema/war-paint-women-at-war/\" title=\"War Paint – Women at War\" target=\"_blank\">\n        <div class=\"card__thumbnail\" style=\"--background: url( 'https://www.institut-francais.org.uk/app/uploads/2025/03/war-paint-460x275.jpg' );\"></div>\n    </a>\n\n    <div class=\"card__information\">\n        <div class=\"card__metadata\">\n                        <div class=\"card__terms\">\n                                <div class=\"tag\">Films</div>\n                                <div class=\"tag\">Festivals &amp; Series</div>\n                            </div>\n                                    <div class=\"card__dates\">\n                From 5 Apr            </div>\n                    </div>\n\n        <div class=\"card__content\" style=\"justify-content: space-between\">\n            <a href=\"https://www.institut-francais.org.uk/cinema/war-paint-women-at-war/\" title=\"War Paint – Women at War\" target=\"_blank\">\n                <h3 class=\"card__title\">War Paint – Women at War</h3>\n                <div class=\"card__text\">\n                    Margy Kinmonth’s feature documentary shines a light on the trailblazing role of women artists, on the front lines round the world, championing the female perspective&hellip;                </div>\n            </a>\n\n                    </div>\n    </div>\n</article>\n<article class=\"card card--horizontal card--film\">\n    <a href=\"https://www.institut-francais.org.uk/cinema/misericordia/\" title=\"Misericordia\" target=\"_blank\">\n        <div class=\"card__thumbnail\" style=\"--background: url( 'https://www.institut-francais.org.uk/app/uploads/2024/10/misericorde-1-460x275.webp' );\"></div>\n    </a>\n\n    <div class=\"card__information\">\n        <div class=\"card__metadata\">\n                        <div class=\"card__terms\">\n                                <div class=\"tag\">Films</div>\n                                <div class=\"tag\">New Releases</div>\n                            </div>\n                                    <div class=\"card__dates\">\n                From 28 March            </div>\n                    </div>\n\n        <div class=\"card__content\" style=\"justify-content: space-between\">\n            <a href=\"https://www.institut-francais.org.uk/cinema/misericordia/\" title=\"Misericordia\" target=\"_blank\">\n                <h3 class=\"card__title\">Misericordia</h3>\n                <div class=\"card__text\">\n                    Watch Alain Guiraudie's much anticipated film Misericordia, winner of the Prix Louis-Delluc, and hailed as the 'Best Film of the Year” by Les Cahiers du cinéma. Alain&hellip;                </div>\n            </a>\n\n                    </div>\n    </div>\n</article>\n<article class=\"card card--horizontal card--film\">\n    <a href=\"https://www.institut-francais.org.uk/cinema/when-autumn-falls/\" title=\"When Autumn Falls\" target=\"_blank\">\n        <div class=\"card__thumbnail\" style=\"--background: url( 'https://www.institut-francais.org.uk/app/uploads/2025/02/autumn-falls-460x275.jpg' );\"></div>\n    </a>\n\n    <div class=\"card__information\">\n        <div class=\"card__metadata\">\n                        <div class=\"card__terms\">\n                                <div class=\"tag\">Films</div>\n                                <div class=\"tag\">New Releases</div>\n                            </div>\n                                    <div class=\"card__dates\">\n                From 11 March            </div>\n                    </div>\n\n        <div class=\"card__content\" style=\"justify-content: space-between\">\n            <a href=\"https://www.institut-francais.org.uk/cinema/when-autumn-falls/\" title=\"When Autumn Falls\" target=\"_blank\">\n                <h3 class=\"card__title\">When Autumn Falls</h3>\n                <div class=\"card__text\">\n                    Michelle is enjoying rural retirement close to old friend Marie-Claude. Relations with her daughter are strained, but then Marie-Claude’s son enters the picture… At once&hellip;                </div>\n            </a>\n\n                    </div>\n    </div>\n</article>\n<article class=\"card card--horizontal card--film\">\n    <a href=\"https://www.institut-francais.org.uk/cinema/the-return/\" title=\"The Return\" target=\"_blank\">\n        <div class=\"card__thumbnail\" style=\"--background: url( 'https://www.institut-francais.org.uk/app/uploads/2025/03/the-return-1-460x275.jpg' );\"></div>\n    </a>\n\n    <div class=\"card__information\">\n        <div class=\"card__metadata\">\n                        <div class=\"card__terms\">\n                                <div class=\"tag\">Films</div>\n                                <div class=\"tag\">Special Screenings</div>\n                            </div>\n                                    <div class=\"card__dates\">\n                From 11 Apr            </div>\n                    </div>\n\n        <div class=\"card__content\" style=\"justify-content: space-between\">\n            <a href=\"https://www.institut-francais.org.uk/cinema/the-return/\" title=\"The Return\" target=\"_blank\">\n                <h3 class=\"card__title\">The Return</h3>\n                <div class=\"card__text\">\n                    Preview with live virtual Q&A from the British Museum with Ralph Fiennes on 9 April                </div>\n            </a>\n\n                    </div>\n    </div>\n</article>\n<article class=\"card card--horizontal card--film\">\n    <a href=\"https://www.institut-francais.org.uk/cinema/flow/\" title=\"Flow\" target=\"_blank\">\n        <div class=\"card__thumbnail\" style=\"--background: url( 'https://www.institut-francais.org.uk/app/uploads/2024/09/flow-460x275.webp' );\"></div>\n    </a>\n\n    <div class=\"card__information\">\n        <div class=\"card__metadata\">\n                        <div class=\"card__terms\">\n                                <div class=\"tag\">Films</div>\n                                <div class=\"tag\">Kids &amp; Families</div>\n                            </div>\n                                    <div class=\"card__dates\">\n                From 4 Apr            </div>\n                    </div>\n\n        <div class=\"card__content\" style=\"justify-content: space-between\">\n            <a href=\"https://www.institut-francais.org.uk/cinema/flow/\" title=\"Flow\" target=\"_blank\">\n                <h3 class=\"card__title\">Flow</h3>\n                <div class=\"card__text\">\n                    Winner of the Jury Award at the Annecy International Animation Festival in 2024 and of the 2025 Oscar for Best Animated Feature, Flow is a&hellip;                </div>\n            </a>\n\n                    </div>\n    </div>\n</article>\n<article class=\"card card--horizontal card--film\">\n    <a href=\"https://www.institut-francais.org.uk/cinema/black-bag/\" title=\"Black Bag\" target=\"_blank\">\n        <div class=\"card__thumbnail\" style=\"--background: url( 'https://www.institut-francais.org.uk/app/uploads/2025/03/black-bag-460x275.jpg' );\"></div>\n    </a>\n\n    <div class=\"card__information\">\n        <div class=\"card__metadata\">\n                        <div class=\"card__terms\">\n                                <div class=\"tag\">Films</div>\n                                <div class=\"tag\">New Releases</div>\n                            </div>\n                                    <div class=\"card__dates\">\n                From 4 Apr            </div>\n                    </div>\n\n        <div class=\"card__content\" style=\"justify-content: space-between\">\n            <a href=\"https://www.institut-francais.org.uk/cinema/black-bag/\" title=\"Black Bag\" target=\"_blank\">\n                <h3 class=\"card__title\">Black Bag</h3>\n                <div class=\"card__text\">\n                    From Director Steven Soderbergh (Sex, Lies and Videotape, Erin Brockovich), Black Bag is a gripping spy drama about legendary intelligence agents George Woodhouse (Michael Fassbender)&hellip;                </div>\n            </a>\n\n                    </div>\n    </div>\n</article>\n<article class=\"card card--horizontal card--film\">\n    <a href=\"https://www.institut-francais.org.uk/cinema/lost-highway/\" title=\"Lost Highway\" target=\"_blank\">\n        <div class=\"card__thumbnail\" style=\"--background: url( 'https://www.institut-francais.org.uk/app/uploads/2025/03/lost-highway-460x275.jpg' );\"></div>\n    </a>\n\n    <div class=\"card__information\">\n        <div class=\"card__metadata\">\n                        <div class=\"card__terms\">\n                                <div class=\"tag\">Films</div>\n                                <div class=\"tag\">Classics</div>\n                            </div>\n                                    <div class=\"card__dates\">\n                From 6 Apr            </div>\n                    </div>\n\n        <div class=\"card__content\" style=\"justify-content: space-between\">\n            <a href=\"https://www.institut-francais.org.uk/cinema/lost-highway/\" title=\"Lost Highway\" target=\"_blank\">\n                <h3 class=\"card__title\">Lost Highway</h3>\n                <div class=\"card__text\">\n                    “We’ve met before, haven’t we?” A mesmerising meditation on the mysterious nature of identity, Lost Highway, David Lynch’s seventh feature film, is one of the&hellip;                </div>\n            </a>\n\n                    </div>\n    </div>\n</article>\n<article class=\"card card--horizontal card--film\">\n    <a href=\"https://www.institut-francais.org.uk/cinema/holy-cow/\" title=\"Holy Cow\" target=\"_blank\">\n        <div class=\"card__thumbnail\" style=\"--background: url( 'https://www.institut-francais.org.uk/app/uploads/2024/10/holy-cow-460x275.webp' );\"></div>\n    </a>\n\n    <div class=\"card__information\">\n        <div class=\"card__metadata\">\n                        <div class=\"card__terms\">\n                                <div class=\"tag\">Films</div>\n                                <div class=\"tag\">New Releases</div>\n                            </div>\n                                    <div class=\"card__dates\">\n                From 11 Apr            </div>\n                    </div>\n\n        <div class=\"card__content\" style=\"justify-content: space-between\">\n            <a href=\"https://www.institut-francais.org.uk/cinema/holy-cow/\" title=\"Holy Cow\" target=\"_blank\">\n                <h3 class=\"card__title\">Holy Cow</h3>\n                <div class=\"card__text\">\n                    Totone is 18 and spends most of his time drinking beers and partying with his group of friends in the Jura region. But reality catches&hellip;                </div>\n            </a>\n\n                    </div>\n    </div>\n</article>\n<article class=\"card card--horizontal card--film\">\n    <a href=\"https://www.institut-francais.org.uk/cinema/from-the-east/\" title=\"D&#8217;Est\" target=\"_blank\">\n        <div class=\"card__thumbnail\" style=\"--background: url( 'https://www.institut-francais.org.uk/app/uploads/2025/01/from-the-east-460x275.webp' );\"></div>\n    </a>\n\n    <div class=\"card__information\">\n        <div class=\"card__metadata\">\n                        <div class=\"card__terms\">\n                                <div class=\"tag\">Films</div>\n                                <div class=\"tag\">Classics</div>\n                            </div>\n                                    <div class=\"card__dates\">\n                From 5 Apr            </div>\n                    </div>\n\n        <div class=\"card__content\" style=\"justify-content: space-between\">\n            <a href=\"https://www.institut-francais.org.uk/cinema/from-the-east/\" title=\"D&#8217;Est\" target=\"_blank\">\n                <h3 class=\"card__title\">D&#8217;Est</h3>\n                <div class=\"card__text\">\n                    Following the demolition of the Berlin Wall, Chantal Akerman captures the reality and mutation of former Soviet territories, shot from summer through to winter in&hellip;                </div>\n            </a>\n\n                    </div>\n    </div>\n</article>\n<article class=\"card card--horizontal card--film\">\n    <a href=\"https://www.institut-francais.org.uk/cinema/ernest-celestine-spring-tales/\" title=\"Ernest &amp; Celestine &#8211; Spring Tales\" target=\"_blank\">\n        <div class=\"card__thumbnail\" style=\"--background: url( 'https://www.institut-francais.org.uk/app/uploads/2025/03/ernest-and-celestine-1-460x275.jpg' );\"></div>\n    </a>\n\n    <div class=\"card__information\">\n        <div class=\"card__metadata\">\n                        <div class=\"card__terms\">\n                                <div class=\"tag\">CinéFamilies</div>\n                                <div class=\"tag\">Films</div>\n                            </div>\n                                    <div class=\"card__dates\">\n                12 Apr & 31 May            </div>\n                    </div>\n\n        <div class=\"card__content\" style=\"justify-content: space-between\">\n            <a href=\"https://www.institut-francais.org.uk/cinema/ernest-celestine-spring-tales/\" title=\"Ernest &amp; Celestine &#8211; Spring Tales\" target=\"_blank\">\n                <h3 class=\"card__title\">Ernest &amp; Celestine &#8211; Spring Tales</h3>\n                <div class=\"card__text\">\n                    Spring is coming! 4 charming stories that capture spring’s beauty. Ernest, a rather large and marginal bear, also a street musician and clown, has invited&hellip;                </div>\n            </a>\n\n                    </div>\n    </div>\n</article>\n<article class=\"card card--horizontal card--film\">\n    <a href=\"https://www.institut-francais.org.uk/cinema/inland-empire/\" title=\"Inland Empire\" target=\"_blank\">\n        <div class=\"card__thumbnail\" style=\"--background: url( 'https://www.institut-francais.org.uk/app/uploads/2025/03/inland-empire-460x275.jpg' );\"></div>\n    </a>\n\n    <div class=\"card__information\">\n        <div class=\"card__metadata\">\n                        <div class=\"card__terms\">\n                                <div class=\"tag\">Films</div>\n                                <div class=\"tag\">Classics</div>\n                            </div>\n                                    <div class=\"card__dates\">\n                13 & 17 Apr            </div>\n                    </div>\n\n        <div class=\"card__content\" style=\"justify-content: space-between\">\n            <a href=\"https://www.institut-francais.org.uk/cinema/inland-empire/\" title=\"Inland Empire\" target=\"_blank\">\n                <h3 class=\"card__title\">Inland Empire</h3>\n                <div class=\"card__text\">\n                    An actress's (Laura Dern) perception of reality becomes increasingly distorted as she finds herself falling for her co-star (Justin Theroux) in a remake of an&hellip;                </div>\n            </a>\n\n                    </div>\n    </div>\n</article>\n<article class=\"card card--horizontal card--event\">\n    <a href=\"https://www.institut-francais.org.uk/festivals-and-series/we-stand-with-ukraine/#/\" title=\"We Stand with Ukraine\" target=\"_blank\">\n        <div class=\"card__thumbnail\" style=\"--background: url( 'https://www.institut-francais.org.uk/app/uploads/2025/03/intercepted-we-stand-with-ukraine-460x275.jpg' );\"></div>\n\t</a>\n\n        <div class=\"card__information\">\n            <div class=\"card__metadata\">\n\t\t\t