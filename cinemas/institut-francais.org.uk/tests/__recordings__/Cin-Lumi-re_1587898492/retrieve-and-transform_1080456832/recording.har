cription\" content=\"Hola Frida! is the story of a little girl who is different. Her world is Coyoacan, Mexico City. Sparkling &amp; vibrant, everything interests her and when difficulties arise, she faces them with an overflowing imagination. This little girl is called Frida Kahlo. A film that paints a colourful and tender introduction to the famous artist [&hellip;]\" />\n\t<meta property=\"og:url\" content=\"https://www.institut-francais.org.uk/cinema/hola-frida/\" />\n\t<meta property=\"og:site_name\" content=\"Institut Français · Royaume-Uni\" />\n\t<meta property=\"article:modified_time\" content=\"2025-03-13T17:10:00+00:00\" />\n\t<meta property=\"og:image\" content=\"https://www.institut-francais.org.uk/app/uploads/2025/03/frida.jpg\" />\n\t<meta property=\"og:image:width\" content=\"1440\" />\n\t<meta property=\"og:image:height\" content=\"660\" />\n\t<meta property=\"og:image:type\" content=\"image/jpeg\" />\n\t<meta name=\"twitter:card\" content=\"summary_large_image\" />\n\t<meta name=\"twitter:label1\" content=\"Estimated reading time\" />\n\t<meta name=\"twitter:data1\" content=\"1 minute\" />\n\t<script type=\"application/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://www.institut-francais.org.uk/cinema/hola-frida/\",\"url\":\"https://www.institut-francais.org.uk/cinema/hola-frida/\",\"name\":\"Hola Frida! at Ciné Lumière - Institut Français · Royaume-Uni\",\"isPartOf\":{\"@id\":\"https://www.institut-francais.org.uk/#website\"},\"primaryImageOfPage\":{\"@id\":\"https://www.institut-francais.org.uk/cinema/hola-frida/#primaryimage\"},\"image\":{\"@id\":\"https://www.institut-francais.org.uk/cinema/hola-frida/#primaryimage\"},\"thumbnailUrl\":\"https://www.institut-francais.org.uk/app/uploads/2025/03/frida.jpg\",\"datePublished\":\"2025-03-13T17:05:41+00:00\",\"dateModified\":\"2025-03-13T17:10:00+00:00\",\"breadcrumb\":{\"@id\":\"https://www.institut-francais.org.uk/cinem