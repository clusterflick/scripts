=\"slide__illustration slide__illustration--mobile  position-middle-center\" style=\"--background: url('https://www.institut-francais.org.uk/app/uploads/2025/03/frida.jpg')\">\n\t\t\t\t\t</div>\n\n\t\t\n\t\t\n\t\t\t\t<a class=\"button--play slide__play\" aria-label=\"Play this video\" href=\"https://www.youtube.com/watch?v=RhjFnowwhfI&autoplay=1\" title=\"Play this video\" rel=\"nofollow noopener\" target=\"_blank\" data-fancybox>\n        \t<i class=\"ri-play-circle-line\"></i>\n        </a>\n\t\t\t</div>\n\t\t</section>\n\t\t\t<div class=\"page-context\">\n\t\t\t\t<div class=\"title-dates\">\n\t\t\t\t\t<ul class=\"breadcrumbs\">\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk\" title=\"Home\">\n                Home            </a>\n            </li>\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk/cinema/\" title=\"Films\">\n                Films            </a>\n            </li>\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk/whats-on/\" title=\"What&#8217;s On\">\n                What&#8217;s On            </a>\n            </li>\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk/cinema/\" title=\"Ciné Lumière\">\n                Ciné Lumière            </a>\n            </li>\n        <li class=\"item\">\n                    <span class=\"link current\">Hola Frida!</span>\n            </li>\n    </ul>\n\t\t\t\t\t<h1>Hola Frida!</h1>\n\n\t\t\t\t\t\t\t\t\t\t<span class=\"start\">Sat 24 May</span>\n\t\t\t\t\t\n\t\t            \t\t            <div class=\"tags\">\n\t\t                \t\t                <div class=\"tags__tag tag\">\n\t\t                    Films\t\t                </div>\n\t\t                \t\t                <div class=\"tags__tag tag\">\n\t\t                    CinéFamilies\t\t                </div>\n\t\t                \n\t\t                \t\t                <div class=\"tags__tag tag\">\n\t\t                \t<a href=\"https://www.institut-francais.org.uk/festivals-and-series/women-shaping-the-world/\" target=\"_blank\" title=\"Women Shaping the World\">\n\t\t                    \tWomen Shaping the World\t\t                    </a>\n\t\t                </div>\n\t\t                \t\t            </div>\n\t\t            \t\t\t\t</div>\n\n\t\t\t\t<div class=\"definition\">\n\t\t\t\t\t<div class=\"content-block rte\"><p><em>Hola Frida!</em> is the story of a little girl who is different. Her world is Coyoacan, Mexico City.</p>\n<p>Sparkling &amp; vibrant, everything interests her and when difficulties arise, she faces them</p>\n<p>with an overflowing imagination. This little girl is called Frida Kahlo. A film that paints a colourful and tender introduction to the famous artist in a new light: perfect for the younger ones!</p></div>\n\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t<ul class=\"metadata\" style=\"background: #3558a2;\">\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-vidicon-2-line\"></i> Director(s): </strong>\n\t\t\t\t\t\tKarine Vézina & André Kadi\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-team-line\"></i> Cast: </strong>\n\t\t\t\t\t\tOlivia Ruiz, Emma Rodriguez, Rebecca Gonzalez\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-map-pin-line\"></i> Country, year: </strong>\n\t\t\t\t\t\tFRA/CAN | 2024\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-time-line\"></i> Duration: </strong>\n\t\t\t\t\t\t82 min\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-chat-1-line\"></i> Language: </strong>\n\t\t\t\t\t\tIn French & a bit of Spanish with English subtitles\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-settings-line\"></i> Cert.: </strong>\n\t\t\t\t\t\tTBC 6+\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-information-line\"></i> More information: </strong>\n\t\t\t\t\t\tUK Premiere\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t</div>\n\t\t</header>\n\t</section>\n\n\t\t<section class=\"next-showing\">\n\t\t<h2>Next Showing</h2>\n\t\t<div class=\"timetable\">\n\t\t\t<div class=\"date\">\n\t\t\t\t<time datetime=\"2025-05-24\">\n\t                Saturday 24 May\t            </time>\n\t                            <span class=\"location\">Ciné Lumière</span>\n\t            \t            \t\t        <span class=\"calendar-note\">UK Premiere</span>\n\t\t    \t           \t</div>\n\n\t        \t        <time class=\"time\" datetime=\"14:00\">\n\t            14:00\t        </time>\n\t    \t\t    </div>\n\t\t\n\t\t\t    <div class=\"actions\">\n\t    \t<a href=\"https://cinelumiere.savoysystems.co.uk/CineLumiere.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_600.TcsWebTab_601.TcsPerformance_6238752.TcsSection_1928774\" rel=\"nofollow\" target=\"_blank\" title=\"Book now\" class=\"button button-arrow\">Book now</a>\n\t    \t\t    </div>\n\t\t\t</section>\n\t\n\t\n\t\t<section class=\"film-partners\">\n\t\t<div class=\"content-block rte\"><p><img decoding=\"async\" class=\"alignnone  wp-image-48979\" src=\"https://www.institut-francais.org.uk/app/uploads/2024/03/LOGO_Animaction1-jpg.webp\" alt=\"\" width=\"200\" height=\"72\" srcset=\"https://www.institut-francais.org.uk/app/uploads/2024/03/LOGO_Animaction1-jpg.webp 1201w, https://www.institut-francais.org.uk/app/uploads/2024/03/LOGO_Animaction1-300x108.webp 300w, https://www.institut-francais.org.uk/app/uploads/2024/03/LOGO_Animaction1-1024x369.webp 1024w, https://www.institut-francais.org.uk/app/uploads/2024/03/LOGO_Animaction1-768x277.webp 768w\" sizes=\"(max-width: 200px) 100vw, 200px\" /> <img decoding=\"