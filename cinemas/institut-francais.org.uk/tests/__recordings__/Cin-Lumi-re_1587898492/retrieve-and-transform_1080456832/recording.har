play-circle-line\"></i>\n            </a>\n\t\t\t\t\t</div>\n\t\t\t</div>\n\t\t</section><section class=\"mobile leaderboard \">\n\t<div class=\"overlay\" aria-hidden=\"true\"></div>\n\t\t<div class=\"slide  active\">\n\t\t\n\t\t<div class=\"slide__illustration slide__illustration--mobile  position-middle-center\" style=\"--background: url('https://www.institut-francais.org.uk/app/uploads/2025/02/john-yoko-.jpg')\">\n\t\t\t\t\t</div>\n\n\t\t\n\t\t\n\t\t\t\t<a class=\"button--play slide__play\" aria-label=\"Play this video\" href=\"https://www.youtube.com/watch?v=3qFXNhpO3ZI&autoplay=1\" title=\"Play this video\" rel=\"nofollow noopener\" target=\"_blank\" data-fancybox>\n        \t<i class=\"ri-play-circle-line\"></i>\n        </a>\n\t\t\t</div>\n\t\t</section>\n\t\t\t<div class=\"page-context\">\n\t\t\t\t<div class=\"title-dates\">\n\t\t\t\t\t<ul class=\"breadcrumbs\">\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk\" title=\"Home\">\n                Home            </a>\n            </li>\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk/cinema/\" title=\"Films\">\n                Films            </a>\n            </li>\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk/whats-on/\" title=\"What&#8217;s On\">\n                What&#8217;s On            </a>\n            </li>\n        <li class=\"item\">\n                    <a class=\"link\" href=\"https://www.institut-francais.org.uk/cinema/\" title=\"Ciné Lumière\">\n                Ciné Lumière            </a>\n            </li>\n        <li class=\"item\">\n                    <span class=\"link current\">One to One: John &amp; Yoko</span>\n            </li>\n    </ul>\n\t\t\t\t\t<h1>One to One: John &amp; Yoko</h1>\n\n\t\t\t\t\t\t\t\t\t\t<span class=\"start\">From Fri 25 Apr to Thu 01 May</span>\n\t\t\t\t\t\n\t\t            \t\t            <div class=\"tags\">\n\t\t                \t\t                <div class=\"tags__tag tag\">\n\t\t                    Films\t\t                </div>\n\t\t                \t\t                <div class=\"tags__tag tag\">\n\t\t                    New Releases\t\t                </div>\n\t\t                \n\t\t                \t\t            </div>\n\t\t            \t\t\t\t</div>\n\n\t\t\t\t<div class=\"definition\">\n\t\t\t\t\t<div class=\"content-block rte\"><p>New York, 1972. In John Lennon and Yoko Ono’s apartment, the television is always on, serving as a ‘window to the world.’ Through their TV, this inventive documentary explores America at the time, the Lennons’ evolving politics, and their complex personal lives as they search for Yoko’s estranged daughter, Kyoko, against the backdrop of the Nixon-McGovern election. Featuring previously unheard phone recordings and music from John’s only post-Beatles concert, it unveils the world John and Yoko inhabited and their lasting relevance today.</p></div>\n\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t<ul class=\"metadata\" style=\"background: #3558a2;\">\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-vidicon-2-line\"></i> Director(s): </strong>\n\t\t\t\t\t\tKevin Macdonald, Sam Rice-Edwards\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-map-pin-line\"></i> Country, year: </strong>\n\t\t\t\t\t\tUK | 2024\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-time-line\"></i> Duration: </strong>\n\t\t\t\t\t\t100 mins\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-chat-1-line\"></i> Language: </strong>\n\t\t\t\t\t\tin English\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li style=\"display: block;\">\n\t\t\t\t\t\t<strong><i class=\"ri-settings-line\"></i> Cert.: </strong>\n\t\t\t\t\t\tTBC\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li styl