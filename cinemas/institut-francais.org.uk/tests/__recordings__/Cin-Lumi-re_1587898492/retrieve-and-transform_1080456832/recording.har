ni\" />\n\t<meta property=\"og:description\" content=\"Poetic realism reached sublime heights with Les Enfants du paradis (Children of Paradise), widely considered one of the greatest French films of all time. This nimble depiction of nineteenth-century Paris’s theatrical demimonde, filmed during World War II, follows a mysterious woman (Arletty) loved by four different men (all based on historical figures): an actor, a [&hellip;]\" />\n\t<meta property=\"og:url\" content=\"https://www.institut-francais.org.uk/cinema/les-enfants-du-paradis/\" />\n\t<meta property=\"og:site_name\" content=\"Institut Français · Royaume-Uni\" />\n\t<meta property=\"article:modified_time\" content=\"2025-04-03T16:30:46+00:00\" />\n\t<meta property=\"og:image\" content=\"https://www.institut-francais.org.uk/app/uploads/2025/03/les-enfants-du-paradis-2.jpg\" />\n\t<meta property=\"og:image:width\" content=\"1440\" />\n\t<meta property=\"og:image:height\" content=\"660\" />\n\t<meta property=\"og:image:type\" content=\"image/jpeg\" />\n\t<meta name=\"twitter:card\" content=\"summary_large_image\" />\n\t<meta name=\"twitter:label1\" content=\"Estimated reading time\" />\n\t<meta name=\"twitter:data1\" content=\"1 minute\" />\n\t<script type=\"application/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://www.institut-francais.org.uk/cinema/les-enfants-du-paradis/\",\"url\":\"https://www.institut-francais.org.uk/cinema/les-enfants-du-paradis/\",\"name\":\"Les Enfants du paradis at Ciné Lumière - Institut Français · Royaume-Uni\",\"isPartOf\":{\"@id\":\"https://www.institut-francais.org.uk/#website\"},\"primaryImageOfPage\":{\"@id\":\"https://www.institut-francais.org.uk/cinema/les-enfants-du-paradis/#primaryimage\"},\"image\":{\"@id\":\"https://www.institut-francais.org.uk/cinema/les-enfants-du-paradis/#primaryimage\"},\"thumbnailUrl\":\"https://www.institut-francais.org.uk/app/uploads/2025/03/les-enfants-du-paradi