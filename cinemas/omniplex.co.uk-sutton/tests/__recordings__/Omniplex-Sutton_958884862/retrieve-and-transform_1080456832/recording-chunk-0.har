dropdown\r\ndocument.addEventListener('DOMContentLoaded', () => {\r\n    const cinemaSelect = document.getElementById('conactlocalCinema');\r\n    cinemaSelect.selectedIndex = 0;\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function () {\r\n  const cinemaSelect = document.getElementById('conactlocalCinema');\r\n\r\n  if (!cinemaSelect) return;\r\n\r\n  cinemaSelect.addEventListener('change', function () {\r\n    const siteCode = this.value;\r\n\r\n    if (siteCode !== '') {\r\n      window.location.href = '/company/contact?site=' + encodeURIComponent(siteCode);\r\n    }\r\n  });\r\n});\r\n</script>\r\n</body>\r\n\r\n</html>",
