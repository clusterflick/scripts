\n          <h4 class=\"bigText leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            &pound;6.95          </h4>\r\n        </div>\r\n          </div>\r\n  </div>\r\n  <div class=\"midSection flex justify-between items-baseline\">\r\n\r\n    <div class=\"mb-2\"></div>\r\n  </div>\r\n  <div class=\"bottomSection flex items-center justify-between gap-2\">\r\n    <div class=\"shrink-0\">\r\n      <p class=\"smallText\">\r\n        Screen 6      </p>\r\n    </div>\r\n    <div class=\"flex flex-1 min-w-0 justify-end overflow-hidden\">\r\n      <div class=\"flex min-w-0 max-w-full items-center justify-end gap-2\"> \r\n                      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n</a><a aria-label=\"Wildwood at 18:10 in Screen 1\" href=\"https://www.omniplexcinemas.co.uk/booking/seats/sutton/48169\" class=\"\"> \r\n<div id=\"perf_4\" class=\"showTimeBox bg-ompGray-times p-2 col-span-1 rounded-xl\">\r\n  <div class=\"topSection flex justify-between items-end\">\r\n    <div class=\"flex items-end\">\r\n      <div class=\"flex items-baseline\">\r\n        <h4 class=\"bigText mr-1 leading-none\" aria-label=\"Wildwood at 18:10 in Screen 1\">\r\n          18:10        </h4>\r\n        <p class=\"smallText leading-none\" aria-label=\"Wildwood starts at 18:10 and ends at 20:20\">\r\n          - 20:20        </p>\r\n      </div>\r\n    </div>\r\n    <div class=\"flex items-end\">\r\n              <div class=\"flex items-baseline\">\r\n          <p class=\"smallText mr-1 leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            From\r\n          </p>\r\n          <h4 class=\"bigText leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            &pound;6.95          </h4>\r\n        </div>\r\n          </div>\r\n  </div>\r\n  <div class=\"midSection flex justify-between items-baseline\">\r\n\r\n    <div class=\"mb-2\"></div>\r\n  </div>\r\n  <div class=\"bottomSection flex items-center justify-between gap-2\">\r\n    <div class=\"shrink-0\">\r\n      <p class=\"smallText\">\r\n        Screen 1      </p>\r\n    </div>\r\n    <div class=\"flex flex-1 min-w-0 justify-end overflow-hidden\">\r\n      <div class=\"flex min-w-0 max-w-full items-center justify-end gap-2\"> \r\n                      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n</a><a aria-label=\"Wildwood at 19:10 in Screen 6\" href=\"https://www.omniplexcinemas.co.uk/booking/seats/sutton/48188\" class=\"\"> \r\n<div id=\"perf_5\" class=\"showTimeBox bg-ompGray-times p-2 col-span-1 rounded-xl\">\r\n  <div class=\"topSection flex justify-between items-end\">\r\n    <div class=\"flex items-end\">\r\n      <div class=\"flex items-baseline\">\r\n        <h4 class=\"bigText mr-1 leading-none\" aria-label=\"Wildwood at 19:10 in Screen 6\">\r\n          19:10        </h4>\r\n        <p class=\"smallText leading-none\" aria-label=\"Wildwood starts at 19:10 and ends at 21:20\">\r\n          - 21:20        </p>\r\n      </div>\r\n    </div>\r\n    <div class=\"flex items-end\">\r\n              <div class=\"flex items-baseline\">\r\n          <p class=\"smallText mr-1 leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            From\r\n          </p>\r\n          <h4 class=\"bigText leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            &pound;6.95          </h4>\r\n        </div>\r\n          </div>\r\n  </div>\r\n  <div class=\"midSection flex justify-between items-baseline\">\r\n\r\n    <div class=\"mb-2\"></div>\r\n  </div>\r\n  <div class=\"bottomSection flex items-center justify-between gap-2\">\r\n    <div class=\"shrink-0\">\r\n      <p class=\"smallText\">\r\n        Screen 6      </p>\r\n    </div>\r\n    <div class=\"flex flex-1 min-w-0 justify-end overflow-hidden\">\r\n      <div class=\"flex min-w-0 max-w-full items-center justify-end gap-2\"> \r\n                      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n</a>          </div>    \r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"main-container my-mid block md:hidden\">\r\n  <button id=\"aboutToggle\" class=\"flex items-center text-ompYellow font-semibold w-full text-left\">\r\n    <p class=\"\">Sutton Surrey Omniplex</p>\r\n    <i id=\"aboutIcon\" class=\"icon omni-chevron-up pl-4\"></i>\r\n  </button>\r\n  <div id=\"aboutSiteSection\" class=\"mt-4 hidden\">\r\n    <div>\r\n      Omniplex Cinema Sutton: Luxury Recliners. Double MAXX screens.\r\n\r\nExperience the next level of cinema at Omniplex Cinema Sutton, the premier 12-screen entertainment hub in South London. Located in the heart of the St Nicholas Shopping Centre, our cinema features the latest in motion technology, Premium Large Format screens, and luxury seating for the ultimate movie night.\r\n\r\nWhat to Expect at Omniplex Sutton:\r\n&#9679;\tDouble Omniplex MAXX: Immerse yourself in the biggest blockbusters on our two Premium Large Format MAXX screens, featuring floor-to-ceiling visuals and powerful immersive sound.\r\n\r\n&#9679;\tD-BOX Motion Seating: Feel every moment with our D-BOX haptic seats, perfectly synchronized with the on-screen action for a truly 4D experience.\r\n\r\n&#9679;\tLuxury Electric Recliners: Relax in style with our signature Electric Reclining Seats, allowing you to stretch out and enjoy the latest releases in total comfort.\r\n\r\n&#9679;\tSt Nicholas Centre Convenience: Benefit from 3 Hours of Free Car Parking (validated on-site) at the St Nicholas Shopping Centre - the most convenient way to watch movies in Sutton.\r\n\r\n&#9679;\tCinema Treats: Fuel your visit with our famous fresh popcorn made on-site, hot nachos, sweets, and a wide selection of soft drinks.\r\n\r\n&#9679;\tDigital Experience: Book on the Omniplex App for paperless entry and manage your MyOmniPass with ease. Omniplex Gift Cards are also available online - the perfect gift for any film lover.\r\n\r\nSecure your D-BOX seat or MAXX Recliner by booking online at Omniplex Sutton today!\r\n    </div>\r\n  </div>\r\n  <div class=\"mt-4\">\r\n      </div>\r\n</div>\r\n\r\n<script>\r\n  document.addEventListener('DOMContentLoaded', function () {\r\n    const toggle = document.getElementById('aboutToggle');\r\n    const section = document.getElementById('aboutSiteSection');\r\n    const icon = document.getElementById('aboutIcon');\r\n    toggle.addEventListener('click', function () {\r\n      section.classList.toggle('hidden');\r\n      icon.classList.toggle('omni-chevron-down');\r\n      icon.classList.toggle('omni-chevron-up');\r\n    });\r\n  });\r\n\r\nfunction clearFIlters(){\r\n  const clearFiltersButton = document.getElementById('clearFilters');\r\n  clearFiltersButton.click();\r\n}\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n  var showcase = new Splide('#showcase', {\r\n    type: 'loop',\r\n    perPage: 1.2,\r\n    loop: true,\r\n    gap: '20px',\r\n    focus: 'center',\r\n    arrows: false,\r\n    pagination: false,\r\n    trimSpace: false,\r\n    autoHeight: true,\r\n    clones: 2,\r\n    // Auto scroll\r\n    autoplay: true,\r\n    interval: 5000,\r\n    pauseOnHover: true,\r\n    pauseOnFocus: true,\r\n  });\r\n  showcase.mount();\r\n});\r\n\r\nfunction toggleSynopsis(btn) {\r\n  const container = btn.parentElement;\r\n  const shortText = container.querySelector('.synopsis-short');\r\n  const fullText = container.querySelector('.synopsis-full');\r\n\r\n  const isHidden = fullText.classList.contains('hidden');\r\n\r\n  if (isHidden) {\r\n    shortText.classList.add('hidden');\r\n    fullText.classList.remove('hidden');\r\n    btn.textContent = 'See less';\r\n  } else {\r\n    shortText.classList.remove('hidden');\r\n    fullText.classList.add('hidden');\r\n    btn.textContent = 'See more';\r\n  }\r\n}\r\n\r\nfunction showSearchBox(){\r\n  const searchBoxContainer =  document.getElementById('searchBoxContainer');\r\n\r\n  searchBoxContainer.classList.toggle('hidden');\r\n}\r\n</script>\r\n\r\n\r\n    <div class=\"main-container my-big \">\r\n              <div class=\"grid grid-cols-6 gap-6\">\r\n                      \r\n            <div class=\"col-span-6 md:col-span-2 rounded-xl overflow-hidden bg-black\">\r\n              <div\r\n                class=\"h-[300px] flex flex-col justify-end p-6 bg-cover bg-center\"\r\n                style=\"background-image: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.2)), url('/cms/footerads/opass.png'); background-position: right top;\"\r\n              >\r\n                                  <h3 class=\"text-xl font-semibold mb-2 text-white\">\r\n                    Get a ticket to every movie at Omniplex with a monthly 'MyOmniPass' subscription.                  </h3>\r\n                \r\n                                  <p class=\"text-sm mb-4 text-white\">\r\n                    Terms &amp; Exclusions Apply                  </p>\r\n                \r\n                                  <a\r\n                    href=\"/join/landing\"\r\n                    class=\"text-center font-semibold bg-white/20 hover:bg-white/30 transition px-4 py-2 rounded-md text-sm w-full text-white\"\r\n                  >\r\n                    Find out more                  </a>\r\n                              </div>\r\n            </div>\r\n                      \r\n            <div class=\"col-span-6 md:col-span-2 rounded-xl overflow-hidden bg-black\">\r\n              <div\r\n                class=\"h-[300px] flex flex-col justify-end p-6 bg-cover bg-center\"\r\n                style=\"background-image: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.2)), url('/cms/footerads/gcard.png'); background-position: right top;\"\r\n              >\r\n                                  <h3 class=\"text-xl font-semibold mb-2 text-white\">\r\n                    For the superhero in your life...                  </h3>\r\n                \r\n                                  <p class=\"text-sm mb-4 text-white\">\r\n                    Get them an Omniplex Gift Card                  </p>\r\n                \r\n                                  <a\r\n                    href=\"/giftcards/choose\"\r\n                    class=\"text-center font-semibold bg-white/20 hover:bg-white/30 transition px-4 py-2 rounded-md text-sm w-full text-white\"\r\n                  >\r\n                    Get a Gift Card                  </a>\r\n                              </div>\r\n            </div>\r\n                      \r\n            <div class=\"col-span-6 md:col-span-2 rounded-xl overflow-hidden bg-black\">\r\n              <div\r\n                class=\"h-[300px] flex flex-col justify-end p-6 bg-cover bg-center\"\r\n                style=\"background-image: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.2)), url('/cms/footerads/kids.png'); background-position: right top;\"\r\n              >\r\n                                  <h3 class=\"text-xl font-semibold mb-2 text-white\">\r\n                    Perfect for a day out with the kids                  </h3>\r\n                \r\n                                  <p class=\"text-sm mb-4 text-white\">\r\n                    Best movies and treats for all                  </p>\r\n                \r\n                                  <a\r\n                    href=\"/cinema/kids\"\r\n                    class=\"text-center font-semibold bg-white/20 hover:bg-white/30 transition px-4 py-2 rounded-md text-sm w-full text-white\"\r\n                  >\r\n                     See our Kids offerings                  </a>\r\n                              </div>\r\n            </div>\r\n                  </div>\r\n          </div>\r\n       \r\n<div id=\"footerContact\" class=\"bg-[#282828] mt-8\">\r\n  <div class=\"w-full text-center py-8\">\r\n    <h4 class=\"text-ompYellow text-2xl font-bold\">Need help?</h4>\r\n    <p class=\"\">Get in touch with your local cinema now:</p>\r\n    <div class=\"input-container mb-4 main-container mt-4\">\r\n      <div class=\"input-select mx-auto w-full md:w-2/3 lg:w-1/2\">\r\n        <select id=\"conactlocalCinema\" name=\"sitecode\" class=\"select-input\">\r\n          <option value=\"\" disabled selected>Choose Cinema</option>\r\n          <optgroup style=\"font-weight:900;font-size:13px;\" label=\"England\"><option value=\"OMP_BIRM\" id=\"birmingham-great-park\" data-thissite=\"OMP_BIRM\" data-sitecode=\"OMP_SUTT\">&nbsp;Birmingham - Great Park</option>\r\n<option value=\"OMP_HIWY\" id=\"high-wycombe\" data-thissite=\"OMP_HIWY\" data-sitecode=\"OMP_SUTT\">&nbsp;High Wycombe</option>\r\n<option value=\"OMP_IPSW\" id=\"ipswich\" data-thissite=\"OMP_IPSW\" data-sitecode=\"OMP_SUTT\">&nbsp;Ipswich</option>\r\n<option value=\"OMP_SUND\" id=\"sunderland\" data-thissite=\"OMP_SUND\" data-sitecode=\"OMP_SUTT\">&nbsp;Sunderland</option>\r\n<option selected=\"selected\" value=\"OMP_SUTT\" id=\"sutton\" data-thissite=\"OMP_SUTT\" data-sitecode=\"OMP_SUTT\">&nbsp;Sutton Surrey</option>\r\n<option value=\"OMP_WIGA\" id=\"wigan\" data-thissite=\"OMP_WIGA\" data-sitecode=\"OMP_SUTT\">&nbsp;Wigan</option>\r\n</optgroup><optgroup style=\"font-weight:900;font-size:13px;\" label=\"Scotland\"><option value=\"OMP_CLYD\" id=\"glasgow-clydebank\" data-thissite=\"OMP_CLYD\" data-sitecode=\"OMP_SUTT\">&nbsp;Clydebank</option>\r\n<option value=\"OMP_GLAS\" id=\"glasgow-renfrew-street\" data-thissite=\"OMP_GLAS\" data-sitecode=\"OMP_SUTT\">&nbsp;Glasgow - Renfrew Street</option>\r\n</optgroup><optgroup style=\"font-weight:900;font-size:13px;\" label=\"Northern Ireland\"><option value=\"OMP_ANTR\" id=\"antrim\" data-thissite=\"OMP_ANTR\" data-sitecode=\"OMP_SUTT\">&nbsp;Antrim</option>\r\n<option value=\"OMP_BANB\" id=\"banbridge\" data-thissite=\"OMP_BANB\" data-sitecode=\"OMP_SUTT\">&nbsp;Banbridge</option>\r\n<option value=\"OMP_BANG\" id=\"bangor\" data-thissite=\"OMP_BANG\" data-sitecode=\"OMP_SUTT\">&nbsp;Bangor</option>\r\n<option value=\"OMP_DUDO\" id=\"belfast\" data-thissite=\"OMP_DUDO\" data-sitecode=\"OMP_SUTT\">&nbsp;Be