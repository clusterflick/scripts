\"\r\n        data-eventCode=\"Supergirl\"\r\n      />\r\n              <img\r\n          onclick=\"playYoutubeVideo('YqdAEdkHrwo')\"\r\n          src=\"/public/assets/svgs/play-circle.svg\"\r\n          alt=\"Play Trailler\"\r\n          class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n        />\r\n          </div>\r\n  </div>\r\n  <div class=\"md:col-span-5 lg:col-span-5 xl:col-span-8\">\r\n    <div class=\"grid grid-cols-3 md:grid-cols-5 gap-4 items-start\">\r\n      <!-- A (Mobile) -->\r\n      <div class=\"md:hidden col-span-1\">\r\n        <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n          <img\r\n            src=\"/filmimages/small/106024.jpg?v=1555854959\"\r\n            alt=\"Supergirl Event poster\"\r\n            class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n            data-eventCode=\"106024\"\r\n            data-eventCode=\"Supergirl\"\r\n          />\r\n                      <img\r\n              onclick=\"playYoutubeVideo('YqdAEdkHrwo')\"\r\n              src=\"/public/assets/svgs/play-circle.svg\"\r\n              alt=\"Play Trailler\"\r\n              class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n            />\r\n                  </div>\r\n      </div>\r\n      <!-- B -->\r\n      <div class=\"col-span-2 md:col-span-5\">\r\n        <div class=\"w-full\">\r\n          <div class=\"flex justify-between items-start w-full mb-2\">\r\n            <p class=\"font-medium text-lg sm:text-2xl md:text-3xl leading-snug sm:leading-tight md:leading-tight mr-4\">\r\n              <a href=\"/cinema/movie/sutton/supergirl\">\r\n                Supergirl              </a>\r\n            </p>\r\n            <img data-toggle=\"0\" id=\"favourite106024\" onClick=\"toggleFavourite('106024');return false;\" src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_favourited-off.svg\" class=\"w-4 mt-2 mx-3\" alt=\"Add to Favourites\" />  \r\n          </div>\r\n          <div class=\"flex items-center gap-2 mb-2\">\r\n            <div class=\"flex flex-col md:flex-row gap-4\">\r\n              <div class=\"flex items-center gap-2\">\r\n                <img src=\"/images/ratings/UK_12A.png\" class=\"w-4 min-w-[30px]\" />\r\n                <p class=\"text-base leading-snug font-normal leading-none\">Action, Adventure</p>\r\n              </div>\r\n              <p class=\"mb-2 md:m-auto flex item-center\"><span class=\"hidden md:flex mr-2\">|</span> 1hr 50min </p>\r\n            </div>\r\n          </div>\r\n          \r\n            <p class=\"hidden md:block mb-2 pt-2\">\r\n              <span class=\"synopsis-short\">\r\n                When an unexpected and ruthless enemy threatens, Kara Zor-El is forced, against her will, to team up with an unlikely companion. Together, they embark on an epic cosmic journey where revenge and justice are at stake - and where Kara must confront her...              </span>\r\n\r\n                              <span class=\"synopsis-full hidden text-base\">\r\n                  When an unexpected and ruthless enemy threatens, Kara Zor-El is forced, against her will, to team up with an unlikely companion. Together, they embark on an epic cosmic journey where revenge and justice are at stake - and where Kara must confront her origins to find her own path as a hero.                </span>\r\n\r\n                <button \r\n                  type=\"button\"\r\n                  class=\"ml-2 text-ompYellow underline text-base\"\r\n                  onclick=\"toggleSynopsis(this)\"\r\n                >\r\n                  See more\r\n                </button>\r\n                          </p>\r\n          <div class=\"hallTypeIcon hidden\">\r\n                                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_dbox-orange.svg\" class=\"h-4 w-auto my-2\" alt=\"Event Type Icon\" />\r\n                                                </div>\r\n        </div>\r\n      </div>\r\