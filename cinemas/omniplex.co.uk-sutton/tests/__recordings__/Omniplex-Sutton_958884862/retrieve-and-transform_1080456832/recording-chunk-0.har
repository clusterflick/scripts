4 mt-2 mx-3\" alt=\"Add to Favourites\" />  \r\n          </div>\r\n          <div class=\"flex items-center gap-2 mb-2\">\r\n            <div class=\"flex flex-col md:flex-row gap-4\">\r\n              <div class=\"flex items-center gap-2\">\r\n                <img src=\"/images/ratings/UK_15.png\" class=\"w-4\" />\r\n                <p class=\"text-base leading-snug font-normal leading-none\">Comedy</p>\r\n              </div>\r\n              <p class=\"mb-2 md:m-auto flex item-center\"><span class=\"hidden md:flex mr-2\">|</span> 1hr 36min </p>\r\n            </div>\r\n          </div>\r\n          \r\n            <p class=\"hidden md:block mb-2 pt-2\">\r\n              <span class=\"synopsis-short\">\r\n                Twenty-six years after outrunning a suspiciously familiar masked killer (&quot;GhostFace&quot;), the Core Four are back in the killer?s crosshairs and no horror movie IP is safe. Marlon Wayans (&quot;Shorty&quot;), Shawn Wayans (&quot;Ray&quot;), Ann...              </span>\r\n\r\n                              <span class=\"synopsis-full hidden text-base\">\r\n                  Twenty-six years after outrunning a suspiciously familiar masked killer (&quot;GhostFace&quot;), the Core Four are back in the killer?s crosshairs and no horror movie IP is safe. Marlon Wayans (&quot;Shorty&quot;), Shawn Wayans (&quot;Ray&quot;), Anna Faris (&quot;Cindy&quot;), and Regina Hall (&quot;Brenda&quot;) reunite in Scary Movie alongside returning favourites and fresh faces to slash through reboots, remakes, requels, prequels, sequels, spin-offs, elevated horror, origin stories, anything with the word legacy in it, and every ?final chapter? that absolutely isn?t final. Nothing is sacred. No trope survives. Every line gets crossed. The Wayans are back to cancel the Cancel Culture.                </span>\r\n\r\n                <button \r\n                  type=\"button\"\r\n                  class=\"ml-2 text-ompYellow underline text-base\"\r\n                  onclick=\"toggleSynopsis(this)\"\r\n                >\r\n                  See more\r\n                </button>\r\n                          </p>\r\n          <div class=\"hallTypeIcon hidden\">\r\n                                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_maxx.svg\" class=\"h-4 w-auto my-2\" alt=\"Event Type Icon\" />\r\n                                                </div>\r\n        </div>\r\n      </div>\r\n      <!-- C -->\r\n      <div class=\"col-span-3 md:col-span-5 md:col-start-1\">\r\n        <div class=\"w-full grid grid-cols-1 md:grid-cols-2 sm:col-span-2 xl:grid-cols-3  gap-2\">\r\n          <a aria-label=\"Scary Movie at 14:40 in Screen 11\" href=\"https://www.omniplexcinemas.co.uk/booking/seats/sutton/41892\" class=\"\"> \r\n<div id=\"perf_0\" class=\"showTimeBox bg-ompGray-times p-2 col-span-1 rounded-xl\">\r\n  <div class=\"topSection flex justify-between items-end\">\r\n    <div class=\"flex items-end\">\r\n      <div class=\"flex items-baseline\">\r\n        <h4 class=\"bigText mr-1 leading-none\" aria-label=\"Scary Movie at 14:40 in Screen 11\">\r\n          14:40        </h4>\r\n        <p class=\"smallText leading-none\" aria-label=\"Scary Movie starts at 14:40 and ends at 16:16\">\r\n          - 16:16        </p>\r\n      </div>\r\n    </div>\r\n    <div class=\"flex items-end\">\r\n              <div class=\"flex items-baseline\">\r\n          <p class=\"smallText mr-1 leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            From\r\n          </p>\r\n          <h4 class=\"bigText leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            &pound;6.95          </h4>\r\n        </div>\r\n          </div>\r\n  </div>\r\n  <div class=\"midSection flex justify-between items-baseline\">\r\n\r\n    <div class=\"mb-2\"></div>\r\n  </div>\r\n  <div class=\"bottomSection flex justify-between items-baseline\">\r\n    <div class=\"flex items-baseline w-auto\">\r\n      <div c