art-1 w-full h-auto object-cover\"\r\n            data-eventCode=\"112568\"\r\n            data-eventCode=\"Shaun the Sheep: The Beast of Mossy Bottom\"\r\n          />\r\n                      <img\r\n              onclick=\"playYoutubeVideo('UZ46Smi6mOw')\"\r\n              src=\"/public/assets/svgs/play-circle.svg\"\r\n              alt=\"Play Trailler\"\r\n              class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n            />\r\n                  </div>\r\n      </div>\r\n      <!-- B -->\r\n      <div class=\"col-span-2 md:col-span-5\">\r\n        <div class=\"w-full\">\r\n          <div class=\"flex justify-between items-start w-full mb-2\">\r\n            <p class=\"font-medium text-lg sm:text-2xl md:text-3xl leading-snug sm:leading-tight md:leading-tight mr-4\">\r\n              <a href=\"/cinema/movie/sutton/shaun-the-sheep-the-beast-of-mossy-bottom\">\r\n                Shaun the Sheep: The Beast of Mossy Bottom              </a>\r\n            </p>\r\n            <img data-toggle=\"0\" id=\"favourite112568\" onClick=\"toggleFavourite('112568');return false;\" src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_favourited-off.svg\" class=\"w-4 mt-2 mx-3\" alt=\"Add to Favourites\" />  \r\n          </div>\r\n          <div class=\"flex items-center gap-2 mb-2\">\r\n            <div class=\"flex flex-col md:flex-row gap-4\">\r\n              <div class=\"flex items-center gap-2\">\r\n                <img src=\"/images/ratings/UK_U.png\" class=\"w-4 min-w-[30px]\" />\r\n                <p class=\"text-base leading-snug font-normal leading-none\">Animation, Comedy, Family</p>\r\n              </div>\r\n              <p class=\"mb-2 md:m-auto flex item-center\"><span class=\"hidden md:flex mr-2\">|</span> 1hr 31min </p>\r\n            </div>\r\n          </div>\r\n          \r\n            <p class=\"hidden md:block mb-2 pt-2\">\r\n              <span class=\"synopsis-short\">\r\n                Shaun The Sheep: The Beast Of Mossy Bottom sees the residents of Mossy Bottom Farm looking forward to Halloween - until the clumsy Farmer trashes the Flock's beloved pumpkin patch! When Shaun turns mad scientist to fix the problem, things rapidly spi...              </span>\r\n\r\n                              <span class=\"synopsis-full hidden text-base\">\r\n                  Shaun The Sheep: The Beast Of Mossy Bottom sees the residents of Mossy Bottom Farm looking forward to Halloween - until the clumsy Farmer trashes the Flock's beloved pumpkin patch! When Shaun turns mad scientist to fix the problem, things rapidly spiral out of control... With The Farmer missing and a wild beast roaming the woods of Mossingham, all the ingredients are in place for a monstrously fun family adventure.                </span>\r\n\r\n                <button \r\n                  type=\"button\"\r\n                  class=\"ml-2 text-ompYellow underline text-base\"\r\n                  onclick=\"toggleSynopsis(this)\"\r\n                >\r\n                  See more\r\n                </button>\r\n                          </p>\r\n          <div class=\"hallTypeIcon hidden\">\r\n                                  </div>\r\n        </div>\r\n      </div>\r\n      <!-- C -->\r\n      <div class=\"col-span-3 md:col-span-5 md:col-start-1\">\r\n        <div class=\"w-full grid grid-cols-1 md:grid-cols-2 sm:col-span-2 xl:grid-cols-3  gap-2\">\r\n          <a aria-label=\"Shaun the Sheep: The Beast of Mossy Bottom at 15:40 in Screen 7\" href=\"https://www.omniplexcinemas.co.uk/booking/seats/sutton/48414\" class=\"\"> \r\n<div id=\"perf_0\" class=\"showTimeBox bg-ompGray-times p-2 col-span-1 rounded-xl\">\r\n  <div class=\"topSection flex justify-between items-end\">\r\n    <div class=\"flex items-end\">\r\n      <div class=\"flex items-baseline\">\r\n        <h4 class=\"bigText mr-1 leading-none\" aria-label=\"Shaun the Sheep: The Beast of Mossy Bottom at 15:40 in Screen 7\">\r\n          15:40        </h4>\r\n 