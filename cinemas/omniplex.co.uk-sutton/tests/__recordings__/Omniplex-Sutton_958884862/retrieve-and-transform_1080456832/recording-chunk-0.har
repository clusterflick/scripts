        </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      \"\r\n                      onclick=\"showCookiePolicy(true)\"                    >\r\n                      Manage Cookies                    </a>\r\n                  </li>\r\n                              </ul>\r\n            </div>\r\n                  </div>\r\n              <div id=\"footerColumn2\" class=\"space-y-8\">\r\n                      <div>\r\n                              <h4 class=\"mb-1 font-semibold text-white\">\r\n                  Omniplex Cinemas                </h4>\r\n              \r\n              <ul class=\"space-y-1\">\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/explore/careers\"\"\r\n                                          >\r\n                      Careers                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/explore/app\"\"\r\n                                          >\r\n                      Omniplex App                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/cinema/classics\"\"\r\n                                          >\r\n                      Classics                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/giftcards/choose\"\"\r\n                                          >\r\n                      Gift Cards                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/blog\"\"\r\n                                          >\r\n                      Blog                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/explore/competition\"\"\r\n                                          >\r\n                      Offers & Competitions                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/cinema/kids\"\"\r\n                                          >\r\n                      Kids Club                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/explore/meerkatmovies\"\"\r\n                                          >\r\n                      Meerkat Movies                    </a>\r\n                  </li>\r\n                              </ul>\r\n            </div>\r\n                      <div>\r\n                              <h4 class=\"mb-1 font-semibold text-white\">\r\n                  MyOmniPass                </h4>\r\n              \r\n              <ul class=\"spac