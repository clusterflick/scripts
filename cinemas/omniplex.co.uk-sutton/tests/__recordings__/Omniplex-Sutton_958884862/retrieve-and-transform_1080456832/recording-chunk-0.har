            "text": "<html>\r\n  <head>\r\n    <title>Spider-Man: Brand New Day | Cinema Showtimes</title>\r\n    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=iso-8859-1\" />\r\n    <meta name=\"name\" content=\"Spider-Man: Brand New Day playing at Omniplex Cinemas, browse the latest showtimes and purchase your tickets online today!\" />\r\n    <meta name=\"description\" content=\"Spider-Man: Brand New Day playing at Omniplex Cinemas, browse the latest showtimes and purchase your tickets online today!\" />\r\n    <meta name=\"keywords\" content=\"Omniplex Cinemas, Cinema in Ireland, Cinema, Movies, Films, MAXX Movies, 3D Movies, Book Tickets, Cinema Tickets, Cinema Times, Movies Times, \" />\r\n    <meta name=\"author\" content=\"Collaborative Software Limited\" />\r\n    <meta name=\"copyright\" content=\"Collaborative Software Limited\" />\r\n        <meta name=\"robots\" content=\"index,follow\" />\r\n    \r\n    <meta charset=\"UTF-8\">\r\n    <meta content=\"IE=Edge\" http-equiv=\"X-UA-Compatible\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n\r\n    <meta data-a1serv=\"omniweb10\" />\r\n    <meta data-a1php=\"8.0.27\" />\r\n    <meta data-a1phptime=\"20260921 20:26:39\" />\r\n    <meta data-a1mysqltime=\"20260921 20:26:39\" />\r\n    \r\n    <meta data-lat=\"\" />\r\n    <meta data-lon=\"\" />\r\n    \r\n    <meta name=\"twitter:card\" content=\"summary\" />\r\n    <meta name=\"twitter:site\" content=\"\" />\r\n    <meta name=\"twitter:creator\" content=\"\" />\r\n    <meta property=\"og:title\" content=\"Spider-Man: Brand New Day | Cinema Showtimes\" />\r\n    <meta property=\"og:description\" content=\"Spider-Man: Brand New Day playing at Omniplex Cinemas, browse the latest showtimes and purchase your tickets online today!\" />\r\n    <meta property=\"og:type\" content=\"website\" />\r\n    <meta property=\"og:url\" content=\"https://www.omniplexcinemas.co.uk/cinema/movie/sutton/spider-man-brand-new-