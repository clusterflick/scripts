         <p class=\"font-medium text-lg sm:text-2xl md:text-3xl leading-snug sm:leading-tight md:leading-tight mr-4\">\r\n              <a href=\"/cinema/movie/sutton/jackass-best-and-last\">\r\n                Jackass: Best and Last              </a>\r\n            </p>\r\n            <img data-toggle=\"0\" id=\"favourite110402\" onClick=\"toggleFavourite('110402');return false;\" src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_favourited-off.svg\" class=\"w-4 mt-2 mx-3\" alt=\"Add to Favourites\" />  \r\n          </div>\r\n          <div class=\"flex items-center gap-2 mb-2\">\r\n            <div class=\"flex flex-col md:flex-row gap-4\">\r\n              <div class=\"flex items-center gap-2\">\r\n                <img src=\"/images/ratings/UK_18.png\" class=\"w-4 min-w-[30px]\" />\r\n                <p class=\"text-base leading-snug font-normal leading-none\">Comedy, Documentary</p>\r\n              </div>\r\n              <p class=\"mb-2 md:m-auto flex item-center\"><span class=\"hidden md:flex mr-2\">|</span> 1hr 32min </p>\r\n            </div>\r\n          </div>\r\n          \r\n            <p class=\"hidden md:block mb-2 pt-2\">\r\n              <span class=\"synopsis-short\">\r\n                Johnny Knoxville and the gang return for one final fling at the big screen. Featuring all-new stunts and stupidity along with the greatest hits and biggest laughs from the past, jackass: best and last is a joyously raucous celebration of all the misc...              </span>\r\n\r\n                              <span class=\"synopsis-full hidden text-base\">\r\n                  Johnny Knoxville and the gang return for one final fling at the big screen. Featuring all-new stunts and stupidity along with the greatest hits and biggest laughs from the past, jackass: best and last is a joyously raucous celebration of all the mischievous camaraderie that you?ve come to love and expect from these idiots over the past 25 years. So, grab your dumb little buddies, raise your glasses, and come experience the cinematic event that promises to be the last time you?ll ever laugh this hard in a theatre.                </span>\r\n\r\n                <button \r\n                  type=\"button\"\r\n                  class=\"ml-2 text-ompYellow underline text-base\"\r\n                  onclick=\"toggleSynopsis(this)\"\r\n                >\r\n                  See more\r\n                </button>\r\n                          </p>\r\n          <div class=\"hallTypeIcon hidden\">\r\n                                  </div>\r\n        </div>\r\n      </div>\r\n      <!-- C -->\r\n      <div class=\"col-span-3 md:col-span-5 md:col-start-1\">\r\n        <div class=\"w-full grid grid-cols-1 md:grid-cols-2 sm:col-span-2 xl:grid-cols-3  gap-2\">\r\n          <a aria-label=\"Jackass: Best and Last at 20:20 in Screen 9\" href=\"https://www.omniplexcinemas.co.uk/booking/seats/sutton/44540\" class=\"\"> \r\n<div id=\"perf_0\" class=\"showTimeBox bg-ompGray-times p-2 col-span-1 rounded-xl\">\r\n  <div class=\"topSection flex justify-between items-end\">\r\n    <div class=\"flex items-end\">\r\n      <div class=\"flex items-baseline\">\r\n        <h4 class=\"bigText mr-1 leading-none\" aria-label=\"Jackass: Best and Last at 20:20 in Screen 9\">\r\n          20:20        </h4>\r\n        <p class=\"smallText leading-none\" aria-label=\"Jackass: Best and Last starts at 20:20 and ends at 21:52\">\r\n          - 21:52        </p>\r\n      </div>\r\n    </div>\r\n    <div class=\"flex items-end\">\r\n              <div class=\"flex items-baseline\">\r\n          <p class=\"smallText mr-1 leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            From\r\n          </p>\r\n          <h4 class=\"bigText leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            &pound;6.95          </h4>\r\n        </div>\r\n          </div>\r\n  </div>\r\n  <div class=\"midSection flex justify-between items-baseline\">\r\n\r\n    <div class=\"mb-2\"></div>\r\n  </div>\r\n  <div class=\"bottomSection flex justify-between items-baseline\">\r\n    <div class=\"flex items-baseline w-auto\">\r\n      <div class=\"flex items-start w-auto\">\r\n        <p class=\"smallText\">Screen 9</p>\r\n      </div> \r\n    </div>\r\n    <div class=\"flex items-baseline w-auto space-x-2\">\r\n        \r\n    \r\n\r\n</div>\r\n  </div>\r\n</div>\r\n</a>          </div>    \r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n  <!-- main grid  -->\r\n  <div class=\"grid grid-cols-1 md:grid-cols-6 lg:grid-cols-7 xl:grid-cols-10  bg-ompYellow-light/5 shadow-lg backdrop-blur-sm p-4 rounded-lg gap-4 xl:gap-8\">\r\n    <div class=\"hidden md:block col-span-1 md:col-span-1 lg:col-span-2 xl:col-span-2\">\r\n    <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n      <img\r\n        src=\"/cms/Disclosure-Day-Web-Poster (1).jpg\"\r\n        alt=\"Disclosure Day Event poster\"\r\n        class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n        data-eventCode=\"109930\"\r\n        data-eventCode=\"Disclosure Day\"\r\n      />\r\n              <img\r\n          onclick=\"playYoutubeVideo('icDuEHSxE-w')\"\r\n          src=\"/public/assets/svgs/play-circle.svg\"\r\n          alt=\"Play Trailler\"\r\n          class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n        />\r\n          </div>\r\n  </div>\r\n  <div class=\"md:col-span-5 lg:col-span-5 xl:col-span-8\">\r\n    <div class=\"grid grid-cols-3 md:grid-cols-5 gap-4 items-start\">\r\n      <!-- A (Mobile) -->\r\n      <div class=\"md:hidden col-span-1\">\r\n        <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n          <img\r\n            src=\"/cms/Disclosure-Day-Web-Poster (1).jpg\"\r\n            alt=\"Disclosure Day Event poster\"\r\n            class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n            data-eventCode=\"109930\"\r\n            data-eventCode=\"Disclosure Day\"\r\n          />\r\n                      <img\r\n              onclick=\"playYoutubeVideo('icDuEHSxE-w')\"\r\n              src=\"/public/assets/svgs/play-circle.svg\"\r\n              alt=\"Play Trailler\"\r\n              class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n            />\r\n                  </div>\r\n      </div>\r\n      <!-- B -->\r\n      <div class=\"col-span-2 md:col-span-5\">\r\n        <div class=\"w-full\">\r\n          <div class=\"flex justify-between items-start w-full mb-2\">\r\n            <p class=\"font-medium text-lg sm:text-2xl md:text-3xl leading-snug sm:leading-tight md:leading-tight mr-4\">\r\n              <a href=\"/cinema/movie/sutton/disclosure-day\">\r\n                Disclosure Day              </a>\r\n            </p>\r\n            <img data-toggle=\"0\" id=\"favourite109930\" onClick=\"toggleFavourite('109930');return false;\" src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_favourited-off.svg\" class=\"w-4 mt-2 mx-3\" alt=\"Add to Favourites\" />  \r\n          </div>\r\n          <div class=\"flex items-center gap-2 mb-2\">\r\n            <div class=\"flex flex-col md:flex-row gap-4\">\r\n              <div class=\"flex items-center gap-2\">\r\n                <img src=\"/images/ratings/UK_12A.png\" class=\"w-4 min-w-[30px]\" />\r\n                <p class=\"text-base leading-snug font-normal leading-none\">Action, Drama, Sci-Fi, Thriller</p>\r\n              </div>\r\n              <p class=\"mb-2 md:m-auto flex item-center\"><span class=\"hidden md:flex mr-2\">|</span> 2hrs 25min </p>\r\n            </div>\r\n          </div>\r\n          \r\n            <p class=\"hidden md:block mb-2 pt-2\">\r\n              <span class=\"synopsis-short\">\r\n                Disclosure Day is the latest epic from legendary filmmaker Steven Spielberg, marking his long-awaited return to large-scale science fiction. The film stars Emily Blunt, Josh O?Connor, Colman Domingo, Colin Firth and Eve Hewson, bringing together an e...              </span>\r\n\r\n                              <span class=\"synopsis-full hidden text-base\">\r\n                  Disclosure Day is the latest epic from legendary filmmaker Steven Spielberg, marking his long-awaited return to large-scale science fiction. The film stars Emily Blunt, Josh O?Connor, Colman Domingo, Colin Firth and Eve Hewson, bringing together an extraordinary ensemble for a story centred on humanity?s first undeniable encounter with extraterrestrial intelligence. Spielberg, who practically defined the genre with classics such as Close Encounters of the Third Kind, E.T. the Extra-Terrestrial and War of the Worlds, returns with a film that blends global spectacle with deeply human storytelling. At the heart of Disclosure Day is a moment that changes everything: the day the truth about alien contact is revealed to the world, triggering political upheaval, scientific discovery and a profound shift in how humanity understands its place in the universe.\r\n\r\nThe project represents Spielberg?s first major science-fiction film since 2018?s Ready Player One, and many observers see it as a spiritual return to the awe-filled cosmic storytelling that defined his early career. Working from a story developed with longtime collaborator David Koepp (Jurassic Park, War of the Worlds), the film combines mystery, wonder and global stakes as governments, scientists and ordinary people grapple with the greatest revelation in human history. Few filmmakers have shaped science fiction as profoundly as Spielberg, whose films helped transform the genre into one of cinema?s most emotionally resonant forms of storytelling. With Disclosure Day, he returns to the subject that helped define his career: the moment humanity looks to the sky and realises we are not alone.                </span>\r\n\r\n                <button \r\n                  type=\"button\"\r\n                  class=\"ml-2 text-ompYellow underline text-base\"\r\n                  onclick=\"toggleSynopsis(this)\"\r\n                >\r\n                  See more\r\n                </button>\r\n                          </p>\r\n          <div class=\"hallTypeIcon hidden\">\r\n                                  </div>\r\n        </div>\r\n      </div>\r\n      <!-- C -->\r\n      <div class=\"col-span-3 md:col-span-5 md:col-start-1\">\r\n        <div class=\"w-full grid grid-cols-1 md:grid-cols-2 sm:col-span-2 xl:grid-cols-3  gap-2\">\r\n          <a aria-label=\"Disclosure Day at 19:40 in Screen 4\" href=\"https://www.omniplexcinemas.co.uk/booking/seats/sutton/44764\" class=\"\"> \r\n<div id=\"perf_0\" class=\"showTimeBox bg-ompGray-times p-2 col-span-1 rounded-xl\">\r\n  <div class=\"topSection flex justify-between items-end\">\r\n    <div class=\"flex items-end\">\r\n      <div class=\"flex items-baseline\">\r\n        <h4 class=\"bigText mr-1 leading-none\" aria-label=\"Disclosure Day at 19:40 in Screen 4\">\r\n          19:40        </h4>\r\n        <p class=\"smallText leading-none\" aria-label=\"Disclosure Day starts at 19:40 and ends at 22:05\">\r\n          - 22:05        </p>\r\n      </div>\r\n    </div>\r\n    <div class=\"flex items-end\">\r\n              <div class=\"flex items-baseline\">\r\n          <p class=\"smallText mr-1 leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            From\r\n          </p>\r\n          <h4 class=\"bigText leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            &pound;6.95          </h4>\r\n        </div>\r\n          </div>\r\n  </div>\r\n  <div class=\"midSection flex justify-between items-baseline\">\r\n\r\n    <div class=\"mb-2\"></div>\r\n  </div>\r\n  <div class=\"bottomSection flex justify-between items-baseline\">\r\n    <div class=\"flex items-baseline w-auto\">\r\n      <div class=\"flex items-start w-auto\">\r\n        <p class=\"smallText\">Screen 4</p>\r\n      </div> \r\n    </div>\r\n    <div class=\"flex items-baseline w-auto space-x-2\">\r\n        \r\n    \r\n\r\n</div>\r\n  </div>\r\n</div>\r\n</a>          </div>    \r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n  <!-- main grid  -->\r\n  <div class=\"grid grid-cols-1 md:grid-cols-6 lg:grid-cols-7 xl:grid-cols-10  bg-ompYellow-light/5 shadow-lg backdrop-blur-sm p-4 rounded-lg gap-4 xl:gap-8\">\r\n    <div class=\"hidden md:block col-span-1 md:col-span-1 lg:col-span-2 xl:col-span-2\">\r\n    <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n      <img\r\n        src=\"/filmimages/small/93222.jpg?v=1551338112\"\r\n        alt=\"Michael Event poster\"\r\n        class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n        data-eventCode=\"93222\"\r\n        data-eventCode=\"Michael\"\r\n      />\r\n              <img\r\n          onclick=\"playYoutubeVideo('AuYmKbtnmEA')\"\r\n          src=\"/public/assets/svgs/play-circle.svg\"\r\n          alt=\"Play Trailler\"\r\n          class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n        />\r\n          </div>\r\n  </div>\r\n  <div class=\"md:col-span-5 lg:col-span-5 xl:col-span-8\">\r\n    <div class=\"grid grid-cols-3 md:grid-cols-5 gap-4 items-start\">\r\n      <!-- A (Mobile) -->\r\n      <div class=\"md:hidden col-span-1\">\r\n        <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n          <img\r\n            src=\"/filmimages/small/93222.jpg?v=1551338112\"\r\n            alt=\"Michael Event poster\"\r\n            class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n            data-eventCode=\"93222\"\r\n            data-eventCode=\"Michael\"\r\n          />\r\n                      <img\r\n              onclick=\"playYoutubeVideo('AuYmKbtnmEA')\"\r\n              src=\"/public/assets/svgs/play-circle.svg\"\r\n              alt=\"Play Trailler\"\r\n              class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n            />\r\n                  </div>\r\n      </div>\r\n      <!-- B -->\r\n      <div class=\"col-span-2 md:col-span-5\">\r\n        <div class=\"w-full\">\r\n          <div class=\"flex justify-between items-start w-full mb-2\">\r\n            <p class=\"font-medium text-lg sm:text-2xl md:text-3xl leading-snug sm:leading-tight md:leading-tight mr-4\">\r\n              <a href=\"/cinema/movie/sutton/michael\">\r\n                Michael              </a>\r\n            </p>\r\n            <img data-toggle=\"0\" id=\"favourite93222\" onClick=\"toggleFavourite('93222');return false;\" src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_favourited-off.svg\" class=\"w-4 mt-2 mx-3\" alt=\"Add to Favourites\" />  \r\n          </div>\r\n          <div class=\"flex items-center gap-2 mb-2\">\r\n            <div class=\"flex flex-col md:flex-row gap-4\">\r\n              <div class=\"flex items-center gap-2\">\r\n                <img src=\"/images/ratings/UK_12A.png\" class=\"w-4 min-w-[30px]\" />\r\n                <p class=\"text-base leading-snug font-normal leading-none\">Drama</p>\r\n              </div>\r\n              <p class=\"mb-2 md:m-auto flex item-center\"><span class=\"hidden md:flex mr-2\">|</span> 2hrs 07min </p>\r\n            </div>\r\n          </div>\r\n          \r\n            <p class=\"hidden md:block mb-2 pt-2\">\r\n              <span class=\"synopsis-short\">\r\n                A biopic exploring the life of Michael Jackson, from his Jackson 5 beginnings and extraordinary talent to his status as the biggest entertainer, promising an honest look at his triumphs, struggles, and iconic performances, starring his nephew Jaafar ...              </span>\r\n\r\n                              <span class=\"synopsis-full hidden text-base\">\r\n                  A biopic exploring the life of Michael Jackson, from his Jackson 5 beginnings and extraordinary talent to his status as the biggest entertainer, promising an honest look at his triumphs, struggles, and iconic performances, starring his nephew Jaafar Jackson as Michael, with Colman Domingo &amp; Nia Long as his parents, directed by Antoine Fuqua.                </span>\r\n\r\n                <button \r\n                  type=\"button\"\r\n                  class=\"ml-2 text-ompYellow underline text-base\"\r\n                  onclick=\"toggleSynopsis(this)\"\r\n                >\r\n                  See more\r\n                </button>\r\n                          </p>\r\n          <div class=\"hallTypeIcon hidden\">\r\n                                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_dbox-orange.svg\" class=\"h-4 w-auto my-2\" alt=\"Event Type Icon\" />\r\n                                                </div>\r\n        </div>\r\n      </div>\r\n      <!-- C -->\r\n      <div class=\"col-span-3 md:col-span-5 md:col-start-1\">\r\n        <div class=\"w-full grid grid-cols-1 md:grid-cols-2 sm:col-span-2 xl:grid-cols-3  gap-2\">\r\n          <a aria-label=\"Michael at 18:50 in DBOX 12\" href=\"https://www.omniplexcinemas.co.uk/booking/seats/sutton/44547\" class=\"\"> \r\n<div id=\"perf_0\" class=\"showTimeBox bg-ompGray-times p-2 col-span-1 rounded-xl\">\r\n  <div class=\"topSection flex justify-between items-end\">\r\n    <div class=\"flex items-end\">\r\n      <div class=\"flex items-baseline\">\r\n        <h4 class=\"bigText mr-1 leading-none\" aria-label=\"Michael at 18:50 in DBOX 12\">\r\n          18:50        </h4>\r\n        <p class=\"smallText leading-none\" aria-label=\"Michael starts at 18:50 and ends at 20:57\">\r\n          - 20:57        </p>\r\n      </div>\r\n    </div>\r\n    <div class=\"flex items-end\">\r\n              <div class=\"flex items-baseline\">\r\n          <p class=\"smallText mr-1 leading-none\" aria-label=\"Cost starting from &pound;13.95\">\r\n            From\r\n          </p>\r\n          <h4 class=\"bigText leading-none\" aria-label=\"Cost starting from &pound;13.95\">\r\n            &pound;13.95          </h4>\r\n        </div>\r\n          </div>\r\n  </div>\r\n  <div class=\"midSection flex justify-between items-baseline\">\r\n\r\n    <div class=\"mb-2\"></div>\r\n  </div>\r\n  <div class=\"bottomSection flex justify-between items-baseline\">\r\n    <div class=\"flex items-baseline w-auto\">\r\n      <div class=\"flex items-start w-auto\">\r\n        <p class=\"smallText\">DBOX 12</p>\r\n      </div> \r\n    </div>\r\n    <div class=\"flex items-baseline w-auto space-x-2\">\r\n                  <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_dbox-orange.svg\" class=\"h-[17px] w-auto\" alt=\"Hall Type Icon\" />\r\n              \r\n    \r\n\r\n</div>\r\n  </div>\r\n</div>\r\n</a>          </div>    \r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"main-container my-mid block md:hidden\">\r\n  <button id=\"aboutToggle\" class=\"flex items-center text-ompYellow font-semibold w-full text-left\">\r\n    <p class=\"\">Sutton Surrey Omniplex</p>\r\n    <i id=\"aboutIcon\" class=\"icon omni-chevron-up pl-4\"></i>\r\n  </button>\r\n  <div id=\"aboutSiteSection\" class=\"mt-4 hidden\">\r\n    <div>\r\n      Omniplex Cinema Sutton is a 12-screen cinema in Sutton, surrounded by a great selection of local restaurants, shops and facilities. Check out all of the latest movies and classic re-releases in this modern multiplex. It is the perfect place for lovers of the big screen. \r\n\r\nWhat to expect at Omniplex Cinema Sutton:\r\n\r\nAt Omniplex Cinema Sutton, watch your new favourite movies on our cutting-edge OmniplexMAXX screen. This cinema also features Recline seats, Sofa seats 3D performances, assigned seating and wheelchair-accessibility. Before heading into the screen, stock up on fresh popcorn made on-site, as well as nachos,hotdogs, sweets and soft drinks. We offer free parking for up to 3 hours! Simply ask our cinema staff to stamp your parking ticket.    </div>\r\n  </div>\r\n  <div class=\"mt-4\">\r\n      </div>\r\n</div>\r\n\r\n<script>\r\n  document.addEventListener('DOMContentLoaded', function () {\r\n    const toggle = document.getElementById('aboutToggle');\r\n    const section = document.getElementById('aboutSiteSection');\r\n    const icon = document.getElementById('aboutIcon');\r\n    toggle.addEventListener('click', function () {\r\n      section.classList.toggle('hidden');\r\n      icon.classList.toggle('omni-chevron-down');\r\n      icon.classList.toggle('omni-chevron-up');\r\n    });\r\n  });\r\n\r\nfunction clearFIlters(){\r\n  const clearFiltersButton = document.getElementById('clearFilters');\r\n  clearFiltersButton.click();\r\n}\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n  var showcase = new Splide('#showcase', {\r\n    type: 'loop',\r\n    perPage: 1.2,\r\n    loop: true,\r\n    gap: '20px',\r\n    focus: 'center',\r\n    arrows: false,\r\n    pagination: false,\r\n    trimSpace: false,\r\n    autoHeight: true,\r\n    clones: 2,\r\n    // Auto scroll\r\n    autoplay: true,\r\n    interval: 5000,\r\n    pauseOnHover: true,\r\n    pauseOnFocus: true,\r\n  });\r\n  showcase.mount();\r\n});\r\n\r\nfunction toggleSynopsis(btn) {\r\n  const container = btn.parentElement;\r\n  const shortText = container.querySelector('.synopsis-short');\r\n  const fullText = container.querySelector('.synopsis-full');\r\n\r\n  const isHidden = fullText.classList.contains('hidden');\r\n\r\n  if (isHidden) {\r\n    shortText.classList.add('hidden');\r\n    fullText.classList.remove('hidden');\r\n    btn.textContent = 'See less';\r\n  } else {\r\n    shortText.classList.remove('hidden');\r\n    fullText.classList.add('hidden');\r\n    btn.textContent = 'See more';\r\n  }\r\n}\r\n\r\nfunction showSearchBox(){\r\n  const searchBoxContainer =  document.getElementById('searchBoxContainer');\r\n\r\n  searchBoxContainer.classList.toggle('hidden');\r\n}\r\n</script>\r\n\r\n\r\n    <div class=\"main-container my-big \">\r\n              <div class=\"grid grid-cols-6 gap-6\">\r\n                      \r\n            <div class=\"col-span-6 md:col-span-2 rounded-xl overflow-hidden bg-black\">\r\n              <div\r\n                class=\"h-[300px] flex flex-col justify-end p-6 bg-cover bg-center\"\r\n                style=\"background-image: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.2)), url('/cms/footerads/opass.png'); background-position: right top;\"\r\n              >\r\n                                  <h3 class=\"text-xl font-semibold mb-2 text-white\">\r\n                    Get a ticket to every movie at Omniplex with a monthly 'MyOmniPass' subscription.                  </h3>\r\n                \r\n                                  <p class=\"text-sm mb-4 text-white\">\r\n                    Terms &amp; Exclusions Apply                  </p>\r\n                \r\n                                  <a\r\n                    href=\"/join/landing\"\r\n                    class=\"text-center font-semibold bg-white/20 hover:bg-white/30 transition px-4 py-2 rounded-md text-sm w-full text-white\"\r\n                  >\r\n                    Find out more                  </a>\r\n                              </div>\r\n            </div>\r\n                      \r\n            <div class=\"col-span-6 md:col-span-2 rounded-xl overflow-hidden bg-black\">\r\n              <div\r\n                class=\"h-[300px] flex flex-col justify-end p-6 bg-cover bg-center\"\r\n                style=\"background-image: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.2)), url('/cms/footerads/gcard.png'); background-position: right top;\"\r\n              >\r\n                                  <h3 class=\"text-xl font-semibold mb-2 text-white\">\r\n                    For the superhero in your life...                  </h3>\r\n                \r\n                                  <p class=\"text-sm mb-4 text-white\">\r\n                    Get them an Omniplex Gift Card                  </p>\r\n                \r\n                                  <a\r\n                    href=\"/giftcards/choose\"\r\n                    class=\"text-center font-semibold bg-white/20 hover:bg-white/30 transition px-4 py-2 rounded-md text-sm w-full text-white\"\r\n                  >\r\n                    Get a Gift Card                  </a>\r\n                              </div>\r\n            </div>\r\n                      \r\n            <div class=\"col-span-6 md:col-span-2 rounded-xl overflow-hidden bg-black\">\r\n              <div\r\n                class=\"h-[300px] flex flex-col justify-end p-6 bg-cover bg-center\"\r\n                style=\"background-image: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.2)), url('/cms/footerads/kids.png'); background-position: right top;\"\r\n              >\r\n                                  <h3 class=\"text-xl font-semibold mb-2 text-white\">\r\n                    Perfect for a day out with the kids                  </h3>\r\n                \r\n                                  <p class=\"text-sm mb-4 text-white\">\r\n                    Best movies and treats for all                  </p>\r\n                \r\n                                  <a\r\n                    href=\"/cinema/kids\"\r\n                    class=\"text-center font-semibold bg-white/20 hover:bg-white/30 transition px-4 py-2 rounded-md text-sm w-full text-white\"\r\n                  >\r\n                     See our Kids offerings                  </a>\r\n                              </div>\r\n            </div>\r\n                  </div>\r\n          </div>\r\n       \r\n<div id=\"footerContact\" class=\"bg-[#282828] mt-8\">\r\n  <div class=\"w-full text-center py-8\">\r\n    <h4 class=\"text-ompYellow text-2xl font-bold\">Need help?</h4>\r\n    <p class=\"\">Get in touch with your local cinema now:</p>\r\n    <div class=\"input-container mb-4 main-container mt-4\">\r\n      <div class=\"input-select mx-auto w-full md:w-2/3 lg:w-1/2\">\r\n        <select id=\"conactlocalCinema\" name=\"sitecode\" class=\"select-input\">\r\n          <