ass=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Comedy\" class=\"cursor-pointer\">Comedy (4)</label>\r\n              <input type=\"checkbox\" id=\"genre_Comedy\" name=\"genre_Comedy\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Documentary\" class=\"cursor-pointer\">Documentary (1)</label>\r\n              <input type=\"checkbox\" id=\"genre_Documentary\" name=\"genre_Documentary\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Drama\" class=\"cursor-pointer\">Drama (7)</label>\r\n              <input type=\"checkbox\" id=\"genre_Drama\" name=\"genre_Drama\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Event\" class=\"cursor-pointer\">Event (15)</label>\r\n              <input type=\"checkbox\" id=\"genre_Event\" name=\"genre_Event\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Family\" class=\"cursor-pointer\">Family (1)</label>\r\n              <input type=\"checkbox\" id=\"genre_Family\" name=\"genre_Family\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Fantasy\" class=\"cursor-pointer\">Fantasy (3)</label>\r\n              <input type=\"checkbox\" id=\"genre_Fantasy\" name=\"genre_Fantasy\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Horror\" class=\"cursor-pointer\">Horror (3)</label>\r\n              <input type=\"checkbox\" id=\"genre_Horror\" name=\"genre_Horror\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Romance\" class=\"cursor-pointer\">Romance (1)</label>\r\n              <input type=\"checkbox\" id=\"genre_Romance\" name=\"genre_Romance\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Sci-Fi\" class=\"cursor-pointer\">Sci-Fi (4)</label>\r\n              <input type=\"checkbox\" id=\"genre_Sci-Fi\" name=\"genre_Sci-Fi\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Thriller\" class=\"cursor-pointer\">Thriller (7)</label>\r\n              <input type=\"checkbox\" id=\"genre_Thriller\" name=\"genre_Thriller\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n              \r\n        </div> -->\r\n            \r\n      <div class=\"mb-big\">\r\n        <h3 class=\"text-md font-semibold\">Accessibility Options</h3>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-audio-described\"></i>\r\n              <label for=\"audioDescriptionFilter\" class=\"cursor-pointer font-medium\">Audio Description</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"audioDescriptionFilter\" name=\"access_audioDescription\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Grab a headset and enjoy detailed screen descriptions. <a href=\"/filters/audiodescribed\" class=\"text-ompYellow\">Learn more</a></p> \r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-sensory-friendly-56\"></i>\r\n              <label for=\"sensoryFriendlyFilter\" class=\"cursor-pointer font-medium\">Sensory Friendly</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"sensoryFriendlyFilter\" name=\"access_sensoryFriendly\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Held every weekend around noon at all Omniplex cinemas. <a href=\"/filters/sensoryfriendly\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>        \r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-subtitles\"></i>\r\n              <label for=\"subtitledFilter\" class=\"cursor-pointer font-medium\">Subtitled</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"subtitledFilter\" name=\"access_subtitled\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Available for blockbuster movies on Monday evenings. <a href=\"/filters/subtitled\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>        \r\n      </div>      \r\n          \r\n      <div class=\"mb-big\">\r\n        <h3 class=\"text-md font-semibold\">Special Screenings</h3>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-kids-club\"></i>\r\n              <label for=\"kidsClubFilter\" class=\"cursor-pointer font-medium\">Kids Club</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"kidsClubFilter\" name=\"special_kidsClub\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Save on select family films every weekend. <a href=\"/filters/kidsclub\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>\r\n        <!-- Seniors Club  -->\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <img src=\"/public/assets/svgs/seniorClub_icon.svg\" class=\"w-4 h-4 mr-2\">\r\n              <label for=\"seniorClubFilter\" class=\"cursor-pointer font-medium\">Senior Club Screening</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"seniorClubFilter\" name=\"special_seniorClub\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Held every Wednesday in early afternoon shopwtimes. <a href=\"/filters/seniorsclub\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-secret-screeningss\"></i>\r\n              <label for=\"secretScreenFilter\" class=\"cursor-pointer font-medium\">Secret Screenings</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"secretScreenFilter\" name=\"special_secretScreen\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">You'll know the genre, but the movie is a surprise! <a href=\"/filters/secretscreenings\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-live-and-eventss\"></i>\r\n              <label for=\"liveEventsFilter\" class=\"cursor-pointer font-medium\">Live &amp; Events</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"liveEventsFilter\" name=\"special_liveEvents\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Watch pre-recorded and live events from around the world on the big screen. <a href=\"/filters/liveevents\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-star-full\"></i>\r\n              <label for=\"classicsFilter\" class=\"cursor-pointer font-medium\">Classics</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"classicsFilter\" name=\"special_classics\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Relive fan-favourite classics on the big screen every month.</p>\r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-kids-club\"></i>\r\n              <label for=\"parentbabyFilter\" class=\"cursor-pointer font-medium\">Parent &amp; Baby</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"parentbabyFilter\" name=\"special_parentbaby\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Wednesdays for movie time with your little one! <a href=\"#\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>        \r\n      </div>    \r\n        </div>\r\n    \r\n    <!-- Footer: Fixed Bottom Buttons -->\r\n    <div class=\"px-8 py-4 bg-black border-t border-gray-700\">\r\n      <div class=\"flex justify-between\">\r\n        <button id=\"clearFilters\" class=\"mx-2 w-full bg-gray-600 px-4 py-2 rounded text-white\">Clear all</button>\r\n        <button id=\"applyFilters\" class=\"mx-2 w-full bg-ompYellow px-4 py-2 rounded text-black\">Apply</button>\r\n      </div>\r\n    </div>\r\n  </form>\r\n</div><!-- Info Start  -->\r\n<!-- Info End  -->\r\n\r\n<!-- Success Alert Start  -->\r\n<!-- Success Alert End  -->\r\n\r\n<!-- Error Alert Start  -->\r\n<!-- Error Alert End  -->\r\n\r\n<script>\r\ndocument.addEventListener(\"DOMContentLoaded\", function() {\r\n  document.querySelectorAll('.relative').forEach(function(alert) {\r\n    requestAnimationFrame(function() {\r\n      alert.classList.remove('hidden');\r\n      alert.classList.add('block');\r\n    });\r\n  });\r\n  document.querySelectorAll('.close-alert').forEach(function(button) {\r\n    button.addEventListener('click', function() {\r\n      const alertDiv = button.closest('.relative');\r\n      if (alertDiv) {\r\n        alertDiv.classList.remove('block');\r\n        alertDiv.classList.add('hidden');\r\n      }\r\n    });\r\n  });\r\n});\r\n</script>\r\n<!-- Display when user clicks star to remove from watch list  -->\r\n<div id=\"removeFavouriteMovie\" class=\"overflow-hidden hidden\">\r\n  <div class=\"fixed inset-0 flex items-center justify-center z-50\">\r\n    <div id=\"backgroundOverlay\" class=\"absolute inset-0 bg-black opacity-90 pointer-events-none\"></div>\r\n    <div class=\"relative p-6 rounded shadow-lg z-10\">\r\n      <p class=\"mb-4\">Do you want to remove this movie from your Want to Watch List?</p>\r\n      <h2 class=\"text-4xl font-bold my-mid text-center\" id=\"removeFavouriteMovieName\">Stolen</h2>\r\n      <div class=\"\">\r\n        <input type=\"hidden\" id=\"removeFavouriteMovieCode\" value=\"\" />\r\n        <button class=\"btn-solid-yellow mb-4\" onClick=\"removeFavourite();return false;\">Yes, remove from my list</button>\r\n        <button class=\"btn-solid-gray\" onClick=\"closeRemoveFavouriteModal();return false;\">No, go back</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>  \r\n<!-- END - Display when user clicks star to remove from watch list  -->\r\n\r\n\r\n<!-- Display when user selects a different site for food  -->\r\n<div id=\"confirmFoodSite\" class=\"overflow-hidden hidden\">\r\n  <div class=\"fixed inset-0 flex items-center justify-center z-50\">\r\n    <div id=\"backgroundOverlay\" class=\"absolute inset-0 bg-black/70 backdrop-blur-sm pointer-events-none\"></div>\r\n    <div class=\"relative p-6 rounded shadow-lg z-10 bg-ompGray rounded-lg\">\r\n            <p class=\"mb-4\">You are ordering food for collection at</p>\r\n      <h2 class=\"text-4xl font-bold my-mid text-center\" id=\"closeConfirmFoodSiteName\">Site Name</h2>\r\n      <div class=\"\">\r\n      <button class=\"btn-solid-yellow mb-2\" onClick=\"sumbitForm()\">Confirm</button>\r\n      <button class=\"btn-solid-gray\" onClick=\"closeConfirmFoodSite();return false;\">No, go back</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>  \r\n<!-- END - Display when user selects a different site for food  -->\r\n\r\n\r\n<!-- Display when user selects a different site for food  -->\r\n<div id=\"cancelMembership\" class=\"overflow-hidden hidden\">\r\n  <div class=\"fixed inset-0 flex items-center justify-center z-50\">\r\n    <div id=\"backgroundOverlay\" class=\"absolute inset-0 bg-black/70 backdrop-blur-sm pointer-events-none\"></div>\r\n    <div class=\"relative p-6 rounded shadow-lg z-10 bg-ompGray rounded-lg\">\r\n      <p class=\"mb-4\">Are you sure you want to cancel your membership?</p>\r\n      <div class=\"\">\r\n        <button class=\"btn-solid-yellow mb-2\" onclick=\"cancelScheme()\">Confirm</button>\r\n        <button class=\"btn-solid-gray\" onClick=\"closeCancelMembership();return false;\">No, go back</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>  \r\n<!-- END - Display when user selects a different site for food  -->  <div class=\"main-container-full block md:hidden mb-mid relative z-[5]\">\r\n    <div class=\"w-full z-50\">\r\n      <div id=\"mobileSliderNav\" class=\"group-nav-container\" style=\"cursor: grab;\">\r\n        <!-- active  -->\r\n                    <button\r\n              onclick=\"navigateTo('/cinema/showtimes')\"\r\n              class=\"group-nav-item active\"\r\n            >\r\n              <p>Showtimes</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/cinema/movies')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Trailers</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/cinema/events')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Events</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/cinema/kids')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Kids &amp; Family</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/booking/extras-home')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Food</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/company/about')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Our Cinema</p>\r\n            </button>\r\n              </div>\r\n    </div>\r\n  </div>\r\n  <script>\r\n    document.addEventListener('DOMContentLoaded', () => {\r\n\r\n      const nav = document.getElementById('mobileSliderNav');\r\n      if (!nav) return;\r\n\r\n      const items = Array.from(nav.querySelectorAll('.group-nav-item'));\r\n      const sections = items.map(btn => document.getElementById(btn.dataset.target));\r\n\r\n      let suppressNavClick = false;\r\n\r\n      // Expose to inline onclick\r\n      window.navigateTo = function(url) {\r\n        if (suppressNavClick) return;\r\n        window.location.href = url;\r\n      };\r\n\r\n      function setActive(activeIdx) {\r\n        items.forEach((btn, i) => {\r\n          btn.classList.toggle('active', i === activeIdx);\r\n        });\r\n      }\r\n\r\n      function centerNavItem(btn, behavior = 'smooth') {\r\n        const desired =\r\n          btn.offsetLeft + (btn.offsetWidth / 2) - (nav.clientWidth / 2);\r\n\r\n        const maxScroll = nav.scrollWidth - nav.clientWidth;\r\n        const clamped = Math.max(0, Math.min(desired, maxScroll));\r\n\r\n        nav.scrollTo({\r\n          left: clamped,\r\n          behavior\r\n        });\r\n      }\r\n\r\n      // Center active item on load\r\n      const initiallyActive = nav.querySelector('.group-nav-item.active');\r\n      if (initiallyActive) centerNavItem(initiallyActive, 'auto');\r\n\r\n      // --- Drag to scroll ---\r\n      (function enableDragScroll(container) {\r\n\r\n        let isDown = false;\r\n        let startX = 0;\r\n        let startScrollLeft = 0;\r\n        let dragging = false;\r\n\r\n        const DRAG_THRESHOLD = 10;\r\n\r\n        container.style.cursor = 'grab';\r\n\r\n        container.addEventListener('pointerdown', (e) => {\r\n          if (e.pointerType === 'mouse' && e.button !== 0) return;\r\n\r\n          isDown = true;\r\n          dragging = false;\r\n          startX = e.clientX;\r\n          startScrollLeft = container.scrollLeft;\r\n\r\n          container.style.cursor = 'grabbing';\r\n        });\r\n\r\n        container.addEventListener('pointermove', (e) => {\r\n          if (!isDown) return;\r\n\r\n          const dx = e.clientX - startX;\r\n\r\n          if (!dragging && Math.abs(dx) > DRAG_THRESHOLD) {\r\n            dragging = true;\r\n          }\r\n\r\n          if (dragging) {\r\n            if (e.cancelable) e.preventDefault();\r\n            container.scrollLeft = startScrollLeft - dx;\r\n          }\r\n\r\n        }, { passive: false });\r\n\r\n        container.addEventListener('pointerup', () => {\r\n          isDown = false;\r\n          container.style.cursor = 'grab';\r\n\r\n          if (dragging) {\r\n            suppressNavClick = true;\r\n            setTimeout(() => {\r\n              suppressNavClick = false;\r\n            }, 0);\r\n          }\r\n        });\r\n\r\n        container.addEventListener('pointercancel', () => {\r\n          isDown = false;\r\n          container.style.cursor = 'grab';\r\n        });\r\n\r\n      })(nav);\r\n\r\n    });\r\n  </script>\r\n\r\n\r\n<!-- Here   -->\r\n\r\n<link rel=\"stylesheet\" href=\"/include/A1CookieManager/css/main.css?v=20260907_01\" type=\"text/css\"> \r\n<div id=\"cookieOverlay\" class=\"OMP_overlay backdrop-blur-sm\" style=\"pointer-events:none;\"></div>\r\n<div id=\"cookieConsentBar\" style=\"display: none;\">\r\n  <div class=\"cookie-consent-banner\">\r\n    <p>We use cookies on our website to personalise and improve your experience and ensure the website works\r\n      correctly.\r\n      <a style=\"text-decoration:underline;\" href=\"/company/privacy#cookieAnchor\" target=\"_blank\">View our Cookie Policy</a>.\r\n    </p>\r\n    <div class=\"cookie-buttons\">\r\n      \r\n    <button id=\"managePrefs\" onclick=\"toggleManage()\" class=\"cookie-button btn-solid-gray !mx-px\" id=\"manage-cookies\">Manage</button>\r\n      <button id=\"savePrefs\" onclick=\"checkCookiePerfs()\" class=\"cookie-button btn-solid-yellow !mx-px\" style=\"display:none;\">Save Preferences</button>\r\n    <button id=\"acceptAll\" onclick=\"setCookieCookie('ALL')\" class=\"cookie-button btn-solid-yellow !mx-px\">Accept All</button>\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"manageOptions\" style=\"display:none;\">\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Necessary</h3>\r\n                      <p>Necessary cookies are required to enable the basic features of this site, such as providing secure log-in or adjusting your consent preferences. These cookies do not store any personally identifiable data.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Necessary\"\r\n                                  checked                                  disabled>\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreNecessary')\">More Details</button>\r\n              <div id=\"moreNecessary\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                                                  <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> a1wcc</li>\r\n                              <li><strong>Duration:</strong> 1 year</li>\r\n                              <li><strong>Description:</strong> Stores the user&rsquo;s consent and preferences for website cookies. This cookie remembers the user&rsquo;s choices regarding the acceptance or rejection of specific cookie categories, ensuring personalized settings are applied on subsequent visits.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> PHPSESSID</li>\r\n                              <li><strong>Duration:</strong> Session</li>\r\n                              <li><strong>Description:</strong> Creates a unique session identifier for each visitor to maintain session data across multiple pages. It does not contain personal information and is deleted when the user closes their browser. This cookie is essential for enabling user functionalities and preferences during the active session.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> __cflb</li>\r\n                              <li><strong>Duration:</strong> 24 hours</li>\r\n                              <li><strong>Description:</strong> CloudFlare&rsquo;s session affinity cookie used to map your session to the correct server.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> sitecode</li>\r\n                              <li><strong>Duration:</strong> 1 hour</li>\r\n                              <li><strong>Description:</strong> The cinema location you have selected.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> omnicustomer</li>\r\n                              <li><strong>Duration:</strong> 2 weeks</li>\r\n                              <li><strong>Description:</strong> A token for the login, if &lsquo;stay logged in&rsquo; is selected.</li>\r\n                          </ul>\r\n                                                      </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Analytics</h3>\r\n                      <p>Analytical cookies are used to understand how visitors interact with the website. These cookies help provide information on metrics such as the number of visitors, bounce rate, traffic source, etc.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Analytics\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreAnalytics')\">More Details</button>\r\n              <div id=\"moreAnalytics\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                                                  <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _ga</li>\r\n                              <li><strong>Duration:</strong> 2 years</li>\r\n                              <li><strong>Description:</strong> Registers a unique ID that is used to generate statistical data on how the visitor uses the website.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _ga_C6EGS4GGTV</li>\r\n                              <li><strong>Duration:</strong> 2 years</li>\r\n                              <li><strong>Description:</strong> Used by Google Analytics to collect data on the number of times a user has visited the website as well as dates for the first and most recent visit.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _ga_Y8PVGSGW5G</li>\r\n                              <li><strong>Duration:</strong> 2 years</li>\r\n                              <li><strong>Description:</strong> Used to persist session state.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _gat_gtag_UA_2532751_2</li>\r\n                              <li><strong>Duration:</strong> 1 minute</li>\r\n                              <li><strong>Description:</strong> Used by Google Analytics to throttle request rate.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _gat_gtag_UA_56401285_6</li>\r\n                              <li><strong>Duration:</strong> 1 minute</li>\r\n                              <li><strong>Description:</strong> Used to throttle request rate.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _gid</li>\r\n                              <li><strong>Duration:</strong> 24 hours</li>\r\n                              <li><strong>Description:</strong> Registers a unique ID that is used to generate statistical data on how the visitor uses the website.</li>\r\n                          </ul>\r\n                                                      </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Functional</h3>\r\n                      <p>Functional cookies help perform certain functionalities like sharing the content of the website on social media platforms, collecting feedback, and other third-party features.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Functional\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreFunctional')\">More Details</button>\r\n              <div id=\"moreFunctional\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Performance</h3>\r\n                      <p>Performance cookies are used to understand and analyze the key performance indexes of the website which helps in delivering a better user experience for the visitors.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Performance\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('morePerformance')\">More Details</button>\r\n              <div id=\"morePerformance\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Advertisement</h3>\r\n                      <p>Advertisement cookies are used to provide visitors with customized advertisements based on the pages you visited previously and to analyze the effectiveness of the ad campaigns.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Advertisement\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreAdvertisement')\">More Details</button>\r\n              <div id=\"moreAdvertisement\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Other</h3>\r\n                      <p>Other uncategorized cookies are those that are being analyzed and have not been classified into a category as yet.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Other\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreOther')\">More Details</button>\r\n              <div id=\"moreOther\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n    </div>\r\n</div>\r\n\r\n<script type=\"text/javascript\" src=\"/include/A1CookieManager/script/main.js?v=20260907_01\"></script>\r\n\r\n<div id=\"siteModal\" class=\"fixed inset-0 z-[60] flex items-center justify-center p-4 hidden\">\r\n  <div class=\"absolute inset-0 bg-black/70 backdrop-blur-sm\"></div>\r\n  <div class=\"relative z-[70] w-full max-w-[640px] h-[85vh]\">\r\n    <style>\r\n  #siteScrollArea {\r\n    -ms-overflow-style: none;\r\n    scrollbar-width: none;\r\n  }\r\n\r\n  #siteScrollArea::-webkit-scrollbar {\r\n    display: none;\r\n  }\r\n</style>\r\n\r\n<div class=\"flex h-full flex-col overflow-hidden rounded-xl bg-[#282828]\">\r\n\r\n  <div class=\"shrink-0 bg-[#282828] px-4 pt-8 pb-4\">\r\n    <div class=\"text-right mb-4 px-4\">\r\n      <i onclick=\"toggleLoginModal()\" class=\"text-ompYellow icon omni-close cursor-pointer\"></i>\r\n    </div>\r\n    <div class=\"w-full md:w-3/4 mx-auto w-full max-w-[560px]\">\r\n      <div id=\"login_section\" class=\"mb-6 w-full\">\r\n        <h1 class=\"text-3xl leading-tight font-normal text-white\">\r\n          Which is your local Omniplex?\r\n        </h1>\r\n      </div>\r\n\r\n      <div class=\"input-search  overflow-hidden rounded-md\">\r\n        <i class=\"icon omni-search text-white/80\"></i>\r\n        <input id=\"search\" placeholder=\"Search\" type=\"text\" class=\"text-white placeholder:text-white/50\" />\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"siteScrollArea\" class=\"flex-1 overflow-y-auto px-4\">\r\n    <div class=\"w-full md:w-3/4 mx-auto w-full max-w-[560px] py-6\">\r\n      <div id=\"site-selection-list\" class=\"border-t border-b border-ompYellow/30 py-4\">\r\n        <form id=\"siteList-modal\">\r\n          \r\n          <div class=\"region-group mb-2\"><div class=\"region-header flex cursor-pointer items-center justify-between py-3\"><p class=\"text-xl text-white\">England</p><i class=\"icon-swtich icon omni-chevron-up text-xl text-white\"></i></div><div class=\"region-items\"><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Birmingham - Great Park</p></div><div><input type=\"checkbox\" value=\"OMP_BIRM\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">High Wycombe</p></div><div><input type=\"checkbox\" value=\"OMP_HIWY\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Ipswich</p></div><div><input type=\"checkbox\" value=\"OMP_IPSW\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Sunderland</p></div><div><input type=\"checkbox\" value=\"OMP_SUND\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Sutton Surrey</p></div><div><input type=\"checkbox\" value=\"OMP_SUTT\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Wigan</p></div><div><input type=\"checkbox\" value=\"OMP_WIGA\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div></div></div><div class=\"region-group mb-2\"><div class=\"region-header flex cursor-pointer items-center justify-between py-3\"><p class=\"text-xl text-white\">Scotland</p><i class=\"icon-swtich icon omni-chevron-up text-xl text-white\"></i></div><div class=\"region-items\"><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Clydebank</p></div><div><input type=\"checkbox\" value=\"OMP_CLYD\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Glasgow - Renfrew Street</p></div><div><input type=\"checkbox\" value=\"OMP_GLAS\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div></div></div><div class=\"region-group mb-2\"><div class=\"region-header flex cursor-pointer items-center justify-between py-3\"><p class=\"text-xl text-white\">Northern Ireland</p><i class=\"icon-swtich icon omni-chevron-up text-xl text-white\"></i></div><div class=\"region-items\"><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Antrim</p></div><div><input type=\"checkbox\" value=\"OMP_ANTR\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Banbridge</p></div><div><input type=\"checkbox\" value=\"OMP_BANB\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Bangor</p></div><div><input type=\"checkbox\" value=\"OMP_BANG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Belfast - Dundonald</p></div><div><input type=\"checkbox\" value=\"OMP_DUDO\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Belfast - Kennedy Centre</p></div><div><input type=\"checkbox\" value=\"OMP_KENN\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Carrickfergus</p></div><div><input type=\"checkbox\" value=\"OMP_CARR\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Craigavon</p></div><div><input type=\"checkbox\" value=\"OMP_CRAI\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Derry</p></div><div><input type=\"checkbox\" value=\"OMP_DERR\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Downpatrick</p></div><div><input type=\"checkbox\" value=\"OMP_DOWN\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Dungannon</p></div><div><input type=\"checkbox\" value=\"OMP_DUGA\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Larne</p></div><div><input type=\"checkbox\" value=\"OMP_LARN\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Lisburn</p></div><div><input type=\"checkbox\" value=\"OMP_LISB\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Newry</p></div><div><input type=\"checkbox\" value=\"OMP_NEWR\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Omagh</p></div><div><input type=\"checkbox\" value=\"OMP_OMAG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div></div></div><div class=\"region-group mb-2\"><div class=\"region-header flex cursor-pointer items-center justify-between py-3\"><p class=\"text-xl text-white\">Rep. of Ireland</p><i class=\"icon-swtich icon omni-chevron-up text-xl text-white\"></i></div><div class=\"region-items\"><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Arklow</p></div><div><input type=\"checkbox\" value=\"OMP_ARKL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Ballinasloe</p></div><div><input type=\"checkbox\" value=\"OMP_BALL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Carlow</p></div><div><input type=\"checkbox\" value=\"OMP_CARL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Cork</p></div><div><input type=\"checkbox\" value=\"OMP_MAHO\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Drogheda - Scotch Hall</p></div><div><input type=\"checkbox\" value=\"OMP_SCOT\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Dublin - Balbriggan</p></div><div><input type=\"checkbox\" value=\"OMP_BALB\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Dublin - Nutgrove</p></div><div><input type=\"checkbox\" value=\"OMP_NUTG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Dublin - Rathmines</p></div><div><input type=\"checkbox\" value=\"OMP_RATH\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Dundalk</p></div><div><input type=\"checkbox\" value=\"OMP_DUND\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Galway - Salthill</p></div><div><input type=\"checkbox\" value=\"OMP_GALW\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Killarney</p></div><div><input type=\"checkbox\" value=\"OMP_KILL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Limerick</p></div><div><input type=\"checkbox\" value=\"OMP_LIME\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Longford</p></div><div><input type=\"checkbox\" value=\"OMP_LONG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Monaghan</p></div><div><input type=\"checkbox\" value=\"OMP_MONA\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Mullingar</p></div><div><input type=\"checkbox\" value=\"OMP_MULL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Nenagh</p></div><div><input type=\"checkbox\" value=\"OMP_NENA\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Roscommon</p></div><div><input type=\"checkbox\" value=\"OMP_ROSC\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Shannon</p></div><div><input type=\"checkbox\" value=\"OMP_SHAN\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Sligo</p></div><div><input type=\"checkbox\" value=\"OMP_SLIG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Tralee</p></div><div><input type=\"checkbox\" value=\"OMP_TRAL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Waterford</p></div><div><input type=\"checkbox\" value=\"OMP_WATE\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Wexford</p></div><div><input type=\"checkbox\" value=\"OMP_WEXF\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div></div></div>\r\n          <input type=\"hidden\" class=\"action\" name=\"action\" value=\"process\" />\r\n        </form>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"footerControl\" class=\"hidden shrink-0 bg-[#282828]\">\r\n    <div class=\"main-container mx-auto w-full max-w-[560px] px-4 py-4\">\r\n      <button id=\"siteSelectButton\" type=\"button\" class=\"btn-solid-yellow w-full\" onclick=\"siteSelectProceed();\">\r\n        Continue\r\n      </button>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<script>\r\n  document.addEventListener(\"DOMContentLoaded\", function() {\r\n    const siteContainers = document.querySelectorAll(\".site-selection-item\");\r\n    const footerControl  = document.getElementById('footerControl');\r\n    const searchInput    = document.getElementById('search');\r\n    const regionHeaders  = document.querySelectorAll('.region-header');\r\n    const regionItems    = document.querySelectorAll('.region-items');\r\n\r\n    function resetCheckboxes() {\r\n      siteContainers.forEach(container => {\r\n        const cb  = container.querySelector(\"input[type='checkbox']\");\r\n        const img = container.querySelector(\".checkbox-img\");\r\n\r\n        if (cb && img) {\r\n          cb.checked = false;\r\n          img.src = \"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\";\r\n        }\r\n      });\r\n    }\r\n\r\n    siteContainers.forEach(container => {\r\n      const cb  = container.querySelector(\"input[type='checkbox']\");\r\n      const img = container.querySelector(\".checkbox-img\");\r\n\r\n      if (!cb || !img) {\r\n        return;\r\n      }\r\n\r\n      container.addEventListener(\"click\", function() {\r\n        if (!cb.checked) {\r\n          resetCheckboxes();\r\n          cb.checked = true;\r\n          img.src = \"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-on.svg\";\r\n          footerControl.classList.remove('hidden');\r\n        } else {\r\n          cb.checked = false;\r\n          img.src = \"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\";\r\n          footerControl.classList.add('hidden');\r\n        }\r\n      });\r\n    });\r\n\r\n    searchInput.addEventListener(\"input\", function() {\r\n      const q     = this.value.toLowerCase().trim();\r\n      const items = document.querySelectorAll('.site-selection-item');\r\n\r\n      if (q) {\r\n        regionHeaders.forEach(h => h.style.display = 'none');\r\n        regionItems.forEach(r => r.style.display = '');\r\n        items.forEach(item => {\r\n          const txt = item.querySelector('p').textContent.toLowerCase();\r\n          item.style.display = txt.includes(q) ? 'flex' : 'none';\r\n        });\r\n      } else {\r\n        regionHeaders.forEach(h => h.style.display = '');\r\n        regionItems.forEach(r => r.style.display = 'none');\r\n        items.forEach(i => i.style.display = '');\r\n      }\r\n    });\r\n\r\n    document.querySelectorAll('.region-group').forEach(group => {\r\n      const header = group.querySelector('.region-header');\r\n      const items  = group.querySelector('.region-items');\r\n      const icon   = header.querySelector('i');\r\n\r\n      header.classList.add('closed');\r\n      items.style.display = 'none';\r\n      icon.classList.add('omni-chevron-down');\r\n      icon.classList.remove('omni-chevron-up');\r\n\r\n      header.addEventListener('click', () => {\r\n        const hidden = items.style.display === 'none';\r\n        items.style.display = hidden ? '' : 'none';\r\n        header.classList.toggle('closed', !hidden);\r\n        icon.classList.toggle('omni-chevron-up', hidden);\r\n        icon.classList.toggle('omni-chevron-down', !hidden);\r\n      });\r\n    });\r\n\r\n    const currentSiteCode = 'OMP_SUTT';\r\n\r\n    if (currentSiteCode) {\r\n      const selectedInput = document.querySelector('input[name=\"cinema_item\"][value=\"' + currentSiteCode + '\"]');\r\n\r\n      if (selectedInput) {\r\n        const container   = selectedInput.closest('.site-selection-item');\r\n        const regionGroup = container.closest('.region-group');\r\n\r\n        if (regionGroup) {\r\n          const header = regionGroup.querySelector('.region-header');\r\n          const items  = regionGroup.querySelector('.region-items');\r\n          const icon   = header.querySelector('i');\r\n\r\n          items.style.display = '';\r\n          header.classList.remove('closed');\r\n          icon.classList.add('omni-chevron-up');\r\n          icon.classList.remove('omni-chevron-down');\r\n        }\r\n\r\n        selectedInput.checked = true;\r\n\r\n        const img = container.querySelector('.checkbox-img');\r\n        if (img) {\r\n          img.src = \"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-on.svg\";\r\n        }\r\n\r\n        footerControl.classList.remove('hidden');\r\n        container.scrollIntoView({ behavior: 'smooth', block: 'center' });\r\n      }\r\n    }\r\n\r\n        // getLatLong();\r\n      });\r\n\r\n  function siteSelectSubmit() {\r\n    document.getElementById('siteList-modal').submit();\r\n  }\r\n\r\n  function siteSelectProceed() {\r\n    document.getElementById('siteSelectButton').classList.add('disabled');\r\n    siteSelectSubmit();\r\n  }\r\n</script>  </div>\r\n</div>\r\n\r\n\r\n<!-- And here  -->\r\n\r\n<div class=\"pt-1 pb-2 relative\" style=\"overflow: visible;\">\r\n  <!-- JD to review -->\r\n  <div style=\"\r\n    position: absolute;\r\n    top: 50%;\r\n    left: 50%;\r\n    transform: translate(-50%, -50%);\r\n    width: 100%;\r\n    height: 90%;\r\n    background: radial-gradient(\r\n      circle at center,\r\n      #ffea00 0%,\r\n      rgba(255,234,0,0.12) 35%,\r\n      rgba(255,234,0,0) 100%\r\n    );\r\n    filter: blur(30px);\r\n    -webkit-filter: blur(30px);\r\n    opacity: 0.5;\r\n    z-index: 0;\">\r\n  </div>\r\n  <section id=\"showcase\" class=\"main-container-s2s splide mb-mid\" style=\"position: relative;\">\r\n    <div class=\"splide__track\">\r\n      <ul class=\"splide__list\">\r\n        \r\n                  <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/Resident Evil Web Slider.webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">Resident Evil</h2><div class=\"showtime-details flex items-center gap-3 flex-wrap justify-start\"><a href=\"/cinema/movie/sutton/resident-evil\" class=\"!mx-px btn-solid-yellow showtime-button\">Book now</a><span class=\"showtime-age-rating flex-shrink-0\"><img title=\"BBFC - 15\" class=\"showtime-age-rating-img\" src=\"/images/ratings/UK_15.png\" /></span><span class=\"showtime-genre\">Horror</span></div></div></div></div>                  <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/Practical Magic 2 Web Slider.webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">Practical Magic 2</h2><div class=\"showtime-details flex items-center gap-3 flex-wrap justify-start\"><a href=\"/cinema/movie/sutton/practical-magic-2\" class=\"!mx-px btn-solid-yellow showtime-button\">Book now</a><span class=\"showtime-age-rating flex-shrink-0\"><img title=\"BBFC - 12A\" class=\"showtime-age-rating-img\" src=\"/images/ratings/UK_12A.png\" /></span><span class=\"showtime-genre\">Comedy</span></div></div></div></div>                  <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/Shaun the Sheep The Beast of Mossy Bottom Web Slider.webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">Shaun the Sheep: The Beast of Mossy Bottom</h2><div class=\"showtime-details flex items-center gap-3 flex-wrap justify-start\"><a href=\"/cinema/movie/sutton/shaun-the-sheep-the-beast-of-mossy-bottom\" class=\"!mx-px btn-solid-yellow showtime-button\">Book now</a><span class=\"showtime-age-rating flex-shrink-0\"><img title=\"BBFC - U\" class=\"showtime-age-rating-img\" src=\"/images/ratings/UK_U.png\" /></span><span class=\"showtime-genre\">Animation, Comedy, Family</span></div></div></div></div>                  <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/Don't Look Back in Anger Web Slider (1).webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">OASIS: Don't Look Back in Anger</h2><div class=\"showtime-details flex items-center gap-3 flex-wrap justify-start\"><a href=\"/cinema/movie/sutton/oasis-don-t-look-back-in-anger\" class=\"!mx-px btn-solid-yellow showtime-button\">Book now</a><span class=\"showtime-age-rating flex-shrink-0\"><img title=\"BBFC - 15\" class=\"showtime-age-rating-img\" src=\"/images/ratings/UK_15.png\" /></span><span class=\"showtime-genre\">Documentary</span></div></div></div></div>                                    <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/Insidious Out of the Further Web Slider.webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">Insidious: Out Of The Further</h2><div class=\"showtime-details flex items-center gap-3 flex-wrap justify-start\"><a href=\"/cinema/movie/sutton/insidious-out-of-the-further\" class=\"!mx-px btn-solid-yellow showtime-button\">Book now</a><span class=\"showtime-age-rating flex-shrink-0\"><img title=\"BBFC - 15\" class=\"showtime-age-rating-img\" src=\"/images/ratings/UK_15.png\" /></span><span class=\"showtime-genre\">Horror</span></div></div></div></div>                  <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/Pressure Web Slider.webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">Pressure</h2><div class=\"showtime-details flex items-center gap-3 flex-wrap justify-start\"><a href=\"/cinema/movie/sutton/pressure\" class=\"!mx-px btn-solid-yellow showtime-button\">Book now</a><span class=\"showtime-age-rating flex-shrink-0\"><img title=\"BBFC - 12A\" class=\"showtime-age-rating-img\" src=\"/images/ratings/UK_12A.png\" /></span><span class=\"showtime-genre\">Thriller, Drama</span></div></div></div></div>                  <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/Coyote vs ACME Web Slider.webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">Coyote vs Acme</h2><div class=\"showtime-details flex items-center gap-3 flex-wrap justify-start\"><a href=\"/cinema/movie/sutton/coyote-vs-acme\" class=\"!mx-px btn-solid-yellow showtime-button\">Book now</a><span class=\"showtime-age-rating flex-shrink-0\"><img title=\"BBFC - PG\" class=\"showtime-age-rating-img\" src=\"/images/ratings/UK_PG.png\" /></span><span class=\"showtime-genre\">Adventure, Animation, Comedy</span></div></div></div></div>              </ul>\r\n    </div>\r\n  </section>\r\n</div>\r\n\r\n<div class=\"main-container\" style=\"background-color: transparent\">\r\n  <div id=\"showtimes_section\" class=\"w-full flex flex-col md:flex-row items-center justify-between\">\r\n    <div class=\"flex w-full\">\r\n      <div class=\"mb-mid flex items-center w-full justify-between md:justify-start\">\r\n        <!-- <h1 class=\"page-title text-white mr-4\">Now showing in</h1> -->\r\n        <div class=\"\">\r\n          <div class=\"flex items-center\"><a href=\"/cinema/site\" class=\"js-site-link\"><span class=\"menu-location pr-1 py-1 text-2xl font-semibold\">Sutton Surrey</span><i class=\"icon omni-chevron-down mx-1 text-xl cursor-pointer\"></i></a></div>        </div>\r\n        <a href=\"/company/about\" class=\" pl-3 text-ompYellow\">About this venue</a>\r\n      </div>\r\n    </div>\r\n    <div class=\"w-full lg:w-auto\">\r\n      <div class=\"flex items-center mb-mid block md:hidden\">\r\n        <p class=\"text-base\">Filter movies & events</p>\r\n        <i id=\"filterButton\" class=\"icon omni-filter mx-3 text-lg\"></i>\r\n        <i onclick=\"showSearchBox()\" id=\"showSearchBarButton\" class=\"icon omni-search mx-3 text-lg\"></i>\r\n      </div>\r\n\r\n      <div>\r\n        <div id=\"searchBoxContainer\" class=\"mb-4 pt-2 hidden md:block\">\r\n          <div class=\"flex justify-between items-center\">\r\n            <div class=\"input-search\">\r\n              <i class=\"icon omni-search\" style=\"position: static;\"></i>\r\n              <input style=\"left: 10px;\" id=\"searchBarInput\" onkeyup=\"searchForPerformance()\" placeholder=\"Movie Search\" type=\"text\" />\r\n              <div class=\"flex absolute bg-ompGray z-[40]\"><ul id=\"performanceList\"><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/resident-evil\">Resident Evil</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/practical-magic-2\">Practical Magic 2</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/insidious-out-of-the-further\">Insidious: Out Of The Further</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/shaun-the-sheep-the-beast-of-mossy-bottom\">Shaun the Sheep: The Beast of Mossy Bottom</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-odyssey\">The Odyssey</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/bad-apples-\">Bad Apples</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/oasis-don-t-look-back-in-anger\">OASIS: Don't Look Back in Anger</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/spider-man-brand-new-day\">Spider-Man: Brand New Day</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/pressure\">Pressure</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/fall-2-deadpoint\">Fall 2: Deadpoint</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/coyote-vs-acme\">Coyote vs Acme</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/alices-adventures-in-wonderland-live-the-royal-ballet-26-27\">Alices Adventures In Wonderland - LIVE - The Royal Ballet 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/andre-rieu-s-2026-christmas-concert-let-it-snow\">Andre Rieu?s 2026 Christmas Concert: Let It Snow</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/avengers-endgame-encore-infinity-vision-\">Avengers: Endgame Encore (Infinity Vision)</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/carmen-live-the-royal-opera-26-27\">Carmen - LIVE- The Royal Opera 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/cosi-fan-tutte-live-the-royal-opera-26-27\">Cosi Fan Tutte - LIVE - The Royal Opera 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/dune-part-three\">Dune: Part Three</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/fallen-angels-by-noel-coward\">Fallen Angels by Noel Coward</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/gotterdammerung-live-the-royal-opera-26-27\">Gotterdammerung - LIVE - The Royal Opera 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/hadestown-the-musical\">Hadestown: The Musical</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/heart-of-the-beast\">Heart Of The Beast</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/her-private-hell\">Her Private Hell</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/hope\">Hope</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/la-fanciulla-del-west-the-met-opera-26-27\">La Fanciulla Del West - The Met Opera 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/macbeth-the-met-opera-2026-27\">Macbeth - The Met Opera 2026-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/manon-live-the-royal-ballet-26-27\">Manon - LIVE - The Royal Ballet 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/minions-and-monsters\">Minions and Monsters</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/moana\">Moana</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/nt-live-golden-boy\">NT Live: Golden Boy</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/nt-live-the-misanthrope\">NT Live: The Misanthrope</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/queen-budapest\">Queen Budapest</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/romeo-juliet-live-the-royal-ballet-26-27\">Romeo & Juliet - LIVE - The Royal Ballet 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/runner\">Runner</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/sense-and-sensibility\">Sense And Sensibility</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/swan-lake-live-the-royal-ballet-26-27\">Swan Lake - LIVE - The Royal Ballet 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-dog-stars\">The Dog Stars</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-end-of-oak-street\">The End Of Oak Street</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-nutcracker-live-the-royal-ballet-26-27\">The Nutcracker - LIVE - The Royal Ballet 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/tosca-live-the-royal-opera-26-27\">Tosca - LIVE - The Royal Opera 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/verity\">Verity</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/wildwood\">Wildwood</a>  </li> </ul> </div>            </div>\r\n            <i id=\"filterButton2\" class=\"icon omni-filter text-ompYellow mx-3 hidden md:block\"></i>\r\n          </div>\r\n        </div>  \r\n      </div>\r\n      <div id=\"\" class=\"\">\r\n        <div id=\"filterControlls-datescon\">\r\n           \r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n<div class=\"sticky top-0  z-[30]\">\r\n    \r\n  <div id=\"filterControlls-dates\" class=\"main-container-full bg-ompGray-dates\" style=\"padding-left: 0 !important; padding-right: 0 !important; \">\r\n    <div id=\"dateNav\" class=\"date-nav-container mb-mid md:justify-around\" style=\"\">\r\n                <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-09-21\">\r\n            <span>Today</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-09-22\">\r\n            <span>Tuesday</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-09-23\">\r\n            <span>Wednesday</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-09-24\">\r\n            <span>Thursday</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-09-25\">\r\n            <span>Friday</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-09-26\">\r\n            <span>Saturday</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-09-27\">\r\n            <span>Sunday</span>\r\n          </button>\r\n                <button type=\"button\" class=\"date-nav-item active\" data-date=\"calendar\" onclick=\"showDateCalendar(); return false;\">\r\n          <span>\r\n            10th Nov          </span>\r\n        </button>\r\n    </div>\r\n\r\n\r\n\r\n    <!-- <section id=\"dates\" class=\"splide mb-mid py-4 bg-ompGray-slider px-2\">\r\n      <div class=\"splide__track\">\r\n        <ul class=\"splide__list\">\r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"0\" onClick=\"updateSearch('DATE', '2026-09-21');refreshSearch();\">Today</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"1\" onClick=\"updateSearch('DATE', '2026-09-22');refreshSearch();\">Tuesday</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"2\" onClick=\"updateSearch('DATE', '2026-09-23');refreshSearch();\">Wednesday</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"3\" onClick=\"updateSearch('DATE', '2026-09-24');refreshSearch();\">Thursday</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"4\" onClick=\"updateSearch('DATE', '2026-09-25');refreshSearch();\">Friday</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"5\" onClick=\"updateSearch('DATE', '2026-09-26');refreshSearch();\">Saturday</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"6\" onClick=\"updateSearch('DATE', '2026-09-27');refreshSearch();\">Sunday</a>\r\n            </li> \r\n                    \r\n          <li class=\"splide__slide date-item active\" ><a data-target=\"6\" href=\"#\" onClick=\"showDateCalendar(); return false;\">10th Nov</a></li>\r\n        </ul>\r\n      </div>\r\n    </section> -->\r\n  </div>\r\n\r\n  <div id=\"calendarModal\" class=\"hidden\">\r\n    <div class=\"fixed top-0 left-0 inset-0 bg-black/70 backdrop-blur-sm z-[170]\"></div>\r\n    <div class=\"fixed inset-0 flex justify-center items-center z-[180]\">\r\n      <div class=\"rounded-lg shadow-lg p-6 relative\">\r\n        <input type=\"text\" id=\"calendarPicker\" placeholder=\"Select a date\"\r\n              class=\"hidden w-full border border-gray-300 rounded p-2\" />\r\n        <button class=\"btn-solid-yellow mt-4\" onclick=\"closeCalendarModal()\">Close</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <script src=\"/public/js/flatpickr/flatpickr.min.js\"></script>\r\n  <script>\r\n    // Assume allowedDates is provided by PHP as an array of UNIX timestamps\r\n    var defaultDate = \"2026-11-10\";\r\n    const allowedDatesTimestamps = [1789945200000,1790031600000,1790118000000,1790204400000,1790290800000,1790377200000,1790463600000,1790550000000,1790636400000,1790722800000,1790809200000,1805760000000,1796428800000,1796515200000,1794268800000,1803340800000,1797292800000,1792623600000,1792882800000,1801612800000,1791846000000,1792278000000,1800921600000,1792450800000,1793059200000,1793836800000,1791327600000,1791586800000,1811199600000,1808348400000,1796083200000,1809471600000,1790895600000,1790982000000,1791068400000,1791154800000,1791241200000,1791414000000,1792710000000,1792796400000,1792972800000,1793145600000,1793232000000];\r\n    const allowedDates = allowedDatesTimestamps.map(ts => new Date(ts));\r\n    // console.log('DateSelector::AllowedDateCount:43');\r\n    // console.log('DateSelector::CalendarEventCount:41');\r\n    // console.log('DateSelector::AllowedDates:' + allowedDatesTimestamps);\r\n    // console.log('DateSelector::DfltDate:' + defaultDate);\r\n    // console.log('DateSelector::FilterEventCode: ');    \r\n    \r\n    if (defaultDate == 0) {\r\n      defaultDate = '';\r\n    }\r\n\r\n    flatpickr(\"#calendarPicker\", {\r\n      inline: true,\r\n      enable: allowedDates,\r\n      dateFormat: \"Y-m-d\",\r\n      defaultDate: defaultDate,\r\n      onChange: function(selectedDates, dateStr, instance) {\r\n        console.log(\"Selected date:\", dateStr);\r\n        calendarDateChange(dateStr);\r\n        // Optionally, automatically close the modal after selection:\r\n        // closeCalendarModal();\r\n      }\r\n    });\r\n    \r\n  </script>\r\n\r\n  <script> \r\n    var slideIndex = 6;\r\n    console.log(slideIndex);\r\n    \r\n    // document.addEventListener('DOMContentLoaded', function() {\r\n    //   var dates = new Splide('#dates', {\r\n    //     type: 'slide',\r\n    //     perPage: 6, // Default: Fully show only 3 slides at a time\r\n    //     perMove: 1, // Move one slide at a time\r\n    //     gap: '5px', // Space between slides\r\n    //     arrows: false, // Hide arrows\r\n    //     pagination: false, // Hide pagination\r\n    //     trimSpace: false, // Prevents unwanted cropping\r\n    //     autoHeight: true, // Adjusts height to content dynamically\r\n    //     rewind: false, // Prevents bouncing back to the first slide\r\n    //     snap: true, // Forces snap to the closest slide\r\n    //     drag: true, // Prevents flick scrolling through multiple items quickly\r\n    //     wheel: false, // Disables fast scrolling with mouse wheel\r\n    //     //focus: 'center',\r\n    //     breakpoints: {\r\n    //       1200: {\r\n    //         perPage: 6\r\n    //       }, // Show 5 slides on larger screens\r\n    //       900: {\r\n    //         perPage: 4\r\n    //       }, // Show 4 slides on medium screens\r\n    //       600: {\r\n    //         perPage: 3\r\n    //       }, // Default: 3 slides on smaller screens\r\n    //     },\r\n    //   });\r\n    \r\n    //   dates.on('mounted', function () {\r\n    //     // Wait for a short timeout to let layout settle\r\n    //     setTimeout(() => {\r\n    //       dates.go(slideIndex);\r\n    //     }, 0); // You can try increasing this to 50–100ms if needed\r\n    //   });\r\n    \r\n    //   // dates.mount();\r\n      \r\n    //   // Log current index on load\r\n    //   console.log('Starting slide index:', dates.index);\r\n    //   console.log('Starting slide selected:', slideIndex);\r\n    \r\n    //   // Log index whenever slide moves\r\n    //   dates.on('moved', function (newIndex) {\r\n    //     console.log('Now showing slide index:', newIndex);\r\n    //   });\r\n    \r\n    //   // Log all slide elements with their indexes\r\n    //   var slides = dates.Components.Slides.get();\r\n    //   slides.forEach((slideObj, index) => {\r\n    //     console.log(`Slide ${index}:`, slideObj.slide.textContent.trim());\r\n    //   });\r\n    // });\r\n    document.addEventListener(\"DOMContentLoaded\", function() {\r\n      const searchBar = document.querySelector(\"#filterControlls-search\");\r\n      const filterControls = document.querySelector(\"#filterControlls\");\r\n      var scrollPos = 0;\r\n      window.addEventListener(\"scroll\", function() {\r\n        let scrollTop = window.scrollY || document.documentElement.scrollTop;\r\n        // let filterTop = filterControls.getBoundingClientRect().top;\r\n        \r\n        if (searchBar != null) {\r\n          // searchBar.classList.remove(\"hidden\");\r\n          // if (filterTop <= 35) {\r\n          //   // searchBar.classList.add(\"hidden\");\r\n          // }\r\n        }\r\n      });\r\n    });\r\n\r\n    document.addEventListener('DOMContentLoaded', () => {\r\n  const nav      = document.getElementById('dateNav');\r\n  if (!nav) return;\r\n\r\n  const items    = Array.from(nav.querySelectorAll('.date-nav-item'));\r\n  const sections = items.map(btn =>\r\n    document.querySelector(`[data-date-section=\"${btn.dataset.date}\"]`)\r\n  );\r\n\r\n  // Flag to ignore clicks that were actually drags\r\n  let suppressNavClick = false;\r\n\r\n  function setActive(idx) {\r\n    items.forEach((b,i) => b.classList.toggle('active', i === idx));\r\n  }\r\n\r\n  function centerNavItem(btn) {\r\n    const navRect = nav.getBoundingClientRect();\r\n    const btnRect = btn.getBoundingClientRect();\r\n    const offset  = btnRect.left\r\n                  - navRect.left\r\n                  - (navRect.width / 2)\r\n                  + (btnRect.width / 2);\r\n    nav.scrollBy({ left: offset, behavior: 'smooth' });\r\n  }\r\n\r\n  items.forEach((btn, idx) => {\r\n    btn.addEventListener('click', () => {\r\n      if (suppressNavClick) return;\r\n\r\n      if (btn.dataset.date === 'calendar') {\r\n        showDateCalendar();\r\n        return;\r\n      }\r\n\r\n      sections[idx]?.scrollIntoView({ behavior: 'smooth', block: 'start' });\r\n\r\n      // highlight + center in the nav\r\n      setActive(idx);\r\n      centerNavItem(btn);\r\n\r\n      // run your filters\r\n      updateSearch('DATE', btn.dataset.date);\r\n      refreshSearch();\r\n    });\r\n  });\r\n\r\n  const observer = new IntersectionObserver((entries) => {\r\n    entries.forEach(ent => {\r\n      if (ent.isIntersecting) {\r\n        const idx = sections.findIndex(sec => sec === ent.target);\r\n        if (idx >= 0) {\r\n          setActive(idx);\r\n          centerNavItem(items[idx]);\r\n        }\r\n      }\r\n    });\r\n  }, {\r\n    rootMargin: '-30% 0px -70% 0px',\r\n    threshold: 0\r\n  });\r\n\r\n  sections.forEach(sec => sec && observer.observe(sec));\r\n\r\n  const initialIdx = items.findIndex(b => b.classList.contains('active'));\r\n  if (initialIdx >= 0) centerNavItem(items[initialIdx]);\r\n\r\n  // --- drag-to-scroll (mouse + touch) that DOESN'T break clicks ---\r\n  (function enableDragScroll(container) {\r\n    let isDown = false;\r\n    let startX = 0;\r\n    let startScrollLeft = 0;\r\n    let dragging = false;\r\n\r\n    const DRAG_THRESHOLD = 10; // px\r\n\r\n    container.style.cursor = 'grab';\r\n\r\n    container.addEventListener('pointerdown', (e) => {\r\n      if (e.pointerType === 'mouse' && e.button !== 0) return;\r\n\r\n      isDown = true;\r\n      dragging = false;\r\n      startX = e.clientX;\r\n      startScrollLeft = container.scrollLeft;\r\n\r\n      container.style.cursor = 'grabbing';\r\n    });\r\n\r\n    container.addEventListener('pointermove', (e) => {\r\n      if (!isDown) return;\r\n\r\n      const dx = e.clientX - startX;\r\n\r\n      if (!dragging && Math.abs(dx) > DRAG_THRESHOLD) {\r\n        dragging = true;\r\n      }\r\n\r\n      if (dragging) {\r\n        if (e.cancelable) e.preventDefault();\r\n        container.scrollLeft = startScrollLeft - dx;\r\n      }\r\n    }, { passive: false });\r\n\r\n    container.addEventListener('pointerup', () => {\r\n      isDown = false;\r\n      container.style.cursor = 'grab';\r\n\r\n      if (dragging) {\r\n        suppressNavClick = true;\r\n        setTimeout(() => { suppressNavClick = false; }, 0);\r\n      }\r\n    });\r\n\r\n    container.addEventListener('pointercancel', () => {\r\n      isDown = false;\r\n      container.style.cursor = 'grab';\r\n    });\r\n  })(nav);\r\n});\r\n\r\n  </script>  </div>\r\n<div class=\"main-container flex items-center text-sm space-x-2 mb-4 text-white/40\">\r\n  <p class=\"inline-flex text-xs items-center justify-center w-4 h-4 bg-white/40 text-black rounded-full\">\r\n    &pound;  </p>\r\n  <p>Booking online is &pound;1.00 cheaper</p>\r\n</div>\r\n</div>\r\n\r\n<div id=\"youtubeEmbed\" class=\"overflow-hidden hidden\">\r\n  <div class=\"fixed inset-0 flex items-center justify-center z-50\">\r\n    <div id=\"backgroundOverlay\" class=\"absolute inset-0 bg-black/70 backdrop-blur-sm pointer-events-none\"></div>\r\n    <div class=\"relative p-6 rounded shadow-lg z-10\">\r\n      <div id=\"youtubeIframe\" class=\"mb-2\">\r\n      </div>\r\n      <div class=\"\">\r\n        <button onclick=\"closeYoutubeVideo()\" class=\"btn-solid-yellow w-full\" onClick=\"closeRemoveFavouriteModal();return false;\">Close</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div> \r\n\r\n<div class=\"main-container grid grid-cols-1 gap-6\">\r\n  <!-- main grid  -->\r\n  <div class=\"grid grid-cols-1 md:grid-cols-6 lg:grid-cols-7 xl:grid-cols-10  bg-ompYellow-light/5 shadow-lg backdrop-blur-sm p-4 rounded-lg gap-4 xl:gap-8\">\r\n    <div class=\"hidden md:block col-span-1 md:col-span-1 lg:col-span-2 xl:col-span-2\">\r\n    <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n      <img\r\n        src=\"/filmimages/small/110364.jpg?v=1555781431\"\r\n        alt=\"Carmen - LIVE- The Royal Opera 26-27 Event poster\"\r\n        class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n        data-eventCode=\"110364\"\r\n        data-eventCode=\"Carmen - LIVE- The Royal Opera 26-27\"\r\n      />\r\n              <img\r\n          onclick=\"playYoutubeVideo('eRR1FiG__FU')\"\r\n          src=\"/public/assets/svgs/play-circle.svg\"\r\n          alt=\"Play Trailler\"\r\n          class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n        />\r\n          </div>\r\n  </div>\r\n  <div class=\"md:col-span-5 lg:col-span-5 xl:col-span-8\">\r\n    <div class=\"grid grid-cols-3 md:grid-cols-5 gap-4 items-start\">\r\n      <!-- A (Mobile) -->\r\n      <div class=\"md:hidden col-span-1\">\r\n        <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n          <img\r\n            src=\"/filmimages/small/110364.jpg?v=1555781431\"\r\n            alt=\"Carmen - LIVE- The Royal Opera 26-27 Event poster\"\r\n            class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n            data-eventCode=\"110364\"\r\n            data-eventCode=\"Carmen - LIVE- The Royal Opera 26-27\"\r\n          />\r\n                      <img\r\n              onclick=\"playYoutubeVideo('eRR1FiG__FU')\"\r\n              src=\"/public/assets/svgs/play-circle.svg\"\r\n              alt=\"Play Trailler\"\r\n              class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n            />\r\n                  </div>\r\n      </div>\r\n      <!-- B -->\r\n      <div class=\"col-span-2 md:col-span-5\">\r\n        <div class=\"w-full\">\r\n          <div class=\"flex justify-between items-start w-full mb-2\">\r\n            <p class=\"font-medium text-lg sm:text-2xl md:text-3xl leading-snug sm:leading-tight md:leading-tight mr-4\">\r\n              <a href=\"/cinema/movie/sutton/carmen-live-the-royal-opera-26-27\">\r\n                Carmen - LIVE- The Royal Opera 26-27              </a>\r\n            </p>\r\n            <img data-toggle=\"0\" id=\"favourite110364\" onClick=\"toggleFavourite('110364');return false;\" src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_favourited-off.svg\" class=\"w-4 mt-2 mx-3\" alt=\"Add to Favourites\" />  \r\n          </div>\r\n          <div class=\"flex items-center gap-2 mb-2\">\r\n            <div class=\"flex flex-col md:flex-row gap-4\">\r\n              <div class=\"flex items-center gap-2\">\r\n                <img src=\"/images/ratings/UK_TBC.png\" class=\"w-4 min-w-[30px]\" />\r\n                <p class=\"text-base leading-snug font-normal leading-none\"></p>\r\n              </div>\r\n              <p class=\"mb-2 md:m-auto flex item-center\"><span class=\"hidden md:flex mr-2\">|</span> 3hrs 35min </p>\r\n            </div>\r\n          </div>\r\n          \r\n            <p class=\"hidden md:block mb-2 pt-2\">\r\n              <span class=\"synopsis-short\">\r\n                Under the oppressive heat of the Spanish sun, the fiercely independent Carmen attracts the attention of Don Jos&eacute;. She warns him not to fall in love with her, but his obsession knows no bounds. Damiano Michieletto?s searing production returns, ...              </span>\r\n\r\n                              <span class=\"synopsis-full hidden text-base\">\r\n                  Under the oppressive heat of the Spanish sun, the fiercely independent Carmen attracts the attention of Don Jos&eacute;. She warns him not to fall in love with her, but his obsession knows no bounds. Damiano Michieletto?s searing production returns, casting scorching light on the lust, violence and destructive desire of Bizet?s ever-popular opera. \r\nAn all-star cast brings this white-hot drama to life, with Ginger Costa-Jackson in the fiery title role, alongside Russell Thomas as the jealous and despairing Don Jos&eacute;. Following his 2023 Royal Opera debut, Sesto Quatrini returns to conduct Bizet?s electrifying and sensual score.                </span>\r\n\r\n                <button \r\n                  type=\"button\"\r\n                  class=\"ml-2 text-ompYellow underline text-base\"\r\n                  onclick=\"toggleSynopsis(this)\"\r\n                >\r\n                  See more\r\n                </button>\r\n                          </p>\r\n          <div class=\"hallTypeIcon hidden\">\r\n                                  </div>\r\n        </div>\r\n      </div>\r\n      <!-- C -->\r\n      <div class=\"col-span-3 md:col-span-5 md:col-start-1\">\r\n        <div class=\"w-full grid grid-cols-1 md:grid-cols-2 sm:col-span-2 xl:grid-cols-3  gap-2\">\r\n          <a aria-label=\"Carmen - LIVE- The Royal Opera 26-27 at 19:00 in Screen 10\" href=\"https://www.omniplexcinemas.co.uk/booking/seats/sutton/42662\" class=\"\"> \r\n<div id=\"perf_0\" class=\"showTimeBox bg-ompGray-times p-2 col-span-1 rounded-xl\">\r\n  <div class=\"topSection flex justify-between items-end\">\r\n    <div class=\"flex items-end\">\r\n      <div class=\"flex items-baseline\">\r\n        <h4 class=\"bigText mr-1 leading-none\" aria-label=\"Carmen - LIVE- The Royal Opera 26-27 at 19:00 in Screen 10\">\r\n          19:00        </h4>\r\n        <p class=\"smallText leading-none\" aria-label=\"Carmen - LIVE- The Royal Opera 26-27 starts at 19:00 and ends at 22:35\">\r\n          - 22:35        </p>\r\n      </div>\r\n    </div>\r\n    <div class=\"flex items-end\">\r\n              <div class=\"flex items-baseline\">\r\n          <p class=\"smallText mr-1 leading-none\" aria-label=\"Cost starting from &pound;14.95\">\r\n            From\r\n          </p>\r\n          <h4 class=\"bigText leading-none\" aria-label=\"Cost starting from &pound;14.95\">\r\n            &pound;14.95          </h4>\r\n        </div>\r\n          </div>\r\n  </div>\r\n  <div class=\"midSection flex justify-between items-baseline\">\r\n\r\n    <div class=\"mb-2\"></div>\r\n  </div>\r\n  <div class=\"bottomSection flex items-center justify-between gap-2\">\r\n    <div class=\"shrink-0\">\r\n      <p class=\"smallText\">\r\n        Screen 10      </p>\r\n    </div>\r\n    <div class=\"flex flex-1 min-w-0 justify-end overflow-hidden\">\r\n      <div class=\"flex min-w-0 max-w-full items-center justify-end gap-2\"> \r\n                      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n</a>          </div>    \r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"main-container my-mid block md:hidden\">\r\n  <button id=\"aboutToggle\" class=\"flex items-center text-ompYellow font-semibold w-full text-left\">\r\n    <p class=\"\">Sutton Surrey Omniplex</p>\r\n    <i id=\"aboutIcon\" class=\"icon omni-chevron-up pl-4\"></i>\r\n  </button>\r\n  <div id=\"aboutSiteSection\" class=\"mt-4 hidden\">\r\n    <div>\r\n      Omniplex Cinema Sutton: Luxury Recliners. Double MAXX screens.\r\n\r\nExperience the next level of cinema at Omniplex Cinema Sutton, the premier 12-screen entertainment hub in South London. Located in the heart of the St Nicholas Shopping Centre, our cinema features the latest in motion technology, Premium Large Format screens, and luxury seating for the ultimate movie night.\r\n\r\nWhat to Expect at Omniplex Sutton:\r\n&#9679;\tDouble Omniplex MAXX: Immerse yourself in the biggest blockbusters on our two Premium Large Format MAXX screens, featuring floor-to-ceiling visuals and powerful immersive sound.\r\n\r\n&#9679;\tD-BOX Motion Seating: Feel every moment with our D-BOX haptic seats, perfectly synchronized with the on-screen action for a truly 4D experience.\r\n\r\n&#9679;\tLuxury Electric Recliners: Relax in style with our signature Electric Reclining Seats, allowing you to stretch out and enjoy the latest releases in total comfort.\r\n\r\n&#9679;\tSt Nicholas Centre Convenience: Benefit from 3 Hours of Free Car Parking (validated on-site) at the St Nicholas Shopping Centre - the most convenient way to watch movies in Sutton.\r\n\r\n&#9679;\tCinema Treats: Fuel your visit with our famous fresh popcorn made on-site, hot nachos, sweets, and a wide selection of soft drinks.\r\n\r\n&#9679;\tDigital Experience: Book on the Omniplex App for paperless entry and manage your MyOmniPass with ease. Omniplex Gift Cards are also available online - the perfect gift for any film lover.\r\n\r\nSecure your D-BOX seat or MAXX Recliner by booking online at Omniplex Sutton today!\r\n    </div>\r\n  </div>\r\n  <div class=\"mt-4\">\r\n      </div>\r\n</div>\r\n\r\n<script>\r\n  document.addEventListener('DOMContentLoaded', function () {\r\n    const toggle = document.getElementById('aboutToggle');\r\n    const section = document.getElementById('aboutSiteSection');\r\n    const icon = document.getElementById('aboutIcon');\r\n    toggle.addEventListener('click', function () {\r\n      section.classList.toggle('hidden');\r\n      icon.classList.toggle('omni-chevron-down');\r\n      icon.classList.toggle('omni-chevron-up');\r\n    });\r\n  });\r\n\r\nfunction clearFIlters(){\r\n  const clearFiltersButton = document.getElementById('clearFilters');\r\n  clearFiltersButton.click();\r\n}\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n  var showcase = new Splide('#showcase', {\r\n    type: 'loop',\r\n    perPage: 1.2,\r\n    loop: true,\r\n    gap: '20px',\r\n    focus: 'center',\r\n    arrows: false,\r\n    pagination: false,\r\n    trimSpace: false,\r\n    autoHeight: true,\r\n    clones: 2,\r\n    // Auto scroll\r\n    autoplay: true,\r\n    interval: 5000,\r\n    pauseOnHover: true,\r\n    pauseOnFocus: true,\r\n  });\r\n  showcase.mount();\r\n});\r\n\r\nfunction toggleSynopsis(btn) {\r\n  const container = btn.parentElement;\r\n  const shortText = container.querySelector('.synopsis-short');\r\n  const fullText = container.querySelector('.synopsis-full');\r\n\r\n  const isHidden = fullText.classList.contains('hidden');\r\n\r\n  if (isHidden) {\r\n    shortText.classList.add('hidden');\r\n    fullText.classList.remove('hidden');\r\n    btn.textContent = 'See less';\r\n  } else {\r\n    shortText.classList.remove('hidden');\r\n    fullText.classList.add('hidden');\r\n    btn.textContent = 'See more';\r\n  }\r\n}\r\n\r\nfunction showSearchBox(){\r\n  const searchBoxContainer =  document.getElementById('searchBoxContainer');\r\n\r\n  searchBoxContainer.classList.toggle('hidden');\r\n}\r\n</script>\r\n\r\n\r\n    <div class=\"main-container my-big \">\r\n              <div class=\"grid grid-cols-6 gap-6\">\r\n                      \r\n            <div class=\"col-span-6 md:col-span-2 rounded-xl overflow-hidden bg-black\">\r\n              <div\r\n                class=\"h-[300px] flex flex-col justify-end p-6 bg-cover bg-center\"\r\n                style=\"background-image: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.2)), url('/cms/footerads/opass.png'); background-position: right top;\"\r\n              >\r\n                                  <h3 class=\"text-xl font-semibold mb-2 text-white\">\r\n                    Get a ticket to every movie at Omniplex with a monthly 'MyOmniPass' subscription.                  </h3>\r\n                \r\n                                  <p class=\"text-sm mb-4 text-white\">\r\n                    Terms &amp; Exclusions Apply                  </p>\r\n                \r\n                                  <a\r\n                    href=\"/join/landing\"\r\n                    class=\"text-center font-semibold bg-white/20 hover:bg-white/30 transition px-4 py-2 rounded-md text-sm w-full text-white\"\r\n                  >\r\n                    Find out more                  </a>\r\n                              </div>\r\n            </div>\r\n                      \r\n            <div class=\"col-span-6 md:col-span-2 rounded-xl overflow-hidden bg-black\">\r\n              <div\r\n                class=\"h-[300px] flex flex-col justify-end p-6 bg-cover bg-center\"\r\n                style=\"background-image: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.2)), url('/cms/footerads/gcard.png'); background-position: right top;\"\r\n              >\r\n                                  <h3 class=\"text-xl font-semibold mb-2 text-white\">\r\n                    For the superhero in your life...                  </h3>\r\n                \r\n                                  <p class=\"text-sm mb-4 text-white\">\r\n                    Get them an Omniplex Gift Card                  </p>\r\n                \r\n                                  <a\r\n                    href=\"/giftcards/choose\"\r\n                    class=\"text-center font-semibold bg-white/20 hover:bg-white/30 transition px-4 py-2 rounded-md text-sm w-full text-white\"\r\n                  >\r\n                    Get a Gift Card                  </a>\r\n                              </div>\r\n            </div>\r\n                      \r\n            <div class=\"col-span-6 md:col-span-2 rounded-xl overflow-hidden bg-black\">\r\n              <div\r\n                class=\"h-[300px] flex flex-col justify-end p-6 bg-cover bg-center\"\r\n                style=\"background-image: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.2)), url('/cms/footerads/kids.png'); background-position: right top;\"\r\n              >\r\n                                  <h3 class=\"text-xl font-semibold mb-2 text-white\">\r\n                    Perfect for a day out with the kids                  </h3>\r\n                \r\n                                  <p class=\"text-sm mb-4 text-white\">\r\n                    Best movies and treats for all                  </p>\r\n                \r\n                                  <a\r\n                    href=\"/cinema/kids\"\r\n                    class=\"text-center font-semibold bg-white/20 hover:bg-white/30 transition px-4 py-2 rounded-md text-sm w-full text-white\"\r\n                  >\r\n                     See our Kids offerings                  </a>\r\n                              </div>\r\n            </div>\r\n                  </div>\r\n          </div>\r\n       \r\n<div id=\"footerContact\" class=\"bg-[#282828] mt-8\">\r\n  <div class=\"w-full text-center py-8\">\r\n    <h4 class=\"text-ompYellow text-2xl font-bold\">Need help?</h4>\r\n    <p class=\"\">Get in touch with your local cinema now:</p>\r\n    <div class=\"input-container mb-4 main-container mt-4\">\r\n      <div class=\"input-select mx-auto w-full md:w-2/3 lg:w-1/2\">\r\n        <select id=\"conactlocalCinema\" name=\"sitecode\" class=\"select-input\">\r\n          <option value=\"\" disabled selected>Choose Cinema</option>\r\n          <optgroup style=\"font-weight:900;font-size:13px;\" label=\"England\"><option value=\"OMP_BIRM\" id=\"birmingham-great-park\" data-thissite=\"OMP_BIRM\" data-sitecode=\"OMP_SUTT\">&nbsp;Birmingham - Great Park</option>\r\n<option value=\"OMP_HIWY\" id=\"high-wycombe\" data-thissite=\"OMP_HIWY\" data-sitecode=\"OMP_SUTT\">&nbsp;High Wycombe</option>\r\n<option value=\"OMP_IPSW\" id=\"ipswich\" data-thissite=\"OMP_IPSW\" data-sitecode=\"OMP_SUTT\">&nbsp;Ipswich</option>\r\n<option value=\"OMP_SUND\" id=\"sunderland\" data-thissite=\"OMP_SUND\" data-sitecode=\"OMP_SUTT\">&nbsp;Sunderland</option>\r\n<option selected=\"selected\" value=\"OMP_SUTT\" id=\"sutton\" data-thissite=\"OMP_SUTT\" data-sitecode=\"OMP_SUTT\">&nbsp;Sutton Surrey</option>\r\n<option value=\"OMP_WIGA\" id=\"wigan\" data-thissite=\"OMP_WIGA\" data-sitecode=\"OMP_SUTT\">&nbsp;Wigan<