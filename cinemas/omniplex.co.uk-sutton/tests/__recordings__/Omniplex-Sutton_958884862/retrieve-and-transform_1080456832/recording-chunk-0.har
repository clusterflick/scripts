.png?v=20260318_01\">\r\n    <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"https://www.omniplexcinemas.co.uk/images/icons/favicon-16x16.png?v=20260318_01\">\r\n    <link rel=\"manifest\" href=\"https://www.omniplexcinemas.co.uk/images/icons/manifest.json?v=20260318_01\">\r\n    <link rel=\"mask-icon\" href=\"https://www.omniplexcinemas.co.uk/images/icons/safari-pinned-tab.svg?v=20260318_01\" color=\"#ffea00\">\r\n    <link rel=\"shortcut icon\" href=\"https://www.omniplexcinemas.co.uk/images/icons/favicon.ico\">\r\n\r\n    <meta name=\"apple-mobile-web-app-title\" content=\"Omniplex Cinemas\">\r\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" />\r\n    <meta name=\"application-name\" content=\"Omniplex Cinemas\">\r\n    <meta name=\"theme-color\" content=\"#FFEA00\" />\r\n    <meta name=\"msapplication-TileColor\" content=\"#383738\">\r\n    <meta name=\"msapplication-TileImage\" content=\"https://www.omniplexcinemas.co.uk/images/icons/mstile-144x144.png?v=20260318_01\">\r\n\r\n        \r\n\r\n    <link rel=\"stylesheet\" href=\"/public/js/flatpickr/flatpickr.min.css\">\r\n    <link href=\"/stylesheet.css?v=20260604_01\" rel=\"stylesheet\">\r\n\r\n    <link rel=\"stylesheet\" href=\"\\public\\js\\libaries\\splide-4.1.3\\dist\\css\\splide.min.css\">\r\n    <script type=\"text/javascript\" src=\"\\public\\js\\libaries\\splide-4.1.3\\dist\\js\\splide.min.js\"></script>\r\n    <script type=\"text/javascript\" src=\"\\public\\js\\components\\dateselector.js?v=20260528_01\"></script>\r\n    <script type=\"text/javascript\" src=\"\\public\\js\\libaries\\jquery\\jquery-3.2.1.min.js\"></script>\r\n    <script type=\"text/javascript\" src=\"\\public\\js\\libaries\\jquery\\jQuery.print.js\"></script>\r\n    \r\n</head>\r\n<!-- START -- Google tag (gtag.js) ---------------------------- --> \r\n <!-- <script async src=\"https://www.googletagmanager.com/gtag/js?id=G-10238KM80X\"></script> <script> window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-10238KM80X'); </script> -->\r\n <!-- END  -- Google tag (gtag.js) ---------------------------- --> \r\n<script>\r\nfunction goToHome() {\r\n  window.location.href = '/cinema/showtimes';\r\n}\r\n\r\nvar GlobalNavigateBackLocation = '/cinema/showtimes';\r\n</script>\r\n<script>\r\n//----------------------------\r\n//if (navigator.geolocation) {\r\n//\tnavigator.geolocation.getCurrentPosition(handleLatLonPosition);\r\n//}\r\n\r\n//----------------------------\r\nfunction handleLatLonPosition(pos) {\r\n\tvar requestURL = '/api/internalapi/?action=setLatLon&lat=' + pos.coords.latitude + '&lng=' + pos.coords.longitude;\r\n\tconsole.log('API: ' + requestURL);\r\n  \t    \r\n\tvar request = $.ajax({\r\n    url: requestURL,\r\n    type: \"get\",\r\n\t\tasync: false,\r\n    data: {}\r\n  });\r\n\t\r\n  request.done(function(response, textStatus, jqXHR){\r\n    console.log('Lat/Lon Stored');\t\t\t\t\t\t\r\n  });\r\n}\r\n</script>    <body class=\" bg-ompGray-ompdark main-bg  text-white min-h-screen\">\r\n        <div id=\"genericOverlay\" class=\"fixed top-0 left-0 inset-0 bg-black/70 backdrop-blur-sm z-[170] hidden\"></div>\r\n    <div id=\"desktopHeader\" class=\"!hidden md:!block relative z-50 my-2\">\r\n      <header class=\"main-container-header w-full text-white\">\r\n        <div class=\"mx-auto flex justify-center h-14 max-w-7xl items-center\">\r\n          <a href=\"/\" class=\"flex items-center\">\r\n            <img src=\"/public/assets/branding/omniplex_logo.png\" class=\"h-9\" alt=\"Omniplex Logo\" />\r\n          </a>\r\n          <nav class=\"flex mx-4 justify-end flex-1 items-center text-sm gap-1 md:gap-2 lg:ml-8 lg:gap-4\">\r\n            <div class=\"\">\r\n                            <a href=\"/cinema/showtimes\" class=\"header-navigation px-2 py-1 text-white/80 hover:text-white active\">Showtimes</a>\r\n                            <a href=\"/cinema/movies\" class=\"header-navigation px-2 py-1 text-white/80 hover:text-white \">Trailers</a>\r\n                            <a href=\"/cinema/classics\" class=\"header-navigation px-2 py-1 text-white/80 hover:text-white \">Classics</a>\r\n                            <a href=\"/cinema/kids\" class=\"header-navigation px-2 py-1 text-white/80 hover:text-white \">Kids</a>\r\n                            <a href=\"/booking/extras-home\" class=\"header-navigation px-2 py-1 text-white/80 hover:text-white \">Food</a>\r\n                            <a href=\"/company/about\" class=\"header-navigation px-2 py-1 text-white/80 hover:text-white \">Our Cinema</a>\r\n                          </div>\r\n          </nav>\r\n          <div class=\"flex items-center gap-2\">\r\n                        <a class=\"rounded p-1\" href=\"/account/login\">\r\n              <i class=\"icon omni-user-circle text-[24px] \"></i>\r\n            </a>\r\n            <!-- myomnipass -->\r\n                         <a href=\"/join/landing\" class=\"p-1  hidden lg:block\">\r\n              <img src=\"/public/assets/branding/omnipass.png\" class=\"h-6\" alt=\"Omnipass\" />\r\n            </a>\r\n            <a href=\"/account/login\" class=\"p-1 block lg:hidden\">\r\n              <img src=\"/public/assets/branding/mobile-omnipass.svg\" class=\"h-8\" alt=\"Omnipass\" />\r\n            </a>\r\n          </div>\r\n        </div>\r\n        \r\n      </header>\r\n    </div>\r\n\r\n    <div id=\"mobibleHeader\" class=\"block md:hidden  relative my-2 z-50\">\r\n            <header id=\"standard-menu\" class=\"flex items-center justify-between p-4 relative\">\r\n        <div class=\"text-white focus:outline-none flex items-center justify-between flex-1\">\r\n          <button id=\"menuButton\" class=\"text-white focus:outline-none\">\r\n            <i class=\"a1-application-menu-burger text-[24px] \"></i>\r\n          </button>\r\n          <p>&nbsp;</p>\r\n        </div>\r\n        <a href=\"/\" class=\"shrink-0\">\r\n          <img src=\"/public/assets/branding/omniplex_logo.png\" class=\"w-1/2 mx-auto block w-[114px]\" />\r\n        </a>\r\n        <div class=\"text-white focus:outline-none flex items-center gap-2 flex-1 flex justify-end\">\r\n                    <a class=\"rounded p-1\" href=\"/account/login\">\r\n            <i class=\"icon omni-user-circle text-[24px] \"></i>\r\n          </a>\r\n          <a href=\"/join/landing\">\r\n            <!-- <i class=\"icon omni-user-circle text-[24px] \"></i> -->\r\n            <img src=\"/public/assets/branding/myomnipass-sm.png\" class=\"h-8\" alt=\"Omnipass\" />\r\n          </a>\r\n        </div>\r\n      </header>\r\n      <div id=\"menu\"\r\n    class=\"main-bg inset-0 text-white bg-black fixed transform -translate-x-full transition-transform duration-300 ease-in-out z-50 \"\r\n    style=\"z-index:99999;\">\r\n    <button onclick=\"closeModal()\" id=\"closeButton\" class=\"w-full px-4 block relative text-right mt-8 mb-4\">\r\n      <i class=\"icon omni-close text-xl\"></i>\r\n    </button>\r\n    <nav class=\"px-4 h-full overflow-scroll\">\r\n      <div class=\"mb-8 border-b border-1 border-white\">\r\n        <p class=\"mb-2 menu-location-title\">Preferred location: </p>\r\n        <div class=\"flex items-center\"><a href=\"/cinema/site\" class=\"js-site-link\"><span class=\"menu-location pr-1 py-1 text-2xl font-semibold\">Sutton Surrey</span><i class=\"icon omni-chevron-down mx-1 text-xl cursor-pointer\"></i></a></div>        <a class=\"block text-base my-2 py-4\" href=\"/company/about\">Our Cinema</a>\r\n      </div>\r\n      <ul id=\"menu-items\" class=\"text-lg\">\r\n                        <li class=\"menu-item pb-4\">\r\n          <a href=\"/ticketchanges/home\" class=\"block text-ompYellow \">\r\n            Ticket Changes            <!-- <div style=\"height: 8\"></div> -->\r\n          </a>\r\n        </li>\r\n                                  <li class=\"menu-item pb-4\">\r\n          <a href=\"/booking/extras-home\" class=\"block  \">\r\n            Food            <!-- <div style=\"height: 8\"></div> -->\r\n          </a>\r\n        </li>\r\n                                  <li class=\"menu-item pb-4\">\r\n          <a href=\"/cinema/kids\" class=\"block  \">\r\n            Kids            <!-- <div style=\"height: 8\"></div> -->\r\n          </a>\r\n        </li>\r\n                                  <li class=\"menu-item pb-4\">\r\n          <a href=\"/cinema/events\" class=\"block  \">\r\n            Events            <!-- <div style=\"height: 8\"></div> -->\r\n          </a>\r\n        </li>\r\n                                      <li class=\"menu-drop pb-4\">\r\n              <button onclick=\"toggleDropdown('dropdown')\"\r\n                class=\"w-full text-left flex justify-between items-center \">\r\n                Gift Cards                <i class=\"icon omni-chevron-down\"></i>\r\n              </button>\r\n              <ul id=\"dropdown\" style=\"margin-bottom: 16px\" class=\"hidden my-small pl-4 space-y-2\">\r\n                                <li class=\"!my-small\">\r\n                  <a href=\"/giftcards/choose\">\r\n                    Buy an e-gift card                  </a>\r\n                </li>\r\n                                <li class=\"!my-small\">\r\n                  <a href=\"/giftcards/balance\">\r\n                    Check gift card amount                  </a>\r\n                </li>\r\n                                <!-- <div style=\"height: 8\"></div> -->\r\n              </ul>\r\n            </li>\r\n                                      <li class=\"menu-drop pb-4\">\r\n              <button onclick=\"toggleDropdown('dropdown1')\"\r\n                class=\"w-full text-left flex justify-between items-center \">\r\n                Help                <i class=\"icon omni-chevron-down\"></i>\r\n              </button>\r\n              <ul id=\"dropdown1\" style=\"margin-bottom: 16px\" class=\"hidden my-small pl-4 space-y-2\">\r\n                                <li class=\"!my-small\">\r\n                  <a href=\"/company/faq\">\r\n                    Frequently asked questions                  </a>\r\n                </li>\r\n                                <li class=\"!my-small\">\r\n                  <a href=\"/company/contact\">\r\n                    Contact us                  </a>\r\n                </li>\r\n                                <!-- <div style=\"height: 8\"></div> -->\r\n              </ul>\r\n            </li>\r\n                                  <li class=\"menu-item pb-4\">\r\n          <a href=\"/account/login\" class=\"block  font-bold\">\r\n            Sign in to My Account <br/> <span class=\"font-normal\">(my tickets, food orders)</span>            <!-- <div style=\"height: 8\"></div> -->\r\n          </a>\r\n        </li>\r\n                                  <li class=\"menu-item pb-4\">\r\n          <a href=\"/join/landing\" class=\"block  font-bold\">\r\n            Create an Account            <!-- <div style=\"height: 8\"></div> -->\r\n          </a>\r\n        </li>\r\n                        </ul>\r\n    </nav>\r\n  </div>          </div>\r\n  <!-- Filter Slider -->\r\n<div id=\"filter\"\r\n  class=\"main-bg fixed top-0 right-0 h-full\r\n         w-full sm:w-3/4 md:w-1/2 lg:w-1/3 xl:w-1/4\r\n         text-white transform transition-transform duration-300 ease-in-out\r\n         z-[172] flex flex-col translate-x-full opacity-100\">\r\n  <form id=\"searchFilterForm\" method=\"GET\" action=\"\" class=\"flex flex-col h-full\">\r\n    <input type=\"hidden\" name=\"action\" value=\"processFilters\">\r\n    <input type=\"hidden\" name=\"filterDate\" />    \r\n    \r\n    <!-- Header: Fixed Back Button -->\r\n    <div class=\"px-6 mt-6\">\r\n      <button id=\"closeFilterButton\" class=\"mb-6\">\r\n        <a class=\"text-ompYellow flex items-center\">\r\n          <i class=\"text-ompYellow icon omni-chevron-left pr-2 header-navigation\"></i>\r\n          <p class=\"text-ompYellow header-navigation\">Back</p>\r\n        </a>\r\n      </button>\r\n    </div>\r\n\r\n    <!-- Scrollable Filter Content -->\r\n    <div class=\"flex-grow overflow-y-auto px-8\">\r\n      <h2 class=\"text-lg font-bold mb-4\">Filters</h2>\r\n      \r\n            \r\n        <div class=\"mb-big\">\r\n          <h3 class=\"text-md font-semibold\">Time of day</h3>\r\n          <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"daytimeFilter\" class=\"cursor-pointer\">Daytime (Before 5pm)</label>\r\n              <input type=\"checkbox\" id=\"daytimeFilter\" name=\"daytimeFilter\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n          <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"eveningFilter\" class=\"cursor-pointer\">Evening (After 5pm)</label>\r\n              <input type=\"checkbox\" id=\"eveningFilter\" name=\"eveningFilter\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n        </div>\r\n              <div class=\"mb-big\">\r\n          <h3 class=\"text-md font-semibold\">Age Rating</h3>\r\n\r\n          <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"ageRatingUPGFilter\" class=\"cursor-pointer font-medium\">U</label>\r\n              <input type=\"checkbox\" id=\"ageRatingUPGFilter\" name=\"age_u_g\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n\r\n          <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"ageRatingUPGFilter\" class=\"cursor-pointer font-medium\">PG</label>\r\n              <input type=\"checkbox\" id=\"ageRatingUPGFilter\" name=\"age_pg\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n\r\n          <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"ageRating12aFilter\" class=\"cursor-pointer font-medium\">12/12A</label>\r\n              <input type=\"checkbox\" id=\"ageRating12aFilter\" name=\"age_12_12a\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n\r\n                      <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n              <div class=\"flex items-center justify-between w-full\">\r\n                <label for=\"ageRating15Filter\" class=\"cursor-pointer font-medium\">15</label>\r\n                <input type=\"checkbox\" id=\"ageRating15Filter\" name=\"age_15\" class=\"hidden\" >\r\n                                  <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                              </div>\r\n            </div>\r\n          \r\n          \r\n          <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"ageRating18Filter\" class=\"cursor-pointer font-medium\">18</label>\r\n              <input type=\"checkbox\" id=\"ageRating18Filter\" name=\"age_18\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n        </div>\r\n            \r\n        <!-- <div class=\"mb-big\">\r\n          <h3 class=\"text-md font-semibold\">Genre</h3>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Action\" class=\"cursor-pointer\">Action (6)</label>\r\n              <input type=\"checkbox\" id=\"genre_Action\" name=\"genre_Action\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Adventure\" class=\"cursor-pointer\">Adventure (7)</label>\r\n              <input type=\"checkbox\" id=\"genre_Adventure\" name=\"genre_Adventure\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Animation\" class=\"cursor-pointer\">Animation (6)</label>\r\n              <input type=\"checkbox\" id=\"genre_Animation\" name=\"genre_Animation\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Comedy\" class=\"cursor-pointer\">Comedy (7)</label>\r\n              <input type=\"checkbox\" id=\"genre_Comedy\" name=\"genre_Comedy\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Drama\" class=\"cursor-pointer\">Drama (4)</label>\r\n              <input type=\"checkbox\" id=\"genre_Drama\" name=\"genre_Drama\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Event\" class=\"cursor-pointer\">Event (10)</label>\r\n              <input type=\"checkbox\" id=\"genre_Event\" name=\"genre_Event\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Family\" class=\"cursor-pointer\">Family (4)</label>\r\n              <input type=\"checkbox\" id=\"genre_Family\" name=\"genre_Family\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Fantasy\" class=\"cursor-pointer\">Fantasy (3)</label>\r\n              <input type=\"checkbox\" id=\"genre_Fantasy\" name=\"genre_Fantasy\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Horror\" class=\"cursor-pointer\">Horror (2)</label>\r\n              <input type=\"checkbox\" id=\"genre_Horror\" name=\"genre_Horror\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Romance\" class=\"cursor-pointer\">Romance (1)</label>\r\n              <input type=\"checkbox\" id=\"genre_Romance\" name=\"genre_Romance\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Sci-Fi\" class=\"cursor-pointer\">Sci-Fi (1)</label>\r\n              <input type=\"checkbox\" id=\"genre_Sci-Fi\" name=\"genre_Sci-Fi\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Thriller\" class=\"cursor-pointer\">Thriller (2)</label>\r\n              <input type=\"checkbox\" id=\"genre_Thriller\" name=\"genre_Thriller\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n              \r\n        </div> -->\r\n            \r\n      <div class=\"mb-big\">\r\n        <h3 class=\"text-md font-semibold\">Accessibility Options</h3>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-audio-described\"></i>\r\n              <label for=\"audioDescriptionFilter\" class=\"cursor-pointer font-medium\">Audio Description</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"audioDescriptionFilter\" name=\"access_audioDescription\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Grab a headset and enjoy detailed screen descriptions. <a href=\"/filters/audiodescribed\" class=\"text-ompYellow\">Learn more</a></p> \r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-sensory-friendly-56\"></i>\r\n              <label for=\"sensoryFriendlyFilter\" class=\"cursor-pointer font-medium\">Sensory Friendly</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"sensoryFriendlyFilter\" name=\"access_sensoryFriendly\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Held every weekend around noon at all Omniplex cinemas. <a href=\"/filters/sensoryfriendly\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>        \r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-subtitles\"></i>\r\n              <label for=\"subtitledFilter\" class=\"cursor-pointer font-medium\">Subtitled</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"subtitledFilter\" name=\"access_subtitled\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Available for blockbuster movies on Monday evenings. <a href=\"/filters/subtitled\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>        \r\n      </div>      \r\n          \r\n      <div class=\"mb-big\">\r\n        <h3 class=\"text-md font-semibold\">Special Screenings</h3>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-kids-club\"></i>\r\n              <label for=\"kidsClubFilter\" class=\"cursor-pointer font-medium\">Kids Club</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"kidsClubFilter\" name=\"special_kidsClub\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Save on select family films every weekend. <a href=\"/filters/kidsclub\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-secret-screeningss\"></i>\r\n              <label for=\"secretScreenFilter\" class=\"cursor-pointer font-medium\">Secret Screenings</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"secretScreenFilter\" name=\"special_secretScreen\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">You'll know the genre, but the movie is a surprise! <a href=\"/filters/secretscreenings\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-live-and-eventss\"></i>\r\n              <label for=\"liveEventsFilter\" class=\"cursor-pointer font-medium\">Live &amp; Events</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"liveEventsFilter\" name=\"special_liveEvents\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Watch pre-recorded and live events from around the world on the big screen. <a href=\"/filters/liveevents\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-star-full\"></i>\r\n              <label for=\"classicsFilter\" class=\"cursor-pointer font-medium\">Classics</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"classicsFilter\" name=\"special_classics\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Relive fan-favourite classics on the big screen every month.</p>\r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-kids-club\"></i>\r\n              <label for=\"parentbabyFilter\" class=\"cursor-pointer font-medium\">Parent &amp; Baby</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"parentbabyFilter\" name=\"special_parentbaby\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Wednesdays for movie time with your little one! <a href=\"#\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>        \r\n      </div>    \r\n        </div>\r\n    \r\n    <!-- Footer: Fixed Bottom Buttons -->\r\n    <div class=\"px-8 py-4 bg-black border-t border-gray-700\">\r\n      <div class=\"flex justify-between\">\r\n        <button id=\"clearFilters\" class=\"mx-2 w-full bg-gray-600 px-4 py-2 rounded text-white\">Clear all</button>\r\n        <button id=\"applyFilters\" class=\"mx-2 w-full bg-ompYellow px-4 py-2 rounded text-black\">Apply</button>\r\n      </div>\r\n    </div>\r\n  </form>\r\n</div><!-- Info Start  -->\r\n<!-- Info End  -->\r\n\r\n<!-- Success Alert Start  -->\r\n<!-- Success Alert End  -->\r\n\r\n<!-- Error Alert Start  -->\r\n<!-- Error Alert End  -->\r\n\r\n<script>\r\ndocument.addEventListener(\"DOMContentLoaded\", function() {\r\n  document.querySelectorAll('.relative').forEach(function(alert) {\r\n    requestAnimationFrame(function() {\r\n      alert.classList.remove('hidden');\r\n      alert.classList.add('block');\r\n    });\r\n  });\r\n  document.querySelectorAll('.close-alert').forEach(function(button) {\r\n    button.addEventListener('click', function() {\r\n      const alertDiv = button.closest('.relative');\r\n      if (alertDiv) {\r\n        alertDiv.classList.remove('block');\r\n        alertDiv.classList.add('hidden');\r\n      }\r\n    });\r\n  });\r\n});\r\n</script>\r\n<!-- Display when user clicks star to remove from watch list  -->\r\n<div id=\"removeFavouriteMovie\" class=\"overflow-hidden hidden\">\r\n  <div class=\"fixed inset-0 flex items-center justify-center z-50\">\r\n    <div id=\"backgroundOverlay\" class=\"absolute inset-0 bg-black opacity-90 pointer-events-none\"></div>\r\n    <div class=\"relative p-6 rounded shadow-lg z-10\">\r\n      <p class=\"mb-4\">Do you want to remove this movie from your Want to Watch List?</p>\r\n      <h2 class=\"text-4xl font-bold my-mid text-center\" id=\"removeFavouriteMovieName\">Stolen</h2>\r\n      <div class=\"\">\r\n        <input type=\"hidden\" id=\"removeFavouriteMovieCode\" value=\"\" />\r\n        <button class=\"btn-solid-yellow mb-4\" onClick=\"removeFavourite();return false;\">Yes, remove from my list</button>\r\n        <button class=\"btn-solid-gray\" onClick=\"closeRemoveFavouriteModal();return false;\">No, go back</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>  \r\n<!-- END - Display when user clicks star to remove from watch list  -->\r\n\r\n\r\n<!-- Display when user selects a different site for food  -->\r\n<div id=\"confirmFoodSite\" class=\"overflow-hidden hidden\">\r\n  <div class=\"fixed inset-0 flex items-center justify-center z-50\">\r\n    <div id=\"backgroundOverlay\" class=\"absolute inset-0 bg-black/70 backdrop-blur-sm pointer-events-none\"></div>\r\n    <div class=\"relative p-6 rounded shadow-lg z-10 bg-ompGray rounded-lg\">\r\n      <p class=\"mb-4\">You are ordering food for collection at</p>\r\n      <h2 class=\"text-4xl font-bold my-mid text-center\" id=\"closeConfirmFoodSiteName\">Site Name</h2>\r\n      <div class=\"\">\r\n      <button class=\"btn-solid-yellow mb-2\" onClick=\"sumbitForm()\">Confirm</button>\r\n        <button class=\"btn-solid-gray\" onClick=\"closeConfirmFoodSite();return false;\">No, go back</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>  \r\n<!-- END - Display when user selects a different site for food  -->  <div class=\"main-container-full block md:hidden mb-mid relative z-[5]\">\r\n    <div class=\"w-full z-50\">\r\n      <div id=\"mobileSliderNav\" class=\"group-nav-container\" style=\"cursor: grab;\">\r\n        <!-- active  -->\r\n                    <button\r\n              onclick=\"navigateTo('/cinema/showtimes')\"\r\n              class=\"group-nav-item active\"\r\n            >\r\n              <p>Showtimes</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/cinema/movies')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Trailers</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/cinema/classics')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Classics</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/cinema/kids')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Kids</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/booking/extras-home')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Food</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/company/about')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Our Cinema</p>\r\n            </button>\r\n              </div>\r\n    </div>\r\n  </div>\r\n  <script>\r\n    document.addEventListener('DOMContentLoaded', () => {\r\n\r\n      const nav = document.getElementById('mobileSliderNav');\r\n      if (!nav) return;\r\n\r\n      const items = Array.from(nav.querySelectorAll('.group-nav-item'));\r\n      const sections = items.map(btn => document.getElementById(btn.dataset.target));\r\n\r\n      let suppressNavClick = false;\r\n\r\n      // Expose to inline onclick\r\n      window.navigateTo = function(url) {\r\n        if (suppressNavClick) return;\r\n        window.location.href = url;\r\n      };\r\n\r\n      function setActive(activeIdx) {\r\n        items.forEach((btn, i) => {\r\n          btn.classList.toggle('active', i === activeIdx);\r\n        });\r\n      }\r\n\r\n      function centerNavItem(btn, behavior = 'smooth') {\r\n        const desired =\r\n          btn.offsetLeft + (btn.offsetWidth / 2) - (nav.clientWidth / 2);\r\n\r\n        const maxScroll = nav.scrollWidth - nav.clientWidth;\r\n        const clamped = Math.max(0, Math.min(desired, maxScroll));\r\n\r\n        nav.scrollTo({\r\n          left: clamped,\r\n          behavior\r\n        });\r\n      }\r\n\r\n      // Center active item on load\r\n      const initiallyActive = nav.querySelector('.group-nav-item.active');\r\n      if (initiallyActive) centerNavItem(initiallyActive, 'auto');\r\n\r\n      // --- Drag to scroll ---\r\n      (function enableDragScroll(container) {\r\n\r\n        let isDown = false;\r\n        let startX = 0;\r\n        let startScrollLeft = 0;\r\n        let dragging = false;\r\n\r\n        const DRAG_THRESHOLD = 10;\r\n\r\n        container.style.cursor = 'grab';\r\n\r\n        container.addEventListener('pointerdown', (e) => {\r\n          if (e.pointerType === 'mouse' && e.button !== 0) return;\r\n\r\n          isDown = true;\r\n          dragging = false;\r\n          startX = e.clientX;\r\n          startScrollLeft = container.scrollLeft;\r\n\r\n          container.style.cursor = 'grabbing';\r\n        });\r\n\r\n        container.addEventListener('pointermove', (e) => {\r\n          if (!isDown) return;\r\n\r\n          const dx = e.clientX - startX;\r\n\r\n          if (!dragging && Math.abs(dx) > DRAG_THRESHOLD) {\r\n            dragging = true;\r\n          }\r\n\r\n          if (dragging) {\r\n            if (e.cancelable) e.preventDefault();\r\n            container.scrollLeft = startScrollLeft - dx;\r\n          }\r\n\r\n        }, { passive: false });\r\n\r\n        container.addEventListener('pointerup', () => {\r\n          isDown = false;\r\n          container.style.cursor = 'grab';\r\n\r\n          if (dragging) {\r\n            suppressNavClick = true;\r\n            setTimeout(() => {\r\n              suppressNavClick = false;\r\n            }, 0);\r\n          }\r\n        });\r\n\r\n        container.addEventListener('pointercancel', () => {\r\n          isDown = false;\r\n          container.style.cursor = 'grab';\r\n        });\r\n\r\n      })(nav);\r\n\r\n    });\r\n  </script>\r\n\r\n\r\n<!-- Here   -->\r\n\r\n<link rel=\"stylesheet\" href=\"/include/A1CookieManager/css/main.css?v=20260528_01\" type=\"text/css\"> \r\n<div id=\"cookieOverlay\" class=\"OMP_overlay backdrop-blur-sm\" style=\"pointer-events:none;\"></div>\r\n<div id=\"cookieConsentBar\" style=\"display: none;\">\r\n  <div class=\"cookie-consent-banner\">\r\n    <p>We use cookies on our website to personalise and improve your experience and ensure the website works\r\n      correctly.\r\n      <a style=\"text-decoration:underline;\" href=\"/company/privacy#cookieAnchor\" target=\"_blank\">View our Cookie Policy</a>.\r\n    </p>\r\n    <div class=\"cookie-buttons\">\r\n      \r\n    <button id=\"managePrefs\" onclick=\"toggleManage()\" class=\"cookie-button btn-solid-gray !mx-px\" id=\"manage-cookies\">Manage</button>\r\n      <button id=\"savePrefs\" onclick=\"checkCookiePerfs()\" class=\"cookie-button btn-solid-yellow !mx-px\" style=\"display:none;\">Save Preferences</button>\r\n    <button id=\"acceptAll\" onclick=\"setCookieCookie('ALL')\" class=\"cookie-button btn-solid-yellow !mx-px\">Accept All</button>\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"manageOptions\" style=\"display:none;\">\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Necessary</h3>\r\n                      <p>Necessary cookies are required to enable the basic features of this site, such as providing secure log-in or adjusting your consent preferences. These cookies do not store any personally identifiable data.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Necessary\"\r\n                                  checked                                  disabled>\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreNecessary')\">More Details</button>\r\n              <div id=\"moreNecessary\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                                                  <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> a1wcc</li>\r\n                              <li><strong>Duration:</strong> 1 year</li>\r\n                              <li><strong>Description:</strong> Stores the user&rsquo;s consent and preferences for website cookies. This cookie remembers the user&rsquo;s choices regarding the acceptance or rejection of specific cookie categories, ensuring personalized settings are applied on subsequent visits.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> PHPSESSID</li>\r\n                              <li><strong>Duration:</strong> Session</li>\r\n                              <li><strong>Description:</strong> Creates a unique session identifier for each visitor to maintain session data across multiple pages. It does not contain personal information and is deleted when the user closes their browser. This cookie is essential for enabling user functionalities and preferences during the active session.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> __cflb</li>\r\n                              <li><strong>Duration:</strong> 24 hours</li>\r\n                              <li><strong>Description:</strong> CloudFlare&rsquo;s session affinity cookie used to map your session to the correct server.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> sitecode</li>\r\n                              <li><strong>Duration:</strong> 1 hour</li>\r\n                              <li><strong>Description:</strong> The cinema location you have selected.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> omnicustomer</li>\r\n                              <li><strong>Duration:</strong> 2 weeks</li>\r\n                              <li><strong>Description:</strong> A token for the login, if &lsquo;stay logged in&rsquo; is selected.</li>\r\n                          </ul>\r\n                                                      </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Analytics</h3>\r\n                      <p>Analytical cookies are used to understand how visitors interact with the website. These cookies help provide information on metrics such as the number of visitors, bounce rate, traffic source, etc.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Analytics\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreAnalytics')\">More Details</button>\r\n              <div id=\"moreAnalytics\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                                                  <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _ga</li>\r\n                              <li><strong>Duration:</strong> 2 years</li>\r\n                              <li><strong>Description:</strong> Registers a unique ID that is used to generate statistical data on how the visitor uses the website.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _ga_C6EGS4GGTV</li>\r\n                              <li><strong>Duration:</strong> 2 years</li>\r\n                              <li><strong>Description:</strong> Used by Google Analytics to collect data on the number of times a user has visited the website as well as dates for the first and most recent visit.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _ga_Y8PVGSGW5G</li>\r\n                              <li><strong>Duration:</strong> 2 years</li>\r\n                              <li><strong>Description:</strong> Used to persist session state.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _gat_gtag_UA_2532751_2</li>\r\n                              <li><strong>Duration:</strong> 1 minute</li>\r\n                              <li><strong>Description:</strong> Used by Google Analytics to throttle request rate.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _gat_gtag_UA_56401285_6</li>\r\n                              <li><strong>Duration:</strong> 1 minute</li>\r\n                              <li><strong>Description:</strong> Used to throttle request rate.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _gid</li>\r\n                              <li><strong>Duration:</strong> 24 hours</li>\r\n                              <li><strong>Description:</strong> Registers a unique ID that is used to generate statistical data on how the visitor uses the website.</li>\r\n                          </ul>\r\n                                                      </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Functional</h3>\r\n                      <p>Functional cookies help perform certain functionalities like sharing the content of the website on social media platforms, collecting feedback, and other third-party features.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Functional\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreFunctional')\">More Details</button>\r\n              <div id=\"moreFunctional\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Performance</h3>\r\n                      <p>Performance cookies are used to understand and analyze the key performance indexes of the website which helps in delivering a better user experience for the visitors.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Performance\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('morePerformance')\">More Details</button>\r\n              <div id=\"morePerformance\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Advertisement</h3>\r\n                      <p>Advertisement cookies are used to provide visitors with customized advertisements based on the pages you visited previously and to analyze the effectiveness of the ad campaigns.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Advertisement\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreAdvertisement')\">More Details</button>\r\n              <div id=\"moreAdvertisement\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Other</h3>\r\n                      <p>Other uncategorized cookies are those that are being analyzed and have not been classified into a category as yet.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Other\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreOther')\">More Details</button>\r\n              <div id=\"moreOther\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n    </div>\r\n</div>\r\n\r\n<script type=\"text/javascript\" src=\"/include/A1CookieManager/script/main.js?v=20260528_01\"></script><div id=\"siteModal\" class=\"fixed inset-0 z-[60] flex items-center justify-center p-4 hidden\">\r\n  <div class=\"absolute inset-0 bg-black/70 backdrop-blur-sm\"></div>\r\n  <div class=\"relative z-[70] w-full max-w-[640px] h-[85vh]\">\r\n    <style>\r\n  #siteScrollArea {\r\n    -ms-overflow-style: none;\r\n    scrollbar-width: none;\r\n  }\r\n\r\n  #siteScrollArea::-webkit-scrollbar {\r\n    display: none;\r\n  }\r\n</style>\r\n\r\n<div class=\"flex h-full flex-col overflow-hidden rounded-xl bg-[#282828]\">\r\n\r\n  <div class=\"shrink-0 bg-[#282828] px-4 pt-8 pb-4\">\r\n    <div class=\"text-right mb-4 px-4\">\r\n      <i onclick=\"toggleLoginModal()\" class=\"text-ompYellow icon omni-close cursor-pointer\"></i>\r\n    </div>\r\n    <div class=\"w-full md:w-3/4 mx-auto w-full max-w-[560px]\">\r\n      <div id=\"login_section\" class=\"mb-6 w-full\">\r\n        <h1 class=\"text-3xl leading-tight font-normal text-white\">\r\n          Which is your local Omniplex?\r\n        </h1>\r\n      </div>\r\n\r\n      <div class=\"input-search  overflow-hidden rounded-md\">\r\n        <i class=\"icon omni-search text-white/80\"></i>\r\n        <input id=\"search\" placeholder=\"Search\" type=\"text\" class=\"text-white placeholder:text-white/50\" />\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"siteScrollArea\" class=\"flex-1 overflow-y-auto px-4\">\r\n    <div class=\"w-full md:w-3/4 mx-auto w-full max-w-[560px] py-6\">\r\n      <div id=\"site-selection-list\" class=\"border-t border-b border-ompYellow/30 py-4\">\r\n        <form id=\"siteList-modal\">\r\n          \r\n          <div class=\"region-group mb-2\"><div class=\"region-header flex cursor-pointer items-center justify-between py-3\"><p class=\"text-xl text-white\">England</p><i class=\"icon-swtich icon omni-chevron-up text-xl text-white\"></i></div><div class=\"region-items\"><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Birmingham - Great Park</p></div><div><input type=\"checkbox\" value=\"OMP_BIRM\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">High Wycombe</p></div><div><input type=\"checkbox\" value=\"OMP_HIWY\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Ipswich</p></div><div><input type=\"checkbox\" value=\"OMP_IPSW\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Sunderland</p></div><div><input type=\"checkbox\" value=\"OMP_SUND\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Sutton Surrey</p></div><div><input type=\"checkbox\" value=\"OMP_SUTT\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Wigan</p></div><div><input type=\"checkbox\" value=\"OMP_WIGA\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div></div></div><div class=\"region-group mb-2\"><div class=\"region-header flex cursor-pointer items-center justify-between py-3\"><p class=\"text-xl text-white\">Scotland</p><i class=\"icon-swtich icon omni-chevron-up text-xl text-white\"></i></div><div class=\"region-items\"><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Clydebank</p></div><div><input type=\"checkbox\" value=\"OMP_CLYD\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Glasgow - Renfrew Street</p></div><div><input type=\"checkbox\" value=\"OMP_GLAS\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div></div></div><div class=\"region-group mb-2\"><div class=\"region-header flex cursor-pointer items-center justify-between py-3\"><p class=\"text-xl text-white\">Northern Ireland</p><i class=\"icon-swtich icon omni-chevron-up text-xl text-white\"></i></div><div class=\"region-items\"><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Antrim</p></div><div><input type=\"checkbox\" value=\"OMP_ANTR\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Banbridge</p></div><div><input type=\"checkbox\" value=\"OMP_BANB\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Bangor</p></div><div><input type=\"checkbox\" value=\"OMP_BANG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Belfast - Dundonald</p></div><div><input type=\"checkbox\" value=\"OMP_DUDO\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Belfast - Kennedy Centre</p></div><div><input type=\"checkbox\" value=\"OMP_KENN\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Carrickfergus</p></div><div><input type=\"checkbox\" value=\"OMP_CARR\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Craigavon</p></div><div><input type=\"checkbox\" value=\"OMP_CRAI\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Derry</p></div><div><input type=\"checkbox\" value=\"OMP_DERR\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Downpatrick</p></div><div><input type=\"checkbox\" value=\"OMP_DOWN\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Dungannon</p></div><div><input type=\"checkbox\" value=\"OMP_DUGA\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Larne</p></div><div><input type=\"checkbox\" value=\"OMP_LARN\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Lisburn</p></div><div><input type=\"checkbox\" value=\"OMP_LISB\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Newry</p></div><div><input type=\"checkbox\" value=\"OMP_NEWR\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Omagh</p></div><div><input type=\"checkbox\" value=\"OMP_OMAG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div></div></div><div class=\"region-group mb-2\"><div class=\"region-header flex cursor-pointer items-center justify-between py-3\"><p class=\"text-xl text-white\">Rep. of Ireland</p><i class=\"icon-swtich icon omni-chevron-up text-xl text-white\"></i></div><div class=\"region-items\"><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Arklow</p></div><div><input type=\"checkbox\" value=\"OMP_ARKL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Ballinasloe</p></div><div><input type=\"checkbox\" value=\"OMP_BALL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Carlow</p></div><div><input type=\"checkbox\" value=\"OMP_CARL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Cork</p></div><div><input type=\"checkbox\" value=\"OMP_MAHO\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Drogheda - Scotch Hall</p></div><div><input type=\"checkbox\" value=\"OMP_SCOT\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Dublin - Balbriggan</p></div><div><input type=\"checkbox\" value=\"OMP_BALB\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Dublin - Nutgrove</p></div><div><input type=\"checkbox\" value=\"OMP_NUTG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Dublin - Rathmines</p></div><div><input type=\"checkbox\" value=\"OMP_RATH\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Dundalk</p></div><div><input type=\"checkbox\" value=\"OMP_DUND\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Galway - Salthill</p></div><div><input type=\"checkbox\" value=\"OMP_GALW\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Killarney</p></div><div><input type=\"checkbox\" value=\"OMP_KILL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Limerick</p></div><div><input type=\"checkbox\" value=\"OMP_LIME\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Longford</p></div><div><input type=\"checkbox\" value=\"OMP_LONG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Monaghan</p></div><div><input type=\"checkbox\" value=\"OMP_MONA\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Mullingar</p></div><div><input type=\"checkbox\" value=\"OMP_MULL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Nenagh</p></div><div><input type=\"checkbox\" value=\"OMP_NENA\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Roscommon</p></div><div><input type=\"checkbox\" value=\"OMP_ROSC\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Shannon</p></div><div><input type=\"checkbox\" value=\"OMP_SHAN\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Sligo</p></div><div><input type=\"checkbox\" value=\"OMP_SLIG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Tralee</p></div><div><input type=\"checkbox\" value=\"OMP_TRAL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Waterford</p></div><div><input type=\"checkbox\" value=\"OMP_WATE\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Wexford</p></div><div><input type=\"checkbox\" value=\"OMP_WEXF\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div></div></div>\r\n          <input type=\"hidden\" class=\"action\" name=\"action\" value=\"process\" />\r\n        </form>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"footerControl\" class=\"hidden shrink-0 bg-[#282828]\">\r\n    <div class=\"main-container mx-auto w-full max-w-[560px] px-4 py-4\">\r\n      <button id=\"siteSelectButton\" type=\"button\" class=\"btn-solid-yellow w-full\" onclick=\"siteSelectProceed();\">\r\n        Continue\r\n      </button>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<script>\r\n  document.addEventListener(\"DOMContentLoaded\", function() {\r\n    const siteContainers = document.querySelectorAll(\".site-selection-item\");\r\n    const footerControl  = document.getElementById('footerControl');\r\n    const searchInput    = document.getElementById('search');\r\n    const regionHeaders  = document.querySelectorAll('.region-header');\r\n    const regionItems    = document.querySelectorAll('.region-items');\r\n\r\n    function resetCheckboxes() {\r\n      siteContainers.forEach(container => {\r\n        const cb  = container.querySelector(\"input[type='checkbox']\");\r\n        const img = container.querySelector(\".checkbox-img\");\r\n\r\n        if (cb && img) {\r\n          cb.checked = false;\r\n          img.src = \"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\";\r\n        }\r\n      });\r\n    }\r\n\r\n    siteContainers.forEach(container => {\r\n      const cb  = container.querySelector(\"input[type='checkbox']\");\r\n      const img = container.querySelector(\".checkbox-img\");\r\n\r\n      if (!cb || !img) {\r\n        return;\r\n      }\r\n\r\n      container.addEventListener(\"click\", function() {\r\n        if (!cb.checked) {\r\n          resetCheckboxes();\r\n          cb.checked = true;\r\n          img.src = \"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-on.svg\";\r\n          footerControl.classList.remove('hidden');\r\n        } else {\r\n          cb.checked = false;\r\n          img.src = \"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\";\r\n          footerControl.classList.add('hidden');\r\n        }\r\n      });\r\n    });\r\n\r\n    searchInput.addEventListener(\"input\", function() {\r\n      const q     = this.value.toLowerCase().trim();\r\n      const items = document.querySelectorAll('.site-selection-item');\r\n\r\n      if (q) {\r\n        regionHeaders.forEach(h => h.style.display = 'none');\r\n        regionItems.forEach(r => r.style.display = '');\r\n        items.forEach(item => {\r\n          const txt = item.querySelector('p').textContent.toLowerCase();\r\n          item.style.display = txt.includes(q) ? 'flex' : 'none';\r\n        });\r\n      } else {\r\n        regionHeaders.forEach(h => h.style.display = '');\r\n        regionItems.forEach(r => r.style.display = 'none');\r\n        items.forEach(i => i.style.display = '');\r\n      }\r\n    });\r\n\r\n    document.querySelectorAll('.region-group').forEach(group => {\r\n      const header = group.querySelector('.region-header');\r\n      const items  = group.querySelector('.region-items');\r\n      const icon   = header.querySelector('i');\r\n\r\n      header.classList.add('closed');\r\n      items.style.display = 'none';\r\n      icon.classList.add('omni-chevron-down');\r\n      icon.classList.remove('omni-chevron-up');\r\n\r\n      header.addEventListener('click', () => {\r\n        const hidden = items.style.display === 'none';\r\n        items.style.display = hidden ? '' : 'none';\r\n        header.classList.toggle('closed', !hidden);\r\n        icon.classList.toggle('omni-chevron-up', hidden);\r\n        icon.classList.toggle('omni-chevron-down', !hidden);\r\n      });\r\n    });\r\n\r\n    const currentSiteCode = 'OMP_SUTT';\r\n\r\n    if (currentSiteCode) {\r\n      const selectedInput = document.querySelector('input[name=\"cinema_item\"][value=\"' + currentSiteCode + '\"]');\r\n\r\n      if (selectedInput) {\r\n        const container   = selectedInput.closest('.site-selection-item');\r\n        const regionGroup = container.closest('.region-group');\r\n\r\n        if (regionGroup) {\r\n          const header = regionGroup.querySelector('.region-header');\r\n          const items  = regionGroup.querySelector('.region-items');\r\n          const icon   = header.querySelector('i');\r\n\r\n          items.style.display = '';\r\n          header.classList.remove('closed');\r\n          icon.classList.add('omni-chevron-up');\r\n          icon.classList.remove('omni-chevron-down');\r\n        }\r\n\r\n        selectedInput.checked = true;\r\n\r\n        const img = container.querySelector('.checkbox-img');\r\n        if (img) {\r\n          img.src = \"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-on.svg\";\r\n        }\r\n\r\n        footerControl.classList.remove('hidden');\r\n        container.scrollIntoView({ behavior: 'smooth', block: 'center' });\r\n      }\r\n    }\r\n\r\n        // getLatLong();\r\n      });\r\n\r\n  function siteSelectSubmit() {\r\n    document.getElementById('siteList-modal').submit();\r\n  }\r\n\r\n  function siteSelectProceed() {\r\n    document.getElementById('siteSelectButton').classList.add('disabled');\r\n    siteSelectSubmit();\r\n  }\r\n</script>  </div>\r\n</div>\r\n<!-- And here  -->\r\n\r\n<div class=\"pt-1 pb-2 relative\" style=\"overflow: visible;\">\r\n  <div style=\"\r\n    position: absolute;\r\n    top: 50%;\r\n    left: 50%;\r\n    transform: translate(-50%, -50%);\r\n    width: 100%;\r\n    height: 90%;\r\n    background: radial-gradient(\r\n      circle at center,\r\n      #ffea00 0%,\r\n      rgba(255,234,0,0.12) 35%,\r\n      rgba(255,234,0,0) 100%\r\n    );\r\n    filter: blur(30px);\r\n    -webkit-filter: blur(30px);\r\n    z-index: 0;\">\r\n  </div>\r\n  <section id=\"showcase\" class=\"main-container-s2s splide mb-mid\" style=\"position: relative;\">\r\n    <div class=\"splide__track\">\r\n      <ul class=\"splide__list\">\r\n                  <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/Star Wars The Mandalorian and Grogu Web Slider.webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">Star Wars: The Mandalorian and Grogu</h2><div class=\"showtime-details flex items-center gap-3 flex-wrap justify-start\"><a href=\"/cinema/movie/sutton/star-wars-the-mandalorian-and-grogu\" class=\"!mx-px btn-solid-yellow showtime-button\">Book now</a><span class=\"showtime-age-rating flex-shrink-0\"><img title=\"BBFC - 12A\" class=\"showtime-age-rating-img\" src=\"/images/ratings/UK_12A.png\" /></span><span class=\"showtime-genre\">Action, Adventure</span></div></div></div></div>                  <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/Backrooms Web Slider.webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">Backrooms</h2><div class=\"showtime-details flex items-center gap-3 flex-wrap justify-start\"><a href=\"/cinema/movie/sutton/backrooms\" class=\"!mx-px btn-solid-yellow showtime-button\">Book now</a><span class=\"showtime-age-rating flex-shrink-0\"><img title=\"BBFC - 15\" class=\"showtime-age-rating-img\" src=\"/images/ratings/UK_15.png\" /></span><span class=\"showtime-genre\">Horror</span></div></div></div></div>                  <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/Power Ballad Web Slider.webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">Power Ballad</h2><div class=\"showtime-details flex items-center gap-3 flex-wrap justify-start\"><a href=\"/cinema/movie/sutton/power-ballad\" class=\"!mx-px btn-solid-yellow showtime-button\">Book now</a><span class=\"showtime-age-rating flex-shrink-0\"><img title=\"BBFC - 15\" class=\"showtime-age-rating-img\" src=\"/images/ratings/UK_15.png\" /></span><span class=\"showtime-genre\">Comedy</span></div></div></div></div>                  <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/Masters of the Universe Web Slider.webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">Masters Of The Universe</h2><div class=\"showtime-details flex items-center gap-3 flex-wrap justify-start\"><a href=\"/cinema/movie/sutton/masters-of-the-universe\" class=\"!mx-px btn-solid-yellow showtime-button\">Book now</a><span class=\"showtime-age-rating flex-shrink-0\"><img title=\"BBFC - 12A\" class=\"showtime-age-rating-img\" src=\"/images/ratings/UK_12A.png\" /></span><span class=\"showtime-genre\">Action, Adventure, Fantasy, Sci-Fi</span></div></div></div></div>                  <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/The Amazing Digital Circus The Last Act Web Slider (1).webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">The Amazing Digital Circus: The Last Act</h2><div class=\"showtime-details flex items-center gap-3 flex-wrap justify-start\"><a href=\"/cinema/movie/sutton/the-amazing-digital-circus-the-last-act\" class=\"!mx-px btn-solid-yellow showtime-button\">Book now</a><span class=\"showtime-age-rating flex-shrink-0\"><img title=\"BBFC - 12A\" class=\"showtime-age-rating-img\" src=\"/images/ratings/UK_12A.png\" /></span><span class=\"showtime-genre\">Animation, Drama, Thriller</span></div></div></div></div>                  <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/The Sheep Detectives Web Slider.webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">The Sheep Detectives</h2><div class=\"showtime-details flex items-center gap-3 flex-wrap justify-start\"><a href=\"/cinema/movie/sutton/the-sheep-detectives\" class=\"!mx-px btn-solid-yellow showtime-button\">Book now</a><span class=\"showtime-age-rating flex-shrink-0\"><img title=\"BBFC - PG\" class=\"showtime-age-rating-img\" src=\"/images/ratings/UK_PG.png\" /></span><span class=\"showtime-genre\">Action, Comedy</span></div></div></div></div>                                    <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/Obsession Web Slider.webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">Obsession</h2><div class=\"showtime-details flex items-center gap-3 flex-wrap justify-start\"><a href=\"/cinema/movie/sutton/obsession\" class=\"!mx-px btn-solid-yellow showtime-button\">Book now</a><span class=\"showtime-age-rating flex-shrink-0\"><img title=\"BBFC - 18\" class=\"showtime-age-rating-img\" src=\"/images/ratings/UK_18.png\" /></span><span class=\"showtime-genre\">Horror</span></div></div></div></div>              </ul>\r\n    </div>\r\n  </section>\r\n</div>\r\n\r\n<div class=\"main-container\" style=\"background-color: transparent\">\r\n  <div id=\"showtimes_section\" class=\"w-full flex flex-col md:flex-row items-center justify-between\">\r\n    <div class=\"flex w-full\">\r\n      <div class=\"mb-mid flex items-center w-full justify-between md:justify-start\">\r\n        <!-- <h1 class=\"page-title text-white mr-4\">Now showing in</h1> -->\r\n        <div class=\"\">\r\n          <div class=\"flex items-center\"><a href=\"/cinema/site\" class=\"js-site-link\"><span class=\"menu-location pr-1 py-1 text-2xl font-semibold\">Sutton Surrey</span><i class=\"icon omni-chevron-down mx-1 text-xl cursor-pointer\"></i></a></div>        </div>\r\n        <a href=\"/company/about\" class=\" pl-3 text-ompYellow\">About this venue</a>\r\n      </div>\r\n    </div>\r\n    <div class=\"w-full lg:w-auto\">\r\n      <div class=\"flex items-center mb-mid block md:hidden\">\r\n        <p class=\"text-base\">Filter movies & events</p>\r\n        <i id=\"filterButton\" class=\"icon omni-filter mx-3 text-lg\"></i>\r\n        <i onclick=\"showSearchBox()\" id=\"showSearchBarButton\" class=\"icon omni-search mx-3 text-lg\"></i>\r\n      </div>\r\n\r\n      <div>\r\n        <div id=\"searchBoxContainer\" class=\"mb-4 pt-2 hidden md:block\">\r\n          <div class=\"flex justify-between items-center\">\r\n            <div class=\"input-search\">\r\n              <i class=\"icon omni-search\" style=\"position: static;\"></i>\r\n              <input style=\"left: 10px;\" id=\"searchBarInput\" onkeyup=\"searchForPerformance()\" placeholder=\"Movie Search\" type=\"text\" />\r\n              <div class=\"flex absolute bg-ompGray z-[40]\"><ul id=\"performanceList\"><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/star-wars-the-mandalorian-and-grogu\">Star Wars: The Mandalorian and Grogu</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/star-wars-the-mandalorian-and-grogu-3d-\">Star Wars: The Mandalorian and Grogu (3D)</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/backrooms\">Backrooms</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/power-ballad\">Power Ballad</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/michael\">Michael</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/charlie-the-wonderdog\">Charlie The Wonderdog</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/obsession\">Obsession</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-magic-faraway-tree\">The Magic Faraway Tree</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-devil-wears-prada-2\">The Devil Wears Prada 2</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-sheep-detectives\">The Sheep Detectives</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/alices-adventures-in-wonderland-live-the-royal-ballet-26-27\">Alices Adventures In Wonderland - LIVE - The Royal Ballet 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/carmen-live-the-royal-opera-26-27\">Carmen - LIVE- The Royal Opera 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/cosi-fan-tutte-live-the-royal-opera-26-27\">Cosi Fan Tutte - LIVE - The Royal Opera 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/disclosure-day\">Disclosure Day</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/gotterdammerung-live-the-royal-opera-26-27\">Gotterdammerung - LIVE - The Royal Opera 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/k-pop-demon-hunters-a-sing-along-event-\">K-Pop Demon Hunters (A Sing-Along Event)</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/la-fanciulla-del-west-the-met-opera-26-27\">La Fanciulla Del West - The Met Opera 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/les-liaisons-dangereuses-national-theatre\">Les Liaisons Dangereuses - National Theatre</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/macbeth-the-met-opera-2026-27\">Macbeth - The Met Opera 2026-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/manon-live-the-royal-ballet-26-27\">Manon - LIVE - The Royal Ballet 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/masters-of-the-universe\">Masters Of The Universe</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/minions-monsters\">Minions & Monsters</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/romeo-juliet-live-the-royal-ballet-26-27\">Romeo & Juliet - LIVE - The Royal Ballet 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/scary-movie\">Scary Movie</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/supergirl\">Supergirl</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/swan-lake-live-the-royal-ballet-26-27\">Swan Lake - LIVE - The Royal Ballet 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-amazing-digital-circus-the-last-act\">The Amazing Digital Circus: The Last Act</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-nutcracker-live-the-royal-ballet-26-27\">The Nutcracker - LIVE - The Royal Ballet 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-super-mario-galaxy-movie\">The Super Mario Galaxy Movie</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/tosca-live-the-royal-opera-26-27\">Tosca - LIVE - The Royal Opera 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/toy-story-5\">Toy Story 5</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/tuner\">Tuner</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/we-re-nothing-at-all\">We're Nothing at All</a>  </li> </ul> </div>            </div>\r\n            <i id=\"filterButton2\" class=\"icon omni-filter text-ompYellow mx-3 hidden md:block\"></i>\r\n          </div>\r\n        </div>  \r\n      </div>\r\n      <div id=\"\" class=\"\">\r\n        <div id=\"filterControlls-datescon\">\r\n           \r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n<div class=\"sticky top-0  z-[30]\">\r\n    \r\n  <div id=\"filterControlls-dates\" class=\"main-container-full bg-ompGray-dates\" style=\"padding-left: 0 !important; padding-right: 0 !important; \">\r\n    <div id=\"dateNav\" class=\"date-nav-container mb-mid md:justify-around\" style=\"\">\r\n                <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-06-04\">\r\n            <span>Today</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-06-05\">\r\n            <span>Friday</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-06-06\">\r\n            <span>Saturday</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-06-07\">\r\n            <span>Sunday</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-06-08\">\r\n            <span>Monday</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-06-09\">\r\n            <span>Tuesday</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-06-10\">\r\n            <span>Wednesday</span>\r\n          </button>\r\n                <button type=\"button\" class=\"date-nav-item active\" data-date=\"calendar\" onclick=\"showDateCalendar(); return false;\">\r\n          <span>\r\n            9th Jul          </span>\r\n        </button>\r\n    </div>\r\n\r\n\r\n\r\n    <!-- <section id=\"dates\" class=\"splide mb-mid py-4 bg-ompGray-slider px-2\">\r\n      <div class=\"splide__track\">\r\n        <ul class=\"splide__list\">\r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"0\" onClick=\"updateSearch('DATE', '2026-06-04');refreshSearch();\">Today</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"1\" onClick=\"updateSearch('DATE', '2026-06-05');refreshSearch();\">Friday</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"2\" onClick=\"updateSearch('DATE', '2026-06-06');refreshSearch();\">Saturday</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"3\" onClick=\"updateSearch('DATE', '2026-06-07');refreshSearch();\">Sunday</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"4\" onClick=\"updateSearch('DATE', '2026-06-08');refreshSearch();\">Monday</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"5\" onClick=\"updateSearch('DATE', '2026-06-09');refreshSearch();\">Tuesday</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"6\" onClick=\"updateSearch('DATE', '2026-06-10');refreshSearch();\">Wednesday</a>\r\n            </li> \r\n                    \r\n          <li class=\"splide__slide date-item active\" ><a data-target=\"6\" href=\"#\" onClick=\"showDateCalendar(); return false;\">9th Jul</a></li>\r\n        </ul>\r\n      </div>\r\n    </section> -->\r\n  </div>\r\n\r\n  <div id=\"calendarModal\" class=\"hidden\">\r\n    <div class=\"fixed top-0 left-0 inset-0 bg-black/70 backdrop-blur-sm z-[170]\"></div>\r\n    <div class=\"fixed inset-0 flex justify-center items-center z-[180]\">\r\n      <div class=\"rounded-lg shadow-lg p-6 relative\">\r\n        <input type=\"text\" id=\"calendarPicker\" placeholder=\"Select a date\"\r\n              class=\"hidden w-full border border-gray-300 rounded p-2\" />\r\n        <button class=\"btn-solid-yellow mt-4\" onclick=\"closeCalendarModal()\">Close</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <script src=\"/public/js/flatpickr/flatpickr.min.js\"></script>\r\n  <script>\r\n    // Assume allowedDates is provided by PHP as an array of UNIX timestamps\r\n    var defaultDate = \"2026-07-09\";\r\n    const allowedDatesTimestamps = [1780527600000,1780614000000,1780700400000,1780786800000,1780873200000,1780959600000,1781046000000,1781132400000,1805760000000,1794268800000,1803340800000,1781218800000,1781305200000,1781391600000,1781478000000,1781564400000,1781650800000,1781737200000,1801612800000,1800921600000,1782342000000,1782601200000,1792450800000,1793059200000,1782860400000,1782946800000,1783033200000,1783119600000,1783206000000,1783292400000,1783378800000,1783465200000,1783551600000,1811199600000,1782428400000,1782514800000,1782687600000,1782774000000,1808348400000,1796083200000,1809471600000,1781823600000,1781910000000,1781996400000,1782082800000,1782169200000,1782255600000];\r\n    const allowedDates = allowedDatesTimestamps.map(ts => new Date(ts));\r\n    console.log('DateSelector::AllowedDateCount:47');\r\n    console.log('DateSelector::CalendarEventCount:33');\r\n    console.log('DateSelector::AllowedDates:' + allowedDatesTimestamps);\r\n    console.log('DateSelector::DfltDate:' + defaultDate);\r\n    console.log('DateSelector::FilterEventCode: ');    \r\n    \r\n    if (defaultDate == 0) {\r\n      defaultDate = '';\r\n    }\r\n\r\n    flatpickr(\"#calendarPicker\", {\r\n      inline: true,\r\n      enable: allowedDates,\r\n      dateFormat: \"Y-m-d\",\r\n      defaultDate: defaultDate,\r\n      onChange: function(selectedDates, dateStr, instance) {\r\n        console.log(\"Selected date:\", dateStr);\r\n        calendarDateChange(dateStr);\r\n        // Optionally, automatically close the modal after selection:\r\n        // closeCalendarModal();\r\n      }\r\n    });\r\n    \r\n  </script>\r\n\r\n  <script> \r\n    var slideIndex = 6;\r\n    console.log(slideIndex);\r\n    \r\n    // document.addEventListener('DOMContentLoaded', function() {\r\n    //   var dates = new Splide('#dates', {\r\n    //     type: 'slide',\r\n    //     perPage: 6, // Default: Fully show only 3 slides at a time\r\n    //     perMove: 1, // Move one slide at a time\r\n    //     gap: '5px', // Space between slides\r\n    //     arrows: false, // Hide arrows\r\n    //     pagination: false, // Hide pagination\r\n    //     trimSpace: false, // Prevents unwanted cropping\r\n    //     autoHeight: true, // Adjusts height to content dynamically\r\n    //     rewind: false, // Prevents bouncing back to the first slide\r\n    //     snap: true, // Forces snap to the closest slide\r\n    //     drag: true, // Prevents flick scrolling through multiple items quickly\r\n    //     wheel: false, // Disables fast scrolling with mouse wheel\r\n    //     //focus: 'center',\r\n    //     breakpoints: {\r\n    //       1200: {\r\n    //         perPage: 6\r\n    //       }, // Show 5 slides on larger screens\r\n    //       900: {\r\n    //         perPage: 4\r\n    //       }, // Show 4 slides on medium screens\r\n    //       600: {\r\n    //         perPage: 3\r\n    //       }, // Default: 3 slides on smaller screens\r\n    //     },\r\n    //   });\r\n    \r\n    //   dates.on('mounted', function () {\r\n    //     // Wait for a short timeout to let layout settle\r\n    //     setTimeout(() => {\r\n    //       dates.go(slideIndex);\r\n    //     }, 0); // You can try increasing this to 50–100ms if needed\r\n    //   });\r\n    \r\n    //   // dates.mount();\r\n      \r\n    //   // Log current index on load\r\n    //   console.log('Starting slide index:', dates.index);\r\n    //   console.log('Starting slide selected:', slideIndex);\r\n    \r\n    //   // Log index whenever slide moves\r\n    //   dates.on('moved', function (newIndex) {\r\n    //     console.log('Now showing slide index:', newIndex);\r\n    //   });\r\n    \r\n    //   // Log all slide elements with their indexes\r\n    //   var slides = dates.Components.Slides.get();\r\n    //   slides.forEach((slideObj, index) => {\r\n    //     console.log(`Slide ${index}:`, slideObj.slide.textContent.trim());\r\n    //   });\r\n    // });\r\n    document.addEventListener(\"DOMContentLoaded\", function() {\r\n      const searchBar = document.querySelector(\"#filterControlls-search\");\r\n      const filterControls = document.querySelector(\"#filterControlls\");\r\n      var scrollPos = 0;\r\n      window.addEventListener(\"scroll\", function() {\r\n        let scrollTop = window.scrollY || document.documentElement.scrollTop;\r\n        // let filterTop = filterControls.getBoundingClientRect().top;\r\n        \r\n        if (searchBar != null) {\r\n          // searchBar.classList.remove(\"hidden\");\r\n          // if (filterTop <= 35) {\r\n          //   // searchBar.classList.add(\"hidden\");\r\n          // }\r\n        }\r\n      });\r\n    });\r\n\r\n    document.addEventListener('DOMContentLoaded', () => {\r\n  const nav      = document.getElementById('dateNav');\r\n  if (!nav) return;\r\n\r\n  const items    = Array.from(nav.querySelectorAll('.date-nav-item'));\r\n  const sections = items.map(btn =>\r\n    document.querySelector(`[data-date-section=\"${btn.dataset.date}\"]`)\r\n  );\r\n\r\n  // Flag to ignore clicks that were actually drags\r\n  let suppressNavClick = false;\r\n\r\n  function setActive(idx) {\r\n    items.forEach((b,i) => b.classList.toggle('active', i === idx));\r\n  }\r\n\r\n  function centerNavItem(btn) {\r\n    const navRect = nav.getBoundingClientRect();\r\n    const btnRect = btn.getBoundingClientRect();\r\n    const offset  = btnRect.left\r\n                  - navRect.left\r\n                  - (navRect.width / 2)\r\n                  + (btnRect.width / 2);\r\n    nav.scrollBy({ left: offset, behavior: 'smooth' });\r\n  }\r\n\r\n  items.forEach((btn, idx) => {\r\n    btn.addEventListener('click', () => {\r\n      if (suppressNavClick) return;\r\n\r\n      if (btn.dataset.date === 'calendar') {\r\n        showDateCalendar();\r\n        return;\r\n      }\r\n\r\n      sections[idx]?.scrollIntoView({ behavior: 'smooth', block: 'start' });\r\n\r\n      // highlight + center in the nav\r\n      setActive(idx);\r\n      centerNavItem(btn);\r\n\r\n      // run your filters\r\n      updateSearch('DATE', btn.dataset.date);\r\n      refreshSearch();\r\n    });\r\n  });\r\n\r\n  const observer = new IntersectionObserver((entries) => {\r\n    entries.forEach(ent => {\r\n      if (ent.isIntersecting) {\r\n        const idx = sections.findIndex(sec => sec === ent.target);\r\n        if (idx >= 0) {\r\n          setActive(idx);\r\n          centerNavItem(items[idx]);\r\n        }\r\n      }\r\n    });\r\n  }, {\r\n    rootMargin: '-30% 0px -70% 0px',\r\n    threshold: 0\r\n  });\r\n\r\n  sections.forEach(sec => sec && observer.observe(sec));\r\n\r\n  const initialIdx = items.findIndex(b => b.classList.contains('active'));\r\n  if (initialIdx >= 0) centerNavItem(items[initialIdx]);\r\n\r\n  // --- drag-to-scroll (mouse + touch) that DOESN'T break clicks ---\r\n  (function enableDragScroll(container) {\r\n    let isDown = false;\r\n    let startX = 0;\r\n    let startScrollLeft = 0;\r\n    let dragging = false;\r\n\r\n    const DRAG_THRESHOLD = 10; // px\r\n\r\n    container.style.cursor = 'grab';\r\n\r\n    container.addEventListener('pointerdown', (e) => {\r\n      if (e.pointerType === 'mouse' && e.button !== 0) return;\r\n\r\n      isDown = true;\r\n      dragging = false;\r\n      startX = e.clientX;\r\n      startScrollLeft = container.scrollLeft;\r\n\r\n      container.style.cursor = 'grabbing';\r\n    });\r\n\r\n    container.addEventListener('pointermove', (e) => {\r\n      if (!isDown) return;\r\n\r\n      const dx = e.clientX - startX;\r\n\r\n      if (!dragging && Math.abs(dx) > DRAG_THRESHOLD) {\r\n        dragging = true;\r\n      }\r\n\r\n      if (dragging) {\r\n        if (e.cancelable) e.preventDefault();\r\n        container.scrollLeft = startScrollLeft - dx;\r\n      }\r\n    }, { passive: false });\r\n\r\n    container.addEventListener('pointerup', () => {\r\n      isDown = false;\r\n      container.style.cursor = 'grab';\r\n\r\n      if (dragging) {\r\n        suppressNavClick = true;\r\n        setTimeout(() => { suppressNavClick = false; }, 0);\r\n      }\r\n    });\r\n\r\n    container.addEventListener('pointercancel', () => {\r\n      isDown = false;\r\n      container.style.cursor = 'grab';\r\n    });\r\n  })(nav);\r\n});\r\n\r\n  </script>  </div>\r\n<div class=\"main-container flex items-center text-sm space-x-2 mb-4 text-white/40\">\r\n  <p class=\"inline-flex text-xs items-center justify-center w-4 h-4 bg-white/40 text-black rounded-full\">\r\n    &pound;  </p>\r\n  <p>Booking online is &pound;1.00 cheaper</p>\r\n</div>\r\n</div>\r\n\r\n<div id=\"youtubeEmbed\" class=\"overflow-hidden hidden\">\r\n  <div class=\"fixed inset-0 flex items-center justify-center z-50\">\r\n    <div id=\"backgroundOverlay\" class=\"absolute inset-0 bg-black/70 backdrop-blur-sm pointer-events-none\"></div>\r\n    <div class=\"relative p-6 rounded shadow-lg z-10\">\r\n      <div id=\"youtubeIframe\" class=\"mb-2\">\r\n      </div>\r\n      <div class=\"\">\r\n        <button onclick=\"closeYoutubeVideo()\" class=\"btn-solid-yellow w-full\" onClick=\"closeRemoveFavouriteModal();return false;\">Close</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div> \r\n\r\n<div class=\"main-container grid grid-cols-1 gap-6\">\r\n  <!-- main grid  -->\r\n  <div class=\"grid grid-cols-1 md:grid-cols-6 lg:grid-cols-7 xl:grid-cols-10  bg-ompYellow-light/5 shadow-lg backdrop-blur-sm p-4 rounded-lg gap-4 xl:gap-8\">\r\n    <div class=\"hidden md:block col-span-1 md:col-span-1 lg:col-span-2 xl:col-span-2\">\r\n    <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n      <img\r\n        src=\"/filmimages/small/109933.jpg?v=1555859777\"\r\n        alt=\"Minions & Monsters Event poster\"\r\n        class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n        data-eventCode=\"109933\"\r\n        data-eventCode=\"Minions & Monsters\"\r\n      />\r\n              <img\r\n          onclick=\"playYoutubeVideo('ZSdOwt-G49w')\"\r\n          src=\"/public/assets/svgs/play-circle.svg\"\r\n          alt=\"Play Trailler\"\r\n          class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n        />\r\n          </div>\r\n  </div>\r\n  <div class=\"md:col-span-5 lg:col-span-5 xl:col-span-8\">\r\n    <div class=\"grid grid-cols-3 md:grid-cols-5 gap-4 items-start\">\r\n      <!-- A (Mobile) -->\r\n      <div class=\"md:hidden col-span-1\">\r\n        <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n          <img\r\n            src=\"/filmimages/small/109933.jpg?v=1555859777\"\r\n            alt=\"Minions & Monsters Event poster\"\r\n            class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n            data-eventCode=\"109933\"\r\n            data-eventCode=\"Minions & Monsters\"\r\n          />\r\n                      <img\r\n              onclick=\"playYoutubeVideo('ZSdOwt-G49w')\"\r\n              src=\"/public/assets/svgs/play-circle.svg\"\r\n              alt=\"Play Trailler\"\r\n              class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n            />\r\n                  </div>\r\n      </div>\r\n      <!-- B -->\r\n      <div class=\"col-span-2 md:col-span-5\">\r\n        <div class=\"w-full\">\r\n          <div class=\"flex justify-between items-start w-full mb-2\">\r\n            <p class=\"font-medium text-lg sm:text-2xl md:text-3xl leading-snug sm:leading-tight md:leading-tight mr-4\">\r\n              <a href=\"/cinema/movie/sutton/minions-monsters\">\r\n                Minions & Monsters              </a>\r\n            </p>\r\n            <img data-toggle=\"0\" id=\"favourite109933\" onClick=\"toggleFavourite('109933');return false;\" src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_favourited-off.svg\" class=\"w-4 mt-2 mx-3\" alt=\"Add to Favourites\" />  \r\n          </div>\r\n          <div class=\"flex items-center gap-2 mb-2\">\r\n            <div class=\"flex flex-col md:flex-row gap-4\">\r\n              <div class=\"flex items-center gap-2\">\r\n                <img src=\"/images/ratings/UK_TBC.png\" class=\"w-4\" />\r\n                <p class=\"text-base leading-snug font-normal leading-none\">Animation</p>\r\n              </div>\r\n              <p class=\"mb-2 md:m-auto flex item-center\"><span class=\"hidden md:flex mr-2\">|</span> 1hr 25min </p>\r\n            </div>\r\n          </div>\r\n          \r\n            <p class=\"hidden md:block mb-2 pt-2\">\r\n              <span class=\"synopsis-short\">\r\n                This time the Minions stumble into a mysterious world of creatures and monsters that pushes their chaotic curiosity to the absolute limit. Packed with the franchise?s trademark slapstick comedy, colourful animation and relentless visual gags, Minions...              </span>\r\n\r\n                              <span class=\"synopsis-full hidden text-base\">\r\n                  This time the Minions stumble into a mysterious world of creatures and monsters that pushes their chaotic curiosity to the absolute limit. Packed with the franchise?s trademark slapstick comedy, colourful animation and relentless visual gags, Minions &amp; Monsters expands the universe with new characters, new villains and even bigger set-pieces. Since their introduction the Minions have become a true global phenomenon?spawning theme-park attractions, viral memes and billions of views online?thanks to their lovable stupidity and unstoppable enthusiasm for mayhem. With its combination of fast-paced comedy and family-friendly adventure, Minions &amp; Monsters promises another wildly entertaining chapter for the most unpredictable characters in modern animation.                </span>\r\n\r\n                <button \r\n                  type=\"button\"\r\n                  class=\"ml-2 text-ompYellow underline text-base\"\r\n                  onclick=\"toggleSynopsis(this)\"\r\n                >\r\n                  See more\r\n                </button>\r\n                          </p>\r\n          <div class=\"hallTypeIcon hidden\">\r\n                                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_maxx.svg\" class=\"h-4 w-auto my-2\" alt=\"Event Type Icon\" />\r\n                                                </div>\r\n        </div>\r\n      </div>\r\n      <!-- C -->\r\n      <div class=\"col-span-3 md:col-span-5 md:col-start-1\">\r\n        <div class=\"w-full grid grid-cols-1 md:grid-cols-2 sm:col-span-2 xl:grid-cols-3  gap-2\">\r\n          <a aria-label=\"Minions & Monsters at 11:20 in Screen 8\" href=\"https://www.omniplexcinemas.co.uk/booking/seats/sutton/43015\" class=\"\"> \r\n<div id=\"perf_0\" class=\"showTimeBox bg-ompGray-times p-2 col-span-1 rounded-xl\">\r\n  <div class=\"topSection flex justify-between items-end\">\r\n    <div class=\"flex items-end\">\r\n      <div class=\"flex items-baseline\">\r\n        <h4 class=\"bigText mr-1 leading-none\" aria-label=\"Minions & Monsters at 11:20 in Screen 8\">\r\n          11:20        </h4>\r\n        <p class=\"smallText leading-none\" aria-label=\"Minions & Monsters starts at 11:20 and ends at 12:45\">\r\n          - 12:45        </p>\r\n      </div>\r\n    </div>\r\n    <div class=\"flex items-end\">\r\n              <div class=\"flex items-baseline\">\r\n          <p class=\"smallText mr-1 leading-none\" aria-label=\"Cost starting from &pound;8.95\">\r\n            From\r\n          </p>\r\n          <h4 class=\"bigText leading-none\" aria-label=\"Cost starting from &pound;8.95\">\r\n            &pound;8.95          </h4>\r\n        </div>\r\n          </div>\r\n  </div>\r\n  <div class=\"midSection flex justify-between items-baseline\">\r\n\r\n    <div class=\"mb-2\"></div>\r\n  </div>\r\n  <div class=\"bottomSection flex justify-between items-baseline\">\r\n    <div class=\"flex items-baseline w-auto\">\r\n      <div class=\"flex items-start w-auto\">\r\n        <p class=\"smallText\">Screen 8</p>\r\n      </div> \r\n    </div>\r\n    <div class=\"flex items-baseline w-auto space-x-2\">\r\n                        <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_maxx.svg\" class=\"h-[17px] w-auto\" alt=\"Ha