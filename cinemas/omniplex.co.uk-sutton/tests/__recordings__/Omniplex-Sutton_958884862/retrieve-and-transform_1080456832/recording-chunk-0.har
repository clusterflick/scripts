ance()\" placeholder=\"Movie Search\" type=\"text\" />\r\n              <div class=\"flex absolute bg-ompGray z-[40]\"><ul id=\"performanceList\"><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/star-wars-the-mandalorian-and-grogu\">Star Wars: The Mandalorian and Grogu</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/star-wars-the-mandalorian-and-grogu-3d-\">Star Wars: The Mandalorian and Grogu (3D)</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/backrooms\">Backrooms</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/power-ballad\">Power Ballad</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/michael\">Michael</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/charlie-the-wonderdog\">Charlie The Wonderdog</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/obsession\">Obsession</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-magic-faraway-tree\">The Magic Faraway Tree</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-devil-wears-prada-2\">The Devil Wears Prada 2</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-sheep-detectives\">The Sheep Detectives</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/alices-adventures-in-wonderland-live-the-royal-ballet-26-27\">Alices Adventures In Wonderland - LIVE - The Royal Ballet 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/carmen-live-the-royal-opera-26-27\">Carmen - LIVE- The Royal Opera 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/cosi-fan-tutte-live-the-royal-op