ion flex justify-between items-baseline\">\r\n    <div class=\"flex items-baseline w-auto\">\r\n      <div class=\"flex items-start w-auto\">\r\n        <p class=\"smallText\">Screen 1</p>\r\n      </div> \r\n    </div>\r\n    <div class=\"flex items-baseline w-auto space-x-2\">\r\n        \r\n    \r\n\r\n</div>\r\n  </div>\r\n</div>\r\n</a>          </div>    \r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"main-container my-mid block md:hidden\">\r\n  <button id=\"aboutToggle\" class=\"flex items-center text-ompYellow font-semibold w-full text-left\">\r\n    <p class=\"\">Sutton Surrey Omniplex</p>\r\n    <i id=\"aboutIcon\" class=\"icon omni-chevron-up pl-4\"></i>\r\n  </button>\r\n  <div id=\"aboutSiteSection\" class=\"mt-4 hidden\">\r\n    <div>\r\n      Omniplex Cinema Sutton is a 12-screen cinema in Sutton, surrounded by a great selection of local restaurants, shops and facilities. Check out all of the latest movies and classic re-releases in this modern multiplex. It is the perfect place for lovers of the big screen. \r\n\r\nWhat to expect at Omniplex Cinema Sutton:\r\n\r\nAt Omniplex Cinema Sutton, watch your new favourite movies on our cutting-edge OmniplexMAXX screen. This cinema also features Recline seats, Sofa seats 3D performances, assigned seating and wheelchair-accessibility. Before heading into the screen, stock up on fresh popcorn made on-site, as well as nachos,hotdogs, sweets and soft drinks. We offer free parking for up to 3 hours! Simply ask our cinema staff to stamp your parking ticket.    </div>\r\n  </div>\r\n  <div class=\"mt-4\">\r\n      </div>\r\n</div>\r\n\r\n<script>\r\n  document.addEventListener('DOMContentLoaded', function () {\r\n    const toggle = document.getElementById('aboutToggle');\r\n    const section = document.getElementById('aboutSiteSection');\r\n    const icon = document.getElementById('aboutIcon');\r\n    toggle.addEventListener('click', function () {\r\n      section.classList.toggle('hidden');\r\n      icon.classList.toggle('omni-chevron-down');\r\n      icon.classList.toggle('omni-chevron-up');\r\n    });\r\n  });\r\n\r\nfunction clearFIlters(){\r\n  const clearFiltersButton = document.getElementById('clearFilters');\r\n  clearFiltersButton.click();\r\n}\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n  var showcase = new Splide('#showcase', {\r\n    type: 'loop',\r\n    perPage: 1.2,\r\n    loop: true,\r\n    gap: '20px',\r\n    focus: 'center',\r\n    arrows: false,\r\n    pagination: false,\r\n    trimSpace: false,\r\n    autoHeight: true,\r\n    clones: 2,\r\n    // Auto scroll\r\n    autoplay: true,\r\n    interval: 5000,\r\n    pauseOnHover: true,\r\n    pauseOnFocus: true,\r\n  });\r\n  showcase.mount();\r\n});\r\n\r\nfunction toggleSynopsis(btn) {\r\n  const container = btn.parentElement;\r\n  const shortText = container.querySelector('.synopsis-short');\r\n  const fullText = container.querySelector('.synopsis-full');\r\n\r\n  const isHidden = fullText.classList.contains('hidden');\r\n\r\n  if (isHidden) {\r\n    shortText.classList.add('hidden');\r\n    fullText.classList.remove('hidden');\r\n    btn.textContent = 'See less';\r\n  } else {\r\n    shortText.classList.remove('hidden');\r\n    fullText.classList.add('hidden');\r\n    btn.textContent = 'See more';\r\n  }\r\n}\r\n\r\nfunction showSearchBox(){\r\n  const searchBoxContainer =  document.getElementById('searchBoxContainer');\r\n\r\n  searchBoxContainer.classList.toggle('hidden');\r\n}\r\n</script>\r\n\r\n\r\n    <div class=\"main-container my-big \">\r\n              <div class=\"grid grid-cols-6 gap-6\">\r\n                      \r\n            <div class=\"col-span-6 md:col-span-2 rounded-xl overflow-hidden bg-black\">\r\n              <div\r\n                class=\"h-[300px] flex flex-col justify-end p-6 bg-cover bg-center\"\r\n                style=\"background-image: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.2)), url('/cms/footerads/opass.png'); background-position: right top;\"\r\n              >\r\n                                  <h3 class=\"text-xl font-semibold mb-2 text-white\">\r\n                    Get a ticket to every movie at Omniplex with a monthly 'MyOmniPass' subscription.                  </h3>\r\n                \r\n                                  <p class=\"text-sm mb-4 text-white\">\r\n                    Terms &amp; Exclusions Apply                  </p>\r\n                \r\n                                  <a\r\n                    href=\"/join/landing\"\r\n                    class=\"text-center font-semibold bg-white/20 hover:bg-white/30 transition px-4 py-2 rounded-md text-sm w-full text-white\"\r\n                  >\r\n                    Find out more                  </a>\r\n                              </div>\r\n            </div>\r\n                      \r\n            <div class=\"col-span-6 md:col-span-2 rounded-xl overflow-hidden bg-black\">\r\n              <div\r\n                class=\"h-[300px] flex flex-col justify-end p-6 bg-cover bg-center\"\r\n                style=\"background-image: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.2)), url('/cms/footerads/gcard.png'); background-position: right top;\"\r\n              >\r\n                                  <h3 class=\"text-xl font-semibold mb-2 text-white\">\r\n                    For the superhero in your life...                  </h3>\r\n                \r\n                                  <p class=\"text-sm mb-4 text-white\">\r\n                    Get them an Omniplex Gift Card                  </p>\r\n                \r\n                                  <a\r\n                    href=\"/giftcards/choose\"\r\n                    class=\"text-center font-semibold bg-white/20 hover:bg-white/30 transition px-4 py-2 rounded-md text-sm w-full text-white\"\r\n                  >\r\n                    Get a Gift Card                  </a>\r\n                              </div>\r\n            </div>\r\n                      \r\n            <div class=\"col-span-6 md:col-span-2 rounded-xl overflow-hidden bg-black\">\r\n              <div\r\n                class=\"h-[300px] flex flex-col justify-end p-6 bg-cover bg-center\"\r\n                style=\"background-image: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.2)), url('/cms/footerads/kids.png'); background-position: right top;\"\r\n              >\r\n                                  <h3 class=\"text-xl font-semibold mb-2 text-white\">\r\n                    Perfect for a day out with the kids                  </h3>\r\n                \r\n                                  <p class=\"text-sm mb-4 text-white\">\r\n                    Best movies and treats for all                  </p>\r\n                \r\n                                  <a\r\n                    href=\"/cinema/kids\"\r\n                    class=\"text-center font-semibold bg-white/20 hover:bg-white/30 transition px-4 py-2 rounded-md text-sm w-full text-white\"\r\n                  >\r\n                     See our Kids offerings                  </a>\r\n                              </div>\r\n            </div>\r\n                  </div>\r\n          </div>\r\n       \r\n<div id=\"footerContact\" class=\"bg-[#282828] mt-8\">\r\n  <div class=\"w-full text-center py-8\">\r\n    <h4 class=\"text-ompYellow text-2xl font-bold\">Need help?</h4>\r\n    <p class=\"\">Get in touch with your local cinema now:</p>\r\n    <div class=\"input-container mb-4 main-container mt-4\">\r\n      <div class=\"input-select mx-auto w-full md:w-2/3 lg:w-1/2\">\r\n        <select id=\"conactlocalCinema\" name=\"sitecode\" class=\"select-input\">\r\n          <option value=\"\" disabled selected>Choose Cinema</option>\r\n          <optgroup style=\"font-weight:900;font-size:13px;\" label=\"England\"><option value=\"OMP_BIRM\" id=\"birmingham-great-park\" data-thissite=\"OMP_BIRM\" data-sitecode=\"OMP_SUTT\">&nbsp;Birmingham - Great Park</option>\r\n<option value=\"OMP_HIWY\" id=\"high-wycombe\" data-thissite=\"OMP_HIWY\" data-sitecode=\"OMP_SUTT\">&nbsp;High Wycombe</option>\r\n<option value=\"OMP_IPSW\" id=\"ipswich\" data-thissite=\"OMP_IPSW\" data-sitecode=\"OMP_SUTT\">&nbsp;Ipswich</option>\r\n<option value=\"OMP_SUND\" id=\"sunderland\" data-thissite=\"OMP_SUND\" data-sitecode=\"OMP_SUTT\">&nbsp;Sunderland</option>\r\n<option selected=\"selected\" value=\"OMP_SUTT\" id=\"sutton\" data-thissite=\"OMP_SUTT\" data-sitecode=\"OMP_SUTT\">&nbsp;Sutton Surrey</option>\r\n<option value=\"OMP_WIGA\" id=\"wigan\" data-thissite=\"OMP_WIGA\" data-sitecode=\"OMP_SUTT\">&nbsp;Wigan</option>\r\n</optgroup><optgroup style=\"font-weight:900;font-size:13px;\" label=\"Scotland\"><option value=\"OMP_CLYD\" id=\"glasgow-clydebank\" data-thissite=\"OMP_CLYD\" data-sitecode=\"OMP_SUTT\">&nbsp;Clydebank</option>\r\n<option value=\"OMP_GLAS\" id=\"glasgow-renfrew-street\" data-thissite=\"OMP_GLAS\" data-sitecode=\"OMP_SUTT\">&nbsp;Glasgow - Renfrew Street</option>\r\n</optgroup><optgroup style=\"font-weight:900;font-size:13px;\" label=\"Northern Ireland\"><option value=\"OMP_ANTR\" id=\"antrim\" data-thissite=\"OMP_ANTR\" data-sitecode=\"OMP_SUTT\">&nbsp;Antrim</option>\r\n<option value=\"OMP_BANB\" id=\"banbridge\" data-thissite=\"OMP_BANB\" data-sitecode=\"OMP_SUTT\">&nbsp;Banbridge</option>\r\n<option value=\"OMP_BANG\" id=\"bangor\" data-thissite=\"OMP_BANG\" data-sitecode=\"OMP_SUTT\">&nbsp;Bangor</option>\r\n<option value=\"OMP_DUDO\" id=\"belfast\" data-thissite=\"OMP_DUDO\" data-sitecode=\"OMP_SUTT\">&nbsp;Belfast - Dundonald</option>\r\n<option value=\"OMP_KENN\" id=\"kennedy-centre\" data-thissite=\"OMP_KENN\" data-sitecode=\"OMP_SUTT\">&nbsp;Belfast - Kennedy Centre</option>\r\n<option value=\"OMP_CARR\" id=\"carrickfergus\" data-thissite=\"OMP_CARR\" data-sitecode=\"OMP_SUTT\">&nbsp;Carrickfergus</option>\r\n<option value=\"OMP_CRAI\" id=\"craigavon\" data-thissite=\"OMP_CRAI\" data-sitecode=\"OMP_SUTT\">&nbsp;Craigavon</option>\r\n<option value=\"OMP_DERR\" id=\"derry\" data-thissite=\"OMP_DERR\" data-sitecode=\"OMP_SUTT\">&nbsp;Derry</option>\r\n<option value=\"OMP_DOWN\" id=\"downpatrick\" data-thissite=\"OMP_DOWN\" data-sitecode=\"OMP_SUTT\">&nbsp;Downpatrick</option>\r\n<option value=\"OMP_DUGA\" id=\"dungannon\" data-thissite=\"OMP_DUGA\" data-sitecode=\"OMP_SUTT\">&nbsp;Dungannon</option>\r\n<option value=\"OMP_LARN\" id=\"larne\" data-thissite=\"OMP_LARN\" data-sitecode=\"OMP_SUTT\">&nbsp;Larne</option>\r\n<option value=\"OMP_LISB\" id=\"lisburn\" data-thissite=\"OMP_LISB\" data-sitecode=\"OMP_SUTT\">&nbsp;Lisburn</option>\r\n<option value=\"OMP_NEWR\" id=\"newry\" data-thissite=\"OMP_NEWR\" data-sitecode=\"OMP_SUTT\">&nbsp;Newry</option>\r\n<option value=\"OMP_OMAG\" id=\"omagh\" data-thissite=\"OMP_OMAG\" data-sitecode=\"OMP_SUTT\">&nbsp;Omagh</option>\r\n</optgroup><optgroup style=\"font-weight:900;font-size:13px;\" label=\"Rep. of Ireland\"><option value=\"OMP_ARKL\" id=\"arklow\" data-thissite=\"OMP_ARKL\" data-sitecode=\"OMP_SUTT\">&nbsp;Arklow</option>\r\n<option value=\"OMP_BALL\" id=\"ballinasloe\" data-thissite=\"OMP_BALL\" data-sitecode=\"OMP_SUTT\">&nbsp;Ballinasloe</option>\r\n<option value=\"OMP_CARL\" id=\"carlow\" data-thissite=\"OMP_CARL\" data-sitecode=\"OMP_SUTT\">&nbsp;Carlow</option>\r\n<option value=\"OMP_MAHO\" id=\"cork\" data-thissite=\"OMP_MAHO\" data-sitecode=\"OMP_SUTT\">&nbsp;Cork</option>\r\n<option value=\"OMP_SCOT\" id=\"drogheda-scotch-hall\" data-thissite=\"OMP_SCOT\" data-sitecode=\"OMP_SUTT\">&nbsp;Drogheda - Scotch Hall</option>\r\n<option value=\"OMP_BALB\" id=\"balbriggan\" data-thissite=\"OMP_BALB\" data-sitecode=\"OMP_SUTT\">&nbsp;Dublin - Balbriggan</option>\r\n<option value=\"OMP_NUTG\" id=\"nutgrove\" data-thissite=\"OMP_NUTG\" data-sitecode=\"OMP_SUTT\">&nbsp;Dublin - Nutgrove</option>\r\n<option value=\"OMP_RATH\" id=\"dublin-rathmines\" data-thissite=\"OMP_RATH\" data-sitecode=\"OMP_SUTT\">&nbsp;Dublin - Rathmines</option>\r\n<option value=\"OMP_DUND\" id=\"dundalk\" data-thissite=\"OMP_DUND\" data-sitecode=\"OMP_SUTT\">&nbsp;Dundalk</option>\r\n<option value=\"OMP_GALW\" id=\"galway\" data-thissite=\"OMP_GALW\" data-sitecode=\"OMP_SUTT\">&nbsp;Galway - Salthill</option>\r\n<option value=\"OMP_KILL\" id=\"killarney\" data-thissite=\"OMP_KILL\" data-sitecode=\"OMP_SUTT\">&nbsp;Killarney</option>\r\n<option value=\"OMP_LIME\" id=\"limerick\" data-thissite=\"OMP_LIME\" data-sitecode=\"OMP_SUTT\">&nbsp;Limerick</option>\r\n<option value=\"OMP_LONG\" id=\"longford\" data-thissite=\"OMP_LONG\" data-sitecode=\"OMP_SUTT\">&nbsp;Longford</option>\r\n<option value=\"OMP_MONA\" id=\"monaghan\" data-thissite=\"OMP_MONA\" data-sitecode=\"OMP_SUTT\">&nbsp;Monaghan</option>\r\n<option value=\"OMP_MULL\" id=\"mullingar\" data-thissite=\"OMP_MULL\" data-sitecode=\"OMP_SUTT\">&nbsp;Mullingar</option>\r\n<option value=\"OMP_NENA\" id=\"nenagh\" data-thissite=\"OMP_NENA\" data-sitecode=\"OMP_SUTT\">&nbsp;Nenagh</option>\r\n<option value=\"OMP_ROSC\" id=\"roscommon\" data-thissite=\"OMP_ROSC\" data-sitecode=\"OMP_SUTT\">&nbsp;Roscommon</option>\r\n<option value=\"OMP_SHAN\" id=\"shannon\" data-thissite=\"OMP_SHAN\" data-sitecode=\"OMP_SUTT\">&nbsp;Shannon</option>\r\n<option value=\"OMP_SLIG\" id=\"sligo\" data-thissite=\"OMP_SLIG\" data-sitecode=\"OMP_SUTT\">&nbsp;Sligo</option>\r\n<option value=\"OMP_TRAL\" id=\"tralee\" data-thissite=\"OMP_TRAL\" data-sitecode=\"OMP_SUTT\">&nbsp;Tralee</option>\r\n<option value=\"OMP_WATE\" id=\"waterford\" data-thissite=\"OMP_WATE\" data-sitecode=\"OMP_SUTT\">&nbsp;Waterford</option>\r\n<option value=\"OMP_WEXF\" id=\"wexford\" data-thissite=\"OMP_WEXF\" data-sitecode=\"OMP_SUTT\">&nbsp;Wexford</option>\r\n</optgroup> \r\n        </select>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n<div id=\"footerNav\" class=\"bg-[#191919] py-mid\">\r\n  <div id=\"footerContainer\" class=\"main-container py-8 px-4\">\r\n    <footer class=\"grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-16 text-left md:text-center text-white\">\r\n              <div id=\"footerColumn1\" class=\"space-y-8\">\r\n                      <div>\r\n                              <h4 class=\"mb-1 font-semibold text-white\">\r\n                  Contact Us                </h4>\r\n              \r\n              <ul class=\"space-y-1\">\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/contact\"\"\r\n                                          >\r\n                      Get in touch                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 !text-ompYellow\"\r\n                      href=\"/ticketchanges/home\"\"\r\n                                          >\r\n                      Ticket changes                    </a>\r\n                  </li>\r\n                              </ul>\r\n            </div>\r\n                      <div>\r\n                              <h4 class=\"mb-1 font-semibold text-white\">\r\n                  Customer Information                </h4>\r\n              \r\n              <ul class=\"space-y-1\">\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/about\"\"\r\n                                          >\r\n                      About Us                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/faq\"\"\r\n   