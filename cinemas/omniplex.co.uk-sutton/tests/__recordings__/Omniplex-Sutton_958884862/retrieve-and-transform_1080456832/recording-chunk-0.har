g\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n        </div>\r\n            \r\n        <!-- <div class=\"mb-big\">\r\n          <h3 class=\"text-md font-semibold\">Genre</h3>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Action\" class=\"cursor-pointer\">Action (8)</label>\r\n              <input type=\"checkbox\" id=\"genre_Action\" name=\"genre_Action\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Adventure\" class=\"cursor-pointer\">Adventure (7)</label>\r\n              <input type=\"checkbox\" id=\"genre_Adventure\" name=\"genre_Adventure\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Animation\" class=\"cursor-pointer\">Animation (4)</label>\r\n              <input type=\"checkbox\" id=\"genre_Animation\" name=\"genre_Animation\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Comedy\" class=\"cursor-pointer\">Comedy (4)</label>\r\n              <input type=\"checkbox\" id=\"genre_Comedy\" name=\"genre_Comedy\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Documentary\" class=\"cursor-pointer\">Documentary (2)</label>\r\n              <input type=\"checkbox\" id=\"genre_Documentary\" name=\"genre_Documentary\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Drama\" class=\"cursor-pointer\">Drama (4)</label>\r\n              <input type=\"checkbox\" id=\"genre_Drama\" name=\"genre_Drama\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Event\" class=\"cursor-pointer\">Event (14)</label>\r\n              <input type=\"checkbox\" id=\"genre_Event\" name=\"genre_Event\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Family\" class=\"cursor-pointer\">Family (2)</label>\r\n              <input type=\"checkbox\" id=\"genre_Family\" name=\"genre_Family\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Fantasy\" class=\"cursor-pointer\">Fantasy (3)</label>\r\n              <input type=\"checkbox\" id=\"genre_Fantasy\" name=\"genre_Fantasy\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Horror\" class=\"cursor-pointer\">Horror (1)</label>\r\n              <input type=\"checkbox\" id=\"genre_Horror\" name=\"genre_Horror\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Romance\" class=\"cursor-pointer\">Romance (1)</label>\r\n              <input type=\"checkbox\" id=\"genre_Romance\" name=\"genre_Romance\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Sci-Fi\" class=\"cursor-pointer\">Sci-Fi (2)</label>\r\n              <input type=\"checkbox\" id=\"genre_Sci-Fi\" name=\"genre_Sci-Fi\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Thriller\" class=\"cursor-pointer\">Thriller (1)</label>\r\n              <input type=\"checkbox\" id=\"genre_Thriller\" name=\"genre_Thriller\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n              \r\n        </div> -->\r\n            \r\n      <div class=\"mb-big\">\r\n        <h3 class=\"text-md font-semibold\">Accessibility Options</h3>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-audio-described\"></i>\r\n              <label for=\"audioDescriptionFilter\" class=\"cursor-pointer font-medium\">Audio Description</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"audioDescriptionFilter\" name=\"access_audioDescription\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Grab a headset and enjoy detailed screen descriptions. <a href=\"/filters/audiodescribed\" class=\"text-ompYellow\">Learn more</a></p> \r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-sensory-friendly-56\"></i>\r\n              <label for=\"sensoryFriendlyFilter\" class=\"cursor-pointer font-medium\">Sensory Friendly</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"sensoryFriendlyFilter\" name=\"access_sensoryFriendly\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Held every weekend around noon at all Omniplex cinemas. <a href=\"/filters/sensoryfriendly\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>        \r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-subtitles\"></i>\r\n              <label for=\"subtitledFilter\" class=\"cursor-pointer font-medium\">Subtitled</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"subtitledFilter\" name=\"access_subtitled\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Available for blockbuster movies on Monday evenings. <a href=\"/filters/subtitled\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>        \r\n      </div>      \r\n          \r\n      <div class=\"mb-big\">\r\n        <h3 class=\"text-md font-semibold\">Special Screenings</h3>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-kids-club\"></i>\r\n              <label for=\"kidsClubFilter\" class=\"cursor-pointer font-medium\">Kids Club</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"kidsClubFilter\" name=\"special_kidsClub\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Save on select family films every weekend. <a href=\"/filters/kidsclub\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-secret-screeningss\"></i>\r\n              <label for=\"secretScreenFilter\" class=\"cursor-pointer font-medium\">Secret Screenings</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"secretScreenFilter\" name=\"special_secretScreen\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">You'll know the genre, but the movie is a surprise! <a href=\"/filters/secretscreenings\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-live-and-eventss\"></i>\r\n              <label for=\"liveEventsFilter\" class=\"cursor-pointer font-medium\">Live &amp; Events</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"liveEventsFilter\" name=\"special_liveEvents\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Watch pre-recorded and live events from around the world on the big screen. <a href=\"/filters/liveevents\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-star-full\"></i>\r\n              <label for=\"classicsFilter\" class=\"cursor-pointer font-medium\">Classics</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"classicsFilter\" name=\"special_classics\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Relive fan-favourite classics on the big screen every month.</p>\r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-kids-club\"></i>\r\n              <label for=\"parentbabyFilter\" class=\"cursor-pointer font-medium\">Parent &amp; Baby</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"parentbabyFilter\" name=\"special_parentbaby\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Wednesdays for movie time with your little one! <a href=\"#\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>        \r\n      </div>    \r\n        </div>\r\n    \r\n    <!-- Footer: Fixed Bottom Buttons -->\r\n    <div class=\"px-8 py-4 bg-black border-t border-gray-700\">\r\n      <div class=\"flex justify-between\">\r\n        <button id=\"clearFilters\" class=\"mx-2 w-full bg-gray-600 px-4 py-2 rounded text-white\">Clear all</button>\r\n        <button id=\"applyFilters\" class=\"mx-2 w-full bg-ompYellow px-4 py-2 rounded text-black\">Apply</button>\r\n      </div>\r\n    </div>\r\n  </form>\r\n</div><!-- Info Start  -->\r\n<!-- Info End  -->\r\n\r\n<!-- Success Alert Start  -->\r\n<!-- Success Alert End  -->\r\n\r\n<!-- Error Alert Start  -->\r\n<!-- Error Alert End  -->\r\n\r\n<script>\r\ndocument.addEventListener(\"DOMContentLoaded\", function() {\r\n  document.querySelectorAll('.relative').forEach(function(alert) {\r\n    requestAnimationFrame(function() {\r\n      alert.classList.remove('hidden');\r\n      alert.classList.add('block');\r\n    });\r\n  });\r\n  document.querySelectorAll('.close-alert').forEach(function(button) {\r\n    button.addEventListener('click', function() {\r\n      const alertDiv = button.closest('.relative');\r\n      if (alertDiv) {\r\n        alertDiv.classList.remove('block');\r\n        alertDiv.classList.add('hidden');\r\n      }\r\n    });\r\n  });\r\n});\r\n</script>\r\n<!-- Display when user clicks star to remove from watch list  -->\r\n<div id=\"removeFavouriteMovie\" class=\"overflow-hidden hidden\">\r\n  <div class=\"fixed inset-0 flex items-center justify-center z-50\">\r\n    <div id=\"backgroundOverlay\" class=\"absolute inset-0 bg-black opacity-90 pointer-events-none\"></div>\r\n    <div class=\"relative p-6 rounded shadow-lg z-10\">\r\n      <p class=\"mb-4\">Do you want to remove this movie from your Want to Watch List?</p>\r\n      <h2 class=\"text-4xl font-bold my-mid text-center\" id=\"removeFavouriteMovieName\">Stolen</h2>\r\n      <div class=\"\">\r\n        <input type=\"hidden\" id=\"removeFavouriteMovieCode\" value=\"\" />\r\n        <button class=\"btn-solid-yellow mb-4\" onClick=\"removeFavourite();return false;\">Yes, remove from my list</button>\r\n        <button class=\"btn-solid-gray\" onClick=\"closeRemoveFavouriteModal();return false;\">No, go back</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>  \r\n<!-- END - Display when user clicks star to remove from watch list  -->\r\n\r\n\r\n<!-- Display when user selects a different site for food  -->\r\n<div id=\"confirmFoodSite\" class=\"overflow-hidden hidden\">\r\n  <div class=\"fixed inset-0 flex items-center justify-center z-50\">\r\n    <div id=\"backgroundOverlay\" class=\"absolute inset-0 bg-black/70 backdrop-blur-sm pointer-events-none\"></div>\r\n    <div class=\"relative p-6 rounded shadow-lg z-10 bg-ompGray rounded-lg\">\r\n      <p class=\"mb-4\">You are ordering food for collection at</p>\r\n      <h2 class=\"text-4xl font-bold my-mid text-center\" id=\"closeConfirmFoodSiteName\">Site Name</h2>\r\n      <div class=\"\">\r\n      <button class=\"btn-solid-yellow mb-2\" onClick=\"sumbitForm()\">Confirm</button>\r\n        <button class=\"btn-solid-gray\" onClick=\"closeConfirmFoodSite();return false;\">No, go back</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>  \r\n<!-- END - Display when user selects a different site for food  -->\r\n\r\n\r\n<!-- Display when user selects a different site for food  -->\r\n<div id=\"cancelMembership\" class=\"overflow-hidden hidden\">\r\n  <div class=\"fixed inset-0 flex items-center justify-center z-50\">\r\n    <div id=\"backgroundOverlay\" class=\"absolute inset-0 bg-black/70 backdrop-blur-sm pointer-events-none\"></div>\r\n    <div class=\"relative p-6 rounded shadow-lg z-10 bg-ompGray rounded-lg\">\r\n      <p class=\"mb-4\">Are you sure you want to cancel your membership?</p>\r\n      <div class=\"\">\r\n        <button class=\"btn-solid-yellow mb-2\" onclick=\"cancelScheme()\">Confirm</button>\r\n        <button class=\"btn-solid-gray\" onClick=\"closeCancelMembership();return false;\">No, go back</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>  \r\n<!-- END - Display when user selects a different site for food  -->  <div class=\"main-container-full block md:hidden mb-mid relative z-[5]\">\r\n    <div class=\"w-full z-50\">\r\n      <div id=\"mobileSliderNav\" class=\"group-nav-container\" style=\"cursor: grab;\">\r\n        <!-- active  -->\r\n                    <button\r\n              onclick=\"navigateTo('/cinema/showtimes')\"\r\n              class=\"group-nav-item active\"\r\n            >\r\n              <p>Showtimes</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/cinema/movies')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Trailers</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/cinema/events')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Events</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/cinema/kids')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Kids &amp; Family</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/booking/extras-home')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Food</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/company/about')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Our Cinema</p>\r\n            </button>\r\n              </div>\r\n    </div>\r\n  </div>\r\n  <script>\r\n    document.addEventListener('DOMContentLoaded', () => {\r\n\r\n      const nav = document.getElementById('mobileSliderNav');\r\n      if (!nav) return;\r\n\r\n      const items = Array.from(nav.querySelectorAll('.group-nav-item'));\r\n      const sections = items.map(btn => document.getElementById(btn.dataset.target));\r\n\r\n      let suppressNavClick = false;\r\n\r\n      // Expose to inline onclick\r\n      window.navigateTo = function(url) {\r\n        if (suppressNavClick) return;\r\n        window.location.href = url;\r\n      };\r\n\r\n      function setActive(activeIdx) {\r\n        items.forEach((btn, i) => {\r\n          btn.classList.toggle('active', i === activeIdx);\r\n        });\r\n      }\r\n\r\n      function centerNavItem(btn, behavior = 'smooth') {\r\n        const desired =\r\n          btn.offsetLeft + (btn.offsetWidth / 2) - (nav.clientWidth / 2);\r\n\r\n        const maxScroll = nav.scrollWidth - nav.clientWidth;\r\n        const clamped = Math.max(0, Math.min(desired, maxScroll));\r\n\r\n        nav.scrollTo({\r\n          left: clamped,\r\n          behavior\r\n        });\r\n      }\r\n\r\n      // Center active item on load\r\n      const initiallyActive = nav.querySelector('.group-nav-item.active');\r\n      if (initiallyActive) centerNavItem(initiallyActive, 'auto');\r\n\r\n      // --- Drag to scroll ---\r\n      (function enableDragScroll(container) {\r\n\r\n        let isDown = false;\r\n        let startX = 0;\r\n        let startScrollLeft = 0;\r\n        let dragging = false;\r\n\r\n        const DRAG_THRESHOLD = 10;\r\n\r\n        container.style.cursor = 'grab';\r\n\r\n        container.addEventListener('pointerdown', (e) => {\r\n          if (e.pointerType === 'mouse' && e.button !== 0) return;\r\n\r\n          isDown = true;\r\n          dragging = false;\r\n          startX = e.clientX;\r\n          startScrollLeft = container.scrollLeft;\r\n\r\n          container.style.cursor = 'grabbing';\r\n        });\r\n\r\n        container.addEventListener('pointermove', (e) => {\r\n          if (!isDown) return;\r\n\r\n          const dx = e.clientX - startX;\r\n\r\n          if (!dragging && Math.abs(dx) > DRAG_THRESHOLD) {\r\n            dragging = true;\r\n          }\r\n\r\n          if (dragging) {\r\n            if (e.cancelable) e.preventDefault();\r\n            container.scrollLeft = startScrollLeft - dx;\r\n          }\r\n\r\n        }, { passive: false });\r\n\r\n        container.addEventListener('pointerup', () => {\r\n          isDown = false;\r\n          container.style.cursor = 'grab';\r\n\r\n          if (dragging) {\r\n            suppressNavClick = true;\r\n            setTimeout(() => {\r\n              suppressNavClick = false;\r\n            }, 0);\r\n          }\r\n        });\r\n\r\n        container.addEventListener('pointercancel', () => {\r\n          isDown = false;\r\n          container.style.cursor = 'grab';\r\n        });\r\n\r\n      })(nav);\r\n\r\n    });\r\n  </script>\r\n\r\n\r\n<!-- Here   -->\r\n\r\n<link rel=\"stylesheet\" href=\"/include/A1CookieManager/css/main.css?v=20260617_01\" type=\"text/css\"> \r\n<div id=\"cookieOverlay\" class=\"OMP_overlay backdrop-blur-sm\" style=\"pointer-events:none;\"></div>\r\n<div id=\"cookieConsentBar\" style=\"display: none;\">\r\n  <div class=\"cookie-consent-banner\">\r\n    <p>We use cookies on our website to personalise and improve your experience and ensure the website works\r\n      correctly.\r\n      <a style=\"text-decoration:underline;\" href=\"/company/privacy#cookieAnchor\" target=\"_blank\">View our Cookie Policy</a>.\r\n    </p>\r\n    <div class=\"cookie-buttons\">\r\n      \r\n    <button id=\"managePrefs\" onclick=\"toggleManage()\" class=\"cookie-button btn-solid-gray !mx-px\" id=\"manage-cookies\">Manage</button>\r\n      <button id=\"savePrefs\" onclick=\"checkCookiePerfs()\" class=\"cookie-button btn-solid-yellow !mx-px\" style=\"display:none;\">Save Preferences</button>\r\n    <button id=\"acceptAll\" onclick=\"setCookieCookie('ALL')\" class=\"cookie-button btn-solid-yellow !mx-px\">Accept All</button>\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"manageOptions\" style=\"display:none;\">\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Necessary</h3>\r\n                      <p>Necessary cookies are required to enable the basic features of this site, such as providing secure log-in or adjusting your consent preferences. These cookies do not store any personally identifiable data.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Necessary\"\r\n                                  checked                                  disabled>\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreNecessary')\">More Details</button>\r\n              <div id=\"moreNecessary\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                                                  <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> a1wcc</li>\r\n                              <li><strong>Duration:</strong> 1 year</li>\r\n                              <li><strong>Description:</strong> Stores the user&rsquo;s consent and preferences for website cookies. This cookie remembers the user&rsquo;s choices regarding the acceptance or rejection of specific cookie categories, ensuring personalized settings are applied on subsequent visits.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> PHPSESSID</li>\r\n                              <li><strong>Duration:</strong> Session</li>\r\n                              <li><strong>Description:</strong> Creates a unique session identifier for each visitor to maintain session data across multiple pages. It does not contain personal information and is deleted when the user closes their browser. This cookie is essential for enabling user functionalities and preferences during the active session.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> __cflb</li>\r\n                              <li><strong>Duration:</strong> 24 hours</li>\r\n                              <li><strong>Description:</strong> CloudFlare&rsquo;s session affinity cookie used to map your session to the correct server.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> sitecode</li>\r\n                              <li><strong>Duration:</strong> 1 hour</li>\r\n                              <li><strong>Description:</strong> The cinema location you have selected.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> omnicustomer</li>\r\n                              <li><strong>Duration:</strong> 2 weeks</li>\r\n                              <li><strong>Description:</strong> A token for the login, if &lsquo;stay logged in&rsquo; is selected.</li>\r\n                          </ul>\r\n                                                      </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Analytics</h3>\r\n                      <p>Analytical cookies are used to understand how visitors interact with the website. These cookies help provide information on metrics such as the number of visitors, bounce rate, traffic source, etc.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Analytics\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreAnalytics')\">More Details</button>\r\n              <div id=\"moreAnalytics\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                                                  <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _ga</li>\r\n                              <li><strong>Duration:</strong> 2 years</li>\r\n                              <li><strong>Description:</strong> Registers a unique ID that is used to generate statistical data on how the visitor uses the website.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _ga_C6EGS4GGTV</li>\r\n                              <li><strong>Duration:</strong> 2 years</li>\r\n                              <li><strong>Description:</strong> Used by Google Analytics to collect data on the number of times a user has visited the website as well as dates for the first and most recent visit.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _ga_Y8PVGSGW5G</li>\r\n                              <li><strong>Duration:</strong> 2 years</li>\r\n                              <li><strong>Description:</strong> Used to persist session state.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _gat_gtag_UA_2532751_2</li>\r\n                              <li><strong>Duration:</strong> 1 minute</li>\r\n                              <li><strong>Description:</strong> Used by Google Analytics to throttle request rate.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _gat_gtag_UA_56401285_6</li>\r\n                              <li><strong>Duration:</strong> 1 minute</li>\r\n                              <li><strong>Description:</strong> Used to throttle request rate.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _gid</li>\r\n                              <li><strong>Duration:</strong> 24 hours</li>\r\n                              <li><strong>Description:</strong> Registers a unique ID that is used to generate statistical data on how the visitor uses the website.</li>\r\n                          </ul>\r\n                                                      </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Functional</h3>\r\n                      <p>Functional cookies help perform certain functionalities like sharing the content of the website on social media platforms, collecting feedback, and other third-party features.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Functional\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreFunctional')\">More Details</button>\r\n              <div id=\"moreFunctional\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Performance</h3>\r\n                      <p>Performance cookies are used to understand and analyze the key performance indexes of the website which helps in delivering a better user experience for the visitors.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Performance\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('morePerformance')\">More Details</button>\r\n              <div id=\"morePerformance\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Advertisement</h3>\r\n                      <p>Advertisement cookies are used to provide visitors with customized advertisements based on the pages you visited previously and to analyze the effectiveness of the ad campaigns.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Advertisement\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreAdvertisement')\">More Details</button>\r\n              <div id=\"moreAdvertisement\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Other</h3>\r\n                      <p>Other uncategorized cookies are those that are being analyzed and have not been classified into a category as yet.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Other\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreOther')\">More Details</button>\r\n              <div id=\"moreOther\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n    </div>\r\n</div>\r\n\r\n<script type=\"text/javascript\" src=\"/include/A1CookieManager/script/main.js?v=20260617_01\"></script>\r\n\r\n<div id=\"siteModal\" class=\"fixed inset-0 z-[60] flex items-center justify-center p-4 hidden\">\r\n  <div class=\"absolute inset-0 bg-black/70 backdrop-blur-sm\"></div>\r\n  <div class=\"relative z-[70] w-full max-w-[640px] h-[85vh]\">\r\n    <style>\r\n  #siteScrollArea {\r\n    -ms-overflow-style: none;\r\n    scrollbar-width: none;\r\n  }\r\n\r\n  #siteScrollArea::-webkit-scrollbar {\r\n    display: none;\r\n  }\r\n</style>\r\n\r\n<div class=\"flex h-full flex-col overflow-hidden rounded-xl bg-[#282828]\">\r\n\r\n  <div class=\"shrink-0 bg-[#282828] px-4 pt-8 pb-4\">\r\n    <div class=\"text-right mb-4 px-4\">\r\n      <i onclick=\"toggleLoginModal()\" class=\"text-ompYellow icon omni-close cursor-pointer\"></i>\r\n    </div>\r\n    <div class=\"w-full md:w-3/4 mx-auto w-full max-w-[560px]\">\r\n      <div id=\"login_section\" class=\"mb-6 w-full\">\r\n        <h1 class=\"text-3xl leading-tight font-normal text-white\">\r\n          Which is your local Omniplex?\r\n        </h1>\r\n      </div>\r\n\r\n      <div class=\"input-search  overflow-hidden rounded-md\">\r\n        <i class=\"icon omni-search text-white/80\"></i>\r\n        <input id=\"search\" placeholder=\"Search\" type=\"text\" class=\"text-white placeholder:text-white/50\" />\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"siteScrollArea\" class=\"flex-1 overflow-y-auto px-4\">\r\n    <div class=\"w-full md:w-3/4 mx-auto w-full max-w-[560px] py-6\">\r\n      <div id=\"site-selection-list\" class=\"border-t border-b border-ompYellow/30 py-4\">\r\n        <form id=\"siteList-modal\">\r\n          \r\n          <div class=\"region-group mb-2\"><div class=\"region-header flex cursor-pointer items-center justify-between py-3\"><p class=\"text-xl text-white\">England</p><i class=\"icon-swtich icon omni-chevron-up text-xl text-white\"></i></div><div class=\"region-items\"><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Birmingham - Great Park</p></div><div><input type=\"checkbox\" value=\"OMP_BIRM\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">High Wycombe</p></div><div><input type=\"checkbox\" value=\"OMP_HIWY\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Ipswich</p></div><div><input type=\"checkbox\" value=\"OMP_IPSW\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Sunderland</p></div><div><input type=\"checkbox\" value=\"OMP_SUND\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Sutton Surrey</p></div><div><input type=\"checkbox\" value=\"OMP_SUTT\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Wigan</p></div><div><input type=\"checkbox\" value=\"OMP_WIGA\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div></div></div><div class=\"region-group mb-2\"><div class=\"region-header flex cursor-pointer items-center justify-between py-3\"><p class=\"text-xl text-white\">Scotland</p><i class=\"icon-swtich icon omni-chevron-up text-xl text-white\"></i></div><div class=\"region-items\"><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Clydebank</p></div><div><input type=\"checkbox\" value=\"OMP_CLYD\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Glasgow - Renfrew Street</p></div><div><input type=\"checkbox\" value=\"OMP_GLAS\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div></div></div><div class=\"region-group mb-2\"><div class=\"region-header flex cursor-pointer items-center justify-between py-3\"><p class=\"text-xl text-white\">Northern Ireland</p><i class=\"icon-swtich icon omni-chevron-up text-xl text-white\"></i></div><div class=\"region-items\"><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Antrim</p></div><div><input type=\"checkbox\" value=\"OMP_ANTR\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Banbridge</p></div><div><input type=\"checkbox\" value=\"OMP_BANB\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Bangor</p></div><div><input type=\"checkbox\" value=\"OMP_BANG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Belfast - Dundonald</p></div><div><input type=\"checkbox\" value=\"OMP_DUDO\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Belfast - Kennedy Centre</p></div><div><input type=\"checkbox\" value=\"OMP_KENN\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Carrickfergus</p></div><div><input type=\"checkbox\" value=\"OMP_CARR\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Craigavon</p></div><div><input type=\"checkbox\" value=\"OMP_CRAI\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Derry</p></div><div><input type=\"checkbox\" value=\"OMP_DERR\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Downpatrick</p></div><div><input type=\"checkbox\" value=\"OMP_DOWN\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Dungannon</p></div><div><input type=\"checkbox\" value=\"OMP_DUGA\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Larne</p></div><div><input type=\"checkbox\" value=\"OMP_LARN\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Lisburn</p></div><div><input type=\"checkbox\" value=\"OMP_LISB\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Newry</p></div><div><input type=\"checkbox\" value=\"OMP_NEWR\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Omagh</p></div><div><input type=\"checkbox\" value=\"OMP_OMAG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div></div></div><div class=\"region-group mb-2\"><div class=\"region-header flex cursor-pointer items-center justify-between py-3\"><p class=\"text-xl text-white\">Rep. of Ireland</p><i class=\"icon-swtich icon omni-chevron-up text-xl text-white\"></i></div><div class=\"region-items\"><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Arklow</p></div><div><input type=\"checkbox\" value=\"OMP_ARKL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Ballinasloe</p></div><div><input type=\"checkbox\" value=\"OMP_BALL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Carlow</p></div><div><input type=\"checkbox\" value=\"OMP_CARL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Cork</p></div><div><input type=\"checkbox\" value=\"OMP_MAHO\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Drogheda - Scotch Hall</p></div><div><input type=\"checkbox\" value=\"OMP_SCOT\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Dublin - Balbriggan</p></div><div><input type=\"checkbox\" value=\"OMP_BALB\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Dublin - Nutgrove</p></div><div><input type=\"checkbox\" value=\"OMP_NUTG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Dublin - Rathmines</p></div><div><input type=\"checkbox\" value=\"OMP_RATH\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Dundalk</p></div><div><input type=\"checkbox\" value=\"OMP_DUND\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Galway - Salthill</p></div><div><input type=\"checkbox\" value=\"OMP_GALW\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Killarney</p></div><div><input type=\"checkbox\" value=\"OMP_KILL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Limerick</p></div><div><input type=\"checkbox\" value=\"OMP_LIME\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Longford</p></div><div><input type=\"checkbox\" value=\"OMP_LONG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Monaghan</p></div><div><input type=\"checkbox\" value=\"OMP_MONA\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Mullingar</p></div><div><input type=\"checkbox\" value=\"OMP_MULL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Nenagh</p></div><div><input type=\"checkbox\" value=\"OMP_NENA\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Roscommon</p></div><div><input type=\"checkbox\" value=\"OMP_ROSC\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Shannon</p></div><div><input type=\"checkbox\" value=\"OMP_SHAN\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Sligo</p></div><div><input type=\"checkbox\" value=\"OMP_SLIG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Tralee</p></div><div><input type=\"checkbox\" value=\"OMP_TRAL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Waterford</p></div><div><input type=\"checkbox\" value=\"OMP_WATE\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Wexford</p></div><div><input type=\"checkbox\" value=\"OMP_WEXF\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div></div></div>\r\n          <input type=\"hidden\" class=\"action\" name=\"action\" value=\"process\" />\r\n        </form>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"footerControl\" class=\"hidden shrink-0 bg-[#282828]\">\r\n    <div class=\"main-container mx-auto w-full max-w-[560px] px-4 py-4\">\r\n      <button id=\"siteSelectButton\" type=\"button\" class=\"btn-solid-yellow w-full\" onclick=\"siteSelectProceed();\">\r\n        Continue\r\n      </button>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<script>\r\n  document.addEventListener(\"DOMContentLoaded\", function() {\r\n    const siteContainers = document.querySelectorAll(\".site-selection-item\");\r\n    const footerControl  = document.getElementById('footerControl');\r\n    const searchInput    = document.getElementById('search');\r\n    const regionHeaders  = document.querySelectorAll('.region-header');\r\n    const regionItems    = document.querySelectorAll('.region-items');\r\n\r\n    function resetCheckboxes() {\r\n      siteContainers.forEach(container => {\r\n        const cb  = container.querySelector(\"input[type='checkbox']\");\r\n        const img = container.querySelector(\".checkbox-img\");\r\n\r\n        if (cb && img) {\r\n          cb.checked = false;\r\n          img.src = \"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\";\r\n        }\r\n      });\r\n    }\r\n\r\n    siteContainers.forEach(container => {\r\n      const cb  = container.querySelector(\"input[type='checkbox']\");\r\n      const img = container.querySelector(\".checkbox-img\");\r\n\r\n      if (!cb || !img) {\r\n        return;\r\n      }\r\n\r\n      container.addEventListener(\"click\", function() {\r\n        if (!cb.checked) {\r\n          resetCheckboxes();\r\n          cb.checked = true;\r\n          img.src = \"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-on.svg\";\r\n          footerControl.classList.remove('hidden');\r\n        } else {\r\n          cb.checked = false;\r\n          img.src = \"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\";\r\n          footerControl.classList.add('hidden');\r\n        }\r\n      });\r\n    });\r\n\r\n    searchInput.addEventListener(\"input\", function() {\r\n      const q     = this.value.toLowerCase().trim();\r\n      const items = document.querySelectorAll('.site-selection-item');\r\n\r\n      if (q) {\r\n        regionHeaders.forEach(h => h.style.display = 'none');\r\n        regionItems.forEach(r => r.style.display = '');\r\n        items.forEach(item => {\r\n          const txt = item.querySelector('p').textContent.toLowerCase();\r\n          item.style.display = txt.includes(q) ? 'flex' : 'none';\r\n        });\r\n      } else {\r\n        regionHeaders.forEach(h => h.style.display = '');\r\n        regionItems.forEach(r => r.style.display = 'none');\r\n        items.forEach(i => i.style.display = '');\r\n      }\r\n    });\r\n\r\n    document.querySelectorAll('.region-group').forEach(group => {\r\n      const header = group.querySelector('.region-header');\r\n      const items  = group.querySelector('.region-items');\r\n      const icon   = header.querySelector('i');\r\n\r\n      header.classList.add('closed');\r\n      items.style.display = 'none';\r\n      icon.classList.add('omni-chevron-down');\r\n      icon.classList.remove('omni-chevron-up');\r\n\r\n      header.addEventListener('click', () => {\r\n        const hidden = items.style.display === 'none';\r\n        items.style.display = hidden ? '' : 'none';\r\n        header.classList.toggle('closed', !hidden);\r\n        icon.classList.toggle('omni-chevron-up', hidden);\r\n        icon.classList.toggle('omni-chevron-down', !hidden);\r\n      });\r\n    });\r\n\r\n    const currentSiteCode = 'OMP_SUTT';\r\n\r\n    if (currentSiteCode) {\r\n      const selectedInput = document.querySelector('input[name=\"cinema_item\"][value=\"' + currentSiteCode + '\"]');\r\n\r\n      if (selectedInput) {\r\n        const container   = selectedInput.closest('.site-selection-item');\r\n        const regionGroup = container.closest('.region-group');\r\n\r\n        if (regionGroup) {\r\n          const header = regionGroup.querySelector('.region-header');\r\n          const items  = regionGroup.querySelector('.region-items');\r\n          const icon   = header.querySelector('i');\r\n\r\n          items.style.display = '';\r\n          header.classList.remove('closed');\r\n          icon.classList.add('omni-chevron-up');\r\n          icon.classList.remove('omni-chevron-down');\r\n        }\r\n\r\n        selectedInput.checked = true;\r\n\r\n        const img = container.querySelector('.checkbox-img');\r\n        if (img) {\r\n          img.src = \"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-on.svg\";\r\n        }\r\n\r\n        footerControl.classList.remove('hidden');\r\n        container.scrollIntoView({ behavior: 'smooth', block: 'center' });\r\n      }\r\n    }\r\n\r\n        // getLatLong();\r\n      });\r\n\r\n  function siteSelectSubmit() {\r\n    document.getElementById('siteList-modal').submit();\r\n  }\r\n\r\n  function siteSelectProceed() {\r\n    document.getElementById('siteSelectButton').classList.add('disabled');\r\n    siteSelectSubmit();\r\n  }\r\n</script>  </div>\r\n</div>\r\n\r\n\r\n<!-- And here  -->\r\n\r\n<div class=\"pt-1 pb-2 relative\" style=\"overflow: visible;\">\r\n  <!-- JD to review -->\r\n  <div style=\"\r\n    position: absolute;\r\n    top: 50%;\r\n    left: 50%;\r\n    transform: translate(-50%, -50%);\r\n    width: 100%;\r\n    height: 90%;\r\n    background: radial-gradient(\r\n      circle at center,\r\n      #ffea00 0%,\r\n      rgba(255,234,0,0.12) 35%,\r\n      rgba(255,234,0,0) 100%\r\n    );\r\n    filter: blur(30px);\r\n    -webkit-filter: blur(30px);\r\n    opacity: 0.5;\r\n    z-index: 0;\">\r\n  </div>\r\n  <section id=\"showcase\" class=\"main-container-s2s splide mb-mid\" style=\"position: relative;\">\r\n    <div class=\"splide__track\">\r\n      <ul class=\"splide__list\">\r\n        \r\n                  <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/Moana Web Slider.webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">Moana</h2><div class=\"showtime-details flex items-center gap-3 flex-wrap justify-start\"><a href=\"/cinema/movie/sutton/moana\" class=\"!mx-px btn-solid-yellow showtime-button\">Book now</a><span class=\"showtime-age-rating flex-shrink-0\"><img title=\"BBFC - PG\" class=\"showtime-age-rating-img\" src=\"/images/ratings/UK_PG.png\" /></span><span class=\"showtime-genre\">Action, Adventure</span></div></div></div></div>                  <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/Evil Dead Burn Web Slider.webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">Evil Dead Burn</h2><div class=\"showtime-details flex items-center gap-3 flex-wrap justify-start\"><a href=\"/cinema/movie/sutton/evil-dead-burn\" class=\"!mx-px btn-solid-yellow showtime-button\">Book now</a><span class=\"showtime-age-rating flex-shrink-0\"><img title=\"BBFC - 18\" class=\"showtime-age-rating-img\" src=\"/images/ratings/UK_18.png\" /></span><span class=\"showtime-genre\">Horror</span></div></div></div></div>                  <div class=\"splide__slide showtime-card\" style=\"background-image: url('https://www.omniplexcinemas.co.uk/cms/Toy Story 5  Slider 2.webp');\"><div class=\"showtime-card-graident\"><div class=\"showtime-card-content\"><h2 class=\"showtime-title mb-2\">Toy Stor