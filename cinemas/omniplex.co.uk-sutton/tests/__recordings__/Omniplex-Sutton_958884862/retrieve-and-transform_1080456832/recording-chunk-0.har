l-span-1 md:col-span-1 lg:col-span-2 xl:col-span-2\">\r\n    <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n      <img\r\n        src=\"/filmimages/small/112718.jpg?v=1558739705\"\r\n        alt=\"Animal Farm Event poster\"\r\n        class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n        data-eventCode=\"112718\"\r\n        data-eventCode=\"Animal Farm\"\r\n      />\r\n          </div>\r\n  </div>\r\n  <div class=\"md:col-span-5 lg:col-span-5 xl:col-span-8\">\r\n    <div class=\"grid grid-cols-3 md:grid-cols-5 gap-4 items-start\">\r\n      <!-- A (Mobile) -->\r\n      <div class=\"md:hidden col-span-1\">\r\n        <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n          <img\r\n            src=\"/filmimages/small/112718.jpg?v=1558739705\"\r\n            alt=\"Animal Farm Event poster\"\r\n            class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n            data-eventCode=\"112718\"\r\n            data-eventCode=\"Animal Farm\"\r\n          />\r\n                  </div>\r\n      </div>\r\n      <!-- B -->\r\n      <div class=\"col-span-2 md:col-span-5\">\r\n        <div class=\"w-full\">\r\n          <div class=\"flex justify-between items-start w-full mb-2\">\r\n            <p class=\"font-medium text-lg sm:text-2xl md:text-3xl leading-snug sm:leading-tight md:leading-tight mr-4\">\r\n              <a href=\"/cinema/movie/sutton/animal-farm\">\r\n                Animal Farm              </a>\r\n            </p>\r\n            <img data-toggle=\"0\" id=\"favourite112718\" onClick=\"toggleFavourite('112718');return false;\" src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_favourited-off.svg\" class=\"w-4 mt-2 mx-3\" alt=\"Add to Favourites\" />  \r\n          </div>\r\n          <div class=\"flex items-center gap-2 mb-2\">\r\n            <div class=\"flex flex-col md:flex-row gap-4\">\r\n              <div class=\"flex items-center gap-2\">\r\n                <img src=\"/images/ratings/UK_PG.png\" class=\"w-4 min-w-[30px]\" />\r\n                <p class=\"text-base leading-snug font-normal leading-none\">Animation</p>\r\n              </div>\r\n              <p class=\"mb-2 md:m-auto flex item-center\"><span class=\"hidden md:flex mr-2\">|</span> 1hr 35min </p>\r\n            </div>\r\n          </div>\r\n          \r\n            <p class=\"hidden md:block mb-2 pt-2\">\r\n              <span class=\"synopsis-short\">\r\n                From visionary director Andy Serkis, and featuring the voices of Seth Rogen, Gaten Matarazzo, Glenn Close, and Woody Harrelson, comes an inspiring animated adventure about friendship, courage, and believing in a brighter future. When the animals of M...              </span>\r\n\r\n                              <span class=\"synopsis-full hidden text-base\">\r\n                  From visionary director Andy Serkis, and featuring the voices of Seth Rogen, Gaten Matarazzo, Glenn Close, and Woody Harrelson, comes an inspiring animated adventure about friendship, courage, and believing in a brighter future. When the animals of Manor Farm set out to build a community where everyone has a voice, they discover that creating a fair and happy home takes teamwork, kindness, and the courage to do what's right. Filled with heart, humour, and unforgettable characters, Animal Farm is a timeless tale the whole family can enjoy.                </span>\r\n\r\n                <button \r\n                  type=\"button\"\r\n                  class=\"ml-2 text-ompYellow underline text-base\"\r\n                  onclick=\"toggleSynopsis(this)\"\r\n                >\r\n                  See more\r\n                </button>\r\n                          </p>\r\n          <div class=\"hallTypeIcon hidden\">\r\n                                  </div>\r\n        </div>\r\n      </div>\r\n      <!-- C -->\r\n      <div class=\"col-span-3 md:col-span-5 md:col-start-1\">\r\n        <div class=\"w-full grid grid-cols-1 md:grid-cols-2 sm:col-span-2 xl:grid-cols-3