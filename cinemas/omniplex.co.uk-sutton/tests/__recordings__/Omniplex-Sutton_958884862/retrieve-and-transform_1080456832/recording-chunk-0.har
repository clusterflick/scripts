mages/small/104999.jpg?v=1555454488\"\r\n            alt=\"Toy Story 5 Event poster\"\r\n            class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n            data-eventCode=\"104999\"\r\n            data-eventCode=\"Toy Story 5\"\r\n          />\r\n                      <img\r\n              onclick=\"playYoutubeVideo('UV7Ht-R3ICY')\"\r\n              src=\"/public/assets/svgs/play-circle.svg\"\r\n              alt=\"Play Trailler\"\r\n              class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n            />\r\n                  </div>\r\n      </div>\r\n      <!-- B -->\r\n      <div class=\"col-span-2 md:col-span-5\">\r\n        <div class=\"w-full\">\r\n          <div class=\"flex justify-between items-start w-full mb-2\">\r\n            <p class=\"font-medium text-lg sm:text-2xl md:text-3xl leading-snug sm:leading-tight md:leading-tight mr-4\">\r\n              <a href=\"/cinema/movie/sutton/toy-story-5\">\r\n                Toy Story 5              </a>\r\n            </p>\r\n            <img data-toggle=\"0\" id=\"favourite104999\" onClick=\"toggleFavourite('104999');return false;\" src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_favourited-off.svg\" class=\"w-4 mt-2 mx-3\" alt=\"Add to Favourites\" />  \r\n          </div>\r\n          <div class=\"flex items-center gap-2 mb-2\">\r\n            <div class=\"flex flex-col md:flex-row gap-4\">\r\n              <div class=\"flex items-center gap-2\">\r\n                <img src=\"/images/ratings/UK_TBCU.png\" class=\"w-4\" />\r\n                <p class=\"text-base leading-snug font-normal leading-none\">Animation, Comedy, Family</p>\r\n              </div>\r\n              <p class=\"mb-2 md:m-auto flex item-center\"><span class=\"hidden md:flex mr-2\">|</span> 1hr 42min </p>\r\n            </div>\r\n          </div>\r\n          \r\n            <p class=\"hidden md:block mb-2 pt-2\">\r\n              <span class=\"synopsis-short\">\r\n                Buzz, Woody, Jessie and the rest of the gang's jobs get exponentially harder when they go head-to-head with a new threat to playtime. Tom Hanks returns as the ever loyal cowboy Woody, Tim Allen reports for duty as Buzz Lightyear, and Joan Cusack sadd...              </span>\r\n\r\n                              <span class=\"synopsis-full hidden text-base\">\r\n                  Buzz, Woody, Jessie and the rest of the gang's jobs get exponentially harder when they go head-to-head with a new threat to playtime. Tom Hanks returns as the ever loyal cowboy Woody, Tim Allen reports for duty as Buzz Lightyear, and Joan Cusack saddles up again as the rootin? tootin? cowgirl Jessie. It was recently announced that Conan O?Brien will also be a part of the voice cast as the toilet training tech toy, Smarty Pants.                </span>\r\n\r\n                <button \r\n                  type=\"button\"\r\n                  class=\"ml-2 text-ompYellow underline text-base\"\r\n                  onclick=\"toggleSynopsis(this)\"\r\n                >\r\n                  See more\r\n                </button>\r\n                          </p>\r\n          <div class=\"hallTypeIcon hidden\">\r\n                                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_maxx.svg\" class=\"h-4 w-auto my-2\" alt=\"Event Type Icon\" />\r\n                                                </div>\r\n        </div>\r\n      </div>\r\n      <!-- C -->\r\n      <div class=\"col-span-3 md:col-span-5 md:col-start-1\">\r\n        <div class=\"w-full grid grid-cols-1 md:grid-cols-2 sm:col-span-2 xl:grid-cols-3  gap-2\">\r\n          <a aria-label=\"Toy Story 5 at 17:00 in Screen 10\" href=\"https://www.omniplexcinemas.co.uk/booking/seats/sutton/42574\" class=\"\"> \r\n<div id=\"perf_0\" class=\"showTimeBox bg-ompGray-times p-2 col-span-1 rounded-xl\">\r\n  <div class=\"topSection flex justify-between items-end\">\r\n    <div class=\"flex items-end\">\r\n      <div class=