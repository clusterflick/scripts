\n                Showtimes              </a>\r\n\r\n              <a href=\"/cinema/showtimes\" class=\"inline-block lg:hidden header-navigation px-2 py-1 text-white/80 hover:text-white active\">\r\n                Showtimes              </a>\r\n              \r\n                            <a href=\"/cinema/movies\" class=\"hidden lg:inline-block header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Trailers              </a>\r\n\r\n              <a href=\"/cinema/movies\" class=\"inline-block lg:hidden header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Trailers              </a>\r\n              \r\n                            <a href=\"/cinema/events\" class=\"hidden lg:inline-block header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Events              </a>\r\n\r\n              <a href=\"/cinema/events\" class=\"inline-block lg:hidden header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Events              </a>\r\n              \r\n                            <a href=\"/cinema/kids\" class=\"hidden lg:inline-block header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Kids &amp; Family              </a>\r\n\r\n              <a href=\"/cinema/kids\" class=\"inline-block lg:hidden header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Kids              </a>\r\n              \r\n                            <a href=\"/booking/extras-home\" class=\"hidden lg:inline-block header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Food              </a>\r\n\r\n              <a href=\"/booking/extras-home\" class=\"inline-block lg:hidden header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Food              </a>\r\n              \r\n                            <a href=\"/company/about\" class=\"hidden lg:inline-block header-navigation px-2 py-1 text