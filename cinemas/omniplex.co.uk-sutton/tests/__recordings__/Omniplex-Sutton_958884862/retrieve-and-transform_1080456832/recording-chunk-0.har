"OMP_SUTT\">&nbsp;Drogheda - Scotch Hall</option>\r\n<option value=\"OMP_BALB\" id=\"balbriggan\" data-thissite=\"OMP_BALB\" data-sitecode=\"OMP_SUTT\">&nbsp;Dublin - Balbriggan</option>\r\n<option value=\"OMP_NUTG\" id=\"nutgrove\" data-thissite=\"OMP_NUTG\" data-sitecode=\"OMP_SUTT\">&nbsp;Dublin - Nutgrove</option>\r\n<option value=\"OMP_RATH\" id=\"dublin-rathmines\" data-thissite=\"OMP_RATH\" data-sitecode=\"OMP_SUTT\">&nbsp;Dublin - Rathmines</option>\r\n<option value=\"OMP_DUND\" id=\"dundalk\" data-thissite=\"OMP_DUND\" data-sitecode=\"OMP_SUTT\">&nbsp;Dundalk</option>\r\n<option value=\"OMP_GALW\" id=\"galway\" data-thissite=\"OMP_GALW\" data-sitecode=\"OMP_SUTT\">&nbsp;Galway - Salthill</option>\r\n<option value=\"OMP_KILL\" id=\"killarney\" data-thissite=\"OMP_KILL\" data-sitecode=\"OMP_SUTT\">&nbsp;Killarney</option>\r\n<option value=\"OMP_LIME\" id=\"limerick\" data-thissite=\"OMP_LIME\" data-sitecode=\"OMP_SUTT\">&nbsp;Limerick</option>\r\n<option value=\"OMP_LONG\" id=\"longford\" data-thissite=\"OMP_LONG\" data-sitecode=\"OMP_SUTT\">&nbsp;Longford</option>\r\n<option value=\"OMP_MONA\" id=\"monaghan\" data-thissite=\"OMP_MONA\" data-sitecode=\"OMP_SUTT\">&nbsp;Monaghan</option>\r\n<option value=\"OMP_MULL\" id=\"mullingar\" data-thissite=\"OMP_MULL\" data-sitecode=\"OMP_SUTT\">&nbsp;Mullingar</option>\r\n<option value=\"OMP_NENA\" id=\"nenagh\" data-thissite=\"OMP_NENA\" data-sitecode=\"OMP_SUTT\">&nbsp;Nenagh</option>\r\n<option value=\"OMP_ROSC\" id=\"roscommon\" data-thissite=\"OMP_ROSC\" data-sitecode=\"OMP_SUTT\">&nbsp;Roscommon</option>\r\n<option value=\"OMP_SHAN\" id=\"shannon\" data-thissite=\"OMP_SHAN\" data-sitecode=\"OMP_SUTT\">&nbsp;Shannon</option>\r\n<option value=\"OMP_SLIG\" id=\"sligo\" data-thissite=\"OMP_SLIG\" data-sitecode=\"OMP_SUTT\">&nbsp;Sligo</option>\r\n<option value=\"OMP_TRAL\" id=\"tralee\" data-thissite=\"OMP_TRAL\" data-sitecode=\"OMP_SUTT\">&nbsp;Tralee</option>\r\n<option value=\"OMP_WATE\" id=\"waterford\" data-thi