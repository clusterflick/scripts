         </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/faq\"\"\r\n                                          >\r\n                      FAQs                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/accessibility\"\"\r\n                                          >\r\n                      Accessibility                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/parking\"\"\r\n                                          >\r\n                      Parking                    </a>\r\n                  </li>\r\n                              </ul>\r\n            </div>\r\n                      <div>\r\n              \r\n              <ul class=\"space-y-1\">\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/terms\"\"\r\n                                          >\r\n                      Terms & Conditions                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/privacy\"\"\r\n                                          >\r\n                      Privacy Policy                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      \"\r\n                      onclick=\"showCookiePolicy(true)\"                    >\r\n                      Manage Cookies                    </a>\r\n                  </li>\r\n                              </ul>\r\n            </div>\r\n                  </div>\r\n              <div id=\"footerColumn2\" class=\"space-y-8\">\r\n                      <div>\r\n                              <h4 class=\"mb-1 font-semibold text-white\">\r\n                  Omniplex Cinemas                </h4>\r\n              \r\n              <ul class=\"space-y-1\">\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/explore/careers\"\"\r\n                                          >\r\n                      Careers                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/explore/app\"\"\r\n                                          >\r\n                      Omniplex App                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/cinema/events\"\"\r\n                                          >\r\n                      Events                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      clas