00/svg\"\r\n        width=\"32\"\r\n        height=\"32\"\r\n        viewBox=\"0 0 32 32\"\r\n      >\r\n        <path d=\"M30.7 9.6s-.3-2.2-1.3-3.2c-1.2-1.3-2.6-1.3-3.2-1.4C21.7 4.7 16 4.7 16 4.7h0s-5.7 0-10.2.3c-.6.1-2 .1-3.2 1.4-1 1-1.3 3.2-1.3 3.2S1 12.2 1 14.8v2.4c0 2.6.3 5.2.3 5.2s.3 2.2 1.3 3.2c1.2 1.3 2.8 1.2 3.5 1.4 2.6.2 9.9.3 9.9.3s5.7 0 10.2-.3c.6-.1 2-.1 3.2-1.4 1-1 1.3-3.2 1.3-3.2s.3-2.6.3-5.2v-2.4c0-2.6-.3-5.2-.3-5.2zM13.1 20.5v-9l7.9 4.5-7.9 4.5z\"></path>\r\n      </svg>\r\n    </a>\r\n  </div>\r\n</div>\r\n<div id=\"footerCompany\" class=\"bg-[#282828]\">\r\n  <div class=\"w-full text-center py-8\">\r\n    <img src=\"/public/assets/branding/omniplex_logo.png\" class=\"h-[44px] mx-auto  mb-3\" alt=\"Omniplex Logo\">\r\n    <p class=\"\">&copy; Omniplex. All rights reserved.</p>\r\n  </div>\r\n</div>\r\n\r\n\r\n\r\n<!-- All footer elements go here      -->\r\n<!-- General JS  -->\r\n<script type=\"text/javascript\" src=\"/public/js/scripts.js?v=1780527802\"></script>\r\n\r\n<!-- If the developer is debugging in Chrome -->\r\n<script>\r\nGlobalDebuggingInChrome = false;\r\n\r\n\r\n\r\n//Clears Footer Contact Select dropdown\r\ndocument.addEventListener('DOMContentLoaded', () => {\r\n    const cinemaSelect = document.getElementById('conactlocalCinema');\r\n    cinemaSelect.selectedIndex = 0;\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function () {\r\n  const cinemaSelect = document.getElementById('conactlocalCinema');\r\n\r\n  if (!cinemaSelect) return;\r\n\r\n  cinemaSelect.addEventListener('change', function () {\r\n    const siteCode = this.value;\r\n\r\n    if (siteCode !== '') {\r\n      window.location.href = '/company/contact?site=' + encodeURIComponent(siteCode);\r\n    }\r\n  });\r\n});\r\n</script>\r\n</body>\r\n\r\n</html>",
