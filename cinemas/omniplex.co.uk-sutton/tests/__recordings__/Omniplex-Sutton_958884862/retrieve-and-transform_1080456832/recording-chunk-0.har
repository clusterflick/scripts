election-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Monaghan</p></div><div><input type=\"checkbox\" value=\"OMP_MONA\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Mullingar</p></div><div><input type=\"checkbox\" value=\"OMP_MULL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Nenagh</p></div><div><input type=\"checkbox\" value=\"OMP_NENA\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Roscommon</p></div><div><input type=\"checkbox\" value=\"OMP_ROSC\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Shannon</p></div><div><input type=\"checkbox\" value=\"OMP_SHAN\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Sligo</p></div><div><input type=\"checkbox\" value=\"OMP_SLIG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Tralee</p></div><div><input type=\"checkbox\" value=\"OMP_TRAL\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Waterford</p></div><div><input type=\"checkbox\" value=\"OMP_WATE\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Wexford</p></div><div><input type=\"checkbox\" value=\"OMP_WEXF\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div></div></div>\r\n          <input type=\"hidden\" class=\"action\" name=\"action\" value=\"process\" />\r\n        </form>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"footerControl\" class=\"hidden shrink-0 bg-[#282828]\">\r\n    <div class=\"main-container mx-auto w-full max-w-[560px] px-4 py-4\">\r\n      <button id=\"siteSelectButton\" type=\"button\" class=\"btn-solid-yellow w-full\" onclick=\"siteSelectProceed();\">\r\n        Continue\r\n      </button>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<script>\r\n  document.addEventListener(\"DOMContentLoaded\", function() {\r\n    const siteContainers = document.querySelectorAll(\".site-selection-item\");\r\n    const footerControl  = document.getElementById('footerControl');\r\n    const searchInput    = document.getElementById('search');\r\n    const regionHeaders  = document.querySelectorAll('.region-header');\r\n    const regionItems    = document.querySelectorAll('.region-items');\r\n\r\n    function resetCheckboxes() {\r\n      siteContainers.forEach(container => {\r\n        const cb  = container.querySelector(\"input[type='checkbox']\");\r\n        const img = container.querySelector(\".checkbox-img\");\r\n\r\n        if (cb && img) {\r\n          cb.checked = false;\r\n          img.src = \"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\";\r\n        }\r\n      });\r\n    }\r\n\r\n    siteContainers.forEach(container => {\r\n      const cb  = container.querySelector(\"input[type='checkbox']\");\r\n      const img = container.querySelector(\".checkbox-img\");\r\n\r\n      if (!cb || !img) {\r\n        return;\r\n      }\r\n\r\n      container.addEventListener(\"click\", function() {\r\n        if (!cb.checked) {\r\n          resetCheckboxes();\r\n          cb.checked = true;\r\n          img.src = \"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-on.svg\";\r\n          footerControl.classList.remove('hidden');\r\n        } else {\r\n          cb.checked = false;\r\n          img.src = \"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\";\r\n          footerControl.classList.add('hidden');\r\n        }\r\n      });\r\n    });\r\n\r\n    searchInput.addEventListener(\"input\", function() {\r\n      const q     = this.value.toLowerCase().trim();\r\n      const items = document.querySelectorAll('.site-selection-item');\r\n\r\n      if (q) {\r\n        regionHeaders.forEach(h => h.style.display = 'none');\r\n        regionItems.forEach(r => r.style.display = '');\r\n        items.forEach(item => {\r\n          const txt = item.querySelector('p').textContent.toLowerCase();\r\n          item.style.display = txt.includes(q) ? 'flex' : 'none';\r\n        });\r\n      } else {\r\n        regionHeaders.forEach(h => h.style.display = '');\r\n        regionItems.forEach(r => r.style.display = 'none');\r\n        items.forEach(i => i.style.display = '');\r\n      }\r\n    });\r\n\r\n    document.querySelectorAll('.region-group').forEach(group => {\r\n      const header = group.querySelector('.region-header');\r\n      const items  = group.querySelector('.region-items');\r\n      const icon   = header.querySelector('i');\r\n\r\n      header.classList.add('closed');\r\n      items.style.display = 'none';\r\n      icon.classList.add('omni-chevron-down');\r\n      icon.classList.remove('omni-chevron-up');\r\n\r\n      header.addEventListener('click', () => {\r\n        const hidden = items.style.display === 'none';\r\n        items.style.display = hidden ? '' : 'none';\r\n        header.classList.toggle('closed', !hidden);\r\n        icon.classList.toggle('omni-chevron-up', hidden);\r\n        icon.classList.toggle('omni-chevron-down', !hidden);\r\n      });\r\n    });\r\n\r\n    const currentSiteCode = 'OMP_SUTT';\r\n\r\n    if (currentSiteCode) {\r\n      const selectedInput = document.querySelector('input[name=\"cinema_item\"][value=\"' + currentSiteCode + '\"]');\r\n\r\n      if (selectedInput) {\r\n        const container   = selectedInput.closest('.site-selection-item');\r\n        const regionGroup = container.closest('.region-group');\r\n\r\n        if (regionGroup) {\r\n          const header = regionGroup.querySelector('.region-header');\r\n          const items  = regionGroup.querySelector('.region-items');\r\n          const icon   = header.querySelector('i');\r\n\r\n          items.style.display = '';\r\n          header.classList.remove('closed');\r\n          icon.classList.add('omni-chevron-up');\r\n          icon.classList.remove('omni-chevron-down');\r\n        }\r\n\r\n        selectedInput.checked = true;\r\n\r\n        const img = container.querySelector('.checkbox-img');\r\n        if (img) {\r\n          img.src = \"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-on.svg\";\r\n        }\r\n\r\n        footerControl.classList.remove('hidden');\r\n        container.scrollIntoView({ behavior: 'smooth', block: 'center' });\r\n      }\r\n    }\r\n\r\n        // getLatLong();\r\n      });\r\n\r\n  function siteSelectSubmit() {\r\n    document.getElementById('siteList-modal').submit();\r\n  }\r\n\r\n  function siteSelectProceed() {\r\n    document.getElementById('siteSelectButton').classList.add('disabled');\r\n    siteSelectSubmit();\r\n  }\r\n</script>  </div>\r\n</div>\r\n\r\n\r\n<!-- And here  --><div id=\"youtubeEmbed\" class=\"overflow-hidden hidden\">\r\n  <div class=\"fixed inset-0 flex items-center justify-center z-50\">\r\n    <div id=\"backgroundOverlay\" class=\"absolute inset-0 bg-black/70 backdrop-blur-sm pointer-events-none\"></div>\r\n    <div class=\"relative p-6 rounded shadow-lg z-10\">\r\n      <div id=\"youtubeIframe\" class=\"mb-2\">\r\n      </div>\r\n      <div class=\"\">\r\n        <button onclick=\"closeYoutubeVideo()\" class=\"btn-solid-yellow w-full\" onClick=\"closeRemoveFavouriteModal();return false;\">Close</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div> \r\n<div class=\"main-container movieHeader relative\"\r\n     style=\"background-image:url('/filmimages/still/105535.jpg');\r\n            background-size:cover;\r\n            background-repeat:no-repeat;\r\n            background-position:center;\">\r\n\r\n      <img\r\n      onclick=\"playYoutubeVideo('r9l2gHVDnMQ')\"\r\n      src=\"/public/assets/svgs/play-circle.svg\"\r\n      alt=\"Play video\"\r\n      class=\"hidden md:block absolute inset-0 m-auto w-16 h-16 md:w-20 md:h-20 z-20 cursor-pointer\"\r\n    />\r\n  \r\n  <div class=\"graident absolute inset-0 z-10\"></div>\r\n\r\n  <div class=\"pb-mid movieHeader-content md:h-[360px] relative z-20\">\r\n    \r\n    <div class=\"pt-10 mb-7 block md:hidden\">\r\n      <a onclick=\"navigateBack()\" class=\"text-ompYellow flex items-center align-center\">\r\n        <i class=\"text-ompYellow icon omni-chevron-left pr-2 header-navigation\"></i>\r\n        <p class=\"text-ompYellow header-navigation\">Back</p>\r\n      </a>\r\n    </div>\r\n\r\n    <div class=\"md:absolute md:bottom-0\">\r\n      <div>\r\n        <p class=\"showtime-title\">Moana</p>\r\n      </div>\r\n\r\n      <div class=\"mb-3 flex items-center\">\r\n        <img class=\"showtime-age-rating-img min-w-[30px]\" src=\"/images/ratings/UK_PG.png\">\r\n        <p class=\"text ml-2\">|  1hr 55min</p>\r\n        <p class=\"text ml-2\">| Action, Adventure</p>\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n</div>\r\n<div class=\"main-container\">\r\n  <div class=\"moviesCard my-big\">\r\n   <div class=\"mb-4\">\r\n     <p class=\"text\">Disney's highly-anticipated live-action reimagining of Moana, starring Catherine Laga'aia as Moana and Dwayne Johnson, who reprises his role as the trickster demigod Maui.</p>\r\n   </div>\r\n   \r\n   <div class=\"mb-4\">   \r\n     <p class=\"text\"><b>Starring:</b> Catherine Laga'aia, Dwayne Johnson, John Tui</p>\r\n   </div>\r\n   \r\n    <div class=\"mb-4\">\r\n      <p class=\"text\"><b>Director:</b> Thomas Kail</p>\r\n    </div>\r\n     \r\n\r\n<div class=\"video_player mb-mid block md:hidden\">\r\n    <iframe width=\"100%\" height=\"auto\" \r\n      src=\"https://www.youtube.com/embed/r9l2gHVDnMQ?si=iZx_nCgb4TAspxtj\" \r\n      title=\"Moana\" \r\n      frameborder=\"0\" \r\n      allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" \r\n      referrerpolicy=\"strict-origin-when-cross-origin\" \r\n      allowfullscreen>\r\n    </iframe>\r\n  </div>\r\n    \r\n  </div>\r\n</div>\r\n\r\n<div id=\"filterControlls\" class=\"sticky top-0 z-[30]\">\r\n    <script>updateSearch('EVENT', '2026-09-26');refreshSearch();</script>\r\n      \r\n  <div id=\"filterControlls-dates\" class=\"main-container-full bg-ompGray-dates\" style=\"padding-left: 0 !important; padding-right: 0 !important; \">\r\n    <div id=\"dateNav\" class=\"date-nav-container mb-mid md:justify-around\" style=\"\">\r\n                <button type=\"button\" class=\"date-nav-item active\" data-date=\"2026-09-26\">\r\n            <span>Saturday</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-09-27\">\r\n            <span>Sunday</span>\r\n          </button>\r\n                <button type=\"button\" class=\"date-nav-item\" data-date=\"calendar\" onclick=\"showDateCalendar(); return false;\">\r\n          <span>\r\n            Choose Date          </span>\r\n        </button>\r\n    </div>\r\n\r\n\r\n\r\n    <!-- <section id=\"dates\" class=\"splide mb-mid py-4 bg-ompGray-slider px-2\">\r\n      <div class=\"splide__track\">\r\n        <ul class=\"splide__list\">\r\n                   \r\n            <li class=\"splide__slide date-item active\">\r\n              <a data-target=\"0\" onClick=\"updateSearch('DATE', '2026-09-26');refreshSearch();\">Saturday</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"1\" onClick=\"updateSearch('DATE', '2026-09-27');refreshSearch();\">Sunday</a>\r\n            </li> \r\n                    \r\n          <li class=\"splide__slide date-item \" ><a data-target=\"1\" href=\"#\" onClick=\"showDateCalendar(); return false;\">Choose Date</a></li>\r\n        </ul>\r\n      </div>\r\n    </section> -->\r\n  </div>\r\n\r\n  <div id=\"calendarModal\" class=\"hidden\">\r\n    <div class=\"fixed top-0 left-0 inset-0 bg-black/70 backdrop-blur-sm z-[170]\"></div>\r\n    <div class=\"fixed inset-0 flex justify-center items-center z-[180]\">\r\n      <div class=\"rounded-lg shadow-lg p-6 relative\">\r\n        <input type=\"text\" id=\"calendarPicker\" placeholder=\"Select a date\"\r\n              class=\"hidden w-full border border-gray-300 rounded p-2\" />\r\n        <button class=\"btn-solid-yellow mt-4\" onclick=\"closeCalendarModal()\">Close</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <script src=\"/public/js/flatpickr/flatpickr.min.js\"></script>\r\n  <script>\r\n    // Assume allowedDates is provided by PHP as an array of UNIX timestamps\r\n    var defaultDate = \"2026-09-26\";\r\n    const allowedDatesTimestamps = [1790377200000,1790463600000];\r\n    const allowedDates = allowedDatesTimestamps.map(ts => new Date(ts));\r\n    // console.log('DateSelector::AllowedDateCount:2');\r\n    // console.log('DateSelector::CalendarEventCount:1');\r\n    // console.log('DateSelector::AllowedDates:' + allowedDatesTimestamps);\r\n    // console.log('DateSelector::DfltDate:' + defaultDate);\r\n    // console.log('DateSelector::FilterEventCode: 105535');    \r\n    \r\n    if (defaultDate == 0) {\r\n      defaultDate = '';\r\n    }\r\n\r\n    flatpickr(\"#calendarPicker\", {\r\n      inline: true,\r\n      enable: allowedDates,\r\n      dateFormat: \"Y-m-d\",\r\n      defaultDate: defaultDate,\r\n      onChange: function(selectedDates, dateStr, instance) {\r\n        console.log(\"Selected date:\", dateStr);\r\n        calendarDateChange(dateStr);\r\n        // Optionally, automatically close the modal after selection:\r\n        // closeCalendarModal();\r\n      }\r\n    });\r\n    \r\n  </script>\r\n\r\n  <script> \r\n    var slideIndex = 0;\r\n    console.log(slideIndex);\r\n    \r\n    // document.addEventListener('DOMContentLoaded', function() {\r\n    //   var dates = new Splide('#dates', {\r\n    //     type: 'slide',\r\n    //     perPage: 6, // Default: Fully show only 3 slides at a time\r\n    //     perMove: 1, // Move one slide at a time\r\n    //     gap: '5px', // Space between slides\r\n    //     arrows: false, // Hide arrows\r\n    //     pagination: false, // Hide pagination\r\n    //     trimSpace: false, // Prevents unwanted cropping\r\n    //     autoHeight: true, // Adjusts height to content dynamically\r\n    //     rewind: false, // Prevents bouncing back to the first slide\r\n    //     snap: true, // Forces snap to the closest slide\r\n    //     drag: true, // Prevents flick scrolling through multiple items quickly\r\n    //     wheel: false, // Disables fast scrolling with mouse wheel\r\n    //     //focus: 'center',\r\n    //     breakpoints: {\r\n    //       1200: {\r\n    //         perPage: 6\r\n    //       }, // Show 5 slides on larger screens\r\n    //       900: {\r\n    //         perPage: 4\r\n    //       }, // Show 4 slides on medium screens\r\n    //       600: {\r\n    //         perPage: 3\r\n    //       }, // Default: 3 slides on smaller screens\r\n    //     },\r\n    //   });\r\n    \r\n    //   dates.on('mounted', function () {\r\n    //     // Wait for a short timeout to let layout settle\r\n    //     setTimeout(() => {\r\n    //       dates.go(slideIndex);\r\n    //     }, 0); // You can try increasing this to 50–100ms if needed\r\n    //   });\r\n    \r\n    //   // dates.mount();\r\n      \r\n    //   // Log current index on load\r\n    //   console.log('Starting slide index:', dates.index);\r\n    //   console.log('Starting slide selected:', slideIndex);\r\n    \r\n    //   // Log index whenever slide moves\r\n    //   dates.on('moved', function (newIndex) {\r\n    //     console.log('Now showing slide index:', newIndex);\r\n    //   });\r\n    \r\n    //   // Log all slide elements with their indexes\r\n    //   var slides = dates.Components.Slides.get();\r\n    //   slides.forEach((slideObj, index) => {\r\n    //     console.log(`Slide ${index}:`, slideObj.slide.textContent.trim());\r\n    //   });\r\n    // });\r\n    document.addEventListener(\"DOMContentLoaded\", function() {\r\n      const searchBar = document.querySelector(\"#filterControlls-search\");\r\n      const filterControls = document.querySelector(\"#filterControlls\");\r\n      var scrollPos = 0;\r\n      window.addEventListener(\"scroll\", function() {\r\n        let scrollTop = window.scrollY || document.documentElement.scrollTop;\r\n        // let filterTop = filterControls.getBoundingClientRect().top;\r\n        \r\n        if (searchBar != null) {\r\n          // searchBar.classList.remove(\"hidden\");\r\n          // if (filterTop <= 35) {\r\n          //   // searchBar.classList.add(\"hidden\");\r\n          // }\r\n        }\r\n      });\r\n    });\r\n\r\n    document.addEventListener('DOMContentLoaded', () => {\r\n  const nav      = document.getElementById('dateNav');\r\n  if (!nav) return;\r\n\r\n  const items    = Array.from(nav.querySelectorAll('.date-nav-item'));\r\n  const sections = items.map(btn =>\r\n    document.querySelector(`[data-date-section=\"${btn.dataset.date}\"]`)\r\n  );\r\n\r\n  // Flag to ignore clicks that were actually drags\r\n  let suppressNavClick = false;\r\n\r\n  function setActive(idx) {\r\n    items.forEach((b,i) => b.classList.toggle('active', i === idx));\r\n  }\r\n\r\n  function centerNavItem(btn) {\r\n    const navRect = nav.getBoundingClientRect();\r\n    const btnRect = btn.getBoundingClientRect();\r\n    const offset  = btnRect.left\r\n                  - navRect.left\r\n                  - (navRect.width / 2)\r\n                  + (btnRect.width / 2);\r\n    nav.scrollBy({ left: offset, behavior: 'smooth' });\r\n  }\r\n\r\n  items.forEach((btn, idx) => {\r\n    btn.addEventListener('click', () => {\r\n      if (suppressNavClick) return;\r\n\r\n      if (btn.dataset.date === 'calendar') {\r\n        showDateCalendar();\r\n        return;\r\n      }\r\n\r\n      sections[idx]?.scrollIntoView({ behavior: 'smooth', block: 'start' });\r\n\r\n      // highlight + center in the nav\r\n      setActive(idx);\r\n      centerNavItem(btn);\r\n\r\n      // run your filters\r\n      updateSearch('DATE', btn.dataset.date);\r\n      refreshSearch();\r\n    });\r\n  });\r\n\r\n  const observer = new IntersectionObserver((entries) => {\r\n    entries.forEach(ent => {\r\n      if (ent.isIntersecting) {\r\n        const idx = sections.findIndex(sec => sec === ent.target);\r\n        if (idx >= 0) {\r\n          setActive(idx);\r\n          centerNavItem(items[idx]);\r\n        }\r\n      }\r\n    });\r\n  }, {\r\n    rootMargin: '-30% 0px -70% 0px',\r\n    threshold: 0\r\n  });\r\n\r\n  sections.forEach(sec => sec && observer.observe(sec));\r\n\r\n  const initialIdx = items.findIndex(b => b.classList.contains('active'));\r\n  if (initialIdx >= 0) centerNavItem(items[initialIdx]);\r\n\r\n  // --- drag-to-scroll (mouse + touch) that DOESN'T break clicks ---\r\n  (function enableDragScroll(container) {\r\n    let isDown = false;\r\n    let startX = 0;\r\n    let startScrollLeft = 0;\r\n    let dragging = false;\r\n\r\n    const DRAG_THRESHOLD = 10; // px\r\n\r\n    container.style.cursor = 'grab';\r\n\r\n    container.addEventListener('pointerdown', (e) => {\r\n      if (e.pointerType === 'mouse' && e.button !== 0) return;\r\n\r\n      isDown = true;\r\n      dragging = false;\r\n      startX = e.clientX;\r\n      startScrollLeft = container.scrollLeft;\r\n\r\n      container.style.cursor = 'grabbing';\r\n    });\r\n\r\n    container.addEventListener('pointermove', (e) => {\r\n      if (!isDown) return;\r\n\r\n      const dx = e.clientX - startX;\r\n\r\n      if (!dragging && Math.abs(dx) > DRAG_THRESHOLD) {\r\n        dragging = true;\r\n      }\r\n\r\n      if (dragging) {\r\n        if (e.cancelable) e.preventDefault();\r\n        container.scrollLeft = startScrollLeft - dx;\r\n      }\r\n    }, { passive: false });\r\n\r\n    container.addEventListener('pointerup', () => {\r\n      isDown = false;\r\n      container.style.cursor = 'grab';\r\n\r\n      if (dragging) {\r\n        suppressNavClick = true;\r\n        setTimeout(() => { suppressNavClick = false; }, 0);\r\n      }\r\n    });\r\n\r\n    container.addEventListener('pointercancel', () => {\r\n      isDown = false;\r\n      container.style.cursor = 'grab';\r\n    });\r\n  })(nav);\r\n});\r\n\r\n  </script>  </div>\r\n<div class=\"main-container\">\r\n  <div class=\"w-full grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2\">\r\n    </div> \r\n</div>\r\n\r\n<script>\r\ndocument.addEventListener(\"DOMContentLoaded\", function() {\r\n  const videos = document.querySelectorAll(\".lazy-video\");\r\n\r\n  const observer = new IntersectionObserver(entries => {\r\n    entries.forEach(entry => {\r\n      // Adjust threshold as needed (here, 33% visible)\r\n      if (entry.intersectionRatio > 0.33) {\r\n        if (entry.target.paused) entry.target.play();\r\n      } else {\r\n        if (!entry.target.paused) entry.target.pause();\r\n      }\r\n    });\r\n  }, {\r\n    threshold: [0.33]\r\n  });\r\n\r\n  videos.forEach(video => observer.observe(video));\r\n});\r\n\r\ndocument.addEventListener(\"DOMContentLoaded\", function() {\r\n  let videos = document.querySelectorAll(\".lazy-video\");\r\n  \r\n  //----------------------------------\r\n  function checkVisibility(video) {\r\n    let rect = video.getBoundingClientRect();\r\n    let windowHeight = window.innerHeight;\r\n    let topThirdEnd = windowHeight / 3; // 1/3 of the screen height\r\n\r\n    return rect.top >= 0 && rect.top < topThirdEnd;\r\n  }\r\n\r\n  //----------------------------------\r\n  function handleScroll() {\r\n    console.log('LazyVideo::handleScroll');\r\n    videos.forEach(video => {\r\n      if (checkVisibility(video)) {\r\n        if (video.paused) {\r\n          video.play();\r\n        }\r\n      } else {\r\n        if (!video.paused) {\r\n          video.pause();\r\n        }\r\n      }\r\n    });\r\n  }\r\n\r\n  // Ensure the video does not go fullscreen when touched\r\n  videos.forEach(video => {\r\n    video.setAttribute(\"webkit-playsinline\", \"\");\r\n    video.setAttribute(\"playsinline\", \"\");\r\n\r\n    video.addEventListener(\"touchstart\", (e) => {\r\n      //e.preventDefault();\r\n      video.play();\r\n    });\r\n\r\n    // Prevent fullscreen behavior\r\n    video.addEventListener(\"play\", function() {\r\n      setTimeout(() => {\r\n        if (document.fullscreenElement || document.webkitFullscreenElement) {\r\n          document.exitFullscreen?.();\r\n          document.webkitExitFullscreen?.();\r\n        }\r\n      }, 100);\r\n    });\r\n  });\r\n\r\n  window.addEventListener(\"scroll\", handleScroll);\r\n  window.addEventListener(\"resize\", handleScroll);\r\n  handleScroll(); // Run once on load\r\n});\r\n</script>   \r\n<div id=\"footerContact\" class=\"bg-[#282828] mt-8\">\r\n  <div class=\"w-full text-center py-8\">\r\n    <h4 class=\"text-ompYellow text-2xl font-bold\">Need help?</h4>\r\n    <p class=\"\">Get in touch with your local cinema now:</p>\r\n    <div class=\"input-container mb-4 main-container mt-4\">\r\n      <div class=\"input-select mx-auto w-full md:w-2/3 lg:w-1/2\">\r\n        <select id=\"conactlocalCinema\" name=\"sitecode\" class=\"select-input\">\r\n          <option value=\"\" disabled selected>Choose Cinema</option>\r\n          <optgroup style=\"font-weight:900;font-size:13px;\" label=\"England\"><option value=\"OMP_BIRM\" id=\"birmingham-great-park\" data-thissite=\"OMP_BIRM\" data-sitecode=\"OMP_SUTT\">&nbsp;Birmingham - Great Park</option>\r\n<option value=\"OMP_HIWY\" id=\"high-wycombe\" data-thissite=\"OMP_HIWY\" data-sitecode=\"OMP_SUTT\">&nbsp;High Wycombe</option>\r\n<option value=\"OMP_IPSW\" id=\"ipswich\" data-thissite=\"OMP_IPSW\" data-sitecode=\"OMP_SUTT\">&nbsp;Ipswich</option>\r\n<option value=\"OMP_SUND\" id=\"sunderland\" data-thissite=\"OMP_SUND\" data-sitecode=\"OMP_SUTT\">&nbsp;Sunderland</option>\r\n<option selected=\"selected\" value=\"OMP_SUTT\" id=\"sutton\" data-thissite=\"OMP_SUTT\" data-sitecode=\"OMP_SUTT\">&nbsp;Sutton Surrey</option>\r\n<option value=\"OMP_WIGA\" id=\"wigan\" data-thissite=\"OMP_WIGA\" data-sitecode=\"OMP_SUTT\">&nbsp;Wigan</option>\r\n</optgroup><optgroup style=\"font-weight:900;font-size:13px;\" label=\"Scotland\"><option value=\"OMP_CLYD\" id=\"glasgow-clydebank\" data-thissite=\"OMP_CLYD\" data-sitecode=\"OMP_SUTT\">&nbsp;Clydebank</option>\r\n<option value=\"OMP_GLAS\" id=\"glasgow-renfrew-street\" data-thissite=\"OMP_GLAS\" data-sitecode=\"OMP_SUTT\">&nbsp;Glasgow - Renfrew Street</option>\r\n</optgroup><optgroup style=\"font-weight:900;font-size:13px;\" label=\"Northern Ireland\"><option value=\"OMP_ANTR\" id=\"antrim\" data-thissite=\"OMP_ANTR\" data-sitecode=\"OMP_SUTT\">&nbsp;Antrim</option>\r\n<option value=\"OMP_BANB\" id=\"banbridge\" data-thissite=\"OMP_BANB\" data-sitecode=\"OMP_SUTT\">&nbsp;Banbridge</option>\r\n<option value=\"OMP_BANG\" id=\"bangor\" data-thissite=\"OMP_BANG\" data-sitecode=\"OMP_SUTT\">&nbsp;Bangor</option>\r\n<option value=\"OMP_DUDO\" id=\"belfast\" data-thissite=\"OMP_DUDO\" data-sitecode=\"OMP_SUTT\">&nbsp;Belfast - Dundonald</option>\r\n<option value=\"OMP_KENN\" id=\"kennedy-centre\" data-thissite=\"OMP_KENN\" data-sitecode=\"OMP_SUTT\">&nbsp;Belfast - Kennedy Centre</option>\r\n<option value=\"OMP_CARR\" id=\"carrickfergus\" data-thissite=\"OMP_CARR\" data-sitecode=\"OMP_SUTT\">&nbsp;Carrickfergus</option>\r\n<option value=\"OMP_CRAI\" id=\"craigavon\" data-thissite=\"OMP_CRAI\" data-sitecode=\"OMP_SUTT\">&nbsp;Craigavon</option>\r\n<option value=\"OMP_DERR\" id=\"derry\" data-thissite=\"OMP_DERR\" data-sitecode=\"OMP_SUTT\">&nbsp;Derry</option>\r\n<option value=\"OMP_DOWN\" id=\"downpatrick\" data-thissite=\"OMP_DOWN\" data-sitecode=\"OMP_SUTT\">&nbsp;Downpatrick</option>\r\n<option value=\"OMP_DUGA\" id=\"dungannon\" data-thissite=\"OMP_DUGA\" data-sitecode=\"OMP_SUTT\">&nbsp;Dungannon</option>\r\n<option value=\"OMP_LARN\" id=\"larne\" data-thissite=\"OMP_LARN\" data-sitecode=\"OMP_SUTT\">&nbsp;Larne</option>\r\n<option value=\"OMP_LISB\" id=\"lisburn\" data-thissite=\"OMP_LISB\" data-sitecode=\"OMP_SUTT\">&nbsp;Lisburn</option>\r\n<option value=\"OMP_NEWR\" id=\"newry\" data-thissite=\"OMP_NEWR\" data-sitecode=\"OMP_SUTT\">&nbsp;Newry</option>\r\n<option value=\"OMP_OMAG\" id=\"omagh\" data-thissite=\"OMP_OMAG\" data-sitecode=\"OMP_SUTT\">&nbsp;Omagh</option>\r\n</optgroup><optgroup style=\"font-weight:900;font-size:13px;\" label=\"Rep. of Ireland\"><option value=\"OMP_ARKL\" id=\"arklow\" data-thissite=\"OMP_ARKL\" data-sitecode=\"OMP_SUTT\">&nbsp;Arklow</option>\r\n<option value=\"OMP_BALL\" id=\"ballinasloe\" data-thissite=\"OMP_BALL\" data-sitecode=\"OMP_SUTT\">&nbsp;Ballinasloe</option>\r\n<option value=\"OMP_CARL\" id=\"carlow\" data-thissite=\"OMP_CARL\" data-sitecode=\"OMP_SUTT\">&nbsp;Carlow</option>\r\n<option value=\"OMP_MAHO\" id=\"cork\" data-thissite=\"OMP_MAHO\" data-sitecode=\"OMP_SUTT\">&nbsp;Cork</option>\r\n<option value=\"OMP_SCOT\" id=\"drogheda-scotch-hall\" data-thissite=\"OMP_SCOT\" data-sitecode=\"OMP_SUTT\">&nbsp;Drogheda - Scotch Hall</option>\r\n<option value=\"OMP_BALB\" id=\"balbriggan\" data-thissite=\"OMP_BALB\" data-sitecode=\"OMP_SUTT\">&nbsp;Dublin - Balbriggan</option>\r\n<option value=\"OMP_NUTG\" id=\"nutgrove\" data-thissite=\"OMP_NUTG\" data-sitecode=\"OMP_SUTT\">&nbsp;Dublin - Nutgrove</option>\r\n<option value=\"OMP_RATH\" id=\"dublin-rathmines\" data-thissite=\"OMP_RATH\" data-sitecode=\"OMP_SUTT\">&nbsp;Dublin - Rathmines</option>\r\n<option value=\"OMP_DUND\" id=\"dundalk\" data-thissite=\"OMP_DUND\" data-sitecode=\"OMP_SUTT\">&nbsp;Dundalk</option>\r\n<option value=\"OMP_GALW\" id=\"galway\" data-thissite=\"OMP_GALW\" data-sitecode=\"OMP_SUTT\">&nbsp;Galway - Salthill</option>\r\n<option value=\"OMP_KILL\" id=\"killarney\" data-thissite=\"OMP_KILL\" data-sitecode=\"OMP_SUTT\">&nbsp;Killarney</option>\r\n<option value=\"OMP_LIME\" id=\"limerick\" data-thissite=\"OMP_LIME\" data-sitecode=\"OMP_SUTT\">&nbsp;Limerick</option>\r\n<option value=\"OMP_LONG\" id=\"longford\" data-thissite=\"OMP_LONG\" data-sitecode=\"OMP_SUTT\">&nbsp;Longford</option>\r\n<option value=\"OMP_MONA\" id=\"monaghan\" data-thissite=\"OMP_MONA\" data-sitecode=\"OMP_SUTT\">&nbsp;Monaghan</option>\r\n<option value=\"OMP_MULL\" id=\"mullingar\" data-thissite=\"OMP_MULL\" data-sitecode=\"OMP_SUTT\">&nbsp;Mullingar</option>\r\n<option value=\"OMP_NENA\" id=\"nenagh\" data-thissite=\"OMP_NENA\" data-sitecode=\"OMP_SUTT\">&nbsp;Nenagh</option>\r\n<option value=\"OMP_ROSC\" id=\"roscommon\" data-thissite=\"OMP_ROSC\" data-sitecode=\"OMP_SUTT\">&nbsp;Roscommon</option>\r\n<option value=\"OMP_SHAN\" id=\"shannon\" data-thissite=\"OMP_SHAN\" data-sitecode=\"OMP_SUTT\">&nbsp;Shannon</option>\r\n<option value=\"OMP_SLIG\" id=\"sligo\" data-thissite=\"OMP_SLIG\" data-sitecode=\"OMP_SUTT\">&nbsp;Sligo</option>\r\n<option value=\"OMP_TRAL\" id=\"tralee\" data-thissite=\"OMP_TRAL\" data-sitecode=\"OMP_SUTT\">&nbsp;Tralee</option>\r\n<option value=\"OMP_WATE\" id=\"waterford\" data-thissite=\"OMP_WATE\" data-sitecode=\"OMP_SUTT\">&nbsp;Waterford</option>\r\n<option value=\"OMP_WEXF\" id=\"wexford\" data-thissite=\"OMP_WEXF\" data-sitecode=\"OMP_SUTT\">&nbsp;Wexford</option>\r\n</optgroup> \r\n        </select>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n<div id=\"footerNav\" class=\"bg-[#191919] py-mid\">\r\n  <div id=\"footerContainer\" class=\"main-container py-8 px-4\">\r\n    <footer class=\"grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-16 text-left md:text-center text-white\">\r\n              <div id=\"footerColumn1\" class=\"space-y-8\">\r\n                      <div>\r\n                              <h4 class=\"mb-1 font-semibold text-white\">\r\n                  Contact Us                </h4>\r\n              \r\n              <ul class=\"space-y-1\">\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/contact\"\"\r\n                                          >\r\n                      Get in touch                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 !text-ompYellow\"\r\n                      href=\"/ticketchanges/home\"\"\r\n                                          >\r\n                      Ticket changes                    </a>\r\n                  </li>\r\n                              </ul>\r\n            </div>\r\n                      <div>\r\n                              <h4 class=\"mb-1 font-semibold text-white\">\r\n                  Customer Information                </h4>\r\n              \r\n              <ul class=\"space-y-1\">\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/about\"\"\r\n                                          >\r\n                      About Us                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/faq\"\"\r\n                                          >\r\n                      FAQs                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/accessibility\"\"\r\n                                          >\r\n                      Accessibility                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/parking\"\"\r\n                                          >\r\n                      Parking                    </a>\r\n                  </li>\r\n                              </ul>\r\n            </div>\r\n                      <div>\r\n              \r\n              <ul class=\"space-y-1\">\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/terms\"\"\r\n                                          >\r\n                      Terms & Conditions                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/privacy\"\"\r\n                                          >\r\n                      Privacy Policy                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      \"\r\n                      onclick=\"showCookiePolicy(true)\"                    >\r\n                      Manage Cookies                    </a>\r\n                  </li>\r\n                              </ul>\r\n            </div>\r\n                  </div>\r\n              <div id=\"footerColumn2\" class=\"space-y-8\">\r\n                      <div>\r\n                              <h4 class=\"mb-1 font-semibold text-white\">\r\n                  Omniplex Cinemas                </h4>\r\n              \r\n              <ul class=\"space-y-1\">\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/explore/careers\"\"\r\n                                          >\r\n                      Careers