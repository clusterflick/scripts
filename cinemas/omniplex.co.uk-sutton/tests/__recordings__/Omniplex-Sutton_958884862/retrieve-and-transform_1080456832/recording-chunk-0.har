w-light/5 shadow-lg backdrop-blur-sm p-4 rounded-lg gap-4 xl:gap-8\">\r\n    <div class=\"hidden md:block col-span-1 md:col-span-1 lg:col-span-2 xl:col-span-2\">\r\n    <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n      <img\r\n        src=\"/cms/The Amazing Digital Circus The Last Act Web Poster (1).webp\"\r\n        alt=\"The Amazing Digital Circus: The Last Act Event poster\"\r\n        class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n        data-eventCode=\"109934\"\r\n        data-eventCode=\"The Amazing Digital Circus: The Last Act\"\r\n      />\r\n              <img\r\n          onclick=\"playYoutubeVideo('vNGAtHBhdiM')\"\r\n          src=\"/public/assets/svgs/play-circle.svg\"\r\n          alt=\"Play Trailler\"\r\n          class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n        />\r\n          </div>\r\n  </div>\r\n  <div class=\"md:col-span-5 lg:col-span-5 xl:col-span-8\">\r\n    <div class=\"grid grid-cols-3 md:grid-cols-5 gap-4 items-start\">\r\n      <!-- A (Mobile) -->\r\n      <div class=\"md:hidden col-span-1\">\r\n        <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n          <img\r\n            src=\"/cms/The Amazing Digital Circus The Last Act Web Poster (1).webp\"\r\n            alt=\"The Amazing Digital Circus: The Last Act Event poster\"\r\n            class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n            data-eventCode=\"109934\"\r\n            data-eventCode=\"The Amazing Digital Circus: The Last Act\"\r\n          />\r\n                      <img\r\n              onclick=\"playYoutubeVideo('vNGAtHBhdiM')\"\r\n              src=\"/public/assets/svgs/play-circle.svg\"\r\n              alt=\"Play Trailler\"\r\n              class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n            />\r\n                  </div>\r\n      </div>\r\n      <!-- B -->\r\n      <div class=\"col-span-2 md:col-span-5\">\r\n        <div class=\"w-full\">\r\n          <div class=\"flex justify-between items-start w-full mb-2\">\r\n            <p class=\"font-medium text-lg sm:text-2xl md:text-3xl leading-snug sm:leading-tight md:leading-tight mr-4\">\r\n              <a href=\"/cinema/movie/sutton/the-amazing-digital-circus-the-last-act\">\r\n                The Amazing Digital Circus: The Last Act              </a>\r\n            </p>\r\n            <img data-toggle=\"0\" id=\"favourite109934\" onClick=\"toggleFavourite('109934');return false;\" src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_favourited-off.svg\" class=\"w-4 mt-2 mx-3\" alt=\"Add to Favourites\" />  \r\n          </div>\r\n          <div class=\"flex items-center gap-2 mb-2\">\r\n            <div class=\"flex flex-col md:flex-row gap-4\">\r\n              <div class=\"flex items-center gap-2\">\r\n                <img src=\"/images/ratings/UK_12A.png\" class=\"w-4\" />\r\n                <p class=\"text-base leading-snug font-normal leading-none\">Animation, Drama, Thriller</p>\r\n              </div>\r\n              <p class=\"mb-2 md:m-auto flex item-center\"><span class=\"hidden md:flex mr-2\">|</span> 1hr 33min </p>\r\n            </div>\r\n          </div>\r\n          \r\n            <p class=\"hidden md:block mb-2 pt-2\">\r\n              <span class=\"synopsis-short\">\r\n                The viral internet sensation The Amazing Digital Circus comes to its long-awaited conclusion in a feature-length theatrical release! This Last Act combines episode 8 with the all new, hour long episode 9 for fans to see before anyone else in the worl...              </span>\r\n\r\n                              <span class=\"synopsis-full hidden text-base\">\r\n                  The viral internet sensation The Amazing Digital Circus comes to its long-awaited conclusion in a feature-length theatrical release! This Last Act combines episode 8 with the all new, hour long episode 9 for fans to see before anyone else in the world. With Caine gone and the circus dark, the cast are left with only the mistakes and traumas of their pasts to keep them company. As the prospect of eternity closes in around them, they discover the truth about the Digital Circus and its history. Will they come to terms with what they uncover, or will they make the other choice? Also, presumably at some point someone says something funny, because this ending can?t be THAT depressing, can it?                </span>\r\n\r\n                <button \r\n                  type=\"button\"\r\n                  class=\"ml-2 text-ompYellow underline text-base\"\r\n                  onclick=\"toggleSynopsis(this)\"\r\n                >\r\n                  See more\r\n                </button>\r\n                          </p>\r\n          <div class=\"hallTypeIcon hidden\">\r\n                                  </div>\r\n        </div>\r\n      </div>\r\n      <!-- C -->\r\n      <div class=\"col-span-3 md:col-span-5 md:col-start-1\">\r\n        <div class=\"w-full grid grid-cols-1 md:grid-cols-2 sm:col-span-2 xl:grid-cols-3  gap-2\">\r\n          <a aria-label=\"The Amazing Digital Circus: The Last Act at 14:30 in Screen 4\" href=\"https://www.omniplexcinemas.co.uk/booking/seats/sutton/41281\" class=\"\"> \r\n<div id=\"perf_0\" class=\"showTimeBox bg-ompGray-times p-2 col-span-1 rounded-xl\">\r\n  <div class=\"topSection flex justify-between items-end\">\r\n    <div class=\"flex items-end\">\r\n      <div class=\"flex items-baseline\">\r\n        <h4 class=\"bigText mr-1 leading-none\" aria-label=\"The Amazing Digital Circus: The Last Act at 14:30 in Screen 4\">\r\n          14:30        </h4>\r\n        <p class=\"smallText leading-none\" aria-label=\"The Amazing Digital Circus: The Last Act starts at 14:30 and ends at 16:03\">\r\n          - 16:03        </p>\r\n      </div>\r\n    </div>\r\n    <div class=\"flex items-end\">\r\n              <div class=\"flex items-baseline\">\r\n          <p class=\"smallText mr-1 leading-none\" aria-label=\"