ractical Magic 2\"\r\n      />\r\n              <img\r\n          onclick=\"playYoutubeVideo('Ho10_4IX1jE')\"\r\n          src=\"/public/assets/svgs/play-circle.svg\"\r\n          alt=\"Play Trailler\"\r\n          class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n        />\r\n          </div>\r\n  </div>\r\n  <div class=\"md:col-span-5 lg:col-span-5 xl:col-span-8\">\r\n    <div class=\"grid grid-cols-3 md:grid-cols-5 gap-4 items-start\">\r\n      <!-- A (Mobile) -->\r\n      <div class=\"md:hidden col-span-1\">\r\n        <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n          <img\r\n            src=\"/cms/Practical Magic 2 Web Poster.webp\"\r\n            alt=\"Practical Magic 2 Event poster\"\r\n            class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n            data-eventCode=\"110084\"\r\n            data-eventCode=\"Practical Magic 2\"\r\n          />\r\n                      <img\r\n              onclick=\"playYoutubeVideo('Ho10_4IX1jE')\"\r\n              src=\"/public/assets/svgs/play-circle.svg\"\r\n              alt=\"Play Trailler\"\r\n              class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n            />\r\n                  </div>\r\n      </div>\r\n      <!-- B -->\r\n      <div class=\"col-span-2 md:col-span-5\">\r\n        <div class=\"w-full\">\r\n          <div class=\"flex justify-between items-start w-full mb-2\">\r\n            <p class=\"font-medium text-lg sm:text-2xl md:text-3xl leading-snug sm:leading-tight md:leading-tight mr-4\">\r\n              <a href=\"/cinema/movie/sutton/practical-magic-2\">\r\n                Practical Magic 2              </a>\r\n            </p>\r\n            <img data-toggle=\"0\" id=\"favourite110084\" onClick=\"toggleFavourite('110084');return false;\" src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_favourited-off.svg\" class=\"w-4 mt-2 mx-3\" alt=\"Add to Favourites\" />  \r\n          </div>\r\n          <div class=\"flex items-center gap-2 mb-2\">\r\n            <div class=\"flex flex-col md:flex-row gap-4\">\r\n              <div class=\"flex items-center gap-2\">\r\n                <img src=\"/images/ratings/UK_12A.png\" class=\"w-4 min-w-[30px]\" />\r\n                <p class=\"text-base leading-snug font-normal leading-none\">Comedy</p>\r\n              </div>\r\n              <p class=\"mb-2 md:m-auto flex item-center\"><span class=\"hidden md:flex mr-2\">|</span> 2hrs 10min </p>\r\n            </div>\r\n          </div>\r\n          \r\n            <p class=\"hidden md:block mb-2 pt-2\">\r\n              <span class=\"synopsis-short\">\r\n                Practical Magic 2 brings audiences back to the enchanting world of the Owens family more than 25 years after the original film became a cult favourite. Released in 1998, Practical Magic starred Sandra Bullock and Nicole Kidman as sisters Sally and Gi...              </span>\r\n\r\n                              <span class=\"synopsis-full hidden text-base\">\r\n                  Practical Magic 2 brings audiences back to the enchanting world of the Owens family more than 25 years after the original film became a cult favourite. Released in 1998, Practical Magic starred Sandra Bullock and Nicole Kidman as sisters Sally and Gillian Owens?descendants of a long line of witches cursed so that any man they fall in love with is doomed to die. Although the film received mixed reviews on release, it gradually built a devoted fanbase through television, streaming and word of mouth, becoming one of the most beloved witch-themed films ever made thanks to its unique blend of romance, fantasy, humour and female empowerment. The sequel reunites Bullock and Kidman, with both stars also serving as producers, and sees them return to the magical Owens family decades later as a new generation begins to discover the mysterious powers?and dangers?that run through their bloodline.\r\n\r\nSo why a sequel now? In recent years the original film has experienced a huge resurgence in popularity, especially during the Halloween season where it has become something of an annual viewing tradition for many fans. That renewed interest?combined with Hollywood?s growing appetite for nostalgic legacy sequels?helped finally bring the long-discussed follow-up to life. The film is being directed by Susanne Bier, who previously worked with Sandra Bullock on the hit Netflix thriller Bird Box, and draws inspiration from author Alice Hoffman?s later novels set in the Owens universe, which expanded the family?s magical mythology far beyond the original story. With its mix of romance, witchcraft and sisterhood, Practical Magic 2 aims to recapture the charm that made the first film endure for a generation while introducing a new chapter in the spellbinding story of the Owens women.                </span>\r\n\r\n                <button \r\n                  type=\"button\"\r\n                  class=\"ml-2 text-ompYellow underline text-base\"\r\n                  onclick=\"toggleSynopsis(this)\"\r\n                >\r\n                  See more\r\n                </button>\r\n                          </p>\r\n          <div class=\"hallTypeIcon hidden\">\r\n                                  </div>\r\n        </div>\r\n      </div>\r\n      <!-- C -->\r\n      <div class=\"col-span-3 md:col-span-5 md:col-start-1\">\r\n        <div class=\"w-full grid grid-cols-1 md:grid-cols-2 sm:col-span-2 xl:grid-cols-3  gap-2\">\r\n          <a aria-label=\"Practical Magic 2 at 14:00 in Screen 1\" href=\"https://www.omniplexcinemas.co.uk/booking/seats/sutton/48352\" class=\"\"> \r\n<div id=\"perf_0\" class=\"showTimeBox bg-ompGray-times p-2 col-span-1 rounded-xl\">\r\n  <div class=\"topSection flex justify-between items-end\">\r\n    <div class=\"flex items-end\">\r\n      <div class=\"flex items-baseline\">\r\n        <h4 class=\"bigText mr-1 leading-none\" aria-label=\"Practical Magic 2 at 14:00 in Screen 1\">\r\n          14:00        </h4>\r\n        <p class=\"smallText leading-none\" aria-label=\"Practical Magic 2 starts at 14:00 and ends at 16:10\">\r\n          - 16:10        </p>\r\n      </div>\r\n    </div>\r\n    <div class=\"flex items-end\">\r\n              <div class=\"flex items-baseline\">\r\n          <p class=\"smallText mr-1 leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            From\r\n          </p>\r\n          <h4 class=\"bigText leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            &pound;6.95          </h4>\r\n        </div>\r\n          </div>\r\n  </div>\r\n  <div class=\"midSection flex justify-between items-baseline\">\r\n\r\n    <div class=\"mb-2\"></div>\r\n  </div>\r\n  <div class=\"bottomSection flex items-center justify-between gap-2\">\r\n    <div class=\"shrink-0\">\r\n      <p class=\"smallText\">\r\n        Screen 1      </p>\r\n    </div>\r\n    <div class=\"flex flex-1 min-w-0 justify-end overflow-hidden\">\r\n      <div class=\"flex min-w-0 max-w-full items-center justify-end gap-2\"> \r\n                      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n</a><a aria-label=\"Practical Magic 2 at 16:40 in Screen 11\" href=\"https://www.omniplexcinemas.co.uk/booking/seats/sutton/48373\" class=\"\"> \r\n<div id=\"perf_1\" class=\"showTimeBox bg-ompGray-times p-2 col-span-1 rounded-xl\">\r\n  <div class=\"topSection flex justify-between items-end\">\r\n    <div class=\"flex items-end\">\r\n      <div class=\"flex items-baseline\">\r\n        <h4 class=\"bigText mr-1 leading-none\" aria-label=\"Practical Magic 2 at 16:40 in Screen 11\">\r\n          16:40        </h4>\r\n        <p class=\"smallText leading-none\" aria-label=\"Practical Magic 2 starts at 16:40 and ends at 18:50\">\r\n          - 18:50        </p>\r\n      </div>\r\n    </div>\r\n    <div class=\"flex items-end\">\r\n              <div class=\"flex items-baseline\">\r\n          <p class=\"smallText mr-1 leading-none\" aria-label=\"Cost starti