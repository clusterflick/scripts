            "text": "<html>\r\n  <head>\r\n    <title>UK Cinema Listings & Tickets | Omniplex</title>\r\n    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=iso-8859-1\" />\r\n    <meta name=\"name\" content=\"Experience the magic of cinema at Omniplex. Discover the latest blockbusters in stunning 2D, 3D, MAXX, and Recline screens. Book your tickets online now!\" />\r\n    <meta name=\"description\" content=\"Experience the magic of cinema at Omniplex. Discover the latest blockbusters in stunning 2D, 3D, MAXX, and Recline screens. Book your tickets online now!\" />\r\n    <meta name=\"keywords\" content=\"Omniplex Cinemas, Cinema in Ireland, Cinema, Movies, Films, MAXX Movies, 3D Movies, Book Tickets, Cinema Tickets, Cinema Times, Movies Times\" />\r\n    <meta name=\"author\" content=\"Collaborative Software Limited\" />\r\n    <meta name=\"copyright\" content=\"Collaborative Software Limited\" />\r\n        <meta name=\"robots\" content=\"index,follow\" />\r\n    \r\n    <meta charset=\"UTF-8\">\r\n    <meta content=\"IE=Edge\" http-equiv=\"X-UA-Compatible\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n\r\n    <meta data-a1serv=\"omniweb10\" />\r\n    <meta data-a1php=\"8.0.27\" />\r\n    <meta data-a1phptime=\"20260921 20:25:22\" />\r\n    <meta data-a1mysqltime=\"20260921 20:25:22\" />\r\n    \r\n    <meta data-lat=\"\" />\r\n    <meta data-lon=\"\" />\r\n    \r\n    <meta name=\"twitter:card\" content=\"summary\" />\r\n    <meta name=\"twitter:site\" content=\"\" />\r\n    <meta name=\"twitter:creator\" content=\"\" />\r\n    <meta property=\"og:title\" content=\"UK Cinema Listings & Tickets | Omniplex\" />\r\n    <meta property=\"og:description\" content=\"Experience the magic of cinema at Omniplex. Discover the latest blockbusters in stunning 2D, 3D, MAXX, and Recline screens. Book your tickets online now!\" />\r\n    <meta property=\"og:type\" content=\"website\" />\r\n    <meta property=\"og:url\" content=\"https://www.omniplexcinemas.co.uk/cinema/showtimes/sutton?action=processFilters&filterDate=2026-09-24\" />\r\n    <meta property=\"og:image\" content=\"https://www.omniplexcinemas.co.uk/images/icons/omniOG.jpg\" />\r\n    <meta property=\"og:image:type\" content=\"image/jpeg\" />\r\n    <meta property=\"og:image:width\" content=\"1200\" />\r\n    <meta property=\"og:image:height\" content=\"1200\" />\r\n    <meta property=\"og:site_name\" content=\"Omniplex Cinemas\" />\r\n\r\n    <link rel=\"apple-touch-icon\" sizes=\"57x57\" href=\"https://www.omniplexcinemas.co.uk/images/icons/apple-touch-icon-57x57.png?v=20260713_01\">\r\n    <link rel=\"apple-touch-icon\" sizes=\"60x60\" href=\"https://www.omniplexcinemas.co.uk/images/icons/apple-touch-icon-60x60.png?v=20260713_01\">\r\n    <link rel=\"apple-touch-icon\" sizes=\"72x72\" href=\"https://www.omniplexcinemas.co.uk/images/icons/apple-touch-icon-72x72.png?v=20260713_01\">\r\n    <link rel=\"apple-touch-icon\" sizes=\"76x76\" href=\"https://www.omniplexcinemas.co.uk/images/icons/apple-touch-icon-76x76.png?v=20260713_01\">\r\n    <link rel=\"apple-touch-icon\" sizes=\"114x114\" href=\"https://www.omniplexcinemas.co.uk/images/icons/apple-touch-icon-114x114.png?v=20260713_01\">\r\n    <link rel=\"apple-touch-icon\" sizes=\"120x120\" href=\"https://www.omniplexcinemas.co.uk/images/icons/apple-touch-icon-120x120.png?v=20260713_01\">\r\n    <link rel=\"apple-touch-icon\" sizes=\"144x144\" href=\"https://www.omniplexcinemas.co.uk/images/icons/apple-touch-icon-144x144.png?v=20260713_01\">\r\n    <link rel=\"apple-touch-icon\" sizes=\"152x152\" href=\"https://www.omniplexcinemas.co.uk/images/icons/apple-touch-icon-152x152.png?v=20260713_01\">\r\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"https://www.omniplexcinemas.co.uk/images/icons/apple-touch-icon-180x180.png?v=20260713_01\">\r\n    <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"https://www.omniplexcinemas.co.uk/images/icons/favicon-32x32.png?v=20260713_01\">\r\n    <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"https://www.omniplexcinemas.co.uk/images/icons/favicon-16x16.png?v=20260713_01\">\r\n    <link rel=\"manifest\" href=\"https://www.omniplexcinemas.co.uk/images/icons/manifest.json?v=20260713_01\">\r\n    <link rel=\"mask-icon\" href=\"https://www.omniplexcinemas.co.uk/images/icons/safari-pinned-tab.svg?v=20260713_01\" color=\"#ffea00\">\r\n    <link rel=\"shortcut icon\" href=\"https://www.omniplexcinemas.co.uk/images/icons/favicon.ico\">\r\n\r\n    <meta name=\"apple-mobile-web-app-title\" content=\"Omniplex Cinemas\">\r\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" />\r\n    <meta name=\"application-name\" content=\"Omniplex Cinemas\">\r\n    <meta name=\"theme-color\" content=\"#FFEA00\" />\r\n    <meta name=\"msapplication-TileColor\" content=\"#383738\">\r\n    <meta name=\"msapplication-TileImage\" content=\"https://www.omniplexcinemas.co.uk/images/icons/mstile-144x144.png?v=20260713_01\">\r\n\r\n        \r\n\r\n    <link rel=\"stylesheet\" href=\"/public/js/flatpickr/flatpickr.min.css\">\r\n    <link href=\"/stylesheet.css?v=20260921_02\" rel=\"stylesheet\">\r\n\r\n    <link rel=\"stylesheet\" href=\"\\public\\js\\libaries\\splide-4.1.3\\dist\\css\\splide.min.css\">\r\n    <script type=\"text/javascript\" src=\"\\public\\js\\libaries\\splide-4.1.3\\dist\\js\\splide.min.js\"></script>\r\n    <script type=\"text/javascript\" src=\"\\public\\js\\components\\dateselector.js?v=20260907_01\"></script>\r\n    <script type=\"text/javascript\" src=\"\\public\\js\\libaries\\jquery\\jquery-3.2.1.min.js\"></script>\r\n    <script type=\"text/javascript\" src=\"\\public\\js\\libaries\\jquery\\jQuery.print.js\"></script>\r\n    \r\n</head>\r\n<!-- START -- Google tag (gtag.js) ---------------------------- --> \r\n <!-- <script async src=\"https://www.googletagmanager.com/gtag/js?id=G-10238KM80X\"></script> <script> window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-10238KM80X'); </script> -->\r\n <!-- END  -- Google tag (gtag.js) ---------------------------- --> \r\n<script>\r\nfunction goToHome() {\r\n  window.location.href = '/cinema/showtimes';\r\n}\r\n\r\nvar GlobalNavigateBackLocation = '/cinema/showtimes';\r\n</script>\r\n<script>\r\n//----------------------------\r\n// todo : need to review how location works\r\n//if (navigator.geolocation) {\r\n//\tnavigator.geolocation.getCurrentPosition(handleLatLonPosition);\r\n//}\r\n\r\n//----------------------------\r\nfunction handleLatLonPosition(pos) {\r\n\tvar requestURL = '/api/internalapi/?action=setLatLon&lat=' + pos.coords.latitude + '&lng=' + pos.coords.longitude;\r\n\tconsole.log('API: ' + requestURL);\r\n  \t    \r\n\tvar request = $.ajax({\r\n    url: requestURL,\r\n    type: \"get\",\r\n\t\tasync: false,\r\n    data: {}\r\n  });\r\n\t\r\n  request.done(function(response, textStatus, jqXHR){\r\n    console.log('Lat/Lon Stored');\t\t\t\t\t\t\r\n  });\r\n}\r\n</script>    <body class=\" bg-ompGray-ompdark main-bg  text-white min-h-screen\">\r\n        <div id=\"genericOverlay\" class=\"fixed top-0 left-0 inset-0 bg-black/70 backdrop-blur-sm z-[170] hidden\"></div>\r\n    <div id=\"desktopHeader\" class=\"!hidden md:!block relative z-50 my-2\">\r\n      <header class=\"main-container-header w-full text-white\">\r\n        <div class=\"mx-auto flex justify-center h-14 max-w-7xl items-center\">\r\n          <a href=\"/\" class=\"flex items-center\">\r\n            <img src=\"/public/assets/branding/omniplex_logo.png\" class=\"h-9\" alt=\"Omniplex Logo\" />\r\n          </a>\r\n          <nav class=\"flex mx-4 justify-end flex-1 items-center text-sm gap-1 md:gap-2 lg:ml-8 lg:gap-4\">\r\n            <div class=\"\">\r\n                            <a href=\"/cinema/showtimes\" class=\"hidden lg:inline-block header-navigation px-2 py-1 text-white/80 hover:text-white active\">\r\n                Showtimes              </a>\r\n\r\n              <a href=\"/cinema/showtimes\" class=\"inline-block lg:hidden header-navigation px-2 py-1 text-white/80 hover:text-white active\">\r\n                Showtimes              </a>\r\n              \r\n                            <a href=\"/cinema/movies\" class=\"hidden lg:inline-block header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Trailers              </a>\r\n\r\n              <a href=\"/cinema/movies\" class=\"inline-block lg:hidden header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Trailers              </a>\r\n              \r\n                            <a href=\"/cinema/events\" class=\"hidden lg:inline-block header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Events              </a>\r\n\r\n              <a href=\"/cinema/events\" class=\"inline-block lg:hidden header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Events              </a>\r\n              \r\n                            <a href=\"/cinema/kids\" class=\"hidden lg:inline-block header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Kids &amp; Family              </a>\r\n\r\n              <a href=\"/cinema/kids\" class=\"inline-block lg:hidden header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Kids              </a>\r\n              \r\n                            <a href=\"/booking/extras-home\" class=\"hidden lg:inline-block header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Food              </a>\r\n\r\n              <a href=\"/booking/extras-home\" class=\"inline-block lg:hidden header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Food              </a>\r\n              \r\n                            <a href=\"/company/about\" class=\"hidden lg:inline-block header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Our Cinema              </a>\r\n\r\n              <a href=\"/company/about\" class=\"inline-block lg:hidden header-navigation px-2 py-1 text-white/80 hover:text-white \">\r\n                Our Cinema              </a>\r\n              \r\n                          </div>\r\n          </nav>\r\n          <div class=\"flex items-center gap-2\">\r\n                        <a class=\"rounded p-1\" href=\"/account/login\">\r\n              <i class=\"icon omni-user-circle text-[24px] \"></i>\r\n            </a>\r\n            <!-- myomnipass -->\r\n                         <a href=\"/account/login\" class=\"p-1  hidden lg:block\">\r\n              <img src=\"/public/assets/branding/omnipass.png\" class=\"h-6\" alt=\"Omnipass\" />\r\n            </a>\r\n            <a href=\"/account/login\" class=\"p-1 block lg:hidden\">\r\n              <img src=\"/public/assets/branding/mobile-omnipass.svg\" class=\"h-8\" alt=\"Omnipass\" />\r\n            </a>\r\n                      </div>\r\n        </div>\r\n        \r\n      </header>\r\n    </div>\r\n\r\n    <div id=\"mobibleHeader\" class=\"block md:hidden  relative my-2 z-50\">\r\n            <header id=\"standard-menu\" class=\"flex items-center justify-between p-4 relative\">\r\n        <div class=\"text-white focus:outline-none flex items-center justify-between flex-1\">\r\n          <button id=\"menuButton\" class=\"text-white focus:outline-none\">\r\n            <i class=\"a1-application-menu-burger text-[24px] \"></i>\r\n          </button>\r\n          <p>&nbsp;</p>\r\n        </div>\r\n        <a href=\"/\" class=\"shrink-0\">\r\n          <img src=\"/public/assets/branding/omniplex_logo.png\" class=\"w-1/2 mx-auto block w-[114px]\" />\r\n        </a>\r\n        <div class=\"text-white focus:outline-none flex items-center gap-2 flex-1 flex justify-end\">\r\n                    <a class=\"rounded p-1\" href=\"/account/login\">\r\n            <i class=\"icon omni-user-circle text-[24px] \"></i>\r\n          </a>\r\n          <a href=\"/account/login\">\r\n            <!-- <i class=\"icon omni-user-circle text-[24px] \"></i> -->\r\n            <img src=\"/public/assets/branding/myomnipass-sm.png\" class=\"h-8\" alt=\"Omnipass\" />\r\n          </a>\r\n        </div>\r\n      </header>\r\n      <div id=\"menu\"\r\n    class=\"main-bg inset-0 text-white bg-black fixed transform -translate-x-full transition-transform duration-300 ease-in-out z-50 \"\r\n    style=\"z-index:99999;\">\r\n    <button onclick=\"closeModal()\" id=\"closeButton\" class=\"w-full px-4 block relative text-right mt-8 mb-4\">\r\n      <i class=\"icon omni-close text-xl\"></i>\r\n    </button>\r\n    <nav class=\"px-4 h-full overflow-scroll\">\r\n      <div class=\"mb-8 border-b border-1 border-white\">\r\n        <p class=\"mb-2 menu-location-title\">Preferred location: </p>\r\n        <div class=\"flex items-center\"><a href=\"/cinema/site\" class=\"js-site-link\"><span class=\"menu-location pr-1 py-1 text-2xl font-semibold\">Sutton Surrey</span><i class=\"icon omni-chevron-down mx-1 text-xl cursor-pointer\"></i></a></div>        <a class=\"block text-base my-2 py-4\" href=\"/company/about\">Our Cinema</a>\r\n      </div>\r\n      <ul id=\"menu-items\" class=\"text-lg\">\r\n                        <li class=\"menu-item pb-4\">\r\n          <a href=\"/ticketchanges/home\" class=\"block text-ompYellow \">\r\n            Ticket Changes            <!-- <div style=\"height: 8\"></div> -->\r\n          </a>\r\n        </li>\r\n                                  <li class=\"menu-item pb-4\">\r\n          <a href=\"/booking/extras-home\" class=\"block  \">\r\n            Food            <!-- <div style=\"height: 8\"></div> -->\r\n          </a>\r\n        </li>\r\n                                  <li class=\"menu-item pb-4\">\r\n          <a href=\"/cinema/kids\" class=\"block  \">\r\n            Kids            <!-- <div style=\"height: 8\"></div> -->\r\n          </a>\r\n        </li>\r\n                                  <li class=\"menu-item pb-4\">\r\n          <a href=\"/cinema/events\" class=\"block  \">\r\n            Events            <!-- <div style=\"height: 8\"></div> -->\r\n          </a>\r\n        </li>\r\n                                      <li class=\"menu-drop pb-4\">\r\n              <button onclick=\"toggleDropdown('dropdown')\"\r\n                class=\"w-full text-left flex justify-between items-center \">\r\n                Gift Cards                <i class=\"icon omni-chevron-down\"></i>\r\n              </button>\r\n              <ul id=\"dropdown\" style=\"margin-bottom: 16px\" class=\"hidden my-small pl-4 space-y-2\">\r\n                                <li class=\"!my-small\">\r\n                  <a href=\"/giftcards/choose\">\r\n                    Buy an e-gift card                  </a>\r\n                </li>\r\n                                <li class=\"!my-small\">\r\n                  <a href=\"/giftcards/balance\">\r\n                    Check gift card amount                  </a>\r\n                </li>\r\n                                <!-- <div style=\"height: 8\"></div> -->\r\n              </ul>\r\n            </li>\r\n                                      <li class=\"menu-drop pb-4\">\r\n              <button onclick=\"toggleDropdown('dropdown1')\"\r\n                class=\"w-full text-left flex justify-between items-center \">\r\n                Help                <i class=\"icon omni-chevron-down\"></i>\r\n              </button>\r\n              <ul id=\"dropdown1\" style=\"margin-bottom: 16px\" class=\"hidden my-small pl-4 space-y-2\">\r\n                                <li class=\"!my-small\">\r\n                  <a href=\"/company/faq\">\r\n                    Frequently asked questions                  </a>\r\n                </li>\r\n                                <li class=\"!my-small\">\r\n                  <a href=\"/company/contact\">\r\n                    Contact us                  </a>\r\n                </li>\r\n                                <!-- <div style=\"height: 8\"></div> -->\r\n              </ul>\r\n            </li>\r\n                                  <li class=\"menu-item pb-4\">\r\n          <a href=\"/account/login\" class=\"block  font-bold\">\r\n            Sign in to My Account <br/> <span class=\"font-normal\">(my tickets, food orders)</span>            <!-- <div style=\"height: 8\"></div> -->\r\n          </a>\r\n        </li>\r\n                                  <li class=\"menu-item pb-4\">\r\n          <a href=\"/join/landing\" class=\"block  font-bold\">\r\n            Create an Account            <!-- <div style=\"height: 8\"></div> -->\r\n          </a>\r\n        </li>\r\n                        </ul>\r\n    </nav>\r\n  </div>          </div>\r\n  <!-- Filter Slider -->\r\n<div id=\"filter\"\r\n  class=\"main-bg fixed top-0 right-0 h-full\r\n         w-full sm:w-3/4 md:w-1/2 lg:w-1/3 xl:w-1/4\r\n         text-white transform transition-transform duration-300 ease-in-out\r\n         z-[172] flex flex-col translate-x-full opacity-100\">\r\n  <form id=\"searchFilterForm\" method=\"GET\" action=\"\" class=\"flex flex-col h-full\">\r\n    <input type=\"hidden\" name=\"action\" value=\"processFilters\">\r\n    <input type=\"hidden\" name=\"filterDate\" />    \r\n    \r\n    <!-- Header: Fixed Back Button -->\r\n    <div class=\"px-6 mt-6\">\r\n      <button id=\"closeFilterButton\" class=\"mb-6\">\r\n        <a class=\"text-ompYellow flex items-center\">\r\n          <i class=\"text-ompYellow icon omni-chevron-left pr-2 header-navigation\"></i>\r\n          <p class=\"text-ompYellow header-navigation\">Back</p>\r\n        </a>\r\n      </button>\r\n    </div>\r\n\r\n    <!-- Scrollable Filter Content -->\r\n    <div class=\"flex-grow overflow-y-auto px-8\">\r\n      <h2 class=\"text-lg font-bold mb-4\">Filters</h2>\r\n      \r\n            \r\n        <div class=\"mb-big\">\r\n          <h3 class=\"text-md font-semibold\">Time of day</h3>\r\n          <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"daytimeFilter\" class=\"cursor-pointer\">Daytime (Before 5pm)</label>\r\n              <input type=\"checkbox\" id=\"daytimeFilter\" name=\"daytimeFilter\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n          <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"eveningFilter\" class=\"cursor-pointer\">Evening (After 5pm)</label>\r\n              <input type=\"checkbox\" id=\"eveningFilter\" name=\"eveningFilter\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n        </div>\r\n              <div class=\"mb-big\">\r\n          <h3 class=\"text-md font-semibold\">Age Rating</h3>\r\n\r\n          <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"ageRatingUPGFilter\" class=\"cursor-pointer font-medium\">U</label>\r\n              <input type=\"checkbox\" id=\"ageRatingUPGFilter\" name=\"age_u_g\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n\r\n          <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"ageRatingUPGFilter\" class=\"cursor-pointer font-medium\">PG</label>\r\n              <input type=\"checkbox\" id=\"ageRatingUPGFilter\" name=\"age_pg\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n\r\n          <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"ageRating12aFilter\" class=\"cursor-pointer font-medium\">12/12A</label>\r\n              <input type=\"checkbox\" id=\"ageRating12aFilter\" name=\"age_12_12a\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n\r\n                      <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n              <div class=\"flex items-center justify-between w-full\">\r\n                <label for=\"ageRating15Filter\" class=\"cursor-pointer font-medium\">15</label>\r\n                <input type=\"checkbox\" id=\"ageRating15Filter\" name=\"age_15\" class=\"hidden\" >\r\n                                  <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                              </div>\r\n            </div>\r\n          \r\n          \r\n          <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"ageRating18Filter\" class=\"cursor-pointer font-medium\">18</label>\r\n              <input type=\"checkbox\" id=\"ageRating18Filter\" name=\"age_18\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n        </div>\r\n            \r\n        <!-- <div class=\"mb-big\">\r\n          <h3 class=\"text-md font-semibold\">Genre</h3>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Action\" class=\"cursor-pointer\">Action (9)</label>\r\n              <input type=\"checkbox\" id=\"genre_Action\" name=\"genre_Action\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Adventure\" class=\"cursor-pointer\">Adventure (9)</label>\r\n              <input type=\"checkbox\" id=\"genre_Adventure\" name=\"genre_Adventure\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Animation\" class=\"cursor-pointer\">Animation (4)</label>\r\n              <input type=\"checkbox\" id=\"genre_Animation\" name=\"genre_Animation\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Comedy\" class=\"cursor-pointer\">Comedy (4)</label>\r\n              <input type=\"checkbox\" id=\"genre_Comedy\" name=\"genre_Comedy\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Documentary\" class=\"cursor-pointer\">Documentary (1)</label>\r\n              <input type=\"checkbox\" id=\"genre_Documentary\" name=\"genre_Documentary\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Drama\" class=\"cursor-pointer\">Drama (7)</label>\r\n              <input type=\"checkbox\" id=\"genre_Drama\" name=\"genre_Drama\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Event\" class=\"cursor-pointer\">Event (15)</label>\r\n              <input type=\"checkbox\" id=\"genre_Event\" name=\"genre_Event\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Family\" class=\"cursor-pointer\">Family (1)</label>\r\n              <input type=\"checkbox\" id=\"genre_Family\" name=\"genre_Family\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Fantasy\" class=\"cursor-pointer\">Fantasy (3)</label>\r\n              <input type=\"checkbox\" id=\"genre_Fantasy\" name=\"genre_Fantasy\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Horror\" class=\"cursor-pointer\">Horror (3)</label>\r\n              <input type=\"checkbox\" id=\"genre_Horror\" name=\"genre_Horror\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Romance\" class=\"cursor-pointer\">Romance (1)</label>\r\n              <input type=\"checkbox\" id=\"genre_Romance\" name=\"genre_Romance\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Sci-Fi\" class=\"cursor-pointer\">Sci-Fi (4)</label>\r\n              <input type=\"checkbox\" id=\"genre_Sci-Fi\" name=\"genre_Sci-Fi\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n                    <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n            <div class=\"flex items-center justify-between w-full\">\r\n              <label for=\"genre_Thriller\" class=\"cursor-pointer\">Thriller (7)</label>\r\n              <input type=\"checkbox\" id=\"genre_Thriller\" name=\"genre_Thriller\" class=\"hidden\" >\r\n                              <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                          </div>\r\n          </div>\r\n              \r\n        </div> -->\r\n            \r\n      <div class=\"mb-big\">\r\n        <h3 class=\"text-md font-semibold\">Accessibility Options</h3>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-audio-described\"></i>\r\n              <label for=\"audioDescriptionFilter\" class=\"cursor-pointer font-medium\">Audio Description</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"audioDescriptionFilter\" name=\"access_audioDescription\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Grab a headset and enjoy detailed screen descriptions. <a href=\"/filters/audiodescribed\" class=\"text-ompYellow\">Learn more</a></p> \r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-sensory-friendly-56\"></i>\r\n              <label for=\"sensoryFriendlyFilter\" class=\"cursor-pointer font-medium\">Sensory Friendly</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"sensoryFriendlyFilter\" name=\"access_sensoryFriendly\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Held every weekend around noon at all Omniplex cinemas. <a href=\"/filters/sensoryfriendly\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>        \r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-subtitles\"></i>\r\n              <label for=\"subtitledFilter\" class=\"cursor-pointer font-medium\">Subtitled</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"subtitledFilter\" name=\"access_subtitled\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Available for blockbuster movies on Monday evenings. <a href=\"/filters/subtitled\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>        \r\n      </div>      \r\n          \r\n      <div class=\"mb-big\">\r\n        <h3 class=\"text-md font-semibold\">Special Screenings</h3>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-kids-club\"></i>\r\n              <label for=\"kidsClubFilter\" class=\"cursor-pointer font-medium\">Kids Club</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"kidsClubFilter\" name=\"special_kidsClub\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Save on select family films every weekend. <a href=\"/filters/kidsclub\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>\r\n        <!-- Seniors Club  -->\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <img src=\"/public/assets/svgs/seniorClub_icon.svg\" class=\"w-4 h-4 mr-2\">\r\n              <label for=\"seniorClubFilter\" class=\"cursor-pointer font-medium\">Senior Club Screening</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"seniorClubFilter\" name=\"special_seniorClub\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Held every Wednesday in early afternoon shopwtimes. <a href=\"/filters/seniorsclub\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-secret-screeningss\"></i>\r\n              <label for=\"secretScreenFilter\" class=\"cursor-pointer font-medium\">Secret Screenings</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"secretScreenFilter\" name=\"special_secretScreen\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">You'll know the genre, but the movie is a surprise! <a href=\"/filters/secretscreenings\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-live-and-eventss\"></i>\r\n              <label for=\"liveEventsFilter\" class=\"cursor-pointer font-medium\">Live &amp; Events</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"liveEventsFilter\" name=\"special_liveEvents\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Watch pre-recorded and live events from around the world on the big screen. <a href=\"/filters/liveevents\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-star-full\"></i>\r\n              <label for=\"classicsFilter\" class=\"cursor-pointer font-medium\">Classics</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"classicsFilter\" name=\"special_classics\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Relive fan-favourite classics on the big screen every month.</p>\r\n        </div>\r\n        <div class=\"filter-checkbox py-4 px-3 my-2 bg-ompGray-times\">\r\n          <div class=\"flex items-center justify-between w-full\">\r\n            <div class=\"flex gap-x-2 items-center\">\r\n              <i class=\"icon omni-kids-club\"></i>\r\n              <label for=\"parentbabyFilter\" class=\"cursor-pointer font-medium\">Parent &amp; Baby</label>\r\n            </div>\r\n            <input type=\"checkbox\" id=\"parentbabyFilter\" name=\"special_parentbaby\" class=\"hidden\" >\r\n                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-6 h-6 mr-2\">\r\n                      </div>\r\n          <p class=\"pt-1\">Wednesdays for movie time with your little one! <a href=\"#\" class=\"text-ompYellow\">Learn more</a></p>\r\n        </div>        \r\n      </div>    \r\n        </div>\r\n    \r\n    <!-- Footer: Fixed Bottom Buttons -->\r\n    <div class=\"px-8 py-4 bg-black border-t border-gray-700\">\r\n      <div class=\"flex justify-between\">\r\n        <button id=\"clearFilters\" class=\"mx-2 w-full bg-gray-600 px-4 py-2 rounded text-white\">Clear all</button>\r\n        <button id=\"applyFilters\" class=\"mx-2 w-full bg-ompYellow px-4 py-2 rounded text-black\">Apply</button>\r\n      </div>\r\n    </div>\r\n  </form>\r\n</div><!-- Info Start  -->\r\n<!-- Info End  -->\r\n\r\n<!-- Success Alert Start  -->\r\n<!-- Success Alert End  -->\r\n\r\n<!-- Error Alert Start  -->\r\n<!-- Error Alert End  -->\r\n\r\n<script>\r\ndocument.addEventListener(\"DOMContentLoaded\", function() {\r\n  document.querySelectorAll('.relative').forEach(function(alert) {\r\n    requestAnimationFrame(function() {\r\n      alert.classList.remove('hidden');\r\n      alert.classList.add('block');\r\n    });\r\n  });\r\n  document.querySelectorAll('.close-alert').forEach(function(button) {\r\n    button.addEventListener('click', function() {\r\n      const alertDiv = button.closest('.relative');\r\n      if (alertDiv) {\r\n        alertDiv.classList.remove('block');\r\n        alertDiv.classList.add('hidden');\r\n      }\r\n    });\r\n  });\r\n});\r\n</script>\r\n<!-- Display when user clicks star to remove from watch list  -->\r\n<div id=\"removeFavouriteMovie\" class=\"overflow-hidden hidden\">\r\n  <div class=\"fixed inset-0 flex items-center justify-center z-50\">\r\n    <div id=\"backgroundOverlay\" class=\"absolute inset-0 bg-black opacity-90 pointer-events-none\"></div>\r\n    <div class=\"relative p-6 rounded shadow-lg z-10\">\r\n      <p class=\"mb-4\">Do you want to remove this movie from your Want to Watch List?</p>\r\n      <h2 class=\"text-4xl font-bold my-mid text-center\" id=\"removeFavouriteMovieName\">Stolen</h2>\r\n      <div class=\"\">\r\n        <input type=\"hidden\" id=\"removeFavouriteMovieCode\" value=\"\" />\r\n        <button class=\"btn-solid-yellow mb-4\" onClick=\"removeFavourite();return false;\">Yes, remove from my list</button>\r\n        <button class=\"btn-solid-gray\" onClick=\"closeRemoveFavouriteModal();return false;\">No, go back</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>  \r\n<!-- END - Display when user clicks star to remove from watch list  -->\r\n\r\n\r\n<!-- Display when user selects a different site for food  -->\r\n<div id=\"confirmFoodSite\" class=\"overflow-hidden hidden\">\r\n  <div class=\"fixed inset-0 flex items-center justify-center z-50\">\r\n    <div id=\"backgroundOverlay\" class=\"absolute inset-0 bg-black/70 backdrop-blur-sm pointer-events-none\"></div>\r\n    <div class=\"relative p-6 rounded shadow-lg z-10 bg-ompGray rounded-lg\">\r\n            <p class=\"mb-4\">You are ordering food for collection at</p>\r\n      <h2 class=\"text-4xl font-bold my-mid text-center\" id=\"closeConfirmFoodSiteName\">Site Name</h2>\r\n      <div class=\"\">\r\n      <button class=\"btn-solid-yellow mb-2\" onClick=\"sumbitForm()\">Confirm</button>\r\n      <button class=\"btn-solid-gray\" onClick=\"closeConfirmFoodSite();return false;\">No, go back</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>  \r\n<!-- END - Display when user selects a different site for food  -->\r\n\r\n\r\n<!-- Display when user selects a different site for food  -->\r\n<div id=\"cancelMembership\" class=\"overflow-hidden hidden\">\r\n  <div class=\"fixed inset-0 flex items-center justify-center z-50\">\r\n    <div id=\"backgroundOverlay\" class=\"absolute inset-0 bg-black/70 backdrop-blur-sm pointer-events-none\"></div>\r\n    <div class=\"relative p-6 rounded shadow-lg z-10 bg-ompGray rounded-lg\">\r\n      <p class=\"mb-4\">Are you sure you want to cancel your membership?</p>\r\n      <div class=\"\">\r\n        <button class=\"btn-solid-yellow mb-2\" onclick=\"cancelScheme()\">Confirm</button>\r\n        <button class=\"btn-solid-gray\" onClick=\"closeCancelMembership();return false;\">No, go back</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>  \r\n<!-- END - Display when user selects a different site for food  -->  <div class=\"main-container-full block md:hidden mb-mid relative z-[5]\">\r\n    <div class=\"w-full z-50\">\r\n      <div id=\"mobileSliderNav\" class=\"group-nav-container\" style=\"cursor: grab;\">\r\n        <!-- active  -->\r\n                    <button\r\n              onclick=\"navigateTo('/cinema/showtimes')\"\r\n              class=\"group-nav-item active\"\r\n            >\r\n              <p>Showtimes</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/cinema/movies')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Trailers</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/cinema/events')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Events</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/cinema/kids')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Kids &amp; Family</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/booking/extras-home')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Food</p>\r\n            </button>\r\n                    <button\r\n              onclick=\"navigateTo('/company/about')\"\r\n              class=\"group-nav-item \"\r\n            >\r\n              <p>Our Cinema</p>\r\n            </button>\r\n              </div>\r\n    </div>\r\n  </div>\r\n  <script>\r\n    document.addEventListener('DOMContentLoaded', () => {\r\n\r\n      const nav = document.getElementById('mobileSliderNav');\r\n      if (!nav) return;\r\n\r\n      const items = Array.from(nav.querySelectorAll('.group-nav-item'));\r\n      const sections = items.map(btn => document.getElementById(btn.dataset.target));\r\n\r\n      let suppressNavClick = false;\r\n\r\n      // Expose to inline onclick\r\n      window.navigateTo = function(url) {\r\n        if (suppressNavClick) return;\r\n        window.location.href = url;\r\n      };\r\n\r\n      function setActive(activeIdx) {\r\n        items.forEach((btn, i) => {\r\n          btn.classList.toggle('active', i === activeIdx);\r\n        });\r\n      }\r\n\r\n      function centerNavItem(btn, behavior = 'smooth') {\r\n        const desired =\r\n          btn.offsetLeft + (btn.offsetWidth / 2) - (nav.clientWidth / 2);\r\n\r\n        const maxScroll = nav.scrollWidth - nav.clientWidth;\r\n        const clamped = Math.max(0, Math.min(desired, maxScroll));\r\n\r\n        nav.scrollTo({\r\n          left: clamped,\r\n          behavior\r\n        });\r\n      }\r\n\r\n      // Center active item on load\r\n      const initiallyActive = nav.querySelector('.group-nav-item.active');\r\n      if (initiallyActive) centerNavItem(initiallyActive, 'auto');\r\n\r\n      // --- Drag to scroll ---\r\n      (function enableDragScroll(container) {\r\n\r\n        let isDown = false;\r\n        let startX = 0;\r\n        let startScrollLeft = 0;\r\n        let dragging = false;\r\n\r\n        const DRAG_THRESHOLD = 10;\r\n\r\n        container.style.cursor = 'grab';\r\n\r\n        container.addEventListener('pointerdown', (e) => {\r\n          if (e.pointerType === 'mouse' && e.button !== 0) return;\r\n\r\n          isDown = true;\r\n          dragging = false;\r\n          startX = e.clientX;\r\n          startScrollLeft = container.scrollLeft;\r\n\r\n          container.style.cursor = 'grabbing';\r\n        });\r\n\r\n        container.addEventListener('pointermove', (e) => {\r\n          if (!isDown) return;\r\n\r\n          const dx = e.clientX - startX;\r\n\r\n          if (!dragging && Math.abs(dx) > DRAG_THRESHOLD) {\r\n            dragging = true;\r\n          }\r\n\r\n          if (dragging) {\r\n            if (e.cancelable) e.preventDefault();\r\n            container.scrollLeft = startScrollLeft - dx;\r\n          }\r\n\r\n        }, { passive: false });\r\n\r\n        container.addEventListener('pointerup', () => {\r\n          isDown = false;\r\n          container.style.cursor = 'grab';\r\n\r\n          if (dragging) {\r\n            suppressNavClick = true;\r\n            setTimeout(() => {\r\n              suppressNavClick = false;\r\n            }, 0);\r\n          }\r\n        });\r\n\r\n        container.addEventListener('pointercancel', () => {\r\n          isDown = false;\r\n          container.style.cursor = 'grab';\r\n        });\r\n\r\n      })(nav);\r\n\r\n    });\r\n  </script>\r\n\r\n\r\n<!-- Here   -->\r\n\r\n<link rel=\"stylesheet\" href=\"/include/A1CookieManager/css/main.css?v=20260907_01\" type=\"text/css\"> \r\n<div id=\"cookieOverlay\" class=\"OMP_overlay backdrop-blur-sm\" style=\"pointer-events:none;\"></div>\r\n<div id=\"cookieConsentBar\" style=\"display: none;\">\r\n  <div class=\"cookie-consent-banner\">\r\n    <p>We use cookies on our website to personalise and improve your experience and ensure the website works\r\n      correctly.\r\n      <a style=\"text-decoration:underline;\" href=\"/company/privacy#cookieAnchor\" target=\"_blank\">View our Cookie Policy</a>.\r\n    </p>\r\n    <div class=\"cookie-buttons\">\r\n      \r\n    <button id=\"managePrefs\" onclick=\"toggleManage()\" class=\"cookie-button btn-solid-gray !mx-px\" id=\"manage-cookies\">Manage</button>\r\n      <button id=\"savePrefs\" onclick=\"checkCookiePerfs()\" class=\"cookie-button btn-solid-yellow !mx-px\" style=\"display:none;\">Save Preferences</button>\r\n    <button id=\"acceptAll\" onclick=\"setCookieCookie('ALL')\" class=\"cookie-button btn-solid-yellow !mx-px\">Accept All</button>\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"manageOptions\" style=\"display:none;\">\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Necessary</h3>\r\n                      <p>Necessary cookies are required to enable the basic features of this site, such as providing secure log-in or adjusting your consent preferences. These cookies do not store any personally identifiable data.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Necessary\"\r\n                                  checked                                  disabled>\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreNecessary')\">More Details</button>\r\n              <div id=\"moreNecessary\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                                                  <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> a1wcc</li>\r\n                              <li><strong>Duration:</strong> 1 year</li>\r\n                              <li><strong>Description:</strong> Stores the user&rsquo;s consent and preferences for website cookies. This cookie remembers the user&rsquo;s choices regarding the acceptance or rejection of specific cookie categories, ensuring personalized settings are applied on subsequent visits.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> PHPSESSID</li>\r\n                              <li><strong>Duration:</strong> Session</li>\r\n                              <li><strong>Description:</strong> Creates a unique session identifier for each visitor to maintain session data across multiple pages. It does not contain personal information and is deleted when the user closes their browser. This cookie is essential for enabling user functionalities and preferences during the active session.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> __cflb</li>\r\n                              <li><strong>Duration:</strong> 24 hours</li>\r\n                              <li><strong>Description:</strong> CloudFlare&rsquo;s session affinity cookie used to map your session to the correct server.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> sitecode</li>\r\n                              <li><strong>Duration:</strong> 1 hour</li>\r\n                              <li><strong>Description:</strong> The cinema location you have selected.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> omnicustomer</li>\r\n                              <li><strong>Duration:</strong> 2 weeks</li>\r\n                              <li><strong>Description:</strong> A token for the login, if &lsquo;stay logged in&rsquo; is selected.</li>\r\n                          </ul>\r\n                                                      </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Analytics</h3>\r\n                      <p>Analytical cookies are used to understand how visitors interact with the website. These cookies help provide information on metrics such as the number of visitors, bounce rate, traffic source, etc.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Analytics\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreAnalytics')\">More Details</button>\r\n              <div id=\"moreAnalytics\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                                                  <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _ga</li>\r\n                              <li><strong>Duration:</strong> 2 years</li>\r\n                              <li><strong>Description:</strong> Registers a unique ID that is used to generate statistical data on how the visitor uses the website.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _ga_C6EGS4GGTV</li>\r\n                              <li><strong>Duration:</strong> 2 years</li>\r\n                              <li><strong>Description:</strong> Used by Google Analytics to collect data on the number of times a user has visited the website as well as dates for the first and most recent visit.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _ga_Y8PVGSGW5G</li>\r\n                              <li><strong>Duration:</strong> 2 years</li>\r\n                              <li><strong>Description:</strong> Used to persist session state.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _gat_gtag_UA_2532751_2</li>\r\n                              <li><strong>Duration:</strong> 1 minute</li>\r\n                              <li><strong>Description:</strong> Used by Google Analytics to throttle request rate.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _gat_gtag_UA_56401285_6</li>\r\n                              <li><strong>Duration:</strong> 1 minute</li>\r\n                              <li><strong>Description:</strong> Used to throttle request rate.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _gid</li>\r\n                              <li><strong>Duration:</strong> 24 hours</li>\r\n                              <li><strong>Description:</strong> Registers a unique ID that is used to generate statistical data on how the visitor uses the website.</li>\r\n                          </ul>\r\n                                                      </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Functional</h3>\r\n                      <p>Functional cookies help perform certain functionalities like sharing the content of the website on social media platforms, collecting feedback, and other third-party features.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Functional\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreFunctional')\">More Details</button>\r\n              <div id=\"moreFunctional\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Performance</h3>\r\n                      <p>Performance cookies are used to understand and analyze the key performance indexes of the website which helps in delivering a better user experience for the visitors.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Performance\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('morePerformance')\">More Details</button>\r\n              <div id=\"morePerformance\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Advertisement</h3>\r\n                      <p>Advertisement cookies are used to provide visitors with customized advertisements based on the pages you visited previously and to analyze the effectiveness of the ad campaigns.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Advertisement\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreAdvertisement')\">More Details</button>\r\n              <div id=\"moreAdvertisement\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Other</h3>\r\n                      <p>Other uncategorized cookies are those that are being analyzed and have not been classified into a category as yet.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Other\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreOther')\">More Details</button>\r\n              <div id=\"moreOther\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n    </div>\r\n</div>\r\n\r\n<script type=\"text/javascript\" src=\"/include/A1CookieManager/script/main.js?v=20260907_01\"></script>\r\n\r\n<div id=\"siteModal\" class=\"fixed inset-0 z-[60] flex items-center justify-center p-4 hidden\">\r\n  <div class=\"absolute inset-0 bg-black/70 backdrop-blur-sm\"></div>\r\n  <div class=\"relative z-[70] w-full max-w-[640px] h-[85vh]\">\r\n    <style>\r\n  #siteScrollArea {\r\n    -ms-overflow-style: none;\r\n    scrollbar-width: none;\r\n  }\r\n\r\n  #siteScrollArea::-webkit-scrollbar {\r\n    display: none;\r\n  }\r\n</style>\r\n\r\n<div class=\"flex h-full flex-col overflow-hidden rounded-xl bg-[#282828]\">\r\n\r\n  <div class=\"shrink-0 bg-[#282828] px-4 pt-8 pb-4\">\r\n    <div class=\"text-right mb-4 px-4\">\r\n      <i onclick=\"toggleLoginModal()\" class=\"text-ompYellow icon omni-close cursor-pointer\"></i>\r\n    </div>\r\n    <div class=\"w-full md:w-3/4 mx-auto w-full max-w-[560px]\">\r\n      <div id=\"login_section\" class=\"mb-6 w-full\">\r\n        <h1 class=\"text-3xl leading-tight font-normal text-white\">\r\n          Which is your local Omniplex?\r\n        </h1>\r\n      </div>\r\n\r\n      <div class=\"input-search  overflow-hidden rounded-md\">\r\n        <i class=\"icon omni-search text-white/80\"></i>\r\n        <input id=\"search\" placeholder=\"Search\" type=\"text\" class=\"text-white placeholder:text-white/50\" />\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"siteScrollArea\" class=\"flex-1 overflow-y-auto px-4\">\r\n    <div class=\"w-full md:w-3/4 mx-auto w-full max-w-[560px] py-6\">\r\n      <div id=\"site-selection-list\" class=\"border-t border-b border-ompYellow/30 py-4\">\r\n        <form id=\"siteList-modal\">\r\n          \r\n          <div class=\"region-group mb-2\"><div class=\"region-header flex cursor-pointer items-center justify-between py-3\"><p class=\"text-xl text-white\">England</p><i class=\"icon-swtich icon omni-chevron-up text-xl text-white\"></i></div><div class=\"region-items\"><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Birmingham - Great Park</p></div><div><input type=\"checkbox\" value=\"OMP_BIRM\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">High Wycombe</p></div><div><input type=\"checkbox\" value=\"OMP_HIWY\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Ipswich</p></div><div><input type=\"checkbox\" value=\"OMP_IPSW\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Sunderland</p></div><div><input type=\"checkbox\" value=\"OMP_SUND\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Sutton Surrey</p></div><div><input type=\"checkbox\" value=\"OMP_SUTT\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Wigan</p></div><div><input type=\"checkbox\" value=\"OMP_WIGA\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div></div></div><div class=\"region-group mb-2\"><div class=\"region-header flex cursor-pointer items-center justify-between py-3\"><p class=\"text-xl text-white\">Scotland</p><i class=\"icon-swtich icon omni-chevron-up text-xl text-white\"></i></div><div class=\"region-items\"><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Clydebank</p></div><div><input type=\"checkbox\" value=\"OMP_CLYD\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Glasgow - Renfrew Street</p></div><div><input type=\"checkbox\" value=\"OMP_GLAS\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div></div></div><div class=\"region-group mb-2\"><div class=\"region-header flex cursor-pointer items-center justify-between py-3\"><p class=\"text-xl text-white\">Northern Ireland</p><i class=\"icon-swtich icon omni-chevron-up text-xl text-white\"></i></div><div class=\"region-items\"><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Antrim</p></div><div><input type=\"checkbox\" value=\"OMP_ANTR\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Banbridge</p></div><div><input type=\"checkbox\" value=\"OMP_BANB\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Bangor</p></div><div><input type=\"checkbox\" value=\"OMP_BANG\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Belfast - Dundonald</p></div><div><input type=\"checkbox\" value=\"OMP_DUDO\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Belfast - Kennedy Centre</p></div><div><input type=\"checkbox\" value=\"OMP_KENN\" name=\"cinema_item\" class=\"hidden\" /><img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_checkbox-off.svg\" class=\"checkbox-img w-7\" /></div></div><div class=\"site-selection-item my-2 flex cursor-pointer items-center justify-between py-3\"><div><p class=\"text-xl text-white\">Carrickfergus</p></div><div><input type=\"checkbox\" value=\"OMP_CARR