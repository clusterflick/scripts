ance()\" placeholder=\"Movie Search\" type=\"text\" />\r\n              <div class=\"flex absolute bg-ompGray z-[40]\"><ul id=\"performanceList\"><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/star-wars-the-mandalorian-and-grogu\">Star Wars: The Mandalorian and Grogu</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/star-wars-the-mandalorian-and-grogu-3d-\">Star Wars: The Mandalorian and Grogu (3D)</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/backrooms\">Backrooms</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/power-ballad\">Power Ballad</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/michael\">Michael</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/charlie-the-wonderdog\">Charlie The Wonderdog</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/obsession\">Obsession</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-magic-faraway-tree\">The Magic Faraway Tree</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-devil-wears-prada-2\">The Devil Wears Prada 2</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-sheep-detectives\">The Sheep Detectives</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/alices-adventures-in-wonderland-live-the-royal-ballet-26-27\">Alices Adventures In Wonderland - LIVE - The Royal Ballet 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/carmen-live-the-royal-opera-26-27\">Carmen - LIVE- The Royal Opera 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/cosi-fan-tutte-live-the-royal-opera-26-27\">Cosi Fan Tutte - LIVE - The Royal Opera 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/disclosure-day\">Disclosure Day</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/gotterdammerung-live-the-royal-opera-26-27\">Gotterdammerung - LIVE - The Royal Opera 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/k-pop-demon-hunters-a-sing-along-event-\">K-Pop Demon Hunters (A Sing-Along Event)</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/la-fanciulla-del-west-the-met-opera-26-27\">La Fanciulla Del West - The Met Opera 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/les-liaisons-dangereuses-national-theatre\">Les Liaisons Dangereuses - National Theatre</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/macbeth-the-met-opera-2026-27\">Macbeth - The Met Opera 2026-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/manon-live-the-royal-ballet-26-27\">Manon - LIVE - The Royal Ballet 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/masters-of-the-universe\">Masters Of The Universe</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/minions-monsters\">Minions & Monsters</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/romeo-juliet-live-the-royal-ballet-26-27\">Romeo & Juliet - LIVE - The Royal Ballet 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/scary-movie\">Scary Movie</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/supergirl\">Supergirl</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/swan-lake-live-the-royal-ballet-26-27\">Swan Lake - LIVE - The Royal Ballet 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-amazing-digital-circus-the-last-act\">The Amazing Digital Circus: The Last Act</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-nutcracker-live-the-royal-ballet-26-27\">The Nutcracker - LIVE - The Royal Ballet 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/the-super-mario-galaxy-movie\">The Super Mario Galaxy Movie</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/tosca-live-the-royal-opera-26-27\">Tosca - LIVE - The Royal Opera 26-27</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/toy-story-5\">Toy Story 5</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/tuner\">Tuner</a>  </li><li style=\"display: none;\">  <a class=\"p-3 block\" href=\"/cinema/movie/sutton/we-re-nothing-at-all\">We're Nothing at All</a>  </li> </ul> </div>            </div>\r\n            <i id=\"filterButton2\" class=\"icon omni-filter text-ompYellow mx-3 hidden md:block\"></i>\r\n          </div>\r\n        </div>  \r\n      </div>\r\n      <div id=\"\" class=\"\">\r\n        <div id=\"filterControlls-datescon\">\r\n           \r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n<div class=\"sticky top-0  z-[30]\">\r\n    \r\n  <div id=\"filterControlls-dates\" class=\"main-container-full bg-ompGray-dates\" style=\"padding-left: 0 !important; padding-right: 0 !important; \">\r\n    <div id=\"dateNav\" class=\"date-nav-container mb-mid md:justify-around\" style=\"\">\r\n                <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-06-04\">\r\n            <span>Today</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-06-05\">\r\n            <span>Friday</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-06-06\">\r\n            <span>Saturday</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-06-07\">\r\n            <span>Sunday</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-06-08\">\r\n            <span>Monday</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-06-09\">\r\n            <span>Tuesday</span>\r\n          </button>\r\n                  <button type=\"button\" class=\"date-nav-item\" data-date=\"2026-06-10\">\r\n            <span>Wednesday</span>\r\n          </button>\r\n                <button type=\"button\" class=\"date-nav-item active\" data-date=\"calendar\" onclick=\"showDateCalendar(); return false;\">\r\n          <span>\r\n            3rd Jul          </span>\r\n        </button>\r\n    </div>\r\n\r\n\r\n\r\n    <!-- <section id=\"dates\" class=\"splide mb-mid py-4 bg-ompGray-slider px-2\">\r\n      <div class=\"splide__track\">\r\n        <ul class=\"splide__list\">\r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"0\" onClick=\"updateSearch('DATE', '2026-06-04');refreshSearch();\">Today</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"1\" onClick=\"updateSearch('DATE', '2026-06-05');refreshSearch();\">Friday</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"2\" onClick=\"updateSearch('DATE', '2026-06-06');refreshSearch();\">Saturday</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"3\" onClick=\"updateSearch('DATE', '2026-06-07');refreshSearch();\">Sunday</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"4\" onClick=\"updateSearch('DATE', '2026-06-08');refreshSearch();\">Monday</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"5\" onClick=\"updateSearch('DATE', '2026-06-09');refreshSearch();\">Tuesday</a>\r\n            </li> \r\n                   \r\n            <li class=\"splide__slide date-item \">\r\n              <a data-target=\"6\" onClick=\"updateSearch('DATE', '2026-06-10');refreshSearch();\">Wednesday</a>\r\n            </li> \r\n                    \r\n          <li class=\"splide__slide date-item active\" ><a data-target=\"6\" href=\"#\" onClick=\"showDateCalendar(); return false;\">3rd Jul</a></li>\r\n        </ul>\r\n      </div>\r\n    </section> -->\r\n  </div>\r\n\r\n  <div id=\"calendarModal\" class=\"hidden\">\r\n    <div class=\"fixed top-0 left-0 inset-0 bg-black/70 backdrop-blur-sm z-[170]\"></div>\r\n    <div class=\"fixed inset-0 flex justify-center items-center z-[180]\">\r\n      <div class=\"rounded-lg shadow-lg p-6 relative\">\r\n        <input type=\"text\" id=\"calendarPicker\" placeholder=\"Select a date\"\r\n              class=\"hidden w-full border border-gray-300 rounded p-2\" />\r\n        <button class=\"btn-solid-yellow mt-4\" onclick=\"closeCalendarModal()\">Close</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <script src=\"/public/js/flatpickr/flatpickr.min.js\"></script>\r\n  <script>\r\n    // Assume allowedDates is provided by PHP as an array of UNIX timestamps\r\n    var defaultDate = \"2026-07-03\";\r\n    const allowedDatesTimestamps = [1780527600000,1780614000000,1780700400000,1780786800000,1780873200000,1780959600000,1781046000000,1781132400000,1805760000000,1794268800000,1803340800000,1781218800000,1781305200000,1781391600000,1781478000000,1781564400000,1781650800000,1781737200000,1801612800000,1800921600000,1782342000000,1782601200000,1792450800000,1793059200000,1782860400000,1782946800000,1783033200000,1783119600000,1783206000000,1783292400000,1783378800000,1783465200000,1783551600000,1811199600000,1782428400000,1782514800000,1782687600000,1782774000000,1808348400000,1796083200000,1809471600000,1781823600000,1781910000000,1781996400000,1782082800000,1782169200000,1782255600000];\r\n    const allowedDates = allowedDatesTimestamps.map(ts => new Date(ts));\r\n    console.log('DateSelector::AllowedDateCount:47');\r\n    console.log('DateSelector::CalendarEventCount:33');\r\n    console.log('DateSelector::AllowedDates:' + allowedDatesTimestamps);\r\n    console.log('DateSelector::DfltDate:' + defaultDate);\r\n    console.log('DateSelector::FilterEventCode: ');    \r\n    \r\n    if (defaultDate == 0) {\r\n      defaultDate = '';\r\n    }\r\n\r\n    flatpickr(\"#calendarPicker\", {\r\n      inline: true,\r\n      enable: allowedDates,\r\n      dateFormat: \"Y-m-d\",\r\n      defaultDate: defaultDate,\r\n      onChange: function(selectedDates, dateStr, instance) {\r\n        console.log(\"Selected date:\", dateStr);\r\n        calendarDateChange(dateStr);\r\n        // Optionally, automatically close the modal after selection:\r\n        // closeCalendarModal();\r\n      }\r\n    });\r\n    \r\n  </script>\r\n\r\n  <script> \r\n    var slideIndex = 6;\r\n    console.log(slideIndex);\r\n    \r\n    // document.addEventListener('DOMContentLoaded', function() {\r\n    //   var dates = new Splide('#dates', {\r\n    //     type: 'slide',\r\n    //     perPage: 6, // Default: Fully show only 3 slides at a time\r\n    //     perMove: 1, // Move one slide at a time\r\n    //     gap: '5px', // Space between slides\r\n    //     arrows: false, // Hide arrows\r\n    //     pagination: false, // Hide pagination\r\n    //     trimSpace: false, // Prevents unwanted cropping\r\n    //     autoHeight: true, // Adjusts height to content dynamically\r\n    //     rewind: false, // Prevents bouncing back to the first slide\r\n    //     snap: true, // Forces snap to the closest slide\r\n    //     drag: true, // Prevents flick scrolling through multiple items quickly\r\n    //     wheel: false, // Disables fast scrolling with mouse wheel\r\n    //     //focus: 'center',\r\n    //     breakpoints: {\r\n    //       1200: {\r\n    //         perPage: 6\r\n    //       }, // Show 5 slides on larger screens\r\n    //       900: {\r\n    //         perPage: 4\r\n    //       }, // Show 4 slides on medium screens\r\n    //       600: {\r\n    //         perPage: 3\r\n    //       }, // Default: 3 slides on smaller screens\r\n    //     },\r\n    //   });\r\n    \r\n    //   dates.on('mounted', function () {\r\n    //     // Wait for a short timeout to let layout settle\r\n    //     setTimeout(() => {\r\n    //       dates.go(slideIndex);\r\n    //     }, 0); // You can try increasing this to 50–100ms if needed\r\n    //   });\r\n    \r\n    //   // dates.mount();\r\n      \r\n    //   // Log current index on load\r\n    //   console.log('Starting slide index:', dates.index);\r\n    //   console.log('Starting slide selected:', slideIndex);\r\n    \r\n    //   // Log index whenever slide moves\r\n    //   dates.on('moved', function (newIndex) {\r\n    //     console.log('Now showing slide index:', newIndex);\r\n    //   });\r\n    \r\n    //   // Log all slide elements with their indexes\r\n    //   var slides = dates.Components.Slides.get();\r\n    //   slides.forEach((slideObj, index) => {\r\n    //     console.log(`Slide ${index}:`, slideObj.slide.textContent.trim());\r\n    //   });\r\n    // });\r\n    document.addEventListener(\"DOMContentLoaded\", function() {\r\n      const searchBar = document.querySelector(\"#filterControlls-search\");\r\n      const filterControls = document.querySelector(\"#filterControlls\");\r\n      var scrollPos = 0;\r\n      window.addEventListener(\"scroll\", function() {\r\n        let scrollTop = window.scrollY || document.documentElement.scrollTop;\r\n        // let filterTop = filterControls.getBoundingClientRect().top;\r\n        \r\n        if (searchBar != null) {\r\n          // searchBar.classList.remove(\"hidden\");\r\n          // if (filterTop <= 35) {\r\n          //   // searchBar.classList.add(\"hidden\");\r\n          // }\r\n        }\r\n      });\r\n    });\r\n\r\n    document.addEventListener('DOMContentLoaded', () => {\r\n  const nav      = document.getElementById('dateNav');\r\n  if (!nav) return;\r\n\r\n  const items    = Array.from(nav.querySelectorAll('.date-nav-item'));\r\n  const sections = items.map(btn =>\r\n    document.querySelector(`[data-date-section=\"${btn.dataset.date}\"]`)\r\n  );\r\n\r\n  // Flag to ignore clicks that were actually drags\r\n  let suppressNavClick = false;\r\n\r\n  function setActive(idx) {\r\n    items.forEach((b,i) => b.classList.toggle('active', i === idx));\r\n  }\r\n\r\n  function centerNavItem(btn) {\r\n    const navRect = nav.getBoundingClientRect();\r\n    const btnRect = btn.getBoundingClientRect();\r\n    const offset  = btnRect.left\r\n                  - navRect.left\r\n                  - (navRect.width / 2)\r\n                  + (btnRect.width / 2);\r\n    nav.scrollBy({ left: offset, behavior: 'smooth' });\r\n  }\r\n\r\n  items.forEach((btn, idx) => {\r\n    btn.addEventListener('click', () => {\r\n      if (suppressNavClick) return;\r\n\r\n      if (btn.dataset.date === 'calendar') {\r\n        showDateCalendar();\r\n        return;\r\n      }\r\n\r\n      sections[idx]?.scrollIntoView({ behavior: 'smooth', block: 'start' });\r\n\r\n      // highlight + center in the nav\r\n      setActive(idx);\r\n      centerNavItem(btn);\r\n\r\n      // run your filters\r\n      updateSearch('DATE', btn.dataset.date);\r\n      refreshSearch();\r\n    });\r\n  });\r\n\r\n  const observer = new IntersectionObserver((entries) => {\r\n    entries.forEach(ent => {\r\n      if (ent.isIntersecting) {\r\n        const idx = sections.findIndex(sec => sec === ent.target);\r\n        if (idx >= 0) {\r\n          setActive(idx);\r\n          centerNavItem(items[idx]);\r\n        }\r\n      }\r\n    });\r\n  }, {\r\n    rootMargin: '-30% 0px -70% 0px',\r\n    threshold: 0\r\n  });\r\n\r\n  sections.forEach(sec => sec && observer.observe(sec));\r\n\r\n  const initialIdx = items.findIndex(b => b.classList.contains('active'));\r\n  if (initialIdx >= 0) centerNavItem(items[initialIdx]);\r\n\r\n  // --- drag-to-scroll (mouse + touch) that DOESN'T break clicks ---\r\n  (function enableDragScroll(container) {\r\n    let isDown = false;\r\n    let startX = 0;\r\n    let startScrollLeft = 0;\r\n    let dragging = false;\r\n\r\n    const DRAG_THRESHOLD = 10; // px\r\n\r\n    container.style.cursor = 'grab';\r\n\r\n    container.addEventListener('pointerdown', (e) => {\r\n      if (e.pointerType === 'mouse' && e.button !== 0) return;\r\n\r\n      isDown = true;\r\n      dragging = false;\r\n      startX = e.clientX;\r\n      startScrollLeft = container.scrollLeft;\r\n\r\n      container.style.cursor = 'grabbing';\r\n    });\r\n\r\n    container.addEventListener('pointermove', (e) => {\r\n      if (!isDown) return;\r\n\r\n      const dx = e.clientX - startX;\r\n\r\n      if (!dragging && Math.abs(dx) > DRAG_THRESHOLD) {\r\n        dragging = true;\r\n      }\r\n\r\n      if (dragging) {\r\n        if (e.cancelable) e.preventDefault();\r\n        container.scrollLeft = startScrollLeft - dx;\r\n      }\r\n    }, { passive: false });\r\n\r\n    container.addEventListener('pointerup', () => {\r\n      isDown = false;\r\n      container.style.cursor = 'grab';\r\n\r\n      if (dragging) {\r\n        suppressNavClick = true;\r\n        setTimeout(() => { suppressNavClick = false; }, 0);\r\n      }\r\n    });\r\n\r\n    container.addEventListener('pointercancel', () => {\r\n      isDown = false;\r\n      container.style.cursor = 'grab';\r\n    });\r\n  })(nav);\r\n});\r\n\r\n  </script>  </div>\r\n<div class=\"main-container flex items-center text-sm space-x-2 mb-4 text-white/40\">\r\n  <p class=\"inline-flex text-xs items-center justify-center w-4 h-4 bg-white/40 text-black rounded-full\">\r\n    &pound;  </p>\r\n  <p>Booking online is &pound;1.00 cheaper</p>\r\n</div>\r\n</div>\r\n\r\n<div id=\"youtubeEmbed\" class=\"overflow-hidden hidden\">\r\n  <div class=\"fixed inset-0 flex items-center justify-center z-50\">\r\n    <div id=\"backgroundOverlay\" class=\"absolute inset-0 bg-black/70 backdrop-blur-sm pointer-events-none\"></div>\r\n    <div class=\"relative p-6 rounded shadow-lg z-10\">\r\n      <div id=\"youtubeIframe\" class=\"mb-2\">\r\n      </div>\r\n      <div class=\"\">\r\n        <button onclick=\"closeYoutubeVideo()\" class=\"btn-solid-yellow w-full\" onClick=\"closeRemoveFavouriteModal();return false;\">Close</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div> \r\n\r\n<div class=\"main-container grid grid-cols-1 gap-6\">\r\n  <!-- main grid  -->\r\n  <div class=\"grid grid-cols-1 md:grid-cols-6 lg:grid-cols-7 xl:grid-cols-10  bg-ompYellow-light/5 shadow-lg backdrop-blur-sm p-4 rounded-lg gap-4 xl:gap-8\">\r\n    <div class=\"hidden md:block col-span-1 md:col-span-1 lg:col-span-2 xl:col-span-2\">\r\n    <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n      <img\r\n        src=\"/filmimages/small/109933.jpg?v=1555859777\"\r\n        alt=\"Minions & Monsters Event poster\"\r\n        class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n        data-eventCode=\"109933\"\r\n        data-eventCode=\"Minions & Monsters\"\r\n      />\r\n              <img\r\n          onclick=\"playYoutubeVideo('ZSdOwt-G49w')\"\r\n          src=\"/public/assets/svgs/play-circle.svg\"\r\n          alt=\"Play Trailler\"\r\n          class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n        />\r\n          </div>\r\n  </div>\r\n  <div class=\"md:col-span-5 lg:col-span-5 xl:col-span-8\">\r\n    <div class=\"grid grid-cols-3 md:grid-cols-5 gap-4 items-start\">\r\n      <!-- A (Mobile) -->\r\n      <div class=\"md:hidden col-span-1\">\r\n        <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n          <img\r\n            src=\"/filmimages/small/109933.jpg?v=1555859777\"\r\n            alt=\"Minions & Monsters Event poster\"\r\n            class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n            data-eventCode=\"109933\"\r\n            data-eventCode=\"Minions & Monsters\"\r\n          />\r\n                      <img\r\n              onclick=\"playYoutubeVideo('ZSdOwt-G49w')\"\r\n              src=\"/public/assets/svgs/play-circle.svg\"\r\n              alt=\"Play Trailler\"\r\n              class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n            />\r\n                  </div>\r\n      </div>\r\n      <!-- B -->\r\n      <div class=\"col-span-2 md:col-span-5\">\r\n        <div class=\"w-full\">\r\n          <div class=\"flex justify-between items-start w-full mb-2\">\r\n            <p class=\"font-medium text-lg sm:text-2xl md:text-3xl leading-snug sm:leading-tight md:leading-tight mr-4\">\r\n              <a href=\"/cinema/movie/sutton/minions-monsters\">\r\n                Minions & Monsters              </a>\r\n            </p>\r\n            <img data-toggle=\"0\" id=\"favourite109933\" onClick=\"toggleFavourite('109933');return false;\" src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_favourited-off.svg\" class=\"w-4 mt-2 mx-3\" alt=\"Add to Favourites\" />  \r\n          </div>\r\n          <div class=\"flex items-center gap-2 mb-2\">\r\n            <div class=\"flex flex-col md:flex-row gap-4\">\r\n              <div class=\"flex items-center gap-2\">\r\n                <img src=\"/images/ratings/UK_TBC.png\" class=\"w-4\" />\r\n                <p class=\"text-base leading-snug font-normal leading-none\">Animation</p>\r\n              </div>\r\n              <p class=\"mb-2 md:m-auto flex item-center\"><span class=\"hidden md:flex mr-2\">|</span> 1hr 25min </p>\r\n            </div>\r\n          </div>\r\n          \r\n            <p class=\"hidden md:block mb-2 pt-2\">\r\n              <span class=\"synopsis-short\">\r\n                This time the Minions stumble into a mysterious world of creatures and monsters that pushes their chaotic curiosity to the absolute limit. Packed with the franchise?s trademark slapstick comedy, colourful animation and relentless visual gags, Minions...              </span>\r\n\r\n                              <span class=\"synopsis-full hidden text-base\">\r\n                  This time the Minions stumble into a mysterious world of creatures and monsters that pushes their chaotic curiosity to the absolute limit. Packed with the franchise?s trademark slapstick comedy, colourful animation and relentless visual gags, Minions &amp; Monsters expands the universe with new characters, new villains and even bigger set-pieces. Since their introduction the Minions have become a true global phenomenon?spawning theme-park attractions, viral memes and billions of views online?thanks to their lovable stupidity and unstoppable enthusiasm for mayhem. With its combination of fast-paced comedy and family-friendly adventure, Minions &amp; Monsters promises another wildly entertaining chapter for the most unpredictable characters in modern animation.                </span>\r\n\r\n                <button \r\n                  type=\"button\"\r\n                  class=\"ml-2 text-ompYellow underline text-base\"\r\n                  onclick=\"toggleSynopsis(this)\"\r\n                >\r\n                  See more\r\n                </button>\r\n                          </p>\r\n          <div class=\"hallTypeIcon hidden\">\r\n                                          <img src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_maxx.svg\" class=\"h-4 w-