; return false;\">29th Oct</a></li>\r\n        </ul>\r\n      </div>\r\n    </section> -->\r\n  </div>\r\n\r\n  <div id=\"calendarModal\" class=\"hidden\">\r\n    <div class=\"fixed top-0 left-0 inset-0 bg-black/70 backdrop-blur-sm z-[170]\"></div>\r\n    <div class=\"fixed inset-0 flex justify-center items-center z-[180]\">\r\n      <div class=\"rounded-lg shadow-lg p-6 relative\">\r\n        <input type=\"text\" id=\"calendarPicker\" placeholder=\"Select a date\"\r\n              class=\"hidden w-full border border-gray-300 rounded p-2\" />\r\n        <button class=\"btn-solid-yellow mt-4\" onclick=\"closeCalendarModal()\">Close</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <script src=\"/public/js/flatpickr/flatpickr.min.js\"></script>\r\n  <script>\r\n    // Assume allowedDates is provided by PHP as an array of UNIX timestamps\r\n    var defaultDate = \"2026-10-29\";\r\n    const allowedDatesTimestamps = [1789945200000,1790031600000,1790118000000,1790204400000,1790290800000,1790377200000,1790463600000,1790550000000,1790636400000,1790722800000,1790809200000,1805760000000,1796428800000,1796515200000,1794268800000,1803340800000,1797292800000,1792623600000,1792882800000,1801612800000,1791846000000,1792278000000,1800921600000,1792450800000,1793059200000,1793836800000,1791327600000,1791586800000,1811199600000,1808348400000,1796083200000,1809471600000,1790895600000,1790982000000,1791068400000,1791154800000,1791241200000,1791414000000,1792710000000,1792796400000,1792972800000,1793145600000,1793232000000];\r\n    const allowedDates = allowedDatesTimestamps.map(ts => new Date(ts));\r\n    // console.log('DateSelector::AllowedDateCount:43');\r\n    // console.log('DateSelector::CalendarEventCount:41');\r\n    // console.log('DateSelector::AllowedDates:' + allowedDatesTimestamps);\r\n    // console.log('DateSelector::DfltDate:' + defaultDate);\r\n    // console.log('DateSelector::FilterEventCode: ');    \r\n    \r\n    if (defaultDate == 0) {\r\n      defaultDate = '';\r\n    }\r\n\r\n    flatpickr(\"#calendarPicker\", {\r\n      inline: true,\r\n      enable: allowedDates,\r\n      dateFormat: \"Y-m-d\",\r\n      defaultDate: defaultDate,\r\n      onChange: function(selectedDates, dateStr, instance) {\r\n        console.log(\"Selected date:\", dateStr);\r\n        calendarDateChange(dateStr);\r\n        // Optionally, automatically close the modal after selection:\r\n        // closeCalendarModal();\r\n      }\r\n    });\r\n    \r\n  </script>\r\n\r\n  <script> \r\n    var slideIndex = 6;\r\n    console.log(slideIndex);\r\n    \r\n    // document.addEventListener('DOMContentLoaded', function() {\r\n    //   var dates = new Splide('#dates', {\r\n    //     type: 'slide',\r\n    //     perPage: 6, // Default: Fully show only 3 slides at a time\r\n    //     perMove: 1, // Move one slide at a time\r\n    //     gap: '5px', // Space between slides\r\n    //     arrows: false, // Hide arrows\r\n    //     pagination: false, // Hide pagination\r\n    //     trimSpace: false, // Prevents unwanted cropping\r\n    //     autoHeight: true, // Adjusts height to content dynamically\r\n    //     rewind: false, // Prevents bouncing back to the first slide\r\n    //     snap: true, // Forces snap to the closest slide\r\n    //     drag: true, // Prevents flick scrolling through multiple items quickly\r\n    //     wheel: false, // Disables fast scrolling with mouse wheel\r\n    //     //focus: 'center',\r\n    //     breakpoints: {\r\n    //       1200: {\r\n    //         perPage: 6\r\n    //       }, // Show 5 slides on larger screens\r\n    //       900: {\r\n    //         perPage: 4\r\n    //       }, // Show 4 slides on medium screens\r\n    //       600: {\r\n    //         perPage: 3\r\n    //       }, // Default: 3 slides on smaller screens\r\n    //     },\r\n    //   });\r\n    \r\n    //   dates.on('mounted', function () {\r\n    //     // Wait for a short timeout to let layout settle\r\n    //     setTimeout(() => {\r\n    //       dates.go(slideIndex);\r\n    //     }, 0); // You can try increasing this to 50–100ms if needed\r\n    //   });\r\n    \r\n    //   // dates.mount();\r\n      \r\n    //   // Log current index on load\r\n    //   console.log('Starting slide index:', dates.index);\r\n    //   console.log('Starting slide selected:', slideIndex);\r\n    \r\n    //   // Log index whenever slide moves\r\n    //   dates.on('moved', function (newIndex) {\r\n    //     console.log('Now showing slide index:', newIndex);\r\n    //   });\r\n    \r\n    //   // Log all slide elements with their indexes\r\n    //   var slides = dates.Components.Slides.get();\r\n    //   slides.forEach((slideObj, index) => {\r\n    //     console.log(`Slide ${index}:`, slideObj.slide.textContent.trim());\r\n    //   });\r\n    // });\r\n    document.addEventListener(\"DOMContentLoaded\", function() {\r\n      const searchBar = document.querySelector(\"#filterControlls-search\");\r\n      const filterControls = document.querySelector(\"#filterControlls\");\r\n      var scrollPos = 0;\r\n      window.addEventListener(\"scroll\", function() {\r\n        let scrollTop = window.scrollY || document.documentElement.scrollTop;\r\n        // let filterTop = filterControls.getBoundingClientRect().top;\r\n        \r\n        if (searchBar != null) {\r\n          // searchBar.classList.remove(\"hidden\");\r\n          // if (filterTop <= 35) {\r\n          //   // searchBar.classList.add(\"hidden\");\r\n          // }\r\n        }\r\n      });\r\n    });\r\n\r\n    document.addEventListener('DOMContentLoaded', () => {\r\n  const nav      = document.getElementById('dateNav');\r\n  if (!nav) return;\r\n\r\n  const items    = Array.from(nav.querySelectorAll('.date-nav-item'));\r\n  const sections = items.map(btn =>\r\n    document.querySelector(`[data-date-section=\"${btn.dataset.date}\"]`)\r\n  );\r\n\r\n  // Flag to ignore clicks that were actually drags\r\n  let suppressNavClick = false;\r\n\r\n  function setActive(idx) {\r\n    items.forEach((b,i) => b.classList.toggle('active', i === idx));\r\n  }\r\n\r\n  function centerNavItem(btn) {\r\n    const navRect = nav.getBoundingClientRect();\r\n    const btnRect = btn.getBoundingClientRect();\r\n    const offset  = btnRect.left\r\n                  - navRect.left\r\n                  - (navRect.width / 2)\r\n                  + (btnRect.width / 2);\r\n    nav.scrollBy({ left: offset, behavior: 'smooth' });\r\n  }\r\n\r\n  items.forEach((btn, idx) => {\r\n    btn.addEventListener('click', () => {\r\n      if (suppressNavClick) return;\r\n\r\n      if (btn.dataset.date === 'calendar') {\r\n        showDateCalendar();\r\n        return;\r\n      }\r\n\r\n      sections[idx]?.scrollIntoView({ behavior: 'smooth', block: 'start' });\r\n\r\n      // highlight + center in the nav\r\n      setActive(idx);\r\n      centerNavItem(btn);\r\n\r\n      // run your filters\r\n      updateSearch('DATE', btn.dataset.date);\r\n      refreshSearch();\r\n    });\r\n  });\r\n\r\n  const observer = new IntersectionObserver((entries) => {\r\n    entries.forEach(ent => {\r\n      if (ent.isIntersecting) {\r\n        const idx = sections.findIndex(sec => sec === ent.target);\r\n        if (idx >= 0) {\r\n          setActive(idx);\r\n          centerNavItem(items[idx]);\r\n        }\r\n      }\r\n    });\r\n  }, {\r\n    rootMargin: '-30% 0px -70% 0px',\r\n    threshold: 0\r\n  });\r\n\r\n  sections.forEach(sec => sec && observer.observe(sec));\r\n\r\n  const initialIdx = items.findIndex(b => b.classList.contains('active'));\r\n  if (initialIdx >= 0) centerNavItem(items[initialIdx]);\r\n\r\n  // --- drag-to-scroll (mouse + touch) that DOESN'T break clicks ---\r\n  (function enableDragScroll(container) {\r\n    let isDown = false;\r\n    let startX = 0;\r\n    let startScrollLeft = 0;\r\n    let dragging = false;\r\n\r\n    const DRAG_THRESHOLD = 10; // px\r\n\r\n    container.style.cursor = 'grab';\r\n\r\n    container.addEventListener('pointerdown', (e) => {\r\n      if (e.pointerType === 'mouse' && e.button !== 0) return;\r\n\r\n      isDown = true;\r\n      dragging = false;\r\n      startX = e.clientX;\r\n      startScrollLeft = container.scrollLeft;\r\n\r\n      container.style.cursor = 'grabbing';\r\n    });\r\n\r\n    container.addEventListener('pointermove', (e) => {\r\n      if (!isDown) return;\r\n\r\n      const dx = e.clientX - startX;\r\n\r\n      if (!dragging && Math.abs(dx) > DRAG_THRESHOLD) {\r\n        dragging = true;\r\n      }\r\n\r\n      if (dragging) {\r\n        if (e.cancelable) e.preventDefault();\r\n        container.scrollLeft = startScrollLeft - dx;\r\n      }\r\n    }, { passive: false });\r\n\r\n    container.addEventListener('pointerup', () => {\r\n      isDown = false;\r\n      container.style.cursor = 'grab';\r\n\r\n      if (dragging) {\r\n        suppressNavClick = true;\r\n        setTimeout(() => { suppressNavClick = false; }, 0);\r\n      }\r\n    });\r\n\r\n    container.addEventListener('pointercancel', () => {\r\n      isDown = false;\r\n      container.style.cursor = 'grab';\r\n    });\r\n  })(nav);\r\n});\r\n\r\n  </script>  </div>\r\n<div class=\"main-container flex items-center text-sm space-x-2 mb-4 text-white/40\">\r\n  <p class=\"inline-flex text-xs items-center justify-center w-4 h-4 bg-white/40 text-black rounded-full\">\r\n    &pound;  </p>\r\n  <p>Booking online is &pound;1.00 cheaper</p>\r\n</div>\r\n</div>\r\n\r\n<div id=\"youtubeEmbed\" class=\"overflow-hidden hidden\">\r\n  <div class=\"fixed inset-0 flex items-center justify-center z-50\">\r\n    <div id=\"backgroundOverlay\" class=\"absolute inset-0 bg-black/70 backdrop-blur-sm pointer-events-none\"></div>\r\n    <div class=\"relative p-6 rounded shadow-lg z-10\">\r\n      <div id=\"youtubeIframe\" class=\"mb-2\">\r\n      </div>\r\n      <div class=\"\">\r\n        <button onclick=\"closeYoutubeVideo()\" class=\"btn-solid-yellow w-full\" onClick=\"closeRemoveFavouriteModal();return false;\">Close</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div> \r\n\r\n<div class=\"main-container grid grid-cols-1 gap-6\">\r\n  <!-- main grid  -->\r\n  <div class=\"grid grid-cols-1 md:grid-cols-6 lg:grid-cols-7 xl:grid-cols-10  bg-ompYellow-light/5 shadow-lg backdrop-blur-sm p-4 rounded-lg gap-4 xl:gap-8\">\r\n    <div class=\"hidden md:block col-span-1 md:col-span-1 lg:col-span-2 xl:col-span-2\">\r\n    <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n      <img\r\n        src=\"/filmimages/small/113504.jpg?v=1563395441\"\r\n        alt=\"Wildwood Event poster\"\r\n        class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n        data-eventCode=\"113504\"\r\n        data-eventCode=\"Wildwood\"\r\n      />\r\n              <img\r\n          onclick=\"playYoutubeVideo('dtr5JL1zkiM')\"\r\n          src=\"/public/assets/svgs/play-circle.svg\"\r\n          alt=\"Play Trailler\"\r\n          class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n        />\r\n          </div>\r\n  </div>\r\n  <div class=\"md:col-span-5 lg:col-span-5 xl:col-span-8\">\r\n    <div class=\"grid grid-cols-3 md:grid-cols-5 gap-4 items-start\">\r\n      <!-- A (Mobile) -->\r\n      <div class=\"md:hidden col-span-1\">\r\n        <div class=\"grid grid-cols-1 grid-rows-1 w-full\">\r\n          <img\r\n            src=\"/filmimages/small/113504.jpg?v=1563395441\"\r\n            alt=\"Wildwood Event poster\"\r\n            class=\"col-start-1 row-start-1 w-full h-auto object-cover\"\r\n            data-eventCode=\"113504\"\r\n            data-eventCode=\"Wildwood\"\r\n          />\r\n                      <img\r\n              onclick=\"playYoutubeVideo('dtr5JL1zkiM')\"\r\n              src=\"/public/assets/svgs/play-circle.svg\"\r\n              alt=\"Play Trailler\"\r\n              class=\"col-start-1 row-start-1 self-center justify-self-center w-12 h-12\"\r\n            />\r\n                  </div>\r\n      </div>\r\n      <!-- B -->\r\n      <div class=\"col-span-2 md:col-span-5\">\r\n        <div class=\"w-full\">\r\n          <div class=\"flex justify-between items-start w-full mb-2\">\r\n            <p class=\"font-medium text-lg sm:text-2xl md:text-3xl leading-snug sm:leading-tight md:leading-tight mr-4\">\r\n              <a href=\"/cinema/movie/sutton/wildwood\">\r\n                Wildwood              </a>\r\n            </p>\r\n            <img data-toggle=\"0\" id=\"favourite113504\" onClick=\"toggleFavourite('113504');return false;\" src=\"/public/assets/svgs/omniplex_mobile-app-2025_svgs_favourited-off.svg\" class=\"w-4 mt-2 mx-3\" alt=\"Add to Favourites\" />  \r\n          </div>\r\n          <div class=\"flex items-center gap-2 mb-2\">\r\n            <div class=\"flex flex-col md:flex-row gap-4\">\r\n              <div class=\"flex items-center gap-2\">\r\n                <img src=\"/images/ratings/UK_TBC.png\" class=\"w-4 min-w-[30px]\" />\r\n                <p class=\"text-base leading-snug font-normal leading-none\">Adventure, Animation, Fantasy</p>\r\n              </div>\r\n              <p class=\"mb-2 md:m-auto flex item-center\"><span class=\"hidden md:flex mr-2\">|</span> 2hrs 10min </p>\r\n            </div>\r\n          </div>\r\n          \r\n            <p class=\"hidden md:block mb-2 pt-2\">\r\n              <span class=\"synopsis-short\">\r\n                After her baby brother is abducted by a murder of crows, headstrong teenager Prue McKeel launches a desperate rescue mission into the Impassable Wilderness - an enchanted forest hidden just beyond Portland, Oregon. Joined by her hapless but loyal cla...              </span>\r\n\r\n                              <span class=\"synopsis-full hidden text-base\">\r\n                  After her baby brother is abducted by a murder of crows, headstrong teenager Prue McKeel launches a desperate rescue mission into the Impassable Wilderness - an enchanted forest hidden just beyond Portland, Oregon. Joined by her hapless but loyal classmate Curtis Mehlberg, Prue navigates a world of talking animals, bandits, and powerful figures driven by grief and ambition. As the pair is drawn into a conflict threatening the balance of the forest itself, Prue must discover strength and belief she never knew she possessed. If she hopes to save her brother and protect Wildwood?s fragile future, she will have to risk everything. From Oscar-nominated and BAFTA-winning LAIKA, Wildwood is a sweeping adventure about love, sacrifice, and the magic that reveals itself when we dare to look beyond the familiar.                </span>\r\n\r\n                <button \r\n                  type=\"button\"\r\n                  class=\"ml-2 text-ompYellow underline text-base\"\r\n                  onclick=\"toggleSynopsis(this)\"\r\n                >\r\n                  See more\r\n                </button>\r\n                          </p>\r\n          <div class=\"hallTypeIcon hidden\">\r\n                                  </div>\r\n        </div>\r\n      </div>\r\n      <!-- C -->\r\n      <div class=\"col-span-3 md:col-span-5 md:col-start-1\">\r\n        <div class=\"w-full grid grid-cols-1 md:grid-cols-2 sm:col-span-2 xl:grid-cols-3  gap-2\">\r\n          <a aria-label=\"Wildwood at 12:10 in Screen 1\" href=\"https://www.omniplexcinemas.co.uk/booking/seats/sutton/48177\" class=\"\"> \r\n<div id=\"perf_0\" class=\"showTimeBox bg-ompGray-times p-2 col-span-1 rounded-xl\">\r\n  <div class=\"topSection flex justify-between items-end\">\r\n    <div class=\"flex items-end\">\r\n      <div class=\"flex items-baseline\">\r\n        <h4 class=\"bigText mr-1 leading-none\" aria-label=\"Wildwood at 12:10 in Screen 1\">\r\n          12:10        </h4>\r\n        <p class=\"smallText leading-none\" aria-label=\"Wildwood starts at 12:10 and ends at 14:20\">\r\n          - 14:20        </p>\r\n      </div>\r\n    </div>\r\n    <div class=\"flex items-end\">\r\n              <div class=\"flex items-baseline\">\r\n          <p class=\"smallText mr-1 leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            From\r\n          </p>\r\n          <h4 class=\"bigText leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            &pound;6.95          </h4>\r\n        </div>\r\n          </div>\r\n  </div>\r\n  <div class=\"midSection flex justify-between items-baseline\">\r\n\r\n    <div class=\"mb-2\"></div>\r\n  </div>\r\n  <div class=\"bottomSection flex items-center justify-between gap-2\">\r\n    <div class=\"shrink-0\">\r\n      <p class=\"smallText\">\r\n        Screen 1      </p>\r\n    </div>\r\n    <div class=\"flex flex-1 min-w-0 justify-end overflow-hidden\">\r\n      <div class=\"flex min-w-0 max-w-full items-center justify-end gap-2\"> \r\n                      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n</a><a aria-label=\"Wildwood at 13:10 in Screen 6\" href=\"https://www.omniplexcinemas.co.uk/booking/seats/sutton/48193\" class=\"\"> \r\n<div id=\"perf_1\" class=\"showTimeBox bg-ompGray-times p-2 col-span-1 rounded-xl\">\r\n  <div class=\"topSection flex justify-between items-end\">\r\n    <div class=\"flex items-end\">\r\n      <div class=\"flex items-baseline\">\r\n        <h4 class=\"bigText mr-1 leading-none\" aria-label=\"Wildwood at 13:10 in Screen 6\">\r\n          13:10        </h4>\r\n        <p class=\"smallText leading-none\" aria-label=\"Wildwood starts at 13:10 and ends at 15:20\">\r\n          - 15:20        </p>\r\n      </div>\r\n    </div>\r\n    <div class=\"flex items-end\">\r\n              <div class=\"flex items-baseline\">\r\n          <p class=\"smallText mr-1 leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            From\r\n          </p>\r\n          <h4 class=\"bigText leading-none\" aria-label=\"Cost starting from &pound;6.95\">\r\n            &pound;6.95          </h4>\r\n        </div>\r\n          </div>\r\n  </div>\r\n  <div class=\"midSection flex justify-between items-baseline\">\r\n\r\n    <div class=\"mb-2\"></