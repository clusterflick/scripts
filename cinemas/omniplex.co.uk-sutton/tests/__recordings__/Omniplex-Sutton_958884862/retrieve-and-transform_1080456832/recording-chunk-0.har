ter-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/join/landing\"\"\r\n                                          >\r\n                      Sign up                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/account/login\"\"\r\n                                          >\r\n                      Log in                    </a>\r\n                  </li>\r\n                              </ul>\r\n            </div>\r\n                  </div>\r\n              <div id=\"footerColumn3\" class=\"space-y-8\">\r\n                      <div>\r\n                              <h4 class=\"mb-1 font-semibold text-white\">\r\n                  Cinema Features                </h4>\r\n              \r\n              <ul class=\"space-y-1\">\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/omniplexmaxx\"\"\r\n                                          >\r\n                      Omniplex MAXX                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/omniplexdluxx\"\"\r\n                                          >\r\n                      Omniplex D'LUXX                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/company/omniplexlux\"\"\r\