petition\"\"\r\n                                          >\r\n                      Offers & Competitions                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/cinema/kids\"\"\r\n                                          >\r\n                      Kids Club                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/explore/meerkatmovies\"\"\r\n                                          >\r\n                      Meerkat Movies                    </a>\r\n                  </li>\r\n                              </ul>\r\n            </div>\r\n                      <div>\r\n                              <h4 class=\"mb-1 font-semibold text-white\">\r\n                  MyOmniPass                </h4>\r\n              \r\n              <ul class=\"space-y-1\">\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/join/landing\"\"\r\n                                          >\r\n                      Sign up                    </a>\r\n                  </li>\r\n                                  <li>\r\n                    <a\r\n                      class=\"footer-link text-white/70 hover:text-[#FFEA00] transition-colors duration-200 \"\r\n                      href=\"/account/login\"\"\r\n                                          >\r\n                      Log in                    </a>\r\n                  </li>\r\n                              </ul>\r\n            </div>\r\n                  </div>\r