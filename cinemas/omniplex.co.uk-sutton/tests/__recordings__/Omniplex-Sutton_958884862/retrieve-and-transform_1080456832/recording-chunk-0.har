ic/assets/branding/omniplex_logo.png\" class=\"h-[44px] mx-auto  mb-3\" alt=\"Omniplex Logo\">\r\n    <p class=\"\">&copy; Omniplex. All rights reserved.</p>\r\n  </div>\r\n</div>\r\n\r\n\r\n\r\n<!-- All footer elements go here      -->\r\n<!-- General JS  -->\r\n<script type=\"text/javascript\" src=\"/public/js/scripts.js?v=1780527789\"></script>\r\n\r\n<!-- If the developer is debugging in Chrome -->\r\n<script>\r\nGlobalDebuggingInChrome = false;\r\n\r\n\r\n\r\n//Clears Footer Contact Select dropdown\r\ndocument.addEventListener('DOMContentLoaded', () => {\r\n    const cinemaSelect = document.getElementById('conactlocalCinema');\r\n    cinemaSelect.selectedIndex = 0;\r\n});\r\n\r\ndocument.addEventListener('DOMContentLoaded', function () {\r\n  const cinemaSelect = document.getElementById('conactlocalCinema');\r\n\r\n  if (!cinemaSelect) return;\r\n\r\n  cinemaSelect.addEventListener('change', function () {\r\n    const siteCode = this.value;\r\n\r\n    if (siteCode !== '') {\r\n      window.location.href = '/company/contact?site=' + encodeURIComponent(siteCode);\r\n    }\r\n  });\r\n});\r\n</script>\r\n</body>\r\n\r\n</html>",
