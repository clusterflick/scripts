ue=\"OMP_CARL\" id=\"carlow\" data-thissite=\"OMP_CARL\" data-sitecode=\"OMP_SUTT\">&nbsp;Carlow</option>\r\n<option value=\"OMP_MAHO\" id=\"cork\" data-thissite=\"OMP_MAHO\" data-sitecode=\"OMP_SUTT\">&nbsp;Cork</option>\r\n<option value=\"OMP_SCOT\" id=\"drogheda-scotch-hall\" data-thissite=\"OMP_SCOT\" data-sitecode=\"OMP_SUTT\">&nbsp;Drogheda - Scotch Hall</option>\r\n<option value=\"OMP_BALB\" id=\"balbriggan\" data-thissite=\"OMP_BALB\" data-sitecode=\"OMP_SUTT\">&nbsp;Dublin - Balbriggan</option>\r\n<option value=\"OMP_NUTG\" id=\"nutgrove\" data-thissite=\"OMP_NUTG\" data-sitecode=\"OMP_SUTT\">&nbsp;Dublin - Nutgrove</option>\r\n<option value=\"OMP_RATH\" id=\"dublin-rathmines\" data-thissite=\"OMP_RATH\" data-sitecode=\"OMP_SUTT\">&nbsp;Dublin - Rathmines</option>\r\n<option value=\"OMP_DUND\" id=\"dundalk\" data-thissite=\"OMP_DUND\" data-sitecode=\"OMP_SUTT\">&nbsp;Dundalk</option>\r\n<option value=\"OMP_GALW\" id=\"galway\" data-thissite=\"OMP_GALW\" data-sitecode=\"OMP_SUTT\">&nbsp;Galway - Salthill</option>\r\n<option value=\"OMP_KILL\" id=\"killarney\" data-thissite=\"OMP_KILL\" data-sitecode=\"OMP_SUTT\">&nbsp;Killarney</option>\r\n<option value=\"OMP_LIME\" id=\"limerick\" data-thissite=\"OMP_LIME\" data-sitecode=\"OMP_SUTT\">&nbsp;Limerick</option>\r\n<option value=\"OMP_LONG\" id=\"longford\" data-thissite=\"OMP_LONG\" data-sitecode=\"OMP_SUTT\">&nbsp;Longford</option>\r\n<option value=\"OMP_MONA\" id=\"monaghan\" data-thissite=\"OMP_MONA\" data-sitecode=\"OMP_SUTT\">&nbsp;Monaghan</option>\r\n<option value=\"OMP_MULL\" id=\"mullingar\" data-thissite=\"OMP_MULL\" data-sitecode=\"OMP_SUTT\">&nbsp;Mullingar</option>\r\n<option value=\"OMP_NENA\" id=\"nenagh\" data-thissite=\"OMP_NENA\" data-sitecode=\"OMP_SUTT\">&nbsp;Nenagh</option>\r\n<option value=\"OMP_ROSC\" id=\"roscommon\" data-thissite=\"OMP_ROSC\" data-sitecode=\"OMP_SUTT\">&nbsp;Roscommon</option>\r\n<option value=\"OMP_SHAN\" id=\"shannon\" data-thissite=\"OMP_SHAN\" data-sitecode=\"OMP_SUTT\">&nbsp;Shannon</option>\r\n<option value=\"OMP_SLIG\" id=\"sligo\" data-thissite=\"OMP_SLIG\" data-sitecode=\"OMP_SUTT\">&nbsp;Sligo</option>\r\n<option value=\"OMP_TRAL\" id=\"tralee\" data-thissite=\"OMP_TRAL\" data-sitecode=\"OMP_SUTT\">&nbsp;Tralee</option>\r\n<option value=\"OMP_WATE\" id=\"waterford\" data-thissite=\"OMP_WATE\" data-sitecode=\"OMP_SUTT\">&nbsp;Waterford</option>\r\n<option value=\"OMP_WEXF\" id=\"wexford\" data-thissite=\"OMP_WEXF\" data-sitecode=\"OMP_SUTT\">&nbsp;Wexford</option>\r\n</optgroup>              </select>\r\n            </div>\r\n            <div class=\"divider OMP_alignCenter OMP_padding20-tb\"><span>or</span></div>\r\n            <div class=\"OMP_selectHolder\">\r\n              <i class=\"fas fa-chevron-down\"></i>\r\n              <select id=\"quickMovieMobile\" name=\"event\">\r\n                <option value=\"0\">Choose A Movie</option>\r\n                                <script>\r\n                $(document).ready(function() {\r\n                  if ($(window).width() < 768) {\r\n                    quickBookGetEventsMobile('OMP_SUTT');\r\n                  }\r\n                });\r\n                </script>\r\n                              </select>\r\n              <input type=\"hidden\" id=\"cinemasForMovie\" value=\"\" />\r\n            </div>\r\n            <div id=\"quickDateMobileHolder\" class=\"OMP_selectHolder OMP_margin20-t\" style=\"display: none;\">\r\n              <i class=\"fas fa-chevron-down\"></i>\r\n              <select id=\"quickDateMobile\" name=\"date\">\r\n                <option value=\"0\">Choose Date</option>\r\n              </select>\r\n            </div>\r\n            <div id=\"quickTimeMobileHolder\" class=\"OMP_selectHolder OMP_margin20-t\" style=\"display: none;\">\r\n              <i class=\"fas fa-chevron-down\"></i>\r\n              <select id=\"quickTimeMobile\" name=\"performance\">\r\n                <option value=\"0\">Choose Time</option>\r\n              </select>\r\n            </div>\r\n            <div class=\"OMP_margin30-t\">\r\n              <a href=\"#\" id=\"quickBookButtonMobile\" class=\"formButton OMP_button OMP_buttonYellow OMP_buttonFullWidth\"\r\n                onclick=\"$('#quickbookMobile').submit();return false;\">Book Tickets</a>\r\n            </div>\r\n            <div class=\"clear\"></div>\r\n          </form>\r\n        </div>\r\n      </div>\r\n      <div id=\"manageSubscriptionSlide\">\r\n        <div class=\"OMP_topSection OMP_borderBottomG OMP_padding20-b\">\r\n          <h4>Manage My Subscription</h4>\r\n          <i id=\"slideOutManageSubscriptionClose\" class=\"OMP_slideoutClose far fa-times-circle\"></i>\r\n        </div>\r\n                <div class=\"resultsSection OMP_padding20-t\">\r\n          <h6>How Can I Cancel?</h6>\r\n          <p>When your initial 3 month contract has ended, you will be placed into a rolling 30 day contract. After the\r\n            initial period of 3 months, you can click the 'Manage My Subscription' button at any time and choose the\r\n            'Cancel My Subscription' button. This will stop any future payments on your account.</p>\r\n          <br /> \r\n          <h6>Why Can't I click the 'Update My Subscription' button?</h6>\r\n          <p>This button will only become clickable once your initial 3 month subscription has ended.</p>\r\n          <br />\r\n          <h6>What is MyOmniPass Gold?</h6>\r\n          <p>MyOmniPass Gold is exclusively available for MyOmniPass members who have had their account for over 3\r\n            months. All members are updated automatically to enjoy new benefits including unlimited pre-booking of\r\n            movies both online and in-cinema (as long as they don't overlap, and you only see a movie once).</p>\r\n          <br />\r\n          <h6>How can I get access to MyOmniPass Gold?</h6>\r\n          <p>You will be automatically upgraded to MyOmniPass Gold after your 3 month initial subscription has passed.\r\n          </p>\r\n        </div>\r\n              </div>\r\n    </div>\r\n  </div>\r\n  <script type=\"text/javascript\">\r\n  var classOpening = 'bottom-open';\r\n  /*-----------------------*/\r\n  $(document).ready(function() {\r\n    if (!$.cookie('safeoperations') || $.cookie('safeoperations') == null) {\r\n      $('#disclaimerBox').removeClass('OMP_hide');\r\n    }\r\n    $('#disclaimerClose').on('click', function(e) {\r\n      e.preventDefault();\r\n      $.cookie('safeoperations', true, {\r\n        path: '/'\r\n      });\r\n      $('#disclaimerBox').toggleClass('OMP_hide');\r\n    });\r\n    $('#slideOutOverlay').on('click', function(e) {\r\n      e.preventDefault();\r\n      $('#slideOutOverlay').removeClass('is-open');\r\n      $('#multiSlideMenu').removeClass('is-open');\r\n      $('#multiSlideMenu').toggleClass('bottom-open');\r\n      $('#multiSlideMenu').removeClass('open-menu');\r\n      $('#multiSlideMenu').removeClass('open-search');\r\n      $('#multiSlideMenu').removeClass('open-date');\r\n      $('#multiSlideMenu').removeClass('open-type');\r\n      $('#multiSlideMenu').removeClass('open-seatInfo');\r\n      $('#multiSlideMenu').removeClass('open-manageSubscription');\r\n      $('#multiSlideModal').removeClass('bottom-open');\r\n      $('#multiSlideModal').removeClass('open-trailer');\r\n      $('#multiSlideModal').removeClass('open-seats');\r\n      $('#multiSlideModal').removeClass('open-barcode');\r\n      $('#multiSlideModal').removeClass('open-cancelSubscription');\r\n      $('#multiSlideModal').removeClass('open-cancelOrder');\r\n    });\r\n    $('#slideOutSearchDesktop').on('click', function(e) {\r\n      $('#slideOutOverlay').toggleClass('is-open');\r\n      $('#multiSlideMenu').toggleClass('is-open');\r\n      $('#multiSlideMenu').toggleClass('bottom-open');\r\n      $('#multiSlideMenu').toggleClass('open-search');\r\n    });\r\n    $('#slideOutSearchDesktopClose').on('click', function(e) {\r\n      e.preventDefault();\r\n      $('#slideOutOverlay').removeClass('is-open');\r\n      $('#multiSlideMenu').removeClass('is-open');\r\n      $('#multiSlideMenu').removeClass('bottom-open');\r\n      $('#multiSlideMenu').removeClass('open-search');\r\n    });\r\n    $('#slideOutSelectSearch').on('click', function(e) {\r\n      e.preventDefault();\r\n      $('#slideOutOverlay').toggleClass('is-open');\r\n      $('#multiSlideMenu').toggleClass('is-open');\r\n      $('#multiSlideMenu').toggleClass('bottom-open');\r\n      $('#multiSlideMenu').toggleClass('open-search');\r\n    });\r\n    $('#slideOutSelectSearchMobile').on('click', function(e) {\r\n      e.preventDefault();\r\n      $('#slideOutOverlay').toggleClass('is-open');\r\n      $('#multiSlideMenu').toggleClass('is-open');\r\n      $('#multiSlideMenu').toggleClass('bottom-open');\r\n      $('#multiSlideMenu').toggleClass('open-search');\r\n    });\r\n    $('#slideOutQuickMobile').on('click', function(e) {\r\n      e.preventDefault();\r\n      $('#multiSlideMenu').toggleClass('is-open');\r\n      $('#multiSlideMenu').toggleClass('bottom-open');\r\n      $('#multiSlideMenu').toggleClass('open-quick');\r\n    });\r\n    $('#slideOutSearchMobile').on('click', function(e) {\r\n      e.preventDefault();\r\n      $('#multiSlideMenu').toggleClass('is-open');\r\n      $('#multiSlideMenu').toggleClass('bottom-open');\r\n      $('#multiSlideMenu').toggleClass('open-search');\r\n    });\r\n    $('#slideOutQuickBookClose').on('click', function(e) {\r\n      e.preventDefault();\r\n      $('#multiSlideMenu').removeClass('is-open');\r\n      $('#multiSlideMenu').removeClass('bottom-open');\r\n      $('#multiSlideMenu').removeClass('open-quick');\r\n    });\r\n    $('#slideOutSearchMobileClose').on('click', function(e) {\r\n      e.preventDefault();\r\n      $('#multiSlideMenu').removeClass('is-open');\r\n      $('#multiSlideMenu').removeClass('bottom-open');\r\n      $('#multiSlideMenu').removeClass('open-search');\r\n    });\r\n    $('#slideOutMenuMobile').on('click', function(e) {\r\n      e.preventDefault();\r\n      $('#multiSlideMenu').toggleClass('is-open');\r\n      $('#multiSlideMenu').toggleClass('bottom-open');\r\n      $('#multiSlideMenu').toggleClass('open-menu');\r\n    });\r\n    $('#slideOutMenuClose').on('click', function(e) {\r\n      e.preventDefault();\r\n      $('#multiSlideMenu').removeClass('is-open');\r\n      $('#multiSlideMenu').removeClass('bottom-open');\r\n      $('#multiSlideMenu').removeClass('open-menu');\r\n    });\r\n    $('.OMP_customDate').on('click', function(e) {\r\n      e.preventDefault();\r\n      $('#slideOutOverlay').toggleClass('is-open');\r\n      $('#multiSlideMenu').toggleClass('is-open');\r\n      $('#multiSlideMenu').toggleClass('bottom-open');\r\n      $('#multiSlideMenu').toggleClass('open-date');\r\n    });\r\n    $('#slideOutDateClose').on('click', function(e) {\r\n      e.preventDefault();\r\n      $('#slideOutOverlay').removeClass('is-open');\r\n      $('#multiSlideMenu').removeClass('is-open');\r\n      $('#multiSlideMenu').removeClass('bottom-open');\r\n      $('#multiSlideMenu').removeClass('open-type');\r\n    });\r\n    $('.OMP_customType').on('click', function(e) {\r\n      e.preventDefault();\r\n      $('#slideOutOverlay').toggleClass('is-open');\r\n      $('#multiSlideMenu').toggleClass('is-open');\r\n      $('#multiSlideMenu').toggleClass('bottom-open');\r\n      $('#multiSlideMenu').toggleClass('open-type');\r\n    });\r\n    $('#slideOutTypeClose').on('click', function(e) {\r\n      e.preventDefault();\r\n      $('#slideOutOverlay').removeClass('is-open');\r\n      $('#multiSlideMenu').removeClass('is-open');\r\n      $('#multiSlideMenu').removeClass('bottom-open');\r\n      $('#multiSlideMenu').removeClass('open-type');\r\n    });\r\n    $('#hoverAction').on('mouseover', function(e) {\r\n      e.preventDefault();\r\n      $('.OMP_dropdown').toggleClass('hover');\r\n    });\r\n    $('#hoverAction').on('mouseout', function(e) {\r\n      e.preventDefault();\r\n      $('.OMP_dropdown').toggleClass('hover');\r\n    });\r\n\r\n    $('#hoverAction1').on('click', function(e) {\r\n      e.preventDefault();\r\n      $('.OMP_dropdown').toggleClass('hover');\r\n    });\r\n  });\r\n  </script>\r\n  <!-- MODAL STYLING -->\r\n  <style>\r\n  .modal {\r\n    justify-content: center;\r\n    align-items: center;\r\n    width: 100%;\r\n    height: 100%;\r\n    display: flex;\r\n    z-index: 999999;\r\n    left: 0px;\r\n    top: 0px;\r\n    position: fixed;\r\n  }\r\n\r\n  .modal-overlay {\r\n    opacity: 0.9;\r\n    background-color: rgba(23, 23, 23);\r\n    width: 100%;\r\n    height: 100%;\r\n    position: absolute;\r\n  }\r\n\r\n  #loginForm_Modal label {\r\n    font-family: \"GothamBook\";\r\n    font-size: 14px;\r\n    line-height: 19.6px;\r\n    font-weight: 100;\r\n    margin-bottom: 5px;\r\n  }\r\n\r\n  .modal-container {\r\n    width: 33.333333%;\r\n    margin-left: auto;\r\n    margin-right: auto;\r\n    z-index: 50;\r\n  }\r\n\r\n  .modal-content {\r\n    text-align: left;\r\n    padding-top: 1rem;\r\n    padding-bottom: 1rem;\r\n    padding-left: 1.5rem;\r\n    padding-right: 1.5rem;\r\n  }\r\n\r\n  .modal-container .modal_title-container {\r\n    padding: 20px 30px;\r\n    background-color: black;\r\n    background-image: url(/images/login-modal_header.png);\r\n    height: 50px;\r\n    border-radius: 30px 30px 0 0;\r\n  }\r\n\r\n  .modal-container .rememberMe {\r\n    font-family: \"GothamBook\";\r\n    font-size: 14px;\r\n    line-height: 19.6px;\r\n    font-weight: normal;\r\n    text-align: right;\r\n  }\r\n\r\n  .modal-login {\r\n    max-width: 375px;\r\n    width: 35%;\r\n    position: absolute;\r\n    top: 50%;\r\n    right: 50%;\r\n    transform: translate(50%, -50%);\r\n    color: #ffffff;\r\n  }\r\n\r\n  .modal-ticketChange {\r\n    max-width: 575px;\r\n    width: 50%;\r\n    position: absolute;\r\n    top: 50%;\r\n    right: 50%;\r\n    transform: translate(50%, -50%);\r\n    color: #ffffff;\r\n  }\r\n\r\n  .modal-login .inner-content {\r\n    background-color: #ffffff;\r\n    padding: 30px;\r\n    border-radius: 10px 10px 10px 10px;\r\n    color: #000000;\r\n  }\r\n\r\n  .modal-ticketChange .inner-content {\r\n    background-color: #ffffff;\r\n    padding: 30px;\r\n    border-radius: 20px;\r\n    color: #000000;\r\n  }\r\n\r\n  .modal-button:hover {\r\n    cursor: pointer;\r\n  }\r\n\r\n  .stop-scrolling {\r\n    height: 100%;\r\n    overflow: hidden;\r\n  }\r\n\r\n  @media screen and (max-width:920px) {\r\n\r\n    .modal-login,\r\n    .modal-ticketChange {\r\n      width: 55%;\r\n    }\r\n  }\r\n\r\n  @media screen and (max-width:840px) {\r\n\r\n    .modal-login,\r\n    .modal-ticketChange {\r\n      width: 65%;\r\n    }\r\n  }\r\n\r\n  @media screen and (max-width:540px) {\r\n\r\n    .modal-login,\r\n    .modal-ticketChange {\r\n      width: 95%;\r\n    }\r\n  }\r\n  </style>\r\n  <!-- START OF MODAL -->\r\n  <aside id=\"modal\" class=\"modal\" style=\"display:none;\">\r\n    <div id=\"modal-overlay\" class=\"modal-overlay\"></div>\r\n    <div class=\"modal-container\">\r\n      <div id=\"modal-content\" class=\"modal-content\">\r\n        <!-- SOCIAL DISTANCING MODAL -->\r\n\r\n        <div id=\"modal-login\" class=\"modal-login\" style=\"display:none;\">\r\n          <!-- <div class=\"modal_title-container\">\r\n            <h3>Log in</h3>\r\n            <p>Log in to access your account</p>\r\n          </div> -->\r\n          <div class=\"inner-content\">\r\n            <div>\r\n              <form id=\"loginForm_Modal\" action=\"https://www.omniplexcinemas.co.uk/engine/myomniplex.php\" method=\"post\"\r\n                accept-charset=\"utf-8\">\r\n                <div class=\"OMP_formLine\">\r\n                  <div class=\"OMP_form100 OMP_form100-md\">\r\n                    <h4>Enter your details below</h4>\r\n                    <!-- <p>Don't have a account? <a href=\"/join/plans\">Join Now</a></p> -->\r\n                    <br />\r\n                  </div>\r\n                </div>  \r\n                <div class=\"OMP_formLine\">\r\n                  <div class=\"OMP_form100 OMP_form100-md\">\r\n                    <label>Email Address*</label>\r\n                    <div class=\"OMP_selectHolder\">\r\n                      <input type=\"email\" name=\"email\" required=\"required\" value=\"\" />\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                <div class=\"OMP_formLine\">\r\n                  <div class=\"OMP_form100 OMP_form100-md\">\r\n                    <label>Password*</label>\r\n                    <div class=\"OMP_selectHolder\">\r\n                      <input type=\"password\" name=\"password\" required=\"required\" value=\"\" />\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                <div class=\"OMP_formLine OMP_margin20-t\">\r\n                  <div class=\"OMP_form100 OMP_form100-md\">\r\n                    <input class=\"OMP_button OMP_buttonYellow OMP_buttonFullWidth\" type=\"submit\" value=\"Login\" />\r\n                  </div>\r\n                </div>\r\n                <div class=\"OMP_formLine\">\r\n                  <div class=\"OMP_form100 OMP_form100-md\">\r\n                    <input onclick=\"addRemoveHiddenInput('rememberMe-input', 'rememberMe-input', 'rememeber');\"\r\n                      type=\"checkbox\" checked style=\"vertical-align:-webkit-baseline-middle;\" name=\"rememberMe\"\r\n                      id=\"rememberMe\" value=\"\" />\r\n                    <label class=\"OMP_margin10-t rememberMe\" for=\"rememberMe\"\r\n                      style=\"display:inline-block; vertical-align:middle;\">Stay logged in.</label>\r\n                  </div>\r\n                </div>\r\n                <input type=\"hidden\" name=\"action\" value=\"processLogin\" />\r\n                <input type=\"hidden\" name=\"return\" value=\"https://www.omniplexcinemas.co.uk/myomnipass/login\" />\r\n                <input style=\"display:none;\" type=\"text\" name=\"rememberMe-input\" value=\"rememeber\"\r\n                  id=\"rememberMe-input\">\r\n              </form>\r\n              <script>\r\n              function addRemoveHiddenInput(id, name, value) {\r\n                if ($('#' + id).length > 0) {\r\n                  $('#' + id).remove();\r\n                } else {\r\n                  $('#loginForm_Modal').append('<input style=\"display:none;\" type=\"text\" name=\"' + name + '\" value=\"' +\r\n                    value + '\" id=\"' + id + '\" />');\r\n                }\r\n              }\r\n              </script>\r\n              <p class=\"OMP_margin10-t\">Forgotten your password? <a\r\n                  href=\"https://www.omniplexcinemas.co.uk/myomnipass/forgot\"><strong>Click here</strong></a>.</p>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div id=\"modal-ticketChange\" class=\"modal-ticketChange\" style=\"display:none;\">\r\n          <div class=\"inner-content\">\r\n            <div style=\"padding:20px;\">\r\n              <h3 style=\"text-align:center;text-transform:uppercase;\">Please Note:</h3>\r\n              <p style=\"padding:15px;text-align:center;\">Changes to non-Flexi bookings are subject to a change fee of\r\n                &euro;2.60/&pound;2.00 per ticket.</p>\r\n            </div>\r\n            <div style=\"padding:20px; text-align:center;\">\r\n              <a href=\"/ticketchange/nonflexi\">\r\n                <p style=\"font-size:18px; padding:15px 25px;background-color:#FFEA00;;width: fit-content;margin: auto;border-radius:10px;cursor:pointer;\"\r\n                  onclick=\"hideModal(1)\">Continue</p>\r\n              </a>\r\n              <p style=\"text-decoration:underline;font-size:18px; margin:auto; margin-top:20px;cursor:pointer; width:fit-content;\"\r\n                onclick=\"hideModal(1)\">Cancel</p>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div id=\"modal-ticketChange_blocked\" class=\"modal-ticketChange\" style=\"display:none;\">\r\n          <div class=\"inner-content\">\r\n            <div style=\"padding:20px;\">\r\n              <h3 style=\"text-align:center;text-transform:uppercase;\">SORRY:</h3>\r\n              <p style=\"padding:15px;text-align:center;font-size:18px;\">Only bookings made online are refundable.</p>\r\n            </div>\r\n            <div style=\"padding:20px; text-align:center;\">\r\n              <p style=\"text-decoration:underline;font-size:18px; margin:auto; margin-top:20px;cursor:pointer; width:fit-content;\"\r\n                onclick=\"hideModal(2)\">Close</p>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div id=\"modal-ticketChange_confirm\" class=\"modal-ticketChange\" style=\"display:none;\">\r\n          <div class=\"inner-content\">\r\n            <div style=\"padding:20px;\">\r\n              <h3 style=\"text-align:center;text-transform:uppercase;\">PLEASE NOTE:</h3>\r\n              <p style=\"padding:15px;text-align:center;font-size:18px;\">Tickets and food are <u>non-refundable</u> within 2 hours of your showtime.</p>\r\n            </div>\r\n            <a style=\"margin:auto; margin-top:20px; width:fit-content;\" href=\"/ticketchanges/refund\">\r\n              <p style=\"font-size:18px; padding:20px; text-align:center; background-color:#FFEA00; cursor:pointer;\">Proceed</p>\r\n            </a>\r\n            <div style=\"padding:20px; text-align:center;\">\r\n              <p style=\"text-decoration:underline;font-size:18px; margin:auto; margin-top:20px;cursor:pointer; width:fit-content;\"\r\n                onclick=\"hideModal(3)\">Cancel</p>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n      </div>\r\n    </div>\r\n    </div>\r\n  </aside>\r\n  <script>\r\n  var modal = document.getElementById(\"modal\");\r\n  var model_span = document.getElementsByClassName(\"modal-overlay\")[0];\r\n  var pop_up = localStorage.getItem('pop_up') || '';\r\n\r\n  var loginModal = document.getElementById('modal-login');\r\n  var ticketChangeModal = document.getElementById('modal-ticketChange');\r\n\r\n  var ticketChangeModal_blocked = document.getElementById('modal-ticketChange_blocked');\r\n  var ticketChangeModal_confirm = document.getElementById('modal-ticketChange_confirm');\r\n\r\n  function showModal(id = '') {\r\n    document.body.classList.add(\"stop-scrolling\");\r\n    modal.style.display = \"block\";\r\n    if (id == '') {\r\n      loginModal.style.display = \"block\";\r\n    }\r\n    if (id == 1) {\r\n      ticketChangeModal.style.display = \"block\";\r\n    }\r\n    if (id == 2) {\r\n      ticketChangeModal_blocked.style.display = \"block\";\r\n    }\r\n    if (id == 3) {\r\n      ticketChangeModal_confirm.style.display = \"block\";\r\n    }\r\n  }\r\n\r\n  model_span.onclick = function() {\r\n    hideModal();\r\n  }\r\n  window.onclick = function(event) {\r\n    if (event.target == modal) {\r\n      hideModal();\r\n    }\r\n  }\r\n\r\n  function hideModal(id = '') {\r\n    document.body.classList.remove(\"stop-scrolling\");\r\n    modal.style.display = \"none\";\r\n    if (id == '') {\r\n      loginModal.style.display = \"none\";\r\n      ticketChangeModal_confirm.style.display = \"none\";\r\n      ticketChangeModal_blocked.style.display = \"none\";\r\n    }\r\n    if (id == 1) {\r\n      ticketChangeModal.style.display = \"none\";\r\n    }\r\n    if (id == 2) {\r\n      ticketChangeModal_blocked.style.display = \"none\";\r\n    }\r\n    if (id == 3) {\r\n      ticketChangeModal_confirm.style.display = \"none\";\r\n    }\r\n  }\r\n  </script>\r\n  <!-- END OF MODAL -->\r\n\r\n\r\n  <link rel=\"stylesheet\" href=\"/include/A1CookieManager/css/main.css?v=20250609_01\" type=\"text/css\">\r\n<div id=\"cookieOverlay\" class=\"OMP_overlay\" style=\"pointer-events:none;\"></div>\r\n<div id=\"cookieConsentBar\" style=\"display: none;\">\r\n  <div class=\"cookie-consent-banner\">\r\n    <p>We use cookies on our website to personalise and improve your experience and ensure the website works\r\n      correctly.\r\n      <a style=\"text-decoration:underline;\" href=\"/company/privacy#cookieAnchor\" target=\"_blank\">View our Cookie Policy</a>.\r\n    </p>\r\n    <div class=\"cookie-buttons\">\r\n      \r\n    <button id=\"managePrefs\" onclick=\"toggleManage()\" class=\"cookie-button OMP_button OMP_buttonBlack\" id=\"manage-cookies\">Manage</button>\r\n      <button id=\"savePrefs\" onclick=\"checkCookiePerfs()\" class=\"cookie-button OMP_button OMP_buttonBlack\" style=\"display:none;\">Save Preferences</button>\r\n    <button id=\"acceptAll\" onclick=\"setCookieCookie('ALL')\" class=\"cookie-button OMP_button OMP_buttonYellow\">Accept All</button>\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"manageOptions\" style=\"display:none;\">\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Necessary</h3>\r\n                      <p>Necessary cookies are required to enable the basic features of this site, such as providing secure log-in or adjusting your consent preferences. These cookies do not store any personally identifiable data.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Necessary\"\r\n                                  checked                                  disabled>\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreNecessary')\">More Details</button>\r\n              <div id=\"moreNecessary\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                                                  <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> a1wcc</li>\r\n                              <li><strong>Duration:</strong> 1 year</li>\r\n                              <li><strong>Description:</strong> Stores the user&rsquo;s consent and preferences for website cookies. This cookie remembers the user&rsquo;s choices regarding the acceptance or rejection of specific cookie categories, ensuring personalized settings are applied on subsequent visits.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> PHPSESSID</li>\r\n                              <li><strong>Duration:</strong> Session</li>\r\n                              <li><strong>Description:</strong> Creates a unique session identifier for each visitor to maintain session data across multiple pages. It does not contain personal information and is deleted when the user closes their browser. This cookie is essential for enabling user functionalities and preferences during the active session.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> __cflb</li>\r\n                              <li><strong>Duration:</strong> 24 hours</li>\r\n                              <li><strong>Description:</strong> CloudFlare&rsquo;s session affinity cookie used to map your session to the correct server.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> sitecode</li>\r\n                              <li><strong>Duration:</strong> 1 hour</li>\r\n                              <li><strong>Description:</strong> The cinema location you have selected.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> omnicustomer</li>\r\n                              <li><strong>Duration:</strong> 2 weeks</li>\r\n                              <li><strong>Description:</strong> A token for the login, if &lsquo;stay logged in&rsquo; is selected.</li>\r\n                          </ul>\r\n                                                      </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Analytics</h3>\r\n                      <p>Analytical cookies are used to understand how visitors interact with the website. These cookies help provide information on metrics such as the number of visitors, bounce rate, traffic source, etc.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Analytics\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreAnalytics')\">More Details</button>\r\n              <div id=\"moreAnalytics\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                                                  <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _ga</li>\r\n                              <li><strong>Duration:</strong> 2 years</li>\r\n                              <li><strong>Description:</strong> Registers a unique ID that is used to generate statistical data on how the visitor uses the website.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _ga_C6EGS4GGTV</li>\r\n                              <li><strong>Duration:</strong> 2 years</li>\r\n                              <li><strong>Description:</strong> Used by Google Analytics to collect data on the number of times a user has visited the website as well as dates for the first and most recent visit.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _ga_Y8PVGSGW5G</li>\r\n                              <li><strong>Duration:</strong> 2 years</li>\r\n                              <li><strong>Description:</strong> Used to persist session state.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _gat_gtag_UA_2532751_2</li>\r\n                              <li><strong>Duration:</strong> 1 minute</li>\r\n                              <li><strong>Description:</strong> Used by Google Analytics to throttle request rate.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _gat_gtag_UA_56401285_6</li>\r\n                              <li><strong>Duration:</strong> 1 minute</li>\r\n                              <li><strong>Description:</strong> Used to throttle request rate.</li>\r\n                          </ul>\r\n                                                <ul class='cookieTable'>\r\n                              <li><strong>Cookie:</strong> _gid</li>\r\n                              <li><strong>Duration:</strong> 24 hours</li>\r\n                              <li><strong>Description:</strong> Registers a unique ID that is used to generate statistical data on how the visitor uses the website.</li>\r\n                          </ul>\r\n                                                      </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Functional</h3>\r\n                      <p>Functional cookies help perform certain functionalities like sharing the content of the website on social media platforms, collecting feedback, and other third-party features.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Functional\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreFunctional')\">More Details</button>\r\n              <div id=\"moreFunctional\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Performance</h3>\r\n                      <p>Performance cookies are used to understand and analyze the key performance indexes of the website which helps in delivering a better user experience for the visitors.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Performance\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('morePerformance')\">More Details</button>\r\n              <div id=\"morePerformance\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Advertisement</h3>\r\n                      <p>Advertisement cookies are used to provide visitors with customized advertisements based on the pages you visited previously and to analyze the effectiveness of the ad campaigns.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Advertisement\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreAdvertisement')\">More Details</button>\r\n              <div id=\"moreAdvertisement\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n        <div class=\"manageOption\">\r\n          <div class=\"manageOption-content\">\r\n              <div class=\"titleSwitchCon\">\r\n                  <div>\r\n                      <h3>Other</h3>\r\n                      <p>Other uncategorized cookies are those that are being analyzed and have not been classified into a category as yet.</p>\r\n                  </div>\r\n                  <div>\r\n                      <div class=\"manageOption-switch\">\r\n                          <label class=\"switch\" style=\"\">\r\n                              <input type=\"checkbox\" id=\"Other\"\r\n                                                                    >\r\n                              <span class=\"slider round\"></span>\r\n                          </label>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n              <button class=\"OMP_button OMP_buttonBlack showMoreCookie\" onclick=\"showMore('moreOther')\">More Details</button>\r\n              <div id=\"moreOther\" class=\"cookieTableContainer\" style=\"display:none;\">\r\n                                        <p>No cookies are used in this category.</p>\r\n                                </div>\r\n          </div>\r\n      </div>\r\n    </div>\r\n</div>\r\n\r\n<script type=\"text/javascript\" src=\"/include/A1CookieManager/script/main.js?v=20250609_01\"></script>\r\n      <div id=\"attributeCarousel\" style=\"background: linear-gradient(to bottom,#ffcd00,#ffe800);text-align:center;\">\r\n      <a href=\"/explore/omniplexmaxx\" target=\"_blank\" style=\"padding:0;margin:0;line-height:0;padding-top: 2px;\"><img style=\"height:22px;; padding:5px; margin:5px 5px;\" src=\"/images/site_attributes/MAXX.svg\" alt=\"MAXX\" class=\"inline-block mx-2\" /></a><a href=\"/explore/recline\" target=\"_blank\" style=\"padding:0;margin:0;line-height:0;padding-top: 2px;\"><img style=\"height:22px;; padding:5px; margin:5px 5px;\" src=\"/images/site_attributes/Recline.svg\" alt=\"Recline\" class=\"inline-block mx-2\" /></a><a href=\"/explore/omniplexdbox\" target=\"_blank\" style=\"padding:0;margin:0;line-height:0;padding-top: 2px;\"><img style=\"height:15px; padding:5px; margin:5px 5px;\" src=\"/images/site_attributes/D-BOX.svg\" alt=\"DBOX\" class=\"inline-block mx-2\" /></a><a href=\"/explore/parking\" target=\"_blank\" style=\"padding:0;margin:0;line-height:0;padding-top: 2px;\"><img style=\"height:22px;; padding:5px; margin:5px 5px;\" src=\"/images/site_attributes/FREEParking.svg\" alt=\"Parking\" class=\"inline-block mx-2\" /></a>    </div>\r\n\r\n  \r\n  <style>\r\n    #attributeCarousel { \r\n      display: flex;\r\n      text-align: center;\r\n      flex-direction: row;\r\n      justify-content: center; \r\n      align-items: center;\r\n    }\r\n    .a1c-viewport { overflow: hidden; width: 100%; }\r\n    .a1c-track { display: flex; transition: transform 250ms ease; will-change: transform; }\r\n    .a1c-slide { flex: 0 0 auto; display: flex; justify-content: center; align-items: center; }\r\n    .a1c-viewport { \r\n      cursor: grab;\r\n      touch-action: pan-y; /* Prevent horizontal scroll conflict on Safari */\r\n      -webkit-overflow-scrolling: auto;}\r\n    .a1c-viewport.is-dragging { cursor: grabbing; }\r\n    .alert-bar {\r\n      background: linear-gradient(to bottom,#971720,#c71e2a);\r\n      text-align: center;\r\n      color: #ffffff;\r\n      padding: 5px;\r\n      position: relative;\r\n      z-index: 1;\r\n      box-shadow: 0 8px 14px -6px rgba(0, 0, 0, 0.75);\r\n    }\r\n  </style>\r\n\r\n  <script> \r\n   (function(){\r\n  // ---- Config ----\r\n  const BREAKPOINTS = [\r\n    { width: 0,    items: 3 },   // < 640px\r\n    { width: 640,  items: 5 },   // >= 640px\r\n    { width: 1024, items: 7 }    // >= 1024px\r\n  ];\r\n  const REWIND = true;                // loop at ends\r\n  const AUTOPLAY_MS = 2500;           // advance every N ms\r\n  const PAUSE_ON_HOVER = true;\r\n  const DRAG_THRESHOLD_PX = 30;       // min drag delta to trigger a slide\r\n  const SELECTOR = '#attributeCarousel';\r\n\r\n  const root = document.querySelector(SELECTOR);\r\n  if (!root) return;\r\n\r\n  const originalHTML = root.innerHTML;\r\n\r\n  let state = {\r\n    built: false,\r\n    current: 0,\r\n    total: 0,\r\n    itemsVisible: 0,\r\n    viewport: null,\r\n    track: null,\r\n    slides: [],\r\n    autoplayTimer: null,\r\n    drag: {\r\n      active: false,\r\n      startX: 0,\r\n      lastX: 0,\r\n      startOffset: 0\r\n    }\r\n  };\r\n\r\n  function itemsForWidth(w) {\r\n    let items = BREAKPOINTS[0].items;\r\n    for (const bp of BREAKPOINTS) if (w >= bp.width) items = bp.items;\r\n    return items;\r\n  }\r\n\r\n  // --- robust width measurement (replaces didWrap / wrap-detection) ---\r\n  function totalContentWidth() {\r\n    const anchors = Array.from(root.querySelectorAll(':scope > a'));\r\n    return anchors.reduce((sum, el) => {\r\n      const cs = getComputedStyle(el);\r\n      const rectW = el.getBoundingClientRect().width; // includes padding/border\r\n      const ml = parseFloat(cs.marginLeft) || 0;\r\n      const mr = parseFloat(cs.marginRight) || 0;\r\n      return sum + rectW + ml + mr;\r\n    }, 0);\r\n  }\r\n\r\n  function buildCarousel() {\r\n    if (state.built) return;\r\n    const anchors = Array.from(root.querySelectorAll(':scope > a'));\r\n    state.total = anchors.length;\r\n\r\n    const viewport = document.createElement('div');\r\n    viewport.className = 'a1c-viewport';\r\n\r\n    const track = document.createElement('div');\r\n    track.className = 'a1c-track';\r\n\r\n    anchors.forEach(a => {\r\n      const slide = document.createElement('div');\r\n      slide.className = 'a1c-slide';\r\n      slide.appendChild(a);\r\n      track.appendChild(slide);\r\n    });\r\n\r\n    viewport.appendChild(track);\r\n    root.innerHTML = '';\r\n    root.appendChild(viewport);\r\n\r\n    state.viewport = viewport;\r\n    state.track = track;\r\n    state.slides = Array.from(track.children);\r\n    state.built = true;\r\n\r\n    wireDragging();\r\n    layout();\r\n    startAutoplay();\r\n    if (PAUSE_ON_HOVER) {\r\n      viewport.addEventListener('mouseenter', pauseAutoplay);\r\n      viewport.addEventListener('mouseleave', startAutoplay);\r\n    }\r\n    document.addEventListener('visibilitychange', () => {\r\n      if (document.hidden) pauseAutoplay(); else startAutoplay();\r\n    }, { passive: true });\r\n  }\r\n\r\n  function destroyCarousel() {\r\n    if (!state.built) return;\r\n    pauseAutoplay();\r\n    root.innerHTML = originalHTML;\r\n    state = {\r\n      built: false, current: 0, total: 0, itemsVisible: 0,\r\n      viewport: null, track: null, slides: [], autoplayTimer: null,\r\n      drag: { active:false, startX:0, lastX:0, startOffset:0 }\r\n    };\r\n  }\r\n\r\n  function layout() {\r\n    if (!state.built) return;\r\n    const vw = state.viewport.clientWidth;\r\n    state.itemsVisible = itemsForWidth(window.innerWidth);\r\n    const slideWidth = vw / state.itemsVisible;\r\n    state.slides.forEach(s => s.style.width = Math.floor(slideWidth) + 'px');\r\n\r\n    // clamp or rewind current\r\n    const maxIndex = Math.max(0, state.total - state.itemsVisible);\r\n    if (state.current > maxIndex) state.current = REWIND ? 0 : maxIndex;\r\n    update();\r\n  }\r\n\r\n  function update() {\r\n    const w = state.slides[0].clientWidth || 0;\r\n    const offset = state.current * w;\r\n    state.track.style.transition = 'transform 250ms ease';\r\n    state.track.style.transform = 'translateX(' + (-offset) + 'px)';\r\n  }\r\n\r\n  function slideBy(dir) {\r\n    const maxIndex = Math.max(0, state.total - state.itemsVisible);\r\n    let next = state.current + dir;\r\n    if (REWIND) {\r\n      if (next < 0) next = maxIndex;\r\n      if (next > maxIndex) next = 0;\r\n    } else {\r\n      next = Math.max(0, Math.min(maxIndex, next));\r\n    }\r\n    state.current = next;\r\n    update();\r\n  }\r\n\r\n  // ---- Autoplay ----\r\n  function startAutoplay() {\r\n    if (!state.built || AUTOPLAY_MS <= 0) return;\r\n    if (state.autoplayTimer || userIsTouching) return;\r\n    if (state.total <= state.itemsVisible) return; // nothing to page\r\n    state.autoplayTimer = setInterval(() => {\r\n      if (!state.drag.active && !userIsTouching) slideBy(1);\r\n    }, AUTOPLAY_MS);\r\n  }\r\n  function pauseAutoplay() {\r\n    if (state.autoplayTimer) {\r\n      clearInterval(state.autoplayTimer);\r\n      state.autoplayTimer = null;\r\n    }\r\n  }\r\n\r\n  let userIsTouching = false;\r\n  function startTouchTimer() {\r\n    userIsTouching = true;\r\n    pauseAutoplay();\r\n\r\n    // Safety timeout in case touchend is missed\r\n    setTimeout(() => userIsTouching = false, 1500);\r\n  }\r\n\r\n  // ---- Drag / Swipe ----\r\n  function wireDragging() {\r\n    const vp = state.viewport;\r\n    const onDown = (clientX) => {\r\n      state.drag.active = true;\r\n      state.drag.startX = clientX;\r\n      state.drag.lastX = clientX;\r\n      // freeze current transform as baseline\r\n      const slideW = state.slides[0].clientWidth || 0;\r\n      state.drag.startOffset = state.current * slideW;\r\n      state.track.style.transition = 'none';\r\n      vp.classList.add('is-dragging');\r\n      pauseAutoplay();\r\n    };\r\n    const onMove = (clientX) => {\r\n      if (!state.drag.active) return;\r\n      state.drag.lastX = clientX;\r\n      const dx = clientX - state.drag.startX;\r\n      const translate = -(state.drag.startOffset - dx);\r\n      state.track.style.transform = 'translateX(' + translate + 'px)';\r\n    };\r\n    const onUp = () => {\r\n      if (!state.drag.active) return;\r\n      const dx = state.drag.lastX - state.drag.startX;\r\n      state.drag.active = false;\r\n      vp.classList.remove('is-dragging');\r\n\r\n      if (Math.abs(dx) > DRAG_THRESHOLD_PX) {\r\n        slideBy(dx < 0 ? 1 : -1);\r\n      } else {\r\n        // snap back\r\n        state.track.style.transition = 'transform 200ms ease';\r\n        update();\r\n      }\r\n      // resume autoplay\r\n      startAutoplay();\r\n    };\r\n\r\n    // Mouse\r\n    vp.addEventListener('mousedown', e => { e.preventDefault(); onDown(e.clientX); });\r\n    window.addEventListener('mousemove', e => onMove(e.clientX), { passive: true });\r\n    window.addEventListener('mouseup', onUp);\r\n\r\n    // Touch\r\n    vp.addEventListener('touchstart', e => { if (!e.touches[0]) return; onDown(e.touches[0].clientX); }, { passive: true });\r\n    startTouchTimer();\r\n    vp.addEventListener('touchmove',  e => { if (!e.touches[0]) return; onMove(e.touches[0].clientX); }, { passive: true });\r\n    vp.addEventListener('touchend', onUp);\r\n    vp.addEventListener('touchcancel', onUp);\r\n  }\r\n\r\n  // ---- Build/teardown based on width (no didWrap) ----\r\n  function refresh() {\r\n    if (state.drag.active || userIsTouching) return; \r\n    \r\n    if (!state.built) {\r\n      const needsCarousel = totalContentWidth() > root.clientWidth + 1; // +1 to avoid jitter\r\n      if (needsCarousel) buildCarousel();\r\n    } else {\r\n      layout();\r\n      const totalWidth = totalContentWidth();\r\n      const canFit = totalWidth <= state.viewport.clientWidth + 1;\r\n      if (canFit) destroyCarousel();\r\n    }\r\n  }\r\n\r\n  // --- initialise after images load so widths are correct ---\r\n  window.addEventListener('DOMContentLoaded', () => {\r\n    const imgs = Array.from(root.querySelectorAll('img'));\r\n    const waitForImgs = imgs.map(img => {\r\n      return img.complete ? Promise.resolve() :\r\n        new Promise(res => { img.addEventListener('load', res, { once: true }); img.addEventListener('error', res, { once: true }); });\r\n    });\r\n\r\n    Promise.all(waitForImgs).then(() => {\r\n      refresh();\r\n      // a couple of extra passes for late layout / fonts\r\n      requestAnimationFrame(refresh);\r\n      setTimeout(refresh, 250);\r\n    });\r\n  });\r\n\r\n  let rAF = null;\r\n  window.addEventListener('resize', () => {\r\n    if (rAF) cancelAnimationFrame(rAF);\r\n    rAF = requestAnimationFrame(() => {\r\n      if (state.built) layout();\r\n      refresh();\r\n    });\r\n  });\r\n})();\r\n\r\n  </script>\r\n\r\n<div class=\"OMP_quickBookDesktop OMP_padding20-tb\" style=\"display: none;\">\r\n  <div class=\"quickBookBody OMP_bodyColumn\">\r\n      <form id=\"quickbook\" class=\"OMP_quickBookForm OMP_block\" name=\"book\" action=\"/booking\" method=\"post\">\r\n        <label class=\"labelText\">\r\n          Quick Book<span>:</span>\r\n        </label>\r\n        <div class=\"quickBookDropsContainer\">\r\n          <div class=\"OMP_splitContainer\">\r\n            <div class=\"OMP_selectHolder OMP_splitSection OMP_split25 OMP_margin5-lr\">\r\n              <i class=\"fas fa-chevron-down\"></i>\r\n              <select id=\"quickCinema\" name=\"sitecode\" required=\"required\">\r\n                <option value=\"0\" selected=\"selected\" disabled=\"disabled\">Choose Cinema</option>\r\n                <optgroup style=\"font-weight:900;font-size:13px;\" label=\"England\"><option value=\"OMP_BIRM\" id=\"birmingham-great-park\" data-thissite=\"OMP_BIRM\" data-sitecode=\"OMP_SUTT\">&nbsp;Birmingham - Great Park</option>\r\n<option value=\"OMP_HIWY\" id=\"high-wycombe\" data-thissite=\"OMP_HIWY\" data-sitecode=\"OMP_SUTT\">&nbsp;High Wycombe</option>\r\n<option value=\"OMP_IPSW\" id=\"ipswich\" data-thissite=\"OMP_IPSW\" data-sitecode=\"OMP_SUTT\">&nbsp;Ipswich</option>\r\n<option value=\"OMP_SUND\" id=\"sunderland\" data-thissite=\"OMP_SUND\" data-sitecode=\"OMP_SUTT\">&nbsp;Sunderland</option>\r\n<option selected=\"selected\" value=\"OMP_SUTT\" id=\"sutton\" data-thissite=\"OMP_SUTT\" data-sitecode=\"OMP_SUTT\">&nbsp;Sutton Surrey</option>\r\n<option value=\"OMP_WIGA\" id=\"wigan\" data-thissite=\"OMP_WIGA\" data-sitecode=\"OMP_SUTT\">&nbsp;Wigan</option>\r\n</optgroup><optgroup style=\"font-weight:900;font-size:13px;\" label=\"Scotland\"><option value=\"OMP_CLYD\" id=\"glasgow-clydebank\" data-thissite=\"OMP_CLYD\" data-sitecode=\"OMP_SUTT\">&nbsp;Clydebank</option>\r\n</optgroup><optgroup style=\"font-weight:900;font-size:13px;\" label=\"Northern Ireland\"><option value=\"OMP_ANTR\" id=\"antrim\" data-thissite=\"OMP_ANTR\" data-sitecode=\"OMP_SUTT\">&nbsp;Antrim</option>\r\n<option value=\"OMP_ARMA\" id=\"armagh\" data-thissite=\"OMP_ARMA\" data-sitecode=\"OMP_SUTT\">&nbsp;Armagh</option>\r\n<option value=\"OMP_BANB\" id=\"banbridge\" data-thissite=\"OMP_BANB\" data-sitecode=\"OMP_SUTT\">&nbsp;Banbridge</option>\r\n<option value=\"OMP_BANG\" id=\"bangor\" data-thissite=\"OMP_BANG\" data-sitecode=\"OMP_SUTT\">&nbsp;Bangor</option>\r\n<option value=\"OMP_DUDO\" id=\"belfast\" data-thissite=\"OMP_DUDO\" data-sitecode=\"OMP_SUTT\">&nbsp;Belfast - Dundonald</option>\r\n<option value=\"OMP_KENN\" id=\"kennedy-centre\" data-thissite=\"OMP_KENN\" data-sitecode=\"OMP_SUTT\">&nbsp;Belfast - Kennedy Centre</option>\r\n<option value=\"OMP_CARR\" id=\"carrickfergus\" data-thissite=\"OMP_CARR\" data-sitecode=\"OMP_SUTT\">&nbsp;Carrickfergus</option>\r\n<option value=\"OMP_CRAI\" id=\"craigavon\" data-thissite=\"OMP_CRAI\" data-sitecode=\"OMP_SUTT\">&nbsp;Craigavon</option>\r\n<option value=\"OMP_DERR\" id=\"derry\" data-thissite=\"OMP_DERR\" data-sitecode=\"OMP_SUTT\">&nbsp;Derry</option>\r\n<option value=\"OMP_DOWN\" id=\"downpatrick\" data-thissite=\"OMP_DOWN\" data-sitecode=\"OMP_SUTT\">&nbsp;Downpatrick</option>\r\n<option value=\"OMP_DUGA\" id=\"dungannon\" data-thissite=\"OMP_DUGA\" data-sitecode=\"OMP_SUTT\">&nbsp;Dungannon</option>\r\n<option value=\"OMP_LARN\" id=\"larne\" data-thissite=\"OMP_LARN\" data-sitecode=\"OMP_SUTT\">&nbsp;Larne</option>\r\n<option value=\"OMP_LISB\" id=\"lisburn\" data-thissite=\"OMP_LISB\" data-sitecode=\"OMP_SUTT\">&nbsp;Lisburn</option>\r\n<option value=\"OMP_NEWR\" id=\"newry\" data-thissite=\"OMP_NEWR\" data-sitecode=\"OMP_SUTT\">&nbsp;Newry</option>\r\n<option value=\"OMP_OMAG\" id=\"omagh\" data-thissite=\"OMP_OMAG\" data-sitecode=\"OMP_SUTT\">&nbsp;Omagh</option>\r\n</optgroup><optgroup style=\"font-weight:900;font-size:13px;\" label=\"Rep. of Ireland\"><option value=\"OMP_ARKL\" id=\"arklow\" data-thissite=\"OMP_ARKL\" data-sitecode=\"OMP_SUTT\">&nbsp;Arklow</option>\r\n<option value=\"OMP_BALL\" id=\"ballinasloe\" data-thissite=\"OMP_BALL\" data-sitecode=\"OMP_SUTT\">&nbsp;Ballinasloe</option>\r\n<option value=\"OMP_CARL\" id=\"carlow\" data-thissite=\"OMP_CARL\" data-sitecode=\"OMP_SUTT\">&nbsp;Carlow</option>\r\n<option value=\"OMP_MAHO\" id=\"cork\" data-thissite=\"OMP_MAHO\" data-sitecode=\"OMP_SUTT\">&nbsp;Cork</option>\r\n<option value=\"OMP_SCOT\" id=\"drogheda-scotch-hall\" data-thissite=\"OMP_SCOT\" data-sitecode=\"OMP_SUTT\">&nbsp;Drogheda - Scotch Hall</option>\r\n<option value=\"OMP_BALB\" id=\"balbriggan\" data-thissite=\"OMP_BALB\" data-sitecode=\"OMP_SUTT\">&nbsp;Dublin - Balbriggan</option>\r\n<option value=\"OMP_NUTG\" id=\"nutgrove\" data-thissite=\"OMP_NUTG\" data-sitecode=\"OMP_SUTT\">&nbsp;Dublin - Nutgrove</option>\r\n<option value=\"OMP_RATH\" id=\"dublin-rathmines\" data-thissite=\"OMP_RATH\" data-sitecode=\"OMP_SUTT\">&nbsp;Dublin - Rathmines</option>\r\n<option value=\"OMP_DUND\" id=\"dundalk\" data-thissite=\"OMP_DUND\" data-sitecode=\"OMP_SUTT\">&nbsp;Dundalk</option>\r\n<option value=\"OMP_GALW\" id=\"galway\" data-thissite=\"OMP_GALW\" data-sitecode=\"OMP_SUTT\">&nbsp;Galway - Salthill</option>\r\n<option value=\"OMP_KILL\" id=\"killarney\" data-thissite=\"OMP_KILL\" data-sitecode=\"OMP_SUTT\">&nbsp;Killarney</option>\r\n<option value=\"OMP_LIME\" id=\"limerick\" data-thissite=\"OMP_LIME\" data-sitecode=\"OMP_SUTT\">&nbsp;Limerick</option>\r\n<option value=\"OMP_LONG\" id=\"longford\" data-thissite=\"OMP_LONG\" data-sitecode=\"OMP_SUTT\">&nbsp;Longford</option>\r\n<option value=\"OMP_MONA\" id=\"monaghan\" data-thissite=\"OMP_MONA\" data-sitecode=\"OMP_SUTT\">&nbsp;Monaghan</option>\r\n<option value=\"OMP_MULL\" id=\"mullingar\" data-thissite=\"OMP_MULL\" data-sitecode=\"OMP_SUTT\">&nbsp;Mullingar</option>\r\n<option value=\"OMP_NENA\" id=\"nenagh\" data-thissite=\"OMP_NENA\" data-sitecode=\"OMP_SUTT\">&nbsp;Nenagh</option>\r\n<option value=\"OMP_ROSC\" id=\"roscommon\" data-thissite=\"OMP_ROSC\" data-sitecode=\"OMP_SUTT\">&nbsp;Roscommon</option>\r\n<option value=\"OMP_SHAN\" id=\"shannon\" data-thissite=\"OMP_SHAN\" data-sitecode=\"OMP_SUTT\">&nbsp;Shannon</option>\r\n<option value=\"OMP_SLIG\" id=\"sligo\" data-thissite=\"OMP_SLIG\" data-sitecode=\"OMP_SUTT\">&nbsp;Sligo</option>\r\n<option value=\"OMP_TRAL\" id=\"tralee\" data-thissite=\"OMP_TRAL\" data-sitecode=\"OMP_SUTT\">&nbsp;Tralee</option>\r\n<option value=\"OMP_WATE\" id=\"waterford\" data-thissite=\"OMP_WATE\" data-sitecode=\"OMP_SUTT\">&nbsp;Waterford</option>\r\n<option value=\"OMP_WEXF\" id=\"wexford\" data-thissite=\"OMP_WEXF\" data-sitecode=\"OMP_SUTT\">&nbsp;Wexford</option>\r\n</optgroup> \r\n              </select>\r\n            </div>\r\n            <div class=\"OMP_selectHolder OMP_splitSection OMP_split25 OMP_margin5-lr\">\r\n              <i class=\"fas fa-chevron-down\"></i>\r\n              <select id=\"quickMovie\" name=\"event\" required=\"required\">\r\n                <option value=\"0\" selected=\"selected\" disabled=\"disabled\">Choose Movie</option>\r\n                                  <script>\r\n                    $(document).ready(function() {\r\n                      if($( window ).width() > 768) {\r\n                        quickBookGetEvents('OMP_SUTT'); \r\n                      }\r\n                    });\r\n                  </script>\r\n                              </select>\r\n            </div>\r\n            <div class=\"OMP_selectHolder OMP_splitSection OMP_split25 OMP_margin5-lr\">\r\n              <i class=\"fas fa-chevron-down\"></i>\r\n              <select id=\"quickDate\" name=\"date\" required=\"required\">\r\n                <option value=\"0\" selected=\"selected\" disabled=\"disabled\">Choose Date</option>\r\n              </select>\r\n            </div>\r\n            <div class=\"OMP_selectHolder OMP_splitSection OMP_split25 OMP_margin5-lr\">\r\n              <i class=\"fas fa-chevron-down\"></i>\r\n              <select id=\"quickTime\" name=\"performance\" required=\"required\">\r\n                <option value=\"0\" selected=\"selected\" disabled=\"disabled\">Choose Time</option>\r\n              </select>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <!-- <input class=\"formButton OMP_button OMP_buttonYellow OMP_inline\" type=\"submit\" value=\"Book Tickets\" /> -->\r\n        <a href=\"#\" id=\"quickBookButton\" onclick=\"$('#quickbook').submit();return false;\" class=\"formButton OMP_button OMP_buttonYellow OMP_inline\">Book Tickets</a>\r\n      </form>\r\n  </div>\r\n</div>\r\n<div class=\"OMP_bannerContainer\">\r\n  <div id=\"featureCarousel\" class=\"OMP_slider\">\r\n<div class=\"OMP_sliderItem\">\r\n  <img class=\"bg\" src=\"/cms/bannermanager/Ipswich 5.95 Web Slider.webp\" alt=\"The Running Man\" />\r\n</div>\r\n<div class=\"OMP_sliderItem\">\r\n<div class=\"OMP_filmInfoBar\">\r\n<div class=\"OMP_filmInfo OMP_bodyColumnSlider\">\r\n<div class=\"OMP_splitContainer\">\r\n<div class=\"OMP_splitSection OMP_split20 OMP_hide-lg OMP_vAlignBottom\">\r\n<div class=\"OMP_imageContainer\">\r\n<img class=\"poster OMP_imageRounded\" src=\"/cms/The Running Man Web Poster.webp\" alt=\"The Running Man\" />\r\n</div>\r\n</div>\r\n<div class=\"OMP_splitSection OMP_split80 OMP_split100-lg OMP_vAlignBottom\">\r\n<div class=\"OMP_titleContainer\">\r\n<div class=\"OMP_titleSection\">\r\n<div class=\"title\">\r\n<h2>The Running Man</h2>\r\n</div>\r\n</div>\r\n<div class=\"OMP_infoSection OMP_vAlignMiddle\">\r\n<div class=\"infoHolder OMP_alignLeft OMP_vAlignMiddle OMP_margin5-b-md\">\r\n<div class=\"OMP_block OMP_100w\"><p class=\"OMP_inlineBlock OMP_vAlignMiddle OMP_exlargeText OMP_colourE\">Thriller</p><img title=\"IFCO - 15A\" class=\"OMP_elementsIE OMP_vAlignMiddle OMP_margin20-l OMP_margin5-l-md\" src=\"/images/ratings/IE_15A.png\" /><img title=\"BBFC - 15\" class=\"OMP_elementsUK OMP_vAlignMiddle OMP_margin20-l OMP_margin5-l-md\" src=\"/images/ratings/UK_15.png\" /></div>\r\n</div>\r\n<div class=\"OMP_buttonHolder OMP_vAlignMiddle\">\r\n<div class=\"OMP_buttonSection OMP_alignRight\">\r\n<a class=\"OMP_button OMP_buttonYellow OMP_buttonShort-md OMP_vAlignTop OMP_floatLeft-md OMP_margin20-r\" href=\"/whatson/movie/showtimes/the-running-man\">Book Now</a>\r\n<i class=\"far fa-play-circle\" onclick=\"return showTrailer('KD18ddeFuyM');\"></i>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n  <img class=\"bg\" src=\"/cms/The Running Man Web Slider.webp\" alt=\"The Running Man\" />\r\n</div>\r\n<div class=\"OMP_sliderItem\">\r\n<div class=\"OMP_filmInfoBar\">\r\n<div class=\"OMP_filmInfo OMP_bodyColumnSlider\">\r\n<div class=\"OMP_splitContainer\">\r\n<div class=\"OMP_splitSection OMP_split20 OMP_hide-lg OMP_vAlignBottom\">\r\n<div class=\"OMP_imageContainer\">\r\n<img class=\"poster OMP_imageRounded\" src=\"/cms/Predator Badlands Web Poster copy.webp\" alt=\"Predator: Badlands\" />\r\n</div>\r\n</div>\r\n<div class=\"OMP_splitSection OMP_split80 OMP_split100-lg OMP_vAlignBottom\">\r\n<div class=\"OMP_titleContainer\">\r\n<div class=\"OMP_titleSection\">\r\n<div class=\"title\">\r\n<h2>Predator: Badlands</h2>\r\n</div>\r\n</div>\r\n<div class=\"OMP_infoSection OMP_vAlign