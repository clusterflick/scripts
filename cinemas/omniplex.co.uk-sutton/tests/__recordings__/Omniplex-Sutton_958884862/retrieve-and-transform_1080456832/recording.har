=\"OMP_GALW\" data-sitecode=\"\">&nbsp;Galway - Salthill</option>\r\n<option value=\"OMP_KILL\" id=\"killarney\" data-thissite=\"OMP_KILL\" data-sitecode=\"\">&nbsp;Killarney</option>\r\n<option value=\"OMP_LIME\" id=\"limerick\" data-thissite=\"OMP_LIME\" data-sitecode=\"\">&nbsp;Limerick</option>\r\n<option value=\"OMP_LONG\" id=\"longford\" data-thissite=\"OMP_LONG\" data-sitecode=\"\">&nbsp;Longford</option>\r\n<option value=\"OMP_MONA\" id=\"monaghan\" data-thissite=\"OMP_MONA\" data-sitecode=\"\">&nbsp;Monaghan</option>\r\n<option value=\"OMP_MULL\" id=\"mullingar\" data-thissite=\"OMP_MULL\" data-sitecode=\"\">&nbsp;Mullingar</option>\r\n<option value=\"OMP_NENA\" id=\"nenagh\" data-thissite=\"OMP_NENA\" data-sitecode=\"\">&nbsp;Nenagh</option>\r\n<option value=\"OMP_ROSC\" id=\"roscommon\" data-thissite=\"OMP_ROSC\" data-sitecode=\"\">&nbsp;Roscommon</option>\r\n<option value=\"OMP_SHAN\" id=\"shannon\" data-thissite=\"OMP_SHAN\" data-sitecode=\"\">&nbsp;Shannon</option>\r\n<option value=\"OMP_SLIG\" id=\"sligo\" data-thissite=\"OMP_SLIG\" data-sitecode=\"\">&nbsp;Sligo</option>\r\n<option value=\"OMP_TRAL\" id=\"tralee\" data-thissite=\"OMP_TRAL\" data-sitecode=\"\">&nbsp;Tralee</option>\r\n<option value=\"OMP_WATE\" id=\"waterford\" data-thissite=\"OMP_WATE\" data-sitecode=\"\">&nbsp;Waterford</option>\r\n<option value=\"OMP_WEXF\" id=\"wexford\" data-thissite=\"OMP_WEXF\" data-sitecode=\"\">&nbsp;Wexford</option>\r\n</optgroup> \r\n              </select>\r\n            </div>\r\n            <div class=\"OMP_selectHolder OMP_splitSection OMP_split25 OMP_margin5-lr\">\r\n              <i class=\"fas fa-chevron-down\"></i>\r\n              <select id=\"quickMovie\" name=\"event\" required=\"required\">\r\n                <option value=\"0\" selected=\"selected\" disabled=\"disabled\">Choose Movie</option>\r\n                              </select>\r\n            </div>\r\n            <div class=\"OMP_selectHolder OMP_splitSection OMP_split25 OMP_margin5-lr\">\r\n              <i class=\"fas fa-chevron-down\"></i>\r\n              <select id=\"quickDate\" name=\"date\" required=\"required\">\r\n                <option value=\"0\" selected=\"selected\" disabled=\"disabled\">Choose Date</option>\r\n              </select>\r\n            </div>\r\n            <div class=\"OMP_selectHolder OMP_splitSection OMP_split25 OMP_margin5-lr\">\r\n              <i class=\"fas fa-chevron-down\"></i>\r\n              <select id=\"quickTime\" name=\"performance\" required=\"required\">\r\n                <option value=\"0\" selected=\"selected\" disabled=\"disabled\">Choose Time</option>\r\n              </select>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <!-- <input class=\"formButton OMP_button OMP_buttonYellow OMP_inline\" type=\"submit\" value=\"Book Tickets\" /> -->\r\n        <a href=\"#\" id=\"quickBookButton\" onclick=\"$('#quickbook').submit();return false;\" class=\"formButton OMP_button OMP_buttonYellow OMP_inline\">Book Tickets</a>\r\n      </form>\r\n  </div>\r\n</div>\r\n<div class=\"OMP_bannerContainer\">\r\n  <div class=\"OMP_pageBanner\">\r\n<div class=\"OMP_pageBannerBlur\"  style=\"background-image: url(https://www.omniplexcinemas.co.uk/filmimages/large/ASDPPPP47.jpg?v=1526553431); background-position: 50%;\"></div>\r\n<div class=\"OMP_bodyColumnFeatureNarrow OMP_100h\">\r\n<div class=\"OMP_pageBannerContainer OMP_margin30-b\">\r\n<h1 class=\"OMP_bannerTitle OMP_margin5-b\">La Traviata - Live From Royal Ballet (2026)</h1>\r\n<div class=\"OMP_block OMP_margin10-t OMP_padding30-b OMP_padding0-md\"><img class=\"OMP_ratingImg\" src=\"/images/ratings/IE_TBC.png\"><div class=\"OMP_inlineBlock OMP_padding10-l\"><p class=\"OMP_note OMP_block\"><strong>Running Time</strong></p><p class=\"OMP_note OMP_block\"></p></div></div></div>\r\n</div>\r\n</div>\r\n  <div id=\"homeSelectBanner\" class=\"OMP_homeSiteSelect OMP_bgTransparent\">\r\n    <div class=\"OMP_bodyColumnFeature\">\r\n      <div class=\