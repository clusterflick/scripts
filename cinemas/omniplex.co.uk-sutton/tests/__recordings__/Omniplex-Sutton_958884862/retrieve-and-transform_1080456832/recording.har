=\"disabled\">Choose Date</option>\r\n              </select>\r\n            </div>\r\n            <div class=\"OMP_selectHolder OMP_splitSection OMP_split25 OMP_margin5-lr\">\r\n              <i class=\"fas fa-chevron-down\"></i>\r\n              <select id=\"quickTime\" name=\"performance\" required=\"required\">\r\n                <option value=\"0\" selected=\"selected\" disabled=\"disabled\">Choose Time</option>\r\n              </select>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <!-- <input class=\"formButton OMP_button OMP_buttonYellow OMP_inline\" type=\"submit\" value=\"Book Tickets\" /> -->\r\n        <a href=\"#\" id=\"quickBookButton\" onclick=\"$('#quickbook').submit();return false;\" class=\"formButton OMP_button OMP_buttonYellow OMP_inline\">Book Tickets</a>\r\n      </form>\r\n  </div>\r\n</div>\r\n<div class=\"OMP_bannerContainer\">\r\n  <div class=\"OMP_pageBanner\">\r\n<div class=\"OMP_pageBannerBlur\"  style=\"background-image: url(https://www.omniplexcinemas.co.uk/cms/Regretting You Web Poster.webp); background-position: 50%;\"></div>\r\n<div class=\"OMP_bodyColumnFeatureNarrow OMP_100h\">\r\n<div class=\"OMP_pageBannerContainer OMP_margin30-b\">\r\n<h1 class=\"OMP_bannerTitle OMP_margin5-b\">Regretting You</h1>\r\n<div class=\"OMP_block OMP_margin10-t OMP_padding30-b OMP_padding0-md\"><img class=\"OMP_ratingImg\" src=\"/images/ratings/IE_12A.png\"><div class=\"OMP_inlineBlock OMP_padding10-l\"><p class=\"OMP_note OMP_block\"><strong>Running Time</strong></p><p class=\"OMP_note OMP_block\"></p></div></div></div>\r\n</div>\r\n</div>\r\n  <div id=\"homeSelectBanner\" class=\"OMP_homeSiteSelect OMP_bgTransparent\">\r\n    <div class=\"OMP_bodyColumnFeature\">\r\n      <div class=\"sitePickerWrapper OMP_padding10-tb\">\r\n        <div><h2>Find out what's on at:</h2></div>\r\n        <div class=\"homeSelectCinemaForm OMP_inlineBlock\">\r\n<div class=\"OMP_selectHolder OMP_dropDown\">\r\n<form method=\"post\" id=\"homeSele