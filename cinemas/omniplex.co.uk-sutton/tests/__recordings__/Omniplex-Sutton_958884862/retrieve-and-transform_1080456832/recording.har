es\">\r\n              <div class=\"OMP_accordionButton\"><h6>Cinema Features<span class=\"OMP_chevron\"></span></h6></div>\r\n              <div class=\"OMP_accordionContent\" style=\"display: none;\">\r\n                <a href=\"https://www.omniplexcinemas.co.uk/explore/omniplexmaxx\">Omniplex MAXX</a><br />\r\n<a href=\"https://www.omniplexcinemas.co.uk/explore/omniplexdluxx\">Omniplex D&#039;LUXX</a><br />\r\n<a href=\"https://www.omniplexcinemas.co.uk/explore/omniplexlux\">Omniplex LUX</a><br />\r\n<a href=\"https://www.omniplexcinemas.co.uk/explore/joes\">Joe&#039;s Food Truck</a><br />\r\n<a href=\"https://www.omniplexcinemas.co.uk/explore/beerandcocktails\">Beer &amp; Cocktail Van</a><br />\r\n<a href=\"https://www.omniplexcinemas.co.uk/explore/fromthekitchen\">From the kitchen</a><br />\r\n<a href=\"https://www.omniplexcinemas.co.uk/explore/theavenue\">The Avenue</a><br />\r\n<a href=\"https://www.omniplexcinemas.co.uk/explore/omniplexdbox\">DBOX</a><br />\r\n<a href=\"https://www.omniplexcinemas.co.uk/explore/recline\">Recline</a><br />\r\n<a href=\"https://www.omniplexcinemas.co.uk/explore/sofabed\">SofaBed</a><br />\r\n<a href=\"https://www.omniplexcinemas.co.uk/explore/sofaandarmchair\">Sofa and Armchairs</a><br />\r\n<a href=\"https://www.omniplexcinemas.co.uk/explore/kidsclub\">Kids Club</a><br />\r\n<a href=\"https://www.omniplexcinemas.co.uk/explore/meerkatmovies\">Meerkat Movies</a><br />\r\n              </div>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"OMP_footerBarBottom\">\r\n      <div class=\"OMP_social\">\r\n        <a class=\"facebook\" href=\"https://www.facebook.com/omniplexcinemas\" target=\"_blank\"></a>\r\n        <a class=\"twitter\" href=\"https://twitter.com/omniplexcinema\" target=\"_blank\"></a>\r\n        <a class=\"youtube\" href=\"http://www.youtube.com/user/OmniplexCinemas\" target=\"_blank\"></a>\r\n      </div>\r\n      <div class=\"OMP_copyright OMP_padding30