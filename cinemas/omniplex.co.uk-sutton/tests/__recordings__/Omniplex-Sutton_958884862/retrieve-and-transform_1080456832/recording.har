            "text": "<!DOCTYPE html>\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n\r\n<head>\r\n  <title>The Running Man | Cinema Showtimes</title>\r\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=iso-8859-1\" />\r\n  <meta name=\"name\" content=\"The Running Man playing at Omniplex Cinemas, browse the latest showtimes and purchase your tickets online today!\" />\r\n  <meta name=\"description\" content=\"The Running Man playing at Omniplex Cinemas, browse the latest showtimes and purchase your tickets online today!\" />\r\n  <meta name=\"keywords\" content=\"Omniplex Cinemas, Cinema in Ireland, Cinema, Movies, Films, MAXX Movies, 3D Movies, Book Tickets, Cinema Tickets, Cinema Times, Movies Times, \" />\r\n  <meta name=\"author\" content=\"Collaborative Software Limited\" />\r\n  <meta name=\"copyright\" content=\"Collaborative Software Limited\" />\r\n  <meta name=\"robots\" content=\"index,follow\" />\r\n\t\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0\" />\r\n\r\n  <meta name=\"twitter:card\" content=\"summary\" />\r\n  <meta name=\"twitter:site\" content=\"@omniplexcinema\" />\r\n  <meta name=\"twitter:creator\" content=\"@omniplexcinema\" />\r\n  <meta data-a1serv=\"omniweb4\" />\r\n  <meta data-a1php=\"8.0.27\" />\r\n  <meta data-a1phptime=\"20251111 13:51:59\" />\r\n  <meta data-a1mysqltime=\"20251111 13:51:58\" />\r\n\r\n  <meta property=\"og:title\" content=\"The Running Man | Cinema Showtimes\" />\r\n  <meta property=\"og:description\" content=\"The Running Man playing at Omniplex Cinemas, browse the latest showtimes and purchase your tickets online today!\" />\r\n  <meta property=\"og:type\" content=\"website\" />\r\n  <meta property=\"og:url\" content=\"http://www.omniplexcinemas.co.uk/whatson/movie/showtimes/the-running-man\" />\r\n  <meta property=\"og:image\" content=\"https://www.omniplexcinemas.co.uk/cms/The Running Man Web Poster.webp\" />\r\n  <meta property=\"og:image:typ