D1%26eventDisplay%3Dlist&#038;name=Stanley+Arts+London+Events+Archive+-+Stanley+Arts+London\"\n\t\tclass=\"tribe-events-c-subscribe-dropdown__list-item-link\"\n\t\ttarget=\"_blank\"\n\t\trel=\"noopener noreferrer nofollow noindex\"\n\t>\n\t\tOutlook 365\t</a>\n</li>\n\t\t\t\t\t\t\t\t\t\n<li class=\"tribe-events-c-subscribe-dropdown__list-item tribe-events-c-subscribe-dropdown__list-item--outlook-live\">\n\t<a\n\t\thref=\"https://outlook.live.com/owa?path=/calendar/action/compose&#038;rru=addsubscription&#038;url=webcal%3A%2F%2Fstanleyarts.org%2F%3Fpost_type%3Dtribe_events%26tribe_eventcategory%255B0%255D%3D240%26ical%3D1%26eventDisplay%3Dlist&#038;name=Stanley+Arts+London+Events+Archive+-+Stanley+Arts+London\"\n\t\tclass=\"tribe-events-c-subscribe-dropdown__list-item-link\"\n\t\ttarget=\"_blank\"\n\t\trel=\"noopener noreferrer nofollow noindex\"\n\t>\n\t\tOutlook Live\t</a>\n</li>\n\t\t\t\t\t\t\t\t\t\n<li class=\"tribe-events-c-subscribe-dropdown__list-item tribe-events-c-subscribe-dropdown__list-item--ics\">\n\t<a\n\t\thref=\"https://stanleyarts.org/events/list/?tribe_eventcategory%5B0%5D=240&#038;hide_subsequent_recurrences=1&#038;ical=1\"\n\t\tclass=\"tribe-events-c-subscribe-dropdown__list-item-link\"\n\t\ttarget=\"_blank\"\n\t\trel=\"noopener noreferrer nofollow noindex\"\n\t>\n\t\tExport .ics file\t</a>\n</li>\n\t\t\t\t\t\t\t\t\t\n<li class=\"tribe-events-c-subscribe-dropdown__list-item tribe-events-c-subscribe-dropdown__list-item--outlook-ics\">\n\t<a\n\t\thref=\"https://stanleyarts.org/events/list/?tribe_eventcategory%5B0%5D=240&#038;outlook-ical=1#038;hide_subsequent_recurrences=1&#038;ical=1\"\n\t\tclass=\"tribe-events-c-subscribe-dropdown__list-item-link\"\n\t\ttarget=\"_blank\"\n\t\trel=\"noopener noreferrer nofollow noindex\"\n\t>\n\t\tExport Outlook .ics file\t</a>\n</li>\n\t\t\t\t\t\t\t</ul>\n\t\t</div>\n\t</div>\n</div>\n\n\t\t<div class=\"tribe-events-after-html\">\n\t\n<!--\nThis calendar is powered by The Events Calendar.\nhttp://evnt.is/18wn\n-->\n</div>\n\n\t</div>\n</div>\n\n<script class=\"tribe-events-breakpoints\">\n\t( function () {\n\t\tvar completed = false;\n\n\t\tfunction initBreakpoints() {\n\t\t\tif ( completed ) {\n\t\t\t\t// This was fired already and completed no need to attach to the event listener.\n\t\t\t\tdocument.removeEventListener( 'DOMContentLoaded', initBreakpoints );\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\tif ( 'undefined' === typeof window.tribe ) {\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\tif ( 'undefined' === typeof window.tribe.events ) {\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\tif ( 'undefined' === typeof window.tribe.events.views ) {\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\tif ( 'undefined' === typeof window.tribe.events.views.breakpoints ) {\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\tif ( 'function' !== typeof (window.tribe.events.views.breakpoints.setup) ) {\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\tvar container = document.querySelectorAll( '[data-view-breakpoint-pointer=\"5fd9d5f1-0136-4873-9692-08977253b7e2\"]' );\n\t\t\tif ( ! container ) {\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\twindow.tribe.events.views.breakpoints.setup( container );\n\t\t\tcompleted = true;\n\t\t\t// This was fired already and completed no need to attach to the event listener.\n\t\t\tdocument.removeEventListener( 'DOMContentLoaded', initBreakpoints );\n\t\t}\n\n\t\t// Try to init the breakpoints right away.\n\t\tinitBreakpoints();\n\t\tdocument.addEventListener( 'DOMContentLoaded', initBreakpoints );\n\t})();\n</script>\n<script data-js='tribe-events-view-nonce-data' type='application/json'>{\"tvn1\":\"f726f5c156\",\"tvn2\":\"\"}</script></div>\n\t\t<section id=\"donate\" class=\"fade-in move-up\">\n\n\t\t\t<div class=\"grid-noBottom-centered\">\n\n\t\t\t\t<div class=\"col-4_sm-0 flexbox-center-hv\">\n\t\t\t\t\t<img src=\"https://stanleyarts.org/wp-content/themes/stanley/images/support-us.svg\" id=\"support-img\" alt=\"\" class=\"spin\" />\n\t\t\t\t</div>\n\n\t\t\t\t<div id=\"paypal-button\" class=\"col-11_sm-13_xs-16\">\n\n\t\t\t\t\t\n\t\t\t\t\t<h2 class=\"fs-page-header\">\n\t\t\t\t\t\tBecome a Regular Supporter\t\t\t\t\t</h2>\n\n\t\t\t\t\t<p>As a registered charity, Stanley Arts relies on donations to survive. Our Arts Council funding covers just 20% of our overall costs. Regular donors are a vital life line for our work. Just £5 a month could help us lift up talented young artists, support families and also care for our unique Grade II listed home. If you love Stanley Arts why not join the family and become a regular supporter. Now more than ever, we need your help.</p>\n\n\t\t\t\t\t\n\t\t\t\t\t<a href=\"https://donorbox.org/regular-supporters-1\" target=\"_blank\" class=\"square-button fs-button\">\n\t\t\t\t\t\tSign Up Today\t\t\t\t\t</a>\n\n\t        \t\t<!-- <form action=\"https://www.paypal.com/donate\" method=\"post\" target=\"_top\">\n\t\t\t\t\t\t<input type=\"hidden\" name=\"hosted_button_id\" value=\"TFEDGGMTC4UTC\" />\n\t\t\t\t\t\t<button name=\"submit\" aria-label=\"PayPal - The safer, easier way to pay online!\" class=\"square-button fs-button\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t<img alt=\"\" src=\"https://www.paypal.com/en_GB/i/scr/pixel.gif\" width=\"1\" height=\"1\" />\n\t\t\t\t\t</form> -->\n\n\t\t\t\t</div>\n\n\t\t\t</div>\n\n\t\t</section>\n\n\t\n\t<footer id=\"colophon\" class=\"site-footer\">\n\n\t\t\n\t\t<ul class=\"accordion-wrapper fade-in move-up move-up-1 show-mobile\">\n\n            <li class=\"accordion\">\n\n                <div class=\"accordion-header flexbox\">\n\n                    <h3 class=\"accordion-title fs-footer-title\">\n                        Visit us\n                    </h3>\n\n                    <span class=\"open-close\" role=\"button\" aria-label=\"Toggle Accordion\">\n                        <svg fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 12 7\">\n  <path d=\"M.9991 1L6.277 6l5.2778-5\" stroke=\"#000\"/>\n</svg>                    </span>\n\n                </div>\n\n                <div class=\"accordion-content\">\n\n                    \n\t\t\t\t\t\t<address>\n\t\t\t\t\t\t\tStanley Arts<br />\r\n12 South Norwood Hill<br />\r\nLondon<br />\r\nSE25 6AB<br />\r\nGet in touch<br />\r\n\t\t\t\t\t\t</address>\n\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\t<a href=\"https://www.google.co.uk/maps/place/The+Stanley+Halls/@51.400392,-0.07577,18.67z/data=!4m13!1m7!3m6!1s0x4876013ca43d40ad:0x3d9e5d9ef508ceb2!2sS+Norwood+Hill,+South+Norwood,+London+SE25+6AB!3b1!8m2!3d51.4005909!4d-0.0754453!3m4!1s0x4876013ca53fca2b:0x44533381315ee299!8m2!3d51.4001528!4d-0.0753057\" target=\"_blank\" class=\"underlined\">\n\t\t\t\t\t\t\tView on a map\n\t\t\t\t\t\t</a>\n\n\t\t\t\t\t\n                </div>\n\n            </li>\n\n            <li class=\"accordion\">\n\n                <div class=\"accordion-header flexbox\">\n\n                    <h3 class=\"accordion-title fs-footer-title\">\n                        Get in touch\n                    </h3>\n\n                    <span class=\"open-close\" role=\"button\" aria-label=\"Toggle Accordion\">\n                            <svg fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 12 7\">\n  <path d=\"M.9991 1L6.277 6l5.2778-5\" stroke=\"#000\"/>\n</svg>                    </span>\n\n                </div>\n\n                <div class=\"accordion-content\">\n\n                    \n\t\t\t\t\t\t<p>\n\t\t\t\t\t\t\t<strong>Office</strong><br>\n\t\t\t\t\t\t\t<a href=\"mailto:info@stanleyarts.org\" target=\"_blank\" aria-label=\"Email info@stanleyarts.org\">\n\t\t\t\t\t\t\t\tinfo@stanleyarts.org \n\t\t\t\t\t\t\t</a>\n\n\t\t\t\t\t\t</p>\n\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\t<p>\n\t\t\t\t\t\t\t<strong>Bookings</strong>\n\n\t\t\t\t\t\t\t<br>\n\n\t\t\t\t\t\t\t<a href=\"mailto:bookings@stanleyarts.org\" target=\"_blank\" aria-label=\"Email bookings@stanleyarts.org\">\n\t\t\t\t\t\t\t\tbookings@stanleyarts.org \n\t\t\t\t\t\t\t</a>\n\n\t\t\t\t\t\t\t<br>\n\n\t\t\t\t\t\t\t<a href=\"tel:+442082510184\" target=\"_blank\" aria-label=\"Call 020 8251 0184\