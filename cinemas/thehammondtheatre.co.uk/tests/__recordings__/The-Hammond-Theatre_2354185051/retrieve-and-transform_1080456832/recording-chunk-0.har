generated */\n.wp-block-button__link{color:#fff;background-color:#32373c;border-radius:9999px;box-shadow:none;text-decoration:none;padding:calc(.667em + 2px) calc(1.333em + 2px);font-size:1.125em}.wp-block-file__button{background:#32373c;color:#fff;text-decoration:none}\n/*# sourceURL=/wp-includes/css/classic-themes.min.css */\n</style>\n<style id=\"wp-block-styles-placeholder-inline-css\">\n:root { --wp-internal-comment: \"Placeholder for wp_hoist_late_printed_styles() to replace with the block styles printed at wp_footer.\" }\n/*# sourceURL=wp-block-styles-placeholder-inline-css */\n</style>\n<style id=\"wp-global-styles-placeholder-inline-css\">\n:root { --wp-internal-comment: \"Placeholder for wp_hoist_late_printed_styles() to replace with the global-styles printed at wp_footer.\" }\n/*# sourceURL=wp-global-styles-placeholder-inline-css */\n</style>\n<link rel='stylesheet' id='styles-css-css' href='https://www.thehammondtheatre.co.uk/wp-content/themes/hammond-theatre-23/public/css/styles.css?ver=1694460364' media='all' />\n<link rel=\"https://api.w.org/\" href=\"https://www.thehammondtheatre.co.uk/wp-json/\" /><link rel=\"alternate\" title=\"JSON\" type=\"application/json\" href=\"https://www.thehammondtheatre.co.uk/wp-json/wp/v2/events/2383\" /><link rel='shortlink' href='https://www.thehammondtheatre.co.uk/?p=2383' />\n<link rel=\"icon\" href=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2023/05/cropped-logo-small-32x32.png\" sizes=\"32x32\" />\n<link rel=\"icon\" href=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2023/05/cropped-logo-small-192x192.png\" sizes=\"192x192\" />\n<link rel=\"apple-touch-icon\" href=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2023/05/cropped-logo-small-180x180.png\" />\n<meta name=\"msapplication-TileImage\" content=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2023/05/cropped-logo-small-270x270.png\" />\n</head>\n\n<body class=\"wp-singular events-template-default single single-events postid-2383 wp-theme-hammond-theatre-23 antialiased debug-screens\">\n\t\n\t\t<!-- Google Tag Manager (noscript) -->\n\t<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-XXXXXXX\"\n\theight=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n\t<!-- End Google Tag Manager (noscript) -->\n\t\n\t\n\n\t\n\n\t\n    <!-- START DIV MAIN CONTENT -->\n\t<div id=\"page-wrap\" class=\"smooth-content\">\n        \n\t\t<a class=\"skip-link sr-only\" href=\"#content-wrap\">Skip to content</a>\n        \n            \r\n<div class=\"sticky top-0 bg-grey-500 z-30\">\r\n    <div class=\"container\">\r\n        <div class=\"flex justify-between items-center\">\r\n\r\n            <!-- Logo -->\r\n            <a class=\"w-200 md:w-300 p-10\" href=\"https://www.thehammondtheatre.co.uk\"><img src=\"https://www.thehammondtheatre.co.uk/wp-content/themes/hammond-theatre-23/public/img/logo.png\" alt=\"The Hammond Theatre logo\"></a>\r\n\r\n            <!-- Mobile Menu button -->\r\n            <div class=\"xl:hidden\">\r\n                <a class=\"toggle-menu w-50 h-50 inline-block relative z-50\" href=\"#\">\r\n                    <i class=\"absolute block h-2 bg-white w-30 left-0 transition-all duration-300 top-16\"></i>\r\n                    <i class=\"absolute block h-2 bg-white w-30 left-0 transition-all duration-300 top-24\"></i>\r\n                    <i class=\"absolute block h-2 bg-white w-30 left-0 transition-all duration-300 top-[32px]\"></i>\r\n                </a>\r\n            </div>\r\n\r\n            <!-- Mobile menu -->\r\n            <div class=\"menu-drawer w-screen bg-grey-500 h-screen absolute top-70 md:top-80 transition-all duration-300 p-50\">\r\n                \n<!-- Main Menu -->\n<menu class=\"xs:container text-white flex flex-col items-end text-right mb-30\">\n            <a href=\"https://www.thehammondtheatre.co.uk/\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            Home        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/whats-on\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            What’s On        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/visitor-information\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            Visitor Information        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/about-us\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            About Us        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/theatre-hire\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            Theatre Hire        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/contact-us\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            Contact Us        </a>\n    </menu>\n\n<!-- Top Menu -->\n<menu class=\"xs:container text-white flex flex-col items-end text-right\">\n            <a href=\"https://thehammondtheatre.us16.list-manage.com/subscribe/post?u=3324f533c59f945d0a73364d3&id=1853f3f636\" class=\"hover:text-yellow mb-10 uppercase font-futura text-12 tracking-widest \">\n            Sign up to our mailing list        </a>\n    </menu>            </div>\r\n\r\n            <!-- Desktop menu -->\r\n            <div class=\"hidden xl:block\">\r\n                <!-- Top Menu -->\n<menu class=\"flex justify-end text-white\">\n            <a href=\"https://thehammondtheatre.us16.list-manage.com/subscribe/post?u=3324f533c59f945d0a73364d3&id=1853f3f636\" class=\"hover:text-yellow pl-20 uppercase font-futura text-12 tracking-widest pb-[20px] \">\n            Sign up to our mailing list        </a>\n    </menu>\n\n<!-- Main Menu -->\n<menu class=\"flex justify-end text-white\">\n            <a href=\"https://www.thehammondtheatre.co.uk/\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            Home        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/whats-on\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            What’s On        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/visitor-information\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            Visitor Information        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/about-us\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            About Us        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/theatre-hire\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            Theatre Hire        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/contact-us\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            Contact Us        </a>\n    </menu>            </div>\r\n            \r\n        </div>\r\n    </div>\r\n</div>\r\n\t\t\n\t\t<div id=\"content-wrap\" class=\"min-h-screen\">\r\n\r\n    <main class=\"relative\">\r\n\r\n        <img loading=\"1\" role=\"presentation\" src=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/05/show-banner-2100x1050.png\" alt=\"\" srcset=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/05/show-banner-2100x1050.png 2100w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/05/show-banner-640x320.png 640w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/05/show-banner-400x200.png 400w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/05/show-banner-1280x640.png 1280w\" sizes=\"(max-width: 2100px) 100vw, 2100px\" class=\"w-full h-auto aspect-[19/6] object-cover pointer-events-none\"/>\r\n        <!-- Details -->\r\n        <div class=\"md:container\">\r\n            <div class=\"relative flex flex-wrap gap-y-20 justify-center sm:justify-evenly bg-grey-500 pt-20 md:px-30 lg:px-40 xl:px-50 pb-0 md:-top-50 items-center\">\r\n                <div class=\"w-1/2 sm:w-fit lg:w-2/6 text-center sm:text-left sm:mb-0 px-10\">\r\n                    <p class=\"text-yellow font-interface text-14 uppercase\">Type</p>\r\n                                            <p class=\"text-white font-futura text-18 xl:text-22 font-bold uppercase\">Dance School</p>\r\n                                    </div>\r\n                <div class=\"w-1/2 sm:w-fit lg:w-1/6 text-center sm:text-left sm:mb-0 px-10\">\r\n                    <p class=\"text-yellow font-interface text-14 uppercase\">Date</p>\r\n                                            <p class=\"text-white font-futura text-18 xl:text-22 font-bold uppercase\">11/07/2026</p>\r\n                                    </div>\r\n                <div class=\"w-1/2 sm:w-fit lg:w-1/6 text-center sm:text-left px-10\">\r\n                    <p class=\"text-yellow font-interface text-14 uppercase\">Doors Open</p>\r\n                                            <p class=\"text-white font-futura text-18 xl:text-22 font-bold uppercase\">2:30 pm</p>\r\n                                    </div>\r\n                <div class=\"w-1/2 sm:w-fit lg:w-1/6 text-center sm:text-left px-10\">\r\n                    <p class=\"text-yellow font-interface text-14 uppercase\">Starting Time</p>\r\n                                            <p class=\"text-white font-futura text-18 xl:text-22 font-bold uppercase\">3:00 pm</p>\r\n                                    </div>\r\n                <div class=\"lg:w-1/6 flex justify-end px-10\">\r\n                    <a class=\"button-yellow lg:px-0 lg:w-full xl:w-fit xl:px-30\" href=\"https://tickets.thehammondtheatre.co.uk/TheHammondTheatre.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_591993.TcsWebTab_591994.TcsPerformance_1610366\" target=\"_blank\">Book Now</a>\r\n                </div>\r\n\r\n\t\t\t\t                <div class=\"w-full bg-grey-200 text-center flex flex-col gap-10 xs:flex-row justify-evenly lg:mx-10 p-20 font-futura\">\r\n                    <p class=\"text-grey-500\">\r\n                        <span class=\"mr-10 uppercase\">Running Time:</span>\r\n                                                    <span class=\"mr-[1px] font-bold\">2:40</span>\r\n                            <span class=\"font-bold\">Hours</span>\r\n\t\t\t\t\t\t                    </p>\r\n                    <p class=\"text-grey-500\">\r\n                        <span class=\"mr-10 uppercase\">Intervals:</span>\r\n                                                    <span>1</span>\r\n                                            </p>\r\n                </div>\r\n\t\t\t\t            </div>\r\n        </div>\r\n\r\n        <!-- Titles -->\r\n        <div class=\"container lg:w-4/5 xl:w-3/5 lg:px-0 mx-auto mt-30 md:mt-0 -mb-40\">\r\n            <h1 class=\"text-36 font-futura uppercase text-center mb-10 font-bold\">UNIT 14 presents The 5 Year Spectacle</h1>\r\n            <h3 class=\"text-20 font-futura uppercase text-center mb-10\"></h3>\r\n            <p class=\"text-18 font-interface text-center text-black\"></p>\r\n        </div>\r\n\r\n        <!-- Content -->\r\n        <div class=\"container lg:px-0 relative z-10 py-40 md:py-60 flex justify-end mt-20\">\r\n            <div class=\"prose lg:w-4/5 xl:w-3/5 mx-auto \">\r\n\t\t\t\t<p>Rewind 5 years with us and follow the journey of the rise of UNIT 14. A show encompassing triumph, dedication, achievement, growth &amp; progression. Featuring street dance &amp; acrobatics, there is something from all ages for everyone to enjoy. Join us on the journey to now, and explore the love, friendship &amp; team spirit that makes UNIT 14 what it is today!</p>\n\r\n\t\t\t\t\t\t\t</div>\r\n        </div>\r\n\r\n\r\n\t\t<!-- Reviews -->\r\n\t\t\r\n\r\n        <!-- What Else Is On -->\r\n        \n\n    \n        <div class=\"bg-grey-100 z-20 relative\">\n            <div class=\"container pt-50 pb-100\">\n\n                <h2 class=\"text-36 text-center font-futura uppercase mb-20\">What else is on?</h2>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-30\">\n                                                        \n                        <div class=\"col-span-1 flex flex-col justify-between mt-20 xl:mt-0\">\n                            <div class=\"relative\">\n                                <a href=\"https://www.thehammondtheatre.co.uk/whats-on/unit-14-presents-the-5-year-spectacle\">\n                                    <img loading=\"lazy\" role=\"presentation\" src=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/05/UNIT-14.jpeg\" alt=\"\" srcset=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/05/UNIT-14.jpeg 583w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/05/UNIT-14-400x400.jpeg 400w\" sizes=\"(max-width: 583px) 100vw, 583px\" class=\"h-auto md:min-h-[220px] lg:min-h-[290px] xl:min-h-[170px] 2xl:min-h-[210px] w-full object-cover\"/>                                </a>\n                                <h3 class=\"mt-20 font-futura text-18 text-grey-400 uppercase\">UNIT 14 presents The 5 Year Spectacle</h3>\n                                <a href=\"https://www.thehammondtheatre.co.uk/whats-on/unit-14-presents-the-5-year-spectacle\"  class=\"absolute top-0 left-0 p-20 w-full flex items-center\">\n                                    <img class=\"w-20\" src=\"https://www.thehammondtheatre.co.uk/wp-content/themes/hammond-theatre-23/public/img/logo-icon.png\" alt=\"\">\n                                    <p class=\"relative text-white ml-10 text-14 font-future uppercase\">Dance School</p>\n                                </a>\n                                <time class=\"mt-10 text-18 text-grey-200\">Saturday 11 July </time>\n                            </div>\n                            <div>\n                            <div class=\"flex flex-col xs:flex-row justify-between gap-10 mt-15\">\n                                <a class=\"button-white-outline text-12 xs:text-14 w-full xs:w-1/2 px-0\" href=\"https://www.thehammondtheatre.co.uk/whats-on/unit-14-presents-the-5-year-spectacle\">Read More</a>\n                                <a class=\"button-yellow text-12 xs:text-14 w-full xs:w-1/2 px-0\" href=\"https://tickets.thehammondtheatre.co.uk/TheHammondTheatre.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_591993.TcsWebTab_591994.TcsPerformance_1610366\">Book Now</a>\n                            </div>\n                            </div>\n                        </div>\n                                                        \n                        <div class=\"col-span-1 flex flex-col justify-between mt-20 xl:mt-0\">\n                            <div class=\"relative\">\n                                <a href=\"https://www.thehammondtheatre.co.uk/whats-on/nt-live-the-misanthrope\">\n                                    <img loading=\"lazy\" role=\"presentation\" src=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/06/misanthrope-feature.png\" alt=\"\" srcset=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/06/misanthrope-feature.png 1280w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/06/misanthrope-feature-640x380.png 640w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/06/misanthrope-feature-400x238.png 400w\" sizes=\"(max-width: 1280px) 100vw, 1280px\" class=\"h-auto md:min-h-[220px] lg:min-h-[290px] xl:min-h-[170px] 2xl:min-h-[210px] w-full object-cover\"/>                                </a>\n                                <h3 class=\"mt-20 font-futura text-18 text-grey-400 uppercase\">NT Live: The Misanthrope</h3>\n                                <a href=\"https://www.thehammondtheatre.co.uk/whats-on/nt-live-the-misanthrope\"  class=\"absolute top-0 left-0 p-20 w-full flex items-center\">\n      