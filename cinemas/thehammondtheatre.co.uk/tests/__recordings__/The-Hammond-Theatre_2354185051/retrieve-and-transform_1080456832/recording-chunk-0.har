i.w.org/\" href=\"https://www.thehammondtheatre.co.uk/wp-json/\" /><link rel=\"alternate\" title=\"JSON\" type=\"application/json\" href=\"https://www.thehammondtheatre.co.uk/wp-json/wp/v2/events/2205\" /><link rel='shortlink' href='https://www.thehammondtheatre.co.uk/?p=2205' />\n<link rel=\"icon\" href=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2023/05/cropped-logo-small-32x32.png\" sizes=\"32x32\" />\n<link rel=\"icon\" href=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2023/05/cropped-logo-small-192x192.png\" sizes=\"192x192\" />\n<link rel=\"apple-touch-icon\" href=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2023/05/cropped-logo-small-180x180.png\" />\n<meta name=\"msapplication-TileImage\" content=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2023/05/cropped-logo-small-270x270.png\" />\n</head>\n\n<body class=\"wp-singular events-template-default single single-events postid-2205 wp-theme-hammond-theatre-23 antialiased debug-screens\">\n\t\n\t\t<!-- Google Tag Manager (noscript) -->\n\t<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-XXXXXXX\"\n\theight=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n\t<!-- End Google Tag Manager (noscript) -->\n\t\n\t\n\n\t\n\n\t\n    <!-- START DIV MAIN CONTENT -->\n\t<div id=\"page-wrap\" class=\"smooth-content\">\n        \n\t\t<a class=\"skip-link sr-only\" href=\"#content-wrap\">Skip to content</a>\n        \n            \r\n<div class=\"sticky top-0 bg-grey-500 z-30\">\r\n    <div class=\"container\">\r\n        <div class=\"flex justify-between items-center\">\r\n\r\n            <!-- Logo -->\r\n            <a class=\"w-200 md:w-300 p-10\" href=\"https://www.thehammondtheatre.co.uk\"><img src=\"https://www.thehammondtheatre.co.uk/wp-content/themes/hammond-theatre-23/public/img/logo.png\" alt=\"The Hammond Theatre logo\"></a>\r\n\r\n            <!-- Mobile Menu button -->\r\n            <div class=\"xl:hidden\">\r\n                <a class=\"toggle-menu w-50 h-50 inline-block relative z-50\" href=\"#\">\r\n                    <i class=\"absolute block h-2 bg-white w-30 left-0 transition-all duration-300 top-16\"></i>\r\n                    <i class=\"absolute block h-2 bg-white w-30 left-0 transition-all duration-300 top-24\"></i>\r\n                    <i class=\"absolute block h-2 bg-white w-30 left-0 transition-all duration-300 top-[32px]\"></i>\r\n                </a>\r\n            </div>\r\n\r\n            <!-- Mobile menu -->\r\n            <div class=\"menu-drawer w-screen bg-grey-500 h-screen absolute top-70 md:top-80 transition-all duration-300 p-50\">\r\n                \n<!-- Main Menu -->\n<menu class=\"xs:container text-white flex flex-col items-end text-right mb-30\">\n            <a href=\"https://www.thehammondtheatre.co.uk/\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            Home        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/whats-on\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            What’s On        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/visitor-information\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            Visitor Information        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/about-us\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            About Us        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/theatre-hire\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            Theatre Hire        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/contact-us\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            Contact Us        </a>\n    </menu>\n\n<!-- Top Menu -->\n<menu class=\"xs:container text-white flex flex-col items-end text-right\">\n            <a href=\"https://thehammondtheatre.us16.list-manage.com/subscribe/post?u=3324f533c59f945d0a73364d3&id=1853f3f636\" class=\"hover:text-yellow mb-10 uppercase font-futura text-12 tracking-widest \">\n            Sign up to our mailing list        </a>\n    </menu>            </div>\r\n\r\n            <!-- Desktop menu -->\r\n            <div class=\"hidden xl:block\">\r\n                <!-- Top Menu -->\n<menu class=\"flex justify-end text-white\">\n            <a href=\"https://thehammondtheatre.us16.list-manage.com/subscribe/post?u=3324f533c59f945d0a73364d3&id=1853f3f636\" class=\"hover:text-yellow pl-20 uppercase font-futura text-12 tracking-widest pb-[20px] \">\n            Sign up to our mailing list        </a>\n    </menu>\n\n<!-- Main Menu -->\n<menu class=\"flex justify-end text-white\">\n            <a href=\"https://www.thehammondtheatre.co.uk/\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            Home        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/whats-on\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            What’s On        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/visitor-information\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            Visitor Information        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/about-us\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            About Us        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/theatre-hire\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            Theatre Hire        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/contact-us\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            Contact Us        </a>\n    </menu>            </div>\r\n            \r\n        </div>\r\n    </div>\r\n</div>\r\n\t\t\n\t\t<div id=\"content-wrap\" class=\"min-h-screen\">\r\n\r\n    <main class=\"relative\">\r\n\r\n        <img loading=\"1\" role=\"presentation\" src=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/06/Hamlet-Banner.png\" alt=\"\" srcset=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/06/Hamlet-Banner.png 1440w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/06/Hamlet-Banner-640x200.png 640w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/06/Hamlet-Banner-400x125.png 400w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/06/Hamlet-Banner-1280x400.png 1280w\" sizes=\"(max-width: 1440px) 100vw, 1440px\" class=\"w-full h-auto aspect-[19/6] object-cover pointer-events-none\"/>\r\n        <!-- Details -->\r\n        <div class=\"md:container\">\r\n            <div class=\"relative flex flex-wrap gap-y-20 justify-center sm:justify-evenly bg-grey-500 pt-20 md:px-30 lg:px-40 xl:px-50 pb-20 md:-top-50 items-center\">\r\n                <div class=\"w-1/2 sm:w-fit lg:w-2/6 text-center sm:text-left sm:mb-0 px-10\">\r\n                    <p class=\"text-yellow font-interface text-14 uppercase\">Type</p>\r\n                                            <p class=\"text-white font-futura text-18 xl:text-22 font-bold uppercase\">NT Live</p>\r\n                                    </div>\r\n                <div class=\"w-1/2 sm:w-fit lg:w-1/6 text-center sm:text-left sm:mb-0 px-10\">\r\n                    <p class=\"text-yellow font-interface text-14 uppercase\">Date</p>\r\n                                            <p class=\"text-white font-futura text-18 xl:text-22 font-bold uppercase\">22/01/2026</p>\r\n                                    </div>\r\n                <div class=\"w-1/2 sm:w-fit lg:w-1/6 text-center sm:text-left px-10\">\r\n                    <p class=\"text-yellow font-interface text-14 uppercase\">Doors Open</p>\r\n                                            <p class=\"text-white font-futura text-18 xl:text-22 font-bold uppercase\">6:30 pm</p>\r\n                                    </div>\r\n                <div class=\"w-1/2 sm:w-fit lg:w-1/6 text-center sm:text-left px-10\">\r\n                    <p class=\"text-yellow font-interface text-14 uppercase\">Starting Time</p>\r\n                                            <p class=\"text-white font-futura text-18 xl:text-22 font-bold uppercase\">7:00 pm</p>\r\n                                    </div>\r\n                <div class=\"lg:w-1/6 flex justify-end px-10\">\r\n                    <a class=\"button-yellow lg:px-0 lg:w-full xl:w-fit xl:px-30\" href=\"https://tickets.thehammondtheatre.co.uk/TheHammondTheatre.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_277991.TcsWebTab_277992.TcsProgramme_1484076\" target=\"_blank\">Book Now</a>\r\n                </div>\r\n\r\n\t\t\t\t            </div>\r\n        </div>\r\n\r\n        <!-- Titles -->\r\n        <div class=\"container lg:w-4/5 xl:w-3/5 lg:px-0 mx-auto mt-30 md:mt-0 -mb-40\">\r\n            <h1 class=\"text-36 font-futura uppercase text-center mb-10 font-bold\">NT Live: Hamlet</h1>\r\n            <h3 class=\"text-20 font-futura uppercase text-center mb-10\">by William Shakespeare</h3>\r\n            <p class=\"text-18 font-interface text-center text-black\">directed by Robert Hastie</p>\r\n        </div>\r\n\r\n        <!-- Content -->\r\n        <div class=\"container lg:px-0 relative z-10 py-40 md:py-60 flex justify-end mt-20\">\r\n            <div class=\"prose lg:w-4/5 xl:w-3/5 mx-auto \">\r\n\t\t\t\t<p>Olivier Award-winner Hiran Abeysekera (Life of Pi) is Hamlet in this fearless, contemporary take on Shakespeare’s famous tragedy.</p>\n<p>&nbsp;</p>\n<p>Trapped between duty and doubt, surrounded by power and privilege, young Prince Hamlet dares to ask the ultimate question – you know the one.</p>\n<p>&nbsp;</p>\n<p>National Theatre Deputy Artistic Director, Robert Hastie (Standing at the Sky’s Edge, Operation Mincemeat) directs this sharp, stylish and darkly funny reimagining.</p>\n\r\n\t\t\t\t\t\t\t</div>\r\n        </div>\r\n\r\n\r\n\t\t<!-- Reviews -->\r\n\t\t\r\n\r\n        <!-- What Else Is On -->\r\n        \n\n    \n        <div class=\"bg-grey-100 z-20 relative\">\n            <div class=\"container pt-50 pb-100\">\n\n                <h2 class=\"text-36 text-center font-futura uppercase mb-20\">What else is on?</h2>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-30\">\n                                                        \n                        <div class=\"col-span-1 flex flex-col justify-between mt-20 xl:mt-0\">\n                            <div class=\"relative\">\n                                <a href=\"https://www.thehammondtheatre.co.uk/whats-on/nt-live-hamlet\">\n                                    <img loading=\"lazy\" role=\"presentation\" src=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/06/Hamlet-Feature.png\" alt=\"\" srcset=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/06/Hamlet-Feature.png 1280w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/06/Hamlet-Feature-640x380.png 640w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/06/Hamlet-Feature-400x238.png 400w\" sizes=\"(max-width: 1280px) 100vw, 1280px\" class=\"h-auto md:min-h-[220px] lg:min-h-[290px] xl:min-h-[170px] 2xl:min-h-[210px] w-full object-cover\"/>                                </a>\n                                <h3 class=\"mt-20 font-futura text-18 text-grey-400 uppercase\">NT Live: Hamlet</h3>\n                                <a href=\"https://www.thehammondtheatre.co.uk/whats-on/nt-live-hamlet\"  class=\"absolute top-0 left-0 p-20 w-full flex items-center\">\n                                    <img class=\"w-20\" src=\"https://www.thehammondtheatre.co.uk/wp-content/themes/hammond-theatre-23/public/img/logo-icon.png\" alt=\"\">\n                                    <p class=\"relative text-white ml-10 text-14 font-future uppercase\">NT Live</p>\n                                </a>\n                                <time class=\"mt-10 text-18 text-grey-200\">Thursday 22 January, 7.00pm</time>\n                            </div>\n                            <div>\n                            <div class=\"flex flex-col xs:flex-row justify-between gap-10 mt-15\">\n                                <a class=\"button-white-outline text-12 xs:text-14 w-full xs:w-1/2 px-0\" href=\"https://www.thehammondtheatre.co.uk/whats-on/nt-live-hamlet\">Read More</a>\n                                <a class=\"button-yellow text-12 xs:text-14 w-full xs:w-1/2 px-0\" href=\"https://tickets.thehammondtheatre.co.uk/TheHammondTheatre.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_277991.TcsWebTab_277992.TcsProgramme_1484076\">Book Now</a>\n                            </div>\n                            </div>\n                        </div>\n                                                        \n                        <div class=\"col-span-1 flex flex-col justify-between mt-20 xl:mt-0\">\n                            <div class=\"relative\">\n                                <a href=\"https://www.thehammondtheatre.co.uk/whats-on/grow\">\n                                    <img loading=\"lazy\" role=\"presentation\" src=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/01/Grow-featured.png\" alt=\"\" srcset=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/01/Grow-featured.png 1280w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/01/Grow-featured-640x380.png 640w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/01/Grow-featured-400x238.png 400w\" sizes=\"(max-width: 1280px) 100vw, 1280px\" class=\"h-auto md:min-h-[220px] lg:min-h-[290px] xl:min-h-[170px] 2xl:min-h-[210px] w-full object-cover\"/>                                </a>\n                                <h3 class=\"mt-20 font-futura text-18 text-grey-400 uppercase\">Grow</h3>\n                                <a href=\"https://www.thehammondtheatre.co.uk/whats-on/grow\"  class=\"absolute top-0 left-0 p-20 w-full flex items-center\">\n                                    <img class=\"w-20\" src=\"https://www.thehammondtheatre.co.uk/wp-content/themes/hammond-theatre-23/public/img/logo-icon.png\" alt=\"\">\n                                    <p class=\"relative text-white ml-10 text-14 font-future uppercase\">Cinema</p>\n                                </a>\n                                <time class=\"mt-10 text-18 text-grey-200\">Friday 20 February, 2.30pm</time>\n                            </div>\n                            <div>\n                            <div class=\"flex flex-col xs:flex-row justify-between gap-10 mt-15\">\n                                <a class=\"button-white-outline text-12 xs:text-14 w-full xs:w-1/2 px-0\" href=\"https://www.thehammondtheatre.co.uk/whats-on/grow\">Read More</a>\n                                <a class=\"button-yellow text-12 xs:text-14 w-full xs:w-1/2 px-0\" href=\"https://tickets.thehammondtheatre.co.uk/TheHammondTheatre.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_1050632.TcsWebTab_1050633.TcsPerformance_1562216.TcsSection_1197475\">Book Now</a>\n                            </div>\n                            </div>\n                        </div>\n                                                        \n                        <div class=\"col-span-1 flex flex-col justify-between mt-20 xl:mt-0\">\n                            <div class=\"relative\">\n                                <a href=\"https://www.thehammondtheatre.co.uk/whats-on/the-captain-calamity-half-term-hullabaloo\">\n                                    <img loading=\"lazy\" role=\"presentation\" src=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/01/CC-Feature.png\" alt=\"\" srcset=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/01/CC-Feature.png 1280w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/01/CC-Feature-640x380.png 640w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/01/CC-Feature-400x238.png 400w\" sizes=\"(max-width: 1280px) 100vw, 1280px\" class=\"h-auto md:min-h-[220px] lg:min-h-[290px] xl:min-h-[170px] 2xl:min-h-[210px] w-full object-cover\"/>                                </a>\n                                <h3 class=\"mt-20 font-futura text-18 text-grey-400 uppercase\">The Captain Calamity Half Term Hullabaloo</h3>\n                                <a href=\"https://www.thehammondtheatre.co.uk/whats-on/the-captain-calamity-half-term-hullabaloo\"  class=\"absolute top-0 left-0 p-20 w-full flex items-center\">\n                                    <img class=\"w-20\" src=\"https://www.thehammondtheatre.co.uk/wp-content/themes/hammond-theatre-23/public/img/logo-icon.png\" alt=\"\">\n                                    <p class=\"relative text-white ml-10 text-14 font-future uppercase\">Childrens</p>\n                                </a>\n                                <time class=\"mt-10 text-18 text-grey-200\">Saturday 21 February, 2.30pm</time>\n                            </div>\n                            <div>\n                            <div class=\"flex flex-col xs:flex-row justify-between gap-10 mt-15\">\n                                <a class=\"button-white-outline text-12 xs:text-14 w-full xs:w-1/2 px-0\" href=\"https://www.thehammondtheatre.co.uk/whats-on/the-captain-calamity-half-term-hullabaloo\">Read More</a>\n                                <a class=\"button-yellow text-12 xs:text-14 w-full xs:w-1/2 px-0\" href=\"https://tickets.thehammondtheatre.co.uk/TheHammondTheatre.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_1050632.TcsWebTab_1050633.TcsPerformance_1561113.TcsSection_1197475\">Book Now</a>\n                            </div>\n                            </div>\n                        </div>\n                                                        \n                        <div class=\"col-span-1 flex flex-col justify-between mt-20 xl:mt-0\">\n                            <div class=\"relative\">\n                                <a href=\"https://www.thehammondtheatre.co.uk/whats-on/nt-live-the-audience\">\n                                    <img loading=\"lazy\" role=\"presentation\" src=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/12/Featured-Audience.png\" alt=\"\" srcset=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/12/Featured-Audience.png 1280w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/12/Featured-Audience-640x380.png 640w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/12/Featured-Audience-400x238.png 400w\" sizes=\"(max-width: 1280px) 100vw, 1280px\" class=\"h-auto md:min-h-[220px] lg:min-h-[290px] xl:min-h-[170px] 2xl:min-h-[210px] w-full object-cover\"/>                                </a>\n                                <h3 class=\"mt-20 font-futura text-18 text-grey-400 uppercase\">NT Live: The Audience</h3>\n                                <a href=\"https://www.thehammondtheatre.co.uk/whats-on/nt-live-the-audience\"  class=\"absolute top-0 left-0 p-20 w-full flex items-center\">\n                                    <img class=\"w-20\" src=\"https://www.thehammondtheatre.co.uk/wp-content/themes/hammond-theatre-23/public/img/logo-icon.png\" alt=\"\">\n                                    <p class=\"relative text-white ml-10 text-14 font-future uppercase\">NT Live</p>\n                                </a>\n                                <time class=\"mt-10 text-18 text-grey-200\">Thursday 26 February, 7.00pm</time>\n                            </div>\n                            <div>\n                            <div class=\"flex flex-col xs:flex-row justify-between gap-10 mt-15\">\n                                <a class=\"button-white-outline text-12 xs:text-14 w-full xs:w-1/2 px-0\" hr