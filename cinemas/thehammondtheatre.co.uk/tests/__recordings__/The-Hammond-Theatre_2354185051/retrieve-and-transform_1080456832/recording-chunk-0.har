w.thehammondtheatre.co.uk/#website\",\"url\":\"https://www.thehammondtheatre.co.uk/\",\"name\":\"Hammond Theatre\",\"description\":\"\",\"potentialAction\":[{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://www.thehammondtheatre.co.uk/?s={search_term_string}\"},\"query-input\":{\"@type\":\"PropertyValueSpecification\",\"valueRequired\":true,\"valueName\":\"search_term_string\"}}],\"inLanguage\":\"en-US\"}]}</script>\n\t<!-- / Yoast SEO plugin. -->\n\n\n<link rel='dns-prefetch' href='//ajax.googleapis.com' />\n<link rel=\"alternate\" title=\"oEmbed (JSON)\" type=\"application/json+oembed\" href=\"https://www.thehammondtheatre.co.uk/wp-json/oembed/1.0/embed?url=https%3A%2F%2Fwww.thehammondtheatre.co.uk%2Fwhats-on%2Fthe-captain-calamity-half-term-hullabaloo\" />\n<link rel=\"alternate\" title=\"oEmbed (XML)\" type=\"text/xml+oembed\" href=\"https://www.thehammondtheatre.co.uk/wp-json/oembed/1.0/embed?url=https%3A%2F%2Fwww.thehammondtheatre.co.uk%2Fwhats-on%2Fthe-captain-calamity-half-term-hullabaloo&#038;format=xml\" />\n<style id='wp-img-auto-sizes-contain-inline-css' type='text/css'>\nimg:is([sizes=auto i],[sizes^=\"auto,\" i]){contain-intrinsic-size:3000px 1500px}\n/*# sourceURL=wp-img-auto-sizes-contain-inline-css */\n</style>\n<style id='wp-emoji-styles-inline-css' type='text/css'>\n\n\timg.wp-smiley, img.emoji {\n\t\tdisplay: inline !important;\n\t\tborder: none !important;\n\t\tbox-shadow: none !important;\n\t\theight: 1em !important;\n\t\twidth: 1em !important;\n\t\tmargin: 0 0.07em !important;\n\t\tvertical-align: -0.1em !important;\n\t\tbackground: none !important;\n\t\tpadding: 0 !important;\n\t}\n/*# sourceURL=wp-emoji-styles-inline-css */\n</style>\n<style id='classic-theme-styles-inline-css' type='text/css'>\n/*! This file is auto-generated */\n.wp-block-button__link{color:#fff;background-color:#32373c;border-radius:9999px;box-shadow:none;text-decoration:none;padding:calc(.667em + 2px) calc(1.333em + 2px);font-size:1.125em}.wp-block-file__button{background:#32373c;color:#fff;text-decoration:none}\n/*# sourceURL=/wp-includes/css/classic-themes.min.css */\n</style>\n<link rel='stylesheet' id='styles-css-css' href='https://www.thehammondtheatre.co.uk/wp-content/themes/hammond-theatre-23/public/css/styles.css?ver=1694460364' type='text/css' media='all' />\n<link rel=\"https://api.w.org/\" href=\"https://www.thehammondtheatre.co.uk/wp-json/\" /><link rel=\"alternate\" title=\"JSON\" type=\"application/json\" href=\"https://www.thehammondtheatre.co.uk/wp-json/wp/v2/events/2309\" /><link rel='shortlink' href='https://www.thehammondtheatre.co.uk/?p=2309' />\n<link rel=\"icon\" href=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2023/05/cropped-logo-small-32x32.png\" sizes=\"32x32\" />\n<link rel=\"icon\" href=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2023/05/cropped-logo-small-192x192.png\" sizes=\"192x192\" />\n<link rel=\"apple-touch-icon\" href=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2023/05/cropped-logo-small-180x180.png\" />\n<meta name=\"msapplication-TileImage\" content=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2023/05/cropped-logo-small-270x270.png\" />\n</head>\n\n<body class=\"wp-singular events-template-default single single-events postid-2309 wp-theme-hammond-theatre-23 antialiased debug-screens\">\n\t\n\t\t<!-- Google Tag Manager (noscript) -->\n\t<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-XXXXXXX\"\n\theight=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n\t<!-- End Google Tag Manager (noscript) -->\n\t\n\t\n\n\t\n\n\t\n    <!-- START DIV MAIN CONTENT -->\n\t<div id=\"page-wrap\" class=\"smooth-content\">\n        \n\t\t<a class=\"skip-link sr-only\" href=\"#content-wrap\">Skip to content</a>\n        \n            \r\n<div class=\"sticky top-0 bg-grey-500 z-30\">\r\n    <div class=\"container\">\r\n        <div class=\"flex justify-between items-center\">\r\n\r\n            <!-- Logo -->\r\n            <a class=\"w-200 md:w-300 p-10\" href=\"https://www.thehammondtheatre.co.uk\"><img src=\"https://www.thehammondtheatre.co.uk/wp-content/themes/hammond-theatre-23/public/img/logo.png\" alt=\"The Hammond Theatre logo\"></a>\r\n\r\n            <!-- Mobile Menu button -->\r\n            <div class=\"xl:hidden\">\r\n                <a class=\"toggle-menu w-50 h-50 inline-block relative z-50\" href=\"#\">\r\n                    <i class=\"absolute block h-2 bg-white w-30 left-0 transition-all duration-300 top-16\"></i>\r\n                    <i class=\"absolute block h-2 bg-white w-30 left-0 transition-all duration-300 top-24\"></i>\r\n                    <i class=\"absolute block h-2 bg-white w-30 left-0 transition-all duration-300 top-[32px]\"></i>\r\n                </a>\r\n            </div>\r\n\r\n            <!-- Mobile menu -->\r\n            <div class=\"menu-drawer w-screen bg-grey-500 h-screen absolute top-70 md:top-80 transition-all duration-300 p-50\">\r\n                \n<!-- Main Menu -->\n<menu class=\"xs:container text-white flex flex-col items-end text-right mb-30\">\n            <a href=\"https://www.thehammondtheatre.co.uk/\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            Home        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/whats-on\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            What’s On        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/visitor-information\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            Visitor Information        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/about-us\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            About Us        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/theatre-hire\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            Theatre Hire        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/contact-us\" class=\"hover:text-yellow mb-10 uppercase font-futura text-14 tracking-widest \">\n            Contact Us        </a>\n    </menu>\n\n<!-- Top Menu -->\n<menu class=\"xs:container text-white flex flex-col items-end text-right\">\n            <a href=\"https://thehammondtheatre.us16.list-manage.com/subscribe/post?u=3324f533c59f945d0a73364d3&id=1853f3f636\" class=\"hover:text-yellow mb-10 uppercase font-futura text-12 tracking-widest \">\n            Sign up to our mailing list        </a>\n    </menu>            </div>\r\n\r\n            <!-- Desktop menu -->\r\n            <div class=\"hidden xl:block\">\r\n                <!-- Top Menu -->\n<menu class=\"flex justify-end text-white\">\n            <a href=\"https://thehammondtheatre.us16.list-manage.com/subscribe/post?u=3324f533c59f945d0a73364d3&id=1853f3f636\" class=\"hover:text-yellow pl-20 uppercase font-futura text-12 tracking-widest pb-[20px] \">\n            Sign up to our mailing list        </a>\n    </menu>\n\n<!-- Main Menu -->\n<menu class=\"flex justify-end text-white\">\n            <a href=\"https://www.thehammondtheatre.co.uk/\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            Home        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/whats-on\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            What’s On        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/visitor-information\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            Visitor Information        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/about-us\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            About Us        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/theatre-hire\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            Theatre Hire        </a>\n            <a href=\"https://www.thehammondtheatre.co.uk/contact-us\" class=\"hover:text-yellow pl-20 uppercase font-futura text-14 tracking-widest \">\n            Contact Us        </a>\n    </menu>            </div>\r\n            \r\n        </div>\r\n    </div>\r\n</div>\r\n\t\t\n\t\t<div id=\"content-wrap\" class=\"min-h-screen\">\r\n\r\n    <main class=\"relative\">\r\n\r\n        <img loading=\"1\" role=\"presentation\" src=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/01/CC-Banner.png\" alt=\"\" srcset=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/01/CC-Banner.png 1440w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/01/CC-Banner-640x200.png 640w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/01/CC-Banner-400x125.png 400w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2026/01/CC-Banner-1280x400.png 1280w\" sizes=\"(max-width: 1440px) 100vw, 1440px\" class=\"w-full h-auto aspect-[19/6] object-cover pointer-events-none\"/>\r\n        <!-- Details -->\r\n        <div class=\"md:container\">\r\n            <div class=\"relative flex flex-wrap gap-y-20 justify-center sm:justify-evenly bg-grey-500 pt-20 md:px-30 lg:px-40 xl:px-50 pb-20 md:-top-50 items-center\">\r\n                <div class=\"w-1/2 sm:w-fit lg:w-2/6 text-center sm:text-left sm:mb-0 px-10\">\r\n                    <p class=\"text-yellow font-interface text-14 uppercase\">Type</p>\r\n                                            <p class=\"text-white font-futura text-18 xl:text-22 font-bold uppercase\">Childrens</p>\r\n                                    </div>\r\n                <div class=\"w-1/2 sm:w-fit lg:w-1/6 text-center sm:text-left sm:mb-0 px-10\">\r\n                    <p class=\"text-yellow font-interface text-14 uppercase\">Date</p>\r\n                                            <p class=\"text-white font-futura text-18 xl:text-22 font-bold uppercase\">21/02/2026</p>\r\n                                    </div>\r\n                <div class=\"w-1/2 sm:w-fit lg:w-1/6 text-center sm:text-left px-10\">\r\n                    <p class=\"text-yellow font-interface text-14 uppercase\">Doors Open</p>\r\n                                            <p class=\"text-white font-futura text-18 xl:text-22 font-bold uppercase\">2:00 pm</p>\r\n                                    </div>\r\n                <div class=\"w-1/2 sm:w-fit lg:w-1/6 text-center sm:text-left px-10\">\r\n                    <p class=\"text-yellow font-interface text-14 uppercase\">Starting Time</p>\r\n                                            <p class=\"text-white font-futura text-18 xl:text-22 font-bold uppercase\">2:30 pm</p>\r\n                                    </div>\r\n                <div class=\"lg:w-1/6 flex justify-end px-10\">\r\n                    <a class=\"button-yellow lg:px-0 lg:w-full xl:w-fit xl:px-30\" href=\"https://tickets.thehammondtheatre.co.uk/TheHammondTheatre.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_1050632.TcsWebTab_1050633.TcsPerformance_1561113.TcsSection_1197475\" target=\"_blank\">Book Now</a>\r\n                </div>\r\n\r\n\t\t\t\t            </div>\r\n        </div>\r\n\r\n        <!-- Titles -->\r\n        <div class=\"container lg:w-4/5 xl:w-3/5 lg:px-0 mx-auto mt-30 md:mt-0 -mb-40\">\r\n            <h1 class=\"text-36 font-futura uppercase text-center mb-10 font-bold\">The Captain Calamity Half Term Hullabaloo</h1>\r\n            <h3 class=\"text-20 font-futura uppercase text-center mb-10\">From the moment Captain Calamity and Crew sail in from The Lollipop Lighthouse in Chocolate Button bay the craziness bursts onto the stage.</h3>\r\n            <p class=\"text-18 font-interface text-center text-black\"></p>\r\n        </div>\r\n\r\n        <!-- Content -->\r\n        <div class=\"container lg:px-0 relative z-10 py-40 md:py-60 flex justify-end mt-20\">\r\n            <div class=\"prose lg:w-4/5 xl:w-3/5 mx-auto \">\r\n\t\t\t\t<p>This is a wild mix of magic and mayhem like no other.</p>\n<p>Expect 55 minutes of jaw dropping family fun and insanity featuring marvellous magic, bombastic balloons, beautiful bubbles, silly science, gigglesome games, cheeky tunes, one or two custard pies and enough craziness to send you into a fit of giggles before the curtain comes crashing down.</p>\n<p>Don’t miss this symphony of disaster conducted by a smelly dragon, a magical Story Teller, a Mad Professor, and the biggest buffoon of all, Captain Calamity.</p>\n<p>Ideal for families and children of all ages.</p>\n<p>If you want to know what all the fuss is about then check out Captain Calamity’s very own YouTube Channel! <a href=\"https://youtube.com/@CaptainCalamity\">https://youtube.com/@CaptainCalamity</a></p>\n\r\n\t\t\t\t\t\t\t\t\t<div class=\"video children:w-full children:h-auto children:aspect-video\"><iframe title=\"The Captain Calamity Adventures 2022\" width=\"640\" height=\"360\" src=\"https://www.youtube.com/embed/YnbRdUNBnXw?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe></div>\r\n\t\t\t\t\t\t\t</div>\r\n        </div>\r\n\r\n\r\n\t\t<!-- Reviews -->\r\n\t\t\r\n\r\n        <!-- What Else Is On -->\r\n        \n\n    \n        <div class=\"bg-grey-100 z-20 relative\">\n            <div class=\"container pt-50 pb-100\">\n\n                <h2 class=\"text-36 text-center font-futura uppercase mb-20\">What else is on?</h2>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-30\">\n                                                        \n                        <div class=\"col-span-1 flex flex-col justify-between mt-20 xl:mt-0\">\n                            <div class=\"relative\">\n                                <a href=\"https://www.thehammondtheatre.co.uk/whats-on/nt-live-hamlet\">\n                                    <img loading=\"lazy\" role=\"presentation\" src=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/06/Hamlet-Feature.png\" alt=\"\" srcset=\"https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/06/Hamlet-Feature.png 1280w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/06/Hamlet-Feature-640x380.png 640w, https://www.thehammondtheatre.co.uk/wp-content/uploads/2025/06/Hamlet-Feature-400x238.png 400w\" sizes=\"(max-width: 1280px) 100vw, 1280px\" class=\"h-auto md:min-h-[220px] lg:min-h-[290px] xl:min-h-[170px] 2xl:min-h-[210px] w-full object-cover\"/>                                </a>\n                                <h3 class=\"mt-20 font-futura text-18 text-grey-400 uppercase\">NT Live: Hamlet</h3>\n                                <a href=\"https://www.thehammondtheatre.co.uk/whats-on/nt-live-hamlet\"  class=\"absolute top-0 left-0 p-20 w-full flex items-center\">\n                                    <img class=\"w-20\" src=\"https://www.thehammondtheatre.co.uk/wp-content/themes/hammond-theatre-23/public/img/logo-icon.png\" alt=\"\">\n                                    <p class=\"relative text-white ml-10 text-14 font-future uppercase\">NT Live</p>\n                                </a>\n                                <time class=\"mt-10 text-18 text-grey-200\">Thursday 22 January, 7.00pm</time>\n                            </div>\n                            <div>\n                            <div class=\"flex flex-col xs:flex-row justify-between gap-10 mt-15\">\n                                <a class=\"button-white-outline text-12 xs:text-14 w-full xs:w-1/2 px-0\" href=\"https://www.thehammondtheatre.co.uk/whats-on/nt-live-hamlet\">Read More</a>\n                                <a class=\"button-yellow text-12 xs:text-14 w-full xs:w-1/2 px-0\" href=\"https://tickets.thehammon