            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014888\",\"name\":\"Sarpanch (Punjabi)\",\"originalName\":\"Sarpanch (Punjabi)\",\"length\":145,\"posterLink\":\"https://regalcdn.azureedge.net/CW/SarpanchPunjabi/HO00014888/TV_SmallPosterImage/20260707-122852099.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/SarpanchPunjabi/HO00014888/TV_LargePosterImage/20260707-122852099.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/sarpanch-punjabi/ho00014888\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Sarbjit Cheema, Saanvi Dhiman, Dakssh Ajit Singh, Dev Kharoud, Jasmin Bajwa, Deedar Gill, Gurbaaz\",\"directors\":\"Mandeep Benipal\",\"synopsis\":\"Fateh and Rajveer are 2 brothers living happily together, but in the village from last 20 years the group which was elected as Sarpanch of the film is doing bad things and not developing the village in the way that should be done. So one day Fateh takes the charge and stands in the election for the post of Sarpanch and rest all story follows with the Problems that come his way through this process.\",\"dateStarted\":\"2026-07-10T00:00:00\",\"eventCount\":79,\"categoriesAttributes\":[\"action\",\"drama\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"laser\",\"punjabi\",\"reserved-selected\",\"subbed\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/15.png\",\"ageRestrictionName\":\"15\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/SarpanchPunjabi/HO00014888/TV_TopShelfPosterImage/20260707-122852099.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalc