AndCrewMemberId\":\"0000001177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003901\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004117\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012885\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012886\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017616\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017617\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017618\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"0004c65f-7fef-466d-afe4-7bab15b10fa6\",\"corporateId\":null},\"hopk\":\"HO00008325\",\"hoCode\":\"A000009423\",\"eventId\":null,\"distributorName\":\"ENTERTAINMENT FILM DISTRIBUTOR\"},{\"id\":\"HO00008327\",\"title\":{\"text\":\"No Other Choice\",\"translations\":[]},\"synopsis\":{\"text\":\"Man-su (Lee Byung Hun), a specialist in paper manufacturing with 25 years of experience, is so satisfied with life that he can truthfully tell himself, “I’ve got it all.” While happily passing his days with his wife Miri (Son Yejin), their two children and two dogs, Man-su is suddenly informed by his company that he has been fired.\\n“We’re sorry. We have no other choice.”\\nFeeling shocked as if his head had been cut off by an ax, Man-su vows to find himself a new job within the next three months for the sake of his family. Despite his firm resolve to turn his life around, Man-su spends over a year drifting from one job interview after another, and working at a retail store. He eventually finds himself in danger of losing the very house that he struggled so hard to buy.\\nDesperate, he visits Moon Paper out of the blue and tries to hand over his CV, but he just ends up getting humiliated by line manager Choi Sun-chul (Park Hee Soon). Man-su knows he is better qualified than anyone to work at Moon Paper, so he comes to a certain decision.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, violence, injury detail, sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":139,\"trailerUrl\":null,\"displayPriority\":13,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000010701\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016863\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017619\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017620\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017621\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017622\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000009\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e660de4a-88af-472a-a1e1-57ffb9dcbb49\",\"corporateId\":null},\"hopk\":\"HO00008327\",\"hoCode\":\"A000009425\",\"eventId\":null,\"distributorName\":\"MUBI UK Ltd\"},{\"id\":\"HO00008431\",\"title\":{\"text\":\"Mardaani 3\",\"translations\":[]},\"synopsis\":{\"text\":\"The blockbuster Mardaani franchise has received unanimous love from people and has attained a cult status amongst cine-lovers. Mardaani 3 will see Rani Mukerji reprise the role of a daredevil cop, Shivani Shivaji Roy, who selflessly fights for justice. This film will be a bloody, violent clash between Shivani’s goodness vs sinister evil forces as she begins an extraordinary race against time to hunt and rescue scores of missing girls of the country.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Mardaani 3 will see Rani Mukerji reprise the role of a daredevil cop, Shivani Shivaji Roy, who selflessly fights for justice. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong threat, violence, injury detail, sexual threat\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":130,\"trailerUrl\":\"https://www.youtube.com/watch?v=V4TJKSEftkU\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000714\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011547\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017800\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"17860\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002020\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"96f02b86-c02e-4978-bb33-f79eeb7ad66d\",\"corporateId\":null},\"hopk\":\"HO00008431\",\"hoCode\":\"A000009536\",\"eventId\":null,\"distributorName\":\"YASH RAJ FILMS LTD\"},{\"id\":\"HO00008435\",\"title\":{\"text\":\"Prakambanam\",\"translations\":[]},\"synopsis\":{\"text\":\"In a lively Ernakulam college hostel, three friends juggle politics, pranks and the madness of student life. But when an unexpected twist unsettles their carefree world, comedy and chaos spiral in ways they never imagined.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In a lively Ernakulam college hostel, three friends juggle politics, pranks and the madness of student life. \",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate violence, drug references, sex references, language, horror\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":126,\"trailerUrl\":\"https://www.youtube.com/watch?v=R3_R_q44eJU\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000009387\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010065\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013431\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013899\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017804\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017806\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\