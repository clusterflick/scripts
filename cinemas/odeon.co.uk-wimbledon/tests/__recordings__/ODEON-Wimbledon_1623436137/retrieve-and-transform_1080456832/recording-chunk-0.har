s\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"555-91384\",\"schedule\":{\"businessDate\":\"2026-02-18\",\"startsAt\":\"2026-02-18T20:00:00+00:00\",\"endsAt\":\"2026-02-18T22:45:00+00:00\",\"filmStartsAt\":\"2026-02-18T20:25:00+00:00\",\"filmEndsAt\":\"2026-02-18T22:45:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"555-7-136\",\"filmId\":\"HO00008205\",\"siteId\":\"555\",\"screenId\":\"555-7\",\"areaCategories\":[{\"areaCategoryId\":\"555-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000030\",\"0000000194\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"555\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4198,\"longitude\":-0.2048},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Wimbledon@odeonuk.com\",\"address\":{\"line1\":\"39 The Broadway\",\"line2\":\"The Crescent\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008201\",\"title\":{\"text\":\"GOAT\",\"translations\":[]},\"synopsis\":{\"text\":\"From Sony Pictures Animation, the studio behind Spider-Man TM: Across the Spider-Verse and the artists that made KPop Demon Hunters, comes GOAT, an original action-comedy set in an all-animal world. The story follows Will, a small goat with big dreams who gets a once-in-a-lifetime shot to join the pros and play roarball–a high-intensity, co-ed, full-contact sport dominated by the fastest, fiercest animals in the world. Will’s new teammates aren’t thrilled about having a little goat on their roster, but Will is determined to revolutionize the sport and prove once and for all that “smalls can ball!”\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Sony Pictures Animation, the studio behind Spider-Man TM: Across the Spider-Verse and the artists that made KPop Demon Hunters, comes GOAT, an original action-comedy\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild violence, rude humour, language\",\"translations\":[]},\"releaseDate\":\"2026-02-13\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=kmY-rYS7yng\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000119\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002189\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006525\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009120\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011153\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011459\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017374\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017375\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017376\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017377\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017378\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017379\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017380\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017381\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017382\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017383\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017384\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"9353\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000017\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001297\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"fd3ddcc6-e405-4e1f-89d5-5330b8b46da1\",\"corporateId\":null},\"hopk\":\"HO00008201\",\"hoCode\":\"A000009293\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008205\",\"title\":{\"text\":\"Wuthering Heights\",\"translations\":[]},\"synopsis\":{\"text\":\"A passionate and tumultuous love story set against the backdrop of the Yorkshire moors, exploring the intense and destructive relationship between Heathcliff and Catherine Earnshaw.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A passionate and tumultuous love story set against the backdrop of the Yorkshire moors, exploring the intense and destructive relationship between Heathcliff and Catherin\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-13\",\"runtimeInMinutes\":140,\"trailerUrl\":\"https://www.youtube.com/watch?v=i39w-wDZZuU\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003230\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010191\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017391\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017392\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000898\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001025\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001027\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001190\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001796\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\",\"0000000018\"],\"externalIds\":{\"moviexchangeReleaseId\":\"53bcf89b-c3eb-481c-9b0e-65563daec337\",\"corporateId\":null},\"hopk\":\"HO00008205\",\"hoCode\":\"A000009298\",\"eventId\":null,\"distributorName\":\"WARNER BROS DISTRIBUTORS LTD\"},{\"id\":\"HO00008368\",\"title\":{\"text\":\"Chase Atlantic: LOST IN HEAVEN\",\"translations\":[]},\"synopsis\":{\"text\":\"Chase Atlantic: LOST IN HEAVEN is the immersive feature-length concert film showcasing one of the most legendary performances of Chase Atlantic’s career. This unique cinematic experience captures the band’s final night of their LOST IN HEAVEN European Tour at London’s O2 Arena, which followed the release of their fourth studio album of the same name on November 1, 2024.\\n\\nChase Atlantic is an Australian-born trio consisting of Mitchel Cave (lead singer), Christian Anthony (singer and guitarist) and Clinton Cave (lead guitarist and saxophone), joined on tour by their friends Jesse Boyle (drummer) and Pat Wilde (bassist and guitarist). This high energy night is the culmination of the years the band have spent perfecting their craft. \\n\\nWith over 8 billion global streams, Chase Atlantic in just a few years have grown their audiences from small crowds to numbers filling some of the largest venues in the world.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Chase Atlantic: LOST IN HEAVEN is the immersive feature-length concert film showcasing one of the most legendary performances of Chase Atlantic’s career.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-18\",\"runtimeInMinutes\":101,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000005498\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013680\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013681\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013682\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016749\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017678\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017679\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017680\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017681\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017682\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00002501\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleas