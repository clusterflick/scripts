":{\"latitude\":51.4198,\"longitude\":-0.2048},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Wimbledon@odeonuk.com\",\"address\":{\"line1\":\"39 The Broadway\",\"line2\":\"The Crescent\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008319\",\"title\":{\"text\":\"EPiC: Elvis Presley in Concert\",\"translations\":[]},\"synopsis\":{\"text\":\"Elvis sings and tells his story like never before in a new cinematic experience from visionary filmmaker Baz Luhrmann.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Elvis sings and tells his story like never before in a new cinematic experience from visionary filmmaker Baz Luhrmann.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate bad language, sex references, drug references\",\"translations\":[]},\"releaseDate\":\"2026-02-20\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=V4rLM1k1nKY\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001522\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000005483\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017604\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017605\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017606\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001900\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"29586d46-5172-4706-aca2-77fc2b4810c9\",\"corporateId\":null},\"hopk\":\"HO00008319\",\"hoCode\":\"A000009416\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008368\",\"title\":{\"text\":\"Chase Atlantic: LOST IN HEAVEN\",\"translations\":[]},\"synopsis\":{\"text\":\"Chase Atlantic: LOST IN HEAVEN is the immersive feature-length concert film showcasing one of the most legendary performances of Chase Atlantic’s career. This unique cinematic experience captures the band’s final night of their LOST IN HEAVEN European Tour at London’s O2 Arena, which followed the release of their fourth studio album of the same name on November 1, 2024.\\n\\nChase Atlantic is an Australian-born trio consisting of Mitchel Cave (lead singer), Christian Anthony (singer and guitarist) and Clinton Cave (lead guitarist and saxophone), joined on tour by their friends Jesse Boyle (drummer) and Pat Wilde (bassist and guitarist). This high energy night is the culmination of the years the band have spent perfecting their craft. \\n\\nWith over 8 billion global streams, Chase Atlantic in just a few years have grown their audiences from small crowds to numbers filling some of the largest venues in the world.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Chase Atlantic: LOST IN HEAVEN is the immersive feature-length concert film showcasing one of the most legendary performances of Chase Atlantic’s career.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-18\",\"runtimeInMinutes\":101,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000005498\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013680\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013681\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013682\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016749\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017678\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017679\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017680\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017681\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017682\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00002501\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"d90782fc-5aa7-479a-add1-d80189cc04d8\",\"corporateId\":null},\"hopk\":\"HO00008368\",\