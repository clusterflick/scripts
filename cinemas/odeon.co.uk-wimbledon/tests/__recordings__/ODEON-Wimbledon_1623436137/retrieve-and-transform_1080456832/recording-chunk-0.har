          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-12\",\"showtimes\":[{\"id\":\"555-103776\",\"schedule\":{\"businessDate\":\"2026-08-12\",\"startsAt\":\"2026-08-12T19:15:00+01:00\",\"endsAt\":\"2026-08-12T21:00:00+01:00\",\"filmStartsAt\":\"2026-08-12T19:40:00+01:00\",\"filmEndsAt\":\"2026-08-12T21:00:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"555-3-101\",\"filmId\":\"HO00009195\",\"siteId\":\"555\",\"screenId\":\"555-3\",\"areaCategories\":[{\"areaCategoryId\":\"555-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000187\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"555\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4198,\"longitude\":-0.2048},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Wimbledon@odeonuk.com\",\"address\":{\"line1\":\"39 The Broadway\",\"line2\":\"The Crescent\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00009195\",\"title\":{\"text\":\"KATSEYE: WILD HEARTS\",\"translations\":[]},\"synopsis\":{\"text\":\"Two-time GRAMMY®-nominated global girl group KATSEYE is coming to cinemas worldwide with a special theatrical release ahead of their third EP, WILD.\\n\\nKATSEYE: WILD HEARTS is a captivating journey into the group's bold new era while celebrating the fans who helped make it possible. Featuring never-before-seen footage, EYEKONS fan videos, and intimate interviews from the group members, the film explores the powerful bond between KATSEYE and their global fandom. A love letter to the EYEKONS who helped build this movement, KATSEYE: WILD HEARTS reveals why this group's story is only just beginning.\\n\\nFrom the intense pressure of Dream Academy to chart-topping viral success, audiences experience the highs, setbacks, sacrifices, and breakthrough moments that transformed KATSEYE on their path to global pop stardom. Praised by outlets including The New York Times, Vogue, Rolling Stone, and Billboard, KATSEYE has earned acclaim for their relentless dedication to their craft and electrifying live performances. As one of pop's most exciting emerging global acts, the group continues to solidify its place as a worldwide force.\\n\\nFrom the same team that created Netflix’s POP STAR ACADEMY, KATSEYE: WILD HEARTS is produced by Interscope Films and Boardwalk Pictures, in partnership with HYBE X GEFFEN, and directed by Nadia Hallgren.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Two-time GRAMMY®-nominated global girl group KATSEYE is coming to cinemas worldwide with a special theatrical release ahead of their third EP, WILD.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-12\",\"runtimeInMinutes\":80,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014625\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019617\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019618\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019619\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019620\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019621\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019622\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019623\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019624\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019625\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019626\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"f96b4339-1