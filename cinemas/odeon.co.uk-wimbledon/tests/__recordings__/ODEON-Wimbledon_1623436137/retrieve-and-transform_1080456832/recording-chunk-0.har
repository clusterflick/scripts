\"filmId\":\"HO00008387\",\"siteId\":\"555\",\"screenId\":\"555-4\",\"areaCategories\":[{\"areaCategoryId\":\"555-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000187\",\"0000000147\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"555-89428\",\"schedule\":{\"businessDate\":\"2026-02-26\",\"startsAt\":\"2026-02-26T19:00:00+00:00\",\"endsAt\":\"2026-02-26T22:25:00+00:00\",\"filmStartsAt\":\"2026-02-26T19:25:00+00:00\",\"filmEndsAt\":\"2026-02-26T22:25:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"555-3-89\",\"filmId\":\"HO00008184\",\"siteId\":\"555\",\"screenId\":\"555-3\",\"areaCategories\":[{\"areaCategoryId\":\"555-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"555-91721\",\"schedule\":{\"businessDate\":\"2026-02-26\",\"startsAt\":\"2026-02-26T19:30:00+00:00\",\"endsAt\":\"2026-02-26T21:54:00+00:00\",\"filmStartsAt\":\"2026-02-26T19:55:00+00:00\",\"filmEndsAt\":\"2026-02-26T21:54:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"555-4-121\",\"filmId\":\"HO00008387\",\"siteId\":\"555\",\"screenId\":\"555-4\",\"areaCategories\":[{\"areaCategoryId\":\"555-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000187\",\"0000000147\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"555\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4198,\"longitude\":-0.2048},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Wimbledon@odeonuk.com\",\"address\":{\"line1\":\"39 The Broadway\",\"line2\":\"The Crescent\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008184\",\"title\":{\"text\":\"National Theatre Live: The Audience (Rerelease)\",\"translations\":[]},\"synopsis\":{\"text\":\"Returning to cinemas for the first time in over a decade, Helen Mirren plays Queen Elizabeth II in the Olivier and Tony Award® -winning hit production, directed by Stephen Daldry. For 60 years, Queen Elizabeth II met with each of her 12 prime ministers in a private weekly meeting. This meeting is known as The Audience. From Winston Churchill to Margaret Thatcher and David Cameron, the Queen advised her prime ministers on matters both public and personal. Through these private audiences, we see glimpses of the woman behind the crown and witness the moments that shaped a monarch. Peter Morgan’s Netflix phenomenon The Crown was based on this hit play that was captured live from London’s West End in 2013 and went on to become one of the most-watched NT Live productions.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Academy Award-winner Helen Mirren plays Queen Elizabeth II in the much-anticipated return of the Olivier Award–winning hit production, that inspired Netflix’s The Crown.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-26\",\"runtimeInMinutes\":180,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000328\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000004641\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017347\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017348\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000137\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000447\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000039\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9131253f-ec7c-4f61-b9e3-bbea8ddf1cd3\",\"corporateId\":null},\"hopk\":\"HO00008184\",\"hoCode\":\"A000009276\",\"eventId\":\"0000000001\",\"distributorName\":\"National Theatre\"},{\"id\":\"HO00008319\",\"title\":{\"text\":\"EPiC: Elvis Presley in Concert\",\"translations\":[]},\"synopsis\":{\"text\":\"Elvis sings and tells his story like never before in a new cinematic experience from visionary filmmaker Baz Luhrmann.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Elvis sings and tells his story like never before in a new cinematic experience from visionary filmmaker Baz Luhrmann.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate bad language, sex references, drug references\",\"translations\":[]},\"releaseDate\":\"2026-02-20\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=V4rLM1k1nKY\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001522\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000005483\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017604\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017605\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017606\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001900\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"29586d46-5172-4706-aca2-77fc2b4810c9\",\"corporateId\":null},\"hopk\":\"HO00008319\",\"hoCode\":\"A000009416\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008387\",\"title\":{\"text\":\"Twenty One Pilots: More Than We Ever Imagined\",\"translations\":[]},\"synopsis\":{\"text\":\"Experience the electrifying concert film capturing Twenty One Pilots at a career-defining moment: their monumental Mexico City headline show, performing in front of 65,000 fans at Estadio GNP Seguros during The Clancy World Tour. \\n\\nSet against the vibrant pulse of one of the world’s most iconic music capitals, the film blends cinematic high-energy performance footage with intimate, behind-the-scenes access, revealing the heart, humor, and humanity of the artists as they prepare for one of the biggest shows of their career. \\n\\nViewers follow the band from their arrival in Mexico City to the stage, sharing in the preparation and anticipation that build as showtime approaches. Exclusive commentary from Tyler and Josh offer personal reflections on the journey that brought them to this historic stage and the deep connection with their fans who make it all possible.\\n\\nThe film pulls audiences into the full spectacle of the night. Sweeping aerials of the stadium, on-stage cameras, and crowd-level shots place viewers right at the center of the experience, seeing the show from every angle.  The result is a thrilling, emotional celebration of music, community, and achievement - an unforgettable portrait of Twenty One Pilots, performing a show that will echo through their legacy.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Experience the electrifying concert film capturing Twenty One Pilots at a career-defining moment: their monumental Mexico City headline show.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-25\",\"runtimeInMinutes\":119,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000005569\",\"r