":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"555-101922\",\"schedule\":{\"businessDate\":\"2026-07-16\",\"startsAt\":\"2026-07-17T00:01:00+01:00\",\"endsAt\":\"2026-07-17T03:19:00+01:00\",\"filmStartsAt\":\"2026-07-17T00:26:00+01:00\",\"filmEndsAt\":\"2026-07-17T03:19:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"555-4-121\",\"filmId\":\"HO00008916\",\"siteId\":\"555\",\"screenId\":\"555-4\",\"areaCategories\":[{\"areaCategoryId\":\"555-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000147\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"555-77-HO00008916\"},{\"id\":\"555-101923\",\"schedule\":{\"businessDate\":\"2026-07-16\",\"startsAt\":\"2026-07-17T00:01:00+01:00\",\"endsAt\":\"2026-07-17T03:19:00+01:00\",\"filmStartsAt\":\"2026-07-17T00:26:00+01:00\",\"filmEndsAt\":\"2026-07-17T03:19:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"555-1-118\",\"filmId\":\"HO00008916\",\"siteId\":\"555\",\"screenId\":\"555-1\",\"areaCategories\":[{\"areaCategoryId\":\"555-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"555-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"555-77-HO00008916\"}],\"relatedData\":{\"sites\":[{\"id\":\"555\",\"name\":{\"text\":\"Wimbledon\",\"translations\":[]},\"location\":{\"latitude\":51.4198,\"longitude\":-0.2048},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Wimbledon@odeonuk.com\",\"address\":{\"line1\":\"39 The Broadway\",\"line2\":\"The Crescent\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00001947\",\"title\":{\"text\":\"Zog + Zog and the Flying Doctors\",\"translations\":[]},\"synopsis\":{\"text\":\"As Zog, Pearl, and Gadabout begin a new series of adventures on CBeebies, revisit how they first came to take flight with this special cinema double bill of the original two animated specials. In Zog, meet the clumsy but keen young dragon as he begins his training at Dragon School. Tasked with capturing a princess, could it be that the girl who so kindly treats his bumps and bruises is exactly who he’s been looking for? Then in Zog and the Flying Doctors, Zog’s newly formed team with Princess Pearl and Gadabout travel the land to treat all kinds of creatures, real and mythical, including a mermaid, unicorn and lion.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"As Zog, Pearl, and Gadabout begin a new series of adventures on CBeebies, revisit how they first came to take flight with this special cinema double bill of the original \",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-05\",\"runtimeInMinutes\":53,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000006445\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016173\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019165\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019166\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019167\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019168\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019169\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"2537\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"15e3cd5a-c75d-45a4-a367-93973469f2c7\",\"corporateId\":null},\"hopk\":\"HO00001947\",\"hoCode\":\"A000002231\",\"eventId\":null,\"distributorName\":\"Magic Light Pictures\"},{\"id\":\"HO00008218\",\"title\":{\"text\":\"Toy Story 5\",\"translations\":[]},\"synopsis\":{\"text\":\"The toys are back in Disney and Pixar’s “Toy Story 5,” and this time around it’s Toy meets Tech. Buzz, Woody, Jessie and the rest of the gang’s jobs get exponentially harder when they go head to head with this all-new threat to playtime.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The toys are back in Disney and Pixar’s “Toy Story 5,” and this time around it’s Toy meets Tech. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-19\",\"runtimeInMinutes\":102,\"trailerUrl\":\"https://www.youtube.com/watch?v=RFm6wN7IhtY\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002721\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002933\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004242\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009613\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010641\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017418\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017419\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"7850\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000222\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002742\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e4e53d03-846a-4c4b-a95f-af4af0f815b4\",\"corporateId\":null},\"hopk\":\"HO00008218\",\"hoCode\":\"A000009312\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008246\",\"title\":{\"text\":\"Project Hail Mary\",\"translations\":[]},\"synopsis\":{\"text\":\"Science teacher Ryland Grace (Ryan Gosling) wakes up on a spaceship light years from home with no recollection of who he is or how he got there. As his memory returns, he begins to uncover his mission: solve the riddle of the mysterious substance causing the sun to die out. He must call on his scientific knowledge and unorthodox ideas to save everything on Earth from extinction… but an unexpected friendship means he may not have to do it alone.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Science teacher Ryland Grace (Ryan Gosling) wakes up on a spaceship light years from home with no recollection of who he is or how he got there.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate threat, rude humour, drug references, implied strong language\",\"translations\":[]},\"releaseDate\":\"2026-03-19\",\"runtimeInMinutes\":156,\"trailerUrl\":\"https://www.youtube.com/watch?v=NJGdoaI2VKY\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000556\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000557\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000910\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002808\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010992\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017480\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017481\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017482\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000263\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001953\",\"roles\":[\"Actor\",\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000045\"],\"externalIds\":{\"moviexchangeReleaseId\":\"d6d9381c-63a6-4a6e-8cf1-4989e69890c2\",\"corporateId\":null},\"hopk\":\"HO00008246\",\"hoCode\":\"A000009340\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008248\",\"title\":{\"text\":\"The Devil Wears Prada 2\",\"translations\":[]},\"synopsis\":{\"text\":\"Twenty years after making their iconic turns as Miranda, Andy, Emily and Nigel—Meryl Streep, Anne Hathaway, Emily Blunt and Stanley Tucci return to the fashionable streets of New York City and the sleek offices of Runway Magazine in 20th Century Studios’ “The Devil Wears Prada 2,” the eagerly awaited sequel to the 2006 phenomenon that defined a generation. The film is directed by David Frankel, written by Aline Brosh McKenna, produced by Wendy Finerman, and executive produced by Michael Bederman, Karen Rosenfelt and Aline Brosh McKenna. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Twenty years after making their iconic turns as Miranda, Andy, Emily and Nigel—Meryl Streep, Anne Hathaway, Emily Blunt and Stanley Tucci return to the fashionable street\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-05-01\",\"runtimeInMinutes\":119,\"trailerUrl\":\"https://www.youtube.com/watch?v=gViWAH1PGc0\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000219\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004572\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000004573\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000256\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001778\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"46ccfa4a-af8a-41d3-8253-0c21a9f41f9b\",\"corporateId\":null},\"hopk\":\"HO00008248\",\"hoCode\":\"A000009342\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008413\",\"title\":{\"text\":\"Supergirl\",\"translations\":[]},\"synopsis\":{\"text\":\"When an unexpected and ruthless adversary strikes too close to home, Kara Zor-El, aka Supergirl, reluctantly joins forces with an unlikely companion on an epic, interstellar journey of vengeance and justice.\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It follows Kara Zor-El's story and her darker origin before she finally made her way to Earth.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-25\",\"runtimeInMinutes\":108,\"trailerUrl\":\"https://www.youtube.com/watch?v=wxTiyxH9eZw\",\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007748\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014392\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017778\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001118\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001286\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001846\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002429\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002629\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000001\",\"0000000003\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dbd619f1-56eb-431b-8c89-2eb427edd34f\",\"corporateId\":null},\"hopk\":\"HO00008413\",\"hoCode\":\"A000009517\",\"eventId\":null,\"distributorName\":\"WARNER BROS DISTRIBUTORS LTD\"},{\"id\":\"HO00008415\",\"title\":{\"text\":\"Moana\",\"translations\":[]},\"synopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyages beyond the reef of her island of Motunui with the infamous demigod Maui (Dwayne Johnson) on an unforgettable journey to restore prosperity to her people. The film is directed by Emmy® and Tony Award® winner Thomas Kail (“Hamilton”); produced by Dwayne Johnson, Dany Garcia, Beau Flynn, Hiram Garcia and Lin-Manuel Miranda; and executive produced by Thomas Kail, Scott Sheldon, Charles Newirth and Auliʻi Cravalho, who voiced Moana in the animated features “Moana” and “Moana 2.”\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyage\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=zQjHSoVCQLs\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000117\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001075\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009582\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016273\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017779\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017780\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000102\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000113\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000114\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001036\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"6d579a6e-0609-4ead-992c-190cf5e0fd6f\",\"corporateId\":null},\"hopk\":\"HO00008415\",\"hoCode\":\"A000009519\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008468\",\"title\":{\"text\":\"Disclosure Day\",\"translations\":[]},\"synopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming close to … Disclosure Day.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate threat, violence, injury detail, infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-06-10\",\"runtimeInMinutes\":145,\"trailerUrl\":\"https://www.youtube.com/watch?v=WnW25gFk2Mk\",\"displayPriority\":9,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000219\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000635\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010990\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000216\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000318\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001974\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002474\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"1f2756b4-b117-4f07-b240-55d7611c2d78\",\"corporateId\":null},\"hopk\":\"HO00008468\",\"hoCode\":\"A000009576\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008527\",\"title\":{\"text\":\"Michael\",\"translations\":[]},\"synopsis\":{\"text\":\"Michael is the cinematic portrayal of the life and legacy of one of the most influential artists the world has ever known.\\n\\nThe film tells the story of Michael Jackson’s life beyond the music, tracing his journey from the discovery of his extraordinary talent as the lead of the Jackson Five, to the visionary artist whose creative ambition fuelled a relentless pursuit to become the biggest entertainer in the world.\\n\\nHighlighting both his life off-stage and some of the most iconic performances from his early solo career, the film gives audiences a front-row seat to Michael Jackson as never before. This is where his story begins.\\n\\nMichael stars Jaafar Jackson in his feature film debut, Nia Long (Empire, The Best Man franchise), Laura Harrier (BlacKkKlansman, Spider-Man: Homecoming) and Juliano Krue Valdi (The Loud House, Arco), with Miles Teller (Top Gun: Maverick, Whiplash) and two-time Academy Award® nominee Colman Domingo (Sing Sing, Rustin).\\n\\nDirected by Antoine Fuqua, the award-winning filmmaker of Training Day, Olympus Has Fallen and The Equalizer franchise, from a screenplay by three-time Academy Award® nominee John Logan (Gladiator, The Aviator), the film is produced by Academy Award® winner Graham King (The Departed, Bohemian Rhapsody), John Branca (executive producer This Is It, Thriller 40) and John McClain (executive producer This Is It, Michael Jackson Live at Wembley July 16, 1988).\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Michael is the cinematic portrayal of the life and legacy of one of the most influential artists the world has ever known.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate threat, domestic abuse\",\"translations\":[]},\"releaseDate\":\"2026-04-22\",\"runtimeInMinutes\":127,\"trailerUrl\":\"https://www.youtube.com/watch?v=spOtvnAzBh8\",\"displayPriority\":15,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001329\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002474\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018002\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018003\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018004\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018005\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000216\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001050\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001665\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00002257\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000005\",\"0000000009\",\"0000000013\"],\"externalIds\":{\"moviexchangeReleaseId\":\"f466f587-8251-4c2f-b18d-5daf4f24ec8a\",\"corporateId\":null},\"hopk\":\"HO00008527\",\"hoCode\":\"A000009639\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008565\",\"title\":{\"text\":\"Minions & Monsters\",\"translations\":[]},\"synopsis\":{\"text\":\"Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe with a riotous new chapter, featuring all-new characters, in the biggest global animated franchise in history: Minions & Monsters.\\n\\nThis is the rambunctious, ridiculous and totally true story of how the Minions conquered Hollywood, became movie stars, lost everything, unleashed monsters onto the world and then banded together to try and save the planet from the mayhem they had just created.\\n\\nMinions & Monsters is directed by Academy Award® nominee Pierre Coffin, a director of the first three Despicable Me films and the first Minions film. Coffin has also provided the voice for the Minions since their film debut in 2010. The film is written by Brian Lynch (Minions, The Secret Life of Pets films) and Pierre Coffin and is produced by Illumination’s Academy Award® nominated founder and CEO Chris Meledandri and by Bill Ryan (executive producer, The Super Mario Bros. Movie). The executive producer is Brian Lynch.\\n\\nMore than ten years after their creation, the Minions have become the most iconic animated characters of their generation. Globally recognised and beloved by fans of all ages, they have propelled Illumination’s Despicable Me and Minions to a global box office of more than $5.6 billion.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe \",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":{\"text\":\"very mild comic violence, threat, rude humour\",\"translations\":[]},\"releaseDate\":\"2026-07-01\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=drr0on3W0K8\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002922\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017409\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018101\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"18969\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000015\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000542\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001046\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"HO00001049\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001410\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"1051448b-9ebc-4ce8-b9e7-c007182dbdca\",\"corporateId\":null},\"hopk\":\"HO00008565\",\"hoCode\":\"A000009677\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008587\",\"title\":{\"text\":\"Star Wars: The Mandalorian and Grogu\",\"translations\":[]},\"synopsis\":{\"text\":\"The Mandalorian and Grogu embark on their most thrilling mission yet in Lucasfilm’s “Star Wars: The Mandalorian and Grogu,” an all-new Star Wars adventure opening exclusively in theaters May 22, 2026. The evil Empire has fallen, and Imperial warlords remain scattered throughout the galaxy. As the fledgling New Republic works to protect everything the Rebellion fought for, they have enlisted the help of legendary Mandalorian bounty hunter Din Djarin (Pedro Pascal) and his young apprentice Grogu. Directed by Jon Favreau, “Star Wars: The Mandalorian and Grogu” also stars Sigourney Weaver and is produced by Jon Favreau, Kathleen Kennedy, Dave Filoni, and Ian Bryce, with music composed by Ludwig Göransson.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Mandalorian and Grogu embark on their most thrilling mission yet in Lucasfilm’s “Star Wars: The Mandalorian and Grogu,” an all-new Star Wars adventure \",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate violence, threat, injury detail\",\"translations\":[]},\"releaseDate\":\"2026-05-22\",\"runtimeInMinutes\":132,\"trailerUrl\":\"https://www.youtube.com/watch?v=afVMXehjc0k\",\"displayPriority\":14,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000015\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001725\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010950\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018131\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000349\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001007\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002464\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000010\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"377f5941-3fa2-4f9d-960d-3cfd938f73d6\",\"corporateId\":null},\"hopk\":\"HO00008587\",\"hoCode\":\"A000009702\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008744\",\"title\":{\"text\":\"Obsession\",\"translations\":[]},\"synopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for but soon discovers that some desires come at a dark, sinister price.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong violence, gore\",\"translations\":[]},\"releaseDate\":\"2026-05-15\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=fWLaCC8L6Jo\",\"displayPriority\":10,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002047\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006579\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018515\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018516\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018517\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018518\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018519\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018520\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000018521\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a6a25d26-497a-4daa-a5ff-b5fc9719faca\",\"corporateId\":null},\"hopk\":\"HO00008744\",\"hoCode\":\"A000009874\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008914\",\"title\":{\"text\":\"jackass: best and last\",\"translations\":[]},\"synopsis\":{\"text\":\"Johnny Knoxville and the gang return for one final fling at the big screen. Featuring all-new stunts and stupidity along with the greatest hits and biggest laughs from the past, jackass: best and last is a joyously raucous celebration of all the mischievous camaraderie that you’ve come to love and expect from these idiots over the past 25 years. So, grab your dumb little buddies, raise your glasses, and come experience the cinematic event that promises to be the last time you’ll ever laugh this hard in a theatre.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Johnny Knoxville and the gang return for one final fling at the big screen. Featuring all-new stunts and stupidity along with the greatest hits and biggest laughs.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-26\",\"runtimeInMinutes\":92,\"trailerUrl\":\"https://www.youtube.com/watch?v=erztPGWNkY4\",\"displayPriority\":7,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002327\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000002329\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002330\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000018944\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018945\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018946\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018947\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"3163\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3164\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3165\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3167\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3178\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"3195\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"434e102b-e02e-431e-aff7-3ea7cd362f6b\",\"corporateId\":null},\"hopk\":\"HO00008914\",\"hoCode\":\"A000010056\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00008916\",\"title\":{\"text\":\"The Odyssey\",\"translations\":[]},\"synopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. The film brings Homer’s foundational saga to IMAX® film screens for the first time. \\n\\nThe Odyssey stars Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson and Lupita Nyong’o, with Zendaya and Charlize Theron.\\n\\nThe Odyssey is produced by Emma Thomas and Christopher Nolan for their company, Syncopy. The executive producer is Thomas Hayslip.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":173,\"trailerUrl\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000008\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000150\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000155\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000018948\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000018\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000064\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000267\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002248\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b63dbbaf-6c0e-4622-b9b1-698037e6247e\",\"corporateId\":null},\"hopk\":\"HO00008916\",\"hoCode\":\"A000010058\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008964\",\"title\":{\"text\":\"Evil Dead Burn\",\"translations\":[]},\"synopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. After the loss of her husband, a woman seeks solace with her in-laws in their secluded family home. As one by one they are transformed into Deadites—turning the gathering into a family reunion from hell—she comes to discover that the vows she took in life... live on even in death.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. \",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong bloody violence, gore\",\"translations\":[]},\"releaseDate\":\"2026-07-09\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=YYkUkyfjUKg\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000008177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009258\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019021\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019022\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019023\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019024\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000303\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"3c50ff95-67b2-4152-9965-ad2431794116\",\"corporateId\":null},\"hopk\":\"HO00008964\",\"hoCode\":\"A000010114\",\"eventId\":null,\"distributorName\":\"STUDIOCANAL\"},{\"id\":\"HO00009042\",\"title\":{\"text\":\"Varavu\",\"translations\":[]},\"synopsis\":{\"text\":\"Varavu is an upcoming Malayalam action thriller set against the backdrop of the high ranges, following Polachan, also known as Poly, a wealthy planter who returns to his native land to confront long-standing rivalries and settle unfinished business.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Varavu is an upcoming Malayalam action thriller set against the backdrop of the high ranges, following Polachan, also known as Poly, a wealthy planter\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-16\",\"runtimeInMinutes\":150,\"trailerUrl\":\"https://www.youtube.com/watch?v=aQ7tTufi63s\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004807\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006212\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000006657\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008199\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009547\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013899\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014079\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019260\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019261\",