"castAndCrewMemberId\":\"HO00000349\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000696\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002427\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000010\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a4cb369f-77c4-4fe1-8f85-dd5e76b195dd\",\"corporateId\":null},\"hopk\":\"HO00007533\",\"hoCode\":\"A000008563\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00007638\",\"title\":{\"text\":\"The SpongeBob Movie: Search for Squarepants\",\"translations\":[]},\"synopsis\":{\"text\":\"SpongeBob and his Bikini Bottom friends set sail in their biggest, all-new, can’t miss cinematic event ever…The SpongeBob Movie: Search for SquarePants. Desperate to be a big guy, SpongeBob sets out to prove his bravery to Mr. Krabs by following The Flying Dutchman – a mysterious swashbuckling ghost pirate – on a seafaring comedy- adventure that takes him to the deepest depths of the deep sea, where no Sponge has gone before.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"SpongeBob and his Bikini Bottom friends set sail in their biggest, all-new, can’t miss cinematic event ever…The SpongeBob Movie: Search for SquarePants.\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat, violence, rude humour\",\"translations\":[]},\"releaseDate\":\"2025-12-20\",\"runtimeInMinutes\":96,\"trailerUrl\":\"https://www.youtube.com/watch?v=4-k8Hg7SZas\",\"displayPriority\":15,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000003\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001112\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002204\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016137\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016138\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016139\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016140\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016141\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"9353\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001014\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001107\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001108\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001109\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002485\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002508\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002640\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e5808809-5d74-4074-ba7d-547c6d87a1b4\",\"corporateId\":null},\"hopk\":\"HO00007638\",\"hoCode\":\"A000008678\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00007891\",\"title\":{\"text\":\"A Tooth Fairy Tale\",\"translations\":[]},\"synopsis\":{\"text\":\"Van is a teenage tooth fairy with a taste for adventure, who wishes to explore life beyond the boundaries of his secluded civilization and rigid traditions. Upon meeting Gemma, a daring goblin girl with a knack for science, the pair realise that they have a lot in common, despite the ancient disputes between their two tribes. Together, with the help of Rupee (the world’s cutest troll!), they decide to embark on a mission to reunite their magical kingdoms for good. However, hot on their trail is the greedy Spider Queen and her minions, who will stop at nothing to put an end to their plans.\\n\\nA stunning animation that will spark the imagination of the whole family, it stars Booboo Stewart (The Twilight Saga, Descendants), Larkin Bell (Stranger Things), Vivica A. Fox (Ella Enchanted), Jon Lovitz (Matilda, Hotel Transylvania), and Fran Drescher (Hotel Transylvania).\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Van is a teenage tooth fairy with a taste for adventure, who wishes to explore life beyond the boundaries of his secluded civilization and rigid traditions. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild fantasy violence\",\"translations\":[]},\"releaseDate\":\"2025-10-17\",\"runtimeInMinutes\":88,\"trailerUrl\":\"https://www.youtube.com/watch?v=eLgAL70FzLE\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001634\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002728\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005183\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016119\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016728\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016729\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016730\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"2227\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"21af7487-fc4d-4b39-a8e9-e0607032c85d\",\"corporateId\":null},\"hopk\":\"HO00007891\",\"hoCode\":\"A000008958\",\"eventId\":null,\"distributorName\":\"Kaleidoscope Home Entertainmen\"},{\"id\":\"HO00008012\",\"title\":{\"text\":\"The Housemaid\",\"translations\":[]},\"synopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous — a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, sex, sexual violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-12-22\",\"runtimeInMinutes\":131,\"trailerUrl\":\"https://www.youtube.com/watch?v=kdDdlY2VPxw\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000009161\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012707\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016976\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016977\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000031\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000135\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000814\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001305\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dc7be94d-5ba5-4a79-accd-48ed4d19a3b6\",\"corporateId\":null},\"hopk\":\"HO00008012\",\"hoCode\":\"A000009092\",\"eventId\":null,\"distributorName\":\"LIONSGATE INTERNATIONAL\"},{\"id\":\"HO00008080\",\"title\":{\"text\":\"Hamnet\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"distressing scenes, brief moderate sex\",\"translations\":[]},\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":126,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003903\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011027\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017134\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000116\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000321\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000322\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001794\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001974\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000005\"],\"externalIds\":{\"moviexchangeReleaseId\":\"37b2b94f-65a0-481e-9d3c-bde2445c99a4\",\"corporateId\":null},\"hopk\":\"HO00008080\",\"hoCode\":\"A000009165\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008082\",\"title\":{\"text\":\"The History of Sound\",\"translations\":[]},\"synopsis\":{\"text\":\"In 1917, Lionel — a young, talented music student — meets David at the Boston Conservatory, where they bond over a deep love of folk music. Years later, Lionel receives a letter from David, leading to an impromptu journey through the backwoods of Maine to collect traditional songs. This unexpected reunion, ensuing love affair, and the music they collect and preserve, will shape the course of Lionel’s life far beyond his own awareness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Two young men during World War I set out to record the lives, voices and music of their American countrymen.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"brief strong sex\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":128,\"trailerUrl\":\"https://www.youtube.com/watch?v=E2PSkw8BI7k\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004598\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000007165\",\"roles\":[\"Director\",\"Producer\"]},{\"castA