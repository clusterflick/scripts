ion epic shot across the world using brand new IMAX® film technology. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":173,\"trailerUrl\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000008\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000150\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000155\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000018948\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000018\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000064\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000267\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002248\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b63dbbaf-6c0e-4622-b9b1-698037e6247e\",\"corporateId\":null},\"hopk\":\"HO00008916\",\"hoCode\":\"A000010058\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"}],\"castAndCrew\":[{\"id\":\"0000000008\",\"name\":{\"givenName\":\"Lupita\",\"familyName\":\"Nyong'o\",\"middleName\":null}},{\"id\":\"0000000150\",\"name\":{\"givenName\":\"Robert\",\"familyName\":\"Pattinson\",\"middleName\":null}},{\"id\":\"0000000155\",\"name\":{\"givenName\":\"Christopher\",\"familyName\":\"Nolan\",\"middleName\":null}},{\"id\":\"0000018948\",\"name\":{\"givenName\":\"Emma\",\"familyName\":\"Nolan\",\"middleName\":null}},{\"id\":\"HO00000018\",\"name\":{\"givenName\":\"Charlize\",\"familyName\":\"Theron\",\"middleName\":null}},{\"id\":\"HO00000064\",\"name\":{\"givenName\":\"Matt\",\"familyName\":\"Damon\",\"middleName\":null}},{\"id\":\"HO00000267\",\"name\":{\"givenName\":\"Tom \",\"familyName\":\"Holland\",\"middleName\":null}},{\"id\":\"HO00000805\",\"name\":{\"givenName\