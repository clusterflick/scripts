umbers\":[],\"email\":\"Odeon.Wimbledon@odeonuk.com\",\"address\":{\"line1\":\"39 The Broadway\",\"line2\":\"The Crescent\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00009033\",\"title\":{\"text\":\"National Theatre Live: The Misanthrope\",\"translations\":[]},\"synopsis\":{\"text\":\"Award-winner Sandra Oh (Killing Eve) plays the title role in this razor-sharp reimagining of Molière’s classic dark comedy. Telling the truth isn’t always that simple. Alice, a brilliant novelist, despises the carefully constructed lies of modern society. But the more she challenges those around her, the fiercer the backlash becomes. Soon, she must confront the price of speaking her truth in a world that would rather silence her. Filmed live on stage at the National Theatre, Indhu Rubasingham directs Martin Crimp’s (Cyrano de Bergerac) highly anticipated play.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Award-winner Sandra Oh (Killing Eve) plays the title role in this razor-sharp reimagining of Molière’s classic dark comedy.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-09-22\",\"runtimeInMinutes\":150,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002358\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019238\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019239\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"19464\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"19465\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000447\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000039\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5601913c-5c9c-400a-8361-fab2a4c2a9ba\",\"corporateId\":null},\"hopk\":\"HO00009033\",\"hoCode\":\"A000010187\",\"eventId\":\"0000000001\",\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"000000