outube.com/watch?v=OCYd8Th9ywI\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001078\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001810\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001866\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007400\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007941\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008395\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008396\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008397\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008398\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008399\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008400\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008401\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008402\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008403\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008404\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008405\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008406\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008407\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008408\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008409\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000008410\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00005273\",\"hoCode\":\"A000006547\",\"eventId\":null,\"distributorName\":\"Lionsgate\"},{\"id\":\"HO00006017\",\"title\":{\"text\":\"Sinners\",\"translations\":[]},\"synopsis\":{\"text\":\"Trying to leave their troubled lives behind, twin brothers (Jordan) return to their hometown to start again, only to discover that an even greater evil is waiting to welcome them back.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Twin brothers return to their hometown to start their lives over, where they encounter an evil presence that's been waiting to welcome them back.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-04-18\",\"runtimeInMinutes\":137,\"trailerUrl\":\"https://www.youtube.com/watch?v=4oqCwr_bzHI\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000154\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001644\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002611\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004426\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005026\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005685\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010887\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010888\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010889\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006017\",\"hoCode\":\"A000007420\",\"eventId\":null,\"distributorName\":\"Warners\"},{\"id\":\"HO00006096\",\"title\":{\"text\":\"Mission: Impossible - The Final Reckoning\",\"translations\":[]},\"synopsis\":{\"text\":\"Light the fuse because Tom Cruise's world-saving super spy Ethan Hunt is back to complete a mission for the ages alongside Simon Pegg, Ving Rhames and Hayley Atwell. This propulsive action-adventure demands to be seen on the big screen.    \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Our lives are the sum of our choices. Tom Cruise is Ethan Hunt in Mission: Impossible – The Final Reckoning.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"moderate violence, injury detail, threat, language\",\"translations\":[]},\"releaseDate\":\"2025-05-21\",\"runtimeInMinutes\":170,\"trailerUrl\":\"https://www.youtube.com