ucer\"]},{\"castAndCrewMemberId\":\"0000000030\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000031\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000436\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000802\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003183\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003189\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003192\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003193\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003194\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004434\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005130\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005592\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005596\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005686\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005717\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005718\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005719\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005720\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005721\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005722\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006663\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011114\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011115\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000349\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\",\"0000000007\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9246b245-546b-48f2-aa44-5143e8e5b45e\",\"corporateId\":null},\"hopk\":\"HO00006096\",\"hoCode\":\"A000007516\",\"eventId\":null,\"distributorName\":\"Paramount\"},{\"id\":\"HO00006204\",\"title\":{\"text\":\"28 Years Later\",\"translations\":[]},\"synopsis\":{\"text\":\"Academy Award®-winning director Danny Boyle and Academy Award®-nominated writer Alex Garland reunite for 28 Years Later, a terrifying new story set in the world created by 28 Days Later. It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine, some have found ways to exist amidst the infected. One such group of survivors lives on a small island connected to the mainland by a single, heavily-defended causeway. When one of the group leaves the island on a mission into the dark heart of the mainland, he discovers secrets, wonders, and horrors that have mutated not only the infected but other survivors as well.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine...\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-19\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=poEFz8Ivzug\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000313\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001100\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001270\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003206\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003678\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010558\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011257\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000011418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011419\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a7823fd3-66f7-47af-87ba-d36ef45b168c\",\"corporateId\":null},\"hopk\":\"HO00006204\",\"hoCode\":\"A000007660\",\"eventId\":null,\"distributorName\":\"Sony Pictures\"},{\"id\":\"HO00006205\",\"title\":{\"text\":\"Ballerina\",\"translations\":[]},\"synopsis\":{\"text\":\"Taking place during the events of John Wick: Chapter 3 – Parabellum, the film follows Eve Macarro (Ana de Armas) who is beginning her training in the assassin traditions of the Ruska Roma.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Taking place during the events of John Wick: Chapter 3 – Parabellum, the film follows Eve Macarro (Ana de Armas) who is beginning her training in the assassin traditions \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, language\",\"translations\":[]},\"releaseDate\":\"2025-06-06\",\"runtimeInMinutes\":124,\"trailerUrl\":\"https://www.youtube.com/watch?v=EcsDV0rWEFc\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001278\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001397\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002175\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004517\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005252\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005257\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000007297\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008887\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011420\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011421\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000132\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000136\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000026\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"f23b3bec-30b4-4b5f-97e9-a0d2427493c7\",\"corporateId\":null},\"hopk\":\"HO00006205\",\"hoCode\":\"A000007661\",\"eventId\":null,\"distributorName\":\"Lionsgate\"},{\"id\":\"HO00006206\",\"title\":{\"text\":\"How to Train Your Dragon\",\"translations\":[]},\"synopsis\":{\"text\":\"A live-action remake of the beloved animation that explores the bond between a Viking boy and his dragon, a friendship that flies in the face of centuries of tradition. Together, they confront an ancient threat that endangers both species. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"On the rugged isle of Berk, where Vikings and dragons have been bitter enemies for generations, Hiccup (Mason Thames; The Black Phone, For All Mankind) stands apart.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":{\"text\":\"mild threat, scary scenes, violence, language\",\"translations\":[]},\"releaseDate\":\"2025-06-13\",\"runtimeInMinutes\":126,\"trailerUrl\":\"https://www.youtube.com/watch?v=CS_TVzQpNlg\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000269\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003403\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006974\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006978\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007232\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008693\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011422\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011423\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011424\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011425\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011426\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000011427\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"4360\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000007\",\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5970f2a4-78f6-48eb-a600-f37fc295f441\",\"corporateId\":null},\"hopk\":\"HO00006206\",\"hoCode\":\"A000007662\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006208\",\"title\":{\"text\":\"M3GAN 2.0\",\"translations\":[]},\"synopsis\":{\"text\":\"The murderous doll who captivated pop culture in 2023 is back. And this time she’s not alone.\\n\\nThe original creative team behind that phenomenon—led by horror titans James Wan for Atomic Monster, Jason Blum for Blumhouse and director Gerard Johnstone—reboot an all-new wild chapter in A.I. mayhem with M3GAN 2.0.\\n\\nTwo years after M3GAN, a marvel of artificial intelligence, went rogue and embarked on a murderous (and impeccably choreographed) rampage and was subsequently destroyed, M3GAN’s creator Gemma (Allison Williams) has become a high-profile author and advocate for government oversight of A.I. Meanwhile, Gemma’s niece Cady (Violet McGraw), now 14, has become a teenager, rebelling against Gemma’s overprotective rules.\\n\\nUnbeknownst to them, the underlying tech for M3GAN has been stolen and misused by a powerful defense contractor to create a military-grade weapon known as Amelia (Ivanna Sakhno; Ahsoka, Pacific Rim: Uprising), the ultimate killer infiltration spy. But as Amelia’s self-awareness increases, she becomes decidedly less interested in taking orders from humans. Or in keeping them around.\\n\\nWith the future of human existence on the line, Gemma realizes that the only option is to resurrect M3GAN (Amie Donald, voiced by Jenna Davis) and give her a few upgrades, making her faster, stronger, and more lethal. As their paths collide, the original A.I bitch is about to meet her match.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The murderous doll who captivated pop culture in 2023 is back. And this time she’s not alone.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2025-06-27\",\"runtimeInMinutes\":120,\"trailerUrl\":\"https://www.youtube.com/watch?v=8mhQ6TRDnuE\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000413\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000578\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000705\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004784\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000004785\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004786\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004789\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000009464\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011434\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011435\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011436\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011437\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011438\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9e781b97-f78d-49f4-a57d-76a0726b15bd\",\"corporateId\":null},\"hopk\":\"HO00006208\",\"hoCode\":\"A000007664\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006110\",\"title\":{\"text\":\"F1® The Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career. Thirty years later, he’s a nomadic racer-for-hire when he’s approached by his former teammate Ruben Cervantes (Javier Bardem), owner of a struggling FORMULA 1 team that is on the verge of collapse. Ruben convinces Sonny to come back to FORMULA 1 for one last shot at saving the team and being the best in the world. He’ll drive alongside Joshua Pearce (Damson Idris), the team's hotshot rookie intent on setting his own pace. But as the engines roar, Sonny’s past catches up with him and he finds that in FORMULA 1, your teammate is your fiercest competition—and the road to redemption is not something you can travel alone.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate threat\",\"translations\":[]},\"releaseDate\":\"2025-06-25\",\"runtimeInMinutes\":156,\"trailerUrl\":\"https://www.youtube.com/watch?v=TZGY2CWPXeU\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000166\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000167\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001693\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002986\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003190\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003191\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008544\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008790\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011188\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"90334335-0de9-4985-8924-9942f4379b60\",\"corporateId\":null},\"hopk\":\"HO00006110\",\"hoCode\":\"A000007538\",\"eventId\":null,\"distributorName\":\"Warners\"}],\"castAndCrew\":[{\"id\":\"0000000029\",\"name\":{\"givenName\":\"Christopher\",\"familyName\":\"McQuarrie \",\"middleName\":null}},{\"id\":\"0000000030\",\"name\":{\"givenName\":\"Tom\",\"familyName\":\"Cruise\",\"middleName\":null}},{\"id\":\"0000000031\",\"name\":{\"givenName\":\"Rebecca\",\"familyName\":\"Ferguson\",\"middleName\":null}},{\"id\":\"0000000436\",\"name\":{\"givenName\":\"Holt \",\"familyName\":\"McCallany\",\"middleName\":null}},{\"id\":\"0000000802\",\"name\":{\"givenName\":\"Vanessa\",\"familyName\":\"Kirby\",\"middleName\"