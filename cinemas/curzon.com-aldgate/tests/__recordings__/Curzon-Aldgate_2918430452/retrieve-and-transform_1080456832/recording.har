            "text": "{\"name\":\"Aldgate\",\"urlSegment\":\"aldgate\",\"url\":\"/venues/aldgate/\",\"nodeId\":1784,\"alias\":\"cinema\",\"createDate\":\"2024-08-13T14:18:31\\u002B01:00\",\"updateDate\":\"2025-06-24T08:15:50\\u002B01:00\",\"robotsNoIndex\":false,\"robotsNoFollow\":false,\"masterCanonicalUrl\":null,\"excludeCanonicalUrl\":false,\"seoImage\":null,\"metaKeywords\":\"\",\"metaDescription\":\"Find out what\\u0027s on at Curzon Cinema in Aldgate. Check out the latest blockbuster movies, new Indie film releases and the best of world cinema out now.\",\"seoPageTitle\":\"Curzon Aldgate Cinema Showtimes \\u0026 Film Listings\",\"oGType\":\"\",\"twitterCard\":\"\",\"seoUrl\":\"\",\"oGLocale\":\"\",\"excludeFromXmlSitemap\":false,\"excludeFromSiteSearch\":false,\"pageTitle\":\"Curzon Aldgate Cinema Showtimes \\u0026 Film Listings\",\"hideTitle\":false,\"grid\":[{\"name\":\"gridCarouselQuotes\",\"columns\":[{\"size\":12,\"elements\":[{\"type\":\"gridCarouselQuotes\",\"value\":[{\"stars\":5,\"quoteHeadline\":\"Fantastic, from start to finish.\",\"subHeadline\":\"Bloomers, Google Local Guide\",\"backgroundColour\":{\"color\":\"00788d\",\"label\":\"blue\"}},{\"stars\":5,\"quoteHeadline\":\"Excellent cinema, excellent staff.\",\"subHeadline\":\"Shelley McPhee, Google Local Guide\",\"backgroundColour\":{\"color\":\"ff8200\",\"label\":\"orange\"}}],\"config\":{\"background\":null,\"fullWidth\":false,\"wideBackground\":false}}],\"config\":{}}],\"config\":{\"background\":null,\"fullWidth\":false,\"wideBackground\":false}}],\"redirectDetailsElement\":{\"redirect\":false,\"permanent\":false},\"heroCarouselDetailsElement\":[{\"image\":{\"mobile\":\"/media/c5upoeri/curzon-aldgate-bar-area.jpg?width=393\\u0026height=169\\u0026v=1daf1d80a531d20\",\"tablet\":\"/media/c5upoeri/curzon-aldgate-bar-area.jpg?width=782\\u0026height=315\\u0026v=1daf1d80a531d20\",\"desktop\":\"/media/c5upoeri/curzon-aldgate-bar-area.jpg?width=1216\\u0026height=523\\u0026v=1daf1d80a531d20\",\"alt\":\"\"},\"textHeading\":\"Welcome to Curzon Aldgate\",\"actionLink\":{\"name\":\"Take a Tour\",\"url\":\"https://tours.360virtualtours.co.uk/curzon/aldgate/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=393\\u0026height=169\\u0026v=1dbe4e025633ef0\",\"tablet\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=782\\u0026height=315\\u0026v=1dbe4e025633ef0\",\"desktop\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=1216\\u0026height=523\\u0026v=1dbe4e025633ef0\",\"alt\":\"\"},\"textHeading\":\"Support Stonewall on your Curzon cinema visit\",\"actionLink\":{\"name\":\"Find Out More\",\"url\":\"https://www.curzon.com/charity/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/pjsj0oss/pepperoni.jpg?width=393\\u0026height=169\\u0026v=1daf1d80a3f4700\",\"tablet\":\"/media/pjsj0oss/pepperoni.jpg?width=782\\u0026height=315\\u0026v=1daf1d80a3f4700\",\"desktop\":\"/media/pjsj0oss/pepperoni.jpg?width=1216\\u0026height=523\\u0026v=1daf1d80a3f4700\",\"alt\":\"\"},\"textHeading\":\"Food and Drink\",\"actionLink\":{\"name\":\"View Menu\",\"target\":\"_blank\",\"url\":\"/media/j10nivdb/menu-2.pdf\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/dfbazwtk/ph-aldgate.webp?width=393\\u0026height=169\\u0026v=1daf1d80a500fe0\",\"tablet\":\"/media/dfbazwtk/ph-aldgate.webp?width=782\\u0026height=315\\u0026v=1daf1d80a500fe0\",\"desktop\":\"/media/dfbazwtk/ph-aldgate.webp?width=1216\\u0026height=523\\u0026v=1daf1d80a500fe0\",\"alt\":\"\"},\"textHeading\":\"Hire This Space\",\"actionLink\":{\"name\":\"Contact Us\",\"url\":\"/private-hire/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/yzehnils/cocktail-image.webp?width=393\\u0026height=169\\u0026v=1daf1d80a3a3df0\",\"tablet\":\"/media/yzehnils/cocktail-image.webp?width=782\\u0026height=315\\u0026v=1daf1d80a3a3df0\",\"desktop\":\"/media/yzehnils/cocktail-image.webp?width=1216\\u0026height=523\\u0026v=1daf1d80a3a3df0\",\"alt\":\"\"}},{\"image\":{\"mobile\":\"/media/laalaq50/curzon-aldgate-screen-1-rear.jpg?width=393\\u0026height=169\\u0026v=1daf1d80a519680\",\"tablet\":\"/media/laalaq50/curzon-aldgate-screen-1-rear.jpg?width=782\\u0026height=315\\u0026v=1daf1d80a519680\",\"desktop\":\"/media/laalaq50/curzon-aldgate-screen-1-rear.jpg?width=1216\\u0026height=523\\u0026v=1daf1d80a519680\",\"alt\":\"\"}},{\"image\":{\"mobile\":\"/media/qpdke0ep/curzon-aldgate-screen-2-front.jpg?width=393\\u0026height=169\\u0026v=1daf1d80a542e90\",\"tablet\":\"/media/qpdke0ep/curzon-aldgate-screen-2-front.jpg?width=782\\u0026height=315\\u0026v=1daf1d80a542e90\",\"desktop\":\"/media/qpdke0ep/curzon-aldgate-screen-2-front.jpg?width=1216\\u0026height=523\\u0026v=1daf1d80a542e90\",\"alt\":\"\"}}],\"cinemaLocationDetailsElement\":{\"venueCardImage\":{\"mobile\":\"/media/ioapoyqt/cinema-venues-_aldgate.jpg?width=300\\u0026height=160\\u0026v=1db998a5955e6a0\",\"alt\":\"\"},\"addressLine1\":\"2 Canter Way\",\"city\":\"London\",\"postcode\":\"E1 8PS\",\"nearestStationName\":\"Aldgate East\",\"nearestStationType\":\"underground\"},\"vistaCinema\":{\"key\":\"ALD1\",\"value\":\"Aldgate\"},\"informationTabAccordions\":[{\"heading\":\"Opening Times\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EMonday to Saturday\\u003C/strong\\u003E: The cinema opens 30 minutes before the first show\\u0027s programme begins and closes at midnight.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESunday\\u003C/strong\\u003E: Closes at 11.30pm.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cem\\u003EPlease be aware opening and closing times may be subject to change.\\u003C/em\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Screen info\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 1\\u003C/strong\\u003E\\u003Cbr\\u003E63 seats, 2 wheelchair spaces\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 2\\u003C/strong\\u003E\\u003Cbr\\u003E76 seats, 2 wheelchair spaces\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 3\\u003C/strong\\u003E\\u003Cbr\\u003E70 seats, 2 wheelchair spaces\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 4\\u003C/strong\\u003E\\u003Cbr\\u003E58 seats, 2 wheelchair spaces\\u003C/p\\u003E\"},{\"heading\":\"Accessibility\",\"body\":\"\\u003Cp\\u003EThe cinema is on one level and wheelchair-accessible; each screen has two wheelchair spaces. There is a wheelchair-accessible bathroom.\\u003C/p\\u003E\\n\\u003Cp\\u003EAudio Description and hearing-assist headsets are available on request.\\u003C/p\\u003E\"},{\"heading\":\"Food and drink\",\"body\":\"\\u003Cp\\u003EFresh coffee, teas and cakes alongside an all day menu of pizza and bar food with vegan and vegetarian options available. The drinks menu includes a wide selection of cocktails, wine, craft beer and soft drinks.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca href=\\u0022https://www.curzon.com/media/j10nivdb/menu-2.pdf\\u0022\\u003ESee our full menu here.\\u003C/a\\u003E\\u003C/span\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Happy Hour Information\",\"body\":\"\\u003Cp\\u003EAt this venue Happy Hour is 5pm to 10pm every day, 2 for \\u00A316 on all cocktails.\\u003C/p\\u003E\"},{\"heading\":\"Private Hires\",\"body\":\"\\u003Cp\\u003EOur screens are available to rent for your private functions, email \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca href=\\u0022mailto:privatehires@curzon.com\\u0022 title=\\u0022Email Curzon Private Hires\\u0022\\u003Eprivatehires@curzon.com\\u003C/a\\u003E\\u003C/span\\u003E for more information.\\u003C/p\\u003E\\n\\u003Cp\\u003ETo find out more, visit our \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca href=\\u0022/private-hire/aldgate/\\u0022 title=\\u0022Curzon Aldgate Private Hires\\u0022\\u003EPrivate Hires page\\u003C/a\\u003E\\u003C/span\\u003E.\\u003C/p\\u003E\"},{\"heading\":\"Social Media\",\"body\":\"\\u003Cp\\u003EInstagram: \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca href=\\u0022https://www.instagram.com/accounts/login/?next=https%3A%2F%2Fwww.instagram.com%2Fcurzon.aldgate%2F%3Figsh%3DNDljcTJhbjBwbGg2\\u0026amp;is_from_rle\\u0022 title=\\u0022Curzon Aldgate Instagram\\u0022 data-anchor=\\u0022?next=https%3A%2F%2Fwww.instagram.com%2Fcurzon.aldgate%2F%3Figsh%3DNDljcTJhbjBwbGg2\\u0026amp;is_from_rle\\u0022\\u003Ecurzon.aldgate\\u003C/a\\u003E\\u003C/span\\u003E\\u003C/p\\u003E\"}],\"informationTabDescription\":\"\\u003Cp\\u003EA mere stone\\u2019s throw from the City, our peerless East End cinema combines the best of the old and the new, with its 1940s-inspired style seamlessly blending with state-of-the-art technology. There\\u2019s a large, open-plan bar and caf\\u00E9, perfect for enjoying a coffee during the day or a glass of wine in the evening, and each of Curzon Aldgate\\u2019s four screens has plush reclining seats and side tables.\\u003C/p\\u003E\",\"menuTabAccordions\":[{\"heading\":\"Pizza\",\"body\":\"\\u003Ctable border=\\u00221\\u0022 style=\\u0022border-collapse: collapse; width: 100%; height: 382px;\\u0022\\u003E\\n\\u003Ctbody\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EMargherita (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A311.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EPepperoni \\u0026amp; Honey\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022wi