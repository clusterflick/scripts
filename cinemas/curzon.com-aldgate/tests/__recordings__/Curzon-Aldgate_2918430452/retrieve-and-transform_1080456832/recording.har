 style=\\u0022width: 39.8654%; height: 18.5px; text-align: right;\\u0022\\u003E\\u00A37.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003ECheesy Garlic Flatbread (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; height: 18.5px; text-align: right;\\u0022\\u003E\\u00A38.95\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px; text-align: left;\\u0022\\u003EDip\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; height: 18.5px; text-align: right;\\u0022\\u003E\\u00A31.85\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 21.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 21.5px;\\u0022\\u003EExtra topping\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; height: 21.5px; text-align: right;\\u0022\\u003E\\u00A32.00\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003C/tbody\\u003E\\n\\u003C/table\\u003E\"},{\"heading\":\"sharing plates 3 FOR \\u00A315\",\"body\":\"\\u003Ctable border=\\u00221\\u0022 style=\\u0022border-collapse: collapse; width: 100%; height: 72px;\\u0022\\u003E\\n\\u003Ctbody\\u003E\\n\\u003Ctr style=\\u0022height: 18px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18px;\\u0022\\u003ENocellara Olives (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18px; text-align: right;\\u0022\\u003E\\u00A34.75\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18px;\\u0022\\u003EPadr\\u00F3n Peppers (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18px; text-align: right;\\u0022\\u003E\\u00A36.00\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 49.3728%; height: 18px;\\u0022