asses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"ALD1-130-HO00007116\"}],\"relatedData\":{\"sites\":[{\"id\":\"ALD1\",\"name\":{\"text\":\"Aldgate\",\"translations\":[]},\"location\":{\"latitude\":51.5139007568359,\"longitude\":-0.0689999982714653},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"ALD1@curzon.com\",\"address\":{\"line1\":\"2 Canter Way,\",\"line2\":\"London,\",\"city\":\"E1 8PS\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007116\",\"title\":{\"text\":\"The Odyssey\",\"translations\":[]},\"synopsis\":{\"text\":\"Legendary filmmaker Christopher Nolan follows up his Oscar-winning sensation Oppenheimer with another rousing epic, The Odyssey, whose all-star cast includes Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson, Lupita Nyong'o, Zendaya and Charlize Theron.\\n\\nThis mythic action movie recounts the story of Odysseus (Damon) on his perilous journey home, troubled by gods and monsters. Meanwhile, his wife Penelope (Hathaway) and son Telemachus (Holland) fight to hold their kingdom together against relentless suitors.\\n\\nSee it on 35mm film at Soho, and enjoy it with Dolby Atmos sound at Bloomsbury, Canterbury Riverside and Kingston.\\n\\nTHE ODYSSEY MIDNIGHT SCREENINGS\\nThe film will start promptly at 12:01am on Thursday night. Please ensure you are seated by midnight.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":172,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/b3ff6b75-3025-43b7-88a5-37fc8c43d313/media/TrailerVideo\"},{\