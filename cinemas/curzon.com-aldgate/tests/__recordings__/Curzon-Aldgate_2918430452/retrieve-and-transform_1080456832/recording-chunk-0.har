          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-09-15\",\"showtimes\":[{\"id\":\"ALD1-65209\",\"schedule\":{\"businessDate\":\"2026-09-15\",\"startsAt\":\"2026-09-15T21:00:00+01:00\",\"endsAt\":\"2026-09-15T23:03:00+01:00\",\"filmStartsAt\":\"2026-09-15T21:25:00+01:00\",\"filmEndsAt\":\"2026-09-15T23:03:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"ALD1-4-2\",\"filmId\":\"HO00007245\",\"siteId\":\"ALD1\",\"screenId\":\"ALD1-4\",\"areaCategories\":[{\"areaCategoryId\":\"ALD1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"ALD1\",\"name\":{\"text\":\"Aldgate\",\"translations\":[]},\"location\":{\"latitude\":51.5139007568359,\"longitude\":-0.0689999982714653},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"ALD1@curzon.com\",\"address\":{\"line1\":\"2 Canter Way,\",\"line2\":\"London,\",\"city\":\"E1 8PS\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007245\",\"title\":{\"text\":\"Curzon Film 50: Winter's Bone\",\"translations\":[]},\"synopsis\":{\"text\":\"17-year-old Ree is desperately seeking her father, who disappeared after using the family home as security for his bail.\\n\\nFaced with the possibility of losing her home and being turned out into the Ozark woods, Ree challenges her outlaw kin's code of silence and risks her life to protect her younger siblings and sick mother. She hacks through the lies, evasions and threats offered by her relatives and begins to piece together the truth.\\n\\nWinner of the 2010 Sundance Grand Jury Prize, Winter’s Bone is directed by Debra Granik and adapted for the screen by Granik and Anne Rosellini. Based on the best-selling novel by Daniel Woodrell, this tense, naturalistic thriller also stars John Hawkes, Kevin Breznahan, Dale Dickey, Garret Dillahunt, Sheryl Lee and Tate Taylor.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"17-year-old Ree is desperately seeking her father, who disappeared after using the family home as security for his bail.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"Contains strong language and drug use\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":98,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002338\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002867\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000885\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000886\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000887\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000888\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000889\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000890\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000891\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000002338\"},{\"castAndCrewMemberId\":\"0000002867\"},{\"castAndCrewMemberId\":\"HO00000885\"},{\"castAndCrewMemberId\":\"HO00000886\"},{\"castAndCrewMemberId\":\"HO00000887\"},{\"castAndCrewMemberId\":\"HO00000888\"}],\"directors\":[{\"castAndCrewMemberId\":\"HO00000889\"}],\"producers\":[{\"castAndCrewMemberId\":\"HO00000890\"},{\"castAndCrewMemberId\":\"HO00000891\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007245\",\"hoCode\":\"A000008912\",\"eventId\":\"0000000068\",\"distributorName\":\"Curzon\"}],\"castAndCrew\":[{\"id\":\"0000002338\",\"name\":{\"givenName\":\"Jennifer\",\"familyName\":\"Lawrence\",\"middleName\":null}},{\"id\":\"0000002867\",\"name\":{\"givenName\":\"Garret\",\"familyName\":\"Dillahunt\",\"middleName\":null}},{\"id\":\"HO00000885\",\"name\":{