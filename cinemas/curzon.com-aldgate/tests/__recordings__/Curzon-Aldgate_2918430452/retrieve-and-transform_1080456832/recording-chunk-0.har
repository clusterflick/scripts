les\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004703\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005314\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007765\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c566d7dc-50bb-4d55-984b-c4c65751933e\",\"corporateId\":null},\"hopk\":\"HO00006677\",\"hoCode\":\"A000008241\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006679\",\"title\":{\"text\":\"28 Years Later: The Bone Temple\",\"translations\":[]},\"synopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later: The Bone Temple. In a continuation of the epic story, Dr. Kelson (Ralph Fiennes) finds himself in a shocking new relationship - with consequences that could change the world as they know it - and Spike's (Alfie Williams) encounter with Jimmy Crystal (Jack O'Connell) becomes a nightmare he can't escape. In the world of The Bone Temple, the infected are no longer the greatest threat to survival - the inhumanity of the survivors can be stranger and more terrifying. \\r\\n\\r\\nCUSTOMER NOTICE: This screening is restricted to viewers aged 18 and over. Valid identification must be presented at admission.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later.\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-16\",\"runtimeInMinutes\":110,\"trailerUrl\":\"https://www.youtube.com/watch?v=rl_DJZCyEH4\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000313\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001245\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001270\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003206\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010558\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011257\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011419\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012645\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012802\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ce27f9c4-2b7c-4839-b9e6-0ceceb8e7949\",\"corporateId\":null},\"hopk\":\"HO00006679\",\"hoCode\":\"A000008243\",\"eventId\":null,\"distributorName\":\"Sony Pictures\"},{\"id\":\"HO00006689\",\"title\":{\"text\":\"No Other Choice\",\"translations\":[]},\"synopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":139,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000012169\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012827\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012828\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012829\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012830\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012831\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000026\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9ecc0908-a983-42f7-9591-6f8d73d7488b\",\"corporateId\":null},\"hopk\":\"HO00006689\",\"hoCod