          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-25\",\"showtimes\":[{\"id\":\"ALD1-65207\",\"schedule\":{\"businessDate\":\"2026-08-25\",\"startsAt\":\"2026-08-25T20:40:00+01:00\",\"endsAt\":\"2026-08-25T23:17:00+01:00\",\"filmStartsAt\":\"2026-08-25T21:05:00+01:00\",\"filmEndsAt\":\"2026-08-25T23:17:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"ALD1-4-2\",\"filmId\":\"HO00007233\",\"siteId\":\"ALD1\",\"screenId\":\"ALD1-4\",\"areaCategories\":[{\"areaCategoryId\":\"ALD1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"ALD1\",\"name\":{\"text\":\"Aldgate\",\"translations\":[]},\"location\":{\"latitude\":51.5139007568359,\"longitude\":-0.0689999982714653},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"ALD1@curzon.com\",\"address\":{\"line1\":\"2 Canter Way,\",\"line2\":\"London,\",\"city\":\"E1 8PS\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007233\",\"title\":{\"text\":\"Curzon Film 50: Parasite: Black & White\",\"translations\":[]},\"synopsis\":{\"text\":\"After its extraordinary success in Cannes and at the Oscars, Golden Globes, BAFTAs, Independent Spirit Awards, and, we could go on, Bong Joon Ho’s brilliant Palme d’Or-winner returns in this special black-and-white version. The transfer was overseen by director Bong and offers the lustrous contrasts of monochrome.\\n\\nThe Kims are living a marginal life when their son fakes his way into becoming the English tutor for the ultra-wealthy Park family. Soon all four of the family members have roles in their hyper-stylish modern home, having used every dirty trick in the book. But the house hides secrets that are way outside the Kim's scheme.\\n\\nWinning 4 Oscars including Best Picture and already the most successful Palme d’Or winner ever, Parasite is what happens when the have-nots have their day. A deliciously fun poisoned cocktail of dark humour, social satire, and perfect set pieces, this gripping thriller is a sensational experience that keeps surprising to its last drop.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Winner of the Palme d'Or at the 2019 Cannes Film Festival. Bong Joon-ho returns with this black comedy about wealth, greed and class discrimination.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong bloody violence, language, sex, sex references\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":132,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=5v1-PkankrM\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=5v1-PkankrM\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004980\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007089\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010623\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000407\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000408\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000411\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000414\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000826\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000827\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000828\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000829\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000830\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000831\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000832\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000004980\"},{\"castAndCrewMemberId\":\"0000007089\"},{\"castAndCrewMemberId\":\"HO00000407\"},{\"castAndCrewMemberId\":\"HO00000408\"},{\"castAndCrewMemberId\":\"HO00000411\"},{\"castAndCrewMemberId\":\"HO00000826\"},{\"castAndCrewMemberId\":\"HO00000827\"},{\"castAndCrewMemberId\":\"HO00000828\"},{\"castAndCrewMemberId\":\"HO00000829\"},{\"castAndCrewMemberId\":\"HO00000830\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000010623\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000010623\"},{\"castAndCrewMemberId\":\"HO00000414\"},{\"castAndCrewMemberId\":\"HO00000831\"},{\"castAndCrewMemberId\":\"HO00000832\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007233\",\"hoCode\":\"A000008899\",\"eventId\":\"0000000068\",\"distributorName\":\"Curzon\"}],\"castAndCrew\":[{\"id\":\"0000004980\",\"name\":{\"givenName\":\"Kang-ho\",\"familyName\":\"Song\",\"middleName\":null}},{\"id\":\"0000007089\",\"name\":{\"givenName\":\"Seo-joon \",\"familyName\":\"Park\",\"middleName\":null}},{\"id\":\"0000010623\",\"name\":{\"givenName\":\"Bong\",\"familyName\":\"Joon-ho\",\"middleName\":null}},{\"id\":\"HO00000407\",\"name\":{\"givenName\":\"Woo-sik \",\"familyName\":\"Choi\",\"middleName\":null}},{\"id\":\"HO00000408\",\"name\":{\"givenName\":\"Sun-kyun\",\"familyName\":\"Lee\",\"middleName\":null}},{\"id\":\"HO00000411\",\"name\":{\"givenName\":\"So-dam\",\"familyName\":\"Park\",\"middleName\":null}},{\"id\":\"HO00000414\",\"name\":{\"givenName\":\"Kwak\",\"familyName\":\"Sin-ae\",\"middleName\":null}},{\"id\":\"HO00000826\",\"name\":{\"givenName\":\"Cho Yeo\",\"familyName\":\"Jeong\",\"middleName\":null}},{\"id\":\"HO00000827\",\"name\":{\"givenName\":\"Jeong-eun\",\"familyName\":\"Lee\",\"middleName\":null}},{\"id\":\"HO00000828\",\"name\":{\"givenName\":\"Hye-jin\",\"familyName\":\"Jang\",\"middleName\":null}},{\"id\":\"HO00000829\",\"name\":{\"givenName\":\"Ji-so\",\"familyName\":\"Jung\",\"middleName\":null}},{\"id\":\"HO00000830\",\"name\":{\"givenName\":\"Myeong-hoon\",\"familyName\":\"Park\",\"middleName\":null}},{\"id\":\"HO00000831\