            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-02-12\",\"showtimes\":[{\"id\":\"ALD1-61748\",\"schedule\":{\"businessDate\":\"2026-02-12\",\"startsAt\":\"2026-02-12T18:00:00+00:00\",\"endsAt\":\"2026-02-12T20:18:00+00:00\",\"filmStartsAt\":\"2026-02-12T18:25:00+00:00\",\"filmEndsAt\":\"2026-02-12T20:18:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"ALD1-1-1\",\"filmId\":\"HO00006807\",\"siteId\":\"ALD1\",\"screenId\":\"ALD1-1\",\"areaCategories\":[{\"areaCategoryId\":\"ALD1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"ALD1\",\"name\":{\"text\":\"Aldgate\",\"translations\":[]},\"location\":{\"latitude\":51.5139,\"longitude\":-0.069},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"2 Canter Way,\",\"line2\":\"London,\",\"city\":\"E1 8PS\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006807\",\"title\":{\"text\":\"Film Club: Promising Young Woman\",\"translations\":[]},\"synopsis\":{\"text\":\"From visionary director Emerald Fennell (Killing Eve) comes a delicious new take on revenge. Everyone said Cassie (Carey Mulligan) was a promising young woman... until a mysterious event abruptly derailed her future.  But nothing in Cassie’s life is what it appears to be: she’s wickedly smart, tantalizingly cunning, and she’s living a secret double life by night.  Now, an unexpected encounter is about to give Cassie a chance to right the wrongs of the past in this thrilling and wildly entertaining story. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A young woman, traumatized by a tragic event in her past, seeks out vengeance against men who cross her path.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"sexual violence, violence, drug misuse, language, sex references\",\"translations\":[]},\"releaseDate\":\"2026-02-12\",\"runtimeInMinutes\":113,\"trailerUrl\":\"https://www.youtube.com/watch?v=edQGxerOHeg\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000122\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001093\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003207\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004297\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004380\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005398\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005648\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000005650\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005651\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006020\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006739\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009622\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009878\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011763\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012676\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013267\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013268\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013269\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\",\"0000000003\",\"0000000026\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006807\",\"hoCode\":\"A000008398\",\"eventId\":null,\"distributorName\":\"Park Circus\"}],\"castAndCrew\":[{\"id\":\"0000000122\",\"name\":{\"givenName\":\"Margot \",\"familyName\":\"Robbie\",\"middleName\":null}},{\"id\":\"0000001093\",\"name\":{\"givenName\":\"Ben\",\"familyName\":\"Browning\",\"middleName\":null}},{\"id\":\"0000003207\",\"name\":{\"givenName\":\"Jennifer \",\"familyName\":\"Coolidge\",\"middleName\":null}},{\"id\":\"0000004297\",\"name\":{\"givenName\":\"Connie\",\"