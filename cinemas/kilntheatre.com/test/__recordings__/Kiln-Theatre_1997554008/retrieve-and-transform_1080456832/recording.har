play: block !important;\n    }\n</style>\n\n<article class=\"no-support\">\n    <h4>Unfortunately the Kiln Theatre website is not accessible via the browser you're currently using.</h4>\n    <p>We recommend <a href=\"http://www.whatbrowser.org/intl/en_uk/\">upgrading your browser</a>.</p>\n</article>\n<![endif]-->\n    <main class=\"global-wrap\">\n<section class=\"c-container--padded c-container--title-bar u-red-bg\">\n    <div class=\"max-width-wrap\">\n        <h3 class=\"c-container-title c-container-title--bar\">Now Showing</h3>\n    </div>\n</section>\n\n<!-- Masthead -->\n<section class=\"masthead pg__masthead pg__masthead--cinema-image c-box-gradient\" style=\"background-image: url('https://d3bz2hz99ijuc5.cloudfront.net/wp-content/uploads/2025/07/NT-Live.png?resize=1990%2C796&gravity');\">\n    <div class=\"h-row h-row--film\">\n        <h1 class=\"pg__title\">NT Live: Hamlet</h1>\n        <h2>22 Jan - 24 Jan 2026</h2>\n\n                    <ul class=\"h-row__film-info\">\n                                    <li>By William Shakespeare</li>\n                                    <li>Directed by Robert Hastie</li>\n                            </ul>\n            </div>\n</section>\n\n<!-- Book and Trailer Buttons -->\n<section class=\"c-container--padded u-white-bg\">\n    <div class=\"max-width-wrap\">\n        <ul class=\"c-cinema-book\">\n                            <li><a data-fresco-group=\"trailer\" data-fresco-caption=\"\" class=\"fresco c-btn c-btn--primary\" href=\"https://www.youtube.com/embed/bAvteqeeBFo\">View Trailer</a></li>\n            \n                            <li>\n                    <a href=\"https://kilntheatre.com/whats-on/nt-live-hamlet/#book\" class=\"c-btn c-btn--primary c-btn--book-film \">\n                        Book Now                    </a>\n                </li>\n                    </ul>\n    </div>\n</section>\n\n<!-- Introduction -->\n    <section class=\"c-container--padded u-white-bg\">\n        <div class=\"max-width-wrap\">\n            <div class=\"c-col-txt\">\n                <p>Olivier Award-winner Hiran Abeysekera (<em>Life of Pi</em>) is Hamlet in this fearless, contemporary take on Shakespeare’s famous tragedy. Trapped between duty and doubt, surrounded by power and privilege, young Prince Hamlet dares to ask the ultimate question – you know the one.</p>\n<p>National Theatre Deputy Artistic Director, Robert Hastie (<em>Standing at the Sky’s Edge, Operation Mincemeat</em>) directs this sharp, stylish and darkly funny reimagining.</p>\n            </div>\n        </section>\n    </section>\n\n<!-- Construkt -->\n\n<!-- Films -->\n    <section class=\"c-container--padded c-container--center-title u-white-bg film-book\" id=\"book\">\n        <div class=\"max-width-wrap\">\n            <div class=\"c-film-bookings c-film-bookings--single\">\n                <h3 class=\"c-container-title c-container-title--bar\">Book Now</h3>\n                                    <div class=\"c-booking-single\">\n                        <ul class=\"c-single-performance\">\n                                                            <li class=\"instance \">\n                                    <div class=\"c-single-performance__date-wrapper\">\n                                        <div class=\"c-film-booking__date\">\n                                            Thursday 22nd January                                        </div>\n                                    </div>\n                                                                        <a href=\"https://kilntheatre.com/whats-on/nt-live-hamlet/book/741649\" class=\"c-btn c-btn--primary \">\n                                                    7.00PM\n                                                                                                    </a>\n                                </li>\n                                                    </ul>\n                    </div>\n                                    <div class=\"c-booking-single\">\n                        <ul class=\"c-single-performance\">\n                                                            <li class=\"instance captioned-screening\">\n                                    <div class=\"c-single-performance__date-wrapper\">\n                                        <div class=\"c-film-booking__date\">\n                                            Saturday 24th January                                        </div>\n                                    </div>\n                                                                            <div class=\"instance__type\">captioned screening</div>\n                                                                        <a href=\"https://kilntheatre.com/whats-on/nt-live-hamlet/book/741849\" class=\"c-btn c-btn--primary \">\n                                                    7.00PM\n                                                                                                    </a>\n                                </li>\n                                                    </ul>\n                    </div>\n                            </div>\n        </div>\n    </section>\n    </main> <!-- close global-wrap -->\n\n    <section class=\"c-footer__newsletter-form\">\n    <div class=\"o-max o-max--1400\">\n        <div class=\"o-layout o-layout--large\">\n            <div class=\"o-layout__item u-1/1@tablet\" id=\"sign-up-form\">\n                <form accept-charset=\"UTF-8\" id=\"spextrix-signup-form\">\n    <div class=\"c-newsletter-form\">\n        <h4 class=\"c-newsletter-form__title u-margin-bottom-none\">Newsletter Sign Up</h4>\n\n        <div class=\"c-newsletter-form__signup-container\">\n            <div class=\"c-newsletter-form__description\">\n                <p class=\"c-smallprint\">Sign up to receive updates from us.</p>\n                <p class=\"c-smallprint\">Your privacy is important to us. Please <a href=\"https://kilntheatre.com/privacy-policy/\">click here</a> to read 