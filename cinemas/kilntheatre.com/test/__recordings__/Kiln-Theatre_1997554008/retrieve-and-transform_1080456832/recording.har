r--title-bar u-red-bg\">\n    <div class=\"max-width-wrap\">\n        <h3 class=\"c-container-title c-container-title--bar\">Now Showing</h3>\n    </div>\n</section>\n\n<!-- Masthead -->\n<section class=\"masthead pg__masthead pg__masthead--cinema-image c-box-gradient\" style=\"background-image: url('https://d3bz2hz99ijuc5.cloudfront.net/wp-content/uploads/2025/09/4-2.png?resize=1990%2C796&gravity');\">\n    <div class=\"h-row h-row--film\">\n        <h1 class=\"pg__title\">Plainclothes</h1>\n        <h2>29 Oct - 30 Oct 2025</h2>\n\n                    <ul class=\"h-row__film-info\">\n                                    <li>Directed by Carmen Emmi</li>\n                                    <li>Starring Tom Blyth, Russell Tovey, Amy Forsyth and Maria Dizzia</li>\n                                    <li>95 mins</li>\n                            </ul>\n            </div>\n</section>\n\n<!-- Book and Trailer Buttons -->\n<section class=\"c-container--padded u-white-bg\">\n    <div class=\"max-width-wrap\">\n        <ul class=\"c-cinema-book\">\n                            <li><a data-fresco-group=\"trailer\" data-fresco-caption=\"\" class=\"fresco c-btn c-btn--primary\" href=\"https://www.youtube.com/embed/nut6o9Cxi7o\">View Trailer</a></li>\n            \n                            <li>\n                    <a href=\"https://kilntheatre.com/whats-on/plainclothes/#book\" class=\"c-btn c-btn--primary c-btn--book-film \">\n                        Book Now                    </a>\n                </li>\n                    </ul>\n    </div>\n</section>\n\n<!-- Introduction -->\n    <section class=\"c-container--padded u-white-bg\">\n        <div class=\"max-width-wrap\">\n            <div class=\"c-col-txt\">\n                <p>It’s 1996 and Lucas (Tom Blyth, The Hunger Games) is cruising in a California shopping mall. But once he’s captured the attention of another man, it’s a bait and switch: Lucas is an undercover cop, and he’s entrapping men in the name of ‘public protection’. However, Lucas is increasingly conflicted as he finds himself falling for potential target Andrew (Russell Tovey). Realising they both have secrets to hold, this profound intimacy begins to spark dangerous truths on all sides.</p>\n<p>A showcase for some of the UK’s best actors, Plainclothes is a trip back to a time not so long ago, but shockingly hard to imagine for its distance in advances in LGBT rights. Gripping and tense, as well as full of touching and hard-won intimacy, Plainclothes is a terrific debut.</p>\n            </div>\n        </section>\n    </section>\n\n<!-- Construkt -->\n\n<!-- Films -->\n    <section class=\"c-container--padded c-container--center-title u-white-bg film-book\" id=\"book\">\n        <div class=\"max-width-wrap\">\n            <div class=\"c-film-bookings c-film-bookings--single\">\n                <h3 class=\"c-container-title c-container-title--bar\">Book Now</h3>\n                                    <div class=\"c-booking-single\">\n                        <ul class=\"c-single-performance\">\n                                                            <li class=\"instance parent-and-baby-screening\">\n                                    <div class=\"c-single-performance__date-wrapper\">\n                                        <div class=\"c-film-booking__date\">\n                                            Wednesday 29th October                                        </div>\n                                    </div>\n                                                                            <div class=\"instance__type\">parent and baby screening</div>\n                                                                        <a href=\"https://kilntheatre.com/whats-on/plainclothes/book/771850\" class=\"c-btn c-btn--primary \">\n                                                    11.00AM\n                                                                                                    </a>\n                          