=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-35321\"><a href=\"https://kilntheatre.com/our-story/hire/\">Hires</a></li>\n<li id=\"menu-item-23505\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-23505\"><a href=\"https://kilntheatre.com/kiln-card/\">Kiln Card</a></li>\n</ul>            \n                            <ul id=\"menu-main-menu-secondary-nav\" class=\"o-nav global-header__nav global-header__nav--secondary\"><li id=\"menu-item-21712\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-21712\"><a href=\"https://kilntheatre.com/your-visit/\">Your Visit</a></li>\n<li id=\"menu-item-14318\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-14318\"><a href=\"https://kilntheatre.com/your-visit/access/\">Access</a></li>\n<li id=\"menu-item-21931\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-21931\"><a href=\"https://kilntheatre.com/how-to-get-here/food-and-drink/\">Food and Drink</a></li>\n<li id=\"menu-item-14316\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-14316\"><a href=\"https://kilntheatre.com/our-story/\">Our Story</a></li>\n<li id=\"menu-item-19804\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-19804\"><a href=\"https://kilntheatre.com/our-story/jobs/\">Our Job Opportunities</a></li>\n</ul>            \n                    </div>\n    </div>\n</header>\n\n    <!--[if lte IE 8]>\n<style>\n    body > * {\n        display: none !important;\n    }\n\n    body .no-support {\n        display: block !important;\n    }\n</style>\n\n<article class=\"no-support\">\n    <h4>Unfortunately the Kiln Theatre website is not accessible via the browser you're currently using.</h4>\n    <p>We recommend <a href=\"http://www.whatbrowser.org/intl/en_uk/\">upgrading your browser</a>.</p>\n</article>\n<![endif]-->\n    <main class=\"global-wrap\">\n<section class=\"c-container--padded c-container--title-bar u-red-bg\">\n    <div class=\"max-width-wrap\">\n        <h3 class=\"c-container-title c-container-title--bar\">Now Showing</h3>\n    </div>\n</section>\n\n<!-- Masthead -->\n<section class=\"masthead pg__masthead pg__masthead--cinema-image c-box-gradient\" style=\"background-image: url('https://d3bz2hz99ijuc5.cloudfront.net/wp-content/uploads/2025/10/7-1.png?resize=1990%2C796&gravity');\">\n    <div class=\"h-row h-row--film\">\n        <h1 class=\"pg__title\">The Choral</h1>\n        <h2>14 Nov - 26 Nov 2025</h2>\n\n                    <ul class=\"h-row__film-info\">\n                                    <li>Directed by Nicholas Hytner</li>\n                                    <li>Starring Ralph Fiennes, Roger Allam, Mark Addy, Alun Armstrong, Robert Emms, Simon Russell Beale and Oliver Chris</li>\n                                    <li>113 mins</li>\n                            </ul>\n            </div>\n</section>\n\n<!-- Book and Trailer Buttons -->\n<section class=\"c-container--padded u-white-bg\">\n    <div class=\"max-width-wrap\">\n        <ul class=\"c-cinema-book\">\n                            <li><a data-fresco-group=\"trailer\" data-fresco-caption=\"\" class=\"fresco c-btn c-btn--primary\" href=\"https://www.youtube.com/embed/EYMIhLwiHVs\">View Trailer</a></li>\n            \n                            <li>\n                    <a href=\"https://kilntheatre.com/whats-on/the-choral/#book\" class=\"c-btn c-btn--primary c-btn--book-film \">\n                        Book Now                    </a>\n                </li>\n                    </ul>\n    </div>\n</section>\n\n<!-- Introduction -->\n    <section class=\"c-container--padded u-white-bg\">\n        <div class=\"max-width-wrap\">\n            <div class=\"c-col-txt\">\n                <p>Directed by Nicholas Hytner and written by Alan Bennett (the pair teaming up again following <i>The History Boys, The Madness of King George </i>and<i> The Lady and the Van</i>), this British drama-comedy is one of the year’s genuine treats. Set in Yorkshire, it follows the attempts to mount a choral performance while the show’s usual players have been conscripted in the First World War. Drafted into choirmaster role Dr Henry Guthrie (Ralph Fiennes) must turn a troupe of novices and vagabonds into a serviceable spectacle, all while world events cast a long shadow.<span class=\"Apple-converted-space\"> </span></p>\n<p>Ralph Fiennes anchors this story, the latest addition to a career purple patch with varied yet excellent roles in <i>Conclave</i>, <i>28 Years Later </i>and<i> The Menu.</i> As one would expect from a film helmed by a former artistic director of the The National Theatre, it also boast a supporting cast of theatre heavyweights (Simon Russell Beale, Roger Allam, Oliver Chris) and superb new finds (Jacob Dudman, Amara Okereke and Taylor Uttley) that offer a refreshingly different perspective of life during wartime. <span class=\"Apple-converted-space\"> </span></p>\n            </div>\n        </section>\n    </section>\n\n<!-- Construkt -->\n\n<!-- Films -->\n    <section class=\"c-container--padded c-container--center-title u-white-bg film-book\" id=\"book\">\n        <div class=\"max-width-wrap\">\n            <div class=\"c-film-bookings c-film-bookings--single\">\n                <h3 class=\"c-container-title c-container-title--bar\">Book Now</h3>\n                                    <div class=\"c-booking-single\">\n                        <ul class=\"c-single-performance\">\n                                                            <li class=\"instance \">\n                                    <div class=\"c-single-performance__date-wrapper\">\n                                        <div class=\"c-film-booking__date\">\n                                            Friday 14th November                                        </div>\n                                    </div>\n                                                            