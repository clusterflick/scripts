                        c = c.substring(1);\n                                    }\n                                    if (c.indexOf(name) == 0) {\n                                        return c.substring(name.length, c.length);\n                                    }\n                                }\n                                return \"\";\n                            }\n                        };\n\n                        if (!Cookies.get('cookiesAccepted')) {\n                            $('#cookies-warning').show();\n                        }\n\n                        $('#accept-cookies').on('click', function(event) {\n                            event.preventDefault();\n                            Cookies.accept(60);\n                            $(this).parents('#cookies-warning').remove();\n                        });\n                    })();\n                </script></body>\n</html>\n"
