.com/tricycle/website/secure/signup.aspx\" method=\"POST\">\n            <div class=\"dialog-wrapper\">\n                <input name=\"ReturnUrl\" type=\"hidden\" value=\"https://kilntheatre.com/thank-you?signup\" />\n                <input autofocus name=\"FirstName\" type=\"text\" placeholder=\"First name\" />\n                <input name=\"LastName\" type=\"text\" placeholder=\"Last name\" />\n                <input name=\"Email\" type=\"text\" placeholder=\"Email\" />\n                <input type=\"submit\" value=\"Sign up\" class=\"submit\" />\n            </div>\n        </form>\n    </div>\n</section>\n    </dialog>\n</div>\n\n<script type=\"text/javascript\" src=\"https://kilntheatre.com/admin/wp-includes/js/dist/vendor/moment.min.js?ver=2.29.4\" id=\"moment-js\"></script>\n<script type=\"text/javascript\" id=\"moment-js-after\">\n/* <![CDATA[ */\nmoment.updateLocale( 'en_US', {\"months\":[\"January\",\"February\",\"March\",\"April\",\"May\",\"June\",\"July\",\"August\",\"September\",\"October\",\"November\",\"December\"],\"monthsShort\":[\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\",\"Dec\"],\"weekdays\":[\"Sunday\",\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\"],\"weekdaysShort\":[\"Sun\",\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\",\"Sat\"],\"week\":{\"dow\":1},\"longDateFormat\":{\"LT\":\"g:i a\",\"LTS\":null,\"L\":null,\"LL\":\"F j, Y\",\"LLL\":\"F j, Y g:i a\",\"LLLL\":null}} );\n/* ]]> */\n</script>\n<script type=\"text/javascript\" id=\"full-calendar-js-extra\">\n/* <![CDATA[ */\nvar attendable = {\"instances\":{\"20251029\":[{\"ID\":40794,\"post_author\":\"29\",\"post_date\":\"2025-09-29 16:51:32\",\"post_date_gmt\":\"2025-09-29 15:51:32\",\"post_content\":\"\",\"post_title\":\"Plainclothes\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"open\",\"ping_status\":\"open\",\"post_password\":\"\",\"post_name\":\"plainclothes\",\"to_ping\":\"\",\"pinged\":\"\",\"post_