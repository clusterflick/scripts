nu-item-608\"><a href=\"https://kilntheatre.com/give/\">Give</a></li>\n<li id=\"menu-item-1946\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-1946\"><a href=\"https://kilntheatre.com/creative-engagement/\">Creative Engagement</a></li>\n<li id=\"menu-item-35321\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-35321\"><a href=\"https://kilntheatre.com/our-story/hire/\">Hires</a></li>\n<li id=\"menu-item-23505\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-23505\"><a href=\"https://kilntheatre.com/kiln-card/\">Kiln Card</a></li>\n</ul>            \n                            <ul id=\"menu-main-menu-secondary-nav\" class=\"o-nav global-header__nav global-header__nav--secondary\"><li id=\"menu-item-21712\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-21712\"><a href=\"https://kilntheatre.com/your-visit/\">Your Visit</a></li>\n<li id=\"menu-item-14318\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-14318\"><a href=\"https://kilntheatre.com/your-visit/access/\">Access</a></li>\n<li id=\"menu-item-21931\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-21931\"><a href=\"https://kilntheatre.com/how-to-get-here/food-and-drink/\">Food and Drink</a></li>\n<li id=\"menu-item-41535\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-41535\"><a href=\"https://kilntheatre.com/our-story/\">Our story</a></li>\n<li id=\"menu-item-41539\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-41539\"><a href=\"https://kilntheatre.com/our-story/jobs/\">Job Opportunities</a></li>\n</ul>            \n                    </div>\n    </div>\n</header>\n\n    <!--[if lte IE 8]>\n<style>\n    body > * {\n        display: none !important;\n    }\n\n    body .no-support {\n        display: block !important;\n    }\n</style>\n\n<article class=\"no-support\">\n    <h4>Unfortunately the Kiln Theatre website is not accessible via the browser you're currently using.</h4>\n    <p>We recommend <a href=\"http://www.whatbrowser.org/intl/en_uk/\">upgrading your browser</a>.</p>\n</article>\n<![endif]-->\n    <main class=\"global-wrap\">\n<section class=\"c-container--padded c-container--title-bar u-red-bg\">\n    <div class=\"max-width-wrap\">\n        <h3 class=\"c-container-title c-container-title--bar\">Now Showing</h3>\n    </div>\n</section>\n\n<!-- Masthead -->\n<section class=\"masthead pg__masthead pg__masthead--cinema-image c-box-gradient\" style=\"background-image: url('https://assets.kilntheatre.com/wp-content/uploads/2026/05/6.png?resize=1990%2C796&gravity');\">\n    <div class=\"h-row h-row--film\">\n        <h1 class=\"pg__title\">Familiar Touch</h1>\n        <h2>15 Jul&ndash;16 Jul 2026</h2>\n\n                    <ul class=\"h-row__film-info\">\n                                    <li>Directed by Sarah Friedland</li>\n                                    <li>Starring Kathleen Chalfant, Carolyn Michelle, Andy McQueen and H. Jon Benjamin</li>\n                                    <li>90 mins</li>\n                            </ul>\n            </div>\n</section>\n\n<!-- Book and Trailer Buttons -->\n<section class=\"c-container--padded u-white-bg\">\n    <div class=\"max-width-wrap\">\n        <ul class=\"c-cinema-book\">\n                            <li><a data-fresco-group=\"trailer\" data-fresco-caption=\"\" class=\"fresco c-btn c-btn--primary\" href=\"https://www.youtube.com/embed/NY7qpocVWZE\">View Trailer</a></li>\n            \n                            <li>\n                    <a href=\"https://kilntheatre.com/whats-on/familiar-touch/#book\" class=\"c-btn c-btn--primary c-btn--book-film \">\n                        Book Now                    </a>\n                </li>\n                    </ul>\n    </div>\n</section>\n\n<!-- Introduction -->\n    <section class=\"c-container--padded u-white-bg\">\n        <div class=\"max-width-wrap\">\n            <div class=\"c-col-txt\">\n                <p>In this brilliant and moving debut film, Ruth (Kathleen Chalfant) finds herself checked into a residential care facility by her son. She is experiencing dementia, her past life blurring and focusing before her. Like the new kid at school, we see her learn the ropes, as well as re-connect with past joys from her life as a professional chef.</p>\n<p>It is tempting to view dementia patients through the eyes of their loved ones, as they become less estranged to them. But <em>Familiar Touch</em> keeps the focus on Ruth, seeing her beyond her decline and instead on who she is now. Her son, played by H. Jon Benjamin – known primarily for his comic roles including Bob’s Burgers – and the other residents are brilliant foils to her, in a drama that is attentive and thoughtful, one of the year’s best.</p>\n            </div>\n        </section>\n    </section>\n\n<!-- Construkt -->\n\n<!-- Films -->\n    <section class=\"c-container--padded c-container--center-title u-white-bg film-book\" id=\"book\">\n        <div class=\"max-width-wrap\">\n            <div class=\"c-film-bookings c-film-bookings--single\">\n                <h3 class=\"c-container-title c-container-title--bar\">Book Now</h3>\n                                    <div class=\"c-booking-single\">\n                        <ul class=\"c-single-performance\">\n                                                            <li class=\"instance captioned-screening-tbc\">\n                                    <div class=\"c-single-performance__date-wrapper\">\n                                        <div class=\"c-film-booking__date\">\n                                            Wednesday 15th July                                        </div>\n                                    </div>\n                                                                            <div class=\"instance__type\">captioned screening tbc</div>\n                                                                        <a href=\"https://kilntheatre.com/whats-on/familiar-touch/book/877049\" class=\"c-btn c-btn--primary \">\n                                                    6.00PM\n                                                                                                    </a>\n                                </li>\n                                                    </ul>\n                    </div>\n                                    <div class=\"c-booking-single\">\n                        <ul class=\"c-single-performance\">\n                                                            <li class=\"instance \">\n                                    <div class=\"c-single-performance__date-wrapper\">\n                                        <div class=\"c-film-booking__date\">\n                                            Thursday 16th July                                        </div>\n                                    </div>\n                                                                        <a href=\"https://kilntheatre.com/whats-on/familiar-touch/book/874650\" class=\"c-btn c-btn--primary \">\n                                                    8.30PM\n                                                                                                    </a>\n                                </li>\n                                                    </ul>\n                    </div>\n                            </div>\n        </div>\n    </section>\n    </main> <!-- close global-wrap -->\n\n    <section class=\"c-footer__newsletter-form\">\n    <div class=\"o-max o-max--1400\">\n        <div class=\"o-layout o-layout--large\">\n            <div class=\"o-layout__item u-1/1@tablet\" id=\"sign-up-form\">\n                <form accept-charset=\"UTF-8\" id=\"spextrix-signup-form\">\n    <div class=\"c-newsletter-form\">\n        <h4 class=\"c-newsletter-form__title u-margin-bottom-none\">Newsletter Sign Up</h4>\n\n        <div class=\"c-newsletter-form__signup-container\">\n            <div class=\"c-newsletter-form__description\">\n                <p class=\"c-smallprint\">Sign up to receive updates from us.</p>\n                <p class=\"c-smallprint\">Your privacy is important to us. Please <a href=\"https://kilntheatre.com/privacy-policy/\">click here</a> to read our Privacy Policy.</p>\n            </div>\n\n            \n            <div class=\"c-newsletter__signup\">\n\n                <input type=\"hidden\" id=\"_wpnonce\" name=\"_wpnonce\" value=\"18c40b0ea5\" /><input type=\"hidden\" name=\"_wp_http_referer\" value=\"/whats-on/familiar-touch/\" />                <input type=\"input\" name=\"hnp\" style=\"display: none;\">\n\n                <div class=\"c-newsletter-form__fields c-newsletter-form__primary c-newsletter-form__inputs\">\n                    <div class=\"c-newsletter-form__field\" id=\"first_name\">\n                        <input\n                            class=\"form-text\"\n                            name=\"first_name\"\n                            type=\"text\"\n                            placeholder=\"First name\"\n                            value=\"\"\n                            required\n                        >\n                                                                    </div>\n\n                    <div class=\"c-newsletter-form__field\" id=\"last_name\">\n                        <input\n                            class=\"form-text\"\n                            name=\"last_name\"\n                            type=\"text\"\n                            placeholder=\"Last name\"\n                            value=\"\"\n                            required\n                        >\n                                            </div>\n\n                    <div class=\"c-newsletter-form__field\" id=\"email\">\n                        <input\n                            class=\"form-text\"\n                            name=\"email\"\n       