                           var d = new Date();\n                                d.setTime(d.getTime() + (exdays*24*60*60*1000));\n                                var expires = \"expires=\" + d.toUTCString();\n                                document.cookie=\"cookiesAccepted=true; path=/;\" + expires;\n                            },\n\n                            get: function(cname) {\n                                var name = cname + \"=\";\n                                var decodedCookie = decodeURIComponent(document.cookie);\n                                var ca = decodedCookie.split(';');\n                                for(var i = 0; i <ca.length; i++) {\n                                    var c = ca[i];\n                                    while (c.charAt(0) == ' ') {\n                                        c = c.substring(1);\n                                    }\n                                    if (c.indexOf(name) == 0) {\n                                        return c.substring(name.length, c.length);\n                                    }\n                                }\n                                return \"\";\n                            }\n                        };\n\n                        if (!Cookies.get('cookiesAccepted')) {\n                            $('#cookies-warning').show();\n                        }\n\n                        $('#accept-cookies').on('click', function(event) {\n                            event.preventDefault();\n                            Cookies.accept(60);\n                            $(this).parents('#cookies-warning').remove();\n                        });\n                    })();\n                </script></body>\n</html>\n<!--\nPerformance optimized by Redis Object Cache. Learn more: https://wprediscache.com\n\nRetrieved 2553 objects (936 KB) from Redis using Predis (v3.5.0).\n-->\n",
