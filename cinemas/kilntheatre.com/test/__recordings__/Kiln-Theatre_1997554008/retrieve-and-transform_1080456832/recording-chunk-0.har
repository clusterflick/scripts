fadeIn\"></div>\n            <div class=\"global-header__logo global-header__logo--orange-alt\" data-os-animation=\"fadeIn\"></div>\n        </div>\n    </div>\n    <div class=\"global-header__rhs\">\n                <div class=\"global-header__menu-button\">\n            <div class=\"hamburger\">\n                <span></span>\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n            <p class=\"global-header__button-text active\">Menu</p>\n            <p class=\"global-header__button-text\">Close</p>\n        </div>\n        <div class=\"global-header__navigation\">\n                            <ul id=\"menu-main-menu-primary-navigation\" class=\"o-nav global-header__nav global-header__nav--primary\"><li id=\"menu-item-21228\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-21228\"><a href=\"https://kilntheatre.com/whats-on/\">What’s On</a></li>\n<li id=\"menu-item-23586\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-23586\"><a href=\"https://kilntheatre.com/cinema-listings/\">Cinema Listings</a></li>\n<li id=\"menu-item-608\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-608\"><a href=\"https://kilntheatre.com/give/\">Give</a></li>\n<li id=\"menu-item-1946\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-1946\"><a href=\"https://kilntheatre.com/creative-engagement/\">Creative Engagement</a></li>\n<li id=\"menu-item-35321\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-35321\"><a href=\"https://kilntheatre.com/our-story/hire/\">Hires</a></li>\n<li id=\"menu-item-23505\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-23505\"><a href=\"https://kilntheatre.com/kiln-card/\">Kiln Card</a></li>\n</ul>            \n                            <ul id=\"menu-main-menu-secondary-nav\" class=\"o-nav global-header__nav global-header__nav--secondary\"><li id=\"menu-item-21712\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-21712\"><a href=\"https://kilntheatre.com/your-visit/\">Your Visit</a></li>\n<li id=\"menu-item-14318\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-14318\"><a href=\"https://kilntheatre.com/your-visit/access/\">Access</a></li>\n<li id=\"menu-item-21931\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-21931\"><a href=\"https://kilntheatre.com/how-to-get-here/food-and-drink/\">Food and Drink</a></li>\n<li id=\"menu-item-41535\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-41535\"><a href=\"https://kilntheatre.com/our-story/\">Our story</a></li>\n<li id=\"menu-item-41539\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-41539\"><a href=\"https://kilntheatre.com/our-story/jobs/\">Job Opportunities</a></li>\n</ul>            \n                    </div>\n    </div>\n</header>\n\n    <!--[if lte IE 8]>\n<style>\n    body > * {\n        display: none !important;\n    }\n\n    body .no-support {\n        display: block !important;\n    }\n</style>\n\n<article class=\"no-support\">\n    <h4>Unfortunately the Kiln Theatre website is not accessible via the browser you're currently using.</h4>\n    <p>We recommend <a href=\"http://www.whatbrowser.org/intl/en_uk/\">upgrading your browser</a>.</p>\n</article>\n<![endif]-->\n    <main class=\"global-wrap\">\n<section class=\"c-container--padded c-container--title-bar u-red-bg\">\n    <div class=\"max-width-wrap\">\n        <h3 class=\"c-container-title c-container-title--bar\">Now Showing</h3>\n    </div>\n</section>\n\n<!-- Masthead -->\n<section class=\"masthead pg__masthead pg__masthead--cinema-image c-box-gradient\" style=\"background-image: url('https://assets.kilntheatre.com/wp-content/uploads/2026/05/10.png?resize=1990%2C796&gravity');\">\n    <div class=\"h-row h-row--film\">\n        <h1 class=\"pg__title\">The Odyssey</h1>\n        <h2>17 Jul&ndash;30 Jul 2026</h2>\n\n                    <ul class=\"h-row__film-info\">\n                                    <li>Directed by Christopher Nolan</li>\n                                    <li>Starring Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson, Lupita Nyong’o, Charlize Theron and Zendaya</li>\n                                    <li>172 mins</li>\n                            </ul>\n            </div>\n</section>\n\n<!-- Book and Trailer Buttons -->\n<section class=\"c-container--padded u-white-bg\">\n    <div class=\"max-width-wrap\">\n        <ul class=\"c-cinema-book\">\n                            <li><a data-fresco-group=\"trailer\" data-fresco-caption=\"\" class=\"fresco c-btn c-btn--primary\" href=\"https://www.youtube.com/embed/Sk6LZrA2JSQ?start=2&feature=oembed\">View Trailer</a></li>\n            \n                            <li>\n                    <a href=\"https://kilntheatre.com/whats-on/the-odyssey/#book\" class=\"c-btn c-btn--primary c-btn--book-film \">\n                        Book Now                    </a>\n                </li>\n                    </ul>\n    </div>\n</section>\n\n<!-- Introduction -->\n    <section class=\"c-container--padded u-white-bg\">\n        <div class=\"max-width-wrap\">\n            <div class=\"c-col-txt\">\n                <p>Cinema is full of ‘epics’ but few stories can lay as fair claim to the title as Homer’s original tale of return from the Trojan War. There are few directors who one would entrust such lofty material with, but Christopher Nolan is one of those number. Matt Damon is Odysseus, the Greek leader trying to reconcile with his love Penelope (Anne Hathaway). They are joined by a wildly stellar ensemble cast featuring Lupita Nyong’o, Tom Holland, Robert Pattinson, Zendaya, Charlize Theron among many others.</p>\n<p>Christopher Nolan continues his steer away from the fantastical of his earlier career (<em>The Dark Knight, Interstellar</em>) and towards the historical path of <em>Dunkirk </em>and<em> Oppenheimer</em>. Whatever his subject, there is always a narrative rigour and commitment to visual elegance, as well as jaw-dropping set pieces. The first film shot exclusively with IMAX cameras, this is going to be a stunning chance to see one of the enduring human stories in grand style.</p>\n            </div>\n        </section>\n    </section>\n\n<!-- Construkt -->\n\n<!-- Films -->\n    <section class=\"c-container--padded c-container--center-title u-white-bg film-book\" id=\"book\">\n        <div class=\"max-width-wrap\">\n            <div class=\"c-film-bookings c-film-bookings--single\">\n                <h3 class=\"c-container-title c-container-title--bar\">Book Now</h3>\n                                    <div class=\"c-booking-single\">\n                        <ul class=\"c-single-performance\">\n                                                            <li class=\"instance \">\n                                    <div class=\"c-single-performance__date-wrapper\">\n                                        <div class=\"c-film-booking__date\">\n                                            Friday 17th July                                        </div>\n                                    </div>\n                                                                        <a href=\"https://kilntheatre.com/whats-on/the-odyssey/book/879049\" class=\"c-btn c-btn--primary \">\n                                                    4.00PM\n                                                                                                    </a>\n                                </li>\n                                                            <li class=\"instance \">\n                                    <div class=\"c-single-performance__date-wrapper\">\n                                        <div class=\"c-film-booking__date\">\n                                            Friday 17th July                      