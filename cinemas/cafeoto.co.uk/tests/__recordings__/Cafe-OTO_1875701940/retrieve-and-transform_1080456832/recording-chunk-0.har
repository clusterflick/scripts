lay: none !important;\n        }\n    </style>\n\n<span id=\"event_page\" style=\"display: none;\"></span>\n<div class=\"content-container efg-london-jazz-festival-robyns-rocket\"> <!-- Always required do to fixed header -->\n\t<div class=\"activity-container\">\n\t\t<div class=\"container-fluid\">\n\t\t\t<div class=\"row\">\n\t\t\t    <div class=\"col-xs-12 col-sm-8\">\n\t\t            \n\t\t            <div class=\"event-detail-date\">\n\t\t\t\t\t\t<p>Tuesday 17 November 2026, 7.30pm</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t<div class=\"col-xs-12\">\n\t\t\t\t\t\t\t\t<div class=\"event-detail-slider\">\n\t\t\t\t\t\t\t\t\t<div class=\"each-slide\">\n\t\t\t\t\t\t\t\t\t\t<img src=\"https://media.cafeoto.co.uk/_versions/images/streamingthumnbnail17.11.26_main.jpg?ts=1790001105\" />\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"col-xs-12 col-sm-8\">\n\t\t\t\t\t<div class=\"event-detail-title\">\n\t\t\t\t\t\t<h1><span class=\"prefix\">EFG London Jazz Festival:</span> Robyn&#x27;s Rocket – w/ Laura Jurd &amp; Robyn Rocket + Little Kali + ATMoss<span class=\"suffix\">+ Live Visuals by Rucksack cinema and Jade</span></h1>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\n\t\n\t\t<div class=\"container-fluid\">\n\t\t\t<div class=\"row\">\n\t\t\t\t<div class=\"col-sm-12\">\n\t\t\t\t\t<div class=\"event-detail-meta\">\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t<div id=\"event_7125\" class=\"advance_price\">\n<style>\n    .event-detail-meta span a,\n    .each-price.each-meta span a {\n        padding: 5px 6px 2px 4px;\n    }\n\n    .event-detail-meta .stream .active,\n    .each-price.each-meta .stream .active {\n        background: black;\n        color: white !important;\n    }\n\n    .event-detail-meta .stream a.active:hover,\n    .each-price.each-meta .stream a.active:hover {\n        background: #ccc;\n        color: black !important;\n    }\n</style>\n\n    \n        \n            \n                \n                    \n                        \n                            <span>&pound;15</span>\n                        \n                    \n                \n                    \n                        \n                            <span class=\"external\">\n                                <a class=\"active\" href=\"https://wegottickets.com/f/25901\" target=\"_blank\">\n                                    &pound;12 (Wegottickets)\n                                </a>\n                            </span>\n                        \n                    \n                \n                    \n                        \n                            \n                                \n                                    <span><a href=\"/membership/\"><span>&pound;8 MEMBERS</span></a></span>\n                                \n                            \n                        \n                    \n                \n            \n        \n    \n\n    <!-- Live Stream prices -->\n    \n\n\n</div>\n\t\t\t\t\t\t\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t</div>\n\t\n\n\n\n<div class=\"container-fluid\">\n\t<div class=\"row\">\n\t\t<div class=\"col-sm-5 col-sm-offset-rt-1\">\n\t\t\t<div class=\"event-detail-text-container\">\n\t\t\t    <div class=\"event-detail-intro-container\">\n\t\t\t        <p>Robyn's Rocket with Laura Jurd, Little Kali and ATMoss with live visuals by Rucksack Cinema and Jade.</p>\r\n<p>Robyn&rsquo;s Rocket is a homemade spaceship that brings people together and presents a wide range of experimental/left-field music. Robyn&rsquo;s Rocket believes in being Inclusive Conscious. That means:</p>\r\n<p>1 Seeing who&rsquo;s not in the space<br />2 Inviting them in<br />3 Asking for feedback<br />4 Acting on the feedback where possible.</p>\r\n<p>Timetable:<br />7:30pm Doors open<br />8pm ATMoss<br />9pm Little Kali<br />10pm Laura Jurd and Robyn Rocket<br />10:50pm Gig finishes</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"col-sm-5 col-sm-offset-rt-1\">\n\t\t\t<div class=\"event-detail-text-container\">\n\t\t\t    <div class=\"event-detail-intro-container\">\n\t\t\t        <p><strong>STREAM LIVE ON THE NIGHT HERE:</strong></p>\r\n<p><iframe title=\"YouTube video player\" src=\"https://www.youtube.com/embed/TY14TNAUR7s?si=1ITYXpC85Z9BviBq\" frameborder=\"0\" width=\"100%\" height=\"240\"></iframe></p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n\n\n\n\t\n\n\n\n\n\n\t\n\n<div class=\"container-fluid\">\n    <div class=\"activity-container\">\n        <div class=\"row\">\n            <div class=\"col-sm-12\">\n                <h1 class=\"section-title\">You may also like</h1>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"activity-container-inner\">\n                \n                \n                    <div class=\"each-activity event-detail-each-artist col-xs-6 col-sm-3\">\n                        \n                            \n                                \n                                    <h2 class=\"sub-title\"><a href=\"/shop/hamid-drake-pat-thomas-a-mountain-sees-a-mountain/\">Vinyl</a></h2>\n                                \n                                <div class=\"event-detail-image\">\n                                    <a href=\"/shop/hamid-drake-pat-thomas-a-mountain-sees-a-mountain/\"><img src=\"https://media.cafeoto.co.uk/_versions/images/hamidpat_grayscale.jpg?ts=1765277044\" /></a>\n                                </div>\n                            \n                        \n                        <h2 class=\"sub-title\"><a href=\"/shop/hamid-drake-pat-thomas-a-mountain-sees-a-mountain/\">A Mountain Sees a Mountain</a></h2>\n                        \n                            \n                                \n                                    <div class=\"event-detail-meta\">\n          