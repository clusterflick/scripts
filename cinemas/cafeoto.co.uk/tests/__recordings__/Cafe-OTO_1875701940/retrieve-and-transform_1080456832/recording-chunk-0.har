"content-container company-2026-for-derek-bailey\"> <!-- Always required do to fixed header -->\n\t<div class=\"activity-container\">\n\t\t<div class=\"container-fluid\">\n\t\t\t<div class=\"row\">\n\t\t\t    <div class=\"col-xs-12 col-sm-8\">\n\t\t            \n\t\t            <div class=\"event-detail-date\">\n\t\t\t\t\t\t<p>13–14 December 2026</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t<div class=\"col-xs-12\">\n\t\t\t\t\t\t\t\t<div class=\"event-detail-slider\">\n\t\t\t\t\t\t\t\t\t<div class=\"each-slide\">\n\t\t\t\t\t\t\t\t\t\t<img src=\"https://media.cafeoto.co.uk/_versions/images/company2026_banner_v10_colour_2000_main.png?ts=1788185555\" />\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"col-xs-12 col-sm-8\">\n\t\t\t\t\t<div class=\"event-detail-title\">\n\t\t\t\t\t\t<h1>COMPANY 2026 (for Derek Bailey)<span class=\"suffix\">Lash / Gal / Davies / Hawkins / Keeffe / Niblock / Rezaei / Hao / Butcher / Wastell</span></h1>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\n\t\n\t\t<div class=\"activity-container\">\n\t\t\t<div class=\"container-fluid\">\n\t\t\t\t<div class=\"row\">\n\t\t\t\t\t<div class=\"activity-container-inner\">\n\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"each-activity col-sm-12\" style=\"margin-top:20px; margin-bottom: 35px;\">\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div class=\"each-header\">\n\t\t\t\t\t\t\t\t\t<span>BUY SERIES PASS FOR  BOTH  EVENTS</span>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"event-detail-meta\">\n\t\t\t\t\t\t\t\t\t\n<style>\n    .event-detail-meta span a,\n    .each-price.each-meta span a {\n        padding: 5px 6px 2px 4px;\n    }\n\n    .event-detail-meta .stream .active,\n    .each-price.each-meta .stream .active {\n        background: black;\n        color: white !important;\n    }\n\n    .event-detail-meta .stream a.active:hover,\n    .each-price.each-meta .stream a.active:hover {\n        background: #ccc;\n        color: black !important;\n    }\n</style>\n\n    \n        \n            \n                \n                    \n                        \n                            \n                                <span>\n                                    <a class=\"active\" href=\"#\" onclick=\"javascript: appendToCart({pk:'15816', type: 'event',}, this); return false;\">\n                                        &pound;30 Advance\n                                    </a>\n                                </span>\n                            \n                        \n                    \n                \n                    \n                        \n                            \n                                \n                                    <span><a href=\"/membership/\"><span>&pound;20 MEMBERS</span></a></span>\n                                \n                            \n                        \n                    \n                \n            \n        \n    \n\n    <!-- Live Stream prices -->\n    \n\n\n\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"each-activity col-xs-12 col-sm-4 col-sm-offset-rt-1\">\n\t\t\t\t\t\t\t<div class=\"each-header\">\n\t\t\t\t\t\t\t\t<p><a href=\"/events/company-2026-for-derek-bailey-1/\">Sunday 13 December 2026, 7.30pm</a><br/><a href=\"/events/company-2026-for-derek-bailey-1/\">Company 2026 (For Derek Bailey) – Day One</a></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"event-detail-meta\">\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t<div id=\"event_7102\" class=\"advance_price\">\n<style>\n    .event-detail-meta span a,\n    .each-price.each-meta span a {\n        padding: 5px 6px 2px 4px;\n    }\n\n    .event-detail-meta .stream .active,\n    .each-price.each-meta .stream .active {\n        background: black;\n        color: white !important;\n    }\n\n    .event-detail-meta .stream a.active:hover,\n    .each-price.each-meta .stream a.active:hover {\n        background: #ccc;\n        color: black !important;\n    }\n</style>\n\n    \n        \n            \n                \n                    \n                        \n                            <span>&pound;20</span>\n                        \n                    \n                \n                    \n                        \n                            \n                                <span>\n                                    <a class=\"active\" href=\"#\" onclick=\"javascript: appendToCart({pk:'15819', type: 'event',}, this); return false;\">\n                                        &pound;18 Advance\n                                    </a>\n                                </span>\n                            \n                        \n                    \n                \n                    \n                        \n                            \n                                \n                                    <span><a href=\"/membership/\"><span>&pound;12 MEMBERS</span></a></span>\n                                \n                            \n                        \n                    \n                \n            \n        \n    \n\n    <!-- Live Stream prices -->\n    \n\n\n</div>\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"each-activity col-xs-12 col-sm-4 col-sm-offset-rt-1\">\n\t\t\t\t\t\t\t<div class=\"each-header\">\n\t\t\t\t\t\t\t\t<p><a href=\"/events/company-2026-for-derek-bailey-2/\">Monday 14 December 2026, 7.30pm</a><br/><a href=\"/events/company-2026-for-derek-bailey-2/\">Company 2026 (For Derek Bailey) – Day Two</a></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"event-detail-meta\">\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t<div id=\"event_7103\" class=\"advance_price\">\n<style>\n    .event-detail-meta span a,\n    .each-price.each-meta span a {\n        padding: 5px 6px 2px 4px;\n    }\n\n    .event-detail-meta .stream .active,\n    .each-price.each-meta .stream .active {\n        background: black;\n        color: white !important;\n    }\n\n    .event-detail-meta .stream a.active:hover,\n    .each-price.each-meta .stream a.active:hover {\n        background: #ccc;\n        color: black !important;\n    }\n</style>\n\n    \n        \n            \n                \n                    \n                        \n                            <span>&pound;20</span>\n                        \n                    \n                \n                    \n                        \n                            \n                                <span>\n                                    <a class=\"active\" href=\"#\" onclick=\"javascript: appendToCart({pk:'15822', type: 'event',}, this); return false;\">\n                                        &pound;18 Advance\n                                    </a>\n                                </span>\n                            \n                        \n                    \n                \n                    \n                        \n                            \n                                \n                                    <span><a href=\"/membership/\"><span>&pound;12 MEMBERS</span></a></span>\n                                \n                            \n                        \n                    \n                \n            \n        \n    \n\n    <!-- Live Stream prices -->\n    \n\n\n</div>\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\n\n\n\n<div class=\"container-fluid\">\n\t<div class=\"row\">\n\t\t<div class=\"col-sm-5 col-sm-offset-rt-1\">\n\t\t\t<div class=\"event-detail-text-container\">\n\t\t\t    <div class=\"event-detail-intro-container\">\n\t\t\t        <p>Last December, COMPANY - Derek Bailey&rsquo;s longstanding and influential initiative for group improvisation - was officially reactivated at Cafe OTO. There was such a positive response, we decided to do it again.</p>\r\n<p>Derek formed COMPANY in 1976. The premise was an effectively simple one; invite a group of musicians to improvise together, in various ad-hoc formations, with as little pre-planning as possible.</p>\r\n<p>COMPANY 2026 (for Derek Bailey) curated by John Butcher, Tim Fletcher, Ian Greaves and Mark Wastell in association with Derek Bailey estate and Derek Bailey Archive, Huddersfield University.</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"col-sm-5 col-sm-offset-rt-1\">\n\t\t\t<div class=\"event-detail-text-container\">\n\t\t\t    <div class=\"event-detail-intro-container\">\n\t\t\t        <p><strong>COMPANY 2026 features;</strong><br /> <br />Dominic Lash (electric guitar)<br />Sharon Gal (voice)<br />Angharad Davies (violin)<br />Alexander Hawkins (piano)<br />Charlotte Keeffe (trumpet)<br />Alan Niblock (double bass)<br />Mariam Rezaei (turntables)<br />Zheng Hao (electronics)<br />John Butcher (saxophones)<br />Mark Wastell (percussion)</p>\r\n<p>Comp&egrave;red by Stewart Lee</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n\n\n\n\t\n\t<div class=\"container-fluid\">\n\t\t<div class=\"row\">\n\t\t\t<div class=\"event-detail-each-artist-container\">\n\t\t\t\t\n\t\t\t\t<div class=\"event-detail-each-artist col-xs-12 col-sm-5 col-sm-offset-rt-1\">\n\t\t\t\t\t<h1><a href=\"/artists/dominic-lash/\">Dominic Lash</a></h1>\n\t\t\t\t\t<p>Dominic Lash concentrates on the double bass and electric guitar. He works regularly with musicians including John Butcher, Angharad Davies, Emil Karlsen, Mark Sanders, Pat Thomas, and Alex Ward. He has lived and worked in Oxford, New York and Bristol, and is currently based in Cambridge where he and N.O. Moore curate the monthly improvised music series Soundhunt. He also runs the label Spoonhunt.<br /><a href=\"http://dominiclash.blogspot.co.uk/\" target=\"_blank\">http://dominiclash.blogspot.co.uk/</a></p>\r\n<p><iframe title=\"YouTube video player\" src=\"https://www.youtube.com/embed/i1BR_FZDNs8?si=Adc_H9P60fInkRNL\" frameborder=\"0\" width=\"100%\" height=\"240\"></iframe></p>\n\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div class=\"event-detail-each-artist-image\">\n\t\t\t\t\t\t\t\t\t<img src=\"https://media.cafeoto.co.uk/_versions/images/DominicLash_main.jpg?ts=1686054327\" />\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t<div class=\"event-detail-each-artist col-xs-12 col-sm-5 col-sm-offset-rt-1\">\n\t\t\t\t\t<h1><a href=\"/artists/sharon-gal/\">Sharon Gal</a></h1>\n\t\t\t\t\t<p>Sharon Gal is an interdisciplinary artist, performer, vocalist and composer, specialising in free improvisation, experimental music and collaborative, participatory large group compositions. She works with voice, electronics, extended techniques, field recordings, found audio, video and collage; exploring presence, listening, embodiment, and the relationship between people, sound and space. Sharon performs solo and in collaborations with: David Toop, John Butcher, John Edwards, Sue Lynch, Andie Brown, Yoni Silver, Steve Beresford, Phil Minton, Charles Hayward, Anat Ben David and Lina Lapelyte.</p>\r\n<p>Since 2007 she has directed a series of site specific, large group compositions, inviting musicians and non-musicians to take part. She curated music concerts, including the series Sound Matter, at Caf&eacute; OTO, and concerts at Iklectik arts lab. Her music was released by many labels, including five solo albums and various collaborations.</p>\r\n<p>Past performances include The V&amp;A, ICA, The Whitechapel Gallery, Tate Modern &amp; Tate Britain, MACBA, and Colour Out Of Space, Borealis, Supernormal, Supersonic, TUSK and Tectonics festivals.</p>\r\n<p>Etudes by Sharon Gal, a collection of text &amp; colour scores, presented as a deck of 78 cards, was supported by Sound and Music and published in 2021. Her project, Healing Choir, ran @ the Kilburn Tin Tabernacle between August-October 2024.</p>\r\n<p><a href=\"https://www.sharon-gal.com/\" target=\"_blank\">https://www.sharon-gal.com/<br /></a><a href=\"https://sharongal.bandcamp.com\" target=\"_blank\">https://sharongal.bandcamp.com</a></p>\r\n<p><iframe title=\"YouTube video player\" src=\"https://www.youtube.com/embed/SxG3wB5CyOo\" frameborder=\"0\" width=\"100%\" height=\"240\"></iframe></p>\n\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div class=\"event-detail-each-artist-image\">\n\t\t\t\t\t\t\t\t\t<img src=\"https://media.cafeoto.co.uk/_versions/images/Sharon_Gal_Sound_Matter__2_main.jpg?ts=1689149590\" />\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t<div class=\"event-detail-each-artist col-xs-12 col-sm-5 col-sm-offset-rt-1\">\n\t\t\t\t\t<h1><a href=\"/artists/angharad-davies/\">Angharad Davies</a></h1>\n\t\t\t\t\t<p>Angharad Davies is a Welsh violinist based in London working with free-improvisation, compositions and performance. Her approach to sound involves attentive listening and exploring beyond the sonic confines of her instrument, her classical training and performance expectation.<br /><a href=\"https://angharaddavies.com/\" target=\"_blank\">angharaddavies.com</a></p>\n\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div class=\"event-detail-each-artist-image\">\n\t\t\t\t\t\t\t\t\t<img src=\"https://media.cafeoto.co.uk/_versions/images/Llais--Simon-Ayre-lr_main.jpg?ts=1777650633\" />\n\t\t\t\t\t\t\t\t\t<div class=\"caption\">Photo by Simon Ayre</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t<div class=\"event-detail-each-artist col-xs-12 col-sm-5 col-sm-offset-rt-1\">\n\t\t\t\t\t<h1><a href=\"/artists/alexander-hawkins/\">Alexander Hawkins</a></h1>\n\t\t\t\t\t<p>Alexander Hawkins&rsquo; work ranges from his acclaimed solo performances (&lsquo;intensely intricate&hellip;powerful, technically brilliant and melodically inventive&rsquo;) through to works on a much larger canvas, such as his Togetherness Music ('[a] masterpiece that can stand next to the best works of Mitchell, Braxton or Parker&rsquo;). He collaborates regularly with all generations of creative musicians, including the likes of Anthony Braxton, Marshall Allen, Evan Parker, John Surman, Joe McPhee, Hamid Drake, Nicole Mitchell, Tomeka Reid, Sofia Jernberg, Shabaka Hutchings, and many others. Further creative associations, with two very different icons of African music, Louis Moholo-Moholo and Mulatu Astatke, stretch back for well over a decade. He has been widely commissioned as a composer, including by the likes of the BBC, Berlin&rsquo;s Pierre Boulez Saal, and numerous festivals. His performance schedule takes him to club, concert hall, and festival stages worldwide.</p>\r\n<p><em>\"Sounds like all the future jazz you might imagine without ever being able to conceive of the details\"</em> &ndash; The Guardian</p>\n\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t<div class=\"event-detail-each-artist col-xs-12 col-sm-5 col-sm-offset-rt-1\">\n\t\t\t\t\t<h1><a href=\"/artists/charlotte-keeffe/\">Charlotte Keeffe</a></h1>\n\t\t\t\t\t<p>Keeffe&rsquo;s debut album &lsquo;Right Here, Right Now&rsquo; is where you&rsquo;ll find her exhibiting a passion for vibrant soundscapes rendered in live spaces. Released in 2021, also on Discus Music, she earned critical acclaim carving out a niche on the imprint. She also composes and performs for a number of the roster&rsquo;s artists, including; Hi Res Heart, Carla Diratz and Julie Tippetts. She also co-leads Anthropology Band with the head of Discus Music, Martin Archer.</p>\r\n<p>To date, her music has been featured significantly on BBC Radio 3, Jazz FM and BBC Radio 6, where she's been described as a 'prolific', 'dynamic' and 'excellent improviser!', by the likes of Corey Mwamba, Stuart Maconie and Jez Nelson. Keeffe is a Serious Artist and part of Serious&rsquo; Take Five 2022 cohort. She performed a duet with the mighty City of London as part of world-renowned trumpeter Dave Douglas' Festival of New Trumpet Music 2022.</p>\r\n<p>Harnessing the power of art for social change is a crucial part of Keeffe&rsquo;s musical identity: she has served as Assistant Musical Director of the London Gay Big Band, champions gender and diversity equality, as part of the Parliamentary award-winning Women in Jazz Media team, and played in Marin Alsop's Taki Concordia Orchestra at the World Economic Forum 2019, in front of world leaders and celebrities including Sir David Attenborough.</p>\r\n<p>From stepping on Glastonbury and Wilderness stages alongside Charlotte Church, Laura Mvula and Kate Nash, to broadcasting to an international audience live from her bathroom during the pandemic, Keeffe understands that embracing individuality and letting go of inhibitions is the surest way to grasp the transformative power of music.</p>\r\n<p><em>&ldquo;Keeffe shows notable strength of character as she runs the sonic and emotional gamut...\"</em> - Kevin Le Gendre, JAZZWISE</p>\r\n<p><a href=\"https://www.charlottekeeffe.com\" target=\"_blank\">https://www.charlottekeeffe.com</a></p>\r\n<p><iframe title=\"YouTube video player\" src=\"https://www.youtube.com/embed/AtyMOcsh1zo?si=4rmuScuXaMgg3fIh\" frameborder=\"0\" width=\"100%\" height=\"240\"></iframe></p>\n\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t<div class=\"event-detail-each-artist col-xs-12 col-sm-5 col-sm-offset-rt-1\">\n\t\t\t\t\t<h1><a href=\"/artists/mariam-rezaei/\">Mariam Rezaei </a></h1>\n\t\t\t\t\t<p>Mariam Rezaei (she/her) is a multi-award-winning composer, turntablist and performer whose work spans experimental new music, free improvisation, noise, mutant club music and hip-hop. The Anglo-Iranian virtuoso expands on classic turntablist skills by developing new techniques with vinyl, allowing her to manipulate an expansive range of samples in real time. Rezaei&rsquo;s approach has been recognised by <em>The Wire</em>&rsquo;s Peter Margasak as a &ldquo;radical expansion of the artform.&rdquo; Her innovations include <em>free juggling, turntable sines, needle dripping, fractured loops</em> and<em> needle weaving</em>. Across solo, duo, ensemble, orchestral and operatic works, Rezaei takes the philosophy and aesthetics of turntablism into new territory, creating wildly inventive, energetic and beautiful music.</p>\r\n<p>Following on from the highly acclaimed <em>Fractured</em> (2024) and her ground-breaking <em>Blud/Skeen/Bown</em> trilogy (2019-2023), Rezaei will release Selected Adequate Works in early 2027. A major step forward in live turntablist composition, the double album captures the breadth of Rezaei&rsquo;s vision from warped techno and mangled noise, to shimmering psychedelia and refracted chorales. Each track is recorded live in a single take, with Rezaei transforming her own samples alongside contributions from Elvin Brandhi, Kobe Van Cauwenberghe, Julien Desprez, Lukas Koenig, Eleni Poulou, Lucy Railton and Stewart Smith.</p>\r\n<p>Her major commissions include <em>Scholar&rsquo;s Record</em> for Donaueschinger Musiktage 2025, a four turntable tour-de-force which drew on the legendary festival&rsquo;s audio archives, and <em>6 Scenes for Turntable and Orchestra</em>, an orchestral collaboration with Matthew Shlomowitz for IMD Darmstadt/Tectonics Glasgow. This autumn, she premieres new projects with Ensemble Intercontemporain and Huddersfield Contemporary Music Festival.</p>\r\n<p>In addition to her solo work, Rezaei is a member of the international free music supergroup The Sleep of Reason Produces Monsters, the pioneering Turntable Trio with Evicshen and Maria Ch&aacute;vez, 1984 with Kobe Van Cauwenberghe and Sakina Abdou, and Fire! Orchestra. Other collaborators include Pat Thomas, Bill Orcutt, Jennifer Walshe, Edward George, Farida Amadou, Mats Gustafsson, Valentina Magaletti, Robyn Rocket, Thurston Moore, Lasse Marhaug, Ensemble Contrechamps, Fritz Welch, Raymond MacDonald, Lukas K&ouml;nig, Okkyung Lee, Dali de St Paul and Ali Robertson.</p>\r\n<p>In November 2022, Rezaei received the Paul Hamlyn Foundation #AwardsForArtists in recognition of her contribution to music composition. She previously led experimental arts projects TOPH, TUSK FRINGE and TUSK NORTH. She is currently based in Newcastle, United Kingdom.</p>\r\n<p><iframe style=\"border: 0; width: 100%; height: 120px;\" src=\"https://bandcamp.com/EmbeddedPlayer/album=1942601255/size=large/bgcol=ffffff/linkcol=0687f5/tracklist=false/artwork=small/transparent=true/\" width=\"320\" height=\"240\"></iframe></p>\n\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div class=\"event-detail-each-artist-image\">\n\t\t\t\t\t\t\t\t\t<img src=\"https://media.cafeoto.co.uk/_versions/images/Mariam_Rezaei_by_Peter_Gannushkin-02_main.jpg?ts=1781596862\" />\n\t\t\t\t\t\t\t\t\t<div class=\"caption\">Photo by Peter Gannushkin</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t<div class=\"event-detail-each-artist col-xs-12 col-sm-5 col-sm-offset-rt-1\">\n\t\t\t\t\t<h1><a href=\"/artists/zheng-hao/\">Zheng Hao</a></h1>\n\t\t\t\t\t<p>Born in Wuhan; based in London. Mostly uses electronics or electro-acoustic instruments for solo and group improvisation, while other times also makes unpleasant computer dance music. Enjoys gritty and gnarly textures as well as delicate, amorphous qualities in different sound and space.</p>\r\n<p><a href=\"https://atunnel.net/\" target=\"_blank\">https://atunnel.net/</a><br /><a href=\"https://zhenghao.bandcamp.com/\" target=\"_blank\">https://zhenghao.bandcamp.com/</a></p>\r\n<p><iframe style=\"border: 0; width: 100%; height: 120px;\" src=\"https://bandcamp.com/EmbeddedPlayer/album=260097925/size=large/bgcol=ffffff/linkcol=0687f5/tracklist=false/artwork=small/transparent=true/\" width=\"320\" height=\"240\"></iframe></p>\n\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div class=\"event-detail-each-artist-image\">\n\t\t\t\t\t\t\t\t\t<img src=\"https://media.cafeoto.co.uk/_versions/images/ZhengHao_main.jpeg?ts=1664791361\" />\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t<div class=\"event-detail-each-artist col-xs-12 col-sm-5 col-sm-offset-rt-1\">\n\t\t\t\t\t<h1><a href=\"/artists/john-butcher/\">John Butcher</a></h1>\n\t\t\t\t\t<p>Born in Brighton and living in London, John Butcher is a saxophonist whose work ranges through improvisation, his own compositions, multi tracked pieces and explorations with feedback, unusual acoustics and non-concert locations. He is well known as a solo performer who attempts to engage with a sense of place. Resonant Spaces, for example, is a collection of performances recorded during a tour of unusual locations in Scotland and the Orkney Islands.</p>\r\n<p>Butcher originally studied Physics, but after publishing a PH.D (1982) on quantum chromodynamics he left academia and took off with music. He has since collaborated with hundreds of artists, some for many decades, including Derek Bailey, Eddie Pr&eacute;vost, Angharad Davies, John Stevens&rsquo; Spontaneous Music Ensemble, Okkyung Lee, Andy Moor, Sophie Agnel, Christian Marclay, Pat Thomas, Phil Minton, Rhodri Davies, Tony Buck, Magda Mayas, John Russell, Chris Corsano, Steve Beresford, St&aring;le Liavik Solberg, and Matthew Shipp.</p>\r\n<p>Additionally he values occasional encounters - with large groups ranging from the WDR Sinfonieorchester (as soloist), and the 20+ piece EX Orkest to duos with Akio Suzuki, Liz Allbee, Keiji Haino, Isabelle Duthois, David Toop, Mariam Rezaei, Fred Frith and Joe McPhee.</p>\r\n<p>Recent compositions include &ldquo;Fluid Fixations&rdquo; (an hcmf commission), &ldquo;Penny Wands&rdquo; for Futurist Intonarumori, &ldquo;Good Liquor&hellip;&rdquo; for the London Sinfonietta and &ldquo;Tarab Cuts&rdquo; (shortlisted for a British Composer&rsquo;s Award).</p>\r\n<p>\"Over 40 years of sustained performance and publishing, English saxophonist, improvisor and composer John Butcher has shaped much of what soprano and tenor saxophone can do, and what their roles and vocabulary in improvised music might be. I&rsquo;ve always heard Butcher&rsquo;s playing as a kind of nose-to-tail saxophony, where the whole instrument from reed-tip to brim of bell is available, accessible and articulate. Few other saxophonists slice as sharply back into the physical history, material (and physics) of the instrument, across its near 200 year history. When Hector Berlioz wrote of his friend Adolphe Sax&rsquo;s then fresh invention, &ldquo;the varied beauty of its accent, sometimes serious, sometimes calm, sometimes impassioned, dreamy or melancholic, or vague&rdquo;, he could have been imagining Butcher's distinctively clean but complex, enquiring soundworld.\" WIRE - October 2024. The Primer by Seymour Wright</p>\r\n<p><a href=\"http://www.johnbutcher.org.uk\" target=\"_blank\">http://www.johnbutcher.org.uk</a></p>\r\n<p><iframe title=\"YouTube video player\" src=\"https://www.youtube.com/embed/Ym4QYCOmSFY?si=Y5XN7TY4oLxyxczQ\" frameborder=\"0\" width=\"100%\" height=\"240\"></iframe></p>\n\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t<div class=\"event-detail-each-artist col-xs-12 col-sm-5 col-sm-offset-rt-1\">\n\t\t\t\t\t<h1><a href=\"/artists/mark-wastell/\">Mark Wastell</a></h1>\n\t\t\t\t\t<p>Mark Wastell is a versatile improvising musician who has played a central role in the British improvised music scene for thirty years. He has performed and recorded extensively and his varied resume includes projects with Derek Bailey, Phil Durrant, John Butcher, Lasse Marhaug, Rhodri Davies, Simon H. Fell, Burkhard Beins, John Tilbury, Mattin, Tony Conrad, Evan Parker, Tim Barnes, Bernhard G&uuml;nter, Keith Rowe, John Zorn, Peter Kowald, Joachim Nordwall, Otomo Yoshihide, David Toop, Max Eastley, Hugh Davies, Julie Tippetts, Alan Skidmore, Mike Cooper, Chris Abrahams, Stewart Lee, Clive Bell, Arild Andersen, Jan Bang, Erik Honor&eacute;, Maggie Nicols, Will Gaines, Charlotte Keeffe, Thomas Lehn, Thurston Moore and David Sylvian.</p>\r\n<p><iframe title=\"YouTube video player\" src=\"https://www.youtube.com/embed/3kmsUx0HUiQ?si=8EpHjPxHyu8cwprF\" frameborder=\"0\" width=\"100%\" height=\"240\"></iframe></p>\n\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t<div class=\"event-detail-each-artist col-xs-12 col-sm-5 col-sm-offset-rt-1\">\n\t\t\t\t\t<h1><a href=\"/artists/stewart-lee/\">Stewart Lee</a></h1>\n\t\t\t\t\t<p>Stewart Lee (&ldquo;the world&rsquo;s greatest living stand-up comedian&rdquo; The Times), is in danger of being left behind. He&rsquo;s approaching sixty with debilitating health conditions, his TV profile has diminished, and his once BAFTA award-winning style of stand-up seems obsolete in the face of a wave of callous Netflix-endorsed comedy of anger, monetising the denigration of minorities for millions of dollars. But he can still pack &rsquo;em in at CAF&Eacute; OTO!&nbsp;</p>\n\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t<div class=\"event-detail-each-artist col-xs-12 col-sm-5 col-sm-offset-rt-1\">\n\t\t\t\t\t<h1><a href=\"/artists/alan-niblock/\">Alan Niblock</a></h1>\n\t\t\t\t\t<p>Alan Niblock is a double bassist, improviser, spoken word, composer from Belfast, N.Ireland. His approach to improvisation is through a cognitive lens, treating music as a living unpredictable ecosystem where the environment and the audience directly shape the sonic narrative. He collaborates with prominent figures across Ireland, the UK and International improvised music scenes.</p>\n\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div class=\"event-detail-each-artist-image\">\n\t\t\t\t\t\t\t\t\t<img src=\"https://media.cafeoto.co.uk/_versions/images/alan-niblock_main.jpeg?ts=1788794391\" />\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t\n\n\n\n\n\n\t\n\n<div class=\"container-fluid\">\n    <div class=\"activity-container\">\n        <div class=\"row\">\n            <div class=\"col-sm-12\">\n                <h1 class=\"section-title\">You may also like</h1>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"activity-container-inner\">\n                \n                \n                    <div class=\"each-activity event-detail-each-artist col-xs-6 col-sm-3\">\n                        \n                            \n                                \n                                    <h2 class=\"sub-title\"><a href=\"/shop/hamid-drake-pat-thomas-a-mountain-sees-a-mountain/\">Vinyl</a></h2>\n                                \n                                <div class=\"event-detail-image\">\n                                    <a href=\"/shop/hamid-drake-pat-thomas-a-mountain-sees-a-mountain/\"><img src=\"https://media.cafeoto.co.uk/_versions/images/hamidpat_grayscale.jpg?ts=1765277044\" /></a>\n                                </div>\n                            \n           