            "text": "\n\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n\t<meta charset=\"utf-8\" />\n\t\n\t<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\">\n\t<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n\t<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black\">\n\t<meta name=\"viewport\"\n\t\tcontent=\"width=device-width, user-scalable=no, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0\">\n\t<meta name=\"robots\" content=\"index, follow\" />\n\t\n<meta property=\"og:title\" content=\"Cafe OTO &rarr; أحمد [Ahmed] – Four-Day residency – Pat Thomas / Antonin Gerbal / Joel Grip / Seymour Wright, 9–12 December 2026\" />\n<meta property=\"og:image\" content=\"http://www.cafeoto.co.ukhttps://media.cafeoto.co.uk/_versions/images/Ahmed-in-Paris-lr_main.jpg?ts=1748864794\"/>\n<meta property=\"og:description\" content=\"Hugely excited to welcome back&nbsp;أحمد [Ahmed] - the quartet of Pat Thomas (piano), Antonin Gerbal (drums), Joel Grip (double bass) and Seymour Wright (alto saxophone) - for another extended four-day residency. They make music of heavy rhythm, repetition and syncopation, …\" />\n\n\t\n\t\n\t<link rel=\"icon\" href=\"/static/img/oto-t.e76660063369.svg\" />\n\t\n\t\n\t<link rel=\"canonical\" href=\"https://www.cafeoto.co.uk/events/ahmed-four-day-residency-26/\" />\n\t<script src=\"/static/js/libs/jquery-2.1.1.min.e40ec2161fe7.js\"></script>\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/static/webfonts/ss-social.493795678b19.css\" />\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/static/webfonts/ss-gizmo.46124ac2c54c.css\" />\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/static/css/jquery.cookiebar.f0f5328eaf10.css\" />\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/static/css/cookie.dee57a82b24b.css\" />\n\t<script src=\"/static/js/utils.a9c77ef22e27.js\"></script>\n\t<script src=\"/static/js/cart.56af61584923.js\"></script>\n\t<script src=\"/static/js/jquery.json.7216ba3a1