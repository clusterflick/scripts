mg height=\"30px\" src=\"/static/img/instagram-logo-green.a7bed95db109.jpg\"></a>\n\t\t\t\t\t</span>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t\t<ul style=\"clear: both; margin: 10px 0px\">\n\t\t\t\t<li><a href=\"/\">Home</a></li>\n\t\t\t</ul>\n\t\t</div>\n\t\t<div class=\"clear\"></div>\n\t\t<img class=\"close\" src=\"/static/img/close.c3f3deea279b.png\">\n\t</div>\n</div>\n\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<a class=\"basket-trigger\" id=\"cart-stat\" href=\"#\">\n</a>\n\t\t\t\t\t\t\t<div class=\"basket-container\" id=\"basket\">\n\t\t\t\t\t\t\t\t\n\n\n<div class=\"cart-overlay\">\n    <img src=\"/static/img/checking_invert.02679df881dd.gif\" />\n</div>\n<div class=\"cart-content\">\n    \n        <form class=\"cart-form empty\">\n            \n            <div class=\"row\">\n                <div class=\"col-xs-12 col-sm-12\">\n                    <h1>Your basket is empty</h1>\n                </div>\n            </div>\n            <div class=\"row mobile-checkout\">\n                <div class=\"col-xs-12 col-sm-12\">\n                    <a class=\"return-button mobile\" href=\"#\" onClick=\"javascript: $('#basket, .credits-meta').fadeOut(200);$('html').removeClass('overlay-active');\"><span class=\"ss-gizmo ss-left\"></span> Continue shopping</a>\n                </div>\n            </div>\n            <div class=\"row desktop-checkout\">\n                <div class=\"col-xs-12\">\n                    <a class=\"return-button\" href=\"#\" onClick=\"javascript: $('#basket, .credits-meta').fadeOut(200);$('html').removeClass('overlay-active');\"><span class=\"ss-gizmo ss-left\"></span> Continue shopping</a>\n                </div>\n            </div>\n        </form>\n    \n</div>\n\n\n    <script src=\"/static/js/libs/isotope.min.6497284bdaca.js\"></script>\n    <script src=\"/static/js/cart.56af61584923.js\"> </script>\n \n\n<script>\n$(document).ready(function() {\n  //called when key is pressed in textbox\n  $(\".cart-count\").keypress(function (e) {\n     //if the letter is not digit then display error and don't type anything\n     if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {\n        //display error message\n        //$(\"#errmsg\").html(\"Digits Only\").show().delay(1000).fadeOut(\"slow\");\n               return false;\n    }\n   });\n   if ($('.cart-inner').length > 0) {\n        refreshCartLayout();\n    }\n});\n</script>\n\n\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"logo-container\">\n\t\t\t\t\t\t<a href=\"/\">Cafe OTO</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"search-container\">\n\t\t\t\t\t\t<span class=\"search-trigger\"></span>\n\t\t\t\t\t\t<form action=\"/search\" method=\"get\">\n\t\t\t\t\t\t\t<input type=\"text\" name=\"q\" value=\"\" />\n\t\t\t\t\t\t</form>\n\t\t\t\t\t</div>\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t<div class=\"signup-container login\">\n\t\t\t\t\t\t<span class=\"close\"></span>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t<a class=\"signup-trigger\" href=\"/accounts/register_login/\">Log in &ndash; Sign up</a>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t</div>\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\t<div class=\"new-menu-container\">\n\t\t<div class=\"container-fluid\">\n\t\t\t<div class=\"row\">\n\t\t\t\t<div class=\"col-xs-12 col-sm-12\">\n\t\t\t\t\t<ul class=\"new-menu\">\n\t\t\t\t\t\t<li class=\"has-menu\">\n\t\t\t\t\t\t\t<a href=\"/events/\">Programme</a>\n\t\t\t\t\t\t\t<ul class=\"sub-menu programme\">\n\t\t\t\t\t\t\t\t<li><a href=\"/events/\">All events</a></li>\n\t\t\t\t\t\t\t\t<li><a href=\"/events/new/\">New events</a></li>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<li><a href=\"/events/archive/\">Past Events</a></li>\n\t\t\t\t\t\t\t\t<li class=\"calendar\"><a href=\"/events/\">Calendar</a></li>\n\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t<div id=\"calendar\">\n\t\t\t\t\t\t\t\t<div class=\"calendar-header\">\n\t\t\t\t\t\t\t\t\t<div class=\"calendar-nav\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"prev\">&lt;</div>\n\t\t\t\t\t\t\t\t\t\t<div 