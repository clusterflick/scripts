            "mimeType": "text/html; charset=utf-8",
            "text": "\n\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n\t<meta charset=\"utf-8\" />\n\t\n\t<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\">\n\t<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n\t<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black\">\n\t<meta name=\"viewport\"\n\t\tcontent=\"width=device-width, user-scalable=no, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0\">\n\t<meta name=\"robots\" content=\"index, follow\" />\n\t\n<meta property=\"og:title\" content=\"Cafe OTO &rarr; Robyn&#x27;s Rocket – w/ Laura Jurd &amp; Robyn Rocket + Little Kali + ATMoss, Tuesday 17 November 2026, 7.30pm\" />\n<meta property=\"og:image\" content=\"http://www.cafeoto.co.ukhttps://media.cafeoto.co.uk/_versions/images/streamingthumnbnail17.11.26_main.jpg?ts=1790001105\"/>\n<meta property=\"og:description\" content=\"Robyn's Rocket with Laura Jurd, Little Kali and ATMoss with live visuals by Rucksack Cinema and Jade. Robyn&rsquo;s Rocket is a homemade spaceship that brings people together and presents a wide range of experimental/left-field music. Robyn&rsquo;s Rocket believes in being …\" />\n\n\t\n\t\n\t<link rel=\"icon\" href=\"/static/img/oto-o.a6e69cbcb99b.svg\" />\n\t\n\t\n\t<link rel=\"canonical\" href=\"https://www.cafeoto.co.uk/events/efg-london-jazz-festival-robyns-rocket/\" />\n\t<script src=\"/static/js/libs/jquery-2.1.1.min.e40ec2161fe7.js\"></script>\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/static/webfonts/ss-social.493795678b19.css\" />\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/static/webfonts/ss-gizmo.46124ac2c54c.css\" />\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/static/css/jquery.cookiebar.f0f5328eaf10.css\" />\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/static/css/cookie.dee57a82b24b.css\" />\n\t<script src=\"/static/js/utils.a9c77ef22e27.js\"></script>\n\t<script src=\"/static/js/cart.56af61584923.js\"></script>\n\t<script src=\"/static/js/j