ze\":183465,\"file_size_human\":\"179.2KB\",\"file_type\":\"jpg\",\"mime_type\":\"image/jpeg\",\"is_image\":true,\"is_video\":false,\"is_url\":false,\"in_use\":true,\"created_at\":\"2026-04-22T16:48:11.277579Z\",\"updated_at\":\"2026-04-22T16:48:11.277579Z\"},{\"id\":83845492,\"display_name\":\"IMG_7745.JPG\",\"name\":\"IMG_7745.JPG\",\"hash\":\"V3037035443630821123566583970813\",\"width\":6000,\"height\":4500,\"file_size\":4909441,\"file_size_human\":\"4.7MB\",\"file_type\":\"JPG\",\"mime_type\":\"image/jpeg\",\"is_image\":true,\"is_video\":false,\"is_url\":false,\"in_use\":true,\"created_at\":\"2026-07-16T12:47:01.678892Z\",\"updated_at\":\"2026-07-16T12:47:01.678892Z\"},{\"id\":83909664,\"display_name\":\"IMG_7627.JPG\",\"name\":\"IMG_7627.JPG\",\"hash\":\"C3038782608327657521153827175421\",\"width\":6000,\"height\":4500,\"file_size\":2533319,\"file_size_human\":\"2.4MB\",\"file_type\":\"JPG\",\"mime_type\":\"image/jpeg\",\"is_image\":true,\"is_video\":false,\"is_url\":false,\"in_use\":true,\"created_at\":\"2026-07-17T15:05:35.729315Z\",\"updated_at\":\"2026-07-17T15:05:35.729315Z\"},{\"id\":83909798,\"display_name\":\"IMG_7309.JPG\",\"name\":\"IMG_7309.JPG\",\"hash\":\"R3038786096440941162966651796477\",\"width\":6000,\"height\":4500,\"file_size\":3040764,\"file_size_human\":\"2.9MB\",\"file_type\":\"JPG\",\"mime_type\":\"image/jpeg\",\"is_image\":true,\"is_video\":false,\"is_url\":false,\"in_use\":true,\"created_at\":\"2026-07-17T15:08:44.777176Z\",\"updated_at\":\"2026-07-17T15:08:44.777176Z\"},{\"id\":83909983,\"display_name\":\"IMG_6812.JPG\",\"name\":\"IMG_6812.JPG\",\"hash\":\"Z3038789717001847254014057020413\",\"width\":5757,\"height\":4317,\"file_size\":3982600,\"file_size_human\":\"3.8MB\",\"file_type\":\"JPG\",\"mime_type\":\"image/jpeg\",\"is_image\":true,\"is_video\":false,\"is_url\":false,\"in_use\":true,\"created_at\":\"2026-07-17T15:12:00.943504Z\",\"updated_at\":\"2026-07-17T15:12:00.943504Z\"},{\"id\":83910031,\"display_name\":\"IMG_6626.jpeg\",\"name\":\"IMG_6626.jpeg\",\"hash\":\"O3038790510691457769441224850429\",\"width\":6000,\"height\":4500,\"file_size\":3812906,\"file_size_human\":\"3.6MB\",\"file_type\":\"jpeg\",\"mime_type\":\"image/jpeg\",\"is_image\":true,\"is_video\":false,\"is_url\":false,\"in_use\":true,\"created_at\":\"2026-07-17T15:12:43.957749Z\",\"updated_at\":\"2026-07-17T15:12:43.957749Z\"}],\"tags\":[],\"access_level\":\"public\"},\"H0920602532\":{\"id\":\"H0920602532\",\"title\":\"Programme\",\"purl\":\"programme-55\",\"page_type\":\"page\",\"content\":\"SCREENING\\u003cbr />\\n\\u003cbr />\\n\\u003ch1>\\u003cb>\\nCollecting Remembrance\\u003cbr />By Naomi Lo\\u003cbr />\\u003c/b>\\u003c/h1>\\u003cspan class=\\\"bodycopy2\\\">\\u003cb>\\u003cbr />\\nThursday 12 November, 7pm\\u003c/b>\\u003c/span>\\n\\u003cbr />\\n\\u003cbr />\\nThe dormant reciprocity of sound that persists in urban living is a recurring theme in \\u003cb>Naomi Lo\\u003c/b>’s debut short documentary. In \\u003ci>Collecting Remembrance\\u003c/i>, Naomi depicts her personal journey to explore methods of remembering sound through everyday life. Later, her engagement with a Cantonese singing group, as part of \\u003cb>Jess Hui\\u003c/b>’s healthcare research project \\u003ci>Connecting Through Song\\u003c/i>, shifted her perspective on sonic memory. Jess and Naomi, whose Cantonese heritage intertwines but resonate differently through their lived experience, singing Cantonese songs by themes and recollecting appreciation for the language unfurls collective memories across transnational Cantonese communities. The film compiles moments of improvisation and play through songs by Cantopop legends from \\u003cb>Sam Hui（許冠傑) \\u003c/b>to \\u003cb>Teresa Teng （鄧麗君）\\u003c/b>, revealing how singing can be a purely sentimental connection rather than being overshadowed by competition and refined skills.\\u003cbr />\\n\\u003cbr />\\n\\u003cbr />\\nScreening will be followed by a conversation with Dr. Jess Hui.\\u003cbr />\\n\\u003cbr />\\n\\u003cspan style=\\\"--font-scale: 0.68;\\\">\\u003ca class=\\\"text-style-764985\\\" href=\\\"https://bit.ly/4zTl27M\\\" target=\\\"_blank\\\">RSVP\\u003c/a>\\u003cbr />\\n\\u003c/span>\\n\\n\\u003cbr />\",\"local_css\":\"[id=\\\"H0920602532\\\"] .backdrop {\\n\\tposition: relative;\\n\\twidth: 50%;\\n\\torder: 0;\\n}\\n\\n.mobile [id=\\\"H0920602532\\\"] .backdrop {\\n\\torder: 0;\\n\\theight: var(--split-backdrop-height);\\n\\twidth: 100%;\\n}\\n\\n.mobile [id=\\\"H0920602532\\\"] .page-layout {\\n\\tmax-width: 100%;\\n\\tmin-width: 100%;\\n\\tmin-height: var(--split-content-height);\\n}\\n\\n[id=\\\"H0920602532\\\"] .page-content {\\n\\twidth: 100%;\\n}\\n\\n[id=\\\"H0920602532\\\"].page {\\n\\tbackground-color: #f7b9b1;\\n}\",\"display\":true,\"stack\":false,\"pin\":false,\"overlay\":false,\"password_enabled\":false,\"page_count\":0,\"page_design_options\":null,\"backdrops\":{\"activeBackdrop\":\"wallpaper\",\"backdropSettings\":{\"wallpaper\":{\"activeImage\":\"P3204680296881131417547848580093\",\"alignments\":[],\"image-fit\":\"fill\",\"clipScroll\":false,\"cycle-images\":false,\"transition-type\":\"slide\",\"autoplay\":true,\"autoplay-delay\":3,\"transition-speed\":0.8,\"shuffle\":false,\"navigation\":false,\"opacity\":1,\"bg-color\":\"transparent\",\"margin\":\"0\"}}},\"pin_options\":{},\"overlay_options\":{},\"thumb_media_id\":69107454,\"thumbnail\":{\"id\":69107454,\"master_muid\":14908156,\"name\":\"Bouchra-Khalili--The-Public-Storyteller--Video-still-4.png\",\"display_name\":null,\"hash\":\"K2667518342275486623415440472828\",\"width\":3352,\"height\":2510,\"file_size\":4778692,\"file_type\":\"png\",\"mime_type\":\"image/png\",\"is_image\":true,\"is_video\":false,\"is_url\":false,\"is_placeholder\":false,\"has_audio_track\":null,\"duration\":null,\"url\":null,\"url_id\":null,\"url_thumb\":null,\"url_type\":null,\"created_at\":\"2025-11-26 16:27:40.411717\",\"updated_at\":\"2025-11-26 16:27:40.411717\",\"options\":null},\"thumb_meta\":[],\"media\"