e: normal;\n\tfont-weight: 400;\n\tfont-variation-settings: 'slnt' 0, 'MONO' 0;\n\tline-height: normal;\n\tletter-spacing: 0em;\n\tmargin-bottom: 0.5em;\n\tborder-radius: 10em;\n}\n\naudio-player::part(button) {\n\t--icon-color: rgba(0, 0, 0, 0.85);\n\t--icon-size: 32%;\n\t--play-text: '';\n\t--pause-text: '';\n\twidth: 3.15em;\n\tdisplay: inline-flex;\n\tjustify-content: center;\n\tcursor: pointer;\n}\n\naudio-player::part(play-icon) {\n\tpadding-left: 0.6em;\n}\n\naudio-player::part(pause-icon) {\n\tpadding-left: 0.4em;\n}\n\naudio-player::part(progress-indicator) {\n\tborder-right: 1px solid rgba(0, 0, 0, 0);\n\theight: 100%;\n\tcursor: ew-resize;\n}\n\naudio-player::part(separator) {\n\tborder-right: var(--border-lines);\n}\n\nbody.mobile audio-player {\n\tmax-width: 100%;\n}\n\nmedia-item {\n\t--scroll-animation-mode: animation;\n}</style><style id=\"mobile-offset-styles\"></style><style id=\"text-style-font-sizes\"></style><style id=\"link-styles\"></style><style id=\"font-feature-settings-styles\"></style><div class=\"content\"><div id=\"W3346999636\" page-url=\"header—menu\" class=\"page pinned pinned-top fixed\"><a id=\"header—menu\"></a><div class=\"page-layout\"><div class=\"page-content\"><bodycopy style=\"--fit-height: 10px; --resize-parent-width: 100%;\"><column-set gutter=\"0.0rem\"><column-unit slot=\"0\" span=\"3\">\n    <div style=\"text-align: right\">\n      <div style=\"text-align: left\"><b><h2 style=\"color: rgb(3, 78, 56); --font-scale: 1.2;\">MOSAIC<br />\nROOMS</h2></b><br /></div></div></column-unit><column-unit slot=\"1\" span=\"6\"><div style=\"text-align: center\"><media-item class=\"linked\" hash=\"E2420376052912860883643640543996\" href=\"#highlight\" limit-by=\"width\" rel=\"history\" scale=\"20%\"></media-item><span class=\"title-1\"></span></div></column-unit><column-unit slot=\"2\" span=\"3\"><div style=\"text-align: right\"><a class=\"icon-link menu-button\" href=\"overlay-1\" rel=\"history\"><text-icon icon=\"plus-2\"></text-icon></a></div><div style=\"text-align: center\"></div></column-unit></column-set></bodycopy></div></div><style>[id=\"W3346999636\"] .page-content {\n\tpadding: 1.5rem;\n\tbackground-color: #fdf8d3;\n\tbox-shadow: 0.4rem 0.4rem 1rem 0rem rgba(0,0,0,0);\n\tborder-radius: 0rem;\n}\n\n[id=\"W3346999636\"].page {\n\tjustify-content: center;\n\tmin-height: auto;\n}\n\n[id=\"W3346999636\"] .page-layout {\n\tmax-width: 100%;\n\tpadding: 0rem;\n}\n\n.overlay-content:has([id=\"W3346999636\"]) {\n}</style><style id=\"mobile-offset-styles-W3346999636\"></style></div><div style=\"margin-top: 0px; margin-bottom: 0px;\" class=\"pages\"><div data-direction=\"up\" class=\"pagination-watcher \"></div><div data-container=\"set\" data-id=\"L3543333909\"><div id=\"C2344310529\" page-url=\"programme-53\" class=\"page stacked-page\"><div class=\"backdrop clip\"><div style=\"--backdrop-width: 800px; --backdrop-height: 800px;\" class=\"backdrop-contents  inside  \"><div class=\"wallpaper\"></div></div></div><a id=\"programme-53\"></a><div class=\"page-layout\"><div class=\"page-content\"><bodycopy style=\"--fit-height: 10px; --resize-parent-width: 100%;\"><span class=\"header\">FILM <br />\n</span><h1><b><span style=\"line-height: 1.1;\">\n\nPalestine Cinema Days Around the World: <br />\n<i>Blessed Blessed Oblivion &#x26; With Hasan in Gaza</i> \n\n\n</span> </b></h1><b><h2 style=\"--font-scale: 0.9;\">2 November 2026, 4-6pm</h2></b>\n\n<br />\n<b>LUX</b> and <b>Mosaic Rooms</b> are collaborating for a special screening of <b>Jumana Manna</b>’s <i>Blessed Blessed Oblivion</i> (2010, 21’) from the LUX collection, alongside <b>Kamal Aljafari</b>’s <i>With Hasan in Gaza</i> (2025, 106’) as part of the <b>Palestine Cinema Days Around the World</b>. Presented together, these two films provide a rich portrait of Palestinian daily life, one in East Jerusalem, the other in Gaza. In particular, they have a focus on the manifestations of masculinity in Palestine, looking beyond the stereotypes of Palestinian men that have often circulated in Western media.<br />\n<br />\nJumana Manna’s <i>Blessed Blessed Oblivion</i> weaves together a portrait of masculine performativity in East Jerusalem, as manifested in gyms, barber shops and body parlors. Inspired by Kenneth Anger’s <i>Scorpio Rising</i> (1963), the video uses visual collage and the soundtrack as ironic commentary on stereotyped male “thug” culture in Palestine. Close-up fragments construct an eroticised and parodic montage of bodies, cars and places, intersected by snippets of dialogue and a monologue about the art of a car wash. Simultaneously psychologizing the characters and being seduced by them, the film director finds herself in a double bind similar to the conflicted desire that animates her protagonist as he drifts between abject rants, declamations of heroic poetry and unashamed self-praise.<br />\n<br />\n<i>With Hasan in Gaza</i> looks back at a journey the filmmaker made in 2001, from the north to the south of Gaza, searching for the man with whom he had spent seven months in an Israeli prison over a decade earlier. Kamal Aljafari recently rediscovered the footage in his archive and edited it into this filmic journal of daily life in Gaza, with all of its moments of vibrancy. The film captures children at play, bustling markets, small shops and cafés—but a darker reality looms in images of military checkpoints, demolished Palestinian homes, and the Israeli shelling of a residential neighborhood at night. <br />\n<br />\n\n\n\n\n\n<br />\n <span style=\"--font-scale: 0.65;\">Image: Film still, <i>With Hasan in Gaza </i>by Kamal Aljafari, 2025. Courtesy of filmmaker.</span>\n<br />\n<span style=\"--font-scale: 0.9;\"><br />\n<span style=\"--font-scale: 0.68;\"><a class=\"text-style-764985\" href=\"https://tzkrti.com/en/events/4873\" target=\"_blank\">RSVP</a><br />\n<br />\n\n</span></span></bodycopy></div></div><style>[id=\"C2344310529\"] .backdrop {\n\tposition: relative;\n\twidth: 50%;\n\torder: 0;\n}\n\n.mobile [id=\"C2344310529\"] .backdrop {\n\torder: 0;\n\theight: var(--split-backdrop-height);\n\twidth: 100%;\n}\n\n.mobile [id=\"C2344310529\"] .page-layout {\n\tmax-width: 100%;\n\tmin-width: 100%;\n\tmin-height: var(--split-content-height);\n}\n\n[id=\"C2344310529\"] .page-content {\n\twidth: 100%;\n}\n\n[id=\"C2344310529\"].page {\n\tbackground-color: #f7b9b1;\n}</style><style id=\"mobile-offset-styles-C2344310529\"></style></div><div id=\"Y0708854759\" page-url=\"about-pcdaw-and-lux\" class=\"page stacked-page\"><a id=\"about-pcdaw-and-lux\"></a><div class=\"page-layout\"><div class=\"page-content\"><bodycopy style=\"--fit-height: 10px; --resize-parent-width: 100%;\"><div style=\"text-align: center; font-size: 2.5rem; line-height: 1.3;\"><div style=\"text-align: left; font-size: 1.2rem; color: rgb(10, 10, 10);\"><column-set gutter=\"1\" mobile-hide-empty=\"false\" mobile-stack=\"true\"><column-unit slot=\"0\"><h2><b></b><div class=\"mailing-section\"><b></b></div></h2></column-unit><column-unit slot=\"1\"><div class=\"mailing-section\">\n\n<div style=\"font-size: 2.5rem; line-height: 1.3;\"><div style=\"font-size: 1.2rem; color: rgb(10, 10, 10);\"><h2><b></b><div class=\"mailing-section\"></div></h2><div class=\"mailing-section\">Organised by <b>Filmlab Palestine</b>, the 4th edition of <b><a href=\"https://flp.ps/node/319\" target=\"_blank\">Palestine Cinema Days Around The World</a></b> takes place on 2 November 2026 the 109th anniversary of the Balfour Declaration. <i>Palestine Cinema Days Around the World</i> is a global platform that transcends borders to bring Palestinian stories to the forefront of the world’s conscience. <i>Palestine Cinema Days</i> have grown into a borderless, community-driven act of cultural resistance to protect our stories against systematic erasure, silencing, and distortion. <br />\n<br /><b>LUX</b> is an arts organisation that supports and promotes visual artists working with the moving image. Founded in 2002 as a charity and not-for-profit limited company, the organisation builds on a long lineage of predecessors (The London Film-Makers’ Co-operative, London Video Arts and The Lux Centre) which stretch back to the 1960s.  </div></div></div>\n\n\n<br /></div></column-unit></column-set></div></div>\n<!--          MAILING LIST SECTION          -->\n<div class=\"mailing-section\">\n  <form action=\"https://mosaicrooms.us2.list-manage.com/subscribe/post?u=3e62b74b03d30b38025b333fd&id=625f043cb9&f_id=00e6c2e1f0\" class=\"footer-form\" method=\"POST\" novalidate=\"\" target=\"_blank\">\n</form></div></bodycopy></div></div><style>[id=\"Y0708854759\"].page {\n\tbackground-color: #ffffff;\n\tjustify-content: center;\n\tmin-height: auto;\n}\n\n[id=\"Y0708854759\"] .page-content {\n\twidth: 100%;\n}\n\n[id=\"Y0708854759\"] .backdrop {\n\tposition: relative;\n\twidth: 50%;\n\torder: 1;\n}\n\n.mobile [id=\"Y0708854759\"] .backdrop {\n\torder: 0;\n\theight: var(--split-backdrop-height);\n\twidth: 100%;\n}\n\n.mobile [id=\"Y0708854759\"] .page-layout {\n\tmax-width: 100%;\n\tmin-width: 100%;\n\tmin-height: auto;\n}</style><style id=\"mobile-offset-styles-Y0708854759\"></style></div><div id=\"Q3805278367\" page-url=\"mailinglist-98\" class=\"page stacked-page\"><a id=\"mailinglist-98\"></a><div class=\"page-layout\"><div class=\"page-content\"><bodycopy style=\"--fit-height: 10px; --resize-parent-width: 100%;\"><div style=\"text-align: center; font-size: 2.5rem; line-height: 1.3;\"><div style=\"text-align: left; font-size: 1.2rem; color: rgb(10, 10, 10);\"><column-set gutter=\"1\" mobile-hide-empty=\"false\" mobile-stack=\"true\"><column-unit slot=\"0\"><h2>JOIN OUR MAILING LIST</h2></column-unit><column-unit slot=\"1\"><div class=\"mailing-section\"><div style=\"font-size: 2.5rem; line-height: 1.3;\"><div style=\"font-size: 1.2rem; color: rgb(10, 10, 10);\"><div class=\"mailing-section\"><strong>Keep in touch with Mosaic Rooms</strong><br /><br />Join our mailing list to receive updates on our exhibitions, events, books, workshops and broadcasts.<br />\n\n\n  \n\n  <br />Email address<br />\n\n\n  <form action=\"https://mosaicrooms.us2.list-manage.com/subscribe?u=3e62b74b03d30b38025b333fd&id=625f043cb9\" class=\"footer-form\" method=\"POST\" novalidate=\"\" target=\"_blank\">\n    <input name=\"EMAIL\" placeholder=\"you@example.com\" required=\"\" type=\"email\" />\n    <button type=\"submit\">Subscribe</button></form></div></div></div>\n</div></column-unit></column-set><h1></h1></div></div>\n<!--     MAILING LIST SECTION     -->\n<div class=\"mailing-section\">\n  <form action=\"https://mosaicrooms.us2.list-manage.com/subscribe/post?u=3e62b74b03d30b38025b333fd&id=625f043cb9&f_id=00e6c2e1f0\" class=\"footer-form\" method=\"POST\" novalidate=\"\" target=\"_blank\">\n</form></div></bodycopy></div></div><style>[id=\"Q3805278367\"].page {\n\tbackground-color: #ffffff;\n\tjustify-content: center;\n\tmin-height: auto;\n}\n\n[id=\"Q3805278367\"] .page-content {\n\twidth: 100%;\n}\n\n[id=\"Q3805278367\"] .backdrop {\n\tposition: relative;\n\twidth: 50%;\n\torder: 1;\n}\n\n.mobile [id=\"Q3805278367\"] .backdrop {\n\torder: 0;\n\theight: var(--split-backdrop-height);\n\twidth: 100%;\n}\n\n.mobile [id=\"Q3805278367\"] .page-layout {\n\tmax-width: 100%;\n\tmin-width: 100%;\n\tmin-height: auto;\n}</style><style id=\"mobile-offset-styles-Q3805278367\"></style></div></div><div data-direction=\"down\" class=\"pagination-watcher \"></div></div><div id=\"Y2678236886\" page-url=\"footer\" class=\"page pinned pinned-bottom stacked-page\"><a id=\"footer\"></a><div class=\"page-layout\"><div class=\"page-content\"><bodycopy style=\"--fit-height: 10px; --resize-parent-width: 100%;\"><column-set mobile-stack=\"true\"><column-unit slot=\"0\"><media-item hash=\"P2410786321307578559246402550524\" limit-by=\"width\" scale=\"80%\"></media-item><br />\n<br />\n<br />\n<br />\n<br />\n<div style=\"text-align: left;\"><span class=\"caption\" style=\"--font-scale: 0.8;\">UK Registered Charity No. 1183882</span></div><br /></column-unit><column-unit slot=\"1\"><div style=\"text-align: left;\"><span class=\"caption\">Mosaic Rooms is generously supported by <b>Al-Qattan Charitable Trust. </b></span></div><span class=\"caption\"><br />Current projects are supported by</span><br />\n<media-item hash=\"E2764510220827921411288269831020\" limit-by=\"width\" scale=\"25%\"></media-item><media-item hash=\"T2764545984545228036050013109100\" limit-by=\"width\" scale=\"25.1%\"></media-item> <br />\n<br />\n  \n<br />\n </column-unit><column-unit slot=\"2\"><span class=\"caption\"><b><a href=\"#visit-us\" rel=\"history\">Contact Us</a><br />\n<a href=\"https://freight.cargo.site/m/V2888662501090761096357868975317/Privacy-Notice-2026-V2-1.pdf\" target=\"_blank\">Privacy Policy</a><br />\n<a href=\"https://freight.cargo.site/m/N2747039618074399215892426110165/Terms-and-Conditions---Mosaic-Rooms-2026.pdf\" target=\"_blank\">Terms &#x26; Conditions\n</a><br />\n</b><br />\n<b>Enquiries</b><br />\n<u><a href=\"mailto:info@mosaicrooms.org\" rel=\"mailto\">General </a><br />\n<a href=\"mailto:learning@mosaicrooms.org\" rel=\"mailto\">Learning</a><br />\n<a href=\"mailto:press@mosaicrooms.org\" rel=\"mailto\">Press</a></u><br />\n</span>\n</column-unit><column-unit slot=\"3\">\n  <span class=\"caption\">\n<a href=\"https://maps.app.goo.gl/8bBudTcrHZWKdBjU7\" target=\"_blank\">Mosaic Rooms<br />\n226 Cromwell Road, London SW5 0SW</a><br />\n<br />E    <a href=\"mailto:info@mosaicrooms.org\" rel=\"mailto\">contact@mosaicrooms.org</a><br />\nT    +44 020 7370 9990<br /><br />\n\n<br />\n<span style=\"--font-scale: 1.7;\"><a class=\"icon-link\" href=\"https://www.instagram.com/themosaicrooms/\" target=\"_blank\"><text-icon icon=\"instagram\"></text-icon></a><a class=\"icon-link\" href=\"https://www.facebook.com/themosaicrooms/\" target=\"_blank\"> <text-icon icon=\"facebook\"></text-icon></a>   <a class=\"icon-link\" href=\"https://vimeo.com/themosaicrooms\" target=\"_blan