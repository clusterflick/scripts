          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-17\",\"showtimes\":[{\"id\":\"963-121517\",\"schedule\":{\"businessDate\":\"2026-08-17\",\"startsAt\":\"2026-08-17T20:00:00+01:00\",\"endsAt\":\"2026-08-17T22:15:00+01:00\",\"filmStartsAt\":\"2026-08-17T20:00:00+01:00\",\"filmEndsAt\":\"2026-08-17T22:15:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"963-3-172\",\"filmId\":\"HO00009181\",\"siteId\":\"963\",\"screenId\":\"963-3\",\"areaCategories\":[{\"areaCategoryId\":\"963-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000187\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"963\",\"name\":{\"text\":\"Greenwich\",\"translations\":[]},\"location\":{\"latitude\":51.4905,\"longitude\":0.0127},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Greenwich@OdeonUK.com\",\"address\":{\"line1\":\"Bugsby's Way\",\"line2\":\"Greenwich\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00009181\",\"title\":{\"text\":\"James: Getting Away with It + Live Performance\",\"translations\":[]},\"synopsis\":{\"text\":\"The fully authorised story of James, one of Britain’s most iconic and unlikely bands, told for the first time. Formed in early 80s Manchester, a group of awkward misfits stumbled through a decade of false starts, bad decisions and infamous missteps – joining a cult, turning down the chance to tour with The Smiths and rejecting the legendary Factory Records – before breaking through with Sit Down.\\n \\nFuelled by an improvisational and chaotic approach to music, they built a remarkable catalogue over 40 years. Yet success deepened their dysfunction, leading to collapse at the millennium. But fans refused to let them die and after repairing their differences, they reunited in 2007, finding new life, bigger audiences and finally – a number one album. Please note, the feature will start promptly at 20:00, then the live interview and performance will start directly from the end of the feature. Approx show end will be 22:15.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The fully authorised story of James, one of Britain’s most iconic and unlikely bands, told for the first time. \",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-17\",\"runtimeInMinutes\":135,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000010561\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019551\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019552\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019553\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019554\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019555\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019556\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019557\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000008\",\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"8472f34d-370e-415d-ae45-2ecf3a66a1fc\",\"corporateId\":null},\"hopk\":\"HO00009181\",\"hoCode\":\"A000010349\",\"eventId\":\"0000000001\",\"distributorName\":\"Source Entertainment\"}],\"castAndCrew\":[{\"id\":\"0000010561\",\"name\":{\"givenName\":\"Chris\",\"familyName\":\"Atkins\",\"middleName\":null}},{\"id\":\"0000019551\",\"name\":{\"givenName\":\"Jim\",\"familyName\":\"Glennie\",\"middleName\":null}},{\"id\":\"0000019552\",\"name\":{\"givenName\":\"Tim\",\"familyName\":\"Booth\",\"middleName\":null}},{\"id\":\"0000019553\",\"name\":{\"givenName\":\"Dave\",\"familyName\":\"Baynton-Power\",\"middleName\":null}},{\"id\":\"0000019554\",\"name\":{\"givenName\":\"Saul\",\"familyName\