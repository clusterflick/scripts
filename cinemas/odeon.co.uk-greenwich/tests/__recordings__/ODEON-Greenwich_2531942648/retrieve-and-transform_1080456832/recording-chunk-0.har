          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-05-28\",\"showtimes\":[{\"id\":\"963-105844\",\"schedule\":{\"businessDate\":\"2026-05-28\",\"startsAt\":\"2026-05-28T19:00:00+01:00\",\"endsAt\":\"2026-05-28T21:55:00+01:00\",\"filmStartsAt\":\"2026-05-28T19:25:00+01:00\",\"filmEndsAt\":\"2026-05-28T21:55:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"963-6-151\",\"filmId\":\"HO00008185\",\"siteId\":\"963\",\"screenId\":\"963-6\",\"areaCategories\":[{\"areaCategoryId\":\"963-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"963\",\"name\":{\"text\":\"Greenwich\",\"translations\":[]},\"location\":{\"latitude\":51.4905,\"longitude\":0.0127},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Greenwich@OdeonUK.com\",\"address\":{\"line1\":\"Bugsby's Way\",\"line2\":\"Greenwich\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008185\",\"title\":{\"text\":\"NT Live: The Playboy of the Western World\",\"translations\":[]},\"synopsis\":{\"text\":\"Nicola Coughlan (Bridgerton) joins Éanna Hardwicke (The Sixth Commandment) and Siobhán McSweeney (Derry Girls) in John Millington Synge’s riveting play of youth and self-discovery. Pegeen Flaherty’s life is turned upside down when a young man walks into her pub claiming that he’s killed his father. Instead of being shunned, the killer becomes a local hero and begins to win hearts, that is until a second man unexpectedly arrives on the scene… Filmed live on stage at the National Theatre, Caitríona McLaughlin directs this darkly funny tale full to the brim with secrets.\",\"translations\":[]},\"shortSynopsis\"