            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-09-22\",\"showtimes\":[{\"id\":\"963-119040\",\"schedule\":{\"businessDate\":\"2026-09-22\",\"startsAt\":\"2026-09-22T19:00:00+01:00\",\"endsAt\":\"2026-09-22T21:55:00+01:00\",\"filmStartsAt\":\"2026-09-22T19:25:00+01:00\",\"filmEndsAt\":\"2026-09-22T21:55:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"963-1-174\",\"filmId\":\"HO00009033\",\"siteId\":\"963\",\"screenId\":\"963-1\",\"areaCategories\":[{\"areaCategoryId\":\"963-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"963\",\"name\":{\"text\":\"Greenwich\",\"translations\":[]},\"location\":{\"latitude\":51.4905,\"longitude\":0.0127},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Greenwich@OdeonUK.com\",\"address\":{\"line1\":\"Bugsby's Way\",\"line2\":\"Greenwich\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00009033\",\"title\":{\"text\":\"National Theatre Live: The Misanthrope\",\"translations\":[]},\"synopsis\":{\"text\":\"Award-winner Sandra Oh (Killing Eve) plays the title role in this razor-sharp reimagining of Molière’s classic dark comedy. Telling the truth isn’t always that simple. Alice, a brilliant novelist, despises the carefully constructed lies of modern society. But the more she challenges those around her, the fiercer the backlash becomes. Soon, she must confront the price of speaking her truth in a world that would rather silence her. Filmed live on stage at the National Theatre, Indhu Rubasingham directs Martin Crimp’s (Cyrano de Bergerac) highly anticipated play.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Award-winner Sandra Oh (Killing Eve) plays the title role in this razor-sharp reimagining of Molière’s classic dark comedy.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-09-22\",\"runtimeInMinutes\":150,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002358\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019238\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019239\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"19464\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"19465\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000447\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000039\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5601913c-5c9c-400a-8361-fab2a4c2a9ba\",\"corporateId\":null},\"hopk\":\"HO00009033\",\"hoCode\":\"A000010187\",\"eventId\":\"0000000001\",\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"0000002358\",\"name\":{\"givenName\":\"Sandra\",\"familyName\":\"Oh\",\"middleName\":null}},{\"id\":\"0000019238\",\"name\":{\"givenName\":\"Paul\",\"familyName\":\"Chahidi\",\"middleName\":null}},{\"id\":\"0000019239\",\"name\":{\"givenName\":\"Tom\",\"familyName\":\"Mison\",\"middleName\":null}},{\"id\":\"0000019240\",\"name\":{\"givenName\":\"Abigail\",\"familyName\":\"Cruttenden\",\"middleName\":null}},{\"id\":\"19464\",\"name\":{\"givenName\":\"Jemima\",\"familyName\":\"Rooper\",\"middleName\":null}},{\"id\":\"19465\",\"name\":{\"givenName\":\"Indhu\",\"familyName\":\"Rubasingham\",\"middleName\":null}},{\"id\":\"HO00000447\",\"name\":{\"givenName\":\"National Theatre\",\"familyName\":\"Live\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000039\",\"name\":{\"text\":\"Live Theatre\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\