          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-02-28\",\"showtimes\":[{\"id\":\"963-108824\",\"schedule\":{\"businessDate\":\"2026-02-28\",\"startsAt\":\"2026-02-28T13:00:00+00:00\",\"endsAt\":\"2026-02-28T15:24:00+00:00\",\"filmStartsAt\":\"2026-02-28T13:25:00+00:00\",\"filmEndsAt\":\"2026-02-28T15:24:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"963-9-182\",\"filmId\":\"HO00008387\",\"siteId\":\"963\",\"screenId\":\"963-9\",\"areaCategories\":[{\"areaCategoryId\":\"963-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000187\",\"0000000147\",\"0000000174\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"963-108823\",\"schedule\":{\"businessDate\":\"2026-02-28\",\"startsAt\":\"2026-02-28T16:00:00+00:00\",\"endsAt\":\"2026-02-28T18:24:00+00:00\",\"filmStartsAt\":\"2026-02-28T16:25:00+00:00\",\"filmEndsAt\":\"2026-02-28T18:24:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"963-9-182\",\"filmId\":\"HO00008387\",\"siteId\":\"963\",\"screenId\":\"963-9\",\"areaCategories\":[{\"areaCategoryId\":\"963-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000187\",\"0000000147\",\"0000000174\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"963\",\"name\":{\"text\":\"Greenwich\",\"translations\":[]},\"location\":{\"latitude\":51.4905,\"longitude\":0.0127},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Greenwich@OdeonUK.com\",\"address\":{\"line1\":\"Bugsby's Way\",\"line2\":\"Greenwich\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008387\",\"title\":{\"text\":\"Twenty One Pilots: More Than We Ever Imagined\",\"translations\":[]},\"synopsis\":{\"text\":\"Experience the electrifying concert film capturing Twenty One Pilots at a career-defining moment: their monumental Mexico City headline show, performing in front of 65,000 fans at Estadio GNP Seguros during The Clancy World Tour. \\n\\nSet against the vibrant pulse of one of the world’s most iconic music capitals, the film blends cinematic high-energy performance footage with intimate, behind-the-scenes access, revealing the heart, humor, and humanity of the artists as they prepare for one of the biggest shows of their career. \\n\\nViewers follow the band from their arrival in Mexico City to the stage, sharing in the preparation and anticipation that build as showtime approaches. Exclusive commentary from Tyler and Josh offer personal reflections on the journey that brought them to this historic stage and the deep connection with their fans who make it all possible.\\n\\nThe film pulls audiences into the full spectacle of the night. Sweeping aerials of the stadium, on-stage cameras, and crowd-level shots place viewers right at the center of the experience, seeing the show from every angle.  The result is a thrilling, emotional celebration of music, community, and achievement - an unforgettable portrait of Twenty One Pilots, performing a show that will echo through their legacy.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Experience the electrifying concert film capturing Twenty One Pilots at a career-defining moment: their monumental Mexico City headline show.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"