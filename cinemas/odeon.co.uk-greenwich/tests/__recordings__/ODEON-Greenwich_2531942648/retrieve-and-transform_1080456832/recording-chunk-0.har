rewMemberId\":\"0000016140\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016141\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"9353\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001014\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001107\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001108\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001109\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002485\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002508\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002640\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e5808809-5d74-4074-ba7d-547c6d87a1b4\",\"corporateId\":null},\"hopk\":\"HO00007638\",\"hoCode\":\"A000008678\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00007891\",\"title\":{\"text\":\"A Tooth Fairy Tale\",\"translations\":[]},\"synopsis\":{\"text\":\"Van is a teenage tooth fairy with a taste for adventure, who wishes to explore life beyond the boundaries of his secluded civilization and rigid traditions. Upon meeting Gemma, a daring goblin girl with a knack for science, the pair realise that they have a lot in common, despite the ancient disputes between their two tribes. Together, with the help of Rupee (the world’s cutest troll!), they decide to embark on a mission to reunite their magical kingdoms for good. However, hot on their trail is the greedy Spider Queen and her minions, who will stop at nothing to put an end to their plans.\\n\\nA stunning animation that will spark the imagination of the whole family, it stars Booboo Stewart (The Twilight Saga, Descendants), Larkin Bell (Stranger Things), Vivica A. Fox (Ella Enchanted), Jon Lovitz (Matilda, Hotel Transylvania), and Fran Drescher (Hotel Transylvania).\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Van is a teenage tooth fairy with a taste for adventure, who wishes to explore life beyond the boundaries of his secluded civilization and rigid traditions. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild fantasy violence\",\"translations\":[]},\"releaseDate\":\"2025-10-17\",\"runtimeInMinutes\":88,\"trailerUrl\":\"https://www.youtube.com/watch?v=eLgAL70FzLE\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001634\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002728\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005183\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016119\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016728\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016729\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016730\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"2227\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"21af7487-fc4d-4b39-a8e9-e0607032c85d\",\"corporateId\":null},\"hopk\":\"HO00007891\",\"hoCode\":\"A000008958\",\"eventId\":null,\"distributorName\":\"Kaleidoscope Home Entertainmen\"},{\"id\":\"HO00008012\",\"title\":{\"text\":\"The Housemaid\",\"translations\":[]},\"synopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous — a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, sex, sexual violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-12-22\",\"runtimeInMinutes\":131,\"trailerUrl\":\"https://www.youtube.com/watch?v=kdDdlY2VPxw\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000009161\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012707\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016976\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016977\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000031\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000135\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000814\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001305\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dc7be94d-5ba5-4a79-accd-48ed4d19a3b6\",\"corporateId\":null},\"hopk\":\"HO00008012\",\"hoCode\":\"A000009092\",\"eventId\":null,\"distributorName\":\"LIONSGATE INTERNATIONAL\"},{\"id\":\"HO00008080\",\"title\":{\"text\":\"Hamnet\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"distressing scenes, brief moderate sex\",\"translations\":[]},\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":126,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\