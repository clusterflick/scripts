,\"distributorName\":\"Black Bear Pictures\"},{\"id\":\"HO00008239\",\"title\":{\"text\":\"Kangaroo\",\"translations\":[]},\"synopsis\":{\"text\":\"KANGAROO is a heart-warming family comedy about ex TV personality, Chris Masterman, who becomes stranded in an Outback town outside Alice Springs. There, he teams up with 12-year-old Indigenous girl Charlie. The pair form an unlikely friendship and work together to rescue and rehabilitate orphaned joeys in the remote but stunning Outback community - an endeavour that proves to be life-changing for them both.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"KANGAROO is a heart-warming family comedy about an ex-TV personality Chris Masterman, who becomes stranded in an Outback town after a car accident on his way to Broome. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild bad language, threat, violence\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":107,\"trailerUrl\":\"https://www.youtube.com/watch?v=BAwuJ74KP6U\",\"displayPriority\":12,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002636\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006784\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011449\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011614\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012011\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016712\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016713\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000016714\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016715\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016716\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016717\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016718\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016719\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016720\",\"roles\":[\"Actor\"]},{\"castAndC