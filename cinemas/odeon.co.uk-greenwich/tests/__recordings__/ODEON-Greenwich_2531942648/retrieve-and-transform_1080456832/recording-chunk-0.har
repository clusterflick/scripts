ngId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-13\",\"runtimeInMinutes\":140,\"trailerUrl\":\"https://www.youtube.com/watch?v=i39w-wDZZuU\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003230\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010191\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017391\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017392\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000898\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001025\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001027\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001190\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001796\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\",\"0000000018\"],\"externalIds\":{\"moviexchangeReleaseId\":\"53bcf89b-c3eb-481c-9b0e-65563daec337\",\"corporateId\":null},\"hopk\":\"HO00008205\",\"hoCode\":\"A000009298\",\"eventId\":null,\"distributorName\":\"WARNER BROS DISTRIBUTORS LTD\"},{\"id\":\"HO00008368\",\"title\":{\"text\":\"Chase Atlantic: LOST IN HEAVEN\",\"translations\":[]},\"synopsis\":{\"text\":\"Chase Atlantic: LOST IN HEAVEN is the immersive feature-length concert film showcasing one of the most legendary performances of Chase Atlantic’s career. This unique cinematic experience captures the band’s final night of their LOST IN HEAVEN European Tour at London’s O2 Arena, which followed the release of their fourth studio album of the same name on November 1, 2024.\\n\\nChase Atlantic is an Australian-born trio consisting of Mitchel Cave (lead singer), Christian Anthony (singer and guitarist) and Clinton Cave (lead guitarist and saxophone), joined on tour by their friends Jesse Boyle (drummer) and Pat Wilde (bassist and guitarist). This high energy night is the culmination of the years the band have spent perfecting their craft. \\n\\nWith over 8 billion global streams, Chase Atlantic in just a few years have grown their audiences from small crowds to numbers filling some of the largest venues in the world.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Chase Atlantic: LOST IN HEAVEN is the immersive feature-length concert film showcasing one of the most legendary performances of Chase Atlantic’s career.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-18\",\"runtimeInMinutes\":101,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000005498\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013680\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013681\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013682\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016749\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017678\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017679\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017680\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017681\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017682\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00002501\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"d90782fc-5aa7-479a-add1-d80189cc04d8\",\"corporateId\":null},\"hopk\":\"HO00008368\",\"hoCode\":\"A000009468\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000000119\",\"name\":{\"givenName\":\"David\",\"familyName\":\"Harbour\",\"middleName\":null}},{\"id\":\"0000002189\",\"name\":{\"givenName\":\"Aaron\",\"familyName\":\"Pierre\",\"middleName\":null}},{\"id\":\"0000006525\",\"name\":{\"givenName\":\"Jenifer\",\"familyName\":\"Lewis\",\"middleName\":null}},{\"id\":\"0000009120\",\"name\":{\"givenName\":\"Eduardo\",\"familyName\":\"Franco\",\"middleName\":null}},{\"id\":\"0000011153\",\"name\":{\"givenName\":\"Patton\