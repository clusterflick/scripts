          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-12\",\"showtimes\":[{\"id\":\"963-121523\",\"schedule\":{\"businessDate\":\"2026-08-12\",\"startsAt\":\"2026-08-12T19:15:00+01:00\",\"endsAt\":\"2026-08-12T21:00:00+01:00\",\"filmStartsAt\":\"2026-08-12T19:40:00+01:00\",\"filmEndsAt\":\"2026-08-12T21:00:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"963-3-172\",\"filmId\":\"HO00009195\",\"siteId\":\"963\",\"screenId\":\"963-3\",\"areaCategories\":[{\"areaCategoryId\":\"963-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000187\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"963\",\"name\":{\"text\":\"Greenwich\",\"translations\":[]},\"location\":{\"latitude\":51.4905,\"longitude\":0.0127},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Greenwich@OdeonUK.com\",\"address\":{\"line1\":\"Bugsby's Way\",\"line2\":\"Greenwich\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00009195\",\"title\":{\"text\":\"KATSEYE: WILD HEARTS\",\"translations\":[]},\"synopsis\":{\"text\":\"Two-time GRAMMY®-nominated global girl group KATSEYE is coming to cinemas worldwide with a special theatrical release ahead of their third EP, WILD.\\n\\nKATSEYE: WILD HEARTS is a captivating journey into the group's bold new era while celebrating the fans who helped make it possible. Featuring never-before-seen footage, EYEKONS fan videos, and intimate interviews from the group members, the film explores the powerful bond between KATSEYE and their global fandom. A love letter to the EYEKONS who helped build this movement, KATSEYE: WILD HEARTS reveals why this group's story is only just beginning.\\n\\nFrom the intense pressure of Dream Academy to chart-topping viral success, audiences experience the highs, setbacks, sacrifices, and breakthrough moments that transformed KATSEYE on their path to global pop stardom. Praised by outlets including The New York Times, Vogue, Rolling Stone, and Billboard, KATSEYE has earned acclaim for their relentless dedication to their craft and electrifying live performances. As one of pop's most exciting emerging global acts, the group continues to solidify its place as a worldwide force.\\n\\nFrom the same team that created Netflix’s POP STAR ACADEMY, KATSEYE: WILD HEARTS is produced by Interscope Films and Boardwalk Pictures, in partnership with HYBE X GEFFEN, and directed by Nadia Hallgren.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Two-time GRAMMY®-nominated global girl group KATSEYE is coming to cinemas worldwide with a special theatrical release ahead of their third EP, WILD.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-12\",\"runtimeInMinutes\":80,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014625\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019617\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019618\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019619\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019620\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019621\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019622\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019623\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019624\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019625\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019626\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"f96b4339-1f17-4718-a7fa-9344461b7e6c\",\"corporateId\":null},\"hopk\":\"HO00009195\",\"hoCode\":\"A000010363\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000014625\",\"name\":{\"givenName\":\"Jared\",\"familyName\":\"Shelton\",\"middleName\":null}},{\"id\":\"0000019617\",\"name\":{\"givenName\":\"Katseye\",\"familyName\":\" \",\"middleName\":null}},{\"id\":\"0000019618\",\"name\":{\"givenName\":\"Nadia\",\"familyName\":\"Hallgren\",\"middleName\":null}},{\"id\":\"0000019619\",\"name\":{\"givenName\":\"Lauren\",\"familyName\":\"Cioffi\",\"middleName\":null}},{\"id\":\"0000019620\",\"name\":{\"givenName\":\"Sarina\",\"familyName\":\"Roma\",\"middleName\":null}},{\"id\":\"0000019621\",\"name\":{\"givenName\":\"Lana\",\"familyName\":\"Barkin\",\"middleName\":null}},{\"id\":\"0000019622\",\"name\":{\"givenName\":\"Hayan\",\"familyName\":\"Park\",\"middleName\":null}},{\"id\":\"0000019623\",\"name\":{\"givenName\":\"Ihn\",\"familyName\":\" \",\"middleName\":null}},{\"id\":\"0000019624\",\"name\":{\"givenName\":\"Jay\",\"familyName\":\" \",\"middleName\":null}},{\"id\":\"0000019625\",\"name\":{\"givenName\":\"Mitra\",\"familyName\":\"Darab\",\"middleName\":null}},{\"id\":\"0000019626\",\"name\":{\"givenName\":\"Andrew\",\"familyName\":\"Ibea\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000055\",\"name\":{\"text\":\"Music\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true},{\"id\":\"0000000187\",\"name\":{\"text\":\"Flash Warning\",\"translations\":[]},\"shortName\":{\"text\":\"Flash\",\"translations\":[]},\"description\":{\"text\":\"This title has