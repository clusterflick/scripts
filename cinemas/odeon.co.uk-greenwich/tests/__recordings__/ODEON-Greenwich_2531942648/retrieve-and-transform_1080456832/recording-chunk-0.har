108816\",\"schedule\":{\"businessDate\":\"2026-02-08\",\"startsAt\":\"2026-02-08T21:30:00+00:00\",\"endsAt\":\"2026-02-08T23:26:00+00:00\",\"filmStartsAt\":\"2026-02-08T21:55:00+00:00\",\"filmEndsAt\":\"2026-02-08T23:26:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"963-2-162\",\"filmId\":\"HO00008361\",\"siteId\":\"963\",\"screenId\":\"963-2\",\"areaCategories\":[{\"areaCategoryId\":\"963-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"963\",\"name\":{\"text\":\"Greenwich\",\"translations\":[]},\"location\":{\"latitude\":51.4905,\"longitude\":0.0127},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Greenwich@OdeonUK.com\",\"address\":{\"line1\":\"Bugsby's Way\",\"line2\":\"Greenwich\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007906\",\"title\":{\"text\":\"Pets on a Train\",\"translations\":[]},\"synopsis\":{\"text\":\"When a train unexpectedly starts up, taking only pets with it, the animals discover that Hans, a badger with a grudge is behind it all. While the crash seems inevitable, the animals can count on Falcon, a roguish Raccoon who will do anything to save them.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When a train unexpectedly starts up, taking only pets with it, the animals discover that Hans, a badger with a grudge is behind it all. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat, violence\",\"translations\":[]},\"releaseDate\":\"2025-10-17\",\"runtimeInMinutes\":87,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007897\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011289\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016735\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016736\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016737\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016738\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016739\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016740\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016741\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016742\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"3418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3421\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"935c9fba-f565-4c62-b794-11566b818ecc\",\"corporateId\":null},\"hopk\":\"HO00007906\",\"hoCode\":\"A000008977\",\"eventId\":null,\"distributorName\":\"ALTITUDE\"},{\"id\":\"HO00008201\",\"title\":{\"text\":\"GOAT\",\"translations\":[]},\"synopsis\":{\"text\":\"From Sony Pictures Animation, the studio behind Spider-Man TM: Across the Spider-Verse and the artists that made KPop Demon Hunters, comes GOAT, an original action-comedy set in an all-animal world. The story follows Will, a small goat with big dreams who gets a once-in-a-lifetime shot to join the pros and play roarball–a high-intensity, co-ed, full-contact sport dominated by the fastest, fiercest animals in the world. Will’s new teammates aren’t thrilled about having a little goat on their roster, but Will is determined to revolutionize the sport and prove once and for all that “smalls can ball!”\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Sony Pictures Animation, the studio behind Spider-Man TM: Across the Spider-Verse and the artists that made KPop Demon Hunters, comes GOAT, an original action-comedy\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild violence, rude humour, language\",\"translations\":[]},\"releaseDate\":\"2026-02-13\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=kmY-rYS7yng\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000119\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002189\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006525\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009120\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011153\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011459\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017374\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017375\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017376\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017377\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017378\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017379\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017380\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017381\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017382\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017383\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017384\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"9353\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000017\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001297\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"fd3ddcc6-e405-4e1f-89d5-5330b8b46da1\",\"corporateId\":null},\"hopk\":\"HO00008201\",\"hoCode\":\"A000009293\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008282\",\"title\":{\"text\":\"LOTR: The Return Of The King - Extended Edit