          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-11-19\",\"showtimes\":[{\"id\":\"963-121127\",\"schedule\":{\"businessDate\":\"2026-11-19\",\"startsAt\":\"2026-11-19T15:45:00+00:00\",\"endsAt\":\"2026-11-19T18:26:00+00:00\",\"filmStartsAt\":\"2026-11-19T16:10:00+00:00\",\"filmEndsAt\":\"2026-11-19T18:26:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"963-12-186\",\"filmId\":\"HO00009162\",\"siteId\":\"963\",\"screenId\":\"963-12\",\"areaCategories\":[{\"areaCategoryId\":\"963-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000174\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"963-121126\",\"schedule\":{\"businessDate\":\"2026-11-19\",\"startsAt\":\"2026-11-19T19:00:00+00:00\",\"endsAt\":\"2026-11-19T21:41:00+00:00\",\"filmStartsAt\":\"2026-11-19T19:25:00+00:00\",\"filmEndsAt\":\"2026-11-19T21:41:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"963-12-186\",\"filmId\":\"HO00009162\",\"siteId\":\"963\",\"screenId\":\"963-12\",\"areaCategories\":[{\"areaCategoryId\":\"963-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"963-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000174\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"963\",\"name\":{\"text\":\"Greenwich\",\"translations\":[]},\"location\":{\"latitude\":51.4905,\"longitude\":0.0127},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Greenwich@OdeonUK.com\",\"address\":{\"line1\":\"Bugsby's Way\",\"line2\":\"Greenwich\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00009162\",\"title\":{\"text\":\"GIANT – The Play \",\"translations\":[]},\"synopsis\":{\"text\":\"GIANT, the 5-star critically acclaimed play starring John Lithgow (Killers of the Flower Moon, The Crown) as Roald Dahl, comes to the big screen. Winner of 3 Olivier Awards® including Best Play and a Tony Award® for Best Actor in a Play (John Lithgow), the production was filmed live in London’s West End ahead of its sold-out Broadway run. The stellar cast includes Aya Cash (The Boys, The Franchise, You’re the Worst), Elliot Levey (Cold War, Patriots, Good) and Rachael Stirling (The Divine Mrs S).\\n\\nA world-famous children’s author under threat. A battle of wills in the wake of scandal. And one chance to make amends...It’s the summer of 1983, The Witches is about to hit the shelves and Roald Dahl is making last-minute edits.  But the outcry at his recent, explicitly antisemitic article won’t die down. Across a single afternoon at his family home, and rocked by an unexpectedly explosive confrontation, Dahl is forced to choose: make a public apology or risk his name and reputation. Inspired by real events, GIANT explores with dark humour the difference between considered opinion and dangerous rhetoric offering a complicated portrait of a fiendishly charismatic icon. \\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A world-famous children’s author under threat. A battle of wills in the wake of scandal. And one chance to make amends...\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-11-19\",\"runtimeInMinutes\":136,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007372\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019519\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019520\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000446\",\"roles\