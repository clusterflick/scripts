            "text": "{\"businessDate\":\"2026-03-31\",\"showtimes\":[{\"id\":\"CAM1-38254\",\"schedule\":{\"businessDate\":\"2026-03-31\",\"startsAt\":\"2026-03-31T11:00:00+01:00\",\"endsAt\":\"2026-03-31T12:45:00+01:00\",\"filmStartsAt\":\"2026-03-31T11:25:00+01:00\",\"filmEndsAt\":\"2026-03-31T12:45:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-4-9\",\"filmId\":\"HO00006736\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-4\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000048\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"CAM1\",\"name\":{\"text\":\"Camden\",\"translations\":[]},\"location\":{\"latitude\":51.5423,\"longitude\":-0.1434},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Dockray Place,\",\"line2\":\"London,\",\"city\":\"NW1 8QD\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006736\",\"title\":{\"text\":\"Strongroom\",\"translations\":[]},\"synopsis\":{\"text\":\"Taut as a drum, Vernon Sewell\u2019s rediscovered and remastered suspense thriller is an outstanding example of the lean British \u2018B\u2019 film, and counts the likes of Quentin Tarantino, Martin Scorsese and Edgar Wright amongst its fans.\\r\\n\\r\\nA carefully planned heist on a suburban bank goes awry, and the bank manager and his secretary are locked in an airtight vault. With only 12 hours\u2019 worth of air in the vault, the clock is ticking.\\r\\n\\r\\nSilver Screen: These screenings provide an inclusive and enjoyable cinema experience for senior citizens, where we will be showing classic films as well as recent releases.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-03-30\",\"runtimeInMinutes\":80,\"trailerUrl\":null,\"displayPr