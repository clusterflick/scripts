000008295\"},{\"castAndCrewMemberId\":\"0000013432\"}],\"genreIds\":[\"0000000035\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b5e73a92-33c7-439c-b1d5-e8b523c75cfc\",\"corporateId\":null},\"hopk\":\"HO00006852\",\"hoCode\":\"A000008449\",\"eventId\":null,\"distributorName\":\"Sony Pictures\"},{\"id\":\"HO00006931\",\"title\":{\"text\":\"Disclosure Day\",\"translations\":[]},\"synopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming close to … Disclosure Day.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-10\",\"runtimeInMinutes\":145,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/920be864-1bc7-4cfd-aa64-b828b3c90b38/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=pFz8czbdPdU\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=pFz8czbdPdU\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000341\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001072\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002138\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000002139\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008293\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013627\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000341\"},{\"castAndCrewMemberId\":\"0000000418\"},{\"castAndCrewMemberId\":\"0000001072\"},{\"castAndCrewMemberId\":\"0000008293\"},{\"castAndCrewMemberId\"