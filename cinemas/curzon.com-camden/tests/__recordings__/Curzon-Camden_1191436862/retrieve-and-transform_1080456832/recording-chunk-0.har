550\",\"title\":{\"text\":\"Train Dreams\",\"translations\":[]},\"synopsis\":{\"text\":\"Based on the beloved novella by Denis Johnson, Train Dreams is the moving portrait of Robert Grainier (Edgerton), whose life unfolds during an era of unprecedented change in early 20th-century America.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Based on the beloved novella by Denis Johnson, Train Dreams is the moving portrait of Robert Grainier (Edgerton), whose life unfolds during an era of unprecedented change\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"moderate violence, threat, sex\",\"translations\":[]},\"releaseDate\":\"2025-11-07\",\"runtimeInMinutes\":102,\"trailerUrl\":null,\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000161\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001039\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001516\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006665\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008151\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008438\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009524\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009528\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011787\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012514\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012515\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012516\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"85f2ffb9-a3e6-437c-b922-52ecdaa5292b\",\"corporateId\":null},\"hopk\":\"HO00006550\",\"hoCode\":\"A000008091\",\"eventId\":null,\"distributorName\":\"Black Bear\"},{\"id\":\"HO00006677\",\"title\":{\"text\":\"Hamnet\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award\u00ae winning writer/director Chlo\u00e9 Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare\u2019s timeless masterpiece, Hamlet.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award\u00ae winning writer/director Chlo\u00e9 Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare\u2019s timeless masterpiece, Hamlet.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"distressing scenes, brief moderate sex\",\"translations\":[]},\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":126,\"trailerUrl\":\"https://www.youtube.com/watch?v=Y9Tv9wGPxIw\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000175\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001040\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001087\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002138\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002310\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004702\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004703\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005314\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007765\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c566d7dc-50bb-4d55-984b-c4c65751933e\",\"corporateId\":null},\"hopk\":\"HO00006677\",\"hoCode\":\"A000008241\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006687\",\"title\":{\"text\":\"The History of Sound\",\"translations\":[]},\"synopsis\":{\"text\":\"In 1917, Lionel \u2014 a young, talented music student \u2014 meets David at the Boston Conservatory, where they bond over a deep love of folk music. Years later, Lionel receives a letter from David, leading to an impromptu journey through the backwoods of Maine to collect traditional songs. This unexpected reunion, ensuing love affair, and the music they collect and preserve, will shape the course of Lionel\u2019s life far beyond his own awareness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Two young men during World War I set out to record the lives, voices and music of their American countrymen.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"brief strong sex\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":128,\"trailerUrl\":\"https://www.youtube.com/watch?v=E2PSkw8BI7k\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002283\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002310\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004336\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000007164\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007677\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008293\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012816\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012817\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012818\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012819\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012820\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012821\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012822\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c8ef0b42-7ed8-4ee1-9534-85771b63b7fc\",\"corporateId\":null},\"hopk\":\"HO00006687\",\"hoCode\":\"A000008252\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006689\",\"title\":{\"text\":\"No Other Choice\",\"translations\":[]},\"synopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After being une