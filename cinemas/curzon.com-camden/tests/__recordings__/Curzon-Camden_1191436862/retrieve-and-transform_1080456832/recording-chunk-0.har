            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-09-20\",\"showtimes\":[{\"id\":\"CAM1-43293\",\"schedule\":{\"businessDate\":\"2026-09-20\",\"startsAt\":\"2026-09-20T15:00:00+01:00\",\"endsAt\":\"2026-09-20T17:24:00+01:00\",\"filmStartsAt\":\"2026-09-20T15:25:00+01:00\",\"filmEndsAt\":\"2026-09-20T17:24:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-5-10\",\"filmId\":\"HO00007229\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-5\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"CAM1\",\"name\":{\"text\":\"Camden\",\"translations\":[]},\"location\":{\"latitude\":51.5423011779785,\"longitude\":-0.143399998545647},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"CAM1@curzon.com\",\"address\":{\"line1\":\"Dockray Place,\",\"line2\":\"London,\",\"city\":\"NW1 8QD\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007229\",\"title\":{\"text\":\"Curzon Film 50: Only You\",\"translations\":[]},\"synopsis\":{\"text\":\"Elena (Laia Costa), 35, and Jake (Josh O'Connor), 26, meet by chance on New Year's Eve, fighting for the same taxi. But, instead of going their separate ways after a shared ride, they start a passionate relationship. Within weeks they are living together, and not long after they talk about starting a family.\\n\\nBut, as the seasons' pass, reality catches up with them. Falling in love was the easy part, but can they remain in love when life doesn’t give them everything they hoped for?\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Elena and Jake meet by chance on New Years' Eve, arguing for the same taxi, and start a passionate relationship.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\