            "text": "{\"businessDate\":\"2026-07-23\",\"showtimes\":[{\"id\":\"CAM1-42480\",\"schedule\":{\"businessDate\":\"2026-07-23\",\"startsAt\":\"2026-07-23T12:00:00+01:00\",\"endsAt\":\"2026-07-23T15:17:00+01:00\",\"filmStartsAt\":\"2026-07-23T12:25:00+01:00\",\"filmEndsAt\":\"2026-07-23T15:17:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-1-6\",\"filmId\":\"HO00007116\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-1\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"CAM1-130-HO00007116\"},{\"id\":\"CAM1-42479\",\"schedule\":{\"businessDate\":\"2026-07-23\",\"startsAt\":\"2026-07-23T15:30:00+01:00\",\"endsAt\":\"2026-07-23T18:47:00+01:00\",\"filmStartsAt\":\"2026-07-23T15:55:00+01:00\",\"filmEndsAt\":\"2026-07-23T18:47:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-1-6\",\"filmId\":\"HO00007116\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-1\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"CAM1-130-HO00007116\"},{\"id\":\"CAM1-42478\",\"schedule\":{\"businessDate\":\"2026-07-23\",\"startsAt\":\"2026-07-23T19:00:00+01:00\",\"endsAt\":\"2026-07-23T22:17:00+01:00\",\"filmStartsAt\":\"2026-07-23T19:25:00+01:00\",\"filmEndsAt\":\"2026-07-23T22:17:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-1-6\",\"filmId\":\"HO00007116\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-1\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"CAM1-130-HO00007116\"}],\"relatedData\":{\"sites\":[{\"id\":\"CAM1\",\"name\":{\"text\":\"Camden\",\"translations\":[]},\"location\":{\"latitude\":51.5423011779785,\"longitude\":-0.143399998545647},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"CAM1@curzon.com\",\"address\":{\"line1\":\"Dockray Place,\",\"line2\":\"London,\",\"city\":\"NW1 8QD\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007116\",\"title\":{\"text\":\"The Odyssey\",\"translations\":[]},\"synopsis\":{\"text\":\"Legendary filmmaker Christopher Nolan follows up his Oscar-winning sensation Oppenheimer with another rousing epic, The Odyssey, whose all-star cast includes Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson, Lupita Nyong'o, Zendaya and Charlize Theron.\\n\\nThis mythic action movie recounts the story of Odysseus (Damon) on his perilous journey home, troubled by gods and monsters. Meanwhile, his wife Penelope (Hathaway) and son Telemachus (Holland) fight to hold their kingdom together against relentless suitors.\\n\\nSee it on 35mm film at Soho, and enjoy it with Dolby Atmos sound at Bloomsbury, Canterbury Riverside and Kingston.\\n\\nTHE ODYSSEY MIDNIGHT SCREENINGS\\nThe film will start promptly at 12:01am on Thursday night. Please ensure you are seated by midnight.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":172,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/b3ff6b75-3025-43b7-88a5-37fc8c43d313/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\