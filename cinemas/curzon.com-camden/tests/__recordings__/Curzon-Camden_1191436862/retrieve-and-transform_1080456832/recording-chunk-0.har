          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-07-25\",\"showtimes\":[{\"id\":\"CAM1-42990\",\"schedule\":{\"businessDate\":\"2026-07-25\",\"startsAt\":\"2026-07-25T10:30:00+01:00\",\"endsAt\":\"2026-07-25T12:33:00+01:00\",\"filmStartsAt\":\"2026-07-25T10:55:00+01:00\",\"filmEndsAt\":\"2026-07-25T12:33:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-4-9\",\"filmId\":\"HO00007209\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-4\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000004\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"CAM1-119-HO00007209\"}],\"relatedData\":{\"sites\":[{\"id\":\"CAM1\",\"name\":{\"text\":\"Camden\",\"translations\":[]},\"location\":{\"latitude\":51.5423011779785,\"longitude\":-0.143399998545647},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"CAM1@curzon.com\",\"address\":{\"line1\":\"Dockray Place,\",\"line2\":\"London,\",\"city\":\"NW1 8QD\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007209\",\"title\":{\"text\":\"Kids Club: The Super Mario Galaxy Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"The Super Mario Galaxy Movie is an animated film based on the world of Super Mario Bros., and follows The Super Mario Bros. Movie, which was released in 2023 and earned more than $1.3 billion worldwide. Both the 2023 film and The Super Mario Galaxy Movie are produced by Chris Meledandri of Illumination and Shigeru Miyamoto of Nintendo.\\n\\nThe film will be co-financed by Universal Pictures and Nintendo and will be released worldwide by Universal Pictures.\\n\\nThe Super Mario Galaxy Movie is directed by returning filmmakers Aaron Horvath and Michael Jelenic, from a screenplay by returning screenwriter Matthew Fogel, with Brian Tyler returning to compose the score.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Super Mario Galaxy Movie is an animated film based on the world of Super Mario Bros., and follows The Super Mario Bros. Movie, which was released in 2023. \",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-04-01\",\"runtimeInMinutes\":98,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/ed1e08fa-8624-4161-83bf-0ec0e273ff84/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=DDZkObBBV5w\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=DDZkObBBV5w\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001793\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002278\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003139\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005354\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005358\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005359\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005360\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005361\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005675\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013512\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000351\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001793\"},{\"castAndCrewMemberId\":\"0000002278\"},{\"castAndCrewMemberId\":\"0000003139\"},{\"castAndCrewMemberId\":\"0000005354\"},{\"castAndCrewMemberId\":\"0000005355\"},{\"castAndCrewMemberId\":\"0000005358\"},{\"castAndCrewMemberId\":\"0000005675\"},{\"castAndCrewMemberId\":\"HO00000351\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000005359\"},{\"castAndCrewMemberId\":\"0000005360\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000005361\"},{\"castAndCrewMemberI