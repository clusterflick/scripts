            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-31\",\"showtimes\":[{\"id\":\"CAM1-43290\",\"schedule\":{\"businessDate\":\"2026-08-31\",\"startsAt\":\"2026-08-31T15:00:00+01:00\",\"endsAt\":\"2026-08-31T16:55:00+01:00\",\"filmStartsAt\":\"2026-08-31T15:25:00+01:00\",\"filmEndsAt\":\"2026-08-31T16:55:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-5-10\",\"filmId\":\"HO00007231\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-5\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"CAM1\",\"name\":{\"text\":\"Camden\",\"translations\":[]},\"location\":{\"latitude\":51.5423011779785,\"longitude\":-0.143399998545647},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"CAM1@curzon.com\",\"address\":{\"line1\":\"Dockray Place,\",\"line2\":\"London,\",\"city\":\"NW1 8QD\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007231\",\"title\":{\"text\":\"Curzon Film 50: Orlando\",\"translations\":[]},\"synopsis\":{\"text\":\"In 1600, nobleman Orlando (Tilda Swinton) inherits his parents' house, thanks to Queen Elizabeth I (Quentin Crisp), who commands the young man to never change. After a disastrous affair with Russian princess Sasha (Charlotte Valandrey), Orlando looks for solace in the arts before being appointed ambassador to Constantinople in 1700, where war is raging. One morning, Orlando is shocked to wake up as a woman and returns home, struggling as a female to retain her property as the centuries roll by.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After Queen Elizabeth I commands him not to grow old, a young nobleman struggles with love and his place in the world.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":90,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000198\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011174\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011175\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011176\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011178\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011179\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000198\"},{\"castAndCrewMemberId\":\"0000011174\"},{\"castAndCrewMemberId\":\"0000011175\"},{\"castAndCrewMemberId\":\"0000011176\"},{\"castAndCrewMemberId\":\"0000011177\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000011178\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000011179\"}],\"genreIds\":[\"0000000002\",\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007231\",\"hoCode\":\"A000008896\",\"eventId\":\"0000000068\",\"distributorName\":\"Curzon\"}],\"castAndCrew\":[{\"id\":\"0000000198\",\"name\":{\"givenName\":\"Tilda\",\"familyName\":\"Swinton\",\"middleName\":null}},{\"id\":\"0000011174\",\"name\":{\"givenName\":\"Quentin\",\"familyName\":\"Crisp\",\"middleName\":null}},{\"id\":\"0000011175\",\"name\":{\"givenName\":\"Jimmy\",\"familyName\":\"Somerville\",\"middleName\":null}},{\"id\":\"0000011176\",\"name\":{\"givenName\":\"John\",\"familyName\":\"Bott\",\"middleName\":null}},{\"id\":\"0000011177\",\"name\":{\"givenName\":\"Elaine\",\"familyName\":\"Banham\",\"middleName\":null}},{\"id\":\"0000011178\",\"name\":{\"givenName\":\"Sally\",\"familyName\":\"Potter\",\"middleName\":null}},{\"id\":\"0000011179\",\"name\":{\"givenName\":\"Christopher\",\"familyName\":\"Sheppard\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"