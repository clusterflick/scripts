            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-03-05\",\"showtimes\":[{\"id\":\"CAM1-39303\",\"schedule\":{\"businessDate\":\"2026-03-05\",\"startsAt\":\"2026-03-05T18:00:00+00:00\",\"endsAt\":\"2026-03-05T20:25:00+00:00\",\"filmStartsAt\":\"2026-03-05T18:25:00+00:00\",\"filmEndsAt\":\"2026-03-05T20:25:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-5-10\",\"filmId\":\"HO00006806\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-5\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"CAM1\",\"name\":{\"text\":\"Camden\",\"translations\":[]},\"location\":{\"latitude\":51.5423,\"longitude\":-0.1434},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Dockray Place,\",\"line2\":\"London,\",\"city\":\"NW1 8QD\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006806\",\"title\":{\"text\":\"Film Club: The Love Witch\",\"translations\":[]},\"synopsis\":{\"text\":\"Elaine, a beautiful young witch, is determined to find a man to love her. In her gothic Victorian apartment she makes spells and potions, and then picks up men and seduces them. However her spells work too well, and she ends up with a string of hapless victims. When she finally meets the man of her dreams, her desperation to be loved will drive her to the brink of insanity and murder. With a visual style that pays tribute to Technicolor thrillers of the 1960s, THE LOVE WITCH explores female fantasy and the repercussions of pathological narcissism.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Elaine, a beautiful young witch, is determined to find a man to love her. In her gothic Victorian apartment, she makes spells and potions and then picks up men.\",\"translations\":[]},\"censorRatingId\":\"HO00