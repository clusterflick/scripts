063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007210\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011162\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011923\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12808\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12809\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12810\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e033d58e-8545-4f81-a191-03352ebe4cc0\",\"corporateId\":null},\"hopk\":\"HO00006609\",\"hoCode\":\"A000008158\",\"eventId\":null,\"distributorName\":\"Entertainment Film Distributors\"},{\"id\":\"HO00006610\",\"title\":{\"text\":\"Sentimental Value\",\"translations\":[]},\"synopsis\":{\"text\":\"Nora Borg (Renate Reinsve) is an established Oslo stage actress; her younger sister Agnes (Inga Ibsdotter Lilleaas) has chosen family life with her young son. Though markedly different, the two are close and deeply intertwined, having been raised by a single mother after their filmmaker father\u2019s departure years earlier. When the once renowned Gustav (Stellan Skarsg\u00e5rd) attempts to cast Nora in his comeback film, old wounds bleed anew; \\\"Nora rejects his offer, prompting the isolated patriarch to cast American star Rachel Kemp (Elle Fanning), who gradually comes to realize she has unwittingly become part of a deeply personal film drama. Agnes, meanwhile, delves deeper into the family history as Gustav and Nora attempt rapprochement; but the cracks at the base of the family home run deeper than any Borg can grasp, threatening to topple an already shaky foundation.\\r\\n\\r\\nThis special preview is presented in partnership with The Observer and will feature a post-film conversation between film critic Wendy Ide and leading actor Stellan Skarsg\u00e5rd.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Sisters Nora and Agnes reunite with their estranged father, the charismatic Gustav, a once renowned director who offers stage actress Nora a role.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, suicide references\",\"translations\":[]},\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":133,\"trailerUrl\":\"https://www.youtube.com/watch?v=Gb1sSfWb1Og\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001057\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001058\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001695\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002275\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002626\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002629\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002630\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003236\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008105\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012671\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012672\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012673\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012674\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"938\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5b779d8b-e80b-4790-9616-e4b978f19314\",\"corporateId\":null},\"hopk\":\"HO00006610\",\"hoCode\":\"A000008159\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00006487\",\"title\":{\"text\":\"Frankenstein\",\"translations\":[]},\"synopsis\":{\"text\":\"Oscar-winning director Guillermo del Toro adapts Mary Shelley\u2019s classic tale of Victor Frankenstein, a brilliant but egotistical scientist who brings a creature to life in a monstrous experiment that ultimately leads to the undoing of both the creator and his tragic creation.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Oscar-winning director Guillermo del Toro adapts Mary Shelley\u2019s classic tale of Victor Frankenstein, a brilliant but egotistical scientist who brings a creature to life.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2025-10-17\",\"runtimeInMinutes\":149,\"trailerUrl\":\"https://www.youtube.com/watch?v=8aulMPhE12g\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001390\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001691\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001807\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001808\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002829\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004507\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004991\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007272\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012258\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"4354\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000663\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\",\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dfd152fe-b4d2-44c5-b45e-19aa59a95a7c\",\"corporateId\":null},\"hopk\":\"HO00006487\",\"hoCode\":\"A000008018\",\"eventId\":null,\"distributorName\":\"Netflix\"},{\"id\":\"HO00005906\",\"title\":{\"text\":\"Kids Club: The Wild Robot\",\"translations\":[]},\"synopsis\":{\"text\":\"The Wild Robot\u201d follows Rozzum 7134 (\u201cRoz\u201d for short), a futuristic robot that washes ashore on a deserted island. A tale of survival and discovery begins when she becomes the unexpected protector to an orphaned gosling, which she names Brightbill. Together they struggle to survive the harsh environment, but only succeed with the help of a close-knit group of misfit animals, who become first friends, then family. Ultimately Roz and company save the island from a robotic invasion by Roz\u2019s manufacturer, looking to bring her back to civilization by any means necessary.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Wild Robot\u201d follows Rozzum 7134 (\u201cRoz\u201d for short), a futuristic robot that washes ashore on a deserted island. A tale of survival and discovery begins. \",\"translations\":[]},\"censorRatingId\":\"HO00000001\",\"censorRatingNote\":{\"text\":\"very mild threat, violence, language, rude humour\",\"translations\":[]},\"releaseDate\":\"2026-01-31\",\"runtimeInMinutes\":102,\"trailerUrl\":\"https://www.youtube.com/watch?v=N3oENyzAIiw\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000004\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002970\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003221\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003850\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005623\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005717\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005734\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008070\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010015\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010016\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000010017\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000007\",\"0000000025\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c9115cd6-8b01-4ea2-8e14-a07923f5457d\",\"corporateId\":null},\"hopk\":\"HO00005906\",\"hoCode\":\"A000007287\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"}],\"castAndCrew\":[{\"id\":\"0000000161\",\"name\":{\"givenName\":\"Will\",\"familyName\":\"Patton\",\"middleName\":null}},{\"id\":\"0000001039\",\"name\":{\"givenName\":\"Felicity\",\"familyName\":\"Jones\",\"middleName\":null}},{\"id\":\"0000001516\",\"name\":{\"givenName\":\"Joel\",\"familyName\":\"Edgerton\",\"middleName\":null}},{\"id\":\"0000004240\",\"name\":{\"givenName\":\"Kerry\",\"familyName\":\"