\":\"0000012857\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"8ddd1648-0036-4a88-99b9-4b2eb84d4838\",\"corporateId\":null},\"hopk\":\"HO00006693\",\"hoCode\":\"A000008259\",\"eventId\":null,\"distributorName\":\"Altitude Film Distribution\"},{\"id\":\"HO00006609\",\"title\":{\"text\":\"Marty Supreme\",\"translations\":[]},\"synopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":149,\"trailerUrl\":\"https://www.youtube.com/watch?v=PNDVyJU99M0\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001403\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001416\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002090\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003985\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003988\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000007063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007210\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011162\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011923\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12808\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12809\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12810\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e033d58e-8545-4f81-a191-03352ebe4cc0\",\"corporateId\":null},\"hopk\":\"HO00006609\",\"hoCode\":\"A000008158\",\"eventId\":null,\"distributorName\":\"Entertainment Film Distributors\"},{\"id\":\"HO00006610\",\"title\":{\"text\":\"Sentimental Value\",\"translations\":[]},\"synopsis\":{\"text\":\"Nora Borg (Renate Reinsve) is an established Oslo stage actress; her younger sister Agnes (Inga Ibsdotter Lilleaas) has chosen family life with her young son. Though markedly different, the two are close and deeply intertwined, having been raised by a single mother after their filmmaker father’s departure years earlier. When the once renowned Gustav (Stellan Skarsgård) attempts to cast Nora in his comeback film, old wounds bleed anew; \\\"Nora rejects his offer, prompting the isolated patriarch to cast American star Rachel Kemp (Elle Fanning), who gradually comes to realize she has unwittingly become part of a deeply personal film drama. Agnes, meanwhile, delves deeper into the family history as Gustav and Nora attempt rapprochement; but the cracks at the base of the family home run deeper than any Borg can grasp, threatening to topple an already shaky foundation.\\r\\n\\r\\nThis special preview is presented in partnership with The Observer and will feature a post-film conversation between film critic Wendy Ide and leading actor Stellan Skarsgård.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Sisters Nora and Agnes reunite with their estranged father, the charismatic Gustav, a once renowned director who offers stage actress Nora a role.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, suicide references\",\"translations\":[]},\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":133,\"trailerUrl\":\"https://www.youtube.com/watch?v=Gb1sSfWb1Og\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001057\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001058\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001695\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002275\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002626\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002629\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002630\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003236\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008105\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012671\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012672\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012673\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012674\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"938\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5b779d8b-e80b-4790-9616-e4b978f19314\",\"corporateId\":null},\"hopk\":\"HO00006610\",\"hoCode\":\"A000008159\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00006487\",\"title\":{\"text\":\"Frankenstein\",\"translations\":[]},\"synopsis\":{\"text\":\"Oscar-winning director Guillermo del Toro adapts Mary Shelley’s classic tale of Victor Frankenstein, a brilliant but egotistical scientist who brings a creature to life in a monstrous experiment that ultimately leads to the undoing of both the creator and his tragic creation.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Oscar-winning director Guillermo del Toro adapts Mary Shelley’s classic tale of Victor Frankenstein, a brilliant but egotistical scientist who brings a creature to life.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2025-10-17\",\"runtimeInMinutes\":149,\"trailerUrl\":\"https://www.youtube.com/watch?v=8aulMPhE12g\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001390\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001691\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001807\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001808\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"00000028