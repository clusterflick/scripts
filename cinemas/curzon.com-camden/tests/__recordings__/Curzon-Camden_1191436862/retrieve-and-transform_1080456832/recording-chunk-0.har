          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-07-28\",\"showtimes\":[{\"id\":\"CAM1-43108\",\"schedule\":{\"businessDate\":\"2026-07-28\",\"startsAt\":\"2026-07-28T11:00:00+01:00\",\"endsAt\":\"2026-07-28T12:55:00+01:00\",\"filmStartsAt\":\"2026-07-28T11:25:00+01:00\",\"filmEndsAt\":\"2026-07-28T12:55:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-4-9\",\"filmId\":\"HO00002081\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-4\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000048\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"CAM1-2-HO00002081\"},{\"id\":\"CAM1-42710\",\"schedule\":{\"businessDate\":\"2026-07-28\",\"startsAt\":\"2026-07-28T21:20:00+01:00\",\"endsAt\":\"2026-07-28T23:15:00+01:00\",\"filmStartsAt\":\"2026-07-28T21:45:00+01:00\",\"filmEndsAt\":\"2026-07-28T23:15:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-5-10\",\"filmId\":\"HO00007181\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-5\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000017\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"CAM1\",\"name\":{\"text\":\"Camden\",\"translations\":[]},\"location\":{\"latitude\":51.5423011779785,\"longitude\":-0.143399998545647},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"CAM1@curzon.com\",\"address\":{\"line1\":\"Dockray Place,\",\"line2\":\"London,\",\"city\":\"NW1 8QD\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00002081\",\"title\":{\"text\":\"Orlando\",\"translations\":[]},\"synopsis\":{\"text\":\"In 1600, nobleman Orlando (Tilda Swinton) inherits his parents' house, thanks to Queen Elizabeth I (Quentin Crisp), who commands the young man to never change. After a disastrous affair with Russian princess Sasha (Charlotte Valandrey), Orlando looks for solace in the arts before being appointed ambassador to Constantinople in 1700, where war is raging. One morning, Orlando is shocked to wake up as a woman and returns home, struggling as a female to retain her property as the centuries roll by.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After Queen Elizabeth I commands him not to grow old, a young nobleman struggles with love and his place in the world.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"1993-03-12\",\"runtimeInMinutes\":90,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000198\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011174\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011175\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011176\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011178\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011179\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000198\"},{\"castAndCrewMemberId\":\"0000011174\"},{\"castAndCrewMemberId\":\"0000011175\"},{\"castAndCrewMemberId\":\"0000011176\"},{\"castAndCrewMemberId\":\"0000011177\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000011178\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000011179\"}],\"genreIds\":[\"0000000002\",\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4821c3e3-21a2-48f0-9f4c-cc3f68486ea6\",\"corporateId\":null},\"hopk\":\"HO00002081\",\"hoCode\":\"A000002671\",\"eventId\":null,\"distributorName\":\"Curzon\"},{\"id\":\"HO00007181\",\"title\":{\"text\":\"WHAM! 10 Days in China\",\"translations\":[]},\"synopsis\":{\"text\":\"In 1985, WHAM! made history as the first Western pop act to perform in communist China. George Michael and Andrew Ridgeley’s concerts in Beijing and Guangzhou were a cultural milestone – East meets West, music meets politics. Now, newly restored footage reveals the untold story of the iconic tour that helped launch WHAM! to global superstardom.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In 1985, WHAM! crossed cultural divides as the first Western pop act in China. Previously unseen, beautifully restored archive footage reveals this landmark meeting\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-28\",\"runtimeInMinutes\":90,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=P7oAaJqqv8w\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=P7oAaJqqv8w\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000006189\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006191\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014237\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014238\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000006189\"},{\"castAndCrewMemberId\":\"0000006191\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000014237\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000014238\"}],\"genreIds\":[\"0000000006\",\"0000000031\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2cf0e845-3544-444c-b11e-50d2bfd4d480\",\"corporateId\":null},\"hopk\":\"HO00007181\",\"hoCode\":\"A000008836\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000198\",\"name\":{\"givenName\":\"Tilda\",\"familyName\":\"Swinton\",\"middleName\":null}},{\"id\":\"0000011174\",\"name\":{\"givenName\":\"Quentin\",\"familyName\":\"Crisp\",\"middleName\":null}},{\"id\":\"0000011175\",\"name\":{\"givenName\":\"Jimmy\",\"familyName\":\"Somerville\",\"middleName\":null}},{\"id\":\"0000011176\",\"name\":{\"givenName