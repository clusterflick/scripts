relatedData\":{\"sites\":[{\"id\":\"CAM1\",\"name\":{\"text\":\"Camden\",\"translations\":[]},\"location\":{\"latitude\":51.5423011779785,\"longitude\":-0.143399998545647},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"CAM1@curzon.com\",\"address\":{\"line1\":\"Dockray Place,\",\"line2\":\"London,\",\"city\":\"NW1 8QD\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00006852\",\"title\":{\"text\":\"Project Hail Mary\",\"translations\":[]},\"synopsis\":{\"text\":\"Science teacher Ryland Grace (Ryan Gosling) wakes up on a spaceship light years from home with no recollection of who he is or how he got there. As his memory returns, he begins to uncover his mission: solve the riddle of the mysterious substance causing the sun to die out. He must call on his scientific knowledge and unorthodox ideas to save everything on Earth from extinction… but an unexpected friendship means he may not have to do it alone.\\n\\nCUSTOMER NOTICE: Contains a sequence of flashing lights which might affect customers who are susceptible to photosensitive epilepsy.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Science teacher Ryland Grace (Ryan Gosling) wakes up on a spaceship light years from home with no recollection of who he is or how he got there.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-03-20\",\"runtimeInMinutes\":156,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/b5e73a92-33c7-439c-b1d5-e8b523c75cfc/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=3wGFc00i-C0\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=3wGFc00i-C0\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000782\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000865\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001708\",\"role