            "text": "{\"businessDate\":\"2026-06-25\",\"showtimes\":[{\"id\":\"CAM1-37874\",\"schedule\":{\"businessDate\":\"2026-06-25\",\"startsAt\":\"2026-06-25T19:00:00+01:00\",\"endsAt\":\"2026-06-25T22:25:00+01:00\",\"filmStartsAt\":\"2026-06-25T19:25:00+01:00\",\"filmEndsAt\":\"2026-06-25T22:25:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-5-10\",\"filmId\":\"HO00006721\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-5\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000031\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"CAM1\",\"name\":{\"text\":\"Camden\",\"translations\":[]},\"location\":{\"latitude\":51.5423,\"longitude\":-0.1434},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Dockray Place,\",\"line2\":\"London,\",\"city\":\"NW1 8QD\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006721\",\"title\":{\"text\":\"NT Live: Les Liaisons Dangereuses\",\"translations\":[]},\"synopsis\":{\"text\":\"BAFTA Award-winner Lesley Manville (Phantom Thread) joins Aidan Turner (Rivals) in a striking new staging of Christopher Hampton\u2019s celebrated adaptation of the classic novel, where among the glittering salons of the super-rich, one misstep can mean ruin. Marquise de Merteuil is a master in the art of survival. Alongside the magnetic Vicomte de Valmont, they turn seduction into strategy and weaponise desire. But when their alliance collapses into rivalry, the battle between them threatens to destroy everyone in their path. Filmed live on stage at the National Theatre, Marianne Elliott (Angels in America) directs this thrilling game of love, lies, and social warfare.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Lesley Manville joins Aidan Turner in a striking new staging of Christopher Hampton\u2019s celebrated adaptation of the classic novel.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-25\",\"runtimeInMinutes\":180,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003188\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004040\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011132\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012992\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"54e0dbe8-e589-43c5-bf21-f7b8fbd1d66e\",\"corporateId\":null},\"hopk\":\"HO00006721\",\"hoCode\":\"A000008294\",\"eventId\":\"0000000031\",\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"0000003188\",\"name\":{\"givenName\":\"Monica\",\"familyName\":\"Barbaro\",\"middleName\":null}},{\"id\":\"0000004040\",\"name\":{\"givenName\":\"Lesley\",\"familyName\":\"Manville\",\"middleName\":null}},{\"id\":\"0000011132\",\"name\":{\"givenName\":\"Marianne\",\"familyName\":\"Elliott\",\"middleName\":null}},{\"id\":\"0000012992\",\"name\":{\"givenName\":\"Aidan\",\"familyName\":\"Turner\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[],\"screens\":[{\"id\":\"CAM1-5\",\"name\":{\"text\":\"N14\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000031\",\"name\":{\"text\":\"NT Live\",\"translations\":[]},\"shortName\":{\"text\":\"NT Live\",\"translations\":[]},\"description\":{\"text\":\"National Theatre Live brings the best of British theatre to cinema screens across the UK and around the world. With state-of-the-art filming techniques, tailored to every play, we bring you each performance as it happens, in all its glory. From close-ups that capture every flicker of emotion, to sweeping wide shots of the stage. Whether you come along to the live broadcast, or catch one of many replays, you\u2019ll have the best seats in the house.\",\"translations\":[]},\"schedule\":{\"startDate\":\"2024-01-01\",\"endDate\":\"2099-12-31\"},\"siteIds\":[\"ALD1\",\"BLO1\",\"CAM1\",\"CAN01\",\"CAN2\",\"COL1\",\"HOX1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SHE1\",\"SOH1\",\"VIC1\",\"WIM01\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"CAM1-0000000002\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
