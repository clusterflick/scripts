            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-09-27\",\"showtimes\":[{\"id\":\"CAM1-43294\",\"schedule\":{\"businessDate\":\"2026-09-27\",\"startsAt\":\"2026-09-27T15:00:00+01:00\",\"endsAt\":\"2026-09-27T17:14:00+01:00\",\"filmStartsAt\":\"2026-09-27T15:25:00+01:00\",\"filmEndsAt\":\"2026-09-27T17:14:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-5-10\",\"filmId\":\"HO00007243\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-5\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"CAM1\",\"name\":{\"text\":\"Camden\",\"translations\":[]},\"location\":{\"latitude\":51.5423011779785,\"longitude\":-0.143399998545647},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"CAM1@curzon.com\",\"address\":{\"line1\":\"Dockray Place,\",\"line2\":\"London,\",\"city\":\"NW1 8QD\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007243\",\"title\":{\"text\":\"Curzon Film 50: We Need To Talk About Kevin\",\"translations\":[]},\"synopsis\":{\"text\":\"Eva has put her career and ambitions aside to give birth to Kevin. The relationship between mother and son is difficult from the very start. When Kevin is 15, he does something irrational and unforgivable in the eyes of the entire community. Eva grapples with her own feelings of grief and responsibility. Did she ever love her son? And how much of what Kevin did was her fault?\\n\\nBased on the Orange Prize winning novel by Lionel Shriver, We Need to Talk About Kevin is a gripping psychological thriller directed by acclaimed filmmaker Lynne Ramsay (Ratcatcher, Morvern Callar), featuring acclaimed performances by Tilda Swinton, John C. Reilly and Ezra Miller.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Kevin's mother struggles to love her strange child, despite the increasingly dangerous things he says and does as he grows up. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"Contains strong language, once very strong, strong sex & sexualised nudity\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":109,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=M7UD_WThLME\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=M7UD_WThLME\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000198\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002921\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007016\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009092\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009093\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009094\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000072\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000198\"},{\"castAndCrewMemberId\":\"0000002921\"},{\"castAndCrewMemberId\":\"0000007016\"},{\"castAndCrewMemberId\":\"0000009092\"},{\"castAndCrewMemberId\":\"0000009093\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000009094\"}],\"producers\":[{\"castAndCrewMemberId\":\"HO00000072\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007243\",\"hoCode\":\"A000008910\",\"eventId\":\"0000000068\",\"distributorName\":\"Curzon\"}],\"castAndCrew\":[{\"id\":\"0000000198\",\"name\":{\"givenName\":\"Tilda\",\"familyName\":\"Swinton\",\"middleName\":null}},{\"id\":\"0000002921\",\"name\":{\"givenName\":\"Ezra\",\"familyName\":\"Miller\",\"middleName\":null}},{\"id\":\"0000007016\",\"name\":{\"givenName\":\"John C. \",\"familyName\":\"Reilly\",\"middleName\":null}},{\"id\":\"0000009092\",\"name\":{\"givenName\":\"Jasper\",\"familyName\":\