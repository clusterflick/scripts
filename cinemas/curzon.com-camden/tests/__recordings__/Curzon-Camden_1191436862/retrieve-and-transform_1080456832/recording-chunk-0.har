          "redirectURL": "",
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-09-06\",\"showtimes\":[{\"id\":\"CAM1-43291\",\"schedule\":{\"businessDate\":\"2026-09-06\",\"startsAt\":\"2026-09-06T15:00:00+01:00\",\"endsAt\":\"2026-09-06T16:53:00+01:00\",\"filmStartsAt\":\"2026-09-06T15:25:00+01:00\",\"filmEndsAt\":\"2026-09-06T16:53:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-5-10\",\"filmId\":\"HO00007219\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-5\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"CAM1\",\"name\":{\"text\":\"Camden\",\"translations\":[]},\"location\":{\"latitude\":51.5423011779785,\"longitude\":-0.143399998545647},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"CAM1@curzon.com\",\"address\":{\"line1\":\"Dockray Place,\",\"line2\":\"London,\",\"city\":\"NW1 8QD\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007219\",\"title\":{\"text\":\"Curzon Film 50: Cold War\",\"translations\":[]},\"synopsis\":{\"text\":\"Paweł Pawlikowski follows his Oscar-winning Ida with the stunning Cold War, an epic romance set against the backdrop of Europe after World War II. Sumptuously shot in luminous black and white, it spans decades and nations to tell a love story that is as tragic as it is moving, and as transportive as it is honest.\\n\\nIn the ruins of post-war Poland, Wiktor (Tomasz Kot) and Zula (Joanna Kulig) fall deeply, obsessively and destructively in love. As performing musicians forced to play into the Soviet propaganda machine, they dream of escaping to the creative freedom of the West. But one day, as they spot their chance to make a break for Paris, both make a split decision that will mark their lives forever. As the years march on in the wake of that moment, Wiktor and Zula watch the world changing around them, always struggling to find their moment in time.\\n\\nWinner of the Best Director award at the Cannes Film Festival 2018, Pawlikowski melds the personal with the political to exquisite effect. Set to a soundtrack that takes you from the rustic folk songs of rural Poland to the sultry jazz of a Paris basement bar, it’s a wistful and dreamlike journey through a divided continent – and a heartbreaking portrait of ill-fated love.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A passionate love story between two people of different backgrounds and temperaments, who are fatally mismatched, set against the background of the Cold War in the 1950s.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"Strong language\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":88,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=BvPkDdFeTk8\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=BvPkDdFeTk8\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002100\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004635\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009917\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010070\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010071\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000102\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000796\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000797\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000009917\"},{\"castAndCrewMemberId\":\"0000010070\"},{\"castAndCrewMemberId\":\"HO00000102\"},{\"castAndCrewMemberId\":\"HO00000796\"},{\"castAndCrewMemberId\":\"HO00000797\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000010071\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000002100\"},{\"castAndCrewMemberId\":\"0000004635\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007219\",\"hoCode\":\"A000008884\",\"eventId\":\"0000000068\",\"distributorName\":\"Curzon\"}],\"castAndCrew\":[{\"id\":\"0000002100\",\"name\":{\"givenName\":\"Tanya\",\"familyName\":\"Seghatchian\",\"middleName\":null}},{\"id\":\"0000004635\",\"name\":{\"givenName\":\"Ewa\",\"familyName\":\"Puszczynska\",\"middleName\":null}},{\"id\":\"0000009917\",\"name\":{\"givenName\":\"Cédric \",\"familyName\":\"Kahn\",\"middleName\":null}},{\"id\":\"0000010070\",\"name\":{\"givenName\":\"Joanna\",\"familyName\":\"Kulig\",\"middleName\":null}},{\"id\":\"0000010071\",\"name\":{\"givenName\":\"Pawel\",\"familyName\":\"Pawlikowski\",\"middleName\":null}},{\"id\":\"HO00000102\",\"name\":{\"givenName\":\"Agata\",\"familyName\":\"Kulesza\",\"middleName\":null}},{\"id\":\"HO00000796\",\"name\":{\"givenName\":\"Tomasz\",\"familyName\":\"Kot\",\"middleName\":null}},{\"id\":\"HO00000797\",\"name\":{\"givenName\":\"Borys\",\"familyName\":\"Szyc\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":{\"text\":\"Drama\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"HO00000006\",\"classification\":{\"text\":\"15\",\"translations\":[]},\"classificationDescription\":{\"text\":\"15\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000053\",\"name\":{\"text\":\"Film Club\",\"translations\":[]},\"shortName\":{\"text\":\"Film Club\",\"translations\":[]},\"description\":{\"text\":\"Film Club Screening. Browse more at curzon.com/film-club\",\"translations\":[]},\"importantMessage\":{\"text\":\"Film Club Screening\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"CAM1-5\",\"name\":{\"text\":\"N14\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000068\",\"name\":{\"text\":\"Curzon Film 50\",\"translations\":[]},\"shortName\":null,\"description\":null,\"schedule\":{\"startDate\":\"2026-07-31\",\"endDate\":\"2026-10-10\"},\"siteIds\":[\"ALD1\",\"BLO1\",\"CAM1\",\"CAN2\",\"COL1\",\"HOX1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SOH1\",\"VIC1\",\"WIM1\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"CAM1-0000000002\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
