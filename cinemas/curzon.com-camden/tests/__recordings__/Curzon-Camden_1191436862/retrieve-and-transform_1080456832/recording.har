es\":[{\"id\":\"CAM1\",\"name\":{\"text\":\"Camden\",\"translations\":[]},\"location\":{\"latitude\":51.5423,\"longitude\":-0.1434},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Dockray Place,\",\"line2\":\"London,\",\"city\":\"NW1 8QD\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006017\",\"title\":{\"text\":\"Sinners\",\"translations\":[]},\"synopsis\":{\"text\":\"Trying to leave their troubled lives behind, twin brothers (Jordan) return to their hometown to start again, only to discover that an even greater evil is waiting to welcome them back.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Twin brothers return to their hometown to start their lives over, where they encounter an evil presence that's been waiting to welcome them back.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-04-18\",\"runtimeInMinutes\":137,\"trailerUrl\":\"https://www.youtube.com/watch?v=4oqCwr_bzHI\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000154\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001644\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002611\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004426\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005026\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005685\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010887\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010888\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010889\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006017\",\"hoCode\":\"A000007420\",\"eventId\":null,\"distributorName\":\"Warners\"},{\"id\":\"HO00006033\",\"title\":{\"text\":\"Ocean With David Attenborough\",\"translations\":[]},\"synopsis\":{\"text\":\"OCEAN WITH DAVID ATTENBOROUGH takes viewers on a breathtaking journey showing there is nowhere more vital for our survival, more full of life, wonder, or surprise, than the ocean.\\n\\nThe celebrated broadcaster and filmmaker reveals how his lifetime has coincided with the great age of ocean discovery. Through spectacular sequences featuring coral reefs, kelp forests and the open ocean, Attenborough shares why a healthy ocean keeps the entire planet stable and flourishing.\\n\\nStunning, immersive cinematography showcases the wonder of life under the seas and exposes the realities and challenges facing our ocean as never-before-seen, from destructive fishing techniques to mass coral reef bleaching. Yet the story is one of optimism, with Attenborough pointing to inspirational stories from around the world to deliver his greatest message: the ocean can recover to a glory beyond anything anyone alive has ever seen.\\n\\nScreening in cinemas with theatrically exclusive footage.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"David Attenborough takes viewers on a breathtaking journey showing there is nowhere more vital for our survival, more full of life, wonder, or surprise, than the ocean.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":{\"text\":\"mild upsetting scenes, injury detail\",\"translations\":[]},\"releaseDate\":\"2025-05-08\",\"runtimeInMinutes\":85,\"trailerUrl\":\"https://www.youtube.com/watch?v=cIZAdCtKT_g\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"HO00000585\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000586\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000587\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000588\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"77d48b4f-8949-4ff3-aaf8-4bb728f5eb53\",\"corporateId\":null},\"hopk\":\"HO00006033\",\"hoCode\":\"A000007440\",\"eventId\":null,\"distributorName\":\"Altitude Film Distribution\"},{\"id\":\"HO00006097\",\"title\":{\"text\":\"The Phoenician Scheme\",\"translations\":[]},\"synopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe; Mia Threapleton as Liesl, his daughter/a nun; Michael Cera as Bjorn, their tutor. With: Riz Ahmed, Tom Hanks, Bryan Cranston, Mathieu Amalric, Richard Ayoade, Jeffrey Wright, Scarlett Johansson, Benedict Cumberbatch, Rupert Friend, Hope Davis.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong injury detail\",\"translations\":[]},\"releaseDate\":\"2025-05-23\",\"runtimeInMinutes\":101,\"trailerUrl\":\"https://www.youtube.com/watch?v=qRAnphZLAIg\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001084\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001275\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001395\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001400\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001409\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001410\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001411\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002527\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003325\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005645\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005699\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011116\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011117\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"eff6ffca-db00-4c6f-9e5e-1783c6ace2d7\",\"corporateId\":null},\"hopk\":\"HO00006097\",\"hoCode\":\"A000007517\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006204\",\"title\":{\"text\":\"28 Years Later\",\"translations\":[]},\"synopsis\":{\"text\":\"Academy Award®-winning director Danny Boyle and Academy Award®-nominated writer Alex Garland reunite for 28 Years Later, a terrifying new story set in the world created by 28 Days Later. It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine, some have found ways to exist amidst the infected. One such group of survivors lives on a small island connected to the mainland by a single, heavily-defended causeway. When one of the group leaves the island on a mission into the dark heart of the mainland, he discovers secrets, wonders, and horrors that have mutated not only the infected but other survivors as well.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine...\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-19\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=poEFz8Ivzug\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000313\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001100\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001270\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003206\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003678\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010558\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011257\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000011418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011419\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a7823fd3-66f7-47af-87ba-d36ef45b168c\",\"corporateId\":null},\"hopk\":\"HO00006204\",\"hoCode\":\"A000007660\",\"eventId\":null,\"distributorName\":\"Sony Pictures\"},{\"id\":\"HO00006208\",\"title\":{\"text\":\"M3GAN 2.0\",\"translations\":[]},\"synopsis\":{\"text\":\"The murderous doll who captivated pop culture in 2023 is back. And this time she’s not alone.\\n\\nThe original creative team behind that phenomenon—led by horror titans James Wan for Atomic Monster, Jason Blum for Blumhouse and director Gerard Johnstone—reboot an all-new wild chapter in A.I. mayhem with M3GAN 2.0.\\n\\nTwo years after M3GAN, a marvel of artificial intelligence, went rogue and embarked on a murderous (and impeccably choreographed) rampage and was subsequently destroyed, M3GAN’s creator Gemma (Allison Williams) has become a high-profile author and advocate for government oversight of A.I. Meanwhile, Gemma’s niece Cady (Violet McGraw), now 14, has become a teenager, rebelling against Gemma’s overprotective rules.\\n\\nUnbeknownst to them, the underlying tech for M3GAN has been stolen and misused by a powerful defense contractor to create a military-grade weapon known as Amelia (Ivanna Sakhno; Ahsoka, Pacific Rim: Uprising), the ultimate killer infiltration spy. But as Amelia’s self-awareness increases, she becomes decidedly less interested in taking orders from humans. Or in keeping them around.\\n\\nWith the future of human existence on the line, Gemma realizes that the only option is to resurrect M3GAN (Amie Donald, voiced by Jenna Davis) and give her a few upgrades, making her faster, stronger, and more lethal. As their paths collide, the original A.I bitch is about to meet her match.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The murderous doll who captivated pop culture in 2023 is back. And this time she’s not alone.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2025-06-27\",\"runtimeInMinutes\":120,\"trailerUrl\":\"https://www.youtube.com/watch?v=8mhQ6TRDnuE\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000413\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000578\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000705\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004784\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000004785\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004786\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004789\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000009464\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011434\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011435\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011436\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011437\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011438\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9e781b97-f78d-49f4-a57d-76a0726b15bd\",\"corporateId\":null},\"hopk\":\"HO00006208\",\"hoCode\":\"A000007664\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006110\",\"title\":{\"text\":\"F1® The Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career. Thirty years later, he’s a nomadic racer-for-hire when he’s approached by his former teammate Ruben Cervantes (Javier Bardem), owner of a struggling FORMULA 1 team that is on the verge of collapse. Ruben convinces Sonny to come back to FORMULA 1 for one last shot at saving the team and being the best in the world. He’ll drive alongside Joshua Pearce (Damson Idris), the team's hotshot rookie intent on setting his own pace. But as the engines roar, Sonny’s past catches up with him and he finds that in FORMULA 1, your teammate is your fiercest competition—and the road to redemption is not something you can travel alone.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate threat\",\"translations\":[]},\"releaseDate\":\"2025-06-25\",\"runtimeInMinutes\":156,\"trailerUrl\":\"https://www.youtube.com/watch?v=TZGY2CWPXeU\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000166\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000167\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001693\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002986\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003190\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003191\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008544\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008790\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011188\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"90334335-0de9-4985-8924-9942f4379b60\",\"corporateId\":null},\"h