"schedule\":{\"businessDate\":\"2025-06-25\",\"startsAt\":\"2025-06-25T21:10:00+01:00\",\"endsAt\":\"2025-06-25T23:10:00+01:00\",\"filmStartsAt\":\"2025-06-25T21:35:00+01:00\",\"filmEndsAt\":\"2025-06-25T23:10:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-3-8\",\"filmId\":\"HO00006214\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-3\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"CAM1-33727\",\"schedule\":{\"businessDate\":\"2025-06-25\",\"startsAt\":\"2025-06-25T21:30:00+01:00\",\"endsAt\":\"2025-06-25T23:20:00+01:00\",\"filmStartsAt\":\"2025-06-25T21:55:00+01:00\",\"filmEndsAt\":\"2025-06-25T23:20:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-5-10\",\"filmId\":\"HO00006033\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-5\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"CAM1\",\"name\":{\"text\":\"Camden\",\"translations\":[]},\"location\":{\"latitude\":51.5423,\"longitude\":-0.1434},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Dockray Place,\",\"line2\":\"London,\",\"city\":\"NW1 8QD\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006033\",\"title\":{\"text\":\"Ocean With David Attenborough\",\"translations\":[]},\"synopsis\":{\"text\":\"OCEAN WITH DAVID ATTENBOROUGH takes viewers on a breathtaking journey showing there is nowhere more vital for our survival, more full of life, wonder, or surprise, than the ocean.\\n\\nThe celebrated broadcaster and filmmaker reveals how his lifetime has coincided with the great age of ocean discovery. Through spectacular sequences featuring coral reefs, kelp forests and the open ocean, Attenborough shares why a healthy ocean keeps the entire planet stable and flourishing.\\n\\nStunning, immersive cinematography showcases the wonder of life under the seas and exposes the realities and challenges facing our ocean as never-before-seen, from destructive fishing techniques to mass coral reef bleaching. Yet the story is one of optimism, with Attenborough pointing to inspirational stories from around the world to deliver his greatest message: the ocean can recover to a glory beyond anything anyone alive has ever seen.\\n\\nScreening in cinemas with theatrically exclusive footage.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"David Attenborough takes viewers on a breathtaking journey showing there is nowhere more vital for our survival, more full of life, wonder, or surprise, than the ocean.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":{\"text\":\"mild upsetting scenes, injury detail\",\"translations\":[]},\"releaseDate\":\"2025-05-08\",\"runtimeInMinutes\":85,\"trailerUrl\":\"https://www.youtube.com/watch?v=cIZAdCtKT_g\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"HO00000585\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000586\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000587\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000588\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"77d48b4f-8949-4ff3-aaf8-4bb728f5eb53\",\"corporateId\":null},\"hopk\":\"HO00006033\",\"hoCode\":\"A000007440\",\"eventId\":null,\"distributorName\":\"Altitude Film Distribution\"},{\"id\":\"HO00006097\",\"title\":{\"text\":\"The Phoenician Scheme\",\"translations\":[]},\"synopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe; 