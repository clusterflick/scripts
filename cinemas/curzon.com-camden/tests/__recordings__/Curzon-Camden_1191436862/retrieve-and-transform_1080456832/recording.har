livery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-4-9\",\"filmId\":\"HO00006099\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-4\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"CAM1-33128\",\"schedule\":{\"businessDate\":\"2025-06-24\",\"startsAt\":\"2025-06-24T20:50:00+01:00\",\"endsAt\":\"2025-06-24T23:10:00+01:00\",\"filmStartsAt\":\"2025-06-24T21:15:00+01:00\",\"filmEndsAt\":\"2025-06-24T23:10:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-1-6\",\"filmId\":\"HO00006204\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-1\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"CAM1-85-HO00006204\"},{\"id\":\"CAM1-33707\",\"schedule\":{\"businessDate\":\"2025-06-24\",\"startsAt\":\"2025-06-24T21:10:00+01:00\",\"endsAt\":\"2025-06-24T23:16:00+01:00\",\"filmStartsAt\":\"2025-06-24T21:35:00+01:00\",\"filmEndsAt\":\"2025-06-24T23:16:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"CAM1-3-8\",\"filmId\":\"HO00006097\",\"siteId\":\"CAM1\",\"screenId\":\"CAM1-3\",\"areaCategories\":[{\"areaCategoryId\":\"CAM1-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"CAM1-83-HO00006097\"}],\"relatedData\":{\"sites\":[{\"id\":\"CAM1\",\"name\":{\"text\":\"Camden\",\"translations\":[]},\"location\":{\"latitude\":51.5423,\"longitude\":-0.1434},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"Dockray Place,\",\"line2\":\"London,\",\"city\":\"NW1 8QD\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006017\",\"title\":{\"text\":\"Sinners\",\"translations\":[]},\"synopsis\":{\"text\":\"Trying to leave their troubled lives behind, twin brothers (Jordan) return to their hometown to start again, only to discover that an even greater evil is waiting to welcome them back.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Twin brothers return to their hometown to start their lives over, where they encounter an evil presence that's been waiting to welcome them back.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-04-18\",\"runtimeInMinutes\":137,\"trailerUrl\":\"https://www.youtube.com/watch?v=4oqCwr_bzHI\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000154\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001644\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002611\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004426\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005026\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005685\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010887\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010888\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010889\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006017\",\"hoCode\":\"A000007420\",\"eventId\":null,\"distributorName\":\"Warners\"},{\"id\":\"HO00006033\",\"title\":{\"text\":\"Ocean With David Attenborough\",\"translations\":[]},\"synopsis\":{\"text\":\"OCEAN WITH DAVID ATTENBOROUGH takes viewers on a breathtaking journey showing there is nowhere more vital for our survival, more full of life, wonder, or surprise, than the ocean.\\n\\nThe celebrated broadcaster and filmmaker reveals how his lifetime has coincided with the great age of ocean discovery. Through spectacular sequences featuring coral reefs, kelp forests and the open ocean, Attenborough shares why a healthy ocean keeps the entire planet stable and flourishing.\\n\\nStunning, immersive cinematography showcases the wonder of life under the seas and exposes the realities and challenges facing our ocean as never-before-seen, from destructive fishing techniques to mass coral reef bleaching. Yet the story is one of optimism, with Attenborough pointing to inspirational stories from around the world to deliver his greatest message: the ocean can recover to a glory beyond anything anyone alive has ever seen.\\n\\nScreening in cinemas with theatrically exclusive footage.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"David Attenborough takes viewers on a breathtaking journey showing there is nowhere more vital for our survival, more full of life, wonder, or surprise, than the ocean.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":{\"text\":\"mild upsetting scenes, injury detail\",\"translations\":[]},\"releaseDate\":\"2025-05-08\",\"runtimeInMinutes\":85,\"trailerUrl\":\"https://www.youtube.com/watch?v=cIZAdCtKT_g\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"HO00000585\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000586\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000587\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000588\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"77d48b4f-8949-4ff3-aaf8-4bb728f5eb53\",\"corporateId\":null},\"hopk\":\"HO00006033\",\"hoCode\":\"A000007440\",\"eventId\":null,\"distributorName\":\"Altitude Film Distribution\"},{\"id\":\"HO00006097\",\"title\":{\"text\":\"The Phoenician Scheme\",\"translations\":[]},\"synopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe; Mia Threapleton as Liesl, his daughter/a nun; Michael Cera as Bjorn, their tutor. With: Riz Ahmed, Tom Hanks, Bryan Cranston, Mathieu Amalric, Richard Ayoade, Jeffrey Wright, Scarlett Johansson, Benedict Cumberbatch, Rupert Friend, Hope Davis.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong injury detail\",\"translations\":[]},\"releaseDate\":\"2025-05-23\",\"runtimeInMinutes\":101,\"trailerUrl\":\"https://www.youtube.com/watch?v=qRAnphZLAIg\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001084\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001275\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001395\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001400\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001409\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001410\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001411\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002527\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003325\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005645\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005699\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011116\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011117\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"eff6ffca-db00-4c6f-9e5e-1783c6ace2d7\",\"corporateId\":null},\"hopk\":\"HO00006097\",\"hoCode\":\"A000007517\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006099\",\"title\":{\"text\":\"The Ballad of Wallis Island\",\"translations\":[]},\"synopsis\":{\"text\":\"Eccentric lottery winner Charles dreams of getting his favorite musicians, McGwyer Mortimer, back together. The fantasy becomes real when the bandmates and former lovers agree to play a private show at his home on Wallis Island. Old tensions resurface as Charles tries desperately to salvage his dream gig.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Eccentric lottery winner Charles dreams of getting his favorite musicians, McGwyer Mortimer, back together. \",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"moderate bad language\",\"translations\":[]},\"releaseDate\":\"2025-05-30\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=T9smxlnKNz0\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003501\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003970\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004380\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011120\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011121\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011122\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011123\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4c563f44-cfa4-4914-86b1-b510771045c8\",\"corporateId\":null},\"hopk\":\"HO00006099\",\"hoCode\":\"A000007519\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006199\",\"title\":{\"text\":\"Hidden (Caché)\",\"translations\":[]},\"synopsis\":{\"text\":\"A married couple is terrorized by a series of surveillance videotapes left on their front porch.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A married couple is terrorized by a series of surveillance videotapes left on their front porch.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-20\",\"runtimeInMinutes\":118,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004195\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011332\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011334\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011380\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011394\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011412\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"8d52e414-ea56-449f-949a-6cbcfa55a8b7\",\"corporateId\":null},\"hopk\":\"HO00006199\",\"hoCode\":\"A000007654\",\"eventId\":null,\"distributorName\":\"Curzon\"},{\"id\":\"HO00006278\",\"title\":{\"text\":\"Darling (60th Anniversary 4K Restoration)\",\"translations\":[]},\"synopsis\":{\"text\":\"A beautiful but amoral model sleeps her way to the top of the London fashion scene at the height of the Swinging Sixties.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Beautiful but amoral model Diana Scott sleeps her way to the top of the London fashion scene at the height of the Swinging Sixties.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-05-30\",\"runtimeInMinutes\":128,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000010274\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011658\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011659\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011660\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011661\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011662\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011663\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000061\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":\"8494a08e-5d82-44a7-9647-d1c920529122\",\"corporateId\":null},\"hopk\":\"HO00006278\",\"hoCode\":\"A000007745\",\"eventId\":null,\"distributorName\":\"Studio Canal\"},{\"id\":\"HO00006203\",\"title\":{\"text\":\"Tornado\",\"translations\":[]},\"synopsis\":{\"text\":\"Set in the rugged landscape of 1790’s Britain, Tornado (played by model-songwriter Koki,) finds herself caught in a perilous situation when she and her father’s travelling puppet show crosses paths with a ruthless criminal gang led by Sugarman (PULP FICTION star Tim Roth) and his ambitious son Little Sugar (SLOW HORSES’ Jack Lowden). In an attempt to create a new life, Tornado seizes the opportunity to steal the gold from the gang’s most recent heist; what follows is a thrilling tale of adrenaline-fueled action as Tornado fights to escape a violent demise.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Set in the rugged landscape of 1790’s Britain, Tornado (played by model-songwriter Koki,) finds herself caught in a perilous situation.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong bloody violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-06-13\",\"runtimeInMinutes\":91,\"trailerUrl\":null,\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003251\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003321\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011415\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011416\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011417\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000252\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000254\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000256\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b32a6015-ac13-48b6-9e04-b64a47c5df98\",\"corporateId\":null},\"hopk\":\"HO00006203\",\"hoCode\":\"A000007659\",\"eventId\":null,\"distributorName\":\"Lionsgate\"},{\"id\":\"HO00006204\",\"title\":{\"text\":\"28 Years Later\",\"translations\":[]},\"synopsis\":{\"text\":\"Academy Award®-winning director Danny Boyle and Academy Award®-nominated writer Alex Garland reunite for 28 Years Later, a terrifying new story set in the world created by 28 Days Later. It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine, some have found ways to exist amidst the infected. One such group of survivors lives on a small island connected to the mainland by a single, heavily-defended causeway. When one of the group leaves the island on a mission into the dark heart of the mainland, he discovers secrets, wonders, and horrors that have mutated not only the infected but other survivors as well.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine...\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-19\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=poEFz8Ivzug\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000313\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001100\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001270\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003206\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003678\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"000001