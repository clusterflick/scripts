            "text": "{\"name\":\"Camden\",\"urlSegment\":\"camden\",\"url\":\"/venues/camden/\",\"nodeId\":1801,\"alias\":\"cinema\",\"createDate\":\"2024-08-13T14:56:08\\u002B01:00\",\"updateDate\":\"2025-06-24T08:16:27\\u002B01:00\",\"robotsNoIndex\":false,\"robotsNoFollow\":false,\"masterCanonicalUrl\":null,\"excludeCanonicalUrl\":false,\"seoImage\":null,\"metaKeywords\":\"\",\"metaDescription\":\"Find out what\\u0027s on at Curzon Cinema in Camden. Check out the latest blockbuster movies, new Indie film releases and the best of world cinema out now.\",\"seoPageTitle\":\"Curzon Camden Cinema Showtimes \\u0026 Film Listings\",\"oGType\":\"\",\"twitterCard\":\"\",\"seoUrl\":\"\",\"oGLocale\":\"\",\"excludeFromXmlSitemap\":false,\"excludeFromSiteSearch\":false,\"pageTitle\":\"Curzon Camden Cinema Showtimes \\u0026 Film Listings\",\"hideTitle\":false,\"grid\":[],\"redirectDetailsElement\":{\"redirect\":false,\"permanent\":false},\"heroCarouselDetailsElement\":[{\"image\":{\"mobile\":\"/media/qalovdlz/camden-3.jpg?width=393\\u0026height=169\\u0026v=1db9da63d71ed10\",\"tablet\":\"/media/qalovdlz/camden-3.jpg?width=782\\u0026height=315\\u0026v=1db9da63d71ed10\",\"desktop\":\"/media/qalovdlz/camden-3.jpg?width=1216\\u0026height=523\\u0026v=1db9da63d71ed10\",\"alt\":\"\"},\"textHeading\":\"Welcome to Curzon Camden\",\"actionLink\":{\"name\":\"Take a tour\",\"target\":\"_blank\",\"url\":\"https://tours.360virtualtours.co.uk/curzon/camden/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=393\\u0026height=169\\u0026v=1dbe4e025633ef0\",\"tablet\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=782\\u0026height=315\\u0026v=1dbe4e025633ef0\",\"desktop\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=1216\\u0026height=523\\u0026v=1dbe4e025633ef0\",\"alt\":\"\"},\"textHeading\":\"Support Stonewall on your Curzon cinema visit\",\"actionLink\":{\"name\":\"Find out more\",\"url\":\"/charity/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/pjsj0oss/pepperoni.jpg?width=393\\u0026height=169\\u0026v=1daf1d80a3f4700\",\"tablet\":\"/media/pjsj0oss/pepperoni.jpg?width=782\\u0026height=315\\u0026v=1daf1d80a3f4700\",\"desktop\":\"/media/pjsj0oss/pepperoni.jpg?width=1216\\u0026height=523\\u0026v=1daf1d80a3f4700\",\"alt\":\"\"},\"textHeading\":\"Food and drink\",\"actionLink\":{\"name\":\"View Menu\",\"target\":\"_blank\",\"url\":\"https://www.curzon.com/media/j4gbe2nc/menu-1.pdf\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/rhpfukyf/ph-camden.jpg?width=393\\u0026height=169\\u0026v=1db9da652d22f80\",\"tablet\":\"/media/rhpfukyf/ph-camden.jpg?width=782\\u0026height=315\\u0026v=1db9da652d22f80\",\"desktop\":\"/media/rhpfukyf/ph-camden.jpg?width=1216\\u0026height=523\\u0026v=1db9da652d22f80\",\"alt\":\"\"},\"textHeading\":\"Hire this space\",\"actionLink\":{\"name\":\"Contact us\",\"url\":\"https://www.curzon.com/private-hire/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/5c4bhbxo/coffee-cake.jpg?width=393\\u0026height=169\\u0026v=1db9da6ab2ee1f0\",\"tablet\":\"/media/5c4bhbxo/coffee-cake.jpg?width=782\\u0026height=315\\u0026v=1db9da6ab2ee1f0\",\"desktop\":\"/media/5c4bhbxo/coffee-cake.jpg?width=1216\\u0026height=523\\u0026v=1db9da6ab2ee1f0\",\"alt\":\"\"}},{\"image\":{\"mobile\":\"/media/qypjvjjw/camden-4.jpg?width=393\\u0026height=169\\u0026v=1db9da6bc680ff0\",\"tablet\":\"/media/qypjvjjw/camden-4.jpg?width=782\\u0026height=315\\u0026v=1db9da6bc680ff0\",\"desktop\":\"/media/qypjvjjw/camden-4.jpg?width=1216\\u0026height=523\\u0026v=1db9da6bc680ff0\",\"alt\":\"\"}},{\"image\":{\"mobile\":\"/media/t3gihbly/camden111.jpg?width=393\\u0026height=169\\u0026v=1db9da6d1cbfbe0\",\"tablet\":\"/media/t3gihbly/camden111.jpg?width=782\\u0026height=315\\u0026v=1db9da6d1cbfbe0\",\"desktop\":\"/media/t3gihbly/camden111.jpg?width=1216\\u0026height=523\\u0026v=1db9da6d1cbfbe0\",\"alt\":\"\"}}],\"cinemaLocationDetailsElement\":{\"venueCardImage\":{\"mobile\":\"/media/nwlljrud/cinema-venues-_camden.jpg?width=300\\u0026height=160\\u0026v=1db998a5ebcce10\",\"alt\":\"\"},\"addressLine1\":\"Dockray Place\",\"city\":\"London\",\"postcode\":\"NW1 8QD\",\"nearestStationName\":\"Camden Town\",\"nearestStationType\":\"underground\"},\"vistaCinema\":{\"key\":\"CAM1\",\"value\":\"Camden\"},\"informationTabAccordions\":[{\"heading\":\"Opening times\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EMonday to Saturday:\\u003C/strong\\u003E The cinema opens 30 minutes before the first show\\u0027s programme begins and closes at midnight.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESunday:\\u003C/strong\\u003E Closes at 11.30pm.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cem\\u003EPlease be aware opening and closing times may be subject to change.\\u003C/em\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Screen Info\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 1\\u003C/strong\\u003E\\u003Cbr\\u003E30 seats, 1 wheelchair space\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 2\\u003C/strong\\u003E\\u003Cbr\\u003E30 seats, 1 wheelchair space\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 3\\u003C/strong\\u003E\\u003Cbr\\u003E30 seats, 1 wheelchair space\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 4\\u003C/strong\\u003E\\u003Cbr\\u003E30 seats, 1 wheelchair space\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 5\\u003C/strong\\u003E\\u003Cbr\\u003E30 seats, 1 wheelchair space\\u003C/p\\u003E\"},{\"heading\":\"Accessibility\",\"body\":\"\\u003Cp\\u003ECurzon Camden is fully wheelchair accessible. There is a wheelchair-accessible bathroom.\\u003C/p\\u003E\\n\\u003Cp\\u003EAudio Description and hearing-assist headsets are available on request.\\u003C/p\\u003E\"},{\"heading\":\"Food and Drink\",\"body\":\"\\u003Cp\\u003EFresh coffee, teas and pastries alongside an all day menu of pizza and bar food with vegan and vegetarian options available. The drinks menu includes a wide selection of cocktails, wine, craft beer and soft drinks.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022https://www.curzon.com/media/j4gbe2nc/menu-1.pdf\\u0022 target=\\u0022_blank\\u0022 title=\\u0022View Menu\\u0022\\u003ESee our full menu here.\\u003C/a\\u003E\\u003C/span\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Happy Hour Information\",\"body\":\"\\u003Cp\\u003EAt this venue Happy Hour is 5pm to 10pm every day, 2 for \\u00A316 on all cocktails.\\u003C/p\\u003E\"},{\"heading\":\"Private Hires\",\"body\":\"\\u003Cp\\u003EOur screens are available to rent for your private functions, email \\u003Ca href=\\u0022mailto:privatehires@curzon.com\\u0022 title=\\u0022Email private hires\\u0022\\u003Eprivatehires@curzon.com\\u003C/a\\u003E for more information.\\u003C/p\\u003E\\n\\u003Cp\\u003ETo find out more, visit our \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca href=\\u0022https://www.curzon.com/private-hire/\\u0022 title=\\u0022Private Hire\\u0022\\u003EPrivate Hires page\\u003C/a\\u003E\\u003C/span\\u003E.\\u003C/p\\u003E\"},{\"heading\":\"Social Media\",\"body\":\"\\u003Cp\\u003EInstagram: \\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022https://www.instagram.com/curzoncamden?igsh=YzA3OWR1YWljbmNu\\u0022 target=\\u0022_blank\\u0022 title=\\u0022Curzon Camden Instagram\\u0022 data-anchor=\\u0022?igsh=YzA3OWR1YWljbmNu\\u0022\\u003Ecurzoncamden\\u003C/a\\u003E\\u003C/p\\u003E\"}],\"informationTabDescription\":\"\\u003Cp\\u003ETucked under Camden\\u2019s historic railway arches, this unique venue comprises five beautifully mounted screens, each accommodating 30 guests for an intimate filmgoing experience. The cinema also houses a casual, New York-style bar with glamorous interiors and soft lighting.\\u003C/p\\u003E\",\"menuTabAccordions\":[{\"heading\":\"Pizza\",\"body\":\"\\u003Ctable border=\\u00221\\u0022 style=\\u0022border-collapse: collapse; width: 100%; height: 382px;\\u0022\\u003E\\n\\u003Ctbody\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EMargherita (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A311.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EPepperoni \\u0026amp; Honey\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003E\\u0027Nduja\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EGoat\\u0027s Cheese \\u0026amp; Caramelised Onion (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.80\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EMushroom \\u0026amp; Truffle Oil (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.80\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EVegan Margherita (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-alig