          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-10-27\",\"showtimes\":[{\"id\":\"090-52955\",\"schedule\":{\"businessDate\":\"2026-10-27\",\"startsAt\":\"2026-10-27T19:15:00+00:00\",\"endsAt\":\"2026-10-27T22:50:00+00:00\",\"filmStartsAt\":\"2026-10-27T19:40:00+00:00\",\"filmEndsAt\":\"2026-10-27T22:50:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"090-4-73\",\"filmId\":\"HO00008943\",\"siteId\":\"090\",\"screenId\":\"090-4\",\"areaCategories\":[{\"areaCategoryId\":\"090-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"090-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"090-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"090-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"090\",\"name\":{\"text\":\"South Woodford\",\"translations\":[]},\"location\":{\"latitude\":51.5945,\"longitude\":0.023},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.Woodford@OdeonUK.com\",\"address\":{\"line1\":\"60/64 High Road\",\"line2\":\"South Woodford\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008943\",\"title\":{\"text\":\"RBO Cinema Season 2026-27: Manon\",\"translations\":[]},\"synopsis\":{\"text\":\"In the seedy underbelly of 18th-century Paris, money is king. Nothing is sacred – even love itself can be bought for the right price. A native of this hedonistic underworld, Manon is caught between twin desires when she falls in love with the student Des Grieux. Steadfast and devoted, he offers the possibility of an honourable life. Yet, the riches promised by the world of Parisian society remain tempting...\\nManon’s inner turmoil and struggle for survival lie at the devastating heart of Kenneth MacMillan’s 1974 adaptation of Abbé Prévost’s novel. In this signature work of The Royal Ballet, MacMillan’s nuanced understanding of human psychology makes for an unflinching look into the moral degradation of Manon’s Paris, while all its decadence and decay are brought to life through Jules Massenet’s score and Nicholas Georgiadis’s designs.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In the seedy underbelly of 18th-century Paris, money is king. Nothing is sacred – even love itself can be bought for the right price. A native of this hedonistic \",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-10-27\",\"runtimeInMinutes\":190,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003773\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"19382\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":\"57fd5652-0f5b-491f-821f-fa937c10befa\",\"corporateId\":null},\"hopk\":\"HO00008943\",\"hoCode\":\"A000010090\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000003773\",\"name\":{\"givenName\":\"The Royal \",\"familyName\":\"Ballet\",\"middleName\":null}},{\"id\":\"19382\",\"name\":{\"givenName\":\"Koen\",\"familyName\":\"Kessels\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000028\",\"name\":{\"text\":\"Ballet\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true}],\"screens\":[{\"id\":\"090-4\",\"name\":{\"text\":\"Screen 4\",\"translations\":[]}}],\"events\":[{\"id\":