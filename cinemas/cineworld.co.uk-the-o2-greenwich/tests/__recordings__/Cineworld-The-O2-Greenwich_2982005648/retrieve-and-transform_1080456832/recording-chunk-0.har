            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014523\",\"name\":\"Masters Of The Universe (2026)\",\"originalName\":\"Masters Of The Universe (2026)\",\"length\":141,\"posterLink\":\"https://regalcdn.azureedge.net/CW/MastersOfTheUniverse2026/HO00014523/TV_SmallPosterImage/20260512-103101478.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/MastersOfTheUniverse2026/HO00014523/TV_LargePosterImage/20260512-102646654.jpg\",\"videoLink\":\"https://youtu.be/RZ4dblwZ2TY\",\"link\":\"https://www.cineworld.co.uk/films/masters-of-the-universe-2026/ho00014523\",\"weight\":-6,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Alison Brie, Idris Elba, Jared Leto, James Purefoy, Charlotte Riley, Kristen Wiig, Morena Baccarin, Nicholas Galitzine, Jóhannes Haukur Jóhannesson, Camila Mendes\",\"directors\":\"Travis Knight\",\"synopsis\":\"In MASTERS OF THE UNIVERSE, Director Travis Knight brings the legendary franchise back to the big screen in this epic live-action adventure. After being separated for 15 years, the Sword of Power leads Prince Adam (Nicholas Galitzine) back to Eternia where he discovers his home shattered under the fiendish rule of Skeletor (Jared Leto). To save his family and his world, Adam must join forces with his closest allies, Teela (Camila Mendes) and Duncan/Man-At-Arms (Idris Elba), and embrace his true destiny as He-Man — the most powerful man in the universe.\",\"dateStarted\":\"2026-06-03T00:00:00\",\"eventCount\":53,\"categoriesAttributes\":[\"action\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"audio-described\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MastersOfTheUniverse2026/HO00014523/TV_TopShelfPosterImage/20260512-102646654.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MastersOfTheUniverse2026/HO00014523/TV_SmallPosterImage/20260512-103101478.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/MastersOfTheUniverse2026/HO00014523/Mobile_MovieThumbnail/20260512-102646654.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/MastersOfTheUniverse2026/HO00014523/TV_LargePosterImage/20260512-102646654.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/MastersOfTheUniverse2026/HO00014523/Mobile_MovieFeed/20260512-102716788.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"},{\"type\":\"Video\",\"subType\":\"Trailer_Youtube\",\"url\":\"https://youtu.be/RZ4dblwZ2TY\",\"dimensionHeight\":null,\"dimensionWidth\":null}],\"specialMessage\":null,\"distributorName\":\"SONY PICTURES\"}}}",
