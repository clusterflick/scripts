          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014643\",\"name\":\"Scary Movie (2026)\",\"originalName\":\"Scary Movie (2026)\",\"length\":96,\"posterLink\":\"https://regalcdn.azureedge.net/CW/ScaryMovie2026/HO00014643/TV_SmallPosterImage/20260522-064013387.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/ScaryMovie2026/HO00014643/TV_LargePosterImage/20260522-063941761.jpg\",\"videoLink\":\"https://youtu.be/_4CvRre-Rb8\",\"link\":\"https://www.cineworld.co.uk/films/scary-movie-2026/ho00014643\",\"weight\":-8,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Chris Elliott, Anna Faris, Regina Hall, Lochlyn Munro, Cheri Oteri, Dave Sheridan, Kim Wayans, Marlon Wayans, Shawn Wayans, Damon Wayans Jr., Gregg Wayans, Benny Zielke, Cameron Scott Roberts, Heidi Gardner, Olivia Rose Keegan, Ruby Snowber, Savannah Lee Nassif, Sydney Park\",\"directors\":\"Michael Tiddes\",\"synopsis\":\"Twenty-six years after outrunning a suspiciously familiar masked killer (“Ghostface”), the Core Four are back in the killer’s crosshairs and no horror movie IP is safe. Marlon Wayans (“Shorty”), Shawn Wayans (“Ray”), Anna Faris (“Cindy”), and Regina Hall (“Brenda”) reunite in Scary Movie alongside returning favorites and fresh faces to slash through reboots, remakes, requels, prequels, sequels, spin-offs, elevated horror, origin stories, anything with the word legacy in it, and every “final chapter” that absolutely isn’t final. Nothing is sacred. No trope survives. Every line gets crossed.  The Wayans are back to cancel the Cancel Culture.\",\"dateStarted\":\"2026-06-05T00:00:00\",\"eventCount\":249,\"categoriesAttributes\":[\"comedy\",\"horror\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"audio-described\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/15.png\",\"ageRestrictionName\":\"15\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/ScaryMovie2026/HO00014643/TV_TopShelfPosterImage/20260522-063941761.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/ScaryMovie2026/HO00014643/TV_SmallPosterImage/20260522-064013387.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/ScaryMovie2026/HO00014643/Mobile_MovieThumbnail/20260522-063941761.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/ScaryMovie2026/HO00014643/TV_LargePosterImage/20260522-063941761.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/ScaryMovie2026/HO00014643/Mobile_MovieFeed/20260522-064035405.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"},{\"type\":\"Video\",\"subType\":\"Trailer_Youtube\",\"url\":\"https://youtu.be/_4CvRre-Rb8\",\"dimensionHeight\":null,\"dimensionWidth\":null}],\"specialMessage\":null,\"distributorName\":\"PARAMOUNT\"}}}",
