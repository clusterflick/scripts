          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014755\",\"name\":\"RBO Cinema Season 2026-27: The Nutcracker\",\"originalName\":\"RBO Cinema Season 2026-27: The Nutcracker\",\"length\":140,\"posterLink\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627TheNutcracker/HO00014755/TV_SmallPosterImage/20260528-054918066.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627TheNutcracker/HO00014755/TV_LargePosterImage/20260528-054616258.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/rbo-cinema-season-2026-27-the-nutcracker/ho00014755\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Reece Clarke, Mayara Magri, James Hay, Marianna Tsembenhoi, Taisuke Nakao\",\"directors\":\"\",\"synopsis\":\"At a cosy Christmas party, young Clara meets the mysterious magician Drosselmeyer, who gives her a nutcracker doll. When the guests have departed and the house is asleep, Clara sneaks downstairs in search of the doll. Instead, she finds Drosselmeyer, who whisks her away on a journey into a whole world of enchantment: fantastical landscapes of flurried snow and glittering confection where toys come alive and the magic never stops. \\nPeter Wright’s production of this festive family favourite sparkles to the wondrous swell of Tchaikovsky’s orchestral score, alongside the glow and grandeur of Julia Trevelyan Oman’s period designs.\",\"dateStarted\":\"2026-12-01T00:00:00\",\"eventCount\":75,\"categoriesAttributes\":[],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"alternative-content\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627TheNutcracker/HO00014755/TV_TopShelfPosterImage/20260528-054616258.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627TheNutcracker/HO00014755/TV_SmallPosterImage/20260528-054918066.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627TheNutcracker/HO00014755/Mobile_MovieThumbnail/20260528-054616258.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627TheNutcracker/HO00014755/TV_LargePosterImage/20260528-054616258.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627TheNutcracker/HO00014755/Mobile_MovieFeed/20260528-054707837.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"TRAFALGAR RELEASING\"}}}",
