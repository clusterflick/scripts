          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014753\",\"name\":\"RBO Cinema Season 2026-27: Manon\",\"originalName\":\"RBO Cinema Season 2026-27: Manon\",\"length\":190,\"posterLink\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Manon/HO00014753/TV_SmallPosterImage/20260528-053911946.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Manon/HO00014753/TV_LargePosterImage/20260528-053604236.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/rbo-cinema-season-2026-27-manon/ho00014753\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"\",\"directors\":\"\",\"synopsis\":\"In the seedy underbelly of 18th-century Paris, money is king. Nothing is sacred – even love itself can be bought for the right price. A native of this hedonistic underworld, Manon is caught between twin desires when she falls in love with the student Des Grieux. Steadfast and devoted, he offers the possibility of an honourable life. Yet, the riches promised by the world of Parisian society remain tempting...\\nManon’s inner turmoil and struggle for survival lie at the devastating heart of Kenneth MacMillan’s 1974 adaptation of Abbé Prévost’s novel. In this signature work of The Royal Ballet, MacMillan’s nuanced understanding of human psychology makes for an unflinching look into the moral degradation of Manon’s Paris, while all its decadence and decay are brought to life through Jules Massenet’s score and Nicholas Georgiadis’s designs.\",\"dateStarted\":\"2026-10-27T00:00:00\",\"eventCount\":77,\"categoriesAttributes\":[],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"alternative-content\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/12A.png\",\"ageRestrictionName\":\"12a\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Manon/HO00014753/TV_TopShelfPosterImage/20260528-053604236.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Manon/HO00014753/TV_SmallPosterImage/20260528-053911946.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Manon/HO00014753/Mobile_MovieThumbnail/20260528-053604236.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Manon/HO00014753/TV_LargePosterImage/20260528-053604236.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/RBOCinemaSeason202627Manon/HO00014753/Mobile_MovieFeed/20260528-053713457.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"}],\"specialMessage\":null,\"distributorName\":\"TRAFALGAR RELEASING\"}}}",
