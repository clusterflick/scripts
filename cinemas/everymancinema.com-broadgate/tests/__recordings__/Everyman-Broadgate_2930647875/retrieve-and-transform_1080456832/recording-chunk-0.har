\":{\"firstName\":\"Judy\",\"lastName\":\"Garland\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Margaret\",\"lastName\":\"O'Brien\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lucille\",\"lastName\":\"Bremer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mary\",\"lastName\":\"Astor\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Leon\",\"lastName\":\"Ames\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tom\",\"lastName\":\"Drake\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marjorie\",\"lastName\":\"Main\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Harry\",\"lastName\":\"Davenport\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"June\",\"lastName\":\"Lockhart\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joan\",\"lastName\":\"Carroll\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2001-12-07T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"9597\",\"name\":\"BFI Distribution\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Meet Me in St. Louis\",\"synopsis\":\"The well-off Smith family has four beautiful daughters. Seventeen-year-old Esther has fallen in love with John, who has just moved in next door. He however, barely notices her at first. The family is shocked when Mr. Smith reveals that he has been transferred to a nice position in New York, which means that the family has to leave St. Louis and the 1903 St. Louis Fair.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/20/78/2078524fd664c5df3256a398e271fc52.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/0ac9cb2a894bdbc8a67ff5b1b2de2d14.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Meet Me In St. Louis\",\"synopsis\":\"The well-off Smith family has four beautiful daughters. Seventeen-year-old Esther has fallen in love with John, who has just moved in next door. He however, barely notices her at first. The family is shocked when Mr. Smith reveals that he has been transferred to a nice position in New York, which means that the family has to leave St. Louis and the 1903 St. Louis Fair.\",\"certificate\":\"U\",\"casting\":[\"Judy Garland\",\"Margaret O'Brien\",\"Lucille Bremer\",\"Mary Astor\",\"Leon Ames\",\"Tom Drake\",\"Marjorie Main\",\"Harry Davenport\",\"June Lockhart\",\"Joan Carroll\"],\"direction\":[\"Vincente Minnelli\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2001-12-07T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"BFI Distribution\"}},{\"id\":\"1000033032\",\"title\":\"Members' Preview: Nuremberg\",\"runtime\":8880,\"genres\":\"Historical, Drama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2e1719e55f1923fd93a05feb13625d1c.jpg\",\"__typename\":\"Movie\",\"altId\":[\"403027\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"James\",\"lastName\":\"Vanderbilt\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rami\",\"lastName\":\"Malek\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Russell\",\"lastName\":\"Crowe\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Shannon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-11T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"9447\",\"name\":\"StudioCanal UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"images of real dead bodies, Holocaust references, strong violence\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Members' Preview: Nuremberg\",\"synopsis\":\"NUREMBERG chronicles the true story of the eponymous trials held by the Allies against the defeated Nazi regime. The film centers on American psychiatrist Douglas Kelley (Malek), who is tasked with determining whether Nazi prisoners are fit to stand trial for their war crimes and finds himself in a complex battle of wits with Hermann Goring (Crowe), Hitler's right-hand man.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/5f/8f/5f8fe2a51769813b7aede018498d01e0.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2e1719e55f1923fd93a05feb13625d1c.jpg\",\"synopsis\":\"Everyman members are invited to a special preview screening of James Vanderbilt's Nuremberg on Tuesday, November 11.\\n\\nNuremberg chronicles the true story of the eponymous trials held by the Allies against the defeated Nazi regime. The film centres on American psychiatrist Douglas Kelley (Rami Malek), who is tasked with determining whether Nazi prisoners are fit to stand trial for their war crimes and finds himself in a complex battle of wits with Hermann Goring (Russell Crowe), Hitler's right-hand man.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Members' Preview: Nuremberg\",\"synopsis\":\"Everyman members are invited to a special preview screening of James Vanderbilt's Nuremberg on Tuesday, November 11.\\n\\nNuremberg chronicles the true story of the eponymous trials held by the Allies against the defeated Nazi regime. The film centres on American psychiatrist Douglas Kelley (Rami Malek), who is tasked with determining whether Nazi prisoners are fit to stand trial for their war crimes and finds himself in a complex battle of wits with Hermann Goring (Russell Crowe), Hitler's right-hand man.\",\"certificate\":\"15\",\"casting\":[\"Rami Malek\",\"Russell Crowe\",\"Michael Shannon\"],\"direction\":[\"James Vanderbilt\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-11-11T00:00:00.000Z\",\"advisory\":\"images of real dead bodies, Holocaust references, strong violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"StudioCanal UK\"}},{\"id\":\"1000034203\",\"title\":\"Members’ Preview: Eternity\",\"runtime\":6720,\"genres\":\"Comedy, Romance\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/1dae553e62d068cd10592734292ba400.jpg\",\"__typename\":\"Movie\",\"altId\":[\"404374\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"David\",\"lastName\":\"Freyne\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elizabeth\",\"lastName\":\"Olsen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Miles\",\"lastName\":\"Teller\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Callum\",\"lastName\":\"Turner\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-03T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"1000107175\",\"name\":\"A24\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong sex\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Members’ Preview: Eternity\",\"synopsis\":null,\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/1dae553e62d068cd10592734292ba400.jpg\",\"synopsis\":\"Everyman members are invited to a special preview screening of David Freyne's Eternity on Wednesday, December 3.\\n\\nIn an afterlife where souls have one week to decide where to spend eternity, Joan (Elizabeth Olsen) is faced with the impossible choice between Larry, the man she spent her life with (Miles Teller), and her first love Luke (Callum Turner), who died young and has waited decades for her to arrive.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Members’ Preview: Eternity\",\"synopsis\":\"Everyman members are invited to a special preview screening of David Freyne's Eternity on Wednesday, December 3.\\n\\nIn an afterlife where souls have one week to decide where to spend eternity, Joan (Elizabeth Olsen) is faced with the impossible choice between Larry, the man she spent her life with (Miles Teller), and her first love Luke (Callum Turner), who died young and has waited decades for her to arrive.\",\"certificate\":\"15\",\"casting\":[\"Elizabeth Olsen\",\"Miles Teller\",\"Callum Turner\"],\"direction\":[\"David Freyne\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-12-03T00:00:00.000Z\",\"advisory\":\"strong sex\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"A24\"}},{\"id\":\"1000022298\",\"title\":\"Merrily We Roll Along\",\"runtime\":8700,\"genres\":\"Show, Musical\",\"__typename\":\"Movie\",\"altId\":[\"389780\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/09a99fcf517285266100e0b1689f0c3f.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Maria\",\"lastName\":\"Friedman\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Daniel\",\"lastName\":\"Radcliffe\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jonathan\",\"lastName\":\"Groff (II)\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lindsay\",\"lastName\":\"Mendez\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Krystal Joy\",\"lastName\":\"Brown\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Katie Rose\",\"lastName\":\"Clarke\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Reg\",\"lastName\":\"Rogers\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-05T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"1000109904\",\"name\":\"Fathom Entertainment\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"Contains infrequent strong language and brief drug use\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Merrily We Roll Along\",\"synopsis\":\"Spanning three decades, MERRILY WE ROLL ALONG charts the turbulent relationship between composer Franklin Shepard and his two lifelong friends — writer Mary and lyricist & playwright Charley. Originally produced on Broadway in 1981, then becoming an inventive cult-classic ahead of its time, the musical features some of Stephen Sondheim’s most celebrated and personal songs.\\n \\nThe 2023-2024 Broadway production, directed by Maria Friedman, redefined the show for a new era, bringing Stephen Sondheim’s intricate score and George Furth’s book to vivid life with extraordinary depth and clarity. MERRILY WE ROLL ALONG shattered the Hudson Theatre’s house record on Broadway, solidifying its place as a landmark event in Broadway history. The critically acclaimed production won the 2024 Tony Awards for Best Revival of a Musical, Best Performance by an Actor in a Leading Role in a Musical, Best Performance by an Actor in a Featured Role in a Musical and Best Orchestrations. Additionally, in London, MERRILY WE ROLL ALONG garnered the most five-star reviews in West-End history.\\n \\nMERRILY WE ROLL ALONG is produced by Sonia Friedman, David Babani, Patrick Catullo, F. Richard Pappas, RadicalMedia’s Jon Kamen, and Dave Sirulnick. Executive Producers include Meredith Bennett, No Guarantees Productions, Scott Abrams, Jonathan Corr, Mary Maggio, Jeff Romley, Tony Yurgaitis, Andrew Cohen, Amanda Lipitz, Henry Tisch alongside Co-executive producer Stephanie P. McClelland. Karla Zambrano and Alec Sash serve as Supervising Producers.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/ac/8b/ac8b8b9a0aa38a0f356ce18f5b9684da.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Merrily We Roll Along\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/09a99fcf517285266100e0b1689f0c3f.jpg\",\"synopsis\":\"Spanning three decades, Merrily We Roll Along charts the turbulent relationship between composer Franklin Shepard and his two lifelong friends - writer Mary and lyricist & playwright Charley. Originally produced on Broadway in 1981, then becoming an inventive cult-classic ahead of its time, the musical features some of Stephen Sondheim’s most celebrated and personal songs.\\n\\nStarring Daniel Radcliffe, Jonathan Groff and Lindsay Mendez. The Stephen Sondheim-scored musical follows three best friends, in reverse, moving from the shattered pieces of their friendship in middle age backwards to their first meeting as young dreamers on a New York City rooftop.\\n \\nThe 2023-2024 Broadway production, directed by Maria Friedman, redefined the show for a new era, bringing Stephen Sondheim’s intricate score and George Furth’s book to vivid life with extraordinary depth and clarity. Merrily We Roll Along shattered the Hudson Theatre’s house record on Broadway, solidifying its place as a landmark event in Broadway history. The critically acclaimed production won the 2024 Tony Awards for Best Revival of a Musical, Best Performance by an Actor in a Leading Role in a Musical, Best Performance by an Actor in a Featured Role in a Musical and Best Orchestrations. Additionally, in London, Merrily We Roll Along garnered the most five-star reviews in West End history.\\n\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Merrily We Roll Along (Musical)\",\"synopsis\":\"Spanning three decades, Merrily We Roll Along charts the turbulent relationship between composer Franklin Shepard and his two lifelong friends - writer Mary and lyricist & playwright Charley. Originally produced on Broadway in 1981, then becoming an inventive cult-classic ahead of its time, the musical features some of Stephen Sondheim’s most celebrated and personal songs.\\n\\nStarring Daniel Radcliffe, Jonathan Groff and Lindsay Mendez. The Stephen Sondheim-scored musical follows three best friends, in reverse, moving from the shattered pieces of their friendship in middle age backwards to their first meeting as young dreamers on a New York City rooftop.\\n \\nThe 2023-2024 Broadway production, directed by Maria Friedman, redefined the show for a new era, bringing Stephen Sondheim’s intricate score and George Furth’s book to vivid life with extraordinary depth and clarity. Merrily We Roll Along shattered the Hudson Theatre’s house record on Broadway, solidifying its place as a landmark event in Broadway history. The critically acclaimed production won the 2024 Tony Awards for Best Revival of a Musical, Best Performance by an Actor in a Leading Role in a Musical, Best Performance by an Actor in a Featured Role in a Musical and Best Orchestrations. Additionally, in London, Merrily We Roll Along garnered the most five-star reviews in West End history.\\n\",\"certificate\":\"12A\",\"casting\":[\"Daniel Radcliffe\",\"Jonathan Groff (II)\",\"Lindsay Mendez\",\"Krystal Joy Brown\",\"Katie Rose Clarke\",\"Reg Rogers\"],\"direction\":[\"Maria Friedman\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-12-05T00:00:00.000Z\",\"advisory\":\"Contains infrequent strong language and brief drug use\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Fathom Entertainment\"}},{\"id\":\"1000021573\",\"title\":\"Met Opera 2025-26: Andrea Chénier\",\"runtime\":12660,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"388844\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/904c2ea5271cd5be442198b5aa6f5343.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Nicolas\",\"lastName\":\"Joël\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sonya\",\"lastName\":\"Yoncheva\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Piotr\",\"lastName\":\"Beczala\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Igor\",\"lastName\":\"Golovatenko\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-13T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Met Opera 2025-26: Andrea Chénier\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/c6/5c/c65c59b93274602a15d1b702bb4b29fb.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/904c2ea5271cd5be442198b5aa6f5343.jpg\",\"synopsis\":\"Giordano’s passionate tragedy stars tenor Piotr Beczała as the virtuous poet who falls victim to the intrigue and violence of the French Revolution. Following their celebrated recent partnership in Giordano’s Fedora in the 2022–23 Live in HD season, Beczała reunites with soprano Sonya Yoncheva as Chénier’s aristocratic lover, Maddalena di Coigny, with baritone Igor Golovatenko as Carlo Gérard, the agent of the Reign of Terror who seals their fates. Met Principal Guest Conductor Daniele Rustioni takes the podium to lead Nicolas Joël’s gripping staging, which will be transmitted live from the Met stage to cinemas on December 13. \",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/84f664be160a9976fe4ca3346ebfbf6e.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Metropolitan Opera: Andrea Chénier\",\"synopsis\":\"Giordano’s passionate tragedy stars tenor Piotr Beczała as the virtuous poet who falls victim to the intrigue and violence of the French Revolution. Following their celebrated recent partnership in Giordano’s Fedora in the 2022–23 Live in HD season, Beczała reunites with soprano Sonya Yoncheva as Chénier’s aristocratic lover, Maddalena di Coigny, with baritone Igor Golovatenko as Carlo Gérard, the agent of the Reign of Terror who seals their fates. Met Principal Guest Conductor Daniele Rustioni takes the podium to lead Nicolas Joël’s gripping staging, which will be transmitted live from the Met stage to cinemas on December 13. \",\"certificate\":null,\"casting\":[\"Sonya Yoncheva\",\"Piotr Beczala\",\"Igor Golovatenko\"],\"direction\":[\"Nicolas Joël\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/84f664be160a9976fe4ca3346ebfbf6e.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/84f664be160a9976fe4ca3346ebfbf6e.jpg\"],\"release\":\"2025-12-13T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000021570\",\"title\":\"Met Opera 2025-26: Arabella\",\"runtime\":15120,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"388841\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/e4b0ab1203fe58923426c7d0a7b757c6.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/4c/62/4c62f01a1fc3c4e740e4b0d2fc735fa1.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/8a/f2/8af22301b2bb9fda3243476326ea8d80.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/a0/6f/a06ff3a5aeb2ed677a80b1fd05608a1c.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Otto\",\"lastName\":\"Schenk\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rachel\",\"lastName\":\"Willis-Sørensen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Louise\",\"lastName\":\"Alder\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Pavol\",\"lastName\":\"Breslik\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tomasz\",\"lastName\":\"Konieczny\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brindley\",\"lastName\":\"Sherratt\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-22T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Met Opera 2025-26: Arabella\",\"synopsis\":\"Strauss’s elegant romance brings the glamour and enchantment of 19th-century Vienna to cinemas worldwide in a sumptuous production by legendary director Otto Schenk that “is as beautiful as one could hope” (The New York Times). Soprano Rachel Willis-Sørensen stars as the title heroine, a young noblewoman in search of love on her own terms. Radiant soprano Louise Alder is her sister, Zdenka, and bass-baritone Tomasz Konieczny is the dashing count who sweeps Arabella off her feet.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/8e/3b/8e3b100c0a14fd13b2aaeb2773346091.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/8b548e9d33c71d6de25ecf148a9deccd.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/e4b0ab1203fe58923426c7d0a7b757c6.jpg\",\"synopsis\":\"On November 22, Strauss’s elegant romance brings the glamour and enchantment of 19th-century Vienna to cinemas worldwide in a sumptuous production by legendary director Otto Schenk that “is as beautiful as one could hope” (The New York Times). Soprano Rachel Willis-Sørensen stars as the title heroine, a young noblewoman in search of love on her own terms. Radiant soprano Louise Alder is her sister, Zdenka, and bass-baritone Tomasz Konieczny is the dashing count who sweeps Arabella off her feet.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/518d0b19f974c028d5949cae2e417499.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Metropolitan Opera: Arabella\",\"synopsis\":\"On November 22, Strauss’s elegant romance brings the glamour and enchantment of 19th-century Vienna to cinemas worldwide in a sumptuous production by legendary director Otto Schenk that “is as beautiful as one could hope” (The New York Times). Soprano Rachel Willis-Sørensen stars as the title heroine, a young noblewoman in search of love on her own terms. Radiant soprano Louise Alder is her sister, Zdenka, and bass-baritone Tomasz Konieczny is the dashing count who sweeps Arabella off her feet.\",\"certificate\":null,\"casting\":[\"Rachel Willis-Sørensen\",\"Louise Alder\",\"Pavol Breslik\",\"Tomasz Konieczny\",\"Brindley Sherratt\"],\"direction\":[\"Otto Schenk\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/518d0b19f974c028d5949cae2e417499.jpg\",\"https://all.web.img.acsta.net/img/4c/62/4c62f01a1fc3c4e740e4b0d2fc735fa1.jpg\",\"https://all.web.img.acsta.net/img/8a/f2/8af22301b2bb9fda3243476326ea8d80.jpg\",\"https://all.web.img.acsta.net/img/a0/6f/a06ff3a5aeb2ed677a80b1fd05608a1c.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/518d0b19f974c028d5949cae2e417499.jpg\",\"https://cms-assets.webediamovies.pro/production/2/8b548e9d33c71d6de25ecf148a9deccd.jpg\"],\"release\":\"2025-11-22T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000021612\",\"title\":\"Met Opera 2025-26: Eugene Onegin\",\"runtime\":14700,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"388904\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/1b4e9a52f34ffa8c0f55ba8b64dc0e3a.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Deborah\",\"lastName\":\"Warner\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Asmik\",\"lastName\":\"Grigorian\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maria\",\"lastName\":\"Barakova\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Stephanie\",\"lastName\":\"Blythe\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Stanislas\",\"lastName\":\"de Barbeyrac\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Igor\",\"lastName\":\"Golovatenko\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alexander\",\"lastName\":\"Tsymbalyuk\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-05-02T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Met Opera 2025-26: Eugene Onegin\",\"synopsis\":\"Following her acclaimed 2024 company debut in Puccini’s Madama Butterfly, soprano Asmik Grigorian returns to the Met as Tatiana, the lovestruck young heroine in this ardent operatic adaptation of Pushkin, which will be transmitted live from the Metropolitan Opera stage to cinemas worldwide on May 2. Baritone Igor Golovatenko reprises his portrayal of the urbane Onegin, who realizes his affection for her all too late. The Met’s evocative production, directed by Tony Award–winner Deborah Warner, “offers a beautifully detailed reading of … Tchaikovsky’s lyrical romance” (The Telegraph).\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/ca/f6/caf6febc30f0e935550f2300dd3df93b.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/1b4e9a52f34ffa8c0f55ba8b64dc0e3a.jpg\",\"synopsis\":\"Following her acclaimed 2024 company debut in Puccini’s Madama Butterfly, soprano Asmik Grigorian returns to the Met as Tatiana, the lovestruck young heroine in this ardent operatic adaptation of Pushkin. Baritone Igor Golovatenko reprises his portrayal of the urbane Onegin, who realises his affection for her all too late. The Met’s evocative production, directed by Tony Award–winner Deborah Warner, “offers a beautifully detailed reading of … Tchaikovsky’s lyrical romance” (The Telegraph).\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/f12fbaa1d89b9f4bb038a4e5d357c3c7.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Metropolitan Opera: Eugene Onegin\",\"synopsis\":\"Following her acclaimed 2024 company debut in Puccini’s Madama Butterfly, soprano Asmik Grigorian returns to the Met as Tatiana, the lovestruck young heroine in this ardent operatic adaptation of Pushkin. Baritone Igor Golovatenko reprises his portrayal of the urbane Onegin, who realises his affection for her all too late. The Met’s evocative production, directed by Tony Award–winner Deborah Warner, “offers a beautifully detailed reading of … Tchaikovsky’s lyrical romance” (The Telegraph).\",\"certificate\":null,\"casting\":[\"Asmik Grigorian\",\"Maria Barakova\",\"Stephanie Blythe\",\"Stanislas de Barbeyrac\",\"Igor Golovatenko\",\"Alexander Tsymbalyuk\"],\"direction\":[\"Deborah Warner\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/f12fbaa1d89b9f4bb038a4e5d357c3c7.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/f12fbaa1d89b9f4bb038a4e5d357c3c7.jpg\"],\"release\":\"2026-05-02T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000021609\",\"title\":\"Met Opera 2025-26: I Puritani\",\"runtime\":13620,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"388901\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/40d330e126864c7218fd2328463d43e9.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Charles\",\"lastName\":\"Edwards (IV)\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lisette\",\"lastName\":\"Oropesa\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lawrence\",\"lastName\":\"Brownlee\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Artur\",\"lastName\":\"Rucinski\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christian\",\"lastName\":\"Van Horn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-01-10T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Met Opera 2025-26: I Puritani\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/25/fe/25fe22e76426f0e23379918f08260a03.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/40d330e126864c7218fd2328463d43e9.jpg\",\"synopsis\":\"For gorgeous melody, spellbinding coloratura, and virtuoso vocal fireworks, I Puritani has few equals. On January 10, the first new Met production of Bellini’s final masterpiece in nearly 50 years—a striking staging by Charles Edwards, who makes his company directorial debut after many successes as a set designer—arrives in cinemas worldwide. The Met has assembled a world-beating quartet of stars, conducted by Marco Armiliato, for the demanding principal roles. Soprano Lisette Oropesa and tenor Lawrence Brownlee are Elvira and Arturo, brought together by love and torn apart by the political rifts of the English Civil War, with baritone Artur Ruciński as Riccardo, betrothed to Elvira against her will, and bass-baritone Christian Van Horn as Elvira’s sympathetic uncle, Giorgio.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/0cf19008e493413769197c43742cee16.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Metropolitan Opera: I Puritani\",\"synopsis\":\"For gorgeous melody, spellbinding coloratura, and virtuoso vocal fireworks, I Puritani has few equals. On January 10, the first new Met production of Bellini’s final masterpiece in nearly 50 years—a striking staging by Charles Edwards, who makes his company directorial debut after many successes as a set designer—arrives in cinemas worldwide. The Met has assembled a world-beating quartet of stars, conducted by Marco Armiliato, for the demanding principal roles. Soprano Lisette Oropesa and tenor Lawrence Brownlee are Elvira and Arturo, brought together by love and torn apart by the political rifts of the English Civil War, with baritone Artur Ruciński as Riccardo, betrothed to Elvira against her will, and bass-baritone Christian Van Horn as Elvira’s sympathetic uncle, Giorgio.\",\"certificate\":null,\"casting\":[\"Lisette Oropesa\",\"Lawrence Brownlee\",\"Artur Rucinski\",\"Christian Van Horn\"],\"direction\":[\"Charles Edwards (IV)\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/0cf19008e493413769197c43742cee16.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/0cf19008e493413769197c43742cee16.jpg\"],\"release\":\"2026-01-10T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000021569\",\"title\":\"Met Opera 2025-26: La Bohème\",\"runtime\":12540,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"388840\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ca8e39dde699732743c72d2a364ab0bd.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/5e/34/5e34a824009041d18a2d827d8cd6e1b8.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c3/aa/c3aa6df6ee7273459e034f5326aecb43.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/02/3b/023b08341b44b95905ef3f0bf6256e9d.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/71/20/7120500fe870fac941348f0a6a59a8a0.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Franco\",\"lastName\":\"Zeffirelli\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Juliana\",\"lastName\":\"Grigoryan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Heidi\",\"lastName\":\"Stober\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Freddie\",\"lastName\":\"De Tommaso\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lucas\",\"lastName\":\"Meachem\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sean Michael\",\"lastName\":\"Plumb\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jongmin\",\"lastName\":\"Park\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Donald\",\"lastName\":\"Maxwell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-08T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Metropolitan Opera: La Bohème\",\"synopsis\":\"With its enchanting setting and spellbinding score, the world’s most popular opera is as timeless as it is heartbreaking. Franco Zeffirelli’s picture-perfect production brings 19th-century Paris to the Met stage as Puccini’s young friends and lovers navigate the joy and struggle of bohemian life. Soprano Juliana Grigoryan is the feeble seamstress Mimì, opposite tenor Freddie De Tommaso as the ardent poet Rodolfo. Keri-Lynn Wilson conducts the November 8 performance, which will be transmitted live from the Met stage to cinemas worldwide.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/1a/62/1a6240a93e66c2a60e9f71d7d879b5e9.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Met Opera 2025-26: La Bohème\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ca8e39dde699732743c72d2a364ab0bd.jpg\",\"synopsis\":\"With its enchanting setting and spellbinding score, the world’s most popular opera is as timeless as it is heartbreaking. Franco Zeffirelli’s picture-perfect production brings 19th-century Paris to the Met stage as Puccini’s young friends and lovers navigate the joy and struggle of bohemian life. Soprano Juliana Grigoryan is the feeble seamstress Mimì, opposite tenor Freddie De Tommaso as the ardent poet Rodolfo. Keri-Lynn Wilson conducts the November 8 performance, which will be transmitted live from the Met stage to cinemas worldwide. \",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/d1a0b9d459d32c3b10515af5f09b0314.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Metropolitan Opera: La Bohème\",\"synopsis\":\"With its enchanting setting and spellbinding score, the world’s most popular opera is as timeless as it is heartbreaking. Franco Zeffirelli’s picture-perfect production brings 19th-century Paris to the Met stage as Puccini’s young friends and lovers navigate the joy and struggle of bohemian life. Soprano Juliana Grigoryan is the feeble seamstress Mimì, opposite tenor Freddie De Tommaso as the ardent poet Rodolfo. Keri-Lynn Wilson conducts the November 8 performance, which will be transmitted live from the Met stage to cinemas worldwide. \",\"certificate\":\"12A\",\"casting\":[\"Juliana Grigoryan\",\"Heidi Stober\",\"Freddie De Tommaso\",\"Lucas Meachem\",\"Sean Michael Plumb\",\"Jongmin Park\",\"Donald Maxwell\"],\"direction\":[\"Franco Zeffirelli\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/d1a0b9d459d32c3b10515af5f09b0314.jpg\",\"https://all.web.img.acsta.net/img/5e/34/5e34a824009041d18a2d827d8cd6e1b8.jpg\",\"https://all.web.img.acsta.net/img/c3/aa/c3aa6df6ee7273459e034f5326aecb43.jpg\",\"https://all.web.img.acsta.net/img/02/3b/023b08341b44b95905ef3f0bf6256e9d.jpg\",\"https://all.web.img.acsta.net/img/71/20/7120500fe870fac941348f0a6a59a8a0.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/d1a0b9d459d32c3b10515af5f09b0314.jpg\"],\"release\":\"2025-11-08T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000021611\",\"title\":\"Met Opera 2025-26: Tristan und Isolde\",\"runtime\":18720,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"388903\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2de4e1e17135a6dcbf088b3911ea93c4.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Yuval\",\"lastName\":\"Sharon\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lise\",\"lastName\":\"Davidsen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ekaterina\",\"lastName\":\"Gubanova\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Spyres\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tomasz\",\"lastName\":\"Konieczny\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ryan Speedo\",\"lastName\":\"Green\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-03-21T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Met Opera 2025-26: Tristan und Isolde\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/a0/6f/a06f796aae3404f2caf5029e91fc685d.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2de4e1e17135a6dcbf088b3911ea93c4.jpg\",\"synopsis\":\"After years of anticipation, a truly unmissable event arrives in cinemas worldwide on March 21 as the electrifying Lise Davidsen tackles one of the ultimate roles for dramatic soprano: the Irish princess Isolde in Wagner’s transcendent meditation on love and death. Heroic tenor Michael Spyres stars opposite Davidsen as the love-drunk Tristan. The momentous occasion also marks the advent of a new, Met-debut staging by Yuval Sharon—hailed by The New York Times as “the most visionary opera director of his generation” and the first American to direct an opera at the famed Wagner festival in Bayreuth—as well as Music Director Yannick Nézet-Séguin’s first time leading Tristan und Isolde at the Met. Mezzo-soprano Ekaterina Gubanova reprises her portrayal of Brangäne, alongside bass-baritone Tomasz Konieczny, who sings Kurwenal after celebrated Met appearances in Wagner’s Der Fliegende Holländer and Ring cycle. Bass-baritone Ryan Speedo Green makes an important role debut as King Marke.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/35240ed5c775e2e99106fff9663b351b.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Metropolitan Opera: Tristan und Isolde\",\"synopsis\":\"After years of anticipation, a truly unmissable event arrives in cinemas worldwide on March 21 as the electrifying Lise Davidsen tackles one of the ultimate roles for dramatic soprano: the Irish princess Isolde in Wagner’s transcendent meditation on love and death. Heroic tenor Michael Spyres stars opposite Davidsen as the love-drunk Tristan. The momentous occasion also marks the advent of a new, Met-debut staging by Yuval Sharon—hailed by The New York Times as “the most visionary opera director of his generation” and the first American to direct an opera at the famed Wagner festival in Bayreuth—as well as Music Director Yannick Nézet-Séguin’s first time leading Tristan und Isolde at the Met. Mezzo-soprano Ekaterina Gubanova reprises her portrayal of Brangäne, alongside bass-baritone Tomasz Konieczny, who sings Kurwenal after celebrated Met appearances in Wagner’s Der Fliegende Holländer and Ring cycle. Bass-baritone Ryan Speedo Green makes an important role debut as King Marke.\",\"certificate\":null,\"casting\":[\"Lise Davidsen\",\"Ekaterina Gubanova\",\"Michael Spyres\",\"Tomasz Konieczny\",\"Ryan Speedo Green\"],\"direction\":[\"Yuval Sharon\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/35240ed5c775e2e99106fff9663b351b.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/35240ed5c775e2e99106fff9663b351b.jpg\"],\"release\":\"2026-03-21T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"240\",\"title\":\"Metropolis\",\"runtime\":9180,\"genres\":\"Science fiction, Thriller\",\"__typename\":\"Movie\",\"altId\":[\"3359\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/6eb0c9685c2cb8538c2b62a32b12841e.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890932.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890917.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890916.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890915.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890914.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890913.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890912.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890911.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890910.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890909.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Fritz\",\"lastName\":\"Lang\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brigitte\",\"lastName\":\"Helm\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alfred\",\"lastName\":\"Abel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rudolf\",\"lastName\":\"Klein-Rogge\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Theodor\",\"lastName\":\"Loos\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Heinrich\",\"lastName\":\"George\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Olaf\",\"lastName\":\"Storm\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hanns Leo\",\"lastName\":\"Reich\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Heinrich\",\"lastName\":\"Gotho\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Margarete\",\"lastName\":\"Lanner\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Fritz\",\"lastName\":\"Alberti\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-02-19T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"24287\",\"name\":\"Independent\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"Contains mild violence and nudity\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Metropolis\",\"synopsis\":\"In a futuristic city sharply divided between the working class and the city planners, the son of the city's mastermind falls in love with a working class prophet who predicts the coming of a savior to mediate their differences.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/44/a0/44a0114c1a08bbd76668a5c6661872b6.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/6eb0c9685c2cb8538c2b62a32b12841e.jpg\",\"synopsis\":\"Selected by the Visual Effects Branch, Everyman presents: Metropolis\\n\\nIn a futuristic city sharply divided between the working class and the city planners, the son of the city's mastermind falls in love with a working-class prophet who predicts the coming of a saviour to mediate their differences.\\n\\nThis visionary silent classic from director Fritz Lang created one of the most iconic imaginings of a city of the future while telling a compelling story about the conflict between the classes. When a young activist named Maria tries to enlighten the workers about their oppression, the evil scientist Rotwang replaces her with a robot double designed to foment chaos among the oppressed. Pioneering cinematographer Eugen Schüfftan received the credit for the film’s impressive effects, which include elaborate miniatures of the futuristic city as well as the costume for the robot Maria, one of the most memorable artificial humans in cinematic history.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 19 February.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/49fa59bd5630ebe8f687f5b1ec437202.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Metropolis\",\"synopsis\":\"Selected by the Visual Effects Branch, Everyman presents: Metropolis\\n\\nIn a futuristic city sharply divided between the working class and the city planners, the son of the city's mastermind falls in love with a working-class prophet who predicts the coming of a saviour to mediate their differences.\\n\\nThis visionary silent classic from director Fritz Lang created one of the most iconic imaginings of a city of the future while telling a compelling story about the conflict between the classes. When a young activist named Maria tries to enlighten the workers about their oppression, the evil scientist Rotwang replaces her with a robot double designed to foment chaos among the oppressed. Pioneering cinematographer Eugen Schüfftan received the credit for the film’s impressive effects, which include elaborate miniatures of the futuristic city as well as the costume for the robot Maria, one of the most memorable artificial humans in cinematic history.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 19 February.\",\"certificate\":\"PG\",\"casting\":[\"Brigitte Helm\",\"Alfred Abel\",\"Rudolf Klein-Rogge\",\"Theodor Loos\",\"Heinrich George\",\"Olaf Storm\",\"Hanns Leo Reich\",\"Heinrich Gotho\",\"Margarete Lanner\",\"Fritz Alberti\"],\"direction\":[\"Fritz Lang\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/49fa59bd5630ebe8f687f5b1ec437202.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890932.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890917.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890916.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890915.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890914.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890913.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890912.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890911.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890910.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/10/42/19890909.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/49fa59bd5630ebe8f687f5b1ec437202.jpg\"],\"release\":\"2026-02-19T00:00:00.000Z\",\"advisory\":\"Contains mild violence and nudity\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Independent\"}},{\"id\":\"40128\",\"title\":\"Miracle on 34th Street (1947)\",\"runtime\":5760,\"genres\":\"Comedy, Drama, Family\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/868bb85eb92fca8195578fa78eaa5c8d.jpg\",\"__typename\":\"Movie\",\"altId\":[\"18668\",\"212401\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"releases\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/65/56/04/18870190.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"George\",\"lastName\":\"Seaton\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Edmund\",\"lastName\":\"Gwenn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maureen\",\"lastName\":\"O'Hara\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Natalie\",\"lastName\":\"Wood\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Payne\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gene\",\"lastName\":\"Lockhart\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Porter\",\"lastName\":\"Hall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"William\",\"lastName\":\"Frawley\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jerome\",\"lastName\":\"Cowan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Philip\",\"lastName\":\"Tonge\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Percy\",\"lastName\":\"Helton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"locale\":{\"title\":\"Miracle on 34th Street\",\"synopsis\":\"Kris Kringle (Edmund Gwenn) is a lovable old man who claims to be Santa Claus and gets a job at Macy's during the Christmas season. When he is institutionalized as insane, a young lawyer decides to defend him by arguing in court that he is the real thing.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/60/77/6077f5c2418429a352a7fc29512e82ec.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Miracle on 34th Street (1947)\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/868bb85eb92fca8195578fa78eaa5c8d.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/f63e33cec31ff7ebf86e93cb6a4d9938.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Miracle on 34th Street\",\"synopsis\":\"Kris Kringle (Edmund Gwenn) is a lovable old man who claims to be Santa Claus and gets a job at Macy's during the Christmas season. When he is institutionalized as insane, a young lawyer decides to defend him by arguing in court that he is the real thing.\",\"casting\":[\"Edmund Gwenn\",\"Maureen O'Hara\",\"Natalie Wood\",\"John Payne\",\"Gene Lockhart\",\"Porter Hall\",\"William Frawley\",\"Jerome Cowan\",\"Philip Tonge\",\"Percy Helton\"],\"direction\":[\"George Seaton\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/f63e33cec31ff7ebf86e93cb6a4d9938.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/65/56/04/18870190.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/f63e33cec31ff7ebf86e93cb6a4d9938.jpg\"],\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000033755\",\"title\":\"NT Live: The Fifth Step + Live Q&A with Martin Freeman\",\"runtime\":6000,\"genres\":\"Musical\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/b7ea221a71d461c6ce63bd4376fe8712.jpg\",\"__typename\":\"Movie\",\"altId\":[\"403848\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Finn\",\"lastName\":\"Den Hertog\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jack\",\"lastName\":\"Lowden\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Martin\",\"lastName\":\"Freeman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-11T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"7215\",\"name\":\"National Theatre\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"National Theatre Live: The Fifth Step + Live Q&A\",\"synopsis\":\"After years in the 12-step programme of Alcoholics Anonymous, James becomes a sponsor to newcomer Luka. The pair bond over black coffee, trade stories and build a fragile friendship out of their shared experiences. But as Luka approaches step five – the moment of confession – dangerous truths emerge, threatening the trust on which both of their recoveries depend.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/41/65/4165f49c62de33dc4985a6b3759c5ed1.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"NT Live: The Fifth Step + Live Q&A with Martin Freeman\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/b7ea221a71d461c6ce63bd4376fe8712.jpg\",\"synopsis\":\"Join us at Everyman Belsize Park for an early-access preview screening of The Fifth Step, featuring a special live Q&A with writer David Ireland, director Finn den Hertog, and lead actor Martin Freeman.\\n\\nAfter years in the 12-step programme of Alcoholics Anonymous, James becomes a sponsor to newcomer Luka. The pair bond over black coffee, trade stories, and build a fragile friendship out of their shared experiences. But as Luka approaches step five – the moment of confession – dangerous truths emerge, threatening the trust on which both of their recoveries depend.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"National Theatre Live: The Fifth Step + Live Q&A\",\"synopsis\":\"Join us at Everyman Belsize Park for an early-access preview screening of The Fifth Step, featuring a special live Q&A with writer David Ireland, director Finn den Hertog, and lead actor Martin Freeman.\\n\\nAfter years in the 12-step programme of Alcoholics Anonymous, James becomes a sponsor to newcomer Luka. The pair bond over black coffee, trade stories, and build a fragile friendship out of their shared experiences. But as Luka approaches step five – the moment of confession – dangerous truths emerge, threatening the trust on which both of their recoveries depend.\",\"certificate\":\"15\",\"casting\":[\"Jack Lowden\",\"Martin Freeman\"],\"direction\":[\"Finn Den Hertog\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-11-11T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"National Theatre\"}},{\"id\":\"46572\",\"title\":\"National Lampoon's Christmas Vacation\",\"runtime\":5820,\"genres\":\"Comedy\",\"__typename\":\"Movie\",\"altId\":[\"39271\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/617ebef0e8070a7d12bec2b4235c2205.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/pictures/15/11/26/12/21/045714.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/15/11/26/12/21/047120.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/15/11/26/12/21/048058.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/15/11/26/12/21/048995.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jeremiah S.\",\"lastName\":\"Chechik\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Chevy\",\"lastName\":\"Chase\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Beverly\",\"lastName\":\"D'Angelo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Randy\",\"lastName\":\"Quaid\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Miriam\",\"lastName\":\"Flynn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"William\",\"lastName\":\"Hickey\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mae\",\"lastName\":\"Questel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Diane\",\"lastName\":\"Ladd\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Randolph\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"E.G.\",\"lastName\":\"Marshall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Juliette\",\"lastName\":\"Lewis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2020-12-04T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"infrequent strong language, moderate sex references\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]},{\"releasedAt\":\"2024-12-21T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"infrequent strong language, moderate sex references\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"National Lampoon's Christmas Vacation\",\"synopsis\":\"Clark Griswold, the well-intentioned, walking disaster who has dragged his family through the horrors of traveling in two previous National Lampoon Vacation films, has decided to stay home for the holidays--and the neighborhood will never be the same.​\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/4d/1c/4d1cda7ee9d8ae3f2a7ed31bf15c40f6.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/617ebef0e8070a7d12bec2b4235c2205.jpg\",\"synopsis\":\"As the holidays approach, Clark Griswold (Chevy Chase) wants to have a perfect family Christmas, so he pesters his wife, Ellen (Beverly D'Angelo), and children, as he tries to make sure everything is in line, including the tree and house decorations. \\n\\nHowever, things go awry quickly. His hick cousin, Eddie (Randy Quaid), and his family show up unplanned and start living in their camper on the Griswold property. Even worse, Clark's employers renege on the holiday bonus he needs.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/94d0a73fb26813d4ce21de3f58d96d12.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"National Lampoon's Christmas Vacation\",\"synopsis\":\"As the holidays approach, Clark Griswold (Chevy Chase) wants to have a perfect family Christmas, so he pesters his wife, Ellen (Beverly D'Angelo), and children, as he tries to make sure everything is in line, including the tree and house decorations. \\n\\nHowever, things go awry quickly. His hick cousin, Eddie (Randy Quaid), and his family show up unplanned and start living in their camper on the Griswold property. Even worse, Clark's employers renege on the holiday bonus he needs.\",\"certificate\":\"12A\",\"casting\":[\"Chevy Chase\",\"Beverly D'Angelo\",\"Randy Quaid\",\"Miriam Flynn\",\"William Hickey\",\"Mae Questel\",\"Diane Ladd\",\"John Randolph\",\"E.G. Marshall\",\"Juliette Lewis\"],\"direction\":[\"Jeremiah S. Chechik\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/94d0a73fb26813d4ce21de3f58d96d12.jpg\",\"https://all.web.img.acsta.net/pictures/15/11/26/12/21/045714.jpg\",\"https://all.web.img.acsta.net/pictures/15/11/26/12/21/047120.jpg\",\"https://all.web.img.acsta.net/pictures/15/11/26/12/21/048058.jpg\",\"https://all.web.img.acsta.net/pictures/15/11/26/12/21/048995.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/94d0a73fb26813d4ce21de3f58d96d12.jpg\"],\"release\":\"2020-12-04T00:00:00.000Z\",\"advisory\":\"infrequent strong language, moderate sex references\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"}},{\"id\":\"1000026570\",\"title\":\"National Theatre Live: Hamlet\",\"runtime\":10800,\"genres\":\"Drama\",\"__typename\":\"Movie\",\"altId\":[\"395089\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/fd87d89a94a7ae7a33c1d166eb8a6321.jpg\",\"quadImages\":[\"https://all.web.img.acsta.net/img/d3/ae/d3ae1926dd05429ca581a8d3f8250168.png\"],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Robert\",\"lastName\":\"Hastie\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hiran\",\"lastName\":\"Abeysekera\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-01-22T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"distributors\":[{\"id\":\"7215\",\"name\":\"National Theatre\",\"__typename\":\"Company\"}],\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"National Theatre Live: Hamlet\",\"synopsis\":\"Olivier Award-winner Hiran Abeysekera (Life of Pi) is Hamlet in this fearless, contemporary take on Shakespeare’s famous tragedy. \\nTrapped between duty and doubt, surrounded by power and privilege, young Prince Hamlet dares to ask the ultimate question – you know the one.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/1e/87/1e874e60f4054fd16a0f8b51c64e1b5b.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/fd87d89a94a7ae7a33c1d166eb8a6321.jpg\",\"synopsis\":\"Olivier Award-winner Hiran Abeysekera (Life of Pi) is Hamlet in this fearless, contemporary take on Shakespeare’s famous tragedy.\\n\\nTrapped between duty and doubt, surrounded by power and privilege, young Prince Hamlet dares to ask the ultimate question – you know the one.\\nNational Theatre Deputy Artistic Director, Robert Hastie (Standing at the Sky’s Edge, Operation Mincemeat) directs this sharp, stylish and darkly funny reimagining.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/dd059cb3657051bd46281dce9877fb8c.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"National Theatre Live: Hamlet\",\"synopsis\":\"Olivier Award-winner Hiran Abeysekera (Life of Pi) is Hamlet in this fearless, contemporary take on Shakespeare’s famous tragedy.\\n\\nTrapped between duty and doubt, surrounded by power and privilege, young Prince Hamlet dares to ask the ultimate question – you know the one.\\nNational Theatre Deputy Artistic Director, Robert Hastie (Standing at the Sky’s Edge, Operation Mincemeat) directs this sharp, stylish and darkly funny reimagining.\",\"certificate\":null,\"casting\":[\"Hiran Abeysekera\"],\"direction\":[\"Robert Hastie\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/dd059cb3657051bd46281dce9877fb8c.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/dd059cb3657051bd46281dce9877fb8c.jpg\"],\"release\":\"2026-01-22T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"National Theatre\"}},{\"id\":\"1000021371\",\"title\":\"National Theatre Live: Inter Alia\",\"runtime\":6300,\"genres\":\"Drama\",\"__typename\":\"Movie\",\"altId\":[\"388597\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2127c8317d7ffe94c58397574753bb4c.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Justin\",\"lastName\":\"Martin (II)\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jamie\",\"lastName\":\"Glover\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rosamund\",\"lastName\":\"Pike\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-05T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"7215\",\"name\":\"National Theatre\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"National Theatre Live: Inter Alia\",\"synopsis\":\"Oscar-nominated Rosamund Pike (Gone Girl, Saltburn) is Jessica in the much-anticipated next play from the team behind Prima Facie.\\n\\nJessica Parks is a smart Crown Court Judge at the top of her career. Behind the robe, she is a karaoke fiend, a loving wife and a supportive parent. When an event threatens to throw her life completely off balance, can she hold her family upright?\\n\\nWriter Suzie Miller and director Justin Martin reunite following their global phenomenon Prima Facie, with this searing examination of modern motherhood and masculinity.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/1c/6c/1c6c08a72287dcb990416b5a1e6865de.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/cff6833843d56eb8524d07a1dd6dba1f.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2127c8317d7ffe94c58397574753bb4c.jpg\",\"synopsis\":\"Oscar-nominated Rosamund Pike (Gone Girl, Saltburn) is Jessica in the much-anticipated next play from the team behind Prima Facie. \\n\\nJessica Parks is a smart Crown Court Judge at the top of her career. Behind the robe, she is a karaoke fiend, a loving wife and a supportive parent. When an event threatens to throw her life completely off balance, can she hold her family upright?\\n\\nWriter Suzie Miller and director Justin Martin reunite following their global phenomenon Prima Facie with this searing examination of modern motherhood and masculinity.\\n\\nInter Alia is to be broadcast live on Thursday 4th September 2025, with any subsequent shows played as recorded encores.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/43adcf445d5e45109b7780c735cc4382.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"National Theatre Live: Inter Alia\",\"synopsis\":\"Oscar-nominated Rosamund Pike (Gone Girl, Saltburn) is Jessica in the much-anticipated next play from the team behind Prima Facie. \\n\\nJessica Parks is a smart Crown Court Judge at the top of her career. Behind the robe, she is a karaoke fiend, a loving wife and a supportive parent. When an event threatens to throw her life completely off balance, can she hold her family upright?\\n\\nWriter Suzie Miller and director Justin Martin reunite following their global phenomenon Prima Facie with this searing examination of modern motherhood and masculinity.\\n\\nInter Alia is to be broadcast live on Thursday 4th September 2025, with any subsequent shows played as recorded encores.\",\"certificate\":\"15\",\"casting\":[\"Jamie Glover\",\"Rosamund Pike\"],\"direction\":[\"Justin Martin (II)\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/43adcf445d5e45109b7780c735cc4382.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/43adcf445d5e45109b7780c735cc4382.jpg\",\"https://cms-assets.webediamovies.pro/production/2/cff6833843d56eb8524d07a1dd6dba1f.jpg\"],\"release\":\"2025-09-05T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"National Theatre\"}},{\"id\":\"1000026567\",\"title\":\"National Theatre Live: Mrs. Warren’s Profession\",\"runtime\":7200,\"genres\":\"Musical\",\"__typename\":\"Movie\",\"altId\":[\"395086\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/cd667463170cde9cbfad8401f3bb0bb1.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Dominic\",\"lastName\":\"Cooke\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Imelda\",\"lastName\":\"Staunton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bessie\",\"lastName\":\"Carter\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-23T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"7215\",\"name\":\"National Theatre\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"moderate sex references, suicide references\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"National Theatre Live: Mrs. Warren’s Profession\",\"synopsis\":\"Vivie Warren is a woman ahead of her time. Her mother, however, is a product of that old patriarchal order. Exploiting it has earned Mrs. Warren a fortune – but at what cost?\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/58/fb/58fb3bd6ca45c39d12919ac326ab8f9f.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/f16085b9ca32caf21cc624a3b7ceaef3.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/cd667463170cde9cbfad8401f3bb0bb1.jpg\",\"synopsis\":\"Five-time Olivier Award winner Imelda Staunton (The Crown) joins forces with her real-life daughter Bessie Carter (Bridgerton) for the very first time, playing mother and daughter in Bernard Shaw’s incendiary moral classic.\\n\\nVivie Warren is a woman ahead of her time. Her mother, however, is a product of that old patriarchal order. Exploiting it has earned Mrs. Warren a fortune – but at what cost?\\n\\nFilmed live from the West End, this new production reunites Staunton with director Dominic Cooke (Follies, Good), exploring the clash between morality and independence, traditions and progress. \",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/b1d41776a25cd70aafd5e70ce5968893.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"National Theatre Live: Mrs. Warren’s Profession\",\"synopsis\":\"Five-time Olivier Award winner Imelda Staunton (The Crown) joins forces with her real-life daughter Bessie Carter (Bridgerton) for the very first time, playing mother and daughter in Bernard Shaw’s incendiary moral classic.\\n\\nVivie Warren is a woman ahead of her time. Her mother, however, is a product of that old patriarchal order. Exploiting it has earned Mrs. Warren a fortune – but at what cost?\\n\\nFilmed live from the West End, this new production reunites Staunton with director Dominic Cooke (Follies, Good), exploring the clash between morality and independence, traditions and progress. \",\"certificate\":\"12A\",\"casting\":[\"Imelda Staunton\",\"Bessie Carter\"],\"direction\":[\"Dominic Cooke\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/b1d41776a25cd70aafd5e70ce5968893.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/b1d41776a25cd70aafd5e70ce5968893.jpg\",\"https://cms-assets.webediamovies.pro/production/2/f16085b9ca32caf21cc624a3b7ceaef3.jpg\"],\"release\":\"2025-10-23T00:00:00.000Z\",\"advisory\":\"moderate sex references, suicide references\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"National Theatre\"}},{\"id\":\"1000026569\",\"title\":\"National Theatre Live: The Fifth Step\",\"runtime\":6000,\"genres\":\"Musical\",\"__typename\":\"Movie\",\"altId\":[\"395088\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/0faccf8b7ecd36340d228cfdc358f7a6.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Finn\",\"lastName\":\"Den Hertog\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jack\",\"lastName\":\"Lowden\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Martin\",\"lastName\":\"Freeman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-27T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"7215\",\"name\":\"National Theatre\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"very strong language, strong sex references\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"National Theatre Live: The Fifth Step\",\"synopsis\":\"After years in the 12-step programme of Alcoholics Anonymous, James becomes a sponsor to newcomer Luka. The pair bond over black coffee, trade stories and build a fragile friendship out of their shared experiences. But as Luka approaches step five – the moment of confession – dangerous truths emerge, threatening the trust on which both of their recoveries depend.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/53/be/53beca41057ec0c84415ca266d74d67b.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/0faccf8b7ecd36340d228cfdc358f7a6.jpg\",\"synopsis\":\"Olivier Award-winner Jack Lowden (Slow Horses, Dunkirk) is joined by Emmy and BAFTA-winner Martin Freeman (The Hobbit, The Responder) in the critically acclaimed and subversively funny new play by David Ireland.\\n\\nAfter years in the 12-step programme of Alcoholics Anonymous, James becomes a sponsor to newcomer Luka. The pair bond over black coffee, trade stories and build a fragile friendship out of their shared experiences. But as Luka approaches step five – the moment of confession – dangerous truths emerge, threatening the trust on which both of their recoveries depend.\\n\\nFinn den Hertog directs the provocative and entertaining production filmed live from @sohoplace on London’s West End.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/1a6f11bf828f4642e39f3c2cab4aee81.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"National Theatre Live: The Fifth Step\",\"synopsis\":\"Olivier Award-winner Jack Lowden (Slow Horses, Dunkirk) is joined by Emmy and BAFTA-winner Martin Freeman (The Hobbit, The Responder) in the critically acclaimed and subversively funny new play by David Ireland.\\n\\nAfter years in the 12-step programme of Alcoholics Anonymous, James becomes a sponsor to newcomer Luka. The pair bond over black coffee, trade stories and build a fragile friendship out of their shared experiences. But as Luka approaches step five – the moment of confession – dangerous truths emerge, threatening the trust on which both of their recoveries depend.\\n\\nFinn den Hertog directs the provocative and entertaining production filmed live from @sohoplace on London’s West End.\",\"certificate\":\"15\",\"casting\":[\"Jack Lowden\",\"Martin Freeman\"],\"direction\":[\"Finn Den Hertog\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/1a6f11bf828f4642e39f3c2cab4aee81.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/1a6f11bf828f4642e39f3c2cab4aee81.jpg\"],\"release\":\"2025-11-27T00:00:00.000Z\",\"advisory\":\"very strong language, strong sex references\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"National Theatre\"}},{\"id\":\"1000035585\",\"title\":\"Netflix Presents: A House of Dynamite\",\"runtime\":6720,\"genres\":\"Thriller\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8e46594059b4ec03ea50ccecb5085034.jpg\",\"__typename\":\"Movie\",\"altId\":[\"406041\"],\"images\":[],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Kathryn\",\"lastName\":\"Bigelow\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rebecca\",\"lastName\":\"Ferguson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Idris\",\"lastName\":\"Elba\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Greta\",\"lastName\":\"Lee\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-25T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"1000101511\",\"name\":\"Netflix\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong language, threat\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Netflix presents: A House of Dynamite\",\"synopsis\":\"When a single, unattributed missile is launched at the United States, a race begins to determine who is responsible and how to respond.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/e6/f5/e6f54f6040e565ecc9b6057359cf0b1e.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Netflix Presents: A House of Dynamite\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8e46594059b4ec03ea50ccecb5085034.jpg\",\"synopsis\":\"For one night only, Everyman Members are invited to join us on Tuesday, 25 November, for a special screening of A House of Dynamite presented by Netflix.\\n\\nSave a sofa for just £10, and we’ll throw in a drink and a small popcorn on the house!\\n\\nWhen Fort Greely radars detect an unidentified nuclear missile headed for Chicago, the president and his team race to shoot it down while scrambling to learn who launched it, before the crisis spirals into global disaster.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Netflix presents: A House of Dynamite\",\"synopsis\":\"For one night only, Everyman Members are invited to join us on Tuesday, 25 November, for a special screening of A House of Dynamite presented by Netflix.\\n\\nSave a sofa for just £10, and we’ll throw in a drink and a small popcorn on the house!\\n\\nWhen Fort Greely radars detect an unidentified nuclear missile headed for Chicago, the president and his team race to shoot it down while scrambling to learn who launched it, before the crisis spirals into global disaster.\",\"certificate\":\"15\",\"casting\":[\"Rebecca Ferguson\",\"Idris Elba\",\"Greta Lee\"],\"direction\":[\"Kathryn Bigelow\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-11-25T00:00:00.000Z\",\"advisory\":\"strong language, threat\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Netflix\"}},{\"id\":\"1000035560\",\"title\":\"Netflix Presents: Jay Kelly\",\"runtime\":7920,\"genres\":\"Comedy, Drama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a3990518efeba567baf18f650676d58f.jpg\",\"__typename\":\"Movie\",\"altId\":[\"406016\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Noah\",\"lastName\":\"Baumbach\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"George\",\"lastName\":\"Clooney\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Adam\",\"lastName\":\"Sandler\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Laura\",\"lastName\":\"Dern\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-16T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"1000101511\",\"name\":\"Netflix\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong language\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Netflix presents: Jay Kelly\",\"synopsis\":\"JAY KELLY, the new film from Academy Award nominee Noah Baumbach, follows famous movie actor Jay Kelly (George Clooney) and his devoted manager Ron (Adam Sandler) as they embark on a whirlwind and unexpectedly profound journey through Europe. Along the way, both men are forced to confront the choices they've made, the relationships with their loved ones, and the legacies they’ll leave behind.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/fa/bc/fabc2ed6818bd67ba8977926416af75c.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Netflix Presents: Jay Kelly\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a3990518efeba567baf18f650676d58f.jpg\",\"synopsis\":\"For one night only, Everyman Members are invited to join us on Tuesday, 16 December, for a special screening of Jay Kelly presented by Netflix.\\n\\nSave a sofa for just £10, and we’ll throw in a drink and a small popcorn on the house!\\n\\nFamous movie actor Jay Kelly (George Clooney) and his devoted manager Ron (Adam Sandler) embark on a whirlwind and unexpectedly profound journey through Europe. Along the way, both men are forced to confront the choices they've made, the relationships with their loved ones, and the legacies they’ll leave behind.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Netflix presents: Jay Kelly\",\"synopsis\":\"For one night only, Everyman Members are invited to join us on Tuesday, 16 December, for a special screening of Jay Kelly presented by Netflix.\\n\\nSave a sofa for just £10, and we’ll throw in a drink and a small popcorn on the house!\\n\\nFamous movie actor Jay Kelly (George Clooney) and his devoted manager Ron (Adam Sandler) embark on a whirlwind and unexpectedly profound journey through Europe. Along the way, both men are forced to confront the choices they've made, the relationships with their loved ones, and the legacies they’ll leave behind.\",\"certificate\":\"15\",\"casting\":[\"George Clooney\",\"Adam Sandler\",\"Laura Dern\"],\"direction\":[\"Noah Baumbach\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-12-16T00:00:00.000Z\",\"advisory\":\"strong language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Netflix\"}},{\"id\":\"1000035580\",\"title\":\"Netflix Presents: Left-Handed Girl\",\"runtime\":6000,\"genres\":\"Drama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/36db2a1af69da37bd107202e3d858d3d.jpg\",\"__typename\":\"Movie\",\"altId\":[\"406036\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Shih-Ching\",\"lastName\":\"Tsou\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Janel\",\"lastName\":\"Tsai\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nina\",\"lastName\":\"Ye\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Shi-Yuan\",\"lastName\":\"Ma\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-02T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"1000101511\",\"name\":\"Netflix\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong language, sex\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Netflix presents: Left-Handed Girl\",\"synopsis\":\"A single mother and her two daughters return to Taipei after several years of living in the countryside to open a stand at a buzzing night market. Each in their way will have to adapt to this new environment to make ends meet and maintain the family unity. But when their traditional grandfather forbids his youngest left-handed granddaughter from using her \\\"devil hand,\\\" generations of family secrets begin to unravel.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/66/bf/66bf86d4478a4b3442db302c4952ed8f.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Netflix Presents: Left-Handed Girl\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/36db2a1af69da37bd107202e3d858d3d.jpg\",\"synopsis\":\"For one night only, Everyman Members are invited to join us on Tuesday, 2 December, for a special screening of Left-Handed Girl presented by Netflix.\\n\\nSave a sofa for just £10, and we’ll throw in a drink and a small popcorn on the house!\\n\\nA single mother and her two daughters return to Taipei after several years of living in the countryside to open a stand at a buzzing night market. Each in their own way will have to adapt to this new environment to make ends meet and maintain the family unity. But when their traditional grandfather forbids his youngest left-handed granddaughter from using her \\\"devil hand,\\\" generations of family secrets begin to unravel.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Netflix presents: Left-Handed Girl\",\"synopsis\":\"For one night only, Everyman Members are invited to join us on Tuesday, 2 December, for a special screening of Left-Handed Girl presented by Netflix.\\n\\nSave a sofa for just £10, and we’ll throw in a drink and a small popcorn on the house!\\n\\nA single mother and her two daughters return to Taipei after several years of living in the countryside to open a stand at a buzzing night market. Each in their own way will have to adapt to this new environment to make ends meet and maintain the family unity. But when their traditional grandfather forbids his youngest left-handed granddaughter from using her \\\"devil hand,\\\" generations of family secrets begin to unravel.\",\"certificate\":\"15\",\"casting\":[\"Janel Tsai\",\"Nina Ye\",\"Shi-Yuan Ma\"],\"direction\":[\"Shih-Ching Tsou\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-12-02T00:00:00.000Z\",\"advisory\":\"strong language, sex\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Netflix\"}},{\"id\":\"1000035589\",\"title\":\"Netflix Presents: Train Dreams\",\"runtime\":6180,\"genres\":\"Drama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4419908adb213c2595246f8291942de3.jpg\",\"__typename\":\"Movie\",\"altId\":[\"406045\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Clint\",\"lastName\":\"Bentley\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joel\",\"lastName\":\"Edgerton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Felicity\",\"lastName\":\"Jones\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kerry\",\"lastName\":\"Condon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-09T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"1000101511\",\"name\":\"Netflix\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"moderate violence, threat, sex\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Netflix presents: Train Dreams\",\"synopsis\":\"Based on the beloved novella by Denis Johnson, Train Dreams is the moving portrait of Robert Grainier (Golden Globe-nominee Joel Edgerton), whose life unfolds during an era of unprecedented change in early 20th century America. Orphaned at a young age, Robert grows into adulthood among the towering forests of the Pacific Northwest, where he helps expand the nation’s railroad empire alongside men as unforgettable as the landscapes they inhabit. After a tender courtship, he marries Gladys (Academy Award-nominee Felicity Jones) and they build a home together, though his work often takes him far from her and their young daughter. When his life takes an unexpected turn, Robert finds beauty, brutality and newfound meaning for the forests and trees he has felled.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/10/47/1047da134609b3c1bb5f50d72603bf09.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Netflix Presents: Train Dreams\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4419908adb213c2595246f8291942de3.jpg\",\"synopsis\":\"For one night only, Everyman Members are invited to join us on Tuesday, 9 December, for a special screening of Train Dreams presented by Netflix.\\n\\nSave a sofa for just £10, and we’ll throw in a drink and a small popcorn on the house!\\n\\nBased on the beloved novella by Denis Johnson, Train Dreams is the moving portrait of Robert Grainier (Golden Globe-nominee Joel Edgerton), whose life unfolds during an era of unprecedented change in early 20th century America. Orphaned at a young age, Robert grows into adulthood among the towering forests of the Pacific Northwest, where he helps expand the nation’s railroad empire alongside men as unforgettable as the landscapes they inhabit. After a tender courtship, he marries Gladys (Academy Award-nominee Felicity Jones) and they build a home together, though his work often takes him far from her and their young daughter. When his life takes an unexpected turn, Robert finds beauty, brutality and newfound meaning for the forests and trees he has felled.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Netflix presents: Train Dreams\",\"synopsis\":\"For one night only, Everyman Members are invited to join us on Tuesday, 9 December, for a special screening of Train Dreams presented by Netflix.\\n\\nSave a sofa for just £10, and we’ll throw in a drink and a small popcorn on the house!\\n\\nBased on the beloved novella by Denis Johnson, Train Dreams is the moving portrait of Robert Grainier (Golden Globe-nominee Joel Edgerton), whose life unfolds during an era of unprecedented change in early 20th century America. Orphaned at a young age, Robert grows into adulthood among the towering forests of the Pacific Northwest, where he helps expand the nation’s railroad empire alongside men as unforgettable as the landscapes they inhabit. After a tender courtship, he marries Gladys (Academy Award-nominee Felicity Jones) and they build a home together, though his work often takes him far from her and their young daughter. When his life takes an unexpected turn, Robert finds beauty, brutality and newfound meaning for the forests and trees he has felled.\",\"certificate\":\"12A\",\"casting\":[\"Joel Edgerton\",\"Felicity Jones\",\"Kerry Condon\"],\"direction\":[\"Clint Bentley\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-12-09T00:00:00.000Z\",\"advisory\":\"moderate violence, threat, sex\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Netflix\"}},{\"id\":\"238073\",\"title\":\"Now You See Me: Now You Don't\",\"runtime\":6780,\"genres\":\"Thriller, Adventure, Comedy\",\"__typename\":\"Movie\",\"altId\":[\"360685\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/7658334b2afc8ee85913cf773991041e.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/26/b6/26b623f6f6e4cb1c0791be218ac2ccdf.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c9/3a/c93a6aed95c2d75c91c0246c9b80a52f.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/7d/12/7d12bfc7b15c4548e4d23468d8e3c955.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/9d/76/9d769751be5f08a5ed492abc68690b16.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/1e/55/1e556e9b5b6635eac7c5f99d93f27a6e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/b5/d3/b5d34df715ed744ce62d214017053859.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Ruben\",\"lastName\":\"Fleischer\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jesse\",\"lastName\":\"Eisenberg\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Woody\",\"lastName\":\"Harrelson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dave\",\"lastName\":\"Franco\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Isla\",\"lastName\":\"Fisher\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Justice\",\"lastName\":\"Smith\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dominic\",\"lastName\":\"Sessa\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ariana\",\"lastName\":\"Greenblatt\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rosamund\",\"lastName\":\"Pike\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Morgan\",\"lastName\":\"Freeman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mark\",\"lastName\":\"Ruffalo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-14T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13832\",\"name\":\"Lionsgate UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"moderate violence, injury detail, sex reference, infrequent strong language\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Now You See Me: Now You Don't\",\"synopsis\":\"The third installment of Now You See Me, directed by Ruben Fleischer, sees Jesse Eisenberg, Woody Harrelson, Isla Fisher, Dave Franco, and Morgan Freeman, among others reuniting for Now You See Me: Now You Don't. With Justice Smith, Dominic Sessa, and Ariana Greenblatt joining as a new generation of illusionists and Rosamund Pike also starring.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/360685_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/360685_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/f6/cc/f6ccd9385c0495d22898bc6ffe45f4e1.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/d3533ef92ff7905e02c21d0e5e41cc27.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/7658334b2afc8ee85913cf773991041e.jpg\",\"synopsis\":\"A diamond heist reunites retired Horsemen illusionists with new performers Greenblatt, Smith and Sessa as they target dangerous criminals.\\n\\nThe third instalment of Now You See Me, directed by Ruben Fleischer, sees Jesse Eisenberg, Woody Harrelson, Isla Fisher, Dave Franco, and Morgan Freeman, among others reuniting for Now You See Me: Now You Don't. With Justice Smith, Dominic Sessa, and Ariana Greenblatt joining as a new generation of illusionists and Rosamund Pike also starring.\\n\\nWatch out! There might be a sprinkle of extra magic happening in your local Everyman! Check below to find out more...\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/4ba1b981812b2d5091ddb7434082f223.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Now You See Me: Now You Don't\",\"synopsis\":\"A diamond heist reunites retired Horsemen illusionists with new performers Greenblatt, Smith and Sessa as they target dangerous criminals.\\n\\nThe third instalment of Now You See Me, directed by Ruben Fleischer, sees Jesse Eisenberg, Woody Harrelson, Isla Fisher, Dave Franco, and Morgan Freeman, among others reuniting for Now You See Me: Now You Don't. With Justice Smith, Dominic Sessa, and Ariana Greenblatt joining as a new generation of illusionists and Rosamund Pike also starring.\\n\\nWatch out! There might be a sprinkle of extra magic happening in your local Everyman! Check below to find out more...\",\"certificate\":\"12A\",\"casting\":[\"Jesse Eisenberg\",\"Woody Harrelson\",\"Dave Franco\",\"Isla Fisher\",\"Justice Smith\",\"Dominic Sessa\",\"Ariana Greenblatt\",\"Rosamund Pike\",\"Morgan Freeman\",\"Mark Ruffalo\"],\"direction\":[\"Ruben Fleischer\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/4ba1b981812b2d5091ddb7434082f223.jpg\",\"https://all.web.img.acsta.net/img/26/b6/26b623f6f6e4cb1c0791be218ac2ccdf.jpg\",\"https://all.web.img.acsta.net/img/c9/3a/c93a6aed95c2d75c91c0246c9b80a52f.jpg\",\"https://all.web.img.acsta.net/img/7d/12/7d12bfc7b15c4548e4d23468d8e3c955.jpg\",\"https://all.web.img.acsta.net/img/9d/76/9d769751be5f08a5ed492abc68690b16.jpg\",\"https://all.web.img.acsta.net/img/1e/55/1e556e9b5b6635eac7c5f99d93f27a6e.jpg\",\"https://all.web.img.acsta.net/img/b5/d3/b5d34df715ed744ce62d214017053859.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/4ba1b981812b2d5091ddb7434082f223.jpg\",\"https://cms-assets.webediamovies.pro/production/2/d3533ef92ff7905e02c21d0e5e41cc27.jpg\"],\"release\":\"2025-11-14T00:00:00.000Z\",\"advisory\":\"moderate violence, injury detail, sex reference, infrequent strong language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/360685_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/360685_uk_hd.