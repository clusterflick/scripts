          "content": {
            "mimeType": "application/json",
            "text": "[{\"id\":\"27442\",\"title\":\"2001: A Space Odyssey\",\"runtime\":8460,\"genres\":\"Science fiction\",\"__typename\":\"Movie\",\"altId\":[\"5748\",\"272643\",\"276343\",\"276344\",\"143804\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a35f9a5065f45a6631a50cbb602bb1ce.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/2962340.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/2976402.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/2988902.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3017028.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3045153.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3059216.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3073278.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/37/0998482.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3087341.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3002965.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Stanley\",\"lastName\":\"Kubrick\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Keir\",\"lastName\":\"Dullea\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gary\",\"lastName\":\"Lockwood\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"William\",\"lastName\":\"Sylvester\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Douglas\",\"lastName\":\"Rain\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Leonard\",\"lastName\":\"Rossiter\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Margaret\",\"lastName\":\"Tyzack\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Beatty\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sean\",\"lastName\":\"Sullivan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Daniel\",\"lastName\":\"Richter\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Frank\",\"lastName\":\"Miller (II)\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2018-05-18T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[]},{\"releasedAt\":\"2025-12-11T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild violence, threat\",\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"2001: A Space Odyssey\",\"synopsis\":\"2001: A Space Odyssey spans from the dawn of man to its title year. Stone Age Earth: In the presence of a mysterious black obelisk, pre-humans discover the use of tools - and weapons - violently taking first steps toward intelligence. 1999: On Earth's moon astronauts uncover another mysterious black obelisk. 2001: Between Earth and Jupiter, the spacecraft's intelligent computer makes a mistake that kills most of the human crew - then continues to kill to hide its error. Beyond Time: The sole survivor of the journey to Jupiter ascends to the next level of humanity.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/41/78/4178078e2035e57fead7c99a783e140b.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a35f9a5065f45a6631a50cbb602bb1ce.jpg\",\"synopsis\":\"Selected by the Cinematographers Branch, Everyman presents: 2001: A Space Odyssey\\n\\nAn imposing black structure provides a connection between the past and the future in this enigmatic adaptation of a short story by revered sci-fi author Arthur C. Clarke. When Dr. Dave Bowman (Keir Dullea) and other astronauts are sent on a mysterious mission, their ship's computer system, HAL, begins to display increasingly strange behavior, leading up to a tense showdown between man and machine that results in a mind-bending trek through space and time.\\n\\nStanley Kubrick’s groundbreaking space epic was one of the most influential films of its time, and a surprise counter-culture smash due to its psychedelic Stargate sequence. The film ushered in an era of ambitious and intelligent science-fiction cinema. While its visual effects set a new high standard (for which Kubrick received an Oscar), its eye-popping 70mm cinematography was an equal contributor to its visual grandeur, with Geoffrey Unsworth (Cabaret) serving as principal cinematographer and John Alcott (Barry Lyndon) shooting additional scenes, including the \\\"Dawn of Man\\\" prologue. \\n\\nPresented in restored 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 11 December.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/eb4adf05e0823dd2d7095bbe28dced47.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"2001: A Space Odyssey\",\"synopsis\":\"Selected by the Cinematographers Branch, Everyman presents: 2001: A Space Odyssey\\n\\nAn imposing black structure provides a connection between the past and the future in this enigmatic adaptation of a short story by revered sci-fi author Arthur C. Clarke. When Dr. Dave Bowman (Keir Dullea) and other astronauts are sent on a mysterious mission, their ship's computer system, HAL, begins to display increasingly strange behavior, leading up to a tense showdown between man and machine that results in a mind-bending trek through space and time.\\n\\nStanley Kubrick’s groundbreaking space epic was one of the most influential films of its time, and a surprise counter-culture smash due to its psychedelic Stargate sequence. The film ushered in an era of ambitious and intelligent science-fiction cinema. While its visual effects set a new high standard (for which Kubrick received an Oscar), its eye-popping 70mm cinematography was an equal contributor to its visual grandeur, with Geoffrey Unsworth (Cabaret) serving as principal cinematographer and John Alcott (Barry Lyndon) shooting additional scenes, including the \\\"Dawn of Man\\\" prologue. \\n\\nPresented in restored 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 11 December.\",\"certificate\":\"U\",\"casting\":[\"Keir Dullea\",\"Gary Lockwood\",\"William Sylvester\",\"Douglas Rain\",\"Leonard Rossiter\",\"Margaret Tyzack\",\"Robert Beatty\",\"Sean Sullivan\",\"Daniel Richter\",\"Frank Miller (II)\"],\"direction\":[\"Stanley Kubrick\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/eb4adf05e0823dd2d7095bbe28dced47.jpg\",\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/2962340.jpg\",\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/2976402.jpg\",\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/2988902.jpg\",\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3017028.jpg\",\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3045153.jpg\",\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3059216.jpg\",\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3073278.jpg\",\"https://all.web.img.acsta.net/pictures/18/05/17/12/37/0998482.jpg\",\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3087341.jpg\",\"https://all.web.img.acsta.net/pictures/18/05/17/12/34/3002965.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/eb4adf05e0823dd2d7095bbe28dced47.jpg\"],\"release\":\"2018-05-18T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"}},{\"id\":\"139772\",\"title\":\"28 Years Later\",\"runtime\":6900,\"genres\":\"Horror, Thriller\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/968372a91a1acfd9c8659234aac152b1.jpg\",\"__typename\":\"Movie\",\"altId\":[\"356733\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/63/5d/635d5934c1ee76bb074402640cc08e7d.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/50/57/50573e36cfb832f4045abc929369549c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/fd/1e/fd1e6c80658f68d26022cbb67305fdc4.jpeg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/85/29/85294c93477d17b30fb331ecf7d4e334.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ff/13/ff139607f0056668e2195b26774b01d1.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/91/0a/910aa7ed02280e5515a2a745b0f3c8d9.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Danny\",\"lastName\":\"Boyle\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Aaron\",\"lastName\":\"Taylor-Johnson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jodie\",\"lastName\":\"Comer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alfie\",\"lastName\":\"Williams\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ralph\",\"lastName\":\"Fiennes\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jack\",\"lastName\":\"O'Connell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Erin\",\"lastName\":\"Kellyman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Edvin\",\"lastName\":\"Ryding\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Angus\",\"lastName\":\"Angus Neill\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christopher\",\"lastName\":\"Fulford\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gordon\",\"lastName\":\"Alexander\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-06-19T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"39732\",\"name\":\"Sony Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong violence, gore, horror, language\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"28 Years Later\",\"synopsis\":\"Academy Award®-winning director Danny Boyle and Academy Award®-nominated writer Alex Garland reunite for 28 Years Later, a terrifying new story set in the world created by 28 Days Later. It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine, some have found ways to exist amidst the infected. One such group of survivors lives on a small island connected to the mainland by a single, heavily-defended causeway. When one of the group leaves the island on a mission into the dark heart of the mainland, he discovers secrets, wonders, and horrors that have mutated not only the infected but other survivors as well.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/356733_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/356733_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/00/04/0004748ea2afc8820ac36cd58b688100.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/cddea8c9ead49ff3024d6bdecdaaf40d.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/968372a91a1acfd9c8659234aac152b1.jpg\",\"synopsis\":\"It's been almost three decades since the rage virus escaped from a biological weapons laboratory. Still living in a ruthlessly enforced quarantine, some have found ways to exist amid the infected. \\n\\nOne such group of survivors lives on a small island connected to the mainland by a single, heavily defended causeway. When one of them decides to venture into the dark heart of the mainland, he soon discovers a mutation that has spread to not only the infected, but other survivors as well.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/87417c260f31e198989d04a098c71b2f.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"28 Years Later\",\"synopsis\":\"It's been almost three decades since the rage virus escaped from a biological weapons laboratory. Still living in a ruthlessly enforced quarantine, some have found ways to exist amid the infected. \\n\\nOne such group of survivors lives on a small island connected to the mainland by a single, heavily defended causeway. When one of them decides to venture into the dark heart of the mainland, he soon discovers a mutation that has spread to not only the infected, but other survivors as well.\",\"certificate\":\"15\",\"casting\":[\"Aaron Taylor-Johnson\",\"Jodie Comer\",\"Alfie Williams\",\"Ralph Fiennes\",\"Jack O'Connell\",\"Erin Kellyman\",\"Edvin Ryding\",\"Angus Angus Neill\",\"Christopher Fulford\",\"Gordon Alexander\"],\"direction\":[\"Danny Boyle\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/87417c260f31e198989d04a098c71b2f.jpg\",\"https://all.web.img.acsta.net/img/63/5d/635d5934c1ee76bb074402640cc08e7d.jpg\",\"https://all.web.img.acsta.net/img/50/57/50573e36cfb832f4045abc929369549c.jpg\",\"https://all.web.img.acsta.net/img/fd/1e/fd1e6c80658f68d26022cbb67305fdc4.jpeg\",\"https://all.web.img.acsta.net/img/85/29/85294c93477d17b30fb331ecf7d4e334.jpg\",\"https://all.web.img.acsta.net/img/ff/13/ff139607f0056668e2195b26774b01d1.jpg\",\"https://all.web.img.acsta.net/img/91/0a/910aa7ed02280e5515a2a745b0f3c8d9.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/87417c260f31e198989d04a098c71b2f.jpg\",\"https://cms-assets.webediamovies.pro/production/2/cddea8c9ead49ff3024d6bdecdaaf40d.jpg\"],\"release\":\"2025-06-19T00:00:00.000Z\",\"advisory\":\"strong violence, gore, horror, language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/356733_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/356733_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures\"}},{\"id\":\"1000000966\",\"title\":\"28 Years Later: The Bone Temple\",\"runtime\":null,\"genres\":\"Horror\",\"__typename\":\"Movie\",\"altId\":[\"360489\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/969bc01a32aa4967cfe796051f95a94f.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/9f/5d/9f5da086eedfbacc7ff818abf20dd42b.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/b3/e2/b3e253935b3531a7797221b0b57e7e54.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/4f/86/4f865a0840ccdf1dd842f42c85c7b610.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Nia\",\"lastName\":\"DaCosta\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ralph\",\"lastName\":\"Fiennes\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alfie\",\"lastName\":\"Williams\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jack\",\"lastName\":\"O'Connell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Aaron\",\"lastName\":\"Taylor-Johnson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Chi\",\"lastName\":\"Lewis-Parry\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emma\",\"lastName\":\"Laird\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Erin\",\"lastName\":\"Kellyman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Rhodes\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maura\",\"lastName\":\"Bird\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sam\",\"lastName\":\"Locke\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-01-16T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"distributors\":[{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}],\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"28 Years Later: The Bone Temple\",\"synopsis\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later: The Bone Temple. In a continuation of the epic story, Dr. Kelson (Ralph Fiennes) finds himself in a shocking new relationship - with consequences that could change the world as they know it - and Spike's (Alfie Williams) encounter with Jimmy Crystal (Jack O'Connell) becomes a nightmare he can't escape. In the world of The Bone Temple, the infected are no longer the greatest threat to survival - the inhumanity of the survivors can be stranger and more terrifying.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/360489_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/360489_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/34/03/3403243329e388688302c80218860c0b.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/3cab3a0645f8b74e523a6fa7e6e74200.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/969bc01a32aa4967cfe796051f95a94f.jpg\",\"synopsis\":\"28 Years Later: The Bone Temple is an upcoming post-apocalyptic horror film directed by Nia DaCosta and written by Alex Garland. It was shot back-to-back with its predecessor, 28 Years Later, and will serve as the fourth instalment overall in the 28 Days Later film series.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/43153e096210cb210378cea22d1b1a90.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"28 Years Later: The Bone Temple\",\"synopsis\":\"28 Years Later: The Bone Temple is an upcoming post-apocalyptic horror film directed by Nia DaCosta and written by Alex Garland. It was shot back-to-back with its predecessor, 28 Years Later, and will serve as the fourth instalment overall in the 28 Days Later film series.\",\"certificate\":null,\"casting\":[\"Ralph Fiennes\",\"Alfie Williams\",\"Jack O'Connell\",\"Aaron Taylor-Johnson\",\"Chi Lewis-Parry\",\"Emma Laird\",\"Erin Kellyman\",\"Robert Rhodes\",\"Maura Bird\",\"Sam Locke\"],\"direction\":[\"Nia DaCosta\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/43153e096210cb210378cea22d1b1a90.jpg\",\"https://all.web.img.acsta.net/img/9f/5d/9f5da086eedfbacc7ff818abf20dd42b.jpg\",\"https://all.web.img.acsta.net/img/b3/e2/b3e253935b3531a7797221b0b57e7e54.jpg\",\"https://all.web.img.acsta.net/img/4f/86/4f865a0840ccdf1dd842f42c85c7b610.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/43153e096210cb210378cea22d1b1a90.jpg\",\"https://cms-assets.webediamovies.pro/production/2/3cab3a0645f8b74e523a6fa7e6e74200.jpg\"],\"release\":\"2026-01-16T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/360489_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/360489_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures UK\"}},{\"id\":\"326583\",\"title\":\"A Big Bold Beautiful Journey\",\"runtime\":6540,\"genres\":\"Drama\",\"__typename\":\"Movie\",\"altId\":[\"361585\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/d4574f24c75278d6e97a085a54a18846.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/60/76/607617f43a75a33d68cb81f09e5bd9f7.JPG\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ca/fc/cafc1ed27335c215b802bf356dfaa4c1.JPG\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/42/01/420157fe723e865269245a01732a716e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/b8/a0/b8a0e2f6b46c1408c7bf7675f9f452b2.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/61/ef/61efbbeb352db4c34eb010a9f5ac9138.JPG\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/76/36/7636779eb1a7b4b59edcd1e06f0f27eb.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e0/33/e033361e4dc05e03c84d606dc9c3bcdb.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":null,\"lastName\":\"Kogonada\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Margot\",\"lastName\":\"Robbie\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Colin\",\"lastName\":\"Farrell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kevin\",\"lastName\":\"Kline\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Phoebe\",\"lastName\":\"Waller-Bridge\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jennifer\",\"lastName\":\"Grant\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hamish\",\"lastName\":\"Linklater\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lily\",\"lastName\":\"Rabe\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Jodie\",\"lastName\":\"Turner-Smith\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Billy\",\"lastName\":\"Magnussen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sarah\",\"lastName\":\"Gadon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-19T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong language\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"A Big Bold Beautiful Journey\",\"synopsis\":\"Some doors bring you to your past. Some doors lead you to your future. And some doors change everything. Sarah (Margot Robbie) and David (Colin Farrell) are single strangers who meet at a mutual friend’s wedding and soon, through a surprising twist of fate, find themselves on A Big Bold Beautiful Journey – a funny, fantastical, sweeping adventure together where they get to re-live important moments from their respective pasts, illuminating how they got to where they are in the present...and possibly getting a chance to alter their futures.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/361585_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/361585_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/1e/0b/1e0b51ea6f831b9c307bcba2f7df282b.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/8ad31dcb12618001a7ee3bcab2dcaf59.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/d4574f24c75278d6e97a085a54a18846.jpg\",\"synopsis\":\"A Big Bold Beautiful Journey is a romantic fantasy about love, fate, and the mysterious ways lives can connect.\\n\\nAt a wedding, two strangers — David (Colin Farrell) and Sarah (Margot Robbie) — cross paths. What begins as a fleeting encounter quickly transforms into something extraordinary when a twist of fate propels them onto a shared journey unlike anything they could have imagined.\\nTogether, David (Farrell) and Sarah (Robbie) are drawn into an experience that allows them to step back into defining moments from their own pasts. As they relive these memories, they uncover the choices, heartbreaks, and hopes that shaped their lives — and discover how the power of connection can open new doors to the future.\\n\\nDirected by acclaimed filmmaker Kogonada, and based on a screenplay by Seth Reiss, A Big Bold Beautiful Journey features a stellar cast including Colin Farrell, Margot Robbie, Phoebe Waller-Bridge, Billy Magnussen, Jodie Turner-Smith, Hamish Linklater, Lily Rabe, and Kevin Kline.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/22ed7a0567732c23d38f68fd69249ed2.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"A Big Bold Beautiful Journey\",\"synopsis\":\"A Big Bold Beautiful Journey is a romantic fantasy about love, fate, and the mysterious ways lives can connect.\\n\\nAt a wedding, two strangers — David (Colin Farrell) and Sarah (Margot Robbie) — cross paths. What begins as a fleeting encounter quickly transforms into something extraordinary when a twist of fate propels them onto a shared journey unlike anything they could have imagined.\\nTogether, David (Farrell) and Sarah (Robbie) are drawn into an experience that allows them to step back into defining moments from their own pasts. As they relive these memories, they uncover the choices, heartbreaks, and hopes that shaped their lives — and discover how the power of connection can open new doors to the future.\\n\\nDirected by acclaimed filmmaker Kogonada, and based on a screenplay by Seth Reiss, A Big Bold Beautiful Journey features a stellar cast including Colin Farrell, Margot Robbie, Phoebe Waller-Bridge, Billy Magnussen, Jodie Turner-Smith, Hamish Linklater, Lily Rabe, and Kevin Kline.\",\"certificate\":\"15\",\"casting\":[\"Margot Robbie\",\"Colin Farrell\",\"Kevin Kline\",\"Phoebe Waller-Bridge\",\"Jennifer Grant\",\"Hamish Linklater\",\"Lily Rabe\",\"Jodie Turner-Smith\",\"Billy Magnussen\",\"Sarah Gadon\"],\"direction\":[\"Kogonada\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/22ed7a0567732c23d38f68fd69249ed2.jpg\",\"https://all.web.img.acsta.net/img/60/76/607617f43a75a33d68cb81f09e5bd9f7.JPG\",\"https://all.web.img.acsta.net/img/ca/fc/cafc1ed27335c215b802bf356dfaa4c1.JPG\",\"https://all.web.img.acsta.net/img/42/01/420157fe723e865269245a01732a716e.jpg\",\"https://all.web.img.acsta.net/img/b8/a0/b8a0e2f6b46c1408c7bf7675f9f452b2.jpg\",\"https://all.web.img.acsta.net/img/61/ef/61efbbeb352db4c34eb010a9f5ac9138.JPG\",\"https://all.web.img.acsta.net/img/76/36/7636779eb1a7b4b59edcd1e06f0f27eb.jpg\",\"https://all.web.img.acsta.net/img/e0/33/e033361e4dc05e03c84d606dc9c3bcdb.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/22ed7a0567732c23d38f68fd69249ed2.jpg\",\"https://cms-assets.webediamovies.pro/production/2/8ad31dcb12618001a7ee3bcab2dcaf59.jpg\"],\"release\":\"2025-09-19T00:00:00.000Z\",\"advisory\":\"strong language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/361585_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/361585_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures UK\"}},{\"id\":\"58992\",\"title\":\"A Christmas Story\",\"runtime\":5640,\"genres\":\"Comedy, Drama, Family\",\"__typename\":\"Movie\",\"altId\":[\"13123\"],\"coDirectors\":{\"node