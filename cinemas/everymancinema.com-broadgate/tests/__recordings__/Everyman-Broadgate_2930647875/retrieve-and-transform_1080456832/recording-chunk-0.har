ename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dee\",\"lastName\":\"Wallace\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Peter\",\"lastName\":\"Coyote\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"MacNaughton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"K.C.\",\"lastName\":\"Martel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sean\",\"lastName\":\"Frye\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"C. Thomas\",\"lastName\":\"Howell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Erika\",\"lastName\":\"Eleniak\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Barton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2022-09-02T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"Contains very mild language and threat\",\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"E.T. The Extra-Terrestrial\",\"synopsis\":\"An extra-terrestrial is accidentally left behind on Earth and is befriended by a young boy and his brother and sister.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/8d/5e/8d5e6848cd00541011d2f07757651dad.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2a8d2377e786dc509cb516375272d74a.jpg\",\"synopsis\":\"After a gentle alien becomes stranded on Earth, the being is discovered and befriended by a young boy named Elliott. Bringing the extra-terrestrial into his suburban California house, Elliott introduces E.T., as the alien is dubbed, to his brother and his little sister, Gertie, and the children decide to keep its existence a secret. Soon, however, E.T. falls ill, resulting in government intervention and a dire situation for both Elliott and the alien.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"E.T. The Extra-Terrestrial\",\"synopsis\":\"After a gentle alien becomes stranded on Earth, the being is discovered and befriended by a young boy named Elliott. Bringing the extra-terrestrial into his suburban California house, Elliott introduces E.T., as the alien is dubbed, to his brother and his little sister, Gertie, and the children decide to keep its existence a secret. Soon, however, E.T. falls ill, resulting in government intervention and a dire situation for both Elliott and the alien.\",\"certificate\":\"U\",\"casting\":[\"Henry Thomas\",\"Drew Barrymore\",\"Dee Wallace\",\"Peter Coyote\",\"Robert MacNaughton\",\"K.C. Martel\",\"Sean Frye\",\"C. Thomas Howell\",\"Erika Eleniak\",\"Robert Barton\"],\"direction\":[\"Steven Spielberg\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/03/19975721.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/03/19975718.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/03/19975717.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/03/19975714.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/03/19975713.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/03/19975709.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/03/19975706.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/03/19975704.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/00/02/36/52/et6.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/00/02/36/52/et1.jpg\"],\"heroImages\":[],\"release\":\"2022-09-02T00:00:00.000Z\",\"advisory\":\"Contains very mild language and threat\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Universal International Pictures\"}},{\"id\":\"27624\",\"title\":\"Edward Scissorhands\",\"runtime\":6300,\"genres\":\"Fantasy, Romance, Drama\",\"__typename\":\"Movie\",\"altId\":[\"6729\"],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"poster\":\"https://cms-assets.webediamovies.pro/production/279/f543de5f2bf584d26cc80c67e094c00b.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/pictures/17/08/14/20/27/283906.png\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/17/08/14/20/27/284687.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/17/08/14/20/27/285000.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/17/08/14/20/27/285312.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/17/08/14/20/27/285625.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/17/08/14/20/27/284375.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/02/62/19883759.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/02/62/19883756.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/02/62/19883753.jpg\",\"__type