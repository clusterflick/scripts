his ways?\",\"certificate\":\"PG\",\"casting\":[\"Bill Murray\",\"Karen Allen\",\"John Forsythe\",\"Carol Kane\",\"Robert Mitchum\",\"Bobcat Goldthwait\",\"John Glover\",\"Lee Majors\",\"Michael J. Pollard\",\"Alfre Woodard\"],\"direction\":[\"Richard Donner\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/55425e6d7fb0e125d98c741dcde3913e.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/05/39/19886251.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/55425e6d7fb0e125d98c741dcde3913e.jpg\"],\"release\":\"1989-11-01T00:00:00.000Z\",\"advisory\":\"Contains moderate language and violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Paramount Pictures UK\"}},{\"id\":\"13804\",\"title\":\"Showgirls\",\"runtime\":7860,\"genres\":\"Drama, Erotic\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/e2963ac50a86c9ee35e9d41ea893c1e8.jpg\",\"__typename\":\"Movie\",\"altId\":[\"2009\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[{\"url\":\"https://all.web.img.acsta.net/pictures/14/03/12/10/47/373383.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319051.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319050.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319049.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319048.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319041.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319040.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/76/34/37/19779705.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/76/34/37/19779704.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/76/34/37/19779703.jpg\",\"__typename\":\"Image\"}],\"quadImages\":[\"https://all.web.img.acsta.net/img/7b/2a/7b2a81e5927a8c753b3ac9f36dfedbcf.jpg\"],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Paul\",\"lastName\":\"Verhoeven\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elizabeth\",\"lastName\":\"Berkley\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kyle\",\"lastName\":\"MacLachlan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gina\",\"lastName\":\"Gershon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gina\",\"lastName\":\"Ravera\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Davi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Glenn\",\"lastName\":\"Plummer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alan\",\"lastName\":\"Rachins\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lin\",\"lastName\":\"Tucci\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michelle\",\"lastName\":\"Johnston\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Pamela\",\"lastName\":\"Anderson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"1995-12-20T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong sex, sexual violence\",\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[]},{\"releasedAt\":\"2025-11-20T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong sex, nudity, sexual violence\",\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[]},{\"releasedAt\":\"2025-06-06T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong sex, nudity, sexual violence\",\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Showgirls\",\"synopsis\":\"Las Vegas... Running from a troubled past and possessed of a raw and riveting dancing talent, Nomi Malone is soon introduced to the arena of the sensual, pulsating stage shows on the legendary Strip and the powerful men and women who run them. One of those drawn to Nomi's beauty and talent is Zack, the ambitious entertainment director at the Stardust. Another is Cristal, the glamorous, coke-snorting star of the stage show 'Goddess,' who may make her...or break her. As the complex bonds of passion, jealousy and love form between them, Nomi is drawn deeper into the world she so desperately desires and the allure of the spotlight she craves. It's a world of passion, power and personal moral choices where everything--and everyone--has a price.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/e1/fd/e1fd973d796f258f179a1aaa5d917444.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/e2963ac50a86c9ee35e9d41ea893c1e8.jpg\",\"synopsis\":\"Selected by the Marketing & Public Relations Branch, Everyman presents: Showgirls\\n\\nNomi (Elizabeth Berkley) arrives in Las Vegas with only a suitcase and a dream of becoming a top showgirl. She quickly befriends Molly (Gina Ravera), who works at the high-profile Stardust Hotel, and lands a job at a seedy strip club. A chance meeting with Cristal (Gina Gershon), the Stardust's marquee dancer, and her powerful boyfriend, Zack (Kyle MacLachlan), brings Nomi one step closer to realizing her dream. But, as she ascends to the top, Nomi begins to wonder if it's all worth it.\\n\\nDirector Paul Verhoeven and screenwriter Joe Eszterhas followed up the international success of their 1992 thriller Basic Instinct with this lavish drama set against the glitzy and tawdry backdrop of the Las Vegas entertainment world. Elizabeth Berkley is Nomi, a fearless young woman determined to make it in show business at any cost, and Gina Gershon is Cristal Connors, the star whose throne Nomi is scheming to claim. Arguably Verhoeven’s most controversial film, and the rare studio film to be released with an NC-17 rating, it has found an enthusiastic cult following in the thirty years since its premiere. \\n\\nThe feature returns to the big screen at Everyman at The Whiteley on Thursday, 20 November.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/8d789b354051e372c42588c2f81779e3.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Showgirls\",\"synopsis\":\"Selected by the Marketing & Public Relations Branch, Everyman presents: Showgirls\\n\\nNomi (Elizabeth Berkley) arrives in Las Vegas with only a suitcase and a dream of becoming a top showgirl. She quickly befriends Molly (Gina Ravera), who works at the high-profile Stardust Hotel, and lands a job at a seedy strip club. A chance meeting with Cristal (Gina Gershon), the Stardust's marquee dancer, and her powerful boyfriend, Zack (Kyle MacLachlan), brings Nomi one step closer to realizing her dream. But, as she ascends to the top, Nomi begins to wonder if it's all worth it.\\n\\nDirector Paul Verhoeven and screenwriter Joe Eszterhas followed up the international success of their 1992 thriller Basic Instinct with this lavish drama set against the glitzy and tawdry backdrop of the Las Vegas entertainment world. Elizabeth Berkley is Nomi, a fearless young woman determined to make it in show business at any cost, and Gina Gershon is Cristal Connors, the star whose throne Nomi is scheming to claim. Arguably Verhoeven’s most controversial film, and the rare studio film to be released with an NC-17 rating, it has found an enthusiastic cult following in the thirty years since its premiere. \\n\\nThe feature returns to the big screen at Everyman at The Whiteley on Thursday, 20 November.\",\"certificate\":\"18\",\"casting\":[\"Elizabeth Berkley\",\"Kyle MacLachlan\",\"Gina Gershon\",\"Gina Ravera\",\"Robert Davi\",\"Glenn Plummer\",\"Alan Rachins\",\"Lin Tucci\",\"Michelle Johnston\",\"Pamela Anderson\"],\"direction\":[\"Paul Verhoeven\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/8d789b354051e372c42588c2f81779e3.jpg\",\"https://all.web.img.acsta.net/pictures/14/03/12/10/47/373383.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319051.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319050.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319049.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319048.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319041.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/94/31/47/20319040.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/76/34/37/19779705.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/76/34/37/19779704.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/76/34/37/19779703.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/8d789b354051e372c42588c2f81779e3.jpg\"],\"release\":\"1995-12-20T00:00:00.000Z\",\"advisory\":\"strong sex, sexual violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000000149\",\"title\":\"Springsteen: Deliver Me From Nowhere\",\"runtime\":7200,\"genres\":\"Biopic, Drama, Music\",\"__typename\":\"Movie\",\"altId\":[\"359046\",\"401584\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/cec8a81544375ca126b90e7fb64679bd.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/e3/c1/e3c1175f82df6f73e0509caf4cae13a4.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/6f/fa/6ffa7352d390ef5d529dfc00aec24ea4.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/62/c7/62c7e44762628102c40a0c7a839a17f4.JPG\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/cd/46/cd4650a6a6e1619becdb15f16d7cfc7d.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/9c/f6/9cf6d284b7940395309257f5b11d6210.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/1b/32/1b32397277b9af017d288fb6cb77f6e0.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ea/a4/eaa4afd1ba8b463a677cd44d2698fbb7.JPG\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/3a/a4/3aa40acfb4af92aae87823a936c1e2c7.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e3/e5/e3e534639cb83cea93298bf2ec31dd21.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/41/e8/41e837fb33af45889fbd3752bec9b59f.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Scott\",\"lastName\":\"Cooper\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jeremy\",\"lastName\":\"Allen White\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jeremy\",\"lastName\":\"Strong\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Paul Walter\",\"lastName\":\"Hauser\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Stephen\",\"lastName\":\"Graham\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gaby\",\"lastName\":\"Hoffmann\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Odessa\",\"lastName\":\"Young\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marc\",\"lastName\":\"Maron\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Johnny\",\"lastName\":\"Cannizzaro\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"David\",\"lastName\":\"Krumholtz\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Arabella Olivia\",\"lastName\":\"Clark\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-24T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"moderate threat, violence, sex, mental health theme, strong language\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Springsteen: Deliver Me From Nowhere\",\"synopsis\":\"From 20th Century Studios, “Springsteen: Deliver Me from Nowhere” chronicles the making of Bruce Springsteen’s 1982 “Nebraska” album. Recorded on a 4-track recorder in Springsteen’s New Jersey bedroom, the album marked a pivotal time in his life and is considered one of his most enduring works—a raw, haunted acoustic record populated by lost souls searching for a reason to believe.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/01/cf/01cff93ceb5b16cdeb583a2b78f341c7.jpeg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/de9f851c78d1b20abcfb4330086566ca.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/cec8a81544375ca126b90e7fb64679bd.jpg\",\"synopsis\":\"Springsteen: Deliver Me from Nowhere chronicles the making of Bruce Springsteen’s 1982 “Nebraska” album when he was a young musician on the cusp of global superstardom, struggling to reconcile the pressures of success with the ghosts of his past. Recorded on a 4-track recorder in Springsteen’s New Jersey bedroom, the album marked a pivotal time in his life and is considered one of his most enduring works—a raw, haunted acoustic record populated by lost souls searching for a reason to believe. \",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/f70c1d7a473aa51e1020749cfec33846.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Springsteen: Deliver Me From Nowhere\",\"synopsis\":\"Springsteen: Deliver Me from Nowhere chronicles the making of Bruce Springsteen’s 1982 “Nebraska” album when he was a young musician on the cusp of global superstardom, struggling to reconcile the pressures of success with the ghosts of his past. Recorded on a 4-track recorder in Springsteen’s New Jersey bedroom, the album marked a pivotal time in his life and is considered one of his most enduring works—a raw, haunted acoustic record populated by lost souls searching for a reason to believe. \",\"certificate\":\"12A\",\"casting\":[\"Jeremy Allen White\",\"Jeremy Strong\",\"Paul Walter Hauser\",\"Stephen Graham\",\"Gaby Hoffmann\",\"Odessa Young\",\"Marc Maron\",\"Johnny Cannizzaro\",\"David Krumholtz\",\"Arabella Olivia Clark\"],\"direction\":[\"Scott Cooper\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/f70c1d7a473aa51e1020749cfec33846.jpg\",\"https://all.web.img.acsta.net/img/e3/c1/e3c1175f82df6f73e0509caf4cae13a4.jpg\",\"https://all.web.img.acsta.net/img/6f/fa/6ffa7352d390ef5d529dfc00aec24ea4.jpg\",\"https://all.web.img.acsta.net/img/62/c7/62c7e44762628102c40a0c7a839a17f4.JPG\",\"https://all.web.img.acsta.net/img/cd/46/cd4650a6a6e1619becdb15f16d7cfc7d.jpg\",\"https://all.web.img.acsta.net/img/9c/f6/9cf6d284b7940395309257f5b11d6210.jpg\",\"https://all.web.img.acsta.net/img/1b/32/1b32397277b9af017d288fb6cb77f6e0.jpg\",\"https://all.web.img.acsta.net/img/ea/a4/eaa4afd1ba8b463a677cd44d2698fbb7.JPG\",\"https://all.web.img.acsta.net/img/3a/a4/3aa40acfb4af92aae87823a936c1e2c7.jpg\",\"https://all.web.img.acsta.net/img/e3/e5/e3e534639cb83cea93298bf2ec31dd21.jpg\",\"https://all.web.img.acsta.net/img/41/e8/41e837fb33af45889fbd3752bec9b59f.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/f70c1d7a473aa51e1020749cfec33846.jpg\",\"https://cms-assets.webediamovies.pro/production/2/de9f851c78d1b20abcfb4330086566ca.jpg\"],\"release\":\"2025-10-24T00:00:00.000Z\",\"advisory\":\"moderate threat, violence, sex, mental health theme, strong language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Walt Disney\"}},{\"id\":\"1000030397\",\"title\":\"Stop Making Sense\",\"runtime\":5280,\"genres\":\"Documentary, Concert\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4b821dccc7a74624964d57a67ae2db31.jpg\",\"__typename\":\"Movie\",\"altId\":[\"400040\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jonathan\",\"lastName\":\"Demme\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bernie\",\"lastName\":\"Worrell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alex\",\"lastName\":\"Weir\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"David\",\"lastName\":\"Byrne\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-30T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[]}],\"embargoes\":[],\"exhibitor\":{\"title\":\"Stop Making Sense\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4b821dccc7a74624964d57a67ae2db31.jpg\",\"synopsis\":\"Selected by the Documentary Branch, Everyman presents: Stop Making Sense\\n\\nStop Making Sense documents the groundbreaking Talking Heads at their peak and was directed by Jonathan Demme. In honour of its fifteenth anniversary, Stop Making Sense was digitally remixed and remastered by Palm with the newest state-of-the-art Dolby technology.\\n\\nOscar-winner Jonathan Demme (The Silence of the Lambs) collaborated with cinematographer Jordan Cronenweth (Blade Runner) to make the quintessential concert film, documenting three nights of Talking Heads concerts at Hollywood’s Pantages Theatre in December 1983. David Byrne and his fellow Heads perform such modern classics as “Psycho Killer,” “Burning Down The House,” and “Once In A Lifetime,” while Demme’s direction, Cronenweth’s camerawork, and the sound recording make you feel as if you’re in the front row of the Pantages.  \\n\\nPresented in 4k with Dolby Atmos, the feature returns to the big screen at Everyman The Whiteley on Thursday, 30 October.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/7b59d2a4b8fd3dff0469fdf403dbe5bd.jpg\",\"__typename\":\"BOAppImage\"}]},\"locale\":{\"title\":\"Branch Selects: Stop Making Sense\",\"synopsis\":\"Universally acclaimed as one of the best concert films ever made, Stop Making Sense documents the groundbreaking Talking Heads at their peak and was directed by Jonathan Demme. In honor of its fifteenth anniversary, Stop Making Sense was digitally re-mixed and re-mastered by Palm with the newest state-of-the-art Dolby technology.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/af/97/af97ca83afde57788fd7d783c565c7d8.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"originalTitle\":\"Branch Selects: Stop Making Sense\",\"synopsis\":\"Selected by the Documentary Branch, Everyman presents: Stop Making Sense\\n\\nStop Making Sense documents the groundbreaking Talking Heads at their peak and was directed by Jonathan Demme. In honour of its fifteenth anniversary, Stop Making Sense was digitally remixed and remastered by Palm with the newest state-of-the-art Dolby technology.\\n\\nOscar-winner Jonathan Demme (The Silence of the Lambs) collaborated with cinematographer Jordan Cronenweth (Blade Runner) to make the quintessential concert film, documenting three nights of Talking Heads concerts at Hollywood’s Pantages Theatre in December 1983. David Byrne and his fellow Heads perform such modern classics as “Psycho Killer,” “Burning Down The House,” and “Once In A Lifetime,” while Demme’s direction, Cronenweth’s camerawork, and the sound recording make you feel as if you’re in the front row of the Pantages.  \\n\\nPresented in 4k with Dolby Atmos, the feature returns to the big screen at Everyman The Whiteley on Thursday, 30 October.\",\"certificate\":\"PG\",\"casting\":[\"Bernie Worrell\",\"Alex Weir\",\"David Byrne\"],\"direction\":[\"Jonathan Demme\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/7b59d2a4b8fd3dff0469fdf403dbe5bd.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/7b59d2a4b8fd3dff0469fdf403dbe5bd.jpg\"],\"release\":\"2025-10-30T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"234143\",\"title\":\"Tangerine\",\"runtime\":5280,\"genres\":\"Comedy, Drama\",\"__typename\":\"Movie\",\"altId\":[\"202462\"],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"poster\":\"https://cms-assets.webediamovies.pro/production/279/77732a07bd8cca6923fe7b131e0579dc.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/pictures/14/12/15/17/03/040197.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/15/09/16/17/49/122500.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/16/05/13/16/12/094503.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/16/05/13/16/12/095128.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/16/05/13/16/12/095597.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/16/05/13/16/12/096222.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/16/05/13/16/13/152822.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/16/05/13/16/13/154072.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/16/05/13/16/13/154541.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/16/05/13/16/13/155010.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Sean\",\"lastName\":\"Baker\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kitana\",\"lastName\":\"Kiki Rodriguez\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mya\",\"lastName\":\"Taylor\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mickey\",\"lastName\":\"O'Hagan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"James\",\"lastName\":\"Ransone\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Karren\",\"lastName\":\"Karagulian\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Clu\",\"lastName\":\"Gulager\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alla\",\"lastName\":\"Tumanian\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Arsen\",\"lastName\":\"Grigoryan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Luiza\",\"lastName\":\"Nersisyan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ian\",\"lastName\":\"Edwards\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2015-11-13T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"25904\",\"name\":\"Metrodome Distribution\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong language, sex, sex references, drug misuse\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Tangerine\",\"synopsis\":\"It's Christmas Eve in Tinseltown and Sin-Dee is back on the block. Upon hearing that her pimp boyfriend hasn't been faithful during the 28 days she was locked up, the working girl and her best friend, Alexandra, embark on a mission to get to the bottom of the scandalous rumor. Their rip-roaring odyssey leads them through various subcultures of Los Angeles, including an Armenian family dealing with their own repercussions of infidelity.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/202462_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/202462_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/0d/c5/0dc5d60fb7b2dfeee7e0f6cfaa958a81.png\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/77732a07bd8cca6923fe7b131e0579dc.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/53544c94989b3e6efe91f8b99d3c66b7.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Tangerine\",\"synopsis\":\"It's Christmas Eve in Tinseltown and Sin-Dee is back on the block. Upon hearing that her pimp boyfriend hasn't been faithful during the 28 days she was locked up, the working girl and her best friend, Alexandra, embark on a mission to get to the bottom of the scandalous rumor. Their rip-roaring odyssey leads them through various subcultures of Los Angeles, including an Armenian family dealing with their own repercussions of infidelity.\",\"certificate\":\"15\",\"casting\":[\"Kitana Kiki Rodriguez\",\"Mya Taylor\",\"Mickey O'Hagan\",\"James Ransone\",\"Karren Karagulian\",\"Clu Gulager\",\"Alla Tumanian\",\"Arsen Grigoryan\",\"Luiza Nersisyan\",\"Ian Edwards\"],\"direction\":[\"Sean Baker\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/53544c94989b3e6efe91f8b99d3c66b7.jpg\",\"https://all.web.img.acsta.net/pictures/14/12/15/17/03/040197.jpg\",\"https://all.web.img.acsta.net/pictures/15/09/16/17/49/122500.jpg\",\"https://all.web.img.acsta.net/pictures/16/05/13/16/12/094503.jpg\",\"https://all.web.img.acsta.net/pictures/16/05/13/16/12/095128.jpg\",\"https://all.web.img.acsta.net/pictures/16/05/13/16/12/095597.jpg\",\"https://all.web.img.acsta.net/pictures/16/05/13/16/12/096222.jpg\",\"https://all.web.img.acsta.net/pictures/16/05/13/16/13/152822.jpg\",\"https://all.web.img.acsta.net/pictures/16/05/13/16/13/154072.jpg\",\"https://all.web.img.acsta.net/pictures/16/05/13/16/13/154541.jpg\",\"https://all.web.img.acsta.net/pictures/16/05/13/16/13/155010.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/53544c94989b3e6efe91f8b99d3c66b7.jpg\"],\"release\":\"2015-11-13T00:00:00.000Z\",\"advisory\":\"strong language, sex, sex references, drug misuse\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/202462_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/202462_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Metrodome Distribution\"}},{\"id\":\"308\",\"title\":\"Taxi Driver\",\"runtime\":6900,\"genres\":\"Drama, Detective, Thriller\",\"__typename\":\"Movie\",\"altId\":[\"287\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4c874a846412affb468924b04196bea6.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/22/64/19901669.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/22/64/19901662.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/22/64/19901660.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/22/64/19901658.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/22/64/19901655.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/91/08/18880499.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/91/08/18880498.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/91/08/18880494.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/91/08/18880492.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/91/08/18880490.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Martin\",\"lastName\":\"Scorsese\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"De Niro\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jodie\",\"lastName\":\"Foster\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Harvey\",\"lastName\":\"Keitel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cybill\",\"lastName\":\"Shepherd\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Albert\",\"lastName\":\"Brooks\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Leonard\",\"lastName\":\"Harris\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Peter\",\"lastName\":\"Boyle\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Norman\",\"lastName\":\"Matlock\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Diahnne\",\"lastName\":\"Abbott\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Franck\",\"lastName\":\"Adu\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2017-02-10T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"},{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"Contains very strong sex references and child prostitution theme\",\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[]},{\"releasedAt\":\"2026-01-22T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"Contains very strong sex references and child prostitution theme\",\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Taxi Driver\",\"synopsis\":\"Robert De Niro stars with Jodie Foster, Cybill Shepherd, Harvey Keitel, Peter Boyle, and Albert Brooks in the all-too-real story of a psychotic New York cabby who is driven to violence in an attempt to rescue a teenage prostitute.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/287_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/287_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/00/38/00384ea792b4f85786910fa27c89bd38.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4c874a846412affb468924b04196bea6.jpg\",\"synopsis\":\"Selected by the Costume Designers Branch, Everyman presents: Taxi Driver\\n\\nSuffering from insomnia, disturbed loner Travis Bickle (Robert De Niro) takes a job as a New York City cabbie, haunting the streets nightly, growing increasingly detached from reality as he dreams of cleaning up the filthy city. When Travis meets pretty campaign worker Betsy (Cybill Shepherd), he becomes obsessed with the idea of saving the world, first plotting to assassinate a presidential candidate, then directing his attentions toward rescuing 12-year-old prostitute Iris (Jodie Foster).\\n\\nMartin Scorsese’s film of Paul Schrader’s original screenplay about a New York cab driver whose alienation from society leads to violence is one of the defining American films of the 1970s, and earned four Oscar nominations including Best Picture. Oscar-nominee Ruth Morley (The Miracle Worker) had an impressive career designing costumes for film, Broadway, and the opera, and Taxi Driver features some of her most iconic creations, with the unforgettable, Oscar-nominated performances of Robert De Niro and Jodie Foster aided immeasurably by Morley’s distinctive designs. \\n\\nPresented in 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 22 January.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/fef510e4aa640bc3b045a6f3ca7cbb94.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Taxi Driver\",\"synopsis\":\"Selected by the Costume Designers Branch, Everyman presents: Taxi Driver\\n\\nSuffering from insomnia, disturbed loner Travis Bickle (Robert De Niro) takes a job as a New York City cabbie, haunting the streets nightly, growing increasingly detached from reality as he dreams of cleaning up the filthy city. When Travis meets pretty campaign worker Betsy (Cybill Shepherd), he becomes obsessed with the idea of saving the world, first plotting to assassinate a presidential candidate, then directing his attentions toward rescuing 12-year-old prostitute Iris (Jodie Foster).\\n\\nMartin Scorsese’s film of Paul Schrader’s original screenplay about a New York cab driver whose alienation from society leads to violence is one of the defining American films of the 1970s, and earned four Oscar nominations including Best Picture. Oscar-nominee Ruth Morley (The Miracle Worker) had an impressive career designing costumes for film, Broadway, and the opera, and Taxi Driver features some of her most iconic creations, with the unforgettable, Oscar-nominated performances of Robert De Niro and Jodie Foster aided immeasurably by Morley’s distinctive designs. \\n\\nPresented in 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 22 January.\",\"certificate\":\"18\",\"casting\":[\"Robert De Niro\",\"Jodie Foster\",\"Harvey Keitel\",\"Cybill Shepherd\",\"Albert Brooks\",\"Leonard Harris\",\"Peter Boyle\",\"Norman Matlock\",\"Diahnne Abbott\",\"Franck Adu\"],\"direction\":[\"Martin Scorsese\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/fef510e4aa640bc3b045a6f3ca7cbb94.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/22/64/19901669.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/22/64/19901662.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/22/64/19901660.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/22/64/19901658.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/22/64/19901655.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/91/08/18880499.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/91/08/18880498.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/91/08/18880494.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/91/08/18880492.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/91/08/18880490.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/fef510e4aa640bc3b045a6f3ca7cbb94.jpg\"],\"release\":\"2017-02-10T00:00:00.000Z\",\"advisory\":\"Contains very strong sex references and child prostitution theme\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/287_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/287_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"328408\",\"title\":\"The Choral\",\"runtime\":6780,\"genres\":\"Drama, Music, Historical, Romance\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/95e399daa52cf2cd12b6bba8e86af1c2.jpg\",\"__typename\":\"Movie\",\"altId\":[\"361846\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/99/a3/99a3f5566d0ce842182f7cb48f4f37d7.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Nicholas\",\"lastName\":\"Hytner\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ralph\",\"lastName\":\"Fiennes\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Simon Russell\",\"lastName\":\"Beale\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Roger\",\"lastName\":\"Allam\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Amara\",\"lastName\":\"Okereke\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Thomas\",\"lastName\":\"Howes\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jacob\",\"lastName\":\"Dudman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nathan\",\"lastName\":\"Hall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Taylor\",\"lastName\":\"Uttley\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ellie\",\"lastName\":\"Sager\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Reuben\",\"lastName\":\"Bainbridge\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-07T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13762\",\"name\":\"Sony Pictures UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"infrequent strong language, moderate sex\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Choral\",\"synopsis\":\"1916. As war rages on the Western Front, the Choral Society in Ramsden, Yorkshire has lost most of its men to the army. The Choral’s ambitious committee, determined to press ahead, decides to recruit local young males to swell their ranks. They must also engage a new chorus master, and despite their suspicions that he has something to hide, their best bet seems to be Dr. Henry Guthrie (Ralph Fiennes) – driven, uncompromising, and recently returned from a career in Germany. As conscription papers start to arrive, the whole community discovers that the best response to the chaos that is laying waste to their lives is to make music together.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/361846_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/361846_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/4c/b7/4cb7cbe5848dac4af5df9d9eee8aab33.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/95e399daa52cf2cd12b6bba8e86af1c2.jpg\",\"synopsis\":\"1916. As war rages on the Western Front, the Choral Society in Ramsden, Yorkshire has lost most of its men to the army. The Choral’s ambitious committee, determined to press ahead, decides to recruit local young males to swell their ranks. \\n\\nThey must also engage a new chorus master, and despite their suspicions that he has something to hide, their best bet seems to be Dr. Henry Guthrie (Ralph Fiennes) – driven, uncompromising, and recently returned from a career in Germany. As conscription papers start to arrive, the whole community discovers that the best response to the chaos that is laying waste to their lives is to make music together.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Choral\",\"synopsis\":\"1916. As war rages on the Western Front, the Choral Society in Ramsden, Yorkshire has lost most of its men to the army. The Choral’s ambitious committee, determined to press ahead, decides to recruit local young males to swell their ranks. \\n\\nThey must also engage a new chorus master, and despite their suspicions that he has something to hide, their best bet seems to be Dr. Henry Guthrie (Ralph Fiennes) – driven, uncompromising, and recently returned from a career in Germany. As conscription papers start to arrive, the whole community discovers that the best response to the chaos that is laying waste to their lives is to make music together.\",\"certificate\":\"12A\",\"casting\":[\"Ralph Fiennes\",\"Simon Russell Beale\",\"Roger Allam\",\"Amara Okereke\",\"Thomas Howes\",\"Jacob Dudman\",\"Nathan Hall\",\"Taylor Uttley\",\"Ellie Sager\",\"Reuben Bainbridge\"],\"direction\":[\"Nicholas Hytner\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/99/a3/99a3f5566d0ce842182f7cb48f4f37d7.jpg\"],\"heroImages\":[],\"release\":\"2025-11-07T00:00:00.000Z\",\"advisory\":\"infrequent strong language, moderate sex\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/361846_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/361846_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Sony Pictures UK\"}},{\"id\":\"309613\",\"title\":\"The Conjuring: Last Rites\",\"runtime\":8100,\"genres\":\"Horror\",\"__typename\":\"Movie\",\"altId\":[\"369298\",\"388381\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c3e34458b3baef4388f0d5e4a08425e4.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/18/80/18808db779c8bc2d0aba491624ab4f88.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/f4/25/f4256f7fa2d31cf0abaf2df305ce4caa.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/61/32/61329d1938382320cc7e836d5f0b2dcf.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/8d/dc/8ddcb49f500cfccdb5c98603f7819370.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/57/3d/573dd2db1e1000605d04138aaf8cd069.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/85/31/853175d2e31b52c2bc08fba9a54ac15b.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/51/f9/51f9404534bc584afb0f49d256149754.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Michael\",\"lastName\":\"Chaves\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Vera\",\"lastName\":\"Farmiga\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Patrick\",\"lastName\":\"Wilson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mia\",\"lastName\":\"Tomlinson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ben\",\"lastName\":\"Hardy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Steve\",\"lastName\":\"Coulter\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rebecca\",\"lastName\":\"Calder\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elliot\",\"lastName\":\"Cowan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kila\",\"lastName\":\"Lord Cassidy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Beau\",\"lastName\":\"Gadsdon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tilly\",\"lastName\":\"Walker\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-05T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong horror, violence, injury detail\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Conjuring: Last Rites\",\"synopsis\":\"From New Line Cinema comes the ninth entry in the more than $2 billion theatrical Conjuring universe, The Conjuring: Last Rites, directed by franchise veteran Michael Chaves and produced by franchise architects James Wan and Peter Safran.\\n\\nThe Conjuring: Last Rites delivers another thrilling chapter of the iconic Conjuring cinematic universe, based on real events. Vera Farmiga and Patrick Wilson reunite for one last case as renowned, real-life paranormal investigators Ed and Lorraine Warren in a powerful and spine-chilling addition to the global box office-breaking franchise.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/369298_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/369298_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/9e/3f/9e3f56ca4fd1db0e31f626d54f88cf5f.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/7f84816006ffe1ad3a1eea88713eb0dd.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c3e34458b3baef4388f0d5e4a08425e4.jpg\",\"synopsis\":\"In 1986, the Smurl family is terrorised by disembodied voices, violent attacks, and a dark presence that won’t relent. Desperate for help, Ed and Lorraine Warren are called in to confront the evil. What follows is a harrowing battle of courage, faith, and survival as darkness closes in.\\n\\nThe Conjuring: Last Rites delivers another thrilling chapter of the iconic Conjuring cinematic universe, based on real events. Vera Farmiga and Patrick Wilson reunite for one last case as renowned, real-life paranormal investigators Ed and Lorraine Warren in a powerful and spine-chilling addition to the global box office-breaking franchise.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/ee207abc7c40dd1ab2b4d50ea39926e3.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Conjuring: Last Rites\",\"synopsis\":\"In 1986, the Smurl family is terrorised by disembodied voices, violent attacks, and a dark presence that won’t relent. Desperate for help, Ed and Lorraine Warren are called in to confront the evil. What follows is a harrowing battle of courage, faith, and survival as darkness closes in.\\n\\nThe Conjuring: Last Rites delivers another thrilling chapter of the iconic Conjuring cinematic universe, based on real events. Vera Farmiga and Patrick Wilson reunite for one last case as renowned, real-life paranormal investigators Ed and Lorraine Warren in a powerful and spine-chilling addition to the global box office-breaking franchise.\",\"certificate\":\"15\",\"casting\":[\"Vera Farmiga\",\"Patrick Wilson\",\"Mia Tomlinson\",\"Ben Hardy\",\"Steve Coulter\",\"Rebecca Calder\",\"Elliot Cowan\",\"Kila Lord Cassidy\",\"Beau Gadsdon\",\"Tilly Walker\"],\"direction\":[\"Michael Chaves\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/ee207abc7c40dd1ab2b4d50ea39926e3.jpg\",\"https://all.web.img.acsta.net/img/18/80/18808db779c8bc2d0aba491624ab4f88.jpg\",\"https://all.web.img.acsta.net/img/f4/25/f4256f7fa2d31cf0abaf2df305ce4caa.jpg\",\"https://all.web.img.acsta.net/img/61/32/61329d1938382320cc7e836d5f0b2dcf.jpg\",\"https://all.web.img.acsta.net/img/8d/dc/8ddcb49f500cfccdb5c98603f7819370.jpg\",\"https://all.web.img.acsta.net/img/57/3d/573dd2db1e1000605d04138aaf8cd069.jpg\",\"https://all.web.img.acsta.net/img/85/31/853175d2e31b52c2bc08fba9a54ac15b.jpg\",\"https://all.web.img.acsta.net/img/51/f9/51f9404534bc584afb0f49d256149754.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/ee207abc7c40dd1ab2b4d50ea39926e3.jpg\",\"https://cms-assets.webediamovies.pro/production/2/7f84816006ffe1ad3a1eea88713eb0dd.jpg\"],\"release\":\"2025-09-05T00:00:00.000Z\",\"advisory\":\"strong horror, violence, injury detail\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/369298_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/369298_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"}},{\"id\":\"9955\",\"title\":\"The Conversation\",\"runtime\":6780,\"genres\":\"Thriller, Drama, Spy\",\"__typename\":\"Movie\",\"altId\":[\"26317\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4f59210f0769f314a59c8da7b878b9f0.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/03/14/19884209.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/03/14/19884208.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/03/14/19884207.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/65/17/63/18835399.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/02/75/93/027593_ph1.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/210/128/21012837_20130617122849567.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/210/128/21012838_20130617122850052.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/210/128/21012839_20130617122850286.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/210/128/21012840_20130617122850489.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/210/128/21012841_20130617122850645.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Francis Ford\",\"lastName\":\"Coppola\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gene\",\"lastName\":\"Hackman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Cazale\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Allen\",\"lastName\":\"Garfield\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Frederic\",\"lastName\":\"Forrest\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Harrison\",\"lastName\":\"Ford\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Teri\",\"lastName\":\"Garr\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cindy\",\"lastName\":\"Williams\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Duvall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Phoebe\",\"lastName\":\"Alexander\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Shields\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2011-10-31T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"Contains infrequent moderate violence and language\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]},{\"releasedAt\":\"2025-12-04T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"32481\",\"name\":\"Studio Canal\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"moderate violence, language, discriminatory terms\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Conversation\",\"synopsis\":\"Lonely wiretapping expert Harry Caul (Gene Hackman) is hired to record a seemingly innocuous conversation between two lovers (Frederick Forsythe and Cindy Williams). Upon re-hearing the tapes, however, Caul believes he may be putting the couple in danger if he turns the material over to his client (Robert Duvall). But what one hears can ultimately turn out to be quite different from what was actually recorded.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/08/02/0802000d870cdda6457fae83427cdd1e.png\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4f59210f0769f314a59c8da7b878b9f0.jpg\",\"synopsis\":\"Selected by the Sound Branch, Everyman presents: The Conversation\\n\\nSurveillance expert Harry Caul (Gene Hackman) is hired by a mysterious client's brusque aide (Harrison Ford) to tail a young couple, Mark (Frederic Forrest) and Ann (Cindy Williams). Tracking the pair through San Francisco's Union Square, Caul and his associate Stan (John Cazale) manage to record a cryptic conversation between them. Tormented by memories of a previous case that ended badly, Caul becomes obsessed with the resulting tape, trying to determine if the couple are in danger.\\n\\nFrancis Ford Coppola wrote and directed this unnerving paranoid thriller between production of his two Godfather films, with Gene Hackman as a San Francisco surveillance expert who accidentally uncovers evidence of an imminent murder. Few films have featured sound as such a key component of their storyline, and three-time Oscar winner Walter Murch (Apocalypse Now, The English Patient) served as both supervising film editor and sound mixer, working in both capacities to build remarkable tension. The film earned\\n\\nOscar nominations for Best Picture, Coppola’s original screenplay, and Sound (Murch, Arthur Rochester).\\n\\nPresented in 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 4 December.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/becfaff7bd5cc42a41bb0d3486e86fbd.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Conversation\",\"synopsis\":\"Selected by the Sound Branch, Everyman presents: The Conversation\\n\\nSurveillance expert Harry Caul (Gene Hackman) is hired by a mysterious client's brusque aide (Harrison Ford) to tail a young couple, Mark (Frederic Forrest) and Ann (Cindy Williams). Tracking the pair through San Francisco's Union Square, Caul and his associate Stan (John Cazale) manage to record a cryptic conversation between them. Tormented by memories of a previous case that ended badly, Caul becomes obsessed with the resulting tape, trying to determine if the couple are in danger.\\n\\nFrancis Ford Coppola wrote and directed this unnerving paranoid thriller between production of his two Godfather films, with Gene Hackman as a San Francisco surveillance expert who accidentally uncovers evidence of an imminent murder. Few films have featured sound as such a key component of their storyline, and three-time Oscar winner Walter Murch (Apocalypse Now, The English Patient) served as both supervising film editor and sound mixer, working in both capacities to build remarkable tension. The film earned\\n\\nOscar nominations for Best Picture, Coppola’s original screenplay, and Sound (Murch, Arthur Rochester).\\n\\nPresented in 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 4 December.\",\"certificate\":\"12A\",\"casting\":[\"Gene Hackman\",\"John Cazale\",\"Allen Garfield\",\"Frederic Forrest\",\"Harrison Ford\",\"Teri Garr\",\"Cindy Williams\",\"Robert Duvall\",\"Phoebe Alexander\",\"Robert Shields\"],\"direction\":[\"Francis Ford Coppola\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/becfaff7bd5cc42a41bb0d3486e86fbd.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/03/14/19884209.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/03/14/19884208.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/03/14/19884207.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/65/17/63/18835399.jpg\",\"https://all.web.img.acsta.net/medias/02/75/93/027593_ph1.jpg\",\"https://all.web.img.acsta.net/pictures/210/128/21012837_20130617122849567.jpg\",\"https://all.web.img.acsta.net/pictures/210/128/21012838_20130617122850052.jpg\",\"https://all.web.img.acsta.net/pictures/210/128/21012839_20130617122850286.jpg\",\"https://all.web.img.acsta.net/pictures/210/128/21012840_20130617122850489.jpg\",\"https://all.web.img.acsta.net/pictures/210/128/21012841_20130617122850645.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/becfaff7bd5cc42a41bb0d3486e86fbd.jpg\"],\"release\":\"2011-10-31T00:00:00.000Z\",\"advisory\":\"Contains infrequent moderate violence and language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Walt Disney\"}},{\"id\":\"1000034584\",\"title\":\"The Cure: The Show of a Lost World\",\"runtime\":10020,\"genres\":\"Concert\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/3e41012d4526679b74b51bae66e66407.jpg\",\"__typename\":\"Movie\",\"altId\":[\"404839\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[\"https://all.web.img.acsta.net/img/ca/fb/cafb1c691c1747c5b95b051781c8cbb7.jpg\"],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Nick\",\"lastName\":\"Wickham\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Smith\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Simon\",\"lastName\":\"Gallup\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Roger\",\"lastName\":\"O'Donnell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Perry\",\"lastName\":\"Bamonte\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jason\",\"lastName\":\"Cooper\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Reeves\",\"lastName\":\"Gabrels\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-11T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"12\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Cure: The Show of a Lost World\",\"synopsis\":\"On 1st November 2024, THE CURE's widely acclaimed album 'SONGS OF A LOST WORLD' was released. The night of the album's unveiling, The Cure performed the record in full for the first and only time at London’s Troxy in front of 3,000 fans.\\n\\nTHE CURE: THE SHOW OF A LOST WORLD is a recut, remixed and 4K remastered film of that night’s full 31-song show. Directed by Grammy-nominated Nick Wickham, with new surround sound mix by Robert Smith, the film will be released on Thursday 11th December in cinemas worldwide for a limited time only.\\n\\nInitially formed in 1978, The Cure has sold over 30 million albums worldwide, headlined the Glastonbury Festival four times, and been inducted into the Rock and Roll Hall of Fame in 2019. They are considered one of the most influential bands to have ever emerged from the UK.\\n\\nTHE CURE: THE SHOW OF A LOST WORLD was produced and mixed by Robert Smith & Paul Corkett and performed by The Cure - Robert Smith: Voice/guitar/6-string bass, Simon Gallup: Bass, Jason Cooper: Drums/percussion, Roger O'Donnell: Keyboard, Reeves Gabrels: Guitar/6-string bass and Perry Bamonte: Guitar/6-string bass/keyboard.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/6d/d2/6dd2a539193b1154e22ba92c0c699fe9.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/3e41012d4526679b74b51bae66e66407.jpg\",\"synopsis\":\"On 1st November 2024, THE CURE's widely acclaimed Grammy-nominated album 'SONGS OF A LOST WORLD' was released. The night of the album's unveiling, The Cure performed the record in full for the first and only time at London’s Troxy in front of 3,000 fans. THE CURE: THE SHOW OF A LOST WORLD is a recut, remixed and 4K remastered film of that night’s full 31-song show. \\n\\nDirected by Grammy-nominated Nick Wickham, with new surround sound mix by Robert Smith, the film will be released on Thursday 11th December in cinemas worldwide for a limited time only.  Initially formed in 1978, The Cure has sold over 30 million albums worldwide, headlined the Glastonbury Festival four times, and been inducted into the Rock and Roll Hall of Fame in 2019. They are considered one of the most influential bands to have ever emerged from the UK.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Cure : The Show Of A Lost World\",\"synopsis\":\"On 1st November 2024, THE CURE's widely acclaimed Grammy-nominated album 'SONGS OF A LOST WORLD' was released. The night of the album's unveiling, The Cure performed the record in full for the first and only time at London’s Troxy in front of 3,000 fans. THE CURE: THE SHOW OF A LOST WORLD is a recut, remixed and 4K remastered film of that night’s full 31-song show. \\n\\nDirected by Grammy-nominated Nick Wickham, with new surround sound mix by Robert Smith, the film will be released on Thursday 11th December in cinemas worldwide for a limited time only.  Initially formed in 1978, The Cure has sold over 30 million albums worldwide, headlined the Glastonbury Festival four times, and been inducted into the Rock and Roll Hall of Fame in 2019. They are considered one of the most influential bands to have ever emerged from the UK.\",\"certificate\":\"12\",\"casting\":[\"Robert Smith\",\"Simon Gallup\",\"Roger O'Donnell\",\"Perry Bamonte\",\"Jason Cooper\",\"Reeves Gabrels\"],\"direction\":[\"Nick Wickham\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-12-11T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"180\",\"title\":\"The Elephant Man\",\"runtime\":7500,\"genres\":\"Drama, Biopic\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/cd1392413580c7abd3facd6ad618ce95.jpg\",\"__typename\":\"Movie\",\"altId\":[\"27763\"],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887477.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887476.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887475.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887474.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887473.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/90/89/18835878.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/90/89/18835876.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887472.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887471.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887470.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"David\",\"lastName\":\"Lynch\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anthony\",\"lastName\":\"Hopkins\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Hurt\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anne\",\"lastName\":\"Bancroft\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Gielgud\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Wendy\",\"lastName\":\"Hiller\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Freddie\",\"lastName\":\"Jones\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hannah\",\"lastName\":\"Gordon\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Elphick\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lesley\",\"lastName\":\"Dunlop\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Helen\",\"lastName\":\"Ryan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2020-03-13T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"9447\",\"name\":\"StudioCanal UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"Contains mild horror and violence\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[]},{\"releasedAt\":\"2026-01-15T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"32481\",\"name\":\"Studio Canal\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"moderate threat, upsetting scenes, injury detail\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Elephant Man\",\"synopsis\":\"John Hunt starts as the elephant man, John Merrick, in this moving and unforgettable true story of cruelty, humanity and survival. Merrick, a man affected with a terrible disability, is shunned by Victorian Society. An ambitious young doctor (Hopkins) sets out to help him, and discovers a man of sensibility and kindness beneath the surface.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/cd1392413580c7abd3facd6ad618ce95.jpg\",\"synopsis\":\"Selected by the Makeup Artists and Hairstylists Branch, Everyman presents: The Elephant Man\\n\\nJohn Hunt stars as the Elephant Man, John Merrick, in this moving and unforgettable true story of cruelty, humanity, and survival. Merrick, a man affected with a terrible disability, is shunned by Victorian Society. An ambitious young doctor (Hopkins) sets out to help him and discovers a man of sensibility and kindness beneath the surface.\\n\\nJohn Hurt gave a heartrending, Oscar-nominated performance as the title character in The Elephant Man with the aid of elaborate prosthetic makeup by Christopher Tucker that accurately recreated the unusual features of the real-life Joseph Merrick. The film was the first “mainstream” effort from director David Lynch, who brought his distinctive sensibility and striking visual style to this moving biopic, which featured widescreen black-and-white cinematography by Freddie Francis (Glory). \\n\\nPresented in 2k.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/eee5e4cd6541f9a9282b974f2afb8832.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Elephant Man\",\"synopsis\":\"Selected by the Makeup Artists and Hairstylists Branch, Everyman presents: The Elephant Man\\n\\nJohn Hunt stars as the Elephant Man, John Merrick, in this moving and unforgettable true story of cruelty, humanity, and survival. Merrick, a man affected with a terrible disability, is shunned by Victorian Society. An ambitious young doctor (Hopkins) sets out to help him and discovers a man of sensibility and kindness beneath the surface.\\n\\nJohn Hurt gave a heartrending, Oscar-nominated performance as the title character in The Elephant Man with the aid of elaborate prosthetic makeup by Christopher Tucker that accurately recreated the unusual features of the real-life Joseph Merrick. The film was the first “mainstream” effort from director David Lynch, who brought his distinctive sensibility and striking visual style to this moving biopic, which featured widescreen black-and-white cinematography by Freddie Francis (Glory). \\n\\nPresented in 2k.\",\"certificate\":\"PG\",\"casting\":[\"Anthony Hopkins\",\"John Hurt\",\"Anne Bancroft\",\"John Gielgud\",\"Wendy Hiller\",\"Freddie Jones\",\"Hannah Gordon\",\"Michael Elphick\",\"Lesley Dunlop\",\"Helen Ryan\"],\"direction\":[\"David Lynch\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/eee5e4cd6541f9a9282b974f2afb8832.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887477.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887476.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887475.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887474.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887473.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/90/89/18835878.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/90/89/18835876.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887472.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887471.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/06/76/19887470.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/eee5e4cd6541f9a9282b974f2afb8832.jpg\"],\"release\":\"2020-03-13T00:00:00.000Z\",\"advisory\":\"Contains mild horror and violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"StudioCanal UK\"}},{\"id\":\"1000034825\",\"title\":\"The Fan Girl Nation Presents: The Twilight Saga\",\"runtime\":45000,\"genres\":\"Fantasy, Drama, Romance\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/fc0d38c4f1535d04f89d2da617963a8d.jpg\",\"__typename\":\"Movie\",\"altId\":[\"405104\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"directors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"releases\":[{\"releasedAt\":\"2025-11-16T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"12\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Fangirl Nation Presents: The Twilight Saga\",\"synopsis\":null,\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"The Fan Girl Nation Presents: The Twilight Saga\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/fc0d38c4f1535d04f89d2da617963a8d.jpg\",\"synopsis\":\"It’s time to step back into the foggy forests of Forks.\\n\\n Join The Fangirl Nation & Ambar Lee for the ultimate Twilight experience, a full day Twilight Saga Marathon, celebrating the love story that defined an era.\\n\\nFrom Twilight to Breaking Dawn – Part 2, relive every moment of Bella and Edward’s story on the big screen, from the comfort of an Everyman sofa. \\n\\nYour ticket includes:\\n\\n- Breakfast pastries \\n- Popcorn \\n- Homemade pizza for lunch \\n- A twilight blu-ray to take home \\n- A goody bag \\n- Plus a few extra surprises!\\n\\nWhether you’re Team Edward, Team Jacob, or Team Charlie (we don’t judge), it’s time to sparkle like a Cullen.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Fangirl Nation Presents: The Twilight Saga\",\"synopsis\":\"It’s time to step back into the foggy forests of Forks.\\n\\n Join The Fangirl Nation & Ambar Lee for the ultimate Twilight experience, a full day Twilight Saga Marathon, celebrating the love story that defined an era.\\n\\nFrom Twilight to Breaking Dawn – Part 2, relive every moment of Bella and Edward’s story on the big screen, from the comfort of an Everyman sofa. \\n\\nYour ticket includes:\\n\\n- Breakfast pastries \\n- Popcorn \\n- Homemade pizza for lunch \\n- A twilight blu-ray to take home \\n- A goody bag \\n- Plus a few extra surprises!\\n\\nWhether you’re Team Edward, Team Jacob, or Team Charlie (we don’t judge), it’s time to sparkle like a Cullen.\",\"certificate\":\"12\",\"casting\":[],\"direction\":[],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-11-16T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"28201\",\"title\":\"The Godfather: Part II\",\"runtime\":12000,\"genres\":\"Detective, Drama\",\"__typename\":\"Movie\",\"altId\":[\"71112\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/3d4397da893d04ba9614a4fa2667a2cc.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18861224.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18861223.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18861222.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18861221.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18861220.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18660527.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18660525.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18660524.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Francis Ford\",\"lastName\":\"Coppola\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Al\",\"lastName\":\"Pacino\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"De Niro\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Diane\",\"lastName\":\"Keaton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kathleen\",\"lastName\":\"Beller\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ignazio\",\"lastName\":\"Pappalardo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Roman\",\"lastName\":\"Coppola\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sofia\",\"lastName\":\"Coppola\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Megna\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gary\",\"lastName\":\"Kurtz\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sho\",\"lastName\":\"Kosugi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2022-03-04T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13760\",\"name\":\"Paramount Pictures UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong bloody violence, language\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]},{\"releasedAt\":\"2026-01-08T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13760\",\"name\":\"Paramount Pictures UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong violence, bloody images, domestic abuse\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Godfather: Part II\",\"synopsis\":\"Continuing saga of the Corleone family as they move to Nevada and make the casino business their major income source under the leadership of the increasingly paranoid and malevolent Michael, whose reign as the \\\"Don\\\" is juxtaposed against the parallel tale of his father's escape from Sicily as a young boy and his subsequent rise to power in New York's Lower East Side during the turn-of-the-century.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/24/7f/247f39bec2d5eb54c44eb870b1aec5a0.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/3d4397da893d04ba9614a4fa2667a2cc.jpg\",\"synopsis\":\"Selected by the Executives Branch, Everyman presents: The Godfather: Part II\\n\\nContinuing saga of the Corleone family as they move to Nevada and make the casino business their major income source under the leadership of the increasingly paranoid and malevolent Michael, whose reign as the \\\"Don\\\" is juxtaposed against the parallel tale of his father's escape from Sicily as a young boy and his subsequent rise to power in New York's Lower East Side during the turn-of-the-century.\\n\\nThe Godfather: Part II is often cited as the rare example of a sequel that equals or even surpasses the original. Both a sequel and a prequel, the film extends the tragic story of Michael Corleone and his family into the late 1950s while looking back at young Vito (Robert De Niro in an Oscar-winning performance) and his experience as an immigrant in New York, in a gorgeously crafted production rich with novelistic detail. \\n\\nPresented in 4k, the feature returns to the big screen at Everyman The Whiteley on Thursday.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/425d9104a62854175d49ad9e7f0d4e42.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Godfather: Part II\",\"synopsis\":\"Selected by the Executives Branch, Everyman presents: The Godfather: Part II\\n\\nContinuing saga of the Corleone family as they move to Nevada and make the casino business their major income source under the leadership of the increasingly paranoid and malevolent Michael, whose reign as the \\\"Don\\\" is juxtaposed against the parallel tale of his father's escape from Sicily as a young boy and his subsequent rise to power in New York's Lower East Side during the turn-of-the-century.\\n\\nThe Godfather: Part II is often cited as the rare example of a sequel that equals or even surpasses the original. Both a sequel and a prequel, the film extends the tragic story of Michael Corleone and his family into the late 1950s while looking back at young Vito (Robert De Niro in an Oscar-winning performance) and his experience as an immigrant in New York, in a gorgeously crafted production rich with novelistic detail. \\n\\nPresented in 4k, the feature returns to the big screen at Everyman The Whiteley on Thursday.\",\"certificate\":\"15\",\"casting\":[\"Al Pacino\",\"Robert De Niro\",\"Diane Keaton\",\"Kathleen Beller\",\"Ignazio Pappalardo\",\"Roman Coppola\",\"Sofia Coppola\",\"John Megna\",\"Gary Kurtz\",\"Sho Kosugi\"],\"direction\":[\"Francis Ford Coppola\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/425d9104a62854175d49ad9e7f0d4e42.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18861224.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18861223.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18861222.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18861221.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18861220.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18660527.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18660525.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/24/16/18660524.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/425d9104a62854175d49ad9e7f0d4e42.jpg\"],\"release\":\"2022-03-04T00:00:00.000Z\",\"advisory\":\"strong bloody violence, language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Paramount Pictures UK\"}},{\"id\":\"38827\",\"title\":\"The Great Escape\",\"runtime\":10140,\"genres\":\"War movie, Drama\",\"__typename\":\"Movie\",\"altId\":[\"10650\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c80213a8c4133f18caf5b8dc548401fa.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3826355.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3751475.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3782675.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3767075.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3796715.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3812315.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/50/5622128.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/50/5608088.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/50/5594048.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/09/01/10/50/5580008.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"John\",\"lastName\":\"Sturges\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Steve\",\"lastName\":\"McQueen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Charles\",\"lastName\":\"Bronson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Donald\",\"lastName\":\"Pleasence\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"James\",\"lastName\":\"Donald\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"James\",\"lastName\":\"Coburn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hannes\",\"lastName\":\"Messemer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"David\",\"lastName\":\"McCallum\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gordon\",\"lastName\":\"Jackson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Leyton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Angus\",\"lastName\":\"Lennie\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2020-12-18T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[]},{\"releasedAt\":\"2025-11-13T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild violence, language, injury detail\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Great Escape\",\"synopsis\":\"John Sturges dramatisation of the true story of a group of British, American and Canadian POWs who successfully escaped from Stalag Luft III in Upper Silesia in March 1944 is arguably the best World War II adventure film ever made. A host of big-name stars meshes beautifully in this meticulous recreation of the legendary escape. Although this is a film about courage, Sturges wisely takes a low-key approach, leavened with humour, rather than allowing the cast to indulge in macho antics.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/5d/ef/5def2693c01c57164f6fe0e996ed806c.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c80213a8c4133f18caf5b8dc548401fa.jpg\",\"synopsis\":\"Selected by the Music Branch, Everyman presents: The Great Escape\\n\\nImprisoned during World War II in a German POW camp, a group of Allied soldiers are intent on breaking out, not only to escape, but also to draw Nazi forces away from battle to search for fugitives. Outwitting their captors by digging a tunnel out of the prison grounds, the soldiers find the stakes much higher when escape becomes a reality.\\n\\nSteve McQueen leads a star-studded cast in this fact-based story about a group of Allied soldiers plotting a daring escape from a German POW camp. McQueen’s fellow prisoners include Richard Attenborough, James Garner, Charles Bronson, Donald Pleasence, and James Coburn. Director John Sturges manages to maintain a balance of humor and tension over the film’s epic runtime with the help of Oscar-nominated editing by Ferris Webster. For the film’s music, Sturges reunited with his The Magnificent Seven (1960) composer Elmer Bernstein, whose rousing score features a memorable march that is one of Bernstein’s most popular and enduring melodies. \\n\\nThe feature returns to the big screen at Everyman at The Whiteley on Thursday, 13 November.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/c53bb85b0605dfd86cf460a08e57ee4f.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Great Escape\",\"synopsis\":\"Selected by the Music Branch, Everyman presents: The Great Escape\\n\\nImprisoned during World War II in a German POW camp, a group of Allied soldiers are intent on breaking out, not only to escape, but also to draw Nazi forces away from battle to search for fugitives. Outwitting their captors by digging a tunnel out of the prison grounds, the soldiers find the stakes much higher when escape becomes a reality.\\n\\nSteve McQueen leads a star-studded cast in this fact-based story about a group of Allied soldiers plotting a daring escape from a German POW camp. McQueen’s fellow prisoners include Richard Attenborough, James Garner, Charles Bronson, Donald Pleasence, and James Coburn. Director John Sturges manages to maintain a balance of humor and tension over the film’s epic runtime with the help of Oscar-nominated editing by Ferris Webster. For the film’s music, Sturges reunited with his The Magnificent Seven (1960) composer Elmer Bernstein, whose rousing score features a memorable march that is one of Bernstein’s most popular and enduring melodies. \\n\\nThe feature returns to the big screen at Everyman at The Whiteley on Thursday, 13 November.\",\"certificate\":\"PG\",\"casting\":[\"Steve McQueen\",\"Charles Bronson\",\"Donald Pleasence\",\"James Donald\",\"James Coburn\",\"Hannes Messemer\",\"David McCallum\",\"Gordon Jackson\",\"John Leyton\",\"Angus Lennie\"],\"direction\":[\"John Sturges\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/c53bb85b0605dfd86cf460a08e57ee4f.jpg\",\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3826355.jpg\",\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3751475.jpg\",\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3782675.jpg\",\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3767075.jpg\",\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3796715.jpg\",\"https://all.web.img.acsta.net/pictures/23/09/01/10/51/3812315.jpg\",\"https://all.web.img.acsta.net/pictures/23/09/01/10/50/5622128.jpg\",\"https://all.web.img.acsta.net/pictures/23/09/01/10/50/5608088.jpg\",\"https://all.web.img.acsta.net/pictures/23/09/01/10/50/5594048.jpg\",\"https://all.web.img.acsta.net/pictures/23/09/01/10/50/5580008.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/c53bb85b0605dfd86cf460a08e57ee4f.jpg\"],\"release\":\"2020-12-18T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"218476\",\"title\":\"The Grinch\",\"runtime\":5160,\"genres\":\"Animation, Family\",\"__typename\":\"Movie\",\"altId\":[\"180055\",\"269428\",\"280676\",\"284163\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ac9466d0b20be647406c6d107cfffb79.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/pictures/18/03/09/10/04/5692107.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/03/09/10/04/5663982.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/03/09/10/04/5632731.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/07/12/17/09/1394984.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/07/12/17/09/1380921.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/07/12/17/09/1438734.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/07/12/17/09/1366859.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/07/12/17/09/1352796.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/07/12/17/09/1423109.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/18/07/12/17/09/1338734.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Scott\",\"lastName\":\"Mosier\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Yarrow\",\"lastName\":\"Cheney\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Benedict\",\"lastName\":\"Cumberbatch\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Cameron\",\"lastName\":\"Seely\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Pharrell\",\"lastName\":\"Williams\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Rashida\",\"lastName\":\"Jones\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Tristan\",\"lastName\":\"O’Hare\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Kenan\",\"lastName\":\"Thompson\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Sam\",\"lastName\":\"Lavagnino\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Scarlett\",\"lastName\":\"Estevez\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Angela\",\"lastName\":\"Lansbury\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Ramone\",\"lastName\":\"Hamilton\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2021-11-26T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"},{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild slapstick, very mild bad language\",\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Grinch\",\"synopsis\":\"The Grinch tells the story of a cynical grump who goes on a mission to steal Christmas, only to have his heart changed by a young girl's generous holiday spirit. Funny, heartwarming and visually stunning, it's a universal story about the spirit of Christmas and the indomitable power of optimism.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/180055_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/180055_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/d9/28/d928fc12e28c0aad51fee4ac85c8dd23.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ac9466d0b20be647406c6d107cfffb79.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/f0198f12dc9b4097e24b4d58a7552e1a.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Dr. Seuss' The Grinch\",\"synopsis\":\"The Grinch tells the story of a cynical grump who goes on a mission to steal Christmas, only to have his heart changed by a young girl's generous holiday spirit. Funny, heartwarming and visually stunning, it's a universal story about the spirit of Christmas and the indomitable power of optimism.\",\"certificate\":\"U\",\"casting\":[\"Benedict Cumberbatch\",\"Cameron Seely\",\"Pharrell Williams\",\"Rashida Jones\",\"Tristan O’Hare\",\"Kenan Thompson\",\"Sam Lavagnino\",\"Scarlett Estevez\",\"Angela Lansbury\",\"Ramone Hamilton\"],\"direction\":[\"Scott Mosier\",\"Yarrow Cheney\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/f0198f12dc9b4097e24b4d58a7552e1a.jpg\",\"https://all.web.img.acsta.net/pictures/18/03/09/10/04/5692107.jpg\",\"https://all.web.img.acsta.net/pictures/18/03/09/10/04/5663982.jpg\",\"https://all.web.img.acsta.net/pictures/18/03/09/10/04/5632731.jpg\",\"https://all.web.img.acsta.net/pictures/18/07/12/17/09/1394984.jpg\",\"https://all.web.img.acsta.net/pictures/18/07/12/17/09/1380921.jpg\",\"https://all.web.img.acsta.net/pictures/18/07/12/17/09/1438734.jpg\",\"https://all.web.img.acsta.net/pictures/18/07/12/17/09/1366859.jpg\",\"https://all.web.img.acsta.net/pictures/18/07/12/17/09/1352796.jpg\",\"https://all.web.img.acsta.net/pictures/18/07/12/17/09/1423109.jpg\",\"https://all.web.img.acsta.net/pictures/18/07/12/17/09/1338734.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/f0198f12dc9b4097e24b4d58a7552e1a.jpg\"],\"release\":\"2021-11-26T00:00:00.000Z\",\"advisory\":\"mild slapstick, very mild bad language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/180055_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/180055_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"293640\",\"title\":\"The Holdovers\",\"runtime\":8040,\"genres\":\"Comedy, Drama\",\"__typename\":\"Movie\",\"altId\":[\"342791\"],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"poster\":\"https://cms-assets.webediamovies.pro/production/279/b525c53db133f42db5e3fc566138530d.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5186683.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5219443.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5141444.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5155484.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5111804.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5202283.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5233483.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5082165.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5125844.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5169524.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Alexander\",\"lastName\":\"Payne\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Paul\",\"lastName\":\"Giamatti\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Da’vine Joy\",\"lastName\":\"Randolph\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dominic\",\"lastName\":\"Sessa\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Carrie\",\"lastName\":\"Preston\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Andrew\",\"lastName\":\"Garman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tate\",\"lastName\":\"Donovan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gillian\",\"lastName\":\"Vigman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brady\",\"lastName\":\"Hepner\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Naheem\",\"lastName\":\"Garcia\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jim\",\"lastName\":\"Kaplan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2024-01-19T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong language, brief nudity\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Holdovers\",\"synopsis\":\"From acclaimed director Alexander Payne, THE HOLDOVERS follows a curmudgeonly instructor (Paul Giamatti) at an elite New England prep school who is forced to remain on campus during Christmas break to babysit the handful of students with nowhere to go.  Eventually he forms an unlikely bond with one of them -- a damaged, brainy troublemaker (newcomer Dominic Sessa) -- and with the school's head cook, who has just lost a son in Vietnam (Da'Vine Joy Randolph).\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/342791_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/342791_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/72/d2/72d2e1417262cd95e9f09beaa1458f0a.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/b525c53db133f42db5e3fc566138530d.jpg\",\"synopsis\":\"In \\\"The Holdovers,\\\" directed by Alexander Payne, Paul Hunham (Paul Giamatti), an unpopular history teacher at Barton Academy, begrudgingly stays on campus over the 1970 Christmas break to supervise students unable to go home. \\n\\nAmong the remaining few is Angus (Dominic Sessa), a 15-year-old troublemaker with academic potential. The unlikely trio is completed by Mary (Da'Vine Joy Randolph), the school's head cook, mourning the loss of her son in Vietnam. Despite initial animosity, the three form an unconventional Christmas family, navigating misadventures amidst the snowy landscapes of New England. \\n\\nAs they confront their individual pasts, the bond strengthens, and they realise the power to shape their futures isn't confined by their histories. The Holdovers is a heartwarming comedy-drama about unexpected connections and the transformative nature of shared experiences.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/0178c3b8a938c11c821dfe32fdf525b8.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Holdovers\",\"synopsis\":\"In \\\"The Holdovers,\\\" directed by Alexander Payne, Paul Hunham (Paul Giamatti), an unpopular history teacher at Barton Academy, begrudgingly stays on campus over the 1970 Christmas break to supervise students unable to go home. \\n\\nAmong the remaining few is Angus (Dominic Sessa), a 15-year-old troublemaker with academic potential. The unlikely trio is completed by Mary (Da'Vine Joy Randolph), the school's head cook, mourning the loss of her son in Vietnam. Despite initial animosity, the three form an unconventional Christmas family, navigating misadventures amidst the snowy landscapes of New England. \\n\\nAs they confront their individual pasts, the bond strengthens, and they realise the power to shape their futures isn't confined by their histories. The Holdovers is a heartwarming comedy-drama about unexpected connections and the transformative nature of shared experiences.\",\"certificate\":\"15\",\"casting\":[\"Paul Giamatti\",\"Da’vine Joy Randolph\",\"Dominic Sessa\",\"Carrie Preston\",\"Andrew Garman\",\"Tate Donovan\",\"Gillian Vigman\",\"Brady Hepner\",\"Naheem Garcia\",\"Jim Kaplan\"],\"direction\":[\"Alexander Payne\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/0178c3b8a938c11c821dfe32fdf525b8.jpg\",\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5186683.jpg\",\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5219443.jpg\",\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5141444.jpg\",\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5155484.jpg\",\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5111804.jpg\",\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5202283.jpg\",\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5233483.jpg\",\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5082165.jpg\",\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5125844.jpg\",\"https://all.web.img.acsta.net/pictures/23/11/24/17/15/5169524.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/0178c3b8a938c11c821dfe32fdf525b8.jpg\"],\"release\":\"2024-01-19T00:00:00.000Z\",\"advisory\":\"strong language, brief nudity\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/342791_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/342791_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Universal International Pictures\"}},{\"id\":\"1000033712\",\"title\":\"The Holiday (35mm)\",\"runtime\":7860,\"genres\":\"Comedy, Romance\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/6edcbcdc688e99c586134f40175c35b3.jpg\",\"__typename\":\"Movie\",\"altId\":[\"403797\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Nancy\",\"lastName\":\"Meyers\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cameron\",\"lastName\":\"Diaz\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kate\",\"lastName\":\"Winslet\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jude\",\"lastName\":\"Law\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-01T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Holiday (35mm)\",\"synopsis\":\"Iris is in love with a man who is about to marry another woman. Across the globe, Amanda realizes the man she lives with has been unfaithful. Two women who have never met and live 6000 miles apart, find themselves in the exact same place. They meet online at a home exchange website and impulsively switch homes for the holiday. Iris moves into Amanda's L.A. house in sunny California as Amanda arrives in the snow covered English countryside. Shortly after arriving at their destinations, both women find the last thing either wants or expects: a new romance. Amanda is charmed by Iris' handsome brother Graham and Iris, with inspiration provided by legendary screenwriter Arthur, mends her heart when she meets film composer Miles.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/51/3e/513e37f8b9d2d657e9ff6f0f7b2fa454.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/6edcbcdc688e99c586134f40175c35b3.jpg\",\"synopsis\":\"Iris is in love with a man who is about to marry another woman. Across the globe, Amanda realizes the man she lives with has been unfaithful. Two women who have never met and live 6000 miles apart, find themselves in the exact same place. They meet online at a home exchange website and impulsively switch homes for the holiday. Iris moves into Amanda's L.A. house in sunny California as Amanda arrives in the snow covered English countryside. Shortly after arriving at their destinations, both women find the last thing either wants or expects: a new romance. Amanda is charmed by Iris' handsome brother Graham and Iris, with inspiration provided by legendary screenwriter Arthur, mends her heart when she meets film composer Miles.\\n\\nScreening in stunning 35mm at Christmas on the Green this winter.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Holiday (35mm)\",\"synopsis\":\"Iris is in love with a man who is about to marry another woman. Across the globe, Amanda realizes the man she lives with has been unfaithful. Two women who have never met and live 6000 miles apart, find themselves in the exact same place. They meet online at a home exchange website and impulsively switch homes for the holiday. Iris moves into Amanda's L.A. house in sunny California as Amanda arrives in the snow covered English countryside. Shortly after arriving at their destinations, both women find the last thing either wants or expects: a new romance. Amanda is charmed by Iris' handsome brother Graham and Iris, with inspiration provided by legendary screenwriter Arthur, mends her heart when she meets film composer Miles.\\n\\nScreening in stunning 35mm at Christmas on the Green this winter.\",\"certificate\":\"12A\",\"casting\":[\"Cameron Diaz\",\"Kate Winslet\",\"Jude Law\"],\"direction\":[\"Nancy Meyers\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-12-01T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Universal International Pictures\"}},{\"id\":\"317403\",\"title\":\"The Housemaid\",\"runtime\":7860,\"genres\":\"Thriller\",\"__typename\":\"Movie\",\"altId\":[\"377235\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/292660c46d63879ccc2bea9576d8d245.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/6c/78/6c7894999ba2fdb52a7faca437aa8c17.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/b7/b0/b7b0748d96a509101b6c6e2b0d9749c6.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/3f/72/3f72a4345de2f1a93dbf8bb3052ba7f4.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/d0/24/d024f3ce64288d52fe496a95b8bc9d27.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/49/8d/498dc8c1eab1c0cf30a53abbffeffa2c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/f2/dc/f2dcd148cbbb44a015f38bb1c28c1709.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c9/8b/c98b815b5f18547fb4c0efba7a2b250e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/f8/93/f89381255d51777e27dc39aca0c5a6f2.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/60/19/6019a0e042c80680eaca19ca1463b2c7.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/80/c2/80c205a98189f8402c10445ab368a587.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Paul\",\"lastName\":\"Feig\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sydney\",\"lastName\":\"Sweeney\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Amanda\",\"lastName\":\"Seyfried\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brandon\",\"lastName\":\"Sklenar\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michele\",\"lastName\":\"Morrone\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Indiana\",\"lastName\":\"Elle\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elizabeth\",\"lastName\":\"Perkins\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ellen\",\"lastName\":\"Tamaki\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Megan\",\"lastName\":\"Ferguson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brian D.\",\"lastName\":\"Cohen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maury\",\"lastName\":\"Ginsberg\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-26T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13832\",\"name\":\"Lionsgate UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong violence, injury detail, sex, sexual violence, very strong language\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Housemaid\",\"synopsis\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous — a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/377235_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/377235_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/33/f9/33f95e75ff07f9c31b1d166968b39725.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/e203b52b78840203ce5a8e22aeb22b2c.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/292660c46d63879ccc2bea9576d8d245.jpg\",\"synopsis\":\"Trying to escape her past, Millie (Sydnery Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Amanda Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous - a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/86da5349eb0b35c8aa9647a8050b4433.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Housemaid\",\"synopsis\":\"Trying to escape her past, Millie (Sydnery Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Amanda Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous - a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"certificate\":\"15\",\"casting\":[\"Sydney Sweeney\",\"Amanda Seyfried\",\"Brandon Sklenar\",\"Michele Morrone\",\"Indiana Elle\",\"Elizabeth Perkins\",\"Ellen Tamaki\",\"Megan Ferguson\",\"Brian D. Cohen\",\"Maury Ginsberg\"],\"direction\":[\"Paul Feig\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/86da5349eb0b35c8aa9647a8050b4433.jpg\",\"https://all.web.img.acsta.net/img/6c/78/6c7894999ba2fdb52a7faca437aa8c17.jpg\",\"https://all.web.img.acsta.net/img/b7/b0/b7b0748d96a509101b6c6e2b0d9749c6.jpg\",\"https://all.web.img.acsta.net/img/3f/72/3f72a4345de2f1a93dbf8bb3052ba7f4.jpg\",\"https://all.web.img.acsta.net/img/d0/24/d024f3ce64288d52fe496a95b8bc9d27.jpg\",\"https://all.web.img.acsta.net/img/49/8d/498dc8c1eab1c0cf30a53abbffeffa2c.jpg\",\"https://all.web.img.acsta.net/img/f2/dc/f2dcd148cbbb44a015f38bb1c28c1709.jpg\",\"https://all.web.img.acsta.net/img/c9/8b/c98b815b5f18547fb4c0efba7a2b250e.jpg\",\"https://all.web.img.acsta.net/img/f8/93/f89381255d51777e27dc39aca0c5a6f2.jpg\",\"https://all.web.img.acsta.net/img/60/19/6019a0e042c80680eaca19ca1463b2c7.jpg\",\"https://all.web.img.acsta.net/img/80/c2/80c205a98189f8402c10445ab368a587.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/86da5349eb0b35c8aa9647a8050b4433.jpg\",\"https://cms-assets.webediamovies.pro/production/2/e203b52b78840203ce5a8e22aeb22b2c.jpg\"],\"release\":\"2025-12-26T00:00:00.000Z\",\"advisory\":\"strong violence, injury detail, sex, sexual violence, very strong language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/377235_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/377235_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Lionsgate UK\"}},{\"id\":\"21709\",\"title\":\"The Iron Giant\",\"runtime\":5100,\"genres\":\"Animation, Action, Adventure, Science fiction\",\"__typename\":\"Movie\",\"altId\":[\"20682\",\"202598\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ed3239379df1498a4111a1654985a296.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975816.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975815.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975814.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975813.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975812.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975811.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975810.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975809.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975808.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975807.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Brad\",\"lastName\":\"Bird\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Eli\",\"lastName\":\"Marienthal\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Vin\",\"lastName\":\"Diesel\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Jennifer\",\"lastName\":\"Aniston\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Harry\",\"lastName\":\"Connick Jr\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Cloris\",\"lastName\":\"Leachman\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"John\",\"lastName\":\"Mahoney\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"M. Emmet\",\"lastName\":\"Walsh\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"James\",\"lastName\":\"Gammon\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Christopher\",\"lastName\":\"MacDonald\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"1999-12-17T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild fantasy action violence, infrequent mild bad language\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[]},{\"releasedAt\":\"2025-12-18T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild fantasy action violence, infrequent mild bad language\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Iron Giant\",\"synopsis\":\"\\\"Iron Giant\\\" is based upon the 1968 story,'Iron Man,' by the British poet laureate Ted Hughes. The film is about a giant metal machine that drops from the sky and frightens a small town in Maine in 1958, only to find a friend named, Hogarth, that ultimately finds its humanity and saving the towns people of their fears and prejudices.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/4a/ec/4aec12342e0956b6e97e1b70469d91c2.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ed3239379df1498a4111a1654985a296.jpg\",\"synopsis\":\"Selected by the Animation Branch, Everyman presents: The Iron Giant\\n\\nBrad Bird (The Incredibles, Ratatouille) made his feature directing debut with this lively and moving animated adventure loosely inspired by an illustrated children’s novel by poet Ted Hughes. The life of a young boy (voiced by Eli Marienthal) in 1950s Maine is turned upside down when he finds a new friend in a 50-foot-tall alien robot. Bird evocatively recreates the visual iconography of ’50s genre cinema while presenting a humanist message, and his film has developed a devoted fandom in the near quarter-century since its release.  \\n\\nReleased in 1999, The Iron Giant went on to collect 18 award nominations and 20 wins, including the BAFTA Children’s Award for Best Feature Film. The film has since been celebrated for its artistry, earning recognition from the Annie Awards, the Hugo Awards, and the Saturn Awards.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 18 December.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/0e97150921cb575be79e3efdd7bdecd4.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Iron Giant\",\"synopsis\":\"Selected by the Animation Branch, Everyman presents: The Iron Giant\\n\\nBrad Bird (The Incredibles, Ratatouille) made his feature directing debut with this lively and moving animated adventure loosely inspired by an illustrated children’s novel by poet Ted Hughes. The life of a young boy (voiced by Eli Marienthal) in 1950s Maine is turned upside down when he finds a new friend in a 50-foot-tall alien robot. Bird evocatively recreates the visual iconography of ’50s genre cinema while presenting a humanist message, and his film has developed a devoted fandom in the near quarter-century since its release.  \\n\\nReleased in 1999, The Iron Giant went on to collect 18 award nominations and 20 wins, including the BAFTA Children’s Award for Best Feature Film. The film has since been celebrated for its artistry, earning recognition from the Annie Awards, the Hugo Awards, and the Saturn Awards.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 18 December.\",\"certificate\":\"PG\",\"casting\":[\"Eli Marienthal\",\"Vin Diesel\",\"Jennifer Aniston\",\"Harry Connick Jr\",\"Cloris Leachman\",\"John Mahoney\",\"M. Emmet Walsh\",\"James Gammon\",\"Christopher MacDonald\"],\"direction\":[\"Brad Bird\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/0e97150921cb575be79e3efdd7bdecd4.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975816.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975815.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975814.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975813.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975812.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975811.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975810.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975809.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975808.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/11/19975807.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/0e97150921cb575be79e3efdd7bdecd4.jpg\"],\"release\":\"1999-12-17T00:00:00.000Z\",\"advisory\":\"mild fantasy action violence, infrequent mild bad language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"}},{\"id\":\"1000021616\",\"title\":\"The MET Opera 2025-26 : El Último Sueño de Frida y Diego\",\"runtime\":10080,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"388908\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/12488f1932717fcea5b57f91d6c52b1c.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Deborah\",\"lastName\":\"Colker\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gabriella\",\"lastName\":\"Reyes\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Isabel\",\"lastName\":\"Leonard\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nils\",\"lastName\":\"Wanderer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Carlos\",\"lastName\":\"Alvarez\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-05-30T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"exhibitor\":{\"title\":\"The MET Opera 2025-26 : El Último Sueño de Frida y Diego\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/12488f1932717fcea5b57f91d6c52b1c.jpg\",\"synopsis\":\"On May 30, the Metropolitan Opera’s 2025–26 Live in HD season comes to a close with a live transmission of American composer Gabriela Lena Frank’s first opera, a magical-realist portrait of Mexico’s painterly power couple Frida Kahlo and Diego Rivera, with libretto by Pulitzer Prize–winning playwright Nilo Cruz. Fashioned as a reversal of the Orpheus and Euridice myth, the story depicts Frida, sung by leading mezzo-soprano Isabel Leonard, leaving the underworld on the Day of the Dead and reuniting with Diego, portrayed by baritone Carlos Álvarez. The famously feuding pair briefly relive their tumultuous love, embracing both the passion and the pain before bidding the land of the living a final farewell. Music Director Yannick Nézet-Séguin conducts the Met-premiere staging of Frank’s opera, a “confident, richly imagined score” (The New Yorker) that “bursts with color and fresh individuality” (Los Angeles Times). The vibrant new production, taking enthusiastic inspiration from Frida and Diego’s paintings, is directed and choreographed by Deborah Colker.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/52d8b7ca613f8311e54d725a38559cf9.jpg\",\"__typename\":\"BOAppImage\"}]},\"locale\":{\"title\":\"The Metropolitan Opera : El Último Sueño de Frida y Diego\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/1d/68/1d6878c942189268a7bc00a4730cefb1.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"originalTitle\":\"The Metropolitan Opera: El Último Sueño de Frida y Diego\",\"synopsis\":\"On May 30, the Metropolitan Opera’s 2025–26 Live in HD season comes to a close with a live transmission of American composer Gabriela Lena Frank’s first opera, a magical-realist portrait of Mexico’s painterly power couple Frida Kahlo and Diego Rivera, with libretto by Pulitzer Prize–winning playwright Nilo Cruz. Fashioned as a reversal of the Orpheus and Euridice myth, the story depicts Frida, sung by leading mezzo-soprano Isabel Leonard, leaving the underworld on the Day of the Dead and reuniting with Diego, portrayed by baritone Carlos Álvarez. The famously feuding pair briefly relive their tumultuous love, embracing both the passion and the pain before bidding the land of the living a final farewell. Music Director Yannick Nézet-Séguin conducts the Met-premiere staging of Frank’s opera, a “confident, richly imagined score” (The New Yorker) that “bursts with color and fresh individuality” (Los Angeles Times). The vibrant new production, taking enthusiastic inspiration from Frida and Diego’s paintings, is directed and choreographed by Deborah Colker.\",\"certificate\":null,\"casting\":[\"Gabriella Reyes\",\"Isabel Leonard\",\"Nils Wanderer\",\"Carlos Alvarez\"],\"direction\":[\"Deborah Colker\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/52d8b7ca613f8311e54d725a38559cf9.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/52d8b7ca613f8311e54d725a38559cf9.jpg\"],\"release\":\"2026-05-30T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000033503\",\"title\":\"The Marbles + Live Q&A\",\"runtime\":null,\"genres\":\"Documentary\",\"__typename\":\"Movie\",\"altId\":[\"403533\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/0621434d0ab82499efb7bed4b3e3d3b2.jpg\",\"quadImages\":[\"https://all.web.img.acsta.net/img/a7/0f/a70f42eedc450a9ef483e7848c4a5a72.jpg\"],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"David\",\"lastName\":\"Wilkinson\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Patricia\",\"lastName\":\"Allan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Melina\",\"lastName\":\"Antoniadis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tristram\",\"lastName\":\"Besterman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Paul\",\"lastName\":\"Cartledge\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Clare\",\"lastName\":\"Clifford\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brian\",\"lastName\":\"Cox\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Neil\",\"lastName\":\"Curtis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Andrew\",\"lastName\":\"George\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alexander\",\"lastName\":\"Herman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Victoria\",\"lastName\":\"Hislop\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-06T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"6677\",\"name\":\"Guerilla Films Ltd.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"brief images of real dead bodies\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Marbles + Live Q&A\",\"synopsis\":\"THE MARBLES is a compelling new documentary examining one of history's most controversial cultural disputes-the removal of the Parthenon Marbles and the ongoing campaign to return them to Greece. From imperial acquisition to modern-day advocacy, this is the story of heritage, identity, and justice.\\nIn 1801, Lord Elgin controversially removed half the Parthenon's sculptures, sparking a backlash from his contemporaries that continues today. What followed was a 200-year diplomatic battle between Greece and Britain over cultural patrimony. When respected actress and politician Melina Mercouri challenged the British Museum in 1983, she transformed the issue into an international cause that redefined how we think about cultural ownership.\\nThis thoughtful documentary, filmed over five years starting on the 200th anniversary of Greek independence, reveals the complexities of museum ethics, cultural policy, and the competing claims surrounding ancient artefacts. From Athens to London, it's a tale of empire, resistance, and redemption-with Scotland emerging as an unlikely hero.\\nThe debate continues to evolve, raising fundamental questions about the rightful ownership of ancient treasures. The question isn't just about marble sculptures-it's about how we value and preserve cultural heritage in a post-colonial world.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/4b/db/4bdb24b33069bb9171319d3739cebfa9.jpeg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/0621434d0ab82499efb7bed4b3e3d3b2.jpg\",\"synopsis\":\"From imperial acquisition to modern-day advocacy, this is the story of heritage, identity, and justice.\\n\\nJoin us at Everyman Edinburgh for a special preview screening of The Marbles - a compelling new documentary exploring one of history’s most controversial cultural disputes: the removal of the Parthenon Marbles and the ongoing campaign to return them to Greece. \\n\\nThe screening will be followed by a live Q&A with Rowan Brown (Director, Cockburn Association) and Neil Curtis FMA (Head of University Collections, University of Aberdeen).\\n\\nIn 1801, Lord Elgin controversially removed half the Parthenon's sculptures, sparking a backlash from his contemporaries that continues today. What followed was a 200-year diplomatic battle between Greece and Britain over cultural patrimony. When respected actress and politician Melina Mercouri challenged the British Museum in 1983, she transformed the issue into an international cause that redefined how we think about cultural ownership.\\nThis thoughtful documentary, filmed over five years starting on the 200th anniversary of Greek independence, reveals the complexities of museum ethics, cultural policy, and the competing claims surrounding ancient artefacts. From Athens to London, it's a tale of empire, resistance, and redemption-with Scotland emerging as an unlikely hero.\\n\\nThe debate continues to evolve, raising fundamental questions about the rightful ownership of ancient treasures. The question isn't just about marble sculptures-it's about how we value and preserve cultural heritage in a post-colonial world.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"The Marbles + Live Q&A\",\"synopsis\":\"From imperial acquisition to modern-day advocacy, this is the story of heritage, identity, and justice.\\n\\nJoin us at Everyman Edinburgh for a special preview screening of The Marbles - a compelling new documentary exploring one of history’s most controversial cultural disputes: the removal of the Parthenon Marbles and the ongoing campaign to return them to Greece. \\n\\nThe screening will be followed by a live Q&A with Rowan Brown (Director, Cockburn Association) and Neil Curtis FMA (Head of University Collections, University of Aberdeen).\\n\\nIn 1801, Lord Elgin controversially removed half the Parthenon's sculptures, sparking a backlash from his contemporaries that continues today. What followed was a 200-year diplomatic battle between Greece and Britain over cultural patrimony. When respected actress and politician Melina Mercouri challenged the British Museum in 1983, she transformed the issue into an international cause that redefined how we think about cultural ownership.\\nThis thoughtful documentary, filmed over five years starting on the 200th anniversary of Greek independence, reveals the complexities of museum ethics, cultural policy, and the competing claims surrounding ancient artefacts. From Athens to London, it's a tale of empire, resistance, and redemption-with Scotland emerging as an unlikely hero.\\n\\nThe debate continues to evolve, raising fundamental questions about the rightful ownership of ancient treasures. The question isn't just about marble sculptures-it's about how we value and preserve cultural heritage in a post-colonial world.\",\"certificate\":\"12A\",\"casting\":[\"Patricia Allan\",\"Melina Antoniadis\",\"Tristram Besterman\",\"Paul Cartledge\",\"Clare Clifford\",\"Brian Cox\",\"Neil Curtis\",\"Andrew George\",\"Alexander Herman\",\"Victoria Hislop\"],\"direction\":[\"David Wilkinson\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-11-06T00:00:00.000Z\",\"advisory\":\"brie