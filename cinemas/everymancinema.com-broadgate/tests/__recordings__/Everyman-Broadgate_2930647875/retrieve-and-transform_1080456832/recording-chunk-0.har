n Gordon\",\"Logan Pierce\",\"Gina Vultaggio\",\"Erin Tipple\",\"Tess Degenstein\",\"Claire Friesen\"],\"direction\":[\"Osgood Perkins\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/1c/67/1c67eaf26bbe70ae82c3ae52985aaf99.jpg\",\"https://all.web.img.acsta.net/img/6d/17/6d17a421c80a539cf3104fa4457750e7.jpg\",\"https://all.web.img.acsta.net/img/d9/0b/d90b9273a7e8bd094e9087bafbf240dd.jpg\",\"https://all.web.img.acsta.net/img/60/ba/60ba9bea944ed94fee39eede2bd1a197.jpg\",\"https://all.web.img.acsta.net/img/5d/c4/5dc4565d21119c83c3031d752e4c9fb6.jpg\",\"https://all.web.img.acsta.net/img/63/a9/63a98534015a8f2aa9dddacf4a165a3b.jpg\",\"https://all.web.img.acsta.net/img/cf/01/cf0187301c12713bab91a2c108d3d042.jpg\",\"https://all.web.img.acsta.net/img/65/5e/655ec827b96b5b653be714f65cfb501d.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/0455892cd920342f5a86e00a009ddca7.jpg\"],\"release\":\"2025-11-14T00:00:00.000Z\",\"advisory\":\"strong language, injury detail, horror\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/365639_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/365639_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Black Bear Pictures\"}},{\"id\":\"1000034727\",\"title\":\"Kiss Kiss Bang Bang (35mm)\",\"runtime\":6120,\"genres\":\"Action, Comedy\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8b87338e28146a5774e5456b265ecdc6.jpg\",\"__typename\":\"Movie\",\"altId\":[\"404995\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Shane\",\"lastName\":\"Black\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Downey Jr.\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Val\",\"lastName\":\"Kilmer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michelle\",\"lastName\":\"Monaghan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":null,\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Kiss Kiss Bang Bang (35mm)\",\"synopsis\":\"A thief posing as an actor teams up with a tough-guy private eye and a frustrated actress. They become involved in a murder case filled with twists, turns, deceptions, betrayal, and romance.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/9a/8b/9a8bf14b6b91ed460cfb75e3a73bdeed.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8b87338e28146a5774e5456b265ecdc6.jpg\",\"synopsis\":\"Two-bit crook Harry Lockhart (Robert Downey Jr.) stumbles into an audition for a mystery film while on the run from the cops. Winning the part, he lands in Hollywood, where he's flung into a tangled, murderous conspiracy with his childhood sweetheart, Harmony Lane (Michelle Monaghan), and hard-boiled private eye Perry van Shrike (Val Kilmer). This deadpan, affectionate parody of film noir tropes is named for film critic Pauline Kael's influential 1968 collection of film reviews and essays.\\n\\nScreening in stunning 35mm at Christmas on the Green this winter.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Kiss Kiss Bang Bang (35mm)\",\"synopsis\":\"Two-bit crook Harry Lockhart (Robert Downey Jr.) stumbles into an audition for a mystery film while on the run from the cops. Winning the part, he lands in Hollywood, where he's flung into a tangled, murderous conspiracy with his childhood sweetheart, Harmony Lane (Michelle Monaghan), and hard-boiled private eye Perry van Shrike (Val Kilmer). This deadpan, affectionate parody of film noir tropes is named for film critic Pauline Kael's influential 1968 collection of film reviews and essays.\\n\\nScreening in stunning 35mm at Christmas on the Green this winter.\",\"certificate\":\"18\",\"casting\":[\"Robert Downey Jr.\",\"Val Kilmer\",\"Michelle Monaghan\"],\"direction\":[\"Shane Black\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":null,\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000034728\",\"title\":\"Krampus (10th Anniversary)\",\"runtime\":5880,\"genres\":\"Horror, Comedy, Fantasy\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/36a2f5a9ddf5137342271356a5fe2deb.jpg\",\"__typename\":\"Movie\",\"altId\":[\"404996\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"directors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"releases\":[{\"releasedAt\":null,\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Krampus (10th Anniversary)\",\"synopsis\":\"When his dysfunctional family clashes over the holidays, young Max is disillusioned and turns his back on Christmas. Little does he know, this lack of festive spirit has unleashed the wrath of Krampus: a demonic force of ancient evil intent on punishing non-believers. All hell breaks loose as beloved holiday icons take on a monstrous life of their own, laying siege to the fractured family's home and forcing them to fight for each other if they hope to survive.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/a6/2a/a62a3de7f078267962a4d2ed4aa44d81.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/36a2f5a9ddf5137342271356a5fe2deb.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Krampus (10th Anniversary)\",\"synopsis\":\"When his dysfunctional family clashes over the holidays, young Max is disillusioned and turns his back on Christmas. Little does he know, this lack of festive spirit has unleashed the wrath of Krampus: a demonic force of ancient evil intent on punishing non-believers. All hell breaks loose as beloved holiday icons take on a monstrous life of their own, laying siege to the fractured family's home and forcing them to fight for each other if they hope to survive.\",\"certificate\":\"15\",\"casting\":[],\"direction\":[],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":null,\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Universal International Pictures\"}},{\"id\":\"1000033705\",\"title\":\"Late Nights: Big Trouble in Little China\",\"runtime\":6000,\"genres\":\"Adventure, Fantasy\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/1f15d18a9988684f293b630585107026.jpg\",\"__typename\":\"Movie\",\"altId\":[\"403787\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"John\",\"lastName\":\"Carpenter\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kurt\",\"lastName\":\"Russell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kim\",\"lastName\":\"Cattrall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dennis\",\"lastName\":\"Dun\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-21T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12435\",\"name\":\"20th Century Studios\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Late Nights: Big Trouble in Little China\",\"synopsis\":\"Jack Burton, a tough-talking, wisecracking truck driver whose hum-drum life on the road takes a sudden supernatural tailspin when his best friend's fiancee is kidnapped. Speeding to the rescue, Jack finds himself deep beneath San Francisco's Chinatown, in a murky, creature-filled world ruled by Lo Pan, a 2000-year-old magician who mercilessly presides over an empire of spirits. Dodging demons and facing baffling terrors, Jack battles his way through Lo Pan's dark domain in a full-throttle, action-riddled ride to rescue the girl.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/86/4a/864a5a7c01054f136a843b6ba2df4ce6.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/1f15d18a9988684f293b630585107026.jpg\",\"synopsis\":\"Jack Burton, a tough-talking, wisecracking truck driver whose hum-drum life on the road takes a sudden supernatural tailspin when his best friend's fiancée is kidnapped. Speeding to the rescue, Jack finds himself deep beneath San Francisco's Chinatown, in a murky, creature-filled world ruled by Lo Pan, a 2000-year-old magician who mercilessly presides over an empire of spirits. Dodging demons and facing baffling terrors, Jack battles his way through Lo Pan's dark domain in a full-throttle, action-riddled ride to rescue the girl.\\n\\nScreening as part of our Late Nights season.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Late Nights: Big Trouble in Little China\",\"synopsis\":\"Jack Burton, a tough-talking, wisecracking truck driver whose hum-drum life on the road takes a sudden supernatural tailspin when his best friend's fiancée is kidnapped. Speeding to the rescue, Jack finds himself deep beneath San Francisco's Chinatown, in a murky, creature-filled world ruled by Lo Pan, a 2000-year-old magician who mercilessly presides over an empire of spirits. Dodging demons and facing baffling terrors, Jack battles his way through Lo Pan's dark domain in a full-throttle, action-riddled ride to rescue the girl.\\n\\nScreening as part of our Late Nights season.\",\"certificate\":\"15\",\"casting\":[\"Kurt Russell\",\"Kim Cattrall\",\"Dennis Dun\"],\"direction\":[\"John Carpenter\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-11-21T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"20th Century Studios\"}},{\"id\":\"323401\",\"title\":\"Late Nights: Die Hard\",\"runtime\":7860,\"genres\":\"Action, Adventure, Thriller\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/37320682659b2c990bbb4588c6377add.jpg\",\"__typename\":\"Movie\",\"altId\":[\"353920\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"releases\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"John\",\"lastName\":\"McTiernan\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bruce\",\"lastName\":\"Willis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Reginald\",\"lastName\":\"VelJohnson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bonnie\",\"lastName\":\"Bedelia\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"locale\":{\"title\":\"Late Nights: Die Hard\",\"synopsis\":\"\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/37320682659b2c990bbb4588c6377add.jpg\",\"synopsis\":\"New York City policeman John McClane (Bruce Willis) is visiting his estranged wife (Bonnie Bedelia) and two daughters on Christmas Eve. He joins her at a holiday party in the headquarters of the Japanese-owned business she works for. But the festivities are interrupted by a group of terrorists who take over the exclusive high-rise, and everyone in it. Very soon McClane realizes that there's no one to save the hostages -- but him.\\n\\nScreening as part of our Late Nights Season.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/33da3bf213b4f86daa078407b8164f91.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Late Nights: Die Hard\",\"synopsis\":\"New York City policeman John McClane (Bruce Willis) is visiting his estranged wife (Bonnie Bedelia) and two daughters on Christmas Eve. He joins her at a holiday party in the headquarters of the Japanese-owned business she works for. But the festivities are interrupted by a group of terrorists who take over the exclusive high-rise, and everyone in it. Very soon McClane realizes that there's no one to save the hostages -- but him.\\n\\nScreening as part of our Late Nights Season.\",\"casting\":[\"Bruce Willis\",\"Reginald VelJohnson\",\"Bonnie Bedelia\"],\"direction\":[\"John McTiernan\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/33da3bf213b4f86daa078407b8164f91.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/33da3bf213b4f86daa078407b8164f91.jpg\"],\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"323402\",\"title\":\"Late Nights: Gremlins\",\"runtime\":6360,\"genres\":\"Science fiction, Comedy\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/cf24ecac5e7e7e57164fb4b79a6c4b82.jpg\",\"__typename\":\"Movie\",\"altId\":[\"353921\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Joe\",\"lastName\":\"Dante\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Zach\",\"lastName\":\"Galligan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hoyt\",\"lastName\":\"Axton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Frances Lee\",\"lastName\":\"McCain\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-28T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"moderate violence, fantasy horror\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Late Nights: Gremlins\",\"synopsis\":\"A wholesome, All-American town is turned upside-down, when \\\"gremlins\\\"--some impish little creatures--are accidentally unleashed and wreck havoc.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/7c/26/7c263f6d67c9d290ea567874dda4a9ee.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/cf24ecac5e7e7e57164fb4b79a6c4b82.jpg\",\"synopsis\":\"A gadget salesman is looking for a special gift for his son and finds one at a store in Chinatown. The shopkeeper is reluctant to sell him the `mogwai' but sells it to him with the warning to never expose him to bright light, water, or to feed him after midnight. All of this happens and the result is a gang of gremlins that decide to tear up the town on Christmas Eve.\\n\\nScreening as part of our Late Nights Season.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/8fbc43c10f91b1c24baf48ca1f1549e6.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Late Nights: Gremlins\",\"synopsis\":\"A gadget salesman is looking for a special gift for his son and finds one at a store in Chinatown. The shopkeeper is reluctant to sell him the `mogwai' but sells it to him with the warning to never expose him to bright light, water, or to feed him after midnight. All of this happens and the result is a gang of gremlins that decide to tear up the town on Christmas Eve.\\n\\nScreening as part of our Late Nights Season.\",\"certificate\":\"12A\",\"casting\":[\"Zach Galligan\",\"Hoyt Axton\",\"Frances Lee McCain\"],\"direction\":[\"Joe Dante\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/8fbc43c10f91b1c24baf48ca1f1549e6.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/8fbc43c10f91b1c24baf48ca1f1549e6.jpg\"],\"release\":\"2025-11-28T00:00:00.000Z\",\"advisory\":\"moderate violence, fantasy horror\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"}},{\"id\":\"1000033707\",\"title\":\"Late Nights: Kiss Kiss Bang Bang\",\"runtime\":6120,\"genres\":\"Detective, Comedy\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/b434d2e4f0d64714b60bb32224dfcd19.jpg\",\"__typename\":\"Movie\",\"altId\":[\"403789\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Shane\",\"lastName\":\"Black\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Downey Jr.\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Val\",\"lastName\":\"Kilmer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michelle\",\"lastName\":\"Monaghan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-19T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Late Nights: Kiss Kiss Bang Bang\",\"synopsis\":\"A thief posing as an actor teams up with a tough-guy private eye and a frustrated actress. They become involved in a murder case filled with twists, turns, deceptions, betrayal, and romance.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/81/ff/81ffa0519f287ddc97ae7062be941ea1.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/b434d2e4f0d64714b60bb32224dfcd19.jpg\",\"synopsis\":\"A thief posing as an actor teams up with a tough-guy private eye and a frustrated actress. They become involved in a murder case filled with twists, turns, deceptions, betrayal, and romance.\\n\\nScreening as part of our Late Nights season.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Late Nights: Kiss Kiss Bang Bang\",\"synopsis\":\"A thief posing as an actor teams up with a tough-guy private eye and a frustrated actress. They become involved in a murder case filled with twists, turns, deceptions, betrayal, and romance.\\n\\nScreening as part of our Late Nights season.\",\"certificate\":\"15\",\"casting\":[\"Robert Downey Jr.\",\"Val Kilmer\",\"Michelle Monaghan\"],\"direction\":[\"Shane Black\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-12-19T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000033701\",\"title\":\"Late Nights: The Naked Gun\",\"runtime\":5100,\"genres\":\"Comedy, Action\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c9b1556c27067b6b3944286e929e9bb7.jpg\",\"__typename\":\"Movie\",\"altId\":[\"403783\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"David\",\"lastName\":\"Zucker\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Leslie\",\"lastName\":\"Nielsen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"George\",\"lastName\":\"Kennedy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Priscilla\",\"lastName\":\"Beaulieu-Presley\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-14T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13760\",\"name\":\"Paramount Pictures UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Late Nights: The Naked Gun\",\"synopsis\":\"Frank Drebin (Leslie Nielsen), a rather clueless police detective, tries to foil a plot to turn innocent people into assassins through mind control. After his partner, Norberg (O.J. Simpson), is shot, Frank sets out to find the culprit, leading him to business tycoon Vincent Ludwig (Ricardo Montalban). However, Frank has no evidence until he meets Jane Spencer (Priscilla Presley), Ludwig's assistant. She knows nothing about Ludwig's devious plans, but falls for Frank and agrees to help him.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/81/30/81308d2ea2234814878f38439fcc212c.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c9b1556c27067b6b3944286e929e9bb7.jpg\",\"synopsis\":\"Frank Drebin (Leslie Nielsen), a rather clueless police detective, tries to foil a plot to turn innocent people into assassins through mind control. After his partner, Norberg (O.J. Simpson), is shot, Frank sets out to find the culprit, leading him to business tycoon Vincent Ludwig (Ricardo Montalban). However, Frank has no evidence until he meets Jane Spencer (Priscilla Presley), Ludwig's assistant. She knows nothing about Ludwig's devious plans, but falls for Frank and agrees to help him.\\n\\nScreening as part of our Late Nights season.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Late Nights: The Naked Gun\",\"synopsis\":\"Frank Drebin (Leslie Nielsen), a rather clueless police detective, tries to foil a plot to turn innocent people into assassins through mind control. After his partner, Norberg (O.J. Simpson), is shot, Frank sets out to find the culprit, leading him to business tycoon Vincent Ludwig (Ricardo Montalban). However, Frank has no evidence until he meets Jane Spencer (Priscilla Presley), Ludwig's assistant. She knows nothing about Ludwig's devious plans, but falls for Frank and agrees to help him.\\n\\nScreening as part of our Late Nights season.\",\"certificate\":\"15\",\"casting\":[\"Leslie Nielsen\",\"George Kennedy\",\"Priscilla Beaulieu-Presley\"],\"direction\":[\"David Zucker\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-11-14T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Paramount Pictures UK\"}},{\"id\":\"1000033750\",\"title\":\"Late Nights: The Shining (45th Anniversary)\",\"runtime\":8580,\"genres\":\"Horror\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/71e12f8fb354c402004687d9b4f76d60.jpg\",\"__typename\":\"Movie\",\"altId\":[\"403836\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Stanley\",\"lastName\":\"Kubrick\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jack\",\"lastName\":\"Nicholson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Shelley\",\"lastName\":\"Duvall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Danny\",\"lastName\":\"Lloyd\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-12T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Late Nights: The Shining (45th Anniversary)\",\"synopsis\":\"All work and no play makes the caretaker of an isolated resort go way off the deep end, terrorizing his young son and wife. Jack Torrance has come to the elegant, isolated Overlook Hotel as off-season caretaker. Torrance has never been there before - or has he? The answer lies in a ghostly time warp of madness and murder.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/12/af/12af507cc4bc642ab09cf6c90296efed.png\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/71e12f8fb354c402004687d9b4f76d60.jpg\",\"synopsis\":\"All work and no play makes the caretaker of an isolated resort go way off the deep end, terrorising his young son and wife. Jack Torrance has come to the elegant, isolated Overlook Hotel as off-season caretaker. Torrance has never been there before - or has he? The answer lies in a ghostly time warp of madness and murder.\\n\\nScreening as part of our Late Nights season.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Late Nights: The Shining (45th Anniversary)\",\"synopsis\":\"All work and no play makes the caretaker of an isolated resort go way off the deep end, terrorising his young son and wife. Jack Torrance has come to the elegant, isolated Overlook Hotel as off-season caretaker. Torrance has never been there before - or has he? The answer lies in a ghostly time warp of madness and murder.\\n\\nScreening as part of our Late Nights season.\",\"certificate\":\"15\",\"casting\":[\"Jack Nicholson\",\"Shelley Duvall\",\"Danny Lloyd\"],\"direction\":[\"Stanley Kubrick\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-12-12T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"}},{\"id\":\"109815\",\"title\":\"Little Miss Sunshine\",\"runtime\":6000,\"genres\":\"Comedy, Drama\",\"__typename\":\"Movie\",\"altId\":[\"52559\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/468c9506a25d882d56f71a42e817eb88.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898283.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898282.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898281.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898280.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898279.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898278.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898277.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898276.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898275.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898274.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jonathan\",\"lastName\":\"Dayton\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Valerie\",\"lastName\":\"Faris\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Abigail\",\"lastName\":\"Breslin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Greg\",\"lastName\":\"Kinnear\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Paul\",\"lastName\":\"Dano\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alan\",\"lastName\":\"Arkin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Toni\",\"lastName\":\"Collette\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Steve\",\"lastName\":\"Carell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alissa\",\"lastName\":\"Anderegg\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cassandra\",\"lastName\":\"Ashe\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jerry\",\"lastName\":\"Giles\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Beth\",\"lastName\":\"Grant\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2006-06-28T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12435\",\"name\":\"20th Century Studios\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong language, drug use\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]},{\"releasedAt\":\"2026-02-26T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12435\",\"name\":\"20th Century Studios\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong language, sex references, drug misuse\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Little Miss Sunshine\",\"synopsis\":\"The Hoover family treks from Albuquerque to the Little Miss Sunshine pageant in Redondo Beach, California, to fulfill the deepest wish of 7-year-old Olive, an ordinary little girl with big dreams. Along the way the family must deal with crushed dreams, heartbreaks, and a broken-down VW bus, leading up to the surreal Little Miss Sunshine competition itself. On their travels through this bizarre landscape, the Hoovers learn to trust and support each other along the path of life, no matter what the challenge.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/e4/c1/e4c1d260d62f0a1603507c3aabbe9723.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/468c9506a25d882d56f71a42e817eb88.jpg\",\"synopsis\":\"Selected by the Producers Branch, Everyman presents: Little Miss Sunshine\\n\\nThe Hoover family -- a man (Greg Kinnear), his wife (Toni Collette), an uncle (Steve Carell), a brother (Paul Dano) and a grandfather (Alan Arkin) -- puts the fun back in dysfunctional by piling into a VW bus and heading to California to support a daughter (Abigail Breslin) in her bid to win the Little Miss Sunshine Contest. The sanity of everyone involved is stretched to the limit as the group's quirks cause epic problems as they travel along their interstate route.\\n\\nSeven-year-old Olive and her dysfunctional family pile into a trouble-plagued Volkswagen van and road-trip to a child beauty contest in this sleeper hit directed by the team of Jonathan Dayton and Valerie Faris and produced by David T. Friendly, Peter Saraf, Marc Turtletaub, Albert Berger, and Ron Yerxa. The film received four nominations including, Best Picture. Michael Arndt’s Oscar-winning original screenplay deftly blends comedy and drama and is headed by a stellar cast including newcomer Abigail Breslin (who was nominated for her performance), Greg Kinnear, Toni Collette, and Alan Arkin, who won Best Supporting Actor for playing the family’s cranky patriarch.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 26 February.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/b87b568f0d7932cc383adce6cc84a00a.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Little Miss Sunshine\",\"synopsis\":\"Selected by the Producers Branch, Everyman presents: Little Miss Sunshine\\n\\nThe Hoover family -- a man (Greg Kinnear), his wife (Toni Collette), an uncle (Steve Carell), a brother (Paul Dano) and a grandfather (Alan Arkin) -- puts the fun back in dysfunctional by piling into a VW bus and heading to California to support a daughter (Abigail Breslin) in her bid to win the Little Miss Sunshine Contest. The sanity of everyone involved is stretched to the limit as the group's quirks cause epic problems as they travel along their interstate route.\\n\\nSeven-year-old Olive and her dysfunctional family pile into a trouble-plagued Volkswagen van and road-trip to a child beauty contest in this sleeper hit directed by the team of Jonathan Dayton and Valerie Faris and produced by David T. Friendly, Peter Saraf, Marc Turtletaub, Albert Berger, and Ron Yerxa. The film received four nominations including, Best Picture. Michael Arndt’s Oscar-winning original screenplay deftly blends comedy and drama and is headed by a stellar cast including newcomer Abigail Breslin (who was nominated for her performance), Greg Kinnear, Toni Collette, and Alan Arkin, who won Best Supporting Actor for playing the family’s cranky patriarch.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 26 February.\",\"certificate\":\"15\",\"casting\":[\"Abigail Breslin\",\"Greg Kinnear\",\"Paul Dano\",\"Alan Arkin\",\"Toni Collette\",\"Steve Carell\",\"Alissa Anderegg\",\"Cassandra Ashe\",\"Jerry Giles\",\"Beth Grant\"],\"direction\":[\"Jonathan Dayton\",\"Valerie Faris\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/b87b568f0d7932cc383adce6cc84a00a.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898283.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898282.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898281.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898280.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898279.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898278.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898277.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898276.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898275.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/18/90/19898274.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/b87b568f0d7932cc383adce6cc84a00a.jpg\"],\"release\":\"2006-06-28T00:00:00.000Z\",\"advisory\":\"strong language, drug use\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"20th Century Studios\"}},{\"id\":\"1000033713\",\"title\":\"Love Actually (35mm)\",\"runtime\":7800,\"genres\":\"Comedy\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/eca27797b61de09c33821b0c6634b155.jpg\",\"__typename\":\"Movie\",\"altId\":[\"403798\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Richard\",\"lastName\":\"Curtis\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bill\",\"lastName\":\"Nighy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hugh\",\"lastName\":\"Grant\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Liam\",\"lastName\":\"Neeson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-01T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Love Actually (35mm)\",\"synopsis\":\"Everywhere you look, love is causing chaos. From the bachelor Prime Minister of the United Kingdom who, on his first day at 10 Downing Street, falls in love with the girl who brings him his tea, to a hopeless sandwich delivery guy who doesn't think he has a chance with the girls in the U.K., so he heads for Wisconsin. From aging rock stars, to a stony headmistress, to a monolingual Portuguese housemaid--love arrives in many forms, shapes and sizes. Here, ten separate--but intertwining--stories of love all lead up to a big climax on Christmas Eve, proving that love is the driving force in all of these people's lives.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/60/49/60493f44c6d161dea69a68f130ab7679.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/eca27797b61de09c33821b0c6634b155.jpg\",\"synopsis\":\"Everywhere you look, love is causing chaos. From the bachelor Prime Minister of the United Kingdom who, on his first day at 10 Downing Street, falls in love with the girl who brings him his tea, to a hopeless sandwich delivery guy who doesn't think he has a chance with the girls in the U.K., so he heads for Wisconsin. \\n\\nFrom ageing rock stars, to a stony headmistress, to a monolingual Portuguese housemaid--love arrives in many forms, shapes and sizes. Here, ten separate--but intertwining--stories of love all lead up to a big climax on Christmas Eve, proving that love is the driving force in all of these people's lives.\\n\\nScreening in stunning 35mm at Christmas on the Green this winter.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Love Actually (35mm)\",\"synopsis\":\"Everywhere you look, love is causing chaos. From the bachelor Prime Minister of the United Kingdom who, on his first day at 10 Downing Street, falls in love with the girl who brings him his tea, to a hopeless sandwich delivery guy who doesn't think he has a chance with the girls in the U.K., so he heads for Wisconsin. \\n\\nFrom ageing rock stars, to a stony headmistress, to a monolingual Portuguese housemaid--love arrives in many forms, shapes and sizes. Here, ten separate--but intertwining--stories of love all lead up to a big climax on Christmas Eve, proving that love is the driving force in all of these people's lives.\\n\\nScreening in stunning 35mm at Christmas on the Green this winter.\",\"certificate\":\"15\",\"casting\":[\"Bill Nighy\",\"Hugh Grant\",\"Liam Neeson\"],\"direction\":[\"Richard Curtis\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-12-01T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Universal International Pictures\"}},{\"id\":\"1000029251\",\"title\":\"Luca  - Seeing Red + Recorded Q&A\",\"runtime\":null,\"genres\":\"Documentary\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4196e61bf2d4b296c23c30353686b72d.jpg\",\"__typename\":\"Movie\",\"altId\":[\"398439\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Christopher\",\"lastName\":\"M. Armstrong\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Manish\",\"lastName\":\"Pandey\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Chris\",\"lastName\":\"Harris\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Luca\",\"lastName\":\"Montezemolo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-09-25T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"distributors\":[{\"id\":\"24287\",\"name\":\"Independent\",\"__typename\":\"Company\"}],\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Luca  - Seeing Red + Q&A\",\"synopsis\":\"Join us for a very special evening live from the premiere of 'Luca - Seeing Red'.\\nThis preview screening will be followed by a live streamed Q&A with Chris Harris, Luca di Montezemolo, and the film director, Manish Pandey\\n \\nIn 'Luca - Seeing Red', Chris Harris travels to Italy to spend a week with Ferrari legend Luca Montezemolo.\\n \\nThe documentary is ex-BBC Top Gear star, Chris Harris’s ‘love letter’ to a man whom he describes as ‘the greatest car boss ever’ – Luca Cordero di Montezemolo. \\nChris, one of the most knowledgeable and passionate car journalists on earth, spends two weeks with Luca on an odyssey through his native Italy and hears the story of his extraordinary life.\\nHandpicked by Enzo Ferrari, himself, Luca saved Ferrari, twice!  First, in the early 1970’s and then, again, in the 90’s.\\nLuca was the architect of the Lauda and Schumacher eras; he presided over the most beautiful and desirable road cars in history and, under him, Ferrari became a brand to rival Apple, Nike and Coca Cola.  But it was that exact brand value that led to Luca’s operatic corporate assassination as parent company Fiat floated Ferrari to save itself.\\nSet on location in Bologna, Maranello and Rome, and enhanced with evocative archive, Chris takes a thrilling, reminiscent and incredibly personal journey with the man of whom Bernie Ecclestone says, ‘After Mr Ferrari, Luca was Ferrari’.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/53/ef/53ef29471387387173eb4a873251a183.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Luca  - Seeing Red + Recorded Q&A\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/4196e61bf2d4b296c23c30353686b72d.jpg\",\"synopsis\":\"Join us for a very special evening featuring an exclusive screening of Luca – Seeing Red, followed by a recorded conversation with Luca di Montezemolo, Chris Harris and director Manish Pandey, filmed live from our stage at the world premiere.\\n\\nThe documentary is ex-Top Gear star Chris Harris’s ‘love letter’ to the man he calls ‘the greatest car boss ever’, Ferrari legend Luca di Montezemolo. Harris, one of the most passionate car journalists alive, follows Luca on a two-week odyssey through Italy and uncovers his extraordinary life.\\n\\nHandpicked by Enzo Ferrari, Luca saved Ferrari twice—first in the 1970s, then again in the 90s. He masterminded the Lauda and Schumacher eras, presided over Ferrari’s most beautiful road cars, and built a brand rivaling Apple, Nike, and Coca-Cola. But that very success led to his operatic ousting when Fiat floated Ferrari to save itself.\\n\\nSet in Bologna, Maranello and Rome, and enriched with evocative archive, Chris takes a thrilling, personal journey with the man Bernie Ecclestone said: ‘After Mr Ferrari, Luca was Ferrari\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/bb2b260054b7b3c6732541ac386d29aa.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Luca  - Seeing Red + Q&A\",\"synopsis\":\"Join us for a very special evening featuring an exclusive screening of Luca – Seeing Red, followed by a recorded conversation with Luca di Montezemolo, Chris Harris and director Manish Pandey, filmed live from our stage at the world premiere.\\n\\nThe documentary is ex-Top Gear star Chris Harris’s ‘love letter’ to the man he calls ‘the greatest car boss ever’, Ferrari legend Luca di Montezemolo. Harris, one of the most passionate car journalists alive, follows Luca on a two-week odyssey through Italy and uncovers his extraordinary life.\\n\\nHandpicked by Enzo Ferrari, Luca saved Ferrari twice—first in the 1970s, then again in the 90s. He masterminded the Lauda and Schumacher eras, presided over Ferrari’s most beautiful road cars, and built a brand rivaling Apple, Nike, and Coca-Cola. But that very success led to his operatic ousting when Fiat floated Ferrari to save itself.\\n\\nSet in Bologna, Maranello and Rome, and enriched with evocative archive, Chris takes a thrilling, personal journey with the man Bernie Ecclestone said: ‘After Mr Ferrari, Luca was Ferrari\",\"certificate\":null,\"casting\":[\"Chris Harris\",\"Luca Montezemolo\"],\"direction\":[\"Christopher M. Armstrong\",\"Manish Pandey\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/bb2b260054b7b3c6732541ac386d29aa.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/bb2b260054b7b3c6732541ac386d29aa.jpg\"],\"release\":\"2025-09-25T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Independent\"}},{\"id\":\"1000030161\",\"title\":\"Luca - Seeing Red\",\"runtime\":null,\"genres\":\"Documentary\",\"__typename\":\"Movie\",\"altId\":[\"399580\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"releases\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/6f2703b1dbc9de39135d921cd8931fdf.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Christopher\",\"lastName\":\"M. Armstrong\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Manish\",\"lastName\":\"Pandey\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Chris\",\"lastName\":\"Harris\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Luca\",\"lastName\":\"Montezemolo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"locale\":{\"title\":\"Luca - Seeing Red\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/37/f7/37f7b9da1f5c406e084496b54d725beb.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/6f2703b1dbc9de39135d921cd8931fdf.jpg\",\"synopsis\":\"The documentary is ex-Top Gear star Chris Harris’s ‘love letter’ to the man he calls ‘the greatest car boss ever’, Ferrari legend Luca di Montezemolo. Harris, one of the most passionate car journalists alive, follows Luca on a two-week odyssey through Italy and uncovers his extraordinary life.\\n\\nHandpicked by Enzo Ferrari, Luca saved Ferrari twice—first in the 1970s, then again in the 90s. He masterminded the Lauda and Schumacher eras, presided over Ferrari’s most beautiful road cars, and built a brand rivaling Apple, Nike, and Coca-Cola. But that very success led to his operatic ousting when Fiat floated Ferrari to save itself.\\n\\nSet in Bologna, Maranello and Rome, and enriched with evocative archive, Chris takes a thrilling, personal journey with the man Bernie Ecclestone said: ‘After Mr Ferrari, Luca was Ferrari\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/5eec54da11ae0eedb5b4579b39bc938e.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Luca - Seeing Red\",\"synopsis\":\"The documentary is ex-Top Gear star Chris Harris’s ‘love letter’ to the man he calls ‘the greatest car boss ever’, Ferrari legend Luca di Montezemolo. Harris, one of the most passionate car journalists alive, follows Luca on a two-week odyssey through Italy and uncovers his extraordinary life.\\n\\nHandpicked by Enzo Ferrari, Luca saved Ferrari twice—first in the 1970s, then again in the 90s. He masterminded the Lauda and Schumacher eras, presided over Ferrari’s most beautiful road cars, and built a brand rivaling Apple, Nike, and Coca-Cola. But that very success led to his operatic ousting when Fiat floated Ferrari to save itself.\\n\\nSet in Bologna, Maranello and Rome, and enriched with evocative archive, Chris takes a thrilling, personal journey with the man Bernie Ecclestone said: ‘After Mr Ferrari, Luca was Ferrari\",\"casting\":[\"Chris Harris\",\"Luca Montezemolo\"],\"direction\":[\"Christopher M. Armstrong\",\"Manish Pandey\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/5eec54da11ae0eedb5b4579b39bc938e.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/5eec54da11ae0eedb5b4579b39bc938e.jpg\"],\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000007317\",\"title\":\"Marty Supreme\",\"runtime\":8940,\"genres\":\"Drama, Biopic\",\"__typename\":\"Movie\",\"altId\":[\"369701\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ea35dcd46ee4c8d0aa9eae9b9a572f37.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/63/88/63888a193780eeb0574c836513e5c75c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/29/80/298098488caa5271b37f7b8207cc6f83.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/b2/ae/b2ae37eae4f102a5427889137ea062be.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/f8/05/f8059864a9d229cab3d664173280ca83.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/a1/88/a188dbf927027d760a1034d3cafb2dde.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/a3/04/a30488d5862e30c8597eddcee3f3c426.jpg\"