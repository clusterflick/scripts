rson\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dakota\",\"lastName\":\"Johnson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Pedro\",\"lastName\":\"Pascal\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Chris\",\"lastName\":\"Evans\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Zoë\",\"lastName\":\"Winters\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marin\",\"lastName\":\"Ireland\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lindsey\",\"lastName\":\"Broad\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sawyer\",\"lastName\":\"Spielberg\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Louisa\",\"lastName\":\"Jacobson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dasha\",\"lastName\":\"Nekrasova\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nedra Marie\",\"lastName\":\"Taylor\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-08-15T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"39732\",\"name\":\"Sony Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong language, sex references\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Materialists\",\"synopsis\":\"A young, ambitious New York City matchmaker finds herself torn between the perfect match and her imperfect ex.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/387869_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/387869_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/90/55/90557f90d33a8592995aa14195d681b3.png\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/613f71ce0bd052c94d139a9fbfcf795b.jpg\",\"synopsis\":\"Lucy (Dakota Johnson) is a successful matchmaker who believes love can be measured by status, wealth, and looks. But when two very different men - John (Chris Evans), her ex, and Harry (Pedro Pascal), a wealthy client - reenter her life, she’s forced to reconsider what really matters.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/f39aaf6d6672aee4991ef4028dd57698.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Materialists\",\"synopsis\":\"Lucy (Dakota Johnson) is a successful matchmaker who believes love can be measured by status, wealth, and looks. But when two very different men - John (Chris Evans), her ex, and Harry (Pedro Pascal), a wealthy client - reenter her life, she’s forced to reconsider what really matters.\",\"certificate\":\"15\",\"casting\":[\"Dakota Johnson\",\"Pedro Pascal\",\"Chris Evans\",\"Zoë Winters\",\"Marin Ireland\",\"Lindsey Broad\",\"Sawyer Spielberg\",\"Louisa Jacobson\",\"Dasha Nekrasova\",\"Nedra Marie Taylor\"],\