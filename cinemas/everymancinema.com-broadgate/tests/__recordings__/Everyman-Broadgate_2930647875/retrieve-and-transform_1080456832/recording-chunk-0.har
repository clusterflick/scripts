i\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Adam\",\"lastName\":\"McNamara\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Steven\",\"lastName\":\"Cree\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Paddy\",\"lastName\":\"Towers\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jason Alan\",\"lastName\":\"Staines\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Cooke\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-10T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"32481\",\"name\":\"Studio Canal\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"very strong language, brief violence, sex references\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"I Swear\",\"synopsis\":\"Scottish setting, true life story of John Davidson. Diagnosed with Tourette's at 15, targeted as 'insane' by his peers, he struggled with a condition few had witnessed. Campaigning for better understanding and acceptance of the condition of Tourette's as an adult, he finds his life's purpose and accepted his MBE from the Queen in 2019.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/373300_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/373300_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https