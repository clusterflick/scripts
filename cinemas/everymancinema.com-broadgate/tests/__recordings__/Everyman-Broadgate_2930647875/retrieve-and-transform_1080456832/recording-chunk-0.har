es\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/65/29/20345896.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/65/29/20345892.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/65/29/20345890.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/65/29/20345889.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/94/65/29/20345886.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Brian\",\"lastName\":\"Henson\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Caine\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Frank\",\"lastName\":\"Oz\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Steven\",\"lastName\":\"Mackintosh\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Steve\",\"lastName\":\"Whitmire\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Dave\",\"lastName\":\"Goelz\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jerry\",\"lastName\":\"Nelson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Jessica\",\"lastName\":\"Fox\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Meredith\",\"lastName\":\"Braun\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Robin\",\"lastName\":\"Weaver\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2022-12-02T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild scary scenes\",\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Muppet Christmas Carol\",\"synopsis\":\"Yes, The Muppet Christmas Carol will be back in cinemas this festive season. A gem from the Disney catalogue with some great performances from your favorite Muppets.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/18644_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/18644_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/3f/f6/3ff60099f0c2465f64158d258dd169bc.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/62c5ac2f63dd1ae90a5542b36218a30a.jpg\",\"synopsis\":\"Yes, The Muppet Christmas Carol will be back in cinemas this festive season. A gem from the Disney catalogue with some great performances from your favourite Muppets.\\n\\nThe Muppets perform the classic Dickens holiday tale, with Kermit the Frog playing Bob Cratchit, the put-upon clerk of stingy Ebenezer Scrooge (Michael Caine). Other Muppets -- Miss Piggy, Gonzo, Fozzie Bear and Sam the Eagle -- weave in and out of the story, while Scrooge receives visits from spirits of three Christmases -- past, present and future. They show him the error of his self-serving ways, but the miserable old man seems to be past any hope of redemption and happiness.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/475fa5fe1ca9dd1d3858e1c2ce46f99d.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"The Muppet Christmas Carol\",\"synopsis\":\"Yes, The Muppet Christmas Carol will be back in cinemas this festive season. A gem from the Disney catalogue with some great performances from your favourite Muppets.\\n\\nThe Muppets perform the classic Dickens holiday tale, with Kermit the Frog playing Bob Cratchit, the put-upon clerk of stingy Ebenezer Scrooge (Michael Caine). Other Muppets -- Miss Piggy, Gonzo, Fozzie Bear and Sam the Eagle -- weave in and out of the story, while Scrooge receives visits from spirits of three Christmases -- past, present and future. They show him the error of his self-serving ways, but the miserable old man seems to be past any hope of redemption and happiness.\",\"certificate\":\"U\",\"casting\":[\"Michael Caine\",\"Frank Oz\",\"Steven Mackintosh\",\"Steve Whitmire\",\"Dave Goelz\",\"Jerry Nelson\",\"Jessica Fox\",\"Meredith Braun\",\"Robin Weaver\"],\"direction\":[\"Brian Henson\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/475fa5fe1ca9dd1d3858e1c2ce46f99d.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/94/65/29/20345896.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/94/65/29/20345892.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/94/65/29/20345890.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/94/65/29/20345889.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/94/65/29/20345886.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/475fa5fe1ca9dd1d3858e1c2ce46f99d.jpg\"],\"release\":\"2022-12-02T00:00:00.000Z\",\"advisory\":\"mild scary sce