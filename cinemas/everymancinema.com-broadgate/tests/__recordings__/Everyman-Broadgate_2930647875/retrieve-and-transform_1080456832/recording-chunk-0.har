l},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christopher\",\"lastName\":\"McDonald\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Stephen\",\"lastName\":\"Tobolowsky\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brad\",\"lastName\":\"Pitt\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Timothy\",\"lastName\":\"Carhart\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lucinda\",\"lastName\":\"Jenney\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jason\",\"lastName\":\"Beghe\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":null,\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong violence, sex, language, sexual assault\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]},{\"releasedAt\":\"2025-11-27T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong violence, sex, language, sexual assault\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Thelma & Louise\",\"synopsis\":\"Two best friends set out on an adventure, but it soon turns around to a terrifying escape from being hunted by the police, as these two girls escape for the crimes they committed.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/3f/5b/3f5b625d800571b638c446fb6f350175.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/093ffe9326aacd692224d59bed88040c.jpg\",\"synopsis\":\"Selected by the Writers Branch, Everyman presents: Thelma & Louise\\n\\nMeek housewife Thelma (Geena Davis) joins her friend Louise (Susan Sarandon), an independent waitress, on a short fishing trip. However, their trip becomes a flight from the law when Louise shoots and kills a man who tries to rape Thelma at a bar. Louise decides to flee to Mexico, and Thelma joins her. On the way, Thelma falls for sexy young thief J.D. (Brad Pitt) and the sympathetic Detective Slocumb (Harvey Keitel) tries to convince the two women to surrender before their fates are sealed.\\n\\nCallie Khouri’s original screenplay, which won the 1991 Academy Award, reinvented both the buddy film and the road movie as it told the story of its eponymous heroines, Geena Davis and Susan Sarandon, respectively, who find themselves on the run across the American desert. Davis and Sarandon were both nominated for Best Actress, the most recent instance in Academy Awards history that two actors from the same film have been nominated in the category. Ridley Scott was nominated for his typically stylish direction, and the ace supporting cast included Harvey Keitel as an unexpectedly sympathetic policeman and Brad Pitt as an especially exciting detour.\\n\\nPresented in 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 27 November.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/267512e125ecd306c2264d98ecb6098a.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Thelma & Louise\",\"synopsis\":\"Selected by the Writers Branch, Everyman presents: Thelma & Louise\\n\\nMeek housewife Thelma (Geena Davis) joins her friend Louise (Susan Sarandon), an independent waitress, on a short fishing trip. However, their trip becomes a flight from the law when Louise shoots and kills a man who tries to rape Thelma at a bar. Louise decides to flee to Mexico, and Thelma joins her. On the way, Thelma falls for sexy young thief J.D. (Brad Pitt) and the sympathetic Detective Slocumb (Harvey Keitel) tries to convince the two women to surrender before their fates are sealed.\\n\\nCallie Khouri’s original screenplay, which won the 1991 Academy Award, reinvented both the buddy film and the road movie as it told the story of its eponymous heroines, Geena Davis and Susan Sarandon, respectively, who find themselves on the run across the American desert. Davis and Sarandon were both nominated for Best Actress, the most recent instance in Academy Awards history that two actors from the same film have been nominated in the category. Ridley Scott was nominated for his typically stylish direction, and the ace supporting cast included Harvey Keitel as an unexpectedly sympathetic policeman and Brad Pitt as an especially exciting detour.\\n\\nPresented in 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 27 November.\",\"certificate\":\"15\",\"casting\":[\"Geena Davis\",\"Susan Sarandon\",\"Harvey Keitel\",\"Michael Madsen\",\"Christopher McDonald\",\"Stephen Tobolowsky\",\"Brad Pitt\",\"Timothy Carhart\",\"Lucinda Jenney\",\"Jason Beghe\"],\"direction\":[\"Ridley Scott\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/267512e125ecd306c2264d98ecb6098a.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/88/57/19976070.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881198.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881197.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881196.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881195.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881194.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881190.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881189.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881188.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/65/66/86/18881187.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/267512e125ecd306c2264d98ecb6098a.jpg\"],\"release\":\"2025-11-27T00:00:00.000Z\",\"advisory\":\"strong violence, sex, language, sexual assault\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"1000011325\",\"title\":\"Throwback: E.T. the Extra-Terrestrial\",\"runtime\":7200,\"genres\":\"Adventure, Family, Science fiction\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/9ddd39b0715684fa631ee7de81c11efc.jpg\",\"__typename\":\"Movie\",\"altId\":[\"375007\"],\"images\":[],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Steven\",\"lastName\":\"Spielberg\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Henry\",\"lastName\":\"Thomas\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Drew\",\"lastName\":\"Barrymore\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Peter\",\"lastName\":\"Coyote\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dee\",\"lastName\":\"Wallace\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"MacNaughton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2024-10-25T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"Contains very mild language and threat\",\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Throwback: E.T. the Extra-Terrestrial\",\"synopsis\":\"An extra-terrestrial is accidentally left behind on Earth and is befriended by a young boy and his brother and sister.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/9ddd39b0715684fa631ee7de81c11efc.jpg\",\"synopsis\":\"After a gentle alien becomes stranded on Earth, the being is discovered and befriended by a young boy named Elliott. Bringing the extra-terrestrial into his suburban California house, Elliott introduces E.T., as the alien is dubbed, to his brother and his little sister, Gertie, and the children decide to keep its existence a secret. Soon, however, E.T. falls ill, resulting in government intervention and a dire situation for both Elliott and the alien.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/d91e288f55d6f8fff9a98161660e34b7.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Throwback: E.T. the Extra-Terrestrial\",\"synopsis\":\"After a gentle alien becomes stranded on Earth, the being is discovered and befriended by a young boy named Elliott. Bringing the extra-terrestrial into his suburban California house, Elliott introduces E.T., as the alien is dubbed, to his brother and his little sister, Gertie, and the children decide to keep its existence a secret. Soon, however, E.T. falls ill, resulting in government intervention and a dire situation for both Elliott and the alien.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"certificate\":\"U\",\"casting\":[\"Henry Thomas\",\"Drew Barrymore\",\"Peter Coyote\",\"Dee Wallace\",\"Robert MacNaughton\"],\"direction\":[\"Steven Spielberg\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/d91e288f55d6f8fff9a98161660e34b7.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/d91e288f55d6f8fff9a98161660e34b7.jpg\"],\"release\":\"2024-10-25T00:00:00.000Z\",\"advisory\":\"Contains very mild language and threat\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Universal International Pictures\"}},{\"id\":\"1000015250\",\"title\":\"Throwback: Elf\",\"runtime\":5820,\"genres\":\"Adventure, Comedy, Family, Fantasy, Romance\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/7d334b44e41a26c9dd94a07e6d325c11.jpg\",\"__typename\":\"Movie\",\"altId\":[\"380255\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jon\",\"lastName\":\"Favreau\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Will\",\"lastName\":\"Ferrell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"James\",\"lastName\":\"Caan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bob\",\"lastName\":\"Newhart\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Zooey\",\"lastName\":\"Deschanel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Edward\",\"lastName\":\"Asner\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2024-11-29T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild bad language, sex references\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Throwback: Elf\",\"synopsis\":\"As a baby, Buddy crawls into Santa's toy bag and is whisked off to the North Pole, where he is raised as an elf. A misfit who grows to be three times the size of his elf family, Buddy ultimately heads to his birthplace of New York City to seek out his roots. Unfortunately, they turn out to be a \\\"Scrooge\\\"-like father and a cynical ten-year-old stepbrother who doesn't believe in Santa. Worst of all, everyone seems to have forgotten the true meaning of Christmas. But using his simple elf ways, Buddy sets out to single-handedly win over his family and save Christmas in New York, hoping to at last find his true place in the world.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/7a/5f/7a5f8696cf02b4a159c71d8c5d28175a.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/7d334b44e41a26c9dd94a07e6d325c11.jpg\",\"synopsis\":\"As a baby, Buddy crawls into Santa's toy bag and is whisked off to the North Pole, where he is raised as an elf. A misfit who grows to be three times the size of his elf family, Buddy ultimately heads to his birthplace of New York City to seek out his roots. Unfortunately, they turn out to be a \\\"Scrooge\\\"-like father and a cynical ten-year-old stepbrother who doesn't believe in Santa. Worst of all, everyone seems to have forgotten the true meaning of Christmas. But using his simple elf ways, Buddy sets out to single-handedly win over his family and save Christmas in New York, hoping to at last find his true place in the world.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/8c70682361c802b942666d5a1cf42f53.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Throwback: Elf\",\"synopsis\":\"As a baby, Buddy crawls into Santa's toy bag and is whisked off to the North Pole, where he is raised as an elf. A misfit who grows to be three times the size of his elf family, Buddy ultimately heads to his birthplace of New York City to seek out his roots. Unfortunately, they turn out to be a \\\"Scrooge\\\"-like father and a cynical ten-year-old stepbrother who doesn't believe in Santa. Worst of all, everyone seems to have forgotten the true meaning of Christmas. But using his simple elf ways, Buddy sets out to single-handedly win over his family and save Christmas in New York, hoping to at last find his true place in the world.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"certificate\":\"PG\",\"casting\":[\"Will Ferrell\",\"James Caan\",\"Bob Newhart\",\"Zooey Deschanel\",\"Edward Asner\"],\"direction\":[\"Jon Favreau\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/8c70682361c802b942666d5a1cf42f53.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/8c70682361c802b942666d5a1cf42f53.jpg\"],\"release\":\"2024-11-29T00:00:00.000Z\",\"advisory\":\"mild bad language, sex references\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"323181\",\"title\":\"Throwback: It's a Wonderful Life\",\"runtime\":7800,\"genres\":\"Drama, Comedy\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/00811b79beda8509ee8cc3d73b815fc3.jpg\",\"__typename\":\"Movie\",\"altId\":[\"353605\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Frank\",\"lastName\":\"Capra\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"James\",\"lastName\":\"Stewart\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Donna\",\"lastName\":\"Reed\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lionel\",\"lastName\":\"Barrymore\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":null,\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":\"Contains no material likely to offend or harm\",\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Throwback : It's a Wonderful Life\",\"synopsis\":\"George Bailey has so many problems he is thinking about ending it all - and it's Christmas! As the angels discuss George, we see his life in flashback. As George is about to jump from a bridge, he ends up rescuing his guardian angel, Clarence. Clarence then shows George what his town would have looked like if it hadn't been for all of his good deeds over the years. Will Clarence be able to convince George to return to his family and forget suicide?\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Throwback: It's a Wonderful Life\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/00811b79beda8509ee8cc3d73b815fc3.jpg\",\"synopsis\":\"George Bailey has so many problems he is thinking about ending it all - and it's Christmas! As the angels discuss George, we see his life in flashback. As George is about to jump from a bridge, he ends up rescuing his guardian angel, Clarence. Clarence then shows George what his town would have looked like if it hadn't been for all of his good deeds over the years.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Throwback : It's a Wonderful Life\",\"synopsis\":\"George Bailey has so many problems he is thinking about ending it all - and it's Christmas! As the angels discuss George, we see his life in flashback. As George is about to jump from a bridge, he ends up rescuing his guardian angel, Clarence. Clarence then shows George what his town would have looked like if it hadn't been for all of his good deeds over the years.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"certificate\":\"U\",\"casting\":[\"James Stewart\",\"Donna Reed\",\"Lionel Barrymore\"],\"direction\":[\"Frank Capra\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":null,\"advisory\":\"Contains no material likely to offend or harm\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"323177\",\"title\":\"Throwback: Love Actually\",\"runtime\":7740,\"genres\":\"Comedy, Romance\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c71a1af6c938de0d476bdd11270f455a.jpg\",\"__typename\":\"Movie\",\"altId\":[\"353602\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Richard\",\"lastName\":\"Curtis\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hugh\",\"lastName\":\"Grant\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emma\",\"lastName\":\"Thompson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alan\",\"lastName\":\"Rickman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":null,\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":\"strong sex, language\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Throwback : Love Actually\",\"synopsis\":\"Everywhere you look, love is causing chaos. From the bachelor Prime Minister of the United Kingdom who, on his first day at 10 Downing Street, falls in love with the girl who brings him his tea, to a hopeless sandwich delivery guy who doesn't think he has a chance with the girls in the U.K., so he heads for Wisconsin. From aging rock stars, to a stony headmistress, to a monolingual Portuguese housemaid--love arrives in many forms, shapes and sizes. Here, ten separate--but intertwining--stories of love all lead up to a big climax on Christmas Eve, proving that love is the driving force in all of these people's lives.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Throwback: Love Actually\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c71a1af6c938de0d476bdd11270f455a.jpg\",\"synopsis\":\"Everywhere you look, love is causing chaos. From the bachelor Prime Minister of the United Kingdom who, on his first day at 10 Downing Street, falls in love with the girl who brings him his tea, to a hopeless sandwich delivery guy who doesn't think he has a chance with the girls in the U.K., so he heads for Wisconsin.\\n\\nFrom aging rock stars, to a stony headmistress, to a monolingual Portuguese housemaid--love arrives in many forms, shapes and sizes. Here, ten separate--but intertwining--stories of love all lead up to a big climax on Christmas Eve, proving that love is the driving force in all of these people's lives.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Throwback : Love Actually\",\"synopsis\":\"Everywhere you look, love is causing chaos. From the bachelor Prime Minister of the United Kingdom who, on his first day at 10 Downing Street, falls in love with the girl who brings him his tea, to a hopeless sandwich delivery guy who doesn't think he has a chance with the girls in the U.K., so he heads for Wisconsin.\\n\\nFrom aging rock stars, to a stony headmistress, to a monolingual Portuguese housemaid--love arrives in many forms, shapes and sizes. Here, ten separate--but intertwining--stories of love all lead up to a big climax on Christmas Eve, proving that love is the driving force in all of these people's lives.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"certificate\":\"15\",\"casting\":[\"Hugh Grant\",\"Emma Thompson\",\"Alan Rickman\"],\"direction\":[\"Richard Curtis\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":null,\"advisory\":\"strong sex, language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"323178\",\"title\":\"Throwback: The Holiday\",\"runtime\":8160,\"genres\":\"Romance, Comedy\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c9a20e682713783ab62ff38f73978951.jpg\",\"__typename\":\"Movie\",\"altId\":[\"353603\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"releases\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Nancy\",\"lastName\":\"Meyers\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cameron\",\"lastName\":\"Diaz\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kate\",\"lastName\":\"Winslet\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jack\",\"lastName\":\"Black\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"embargoes\":[],\"locale\":{\"title\":\"Throwback : The Holiday\",\"synopsis\":\"\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Throwback: The Holiday\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c9a20e682713783ab62ff38f73978951.jpg\",\"synopsis\":\"Iris is in love with a man who is about to marry another woman. Across the globe, Amanda realizes the man she lives with has been unfaithful. Two women who have never met and live 6000 miles apart, find themselves in the exact same place. When they meet online at a home exchange website, they impulsively switch homes for the holiday.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/5c333fd86502a5788a4edabcd37a9ded.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Throwback : The Holiday\",\"synopsis\":\"Iris is in love with a man who is about to marry another woman. Across the globe, Amanda realizes the man she lives with has been unfaithful. Two women who have never met and live 6000 miles apart, find themselves in the exact same place. When they meet online at a home exchange website, they impulsively switch homes for the holiday.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"casting\":[\"Cameron Diaz\",\"Kate Winslet\",\"Jack Black\"],\"direction\":[\"Nancy Meyers\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/5c333fd86502a5788a4edabcd37a9ded.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/5c333fd86502a5788a4edabcd37a9ded.jpg\"],\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000