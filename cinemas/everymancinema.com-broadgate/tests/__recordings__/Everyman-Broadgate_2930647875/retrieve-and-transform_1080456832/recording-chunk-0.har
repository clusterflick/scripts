:\"Tedde\",\"lastName\":\"Moore\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"R.D.\",\"lastName\":\"Robb\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Zack\",\"lastName\":\"Ward\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jeff\",\"lastName\":\"Gillen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Wong\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"1984-10-26T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"Contains mild violence and language\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"A Christmas Story\",\"synopsis\":\"In the 1940's, in the town of Hammond, 9-year-old Ralphie wants one thing for Christmas -- an official Red Ryder BB rifle. When he asks his mother for the BB gun for Christmas, she says, \\\"No, you'll shoot your eye out\\\". When he writes an essay about it at school his teacher gives him a C+ with a note saying \\\"You'll shoot your eye out.\\\" Next he asks Santa for the gun, Santa's response is familiar, he says, \\\"You'll shoot your eye out, kid.\\\" Ralph fears that he'll never get the BB gun for Christmas. But there may be a surprise in store for him.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/00/dd/00dd1444ed0fb95e5686ca249589be5e.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typenam