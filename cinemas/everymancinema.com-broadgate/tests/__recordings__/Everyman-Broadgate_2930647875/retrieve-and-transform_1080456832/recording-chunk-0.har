\":\"https://m.boxoffice.media/QuickTime/373300_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Studio Canal\"}},{\"id\":\"1000034723\",\"title\":\"It's A Wonderful Life (35mm)\",\"runtime\":7800,\"genres\":\"Drama, Comedy\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2590c5e98dd2b387bab899d08bfa81fd.jpg\",\"__typename\":\"Movie\",\"altId\":[\"404991\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Frank\",\"lastName\":\"Capra\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"James\",\"lastName\":\"Stewart\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Donna\",\"lastName\":\"Reed\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lionel\",\"lastName\":\"Barrymore\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":null,\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"It's A Wonderful Life (35mm)\",\"synopsis\":\"George Bailey has so many problems he is thinking about ending it all - and it's Christmas! As the angels discuss George, we see his life in flashback. As George is about to jump from a bridge, he ends up rescuing his guardian angel, Clarence. Clarence then shows George what his town would have looked like if it hadn't been for all of his good deeds over the years. Will Clarence be able to convince George to return to his family and forget suicide?\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/76/ff/76ffc98aee1c1b02c7f2559a5543f9c6.jpeg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2590c5e98dd2b387bab899d08bfa81fd.jpg\",\"synopsis\":\"George Bailey has so many problems he is thinking about ending it all - and it's Christmas! As the angels discuss George, we see his life in flashback. As George is about to jump from a bridge, he ends up rescuing his guardian angel, Clarence. Clarence then shows George what his town would have looked like if it hadn't been for all of his good deeds over the years. Will Clarence be able to convince George to return to his family and forget suicide?\\n\\nScreening in stunning 35mm at Christmas on the Green this winter.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"It's A Wonderful Life (35mm)\",\"synopsis\":\"George Bailey has so many problems he is thinking about ending it all - and it's Christmas! As the angels discuss George, we see his life in flashback. As George is about to jump from a bridge, he ends up rescuing his guardian angel, Clarence. Clarence then shows George what his town would have looked like if it hadn't been for all of his good deeds over the years. Will Clarence be able to convince George to return to his family and forget suicide?\\n\\nScreening in stunning 35mm at Christmas on the Green this winter.\",\"certificate\":\"U\",\"casting\":[\"James Stewart\",\"Donna Reed\",\"Lionel Barrymore\"],\"direction\":[\"Frank Capra\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":null,\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"5762\",\"title\":\"It's a Wonderful Life\",\"runtime\":7740,\"genres\":\"Comedy drama, Fantasy, Drama, Comedy\",\"__typename\":\"Movie\",\"altId\":[\"3836