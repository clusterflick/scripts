ull},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jason\",\"lastName\":\"Watkins\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brenda\",\"lastName\":\"Blethyn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sandra\",\"lastName\":\"Huggett\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lolly\",\"lastName\":\"Jones\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-07T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"1000109968\",\"name\":\"Conic\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong language, bloody images, suicide\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Dragonfly\",\"synopsis\":\"Have we become a nation of strangers? In Dragonfly, neglected pensioner Elsie (Brenda Blethyn) finds an unexpected ally in her younger neighbour Colleen (Andrea Riseborough). Over time, Elsie gains a friend and the troubled Colleen finds a fresh purpose in life as she shops, cleans and cares for her. It brings brighter days for both of them. Elsie’s son John (Jason Watkins) resents the way that Colleen has selflessly fulfilled the responsibilities that he has shirked. Simmering tensions bring shocking consequences in a gripping human story straight from the heart of broken Britain. A powerful return to the cinema from London to Brighton director Paul Andrew Williams that showcases heartrending, award-winning performances from Brenda Blethyn and Andrea Riseborough.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/394226_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/394226_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/2c/d3/2cd37a8172b66831ff71ecf0eec02052.jpeg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Dragonfly\",\"synopsis\":\"Have we become a nation of strangers? In Dragonfly, neglected pensioner Elsie (Brenda Blethyn) finds an unexpected ally in her younger neighbour Colleen (Andrea Riseborough). Over time, Elsie gains a friend and the troubled Colleen finds a fresh purpose in life as she shops, cleans and cares for her. It brings brighter days for both of them. Elsie’s son John (Jason Watkins) resents the way that Colleen has selflessly fulfilled the responsibilities that he has shirked. Simmering tensions bring shocking consequences in a gripping human story straight from the heart of broken Britain. A powerful return to the cinema from London to Brighton director Paul Andrew Williams that showcases heartrending, award-winning performances from Brenda Blethyn and Andrea Riseborough.\",\"certificate\":\"15\",\"casting\":[\"Andrea Riseborough\",\"Jason Watkins\",\"Brenda Blethyn\",\"Sandra Huggett\",\"Lolly Jones\"],\"direction\":[\"Paul Andrew Williams\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/d6/ec/d6eccf2d3e2cacccff575b02b2238a05.jpg\",\"https://all.web.img.acsta.net/img/99/b5/99b58bbd4d66f46e8bfe261d8173abe9.jpg\",\"https://all.web.img.acsta.net/img/6b/ac/6bac92354d9357ee71bf291decddcd85.jpg\"],\"heroImages\":[],\"release\":\"2025-11-07T00:00:00.000Z\",\"advisory\":\"strong language, bloody images, suicide\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/394226_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/394226_uk_hd.mov\"},\"localizations\":[],\"studio\