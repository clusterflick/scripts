le\":\"Throwback: The Nightmare Before Christmas\",\"synopsis\":\"Bored with the same old scare-and-scream routine, Pumpkin King Jack Skellington longs to spread the joy of Christmas. But his merry mission puts Santa in jeopardy and creates a nightmare for good little boys and girls everywhere.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/46/39/46397280c0bbd8f571766830f1c8ea33.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/b010a840300093f3ec43b20c3320dd43.jpg\",\"synopsis\":\"Bored with the same old scare-and-scream routine, Pumpkin King Jack Skellington longs to spread the joy of Christmas. But his merry mission puts Santa in jeopardy and creates a nightmare for good little boys and girls everywhere.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/4728e26e4d46c57683625daf5b188ef6.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Throwback: The Nightmare Before Christmas\",\"synopsis\":\"Bored with the same old scare-and-scream routine, Pumpkin King Jack Skellington longs to spread the joy of Christmas. But his merry mission puts Santa in jeopardy and creates a nightmare for good little boys and girls everywhere.\\n\\nScreening on Sundays and Tuesdays as part of our Throwback Season where we revisit classics. Each ticket to these showtimes includes complimentary popcorn and a drink.\",\"certificate\":\"PG\",\"casting\":[\"Danny Elfman\",\"Chris Sarandon\",\"Catherine O'Hara\",\"William Hickey\",\"Glenn Shadix\",\"Paul Reubens\"],\"direction\":[\"Henry Selick\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/4728e26e4d46c57683625daf5b188ef6.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/4728e26e4d46c57683625daf5b188ef6.jpg\"],\"release\":\"2024-11-01T00:00:00.000Z\",\"advisory\":\"Contains mild comic horror\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"1000033698\",\"title\":\"Toddler Club: A Paw Patrol Christmas\",\"runtime\":2640,\"genres\":\"Animation\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ad063355c1b8575d510b257d80bcf3e6.jpg\",\"__typename\":\"Movie\",\"altId\":[\"403780\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jamie\",\"lastName\":\"Whitney\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Lucien\",\"lastName\":\"Duncan-Reid\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"David J.\",\"lastName\":\"Dixon\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Luke\",\"lastName\":\"Dietz\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2025-11-07T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13760\",\"name\":\"Paramount Pictures UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"very mild threat\",\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Toddler Club: A Paw Patrol Christmas\",\"synopsis\":\"Children's adventure animation in which a canine response team must stop a mayor and his feline companions from stealing a stash of Christmas presents.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/d1/07/d107129fd83a1cbd9f89fd5de126aaaf.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ad063355c1b8575d510b257d80bcf3e6.jpg\",\"synopsis\":\"When Santa gets ill, Christmas is cancelled in Adventure Bay. Mayor Humdinger goes to the North Pole to take all the gifts for himself. Rubble and the rest of the PAW Patrol will have to make a sacrifice to stop Mayor Humdinger from ruining Christmas!\\n\\nJoin us every Friday or Saturday for toddler-friendly cinema screenings. From ages 1 to 5, share your childhood favourites and the best new family film releases with your pre-schoolers, and we’ll bring you a warm drink and a slice of cake or a small popcorn, all included in the price of your ticket.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Toddler Club: A Paw Patrol Christmas\",\"synopsis\":\"When Santa gets ill, Christmas is cancelled in Adventure Bay. Mayor Humdinger goes to the North Pole to take all the gifts for himself. Rubble and the rest of the PAW Patrol will have to make a sacrifice to stop Mayor Humdinger from ruining Christmas!\\n\\nJoin us every Friday or Saturday for toddler-friendly cinema screenings. From ages 1 to 5, share your childhood favourites and the best new family film releases with your pre-schoolers, and we’ll bring you a warm drink and a slice of cake or a small popcorn, all included in the price of your ticket.\",\"certificate\":\"U\",\"casting\":[\"Lucien Duncan-Reid\",\"David J. Dixon\",\"Luke Dietz\"],\"direction\":[\"Jamie Whitney\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-11-07T00:00:00.000Z\",\"advisory\":\"very mild threa