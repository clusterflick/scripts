irstName\":\"Caroline\",\"lastName\":\"Aaron\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"1991-03-12T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12435\",\"name\":\"20th Century Studios\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"Contains moderate violence\",\"__typename\":\"Rating\",\"certificate\":\"12\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Edward Scissorhands\",\"synopsis\":\"When a mad scientist meets an early death his creation is left to fend with scissors for hands.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/73/97/739703a4f1c1e3d1bdc686dd5acc1abb.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/d330944c9952a6735dacdc06ab30d3ce.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/f543de5f2bf584d26cc80c67e094c00b.jpg\",\"synopsis\":\"A scientist (Vincent Price) builds an animated human being -- the gentle Edward (Johnny Depp). The scientist dies before he can finish assembling Edward, though, leaving the young man with a freakish appearance accentuated by the scissor blades he has instead of hands. \\n\\nLoving suburban saleswoman Peg (Dianne Wiest) discovers Edward and takes him home, where he falls for Peg's teen daughter (Winona Ryder). However, despite his kindness and artistic talent, Edward's hands make him an outcast.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Edward Scissorhands\",\"synopsis\":\"A scientist (Vincent Price) builds an animated human being -- the gentle Edward (Johnny Depp). The scientist dies before he can finish assembling Edward, though, leaving the young man with a freakish appearance accentuated by the scissor blades he has instead of hands. \\n\\nLoving suburban saleswoman Peg (Dianne Wiest) discovers Edward and takes him home, where he falls for Peg's teen daughter (Winona Ryder). However, despite his kindness and artistic talent, Edward's hands make him an outcast.\",\"certificate\":\"12\",\"casting\":[\"Johnny Depp\",\"Winona Ryder\",\"Dianne Wiest\",\"Vincent Price\",\"Anthony Michael Hall\",\"O-Lan Jones\",\"Kathy Baker\",\"Robert Oliveri\",\"Conchata Ferrell\",\"Caroline Aaron\"],\"direction\":[\"Tim Burton\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/pictures/17/08/14/20/27/283906.png\",\"https://all.web.img.acsta.net/pictures/17/08/14/20/27/284687.jpg\",\"https://all.web.img.acsta.net/pictures/17/08/14/20/27/285000.jpg\",\"https://all.web.img.acsta.net/pictures/17/08/14/20/27/285312.jpg\",\"https://all.web.img.acsta.net/pictures/17/08/14/20/27/285625.jpg\",\"https://all.web.img.acsta.net/pictures/17/08/14/20/27/284375.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/02/62/19883759.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/02/62/19883756.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/02/62/19883753.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/87/02/62/19883752.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/d330944c9952a6735dacdc06ab30d3ce.jpg\"],\"release\":\"1991-03-12T00:00:00.000Z\",\"advisory\":\"Contains moderate violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"20th Century Studios\"}},{\"id\":\"45156\",\"title\":\"Elf\",\"runtime\":5820,\"genres\":\"Comedy, Fantasy, Family\",\"__typename\":\"Movie\",\"altId\":[\"39816\",\"354524\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/d2c0aadc9274ed09a789b8f1bbd443ce.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/15/53/18365514.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/15/53/18365513.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/15/53/18365512.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/15/53/18365511.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/15/53/18365510.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/35/15/53/18365508.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jon\",\"lastName\":\"Favreau\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Will\",\"lastName\":\"Ferrell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"James\",\"lastName\":\"Caan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Zooey\",\"lastName\":\"Deschanel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bob\",\"lastName\":\"Newhart\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Edward\",\"lastName\":\"Asner\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mary\",\"lastName\":\"Steenburgen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Daniel\",\"lastName\":\"Tay\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Lerner\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jon\",\"lastName\":\"Favreau\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Andy\",\"lastName\":\"Richter\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2021-11-26T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"},{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild bad language, sex references\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Elf\",\"synopsis\":\"As a baby, Buddy crawls into Santa's toy bag and is whisked off to the North Pole, where he is raised as an elf. A misfit who grows to be three times the size of his elf family, Buddy ultimately heads to his birthplace of New York City to seek out his roots. Unfortunately, they turn out to be a \\\"Scrooge\\\"-like father and a cynical ten-year-old stepbrother who doesn't believe in Santa. Worst of all, everyone seems to have forgotten the true meaning of Christmas. But using his simple elf ways, Buddy sets out to single-handedly win over his family and save Christmas in New York, hoping to at last find his true place in the world.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/39816_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/39816_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/c2/62/c262ba816a5dbf390131d18c9cb646ee.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/d2c0aadc9274ed09a789b8f1bbd443ce.jpg\",\"synopsis\":\"As a baby, Buddy crawls into Santa's toy bag and is whisked off to the North Pole, where he is raised as an elf. A misfit who grows to be three times the size of his elf family, Buddy ultimately heads to his birthplace of New York City to seek out his roots. \\n\\nUnfortunately, they turn out to be a \\\"Scrooge\\\"-like father and a cynical ten-year-old stepbrother who doesn't believe in Santa. Worst of all, everyone seems to have forgotten the true meaning of Christmas. But using his simple elf ways, Buddy sets out to single-handedly win over his family and save Christmas in New York, hoping to at last find his true place in the world.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/aa614f2a1ab4d550c8a2244396c3e3cb.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Elf\",\"synopsis\":\"As a baby, Buddy crawls into Santa's toy bag and is whisked off to the North Pole, where he is raised as an elf. A misfit who grows to be three times the size of his elf family, Buddy ultimately heads to his birthplace of New York City to seek out his roots. \\n\\nUnfortunately, they turn out to be a \\\"Scrooge\\\"-like father and a cynical ten-year-old stepbrother who doesn't believe in Santa. Worst of all, everyone seems to have forgotten the true meaning of Christmas. But using his simple elf ways, Buddy sets out to single-handedly win over his family and save Christmas in New York, hoping to at last find his true place in the world.\",\"certificate\":\"PG\",\"casting\":[\"Will Ferrell\",\"James Caan\",\"Zooey Deschanel\",\"Bob Newhart\",\"Edward Asner\",\"Mary Steenburgen\",\"Daniel Tay\",\"Michael Lerner\",\"Jon Favreau\",\"Andy Richter\"],\"direction\":[\"Jon Favreau\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/aa614f2a1ab4d550c8a2244396c3e3cb.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/15/53/18365514.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/15/53/18365513.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/15/53/18365512.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/15/53/18365511.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/15/53/18365510.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/35/15/53/18365508.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/aa614f2a1ab4d550c8a2244396c3e3cb.jpg\"],\"release\":\"2021-11-26T00:00:00.000Z\",\"advisory\":\"mild bad language, sex references\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/39816_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/39816_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"323852\",\"title\":\"Ella McCay\",\"runtime\":null,\"genres\":\"Comedy drama, Drama\",\"__typename\":\"Movie\",\"altId\":[\"372956\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8c82a6db9012cc31365e0e76ede6eac8.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/9a/68/9a688ffecaf774a0cf9d6aa852cec37a.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/9d/1f/9d1f8cb17e8e062054a4794989ca00dc.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/a7/d8/a7d8ef4435ecf737acab1cea43592b9d.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/8c/81/8c815168721987f17783370f0e0d4719.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/06/00/0600d67feb12487be3b93b5024a17364.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/fc/dc/fcdc3598cc5ce560402170f4ce025def.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/87/44/87445566ef1e7cf06598e19f1aa091d9.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/30/3b/303b3485c2731eaa2b78e58f347117b8.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ba/79/ba79f18184692480542e477b60eb54ae.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/bc/36/bc360fc529acb4ff1794a5ce1be994e2.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"James L.\",\"lastName\":\"Brooks\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emma\",\"lastName\":\"Mackey\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jamie Lee\",\"lastName\":\"Curtis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Woody\",\"lastName\":\"Harrelson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Spike\",\"lastName\":\"Fearn\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ayo\",\"lastName\":\"Edebiri\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Albert\",\"lastName\":\"Brooks\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rebecca\",\"lastName\":\"Hall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jack\",\"lastName\":\"Lowden\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kumail\",\"lastName\":\"Nanjiani\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sheetal\",\"lastName\":\"Sheth\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-12T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}],\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Ella McCay\",\"synopsis\":\"Academy Award winning writer/director, James L. Brooks, brings you the humour, the headaches, and the heart that makes a family.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/372956_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/372956_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/c4/d3/c4d309777607eeb2fb91b969b1afc373.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/8d713b229a16f78281fc0b053df1ddd5.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8c82a6db9012cc31365e0e76ede6eac8.jpg\",\"synopsis\":\"An idealistic young woman juggles her family and work life in a comedy about the people you love and how to survive them. “Ella McCay” features an all-star cast including Emma Mackey, Jamie Lee Curtis, Jack Lowden, Kumail Nanjiani, Ayo Edebiri, Spike Fearn, Rebecca Hall, Julie Kavner, Becky Ann Baker, Joey Brooks with Albert Brooks and Woody Harrelson. \",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/f46fcf9115a0e453e323142ab06fa054.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Ella McCay\",\"synopsis\":\"An idealistic young woman juggles her family and work life in a comedy about the people you love and how to survive them. “Ella McCay” features an all-star cast including Emma Mackey, Jamie Lee Curtis, Jack Lowden, Kumail Nanjiani, Ayo Edebiri, Spike Fearn, Rebecca Hall, Julie Kavner, Becky Ann Baker, Joey Brooks with Albert Brooks and Woody Harrelson. \",\"certificate\":null,\"casting\":[\"Emma Mackey\",\"Jamie Lee Curtis\",\"Woody Harrelson\",\"Spike Fearn\",\"Ayo Edebiri\",\"Albert Brooks\",\"Rebecca Hall\",\"Jack Lowden\",\"Kumail Nanjiani\",\"Sheetal Sheth\"],\"direction\":[\"James L. Brooks\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/f46fcf9115a0e453e323142ab06fa054.jpg\",\"https://all.web.img.acsta.net/img/9a/68/9a688ffecaf774a0cf9d6aa852cec37a.jpg\",\"https://all.web.img.acsta.net/img/9d/1f/9d1f8cb17e8e062054a4794989ca00dc.jpg\",\"https://all.web.img.acsta.net/img/a7/d8/a7d8ef4435ecf737acab1cea43592b9d.jpg\",\"https://all.web.img.acsta.net/img/8c/81/8c815168721987f17783370f0e0d4719.jpg\",\"https://all.web.img.acsta.net/img/06/00/0600d67feb12487be3b93b5024a17364.jpg\",\"https://all.web.img.acsta.net/img/fc/dc/fcdc3598cc5ce560402170f4ce025def.jpg\",\"https://all.web.img.acsta.net/img/87/44/87445566ef1e7cf06598e19f1aa091d9.jpg\",\"https://all.web.img.acsta.net/img/30/3b/303b3485c2731eaa2b78e58f347117b8.jpg\",\"https://all.web.img.acsta.net/img/ba/79/ba79f18184692480542e477b60eb54ae.jpg\",\"https://all.web.img.acsta.net/img/bc/36/bc360fc529acb4ff1794a5ce1be994e2.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/f46fcf9115a0e453e323142ab06fa054.jpg\",\"https://cms-assets.webediamovies.pro/production/2/8d713b229a16f78281fc0b053df1ddd5.jpg\"],\"release\":\"2025-12-12T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/372956_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/372956_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Walt Disney\"}},{\"id\":\"1000034202\",\"title\":\"Emirates Presents: Jay Kelly\",\"runtime\":7920,\"genres\":\"Comedy, Drama\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a964a63a9f21669126c57e63c79ab9ce.jpg\",\"__typename\":\"Movie\",\"altId\":[\"404373\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Noah\",\"lastName\":\"Baumbach\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"George\",\"lastName\":\"Clooney\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Adam\",\"lastName\":\"Sandler\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Laura\",\"lastName\":\"Dern\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-19T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"1000101511\",\"name\":\"Netflix\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong language\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Emirates Presents: Jay Kelly\",\"synopsis\":\"JAY KELLY, the new film from Academy Award nominee Noah Baumbach, follows famous movie actor Jay Kelly (George Clooney) and his devoted manager Ron (Adam Sandler) as they embark on a whirlwind and unexpectedly profound journey through Europe. Along the way, both men are forced to confront the choices they've made, the relationships with their loved ones, and the legacies they’ll leave behind.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/fa/bc/fabc2ed6818bd67ba8977926416af75c.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a964a63a9f21669126c57e63c79ab9ce.jpg\",\"synopsis\":\"Emirates brings the ultimate first-class experience to Everyman venues across the UK. Showcasing film previews for the latest releases each month, including complimentary champagne on arrival. \\n\\nThis month, Emirates presents: Jay Kelly\\n\\nFamous movie star Jay Kelly and his devoted manager, Ron, embark on an unexpectedly profound journey through Europe. Along the way, both men confront the choices they've made, relationships with loved ones, and the legacies they'll leave behind.\\n\\nPriority booking for Members is open from November 3 - 4, with booking opening for all guests from November 5.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Emirates Presents: Jay Kelly\",\"synopsis\":\"Emirates brings the ultimate first-class experience to Everyman venues across the UK. Showcasing film previews for the latest releases each month, including complimentary champagne on arrival. \\n\\nThis month, Emirates presents: Jay Kelly\\n\\nFamous movie star Jay Kelly and his devoted manager, Ron, embark on an unexpectedly profound journey through Europe. Along the way, both men confront the choices they've made, relationships with loved ones, and the legacies they'll leave behind.\\n\\nPriority booking for Members is open from November 3 - 4, with booking opening for all guests from November 5.\",\"certificate\":\"15\",\"casting\":[\"George Clooney\",\"Adam Sandler\",\"Laura Dern\"],\"direction\":[\"Noah Baumbach\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-11-19T00:00:00.000Z\",\"advisory\":\"strong language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Netflix\"}},{\"id\":\"1000026518\",\"title\":\"Exhibition on Screen: Caravaggio\",\"runtime\":6300,\"genres\":\"Documentary\",\"__typename\":\"Movie\",\"altId\":[\"395026\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a63966fdba4816b0afe9d794ae0cdd6b.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/59/ef/59ef79063053c064119af26eb6f39e0b.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e9/2e/e92e5b60b352378205913679ffb33634.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Phil\",\"lastName\":\"Grabsky\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"David\",\"lastName\":\"Bickerstaff\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jack\",\"lastName\":\"Bannell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-11T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"17526\",\"name\":\"Seventh Art Productions\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"moderate bad language, sex references\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Exhibition on Screen: Caravaggio\",\"synopsis\":\"Five years in the making, this is the most extensive film ever made about this revolutionary artist. With first-hand testimony from the artist himself on the eve of his mysterious disappearance, this film reveals Caravaggio as never before. Featuring masterpiece after masterpiece and testimony from leading experts from around the world, Caravaggio immerses audiences in the hidden narratives of the artist’s life, piecing together clues embedded within his incredible art.\\n\\nCaravaggio’s masterpieces are some of art’s most instantly recognisable. No one else uses his signature blend of dramatic light, intense naturalism and bold, striking figures. His astonishing paintings have captivated audiences for centuries. But there lies a deeper mystery – one that still beckons us to explore. What do these masterpieces reveal about the man behind the brush? The intriguing self-depictions within his works – sometimes disguised, sometimes in plain sight – offer a rare window into his psyche and personal struggles. Join us as we unravel the story of one of history’s most brilliant, complex and controversial figures.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/3b/d1/3bd1e285b0309c36c3cf5d7eae4e6e36.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a63966fdba4816b0afe9d794ae0cdd6b.jpg\",\"synopsis\":\"Mystery, intrigue, beauty, passion, murder – shine a new light on Caravaggio in this dramatic biography…\\n\\nFive years in production, this is the most extensive film ever made about one of the greatest artists of all time – Caravaggio. Featuring masterpiece after masterpiece and with first-hand testimony from the artist himself on the eve of his mysterious disappearance, this beautiful new film reveals Caravaggio as never before.\\n\\nMulti-award-winning filmmakers David Bickerstaff and Phil Grabsky delve into the hidden narratives of Caravaggio’s life, piecing together clues embedded within his incredible art. The intriguing self-depictions within his works — sometimes disguised, sometimes in plain sight — offer a rare window into his psyche and personal struggles. Join us as we unravel the story of one of history’s most brilliant, complex and controversial figures.\\n\\nCaravaggio’s masterpieces are some of art’s most instantly recognisable. No one else uses his signature blend of dramatic light, intense naturalism and bold, striking figures. His incredible paintings have captivated audiences for centuries. But there lies a deeper mystery — one that still beckons us to explore. What do these masterpieces reveal about the man behind the brush? Join us as we explore the intriguing clues that help us to finally understand the life – and death – of this remarkable man.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/434ca590db349eb5c2b7d94569e37337.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Exhibition On Screen: Caravaggio\",\"synopsis\":\"Mystery, intrigue, beauty, passion, murder – shine a new light on Caravaggio in this dramatic biography…\\n\\nFive years in production, this is the most extensive film ever made about one of the greatest artists of all time – Caravaggio. Featuring masterpiece after masterpiece and with first-hand testimony from the artist himself on the eve of his mysterious disappearance, this beautiful new film reveals Caravaggio as never before.\\n\\nMulti-award-winning filmmakers David Bickerstaff and Phil Grabsky delve into the hidden narratives of Caravaggio’s life, piecing together clues embedded within his incredible art. The intriguing self-depictions within his works — sometimes disguised, sometimes in plain sight — offer a rare window into his psyche and personal struggles. Join us as we unravel the story of one of history’s most brilliant, complex and controversial figures.\\n\\nCaravaggio’s masterpieces are some of art’s most instantly recognisable. No one else uses his signature blend of dramatic light, intense naturalism and bold, striking figures. His incredible paintings have captivated audiences for centuries. But there lies a deeper mystery — one that still beckons us to explore. What do these masterpieces reveal about the man behind the brush? Join us as we explore the intriguing clues that help us to finally understand the life – and death – of this remarkable man.\",\"certificate\":\"12A\",\"casting\":[\"Jack Bannell\"],\"direction\":[\"Phil Grabsky\",\"David Bickerstaff\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/434ca590db349eb5c2b7d94569e37337.jpg\",\"https://all.web.img.acsta.net/img/59/ef/59ef79063053c064119af26eb6f39e0b.jpg\",\"https://all.web.img.acsta.net/img/e9/2e/e92e5b60b352378205913679ffb33634.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/434ca590db349eb5c2b7d94569e37337.jpg\"],\"release\":\"2025-11-11T00:00:00.000Z\",\"advisory\":\"moderate bad language, sex references\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Seventh Art Productions\"}},{\"id\":\"1000027396\",\"title\":\"Exhibition on Screen: Frida Kahlo\",\"runtime\":5400,\"genres\":\"Documentary\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a24e554c967d19b31c2202a6d13d2c0c.jpg\",\"__typename\":\"Movie\",\"altId\":[\"396193\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Ali\",\"lastName\":\"Ray\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2026-05-15T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Exhibition on Screen: Frida Kahlo 2026 Encore\",\"synopsis\":null,\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Exhibition on Screen: Frida Kahlo\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/a24e554c967d19b31c2202a6d13d2c0c.jpg\",\"synopsis\":\"Frida Kahlo is a phenomenon. She is arguably the world’s favourite female artist – beloved by young and old. Exhibition on Screen’s award-winning film – first released during covid to a restricted audience - is back by popular demand with an exciting new addition from the blockbuster transatlantic exhibition from Tate Britain and MFA Houston 'Frida Kahlo: the Making of an Icon'. \\n  \\nWho was Frida Kahlo? Everyone knows her face but who was the woman behind the bright colours, the big brows and the floral crowns? Take a journey through the life of a true icon, discover her art, and uncover the true story of her rebellious, passionate and turbulent life. \\n  \\nMaking use of the latest technology to deliver previously unimaginable quality, we take an in-depth look at key works throughout her career. Using letters Kahlo wrote to guide us, this definitive film reveals her deepest emotions and unlocks the secrets and symbolism contained within her art. \\n  \\nExhibition on Screen’s trademark combination of interviews with those who knew her and world experts, commentary and a detailed exploration of her art, combined with new special bonus footage from the 2026 Tate exhibition, delivers a treasure trove of colour and emotion. This personal and intimate film offers privileged access to her works, her home, her studio and highlights the source of her feverish creativity, her resilience and her unmatched lust for life, beauty and revolution. \\n  \\nCreated in close collaboration with world experts and those who knew her. \\n  \\nAdditional new material from the curators of the groundbreaking new Tate Britain and MFA Houston exhibition. \",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/4bc3e6945560152e4f7003796aae6faa.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Exhibition on Screen: Frida Kahlo 2026 Encore\",\"synopsis\":\"Frida Kahlo is a phenomenon. She is arguably the world’s favourite female artist – beloved by young and old. Exhibition on Screen’s award-winning film – first released during covid to a restricted audience - is back by popular demand with an exciting new addition from the blockbuster transatlantic exhibition from Tate Britain and MFA Houston 'Frida Kahlo: the Making of an Icon'. \\n  \\nWho was Frida Kahlo? Everyone knows her face but who was the woman behind the bright colours, the big brows and the floral crowns? Take a journey through the life of a true icon, discover her art, and uncover the true story of her rebellious, passionate and turbulent life. \\n  \\nMaking use of the latest technology to deliver previously unimaginable quality, we take an in-depth look at key works throughout her career. Using letters Kahlo wrote to guide us, this definitive film reveals her deepest emotions and unlocks the secrets and symbolism contained within her art. \\n  \\nExhibition on Screen’s trademark combination of interviews with those who knew her and world experts, commentary and a detailed exploration of her art, combined with new special bonus footage from the 2026 Tate exhibition, delivers a treasure trove of colour and emotion. This personal and intimate film offers privileged access to her works, her home, her studio and highlights the source of her feverish creativity, her resilience and her unmatched lust for life, beauty and revolution. \\n  \\nCreated in close collaboration with world experts and those who knew her. \\n  \\nAdditional new material from the curators of the groundbreaking new Tate Britain and MFA Houston exhibition. \",\"certificate\":null,\"casting\":[],\"direction\":[\"Ali Ray\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/4bc3e6945560152e4f7003796aae6faa.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/4bc3e6945560152e4f7003796aae6faa.jpg\"],\"release\":\"2026-05-15T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000025863\",\"title\":\"Exhibition on Screen: Turner & Constable\",\"runtime\":5400,\"genres\":\"Documentary\",\"__typename\":\"Movie\",\"altId\":[\"394279\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/251d9bfc64f493c8d72c8c4e05453d1b.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"David\",\"lastName\":\"Bickerstaff\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2026-03-06T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Exhibition on Screen: Turner & Constable\",\"synopsis\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/50/39/50393b5c8bbef9512301b14437336f28.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/251d9bfc64f493c8d72c8c4e05453d1b.jpg\",\"synopsis\":\"Celebrating the 250th anniversary of their births, this unmissable new documentary explores Turner and Constable’s intertwined lives and legacies alongside the groundbreaking Tate exhibition.\\nTwo of Britain’s greatest painters, J.M.W. Turner and John Constable were also the greatest of rivals. Born within a year of each other, both used landscape painting to reflect the changing world around them. Tate Britain is bringing these two greats together for a groundbreaking exhibition, in London from November 2025 to April 2026, and Exhibition on Screen once again has exclusive and privileged access to bring their extraordinary art and remarkable stories to the big screen in February so that you can enjoy both film and exhibition together. Discover unexpected sides to both artists with intimate views of sketchbooks and personal items and insights from leading experts.\\nTurner’s blazing sunsets and sublime scenes from his travels and Constable’s idealised depictions of beloved places from home whipped the public of the time into a frenzy of enthusiasm. Constable represents the very best of the old school of realism and pastoral nostalgia; Turner, an exciting new way of depicting emotion and dreamlike impressions. Critics compared their starkly different styles to a clash of ‘fire and water’. Don’t miss this opportunity to see these greats side-by-side, as they so often were in life, on the big screen for the first time.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/ee3751d515f699df5893ddd4516d2880.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Exhibition on Screen : Turner & Constable\",\"synopsis\":\"Celebrating the 250th anniversary of their births, this unmissable new documentary explores Turner and Constable’s intertwined lives and legacies alongside the groundbreaking Tate exhibition.\\nTwo of Britain’s greatest painters, J.M.W. Turner and John Constable were also the greatest of rivals. Born within a year of each other, both used landscape painting to reflect the changing world around them. Tate Britain is bringing these two greats together for a groundbreaking exhibition, in London from November 2025 to April 2026, and Exhibition on Screen once again has exclusive and privileged access to bring their extraordinary art and remarkable stories to the big screen in February so that you can enjoy both film and exhibition together. Discover unexpected sides to both artists with intimate views of sketchbooks and personal items and insights from leading experts.\\nTurner’s blazing sunsets and sublime scenes from his travels and Constable’s idealised depictions of beloved places from home whipped the public of the time into a frenzy of enthusiasm. Constable represents the very best of the old school of realism and pastoral nostalgia; Turner, an exciting new way of depicting emotion and dreamlike impressions. Critics compared their starkly different styles to a clash of ‘fire and water’. Don’t miss this opportunity to see these greats side-by-side, as they so often were in life, on the big screen for the first time.\",\"certificate\":null,\"casting\":[],\"direction\":[\"David Bickerstaff\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/ee3751d515f699df5893ddd4516d2880.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/ee3751d515f699df5893ddd4516d2880.jpg\"],\"release\":\"2026-03-06T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000033715\",\"title\":\"Eyes Wide Shut (35mm)\",\"runtime\":9540,\"genres\":\"Drama, Thriller, Erotic\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/dd142cd6909f3c89e10b43bde4877921.jpg\",\"__typename\":\"Movie\",\"altId\":[\"403800\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Stanley\",\"lastName\":\"Kubrick\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Tom\",\"lastName\":\"Cruise\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Nicole\",\"lastName\":\"Kidman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Madison\",\"lastName\":\"Eginton\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-01T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Eyes Wide Shut (35mm)\",\"synopsis\":\"At a Christmas party hosted by wealthy, unconventional Victor Ziegler (Sydney Pollack), provocative advances and innocent flirtations arouse suspicion as high-society physician Dr. William Harford (Cruise) and his sexy wife, Alice (Kidman) watch each other from a distance. Alone later, this seemingly perfect couple confront their intimate sexual fantasies -- which don't include each other. Caught between reality and illusion, jealousy and obsession, William struggles with his inner urges. Will he act on his erotic fantasies or keep them hidden deep inside? Sometimes a man can see more clearly with his Eyes Wide Shut.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/85/dc/85dcbfedfc1493277cbe2aa7a3b536af.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/dd142cd6909f3c89e10b43bde4877921.jpg\",\"synopsis\":\"At a Christmas party hosted by wealthy, unconventional Victor Ziegler (Sydney Pollack), provocative advances and innocent flirtations arouse suspicion as high-society physician Dr. William Harford (Cruise) and his sexy wife, Alice (Kidman) watch each other from a distance. \\n\\nAlone later, this seemingly perfect couple confront their intimate sexual fantasies -- which don't include each other. Caught between reality and illusion, jealousy and obsession, William struggles with his inner urges. Will he act on his erotic fantasies or keep them hidden deep inside? Sometimes a man can see more clearly with his Eyes Wide Shut.\\n\\nScreening in stunning 35mm at Christmas on the Green this winter.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Eyes Wide Shut (35mm)\",\"synopsis\":\"At a Christmas party hosted by wealthy, unconventional Victor Ziegler (Sydney Pollack), provocative advances and innocent flirtations arouse suspicion as high-society physician Dr. William Harford (Cruise) and his sexy wife, Alice (Kidman) watch each other from a distance. \\n\\nAlone later, this seemingly perfect couple confront their intimate sexual fantasies -- which don't include each other. Caught between reality and illusion, jealousy and obsession, William struggles with his inner urges. Will he act on his erotic fantasies or keep them hidden deep inside? Sometimes a man can see more clearly with his Eyes Wide Shut.\\n\\nScreening in stunning 35mm at Christmas on the Green this winter.\",\"certificate\":\"18\",\"casting\":[\"Tom Cruise\",\"Nicole Kidman\",\"Madison Eginton\"],\"direction\":[\"Stanley Kubrick\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-12-01T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"206794\",\"title\":\"Frankenstein\",\"runtime\":9000,\"genres\":\"Drama, Science fiction, Horror\",\"__typename\":\"Movie\",\"altId\":[\"382659\",\"404536\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/fd070124b55fac5f99bf1667170229aa.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/a6/3c/a63c6bc1605700de1024fd33f2581c66.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/43/0e/430e45e58e0f868477a192724d5a110e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e4/72/e472440f3c0bc9032468af40817839f0.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ab/46/ab46d36ff0fe16211126366a80225cf1.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/dc/d1/dcd1a6950bba26de544b9f481d48cdf2.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/41/ec/41ec5b2a915dfb55f94b03d811db45d3.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/06/de/06de307e68787da21d88995b6b691de0.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/54/af/54af2d3104697fe760f6cf01a6e554fd.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/3f/7e/3f7ed994b13222361afc0b14dde71a4b.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e7/c4/e7c40966afd6c0b66afb0fe62d7228fa.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Guillermo\",\"lastName\":\"del Toro\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Oscar\",\"lastName\":\"Isaac\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jacob\",\"lastName\":\"Elordi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mia\",\"lastName\":\"Goth\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christoph\",\"lastName\":\"Waltz\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Felix\",\"lastName\":\"Kammerer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Lars\",\"lastName\":\"Mikkelsen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"David\",\"lastName\":\"Bradley (IV)\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christian\",\"lastName\":\"Convery\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sofia\",\"lastName\":\"Galasso\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Charles\",\"lastName\":\"Dance\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-24T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"40174\",\"name\":\"Netflix\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong violence, injury detail\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Frankenstein\",\"synopsis\":\"Oscar-winning director Guillermo del Toro adapts Mary Shelley's classic tale of Victor Frankenstein, a brilliant but egotistical scientist who brings a creature to life in a monstrous experiment that ultimately leads to the undoing of both the creator and his tragic creation.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/ea/a8/eaa845cf3e9036e0ac687d60c84ced64.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/2de2d61a78bc4917b0b40d56e998468a.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/fd070124b55fac5f99bf1667170229aa.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/86ee705cd9c3b5c5f5edcea04beddc9c.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Frankenstein\",\"synopsis\":\"Oscar-winning director Guillermo del Toro adapts Mary Shelley's classic tale of Victor Frankenstein, a brilliant but egotistical scientist who brings a creature to life in a monstrous experiment that ultimately leads to the undoing of both the creator and his tragic creation.\",\"certificate\":\"15\",\"casting\":[\"Oscar Isaac\",\"Jacob Elordi\",\"Mia Goth\",\"Christoph Waltz\",\"Felix Kammerer\",\"Lars Mikkelsen\",\"David Bradley (IV)\",\"Christian Convery\",\"Sofia Galasso\",\"Charles Dance\"],\"direction\":[\"Guillermo del Toro\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/86ee705cd9c3b5c5f5edcea04beddc9c.jpg\",\"https://all.web.img.acsta.net/img/a6/3c/a63c6bc1605700de1024fd33f2581c66.jpg\",\"https://all.web.img.acsta.net/img/43/0e/430e45e58e0f868477a192724d5a110e.jpg\",\"https://all.web.img.acsta.net/img/e4/72/e472440f3c0bc9032468af40817839f0.jpg\",\"https://all.web.img.acsta.net/img/ab/46/ab46d36ff0fe16211126366a80225cf1.jpg\",\"https://all.web.img.acsta.net/img/dc/d1/dcd1a6950bba26de544b9f481d48cdf2.jpg\",\"https://all.web.img