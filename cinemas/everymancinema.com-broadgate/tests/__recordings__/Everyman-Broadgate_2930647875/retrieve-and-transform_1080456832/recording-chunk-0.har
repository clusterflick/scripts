rdo\",\"Jesse Gervasi\",\"Kai Harris\",\"Courtney Gilmour\",\"Kim Roberts\"],\"direction\":[\"Jamie Whitney\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/72/e7/72e723f747a4a179ec228672cc3e7bd8.jpg\",\"https://all.web.img.acsta.net/img/f1/a5/f1a503cfa991e275cd8f984038663777.jpg\",\"https://all.web.img.acsta.net/img/3d/7b/3d7ba09c2cff959dc2d5cba583be6061.jpg\",\"https://all.web.img.acsta.net/img/b3/97/b39707e3e22bfbac45d512488b2333b1.jpg\"],\"heroImages\":[],\"release\":\"2025-11-07T00:00:00.000Z\",\"advisory\":\"very mild threat\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Paramount Pictures UK\"}},{\"id\":\"1000021733\",\"title\":\"André Rieu's 2025 Christmas Concert: Merry Christmas\",\"runtime\":10800,\"genres\":\"Concert\",\"__typename\":\"Movie\",\"altId\":[\"389063\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/bb8fbd6b08c1a5eb94755e8f35dd9050.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"André\",\"lastName\":\"Rieu\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"André\",\"lastName\":\"Rieu\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emma\",\"lastName\":\"Kok\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-05T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"distributors\":[{\"id\":\"43134\",\"name\":\"Piece of Magic Entertainment\",\"__typename\":\"Company\"}],\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Andre Rieu's 2025 Christmas Concert: Merry Christmas\",\"synopsis\":\"This holiday season, the magic begins on the big screen. Join André Rieu for his 2025 Christmas Concert – “Merry Christmas” and experience joyful carols, beautiful waltzes, and plenty of surprises – it’s the ultimate Christmas cinema event! With his fabulous Johann Strauss Orchestra, and special guests including the sensational Emma Kok and over 400 brass players bringing the majestic sound of Christmas, André’s concert is bursting with warmth, laughter, and holiday cheer. Christmas is André’s favorite time of year - and he can’t wait to share this spectacular concert with you, only in cinemas!\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/52/c0/52c0ef24bceec569a8a64d5977c777bb.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"André Rieu's 2025 Christmas Concert: Merry Christmas\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/bb8fbd6b08c1a5eb94755e8f35dd9050.jpg\",\"synopsis\":\"This holiday season, the magic begins on the big screen. Join André Rieu for his 2025 Christmas Concert – “Merry Christmas” and experience joyful carols, beautiful waltzes, and plenty of surprises – it’s the ultimate Christmas cinema event! With his fabulous Johann Strauss Orchestra, and special guests including the sensational Emma Kok and over 400 brass players bringing the majestic sound of Christmas, André’s concert is bursting with warmth, laughter, and holiday cheer. Christmas is André’s favourite time of year - and he can’t wait to share this spectacular concert with you, only in cinemas!\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"André Rieu's 2025 Christmas Concert: Merry Christmas\",\"synopsis\":\"This holiday season, the magic begins on the big screen. Join André Rieu for his 2025 Christmas Concert – “Merry Christmas” and experience joyful carols, beautiful waltzes, and plenty of surprises – it’s the ultimate Christmas cinema event! With his fabulous Johann Strauss Orchestra, and special guests including the sensational Emma Kok and over 400 brass players bringing the majestic sound of Christmas, André’s concert is bursting with warmth, laughter, and holiday cheer. Christmas is André’s favourite time of year - and he can’t wait to share this spectacular concert with you, only in cinemas!\",\"certificate\":null,\"casting\":[\"André Rieu\",\"Emma Kok\"],\"direction\":[\"André Rieu\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-12-05T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Piece of Magic Entertainment\"}},{\"id\":\"1000012643\",\"title\":\"Anemone\",\"runtime\":7560,\"genres\":\"Drama\",\"__typename\":\"Movie\",\"altId\":[\"376713\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/f2a63a43b80c0fcf4e6ea6c8234ce576.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/ae/5a/ae5afc64edaa1525b8b81cd6e541fe81.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/f0/78/f078fd1f2b3b9592374101bbb559f320.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Ronan\",\"lastName\":\"Day-Lewis\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Daniel\",\"lastName\":\"Day-Lewis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sean\",\"lastName\":\"Bean\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Samantha\",\"lastName