ypename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"The Mastermind\",\"synopsis\":\"In 1970, Mooney and two cohorts wander into a museum in broad daylight and steal four paintings. When holding onto the art proves more difficult than stealing them, Mooney is relegated to a life on the run.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/ac/38/ac38a08aed76e5c809f789d0a5be13f2.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Beyond: The Mastermind\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/b5906dec566b1fa6f0ef68611ae755f5.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Beyond: The Mastermind\",\"synopsis\":\"In 1970, Mooney and two cohorts wander into a museum in broad daylight and steal four paintings. When holding onto the art proves more difficult than stealing them, Mooney is relegated to a life on the run.\",\"certificate\":\"12A\",\"casting\":[\"Josh O'Connor\",\"Alana Haim\",\"John Magaro\"],\"direction\":[\"Kelly Reichardt\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-11-24T00:00:00.000Z\",\"advisory\":\"infrequent strong language, moderate violence, drug references\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"MUBI\"}},{\"id\":\"323047\",\"title\":\"Black Phone 2\",\"runtime\":6840,\"genres\":\"Horror, Thriller\",\"__typename\":\"Movie\",\"altId\":[\"353451\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/f57b0699be45c6c0355061668d30e375.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/c9/ae/c9aefdd8d2e9512b6af6e40399748587.JPG\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/fe/f3/fef338f053674ccf1da51dd65a91ecba.JPG\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ef/aa/efaae2ee180a9e733158331af1f5c642.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/3e/3f/3e3f1dee5d0e83e3128ce42c6be4328e.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/92/48/92481963c9d1daac6ae6239d8f982766.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ef/84/ef8440aa443aaa7f7e7fa4cf4a21d297.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/ec/fc/ecfc28c48b180fd6f43d9fc368d5ac01.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/54/36/543683e260c2aa52acb8a13e38fbaa8c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/51/85/5185c15c9bbfc6c861f7c31d718e0d4c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/54/55/5455369d8588f4542e6b98778655176e.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Scott\",\"lastName\":\"Derrickson\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mason\",\"lastName\":\"Thames\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Madeleine\",\"lastName\":\"McGraw\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ethan\",\"lastName\":\"Hawke\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Demian\",\"lastName\":\"Bichir\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Miguel\",\"lastName\":\"Cazarez Mora\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Arianna\",\"lastName\":\"Rivas\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jeremy\",\"lastName\":\"Davies\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rebecca\",\"lastName\":\"Clarke\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Anna\",\"lastName\":\"Lore\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Maev\",\"lastName\":\"Beaty\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-17T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong bloody violence\",\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Black Phone 2\",\"synopsis\":\"Four years ago, 13-year-old Finn killed his abductor and escaped, becoming the sole survivor of The Grabber. But true evil transcends death … and the phone is ringing again. \\n\\nFour-time Academy Award® nominee Ethan Hawke returns to the most sinister role of his career as The Grabber seeks vengeance on Finn (Mason Thames) from beyond the grave by menacing Finn’s younger sister, Gwen (Madeleine McGraw). \\n\\nAs Finn, now 17, struggles with life after his captivity, the headstrong 15-year-old Gwen begins receiving calls in her dreams from the black phone and seeing disturbing visions of three boys being stalked at a winter camp known as Alpine Lake. \\n\\nDetermined to solve the mystery and end the torment for both her and her brother, Gwen persuades Finn to visit the camp during a winter storm. There, she uncovers a shattering intersection between The Grabber and her own family’s history. Together, she and Finn must confront a killer who has grown more powerful in death and more significant to them than either could imagine.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/353451_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/353451_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/d5/27/d52734752deaac44bb4dbc5318b7b21f.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/63cfd82e62a915010183f67b98549647.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":\"Black Phone 2\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/f57b0699be45c6c0355061668d30e375.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/b7d27e57e51a1d6be3336e01978986b9.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Black Phone 2\",\"synopsis\":\"Four years ago, 13-year-old Finn killed his abductor and escaped, becoming the sole survivor of The Grabber. But true evil transcends death … and the phone is ringing again. \\n\\nFour-time Academy Award® nominee Ethan Hawke returns to the most sinister role of his career as The Grabber seeks vengeance on Finn (Mason Thames) from beyond the grave by menacing Finn’s younger sister, Gwen (Madeleine McGraw). \\n\\nAs Finn, now 17, struggles with life after his captivity, the headstrong 15-year-old Gwen begins receiving calls in her dreams from the black phone and seeing disturbing visions of three boys being stalked at a winter camp known as Alpine Lake. \\n\\nDetermined to solve the mystery and end the torment for both her and her brother, Gwen persuades Finn to visit the camp during a winter storm. There, she uncovers a shattering intersection between The Grabber and her own family’s history. Together, she and Finn must confront a killer who has grown more powerful in death and more significant to them than either could imagine.\",\"certificate\":\"18\",\"casting\":[\"Mason Thames\",\"Madeleine McGraw\",\"Ethan Hawke\",\"Demian Bichir\",\"Miguel Cazarez Mora\",\"Arianna Rivas\",\"Jeremy Davies\",\"Rebecca Clarke\",\"Anna Lore\",\"Maev Beaty\"],\"direction\":[\"Scott Derrickson\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/b7d27e57e51a1d6be3336e01978986b9.jpg\",\"https://all.web.img.acsta.net/img/c9/ae/c9aefdd8d2e9512b6af6e40399748587.JPG\",\"https://all.web.img.acsta.net/img/fe/f3/fef338f053674ccf1da51dd65a91ecba.JPG\",\"https://all.web.img.acsta.net/img/ef/aa/efaae2ee180a9e733158331af1f5c642.jpg\",\"https://all.web.img.acsta.net/img/3e/3f/3e3f1dee5d0e83e3128ce42c6be4328e.jpg\",\"https://all.web.img.acsta.net/img/92/48/92481963c9d1daac6ae6239d8f982766.jpg\",\"https://all.web.img.acsta.net/img/ef/84/ef8440aa443aaa7f7e7fa4cf4a21d297.jpg\",\"https://all.web.img.acsta.net/img/ec/fc/ecfc28c48b180fd6f43d9fc368d5ac01.jpg\",\"https://all.web.img.acsta.net/img/54/36/543683e260c2aa52acb8a13e38fbaa8c.jpg\",\"https://all.web.img.acsta.net/img/51/85/5185c15c9bbfc6c861f7c31d718e0d4c.jpg\",\"https://all.web.img.acsta.net/img/54/55/5455369d8588f4542e6b98778655176e.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/b7d27e57e51a1d6be3336e01978986b9.jpg\",\"https://cms-assets.webediamovies.pro/production/2/63cfd82e62a915010183f67b98549647.jpg\"],\"release\":\"2025-10-17T00:00:00.000Z\",\"advisory\":\"strong bloody violence\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/353451_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/353451_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Universal International Pictures\"}},{\"id\":\"1975\",\"title\":\"Blade Runner\",\"runtime\":7020,\"genres\":\"Science fiction\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/57375104cbd83bf27dde7b6c1cd8e899.jpg\",\"__typename\":\"Movie\",\"altId\":[\"15042\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902250.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902249.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902235.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902234.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902233.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902231.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902228.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902219.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902216.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902213.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Ridley\",\"lastName\":\"Scott\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Harrison\",\"lastName\":\"Ford\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rutger\",\"lastName\":\"Hauer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sean\",\"lastName\":\"Young\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Daryl\",\"lastName\":\"Hannah\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"M. Emmet\",\"lastName\":\"Walsh\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"William\",\"lastName\":\"Sanderson\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brion\",\"lastName\":\"James\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joe\",\"lastName\":\"Turkel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Edward James\",\"lastName\":\"Olmos\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joanna\",\"lastName\":\"Cassidy\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"1986-04-10T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong violence\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Blade Runner\",\"synopsis\":\"In the year 2019, ex-detective Rick Deckard is called out of retirement to track down and eliminate a team of humanoid androids that have escaped from an outer space mining colony and have taken refuge here on Earth. During his search for the fugitives, he discovers some disturbing secrets about the future plans of the androids' manufacturer, the Tyrell Corporation.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/2a/a5/2aa53a45c3b5d7e38b79134a67af8a96.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/57375104cbd83bf27dde7b6c1cd8e899.jpg\",\"synopsis\":\"Selected by the Production Designers Branch, Everyman presents: Blade Runner\\n\\nIn the year 2019, ex-detective Rick Deckard is called out of retirement to track down and eliminate a team of humanoid androids that have escaped from an outer space mining colony and have taken refuge here on Earth. During his search for the fugitives, he discovers some disturbing secrets about the future plans of the androids' manufacturer, the Tyrell Corporation.\\n\\nThe design team of Lawrence G. Paull, David L. Snyder, and Linda DeScenna helped create one of cinema’s most indelible and imaginative visualizations of the city of the future (in this case, the Los Angeles of 2019) in this science-fiction noir, directed by Ridley Scott and adapted from the Philip K. Dick novel Do Androids Dream of Electric Sheep? which has become a classic in the forty years since its release. The film was nominated for Art Direction and for its Visual Effects, which are as seamlessly convincing as the day it premiered. \\n\\nPresented in 4k, the feature returns to the big screen at Everyman The Whiteley on Thursday, 23 October.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/a0d88e1dba1f39d72baf133ebaafef72.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Blade Runner\",\"synopsis\":\"Selected by the Production Designers Branch, Everyman presents: Blade Runner\\n\\nIn the year 2019, ex-detective Rick Deckard is called out of retirement to track down and eliminate a team of humanoid androids that have escaped from an outer space mining colony and have taken refuge here on Earth. During his search for the fugitives, he discovers some disturbing secrets about the future plans of the androids' manufacturer, the Tyrell Corporation.\\n\\nThe design team of Lawrence G. Paull, David L. Snyder, and Linda DeScenna helped create one of cinema’s most indelible and imaginative visualizations of the city of the future (in this case, the Los Angeles of 2019) in this science-fiction noir, directed by Ridley Scott and adapted from the Philip K. Dick novel Do Androids Dream of Electric Sheep? which has become a classic in the forty years since its release. The film was nominated for Art Direction and for its Visual Effects, which are as seamlessly convincing as the day it premiered. \\n\\nPresented in 4k, the feature returns to the big screen at Everyman The Whiteley on Thursday, 23 October.\",\"certificate\":\"15\",\"casting\":[\"Harrison Ford\",\"Rutger Hauer\",\"Sean Young\",\"Daryl Hannah\",\"M. Emmet Walsh\",\"William Sanderson\",\"Brion James\",\"Joe Turkel\",\"Edward James Olmos\",\"Joanna Cassidy\"],\"direction\":[\"Ridley Scott\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/a0d88e1dba1f39d72baf133ebaafef72.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902250.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902249.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902235.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902234.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902233.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902231.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902228.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902219.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902216.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/66/01/66/18902213.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/a0d88e1dba1f39d72baf133ebaafef72.jpg\"],\"release\":\"1986-04-10T00:00:00.000Z\",\"advisory\":\"strong violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Warner Bros U.K.\"}},{\"id\":\"29\",\"title\":\"Breathless\",\"runtime\":5400,\"genres\":\"Detective, Drama, Romance\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/5ab21cba4f9f5a8a11d8ba95f3c18d49.jpg\",\"__typename\":\"Movie\",\"altId\":[\"6977\",\"92609\",\"184863\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jean-Luc\",\"lastName\":\"Godard\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jean\",\"lastName\":\"Seberg\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jean-Paul\",\"lastName\":\"Belmondo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Daniel\",\"lastName\":\"Boulanger\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Henri-Jacques\",\"lastName\":\"Huet\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Roger\",\"lastName\":\"Hanin\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Van\",\"lastName\":\"Doude\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Claude\",\"lastName\":\"Mansard\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Liliane\",\"lastName\":\"Dreyfus\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michel\",\"lastName\":\"Fabre\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jean-Pierre\",\"lastName\":\"Melville\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2020-12-04T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"9447\",\"name\":\"StudioCanal UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"moderate sex references, brief nudity\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]},{\"releasedAt\":\"2026-02-05T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"32481\",\"name\":\"Studio Canal\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"moderate sex references, brief nudity\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Breathless\",\"synopsis\":\"Godard's jazzy riff on American Film Noir features iconic performances from Jean-Paul Belmondo, as the on-the-run Bogart-inspired small-time hood, and Jean Seberg as his American, Herald Tribune-hawking girlfriend, who ultimately betrays him. With a pace that's non-stop, thanks to its startling new editing techniques, BREATHLESS reinvented the grammar of movies and almost instantly changed the course of international filmmaking.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/6977_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/6977_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/83/7b/837b8a73b877e5841ae4e7a57510399e.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/5ab21cba4f9f5a8a11d8ba95f3c18d49.jpg\",\"synopsis\":\"Selected by the Film Editors Branch, Everyman presents: Breathless\\n\\nPetty thug Michel (Jean-Paul Belmondo) considers himself a suave bad guy in the manner of Humphrey Bogart, but panics and impulsively kills a policeman while driving a stolen car. On the lam, he turns to his aspiring journalist girlfriend, Patricia (Jean Seberg), hiding out in her Paris apartment while he tries to pull together enough money to get the pair to Italy. But when Patricia learns that her boyfriend is being investigated for murder, she begins to question her loyalties.\\n\\nJean-Luc Godard dedicated his game-changing thriller to the American B-movie studio Monogram Pictures, and this tale of an American student who falls for a Parisian thief is not only one of the defining films of the French New Wave but one of cinema’s most influential films. Jean Seberg and Jean-Paul Belmondo’s career-defining performances made them icons of cinematic cool, while Raoul Coutard’s striking black-and-white, hand-held cinematography captures the chaotic elegance of the city of lights. The film editing of Cécile Decugis—a filmmaker and activist in her own right—incorporated groundbreaking techniques, such as jump cuts, that forever changed the way cinematic stories are told.  \\n\\nPresented in restored 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 5 February.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/8c9dbb6ccaf86a9d7abe0449cd8a6eab.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"À bout de souffle\",\"synopsis\":\"Selected by the Film Editors Branch, Everyman presents: Breathless\\n\\nPetty thug Michel (Jean-Paul Belmondo) considers himself a suave bad guy in the manner of Humphrey Bogart, but panics and impulsively kills a policeman while driving a stolen car. On the lam, he turns to his aspiring journalist girlfriend, Patricia (Jean Seberg), hiding out in her Paris apartment while he tries to pull together enough money to get the pair to Italy. But when Patricia learns that her boyfriend is being investigated for murder, she begins to question her loyalties.\\n\\nJean-Luc Godard dedicated his game-changing thriller to the American B-movie studio Monogram Pictures, and this tale of an American student who falls for a Parisian thief is not only one of the defining films of the French New Wave but one of cinema’s most influential films. Jean Seberg and Jean-Paul Belmondo’s career-defining performances made them icons of cinematic cool, while Raoul Coutard’s striking black-and-white, hand-held cinematography captures the chaotic elegance of the city of lights. The film editing of Cécile Decugis—a filmmaker and activist in her own right—incorporated groundbreaking techniques, such as jump cuts, that forever changed the way cinematic stories are told.  \\n\\nPresented in restored 4k, the feature returns to the big screen at Everyman at The Whiteley on Thursday, 5 February.\",\"certificate\":\"12A\",\"casting\":[\"Jean Seberg\",\"Jean-Paul Belmondo\",\"Daniel Boulanger\",\"Henri-Jacques Huet\",\"Roger Hanin\",\"Van Doude\",\"Claude Mansard\",\"Liliane Dreyfus\",\"Michel Fabre\",\"Jean-Pierre Melville\"],\"direction\":[\"Jean-Luc Godard\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/8c9dbb6ccaf86a9d7abe0449cd8a6eab.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/8c9dbb6ccaf86a9d7abe0449cd8a6eab.jpg\"],\"release\":\"2020-12-04T00:00:00.000Z\",\"advisory\":\"moderate sex references, brief nudity\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/6977_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/6977_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"StudioCanal UK\"}},{\"id\":\"282613\",\"title\":\"Bugonia\",\"runtime\":7140,\"genres\":\"Science fiction\",\"__typename\":\"Movie\",\"altId\":[\"363871\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/5af7acab5f6f165661b45c5848c949b4.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/8b/fd/8bfdb63a039ba5a439924fd2619fb0f2.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/69/bb/69bbcae9ab59d50737edfe17c55efc33.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/89/0f/890fb71cca68e9bf7bce5eea9947f7f3.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/50/6f/506f4970fd8147c099a0fb539387bfc6.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Yorgos\",\"lastName\":\"Lanthimos\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Emma\",\"lastName\":\"Stone\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jesse\",\"lastName\":\"Plemons\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Aidan\",\"lastName\":\"Delbis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alicia\",\"lastName\":\"Silverstone\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Stavros\",\"lastName\":\"Halkias\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Parvinder\",\"lastName\":\"Shergill\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Vanessa\",\"lastName\":\"Eng\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Momma\",\"lastName\":\"Cherri\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cedric\",\"lastName\":\"Dumornay\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marc T.\",\"lastName\":\"Lewis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-31T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"26962\",\"name\":\"Universal Pictures International\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong violence, injury detail, suicide, very strong language\",\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Bugonia\",\"synopsis\":\"Two conspiracy obsessed young men kidnap the high-powered CEO of a major company, convinced that she is an alien intent on destroying planet Earth. BUGONIA is based on the South Korean sci-fi comedy, SAVE THE GREEN PLANET (2003).\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/363871_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/363871_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/7a/ae/7aaef9661d91df5c100d141af9567d13.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/5330044dddea05bdfbabfcbb4e479ae1.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/5af7acab5f6f165661b45c5848c949b4.jpg\",\"synopsis\":\"Two conspiracy-obsessed young men kidnap the high-powered CEO of a major company, convinced that she is an alien intent on destroying planet Earth. Bugonia is based on the South Korean sci-fi comedy, SAVE THE GREEN PLANET (2003).\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/434a5159784ed76beba9c140860bebf4.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Bugonia\",\"synopsis\":\"Two conspiracy-obsessed young men kidnap the high-powered CEO of a major company, convinced that she is an alien intent on destroying planet Earth. Bugonia is based on the South Korean sci-fi comedy, SAVE THE GREEN PLANET (2003).\",\"certificate\":\"15\",\"casting\":[\"Emma Stone\",\"Jesse Plemons\",\"Aidan Delbis\",\"Alicia Silverstone\",\"Stavros Halkias\",\"Parvinder Shergill\",\"Vanessa Eng\",\"Momma Cherri\",\"Cedric Dumornay\",\"Marc T. Lewis\"],\"direction\":[\"Yorgos Lanthimos\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/434a5159784ed76beba9c140860bebf4.jpg\",\"https://all.web.img.acsta.net/img/8b/fd/8bfdb63a039ba5a439924fd2619fb0f2.jpg\",\"https://all.web.img.acsta.net/img/69/bb/69bbcae9ab59d50737edfe17c55efc33.jpg\",\"https://all.web.img.acsta.net/img/89/0f/890fb71cca68e9bf7bce5eea9947f7f3.jpg\",\"https://all.web.img.acsta.net/img/50/6f/506f4970fd8147c099a0fb539387bfc6.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/434a5159784ed76beba9c140860bebf4.jpg\",\"https://cms-assets.webediamovies.pro/production/2/5330044dddea05bdfbabfcbb4e479ae1.jpg\"],\"release\":\"2025-10-31T00:00:00.000Z\",\"advisory\":\"strong violence, injury detail, suicide, very strong language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/363871_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/363871_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Universal Pictures International\"}},{\"id\":\"1000033717\",\"title\":\"Carol (35mm)\",\"runtime\":7080,\"genres\":\"Drama, Romance\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/461c683acaf78e4d03872ce0552557b5.jpg\",\"__typename\":\"Movie\",\"altId\":[\"403802\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Todd\",\"lastName\":\"Haynes\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cate\",\"lastName\":\"Blanchett\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rooney\",\"lastName\":\"Mara\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kyle\",\"lastName\":\"Chandler\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-01T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"9447\",\"name\":\"StudioCanal UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Carol (35mm)\",\"synopsis\":\"A young woman in her 20s, Therese Belivet is a clerk working in a Manhattan department store and dreaming of a more fulfilling life when she meets Carol, an alluring woman trapped in a loveless, convenient marriage.  As an immediate connection sparks between them, the innocence of their first encounter dims and their connection deepens. While Carol breaks free from the confines of marriage, her husband threatens her competence as a mother when Carol's involvement with Therese and close relationship with her best friend Abby comes to light.  As Carol leaves the comfort of home to travel with Therese, an internal journey of self-discovery coincides with her new sense of space.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/ac/2f/ac2f951161e9548f8dc62029b32ab568.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/461c683acaf78e4d03872ce0552557b5.jpg\",\"synopsis\":\"A young woman in her 20s, Therese Belivet, is a clerk working in a Manhattan department store and dreaming of a more fulfilling life when she meets Carol, an alluring woman trapped in a loveless, convenient marriage. As an immediate connection sparks between them, the innocence of their first encounter dims, and their connection deepens. \\n\\nWhile Carol breaks free from the confines of marriage, her husband threatens her competence as a mother when Carol's involvement with Therese and her close relationship with her best friend Abby come to light.  As Carol leaves the comfort of home to travel with Therese, an internal journey of self-discovery coincides with her new sense of space.\\n\\nScreening in stunning 35mm at Christmas on the Green this winter.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Carol (35mm)\",\"synopsis\":\"A young woman in her 20s, Therese Belivet, is a clerk working in a Manhattan department store and dreaming of a more fulfilling life when she meets Carol, an alluring woman trapped in a loveless, convenient marriage. As an immediate connection sparks between them, the innocence of their first encounter dims, and their connection deepens. \\n\\nWhile Carol breaks free from the confines of marriage, her husband threatens her competence as a mother when Carol's involvement with Therese and her close relationship with her best friend Abby come to light.  As Carol leaves the comfort of home to travel with Therese, an internal journey of self-discovery coincides with her new sense of space.\\n\\nScreening in stunning 35mm at Christmas on the Green this winter.\",\"certificate\":\"15\",\"casting\":[\"Cate Blanchett\",\"Rooney Mara\",\"Kyle Chandler\"],\"direction\":[\"Todd Haynes\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-12-01T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"StudioCanal UK\"}},{\"id\":\"14178\",\"title\":\"Casino\",\"runtime\":10680,\"genres\":\"Drama, Detective\",\"__typename\":\"Movie\",\"altId\":[\"3139\"],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"poster\":\"https://cms-assets.webediamovies.pro/production/279/bc3522e54f7c571ca3b2a2acc57bde07.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840349.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840348.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840347.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840336.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840335.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840334.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18984810.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18462109.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18462108.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18462106.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Martin\",\"lastName\":\"Scorsese\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"De Niro\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sharon\",\"lastName\":\"Stone\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Joe\",\"lastName\":\"Pesci\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Don\",\"lastName\":\"Rickles\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"James\",\"lastName\":\"Woods\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kevin\",\"lastName\":\"Pollak\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Frank\",\"lastName\":\"Vincent\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alan\",\"lastName\":\"King\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dick\",\"lastName\":\"Smothers\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Catherine\",\"lastName\":\"Scorsese\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2023-09-16T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13733\",\"name\":\"Universal International Pictures\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"strong violence\",\"__typename\":\"Rating\",\"certificate\":\"18\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Casino\",\"synopsis\":\"Robert DeNiro, Sharon Stone and Joe Pesci star in director Martin Scorsese's riveting look at how blind ambition, white-hot passion and 24-karat greed toppled an empire. Las Vegas 1973 is the setting for this fact-based story about the Mob's multi-million dollar casino operation - where fortunes and lives were made and lost with a roll of the dice.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/0f/2b/0f2b617c052914f03487cf6906bc0257.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/bc3522e54f7c571ca3b2a2acc57bde07.jpg\",\"synopsis\":\"Selected by the Actors Branch, Everyman presents: Casino\\n\\nRobert De Niro, Sharon Stone and Joe Pesci star in director Martin Scorsese's riveting look at how blind ambition, white-hot passion and 24-karat greed toppled an empire. Las Vegas 1973 is the setting for this fact-based story about the Mob's multi-million dollar casino operation, where fortunes and lives were made and lost with a roll of the dice.\\n\\nAuthor Nicholas Pileggi teamed up with director Martin Scorsese to adapt his own non-fiction book about the influence of organised crime in Las Vegas gambling in the 1970s and ’80s for this thrilling true crime epic, showcasing the director’s dazzling style with the help of such key collaborators as cinematographer Robert Richardson and editor Thelma Schoonmaker. Casting director Ellen Lewis assembled an impressively eclectic ensemble including Oscar-winning Scorsese perennials Robert De Niro and Joe Pesci, several comedians in rare serious roles (including Don Rickles, Alan King, and Dick Smothers), and Sharon Stone, whose uncompromising performance as the troubled wife of De Niro’s casino boss earned her a Best Actress nomination.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman The Whiteley on Thursday, 6 November.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/38673aa35d60cdf741fbeb3bf89144dc.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Casino\",\"synopsis\":\"Selected by the Actors Branch, Everyman presents: Casino\\n\\nRobert De Niro, Sharon Stone and Joe Pesci star in director Martin Scorsese's riveting look at how blind ambition, white-hot passion and 24-karat greed toppled an empire. Las Vegas 1973 is the setting for this fact-based story about the Mob's multi-million dollar casino operation, where fortunes and lives were made and lost with a roll of the dice.\\n\\nAuthor Nicholas Pileggi teamed up with director Martin Scorsese to adapt his own non-fiction book about the influence of organised crime in Las Vegas gambling in the 1970s and ’80s for this thrilling true crime epic, showcasing the director’s dazzling style with the help of such key collaborators as cinematographer Robert Richardson and editor Thelma Schoonmaker. Casting director Ellen Lewis assembled an impressively eclectic ensemble including Oscar-winning Scorsese perennials Robert De Niro and Joe Pesci, several comedians in rare serious roles (including Don Rickles, Alan King, and Dick Smothers), and Sharon Stone, whose uncompromising performance as the troubled wife of De Niro’s casino boss earned her a Best Actress nomination.\\n\\nPresented in 2k, the feature returns to the big screen at Everyman The Whiteley on Thursday, 6 November.\",\"certificate\":\"18\",\"casting\":[\"Robert De Niro\",\"Sharon Stone\",\"Joe Pesci\",\"Don Rickles\",\"James Woods\",\"Kevin Pollak\",\"Frank Vincent\",\"Alan King\",\"Dick Smothers\",\"Catherine Scorsese\"],\"direction\":[\"Martin Scorsese\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/38673aa35d60cdf741fbeb3bf89144dc.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840349.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840348.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840347.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840336.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840335.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18840334.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18984810.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18462109.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18462108.jpg\",\"https://all.web.img.acsta.net/medias/nmedia/18/36/21/14/18462106.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/38673aa35d60cdf741fbeb3bf89144dc.jpg\"],\"release\":\"2023-09-16T00:00:00.000Z\",\"advisory\":\"strong violence\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Universal International Pictures\"}},{\"id\":\"1000006167\",\"title\":\"Christmas Karma\",\"runtime\":6600,\"genres\":\"Comedy, Family, Music\",\"__typename\":\"Movie\",\"altId\":[\"368195\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"poster\":\"https://all.web.img.acsta.net/img/19/19/1919249e75842a78410a24a42e64bc8f.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/32/52/3252111e44bf37928102f123c4976186.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/44/13/44135b6fa12dc0c281b3dd07c0132c62.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/59/78/5978181e194b4505e58e5da09a0bec86.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c5/2e/c52e3d45958c088329330c58d7fed94b.jpg\",\"__typename\":\"Image\"}],\"quadImages\":[\"https://all.web.img.acsta.net/img/9b/ae/9baebd118bd96f694fae6dedb2fbec97.jpg\",\"https://all.web.img.acsta.net/img/8f/5c/8f5c20e58a3faf4c249310f96af6943a.jpg\"],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Gurinder\",\"lastName\":\"Chadha\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kunal\",\"lastName\":\"Nayyar\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Eva\",\"lastName\":\"Longoria\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Billy\",\"lastName\":\"Porter\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":null,\"lastName\":\"Boy George\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Charithra\",\"lastName\":\"Chandran\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hugh\",\"lastName\":\"Bonneville\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Leo\",\"lastName\":\"Suter\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Pixie\",\"lastName\":\"Lott\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Danny\",\"lastName\":\"Dyer\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-14T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"1000112319\",\"name\":\"True Brit Entertainment Ltd.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild violence, discrimination, language\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Christmas Karma\",\"synopsis\":\"Told from Chadha’s unique point of view and in her own distinctive style, the film resonates with Dickens’ masterful statement on the human condition, exploring themes of prejudice, acceptance, reconciliation, identity and belonging. Inspired by Frank Capra’s timeless ‘It’s A Wonderful Life’, CHRISTMAS KARMA is a festive British classic for our times, and for generations to come, that promotes a strong message to be kind, choose love and celebrate the present.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/368195_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/368195_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/19/19/1919249e75842a78410a24a42e64bc8f.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":null,\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Christmas Karma\",\"synopsis\":\"Told from Chadha’s unique point of view and in her own distinctive style, the film resonates with Dickens’ masterful statement on the human condition, exploring themes of prejudice, acceptance, reconciliation, identity and belonging. Inspired by Frank Capra’s timeless ‘It’s A Wonderful Life’, CHRISTMAS KARMA is a festive British classic for our times, and for generations to come, that promotes a strong message to be kind, choose love and celebrate the present.\",\"certificate\":\"PG\",\"casting\":[\"Kunal Nayyar\",\"Eva Longoria\",\"Billy Porter\",\"Boy George\",\"Charithra Chandran\",\"Hugh Bonneville\",\"Leo Suter\",\"Pixie Lott\",\"Danny Dyer\"],\"direction\":[\"Gurinder Chadha\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/32/52/3252111e44bf37928102f123c4976186.jpg\",\"https://all.web.img.acsta.net/img/44/13/44135b6fa12dc0c281b3dd07c0132c62.jpg\",\"https://all.web.img.acsta.net/img/59/78/5978181e194b4505e58e5da09a0bec86.jpg\",\"https://all.web.img.acsta.net/img/c5/2e/c52e3d45958c088329330c58d7fed94b.jpg\"],\"heroImages\":[],\"release\":\"2025-11-14T00:00:00.000Z\",\"advisory\":\"mild violence, discrimination, language\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/368195_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/368195_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"True Brit Entertainment Ltd.\"}},{\"id\":\"1000028403\",\"title\":\"Deeper Into Movies: Ken Loach and Mike Leigh in Conversation\",\"runtime\":null,\"genres\":\"\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8797cfc3bee2f5776664b0e95d8fbdfa.jpg\",\"__typename\":\"Movie\",\"altId\":[\"397404\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"directors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"releases\":[{\"releasedAt\":\"2025-08-27T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Deeper Into Movies: A Passage Into England + Live Q&A\",\"synopsis\":\"Across decades, both directors have carved out uncompromising bodies of work rooted in working-class life — capturing the quiet dignity, frustrations, humour, and resilience of everyday people with rare authenticity. Whether through Leigh’s improvisational, actor-led explorations of character or Loach’s fierce political clarity and social realism, their films have shaped how we understand Britain on screen. This conversation offers a chance to witness two visionary directors reflect on their parallel careers and longstanding friendship.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Deeper Into Movies: Ken Loach and Mike Leigh in Conversation\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8797cfc3bee2f5776664b0e95d8fbdfa.jpg\",\"synopsis\":\"Across decades, both directors (Ken Loach & Mike Leigh) have carved out uncompromising bodies of work rooted in working-class life — capturing the quiet dignity, frustrations, humour, and resilience of everyday people with rare authenticity. Whether through Leigh’s improvisational, actor-led explorations of character or Loach’s fierce political clarity and social realism, their films have shaped how we understand Britain on screen.\\n\\nThis conversation, hosted by Geoff Andrew, offers a chance to witness two visionary directors reflect on their parallel careers and longstanding friendship.\\n\\nAll ticket sales support the cinema charity 'Cinema For All'.\\n\\n5:00pm - Doors open \\n5:30pm - Event begins \\n6:30pm - Event ends \",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/0b0569a588d456a723b4dd2bcb83ecb4.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Deeper Into Movies: A Passage Into England + Live Q&A\",\"synopsis\":\"Across decades, both directors (Ken Loach & Mike Leigh) have carved out uncompromising bodies of work rooted in working-class life — capturing the quiet dignity, frustrations, humour, and resilience of everyday people with rare authenticity. Whether through Leigh’s improvisational, actor-led explorations of character or Loach’s fierce political clarity and social realism, their films have shaped how we understand Britain on screen.\\n\\nThis conversation, hosted by Geoff Andrew, offers a chance to witness two visionary directors reflect on their parallel careers and longstanding friendship.\\n\\nAll ticket sales support the cinema charity 'Cinema For All'.\\n\\n5:00pm - Doors open \\n5:30pm - Event begins \\n6:30pm - Event ends \",\"certificate\":null,\"casting\":[],\"direction\":[],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/0b0569a588d456a723b4dd2bcb83ecb4.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/0b0569a588d456a723b4dd2bcb83ecb4.jpg\"],\"release\":\"2025-08-27T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"1000033714\",\"title\":\"Die Hard (35mm)\",\"runtime\":7920,\"genres\":\"Action\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/f384f42796b0e98ec6045ab146e55a2c.jpg\",\"__typename\":\"Movie\",\"altId\":[\"403799\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"John\",\"lastName\":\"McTiernan\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bruce\",\"lastName\":\"Willis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alan\",\"lastName\":\"Rickman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alexander\",\"lastName\":\"Godunov\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-01T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12435\",\"name\":\"20th Century Studios\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Die Hard (35mm)\",\"synopsis\":\"A New York City cop faces overwhelming odds when his Christmas visit to California is interrupted by a terrorist invasion of his estranged wife's office building\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/b9/d9/b9d978d3080dc7da9299b45fc82278ea.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/f384f42796b0e98ec6045ab146e55a2c.jpg\",\"synopsis\":\"New York City policeman John McClane (Bruce Willis) is visiting his estranged wife (Bonnie Bedelia) and two daughters on Christmas Eve. He joins her at a holiday party in the headquarters of the Japanese-owned business she works for. But the festivities are interrupted by a group of terrorists who take over the exclusive high-rise, and everyone in it. Very soon, McClane realises that there's no one to save the hostages -- but him.\\n\\nScreening in stunning 35mm at Christmas on the Green this winter.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Die Hard (35mm)\",\"synopsis\":\"New York City policeman John McClane (Bruce Willis) is visiting his estranged wife (Bonnie Bedelia) and two daughters on Christmas Eve. He joins her at a holiday party in the headquarters of the Japanese-owned business she works for. But the festivities are interrupted by a group of terrorists who take over the exclusive high-rise, and everyone in it. Very soon, McClane realises that there's no one to save the hostages -- but him.\\n\\nScreening in stunning 35mm at Christmas on the Green this winter.\",\"certificate\":\"15\",\"casting\":[\"Bruce Willis\",\"Alan Rickman\",\"Alexander Godunov\"],\"direction\":[\"John McTiernan\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-12-01T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"20th Century Studios\"}},{\"id\":\"310017\",\"title\":\"Die My Love\",\"runtime\":7080,\"genres\":\"Drama, Thriller, Comedy\",\"__typename\":\"Movie\",\"altId\":[\"361144\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"poster\":\"https://cms-assets.webediamovies.pro/production/279/85af2191b2e5307fb4707e9cfc9c09b9.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/b7/6a/b76a88058ca34d6d702d5dffc1bfd8d6.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/04/50/0450bdf4997c9db3b80a9439933c1f4a.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/65/a1/65a112a61512f0c8e81eebf6c2c54279.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/53/f8/53f86a59e2423816aa9b10662f55d0c8.jpg\",\"__typename\":\"Image\"},