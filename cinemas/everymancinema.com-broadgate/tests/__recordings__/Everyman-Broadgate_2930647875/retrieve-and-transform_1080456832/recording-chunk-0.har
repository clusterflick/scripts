":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Frantz\",\"lastName\":\"Confiac\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Emmanuel\",\"lastName\":\"Garijo\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Nicolas\",\"lastName\":\"Marié\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Stéphane\",\"lastName\":\"Ronchewski\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Sébastien\",\"lastName\":\"Desjours\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2025-10-24T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"33240\",\"name\":\"Altitude Films\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild threat, violence\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Pets on a Train\",\"synopsis\":\"When a train unexpectedly takes off carrying only pets, the animals discover that Hans, a badger with a grudge, is behind it all. While the crash seems inevitable, the animals can count on Falcon, a roguish raccoon who will do anything to save them.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/366031_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/366031_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/a4/42/a4427d476a4c88ae28c2125b3feaaa17.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ac6a8498beb46430b5b25d26c3ec47a9.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/65febed82689fb4cab32fb1c47d43df7.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Falcon Express\",\"synopsis\":\"When a train unexpectedly takes off carrying only pets, the animals discover that Hans, a badger with a grudge, is behind it all. While the crash seems inevitable, the animals can count on Falcon, a roguish raccoon who will do anything to save them.\",\"certificate\":\"PG\",\"casting\":[\"Damien Ferrette\",\"Herve Jolly\",\"Kaycie Chase\",\"Frantz Confiac\",\"Emmanuel Garijo\",\"Nicolas Marié\",\"Stéphane Ronchewski\",\"Sébastien Desjours\"],\"direction\":[\"Benoît Daffis\",\"Jean-Christian Tassy\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/65febed82689fb4cab32fb1c47d43df7.jpg\",\"https://all.web.img.acsta.net/img/b8/09/b809bf1aac34c4a4fd89a84ec1c922ab.jpg\",\"https://all.web.img.acsta.net/img/41/e7/41e7f3b303587c86b6c7a272d864129e.jpg\",\"https://all.web.img.acsta.net/img/6b/36/6b3623d413167424345084002596046a.jpg\",\"https://all.web.img.acsta.net/img/dd/69/dd6912f7a4bf41ac392d720aafa8686b.jpg\",\"https://all.web.img.acsta.net/img/81/c9/81c938d49ac40666eb15d155789ae432.jpg\",\"https://all.web.img.acsta.net/img/a7/63/a7636d3fcc7b24fc633a3a726ca5c666.jpg\",\"https://all.web.img.acsta.net/img/d5/6e/d56eb67bf238f79c1dc2579d70381fd7.jpg\",\"https://all.web.img.acsta.net/img/0d/03/0d037c26e8cd4ec3077b660dbd32bd97.jpg\",\"https://all.web.img.acsta.net/img/ae/b6/aeb613e62bf88f451bb7a95c8ed5bf2e.jpg\",\"https://all.web.img.acsta.net/img/27/bd/27bd48b78d1648dea5d08cff1d30dd06.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/65febed82689fb4cab32fb1c47d43df7.jpg\"],\"release\":\"2025-10-24T00:00:00.000Z\",\"advisory\":\"mild threat, violence\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/366031_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/366031_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Altitude Films\"}},{\"id\":\"326652\",\"title\":\"Predator: Badlands\",\"runtime\":6420,\"genres\":\"Science fiction, Action, Horror\",\"__typename\":\"Movie\",\"altId\":[\"365319\",\"393821\",\"402724\",\"402725\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/adba2357f581a93f2348f08a3bf4b8a9.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/ea/a9/eaa9b3377948a2339c7a447710bd01bd.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/90/c7/90c78c98029a815378a77945c5bfcdc6.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/bb/69/bb69c478c4004af432ac015d22af7ebd.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/dc/48/dc4852a080892ec7d302bb2299fe4112.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c6/c4/c6c4b6dba7cefdef773404d426e1990b.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/56/f0/56f089fb54987fdbcd8a17b4fe8dfecf.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/2d/ef/2deff9d6cb4b6d66523f854f097cf6fe.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e5/b9/e5b996d90a460e9b8b860ca605376bcf.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/3b/1f/3b1fa240e724debd8b29a92cb07060a8.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/e9/21/e921981b1cd2255226156c7cbda26874.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Dan\",\"lastName\":\"Trachtenberg\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elle\",\"lastName\":\"Fanning\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dimitrius\",\"lastName\":\"Schuster-Koloamatangi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Homick\",\"__typename\":\"Person\"},\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Stefan\",\"lastName\":\"Grube\",\"__typename\":\"Person\"}},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Rohinal\",\"lastName\":\"Nayaran\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Reuben\",\"lastName\":\"de Jong\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cameron\",\"lastName\":\"Brown\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Alison\",\"lastName\":\"Wright\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Matt\",\"lastName\":\"Duffer\",\"__typename\":\"Person\"}},{\"actor\":null,\"__typename\":\"MovieCredit\",\"localizedVoiceActor\":null,\"originalVoiceActor\":{\"firstName\":\"Ross\",\"lastName\":\"Duffer\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2025-11-07T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"moderate violence, threat, injury detail\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Predator: Badlands\",\"synopsis\":\"20th Century Studios’ “Predator: Badlands,” directed by Dan Trachtenberg (“Prey”), opens exclusively in theaters November 7, 2025. The newest entry in the “Predator” franchise is set in the future on a remote planet, where a young Predator, outcast from his clan, finds an unlikely ally in Thia (Elle Fanning) and embarks on a treacherous journey in search of the ultimate adversary.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/365319_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/365319_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/87/dd/87dde27e0d6ac569847f53e1f0049cc8.jpeg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/7f88a508344129df0986979671c62783.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/adba2357f581a93f2348f08a3bf4b8a9.jpg\",\"synopsis\":\"It’s the future, and Elle Fanning (A Complete Unknown, The Neon Demon) is Thia, a legless synth created by the corrupt mega corporation Weyland-Yutani. Recently rebooted, she’s once again roaming her remote planet; the most dangerous planet in the universe, to be precise. \\n\\nYoung predator, Dek, finds himself traversing the same treacherous terrain. Outcast from his clan for being a runt, he’s hunting for the planet’s definitive and virtually unkillable apex predator. Thia can help him on his quest, but this isn’t a journey they’re making alone. On this planet, even the predators are prey.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/1eb0cc037db22fe13ea987523a84647a.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Predator: Badlands\",\"synopsis\":\"It’s the future, and Elle Fanning (A Complete Unknown, The Neon Demon) is Thia, a legless synth created by the corrupt mega corporation Weyland-Yutani. Recently rebooted, she’s once again roaming her remote planet; the most dangerous planet in the universe, to be precise. \\n\\nYoung predator, Dek, finds himself traversing the same treacherous terrain. Outcast from his clan for being a runt, he’s hunting for the planet’s definitive and virtually unkillable apex predator. Thia can help him on his quest, but this isn’t a journey they’re making alone. On this planet, even the predators are prey.\",\"certificate\":\"12A\",\"casting\":[\"Elle Fanning\",\"Dimitrius Schuster-Koloamatangi\",\"Michael Homick\",\"Rohinal Nayaran\",\"Reuben de Jong\",\"Cameron Brown\",\"Alison Wright\",\"Matt Duffer\",\"Ross Duffer\"],\"direction\":[\"Dan Trachtenberg\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/1eb0cc037db22fe13ea987523a84647a.jpg\",\"https://all.web.img.acsta.net/img/ea/a9/eaa9b3377948a2339c7a447710bd01bd.jpg\",\"https://all.web.img.acsta.net/img/90/c7/90c78c98029a815378a77945c5bfcdc6.jpg\",\"https://all.web.img.acsta.net/img/bb/69/bb69c478c4004af432ac015d22af7ebd.jpg\",\"https://all.web.img.acsta.net/img/dc/48/dc4852a080892ec7d302bb2299fe4112.jpg\",\"https://all.web.img.acsta.net/img/c6/c4/c6c4b6dba7cefdef773404d426e1990b.jpg\",\"https://all.web.img.acsta.net/img/56/f0/56f089fb54987fdbcd8a17b4fe8dfecf.jpg\",\"https://all.web.img.acsta.net/img/2d/ef/2deff9d6cb4b6d66523f854f097cf6fe.jpg\",\"https://all.web.img.acsta.net/img/e5/b9/e5b996d90a460e9b8b860ca605376bcf.jpg\",\"https://all.web.img.acsta.net/img/3b/1f/3b1fa240e724debd8b29a92cb07060a8.jpg\",\"https://all.web.img.acsta.net/img/e9/21/e921981b1cd2255226156c7cbda26874.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/1eb0cc037db22fe13ea987523a84647a.jpg\",\"https://cms-assets.webediamovies.pro/production/2/7f88a508344129df0986979671c62783.jpg\"],\"release\":\"2025-11-07T00:00:00.000Z\",\"advisory\":\"moderate violence, threat, injury detail\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/365319_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/365319_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Walt Disney\"}},{\"id\":\"1000033477\",\"title\":\"Preview: National Theatre Live: The Fifth Step\",\"runtime\":6000,\"genres\":\"Musical\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/35d6ff7e4432fa2228061749d3cae01c.jpg\",\"__typename\":\"Movie\",\"altId\":[\"403505\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Finn\",\"lastName\":\"Den Hertog\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jack\",\"lastName\":\"Lowden\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Martin\",\"lastName\":\"Freeman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-18T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"7215\",\"name\":\"National Theatre\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"15\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Preview Screening - National Theatre Live: The Fifth Step\",\"synopsis\":\"After years in the 12-step programme of Alcoholics Anonymous, James becomes a sponsor to newcomer Luka. The pair bond over black coffee, trade stories and build a fragile friendship out of their shared experiences. But as Luka approaches step five – the moment of confession – dangerous truths emerge, threatening the trust on which both of their recoveries depend.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/41/65/4165f49c62de33dc4985a6b3759c5ed1.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Preview: National Theatre Live: The Fifth Step\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/35d6ff7e4432fa2228061749d3cae01c.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Preview Screening - National Theatre Live: The Fifth Step\",\"synopsis\":\"After years in the 12-step programme of Alcoholics Anonymous, James becomes a sponsor to newcomer Luka. The pair bond over black coffee, trade stories and build a fragile friendship out of their shared experiences. But as Luka approaches step five – the moment of confession – dangerous truths emerge, threatening the trust on which both of their recoveries depend.\",\"certificate\":\"15\",\"casting\":[\"Jack Lowden\",\"Martin Freeman\"],\"direction\":[\"Finn Den Hertog\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-11-18T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"National Theatre\"}},{\"id\":\"1000034059\",\"title\":\"Preview: Wicked: For Good\",\"runtime\":8220,\"genres\":\"Fantasy, Adventure, Musical, Romance\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c329f52e6612b92a0f194bdc44b7da1d.jpg\",\"__typename\":\"Movie\",\"altId\":[\"404190\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jon M.\",\"lastName\":\"Chu\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ariana\",\"lastName\":\"Grande\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Cynthia\",\"lastName\":\"Erivo\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Jonathan\",\"lastName\":\"Bailey\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-20T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"26962\",\"name\":\"Universal Pictures International\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild threat, violence, innuendo, language\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Wicked: For Good - Medicinema preview\",\"synopsis\":\"The final chapter of the untold story of the witches of Oz begins with Elphaba and Glinda estranged and living with the consequences of their choices.\\n\\nElphaba (Cynthia Erivo), now demonized as The Wicked Witch of the West, lives in exile, hidden within the Ozian forest while continuing her fight for the freedom of Oz’s silenced Animals and desperately trying to expose the truth she knows about The Wizard (Jeff Goldblum).\\n\\nGlinda, meanwhile, has become the glamorous symbol of Goodness for all of Oz, living at the palace in Emerald City and reveling in the perks of fame and popularity. Under the instruction of Madame Morrible (Oscar® winner Michelle Yeoh), Glinda is deployed to serve as an effervescent comfort to Oz, reassuring the masses that all is well under the rule of The Wizard.\\n\\nAs Glinda’s stardom expands and she prepares to marry Prince Fiyero (Olivier award winner and Emmy and SAG nominee Jonathan Bailey) in a spectacular Ozian wedding, she is haunted by her separation from Elphaba. She attempts to broker a conciliation between Elphaba and The Wizard, but those efforts will fail, driving Elphaba and Glinda only further apart. The aftershocks will transform Boq (Tony nominee Ethan Slater) and Fiyero forever, and threaten the safety of Elphaba’s sister, Nessarose (Marissa Bode), when a girl from Kansas comes crashing into all their lives.\\n\\nAs an angry mob rises against the Wicked Witch, Glinda and Elphaba will need to come together one final time. With their singular friendship now the fulcrum of their futures, they will need to truly see each other, with honesty and empathy, if they are to change themselves, and all of Oz, for good.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/7e/ff/7eff66d3764c7196492f0c8c23106fa0.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/525013bf8568d8b659c9d96b554b2497.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":\"Preview: Wicked: For Good\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c329f52e6612b92a0f194bdc44b7da1d.jpg\",\"synopsis\":\"Join us Thursday, 20 November, for an early charity screening preview of Wicked: For Good in support of MediCinema - a unique charity operating at the heart of NHS hospitals, offering therapeutic cinema experiences to improve the mental, emotional and physical well-being of patients and their loved ones. All the proceeds from the event will be donated to MediCinema.\\n\\nNow demonised as the Wicked Witch of the West, Elphaba lives in exile in the Ozian forest, while Glinda resides at the palace in Emerald City, revelling in the perks of fame and popularity. As an angry mob rises against the Wicked Witch, she'll need to reunite with Glinda to transform herself, and all of Oz, for good.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Wicked: For Good - Medicinema preview\",\"synopsis\":\"Join us Thursday, 20 November, for an early charity screening preview of Wicked: For Good in support of MediCinema - a unique charity operating at the heart of NHS hospitals, offering therapeutic cinema experiences to improve the mental, emotional and physical well-being of patients and their loved ones. All the proceeds from the event will be donated to MediCinema.\\n\\nNow demonised as the Wicked Witch of the West, Elphaba lives in exile in the Ozian forest, while Glinda resides at the palace in Emerald City, revelling in the perks of fame and popularity. As an angry mob rises against the Wicked Witch, she'll need to reunite with Glinda to transform herself, and all of Oz, for good.\",\"certificate\":\"PG\",\"casting\":[\"Ariana Grande\",\"Cynthia Erivo\",\"Jonathan Bailey\"],\"direction\":[\"Jon M. Chu\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/525013bf8568d8b659c9d96b554b2497.jpg\"],\"release\":\"2025-11-20T00:00:00.000Z\",\"advisory\":\"mild threat, violence, innuendo, language\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Universal Pictures International\"}},{\"id\":\"1000022513\",\"title\":\"RBO Cinema Season 2025-26: Cinderella\",\"runtime\":11700,\"genres\":\"Opera\",\"__typename\":\"Movie\",\"altId\":[\"390067\"],\"quadImages\":[],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2cac32d15a8827274a8d5a3db727a5d0.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/40/c7/40c7041378424715c21d8a8cb0a64ce7.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/5d/47/5d47b4ba4580ca97b3560247f7c3696a.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/12/0d/120d8050e160b34379b1facde126a970.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/90/4a/904a103632f53581472252a59eb2cc75.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/4c/9d/4c9d70b31039bc853d5cb23ccfac3925.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/a4/ca/a4ca3c5d043b3208e22c2feacd384fbf.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/dc/a8/dca8d5dfd8afe969a648afc0858a9f22.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Frederick\",\"lastName\":\"Ashton\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Fumi\",\"lastName\":\"Kaneko\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"William\",\"lastName\":\"Bracewell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bennet\",\"lastName\":\"Gartside\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"James\",\"lastName\":\"Hay\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Thomas\",\"lastName\":\"Whitehead\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mayara\",\"lastName\":\"Magri\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Isabella\",\"lastName\":\"Gasparini\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mariko\",\"lastName\":\"Sasaki\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Meaghan\",\"lastName\":\"Grace Hinkis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Claire\",\"lastName\":\"Calvert\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-11-25T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Royal Ballet and Opera: Cinderella\",\"synopsis\":\"Stuck at home and put to work by her spoiled Step-Sisters, Cinderella’s life is dreary and dull. Everything changes when she helps a mysterious woman out... With a little bit of magic, she is transported into an ethereal new world – one where fairies bring the gifts of the seasons, where pumpkins turn into carriages, and where true love awaits.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/50/bf/50bf300cd8d92f7cc0029c350824d38c.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"RBO Cinema Season 2025-26: Cinderella\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2cac32d15a8827274a8d5a3db727a5d0.jpg\",\"synopsis\":\"Stuck at home and put to work by her spoiled Step-Sisters, Cinderella’s life is dreary and dull. Everything changes when she helps a mysterious woman out...With a little bit of magic, she is transported into an ethereal new world – one where fairies bring the gifts of the seasons, where pumpkins turn into carriages, and where true love awaits. \\n\\nThis enchanting ballet by The Royal Ballet’s Founding Choreographer Frederick Ashton is a theatrical experience for all the family and will transport you into an ethereal world where a sprinkling of fairy dust makes dreams come true.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/7e8e55c86c93ac43749f22cc4d9102a9.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Royal Ballet and Opera: Cinderella\",\"synopsis\":\"Stuck at home and put to work by her spoiled Step-Sisters, Cinderella’s life is dreary and dull. Everything changes when she helps a mysterious woman out...With a little bit of magic, she is transported into an ethereal new world – one where fairies bring the gifts of the seasons, where pumpkins turn into carriages, and where true love awaits. \\n\\nThis enchanting ballet by The Royal Ballet’s Founding Choreographer Frederick Ashton is a theatrical experience for all the family and will transport you into an ethereal world where a sprinkling of fairy dust makes dreams come true.\",\"certificate\":\"12A\",\"casting\":[\"Fumi Kaneko\",\"William Bracewell\",\"Bennet Gartside\",\"James Hay\",\"Thomas Whitehead\",\"Mayara Magri\",\"Isabella Gasparini\",\"Mariko Sasaki\",\"Meaghan Grace Hinkis\",\"Claire Calvert\"],\"direction\":[\"Frederick Ashton\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/7e8e55c86c93ac43749f22cc4d9102a9.jpg\",\"https://all.web.img.acsta.net/img/40/c7/40c7041378424715c21d8a8cb0a64ce7.jpg\",\"https://all.web.img.acsta.net/img/5d/47/5d47b4ba4580ca97b3560247f7c3696a.jpg\",\"https://all.web.img.acsta.net/img/12/0d/120d8050e160b34379b1facde126a970.jpg\",\"https://all.web.img.acsta.net/img/90/4a/904a103632f53581472252a59eb2cc75.jpg\",\"https://all.web.img.acsta.net/img/4c/9d/4c9d70b31039bc853d5cb23ccfac3925.jpg\",\"https://all.web.img.acsta.net/img/a4/ca/a4ca3c5d043b3208e22c2feacd384fbf.jpg\",\"https://all.web.img.acsta.net/img/dc/a8/dca8d5dfd8afe969a648afc0858a9f22.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/7e8e55c86c93ac43749f22cc4d9102a9.jpg\"],\"release\":\"2025-11-25T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000022520\",\"title\":\"RBO Cinema Season 2025-26: Giselle\",\"runtime\":12600,\"genres\":\"Opera\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c31ec6fcba293a62fce07b331856d656.jpg\",\"__typename\":\"Movie\",\"altId\":[\"390078\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"directors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"releases\":[{\"releasedAt\":\"2026-03-03T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}],\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Royal Ballet and Opera: Giselle\",\"synopsis\":\"The world turns upside down for the peasant girl Giselle when she discovers her lover Albrecht is actually a nobleman promised to another. In despair, she kills herself. Her spirit joins the Wilis, the vengeful ghosts of women who have been jilted and die before their wedding day. The Wilis are hell-bent on killing any man who crosses their path in a dance to the death. Wracked with guilt, Albrecht visits Giselle’s grave, where he must face the Wilis – and Giselle’s ghost. Will he survive?\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/20/f4/20f477daca13345ce6ebf0baff0a9b74.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"RBO Cinema Season 2025-26: Giselle\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/c31ec6fcba293a62fce07b331856d656.jpg\",\"synopsis\":\"The peasant girl Giselle has fallen in love with Albrecht. When she discovers that he is actually a nobleman promised to another, she kills herself in despair. Her spirit joins the Wilis: the vengeful ghosts of women hell-bent on killing any man who crosses their path in a dance to the death. Wracked with guilt, Albrecht visits Giselle’s grave, where he must face the Wilis – and Giselle’s ghost. \\n\\nPeter Wright’s 1985 production of this quintessential Romantic ballet is a classic of The Royal Ballet repertory. Set to Adolphe Adam’s evocative score and with atmospheric designs by John Macfarlane, Giselle conjures up the earthly and otherworldly realms in a tale of love, betrayal and redemption.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/a636ce755e4fff88f833d412bc653308.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Royal Ballet and Opera: Giselle\",\"synopsis\":\"The peasant girl Giselle has fallen in love with Albrecht. When she discovers that he is actually a nobleman promised to another, she kills herself in despair. Her spirit joins the Wilis: the vengeful ghosts of women hell-bent on killing any man who crosses their path in a dance to the death. Wracked with guilt, Albrecht visits Giselle’s grave, where he must face the Wilis – and Giselle’s ghost. \\n\\nPeter Wright’s 1985 production of this quintessential Romantic ballet is a classic of The Royal Ballet repertory. Set to Adolphe Adam’s evocative score and with atmospheric designs by John Macfarlane, Giselle conjures up the earthly and otherworldly realms in a tale of love, betrayal and redemption.\",\"certificate\":null,\"casting\":[],\"direction\":[],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/a636ce755e4fff88f833d412bc653308.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/a636ce755e4fff88f833d412bc653308.jpg\"],\"release\":\"2026-03-03T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000022518\",\"title\":\"RBO Cinema Season 2025-26: La Traviata\",\"runtime\":14400,\"genres\":\"Opera\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2cc10a0cc2b8ddb28a1b619eb9698eec.jpg\",\"__typename\":\"Movie\",\"altId\":[\"390073\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Richard\",\"lastName\":\"Eyre\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ermonela\",\"lastName\":\"Jaho\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Giovanni\",\"lastName\":\"Sala\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Antonello\",\"lastName\":\"Manacorda\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Aleksei\",\"lastName\":\"Isaev\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Veena\",\"lastName\":\"Akama-Makia\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-01-14T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}],\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Royal Ballet and Opera: La Traviata\",\"synopsis\":\"A moving story about a woman in love that features one of opera’s most famous melodies (the ‘Brindisi’ chorus), La traviata is perfect for first-timers and a favourite among regular opera-goers. Antonello Manacorda conducts a cast headlined by soprano Ermonela Jaho. In director Richard Eyre’s world of seductive grandeur, the tender and devastating beauty at the centre of Verdi’s opera shines bright.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/02/43/024351f861c3df363dbf576c900dd742.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"RBO Cinema Season 2025-26: La Traviata\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/2cc10a0cc2b8ddb28a1b619eb9698eec.jpg\",\"synopsis\":\"At one of her lavish parties, celebrated Parisan courtesan Violetta is introduced to Alfredo Germont. The two fall madly in love, and though hesitant to leave behind her life of luxury and freedom, Violetta follows her heart. But the young couple’s happiness is short-lived, as the harsh realities of life soon come knocking.\\n\\nAs intimate as it is sumptuous, La traviata features some of opera’s most famous melodies, and is a star vehicle for its leading soprano role sung by Ermonela Jaho. In director Richard Eyre’s world of seductive grandeur, the tender and devastating beauty at the centre of Verdi’s opera shines bright.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/6b0e9d6243a48af9639a85e4075c18cd.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Royal Ballet and Opera: La Traviata\",\"synopsis\":\"At one of her lavish parties, celebrated Parisan courtesan Violetta is introduced to Alfredo Germont. The two fall madly in love, and though hesitant to leave behind her life of luxury and freedom, Violetta follows her heart. But the young couple’s happiness is short-lived, as the harsh realities of life soon come knocking.\\n\\nAs intimate as it is sumptuous, La traviata features some of opera’s most famous melodies, and is a star vehicle for its leading soprano role sung by Ermonela Jaho. In director Richard Eyre’s world of seductive grandeur, the tender and devastating beauty at the centre of Verdi’s opera shines bright.\",\"certificate\":null,\"casting\":[\"Ermonela Jaho\",\"Giovanni Sala\",\"Antonello Manacorda\",\"Aleksei Isaev\",\"Veena Akama-Makia\"],\"direction\":[\"Richard Eyre\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/6b0e9d6243a48af9639a85e4075c18cd.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/6b0e9d6243a48af9639a85e4075c18cd.jpg\"],\"release\":\"2026-01-14T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000022521\",\"title\":\"RBO Cinema Season 2025-26: Siegfried\",\"runtime\":19800,\"genres\":\"Opera\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/cc116e25c1ddb2e2a4f0e889ee820d1e.jpg\",\"__typename\":\"Movie\",\"altId\":[\"390081\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Barrie\",\"lastName\":\"Kosky\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Andreas\",\"lastName\":\"Schager\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Peter\",\"lastName\":\"Hoare\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christopher\",\"lastName\":\"Maltman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Elisabet\",\"lastName\":\"Strid\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Christopher\",\"lastName\":\"Purves\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Soloman\",\"lastName\":\"Howard\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-03-31T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}],\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Royal Ballet and Opera: Siegfried\",\"synopsis\":\"Andreas Schager, in his much-anticipated debut with The Royal Opera, stars as Siegfried’s titular hero, alongside Christopher Maltman’s towering Wanderer, Peter Hoare’s treacherous Mime and Elisabet Strid’s radiant Brünnhilde. Antonio Pappano conducts, drawing out the unspoken tensions and ethereal mysticism of Wagner’s dynamic score.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/96/a4/96a4c51bc6b0f56d310cef1eda00f328.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"RBO Cinema Season 2025-26: Siegfried\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/cc116e25c1ddb2e2a4f0e889ee820d1e.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/44dd66d4e4c8cff7b75a8cfe2139c241.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Royal Ballet and Opera: Siegfried\",\"synopsis\":\"Andreas Schager, in his much-anticipated debut with The Royal Opera, stars as Siegfried’s titular hero, alongside Christopher Maltman’s towering Wanderer, Peter Hoare’s treacherous Mime and Elisabet Strid’s radiant Brünnhilde. Antonio Pappano conducts, drawing out the unspoken tensions and ethereal mysticism of Wagner’s dynamic score.\",\"certificate\":null,\"casting\":[\"Andreas Schager\",\"Peter Hoare\",\"Christopher Maltman\",\"Elisabet Strid\",\"Christopher Purves\",\"Soloman Howard\"],\"direction\":[\"Barrie Kosky\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/44dd66d4e4c8cff7b75a8cfe2139c241.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/44dd66d4e4c8cff7b75a8cfe2139c241.jpg\"],\"release\":\"2026-03-31T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000022522\",\"title\":\"RBO Cinema Season 2025-26: The Magic Flute\",\"runtime\":12600,\"genres\":\"Opera\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/438988d4479fed858ad4649301c84135.jpg\",\"__typename\":\"Movie\",\"altId\":[\"390082\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"David\",\"lastName\":\"McVicar\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Julia\",\"lastName\":\"Bullock\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Amitai\",\"lastName\":\"PATI\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Huw\",\"lastName\":\"Montague Rendall\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-04-21T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}],\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Royal Ballet and Opera: The Magic Flute\",\"synopsis\":\"A fantastical opera for all the family \\n\\nPrincess Pamina has been captured. Her mother, the Queen of the Night, tasks the young Prince Tamino with her daughter’s rescue. But when Tamino and his friendly sidekick, Papageno, embark on their adventure, they soon learn that when it comes to the quest for love, nothing is as it really seems. Guided by a magic flute, they encounter monsters, villains, and a mysterious brotherhood of men – but help, it turns out, comes when you least expect it. \\n\\nWith the Queen of the Night’s showstopping arias, an Overture that fizzes with energy, Papageno’s catchy tunes and sublime melodies for Pamina and Tamino, the music of The Magic Flute leaves no heart uncharmed. Two starry casts include Julia Bullock and Lucy Crowe as Pamina, Amitai Pati and Mingjie Lei as Tamino, Huw Montague Rendall as Papageno, Kathryn Lewek and Annie Fassea as the Queen of the Night and Soloman Howard and Timo Riihonen as Sarastro, led by French conductor Marie Jacquot in her Covent Garden debut, and Finnegan Downie Dear.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/18/ab/18ab8fd72dcc7d001da4e1019406b724.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"RBO Cinema Season 2025-26: The Magic Flute\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/438988d4479fed858ad4649301c84135.jpg\",\"synopsis\":\"A fantastical opera for all the family \\n\\nPrincess Pamina has been captured. Her mother, the Queen of the Night, tasks the young Prince Tamino with her daughter’s rescue. But when Tamino and his friendly sidekick, Papageno, embark on their adventure, they soon learn that when it comes to the quest for love, nothing is as it really seems. Guided by a magic flute, they encounter monsters, villains, and a mysterious brotherhood of men – but help, it turns out, comes when you least expect it. \\n\\nWith the Queen of the Night’s showstopping arias, an Overture that fizzes with energy, Papageno’s catchy tunes, and sublime melodies for Pamina and Tamino, the music of The Magic Flute leaves no heart uncharmed. Two starry casts include Julia Bullock and Lucy Crowe as Pamina, Amitai Pati and Mingjie Lei as Tamino, Huw Montague Rendall as Papageno, Kathryn Lewek and Annie Fassea as the Queen of the Night and Soloman Howard and Timo Riihonen as Sarastro, led by French conductor Marie Jacquot in her Covent Garden debut, and Finnegan Downie Dear.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/42e97987d1e1fcd5f19d2d9a7f33cb8b.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Royal Ballet and Opera: The Magic Flute\",\"synopsis\":\"A fantastical opera for all the family \\n\\nPrincess Pamina has been captured. Her mother, the Queen of the Night, tasks the young Prince Tamino with her daughter’s rescue. But when Tamino and his friendly sidekick, Papageno, embark on their adventure, they soon learn that when it comes to the quest for love, nothing is as it really seems. Guided by a magic flute, they encounter monsters, villains, and a mysterious brotherhood of men – but help, it turns out, comes when you least expect it. \\n\\nWith the Queen of the Night’s showstopping arias, an Overture that fizzes with energy, Papageno’s catchy tunes, and sublime melodies for Pamina and Tamino, the music of The Magic Flute leaves no heart uncharmed. Two starry casts include Julia Bullock and Lucy Crowe as Pamina, Amitai Pati and Mingjie Lei as Tamino, Huw Montague Rendall as Papageno, Kathryn Lewek and Annie Fassea as the Queen of the Night and Soloman Howard and Timo Riihonen as Sarastro, led by French conductor Marie Jacquot in her Covent Garden debut, and Finnegan Downie Dear.\",\"certificate\":null,\"casting\":[\"Julia Bullock\",\"Amitai PATI\",\"Huw Montague Rendall\"],\"direction\":[\"David McVicar\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/42e97987d1e1fcd5f19d2d9a7f33cb8b.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/42e97987d1e1fcd5f19d2d9a7f33cb8b.jpg\"],\"release\":\"2026-04-21T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000022517\",\"title\":\"RBO Cinema Season 2025-26: The Nutcracker\",\"runtime\":12600,\"genres\":\"Opera\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/5823b05d5775e2889c88ab8131e0db0d.jpg\",\"__typename\":\"Movie\",\"altId\":[\"390072\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Peter\",\"lastName\":\"Wright\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mayara\",\"lastName\":\"Magri\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Reece\",\"lastName\":\"Clarke\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marianna\",\"lastName\":\"Tsembenhoi\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Liam\",\"lastName\":\"Boswell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gary\",\"lastName\":\"Avis\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-10T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Royal Ballet and Opera: The Nutcracker\",\"synopsis\":\"Peter Wright's production of The Nutcracker has been enchanting children and adults alike since its first performance by The Royal Ballet in 1984. Julia Trevelyan Oman’s designs bring the story wonderfully to life, from the 19th century German home of the Stalbaums – which features a Christmas tree that transforms beyond one’s imagination – to the Kingdom of Sweets, where everything is sugar and sparkle.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/53/f6/53f6e13bfaf104081921cd1e221ccc1e.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/2775b85fd912fd456e249e0c62ce1269.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":\"RBO Cinema Season 2025-26: The Nutcracker\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/5823b05d5775e2889c88ab8131e0db0d.jpg\",\"synopsis\":\"The magician Herr Drosselmeyer needs to save his nephew. Hans-Peter has been transformed into a Nutcracker; the only way to save him is for the Nutcracker to defeat the Mouse King and find a girl to love and care for him. A flicker of hope comes in the form of the young Clara, whom Drosselmeyer meets at a Christmas party. With some magic, a cosy Christmas gathering turns into a marvellous adventure. \\n\\nPeter Wright’s The Nutcracker has enchanted audiences since its 1984 premiere by the Company. Featuring Tchaikovsky’s most familiar melodies and brought to life by Julia Trevelyan Oman’s exquisite designs, The Nutcracker is sure to be a festive firecracker for all ages.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/cc5c4998a7dc6a9ac9146bbaccaa7676.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Royal Ballet and Opera: The Nutcracker\",\"synopsis\":\"The magician Herr Drosselmeyer needs to save his nephew. Hans-Peter has been transformed into a Nutcracker; the only way to save him is for the Nutcracker to defeat the Mouse King and find a girl to love and care for him. A flicker of hope comes in the form of the young Clara, whom Drosselmeyer meets at a Christmas party. With some magic, a cosy Christmas gathering turns into a marvellous adventure. \\n\\nPeter Wright’s The Nutcracker has enchanted audiences since its 1984 premiere by the Company. Featuring Tchaikovsky’s most familiar melodies and brought to life by Julia Trevelyan Oman’s exquisite designs, The Nutcracker is sure to be a festive firecracker for all ages.\",\"certificate\":\"12A\",\"casting\":[\"Mayara Magri\",\"Reece Clarke\",\"Marianna Tsembenhoi\",\"Liam Boswell\",\"Gary Avis\"],\"direction\":[\"Peter Wright\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/cc5c4998a7dc6a9ac9146bbaccaa7676.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/cc5c4998a7dc6a9ac9146bbaccaa7676.jpg\",\"https://cms-assets.webediamovies.pro/production/2/2775b85fd912fd456e249e0c62ce1269.jpg\"],\"release\":\"2025-12-10T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000022519\",\"title\":\"RBO Cinema Season 2025-26: Woolf Works\",\"runtime\":12600,\"genres\":\"Opera\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/d5bc30916696a4e51b6d4df14d0d5462.jpg\",\"__typename\":\"Movie\",\"altId\":[\"390074\"],\"cast\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Wayne\",\"lastName\":\"McGregor\",\"__typename\":\"Person\"}}]},\"releases\":[{\"releasedAt\":\"2026-02-09T00:00:00.000Z\",\"__typename\":\"Release\",\"rating\":{\"advisory\":null,\"__typename\":\"Rating\",\"certificate\":null},\"distributors\":[{\"id\":\"39223\",\"name\":\"Trafalgar Releasing\",\"__typename\":\"Company\"}],\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Royal Ballet and Opera: Woolf Works\",\"synopsis\":\"I now, I then (from Mrs Dalloway)  \\n\\nMrs Dalloway, Woolf’s 1925 stream of consciousness novel, is set over the course of one day and alternates between two stories: a society hostess preparing for an important party and a shell-shocked war veteran on his way to a psychiatric assessment. Though they never meet, both Clarissa, the protected insider and Septimus, the social outcast, are haunted by the past. Opening with an excerpt from Woolf’s recorded essay, On Craftsmanship, I now I then is a journey into the writing of Mrs Dalloway, interweaving narrative fragments from the novel with aspects of Woolf’s autobiography including the experience of drawing on her own mental illness as subject matter. \\n\\nBecomings (from Orlando) \\n\\n‘on or about December 1910 human nature changed’ – Virginia Woolf  \\n\\nWritten in an epoch of recalibration in every sphere including the roles and rights of women, modes of representation in art and literature, and rapid advances in cosmology, Woolf’s iconoclastic 1928 novel Orlando centres around a fantastical figure who journeys through three hundred years without growing old, and changes sex along the way. Relationships prove transient, even with himself, while relativity and plasticity define her experience of time and space. Becomings presents Orlando’s dizzying wide-angle vision of a vast, ever-altering universe in which life is energy passing through a multiplicity of forms – a brief, gorgeous flaring of insect wings, gestating, emerging, extinguishing and moving on. \\n\\nTuesday (from The Waves) \\n\\nGrand and elegiac, The Waves (1931) is Woolf’s most experimental novel, conceived in response to her own childlessness and the contrasting fierce maternity of her sister Vanessa. In the novel, the voices of six people growing from childhood to old age are punctuated by symbols of natural decay and renewal, the most important of which is the ever-returning sea. Responding to Woolf’s unique fascination with underwater imagery in all her writing, Tuesday merges themes of The Waves with a portrayal of the writer’s suicide by drowning. As Woolf counts her steps towards the river Ouse and her final journey, so too the world of her novel moves towards abstraction and silence.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/53/ac/53ac6751a126945ed298f4bf73658165.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"RBO Cinema Season 2025-26: Woolf Works\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/d5bc30916696a4e51b6d4df14d0d5462.jpg\",\"synopsis\":\"Virginia Woolf defied literary conventions to depict rich inner worlds – her heightened, startling and poignant reality. Resident Choreographer Wayne McGregor leads a luminous artistic team to evoke Woolf’s signature stream of consciousness writing style in this immense work that rejects traditional narrative structures. \\n\\nWoolf Works is a collage of themes from Mrs Dalloway, Orlando, The Waves and Woolf’s other writings. Created in 2015 for The Royal Ballet, this Olivier-award winning ballet triptych captures the heart of Woolf’s uniquely artistic spirit.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/162aa706edb9057771bcc9000957a30e.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Royal Ballet and Opera: Woolf Works\",\"synopsis\":\"Virginia Woolf defied literary conventions to depict rich inner worlds – her heightened, startling and poignant reality. Resident Choreographer Wayne McGregor leads a luminous artistic team to evoke Woolf’s signature stream of consciousness writing style in this immense work that rejects traditional narrative structures. \\n\\nWoolf Works is a collage of themes from Mrs Dalloway, Orlando, The Waves and Woolf’s other writings. Created in 2015 for The Royal Ballet, this Olivier-award winning ballet triptych captures the heart of Woolf’s uniquely artistic spirit.\",\"certificate\":null,\"casting\":[],\"direction\":[\"Wayne McGregor\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/162aa706edb9057771bcc9000957a30e.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/162aa706edb9057771bcc9000957a30e.jpg\"],\"release\":\"2026-02-09T00:00:00.000Z\",\"advisory\":null,\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Trafalgar Releasing\"}},{\"id\":\"1000009067\",\"title\":\"Regretting You\",\"runtime\":7020,\"genres\":\"Drama, Romance\",\"__typename\":\"Movie\",\"altId\":[\"372064\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8e5914e2f73d3dcc11961db0e70032c8.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/cc/79/cc79a7ec57e4e1d8134b85567a77671c.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/0c/c9/0cc954fb368d5baeed51ff31b5b2e93f.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/d3/8d/d38d7ccdc0d5e0d3d8bcdfd61c59caca.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c1/a3/c1a35a9b01de91a4e749e77e8bf735ba.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/05/b7/05b7920818512f61bf73b8a8f411e3d9.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/03/d6/03d615742a36c4cc8a3aa4781aef7701.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Josh\",\"lastName\":\"Boone\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Allison\",\"lastName\":\"Williams\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mckenna\",\"lastName\":\"Grace\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Dave\",\"lastName\":\"Franco\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mason\",\"lastName\":\"Thames\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Scott\",\"lastName\":\"Eastwood\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Willa\",\"lastName\":\"Fitzgerald\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Sam\",\"lastName\":\"Morelos\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Clancy\",\"lastName\":\"Brown\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ethan Samuel\",\"lastName\":\"Costanilla\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Marcelle\",\"lastName\":\"LeBlanc\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-10-24T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"13760\",\"name\":\"Paramount Pictures UK\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"infrequent strong language, moderate sex, drug misuse\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Regretting You\",\"synopsis\":\"Based on the bestselling book, REGRETTING YOU introduces audiences to Morgan Grant (Allison Williams) and her daughter Clara (Mckenna Grace) as they explore what’s left behind after a devastating accident reveals a shocking betrayal and forces them to confront family secrets, redefine love, and rediscover each other. REGRETTING YOU is a story of growth, resilience, and self-discovery in the aftermath of tragedy, also starring Dave Franco and Mason Thames with Scott Eastwood and Willa Fitzgerald.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[{\"url\":\"https://m.boxoffice.media/mp4/372064_uk_high.mp4\",\"__typename\":\"MovieVideo\"}],\"hdTrailers\":[{\"url\":\"https://m.boxoffice.media/QuickTime/372064_uk_hd.mov\",\"__typename\":\"MovieVideo\"}],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/0b/ea/0bea72ffb3a207eca1076ce92d7ea708.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/fa9972ffbfee4b25321c48bd358aad1f.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/8e5914e2f73d3dcc11961db0e70032c8.jpg\",\"synopsis\":\"Based on the bestselling book, Regretting You introduces audiences to Morgan Grant (Allison Williams) and her daughter Clara (Mckenna Grace) as they explore what’s left behind after a devastating accident reveals a shocking betrayal and forces them to confront family secrets, redefine love, and rediscover each other. #\\n\\nRegretting You is a story of growth, resilience, and self-discovery in the aftermath of tragedy, also starring Dave Franco and Mason Thames with Scott Eastwood and Willa Fitzgerald.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"Regretting You\",\"synopsis\":\"Based on the bestselling book, Regretting You introduces audiences to Morgan Grant (Allison Williams) and her daughter Clara (Mckenna Grace) as they explore what’s left behind after a devastating accident reveals a shocking betrayal and forces them to confront family secrets, redefine love, and rediscover each other. #\\n\\nRegretting You is a story of growth, resilience, and self-discovery in the aftermath of tragedy, also starring Dave Franco and Mason Thames with Scott Eastwood and Willa Fitzgerald.\",\"certificate\":\"12A\",\"casting\":[\"Allison Williams\",\"Mckenna Grace\",\"Dave Franco\",\"Mason Thames\",\"Scott Eastwood\",\"Willa Fitzgerald\",\"Sam Morelos\",\"Clancy Brown\",\"Ethan Samuel Costanilla\",\"Marcelle LeBlanc\"],\"direction\":[\"Josh Boone\"],\"coDirection\":[],\"pictures\":[\"https://all.web.img.acsta.net/img/cc/79/cc79a7ec57e4e1d8134b85567a77671c.jpg\",\"https://all.web.img.acsta.net/img/0c/c9/0cc954fb368d5baeed51ff31b5b2e93f.jpg\",\"https://all.web.img.acsta.net/img/d3/8d/d38d7ccdc0d5e0d3d8bcdfd61c59caca.jpg\",\"https://all.web.img.acsta.net/img/c1/a3/c1a35a9b01de91a4e749e77e8bf735ba.jpg\",\"https://all.web.img.acsta.net/img/05/b7/05b7920818512f61bf73b8a8f411e3d9.jpg\",\"https://all.web.img.acsta.net/img/03/d6/03d615742a36c4cc8a3aa4781aef7701.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/2/fa9972ffbfee4b25321c48bd358aad1f.jpg\"],\"release\":\"2025-10-24T00:00:00.000Z\",\"advisory\":\"infrequent strong language, moderate sex, drug misuse\",\"trailer\":{\"SD\":\"https://m.boxoffice.media/mp4/372064_uk_high.mp4\",\"HD\":\"https://m.boxoffice.media/QuickTime/372064_uk_hd.mov\"},\"localizations\":[],\"studio\":{\"name\":\"Paramount Pictures UK\"}},{\"id\":\"1000035555\",\"title\":\"Relaxed Screening: Elf\",\"runtime\":5820,\"genres\":\"Comedy, Fantasy, Family\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/333faf913c064c4d5f5e237e0fe7437d.jpg\",\"__typename\":\"Movie\",\"altId\":[\"406011\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Jon\",\"lastName\":\"Favreau\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Will\",\"lastName\":\"Ferrell\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"James\",\"lastName\":\"Caan\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Zooey\",\"lastName\":\"Deschanel\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2025-12-14T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"12048\",\"name\":\"Park Circus\",\"__typename\":\"Company\"},{\"id\":\"13759\",\"name\":\"Warner Bros U.K.\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"mild bad language, sex references\",\"__typename\":\"Rating\",\"certificate\":\"PG\"},\"localRatings\":[]}],\"embargoes\":[],\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/333faf913c064c4d5f5e237e0fe7437d.jpg\",\"synopsis\":\"Welcome to Relaxed Screenings – a comfortable and inclusive way to enjoy the magic of the movies in a sensory and autism-friendly environment. Every month, we host a special screening with a reduced volume, dimmed lighting, and no ads or trailers, creating a calm and stress-free setting for neurodiverse guests- including those with autism and sensory sensitivities -and their friends, family, and carers.\\n\\nAs a baby, Buddy crawls into Santa's toy bag and is whisked off to the North Pole, where he is raised as an elf. A misfit who grows to be three times the size of his elf family, Buddy ultimately heads to his birthplace of New York City to seek out his roots. Unfortunately, they turn out to be a \\\"Scrooge\\\"-like father and a cynical ten-year-old stepbrother who doesn't believe in Santa. Worst of all, everyone seems to have forgotten the true meaning of Christmas. But using his simple elf ways, Buddy sets out to single-handedly win over his family and save Christmas in New York, hoping to at last find his true place in the world.\\n\\nElf is rated PG, featuring some sexual innuendo and mild bad language, which may be unsuitable for very young children.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"locale\":{\"title\":\"Relaxed Screening: Elf\",\"synopsis\":\"As a baby, Buddy crawls into Santa's toy bag and is whisked off to the North Pole, where he is raised as an elf. A misfit who grows to be three times the size of his elf family, Buddy ultimately heads to his birthplace of New York City to seek out his roots. Unfortunately, they turn out to be a \\\"Scrooge\\\"-like father and a cynical ten-year-old stepbrother who doesn't believe in Santa. Worst of all, everyone seems to have forgotten the true meaning of Christmas. But using his simple elf ways, Buddy sets out to single-handedly win over his family and save Christmas in New York, hoping to at last find his true place in the world.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/c2/62/c262ba816a5dbf390131d18c9cb646ee.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"originalTitle\":\"Relaxed Screening: Elf\",\"synopsis\":\"Welcome to Relaxed Screenings – a comfortable and inclusive way to enjoy the magic of the movies in a sensory and autism-friendly environment. Every month, we host a special screening with a reduced volume, dimmed lighting, and no ads or trailers, creating a calm and stress-free setting for neurodiverse guests- including those with autism and sensory sensitivities -and their friends, family, and carers.\\n\\nAs a baby, Buddy crawls into Santa's toy bag and is whisked off to the North Pole, where he is raised as an elf. A misfit who grows to be three times the size of his elf family, Buddy ultimately heads to his birthplace of New York City to seek out his roots. Unfortunately, they turn out to be a \\\"Scrooge\\\"-like father and a cynical ten-year-old stepbrother who doesn't believe in Santa. Worst of all, everyone seems to have forgotten the true meaning of Christmas. But using his simple elf ways, Buddy sets out to single-handedly win over his family and save Christmas in New York, hoping to at last find his true place in the world.\\n\\nElf is rated PG, featuring some sexual innuendo and mild bad language, which may be unsuitable for very young children.\",\"certificate\":\"PG\",\"casting\":[\"Will Ferrell\",\"James Caan\",\"Zooey Deschanel\"],\"direction\":[\"Jon Favreau\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"2025-12-14T00:00:00.000Z\",\"advisory\":\"mild bad language, sex references\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Park Circus\"}},{\"id\":\"323925\",\"title\":\"Rental Family\",\"runtime\":6180,\"genres\":\"Comedy, Drama\",\"__typename\":\"Movie\",\"altId\":[\"383271\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/e64bcdcf40582910fb00e88d9b0748e4.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/img/6c/69/6c694be8459fa827c75fb5ac21362db1.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/88/a9/88a993e55af085216bbbdfe08054f2d8.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/60/ab/60ab4afa7763880ff583d2fe243bcec5.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/c7/b5/c7b5eb24947d9bca74d2a543c83f228d.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/d4/f5/d4f5381dd1a3664dabcf395329bb1c78.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/65/5b/655b9507c0fe276e50d83904fc95cd55.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/d1/18/d1186a6f6b212afe5a860708081e8872.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/2e/a4/2ea417f778e9e92efecc8b9c158b996a.jpg\",\"__typename\":\"Image\"},{\"url\":\"https://all.web.img.acsta.net/img/a0/c5/a0c54db4b66c5004eaa3df6c89b68309.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Mitsuyo\",\"lastName\":\"Miyazaki\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Brendan\",\"lastName\":\"Fraser\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mari\",\"lastName\":\"Yamamoto\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Takehiro\",\"lastName\":\"Hira\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Shannon Mahina\",\"lastName\":\"Gorman\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Akira\",\"lastName\":\"Emoto\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Paolo Andrea\",\"lastName\":\"Di Pietro\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Shinji\",\"lastName\":\"Ozeki\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Yuji\",\"lastName\":\"Komatsu\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Ryoko\",\"lastName\":\"Osada\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Gan\",\"lastName\":\"Furukawa\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"2026-01-16T00:00:00.000Z\",\"__typename\":\"Release\",\"distributors\":[{\"id\":\"16219\",\"name\":\"Walt Disney\",\"__typename\":\"Company\"}],\"rating\":{\"advisory\":\"infrequent strong language, moderate sex references\",\"__typename\":\"Rating\",\"certificate\":\"12A\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Rental Family\",\"synopsis\":\"Set against modern-day Tokyo, RENTAL FAMILY follows an American actor (Brendan Fraser) who struggles to find purpose until he lands an unusual gig: working for a Japanese \\\"rental family\\\" agency, playing stand-in roles for strangers. As he immerses himself in his clients' worlds, he begins to form genuine bonds that blur the lines between performance and reality. Confronting the moral complexities of his work, he rediscovers purpose, belonging, and the quiet beauty of human connection.\",\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"poster\":{\"url\":\"https://all.web.img.acsta.net/img/e5/c9/e5c9731fbbf4787d81bdc5b7ca7f3f38.jpg\",\"__typename\":\"Image\"},\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[{\"type\":\"DEFAULT_HERO_IMAGE\",\"url\":\"https://cms-assets.webediamovies.pro/production/2/6c730dd696cb66c5e19b037d8a183baf.jpg\",\"__typename\":\"BOAppImage\"}]}},\"exhibitor\":{\"title\":null,\"poster\":\"https://cms-assets.webediamovies.pro/production/279/e64bcdcf40582910fb00e88d9b0748e4.jpg\",\"synopsis\":\"Struggling to find purpose, an American actor lands an unusual gig with a Japanese agency to play stand-in roles for strangers. As he immerses himself in his clients' worlds, he begins to form genuine bonds that blur the lines between performance and reality. Confronting the moral complexities of his work, he soon rediscovers purpose, belonging, and the quiet beauty of human connection.\",\"__typename\":\"MovieLocalizedOverride\",\"images\":[{\"type\":\"DEFAULT_STILL\",\"url\":\"https://cms-assets.webediamovies.pro/production/279/e362730428785a903463375826af5d97.jpg\",\"__typename\":\"BOAppImage\"}]},\"originalTitle\":\"Rental Family\",\"synopsis\":\"Struggling to find purpose, an American actor lands an unusual gig with a Japanese agency to play stand-in roles for strangers. As he immerses himself in his clients' worlds, he begins to form genuine bonds that blur the lines between performance and reality. Confronting the moral complexities of his work, he soon rediscovers purpose, belonging, and the quiet beauty of human connection.\",\"certificate\":\"12A\",\"casting\":[\"Brendan Fraser\",\"Mari Yamamoto\",\"Takehiro Hira\",\"Shannon Mahina Gorman\",\"Akira Emoto\",\"Paolo Andrea Di Pietro\",\"Shinji Ozeki\",\"Yuji Komatsu\",\"Ryoko Osada\",\"Gan Furukawa\"],\"direction\":[\"Mitsuyo Miyazaki\"],\"coDirection\":[],\"pictures\":[\"https://cms-assets.webediamovies.pro/production/279/e362730428785a903463375826af5d97.jpg\",\"https://all.web.img.acsta.net/img/6c/69/6c694be8459fa827c75fb5ac21362db1.jpg\",\"https://all.web.img.acsta.net/img/88/a9/88a993e55af085216bbbdfe08054f2d8.jpg\",\"https://all.web.img.acsta.net/img/60/ab/60ab4afa7763880ff583d2fe243bcec5.jpg\",\"https://all.web.img.acsta.net/img/c7/b5/c7b5eb24947d9bca74d2a543c83f228d.jpg\",\"https://all.web.img.acsta.net/img/d4/f5/d4f5381dd1a3664dabcf395329bb1c78.jpg\",\"https://all.web.img.acsta.net/img/65/5b/655b9507c0fe276e50d83904fc95cd55.jpg\",\"https://all.web.img.acsta.net/img/d1/18/d1186a6f6b212afe5a860708081e8872.jpg\",\"https://all.web.img.acsta.net/img/2e/a4/2ea417f778e9e92efecc8b9c158b996a.jpg\",\"https://all.web.img.acsta.net/img/a0/c5/a0c54db4b66c5004eaa3df6c89b68309.jpg\"],\"heroImages\":[\"https://cms-assets.webediamovies.pro/production/279/e362730428785a903463375826af5d97.jpg\",\"https://cms-assets.webediamovies.pro/production/2/6c730dd696cb66c5e19b037d8a183baf.jpg\"],\"release\":\"2026-01-16T00:00:00.000Z\",\"advisory\":\"infrequent strong language, moderate sex references\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{\"name\":\"Walt Disney\"}},{\"id\":\"125075\",\"title\":\"Scrooge (1951)\",\"runtime\":5160,\"genres\":\"Drama, Fantasy\",\"__typename\":\"Movie\",\"altId\":[\"57298\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"images\":[],\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ec9107dfeef4ff5b0908c3eeec31b715.jpg\",\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Brian Desmond\",\"lastName\":\"Hurst\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Alastair\",\"lastName\":\"Sim\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Kathleen\",\"lastName\":\"Harrison\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Mervyn\",\"lastName\":\"Johns\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Hermione\",\"lastName\":\"Baddeley\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Michael\",\"lastName\":\"Hordern\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"George\",\"lastName\":\"Cole\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null}]},\"releases\":[{\"releasedAt\":\"1951-10-31T00:00:00.000Z\",\"distributors\":[],\"__typename\":\"Release\",\"rating\":{\"advisory\":\"Contains very mild horror\",\"__typename\":\"Rating\",\"certificate\":\"U\"},\"localRatings\":[]}],\"embargoes\":[],\"locale\":{\"title\":\"Scrooge\",\"synopsis\":\"Alastair Sim's tour-de-force performance as the ultimate miser, Ebenezer Scrooge, has almost single-handedly made this beloved version of Charles Dickens' story into one of the best-loved Christmas films of all time. Some of Britain's best filmmakers united behind Sim, who was joined by a delightful cast of accomplished and acclaimed English actors; creating what many today believe to be the best and most faithful production of Dickens' immortal tale. Cranky and curmudgeonly Scrooge learns the error of his unkind ways and is taught the true meaning of the holidays when he is visited by the ghost of his late business partner and the spirits of Christmas past, present and future.\",\"poster\":null,\"__typename\":\"MovieLocalized\",\"sdTrailers\":[],\"hdTrailers\":[],\"cmsAssets\":{\"__typename\":\"CMSAsset\",\"images\":[]}},\"exhibitor\":{\"title\":\"Scrooge (1951)\",\"poster\":\"https://cms-assets.webediamovies.pro/production/279/ec9107dfeef4ff5b0908c3eeec31b715.jpg\",\"synopsis\":null,\"__typename\":\"MovieLocalizedOverride\",\"images\":[]},\"originalTitle\":\"A Christmas Carol\",\"synopsis\":\"Alastair Sim's tour-de-force performance as the ultimate miser, Ebenezer Scrooge, has almost single-handedly made this beloved version of Charles Dickens' story into one of the best-loved Christmas films of all time. Some of Britain's best filmmakers united behind Sim, who was joined by a delightful cast of accomplished and acclaimed English actors; creating what many today believe to be the best and most faithful production of Dickens' immortal tale. Cranky and curmudgeonly Scrooge learns the error of his unkind ways and is taught the true meaning of the holidays when he is visited by the ghost of his late business partner and the spirits of Christmas past, present and future.\",\"certificate\":\"U\",\"casting\":[\"Alastair Sim\",\"Kathleen Harrison\",\"Mervyn Johns\",\"Hermione Baddeley\",\"Michael Hordern\",\"George Cole\"],\"direction\":[\"Brian Desmond Hurst\"],\"coDirection\":[],\"pictures\":[],\"heroImages\":[],\"release\":\"1951-10-31T00:00:00.000Z\",\"advisory\":\"Contains very mild horror\",\"trailer\":{\"SD\":null,\"HD\":null},\"localizations\":[],\"studio\":{}},{\"id\":\"4357\",\"title\":\"Scrooged\",\"runtime\":6000,\"genres\":\"Comedy\",\"__typename\":\"Movie\",\"altId\":[\"13291\"],\"coDirectors\":{\"nodes\":[],\"__typename\":\"CreditsPager\"},\"quadImages\":[],\"poster\":\"https://cms-assets.webediamovies.pro/production/279/fc7356f6c89edde00e1f3a2da820d10f.jpg\",\"images\":[{\"url\":\"https://all.web.img.acsta.net/medias/nmedia/18/87/05/39/19886251.jpg\",\"__typename\":\"Image\"}],\"directors\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"person\":{\"firstName\":\"Richard\",\"lastName\":\"Donner\",\"__typename\":\"Person\"}}]},\"cast\":{\"__typename\":\"CreditsPager\",\"nodes\":[{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bill\",\"lastName\":\"Murray\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Karen\",\"lastName\":\"Allen\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Forsythe\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Carol\",\"lastName\":\"Kane\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Robert\",\"lastName\":\"Mitchum\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"Bobcat\",\"lastName\":\"Goldthwait\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__typename\":\"MovieCredit\",\"actor\":{\"firstName\":\"John\",\"lastName\":\"Glover\",\"__typename\":\"Person\"},\"originalVoiceActor\":null,\"localizedVoiceActor\":null},{\"__type