            "text": "{\"businessDate\":\"2026-07-29\",\"showtimes\":[{\"id\":\"200-21623\",\"schedule\":{\"businessDate\":\"2026-07-29\",\"startsAt\":\"2026-07-29T17:30:00+01:00\",\"endsAt\":\"2026-07-29T20:15:00+01:00\",\"filmStartsAt\":\"2026-07-29T17:55:00+01:00\",\"filmEndsAt\":\"2026-07-29T20:15:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"200-3-38\",\"filmId\":\"HO00008728\",\"siteId\":\"200\",\"screenId\":\"200-3\",\"areaCategories\":[{\"areaCategoryId\":\"200-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000174\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"200-78-HO00008728\"},{\"id\":\"200-21624\",\"schedule\":{\"businessDate\":\"2026-07-29\",\"startsAt\":\"2026-07-29T20:50:00+01:00\",\"endsAt\":\"2026-07-29T23:35:00+01:00\",\"filmStartsAt\":\"2026-07-29T21:15:00+01:00\",\"filmEndsAt\":\"2026-07-29T23:35:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"200-3-38\",\"filmId\":\"HO00008728\",\"siteId\":\"200\",\"screenId\":\"200-3\",\"areaCategories\":[{\"areaCategoryId\":\"200-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000174\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"200-78-HO00008728\"}],\"relatedData\":{\"sites\":[{\"id\":\"200\",\"name\":{\"text\":\"London Tottenham Court Road\",\"translations\":[]},\"loca