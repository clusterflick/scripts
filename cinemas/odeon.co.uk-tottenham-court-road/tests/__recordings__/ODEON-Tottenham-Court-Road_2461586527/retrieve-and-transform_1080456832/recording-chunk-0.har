\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000065\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"200-19671\",\"schedule\":{\"businessDate\":\"2026-02-14\",\"startsAt\":\"2026-02-14T18:30:00+00:00\",\"endsAt\":\"2026-02-14T19:35:00+00:00\",\"filmStartsAt\":\"2026-02-14T18:35:00+00:00\",\"filmEndsAt\":\"2026-02-14T19:35:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"200-1-30\",\"filmId\":\"HO00008365\",\"siteId\":\"200\",\"screenId\":\"200-1\",\"areaCategories\":[{\"areaCategoryId\":\"200-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000065\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"200-19669\",\"schedule\":{\"businessDate\":\"2026-02-14\",\"startsAt\":\"2026-02-14T20:00:00+00:00\",\"endsAt\":\"2026-02-14T21:05:00+00:00\",\"filmStartsAt\":\"2026-02-14T20:05:00+00:00\",\"filmEndsAt\":\"2026-02-14T21:05:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"200-1-30\",\"filmId\":\"HO00008365\",\"siteId\":\"200\",\"screenId\":\"200-1\",\"areaCategories\":[{\"areaCategoryId\":\"200-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000065\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"200\",\"name\":{\"text\":\"London Tottenham Court Road\",\"translations\":[]},\"location\":{\"latitude\":51.5183,\"longitude\":-0.1324},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.TottenhamCourtRd@OdeonUK.com\",\"address\":{\"line1\":\"Central Cross\",\"line2\":\"30 Tottenham Court Road\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008365\",\"title\":{\"text\":\"ATEEZ VR CONCERT : LIGHT THE WAY\",\"translations\":[]},\"synopsis\":{\"text\":\"One day, a mysterious message arrives for ATEEZ,\\r\\nwho had been spending a peaceful time in their hideout.\\r\\nAt that moment, everything began to change.\\r\\n\\r\\nATINY has vanished…\\r\\nAs if under a spell, ATEEZ wanders through a dreamlike wasteland,\\r\\ninto a collapsing world engulfed in flames, and the Dark City veiled in dense fog.\\r\\nPursued by an unknown force, ATEEZ begins to fight back to find ATINY.\\r\\n\\r\\nExperience an intense immersion where every second counts with INCEPTION, \\r\\nan explosion of freedom and energy in the global hit BOUNCY (K-HOT CHILLI PEPPERS),\\r\\nand the pinnacle of refined charisma with Ice On My Teeth!\\r\\n\\r\\nWith world-class performances,\\r\\nATEEZ, who leads at the forefront of K-pop, unveils their\\r\\nfirst cinematic VR concert, <LIGHT THE WAY>.\\r\\n\\r\\nA story that’s completed only when we’re together.\\r\\nATEEZ now invites you to another dimension, where they await you.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Welcome to the mysterious Dark City, where ATEEZ fights back against an unknown force to rescue ATINY.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-13\",\"runtimeInMinutes\":60,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000052\",\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00008365\",\"hoCode\":\"A000009465\",\"eventId\":\"0000000001\",\"distributorName\":\"AmazeVR, Inc\"}],\"castAndCrew\":[],\"genres\":[{\"id\":\"0000000052\",\"name\":{\"text\":\"Concert\",\"translations\":[]},\"description\":{\"text\":\"Pre-recorded concert\",\"translations\":[]}},{\"id\":\"0000000055\",\"name\":{\"text\":\"Music\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true},{\"id\":\"0000000065\",\"name\":{\"text\":\"Korean (Audio)\",\"translations\":[]},\"shortName\":{\"text\":\"KoreanLang\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":10,\"isPromoted\":false}],\"screens\":[{\"id\":\"200-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000001\",\"name\":{\"text\":\"Event\",\"translations\":[]},\"shortName\":{\"text\":\"Event\",\"translations\":[]},\"description\":null,\"schedule\":{\"startDate\":null,\"endDate\":null},\"siteIds\":[\"017\",\"019\",\"031\",\"033\",\"040\",\"044\",\"050\",\"061\",\"071\",\"072\",\"073\",\"074\",\"075\",\"076\",\"077\",\"078\",\"086\",\"090\",\"124\",\"125\",\"153\",\"155\",\"158\",\"159\",\"200\",\"209\",\"220\",\"244\",\"282\",\"355\",\"380\",\"395\",\"430\",\"440\",\"453\",\"475\",\"484\",\"486\",\"498\",\"500\",\"505\",\"508\",\"510\",\"512\",\"515\",\"522\",\"530\",\"536\",\"546\",\"555\",\"560\",\"568\",\"570\",\"590\",\"593\",\"598\",\"600\",\"615\",