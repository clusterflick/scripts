rk City, where ATEEZ fights back against an unknown force to rescue ATINY.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-13\",\"runtimeInMinutes\":60,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000052\",\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00008365\",\"hoCode\":\"A000009465\",\"eventId\":\"0000000001\",\"distributorName\":\"AmazeVR, Inc\"}],\"castAndCrew\":[],\"genres\":[{\"id\":\"0000000052\",\"name\":{\"text\":\"Concert\",\"translations\":[]},\"description\":{\"text\":\"Pre-recorded concert\",\"translations\":[]}},{\"id\":\"0000000055\",\"name\":{\"text\":\"Music\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true},{\"id\":\"0000000065\",\"name\":{\"text\":\"Korean (Audio)\",\"translations\":[]},\"shortName\":{\"text\":\"KoreanLang\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":10,\"isPromoted\":false}],\"screens\":[{\"id\":\"200-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000001\",\"name\":{\"text\":\"Event\",\"translations\":[]},\"shortName\":{\"text\":\"Event\",\"translations\":[]},\"description\":null,\"schedule\":{\"startDate\":null,\"endDate\":null},\"siteIds\":[\"017\",\"019\",\"031\",\"033\",\"040\",\"044\",\"050\",\"061\",\"071\",\"072\",\"073\",\"074\",\"075\",\"076\",\"077\",\"078\",\"086\",\"090\",\"124\",\"125\",\"153\",\"155\",\"158\",\"159\",\"200\",\"209\