tegories\":[{\"areaCategoryId\":\"200-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000174\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"200-77-HO00008916\"}],\"relatedData\":{\"sites\":[{\"id\":\"200\",\"name\":{\"text\":\"London Tottenham Court Road\",\"translations\":[]},\"location\":{\"latitude\":51.5183,\"longitude\":-0.1324},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"Odeon.TottenhamCourtRd@OdeonUK.com\",\"address\":{\"line1\":\"Central Cross\",\"line2\":\"30 Tottenham Court Road\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008916\",\"title\":{\"text\":\"The Odyssey\",\"translations\":[]},\"synopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. The film brings Homer’s foundational saga to IMAX® film screens for the first time. \\n\\nThe Odyssey stars Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson and Lupita Nyong’o, with Zendaya and Charlize Theron.\\n\\nThe Odyssey is produced by Emma Thomas and Christopher Nolan for their company, Syncopy. The executive producer is Thomas Hayslip.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":173,\"trailerUrl\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000008\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000150\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000155\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000018948\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000018\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000064\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000267\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002248\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b63dbbaf-6c0e-4622-b9b1-698037e6247e\",\"corporateId\":null},\"hopk\":\"HO00008916\",\"hoCode\":\"A000010058\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00009060\",\"title\":{\"text\":\"LE SSERAFIM VR CONCERT: INVITATION\",\"translations\":[]},\"synopsis\":{\"text\":\"The moment the elevator doors open, you’re standing in the same space as “LE SSERAFIM.”\\r\\nJust when you think your eyes have met — they vanish. \\r\\nAll that remains is a single, mysterious ‘Frame Card.’\\r\\nBeyond it, another world begins to unfold.\\r\\n\\r\\nInside a food truck where ingredients are flying through the air, you complete your very own SPAGHETTI, \\r\\nand the moment you Come Over at the crossroads of a city where the murals come alive,\\r\\nyou finally land on a strange planet — facing the burning heart of ANTIFRAGILE at its center.\\r\\n\\r\\nAt the boundary where reality and fantasy intersect, an explosion of non-stop energy!\\r\\nLE SSERAFIM presents a new dimension of VR concert fueled by electrifying energy.\\r\\n\\r\\n〈LE SSERAFIM VR CONCERT : INVITATION〉 Now, we invite you to that world.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The moment the elevator doors open, you’re standing in the same space as “LE SSERAFIM.” Just when you think your eyes have met — they vanish. \",\"translations\