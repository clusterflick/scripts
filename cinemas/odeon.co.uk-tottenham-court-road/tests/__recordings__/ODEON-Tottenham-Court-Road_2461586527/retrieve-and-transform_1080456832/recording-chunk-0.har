            "text": "{\"businessDate\":\"2026-07-17\",\"showtimes\":[{\"id\":\"200-21793\",\"schedule\":{\"businessDate\":\"2026-07-17\",\"startsAt\":\"2026-07-17T10:45:00+01:00\",\"endsAt\":\"2026-07-17T14:03:00+01:00\",\"filmStartsAt\":\"2026-07-17T11:10:00+01:00\",\"filmEndsAt\":\"2026-07-17T14:03:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"200-3-38\",\"filmId\":\"HO00008916\",\"siteId\":\"200\",\"screenId\":\"200-3\",\"areaCategories\":[{\"areaCategoryId\":\"200-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000174\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"200-77-HO00008916\"},{\"id\":\"200-21607\",\"schedule\":{\"businessDate\":\"2026-07-17\",\"startsAt\":\"2026-07-17T11:00:00+01:00\",\"endsAt\":\"2026-07-17T12:00:00+01:00\",\"filmStartsAt\":\"2026-07-17T11:00:00+01:00\",\"filmEndsAt\":\"2026-07-17T12:00:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"200-1-30\",\"filmId\":\"HO00009060\",\"siteId\":\"200\",\"screenId\":\"200-1\",\"areaCategories\":[{\"areaCategoryId\":\"200-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"200-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000065\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"200-21608\",\"schedule\":{\"businessDate\":\"2026-07-17\",\"startsAt\":\"2026-07-17T12:30:00+01:00\",\"endsAt\":\"2026-07-17T13:30: