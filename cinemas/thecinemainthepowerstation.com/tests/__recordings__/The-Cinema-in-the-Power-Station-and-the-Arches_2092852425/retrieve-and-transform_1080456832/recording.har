r-group section-page-submenus\">\n      <!-- <div class=\"submenus\"> -->\n  <div class=\"d-flex justify-content-evenly\"><div class=\"submenu submenu-3\">\n<!-- <a href=\"/whats-on\" class=\"\"> -->\n  <a href=\"/whats-on\" class=\"\">\n        <span class=\"tagline\">What&#039;s On</span>\n    </a>\n</div><div class=\"submenu submenu-6\">\n<!-- <a href=\"/whats-on/babes-in-arms\" class=\"\"> -->\n  <a href=\"/whats-on/babes-in-arms\" class=\"\">\n        <span class=\"tagline\">Babes in Arms</span>\n    </a>\n</div><div class=\"submenu submenu-8\">\n<!-- <a href=\"/whats-on/accessibility\" class=\"\"> -->\n  <a href=\"/whats-on/accessibility\" class=\"\">\n        <span class=\"tagline\">Accessibility</span>\n    </a>\n</div><div class=\"submenu submenu-9\">\n<!-- <a href=\"/whats-on/dolby-cinema\" class=\"\"> -->\n  <a href=\"/whats-on/dolby-cinema\" class=\"\">\n        <span class=\"tagline\">Dolby Cinema</span>\n    </a>\n</div><div class=\"submenu submenu-11\">\n<!-- <a href=\"/ticket-info\" class=\"\"> -->\n  <a href=\"/ticket-info\" class=\"\">\n        <span class=\"tagline\">Ticket Info</span>\n    </a>\n</div>      <!-- <div class=\"submenu submenu-1\">\n          <a href=\"/thecinemainthepowerstation.com/signup\" class=\"\">\n              <span class=\"tagline\">Sign Up</span>\n          </a>\n      </div> --></div>    </div>\n  </section>\n\n  <section id=\"section_1_stack\" class=\"bg-dark py-4 py-lg-5\">    <div class=\"d-lg-block text-center \">\n        <img class=\"w-auto logo2-whatson mt-0\" src=\"/assets/images/cinema-logo-white-2.png\" alt=\"Cinema Logo\">\n    </div></section><section id=\"section_2_stack\" class=\"bg-white p-0\"><section class=\"mb-0\">\n    <div class=\"page-header py-5 py-md-0 ratio ratio-2x1 position-relative bg-white\">\n        <picture>\n            <source srcset=\"https://media.cinemacloud.co.uk/imageFilm/2007_7_1.jpg\" media=\"(max-width: 991.9px)\">\n            <source srcset=\"https://media.cinemacloud.co.uk/imageFilm/2007_10_1.jpg\" media=\"(min-width: 992px)\">\n            <img src=\"https://media.cinemacloud.co.uk/imageFilm/2007_10_1.jpg\" alt=\"Background\" class=\"w-100 h-100 position-absolute top-0 start-0 object-fit-cover\">\n        </picture>\n<div class=\"position-absolute w-100 w-lg-50 h-50 h-lg-100 bg-grad\"></div>        <div id=\"movie-overlay\" class=\"d-flex flex-column justify-content-end justify-content-lg-center align-items-center align-items-lg-start h-100 mx-lg-7\">\n        <div class=\"d-none d-lg-inline movie-awards mb-4 d-flex justify-content-start\"></div>    <img class=\"title-treatment mb-4 mb-lg-6\" src=\"https://media.cinemacloud.co.uk/imageFilm/2007_8_1.png\" alt=\"Logo\">    <div class=\"movie-badges mb-2 d-flex justify-content-start\">        <span class=\"badge text-bg-secondary me-2\">2024</span>\n    <span class=\"badge text-bg-secondary me-2\">2hr 11mins</span>        <img src=\"https://media.cinemacloud.co.uk/imageMisc/Dolby/Atmos/Vertical/DLB_Atms_vert_rgb_wht_@1x.png\" class=\"cert-20 me-2\" alt=\"Movie Sound Dolby Atmos\">\n        <img src=\"https://media.cinemacloud.co.uk/bbfc/SVGs/BBFC_15_RGB.svg\" class=\"cert-20\" alt=\"BBFC Cert 15\">\n    </div><p class=\"text-white opacity-6\"><small>Horror, Thriller, Action</small></p>    </div>    </div>\n</div>\n</section></section><section id=\"section_3_stack\" class=\"bg-white p-0\">            <div class=\"container my-5\">\n                <div class=\"row\">\n\n                    <div class=\"col-12 col-lg-6 order-1 order-lg-0\">\n                        <h3 class=\"text-uppercase\">Sinners</h3>\n\n\n                        <p><img src=\"https://media.cinemacloud.co.uk/bbfc/SVGs/BBFC_15_RGB.svg \" class=\"cert-40 my-4\" alt=\"BBFC Cert $certs\" ></p>\n\n                                                    <h3 class=\" fjalla-one-regular fs-4 text-dark mb-4\">Synopsis</h3>\n                            <p class=\"mb-5 text-dark\">Trying to leave their troubled lives behind, twin brothers return to their hometown to start again, only to discover that an even greater evil is waiting to welcome them back.</p>\n                                                \n                        <div class=\"row\">\n                            <div class=\"col-7 col-md-8\">\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Release Date:</p>\n                                    <p class=\"mt-0 fw-bolder\">April</p>\n                                \n\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Duration:</p>\n                                    <p class=\"mt-0 fw-bolder\">2hr 11mins</p>\n                                \n\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Available Sound Formats:</p>\n                                    <p class=\"mt-0 fw-bolder sound-formats\">\n                                        Dolby Atmos                                    </p>\n                                                                                                    <p class=\"mb-1 fw-bold text-secondary\">Genre:</p>\n                                    <p class=\"mt-0 fw-bolder\">Horror, Thriller, Action</p>\n                                                                                                    <p class=\"mb-1 fw-bold text-secondary\">Country:</p>\n                                    <p class=\"mt-0 fw-bolder\">United States</p>\n                                \n                            </div>\n                            <div class=\"col-5 col-md-4\">\n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Director:</p>\n                                    <p class=\"mt-0 fw-bolder\">Ryan Coogler</p>\n                                \n                                                                    <p class=\"mb-1 fw-bold text-secondary\">Starring:</p>\n                                    <p class=\"mt-0 fw-bolder\">Michael B. Jordan,<br> Hailee Steinfeld,<br> Jack O'Connell</p>\n                                                            </div>\n                        </div>\n\n                        \n                        <!-- <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                            </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“Florence Pugh and Andrew Garfield scorch…The pair’s chemistry is off the charts and each set-piece a showstopper in this tragic romance.”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                            Kevin Maher, The Times\n                            </figcaption>\n                        </figure>\n\n                        <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                        </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“It’s such a joy to watch two such assured and natural performers allowed the room to exercise both movie star and actor muscles as well as showcase their ease with both comedy and drama.”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                            Benjamin Lee, Guardian\n                            </figcaption>\n                        </figure>\n\n                        <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                        </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“The perfect movie for when you want to sit in your feelings and be taken on an unashamedly emotional journey…Garfield and Pugh are as dreamy a team as you’d hope!”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                            Tori Brazier, Metro\n                            </figcaption>\n                        </figure>\n\n                        <hr class=\"dark horizontal my-5\">\n                        <figure>\n                            <div class=\"d-block mb-4\">\n                                                        </div>\n                            <blockquote class=\"blockquote text-dark\">\n                                <p>“Andrew Garfield and Florence Pugh will break your heart in a London romance of rare honesty.”</p>\n                            </blockquote>\n                            <figcaption class=\"blockquote-footer mt-3\">\n                                Helen O'Hara, Time Out\n                            </figcaption>\n                        </figure> -->\n\n                    </div>\n\n                    \n                    <div class=\"col-12 col-lg-6 ps-lg-5 order-0 order-lg-1\">\n                        <h2 class=\"fs-4 fjalla-one-regular\">Show times</h2>\n\n                        <p class=\"mb-4\">To book online, please first select a location from below and then select a time:</p>                                    <!-- <div class=\"row row-cols-2 g-4\">\n                                        <div class=\"col\">\n                                            <div class=\"card h-100 bg-power \">\n                                            <img src=\"/assets/images/ps-inside.jpg\" class=\"card-img-top\" alt=\"...\">\n                                            <div class=\"card-footer text-center p-2 pb-0\">\n                                                <h3 class=\"d-none d-lg-block text-white fjalla-one-regular text-uppercase mb-0\">The Power Station</h3>\n                                                <p class=\"d-none d-lg-block text-white text-spacing-2 text-uppercase homepage-small\">Turbine Hall B Battersea Power Station</p>\n                                                <p class=\"d-block d-lg-none text-white text-spacing-2 text-uppercase homepage-small mb-2\">Turbine Hall B</p>\n                                            </div>\n                                            </div>\n                                        </div>\n                                        <div class=\"col\">\n                                            <div class=\"card h-100 bg-arches \">\n                                            <img src=\"/assets/images/ps-outside.jpg\" class=\"card-img-top\" alt=\"...\">\n                                            <div class=\"card-footer text-center p-2 pb-0\">\n                                                <h3 class=\"d-none d-lg-block text-white fjalla-one-regular text-uppercase mb-0\">The Arches</h3>\n                                                <p class=\"d-none d-lg-block text-white text-spacing-2 text-uppercase homepage-small\">Arches Lane Battersea Power Station</p>\n                                                <p class=\"d-block d-lg-none text-white text-spacing-2 text-uppercase homepage-small mb-2\">Arches Lane</p>\n                                            </div>\n                                            </div>\n                                        </div>\n                                    </div> -->\n\n                                                                    \n                                <div id=\"location-buttons\" class=\"row row-cols-2 g-2 mb-4\">\n                                                                                <div class=\"col\">\n                                                <a role=\"button\" data-subsite=\"6\" class=\"select-subsite text-decoration-none\">\n                                                    <div class=\"card h-100 bg-power\">\n                                                        <img src=\"/assets/images/ps-inside.jpg\" class=\"card-img-top image-highlight\" alt=\"...\">\n                                                        <div class=\"card-footer text-center p-2 pb-0\">\n                                                            <p class=\"d-none d-lg-block text-white text-spacing-2 text-uppercase homepage-small mb-0\">Turbine Hall B</p>\n                                                            <p class=\"d-none d-lg-block text-white text-spacing-2 text-uppercase homepage-small\">Battersea Power Station</p>\n                                                            <p class=\"d-block d-lg-none text-white text-spacing-2 text-uppercase homepage-small mb-2\">Turbine Hall B</p>\n                                                        </div>\n                                                    </div>\n                                                </a>\n\n                                                <style>\n                                                .image-highlight:hover {\n                                                    filter: brightness(1.3);\n                                                    transition: filter 0.3s ease;\n                                                }\n\n                                                .image-highlight {\n                                                transition: filter 0.3s ease;\n                                                }\n                                                </style>\n                                            </div>\n                                            <!-- <button type=\"button\" class=\"btn btn-power btn-lg rounded-1 mb-4 select-subsite w-100 me-2 px-2\" \n                                                    data-subsite=\"6\" \n                                                    data-bs-toggle=\"tooltip\" \n                                                    data-bs-placement=\"top\" \n                                                    data-bs-custom-class=\"custom-tooltip\" \n                                                    data-bs-html=\"true\" \n                                                    data-bs-title=\"Located on 3rd Floor, Turbine Hall B, Battersea Power Station\">\n                                                The Cinema in the Power Station\n                                            </button> -->\n                                                                                                                <div class=\"col\">\n                                                <a role=\"button\" data-subsite=\"7\" class=\"select-subsite text-decoration-none\">\n                                                    <div class=\"card h-100 bg-arches\">\n                                                        <img src=\"/assets/images/ps-outside.jpg\" class=\"card-img-top image-highlight\" alt=\"...\">\n                                                        <div class=\"card-footer text-center p-2 pb-0\">\n                                                            <!-- <h3 class=\"d-none d-lg-block text-white fjalla-one-regular text-uppercase mb-0 fs-4\">The Arches</h3> -->\n                                                            <p class=\"d-none d-lg-block text-white text-spacing-2 text-uppercase homepage-small mb-0\">Arches Lane</p>\n                                                            <p class=\"d-none d-lg-block text-white text-spacing-2 text-uppercase homepage-small\">Battersea Power Station</p>\n                                                            <p class=\"d-block d-lg-none text-white text-spacing-2 text-uppercase homepage-small mb-2\">Arches Lane</p>\n                                                        </div>\n                                                    </div>\n                                                </a>\n                                            </div>\n                                            <!-- <button type=\"button\" class=\"btn btn-arches btn-lg rounded-1 mb-4 select-subsite w-100 ms-2 px-2\" \n                                                    data-subsite=\"7\" \n                                                    data-bs-toggle=\"tooltip\" \n                                                    data-bs-placement=\"top\" \n                                                    data-bs-custom-class=\"custom-tooltip\" \n                                                    data-bs-html=\"true\" \n                                                    data-bs-title=\"Situated just outside The Power Station, in the Arches under Grosvenor Bridge.\">\n                                                The Cinema in the Arches\n                                            </button> -->\n                                                                    </div>\n                                                            \n            \n                            <script>\n                                document.addEventListener(\"DOMContentLoaded\", function () {\n                                    var buttons = document.querySelectorAll(\".select-subsite\");\n                                    var showtimes6 = document.getElementById(\"showtimes6\");\n                                    var showtimes7 = document.getElementById(\"showtimes7\");\n\n                                    buttons.forEach(button => {\n                                        button.addEventListener(\"click\", function () {\n                                            var subsite = this.getAttribute(\"data-subsite\");\n\n                                            // Toggle visibility of showtime divs based on subsite value\n                                            if (subsite === \"6\") {\n                                                showtimes6.classList.remove(\"d-none\");\n                                                showtimes6.classList.add(\"d-block\");\n                                                showtimes7.classList.remove(\"d-block\");\n                                                showtimes7.classList.add(\"d-none\");\n                                            } else if (subsite === \"7\") {\n                                                showtimes7.classList.remove(\"d-none\");\n                                                showtimes7.classList.add(\"d-block\");\n                                                showtimes6.classList.remove(\"d-block\");\n                                                showtimes6.classList.add(\"d-none\");\n                                            }\n\n                                            // Send AJAX request to the server using fetch\n                                            fetch(\"/assets/ajax/select_subsite.php\", {\n                                                method: \"POST\",\n                                                headers: {\n                                                    \"X-Requested-With\": \"XMLHttpRequest\",\n                                                    \"Content-Type\": \"application/x-www-form-urlencoded\" // ✅ Needed for URL-encoded form data\n                                                },\n                                                body: `subsite=${encodeURIComponent(subsite)}` // ✅ Encode data properly\n                                            })\n                                            .then(response => response.json()) // ✅ Parse JSON response\n                                            .then(data => {\n                                                if (data.success) {\n                                                    console.log(\"Subsite selected:\", data);\n                                                } else {\n                                                    console.error(\"Error:\", data.message);\n                                                }\n                                            })\n                                            .catch(error => {\n                                                console.error(\"Request failed:\", error);\n                                            });\n                                        });\n                                    });\n                                });\n                            </script>\n\n                        \n                                                                <div id=\"showtimes6\" class=\"d-none\">\n                                        <h3>Showtimes for Turbine Hall B</h3>\n                                        <p>These screenings are located on 3rd Floor, Turbine Hall B, Battersea Power Station.</p>\n                                                    <h4 class=\"fs-6 mb-4 fw-bold text-muted\">Friday, April 18</h4>\n            <div class=\"d-flex flex-wrap text-center mb-4\">\n                <script>\n                    // Initialize all tooltips\n                    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle=\"tooltip\"]'));\n                    tooltipTriggerList.map(function (tooltipTriggerEl) {\n                        return new bootstrap.Tooltip(tooltipTriggerEl);\n                    });\n                </script>\n                           \n                                        <a role=\"button\" class=\"btn btn-power rounded-1 mb-3 me-3 py-1 py-md-3 px-3 d-flex align-items-center\" \n                         href=\"https://web2.empire.mycloudcinema.com/#/book/38303\" style=\"min-height: 40px;\">\n                        <div class=\"d-flex align-items-center w-100 justify-content-center\">\n                            <span class=\"btn-times-fs\" style=\"line-height: 1;\">13:45</span>\n                                