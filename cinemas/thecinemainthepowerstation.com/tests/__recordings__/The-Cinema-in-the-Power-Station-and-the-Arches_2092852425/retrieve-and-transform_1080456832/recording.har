-target=\"subMenu2\">\n                    Box Office<i class=\"bi bi-chevron-right ms-2 d-lg-none\"></i>\n                  </a>\n                  \n    <div class=\"hover-content border-bottom\">\n      <div class=\"container-fluid\">\n        <div class=\"row justify-content-center \">\n        \n\n    <div class=\"col-12 col-xl-10 py-lg-4 px-lg-9\">\n      <div class=\"row\">\n        <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n          <div class=\"menu-promotion\">\n            <a class=\"menu-promotion__link\" href=\"https://www.olympiccinema.com/whats-on\">\n              <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_cinema_1.jpg\">\n            </a>\n            <div class=\"pt-2\">Olympic Cinema</div>\n          </div>\n        </div>\n\n        <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n          <div class=\"menu-promotion\">\n            <a class=\"menu-promotion__link\" href=\"https://www.thecinemainthepowerstation.com/whats-on\">\n              <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_cinema_2.jpg\">\n            </a>\n            <div class=\"pt-2\">The Cinema in the Power Station</div>\n          </div>\n        </div>\n\n        <div class=\"col-lg-4 col-sm-12 mb-2 d-flex justify-content-center\">\n          <div class=\"menu-promotion\">\n            <a class=\"menu-promotion__link\" href=\"https://www.thecinemaatselfridges.com/whats-on\">\n              <img class=\"menu-promotion__image img-fluid\" src=\"https://media.cinemacloud.co.uk/imageMisc/2025/menu_cinema_3.jpg\">\n            </a>\n            <div class=\"pt-2\">The Cinema at Selfridges</div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n        </div>\n      </div>\n    </div>\n\n                </li>\n\n\n              <li class=\"nav-item \">\n                <a class=\"nav-link \" href=\