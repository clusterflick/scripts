            "size": 84198,
            "text": "\n<!doctype html><!doctype html>\n<html lang=\"en\">\n<!-- <html lang=\"en\" class=\"h-100\" data-bs-theme=\"light\"> -->\n\n  <head>\n    <meta charset=\"UTF-8\">\n    <meta content=\"dark light\" name=\"color-scheme\">\n    <meta content=\"origin\" name=\"referrer\">\n\t\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\">\n    <meta name=\"Description\" content=\"A hub of entertainment, with cinema at its heart, set in iconic locations\">\n    <meta name=\"Description\" content=\"Discover the innovative world of Apple and shop everything iPhone, iPad, Apple Watch, Mac, and Apple TV, plus explore accessories, entertainment, and expert device support.\">\n    <meta property=\"og:title\" content=\"Olympic Studios\">\n    <meta property=\"og:description\" content=\"A hub of entertainment, with cinema at its heart, set in iconic locations\">\n    <meta property=\"og:url\" content=\"https://www.olympicstudios.com/\">\n    <meta property=\"og:locale\" content=\"en_UK\">\n    <meta property=\"og:image\" content=\"https://www.thecinemainthepowerstation.com/assets/images/open_graph_logo.png?202110180743\">\n    <meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:site_name\" content=\"Olympic Studios\">\n\n    <title>Black Bag - The Cinema in The Power Station</title>\n    <meta name=\"generator\" content=\"cc v2\">\n\t\t<link rel=\"canonical\" href=\"https://www.olympicstudios.com\" />\n\n    <!-- BOOTSTRAP 5 -->\n\t\t<link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css\" rel=\"stylesheet\" integrity=\"sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH\" crossorigin=\"anonymous\">\n\t\t<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css\">\n\n\t\t<!-- FONTS -->\n    <link href=\"https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700|Noto+Sans:300,400,500,600,700,800|PT+Mono:300,400,500,600,700\" rel=\"stylesheet\">\n\t\t<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n\t\t<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n\t\t<link href=\"https://fonts.googleapis.com/css2?family=Fjalla+One&display=swap\" rel=\"stylesheet\">\n    \n    <link rel=\"stylesheet\" href=\"/assets/css/style.css?v=4.0.13\"/>\n    <!-- <link rel=\"stylesheet\" href=\"/assets/css/astro.css?v=4.0.13\"/> -->\n    <link rel=\"stylesheet\" href=\"/assets/css/style-custom.css?v=4.0.13\"/>\n    <link rel=\"stylesheet\" href=\"/assets/css/cinema-cloud.css?v=4.0.13\"/>\n    <link rel=\"stylesheet\" href=\"/assets/css/horizontal-scroller.css?v=4.0.13\"/>\n    <link rel=\"stylesheet\" href=\"/assets/css/nav.css?v=4.0.13\"/>\n\n\t\t<!-- FAVICON -->\n\t\t<link rel=\"shortcut icon\" type=\"image/ico\" href=\"/assets/images/cinema_2/favicon.ico\" >\n\t\t<!-- <link rel=\"apple-touch-icon\" type=\"image/png\" sizes=\"76x76\" href=\"/assets/images/cinema_2/favicon-76x76.png\"> -->\n\t\t<link rel=\"apple-touch-icon\" type=\"image/png\" sizes=\"167x167\" href=\"/assets/images/cinema_2/favicon-167x167.png\">\n\t\t<link rel=\"apple-touch-icon\" type=\"image/png\" sizes=\"180x180\" href=\"/assets/images/cinema_2/favicon-180x180.png\">\n\t\t<link rel=\"icon\" type=\"image/png\" sizes=\"48x48\" href=\"/assets/images/cinema_2/favicon-48x48.png\">\n\t\t<link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/assets/images/cinema_2/favicon-192x192.png\">\n\n    <!-- Google Tag Manager -->\n\t\t\t\t\t<!-- Global site tag (gtag.js) - Google Analytics x -->\n\t\t\t<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-BZH37G5VDY\"></script>\n\t\t\t<script>\n\t\t\t\t\twindow.dataLayer = window.dataLayer || [];\n\t\t\t\t\tfunction gtag() {\n\t\t\t\t\t\t\tdataLayer.push(arguments);\n\t\t\t\t\t}\n\t\t\t\t\tgtag('js', new Date());\n\t\t\t\t\tgtag('config', 'G-BZH37G5VDY');\n\t\t\t</script>\n\t\t\t\t\t\t<!-- Google Tag Manager -->\n\t\t\