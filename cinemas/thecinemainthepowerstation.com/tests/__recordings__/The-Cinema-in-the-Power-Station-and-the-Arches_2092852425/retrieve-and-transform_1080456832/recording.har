 ms-2\"></p>\n  \n      <p class=\"col-auto m-0 justify-content-center d-flex align-items-center justify-content-between text-white lw-1\">\n          A hub of entertainment, with cinema at its heart, set in iconic locations\n      </p>\n    \n      <p class=\"col text-end m-0 text-uppercase\">        </p>\n      </div>\n              \n\n  <section class=\"position-sticky top-0 z-index-4\">\n    <nav id=\"cc-nav\" class=\"navbar navbar-expand-lg bg-white border-bottom p-0 d-flex justify-content-between align-items-center start-0 end-0\">\n      \n      <!-- Hamburger Button (Visible only on mobile) -->\n      <div class=\"col-auto d-flex justify-content-start ms-2 d-lg-none\">\n\n        <!-- <button class=\"btn btn-primary\" type=\"button\" data-bs-toggle=\"offcanvas\" data-bs-target=\"#testOffcanvas\">Open Offcanvas</button> -->\n        <button class=\"navbar-toggler border-0 p-0\" type=\"button\" data-bs-toggle=\"offcanvas\"\n          data-bs-target=\"#offcanvasMenu\" aria-controls=\"offcanvasMenu\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n          <span class=\"navbar-toggler-icon\"></span>\n        </button>\n      </div>\n\n      <!-- Logo (Center on mobile, left on desktop) -->\n      <div class=\"col-auto d-flex justify-content-center position-absolute start-50 translate-middle-x d-lg-none\">\n      <a href=\"#\" class=\"navbar-brand mx-auto\">\n      <!-- <a href=\"\" class=\"navbar-brand mx-auto\"> -->\n\n      <a href=\"https://www.olympicstudios.com\" class=\"navbar-brand mx-auto\">\n      <!-- <img class=\"logo logo2 mobile-logo\" src=\"/assets/images/cinema-logo2.png\" alt=\"Cinema Logo\"> -->\n      <img class=\"logo logo0 mobile-logo\" src=\"/assets/images/OlympicLogo_Gold.png\" alt=\"Cinema Logo\">\n        </a>\n      </div>\n\n      <!-- Accounts Icon (Visible only on mobile) -->\n      <div class=\"col-auto d-flex justify-content-end d-lg-none me-2\">\n        <a href=\"/account\" class=\"text-decoration-none\">\n          <