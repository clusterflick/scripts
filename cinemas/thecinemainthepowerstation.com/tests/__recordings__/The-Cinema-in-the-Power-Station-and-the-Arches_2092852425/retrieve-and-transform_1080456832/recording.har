\":\"Place\",\"name\":\"The Cinema in The Power Station\",\"address\":{\"@type\":\"PostalAddress\",\"name\":\"The Cinema in The Power Station\",\"streetAddress\":\"3rd Floor, Turbine Hall B, Battersea Power Station\",\"addressLocality\":\"London\",\"postalCode\":\"SW11 8DD\",\"addressCountry\":\"GB\"}},\"priceRange\":\"£5 - £20\",\"offers\":{\"@type\":\"Offer\",\"url\":\"https://web2.empire.mycloudcinema.com/#/book/38111\",\"priceCurrency\":\"GBP\",\"availability\":\"https://schema.org/InStock\",\"validFrom\":\"2025-04-07T19:10:21.506737+01:00\"},\"inLanguage\":\"en\",\"image\":\"https://media.cinemacloud.co.uk/imageFilm/2017_10_1.jpg\"}</script>\n                            </div>\n                                                </div>\n                                                                \n                    </div>\n\n                </div>\n                \n\n                </section>  \n<footer class=\"container-fluid bg-light\">\n  <div class=\"p-1 pt-4 p-lg-5 border-top row\">\n\n    <div class=\"col-12 col-lg-3 mb-5 mb-lg-3\">\n      <h6 class=\"fjalla-one-regular text-dark mb-4 text-uppercase lh-sm\">A hub of entertainment, with cinema at its heart, set in iconic locations</h6>\n      <div class=\"flex-column\">\n        <p>Cinema as it’s meant to be — immersive, effortless, and unforgettable. With state-of-the-art sound and vision, our screens offer a truly unrivalled experience. Settle into spacious, reclining seats with ample legroom and personal tables. The Grab & Go bar offers quiet snacks, and curated wines and drinks to enjoy throughout the film.</p>\n      </div>\n    </div>\n\n    <div class=\"col-12 col-lg-6 row d-flex justify-content-start justify-content-lg-center\">\n      <div class=\"col-12 col-md-4 mb-5 mb-lg-3 d-flex justify-content-start justify-content-lg-center\">\n        <div class=\"text-sm-start\">\n          <h6 class=\"fjalla-one-regular text-dark text-uppercase mb-4\">Discover</h6>\n          <ul class=\"nav flex-column\">\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/select-your-cinema\" class=\"p-0\">Box Office</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/blogs/events\" class=\"p-0\">Events</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/private-hire\" class=\"p-0\">Private Hire</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/membership\" class=\"p-0\">Membership</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/recording-studio\" class=\"p-0\">Recording Studio</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/dine-and-drink\" class=\"p-0\">Dine & Drink</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"/account\" class=\"p-0\">Sign In</a></p></li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"col-12 col-md-4 mb-5 mb-lg-3 d-flex justify-content-start justify-content-lg-center\">\n        <div class=\"text-sm-start\">\n          <h6 class=\"fjalla-one-regular text-dark text-uppercase mb-4\">About</h6>\n          <ul class=\"nav flex-column\">\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/our-story\" class=\"p-0\">Our Story</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/get-in-touch\" class=\"p-0\">Get in Touch</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/join-the-team\" class=\"p-0\">Join the Team</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/pages/accessibility\" class=\"p-0\">Accessibility</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/policies/privacy-policy\" class=\"p-0\">Privacy Policy</a></p></li>\n            <li class=\"\"><p class=\"mb-2\"><a href=\"https://www.olympicstudios.com/policies/terms-of-service\" class=\"p-0\">Terms of Service</a></p></li>\n          </ul>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"mc_embed_signup\" class=\"col-12 col-lg-3 mb-5 mb-lg-3\">\n      <form action=\"https://olympiccinema.us21.list-manage.com/subscribe/post?u=68db9de725c43ba8028e19e42&amp;id=48332d89b2&amp;f_id=0028e1e6f0\" method=\"post\" id=\"mc-embedded-subscribe-form\" name=\"mc-embedded-subscribe-form\"  target=\"_self\" class=\"row needs-validation validate\" validate>\n        <h6 class=\"fjalla-one-regular text-dark text-uppercase mb-4\">The Dispatch</h6>\n        <p>Tune in for the latest news</p>\n        <div id=\"mc_embed_signup_scroll\">\n            <div class=\"mc-field-group has-validation\">\n              <!-- <label for=\"mce-EMAIL\">Email Address <span class=\"asterisk form-label\">*</span></label> -->\n              <input type=\"email\" name=\"EMAIL\" class=\"form-control required email\" id=\"mce-EMAIL\" placeholder=\"Your email *\" required>\n              <div class=\"invalid-feedback\">\n                Please type a valid email address.\n              </div>\n            </div>\n\n            <div class=\"row my-2\">\n              <div class=\"mc-field-group has-validation col-md-6 mb-2 mb-lg-0\">\n                <!-- <label for=\"mce-FNAME\" class=\"form-label\">First Name </label> -->\n                <input type=\"text\" name=\"FNAME\" class=\"form-control text\" id=\"mce-FNAME\" placeholder=\"First Name\" required>\n                <div class=\"valid-feedback\">Looks good!</div>\n              </div>\n              <div class=\"mc-field-group has-validation col-md-6\">\n                <!-- <label for=\"mce-LNAME\" class=\"form-label\">Last Name </label> -->\n                <input type=\"text\" name=\"LNAME\" class=\"form-control text\" id=\"mce-LNAME\" placeh