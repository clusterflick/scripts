//schema.org\",\"@type\":\"Event\",\"name\":\"Toy Story 5\",\"startDate\":\"2026-07-16T18:45:00.000+00:00\",\"endDate\":\"2026-07-16T20:47:00.000+00:00\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"location\":{\"@type\":\"Place\",\"name\":\"The Cinema in the Arches\",\"address\":{\"@type\":\"PostalAddress\",\"name\":\"The Cinema in the Arches\",\"streetAddress\":\"Circus West, 22 Arches Lane\",\"addressLocality\":\"London\",\"postalCode\":\"SW11 8AB\",\"addressCountry\":\"GB\"}},\"priceRange\":\"£5 - £20\",\"offers\":{\"@type\":\"Offer\",\"url\":\"https://web2.empire.mycloudcinema.com/#/book/58323\",\"priceCurrency\":\"GBP\",\"availability\":\"https://schema.org/InStock\",\"validFrom\":\"2026-07-11T18:08:45+01:00\"},\"inLanguage\":\"en\",\"image\":\"https://m.cinemacloud.co.uk/imageFilm/2373_10_2.jpg\"}</script>            </div>\n            </div>                    </div>\n                    <div class=\"d-block d-md-none\">\n                        <h2 class=\"fs-4 fjalla-one-regular text-dark\">Show Times</h2><p class=\"fs-6\">To book online, please select a time from below:</p><p class=\"mb-4\">First select a cinema location from below and then select the time:</p>                <div id=\"location-buttons\" class=\"row row-cols-2 g-2 mb-4\">\n                                        <div class=\"col\">\n                        <a role=\"button\" data-subsite=\"6\" class=\"select-subsite text-decoration-none\">\n                            <div class=\"card h-100 bg-power\">\n                                <img src=\"/assets/images/ps-inside.jpg\" class=\"card-img-top image-highlight\" alt=\"...\">\n                                <div class=\"card-footer text-center p-2 pb-0\">\n                                    <p class=\"d-none d-lg-block text-white text-spacing-2 text-uppercase homepage-small mb-2\">The Cinema in The Power Station</p>\n                                    <p class=\"d-block d-lg-none text-white text-spacing-2 text-uppercase homepage-small mb-2\">The Cinema in The Power Station</p>\n                                </div>\n                            </div>\n                        </a>\n                        <style>.image-highlight:hover{filter:brightness(1.3);transition:filter 0.3s ease}.image-highlight{transition:filter 0.3s ease}</style>\n                    </div>\n                                                            <div class=\"col\">\n                        <a role=\"button\" data-subsite=\"7\" class=\"select-subsite text-decoration-none\">\n                            <div class=\"card h-100 bg-arches\">\n                                <img src=\"/assets/images/ps-outside.jpg\" class=\"card-img-top image-highlight\" alt=\"...\">\n                                <div class=\"card-footer text-center p-2 pb-0\">\n                                    <p class=\"d-none d-lg-block text-white text-spacing-2 text-uppercase homepage-small mb-2\">The Cinema in The Arches</p>\n                                    <p class=\"d-block d-lg-none text-white text-spacing-2 text-uppercase homepage-small mb-2\">The Cinema in The Arches</p>\n                                </div>\n                            </div>\n                        </a>\n                    </div>\n                                    </div>\n                <script>\n                    document.addEventListener(\"DOMContentLoaded\", function () {\n                        var buttons = document.querySelectorAll(\".select-subsite\");\n                        var showtimes6 = document.getElementById(\"showtimes6m\");\n                        var showtimes7 = document.getElementById(\"showtimes7m\");\n                        buttons.forEach(function(button) {\n                            button.addEventListener(\"click\", function () {\n                                var subsite = this.getAttribute(\"data-subsite\");\n                                if (subsite === \"6\") {\n                                    showtimes6.classList.remove(\"d-none\");\n                                    showtimes6.classList.add(\"d-block\");\n                                    showtimes7.classList.remove(\"d-block\");\n                                    showtimes7.classList.add(\"d-none\");\n                                } else if (subsite === \"7\") {\n                                    showtimes7.classList.remove(\"d-none\");\n                                    showtimes7.classList.add(\"d-block\");\n                                    showtimes6.classList.remove(\"d-block\");\n                                    showtimes6.classList.add(\"d-none\");\n                                }\n                                fetch(\"/api/session/select-subsite\", {\n                                    method: \"POST\",\n                                    headers: {\n                                        \"X-Requested-With\": \"XMLHttpRequest\",\n                                        \"Content-Type\": \"application/x-www-form-urlencoded\"\n                                    },\n                                    body: \"subsite=\" + encodeURIComponent(subsite)\n                                })\n                                .then(function(r) { return r.json(); })\n                                .then(function(data) { if (!data.success) { console.error(\"Error:\", data.message); } })\n                                .catch(function(err) { console.error(\"Request failed:\", err); });\n                            });\n                        });\n                    });\n                </script>\n                <div id=\"showtimes6m\" class=\"d-none\"><h3>Show times in The Power Station</h3><p>These screenings are located on 3rd Floor, Turbine Hall B, Battersea Power Station.</p>        <script>\n            document.addEventListener('DOMContentLoaded', function() {\n                var tooltipTriggerList = [].sl