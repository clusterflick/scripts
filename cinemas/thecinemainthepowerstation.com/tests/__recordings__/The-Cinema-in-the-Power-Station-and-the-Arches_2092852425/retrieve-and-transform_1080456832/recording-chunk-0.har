                </span>\n                                            </div>\n        </a>\n                                </div>\n                                    </div>\n            </div>\n        </div>\n                    </div>\n        </section>\n                <section class=\"date-section\">\n            <h3 class=\"date-day date-sticky fs-4 mb-4 mb-lg-2 fjalla-one-regular text-muted\">\n                Tuesday September 22            </h3>\n            <div class=\"row mb-5\">\n                        <div class=\"col-md-12\">\n            <div class=\"row mb-2 mb-lg-0\">\n                <div class=\"col-md-5 d-flex justify-content-start align-items-start mt-0 mt-md-2\">\n                    <img src=\"https://m.cinemacloud.co.uk/bbfc/SVGs/BBFC_15_RGB.svg\" class=\"cert-20 me-2\" alt=\"BBFC Cert 15\">\n                    <h5 class=\"h5-title fw-bolder text-uppercase lh-1 mb-2 mb-lg-0\">\n                        <a class=\"text-decoration-none text-black\" href=\"/film/nt-live-the-misanthrope\">National Theatre Live: The Misanthrope</a>\n                    </h5>\n                </div>\n                <div class=\"col mb-2 border-bottom border-0 border-lg-1 border-light-subtle\">\n                                                                        <h6 class=\"text-muted fw-semibold mb-1 mb-lg-2\">The Cinema in the Arches</h6>\n                                                <div class=\"d-flex flex-wrap\">\n                                    <a class=\"btn btn-arches mb-2 mb-lg-3 me-3 py-1 py-md-3 px-3 rounded-1 d-flex align-items-center justify-content-center\"\n           href=\"#\" role=\"button\"  style=\"min-height: 40px;\"   data-bs-toggle=\"modal\" data-bs-target=\"#archesNoticeModal\" data-booking-url=\"https://web2.empire.mycloudcinema.com/#/book/58333\" >\n            <div class=\"d-flex align-items-center\">\n                <span class=\"d-flex align-items-center\">\n                    <span class=\"btn-times-fs\" style=\"line-height:1;\">19:30</span>\n                                        <span class=\"ms-2 opacity-7 d-none\" style=\"line-height:1;\"></span>\n                </span>\n                                            </div>\n        </a>\n                                </div>\n                                    </div>\n            </div>\n        </div>\n                    </div>\n        </section>\n                </div>\n        <script>\n        document.addEventListener('DOMContentLoaded', function() {\n            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle=\"tooltip\"]'));\n            tooltipTriggerList.map(function(e) { return new bootstrap.Tooltip(e); });\n            document.querySelectorAll('a.disabled').forEach(function(el) {\n                el.addEventListener('click', function(e) { e.preventDefault(); });\n            });\n            const stickyHeaders = document.querySelectorAll('.date-sticky');\n            if (stickyHeaders.length > 0) {\n                const getStickyTop = () => window.innerWidth >= 992 ? 118 : window.innerWidth >= 768 ? 95 : 87;\n                const checkSticky = () => {\n                    const t = getStickyTop();\n                    stickyHeaders.forEach(h => {\n                        const rect = h.getBoundingClientRect();\n                        h.classList.toggle('is-stuck', rect.top <= t + 5 && rect.top >= t - 5);\n                    });\n                };\n                window.addEventListener('scroll', checkSticky, { passive: true });\n                window.addEventListener('resize', checkSticky, { passive: true });\n                checkSticky();\n            }\n        });\n        </script>\n                <div class=\"modal fade\" id=\"archesNoticeModal\" tabindex=\"-1\" aria-hidden=\"true\">\n            <div class=\"modal-dialog modal-dialog-centered\">\n                <div class=\"modal-content\">\n                    <div class=\"modal-header border-0\">\n                        <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\n                    </div>\n                    <div class=\"modal-body text-center py-0\">\n                        <h4 class=\"pb-2 modal-title fw-bold fjalla-one-regular text-uppercase\">IMPORTANT NOTICE</h4>\n                        <h6 class=\"mb-0\">This screening is at</h6>\n                        <h5 class=\"mb-0\"><strong>The Cinema in the Arches</strong>.</h5>\n                        <h6 class=\"mb-0 text-muted\"><strong>NOT</strong> in the main Power Station building — it's on Arches Lane.</h6>\n                    </div>\n                    <div class=\"modal-footer border-0 justify-content-center pb-4 text-center\">\n                        <h6 class=\"mt-3 mb-0 pb-2 text-muted\">To continue with your booking, click Book Now.</h6>\n                        <a href=\"#\" id=\"archesModalContinueBtn\" class=\"btn btn-arches\">BOOK NOW</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <script>\n        document.addEventListener('DOMContentLoaded', function() {\n            var m = document.getElementById('archesNoticeModal');\n            if (m) {\n                document.body.appendChild(m);\n                m.addEventListener('show.bs.modal', function(e) {\n                    var btn = e.relatedTarget;\n                    var url = btn ? btn.getAttribute('data-booking-url') : null;\n                    var cont = document.getElementById('archesModalContinueBtn');\n                    if (cont && url) cont.setAttribute('href', url);\n                });\n            }\n        });\n        </script>\n                    </div>\n</div>\n<script>\n(function () {\n    var stored = sessionStorage.getItem('cc_listing_view');\n    if (!stored) return;\n    var active = document.querySelector('.set-listings.nav-link.active');\n    if (!active || active.getAttribute('data-view') === stored) return;\n    var target = document.querySelector('.set-listings.nav-link[data-view=\"' + stored + '\"]');\n    if (!target) return;\n    // Swap nav link classes\n    active.classList.remove('active');\n    active.setAttribute('aria-selected', 'false');\n    target.classList.add('active');\n    target.setAttribute('aria-selected', 'true');\n    // Swap pane classes\n    var fromPane = document.querySelector('.tab-pane.active');\n    var toPane   = document.getElementById(target.getAttribute('href').replace('#', ''));\n    if (fromPane) { fromPane.classList.remove('active', 'show'); }\n    if (toPane)   { toPane.classList.add('active', 'show'); }\n    // Update data-session so cc.js moving-tab init reads the correct value\n    // and adds the 'active' class to the inner <a>, making the white indicator visible\n    var navPills = target.closest('.nav-pills');\n    if (navPills) navPills.setAttribute('data-session', stored);\n})();\n</script></section><section id=\"section_5_stack\" class=\"bg-white py-4 py-lg-5 m-0\"><div class=\"container \"><h2 class=\"fjalla-one-regular majortitle fs-4 text-uppercase p-0 m-0 pb-2 text-center text-black\">Coming Soon</h2></div><div class=\"horizontal-scroller d-flex align-items-center position-relative pt-4 pt-lg-5\">\n    <button class=\"arrow start-1\" id=\"scrollLeft_section_5\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" fill=\"none\">\n            <circle cx=\"24\" cy=\"24\" r=\"24\" transform=\"matrix(-1 0 0 1 48 0)\" fill=\"#00000030\"></circle>\n            <path fill-rule=\"evenodd\" clip-rule=\"evenodd\"\n                d=\"M26.8 30.634C26.3529 31.122 25.622 31.122 25.1748 30.634L19.2121 24.1265C18.7718 23.646 18.7718 22.8718 19.2121 22.3913L25.1748 15.8838C25.622 15.3958 26.3529 15.3958 26.8 15.8838C27.2404 16.3643 27.2404 17.1385 26.8 17.619L21.6323 23.2589L26.8 28.8987C27.2404 29.3793 27.2404 30.1534 26.8 30.634Z\"\n                fill=\"#ffffff\"></path>\n        <