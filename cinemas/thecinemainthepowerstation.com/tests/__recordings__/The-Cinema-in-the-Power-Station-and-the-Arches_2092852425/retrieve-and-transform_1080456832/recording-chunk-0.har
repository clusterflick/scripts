ard border border-light-subtle rounded-3 shadow-sm overflow-hidden\">\n            <img src=\"https://m.cinemacloud.co.uk/imageFilm/2429_7_1.jpg\" class=\"img-fluid object-fit-cover rounded-3\" alt=\"One Night Only\">\n            <div class=\"position-absolute bottom-0 text-white p-4 w-100 bg-grad-portrait-dark\">\n                <div id=\"whatson-tt\" class=\"d-flex justify-content-center\">\n                    <img src=\"https://m.cinemacloud.co.uk/imageFilm/2429_8_1.png\" class=\"title-treatment\" alt=\"One Night Only\"\n                         onerror=\"this.style.display='none';this.nextElementSibling.style.display='flex'\">\n                    <div class=\"title-treatment mb-4 text-white flex-wrap text-center\" style=\"display:none\">\n                        <p class=\"w-100 fs-2\" style=\"max-height:150px;white-space:normal\">One Night Only</p>\n                    </div>\n                </div>\n            </div>\n            <img src=\"https://m.cinemacloud.co.uk/bbfc/SVGs/BBFC_tba_RGB.svg\" class=\"cert-30 m-3\" alt=\"BBFC Cert tba\"\n                 style=\"position:absolute;top:0;right:0\">\n            <h2 class=\"fjalla-one-regular majortitle fs-4 text-white m-3\"\n                style=\"position:absolute;top:0;left:0\"></h2>\n        </div>\n    </div>\n</a><a class=\"text-decoration-none\" href=\"/film/bitter-christmas\">\n    <div class=\"card-container position-relative overflow-hidden ps-4 pe-0  last-card\">\n        <div class=\"card border border-light-subtle rounded-3 shadow-sm overflow-hidden\">\n            <img src=\"https://m.cinemacloud.co.uk/imageFilm/2413_7_1.jpg\" class=\"img-fluid object-fit-cover rounded-3\" alt=\"Bitter Christmas\">\n            <div class=\"position-absolute bottom-0 text-white p-4 w-100 bg-grad-portrait-dark\">\n                <div id=\"whatson-tt\" class=\"d-flex justify-content-center\">\n                    <img src=\"https://m.cinemacloud.co.uk/imageFilm/2413_8_1.png\" class=\"title-treatment\" alt=\"