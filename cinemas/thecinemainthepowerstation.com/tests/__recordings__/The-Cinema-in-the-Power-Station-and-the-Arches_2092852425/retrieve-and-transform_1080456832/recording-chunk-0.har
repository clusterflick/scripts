ss=\"tagline\">Dolby Cinema</span>\n                </a>\n            </div>\n                    <div class=\"submenu\">\n                <a href=\"/ecards\" class=\"\">\n                    <span class=\"tagline\">Gift Cards</span>\n                </a>\n            </div>\n                    <div class=\"submenu\">\n                <a href=\"/ticket-info\" class=\"\">\n                    <span class=\"tagline\">Ticket Info</span>\n                </a>\n            </div>\n                    <div class=\"submenu\">\n                <a href=\"/boxes\" class=\"\">\n                    <span class=\"tagline\">Boxes</span>\n                </a>\n            </div>\n                </div>\n    </div>\n    \n</section>\n<style>\n    .cc-account-dropdown .cc-account-menu { display:none; }\n    .cc-account-dropdown:hover .cc-account-menu { display:block; }\n    .cc-account-menu-item { font-size:.8rem; color:#212529; text-decoration:none !important; display:block; }\n    .cc-account-menu-item:hover, .cc-account-menu-item:focus { background-color:#f8f9fa; color:#212529; text-decoration:none !important; }\n</style>\n<script>\ndocument.querySelectorAll('.cc-nav-signout').forEach(function(btn) {\n    btn.addEventListener('click', function() {\n        fetch('/api/account/logout', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ action: 'logout' })\n        })\n        .then(function(r) { return r.ok ? r.json() : null; })\n        .then(function() { window.location.href = '/'; })\n        .catch(function() { window.location.reload(); });\n    });\n});\n</script>\n        <div class=\"cc-banner\" style=\"background:#937251\"><div class=\"cc-banner-desktop d-none d-md-block\"><div class=\"container\"><div class=\"d-flex flex-column align-items-center justify-content-center text-center py-2\"><span class=\"cc-banner-title fjalla-one-regular majortitle text-uppercase\" style=\"color:#ffffff;font-size:14px;letter-spacing:0.05em\">FAMILY FILM SEASON</span><span class=\"cc-banner-tagline\" style=\"color:#ffffff;font-size:11px\">£10 cinema tickets for all children under 14</span></div></div></div><div class=\"cc-banner-mobile d-block d-md-none\"><div class=\"container text-center py-2\"><div class=\"cc-banner-tagline\" style=\"color:#ffffff;font-size:11px\">£10 cinema tickets for all children under 14</div></div></div></div><section id=\"section_2_stack\" class=\"bg-dark p-0 m-0\">        <!-- Page Video Modal -->\n        <div id=\"videoModal\" class=\"modal fade\" data-bs-backdrop=\"static\" data-bs-keyboard=\"false\" tabindex=\"-1\" aria-labelledby=\"videoModalLabel\" aria-hidden=\"true\">\n            <div class=\"modal-dialog modal-dialog-centered modal-lg\">\n                <div class=\"modal-content\">\n                    <div class=\"modal-header justify-content-center position-relative\">\n                        <div class=\"w-100 text-center\">\n                            <h1 class=\"modal-title fs-5\" id=\"modalTrailerLabel\">National Theatre Live: The Misanthrope</h1>\n                        </div>\n                        <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\n                    </div>\n                    <div class=\"modal-body p-1 p-md-2\">\n                        <div class=\"ratio ratio-16x9\">\n                            <iframe class=\"embed-responsive-item\" allowfullscreen allow=\"autoplay\" allowfullscreen=\"true\"></iframe>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- End Page Video Modal -->\n\n            <div class=\"page-header py-5 py-md-0 ratio ratio-2x1 position-relative\">\n        <picture>\n            <source srcset=\"https://m.cinemacloud.co.uk/imageFilm/2421_7_1.jpg\" media=\"(max-width: 767.9px)\">\n            <source srcset=\"https://m.cinemacloud.co.uk/imageFilm/2421_10_1.jpg\" media=\"(min-width: 768px)\">\n            <img src=\"https://m.cinemacloud.co.uk/imageFilm/2421_10_1.jpg\" alt=\"Background\" class=\"film-header-bg w-100 h-100 position-absolute top-0 start-0 object-fit-cover\" onload=\"this.style.opacity=1;\">\n        </picture>\n        <div class=\"position-absolute w-100 w-md-50 h-50 h-md-100 bg-grad-dark\"></div>\n        <div id=\"movie-overlay\" class=\"d-flex flex-column justify-content-end justify-content-md-center align-items-center align-items-md-start h-100 mx-md-5 mx-lg-7\">\n            \n            \n            <img class=\"title-treatment mb-4 mb-md-6 my-3\" src=\"https://m.cinemacloud.co.uk/imageFilm/2421_8_1.png\" alt=\"National Theatre Live: The Misanthrope\" onerror=\"this.style.display='none';this.nextElementSibling.style.display=''\"><div class=\"title-treatment mb-4 mb-md-6 text-white text-left\" style=\"display:none;\"><h1 class=\"h4 text-white fw-semibold\">National Theatre Live: The Misanthrope</h1></div>\n            \n            <div class=\"movie-badges mb-2 d-flex justify-content-start\">\n                <span class=\"badge text-bg-secondary me-2 px-3 fw-semibold\">2026</span><span class=\"badge text-bg-secondary me-2 px-3 fw-semibold\">2hr</span><img src=\"https://m.cinemacloud.co.uk/imageMisc/Dolby/Atmos/Vertical/DLB_Atms_vert_rgb_wht_@1x.png\" class=\"cert-20 me-2\" alt=\"Movie Sound Dolby Atmos\"><img src=\"https://m.cinemacloud.co.uk/bbfc/SVGs/BBFC_15_RGB.svg\" class=\"cert-20\" alt=\"BBFC Cert 15\">\n            </div>\n            \n            <p class=\"text-light fs-6 fw-semibold\"><small>Drama, Comedy</small></p>\n            \n        </div>\n    </div></section><section id=\"section_3_stack\" class=\"bg-white p-0 m-0\">        <div class=\"container my-5\">\n            <div class=\"row\">\n                <!-- Left column: film info -->\n                <div class=\"col-12 col-lg-6 order-1 order-lg-0\">\n                    <h3 class=\"fjalla-one-regular fs-3 text-uppercase text-dark mb-4\">National Theatre Live: The Misanthrope</h3>\n                    <div class=\"d-flex mt-1 mb-4\"><img class=\"flex-shrink-1 cert-40\" src=\"https://m.cinemacloud.co.uk/bbfc/SVGs/BBFC_15_RGB.svg\" alt=\"BBFC Cert\"><small style=\"font-size: 0.7rem;\" class=\"w-100 small ps-2 text-muted fst-italic\">Admission to film screenings is strictly in accordance with BBFC age ratings and valid proof of age may be required as a condition of entry.</small></div>                                        <h3 class=\"fjalla-one-regular fs-4 text-dark mb-4\">Synopsis</h3><div class=\"mb-5 text-dark\">Alice, a brilliant novelist, despises the hollow contemporary mantras of kindness and respect. But the bolder she becomes in speaking out, the more colleagues avoid her, and the more her personal relationships begin to fracture. As she challenges fashionable ideas and lends her voice to causes others are afraid to touch, she faces intense criticism and backlash. Alice will soon learn the price she must pay as an artist and as a woman for daring to speak her mind. Award-winner Sandra Oh is the Misanthrope in Martin Crimp's cutting new version of Molière's dark comedy, directed by National Theatre Director Indhu Rubasingham.</div>                                                            <div class=\"row\">\n                        <div class=\"col-7 col-md-8\">\n                                                                                    <p class=\"mb-1 fw-semibold text-secondary\">Duration:</p><p class=\"mt-0 fw-bolder\">2hr</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Available Sound Formats:</p><p class=\"mt-0 fw-bolder sound-formats\">Dolby Atmos</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Genre:</p><p class=\"mt-0 fw-bolder\">Drama, Comedy</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Country:</p><p class=\"mt-0 fw-bolder\">United Kingdom</p>                        </div>\n                        <div class=\"col-5 col-md-4\">\n                            <p class=\"mb-1 fw-semibold text-secondary\">Director:</p><p class=\"mt-0 fw-bolder\">Indhu Rubasingham</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Starring:</p><p class=\"mt-0 fw-bolder\">Paul Chahidi,<br> Sandra Oh,<br> Poppy Townsend White,<br> Abigail Cruttenden,<br> Imogen Elliott,<br> Rina Fatania,<br> Freddie MacBruce,<br> Tom Mison,<br> Jemima Rooper,<br> Gabby Wong,<br> Scott Sparrow,<br> Amira Matthews,<br> Niamh James,<br> Arthur Blanc,<br> Francesca Fullilove,<br> Teddy Holton-Frances,<br> John Vernon</p>                        </div>\n                    </div>\n                                                            <hr class=\"dark horizontal my-5\">                </div>\n\n                <!-- Right column: sticky showtime panel -->\n                <div class=\"col-12 col-lg-6 ps-lg-5 order-0 order-lg-1\">\n                    <div class=\"d-none d-md-block position-sticky\" style=\"top: 164px\">\n                        <h2 class=\"fs-4 fjalla-one-regular text-dark\">Show Times</h2><p class=\"fs-6\">To book online, please select a time from below:</p><div id=\"showtimes7d\" class=\"d-block\"><h3>Show times in The Arches</h3><p>The following screenings are situated just outside The Power Station, in the Arches under Grosvenor Bridge.</p>        <script>\n            document.addEventListener('DOMContentLoaded', function() {\n                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle=\"tooltip\"]'));\n                tooltipTriggerList.map(function(el) { return new bootstrap.Tooltip(el); });\n                document.querySelectorAll('a.disabled').forEach(function(el) {\n                    el.addEventListener('click', function(e) { e.preventDefault(); });\n                });\n            });\n        </script>\n                    <h4 class=\"fs-6 mb-4 fw-semibold text-muted\">Tuesday, September 22</h4>\n            <div class=\"d-flex flex-wrap text-center mb-4\">\n                                    <a role=\"button\"\n                       class=\"btn btn-arches rounded-1 mb-3 me-3 py-1 py-md-3 px-3 d-flex align-items-center\"\n                                              href=\"https://web2.empire.mycloudcinema.com/#/book/58333\"                        style=\"min-height: 40px;\" >\n                        <div class=\"d-flex align-items-center w-100 justify-content-center\">\n                            <span class=\"btn-times-fs\" style=\"line-height: 1;\">19:30</span>\n                                                        <span class=\"ms-2 opacity-7 d-none\" style=\"line-height: 1;\"></span>\n                                                                                </div>\n                    </a>\n                    <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Event\",\"name\":\"National Theatre Live: The Misanthrope\",\"startDate\":\"2026-09-22T18:30:00.000+00:00\",\"endDate\":\"2026-09-22T20:50:00.000+00:00\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"location\":{\"@type\":\"Place\",\"name\":\"The Cinema in the Arches\",\"address\":{\"@type\":\"PostalAddress\",\"name\":\"The Cinema in the Arches\",\"streetAddress\":\"Circus West, 22 Arches Lane\",\"addressLocality\":\"London\",\"postalCode\":\"SW11 8AB\",\"addressCountry\":\"GB\"}},\"priceRange\":\"£5 - £20\",\"offers\":{\"@type\":\"Offer\",\"url\":\"https://web2.empire.mycloudcinema.com/#/book/58333\",\"priceCurrency\":\"GBP\",\"availability\":\"https://schema.org/InStock\",\"validFrom\":\"2026-07-11T18:08:45+01:00\"},\"inLanguage\":\"en\",\"image\":\"https://m.cinemacloud.co.uk/imageFilm/2421_10_1.jpg\"}</script>            </div>\n            </div>                    </div>\n                    <div class=\"d-block d-md-none\">\n              