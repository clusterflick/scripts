c-banner-tagline\" style=\"color:#ffffff;font-size:11px\">£10 cinema tickets for all children under 14</span></div></div></div><div class=\"cc-banner-mobile d-block d-md-none\"><div class=\"container text-center py-2\"><div class=\"cc-banner-tagline\" style=\"color:#ffffff;font-size:11px\">£10 cinema tickets for all children under 14</div></div></div></div><section id=\"section_2_stack\" class=\"bg-dark p-0 m-0\">        <!-- Page Video Modal -->\n        <div id=\"videoModal\" class=\"modal fade\" data-bs-backdrop=\"static\" data-bs-keyboard=\"false\" tabindex=\"-1\" aria-labelledby=\"videoModalLabel\" aria-hidden=\"true\">\n            <div class=\"modal-dialog modal-dialog-centered modal-lg\">\n                <div class=\"modal-content\">\n                    <div class=\"modal-header justify-content-center position-relative\">\n                        <div class=\"w-100 text-center\">\n                            <h1 class=\"modal-title fs-5\" id=\"modalTrailerLabel\">Obsession </h1>\n                        </div>\n                        <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\n                    </div>\n                    <div class=\"modal-body p-1 p-md-2\">\n                        <div class=\"ratio ratio-16x9\">\n                            <iframe class=\"embed-responsive-item\" allowfullscreen allow=\"autoplay\" allowfullscreen=\"true\"></iframe>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- End Page Video Modal -->\n\n            <div class=\"page-header py-5 py-md-0 ratio ratio-2x1 position-relative\">\n        <picture>\n            <source srcset=\"https://m.cinemacloud.co.uk/imageFilm/2354_7_1.jpg\" media=\"(max-width: 767.9px)\">\n            <source srcset=\"https://m.cinemacloud.co.uk/imageFilm/2354_10_1.jpg\" media=\"(min-width: 768px)\">\n            <img src=\"https://m.cinemacloud.co.uk/imageFilm/2354_10_1.jpg\" alt=\"Background\" class=\"film-header-bg w-100 h-100 position-absolute top-0 start-0 object-fit-cover\" onload=\"this.style.opacity=1;\">\n        </picture>\n        <div class=\"position-absolute w-100 w-md-50 h-50 h-md-100 bg-grad-dark\"></div>\n        <div id=\"movie-overlay\" class=\"d-flex flex-column justify-content-end justify-content-md-center align-items-center align-items-md-start h-100 mx-md-5 mx-lg-7\">\n            \n            \n            <img class=\"title-treatment mb-4 mb-md-6 my-3\" src=\"https://m.cinemacloud.co.uk/imageFilm/2354_8_1.png\" alt=\"Obsession \" onerror=\"this.style.display='none';this.nextElementSibling.style.display=''\"><div class=\"title-treatment mb-4 mb-md-6 text-white text-left\" style=\"display:none;\"><h1 class=\"h4 text-white fw-semibold\">Obsession </h1></div>\n            \n            <div class=\"movie-badges mb-2 d-flex justify-content-start\">\n                <span class=\"badge text-bg-secondary me-2 px-3 fw-semibold\">2026</span><span class=\"badge text-bg-secondary me-2 px-3 fw-semibold\">1hr 49mins</span><img src=\"https://m.cinemacloud.co.uk/imageMisc/Dolby/Atmos/Vertical/DLB_Atms_vert_rgb_wht_@1x.png\" class=\"cert-20 me-2\" alt=\"Movie Sound Dolby Atmos\"><img src=\"https://m.cinemacloud.co.uk/bbfc/SVGs/BBFC_18_RGB.svg\" class=\"cert-20\" alt=\"BBFC Cert 18\">\n            </div>\n            \n            <p class=\"text-light fs-6 fw-semibold\"><small>Horror</small></p>\n                        <div id=\"trailer-button\" class=\"d-none d-md-block me-md-auto mb-3\">\n                <a href=\"#\" class=\"btn btn-md rounded-pill d-inline-flex align-items-center blurred-button\"\n                   data-bs-toggle=\"modal\" data-bs-target=\"#videoModal\"\n                   data-video=\"https://www.youtube.com/embed/0G5CjgPw1x4?autoplay=1&origin=\">\n                    <i class=\"bi bi-play-fill fs-5 me-2\"></i>\n                    <span class=\"fs-6\">Trailer</span>\n                </a>\n            </div>\n            <script>\n                document.addEventListener('DOMContentLoaded', function() {\n                    const videoModal = document.getElementById('videoModal');\n                    const modalIframe = videoModal.querySelector('iframe');\n                    videoModal.addEventListener('show.bs.modal', function(event) {\n                        const button = event.relatedTarget;\n                        const url = button.getAttribute('data-video');\n                        modalIframe.setAttribute('src', url);\n                        modalIframe.setAttribute('allow', 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture');\n                    });\n                    videoModal.addEventListener('hidden.bs.modal', function() {\n                        modalIframe.removeAttribute('src');\n                        modalIframe.removeAttribute('allow');\n                    });\n                });\n            </script>\n            \n        </div>\n    </div></section><section id=\"section_3_stack\" class=\"bg-white p-0 m-0\">        <div class=\"container my-5\">\n            <div class=\"row\">\n                <!-- Left column: film info -->\n                <div class=\"col-12 col-lg-6 order-1 order-lg-0\">\n                    <h3 class=\"fjalla-one-regular fs-3 text-uppercase text-dark mb-4\">Obsession </h3>\n                    <div class=\"d-flex mt-1 mb-4\"><img class=\"flex-shrink-1 cert-40\" src=\"https://m.cinemacloud.co.uk/bbfc/SVGs/BBFC_18_RGB.svg\" alt=\"BBFC Cert\"><small style=\"font-size: 0.7rem;\" class=\"w-100 small ps-2 text-muted fst-italic\">Admission to film screenings is strictly in accordance with BBFC age ratings and valid proof of age may be required as a condition of entry.</small></div>                    <div id=\"trailer-button\" class=\"d-block d-md-none me-md-auto mt-0 mb-4\"><a href=\"#\" class=\"btn btn-white btn-sm btn-lg-md rounded-1\" data-bs-toggle=\"modal\" data-bs-target=\"#videoModal\" data-video=\"https://www.youtube.com/embed/0G5CjgPw1x4?autoplay=1\">Watch Trailer</a></div>                    <h3 class=\"fjalla-one-regular fs-4 text-dark mb-4\">Synopsis</h3><div class=\"mb-5 text-dark\">After breaking the mysterious 'One Wish Willow' to win his crush's heart, a hopeless romantic finds himself getting exactly what he asked for but soon discovers that some desires come at a dark, sinister price.</div>                                                            <div class=\"row\">\n                        <div class=\"col-7 col-md-8\">\n                                                                                    <p class=\"mb-1 fw-semibold text-secondary\">Duration:</p><p class=\"mt-0 fw-bolder\">1hr 49mins</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Available Sound Formats:</p><p class=\"mt-0 fw-bolder sound-formats\">Dolby Atmos</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Genre:</p><p class=\"mt-0 fw-bolder\">Horror</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Country:</p><p class=\"mt-0 fw-bolder\">United Kingdom, United States</p>                        </div>\n                        <div class=\"col-5 col-md-4\">\n                            <p class=\"mb-1 fw-semibold text-secondary\">Director:</p><p class=\"mt-0 fw-bolder\">Curry Barker</p>                            <p class=\"mb-1 fw-semibold text-secondary\">Starring:</p><p class=\"mt-0 fw-bolder\">Andy Richter,<br> Matthew Jackson,<br> Cooper Tomlinson,<br> Jeff Barker,<br> Michael Johnston,<br> Inde Navarrette,<br> Megan Lawless,<br> Haley Fitzgerald,<br> Darin Toonder,<br> Anthony Pavone,<br> Justice,<br> Anthony Casabianca,<br> Chloe Breen,<br> Malcolm Kelner,<br> Travis Beck,<br> Kyle Blumenthal,<br> Danielle Krett</p>                        </div>\n                    </div>\n                                                            <hr class=\"dark horizontal my-5\"><figure class=\"mb-5\"><div class=\"d-block mb-2\"><div class=\"d-flex align-items-center\"><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i></div></div><blockquote class=\"blockquote text-dark mb-2\"><p>\"A comedically gruesome take on love’s maddening effects-  Obsession is so fresh and exhilarating\"</p></blockquote><figcaption class=\"blockquote-footer mt-1\">Lou Thomas , Empire</figcaption></figure><figure class=\"mb-5\"><div class=\"d-block mb-2\"><div class=\"d-flex align-items-center\"><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i><i class=\"bi bi-star-fill text-warning me-1 fs-5\"></i></div></div><blockquote class=\"blockquote text-dark mb-2\"><p>\"Obsession is delicately handled work, unafraid to find pockets of humour.\"</p></blockquote><figcaption class=\"blockquote-footer mt-1\">Clarisse Loughrey, The Independent</figcaption></figure>                </div>\n\n                <!-- Right column: sticky showtime panel -->\n                <div class=\"col-12 col-lg-6 ps-lg-5 order-0 order-lg-1\">\n                    <div class=\"d-none d-md-block position-sticky\" style=\"top: 164px\">\n                        <h2 class=\"fs-4 fjalla-one-regular text-dark\">Show Times</h2><p class=\"fs-6\">To book online, please select a time from below:</p><p class=\"mb-4\">First select a cinema location from below and then select the time:</p>                <div id=\"location-buttons\" class=\"row row-cols-2 g-2 mb-4\">\n                                        <div class=\"col\">\n                        <a role=\"button\" data-subsite=\"6\" class=\"select-subsite text-decoration-none\">\n                            <div class=\"card h-100 bg-power\">\n                                <img src=\"/assets/images/ps-inside.jpg\" class=\"card-img-top image-highlight\" alt=\"...\">\n                                <div class=\"card-footer text-center p-2 pb-0\">\n                                    <p class=\"d-none d-lg-block text-white text-spacing-2 text-uppercase homepage-small mb-2\">The Cinema in The Power Station</p>\n                                    <p class=\"d-block d-lg-none text-white text-spacing-2 text-uppercase homepage-small mb-2\">The Cinema in The Power Station</p>\n                                </div>\n                            </div>\n                        </a>\n                        <style>.image-highlight:hover{filter:brightness(1.3);transition:filter 0.3s ease}.image-highlight{transition:filter 0.3s ease}</style>\n                    </div>\n                                                            <div class=\"col\">\n                        <a role=\"button\" data-subsite=\"7\" class=\"select-subsite text-decoration-none\">\n                            <div class=\"card h-100 bg-arches\">\n                                <img src=\"/assets/images/ps-outside.jpg\" class=\"card-img-top image-highlight\" alt=\"...\">\n                                <div class=\"card-footer text-center p-2 pb-0\">\n                                    <p class=\"d-none d-lg-block text-white text-spacing-2 text-uppercase homepage-small mb-2\">The Cinema in The Arches</p>\n                                    <p class=\"d-block d-lg-none text-white text-spacing-2 text-uppercase homepage-small mb-2\">The Cinema in The Arches</p>\n                                </div>\n                            </div>\n                        </a>\n                    </div>\n                                    </div>\n                <script>\n                    document.addEventListener(\"DOMContentLoaded\", function () {\n                        var buttons = document.querySelectorAll(\".select-subsite\");\n                        var showtimes6 = document.getElementById(\"showtimes6d\");\n                        var showtimes7 = document.getElementById(\"showtimes7d\");\n                        buttons.forEach(function(button) {\n                            button.addEventListener(\"click\", function () {\n                                var subsite = this.getAttribute(\"data-subsite\");\n                                if (subsite === \"6\") {\n                                    showtimes6.classList.remove(\"d-none\");\n                                    showtimes6.classList.add(\"d-block\");\n                                    showtimes7.classList.remove(\"d-block\");\n                                    showtimes7.classList.add(\"d-none\");\n                                } else if (subsite === \"7\") {\n                                    showtimes7.classList.remove(\"d-none\");\n                                    showtimes7.classList.add(\"d-block\");\n                                    showtimes6.classList.remove(\"d-block\");\n                                    showtimes6.classList.add(\"d-none\");\n                                }\n                                fetch(\"/api/session/select-subsite\", {\n                                    method: \"POST\",\n                                    headers: {\n                                        \"X-Requested-With\": \"XMLHttpRequest\",\n                                        \"Content-Type\": \"application/x-www-form-urlencoded\"\n                                    },\n                                    body: \"subsite=\" + encodeURIComponent(subsite)\n                                })\n                                .then(function(r) { return r.json(); })\n                                .then(function(data) { if (!data.success) { console.error(\"Error:\", data.message); } })\n                                .catch(function(err) { console.error(\"Request failed:\", err); });\n                            });\n                        });\n                    });\n                </script>\n                <div id=\"showtimes6d\" class=\"d-none\"><h3>Show times in The Power Station</h3><p>These screenings are located on 3rd Floor, Turbine Hall B, Battersea Power Station.</p>        <script>\n            document.addEventListener('DOMContentLoaded', function() {\n                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle=\"tooltip\"]'));\n                tooltipTriggerList.map(function(el) { return new bootstrap.Tooltip(el); });\n                document.querySelectorAll('a.disabled').forEach(function(el) {\n                    el.addEventListener('click', function(e) { e.preventDefault(); });\n                });\n            });\n        </script>\n                    <h4 class=\"fs-6 mb-4 fw-semibold text-muted\">Today - Saturday, July 11</h4>\n            <div class=\"d-flex flex-wrap text-center mb-4\">\n                                    <a role=\"button\"\n                       class=\"btn btn-power rounded-1 mb-3 me-3 py-1 py-md-3 px-3 d-flex align-items-center\"\n                                              href=\"https://web2.empire.mycloudcinema.com/#/book/58231\"                        style=\"min-height: 40px;\" >\n                        <div class=\"d-flex align-items-center w-100 justify-content-center\">\n                            <span class=\"btn-times-fs\" style=\"line-height: 1;\">20:30</span>\n                                                        <span class=\"ms-2 opacity-7 d-none\" style=\"line-height: 1;\"></span>\n                                                                                </div>\n                    </a>\n                    <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Event\",\"name\":\"Obsession \",\"startDate\":\"2026-07-11T19:30:00.000+00:00\",\"endDate\":\"2026-07-11T21:44:00.000+00:00\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAtten