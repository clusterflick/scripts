f3166972-61d5-42ce-a01d-dc8b73ca8e9f/IMG_6897.jpg\",\"name\":\"IMG_6897.jpg\",\"size\":125341,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":1080,\"height\":1350}},{\"id\":\"bc116c8f-6618-4720-b527-af91a13d01d2\",\"name\":\"Crispmas Dinner - Beer & Crisp Tasting\",\"start\":{\"type\":\"datetime\",\"date\":\"2025-12-10\",\"time\":\"19:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2025-12-10\",\"time\":\"21:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div><span>Even the Christmas dinner isn’t safe from Big Crisp™️. Our in-house crisp sommelier Chloe will ride the aisles to find the most festive of crisps, pairing each one with a PDBC beer. Expect a highly unserious but very merry time featuring 5 x 1/3 pours plus snacks.</span></div><br><div><strong>Date: </strong>Wednesday 10th December<br><strong>Time:</strong> 7pm<br><strong>Location: </strong>Victoria Park taproom (<span><em>Unit GF1, Bow Wharf, 221 Grove Rd., Old Ford, London E3 5SN)</em></span></div><br><div>Your email confirmation is your ticket.</div>\",\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[{\"tagName\":\"£25pp\",\"id\":\"740c36a1-0d66-4a01-9c84-12114c6818dc\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"exceptions\":[],\"actions\":[{\"id\":\"db04401a75dc4\",\"type\":\"link\",\"text\":\"Get Tickets\",\"link\":{\"rawValue\":\"https://prettydecentbeer.co/products/crispmas-dinner-beer-crisp-tasting?variant=56008914043266\",\"value\":\"https://prettydecentbeer.co/products/crispmas-dinner-beer-crisp-tasting?variant=56008914043266\",\"type\":\"url\",\"target\":\"_blank\"},\"primary\":true}],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/b1a03d5a-4ff9-48f0-bbad-de7c8b37491f/VP-Crispmas-poster_v1.jpg\",\"name\":\"VP-Crispmas-poster_v1.jpg\",\"size\":608972,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":1754,\"height\":2481}},{\"id\":\"0ba25e3a-9ff2-4655-ac8b-8c2c37a2279c\",\"name\":\"Wreath Making Workshop\",\"start\":{\"type\":\"datetime\",\"date\":\"2025-12-07\",\"time\":\"13:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2025-12-07\",\"time\":\"15:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>🎄 <strong>Get Creative This Christmas!</strong> 🎄</div><br><div>Join us for a festive <strong>Wreath Making Workshop</strong> at <em>the best gaff in town</em> — <strong>Victoria Park - Pretty Decent Beer Co.</strong></div><br><div>Settle into a cosy and intimate afternoon surrounded by good vibes, great beer, and plenty of Christmas cheer. You’ll create your own one-of-a-kind wreath using a gorgeous mix of <strong>seasonal foliage and decorative touches</strong> — think pine cones, berried ivy, dried oranges, hydrangeas, and your choice of ribbon.</div><br><div>Of course, it wouldn’t be Christmas without a little tipple — enjoy a <strong>pint (or two!) of Pretty Decent’s finest</strong> as you craft your masterpiece.</div><br><div>We’ll provide all the materials (and a few festive treats), so just bring yourself, your creativity, and your holiday spirit!</div><br><div></div>\",\"eventType\":[\"c69f13eb-2f51-44ee-9f82-a1f24a3d0472\"],\"location\":[\"51079595-090b-4b24-a4d3-a7b4b1330217\"],\"host\":[],\"tags\":[{\"tagName\":\"£50pp\",\"id\":\"22baac06-a2f3-461b-bb7e-dbe56022617f\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"exceptions\":[],\"actions\":[{\"id\":\"cb610961ba051\",\"type\":\"link\",\"text\":\"Get Tickets\",\"link\":{\"rawValue\":\"https://www.tickettailor.com/events/maggiesnorm/1931800\",\"value\":\"https://www.tickettailor.com/events/maggiesnorm/1931800\",\"type\":\"url\",\"target\":\"_blank\"},\"primary\":true}],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/7c205808-4003-43fe-b807-848a340d4655/UPDATED-XMAS.png\",\"name\":\"UPDATED XMAS.png\",\"size\":1722954,\"type\":\"image/png\",\"extension\":\"png\",\"width\":1080,\"height\":1350}},{\"id\":\"7e0d4200-fce9-4992-a5b7-714db7c44a60\",\"name\":\"Blackhorse Beer Mile Christmas Party\",\"start\":{\"type\":\"datetime\",\"date\":\"2025-12-06\",\"time\":\"12:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2025-12-06\",\"time\":\"23:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>Blackhorse Beer Mile: Christmas Edition!</div><br><div>It’s the unofficial start of the festive season, and so start as you mean to go on. More details to follow but it’ll pretty much be beer, beer, and probably, more beer. Or wine and cocktails if thats more your thing. </div>\",\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[{\"id\":\"dc4cc653-0d33-4596-9594-9a909b25ebc7\",\"tagName\":\"Free entry\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"exceptions\":[],\"actions\":[{\"id\":\"1a11d214e926d\",\"type\":\"link\",\"text\":\"Book a table\",\"link\":{\"rawValue\":\"https://bookings.designmynight.com/book?venue_id=66017f5ae5c3ac093463ea2d&source=partner\",\"value\":\"https://bookings.designmynight.com/book?venue_id=66017f5ae5c3ac093463ea2d&source=partner\",\"type\":\"url\",\"target\":\"_blank\"},\"primary\":true}],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/b6f121d2-b15c-48e4-ae37-205d6548b861/BBM-Christmas-2025-socials.jpg\",\"name\":\"BBM Christmas 2025 socials.jpg\",\"size\":1656778,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":2250,\"height\":3000}},{\"id\":\"abb515bb-873a-42bf-ab45-1b93db46f20c\",\"name\":\"Run Club\",\"start\":{\"type\":\"datetime\",\"date\":\"2025-10-04\",\"time\":\"12:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2025-10-04\",\"time\":\"14:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"custom\",\"repeatFrequency\":\"monthly\",\"repeatInterval\":1,\"repeatEnds\":\"onDate\",\"repeatEndsDate\":{\"type\":\"datetime\",\"date\":\"2025-12-06\",\"time\":\"12:00\"},\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"nthDay\",\"description\":\"<div>A 5km(ish) run around the park setting off from the taproom around 7pm and finishing back there for a free pint.</div><br><div>All abilities welcome, even if you're a newbie!</div><br><div>Bag drop available.</div>\",\"eventType\":[\"c69f13eb-2f51-44ee-9f82-a1f24a3d0472\"],\"location\":[\"51079595-090b-4b24-a4d3-a7b4b1330217\"],\"host\":[],\"tags\":[{\"tagName\":\"Free entry\",\"id\":\"08bd5328-2c12-41d1-b540-3a86d3a25cc6\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"repeatWeeklyOnDays\":[\"sa\"],\"exceptions\":[],\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/79b48646-7b13-43a4-b50c-781cf26f1035/PDBC_RunningClub-SQ.jpg\",\"name\":\"PDBC_RunningClub-SQ.jpg\",\"size\":468627,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":2000,\"height\":2000}},{\"id\":\"c859d2f2-9c5c-4be2-8471-ff1365b878ac\",\"name\":\"LAST KARAOKE AT VICCY PARK\",\"start\":{\"type\":\"datetime\",\"date\":\"2025-12-05\",\"time\":\"21:30\"},\"end\":{\"type\":\"datetime\",\"date\":\"2025-12-05\",\"time\":\"21:30\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>The last karaoke before Sam heads off to travel the world (sob).</div><br><div>As a wise elf once said: \\\"the best way to spread Christmas cheer is singing loud for all to hear\\\". So that's exactly what we'll be doing on 5th Dec! </div><br><div>Pick your fave festive tune and belt it loud (non xmas songs also allowed).</div><br><div>Starts at 9.30pm, shot of tequila for those who sing.</div><br><div>Xmas party dress encouraged but not mandatory.</div>\",\"eventType\":[\"c69f13eb-2f51-44ee-9f82-a1f24a3d0472\"],\"location\":[\"51079595-090b-4b24-a4d3-a7b4b1330217\"],\"host\":[],\"tags\":[{\"tagName\":\"Free entry\",\"id\":\"61f3be94-5cd7-47ca-8ab1-697d761e352b\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"exceptions\":[],\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/8a0c0a2b-6936-4b33-9363-b68a77575154/karaoke-sqaure.png\",\"name\":\"karaoke sqaure.png\",\"size\":942487,\"type\":\"image/png\",\"extension\":\"png\",\"width\":1080,\"height\":1080}},{\"id\":\"6c99f9df-95be-404e-8cf9-67681b1d54f6\",\"name\":\"Christmas Carols with Sing17\",\"start\":{\"type\":\"datetime\",\"date\":\"2025-12-05\",\"time\":\"19:30\"},\"end\":{\"type\":\"datetime\",\"date\":\"2025-12-05\",\"time\":\"20:30\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>Local Walthamstow Choir Sing17 will be at the brewery busting out all the festive bangers. We'll have Mulled Wine, Stout Hot Choccies and Hot Pizzas! </div><br><div></div><br><div>Free to attend.</div>\",\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[{\"tagName\":\"Free entry\",\"id\":\"735f8737-20f3-48af-966c-99905456c135\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"exceptions\":[],\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/80ab7c1d-495e-4388-8ece-8cde9dd76ca8/BHR-carols-1-.png\",\"name\":\"BHR carols (1).png\",\"size\":1295984,\"type\":\"image/png\",\"extension\":\"png\",\"width\":1080,\"height\":1350}},{\"id\":\"f3e69d07-e5ce-4be2-892c-813bbe4b3e5a\",\"name\":\"Run Club\",\"start\":{\"type\":\"datetime\",\"date\":\"2025-09-27\",\"time\":\"12:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2025-09-27\",\"time\":\"14:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"custom\",\"repeatFrequency\":\"monthly\",\"repeatInterval\":1,\"repeatEnds\":\"onDate\",\"repeatEndsDate\":{\"type\":\"datetime\",\"date\":\"2025-11-29\",\"time\":\"12:00\"},\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"lastDay\",\"description\":\"<div>A 5km(ish) run setting off from the brewery around 7pm and finishing back there for a free pint. </div><br><div>All abilities welcome, even if you're a newbie!</div><br><div>Bag drop available.</div>\",\"eventType\":[\"68c11ec0-281a-4735-9862-06e09c717587\"],\"location\":[\"d4db9d7b-4c96-46e5-b884-81d94ce2c9f7\"],\"host\":[],\"tags\":[{\"id\":\"81e9225d-7a1f-4bc0-8cb9-28e61b2adba7\",\"tagName\":\"Free entry\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"repeatWeeklyOnDays\":[\"sa\"],\"exceptions\":[],\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/2d64c9f0-f19a-4dca-9a8e-2a501abfa798/PDBC_RunningClub-SQ.jpg\",\"name\":\"PDBC_RunningClub-SQ.jpg\",\"size\":468627,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":2000,\"height\":2000}},{\"id\":\"43091614-14a6-4dad-91fe-8fe4d616d0d7\",\"name\":\"Victoria Park's 1st Birthday! \",\"start\":{\"type\":\"datetime\",\"date\":\"2025-11-28\",\"time\":\"18:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2025-11-28\",\"time\":\"23:59\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>It's been one whole year since we opened our taproom on the edge of Viccy Park!<br><br>From 6pm it'll be classic birthday party energy with hats, cake, games, party tunes, the lot. There’ll be a raffle with merch and beer cans up for grabs, plus a FREE PINT for the first 50 people through the door.<br><br>You could also win FREE BEER FOR A WHOLE YEAR which feels like the sort of thing Future You will really appreciate so probably worth sticking around for!<br><br>Hopefully see you there! x</div><br><div><span>22 h</span></div>\",\"eventType\":[\"c69f13eb-2f51-44ee-9f82-a1f24a3d0472\"],\"location\":[\"51079595-090b-4b24-a4d3-a7b4b1330217\"],\"host\":[],\"tags\":[{\"tagName\":\"Free entry\",\"id\":\"3a131964-56c6-4359-ade5-414dc7f90fd9\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"exceptions\":[],\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/414111a2-d048-4297-b031-bc141b8fad40/VP-birthday.png\",\"name\":\"VP birthday.png\",\"size\":1758872,\"type\":\"image/png\",\"extension\":\"png\",\"width\":1080,\"height\":1350}},{\"id\":\"75be8b91-2d10-4396-a622-853035ed53bf\",\"name\":\"Quiz\",\"start\":{\"type\":\"datetime\",\"date\":\"2025-09-24\",\"time\":\"19:30\"},\"end\":{\"type\":\"datetime\",\"date\":\"2025-09-24\",\"time\":\"22:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"custom\",\"repeatFrequency\":\"monthly\",\"repeatInterval\":1,\"repeatEnds\":\"onDate\",\"repeatEndsDate\":{\"type\":\"datetime\",\"date\":\"2025-11-26\",\"time\":