"tagName\":\"Free\"}],\"color\":\"transparent\",\"actions\":[],\"actionsCaption\":\"\",\"video\":null,\"file\":null,\"isAllDay\":false},{\"id\":\"351a2667-49b8-4881-8815-9c0a4e93bad1\",\"name\":\"Sunday Movie Club - All Taprooms\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-12-20\",\"time\":\"18:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-12-20\",\"time\":\"20:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatWeeklyOnDays\":[\"su\"],\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"exceptions\":[],\"description\":\"<div>Every Sunday we show a film at all taprooms from 6-8pm. Usual drinks and pizzas available, plus hot drinks and mulled wine.</div><br><div>This is what's showing:</div><br><div>Blackhorse Road: The Christmas Chronicles</div><br><div>Forest Gate: Elf</div><br><div>Victoria Park: Home Alone</div>\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/a3e9e469-703d-4753-bfae-f82b2bba5f22/alex-litvin-MAYsdoYpGuk-unsplash.jpg\",\"name\":\"alex-litvin-MAYsdoYpGuk-unsplash.jpg\",\"size\":3326764,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":5472,\"height\":3648,\"meta\":{\"width\":5472,\"height\":3648}},\"eventType\":[],\"location\":[],\"host\":[],\"tags\":[{\"id\":\"53e2865d-0938-47e1-940d-9d54c3f7787f\",\"tagName\":\"Free\"}],\"color\":\"transparent\",\"actions\":[],\"actionsCaption\":\"\",\"video\":null,\"file\":null,\"isAllDay\":false},{\"id\":\"a7d5e3b5-2052-45e2-bb5a-216569db3e59\",\"name\":\"Blackhorse Beer Mile: HarvestFest\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-10-10\",\"time\":\"12:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-10-10\",\"time\":\"23:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatWeeklyOnDays\":[],\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"exceptions\":[],\"description\":\"<div>Saddle up, ducky, It's Beer Mile time!</div><br><div>Expect big country bangers, Hook-a-Duck for prizes and the Duck Hut Saloon Bar. We'll be serving picklebacks, lageritas and mulled stout hot chocolates all day.</div><br><div>Plus, it's the return of our seasonal Duck Trio – Le Duck, La Duck and Les Ducks – showcasing this year's New Zealand hop harvest with two single-hop pale ales and a NEIPA that brings both hops together.</div><br><div>A FREE all day event at the Blackhorse Road taproom. Collect stamps at participating venues and receive a free beer glass.</div>\",\"images\":[{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/e079527c-fefc-4737-9114-088d4acbd75b/BBM-Harvestfest-beer-06.jpg\",\"alt\":\"BBM-Harvestfest-beer-06.jpg\",\"id\":\"4b2dc01b-10b3-4bd5-a3f2-3255952075ef\"}],\"coverImage\":null,\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[{\"tagName\":\"Free\",\"id\":\"6796678b-30f9-4e34-a16a-6811b961d1a3\"}],\"color\":\"rgb(209, 175, 255)\",\"actions\":[],\"actionsCaption\":\"\",\"video\":null,\"file\":null,\"isAllDay\":true},{\"id\":\"8a487e71-95ad-48a9-9824-c3052c499162\",\"name\":\"Forestober Fest\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-09-24\",\"time\":\"16:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-09-24\",\"time\":\"23:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatWeeklyOnDays\":[],\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"exceptions\":[],\"description\":\"<div><span>Oktoberfest is round the corner, which means it’s time for us to saddle up the ol’ bandwagon and get ready for the annual release of Forestgatebier - our hyper-local, not-so-traditional Fest(ish)bier.</span><br><br><span>Back for V6, this year’s hazy pale has a brand new hop bill featuring Idaho 7 Cryo, Idaho 7 CGX, Citra and Nectaron, while the label gets an updated hand-drawn map of the Forest Gate area by our in-house illustrator, Nanna Koekoek.</span><br><br><span>Join us at the Forest Gate tappy from 4pm on 24th September to toast the return of Forestgatebier with £4.50 pints, a pizza special from Papi's Munchies and some suitably fest-y tunes!</span></div>\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/b3183169-d0d8-44c3-867c-026d97e03127/Forestgatebier-Assets-1-.png\",\"name\":\"Forestgatebier Assets (1).png\",\"size\":5781944,\"type\":\"image/png\",\"extension\":\"png\",\"width\":2298,\"height\":3250,\"meta\":{\"width\":2298,\"height\":3250}},\"eventType\":[\"68c11ec0-281a-4735-9862-06e09c717587\"],\"location\":[\"d4db9d7b-4c96-46e5-b884-81d94ce2c9f7\"],\"host\":[],\"tags\":[{\"tagName\":\"Free\",\"id\":\"95b23e84-180e-421e-853c-d91bfd7b2222\"}],\"color\":\"rgb(15, 87, 28)\",\"actions\":[],\"actionsCaption\":\"\",\"video\":null,\"file\":null,\"isAllDay\":false},{\"id\":\"1d7482ba-b3ce-4c2f-b53f-69938e276f52\",\"name\":\"Papi's Munchies Pizza Party\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-09-18\",\"time\":\"16:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-09-18\",\"time\":\"21:30\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatWeeklyOnDays\":[],\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"exceptions\":[],\"description\":\"<div><span>Join us to celebrate our good pals Papi’s first day slinging pizzas at our Victoria Park taproom.</span><br><br><span>Pizzas will be just £6 from 4-9.30pm so swing for dinner and a pint and see why we love them so much!</span><br><br><span>Walk ins welcome or you can book a table </span><a target=\\\"_blank\\\" href=\\\"https://bookings.designmynight.com/book?venue_id=674dbac16a928163e9348b79&amp;source=partner\\\"><span>here.</span></a></div>\",\"images\":[{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/39d13ebf-6e59-44a6-ad64-9c8f2ae1bb67/used-3-1-.jpg\",\"alt\":\"used-3-1-.jpg\",\"id\":\"99427a0c-ff1e-4637-87d5-f5a2fa8d755e\"}],\"coverImage\":null,\"eventType\":[\"c69f13eb-2f51-44ee-9f82-a1f24a3d0472\"],\"location\":[\"51079595-090b-4b24-a4d3-a7b4b1330217\"],\"host\":[],\"tags\":[{\"tagName\":\"Free\",\"id\":\"9daac638-4a12-4e55-a9ac-3ee19f7d6b14\"}],\"color\":\"rgb(6, 139, 136)\",\"actions\":[],\"actionsCaption\":\"\",\"video\":null,\"file\":null,\"isAllDay\":false},{\"id\":\"788ad4fb-a315-497f-a093-8e4ba2bf6b4c\",\"name\":\"Locals Day\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-09-16\",\"time\":\"16:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-09-16\",\"time\":\"16:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatWeeklyOnDays\":[],\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"exceptions\":[],\"description\":\"<div>It’s that time again when you can get your hands on one of our nifty Locals Card keyrings!<br><br>On 16th September, swing by your local tappy anytime from 4pm–close and secure yourself a sweet 10% discount for life*.<br><br>How do you qualify for a Locals Card, we hear you ask? Being local is a state of mind. If you feel local and reckon you’ll get some use out of a discount card, that’s good enough for us! No need to tell us your postcode or whip out a council tax bill ✌🏻<br><br>*10% discount can’t be used alongside other discounts and some exclusions apply. Limited cards available – only available on the 16th and once they’re gone, they’re gone!</div><br><div><span>1 w</span></div>\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/ac8c0b86-47a9-442b-bc28-2561fd951501/LocalsDay-Instagram-Post-45-.png\",\"name\":\"LocalsDay (Instagram Post (45)).png\",\"size\":714419,\"type\":\"image/png\",\"extension\":\"png\",\"width\":1080,\"height\":1350,\"meta\":{\"width\":1080,\"height\":1350}},\"eventType\":[],\"location\":[\"51079595-090b-4b24-a4d3-a7b4b1330217\",\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\",\"d4db9d7b-4c96-46e5-b884-81d94ce2c9f7\"],\"host\":[],\"tags\":[{\"tagName\":\"Free\",\"id\":\"3235c1df-ac8e-428e-be31-0c3947c708f8\"}],\"color\":\"rgb(15, 87, 28)\",\"actions\":[],\"actionsCaption\":\"\",\"video\":null,\"file\":null,\"isAllDay\":false},{\"id\":\"9fa1e90f-351e-41d2-bbdb-b8e89820e258\",\"name\":\"World Cup Semi Finals - England vs Argentina\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-07-15\",\"time\":\"20:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-07-15\",\"time\":\"23:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatWeeklyOnDays\":[],\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"exceptions\":[],\"description\":\"<div>We’re showing the Semi Final England game across all taprooms this Wednesday:<br><br>🧲 Blackhorse Road<br>Tickets have now sold out. We will gauge walk-ins once all booking have arrived. <br><br>🌳 Victoria Park &amp; Forest Gate<br><a target=\\\"_blank\\\" href=\\\"https://prettydecentbeer.co/pages/taprooms\\\">Table bookings are now open</a>. We recommend booking ahead to guarantee your spot, but there will be walk-in space on the day too. Any remaining seats that aren’t booked will be available on a first come, first served basis.<br><br>Book your local via the link in our bio.</div><br><div><span>1d</span></div>\",\"images\":[{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/2c9ea1e5-5086-4eb6-83d7-6d217d3f9215/Blackhorse_ENG_vs_SVN-111-Chris_Coulson.jpg\",\"alt\":\"Blackhorse_ENG_vs_SVN-111-Chris_Coulson.jpg\",\"id\":\"c239f8cc-4c1e-486e-819e-93c54f3a7d90\"}],\"coverImage\":null,\"eventType\":[],\"location\":[],\"host\":[],\"tags\":[],\"color\":\"transparent\",\"actions\":[],\"actionsCaption\":\"\",\"video\":null,\"file\":null,\"isAllDay\":false},{\"id\":\"eaef4099-4678-42fd-a871-335d8c6637f2\",\"name\":\"World Cup: England vs Panama\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-06-27\",\"time\":\"19:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-06-27\",\"time\":\"19:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"exceptions\":[],\"description\":\"<div>Kick off 10pm.<br><br>Tickets are £6- that gets you entry and your first pint.<br><br>Catch the England games on our 120” screen at Blackhorse Road. Expect 20 taps of beer brewed onsite, plus wines, cocktails and frozen slushies. Pizzas from It’s Not Big Dough will be on, and we’ve heard whispers of some footie specials too.<br><br>Seats are first come, first served, and this ticket does not guarantee a seat or table - we’d recommend arriving early.<br><br>If you have a table booking earlier in the day, it will be valid until 6pm. After that, you’ll be asked to move to a shared bench for the game.</div><br><div><em>This is for our Blackhorse Road taproom at:<br>Unit 10 Uplands Business Park<br>Blackhorse Ln<br>E17 5QJ</em></div>\",\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[{\"id\":\"21774452-a9a1-4300-b400-874f156443a1\",\"tagName\":\"\"}],\"color\":\"rgb(141, 56, 255)\",\"video\":null,\"file\":null,\"actions\":[{\"id\":\"7423958b1f992\",\"type\":\"link\",\"text\":\"Get Tickets\",\"link\":{\"rawValue\":\"https://prettydecentbeer.co/products/world-cup-england-vs-ghan