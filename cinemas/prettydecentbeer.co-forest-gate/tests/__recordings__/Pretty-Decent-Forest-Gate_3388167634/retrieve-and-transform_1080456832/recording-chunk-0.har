,\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[],\"color\":\"rgb(141, 56, 255)\",\"video\":null,\"file\":null,\"actions\":[{\"id\":\"ad358aae59c\",\"type\":\"link\",\"text\":\"Get Tickets\",\"link\":{\"rawValue\":\"https://prettydecentbeer.co/products/world-cup-england-vs-croatia?variant=56504678416770\",\"value\":\"https://prettydecentbeer.co/products/world-cup-england-vs-croatia?variant=56504678416770\",\"type\":\"url\",\"target\":\"_blank\"},\"primary\":true}],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/54ee32e5-01db-458b-b85a-31d67e9fb26c/1.png\",\"name\":\"1.png\",\"size\":928240,\"type\":\"image/png\",\"extension\":\"png\",\"width\":1080,\"height\":1350}},{\"id\":\"0f259fcd-ff6f-4772-a019-8b7caaabe31e\",\"name\":\"Rustie's (Sheridan) Rodeo! - 9th Birthday\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-05-24\",\"time\":\"13:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-05-24\",\"time\":\"21:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatWeeklyOnDays\":[],\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"exceptions\":[],\"description\":\"<div><span>Back where it all started 🥲 We wouldn’t be here without the FG community, so come down and celebrate with us at the OG tappy!</span></div><br><div><span>We’re throwing it back to the year PDBC was born! </span></div><br><div><span>Drink like it’s 2017 with core beers pouring for 2017 prices 1-3pm, birthday specials on tap, (hopefully) some sunshine 🤞, and pizzas from Papi's Munchies.</span></div>\",\"eventType\":[\"68c11ec0-281a-4735-9862-06e09c717587\"],\"location\":[\"d4db9d7b-4c96-46e5-b884-81d94ce2c9f7\"],\"host\":[],\"tags\":[{\"tagName\":\"Free\",\"id\":\"44bd6959-9fd6-47aa-987d-1962358de07b\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"isAllDay\":false,\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/abe58a9d-fd5b-419c-9f75-db107092026f/5.png\",\"name\":\"5.png\",\"size\":457047,\"type\":\"image/png\",\"extension\":\"png\",\"width\":1080,\"height\":1350,\"meta\":{\"width\":1080,\"height\":1350}}},{\"id\":\"1e7dcece-8060-4e16-bfc0-3729441ce6df\",\"name\":\"Birthday Tappy to Tappy 10K\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-05-23\",\"time\":\"11:30\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-05-23\",\"time\":\"13:30\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatWeeklyOnDays\":[\"sa\"],\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"exceptions\":[],\"description\":\"<div><span>Nothing says birthday like a big (hungover from the night before) run, because we’re all about wellness as we get older🧘</span></div><br><div><span><strong><br></strong>Starting from the Forest Gate taproom we’ll run through the Olympic park, along the canal and finish up at Victoria Park for a birthday beer on us!</span></div><br><div><span>Meet at the Blackhorse Road taprooms at 11.30am. Run, jog, walk - all abilities/paces welcome!</span></div>\",\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\",\"c69f13eb-2f51-44ee-9f82-a1f24a3d0472\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[{\"tagName\":\"Free\",\"id\":\"13fe9797-31e8-4eea-b0f3-07e3222c47d0\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"isAllDay\":false,\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/87cc0bdf-4cf5-458d-b620-4ce185936144/4.png\",\"name\":\"4.png\",\"size\":496309,\"type\":\"image/png\",\"extension\":\"png\",\"width\":1080,\"height\":1350,\"meta\":{\"width\":1080,\"height\":1350}}},{\"id\":\"cb4082f1-42cb-4047-bb6d-a010914462ad\",\"name\":\"Ultra Party Time! - 9th Birthday\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-05-22\",\"time\":\"17:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-05-22\",\"time\":\"23:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatWeeklyOnDays\":[],\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"exceptions\":[],\"description\":\"<div><span>It's our 9th birthday and to celebrate we're bringing together two of our favourite things: music and beer!</span></div><br><div><span>Team PD are taking to the decks to go B2B2B2B2B each playing a set of their favourite genre. Expect anything from jazz rap to Muzak, noughties Garage to French Hip Hop!</span></div><br><div><span>Fresh pours of birthday beers, pizzas from It's Not Big Dough, and prizes to be won!&nbsp;</span></div><br><div></div>\",\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[{\"tagName\":\"Free\",\"id\":\"9e95d56b-a09e-4855-9169-6cdc30ccaa11\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"isAllDay\":false,\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/58dd77f5-fc7f-4396-8f18-4618fdf72a7a/3.png\",\"name\":\"3.png\",\"size\":600579,\"type\":\"image/png\",\"extension\":\"png\",\"width\":1080,\"height\":1350,\"meta\":{\"width\":1080,\"height\":1350}}},{\"id\":\"9c8d101e-627f-400a-a6fd-6c7e2dc3710d\",\"name\":\"Seouls of Mischief Soundsystem\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-03-27\",\"time\":\"21:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-03-27\",\"time\":\"23:45\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"exceptions\":[],\"description\":\"<div><span>A new FREE party series takeover with Seouls of Mischief. </span></div><br><div><span>Once a month DJs will take to the decks spinning </span>Disco, House and Garage. </div><br><div>Next one is 27th March.</div>\",\"eventType\":[\"c69f13eb-2f51-44ee-9f82-a1f24a3d0472\"],\"location\":[\"51079595-090b-4b24-a4d3-a7b4b1330217\"],\"host\":[],\"tags\":[{\"tagName\":\"Free entry\",\"id\":\"70695b21-dac6-434a-9591-fd8ee04ddab1\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"visible\":false,\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/40c56c77-8655-4e78-b010-b2914f175395/SnapInsta-to_642505462_17912940423303948_4160227713215857557_n.jpg\",\"name\":\"SnapInsta.to_642505462_17912940423303948_4160227713215857557_n.jpg\",\"size\":200996,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":1080,\"height\":1330}},{\"id\":\"2ca3d498-d215-40cc-a1d2-c4fbe57e6538\",\"name\":\"Nanna's Night Off (Vinyl Session)\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-03-27\",\"time\":\"19:30\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-03-27\",\"time\":\"22:30\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"exceptions\":[],\"description\":\"<div><span>A monthly music night at our Forest Gate taproom.</span><br><br><span>Every last Friday, Nanna - the brains behind our branding and labels, Forest Gate local, and part-time vinyl demon - will be on the decks, joined by a different special guest each month.</span></div><br><div></div>\",\"eventType\":[\"68c11ec0-281a-4735-9862-06e09c717587\"],\"location\":[\"d4db9d7b-4c96-46e5-b884-81d94ce2c9f7\"],\"host\":[],\"tags\":[{\"tagName\":\"Free \",\"id\":\"4d7fe228-64f7-4774-9218-901d1ba5f29c\"}],\"color\":\"#32b25f\",\"video\":null,\"file\":null,\"repeatWeeklyOnDays\":[\"fr\"],\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/f50ae9a8-b0d7-412a-a8bd-0a28feefc600/nanna-night-off.jpg\",\"name\":\"nanna night off.jpg\",\"size\":5304706,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":4284,\"height\":5712}},{\"id\":\"054abc97-91a8-4555-a722-3cef2e7ef685\",\"name\":\"Noughties Night\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-03-27\",\"time\":\"19:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-03-27\",\"time\":\"22:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"exceptions\":[],\"description\":\"<div>Join us for a night of noughties nostalgia at the Blackhorse Road taproom on Friday 27th. </div><br><div>We’ll be blasting the best bangers from the 90s and early 2000s and serving up iconic drinks from the era - Cosmos (so we can live out our Sex and the City dreams) and Jägerbombs very much included. </div><br><div>Our slushy are also back, pouring frozen margaritas all night.</div>\",\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[{\"id\":\"b7b72ea2-877d-4add-b7de-15cafdd5fe76\",\"tagName\":\"Free entry\"}],\"color\":\"#7280f6\",\"video\":null,\"file\":null,\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/072794e0-44d6-410d-87ee-371bc74b7a67/brett-jordan-x3wDxZJx9qs-unsplash.jpg\",\"name\":\"brett-jordan-x3wDxZJx9qs-unsplash.jpg\",\"size\":3659639,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":5184,\"height\":3888}},{\"id\":\"447c8ede-4552-4762-b17c-0cb62490f2b6\",\"name\":\"T-shirt Weather Party: Oso Brew Co \",\"start\":{\"type\":\"datetime\",\"date\":\"2026-03-26\",\"time\":\"17:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-03-26\",\"time\":\"22:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"exceptions\":[],\"description\":\"<div>Next week, on 26th March, some of the team from Oso Brew Co are coming over from Madrid to brew a collab with us ahead of their beer festival Fresh Fest - which we are very hyped to be pouring at!</div><br><div>So, in the hope they might bring some Spanish sun in their hand luggage (🤞), we've decided to make a day of it, and you're invited. We're not waiting until June. Summer starts now!</div><br><div>Join us at the Blackhorse Road tappy where team Oso and team PD will be leading the charge. We'll have three Spanish imports from Oso pouring for £4 a pint from 5-7pm, we'll fire up the slushy machines for the first time this year for frozen margs, Balearic beats on the speakers, and crisp lagers till the sun goes down.</div><br><div></div>\",\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[{\"id\":\"91a02da8-e3be-4256-a6c5-17abd234c52d\",\"tagName\":\"Free entry\"}],\"color\":\"#7280f6\",\"video\":null,\"file\":null,\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/e459d8c3-f451-4378-9bf2-e527bff5d07c/Orange-and-White-Modern-Minimalist-Music-Fest-Instagram-Post.png\",\"name\":\"Orange and White Modern Minimalist Music Fest Instagram Post.png\",\"size\":1208830,\"type\":\"image/png\",\"extension\":\"png\",\"width\":1080,\"height\":1350}},{\"id\":\"3d752d0a-2186-4193-b9d8-29d80162ebcc\",\"name\":\"Busy Beaver Club\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-01-18\",\"time\":\"13:24\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-01-18\",\"time\":\"13:24\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"custom\",\"repeatFrequency\":\"weekly\",\"repeatInterval\":1,\"repeatEnds\":\"onDate\",\"repeatEndsDate\":{\"type\":\"datetime\",\"date\":\"2026-02-22\",\"time\":\"13:24\"},\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>Every Sunday, 12–2pm in January and February, at the Blackhorse Road taproom, we’ll be setting up colouring and crafts for the kids (supervision required please!), plus £8 margherita pizzas from It's Not Big Dough, so lunch is sorted.<br></div>\",\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[{\"tagName\":\"Free\",\"id\":\"51dd5737-934b-423f-b766-a0f91927481e\"}],\"color\":\"rgb(184, 45, 45)\",\"video\":null,\"file\":null,\"repeatWeeklyOnDays\":[\"su\"],\"exceptions\":[],\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/d0d97b0d-0b34-4f2e-95b7-bfd52f2701fb/BUSY-BEAVER-CLUB.png\",\"name\":\"BUSY BEAVER CLUB.png\",\"size\":1034135,\"type\":\"image/png\",\"extension\":\"png\",\"width\":1414,\"height\":2000}},{\"id\":\"2a0a1966-5590-4801-aaa5-9ca4414e5ccd\",\"name\":\"Valentine's Slice Night with Papi's Munchies\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-02-14\",\"time\":\"19:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-02-14\",\"time\":\"23:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"exceptions\":[],\"description\":\"<div>If the thickness of your pizza base directly correlates to how much you love someone, spending Valentine’s Day eating Detroit-style deep dish together feels like a pretty strong declaration of intent!<br><br>Join us at the Forest Gate tappy on 14th February for a Valentine’s Day Detroit-style pizza supper club with our pals <a class=\\\"x1i10hfl xjbqb8w x1ejq31n x18oe1m7 x1sy0etr xstzfhl x972fbf x10w94by x1qhh985 x14e42zd x9f619 x1ypdohk xt0psk2 x3ct3a4 xdj266r x14z9mp xat24cr x1lziwak xexx8yu xyri2b x18d9i69 x1c1uobl x16tdsg8 x1hl2dhg xggy1nq x1a2a7pz notranslate _a6hd\\\" href=\\\"https://www.instagram.com/papismunchies/\\\">@papismunchies</a>.<br><br>You might know Papi’s for their Neapolitan pizzas, but they also make a mean Detroit deep dish - big, cheesy slices baked in rectangular trays, crisp on the outside and soft, springy in the middle. For one night only, it’s landing as a three-course set menu to kick off the first of their Detroit Slice Nights.<br><br>Perfect for dates or mates who’d rather avoid the fancy white tablecloths and Adele piano covers. Expect a super relaxed evening with great pizza, great beer*, and an excellent, non-ballad-heavy playlist.<br><br>Your ticket includes a starter, two generous slices of Detroit-style pizza, and dessert. Drinks-wise, all the usuals will be available to buy on the night, plus our Valentine’s beer - Choo Mean The World To Me. Because to us, love is best served double dry hopped 💕<br><br>£30 per person<br>Three-course set menu<br>Two seatings - 7pm &amp; 9pm (90 mins)<br></div>\",\"eventType\":[\"68c11ec0-281a-4735-9862-06e09c717587\"],\"location\":[\"d4db9d7b-4c96-46e5-b884-81d94ce2c9f7\"],\"host\":[],\"tags\":[{\"id\":\"90039484-dd7c-4c8d-a898-f2dcc9d21711\",\"tagName\":\"Ticketed\"}],\"color\":\"rgb(14, 139, 37)\",\"video\":null,\"file\":null,\"actions\":[{\"id\":\"5a532465d21d9\",\"type\":\"link\",\"text\":\"Get Tickets\",\"link\":{\"rawValue\":\"https://prettydecentbeer.co/products/valentines-day-supper-club?variant=56204003082626\",\"value\":\"https://prettydecentbeer.co/products/valentines-day-supper-club?variant=56204003082626\",\"type\":\"url\",\"target\":\"_blank\"},\"primary\":true}],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/8edb1857-3d16-4d03-86f6-330e02d2c21f/PDBC-x-PAPIS-.png\",\"name\":\"PDBC x PAPIS .png\",\"size\":346256,\"type\":\"image/png\",\"extension\":\"png\",\"width\":1080,\"height\":1350}},{\"id\":\"b9e94a9e-f342-4101-953d-b54bbea7e560\",\"name\":\"International Women's Day Brew\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-02-11\",\"time\":\"09:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-02-11\",\"time\":\"16:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"exceptions\":[],\"description\":\"<div><span>Every year, the women of Pretty Decent get together to brew an International Women’s Day beer. This year, for the first time since moving our brewhouse to Blackhorse Road, we’re veryyy excited (slash scared in case no one turns up 🫠) to be opening the day up to our women and non-binary pals!</span><br><br><span>With over half of our team being women, IWD brews are something we always look forward to. It’s a great excuse to get together at the brewery, share knowledge and skills, and help make beer a more welcoming space.</span><br><br><span>The brew day takes place on Wednesday 11th February, running from 9am to around 4pm. You’re welcome to dip in and out – no pressure to stay all day! We’ll grab a group photo around 12.30pm, with a few beers in the afternoon once things are underway.</span><br><br><span>If you’ve not been to a brew day before, there can be a fair bit of waiting around, so we’ll have a couple of things going on throughout the day such as a ‘design your own label’ session with our in-house illustrator Nanna ✍️</span><br></div>\",\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[{\"id\":\"2c2f035b-5fdd-4430-9eb2-37a24957e8d9\",\"tagName\":\"Free \"}],\"color\":\"rgb(255, 235, 0)\",\"video\":null,\"file\":null,\"actions\":[{\"id\":\"24237014a7ada\",\"type\":\"link\",\"text\":\"Register\",\"link\":{\"rawValue\":\"https://tally.so/r/b5eYpo\",\"value\":\"https://tally.so/r/b5eYpo\",\"type\":\"url\",\"target\":\"_blank\"},\"primary\":true}],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/c0159ed9-697e-4bd6-8e9f-8e1cc0b8618c/iwd9.jpg\",\"name\":\"iwd9.jpg\",\"size\":6500649,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":4284,\"height\":5712}},{\"id\":\"022ff71c-6aab-4fe3-9ac8-23ff2bcb37cf\",\"name\":\"Sunday Screenings\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-01-11\",\"time\":\"17:29\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-01-11\",\"time\":\"17:29\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"custom\",\"repeatFrequency\":\"weekly\",\"repeatInterval\":1,\"repeatEnds\":\"onDate\",\"repeatEndsDate\":{\"type\":\"datetime\",\"date\":\"2026-02-02\",\"time\":\"17:29\"},\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>Ease into the week with a movie, pint and a burger.</div><br><div>Every Sunday at 2pm (kid friendly) and 6pm. Here's the schedule for January:</div><br><div>11th:<br>2pm - Treasure Planet<br>6pm - Jurassic Park</div><br><div>18th:<br>2pm - The Lion, The Witch &amp; The Wardrobe<br>6pm - The Other Woman</div><br><div>25th:<br>2pm - Shrek<br>6pm - Darjeeling Limited</div><br><div>1st Feb:<br>2pm - Shrek 2<br>6pm - Notting Hill</div><br><div>1st:<br>2pm - The Golden Compass<br>6pm - Parasite</div>\",\"eventType\":[\"c69f13eb-2f51-44ee-9f82-a1f24a3d0472\"],\"location\":[\"51079595-090b-4b24-a4d3-a7b4b1330217\"],\"host\":[],\"tags\":[{\"id\":\"19443a54-7a37-4bc2-822c-e4daef49d0e2\",\"tagName\":\"Free\"}],\"color\":\"rgb(251, 167, 225)\",\"video\":null,\"file\":null,\"isAllDay\":true,\"repeatWeeklyOnDays\":[\"su\"],\"exceptions\":[],\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/f796e5c4-17a9-4887-8618-4d4b3c19055e/2.png\",\"name\":\"2.png\",\"size\":780530,\"type\":\"image/png\",\"extension\":\"png\",\"width\":1080,\"height\":1080}},{\"id\":\"6eb02e71-12e0-4deb-88c4-971de2554529\",\"name\":\"Indie Night\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-01-31\",\"time\":\"19:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-01-31\",\"time\":\"22:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>Join us for a big pay day Indie sleaze up! Expect big Indie tunes, some you'll recognise and some hidden gems you might not. Pizzas, pints, and songs you can tap your Winklepickers to.</div><br><div>From 7pm, no ticket required.</div><br><div></div><br><div></div>\",\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[{\"id\":\"d090c38f-0de8-4a19-ad5b-8ef35d560b8b\",\"tagName\":\"Free entry\"}],\"color\":\"rgb(184, 45, 45)\",\"video\":null,\"file\":null,\"exceptions\":[],\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/de0cd55d-8140-4cac-9e31-27b63148d4e0/IMG_6575_VSCO.jpg\",\"name\":\"IMG_6575_VSCO.jpg\",\"size\":803794,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":2899,\"height\":3866}},{\"id\":\"297b6740-84f5-4715-96ad-0e1e7d33be97\",\"name\":\"Run Club\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-01-31\",\"time\":\"12:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-01-31\",\"time\":\"13:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>Every Month (on the last Saturday) we run a community Run Club. It's open to all abilities, whether you've never run in your life or you smash out ultras. You're welcome to race ahead or walk the whole route.</div><br><div>It's typically a 5km round the local area and ends back at the brewery for a pint on us.</div><br><div>Meet at the taproom for 12pm. Bag drop available.</div>\",\"eventType\":[\"68c11ec0-281a-4735-9862-06e09c717587\"],\"location\":[\"d4db9d7b-4c96-46e5-b884-81d94ce2c9f7\"],\"host\":[],\"tags\":[{\"id\":\"0f22ba8d-7114-4427-9381-381d2d19bc32\",\"tagName\":\"Free\"}],\"color\":\"rgb(14, 139, 37)\",\"video\":null,\"file\":null,\"exceptions\":[],\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/5beb6452-2915-4683-bbde-d403e8f1140c/WhatsApp-Image-2025-07-26-at-19-26-01.jpg\",\"name\":\"WhatsApp Image 2025-07-26 at 19.26.01.jpeg\",\"size\":726211,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":2048,\"height\":1536}},{\"id\":\"250ea345-49ce-4a51-8e14-06e6222fa590\",\"name\":\"Le Wine Club \",\"start\":{\"type\":\"datetime\",\"date\":\"2026-01-07\",\"time\":\"16:18\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-01-07\",\"time\":\"16:18\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"custom\",\"repeatFrequency\":\"weekly\",\"repeatInterval\":1,\"repeatEnds\":\"onDate\",\"repeatEndsDate\":{\"type\":\"datetime\",\"date\":\"2026-01-28\",\"time\":\"16:18\"},\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>French for 'The Wine Club', every Wednesday 4 'til close, we pour glasses of house wine for just £5, or enjoy a bottle with friends £25.</div><br><div>Every Month there'll also be a wine-focused special on offer. For January, it's a flight of our fave reds for £12.</div>\",\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[{\"tagName\":\"Free entry\",\"id\":\"89f4f070-fd0c-4d46-a484-1a0368b24779\"}],\"color\":\"rgb(184, 45, 45)\",\"video\":null,\"file\":null,\"isAllDay\":true,\"repeatWeeklyOnDays\":[\"we\"],\"visible\":false,\"exceptions\":[],\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/447d974f-84aa-4726-a402-2ba91d93d03e/240625_Pretty_Decent_ENG_vs_SVN-93-Chris_Coulson-.jpg\",\"name\":\"240625_Pretty_Decent_ENG_vs_SVN-93[©Chris_Coulson].jpg\",\"size\":968620,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":2500,\"height\":1667}},{\"id\":\"3be8da57-d07e-4123-9bf7-9a0844d76647\",\"name\":\"Movie Club\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-01-11\",\"time\":\"18:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-01-11\",\"time\":\"18:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"custom\",\"repeatFrequency\":\"weekly\",\"repeatInterval\":1,\"repeatEnds\":\"onDate\",\"repeatEndsDate\":{\"type\":\"datetime\",\"date\":\"2026-01-26\",\"time\":\"17:02\"},\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>Ease into the week with a movie, pint and a pizza.</div><br><div>Every Sunday 6-8pm. Here's the schedule for January:</div><br><div><span>4th- Anchorman</span><br><span>11th- The Birdcage</span><br><span>18th- Empire Records</span><br><span>25th- Zoolander</span></div>\",\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[{\"id\":\"30aacded-ab3e-431e-be97-86718daf87b1\",\"tagName\":\"Free \"}],\"color\":\"rgb(184, 45, 45)\",\"video\":null,\"file\":null,\"repeatWeeklyOnDays\":[\"su\"],\"exceptions\":[],\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/d5c150fd-cd3d-4d43-abff-22baafa62151/1.png\",\"name\":\"1.png\",\"size\":772734,\"type\":\"image/png\",\"extension\":\"png\",\"width\":1080,\"height\":1080}},{\"id\":\"29a8568b-cfb1-46a9-9ad8-e2a6af5ac306\",\"name\":\"Karaoke\",\"start\":{\"type\":\"datetime\",\"date\":\"2026-01-09\",\"time\":\"21:30\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-01-09\",\"time\":\"23:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>Karaoke night at Pretty Decent Victoria Park. Pick a song, grab a pint, and give it a go - whether you’re secretly brilliant or loudly average. Expect big tunes, a friendly crowd, and a free shot if you get up and sing. </div>\",\"eventType\":[\"c69f13eb-2f51-44ee-9f82-a1f24a3d0472\"],\"location\":[\"51079595-090b-4b24-a4d3-a7b4b1330217\"],\"host\":[],\"tags\":[{\"id\":\"cfd809d6-4450-431c-a2cf-a5d60793a221\",\"tagName\":\"Free\"}],\"color\":\"rgb(251, 167, 225)\",\"video\":null,\"file\":null,\"exceptions\":[],\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/3cd1819c-f3d3-4abe-a4cf-48dd3c15ad18/Karaoke-for-website.png\",\"name\":\"Karaoke for website.png\",\"size\":900736,\"type\":\"image/png\",\"extension\":\"png\",\"width\":1080,\"height\":1080}},{\"id\":\"83dfd0db-827f-437d-a81e-82f3c412275c\",\"name\":\"NYE Party - Blackhorse Road\",\"start\":{\"type\":\"datetime\",\"date\":\"2025-12-31\",\"time\":\"16:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-01-01\",\"time\":\"01:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>Open from 4pm ‘til 1am – we’ll have party bangers, pints and fizz flowing, plus a big midnight celebration. Expect shiny decs, and a resolution wall where you can tell us all the things you plan to do… but probably won’t.</div><br><div>£5 entry – booking advised!</div>\",\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[{\"tagName\":\"£5pp\",\"id\":\"2af5c404-23ad-4b60-b027-04fbfc9d93e7\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"exceptions\":[],\"actions\":[{\"id\":\"daf60d490ccc1\",\"type\":\"link\",\"text\":\"Get Tickets\",\"link\":{\"rawValue\":\"https://prettydecentbeer.co/products/new-years-eve-party?variant=55823401812354\",\"value\":\"https://prettydecentbeer.co/products/new-years-eve-party?variant=55823401812354\",\"type\":\"url\",\"target\":\"_blank\"},\"primary\":true}],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/6fb8cb11-623f-4924-af52-9d6598872fcb/NYE-webshop-BHR.jpg\",\"name\":\"NYE-webshop-BHR.jpg\",\"size\":783867,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":2464,\"height\":2464}},{\"id\":\"2272d1ac-0657-4017-8649-969360b5d83f\",\"name\":\"NYE Party - Victoria Park\",\"start\":{\"type\":\"datetime\",\"date\":\"2025-12-31\",\"time\":\"16:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-01-01\",\"time\":\"01:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>Open from 4pm through 'til 1am we'll have party bangers, pints and fizz flowing and a big midnight celebration. It's £5 entry, booking advised!</div>\",\"eventType\":[\"c69f13eb-2f51-44ee-9f82-a1f24a3d0472\"],\"location\":[\"51079595-090b-4b24-a4d3-a7b4b1330217\"],\"host\":[],\"tags\":[{\"tagName\":\"£5pp\",\"id\":\"b9602058-2e42-4450-babe-ae309e162146\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"exceptions\":[],\"actions\":[{\"id\":\"7686b310a7622\",\"type\":\"link\",\"text\":\"Get Tickets\",\"link\":{\"rawValue\":\"https://prettydecentbeer.co/products/new-years-eve-party-victoria-park?variant=55823404335490\",\"value\":\"https://prettydecentbeer.co/products/new-years-eve-party-victoria-park?variant=55823404335490\",\"type\":\"url\",\"target\":\"_blank\"},\"primary\":true}],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/19a9920f-d4ad-4d6a-922e-291296dafdd5/NYE-webshop-VP.jpg\",\"name\":\"NYE-webshop-VP.jpg\",\"size\":736592,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":2464,\"height\":2464}},{\"id\":\"6d7a189b-886c-4af2-9b7e-c64196dbf97f\",\"name\":\"NYE Party - Forest Gate\",\"start\":{\"type\":\"datetime\",\"date\":\"2025-12-31\",\"time\":\"16:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2026-01-01\",\"time\":\"01:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>Join us at our OG taproom to ring in the New Year. We're keeping it low key with pizza and pints-a-plenty. Open from 4pm for those early family celebrations, through to 1am for those who want to do the proper count down!</div><br><div>It's free entry so no need to worry about booking a ticket but you're welcome to book a table by emailing <a href=\\\"mailto:forestgate@prettydecentbeer.co\\\">forestgate@prettydecentbeer.co</a>.</div>\",\"eventType\":[\"68c11ec0-281a-4735-9862-06e09c717587\"],\"location\":[\"d4db9d7b-4c96-46e5-b884-81d94ce2c9f7\"],\"host\":[],\"tags\":[{\"tagName\":\"Free entry\",\"id\":\"dd3c669c-b8b2-4f28-9808-855bc1843694\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"exceptions\":[],\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/73b41cce-31d7-4530-9ff4-c0eaabb0ad07/NYE2025-A3poster-vTagline.jpg\",\"name\":\"NYE2025-A3poster-vTagline.jpg\",\"size\":754111,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":2465,\"height\":3486}},{\"id\":\"338934a0-3eb6-4aac-ab2c-ac21dd461fcb\",\"name\":\"Ugly Christmas Jumper Day\",\"start\":{\"type\":\"datetime\",\"date\":\"2025-12-19\",\"time\":\"16:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2025-12-19\",\"time\":\"23:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>Wear your most garish/best Christmas Jumper and we'll enter you into a raffle to win a beer box!</div>\",\"eventType\":[\"6a1c0e53-802b-4a6e-9a30-5689f90fc8cc\"],\"location\":[\"6ef80a92-4bfe-4fd6-bde2-b0fccda6bb7d\"],\"host\":[],\"tags\":[{\"id\":\"c2f6134c-889f-4e47-9445-fd7d6b689a53\",\"tagName\":\"Free entry\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"isAllDay\":true,\"exceptions\":[],\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":{\"url\":\"https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/9e1b8813-3aae-4f6b-97d1-a92afd36a2cb/richard-bell-tC99K66NtEk-unsplash.jpg\",\"name\":\"richard-bell-tC99K66NtEk-unsplash.jpg\",\"size\":1191906,\"type\":\"image/jpeg\",\"extension\":\"jpg\",\"width\":5868,\"height\":3912}},{\"id\":\"7d523665-b205-43d3-9530-a5b8c2cba812\",\"name\":\"Pub Quiz: Xmas Edition! \",\"start\":{\"type\":\"datetime\",\"date\":\"2025-12-17\",\"time\":\"19:30\"},\"end\":{\"type\":\"datetime\",\"date\":\"2025-12-17\",\"time\":\"21:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>A Christmas-ified version of our monthly pub quiz at Viccy Park.</div><br><div>£2pp</div>\",\"eventType\":[\"c69f13eb-2f51-44ee-9f82-a1f24a3d0472\"],\"location\":[\"51079595-090b-4b24-a4d3-a7b4b1330217\"],\"host\":[],\"tags\":[{\"id\":\"a805cbf3-f986-4f70-94c1-6762c14f209c\",\"tagName\":\"£2pp\"}],\"color\":\"transparent\",\"video\":null,\"file\":null,\"exceptions\":[],\"actions\":[],\"actionsCaption\":\"\",\"images\":[],\"coverImage\":null},{\"id\":\"be51b479-aa60-4dcc-a10e-dc380ce8a70a\",\"name\":\"Bauble Painting\",\"start\":{\"type\":\"datetime\",\"date\":\"2025-12-14\",\"time\":\"15:00\"},\"end\":{\"type\":\"datetime\",\"date\":\"2025-12-14\",\"time\":\"17:00\"},\"timeZone\":\"Europe/London\",\"repeatPeriod\":\"noRepeat\",\"repeatFrequency\":\"daily\",\"repeatInterval\":1,\"repeatEnds\":\"never\",\"repeatEndsDate\":null,\"repeatEndsOccurrences\":1,\"repeatMonthlyOnDay\":\"sameDay\",\"description\":\"<div>Hosted by our very own Jaime, spend the afternoon decorating decorations!&nbsp;</div><br><div>We'll provide the baubles and plenty of glitter, paints, ribbons and other decorative bits and bobs. Bring a pal and enjoy a few drinks whilst you craft, or bring the kids down and let them make something they can hang on the (back of) the tree!</div><br><div><strong>Date:&nbsp;</strong>Sunday 14th December<br><strong>Time: </strong>3pm<br><strong>Price: </strong>£10pp<br><strong>Location: </strong>Victoria Park taproom (<span><em>Unit GF1, Bow Wharf, 221 Grove Rd., Old Ford, London E3 5SN)</em></span></div><br><div>Your email confirmation is your ticket.</div>\",\"even