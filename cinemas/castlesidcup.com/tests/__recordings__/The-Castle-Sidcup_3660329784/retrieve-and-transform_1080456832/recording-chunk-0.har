            "text": "\n\n\n\n<!doctype html>\n<html>\n\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"apple-mobile-web-app-title\" content=\"The Castle Cinema Sidcup\">\n    <meta name=\"application-name\" content=\"The Castle Cinema Sidcup\">\n    <meta name=\"theme-color\" content=\"#ffffff\">\n    <meta name=\"google-site-verification\" content=\"2jx6wSc1LPiFGgeMS3-e-a-hxA08ZyaaK0P99kOzxVw\" />\n    <meta name=\"description\" content=\"We are an independent, crowdfunded, community cinema coming to Sidcup.\">\n    \n    <title>Wicked: For Good - The Castle Cinema Sidcup</title>\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/static/favicons/apple-touch-icon.png\">\n    <link rel=\"icon\" type=\"image/png\" href=\"/static/favicons/favicon-32x32.png\" sizes=\"32x32\">\n    <link rel=\"icon\" type=\"image/png\" href=\"/static/favicons/favicon-16x16.png\" sizes=\"16x16\">\n    <link rel=\"manifest\" href=\"/static/favicons/manifest.json\">\n    <link rel=\"mask-icon\" href=\"/static/favicons/safari-pinned-tab.svg\" color=\"#f0b200\">\n    <link href=\"/static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\n    <link href=\"https://fonts.googleapis.com/css?family=Karla\" rel=\"stylesheet\">\n    <style type=\"text/css\">\n      html,\n      body {\n          margin: 0;\n          padding: 0;\n      }\n\n      * {\n          box-sizing: border-box;\n      }\n\n      .slider {\n          width: 100%;\n          margin: 5.5em auto;\n      }\n\n      .slick-slide img {\n          width: 100%;\n      }\n\n      .slick-prev:before,\n      .slick-next:before {\n          color: black;\n      }\n    </style>\n    <script>\n      (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){\n      (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),\n      m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)\n      })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');\n\n      ga('create', 'UA-87677552-1', 'auto');\n      ga('send', 'pageview');\n\n    </script>\n</head>\n\n<body>\n    <div class=\"toggle-name\">\n        <p>MENU</p>\n        <div class=\"menu-toggle\">\n            <img id=\"trigger-overlay\" type=\"button\" src=\"/static/images/menu.png\">\n        </div>\n    </div>\n    <div class=\"overlay overlay-nav\">\n        <button type=\"button\" class=\"overlay-close\"><img src=\"/static/images/cross.png\"></button>\n        <nav>\n            <ul>\n                \n\n<li><a href=\"/calendar/\">What's on</a></li>\n<li><a href=\"/membership/\">Membership</a></li>\n<li><a href=\"/membership/#gifts\">Gift Vouchers</a></li>\n<li><a href=\"/bar/\">Bar &amp; food</a></li>\n<li><a href=\"/private-hire/\">Private hire</a></li>\n<li><a href=\"/about-us/\">About us</a></li>\n<li><a href=\"/access/\">Accessibility</a></li>\n\n\n                <li>\n                    \n<ul class=\"social\">\n    <li>\n        <a href=\"http://www.instagram.com/thecastlesidcup\" target=\"_blank\"><img src=\"/static/images/instagram-b.png\" /></a>\n    </li>\n    <li>\n        <a href=\"http://www.twitter.com/thecastlesidcup\" target=\"_blank\"><img src=\"/static/images/twitter-b.png\" /></a>\n    </li>\n</ul>\n\n                </li>\n            </ul>\n        </nav>\n    </div>\n    \n        \n    \n    \n\n    \n\n\n<div class=\"header inner blank\">\n    <a href=\"/\"><img class=\"inner-logo\" src=\"/static/images/sidcup/castle-sidcup-temp-logo.png\"></a>\n\n    <div id=\"main-nav\">\n        \n<ul class=\"social\">\n    <li>\n        <a href=\"http://www.instagram.com/thecastlesidcup\" target=\"_blank\"><img src=\"/static/images/instagram-b.png\" /></a>\n    </li>\n    <li>\n        <a href=\"http://www.twitter.com/thecastlesidcup\" target=\"_blank\"><img src=\"/static/images/twitter-b.png\" /></a>\n    </li>\n</ul>\n\n\n        <a href=\"/\"><img class=\"crown\" src=\"/static/images/sidcup/castle-sidcup-temp-logo.png\"></a>\n        <div class=\"nav-links inner\">\n            <ul>\n                \n\n<li><a href=\"/calendar/\">What's on</a></li>\n<li><a href=\"/membership/\">Membership</a></li>\n<li><a href=\"/membership/#gifts\">Gift Vouchers</a></li>\n<li><a href=\"/bar/\">Bar &amp; food</a></li>\n<li><a href=\"/private-hire/\">Private hire</a></li>\n<li><a href=\"/about-us/\">About us</a></li>\n<li><a href=\"/access/\">Accessibility</a></li>\n\n\n            </ul>\n        </div>\n    </div>\n</div>\n\n\n    \n    <section class=\"hero-banner\">\n        <div>\n            \n            <a class=\"venobox\" data-vbtype=\"video\" href=\"https://www.youtube.com/watch?v=R2Xubj7lazE?si=zQ_GkyzU-Ekq0HO\" data-autoplay=\"true\"><div class=\"play inner\"></div></a>\n            \n            <div class=\"hero-image inner clip btm\">\n                \n\n\n\n\n\n\n\n\n<div class=\"special responsive-image-wrapper programme-image-wrapper\" style=\"padding-bottom: 45.390625%;\">\n\n\n    \n    <picture>\n        <source srcset=\"/optimised-images/c_crop,ar_1280:581/w_1280,h_581,f_webp,q_auto/https://thecastlecinema.com/_media/wicked-for-good-press.jpg, /optimised-images/c_crop,ar_1280:581/w_1280,h_581,f_webp,q_auto/https://thecastlecinema.com/images/default-widescreen.jpg\" type=\"image/webp\">\n        <source srcset=\"/optimised-images/c_crop,ar_1280:581/w_1280,h_581,f_jpg,q_auto/https://thecastlecinema.com/_media/wicked-for-good-press.jpg, /optimised-images/c_crop,ar_1280:581/w_1280,h_581,f_jpg,q_auto/https://thecastlecinema.com/images/default-widescreen.jpg\" type=\"image/jpeg\">\n        <img class=\"\" src=\"/optimised-images/c_crop,ar_1280:581/w_1280,h_581,f_jpg,q_auto/https://thecastlecinema.com/_media/wicked-for-good-press.jpg\">\n    </picture>\n\n</div>\n\n            </div>\n            <div class=\"bumper mobile\">\n                <div class=\"hero-info inner\">\n                    <div class=\"film-poster\">\n\n\n\n\n\n\n\n\n<div class=\" responsive-image-wrapper programme-image-wrapper\" style=\"padding-bottom: 150.0%;\">\n\n\n    \n    <picture>\n        <source srcset=\"/optimised-images/c_crop,ar_128:192/w_128,h_192,f_webp,q_auto/https://thecastlecinema.com/_media/wicked-for-good-poster.jpg, /optimised-images/c_crop,ar_128:192/w_128,h_192,f_webp,q_auto/https://thecastlecinema.com/images/default-poster.jpg\" type=\"image/webp\">\n        <source srcset=\"/optimised-images/c_crop,ar_128:192/w_128,h_192,f_jpg,q_auto/https://thecastlecinema.com/_media/wicked-for-good-poster.jpg, /optimised-images/c_crop,ar_128:192/w_128,h_192,f_jpg,q_auto/https://thecastlecinema.com/images/default-poster.jpg\" type=\"image/jpeg\">\n        <img class=\"\" src=\"/optimised-images/c_crop,ar_128:192/w_128,h_192,f_jpg,q_auto/https://thecastlecinema.com/_media/wicked-for-good-poster.jpg\">\n    </picture>\n\n</div>\n</div>\n                    <div class=\"info-holder\">\n                        <!--<div class=\"hero-subhead\">Now playing</div>-->\n                        <div class=\"hero-title\"><h3>Wicked: For Good</h3></div>\n                        <div class=\"film-details\">\n                            \n                            \n                            \n                            \n                            <div class=\"film-duration comma\">137 mins</div>\n                            \n                            \n                            <div class=\"film-year comma\">2025</div>\n                            \n                            \n                            \n                            \n\n<div class=\"bbfc\">\n    <img src=\"/static/images/BBFC_PG.png\" alt=\"BBFC PG\">\n</div>\n\n\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n    </section> <!-- Slider -->\n\n<section class=\"main\">\n    <div class=\"bumper\">\n\n    <div class=\"half-col film-times tablet\">\n        \n            \n\n            <h2 class=\"band\">Film times</h2>\n\n            \n            <div class=\"day-times\">\n                <div class=\"day\"><h3>Fri</h3>12 Dec</div>\n                <div class=\"times\">\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"166\" data-filters=\"\" data-start-time=\"2025-12-12T15:40:00\" href=\"/bookings/166/\">\n    15:40\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n        \n    \n    \n        <span class=\"screen\">S1</span>\n    \n</a>\n\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"170\" data-filters=\"\" data-start-time=\"2025-12-12T18:40:00\" href=\"/bookings/170/\">\n    18:40\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n        \n    \n    \n        <span class=\"screen\">S3</span>\n    \n</a>\n\n                \n                </div>\n            </div>\n            \n            <div class=\"day-times\">\n                <div class=\"day\"><h3>Sat</h3>13 Dec</div>\n                <div class=\"times\">\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"171\" data-filters=\"\" data-start-time=\"2025-12-13T10:20:00\" href=\"/bookings/171/\">\n    10:20\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n        \n    \n    \n        <span class=\"screen\">S1</span>\n    \n</a>\n\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"178\" data-filters=\"\" data-start-time=\"2025-12-13T13:30:00\" href=\"/bookings/178/\">\n    13:30\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n        \n    \n    \n        <span class=\"screen\">S1</span>\n    \n</a>\n\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"181\" data-filters=\"\" data-start-time=\"2025-12-13T15:30:00\" href=\"/bookings/181/\">\n    15:30\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n        \n    \n    \n        <span class=\"screen\">S3</span>\n    \n</a>\n\n                \n                </div>\n            </div>\n            \n            <div class=\"day-times\">\n                <div class=\"day\"><h3>Sun</h3>14 Dec</div>\n                <div class=\"times\">\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"183\" data-filters=\"\" data-start-time=\"2025-12-14T13:20:00\" href=\"/bookings/183/\">\n    13:20\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n        \n    \n    \n        <span class=\"screen\">S3</span>\n    \n</a>\n\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"192\" data-filters=\"\" data-start-time=\"2025-12-14T15:50:00\" href=\"/bookings/192/\">\n    15:50\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n        \n    \n    \n        <span class=\"screen\">S1</span>\n    \n</a>\n\n                \n                </div>\n            </div>\n            \n            <div class=\"day-times\">\n                <div class=\"day\"><h3>Mon</h3>15 Dec</div>\n                <div class=\"times\">\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"200\" data-filters=\"\" data-start-time=\"2025-12-15T13:40:00\" href=\"/bookings/200/\">\n    13:40\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n            <span class=\"screening-type\">£6 Monday!</span>\n        \n        \n    \n    \n        <span class=\"screen\">S3</span>\n    \n</a>\n\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"195\" data-filters=\"\" data-start-time=\"2025-12-15T16:00:00\" href=\"/bookings/195/\">\n    16:00\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n            <span class=\"screening-type\">£6 Monday!</span>\n        \n        \n    \n    \n        <span class=\"screen\">S1</span>\n    \n</a>\n\n                \n                </div>\n            </div>\n            \n            <div class=\"day-times\">\n                <div class=\"day\"><h3>Tue</h3>16 Dec</div>\n                <div class=\"times\">\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"205\" data-filters=\"\" data-start-time=\"2025-12-16T13:40:00\" href=\"/bookings/205/\">\n    13:40\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n        \n    \n    \n        <span class=\"screen\">S3</span>\n    \n</a>\n\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"206\" data-filters=\"\" data-start-time=\"2025-12-16T16:00:00\" href=\"/bookings/206/\">\n    16:00\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n        \n    \n    \n        <span class=\"screen\">S1</span>\n    \n</a>\n\n                \n                </div>\n            </div>\n            \n            <div class=\"day-times\">\n                <div class=\"day\"><h3>Wed</h3>17 Dec</div>\n                <div class=\"times\">\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"220\" data-filters=\"\" data-start-time=\"2025-12-17T13:40:00\" href=\"/bookings/220/\">\n    13:40\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n        \n    \n    \n        <span class=\"screen\">S3</span>\n    \n</a>\n\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"213\" data-filters=\"\" data-start-time=\"2025-12-17T16:00:00\" href=\"/bookings/213/\">\n    16:00\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n        \n    \n    \n        <span class=\"screen\">S1</span>\n    \n</a>\n\n                \n                </div>\n            </div>\n            \n        \n\n    </div>\n\n    <div class=\"half-col film-description tablet\">\n      \n      \n      \n        <span class=\"film-synopsis\"><p><p>Elphaba (Cynthia Erivo), now demonized as The Wicked Witch of the West, lives in exile, hidden within the Ozian forest while continuing her fight for the freedom of Oz's silenced Animals and desperately trying to expose the truth she knows about The Wizard (Jeff Goldblum). </p>\n<p>Glinda, meanwhile, has become the glamorous symbol of Goodness for all of Oz, living at the palace in Emerald City and reveling in the perks of fame and popularity.</p>\n<p>As an angry mob rises against the Wicked Witch, Glinda and Elphaba will need to come together one final time. With their singular friendship now the fulcrum of their futures, they will need to truly see each other, with honesty and empathy, if they are to change themselves, and all of Oz, for good.</p></p></span>\n      \n        <br>\n\n        <div class=\"meta\">\n            \n                \n                    <div class=\"meta-line\"><strong>Starring</strong>: <br>\n                    <span class=\"film-cast\">Cynthia Erivo, Ariana Grande, Jeff Goldblum</span></div>\n                \n            \n                \n                    <div class=\"meta-line\"><strong>Director</strong>: <br>\n                    <span class=\"film-director\">Jon M. Chu</span></div>\n                \n            \n                \n            \n                \n            \n                \n            \n                \n            \n        </div>\n    </div>\n\n    <div class=\"clear marg\"></div>\n    \n    <!-- Films -->\n    </div>\n\n    </section>\n\n\n    \n    <footer class=\"inner clip top\">\n        \n<div class=\"newsletter\">\n<form class=\"mc-form\">\n    \n    <span>Newsletter signup</span>\n    \n    <input id=\"mc-email\" type=\"email\" placeholder=\"Enter your email address\">\n    <div class=\"button teal dark\">Sign up</div>\n    </br>\n    <label for=\"mc-email\"></label>\n</form>\n</div>\n\n    <div class=\"footer-cols\">\n        <div class=\"third-col contact\">\n            <div class=\"contact\">\n                <h3>The Castle Cinema Sidcup</h3>\n                <p> 106 High St\n                    <br> Sidcup, London, DA14 6DS\n                    <br>\n                    <a href=\"/info/#find-us\">Map</a>\n                </p>\n                <p>\n                    <a href=\"mailto:hello@castlesidcup.com\">hello@castlesidcup.com</a>\n                </p>\n                <h3>Hours</h3>\n                <p>\n                  Coming soon!\n                </p>\n                \n<ul class=\"social\">\n    <li>\n        <a href=\"http://www.instagram.com/thecastlesidcup\" target=\"_blank\"><img src=\"/static/images/instagram.png\" /></a>\n    </li>\n    <li>\n        <a href=\"http://www.twitter.com/thecastlesidcup\" target=\"_blank\"><img src=\"/static/images/twitter.png\" /></a>\n    </li>\n</ul>\n\n            </div>\n        </div>\n        <div class=\"twothird-col\">\n            <div class=\"nav-col\">\n                <ul class=\"first\">\n                    <li>Top menu</li>\n                    \n\n<li><a href=\"/calendar/\">What's on</a></li>\n<li><a href=\"/membership/\">Membership</a></li>\n<li><a href=\"/membership/#gifts\">Gift Vouchers</a></li>\n<li><a href=\"/bar/\">Bar &amp; food</a></li>\n<li><a href=\"/private-hire/\">Private hire</a></li>\n<li><a href=\"/about-us/\">About us</a></li>\n<li><a href=\"/access/\">Accessibility</a></li>\n\n\n                </ul>\n            </div>\n            <div class=\"nav-col\">\n                <ul class=\"first\">\n                    <li>Cinema info</li>\n                    <li><a href=\"/about-us/\">About us</a></li>\n                    <li><a href=\"/info/#contact\">Contact us</a></li>\n                    <li><a href=\"/info/#find-us\">Find us</a></li>\n                    <li><a href=\"/info/#booking\">Booking info</a></li>\n                    <li><a href=\"/info/#booking\">Ticket prices</a></li>\n                    <li><a href=\"/info/#get-involved\">Get involved</a></li>\n                </ul>\n            </div>\n            <div class=\"nav-col\">\n                <ul>\n                    <li>Listings</li>\n                    <li><a href=\"/listings/\">All listings (A-Z)</a></li>\n                    <li><a href=\"/calendar/\">Calendar</a></li>\n                    <li><a href=\"/listings/?category=live\">Live</a></li>\n                    <li><a href=\"/listings/?category=events\">Events</a></li>\n                    <li><a href=\"/bar/#events\">Art gallery</a></li>\n                </ul>\n            </div>\n            <div class=\"nav-col\">\n                <ul>\n                    <li>Share the love</li>\n                    <li><a href=\"/membership/#gifts\">Gifts</a></li>\n                    <li><a href=\"/membership/\">Support us</a></li>\n                    <li><a href=\"/info/#contact\">Advertising</a></li>\n                    <li><a href=\"/about-us/#curators\">Curators</a></li>\n                </ul>\n            </div>\n        </div>\n        <div class=\"clear\"></div>\n        <div class=\"terms\">\n            <ul>\n                <li><a href=\"/faq/\">FAQs</a></li>\n                <li><a href=\"/privacy/\">Privacy policy</a></li>\n                <li><a href=\"/terms/\">Terms &amp; conditions</a></li>\n                <li><a href=\"/access/\">Access</a></li>\n            </ul>\n            <p>&copy; 2016 The Castle Cinema</p>\n        </div>\n    </div>\n    <div class=\"clear\"></div>\n</footer>\n    <!-- Container -->\n    \n\n    \n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/salvattore/1.0.9/salvattore.min.js\" integrity=\"sha256-7DszDogKBCAj+K9LUttX3pnQ04gZkAwbnvjGx8O2KjA=\" crossorigin=\"anonymous\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/jquery/3.1.1/jquery.min.js\" integrity=\"sha256-hVVnYaiADRTO2PzUGmuLJr8BLUSjGIZsDYGmIJLv2b8=\" crossorigin=\"anonymous\"></script>\n    <script src=\"/static/lib/js/modernizr.custom.min.js\"></script>\n    <script src=\"/static/lib/js/jquery.sticky.js\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/venobox/1.9.3/venobox.min.css\" integrity=\"sha512-e+0yqAgUQFoRrJ4pZigQXpOE0S7J9IGwmgH801h4H5ODqOCG8/GRfXHQ+9ab754NL79O7wDwdjwY3CcU8sEANg==\" crossorigin=\"anonymous\" />\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/venobox/1.9.3/venobox.min.js\" integrity=\"sha512-zBTnX97k269iewUwROiWwO82A6uXO4lcjq0Z4xnvO+qAblC/RMQRUu8fQVKtSFhPNKD5Xzh9PMoZG7+LnmH1Hg==\" crossorigin=\"anonymous\"></script>\n    <script src=\"/static/js/ajax-mailchimp.js\"></script>\n\n    <script>\n      $(window).on('load', function(){\n        $(\"#main-nav\").sticky({ topSpacing: 0 });\n      });\n    \n      /**\n        * Strips (removes) all elements with the given className, \n        * but preserves their children in the DOM hierarchy.\n        *\n        * @param {HTMLElement} node       - The root node from which to start stripping.\n        * @param {string}      className  - The class name to look for.\n        */\n        function stripTagsWithClass(node, className) {\n        // If node has no children, no need to proceed.\n        if (!node || !node.children) return;\n\n        // Convert HTMLCollection/NodeList to an array so we can safely iterate\n        // even if the children change during the process.\n        const children = Array.from(node.children);\n\n        for (const child of children) {\n            // Recursively handle child's subtree first.\n            stripTagsWithClass(child, className);\n\n            // After recursion, check if this child has the target class.\n            if (child.classList && child.classList.contains(className)) {\n            // Move all child nodes (inner text, nested elements, etc.)\n            // out of the element being removed.\n            while (child.firstChild) {\n                child.parentNode.insertBefore(child.firstChild, child);\n            }\n            // Remove the now-empty element from its parent.\n            child.parentNode.removeChild(child);\n            }\n        }\n      }\n\n      $(document).ready(function(){\n\n        /* default settings */\n        $('.venobox').venobox();\n\n\n        /* custom settings */\n        $('.venobox_custom').venobox({\n            framewidth: '400px',        // default: ''\n            frameheight: '300px',       // default: ''\n            border: '10px',             // default: '0'\n            bgcolor: '#5dff5e',         // default: '#fff'\n            titleattr: 'data-title',    // default: 'title'\n            numeratio: true,            // default: false\n            infinigall: true            // default: false\n        });\n\n        /* auto-open #firstlink on page load */\n        $(\"#firstlink\").venobox().trigger('click');\n\n        const $whatson = $('#whats-on')[0];\n\n        $('#whats-on .day').click(function () {\n          var $this = $(this);\n          if (!$this.hasClass('select')) {\n            var index = $this.data('day-index');\n            $('.day').removeClass('select');\n            $this.addClass('select');\n\n            $('.day-group').css('display', 'none');\n            $('.day-group[data-day-index=\"' + index + '\"]').css('display', '');\n            stripTagsWithClass($whatson, 'column')\n            salvattore.init()\n          };\n\n          return false;\n        });\n\n        $('.mc-form .button').click(function () {\n          $(this).closest('form').submit();\n        });\n\n        $('.mc-form').ajaxChimp({\n          url: 'https://thecastlecinema.us14.list-manage.com/subscribe/post?u=951023a30af8baa6abe38e0fd&id=d4c5e98666'\n        });\n      });\n\n      $(document).ready(function(){\n        $('.random-pick').each(function() {\n          var $elements = $(this).children();\n          var elementCount = $elements.length;\n          var heroIndex = +localStorage.getItem('heroIndex');\n          heroIndex += 1;\n          if ((heroIndex == null) || (heroIndex > elementCount - 1)) {\n            heroIndex = 0;\n          }\n\n          var $visibleElement = $($elements.get(heroIndex));\n          $elements.css('display', 'none');\n          $visibleElement.css('display', '');\n          localStorage.setItem('heroIndex', heroIndex);\n        });\n      });\n    </script>\n\n    <script sr