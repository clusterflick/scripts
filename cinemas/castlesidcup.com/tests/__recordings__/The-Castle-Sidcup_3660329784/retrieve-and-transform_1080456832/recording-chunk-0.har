sponsive-image-wrapper programme-image-wrapper\" style=\"padding-bottom: 150.0%;\">\n\n\n    \n    <picture>\n        <source srcset=\"/optimised-images/c_crop,ar_128:192/w_128,h_192,f_webp,q_auto/https://thecastlecinema.com/_media/bugoniaposter.jpg, /optimised-images/c_crop,ar_128:192/w_128,h_192,f_webp,q_auto/https://thecastlecinema.com/images/default-poster.jpg\" type=\"image/webp\">\n        <source srcset=\"/optimised-images/c_crop,ar_128:192/w_128,h_192,f_jpg,q_auto/https://thecastlecinema.com/_media/bugoniaposter.jpg, /optimised-images/c_crop,ar_128:192/w_128,h_192,f_jpg,q_auto/https://thecastlecinema.com/images/default-poster.jpg\" type=\"image/jpeg\">\n        <img class=\"\" src=\"/optimised-images/c_crop,ar_128:192/w_128,h_192,f_jpg,q_auto/https://thecastlecinema.com/_media/bugoniaposter.jpg\">\n    </picture>\n\n</div>\n</div>\n                    <div class=\"info-holder\">\n                        <!--<div class=\"hero-subhead\">Now playing</div>-->\n                        <div class=\"hero-title\"><h3>Bugonia</h3></div>\n                        <div class=\"film-details\">\n                            \n                            \n                            \n                            \n                            <div class=\"film-duration comma\">118 mins</div>\n                            \n                            \n                            <div class=\"film-year comma\">2025</div>\n                            \n                            \n                            \n                            \n\n<div class=\"bbfc\">\n    <img src=\"/static/images/BBFC_15.png\" alt=\"BBFC 15\">\n</div>\n\n\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n    </section> <!-- Slider -->\n\n<section class=\"main\">\n    <div class=\"bumper\">\n\n    <div class=\"half-col film-times tablet\">\n        \n            \n\n            <h2 class=\"band\">Film times</h2>\n\n         