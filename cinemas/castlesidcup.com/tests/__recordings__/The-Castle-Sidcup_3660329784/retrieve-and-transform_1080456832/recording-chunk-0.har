t>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/jquery/3.1.1/jquery.min.js\" integrity=\"sha256-hVVnYaiADRTO2PzUGmuLJr8BLUSjGIZsDYGmIJLv2b8=\" crossorigin=\"anonymous\"></script>\n    <script src=\"/static/lib/js/modernizr.custom.min.js\"></script>\n    <script src=\"/static/lib/js/jquery.sticky.js\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/venobox/1.9.3/venobox.min.css\" integrity=\"sha512-e+0yqAgUQFoRrJ4pZigQXpOE0S7J9IGwmgH801h4H5ODqOCG8/GRfXHQ+9ab754NL79O7wDwdjwY3CcU8sEANg==\" crossorigin=\"anonymous\" />\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/venobox/1.9.3/venobox.min.js\" integrity=\"sha512-zBTnX97k269iewUwROiWwO82A6uXO4lcjq0Z4xnvO+qAblC/RMQRUu8fQVKtSFhPNKD5Xzh9PMoZG7+LnmH1Hg==\" crossorigin=\"anonymous\"></script>\n    <script src=\"/static/js/ajax-mailchimp.js\"></script>\n\n    <script>\n      $(window).on('load', function(){\n        $(\"#main-nav\").sticky({ topSpacing: 0 });\n      });\n    \n      /**\n        * Strips (removes) all elements with the given className, \n        * but preserves their children in the DOM hierarchy.\n        *\n        * @param {HTMLElement} node       - The root node from which to start stripping.\n        * @param {string}      className  - The class name to look for.\n        */\n        function stripTagsWithClass(node, className) {\n        // If node has no children, no need to proceed.\n        if (!node || !node.children) return;\n\n        // Convert HTMLCollection/NodeList to an array so we can safely iterate\n        // even if the children change during the process.\n        const children = Array.from(node.children);\n\n        for (const child of children) {\n            // Recursively handle child's subtree first.\n            stripTagsWithClass(child, className);\n\n            // After recursion, check if this child has the target class.\n            if (child.classList && child.classList.contains(className)) {\n            // Move all child nodes (inner text, nested elements, etc.)\n            // out of the element being removed.\n            while (child.firstChild) {\n                child.parentNode.insertBefore(child.firstChild, child);\n            }\n            // Remove the now-empty element from its parent.\n            child.parentNode.removeChild(child);\n            }\n        }\n      }\n\n      $(document).ready(function(){\n\n        /* default settings */\n        $('.venobox').venobox();\n\n\n        /* custom settings */\n        $('.venobox_custom').venobox({\n            framewidth: '400px',        // default: ''\n            frameheight: '300px',       // default: ''\n            border: '10px',             // default: '0'\n            bgcolor: '#5dff5e',         // default: '#fff'\n            titleattr: 'data-title',    // default: 'title'\n            numeratio: true,            // default: false\n            infinigall: true            // default: false\n        });\n\n        /* auto-open #firstlink on page load */\n        $(\"#firstlink\").venobox().trigger('click');\n\n        const $whatson = $('#whats-on')[0];\n\n        $('#whats-on .day').click(function () {\n          var $this = $(this);\n          if (!$this.hasClass('select')) {\n            var index = $this.data('day-index');\n            $('.day').removeClass('select');\n            $this.addClass('select');\n\n            $('.day-group').css('display', 'none');\n            $('.day-group[data-day-index=\"' + index + '\"]').css('display', '');\n            stripTagsWithClass($whatson, 'column')\n            salvattore.init()\n          };\n\n          return false;\n        });\n\n        $('.mc-form .button').click(function () {\n          $(this).closest('form').submit();\n        });\n\n        $('.mc-form').ajaxChimp({\n          url: 'https://thecastlecinema.us14.list-manage.com/subscribe/post?u=951023a30af8baa6abe38e0fd&id=d4c5e98666'\n        });\n      });\n\n      $(document).ready(function(){\n        $('.random-pick').each(function() {\n          var $elements = $(this).children();\n          var elementCount = $elements.length;\n          var heroIndex = +localStorage.getItem('heroIndex');\n          heroIndex += 1;\n          if ((heroIndex == null) || (heroIndex > elementCount - 1)) {\n            heroIndex = 0;\n          }\n\n          var $visibleElement = $($elements.get(heroIndex));\n          $elements.css('display', 'none');\n          $visibleElement.css('display', '');\n          localStorage.setItem('heroIndex', heroIndex);\n        });\n      });\n    </script>\n\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/classie/1.0.1/classie.min.js\" integrity=\"sha256-6O5DljdGA6AiaEVC/Zn8pNLNbQGparYTI9091fGX64k=\" crossorigin=\"anonymous\"></script>\n    <script src=\"/static/js/site.js\"></script>\n    \n\n    <script type=\"application/ld+json\">\n    {\"@context\": \"http://www.schema.org\", \"@id\": \"https://castlesidcup.com/#organization\", \"@type\": \"MovieTheater\", \"address\": {\"@type\": \"PostalAddress\", \"addressCountry\": \"United Kingdom\", \"addressLocality\": \"Sidcup\", \"addressRegion\": \"London\", \"postalCode\": \"DA14 6DS\", \"streetAddress\": \"106 High St\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": \"51.42629195524428\", \"longitude\": \"0.10148013807531617\"}, \"image\": \"https://castlesidcup.com/static/images/sidcup/castle-sidcup-temp-logo.png\", \"name\": \"Castle Sidcup\", \"url\": \"https://castlesidcup.com\"}\n    </script>\n    \n    <script type=\"application/ld+json\">\n    {\"@context\": \"http://schema.org\", \"@type\": \"ScreeningEvent\", \"@id\": \"https://castlesidcup.com/bookings/1388/\", \"name\": \"Bluey at the Cinema: Playdates with Friends\", \"description\": \"Bluey at the Cinema: Playdates with Friends\", \"location\": {\"@type\": \"MovieTheater\", \"@id\": \"https://castlesidcup.com/#organization\", \"name\": \"Castle Sidcup\", \"url\": \"https://castlesidcup.com\", \"image