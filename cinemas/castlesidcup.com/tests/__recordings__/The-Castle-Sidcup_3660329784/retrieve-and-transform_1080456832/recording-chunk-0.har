     <img class=\"\" src=\"/optimised-images/c_crop,ar_1280:581/w_1280,h_581,f_jpg,q_auto/https://thecastlecinema.com/_media/avpc_r1_rec709_g24_3996x2160_0101371.jpg\">\n    </picture>\n\n</div>\n\n            </div>\n            <div class=\"bumper mobile\">\n                <div class=\"hero-info inner\">\n                    <div class=\"film-poster\">\n\n\n\n\n\n\n\n\n<div class=\" responsive-image-wrapper programme-image-wrapper\" style=\"padding-bottom: 150.0%;\">\n\n\n    \n    <picture>\n        <source srcset=\"/optimised-images/c_crop,ar_128:192/w_128,h_192,f_webp,q_auto/https://thecastlecinema.com/_media/the-drama-poster.jpg, /optimised-images/c_crop,ar_128:192/w_128,h_192,f_webp,q_auto/https://thecastlecinema.com/images/default-poster.jpg\" type=\"image/webp\">\n        <source srcset=\"/optimised-images/c_crop,ar_128:192/w_128,h_192,f_jpg,q_auto/https://thecastlecinema.com/_media/the-drama-poster.jpg, /optimised-images/c_crop,ar_128:192/w_128,h_192,f_jpg,q_auto/https://thecastlecinema.com/images/default-poster.jpg\" type=\"image/jpeg\">\n        <img class=\"\" src=\"/optimised-images/c_crop,ar_128:192/w_128,h_192,f_jpg,q_auto/https://thecastlecinema.com/_media/the-drama-poster.jpg\">\n    </picture>\n\n</div>\n</div>\n                    <div class=\"info-holder\">\n                        <!--<div class=\"hero-subhead\">Now playing</div>-->\n                        <div class=\"hero-title\"><h3>The Drama</h3></div>\n                        <div class=\"film-details\">\n                            \n                            \n                            \n                            \n                            <div class=\"film-duration comma\">106 mins</div>\n                            \n                            \n                            <div class=\"film-year comma\">2026</div>\n                            \n                            \n                            \n                            \n\n<div class=\"bbfc\">\n    <img src=\"/s