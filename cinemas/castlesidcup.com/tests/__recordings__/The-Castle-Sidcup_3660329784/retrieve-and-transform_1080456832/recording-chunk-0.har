            "text": "\n\n\n\n<!doctype html>\n<html>\n\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"apple-mobile-web-app-title\" content=\"Castle Sidcup\">\n    <meta name=\"application-name\" content=\"Castle Sidcup\">\n    <meta name=\"theme-color\" content=\"#ffffff\">\n    <meta name=\"google-site-verification\" content=\"2jx6wSc1LPiFGgeMS3-e-a-hxA08ZyaaK0P99kOzxVw\" />\n    <meta name=\"description\" content=\"We are an independent, three screen community cinema in Sidcup.\">\n    \n    <title>NT Live: Les Liaisons Dangereuses - Castle Sidcup</title>\n    \n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/static/favicons/apple-touch-icon-sidcup.png\">\n    <link rel=\"icon\" type=\"image/png\" href=\"/static/favicons/favicon-32x32.png\" sizes=\"32x32\">\n    <link rel=\"icon\" type=\"image/png\" href=\"/static/favicons/favicon-16x16.png\" sizes=\"16x16\">\n    <link rel=\"manifest\" href=\"/static/favicons/manifest.json\">\n    <link rel=\"mask-icon\" href=\"/static/favicons/safari-pinned-tab.svg\" color=\"#f0b200\">\n    <link href=\"/static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\n    <link href=\"https://fonts.googleapis.com/css?family=Karla\" rel=\"stylesheet\">\n    <style type=\"text/css\">\n      html,\n      body {\n          margin: 0;\n          padding: 0;\n      }\n\n      * {\n          box-sizing: border-box;\n      }\n\n      .slider {\n          width: 100%;\n          margin: 5.5em auto;\n      }\n\n      .slick-slide img {\n          width: 100%;\n      }\n\n      .slick-prev:before,\n      .slick-next:before {\n          color: black;\n      }\n    </style>\n    <script>\n      (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){\n      (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),\n      m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)\n      })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');\n\n      ga('create', 'UA-87677552-1', 'auto');\n      ga('send', 'pageview');\n\n    </script>\n</head>\n\n<body>\n    <div class=\"toggle-name\">\n        <p>MENU</p>\n        <div class=\"menu-toggle\">\n            <img id=\"trigger-overlay\" type=\"button\" src=\"/static/images/menu.png\">\n        </div>\n    </div>\n    <div class=\"overlay overlay-nav\">\n        <button type=\"button\" class=\"overlay-close\"><img src=\"/static/images/cross.png\"></button>\n        <nav>\n            <ul>\n                \n\n<li><a href=\"/calendar/\">What's on</a></li>\n<li><a href=\"/membership/\">Membership</a></li>\n<li><a href=\"/membership/#gifts\">Gift Vouchers</a></li>\n<li><a href=\"/bar/\">Bar &amp; food</a></li>\n<li><a href=\"/private-hire/\">Private hire</a></li>\n<li><a href=\"/about-us/\">About us</a></li>\n<li><a href=\"/access/\">Accessibility</a></li>\n\n\n                <li>\n                    \n<ul class=\"social\">\n    <li>\n        <a href=\"http://www.instagram.com/castlesidcup\" target=\"_blank\"><img src=\"/static/images/instagram-b.png\" /></a>\n    </li>\n    <li>\n        <a href=\"https://www.facebook.com/castlesidcup\" target=\"_blank\"><img src=\"/static/images/facebook-b.png\" /></a>\n    </li>\n</ul>\n\n                </li>\n            </ul>\n        </nav>\n    </div>\n    \n        \n    \n    \n    <a href=\"https://thecastlecinema.com/\">\n        <div class=\"global-banner\" style=\"background-color: #0c9a92; color: #ffffff\">\n            <div class=\"global-banner-content\">\n                You are viewing The Castle Cinema Sidcup. [Click here to switch to Hackney] \n            </div>\n        </div>\n    </a>\n    \n\n    \n\n\n<div class=\"header inner blank\">\n    <a href=\"/\"><img class=\"inner-logo\" src=\"/static/images/sidcup/castle-sidcup-temp-logo.png\"></a>\n\n    <div id=\"main-nav\">\n        \n<ul class=\"social\">\n    <li>\n        <a href=\"http://www.instagram.com/castlesidcup\" target=\"_blank\"><img src=\"/static/images/instagram-b.png\" /></a>\n    </li>\n    <li>\n        <a href=\"https://www.facebook.com/castlesidcup\" target=\"_blank\"><img src=\"/static/images/facebook-b.png\" /></a>\n    </li>\n</ul>\n\n\n        <a href=\"/\"><img class=\"crown\" src=\"/static/images/sidcup/castle-sidcup-temp-logo.png\"></a>\n        <div class=\"nav-links inner\">\n            <ul>\n                \n\n<li><a href=\"/calendar/\">What's on</a></li>\n<li><a href=\"/membership/\">Membership</a></li>\n<li><a href=\"/membership/#gifts\">Gift Vouchers</a></li>\n<li><a href=\"/bar/\">Bar &amp; food</a></li>\n<li><a href=\"/private-hire/\">Private hire</a></li>\n<li><a href=\"/about-us/\">About us</a></li>\n<li><a href=\"/access/\">Accessibility</a></li>\n\n\n            </ul>\n        </div>\n    </div>\n</div>\n\n\n    \n    <section class=\"hero-banner\">\n        <div>\n            \n            <div class=\"hero-image inner clip btm\">\n                \n\n\n\n\n\n\n\n\n<div class=\"special responsive-image-wrapper programme-image-wrapper\" style=\"padding-bottom: 45.390625%;\">\n\n\n    \n    <picture>\n        <source srcset=\"/optimised-images/c_crop,ar_1280:581/w_1280,h_581,f_webp,q_auto/https://castlecinema.admit-one.co.uk/sites/CASTLE/CASTLE/eventImages/105591_2.jpg, /optimised-images/c_crop,ar_1280:581/w_1280,h_581,f_webp,q_auto/https://thecastlecinema.com/images/default-widescreen.jpg\" type=\"image/webp\">\n        <source srcset=\"/optimised-images/c_crop,ar_1280:581/w_1280,h_581,f_jpg,q_auto/https://castlecinema.admit-one.co.uk/sites/CASTLE/CASTLE/eventImages/105591_2.jpg, /optimised-images/c_crop,ar_1280:581/w_1280,h_581,f_jpg,q_auto/https://thecastlecinema.com/images/default-widescreen.jpg\" type=\"image/jpeg\">\n        <img class=\"\" src=\"/optimised-images/c_crop,ar_1280:581/w_1280,h_581,f_jpg,q_auto/https://castlecinema.admit-one.co.uk/sites/CASTLE/CASTLE/eventImages/105591_2.jpg\">\n    </picture>\n\n</div>\n\n            </div>\n            <div class=\"bumper mobile\">\n                <div class=\"hero-info inner\">\n                    <div class=\"film-poster\">\n\n\n\n\n\n\n\n\n<div class=\" responsive-image-wrapper programme-image-wrapper\" style=\"padding-bottom: 150.0%;\">\n\n\n    \n    <picture>\n        <source srcset=\"/optimised-images/c_crop,ar_128:192/w_128,h_192,f_webp,q_auto/https://castlecinema.admit-one.co.uk/sites/CASTLE/CASTLE/eventImages/105591_0.jpg, /optimised-images/c_crop,ar_128:192/w_128,h_192,f_webp,q_auto/https://thecastlecinema.com/images/default-poster.jpg\" type=\"image/webp\">\n        <source srcset=\"/optimised-images/c_crop,ar_128:192/w_128,h_192,f_jpg,q_auto/https://castlecinema.admit-one.co.uk/sites/CASTLE/CASTLE/eventImages/105591_0.jpg, /optimised-images/c_crop,ar_128:192/w_128,h_192,f_jpg,q_auto/https://thecastlecinema.com/images/default-poster.jpg\" type=\"image/jpeg\">\n        <img class=\"\" src=\"/optimised-images/c_crop,ar_128:192/w_128,h_192,f_jpg,q_auto/https://castlecinema.admit-one.co.uk/sites/CASTLE/CASTLE/eventImages/105591_0.jpg\">\n    </picture>\n\n</div>\n</div>\n                    <div class=\"info-holder\">\n                        <!--<div class=\"hero-subhead\">Now playing</div>-->\n                        <div class=\"hero-title\"><h3>NT Live: Les Liaisons Dangereuses</h3></div>\n                        <div class=\"film-details\">\n                            \n                            <div class=\"film-organiser comma\"><a href=\"/organisation/461/nt-live/\">NT Live</a></div>\n                            \n                            \n                            \n                            \n                            <div class=\"film-duration comma\">150 mins</div>\n                            \n                            \n                            <div class=\"film-year comma\">2026</div>\n                            \n                            \n                            \n                            \n\n<div class=\"bbfc\">\n    <img src=\"/static/images/BBFC_15.png\" alt=\"BBFC 15\">\n</div>\n\n\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n    </section> <!-- Slider -->\n\n<section class=\"main\">\n    <div class=\"bumper\">\n\n    <div class=\"half-col film-times tablet\">\n        \n            \n\n            <h2 class=\"band\">Event times</h2>\n\n            \n            <div class=\"day-times\">\n                <div class=\"day\"><h3>Thu</h3>25 Jun</div>\n                <div class=\"times\">\n                \n                    \n\n\n\n  \n\n<a class=\"performance-button button sm  \" data-perf-id=\"933\" data-filters=\"\" data-start-time=\"2026-06-25T19:00:00\" href=\"/bookings/933/\">\n    19:00\n    \n        <span class=\"sold-out\" style=\"display:none;\">sold out</span>\n        <span class=\"last-few\" style=\"display:none;\">(last few seats)</span>\n        \n        \n    \n    \n        <span class=\"screen\">S3</span>\n    \n</a>\n\n                \n                </div>\n            </div>\n            \n        \n\n    </div>\n\n    <div class=\"half-col film-description tablet\">\n      \n      \n      \n        <span class=\"film-synopsis\"><p><p>BAFTA Award-winner Lesley Manville (Phantom Thread) joins Aidan Turner (Rivals) in a striking new staging of Christopher Hampton’s celebrated adaptation of the classic novel, where among the glittering salons of the super-rich, one misstep can mean ruin.</p>\n<p>Marquise de Merteuil is a master in the art of survival. Alongside the magnetic Vicomte de Valmont, they turn seduction into strategy and weaponise desire.  But when their alliance collapses into rivalry, the battle between them threatens to destroy everyone in their path.</p>\n<p>Filmed live on stage at the National Theatre, Marianne Elliott (Angels in America) directs this thrilling game of love, lies, and social warfare.</p></p></span>\n      \n        <br>\n\n        <div class=\"meta\">\n            \n                \n                    <div class=\"meta-line\"><strong>Starring</strong>: <br>\n                    <span class=\"film-cast\">Aidan Turner, Lesley Manville, Cat Simmons</span></div>\n                \n            \n                \n                    <div class=\"meta-line\"><strong>Director</strong>: <br>\n                    <span class=\"film-director\">Marianne Elliott</span></div>\n                \n            \n                \n            \n                \n            \n                \n            \n                \n            \n        </div>\n    </div>\n\n    <div class=\"clear marg\"></div>\n    \n    <!-- Films -->\n    </div>\n\n    </section>\n\n\n    \n    <footer class=\"inner clip top\">\n        \n<div class=\"newsletter\">\n<form class=\"mc-form\">\n    \n    <span>Newsletter signup</span>\n    \n    <input id=\"mc-email\" type=\"email\" placeholder=\"Enter your email address\">\n    <div class=\"button teal dark\">Sign up</div>\n    </br>\n    <label for=\"mc-email\"></label>\n</form>\n</div>\n\n    <div class=\"footer-cols\">\n        <div class=\"third-col contact\">\n            <div class=\"contact\">\n                <h3>The Castle Cinema Sidcup</h3>\n                <p> Storyteller Building, 106 High St\n                    <br> Sidcup, London, DA14 6DS\n                    <br>\n                    <a href=\"/info/#find-us\">Map</a>\n                </p>\n                <p>\n                    <a href=\"mailto:hello@castlesidcup.com\">hello@castlesidcup.com</a>\n                </p>\n                <h3>Hours</h3>\n                <p>\n                  09:30 til late, every day (except Christmas Day!)\n                </p>\n                \n<ul class=\"social\">\n    <li>\n        <a href=\"http://www.instagram.com/castlesidcup\" target=\"_blank\"><img src=\"/static/images/instagram.png\" /></a>\n    </li>\n    <li>\n        <a href=\"https://www.facebook.com/castlesidcup\" target=\"_blank\"><img src=\"/static/images/facebook.png\" /></a>\n    </li>\n</ul>\n\n            </div>\n        </div>\n        <div class=\"twothird-col\">\n            <div class=\"nav-col\">\n                <ul class=\"first\">\n                    <li>Top menu</li>\n                    \n\n<li><a href=\"/calendar/\">What's on</a></li>\n<li><a href=\"/membership/\">Membership</a></li>\n<li><a href=\"/membership/#gifts\">Gift Vouchers</a></li>\n<li><a href=\"/bar/\">Bar &amp; food</a></li>\n<li><a href=\"/private-hire/\">Private hire</a></li>\n<li><a href=\"/about-us/\">About us</a></li>\n<li><a href=\"/access/\">Accessibility</a></li>\n\n\n                </ul>\n            </div>\n            <div class=\"nav-col\">\n                <ul class=\"first\">\n                    <li>Cinema info</li>\n                    <li><a href=\"/about-us/\">About us</a></li>\n                    <li><a href=\"/info/#contact\">Contact us</a></li>\n                    <li><a href=\"/info/#find-us\">Find us</a></li>\n                    <li><a href=\"/info/#booking\">Booking info</a></li>\n                    <li><a href=\"/info/#booking\">Ticket prices</a></li>\n                    <li><a href=\"/info/#get-involved\">Get involved</a></li>\n                </ul>\n            </div>\n            <div class=\"nav-col\">\n                <ul>\n                    <li>Listings</li>\n                    <li><a href=\"/listings/\">All listings (A-Z)</a></li>\n                    <li><a href=\"/calendar/\">Calendar</a></li>\n                    <li><a href=\"/listings/?category=live\">Live</a></li>\n                    <li><a href=\"/listings/?category=events\">Events</a></li>\n                    <li><a href=\"/bar/#events\">Art gallery</a></li>\n                </ul>\n            </div>\n            <div class=\"nav-col\">\n                <ul>\n                    <li>Share the love</li>\n                    <li><a href=\"/membership/#gifts\">Gifts</a></li>\n                    <li><a href=\"/membership/\">Support us</a></li>\n                    <li><a href=\"/info/#contact\">Advertising</a></li>\n                    <li><a href=\"/about-us/#curators\">Curators</a></li>\n                </ul>\n            </div>\n        </div>\n        <div class=\"clear\"></div>\n        <div class=\"terms\">\n            <ul>\n                <li><a href=\"/faq/\">FAQs</a></li>\n                <li><a href=\"/privacy/\">Privacy policy</a></li>\n                <li><a href=\"/terms/\">Terms &amp; conditions</a></li>\n                <li><a href=\"/access/\">Access</a></li>\n            </ul>\n            <p>&copy; 2016 The Castle Cinema</p>\n        </div>\n    </div>\n    <div class=\"clear\"></div>\n</footer>\n    <!-- Container -->\n    \n\n    \n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/salvattore/1.0.9/salvattore.min.js\" integrity=\"sha256-7DszDogKBCAj+K9LUttX3pnQ04gZkAwbnvjGx8O2KjA=\" crossorigin=\"anonymous\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/jquery/3.1.1/jquery.min.js\" integrity=\"sha256-hVVnYaiADRTO2PzUGmuLJr8BLUSjGIZsDYGmIJLv2b8=\" crossorigin=\"anonymous\"></script>\n    <script src=\"/static/lib/js/modernizr.custom.min.js\"></script>\n    <script src=\"/static/lib/js/jquery.sticky.js\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/venobox/1.9.3/venobox.min.css\" integrity=\"sha512-e+0yqAgUQFoRrJ4pZigQXpOE0S7J9IGwmgH801h4H5ODqOCG8/GRfXHQ+9ab754NL79O7wDwdjwY3CcU8sEANg==\" crossorigin=\"anonymous\" />\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/venobox/1.9.3/venobox.min.js\" integrity=\"sha512-zBTnX97k269iewUwROiWwO82A6uXO4lcjq0Z4xnvO+qAblC/RMQRUu8fQVKtSFhPNKD5Xzh9PMoZG7+LnmH1Hg==\" crossorigin=\"anonymous\"></script>\n    <script src=\"/static/js/ajax-mailchimp.js\"></script>\n\n    <script>\n      $(window).on('load', function(){\n        $(\"#main-nav\").sticky({ topSpacing: 0 });\n      });\n    \n      /**\n        * Strips (removes) all elements with the given className, \n        * but preserves their children in the DOM hierarchy.\n        *\n        * @param {HTMLElement} node       - The root node from which to start stripping.\n        * @param {string}      className  - The class name to look for.\n        */\n        function stripTagsWithClass(node, className) {\n        // If node has no children, no need to proceed.\n        if (!node || !node.children) return;\n\n        // Convert HTMLCollection/NodeList to an array so we can safely iterate\n        // even if the children change during the process.\n        const children = Array.from(node.children);\n\n        for (const child of children) {\n            // Recursively handle child's subtree first.\n            stripTagsWithClass(child, className);\n\n            // After recursion, check if this child has the target class.\n            if (child.classList && child.classList.contains(className)) {\n            // Move all child nodes (inner text, nested elements, etc.)\n            // out of the element being removed.\n            while (child.firstChild) {\n                child.parentNode.insertBefore(child.firstChild, child);\n            }\n            // Remove the now-empty element from its parent.\n            child.parentNode.removeChild(child);\n            }\n        }\n      }\n\n      $(document).ready(function(){\n\n        /* default settings */\n        $('.venobox').venobox();\n\n\n        /* custom settings */\n        $('.venobox_custom').venobox({\n            framewidth: '400px',        // default: ''\n            frameheight: '300px',       // default: ''\n            border: '10px',             // default: '0'\n            bgcolor: '#5dff5e',         // default: '#fff'\n            titleattr: 'data-title',    // default: 'title'\n            numeratio: true,            // default: false\n            infinigall: true            // default: false\n        });\n\n        /* auto-open #firstlink on page load */\n        $(\"#firstlink\").venobox().trigger('click');\n\n        const $whatson = $('#whats-on')[0];\n\n        $('#whats-on .day').click(function () {\n          var $this = $(this);\n          if (!$this.hasClass('select')) {\n            var index = $this.data('day-index');\n            $('.day').removeClass('select');\n            $this.addClass('select');\n\n            $('.day-group').css('display', 'none');\n            $('.day-group[data-day-index=\"' + index + '\"]').css('display', '');\n            stripTagsWithClass($whatson, 'column')\n            salvattore.init()\n          };\n\n          return false;\n        });\n\n        $('.mc-form .button').click(function () {\n          $(this).closest('form').submit();\n        });\n\n        $('.mc-form').ajaxChimp({\n          url: 'https://thecastlecinema.us14.list-manage.com/subscribe/post?u=951023a30af8baa6abe38e0fd&id=d4c5e98666'\n        });\n      });\n\n      $(document).ready(function(){\n        $('.random-pick').each(function() {\n          var $elements = $(this).children();\n          var elementCount = $elements.length;\n          var heroIndex = +localStorage.getItem('heroIndex');\n          heroIndex += 1;\n          if ((heroIndex == null) || (heroIndex > elementCount - 1)) {\n            heroIndex = 0;\n          }\n\n          var $visibleElement = $($elements.get(heroIndex));\n          $elements.css('display', 'none');\n          $visibleElement.css('display', '');\n          localStorage.setItem('heroIndex', heroIndex);\n        });\n      });\n    </script>\n\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/classie/1.0.1/classie.min.js\" integrity=\"sha256-6O5DljdGA6AiaEVC/Zn8pNLNbQGparYTI9091fGX64k=\" crossorigin=\"anonymous\"></script>\n    <script src=\"/static/js/site.js\"></script>\n    \n\n    <script type=\"application/ld+json\">\n    {\"@context\": \"http://www.schema.org\", \"@id\": \"https://castlesidcup.com/#organization\", \"@type\": \"MovieTheater\", \"address\": {\"@type\": \"PostalAddress\", \"addressCountry\": \"United Kingdom\", \"addressLocality\": \"Sidcup\", \"addressRegion\": \"London\", \"postalCode\": \"DA14 6DS\", \"streetAddress\": \"106 High St\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": \"51.42629195524428\", \"longitude\": \"0.10148013807531617\"}, \"image\": \"https://castlesidcup.com/static/images/sidcup/castle-sidcup-temp-logo.png\", \"name\": \"Castle Sidcup\", \"url\": \"https://castlesidcup.com\"}\n    </script>\n    \n    <script src=\"/static/lib/js/instant.page.js\" type=\"module\"></script>\n    <script src=\"https://identity.netlify.com/v1/netlify-identity-widget.js\"></script>\n</body>\n\n</html>",
