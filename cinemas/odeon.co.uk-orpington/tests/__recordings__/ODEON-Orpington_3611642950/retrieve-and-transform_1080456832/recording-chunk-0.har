            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-07\",\"showtimes\":[{\"id\":\"852-56457\",\"schedule\":{\"businessDate\":\"2026-08-07\",\"startsAt\":\"2026-08-07T10:00:00+01:00\",\"endsAt\":\"2026-08-07T11:55:00+01:00\",\"filmStartsAt\":\"2026-08-07T10:25:00+01:00\",\"filmEndsAt\":\"2026-08-07T11:55:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-3-60\",\"filmId\":\"HO00008836\",\"siteId\":\"852\",\"screenId\":\"852-3\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"852-56458\",\"schedule\":{\"businessDate\":\"2026-08-07\",\"startsAt\":\"2026-08-07T12:20:00+01:00\",\"endsAt\":\"2026-08-07T14:15:00+01:00\",\"filmStartsAt\":\"2026-08-07T12:45:00+01:00\",\"filmEndsAt\":\"2026-08-07T14:15:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-3-60\",\"filmId\":\"HO00008836\",\"siteId\":\"852\",\"screenId\":\"852-3\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"852\",\"name\":{\"text\":\"Orpington\",\"translations\":[]},\"location\":{\"latitude\":51.3766,\"longitude\":0.1012},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"odeon.orpington@odeonuk.com\",\"address\":{\"line1\":\"The Walnuts Shopping Centre\",\"line2\":\"Orpington\",\"city\":\"Kent\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008836\",\"title\":{\"text\":\"Paw Patrol: The Dino Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"After their ship gets caught in a mysterious storm, the PAW Patrol pups crash land on an uncharted tropical island filled with dinosaurs. They meet Rex, a pup who has been stranded on the island for years and has become an expert in all things dino-related. When the PAW Patrol's archrival, Mayor Humdinger, begins recklessly mining in hopes of exploiting the island for its natural resources, he inadvertently causes a huge, dormant volcano to erupt. The PAW Patrol pups are thrown into a series of high-stakes, dino-sized rescues bigger than anything they've done before, as they must stop Humdinger before everything on the island goes extinct.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After their ship gets caught in a mysterious storm, the PAW Patrol pups crash land on an uncharted tropical island filled with dinosaurs. They meet Rex.\",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-06\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=W6q8uzqfB5k\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002221\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002222\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003857\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004749\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009450\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009456\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009459\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009460\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000015584\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017638\",\"roles\":[\"Act