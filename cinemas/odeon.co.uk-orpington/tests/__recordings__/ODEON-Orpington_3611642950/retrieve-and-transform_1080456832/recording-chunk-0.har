]},{\"castAndCrewMemberId\":\"HO00000267\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002248\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b63dbbaf-6c0e-4622-b9b1-698037e6247e\",\"corporateId\":null},\"hopk\":\"HO00008916\",\"hoCode\":\"A000010058\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00009148\",\"title\":{\"text\":\"Talking Tom Heroes on the Big Screen\",\"translations\":[]},\"synopsis\":{\"text\":\"Talking Tom and his superhero friends are coming to the big screen for the first time ever! It’s an hour-long show featuring your very favorite episodes of the hit series “Talking Tom Heroes: Suddenly Super” - and also some never-before-seen surprises. You’ll even get a chance to become part of the action as you play interactive games, shout at the screen, and sing along to Tom’s hero theme. Get ready to get super, because you’ve never seen the heroes like this!\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Talking Tom and his superhero friends are coming to the big screen for the first time ever! It’s an hour-long show featuring your very favorite episodes of the hit series\",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-24\",\"runtimeInMinutes\":66,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000019487\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019488\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019489\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019490\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019491\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"03714ba9-83dd-4e66-b9ce-b829ba828b78\",\"corporateId\":null},\"hopk\":\"HO00009148\",\"hoCode\":\"A000010312\",\"eventId