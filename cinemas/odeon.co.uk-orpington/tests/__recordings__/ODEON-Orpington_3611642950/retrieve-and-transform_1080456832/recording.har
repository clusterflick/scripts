852-48022\",\"schedule\":{\"businessDate\":\"2025-11-15\",\"startsAt\":\"2025-11-15T20:30:00+00:00\",\"endsAt\":\"2025-11-15T23:08:00+00:00\",\"filmStartsAt\":\"2025-11-15T20:55:00+00:00\",\"filmEndsAt\":\"2025-11-15T23:08:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-4-55\",\"filmId\":\"HO00007459\",\"siteId\":\"852\",\"screenId\":\"852-4\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000145\",\"0000000174\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"852\",\"name\":{\"text\":\"Orpington\",\"translations\":[]},\"location\":{\"latitude\":51.3766,\"longitude\":0.1012},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"odeon.orpington@odeonuk.com\",\"address\":{\"line1\":\"The Walnuts Shopping Centre\",\"line2\":\"Orpington\",\"city\":\"Kent\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007459\",\"title\":{\"text\":\"The Running Man\",\"translations\":[]},\"synopsis\":{\"text\":\"In a near-future society, The Running Man is the top-rated show on television—a deadly competition where contestants, known as Runners, must survive 30 days while being hunted by professional assassins, with every move broadcast to a bloodthirsty public and each day bringing a greater cash reward. Desperate to save his sick daughter, working-class Ben Richards (Glen Powell) is convinced by the show’s charming but ruthless producer, Dan Killian (Josh Brolin), to enter the game as a last resort. But Ben’s defiance, instincts, and grit turn him into an unexpected fan favourite—and a threat to the entire system. As ratings skyrocket, so does the danger, and Ben must outwit not just the Hunters but a nation addicted to watching him fall.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In a near-future society, The Running Man is the top-rated show on television—a deadly competition where contestants, known as Runners, must survive 30 days.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong bloody violence, language, brief sex references\",\"translations\":[]},\"releaseDate\":\"2025-11-11\",\"runtimeInMinutes\":133,\"trailerUrl\":\"https://www.youtube.com/watch?v=ByXAgJU_X2M\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001038\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002031\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010192\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015891\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015892\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"4068\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000216\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001054\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001620\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001746\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001747\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001845\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002426\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e33681b9-a8e3-4ed7-a24a-c9ba36d92dd9\",\"corporateId\":null},\"hopk\":\"HO00007459\",\"hoCode\":\"A000008485\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00007519\",\"title\":{\"text\":\"Now You See Me: Now You Don’t\",\"translations\":[]},\"synopsis\":{\"text\":\"The Four Horsemen return along with a new generation of illusionists performing mind-melding twists, turns, surprises, and magic unlike anything ever captured on film.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Four Horsemen return along with a new generation of illusionists performing mind-melding twists,