            "mimeType": "application/json; charset=utf-8",
            "size": 2438,
            "text": "{\"businessDate\":\"2025-12-01\",\"showtimes\":[{\"id\":\"852-49178\",\"schedule\":{\"businessDate\":\"2025-12-01\",\"startsAt\":\"2025-12-01T19:00:00+00:00\",\"endsAt\":\"2025-12-01T20:52:00+00:00\",\"filmStartsAt\":\"2025-12-01T19:25:00+00:00\",\"filmEndsAt\":\"2025-12-01T20:52:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-3-54\",\"filmId\":\"HO00007402\",\"siteId\":\"852\",\"screenId\":\"852-3\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"852\",\"name\":{\"text\":\"Orpington\",\"translations\":[]},\"location\":{\"latitude\":51.3766,\"longitude\":0.1012},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"odeon.orpington@odeonuk.com\",\"address\":{\"line1\":\"The Walnuts Shopping Centre\",\"line2\":\"Orpington\",\"city\":\"Kent\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007402\",\"title\":{\"text\":\"National Theatre Live: The Fifth Step\",\"translations\":[]},\"synopsis\":{\"text\":\"Olivier Award-winner Jack Lowden (Slow Horses, Dunkirk) is joined by Emmy and BAFTA-winner Martin Freeman (The Hobbit, The Responder) in the critically acclaimed and subversively funny new play by David Ireland.\\n\\nAfter years in the 12-step programme of Alcoholics Anonymous, James becomes a sponsor to newcomer Luka. The pair bond over black coffee, trade stories and build a fragile friendship out of their shared experiences. But as Luka approaches step five – the moment of confession – dangerous truths emerge, threatening the trust on which both of their recoveries depend.\\n\\nFinn den Hertog directs the provocative and entertaining production filmed live from @sohoplace on London’s West End.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After years in the 12-step programme of Alcoholics Anonymous, James becomes a sponsor to newcomer Luka. \",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-27\",\"runtimeInMinutes\":87,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000895\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005750\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015779\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\",\"0000000009\",\"0000000039\"],\"externalIds\":{\"moviexchangeReleaseId\":\"f6f11971-8636-42da-aab9-2d664c93d9ee\",\"corporateId\":null},\"hopk\":\"HO00007402\",\"hoCode\":\"A000008422\",\"eventId\":\"0000000001\",\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"0000000895\",\"name\":{\"givenName\":\"Martin\",\"familyName\":\"Freeman\",\"middleName\":null}},{\"id\":\"0000005750\",\"name\":{\"givenName\":\"Jack \",\"familyName\":\"Lowden\",\"middleName\":null}},{\"id\":\"0000015779\",\"name\":{\"givenName\":\"Finn\",\"familyName\":\"den Hertog\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Comedy\",\"translations\":[]},\"description\":null},{\"id\":\"0000000009\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":null},{\"id\":\"0000000039\",\"name\":{\"text\":\"Live Theatre\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null