        "response": {
          "bodySize": 3088,
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 3088,
            "text": "{\"businessDate\":\"2025-12-04\",\"showtimes\":[{\"id\":\"852-48755\",\"schedule\":{\"businessDate\":\"2025-12-04\",\"startsAt\":\"2025-12-04T19:15:00+00:00\",\"endsAt\":\"2025-12-04T22:05:00+00:00\",\"filmStartsAt\":\"2025-12-04T19:40:00+00:00\",\"filmEndsAt\":\"2025-12-04T22:05:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-3-54\",\"filmId\":\"HO00007991\",\"siteId\":\"852\",\"screenId\":\"852-3\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"852\",\"name\":{\"text\":\"Orpington\",\"translations\":[]},\"location\":{\"latitude\":51.3766,\"longitude\":0.1012},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"odeon.orpington@odeonuk.com\",\"address\":{\"line1\":\"The Walnuts Shopping Centre\",\"line2\":\"Orpington\",\"city\":\"Kent\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007991\",\"title\":{\"text\":\"Merrily We Roll Along\",\"translations\":[]},\"synopsis\":{\"text\":\"Spanning three decades, MERRILY WE ROLL ALONG charts the turbulent relationship between composer Franklin Shepard and his two lifelong friends — writer Mary and lyricist & playwright Charley. Originally produced on Broadway in 1981, then becoming an inventive cult-classic ahead of its time, the musical features some of Stephen Sondheim’s most celebrated and personal songs.\\n\\nThe 2023-2024 Broadway production, directed by Maria Friedman, redefined the show for a new era, bringing Stephen Sondheim’s intricate score and George Furth’s book to vivid life with extraordinary depth and clarity. MERRILY WE ROLL ALONG shattered the Hudson Theatre’s house record on Broadway, solidifying its place as a landmark event in Broadway history. The critically acclaimed production won the 2024 Tony Awards for Best Revival of a Musical, Best Performance by an Actor in a Leading Role in a Musical, Best Performance by an Actor in a Featured Role in a Musical and Best Orchestrations. Additionally, in London, MERRILY WE ROLL ALONG garnered the most five-star reviews in West-End history.\\n\\nMERRILY WE ROLL ALONG is produced by Sonia Friedman, David Babani, Patrick Catullo, F. Richard Pappas, RadicalMedia’s Jon Kamen, and Dave Sirulnick. Executive Producers include Meredith Bennett, No Guarantees Productions, Scott Abrams, Jonathan Corr, Mary Maggio, Jeff Romley, Tony Yurgaitis, Andrew Cohen, Amanda Lipitz, Henry Tisch alongside Co-executive producer Stephanie P. McClelland. Karla Zambrano and Alec Sash serve as Supervising Producers.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Spanning three decades, MERRILY WE ROLL ALONG charts the turbulent relationship between composer Franklin Shepard and his two lifelong friends.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-04\",\"runtimeInMinutes\":145,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000626\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001190\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016924\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016925\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016926\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016927\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016928\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016929\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016930\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016931\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016932\",\"r