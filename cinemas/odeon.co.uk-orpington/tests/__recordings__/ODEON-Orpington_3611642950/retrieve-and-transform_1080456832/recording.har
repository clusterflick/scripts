1\",\"siteId\":\"852\",\"screenId\":\"852-4\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000145\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"852-49231\",\"schedule\":{\"businessDate\":\"2025-12-06\",\"startsAt\":\"2025-12-06T09:45:00+00:00\",\"endsAt\":\"2025-12-06T11:35:00+00:00\",\"filmStartsAt\":\"2025-12-06T09:55:00+00:00\",\"filmEndsAt\":\"2025-12-06T11:35:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-3-54\",\"filmId\":\"HO00007921\",\"siteId\":\"852\",\"screenId\":\"852-3\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"852-46225\",\"schedule\":{\"businessDate\":\"2025-12-06\",\"startsAt\":\"2025-12-06T19:15:00+00:00\",\"endsAt\":\"2025-12-06T22:15:00+00:00\",\"filmStartsAt\":\"2025-12-06T19:40:00+00:00\",\"filmEndsAt\":\"2025-12-06T22:40:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-7-58\",\"filmId\":\"HO00007662\",\"siteId\":\"852\",\"screenId\":\"852-7\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000048\",\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"852\",\"name\":{\"text\