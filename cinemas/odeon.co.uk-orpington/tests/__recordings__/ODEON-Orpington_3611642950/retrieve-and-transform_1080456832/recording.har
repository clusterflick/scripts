            "mimeType": "application/json; charset=utf-8",
            "size": 6412,
            "text": "{\"businessDate\":\"2025-12-02\",\"showtimes\":[{\"id\":\"852-46974\",\"schedule\":{\"businessDate\":\"2025-12-02\",\"startsAt\":\"2025-12-02T19:50:00+00:00\",\"endsAt\":\"2025-12-02T22:10:00+00:00\",\"filmStartsAt\":\"2025-12-02T20:15:00+00:00\",\"filmEndsAt\":\"2025-12-02T22:10:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-3-54\",\"filmId\":\"HO00007761\",\"siteId\":\"852\",\"screenId\":\"852-3\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"852\",\"name\":{\"text\":\"Orpington\",\"translations\":[]},\"location\":{\"latitude\":51.3766,\"longitude\":0.1012},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"odeon.orpington@odeonuk.com\",\"address\":{\"line1\":\"The Walnuts Shopping Centre\",\"line2\":\"Orpington\",\"city\":\"Kent\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007761\",\"title\":{\"text\":\"The Twilight Saga: Breaking Dawn Part 2\",\"translations\":[]},\"synopsis\":{\"text\":\"The final Twilight Saga begins with Bella now a vampire learning to use her abilities. And happy to see her daughter, Renesmee is flourishing. But when someone sees Renesmee do something that makes them think that she was turned. This person goes to the Volturi, because it is a violation to turn a child. And the penalty is death for both who turned the child into a vampire and the child, cause they deem a turned child too dangerous. Alice gets a vision of the Volturi coming after them. So the Cullens try to convince them that Renesmee is not a threat. So they ask friends and family to come stand with them. But when someone who has it in for the Volturi shows up and tells them they should be ready for a fight. And they get ready.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After the birth of Renesmee/Nessie, the Cullens gather other vampire clans in order to protect the child from a false allegation that puts the family in front of the Volt\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"Contains moderate fantasy violence\",\"translations\":[]},\"releaseDate\":\"2025-11-28\",\"runtimeInMinutes\":115,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000150\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000290\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000927\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000928\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000929\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000931\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000933\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000015117\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016457\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016458\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016460\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000143\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000172\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000564\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001172\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001621\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000009\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a34b7cd9-0627-490c-b576-b12ed55cf276\",\"corporateId\":null},\"hopk\":\"HO00007761\",\"hoCode\":\"A000008811\",\"eventId\":null,\"distributorName\":\"LIONSGATE INTERNATIONAL\"}],\"castAndCrew\":[{\"id\":\"0000000150\",\"name\":{\"givenName\":\"Robert\",\"familyName\":\"Pattinso