\"0000000006\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"852\",\"name\":{\"text\":\"Orpington\",\"translations\":[]},\"location\":{\"latitude\":51.3766,\"longitude\":0.1012},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"odeon.orpington@odeonuk.com\",\"address\":{\"line1\":\"The Walnuts Shopping Centre\",\"line2\":\"Orpington\",\"city\":\"Kent\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007169\",\"title\":{\"text\":\"Materialists\",\"translations\":[]},\"synopsis\":{\"text\":\"A young, ambitious New York City matchmaker finds herself torn between the perfect match and her imperfect ex. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A young, ambitious New York City matchmaker finds herself torn between the perfect match and her imperfect ex. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, sex references\",\"translations\":[]},\"releaseDate\":\"2025-08-13\",\"runtimeInMinutes\":117,\"trailerUrl\":\"https://www.youtube.com/watch?v=xjA6vUGNrsY\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003142\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009478\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000012345\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015298\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015299\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015300\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015301\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000150\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000812\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000813\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001007\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001640\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001671\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000018\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b2d42740-1676-4e43-b799-cd2989314a54\",\"corporateId\":null},\"hopk\":\"HO00007169\",\"hoCode\":\"A000008153\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00007459\",\"title\":{\"text\":\"The Running Man\",\"translations\":[]},\"synopsis\":{\"text\":\"In a near-future society, The Running Man is the top-rated show on television—a deadly competition where contestants, known as Runners, must survive 30 days while being hunted by professional assassins, with every move broadcast to a bloodthirsty public and each day bringing a greater cash reward. Desperate to save his sick daughter, working-class Ben Richards (Glen Powell) is convinced by the show’s charming but ruthless producer, Dan Killian (Josh Brolin), to enter the game as a last resort. But Ben’s defiance, instincts, and grit turn him into an unexpected fan favourite—and a threat to the entire system. As ratings skyrocket, so does the danger, and Ben must outwit not just the Hunters but a nation addicted to watching him fall.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In a near-future society, The Running Man is the top-rated show on television—a deadly competition where contestants, known as Runners, must survive 30 days.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong bloody violence, language, brief sex references\",\"translations\":[]},\"releaseDate\":\"2025-11-11\",\"runtimeInMinutes\":133,\"trailerUrl\":\"https://www.youtube.com/watch?v=ByXAgJU_X2M\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001038\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002031\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010192\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015891\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015892\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"4068\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000216\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001054\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001620\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001746\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001747\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001845\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002426\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e33681b9-a8e3-4ed7-a24a-c9ba36d92dd9\",\"corporateId\":null},\"hopk\":\"HO00007459\",\"hoCode\":\"A000008485\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00007462\",\"title\":{\"text\":\"Predator: Badlands\",\"translations\":[]},\"synopsis\":{\"text\":\"20th Century Studios’ “Predator: Badlands,” directed by Dan Trachtenberg (“Prey”), opens exclusively in theaters November 7, 2025. The newest entry in the “Predator” franchise is set in the future on a remote planet, where a young Predator, outcast from his clan, finds an unlikely ally in Thia (Elle Fanning) and embarks on a treacherous journey in search of the ultimate adversary. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The newest entry in the “Predator” franchise is set in the future on a remote planet, where a young Predator, outcast from his clan, finds an unlikely ally.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate violence, threat, injury detail\",\"translations\":[]},\"releaseDate\":\"2025-11-07\",\"runtimeInMinutes\":107,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000015893\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015894\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000002\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001908\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"14a05d1a-67dd-4361-816f-7dd581bf53ef\",\"corporateId\":null},\"hopk\":\"HO00007462\",\"hoCode\":\"A000008488\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00007517\",\"title\":{\"text\":\"Springsteen: Deliver Me from Nowhere\",\"translations\":[]},\"synopsis\":{\"text\":\"Bruce Springsteen's journey crafting his 1982 album Nebraska, which emerged as he recorded Born in the USA with the E Street Band. Based on Warren Zanes' book.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Bruce Springsteen's journey crafting his 1982 album Nebraska, which emerged as he recorded Born in the USA with the E Street Band. Based on Warren Zanes' book.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate threat, violence, sex, mental health theme, strong language\",\"translations\":[]},\"releaseDate\":\"2025-10-24\",\"runtimeInMinutes\":119,\"trailerUrl\":null,\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000025\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000519\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002757\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004193\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004450\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007748\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010950\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015984\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000015985\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000920\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001157\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001610\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a5d031cd-7526-4894-a0e3-35b03eb8d34c\",\"corporateId\":null},\"hopk\":\"HO00007517\",\"hoCode\":\"A000008547\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00007541\",\"title\":{\"text\":\"Gabby's Dollhouse: The Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"DreamWorks Animation elevates its global smash streaming series into its first ever cinematic adventure with Gabby’s Dollhouse: The Movie.\\n\\nSince the debut of the Gabby’s Dollhouse series in 2021, kids around the world have been having one big sprinkle party with Gabby and her friends on Netflix. Created by celebrated storytellers Traci Paige Johnson and Jennifer Twomey, Gabby's Dollhouse is a mixed media preschool series that unboxes a surprise before jumping into a fantastical animated world full of adorable cat characters that live inside Gabby’s dollhouse.\\n\\nIn the new film, Gabby (Laila Lockhart Kraner, reprising her role from the series) heads out on a road trip with her Grandma Gigi (four-time Grammy Award winner Gloria Estefan) to the urban wonderland of Cat Francisco. But when Gabby’s dollhouse, her most prized possession, ends up in the hands of an eccentric cat lady named Vera (Oscar® nominee Kristen Wiig), Gabby sets off on an adventure through the real world to get the Gabby Cats back together and save the dollhouse before it’s too late.\\n\\nThe all-star comedic voice cast includes Saturday Night Live powerhouses Ego Nwodim, Kyle Mooney and Melissa Villaseñor, as well as Emmy nominee Thomas Lennon (Reno 911!, American Dad!), Jason Mantzoukas (Invincible, Big Mouth), and Fortune Feimster (Fortune Feimster: Crushing It, Velma). The beloved series voice cast reprises their roles as Pandy Paws, CatRat, Cakey, DJ Catnip, Baby Box, MerCat and more.\\n\\nGabby’s Dollhouse: The Movie is directed by Ryan Crego (executive producer of Home: Adventures with Tip & Oh, I Heart Arlo), who earned a Children’s and Family Emmy nomination for his television feature Arlo the Alligator Boy. The film is produced by Steven Schweickart, who has served as a production supervisor or co-producer on some of DreamWorks Animation’s biggest blockbusters including How to Train Your Dragon, The Croods and most recently, Kung Fu Panda 4, which has earned almost $500 million worldwide. The film is executive produced by Jennifer Twomey and Traci Paige Johnson, based on the Gabby’s Dollhouse series created by them.\\n\\nIn 2024, according to Nielsen, the Gabby’s Dollhouse series was the ninth-most-viewed streaming original series. Netflix expanded the series to 100 total episodes, and the 11th season debuted on Netflix in February 2025.\\n\\nRooted in a growth mindset, Gabby’s activity-based episodes encourage flexible thinking and learning from your mistakes. The Gabby’s Dollhouse series has been in the Top 10 in TV in 63 countries on Netflix and has become a top preschool brand around the world, inspiring an award-winning toy line, publishing, home, apparel, and more, as well as original music, a top-rated app and a growing YouTube channel visited by millions of fans weekly. Additionally, Gabby’s Dollhouse continues to expand through Universal Destinations & Experiences theme parks, global fan experiences, live events and more.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Gabby and Grandma Gigi's road trip takes an unexpected turn when Gabby's prized dollhouse ends up with eccentric cat lady Vera. \",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":null,\"releaseDate\":\"2025-10-16\",\"runtimeInMinutes\":98,\"trailerUrl\":null,\"displayPriority\":8,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000988\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009125\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000015584\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016020\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016021\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016022\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016023\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016024\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016025\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016026\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016027\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001004\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002697\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e647bea3-9e08-4e29-a883-7343c40a9575\",\"corporateId\":null},\"hopk\":\"HO00007541\",\"hoCode\":\"A000008571\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00007636\",\"title\":{\"text\":\"Regretting You\",\"translations\":[]},\"synopsis\":{\"text\":\"Based on the bestselling book, REGRETTING YOU introduces audiences to Morgan Grant (Allison Williams) and her daughter Clara (Mckenna Grace) as they explore what’s left behind after a devastating accident reveals a shocking betrayal and forces them to confront family secrets, redefine love, and rediscover each other. REGRETTING YOU is a story of growth, resilience, and self-discovery in the aftermath of tragedy, also starring Dave Franco and Mason Thames with Scott Eastwood and Willa Fitzgerald, in theatres this October.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Based on the bestselling book, REGRETTING YOU introduces audiences to Morgan Grant (Allison Williams) and her daughter Clara (Mckenna Grace).\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate sex, drug misuse\",\"translations\":[]},\"releaseDate\":\"2025-10-24\",\"runtimeInMinutes\":115,\"trailerUrl\":null,\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000531\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000884\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001107\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001513\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004766\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005016\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016135\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016136\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000929\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001619\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00002691\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"25025eb5-6ad1-4fb9-91e6-d15a60f45870\",\"corporateId\":null},\"hopk\":\"HO00007636\",\"hoCode\":\"A000008676\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00007755\",\"title\":{\"text\":\"The Twilight Saga: New Moon\",\"translations\":[]},\"synopsis\":{\"text\":\"After Bella recovers from the vampire attack that almost claimed her life, she looks to celebrate her birthday with Edward and his family. However, a minor accident during the festivities results in Bella's blood being shed, a sight that proves too intense for the Cullens, who decide to leave the town of Forks, Washington for Bella and Edward's sake. Initially heartbroken, Bella finds a form of comfort in reckless living, as well as an even-closer friendship with Jacob Black. Danger in different forms awaits.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Edward leaves Bella after an attack that nearly claimed her life, and in her depression she falls into yet another paranormal relationship - this time with werewolf Jacob\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"Contains moderate fantasy violence and horror\",\"translations\":[]},\"releaseDate\":\"2025-11-07\",\"runtimeInMinutes\":127,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000150\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000290\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000927\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000928\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000929\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000931\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000933\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016457\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016458\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"16743\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000172\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000564\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000600\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000676\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001172\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001621\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000009\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"0a8d072a-7d74-4514-9342-6fa43de21111\",\"corporateId\":null},\"hopk\":\"HO00007755\",\"hoCode\":\"A000008805\",\"eventId\":null,\"distributorName\":\"LIONSGATE INTERNATIONAL\"},{\"id\":\"HO00007828\",\"title\":{\"text\":\"Bugonia\",\"translations\":[]},\"synopsis\":{\"text\":\"Two conspiracy obsessed young men kidnap the high-powered CEO of a major company, convinced that she is an alien intent on destroying planet Earth.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Two conspiracy obsessed young men kidnap the high-powered CEO of a major company, convinced that she is an alien intent on destroying planet Earth.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-10-31\",\"runtimeInMinutes\":118,\"trailerUrl\":\"https://www.youtube.com/watch?v=GYanIV0BNyY\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001319\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002864\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003304\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004704\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009010\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016597\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016598\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016599\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016600\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000255\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001606\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001960\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000006\",\"0000000022\"],\"externalIds\":{\"moviexchangeReleaseId\":\"6c78cc0b-e1f4-4fe4-9a8f-9abb75dc08bf\",\"corporateId\":null},\"hopk\":\"HO00007828\",\"hoCode\":\"A000008885\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00007830\",\"title\":{\"text\":\"The Choral\",\"translations\":[]},\"synopsis\":{\"text\":\"1916. As war rages on the Western Front, the Choral Society in Ramsden, Yorkshire has lost most of its men to the army. The Choral’s ambitious committee, determined to press ahead, decides to recruit local young males to swell their ranks. They must also engage a new chorus master, and despite their suspicions that he has something to hide, their best bet seems to be Dr. Henry Guthrie (Ralph Fiennes) – driven, uncompromising, and recently returned from a career in Germany. As conscription papers start to arrive, the whole community discovers that the best response to the chaos that is laying waste to their lives is to make music together.\\n\\n \\n\\nDirected by BAFTA, Olivier and Tony Award winner NICHOLAS HYTNER (The Crucible) and written by BAFTA, Olivier and Tony Award winner ALAN BENNETT, The Choral marks their fourth writer-director collaboration following the acclaimed films The Madness of King George, The History Boys, and The Lady in The Van.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"1916. As war rages on the Western Front, the Choral Society in Ramsden, Yorkshire has lost most of its men to the army. \",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate sex\",\"translations\":[]},\"releaseDate\":\"2025-11-07\",\"runtimeInMinutes\":113,\"trailerUrl\":\"https://www.youtube.com/watch?v=6zRVP-ZgMm8\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000456\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001181\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002690\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016601\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016602\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000061\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000446\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000914\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000024\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2d11e861-3222-4621-b9ca-ef1884f57c6f\",\"corporateId\":null},\"hopk\":\"HO00007830\",\"hoCode\":\"A000008887\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00007886\",\"title\":{\"text\":\"Die My Love\",\"translations\":[]},\"synopsis\":{\"text\":\"From renowned filmmaker Lynne Ramsay, DIE MY LOVE is a visceral and uncompromising portrait of a woman engulfed by love and madness. Anchored by a ferocious, tour de force performance from Jennifer Lawrence, and co-starring Robert Pattinson. \\nThe film follows Grace (Lawrence) and her partner Jackson (Pattinson), who have recently moved into an old house deep in the country. With ambitions to write The Great American Novel, Grace settles into her new environment, and the couple welcome a baby soon after. However, with Jackson frequently – and suspiciously – absent, and the pressures of domestic life starting to weigh on her, Grace begins to unravel, leaving a path of destruction in her wake. \\nBased on Ariana Harwicz’s celebrated novel and co-starring Sissy Spacek, LaKeith Stanfield and Nick Nolte, Ramsay marks her eagerly-awaited return with this fearless new cinematic vision that charts the complexity of love and how it can change and transform over time. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From renowned filmmaker Lynne Ramsay, DIE MY LOVE is a visceral and uncompromising portrait of a woman engulfed by love and madness.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"mental health theme, strong sex, nudity, language\",\"translations\":[]},\"releaseDate\":\"2025-11-07\",\"runtimeInMinutes\":119,\"trailerUrl\":null,\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000150\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000578\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003663\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014891\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016726\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000016727\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000152\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000009\",\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ae8a1736-abd9-4f9f-9b6c-125673531eb4\",\"corporateId\":null},\"hopk\":\"HO00007886\",\"hoCode\":\"A000008953\",\"eventId\":null,\"distributorName\":\"MUBI UK Ltd\"}],\"castAndCrew\":[{\"id\":\"0000003142\",\"name\":{\"givenName\":\"David\",\"familyName\":\"Hinojosa\",\"middleName\":null}},{\"id\":\"0000009478\",\"name\":{\"givenName\":\"Celine\",\"familyName\":\"Song\",\"middleName\":null}},{\"id\":\"0000012345\",\"name\":{\"givenName\":\"Dasha\",\"familyName\":\"Nekrasova\",\"middleName\":null}},{\"id\":\"0000015298\",\"name\":{\"givenName\":\"Zoe\",\"familyName\":\"Winters\",\"middleName\":null}},{\"id\":\"0000015299\",\"name\":{\"givenName\":\"Louisa\",\"familyName\":\"Jacobson\",\"middleName\":null}},{\"id\":\"0000015300\",\"name\":{\"givenName\":\"Lindsey\",\"familyName\":\"Broad\",\"middleName\":null}},{\"id\":\"0000015301\",\"name\":{\"givenName\":\"Sawyer\",\"familyName\":\"Spielberg\",\"middleName\":null}},{\"id\":\"HO00000150\",\"name\":{\"givenName\":\"Chris\",\"familyName\":\"Evans\",\"middleName\":null}},{\"id\":\"HO00000812\",\"name\":{\"givenName\":\"Christine \",\"familyName\":\"Vachon\",\"middleName\":null}},{\"id\":\"HO00000813\",\"name\":{\"givenName\":\"Pamela \",\"familyName\":\"Koffler\",\"middleName\":null}},{\"id\":\"HO00001007\",\"name\":{\"givenName\":\"Pedro\",\"familyName\":\"Pascal\",\"middleName\":null}},{\"id\":\"HO00001640\",\"name\":{\"givenName\":\"Dakota\",\"familyName\":\"Johnson\",\"middleName\":null}},{\"id\":\"HO00001671\",\"name\":{\"givenName\":\"Marin \",\"familyName\":\"Ireland\",\"middleName\":null}},{\"id\":\"0000001038\",\"name\":{\"givenName\":\"Michael\",\"familyName\":\"Cera\",\"middleName\":null}},{\"id\":\"0000002031\",\"name\":{\"givenName\":\"William H.\",\"familyName\":\"Macy\",\"middleName\":null}},{\"id\":\"0000010192\",\"name\":{\"givenName\":\"Emilia\",\"familyName\":\"Jones\",\"middleName\":null}},{\"id\":\"0000015891\",\"name\":{\"givenName\":\"Daniel\",\"familyName\":\"Ezra\",\"middleName\":null}},{\"id\":\"0000015892\",\"name\":{\"givenName\":\"Audrey\",\"familyName\":\"Chon\",\"middleName\":null}},{\"id\":\"4068\",\"name\":{\"givenName\":\"Jayme\",\"familyName\":\"Lawson\",\"middleName\":null}},{\"id\":\"HO00000216\",\"name\":{\"givenName\":\"Colman \",\"familyName\":\"Domingo\",\"middleName\":null}},{\"id\":\"HO00001054\",\"name\":{\"givenName\":\"Glen\",\"familyName\":\"Powell\",\"middleName\":null}},{\"id\":\"HO00001620\",\"name\":{\"g