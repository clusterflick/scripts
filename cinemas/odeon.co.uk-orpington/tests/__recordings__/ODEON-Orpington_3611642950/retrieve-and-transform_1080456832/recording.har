          "bodySize": 2564,
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 2564,
            "text": "{\"businessDate\":\"2026-04-21\",\"showtimes\":[{\"id\":\"852-43722\",\"schedule\":{\"businessDate\":\"2026-04-21\",\"startsAt\":\"2026-04-21T18:45:00+01:00\",\"endsAt\":\"2026-04-21T22:40:00+01:00\",\"filmStartsAt\":\"2026-04-21T19:10:00+01:00\",\"filmEndsAt\":\"2026-04-21T22:40:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-2-64\",\"filmId\":\"HO00007282\",\"siteId\":\"852\",\"screenId\":\"852-2\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000048\",\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"852\",\"name\":{\"text\":\"Orpington\",\"translations\":[]},\"location\":{\"latitude\":51.3766,\"longitude\":0.1012},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"odeon.orpington@odeonuk.com\",\"address\":{\"line1\":\"The Walnuts Shopping Centre\",\"line2\":\"Orpington\",\"city\":\"Kent\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007282\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: The Magic Flute\",\"translations\":[]},\"synopsis\":{\"text\":\"Princess Pamina has been captured. Her mother, the Queen of the Night, tasks the young Prince Tamino with her daughter’s rescue. But when Tamino and his friendly sidekick, Papageno, embark on their adventure, they soon learn that when it comes to the quest for love, nothing is as it really seems. Guided by a magic flute, they encounter monsters, villains, and a mysterious brotherhood of men – but help, it turns out, comes when you least expect it.\\nMozart’s fantastical opera glitters in David McVicar’s enchanting production. A star cast including Julia Bullock as Pamina, Amitai Pati as Tamino, Huw Montague Rendall as Papageno, Kathryn Lewek as the Queen of the Night, and Soloman Howard as Sarastro, led by French conductor Marie Jacquot in her Covent Garden debut.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Princess Pamina has been captured. Her mother, the Queen of the Night, tasks the young Prince Tamino with her daughter’s rescue.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-04-21\",\"runtimeInMinutes\":210,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000006070\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006104\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000015512\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015513\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015514\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000433\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001923\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000043\"],\"externalIds\":{\"moviexchangeReleaseId\":\"332ce0d1-a770-46a8-b6af-db950a2f7eab\",\"corporateId\":null},\"hopk\":\"HO00007282\",\"hoCode\":\"A000008288\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000006070\",\"name\":{\"givenName\":\"Soloman\",\"familyName\":\"Howard\",\"middleName\":null}},{\"id\":\"0000006104\",\"name\":{\"givenName\":\"David\",\"familyName\":\"McVicar\",\"middleName\":null}},{\"id\":\"0000015512\",\"name\":{\"givenName\":\"Julia\",\"familyName\":\"Bullock\",\"middleName\":null}},{\"id\":\"0000015513\",\"name\":{\"givenName\":\"Amitai\",\"familyName\":\"Pati\",\"middleName\":null}},{\"id\":\"0000015514\",\"name\":{\"givenName\":\"Huw\",\"familyName\":\"Montague Rendall\",\"middleName\":null}},{\"id\":\"HO00000433\",\"name\":{\"givenName\":\"Gerhard\",\"familyName\":\"Siegel\",\"middleName\":null}},{\"id\":\"HO00001923\",\"name\":{\"givenName\":\"Kathryn\",\"familyName\":\"Lewek\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000043\",\"name\":{\"text\":\"Opera\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000048\",\"name\":{\"text\":\"English (Sub)\",\"translations\":[]},\"shortName\":{\"text\":\"EnglishSub\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":10,\"isPromoted\":false},{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true},{\"id\":\"0000000030\",\"name\":{\"text\":\"Wheelchair Accessible\",\"translations\":[]},\"shortName\":{\"text\":\"Wheelchair\",\"translations\":[]},\"description\":{\"text\":\"This auditorium has bays for wheelchair users with seats beside them for accompanying guests.\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":10,\"isPromoted\":false}],\"screens\":[{\"id\":\"852-2\",\"name\":{\"text\":\"Screen 2\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000001\",\"name\":{\"text\":\"Event\",\"translations\":[]},\"shortName\":{\"text\":\"Event\",\"translations\":[]},\"description\":null,\"schedule\":{\"startDate\":null,\"endDate\":null},\"siteIds\":[\"017\",\"019\",\"031\",\"033\",\"040\",\"044\",\"050\",\"061\",\"071\",\"072\",\"073\",\"074\",\"075\",\"076\",\"077\",\"078\",\"086\",\"090\",\"124\",\"125\",\"153\",\"155\",\"158\",\"159\",\"200\",\"209\",\"220\",\"244\",\"282\",\"355\",\"380\",\"395\",\"430\",\"440\",\"453\",\"475\",\"484\",\"486\",\"498\",\"500\",\"505\",\"508\",\"510\",\"512\",\"515\",\"522\",\"530\",\"536\",\"546\",\"555\",\"560\",\"568\",\"570\",\"590\",\"593\",\"598\",\"600\",\"615\",\"694\",