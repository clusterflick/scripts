          "bodySize": 2491,
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 2491,
            "text": "{\"businessDate\":\"2026-01-14\",\"showtimes\":[{\"id\":\"852-43718\",\"schedule\":{\"businessDate\":\"2026-01-14\",\"startsAt\":\"2026-01-14T18:45:00+00:00\",\"endsAt\":\"2026-01-14T23:10:00+00:00\",\"filmStartsAt\":\"2026-01-14T19:10:00+00:00\",\"filmEndsAt\":\"2026-01-14T23:10:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-2-64\",\"filmId\":\"HO00007274\",\"siteId\":\"852\",\"screenId\":\"852-2\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"852\",\"name\":{\"text\":\"Orpington\",\"translations\":[]},\"location\":{\"latitude\":51.3766,\"longitude\":0.1012},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"odeon.orpington@odeonuk.com\",\"address\":{\"line1\":\"The Walnuts Shopping Centre\",\"line2\":\"Orpington\",\"city\":\"Kent\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007274\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: La Traviata\",\"translations\":[]},\"synopsis\":{\"text\":\"At one of her lavish parties, celebrated Parisan courtesan Violetta is introduced to Alfredo Germont. The two fall madly in love, and though hesitant to leave behind her life of luxury and freedom, Violetta follows her heart. But the young couple’s happiness is short-lived, as the harsh realities of life soon come knocking.\\nAs intimate as it is sumptuous, La traviata features some of opera’s most famous melodies, and is a star vehicle for its leading soprano role sung by Ermonela Jaho. In director Richard Eyre’s world of seductive grandeur, the tender and devastating beauty at the centre of Verdi’s opera shines bright.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"At one of her lavish parties, celebrated Parisan courtesan Violetta is introduced to Alfredo Germont. \",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-14\",\"runtimeInMinutes\":240,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002554\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015501\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015502\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015503\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015504\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015505\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015506\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015507\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"15482\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000043\"],\"externalIds\":{\"moviexchangeReleaseId\":\"bc0c66c8-a0aa-4fcb-a5d5-1c94495a8815\",\"corporateId\":null},\"hopk\":\"HO00007274\",\"hoCode\":\"A000008280\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000002554\",\"name\":{\"givenName\":\"Ermonela \",\"familyName\":\"Jaho\",\"middleName\":null}},{\"id\":\"0000015501\",\"name\":{\"givenName\":\"Giovanni\",\"familyName\":\"Sala\",\"middleName\":null}},{\"id\":\"0000015502\",\"name\":{\"givenName\":\"Aleksei\",\"familyName\":\"Isaev\",\"middleName\":null}},{\"id\":\"0000015503\",\"name\":{\"givenName\":\"Veena\",\"familyName\":\"Akama-Makia\",\"middleName\":null}},{\"id\":\"0000015504\",\"name\":{\"givenName\":\"Barnaby\",\"familyName\":\"Rea\",\"middleName\":null}},{\"id\":\"0000015505\",\"name\":{\"givenName\":\"Ellen\",\"familyName\":\"Pearson\",\"middleName\":null}},{\"id\":\"0000015506\",\"name\":{\"givenName\":\"Sam\",\"familyName\":\"Hird\",\"middleName\":null}},{\"id\":\"0000015507\",\"name\":{\"givenName\":\"Giorgi\",\"familyName\":\"Guliashvili\",\"middleName\":null}},{\"id\":\"15482\",\"name\":{\"givenName\":\"Ossian\",\"familyName\":\"Huskinson\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000043\",\"name\":{\"text\":\"Opera\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true},{\"id\":\"0000000030\",\"name\":{\"text\":\"Wheelchair Accessible\",\"translations\":[]},\"shortName\":{\"text\":\"Wheelchair\",\"translations\":[]},\"description\":{\"text\":\"This auditorium has bays for wheelchair users with seats beside them for accompanying guests.\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":10,\"isPromoted\":false}],\"screens\":[{\"id\":\"852-2\",\"name\":{\"text\":\"Screen 2\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000001\",\"name\":{\"text\":\"Event\",\"translations\":[]},\"shortName\":{\"text\":\"Event\",\"translations\":[]},\"description\":null,\"schedule\":{\"startDate\":null,\"endDate\":null},\"siteIds\":[\"017\",\"019\",\"031\",\"033\",\"040\",\"044\",\"050\",\"061\",\"071\",\"072\",\"073\",\"074\",\"075\",\"076\",\"077\",\"078\",\"086\",\"090\",\"124\",\"125\",\"153\",\"155\",\"158\",\"159\",\"200\",\"209\",\"220\",\"244\",\"282\",\"355\",\"380\",\"395\",\"430\",\"440\",\"453\",\"475\",\"484\",\"486\",\"498\",\"500\",\"505\",\"508\",\"510\",\"512\",\"515\",\"522\",\"530\",\"536\",\"546\",\"555\",\"560\",\"568\",\"570\",\"590\",\"593\",\"598\",\"600\",\"615\",\"694\",\"695\",\"734\",\"750\",\"755\",\"756\",\"757\",\"758\",\"759\",\"760\",\"761\",\"800\",\"806\",\"82