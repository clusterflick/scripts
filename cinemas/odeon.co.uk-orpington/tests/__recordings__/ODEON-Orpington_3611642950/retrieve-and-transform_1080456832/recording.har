          "bodySize": 2231,
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 2231,
            "text": "{\"businessDate\":\"2026-02-05\",\"showtimes\":[{\"id\":\"852-44607\",\"schedule\":{\"businessDate\":\"2026-02-05\",\"startsAt\":\"2026-02-05T18:45:00+00:00\",\"endsAt\":\"2026-02-05T20:22:00+00:00\",\"filmStartsAt\":\"2026-02-05T19:10:00+00:00\",\"filmEndsAt\":\"2026-02-05T20:22:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-3-54\",\"filmId\":\"HO00007331\",\"siteId\":\"852\",\"screenId\":\"852-3\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"852\",\"name\":{\"text\":\"Orpington\",\"translations\":[]},\"location\":{\"latitude\":51.3766,\"longitude\":0.1012},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"odeon.orpington@odeonuk.com\",\"address\":{\"line1\":\"The Walnuts Shopping Centre\",\"line2\":\"Orpington\",\"city\":\"Kent\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007331\",\"title\":{\"text\":\"R.E.M. X Buster Keaton's Sherlock Jr.\",\"translations\":[]},\"synopsis\":{\"text\":\"Silents Synced pairs classic silent movies with epic rock music to bring audiences a unique big screen experience. Buster Keaton’s 1924 comedy classic is reimagined with R.E.M. 's alt-rock masterpieces Monster (1994) and New Adventures in Hi-Fi (1996).\\n\\nIn this sublime comedy teetering between reality and illusion, Buster Keaton stars as a film projectionist who dreams of becoming a detective. He uses his limited skills when he is framed by a rival for stealing his girlfriend’s father’s pocket watch. Keaton reportedly broke his neck performing one of the many dangerous practical stunts in the film.\\n\\nWhether you’re a movie lover or a rock music fan this is an experience you won’t want to miss!!\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Silents Synced pairs classic silent movies with epic rock music to bring audiences a unique big screen experience.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-05\",\"runtimeInMinutes\":72,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000055\"],\"externalIds\":{\"moviexchangeReleaseId\":\"6862c9ac-cc5c-46e7-a2fa-a058a8f70212\",\"corporateId\":null},\"hopk\":\"HO00007331\",\"hoCode\":\"A000008347\",\"eventId\":\"0000000001\",\"distributorName\":\"CinemaLive Limited\"}],\"castAndCrew\":[],\"genres\":[{\"id\":\"0000000055\",\"name\":{\"text\":\"Music\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true},{\"id\":\"0000000030\",\"name\":{\"text\":\"Wheelchair Accessible\",\"translations\":[]},\"shortName\":{\"text\":\"Wheelchair\",\"translations\":[]},\"description\":{\"text\":\"This auditorium has bays for wheelchair users with seats beside them for accompanying guests.\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":10,\"isPromoted\":false}],\"screens\":[{\"id\":\"852-3\",\"name\":{\"text\":\"Screen 3\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000001\",\"name\":{\"text\":\"Event\",\"translations\":[]},\"shortName\":{\"text\":\"Event\",\"translations\":[]},\"description\":null,\"schedule\":{\"startDate\":null,\"endDate\":null},\"siteIds\":[