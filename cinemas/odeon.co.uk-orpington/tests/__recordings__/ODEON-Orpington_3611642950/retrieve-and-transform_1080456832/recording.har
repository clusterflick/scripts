,\"endsAt\":\"2025-11-25T22:55:00+00:00\",\"filmStartsAt\":\"2025-11-25T19:40:00+00:00\",\"filmEndsAt\":\"2025-11-25T22:55:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-2-64\",\"filmId\":\"HO00007268\",\"siteId\":\"852\",\"screenId\":\"852-2\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000174\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"852-46973\",\"schedule\":{\"businessDate\":\"2025-11-25\",\"startsAt\":\"2025-11-25T19:50:00+00:00\",\"endsAt\":\"2025-11-25T22:12:00+00:00\",\"filmStartsAt\":\"2025-11-25T20:15:00+00:00\",\"filmEndsAt\":\"2025-11-25T22:12:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-3-54\",\"filmId\":\"HO00007759\",\"siteId\":\"852\",\"screenId\":\"852-3\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"852-48809\",\"schedule\":{\"businessDate\":\"2025-11-25\",\"startsAt\":\"2025-11-25T20:00:00+00:00\",\"endsAt\":\"2025-11-25T22:43:00+00:00\",\"filmStartsAt\":\"2025-11-25T20:25:00+00:00\",\"filmEndsAt\":\"2025-11-25T22:43:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-7-71\",\"filmId\":\"HO00007320\",\"siteId\":\"852\",\"screenId\":\"852-7\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"852-57-HO00007320\"}],\"relatedData\":{\"sites\":[{\"id\":\"852\",\"name\":{\"text\":\"Orpington\",\"translations\":[]},\"location\":{\"latitude\":51.3766,\"longitude\":0.1012},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"odeon.orpington@odeonuk.com\",\"address\":{\"line1\":\"The Walnuts Shopping Centre\",\"line2\":\"Orpington\",\"city\":\"Kent\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007268\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: Cinderella\",\"translations\":[]},\"synopsis\":{\"text\":\"Stuck at home and put to work by her spoiled Step-Sisters, Cinderella’s life is dreary and dull. Everything changes when she helps a mysterious woman out...With a little bit of magic, she is transported into an ethereal new world – one where fairies bring the gifts of the seasons, where pumpkins turn into carriages, and where true love awaits. \\nThis enchanting ballet by The Royal Ballet’s Founding Choreographer Frederick Ashton is a theatrical experience for all the family and will transport you into an ethereal world where a sprinkling of fairy dust makes dreams come true.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Stuck at home and put to work by her spoiled Step-Sisters, Cinderella’s life is dreary and dull. Everything changes when she helps a mysterious woman out...\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-25\",\"runtimeInMinutes\":195,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003762\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006080\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006081\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015495\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015496\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015497\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015498\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015499\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015500\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12824\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"6144\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":\"bc7d24db-941d-455b-9e7a-5811d8bd908a\",\"corporateId\":null},\"hopk\":\"HO00007268\",\"hoCode\":\"A000008274\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"},{\"id\":\"HO00007320\",\"title\":{\"text\":\"Wicked: For Good\",\"translations\":[]},\"synopsis\":{\"text\":\"And now whatever way our stories end, I know you have rewritten mine by being my friend …\\n\\nLast year’s global cinematic cultural sensation, which became the most successful Broadway film adaptation of all time, now reaches its epic, electrifying, emotional conclusion in Wicked: For Good.\\n\\nDirected once again by award-winning director Jon M. Chu and starring the spectacular returning cast, led by Academy Award® nominated superstars Cynthia Erivo and Ariana Grande, the final chapter of the untold story of the witches of Oz begins with Elphaba and Glinda estranged and living with the consequences of their choices.\\n\\nElphaba (Cynthia Erivo), now demonized as The Wicked Witch of the West, lives in exile, hidden within the Ozian forest while continuing her fight for the freedom of Oz’s silenced Animals and desperately trying to expose the truth she knows about The Wizard (Jeff Goldblum).\\n\\nGlinda, meanwhile, has become the glamorous symbol of Goodness for all of Oz, living at the palace in Emerald City and reveling in the perks of fame and popularity. Under the instruction of Madame Morrible (Oscar® winner Michelle Yeoh), Glinda is deployed to serve as an effervescent comfort to Oz, reassuring the masses that all is well under the rule of The Wizard.\\n\\nAs Glinda’s stardom expands and she prepares to marry Prince Fiyero (Olivier award winner and Emmy and SAG nominee Jonathan Bailey) in a spectacular Ozian wedding, she is haunted by her separation from Elphaba. She attempts to broker a conciliation between Elphaba and The Wizard, but those efforts will fail, driving Elphaba and Glinda only further apart. The aftershocks will transform Boq (Tony nominee Ethan Slater) and Fiyero forever, and threaten the safety of Elphaba’s sister, Nessarose (Marissa Bode), when a girl from Kansas comes crashing into all their lives.\\n\\nAs an angry mob rises against the Wicked Witch, Glinda and Elphaba will need to come together one final time. With their singular friendship now the fulcrum of their futures, they will need to truly see each other, with honesty and empathy, if they are to change themselves, and all of Oz, for good.\\n\\nWicked: For Good also stars Emmy nominee Bowen Yang and Bronwyn James as Glinda’s fawning assistants, Pfannee and ShenShen and BAFTA and Grammy nominee Sharon D. Clarke (Caroline, or Change) as the voice of Elphaba’s childhood nanny, Dulcibear.\\n\\nThe film is produced by returning Tony and Emmy winning powerhouse Marc Platt p.g.a. and by multiple Tony winner David Stone. The executive producers are Stephen Schwartz, David Nicksay, Jared LeBoff, Winnie Holzman and Dana Fox. The first film, Wicked, released in November 2024, earned 10 Academy Award® nominations, including Best Picture, and won the Oscars® for Costume Design and Production Design. To date, the film has grossed $750 million worldwide.\\n\\nWicked: For Good is based on the generation-defining musical stage play with music and lyrics by legendary Grammy and Oscar® winning composer and lyricist Stephen Schwartz and book by Winnie Holzman, from the bestselling novel by Gregory Maguire. The screenplay is by Winnie Holzman and Winnie Holzman & Dana Fox. The film score is by John Powell & Stephen Schwartz, with music and lyrics by Stephen Schwartz.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"And now whatever way our stories end, I know you have rewritten mine by being my friend …\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat, violence, innuendo, language\",\"translations\":[]},\"releaseDate\":\"2025-11-21\",\"runtimeInMinutes\":138,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000974\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010640\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012337\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012338\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012339\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012341\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012342\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000029\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000118\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001041\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001761\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4bdf55f3-2cb7-4623-9759-0d012395c794\",\"corporateId\":null},\"hopk\":\"HO00007320\",\"hoCode\":\"A000008332\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00007759\",\"title\":{\"text\":\"The Twilight Saga: Breaking Dawn Part 1 \",\"translations\":[]},\"synopsis\":{\"text\":\"After Bella and Edward's honeymoon, things take a turn for the worse when Bella realises she is pregnant. The baby grows at an abnormally fast rate and causes many health problems to Bella. The wolf pack see the unborn child as a threat and plan to get rid of it. But the Cullens do everything they can to ensure that both Bella and the unborn child remain safe.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Quileutes close in on expecting parents Edward and Bella, whose unborn child poses a threat to the Wolf Pack and the towns people of Forks.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"Contains moderate sex and violence\",\"translations\":[]},\"releaseDate\":\"2025-11-21\",\"runtimeInMinutes\":117,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000150\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000927\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000928\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000929\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000931\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000933\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000015117\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016457\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016458\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016460\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000143\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000172\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000564\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001621\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000009\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"431ab8c3-1b3e-4835-b72c-d443a3746f3a\",\"corporateId\":null},\"hopk\":\"HO00007759\",\"hoCode\":\"A000008809\",\"eventId\":null,\"distributorName\":\"LIONSGATE INTERNATIONAL\"}],\"castAndCrew\":[{\"id\":\"0000003762\",\"name\":{\"givenName\":\"Isabella\",\"familyName\":\"Gasparini\",\"middleName\":null}},{\"id\":\"0000006080\",\"name\":{\"givenName\":\"William\",\"familyName\":\"Bracewell\",\"middleName\":null}},{