            "text": "{\"businessDate\":\"2025-11-19\",\"showtimes\":[{\"id\":\"852-48311\",\"schedule\":{\"businessDate\":\"2025-11-19\",\"startsAt\":\"2025-11-19T19:45:00+00:00\",\"endsAt\":\"2025-11-19T22:10:00+00:00\",\"filmStartsAt\":\"2025-11-19T20:10:00+00:00\",\"filmEndsAt\":\"2025-11-19T22:10:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-3-54\",\"filmId\":\"HO00000157\",\"siteId\":\"852\",\"screenId\":\"852-3\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"852\",\"name\":{\"text\":\"Orpington\",\"translations\":[]},\"location\":{\"latitude\":51.3766,\"longitude\":0.1012},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"odeon.orpington@odeonuk.com\",\"address\":{\"line1\":\"The Walnuts Shopping Centre\",\"line2\":\"Orpington\",\"city\":\"Kent\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00000157\",\"title\":{\"text\":\"Screen Unseen (19 November)\",\"translations\":[]},\"synopsis\":{\"text\":\"Join us for Screen Unseen to watch highly-acclaimed, pre-release films from just £6*. But there’s a twist in the plot... you won’t know which film you’re seeing until the cinema lights go down. Can you handle the suspense? \\r\\n\\r\\nScreen Unseen is an over 15s event (unless otherwise stated). But the film you see could be rated anything from a U to 15. We won't tell you the run time but you’ll see the whole film, which usually lasts between 90 and 180 minutes. There will be a pre-feature reel beforehand,  however please be in your seats at the advertised time so you don't miss the start of the film!\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Exclusive preview screenings with a twist! You book in advance but you don't know what film you're about to see until the curtains go up.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-19\",\"runtimeInMinutes\":120,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000016\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":\"A000000134\"},\"hopk\":\"HO00000157\",\"hoCode\":\"A000000134\",\"eventId\":null,\"distributorName\":\"ODEON/UCI (Dummy Distributor)\"}],\"castAndCrew\":[],\"genres\":[{\"id\":\"0000000016\",\"name\":{\"text\":\"Mystery\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000005\",\"classification\":{\"text\":\"18\",\"translations\":[]},\"classificationDescription\":{\"text\":\"18\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":18}}],\"attributes\":[{\"id\":\"0000000030\",\"name\":{\"text\":\"Wheelchair Accessible\",\"translations\":[]},\"shortName\":{\"text\":\"Wheelchair\",\"translations\":[]},\"description\":{\"text\":\"This auditorium has bays for wheelchair users with seats beside them for accompanying guests.\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":10,\"isPromoted\":false}],\"screens\":[{\"id\":\"852-3\",\"name\":{\"text\":\"Screen 3\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"852-0000000001\",\"name\":{\"text\":\"Classic Saver\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false},{\"id\":\"852-0000000002\",\"name\":{\"text\":\"Premier\",\"translations\":[]},\"hopk\":\"0000000001\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false},{\"id\":\"852-0000000017\",\"name\":{\"text\":\"Classic Popular\",\"translations\":[]},\"hopk\":\"0000000025\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}"
