h seats beside them for accompanying guests.\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":10,\"isPromoted\":false},{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true}],\"screens\":[{\"id\":\"852-4\",\"name\":{\"text\":\"Screen 4\",\"translations\":[]}},{\"id\":\"852-2\",\"name\":{\"text\":\"Screen 2\",\"translations\":[]}},{\"id\":\"852-7\",\"name\":{\"text\":\"Screen 7\",\"translations\":[]}},{\"id\":\"852-3\",\"name\":{\"text\":\"Screen 3\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000001\",\"name\":{\"text\":\"Event\",\"translations\":[]},\"shortName\":{\"text\":\"Event\",\"translations\":[]},\"description\":null,\"schedule\":{\"startDate\":null,\"endDate\":null},\"siteIds\":[\"017\",\"019\",\"031\",\"033\",\"040\",\"044\",\"050\",\"061\",\"071\",\"072\",\"073\",\"074\",\"075\",\"076\",\"077\",\"078\",\"086\",\"090\",\"124\",\"125\",\"153\",\"155\",\"158\",\"159\",\"200\",\"209\",\"220\",\"244\",\"282\",\"355\",\"380\",\"395\",\"430\",\"440\",\"453\",\"475\",\"484\",\"486\",\"498\",\"500\",\"505\",\"508\",\"510\",\"512\",\"515\",\"522\",\"530\",\"536\",\"546\",\"555\",\"560\",\"568\",\"570\",\"590\",\"593\",\"598\",\"600\",\"615\",\"694\",\"695\",\"734\",\"750\",\"755\",\"756\",\"757\",\"758\",\"759\",\"760\",\"761\",\"800\",\"806\",\"824\",\"838\",\"841\",\"842\",\"843\",\"845\",\"846\",\"847\",\"848\",\"849\",\"850\",\"851\",\"852\",\"853\",\"854\",\"856\",\"857\",\"858\",\"859\",\"860\",\"888\",\"912\",\"915\",\"916\",\"917\",\"920\",\"923\",\"925\",\"929\",\"930\",\"948\",\"949\",\"953\",\"954\",\"955\",\"957\",\"961\",\"962\",\"963\",\"980\",\"985\",\"995\",\"998\"]}],\"filmAdvanceBookingRules\":[{\"id\":\"852-57-HO00007320\",\"filmId\":\"HO00007320\",\"siteId\":\"852\",\"bookingPeriods\":[{\"startsAt\":\"2025-10-30T00:00:00+00:00\",\"orderBookingModes\