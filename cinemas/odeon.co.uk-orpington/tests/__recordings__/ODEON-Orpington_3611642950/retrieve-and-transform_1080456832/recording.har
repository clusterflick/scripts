            "text": "{\"businessDate\":\"2025-12-09\",\"showtimes\":[{\"id\":\"852-46227\",\"schedule\":{\"businessDate\":\"2025-12-09\",\"startsAt\":\"2025-12-09T19:15:00+00:00\",\"endsAt\":\"2025-12-09T22:15:00+00:00\",\"filmStartsAt\":\"2025-12-09T19:40:00+00:00\",\"filmEndsAt\":\"2025-12-09T22:40:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-7-58\",\"filmId\":\"HO00007662\",\"siteId\":\"852\",\"screenId\":\"852-7\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000048\",\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"852\",\"name\":{\"text\":\"Orpington\",\"translations\":[]},\"location\":{\"latitude\":51.3766,\"longitude\":0.1012},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"odeon.orpington@odeonuk.com\",\"address\":{\"line1\":\"The Walnuts Shopping Centre\",\"line2\":\"Orpington\",\"city\":\"Kent\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007662\",\"title\":{\"text\":\"Andre Rieu's 2025 Christmas: Merry Christmas\",\"translations\":[]},\"synopsis\":{\"text\":\"This holiday season, the magic begins on the big screen. Join André Rieu for his 2025 \\nChristmas Concert – “Merry Christmas” and experience joyful carols, beautiful waltzes, \\nand plenty of surprises – it’s the ultimate Christmas cinema event!  \\nWith his fabulous Johann Strauss Orchestra, and special guests including the \\nsensational Emma Kok and over 400 brass players bringing the majestic sound of \\nChristmas, André’s concert is bursting with warmth, laughter, and holiday cheer. \\nChristmas is André’s favourite time of year - and he can’t wait to share this spectacular \\nconcert with you, only in cinemas!\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"This holiday season, the magic begins on the big screen. Join André Rieu for his 2025 \\nChristmas Concert – “Merry Christmas” and experience joyful carols.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-06\",\"runtimeInMinutes\":155,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"6669\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000335\",\"roles\":[\"Actor\",\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000035\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2ada62d8-904b-43fd-8798-15b61a8fe5b4\",\"corporateId\":null},\"hopk\":\"HO00007662\",\"hoCode\":\"A000008703\",\"eventId\":\"0000000001\",\"distributorName\":\"PIECE OF MAGIC\"}],\"castAndCrew\":[{\"id\":\"6669\",\"name\":{\"givenName\":\"Michel\",\"familyName\":\"Fizzano\",\"middleName\":null}},{\"id\":\"HO00000335\",\"name\":{\"givenName\":\"André\",\"familyName\":\"Rieu\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000035\",\"name\":{\"text\":\"Live Concert\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000048\",\"name\":{\"text\":\"English (Sub)\",\"translations\":[]},\"shortName\":{\"text\":\"EnglishSub\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":10,\"isPromoted\":false},{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true},{\"id\":\"0000000030\",\"name\":{\"text\":\"Wheelchair Accessible\",\"translations\":[]},\"shortName\":{\"text\