":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"852\",\"name\":{\"text\":\"Orpington\",\"translations\":[]},\"location\":{\"latitude\":51.3766,\"longitude\":0.1012},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"odeon.orpington@odeonuk.com\",\"address\":{\"line1\":\"The Walnuts Shopping Centre\",\"line2\":\"Orpington\",\"city\":\"Kent\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007316\",\"title\":{\"text\":\"Zootropolis 2\",\"translations\":[]},\"synopsis\":{\"text\":\"Brave rabbit cop Judy Hopps and her friend, the fox Nick Wilde, team up again to crack a new case, the most perilous and intricate of their careers.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Brave rabbit cop Judy Hopps and her friend, the fox Nick Wilde, team up again to crack a new case, the most perilous and intricate of their careers.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-28\",\"runtimeInMinutes\":100,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003440\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000003441\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003443\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006395\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008394\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015583\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015584\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000082\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000488\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002397\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"87004e42-c4bd-4468-8b83-00f122c59dd9\",\"corporateId\":null},\"hopk\":\"HO00007316\",\"hoCode\":\"A000008328\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00007320\",\"title\":{\"text\":\"Wicked: For Good\",\"translations\":[]},\"synopsis\":{\"text\":\"And now whatever way our stories end, I know you have rewritten mine by being my friend …\\n\\nLast year’s global cinematic cultural sensation, which became the most successful Broadway film adaptation of all time, now reaches its epic, electrifying, emotional conclusion in Wicked: For Good.\\n\\nDirected once again by award-winning director Jon M. Chu and starring the spectacular returning cast, led by Academy Award® nominated superstars Cynthia Erivo and Ariana Grande, the final chapter of the untold story of the witches of Oz begins with Elphaba and Glinda estranged and living with the consequences of their choices.\\n\\nElphaba (Cynthia Erivo), now demonized as The Wicked Witch of the West, lives in exile, hidden within the Ozian forest while continuing her fight for the freedom of Oz’s silenced Animals and desperately trying to expose the truth she knows about The Wizard (Jeff Goldblum).\\n\\nGlinda, meanwhile, has become the glamorous symbol of Goodness for all of Oz, living at the palace in Emerald City and reveling in the perks of fame and popularity. Under the instruction of Madame Morrible (Oscar® winner Michelle Yeoh), Glinda is deployed to serve as an effervescent comfort to Oz, reassuring the masses that all is well under the rule of The Wizard.\\n\\nAs Glinda’s stardom expands and she prepares to marry Prince Fiyero (Olivier award winner and Emmy and SAG nominee Jonathan Bailey) in a spectacular Ozian wedding, she is haunted by her separation from Elphaba. She attempts to broker a conciliation between Elphaba and The Wizard, but those efforts will fail, driving Elphaba and Glinda only further apart. The aftershocks will transform Boq (Tony nominee Ethan Slater) and Fiyero forever, and threaten the safety of Elphaba’s sister, Nessarose (Marissa Bode), when a girl from Kansas comes crashing into all their lives.\\n\\nAs an angry mob rises against the Wicked Witch, Glinda and Elphaba will need to come together one final time. With their singular friendship now the fulcrum of their futures, they will need to truly see each other, with honesty and empathy, if they are to change themselves, and all of Oz, for good.\\n\\nWicked: For Good also stars Emmy nominee Bowen Yang and Bronwyn James as Glinda’s fawning assistants, Pfannee and ShenShen and BAFTA and Grammy nominee Sharon D. Clarke (Caroline, or Change) as the voice of Elphaba’s childhood nanny, Dulcibear.\\n\\nThe film is produced by returning Tony and Emmy winning powerhouse Marc Platt p.g.a. and by multiple Tony winner David Stone. The executive producers are Stephen Schwartz, David Nicksay, Jared LeBoff, Winnie Holzman and Dana Fox. The first film, Wicked, released in November 2024, earned 10 Academy Award® nominations, including Best Picture, and won the Oscars® for Costume Design and Production Design. To date, the film has grossed $750 million worldwide.\\n\\nWicked: For Good is based on the generation-defining musical stage play with music and lyrics by legendary Grammy and Oscar® winning composer and lyricist Stephen Schwartz and book by Winnie Holzman, from the bestselling novel by Gregory Maguire. The screenplay is by Winnie Holzman and Winnie Holzman & Dana Fox. The film score is by John Powell & Stephen Schwartz, with music and lyrics by Stephen Schwartz.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"And now whatever way our stories end, I know you have rewritten mine by being my friend …\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat, violence, innuendo, language\",\"translations\":[]},\"releaseDate\":\"2025-11-21\",\"runtimeInMinutes\":138,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000974\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010640\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012337\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012338\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012339\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012341\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012342\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000029\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000118\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001041\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001761\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4bdf55f3-2cb7-4623-9759-0d012395c794\",\"corporateId\":null},\"hopk\":\"HO00007320\",\"hoCode\":\"A000008332\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00007896\",\"title\":{\"text\":\"Westlife - Royal Albert Hall (25th Anniversary)\",\"translations\":[]},\"synopsis\":{\"text\":\"Experience an unforgettable celebration as for the first time ever, Westlife take centre stage at London’s iconic Royal Albert Hall for a fun-filled night of nostalgia honouring 25 magnificent years of chart-topping music. Selling over 55 millions records worldwide and with an incredible 14 No.1 singles, Westlife have established themselves as a defining force within pop and one of the world’s biggest bands of the 21st century.  \\nTo mark their 25th anniversary, the band will be joined by the renowned Royal Philharmonic Concert Orchestra, bringing Westlife’s biggest hits and fan favourites like Flying Without Wings, Your Raise Me Up and Uptown Girl to life like never before and with the glittering Gatsby-themed stage, this event promises a visual and musical feast for fans and newcomers alike. \\nThis is not just a concert — it's a cinematic celebration of a legendary band and their enduring legacy. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Experience an unforgettable celebration as for the first time ever, Westlife take centre stage at London’s iconic Royal Albert Hall for a fun-filled night of nostalgia.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-29\",\"runtimeInMinutes\":110,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000035\"],\"externalIds\":{\"moviexchangeReleaseId\":\"1db15e27-5d1e-444b-9820-7da8eff3d385\",\"corporateId\":null},\"hopk\":\"HO00007896\",\"hoCode\":\"A000008964\",\"eventId\":\"0000000001\",\"distributorName\":\"CinemaLive Limited\"}],\"castAndCrew\":[{\"id\":\"0000003440\",\"name\":{\"givenName\":\"Byron\",\"familyName\":\"Howard\",\"middleName\":null}},{\"id\":\"0000003441\",\"name\":{\"givenName\":\"Jared\",\"familyName\":\"Bush\",\"middleName\":null}},{\"id\":\"0000003443\",\"name\":{\"givenName\":\"Yvett Merino\",\"familyName\":\"Flores\",\"middleName\":null}},{\"id\":\"0000006395\",\"name\":{\"givenName\":\"Jason\",\"familyName\":\"Bateman\",\"middleName\":null}},{\"id\":\"0000008394\",\"name\":{\"givenName\":\"Ginnifer\",\"familyName\":\"Goodwin\",\"middleName\":null}},{\"id\":\"0000015583\",\"name\":{\"givenName\":\"Rolando\",\"familyName\":\"Davila-Beltran\",\"middleName\":null}},{\"id\":\"0000015584\",\"name\":{\"givenName\":\"Fortune\",\"familyName\":\"Feimster\",\"middleName\":null}},{\"id\":\"HO00000082\",\"name\":{\"givenName\":\"Jennifer\",\"familyName\":\"Lee\",\"middleName\":null}},{\"id\":\"HO00000488\",\"name\":{\"givenName\":\"Shakira\",\"familyName\":\"\",\"middleName\":null}},{\"id\":\"HO00002397\",\"name\":{\"givenName\":\"Ke\",\"familyName\":\"Huy Quan\",\"middleName\":null}},{\"id\":\"0000000974\",\"name\":{\"givenName\":\"Jeff\",\"familyName\":\"Goldblum\",\"middleName\":null}},{\"id\":\"0000010640\",\"name\":{\"givenName\":\"Bowen\",\"familyName\":\"Yang\",\"middleName\":null}},{\"id\":\"0000012337\",\"name\":{\"givenName\":\"Ariana\",\"familyName\":\"Grande\",\"middleName\":null}},{\"id\":\"0000012338\",\"name\":{\"givenName\":\"Mariss