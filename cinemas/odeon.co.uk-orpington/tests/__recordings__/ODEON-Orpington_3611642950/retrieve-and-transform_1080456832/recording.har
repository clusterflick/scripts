            "text": "{\"businessDate\":\"2025-12-14\",\"showtimes\":[{\"id\":\"852-45422\",\"schedule\":{\"businessDate\":\"2025-12-14\",\"startsAt\":\"2025-12-14T14:00:00+00:00\",\"endsAt\":\"2025-12-14T17:55:00+00:00\",\"filmStartsAt\":\"2025-12-14T14:25:00+00:00\",\"filmEndsAt\":\"2025-12-14T17:55:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-3-54\",\"filmId\":\"HO00007270\",\"siteId\":\"852\",\"screenId\":\"852-3\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"852\",\"name\":{\"text\":\"Orpington\",\"translations\":[]},\"location\":{\"latitude\":51.3766,\"longitude\":0.1012},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"odeon.orpington@odeonuk.com\",\"address\":{\"line1\":\"The Walnuts Shopping Centre\",\"line2\":\"Orpington\",\"city\":\"Kent\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007270\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: The Nutcracker\",\"translations\":[]},\"synopsis\":{\"text\":\"The magician Herr Drosselmeyer needs to save his nephew. Hans-Peter has been transformed into a Nutcracker; the only way to save him is for the Nutcracker to defeat the Mouse King and find a girl to love and care for him. A flicker of hope comes in the form of the young Clara, whom Drosselmeyer meets at a Christmas party. With some magic, a cosy Christmas gathering turns into a marvellous adventure. \\nPeter Wright’s The Nutcracker has enchanted audiences since its 1984 premiere by the Company. Featuring Tchaikovsky’s most familiar melodies and brought to life by Julia Trevelyan Oman’s exquisite designs, The Nutcracker is sure to be a festive firecracker for all ages.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The magician Herr Drosselmeyer needs to save his nephew. Hans-Peter has been transformed into a Nutcracker.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-10\",\"runtimeInMinutes\":210,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001227\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b3549712-da50-415c-811f-783459340cae\",\"corporateId\":null},\"hopk\":\"HO00007270\",\"hoCode\":\"A000008276\",\"eventId\":\"0000000001\",\"distributorName\":\"Trafalgar Releasing Ltd\"}],\"castAndCrew\":[{\"id\":\"0000001227\",\"name\":{\"givenName\":\"Peter \",\"familyName\":\"Wright\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000028\",\"name\":{\"text\":\"Ballet\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true},{\"id\":\"0000000030\",\"name\":{\"text\":\"Wheelchair Accessible\",\"translations\":[]},\"shortName\":{\"text\":\"Wheelchair\",\"translations\":[]},\"description\":{\"text\":\"This auditorium has bays for wheelchair users with seats beside them for accompanying guests.\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":10,\"isPromoted\":false}],\"screens\":[{\"id\":\"852-3\",\"name\":{\"text\":\"Screen 3\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000001\",\"name\":{\"text\":\"Event\",\"translations\":[]},