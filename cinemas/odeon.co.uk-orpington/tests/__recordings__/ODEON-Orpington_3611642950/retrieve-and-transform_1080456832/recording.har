goryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"852-57-HO00007320\"},{\"id\":\"852-48780\",\"schedule\":{\"businessDate\":\"2025-11-22\",\"startsAt\":\"2025-11-22T19:00:00+00:00\",\"endsAt\":\"2025-11-22T21:43:00+00:00\",\"filmStartsAt\":\"2025-11-22T19:25:00+00:00\",\"filmEndsAt\":\"2025-11-22T21:43:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-4-55\",\"filmId\":\"HO00007320\",\"siteId\":\"852\",\"screenId\":\"852-4\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000145\",\"0000000174\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"852-57-HO00007320\"},{\"id\":\"852-48781\",\"schedule\":{\"businessDate\":\"2025-11-22\",\"startsAt\":\"2025-11-22T20:00:00+00:00\",\"endsAt\":\"2025-11-22T22:43:00+00:00\",\"filmStartsAt\":\"2025-11-22T20:25:00+00:00\",\"filmEndsAt\":\"2025-11-22T22:43:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"852-2-67\",\"filmId\":\"HO00007320\",\"siteId\":\"852\",\"screenId\":\"852-2\",\"areaCategories\":[{\"areaCategoryId\":\"852-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000002\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000017\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"852-0000000020\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000174\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"852-57-HO00007320\"}],\"relatedData\":{\"sites\":[{\"id\":\"852\",\"name\":{\"text\":\"Orpington\",\"translations\":[]},\"location\":{\"latitude\":51.3766,\"longitude\":0.1012},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"odeon.orpington@odeonuk.com\",\"address\":{\"line1\":\"The Walnuts Shopping Centre\",\"line2\":\"Orpington\",\"city\":\"Kent\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007320\",\"title\":{\"text\":\"Wicked: For Good\",\"translations\":[]},\"synopsis\":{\"text\":\"And now whatever way our stories end, I know you have rewritten mine by being my friend …\\n\\nLast year’s global cinematic cultural sensation, which became the most successful Broadway film adaptation of all time, now reaches its epic, electrifying, emotional conclusion in Wicked: For Good.\\n\\nDirected once again by award-winning director Jon M. Chu and starring the spectacular returning cast, led by Academy Award® nominated superstars Cynthia Erivo and Ariana Grande, the final chapter of the untold story of the witches of Oz begins with Elphaba and Glinda estranged and living with the consequences of their choices.\\n\\nElphaba (Cynthia Erivo), now demonized as The Wicked Witch of the West, lives in exile, hidden within the Ozian forest while continuing her fight for the freedom of Oz’s silenced Animals and desperately trying to expose the truth she knows about The Wizard (Jeff Goldblum).\\n\\nGlinda, meanwhile, has become the glamorous symbol of Goodness for all of Oz, living at the palace in Emerald City and reveling in the perks of fame and popularity. Under the instruction of Madame Morrible (Oscar® winner Michelle Yeoh), Glinda is deployed to serve as an effervescent comfort to Oz, reassuring the masses that all is well under the rule of The Wizard.\\n\\nAs Glinda’s stardom expands and she prepares to marry Prince Fiyero (Olivier award winner and Emmy and SAG nominee Jonathan Bailey) in a spectacular Ozian wedding, she is haunted by her separation from Elphaba. She attempts to broker a conciliation between Elphaba and The Wizard, but those efforts will fail, driving Elphaba and Glinda only further apart. The aftershocks will transform Boq (Tony nominee Ethan Slater) and Fiyero forever, and threaten the safety of Elphaba’s sister, Nessarose (Marissa Bode), when a girl from Kansas comes crashing into all their lives.\\n\\nAs an angry mob rises against the Wicked Witch, Glinda and Elphaba will need to come together one final time. With their singular friendship now the fulcrum of their futures, they will need to truly see each other, with honesty and empathy, if they are to change themselves, and all of Oz, for good.\\n\\nWicked: For Good also stars Emmy nominee Bowen Yang and Bronwyn James as Glinda’s fawning assistants, Pfannee and ShenShen and BAFTA and Grammy nominee Sharon D. Clarke (Caroline, or Change) as the voice of Elphaba’s childhood nanny, Dulcibear.\\n\\nThe film is produced by returning Tony and Emmy winning powerhouse Marc Platt p.g.a. and by multiple Tony winner David Stone. The executive producers are Stephen Schwartz, David Nicksay, Jared LeBoff, Winnie Holzman and Dana Fox. The first film, Wicked, released in November 2024, earned 10 Academy Award® nominations, including Best Picture, and won the Oscars® for Costume Design and Production Design. To date, the film has grossed $750 million worldwide.\\n\\nWicked: For Good is based on the generation-defining musical stage play with music and lyrics by legendary Grammy and Oscar® winning composer and lyricist Stephen Schwartz and book by Winnie Holzman, from the bestselling novel by Gregory Maguire. The screenplay is by Winnie Holzman and Winnie Holzman & Dana Fox. The film score is by John Powell & Stephen Schwartz, with music and lyrics by Stephen Schwartz.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"And now whatever way our stories end, I know you have rewritten mine by being my friend …\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat, violence, innuendo, language\",\"translations\":[]},\"releaseDate\":\"2025-11-21\",\"runtimeInMinutes\":138,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000974\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010640\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012337\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012338\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012339\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012341\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012342\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000029\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000118\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001041\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00001761\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4bdf55f3-2cb7-4623-9759-0d012395c794\",\"corporateId\":null},\"hopk\":\"HO00007320\",\"hoCode\":\"A000008332\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"}],\"castAndCrew\":[{\"id\":\"0000000974\",\"name\":{\"givenName\":\"Jeff\",\"familyName\":\"Goldblum\",\"middleName\":null}},{\"id\":\"0000010640\",\"name\":{\"givenName\":\"Bowen\",\"familyName\":\"Yang\",\"middleName\":null}},{\"id\":\"0000012337\",\"name\":{\"givenName\":\"Ariana\",\"familyName\":\"Grande\",\"middleName\":null}},{\"id\":\"0000012338\",\"name\":{\"givenName\":\"Marissa\",\"familyName\":\"Bode\",\"middleName\":null}},{\"id\":\"0000012339\",\"name\":{\"givenName\":\"Jonathan\",\"familyName\":\"Bailey\",\"middleName\":null}},{\"id\":\"0000012341\",\"name\":{\"givenName\":\"Ethan\",\"familyName\":\"Slater\",\"middleName\":null}},{\"id\":\"0000012342\",\"name\":{\"givenName\":\"David\",\"familyName\":\"Stone\",\"middleName\":null}},{\"id\":\"HO00000029\",\"name\":{\"givenName\":\"Michelle \",\"familyName\":\"Yeoh\",\"middleName\":null}},{\"id\":\"HO00000118\",\"name\":{\"givenName\":\"Cynthia\",\"familyName\":\"Erivo\",\"middleName\":null}},{\"id\":\"HO00001041\",\"name\":{\"givenName\":\"Jon M.\",\"familyName\":\"Chu\",\"middleName\":null}},{\"id\":\"HO00001761\",\"name\":{\"givenName\":\"Marc\",\"familyName\":\"Platt\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000001\",\"name\":{\"text\":\"Action\",\"translations\":[]},\"description\":null},{\"id\":\"0000000010\",\"name\":{\"text\":\"Family\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000009\",\"classification\":{\"text\":\"PG\",\"translations\":[]},\"classificationDescription\":{\"text\":\"Parental Guidance\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Audio Described\",\"translations\":[]},\"shortName\":{\"text\":\"AudioDes\",\"translations\":[]},\"description\":{\"text\":\"A narrator describes the action, scene changes, and actors' body language, along with the dialogue of the film. Audio Description is accessed via headphones and a body pack.\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":3,\"isPromoted\":false},{\"id\":\"0000000145\",\"name\":{\"text\":\"iSense\",\"translations\":[]},\"shortName\":{\"text\":\"iSense \",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":1,\"isPromoted\":false},{\"id\":\"0000000174\",\"name\":{\"text\":\"Laser\",\"translations\":[]},\"shortName\":{\"text\":\"Laser\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":1,\"isPromoted\":false},{\"id\":\"0000000030\",\"name\":{\"text\":\"Wheelchair Accessible\",\"translations\":[]},\"shortName\":{\"text\":\"Wheelchair\",\"translations\":[]},\"description\":{\"text\":\"This auditorium has bays for w