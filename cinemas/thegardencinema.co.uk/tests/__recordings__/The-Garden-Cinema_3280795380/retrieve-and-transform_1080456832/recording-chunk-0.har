            "mimeType": "text/html; charset=UTF-8",
            "text": "<!doctype html>\n<!--[if lt IE 7]><html lang=\"en-GB\" class=\"no-js lt-ie9 lt-ie8 lt-ie7\"><![endif]-->\n<!--[if (IE 7)&!(IEMobile)]><html lang=\"en-GB\" class=\"no-js lt-ie9 lt-ie8\"><![endif]-->\n<!--[if (IE 8)&!(IEMobile)]><html lang=\"en-GB\" class=\"no-js lt-ie9\"><![endif]-->\n<!--[if gt IE 8]><!--> <html lang=\"en-GB\" class=\"no-js\" bgcolor=\"#1f1f1f\"><!--<![endif]-->\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <meta name=\"HandheldFriendly\" content=\"True\">\n    <meta name=\"MobileOptimized\" content=\"320\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"/>\n    \n    \n    \n    <title>Kino Industry Session: Supporting Emerging Talent with BIFA &amp; Beyond / The Garden Cinema</title>\n<meta name=\"description\" content=\"Filmmaker and curator Nia Childs speaks with BIFA Springboard/Kino alumni Alix Austin, Michelle Br&#248;ndum &amp; Keir Siewert. They&#8217;ll chat about their careers in short form, their journey into features, and opportunities/initiatives that exist (like BIFA and Kino) that other emerging filmmakers can leverage to support the early stages of a&hellip;\">\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\">\n<link rel=\"canonical\" href=\"https://www.thegardencinema.co.uk/film/kino-industry-session-supprting-emerging-talent-with-bifa-beyond/\">\n<meta property=\"og:url\" content=\"https://www.thegardencinema.co.uk/film/kino-industry-session-supprting-emerging-talent-with-bifa-beyond/\">\n<meta property=\"og:site_name\" content=\"The Garden Cinema\">\n<meta property=\"og:locale\" content=\"en_GB\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"article:author\" content=\"https://www.facebook.com/p/The-Garden-Cinema-100037345105930/?locale=en_GB\">\n<meta property=\"article:publisher\" content=\"https://www.facebook.co