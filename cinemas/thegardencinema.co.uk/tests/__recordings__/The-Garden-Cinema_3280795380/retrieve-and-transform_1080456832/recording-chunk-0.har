            "mimeType": "text/html; charset=UTF-8",
            "text": "<!doctype html>\n<!--[if lt IE 7]><html lang=\"en-GB\" class=\"no-js lt-ie9 lt-ie8 lt-ie7\"><![endif]-->\n<!--[if (IE 7)&!(IEMobile)]><html lang=\"en-GB\" class=\"no-js lt-ie9 lt-ie8\"><![endif]-->\n<!--[if (IE 8)&!(IEMobile)]><html lang=\"en-GB\" class=\"no-js lt-ie9\"><![endif]-->\n<!--[if gt IE 8]><!--> <html lang=\"en-GB\" class=\"no-js\" bgcolor=\"#1f1f1f\"><!--<![endif]-->\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <meta name=\"HandheldFriendly\" content=\"True\">\n    <meta name=\"MobileOptimized\" content=\"320\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"/>\n    \n    \n    \n    <title>Synthetic Sincerity + Lift + Q&amp;A / The Garden Cinema</title>\n\t<style>img:is([sizes=\"auto\" i], [sizes^=\"auto,\" i]) { contain-intrinsic-size: 3000px 1500px }</style>\n\t<meta name=\"description\" content=\"This screening will be followed by a Q&amp;A with Marc Isaacs. The Synthetic Sincerity Lab based at the University of Southern England are trying to create authentic AI characters as part of a new research project. The head of the lab, Professor Song, licences the films of Marc Isaacs&#8217; to&hellip;\">\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\">\n<link rel=\"canonical\" href=\"https://www.thegardencinema.co.uk/film/synthetic-sincerity/\">\n<meta property=\"og:url\" content=\"https://www.thegardencinema.co.uk/film/synthetic-sincerity/\">\n<meta property=\"og:site_name\" content=\"The Garden Cinema\">\n<meta property=\"og:locale\" content=\"en_GB\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"article:author\" content=\"https://www.facebook.com/p/The-Garden-Cinema-100037345105930/?locale=en_GB\">\n<meta property=\"article:publisher\" content=\"https://www.facebook.com/p/The-Garden-Cinema-100037345105930/?locale=en_GB\">\n<meta property=\"og:title\" content=\"Synthetic Sincerity + Lift + Q&amp;A / The Garden Cinema\">\n<meta property=\"og:description\" content=\"This screening will be followed by a Q&amp;A with Marc Isaacs. The Synthetic Sincerity Lab based at the University of Southern England are trying to create authentic AI characters as part of a new research project. The head of the lab, Professor Song, licences the films of Marc Isaacs&#8217; to&hellip;\">\n<meta property=\"og:image\" content=\"https://images.savoysystems.co.uk/GCL/5770643.jpg\">\n<meta property=\"og:image:secure_url\" content=\"https://images.savoysystems.co.uk/GCL/5770643.jpg\">\n<meta property=\"og:image:width\" content=\"878\">\n<meta property=\"og:image:height\" content=\"878\">\n<meta name=\"twitter:card\" content=\"summary\">\n<meta name=\"twitter:site\" content=\"@thegardencinema\">\n<meta name=\"twitter:creator\" content=\"@thegardencinema\">\n<meta name=\"twitter:title\" content=\"Synthetic Sincerity + Lift + Q&amp;A / The Garden Cinema\">\n<meta name=\"twitter:description\" content=\"This screening will be followed by a Q&amp;A with Marc Isaacs. The Synthetic Sincerity Lab based at the University of Southern England are trying to create authentic AI characters as part of a new research project. The head of the lab, Professor Song, licences the films of Marc Isaacs&#8217; to&hellip;\">\n<meta name=\"twitter:image\" content=\"https://images.savoysystems.co.uk/GCL/5770643.jpg\">\n<link rel=\"alternate\" type=\"application/rss+xml\" title=\"The Garden Cinema &raquo; Feed\" href=\"https://www.thegardencinema.co.uk/feed/\" />\n<link rel=\"alternate\" type=\"application/rss+xml\" title=\"The Garden Cinema &raquo; Comments Feed\" href=\"https://www.thegardencinema.co.uk/comments/feed/\" />\n<link rel=\"alternate\" type=\"application/rss+xml\" title=\"The Garden Cinema &raquo; Synthetic Sincerity + Lift + Q&amp;A Comments Feed\" href=\"https://www.thegardencinema.co.uk/film/synthetic-sincerity/feed/\" />\n<script type=\"t