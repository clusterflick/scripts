uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_6035033.TcsSection_3060731\">20:45</a></span><span class=\"screening-tag ext-screening\"></span><span class=\"screening-tag ext-audio_description\"></span></div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Thu 03 Sep</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening  audio_description \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5943716.TcsSection_971\">15:30</a></span><span class=\"screening-tag ext-screening\"></span><span class=\"screening-tag ext-audio_description\"></span></div><div class=\"screening-panel   screening  audio_description \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5943720.TcsSection_3060731\">20:45</a></span><span class=\"screening-tag ext-screening\"></span><span class=\"screening-tag ext-audio_description\"></span></div></div></div>              </div>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" >\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/boris-godunov/\"><img class=\"films-list__by-title__film-thumb\" loading=\"lazy\" src=\"https://images.savoysystems.co.uk/GCL/5887846.jpg\" /></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/boris-godunov/\">Boris Godunov <span class=\"film-detail__film__rating\">18</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>Andrzej Żuławski, France, Yugoslavia, 1989</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                The screening on October 5th will be introduced by writer Daniel Bird. There will be a special screening of Boris Godunov on Sunday 13 September, followed by a post-screening discussion with members of the Royal Opera House team. You can buy tickets for&hellip; <a href=\"https://www.thegardencinema.co.uk/film/boris-godunov/\">Read&nbsp;More</a>            </div>\n\n            <div class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Tue 29 Sep</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5888986.TcsSection_971\">14:30</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Mon 05 Oct</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening  intro \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5889052.TcsSection_638\">20:00</a></span><span class=\"screening-tag ext-screening\"></span><span class=\"screening-tag ext-intro\"></span></div></div></div>              </div>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" >\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/broadcast-news/\"><img class=\"films-list__by-title__film-thumb\" loading=\"lazy\" src=\"https://images.savoysystems.co.uk/GCL/5710849.jpg\" /></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/broadcast-news/\">Broadcast News <span class=\"film-detail__film__rating\">15</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>James L. Brooks, 1987, USA</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                Broadcast News was suggested by our member John Atkinson, who writes: 'Broadcast News is the sort of nuanced comedy drama that studios run a mile from these days. It’s wonderfully written, full of great dialogue delivered by a perfect cast. It’s one of my&hellip; <a href=\"https://www.thegardencinema.co.uk/film/broadcast-news/\">Read&nbsp;More</a>            </div>\n\n            <div class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Sat 29 Aug</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5731160.TcsSection_638\">17:30</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div>              </div>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" >\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/by-hook-or-by-crook-intro/\"><img class=\"films-list__by-title__film-thumb\" loading=\"lazy\" src=\"https://images.savoysystems.co.uk/GCL/5901996.jpg\" /></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/by-hook-or-by-crook-intro/\">By Hook or By Crook + Intro <span class=\"film-detail__film__rating\">18</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>USA, 2001, Harry Dodge & Silas Howard </em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                Join us for the UK premiere of By Hook or By Crook’s restoration, introduced by Emily Simmons from Crip Cinema Archive. This is the last August screening in the cinema’s new strand, Fruits on Film. This screening will include Descriptive Subtitles (DS).&hellip; <a href=\"https://www.thegardencinema.co.uk/film/by-hook-or-by-crook-intro/\">Read&nbsp;More</a>            </div>\n\n            <div class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Fri 28 Aug</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening  intro \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5902057.TcsSection_638\">18:30</a></span><span class=\"screening-tag ext-screening\"></span><span class=\"screening-tag ext-intro\"></span></div></div></div>              </div>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" id=\"starts-with-c\">\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/closely-observed-trains/\"><img class=\"films-list__by-title__film-thumb\" loading=\"lazy\" src=\"https://images.savoysystems.co.uk/GCL/5945565.jpg\" /></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/closely-observed-trains/\">Closely Observed Trains <span class=\"film-detail__film__rating\">15</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>Jiří Menzel, 1966, Czechoslovakia</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                Our screening on Wednesday 9 September will be introduced by the close friend of Jiří Menzel: film critic, broadcaster, and lecturer Phillip Bergson. At a village railway station in occupied Czechoslovakia, a bumbling dispatcher’s apprentice longs to liberate himself from his virginity.&hellip; <a href=\"https://www.thegardencinema.co.uk/film/closely-observed-trains/\">Read&nbsp;More</a>            </div>\n\n            <div class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Wed 09 Sep</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening  intro \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5955520.TcsSection_638\">18:00</a></span><span class=\"screening-tag ext-screening\"></span><span class=\"screening-tag ext-intro\"></span></div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Fri 18 Sep</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5955603.TcsSection_638\">18:30</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Thu 15 Oct</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5956121.TcsSection_638\">16:00</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div>              </div>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" >\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/cosmos/\"><img class=\"films-list__by-title__film-thumb\" loading=\"lazy\" src=\"https://images.savoysystems.co.uk/GCL/5888039.jpg\" /></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/cosmos/\">Cosmos <span class=\"film-detail__film__rating\">15</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>Andrzej Żuławski, France, Portugal, 2015</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                When two young men arrive at a family-run guesthouse in rural France, their anticipation of a few days' peace and quiet is undermined by a variety of sinister occurrences. A small bird is found murdered, its neck in a tiny noose, a&hellip; <a href=\"https://www.thegardencinema.co.uk/film/cosmos/\">Read&nbsp;More</a>            </div>\n\n            <div class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Tue 08 Sep</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5888755.TcsSection_971\">20:30</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Fri 25 Sep</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5888974.TcsSection_971\">18:00</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div>              </div>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" id=\"starts-with-d\">\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/daisies/\"><img class=\"films-list__by-title__film-thumb\" loading=\"lazy\" src=\"https://images.savoysystems.co.uk/GCL/2083740.jpg\" /></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/daisies/\">Daisies <span class=\"film-detail__film__rating\">15</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>Věra Chytilová, 1966, Czechoslovakia</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                Our screening on Thursday 8 October will be introduced by art historian and Fashion in Film Festival director Marketa Uhlirova. A satirical, wild and irreverent story of rebellion, Věra Chytilová’s classic of surrealist cinema is perhaps also the most adventurous and anarchic&hellip; <a href=\"https://www.thegardencinema.co.uk/film/daisies/\">Read&nbsp;More</a>            </div>\n\n            <div class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Thu 17 Sep</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5955745.TcsSection_638\">20:30</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Tue 22 Sep</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5955831.TcsSection_638\">16:00</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Thu 08 Oct</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening  intro \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5956002.TcsSection_638\">18:00</a></span><span class=\"screening-tag ext-screening\"></span><span class=\"screening-tag ext-intro\"></span></div></div></div>              </div>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" >\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/dear-you/\"><img class=\"films-list__by-title__film-thumb\" loading=\"lazy\" src=\"https://images.savoysystems.co.uk/GCL/5735870.jpg\" /></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/dear-you/\">Dear You <span class=\"film-detail__film__rating\">15</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>Lan Hongchun, 2026, China</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                For years, Grandma Shurou from Chaoshan has lived on the letters and remittances from her husband who left for Nanyang to survive the war and never returned. When her debt-ridden grandson Xiaowei secretly travels to Thailand to find his rumoured 'millionaire' grandpa,&hellip; <a href=\"https://www.thegardencinema.co.uk/film/dear-you/\">Read&nbsp;More</a>            </div>\n\n            <div class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Wed 26 Aug</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_6059715.TcsSection_971\">20:30</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Thu 27 Aug</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_6059605.TcsSection_3060731\">15:45</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Fri 28 Aug</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_6097914.TcsSection_971\">13:05</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Mon 31 Aug</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_6097949.TcsSection_638\">12:45</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Thu 03 Sep</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_6103052.TcsSection_3060731\">13:30</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div>              </div>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" >\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/diamonds-of-the-night/\"><img class=\"films-list__by-title__film-thumb\" loading=\"lazy\" src=\"https://images.savoysystems.co.uk/GCL/5945010.jpg\" /></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/diamonds-of-the-night/\">Diamonds of the Night <span class=\"film-detail__film__rating\">12</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>Jan Němec, 1964, Czechoslovakia</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                Our screening on Thursday 10 September will be introduced by Second Run DVD founder Mehelli Modi. Němec’s debut feature is one of the most thrilling and startlingly original works of cinema. Told almost without dialogue, it chronicles the tense and desperate journey&hellip; <a href=\"https://www.thegardencinema.co.uk/film/diamonds-of-the-night/\">Read&nbsp;More</a>            </div>\n\n            <div class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Thu 10 Sep</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening  intro \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5955528.TcsSection_638\">18:00</a></span><span class=\"screening-tag ext-screening\"></span><span class=\"screening-tag ext-intro\"></span></div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Wed 23 Sep</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5955837.TcsSection_638\">15:30</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Tue 20 Oct</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5956186.TcsSection_638\">16:00</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div>              </div>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" id=\"starts-with-f\">\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/free-willy/\"><img class=\"films-list__by-title__film-thumb\" loading=\"lazy\" src=\"https://images.savoysystems.co.uk/GCL/5672588.jpg\" /></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/free-willy/\">Free Willy <span class=\"film-detail__film__rating\">PG</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>Simon Wincer, 1993, USA</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                In this much-loved family classic, a 12-year-old orphaned boy named Jesse befriends a captive orca, Willy, at an ailing amusement park. When he discovers that the park owner has been planning to dispose of Willy, he hatches a scheme to break Willy&hellip; <a href=\"https://www.thegardencinema.co.uk/film/free-willy/\">Read&nbsp;More</a>            </div>\n\n            <div class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Sat 19 Sep</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening  pay_what_you_can \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5672884.TcsSection_3060731\">11:00</a></span><span class=\"screening-tag ext-screening\"></span><span class=\"screening-tag ext-pay_what_you_can\"></span></div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Sun 20 Sep</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening  pay_what_you_can \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5672886.TcsSection_638\">11:00</a></span><span class=\"screening-tag ext-screening\"></span><span class=\"screening-tag ext-pay_what_you_can\"></span></div></div></div>              </div>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" >\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/full-moon-in-new-york-qa/\"><img class=\"films-list__by-title__film-thumb\" loading=\"lazy\" src=\"https://images.savoysystems.co.uk/GCL/5710584.jpg\" /></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/full-