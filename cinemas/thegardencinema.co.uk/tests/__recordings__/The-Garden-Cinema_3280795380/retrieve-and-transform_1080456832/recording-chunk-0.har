son-filters\">\n     \n     <h2><i class=\"fa-regular fa-bars-filter\"></i>Filter by type</h2>\n   <form role=\"form\" method=\"get\" class=\"filter-form\" action=\"https://www.thegardencinema.co.uk/\">\n<input class=\"filter-checkbox\" type=\"checkbox\" value=\"1\" id=\"filter-members\"><label for=\"filter-members\"><i class=\"fa-regular fa-square-check\"></i>Members</label><input class=\"filter-checkbox\" type=\"checkbox\" value=\"1\" id=\"filter-intro\"><label for=\"filter-intro\"><i class=\"fa-regular fa-square-check\"></i>+ Intro</label><input class=\"filter-checkbox\" type=\"checkbox\" value=\"1\" id=\"filter-live_music\"><label for=\"filter-live_music\"><i class=\"fa-regular fa-square-check\"></i>+ Live Music</label><input class=\"filter-checkbox\" type=\"checkbox\" value=\"1\" id=\"filter-pay_what_you_can\"><label for=\"filter-pay_what_you_can\"><i class=\"fa-regular fa-square-check\"></i>Pay What You Can</label><input class=\"filter-checkbox\" type=\"checkbox\" value=\"1\" id=\"filter-q_and_a\"><label for=\"filter-q_and_a\"><i class=\"fa-regular fa-square-check\"></i>+ Q&A</label><input class=\"filter-checkbox\" type=\"checkbox\" value=\"1\" id=\"filter-discussion\"><label for=\"filter-discussion\"><i class=\"fa-regular fa-square-check\"></i>+ Discussion</label><input class=\"filter-checkbox\" type=\"checkbox\" value=\"1\" id=\"filter-hoh\"><label for=\"filter-hoh\"><i class=\"fa-regular fa-square-check\"></i>Hard of Hearing</label><input class=\"filter-checkbox\" type=\"checkbox\" value=\"1\" id=\"filter-audio_description\"><label for=\"filter-audio_description\"><i class=\"fa-regular fa-square-check\"></i>Audio Description</label>               <div class=\"filter-controls\">\n            <input type=\"reset\" value=\"clear\">\n            <input type=\"submit\" value=\"apply\" id=\"filter-apply\">\n          </div>\n       \n      <p style=\"margin-left: 10px;\">or <a id=\"by-title-close\" href=\"https://www.thegardencinema.co.uk/#by-title\" style=\"text-decoration: underline\"  rel=\"modal:close\">View all films by A-Z</a></p>\n         \n         </form>\n   </section>\n</div>\n\n\n\n\n\n\n<div  id=\"modal-waiting\" class=\"modal\">\n    <section class=\"wait-list\">\n        <h3 class=\"main-title\">Waiting List</h3>\n        <form role=\"form\" method=\"post\" id=\"wlm-form\" class=\"waiting-list-form\" action=\"https://www.thegardencinema.co.uk/wp-admin/admin-ajax.php\">\n          <div class=\"wlm-hide-me-after-submit\">\n            <input type=\"hidden\" name=\"wait-list-id\" id=\"wait-list-id\" value=\"\">\n            <h1 id=\"wait-list-name\"></h1>\n            <h3 id=\"wait-list-time\"></h3>\n              <div class=\"wait-list-instructions\">\n                <p>Please confirm below to add yourself to the waiting list for this screening. You will be notified by email if a ticket becomes available. </p>\n                <p>Please note that this email notification will be sent out to all members on the waiting list at the same time, and tickets are sold on a first come, first served basis.</p>\n         \n                \n            </div>\n            <button id=\"wlm-button-add\">+ Add me to the list</button>\n          </div>\n          <div class=\"wlm-show-me-on-success\">\n            <i class=\"fa-regular fa-circle-check\"></i> You have been added to the waiting list.\n          </div>\n          <div class=\"wlm-show-me-on-fail\">\n            <i class=\"fa-regular fa-circle-check\"></i> You are already on the waiting list.\n          </div>\n            <div>To view and manage your waiting lists and email preferences, please click below.</div>\n            <a href=\"/my-account/my-waitlist/\">Manage my waiting lists</a>\n        </form>\n    </section>\n</div>\n<style>\n  .wlm-show-me-on-success {\n      display: none;\n  }\n  .wlm-show-me-on-fail {\n      display:none;\n  }\n  #wlm-form.failed .wlm-hide-me-after-submit,\n  #wlm-form.success .wlm-hide-me-after-submit  {\n      display: none;\