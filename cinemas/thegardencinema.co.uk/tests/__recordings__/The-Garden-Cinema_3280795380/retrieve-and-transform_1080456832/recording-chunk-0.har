down;\n}\n \n \t\t</style>\n\t\t     \n    <!-- Font Awesome Pro   -->\n    <script src=\"https://kit.fontawesome.com/57d80f9e95.js\" crossorigin=\"anonymous\"></script>\n    \n\n    <!-- <script src=\"https://cdnjs.cloudflare.com/ajax/libs/jquery/3.0.0/jquery.min.js\"></script>-->\n    \n    <!-- jQuery Modal -->\n  <!--\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/jquery-modal/0.9.1/jquery.modal.min.js\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/jquery-modal/0.9.1/jquery.modal.min.css\" />\n    -->\n    \n   <div  id=\"modal-search\" class=\"modal\">\n<form role=\"search\" method=\"get\" class=\"search-form\" action=\"https://www.thegardencinema.co.uk/\">\n  \n  <label>  <input type=\"search\" class=\"search-field\" \n            placeholder=\"Search films\"\n            value=\"\" name=\"s\"\n            title=\"Search for:\"  autofocus /></label>\n    \n    <button type=\"submit\"><i class=\"far fa-search\"></i></button>\n    <input type=\"submit\" class=\"search-submit hidden\"\n        value=\"Search\" />\n</form>\n</div>\n\n\n\n\n\n\n    \n     \n         <!-- Google tag (gtag.js) -->\n    <script async src=\"https://www.googletagmanager.com/gtag/js?id=G-CTS9XBV57S\"></script>\n    <script>\n      window.dataLayer = window.dataLayer || [];\n      function gtag(){dataLayer.push(arguments);}\n      gtag('js', new Date());\n\n      gtag('config', 'G-CTS9XBV57S');\n    </script>\n \n\n\n\t <!--Adobe Source Sans-->\n\t<link rel=\"preconnect\" href=\"https://use.typekit.net\" crossorigin>\n\t<link rel=\"preconnect\" href=\"https://fonts.typekit.net\" crossorigin>\n\t<link rel=\"preload\" as=\"style\" href=\"https://use.typekit.net/nzo1bak.css\">\n\t<link rel=\"stylesheet\" href=\"https://use.typekit.net/nzo1bak.css\" onload=\"this.onload=null;this.rel='stylesheet'\">\n\t<noscript><link rel=\"stylesheet\" href=\"https://use.typekit.net/nzo1bak.css\"></noscript>\n \t \n    <!-- Favicon -->\n    \n\n<link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n<link rel=\"manifest\" href=\"/site.webmanifest\">\n<link rel=\"mask-icon\" href=\"/safari-pinned-tab.svg\" color=\"#5bbad5\">\n<meta name=\"msapplication-TileColor\" content=\"#ffffff\">\n<meta name=\"theme-color\" content=\"#ffffff\">\n\n\n\t\n\t<!-- Begin Cookie Consent plugin by Silktide - http://silktide.com/cookieconsent -->\n<script type=\"text/javascript\">\n    window.cookieconsent_options = {\"message\":\"This website uses cookies to ensure you get the best experience on our website.\",\"dismiss\":\"Accept & Close\",\"learnMore\":\"Privacy policy\",\"link\":\"/privacy\",\"theme\":\"light-bottom\"};\n</script>\n\n<script type=\"text/javascript\" src=\"//cdnjs.cloudflare.com/ajax/libs/cookieconsent2/1.0.10/cookieconsent.min.js\"></script>\n<!-- End Cookie Consent plugin -->\n<script>\n(function(){\n  var h=location.hash.replace('#','');\n  if(!h)h='by-date';\n  var type=h.split(',')[0];\n  if(!/^by-(date|title|season|strand|event)$/.test(type))type='by-date';\n  document.documentElement.setAttribute('data-films-list',type);\n  document.addEventListener('DOMContentLoaded',function(){\n    document.body.setAttribute('data-films-list',type);\n  });\n})();\n</script>\n</head>\n<body itemscope itemtype=\"http://schema.org/WebPage\"  class=\"wp-singular film-template-default single single-film postid-26564 wp-theme-garden-cinema kino-industry-session-from-short-film-to-streaming-revenue by-event film-kino-industry-session-from-short-film-to-streaming-revenue\">\n\n    \n<div class=\"float-top\">\n\n  \n  <section class=\"header logged-out-savoy\">\n      <div class=\"header__row grid\">\n\n        <!-- Desktop menu -->\n\n        <div class=\"logo__inner\"><a href=\"/\"><img src=\"/wp-content/uploads/2021/11/Logo-Dark-Background.p