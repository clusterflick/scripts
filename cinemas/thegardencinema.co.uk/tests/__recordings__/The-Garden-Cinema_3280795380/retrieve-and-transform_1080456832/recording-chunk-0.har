tem_0.TcsWebTab_0.TcsPerformance_4783766.TcsSection_638\">20:20</a></span><span class=\"screening-tag ext-audio_description\"></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div>              </span>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" >\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/the-smurfs/\"><img src=\"https://images.savoysystems.co.uk/GCL/4448738.jpg\" class=\"films-list__by-title__film-thumb\" alt=\"\"></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/the-smurfs/\">The Smurfs <span class=\"film-detail__film__rating\">U</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>Raja Gosnell, 2011, United States</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                A group of tiny blue creatures from a magical forest are accidentally transported to modern-day New York City, where they must find a way back home. With the help of a kind couple, they try to stay hidden while evading a determined&hellip; <a href=\"https://www.thegardencinema.co.uk/film/the-smurfs/\">Read&nbsp;More</a>            </div>\n\n            <span class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel   pay_what_you_can \"><div class=\"screening-panel__date-title\">Sat 07 Feb</div><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_4790258.TcsSection_3060731\">11:00</a></span><span class=\"screening-tag ext-pay_what_you_can\"></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel   pay_what_you_can \"><div class=\"screening-panel__date-title\">Sun 08 Feb</div><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_4790292.TcsSection_3060731\">11:00</a></span><span class=\"screening-tag ext-pay_what_you_can\"></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div>              </span>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" id=\"starts-with-t\">\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/tampopo/\"><img width=\"798\" height=\"1129\" src=\"https://www.thegardencinema.co.uk/wp-content/uploads/films/Tampopo.jpg\" class=\"films-list__by-title__film-thumb\" alt=\"\" loading=\"lazy\" decoding=\"async\" srcset=\"https://www.thegardencinema.co.uk/wp-content/uploads/films/Tampopo.jpg 798w, https://www.thegardencinema.co.uk/wp-content/uploads/films/Tampopo-212x300.jpg 212w, https://www.thegardencinema.co.uk/wp-content/uploads/films/Tampopo-724x1024.jpg 724w, https://www.thegardencinema.co.uk/wp-content/uploads/films/Tampopo-768x1087.jpg 768w\" sizes=\"auto, (max-width: 798px) 100vw, 798px\" /></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/tampopo/\">Tampopo <span class=\"film-detail__film__rating\">15</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>Juzo Itami, 1985, Japan</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                The tale of an eccentric band of culinary ronin who guide the widow of a noodle-shop owner on her quest for the perfect recipe, this rapturous 'ramen western' by Japanese director Juzo Itami is an entertaining, genre-bending adventure underpinned by a deft&hellip; <a href=\"https://www.thegardencinema.co.uk/film/tampopo/\">Read&nbsp;More</a>            </div>\n\n            <span class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel  \"><div class=\"screening-panel__date-title\">Wed 11 Feb</div><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_4683425.TcsSection_638\">15:15</a></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel  \"><div class=\"screening-panel__date-title\">Wed 04 Mar</div><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_4683776.TcsSection_638\">20:00</a></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div>              </span>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" >\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/tetsuo-the-iron-man/\"><img src=\"https://images.savoysystems.co.uk/GCL/4292359.jpg\" class=\"films-list__by-title__film-thumb\" alt=\"\"></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/tetsuo-the-iron-man/\">Tetsuo: The Iron Man <span class=\"film-detail__film__rating\">18</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>Shinya Tsukamoto, 1989, Japan</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                Our screening on Thursday 26 February will be introduced by Mark Player, author of Japanese Cinema and Punk, and will be followed by a post film discussion group in the Atrium Bar.    A strange man known only as the 'metal fetishist', who seems&hellip; <a href=\"https://www.thegardencinema.co.uk/film/tetsuo-the-iron-man/\">Read&nbsp;More</a>            </div>\n\n            <span class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel   intro \"><div class=\"screening-panel__date-title\">Thu 26 Feb</div><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_4292608.TcsSection_3060731\">18:00</a></span><span class=\"screening-tag ext-intro\"></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel  \"><div class=\"screening-panel__date-title\">Sat 07 Mar</div><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_4683993.TcsSection_971\">21:00</a></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div>              </span>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" >\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/typhoon-club/\"><img src=\"https://images.savoysystems.co.uk/GCL/4292305.jpg\" class=\"films-list__by-title__film-thumb\" alt=\"\"></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/typhoon-club/\">Typhoon Club <span class=\"film-detail__film__rating\">18</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>Shinji Somai, 1985, Japan</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                Our screening on 12 February will be introduced by Alexander Jacoby (Oxford Brookes), and will be followed by a film discussion group in the Atrium Bar. Newly restored, Shinji Somai’s beloved cult film Typhoon Club is widely heralded as the director’s seminal feature&hellip; <a href=\"https://www.thegardencinema.co.uk/film/typhoon-club/\">Read&nbsp;More</a>            </div>\n\n            <span class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel   intro \"><div class=\"screening-panel__date-title\">Thu 12 Feb</div><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_4292579.TcsSection_3060731\">18:00</a></span><span class=\"screening-tag ext-intro\"></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel  \"><div class=\"screening-panel__date-title\">Wed 18 Feb</div><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_4683535.TcsSection_638\">15:30</a></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel  \"><div class=\"screening-panel__date-title\">Mon 02 Mar</div><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_4683770.TcsSection_638\">20:15</a></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div>              </span>\n          </div>\n\n\n        </div>\n        </div>\n</section>\n\n\n<!-- List Seasons -->\n\n\n<section class=\"films-list__by-season films-list-block\">\n  <div class=\"films-list__by-season__inner\">\n          <div class=\"films-list__by-season__row\">\n                  <div class=\"films-list__by-season__season\">\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/season/1980s-the-lost-decade-of-japanese-cinema/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2025/12/cut-out-80japanese.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/season/1980s-the-lost-decade-of-japanese-cinema/\">1980s: The Lost Decade of Japanese Cinema</a></div>\n                <div class=\"films-list__by-season__season__date\">\n\n                    Fri 09 Jan  &#8212;  Sat 07 Mar 2026\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">The 1980s were the zenith of Japan’s bubble economy, an era which saw the accumulation of vast wealth, alongside rapid technological and commercial growth. City centres sprouted neon-emblazoned shrines to multinational capitalism, built upon the&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/season/1980s-the-lost-decade-of-japanese-cinema/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                  <div class=\"films-list__by-season__season\">\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/season/members-events/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image top\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2024/08/cut-out-members3.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/season/members-events/\">Members' Events</a></div>\n                <div class=\"films-list__by-season__season__date\">\n\n                    Fri 25 Mar  &#8212;  Fri 01 Jan 2027\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">Events for members only, including free bi-weekly screenings for Garden Cinema Members with films chosen for members, by members. Selected films are added regularly, so keep an eye on this page for updates.&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/season/members-events/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n            </div>\n\n    <p class=\"season-detail__more-seasons-link\"><a href=\"/#by-season\">Current Seasons</a> | <a\n        href=\"/about-us/archive-seasons/\">Past Seasons</a></p>\n\n  </div>\n</section>\n\n<!-- List Strands -->\n\n\n<section class=\"films-list__by-strand films-list-block\">\n  <div class=\"films-list__by-season__inner\">\n          <div class=\"films-list__by-season__row\">\n        \n        \n        \n                                            <div class=\"films-list__by-season__season hidden- \"    >\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/strand/films-for-the-family/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2022/06/bambi-cut-out-colour.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/strand/films-for-the-family/\">Films for the Family</a></div>\n                <div class=\"films-list__by-season__season__date\" style=\"display: none\">\n\n                    Sun 24 Jul  &#8212;  Fri 01 Jan 2027\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">Join us every Saturday & Sunday morning and on weekdays during the school holidays for some of our favourite family classics. For cinema lovers of all ages. On Sundays the films are followed&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/strand/films-for-the-family/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                                   <div class=\"films-list__by-season__season hidden- \"    >\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/strand/members-events/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2024/08/cut-out-members3.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/strand/members-events/\">Members' Events</a></div>\n                <div class=\"films-list__by-season__season__date\" style=\"display: none\">\n\n                    Fri 25 Mar  &#8212;  Tue 08 May 2040\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">Events for members only, including free bi-weekly screenings for Garden Cinema Members with films chosen for members, by members. Selected films are added regularly, so keep an eye on this page for updates.&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/strand/members-events/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                                   <div class=\"films-list__by-season__season hidden- \"    >\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/strand/bring-your-baby-screenings/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2025/11/cut-out-babyfilm-1.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/strand/bring-your-baby-screenings/\">Bring Your Baby Screenings</a></div>\n                <div class=\"films-list__by-season__season__date\" style=\"display: none\">\n\n                    Mon 24 Nov  &#8212;  Thu 01 Jan 2099\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">A chance for parents and carers with babies of twelve months and under to see the latest releases in a relaxed environment.  These screenings will have raised lighting, reduced volume levels, and captions/subtitles&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/strand/bring-your-baby-screenings/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                                   <div class=\"films-list__by-season__season hidden- \"    >\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/strand/select-japan/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2025/04/cut-out-kikujiro.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/strand/select-japan/\">Select Japan</a></div>\n                <div class=\"films-list__by-season__season__date\" style=\"display: none\">\n\n                    Mon 14 Apr  &#8212;  Thu 23 Apr 2026\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">Select Japan is an initiative from The Garden Cinema to showcase the best of Japanese cinema, classic and contemporary, with a focus on titles and filmmakers which have been rarely screened in the&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/strand/select-japan/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                                                    <div class=\"films-list__by-season__season hidden- \"    >\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/strand/chinese-cinema-project/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2025/04/Page-Icon.png\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/strand/chinese-cinema-project/\">Chinese Cinema Project</a></div>\n                <div class=\"films-list__by-season__season__date\" style=\"display: none\">\n\n                    Sat 19 Nov  &#8212;  Fri 01 Jan 2027\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">The Chinese Cinema Project is an exhibition initiative presented by The Garden Cinema. It showcases works from emerging and under-represented Chinese filmmakers via regular screenings, exploring auteurship and cinematic beauty in its various&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/strand/chinese-cinema-project/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                    </div>\n  </div>\n</section>\n\n<!-- List Events -->\n\n<section class=\"films-list__by-event films-list-block\">\n  <div class=\"films-list__by-event__inner\">\n    <div class=\"films-list__by-event__row\">\n          <div class=\"films-list__by-event__event\">\n    <div class=\"films-list__by-event__event__inner\">\n\n      <div class=\"films-list__by-event__event__image-block\">\n        <a href=\"https://www.thegardencinema.co.uk/festival/factual-animation-film-festival/\">\n                      <img src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2025/12/Frame-89.jpg\" loading=\"lazy\"\n               class=\"films-list__by-event__event__image middle\"></a>\n                </div>\n\n      <div class=\"films-list__by-event__event__content-block\">\n        <span class=\"films-list__by-event__event__pre-title\">FESTIVAL: </span>\n        <h2 class=\"films-list__by-event__event__title\"><a\n            href=\"https://www.thegardencinema.co.uk/festival/factual-animation-film-festival/\">Factual Animation Film Festival</a></h2>\n        <div class=\"films-list__by-event__event__date\"> Sat 10 Jan\n            </div>\n        <div class=\"synopsis-wrapper\">\n\n\n          <div class=\"films-list__by-event__synopsis\">\n                                              Factual Animation Film Festival (FAFF) is the world’s longest running film festival dedicated to championing short animated documentaries and factual animation.&hellip; </div>\n\n          <div class=\"films-list__by-event__button\"><a href=\"https://www.thegardencinema.co.uk/festival/factual-animation-film-festival/\">Read&nbsp;more</a>\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n  </div>\n      <div class=\"films-list__by-event__event\">\n    <div class=\"films-list__by-event__event__inner\">\n\n      <div class=\"films-list__by-event__event__image-block\">\n        <a href=\"https://www.thegardencinema.co.uk/film/power-station-qa/\">\n                        <img src=\"https://images.savoysystems.co.uk/GCL/4682695.jpg\" class=\"films-list__by-event__event__image middle\" alt=\"\"></a>\n      </div>\n\n      <div class=\"films-list__by-event__event__content-block\">\n        <span class=\"films-list__by-event__event__pre-title\">EVENT: </span>\n        <h2 class=\"films-list__by-event__event__title\"><a\n            href=\"https://www.thegardencinema.co.uk/film/power-station-qa/\">Power Station + Q&amp;A</a></h2>\n        <div class=\"films-list__by-event__event__date\">Mon 19 Jan 2026</div>\n\n\n                  <div class=\"synopsis-wrapper\">\n\n          <div class=\"films-list__by-event__synopsis\">\n                                              The film will be followed by a Q&A with director Den Edelstyn. Two artists in Walthamstow set out to take their&hellip;\n\n              </div>\n          <div class=\"films-list__by-event__button\"><a href=\"https://www.thegardencinema.co.uk/film/power-station-qa/\">Read&nbsp;more</a></div>\n        </div>\n\n      </div>\n\n    </div>\n  </div>\n      <div class=\"films-list__by-event__event\">\n    <div class=\"films-list__by-event__event__inner\">\n\n      <div class=\"films-list__by-event__event__image-block\">\n        <a href=\"https://www.thegardencinema.co.uk/film/members-scratch-night/\">\n                        <img width=\"800\" height=\"1184\" src=\"https://www.thegardencinema.co.uk/wp-content/uploads/films/Members--Scratch-Night-1.jpg\" class=\"films-list__by-event__event__image middle\" alt=\"\" loading=\"lazy\" decoding=\"async\" srcset=\"https://www.thegardencinema.co.uk/wp-content/uploads/films/Members--Scratch-Night-1.jpg 800w, https://www.thegardencinema.co.uk/wp-content/uploads/films/Members--Scratch-Night-1-203x300.jpg 203w, https://www.thegardencinema.co.uk/wp-content/uploads/films/Members--Scratch-Night-1-692x1024.jpg 692w, https://www.thegardencinema.co.uk/wp-content/uploads/films/Members--Scratch-Night-1-768x1137.jpg 768w\" sizes=\"auto, (max-width: 800px) 100vw, 800px\" /></a>\n      </div>\n\n      <div class=\"films-list__by-event__event__content-block\">\n        <span class=\"films-list__by-event__event__pre-title\">EVENT: </span>\n        <h2 class=\"films-list__by-event__event__title\"><a\n            href=\"https://www.thegardencinema.co.uk/film/members-scratch-night/\">Members' Scratch Night</a></h2>\n        <div class=\"films-list__by-event__event__date\">Fri 23 Jan 2026</div>\n\n\n                  <div class=\"synopsis-wrapper\">\n\n          <div class=\"films-list__by-event__synopsis\">\n                                              Our Members' Scratch Night returns on Friday 23 January to help more of the creatives in our membership community develop their WIP&hellip;\n\n              </div>\n          <div class=\"films-list__by-event__button\"><a href=\"https://www.thegardencinema.co.uk/film/members-scratch-night/\">Read&nbsp;more</a></div>\n        </div>\n\n      </div>\n\n    </div>\n  </div>\n      <div class=\"films-list__by-event__event\">\n    <div class=\"films-list__by-event__event__inner\">\n\n      <div class=\"films-list__by-event__event__image-block\">\n        <a href=\"https://www.thegardencinema.co.uk/festival/london-short-film-festival-2026/\">\n                      <img src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2025/12/LSFF_BLACK.png\" loading=\"lazy\"\n               class=\"films-list__by-event__event__image middle\"></a>\n                </div>\n\n      <div class=\"films-list__by-event__event__content-block\">\n        <span class=\"films-list__by-event__event__pre-title\">FESTIVAL: </span>\n        <h2 class=\"films-list__by-event__event__title\"><a\n            href=\"https://www.thegardencinema.co.uk/festival/london-short-film-festival-2026/\">London Short Film Festival 2026</a></h2>\n        <div class=\"films-list__by-event__event__date\"> Sun 25 Jan\n            </div>\n        <div class=\"synopsis-wrapper\">\n\n\n          <div class=\"films-list__by-event__synopsis\">\n                                              The UK’s leading short film festival, the London Short Film Festival (LSFF), returns for its 23rd edition from 23 January –&hellip; </div>\n\n          <div class=\"films-list__by-event__button\"><a href=\"https://www.thegardencinema.co.uk/festival/london-short-film-festival-2026/\">Read&nbsp;more</a>\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n  </div>\n      <div class=\"films-list__by-event__event\">\n    <div class=\"films-list__by-event__event__inner\">\n\n      <div class=\"films-list__by-event__event__image-block\">\n        <a href=\"https://www.thegardencinema.co.uk/film/video-bazaar-presents-burst-city/\">\n                        <img src=\"https://images.savoysystems.co.uk/GCL/4785815.jpg\" class=\"films-list__by-event__event__image middle\" alt=\"\"></a>\n      </div>\n\n      <div class=\"films-list__by-event__event__content-block\">\n        <span class=\"films-list__by-event__event__pre-title\">EVENT: </span>\n        <h2 class=\"films-list__by-event__event__title\"><a\n            href=\"https://www.thegardencinema.co.uk/film/video-bazaar-presents-burst-city/\">Video Bazaar presents: Burst City</a></h2>\n        <div class=\"films-list__by-event__event__date\">Tue 27 Jan 2026</div>\n\n\n          <span class=\"films-list__by-event__event__partner__link\">Screened in partnership with <a\n                  href=\"https://www.thegardencinema.co.uk/partner/video-bazaar/\">Video Bazaar</a> </span>        <div class=\"synopsis-wrapper\">\n\n          <div class=\"films-list__by-event__synopsis\">\n                                              Burst City is an explosive Molotov cocktail of dystopian sci-fi, Mad Max-style biker wars against yakuza gangsters and the police, and riotous&hellip;\n\n              </div>\n          <div class=\"films-list__by-event__button\"><a href=\"https://www.thegardencinema.co.uk/film/video-bazaar-presents-burst-city/\">Read&nbsp;more</a></div>\n        </div>\n\n      </div>\n\n    </div>\n  </div>\n      <div class=\"films-list__by-event__event\">\n    <div class=\"films-list__by-event__event__inner\">\n\n      <div class=\"films-list__by-event__event__image-block\">\n        <a href=\"https://www.thegardencinema.co.uk/film/avant-drag-qa/\">\n                        <img src=\"https://images.savoysystems.co.uk/GCL/4793178.jpg\" class=\"films-list__by-event__event__image middle\" alt=\"\"></a>\n      </div>\n\n      <div class=\"films-list__by-event__event__content-block\">\n        <span class=\"films-list__by-event__event__pre-title\">EVENT: </span>\n        <h2 class=\"films-list__by-event__event__title\"><a\n            href=\"https://www.thegardencinema.co.uk/film/avant-drag-qa/\">Avant-Drag! + Q&amp;A</a></h2>\n        <div class=\"films-list__by-event__event__date\">Sat 31 Jan 2026</div>\n\n\n                  <div class=\"synopsis-wrapper\">\n\n          <div class=\"films-list__by-event__synopsis\">\n                                              To mark the start of LGBT+ History Month, the Royal Anthropological Institute, in partnership with Spectra, Queer Non-Fiction Films, presents a&hellip;\n\n              </div>\n          <div class=\"films-list__by-event__button\"><a href=\"https://www.thegardencinema.co.uk/film/avant-drag-qa/\">Read&nbsp;more</a></div>\n        </div>\n\n      </div>\n\n    </div>\n  </div>\n      <div class=\"films-list__by-event__event\">\n    <div class=\"films-list__by-event__event__inner\">\n\n      <div class=\"films-list__by-event__event__image-block\">\n        <a href=\"https://www.thegardencinema.co.uk/film/terrys-gi-dad-qa/\">\n                        <img src=\"https://images.savoysystems.co.uk/GCL/4693966.jpg\" class=\"films-list__by-event__event__image middle\" alt=\"\"></a>\n      </div>\n\n      <div class=\"films-list__by-event__event__content-block\">\n        <span class=\"films-list__by-event__event__pre-title\">EVENT: </span>\n        <h2 class=\"films-list__by-event__event__title\"><a\n            href=\"https://www.thegardencinema.co.uk/film/terrys-gi-dad-qa/\">Terry's GI Dad + Q&amp;A</a></h2>\n        <div class=\"films-list__by-event__event__date\">Sat 31 Jan 2026</div>\n\n\n                  <div class=\"synopsis-wrapper\">\n\n          <div class=\"films-list__by-event__synopsis\">\n                                              London Breeze Film Festival is delighted to present the winner of its Best Feature Documentary award for 2025 at The Garden Cinema.&hellip;\n\n              </div>\n          <div class=\"films-list__by-event__button\"><a href=\"https://www.thegardencinema.co.uk/film/terrys-gi-dad-qa/\">Read&nbsp;more</a></div>\n        </div>\n\n      </div>\n\n    </div>\n  </div>\n      <div class=\"films-list__by-event__event\">\n    <div class=\"films-list__by-event__event__inner\">\n\n      <div class=\"films-list__by-event__event__image-block\">\n        <a href=\"https://www.thegardencinema.co.uk/film/four-springs/\">\n                        <img src=\"https://images.savoysystems.co.uk/GCL/4332311.jpg\" class=\"films-list__by-event__event__image middle\" alt=\"\"></a>\n      </div>\n\n      <div class=\"films-list__by-event__event__content-block\">\n        <span class=\"films-list__by-event__event__pre-title\">EVENT: </span>\n        <h2 class=\"films-list__by-event__event__title\"><a\n            href=\"https://www.thegardencinema.co.uk/film/four-springs/\">Four Springs</a></h2>\n        <div class=\"films-list__by-event__event__date\">Sat 14 Feb 2026</div>\n\n\n                  <div class=\"synopsis-wrapper\">\n\n          <div class=\"films-list__by-event__synopsis\">\n                                              The screening on 14 February will be followed by an online Q&A with the director Lu Qingyi. Four Springs is a&hellip;\n\n              </div>\n          <div class=\"films-list__by-event__button\"><a href=\"https://www.thegardencinema.co.uk/film/four-springs/\">Read&nbsp;more</a></div>\n        </div>\n\n      </div>\n\n    </div>\n  </div>\n      <div class=\"films-list__by-event__event\">\n    <div class=\"films-list__by-event__event__inner\">\n\n      <div class=\"films-list__by-event__event__image-block\">\n        <a href=\"https://www.thegardencinema.co.uk/film/we-are-doc-women-presents-still-pushing-pineapples-qa/\">\n                        <img src=\"https://images.savoysystems.co.uk/GCL/4787955.jpg\" class=\"films-list__by-event__event__image middle\" alt=\"\"></a>\n      </div>\n\n      <div class=\"films-list__by-event__event__content-block\">\n        <span class=\"films-list__by-event__event__pre-title\">EVENT: </span>\n        <h2 class=\"films-list__by-event__event__title\"><a\n            href=\"https://www.thegardencinema.co.uk/film/we-are-doc-women-presents-still-pushing-pineapples-qa/\">We Are Doc Women presents: Still Pushing Pineapples + Q&amp;A</a></h2>\n        <div class=\"films-list__by-event__event__date\">Wed 25 Feb 2026</div>\n\n\n          <span class=\"films-list__by-event__event__partner__link\">Screened in partnership with <a\n                  href=\"https://www.thegardencinema.co.uk/partner/we-are-doc-women/\">We Are Doc Women</a> </span>        <div class=\"synopsis-wrapper\">\n\n          <div class=\"films-list__by-event__synopsis\">\n                                              What happens when you’ve created the worst hit song ever – at least according to the music press? What comes after&hellip;\n\n              </div>\n          <div class=\"films-list__by-event__button\"><a href=\"https://www.thegardencinema.co.uk/film/we-are-doc-women-presents-still-pushing-pineapples-qa/\">Read&nbsp;more</a></div>\n        </div>\n\n      </div>\n\n    </div>\n  </div>\n      <div class=\"films-list__by-event__event\">\n    <div class=\"films-list__by-event__event__inner\">\n\n      <div class=\"films-list__by-event__event__image-block\">\n        <a href=\"https://www.thegardencinema.co.uk/film/members-sake-tasting-cheese/\">\n                        <img width=\"488\" height=\"598\" src=\"https://www.thegardencinema.co.uk/wp-content/uploads/films/Members--Sake-Tasting-1.jpg\" class=\"films-list__by-event__event__image middle\" alt=\"\" loading=\"lazy\" decoding=\"async\" srcset=\"https://www.thegardencinema.co.uk/wp-content/uploads/films/Members--Sake-Tasting-1.jpg 488w, https://www.thegardencinema.co.uk/wp-content/uploads/films/Members--Sake-Tasting-1-245x300.jpg 245w\" sizes=\"auto, (max-width: 488px) 100vw, 488px\" /></a>\n      </div>\n\n      <div class=\"films-list__by-event__event__content-block\">\n        <span class=\"films-list__by-event__event__pre-title\">EVENT: </span>\n        <h2 class=\"films-list__by-event__event__title\"><a\n            href=\"https://www.thegardencinema.co.uk/film/members-sake-tasting-cheese/\">Members' sake &amp; cheese tasting</a></h2>\n        <div class=\"films-list__by-event__event__date\">Sat 28 Feb 2026</div>\n\n\n                  <div class=\"synopsis-wrapper\">\n\n          <div class=\"films-list__by-event__synopsis\">\n                                              To celebrate our trip to 1980s Japan with our Lost Decade season, we're delighted to welcome back the team from Sake&hellip;\n\n              </div>\n          <div class=\"films-list__by-event__button\"><a href=\"https://www.thegardencinema.co.uk/film/members-sake-tasting-cheese/\">Read&nbsp;more</a></div>\n        </div>\n\n      </div>\n\n    </div>\n  </div>\n      <div class=\"films-list__by-event__event\">\n    <div class=\"films-list__by-event__event__inner\">\n\n      <div class=\"films-list__by-event__event__image-block\">\n        <a href=\"https://www.thegardencinema.co.uk/film/unknown-pleasures/\">\n                        <img src=\"https://images.savoysystems.co.uk/GCL/4747137.png\" class=\"films-list__by-event__event__image middle\" alt=\"\"></a>\n      </div>\n\n      <div class=\"films-list__by-event__event__content-block\">\n        <span class=\"films-list__by-event__event__pre-title\">EVENT: </span>\n        <h2 class=\"films-list__by-event__event__title\"><a\n            href=\"https://www.thegardencinema.co.uk/film/unknown-pleasures/\">Unknown Pleasures</a></h2>\n        <div class=\"films-list__by-event__event__date\">Sat 07 Mar 2026</div>\n\n\n                  <div class=\"synopsis-wrapper\">\n\n          <div class=\"films-list__by-event__synopsis\">\n                                              Two unemployed Chinese teenagers have trouble resisting the temptations of the Western world. &hellip;\n\n              </div>\n          <div class=\"films-list__by-event__button\"><a href=\"https://www.thegardencinema.co.uk/film/unknown-pleasures/\">Read&nbsp;more</a></div>\n        </div>\n\n      </div>\n\n    </div>\n  </div>\n    </div>\n        </div>\n  </div>\n</section>\n\n\n \n\n\n \n\n <link rel=\"stylesheet\" href=\"https://sibforms.com/forms/end-form/build/sib-styles.css\">\n<a name=\"newsletter\"></a>\n<section class=\"newsletter\">\n\t <div class=\"newsletter__inner\">\n\t\t\t \n\t\t\t\t<h1 class=\"newsletter__title\">Join our newsletter</h1>\n\t\t\t\t\t\t\t\t<div class=\"newsletter__