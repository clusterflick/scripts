\"Privacy policy\",\"link\":\"/privacy\",\"theme\":\"light-bottom\"};\n</script>\n\n<script type=\"text/javascript\" src=\"//cdnjs.cloudflare.com/ajax/libs/cookieconsent2/1.0.10/cookieconsent.min.js\"></script>\n<!-- End Cookie Consent plugin -->\n</head>\n<body itemscope itemtype=\"http://schema.org/WebPage\"  class=\"wp-singular film-template-default single single-film postid-24741 wp-theme-garden-cinema bringing-up-baby by-title film-bringing-up-baby\">\n\n    \n<div class=\"float-top\">\n\n  \n  <section class=\"header logged-out-savoy\">\n      <div class=\"header__row grid\">\n\n        <!-- Desktop menu -->\n\n        <div class=\"logo__inner\"><a href=\"/\"><img src=\"/wp-content/uploads/2021/11/Logo-Dark-Background.png\"\n                                                  class=\"gc-logo\"></a></div>\n\n        <!-- <div class=\"widget_nav_menu\">\n          <ul id=\"menu-blog-menu\" class=\"login-menu\"><li id=\"menu-item-8102\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-8102\"><a href=\"/videos-podcasts/\">Latest posts</a></li>\n<li id=\"menu-item-8100\" class=\"menu-item menu-item-type-taxonomy menu-item-object-category menu-item-8100\"><a href=\"https://www.thegardencinema.co.uk/videos-podcasts/video/\">Videos</a></li>\n<li id=\"menu-item-8101\" class=\"menu-item menu-item-type-taxonomy menu-item-object-category menu-item-8101\"><a href=\"https://www.thegardencinema.co.uk/videos-podcasts/podcasts/\">Podcasts</a></li>\n</ul></div> -->\n\n\n        <div class=\"mobile-menu-rhs\">\n            \n             <a class=\"membersarea-icon\" href=\"/activity\" title=\"Members' Area\" ><i class=\"fal fa-people-group\"></i></a>\n            \n          <a class=\"search-icon\" href=\"#modal-search\" rel=\"modal:open\" title=\"Search\"><i class=\"fal fa-search\"></i></a>\n\n          <a class=\"basket-icon\" title=\"Basket\" \n             href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsSum