            "mimeType": "text/html; charset=UTF-8",
            "text": "<!doctype html>\n<!--[if lt IE 7]><html lang=\"en-GB\" class=\"no-js lt-ie9 lt-ie8 lt-ie7\"><![endif]-->\n<!--[if (IE 7)&!(IEMobile)]><html lang=\"en-GB\" class=\"no-js lt-ie9 lt-ie8\"><![endif]-->\n<!--[if (IE 8)&!(IEMobile)]><html lang=\"en-GB\" class=\"no-js lt-ie9\"><![endif]-->\n<!--[if gt IE 8]><!--> <html lang=\"en-GB\" class=\"no-js\" bgcolor=\"#1f1f1f\"><!--<![endif]-->\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <meta name=\"HandheldFriendly\" content=\"True\">\n    <meta name=\"MobileOptimized\" content=\"320\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"/>\n    \n    \n    \n    <title>The Cup (Phörpa) + Live Music / The Garden Cinema</title>\n\t<style>img:is([sizes=\"auto\" i], [sizes^=\"auto,\" i]) { contain-intrinsic-size: 3000px 1500px }</style>\n\t<meta name=\"description\" content=\"The Cup will be preceded by an introduction from guest curator Anupma Shanker and a live Dranyen Lute performance by Tibetan mountain and folk singer, Ngawang Lodup. The critically-acclaimed directorial debut of Bhutanese-born filmmaker and Buddhist Lama Khyentse Norbu, The Cup&nbsp;involves two young football-crazed Tibetan refugee monks Palden and Nylma,&hellip;\">\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\">\n<link rel=\"canonical\" href=\"https://www.thegardencinema.co.uk/film/the-cup-phorpa-live-music/\">\n<meta property=\"og:url\" content=\"https://www.thegardencinema.co.uk/film/the-cup-phorpa-live-music/\">\n<meta property=\"og:site_name\" content=\"The Garden Cinema\">\n<meta property=\"og:locale\" content=\"en_GB\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"article:author\" content=\"https://www.facebook.com/p/The-Garden-Cinema-100037345105930/?locale=en_GB\">\n<meta property=\"article:publisher\" content=\"https://www.facebook.com/p/The-Garden-Cinema-100037345105930/?locale=en_GB\">\n<meta property=\"og:title\" content=\"The Cup (Phörpa) + Live Music / The Garden Cinema\">\n<meta property=\"og:description\" content=\"The Cup will be preceded by an introduction from guest curator Anupma Shanker and a live Dranyen Lute performance by Tibetan mountain and folk singer, Ngawang Lodup. The critically-acclaimed directorial debut of Bhutanese-born filmmaker and Buddhist Lama Khyentse Norbu, The Cup&nbsp;involves two young football-crazed Tibetan refugee monks Palden and Nylma,&hellip;\">\n<meta property=\"og:image\" content=\"https://images.savoysystems.co.uk/GCL/5562364.jpg\">\n<meta property=\"og:image:secure_url\" content=\"https://images.savoysystems.co.uk/GCL/5562364.jpg\">\n<meta property=\"og:image:width\" content=\"878\">\n<meta property=\"og:image:height\" content=\"878\">\n<meta name=\"twitter:card\" content=\"summary\">\n<meta name=\"twitter:site\" content=\"@thegardencinema\">\n<meta name=\"twitter:creator\" content=\"@thegardencinema\">\n<meta name=\"twitter:title\" content=\"The Cup (Phörpa) + Live Music / The Garden Cinema\">\n<meta name=\"twitter:description\" content=\"The Cup will be preceded by an introduction from guest curator Anupma Shanker and a live Dranyen Lute performance by Tibetan mountain and folk singer, Ngawang Lodup. The critically-acclaimed directorial debut of Bhutanese-born filmmaker and Buddhist Lama Khyentse Norbu, The Cup&nbsp;involves two young football-crazed Tibetan refugee monks Palden and Nylma,&hellip;\">\n<meta name=\"twitter:image\" content=\"https://images.savoysystems.co.uk/GCL/5562364.jpg\">\n<link rel=\"alternate\" type=\"application/rss+xml\" title=\"The Garden Cinema &raquo; Feed\" href=\"https://www.thegardencinema.co.uk/feed/\" />\n<link rel=\"alternate\" type=\"application/rss+xml\" title=\"The Garden Cinema &raquo; Comments Feed\" href=\"https://www.thegardencinema.co.uk/comments/feed/\" />\n<link rel=\"alternate\" type=\"application/rss+xml\" t