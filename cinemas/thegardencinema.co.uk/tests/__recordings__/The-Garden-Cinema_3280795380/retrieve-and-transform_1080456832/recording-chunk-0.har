/  Screening links -->\n      <div class=\"films-list__by-date__film__screeningtimes\">\n          <div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Sun 22 Nov</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening  pay_what_you_can \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_6041456.TcsSection_3060731\">11:00</a></span><span class=\"screening-tag ext-screening\"></span><span class=\"screening-tag ext-pay_what_you_can\"></span></div></div></div>      </div>\n    </div>\n  </div>\n    </div>\n  </div>\n                      <div class=\"films-list__by-date__blank\" data-members=\"1\">\n              <h1>No matches</h1>\n              <p>There are no screenings of this type currently scheduled</p>\n            </div>\n                      <div class=\"films-list__by-date__blank\" data-matinee=\"1\">\n              <h1>No matches</h1>\n              <p>There are no screenings of this type currently scheduled</p>\n            </div>\n            </div>\n</section>\n\n<!-- List films by title  A-Z - NOT IN USE -->\n\n<section class=\"alphabet-list\" style=\"display: none\">\n  <ul>\n         <li><a href=\"#by-title,A\">A</a></li>\n         <li><a href=\"#by-title,B\">B</a></li>\n         <li><a href=\"#by-title,C\">C</a></li>\n         <li><a href=\"#by-title,D\">D</a></li>\n         <li><a href=\"#by-title,E\">E</a></li>\n         <li><a href=\"#by-title,F\">F</a></li>\n         <li><a href=\"#by-title,G\">G</a></li>\n         <li><a href=\"#by-title,H\">H</a></li>\n         <li><a href=\"#by-title,I\">I</a></li>\n         <li><a href=\"#by-title,J\">J</a></li>\n         <li><a href=\"#by-title,K\">K</a></li>\n         <li><a href=\"#by-title,L\">L</a></li>\n         <li><a href=\"#by-title,M\">M</a></li>\n         <li><a href=\"#by-title,N\">N</a></li>\n         <li><a href=\"#by-title,O\">O</a></li>\n         <li><a href=\"#by-title,P\">P</a></li>\n         <li><a href=\"#by-title,Q\">Q</a></li>\n         <li><a href=\"#by-title,R\">R</a></li>\n         <li><a href=\"#by-title,S\">S</a></li>\n         <li><a href=\"#by-title,T\">T</a></li>\n         <li><a href=\"#by-title,U\">U</a></li>\n         <li><a href=\"#by-title,V\">V</a></li>\n         <li><a href=\"#by-title,W\">W</a></li>\n         <li><a href=\"#by-title,X\">X</a></li>\n         <li><a href=\"#by-title,Y\">Y</a></li>\n         <li><a href=\"#by-title,Z\">Z</a></li>\n      </ul>\n</section>\n\n\n\n<section class=\"films-list__by-title films-list-block\">\n\n\n  <div class=\"films-list__by-title__inner\">\n\n      <h2 class=\"films-list__by-title__title\" style=\"color: #215551;\">Browse films A–Z </h2>\n\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" id=\"starts-with-a\">\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/amyl-and-the-sniffers-presents-truth-or-consequence/\"><img class=\"films-list__by-title__film-thumb\" loading=\"lazy\" src=\"https://images.savoysystems.co.uk/GCL/5943820.jpg\" /></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/amyl-and-the-sniffers-presents-truth-or-consequence/\">Amyl and the Sniffers presents: Truth or Consequence <span class=\"film-detail__film__rating\">18</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>John Angus Stewart, 2026, USA, Australia, UK</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                Truth or Consequence is a concert film in which Amyl and the Sniffers perform country-influenced versions of their songs, two unreleased tracks, and a cover of the Slim Dusty classic 'Lights On The Hill'. It was recorded and filmed in front of an&hellip; <a href=\"https://www.thegardencinema.co.uk/film/amyl-and-the-sniffers-presents-truth-or-consequence/\">Read&nbsp;More</a>            </div>\n\n            <div class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Mon 31 Aug</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5984098.TcsSection_3060731\">18:00</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div>              </div>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" id=\"starts-with-b\">\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/bitter-christmas/\"><img class=\"films-list__by-title__film-thumb\" loading=\"lazy\" src=\"https://images.savoysystems.co.uk/GCL/5943542.jpg\" /></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/bitter-christmas/\">Bitter Christmas <span class=\"film-detail__film__rating\">15</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>Pedro Almodóvar, 2026, Spain</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                Bitter Christmas tells two alternating stories, one starring Elsa, an advertising director, in 2004, during a long weekend in December. The second takes place in 2026 and stars Raúl, a screenwriter and director who is writing a script that we soon discover is&hellip; <a href=\"https://www.thegardencinema.co.uk/film/bitter-christmas/\">Read&nbsp;More</a>            </div>\n\n            <div class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Fri 28 Aug</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening  audio_description \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5943599.TcsSection_3060731\">13:20</a></span><span class=\"screening-tag ext-screening\"></span><span class=\"screening-tag ext-audio_description\"></span></div><div class=\"screening-panel   screening  audio_description \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5943593.TcsSection_638\">16:00</a></span><span class=\"screening-tag ext-screening\"></span><span class=\"screening-tag ext-audio_description\"></span></div><div class=\"screening-panel   screening \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5943595.TcsSection_971\">17:45</a></span><span class=\"screening-tag ext-screening\"></span></div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel__date-title\">Sat 29 Aug</div><div class=\"screening-panel__list\"><div class=\"screening-panel   screening  audio_description \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuIt