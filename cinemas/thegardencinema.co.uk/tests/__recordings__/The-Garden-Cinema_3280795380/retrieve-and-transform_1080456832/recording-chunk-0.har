en-cinema/css/style.css?v=1782396595' type='text/css' media='all' />\n<!--[if lt IE 9]>\n<link rel='stylesheet' id='bones-ie-only-css' href='https://www.thegardencinema.co.uk/wp-content/themes/garden-cinema/css/ie.css' type='text/css' media='all' />\n<![endif]-->\n<script type=\"text/javascript\" src=\"https://www.thegardencinema.co.uk/wp-includes/js/jquery/jquery.min.js\" id=\"jquery-core-js\"></script>\n\n\n\n\n\n\n\n<script type=\"text/javascript\" id=\"map-js-extra\">\n/* <![CDATA[ */\nvar google_map = {\"map_icon\":{\"url\":\"https:\\/\\/www.thegardencinema.co.uk\\/wp-content\\/uploads\\/2019\\/06\\/icon-map-GC-e1559835169421.png\",\"size\":[64,64]}};\n/* ]]> */\n</script>\n\n\n<link rel=\"https://api.w.org/\" href=\"https://www.thegardencinema.co.uk/wp-json/\" /><link rel='shortlink' href='https://www.thegardencinema.co.uk/?p=25834' />\n<link rel=\"alternate\" title=\"oEmbed (JSON)\" type=\"application/json+oembed\" href=\"https://www.thegardencinema.co.uk/wp-json/oembed/1.0/embed?url=https%3A%2F%2Fwww.thegardencinema.co.uk%2Ffilm%2Fbroadcast-news%2F\" />\n<link rel=\"alternate\" title=\"oEmbed (XML)\" type=\"text/xml+oembed\" href=\"https://www.thegardencinema.co.uk/wp-json/oembed/1.0/embed?url=https%3A%2F%2Fwww.thegardencinema.co.uk%2Ffilm%2Fbroadcast-news%2F&#038;format=xml\" />\n\n\t<script type=\"text/javascript\">var ajaxurl = 'https://www.thegardencinema.co.uk/wp-admin/admin-ajax.php';</script>\n\n\t\t<style type=\"text/css\" id=\"wp-custom-css\">\n\t\t\t#menu-community-menu {\n    overflow: hidden !important; \n}\n.films-list__by-season__season__image{\n    object-fit: scale-down;\n}\n \n \t\t</style>\n\t\t     \n    <!-- Font Awesome Pro   -->\n    <script src=\"https://kit.fontawesome.com/57d80f9e95.js\" crossorigin=\"anonymous\"></script>\n    \n\n    <!-- <script src=\"https://cdnjs.cloudflare.com/ajax/libs/jquery/3.0.0/jquery.min.js\"></script>-->\n    \n    <!-- jQuery Modal -->\n  <!--\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/jquery-modal/0.9.1/jquery.modal.min.js\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/jquery-modal/0.9.1/jquery.modal.min.css\" />\n    -->\n    \n   <div  id=\"modal-search\" class=\"modal\">\n<form role=\"search\" method=\"get\" class=\"search-form\" action=\"https://www.thegardencinema.co.uk/\">\n  \n  <label>  <input type=\"search\" class=\"search-field\" \n            placeholder=\"Search films\"\n            value=\"\" name=\"s\"\n            title=\"Search for:\"  autofocus /></label>\n    \n    <button type=\"submit\"><i class=\"far fa-search\"></i></button>\n    <input type=\"submit\" class=\"search-submit hidden\"\n        value=\"Search\" />\n</form>\n</div>\n\n\n\n\n\n\n    \n     \n         <!-- Google tag (gtag.js) -->\n    <script async src=\"https://www.googletagmanager.com/gtag/js?id=G-CTS9XBV57S\"></script>\n    <script>\n      window.dataLayer = window.dataLayer || [];\n      function gtag(){dataLayer.push(arguments);}\n      gtag('js', new Date());\n\n      gtag('config', 'G-CTS9XBV57S');\n    </script>\n \n\n\n\t <!--Adobe Source Sans-->\n\t<link rel=\"stylesheet\" href=\"https://use.typekit.net/nzo1bak.css\">\n \t \n    <!-- Favicon -->\n    \n\n<link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n<link rel=\"manifest\" href=\"/site.webmanifest\">\n<link rel=\"mask-icon\" href=\"/safari-pinned-tab.svg\" color=\"#5bbad5\">\n<meta name=\"msapplication-TileColor\" content=\"#ffffff\">\n<meta name=\"theme-color\" content=\"#ffffff\">\n\n\n\t\n\t<!-- Begin Cookie Consent plugin by Silktide - http://silktide.com/cookieconsent -->\n<script type=\"text/javascript\">\n    window.cookieconsent_options = {\"message\":\"This website uses cookies to ensure you get the best experience on our website.\",\"dismiss\":\"Accept & Close\",\"learnMore\":\"Privacy policy\",\"link\":\"/privacy\",\"theme\":\"light-bottom\"};\n</script>\n\n<script type=\"text/javascript\" src=\"//cdnjs.cloudflare.com/ajax/libs/cookieconsent2/1.0.10/cookieconsent.min.js\"></script>\n<!-- End Cookie Consent plugin -->\n</head>\n<body itemscope itemtype=\"http://schema.org/WebPage\"  class=\"wp-singular film-template-default single single-film postid-25834 wp-theme-garden-cinema broadcast-news by-title film-broadcast-news\">\n\n    \n<div class=\"float-top\">\n\n  \n  <section class=\"header logged-out-savoy\">\n      <div class=\"header__row grid\">\n\n        <!-- Desktop menu -->\n\n        <div class=\"logo__inner\"><a href=\"/\"><img src=\"/wp-content/uploads/2021/11/Logo-Dark-Background.png\"\n                                                  class=\"gc-logo\"></a></div>\n\n        <!-- <div class=\"widget_nav_menu\">\n          <ul id=\"menu-blog-menu\" class=\"login-menu\"><li id=\"menu-item-8102\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-8102\"><a href=\"/videos-podcasts/\">Latest posts</a></li>\n<li id=\"menu-item-8100\" class=\"menu-item menu-item-type-taxonomy menu-item-object-category menu-item-8100\"><a href=\"https://www.thegardencinema.co.uk/videos-podcasts/video/\">Videos</a></li>\n<li id=\"menu-item-8101\" class=\"menu-item menu-item-type-taxonomy menu-item-object-category menu-item-8101\"><a href=\"https://www.thegardencinema.co.uk/videos-podcasts/podcasts/\">Podcasts</a></li>\n</ul></div> -->\n\n\n        <div class=\"mobile-menu-rhs\">\n            \n             <a class=\"membersarea-icon\" href=\"/activity\" title=\"Members' Area\" ><i class=\"fal fa-people-group\"></i></a>\n            \n          <a class=\"search-icon\" href=\"#modal-search\" rel=\"modal:open\" title=\"Search\"><i class=\"fal fa-search\"></i></a>\n\n          <a class=\"basket-icon\" title=\"Basket\" \n             href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems