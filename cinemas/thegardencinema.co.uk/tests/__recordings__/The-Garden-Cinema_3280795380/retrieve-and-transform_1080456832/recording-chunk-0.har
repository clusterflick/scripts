f=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5839482.TcsSection_3060731\">15:45</a></span><span class=\"screening-tag ext-audio_description\"></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel   audio_description \"><div class=\"screening-panel__date-title\">Thu 23 Jul</div><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5839484.TcsSection_3060731\">15:45</a></span><span class=\"screening-tag ext-audio_description\"></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div>              </span>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" id=\"starts-with-w\">\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/wallace-gromit-a-grand-day-out-the-wrong-trousers-a-close-shave/\"><img src=\"https://images.savoysystems.co.uk/GCL/1659109.jpg\" class=\"films-list__by-title__film-thumb\" alt=\"\"></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/wallace-gromit-a-grand-day-out-the-wrong-trousers-a-close-shave/\">Wallace &amp; Gromit: A Grand Day Out, The Wrong Trousers, A Close Shave <span class=\"film-detail__film__rating\">PG</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>Nick Park, 1989, 1993, 1995, UK</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                As the school holidays begin we're bringing Aardman Animations' three half-hour specials back to The Garden Cinema. Featuring the Oscar-winning duo - charming and eccentric inventor Wallace and his faithful four-legged companion Gromit. A Grand Day Out: Wallace and Gromit enjoy a&hellip; <a href=\"https://www.thegardencinema.co.uk/film/wallace-gromit-a-grand-day-out-the-wrong-trousers-a-close-shave/\">Read&nbsp;More</a>            </div>\n\n            <span class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel  \"><div class=\"screening-panel__date-title\">Sat 18 Jul</div><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5839604.TcsSection_971\">13:30</a></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel  \"><div class=\"screening-panel__date-title\">Mon 20 Jul</div><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5839610.TcsSection_3060731\">15:15</a></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel  \"><div class=\"screening-panel__date-title\">Tue 21 Jul</div><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5839626.TcsSection_971\">16:00</a></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel  \"><div class=\"screening-panel__date-title\">Wed 22 Jul</div><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5839630.TcsSection_638\">14:15</a></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div><div class=\"screening-panel__day\"><div class=\"screening-panel  \"><div class=\"screening-panel__date-title\">Thu 23 Jul</div><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5839632.TcsSection_971\">15:15</a></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div>              </span>\n          </div>\n\n\n        </div>\n        </div>\n</section>\n\n\n<!-- List Seasons -->\n\n\n<section class=\"films-list__by-season films-list-block\">\n  <div class=\"films-list__by-season__inner\">\n          <div class=\"films-list__by-season__row\">\n                  <div class=\"films-list__by-season__season\">\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/season/screwball-summer/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2026/04/cut-out-screwball-1.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/season/screwball-summer/\">Screwball Summer</a></div>\n                <div class=\"films-list__by-season__season__date\">\n\n                    Sun 24 May  &#8212;  Tue 18 Aug 2026\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">There has never been such a successful collision of silliness and sophistication in the history of cinema as the Screwball Comedy. Speedy dialogue, couples’ quarrels, and slapstick are inseparable from razor-sharp wit, and&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/season/screwball-summer/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                  <div class=\"films-list__by-season__season\">\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/season/south-asian-heritage-month-2026/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2026/05/cut-out-southasian-ok-1.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/season/south-asian-heritage-month-2026/\">South Asian Heritage Month 2026</a></div>\n                <div class=\"films-list__by-season__season__date\">\n\n                    Wed 01 Jul  &#8212;  Fri 31 Jul 2026\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\"> This July, we are once again celebrating South Asian Heritage Month with an array of newly restored classics, anniversary screenings, critically acclaimed new titles, live music, expert introductions, and Q&As.  The season&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/season/south-asian-heritage-month-2026/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                  <div class=\"films-list__by-season__season\">\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/season/hong-kong-golden-age-1985-1997/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2026/06/cuout-hong-kong2026-new.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/season/hong-kong-golden-age-1985-1997/\">Hong Kong Golden Age 1985-1997</a></div>\n                <div class=\"films-list__by-season__season__date\">\n\n                    Thu 09 Jul  &#8212;  Thu 27 Aug 2026\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">Following last year’s Hong Kong New Wave 1979–1989 season, The Garden Cinema broadens its focus to the wider Golden Age of Hong Kong cinema, a remarkable era spanning the late 1970s through to the 1990s&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/season/hong-kong-golden-age-1985-1997/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                  <div class=\"films-list__by-season__season\">\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/season/members-summer-selection-2026/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2026/06/cut-out-summer2026-wave1.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/season/members-summer-selection-2026/\">Members' Summer Selection 2026</a></div>\n                <div class=\"films-list__by-season__season__date\">\n\n                    Sat 18 Jul  &#8212;  Mon 31 Aug 2026\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">Inspired by your many suggestions on the Members’ Area and passionate campaigning for your favourite films, our Members’ Summer Selection returns once again. We’ve taken into account support and upvotes from the community, as well as&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/season/members-summer-selection-2026/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n            </div>\n\n    <p class=\"season-detail__more-seasons-link\"><a href=\"/#by-season\">Current Seasons</a> | <a\n        href=\"/about-us/archive-seasons/\">Past Seasons</a></p>\n\n  </div>\n</section>\n\n<!-- List Strands -->\n\n\n<section class=\"films-list__by-strand films-list-block\">\n  <div class=\"films-list__by-season__inner\">\n          <div class=\"films-list__by-season__row\">\n        \n        \n        \n                           <div class=\"films-list__by-season__season hidden- \"    >\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/strand/greek-salad/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2026/02/stella-3-1.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/strand/greek-salad/\">Greek Salad</a></div>\n                <div class=\"films-list__by-season__season__date\" style=\"display: none\">\n\n                    Thu 19 Mar  &#8212;  Fri 09 Feb 2052\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">Greek Salad is an ongoing Greek cinema strand. Each screening explores a gem of Greek cinema – tossing together classics, festival favourites, and directors’ spotlights alike. After concluding our mini retrospective on maverick&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/strand/greek-salad/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                                   <div class=\"films-list__by-season__season hidden- \"    >\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/strand/films-for-the-family/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2022/06/bambi-cut-out-colour.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/strand/films-for-the-family/\">Films for the Family</a></div>\n                <div class=\"films-list__by-season__season__date\" style=\"display: none\">\n\n                    Sun 24 Jul  &#8212;  Sun 01 Jan 2040\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">Join us every Saturday & Sunday morning and on weekdays during the school holidays for some of our favourite family classics. For cinema lovers of all ages. On Sundays the films are followed&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/strand/films-for-the-family/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                                   <div class=\"films-list__by-season__season hidden- \"    >\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/strand/members-events/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2024/08/cut-out-members3.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/strand/members-events/\">Members' Events</a></div>\n                <div class=\"films-list__by-season__season__date\" style=\"display: none\">\n\n                    Fri 25 Mar  &#8212;  Tue 08 May 2040\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">Events for members only, including free fortnightly screenings for Garden Cinema Members with films chosen for members, by members. Selected films are added regularly, so keep an eye on this page for updates.&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/strand/members-events/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                                   <div class=\"films-list__by-season__season hidden- \"    >\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/strand/planting-seeds/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2025/01/thumbnail_planting-seeds-cut-out.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/strand/planting-seeds/\">Planting Seeds</a></div>\n                <div class=\"films-list__by-season__season__date\" style=\"display: none\">\n\n                    Sat 05 Apr  &#8212;  Mon 31 Dec 2040\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\"> The Garden Cinema’s strand for nature and environment-focused screenings. We have curated a selection of international films that span many genres, themes and countries to tell stories of resilience and resistance through&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/strand/planting-seeds/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                                   <div class=\"films-list__by-season__season hidden- \"    >\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/strand/composing-cinema/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2025/09/composing-cinema-cutout.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/strand/composing-cinema/\">Composing Cinema</a></div>\n                <div class=\"films-list__by-season__season__date\" style=\"display: none\">\n\n                    Mon 27 Oct  &#8212;  Mon 31 Dec 2040\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">Composing Cinema celebrates the bespoke musical contributions made by composers to the world of film and includes guest introductions, Q&As, and live scores. &hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/strand/composing-cinema/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                                   <div class=\"films-list__by-season__season hidden- \"    >\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/strand/select-japan/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2025/04/cut-out-kikujiro.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/strand/select-japan/\">Select Japan</a></div>\n                <div class=\"films-list__by-season__season__date\" style=\"display: none\">\n\n                    Mon 14 Apr  &#8212;  Mon 23 Apr 2040\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">Select Japan is an initiative from The Garden Cinema to showcase the best of Japanese cinema, classic and contemporary, with a focus on titles and filmmakers which have been rarely screened in the&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/strand/select-japan/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                                   <div class=\"films-list__by-season__season hidden- \"    >\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/strand/chinese-cinema-project/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2025/04/Page-Icon.png\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/strand/chinese-cinema-project/\">Chinese Cinema Project</a></div>\n                <div class=\"films-list__by-season__season__date\" style=\"display: none\">\n\n                    Sat 19 Nov  &#8212;  Sun 01 Jan 2040\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">The Chinese Cinema Project is an exhibition initiative presented by The Garden Cinema. It showcases works from emerging and under-represented Chinese filmmakers via regular screenings, exploring auteurship and cinematic beauty in its various&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/strand/chinese-cinema-project/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                                   <div class=\"films-list__by-season__season hidden- \"    >\n            <div class=\"films-list__by-season__season__inner\">\n\n              <a href=\"https://www.thegardencinema.co.uk/strand/dear-italy/\" class=\"films-list__by-season__season__image-block\">\n                  <img loading=\"lazy\"\n                                                    class=\"films-list__by-season__season__image middle\"\n                                                    src=\"https://www.thegardencinema.co.uk/wp-content/uploads/2026/05/cut-out-vitti.jpg\">\n                                </a>\n              <div class=\"films-list__by-season__season__content-block\">\n                <div class=\"films-list__by-season__season__title\"><a\n                    href=\"https://www.thegardencinema.co.uk/strand/dear-italy/\">Dear Italy</a></div>\n                <div class=\"films-list__by-season__season__date\" style=\"display: none\">\n\n                    Fri 19 Sep  &#8212;  Mon 31 Dec 2040\n                </div>\n\n                  \n                <div class=\"films-list__by-season__season__description\">Dear Italy is The Garden Cinema’s love letter to Italian Cinema. We are delighted to showcase films not only widely considered classics but also the most beloved by audiences and critics alike. This&hellip;</div>\n                <a class=\"films-list__by-season__season__button\"\n                   href=\"https://www.thegardencinema.co.uk/strand/dear-italy/\">Read&nbsp;more</a>\n\n              </div>\n\n            </div>\n          </div>\n                                     </div>\n  </div>\n</section>\n\n<!-- List Events -->\n\n<section class=\"films-list__by-event films-list-block\">\n  <div class=\"films-list__by-event__inner\">\n    <div class=\"films-list__by-event__row\">\n          <div class=\"films-list__by-event__event\">\n    <div class=\"films-list__by-event__event__inner\">\n\n      <div class=\"films-list__by-event__event__image-block\">\n        <a href=\"https://www.thegardencinema.co.uk/film/the-day-innocence-died-bloody-sunday-and-the-fight-for-justice-qa/\">\n                        <img src=\"https://images.savoysystems.co.uk/GCL/5693180.jpg\" class=\"films-list__by-event__event__image middle\" alt=\"\"></a>\n      </div>\n\n      <div class=\"films-list__by-event__event__content-block\">\n        <span class=\"films-list__by-event__event__pre-title\">EVENT: </span>\n        <h2 class=\"films-list__by-event__event__title\"><a\n            href=\"https://www.thegardencinema.co.uk/film/the-day-innocence-died-bloody-sund