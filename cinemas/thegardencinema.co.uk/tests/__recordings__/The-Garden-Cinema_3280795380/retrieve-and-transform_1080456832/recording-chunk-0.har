            "mimeType": "text/html; charset=UTF-8",
            "text": "<!doctype html>\n<!--[if lt IE 7]><html lang=\"en-GB\" class=\"no-js lt-ie9 lt-ie8 lt-ie7\"><![endif]-->\n<!--[if (IE 7)&!(IEMobile)]><html lang=\"en-GB\" class=\"no-js lt-ie9 lt-ie8\"><![endif]-->\n<!--[if (IE 8)&!(IEMobile)]><html lang=\"en-GB\" class=\"no-js lt-ie9\"><![endif]-->\n<!--[if gt IE 8]><!--> <html lang=\"en-GB\" class=\"no-js\" bgcolor=\"#1f1f1f\"><!--<![endif]-->\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <meta name=\"HandheldFriendly\" content=\"True\">\n    <meta name=\"MobileOptimized\" content=\"320\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"/>\n    \n    \n    \n    <title>Marketa Lazarová / The Garden Cinema</title>\n<meta name=\"description\" content=\"Our screening on Friday 9 October will be introduced by Czech film expert Peter Hames. Voted the best Czech film ever made, Marketa Lazarov&#225;&nbsp;is a powerful and passionate medieval epic set in the mid-13th Century. Based on avant-garde writer Vladislav Vancura&#039;s novel, it follows the rivalry between two warring clans,&hellip;\">\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\">\n<link rel=\"canonical\" href=\"https://www.thegardencinema.co.uk/film/marketa-lazarova/\">\n<meta property=\"og:url\" content=\"https://www.thegardencinema.co.uk/film/marketa-lazarova/\">\n<meta property=\"og:site_name\" content=\"The Garden Cinema\">\n<meta property=\"og:locale\" content=\"en_GB\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"article:author\" content=\"https://www.facebook.com/p/The-Garden-Cinema-100037345105930/?locale=en_GB\">\n<meta property=\"article:publisher\" content=\"https://www.facebook.com/p/The-Garden-Cinema-100037345105930/?locale=en_GB\">\n<meta property=\"og:title\" content=\"Marketa Lazarová / The Garden Cinema\">\n<meta property=\"og:description\" c