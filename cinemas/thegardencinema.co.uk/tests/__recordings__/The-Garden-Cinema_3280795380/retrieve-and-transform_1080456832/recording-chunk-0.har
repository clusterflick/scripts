gardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5943718.TcsSection_3060731\">16:00</a></span><span class=\"screening-tag ext-screening\"></span><span class=\"screening-tag ext-audio_description\"></span></div><div class=\"screening-panel   screening  audio_description \"><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_5943722.TcsSection_971\">20:15</a></span><span class=\"screening-tag ext-screening\"></span><span class=\"screening-tag ext-audio_description\"></span></div></div></div>              </div>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" id=\"starts-with-j\">\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/john-the-violent/\"><img class=\"films-list__by-title__film-thumb\" loading=\"lazy\" src=\"https://images.savoysystems.co.uk/GCL/5599866.jpg\" /></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/john-the-violent/\">John the Violent <span class=\"film-detail__film__rating\">18</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>Tonia Marketaki/ 1973/ Greece</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                The screening on Thursday 22 October will be introduced by Film Lecturer Tonia Kazakopoulou. Synopsis: It’s midnight on a deserted street in Athens. A young woman is stabbed to death by a stranger, who instantly slips into the shadows. Uppon his arrest,&hellip; <a href=\"https://www.thegard