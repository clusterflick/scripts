sets/css/wp-ulike.min.css' type='text/css' media='all' />\n<link rel='stylesheet' id='bones-stylesheet-css' href='https://www.thegardencinema.co.uk/wp-content/themes/garden-cinema/css/style.css?v=1787661836' type='text/css' media='all' />\n<!--[if lt IE 9]>\n<link rel='stylesheet' id='bones-ie-only-css' href='https://www.thegardencinema.co.uk/wp-content/themes/garden-cinema/css/ie.css' type='text/css' media='all' />\n<![endif]-->\n<script type=\"text/javascript\" src=\"https://www.thegardencinema.co.uk/wp-includes/js/jquery/jquery.min.js\" id=\"jquery-core-js\"></script>\n\n\n\n<script type=\"text/javascript\" id=\"garden-cinema-js-extra\">\n/* <![CDATA[ */\nvar gcAjax = {\"nonce\":\"ecd9ff4892\"};\n/* ]]> */\n</script>\n\n\n\n\n<script type=\"text/javascript\" id=\"map-js-extra\">\n/* <![CDATA[ */\nvar google_map = {\"map_icon\":{\"url\":\"https:\\/\\/www.thegardencinema.co.uk\\/wp-content\\/uploads\\/2019\\/06\\/icon-map-GC-e1559835169421.png\",\"size\":[64,64]}};\n/* ]]> */\n</script>\n\n\n<link rel=\"https://api.w.org/\" href=\"https://www.thegardencinema.co.uk/wp-json/\" /><link rel=\"alternate\" title=\"JSON\" type=\"application/json\" href=\"https://www.thegardencinema.co.uk/wp-json/wp/v2/pages/2\" /><link rel='shortlink' href='https://www.thegardencinema.co.uk/' />\n<link rel=\"alternate\" title=\"oEmbed (JSON)\" type=\"application/json+oembed\" href=\"https://www.thegardencinema.co.uk/wp-json/oembed/1.0/embed?url=https%3A%2F%2Fwww.thegardencinema.co.uk%2F\" />\n<link rel=\"alternate\" title=\"oEmbed (XML)\" type=\"text/xml+oembed\" href=\"https://www.thegardencinema.co.uk/wp-json/oembed/1.0/embed?url=https%3A%2F%2Fwww.thegardencinema.co.uk%2F&#038;format=xml\" />\n\n\t<script type=\"text/javascript\">var ajaxurl = 'https://www.thegardencinema.co.uk/wp-admin/admin-ajax.php';</script>\n\n\t\t<style type=\"text/css\" id=\"wp-custom-css\">\n\t\t\t#menu-community-menu {\n    overflow: hidden !important; \n}\n.films-list__by-season__season__image{\n    object-fit