ng \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWebTab_0.TcsPerformance_4783898.TcsSection_971\">20:35</a></span>  <div class=\"screening-panel__footer-row\">\n      </div></div></div>              </span>\n          </div>\n\n\n        </div>\n      \n\n        <div class=\"films-list__by-title__film\" style=\"background-image: url();\" id=\"starts-with-c\">\n          <div class=\"films-list__by-title__film-image\">\n                          <a\n              href=\"https://www.thegardencinema.co.uk/film/the-crazy-family/\"><img src=\"https://images.savoysystems.co.uk/GCL/4292246.jpg\" class=\"films-list__by-title__film-thumb\" alt=\"\"></a>\n          </div>\n\n          <div class=\"films-list__by-title__film-content\">\n            <h2\n              class=\"films-list__by-title__film-title\"><a  href=\"https://www.thegardencinema.co.uk/film/the-crazy-family/\">The Crazy Family <span class=\"film-detail__film__rating\">18</span></a></h2>\n\n            <div class=\"films-list__by-title__az-summary\">\n              <em>Gakuryu Ishii, 1984, Japan</em></div>\n\n            <div class=\"films-list__by-title__synopsis\">\n                                Our screening on Saturday 31 January will be introduced by Tom Cunliffe (UCL), and will be followed by a post film discussion group in the Atrium Bar. The Kobayashi family finally are able to move out of their tiny, cramped Tokyo apartment&hellip; <a href=\"https://www.thegardencinema.co.uk/film/the-crazy-family/\">Read&nbsp;More</a>            </div>\n\n            <span class=\"films-list__by-title__screenings\">\n                  <div class=\"screening-panel__day\"><div class=\"screening-panel   intro \"><div class=\"screening-panel__date-title\">Sat 31 Jan</div><span class=\"screening-time\"><a class=\"screening \" href=\"https://bookings.thegardencinema.co.uk/TheGardenCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_0.TcsWe