   </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"/about-us/contact-us\" data-drupal-link-system-path=\"node/2731\">Contact us</a>\n                      </li>\n        </ul>\n      \n              </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us\" data-drupal-link-system-path=\"node/3790\">Support us</a>\n                      </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"https://shop.sciencemuseum.org.uk/  \" rel=\"noopener noreferrer\">Shop</a>\n                      </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"https://wonderlabplus.sciencemuseumgroup.org.uk/\" rel=\"noopener noreferrer\">Wonderlab+</a>\n                      </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"https://blog.sciencemuseum.org.uk/\" rel=\"noopener noreferrer\">Blog</a>\n                      </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"https://my.sciencemuseum.org.uk/account/create/brief\" rel=\"noopener noreferrer\">Newsletter</a>\n                      </li>\n        </ul>\n          </div>\n    </div>\n      \n\n  </div>\n<div id=\"block-openinghoursblock\" class=\"c-secondary-nav__block -bg-white\">\n  \n    \n            <p class=\"o-menu\">\n                  Free entry<br>\n                 Open daily, 10.00–18.00 \n      </p>\n        <p class=\"o-menu -fade\">\n              Science Museum<br>\n                          Exhibition Road<br>\n                  London SW7 2DD\n    </p>\n    <a class=\"o-menu\" href=\"https://www.google.co.uk/maps/dir//Science+Museum,+Exhibition+Rd,+Kensington,+London+SW7+2DD\" rel=\"noreferrer\">\n      View on Google Maps\n  </a>\n    \n  </div>\n\n  </div>\n  </div>\n          </div>\n        </div>\n      </div>\n                <div class=\"o-message\">\n  <div class=\"o-container\">\n                                  <p><a href=\"https://my.sciencemuseum.org.uk/events?view=calendar&amp;kid=441\">Book your free general admission tickets to visit the Science Museum here</a>. Schools and groups can <a href=\"/groups\" data-entity-type=\"node\" data-entity-uuid=\"ccd38c13-451c-401f-b91b-e95cafc5737e\" data-entity-substitution=\"canonical\">book free general admission tickets here</a>.&nbsp;<br>The museum will be open from 09.00 every morning from Saturday 14 – Friday 20 February.</p>\n\n      \n      \n      </div>\n</div>\n\n\n            <div class=\"o-mobile-menu\">\n      <nav  id=\"block-menunavigation-science-mobile\" class=\"o-list c-menu-mobile\" aria-label=\"Mobile navigation\">\n        \n            <div class=\"c-menu-drilldown -mobile\">\n      <div class=\"c-menu-drilldown__container\">\n      <ul class=\"o-list c-menu-drilldown__root\">\n              \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Visit</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/visit\" data-drupal-link-system-path=\"node/2746\">Visit</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/visit/food-and-drink\" title=\"Food and drink\" data-drupal-link-system-path=\"node/2674\">Food and drink</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/visit/accessibility\" data-drupal-link-system-path=\"node/2677\">Accessibility</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/see-and-do\" data-drupal-link-system-path=\"node/2926\">See and do</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/objects-and-stories\" data-drupal-link-system-path=\"node/2932\">Objects and stories</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Groups</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/groups\" data-drupal-link-system-path=\"node/2923\">Groups</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item menu-item--collapsed\">\n                  <a href=\"/groups/formal-education-groups\" data-drupal-link-system-path=\"node/2938\">Formal education groups</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/groups/other-groups\" data-drupal-link-system-path=\"node/12503\">Other Groups</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/groups/home-educating-visit\" data-drupal-link-system-path=\"node/10004\">Home Educators</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/groups/community-partnerships\" data-drupal-link-system-path=\"node/15125\">Community partnerships</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/groups/groups-faqs\" data-drupal-link-system-path=\"node/12505\">FAQs for groups</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://learning.sciencemuseumgroup.org.uk/\" rel=\"noopener noreferrer\">Learning resources</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item menu-item--collapsed\">\n                  <a href=\"/groups/teacher-cpd-and-events\" data-drupal-link-system-path=\"node/2935\">Educator CPD and events</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/travel-trade\" data-drupal-link-system-path=\"node/14719\">Travel Trade</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Researchers</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/researchers\" data-drupal-link-system-path=\"node/3784\">Researchers</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Dana Research Centre and Library</button>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/researchers/research-events\" data-drupal-link-system-path=\"node/6982\">Research Events</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"http://journal.sciencemuseum.ac.uk\" rel=\"noopener noreferrer\">Science Museum Group Journal</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">About us</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us\" data-drupal-link-system-path=\"node/2929\">About us</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/press-office\" data-drupal-link-system-path=\"node/2944\">Press office</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://www.hirethesciencemuseum.com/\" rel=\"noopener noreferrer\">Venue hire</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://www.sciencemuseumgroup.org.uk/work-with-us\" rel=\"noopener noreferrer\">Jobs</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/volunteering-science-museum\" data-drupal-link-system-path=\"node/2728\">Volunteering</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/contact-us\" data-drupal-link-system-path=\"node/2731\">Contact us</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us\" data-drupal-link-system-path=\"node/3790\">Support us</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://shop.sciencemuseum.org.uk/  \" rel=\"noopener noreferrer\">Shop</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://wonderlabplus.sciencemuseumgroup.org.uk/\" rel=\"noopener noreferrer\">Wonderlab+</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://blog.sciencemuseum.org.uk/\" rel=\"noopener noreferrer\">Blog</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://my.sciencemuseum.org.uk/account/create/brief\" rel=\"noopener noreferrer\">Newsletter</a>\n                      </li>\n    \n          <li>\n        <div class=\"site-search-form c-search-mob\" data-drupal-selector=\"site-search-form-2\" id=\"block-sitesearchform-mobile\">\n  \n  <div class=\"c-search-mob__form\">\n    \n        \n        <form autocomplete=\"off\" block=\"block-sitesearchform-mobile\" action=\"/see-and-do/star-trek-into-darkness\" method=\"post\" id=\"site-search-form-mobile\" accept-charset=\"UTF-8\">\n  <div class=\"js-form-item form-item form-type-search js-form-type-search form-item-term js-form-item-term\">\n      <label for=\"edit-term-mobile\">\n    Search the site\n\n      </label>\n        <input data-drupal-selector=\"edit-term\" data-msg-maxlength=\"Search the site field has a maximum length of 128.\" type=\"search\" id=\"edit-term-mobile\" name=\"term\" value=\"\" size=\"60\" maxlength=\"128\" class=\"form-search\" />\n\n        </div>\n<input data-drupal-selector=\"form-kgnyg846uwoj8u2torankxtsm0onllkgsvyqhzjpmho\" type=\"hidden\" name=\"form_build_id\" value=\"form-KGNYg846Uwoj8U2tOrANkxTSm0oNLlkgSVyqHZJPMHo\" />\n<input data-drupal-selector=\"edit-site-search-form-2\" type=\"hidden\" name=\"form_id\" value=\"site_search_form\" />\n<div data-drupal-selector=\"edit-actions\" class=\"form-actions js-form-wrapper form-wrapper\" id=\"edit-actions-mobile\">\n\n<button  data-drupal-selector=\"site-search-form-button\" type=\"submit\" id=\"site-search-form-button-mobile\" name=\"op\" value=\"Submit\" class=\"button js-form-submit form-submit btn btn--primary\">\n  Submit\n  <svg class=\"o-icon btn__icon\" role=\"presentation\">\n    <use xlink:href=\"#arrow-bold-right\"></use>\n  </svg>\n</button></div>\n\n</form>\n\n      </div>\n\n</div>\n\n      </li>\n        </ul>\n          </div>\n    </div>\n      \n\n  </nav>\n  </div>\n    </header>\n        <div id=\"main-wrapper\" class=\"o-main-wrapper clearfix\">\n      <div id=\"main\" class=\"clearfix\">\n        \n        <main id=\"main-content\" tabindex=\"-1\">\n                            \n\n<div data-drupal-messages-fallback class=\"hidden\"></div>\n\n\n                              \n                      <article class=\"h-relative\">\n  \n  \n<div class=\"h-relative\">\n  <div class=\"c-banner-medium c-banner-medium--media\">\n    \n  \n    \n    <div class=\"c-banner-medium__element c-banner-medium__element--color\" style=\"background:#143352\">\n      <div class=\"c-banner-medium__column\" style=\"color:#143352\">\n                  <img src=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/her/public/2026-02/ST12_INTO_DARKNESS.jpg?h=7d69bdbb&amp;itok=H8UPYDGA\" class=\"c-banner-medium__img\" alt=\"\"/>\n              </div>\n    </div>\n    <div class=\"c-banner-medium__overlay\">\n      <div class=\"c-banner-medium__container | o-container\">\n        <div class=\"c-breadcrumb  | js-breadcrumb\">\n              <span class=\"visually-hidden\">You are here:</span>\n    <ol class=\"o-list c-breadcrumb__links\">\n    \n          <li>\n                  <a href=\"/\">\n                          <svg class=\"o-icon c-breadcrumb__divider-icon\" role=\"presentation\">\n                <use xlink:href=\"#arrow-bold-right\"></use>\n              </svg>\n                        Home\n          </a>\n              </li>\n          <li>\n                  <a href=\"/see-and-do\">\n                        See and do\n          </a>\n              </li>\n        </ol>\n\n        </div>\n\n                <h1 class=\"visually-hidden\"><span class=\"h-relative\">Star Trek Into Darkness (12A) </span>\n</h1>\n\n        <div aria-hidden=\"true\" class=\"c-banner-medium__title | o-title o-title--primary\">\n          <span class=\"js-cascade\"><span class=\"h-relative\">Star Trek Into Darkness (12A) </span>\n</span>\n        </div>\n              </div>\n    </div>\n  </div>\n</div>\n\n    <div class=\"o-main-content | js-sticky-container\">\n    <!-- Body content -->\n    <div class=\"o-body -first\">\n      <div class=\"o-container u-order\">\n        <div class=\"o-content u-order-body\">\n          <div class=\"c-wysiwyg\">\n              <div class=\"o-text-introduction\">\n                            <p>Experience the thrilling second chapter in the rebooted <em>Star Trek</em>&nbsp;saga on one of the UK's biggest screens. This IMAX presentation includes select scenes in expanded 1.90 aspect ratio for enhanced immersion</p>\n\n      \n              </div>\n                          <p><span lang=\"EN-US\">After a devastating terrorist attack at the heart of the Federation, Captain James T. Kirk (Chris Pine) and the crew of the </span><em><span lang=\"EN-US\">U.S.S. Enterprise</span></em><span lang=\"EN-US\">, including Spock (Zachary Quinto), Uhura (Zoe Saldana), Dr. McCoy (Karl Urban) and Scotty (Simon Pegg), are launched on a relentless manhunt into enemy territory.</span></p><p><span lang=\"EN-US\">Their target is a mysterious and terrifying adversary (Benedict Cumberbatch), a seemingly unstoppable force of destruction whose actions threaten to tear Starfleet apart from within.</span></p><p><span lang=\"EN-US\">Directed and produced by J.J. Abrams, this explosive chapter delivers spectacular action and breathtaking scale, raising the stakes higher than ever before in a thrilling mission where no one is safe.</span></p><div class=\"embedded-entity\"><div>\n                  <div class=\"video-embed-field-provider-youtube video-embed-field-responsive-video\"><iframe width=\"854\" height=\"480\" frameborder=\"0\" src=\"https://www.youtube.com/embed/sJNyGFqgyag?autoplay=0&amp;start=0&amp;rel=0\"></iframe>\n</div>\n\n      \n  </div>\n</div><ul><li><em><span>Star Trek Into Darkness</span></em><span> (12A), 2013, UK/USA, dir. J. J. Abrams, 133 mins.</span></li><li><em>TM CBS Studios Inc. © 2026</em>&nbsp;Par. Pics.</li></ul>\n      \n          </div>\n        </div>\n        <div class=\"o-sidebar-wrapper-fixed  u-order-sidebar | js-sticky-sidebar\" data-sidebar-spacer=\"false\">\n          <div class=\"o-container\">\n            <div class=\"o-sidebar\">\n              <div>\n                <h2 class=\"visually-hidden\">Information</h2>\n                \n\n\n<div class=\"c-info-block c-info-block--primary\">\n  <ul class=\"c-info-block__list o-list\">\n        <li class=\"o-title o-title--tertiary c-info-block__title -first\">\n                  Film\n      \n    </li>\n        <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                  <li><span class=\"o-label\">Date:</span>             Thursday 11 June 2026\n      </li>\n                          <li><span class=\"o-label\">Time:</span>             19.15  \n      </li>\n                          <li><span class=\"o-label\">Duration:</span>             133 minutes\n      </li>\n                          <li><span class=\"o-label\">Price:</span>             From £14 \n      </li>\n                          <li><span class=\"o-label\">Location:</span> IMAX: The Ronson Theatre\n      <span class=\"separator\">, </span>\n  Level 0</li>\n                <!-- Age and Height Restrictions -->\n                          <li><span class=\"o-label\">Age:</span>             12A\n      </li>\n                <!-- Festival \"parents\" -->\n              </ul>\n    </li>\n            <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                <li>\n          <a href=\"https://my.sciencemuseum.org.uk/0/447021\" class=\"btn btn--primary -on-black\">\n            Book now\n            <svg class=\"o-icon btn__icon\" role=\"presentation\">\n              <use xlink:href=\"#arrow-bold-right\"></use>\n            </svg>\n          </a>\n        </li>\n                      </ul>\n    </li>\n                \n    \n  </ul>\n</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n                    \n<div class=\"o-body\">\n  <div class=\"o-container\">\n    <div class=\"o-content\">\n      <section class=\"slice view-mode-default c-accordion clearfix | js-accordion\" >\n              \n        <h2  class=\"c-accordion__section-title\">            Visit Information\n      </h2>\n                                  <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-1\" aria-expanded=\"false\" aria-controls=\"tab-content-1\">\n\t  <span>            About your visit\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-1\" aria-hidden=\"true\" aria-labelledby=\"tab-1\">\n              <h4>Are you serving food/drinks? Can I bring my own food/drink?&nbsp;</h4><p>We sell drinks and snacks in our concessions area. You can bring your own bottle of water, however food from outside the IMAX cinema is not permitted.&nbsp;</p><h4>How long before showing do I need to arrive?&nbsp;&nbsp;</h4><p>Our concessions area will be open from 18.15. We recommend arriving at the cinema at least 15 minutes before the time printed on your tickets.</p><h4>Will toilets be available?&nbsp;</h4><p>There are toilet facilities available near the concessions area and towards the back of the IMAX cinema on level 3.&nbsp;</p>\n      \n  \n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-2\" aria-expanded=\"false\" aria-controls=\"tab-content-2\">\n\t  <span>            Accessibility\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-2\" aria-hidden=\"true\" aria-labelledby=\"tab-2\">\n              <h4>Is there step-free access to the auditorium and concession area?&nbsp;</h4><p>Yes, there is step free access to the auditorium. Please ask at our IMAX ticket desk and a staff member will escort you to your seats.&nbsp;</p><h4>Are there spaces reserved for wheelchair users in the auditorium?&nbsp;</h4><p>Yes, there are four&nbsp;spaces available for wheelchair users. Please call our call centre on 033 0058 0058 to book.&nbsp;</p><h4>Do you provide hearing loops?&nbsp;</h4><p>Yes, we do have hearing loops available. Just speak to a member of staff upon arrival. &nbsp;</p><h4>Are there accessible toilet facilities?&nbsp;</h4><p>Yes, accessible toilets are located near the IMAX concessions area and outside the main auditorium&nbsp;</p>\n      \n  \n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-3\" aria-expanded=\"false\" aria-controls=\"tab-content-3\">\n\t  <span>            Tickets\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-3\" aria-hidden=\"true\" aria-labelledby=\"tab-3\">\n              <p><span>Should you wish to amend your order, tickets can be refunded up until 12.00 the day before the screening or moved to a different date up until two hours before. Amendments must be made over the phone via our contact centre. Lines are open each day between 9.00–17.00. Beyond this point tickets cannot be amended or refunded.</span></p>\n      \n  \n</div>\n\n      \n                </section>\n    </div>\n  </div>\n</div>\n          <section class=\"o-section -primary\">\n  <div class=\"o-section__padding\">\n              <div class=\"o-container\">\n                  <h2 class=\"visually-hidden\">            Gallery\n      </h2>\n                      </div>\n              <div class=\"c-carousel c-carousel--gallery -offset | js-carousel\" data-carousel-style=\"offset\">\n        <div class=\"c-swiper-btn-pos\">\n          <button class=\"c-swiper-btn -back | swiper-button-back\">\n            <span class=\"visually-hidden\">Previous slide</span>\n            <svg><use xlink:href=\"#arrow-thin-right\"></use></svg>\n          </button>\n        </div>\n        <div class=\"c-swiper-btn-pos\">\n          <button class=\"c-swiper-btn | swiper-button-next\">\n            <span class=\"visually-hidden\">Next slide</span>\n            <svg><use xlink:href=\"#arrow-thin-right\"></use></svg>\n          </button>\n        </div>\n        <div class=\"swiper-container\">\n            <div class=\"swiper-wrapper\">\n                \n                            \n  \n  \n<div class=\"swiper-slide\">\n  <div class=\"c-media\">\n    <figure class=\"c-media__figure\"\n            data-large-image-width=\"1600\"\n            data-large-image-height=\"1200\"\n            data-large-image-url=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/smg_carousel_zoom/public/2026-02/Into%20Darkness_Carousel_1.jpeg\"\n            data-title='The original 2013 movie poster for Star Trek Into Darkness. '\n            data-credit=\"TM CBS Studios Inc. © 2026 Par. Pics.\"\n            data-link=\"\"\n            data-link-text=\"\">\n                                  <img loading=\"lazy\" class=\"image-carousel\" srcset=\"/sites/default/files/styles/carousel/public/2026-02/Into%20Darkness_Carousel_1.jpeg?itok=3tDXTyyq 1x\" width=\"933\" height=\"700\" src=\"/sites/default/files/styles/carousel/public/2026-02/Into%20Darkness_Carousel_1.jpeg?itok=3tDXTyyq\" alt=\"\" />\n\n\n\n      \n\n      \n      <figcaption class=\"c-media__caption\">\n        <p>The original 2013 movie poster for Star Trek Into Darkness. </p>\n        <cite>TM CBS Studios Inc. © 2026 Par. Pics.</cite>\n      </figcaption>\n    </figure>\n  </div>\n</div>\n\n          \n  \n  \n<div class=\"swiper-slide\">\n  <div class=\"c-media\">\n    <figure class=\"c-media__figure\"\n            data-large-image-width=\"1600\"\n            data-large-image-height=\"919\"\n            data-large-image-url=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/smg_carousel_zoom/public/2026-02/Into%20Darkness_Carousel_2.jpg\"\n            data-title='The cast on set for Star Trek Into Darkness. '\n            data-credit=\"TM CBS Studios Inc. © 2026 Par. Pics.\"\n            data-link=\"\"\n            data-link-text=\"\">\n                                  <img loading=\"lazy\" class=\"image-carousel\" srcset=\"/sites/default/files/styles/carousel/public/2026-02/Into%20Darkness_Carousel_2.jpg?itok=8CpUn9aO 1x\" width=\"1218\" height=\"700\" src=\"/sites/default/files/styles/carousel/public/2026-02/Into%20Darkness_Carousel_2.jpg?itok=8CpUn9aO\" alt=\"\" />\n\n\n\n      \n\n      \n      <figcaption class=\"c-media__caption\">\n        <p>The cast on set for Star Trek Into Darkness. </p>\n        <cite>TM CBS Studios Inc. © 2026 Par. Pics.</cite>\n      </figcaption>\n    </figure>\n  </div>\n</div>\n\n          \n  \n  \n<div class=\"swiper-slide\">\n  <div class=\"c-media\">\n    <figure class=\"c-media__figure\"\n            data-large-image-width=\"1494\"\n            data-large-image-height=\"2040\"\n            data-large-image-url=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/smg_carousel_zoom/public/2026-02/Into%20Darkness_Carousel_3.jpg\"\n            data-title='Benedict Cumberbatch as Khan Noonien Singh in Star Trek Into Darkness. '\n            data-credit=\"TM CBS Studios Inc. © 2026 Par. Pics\"\n            data-link=\"\"\n            data-link-text=\"\">\n                                  <img loading=\"lazy\" class=\"image-carousel\" srcset=\"/sites/default/files/styles/carousel/public/2026-02/Into%20Darkness_Carousel_3.jpg?itok=73PvrQ17 1x\" width=\"513\" height=\"700\" src=\"/sites/default/files/styles/carousel/public/2026-02/Into%20Darkness_Carousel_3.jpg?itok=73PvrQ17\" alt=\"\" />\n\n\n\n      \n\n      \n      <figcaption class=\"c-media__caption\">\n        <p>Benedict Cumberbatch as Khan Noonien Singh in Star Trek Into Darkness. </p>\n        <cite>TM CBS Studios Inc. © 2026 Par. Pics</cite>\n      </figcaption>\n    </figure>\n  </div>\n</div>\n\n      \n            </div>\n        </div>\n      </div>\n      </div>\n</section>\n\n      \n    \n  </div>\n</article>\n              \n\n<section class=\"o-section -secondary\" aria-labelledby=\"a-see-more-films\">\n    <div  class=\"slice view-mode-default o-container clearfix\">\n      <div class=\"o-container__padding\">\n                  <h2 id=\"a-see-more-films\" class=\"o-title o-title--section\">            See more films\n      </h2>\n                                      <div class=\"slice view-mode-grid-4-column\">\n      <div class=\"js-carousel-teaser\" data-carousel-slidesPerView=\"1\"> \n  <div class=\"o-grid o-grid--4-col\">\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/star-trek-60-film-season\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2026-02/ST_Nemesis_Still_KS_0005_186d1a470cf2b545ef0caa46626acbbbfe4d950b_0.jpg?h=4e0c70af&amp;itok=q972f3hV 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2026-02/ST_Nemesis_Still_KS_0005_186d1a470cf2b545ef0caa46626acbbbfe4d950b_0.jpg?h=4e0c70af&amp;itok=q972f3hV\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Star Trek at 60 Film season</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Festival\n      \n      </div>\n            <div class=\"c-card__desc\">\n                          <p>            Celebrate the 60th anniversary of Star Trek and experience the entire cinematic legacy, from the original voyages of Captain Kirk to the modern reboot trilogy, <br />\r\n\n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/star-trek-the-motion-picture\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2026-02/ST_THE_MOTION_PICTUREpromo.png?h=87c939dd&amp;itok=i6p8uijz 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2026-02/ST_THE_MOTION_PICTUREpromo.png?h=87c939dd&amp;itok=i6p8uijz\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Star Trek: The Motion Picture (PG)—Director’s Edition</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Film\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Thursday 26 March 2026\n      </span>\n                          <p>            The original Star Trek adventure, Star Trek: The Motion Picture (1979), returns, fully restored, for the ultimate big-screen experience. \n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/star-trek-ii-the-wrath-of-khan\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2026-02/ST2_Wrath_Still_0.jpg?h=3a7c63f8&amp;itok=DPFVmcoi 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2026-02/ST2_Wrath_Still_0.jpg?h=3a7c63f8&amp;itok=DPFVmcoi\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Star Trek II: The Wrath of Khan (12A)—Director&#039;s Cut</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Film\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Thursday 2 April 2026\n      </span>\n                          <p>            A thrilling second installment in the Star Trek film franchise, Star Trek II: The Wrath of Khan (1982), delivers unforgettable action and emotional depth on one of the biggest screens in the UK. \n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/star-trek-2009\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2026-02/ST11_2009_STILL.jpg?h=44e38f42&amp;itok=T6XJTqCH 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2026-02/ST11_2009_STILL.jpg?h=44e38f42&amp;itok=T6XJTqCH\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Star Trek (2009) (12A) </span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Film\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Friday 9 June 2026\n      </span>\n                          <p>            A dark, intense and emotionally charged finale for the Next Generation crew. Experience this powerful cinematic conclusion on one of the biggest screens in the UK. \n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n      </div>\n</div>\n\n  </div>\n\n      \n              </div>\n  </div>\n</section>\n      \n\n\n        </main>\n              </div>\n    </div>\n    \n    <footer>\n      <div class=\"c-social-panel | js-sticky-footer\">\n  <div class=\"o-container\">\n    <div class=\"c-social-panel__wrapper\">\n      <div class=\"js-social-shares | c-social-panel__icons\">\n      </div>\n      <a href=\"#main-wrapper\" class=\"c-social-panel__link | js-back-top\">\n        <span>Back to Top</span>\n\n        <svg class=\"o-icon\" role=\"presentation\">\n          <use xlink:href=\"#arrow-bold-right\"></use>\n        </svg>\n      </a>\n    </div>\n  </div>\n</div>\n      <div class=\"c-footer\">\n                  <div class=\"o-container\">\n            <div class=\"c-footer__padding\">\n              <div class=\"c-footer__section c-footer__section--second clearfix\">\n                      <div class=\"c-footer__block -column\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Location</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <span>Exhibition Road, South Kensington, London, SW7 2DD</span>\n                  </li>\n              <li>\n          <a href=\"http://www.discoversouthken.com/\" rel=\"noopener noreferrer\">Discover South Kensington</a>\n                  </li>\n            </ul>\n  \n                  </li>\n            </ul>\n  \n\n  </div><div class=\"c-footer__block -column\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Opening times</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <a href=\"/visit\" data-drupal-link-system-path=\"node/2746\">Open daily 10.00–18.00 (except for 24-26 December)</a>\n                  </li>\n            </ul>\n  \n                  </li>\n            </ul>\n  \n\n  </div><div class=\"c-footer__block -column -social\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Newsletter</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <a href=\"https://my.sciencemuseum.org.uk/account/create/brief\" rel=\"noopener noreferrer\">Sign up</a>\n                  </li>\n            </ul>\n  \n                  </li>\n              <li>\n          <span>My Account</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <a href=\"https://my.sciencemuseum.org.uk/account/login\" rel=\"noopener noreferrer\">My bookings</a>\n                  </li>\n              <li>\n          <a href=\"https://groups.sciencemuseum.org.uk/login\" rel=\"noopener noreferrer\">My school or group bookings</a>\n                  </li>\n            </ul>\n  \n                  </li>\n              <li>\n          <span>Keep in touch</span>\n                                    <ul class=\"o-list\">\n     