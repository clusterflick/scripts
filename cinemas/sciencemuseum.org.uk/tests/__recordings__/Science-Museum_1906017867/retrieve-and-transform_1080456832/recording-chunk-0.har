            "text": "<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\" prefix=\"og: https://ogp.me/ns#\" class=\"t-default\">\n  <head>\n    <!-- Google Tag Manager -->\n    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\n        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\n        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n      })(window,document,'script','dataLayer','GTM-MBLN5VC2');</script>\n    <!-- End Google Tag Manager -->\n    <meta charset=\"utf-8\" />\n<meta name=\"description\" content=\"Antarctica is a land of mystery and yet what happens there affects every single one of us. Find out more in this exclusive IMAX screening.\" />\n<meta name=\"referrer\" content=\"origin-when-cross-origin\" />\n<meta property=\"og:site_name\" content=\"Science Museum\" />\n<meta property=\"og:url\" content=\"https://www.sciencemuseum.org.uk/see-and-do/antarctica-3d\" />\n<meta property=\"og:title\" content=\"Antarctica 3D (U) | Science Museum\" />\n<meta property=\"og:description\" content=\"Explore the mysterious and wild plains of Antarctica and meet the creatures that thrive in the coldest and windiest place on the planet. Book early for cheaper prices.\" />\n<meta property=\"og:image\" content=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/social_facebook/public/2020-11/antartica-imax.jpg?h=47f41414&amp;itok=CSkuYSKG\" />\n<meta property=\"og:image\" content=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/social_facebook/public/2020-11/antartica-imax.jpg?h=47f41414&amp;itok=CSkuYSKG\" />\n<meta property=\"og:image:url\" content=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/social_facebook/public/2020-11/antartica-imax.jpg?h=47f41414&amp;itok=CSkuYSKG\" />\n<meta property=\"og:image:url\" content=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/social_facebook/public/2020-11/antartica-imax.jpg?h=47f41414&amp;itok=CSkuYSKG\" />\n<meta property=\"og:image:secure_url\" content=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/social_facebook/public/2020-11/antartica-imax.jpg?h=47f41414&amp;itok=CSkuYSKG\" />\n<meta property=\"og:image:secure_url\" content=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/social_facebook/public/2020-11/antartica-imax.jpg?h=47f41414&amp;itok=CSkuYSKG\" />\n<meta property=\"og:image:width\" content=\"1200, 1200\" />\n<meta property=\"og:image:height\" content=\"630, 630\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:description\" content=\"Antarctica is a land of mystery and yet what happens there affects every single one of us. Find out more in this exclusive IMAX screening.\" />\n<meta name=\"twitter:site\" content=\"@sciencemuseum\" />\n<meta name=\"twitter:title\" content=\"Antarctica 3D (U) | Science Museum\" />\n<meta name=\"twitter:site:id\" content=\"15994087\" />\n<meta name=\"twitter:creator\" content=\"@sciencemuseum\" />\n<meta name=\"twitter:creator:id\" content=\"15994087\" />\n<meta name=\"twitter:image\" content=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/social_twitter/public/2020-11/antartica-imax.jpg?h=47f41414&amp;itok=nGs8Xuke, https://www.sciencemuseum.org.uk/sites/default/files/styles/social_twitter/public/2020-11/antartica-imax.jpg?h=47f41414&amp;itok=nGs8Xuke\" />\n<meta name=\"Generator\" content=\"Drupal 10 (https://www.drupal.org)\" />\n<meta name=\"MobileOptimized\" content=\"width\" />\n<meta name=\"HandheldFriendly\" content=\"true\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<link rel=\"icon\" href=\"/themes/smg_sci/favicon.ico\" type=\"image/vnd.microsoft.icon\" />\n<link rel=\"canonical\" href=\"https://www.sciencemuseum.org.uk/see-and-do/antarctica-3d\" />\n<link rel=\"shortlink\" href=\"https://www.sciencemuseum.org.uk/node/11341\" />\n<script type=\"application/ld+json\">[{\"@context\":\"http:\\/\\/schema.org\",\"@graph\":[[{\"@type\":\"Event\",\"name\":\"Antarctica 3D (U)\",\"url\":\"https:\\/\\/www.sciencemuseum.org.uk\\/see-and-do\\/antarctica-3d\",\"startdate\":\"2026-03-29T17:00:00\",\"enddate\":\"2026-03-29T17:01:00\",\"description\":\"&lt;p&gt;Join Benedict Cumberbatch as he explores the mysterious and wild continent of Antarctica.&lt;\\/p&gt;\",\"image\":\"https:\\/\\/www.sciencemuseum.org.uk\\/sites\\/default\\/files\\/styles\\/thumbnail\\/public\\/2020-11\\/antartica-imax.jpg?itok=EmT0pC0-\",\"offers\":{\"@type\":\"Offer\",\"name\":\"Antarctica 3D (U)\",\"url\":\"https:\\/\\/my.sciencemuseum.org.uk\\/events?view=calendar&amp;&amp;kid=528\"},\"location\":{\"@type\":\"EventVenue\",\"name\":\"Science Museum\",\"address\":\"Science Museum, Exhibition Road, London, SW7 2DD\"}}]]},{\"@context\":\"http:\\/\\/schema.org\",\"@type\":\"Organization\",\"openingHours\":\"Open daily, 10.00\\u201318.00 \",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Exhibition Road\",\"addressLocality\":\"London\",\"addressCountry\":\"UK\",\"postalCode\":\"SW7 2DD\"},\"telephone\":\"\"}]</script>\n\n    <title>Antarctica 3D (U) | Science Museum</title>\n    <link rel=\"stylesheet\" media=\"all\" href=\"/sites/default/files/css/css_cp5gOnUHwWdSbptlef7MazYIOfHRVHM5F_6qh8YHE0c.css?delta=0&amp;language=en&amp;theme=smg_sci&amp;include=eJxFjFEKxCAMBS9k9Ugl6msNaAxGC719yy7s_g0zMIlSwVGXlZB-6BtkOcjkee9oEfmNOrmLUxp0DtJiIY-lVP3f-CW6YmUryM7aGSyxs9smWohkcBdn9O9wPxg1hwHTLsYXtk98ALv_N_Q\" />\n<link rel=\"stylesheet\" media=\"all\" href=\"/sites/default/files/css/css_6LJzb3b8Aw6mAs5psVzvJW1YU8X4o41p8bUqrPIWN6w.css?delta=1&amp;language=en&amp;theme=smg_sci&amp;include=eJxFjFEKxCAMBS9k9Ugl6msNaAxGC719yy7s_g0zMIlSwVGXlZB-6BtkOcjkee9oEfmNOrmLUxp0DtJiIY-lVP3f-CW6YmUryM7aGSyxs9smWohkcBdn9O9wPxg1hwHTLsYXtk98ALv_N_Q\" />\n<link rel=\"stylesheet\" media=\"print\" href=\"/sites/default/files/css/css_4YUXVCgUlZ_wSi