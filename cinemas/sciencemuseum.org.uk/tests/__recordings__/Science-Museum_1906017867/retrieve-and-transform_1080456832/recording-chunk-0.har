maxlength=\"128\" class=\"form-search\" />\n\n        </div>\n<input data-drupal-selector=\"form-rmpnjrtqy9xkvhtbyg8ggw0dlaspuip-7utyz61mbga\" type=\"hidden\" name=\"form_build_id\" value=\"form-rMPNJRtQy9XKVhTbYg8Ggw0dlASPuIP_7UTyz61MBgA\" />\n<input data-drupal-selector=\"edit-site-search-form-2\" type=\"hidden\" name=\"form_id\" value=\"site_search_form\" />\n<div data-drupal-selector=\"edit-actions\" class=\"form-actions js-form-wrapper form-wrapper\" id=\"edit-actions-mobile\">\n\n<button  data-drupal-selector=\"site-search-form-button\" type=\"submit\" id=\"site-search-form-button-mobile\" name=\"op\" value=\"Submit\" class=\"button js-form-submit form-submit btn btn--primary\">\n  Submit\n  <svg class=\"o-icon btn__icon\" role=\"presentation\">\n    <use xlink:href=\"#arrow-bold-right\"></use>\n  </svg>\n</button></div>\n\n</form>\n\n      </div>\n\n</div>\n\n      </li>\n        </ul>\n          </div>\n    </div>\n      \n\n  </nav>\n  </div>\n    </header>\n        <div id=\"main-wrapper\" class=\"o-main-wrapper clearfix\">\n      <div id=\"main\" class=\"clearfix\">\n        \n        <main id=\"main-content\" tabindex=\"-1\">\n                            \n\n<div data-drupal-messages-fallback class=\"hidden\"></div>\n\n\n                              \n                      <article class=\"h-relative\">\n  \n      \n<div class=\"h-relative\">\n  <header class=\"c-banner-deep c-banner-deep--event | js-banner\">\n    \n    <div class=\"c-banner-deep__bg -has-overlay\">\n            <div class=\"c-banner-deep__img-wrapper\">\n        <div class=\"c-banner-deep__img\" style=\"background-image: url('https://www.sciencemuseum.org.uk/sites/default/files/styles/her/public/2019-05/apollo-11-first-steps.jpg?h=dc8d4ed4&amp;itok=rFsfNuvD')\"></div>\n      </div>\n                  <div class=\"c-banner-deep__content | o-container\">\n        <div class=\"c-banner-deep__content__wrapper\">\n          <div class=\"c-breadcrumb  | js-breadcrumb\">\n                <span class=\"visually-hidden\">You are here:</span>\n    <ol class=\"o-list c-breadcrumb__links\">\n    \n          <li>\n                  <a href=\"/\">\n                          <svg class=\"o-icon c-breadcrumb__divider-icon\" role=\"presentation\">\n                <use xlink:href=\"#arrow-bold-right\"></use>\n              </svg>\n                        Home\n          </a>\n              </li>\n          <li>\n                  <a href=\"/groups\">\n                        Group visits\n          </a>\n              </li>\n        </ol>\n\n          </div>\n          <div class=\"c-banner-deep__title__wrapper\">\n\n                        <h1 class=\"visually-hidden\" ><span class=\"h-relative\">Apollo 11: First Steps Edition 2D (U) – groups</span>\n</h1>\n\n            <div aria-hidden=\"true\" class=\"c-banner-deep__title | o-title o-title--primary\">\n              <span  class=\"js-cascade\"><span class=\"h-relative\">Apollo 11: First Steps Edition 2D (U) – groups</span>\n</span>\n            </div>\n          </div>\n                  </div>\n      </div>\n    </div>\n      </header>\n</div>\n      <div class=\"o-main-content | js-sticky-container\">\n    <!-- Body content -->\n    <div class=\"o-body -first\">\n      <div class=\"o-container u-order\">\n        <div class=\"o-content u-order-body\">\n          <div class=\"c-wysiwyg\">\n              <div class=\"o-text-introduction\">\n                            <p>Follow the exhilarating lift off, landing and return of the historic Apollo 11 mission that put the first humans on the Moon. Recommended for Year 6 upwards.</p>\n\n      \n              </div>\n                          <p><span>Combining never-before-seen footage and newly discovered audio recordings, this film will transport you to some of the most incredible real-life moments from the first Moon landing.</span></p><p><span>See the Apollo 10 command module, used in the dress rehearsal for the Apollo 11 mission, in our </span><a href=\"/see-and-do/space\" data-entity-type=\"node\" data-entity-uuid=\"5d55fe07-c43a-43cd-bd85-f2eb1be7c51d\" data-entity-substitution=\"canonical\"><em><span>Space</span></em></a><span> gallery.</span></p>\n      \n          </div>\n        </div>\n        <div class=\"o-sidebar-wrapper-fixed  u-order-sidebar | js-sticky-sidebar\" data-sidebar-spacer=\"false\">\n          <div class=\"o-container\">\n            <div class=\"o-sidebar\">\n              <div>\n                <h2 class=\"visually-hidden\">Information</h2>\n                \n\n\n<div class=\"c-info-block c-info-block--primary\">\n  <ul class=\"c-info-block__list o-list\">\n        <li class=\"o-title o-title--tertiary c-info-block__title -first\">\n                  Educational IMAX film\n      \n    </li>\n        <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                  <li><span class=\"o-label\">Date:</span>             Available on selected dates\n      </li>\n                                  <li><span class=\"o-label\">Duration:</span>             60 minutes\n      </li>\n                                  <li><span class=\"o-label\">Location:</span> IMAX: The Ronson Theatre\n      <span class=\"separator\">, </span>\n  Level 0</li>\n                <!-- Age and Height Restrictions -->\n                        <!-- Festival \"parents\" -->\n              </ul>\n    </li>\n            <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                <li>\n          <a href=\"https://www.sciencemuseum.org.uk/groups/booking-online\" class=\"btn btn--primary -on-black\">\n            Book now\n            <svg class=\"o-icon btn__icon\" role=\"presentation\">\n              <use xlink:href=\"#arrow-bold-right\"></use>\n            </svg>\n          </a>\n        </li>\n                      </ul>\n    </li>\n                        <li class=\"c-info-block__section\">\n        <ul class=\"o-list\">\n                      <li><span class=\"o-label\">Curriculum links:</span> <span>Science, </span><span>Forces and motion, </span><span>Space, </span><span>Engineering, </span><span>History</span></li>\n                                <li><span class=\"o-label\">Key stage suitability:</span> <span>KS2, </span><span>KS3, </span><span>KS4</span></li>\n                                <li><span class=\"o-label\">Maximum group size:</span>             300\n       </li>\n                                <li><span class=\"o-label\">Adult to student ratio:</span>              Ages 5 to 11 – 1:8; Ages 11 to 16 – 1:10; Ages 16 to 18 – 1:30\n      </li>\n                            </ul>\n      </li>\n              \n      <li class=\"o-title o-title--tertiary c-info-block__title -margin-top\">In this page</li>\n      <li class=\"c-info-block__section\">\n  <ul class=\"o-list c-info-block__links\">\n      <li><a href=\"#ticket-prices\">Ticket prices</a></li>\n      <li><a href=\"#booking-terms\">Booking terms</a></li>\n    </ul>\n  </li>\n  \n  </ul>\n</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n                    \n<div class=\"o-body\">\n  <div class=\"o-container\">\n    <div class=\"o-content\">\n      <section class=\"slice view-mode-default c-accordion clearfix | js-accordion\" >\n        <span class=\"js-jump-link-anchor\" id=\"ticket-prices\"></span>      \n        <h2  class=\"c-accordion__section-title\">            Ticket prices\n      </h2>\n                                  <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-1\" aria-expanded=\"false\" aria-controls=\"tab-content-1\">\n\t  <span>            Formal education groups e.g. schools\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-1\" aria-hidden=\"true\" aria-labelledby=\"tab-1\">\n              <p><span>We offer formal education groups, such as schools, colleges and universities, up to 50% off tickets during term times and 25% off all other times. </span><span class=\"TextRun SCXW247805585 BCX0 NormalTextRun\" lang=\"EN-US\">This offer can’t be combined with other discounts. </span><span>The discounted prices are:</span></p>\n      \n  \n    <div class=\"c-info-table\">\n    <ul class=\"o-list\">\n\n                <li>\n    <ul class=\"o-list c-info-table__content\">\n      <li>\n                  Child\n                          <span>Term time week days</span>\n              </li>\n      <li>\n                  <span class=\"visually-hidden\">Price:</span>£5.50\n              </li>\n    </ul>\n  </li>\n\n                <li>\n    <ul class=\"o-list c-info-table__content\">\n      <li>\n                  Adult\n                          <span>Term time week days\r\n</span>\n              </li>\n      <li>\n                  <span class=\"visually-hidden\">Price:</span>£5.50\n              </li>\n    </ul>\n  </li>\n\n                <li>\n    <ul class=\"o-list c-info-table__content\">\n      <li>\n                  Child\n                          <span>All other times</span>\n              </li>\n      <li>\n                  <span class=\"visually-hidden\">Price:</span>£7.50\n              </li>\n    </ul>\n  </li>\n\n                <li>\n    <ul class=\"o-list c-info-table__content\">\n      <li>\n                  Adult\n                          <span>All other times</span>\n              </li>\n      <li>\n                  <span class=\"visually-hidden\">Price:</span>£9.00\n              </li>\n    </ul>\n  </li>\n\n      \n    </ul>\n  </div>\n  \n\n\n\n\n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-2\" aria-expanded=\"false\" aria-controls=\"tab-content-2\">\n\t  <span>            Informal education groups e.g. Brownies\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-2\" aria-hidden=\"true\" aria-labelledby=\"tab-2\">\n              <p><span>For informal education groups, including Girlguiding, Scouts, youth groups and summer schools, we offer up to 25% off full price tickets. </span><span class=\"TextRun SCXW247805585 BCX0 NormalTextRun\" lang=\"EN-US\">This offer can’t be combined with other discounts. </span><span>The discounted prices are:</span></p>\n      \n  \n    <div class=\"c-info-table\">\n    <ul class=\"o-list\">\n\n                <li>\n    <ul class=\"o-list c-info-table__content\">\n      <li>\n                  Child\n                          <span></span>\n              </li>\n      <li>\n                  <span class=\"visually-hidden\">Price:</span>£7.50\n              </li>\n    </ul>\n  </li>\n\n                <li>\n    <ul class=\"o-list c-info-table__content\">\n      <li>\n                  Adult\n                          <span></span>\n              </li>\n      <li>\n                  <span class=\"visually-hidden\">Price:</span>£9.00\n              </li>\n    </ul>\n  </li>\n\n      \n    </ul>\n  </div>\n  \n\n\n\n\n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-3\" aria-expanded=\"false\" aria-controls=\"tab-content-3\">\n\t  <span>            Other groups e.g. coach tours\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-3\" aria-hidden=\"true\" aria-labelledby=\"tab-3\">\n              <p><span>For other groups, including adult interest groups, coach groups, we can offer up to 15% off full price tickets at any time. </span><span class=\"TextRun SCXW247805585 BCX0 NormalTextRun\" lang=\"EN-US\">This offer can’t be combined with other discounts. </span><span>The discounted prices are:</span></p>\n      \n  \n    <div class=\"c-info-table\">\n    <ul class=\"o-list\">\n\n                <li>\n    <ul class=\"o-list c-info-table__content\">\n      <li>\n                  Child\n                          <span></span>\n              </li>\n      <li>\n                  <span class=\"visually-hidden\">Price:</span>£8.50\n              </li>\n    </ul>\n  </li>\n\n                <li>\n    <ul class=\"o-list c-info-table__content\">\n      <li>\n                  Adult\n                          <span>£10.00</span>\n              </li>\n      <li>\n                  <span class=\"visually-hidden\">Price:</span>\n              </li>\n    </ul>\n  </li>\n\n      \n    </ul>\n  </div>\n  \n\n\n\n\n</div>\n\n      \n                </section>\n    </div>\n  </div>\n</div>\n          \n<div class=\"o-body \">\n  <div class=\"o-container\">\n    <div class=\"o-content\">\n      <section class=\"c-wysiwyg  \">\n        <span class=\"js-jump-link-anchor\" id=\"booking-terms\"></span>                  <h2>            Booking terms\n      </h2>\n        \n                              <p><span>Our </span><a href=\"/group-bookings-terms-and-conditions\" data-entity-type=\"node\" data-entity-uuid=\"d4fa3a5d-697b-463e-a953-97924a3638e8\" data-entity-substitution=\"canonical\">booking terms</a><span> apply for this event.</span></p><hr><p><span>Header image: The Saturn V liftoff, courtesy of Statement Pictures for CNN Films/ MacGillivray Freeman Films</span></p>\n      \n              </section>\n    </div>\n  </div>\n</div>\n\n      \n    \n  </div>\n</article>\n            \n\n<section class=\"o-section \" aria-labelledby=\"a-other-things-to-see-and-do\">\n    <div  class=\"slice view-mode-default o-container clearfix\">\n      <div class=\"o-container__wrapper\">\n                  <h2 id=\"a-other-things-to-see-and-do\" class=\"o-title o-title--section\">            Other things to see and do\n      </h2>\n                                      <div class=\"slice view-mode-thirds-3-column\">\n      <div class=\"js-carousel-teaser\" data-carousel-slidesPerView=\"1\"> \n  <div class=\"o-grid o-grid--3-col\">\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/groups/wonderlab-school-info\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2017-09/MIRRORBOX-CMYK.jpg?h=93e53cd6&amp;itok=-NvZnGgO 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2017-09/MIRRORBOX-CMYK.jpg?h=93e53cd6&amp;itok=-NvZnGgO\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Wonderlab–Groups</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Interactive gallery\n      \n      </div>\n            <div class=\"c-card__desc\">\n                          <p>            Ignite curiosity about science and maths through hands-on exhibits and immersive experiences. <br />\r\nFor KS2 and KS3.\n      </p>\n                      </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card -external\">\n  <a href=\"https://learning.sciencemuseumgroup.org.uk/resources/chatterbox-challenge-space/\" class=\"c-card__link\">\n    <div class=\"c-card__img -default\">\n                  <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2017-09/exploring-space-hero.jpg?itok=cxPqnW-K 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2017-09/exploring-space-hero.jpg?itok=cxPqnW-K\" alt=\"\" />\n\n\n\n      \n  </div>\n\n      \n          </div>\n\n    <div class=\"c-card__content\">\n      <h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Chatterbox challenge: Space</span>\n\n      </h3>\n              <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Resources\n      \n        </div>\n            <div class=\"c-card__desc\">\n                  <p>            Explore the amazing space themed objects in the Science Museum using your observation skills and curiosity.\n      </p>\n              </div>\n    </div>\n\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/groups/space-school-info\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2025-04/sharman-sokol_0.jpg?h=65f9a063&amp;itok=ttBdjIke 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2025-04/sharman-sokol_0.jpg?h=65f9a063&amp;itok=ttBdjIke\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Space – Groups</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Object gallery\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Open daily, 10.00-18.00\n      </span>\n                          <p>            See iconic spacecraft and out-of-this-world objects in our exciting new free gallery.\n      </p>\n                      </div>\n    </div>\n  </a>\n</article>\n</div>\n      </div>\n</div>\n  </div>\n\n      \n              </div>\n  </div>\n</section>\n      \n\n\n        </main>\n              </div>\n    </div>\n    \n    <footer>\n      <div class=\"c-back-to-top-panel | js-sticky-footer\">\n  <div class=\"o-container\">\n    <div class=\"c-back-to-top-panel__wrapper\">\n      <a href=\"#main-wrapper\" class=\"c-back-to-top-panel__link | js-back-top\">\n        <span>Back to Top</span>\n\n        <svg class=\"o-icon\" role=\"presentation\">\n          <use xlink:href=\"#arrow-bold-right\"></use>\n        </svg>\n      </a>\n    </div>\n  </div>\n</div>\n      <div class=\"c-footer\">\n                  <div class=\"o-container\">\n            <div class=\"c-footer__padding\">\n              <div class=\"c-footer__section c-footer__section--second clearfix\">\n                      <div class=\"c-footer__block -column\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Location</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <span>Exhibition Road, South Kensington, London, SW7 2DD</span>\n                  </li>\n              <li>\n          <a href=\"http://www.discoversouthken.com/\" rel=\"noopener noreferrer\">Discover South Kensington</a>\n                  </li>\n            </ul>\n  \n                  </li>\n            </ul>\n  \n\n  </div><div class=\"c-footer__block -column\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Opening times</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <a href=\"/visit\" data-drupal-link-system-path=\"node/2746\">Open daily 10.00–18.00 (except for 24-26 December)</a>\n                  </li>\n            </ul>\n  \n                  </li>\n            </ul>\n  \n\n  </div><div class=\"c-footer__block -column -social\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Newsletter</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <a href=\"https://my.sciencemuseum.org.uk/account/create/brief\" rel=