 class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Dana Research Centre and Library</button>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/researchers/research-events\" data-drupal-link-system-path=\"node/6982\">Research Events</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"http://journal.sciencemuseum.ac.uk\" rel=\"noopener noreferrer\">Science Museum Group Journal</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">About us</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us\" data-drupal-link-system-path=\"node/2929\">About us</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/press-office\" data-drupal-link-system-path=\"node/2944\">Press office</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://www.hirethesciencemuseum.com/\" rel=\"noopener noreferrer\">Venue hire</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://www.sciencemuseumgroup.org.uk/work-with-us\" rel=\"noopener noreferrer\">Jobs</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/volunteering-science-museum\" data-drupal-link-system-path=\"no