 </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Support us</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us\" data-drupal-link-system-path=\"node/3790\">Support us</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/donate-today\" data-drupal-link-system-path=\"node/15373\">Donate today</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/adopt-an-object\" data-drupal-link-system-path=\"node/12757\">Adopt an object</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/become-patron\" data-drupal-link-system-path=\"node/2701\">Become a Patron</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/corporate-partnerships\" data-drupal-link-system-path=\"node/2749\">Corporate partnerships</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/giftsinwills\" data-drupal-link-system-path=\"node/2710\">Leave a gift in your will</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/support-us-major-gift\" data-drupal-link-system-path=\"node/2707\">Support us with a major gift</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://shop.sciencemuseum.org.uk/  \" rel=\"noopener noreferrer\">Shop</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://wonderlabplus.sciencemuseumgroup.org.uk/\" rel=\"noopener noreferrer\">Wonderlab+</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://blog.sciencemuseum.org.uk/\" rel=\"noopener noreferrer\">Blog</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://my.sciencemuseum.org.uk/account/create/brief\" rel=\"noopener noreferrer\">Newsletter</a>\n                      </li>\n    \n          <li>\n        <div class=\"site-search-form c-search-mob\" data-drupal-selector=\"site-search-form-2\" id=\"block-sitesearchform-mobile\">\n  \n  <div class=\"c-search-mob__form\">\n    \n        \n        <form autocomplete=\"off\" block=\"block-sitesearchform-mobile\" action=\"/see-and-do/star-trek-warp-trail\" method=\"post\" id=\"site-search-form-mobile\" accept-charset=\"UTF-8\">\n  <div class=\"js-form-item form-item form-type-search js-form-type-search form-item-term js-form-item-term\">\n      <label for=\"edit-term-mobile\">\n    Search the site\n\n      </label>\n        <input data-drupal-selector=\"edit-term\" data-msg-maxlength=\"Search the site field has a maximum length of 128.\" type=\"search\" id=\"edit-term-mobile\" name=\"term\" value=\"\" size=\"60\" maxlength=\"128\" class=\"form-search\" />\n\n        </div>\n<input data-drupal-selector=\"form-5c5-vncqbzi-orpn3lc3vf3r3-dh6cy7scrue26nwps\" type=\"hidden\" name=\"form_build_id\" value=\"form-5c5_vNCqbZi_ORpN3lc3vf3R3-DH6cY7SCRue26nWPs\" />\n<input data-drupal-selector=\"edit-site-search-form-2\" type=\"hidden\" name=\"form_id\" value=\"site_search_form\" />\n<div data-drupal-selector=\"edit-actions\" class=\"form-actions js-form-wrapper form-wrapper\" id=\"edit-actions-mobile\">\n\n<button  data-drupal-selector=\"site-search-form-button\" type=\"submit\" id=\"site-search-form-button-mobile\" name=\"op\" value=\"Submit\" class=\"button js-form-submit form-submit btn btn--primary\">\n  Submit\n  <svg class=\"o-icon btn__icon\" role=\"presentation\">\n    <use xlink:href=\"#arrow-bold-right\"></use>\n  </svg>\n</button></div>\n\n</form>\n\n      </div>\n\n</div>\n\n      </li>\n        </ul>\n          </div>\n    </div>\n      \n\n  </nav>\n  </div>\n    </header>\n        <div id=\"main-wrapper\" class=\"o-main-wrapper clearfix\">\n      <div id=\"main\" class=\"clearfix\">\n        \n        <main id=\"main-content\" tabindex=\"-1\">\n                            \n\n<div data-drupal-messages-fallback class=\"hidden\"></div>\n\n\n                              \n                      <article class=\"h-relative\">\n  \n      \n<div class=\"h-relative\">\n  <header class=\"c-banner-deep c-banner-deep--event | js-banner\">\n    \n    <div class=\"c-banner-deep__bg -has-overlay\">\n            <div class=\"c-banner-deep__img-wrapper\">\n        <div class=\"c-banner-deep__img\" style=\"background-image: url('https://www.sciencemuseum.org.uk/sites/default/files/styles/her/public/2026-03/star-trek-hero_0.png?h=0cd817c1&amp;itok=I2dsmuJB')\"></div>\n      </div>\n                  <div class=\"c-banner-deep__content | o-container\">\n        <div class=\"c-banner-deep__content__wrapper\">\n          <div class=\"c-breadcrumb  | js-breadcrumb\">\n                <span class=\"visually-hidden\">You are here:</span>\n    <ol class=\"o-list c-breadcrumb__links\">\n    \n          <li>\n                  <a href=\"/\">\n                          <svg class=\"o-icon c-breadcrumb__divider-icon\" role=\"presentation\">\n                <use xlink:href=\"#arrow-bold-right\"></use>\n              </svg>\n                        Home\n          </a>\n              </li>\n          <li>\n                  <a href=\"/see-and-do\">\n                        See and do\n          </a>\n              </li>\n        </ol>\n\n          </div>\n          <div class=\"c-banner-deep__title__wrapper\">\n\n                        <h1 class=\"visually-hidden\" ><span class=\"h-relative\">Star Trek Warp Trail</span>\n</h1>\n\n            <div aria-hidden=\"true\" class=\"c-banner-deep__title | o-title o-title--primary\">\n              <span  class=\"js-cascade\"><span class=\"h-relative\">Star Trek Warp Trail</span>\n</span>\n            </div>\n          </div>\n                  </div>\n      </div>\n    </div>\n      </header>\n</div>\n  \n    <div class=\"o-main-content | js-sticky-container\">\n    <!-- Body content -->\n    <div class=\"o-body -first\">\n      <div class=\"o-container u-order\">\n        <div class=\"o-content u-order-body\">\n          <div class=\"c-wysiwyg\">\n              <div class=\"o-text-introduction\">\n                            <p>Calling all Starfleet recruits! Discover iconic Star Trek objects and outfits across the museum in this free trail.</p>\n\n      \n              </div>\n                          <div class=\"OutlineElement Ltr SCXW202198059 BCX8\"><p><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\">Space, the final frontier...</span></p></div><div class=\"OutlineElement Ltr SCXW202198059 BCX8\"><p><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\"></span></p></div><div class=\"OutlineElement Ltr SCXW202198059 BCX8\"><p><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\">Have you ever wondered how the legendary science fiction franchise might’ve inspired the real-world science we use every day?</span></p></div><div class=\"OutlineElement Ltr SCXW202198059 BCX8\"><p><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\"></span></p></div><div class=\"OutlineElement Ltr SCXW202198059 BCX8\"><p><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\">Find out by picking up a free </span><em><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\">Star Trek Warp Trail </span></em><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\">guide when you arrive at the museum and set off on a voyage to see legendary items from the</span><em><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\"> Star Trek</span></em><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\"> archives that have been beamed across the galleries.</span></p></div><div class=\"OutlineElement Ltr SCXW202198059 BCX8\"><p><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\"></span></p></div><div class=\"OutlineElement Ltr SCXW202198059 BCX8\"><p><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\">Learn how the tools and technologies used within</span><em><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\"> Star Trek</span></em><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\"> connect to our collection—from revolutionary medicine and surviving in space, to instant communication and more—before ending the trail by getting to sit in the </span><em><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\">U.S.S. Discovery</span></em><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\"> Captain’s Chair and browse the exclusive 60</span><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun Superscript\" lang=\"EN-US\">th</span><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\"> anniversary retail range in our </span><em><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\">Star Trek</span></em><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\"> shop.</span></p><p><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\">The </span><em><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\">Star Trek Warp Trail</span></em><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\"> is free to visit we’d recommend visitors </span><a href=\"/see-and-do/welcome\" data-entity-type=\"node\" data-entity-uuid=\"b36d7402-ea3b-478e-bb42-d6dc2743b594\" data-entity-substitution=\"canonical\"><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\">book a free general admission ticket to the museum in advance</span></a><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\"> due to expected high demand. Please be aware that the </span><em><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\">Warp Trail</span></em><span class=\"TextRun SCXW202198059 BCX8 NormalTextRun\" lang=\"EN-US\"> is only available during daytime opening hours and cannot be visited in the evenings before or after the film screenings.</span></p></div>\n      \n          </div>\n        </div>\n        <div class=\"o-sidebar-wrapper-fixed  u-order-sidebar | js-sticky-sidebar\" data-sidebar-spacer=\"false\">\n          <div class=\"o-container\">\n            <div class=\"o-sidebar\">\n              <div>\n                <h2 class=\"visually-hidden\">Information</h2>\n                \n\n\n<div class=\"c-info-block c-info-block--primary\">\n  <ul class=\"c-info-block__list o-list\">\n        <li class=\"o-title o-title--tertiary c-info-block__title -first\">\n                  Free\n                   Trail\n      \n    </li>\n        <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                  <li><span class=\"o-label\">Date:</span>             Now open until 8 September 2026\n      </li>\n                                                <!-- Age and Height Restrictions -->\n                        <!-- Festival \"parents\" -->\n              </ul>\n    </li>\n                                  <li class=\"visually-hidden\">            Location\n      </li>\n  <li class=\"c-info-block__section\">            <p><span class=\"TextRun SCXW28905559 BCX0 NormalTextRun\" lang=\"EN-US\"><strong>LOCATION: </strong>Multiple galleries across 4 floors.<strong> </strong>Pick up a free trail guide on arrival. Look for the </span><em><span class=\"TextRun SCXW28905559 BCX0 NormalTextRun\" lang=\"EN-US\">Star Trek Warp Trail </span></em><span class=\"TextRun SCXW28905559 BCX0 NormalTextRun\" lang=\"EN-US\">sign in the Front Concourse. P</span><span>lease note the trail has multiple stops across free galleries around the museum.</span></p><p><span><strong>TIMES:</strong> Trail available during </span><a href=\"/visit\" data-entity-type=\"node\" data-entity-uuid=\"c719e7ce-edbb-4329-8fed-ed556a9813d9\" data-entity-substitution=\"canonical\"><span>museum daytime opening hours</span></a><span>. Evening films – no gallery access in the evenings.&nbsp;</span></p><p><span><strong>DURATION:</strong> Recommended 45 minutes</span></p><p><span class=\"TextRun SCXW28905559 BCX0 NormalTextRun\" lang=\"EN-US\"><strong>ACCESSIBILITY: </strong>There is seating in each gallery, and each floor is accessible via lift.</span><span class=\"EOP SCXW28905559 BCX0\">&nbsp;</span></p>\n      </li>\n\n            <li class=\"visually-hidden\">            Book\n      </li>\n  <li class=\"c-info-block__section\">\n    <a href=\"/see-and-do/welcome\" class=\"btn btn--primary -on-black\">\n      Book free museum general admission now\n      <svg class=\"o-icon btn__icon\" role=\"presentation\">\n        <use xlink:href=\"#arrow-bold-right\"></use>\n      </svg>\n    </a>\n  </li>\n\n      \n    \n  </ul>\n</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n                    \n<div class=\"o-body\">\n  <div class=\"o-container\">\n    <div class=\"o-content\">\n      <section class=\"slice view-mode-default c-accordion clearfix | js-accordion\" >\n              \n        <h2  class=\"c-accordion__section-title\">            Faqs\n      </h2>\n                                  <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-1\" aria-expanded=\"false\" aria-controls=\"tab-content-1\">\n\t  <span>            Is the Star Trek Warp Trail an exhibition?\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-1\" aria-hidden=\"true\" aria-labelledby=\"tab-1\">\n              <p><span>It’s not an exhibition, but it is an exciting free trail around the museum where you can see iconic objects from the </span><em><span>Star Trek </span></em><span>archive, including screen-used costumes and props as well as replicas from the franchise, and find out how they link to the real-world science in our free galleries.</span></p><p><span>&nbsp;</span></p><p>&nbsp;</p><p><span>&nbsp;</span></p><p>&nbsp;</p><p><span>&nbsp;</span></p><p>&nbsp;</p>\n      \n  \n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-2\" aria-expanded=\"false\" aria-controls=\"tab-content-2\">\n\t  <span>            How long will I need for the trail?\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-2\" aria-hidden=\"true\" aria-labelledby=\"tab-2\">\n              <p><span>As the </span><em><span>Star Trek Warp Trail</span></em><span> has multiple stops across the museum, we’d recommend allowing a minimum of 45 minutes to see all the objects on display.&nbsp;</span></p><p>&nbsp;</p>\n      \n  \n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-3\" aria-expanded=\"false\" aria-controls=\"tab-content-3\">\n\t  <span>            Is the Star Trek Warp Trail free?\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-3\" aria-hidden=\"true\" aria-labelledby=\"tab-3\">\n              <p><span>Yes, the </span><em><span>Star Trek Warp Trail</span></em><span> is a free self-guided experience available to all museum visitors until September 2026. It is perfect for families, adults, fans and newcomers to&nbsp;</span><em><span>Star Trek</span></em><span>&nbsp;alike.</span></p>\n      \n  \n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-4\" aria-expanded=\"false\" aria-controls=\"tab-content-4\">\n\t  <span>            Is the trail accessible for wheelchairs?\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-4\" aria-hidden=\"true\" aria-labelledby=\"tab-4\">\n              <p><span>Yes, the trail is accessible for wheelchairs and all the free galleries that are part of the trail are accessible via lift.&nbsp;</span></p>\n      \n  \n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-5\" aria-expanded=\"false\" aria-controls=\"tab-content-5\">\n\t  <span>            Could I get a digital copy of the trail guide?\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-5\" aria-hidden=\"true\" aria-labelledby=\"tab-5\">\n              <p><span>Unfortunately, we can’t share the trail guide digitally right now but if this changes, we will let visitors know and add this to our website as soon as possible.</span></p>\n      \n  \n</div>\n\n      \n                </section>\n    </div>\n  </div>\n</div>\n          \n<div class=\"o-body \">\n  <div class=\"o-container\">\n    <div class=\"o-content\">\n      <section class=\"c-wysiwyg  \">\n                \n                              <div class=\"embedded-entity\"><div>\n                  <div class=\"video-embed-field-provider-youtube video-embed-field-responsive-video\"><iframe width=\"854\" height=\"480\" frameborder=\"0\" src=\"https://www.youtube.com/embed/FzoQEg0vApA?autoplay=0&amp;start=0&amp;rel=0\"></iframe>\n</div>\n\n      \n  </div>\n</div>\n      \n              </section>\n    </div>\n  </div>\n</div>\n\n          <section class=\"o-section -primary\">\n  <div class=\"o-section__padding\">\n              <div class=\"o-container\">\n                  <h2 class=\"o-title o-title--carousel\n\">            Boldly go where no-one has gone before\n      </h2>\n                      </div>\n              <div class=\"c-carousel c-carousel--gallery -offset | js-carousel\" data-carousel-style=\"offset\">\n        <div class=\"c-swiper-btn-pos\">\n          <button class=\"c-swiper-btn -back | swiper-button-back\">\n            <span class=\"visually-hidden\">Previous slide</span>\n            <svg><use xlink:href=\"#arrow-thin-right\"></use></svg>\n          </button>\n        </div>\n        <div class=\"c-swiper-btn-pos\">\n          <button class=\"c-swiper-btn | swiper-button-next\">\n            <span class=\"visually-hidden\">Next slide</span>\n            <svg><use xlink:href=\"#arrow-thin-right\"></use></svg>\n          </button>\n        </div>\n        <div class=\"swiper-container\">\n            <div class=\"swiper-wrapper\">\n                \n                            \n  \n\n<div class=\"swiper-slide\">\n  <div class=\"c-media\">\n    <figure class=\"c-media__figure\"\n            data-large-image-width=\"1600\"\n            data-large-image-height=\"1143\"\n            data-large-image-url=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/smg_carousel_zoom/public/2026-03/star-trek-2_0.jpeg\"\n            data-title='Discover costumes, props and more from the TV series and films. Image credit: © Science Museum Group'\n            data-credit=\"\"\n            data-link=\"\"\n            data-link-text=\"\">\n                                  <img loading=\"lazy\" class=\"image-carousel\" srcset=\"/sites/default/files/styles/carousel/public/2026-03/star-trek-2_0.jpeg?itok=i9qZ2L2p 1x\" width=\"980\" height=\"700\" src=\"/sites/default/files/styles/carousel/public/2026-03/star-trek-2_0.jpeg?itok=i9qZ2L2p\" alt=\"\" />\n\n\n\n      \n\n      \n      <figcaption class=\"c-media__caption\">\n        <p>Discover costumes, props and more from the TV series and films. Image credit: © Science Museum Group</p>\n        <cite></cite>\n      </figcaption>\n    </figure>\n  </div>\n</div>\n\n          \n  \n\n<div class=\"swiper-slide\">\n  <div class=\"c-media\">\n    <figure class=\"c-media__figure\"\n            data-large-image-width=\"1600\"\n            data-large-image-height=\"1067\"\n            data-large-image-url=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/smg_carousel_zoom/public/2026-04/2026-04-01_Star%20Trek%20Warp%20Trail_Carousel%20Image%202.jpg\"\n            data-title='Set out on a voyage around the museum using the free trail guide © Science Museum Group'\n            data-credit=\"\"\n            data-link=\"\"\n            data-link-text=\"\">\n                                  <img loading=\"lazy\" class=\"image-carousel\" srcset=\"/sites/default/files/styles/carousel/public/2026-04/2026-04-01_Star%20Trek%20Warp%20Trail_Carousel%20Image%202.jpg?itok=QR1YoO5F 1x\" width=\"1050\" height=\"700\" src=\"/sites/default/files/styles/carousel/public/2026-04/2026-04-01_Star%20Trek%20Warp%20Trail_Carousel%20Image%202.jpg?itok=QR1YoO5F\" alt=\"\" />\n\n\n\n      \n\n      \n      <figcaption class=\"c-media__caption\">\n        <p>Set out on a voyage around the museum using the free trail guide © Science Museum Group</p>\n        <cite></cite>\n      </figcaption>\n    </figure>\n  </div>\n</div>\n\n          \n  \n\n<div class=\"swiper-slide\">\n  <div class=\"c-media\">\n    <figure class=\"c-media__figure\"\n            data-large-image-width=\"1600\"\n            data-large-image-height=\"1067\"\n            data-large-image-url=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/smg_carousel_zoom/public/2026-04/2026-04-01_Star%20Trek%20Warp%20Trail_Carousel%20Image%203.jpg\"\n            data-title='Find iconic Star Trek objects from the archives across multiple galleries © Science Museum Group'\n            data-credit=\"\"\n            data-link=\"\"\n            data-link-text=\"\">\n                                  <img loading=\"lazy\" class=\"image-carousel\" srcset=\"/sites/default/files/styles/carousel/public/2026-04/2026-04-01_Star%20Trek%20Warp%20Trail_Carousel%20Image%203.jpg?itok=8RRd4yZB 1x\" width=\"1050\" height=\"700\" src=\"/sites/default/files/styles/carousel/public/2026-04/2026-04-01_Star%20Trek%20Warp%20Trail_Carousel%20Image%203.jpg?itok=8RRd4yZB\" alt=\"\" />\n\n\n\n      \n\n      \n      <figcaption class=\"c-media__caption\">\n        <p>Find iconic Star Trek objects from the archives across multiple galleries © Science Museum Group</p>\n        <cite></cite>\n      </figcaption>\n    </figure>\n  </div>\n</div>\n\n          \n  \n\n<div class=\"swiper-slide\">\n  <div class=\"c-media\">\n    <figure class=\"c-media__figure\"\n            data-large-image-width=\"1600\"\n            data-large-image-height=\"1067\"\n            data-large-image-url=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/smg_carousel_zoom/public/2026-04/2026-04-01_Star%20Trek%20Warp%20Trail_Carousel%20Image%204.jpg\"\n            data-title='From medicine in space to AI, see how these incredible items link back to real-life science © Science Museum Group&amp;nbsp;'\n            data-credit=\"\"\n            data-link=\"\"\n            data-link-text=\"\">\n                                  <img loading=\"lazy\" class=\"image-carousel\" srcset=\"/sites/default/files/styles/carousel/public/2026-04/2026-04-01_Star%20Trek%20Warp%20Trail_Carousel%20Image%204.jpg?itok=a_f4Tzqy 1x\" width=\"1050\" height=\"700\" src=\"/sites/default/files/styles/carousel/public/2026-04/2026-04-01_Star%20Trek%20Warp%20Trail_Carousel%20Image%204.jpg?itok=a_f4Tzqy\" alt=\"\" />\n\n\n\n      \n\n      \n      <figcaption class=\"c-media__caption\">\n        <p>From medicine in space to AI, see how these incredible items link back to real-life science © Science Museum Group&nbsp;</p>\n        <cite></cite>\n      </figcaption>\n    </figure>\n  </div>\n</div>\n\n          \n  \n\n<div class=\"swiper-slide\">\n  <div class=\"c-media\">\n    <figure class=\"c-media__figure\"\n            data-large-image-width=\"1600\"\n            data-large-image-height=\"2000\"\n            data-large-image-url=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/smg_carousel_zoom/public/2026-03/JWIL2026_03_25_%280004%29.jpeg\"\n            data-title='At the end of the trail take a seat in the U.S.S. Discovery Captain’s Chair for the ultimate Star Trek-inspired selfie. Image credit: © Science Museum Group'\n            data-credit=\"\"\n            data-link=\"\"\n            data-link-text=\"\">\n                                  <img loading=\"lazy\" class=\"image-carousel\" srcset=\"/sites/default/files/styles/carousel/public/2026-03/JWIL2026_03_25_%280004%29.jpeg?itok=_QnZYemB 1x\" width=\"560\" height=\"700\" src=\"/sites/default/files/styles/carousel/public/2026-03/JWIL2026_03_25_%280004%29.jpeg?itok=_QnZYemB\" alt=\"\" />\n\n\n\n      \n\n      \n      <figcaption class=\"c-media__caption\">\n        <p>At the end of the trail take a seat in the U.S.S. Discovery Captain’s Chair for the ultimate Star Trek-inspired selfie. Image credit: © Science Museum Group</p>\n        <cite></cite>\n      </figcaption>\n    </figure>\n  </div>\n</div>\n\n      \n            </div>\n        </div>\n      </div>\n      </div>\n</section>\n\n      \n    \n  </div>\n</article>\n            \n\n<section class=\"o-section \" aria-labelledby=\"a-more-things-to-see-and-do\">\n    <div  class=\"slice view-mode-default o-container clearfix\">\n      <div class=\"o-container__wrapper\">\n                  <h2 id=\"a-more-things-to-see-and-do\" class=\"o-title o-title--section\">            More things to see and do\n      </h2>\n                                      <div class=\"slice view-mode-split-2-column-\">\n      <div class=\"o-grid o-grid--2-col\">\n      <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/star-trek-60\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2026-02/ST6_TUC_Still_KS_ILM-1.jpg?h=03f5e3be&amp;itok=pdj2X9IY 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2026-02/ST6_TUC_Still_KS_ILM-1.jpg?h=03f5e3be&amp;itok=pdj2X9IY\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Star Trek at 60 </span>\n\n      </h3>\n            <div class=\"c-card__desc\">\n                          <p>            Boldly go where no one has gone before with our special season celebrating the 60th anniversary of Star Trek.\n      </p>\n                      </div>\n    </div>\n  </a>\n</article>\n</div>\n      <div class=\"o-grid__item\"><article class=\"c-card -feature\">\n  <a href=\"/see-and-do/star-trek-60-film-season\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2026-02/ST_Nemesis_Still_KS_0005_186d1a470cf2b545ef0caa46626acbbbfe4d950b_0.jpg?h=4e0c70af&amp;itok=q972f3hV 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2026-02/ST_Nemesis_Still_KS_0005_186d1a470cf2b545ef0caa46626acbbbfe4d950b_0.jpg?h=4e0c70af&amp;itok=q972f3hV\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Star Trek at 60 Film season</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Festival\n      \n      </div>\n            <div class=\"c-card__desc\">\n                          <p>            Celebrate the 60th anniversary of Star Trek and experience the entire cinematic legacy, from the original voyages of Captain Kirk to the modern reboot trilogy, <br />\r\n\n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n  </div>\n  </div>\n\n          <div class=\"slice view-mode-thirds-3-column\">\n      <div class=\"js-carousel-teaser\" data-carousel-slidesPerView=\"1\"> \n  <div class=\"o-grid o-grid--3-col\">\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/destination-space\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2025-09/apollo-10.jpg?h=a068776e&amp;itok=4Nc_Ae9Z 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2025-09/apollo-10.jpg?h=a068776e&amp;itok=4Nc_Ae9Z\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Destination Space  </span>\n\n      </h3>\n            <div class=\"c-card__desc\">\n                          <p>            Discover all things space at the Science Museum, from our new gallery to a spectacular free family show packed with space-inspired experiments!\n      </p>\n                      </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card -feature\">\n  <a href=\"/see-and-do/space\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2025-09/Visitor%20next%20to%20the%20the%20Soyuz%20and%20Apollo%2010%20modules%20in%20the%20Space%20gallery%20at%20the%20Science%20Museum%20%C2%A9%20Science%20Museum%20Group%20%281%29.jpeg?h=06ac0d8c&amp;itok=6S7xNhFI 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2025-09/Visitor%20next%20to%20the%20the%20Soyuz%20and%20Apollo%2010%20modules%20in%20the%20Space%20gallery%20at%20the%20Science%20Museum%20%C2%A9%20Science%20Museum%20Group%20%281%29.jpeg?h=06ac0d8c&amp;itok=6S7xNhFI\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Space</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Object gallery\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Open daily 10.00-18.00\n      </span>\n                          <p>            See iconic spacecraft and out-of-this-world objects in our exciting new free gallery.\n      </p>\n                          <span class=\"c-card__tag\">            Free\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card -feature\">\n  <a href=\"/see-and-do/astronights\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2019-09/astronights-hero.jpg?h=6da36de0&amp;itok=4tX50LEK 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2019-09/astronights-hero.jpg?h=6da36de0&amp;itok=4tX50LEK\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Astronights</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Event\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Dates vary\n      </span>\n                          <p>            Have you ever wanted to have a sleepover in a museum? Then don&#039;t miss out on our exciting space-themed Astronights!\n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n      </div>\n</div>\n  </div>\n\n      \n              </div>\n  </div>\n</section>\n      \n\n\n        </main>\n              </div>\n    </div>\n    \n    <footer>\n      <div class=\"c-back-to-top-panel | js-sticky-footer\">\n  <div class=\"o-container\">\n    <div class=\"c-back-to-top-panel__wrapper\">\n      <a href=\"#main-wrapper\" class=\"c-back-to-top-panel__link | js-back-top\">\n        <span>Back to Top</span>\n\n        <svg class=\"o-icon\" role=\"presentation\">\n          <use xlink:href=\"#arrow-bold-right\"></use>\n        </svg>\n      </a>\n    </div>\n  </div>\n</div>\n      <div class=\"c-footer\">\n                  <div class=\"o-container\">\n            <div class=\"c-footer__padding\">\n              <div class=\"c-footer__sec