abel>\n        <input data-drupal-selector=\"edit-term\" data-msg-maxlength=\"Search the site field has a maximum length of 128.\" type=\"search\" id=\"edit-term-mobile\" name=\"term\" value=\"\" size=\"60\" maxlength=\"128\" class=\"form-search\" />\n\n        </div>\n<input data-drupal-selector=\"form-rmpnjrtqy9xkvhtbyg8ggw0dlaspuip-7utyz61mbga\" type=\"hidden\" name=\"form_build_id\" value=\"form-rMPNJRtQy9XKVhTbYg8Ggw0dlASPuIP_7UTyz61MBgA\" />\n<input data-drupal-selector=\"edit-site-search-form-2\" type=\"hidden\" name=\"form_id\" value=\"site_search_form\" />\n<div data-drupal-selector=\"edit-actions\" class=\"form-actions js-form-wrapper form-wrapper\" id=\"edit-actions-mobile\">\n\n<button  data-drupal-selector=\"site-search-form-button\" type=\"submit\" id=\"site-search-form-button-mobile\" name=\"op\" value=\"Submit\" class=\"button js-form-submit form-submit btn btn--primary\">\n  Submit\n  <svg class=\"o-icon btn__icon\" role=\"presentation\">\n    <use xlink:href=\"#arrow-bold-right\"></use>\n  </svg>\n</button></div>\n\n</form>\n\n      </div>\n\n</div>\n\n      </li>\n        </ul>\n          </div>\n    </div>\n      \n\n  </nav>\n  </div>\n    </header>\n        <div id=\"main-wrapper\" class=\"o-main-wrapper clearfix\">\n      <div id=\"main\" class=\"clearfix\">\n        \n        <main id=\"main-content\" tabindex=\"-1\">\n                            \n\n<div data-drupal-messages-fallback class=\"hidden\"></div>\n\n\n                              \n                      <article class=\"h-relative\">\n  \n      \n<div class=\"h-relative\">\n  <header class=\"c-banner-deep c-banner-deep--event | js-banner\">\n    \n    <div class=\"c-banner-deep__bg -has-overlay\">\n            <div class=\"c-banner-deep__img-wrapper\">\n        <div class=\"c-banner-deep__img\" style=\"background-image: url('https://www.sciencemuseum.org.uk/sites/default/files/styles/her/public/2026-06/ODY_INTL_DIGITAL_Horse_FilmBanner_1100x500px_UK.jpg?h=3b35cf52&amp;itok=mR9vX2KY')\"></div>\n      </div>\n                  <div class=\"c-banner-deep__content | o-container\">\n        <div class=\"c-banner-deep__content__wrapper\">\n          <div class=\"c-breadcrumb  | js-breadcrumb\">\n                <span class=\"visually-hidden\">You are here:</span>\n    <ol class=\"o-list c-breadcrumb__links\">\n    \n          <li>\n                  <a href=\"/\">\n                          <svg class=\"o-icon c-breadcrumb__divider-icon\" role=\"presentation\">\n                <use xlink:href=\"#arrow-bold-right\"></use>\n              </svg>\n                        Home\n          </a>\n              </li>\n          <li>\n                  <a href=\"/see-and-do\">\n                        See and do\n          </a>\n              </li>\n        </ol>\n\n          </div>\n          <div class=\"c-banner-deep__title__wrapper\">\n\n                        <h1 class=\"visually-hidden\" ><span class=\"h-relative\">The Odyssey (15)</span>\n</h1>\n\n            <div aria-hidden=\"true\" class=\"c-banner-deep__title | o-title o-title--primary\">\n              <span  class=\"js-cascade\"><span class=\"h-relative\">The Odyssey (15)</span>\n</span>\n            </div>\n          </div>\n                  </div>\n      </div>\n    </div>\n      </header>\n</div>\n  \n    <div class=\"o-main-content | js-sticky-container\">\n    <!-- Body content -->\n    <div class=\"o-body -first\">\n      <div class=\"o-container u-order\">\n        <div class=\"o-content u-order-body\">\n          <div class=\"c-wysiwyg\">\n              <div class=\"o-text-introduction\">\n                \n              </div>\n                          <p><span>Christopher Nolan's new must-see film,</span><em><span> The Odyssey</span></em><span>, is a mythic action epic shot across the world using brand new IMAX film technology. The film brings Homer's foundational saga to IMAX film screens for the first time and is the first feature to be shot entirely with IMAX cameras, making the Science Museum's 70mm IMAX cinema the best choice when booking tickets.</span></p><p><em><span>The Odyssey</span></em><span> stars Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson and Lupita Nyong'o, with Zendaya and Charlize Theron.&nbsp;</span></p><div class=\"embedded-entity\"><div>\n                  <div class=\"video-embed-field-provider-youtube video-embed-field-responsive-video\"><iframe width=\"854\" height=\"480\" frameborder=\"0\" src=\"https://www.youtube.com/embed/iklicVKcoI8?autoplay=0&amp;start=0&amp;rel=0\"></iframe>\n</div>\n\n      \n  </div>\n</div><ul><li><em>The Odyssey </em>(15), 2026, dir. Christopher Nolan, 172 mins.</li><li><span>2025 UNIVERSAL STUDIOS</span></li></ul>\n      \n          </div>\n        </div>\n        <div class=\"o-sidebar-wrapper-fixed  u-order-sidebar | js-sticky-sidebar\" data-sidebar-spacer=\"false\">\n          <div class=\"o-container\">\n            <div class=\"o-sidebar\">\n              <div>\n                <h2 class=\"visually-hidden\">Information</h2>\n                \n\n\n<div class=\"c-info-block c-info-block--primary\">\n  <ul class=\"c-info-block__list o-list\">\n        <li class=\"o-title o-title--tertiary c-info-block__title -first\">\n                  IMAX screening\n      \n    </li>\n        <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                  <li><span class=\"o-label\">Date:</span>             From 17 July 2026\n      </li>\n                                  <li><span class=\"o-label\">Duration:</span>             172 mins\n      </li>\n                          <li><span class=\"o-label\">Price:</span>             From £14 (discounts available)\n      </li>\n                          <li><span class=\"o-label\">Location:</span> IMAX: The Ronson Theatre\n      <span class=\"separator\">, </span>\n  Level 0</li>\n                <!-- Age and Height Restrictions -->\n                          <li><span class=\"o-label\">Age:</span>             Certificate 15\n      </li>\n                <!-- Festival \"parents\" -->\n              </ul>\n    </li>\n            <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                <li>\n          <a href=\"https://my.sciencemuseum.org.uk/events?view=calendar&amp;kid=794&amp;startdate=01-07-2026\" class=\"btn btn--primary -on-black\">\n            Check ticket availability\n            <svg class=\"o-icon btn__icon\" role=\"presentation\">\n              <use xlink:href=\"#arrow-bold-right\"></use>\n            </svg>\n          </a>\n        </li>\n                      </ul>\n    </li>\n                \n    \n  </ul>\n</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n                    <section class=\"o-section -primary\">\n  <div class=\"o-section__padding\">\n              <div class=\"o-container\">\n                  <h2 class=\"visually-hidden\">            Gallery\n      </h2>\n                      </div>\n              <div class=\"c-carousel c-carousel--gallery -offset | js-carousel\" data-carousel-style=\"offset\">\n        <div class=\"c-swiper-btn-pos\">\n          <button class=\"c-swiper-btn -back | swiper-button-back\">\n            <span class=\"visually-hidden\">Previous slide</span>\n            <svg><use xlink:href=\"#arrow-thin-right\"></use></svg>\n          </button>\n        </div>\n        <div class=\"c-swiper-btn-pos\">\n          <button class=\"c-swiper-btn | swiper-button-next\">\n            <span class=\"visually-hidden\">Next slide</span>\n            <svg><use xlink:href=\"#arrow-thin-right\"></use></svg>\n          </button>\n        </div>\n        <div class=\"swiper-container\">\n            <div class=\"swiper-wrapper\">\n                \n                            \n\n\n<div class=\"swiper-slide\">\n  <div class=\"c-media\">\n    <figure class=\"c-media__figure\"\n            data-large-image-width=\"1200\"\n            data-large-image-height=\"1200\