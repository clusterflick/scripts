search-form-2\" id=\"block-sitesearchform-mobile\">\n  \n  <div class=\"c-search-mob__form\">\n    \n        \n        <form autocomplete=\"off\" block=\"block-sitesearchform-mobile\" action=\"/see-and-do/the-odyssey\" method=\"post\" id=\"site-search-form-mobile\" accept-charset=\"UTF-8\">\n  <div class=\"js-form-item form-item form-type-search js-form-type-search form-item-term js-form-item-term\">\n      <label for=\"edit-term-mobile\">\n    Search the site\n\n      </label>\n        <input data-drupal-selector=\"edit-term\" data-msg-maxlength=\"Search the site field has a maximum length of 128.\" type=\"search\" id=\"edit-term-mobile\" name=\"term\" value=\"\" size=\"60\" maxlength=\"128\" class=\"form-search\" />\n\n        </div>\n<input data-drupal-selector=\"form-5c5-vncqbzi-orpn3lc3vf3r3-dh6cy7scrue26nwps\" type=\"hidden\" name=\"form_build_id\" value=\"form-5c5_vNCqbZi_ORpN3lc3vf3R3-DH6cY7SCRue26nWPs\" />\n<input data-drupal-selector=\"edit-site-search-form-2\" type=\"hidden\" name=\"form_id\" value=\"site_search_form\" />\n<div data-drupal-selector=\"edit-actions\" class=\"form-actions js-form-wrapper form-wrapper\" id=\"edit-actions-mobile\">\n\n<button  data-drupal-selector=\"site-search-form-button\" type=\"submit\" id=\"site-search-form-button-mobile\" name=\"op\" value=\"Submit\" class=\"button js-form-submit form-submit btn btn--primary\">\n  Submit\n  <svg class=\"o-icon btn__icon\" role=\"presentation\">\n    <use xlink:href=\"#arrow-bold-right\"></use>\n  </svg>\n</button></div>\n\n</form>\n\n      </div>\n\n</div>\n\n      </li>\n        </ul>\n          </div>\n    </div>\n      \n\n  </nav>\n  </div>\n    </header>\n        <div id=\"main-wrapper\" class=\"o-main-wrapper clearfix\">\n      <div id=\"main\" class=\"clearfix\">\n        \n        <main id=\"main-content\" tabindex=\"-1\">\n                            \n\n<div data-drupal-messages-fallback class=\"hidden\"></div>\n\n\n                              \n                      <article class=\"h-relative\">\n  \n  \n<div class=\"h-relative\">\n  <div class=\"c-banner-medium c-banner-medium--media\">\n    \n  \n    \n    <div class=\"c-banner-medium__element c-banner-medium__element--color\" style=\"background:#000000\">\n      <div class=\"c-banner-medium__column\" style=\"color:#000000\">\n                  <img src=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/her/public/2023-08/Talk%20header_2000x965_02.jpg?h=582bd360&amp;itok=X3DvdXTl\" class=\"c-banner-medium__img\" alt=\"\"/>\n              </div>\n    </div>\n    <div class=\"c-banner-medium__overlay\">\n      <div class=\"c-banner-medium__container | o-container\">\n        <div class=\"c-breadcrumb  | js-breadcrumb\">\n              <span class=\"visually-hidden\">You are here:</span>\n    <ol class=\"o-list c-breadcrumb__links\">\n    \n          <li>\n                  <a href=\"/\">\n                          <svg class=\"o-icon c-breadcrumb__divider-icon\" role=\"presentation\">\n                <use xlink:href=\"#arrow-bold-right\"></use>\n              </svg>\n                        Home\n          </a>\n              </li>\n          <li>\n                  <a href=\"/see-and-do\">\n                        See and do\n          </a>\n              </li>\n        </ol>\n\n        </div>\n\n                <h1 class=\"visually-hidden\"><span class=\"h-relative\">The Odyssey</span>\n</h1>\n\n        <div aria-hidden=\"true\" class=\"c-banner-medium__title | o-title o-title--primary\">\n          <span class=\"js-cascade\"><span class=\"h-relative\">The Odyssey</span>\n</span>\n        </div>\n              </div>\n    </div>\n  </div>\n</div>\n\n    <div class=\"o-main-content | js-sticky-container\">\n    <!-- Body content -->\n    <div class=\"o-body -first\">\n      <div class=\"o-container u-order\">\n        <div class=\"o-content u-order-body\">\n          <div class=\"c-wysiwyg\">\n              <div class=\"o-text-introduction\">\n                            <p>Get tickets now to experience the first IMAX 70mm screenings of Christopher Nolan's <em>The Odyssey</em> for one year from now—In cinemas 17 7 26.</p>\n\n      \n              </div>\n                          <p><span>Tickets are now sold out for The Odyssey. </span>If you missed out, <a href=\"https://sciencemuseum.wufoo.com/forms/px0vrw1bizs5c/\">please fill out this form</a> and register your interest so you can be the first to know when more screenings are released.</p><div class=\"align-center embedded-entity\"><div>\n                    <img src=\"/sites/default/files/styles/embedded_image/public/2025-07/odyssey-poster.jpg?itok=3nvgUVJp\" width=\"947\" height=\"1500\" alt=\"Poster for Christopher Nolan's The Odyssey\">\n\n\n\n      \n              </div>\n</div>\n      \n          </div>\n        </div>\n        <div class=\"o-sidebar-wrapper-fixed  u-order-sidebar | js-sticky-sidebar\" data-sidebar-spacer=\"false\">\n          <div class=\"o-container\">\n            <div class=\"o-sidebar\">\n              <div>\n                <h2 class=\"visually-hidden\">Information</h2>\n                \n\n\n<div class=\"c-info-block c-info-block--primary\">\n  <ul class=\"c-info-block__list o-list\">\n        <li class=\"o-title o-title--tertiary c-info-block__title -first\">\n                  IMAX screening\n      \n    </li>\n        <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                  <li><span class=\"o-label\">Date:</span>             17, 18 and 19 July 2026\n      </li>\n                          <li><span class=\"o-label\">Time:</span>             19.15\n      </li>\n                                  <li><span class=\"o-label\">Price:</span>             From £14 (discounts available)\n      </li>\n                          <li><span class=\"o-label\">Location:</span> IMAX: The Ronson Theatre\n      <span class=\"separator\">, </span>\n  Level 0</li>\n                <!-- Age and Height Restrictions -->\n                        <!-- Festival \"parents\" -->\n              </ul>\n    </li>\n            <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                <li>\n          <a href=\"https://my.sciencemuseum.org.uk/events?view=calendar&amp;kid=794&amp;StartDate=01-07-26&amp;queueittoken=e_smgqueue~q_00000000-0000-0000-0000-000000000000~ts_1755185970~ce_true~rt_disabled~h_4288ba935df466151a89b2ef73b05f74dfca744dd464801e9db6aba947a678ea\" class=\"btn btn--primary -on-black\">\n            SOLD OUT WITH MORE TICKETS TO COME\n            <svg class=\"o-icon btn__icon\" role=\"presentation\">\n              <use xlink:href=\"#arrow-bold-right\"></use>\n            </svg>\n          </a>\n        </li>\n                      </ul>\n    </li>\n                \n    \n  </ul>\n</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n                      \n\n<section class=\"o-section -secondary\" aria-labelledby=\"a-other-things-to-see-and-do\">\n    <div  class=\"slice view-mode-default o-container clearfix\">\n      <div class=\"o-container__padding\">\n                  <h2 id=\"a-other-things-to-see-and-do\" class=\"o-title o-title--section\">            Other things to see and do\n      </h2>\n                                      <div class=\"slice view-mode-thirds-3-column\">\n      <div class=\"js-carousel-teaser\" data-carousel-slidesPerView=\"1\"> \n  <div class=\"o-grid o-grid--3-col\">\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/imax-70mm-season\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2025-08/IMAX%20The%20Ronson%20Theatre%20at%20the%20Science%20Museum%20%C2%A9%20Science%20Museum%20Group%20%286%29%20%281%29.jpeg?h=0a8b6f8b&amp;itok=HjOPUOnb 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2025-08/IMAX%20The%20Ronson%20Theatre%20at%20the%20Science%20Museum%20%C2%A9%20Science%20Museum%20Group%20%286%29%20%281%29.jpeg?h=0a8b6f8b&amp;itok=HjOPUOnb\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">IMAX 70mm Season</span>\n\n      </h3>\n            <div class=\"c-card__desc\">\n                          <p>            Experience a season of stunning IMAX 70mm film classics at the Science Museum this winter. New dates now added! \n      </p>\n                      </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/power-evening-session\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2025-08/001%20%286%29.jpeg?h=eed674a8&amp;itok=MV5NbbGF 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2025-08/001%20%286%29.jpeg?h=eed674a8&amp;itok=MV5NbbGF\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Power Up evening session</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Event\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Dates vary\n      </span>\n                          <p>            Our popular sell-out adults-only Power Up evening sessions return in 2026 with more dates. \n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n      </div>\n</div>\n  </div>\n\n      \n              </div>\n  </div>\n</section>\n      \n    \n  </div>\n</article>\n\n\n\n        </main>\n              </div>\n    </div>\n    \n    <footer>\n      <div class=\"c-back-to-top-panel | js-sticky-footer\">\n  <div class=\"o-container\">\n    <div class=\"c-back-to-top-panel__wrapper\">\n      <a href=\"#main-wrapper\" class=\"c-back-to-top-panel__link | js-back-top\">\n        <span>Back to Top</span>\n\n        <svg class=\"o-icon\" role=\"presentation\">\n          <use xlink:href=\"#arrow-bold-right\"></use>\n        </svg>\n      </a>\n    </div>\n  </div>\n</div>\n      <div class=\"c-footer\">\n                  <div class=\"o-container\">\n            <div class=\"c-footer__padding\">\n              <div class=\"c-footer__section c-footer__section--second clearfix\">\n                      <div class=\"c-footer__block -column\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Location</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <span>Exhibition Road, South Kensington, London, SW7 2DD</span>\n                  </li>\n              <li>\n          <a href=\"http://www.discoversouthken.com/\" rel=\"noopener noreferrer\">Discover South Kensington</a>\n                  </li>\n            </ul>\n  \n                  </li>\n            </ul>\n  \n\n  </div><div class=\"c-footer__block -column\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Opening times</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <a href=\"/visit\" data-drupal-link-system-path=\"node/2746\">Open daily 10.00–18.00 (except for 24-26 December)</a>\n                  </li>\n            </ul>\n  \n                  </li>\n            </ul>\n  \n\n  </div><div class=\"c-footer__block -column -social\">\n      \n              <ul class=\"o-list\">\n                    <li>\n      