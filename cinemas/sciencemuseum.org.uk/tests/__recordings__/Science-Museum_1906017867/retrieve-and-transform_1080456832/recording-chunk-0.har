 view-mode-default o-container clearfix\">\n      <div class=\"o-container__padding\">\n                  <h2 id=\"a-see-more-films\" class=\"o-title o-title--section\">            See more films\n      </h2>\n                                      <div class=\"slice view-mode-default\">\n      <div class=\"o-grid o-grid--4-col\">\n      <div class=\"o-grid__item\"><article class=\"c-card -feature\">\n  <a href=\"/see-and-do/star-trek-60-film-season\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2026-02/ST_Nemesis_Still_KS_0005_186d1a470cf2b545ef0caa46626acbbbfe4d950b_0.jpg?h=4e0c70af&amp;itok=q972f3hV 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2026-02/ST_Nemesis_Still_KS_0005_186d1a470cf2b545ef0caa46626acbbbfe4d950b_0.jpg?h=4e0c70af&amp;itok=q972f3hV\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Star Trek at 60 Film season</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Festival\n      \n      </div>\n            <div class=\"c-card__desc\">\n                          <p>            Celebrate the 60th anniversary of Star Trek and experience the entire cinematic legacy, from the original voyages of Captain Kirk to the modern reboot trilogy, <br />\r\n\n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n      <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/what-was-on/star-trek-the-motion-picture\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2026-02/ST_THE_MOTION_PICTUREpromo.png?h=87c939dd&amp;itok=i6p8uijz 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2026-02/ST_THE_MOTION_PICTUREpromo.png?h=87c939dd&amp;itok=i6p8uijz\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Star Trek: The Motion Picture (PG)—Director’s Edition</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Film\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            This event took place on Thursday 26 March 2026\n      </span>\n                          <p>            The original Star Trek adventure, Star Trek: The Motion Picture (1979), returns, fully restored, for the ultimate big-screen experience.\n      </p>\n                      </div>\n    </div>\n  </a>\n</article>\n</div>\n      <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/star-trek-ii-the-wrath-of-khan\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2026-02/ST2_Wrath_Still_0.jpg?h=3a7c63f8&amp;itok=DPFVmcoi 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2026-02/ST2_Wrath_Still_0.jpg?h=3a7c63f8&amp;itok=DPFVmcoi\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Star Trek II: The Wrath of Khan (12A)—Director&#039;s Cut</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Film\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            This event took place on Thursday 2 April 2026\n      </span>\n                          <p>            A thrilling second installment in the Star Trek film franchise, Star Trek II: The Wrath of Khan (1982), delivers unforgettable action and emotional depth on one of the biggest screens in the UK. \n      </p>\n                      </div>\n    </div>\n  </a>\n</article>\n</div>\n      <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/star-trek-into-darkness\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2026-02/ST12_INTO_DARKNESS.jpg?h=7d69bdbb&amp;itok=Zn2Fvy_8 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2026-02/ST12_INTO_DARKNESS.jpg?h=7d69bdbb&amp;itok=Zn2Fvy_8\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Star Trek Into Darkness (12A) </span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Film\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Thursday 11 June 2026\n      </span>\n                          <p>            A bold new era of Star Trek continues in this thrilling second chapter of the rebooted saga. Experience it on one of the biggest screens in the UK.\n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n  </div>\n  </div>\n\n      \n              </div>\n  </div>\n</section>\n      \n\n\n        </main>\n              </div