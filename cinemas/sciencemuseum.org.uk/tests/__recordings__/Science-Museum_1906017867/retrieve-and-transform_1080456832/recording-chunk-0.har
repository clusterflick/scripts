rupal-link-system-path=\"node/12757\">Adopt an object</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/become-patron\" data-drupal-link-system-path=\"node/2701\">Become a Patron</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/corporate-partnerships\" data-drupal-link-system-path=\"node/2749\">Corporate partnerships</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/giftsinwills\" data-drupal-link-system-path=\"node/2710\">Leave a gift in your will</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/support-us-major-gift\" data-drupal-link-system-path=\"node/2707\">Support us with a major gift</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://shop.sciencemuseum.org.uk/  \" rel=\"noopener noreferrer\">Shop</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://wonderlabplus.sciencemuseumgroup.org.uk/\" rel=\"noopener noreferrer\">Wonderlab+</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://blog.sciencemuseum.org.uk/\" rel=\"noopener noreferrer\">Blog</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://my.sciencemuseum.org.uk/account/create/brief\" rel=\"noopener noreferrer\">Newsletter</a>\n                      </li>\n    \n          <li>\n        <div class=\"site-search-form c-search-mob\" data-drupal-selector=\"site-search-form-2\" id=\"block-sitesearchform-mobile\">\n  \n  <div class=\"c-search-mob__form\">\n    \n        \n        <form autocomplete=\"off\" block=\"block-sitesearchform-mobile\" action=\"/see-and-do/wild-asia-life-at-extremes\" method=\"post\" id=\"site-search-form-mobile\" accept-charset=\"UTF-8\">\n  <div class=\"js-form-item form-item form-type-search js-form-type-search form-item-term js-form-item-term\">\n      <label for=\"edit-term-mobile\">\n    Search the site\n\n      </label>\n        <input data-drupal-selector=\"edit-term\" data-msg-maxlength=\"Search the site field has a maximum length of 128.\" type=\"search\" id=\"edit-term-mobile\" name=\"term\" value=\"\" size=\"60\" maxlength=\"128\" class=\"form-search\" />\n\n        </div>\n<input data-drupal-selector=\"form-5c5-vncqbzi-orpn3lc3vf3r3-dh6cy7scrue26nwps\" type=\"hidden\" name=\"form_build_id\" value=\"form-5c5_vNCqbZi_ORpN3lc3vf3R3-DH6cY7SCRue26nWPs\" />\n<input data-drupal-selector=\"edit-site-search-form-2\" type=\"hidden\" name=\"form_id\" value=\"site_search_form\" />\n<div data-drupal-selector=\"edit-actions\" class=\"form-actions js-form-wrapper form-wrapper\" id=\"edit-actions-mobile\">\n\n<button  data-drupal-selector=\"site-search-form-button\" type=\"submit\" id=\"site-search-form-button-mobile\" name=\"op\" value=\"Submit\" class=\"button js-form-submit form-submit btn btn--primary\">\n  Submit\n  <svg class=\"o-icon btn__icon\" role=\"presentation\">\n    <use xlink:href=\"#arrow-bold-right\"></use>\n  </svg>\n</button></div>\n\n</form>\n\n      </div>\n\n</div>\n\n      </li>\n        </ul>\n          </div>\n    </div>\n      \n\n  </nav>\n  </div>\n    </header>\n        <div id=\"main-wrapper\" class=\"o-main-wrapper clearfix\">\n      <div id=\"main\" class=\"clearfix\">\n        \n        <main id=\"main-content\" tabindex=\"-1\">\n                            \n\n<div data-drupal-messages-fallback class=\"hidden\"></div>\n\n\n                              \n                      <article class=\"h-relative\">\n  \n      \n<div class=\"h-relative\">\n  <header class=\"c-banner-deep c-banner-deep--event | js-banner\">\n    \n    <div class=\"c-banner-deep__bg -has-overlay\">\n            <div class=\"c-banner-deep__img-wrapper\">\n        <div class=\"c-banner-deep__img\" style=\"background-image: url('https://www.sciencemuseum.org.uk/sites/default/files/styles/her/public/2026-02/wild-asia-4%20%281%29.jpg?h=60873127&amp;itok=lP8Y5VLp')\"></div>\n      </div>\n                  <div class=\"c-banner-deep__content | o-container\">\n        <div class=\"c-banner-deep__content__wrapper\">\n          <div class=\"c-breadcrumb  | js-breadcrumb\">\n                <span class=\"visually-hidden\">You are here:</span>\n    <ol class=\"o-list c-breadcrumb__links\">\n    \n          <li>\n                  <a href=\"/\">\n                          <svg class=\"o-icon c-breadcrumb__divider-icon\" role=\"presentation\">\n                <use xlink:href=\"#arrow-bold-right\"></use>\n              </svg>\n                        Home\n          </a>\n              </li>\n          <li>\n                  <a href=\"/see-and-do\">\n                        See and do\n          </a>\n              </li>\n        </ol>\n\n          </div>\n          <div class=\"c-banner-deep__title__wrapper\">\n\n                        <h1 class=\"visually-hidden\" ><span class=\"h-relative\">Wild Asia: Life at Extremes 3D (U)</span>\n</h1>\n\n            <div aria-hidden=\"true\" class=\"c-banner-deep__title | o-title o-title--primary\">\n              <span  class=\"js-cascade\"><span class=\"h-relative\">Wild Asia: Life at Extremes 3D (U)</span>\n</span>\n            </div>\n          </div>\n                  </div>\n      </div>\n    </div>\n      </header>\n</div>\n  \n    <div class=\"o-main-content | js-sticky-container\">\n    <!-- Body content -->\n    <div class=\"o-body -first\">\n      <div class=\"o-container u-order\">\n        <div class=\"o-content u-order-body\">\n          <div class=\"c-wysiwyg\">\n              <div class=\"o-text-introduction\">\n                            <p>Embark on an epic journey across the wild lands of Asia, where breathtaking landscapes and extraordinary animals await around every corner.</p>\n\n      \n              </div>\n                          <p><span>Narrated by Colin Firth, this adventure begins on the snowy peaks of the Himalayas where you’ll meet snow leopards and tigers raising their little ones in ever-challenging conditions. You continue into remote forests where red pandas hide among treetops before landing in the Gobi Desert to meet the remarkable long-eared jumping Jerboa.&nbsp;</span></p><div class=\"embedded-entity\"><div>\n                  <div class=\"video-embed-field-provider-youtube video-embed-field-responsive-video\"><iframe width=\"854\" height=\"480\" frameborder=\"0\" src=\"https://www.youtube.com/embed/ScWg4_mvVA0?autoplay=0&amp;start=0&amp;rel=0\"></iframe>\n</div>\n\n      \n  </div>\n</div><p><span>After exploring mountains and desert, you are plunged beneath the waves of the world’s richest coral seas of the Pacific, home to the cute-yet-deadly Sea Bunnies and sharks.&nbsp;</span></p><p><span>In this stunning BBC Earth 3D documentary, you will be amazed by stories revealing and exploring the most incredible ways wildlife has been thriving in one of the world’s most extreme environments.</span></p>\n      \n          </div>\n        </div>\n        <div class=\"o-sidebar-wrapper-fixed  u-order-sidebar | js-sticky-sidebar\" data-sidebar-spacer=\"false\">\n          <div class=\"o-container\">\n            <div class=\"o-sidebar\">\n              <div>\n                <h2 class=\"visually-hidden\">Information</h2>\n                \n\n\n<div class=\"c-info-block c-info-block--primary\">\n  <ul class=\"c-info-block__list o-list\">\n        <li class=\"o-title o-title--tertiary c-info-block__title -first\">\n                  IMAX screening\n      \n    </li>\n        <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                  <li><span class=\"o-label\">Date:</span>             Now screening\n      </li>\n                                  <li><span class=\"o-label\">Duration:</span>              60 minutes including adverts\n      </li>\n                          <li><span class=\"o-label\">Price:</span>             £14. Book early for cheaper prices. Family discounts available. Ages 3 and under go free.\n      </li>\n                          <li><span class=\"o-label\">Location:</span> IMAX: The Ronson Theatre\n      <span class=\"separator\">, </span>\n  Level 0</li>\n                <!-- Age and Height Restrictions -->\n                          <li><span class=\"o-label\">Age:</span>              Children under 12 must be accompanied by an adult\n      </li>\n                <!-- Festival \"parents\" -->\n              </ul>\n    </li>\n            <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                <li>\n          <a href=\"https://my.sciencemuseum.org.uk/events?view=calendar&amp;kid=839&amp;StartDate=01-03-2026\" class=\"btn btn--primary -on-black\">\n            Book now\n            <svg class=\"o-icon btn__icon\" role=\"presentation\">\n              <use xlink:href=\"#arrow-bold-right\"></use>\n            </svg>\n          </a>\n        </li>\n                      </ul>\n    </li>\n                \n    \n  </ul>\n</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n                    \n<div class=\"o-body\">\n  <div class=\"o-container\">\n    <div class=\"o-content\">\n      <section class=\"slice view-mode-default c-accordion clearfix | js-accordion\" >\n              \n        <h2  class=\"c-accordion__section-title\">            Ticket information\n      </h2>\n                                  <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-1\" aria-expanded=\"false\" aria-controls=\"tab-content-1\">\n\t  <span>            SAVE 50% ON TICKETS\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-1\" aria-hidden=\"true\" aria-labelledby=\"tab-1\">\n              <p><span>You can also get 50% off IMAX documentary tickets when you book day passes for </span><em><span>Wonderlab</span></em><span> or </span><em><span>Power Up</span></em><span>. You will automatically receive the discount when you add them to your basket</span></p>\n      \n  \n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-2\" aria-expanded=\"false\" aria-controls=\"tab-content-2\">\n\t  <span>            BOOK EARLY TO GET CHEAPER TICKET PRICES \n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-2\" aria-hidden=\"true\" aria-labelledby=\"tab-2\">\n              <div class=\"ListContainerWrapper SCXW99034202 BCX8\"><ul><li><span class=\"TextRun Highlight SCXW99034202 BCX8 NormalTextRun\" lang=\"EN-GB\">Save £1 per ticket when you book 1 – 6 days before your visit </span><span class=\"EOP SCXW99034202 BCX8\">&nbsp;</span></li></ul></div><div class=\"ListContainerWrapper SCXW99034202 BCX8\"><ul><li><span class=\"TextRun Highlight SCXW99034202 BCX8 NormalTextRun\" lang=\"EN-GB\">Save £2 per ticket when you book 7 – 13 days before your visit </span><span class=\"EOP SCXW99034202 BCX8\">&nbsp;</span></li></ul></div><div class=\"ListContainerWrapper SCXW99034202 BCX8\"><ul><li><span class=\"TextRun Highlight SCXW99034202 BCX8 NormalTextRun\" lang=\"EN-GB\">Save £3 per ticket when you book 14+ days before your visit </span><span class=\"EOP SCXW99034202 BCX8\">&nbsp;</span></li></ul></div><div class=\"OutlineElement Ltr SCXW99034202 BCX8\"><p><span class=\"TextRun Highlight SCXW99034202 BCX8 NormalTextRun\" lang=\"EN-GB\">If you book in advance, you can save an additional £1 per ticket &nbsp;by booking IMAX screenings with start times between 15.15 – 18.00 </span><span class=\"EOP SCXW99034202 BCX8\">&nbsp;</span></p></div><div class=\"OutlineElement Ltr SCXW99034202 BCX8\"><p><span class=\"TextRun Highlight SCXW99034202 BCX8 NormalTextRun\" lang=\"EN-GB\">Find out more in </span><span class=\"TextRun Highlight Underlined SCXW99034202 BCX8 NormalTextRun\" lang=\"EN-GB\">our </span><a href=\"/ticket-prices-faqs\" data-entity-type=\"node\" data-entity-uuid=\"f26e464c-3997-451a-bde0-483c85b21af6\" data-entity-substitution=\"canonical\"><span class=\"TextRun Highlight Underlined SCXW99034202 BCX8 NormalTextRun\" lang=\"EN-GB\">FAQs</span></a><span class=\"TextRun Highlight SCXW99034202 BCX8 NormalTextRun\" lang=\"EN-GB\">.</span><span class=\"EOP SCXW99034202 BCX8\">&nbsp;</span></p></div>\n      \n  \n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-3\" aria-expanded=\"false\" aria-controls=\"tab-content-3\">\n\t  <span>            Universal Credit tickets\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-3\" aria-hidden=\"true\" aria-labelledby=\"tab-3\">\n              <ul><li>A limited number of £5 tickets are available to anyone in receipt of Universal Credit or some other benefits.</li><li>You can claim £5 tickets for up to five people per household.</li><li>Tickets are only available at least one day before your visit. If you can't find £5 tickets for the date you wish to book, this date is sold out but further dates are available.</li><li>Please see <a class=\"OWAAutoLink\" href=\"/universal-credit-ticket-discounts\" target=\"_blank\" data-entity-type=\"node\" data-entity-uuid=\"d716c1a2-7e75-415f-a137-d7a427f3afd6\" data-entity-substitution=\"canonical\">this page</a>&nbsp;for more details including which supporting documents are needed to show eligibility.</li></ul>\n      \n  \n</div>\n\n      \n                </section>\n    </div>\n  </div>\n</div>\n      \n    \n  </div>\n</article>\n              \n\n<section class=\"o-section -secondary\" aria-labelledby=\"a-other-imax-screenings\">\n    <div  class=\"slice view-mode-default o-container clearfix\">\n      <div class=\"o-container__padding\">\n                  <h2 id=\"a-other-imax-screenings\" class=\"o-title o-title--section\">            Other IMAX screenings\n      </h2>\n                                      <div class=\"slice view-mode-thirds-3-column\">\n      <div class=\"js-carousel-teaser\" data-carousel-slidesPerView=\"1\"> \n  <div class=\"o-grid o-grid--3-col\">\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/arctic-our-frozen-planet\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2026-02/FP2-2HPHH-JustinHofman_DC28538%20%281%29.jpg?h=9dd951d5&amp;itok=f3LU4K3s 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2026-02/FP2-2HPHH-JustinHofman_DC28538%20%281%29.jpg?h=9dd951d5&amp;itok=f3LU4K3s\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Arctic: Our Frozen Planet 3D (U) </span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            IMAX screening\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Now screening\n      </span>\n                          <p>            Join Benedict Cumberbatch as he explores the Arctic in an epic adventure across this magical realm of snow and ice.  \n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/t-rex-3d-pg\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2024-12/Adult%20Rex%20Sunset%20Burst.jpg?h=c3d4457c&amp;itok=bA1ZUD3H 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2024-12/Adult%20Rex%20Sunset%20Burst.jpg?h=c3d4457c&amp;itok=bA1ZUD3H\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">T. rex 3D (PG)</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            IMAX screening\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Now screening\n      </span>\n                          <p>            Witness the wonder years of the T.rex and learn how science contributed to the understanding of these legendary dinosaurs. Book early for cheaper prices. \n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/beautiful-planet-3d-u\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2020-11/A-Beautiful-Planet.jpg?h=3cf665d7&amp;itok=GG-n01r- 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2020-11/A-Beautiful-Planet.jpg?h=3cf665d7&amp;itok=GG-n01r-\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">A Beautiful Planet 3D (U)</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            IMAX screening\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Now showing\n      </span>\n                          <p>            Meet the crew on board the International Space Station and see stunning 3D views of Earth from space. Book early for cheaper prices. \n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n      </div>\n</div>\n  </div>\n\n      \n              </div>\n  </div>\n</section>\n      \n\n\n        </main>\n              </div>\n    </div>\n    \n    <footer>\n      <div class=\"c-back-to-top-panel | js-sticky-footer\">\n  <div class=\"o-container\">\n    <div class=\"c-back-to-top-panel__wrapper\">\n      <a href=\"#main-wrapper\" class=\"c-back-to-top-panel__link | js-back-top\">\n        <span>Back to Top</span>\n\n        <svg class=\"o-icon\" role=\"presentation\">\n          <use xlink:href=\"#arrow-bold-right\"></use>\n        </svg>\n      </a>\n    </div>\n  </div>\n</div>\n      <div class=\"c-footer\">\n                  <div class=\"o-container\">\n            <div class=\"c-footer__padding\">\n              <div class=\"c-footer__section c-footer__section--second clearfix\">\n                      <div class=\"c-footer__block -column\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Location</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <span>Exhibition Road, South Kensington, London, SW7 2DD</span>\n                  </li>\n              <li>\n          <a href=\"http://www.discoversouthken.com/\" rel=\"noopener noreferrer\">Discover South Kensington</a>\n                  </li>\n            </ul>\n  \n                  </li>\n            </ul>\n  \n\n  </div><div class=\"c-footer__block -column\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Opening times</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <a href=\"/visit\" data-drupal-link-system-path=\"node/2746\">Open daily 10.00–18.00 (except for 24-26 December)</a>\n                  </li>\n            </ul>\n  \n                  </li>\n            </ul>\n  \n\n  </div><div class=\"c-footer__block -column -social\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Newsletter</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <a href=\"https://my.sciencemuseum.org.uk/account/create/brief\" rel=\"noopener noreferrer\">Sign up</a>\n                  </li>\n            </ul>\n  \n                  </li>\n              <li>\n          <span>My Account</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <a href=\"https://my.sciencemuseum.org.uk/account/login\" rel=\"noopener noreferrer\">My bookings</a>\n                  </li>\n              <li>\n          <a href=\"https://groups.sciencemuseum.org.uk/login\" rel=\"noopener noreferrer\">My school or group bookings</a>\n                  </li>\n            </ul>\n  \n                  </li>\n              <li>\n          <span>Keep in touch</span>\n 