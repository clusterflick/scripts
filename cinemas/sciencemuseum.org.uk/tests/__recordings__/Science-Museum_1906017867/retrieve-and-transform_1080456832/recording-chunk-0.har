            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/researchers/research-events\" data-drupal-link-system-path=\"node/6982\">Research Events</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"http://journal.sciencemuseum.ac.uk\" rel=\"noopener noreferrer\">Science Museum Group Journal</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">About us</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us\" data-drupal-link-system-path=\"node/2929\">About us</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/press-office\" data-drupal-link-system-path=\"node/2944\">Press office</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://www.hirethesciencemuseum.com/\" rel=\"noopener noreferrer\">Venue hire</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://www.sciencemuseumgroup.org.uk/work-with-us\" rel=\"noopener noreferrer\">Jobs</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/volunteering-science-museum\" data-drupal-link-system-path=\"node/2728\">Volunteering</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/contact-us\" data-drupal-link-system-path=\"node/2731\">Contact us</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Support us</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us\" data-drupal-link-system-path=\"node/3790\">Support us</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/donate-today\" data-drupal-link-system-path=\"node/15373\">Donate today</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/adopt-an-object\" data-drupal-link-system-path=\"node/12757\">Adopt an object</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/become-patron\" data-drupal-link-system-path=\"node/2701\">Become a Patron</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/corporate-partnerships\" data-drupal-link-system-path=\"node/2749\">Corporate partnerships</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/giftsinwills\" data-drupal-link-system-path=\"node/2710\">Leave a gift in your will</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/support-us-major-gift\" data-drupal-link-system-path=\"node/2707\">Support us with a major gift</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://shop.sciencemuseum.org.uk/  \" rel=\"noopener noreferrer\">Shop</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://wonderlabplus.sciencemuseumgroup.org.uk/\" rel=\"noopener noreferrer\">Wonderlab+</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://blog.sciencemuseum.org.uk/\" rel=\"noopener noreferrer\">Blog</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://my.sciencemuseum.org.uk/account/create/brief\" rel=\"noopener noreferrer\">Newsletter</a>\n                      </li>\n    \n          <li>\n        <div class=\"site-search-form c-search-mob\" data-drupal-selector=\"site-search-form-2\" id=\"block-sitesearchform-mobile\">\n  \n  <div class=\"c-search-mob__form\">\n    \n        \n        <form autocomplete=\"off\" block=\"block-sitesearchform-mobile\" action=\"/see-and-do/beautiful-planet-3d-u\" method=\"post\" id=\"site-search-form-mobile\" accept-charset=\"UTF-8\">\n  <div class=\"js-form-item form-item form-type-search js-form-type-search form-item-term js-form-item-term\">\n      <label for=\"edit-term-mobile\">\n    Search the site\n\n      </label>\n        <input data-drupal-selector=\"edit-term\" data-msg-maxlength=\"Search the site field has a maximum length of 128.\" type=\"search\" id=\"edit-term-mobile\" name=\"term\" value=\"\" size=\"60\" maxlength=\"128\" class=\"form-search\" />\n\n        </div>\n<input data-drupal-selector=\"form-5c5-vncqbzi-orpn3lc3vf3r3-dh6cy7scrue26nwps\" type=\"hidden\" name=\"form_build_id\" value=\"form-5c5_vNCqbZi_ORpN3lc3vf3R3-DH6cY7SCRue26nWPs\" />\n<input data-drupal-selector=\"edit-site-search-form-2\" type=\"hidden\" name=\"form_id\" value=\"site_search_form\" />\n<div data-drupal-selector=\"edit-actions\" class=\"form-actions js-form-wrapper form-wrapper\" id=\"edit-actions-mobile\">\n\n<button  data-drupal-selector=\"site-search-form-button\" type=\"submit\" id=\"site-search-form-button-mobile\" name=\"op\" value=\"Submit\" class=\"button js-form-submit form-submit btn btn--primary\">\n  Submit\n  <svg class=\"o-icon btn__icon\" role=\"presentation\">\n    <use xlink:href=\"#arrow-bold-right\"></use>\n  </svg>\n</button></div>\n\n</form>\n\n      </div>\n\n</div>\n\n      </li>\n        </ul>\n          </div>\n    </div>\n      \n\n  </nav>\n  </div>\n    </header>\n        <div id=\"main-wrapper\" class=\"o-main-wrapper clearfix\">\n      <div id=\"main\" class=\"clearfix\">\n        \n        <main id=\"main-content\" tabindex=\"-1\">\n                            \n\n<div data-drupal-messages-fallback class=\"hidden\"></div>\n\n\n                              \n                      <article class=\"h-relative\">\n  \n      \n<div class=\"h-relative\">\n  <header class=\"c-banner-deep c-banner-deep--event | js-banner\">\n    \n    <div class=\"c-banner-deep__bg -has-overlay\">\n            <div class=\"c-banner-deep__img-wrapper\">\n        <div class=\"c-banner-deep__img\" style=\"background-image: url('https://www.sciencemuseum.org.uk/sites/default/files/styles/her/public/2020-11/A-Beautiful-Planet.jpg?h=3cf665d7&amp;itok=vQ0PKoAS')\"></div>\n      </div>\n                  <div class=\"c-banner-deep__content | o-container\">\n        <div class=\"c-banner-deep__content__wrapper\">\n          <div class=\"c-breadcrumb  | js-breadcrumb\">\n                <span class=\"visually-hidden\">You are here:</span>\n    <ol class=\"o-list c-breadcrumb__links\">\n    \n          <li>\n                  <a href=\"/\">\n                          <svg class=\"o-icon c-breadcrumb__divider-icon\" role=\"presentation\">\n                <use xlink:href=\"#arrow-bold-right\"></use>\n              </svg>\n                        Home\n          </a>\n              </li>\n          <li>\n                  <a href=\"/see-and-do\">\n                        See and do\n          </a>\n              </li>\n        </ol>\n\n          </div>\n          <div class=\"c-banner-deep__title__wrapper\">\n\n                        <h1 class=\"visually-hidden\" ><span class=\"h-relative\">A Beautiful Planet 3D (U)</span>\n</h1>\n\n            <div aria-hidden=\"true\" class=\"c-banner-deep__title | o-title o-title--primary\">\n              <span  class=\"js-cascade\"><span class=\"h-relative\">A Beautiful Planet 3D (U)</span>\n</span>\n            </div>\n          </div>\n                  </div>\n      </div>\n    </div>\n      </header>\n</div>\n  \n    <div class=\"o-main-content | js-sticky-container\">\n    <!-- Body content -->\n    <div class=\"o-body -first\">\n      <div class=\"o-container u-order\">\n        <div class=\"o-content u-order-body\">\n          <div class=\"c-wysiwyg\">\n              <div class=\"o-text-introduction\">\n                            <p>Narrated by Jennifer Lawrence, A Beautiful Planet 3D provides a unique vantage point to witness humanity’s impact on the world.&nbsp;&nbsp;</p>\n\n      \n              </div>\n                          <p>Meet the crew on board the International Space Station as they capture stunning footage of our magnificent blue planet to deepen our connection to the place we all call home.&nbsp;&nbsp;</p><p>Exclusively watch this fully immersive IMAX experience on one of the biggest screens in the UK. <span class=\"TextRun SCXW210957221 BCX0 NormalTextRun\" lang=\"EN-US\">Don’t miss out—book early to get cheaper prices.  </span><span class=\"EOP SCXW210957221 BCX0\">&nbsp;</span></p>\n      \n          </div>\n        </div>\n        <div class=\"o-sidebar-wrapper-fixed  u-order-sidebar | js-sticky-sidebar\" data-sidebar-spacer=\"false\">\n          <div class=\"o-container\">\n            <div class=\"o-sidebar\">\n              <div>\n                <h2 class=\"visually-hidden\">Information</h2>\n                \n\n\n<div class=\"c-info-block c-info-block--primary\">\n  <ul class=\"c-info-block__list o-list\">\n        <li class=\"o-title o-title--tertiary c-info-block__title -first\">\n                  IMAX screening\n      \n    </li>\n        <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                  <li><span class=\"o-label\">Date:</span>             Now showing\n      </li>\n                                  <li><span class=\"o-label\">Duration:</span>             60 minutes including adverts \n      </li>\n                          <li><span class=\"o-label\">Price:</span>             £14. Book early for cheaper prices. Family discounts available. Ages 3 and under go free.\n      </li>\n                          <li><span class=\"o-label\">Location:</span> IMAX: The Ronson Theatre\n      <span class=\"separator\">, </span>\n  Level 0</li>\n                <!-- Age and Height Restrictions -->\n                          <li><span class=\"o-label\">Age:</span>             Children under 12 must be accompanied by an adult\n      </li>\n                <!-- Festival \"parents\" -->\n              </ul>\n    </li>\n            <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                <li>\n          <a href=\"https://my.sciencemuseum.org.uk/events?view=calendar&amp;kid=43\" class=\"btn btn--primary -on-black\">\n            Book now\n            <svg class=\"o-icon btn__icon\" role=\"presentation\">\n              <use xlink:href=\"#arrow-bold-right\"></use>\n            </svg>\n          </a>\n        </li>\n                      </ul>\n    </li>\n                              <li class=\"visually-hidden\">            Projector info\n      </li>\n  <li class=\"c-info-block__section\">            <p><br><strong>PROJECTOR:&nbsp;</strong>IMAX Laser 4K&nbsp;</p><hr><p><a href=\"https://www.sciencemuseum.org.uk/learning/beautiful-planet-3d-u-school-info\" target=\"_blank\">A Beautiful Planet 3D for education groups</a></p>\n      </li>\n\n      \n    \n  </ul>\n</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n                    <div class=\"o-body\">\n    <div class=\"o-container\">\n    <div class=\"o-content\">\n      <div class=\"c-carousel-quote | js-carousel-quote\">\n        <div class=\"swiper-container\">\n          <div class=\"swiper-wrapper\">\n                        <div class=\"swiper-slide\">\n\t<blockquote class=\"c-quote\">\n\t  <p class=\"c-quote__content\">            You can’t help but be wowed by the imagery here, made all the more impressive by the large format and 3D. It’s thoughtful escapism for adults; it’s essential viewing for kids.\n      </p>\n\t  <footer class=\"c-quote__cite\">            Time Out \n      </footer>\n\t</blockquote>\n</div>\n          <div class=\"swiper-slide\">\n\t<blockquote class=\"c-quote\">\n\t  <p class=\"c-quote__content\">            The result is the best kind of spectacle: that which encourages us to look up and beyond ourselves—and does so using only organic special effects. \n      </p>\n\t  <footer class=\"c-quote__cite\">            The Guardian \n      </footer>\n\t</blockquote>\n</div>\n          <div class=\"swiper-slide\">\n\t<blockquote class=\"c-quote\">\n\t  <p class=\"c-quote__content\">            It’s appealing to adults and accessible to younger viewers. And it delivers an environmental message that is strong and serious while remaining encouraging and optimistic. \n      </p>\n\t  <footer class=\"c-quote__cite\">            New York Times\n      </footer>\n\t</blockquote>\n</div>\n      \n          </div>\n          <div class=\"swiper-pagination\"></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n          \n<div class=\"o-body\">\n  <div class=\"o-container\">\n    <div class=\"o-content\">\n      <section class=\"slice view-mode-default c-accordion clearfix | js-accordion\" >\n              \n        <h2  class=\"c-accordion__section-title\">            Ticket information\n      </h2>\n                                  <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-1\" aria-expanded=\"false\" aria-controls=\"tab-content-1\">\n\t  <span>            Save 50% on tickets\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-1\" aria-hidden=\"true\" aria-labelledby=\"tab-1\">\n              <p><span>You can also get 50% off IMAX documentary tickets when you book day passes for </span><em><span>Wonderlab</span></em><span> or </span><em><span>Power Up</span></em><span>. You will automatically receive the discount when you add them to your basket. &nbsp;</span></p>\n      \n  \n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-2\" aria-expanded=\"false\" aria-controls=\"tab-content-2\">\n\t  <span>            Book early to get cheaper ticket prices\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-2\" aria-hidden=\"true\" aria-labelledby=\"tab-2\">\n              <div class=\"ListContainerWrapper SCXW257064750 BCX8\"><ul><li><span class=\"TextRun Highlight SCXW257064750 BCX8 NormalTextRun\" lang=\"EN-GB\">Save £1 per ticket when you book 1 – 6 days before your visit </span><span class=\"EOP SCXW257064750 BCX8\">&nbsp;</span></li></ul></div><div class=\"ListContainerWrapper SCXW257064750 BCX8\"><ul><li><span class=\"TextRun Highlight SCXW257064750 BCX8 NormalTextRun\" lang=\"EN-GB\">Save £2 per ticket when you book 7 – 13 days before your visit </span><span class=\"EOP SCXW257064750 BCX8\">&nbsp;</span></li></ul></div><div class=\"ListContainerWrapper SCXW257064750 BCX8\"><ul><li><span class=\"TextRun Highlight SCXW257064750 BCX8 NormalTextRun\" lang=\"EN-GB\">Save £3 per ticket when you book 14+ days before your visit </span><span class=\"EOP SCXW257064750 BCX8\">&nbsp;</span></li></ul></div><div class=\"OutlineElement Ltr SCXW257064750 BCX8\"><p><span class=\"TextRun Highlight SCXW257064750 BCX8 NormalTextRun\" lang=\"EN-GB\">If you book in advance, you can save an additional £1 per ticket &nbsp;by booking IMAX screenings with start times between 15.15 – 18.00 </span><span class=\"EOP SCXW257064750 BCX8\">&nbsp;</span></p></div><div class=\"OutlineElement Ltr SCXW257064750 BCX8\"><p><span class=\"TextRun Highlight SCXW257064750 BCX8 NormalTextRun\" lang=\"EN-GB\">Find out more in </span><a class=\"Hyperlink SCXW257064750 BCX8\" href=\"/ticket-prices-faqs\" target=\"_blank\" data-entity-type=\"node\" data-entity-uuid=\"f26e464c-3997-451a-bde0-483c85b21af6\" data-entity-substitution=\"canonical\"><span class=\"TextRun Highlight Underlined SCXW257064750 BCX8 NormalTextRun\" lang=\"EN-GB\">our FAQs</span></a><span class=\"TextRun Highlight SCXW257064750 BCX8 NormalTextRun\" lang=\"EN-GB\">.</span><span class=\"EOP SCXW257064750 BCX8\">&nbsp;</span></p></div>\n      \n  \n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-3\" aria-expanded=\"false\" aria-controls=\"tab-content-3\">\n\t  <span>            Universal Credit tickets\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-3\" aria-hidden=\"true\" aria-labelledby=\"tab-3\">\n              <ul type=\"disc\"><li><span>A limited number of £5 tickets are available to anyone in receipt of Universal Credit or some other benefits.</span></li><li><span>You can claim £5 tickets for up to five people per household.</span></li><li><span>Tickets are only available at least one day before your visit. If you can't find £5 tickets for the date you wish to book, this date is sold out but further dates are available.</span></li><li><span>Please see </span><a href=\"https://eur02.safelinks.protection.outlook.com/?url=https%3A%2F%2Fwww.sciencemuseum.org.uk%2Funiversal-credit-ticket-discounts&amp;data=05%7C02%7Cweb.team%40ScienceMuseum.ac.uk%7Ce73b15b150b7426fe2f308de6b014e51%7Ce967bcc0c07041c89f7e806069f6330b%7C1%7C0%7C639065850520292146%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=FeQByk0JKtQ5sXzmzC3uHaSi1VZ4bBimDEB24r8MfEU%3D&amp;reserved=0\" target=\"_blank\"><span>this page</span></a><span> for more details including which supporting documents are needed to show eligibility.</span></li></ul>\n      \n  \n</div>\n\n      \n                </section>\n    </div>\n  </div>\n</div>\n          \n<div class=\"o-body \">\n  <div class=\"o-container\">\n    <div class=\"o-content\">\n      <section class=\"c-wysiwyg  \">\n                \n                              <p>Be the first to hear when new films go on sale by signing up to our <a href=\"https://my.sciencemuseum.org.uk/account/create/brief\">email newsletters</a> today.</p>\n      \n              </section>\n    </div>\n  </div>\n</div>\n\n      \n    \n  </div>\n</article>\n              \n\n<section class=\"o-section -secondary\" aria-labelledby=\"a-other-imax-screenings\">\n    <div  class=\"slice view-mode-default o-container clearfix\">\n      <div class=\"o-container__padding\">\n                  <h2 id=\"a-other-imax-screenings\" class=\"o-title o-title--section\">            Other IMAX screenings\n      </h2>\n                                      <div class=\"slice view-mode-grid-4-column\">\n      <div class=\"js-carousel-teaser\" data-carousel-slidesPerView=\"1\"> \n  <div class=\"o-grid o-grid--4-col\">\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/under-sea-3d-u\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2017-08/UTS-3D_POSTER-BKGD.jpg?itok=B5xEL-FZ 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2017-08/UTS-3D_POSTER-BKGD.jpg?itok=B5xEL-FZ\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Under the Sea 3D (U)</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            IMAX screening\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Now showing\n      </span>\n                          <p>            Dive into this magical adventure and be transported below the ocean surface, into the unknown. Book early for cheaper prices.\n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/arctic-our-frozen-planet\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2026-02/FP2-2HPHH-JustinHofman_DC28538%20%281%29.jpg?h=9dd951d5&amp;itok=f3LU4K3s 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2026-02/FP2-2HPHH-JustinHofman_DC28538%20%281%29.jpg?h=9dd951d5&amp;itok=f3LU4K3s\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Arctic: Our Frozen Planet 3D (U) </span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            IMAX screening\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Now screening\n      </span>\n                          <p>            Join Benedict Cumberbatch as he explores the Arctic in an epic adventure across this magical realm of snow and ice.  \n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/ocean-odyssey-3d\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2024-04/AOO_EP01_07_.jpg?h=dd9cdf43&amp;itok=7ZVfc1lm 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2024-04/AOO_EP01_07_.jpg?h=dd9cdf43&amp;itok=7ZVfc1lm\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Ocean Odyssey 3D (U)</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            IMAX screening\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Now showing\n      </span>\n                          <p>            Embark on an extraordinary journey through Earth’s vast ocean highways with a baby humpback whale to uncover the secrets of ocean currents. Book early for cheaper prices.\n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/wild-asia-life-at-extremes\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2026-02/wild-asia-4%20%281%29.jpg?h=60873127&amp;itok=6RPrQllL 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2026-02/wild-asia-4%20%281%29.jpg?h=60873127&amp;itok=6RPrQllL\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Wild Asia: Life at Extremes 3D (U)</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            IMAX screening\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Now screening\n      </span>\n                          <p>            Embark on an epic journey across the wild lands of Asia, where breathtaking landscapes and extraordinary animals await around every corner.\n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n      </div>\n</div>\n\n  </div>\n\n      \n              </div>\n  </div>\n</section>\n      \n\n\n        </main>\n              </div>\n    </div>\n    \n    <footer>\n      <div class=\"c-back-to-top-panel | js-sticky-footer\">\n  <div class=\"o-container\">\n    <div class=\"c-back-to-top-panel__wrapper\">\n      <a href=\"#main-wrapper\" class=\"c-back-to-top-panel__link | js-back-top\">\n        <span>Back to Top</span>\n\n        <svg class=\"o-icon\" role=\"presentation\">\n          <use xlink:href=\"#arro