6/CT-19534.jpg\"\n            data-title=''\n            data-credit=\"\"\n            data-link=\"\"\n            data-link-text=\"\">\n                                  <img loading=\"lazy\" class=\"image-carousel\" srcset=\"/sites/default/files/styles/carousel/public/2026-06/CT-19534.jpg?itok=JMywwNS9 1x\" width=\"1050\" height=\"700\" src=\"/sites/default/files/styles/carousel/public/2026-06/CT-19534.jpg?itok=JMywwNS9\" alt=\"\" />\n\n\n\n      \n\n      \n      <figcaption class=\"c-media__caption\">\n        \n        <cite></cite>\n      </figcaption>\n    </figure>\n  </div>\n</div>\n\n          \n\n\n<div class=\"swiper-slide\">\n  <div class=\"c-media\">\n    <figure class=\"c-media__figure\"\n            data-large-image-width=\"1600\"\n            data-large-image-height=\"1067\"\n            data-large-image-url=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/smg_carousel_zoom/public/2026-06/CT-38345CC_MSG.jpg\"\n            data-title=''\n            data-credit=\"\"\n            data-link=\"\"\n            data-link-text=\"\">\n                                  <img loading=\"lazy\" class=\"image-carousel\" srcset=\"/sites/default/files/styles/carousel/public/2026-06/CT-38345CC_MSG.jpg?itok=87T1JbuW 1x\" width=\"1050\" height=\"700\" src=\"/sites/default/files/styles/carousel/public/2026-06/CT-38345CC_MSG.jpg?itok=87T1JbuW\" alt=\"\" />\n\n\n\n      \n\n      \n      <figcaption class=\"c-media__caption\">\n        \n        <cite></cite>\n      </figcaption>\n    </figure>\n  </div>\n</div>\n\n      \n            </div>\n        </div>\n      </div>\n      </div>\n</section>\n\n            \n\n<section class=\"o-section -secondary\" aria-labelledby=\"a-other-things-to-see-and-do\">\n    <div  class=\"slice view-mode-default o-container clearfix\">\n      <div class=\"o-container__padding\">\n                  <h2 id=\"a-other-things-to-see-and-do\" class=\"o-title o-title--section\">            Other things to see and do\n      </h2>\n                                      <div class=\"slice view-mode-thirds-3-column\">\n      <div class=\"js-carousel-teaser\" data-carousel-slidesPerView=\"1\"> \n  <div class=\"o-grid o-grid--3-col\">\n          <div class=\"o-grid__item\"><article class=\"c-card -feature\">\n  <a href=\"/see-and-do/welcome\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2017-09/wonderlab-learning-2000x1000.jpg?h=c9a3a702&amp;itok=K1NGItW5 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2017-09/wonderlab-learning-2000x1000.jpg?h=c9a3a702&amp;itok=K1NGItW5\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Welcome </span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Museum admission\n      \n      </div>\n            <div class=\"c-card__desc\">\n                          <p>            Book your free Science Museum admission tickets now and find answers to frequently asked questions.\n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/star-trek-60\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2026-02/ST6_TUC_Still_KS_ILM-1.jpg?h=03f5e3be&amp;itok=pdj2X9IY 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2026-02/ST6_TUC_Still_KS_ILM-1.jpg?h=03f5e3be&amp;itok=pdj2X9IY\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Star Trek at 60 </span>\n\n      </h3>\n            <div class=\"c-card__desc\">\n                          <p>            Boldly go where no one has gone before with our special season celebrating the 60th anniversary of Star Trek.\n      </p>\n                      </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/power-evening-session\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2025-08/001%20%286%29.jpeg?h=eed674a8&amp;itok=MV5NbbGF 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2025-08/001%20%286%29.jpeg?h=eed674a8&amp;itok=MV5NbbGF\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Power Up evening session</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Event\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Dates vary\n      </span>\n                          <p>            Our popular sell-out adults-only Power Up evening sessions return in 2026 with more dates. \n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n      </div>\n</div>\n  </div>\n\n      \n              </div>\n  </div>\n</section>\n      \n    \n  </div>\n</article>\n\n\n\n        </main>\n              </div>\n    </div>\n    \n    <footer>\n      <div class=\"c-back-to-top-panel | js-sticky-footer\">\n  <div class=\"o-container\">\n    <div class=\"c-back-to-top-panel__wrapper\">\n      <a href=\"#main-wrapper\" class=\"c-back-to-top-panel__link | js-back-top\">\n        <span>Back to Top</span>\n\n        <svg class=\"o-icon\" role=\"presentation\">\n          <use xlink:href=\"#arrow-bold-right\"></use>\n        </svg>\n      </a>\n    </div>\n  </div>\n</div>\n      <div class=\"c-footer\">\n                  <div class=\"o-container\">\n            <div class=\"c-footer__padding\">\n              <div class=\"c-footer__section c-footer__section--second clearfix\">\n                      <div class=\"c-footer__block -column\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Location</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <span>Exhibition Road, South Kensington, London, SW7 2DD</span>\n                  </li>\n              <li>\n          <a href=\"http://www.discoversouthken.com/\" rel=\"noopener noreferrer\">Discover South Kensington</a>\n                  </li>\n            </ul>\n  \n                  </li>\n            </ul>\n  \n\n  </div><div class=\"c-footer__block -column\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Opening times</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <a href=\"/visit\" data-drupal-link-system-path=\"node/2746\">Open daily 10.00–18.00 (except for 24-26 December)</a>\n                  </li>\n            </ul>\n  \n                  </li>\n            </ul>\n  \n\n  </div><div class=\"c-footer__block -column -social\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Newsletter</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <a href=\"https://my.sciencemuseum.org.uk/account/create/brief\" rel=\"noopener noreferrer\">Sign up</a>\n      