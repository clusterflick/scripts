ass=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/become-patron\" data-drupal-link-system-path=\"node/2701\">Become a Patron</a>\n                      </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/corporate-partnerships\" data-drupal-link-system-path=\"node/2749\">Corporate partnerships</a>\n                      </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/gifts-in-wills\" data-drupal-link-system-path=\"node/2710\">Leave a gift in your will</a>\n                      </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/support-us-major-gift\" data-drupal-link-system-path=\"node/2707\">Support us with a major gift</a>\n                      </li>\n        </ul>\n      \n              </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"https://shop.sciencemuseum.org.uk/  \" rel=\"noopener noreferrer\">Shop</a>\n                      </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"https://wonderlabplus.sciencemuseumgroup.org.uk/\" rel=\"noopener noreferrer\">Wonderlab+</a>\n                      </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"https://blog.sciencemuseum.org.uk/\" rel=\"noopener noreferrer\">Blog</a>\n                      </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"https://my.sciencemuseum.org.uk/account/create/brief\" rel=\"noopener noreferrer\">Newsletter</a>\n                      </li>\n        </ul>\n          </div>\n    </div>\n      \n\n  </div>\n<div id=\"block-openinghoursblock\" class=\"c-secondary-nav__block -bg-white\">\n  \n    \n            <p class=\"o-menu\">\n                  Free entry<br>\n                 Open daily, 10.00–18.00 \n      </p>\n        <p class=\"o-menu -fade\">\n              Science Museum<br>\n                          Exhibition Road<br>\n                  London SW7 2DD\n    </p>\n    <a class=\"o-menu\" href=\"https://www.google.co.uk/maps/dir//Science+Museum,+Exhibition+Rd,+Kensington,+London+SW7+2DD\" rel=\"noreferrer\">\n      View on Google Maps\n  </a>\n    \n  </div>\n\n  </div>\n  </div>\n          </div>\n        </div>\n      </div>\n                <div class=\"o-message\">\n  <div class=\"o-container\">\n                                  <p><a href=\"https://tickets.sciencemuseum.org.uk/\">Book your free general admission tickets to visit the Science Museum here</a>. Schools and groups can <a href=\"/groups\" data-entity-type=\"node\" data-entity-uuid=\"ccd38c13-451c-401f-b91b-e95cafc5737e\" data-entity-substitution=\"canonical\">book free general admission tickets here</a>.</p>\n\n      \n      \n      </div>\n</div>\n\n\n            <div class=\"o-mobile-menu\">\n      <nav  id=\"block-menunavigation-science-mobile\" class=\"o-list c-menu-mobile\" aria-label=\"Mobile navigation\">\n        \n            <div class=\"c-menu-drilldown -mobile\">\n      <div class=\"c-menu-drilldown__container\">\n      <ul class=\"o-list c-menu-drilldown__root\">\n              \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Visit</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/visit\" data-drupal-link-system-path=\"node/2746\">Visit</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/visit/food-and-drink\" title=\"Food and drink\" data-drupal-link-system-path=\"node/2674\">Food and drink</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/visit/accessibility\" data-drupal-link-system-path=\"node/2677\">Accessibility</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/see-and-do\" data-drupal-link-system-path=\"node/2926\">See and do</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/objects-and-stories\" data-drupal-link-system-path=\"node/2932\">Objects and stories</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Groups</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/groups\" data-drupal-link-system-path=\"node/2923\">Groups</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item menu-item--collapsed\">\n                  <a href=\"/groups/formal-education-groups\" data-drupal-link-system-path=\"node/2938\">Formal education groups</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/groups/other-groups\" data-drupal-link-system-path=\"node/12503\">Other Groups</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/groups/home-educating-visit\" data-drupal-link-system-path=\"node/10004\">Home Educators</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/groups/community-partnerships\" data-drupal-link-system-path=\"node/15125\">Community partnerships</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/groups/groups-faqs\" data-drupal-link-system-path=\"node/12505\">FAQs for groups</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://learning.sciencemuseumgroup.org.uk/\" rel=\"noopener noreferrer\">Learning resources</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item menu-item--collapsed\">\n                  <a href=\"/groups/teacher-cpd-and-events\" data-drupal-link-system-path=\"node/2935\">Educator CPD and events</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/travel-trade\" data-drupal-link-system-path=\"node/14719\">Travel Trade</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Researchers</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/researchers\" data-drupal-link-system-path=\"node/3784\">Researchers</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Dana Research Centre and Library</button>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/researchers/research-events\" data-drupal-link-system-path=\"node/6982\">Research Events</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"http://journal.sciencemuseum.ac.uk\" rel=\"noopener noreferrer\">Science Museum Group Journal</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">About us</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us\" data-drupal-link-system-path=\"node/2929\">About us</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/press-office\" data-drupal-link-system-path=\"node/2944\">Press office</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://www.hirethesciencemuseum.com/\" rel=\"noopener noreferrer\">Venue hire</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://www.sciencemuseumgroup.org.uk/work-with-us\" rel=\"noopener noreferrer\">Jobs</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/volunteering-science-museum\" data-drupal-link-system-path=\"node/2728\">Volunteering</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/contact-us\" data-drupal-link-system-path=\"node/2731\">Contact us</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Support us</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us\" data-drupal-link-system-path=\"node/3790\">Support us</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/donate-today\" data-drupal-link-system-path=\"node/15373\">Donate today</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/adopt-an-object\" data-drupal-link-system-path=\"node/12757\">Adopt an object</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/become-patron\" data-drupal-link-system-path=\"node/2701\">Become a Patron</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/corporate-partnerships\" data-drupal-link-system-path=\"node/2749\">Corporate partnerships</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/gifts-in-wills\" data-drupal-link-system-path=\"node/2710\">Leave a gift in your will</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us/support-us-major-gift\" data-drupal-link-system-path=\"node/2707\">Support us with a major gift</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://shop.sciencemuseum.org.uk/  \" rel=\"noopener noreferrer\">Shop</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://wonderlabplus.sciencemuseumgroup.org.uk/\" rel=\"noopener noreferrer\">Wonderlab+</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://blog.sciencemuseum.org.uk/\" rel=\"noopener noreferrer\">Blog</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://my.sciencemuseum.org.uk/account/create/brief\" rel=\"noopener noreferrer\">Newsletter</a>\n                      </li>\n    \n          <li>\n        <div class=\"site-search-form c-search-mob\" data-drupal-selector=\"site-search-form-2\" id=\"block-sitesearchform-mobile\">\n  \n  <div class=\"c-search-mob__form\">\n    \n        \n        <form autocomplete=\"off\" block=\"block-sitesearchform-mobile\" action=\"/see-and-do/beautiful-planet-3d-u\" method=\"post\" id=\"site-search-form-mobile\" accept-charset=\"UTF-8\">\n  <div class=\"js-form-item form-item form-type-search js-form-type-search form-item-term js-form-item-term\">\n      <label for=\"edit-term-mobile\">\n    Search the site\n\n      </label>\n        <input data-drupal-selector=\"edit-term\" data-msg-maxlength=\"Search the site field has a maximum length of 128.\" type=\"search\" id=\"edit-term-mobile\" name=\"term\" value=\"\" size=\"60\" maxlength=\"128\" class=\"form-search\" />\n\n        </div>\n<input data-drupal-selector=\"form-rmpnjrtqy9xkvhtbyg8ggw0dlaspuip-7utyz61mbga\" type=\"hidden\" name=\"form_build_id\" value=\"form-rMPNJRtQy9XKVhTbYg8Ggw0dlASPuIP_7UTyz61MBgA\" />\n<input data-drupal-selector=\"edit-site-search-form-2\" type=\"hidden\" name=\"form_id\" value=\"site_search_form\" />\n<div data-drupal-selector=\"edit-actions\" class=\"form-actions js-form-wrapper form-wrapper\" id=\"edit-actions-mobile\">\n\n<button  data-drupal-selector=\"site-search-form-button\" type=\"submit\" id=\"site-search-form-button-mobile\" name=\"op\" value=\"Submit\" class=\"button js-form-submit form-submit btn btn--primary\">\n  Submit\n  <svg class=\"o-icon btn__icon\" role=\"presentation\">\n    <use xlink:href=\"#arrow-bold-right\"></use>\n  </svg>\n</button></div>\n\n</form>\n\n      </div>\n\n</div>\n\n      </li>\n        </ul>\n          </div>\n    </div>\n      \n\n  </nav>\n  </div>\n    </header>\n        <div id=\"main-wrapper\" class=\"o-main-wrapper clearfix\">\n      <div id=\"main\" class=\"clearfix\">\n        \n        <main id=\"main-content\" tabindex=\"-1\">\n                            \n\n<div data-drupal-messages-fallback class=\"hidden\"></div>\n\n\n                              \n                      <article class=\"h-relative\">\n  \n      \n<div class=\"h-relative\">\n  <header class=\"c-banner-deep c-banner-deep--event | js-banner\">\n    \n    <div class=\"c-banner-deep__bg -has-overlay\">\n            <div class=\"c-banner-deep__img-wrapper\">\n        <div class=\"c-banner-deep__img\" style=\"background-image: url('https://www.sciencemuseum.org.uk/sites/default/files/styles/her/public/2020-11/A-Beautiful-Planet.jpg?h=3cf665d7&amp;itok=vQ0PKoAS')\"></div>\n      </div>\n                  <div class=\"c-banner-deep__content | o-container\">\n        <div class=\"c-banner-deep__content__wrapper\">\n          <div class=\"c-breadcrumb  | js-breadcrumb\">\n                <span class=\"visually-hidden\">You are here:</span>\n    <ol class=\"o-list c-breadcrumb__links\">\n    \n          <li>\n                  <a href=\"/\">\n                          <svg class=\"o-icon c-breadcrumb__divider-icon\" role=\"presentation\">\n                <use xlink:href=\"#arrow-bold-right\"></use>\n              </svg>\n                        Home\n          </a>\n              </li>\n          <li>\n                  <a href=\"/see-and-do\">\n                        See and do\n          </a>\n              </li>\n        </ol>\n\n          </div>\n          <div class=\"c-banner-deep__title__wrapper\">\n\n                        <h1 class=\"visually-hidden\" ><span class=\"h-relative\">A Beautiful Planet 3D (U)</span>\n</h1>\n\n            <div aria-hidden=\"true\" class=\"c-banner-deep__title | o-title o-title--primary\">\n              <span  class=\"js-cascade\"><span class=\"h-relative\">A Beautiful Planet 3D (U)</span>\n</span>\n            </div>\n          </div>\n                  </div>\n      </div>\n    </div>\n      </header>\n</div>\n  \n    <div class=\"o-main-content | js-sticky-container\">\n    <!-- Body content -->\n    <div class=\"o-body -first\">\n      <div class=\"o-container u-order\">\n        <div class=\"o-content u-order-body\">\n          <div class=\"c-wysiwyg\">\n              <div class=\"o-text-introduction\">\n                            <p>Narrated by Jennifer Lawrence, <em>A Beautiful Planet 3D</em> provides a unique vantage point to witness humanity’s impact on the world.&nbsp;&nbsp;</p>\n\n      \n              </div>\n                          <p>Meet the crew on board the International Space Station as they capture stunning footage of our magnificent blue planet to deepen our connection to the place we all call home.&nbsp;&nbsp;</p><p><span class=\"NormalTextRun SCXW95327635 BCX0\">Experience our planet from 400 km above Earth, through breathtaking footage captured by astronauts aboard the International Space Station and presented on one of the UK's biggest IMAX screens.&nbsp;</span></p><div class=\"embedded-entity\"><div>\n                  <div class=\"video-embed-field-provider-youtube video-embed-field-responsive-video\"><iframe width=\"854\" height=\"480\" frameborder=\"0\" src=\"https://www.youtube.com/embed/WzbHi7Lbz00?autoplay=0&amp;start=0&amp;rel=0\"></iframe>\n</div>\n\n      \n  </div>\n</div><p><span class=\"TextRun SCXW145883483 BCX0 NormalTextRun\" lang=\"EN-GB\">As part of the Government's Great British Summer Savings scheme, our children's and family tickets are discounted this summer—so now is a great time to plan your visit.</span><span class=\"EOP Selected SCXW145883483 BCX0\">&nbsp;</span></p>\n      \n          </div>\n        </div>\n        <div class=\"o-sidebar-wrapper-fixed  u-order-sidebar | js-sticky-sidebar\" data-sidebar-spacer=\"false\">\n          <div class=\"o-container\">\n            <div class=\"o-sidebar\">\n              <div>\n                <h2 class=\"visually-hidden\">Information</h2>\n                \n\n\n<div class=\"c-info-block c-info-block--primary\">\n  <ul class=\"c-info-block__list o-list\">\n        <li class=\"o-title o-title--tertiary c-info-block__title -first\">\n                  IMAX screening\n      \n    </li>\n        <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                  <li><span class=\"o-label\">Date:</span>             Now showing\n      </li>\n                                  <li><span class=\"o-label\">Duration:</span>             60 minutes including adverts \n      </li>\n                          <li><span class=\"o-label\">Price:</span>             Prices vary so book ahead of your visit for cheaper tickets this summer. Family discounts apply. Ages 3 and under go free. No booking fees apply.\n      </li>\n                          <li><span class=\"o-label\">Location:</span> IMAX: The Ronson Theatre\n      <span class=\"separator\">, </span>\n  Level 0</li>\n                <!-- Age and Height Restrictions -->\n                          <li><span class=\"o-label\">Age:</span>             Certified U and suitable for all ages. Children under 12 must be accompanied by an adult. \n      </li>\n                <!-- Festival \"parents\" -->\n              </ul>\n    </li>\n            <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                <li>\n          <a href=\"https://tickets.sciencemuseum.org.uk/\" class=\"btn btn--primary -on-black\">\n            Book now\n            <svg class=\"o-icon btn__icon\" role=\"presentation\">\n              <use xlink:href=\"#arrow-bold-right\"></use>\n            </svg>\n          </a>\n        </li>\n                      </ul>\n    </li>\n                              <li class=\"visually-hidden\">            groups\n      </li>\n  <li class=\"c-info-block__section\">            <p><a href=\"/groups/beautiful-planet-3d-u-school-info\" target=\"_blank\" data-entity-type=\"node\" data-entity-uuid=\"5ec60fe2-a09b-4e71-89bc-bed689b33453\" data-entity-substitution=\"canonical\">A Beautiful Planet 3D for education groups</a></p>\n      </li>\n\n      \n    \n  </ul>\n</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n                    <div class=\"o-body\">\n    <div class=\"o-container\">\n    <div class=\"o-content\">\n      <div class=\"c-carousel-quote | js-carousel-quote\">\n        <div class=\"swiper-container\">\n          <div class=\"swiper-wrapper\">\n                        <div class=\"swiper-slide\">\n\t<blockquote class=\"c-quote\">\n\t  <p class=\"c-quote__content\">            You can’t help but be wowed by the imagery here, made all the more impressive by the large format and 3D. It’s thoughtful escapism for adults; it’s essential viewing for kids.\n      </p>\n\t  <footer class=\"c-quote__cite\">            Time Out \n      </footer>\n\t</blockquote>\n</div>\n          <div class=\"swiper-slide\">\n\t<blockquote class=\"c-quote\">\n\t  <p class=\"c-quote__content\">            The result is the best kind of spectacle: that which encourages us to look up and beyond ourselves—and does so using only organic special effects. \n      </p>\n\t  <footer class=\"c-quote__cite\">            The Guardian \n      </footer>\n\t</blockquote>\n</div>\n          <div class=\"swiper-slide\">\n\t<blockquote class=\"c-quote\">\n\t  <p class=\"c-quote__content\">            It’s appealing to adults and accessible to younger viewers. And it delivers an environmental message that is strong and serious while remaining encouraging and optimistic. \n      </p>\n\t  <footer class=\"c-quote__cite\">            New York Times\n      </footer>\n\t</blockquote>\n</div>\n      \n          </div>\n          <div class=\"swiper-pagination\"></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n          \n<div class=\"o-body\">\n  <div class=\"o-container\">\n    <div class=\"o-content\">\n      <section class=\"slice view-mode-default c-accordion clearfix | js-accordion\" >\n              \n        <h2  class=\"c-accordion__section-title\">            Ticket information\n      </h2>\n                                  <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-1\" aria-expanded=\"false\" aria-controls=\"tab-content-1\">\n\t  <span>            Save 50% on tickets\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-1\" aria-hidden=\"true\" aria-labelledby=\"tab-1\">\n              <p>When you buy a <em>Wonderlab</em> or <em>Power Up</em> ticket for a specific date, you can get 50% off an <span class=\"mark3clwislmc\">IMAX</span> documentary showing on the same day. The discount will be applied automatically in the basket when you add <span class=\"mark3clwislmc\">IMAX</span> tickets to the same order.</p>\n      \n  \n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-2\" aria-expanded=\"false\" aria-controls=\"tab-content-2\">\n\t  <span>            Book early to get cheaper ticket prices\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-2\" aria-hidden=\"true\" aria-labelledby=\"tab-2\">\n              <div class=\"ewa-rteLine\">As part of the Government's Great British Summer Savings scheme, our children's and family tickets for IMAX screenings are discounted this summer. Book ahead of your visit to get cheaper ticket prices.</div><div class=\"ewa-rteLine\">&nbsp;</div><div class=\"ewa-rteLine\">Save even more on tickets for earlier and later screenings each day when you book at least a day before your visit.&nbsp;</div><p>Find out more in our <a class=\"Hyperlink SCXW243924447 BCX0\" href=\"https://www.sciencemuseum.org.uk/ticket-prices-faqs\" target=\"_blank\">FAQs</a>.</p>\n      \n  \n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-3\" aria-expanded=\"false\" aria-controls=\"tab-content-3\">\n\t  <span>            Universal Credit tickets\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-3\" aria-hidden=\"true\" aria-labelledby=\"tab-3\">\n              <ul><li>A limited number of discounted IMAX tickets are available to anyone in receipt of Universal Credit or some other benefits.</li><li>As part of the Government's Great British Summer Savings scheme, our children's Universal Credit tickets are discounted this summer at £4.30 per child.</li><li>Adult IMAX Universal Credit tickets are £5 per adult.</li><li>You can claim for up to five people per household.</li><li>Tickets are only available at least one day before your visit. If you can't find Universal Credit tickets for the date you wish to book, this date is sold out but further dates are available.</li><li>Please see <a class=\"Hyperlink SCXW68505022 BCX0\" href=\"https://www.sciencemuseum.org.uk/universal-credit-ticket-discounts\" target=\"_blank\">this page</a> for more details including which supporting documents are needed to show eligibility.</li></ul>\n      \n  \n</div>\n\n      \n                </section>\n    </div>\n  </div>\n</div>\n      \n    \n  </div>\n</article>\n              \n\n<section class=\"o-section -secondary\" aria-labelledby=\"a-other-imax-screenings\">\n    <div  class=\"slice view-mode-default o-container clearfix\">\n      <div class=\"o-container__padding\">\n                  <h2 id=\"a-other-imax-screenings\" class=\"o-title o-title--section\">            Other IMAX screenings\n      </h2>\n                                      <div class=\"slice view-mode-thirds-3-column\">\n      <div class=\"js-carousel-teaser\" data-carousel-slidesPerView=\"1\"> \n  <div class=\"o-grid o-grid--3-col\">\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/under-sea-3d-u\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2017-08/UTS-3D_POSTER-BKGD.jpg?itok=B5xEL-FZ 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2017-08/UTS-3D_POSTER-BKGD.jpg?itok=B5xEL-FZ\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Under the Sea 3D (U)</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            IMAX screening\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Now showing\n      </span>\n                          <p>            Dive into this magical adventure and be transported below the ocean surface, into the unknown. Book ahead of your visit for cheaper prices.\n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/arctic-our-frozen-planet\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2026-02/FP2-2HPHH-JustinHofman_DC28538%20%281%29.jpg?h=9dd951d5&amp;itok=f3LU4K3s 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2026-02/FP2-2HPHH-JustinHofman_DC28538%20%281%29.jpg?h=9dd951d5&amp;itok=f3LU4K3s\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Arctic: Our Frozen Planet 3D (U) </span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            IMAX screening\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Now showing\n      </span>\n                          <p>            Join Benedict Cumberbatch as he explores the Arctic in an epic adventure across this magical realm of snow and ice. Book ahead of your visit for cheaper prices.\n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/antarctica-3d\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2020-11/antartica-imax.jpg?h=47f41414&amp;itok=Eea0ZkIz 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2020-11/antartica-imax.jpg?h=47f41414&amp;itok=Eea0ZkIz\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Antarctica 3D (U)</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            IMAX screening\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Now showing\n      </span>\n                          <p>            Explore the mysterious and wild plains of Antarctica and meet the creatures that thrive in the coldest and windiest place on the planet. Book ahead of your visit for cheaper prices.\n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n      </div>\n</div>\n  </div>\n\n          <div class=\"slice view-mode-thirds-3-column\">\n      <div class=\"js-carousel-teaser\" data-carousel-slidesPerView=\"1\"> \n  <div class=\"o-grid o-grid--3-col\">\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/wild-asia-life-at-extremes\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2026-02/wild-asia-4%20%281%29.jpg?h=42dd0ea9&amp;itok=6RPrQllL 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2026-02/wild-asia-4%20%281%29.jpg?h=42dd0ea9&amp;itok=6RPrQllL\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Wild Asia: Life at Extremes 3D (U)</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            IMAX screening\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Now showing\n      </span>\n                          <p>            Embark on an epic journey across the wild lands of Asia, where breathtaking landscapes and extraordinary animals await around every corner. Book ahead of your visit for cheaper prices.\n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/t-rex-3d-pg\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2024-12/Adult%20Rex%20Sunset%20Burst.jpg?h=c3d4457c&amp;itok=bA1ZUD3H 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2024-12/Adult%20Rex%20Sunset%20Burst.jpg?h=c3d4457c&amp;itok=bA1ZUD3H\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">T. rex 3D (PG)</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            IMAX screening\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Now showing\n      </span>\n                          <p>            Witness the wonder years of the T.rex and learn how science contributed to the understanding of these legendary dinosaurs. Book ahead of your visit for cheaper prices.\n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n      </div>\n</div>\n  </div>\n\n      \n              </div>\n  </div>\n</section>\n      \n\n\n        </main>\n              </div>\n    </div>\n    \n    <footer>\n      <div class=\"c-back-to-top-panel | js-sticky-footer\">\n  <div class=\"o-container\">\n    <div class=\"c-back-to-top-panel__wrapper\">\n      <a href=\"#main-wrapper\" class=\"c-back-to-top-panel__link | js-back-top\">\n        <span>Back to Top</span>\n\n        <svg class=\"o-icon\" role=\"presentation\">\n          <use xlink:href=\"#arrow-bold-right\"></use>\n        </svg>\n      </a>\n    </div>\n  </div>\n</div>\n      <div class=\"c-footer\">\n                  <div class=\"o-container\">\n            <div class=\"c-footer__padding\">\n              <div class=\"c-footer__section c-footer__section--second clearfix\">\n                      <div class=\"c-footer__block -column\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Location</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <span>Exhibition Road, South Kensington, London, SW7 2DD</span>\n                  </li>\n              <li>\n          <a href=\"http://www.discoversouthken.com/\" rel=\"noopener noreferrer\">Discover South Kensington</a>\n                  </li>\n            </ul>\n  \n                  </li>\n            </ul>\n  \n\n  </div><div class=\"c-footer__block -column\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Opening times</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <a href=\"/visit\" data-drupal-link-system-path=\"node/2746\">Open daily 10.00–18.00 (except for 24-26 December)</a>\n                  </li>\n            </ul>\n  \n                  </li>\n            </ul>\n  \n\n  </div><div class=\"c-footer__block -column -social\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Newsletter</span>\n        