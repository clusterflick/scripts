3-451c-401f-b91b-e95cafc5737e\" data-entity-substitution=\"canonical\">book free general admission tickets here</a>.</p>\n<p>&nbsp;</p>\n\n      \n      \n      </div>\n</div>\n\n\n            <div class=\"o-mobile-menu\">\n      <nav  id=\"block-menunavigation-science-mobile\" class=\"o-list c-menu-mobile\" aria-label=\"Mobile navigation\">\n        \n            <div class=\"c-menu-drilldown -mobile\">\n      <div class=\"c-menu-drilldown__container\">\n      <ul class=\"o-list c-menu-drilldown__root\">\n              \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Visit</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/visit\" data-drupal-link-system-path=\"node/2746\">Visit</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/visit/food-and-drink\" title=\"Food and drink\" data-drupal-link-system-path=\"node/2674\">Food and drink</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/visit/accessibility\" data-drupal-link-system-path=\"node/2677\">Accessibility</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/see-and-do\" data-drupal-link-system-path=\"node/2926\">See and do</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/objects-and-stories\" data-drupal-link-system-path=\"node/2932\">Objects and stories</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n             