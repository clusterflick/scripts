            "text": "<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\" prefix=\"og: https://ogp.me/ns#\" class=\"t-default\">\n  <head>\n    <!-- Google Tag Manager -->\n    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\n        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\n        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n      })(window,document,'script','dataLayer','GTM-MBLN5VC2');</script>\n    <!-- End Google Tag Manager -->\n    <meta charset=\"utf-8\" />\n<meta name=\"description\" content=\"Narrated by Jim Carrey, Under the Sea in IMAX 3D will leap off the screen and take you on a fascinating journey to discover the mysteries of the ocean floor.\" />\n<meta name=\"referrer\" content=\"origin-when-cross-origin\" />\n<meta property=\"og:site_name\" content=\"Science Museum\" />\n<meta property=\"og:url\" content=\"https://www.sciencemuseum.org.uk/see-and-do/under-sea-3d-u\" />\n<meta property=\"og:title\" content=\"Under the Sea 3D (U) | Science Museum\" />\n<meta property=\"og:description\" content=\"Dive into this magical adventure and be transported below the ocean surface, into the unknown. Book early for cheaper prices.\" />\n<meta property=\"og:image\" content=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/social_facebook/public/2017-08/UTS-3D_POSTER-BKGD.jpg?itok=OxoYbhMM\" />\n<meta property=\"og:image\" content=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/social_facebook/public/2017-08/UTS-3D_POSTER-BKGD.jpg?itok=OxoYbhMM\" />\n<meta property=\"og:image:url\" content=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/social_facebook/public/2017-08/UTS-3D_POSTER-BKGD.jpg?itok=OxoYbhMM\" />\n<meta property=\"og:image:url\" content=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/social_facebook/public/2017-08/UTS-3D_POSTER-BKGD.jpg?i