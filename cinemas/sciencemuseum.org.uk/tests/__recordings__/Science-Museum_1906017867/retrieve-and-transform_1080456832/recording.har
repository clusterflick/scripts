                 <div class=\"pswp__preloader__icn\">\n                      <div class=\"pswp__preloader__cut\">\n                        <div class=\"pswp__preloader__donut\"></div>\n                      </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"pswp__share-modal pswp__share-modal--hidden pswp__single-tap\">\n                <div class=\"pswp__share-tooltip\"></div>\n            </div>\n\n            <button class=\"pswp__button pswp__button--arrow--left\" title=\"Previous (arrow left)\">\n            </button>\n\n            <button class=\"pswp__button pswp__button--arrow--right\" title=\"Next (arrow right)\">\n            </button>\n\n            <div class=\"pswp__caption\">\n                <div class=\"pswp__caption__center\"></div>\n            </div>\n\n            <div class=\"pswp__link\"><a href=\"#\">View more details on collections site</a></div>\n\n        </div>\n\n    </div>\n\n</div>\n    \n      <div class=\"dialog-off-canvas-main-canvas\" data-off-canvas-main-canvas>\n    <div class=\"o-page-wrapper\">\n  <div class=\"o-page\">\n        <noscript>\n      <div class=\"o-container\">\n        <div class=\"o-container__wrapper\">\n          <p class=\"alert\">Javascript is disabled</p>\n        </div>\n      </div>\n    </noscript>\n\n    <header class=\"c-masthead\" aria-label=\"Science Museum main navigation and branding\">\n      <div class=\"o-container\">\n        <div class=\"c-masthead__wrapper\">\n          <a href=\"/\" class=\"c-masthead__logo -science\">\n            <img src=\"/themes/smg/dist/img/svg/logo/masthead-sml-logo.svg\" alt=\"Science Museum\">\n          </a>\n          <div class=\"c-masthead__actions\">\n            \n            <div class=\"c-masthead__cta-wrapper\">\n                  <div class=\"c-masthead__cta\">\n          <a href=\"https://www.sciencemuseum.org.uk/about-us/support-us\" class=\"c-masthead__cta-donate\">Support us</a>\n              <a h