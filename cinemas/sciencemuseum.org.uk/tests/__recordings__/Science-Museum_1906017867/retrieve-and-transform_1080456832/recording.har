              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://shop.sciencemuseum.org.uk/  \" rel=\"noopener noreferrer\">Shop</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://wonderlabplus.sciencemuseumgroup.org.uk/\" rel=\"noopener noreferrer\">Wonderlab+</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://blog.sciencemuseum.org.uk/\" rel=\"noopener noreferrer\">Blog</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://my.sciencemuseum.org.uk/account/create/brief\" rel=\"noopener noreferrer\">Newsletter</a>\n                      </li>\n    \n          <li>\n        <div class=\"site-search-form c-search-mob\" data-drupal-selector=\"site-search-form-2\" id=\"block-sitesearchform-mobile\">\n  \n  <div class=\"c-search-mob__form\">\n    \n        \n        <form autocomplete=\"off\" block=\"block-sitesearchform-mobile\" action=\"/see-and-do/oppenheimer\" method=\"post\" id=\"site-search-form-mobile\" accept-charset=\"UTF-8\">\n  <div class=\"js-form-item form-item form-type-search js-form-type-search form-item-term js-form-item-term\">\n      <label for=\"edit-term-mobile\">\n    Search the site\n\n      </label>\n        <input data-drupal-selector=\"edit-term\" data-msg-maxlength=\"Search the site field has a maximum length of 128.\" type=\"search\" id=\"edit-term-mobile\" name=\"term\" value=\"\" size=\"60\" maxlength=\"128\" class=\"form-search\" />\n\n        </div>\n<input data-drupal-selector=\"form-npftno0-mnbns-nuhb3jitwvzesh5zocvydycskvvsy\" type=\"hidden\" name=\"form_build_id\" value=\"form-NpFtno0_mnBNs-NuhB3jItwvzesh5ZoCvyDycSKVVsY\" />\n<input data-drupal-selector=\"edit-site-search-form-2\" type=\"hidden\" name=\"form_id\" value=\"site_search_form\" />\n<div data-drupal-selector=\"edit-actions\" class=\"form-actions js-form-wrapper form-wrapper\" id=\"edit-actions-mobile\">\n\n<button  data-drupal-selector=\"site-search-form-button\" type=\"submit\" id=\"site-search-form-button-mobile\" name=\"op\" value=\"Submit\" class=\"button js-form-submit form-submit btn btn--primary\">\n  Submit\n  <svg class=\"o-icon btn__icon\" role=\"presentation\">\n    <use xlink:href=\"#arrow-bold-right\"></use>\n  </svg>\n</button></div>\n\n</form>\n\n      </div>\n\n</div>\n\n      </li>\n        </ul>\n          </div>\n    </div>\n      \n\n  </nav>\n  </div>\n    </header>\n        <div id=\"main-wrapper\" class=\"o-main-wrapper clearfix\">\n      <div id=\"main\" class=\"clearfix\">\n        \n        <main id=\"main-content\" tabindex=\"-1\">\n                            \n\n<div data-drupal-messages-fallback class=\"hidden\"></div>\n\n\n                              \n                      <article class=\"h-relative\">\n  \n  \n<div class=\"h-relative\">\n  <div class=\"c-banner-medium c-banner-medium--media\">\n    \n  \n    \n    <div class=\"c-banner-medium__element c-banner-medium__element--color\" style=\"background:#333333\">\n      <div class=\"c-banner-medium__column\" style=\"color:#333333\">\n        <img src=\"https://www.sciencemuseum.org.uk/sites/default/files/styles/her/public/2025-08/oppenheimer.jpeg?h=7628e202&amp;itok=Mztv59vr\" class=\"c-banner-medium__img\" alt=\"\"/>\n      </div>\n    </div>\n    <div class=\"c-banner-medium__overlay\">\n      <div class=\"c-banner-medium__container | o-container\">\n        <div class=\"c-breadcrumb  | js-breadcrumb\">\n              <span class=\"visually-hidden\">You are here:</span>\n    <ol class=\"o-list c-breadcrumb__links\">\n    \n          <li>\n                  <a href=\"/\">\n                          <svg class=\"o-icon c-breadcrumb__divider-icon\" role=\"presentation\">\n                <use xlink:href=\"#arrow-bold-right\"></use>\n              </svg>\n                        Home\n          </a>\n              </li>\n          <li>\n                  <a href=\"/see-and-do\">\n                        See and do\n          </a>\n              </li>\n        </ol>\n\n        </div>\n\n                <h1 class=\"visually-hidden\"><span class=\"h-relative\">Oppenheimer (15) - 70mm</span>\n</h1>\n\n        <div aria-hidden=\"true\" class=\"c-banner-medium__title | o-title o-title--primary\">\n          <span class=\"js-cascade\"><span class=\"h-relative\">Oppenheimer (15) - 70mm</span>\n</span>\n        </div>\n              </div>\n    </div>\n  </div>\n</div>\n\n    <div class=\"o-main-content | js-sticky-container\">\n    <!-- Body content -->\n    <div class=\"o-body -first\">\n      <div class=\"o-container u-order\">\n        <div class=\"o-content u-order-body\">\n          <div class=\"c-wysiwyg\">\n              <div class=\"o-text-introduction\">\n                            <p>The first film in history to be shot in black and white IMAX 70mm film, watch multi-award-winning <em>Oppenheimer</em> in the format it was intended for.&nbsp;</p>\n\n      \n              </div>\n                          <p><span>Discover the story of American scientist J. Robert Oppenheimer and his race to save the world in this cinematic masterpiece from Christopher Nolan.&nbsp;</span></p><p>Set during the Second World War, Oppenheimer is an IMAX®-shot epic thriller which follows the events of the American genius J. Robert Oppenheimer and his time leading the Manhattan Project.</p><p>A pioneer of nuclear physics studies, Oppenheimer created the atomic bomb in his endless mission to save the world and establish peace even at the risk of destroying it.</p><div class=\"embedded-entity\"><div>\n                  <div class=\"video-embed-field-provider-youtube video-embed-field-responsive-video\"><iframe width=\"854\" height=\"480\" frameborder=\"0\" src=\"https://www.youtube.com/embed/7KD8JwDmMFA?autoplay=0&amp;start=0&amp;rel=0\"></iframe>\n</div>\n\n      \n  </div>\n</div><p>Written and directed by Christopher Nolan using IMAX® cameras, the film stars Cillian Murphy, Emily Blunt, Oscar® winner Matt Damon, and Robert Downey Jr. Oppenheimer also stars Oscar® winner Rami Malek and reunites Nolan with eight-time Oscar® nominated actor, writer, and filmmaker Kenneth Branagh.</p><p><em><span class=\"TextRun SCXW26662979 BCX0 NormalTextRun\" lang=\"FR-FR\">Oppenheimer</span></em><span class=\"TextRun SCXW26662979 BCX0 NormalTextRun\" lang=\"FR-FR\"> (15), 2023, UK/USA, dir. Christopher Nolan, 181 mins.&nbsp;</span><span class=\"EOP SCXW26662979 BCX0\">&nbsp;</span></p><p>Header image: © ™2022 UNIVERSAL STUDIOS</p>\n      \n          </div>\n        </div>\n        <div class=\"o-sidebar-wrapper-fixed  u-order-sidebar | js-sticky-sidebar\" data-sidebar-spacer=\"false\">\n          <div class=\"o-container\">\n            <div class=\"o-sidebar\">\n              <div>\n                <h2 class=\"visually-hidden\">Information</h2>\n                \n\n\n<div class=\"c-info-block c-info-block--primary\">\n  <ul class=\"c-info-block__list o-list\">\n        <li class=\"o-title o-title--tertiary c-info-block__title -first\">\n                  Film\n      \n    </li>\n        <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                  <li><span class=\"o-label\">Date:</span>             Tuesday 21 October and Tuesday 18 November 2025\n      </li>\n                          <li><span class=\"o-label\">Time:</span>             19.15\n      </li>\n                          <li><span class=\"o-label\">Duration:</span>             181 minutes\n      </li>\n                          <li><span class=\"o-label\">Price:</span>              From £14\n      </li>\n                          <li><span class=\"o-label\">Location:</span> IMAX: The Ronson Theatre\n      <span class=\"separator\">, </span>\n  Level 0</li>\n                <!-- Age and Height Restrictions -->\n                          <li><span class=\"o-label\">Age:</span>             15\n      </li>\n                <!-- Festival \"parents\" -->\n              </ul>\n    </li>\n            <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                <li>\n          <a href=\"https://my.sciencemuseum.org.uk/events?view=calendar&amp;kid=666&amp;StartDate=01-10-25\" class=\"btn btn--primary -on-black\">\n            Book now\n            <svg class=\"o-icon btn__icon\" role=\"presentation\">\n              <use xlink:href=\"#arrow-bold-right\"></use>\n            </svg>\n          </a>\n        </li>\n                      </ul>\n    </li>\n                \n    \n  </ul>\n</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n                    \n<div class=\"o-body \">\n  <div class=\"o-container\">\n    <div class=\"o-content\">\n      <section class=\"c-wysiwyg  \">\n                          <h2>            Elevate your cinematic experience with an out-of-this-world dinner!  \n      </h2>\n        \n                              <div class=\"OutlineElement Ltr SCXW61891812 BCX0\"><div class=\"align-center embedded-entity\"><div>\n                    <img src=\"/sites/default/files/styles/embedded_image/public/2025-08/Untitled%20design%20%2836%29.jpg?itok=7UEk99HO\" width=\"1000\" height=\"667\" alt>\n\n\n\n      \n              </div>\n</div></div><div class=\"OutlineElement Ltr SCXW61891812 BCX0\"><div>At the <strong>Tuesday 18 November screening of </strong><em><strong>Oppenheimer</strong>,</em>&nbsp;you can now add a dining reservation to your evening. From Mars Madness Margherita Pizza to Cosmic Burgers, enjoy a delicious dinner at our Space Cafe before immersing yourself on the big screen—it's the perfect start to your night.&nbsp;</div><div>&nbsp;</div><div>You can add your preferred set menu for the&nbsp;18.00 dining reservation to your booking once you add tickets to see <em>Oppenheimer</em>&nbsp;on Tuesday 18 November to your basket.</div></div>\n      \n              </section>\n    </div>\n  </div>\n</div>\n\n          \n<div class=\"o-body\">\n  <div class=\"o-container\">\n    <div class=\"o-content\">\n      <section class=\"slice view-mode-default c-accordion clearfix | js-accordion\" >\n              \n        <h2  class=\"c-accordion__section-title\">            Visit information\n      </h2>\n                                  <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-1\" aria-expanded=\"false\" aria-controls=\"tab-content-1\">\n\t  <span>            About your visit\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-1\" aria-hidden=\"true\" aria-labelledby=\"tab-1\">\n              <h4>Are you serving food/drinks? Can I bring my own food/drink?&nbsp;</h4><p>We sell drinks and snacks in our concessions area. You can bring your own bottle of water, however food from outside the IMAX cinema is not permitted.&nbsp;</p><h4>How long before showing do I need to arrive?&nbsp;&nbsp;</h4><p>Our concessions area will be open from 18.15. We recommend arriving at the cinema at least 15 minutes before the time printed on your tickets.</p><h4>Will toilets be available?&nbsp;</h4><p>There are toilet facilities available near the concessions area and towards the back of the IMAX cinema on level 3.&nbsp;&nbsp;</p>\n      \n  \n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-2\" aria-expanded=\"false\" aria-controls=\"tab-content-2\">\n\t  <span>            Accessibility\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-2\" aria-hidden=\"true\" aria-labelledby=\"tab-2\">\n              <h4>Is there step-free access to the auditorium and concession area?&nbsp;</h4><p>Yes, there is step free access to the auditorium. Please ask at our IMAX ticket desk and a staff member will escort you to your seats.&nbsp;</p><h4>Are there spaces reserved for wheelchair users in the auditorium?&nbsp;</h4><p>Yes, there are four&nbsp;spaces available for wheelchair users. Please call our call centre on 033 0058 0058 to book.&nbsp;</p><h4>Do you provide hearing loops?&nbsp;</h4><p>Yes, we do have hearing loops available. Just speak to a member of staff upon arrival.&nbsp;</p><h4>Do your films have subtitles&nbsp;</h4><p><span>These films will not contain subtitles&nbsp;at this time.</span>&nbsp;</p><h4>Are there accessible toilet facilities?&nbsp;</h4><p>Yes, accessible toilets are located near the IMAX concessions area and outside the main auditorium.</p>\n      \n  \n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-3\" aria-expanded=\"false\" aria-controls=\"tab-content-3\">\n\t  <span>            About our IMAX cinema\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-3\" aria-hidden=\"true\" aria-labelledby=\"tab-3\">\n              <h4>How is it different to a normal cinema experience?&nbsp;&nbsp;</h4><p>The Science Museum’s IMAX cinema is one of only two screens in Europe to feature the very best of both digital and analogue cinema on the same screen. A state-of-the-art next-generation IMAX with Laser projector joins the Science Museum’s original IMAX 70mm film projector to offer two of the highest quality film formats.&nbsp;</p><p>The cinema features modern seating to enjoy films and events in maximum comfort, while our concessions area completes&nbsp; the cinema-going experience with relaxed seating and refreshments bar.&nbsp;</p><h4>What is 70mm film/projection?&nbsp;</h4><p>70mm film projection is one of the highest quality projection formats available. With an aspect ratio of 1.43:1, IMAX 70mm film offers viewers up to 40% more film image on screen than in standard cinemas, combining the largest, clearest images with specially created sound for a high-quality viewing experience.</p><p>A favourite among film makers and film buffs, the format was discussed by Director and Academy-Award winning Visual Effects Designer, Paul Franklin (Inception, Interstellar) on the <a href=\"https://blog.sciencemuseum.org.uk/2001-a-space-odyssey-unrestored/?utm_source=Press&amp;utm_medium=Press%20Release&amp;utm_campaign=L%20AP%3A%20IMAX%2025%2F11%2F20\" target=\"_blank\">Science Museum blog.</a>&nbsp;</p>\n      \n  \n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-4\" aria-expanded=\"false\" aria-controls=\"tab-content-4\">\n\t  <span>            SPACE CAFE SET MENU \n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-4\" aria-hidden=\"true\" aria-labelledby=\"tab-4\">\n              <p>You can choose between two set menus starting from £18.</p><ul><li>Your choice of pizza or a burger served with Space Slaw, Spiced Wedges and a soft drink—£18.</li><li>Your choice of pizza or a burger served with Space Slaw, Spiced Wedges and a beer or wine—£22.</li></ul><p><a href=\"https://www.sciencemuseum.org.uk/sites/default/files/2025-08/SM_Diner_Events_Menu_web_July_25_D_v3.pdf\">View the full evening menu</a></p>\n      \n  \n</div>\n\n          <h3 class=\"c-accordion__title\">\n\t<button class=\"c-accordion__tab | js-accordion-tab\" id=\"tab-5\" aria-expanded=\"false\" aria-controls=\"tab-content-5\">\n\t  <span>            Tickets\n      </span>\n\t  <svg class=\"c-accordion__icon\">\n\t    <use xlink:href=\"#arrow-accordion-down\"></use>\n\t  </svg>\n\t</button>\n</h3>\n\n<div class=\"c-accordion__content clearfix\" id=\"tab-content-5\" aria-hidden=\"true\" aria-labelledby=\"tab-5\">\n              <p>Should you wish to amend your order, tickets can be refunded up until 12.00 the day before the screening or moved to a different date up until two hours before. Amendments must be made over the phone via our contact centre. Lines are open each day between 9.00–17.00. Beyond this point tickets cannot be amended or refunded.</p>\n      \n  \n</div>\n\n      \n                </section>\n    </div>\n  </div>\n</div>\n      \n    \n  </div>\n</article>\n            \n\n<section class=\"o-section \" aria-labelledby=\"a-see-more-films\">\n    <div  class=\"slice view-mode-default o-container clearfix\">\n      <div class=\"o-container__wrapper\">\n                  <h2 id=\"a-see-more-films\" class=\"o-title o-title--section\">            See more films\n      </h2>\n                                      <div class=\"slice view-mode-thirds-3-column\">\n      <div class=\"js-carousel-teaser\" data-carousel-slidesPerView=\"1\"> \n  <div class=\"o-grid o-grid--3-col\">\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/imax-70mm-season\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2025-08/IMAX%20The%20Ronson%20Theatre%20at%20the%20Science%20Museum%20%C2%A9%20Science%20Museum%20Group%20%286%29%20%281%29.jpeg?h=0a8b6f8b&amp;itok=HjOPUOnb 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2025-08/IMAX%20The%20Ronson%20Theatre%20at%20the%20Science%20Museum%20%C2%A9%20Science%20Museum%20Group%20%286%29%20%281%29.jpeg?h=0a8b6f8b&amp;itok=HjOPUOnb\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">IMAX 70mm Season</span>\n\n      </h3>\n            <div class=\"c-card__desc\">\n                          <p>            From Christopher Nolan’s genre-defining Batman trilogy to his Oscar-winning epic Oppenheimer, experience a season of stunning IMAX 70mm film classics at the Science Museum this autumn. \n      </p>\n                      </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/what-was-on/dunkirk-12a-70mm\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2025-08/Dunkirk%20%28Warner%20Bros%29.jpg?h=f8839360&amp;itok=-O3NOyzi 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2025-08/Dunkirk%20%28Warner%20Bros%29.jpg?h=f8839360&amp;itok=-O3NOyzi\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Dunkirk (12A) - 70MM </span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Film\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Thursday 27 November 2025\n      </span>\n                          <p>            Christopher Nolan’s epic wartime thriller Dunkirk returns in stunning IMAX 70mm on one of the UK’s largest screens\n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/interstellar\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2019-04/Interstellar-hero-1_0.jpg?h=dd54426e&amp;itok=OUHJAecV 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2019-04/Interstellar-hero-1_0.jpg?h=dd54426e&amp;itok=OUHJAecV\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Interstellar (12A) - 70MM  </span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            Film\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Friday 12 December 2025\n      </span>\n                          <p>            Christopher Nolan’s epic sci-fi adventure is back in glorious IMAX 70mm this autumn.  \n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n      </div>\n</div>\n  </div>\n\n      \n              </div>\n  </div>\n</section>\n      \n\n\n        </main>\n              </div>\n    </div>\n    \n    <footer>\n      <div class=\"c-social-panel | js-sticky-footer\">\n  <div class=\"o-container\">\n    <div class=\"c-social-panel__wrapper\">\n      <div class=\"js-social-shares | c-social-panel__icons\">\n      </div>\n      <a href=\"#main-wrapper\" class=\"c-social-panel__link | js-back-top\">\n        <span>Back to Top</span>\n\n        <svg class=\"o-icon\" role=\"presentation\">\n          <use xlink:href=\"#arrow-bold-right\"></use>\n        </svg>\n      </a>\n    </div>\n  </div>\n</div>\n      <div class=\"c-footer\">\n                  <div class=\"o-container\">\n            <div class=\"c-footer__padding\">\