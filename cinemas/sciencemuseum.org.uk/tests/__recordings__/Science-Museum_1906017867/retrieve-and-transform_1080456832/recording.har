">Contact us</a>\n                      </li>\n        </ul>\n      \n              </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us\" data-drupal-link-system-path=\"node/3790\">Support us</a>\n                      </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"https://shop.sciencemuseum.org.uk/  \" rel=\"noopener noreferrer\">Shop</a>\n                      </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"https://wonderlabplus.sciencemuseumgroup.org.uk/\" rel=\"noopener noreferrer\">Wonderlab+</a>\n                      </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"https://blog.sciencemuseum.org.uk/\" rel=\"noopener noreferrer\">Blog</a>\n                      </li>\n                      \n      <li class=\"o-menu c-menu-drilldown__item\">\n                  <a href=\"https://my.sciencemuseum.org.uk/account/create/brief\" rel=\"noopener noreferrer\">Newsletter</a>\n                      </li>\n        </ul>\n          </div>\n    </div>\n      \n\n  </div>\n<div id=\"block-openinghoursblock\" class=\"c-secondary-nav__block -bg-white\">\n  \n    \n            <p class=\"o-menu\">\n                  Free entry<br>\n                 Open daily, 10.00–18.00 \n      </p>\n        <p class=\"o-menu -fade\">\n              Science Museum<br>\n                          Exhibition Road<br>\n                  London SW7 2DD\n    </p>\n    <a class=\"o-menu\" href=\"https://www.google.co.uk/maps/dir//Science+Museum,+Exhibition+Rd,+Kensington,+London+SW7+2DD\" rel=\"noreferrer\">\n      View on Google Maps\n  </a>\n    \n  </div>\n\n  </div>\n  </div>\n          </div>\n        </div>\n      </div>\n                <div class=\"o-message\">\n  <div class=\"o-container\">\n                                  <p><a href=\"https://my.sciencemuseum.org.uk/events?view=calendar&amp;kid=441\">Book your free general admission tickets to visit the museum here</a>. Schools and groups can <a href=\"/groups\" data-entity-type=\"node\" data-entity-uuid=\"ccd38c13-451c-401f-b91b-e95cafc5737e\" data-entity-substitution=\"canonical\">book free general admission tickets here</a>. Additional 9-10am free general admission tickets now available for <a href=\"https://eur02.safelinks.protection.outlook.com/?url=https%3A%2F%2Fwww.sciencemuseum.org.uk%2Fsee-and-do%2Fwelcome&amp;data=05%7C02%7Cweb.team%40ScienceMuseum.ac.uk%7C8635f41d5d16429963c308de07154e57%7Ce967bcc0c07041c89f7e806069f6330b%7C1%7C0%7C638955985260747068%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=uLja8KLtskr9%2B7vzOmDaZtQeO1FG3SYgBboiKOY7Nxk%3D&amp;reserved=0\">half term (Monday 27 October-Sunday 2 November 2025)</a>.&nbsp;</p>\n\n      \n      \n      </div>\n</div>\n\n\n            <div class=\"o-mobile-menu\">\n      <nav  id=\"block-menunavigation-science-mobile\" class=\"o-list c-menu-mobile\" aria-label=\"Mobile navigation\">\n        \n            <div class=\"c-menu-drilldown -mobile\">\n      <div class=\"c-menu-drilldown__container\">\n      <ul class=\"o-list c-menu-drilldown__root\">\n              \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Visit</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/visit\" data-drupal-link-system-path=\"node/2746\">Visit</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/visit/food-and-drink\" title=\"Food and drink\" data-drupal-link-system-path=\"node/2674\">Food and drink</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/visit/accessibility\" data-drupal-link-system-path=\"node/2677\">Accessibility</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/see-and-do\" data-drupal-link-system-path=\"node/2926\">See and do</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/objects-and-stories\" data-drupal-link-system-path=\"node/2932\">Objects and stories</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Groups</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/groups\" data-drupal-link-system-path=\"node/2923\">Groups</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item menu-item--collapsed\">\n                  <a href=\"/groups/formal-education-groups\" data-drupal-link-system-path=\"node/2938\">Formal education groups</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/groups/other-groups\" data-drupal-link-system-path=\"node/12503\">Other Groups</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/groups/home-educating-visit\" data-drupal-link-system-path=\"node/10004\">Home Educators</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/groups/community-partnerships\" data-drupal-link-system-path=\"node/15125\">Community partnerships</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/groups/groups-faqs\" data-drupal-link-system-path=\"node/12505\">FAQs for groups</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://learning.sciencemuseumgroup.org.uk/\" rel=\"noopener noreferrer\">Learning resources</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item menu-item--collapsed\">\n                  <a href=\"/groups/teacher-cpd-and-events\" data-drupal-link-system-path=\"node/2935\">Educator CPD and events</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/travel-trade\" data-drupal-link-system-path=\"node/14719\">Travel Trade</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Researchers</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/researchers\" data-drupal-link-system-path=\"node/3784\">Researchers</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Dana Research Centre and Library</button>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/researchers/research-events\" data-drupal-link-system-path=\"node/6982\">Research Events</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"http://journal.sciencemuseum.ac.uk\" rel=\"noopener noreferrer\">Science Museum Group Journal</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item -has-children\">\n                  <button type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">About us</button>\n                                        <ul class=\"c-menu-drilldown__sub\">\n              \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us\" data-drupal-link-system-path=\"node/2929\">About us</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/press-office\" data-drupal-link-system-path=\"node/2944\">Press office</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://www.hirethesciencemuseum.com/\" rel=\"noopener noreferrer\">Venue hire</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://www.sciencemuseumgroup.org.uk/work-with-us\" rel=\"noopener noreferrer\">Jobs</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/volunteering-science-museum\" data-drupal-link-system-path=\"node/2728\">Volunteering</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/contact-us\" data-drupal-link-system-path=\"node/2731\">Contact us</a>\n                      </li>\n    \n        </ul>\n      \n              </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"/about-us/support-us\" data-drupal-link-system-path=\"node/3790\">Support us</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://shop.sciencemuseum.org.uk/  \" rel=\"noopener noreferrer\">Shop</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://wonderlabplus.sciencemuseumgroup.org.uk/\" rel=\"noopener noreferrer\">Wonderlab+</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://blog.sciencemuseum.org.uk/\" rel=\"noopener noreferrer\">Blog</a>\n                      </li>\n          \n            \n      <li class=\"c-menu-drilldown__item\">\n                  <a href=\"https://my.sciencemuseum.org.uk/account/create/brief\" rel=\"noopener noreferrer\">Newsletter</a>\n                      </li>\n    \n          <li>\n        <div class=\"site-search-form c-search-mob\" data-drupal-selector=\"site-search-form-2\" id=\"block-sitesearchform-mobile\">\n  \n  <div class=\"c-search-mob__form\">\n    \n        \n        <form autocomplete=\"off\" block=\"block-sitesearchform-mobile\" action=\"/see-and-do/apollo-11-first-steps\" method=\"post\" id=\"site-search-form-mobile\" accept-charset=\"UTF-8\">\n  <div class=\"js-form-item form-item form-type-search js-form-type-search form-item-term js-form-item-term\">\n      <label for=\"edit-term-mobile\">\n    Search the site\n\n      </label>\n        <input data-drupal-selector=\"edit-term\" data-msg-maxlength=\"Search the site field has a maximum length of 128.\" type=\"search\" id=\"edit-term-mobile\" name=\"term\" value=\"\" size=\"60\" maxlength=\"128\" class=\"form-search\" />\n\n        </div>\n<input data-drupal-selector=\"form-npftno0-mnbns-nuhb3jitwvzesh5zocvydycskvvsy\" type=\"hidden\" name=\"form_build_id\" value=\"form-NpFtno0_mnBNs-NuhB3jItwvzesh5ZoCvyDycSKVVsY\" />\n<input data-drupal-selector=\"edit-site-search-form-2\" type=\"hidden\" name=\"form_id\" value=\"site_search_form\" />\n<div data-drupal-selector=\"edit-actions\" class=\"form-actions js-form-wrapper form-wrapper\" id=\"edit-actions-mobile\">\n\n<button  data-drupal-selector=\"site-search-form-button\" type=\"submit\" id=\"site-search-form-button-mobile\" name=\"op\" value=\"Submit\" class=\"button js-form-submit form-submit btn btn--primary\">\n  Submit\n  <svg class=\"o-icon btn__icon\" role=\"presentation\">\n    <use xlink:href=\"#arrow-bold-right\"></use>\n  </svg>\n</button></div>\n\n</form>\n\n      </div>\n\n</div>\n\n      </li>\n        </ul>\n          </div>\n    </div>\n      \n\n  </nav>\n  </div>\n    </header>\n        <div id=\"main-wrapper\" class=\"o-main-wrapper clearfix\">\n      <div id=\"main\" class=\"clearfix\">\n        \n        <main id=\"main-content\" tabindex=\"-1\">\n                            \n\n<div data-drupal-messages-fallback class=\"hidden\"></div>\n\n\n                              \n                      <article class=\"h-relative\">\n  \n      \n<div class=\"h-relative\">\n  <header class=\"c-banner-deep c-banner-deep--event | js-banner\">\n    \n    <div class=\"c-banner-deep__bg -has-overlay\">\n            <div class=\"c-banner-deep__img-wrapper\">\n        <div class=\"c-banner-deep__img\" style=\"background-image: url('https://www.sciencemuseum.org.uk/sites/default/files/styles/her/public/2019-05/apollo-11-first-steps.jpg?h=dc8d4ed4&amp;itok=rFsfNuvD')\"></div>\n      </div>\n                  <div class=\"c-banner-deep__content | o-container\">\n        <div class=\"c-banner-deep__content__wrapper\">\n          <div class=\"c-breadcrumb  | js-breadcrumb\">\n                <span class=\"visually-hidden\">You are here:</span>\n    <ol class=\"o-list c-breadcrumb__links\">\n    \n          <li>\n                  <a href=\"/\">\n                          <svg class=\"o-icon c-breadcrumb__divider-icon\" role=\"presentation\">\n                <use xlink:href=\"#arrow-bold-right\"></use>\n              </svg>\n                        Home\n          </a>\n              </li>\n          <li>\n                  <a href=\"/see-and-do\">\n                        See and do\n          </a>\n              </li>\n        </ol>\n\n          </div>\n          <div class=\"c-banner-deep__title__wrapper\">\n\n                        <h1 class=\"visually-hidden\" ><span class=\"h-relative\">Apollo 11: First Steps Edition 2D (U)</span>\n</h1>\n\n            <div aria-hidden=\"true\" class=\"c-banner-deep__title | o-title o-title--primary\">\n              <span  class=\"js-cascade\"><span class=\"h-relative\">Apollo 11: First Steps Edition 2D (U)</span>\n</span>\n            </div>\n          </div>\n                  </div>\n      </div>\n    </div>\n      </header>\n</div>\n      <div class=\"o-main-content | js-sticky-container\">\n    <!-- Body content -->\n    <div class=\"o-body -first\">\n      <div class=\"o-container u-order\">\n        <div class=\"o-content u-order-body\">\n          <div class=\"c-wysiwyg\">\n              <div class=\"o-text-introduction\">\n                            <p>Experience the lift-off, landing and return of the historic Apollo 11 mission on one of the biggest cinema screens in Europe.</p>\n\n      \n              </div>\n                          <p><em><span>Apollo 11: First Steps Edition </span></em><span>offers a thrilling cinematic experience in breath-taking 70mm. Using never-before-seen uncovered footage and a trove of newly discovered audio recordings from NASA’s vaults, it will transport you to some of the most incredible real-life moments from the first Moon landing.</span></p><ul><li>Please note that this is a shorter 48-minute version of the film.</li><li>Planning a school visit? <a href=\"/groups/apollo-11-school-info\" data-entity-type=\"node\" data-entity-uuid=\"3a25ce42-ec31-4c14-a16a-a205ebe64f18\" data-entity-substitution=\"canonical\">Find out more information about <em>Apollo 11: First Steps Edition</em>&nbsp;for educational groups</a>.</li></ul><h2><span>Save 50% on tickets</span></h2><p><span>You can get 50% off IMAX documentary tickets when you book day passes for </span><em><span>Wonderlab</span></em><span> or </span><em><span>Power Up</span></em><span>. You will automatically receive the discount when you add them to your basket. &nbsp;</span></p>\n      \n          </div>\n        </div>\n        <div class=\"o-sidebar-wrapper-fixed  u-order-sidebar | js-sticky-sidebar\" data-sidebar-spacer=\"false\">\n          <div class=\"o-container\">\n            <div class=\"o-sidebar\">\n              <div>\n                <h2 class=\"visually-hidden\">Information</h2>\n                \n\n\n<div class=\"c-info-block c-info-block--primary\">\n  <ul class=\"c-info-block__list o-list\">\n        <li class=\"o-title o-title--tertiary c-info-block__title -first\">\n                  IMAX screening\n      \n    </li>\n        <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                  <li><span class=\"o-label\">Date:</span>             Dates and times vary\n      </li>\n                                  <li><span class=\"o-label\">Duration:</span>             48 minutes\n      </li>\n                          <li><span class=\"o-label\">Price:</span>              £12. Family discounts available. Ages 3 and under go free. No bookings fees apply\n      </li>\n                          <li><span class=\"o-label\">Location:</span> IMAX: The Ronson Theatre\n      <span class=\"separator\">, </span>\n  Level 0</li>\n                <!-- Age and Height Restrictions -->\n                          <li><span class=\"o-label\">Age:</span>             Children under 12 must be accompanied by an adult\n      </li>\n                <!-- Festival \"parents\" -->\n              </ul>\n    </li>\n            <li class=\"c-info-block__section\">\n      <ul class=\"o-list\">\n                <li>\n          <a href=\"https://my.sciencemuseum.org.uk/events?view=calendar&amp;startDate=2025-03-01&amp;kid=310\" class=\"btn btn--primary -on-black\">\n            Book now\n            <svg class=\"o-icon btn__icon\" role=\"presentation\">\n              <use xlink:href=\"#arrow-bold-right\"></use>\n            </svg>\n          </a>\n        </li>\n                      </ul>\n    </li>\n                \n    \n  </ul>\n</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n                    <div class=\"o-body\">\n    <div class=\"o-container\">\n    <div class=\"o-content\">\n      <div class=\"c-carousel-quote | js-carousel-quote\">\n        <div class=\"swiper-container\">\n          <div class=\"swiper-wrapper\">\n                        <div class=\"swiper-slide\">\n\t<blockquote class=\"c-quote\">\n\t  <p class=\"c-quote__content\">            &quot;It was like a family discovering a forgotten shoe box full of old movies of major life events—only the family was America.&quot;\n      </p>\n\t  <footer class=\"c-quote__cite\">            Vanity Fair\n      </footer>\n\t</blockquote>\n</div>\n          <div class=\"swiper-slide\">\n\t<blockquote class=\"c-quote\">\n\t  <p class=\"c-quote__content\">            &quot;[...] As much a cinematic discovery as a celestial one.&quot;\n      </p>\n\t  <footer class=\"c-quote__cite\">            Vanity Fair\n      </footer>\n\t</blockquote>\n</div>\n      \n          </div>\n          <div class=\"swiper-pagination\"></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n          \n<div class=\"o-body \">\n  <div class=\"o-container\">\n    <div class=\"o-content\">\n      <section class=\"c-wysiwyg  \">\n                \n                              <p>Header image: The Saturn V liftoff. Courtesy of Statement Pictures for CNN Films/MacGillivray Freeman Films</p>\n      \n              </section>\n    </div>\n  </div>\n</div>\n\n      \n    \n  </div>\n</article>\n              \n\n<section class=\"o-section -secondary\" aria-labelledby=\"a-see-more-imax-presentations\">\n    <div  class=\"slice view-mode-default o-container clearfix\">\n      <div class=\"o-container__padding\">\n                  <h2 id=\"a-see-more-imax-presentations\" class=\"o-title o-title--section\">            See more IMAX presentations\n      </h2>\n                                      <div class=\"slice view-mode-thirds-3-column\">\n      <div class=\"js-carousel-teaser\" data-carousel-slidesPerView=\"1\"> \n  <div class=\"o-grid o-grid--3-col\">\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/antarctica-3d\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2020-11/antartica-imax.jpg?h=47f41414&amp;itok=Eea0ZkIz 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2020-11/antartica-imax.jpg?h=47f41414&amp;itok=Eea0ZkIz\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Antarctica 3D (U)</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            IMAX screening\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Now showing\n      </span>\n                          <p>            Explore the mysterious and wild plains of Antarctica and meet the creatures that thrive in the coldest and windiest place on the planet. Book early for cheaper prices.  \n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/beautiful-planet-3d-u\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2020-11/A-Beautiful-Planet.jpg?h=3cf665d7&amp;itok=GG-n01r- 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2020-11/A-Beautiful-Planet.jpg?h=3cf665d7&amp;itok=GG-n01r-\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">A Beautiful Planet 3D (U)</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            IMAX screening\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Now showing\n      </span>\n                          <p>            Meet the crew on board the International Space Station and see stunning 3D views of Earth from space. Book early for cheaper prices. \n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n          <div class=\"o-grid__item\"><article class=\"c-card \">\n  <a href=\"/see-and-do/ocean-odyssey-3d\" class=\"c-card__link\">\n        <div class=\"c-card__img\">\n      <div>\n                      <img loading=\"lazy\" class=\"teaser-11-7\" srcset=\"/sites/default/files/styles/11_7/public/2024-04/AOO_EP01_07_.jpg?h=dd9cdf43&amp;itok=7ZVfc1lm 1x\" width=\"550\" height=\"350\" src=\"/sites/default/files/styles/11_7/public/2024-04/AOO_EP01_07_.jpg?h=dd9cdf43&amp;itok=7ZVfc1lm\" alt=\"\" />\n\n\n\n      \n  </div>\n    </div>\n    <div class=\"c-card__content\">\n    \t<h3 class=\"c-card__title o-title o-title--secondary\">\n        <span class=\"h-relative\">Ocean Odyssey 3D (U)</span>\n\n      </h3>\n            <div class=\"c-card__info\">\n          <span class=\"visually-hidden\">Category: </span>            IMAX screening\n      \n      </div>\n            <div class=\"c-card__desc\">\n                  <span class=\"c-card__date\">            Now showing\n      </span>\n                          <p>            Embark on an extraordinary journey through Earth’s vast ocean highways with a baby humpback whale to uncover the secrets of ocean currents. Book early for cheaper prices.\n      </p>\n                          <span class=\"c-card__tag\">            Book now\n      </span>\n              </div>\n    </div>\n  </a>\n</article>\n</div>\n      </div>\n</div>\n  </div>\n\n      \n              </div>\n  </div>\n</section>\n      \n\n\n        </main>\n              </div>\n    </div>\n    \n    <footer>\n      <div class=\"c-social-panel | js-sticky-footer\">\n  <div class=\"o-container\">\n    <div class=\"c-social-panel__wrapper\">\n      <div class=\"js-social-shares | c-social-panel__icons\">\n      </div>\n      <a href=\"#main-wrapper\" class=\"c-social-panel__link | js-back-top\">\n        <span>Back to Top</span>\n\n        <svg class=\"o-icon\" role=\"presentation\">\n          <use xlink:href=\"#arrow-bold-right\"></use>\n        </svg>\n      </a>\n    </div>\n  </div>\n</div>\n      <div class=\"c-footer\">\n                  <div class=\"o-container\">\n            <div class=\"c-footer__padding\">\n              <div class=\"c-footer__section c-footer__section--second clearfix\">\n                      <div class=\"c-footer__block -column\">\n      \n              <ul class=\"o-list\">\n                    <li>\n          <span>Location</span>\n                                    <ul class=\"o-list\">\n                    <li>\n          <span>Exhibition Road, South Kensington, London, SW7 2DD</span>\n                  </li>\n              <li>\n          <a href=\"http: