ider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=jnLW-q2ftKA\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=jnLW-q2ftKA\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001093\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002460\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003915\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"0000004392\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004710\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007157\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013073\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014130\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000002460\"},{\"castAndCrewMemberId\":\"0000003915\"},{\"castAndCrewMemberId\":\"0000004392\"},{\"castAndCrewMemberId\":\"0000004710\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000003915\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000001093\"},{\"castAndCrewMemberId\":\"0000007157\"},{\"castAndCrewMemberId\":\"0000013073\"},{\"castAndCrewMemberId\":\"0000014130\"}],\"genreIds\":[\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ad147b9a-b731-410f-8bf9-c4f3f3df2095\",\"corporateId\":null},\"hopk\":\"HO00007147\",\"hoCode\":\"A000008799\",\"eventId\":null,\"distributorName\":\"Black Bear\"},{\"id\":\"HO00007151\",\"title\":{\"text\":\"The Last One for the Road\",\"translations\":[]},\"synopsis\":{\"text\":\"Two blustery 50-somethings, have an obsession: going for their last drink. One night, they run into Giulio, a shy architecture student, whose way of seeing the world and love will be transformed as the trio wander from bar to bar of Veneto.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Two blustery 50-somethings, have an obsession: going for their last drink. One night, they run into Giulio, a shy architecture student.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, brief drug misuse, nudity\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":101,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001878\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010359\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014140\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014141\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014142\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014143\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014144\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001878\"},{\"castAndCrewMemberId\":\"0000014140\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000014141\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000010359\"},{\"castAndCrewMemberId\":\"0000014142\"},{\"castAndCrewMemberId\":\"0000014143\"},{\"castAndCrewMemberId\":\"0000014144\"}],\"genreIds\":[\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"8e65db5e-373f-48e3-8d4d-13723f281cc0\",\"corporateId\":null},\"hopk\":\"HO00007151\",\"hoCode\":\"A000008803\",\"eventId\":null,\"distributorName\":\"Bulldog Film Distribution\"},{\"id\":\"HO00007152\",\"title\":{\"text\":\"Rosebush Pruning\",\"translations\":[]},\"synopsis\":{\"text\":\"Underneath the Catalonian sun, a rich white American family lives in hedonistic isolation, seeking love and validation through one another, their designer wardrobes and pop music. When an outsider infiltrates the family, buried tensions surface and blood ties are severed. \\n\\nAn outrageous, biting satire on the absurdity of patriarchal family, starring Callum Turner, Riley Keough, Jamie Bell, Lukas Gage, Elena Anaya, Tracy Letts, Elle Fanning and Pamela Anderson.\\n\\nFrom award winning director Karim Aïnouz, written by Oscar nominated writer Efthimis Filippou, ROSEBUSH PRUNING is absurd, funny and in equal measure. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Underneath the Catalonian sun, a rich white American family lives in hedonistic isolation, seeking love and validation through one another, their designer wardrobes\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":{\"text\":\"sexual violence, strong sex, nudity\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":95,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/ab78ddcf-eae4-4e1c-9d6a-68f6392793c8/media/TrailerVideo\"}],\"trailerUrl\":null,\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000497\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000736\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001041\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001073\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001820\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005512\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006483\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007166\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008082\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008105\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010500\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013540\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014145\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001041\"},{\"castAndCrewMemberId\":\"0000001073\"},{\"castAndCrewMemberId\":\"0000005512\"},{\"castAndCrewMemberId\":\"0000006483\"},{\"castAndCrewMemberId\":\"0000007166\"},{\"castAndCrewMemberId\":\"0000008105\"},{\"castAndCrewMemberId\":\"0000010500\"},{\"castAndCrewMemberId\":\"0000014145\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000001820\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000000497\"},{\"castAndCrewMemberId\":\"0000000736\"},{\"castAndCrewMemberId\":\"0000008082\"},{\"castAndCrewMemberId\":\"0000013540\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ab78ddcf-eae4-4e1c-9d6a-68f6392793c8\",\"corporateId\":null},\"hopk\":\"HO00007152\",\"hoCode\":\"A000008804\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00007167\",\"title\":{\"text\":\"DocHouse: Birds of War\",\"translations\":[]},\"synopsis\":{\"text\":\"BIRDS OF WAR is the love story of a London-based Lebanese journalist and a Syrian activist/cameraman over thirteen years of revolutions, war and exile.\\n\\nYoung BBC reporter Janay first contacts Syrian cameraman Habak for footage during the final months of the four-year battle for Aleppo in 2016, one of the bloodiest and most decisive turning points in Syria’s brutal civil war. Over time, through texts, video exchanges, voice messages and shared moments from afar, the bond between them strengthens, and as the political landscape shifts around them - from Syria to Lebanon and beyond - their dual roles as journalists and lovers become impossible to separate\\n\\nCo-directed by Janay and Habak, BIRDS OF WAR delves into their personal archives to tell a story both intimate and international. Every new crisis tests what holds them together, capturing the deeply human need for connection amidst truth, propaganda and the chaos of conflict.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":85,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014182\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014183\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000014182\"},{\"castAndCrewMemberId\":\"0000014183\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007167\",\"hoCode\":\"A000008820\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00007210\",\"title\":{\"text\":\"BACKROOMS: EVERYTHING MUST GO WITH BONUS FOOTAGE\",\"translations\":[]},\"synopsis\":{\"text\":\"In the basement of a furniture showroom, a man (Chiwetel Ejiofor) stumbles upon a strange doorway that leads into a mysterious, otherworldly labyrinth. His therapist (Renate Reinsve) doesn't believe him, so he sets out on a mission to gather some proof. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A strange doorway appears in the basement of a furniture showroom.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, violence, injury detail, horror\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":126,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=tKGhxMi50y8\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=tKGhxMi50y8\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000578\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001101\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002626\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003068\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005898\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005899\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009229\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009594\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010891\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013766\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013767\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013768\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013769\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000002626\"},{\"castAndCrewMemberId\":\"0000003068\"},{\"castAndCrewMemberId\":\"0000009594\"},{\"castAndCrewMemberId\":\"0000010891\"},{\"castAndC