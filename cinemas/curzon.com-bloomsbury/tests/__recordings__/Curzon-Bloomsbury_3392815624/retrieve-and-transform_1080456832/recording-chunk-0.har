          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-07-29\",\"showtimes\":[{\"id\":\"BLO1-110598\",\"schedule\":{\"businessDate\":\"2026-07-29\",\"startsAt\":\"2026-07-29T18:00:00+01:00\",\"endsAt\":\"2026-07-29T20:30:00+01:00\",\"filmStartsAt\":\"2026-07-29T18:25:00+01:00\",\"filmEndsAt\":\"2026-07-29T20:30:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-19\",\"filmId\":\"HO00007104\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-111448\",\"schedule\":{\"businessDate\":\"2026-07-29\",\"startsAt\":\"2026-07-29T18:20:00+01:00\",\"endsAt\":\"2026-07-29T19:58:00+01:00\",\"filmStartsAt\":\"2026-07-29T18:27:00+01:00\",\"filmEndsAt\":\"2026-07-29T19:58:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00007227\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-111443\",\"schedule\":{\"businessDate\":\"2026-07-29\",\"startsAt\":\"2026-07-29T20:10:00+01:00\",\"endsAt\":\"2026-07-29T21:47:00+01:00\",\"filmStartsAt\":\"2026-07-29T20:17:00+01:00\",\"filmEndsAt\":\"2026-07-29T21:47:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00007226\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007104\",\"title\":{\"text\":\"Film Club: Marathon Man\",\"translations\":[]},\"synopsis\":{\"text\":\"To mark the centenary of Academy Award-winning director John Schlesinger's birth, we're inviting you to experience his greatest films on the big screen. Season curated by Claire Nicolas and Marc David Jacobs. \\n\\nMARATHON MAN\\nA graduate history student is unwittingly caught in the middle of an international conspiracy involving stolen diamonds, an exiled Nazi war criminal, and a rogue government agent.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A graduate history student is unwittingly caught in the middle of an international conspiracy involving stolen diamonds, an exiled Nazi war criminal, and a rogue agent.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-07\",\"runtimeInMinutes\":125,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001772\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007173\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008227\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011662\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014077\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014078\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014079\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"5923\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001772\"},{\"castAndCrewMemberId\":\"0000007173\"},{\"castAndCrewMemberId\":\"0000008227\"},{\"castAndCrewMemberId\":\"0000014077\"},{\"castAndCrewMemberId\":\"5923\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000011662\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000014078\"},{\"castAndCrewMemberId\":\"0000014079\"}],\"genreIds\":[\"0000000002\",\"0000000026\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007104\",\"hoCode\":\"A000008751\",\"eventId\":null,\"distributorName\":\"Park Circus\"},{\"id\":\"HO00007226\",\"title\":{\"text\":\"DocHouse: Flavors of Iraq\",\"translations\":[]},\"synopsis\":{\"text\":\"French-born journalist Feurat Alani narrates this animated documentary about his complicated connection to Iraq, the country of his parents. His gripping storytelling comes to life with director Léonard Cohen's evocative animation, conjuring up Alani's family in Iraq and his own introduction to the country as a boy, under the dictatorship of Saddam Hussein. With touching vulnerability, Alani depicts his relationship with his revolutionary father, who was exiled from his homeland but never lost his love for her.\\n\\nNimbly covering 5 decades of upheaval, from Iraq's invasion of Kuwait to the American occupation and the subsequent rise of Al Qaeda and Islamic State, Alani presents a piercing perspective on US intervention in the region from a place of deep, personal understanding.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-24\",\"runtimeInMinutes\":90,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004092\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000004092\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007226\",\"hoCode\":\"A000008891\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00007227\",\"title\":{\"text\":\"DocHouse: Ask E. Jean\",\"translations\":[]},\"synopsis\":{\"text\":\"Across a five-decade career, E. Jean Carroll has emerged as a trailblazing journalist, talk show host and beloved advice columnist, conquering the male dominated publishing world of 1980s and 90s New York with a fearless voice all her own. \\n\\nIn recent years, she has fought a high profile legal battle against Donald Trump for sexual assault and defamation, becoming the only woman to beat him in court. Twice. ASK E. JEAN is both a portrait of the thrilling, storied life of a singular icon, and a gutsy exploration of what it takes for a woman to stand up to power and prove she is telling the truth about a historic assault. With the multi-million dollar bill for damages still unpaid and the legal battle rumbling on through the courts and the headlines, ASK E. JEAN is critical viewing.  \",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-24\",\"runtimeInMinutes\":91,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014336\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000014336\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007227\",\"hoCode\":\"A000008892\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000001772\",\"name\":{\"givenName\":\"Marthe \",\"familyName\":\"Keller\",\"middleName\":null}},{\"id\":\"0000007173\",\"name\":{\"givenName\":\"Roy\",\"familyName\":\"Scheider\",\"middleName\":null}},{\"id\":\"0000008227\",\"name\":{\"givenName\":\"Dustin\",\"familyName\":\"Hoffman\",\"middleName\":null}},{\"id\":\"0000011662\",\"name\":{\"givenName\":\"John\",\"familyName\":\"Schlesinger\",\"middleName\":null}},{\"id\":\"0000014077\",\"name\":{