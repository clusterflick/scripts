            "text": "{\"businessDate\":\"2026-07-25\",\"showtimes\":[{\"id\":\"BLO1-111642\",\"schedule\":{\"businessDate\":\"2026-07-25\",\"startsAt\":\"2026-07-25T14:00:00+01:00\",\"endsAt\":\"2026-07-25T15:42:00+01:00\",\"filmStartsAt\":\"2026-07-25T14:07:00+01:00\",\"filmEndsAt\":\"2026-07-25T15:42:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00001263\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"BLO1-2-HO00001263\"},{\"id\":\"BLO1-111439\",\"schedule\":{\"businessDate\":\"2026-07-25\",\"startsAt\":\"2026-07-25T16:00:00+01:00\",\"endsAt\":\"2026-07-25T17:37:00+01:00\",\"filmStartsAt\":\"2026-07-25T16:07:00+01:00\",\"filmEndsAt\":\"2026-07-25T17:37:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00007226\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-111446\",\"schedule\":{\"businessDate\":\"2026-07-25\",\"startsAt\":\"2026-07-25T18:00:00+01:00\",\"endsAt\":\"2026-07-25T19:38:00+01:00\",\"filmStartsAt\":\"2026-07-25T18:07:00+01:00\",\"filmEndsAt\":\"2026-07-25T19:38:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00007227\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-110597\",\"schedule\":{\"businessDate\":\"2026-07-25\",\"startsAt\":\"2026-07-25T21:20:00+01:00\",\"endsAt\":\"2026-07-25T23:36:00+01:00\",\"filmStartsAt\":\"2026-07-25T21:45:00+01:00\",\"filmEndsAt\":\"2026-07-25T23:36:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-19\",\"filmId\":\"HO00007105\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00001263\",\"title\":{\"text\":\"DocHouse: Letters From Baghdad\",\"translations\":[]},\"synopsis\":{\"text\":\"This July marks 100 years since the death of English explorer, spy and political powerhouse Gertrude Bell - the most powerful woman in the British Empire in her day.\\n\\nLETTERS FROM BAGHDAD (2016) tells the dramatic story of the woman known as the female Lawrence of Arabia. Gertrude Bell travelled widely in Arabia before being recruited by British military intelligence during WWI to help draw the borders of Iraq and as a result helped shape the modern Middle East.\\n\\nTold entirely in the words of Bell and her contemporaries, excerpted from their letters, private diaries and official documents, the film chronicles her extraordinary journey into both the uncharted Arabian desert and the inner sanctum of British colonial power. It is a unique look at both a remarkable woman and the tangled history of Iraq.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-12\",\"runtimeInMinutes\":95,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014205\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014206\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000014205\"},{\"castAndCrewMemberId\":\"0000014206\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00001263\",\"hoCode\":\"A000001607\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00007105\",\"title\":{\"text\":\"Film Club: Midnight Cowboy\",\"translations\":[]},\"synopsis\":{\"text\":\"To mark the centenary of Academy Award-winning director John Schlesinger's birth, we're inviting you to experience his greatest films on the big screen. Season curated by Claire Nicolas and Marc David Jacobs. \\n\\nMIDNIGHT COWBOY\\nA naive hustler travels from Texas to New York City to seek personal fortune but, in the process, finds himself a new friend.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A naive hustler travels from Texas to New York City to seek personal fortune but, in the process, finds himself a new friend.\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":{\"text\":\"Sexual violence\",\"translations\":[]},\"releaseDate\":\"2026-07-05\",\"runtimeInMinutes\":111,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=qI-KezdGj0E\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=qI-KezdGj0E\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000008227\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009665\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011662\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000726\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000727\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000728\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000729\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000730\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000731\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000008227\"},{\"castAndCrewMemberId\":\"0000009665\"},{\"castAndCrewMemberId\":\"HO00000726\"},{\"castAndCrewMemberId\":\"HO00000727\"},{\"castAndCrewMemberId\":\"HO00000728\"},{\"castAndCrewMemberId\":\"HO00000729\"},{\"castAndCrewMemberId\":\"HO00000730\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000011662\"}],\"producers\":[{\"castAndCrewMemberId\":\"HO00000731\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007105\",\"hoCode\":\"A000008752\",\"eventId\":null,\"distributorName\":\"Park Circus\"},{\"id\":\"HO00007226\",\"title\":{\"text\":\"DocHouse: Flavors of Iraq\",\"translations\":[]},\"synopsis\":{\"text\":\"French-born journalist Feurat Alani narrates this animated documentary about his complicated connection to Iraq, the country of his parents. His gripping storytelling comes to life with director Léonard Cohen's evocative animation, conjuring up Alani's family in Iraq and his own introduction to the country as a boy, under the dictatorship of Saddam Hussein. With touching vulnerability, Alani depicts his relationship with his revolutionary father, who was exiled from his homeland but never lost his love for her.\\n\\nNimbly covering 5 decades of upheaval, from Iraq's invasion of Kuwait to the American occupation and the subsequent rise of Al Qaeda and Islamic State, Alani presents a piercing perspective on US intervention in the region from a place of deep, personal understanding.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-24\",\"runtimeInMinutes\":90,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004092\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000004092\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007226\",\"hoCode\":\"A000008891\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00007227\",\"title\":{\"text\":\"DocHouse: Ask E. Jean\",\"translations\":[]},\"synopsis\":{\"text\":\"Across a five-decade career, E. Jean Carroll has emerged as a trailblazing journalist, talk show host and beloved advice columnist, conquering the male dominated publishing world of 1980s and 90s New York with a fearless voice all her own. \\n\\nIn recent years, she has fought a high profile legal battle against Donald Trump for sexual assault and defamation, becoming the only woman to beat him in court. Twice. ASK E. JEAN is both a portrait of the thrilling, storied life of a singular icon, and a gutsy exploration of what it takes for a woman to stand up to power and prove she is telling the truth about a historic assault. With the multi-million dollar bill for damages still unpaid and the legal battle rumbling on through the courts and the headlines, ASK E. JEAN is critical viewing.  \",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-24\",\"runtimeInMinutes\":91,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014336\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000014336\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007227\",\"hoCode\":\"A000008892\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000014205\",\"name\":{\"givenName\":\"Sabine\",\"familyName\":\"Krayenbühl \",\"middleName\":null}},{\"id\":\"0000014206\",\"name\":{\"givenName\":\"Zeva\",\"familyName\":\"Oelbaum\",\"middleName\":null}},{\"id\":\"0000008227\",\"name\":{\"givenName\":\"Dustin\",\"familyName\":\"Hoffman\",\"middleName\":null}},{\"id\":\"0000009665\",\"name\":{\"givenName\":\"Jon\",\"familyName\":\"Voight\",\"middleName\":null}},{\"id\":\"0000011662\",\"name\":{\"givenName\":\"John\",\"familyName\":\"Schlesinger\",\"middleName\":null}},{\"id\":\"HO00000726\",\"name\":{\"givenName\":\"Brenda\",\"familyName\":\"Vaccaro\",\"middleName\":null}},{\"id\":\"HO00000727\",\"name\":{\"givenName\":\"Sylvia\",\"familyName\":\"Miles\",\"middleName\":null}},{\"id\":\"HO00000728\",\"name\":{\"givenName\":\"Barnard\",\"familyName\":\"Hughes\",\"middleName\":null}},{\"id\":\"HO00000729\",\"name\":{\"givenName\":\"Ruth\",\"familyName\":\"White\",\"middleName\":null}},{\"id\":\"HO00000730\",\"name\":{\"givenName\":\"John\",\"familyName\":\"McGiver\",\"middleName\":null}},{\"id\":\"HO00000731\",\"name\":{\"givenName\":\"Jerome\",\"familyName\":\"Hellman\",\"middleName\":null}},{\"id\":\"0000004092\",\"name\":{\"givenName\":\"Leonard\",\"familyName\":\"Cohen\",\"middleName\":null}},{\"id\":\"0000014336\",\"name\":{\"givenName\":\"Ivy\",\"familyName\":\"Meeropol\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":{\"text\":\"Drama\",\"translations\":[]}},{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"HO00000002\",\"classification\":{\"text\":\"PG\",\"translations\":[]},\"classificationDescription\":{\"text\":\"PG\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}},{\"id\":\"HO00000005\",\"classification\":{\"text\":\"18\",\"translations\":[]},\"classificationDescription\":{\"text