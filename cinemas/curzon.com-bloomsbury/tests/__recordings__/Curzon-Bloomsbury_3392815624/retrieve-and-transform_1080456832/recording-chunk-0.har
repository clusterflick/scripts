aCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-106976\",\"schedule\":{\"businessDate\":\"2026-01-31\",\"startsAt\":\"2026-01-31T20:30:00+00:00\",\"endsAt\":\"2026-01-31T23:24:00+00:00\",\"filmStartsAt\":\"2026-01-31T20:55:00+00:00\",\"filmEndsAt\":\"2026-01-31T23:24:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-2-3\",\"filmId\":\"HO00006487\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-2\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-106975\",\"schedule\":{\"businessDate\":\"2026-01-31\",\"startsAt\":\"2026-01-31T20:40:00+00:00\",\"endsAt\":\"2026-01-31T23:34:00+00:00\",\"filmStartsAt\":\"2026-01-31T21:05:00+00:00\",\"filmEndsAt\":\"2026-01-31T23:34:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-19\",\"filmId\":\"HO00006609\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000059\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"BLO1-113-HO00006609\"},{\"id\":\"BLO1-106984\",\"schedule\":{\"businessDate\":\"2026-01-31\",\"startsAt\":\"2026-01-31T20:50:00+00:00\",\"endsAt\":\"2026-01-31T23:21:00+00:00\",\"filmStartsAt\":\"2026-01-31T21:15:00+00:00\",\"filmEndsAt\":\"2026-01-31T23:21:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-4-5\",\"filmId\":\"HO00006677\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-4\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000059\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-106983\",\"schedule\":{\"businessDate\":\"2026-01-31\",\"startsAt\":\"2026-01-31T21:00:00+00:00\",\"endsAt\":\"2026-01-31T23:26:00+00:00\",\"filmStartsAt\":\"2026-01-31T21:25:00+00:00\",\"filmEndsAt\":\"2026-01-31T23:26:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-1-2\",\"filmId\":\"HO00006691\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-1\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006648\",\"title\":{\"text\":\"DocHouse: Seeds\",\"translations\":[]},\"synopsis\":{\"text\":\"An exploration of Black generational farmers in the American South reveals the fragility of legacy and the significance of owning land.\\r\\n\\r\\nInterweaving the stories of three Black generational farmers to create a collective and intimate portrait of farming today, SEEDS is a moving and powerful exploration of their lives, joys and struggles.\\r\\n\\r\\nWith remarkable intimacy, the film documents their everyday lives - cotton harvesting, chasing cows, dealing with broken machinery, and financial precarities. The camera relishes simple moments - conversations through car windows, candy from grandma’s purse - as it captures moments of warmth, joy, and fulfillment, turning them into striking vignettes that honor the families’ connection to the land and each other.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-22\",\"runtimeInMinutes\":123,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000012758\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006648\",\"hoCode\":\"A000008205\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006662\",\"title\":{\"text\":\"DocHouse: The Voice of Hind Rajab\",\"translations\":[]},\"synopsis\":{\"text\":\"January 29, 2024. Red Crescent volunteers receive an emergency call. A 6-year old girl is trapped in a car under fire in Gaza, pleading for rescue. While trying to keep her on the line, they do everything they can to get an ambulance to her. Her name was Hind Rajab.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Red Crescent volunteers receive an emergency call. A 6-year old girl is trapped in a car under IDF fire in Gaza, pleading for rescue. Her name was Hind Rajab.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"distressing scenes, strong threat, images of real dead bodies\",\"translations\":[]},\"releaseDate\":\"2026-01-16\",\"runtimeInMinutes\":89,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001301\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012772\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012773\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012774\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006662\",\"hoCode\":\"A000008221\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006677\",\"title\":{\"text\":\"Hamnet\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"distressing scenes, brief moderate sex\",\"translations\":[]},\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":126,\"trailerUrl\":\"https://www.youtube.com/watch?v=Y9Tv9wGPxIw\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000175\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001040\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001087\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002138\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002310\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004702\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004703\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005314\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007765\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c566d7dc-50bb-4d55-984b-c4c65751933e\",\"corporateId\":null},\"hopk\":\"HO00006677\",\"hoCode\":\"A000008241\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006687\",\"title\":{\"text\":\"The History of Sound\",\"translations\":[]},\"synopsis\":{\"text\":\"In 1917, Lionel — a young, talented music student — meets David at the Boston Conservatory, where they bond over a deep love of folk music. Years later, Lionel receives a letter from David, leading to an impromptu journey through the backwoods of Maine to collect traditional songs. This unexpected reunion, ensuing love affair, and the music they collect and preserve, will shape the course of Lionel’s life far beyond his own awareness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Two young men during World War I set out to record the lives, voices and music of their American countrymen.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"brief strong sex\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":128,\"trailerUrl\":\"https://www.youtube.com/watch?v=E2PSkw8BI7k\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002283\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002310\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004336\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000007164\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007677\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008293\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012816\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012817\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012818\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012819\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012820\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012821\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012822\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c8ef0b42-7ed8-4ee1-9534-85771b63b7fc\",\"corporateId\":null},\"hopk\":\"HO00006687\",\"hoCode\":\"A000008252\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006689\",\"title\":{\"text\":\"No Other Choice\",\"translations\":[]},\"synopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":139,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000012169\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012827\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012828\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012829\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012830\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012831\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000026\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9ecc0908-a983-42f7-9591-6f8d73d7488b\",\"corporateId\":null},\"hopk\":\"HO00006689\",\"hoCode\":\"A000008255\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00006691\",\"title\":{\"text\":\"Is This Thing On?\",\"translations\":[]},\"synopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family — forcing them to navigate co-parenting, identity, and whether love can take a new form.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":121,\"trailerUrl\":\"https://www.youtube.com/watch?v=ngmu5zGOa7s\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002276\",\"roles\":[\"Actor\",\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003003\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003138\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006446\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007571\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000012836\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012837\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012838\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4e47345d-b26d-4559-847e-3add7a11d75a\",\"corporateId\":null},\"hopk\":\"HO00006691\",\"hoCode\":\"A000008257\",\"eventId\":null,\"distributorName\":\"Walt Disney Studios Motion Pictures - UK\"},{\"id\":\"HO00006693\",\"title\":{\"text\":\"Nouvelle Vague\",\"translations\":[]},\"synopsis\":{\"text\":\"A playful, poignant love letter to cinema, Nouvelle Vague reimagines the making of Jean-Luc Godard’s Breathless in an exuberant exploration of the youthful rebellion and creative chaos that shaped the French New Wave.\\n\\nDirected by Richard Linklater, starring Zoey Deutch, Guillaume Marbeck, and Aubry Dullin.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A playful, poignant love letter to cinema, Nouvelle Vague reimagines the making of Jean-Luc Godard’s Breathless in an exuberant exploration of the youthful rebellion.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":106,\"trailerUrl\":\"https://www.youtube.com/watch?v=sRqWbsdACzg\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002634\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008603\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012851\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012852\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012853\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012854\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012855\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012856\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012857\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"8ddd1648-0036-4a88-99b9-4b2eb84d4838\",\"corporateId\":null},\"hopk\":\"HO00006693\",\"hoCode\":\"A000008259\",\"eventId\":null,\"distributorName\":\"Altitude Film Distribution\"},{\"id\":\"HO00006609\",\"title\":{\"text\":\"Marty Supreme\",\"translations\":[]},\"synopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":149,\"trailerUrl\":\"https://www.youtube.com/watch?v=PNDVyJU99M0\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001403\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001416\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002090\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003985\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003988\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000007063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007210\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011162\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011923\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12808\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12809\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12810\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e033d58e-8545-4f81-a191-03352ebe4cc0\",\"corporateId\":null},\"hopk\":\"HO00006609\",\"hoCode\":\"A000008158\",\"eventId\":null,\"distributorName\":\"Entertainment Film Distributors\"},{\"id\":\"HO00006610\",\"title\":{\"text\":\"Sentimental Value\",\"translations\":[]},\"synopsis\":{\"text\":\"Nora Borg (Renate Reinsve) is an established Oslo stage actress; her younger sister Agnes (Inga Ibsdotter Lilleaas) has chosen family life with her young son. Though markedly different, the two are close and deeply intertwined, having been raised by a single mother after their filmmaker father’s departure years earlier. When the once renowned Gustav (Stellan Skarsgård) attempts to cast Nora in his comeback film, old wounds bleed anew; \\\"Nora rejects his offer, prompting the isolated patriarch to cast American star Rachel Kemp (Elle Fanning), who gradually comes to realize she has unwittingly become part of a deeply personal film drama. Agnes, meanwhile, delves deeper into the family history as Gustav and Nora attempt rapprochement; but the cracks at the base of the family home run deeper than any Borg can grasp, threatening to topple an already shaky foundation.\\r\\n\\r\\nThis special preview is presented in partnership with The Observer and will feature a post-film conversation between film critic Wendy Ide and leading actor Stellan Skarsgård.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Sisters Nora and Agnes reunite with their estranged father, the charismatic Gustav, a once renowned director who offers stage actress Nora a role.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, suicide references\",\"translations\":[]},\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":133,\"trailerUrl\":\"https://www.youtube.com/watch?v=Gb1sSfWb1Og\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001057\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001058\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001695\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002275\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002626\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002629\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002630\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003236\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008105\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012671\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012672\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012673\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012674\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"938\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5b779d8b-e80b-4790-9616-e4b978f19314\",\"corporateId\":null},\"hopk\":\"HO00006610\",\"hoCode\":\"A000008159\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00006740\",\"title\":{\"text\":\"DocHouse: Cuba & Alaska\",\"translations\":[]},\"synopsis\":{\"text\":\"Codenamed Cuba and Alaska, two female field medics serve on the frontlines of the Ukrainian conflict, navigating the absurdity of war with grit, humour and friendship. \\r\\n\\r\\nMostly comprising footage from phones and GoPro cameras attached to their helmets and chests, the film offers rare access to the medics’ daily lives, their reliance on each other a testament to the camaraderie required to survive in this world.\\r\\n\\r\\nA raw and powerful film fueled by Cuba's enormously contagious laughter and Alaska's dark black humour, the two best friends face down the unknown together with a warrior fierceness befitting Thelma & Louise.\\r\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Codenamed Cuba and Alaska, two female field medics serve on the frontlines of the Ukrainian conflict, navigating the absurdity of war with grit, humour and friendship. \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-22\",\"runtimeInMinutes\":93,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000013028\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006740\",\"hoCode\":\"A000008318\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006742\",\"title\":{\"text\":\"DocHouse: Ai Weiwei's Turandot\",\"translations\":[]},\"synopsis\":{\"text\":\"Renowned artist Ai Weiwei makes his debut as an opera director with a radical reinterpretation of Puccini's classic (and controversial) Turandot, at the Rome Opera House.\\r\\n\\r\\nWell known as both an activist and iconoclast, Ai comes into the project freely admitting his lack of experience in opera, and uses that as a starting point to re-think Puccini's masterpiece for the 21st Century. The uncompromising artist works with some of the Opera world's most experienced designers and conductors to build a piece that challenges, inspires, and reflects the global crises of our times. \\r\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Renowned artist Ai Weiwei makes his debut as an opera director with a radical reinterpretation of Puccini's classic (and controversial) Turandot, at the Rome Opera House.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":78,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000013030\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006742\",\"hoCode\":\"A000008320\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006447\",\"title\":{\"text\":\"It Was Just An Accident\",\"translations\":[]},\"synopsis\":{\"text\":\"Winner of the Palme d’Or at Cannes, IT WAS JUST AN ACCIDENT is a fearless tour-de-force from cinematic luminary Jafar Panahi. Both urgently political and deeply humane, this new moral classic confronts truth and uncertainty, revenge and mercy, head-on.\\n\\nWhen auto mechanic Vahid unexpectedly encounters the man who may have been his torturer in prison, he kidnaps him with the intention to exact vengeance. But since the sole clue to Eghbal’s identity is the distinct squeak of his prosthetic leg, Vahid turns to a loose circle of other now-freed victims for confirmation. And the danger only escalates. \\n\\nAs they deal with their past and diverging worldviews, the group struggles to decide: Is this him, without a doubt? What would retribution mean, in actuality? \\n\\nUnraveling against the ever-present backdrop of authoritarianism, IT WAS JUST AN ACCIDENT coalesces into a climactic act of resistance by an Iranian auteur who is no stranger to unjust detainment himself. Powered by thrilling momentum and peerless craft, France’s Best International Feature Film entry to the 98th Academy Awards® asks us to consider – and reconsider – the line between right and wrong.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Winner of the Palme d’Or at Cannes, IT WAS JUST AN ACCIDENT is a fearless tour-de-force from cinematic luminary Jafar Panahi.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate violence\",\"translations\":[]},\"releaseDate\":\"2025-12-05\",\"runtimeInMinutes\":103,\"trailerUrl\":\"https://www.youtube.com/watch?v=9oHw2ubyWE4\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003596\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003696\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003697\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012220\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012221\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012222\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012223\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012224\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012225\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000026\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"f9f201e0-1560-44c9-8910-d407024cbab6\",\"corporateId\":null},\"hopk\":\"HO00006447\",\"hoCode\":\"A000007964\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00006487\",\"title\":{\"text\":\"Frankenstein\",\"translations\":[]},\"synopsis\":{\"text\":\"Oscar-winning director Guillermo del Toro adapts Mary Shelley’s classic tale of Victor Frankenstein, a brilliant but egotistical scientist who brings a creature to life in a monstrous experiment that ultimately leads to the undoing of both the creator and his tragic creation.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Oscar-winning director Guillermo del Toro adapts Mary Shelley’s classic tale of Victor Frankenstein, a brilliant but egotistical scientist who brings a creature to life.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2025-10-17\",\"runtimeInMinutes\":149,\"trailerUrl\":\"https://www.youtube.com/watch?v=8aulMPhE12g\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001390\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001691\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001807\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001808\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002829\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004507\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004991\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007272\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012258\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"4354\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000663\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\",\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dfd152fe-b4d2-44c5-b45e-19aa59a95a7c\",\"corporateId\":null},\"hopk\":\"HO00006487\",\"hoCode\":\"A000008018\",\"eventId\":null,\"distributorName\":\"Netflix\"},{\"id\":\"HO00000447\",\"title\":{\"text\":\"DocHouse: This is Not A Film\",\"translations\":[]},\"synopsis\":{\"text\":\"In 2011, Iranian director Jafar Panahi received a six year prison sentence and a 20 year ban on filmmaking, for 'making propaganda against the system.' How can you make a film when your government has banned you? This clandestine documentary is Panahi's brilliant and brave answer.\\r\\nShot partially on an iPhone and smuggled into France in a cake for a last-minute submission to Cannes, THIS IS NOT A FILM depicts Panahi's day-to-day life while under house arrest in his Tehran apartment. While appealing his sentence, we see him talking to his family and lawyer on the phone, discussing his plight with co-director Mojtaba Mirtahmasb, and reflecting on the meaning and art of filmmaking. What emerges from this intimate self-portrait is a by turns humorous, moving, and defiant statement of creative resilience in the face of oppression.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In 2011, Iranian director Jafar Panahi received a six year prison sentence and a 20 year ban on filmmaking, for 'making propaganda against the system.\",\"translations\":[]},\"censorRatingId\":\"HO00000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-31\",\"runtimeInMinutes\":75,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00000447\",\"hoCode\":\"A000000534\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000012758\",\"name\":{\"givenName\":\"Brittany\",\"familyName\":\"Shyne\",\"middleName\":null}},{\"id\":\"0000001301\",\"name\":{\"givenName\":\"Kaouther \",\"familyName\":\"Ben Hania\",\"midd