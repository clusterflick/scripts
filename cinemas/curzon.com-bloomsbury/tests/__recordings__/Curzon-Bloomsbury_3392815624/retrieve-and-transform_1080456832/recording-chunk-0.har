moviexchangeReleaseId\":\"3869f393-3342-4dc1-9c0a-a7d04e170132\",\"corporateId\":null},\"hopk\":\"HO00006762\",\"hoCode\":\"A000008342\",\"eventId\":null,\"distributorName\":\"Warners\"},{\"id\":\"HO00006777\",\"title\":{\"text\":\"DocHouse: It's Never Over, Jeff Buckley\",\"translations\":[]},\"synopsis\":{\"text\":\"IT\u2019S NEVER OVER, JEFF BUCKLEY, directed by Oscar-nominated filmmaker Amy Berg, covers the life of the rising young star with an otherworldly voice and boundary-pushing artistry, who left the '90s music world reeling when he died suddenly, at age 30, after the release of his critically acclaimed debut album \u201cGrace.\u201d\\r\\n\\r\\nTold through never-before-seen footage from Buckley\u2019s archives and intimate accounts from his mother Mary Guibert, former partners Rebecca Moore and Joan Wasser, Jeff\u2019s former bandmates, including Michael Tighe and Parker Kindred, and luminaries like Ben Harper and Aimee Mann, IT\u2019S NEVER OVER, JEFF BUCKLEY illuminates one of modern music\u2019s most influential and enigmatic figures.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-13\",\"runtimeInMinutes\":106,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000013102\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006777\",\"hoCode\":\"A000008359\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006790\",\"title\":{\"text\":\"DocHouse: Make It Look Real\",\"translations\":[]},\"synopsis\":{\"text\":\"A local photo studio in Pakistan serves as a vibrant cultural hub where personal dreams and community connections are brought to life through photography. \\r\\n\\r\\nFilmmaker Danial Shah, a displaced native, partners with Sakhi, a photographer yearning for a life abroad, to explore the aesthetics and economics of image-making, shaped by socio-political influences and social class. \\r\\n\\r\\nAs customers enter with their unique fantasies and desires, each photograph emerges as a powerful representation of their aspirations, reflecting the intricate interplay between identity and longing.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-14\",\"runtimeInMinutes\":68,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000013224\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006790\",\"hoCode\":\"A000008378\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000013032\",\"name\":{\"givenName\":\"Banin\",\"familyName\":\"Ahmad Nayef\",\"middleName\":null}},{\"id\":\"0000013033\",\"name\":{\"givenName\":\"Sajad\",\"familyName\":\"Mohamad Qasem\",\"middleName\":null}},{\"id\":\"0000013034\",\"name\":{\"givenName\":\"Waheed\",\"familyName\":\"Thabet Khreibat\",\"middleName\":null}},{\"id\":\"0000013035\",\"name\":{\"givenName\":\"Rahim\",\"familyName\":\"AlHaj\",\"middleName\":null}},{\"id\":\"0000013036\",\"name\":{\"givenName\":\"Hasan\",\"familyName\":\"Hadi\",\"middleName\":null}},{\"id\":\"0000013037\",\"name\":{\"givenName\":\"Leah\",\"familyName\":\"Chen Baker\",\"middleName\":null}},{\"id\":\"0000013038\",\"name\":{\"givenName\":\"Yanal\",\"familyName\":\"Kassay\",\"middleName\":null}},{\"id\":\"0000000122\",\"name\":{\"givenName\":\"Margot \",\"familyName\":\"Robbie\",\"middleName\":null}},{\"id\":\"0000004435\",\"name\":{\"givenName\":\"Hong\",\"familyName\":\"Chau\",\"middleName\":null}},{\"id\":\"0000005031\",\"name\":{\"givenName\":\"Shazad\",\"familyName\":\"Latif\",\"middleName\":null}},{\"id\":\"0000005648\",\"name\":{\"givenName\":\"Emerald\",\"familyName\":\"Fennell\",\"middleName\":null}},{\"id\":\"0000005651\",\"name\":{\"given