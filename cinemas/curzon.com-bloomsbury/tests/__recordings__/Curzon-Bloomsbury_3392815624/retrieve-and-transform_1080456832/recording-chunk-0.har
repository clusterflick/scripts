\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00006278\",\"title\":{\"text\":\"Film Club: Darling\",\"translations\":[]},\"synopsis\":{\"text\":\"To mark the centenary of Academy Award-winning director John Schlesinger's birth, we're inviting you to experience his greatest films on the big screen. Season curated by Claire Nicolas and Marc David Jacobs. \\n\\nDARLING\\nA beautiful but amoral model sleeps her way to the top of the London fashion scene at the height of the Swinging Sixties.\\n\\nSoho screens from 35mm. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Beautiful but amoral model Diana Scott sleeps her way to the top of the London fashion scene at the height of the Swinging Sixties.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong sex references\",\"translations\":[]},\"releaseDate\":\"2026-07-04\",\"runtimeInMinutes\":128,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000010274\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011658\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011662\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011663\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000061\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000010274\"},{\"castAndCrewMemberId\":\"0000011658\"},{\"castAndCrewMemberId\":\"HO00000061\