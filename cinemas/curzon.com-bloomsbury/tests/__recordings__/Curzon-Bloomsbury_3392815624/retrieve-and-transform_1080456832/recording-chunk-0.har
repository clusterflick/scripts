          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-04-02\",\"showtimes\":[{\"id\":\"BLO1-107115\",\"schedule\":{\"businessDate\":\"2026-04-02\",\"startsAt\":\"2026-04-02T18:00:00+01:00\",\"endsAt\":\"2026-04-02T20:23:00+01:00\",\"filmStartsAt\":\"2026-04-02T18:25:00+01:00\",\"filmEndsAt\":\"2026-04-02T20:23:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-1-2\",\"filmId\":\"HO00006795\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-1\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006795\",\"title\":{\"text\":\"Film Club: All We Imagine as Light\",\"translations\":[]},\"synopsis\":{\"text\":\"All We Imagine as Light is a beautiful, sweeping, emotional film that explores the complexities of female friendship and captures the frantic pace, the vibrant colours and the heady atmosphere of modern Mumbai.\\n\\nIn the city, thoughtful Nurse Prabha\u2019s routine is upset when she receives an unexpected gift from her estranged husband. Her younger, flightier and rebellious roommate, Anu, tries in vain to find a spot in the city to be intimate with her secret boyfriend. Their colleague Parvaty fights to stay in her home without any requisite paperwork left by her late husband. A trip to a beach town allows them each to find a space for their desires to manifest. \\n\\nPayal Kapadia\u2019s hugely acclaimed fiction debut was the first Indian film to be selected in Official Competition at Cannes in three decades, where it was awarded the Grand Prix.\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A beautiful, sweeping, emotional film that explores the complexities of female friendship and captures the frantic pace, vibrant colours and heady atmosphere of Mumbai.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong sex\",\"translations\":[]},\"releaseDate\":\"2026-03-08\",\"runtimeInMinutes\":118,\"trailerUrl\":\"https://www.youtube.com/watch?v=Yf1jAx6VhZ8\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002839\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002841\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002842\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009909\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010120\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010121\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010122\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010123\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006795\",\"hoCode\":\"A000008384\",\"eventId\":null,\"distributorName\":\"BFI\"}],\"castAndCrew\":[{\"id\":\"0000002839\",\"name\":{\"givenName\":\"Payal\",\"familyName\":\"Kapadia\",\"middleName\":null}},{\"id\":\"0000002841\",\"name\":{\"givenName\":\"Julien\",\"familyName\":\"Graff\",\"middleName\":null}},{\"id\":\"0000002842\",\"name\":{\"givenName\":\"Thomas\",\"familyName\":\"Hakim\",\"middleName\":null}},{\"id\":\"0000009909\",\"name\":{\"givenName\":\"Kani\",\"familyName\":\"Kusruti\",\"middleName\":null}},{\"id\":\"0000010120\",\"name\":{\"givenName\":\"Chhaya \",\"familyName\":\"Kadam\",\"middleName\":null}},{\"id\":\"0000010121\",\"name\":{\"givenName\":\"Divya\",\"familyName\":\"Prabha\",\"middleName\":null}},{\"id\":\"0000010122\",\"name\":{\"givenName\":\"Hridhu\",\"family