            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-03-07\",\"showtimes\":[{\"id\":\"BLO1-107114\",\"schedule\":{\"businessDate\":\"2026-03-07\",\"startsAt\":\"2026-03-07T15:00:00+00:00\",\"endsAt\":\"2026-03-07T17:06:00+00:00\",\"filmStartsAt\":\"2026-03-07T15:25:00+00:00\",\"filmEndsAt\":\"2026-03-07T17:06:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-19\",\"filmId\":\"HO00006811\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006811\",\"title\":{\"text\":\"Film Club: Vagabond\",\"translations\":[]},\"synopsis\":{\"text\":\"Sandrine Bonnaire won a Best Actress César for her portrayal as Mona - a young and defiant drifter in this tragic story. Using a largely non-professional cast, Agnès Varda’s splintered portrait of the enigmatic woman is told through flashbacks of those who encountered her.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A young woman's body is found frozen in a ditch. Through flashbacks and interviews, we see the events that led to her inevitable death.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"Strong language, drug misuse, sexual threat\",\"translations\":[]},\"releaseDate\":\"2026-03-07\",\"runtimeInMinutes\":101,\"trailerUrl\":\"https://www.youtube.com/watch?v=oeY0KTknEv0\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000