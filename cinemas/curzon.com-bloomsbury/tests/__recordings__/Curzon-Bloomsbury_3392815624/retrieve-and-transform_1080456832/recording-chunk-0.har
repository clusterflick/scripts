            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-04\",\"showtimes\":[{\"id\":\"BLO1-111453\",\"schedule\":{\"businessDate\":\"2026-08-04\",\"startsAt\":\"2026-08-04T20:20:00+01:00\",\"endsAt\":\"2026-08-04T21:48:00+01:00\",\"filmStartsAt\":\"2026-08-04T20:27:00+01:00\",\"filmEndsAt\":\"2026-08-04T21:48:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00007228\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007228\",\"title\":{\"text\":\"DocHouse: The Phantom Pain of Rojava\",\"translations\":[]},\"synopsis\":{\"text\":\"In the autonomous Kurdish state of Rojava, northern Syria, a group of female fighters once dreamt of changing the world.\\n\\nIn the shadow of a failed revolution, Emmy-winning director Maryam Ebrahimi captures the hopes and dreams of these former guerrillas. Once celebrated as global heroes in the war against Islamic State, they now find themself abandoned by their allies, living secretly in a house for wounded soldiers.\\n\\nTHE PHANTOM PAIN OF ROJAVA is a post-war story, following a hidden community over the course of five years, as they struggle to rebuild their bodies and maintain their faith in the Women’s Revolution they dedicated their lives to protecting.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":81,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014337\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000014337\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007228\",\"hoCode\":\"A000008894\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000014337\",\"name\":{\"givenName\":\"Maryam\",\"familyName\":\"Embrahimi \",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000012\",\"name\":{\"text\":\"Programmed by Bertha Dochouse\",\"translations\":[]},\"shortName\":{\"text\":\"Dochouse\",\"translations\":[]},\"description\":{\"text\":\"Programmed by Bertha Dochouse | Preshows: 5 minutes\",\"translations\":[]},\"importantMessage\":{\"text\":\"Preshows: 5 minutes\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"BLO1-6\",\"name\":{\"text\":\"Bertha Dochouse\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"BLO1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
