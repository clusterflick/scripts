e,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-110836\",\"schedule\":{\"businessDate\":\"2026-07-22\",\"startsAt\":\"2026-07-22T19:30:00+01:00\",\"endsAt\":\"2026-07-22T22:47:00+01:00\",\"filmStartsAt\":\"2026-07-22T19:55:00+01:00\",\"filmEndsAt\":\"2026-07-22T22:47:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-19\",\"filmId\":\"HO00007116\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000024\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"BLO1-130-HO00007116\"}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007116\",\"title\":{\"text\":\"The Odyssey\",\"translations\":[]},\"synopsis\":{\"text\":\"Legendary filmmaker Christopher Nolan follows up his Oscar-winning sensation Oppenheimer with another rousing epic, The Odyssey, whose all-star cast includes Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson, Lupita Nyong'o, Zendaya and Charlize Theron.\\n\\nThis mythic action movie recounts the story of Odysseus (Damon) on his perilous journey home, troubled by gods and monsters. Meanwhile, his wife Penelope (Hathaway) and son Telemachus (Holland) fight to hold their kingdom together against relentless suitors.\\n\\nSee it on 35mm film at Soho, and enjoy it with Dolby Atmos sound at Bloomsbury, Canterbury Riverside and Kingston.\\n\\nTHE ODYSSEY MIDNIGHT SCREENINGS\\nThe film will start promptly at 12:01am on Thursday night. Please ensure you are seated by midnight.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":172,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/b3ff6b75-3025-43b7-88a5-37fc8c43d313/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000319\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000680\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001061\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002220\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002609\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003850\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004443\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005731\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000014094\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000319\"},{\"castAndCrewMemberId\":\"0000000680\"},{\"castAndCrewMemberId\":\"0000001061\"},{\"castAndCrewMemberId\":\"0000002220\"},{\"castAndCrewMemberId\":\"0000002609\"},{\"castAndCrewMemberId\":\"0000003850\"},{\"castAndCrewMemberId\":\"0000004443\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000005731\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000005731\"},{\"castAndCrewMemberId\":\"0000014094\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b3ff6b75-3025-43b7-88a5-37fc8c43d313\",\"corporateId\":null},\"hopk\":\"HO00007116\",\"hoCode\":\"A000008764\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00007180\",\"title\":{\"text\":\"DocHouse: The Secret Reading Club of Kabul\",\"translations\":[]},\"synopsis\":{\"text\":\"In Taliban-controlled Afghanistan, where women are barred from education, work, and public life, a group of young women secretly form a reading club.\\n\\nInspired by The Diary of Anne Frank, they document their lives through handwritten diaries and covert phone footage, recording moments of fear, defiance, and solidarity. Filmed from within, the story follows Taliban raids on a hidden school, the arrest of girls practicing martial arts, and escalating threats that force one member into exile. Interwoven with their journey is director Shakiba Adil’s return, as she reconnects with a new generation confronting the same repression she once fled.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":90,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014229\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014230\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000014229\"},{\"castAndCrewMemberId\":\"0000014230\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007180\",\"hoCode\":\"A000008835\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000000319\",\"name\":{\"givenName\":\"Zendaya\",\"familyName\":\"\",\"middleName\":null}},{\"id\":\"0000000680\",\"name\":{\"givenName\":\"Charlize\",\"familyName\":\"Theron\",\"middleName\":null}},{\"id\":\"0000001061\",\"name\":{\"givenName\":\"Matt\",\"familyName\":\"Damon\",\"middleName\":null}},{\"id\":\"0000002220\",\"name\":{