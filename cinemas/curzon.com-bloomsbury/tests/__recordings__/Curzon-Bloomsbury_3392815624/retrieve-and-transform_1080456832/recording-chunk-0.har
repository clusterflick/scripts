            "text": "{\"businessDate\":\"2026-07-27\",\"showtimes\":[{\"id\":\"BLO1-111456\",\"schedule\":{\"businessDate\":\"2026-07-27\",\"startsAt\":\"2026-07-27T18:20:00+01:00\",\"endsAt\":\"2026-07-27T20:32:00+01:00\",\"filmStartsAt\":\"2026-07-27T18:57:00+01:00\",\"filmEndsAt\":\"2026-07-27T20:32:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00007230\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\",\"0000000009\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007230\",\"title\":{\"text\":\"DocHouse: How to Feed a Dictator\",\"translations\":[]},\"synopsis\":{\"text\":\"This film tells the story of five brutal regimes, from Iraq to North Korea, through the eyes of the personal chefs who served them.\\n\\nThrough recipes, rituals and remembrance, a portrait emerges of power, manipulation and the quiet ways ordinary people become entangled in extraordinary violence. Loyalty, denial, fear, even thrill, each chef carries their experience differently, yet together they reveal how dictatorship gets under the skin of everyone it touches. HOW TO FEED A DICTATOR is darkly funny, deeply human and impossible to shake, proof that the most revealing place to understand a regime is not the war room but the kitchen.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-27\",\"runtimeInMinutes\":95,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014338\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000014338\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007230\",\"hoCode\":\"A000008895\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000014338\",\"name\":{\"givenName\":\"Andrew\",\"familyName\":\"Neel\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000012\",\"name\":{\"text\":\"Programmed by Bertha Dochouse\",\"translations\":[]},\"shortName\":{\"text\":\"Dochouse\",\"translations\":[]},\"description\":{\"text\":\"Programmed by Bertha Dochouse | Preshows: 5 minutes\",\"translations\":[]},\"importantMessage\":{\"text\":\"Preshows: 5 minutes\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false},{\"id\":\"0000000009\",\"name\":{\"text\":\"Screening followed by a Q&A\",\"translations\":[]},\"shortName\":{\"text\":\"Q&A\",\"translations\":[]},\"description\":{\"text\":\"Q&A\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"BLO1-6\",\"name\":{\"text\":\"Bertha Dochouse\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"BLO1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailab