201d\\r\\n\\r\\nTold through never-before-seen footage from Buckley\u2019s archives and intimate accounts from his mother Mary Guibert, former partners Rebecca Moore and Joan Wasser, Jeff\u2019s former bandmates, including Michael Tighe and Parker Kindred, and luminaries like Ben Harper and Aimee Mann, IT\u2019S NEVER OVER, JEFF BUCKLEY illuminates one of modern music\u2019s most influential and enigmatic figures.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-13\",\"runtimeInMinutes\":106,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000013102\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006777\",\"hoCode\":\"A000008359\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000013032\",\"name\":{\"givenName\":\"Banin\",\"familyName\":\"Ahmad Nayef\",\"middleName\":null}},{\"id\":\"0000013033\",\"name\":{\"givenName\":\"Sajad\",\"familyName\":\"Mohamad Qasem\",\"middleName\":null}},{\"id\":\"0000013034\",\"name\":{\"givenName\":\"Waheed\",\"familyName\":\"Thabet Khreibat\",\"middleName\":null}},{\"id\":\"0000013035\",\"name\":{\"givenName\":\"Rahim\",\"familyName\":\"AlHaj\",\"middleName\":null}},{\"id\":\"0000013036\",\"name\":{\"givenName\":\"Hasan\",\"familyName\":\"Hadi\",\"middleName\":null}},{\"id\":\"0000013037\",\"name\":{\"givenName\":\"Leah\",\"familyName\":\"Chen Baker\",\"middleName\":null}},{\"id\":\"0000013038\",\"name\":{\"givenName\":\"Yanal\",\"familyName\":\"Kassay\",\"middleName\":null}},{\"id\":\"0000000122\",\"name\":{\"givenName\":\"Margot \",\"familyName\":\"Robbie\",\"middleName\":null}},{\"id\":\"0000004435\",\"name\":{\"givenName\":\"Hong\",\"familyName\":\"Chau\",\"middleName\":null}},{\"id\":\"0000005031\",\"name\":{\"givenName\":\"Shazad\",\"familyName\":\"Latif\",\"middleName\":null}},{\"