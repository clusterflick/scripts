            "text": "{\"businessDate\":\"2026-07-30\",\"showtimes\":[{\"id\":\"BLO1-111449\",\"schedule\":{\"businessDate\":\"2026-07-30\",\"startsAt\":\"2026-07-30T15:00:00+01:00\",\"endsAt\":\"2026-07-30T16:38:00+01:00\",\"filmStartsAt\":\"2026-07-30T15:07:00+01:00\",\"filmEndsAt\":\"2026-07-30T16:38:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00007227\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-111646\",\"schedule\":{\"businessDate\":\"2026-07-30\",\"startsAt\":\"2026-07-30T18:00:00+01:00\",\"endsAt\":\"2026-07-30T20:34:00+01:00\",\"filmStartsAt\":\"2026-07-30T18:20:00+01:00\",\"filmEndsAt\":\"2026-07-30T20:34:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-26\",\"filmId\":\"HO00007251\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000017\",\"0000000009\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-111444\",\"schedule\":{\"businessDate\":\"2026-07-30\",\"startsAt\":\"2026-07-30T18:20:00+01:00\",\"endsAt\":\"2026-07-30T19:57:00+01:00\",\"filmStartsAt\":\"2026-07-30T18:27:00+01:00\",\"filmEndsAt\":\"2026-07-30T19:57:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00007226\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007226\",\"title\":{\"text\":\"DocHouse: Flavors of Iraq\",\"translations\":[]},\"synopsis\":{\"text\":\"French-born journalist Feurat Alani narrates this animated documentary about his complicated connection to Iraq, the country of his parents. His gripping storytelling comes to life with director Léonard Cohen's evocative animation, conjuring up Alani's family in Iraq and his own introduction to the country as a boy, under the dictatorship of Saddam Hussein. With touching vulnerability, Alani depicts his relationship with his revolutionary father, who was exiled from his homeland but never lost his love for her.\\n\\nNimbly covering 5 decades of upheaval, from Iraq's invasion of Kuwait to the American occupation and the subsequent rise of Al Qaeda and Islamic State, Alani presents a piercing perspective on US intervention in the region from a place of deep, personal understanding.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-24\",\"runtimeInMinutes\":90,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004092\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000004092\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007226\",\"hoCode\":\"A000008891\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00007227\",\"title\":{\"text\":\"DocHouse: Ask E. Jean\",\"translations\":[]},\"synopsis\":{\"text\":\"Across a five-decade career, E. Jean Carroll has emerged as a trailblazing journalist, talk show host and beloved advice columnist, conquering the male dominated publishing world of 1980s and 90s New York with a fearless voice all her own. \\n\\nIn recent years, she has fought a high profile legal battle against Donald Trump for sexual assault and defamation, becoming the only woman to beat him in court. Twice. ASK E. JEAN is both a portrait of the thrilling, storied life of a singular icon, and a gutsy exploration of what it takes for a woman to stand up to power and prove she is telling the truth about a historic assault. With the multi-million dollar bill for damages still unpaid and the legal battle rumbling on through the courts and the headlines, ASK E. JEAN is critical viewing.  \",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-24\",\"runtimeInMinutes\":91,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014336\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000014336\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007227\",\"hoCode\":\"A000008892\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00007251\",\"title\":{\"text\":\"Love Me Tender\",\"translations\":[]},\"synopsis\":{\"text\":\"At the end of summer, Clémence tells her ex-husband that she’s had relationships with women. Her life is turned upside down when he files to strip her of their son’s custody. Then begins a struggle of several years for Clémence to defend her right to be a mother and a woman – free to make her own choices. \\nBased on novel by Constance Debre\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After coming out to her ex-husband, Clemence (Vicky Krieps) must fight a brutal custody battle to keep her son—and her right to love who she chooses.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-07\",\"runtimeInMinutes\":134,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/7de38a3e-c295-446c-98e7-1b73dc5f6120/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=3FzA5KO0M_I\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=3FzA5KO0M_I\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000784\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005773\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006130\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009197\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014349\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014350\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014351\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000784\"},{\"castAndCrewMemberId\":\"0000006130\"},{\"castAndCrewMemberId\":\"0000009197\"},{\"castAndCrewMemberId\":\"0000014349\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000014350\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000005773\"},{\"castAndCrewMemberId\":\"0000014351\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"7de38a3e-c295-446c-98e7-1b73dc5f6120\",\"corporateId\":null},\"hopk\":\"HO00007251\",\"hoCode\":\"A000008919\",\"eventId\":null,\"distributorName\":\"Peccadillo Pictures\"}],\"castAndCrew\":[{\"id\":\"0000004092\",\"name\":{\"givenName\":\"Leonard\",\"familyName\":\"Cohen\",\"middleName\":null}},{\"id\":\"0000014336\",\"name\":{\"givenName\":\"Ivy\",\"familyName\":\"Meeropol\",\"middleName\":null}},{\"id\":\"0000000784\",\"name\":{\"givenName\":\"Vicky \",\"familyName\":\"Krieps\",\"middleName\":nul