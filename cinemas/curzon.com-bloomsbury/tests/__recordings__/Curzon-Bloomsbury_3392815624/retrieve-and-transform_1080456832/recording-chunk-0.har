            "text": "{\"businessDate\":\"2026-07-19\",\"showtimes\":[{\"id\":\"BLO1-110827\",\"schedule\":{\"businessDate\":\"2026-07-19\",\"startsAt\":\"2026-07-19T12:10:00+01:00\",\"endsAt\":\"2026-07-19T15:27:00+01:00\",\"filmStartsAt\":\"2026-07-19T12:35:00+01:00\",\"filmEndsAt\":\"2026-07-19T15:27:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-19\",\"filmId\":\"HO00007116\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000024\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"BLO1-130-HO00007116\"},{\"id\":\"BLO1-111233\",\"schedule\":{\"businessDate\":\"2026-07-19\",\"startsAt\":\"2026-07-19T14:00:00+01:00\",\"endsAt\":\"2026-07-19T15:37:00+01:00\",\"filmStartsAt\":\"2026-07-19T14:07:00+01:00\",\"filmEndsAt\":\"2026-07-19T15:37:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00007180\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-110826\",\"schedule\":{\"businessDate\":\"2026-07-19\",\"startsAt\":\"2026-07-19T15:45:00+01:00\",\"endsAt\":\"2026-07-19T19:02:00+01:00\",\"filmStartsAt\":\"2026-07-19T16:10:00+01:00\",\"filmEndsAt\":\"2026-07-19T19:02:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-19\",\"filmId\":\"HO00007116\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000024\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"BLO1-130-HO00007116\"},{\"id\":\"BLO1-111639\",\"schedule\":{\"businessDate\":\"2026-07-19\",\"startsAt\":\"2026-07-19T16:00:00+01:00\",\"endsAt\":\"2026-07-19T17:18:00+01:00\",\"filmStartsAt\":\"2026-07-19T16:07:00+01:00\",\"filmEndsAt\":\"2026-07-19T17:18:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00007171\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-111237\",\"schedule\":{\"businessDate\":\"2026-07-19\",\"startsAt\":\"2026-07-19T18:00:00+01:00\",\"endsAt\":\"2026-07-19T19:47:00+01:00\",\"filmStartsAt\":\"2026-07-19T18:07:00+01:00\",\"filmEndsAt\":\"2026-07-19T19:47:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00007185\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-110825\",\"schedule\":{\"businessDate\":\"2026-07-19\",\"startsAt\":\"2026-07-19T19:30:00+01:00\",\"endsAt\":\"2026-07-19T22:47:00+01:00\",\"filmStartsAt\":\"2026-07-19T19:55:00+01:00\",\"filmEndsAt\":\"2026-07-19T22:47:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-19\",\"filmId\":\"HO00007116\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000024\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"BLO1-130-HO00007116\"}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007116\",\"title\":{\"text\":\"The Odyssey\",\"translations\":[]},\"synopsis\":{\"text\":\"Legendary filmmaker Christopher Nolan follows up his Oscar-winning sensation Oppenheimer with another rousing epic, The Odyssey, whose all-star cast includes Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson, Lupita Nyong'o, Zendaya and Charlize Theron.\\n\\nThis mythic action movie recounts the story of Odysseus (Damon) on his perilous journey home, troubled by gods and monsters. Meanwhile, his wife Penelope (Hathaway) and son Telemachus (Holland) fight to hold their kingdom together against relentless suitors.\\n\\nSee it on 35mm film at Soho, and enjoy it with Dolby Atmos sound at Bloomsbury, Canterbury Riverside and Kingston.\\n\\nTHE ODYSSEY MIDNIGHT SCREENINGS\\nThe film will start promptly at 12:01am on Thursday night. Please ensure you are seated by midnight.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":172,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/b3ff6b75-3025-43b7-88a5-37fc8c43d313/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000319\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000680\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001061\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002220\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002609\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003850\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004443\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005731\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000014094\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000319\"},{\"castAndCrewMemberId\":\"0000000680\"},{\"castAndCrewMemberId\":\"0000001061\"},{\"castAndCrewMemberId\":\"0000002220\"},{\"castAndCrewMemberId\":\"0000002609\"},{\"castAndCrewMemberId\":\"0000003850\"},{\"castAndCrewMemberId\":\"0000004443\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000005731\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000005731\"},{\"castAndCrewMemberId\":\"0000014094\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b3ff6b75-3025-43b7-88a5-37fc8c43d313\",\"corporateId\":null},\"hopk\":\"HO00007116\",\"hoCode\":\"A000008764\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00007171\",\"title\":{\"text\":\"DocHouse: Synthetic Sincerity\",\"translations\":[]},\"synopsis\":{\"text\":\"Marc Isaacs returns with a curious interrogation of the new world of AI authenticity, in a humorous hybrid that plays with form and with expectations. \\n\\nThe Synthetic Sincerity Lab based at the University of Southern England are trying to create authentic AI characters as part of a new research project. The lab wish to license Marc Isaacs' films in order to study the real people he has captured, helping the to create more realistic AIs. In return, they will let the filmmaker document their working process.\\n\\nSo Synthetic Sincerity leads us down the rabbit hole into a winding world of documentary, fiction, reality and synthetic creation, reflecting on what is happening to the human face in the era of AI, and what this might mean for the future of cinema.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-12\",\"runtimeInMinutes\":71,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000659\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000000659\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007171\",\"hoCode\":\"A000008825\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00007180\",\"title\":{\"text\":\"DocHouse: The Secret Reading Club of Kabul\",\"translations\":[]},\"synopsis\":{\"text\":\"In Taliban-controlled Afghanistan, where women are barred from education, work, and public life, a group of young women secretly form a reading club.\\n\\nInspired by The Diary of Anne Frank, they document their lives through handwritten diaries and covert phone footage, recording moments of fear, defiance, and solidarity. Filmed from within, the story follows Taliban raids on a hidden school, the arrest of girls practicing martial arts, and escalating threats that force one member into exile. Interwoven with their journey is director Shakiba Adil’s return, as she reconnects with a new generation confronting the same repression she once fled.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":90,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014229\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014230\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000014229\"},{\"castAndCrewMemberId\":\"0000014230\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007180\",\"hoCode\":\"A000008835\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00007185\",\"title\":{\"text\":\"DocHouse: Savage Mountain\",\"translations\":[]},\"synopsis\":{\"text\":\"Kristin Harila stunned the climbing community in 2023 when she set out to become the fastest person to summit the world’s 14 highest peaks. Alongside her climbing partner, Tenjen Lama Sherpa, she achieved what many believed impossible, summiting all 14 in just 92 days and halving the record held by Nims Purja.\\n\\nBut, what should have been her greatest triumph became a reckoning. During the final ascent, Kristin was accused of stepping over a dying porter, triggering a global backlash and fierce debate about ambition, ethics, and who controls the narrative. Drawing on never‑before‑seen footage from K2, the film unpacks the story behind the controversy.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-05\",\"runtimeInMinutes\":100,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014327\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000014327\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007185\",\"hoCode\":\"A000008840\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000000319\",\"name\":{\"givenName\":\"Zendaya\",\"familyName\":\"\",\"middleName\":null}},{\"id\":\"0000000680\",\"name\":{\"givenName\":\"Charlize\",\"familyName\":\"Theron\",\