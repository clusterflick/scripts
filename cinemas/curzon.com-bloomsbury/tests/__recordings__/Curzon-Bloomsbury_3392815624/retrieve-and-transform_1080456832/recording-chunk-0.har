            "text": "{\"businessDate\":\"2026-02-24\",\"showtimes\":[{\"id\":\"BLO1-106935\",\"schedule\":{\"businessDate\":\"2026-02-24\",\"startsAt\":\"2026-02-24T18:20:00+00:00\",\"endsAt\":\"2026-02-24T19:47:00+00:00\",\"filmStartsAt\":\"2026-02-24T18:27:00+00:00\",\"filmEndsAt\":\"2026-02-24T19:47:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006789\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006789\",\"title\":{\"text\":\"DocHouse: The Last Ambassador\",\"translations\":[]},\"synopsis\":{\"text\":\"What do you do as an ambassador for Afghanistan when the Taliban take power and you are a feminist? You fight back - at least if you're Manizha Bakhtari.\\r\\n\\r\\nThe Afghan ambassador in Vienna at the moment that Taliban took power in 2021, Ms Bakhtari found herself representing a country whose government had fled, and a new regime she refused to recognise. Despite financial and logistical isolation, she defied the Taliban to continue her fight for the rights of Afghan women and girls, staying true to her motto \u2018peace is not the absence of war, but the presence of justice\u2019.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-24\",\"runtimeInMinutes\":80,\"trailerUrl\":null,\"displayPriority\":50,\"c