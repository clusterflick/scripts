          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-09-01\",\"showtimes\":[{\"id\":\"BLO1-111634\",\"schedule\":{\"businessDate\":\"2026-09-01\",\"startsAt\":\"2026-09-01T18:00:00+01:00\",\"endsAt\":\"2026-09-01T19:29:00+01:00\",\"filmStartsAt\":\"2026-09-01T18:07:00+01:00\",\"filmEndsAt\":\"2026-09-01T19:29:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-1-2\",\"filmId\":\"HO00007240\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-1\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007240\",\"title\":{\"text\":\"Curzon Film 50: The Gleaners and I\",\"translations\":[]},\"synopsis\":{\"text\":\"In 2000, Agnès Varda travelled the French countryside to study the world of foragers and scavengers called The Gleaners. Describing herself as a gleaner of ideas and images from interior as well as exterior journeys gives the director a special connection with her subjects in this honest and intriguing documentary.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Varda films and interviews gleaners in France in all forms, from those picking fields after the harvest to those scouring the dumpsters of Paris.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":{\"text\":\"Infrequent mild bad language\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":82,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"HO00000516\",\"roles\":[\"Actor\",\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000878\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000879\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"HO00000516\"},{\"castAndCrewMemberId\":\"HO00000878\"},{\"castAndCrewMemberId\":\"HO00000879\"}],\"directors\":[{\"castAndCrewMemberId\":\"HO00000516\"}],\"producers\":[{\"castAndCrewMemberId\":\"HO00000516\"}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007240\",\"hoCode\":\"A000008906\",\"eventId\":\"0000000068\",\"distributorName\":\"Curzon\"}],\"castAndCrew\":[{\"id\":\"HO00000516\",\"name\":{\"givenName\":\"Agnès\",\"familyName\":\"Varda\",\"middleName\":null}},{\"id\":\"HO00000878\",\"name\":{\"givenName\":\"Bodan\",\"familyName\":\"Litnanski\",\"middleName\":null}},{\"id\":\"HO00000879\",\"name\":{\"givenName\":\"François\",\"familyName\":\"Wertheimer\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"HO00000002\",\"classification\":{\"text\":\"PG\",\"translations\":[]},\"classificationDescription\":{\"text\":\"PG\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000053\",\"name\":{\"text\":\"Film Club\",\"translations\":[]},\"shortName\":{\"text\":\"Film Club\",\"translations\":[]},\"description\":{\"text\":\"Film Club Screening. Browse more at curzon.com/film-club\",\"translations\":[]},\"importantMessage\":{\"text\":\"Film Club Screening\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"BLO1-1\",\"name\":{\"text\":\"Lumiere Screen\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000068\",\"name\":{\"text\":\"Curzon Film 50\",\"translatio