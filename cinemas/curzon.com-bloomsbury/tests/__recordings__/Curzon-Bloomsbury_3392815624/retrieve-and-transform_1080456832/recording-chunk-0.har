:\"0000012829\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012830\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012831\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000026\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9ecc0908-a983-42f7-9591-6f8d73d7488b\",\"corporateId\":null},\"hopk\":\"HO00006689\",\"hoCode\":\"A000008255\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00006691\",\"title\":{\"text\":\"Is This Thing On?\",\"translations\":[]},\"synopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family \u2014 forcing them to navigate co-parenting, identity, and whether love can take a new form.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":121,\"trailerUrl\":\"https://www.youtube.com/watch?v=ngmu5zGOa7s\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002276\",\"roles\":[\"Actor\",\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003003\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003138\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006446\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007571\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000012836\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012837\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012838\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4e47345d-b26d-4559-847e-3add7a11d75a\",\"corporateId\":null},\"hopk\":\"HO00006691\",\"hoCode\":\"A000008257\",\"eventId\":null,\"distributorName\":\"Walt Disney Studios Motion Pictures - UK\"},{\"id\":\"HO00006693\",\"title\":{\"text\":\"Nouvelle Vague\",\"translations\":[]},\"synopsis\":{\"text\":\"A playful, poignant love letter to cinema, Nouvelle Vague reimagines the making of Jean-Luc Godard\u2019s Breathless in an exuberant exploration of the youthful rebellion and creative chaos that shaped the French New Wave.\\n\\nDirected by Richard Linklater, starring Zoey Deutch, Guillaume Marbeck, and Aubry Dullin.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A playful, poignant love letter to cinema, Nouvelle Vague reimagines the making of Jean-Luc Godard\u2019s Breathless in an exuberant exploration of the youthful rebellion.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":106,\"trailerUrl\":\"https://www.youtube.com/watch?v=sRqWbsdACzg\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002634\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008603\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012851\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012852\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012853\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012854\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012855\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012856\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012857\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"8ddd1648-0036-4a88-99b9-4b2eb84d4838\",\"corporateId\":null},\"hopk\":\"HO00006693\",\"hoCode\":\"A000008259\",\"eventId\":null,\"distributorName\":\"Altitude Film Distribution\"},{\"id\":\"HO00006609\",\"title\":{\"text\":\"Marty Supreme\",\"translations\":[]},\"synopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":149,\"trailerUrl\":\"https://www.youtube.com/watch?v=PNDVyJU99M0\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001403\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001416\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002090\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003985\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003988\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000007063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007210\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011162\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011923\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12808\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12809\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12810\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e033d58e-8545-4f81-a191-03352ebe4cc0\",\"corporateId\":null},\"hopk\":\"HO00006609\",\"hoCode\":\"A000008158\",\"eventId\":null,\"distributorName\":\"Entertainment Film Distributors\"},{\"id\":\"HO00006740\",\"title\":{\"text\":\"DocHouse: Cuba & Alaska\",\"translations\":[]},\"synopsis\":{\"text\":\"Codenamed Cuba and Alaska, two female field medics serve on the frontlines of the Ukrainian conflict, navigating the absurdity of war with grit, humour and friendship. \\r\\n\\r\\nMostly comprising footage from phones and GoPro cameras attached to their helmets and chests, the film offers rare access to the medics\u2019 daily lives, their reliance on each other a testament to the camaraderie required to survive in this world.\\r\\n\\r\\nA raw and powerful film fueled by Cuba's enormously contagious laughter and Alaska's dark black humour, the two best friends face down the unknown together with a warrior fierceness befitting Thelma & Louise.\\r\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Codenamed Cuba and Alaska, two female field medics serve on the frontlines of the Ukrainian conflict, navigating the absurdity of war with grit, humour and friendship. \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-22\",\"runtimeInMinutes\":93,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000013028\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006740\",\"hoCode\":\"A000008318\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006742\",\"title\":{\"text\":\"DocHouse: Ai Weiwei's Turandot\",\"translations\":[]},\"synopsis\":{\"text\":\"Renowned artist Ai Weiwei makes his debut as an opera director with a radical reinterpretation of Puccini's classic (and controversial) Turandot, at the Rome Opera House.\\r\\n\\r\\nWell known as both an activist and iconoclast, Ai comes into the project freely admitting his lack of experience in opera, and uses that as a starting point to re-think Puccini's masterpiece for the 21st Century. The uncompromising artist works with some of the Opera world's most experienced designers and conductors to build a piece that challenges, inspires, and reflects the global crises of our times. \\r\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Renowned artist Ai Weiwei makes his debut as an opera director with a radical reinterpretation of Puccini's classic (and controversial) Turandot, at the Rome Opera House.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":78,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000013030\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006742\",\"hoCode\":\"A000008320\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006447\",\"title\":{\"text\":\"It Was Just An Accident\",\"translations\":[]},\"synopsis\":{\"text\":\"Winner of the Palme d\u2019Or at Cannes, IT WAS JUST AN ACCIDENT is a fearless tour-de-force from cinematic luminary Jafar Panahi. Both urgently political and deeply humane, this new moral classic confronts truth and uncertainty, revenge and mercy, head-on.\\n\\nWhen auto mechanic Vahid unexpectedly encounters the man who may have been his torturer in prison, he kidnaps him with the intention to exact vengeance. But since the sole clue to Eghbal\u2019s identity is the distinct squeak of his prosthetic leg, Vahid turns to a loose circle of other now-freed victims for confirmation. And the danger only escalates. \\n\\nAs they deal with their past and diverging worldviews, the group struggles to decide: Is this him, without a doubt? What would retribution mean, in actuality? \\n\\nUnraveling against the ever-present backdrop of authoritarianism, IT WAS JUST AN ACCIDENT coalesces into a climactic act of resistance by an Iranian auteur who is no stranger to unjust detainment himself. Powered by thrilling momentum and peerless craft, France\u2019s Best International Feature Film entry to the 98th Academy Awards\u00ae asks us to consider \u2013 and reconsider \u2013 the line between right and wrong.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Winner of the Palme d\u2019Or at Cannes, IT WAS JUST AN ACCIDENT is a fearless tour-de-force from cinematic luminary Jafar Panahi.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate violence\",\"translations\":[]},\"releaseDate\":\"2025-12-05\",\"runtimeInMinutes\":103,\"trailerUrl\":\"https://www.youtube.com/watch?v=9oHw2ubyWE4\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003596\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003696\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003697\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012220\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012221\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012222\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012223\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012224\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012225\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000026\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"f9f201e0-1560-44c9-8910-d407024cbab6\",\"corporateId\":null},\"hopk\":\"HO00006447\",\"hoCode\":\"A000007964\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00006487\",\"title\":{\"text\":\"Frankenstein\",\"translations\":[]},\"synopsis\":{\"text\":\"Oscar-winning director Guillermo del Toro adapts Mary Shelley\u2019s classic tale of Victor Frankenstein, a brilliant but egotistical scientist who brings a creature to life in a monstrous experiment that ultimately leads to the undoing of both the creator and his tragic creation.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Oscar-winning director Guillermo del Toro adapts Mary Shelley\u2019s classic tale of Victor Frankenstein, a brilliant but egotistical scientist who brings a creature to life.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2025-10-17\",\"runtimeInMinutes\":149,\"trailerUrl\":\"https://www.youtube.com/watch?v=8aulMPhE12g\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001390\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001691\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001807\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001808\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002829\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004507\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004991\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007272\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012258\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"4354\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000663\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\",\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dfd152fe-b4d2-44c5-b45e-19aa59a95a7c\",\"corporateId\":null},\"hopk\":\"HO00006487\",\"hoCode\":\"A000008018\",\"eventId\":null,\"distributorName\":\"Netflix\"},{\"id\":\"HO00000447\",\"title\":{\"text\":\"DocHouse: This is Not A Film\",\"translations\":[]},\"synopsis\":{\"text\":\"In 2011, Iranian director Jafar Panahi received a six year prison sentence and a 20 year ban on filmmaking, for 'making propaganda against the system.' How can you make a film when your government has banned you? This clandestine documentary is Panahi's brilliant and brave answer.\\r\\nShot partially on an iPhone and smuggled into France in a cake for a last-minute submission to Cannes, THIS IS NOT A FILM depicts Panahi's day-to-day life while under house arrest in his Tehran apartment. While appealing his sentence, we see him talking to his family and lawyer on the phone, discussing his plight with co-director Mojtaba Mirtahmasb, and reflecting on the meaning and art of filmmaking. What emerges from this intimate self-portrait is a by turns humorous, moving, and defiant statement of creative resilience in the face of oppression.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In 2011, Iranian director Jafar Panahi received a six year prison sentence and a 20 year ban on filmmaking, for 'making propaganda against the system.\",\"translations\":[]},\"censorRatingId\":\"HO00000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-31\",\"runtimeInMinutes\":75,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00000447\",\"hoCode\":\"A000000534\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000001301\",\"name\":{\"givenName\":\"Kaouther \",\"familyName\":\"Ben Hania\",\"middleName\":null}},{\"id\":\"0000012772\",\"name\":{\"givenName\":\"Saja\",\"familyName\":\"Kilani\",\"middleName\":null}},{\"id\":\"0000012773\",\"name\":{\"givenName\":\"Motaz\",\"familyName\":\"Malhees\",\"middleName\":null}},{\"id\":\"0000012774\",\"name\":{\"givenName\":\"Clara\",\"familyName\":\"Khoury\",\"middleName\":null}},{\"id\":\"0000000175\",\"name\":{\"givenName\":\"Chlo\u00e9 \",\"familyName\":\"Zhao\",\"middleName\":null}},{\"id\":\"0000001040\",\"name\":{\"givenName\":\"Joe\",\"familyName\":\"Alwyn\",\"middleName\":null}},{\"id\":\"0000001087\",\"name\":{\"givenName\":\"Jessie\",\"familyName\":\"Buckley\",\"middleName\":null}},{\"id\":\"0000002138\",\"name\":{\"givenName\":\"Steven\",\"familyName\":\"Spielberg\",\"middleName\":null}},{\"id\":\"0000002310\",\"name\":{\"givenName\":\"Paul\",\"familyName\":\"Mescal\",\"middleName\":null}},{\"id\":\"0000004702\",\"name\":{\"givenName\":\"Sam\",\"familyName\":\"Mendes\",\"middleName\":null}},{\"id\":\"0000004703\",\"name\":{\"givenName\":\"Pippa\",\"familyName\":\"Harris\",\"middleName\":null}},{\"id\":\"0000005314\",\"name\":{\"givenName\":\"Emily\",\"familyName\":\"Watson\",\"middleName\":null}},{\"id\":\"0000007765\",\"name\":{\"givenName\":\"Liza\",\"familyName\":\"Marshall\",\"middleName\":null}},{\"id\":\"0000012800\",\"name\":{\"givenName\":\"Nicolas\",\"familyName\":\"Gonda\",\"middleName\":null}},{\"id