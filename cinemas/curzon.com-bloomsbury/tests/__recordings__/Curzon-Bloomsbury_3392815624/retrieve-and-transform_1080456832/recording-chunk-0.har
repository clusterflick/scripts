:\"BLO1\",\"screenId\":\"BLO1-2\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-106851\",\"schedule\":{\"businessDate\":\"2026-01-29\",\"startsAt\":\"2026-01-29T20:50:00+00:00\",\"endsAt\":\"2026-01-29T23:32:00+00:00\",\"filmStartsAt\":\"2026-01-29T21:13:00+00:00\",\"filmEndsAt\":\"2026-01-29T23:32:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-3-8\",\"filmId\":\"HO00006689\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-3\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-106853\",\"schedule\":{\"businessDate\":\"2026-01-29\",\"startsAt\":\"2026-01-29T21:00:00+00:00\",\"endsAt\":\"2026-01-29T23:31:00+00:00\",\"filmStartsAt\":\"2026-01-29T21:25:00+00:00\",\"filmEndsAt\":\"2026-01-29T23:31:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-19\",\"filmId\":\"HO00006677\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000059\",\"0000000055\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006566\",\"title\":{\"text\":\"Pillion\",\"translations\":[]},\"synopsis\":{\"text\":\"Wallflower Colin (Harry Melling) leads a humdrum existence until he meets the impossibly handsome Ray (Alexander Skarsgård), a mysterious biker he is soon desperately devoted to. As Colin submits to Ray and enters an exciting new world of desire, he must decide the limits of his devotion. Hilarious, subversive and sexy, PILLION is the acclaimed and surprisingly tender love story from writer director Harry Lighton, starring Melling and Skarsgård in fearless performances as a mild young man and his leather-clad lover.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Wallflower Colin leads a humdrum existence until he meets the impossibly handsome Ray  a mysterious biker he is soon desperately devoted to.\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":{\"text\":\"strong sex, nudity\",\"translations\":[]},\"releaseDate\":\"2025-11-28\",\"runtimeInMinutes\":107,\"trailerUrl\":\"https://www.youtube.com/watch?v=aTAacTUKK00\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000026\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001209\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001212\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002533\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005853\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012561\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000164\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":\"32c5dfc0-407d-44d1-8d5a-afe8b22bb2a1\",\"corporateId\":null},\"hopk\":\"HO00006566\",\"hoCode\":\"A000008107\",\"eventId\":null,\"distributorName\":\"Picturehouse Entertainment\"},{\"id\":\"HO00006616\",\"title\":{\"text\":\"DocHouse: Coexistence, My Ass\",\"translations\":[]},\"synopsis\":{\"text\":\"Comedian Noam Shuster Eliassi turns satire into resistance, employing humour to expose hard truths about the relationship between Israel and Palestine – where coexistence feels like a bad joke.\\r\\n\\r\\nEliassi is a former UN diplomat who traded traditional peace activism for stand-up. Her act embraces sharp, uncompromising humour to challenge deeply entrenched narratives about Israel and Palestine. Raised in the country’s only intentionally integrated Jewish-Arab community, she once believed in coexistence. But as the region’s stability worsens through political upheavals, the COVID pandemic and the events of October 7 2023, Eliassi’s comedy evolves into a fearless act of resistance.\\r\\n\\r\\nFilmed over five turbulent years, charting Noam’s rise as a bold new voice in Middle Eastern satire, COEXISTENCE, MY ASS! is a deeply personal and politically urgent documentary that delivers both laughter and heartbreak, reminding us that comedy can act as both a salve and a provocation for change.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-25\",\"runtimeInMinutes\":93,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000012704\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006616\",\"hoCode\":\"A000008167\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006648\",\"title\":{\"text\":\"DocHouse: Seeds\",\"translations\":[]},\"synopsis\":{\"text\":\"An exploration of Black generational farmers in the American South reveals the fragility of legacy and the significance of owning land.\\r\\n\\r\\nInterweaving the stories of three Black generational farmers to create a collective and intimate portrait of farming today, SEEDS is a moving and powerful exploration of their lives, joys and struggles.\\r\\n\\r\\nWith remarkable intimacy, the film documents their everyday lives - cotton harvesting, chasing cows, dealing with broken machinery, and financial precarities. The camera relishes simple moments - conversations through car windows, candy from grandma’s purse - as it captures moments of warmth, joy, and fulfillment, turning them into striking vignettes that honor the families’ connection to the land and each other.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-22\",\"runtimeInMinutes\":123,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000012758\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006648\",\"hoCode\":\"A000008205\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006677\",\"title\":{\"text\":\"Hamnet\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"distressing scenes, brief moderate sex\",\"translations\":[]},\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":126,\"trailerUrl\":\"https://www.youtube.com/watch?v=Y9Tv9wGPxIw\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000175\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001040\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001087\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002138\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002310\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004702\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004703\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005314\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007765\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c566d7dc-50bb-4d55-984b-c4c65751933e\",\"corporateId\":null},\"hopk\":\"HO00006677\",\"hoCode\":\"A000008241\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006681\",\"title\":{\"text\":\"The Voice of Hind Rajab\",\"translations\":[]},\"synopsis\":{\"text\":\"January 29, 2024. Red Crescent volunteers receive an emergency call. A 6-year old girl is trapped in a car under fire in Gaza, pleading for rescue. While trying to keep her on the line, they do everything they can to get an ambulance to her. Her name was Hind Rajab.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Red Crescent volunteers receive an emergency call. A 6-year old girl is trapped in a car under IDF fire in Gaza, pleading for rescue. Her name was Hind Rajab.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"distressing scenes, strong threat, images of real dead bodies\",\"translations\":[]},\"releaseDate\":\"2026-01-16\",\"runtimeInMinutes\":89,\"trailerUrl\":null,\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001301\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012772\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012773\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012774\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e118aebf-d685-4703-8fb5-88305b5e28da\",\"corporateId\":null},\"hopk\":\"HO00006681\",\"hoCode\":\"A000008245\",\"eventId\":null,\"distributorName\":\"Altitude Film Distribution\"},{\"id\":\"HO00006687\",\"title\":{\"text\":\"The History of Sound\",\"translations\":[]},\"synopsis\":{\"text\":\"In 1917, Lionel — a young, talented music student — meets David at the Boston Conservatory, where they bond over a deep love of folk music. Years later, Lionel receives a letter from David, leading to an impromptu journey through the backwoods of Maine to collect traditional songs. This unexpected reunion, ensuing love affair, and the music they collect and preserve, will shape the course of Lionel’s life far beyond his own awareness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Two young men during World War I set out to record the lives, voices and music of their American countrymen.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"brief strong sex\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":128,\"trailerUrl\":\"https://www.youtube.com/watch?v=E2PSkw8BI7k\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002283\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002310\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004336\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000007164\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007677\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008293\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012816\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012817\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012818\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012819\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012820\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012821\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012822\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c8ef0b42-7ed8-4ee1-9534-85771b63b7fc\",\"corporateId\":null},\"hopk\":\"HO00006687\",\"hoCode\":\"A000008252\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006689\",\"title\":{\"text\":\"No Other Choice\",\"translations\":[]},\"synopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":139,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000012169\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012827\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012828\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012829\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012830\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012831\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000026\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9ecc0908-a983-42f7-9591-6f8d73d7488b\",\"corporateId\":null},\"hopk\":\"HO00006689\",\"hoCode\":\"A000008255\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00006609\",\"title\":{\"text\":\"Marty Supreme\",\"translations\":[]},\"synopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":149,\"trailerUrl\":\"https://www.youtube.com/watch?v=PNDVyJU99M0\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001403\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001416\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002090\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003985\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003988\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000007063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007210\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011162\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011923\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12808\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12809\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"12810\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e033d58e-8545-4f81-a191-03352ebe4cc0\",\"corporateId\":null},\"hopk\":\"HO00006609\",\"hoCode\":\"A000008158\",\"eventId\":null,\"distributorName\":\"Entertainment Film Distributors\"},{\"id\":\"HO00006610\",\"title\":{\"text\":\"Sentimental Value\",\"translations\":[]},\"synopsis\":{\"text\":\"Nora Borg (Renate Reinsve) is an established Oslo stage actress; her younger sister Agnes (Inga Ibsdotter Lilleaas) has chosen family life with her young son. Though markedly different, the two are close and deeply intertwined, having been raised by a single mother after their filmmaker father’s departure years earlier. When the once renowned Gustav (Stellan Skarsgård) attempts to cast Nora in his comeback film, old wounds bleed anew; \\\"Nora rejects his offer, prompting the isolated patriarch to cast American star Rachel Kemp (Elle Fanning), who gradually comes to realize she has unwittingly become part of a deeply personal film drama. Agnes, meanwhile, delves deeper into the family history as Gustav and Nora attempt rapprochement; but the cracks at the base of the family home run deeper than any Borg can grasp, threatening to topple an already shaky foundation.\\r\\n\\r\\nThis special preview is presented in partnership with The Observer and will feature a post-film conversation between film critic Wendy Ide and leading actor Stellan Skarsgård.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Sisters Nora and Agnes reunite with their estranged father, the charismatic Gustav, a once renowned director who offers stage actress Nora a role.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, suicide references\",\"translations\":[]},\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":133,\"trailerUrl\":\"https://www.youtube.com/watch?v=Gb1sSfWb1Og\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001057\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001058\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001695\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002275\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002626\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002629\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002630\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003236\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008105\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012671\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012672\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012673\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012674\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"938\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5b779d8b-e80b-4790-9616-e4b978f19314\",\"corporateId\":null},\"hopk\":\"HO00006610\",\"hoCode\":\"A000008159\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00006730\",\"title\":{\"text\":\"DocHouse: Becoming Victoria Wood\",\"translations\":[]},\"synopsis\":{\"text\":\"Victoria Wood remains one of Britain’s most cherished entertainers – a comic genius whose work reshaped the landscape of British humour. \\r\\n\\r\\nBut behind the joyous persona – the singer, the satirist, the sharp-witted writer – lay a young woman navigating insecurity, anger, and self-doubt. Told in her own words and through the voices of those who knew her best, BECOMING VICTORIA WOOD uncovers the formative experiences and personal battles that powered Victoria’s unmatched ability to make the nation laugh.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-10\",\"runtimeInMinutes\":90,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000013002\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006730\",\"hoCode\":\"A000008306\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006742\",\"title\":{\"text\":\"DocHouse: Ai Weiwei's Turandot\",\"translations\":[]},\"synopsis\":{\"text\":\"Renowned artist Ai Weiwei makes his debut as an opera director with a radical reinterpretation of Puccini's classic (and controversial) Turandot, at the Rome Opera House.\\r\\n\\r\\nWell known as both an activist and iconoclast, Ai comes into the project freely admitting his lack of experience in opera, and uses that as a starting point to re-think Puccini's masterpiece for the 21st Century. The uncompromising artist works with some of the Opera world's most experienced designers and conductors to build a piece that challenges, inspires, and reflects the global crises of our times. \\r\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Renowned artist Ai Weiwei makes his debut as an opera director with a radical reinterpretation of Puccini's classic (and controversial) Turandot, at the Rome Opera House.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":78,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000013030\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006742\",\"hoCode\":\"A000008320\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006447\",\"title\":{\"text\":\"It Was Just An Accident\",\"translations\":[]},\"synopsis\":{\"text\":\"Winner of the Palme d’Or at Cannes, IT WAS JUST AN ACCIDENT is a fearless tour-de-force from cinematic luminary Jafar Panahi. Both urgently political and deeply humane, this new moral classic confronts truth and uncertainty, revenge and mercy, head-on.\\n\\nWhen auto mechanic Vahid unexpectedly encounters the man who may have been his torturer in prison, he kidnaps him with the intention to exact vengeance. But since the sole clue to Eghbal’s identity is the distinct squeak of his prosthetic leg, Vahid turns to a loose circle of other now-freed victims for confirmation. And the danger only escalates. \\n\\nAs they deal with their past and diverging worldviews, the group struggles to decide: Is this him, without a doubt? What would retribution mean, in actuality? \\n\\nUnraveling against the ever-present backdrop of authoritarianism, IT WAS JUST AN ACCIDENT coalesces into a climactic act of resistance by an Iranian auteur who is no stranger to unjust detainment himself. Powered by thrilling momentum and peerless craft, France’s Best International Feature Film entry to the 98th Academy Awards® asks us to consider – and reconsider – the line between right and wrong.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Winner of the Palme d’Or at Cannes, IT WAS JUST AN ACCIDENT is a fearless tour-de-force from cinematic luminary Jafar Panahi.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate violence\",\"translations\":[]},\"releaseDate\":\"2025-12-05\",\"runtimeInMinutes\":103,\"trailerUrl\":\"https://www.youtube.com/watch?v=9oHw2ubyWE4\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003596\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003696\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003697\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012220\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012221\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012222\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012223\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012224\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012225\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000026\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"f9f201e0-1560-44c9-8910-d407024cbab6\",\"corporateId\":null},\"hopk\":\"HO00006447\",\"hoCode\":\"A000007964\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00006487\",\"title\":{\"text\":\"Frankenstein\",\"translations\":[]},\"synopsis\":{\"text\":\"Oscar-winning director Guillermo del Toro adapts Mary Shelley’s classic tale of Victor Frankenstein, a brilliant but egotistical scientist who brings a creature to life in a monstrous experiment that ultimately leads to the undoing of both the creator and his tragic creation.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Oscar-winning director Guillermo del Toro adapts Mary Shelley’s classic tale of Victor Frankenstein, a brilliant but egotistical scientist who brings a creature to life.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2025-10-17\",\"runtimeInMinutes\":149,\"trailerUrl\":\"https://www.youtube.com/watch?v=8aulMPhE12g\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001390\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001691\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001807\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001808\