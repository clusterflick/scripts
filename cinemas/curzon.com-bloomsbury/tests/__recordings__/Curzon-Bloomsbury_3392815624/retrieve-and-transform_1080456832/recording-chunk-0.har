            "text": "{\"businessDate\":\"2026-02-27\",\"showtimes\":[{\"id\":\"BLO1-106936\",\"schedule\":{\"businessDate\":\"2026-02-27\",\"startsAt\":\"2026-02-27T18:20:00+00:00\",\"endsAt\":\"2026-02-27T20:07:00+00:00\",\"filmStartsAt\":\"2026-02-27T18:27:00+00:00\",\"filmEndsAt\":\"2026-02-27T20:07:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006793\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006793\",\"title\":{\"text\":\"DocHouse: EPiC: Elvis Presley in Concert\",\"translations\":[]},\"synopsis\":{\"text\":\"Elvis sings and tells his story like never before in director Baz Luhrmann's second foray into the life and music of the King. \\r\\n\\r\\nThis time, Luhrmann presents the results of his extensive archival research during the making of his 2022 biopic, ELVIS, including never-before-seen footage from the singer's legendary residency in Las Vegas. Somewhere between concert film and a documentary narrated by Elvis himself, this is a bombastic technicolour and sound showcase of the performer, combining the spectacle of his live shows with the intimacy of moments behind the scenes. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Elvis sings and tells his story like never before in a new cinematic experience from visionary filmmaker Baz Luhrmann.\",\"translations\":[]},\"censorRa