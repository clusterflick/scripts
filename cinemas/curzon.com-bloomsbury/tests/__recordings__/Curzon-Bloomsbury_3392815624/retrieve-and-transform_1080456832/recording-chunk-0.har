          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2027-05-05\",\"showtimes\":[{\"id\":\"BLO1-110398\",\"schedule\":{\"businessDate\":\"2027-05-05\",\"startsAt\":\"2027-05-05T19:00:00+01:00\",\"endsAt\":\"2027-05-05T22:15:00+01:00\",\"filmStartsAt\":\"2027-05-05T19:00:00+01:00\",\"filmEndsAt\":\"2027-05-05T22:15:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-19\",\"filmId\":\"HO00007129\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007129\",\"title\":{\"text\":\"RBO Cinema Season 2026-27: Tosca\",\"translations\":[]},\"synopsis\":{\"text\":\"Floria Tosca and Mario Cavaradossi live for each other and for their art. But when Cavaradossi helps an escaped prisoner, the lovers make a deadly enemy in the form of Baron Scarpia, Chief of Police. At the mercy of Scarpia’s twisted desires, Tosca is forced to make a horrific bargain: sleeping with the man she hates, in order to save the man she loves. Can she find a way out?\\nOliver Mears’s acclaimed production returns, setting Puccini’s operatic thriller in a contemporary, war-torn Rome. Daniel Oren conducts Aleksandra Kurzak, who returns to the title role, joined by Saimir Pirgu as Cavaradossi and Christopher Maltman as Baron Scarpia.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Floria Tosca and Mario Cavaradossi live for each other and for their art. But when Cavaradossi helps an escaped prisoner, the lovers make a deadly enemy \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2027-05-05\",\"runtimeInMinutes\":195,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000924\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001498\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000003814\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000603\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000750\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000751\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000752\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000753\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000924\"},{\"castAndCrewMemberId\":\"0000003814\"},{\"castAndCrewMemberId\":\"HO00000603\"},{\"castAndCrewMemberId\":\"HO00000750\"},{\"castAndCrewMemberId\":\"HO00000751\"},{\"castAndCrewMemberId\":\"HO00000752\"},{\"castAndCrewMemberId\":\"HO00000753\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000001498\"}],\"producers\":[],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"904c4e23-8194-4918-933d-8eec380af00c\",\"corporateId\":null},\"hopk\":\"HO00007129\",\"hoCode\":\"A000008780\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000924\",\"name\":{\"givenName\":\"Aleksandra\",\"familyName\":\"Kurzak\",\"middleName\":null}},{\"id\":\"0000001498\",\"name\":{\"givenName\":\"Oliver\",\"familyName\":\"Mears\",\"middleName\":null}},{\"id\":\"0000003814\",\"name\":{\"givenName\":\"Christopher \",\"familyName\":\"Maltman\",\"middleName\":null}},{\"id\":\"HO00000603\",\"name\":{\"givenName\":\"Sam\",\"familyName\":\"Hird\",\"middleName\":null}},{\"id\":\"HO00000750\",\"name\":{\"givenName\":\"Saimir\",\"familyName\":\"Pirgu\",\"middleName\":null}},{\"id\":\"HO00000751\",\"name\":{\"givenName\":\"Aled\",\"familyName\":\"Hall\",\"middleName\":null}},{\"id\":\"HO00000752\",\"name\":{\"givenName\":\"Pawel\",\"familyName\":\"Horodyski\",\"middleName\":null}},{\"id\":\"HO00000753\",\"name\":{\"givenName\":\"Jonathan\",\"familyName\":\"Lemalu\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000010\",\"name\":{\"text\":\"Satellite Event\",\"translations\":[]},\"shortName\":{\"text\":\"Sat event\",\"translations\":[]},\"description\":{\"text\":\"Live Via Satellite\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"BLO1-5\",\"name\":{\"text\":\"Renoir Screen\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"BLO1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
