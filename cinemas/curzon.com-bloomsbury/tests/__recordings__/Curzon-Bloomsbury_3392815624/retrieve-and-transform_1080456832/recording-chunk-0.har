,\"censorRatingNote\":null,\"releaseDate\":\"2026-08-07\",\"runtimeInMinutes\":93,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000537\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000000537\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007253\",\"hoCode\":\"A000008921\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000000537\",\"name\":{\"givenName\":\"Maite\",\"familyName\":\"Alberdi\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000012\",\"name\":{\"text\":\"Programmed by Bertha Dochouse\",\"translations\":[]},\"shortName\":{\"text\":\"Dochouse\",\"translations\":[]},\"description\":{\"text\":\"Programmed by Bertha Dochouse | Preshows: 5 minutes\",\"translations\":[]},\"importantMessage\":{\"text\":\"Preshows: 5 minutes\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"BLO1-6\",\"name\":{\"text\":\"Bertha Dochouse\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"BLO1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
