ting\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"BLO1-124-HO00006951\"},{\"id\":\"BLO1-111536\",\"schedule\":{\"businessDate\":\"2026-07-13\",\"startsAt\":\"2026-07-13T21:00:00+01:00\",\"endsAt\":\"2026-07-13T22:56:00+01:00\",\"filmStartsAt\":\"2026-07-13T21:25:00+01:00\",\"filmEndsAt\":\"2026-07-13T22:56:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-3-8\",\"filmId\":\"HO00007043\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-3\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00006949\",\"title\":{\"text\":\"The Christophers\",\"translations\":[]},\"synopsis\":{\"text\":\"The estranged children of a once-famous artist hire a forger to complete his unfinished works so they can be \\\"discovered\\\" and sold after his death.\\n\\nStarring\\nIan McKellen, Michaela Coel, Jessica Gunning, James Corden\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The estranged children of a once-famous artist hire a forger to complete his unfinished works so they can be \\\"discovered\\\" and sold after his death.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-05-15\",\"runtimeInMinutes\":100,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/536f842c-5192-422a-bee4-109ff5f455e6/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=7CB2nsSBqs0\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=7CB2nsSBqs0\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004940\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013701\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000009\",\"roles\":[\"Producer\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000004940\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000013701\"},{\"castAndCrewMemberId\":\"HO00000009\"}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"536f842c-5192-422a-bee4-109ff5f455e6\",\"corporateId\":null},\"hopk\":\"HO00006949\",\"hoCode\":\"A000008565\",\"eventId\":null,\"distributorName\":\"Picturehouse Entertainment\"},{\"id\":\"HO00006951\",\"title\":{\"text\":\"Obsession\",\"translations\":[]},\"synopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for but soon discovers that some desires come at a dark, sinister price.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for.\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":null,\"releaseDate\":\"2026-05-15\",\"runtimeInMinutes\":109,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/53c5bdfb-4dbf-47f5-8eca-b0b807ee068c/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=fWLaCC8L6Jo\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=fWLaCC8L6Jo\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003927\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013704\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013705\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013706\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013707\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013708\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013709\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013710\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000254\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000013704\"},{\"castAndCrewMemberId\":\"0000013705\"},{\"castAndCrewMemberId\":\"0000013706\"},{\"castAndCrewMemberId\":\"0000013707\"},{\"castAndCrewMemberId\":\"0000013708\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000013709\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000003927\"},{\"castAndCrewMemberId\":\"0000013710\"},{\"castAndCrewMemberId\":\"HO00000254\"}],\"genreIds\":[\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"53c5bdfb-4dbf-47f5-8eca-b0b807ee068c\",\"corporateId\":null},\"hopk\":\"HO00006951\",\"hoCode\":\"A000008567\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00007043\",\"title\":{\"text\":\"Effi o Blaenau\",\"translations\":[]},\"synopsis\":{\"text\":\"Based on Gary Owen's much lauded and widely performed monodrama, Iphigenia in Splott, 'Effi o Blaenau' is director Marc Evans' cinematic interpretation set against the wide open landscapes of North Wales. \\n\\nThe film follows Effi, a young woman desperate to escape a town where the pubs are closed, the jobs have vanished and her grandmother works night shifts in the local chip shop just to get by. A chance encounter in a Llandudno nightclub with injured soldier Lee, played by Tom Rhys Harries, briefly opens a door to something better. For a moment, Effi glimpses a life she never imagined. The reality that follows is far tougher. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Based on Gary Owen's much lauded and widely performed monodrama, Iphigenia in Splott, 'Effi o Blaenau' is director Marc Evans' cinematic interpretation \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-19\",\"runtimeInMinutes\":91,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/7674f395-c052-4003-9088-5ba8bfbd4bb3/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=elibOEvAVTo\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=elibOEvAVTo\",\"displayPriority\":10,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003703\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010833\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013980\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013981\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013982\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013983\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013984\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"14072\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"14073\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"14074\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000003703\"},{\"castAndCrewMemberId\":\"0000013980\"},{\"castAndCrewMemberId\":\"0000013981\"},{\"castAndCrewMemberId\":\"0000013982\"},{\"castAndCrewMemberId\":\"0000013983\"},{\"castAndCrewMemberId\":\"14072\"},{\"castAndCrewMemberId\":\"14073\"},{\"castAndCrewMemberId\":\"14074\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000010833\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000013984\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"7674f395-c052-4003-9088-5ba8bfbd4bb3\",\"corporateId\":null},\"hopk\":\"HO00007043\",\"hoCode\":\"A000008681\",\"eventId\":null,\"distributorName\":\"Met Film\"},{\"id\":\"HO00007047\",\"title\":{\"text\":\"Blue Heron\",\"translations\":[]},\"synopsis\":{\"text\":\"Set on Vancouver Island in the late 1990s, Blue Heron follows eight‑year‑old Sasha and her Hungarian immigrant family as they attempt to build a new life, only to be destabilised by the increasingly dangerous behaviour of her older brother, Jeremy. Drawing on her own memories, filmmaker Sophy Romvari shapes a deeply personal portrait of childhood, family fractures, and the fragility of recollection. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Set on Vancouver Island in the late 1990s, Blue Heron follows eight‑year‑old Sasha and her Hungarian immigrant family as they attempt to build a new life\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"upsetting scenes, moderate injury detail, infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-06-26\",\"runtimeInMinutes\":91,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=6qAK9GwWRe0\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=6qAK9GwWRe0\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000013999\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014000\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014001\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014002\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014003\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014004\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014005\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014006\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014007\",\"roles\":[\"Director\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000013999\"},{\"castAndCrewMemberId\":\"0000014000\"},{\"castAndCrewMemberId\":\"0000014001\"},{\"castAndCrewMemberId\":\"0000014002\"},{\"castAndCrewMemberId\":\"0000014003\"},{\"castAndCrewMemberId\":\"0000014004\"},{\"castAndCrewMemberId\":\"0000014005\"},{\"castAndCrewMemberI