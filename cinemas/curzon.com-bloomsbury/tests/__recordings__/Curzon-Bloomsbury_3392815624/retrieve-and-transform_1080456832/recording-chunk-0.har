ewMemberId\":\"0000000122\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000004435\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005031\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005648\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000005651\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000007272\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007273\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013130\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"11246\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":\"3869f393-3342-4dc1-9c0a-a7d04e170132\",\"corporateId\":null},\"hopk\":\"HO00006762\",\"hoCode\":\"A000008342\",\"eventId\":null,\"distributorName\":\"Warners\"},{\"id\":\"HO00006777\",\"title\":{\"text\":\"DocHouse: It's Never Over, Jeff Buckley\",\"translations\":[]},\"synopsis\":{\"text\":\"IT’S NEVER OVER, JEFF BUCKLEY, directed by Oscar-nominated filmmaker Amy Berg, covers the life of the rising young star with an otherworldly voice and boundary-pushing artistry, who left the '90s music world reeling when he died suddenly, at age 30, after the release of his critically acclaimed debut album “Grace.”\\r\\n\\r\\nTold through never-before-seen footage from Buckley’s archives and intimate accounts from his mother Mary Guibert, former partners Rebecca Moore and Joan Wasser, Jeff’s former bandmates, including Michael Tighe and Parker Kindred, and luminaries like Ben Harper and Aimee Mann, IT’S NEVER OVER, JEFF BUCKLEY illuminates one of modern music’s most influential and enigmatic figures.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-13\",\"runtimeInMinutes\":106,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000013102\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006777\",\"hoCode\":\"A000008359\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006790\",\"title\":{\"text\":\"DocHouse: Make It Look Real\",\"translations\":[]},\"synopsis\":{\"text\":\"A local photo studio in Pakistan serves as a vibrant cultural hub where personal dreams and community connections are brought to life through photography. \\r\\n\\r\\nFilmmaker Danial Shah, a displaced native, partners with Sakhi, a photographer yearning for a life abroad, to explore the aesthetics and economics of image-making, shaped by socio-political influences and social class. \\r\\n\\r\\nAs customers enter with their unique fantasies and desires, each photograph emerges as a powerful representation of their aspirations, reflecting the intricate interplay between identity and longing.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-14\",\"runtimeInMinutes\":68,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000013224\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006790\",\"hoCode\":\"A000008378\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006796\",\"title\":{\"text\":\"Film Club: Certain Women\",\"translations\":[]},\"synopsis\":{\"text\":\"The lives of three women intersect in small-town America, where each is imperfectly blazing a trail.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The lives of three women intersect in small-town America, where each is imperfectly blazing a trail.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, nudity\",\"translations\":[]},\"releaseDate\":\"2026-03-19\",\"runtimeInMinutes\":107,\"trailerUrl\":null,\"displayPriority\":50,\"cas