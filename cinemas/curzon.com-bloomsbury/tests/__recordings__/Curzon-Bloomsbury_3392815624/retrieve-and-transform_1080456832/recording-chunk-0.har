s in the Met’s larger-than-life\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-12-05\",\"runtimeInMinutes\":234,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000917\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000298\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000543\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000768\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000769\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000770\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000917\"},{\"castAndCrewMemberId\":\"0000001576\"},{\"castAndCrewMemberId\":\"HO00000298\"},{\"castAndCrewMemberId\":\"HO00000543\"},{\"castAndCrewMemberId\":\"HO00000768\"},{\"castAndCrewMemberId\":\"HO00000769\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000000920\"}],\"producers\":[{\"castAndCrewMemberId\":\"HO00000770\"}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"95312d93-a009-4b83-906c-7c9079bfc829\",\"corporateId\":null},\"hopk\":\"HO00007137\",\"hoCode\":\"A000008788\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000917\",\"name\":{\"givenName\":\"Alfred\",\"familyName\":\"Walker\",\"middleName\":null}},{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000001576\",\"name\":{\"givenName\":\"Quinn\",\"familyName\":\"Kelsey\",\"middleName\":null}},{\"id\":\"HO00000298\",\"name\":{\"givenName\":\"Aigul\",\"familyName\":\"Akhmetshina\",\"middleName\":null}},{\"id\":\"HO00000543\",\"name\":{\"givenName\":\"Morris\",\"familyName\":\"Robinson\",\"middleName\":null}},{\"id\":\"HO00000768\",\"name\":{\"givenName\":\"