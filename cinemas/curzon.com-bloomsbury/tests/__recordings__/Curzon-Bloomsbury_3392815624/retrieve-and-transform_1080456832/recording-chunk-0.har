          "redirectURL": "",
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-09-21\",\"showtimes\":[{\"id\":\"BLO1-111636\",\"schedule\":{\"businessDate\":\"2026-09-21\",\"startsAt\":\"2026-09-21T18:00:00+01:00\",\"endsAt\":\"2026-09-21T19:57:00+01:00\",\"filmStartsAt\":\"2026-09-21T18:20:00+01:00\",\"filmEndsAt\":\"2026-09-21T19:57:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-1-2\",\"filmId\":\"HO00007225\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-1\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007225\",\"title\":{\"text\":\"Curzon Film 50: Mustang\",\"translations\":[]},\"synopsis\":{\"text\":\"Beautifully shot, with stunning performances by its young cast, the Oscar-nominated Mustang is both a rousing tale of spirited youth and a powerful, moving, and timely work of engaging social cinema.\\n\\nIt’s the beginning of summer. In a small village in northern Turkey, Lale and her four sisters are on their way home from school, innocently playing with local boys. But prying village eyes view their games with suspicion and the girls’ behaviour – and refusal to repent – quickly causes a scandal among the family.\\n\\nSoon the sisters find themselves locked in their bedrooms, with sober dress enforced and their schoolwork replaced by cookery classes. Their home now a prison, all the girls have to live for are arranged marriages and family honour. But together, driven by strength, courage, and a desire for freedom, the five sisters fight back against the limits imposed on them and test their family ties to breaking point.\\n\\nDrawing vocal support from critics, festivals, and audiences across the globe, this highly impressive debut from director Deniz Gamze Ergüven is set to be one of the most talked-about and celebrated films of the year.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When five orphan girls are seen innocently playing with boys on a beach, their scandalized conservative guardians confine them while forced marriages are arranged.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"infrequent strong sex references\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":97,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=B5GdLjcK9G0\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=B5GdLjcK9G0\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003323\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000815\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000816\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000817\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000818\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000819\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000820\",\"roles\":[\"Director\"]}],\"actors\":[{\"castAndCrewMemberId\":\"HO00000815\"},{\"castAndCrewMemberId\":\"HO00000816\"},{\"castAndCrewMemberId\":\"HO00000817\"},{\"castAndCrewMemberId\":\"HO00000818\"},{\"castAndCrewMemberId\":\"HO00000819\"}],\"directors\":[{\"castAndCrewMemberId\":\"HO00000820\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000003323\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007225\",\"hoCode\":\"A00