          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-03-04\",\"showtimes\":[{\"id\":\"BLO1-106576\",\"schedule\":{\"businessDate\":\"2026-03-04\",\"startsAt\":\"2026-03-04T18:30:00+00:00\",\"endsAt\":\"2026-03-04T20:06:00+00:00\",\"filmStartsAt\":\"2026-03-04T18:47:00+00:00\",\"filmEndsAt\":\"2026-03-04T20:06:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006786\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\",\"0000000020\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-105811\",\"schedule\":{\"businessDate\":\"2026-03-04\",\"startsAt\":\"2026-03-04T19:00:00+00:00\",\"endsAt\":\"2026-03-04T22:10:00+00:00\",\"filmStartsAt\":\"2026-03-04T19:25:00+00:00\",\"filmEndsAt\":\"2026-03-04T22:10:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-19\",\"filmId\":\"HO00006731\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006731\",\"title\":{\"text\":\"OTHELLO\",\"translations\":[]},\"synopsis\":{\"text\":\"Shakespeare’s OTHELLO rages to life like never before in a ‘compelling’ (★★★★ Telegraph) new production starring David Harewood OBE (Homeland, Best of Enemies), Toby Jones OBE (Mr Bates vs the Post Office, Detectorists), Caitlin FitzGerald (Succession, Masters of Sex), Vinette Robinson (Boiling Point) and Luke Treadaway (A Street Cat Named Bob). \\n\\nDirected by Tony Award-winner Tom Morris OBE (War Horse, Dr Semmelweis, The Grinning Man) with music by PJ Harvey, this epic story of manipulation, jealousy and toxic masculinity explores the darker side of power, rage and desire. Filmed live at the Theatre Royal Haymarket in London especially for the big screen, this is ‘an electrifying star-studded Othello.’ (★★★★ Mail on Sunday) \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Shakespeare’s OTHELLO rages to life like never before in a ‘compelling’ (★★★★ Telegraph) new production starring David Harewood OBE (Homeland, Best of Enemies)...\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-03-04\",\"runtimeInMinutes\":165,\"trailerUrl\":\"https://www.youtube.com/watch?v=BSmPMR5Fr5U\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002163\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002241\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005041\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013003\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013004\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"11247\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9283deea-8308-4781-bff2-a6ecb44f1966\",\"corporateId\":null},\"hopk\":\"HO00006731\",\"hoCode\":\"A000008307\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"},{\"id\":\"HO00006786\",\"title\":{\"text\":\"DocHouse: In Memoriam: Marcel Lozinski\",\"translations\":[]},\"synopsis\":{\"text\":\"This special event honors the legacy of Marcel Łoziński, one of the most influential voices in world documentary cinema who passed away last year. A master of ethical provocation and humanist observation, Łoziński reshaped the language of non-fiction film by questioning the boundaries between truth, manipulation, and authorship. His work—rooted in deep empathy and rigorous self-reflection—continues to inspire generations of filmmakers to look more closely, listen more carefully, and take responsibility for the act of filming itself.\\r\\nThe four film programme includes THE VISIT, WORKSHOP EXERCISES, 89MM FROM EUROPE and ANYTHING CAN HAPPEN, with an introduction from Marc Isaacs.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-03-04\",\"runtimeInMinutes\":79,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000013205\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006786\",\"hoCode\":\"A000008371\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000002163\",\"name\":{\"givenName\":\"Toby\",\"familyName\":\"Jones\",\"middleName\":null}},{\"id\":\"0000002241\",\"name\":{\"givenName\":\"Vinette\",\"familyName\":\"Robinson\",\"middleName\":null}},{\"id\":\"0000005041\",\"name\":{\"givenName\":\"David\",\"familyName\":\"Harewood\",\"middleName\":null}},{\"id\":\"0000013003\",\"name\":{\"givenName\":\"Caitlin\",\"familyName\":\"FitzGerald\",\"middleName\":null}},{\"id\":\"0000013004\",\"name\":{\"givenName\":\"Tom\",\"familyName\":\"Morris\",\"middleName\":null}},{\"id\":\"11247\",\"name\":{\"givenName\":\"Luke\",\"familyName\":\"Treadaway\",\"middleName\":null}},{\"id\":\"0000013205\",\"name\":{\"givenName\":\"Marcel\",\"familyName\":\"Łoziński\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}},{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatin