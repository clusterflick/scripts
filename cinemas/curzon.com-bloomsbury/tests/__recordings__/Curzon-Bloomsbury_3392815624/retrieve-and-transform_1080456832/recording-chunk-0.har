            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-09-22\",\"showtimes\":[{\"id\":\"BLO1-110853\",\"schedule\":{\"businessDate\":\"2026-09-22\",\"startsAt\":\"2026-09-22T18:00:00+01:00\",\"endsAt\":\"2026-09-22T20:30:00+01:00\",\"filmStartsAt\":\"2026-09-22T18:00:00+01:00\",\"filmEndsAt\":\"2026-09-22T20:30:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-19\",\"filmId\":\"HO00007173\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007173\",\"title\":{\"text\":\"National Theatre Live: The Misanthrope\",\"translations\":[]},\"synopsis\":{\"text\":\"Award-winner Sandra Oh (Killing Eve) plays the title role in this razor-sharp reimagining of Molière’s classic dark comedy. Telling the truth isn’t always that simple. Alice, a brilliant novelist, despises the carefully constructed lies of modern society. But the more she challenges those around her, the fiercer the backlash becomes. Soon, she must confront the price of speaking her truth in a world that would rather silence her. Filmed live on stage at the National Theatre, Indhu Rubasingham directs Martin Crimp’s (Cyrano de Bergerac) highly anticipated play.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Award-winner Sandra Oh (Killing Eve) plays the title role in this razor-sharp reimaginin