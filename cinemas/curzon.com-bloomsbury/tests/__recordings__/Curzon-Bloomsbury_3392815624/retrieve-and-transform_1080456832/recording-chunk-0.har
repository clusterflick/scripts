          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-07-24\",\"showtimes\":[{\"id\":\"BLO1-111440\",\"schedule\":{\"businessDate\":\"2026-07-24\",\"startsAt\":\"2026-07-24T18:15:00+01:00\",\"endsAt\":\"2026-07-24T19:52:00+01:00\",\"filmStartsAt\":\"2026-07-24T18:22:00+01:00\",\"filmEndsAt\":\"2026-07-24T19:52:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00007226\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-111445\",\"schedule\":{\"businessDate\":\"2026-07-24\",\"startsAt\":\"2026-07-24T20:15:00+01:00\",\"endsAt\":\"2026-07-24T21:53:00+01:00\",\"filmStartsAt\":\"2026-07-24T20:22:00+01:00\",\"filmEndsAt\":\"2026-07-24T21:53:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00007227\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007226\",\"title\":{\"text\":\"DocHouse: Flavors of Iraq\",\"translations\":[]},\"synopsis\":{\"text\":\"French-born journalist Feurat Alani narrates this animated documentary about his complicated connection to Iraq, the country of his parents. His gripping storytelling comes to life with director Léonard Cohen's evocative animation, conjuring up Alani's family in Iraq and his own introduction to the country as a boy, under the dictatorship of Saddam Hussein. With touching vulnerability, Alani depicts his relationship with his revolutionary father, who was exiled from his homeland but never lost his love for her.\\n\\nNimbly covering 5 decades of upheaval, from Iraq's invasion of Kuwait to the American occupation and the subsequent rise of Al Qaeda and Islamic State, Alani presents a piercing perspective on US intervention in the region from a place of deep, personal understanding.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-24\",\"runtimeInMinutes\":90,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004092\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000004092\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007226\",\"hoCode\":\"A000008891\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00007227\",\"title\":{\"text\":\"DocHouse: Ask E. Jean\",\"translations\":[]},\"synopsis\":{\"text\":\"Across a five-decade career, E. Jean Carroll has emerged as a trailblazing journalist, talk show host and beloved advice columnist, conquering the male dominated publishing world of 1980s and 90s New York with a fearless voice all her own. \\n\\nIn recent years, she has fought a high profile legal battle against Donald Trump for sexual assault and defamation, becoming the only woman to beat him in court. Twice. ASK E. JEAN is both a portrait of the thrilling, storied life of a singular icon, and a gutsy exploration of what it takes for a woman to stand up to power and prove she is telling the truth about a historic assault. With the multi-million dollar bill for damages still unpaid and the legal battle rumbling on through the courts and the headlines, ASK E. JEAN is critical viewing.  \",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-24\",\"runtimeInMinutes\":91,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014336\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000014336\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007227\",\"hoCode\":\"A000008892\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000004092\",\"name\":{\"givenName\":\"Leonard\",\"familyName\":\"Cohen\",\"middleName\":null}},{\"id\":\"0000014336\",\"name\":{\"givenName\":\"Ivy\",\"familyName\":\"Meeropol\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"HO00000004\",\"classification\":{\"text\":\"12A\",\"translations\":[]},\"classificationDescription\":{\"text\":\"12A\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}},{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000012\",\"name\":{\"text\":\"Programmed by Bertha Dochouse\",\"translations\":[]},\"shortName\":{\"text\":\"Dochouse\",\"translations\":[]},\"description\":{\"text\":\"Programmed by Bertha Dochouse | Preshows: 5 minutes\",\"translations\":[]},\"importantMessage\":{\"text\":\"Preshows: 5 minutes\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\