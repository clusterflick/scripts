            "text": "{\"businessDate\":\"2026-02-10\",\"showtimes\":[{\"id\":\"BLO1-107108\",\"schedule\":{\"businessDate\":\"2026-02-10\",\"startsAt\":\"2026-02-10T18:00:00+00:00\",\"endsAt\":\"2026-02-10T20:18:00+00:00\",\"filmStartsAt\":\"2026-02-10T18:25:00+00:00\",\"filmEndsAt\":\"2026-02-10T20:18:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-19\",\"filmId\":\"HO00006765\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000059\",\"0000000008\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-106572\",\"schedule\":{\"businessDate\":\"2026-02-10\",\"startsAt\":\"2026-02-10T20:10:00+00:00\",\"endsAt\":\"2026-02-10T21:45:00+00:00\",\"filmStartsAt\":\"2026-02-10T20:17:00+00:00\",\"filmEndsAt\":\"2026-02-10T21:45:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006782\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006765\",\"title\":{\"text\":\"If I Had Legs I'd Kick You\",\"translations\":[]},\"synopsis\":{\"text\":\"With her life crashing down around her, Linda (Rose Byrne) attempts to navigate her child's mysterious illness, her absent husband, a missing person, and an increasingly hostile relationship with her therapist.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"With her life crashing down around her, Linda (Rose Byrne) attempts to navigate her child's mysterious illness, her absent husband, a missing person, and an increasingly \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-20\",\"runtimeInMinutes\":113,\"trailerUrl\":null,\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000121\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002090\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002283\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003549\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003985\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003988\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010098\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013142\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013143\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"0000013144\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013145\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013146\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"6d0be1c5-2f07-40f3-988d-5d358257e8e7\",\"corporateId\":null},\"hopk\":\"HO00006765\",\"hoCode\":\"A000008345\",\"eventId\":null,\"distributorName\":\"Picturehouse Entertainment\"},{\"id\":\"HO00006782\",\"title\":{\"text\":\"DocHouse: André is an Idiot\",\"translations\":[]},\"synopsis\":{\"text\":\"Unexpected, irreverent, and absurdly funny, ANDRÉ IS AN IDIOT is a wildly life-affirming film about death. When André, a brilliant idiot, learns he's dying from a disease he could have detected with a colonoscopy, he decides to document his final journey. As an iconoclastic ad man, he had defied convention throughout his life. True to form, André approaches mortality with his trademark humor and curiosity, determined to learn how to die both happily and ridiculously.\\r\\n\\r\\nIn a unique collaboration with director Tony Benna, André's stories and musings are brought to life with imaginative stop-motion animation, capturing his unique approach to life's challenges and joys. ANDRÉ IS AN IDIOT is a celebration of resilience, inappropriate humor, and the beauty of fully embracing the human experience - even at its end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"André, a brilliant idiot, is dying because he didn’t get a colonoscopy. His sobering diagnosis, complete irreverence, and insatiable curiosity, send him on a journey.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-06\",\"runtimeInMinutes\":88,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004846\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010734\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013199\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013200\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013201\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013202\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\",\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006782\",\"hoCode\":\"A000008365\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000000121\",\"name\":{\"givenName\":\"Rose\",\"familyName\":\"Byrne\",\"middleName\":null}},{\"id\":\"0000002090\",\"name\":{\"givenName\":\"Eli\",\"familyName\":\"Bush\",\"middleName\":null}},{\"id\":\"0000002283\",\"name\":{\"givenName\":\"Sara \",\"familyName\":\"Murphy\",\"middleName\":null}},{\"id\":\"0000003549\",\"name\":{\"givenName\":\"Ryan \",\"familyName\":\"Zacarias\",\"middleName\":null}},{\"id\":\"0000003