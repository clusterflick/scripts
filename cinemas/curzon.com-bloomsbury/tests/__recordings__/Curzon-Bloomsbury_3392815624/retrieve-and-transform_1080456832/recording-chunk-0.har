          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2027-02-23\",\"showtimes\":[{\"id\":\"BLO1-110395\",\"schedule\":{\"businessDate\":\"2027-02-23\",\"startsAt\":\"2027-02-23T18:45:00+00:00\",\"endsAt\":\"2027-02-23T22:15:00+00:00\",\"filmStartsAt\":\"2027-02-23T18:45:00+00:00\",\"filmEndsAt\":\"2027-02-23T22:15:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-19\",\"filmId\":\"HO00007126\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007126\",\"title\":{\"text\":\"RBO Cinema Season 2026-27: Così Fan Tutte\",\"translations\":[]},\"synopsis\":{\"text\":\"Spurred on by a bet, two young men hatch a plan to test the fidelity of their girlfriends. What follows is a slippery game of seduction and power, the four lovers plunging into a dizzying world of shifting reality, where truth becomes increasingly unstable. \\nCosì fan tutte has lost none of its sting since it first scandalised audiences in 1790. In her Main Stage debut, Netia Jones, Associate Director of The Royal Opera, reimagines Mozart’s comedy of manners through a sharp contemporary lens, where 18th-century romantic trickery meets deeply satirical high-tech deceit. Taking on the roles of the lovers is an exciting young cast led by Louise Alder, Simone McIntosh, Mingjie Lei and Huw Montague Rendall, with Gerald Finley as their manipulative game-master Don Alfonso and Emily Pogorelc as Despina. Thomas Hengelbrock conducts, bringing out the exquisite melodies that underpin the provocative, and resolutely modern, themes at the heart of the opera.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Spurred on by a bet, two young men hatch a plan to test the fidelity of their girlfriends. What follows is a slippery game of seduction and power.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2027-02-23\",\"runtimeInMinutes\":210,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011525\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011537\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000612\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000744\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000745\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000746\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000747\",\"roles\":[\"Director\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000011525\"},{\"castAndCrewMemberId\":\"0000011537\"},{\"castAndCrewMemberId\":\"HO00000612\"},{\"castAndCrewMemberId\":\"HO00000744\"},{\"castAndCrewMemberId\":\"HO00000745\"},{\"castAndCrewMemberId\":\"HO00000746\"}],\"directors\":[{\"castAndCrewMemberId\":\"HO00000747\"}],\"producers\":[],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2f1c2038-a4d7-4d7b-a60b-18a6d9e0f51b\",\"corporateId\":null},\"hopk\":\"HO00007126\",\"hoCode\":\"A000008777\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000011525\",\"name\":{\"givenName\":\"Gerald\",\"familyName\":\"Finley\",\"middleName\":null}},{\"id\":\"0000011537\",\"name\":{\"givenName\":\"Louise\",\"familyName\":\"Alder\",\"middleName\":null}},{\"id\":\"HO00000612\",\"name\":{\"givenName\":\"Huw\",\"fa