          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-13\",\"showtimes\":[{\"id\":\"BLO1-111630\",\"schedule\":{\"businessDate\":\"2026-08-13\",\"startsAt\":\"2026-08-13T18:00:00+01:00\",\"endsAt\":\"2026-08-13T19:40:00+01:00\",\"filmStartsAt\":\"2026-08-13T18:07:00+01:00\",\"filmEndsAt\":\"2026-08-13T19:40:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-1-2\",\"filmId\":\"HO00007222\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-1\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007222\",\"title\":{\"text\":\"Curzon Film 50: I Am Not a Witch\",\"translations\":[]},\"synopsis\":{\"text\":\"Zambian-born Welsh director Rungano Nyoni is set to make her mark on British cinema with her groundbreaking first feature, I Am Not a Witch. Sharply satirical and boldly provocative, the film garnered incredible praise from audiences and critics alike at the Cannes 2017 Directors’ Fortnight.\\n\\nWhen eight-year-old Shula turns up alone and unannounced in a rural Zambian village, the locals are suspicious. A minor incident escalates to a full-blown witch trial, where she is found guilty and sentenced to life on a state-run witch camp. There, she is tethered to a long white ribbon and told that if she ever tries to run away, she will be transformed into a goat. As the days pass, Shula begins to settle into her new community, but a threat looms on the horizon. Soon she is forced to make a difficult decision – whether to resign herself to life on the camp, or take a risk for freedom.\\n\\nAt times moving, often funny and occasionally surreal, I Am Not a Witch offers spellbinding storytelling with flashes of anarchic humour. Audacious and unforgettable, it showcases Rungano Nyoni as a fresh and fearless new voice in British film.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In a Zambian community a girl is denounced as a witch and sent on a trajectory of exploitation, as a tethered member of a witches' camp, a witch for hire.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"moderate threat, bloody images\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":93,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=jOtcU_-KuaQ\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=jOtcU_-KuaQ\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000425\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000007024\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007026\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000007027\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010363\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"14172\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"14173\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000007024\"},{\"castAndCrewMemberId\":\"0000010363\"},{\"castAndCrewMemberId\":\"14172\"},{\"castAndCrewMemberId\":\"14173\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000007026\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000000425\"},{\"castAndCrewMemberId\":\"0000007027\"}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007222\",\"hoCode\":\"A000008887\",\"eventId\