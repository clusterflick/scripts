          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-18\",\"showtimes\":[{\"id\":\"BLO1-111631\",\"schedule\":{\"businessDate\":\"2026-08-18\",\"startsAt\":\"2026-08-18T18:00:00+01:00\",\"endsAt\":\"2026-08-18T20:07:00+01:00\",\"filmStartsAt\":\"2026-08-18T18:20:00+01:00\",\"filmEndsAt\":\"2026-08-18T20:07:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-1-2\",\"filmId\":\"HO00007237\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-1\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007237\",\"title\":{\"text\":\"Curzon Film 50: Shirley\",\"translations\":[]},\"synopsis\":{\"text\":\"Set in the early 1950s, the film charts an imagined chapter in the life of Jackson, who has recently become a literary sensation. When her philandering professor husband (Michael Stuhlbarg) invites a newlywed couple into their home, the reclusive writer is forced to change her routine, which heightens tensions in their already tempestuous household. This change acts as a catalyst, sparking inspiration for the anxiety-prone writer. As she becomes enamoured with Rose, her unsuspecting new muse, Shirley’s obsession plunges her into a quasi-delirium, awakening a repressed femininity that could inspire her next masterpiece.\\n\\nFrom executive producer Martin Scorsese, and co-starring Odessa Young and Logan Lerman, this bewitching psychological drama is a portrait of an artist unravelling. Cleverly blending fiction and reality, Decker celebrates the rebelliousness of Jackson’s art, as well as the undying power of the female voice in the face of patriarchal, mid-century America.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Set in the early 1950s, the film charts an imagined chapter in the life of Jackson, who has recently become a literary sensation.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong bloody images, sex, language\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":107,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=medwII2MUQY\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=medwII2MUQY\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000807\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001079\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001394\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001886\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004369\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010290\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000861\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000862\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000863\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000864\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000865\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001394\"},{\"castAndCrewMemberId\":\"0000001886\"},{\"castAndCrewMemberId\":\"0000004369\"},{\"castAndCrewMemberId\":\"HO00000861\"}],\"directors\":[{\"castAndCrewMemberId\":\"HO00000862\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000000807\"},{\"castAndCrewMemberId\":\"0000001079\"},{\"castAndCrewMemberId\":\"0000001394\"},{\"castAndCrewMemberId