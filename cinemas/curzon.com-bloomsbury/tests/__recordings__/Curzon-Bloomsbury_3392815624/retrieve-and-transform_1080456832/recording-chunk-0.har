            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-03-01\",\"showtimes\":[{\"id\":\"BLO1-106939\",\"schedule\":{\"businessDate\":\"2026-03-01\",\"startsAt\":\"2026-03-01T19:00:00+00:00\",\"endsAt\":\"2026-03-01T20:38:00+00:00\",\"filmStartsAt\":\"2026-03-01T19:07:00+00:00\",\"filmEndsAt\":\"2026-03-01T20:38:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006792\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006792\",\"title\":{\"text\":\"DocHouse: Molly Vs the Machines\",\"translations\":[]},\"synopsis\":{\"text\":\"At 14 years old, Molly Russell came home from school, finished her homework and said goodnight to her family. A few hours later, she took her own life. \\r\\n\\r\\nSurrounded by a loving circle of family and friends, it was a life-shattering mystery to all who knew her. In search of an answer Ian, her devastated father, pieces the final months of her life back together only to discover that, when Molly looked at her phone, social media machines dragged her into darkness.\\r\\n \\r\\nFrom a teenager\u2019s suburban bedroom to the boardrooms of Silicon Valley, MOLLY Vs THE MACHINES is the story of a heartbroken father\u2019s quest to uncover the truth behind his daughter's death, and his fightback against how the most powerful corporations of the modern age operate. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The tragic story behind a British teenager driven to take her life by machines that were built to control people for profit.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"suicide theme, self-harm references, distressing scenes\",\"translations\":[]},\"releaseDate\":\"2026-03-01\",\"runtimeInMinutes\":91,\"trailerUrl\":\"https://www.youtube.com/watch?v=vqgAGr8rmF0\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000005158\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013222\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000205\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006792\",\"hoCode\":\"A000008380\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000005158\",\"name\":{\"givenName\":\"Marc\",\"familyName\":\"Silver\",\"middleName\":null}},{\"id\":\"0000013222\",\"name\":{\"givenName\":\"Natalie\",\"familyName\":\"Humphreys\",\"middleName\":null}},{\"id\":\"HO00000205\",\"name\":{\"givenName\":\"Kat\",\"familyName\":\"Mansoor\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"HO00000006\",\"classification\":{\"text\":\"15\",\"translations\":[]},\"classificationDescription\":{\"text\":\"15\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000012\",\"name\":{\"text\":\"Programmed by Bertha Dochouse\",\"translations\":[]},\"shortName\":{\"text\":\"Dochouse\",\"translations\":[]},\"description\":{\"text\":\"Programmed by Bertha Dochouse | Preshows: 5 minutes\",\"translations\":[]},\"importantMessage\":{\"text\":\"Preshows: 5 minutes\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"BLO1-6\",\"name\":{\"text\":\"Bertha Doc