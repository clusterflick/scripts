          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-03-03\",\"showtimes\":[{\"id\":\"BLO1-106938\",\"schedule\":{\"businessDate\":\"2026-03-03\",\"startsAt\":\"2026-03-03T18:20:00+00:00\",\"endsAt\":\"2026-03-03T20:07:00+00:00\",\"filmStartsAt\":\"2026-03-03T18:27:00+00:00\",\"filmEndsAt\":\"2026-03-03T20:07:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006793\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-99950\",\"schedule\":{\"businessDate\":\"2026-03-03\",\"startsAt\":\"2026-03-03T19:15:00+00:00\",\"endsAt\":\"2026-03-03T22:45:00+00:00\",\"filmStartsAt\":\"2026-03-03T19:15:00+00:00\",\"filmEndsAt\":\"2026-03-03T22:45:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-18\",\"filmId\":\"HO00006231\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000042\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006231\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: Giselle\",\"translations\":[]},\"synopsis\":{\"text\":\"The peasant girl Giselle has fallen in love with Albrecht. When she discovers that he is actually a nobleman promised to another, she kills herself in despair. Her spirit joins the Wilis: the vengeful ghosts of women hell-bent on killing any man who crosses their path in a dance to the death. Wracked with guilt, Albrecht visits Giselle\u2019s grave, where he must face the Wilis \u2013 and Giselle\u2019s ghost. \\nPeter Wright\u2019s 1985 production of this quintessential Romantic ballet is a classic of The Royal Ballet repertory. Set to Adolphe Adam\u2019s evocative score and with atmospheric designs by John Macfarlane, Giselle conjures up the earthly and otherworldly realms in a tale of love, betrayal and redemption.\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The peasant girl Giselle has fallen in love with Albrecht. When she discovers that he is actually a nobleman promised to another, she kills herself in despair.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-03-03\",\"runtimeInMinutes\":210,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"0fa7e02d-9628-4cc4-ac98-b68f704eda30\",\"corporateId\":null},\"hopk\":\"HO00006231\",\"hoCode\":\"A000007688\",\"eventId\":\"0000000042\",\"distributorName\":\"Trafalgar Releasing\"},{\"id\":\"HO00006793\",\"title\":{\"text\":\"DocHouse: EPiC: Elvis Presley in Concert\",\"translations\":[]},\"synopsis\":{\"text\":\"Elvis sings and tells his story like never before in director Baz Luhrmann's second foray into the life and music of the King. \\r\\n\\r\\nThis time, Luhrmann presents the results of his extensive archival research during the making of his 2022 biopic, ELVIS, including never-before-seen footage from the singer's legendary residency in Las Vegas. Somewhere between concert film and a documentary narrated by Elvis himself, this is a bombastic technicolour and sound showcase of the performer, combining the spectacle of his live shows with the intimacy of moments behind the scenes. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Elvis sings and tells his story like never before in a new cinematic experience from visionary filmmaker Baz Luhrmann.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"moderate bad language, sex references, drug references\",\"translations\":[]},\"releaseDate\":\"2026-03-01\",\"runtimeInMinutes\":100,\"trailerUrl\":\"https://www.youtube.com/watch?v=V4rLM1k1nKY\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003331\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003332\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013179\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013180\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013181\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013182\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006793\",\"hoCode\":\"A000008381\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000003331\",\"name\":{\"givenName\":\"Baz\",\"familyName\":\"Luhrmann\",\"middleName\":null}},{\"id\":\"0000003332\",\"name\":{\"givenName\":\"Schuyler\",\"familyName\":\"Weiss\",\"middleName\":null}},{\"id\":\"0000013179\",\"name\":{\"givenName\":\"Elvis\",\"familyName\":\"Presley\",\"middleName\":null}},{\"id\":\"0000013180\",\"name\":{\"givenName\":\"Jeremy\",\"familyName\":\"Castro\",\"middleName\":null}},{\"id\":\"0000013181\",\"name\":{\"givenName\":\"Matthew\",\"familyName\":\"Gross\",\"middleName\":null}},{\"id\":\"0000013182\",\"name\":{\"givenName\":\"Colin\",\"familyName\":\"Smeeton\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}},{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"HO00000004\",\"classification\":{\"text\":\"12A\",\"translations\":[]},\"classificationDescription\":{\"text\":\"12A\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000012\",\"name\":{\"text\":\"Programmed by Bertha Dochouse\",\"translations\":[]},\"shortName\":{\"text\":\"Dochouse\",\"translations\":[]},\"description\":{\"text\":\"Programmed by Bertha Dochouse | Preshows: 5 minutes\",\"translations\":[]},\"importantMessage\":{\"text\":\"Preshows: 5 minutes\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false},{\"id\":\"0000000003\",\"name\":{\"text\":\"Live event\",\"translations\":[]},\"shortName\":{\"text\":\"Live\",\"translations\":[]},\"description\":{\"text\":\"Live Via Satellite\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"BLO1-6\",\"name\":{\"text\":\"Bertha Dochouse\",\"translations\":[]}},{\"id\":\"BLO1-5\",\"name\":{\"text\":\"Renoir Screen\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000042\",\"name\":{\"text\":\"Royal Ballet and Opera\",\"translations\":[]},\"shortName\":{\"text\":\"RB&O\",\"translations\":[]},\"description\":{\"text\":\"The Royal Ballet and Opera brings the thrill of world-class theatre to cinema screens right around the globe. \\n\\nWith productions across both Companies, the programme includes beloved classics as well as new productions.\\n\\nOffering audiences a view from the best seat in the house, the programme shares the joy of live performance, and the beauty of world-class art with cinemagoers in more than 1,500 cinemas and 50 countries around the world.\\n\",\"translations\":[]},\"schedule\":{\"startDate\":\"2024-09-01\",\"endDate\":\"2026-06-30\"},\"siteIds\":[\"ALD1\",\"BLO1\",\"CAM1\",\"CAN01\",\"CAN2\",\"COL1\",\"HOX1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SHE1\",\"SOH1\",\"VIC1\",\"WIM01\"]}],\"filmAdvanceBookingRules\":[],\"areaCateg