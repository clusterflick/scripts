          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-05\",\"showtimes\":[{\"id\":\"BLO1-111454\",\"schedule\":{\"businessDate\":\"2026-08-05\",\"startsAt\":\"2026-08-05T15:00:00+01:00\",\"endsAt\":\"2026-08-05T16:28:00+01:00\",\"filmStartsAt\":\"2026-08-05T15:07:00+01:00\",\"filmEndsAt\":\"2026-08-05T16:28:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00007228\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-110599\",\"schedule\":{\"businessDate\":\"2026-08-05\",\"startsAt\":\"2026-08-05T18:00:00+01:00\",\"endsAt\":\"2026-08-05T20:03:00+01:00\",\"filmStartsAt\":\"2026-08-05T18:25:00+01:00\",\"filmEndsAt\":\"2026-08-05T20:03:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-19\",\"filmId\":\"HO00007102\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-111240\",\"schedule\":{\"businessDate\":\"2026-08-05\",\"startsAt\":\"2026-08-05T18:20:00+01:00\",\"endsAt\":\"2026-08-05T20:12:00+01:00\",\"filmStartsAt\":\"2026-08-05T18:27:00+01:00\",\"filmEndsAt\":\"2026-08-05T20:12:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00007184\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007102\",\"title\":{\"text\":\"Film Club: Billy Liar (4K Restoration)\",\"translations\":[]},\"synopsis\":{\"text\":\"To mark the centenary of Academy Award-winning director John Schlesinger's birth, we're inviting you to experience his greatest films on the big screen. Season curated by Claire Nicolas and Marc David Jacobs.\\n\\nBILLY LIAR\\nA lazy, irresponsible young clerk (Sir Tom Courtenay) in provincial Northern England lives in his own fantasy world and makes emotionally immature decisions as he alienates friends and family.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A lazy, irresponsible young clerk in provincial Northern England lives in his own fantasy world and makes emotionally immature decisions as he alienates friends & family.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":98,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000049\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010274\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011662\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011663\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000723\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000724\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000725\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000049\"},{\"castAndCrewMemberId\":\"0000010274\"},{\"castAndCrewMemberId\":\"HO00000723\"},{\"castAndCrewMemberId\":\"HO00000724\"},{\"castAndCrewMemberId\":\"HO00000725\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000011662\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000011663\"}],\"genreIds\":[\"0000000002\",\"0000000003\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007102\",\"hoCode\":\"A000008749\",\"eventId\":null,\"distributorName\":\"Studio Canal\"},{\"id\":\"HO00007184\",\"title\":{\"text\":\"DocHouse: David Byrne's American Utopia\",\"translations\":[]},\"synopsis\":{\"text\":\"Do we get stupider as we grow up?’ In his wildly popular Broadway show American Utopia, David Byrne reflects on human connections, life and how on earth we work through it.\\nHe joins the dots with his music and it all starts making sense. Spike Lee here transforms the production into immersive, dynamic cinema that radiates with astounding performances, inventive contemporary dance and political urgency. American Utopia flows like an iridescent dream vision. Work by James Baldwin, Janelle Monáe and Kurt Schwitters is highlighted among exhilarating renditions of Byrne’s solo work, as well as Talking Heads classics.\\n\\nAccording to the multi-hyphenate, we love looking at humans more than anything else. Anti-fascist and anti-racist, Byrne illuminates our responsibility to care for one another as he and his co-performers burn down the house.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-08-05\",\"runtimeInMinutes\":105,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011349\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000011349\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007184\",\"hoCode\":\"A000008839\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00007228\",\"title\":{\"text\":\"DocHouse: The Phantom Pain of Rojava\",\"translations\":[]},\"synopsis\":{\"text\":\"In the autonomous Kurdish state of Rojava, northern Syria, a group of female fighters once dreamt of changing the world.\\n\\nIn the shadow of a failed revolution, Emmy-winning director Maryam Ebrahimi captures the hopes and dreams of these former guerrillas. Once celebrated as global heroes in the war against Islamic State, they now find themself abandoned by their allies, living secretly in a house for wounded soldiers.\\n\\nTHE PHANTOM PAIN OF ROJAVA is a post-war story, following a hidden community over the course of five years, as they struggle to rebuild their bodies and maintain their faith in the Women’s Revolution they dedicated their lives to protecting.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":81,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014337\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000014337\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007228\",\"hoCode\":\"A000008894\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000000049\",\"name\":{\"givenName\":\"Tom\",\"familyName\":\"Courtenay \",\"middleName\":null}},{\"id\":\"0000010274\",\"name\":{\"givenName\":\"Julie\",\"familyName\":\"Christie\",\"middleName\":null}},{\"id\":\"0000011662\",\"name\":{\"givenName\":\"John\",\"familyName\":\"Schlesinger\",\"middleName\":null}},{\"id\":\"0000011663\",\"name\":{\"givenName\":\"Joseph\",\"familyName\":\"Janni\",\"middleName\":null}},{\"id\":\"HO00000723\",\"name\":{\"givenName\":\"Leonard\",\"familyName\":\"Rossiter\",\"middleName\":null}},{\"id\":\"H