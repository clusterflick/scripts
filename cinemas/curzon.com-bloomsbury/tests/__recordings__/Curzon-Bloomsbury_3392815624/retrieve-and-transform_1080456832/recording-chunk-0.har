          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-04-21\",\"showtimes\":[{\"id\":\"BLO1-99952\",\"schedule\":{\"businessDate\":\"2026-04-21\",\"startsAt\":\"2026-04-21T18:45:00+01:00\",\"endsAt\":\"2026-04-21T22:15:00+01:00\",\"filmStartsAt\":\"2026-04-21T18:45:00+01:00\",\"filmEndsAt\":\"2026-04-21T22:15:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-18\",\"filmId\":\"HO00006233\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000042\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006233\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: The Magic Flute\",\"translations\":[]},\"synopsis\":{\"text\":\"Princess Pamina has been captured. Her mother, the Queen of the Night, tasks the young Prince Tamino with her daughter\u2019s rescue. But when Tamino and his friendly sidekick, Papageno, embark on their adventure, they soon learn that when it comes to the quest for love, nothing is as it really seems. Guided by a magic flute, they encounter monsters, villains, and a mysterious brotherhood of men \u2013 but help, it turns out, comes when you least expect it.\\nMozart\u2019s fantastical opera glitters in David McVicar\u2019s enchanting production. A star cast including Julia Bullock as Pamina, Amitai Pati as Tamino, Huw Montague Rendall as Papageno, Kathryn Lewek as the Queen of the Night, and Soloman Howard as Sarastro, led by French conductor Marie Jacquot in her Covent Garden debut.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Princess Pamina has been captured. Her mother, the Queen of the Night, tasks the young Prince Tamino with her daughter\u2019s rescue.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-04-21\",\"runtimeInMinutes\":210,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"HO00000053\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000286\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000340\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000555\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000610\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000611\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000612\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"0655a62a-7b31-4fb8-b211-ac46c269b5be\",\"corporateId\":null},\"hopk\":\"HO00006233\",\"hoCode\":\"A000007690\",\"eventId\":\"0000000042\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"HO00000053\",\"name\":{\"givenName\":\"David\",\"familyName\":\"McVicar\",\"middleName\":null}},{\"id\":\"HO00000286\",\"name\":{\"givenName\":\"Soloman\",\"familyName\":\"Howard\",\"middleName\":null}},{\"id\":\"HO00000340\",\"name\":{\"givenName\":\"Kathryn\",\"familyName\":\"Lewek\",\"middleName\":null}},{\"id\":\"HO00000555\",\"name\":{\"givenName\":\"Gerhard\",\"familyName\":\"Siegel\",\"middleName\":null}},{\"id\":\"HO00000610\",\"name\":{\"givenName\":\"Julia\",\"familyName\":\"Bullock\",\"middleName\":null}},{\"id\":\"HO00000611\",\"name\":{\"givenName\":\"Amitai\",\"familyName\":\"Pati\",\"middleName\":null}},{\"id\":\"HO00000612\",\"name\":{\"givenName\":\"Huw\",\"familyName\":\"Montague Rendall\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"HO00000004\",\"classification\":{\"text\":\"12A\",\"translations\":[]},\"classificationDescription\":{\"text\":\"12A\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000003\",\"name\":{\"text\":\"Live event\",\"translations\":[]},\"shortName\":{\"text\":\"Live\",\"translations\":[]},\"description\":{\"text\":\"Live Via Satellite\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"BLO1-5\",\"name\":{\"text\":\"Renoir Screen\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000042\",\"name\":{\"text\":\"Royal Ballet and Opera\",\"translations\":[]},\"shortName\":{\"text\":\"RB&O\",\"translations\":[]},\"description\":{\"text\":\"The Royal Ballet and Opera brings the thrill of world-class theatre to cinema screens right around the globe. \\n\\nWith productions across both Companies, the programme includes beloved classics as well as new productions.\\n\\nOffering audiences a view from the best seat in the house, the programme shares the joy of live performance, and the beauty of world-class art with cinemagoers in more than 1,500 cinemas and 50 countries around the world.\\n\",\"translations\":[]},\"schedule\":{\"startDate\":\"2024-09-01\",\"endDate\":\"2026-06-30\"},\"siteIds\":[\"ALD1\",\"BLO1\",\"CAM1\",\"CAN01\",\"CAN2\",\"COL1\",\"HOX1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SHE1\",\"SOH1\",\"VIC1\",\"WIM01\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"BLO1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
