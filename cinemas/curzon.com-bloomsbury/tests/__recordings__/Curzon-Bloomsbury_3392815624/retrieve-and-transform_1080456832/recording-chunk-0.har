            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-02-20\",\"showtimes\":[{\"id\":\"BLO1-106932\",\"schedule\":{\"businessDate\":\"2026-02-20\",\"startsAt\":\"2026-02-20T18:20:00+00:00\",\"endsAt\":\"2026-02-20T19:57:00+00:00\",\"filmStartsAt\":\"2026-02-20T18:27:00+00:00\",\"filmEndsAt\":\"2026-02-20T19:57:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006791\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006791\",\"title\":{\"text\":\"DocHouse: Fukushima: A Nuclear Nightmare\",\"translations\":[]},\"synopsis\":{\"text\":\"On March 2011, Japan suffered its most powerful earthquake in a thousand years. A towering tsunami followed, breaching the Fukushima nuclear plant\u2019s 10-metre-high seawalls - and triggering a crisis that threatened to become ten times worse than Chernobyl.\\r\\n\\r\\nFUKUSHIMA is the definitive chronicle of this unprecedented disaster. Epic, immersive and unflinching, the film blends testimony from the Fukushima 50 - the engineers, technicians and firefighters who donned radiation suits and remained on site - with breathtaking archive footage to document events as they unfolded, minute by minute.\\r\\n\\r\\nAn unforgettable yet redemptive story of survival, ingenuity and the fight to pull back from the brink, FUKUSHIMA is both a cautionary tale and a powerful testament to human resilience.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-20\",\"runtimeInMinutes\":90,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002823\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000010224\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006791\",\"hoCode\":\"A000008379\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000002823\",\"name\":{\"givenName\":\"James\",\"familyName\":\"Jones\",\"middleName\":null}},{\"id\":\"0000010224\",\"name\":{\"givenName\":\"Megumi\",\"familyName\":\"Inman\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000012\",\"name\":{\"text\":\"Programmed by Bertha Dochouse\",\"translations\":[]},\"shortName\":{\"text\":\"Dochouse\",\"translations\":[]},\"description\":{\"text\":\"Programmed by Bertha Dochouse | Preshows: 5 minutes\",\"translations\":[]},\"importantMessage\":{\"text\":\"Preshows: 5 minutes\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"BLO1-6\",\"name\":{\"text\":\"Bertha Dochouse\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"BLO1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
