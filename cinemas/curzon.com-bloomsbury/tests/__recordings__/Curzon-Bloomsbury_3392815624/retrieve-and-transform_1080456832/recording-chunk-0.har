000009\"}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"536f842c-5192-422a-bee4-109ff5f455e6\",\"corporateId\":null},\"hopk\":\"HO00006949\",\"hoCode\":\"A000008565\",\"eventId\":null,\"distributorName\":\"Picturehouse Entertainment\"},{\"id\":\"HO00006951\",\"title\":{\"text\":\"Obsession\",\"translations\":[]},\"synopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for but soon discovers that some desires come at a dark, sinister price.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for.\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":null,\"releaseDate\":\"2026-05-15\",\"runtimeInMinutes\":109,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/53c5bdfb-4dbf-47f5-8eca-b0b807ee068c/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=fWLaCC8L6Jo\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=fWLaCC8L6Jo\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003927\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013704\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013705\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013706\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013707\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013708\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013709\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013710\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000254\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000013704\"},{\"castAndCrewMemberId\":\"0000013705\"},{\"castAndCrewMemberId\":\"0000013706\"},{\"castAndCrewMemberId\":\"0000013707\"},{\"castAndCrewMemberId\":\"0000013708\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000013709\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000003927\"},{\"castAndCrewMemberId\":\"0000013710\"},{\"castAndCrewMemberId\":\"HO00000254\"}],\"genreIds\":[\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"53c5bdfb-4dbf-47f5-8eca-b0b807ee068c\",\"corporateId\":null},\"hopk\":\"HO00006951\",\"hoCode\":\"A000008567\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006970\",\"title\":{\"text\":\"AKIRA (2026 Re-release) (Subbed)\",\"translations\":[]},\"synopsis\":{\"text\":\"Iconic and game-changing, AKIRA is the definitive anime masterpiece! Katsuhiro Otomo's landmark cyberpunk classic obliterated the boundaries of Japanese animation and forced the world to look into the future. AKIRA's arrival shattered traditional thinking, creating space for future generations of ground-breaking movies. \\n\\nJuly, 1988— World War III breaks loose. Then, in 2019, in megalopolis Tokyo... \\n\\nAs the leader of a group of young robust delinquents, Kaneda spent his nights tearing through the urban wastes, racing his motorbike against rival groups. One night while riding with his gang, his friend Tetsuo suddenly encounters a strange boy― the product of human experimentation— and is injured in the ensuing crash. Shortly thereafter, a military squadron appears on the scene to take the boy and Tetsuo away to an army research facility. Determined to free Tetsuo from capture, Kaneda sneaks into the army research lab. However, a regimen of extreme experimental procedures has awakened a new power in his friend, and now he is consumed by madness… \\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A secret military project endangers Neo-Tokyo when it turns a biker gang member into a rampaging psychic psychopath that only two teenagers and a group of psychics can st\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-04-17\",\"runtimeInMinutes\":124,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/e7b9aeb4-f755-4e8e-abdb-525593dfcd34/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=Jq4ER-P6NCQ\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=Jq4ER-P6NCQ\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"HO00000716\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000717\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000718\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000719\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000720\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000721\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000722\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"HO00000716\"},{\"castAndCrewMemberId\":\"HO00000717\"},{\"castAndCrewMemberId\":\"HO00000718\"},{\"castAndCrewMemberId\":\"HO00000719\"}],\"directors\":[{\"castAndCrewMemberId\":\"HO00000720\"}],\"producers\":[{\"castAndCrewMemberId\":\"HO00000721\"},{\"castAndCrewMemberId\":\"HO00000722\"}],\"genreIds\":[\"0000000002\",\"0000000003\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e7b9aeb4-f755-4e8e-abdb-525593dfcd34\",\"corporateId\":null},\"hopk\":\"HO00006970\",\"hoCode\":\"A000008590\",\"eventId\":null,\"distributorName\":\"Anime\"},{\"id\":\"HO00007043\",\"title\":{\"text\":\"Effi o Blaenau\",\"translations\":[]},\"synopsis\":{\"text\":\"Based on Gary Owen's much lauded and widely performed monodrama, Iphigenia in Splott, 'Effi o Blaenau' is director Marc Evans' cinematic interpretation set against the wide open landscapes of North Wales. \\n\\nThe film follows Effi, a young woman desperate to escape a town where the pubs are closed, the jobs have vanished and her grandmother works night shifts in the local chip shop just to get by. A chance encounter in a Llandudno nightclub with injured soldier Lee, played by Tom Rhys Harries, briefly opens a door to something better. For a moment, Effi glimpses a life she never imagined. The reality that follows is far tougher. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Based on Gary Owen's much lauded and widely performed monodrama, Iphigenia in Splott, 'Effi o Blaenau' is director Marc Evans' cinematic interpretation \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-19\",\"runtimeInMinutes\":91,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/7674f395-c052-4003-9088-5ba8bfbd4bb3/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=elibOEvAVTo\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=elibOEvAVTo\",\"displayPriority\":10,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003703\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010833\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013980\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013981\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013982\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013983\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013984\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"14072\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"14073\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"14074\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000003703\"},{\"castAndCrewMemberId\":\"0000013980\"},{\"castAndCrewMemberId\":\"0000013981\"},{\"castAndCrewMemberId\":\"0000013982\"},{\"castAndCrewMemberId\":\"0000013983\"},{\"castAndCrewMemberId\":\"14072\"},{\"castAndCrewMemberId\":\"14073\"},{\"castAndCrewMemberId\":\"14074\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000010833\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000013984\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"7674f395-c052-4003-9088-5ba8bfbd4bb3\",\"corporateId\":null},\"hopk\":\"HO00007043\",\"hoCode\":\"A000008681\",\"eventId\":null,\"distributorName\":\"Met Film\"},{\"id\":\"HO00007047\",\"title\":{\"text\":\"Blue Heron\",\"translations\":[]},\"synopsis\":{\"text\":\"Set on Vancouver Island in the late 1990s, Blue Heron follows eight‑year‑old Sasha and her Hungarian immigrant family as they attempt to build a new life, only to be destabilised by the increasingly dangerous behaviour of her older brother, Jeremy. Drawing on her own memories, filmmaker Sophy Romvari shapes a deeply personal portrait of childhood, family fractures, and the fragility of recollection. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Set on Vancouver Island in the late 1990s, Blue Heron follows eight‑year‑old Sasha and her Hungarian immigrant family as they attempt to build a new life\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"upsetting scenes, moderate injury detail, infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-06-26\",\"runtimeInMinutes\":91,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=6qAK9GwWRe0\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=6qAK9GwWRe0\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000013999\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014000\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014001\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014002\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014003\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014004\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014005\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014006\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014007\",\"roles\":[\"Director\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000013999\"},{\"castAndCrewMemberId\":\"0000014000\"},{\"castAndCrewMemberId\":\"0000014001\"},{\"castAndCrewMemberId\":\"0000014002\"},{\"castAndCrewMemberId\":\"0000014003\"},{\"castAndCrewMemberId\":\"0000014004\"},{\"castAndCrewMemberId\":\"0000014005\"},{\"castAndCrewMemberId\":\"0000014006\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000014007\"}],\"producers\":[],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c78c4173-ca8f-429b-a33a-07137d47703c\",\"corporateId\":null},\"hopk\":\"HO00007047\",\"hoCode\":\"A000008685\",\"eventId\":null,\"distributorName\":\"Conic\"},{\"id\":\"HO00007050\",\"title\":{\"text\":\"A Private Life\",\"translations\":[]},\"synopsis\":{\"text\":\"When renowned psychiatrist Lilian Steiner learns of the death of one of her patients, she is convinced it was murder and takes it upon herself to investigate…\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When renowned psychiatrist Lilian Steiner learns of the death of one of her patients, she is convinced it was murder and takes it upon herself to investigate…\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, sex, nudity, violence\",\"translations\":[]},\"releaseDate\":\"2026-06-26\",\"runtimeInMinutes\":103,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/a4c6f5dc-ec1c-4670-ad71-942fd06e38c9/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=2JabG5C6IU8\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=2JabG5C6IU8\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000870\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001619\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004195\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005272\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005273\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006143\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006968\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014009\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000186\"},{\"castAndCrewMemberId\":\"0000000870\"},{\"castAndCrewMemberId\":\"0000001619\"},{\"castAndCrewMemberId\":\"0000004195\"},{\"castAndCrewMemberId\":\"0000006143\"},{\"castAndCrewMemberId\":\"0000006968\"},{\"castAndCrewMemberId\":\"0000014009\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000005272\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000005273\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a4c6f5dc-ec1c-4670-ad71-942fd06e38c9\",\"corporateId\":null},\"hopk\":\"HO00007050\",\"hoCode\":\"A000008689\",\"eventId\":null,\"distributorName\":\"Altitude Film Distribution\"},{\"id\":\"HO00007116\",\"title\":{\"text\":\"The Odyssey\",\"translations\":[]},\"synopsis\":{\"text\":\"Legendary filmmaker Christopher Nolan follows up his Oscar-winning sensation Oppenheimer with another rousing epic, The Odyssey, whose all-star cast includes Matt Damon, Tom Holland, Anne Hathaway, Robert Pattinson, Lupita Nyong'o, Zendaya and Charlize Theron.\\n\\nThis mythic action movie recounts the story of Odysseus (Damon) on his perilous journey home, troubled by gods and monsters. Meanwhile, his wife Penelope (Hathaway) and son Telemachus (Holland) fight to hold their kingdom together against relentless suitors.\\n\\nSee it on 35mm film at Soho, and enjoy it with Dolby Atmos sound at Bloomsbury, Canterbury Riverside and Kingston.\\n\\nTHE ODYSSEY MIDNIGHT SCREENINGS\\nThe film will start promptly at 12:01am on Thursday night. Please ensure you are seated by midnight.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence\",\"translations\":[]},\"releaseDate\":\"2026-07-17\",\"runtimeInMinutes\":172,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/b3ff6b75-3025-43b7-88a5-37fc8c43d313/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=Sk6LZrA2JSQ\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000319\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000680\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001061\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002220\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002609\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003850\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004443\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005731\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000014094\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000319\"},{\"castAndCrewMemberId\":\"0000000680\"},{\"castAndCrewMemberId\":\"0000001061\"},{\"castAndCrewMemberId\":\"0000002220\"},{\"castAndCrewMemberId\":\"0000002609\"},{\"castAndCrewMemberId\":\"0000003850\"},{\"castAndCrewMemberId\":\"0000004443\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000005731\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000005731\"},{\"castAndCrewMemberId\":\"0000014094\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b3ff6b75-3025-43b7-88a5-37fc8c43d313\",\"corporateId\":null},\"hopk\":\"HO00007116\",\"hoCode\":\"A000008764\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00007141\",\"title\":{\"text\":\"DocHouse: Life Support\",\"translations\":[]},\"synopsis\":{\"text\":\"Since October 2023, Gaza has been sealed from the world-except for one group, international doctors. While global media are barred from reporting and governments look away, doctors breach the blockade and what they find is not just a humanitarian crisis, but a calculated dismantling of life itself. \\n\\nTheir firsthand accounts and visceral footage offer a rare and vital chronicle of the daily struggles of healthcare workers as they navigate bombed-out hospitals, dwindling supplies, starvation and the overwhelming influx of casualties - predominantly women and children.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":93,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007830\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000007830\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007141\",\"hoCode\":\"A000008792\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00007147\",\"title\":{\"text\":\"The Invite\",\"translations\":[]},\"synopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \\nHave they reignited the spark or lit the match that burns it all down?\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"very strong language, strong sex references, drug misuse\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":106,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/ad147b9a-b731-410f-8bf9-c4f3f3df2095/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=jnLW-q2ftKA\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=jnLW-q2ftKA\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001093\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002460\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003915\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"0000004392\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004710\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007157\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013073\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014130\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000002460\"},{\"castAndCrewMemberId\":\"0000003915\"},{\"castAndCrewMemberId\":\"0000004392\"},{\"castAndCrewMemberId\":\"0000004710\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000003915\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000001093\"},{\"castAndCrewMemberId\":\"0000007157\"},{\"castAndCrewMemberId\":\"0000013073\"},{\"castAndCrewMemberId\":\"0000014130\"}],\"genreIds\":[\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ad147b9a-b731-410f-8bf9-c4f3f3df2095\",\"corporateId\":null},\"hopk\":\"HO00007147\",\"hoCode\":\"A000008799\",\"eventId\":null,\"distributorName\":\"Black Bear\"},{\"id\":\"HO00007151\",\"title\":{\"text\":\"The Last One for the Road\",\"translations\":[]},\"synopsis\":{\"text\":\"Two blustery 50-somethings, have an obsession: going for their last drink. One night, they run into Giulio, a shy architecture student, whose way of seeing the world and love will be transformed as the trio wander from bar to bar of Veneto.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Two blustery 50-somethings, have an obsession: going for their last drink. One night, they run into Giulio, a shy architecture student.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, brief drug misuse, nudity\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":101,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001878\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010359\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014140\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014141\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014142\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014143\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014144\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001878\"},{\"castAndCrewMemberId\":\"0000014140\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000014141\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000010359\"},{\"castAndCrewMemberId\":\"0000014142\"},{\"castAndCrewMemberId\":\"0000014143\"},{\"castAndCrewMemberId\":\"0000014144\"}],\"genreIds\":[\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"8e65db5e-373f-48e3-8d4d-13723f281cc0\",\"corporateId\":null},\"hopk\":\"HO00007151\",\"hoCode\":\"A000008803\",\"eventId\":null,\"distributorName\":\"Bulldog Film Distribution\"},{\"id\":\"HO00007152\",\"title\":{\"text\":\"Rosebush Pruning\",\"translations\":[]},\"synopsis\":{\"text\":\"Underneath the Catalonian sun, a rich white American family lives in hedonistic isolation, seeking love and validation through one another, their designer wardrobes and pop music. When an outsider infiltrates the family, buried tensions surface and blood ties are severed. \\n\\nAn outrageous, biting satire on the absurdity of patriarchal family, starring Callum Turner, Riley Keough, Jamie Bell, Lukas Gage, Elena Anaya, Tracy Letts, Elle Fanning and Pamela Anderson.\\n\\nFrom award winning director Karim Aïnouz, written by Oscar nominated writer Efthimis Filippou, ROSEBUSH PRUNING is absurd, funny and in equal measure. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Underneath the Catalonian sun, a rich white American family lives in hedonistic isolation, seeking love and validation through one another, their designer wardrobes\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":{\"text\":\"sexual violence, strong sex, nudity\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":95,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/ab78ddcf-eae4-4e1c-9d6a-68f6392793c8/media/TrailerVideo\"}],\"trailerUrl\":null,\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000497\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000736\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001041\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001073\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001820\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005512\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006483\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007166\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008082\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008105\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010500\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013540\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014145\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001041\"},{\"castAndCrewMemberId\":\"0000001073\"},{\"castAndCrewMemberId\":\"0000005512\"},{\"castAndCrewMemberId\":\"0000006483\"},{\"castAndCrewMemberId\":\"0000007166\"},{\"castAndCrewMemberId\":\"0000008105\"},{\"castAndCrewMemberId\":\"0000010500\"},{\"castAndCrewMemberId\":\"0000014145\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000001820\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000000497\"},{\"castAndCrewMemberId\":\"0000000736\"},{\"castAndCrewMemberId\":\"0000008082\"},{\"castAndCrewMemberId\":\"0000013540\"}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ab78ddcf-eae4-4e1c-9d6a-68f6392793c8\",\"corporateId\":null},\"hopk\":\"HO00007152\",\"hoCode\":\"A000008804\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00007167\",\"title\":{\"text\":\"DocHouse: Birds of War\",\"translations\":[]},\"synopsis\":{\"text\":\"BIRDS OF WAR is the love story of a London-based Lebanese journalist and a Syrian activist/cameraman over thirteen years of revolutions, war and exile.\\n\\nYoung BBC reporter Janay first contacts Syrian cameraman Habak for footage during the final months of the four-year battle for Aleppo in 2016, one of the bloodiest and most decisive turning points in Syria’s brutal civil war. Over time, through texts, video exchanges, voice messages and shared moments from afar, the bond between them strengthens, and as the political landscape shifts around them - from Syria to Lebanon and beyond - their dual roles as journalists and lovers become impossible to separate\\n\\nCo-directed by Janay and Habak, BIRDS OF WAR delves into their personal archives to tell a story both intimate and international. Every new crisis tests what holds them together, capturing the deeply human need for connection amidst truth, propaganda and the chaos of conflict.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":85,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014182\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014183\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000014182\"},{\"castAndCrewMemberId\":\"0000014183\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007167\",\"hoCode\":\"A000008820\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00007170\",\"title\":{\"text\":\"DocHouse: Replica\",\"translations\":[]},\"synopsis\":{\"text\":\"In China, increasing numbers of young women are embarking on AI relationships. REPLICA follows three women whose virtual boyfriends fill emotional gaps left by loneliness, unfulfilling marriages and the pursuit of independence.\\n\\nQin, Muna and Sonya all have different reasons for finding AI love. For factory worker Qin, its more accessible than a real world relationship, whereas for young mum Muna, it provides the compassion and support missing from her marriage, and tech-savvy Sonya treats her AI lover as an emotional experiment - until it betrays her expectations. \\n\\nAs their virtual relationships deepen, REPLICA reveals the fragile boundary between emotional freedom and reliance on AI, and explores how AI reshapes love, intimacy, and gender in modern China.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"0000000005\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-08\",\"runtimeInMinutes\":90,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000014204\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000014204\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007170\",\"hoCode\":\"A000008824\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00007171\",\"title\":{\"text\":\"DocHouse: Synthetic Sincerity\",\"translations\":[]},\"synopsis\":{\"text\":\"Marc Isaacs returns with a curious interrogation of the new world of AI authenticity, in a humorous hybrid that plays with form and with expectations. \\n\\nThe Synthetic Sincerity Lab based at the University of Southern England are trying to create authentic AI characters as part of a new research project. The lab wish to license Marc Isaacs' films in order to study the real people he has captured, helping the to create more realistic AIs. In return, they will let the filmmaker document their working process.\\n\\nSo Synthetic Sincerity leads us down the rabbit hole into a winding world of documentary, fiction, reality and synthetic creation, reflecting on what is happening to the human face in the era of AI, and what this might mean for the future of cinema.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-12\",\"runtimeInMinutes\":71,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000659\",\"roles\":[\"Director\"]}],\"actors\":[],\"directors\":[{\"castAndCrewMemberId\":\"0000000659\"}],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007171\",\"hoCode\":\"A000008825\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00007210\",\"title\":{\"text\":\"BACKROOMS: EVERYTHING MUST GO WITH BONUS FOOTAGE\",\"translations\":[]},\"synopsis\":{\"text\":\"In the basement of a furniture showroom, a man (Chiwetel Ejiofor) stumbles upon a strange doorway that leads into a mysterious, otherworldly labyrinth. His therapist (Renate Reinsve) doesn't believe him, so he sets out on a mission to gather some proof. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A strange doorway appears in the basement of a furniture showroom.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, violence, injury detail, horror\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":126,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=tKGhxMi50y8\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=tKGhxMi50y8\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000578\",\"roles\