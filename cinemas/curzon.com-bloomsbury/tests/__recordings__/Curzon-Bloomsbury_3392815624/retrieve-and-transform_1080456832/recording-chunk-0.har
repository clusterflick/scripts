            "text": "{\"businessDate\":\"2026-03-05\",\"showtimes\":[{\"id\":\"BLO1-107112\",\"schedule\":{\"businessDate\":\"2026-03-05\",\"startsAt\":\"2026-03-05T18:00:00+00:00\",\"endsAt\":\"2026-03-05T20:14:00+00:00\",\"filmStartsAt\":\"2026-03-05T18:25:00+00:00\",\"filmEndsAt\":\"2026-03-05T20:14:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-19\",\"filmId\":\"HO00006809\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006809\",\"title\":{\"text\":\"Film Club: Left-Handed Girl\",\"translations\":[]},\"synopsis\":{\"text\":\"A single mother and her two daughters return to Taipei after several years of living in the countryside to open a stand at a buzzing night market. Each in their way will have to adapt to this new environment to make ends meet and maintain the family unity. But when their traditional grandfather forbids his youngest left-handed granddaughter from using her \\\"devil hand,\\\" generations of family secrets begin to unravel.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When a single mother and her two daughters relocate to Taipei to open a night market stall, they encounter new challenges and generations of secrets.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, sex\",\"translations\":[]},\"releaseDate\":\"2026-03-05\",\"runtim