          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-11\",\"showtimes\":[{\"id\":\"BLO1-111629\",\"schedule\":{\"businessDate\":\"2026-08-11\",\"startsAt\":\"2026-08-11T18:00:00+01:00\",\"endsAt\":\"2026-08-11T19:50:00+01:00\",\"filmStartsAt\":\"2026-08-11T18:07:00+01:00\",\"filmEndsAt\":\"2026-08-11T19:50:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-1-2\",\"filmId\":\"HO00007234\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-1\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247001647949,\"longitude\":-0.123000003397465},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"BLO1@curzon.com\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":false,\"allowedItemDeliveryMethods\":[]}],\"films\":[{\"id\":\"HO00007234\",\"title\":{\"text\":\"Curzon Film 50: Quo vadis, Aida?\",\"translations\":[]},\"synopsis\":{\"text\":\"The award-winning director of 'Grbavica: The Land of My Dreams' returns with a powerful drama focused on one of the most shameful moments of recent European history.\\n\\nSrebrenica is no longer just the name of a town. It represents the worst of human cruelty and an act that many had hoped was expunged from European history with the end of the Second World War. Jasmila Zbanic's drama unfolds in 1995, just as the Serbian army have entered the mostly Muslim Bosnia town. Aida is a translator for the UN. Her family is among the thousands of citizens looking for shelter in the UN camp. But as an insider to the negotiations, she has access to crucial information that forces her into the untenable position of deciding between her obligation to those she loves and the role that has a wider impact. Zbanic's humanity, locating her story on a relatable level, within an event that many of us might find impossible to comprehend, is what raises 'Quo Vadis Aida' far above the level of the standard war film.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The award-winning director of 'Grbavica: The Land of My Dreams' returns with a powerful drama focused on one of the most shameful moments of recent European history.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong language, threat, brief sexual threat\",\"translations\":[]},\"releaseDate\":\"2026-07-31\",\"runtimeInMinutes\":103,\"trailers\":[{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=ErLD8P4VUjY\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=ErLD8P4VUjY\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001464\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001465\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004635\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000024\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000833\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000834\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000835\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000836\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000837\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000838\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000839\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000840\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000841\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000842\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000843\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000844\",\"roles\":[\"Producer\"]}