            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-02-08\",\"showtimes\":[{\"id\":\"BLO1-106571\",\"schedule\":{\"businessDate\":\"2026-02-08\",\"startsAt\":\"2026-02-08T14:10:00+00:00\",\"endsAt\":\"2026-02-08T15:45:00+00:00\",\"filmStartsAt\":\"2026-02-08T14:17:00+00:00\",\"filmEndsAt\":\"2026-02-08T15:45:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006782\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-106365\",\"schedule\":{\"businessDate\":\"2026-02-08\",\"startsAt\":\"2026-02-08T16:00:00+00:00\",\"endsAt\":\"2026-02-08T17:29:00+00:00\",\"filmStartsAt\":\"2026-02-08T16:07:00+00:00\",\"filmEndsAt\":\"2026-02-08T17:29:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006776\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006776\",\"title\":{\"text\":\"DocHouse: Taxi Tehran\",\"translations\":[]},\"synopsis\":{\"text\":\"Panahi directs and stars in this docufiction miracle, which finds him posing as a taxi driver in Tehran who, rather than demanding cash payment from customers for his services, asks only to hear something about their lives. What results is a symphony of the diverse voices of the Iranian capital. \\r\\n\\r\\nBanned from filmmaking in 2010, Panahi was still finding ways to capture the spirit and contradictions of Iranian society through surreptitious, but undeniably playful, means. \\r\\n\\r\\nThis beautiful, blended, hybrid film - in which Panahi is both auteur and actor, conducter and interlocuter - won the Golden Bear at the 2015 Berlin Film Festival. \",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"0000000005\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-08\",\"runtimeInMinutes\":82,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003596\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006776\",\"hoCode\":\"A000008358\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006782\",\"title\":{\"text\":\"DocHouse: Andr\u00e9 is an Idiot\",\"translations\":[]},\"synopsis\":{\"text\":\"Unexpected, irreverent, and absurdly funny, ANDR\u00c9 IS AN IDIOT is a wildly life-affirming film about death. When Andr\u00e9, a brilliant idiot, learns he's dying from a disease he could have detected with a colonoscopy, he decides to document his final journey. As an iconoclastic ad man, he had defied convention throughout his life. True to form, Andr\u00e9 approaches mortality with his trademark humor and curiosity, determined to learn how to die both happily and ridiculously.\\r\\n\\r\\nIn a unique collaboration with director Tony Benna, Andr\u00e9's stories and musings are brought to life with imaginative stop-motion animation, capturing his unique approach to life's challenges and joys. ANDR\u00c9 IS AN IDIOT is a celebration of resilience, inappropriate humor, and the beauty of fully embracing the human experience - even at its end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Andr\u00e9, a brilliant idiot, is dying because he didn\u2019t get a colonoscopy. His sobering diagnosis, complete irreverence, and insatiable curiosity, send him on a journey.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-06\",\"runtimeInMinutes\":88,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004846\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010734\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013199\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000013200\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013201\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013202\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\",\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006782\",\"hoCode\":\"A000008365\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000003596\",\"name\":{\"givenName\":\"Jafar\",\"familyName\":\"Panahi\",\"middleName\":null}},{\"id\":\"0000004846\",\"name\":{\"givenName\":\"Joshua\",\"familyName\":\"Altman\",\"middleName\":null}},{\"id\":\"0000010734\",\"name\":{\"givenName\":\"Tory\",\"familyName\":\"Tunnell\",\"middleName\":null}},{\"id\":\"0000013199\",\"name\":{\"givenName\":\"Tony\",\"familyName\":\"Benna\",\"middleName\":null}},{\"id\":\"0000013200\",\"name\":{\"givenName\":\"Ben\",\"familyName\":\"Cotner\",\"middleName\":null}},{\"id\":\"0000013201\",\"name\":{\"givenName\":\"Stelio\",\"familyName\":\"Kitrilakis\",\"middleName\":null}},{\"id\":\"0000013202\",\"name\":{\"givenName\":\"Andr\u00e9\",\"familyName\":\"Ricciardi\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":{\"text\":\"Drama\",\"translations\":[]}},{\"id\":\"0000000003\",\"name\":{\"text\":\"Comedy\",\"translations\