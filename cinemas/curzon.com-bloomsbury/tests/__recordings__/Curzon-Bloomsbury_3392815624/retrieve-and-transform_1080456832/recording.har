          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 5130,
            "text": "{\"businessDate\":\"2025-09-08\",\"showtimes\":[{\"id\":\"BLO1-99733\",\"schedule\":{\"businessDate\":\"2025-09-08\",\"startsAt\":\"2025-09-08T18:00:00+01:00\",\"endsAt\":\"2025-09-08T20:13:00+01:00\",\"filmStartsAt\":\"2025-09-08T18:25:00+01:00\",\"filmEndsAt\":\"2025-09-08T20:13:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-18\",\"filmId\":\"HO00001704\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"BLO1-2-HO00001704\"}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00001704\",\"title\":{\"text\":\"Film Club: Happy End\",\"translations\":[]},\"synopsis\":{\"text\":\"Master auteur Michael Haneke (Amour, The White Ribbon, Hidden) returns with a biting satire on bourgeois family values set in the shadow of the European refugee crisis. Featuring a cast of top acting talent, including Isabelle Huppert, Jean-Louis Trintignant, Mathieu Kassovitz and Toby Jones, it’s a piercing dark comedy on the blind preoccupations of middle-class angst.\\n\\nWhen her mother falls ill under mysterious circumstances, young Eve (Fantine Harduin) is sent to live with her estranged father’s relatives in Calais. The Laurent family – wealthy, neurotic and self-obsessed – own a lucrative construction company and live in a sprawling mansion house, waited on by servants. But trouble is brewing, as a series of intergenerational back-stabbings threaten to tear the family apart. Meanwhile, distracted by infidelities and betrayals, they fail to notice that their new arrival has a sinister secret of her own.\\n\\nNominated for the Palme d’Or at the 2017 Cannes Film Festival, Happy End bears all the hallmarks of Haneke’s uniquely stark and unsympathetic style. Pairing pitch-black humour with chillingly precise direction, it’s proof – if we ever needed it – that he remains one of modern cinema’s true visionaries.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A drama about a family set in Calais with the European refugee crisis as the backdrop.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong sex references, suicide references, language\",\"translations\":[]},\"releaseDate\":\"2025-08-23\",\"runtimeInMinutes\":108,\"trailerUrl\":\"https://www.youtube.com/watch?v=r_n_yk2AT7w\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000258\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000491\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002163\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010826\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011334\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011335\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011336\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00001704\",\"hoCode\":\"A000002184\",\"eventId\":null,\"distributorName\":\"Curzon\"}],\"castAndCrew\":[{\"id\":\"0000000258\",\"name\":{\"givenName\":\"Isabelle\",\"familyName\":\"Huppert\",\"middleName\":null}},{\"id\":\"0000000491\",\"name\":{\"givenName\":\"Franz \",\"familyName\":\"Rogowski\",\"middleName\":null}},{\"id\":\"0000002163\",\"name\":{\"givenName\":\"Toby\",\"familyName\":\"Jones\",\"middleName\":null}},{\"id\":\"0000010826\",\"name\":{\"givenName\":\"Jean-Louis\",\"familyName\":\"Trintignant\",\"middleName\":null}},{\"id\":\"0000011334\",\"name\":{\"givenName\":\"Michael\",\"familyName\":\"Haneke\",\"middleName\":null}},{\"id\":\"0000011335\",\"name\":{\"givenName\":\"Fantine\",\"familyName\":\"Harduin\",\"middleName\":null}},{\"id\":\"0000011336\",\"name\":{\"givenName\":\"Margaret\",\"familyName\":\"Ménégoz\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":{\"text\":\"Drama\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"HO00000006\",\"classification\":{\"text\":\"15\",\"translations\":[]},\"classificationDescription\":{\"text\":\"15\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000053\",\"name\":{\"text\":\"Film Club\",\"translations\":[]},\"shortName\":{\"text\":\"Film Club\",\"translations\":[]},\"description\":{\"text\":\"Film Club Screening. Browse more at curzon.com/film-club\",\"translations\":[]},\"importantMessage\":{\"text\":\"Film Club Screening\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"BLO1-5\",\"name\":{\"text\":\"Renoir Screen\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[{\"id\":\"BLO1-2-HO00001704\",\"filmId\":\"HO00001704\",\"siteId\":\"BLO1\",\"bookingPeriods\":[{\"startsAt\":\"2023-12-01T06:00:00+00:00\",\"orderBookingModes\":[\"Paid\",\"Unpaid\",\"UnpaidConfirmed\"],\"restriction\":\"None\",\"rewardId\":null}]}],\"areaCategories\":[{\"id\":\"BLO1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}"
