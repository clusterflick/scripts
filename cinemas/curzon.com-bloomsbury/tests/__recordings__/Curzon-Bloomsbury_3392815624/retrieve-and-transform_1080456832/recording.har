            "text": "{\"businessDate\":\"2025-07-08\",\"showtimes\":[{\"id\":\"BLO1-100616\",\"schedule\":{\"businessDate\":\"2025-07-08\",\"startsAt\":\"2025-07-08T20:30:00+01:00\",\"endsAt\":\"2025-07-08T22:18:00+01:00\",\"filmStartsAt\":\"2025-07-08T20:37:00+01:00\",\"filmEndsAt\":\"2025-07-08T22:18:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006285\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006285\",\"title\":{\"text\":\"DocHouse: S/he Is Still Her/e: Genesis P-Orridge\",\"translations\":[]},\"synopsis\":{\"text\":\"An introduction, conversation and perhaps goodbye to Genesis P-Orridge, who left an astounding and provocative legacy on the worlds of music, art, performance, religion and the occult. A larger-than-life personality that must be experienced to be grasped, Genesis opens up portals to a way of living that transforms and transcends.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Showcases an introduction, conversation and goodbye to Genesis P-Orridge, who left a legacy on the worlds of music, performance, art, religion and the occult.\",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":{\"text\":\"strong sex, nudity\",\"translations\":[]},\"releaseDate\":\"2025-06-27\",\"runtimeInMinutes\":101,\"trailerUrl\":null,\"displayPriority\":50,\"castA