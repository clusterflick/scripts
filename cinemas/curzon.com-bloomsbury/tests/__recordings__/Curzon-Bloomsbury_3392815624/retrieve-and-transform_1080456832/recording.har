            "text": "{\"businessDate\":\"2025-07-18\",\"showtimes\":[{\"id\":\"BLO1-100634\",\"schedule\":{\"businessDate\":\"2025-07-18\",\"startsAt\":\"2025-07-18T18:20:00+01:00\",\"endsAt\":\"2025-07-18T20:09:00+01:00\",\"filmStartsAt\":\"2025-07-18T18:27:00+01:00\",\"filmEndsAt\":\"2025-07-18T20:09:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006283\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006283\",\"title\":{\"text\":\"DocHouse: The Brink of Dreams\",\"translations\":[]},\"synopsis\":{\"text\":\"In a remote village in southern Egypt, a lively group of girls form a street theatre troupe, challenging their families and neighbours with their brilliantly devised street performances.\\r\\n\\r\\nWith nerves of steel, the troupe confront the constrictive gender roles of their society, staging their frustrations and their dreams to the children, women and men who gather as they perform.\\r\\n\\r\\nWinner of the Best Documentary prize at Cannes Film Festival, The Brink of Dreams follows these close friends and brave creative collaborators over four years, as they face their futures and each make crucial choices about the rest of their lives.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In a remote village in southern Egypt, a lively group of girls form a street theatre troupe, chall