          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 4055,
            "text": "{\"businessDate\":\"2026-02-09\",\"showtimes\":[{\"id\":\"BLO1-99949\",\"schedule\":{\"businessDate\":\"2026-02-09\",\"startsAt\":\"2026-02-09T19:15:00+00:00\",\"endsAt\":\"2026-02-09T22:45:00+00:00\",\"filmStartsAt\":\"2026-02-09T19:15:00+00:00\",\"filmEndsAt\":\"2026-02-09T22:45:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-18\",\"filmId\":\"HO00006230\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000042\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006230\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: Woolf Works\",\"translations\":[]},\"synopsis\":{\"text\":\"Virginia Woolf defied literary conventions to depict rich inner worlds – her heightened, startling and poignant reality. Resident Choreographer Wayne McGregor leads a luminous artistic team to evoke Woolf’s signature stream of consciousness writing style in this immense work that rejects traditional narrative structures. Woolf Works is a collage of themes from Mrs Dalloway, Orlando, The Waves and Woolf’s other writings. Created in 2015 for The Royal Ballet, this Olivier-award winning ballet triptych captures the heart of Woolf’s uniquely artistic spirit.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Virginia Woolf defied literary conventions to depict rich inner worlds – her heightened, startling and poignant reality. \",\"translations\":[]},\"censorRatingId\":\"VS