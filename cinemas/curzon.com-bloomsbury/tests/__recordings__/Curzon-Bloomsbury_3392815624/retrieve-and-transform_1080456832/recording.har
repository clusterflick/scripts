            "mimeType": "application/json; charset=utf-8",
            "size": 7484,
            "text": "{\"businessDate\":\"2025-07-04\",\"showtimes\":[{\"id\":\"BLO1-100467\",\"schedule\":{\"businessDate\":\"2025-07-04\",\"startsAt\":\"2025-07-04T18:20:00+01:00\",\"endsAt\":\"2025-07-04T19:47:00+01:00\",\"filmStartsAt\":\"2025-07-04T18:27:00+01:00\",\"filmEndsAt\":\"2025-07-04T19:47:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006280\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-100470\",\"schedule\":{\"businessDate\":\"2025-07-04\",\"startsAt\":\"2025-07-04T20:00:00+01:00\",\"endsAt\":\"2025-07-04T21:44:00+01:00\",\"filmStartsAt\":\"2025-07-04T20:07:00+01:00\",\"filmEndsAt\":\"2025-07-04T21:44:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006279\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006279\",\"title\":{\"text\":\"DocHouse: Hearts of Darkness\",\"translations\":[]},\"synopsis\":{\"text\":\"In the late 1970s, celebrated director Francis Ford Coppola (The Godfather, The Conversation) and his cast, crew and family ventured into the dense jungles of the Philippines to begin work on what would eventually become his masterpiece, APOCALYPSE NOW.\\r\\n\\r\\nBut the journey from page to screen soon spiralled into a hellish, life-threatening nightmare that echoed the film’s narrative. Plagued with adversity, one of the most influential films ever made had one of the most notorious shoots in cinema history that few survived unscathed.\\r\\n\\r\\nMeticulously documented at the time by Eleanor Coppola, Fax Bahr and George Hickenlooper revisited the footage in 1991 and filmed new interviews with cast and crew, resulting in HEARTS OF DARKNESS, a groundbreaking and intimate portrait of what went into making one of the best films ever made.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Documentary that chronicles how Francis Ford Coppola's Apocalypse Now (1979) was plagued by extraordinary script, shooting, budget, and casting problems. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong bloody violence, injury detail, language, drug misuse\",\"translations\":[]},\"releaseDate\":\"2025-07-05\",\"runtimeInMinutes\":97,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000146\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004581\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006335\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008012\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008551\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011664\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"0000011665\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011666\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011667\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011668\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000328\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006279\",\"hoCode\":\"A000007747\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006280\",\"title\":{\"text\":\"DocHouse: Beat the Lotto\",\"translations\":[]},\"synopsis\":{\"text\":\"A ragtag team of chancers join forces to win big in this rip-roaring tale from 1990s Ireland.\\r\\n\\r\\nSoon after the National Lottery came to Ireland, stamp-collector and mathematician Stefan Klincewicz figured out a formula and masterminded an audacious plan to change the odds and win big - if he could just enlist a syndicate to buy every single possible ticket combination. But after months of planning, the heist became public knowledge and, in a race against time, the lottery authorities did everything they could to stop the steal.\\r\\n\\r\\nDirector Ross Whitaker recounts this caper in all its gripping twists and turns, through interviews with the Stefan, the syndicate, and those who remember the furore of a nation divided: were they fat cats ruining the dreams of a downtrodden public, or true Irish underdogs risking it all to outsmart the system?\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Almost everyone has played the Lottery and everyone would like to win it. When the National Lottery was launched in Ireland in 1986, a type of mania ensued.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2025-07-04\",\"runtimeInMinutes\":80,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011669\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006280\",\"hoCode\":\"A000007748\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000000146\",\"name\":{\"givenName\":\"Martin\",\"familyName\":\"Sheen\",\"middleName\":null}},{\"id\":\"0000004581\",\"name\":{\"givenName\":\"Robert\",\"familyName\":\"DuVall\",\"middleName\":null}},{\"id\":\"0000006335\",\"name\":{\"givenName\":\"Francis\",\"familyName\":\"Ford Coppola\",\"middleName\":null}},{\"id\":\"0000008012\",\"name\":{\"givenName\":\"Fred\",\"familyName\":\"Roos\",\"middleName\":null}},{\"id\":\"0000008551\",\"name\":{\"givenName\":\"George\",\"familyName\":\"Lucas\",\"middleName\":null}},{\"id\":\"0000011664\",\"name\":{\"givenName\":\"Eleanor\",\"familyName\":\"Coppola\",\"middleName\":null}},{\"id\":\"0000011665\",\"name\":{\"givenName\":\"John\",\"familyName\":\"Milius\",\"middleName\":null}},{\"id\":\"0000011666\",\"name\":{\"givenName\":\"Fax\",\"familyName\":\"Bahr\",\"middleName\":null}},{\"id\":\"0000011667\",\"name\":{\"givenName\":\"Les\",\"familyName\":\"Mayfield\",\"middleName\":null}},{\"id\":\"0000011668\",\"name\":{\"givenName\":\"George\",\"familyName\":\"Zaloom\",\"middleName\":null}},{\"id\":\"HO00000328\",\"name\":{\"givenName\":\"Dennis\",\"familyName\":\"Hopper\",\"middleName\":null}},{\"id\":\"0000011669\",\"name\":{\"givenName\":\"Ross\",\"familyName\":\"Whitaker\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"HO00000006\",\"classification\":{\"text\":\"15\",\"translations\":[]},\"classificationDescription\":{\"text\":\"15\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}},{\"id\":\"HO00000002\",\"classification\":{\"text\":\"PG\",\"translations\":[]},\"classificationDescription\":{\"text\":\"PG\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000012\",\"name\":{\"text\":\"Programmed by Bertha Dochouse\",\"translations\":[]},\"shortName\":{\"text\":\"Dochouse\",\"translations\":[]},\"description\":{\"text\":\"Programmed by Bertha Dochouse | Preshows: 5 minutes\",\"translations\":[]},\"importantMessage\":{\"text\":\"Preshows: 5 minutes\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"BLO1-6\",\"name