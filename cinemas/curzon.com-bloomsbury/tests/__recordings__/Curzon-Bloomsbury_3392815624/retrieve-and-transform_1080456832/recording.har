            "mimeType": "application/json; charset=utf-8",
            "size": 5501,
            "text": "{\"businessDate\":\"2025-11-25\",\"showtimes\":[{\"id\":\"BLO1-99946\",\"schedule\":{\"businessDate\":\"2025-11-25\",\"startsAt\":\"2025-11-25T19:15:00+00:00\",\"endsAt\":\"2025-11-25T22:30:00+00:00\",\"filmStartsAt\":\"2025-11-25T19:15:00+00:00\",\"filmEndsAt\":\"2025-11-25T22:30:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-18\",\"filmId\":\"HO00006227\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000042\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006227\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: Cinderella\",\"translations\":[]},\"synopsis\":{\"text\":\"Stuck at home and put to work by her spoiled Step-Sisters, Cinderella’s life is dreary and dull. Everything changes when she helps a mysterious woman out...With a little bit of magic, she is transported into an ethereal new world – one where fairies bring the gifts of the seasons, where pumpkins turn into carriages, and where true love awaits. \\nThis enchanting ballet by The Royal Ballet’s Founding Choreographer Frederick Ashton is a theatrical experience for all the family and will transport you into an ethereal world where a sprinkling of fairy dust makes dreams come true.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Stuck at home and put to work by her spoiled Step-Sisters, Cinderella’s life is dreary and dull. Everything changes when she helps a mysterious woman out...\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-25\",\"runtimeInMinutes\":195,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001474\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011529\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011530\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011532\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011533\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011534\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3646\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"9291\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000290\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000291\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"88d0e3c2-d7a3-443d-821c-0953c1b7157f\",\"corporateId\":null},\"hopk\":\"HO00006227\",\"hoCode\":\"A000007684\",\"eventId\":\"0000000042\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000001474\",\"name\":{\"givenName\":\"Isabella\",\"familyName\":\"Gasparini\",\"middleName\":null}},{\"id\":\"0000011529\",\"name\":{\"givenName\":\"Bennet\",\"familyName\":\"Gartside\",\"middleName\":null}},{\"id\":\"0000011530\",\"name\":{\"givenName\":\"James\",\"familyName\":\"Hay\",\"middleName\":null}},{\"id\":\"0000011531\",\"name\":{\"givenName\":\"Mariko\",\"familyName\":\"Sasaki\",\"middleName\":null}},{\"id\":\"0000011532\",\"name\":{\"givenName\":\"Meaghan Grace\",\"familyName\":\"Hinkis\",\"middleName\":null}},{\"id\":\"0000011533\",\"name\":{\"givenName\":\"Claire\",\"familyName\":\"Calvert\",\"middleName\":null}},{\"id\":\"0000011534\",\"name\":{\"givenName\":\"Daichi\",\"familyName\":\"Ikarashi\",\"middleName\":null}},{\"id\":\"3646\",\"name\":{\"givenName\":\"Mayara\",\"familyName\":\"Magri\",\"middleName\":null}},{\"id\":\"9291\",\"name\":{\"givenName\":\"Thomas\",\"familyName\":\"Whitehead\",\"middleName\":null}},{\"id\":\"HO00000290\",\"name\":{\"givenName\":\"William\",\"familyName\":\"Bracewell\",\"middleName\":null}},{\"id\":\"HO00000291\",\"name\":{\"givenName\":\"Fumi\",\"familyName\":\"Kaneko\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000003\",\"name\":{\"text\":\"Live event\",\"translations\":[]},\"shortName\":{\"text\":\"Live\",\"translations\":[]},\"description\":{\"text\":\"Live Via Satellite\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"BLO1-5\",\"name\":{\"text\":\"Renoir Screen\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000042\",\"name\":{\"text\":\"Royal Ballet and Opera\",\"translations\":[]},\"shortName\":{\"text\":\"RB&O\",\"translations\":[]},\"description\":{\"text\":\"The Royal Ballet and Opera brings the thrill of world-class theatre to cinema screens right around the globe. \\n\\nWith productions across both Companies, the programme includes beloved classics as well as new productions.\\n\\nOffering audiences a view from the best seat in the house, the programme shares the joy of live performance, and the beauty of world-class art with cinemagoers in more than 1,500 cinemas and 50 countries around the world.\\n\",\"translations\":[]},\"schedule\":{\"startDate\":\"2024-09-01\",\"endDate\":\"2026-06-30\"},\"siteIds\":[\"ALD1\",\"BLO1\",\"CAM1\",\"CAN01\",\"CAN2\",\"COL1\",\"HOX1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SHE1\",\"SOH1\",\"VIC1\",\"WIM01\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[