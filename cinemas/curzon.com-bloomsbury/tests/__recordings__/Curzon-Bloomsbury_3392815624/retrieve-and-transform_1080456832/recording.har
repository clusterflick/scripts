          "bodySize": 3542,
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 3542,
            "text": "{\"businessDate\":\"2025-07-09\",\"showtimes\":[{\"id\":\"BLO1-100469\",\"schedule\":{\"businessDate\":\"2025-07-09\",\"startsAt\":\"2025-07-09T18:20:00+01:00\",\"endsAt\":\"2025-07-09T19:47:00+01:00\",\"filmStartsAt\":\"2025-07-09T18:27:00+01:00\",\"filmEndsAt\":\"2025-07-09T19:47:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006280\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006280\",\"title\":{\"text\":\"DocHouse: Beat the Lotto\",\"translations\":[]},\"synopsis\":{\"text\":\"A ragtag team of chancers join forces to win big in this rip-roaring tale from 1990s Ireland.\\r\\n\\r\\nSoon after the National Lottery came to Ireland, stamp-collector and mathematician Stefan Klincewicz figured out a formula and masterminded an audacious plan to change the odds and win big - if he could just enlist a syndicate to buy every single possible ticket combination. But after months of planning, the heist became public knowledge and, in a race against time, the lottery authorities did everything they could to stop the steal.\\r\\n\\r\\nDirector Ross Whitaker recounts this caper in all its gripping twists and turns, through interviews with the Stefan, the syndicate, and those who remember the furore of a nation divided: were they fat cats ruining the dreams of a downtrodden public, or true Irish underdogs risking it all to outsmart the system?\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Almost everyone has played the Lottery and everyone would like to win it. When the National Lottery was launched in Ireland in 1986, a type of mania ensued.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2025-07-04\",\"runtimeInMinutes\":80,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011669\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006280\",\"hoCode\":\"A000007748\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000011669\",\"name\":{\"givenName\":\"Ross\",\"familyName\":\"Whitaker\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"HO00000002\",\"classification\":{\"text\":\"PG\",\"translations\":[]},\"classificationDescription\":{\"text\":\"PG\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000012\",\"name\":{\"text\":\"Programmed by Bertha Dochouse\",\"translations\":[]},\"shortName\":{\"text\":\"Dochouse\",\"translations\":[]},\"description\":{\"text\":\"Programmed by Bertha Dochouse | Preshows: 5 minutes\",\"translations\":[]},\"importantMessage\":{\"text\":\"Preshows: 5 minutes\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"BLO1-6\",\"name\":{\"text\":\"Bertha Dochouse\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"BLO1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}"
