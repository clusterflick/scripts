            "text": "{\"businessDate\":\"2025-07-12\",\"showtimes\":[{\"id\":\"BLO1-100473\",\"schedule\":{\"businessDate\":\"2025-07-12\",\"startsAt\":\"2025-07-12T16:00:00+01:00\",\"endsAt\":\"2025-07-12T17:43:00+01:00\",\"filmStartsAt\":\"2025-07-12T16:07:00+01:00\",\"filmEndsAt\":\"2025-07-12T17:43:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006281\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-100618\",\"schedule\":{\"businessDate\":\"2025-07-12\",\"startsAt\":\"2025-07-12T18:00:00+01:00\",\"endsAt\":\"2025-07-12T19:57:00+01:00\",\"filmStartsAt\":\"2025-07-12T18:07:00+01:00\",\"filmEndsAt\":\"2025-07-12T19:57:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006245\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006281\",\"title\":{\"text\":\"DocHouse: Hidden Master\",\"translations\":[]},\"synopsis\":{\"text\":\"George Platt Lynes began his career photographing celebrities, and it’s those portraits along with his extravagant fashion work that he’s best remembered for today. However, George’s heart, his passion, and his greatest talent lay elsewhere, in his work with the male nude. This work, sensuous and radically explicit for its time, has only recently begun being fully discovered and appreciated for the revolution that it represents — a man capturing his fantasies as a gift, a window to a future his camera saw coming before anyone else.\\r\\n\\r\\nFrom visionary art director Sam Shahid, HIDDEN MASTER features a stunning collection of photography from the 1930s-50s, uncovering the life of Lynes less known: his gifted eye for the male form, his longterm friendships with Gertrude Stein and Alfred Kinsey, and his lasting influence as one of the first openly gay American artists.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The life and legacy of a pioneering, openly gay artist, who took radically explicit photographs of the male nude.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-07-12\",\"runtimeInMinutes\":96,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011632\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011633\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000011634\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011635\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006281\",\"hoCode\":\"A000007749\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006245\",\"title\":{\"text\":\"DocHouse: Apocalypse in the Tropics\",\"translations\":[]},\"synopsis\":{\"text\":\"Acclaimed filmmaker Petra Costa exposes the volatile clash between religion and freedom in Brazil, revealing how apocalyptic theology fuels the far right and threatens the nation's fragile democracy.\\r\\n\\r\\nFive years after Oscar-nominated THE EDGE OF DEMOCRACY, Costa returns to Brazil’s political battlefield to examine the dangerous rise of religious extremism. Gaining rare access to key players – including President Lula, former President Bolsonaro and firebrand televangelist Silas Malafaia – she reveals how evangelical leaders have steered the country toward the brink of theocracy. As Malafaia preaches that worsening global chaos will hasten Christ’s return, Costa weaves past and present, juxtaposing Renaissance depictions of the Apocalypse with Brazil’s modern-day democratic crisis. Through gripping investigative storytelling, she delivers a chilling warning: when faith and politics collide, democracy’s survival hangs by a thread.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-23\",\"runtimeInMinutes\":110,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006245\",\"hoCode\":\"A000007707\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000011632\",\"name\":{\"givenName\":\"George\",\"familyName\":\"Platt Lynes II\",\"middleName\":null}},{\"id\":\"0000011633\",\"name\":{\"givenName\":\"Sam\",\"familyName\":\"Shahid\",\"middleName\":null}},{\"id\":\"0000011634\",\"name\":{\"givenName\":\"Matthew\",\"familyName\":\"Kraus\",\"middleName\":null}},{\"id\":\"0000011635\",\"name\":{\"givenName\":\"John\",\"familyName\":\"MacConnell\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}},{\"id\":\"HO00000004\",\"classification\":{\"text\":\"12A\",\"translations\":[]},\"classificationDescription\":{\"text\":\"12A\",\"translations\":[