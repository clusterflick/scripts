          "bodySize": 5882,
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 5882,
            "text": "{\"businessDate\":\"2025-07-11\",\"showtimes\":[{\"id\":\"BLO1-100284\",\"schedule\":{\"businessDate\":\"2025-07-11\",\"startsAt\":\"2025-07-11T18:20:00+01:00\",\"endsAt\":\"2025-07-11T20:22:00+01:00\",\"filmStartsAt\":\"2025-07-11T18:57:00+01:00\",\"filmEndsAt\":\"2025-07-11T20:22:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006260\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\",\"0000000009\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-100617\",\"schedule\":{\"businessDate\":\"2025-07-11\",\"startsAt\":\"2025-07-11T20:40:00+01:00\",\"endsAt\":\"2025-07-11T22:37:00+01:00\",\"filmStartsAt\":\"2025-07-11T20:47:00+01:00\",\"filmEndsAt\":\"2025-07-11T22:37:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006245\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006260\",\"title\":{\"text\":\"DocHouse: Holloway\",\"translations\":[]},\"synopsis\":{\"text\":\"Six women return to the now abandoned Holloway Prison to take part in a women’s circle. Sharing some of the most intimate experiences of their lives, they each unravel what led them to prison, building an eye-opening portrait of failing systems and trauma, while discovering their extraordinary capacity to heal through sisterhood.\\r\\n\\r\\nDirected by BAFTA Breakthrough Brit Daisy-May Hudson and EMMY nominated Sophie Compton, this deeply moving and transformational documentary feature was made via a unique process of a trauma-informed co-creation with six contributors, a group of incredibly talented, high profile women who are running charities and using their lived-experience to call for change. They are Aliyah Ali, Mandy Ogunmokun, Sarah Cassidy, Lady Unchained, Gerrah, and Tamar Mujanay.\\r\\n\\r\\nHOLLOWAY is a profound, meditative, eye-opening and ultimately inspiring exploration of trauma and the immense human capacity for recovery.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2025-07-11\",\"runtimeInMinutes\":85,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007452\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011454\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006260\",\"hoCode\":\"A000007724\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006245\",\"title\":{\"text\":\"DocHouse: Apocalypse in the Tropics\",\"translations\":[]},\"synopsis\":{\"text\":\"Acclaimed filmmaker Petra Costa exposes the volatile clash between religion and freedom in Brazil, revealing how apocalyptic theology fuels the far right and threatens the nation's fragile democracy.\\r\\n\\r\\nFive years after Oscar-nominated THE EDGE OF DEMOCRACY, Costa returns to Brazil’s political battlefield to examine the dangerous rise of religious extremism. Gaining rare access to key players – including President Lula, former President Bolsonaro and firebrand televangelist Silas Malafaia – she reveals how evangelical leaders have steered the country toward the brink of theocracy. As Malafaia preaches that worsening global chaos will hasten Christ’s return, Costa weaves past and present, juxtaposing Renaissance depictions of the Apocalypse with Brazil’s modern-day democratic crisis. Through gripping investigative storytelling, she delivers a chilling warning: when faith and politics collide, democracy’s survival hangs by a thread.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-23\",\"runtimeInMinutes\":110,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006245\",\"hoCode\":\"A000007707\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000007452\",\"name\":{\"givenName\":\"Sophie\",\"familyName\":\"Compton\",\"middleName\":null}},{\"id\":\"0000011454\",\"name\":{\"givenName\":\"Daisy-May\",\"familyName\":\"Hudson\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"HO00000004\",\"classification\":{\"text\":\"12A\",\"translations\":[]},\"classificationDescription\":{\"text\":\"12A\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000012\",\"name\":{\"text\":\"Programmed by Bertha Dochouse\",\"translations\":[]},\"shortName\":{\"text\":\"Dochouse\",\"translations\":[]},\"description\":{\"text\":\"Programmed by Bertha Dochouse | Preshows: 5 minutes\",\"translations\":[]},\"importantMessage\":{\"text\":\"Preshows: 5 minutes\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false},{\"id\":\"0000000009\",\"name\":{\"text\":\"Screening followed by a Q&A\",\"translations\":[]},\"shortName\":{\"text\":\"Q&A\",\"translations\":[]},\"description\":{\"text\":\"Q&A\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"BLO1-6\",\"name\":{\"text\":\"Bertha Dochouse\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"BLO1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}"
