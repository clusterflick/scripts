\"endsAt\":\"2025-06-26T23:10:00+01:00\",\"filmStartsAt\":\"2025-06-26T21:15:00+01:00\",\"filmEndsAt\":\"2025-06-26T23:10:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-1-2\",\"filmId\":\"HO00006204\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-1\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000055\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"BLO1-85-HO00006204\"},{\"id\":\"BLO1-100583\",\"schedule\":{\"businessDate\":\"2025-06-26\",\"startsAt\":\"2025-06-26T21:00:00+01:00\",\"endsAt\":\"2025-06-26T23:06:00+01:00\",\"filmStartsAt\":\"2025-06-26T21:25:00+01:00\",\"filmEndsAt\":\"2025-06-26T23:06:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-4-5\",\"filmId\":\"HO00006097\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-4\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"BLO1-83-HO00006097\"}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006086\",\"title\":{\"text\":\"Parthenope\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award-winning fi lmmaker Paolo Sorrentino comes a monumental and deeply romantic story of a lifetime. Born in the Bay of Naples in 1950, Parthenope (Celeste Dalla Porta) searches for happiness over the long summers of her youth, falling in love with her home city and its many memorable characters. But when tragedy strikes, and carefree romances lose their thrill, she decides to seek a deeper sense of purpose. Featuring a captivating performance from Dalla Porta and an outstanding cast that includes Gary Oldman, PARTHENOPE is another tale of great beauty from a master of modern cinema.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award-winning fi lmmaker Paolo Sorrentino comes a monumental and deeply romantic story of a lifetime. Born in the Bay of Naples in 1950, Parthenope (Celeste \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong sex, language\",\"translations\":[]},\"releaseDate\":\"2025-05-02\",\"runtimeInMinutes\":137,\"trailerUrl\":null,\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001876\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001877\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003564\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011053\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011054\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011055\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011056\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011057\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011058\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000156\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000161\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":\"821ae2af-6add-4e42-a9c1-26154a473921\",\"corporateId\":null},\"hopk\":\"HO00006086\",\"hoCode\":\"A000007505\",\"eventId\":null,\"distributorName\":\"Picturehouse Entertainment\"},{\"id\":\"HO00006097\",\"title\":{\"text\":\"The Phoenician Scheme\",\"translations\":[]},\"synopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe; Mia Threapleton as Liesl, his daughter/a nun; Michael Cera as Bjorn, their tutor. With: Riz Ahmed, Tom Hanks, Bryan Cranston, Mathieu Amalric, Richard Ayoade, Jeffrey Wright, Scarlett Johansson, Benedict Cumberbatch, Rupert Friend, Hope Davis.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong injury detail\",\"translations\":[]},\"releaseDate\":\"2025-05-23\",\"runtimeInMinutes\":101,\"trailerUrl\":\"https://www.youtube.com/watch?v=qRAnphZLAIg\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001084\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001275\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001395\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001400\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001409\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001410\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001411\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002527\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003325\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005645\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005699\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011116\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011117\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"eff6ffca-db00-4c6f-9e5e-1783c6ace2d7\",\"corporateId\":null},\"hopk\":\"HO00006097\",\"hoCode\":\"A000007517\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006199\",\"title\":{\"text\":\"Hidden (Caché)\",\"translations\":[]},\"synopsis\":{\"text\":\"A married couple is terrorized by a series of surveillance videotapes left on their front porch.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A married couple is terrorized by a series of surveillance videotapes left on their front porch.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-20\",\"runtimeInMinutes\":118,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004195\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011332\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011334\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011380\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011394\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011412\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"8d52e414-ea56-449f-949a-6cbcfa55a8b7\",\"corporateId\":null},\"hopk\":\"HO00006199\",\"hoCode\":\"A000007654\",\"eventId\":null,\"distributorName\":\"Curzon\"},{\"id\":\"HO00006203\",\"title\":{\"text\":\"Tornado\",\"translations\":[]},\"synopsis\":{\"text\":\"Set in the rugged landscape of 1790’s Britain, Tornado (played by model-songwriter Koki,) finds herself caught in a perilous situation when she and her father’s travelling puppet show crosses paths with a ruthless criminal gang led by Sugarman (PULP FICTION star Tim Roth) and his ambitious son Little Sugar (SLOW HORSES’ Jack Lowden). In an attempt to create a new life, Tornado seizes the opportunity to steal the gold from the gang’s most recent heist; what follows is a thrilling tale of adrenaline-fueled action as Tornado fights to escape a violent demise.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Set in the rugged landscape of 1790’s Britain, Tornado (played by model-songwriter Koki,) finds herself caught in a perilous situation.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong bloody violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-06-13\",\"runtimeInMinutes\":91,\"trailerUrl\":null,\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003251\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003321\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011415\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011416\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011417\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000252\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000254\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000256\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b32a6015-ac13-48b6-9e04-b64a47c5df98\",\"corporateId\":null},\"hopk\":\"HO00006203\",\"hoCode\":\"A000007659\",\"eventId\":null,\"distributorName\":\"Lionsgate\"},{\"id\":\"HO00006204\",\"title\":{\"text\":\"28 Years Later\",\"translations\":[]},\"synopsis\":{\"text\":\"Academy Award®-winning director Danny Boyle and Academy Award®-nominated writer Alex Garland reunite for 28 Years Later, a terrifying new story set in the world created by 28 Days Later. It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine, some have found ways to exist amidst the infected. One such group of survivors lives on a small island connected to the mainland by a single, heavily-defended causeway. When one of the group leaves the island on a mission into the dark heart of the mainland, he discovers secrets, wonders, and horrors that have mutated not only the infected but other survivors as well.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine...\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-19\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=poEFz8Ivzug\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000313\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001100\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001270\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003206\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003678\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010558\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011257\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000011418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011419\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a7823fd3-66f7-47af-87ba-d36ef45b168c\",\"corporateId\":null},\"hopk\":\"HO00006204\",\"hoCode\":\"A000007660\",\"eventId\":null,\"distributorName\":\"Sony Pictures\"},{\"id\":\"HO00006247\",\"title\":{\"text\":\"DocHouse: Porcelain War\",\"translations\":[]},\"synopsis\":{\"text\":\"Amidst the chaos and destruction of the brutal Russian invasion of Ukraine, three artists defiantly find inspiration and beauty as they defend their culture and their country. In a war waged by professional soldiers against ordinary civilians, Slava Leontyev, Anya Stasenko, and Andrey Stefanov choose to stay behind, armed with their art, their cameras, and, for the first time in their lives, their guns. Despite daily shelling, Anya finds resistance and purpose in her art, Andrey takes the dangerous journey to get his young family to safety abroad, and Slava becomes a weapons instructor for ordinary people who have become unlikely soldiers. As the war intensifies, Andrey picks up his camera to film their story, and on tiny porcelain figurines, Anya and Slava capture their idyllic past, uncertain present, and hope for the future.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Under roaring fighter jets, Ukrainian artists Slava, Anya, and Andrey choose to stay behind. Defiantly finding beauty amid destruction, they show that although it's easy \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":{\"text\":\"strong language\",\"translations\":[]},\"releaseDate\":\"2025-06-20\",\"runtimeInMinutes\":87,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011554\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"0000011555\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011556\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011557\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011558\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011559\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011560\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011561\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006247\",\"hoCode\":\"A000007709\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006253\",\"title\":{\"text\":\"DocHouse: Uncropped\",\"translations\":[]},\"synopsis\":{\"text\":\"Rediscover the work of James Hamilton, one of the great chroniclers of the cultural history of America. A New York legend himself, Hamilton created iconic images during the heyday of alternative print - from Patti Smith, Liza Minnelli, Lou Reed, Hitchcock, George Romero, to Noah Baumbach and Wes Anderson.\\r\\n\\r\\nA visual chronicle of New York’s zeitgeist over the last 50 years, UNCROPPED subtly traces the rise and fall of photojournalism itself, making it a compelling and visually rich narrative for audiences seeking a deep dive into cultural and photographic history.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-20\",\"runtimeInMinutes\":111,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011583\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006253\",\"hoCode\":\"A000007715\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006105\",\"title\":{\"text\":\"DocHouse: E.1027 - Eileen Gray\",\"translations\":[]},\"synopsis\":{\"text\":\"A love triangle of jealousy in the Parisian art scene of the 1930s is brought to life in a stylish docufiction about iconic artist and architect Eileen Gray, who built her modernist dream house on the Riviera, only to be upstaged by Le Corbusier.\\r\\n\\r\\nEileen Gray had a truly eminent sense of design. The Irish artist and architect created some of the most iconic furniture of the 20th century, so when she focussed her unique artistic vision on developing a house for herself on the Riviera in 1929, the result was a modernist triumph. A house and a work of art in one, overlooking the sun-sparkled infinity of the Mediterranean. The house is named E.1027, a cryptic contraction of the names of Gray and her lover, Romanian architect Jean Badovici. But when the Swiss-French star architect Le Corbusier learns of the house, he becomes obsessed – perhaps because Gray breathes light, air and soul into her building, which is not just a machine to live in.\\r\\n\\r\\nE.1027 – EILEEN GRAY AND THE HOUSE BY THE SEA reconstructs the dramatic story of Gray and the house that Le Corbusier amazingly managed to convince the world he had built himself. A stunningly beautiful and cinematic docufiction where the inspiration from Gray is present in lines, colours and shapes – but where they serve the narrative of a brilliant female artist who spent a long life in the shadow of her male colleagues.\\r\\n\\r\\nThe screening on Wed 4 Jun will be followed by a Q&A with director Beatrice Minger and actor Natalie Radmall-Quirke. Screening in partnership with The Architecture Club.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-05-16\",\"runtimeInMinutes\":89,\"trailerUrl\":\"https://www.youtube.com/watch?v=ZRrM_befeLI\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011157\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011158\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006105\",\"hoCode\":\"A000007528\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006110\",\"title\":{\"text\":\"F1® The Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career. Thirty years later, he’s a nomadic racer-for-hire when he’s approached by his former teammate Ruben Cervantes (Javier Bardem), owner of a struggling FORMULA 1 team that is on the verge of collapse. Ruben convinces Sonny to come back to FORMULA 1 for one last shot at saving the team and being the best in the world. He’ll drive alongside Joshua Pearce (Damson Idris), the team's hotshot rookie intent on setting his own pace. But as the engines roar, Sonny’s past catches up with him and he finds that in FORMULA 1, your teammate is your fiercest competition—and the road to redemption is not something you can travel alone.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate threat\",\"translations\":[]},\"releaseDate\":\"2025-06-25\",\"runtimeInMinutes\":156,\"trailerUrl\":\"https://www.youtube.com/watch?v=TZGY2CWPXeU\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000166\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000167\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001693\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002986\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003190\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003191\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008544\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008790\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011188\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"90334335-0de9-4985-8924-9942f4379b60\",\"corporateId\":null},\"hopk\":\"HO00006110\",\"hoCode\":\"A000007538\",\"eventId\":null,\"distributorName\":\"Warners\"}],\"castAndCrew\":[{\"id\":\"0000001876\",\"name\":{\"givenName\":\"Silvio\",\"familyName\":\"Orlando\",\"middleName\":null}},{\"id\":\"0000001877\",\"name\":{\"givenName\":\"Paolo\",\"familyName\":\"Sorrentino\",\"middleName\":null}},{\"id\":\"0000003564\",\"name\":{\"givenName\":\"Ardavan\",\"familyName\":\"Safaee\",\"middleName\":null}},{\"id\":\"0000011053\",\"name\":{\"givenName\":\"Gary\",\"familyName\":\"Oldman\