            "text": "{\"businessDate\":\"2025-07-05\",\"showtimes\":[{\"id\":\"BLO1-100124\",\"schedule\":{\"businessDate\":\"2025-07-05\",\"startsAt\":\"2025-07-05T15:30:00+01:00\",\"endsAt\":\"2025-07-05T16:48:00+01:00\",\"filmStartsAt\":\"2025-07-05T15:37:00+01:00\",\"filmEndsAt\":\"2025-07-05T16:48:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006256\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\",\"0000000009\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"BLO1-100125\",\"schedule\":{\"businessDate\":\"2025-07-05\",\"startsAt\":\"2025-07-05T18:00:00+01:00\",\"endsAt\":\"2025-07-05T19:50:00+01:00\",\"filmStartsAt\":\"2025-07-05T18:07:00+01:00\",\"filmEndsAt\":\"2025-07-05T19:50:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006255\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006255\",\"title\":{\"text\":\"DocHouse: Gen_\",\"translations\":[]},\"synopsis\":{\"text\":\"At Milan's Niguarda public hospital, Dr. Maurizio Bini leads a courageous mission heading two highly sensitive departments: he oversees the dreams and struggles of aspiring parents undergoing IVF alongside the deeply personal journeys of individuals reconciling their bodies with their gender identities. In a politically charged environment that tests medical ethics, Dr. Bini defies societal constraints to offer hope, humanity, and healing, making a profound difference with both expertise and heart.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-07-05\",\"runtimeInMinutes\":103,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011586\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006255\",\"hoCode\":\"A000007717\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006256\",\"title\":{\"text\":\"DocHouse: The Castle\",\"translations\":[]},\"synopsis\":{\"text\":\"Angelo, Mery and Rosy are three 11-year-olds living in Danisinni, an isolated, poor and densely populated neighbourhood in Palermo. Driven by a desire for adventure, the group decides to explore an abandoned kindergarten in the middle of the district. Amidst the rubble, they discover a safe space where they can escape external insecurity and let their imaginations run wild without feeling judged. However, the pressures from the outside world threaten to endanger this island of freedom.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-07-05\",\"runtimeInMinutes\":71,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011587\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011588\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011589\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006256\",\"hoCode\":