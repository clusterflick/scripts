filmStartsAt\":\"2025-06-27T21:35:00+01:00\",\"filmEndsAt\":\"2025-06-27T23:16:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-1-2\",\"filmId\":\"HO00006097\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-1\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"BLO1-83-HO00006097\"}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00004048\",\"title\":{\"text\":\"DocHouse: The Salt Of The Earth\",\"translations\":[]},\"synopsis\":{\"text\":\"For the last 40 years acclaimed photographer Sebastião Salgado has travelled the world, tracing the footsteps of an ever-changing humanity. He has witnessed and documented many of the major events of our times, taking in wars, famine, genocide and exodus. But now he is embarking on a new journey; to discover pristine territories, grandiose landscapes and wild nature as part of a huge photographic tribute to the planet’s beauty. \\r\\n \\r\\nSalgado’s accomplished, moving work and his inspirational life are revealed to us in this Oscar-nominated documentary by his son, Juliano, and world-renowned filmmaker Wim Wenders, himself an avid photographer. Powerful, affecting and truly profound, it is not just a portrait of a great artist but one of life itself. Screening as part of Kino Dreams - the Wim Wenders retrospective.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2025-07-05\",\"runtimeInMinutes\":110,\"trailerUrl\":null,\"displayPriority\":30,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000467\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000003625\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00004048\",\"hoCode\":\"A000005021\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006086\",\"title\":{\"text\":\"Parthenope\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award-winning fi lmmaker Paolo Sorrentino comes a monumental and deeply romantic story of a lifetime. Born in the Bay of Naples in 1950, Parthenope (Celeste Dalla Porta) searches for happiness over the long summers of her youth, falling in love with her home city and its many memorable characters. But when tragedy strikes, and carefree romances lose their thrill, she decides to seek a deeper sense of purpose. Featuring a captivating performance from Dalla Porta and an outstanding cast that includes Gary Oldman, PARTHENOPE is another tale of great beauty from a master of modern cinema.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award-winning fi lmmaker Paolo Sorrentino comes a monumental and deeply romantic story of a lifetime. Born in the Bay of Naples in 1950, Parthenope (Celeste \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong sex, language\",\"translations\":[]},\"releaseDate\":\"2025-05-02\",\"runtimeInMinutes\":137,\"trailerUrl\":null,\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001876\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001877\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003564\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011053\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011054\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011055\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"00