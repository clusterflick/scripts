025-07-02T23:21:00+01:00\",\"filmStartsAt\":\"2025-07-02T21:40:00+01:00\",\"filmEndsAt\":\"2025-07-02T23:21:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-1-2\",\"filmId\":\"HO00006097\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-1\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"BLO1-83-HO00006097\"}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006086\",\"title\":{\"text\":\"Parthenope\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award-winning fi lmmaker Paolo Sorrentino comes a monumental and deeply romantic story of a lifetime. Born in the Bay of Naples in 1950, Parthenope (Celeste Dalla Porta) searches for happiness over the long summers of her youth, falling in love with her home city and its many memorable characters. But when tragedy strikes, and carefree romances lose their thrill, she decides to seek a deeper sense of purpose. Featuring a captivating performance from Dalla Porta and an outstanding cast that includes Gary Oldman, PARTHENOPE is another tale of great beauty from a master of modern cinema.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award-winning fi lmmaker Paolo Sorrentino comes a monumental and deeply romantic story of a lifetime. Born in the Bay of Naples in 1950, Parthenope (Celeste \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong sex, language\",\"translations\":[]},\"releaseDate\":\"2025-05-02\",\"runtimeInMinutes\":137,\"trailerUrl\":null,\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001876\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001877\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003564\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011053\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011054\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011055\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011056\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011057\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011058\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000156\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000161\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":\"821ae2af-6add-4e42-a9c1-26154a473921\",\"corporateId\":null},\"hopk\":\"HO00006086\",\"hoCode\":\"A000007505\",\"eventId\":null,\"distributorName\":\"Picturehouse Entertainment\"},{\"id\":\"HO00006097\",\"title\":{\"text\":\"The Phoenician Scheme\",\"translations\":[]},\"synopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe; Mia Threapleton as Liesl, his daughter/a nun; Michael Cera as Bjorn, their tutor. With: Riz Ahmed, Tom Hanks, Bryan Cranston, Mathieu Amalric, Richard Ayoade, Jeffrey Wright, Scarlett Johansson, Benedict Cumberbatch, Rupert Friend, Hope Davis.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong injury detail\",\"translations\":[]},\"releaseDate\":\"2025-05-23\",\"runtimeInMinutes\":101,\"trailerUrl\":\"https://www.youtube.com/watch?v=qRAnphZLAIg\",\"disp