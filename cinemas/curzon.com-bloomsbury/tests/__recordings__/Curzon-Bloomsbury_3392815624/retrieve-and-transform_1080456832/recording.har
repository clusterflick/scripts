            "text": "{\"businessDate\":\"2025-07-22\",\"showtimes\":[{\"id\":\"BLO1-100637\",\"schedule\":{\"businessDate\":\"2025-07-22\",\"startsAt\":\"2025-07-22T18:20:00+01:00\",\"endsAt\":\"2025-07-22T20:09:00+01:00\",\"filmStartsAt\":\"2025-07-22T18:27:00+01:00\",\"filmEndsAt\":\"2025-07-22T20:09:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006283\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006283\",\"title\":{\"text\":\"DocHouse: The Brink of Dreams\",\"translations\":[]},\"synopsis\":{\"text\":\"In a remote village in southern Egypt, a lively group of girls form a street theatre troupe, challenging their families and neighbours with their brilliantly devised street performances.\\r\\n\\r\\nWith nerves of steel, the troupe confront the constrictive gender roles of their society, staging their frustrations and their dreams to the children, women and men who gather as they perform.\\r\\n\\r\\nWinner of the Best Documentary prize at Cannes Film Festival, The Brink of Dreams follows these close friends and brave creative collaborators over four years, as they face their futures and each make crucial choices about the rest of their lives.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In a remote village in southern Egypt, a lively group of girls form a street theatre troupe, challenging their families and neighbours\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-07-18\",\"runtimeInMinutes\":102,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011679\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011680\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006283\",\"hoCode\":\"A000007751\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000011679\",\"name\":{\"givenName\":\"Ayman\",\"familyName\":\" El Amir\",\"middleName\":null}},{\"id\":\"0000011680\",\"name\":{\"givenName\":\"Nada\",\"familyName\":\"Riyadh\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000012\",\"name\":{\"text\":\"Programmed by Bertha Dochouse\",\"translations\":[]},\"shortName\":{\"text\":\"Dochouse\",\"translations\":[]},\"description\":{\"text\":\"Programmed by Bertha Dochouse | Preshows: 5 minutes\",\"translations\":[]},\"importantMessage\":{\"text\":\"Preshows: 5 minutes\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"BLO1-6\",\"name\":{\"text\":\"Bertha Dochouse\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"BLO1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}"
