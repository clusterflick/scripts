nslations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-14\",\"runtimeInMinutes\":240,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011526\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000480\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000598\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000599\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000600\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000601\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000602\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000603\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000604\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"bc0c66c8-a0aa-4fcb-a5d5-1c94495a8815\",\"corporateId\":null},\"hopk\":\"HO00006229\",\"hoCode\":\"A000007686\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000011526\",\"name\":{\"givenName\":\"Ossian\",\"familyName\":\"Huskinson\",\"middleName\":null}},{\"id\":\"HO00000480\",\"name\":{\"givenName\":\"Ermonela \",\"familyName\":\"Jaho\",\"middleName\":null}},{\"id\":\"HO00000598\",\"name\":{\"givenName\":\"Giovanni\",\"familyName\":\"Sala\",\"middleName\":null}},{\"id\":\"HO00000599\",\"name\":{\"givenName\":\"Aleksei\",\"familyName\":\"Isaev\",\"middleName\":null}},{\"id\":\"HO00000600\",\"name\":{\"givenName\":\"Veena\",\"familyName\":\"Akama-Makia\",\"middleName\":null}},{\"id\":\"HO00000601\",\"name\":{\"givenName\":\"Barnaby\",\"familyName\":\"Rea\",\"middleName\":null}},{\"id\":\"HO00000602\",\"name\":{\"givenName\":\"Ellen\",\"familyName\":\"Pearson\",\"middleName\":null}},{\"id\":\"HO00000603\",\"name\":{\"givenName\":\"Sam\",\"familyName\":\"Hird\",\"middleName\":null}},{\"id\":\"HO00000604\",\"name\":{\"givenName\":\"Giorgi\",\"familyName\":\"Guliashvili\",\"middleName\":null}}],\"genres\":[{