ctor\"]},{\"castAndCrewMemberId\":\"0000004195\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011332\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011334\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011380\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011394\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011412\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"8d52e414-ea56-449f-949a-6cbcfa55a8b7\",\"corporateId\":null},\"hopk\":\"HO00006199\",\"hoCode\":\"A000007654\",\"eventId\":null,\"distributorName\":\"Curzon\"},{\"id\":\"HO00006259\",\"title\":{\"text\":\"DocHouse: The Last Musician of Auschwitz\",\"translations\":[]},\"synopsis\":{\"text\":\"THE LAST MUSICIAN OF AUSCHWITZ tells the extraordinary story of cellist Anita Lasker-Wallfisch, along with other victims of the camp - Jews, Poles and Roma - who played and created music amidst the terrors of the Holocaust. Together they show how, amid the most brutal and dehumanising situations, music could be a lifeline, a way to give testimony and even a means of resistance.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Tells the extraordinary story of Anita Lasker-Wallfisch who, along with other victims of Auschwitz, played and created music amidst the terrors of the Holocaust.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":{\"text\":\"Holocaust theme, images of real dead bodies\",\"translations\":[]},\"releaseDate\":\"2025-06-29\",\"runtimeInMinutes\":89,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000010965\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000010966\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006259\",\"hoCode\":\"A000007723\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006204\",\"title\":{\"text\":\"28 Years Later\",\"translations\":[]},\"synopsis\":{\"text\":\"Academy Award®-winning director Danny Boyle and Academy Award®-nominated writer Alex Garland reunite for 28 Years Later, a terrifying new story set in the world created by 28 Days Later. It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine, some have found ways to exist amidst the infected. One such group of survivors lives on a small island connected to the mainland by a single, heavily-defended causeway. When one of the group leaves the island on a mission into the dark heart of the mainland, he discovers secrets, wonders, and horrors that have mutated not only the infected but other survivors as well.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine...\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-19\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=poEFz8Ivzug\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000313\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001100\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001270\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003206\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003678\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010558\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011257\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000011418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011419\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a7823fd3-66f7-47af-87ba-d36ef45b168c\",\"corporateId\":null},\"hopk\":\"HO00006204\",\"hoCode\":\"A000007660\",\"eventId\":null,\"distributorName\":\"Sony Pictures\"},{\"id\":\"HO00006215\",\"title\":{\"text\":\"Ran (40th Anniversary)\",\"translations\":[]},\"synopsis\":{\"text\":\"In Medieval Japan, an elderly warlord retires, handing over his empire to his three sons. However, he vastly underestimates how the new-found power will corrupt them and cause them to turn on each other...and him.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In Medieval Japan, an elderly warlord retires, handing over his empire to his three sons. However, he vastly underestimates how the new-found power will corrupt them.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong bloody violence\",\"translations\":[]},\"releaseDate\":\"2025-06-27\",\"runtimeInMinutes\":161,\"trailerUrl\":null,\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003969\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009033\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011481\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011482\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011483\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011484\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011485\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011486\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011487\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011488\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"83bc0a5a-d0fb-424a-90e7-a799ebf5230e\",\"corporateId\":null},\"hopk\":\"HO00006215\",\"hoCode\":\"A000007671\",\"eventId\":null,\"distributorName\":\"Studio Canal\"},{\"id\":\"HO00006252\",\"title\":{\"text\":\"DocHouse: Sudan, Remember Us\",\"translations\":[]},\"synopsis\":{\"text\":\"In 2019, documentary filmmaker Hind Meddab flew to Sudan to film a sit-in protest at the Army headquarters in Khartoum. The people of Sudan were assembling, demanding reform after decades of military dictatorship. There she met a selection of young activists that she would continue to film over the course of 4 years, from the swell of hope and accomplishment following dictator Omar al-Bashir’s fall to the oppression of the military crackdown and subsequent civil war, which today, leaves Sudan in ruins.\\r\\n\\r\\nStanding in front of a powerful army, how could the civilian movement find the strength to persist? In conversations, in demonstrations, on walls, it emerges how the Sudanese tradition for poetry becomes a powerful tool for activism. Art, music and poetry bolster every stage of the Sudanese fight for freedom. SUDAN, REMEMBER US bears witness to a lost revolution and within it unearths a tribute to the power of creativity as a tool of survival and resistance.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In a Sudan torn apart by years of war, this documentary immerses us in the daily fight of young Sudanese. \",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-27\",\"runtimeInMinutes\":76,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011581\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011582\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006252\",\"hoCode\":\"A000007714\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006253\",\"title\":{\"text\":\"DocHouse: Uncropped\",\"translations\":[]},\"synopsis\":{\"text\":\"Rediscover the work of James Hamilton, one of the great chroniclers of the cultural history of America. A New York legend himself, Hamilton created iconic images during the heyday of alternative print - from Patti Smith, Liza Minnelli, Lou Reed, Hitchcock, George Romero, to Noah Baumbach and Wes Anderson.\\r\\n\\r\\nA visual chronicle of New York’s zeitgeist over the last 50 years, UNCROPPED subtly traces the rise and fall of photojournalism itself, making it a compelling and visually rich narrative for audiences seeking a deep dive into cultural and photographic history.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-20\",\"runtimeInMinutes\":111,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011583\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006253\",\"hoCode\":\"A000007715\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00000250\",\"title\":{\"text\":\"DocHouse: The Salt Of The Earth (2015)\",\"translations\":[]},\"synopsis\":{\"text\":\"For the last 40 years acclaimed photographer Sebastião Salgado has travelled the world, tracing the footsteps of an ever-changing humanity. He has witnessed and documented many of the major events of our times, taking in wars, famine, genocide and exodus. But now he is embarking on a new journey; to discover pristine territories, grandiose landscapes and wild nature as part of a huge photographic tribute to the planet’s beauty.\\r\\n<br><br>\\r\\nSalgado’s accomplished, moving work and his inspirational life are revealed to us in this Oscar-nominated documentary by his son, Juliano, and world-renowned filmmaker Wim Wenders, himself an avid photographer. Powerful, affecting and truly profound, it is not just a portrait of a great artist but one of life itself.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Wim Winders presents an account of acclaimed photographer Sebastião Salgado, who over the last 40 has travelled the world witnessing and documenting wonders and events.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2015-07-09\",\"runtimeInMinutes\":110,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00000250\",\"hoCode\":\"A000000295\",\"eventId\":null,\"distributorName\":\"DocHouse\"},{\"id\":\"HO00006210\",\"title\":{\"text\":\"Lollipop\",\"translations\":[]},\"synopsis\":{\"text\":\"Molly, a young woman released from prison struggles to regain custody of her children. When she bumps into her childhood friend Amina the two women soon realize their only chance is to join forces and take destiny into their own hands.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Molly, a young woman released from prison struggles to regain custody of her children. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"very strong language\",\"translations\":[]},\"releaseDate\":\"2025-06-13\",\"runtimeInMinutes\":100,\"trailerUrl\":null,\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000005551\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011445\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011446\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011447\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011448\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011449\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011450\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011451\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011452\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011453\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011454\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011455\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c22a02d9-8d70-45ff-ab14-60b81bb23172\",\"corporateId\":null},\"hopk\":\"HO00006210\",\"hoCode\":\"A000007666\",\"eventId\":null,\"distributorName\":\"Met Film\"},{\"id\":\"HO00006211\",\"title\":{\"text\":\"From Hilde, With Love\",\"translations\":[]},\"synopsis\":{\"text\":\"Berlin, 1942. A shy Hilde falls in love with Hans and gradually finds her place in the \\nresistance group that would come to be known as the “Red Orchestra”. Together, \\nthey spend a beautiful summer where their relationship entwines with quiet acts \\nof defiance. But when the Gestapo arrests members of the group, Hilde and Hans \\nare among their numbers and must find the strength to confront their situation. \\nInspired by an incredible true story set against the backdrop of a country torn by \\nconflict, FROM HILDE, WITH LOVE is a powerful tale of love and resistance. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Inspired by an incredible true story set against the backdrop of a country torn by \\nconflict, FROM HILDE, WITH LOVE is a powerful tale of love and resistance. \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-27\",\"runtimeInMinutes\":125,\"trailerUrl\":null,\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007133\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008837\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011456\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011457\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011458\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011459\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011460\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011461\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b19e5bb9-996d-4ea7-b588-04b4f0aa48da\",\"corporateId\":null},\"hopk\":\"HO00006211\",\"hoCode\":\"A000007667\",\"eventId\":null,\"distributorName\":\"Picturehouse Entertainment\"},{\"id\":\"HO00006110\",\"title\":{\"text\":\"F1® The Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career. Thirty years later, he’s a nomadic racer-for-hire when he’s approached by his former teammate Ruben Cervantes (Javier Bardem), owner of a struggling FORMULA 1 team that is on the verge of collapse. Ruben convinces Sonny to come back to FORMULA 1 for one last shot at saving the team and being the best in the world. He’ll drive alongside Joshua Pearce (Damson Idris), the team's hotshot rookie intent on setting his own pace. But as the engines roar, Sonny’s past catches up with him and he finds that in FORMULA 1, your teammate is your fiercest competition—and the road to redemption is not something you can travel alone.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate threat\",\"translations\":[]},\"releaseDate\":\"2025-06-25\",\"runtimeInMinutes\":156,\"trailerUrl\":\"https://www.youtube.com/watch?v=TZGY2CWPXeU\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000166\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000167\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001693\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002986\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003190\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003191\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008544\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008790\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011188\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"90334335-0de9-4985-8924-9942f4379b60\",\"corporateId\":null},\"hopk\":\"HO00006110\",\"hoCode\":\"A000007538\",\"eventId\":null,\"distributorName\":\"Warners\"}],\"castAndCrew\":[{\"id\":\"0000001876\",\"name\":{\"givenName\":\"Silvio\",\"familyName\":\"Orlando\",\"middleName\":null}},{\"id\":\"0000001877\",\"name\":{\"givenName\":\"Paolo\",\"familyName\":\"Sorrentino\",\"middleName\":null}},{\"id\":\"0000003564\",\"name\":{\"givenName\":\"Ardavan\",\"familyName\":\"Safaee\",\"middleName\":null}},{\"id\":\"0000011053\",\"name\":{\"givenName\":\"Gary\",\"familyName\":\"Oldman\",\"middleName\":null}},{\"id\":\"0000011054\",\"name\":{\"givenName\":\"Stefania\",\"familyName\":\"Sandrelli\",\"middleName\":null}},{\"id\":\"0000011055\",\"name\":{\"givenName\":\"Isabella\",\"familyName\":\"Ferrari\",\"middleName\":null}},{\"id\":\"0000011056\",\"name\":{\"givenName\":\"Celeste\",\"familyName\":\"Dalla Porta\",\"middleName\":null}},{\"id\":\"0000011057\",\"name\":{\"givenName\":\"Peppe\",\"familyName\":\"Lanzetta\",\"middleName\":null}},{\"id\":\"0000011058\",\"name\":{\"givenName\":\"Anthony\",\"familyName\":\"Vaccarello\",\"middleName\":null}},{\"id\":\"HO00000156\",\"name\":{\"givenName\":\"Luisa\",\"familyName\":\"Ranieri\",\"middleName\":null}},{\"id\":\"HO00000161\",\"name\":{\"givenName\":\"Lorenzo\",\"familyName\":\"Mieli\",\"middleName\":null}},{\"id\":\"0000000186\",\"name\":{\"givenName\":\"Mathieu\",\"familyName\":\"Amalric\",\"middleName\":null}},{\"id\":\"0000000187\",\"name\":{\"givenName\":\"Riz\",\"familyName\":\"Ahmed\",\"middleName\":null}},{\"id\":\"0000000698\",\"name\":{\"givenName\":\"Scarlett \",\"familyName\":\"Johansson\",\"middleName\":null}},{\"id\":\"0000001084\",\"name\":{\"gi