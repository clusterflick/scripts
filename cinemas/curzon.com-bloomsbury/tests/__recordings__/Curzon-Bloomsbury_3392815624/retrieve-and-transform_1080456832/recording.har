        "response": {
          "bodySize": 4050,
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 4050,
            "text": "{\"businessDate\":\"2025-11-05\",\"showtimes\":[{\"id\":\"BLO1-99945\",\"schedule\":{\"businessDate\":\"2025-11-05\",\"startsAt\":\"2025-11-05T19:15:00+00:00\",\"endsAt\":\"2025-11-05T22:45:00+00:00\",\"filmStartsAt\":\"2025-11-05T19:15:00+00:00\",\"filmEndsAt\":\"2025-11-05T22:45:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006226\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000042\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006226\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: La Fille Mal Gardee\",\"translations\":[]},\"synopsis\":{\"text\":\"Lise, the only daughter of Widow Simone, is in love with the young farmer Colas, but her mother has far more ambitious plans for her. Simone hopes to marry her off to Alain, the son of the wealthy proprietor Thomas. Desperate to marry Colas rather than Alain, Lise contrives to outwit her mother’s plans.  \\n65 years after its premiere, The Royal Ballet presents Frederick Ashton’s La Fille mal gardée. This affectionate portrayal of village life combines exuberant good humour and brilliantly inventive choreography in what is undoubtedly Ashton’s love letter to the English countryside. La Fille mal gardée whisks us away into pastoral bliss with Ferdinand Hérold’s cheerful score and Osbert Lancaster’s colourful designs.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Lise, the only daughter of Widow Simone, is in love with the young farmer Colas, but her mother has far more ambitious plans for her.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-05\",\"runtimeInMinutes\":210,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"431db788-8022-47d3-b718-45d5af01a49a\",\"corporateId\":null},\"hopk\":\"HO00006226\",\"hoCode\":\"A000007683\",\"eventId\":\"0000000042\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000003\",\"name\":{\"text\":\"Live event\",\"translations\":[]},\"shortName\":{\"text\":\"Live\",\"translations\":[]},\"description\":{\"text\":\"Live Via Satellite\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"BLO1-6\",\"name\":{\"text\":\"Bertha Dochouse\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000042\",\"name\":{\"text\":\"Royal Ballet and Opera\",\"translations\":[]},\"shortName\":{\"text\":\"RB&O\",\"translations\":[]},\"description\":{\"text\":\"The Royal Ballet and Opera brings the thrill of world-class theatre to cinema screens right around the globe. \\n\\nWith productions across both Companies, the programme includes beloved classics as well as new productions.\\n\\nOffering audiences a view from the best seat in the house, the programme shares the joy of live performance, and the beauty of world-class art with cinemagoers in more than 1,500 cinemas and 50 countries around the world.\\n\",\"translations\":[]},\"sc