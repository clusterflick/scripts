            "text": "{\"name\":\"Bloomsbury\",\"urlSegment\":\"bloomsbury\",\"url\":\"/venues/bloomsbury/\",\"nodeId\":1800,\"alias\":\"cinema\",\"createDate\":\"2024-08-13T14:55:57\\u002B01:00\",\"updateDate\":\"2025-06-24T08:16:09\\u002B01:00\",\"robotsNoIndex\":false,\"robotsNoFollow\":false,\"masterCanonicalUrl\":null,\"excludeCanonicalUrl\":false,\"seoImage\":null,\"metaKeywords\":\"\",\"metaDescription\":\"Find out what\\u0027s on at Curzon Cinema in Bloomsbury. Check out the latest blockbuster movies, new Indie film releases and the best of world cinema out now.\",\"seoPageTitle\":\"Curzon Bloomsbury Cinema Showtimes \\u0026 Film Listings\",\"oGType\":\"\",\"twitterCard\":\"\",\"seoUrl\":\"\",\"oGLocale\":\"\",\"excludeFromXmlSitemap\":false,\"excludeFromSiteSearch\":false,\"pageTitle\":\"Curzon Bloomsbury Cinema Showtimes \\u0026 Film Listings\",\"hideTitle\":false,\"grid\":[],\"redirectDetailsElement\":{\"redirect\":false,\"permanent\":false},\"heroCarouselDetailsElement\":[{\"image\":{\"mobile\":\"/media/muzb3vxg/blooms1.jpg?width=393\\u0026height=169\\u0026v=1db9d7f76f97930\",\"tablet\":\"/media/muzb3vxg/blooms1.jpg?width=782\\u0026height=315\\u0026v=1db9d7f76f97930\",\"desktop\":\"/media/muzb3vxg/blooms1.jpg?width=1216\\u0026height=523\\u0026v=1db9d7f76f97930\",\"alt\":\"\"},\"textHeading\":\"WELCOME TO CURZON BLOOMSBURY\",\"actionLink\":{\"name\":\"TAKE A TOUR\",\"target\":\"_blank\",\"url\":\"https://tours.360virtualtours.co.uk/curzon/bloomsbury/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=393\\u0026height=169\\u0026v=1dbe4e025633ef0\",\"tablet\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=782\\u0026height=315\\u0026v=1dbe4e025633ef0\",\"desktop\":\"/media/nqiftp2s/stonewall-logo-web2.jpg?width=1216\\u0026height=523\\u0026v=1dbe4e025633ef0\",\"alt\":\"\"},\"textHeading\":\"Support Stonewall on your Curzon cinema visit\",\"actionLink\":{\"name\":\"FIND OUT MORE\",\"url\":\"https://www.curzon.com/charity/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/pjsj0oss/pepperoni.jpg?width=393\\u0026height=169\\u0026v=1daf1d80a3f4700\",\"tablet\":\"/media/pjsj0oss/pepperoni.jpg?width=782\\u0026height=315\\u0026v=1daf1d80a3f4700\",\"desktop\":\"/media/pjsj0oss/pepperoni.jpg?width=1216\\u0026height=523\\u0026v=1daf1d80a3f4700\",\"alt\":\"\"},\"textHeading\":\"FOOD AND DRINK\",\"actionLink\":{\"name\":\"View Menu\",\"target\":\"_blank\",\"url\":\"https://www.curzon.com/media/j10nivdb/menu-2.pdf\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/10tibjxq/ph-blooms.jpg?width=393\\u0026height=169\\u0026v=1db9d7f9f34b2c0\",\"tablet\":\"/media/10tibjxq/ph-blooms.jpg?width=782\\u0026height=315\\u0026v=1db9d7f9f34b2c0\",\"desktop\":\"/media/10tibjxq/ph-blooms.jpg?width=1216\\u0026height=523\\u0026v=1db9d7f9f34b2c0\",\"alt\":\"\"},\"textHeading\":\"HIRE THIS SPACE\",\"actionLink\":{\"name\":\"CONTACT US\",\"url\":\"https://www.curzon.com/private-hire/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/zsmft0r4/blooms2.jpg?width=393\\u0026height=169\\u0026v=1db9d7fb49c9650\",\"tablet\":\"/media/zsmft0r4/blooms2.jpg?width=782\\u0026height=315\\u0026v=1db9d7fb49c9650\",\"desktop\":\"/media/zsmft0r4/blooms2.jpg?width=1216\\u0026height=523\\u0026v=1db9d7fb49c9650\",\"alt\":\"\"}},{\"image\":{\"mobile\":\"/media/yzehnils/cocktail-image.webp?width=393\\u0026height=169\\u0026v=1daf1d80a3a3df0\",\"tablet\":\"/media/yzehnils/cocktail-image.webp?width=782\\u0026height=315\\u0026v=1daf1d80a3a3df0\",\"desktop\":\"/media/yzehnils/cocktail-image.webp?width=1216\\u0026height=523\\u0026v=1daf1d80a3a3df0\",\"alt\":\"\"}}],\"cinemaLocationDetailsElement\":{\"venueCardImage\":{\"mobile\":\"/media/k3cbkjdi/cinema-venues-_bloomsbury.jpg?width=300\\u0026height=160\\u0026v=1db9989820c3910\",\"alt\":\"\"},\"addressLine1\":\"The Brunswick Centre\",\"city\":\"London\",\"postcode\":\"WC1N 1AW\",\"nearestStationName\":\"Russell Square\",\"nearestStationType\":\"underground\"},\"vistaCinema\":{\"key\":\"BLO1\",\"value\":\"Bloomsbury\"},\"informationTabAccordions\":[{\"heading\":\"Opening times\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EMonday to Saturday\\u003C/strong\\u003E: The cinema opens 30 minutes before the first show\\u0027s programme begins and closes at midnight.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESunday\\u003C/strong\\u003E: Closes at 11.30pm.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cem\\u003EPlease be aware opening and closing times may be subject to change.\\u003C/em\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Screen info\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003ELumiere and Plaza Screens\\u003C/strong\\u003E\\u003Cbr\\u003E30 seats, 2 wheelchair spaces\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EMinema and Phoenix Screens\\u003C/strong\\u003E\\u003Cbr\\u003E28 seats, 2 wheelchair spaces\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EBertha Dochouse\\u003C/strong\\u003E\\u003Cbr\\u003E55 seats, 2 wheelchair spaces\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003ERenoir Screen\\u003C/strong\\u003E\\u003Cbr\\u003E148 seats (139 in the main auditorium with 2 wheelchair spaces, 9 balcony seats with 1 wheelchair space) Seating information: Rows A-F are accessible from -2 level, balcony seats on row X are accessible from -1 level.\\u003C/p\\u003E\"},{\"heading\":\"Accessibility\",\"body\":\"\\u003Cp\\u003EAll screens are accessible by lift, and each one has at least two wheelchair spaces. There is a wheelchair-accessible restroom.\\u003C/p\\u003E\\n\\u003Cp\\u003EAudio Description and hearing-assist headsets are available on request.\\u003C/p\\u003E\"},{\"heading\":\"Food and Drink\",\"body\":\"\\u003Cp\\u003EFresh coffee and teas alongside an all day menu of bar food with vegan and vegetarian options available. The drinks menu includes a wide selection of cocktails, wine, craft beer and soft drinks.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022https://www.curzon.com/media/j10nivdb/menu-2.pdf\\u0022 target=\\u0022_blank\\u0022\\u003ESee our full menu here.\\u003C/a\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Happy Hour Information\",\"body\":\"\\u003Cp\\u003EAt this venue Happy Hour is all day: 2 for \\u00A316 on all cocktails.\\u003C/p\\u003E\"},{\"heading\":\"Private hires\",\"body\":\"\\u003Cp\\u003EOur screens are available to rent for your private functions, email \\u003Ca href=\\u0022mailto:privatehires@curzon.com\\u0022\\u003Eprivatehires@curzon.com\\u003C/a\\u003E for more information.\\u003C/p\\u003E\\n\\u003Cp\\u003ETo find out more, visit our \\u003Ca href=\\u0022https://www.curzon.com/private-hire/bloomsbury/\\u0022\\u003EPrivate Hires page.\\u003C/a\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Social Media\",\"body\":\"\\u003Cp\\u003EInstagram: \\u003Ca href=\\u0022https://www.instagram.com/curzonbloomsbury?igsh=OW9yeHZlZjl6a2dt\\u0022 data-anchor=\\u0022?igsh=OW9yeHZlZjl6a2dt\\u0022\\u003Ecurzonbloomsbury\\u003C/a\\u003E\\u003C/p\\u003E\"}],\"informationTabDescription\":\"\\u003Cp\\u003EA historic arthouse cinema, Curzon Bloomsbury cherishes its heritage, and its five screens are named after iconic Curzon-operated sites since 1934, including the beloved Renoir, the largest, theatre-style auditorium. It is also home to Bertha DocHouse, a dedicated documentary screen that hosts documentary premieres, seasons and live Q\\u0026amp;As with filmmakers. The venue is centrally located in the Brunswick Centre, and boasts a light and airy cafe with floor-to-ceiling glass windows.\\u003C/p\\u003E\\n\\u003Cp\\u003EFor Bertha Dochouse updates, \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022https://dochouse.org/subscribe-now/\\u0022 target=\\u0022_blank\\u0022 title=\\u0022Bertha Dochouse Newsletter\\u0022\\u003Esubscribe to the newsletter here\\u003C/a\\u003E\\u003C/span\\u003E.\\u003C/p\\u003E\",\"menuTabAccordions\":[{\"heading\":\"Pizza\",\"body\":\"\\u003Ctable border=\\u00221\\u0022 style=\\u0022border-collapse: collapse; width: 100%; height: 382px;\\u0022\\u003E\\n\\u003Ctbody\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EMargherita (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A311.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EPepperoni \\u0026amp; Honey\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003E\\u0027Nduja\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EGoat\\u0027s Cheese \\u0026amp; Caramelised Onion (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.80\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EMushroom \\u0026amp; Truffle Oil (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.80\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 1