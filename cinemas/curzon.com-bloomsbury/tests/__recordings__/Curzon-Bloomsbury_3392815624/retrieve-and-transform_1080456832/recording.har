        "response": {
          "bodySize": 5077,
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 5077,
            "text": "{\"businessDate\":\"2025-07-10\",\"showtimes\":[{\"id\":\"BLO1-100472\",\"schedule\":{\"businessDate\":\"2025-07-10\",\"startsAt\":\"2025-07-10T18:20:00+01:00\",\"endsAt\":\"2025-07-10T20:04:00+01:00\",\"filmStartsAt\":\"2025-07-10T18:27:00+01:00\",\"filmEndsAt\":\"2025-07-10T20:04:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-6-1\",\"filmId\":\"HO00006279\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-6\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000012\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006279\",\"title\":{\"text\":\"DocHouse: Hearts of Darkness\",\"translations\":[]},\"synopsis\":{\"text\":\"In the late 1970s, celebrated director Francis Ford Coppola (The Godfather, The Conversation) and his cast, crew and family ventured into the dense jungles of the Philippines to begin work on what would eventually become his masterpiece, APOCALYPSE NOW.\\r\\n\\r\\nBut the journey from page to screen soon spiralled into a hellish, life-threatening nightmare that echoed the film’s narrative. Plagued with adversity, one of the most influential films ever made had one of the most notorious shoots in cinema history that few survived unscathed.\\r\\n\\r\\nMeticulously documented at the time by Eleanor Coppola, Fax Bahr and George Hickenlooper revisited the footage in 1991 and filmed new interviews with cast and crew, resulting in HEARTS OF DARKNESS, a groundbreaking and intimate portrait of what went into making one of the best films ever made.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Documentary that chronicles how Francis Ford Coppola's Apocalypse Now (1979) was plagued by extraordinary script, shooting, budget, and casting problems. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong bloody violence, injury detail, language, drug misuse\",\"translations\":[]},\"releaseDate\":\"2025-07-05\",\"runtimeInMinutes\":97,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000146\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004581\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006335\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008012\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008551\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011664\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"0000011665\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011666\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011667\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011668\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000328\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006279\",\"hoCode\":\"A000007747\",\"eventId\":null,\"distributorName\":\"DocHouse\"}],\"castAndCrew\":[{\"id\":\"0000000146\",\"name\":{\"givenName\":\"Martin\",\"familyName\":\"Sheen\",\"middleName\":null}},{\"id\":\"0000004581\",\"name\":{\"givenName\":\"Robert\",\"familyName\":\"DuVall\",\"middleName\":null}},{\"id\":\"0000006335\",\"name\":{\"givenName\":\"Francis\",\"familyName\":\"Ford Coppola\",\"middleName\":null}},{\"id\":\"0000008012\",\"name\":{\"givenName\":\"Fred\",\"familyName\":\"Roos\",\"middleName\":null}},{\"id\":\"0000008551\",\"name\":{\"givenName\":\"George\",\"familyName\":\"Lucas\",\"middleNa