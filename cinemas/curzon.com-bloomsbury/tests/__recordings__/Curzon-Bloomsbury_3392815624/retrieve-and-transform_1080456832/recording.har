            "mimeType": "application/json; charset=utf-8",
            "size": 4296,
            "text": "{\"businessDate\":\"2025-11-08\",\"showtimes\":[{\"id\":\"BLO1-99920\",\"schedule\":{\"businessDate\":\"2025-11-08\",\"startsAt\":\"2025-11-08T18:00:00+00:00\",\"endsAt\":\"2025-11-08T21:30:00+00:00\",\"filmStartsAt\":\"2025-11-08T18:00:00+00:00\",\"filmEndsAt\":\"2025-11-08T21:30:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"BLO1-5-18\",\"filmId\":\"HO00006237\",\"siteId\":\"BLO1\",\"screenId\":\"BLO1-5\",\"areaCategories\":[{\"areaCategoryId\":\"BLO1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"BLO1\",\"name\":{\"text\":\"Bloomsbury\",\"translations\":[]},\"location\":{\"latitude\":51.5247,\"longitude\":-0.123},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"The Brunswick Centre,\",\"line2\":\"London,\",\"city\":\"WC1N 1AW\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006237\",\"title\":{\"text\":\"Met Opera 2025-26: La Bohème\",\"translations\":[]},\"synopsis\":{\"text\":\"With its enchanting setting and spellbinding score, the world’s most popular opera is as timeless as it is heartbreaking. Franco Zeffirelli’s picture-perfect production brings 19th-century Paris to the Met stage as Puccini’s young friends and lovers navigate the joy and struggle of bohemian life. Soprano Juliana Grigoryan is the feeble seamstress Mimì, opposite tenor Freddie De Tommaso as the ardent poet Rodolfo. Keri-Lynn Wilson conducts the November 8 performance, which will be transmitted live from the Met stage to cinemas worldwide. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"With its enchanting setting and spellbinding score, the world’s most popular opera is as timeless as it is heartbreaking. \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-08\",\"runtimeInMinutes\":210,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000009287\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000386\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000621\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000622\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000623\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000624\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000625\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000626\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000627\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"57663c62-8315-4967-9499-407fbb4bb43d\",\"corporateId\":null},\"hopk\":\"HO00006237\",\"hoCode\":\"A000007695\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000009287\",\"name\":{\"givenName\":\"Freddie\",\"familyName\":\"De Tommaso\",\"middleName\":null}},{\"id\":\"HO00000386\",\"name\":{\"givenName\":\"Lucas \",\"familyName\":\"Meachem\",\"middleName\":null}},{\"id\":\"HO00000621\",\"name\":{\"givenName\":\"Keri-Lynn\",\"familyName\":\"Wilson\",\"middleName\":null}},{\"id\":\"HO00000622\",\"name\":{\"givenName\":\"Juliana\",\"familyName\":\"Grigoryan\",\"middleName\":null}},{\"id\":\"HO00000623\",\"name\":{\"givenName\":\"Heidi\",\"familyName\":\"Stober\",\"middleName\":null}},{\"id\":\"HO00000624\",\"name\":{\"givenName\":\"Sean Michael\",\"familyName\":\"Plumb\",\"middleName\":null}},{\"id\":\"HO00000625\",\"name\":{\"givenName\":\"Jongmin\",\"familyName\":\"Park\",\"middleName\":null}},{\"id\":\"HO00000626\",\"name\":{\"givenName\":\"Donald\",\"familyName\":\"Maxwell\",\"middleName\":null}},{\"id\":\"HO00