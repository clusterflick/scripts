0C/LND+-+1-+IG.png\" data-image=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/1758279875054-CE11HO8GDVIWCTBKMY0C/LND+-+1-+IG.png\" data-image-dimensions=\"2250x2813\" data-image-focal-point=\"0.5,0.5\" alt=\"Shoegaze Horror: Bad Vibes, Liminal Loops and Deadly Dissociation\"  class=\"eventlist-thumbnail\" data-load=\"false\"></a>\n\n        <a href=\"/events/miskatonic-shoegaze\" class=\"eventlist-column-date\">\n\n          <div class=\"eventlist-datetag\">\n\n            <div class=\"eventlist-datetag-inner\">\n\n              <div class=\"eventlist-datetag-startdate eventlist-datetag-startdate--month\">Sept</div>\n              <div class=\"eventlist-datetag-startdate eventlist-datetag-startdate--day\">30</div>\n\n              \n              <div class=\"eventlist-datetag-time\"><span class=\"event-time-12hr\">7:00 pm</span><span class=\"event-time-24hr\">19:00</span></div>\n\n              \n\n              <div class=\"eventlist-datetag-status\"></div>\n\n            </div>\n\n          </div>\n\n        </a>\n\n        <div class=\"eventlist-column-info\">\n\n          \n          <div class=\"eventlist-cats\">\n            <a href=\"?category=Upcoming\">Upcoming</a>, <a href=\"?category=Film\">Film</a>, <a href=\"?category=Talk\">Talk</a>\n          </div>\n          \n\n          <h1 class=\"eventlist-title\"><a href=\"/events/miskatonic-shoegaze\" class=\"eventlist-title-link\">Shoegaze Horror: Bad Vibes, Liminal Loops and Deadly Dissociation</a></h1>\n\n          <ul class=\"eventlist-meta event-meta\">\n\n            \n\n            <li class=\"eventlist-meta-item eventlist-meta-date event-meta-item\">\n              <time class=\"event-date\" datetime=\"2025-09-30\">Tuesday 30 September 2025</time>\n            </li>\n\n            <li class=\"eventlist-meta-item eventlist-meta-time event-meta-item\">\n              <span class=\"event-time-12hr\">\n                <time class=\"event-time-12hr-start\" datetime=\"2025-09-30\">7:00 pm</time>\n                <span class=\"event-datetime-divider\"></span>\n                <time class=\"event-time-12hr-end\" datetime=\"2025-09-30\">10:30 pm</time>\n              </span>\n              <span class=\"event-time-24hr\">\n                <time class=\"event-time-24hr-start\" datetime=\"2025-09-30\">19:00</time>\n                <span class=\"event-datetime-divider\"></span>\n                <time class=\"event-time-12hr-end\" datetime=\"2025-09-30\">22:30</time>\n              </span>\n            </li>\n\n            \n\n            \n              \n            \n\n            <li class=\"eventlist-meta-item eventlist-meta-export event-meta-item\">\n              <a href=\"http://www.google.com/calendar/event?action=TEMPLATE&text=Shoegaze%20Horror%3A%20Bad%20Vibes%2C%20Liminal%20Loops%20and%20Deadly%20Dissociation&dates=20250930T180000Z/20250930T213000Z\" class=\"eventlist-meta-export-google\">Google Calendar</a>\n              <span class=\"eventlist-meta-export-divider\"></span>\n              <a href=\"/events/miskatonic-shoegaze?format=ical\" class=\"eventlist-meta-export-ical\">ICS</a>\n            </li>\n\n          </ul>\n\n          \n          <div class=\"eventlist-excerpt\"><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Step into the hazy, destabilising world of Shoegaze Horror—a strain of cinema that trades story for sensation, jump scares for silence, and clarity for lingering dread. Presented by <strong>Andrew Pope</strong></p></div>\n          \n\n          <a href=\"/events/miskatonic-shoegaze\" class=\"eventlist-button sqs-editable-button sqs-button-element--primary\">\n            View Event &#8594;\n          </a>\n\n          <div class=\"eventlist-actions\">\n  <span class=\"sqs-simple-like\" data-item-id=\"68cd3832d1a5b3775f2545a5\" data-like-count=\"0\">\n    <span class=\"like-icon\"></span>\n    <span class=\"like-count\"></span>\n  </span>\n<span class=\"squarespace-social-buttons inline-style\"