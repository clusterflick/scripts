://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/22b224a5-d236-40ad-b5f0-a5d900e189e3/8a---tribulation-99-1992-promo-still_1-credit---other-cinema.jpg?format=750w 750w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/22b224a5-d236-40ad-b5f0-a5d900e189e3/8a---tribulation-99-1992-promo-still_1-credit---other-cinema.jpg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/22b224a5-d236-40ad-b5f0-a5d900e189e3/8a---tribulation-99-1992-promo-still_1-credit---other-cinema.jpg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/22b224a5-d236-40ad-b5f0-a5d900e189e3/8a---tribulation-99-1992-promo-still_1-credit---other-cinema.jpg?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n            </div>\n          </div>\n        \n          \n        \n\n        \n      \n        </figure>\n      \n\n    </div>\n  \n\n\n  \n\n\n</div></div><div class=\"sqs-block horizontalrule-block sqs-block-horizontalrule\" data-block-type=\"47\" id=\"block-yui_3_17_2_1_1767696670151_115608\"><div class=\"sqs-block-content\"><hr /></div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-yui_3_17_2_1_1767696670151_119622\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\"><strong>Tellurian Drama</strong></p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div><div class=\"sqs-block image-block sqs-block-image\" data-block-type=\"5\" id=\"block-yui_3_17_2_1_1767696670151_116279\"><div class=\"sqs-block-content\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n\n    \n  \n    <div\n        class=\"\n          image-block-outer-wrapper\n          layout-caption-below\n          design-layout-inline\n          combination-animation-none\n          individual-animation-none\n          individual-text-animation-none\n        \"\n        data-test=\"image-block-inline-outer-wrapper\"\n    >\n\n      \n\n      \n        <figure\n            class=\"\n              sqs-block-image-figure\n              intrinsic\n            \"\n            style=\"max-width:1920px;\"\n        >\n          \n        \n        \n\n        \n          \n            \n          <div\n              \n              \n              class=\"image-block-wrapper\"\n              data-animation-role=\"image\"\n              \n  \n\n          >\n            <div class=\"sqs-image-shape-container-element\n              \n          \n        \n              has-aspect-ratio\n            \" style=\"\n                position: relative;\n                \n                  padding-bottom:56.25%;\n                \n                overflow: hidden;-webkit-mask-image: -webkit-radial-gradient(white, black);\n              \"\n              >\n                \n                \n                \n                \n                \n                \n                \n                <img data-stretch=\"false\" data-src=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c8b73350-6bc0-46dc-bb9e-4d4acfee2bd9/tellurian1.jpg\" data-image=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c8b73350-6bc0-46dc-bb9e-4d4acfee2bd9/tellurian1.jpg\" data-image-dimensions=\"1920x1080\" data-image-focal-point=\"0.5,0.5\" alt=\"\" data-load=\"false\" elementtiming=\"system-image-block\"  src=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c8b73350-6bc0-46dc-bb9e-4d4acfee2bd9/tellurian1.jpg\" width=\"1920\" height=\"1080\" alt=\"\" sizes=\"(max-width: 640px) 100vw, (max-width: 767px) 100vw, 100vw\" style=\"display:block;object-fit: cover; width: 100%; height: 100%; object-position: 50% 50%\" onload=\"this.classList.add(&quot;loaded&quot;)\" srcset=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c8b73350-6bc0-46dc-bb9e-4d4acfee2bd9/tellurian1.jpg?format=100w 100w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c8b73350-6bc0-46dc-bb9e-4d4acfee2bd9/tellurian1.jpg?format=300w 300w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c8b73350-6bc0-46dc-bb9e-4d4acfee2bd9/tellurian1.jpg?format=500w 500w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c8b73350-6bc0-46dc-bb9e-4d4acfee2bd9/tellurian1.jpg?format=750w 750w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c8b73350-6bc0-46dc-bb9e-4d4acfee2bd9/tellurian1.jpg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c8b73350-6bc0-46dc-bb9e-4d4acfee2bd9/tellurian1.jpg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c8b73350-6bc0-46dc-bb9e-4d4acfee2bd9/tellurian1.jpg?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n            </div>\n          </div>\n        \n          \n        \n\n        \n      \n        </figure>\n      \n\n    </div>\n  \n\n\n  \n\n\n</div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-yui_3_17_2_1_1767696670151_115879\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\">May 5th, 1923. The Dutch East Indies government celebrated the opening of a new radio station in West Java. It was called Radio Malabar. In March 2020, the local Indonesian government plans to reactivate the station as a historical site and tourist attraction. <em>Tellurian Drama</em> imagines what would have happened in between: the vital role of mountain in history; colonial ruins as an apparatus for geoengineering technology; and the invisible power of indigenous ancestral. Narrated based on the forgotten text written by a prominent pseudo-anthropologist Drs. Munarwan, Tellurian Drama problematises the notion of decolonisation, geocentric technology, and historicity of communication.</p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div><div class=\"sqs-block image-block sqs-block-image\" data-block-type=\"5\" id=\"block-yui_3_17_2_1_1767696670151_117127\"><div class=\"sqs-block-content\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n\n    \n  \n    <div\n        class=\"\n          image-block-outer-wrapper\n          layout-caption-below\n          design-layout-inline\n          combination-animation-none\n          individual-animation-none\n          individual-text-animation-none\n        \"\n        data-test=\"image-block-inline-outer-wrapper\"\n    >\n\n      \n\n      \n        <figure\n            class=\"\n              sqs-block-image-figure\n              intrinsic\n            \"\n            style=\"max-width:3024px;\"\n        >\n          \n        \n        \n\n        \n          \n            \n          <div\n              \n              \n              class=\"image-block-wrapper\"\n              data-animation-role=\"image\"\n              \n  \n\n          >\n            <div class=\"sqs-image-shape-container-element\n              \n          \n        \n              has-aspect-ratio\n            \" style=\"\n                position: relative;\n                \n                  padding-bottom:56.41534423828125%;\n                \n                overflow: hidden;-webkit-mask-image: -webkit-radial-gradient(white, black);\n              \"\n              >\n                \n                \n                \n                \n                \n                \n                \n                <img data-stretch=\"false\" data-src=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/8078c810-37a4-463a-828c-5b35ea60074e/Screenshot+2025-11-26+at+00.26.32.png\" dat