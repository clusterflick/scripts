age: -webkit-radial-gradient(white, black);\n              \"\n              >\n                \n                \n                \n                \n                \n                \n                \n                <img data-stretch=\"false\" data-src=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/059d9f28-baa5-4f63-bae9-7b08f0ebc7bc/your-image9.png\" data-image=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/059d9f28-baa5-4f63-bae9-7b08f0ebc7bc/your-image9.png\" data-image-dimensions=\"3420x2214\" data-image-focal-point=\"0.5,0.5\" alt=\"\" data-load=\"false\" elementtiming=\"system-image-block\" data-sqsp-image-classic-block-image src=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/059d9f28-baa5-4f63-bae9-7b08f0ebc7bc/your-image9.png\" width=\"3420\" height=\"2214\" alt=\"\" sizes=\"(max-width: 640px) 100vw, (max-width: 767px) 100vw, 100vw\" style=\"display:block;object-fit: cover; width: 100%; height: 100%; object-position: 50% 50%\" onload=\"this.classList.add(&quot;loaded&quot;)\" srcset=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/059d9f28-baa5-4f63-bae9-7b08f0ebc7bc/your-image9.png?format=100w 100w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/059d9f28-baa5-4f63-bae9-7b08f0ebc7bc/your-image9.png?format=300w 300w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/059d9f28-baa5-4f63-bae9-7b08f0ebc7bc/your-image9.png?format=500w 500w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/059d9f28-baa5-4f63-bae9-7b08f0ebc7bc/your-image9.png?format=750w 750w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/059d9f28-baa5-4f63-bae9-7b08f0ebc7bc/your-image9.png?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/059d9f28-baa5-4f63-bae9-7b08f0ebc7bc/your-image9.png?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/059d9f28-baa5-4f63-bae9-7b08f0ebc7bc/your-image9.png?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n            </div>\n          </div>\n        \n          \n        \n\n        \n      \n        </figure>\n      \n\n    </div>\n  \n\n\n  \n\n\n</div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-1caca95f07f2181b124e\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\"><strong>capital city</strong> is a collective that makes narrative performance. It was founded in southeast London in 2024. Its members are <strong>George Lynch</strong>, <strong>Joe Davies</strong>, <strong>Alex McKenzie</strong>, <strong>Tom Hardwick-Allan</strong>, and <strong>Hannah Taverner</strong>.<strong> </strong>capital city is a collective that makes narrative performance. It was founded in southeast London in 2024. </p><p class=\"\" style=\"white-space:pre-wrap;\">cc's first major production was the play <em>12april</em>, which debuted at <strong>CCA Glasgow</strong> in November 2024. cc has since produced performances for <strong>London Performance Studios</strong>, <strong>Beaconsfield Gallery</strong> and <strong>Les Urbaines Festival</strong> 2025.<br><a href=\"https://capital-city.neocities.org/\">https://capital-city.neocities.org/</a> </p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-horizontalrule horizontalrule-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.horizontalrule/fd311378-f51a-49e8-aa21-5543ebe3b17e_109/website.components.horizontalrule.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.horizontalrule/fd311378-f51a-49e8-aa21-5543ebe3b17e_109/website.components.horizontalrule.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.horizontalrule\" data-sqsp-block=\"line\" data-website-component-id=\"e25e49be0891af0326ae\" id=\"block-e25e49be0891af0326ae\"><div class=\"sqs-block-content\"><hr />\n</div></div><div class=\"sqs-block image-block sqs-block-image\" data-block-type=\"5\" data-sqsp-block=\"image-classic\" id=\"block-yui_3_17_2_1_1781607122873_115375\"><div class=\"sqs-block-content\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n\n    \n  \n    <div\n        class=\"\n          image-block-outer-wrapper\n          layout-caption-below\n          design-layout-inline\n          combination-animation-none\n          individual-animation-none\n          individual-text-animation-none\n        \"\n        data-test=\"image-block-inline-outer-wrapper\"\n        data-sqsp-image-classic-block-layout=\"inline\"\n    >\n\n      \n\n      \n        <figure\n            class=\"\n              sqs-block-image-figure\n              intrinsic\n            \"\n            style=\"max-width:1200px;\"\n        >\n          \n        \n        \n\n        \n          \n            \n          <div\n              \n              \n              class=\"image-block-wrapper\"\n              data-animation-role=\"image\"\n              \n  \n\n          >\n            <div data-sqsp-image-classic-block-image-container class=\"sqs-image-shape-container-element\n              \n          \n        \n              has-aspect-ratio\n            \" style=\"\n                position: relative;\n                \n                  padding-bottom:75%;\n                \n                overflow: hidden;-webkit-mask-image: -webkit-radial-gradient(white, black);\n              \"\n              >\n                \n                \n                \n                \n                \n                \n                \n                <img data-stretch=\"false\" data-src=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/b01d1d03-5c5a-45a4-ac3e-f2858f5e6e3b/0027641161_10.jpg\" data-image=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/b01d1d03-5c5a-45a4-ac3e-f2858f5e6e3b/0027641161_10.jpg\" data-image-dimensions=\"1200x900\" data-image-focal-point=\"0.5,0.5\" alt=\"\" data-load=\"false\" elementtiming=\"system-image-block\" data-sqsp-image-classic-block-image src=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/b01d1d03-5c5a-45a4-ac3e-f2858f5e6e3b/0027641161_10.jpg\" width=\"1200\" height=\"900\" alt=\"\" sizes=\"(max-width: 640px) 100vw, (max-width: 767px) 100vw, 100vw\" style=\"display:block;object-fit: cover; width: 100%; height: 100%; object-position: 50% 50%\" onload=\"this.classList.add(&quot;loaded&quot;)\" srcset=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/b01d1d03-5c5a-45a4-ac3e-f2858f5e6e3b/0027641161_10.jpg?format=100w 100w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/b01d1d03-5c5a-45a4-ac3e-f2858f5e6e3b/0027641161_10.jpg?format=300w 300w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/b01d1d03-5c5a-45a4-ac3e-f2858f5e6e3b/0027641161_10.jpg?format=500w 500w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/b01d1d03-5c5a-45a4-ac3e-f2858f5e6e3b/0027641161_10.jpg?format=750w 750w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/b01d1d03-5c5a-45a4-ac3e-f2858f5e6e3b/0027641161_10.jpg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/b01d1d03-5c5a-45a4-ac3e-f2858f5e6e3b/0027641161_10.jpg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/b01d1d03-5c5a-45a4-ac3e-f2858f5e6e3b/0027641161_10.jpg?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n            </div>\n          </div>\n        \n          \n        \n\n        \n      \n        </figure>\n      \n\n    </div>\n  \n\n\n  \n\n\n</div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-fb87cfbfed8710d4ab49\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\"><strong>Angusraze</strong> is a musician currently based in Kent, UK. His work focuses on primality and emotive extremity through the lens of a large, multimedia narrative.<br><a href=\"https://angusraze.bandcamp.com/\">https://angusraze.bandcamp.com/</a> <br><br><em>After a sustained foray into deepest, darkest Kent, Brigantia’s prodigal son ANGUSRAZE returned to northern climes in the spring of 2026 to continue wreaking havoc on artistic conservatism and social norms. &nbsp;</em></p><p class=\"\" style=\"white-space:pre-wrap;\"><em>Deviating from the bloodied footsteps of his Hull forbears COUM Transmissions, ANGUSRAZE comforts the disturbed and disturbs the comfortable in equal measure. With a shapeshifting intelligence reminiscent of Björk and a pop theatricality akin to Kate Bush, his multimedia practice conjures an extradimensional realm less white-spore-ridden than The Upside Down and blacker than The Black Lodge.&nbsp;</em></p><p class=\"\" style=\"white-space:pre-wrap;\"><em>Rejecting absolutely the high art versus lowbrow dichotomy, ANGUSRAZE’s latest album would have been a welcome thorn in Adorno’s well-tailored brogue, had the bourgeois musicologist lived to contend with PROTO GUILLOTINE HYPER IMPACT.&nbsp;</em></p><p class=\"\" style=\"white-space:pre-wrap;\"><em>If you want a picture of the future, imagine a polymath with a budget vocal mic and a Samurai sword chopping up a nuclear-powered server bank – forever.</em></p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-horizontalrule horizontalrule-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.horizontalrule/fd311378-f51a-49e8-aa21-5543ebe3b17e_109/website.components.horizontalrule.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.horizontalrule/fd311378-f51a-49e8-aa21-5543ebe3b17e_109/website.components.horizontalrule.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.horizontalrule\" data-sqsp-block=\"line\" data-website-component-id=\"yui_3_17_2_1_1781607122873_69037\" id=\"block-yui_3_17_2_1_1781607122873_69037\"><div class=\"sqs-block-content\"><hr />\n</div></div><div class=\"sqs-block image-block sqs-block-image\" data-block-type=\"5\" data-sqsp-block=\"image-classic\" id=\"block-yui_3_17_2_1_1781607122873_69871\"><div class=\"sqs-block-content\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n\n    \n  \n    <div\n        class=\"\n          image-block-outer-wrapper\n          layout-caption-below\n          design-layout-inline\n          combination-animation-none\n          individual-animation-none\n          individual-text-animation-none\n        \"\n        data-test=\"image-block-inline-outer-wrapper\"\n        data-sqsp-image-classic-block-layout=\"inline\"\n    >\n\n      \n\n      \n        <figure\n            class=\"\n              sqs-block-image-figure\n              intrinsic\n            \"\n            style=\"max-width:1140px;\"\n        >\n          \n        \n        \n\n        \n          \n            \n          <div\n              \n              \n              class=\"image-block-wrapper\"\n              data-animation-role=\"image\"\n              \n  \n\n          >\n            <div data-sqsp-image-classic-block-image-container class=\"sqs-image-shape-container-element\n              \n          \n        \n              has-aspect-ratio\n            \" style=\"\n                position: relative;\n                \n                  padding-bottom:120.877197265625%;\n                \n                overflow: hidden;-webkit-mask-image: -webkit-radial-gradient(white, black);\n              \"\n              >\n                \n                \n                \n                \n                \n                \n                \n                <img data-stretch=\"false\" data-src=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/2675aa53-0445-4dee-9030-2051d1f4ecb7/IMG_0544.jpg\" data-image=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/2675aa53-0445-4dee-9030-2051d1f4ecb7/IMG_0544.jpg\" data-image-dimensions=\"1140x1378\" data-image-focal-point=\"0.5,0.5\" alt=\"\" data-load=\"false\" elementtiming=\"system-image-block\" data-sqsp-image-classic-block-image src=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/2675aa53-0445-4dee-9030-2051d1f4ecb7/IMG_0544.jpg\" width=\"1140\" height=\"1378\" alt=\"\" sizes=\"(max-width: 640px) 100vw, (max-width: 767px) 100vw, 100vw\" style=\"display:block;object-fit: cover; width: 100%; height: 100%; object-position: 50% 50%\" onload=\"this.classList.add(&quot;loaded&quot;)\" srcset=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/2675aa53-0445-4dee-9030-2051d1f4ecb7/IMG_0544.jpg?format=100w 100w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/2675aa53-0445-4dee-9030-2051d1f4ecb7/IMG_0544.jpg?format=300w 300w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/2675aa53-0445-4dee-9030-2051d1f4ecb7/IMG_0544.jpg?format=500w 500w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/2675aa53-0445-4dee-9030-2051d1f4ecb7/IMG_0544.jpg?format=750w 750w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/2675aa53-0445-4dee-9030-2051d1f4ecb7/IMG_0544.jpg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/2675aa53-0445-4dee-9030-2051d1f4ecb7/IMG_0544.jpg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/2675aa53-0445-4dee-9030-2051d1f4ecb7/IMG_0544.jpg?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n            </div>\n          </div>\n        \n          \n        \n\n        \n      \n        </figure>\n      \n\n    </div>\n  \n\n\n  \n\n\n</div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-yui_3_17_2_1_1781607122873_69428\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\"><strong>Wounder</strong> is an alias of the musician, producer and performer <strong>Sonny Holland</strong>. Raised on UK bass music, his music combines electronic dance music influences with extreme metal. Big bass, fucking screaming, guitars and shit.</p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-horizontalrule horizontalrule-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.horizontalrule/fd311378-f51a-49e8-aa21-5543ebe3b17e_109/website.components.horizontalrule.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.horizontalrule/fd311378-f51a-49e8-aa21-5543ebe3b17e_109/website.components.horizontalrule.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.horizontalrule\" data-sqsp-block=\"line\" data-website-component-id=\"c2969054ba16456d2dd6\" id=\"block-c2969054ba16456d2dd6\"><div cl