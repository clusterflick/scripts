data-sqsp-image-classic-block-image src=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/3c3fba4a-1f9c-4b9a-8d25-669a95d8fece/getimage_664d54c3-a3b0-44ce-bcdb-e32e336f6bbb.jpg\" width=\"540\" height=\"720\" alt=\"\" sizes=\"(max-width: 640px) 100vw, (max-width: 767px) 100vw, 100vw\" style=\"display:block;object-fit: cover; width: 100%; height: 100%; object-position: 50% 50%\" onload=\"this.classList.add(&quot;loaded&quot;)\" srcset=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/3c3fba4a-1f9c-4b9a-8d25-669a95d8fece/getimage_664d54c3-a3b0-44ce-bcdb-e32e336f6bbb.jpg?format=100w 100w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/3c3fba4a-1f9c-4b9a-8d25-669a95d8fece/getimage_664d54c3-a3b0-44ce-bcdb-e32e336f6bbb.jpg?format=300w 300w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/3c3fba4a-1f9c-4b9a-8d25-669a95d8fece/getimage_664d54c3-a3b0-44ce-bcdb-e32e336f6bbb.jpg?format=500w 500w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/3c3fba4a-1f9c-4b9a-8d25-669a95d8fece/getimage_664d54c3-a3b0-44ce-bcdb-e32e336f6bbb.jpg?format=750w 750w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/3c3fba4a-1f9c-4b9a-8d25-669a95d8fece/getimage_664d54c3-a3b0-44ce-bcdb-e32e336f6bbb.jpg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/3c3fba4a-1f9c-4b9a-8d25-669a95d8fece/getimage_664d54c3-a3b0-44ce-bcdb-e32e336f6bbb.jpg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/3c3fba4a-1f9c-4b9a-8d25-669a95d8fece/getimage_664d54c3-a3b0-44ce-bcdb-e32e336f6bbb.jpg?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n            </div>\n          </div>\n        \n          \n        \n\n        \n      \n        </figure>\n      \n\n    </div>\n  \n\n\n  \n\n\n</div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-yui_3_17_2_1_1777454808996_139080\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\"><strong>Jeremy Gilbert  </strong>is Professor of Cultural and Political Theory at the University of East London, and the current editor of the journal <em>New Formations</em>. His most recent publications include <em>Twenty-First-Century Socialism</em> (Polity 2020)&nbsp;and&nbsp;<em>Hegemony Now&nbsp;: How Big Tech and Wall Street Won the World</em>, co-authored with <strong>Alex Williams</strong> (Verso 2022). Jeremy also maintains a lifelong commitment to public education outside the academy, currently hosting <em>Culture, Power, Politics,&nbsp;</em>a &nbsp;regular podcast and series of free open seminars and lectures. He is also a co-host of the popular podcasts&nbsp;<em>Love is the Message</em>&nbsp;and <em>#ACFM.&nbsp;</em><br><a href=\"https://www.jeremygilbert.org/\">https://www.jeremygilbert.org/</a> </p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-horizontalrule horizontalrule-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.horizontalrule/fd311378-f51a-49e8-aa21-5543ebe3b17e_109/website.components.horizontalrule.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.horizontalrule/fd311378-f51a-49e8-aa21-5543ebe3b17e_109/website.components.horizontalrule.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.horizontalrule\" data-sqsp-block=\"line\" data-website-component-id=\"yui_3_17_2_1_1777454808996_139467\" id=\"block-yui_3_17_2_1_1777454808996_139467\"><div class=\"sqs-block-content\"><hr />\n</div></div><div class=\"sqs-block image-b