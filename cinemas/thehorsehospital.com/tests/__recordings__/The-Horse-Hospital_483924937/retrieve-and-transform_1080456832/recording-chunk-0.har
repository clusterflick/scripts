qs\">\n\n\n                  \n                \n              </a>\n              \n\n            </div>\n            <div data-nc-container=\"bottom-right\">\n\n              <nav class=\"Header-nav Header-nav--secondary\" data-nc-element=\"secondary-nav\" data-content-field=\"navigation\">\n                \n  <div class=\"Header-nav-inner\">\n    <a href=\"/about\" class=\"Header-nav-item\" data-test=\"template-nav\">About</a><a href=\"/venue-information\" class=\"Header-nav-item\" data-test=\"template-nav\">Venue Info</a><a href=\"/new-page-search\" class=\"Header-nav-item\" data-test=\"template-nav\">Search</a>\n  </div>\n\n              </nav>\n\n            </div>\n          </div>\n        </header>\n\n        <div class=\"Content-outer\">\n          \n\n          <main class=\"Main Main--events-item\" >\n            \n              <section class=\"Main-content\" data-content-field=\"main-content\">\n                <div class=\"sqs-events-collection-item\">\n\n  <a href=\"/events\" class=\"eventitem-backlink\">Back to All Events</a>\n\n  \n  <article class=\"eventitem \" id=\"article-695ce929fb73ba4f27c2ee8d\" data-item-id=\"695ce929fb73ba4f27c2ee8d\">\n\n    <div class=\"eventitem-column-meta\">\n\n      <h1 class=\"eventitem-title\">Tribulation 99 | Tellurian Drama | TS2</h1>\n\n      <ul class=\"eventitem-meta event-meta event-meta-date-time-container\">\n\n        \n\n        <li class=\"eventitem-meta-item eventitem-meta-date event-meta-item\">\n          <time class=\"event-date\" datetime=\"2026-02-04\">Wednesday 4 February 2026</time>\n        </li>\n\n        <li class=\"eventitem-meta-item eventitem-meta-time event-meta-item\">\n          <span class=\"event-time-12hr\">\n            <time class=\"event-time-12hr-start\" datetime=\"2026-02-04\">7:00 pm</time>\n            <span class=\"event-datetime-divider\"></span>\n            <time class=\"event-time-12hr-end\" datetime=\"2026-02-04\">10:00 pm</time>\n          </span>\n          <span class=\"event-time-24hr\">\n            <time class=\"event-time-24hr-start\" datetime=\"2026-02-04\">19:00</time>\n            <span class=\"event-datetime-divider\"></span>\n            <time class=\"event-time-12hr-end\" datetime=\"2026-02-04\">22:00</time>\n          </span>\n        </li>\n\n        \n\n      </ul>\n\n      \n        \n      \n\n      <ul class=\"eventitem-meta event-meta event-meta-addtocalendar-container\">\n        <li class=\"eventitem-meta-item eventitem-meta-export event-meta-item\">\n          <a href=\"http://www.google.com/calendar/event?action=TEMPLATE&text=Tribulation%2099%20%7C%20Tellurian%20Drama%20%7C%20TS2&dates=20260204T190000Z/20260204T220000Z\" class=\"eventitem-meta-export-google\">Google Calendar</a>\n          <span class=\"eventitem-meta-export-divider\"></span>\n          <a href=\"/events/tribulation-99?format=ical\" class=\"eventitem-meta-export-ical\">ICS</a>\n        </li>\n      </ul>\n\n      \n      \n\n    </div>\n\n    <div class=\"eventitem-column-content\">\n\n      <div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" data-updated-on=\"1767696717209\" id=\"item-695ce929fb73ba4f27c2ee8d\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-14b7b8fdac6f5cdd36f1\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <h3 style=\"white-space:pre-wrap;\">A screening of three films exploring the metaphysics of electromagnetic communication, psyops, and conspiracy. <strong>Craig Baldwin</strong>’s <em>Tribulation 99: Alien Anomalies Under America </em>(1992), <strong>Riar Rizaldi</strong>’s <em>Tellurian Drama </em>(2020), and <strong>Signal Warfare Research Unit</strong>’s <em>TS2</em>. </h3>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div><div class=\"sqs-block image-block sqs-blo