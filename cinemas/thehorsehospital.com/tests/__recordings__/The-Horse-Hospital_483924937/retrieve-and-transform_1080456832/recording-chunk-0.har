              </a>\n              \n\n            </div>\n            <div data-nc-container=\"bottom-right\">\n\n              <nav class=\"Header-nav Header-nav--secondary\" data-nc-element=\"secondary-nav\" data-content-field=\"navigation\">\n                \n  <div class=\"Header-nav-inner\">\n    <a href=\"/about\" class=\"Header-nav-item\" data-test=\"template-nav\">About</a><a href=\"/venue-information\" class=\"Header-nav-item\" data-test=\"template-nav\">Venue Info</a><a href=\"/new-page-search\" class=\"Header-nav-item\" data-test=\"template-nav\">Search</a>\n  </div>\n\n              </nav>\n\n            </div>\n          </div>\n        </header>\n\n        <div class=\"Content-outer\">\n          \n\n          <main class=\"Main Main--events-item\" >\n            \n              <section class=\"Main-content\" data-content-field=\"main-content\">\n                <div class=\"sqs-events-collection-item\">\n\n  <a href=\"/events\" class=\"eventitem-backlink\">Back to All Events</a>\n\n  \n  <article class=\"eventitem \" id=\"article-6a2ac1bd1e5e8163ced90afb\" data-item-id=\"6a2ac1bd1e5e8163ced90afb\">\n\n    <div class=\"eventitem-column-meta\">\n\n      <h1 class=\"eventitem-title\"> Vive Le Punk (1993) Screening</h1>\n\n      <ul class=\"eventitem-meta event-meta event-meta-date-time-container\">\n\n        \n\n        <li class=\"eventitem-meta-item eventitem-meta-date event-meta-item\">\n          <time class=\"event-date\" datetime=\"2026-07-16\">Thursday 16 July 2026</time>\n        </li>\n\n        <li class=\"eventitem-meta-item eventitem-meta-time event-meta-item\">\n          <span class=\"event-time-12hr\">\n            <time class=\"event-time-12hr-start\" datetime=\"2026-07-16\">7:00 pm</time>\n            <span class=\"event-datetime-divider\"></span>\n            <time class=\"event-time-12hr-end\" datetime=\"2026-07-16\">10:30 pm</time>\n          </span>\n          <span class=\"event-time-24hr\">\n            <time class=\"event-time-24hr-start\" datetime=\"2026-07-16\">19:00</time>\n            <span class=\"event-datetime-divider\"></span>\n            <time class=\"event-time-12hr-end\" datetime=\"2026-07-16\">22:30</time>\n          </span>\n        </li>\n\n        \n\n      </ul>\n\n      \n        \n      \n\n      <ul class=\"eventitem-meta event-meta event-meta-addtocalendar-container\">\n        <li class=\"eventitem-meta-item eventitem-meta-export event-meta-item\">\n          <a href=\"http://www.google.com/calendar/event?action=TEMPLATE&text=%20Vive%20Le%20Punk%20%281993%29%20Screening&dates=20260716T180000Z/20260716T213000Z\" class=\"eventitem-meta-export-google\">Google Calendar</a>\n          <span class=\"eventitem-meta-export-divider\"></span>\n          <a href=\"/events/vive-le-punk-screening?format=ical\" class=\"eventitem-meta-export-ical\">ICS</a>\n        </li>\n      </ul>\n\n      \n      \n\n    </div>\n\n    <div class=\"eventitem-column-content\">\n\n      <div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" data-updated-on=\"1781187056054\" id=\"item-6a2ac1bd1e5e8163ced90afb\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-b49ddc06997630d2a707\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <h3 style=\"white-space:pre-wrap;\">A rare screening of <strong><em>Vive Le Punk</em></strong> [1993], an exclusive documentary made by <strong>Roger K Burton</strong>, featuring <strong>Malcolm McLaren &amp; Vivienne Westwood</strong>. The couple were captured on film at <strong>the Horse Hospital </strong>on the eve of our very first exhibition, <strong><em>Vive Le Punk</em>.&nbsp;</strong>We will also be displaying select pieces featured in the original exhibition<strong>.</strong></h3>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</