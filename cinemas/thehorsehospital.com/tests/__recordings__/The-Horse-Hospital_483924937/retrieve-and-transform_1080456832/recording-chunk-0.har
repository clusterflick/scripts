          "content": {
            "mimeType": "text/html;charset=utf-8",
            "text": "<!doctype html>\n<html xmlns:og=\"http://opengraphprotocol.org/schema/\" xmlns:fb=\"http://www.facebook.com/2008/fbml\" lang=\"en-GB\"  >\n  <head>\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\">\n    <meta name=\"viewport\" content=\"initial-scale=1\">\n\n    <!-- This is Squarespace. --><!-- thehorsehospital -->\n<base href=\"\">\n<meta charset=\"utf-8\" />\n<title> Vive Le Punk (1993) Screening &mdash; The Horse Hospital</title>\n<meta http-equiv=\"Accept-CH\" content=\"Sec-CH-UA-Platform-Version, Sec-CH-UA-Model\" /><link rel=\"icon\" type=\"image/x-icon\" href=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/1519382876464-OXLO2UC8MZ8UW3F8TS1A/favicon.ico?format=100w\"/>\n<link rel=\"canonical\" href=\"https://www.thehorsehospital.com/events/vive-le-punk-screening\"/>\n<meta property=\"og:site_name\" content=\"The Horse Hospital\"/>\n<meta property=\"og:title\" content=\" Vive Le Punk (1993) Screening &mdash; The Horse Hospital\"/>\n<meta property=\"og:latitude\" content=\"40.7207559\"/>\n<meta property=\"og:longitude\" content=\"-74.00076130000002\"/>\n<meta property=\"og:locality\" content=\"\"/>\n<meta property=\"og:url\" content=\"https://www.thehorsehospital.com/events/vive-le-punk-screening\"/>\n<meta property=\"og:type\" content=\"website\"/>\n<meta property=\"og:description\" content=\"A rare screening of   Vive Le Punk   [1993], an exclusive documentary made by  Roger K Burton , featuring  Malcolm McLaren &amp;amp; Vivienne Westwood . The couple were captured on film at  the Horse Hospital  on the eve of our very first exhibition,   Vive Le Punk .&amp;nbsp; We will also be displa\"/>\n<meta property=\"og:image\" content=\"http://static1.squarespace.com/static/5a65df9e2aeba5d8b0fd547c/5a65e00253450a34f40b32e4/6a2ac1bd1e5e8163ced90afb/1781187490506/horse_hospital_vive_le_punk_poster_v2.001.jpeg?format=1500w\"/>\n<meta property=\"og:image:width\" content=\"1500\"/>\n<meta property=\"og:im