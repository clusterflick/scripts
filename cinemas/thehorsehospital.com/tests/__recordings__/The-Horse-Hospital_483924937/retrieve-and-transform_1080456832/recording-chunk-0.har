83089233-0031RRGOKUP4ULH4CP24/Logo-Web.png?format=750w 750w, //images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/1519383089233-0031RRGOKUP4ULH4CP24/Logo-Web.png?format=1000w 1000w, //images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/1519383089233-0031RRGOKUP4ULH4CP24/Logo-Web.png?format=1500w 1500w, //images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/1519383089233-0031RRGOKUP4ULH4CP24/Logo-Web.png?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n\n                  \n                \n              </a>\n              \n\n            </div>\n            <div data-nc-container=\"bottom-right\">\n\n              <nav class=\"Header-nav Header-nav--secondary\" data-nc-element=\"secondary-nav\" data-content-field=\"navigation\">\n                \n  <div class=\"Header-nav-inner\">\n    <a href=\"/about\" class=\"Header-nav-item\" data-test=\"template-nav\">About</a><a href=\"/venue-information\" class=\"Header-nav-item\" data-test=\"template-nav\">Venue Info</a><a href=\"/new-page-search\" class=\"Header-nav-item\" data-test=\"template-nav\">Search</a>\n  </div>\n\n              </nav>\n\n            </div>\n          </div>\n        </header>\n\n        <div class=\"Content-outer\">\n          \n            \n              <section class=\"Intro\" data-parallax-original-element data-parallax-id=\"5a65e00253450a34f40b32e4\">\n  <div class=\"sqs-layout sqs-grid-12 columns-12 Intro-content empty\" data-layout-label=\"Intro\" data-type=\"block-field\" id=\"5a65e00253450a34f40b32e4_intro\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"></div></div></div>\n  \n    \n  \n</section>\n            \n          \n\n          <main class=\"Main Main--events-list\" >\n            \n              <section class=\"Main-content\" data-content-field=\"main-content\">\n                <!-- Event List View -->\n\n  <div class=\"sqs-events-collection-list\">\n\n    <!-- Upcoming Events -->\n\n    <div class=\"eventlist eventlist--upcoming\">\n\n    \n    <div class=\"eventlist-filter\">\n      \n        \n          Filtering by: Film\n        \n      \n    </div>\n    \n\n    \n\n      <article class=\"eventlist-event eventlist-event--upcoming eventlist-event--hasimg eventlist-hasimg\">\n\n        <a href=\"/events/tribulation-99\" class=\"eventlist-column-thumbnail content-fill\"><img data-src=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c3671d9d-a52c-412b-a3df-1dfffdb1738d/Screenshot+2026-01-07+at+11.03.15.png\" data-image=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c3671d9d-a52c-412b-a3df-1dfffdb1738d/Screenshot+2026-01-07+at+11.03.15.png\" data-image-dimensions=\"2488x1883\" data-image-focal-point=\"0.5,0.5\" alt=\"Tribulation 99 | Tellurian Drama | TS2\"  class=\"eventlist-thumbnail\" data-load=\"false\"></a>\n\n        <a href=\"/events/tribulation-99\" class=\"eventlist-column-date\">\n\n          <div class=\"eventlist-datetag\">\n\n            <div class=\"eventlist-datetag-inner\">\n\n              <div class=\"eventlist-datetag-startdate eventlist-datetag-startdate--month\">Feb</div>\n              <div class=\"eventlist-datetag-startdate eventlist-datetag-startdate--day\">4</div>\n\n              \n              <div class=\"eventlist-datetag-time\"><span class=\"event-time-12hr\">7:00 pm</span><span class=\"event-time-24hr\">19:00</span></div>\n\n              \n\n              <div class=\"eventlist-datetag-status\"></div>\n\n            </div>\n\n          </div>\n\n        </a>\n\n        <div class=\"eventlist-column-info\">\n\n          \n          <div class=\"eventlist-cats\">\n            <a href=\"?category=Upcoming\">Upcoming</a>, <a href=\"?category=Film\">Film</a>\n          </div>\n          \n\n          <h1 class=\"eventlist-title\"><a href=\"/events/tribulation-99\" class=\"eventlist-title-link\">Tribulation 99 | Tellurian Drama | TS2</a></h1>\n\n          <ul class=\"eventlist-meta event-meta\">\n\n            \n\n            <li class=\"eventlist-meta-item eventlist-meta-date event-meta-item\">\n              <time class=\"event-date\" datetime=\"2026-02-04\">Wednesday 4 February 2026</time>\n            </li>\n\n            <li class=\"eventlist-meta-item eventlist-meta-time event-meta-item\">\n              <span class=\"event-time-12hr\">\n                <time class=\"event-time-12hr-start\" datetime=\"2026-02-04\">7:00 pm</time>\n                <span class=\"event-datetime-divider\"></span>\n                <time class=\"event-time-12hr-end\" datetime=\"2026-02-04\">10:00 pm</time>\n              </span>\n              <span class=\"event-time-24hr\">\n                <time class=\"event-time-24hr-start\" datetime=\"2026-02-04\">19:00</time>\n                <span class=\"event-datetime-divider\"></span>\n                <time class=\"event-time-12hr-end\" datetime=\"2026-02-04\">22:00</time>\n              </span>\n            </li>\n\n            \n\n            \n              \n            \n\n            <li class=\"eventlist-meta-item eventlist-meta-export event-meta-item\">\n              <a href=\"http://www.google.com/calendar/event?action=TEMPLATE&text=Tribulation%2099%20%7C%20Tellurian%20Drama%20%7C%20TS2&dates=20260204T190000Z/20260204T220000Z\" class=\"eventlist-meta-export-google\">Google Calendar</a>\n              <span class=\"eventlist-meta-export-divider\"></span>\n              <a href=\"/events/tribulation-99?format=ical\" class=\"eventlist-meta-export-ical\">ICS</a>\n            </li>\n\n          </ul>\n\n          \n          <div class=\"eventlist-excerpt\"><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">A screening of three films exploring the metaphysics of electromagnetic communication, psyops, and conspiracy. <strong>Craig Baldwin</strong>’s <em>Tribulation 99: Alien Anomalies Under America </em>(1992), <strong>Riar Rizaldi</strong>’s <em>Tellurian Drama </em>(2020), and <strong>Signal Warfare Research Unit</strong>’s <em>TS2</em>. </p></div>\n          \n\n          <a href=\"/events/tribulation-99\" class=\"eventlist-button sqs-button-element--primary\">\n            View Event &#8594;\n          </a>\n\n          <div class=\"eventlist-actions\">\n  <span class=\"sqs-simple-like\" data-item-id=\"695ce929fb73ba4f27c2ee8d\" data-like-count=\"0\">\n    <span class=\"like-icon\"></span>\n    <span class=\"like-count\"></span>\n  </span>\n<span class=\"squarespace-social-buttons inline-style\" data-system-data-id=\"c3671d9d-a52c-412b-a3df-1dfffdb1738d\" data-asset-url=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c3671d9d-a52c-412b-a3df-1dfffdb1738d/Screenshot+2026-01-07+at+11.03.15.png\" data-record-type=\"12\" data-full-url=\"/events/tribulation-99\" data-title=\"Tribulation 99 | Tellurian Drama | TS2\"></span></div>\n\n        </div>\n\n        <div class=\"clear\"></div>\n\n      </article>\n\n    \n\n    </div>\n\n\n    <!-- Past Events -->\n\n    \n    <div class=\"eventlist eventlist--past\">\n    <hr class=\"eventlist-past-upcoming-divider\">\n    \n\n    \n\n      <article class=\"eventlist-event eventlist-event--past eventlist-event--hasimg eventlist-hasimg\">\n\n        <a href=\"/events/amurmur\" class=\"eventlist-column-thumbnail content-fill\"><img data-src=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/1762790954035-M17QY56FZ83KU6R8V7BH/Amurmur+event-3+%281%29.jpg\" data-image=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/1762790954035-M17QY56FZ83KU6R8V7BH/Amurmur+event-3+%281%29.jpg\" data-image-dimensions=\"1414x2000\" data-image-focal-point=\"0.5,0.5\" alt=\"Amurmur: Unquieten Memory\"  class=\"eventlist-thumbnail\" data-load=\"false\"></a>\n\n        <a href=\"/events/amurmur\" class=\"eventlist-column-date\">\n\n          <div class=\"eventlist-datetag\">\n\n            <div class=\"eventlist-datetag-inner\">\n\n              <div class=\"eventlist-datetag-startdate eventlist-datetag-startdate--month\">Dec</div>\n              <div class=\"eventlist-datetag-startdate eventlist-datetag-startdate--day\">18</div>\n\n              \n              <div class=\"eventlist-datetag-time\"><span class=\"event-time-12hr\">7:30 pm</span><span class=\"event-time-24hr\">19:30</span></div>\n\n              \n\n              <div class=\"eventlist-datetag-status\"></div>\n\n            </div>\n\n          </div>\n\n        </a>\n\n        <div class=\"eventlist-column-info\">\n\n          \n          <div class=\"eventlist-cats\">\n            <a href=\"?category=Upcoming\">Upcoming</a>, <a href=\"?category=Film\">Film</a>, <a href=\"?category=Talk\">Talk</a>\n          </div>\n          \n\n          <h1 class=\"eventlist-title\"><a href=\"/events/amurmur\" class=\"eventlist-title-link\">Amurmur: Unquieten Memory</a></h1>\n\n          <ul class=\"eventlist-meta event-meta\">\n\n            \n\n            <li class=\"eventlist-meta-item eventlist-meta-date event-meta-item\">\n              <time class=\"event-date\" datetime=\"2025-12-18\">Thursday 18 December 2025</time>\n            </li>\n\n            <li class=\"eventlist-meta-item eventlist-meta-time event-meta-item\">\n              <span class=\"event-time-12hr\">\n                <time class=\"event-time-12hr-start\" datetime=\"2025-12-18\">7:30 pm</time>\n                <span class=\"event-datetime-divider\"></span>\n                <time class=\"event-time-12hr-end\" datetime=\"2025-12-18\">10:30 pm</time>\n              </span>\n              <span class=\"event-time-24hr\">\n                <time class=\"event-time-24hr-start\" datetime=\"2025-12-18\">19:30</time>\n                <span class=\"event-datetime-divider\"></span>\n                <time class=\"event-time-12hr-end\" datetime=\"2025-12-18\">22:30</time>\n              </span>\n            </li>\n\n            \n\n            \n              \n            \n\n            <li class=\"eventlist-meta-item eventlist-meta-export event-meta-item\">\n              <a href=\"http://www.google.com/calendar/event?action=TEMPLATE&text=Amurmur%3A%20Unquieten%20Memory&dates=20251218T193000Z/20251218T223000Z\" class=\"eventlist-meta-export-google\">Google Calendar</a>\n              <span class=\"eventlist-meta-export-divider\"></span>\n              <a href=\"/events/amurmur?format=ical\" class=\"eventlist-meta-export-ical\">ICS</a>\n            </li>\n\n          </ul>\n\n          \n          <div class=\"eventlist-excerpt\"><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>Amurmur</strong> is a platform celebrating memory, enshrinement and archives. For our first event, through readings and budding projects, a selection of artists share their impassioned ways of engaging with the past. Followed by a screening of a film by <strong>Ines Barquet</strong> and <strong>Ximena Prieto</strong>, based on an idea by <strong>Alexia Marmara</strong>.</p></div>\n          \n\n          <a href=\"/events/amurmur\" class=\"eventlist-button sqs-editable-button sqs-button-element--primary\">\n            View Event &#8594;\n          </a>\n\n          <div class=\"eventlist-actions\">\n  <span class=\"sqs-simple-like\" data-item-id=\"69120d7a67037d3f57f2d200\" data-like-count=\"0\">\n    <span class=\"like-icon\"></span>\n    <span class=\"like-count\"></span>\n  </span>\n<span class=\"squarespace-social-buttons inline-style\" data-system-data-id=\"1762790954035-M17QY56FZ83KU6R8V7BH\" data-asset-url=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/1762790954035-M17QY56FZ83KU6R8V7BH/Amurmur+event-3+%281%29.jpg\" data-record-type=\"12\" data-full-url=\"/events/amurmur\" data-title=\"Amurmur: Unquieten Memory\"></span></div>\n\n        </div>\n\n        <div class=\"clear\"></div>\n\n      </article>\n\n    \n\n      <article class=\"eventlist-event eventlist-event--past eventlist-event--hasimg eventlist-hasimg\">\n\n        <a href=\"/eve