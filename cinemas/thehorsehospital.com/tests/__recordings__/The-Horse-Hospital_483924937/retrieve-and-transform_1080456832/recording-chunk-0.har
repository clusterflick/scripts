cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/187ae8db-75e9-4e7e-9836-ccb7255b0d8a/IMG_0544.jpg\" data-image-dimensions=\"1140x1378\" data-image-focal-point=\"0.5,0.5\" alt=\"\" data-load=\"false\" elementtiming=\"system-image-block\" data-sqsp-image-classic-block-image src=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/187ae8db-75e9-4e7e-9836-ccb7255b0d8a/IMG_0544.jpg\" width=\"1140\" height=\"1378\" alt=\"\" sizes=\"(max-width: 640px) 100vw, (max-width: 767px) 100vw, 100vw\" style=\"display:block;object-fit: cover; width: 100%; height: 100%; object-position: 50% 50%\" onload=\"this.classList.add(&quot;loaded&quot;)\" srcset=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/187ae8db-75e9-4e7e-9836-ccb7255b0d8a/IMG_0544.jpg?format=100w 100w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/187ae8db-75e9-4e7e-9836-ccb7255b0d8a/IMG_0544.jpg?format=300w 300w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/187ae8db-75e9-4e7e-9836-ccb7255b0d8a/IMG_0544.jpg?format=500w 500w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/187ae8db-75e9-4e7e-9836-ccb7255b0d8a/IMG_0544.jpg?format=750w 750w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/187ae8db-75e9-4e7e-9836-ccb7255b0d8a/IMG_0544.jpg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/187ae8db-75e9-4e7e-9836-ccb7255b0d8a/IMG_0544.jpg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/187ae8db-75e9-4e7e-9836-ccb7255b0d8a/IMG_0544.jpg?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n            </div>\n          </div>\n        \n          \n        \n\n        \n      \n        </figure>\n      \n\n    </div>\n  \n\n\n  \n\n\n</div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-yui_3_17_2_1_1781607122873_54292\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\"><strong>Wounder</strong> is an alias of the musician, producer and performer <strong>Sonny Holland</strong>. Raised on UK bass music, his music combines electronic dance music influences with extreme metal. Big bass, fucking screaming, guitars and shit.</p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-horizontalrule horizontalrule-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.horizontalrule/fd311378-f51a-49e8-aa21-5543ebe3b17e_109/website.components.horizontalrule.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.horizontalrule/fd311378-f51a-49e8-aa21-5543ebe3b17e_109/website.components.horizontalrule.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.horizontalrule\" data-sqsp-block=\"line\" data-website-component-id=\"639a10c110bc4ec66b8b\" id=\"block-639a10c110bc4ec66b8b\"><div class=\"sqs-block-content\"><hr />\n</div></div></div></div></div>\n\n      \n      <div class=\"eventitem-content-footer\">\n\n        \n\n        \n          <ul class=\"eventitem-meta event-meta event-meta-cats-tags-container\">\n            <li class=\"eventitem-meta-item eventitem-meta-cats event-meta-item\">Posted in <a href=\"/events?category=Upcoming\">Upcoming</a>, <a href=\"/events?category=Film\">Film</a>, <a href=\"/events?category=Music\">Music</a>, <a href=\"/events?category=Talk\">Talk</a>, <a href=\"/events?category=Sound\">Sound</a>, <a href=\"/events?category=Theatre\">Theatre</a>, <a href=\"/events?category=Performance\">Performance</a>, <a href=\"/events?category=Improvisation\">Improvisation</a>, <a href