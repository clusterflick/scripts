ayout-inline\n          combination-animation-none\n          individual-animation-none\n          individual-text-animation-none\n        \"\n        data-test=\"image-block-inline-outer-wrapper\"\n    >\n\n      \n\n      \n        <figure\n            class=\"\n              sqs-block-image-figure\n              intrinsic\n            \"\n            style=\"max-width:2488px;\"\n        >\n          \n        \n        \n\n        \n          \n            \n          <div\n              \n              \n              class=\"image-block-wrapper\"\n              data-animation-role=\"image\"\n              \n  \n\n          >\n            <div class=\"sqs-image-shape-container-element\n              \n          \n        \n              has-aspect-ratio\n            \" style=\"\n                position: relative;\n                \n                  padding-bottom:75.68328094482422%;\n                \n                overflow: hidden;-webkit-mask-image: -webkit-radial-gradient(white, black);\n              \"\n              >\n                \n                \n                \n                \n                \n                \n                \n                <img data-stretch=\"false\" data-src=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c3671d9d-a52c-412b-a3df-1dfffdb1738d/Screenshot+2026-01-07+at+11.03.15.png\" data-image=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c3671d9d-a52c-412b-a3df-1dfffdb1738d/Screenshot+2026-01-07+at+11.03.15.png\" data-image-dimensions=\"2488x1883\" data-image-focal-point=\"0.5,0.5\" alt=\"\" data-load=\"false\" elementtiming=\"system-image-block\"  src=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c3671d9d-a52c-412b-a3df-1dfffdb1738d/Screenshot+2026-01-07+at+11.03.15.png\" width=\"2488\" height=\"1883\" alt=\"\" sizes=\"(max-width: 640px) 100vw, (max-width: 767px) 100vw, 100vw\" style=\"display:block;object-fit: cover; width: 100%; height: 100%; object-position: 50% 50%\" onload=\"this.classList.add(&quot;loaded&quot;)\" srcset=\"https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c3671d9d-a52c-412b-a3df-1dfffdb1738d/Screenshot+2026-01-07+at+11.03.15.png?format=100w 100w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c3671d9d-a52c-412b-a3df-1dfffdb1738d/Screenshot+2026-01-07+at+11.03.15.png?format=300w 300w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c3671d9d-a52c-412b-a3df-1dfffdb1738d/Screenshot+2026-01-07+at+11.03.15.png?format=500w 500w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c3671d9d-a52c-412b-a3df-1dfffdb1738d/Screenshot+2026-01-07+at+11.03.15.png?format=750w 750w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c3671d9d-a52c-412b-a3df-1dfffdb1738d/Screenshot+2026-01-07+at+11.03.15.png?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c3671d9d-a52c-412b-a3df-1dfffdb1738d/Screenshot+2026-01-07+at+11.03.15.png?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/5a65df9e2aeba5d8b0fd547c/c3671d9d-a52c-412b-a3df-1dfffdb1738d/Screenshot+2026-01-07+at+11.03.15.png?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n            </div>\n          </div>\n        \n          \n        \n\n        \n      \n        </figure>\n      \n\n    </div>\n  \n\n\n  \n\n\n</div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-yui_3_17_2_1_1767696670151_87216\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\"><em>Tribulation 99: Alien Anomalies Under America</em><strong> </strong>presents a factual chronicle of US intervention in Latin America in the form of the ultimate conspiracy theory, combining covert action, environmental catastrophe, space aliens, cattle mutilations, killer bees, religious prophecy, doomsday diatribes, and just about every other crackpot theory broadcast through the dentures of the modern&nbsp;paranoiac.</p><blockquote><p class=\"\" style=\"white-space:pre-wrap;\">One of the most complex North American found footage films produced… <em>Tribulation 99 </em>uses an astonishingly heterogeneous collection of images. Composed entirely of found footage the film culls its images both from ostensibly legitimate institutional sources of knowledge production (e.g., government documentaries and documents, newsreels, instructional and science films) and from unofficial sources not typically accorded legitimate status (e.g., B movies, science fiction, exploitation films, propaganda, advertising). <br>- Michael Zryd</p></blockquote>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div><div class=\"sqs-block image-block sqs-block-image\" data-block-type=\"5\" id=\"block-yui_3_17_2_1_1767696670151_114773\"><div class=\"sqs-block-content\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n\n    \n  \n    <div\n        class=\"\n          image-block-outer-wrapper\n          layout-caption-below\n          design-layout-inline\n          combination-animation-none\n          individual-animation-none\n          individual-text-animation-none\n        \"\n        data-test=\"image-block-inline-outer-wrapper\"\n    >\n\n      \n\n      \n        <figure\n            class=\"\n              sqs-block-image-figure\n              intrinsic\n            \"\n            style=\"max-width:1920px;\"\n        >\n          \n        \n        \n\n        \n          \n            \n          <div\n              \n              \n              class=\"image-block-wrapper\"\n              data-animation-role=\"image\"\n              \n  \n\n          >\n            <div class=\"sqs-image-shape-container-element\n              \n          \n        \n   