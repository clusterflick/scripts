n\n            <li class=\"eventlist-meta-item eventlist-meta-time event-meta-item\">\n              <span class=\"event-time-12hr\">\n                <time class=\"event-time-12hr-start\" datetime=\"2026-05-21\">7:00 pm</time>\n                <span class=\"event-datetime-divider\"></span>\n                <time class=\"event-time-12hr-end\" datetime=\"2026-05-21\">10:30 pm</time>\n              </span>\n              <span class=\"event-time-24hr\">\n                <time class=\"event-time-24hr-start\" datetime=\"2026-05-21\">19:00</time>\n                <span class=\"event-datetime-divider\"></span>\n                <time class=\"event-time-12hr-end\" datetime=\"2026-05-21\">22:30</time>\n              </span>\n            </li>\n\n            \n\n            \n              \n            \n\n            <li class=\"eventlist-meta-item eventlist-meta-export event-meta-item\">\n              <a href=\"http://www.google.com/calendar/event?action=TEMPLATE&text=DANCE%20NOT%20DANCE%3A%20where%20the%20body%20dissolves%20and%20movement%20persists&dates=20260521T180000Z/20260521T213000Z\" class=\"eventlist-meta-export-google\">Google Calendar</a>\n              <span class=\"eventlist-meta-export-divider\"></span>\n              <a href=\"/events/dance-not-dance?format=ical\" class=\"eventlist-meta-export-ical\">ICS</a>\n            </li>\n\n          </ul>\n\n          \n          <div class=\"eventlist-excerpt\"><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">An evening that moves between embodied rhythm, disembodied choreography, and live improvisation, featuring <strong>The Drum Also Dances</strong> and <strong>Breath Quartet</strong></p></div>\n          \n\n          <a href=\"/events/dance-not-dance\" class=\"eventlist-button sqs-editable-button sqs-button-element--primary\">\n            View Event &#8594;\n          </a>\n\n          <div class=\"eventlist-actions\">\n  <span class=\"sqs-simple-like\" data-item-id=\"69f6912261028254015efeb2