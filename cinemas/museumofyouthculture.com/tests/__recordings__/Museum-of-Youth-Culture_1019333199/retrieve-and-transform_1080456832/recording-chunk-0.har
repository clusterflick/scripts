useumofyouthculture.com/wp-content/uploads/2019/11/MOYC-Blocked-Logo-Black-48x48.png 48w, https://www.museumofyouthculture.com/wp-content/uploads/2019/11/MOYC-Blocked-Logo-Black-560x560.png 560w\" data-sizes=\"auto, (max-width: 2560px) 100vw, 2560px\" />\n\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t</div>\n<div role=\"figure\" class=\"fl-module fl-module-photo fl-photo fl-photo-align-right fl-node-3uritb8w2xl1 fl-visible-mobile\" data-node=\"3uritb8w2xl1\" aria-label=\"Photo\" itemscope itemtype=\"https://schema.org/ImageObject\">\n\t<div class=\"fl-photo-content fl-photo-img-png\">\n\t\t\t\t<a href=\"https://museumofyouthculture.com\" target=\"_self\" itemprop=\"url\">\n\t\t\t\t\t<img decoding=\"async\" class=\"fl-photo-img lazy\" src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%201%201%22%3E%3C%2Fsvg%3E\" data-src=\"https://www.museumofyouthculture.com/wp-content/plugins/bb-plugin/img/pixel.png\" alt=\"\"  itemprop=\"image\" />\n\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t</div>\n</div>\n</div>\n\t</div>\n\n<div class=\"fl-col-group fl-node-uhw8jpqrg1eo\" data-node=\"uhw8jpqrg1eo\">\n\t\t\t<div class=\"fl-col fl-node-wi6fdqnu5vlz fl-col-bg-color\" data-node=\"wi6fdqnu5vlz\">\n\t<div class=\"fl-col-content fl-node-content\"></div>\n</div>\n\t</div>\n\t\t</div>\n\t</div>\n</div>\n<div class=\"fl-row fl-row-full-width fl-row-bg-none fl-node-9ialf72y6bvq fl-row-default-height fl-row-align-center\" data-node=\"9ialf72y6bvq\">\n\t<div class=\"fl-row-content-wrap\">\n\t\t\t\t\t\t<div class=\"fl-row-content fl-row-fixed-width fl-node-content\">\n\t\t\n<div class=\"fl-col-group fl-node-iykcutjwdsx9\" data-node=\"iykcutjwdsx9\">\n\t\t\t<div class=\"fl-col fl-node-z9hd6s3miu8j fl-col-bg-color\" data-node=\"z9hd6s3miu8j\">\n\t<div class=\"fl-col-content fl-node-content\"><h2  class=\"fl-module fl-module-heading fl-heading fl-heading-text fl-node-u1x7c4yfezka\" data-node=\"u1x7c4yfezka\" aria-label=\"Heading\">\n\t\t\tEXHIBITIONS\t</h2>\n<div  class=\"fl-module fl-module-rich-text fl-rich-text fl-node-bliun0kfoy1s\" data-node=\"bliun0kfoy1s\" aria-label=\"Text Editor\">\n\t<p>The Museum of Youth Culture welcomes walk-ins, but we encourage people to pre-book their visit so that we can anticipate numbers and ensure you have a great experience!</p>\n</div>\n<div class=\"fl-module fl-module-button fl-node-tz5g1eimvskw fl-button-wrap fl-button-width-auto fl-button-left\" data-node=\"tz5g1eimvskw\" aria-label=\"Button\"><a href=\"https://www.museumofyouthculture.com/bookings/\" target=\"_self\" class=\"fl-button\"><span class=\"fl-button-text\">Pre-Book Your Visit</span></a></div></div>\n</div>\n\t</div>\n\n<div class=\"fl-col-group fl-node-4v0yia2bqulx\" data-node=\"4v0yia2bqulx\">\n\t\t\t<div class=\"fl-col fl-node-sqg1opz0yd3m fl-col-bg-color fl-col-has-cols\" data-node=\"sqg1opz0yd3m\">\n\t<div class=\"fl-col-content fl-node-content\">\n<div class=\"fl-col-group fl-node-ps1jzb482fqa fl-col-group-nested\" data-node=\"ps1jzb482fqa\">\n\t\t\t<div class=\"fl-col fl-node-h4fjysq1g7wm fl-col-bg-color fl-col-small\" data-node=\"h4fjysq1g7wm\">\n\t<div class=\"fl-col-content fl-node-content\"><figure class=\"fl-module fl-module-photo fl-photo fl-photo-align-center fl-node-arzbeu1jqgyl\" data-node=\"arzbeu1jqgyl\" aria-label=\"Photo\" itemscope itemtype=\"https://schema.org/ImageObject\">\n\t<div class=\"fl-photo-content fl-photo-img-jpg\">\n\t\t\t\t<a href=\"https://www.museumofyouthculture.com/god-save-the-queens/\" target=\"_self\" itemprop=\"url\">\n\t\t\t\t\t<img decoding=\"async\" class=\"fl-photo-img wp-image-23378 size-full lazy\" src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%202145%202560%22%3E%3C%2Fsvg%3E\" data-src=\"https://www.museumofyouthculture.com/wp-content/uploads/2026/09/God-Save-the-Queens-Flyer-scaled.jpg\" alt=\"God Save the Queens Flyer\" height=\"2560\" width=\"2145\" title=\"God Save the Queens Flyer\" data-srcset=\"https://www.museumofyouthculture.com/wp-content/uploads/2026/09/God-Save-the-Queens-Flyer-scaled.jpg 2145w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/God-Save-the-Queens-Flyer-251x300.jpg 251w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/God-Save-the-Queens-Flyer-858x1024.jpg 858w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/God-Save-the-Queens-Flyer-768x916.jpg 768w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/God-Save-the-Queens-Flyer-1287x1536.jpg 1287w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/God-Save-the-Queens-Flyer-1716x2048.jpg 1716w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/God-Save-the-Queens-Flyer-500x597.jpg 500w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/God-Save-the-Queens-Flyer-800x955.jpg 800w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/God-Save-the-Queens-Flyer-1280x1527.jpg 1280w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/God-Save-the-Queens-Flyer-1920x2291.jpg 1920w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/God-Save-the-Queens-Flyer-20x24.jpg 20w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/God-Save-the-Queens-Flyer-30x36.jpg 30w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/God-Save-the-Queens-Flyer-40x48.jpg 40w\" data-sizes=\"auto, (max-width: 2145px) 100vw, 2145px\" />\n\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t</figure>\n<div  class=\"fl-module fl-module-rich-text fl-rich-text fl-node-oqzgyhrikbu0\" data-node=\"oqzgyhrikbu0\" aria-label=\"Text Editor\">\n\t<p><strong>God Save the Queens<br />\n23.10 - 22.11<br />\n</strong><b>MAIN GALLERY</b></p>\n<p>Fifty years after Poly Styrene and a generation of pioneering women helped shape punk's music, art and identity, God Save the Queens takes over the Museum of Youth Culture’s basement gallery. The exhibition presents artwork, photography, fashion and personal archival material from the women who transformed punk's visual and cultural language.</p>\n</div>\n</div>\n</div>\n\t\t\t<div class=\"fl-col fl-node-79wxdfujmt15 fl-col-bg-color fl-col-small\" data-node=\"79wxdfujmt15\">\n\t<div class=\"fl-col-content fl-node-content\"><figure class=\"fl-module fl-module-photo fl-photo fl-photo-align-center fl-node-ap9126l4sdzi\" data-node=\"ap9126l4sdzi\" aria-label=\"Photo\" itemscope itemtype=\"https://schema.org/ImageObject\">\n\t<div class=\"fl-photo-content fl-photo-img-png\">\n\t\t\t\t\t<img decoding=\"async\" class=\"fl-photo-img wp-image-23317 size-full lazy\" src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%201080%201350%22%3E%3C%2Fsvg%3E\" data-src=\"https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Things-I-Lied-to-my-Parents-About.png\" alt=\"Things I Lied to my Parents About\" height=\"1350\" width=\"1080\" title=\"Things I Lied to my Parents About\" data-srcset=\"https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Things-I-Lied-to-my-Parents-About.png 1080w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Things-I-Lied-to-my-Parents-About-240x300.png 240w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Things-I-Lied-to-my-Parents-About-819x1024.png 819w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Things-I-Lied-to-my-Parents-About-768x960.png 768w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Things-I-Lied-to-my-Parents-About-500x625.png 500w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Things-I-Lied-to-my-Parents-About-800x1000.png 800w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Things-I-Lied-to-my-Parents-About-19x24.png 19w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Things-I-Lied-to-my-Parents-About-29x36.png 29w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Things-I-Lied-to-my-Parents-About-38x48.png 38w\" data-sizes=\"auto, (max-width: 1080px) 100vw, 1080px\" />\n\t\t\t\t\t</div>\n\t</figure>\n<div  class=\"fl-module fl-module-rich-text fl-rich-text fl-node-se2kmbc063pr\" data-node=\"se2kmbc063pr\" aria-label=\"Text Editor\">\n\t<p><strong>Things I Lied to My Parents About<br />\n20.06 - 1.11<br />\n</strong><strong>YOUTH CLUB GALLERY</strong></p>\n<p><em>\"I swear I'm telling the truth... Don't you believe me?\"</em></p>\n<p>We've all told a lie at some point. Lying enables you to tease apart the idea of who you want to be against who you are, and what you are allowed to be. Through it we can begin to build our sense of self away from judgement and punishment. Curated by the Museum's Youth Collective, this exhibition explores the stories and formative moments that come with lying as a teenager, from sneaking off to parties to first dates and adventures with friends.</p>\n</div>\n</div>\n</div>\n\t\t\t<div class=\"fl-col fl-node-chjbs45fxyug fl-col-bg-color fl-col-small\" data-node=\"chjbs45fxyug\">\n\t<div class=\"fl-col-content fl-node-content\"><figure class=\"fl-module fl-module-photo fl-photo fl-photo-align-center fl-node-82a14god6uwe\" data-node=\"82a14god6uwe\" aria-label=\"Photo\" itemscope itemtype=\"https://schema.org/ImageObject\">\n\t<div class=\"fl-photo-content fl-photo-img-png\">\n\t\t\t\t\t<img decoding=\"async\" class=\"fl-photo-img wp-image-23377 size-full lazy\" src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%201920%202560%22%3E%3C%2Fsvg%3E\" data-src=\"https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Jeanie-Jean-Exhibition-scaled.png\" alt=\"Jeanie Jean Exhibition\" height=\"2560\" width=\"1920\" title=\"Jeanie Jean Exhibition\" data-srcset=\"https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Jeanie-Jean-Exhibition-scaled.png 1920w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Jeanie-Jean-Exhibition-225x300.png 225w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Jeanie-Jean-Exhibition-768x1024.png 768w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Jeanie-Jean-Exhibition-1152x1536.png 1152w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Jeanie-Jean-Exhibition-1536x2048.png 1536w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Jeanie-Jean-Exhibition-500x667.png 500w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Jeanie-Jean-Exhibition-800x1067.png 800w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Jeanie-Jean-Exhibition-1280x1707.png 1280w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Jeanie-Jean-Exhibition-18x24.png 18w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Jeanie-Jean-Exhibition-27x36.png 27w, https://www.museumofyouthculture.com/wp-content/uploads/2026/09/Jeanie-Jean-Exhibition-36x48.png 36w\" data-sizes=\"auto, (max-width: 1920px) 100vw, 1920px\" />\n\t\t\t\t\t</div>\n\t</figure>\n<div  class=\"fl-module fl-module-rich-text fl-rich-text fl-node-hvik4b7nz586\" data-node=\"hvik4b7nz586\" aria-label=\"Text Editor\">\n\t<p><strong><b>Not Dead Vol 2: DIY, The Power of Gigs, A Diary by Jeanie Jean</b><br />\n<b>16.10 - 01.11 </b><br />\n</strong><b>CAFE GALLERY</b></p>\n<p><em><span style=\"font-weight: 400;\">I once overheard someone say to their mate: 'There's nothing creative going on with young people now. </span><span style=\"font-weight: 400;\">I say bollocks to that. I've been saying this now for nearly five years.</span></em></p>\n<p>Not Dead Vol 2: DIY, The Power of Gigs, A Diary is a new book and exhibition documenting the UK's DIY Punk, Rock and Indie scene through the grassroots venues and spaces that sustain it.</p>\n</div>\n</div>\n</div>\n\t</div>\n</div>\n</div>\n\t</div>\n\n<div class=\"fl-col-group fl-node-kt8xz94ei1vl\" data-node=\"kt8xz94ei1vl\">\n\t\t\t<div class=\"fl-col fl-node-9vh38zeda0ws fl-col-bg-color fl-col-has-cols\" data-node=\"9vh38zeda0ws\">\n\t<div class=\"fl-col-content fl-node-content\"><h2  class=\"fl-module fl-module-heading fl-heading fl-heading-text fl-node-wbp8gzvh4693\" data-node=\"wbp8gzvh4693\" aria-label=\"Heading\">\n\t\t\tUPCOMING EXHIBITIONS\t</h2>\n\n<div class=\"fl-col-group fl-node-g5vl7kx9jzoi fl-col-group-nested\" data-node=\"g5vl7kx9jzoi\">\n\t\t\t<div class=\"fl-col fl-node-awj092cbhkgm fl-col-bg-color fl-col-small\" data-node=\"awj092cbhkgm\">\n\t<div class=\"fl-col-content fl-node-content\"><figure class=\"fl-module fl-module-photo fl-photo fl-photo-align-center fl-node-4pr218ebocky\" data-node=\"4pr218ebocky\" aria-label=\"Photo\" itemscope itemtype=\"https://schema.org/ImageObject\">\n\t<div class=\"fl-photo-content fl-photo-img-jpg\">\n\t\t\t\t\t<img decoding=\"async\" class=\"fl-photo-img wp-image-23535 size-full lazy\" src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%202011%202560%22%3E%3C%2Fsvg%3E\" data-src=\"https://www.museumofyouthculture.com/wp-content/uploads/2026/10/C-Muller-flyer-scaled.jpg\" alt=\"C Muller flyer\" height=\"2560\" width=\"2011\" title=\"C Muller flyer\" data-srcset=\"https://www.museumofyouthculture.com/wp-content/uploads/2026/10/C-Muller-flyer-scaled.jpg 2011w, https://www.museumofyouthculture.com/wp-content/uploads/2026/10/C-Muller-flyer-236x300.jpg 236w, https://www.museumofyouthculture.com/wp-content/uploads/2026/10/C-Muller-flyer-805x1024.jpg 805w, https://www.museumofyouthculture.com/wp-content/uploads/2026/10/C-Muller-flyer-768x977.jpg 768w, https://www.museumofyouthculture.com/wp-content/uploads/2026/10/C-Muller-flyer-1207x1536.jpg 1207w, https://www.museumofyouthculture.com/wp-content/uploads/2026/10/C-Muller-flyer-1609x2048.jpg 1609w, https://www.museumofyouthculture.com/wp-content/uploads/2026/10/C-Muller-flyer-500x636.jpg 500w, https://www.museumofyouthculture.com/wp-content/uploads/2026/10/C-Muller-flyer-800x1018.jpg 800w, https://www.museumofyouthculture.com/wp-content/uploads/2026/10/C-Muller-flyer-1280x1629.jpg 1280w, https://www.museumofyouthculture.com/wp-content/uploads/2026/10/C-Muller-flyer-1920x2444.jpg 1920w, https://www.museumofyouthculture.com/wp-content/uploads/2026/10/C-Muller-flyer-19x24.jpg 19w, https://www.museumofyouthculture.com/wp-content/uploads/2026/10/C-Muller-flyer-28x36.jpg 28w, https://www.museumofyouthculture.com/wp-content/uploads/2026/10/C-Muller-flyer-38x48.jpg 38w\" data-sizes=\"auto, (max-width: 2011px) 100vw, 2011px\" />\n\t\t\t\t\t</div>\n\t</figure>\n<div  class=\"fl-module fl-module-rich-text fl-rich-text fl-node-lx6e5gtism1h\" data-node=\"lx6e5gtism1h\" aria-label=\"Text Editor\">\n\t<p><strong>Back in the Eighties by Clare Muller<br />\n06.11 - 22.11<br />\n</strong><strong>CAFE GALLERY</strong></p>\n<p>From The Body Snatchers to Madness, and working as the staff photographer at Stiff Records, Clare Muller’s archive documents music culture in flux. Back in the Eighties explores Clare’s unseen and recently digitised reportage photography, featuring a selection of black and white photographs documenting life in the early 1980s.</p>\n</div>\n</div>\n</div>\n\t\t\t<div class=\"fl-col fl-node-xpb8lc5jh1t4 fl-col-bg-color fl-col-small\" data-node=\"xpb8lc5jh1t4\">\n\t<div class=\"fl-col-content fl-node-content\"></div>\n</div>\n\t\t\t<div class=\"fl-col fl-node-7iajf4q5xs30 fl-col-bg-color fl-col-small\" data-node=\"7iajf4q5xs30\">\n\t<div class=\"fl-col-content fl-node-content\"></div>\n</div>\n\t</div>\n<h2  class=\"fl-module fl-module-heading fl-heading fl-heading-text fl-node-x2suo4vqzhfr\" data-node=\"x2suo4vqzhfr\" aria-label=\"Heading\">\n\t\t\tUPCOMING EVENTS\t</h2>\n\n<div class=\"fl-col-group fl-node-bdig7menvfuo fl-col-group-nested\" data-node=\"bdig7menvfuo\">\n\t\t\t<div class=\"fl-col fl-node-50mq1zplbxw3 fl-col-bg-none\" data-node=\"50mq1zplbxw3\">\n\t<div class=\"fl-col-content fl-node-content\"><div  class=\"fl-module fl-module-rich-text fl-rich-text fl-node-o16qe2k9lpfc\" data-node=\"o16qe2k9lpfc\" aria-label=\"Text Editor\">\n\t<p><b>01.11.26 | 6-9pm<br />\nStories From The She-Punks Screening / Q&amp;A / DJs<br />\n</b></p>\n<p class=\"wp-block-paragraph\">Up Yours Collective presents an evening celebrating She-Punk with a film screening, Q&amp;A and DJ sets from the trailblazers of today as part of the Up Yours! God Save The Queens program at Museum of Youth Culture.</p>\n<p class=\"wp-block-paragraph\">6.30pm – Screening of Gina Birch and Helen Reddington’s Stories From The She-Punks</p>\n<p class=\"wp-block-paragraph\">7.15pm – Q&amp;A with the filmmakers chaired by curator and author Marie Arleth Skov</p>\n<p class=\"wp-block-paragraph\">8-10pm – DJ sets from Tyson (Ladies Music Pub) and Estella Adeyeri (Big Joanie)</p>\n</div>\n<div class=\"fl-module fl-module-button fl-node-troqyv3zsa5h fl-button-wrap fl-button-width-auto fl-button-left\" data-node=\"troqyv3zsa5h\" aria-label=\"Button\"><a href=\"https://upyourscollective.com/product/stories-from-the-she-punks-screening-qa-djs/\" target=\"_blank\" rel=\"noopener\" class=\"fl-button\"><span class=\"fl-button-text\">Book Now</span></a></div><div  class=\"fl-module fl-module-separator fl-node-lx4ymet3pjdz\" data-node=\"lx4ymet3pjdz\" aria-label=\"Separator\">\n\t<div class=\"fl-separator\"></div>\n</div>\n<div  class=\"fl-module fl-module-rich-text fl-rich-text fl-node-nhyw5rozmba9\" data-node=\"nhyw5rozmba9\" aria-label=\"Text Editor\">\n\t<p><b>05.11.26 | 6-9pm<br />\nBack in the Eighties by Clare Muller Private View</b></p>\n<p class=\"p1\">From The Body Snatchers to Madness, and working as the staff photographer at Stiff Records, Clare Muller’s archive documents music culture in flux. Back in the Eighties explores Clare’s unseen and recently digitised reportage photography, featuring a selection of black and white photographs documenting life in the early 1980s.</p>\n</div>\n<div class=\"fl-module fl-module-button fl-node-846zxbisae5d fl-button-wrap fl-button-width-auto fl-button-left\" data-node=\"846zxbisae5d\" aria-label=\"Button\"><a href=\"https://link.dice.fm/ad4e6450a6e7\" target=\"_blank\" rel=\"noopener\" class=\"fl-button\"><span class=\"fl-button-text\">RSVP</span></a></div><div  class=\"fl-module fl-module-separator fl-node-6jctfzr34q27\" data-node=\"6jctfzr34q27\" aria-label=\"Separator\">\n\t<div class=\"fl-separator\"></div>\n</div>\n<div  class=\"fl-module fl-module-rich-text fl-rich-text fl-node-mf5envqsab21\" data-node=\"mf5envqsab21\" aria-label=\"Text Editor\">\n\t<p><b>06.11.26 | 6-9pm<br />\n</b><strong>Black Leprechaun Press Night</strong></p>\n<p class=\"\">​Nourishment and the Museum of Youth Culture present a special screening and creative evening celebrating the launch of Black Leprechaun, a film project led by filmmaker and actor Eyum-Priscilla about her Black Irish Identity.</p>\n<p class=\"\">​Bringing together film, conversation, music and community, the evening will connect emerging creatives, cultural professionals and people working across film, TV and theatre for a celebration of independent storytelling and contemporary creativity.</p>\n<p class=\"\"><strong>​On the night</strong></p>\n<p class=\"\">​🎬 <strong>Black Leprechaun screening</strong><br />\nWatch the project on the big screen and hear directly from the people who brought it to life.</p>\n<p class=\"\">​🎙️ <strong>Cast &amp; creative panel</strong><br />\nA conversation with Eyum-Priscilla and members of the cast and creative team, exploring the making of <em>Black Leprechaun</em>, their individual creative journeys and building independent work in the industry.</p>\n<p class=\"\">​🎧 <strong>DJs, games &amp; networking</strong><br />\nStay for music, activities and a chance to meet other creatives and people working across the cultural industries.</p>\n<p class=\"\">​Who's it for?</p>\n<p class=\"\">​Young creatives, filmmakers, actors, writers, producers, photographers, cultural workers and anyone interested in independent film, and upcoming talent.</p>\n<p class=\"\">​The evening is being produced collaboratively by Nourishment, Museum of Youth Culture and the Black Leprechaun team.</p>\n</div>\n<div class=\"fl-module fl-module-button fl-node-vmow2zxunahq fl-button-wrap fl-button-width-auto fl-button-left\" data-node=\"vmow2zxunahq\" aria-label=\"Button\"><a href=\"https://luma.com/khagesml\" target=\"_blank\" rel=\"noopener\" class=\"fl-button\"><span class=\"fl-button-text\">Book Now</span></a></div><div  class=\"fl-module fl-module-separator fl-node-m59sd23juqcn\" data-node=\"m59sd23juqcn\" aria-label=\"Separator\">\n\t<div class=\"fl-separator\"></div>\n</div>\n<div  class=\"fl-module fl-module-rich-text fl-rich-text fl-node-2rk0dfagvm67\" data-node=\"2rk0dfagvm67\" aria-label=\"Text Editor\">\n\t<p><b>13.11.26 | 6-9pm<br />\n</b><strong>*SOLD OUT* An Evening with THE SLITS</strong></p>\n<p class=\"wp-block-paragraph\">Up Yours! Collective invites you to an evening celebrating the raw energy and legacy of The Slits, as part of Up Yours! God Save The Queens at the Museum of Youth Culture. Featuring a screening of Bill Badgley's documentary \"Here to Be Heard: The Story of the Slits\", a Q&amp;A with Zoë Howe (author of \"Typical Girls? The Story of The Slits\" and Palmolive (founder and drummer of The Slits) and a book signing of Zoë's newly reissued book with a fresh foreword. Plus a DJ set from Tessa \"Bassie\" Pollitt, (The Slits bassist). A night for anyone who loves punk, music history, and the women who shaped it.</p>\n<p class=\"wp-block-paragraph\">*The film is certified 15 so viewers must be able to provide ID proving they are 15 or over to enter the screening room. Guests of all ages are welcome to the rest of the event but no discounts can be given on the ticket price.</p>\n</div>\n<div  class=\"fl-module fl-module-separator fl-node-j3bwz5lx68cf\" data-node=\"j3bwz5lx68cf\" aria-label=\"Separator\">\n\t<div class=\"fl-separator\"></div>\n</div>\n<div  class=\"fl-module fl-module-rich-text fl-rich-text fl-node-ntawe8gpdkc6\" data-node=\"ntawe8gpdkc6\" aria-label=\"Text Editor\">\n\t<p><b>12.11.26 | 12-6pm<br />\n</b><strong>JAZZ TO JUNGLE </strong></p>\n<div class=\"\" data-block=\"true\" data-editor=\"df3nu\" data-offset-key=\"cgu3h-0-0\">\n<div class=\"public-DraftStyleDefault-block public-DraftStyleDefault-ltr\" data-offset-key=\"cgu3h-0-0\"><span data-offset-key=\"cgu3h-0-0\">JAZZ TO JUNGLE is taking over the Museum of Youth Culture's cafe gallery on Saturday 14th November to explore how youth culture has shaped the legacy of Jungle and Drum &amp; Bass.</span></div>\n<div data-offset-key=\"cgu3h-0-0\"></div>\n</div>\n<div class=\"\" data-block=\"true\" data-editor=\"df3nu\" data-offset-key=\"1rpb1-0-0\">\n<div class=\"public-DraftStyleDefault-block public-DraftStyleDefault-ltr\" data-offset-key=\"1rpb1-0-0\"><span data-offset-key=\"1rpb1-0-0\">This panel will bring new talent, legacy acts, and critical thinkers to share their thoughts on the rich legacy of Jungle and Drum &amp; Bass and how social and economic factors sonically shaped British rave and youth culture in the past and present.</span></div>\n<div data-offset-key=\"1rpb1-0-0\"></div>\n</div>\n<div class=\"\" data-block=\"true\" data-editor=\"df3nu\" data-offset-key=\"43ikk-0-0\">\n<div class=\"public-DraftStyleDefault-block public-DraftStyleDefault-ltr\" data-offset-key=\"43ikk-0-0\"></div>\n</div>\n<div class=\"\" data-block=\"true\" data-editor=\"df3nu\" data-offset-key=\"d22la-0-0\">\n<div class=\"public-DraftStyleDefault-block public-DraftStyleDefault-ltr\" data-offset-key=\"d22la-0-0\"><span data-offset-key=\"d22la-0-0\">12:30-14:00- Panel + Q&amp;A</span></div>\n</div>\n<div class=\"\" data-block=\"true\" data-editor=\"df3nu\" data-offset-key=\"5d6rj-0-0\">\n<div class=\"public-DraftStyleDefault-block public-DraftStyleDefault-ltr\" data-offset-key=\"5d6rj-0-0\"><span data-offset-key=\"5d6rj-0-0\">14:30 - 6PM Jazz to Jungle DJs</span></div>\n</div>\n</div>\n<div  class=\"fl-module fl-module-separator fl-node-208dgwl5v63x\" data-node=\"208dgwl5v63x\" aria-label=\"Separator\">\n\t<div class=\"fl-separator\"></div>\n</div>\n</div>\n</div>\n\t\t\t<div class=\"fl-col fl-node-grwbhax204nk fl-col-bg-none fl-col-small\" data-node=\"grwbhax204nk\">\n\t<div class=\"fl-col-content fl-node-content\"></div>\n</div>\n\t</div>\n</div>\n</div>\n\t</div>\n\t\t</div>\n\t</div>\n</div>\n<div class=\"fl-row fl-row-fixed-width fl-row-bg-none fl-node-1ybpoawgnc0u fl-row-default-height fl-row-align-center\" data-node=\"1ybpoawgnc0u\">\n\t<div class=\"fl-row-content-wrap\">\n\t\t\t\t\t\t<div class=\"fl-row-content fl-row-fixed-width fl-node-content\">\n\t\t\n<div class=\"fl-col-group fl-node-vi1a0cl94qku\" data-node=\"vi1a0cl94qku\">\n\t\t\t<div class=\"fl-col fl-node-z2l375yjexsp fl-col-bg-color fl-col-small\" data-node=\"z2l375yjexsp\">\n\t<div class=\"fl-col-content fl-node-content\"></div>\n</div>\n\t\t\t<div class=\"fl-col fl-node-e74mr0kgtpws fl-col-bg-color fl-col-small\" data-node=\"e74mr0kgtpws\">\n\t<div class=\"fl-col-content fl-node-content\"><div  class=\"fl-module fl-module-rich-text fl-rich-text fl-node-tix7e2sdpulb\" data-node=\"tix7e2sdpulb\" aria-label=\"Text Editor\">\n\t<p><strong>Get in touch:</strong></p>\n<p><span style=\"text-decoration: underline;\"><a href=\"mailto:info@museumofyouthculture.com\">info@museumofyouthculture.com</a></span></p>\n</div>\n</div>\n</div>\n\t\t\t<div class=\"fl-col fl-node-hkebvi35q90r fl-col-bg-color fl-col-small\" data-node=\"hkebvi35q90r\">\n\t<div class=\"fl-col-content fl-node-content\"><div  class=\"fl-module fl-module-rich-text fl-rich-text fl-node-xy70dqltvgor\" data-node=\"xy70dqltvgor\" aria-label=\"Text Editor\">\n\t<p><strong>Social Media:</strong></p>\n</div>\n<div class=\"fl-module fl-module-icon-group fl-node-68be3zxthmi5\" data-node=\"68be3zxthmi5\" aria-label=\"Icon Group\">\n\t<div class=\"fl-module-content fl-node-content\">\n\t\t<div class=\"fl-icon-group\">\n\t<span cla