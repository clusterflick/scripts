\t\t<!-- Category list -->\n\t\t\t</div>\n\t\t\t\t</div>\n\t<div class=\"col-9 bg-white article sizematters\">\n\t\t\n\t\t<div class=\"row bg-dark events-pagination-controller\">\n\t\t\t<div class=\"col-3 do-not-alter-height\">\n\t\t\t\t<div class=\"events-month\"><a href=\"/events\"><svg src=\"/img/icons.svg\" width=\"11\" height=\"19\" class=\"icon\" style=\"transform: rotate(180deg);\"><use xlink:href=\"/img/icons.svg#events-arrow-icon\"/></svg> BACK TO LIST</a></div>\n\t\t\t</div>\n\t\t\t<div class=\"col-9 do-not-alter-height\">\n\t\t\t\t<div class=\"pagination\"><a href=\"/events/2026/july\"><svg src=\"/img/icons.svg\" width=\"11\" height=\"19\" class=\"icon\" style=\"transform: rotate(180deg);\"><use xlink:href=\"/img/icons.svg#events-arrow-icon\"/></svg></a><a href=\"/events/2026/september\"><svg src=\"/img/icons.svg\" width=\"11\" height=\"19\" class=\"icon\"><use xlink:href=\"/img/icons.svg#events-arrow-icon\"/></svg></a></div>\n\t\t\t</div>\n\t\t</div>\n\n\n\t\t\n\t\t\n\t\t<div class=\"row\">\n\t\t\t<div class=\"col-10 content-block-text\"> \n\t\t\t\t<div class=\"addthis_sharing_toolbox\">\n<!-- AddToAny BEGIN -->\n<div class=\"a2a_kit a2a_kit_size_16 a2a_default_style\">\n<a class=\"a2a_dd\" href=\"https://www.addtoany.com/share\"></a>\n<a class=\"a2a_button_facebook\"></a>\n<a class=\"a2a_button_email\"></a>\n<a class=\"a2a_button_linkedin\"></a>\n<a class=\"a2a_button_x\"></a>\n</div>\n<script defer src=\"https://static.addtoany.com/menu/page.js\"></script>\n<!-- AddToAny END -->\n\t\t\t\t</div>\n\n\t\t\t\t<span class=\"meta events\">Events</span> <span class=\"article-date\">11 August 2026 7:00 pm</span>\n\t\t\t\t<h1>Summer by the River: Wicked Sing-Along (PG)</h1>\n\t\t\t\t<p><img src=\"https://www.londonbridgecity.co.uk/uploads/wicked-image-1-universal-1.jpg\" alt=\"\"></p>\t\t\t\t<p>Wicked (Part 1) follows the unlikely friendship between Elphaba, a misunderstood green-skinned outcast with raw magical power, and Galinda, a bubbly, popular overachiever. Set in the Land of Oz, the two meet at Shiz University, and their journey leads them from bitter rivalry to a profound bond, eventually putting them on a collision course with The Wonderful Wizard of Oz.</p>\r\n<p>Location: London Bridge City Pier</p>\r\n<p>FREE ENTRY</p>\n\t\t\t\t\t\t\t</div>\n\t\t</div>\n\n\t</div>\n</section>\n\n<script src=\"//s7.addthis.com/js/300/addthis_widget.js#pubid=ra-57613665565d9a9c\"></script>\n\n\t\t\t<div class=\"push-footer-down\"></div>\n\t\t</div>\n\n\n\t\t<div class=\"container footer-wrapper\">\n\t\t\t<section class=\"footer\">\n\t\t\t\t<div class=\"legal\">\n\t\t\t\t\t<a href=\"/pages/privacy-notice\">Privacy notice</a>\n\t\t\t\t\t|\n\t\t\t\t\t<a href=\"http://saentys.com\" target=\"_blank\">Website by SAENTYS</a>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"social\">Follow us\n\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.facebook.com/LDNBridgeCity\" title=\"Follow us on Facebook\" target=\"_blank\">\n\t\t\t\t\t\t\t\t<svg width=\"9\" height=\"18\" class=\"icon\"><use xlink:href=\"/img/icons.svg#social-facebook-icon\"/></svg>\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://x.com/ldnbridgecity\" title=\"Follow us on Twitter\" target=\"_blank\">\n\t\t\t\t\t\t\t\t<svg class=\"icon\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" version=\"1.1\" width=\"14\" height=\"14\" viewbox=\"0 0 256 256\" xml:space=\"preserve\">\n\t\t\t\t\t\t\t\t\t<defs></defs>\n\t\t\t\t\t\t\t\t\t<g style=\"stroke: none; stroke-width: 0; stroke-dasharray: none; stroke-linecap: butt; stroke-linejoin: miter; stroke-miterlimit: 10; fill: none; fill-rule: nonzero; opacity: 1;\" transform=\"translate(1.4065934065934016 1.4065934065934016) scale(2.81 2.81)\"><polygon points=\"24.89,23.01 57.79,66.99 65.24,66.99 32.34,23.01 \" style=\"stroke: none; stroke-width: 1; stroke-dasharray: none; stroke-linecap: butt; stroke-linejoin: miter; stroke-miterlimit: 10; fill: rgb(248,224,4); fill-rule: nonze