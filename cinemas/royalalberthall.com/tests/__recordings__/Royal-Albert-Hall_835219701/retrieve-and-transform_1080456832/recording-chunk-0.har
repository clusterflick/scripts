e\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/production/101101\",\"Categories\":[],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2027/messiah-on-good-friday\",\"DateDescription\":\"Friday 26 March 2027\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[{\"Type\":\"Person\",\"Title\":\"Royal Choral Society\",\"Role\":null,\"Website\":null},{\"Type\":\"Music Group\",\"Title\":\"Royal Philharmonic Orchestra\",\"Role\":null,\"Website\":null},{\"Type\":\"Person\",\"Title\":\" Richard Cooke\",\"Role\":\"conductor\",\"Website\":null}],\"ThemeColor\":\"#f2e861\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2025/4-April/Annual-Messiah-2820x1487.png?type=image&id=2361&token=1549efca&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2025/4-April/Annual-Messiah-2820x1487.png?type=image&id=2361&token=1549efca&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2025/4-April/Annual-Messiah-2820x1487.png?type=image&id=2361&token=1549efca&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2025/4-April/Annual-Messiah-2820x1487.png?type=image&id=2361&token=1549efca&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Performers stood on the south steps with the Royal Albert Hall behind them\",\"caption\":null},\"Performances\":[{\"ID\":\"2063-101102\",\"PerformanceNumber\":101102,\"ProductionSeasonNumber\":101101,\"Date\":\"2027-03-26T14:30:00+00:00\",\"TimeSlot\":\"Afternoon\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-04-02T10:00:00+01:00\",\"OffSaleDate\":\"2027-03-26T13:55:00+00:00\",\"MinimumPrice\":20,\"MaximumPrice\":60,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":61,\"ContentType\":\"Members - Donate to Charity\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p>Royal Choral Society presents: <strong>Messiah on Good Friday 2027</strong></p>\\r\\n<p><br />The <strong>Royal Choral Society</strong>&rsquo;s Good Friday afternoon performance of Handel's <em>Messiah</em> has been a Hall tradition for over 150 years.</p>\\r\\n<p>Hearing the spine-tingling choruses of the UK&rsquo;s favourite choral work performed live by 150 voices and full orchestra in the magnificent surroundings of London&rsquo;s famous concert hall is an unmatchable, bucket-list experience.</p>\\r\\n<p>The 2027 performance will be conducted by the <strong>Royal Choral Society</strong>&rsquo;s Music Director <strong>Richard Cooke</strong>, and the choir will be accompanied by the <strong>Royal Philharmonic Orchestra</strong> with a quartet of superb soloists.</p>\\r\\n<p>Book your tickets and be part of one of the capital city&rsquo;s quintessential Easter events.</p>\",\"Inactive\":false}]}]},{\"ID\":38,\"ProductionSeasonNumber\":97985,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2026-01-01T19:30:00Z\",\"EndDate\":\"2026-11-13T19:30:00Z\",\"Prefix\":null,\"Title\":\"Royal Albert Hall tour\",\"Suffix\":\"Discover a London landmark\",\"ListingIndicator\":null,\"Summary\":\"Together with a friendly guide, you’ll take a peek at the royal areas of the Hall, see the breath-taking auditorium, and the stage that’s hosted some of the world’s biggest change-makers,