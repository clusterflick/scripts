?type=image&id=7486&token=2df8c6fc&mode=fill&top=45&left=0&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/BG-Xmas.jpg?type=image&id=7486&token=2df8c6fc&mode=fill&top=100&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/BG-Xmas.jpg?type=image&id=7486&token=2df8c6fc&mode=fill&top=200&left=0&width=1200&height=400&format=webp\",\"alt\":\"Baby Gospel Christmas\",\"caption\":null},\"Performances\":[{\"ID\":\"2183-101988\",\"PerformanceNumber\":101988,\"ProductionSeasonNumber\":101983,\"Date\":\"2026-12-08T11:00:00+00:00\",\"TimeSlot\":\"Morning\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-04T10:00:00+01:00\",\"OffSaleDate\":\"2026-12-08T10:25:00+00:00\",\"MinimumPrice\":12.27,\"MaximumPrice\":12.27,\"WebContents\":[{\"ContentTypeId\":67,\"ContentType\":\"Venue Name\",\"Content\":\"yes\",\"Inactive\":false}]}]},{\"ID\":2107,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101163,\"WishlistNumber\":447,\"StartDate\":\"2026-08-17T19:00:00+01:00\",\"EndDate\":\"2026-08-17T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Copland and Stravinsky\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Ryan Bancroft and the BBC National Orchestra of Wales perform two 20th-century ballets – Copland’s Billy the Kid and Stravinsky’s Petrushka – alongside a new Clarinet Concerto by Portland-based composer and songwriter Gabriel Kahane.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-41-Copland-and-Stravinsky-2820-x-1480-AUG-17.jpg?type=image&id=7194&token=f17114a6&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-41-Copland-and-Stravinsky-2820-x-1480-AUG-17.jpg?type=image&id=7194&token=f17114a6&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-41-Copland-and-Stravinsky-2820-x-1480-AUG-17.jpg?type=image&id=7194&token=f17114a6&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-41-Copland-and-Stravinsky-2820-x-1480-AUG-17.jpg?type=image&id=7194&token=f17114a6&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-41-Copland-and-Stravinsky-2820-x-1480-AUG-17.jpg?type=image&id=7194&token=f17114a6&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Anthony McGill\",\"caption\":\"Anthony McGill © Martin Romero  \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\",\"Contemporary Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/copland-and-stravinsky\",\"DateDescription\":\"Monday 17 August 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#342a83\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-41-Copland-and-Stravinsky-2820-x-1480-AUG-17.jpg?type=image&id=7194&token=f17114a6&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-41-Copland-and-Stravinsky-2820-x-1480-AUG-17.jpg?type=image&id=7194&token=f17114a6&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-41-Copland-and-Stravinsky-2820-x-1480-AUG-17.jpg?type=image&id=7194&token=f17114a6&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-41-Copland-and-Stravinsky-2820-x-1480-AUG-17.jpg?type=image&id=7194&token=f17114a6&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Anthony McGill\",\"caption\":\"Anthony McGill © Martin Romero  \"},\"Performances\":[{\"ID\":\"2107-101163\",\"PerformanceNumber\":101163,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-08-17T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-08-17T18:25:00+01:00\",\"MinimumPrice\":5.1,\"MaximumPrice\":46,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-41-Copland-and-Stravinsky-2820-x-1480-AUG-17.jpg?type=image&id=7194&token=f17114a6\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>Two 20th-century ballets lie at the heart of this colourful concert by&nbsp;<strong>Ryan Bancroft</strong>&nbsp;and the&nbsp;<strong>BBC National Orchestra of Wales</strong>.</p>\\r\\n<p>Puppets come to life at a bustling Shrovetide Fair in&nbsp;<strong>Stravinsky</strong>&rsquo;s&nbsp;<em>Petrushka</em>&nbsp;&ndash; a giddy musical collage of folk tunes and modernist invention &ndash; while cowboy songs swirl through the score of&nbsp;<strong>Copland</strong>&rsquo;s&nbsp;<em>Billy the Kid</em>: a musical portrait of the infamous outlaw.</p>\\r\\n<p>Dedicatee&nbsp;<strong>Anthony McGill</strong>&nbsp;is the soloist in a new Clarinet Concerto, &lsquo;If love will not swing wide the gates&rsquo;, by Portland-based composer and songwriter&nbsp;<strong>Gabriel Kahane</strong>. A collaborator of Sufjan Stevens and Rufus Wainright, Kahane blends classical forms with folk-pop influences in his melodic, anthemic writing.&nbsp;</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Copland</strong>&nbsp;Billy the Kid &ndash; suite&nbsp;<em>22&rsquo;&nbsp;</em><br /><strong>Gabriel Kahane</strong>&nbsp;Clarinet Concerto, &lsquo;If love will not swing wide the gates&rsquo;&nbsp;<em>22&rsquo;&nbsp;</em><br /><em>BBC co-commission: European premiere</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Stravinsky</strong>&nbsp;Petrushka (1947 version)&nbsp;<em>34&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Anthony McGill&nbsp;</strong><em>clarinet</em></p>\\r\\n<p><strong>BBC National Orchestra of Wales</strong><br /><strong>Ryan Bancroft</strong>&nbsp;<em>conductor</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2182,\"ProductionSeasonNumber\":101983,\"PerformanceNumber\":101987,\"WishlistNumber\":null,\"StartDate\":\"2026-11-03T11:00:00Z\",\"EndDate\":\"2026-11-03T11:00:00Z\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"Baby Knees Up\",\"Suffix\":\"A Baby Broadway show\",\"ListingIndicator\":null,\"Summary\":\"An interactive experience where the entire family can sing and dance along to tunes from classic musicals and films.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/BABY-KNEES-UP.png?type=image&id=7470&token=7c175323&mode=fill&top=6&left=0&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/BABY-KNEES-UP.png?type=image&id=7470&token=7c175323&mode=fill&top=7&left=0&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/BABY-KNEES-UP.png?type=image&id=7470&token=7c175323&mode=fill&top=11&left=0&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/BABY-KNEES-UP.png?type=image&id=7470&token=7c175323&mode=fill&top=12&left=0&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/BABY-KNEES-UP.png?type=image&id=7470&token=7c175323&mode=fill&top=15&left=0&width=820&height=456&format=webp\",\"alt\":\"Baby Broadway\",\"caption\":null},\"Venue\":\"Elgar Room\",\"VenueDetails\":{\"ID\":169,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/booking/production/101987\",\"Categories\":[\"Children and family\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2026/baby-knees-up\",\"DateDescription\":\"Tuesday 3 November 2026\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#003dba\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/BABY-KNEES-UP.png?type=image&id=7470&token=7c175323&mode=fill&top=7&left=0&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/BABY-KNEES-UP.png?type=image&id=7470&token=7c175323&mode=fill&top=15&left=0&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/BABY-KNEES-UP.png?type=image&id=7470&token=7c175323&mode=fill&top=78&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/BABY-KNEES-UP.png?type=image&id=7470&token=7c175323&mode=fill&top=156&left=0&width=1200&height=400&format=webp\",\"alt\":\"Baby Broadway\",\"caption\":null},\"Performances\":[{\"ID\":\"2182-101987\",\"PerformanceNumber\":101987,\"ProductionSeasonNumber\":101983,\"Date\":\"2026-11-03T11:00:00+00:00\",\"TimeSlot\":\"Morning\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-04T10:00:00+01:00\",\"OffSaleDate\":\"2026-11-03T10:25:00+00:00\",\"MinimumPrice\":12.27,\"MaximumPrice\":12.27,\"WebContents\":[{\"ContentTypeId\":67,\"ContentType\":\"Venue Name\",\"Content\":\"yes\",\"Inactive\":false}]}]},{\"ID\":2098,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101144,\"WishlistNumber\":447,\"StartDate\":\"2026-08-11T18:00:00+01:00\",\"EndDate\":\"2026-08-11T18:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Dudamel and the LA Phil - Beethoven and Adès\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"The Los Angeles Philharmonic returns to the Proms for the first time in over two decades, led by Music Director Gustavo Dudamel. Together they perform Beethoven’s ‘Pastoral’ Symphony and Purgatorio, the first panel from Thomas Adès’s Dante ballet\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ades.png?type=image&id=7499&token=8e015c12&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ades.png?type=image&id=7499&token=8e015c12&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ades.png?type=image&id=7499&token=8e015c12&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ades.png?type=image&id=7499&token=8e015c12&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ades.png?type=image&id=7499&token=8e015c12&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"Gustavo Dudamel\",\"caption\":\"Gustavo Dudamel © Dustin Downing\"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/dudamel-and-the-la-phil-beethoven-and-ades\",\"DateDescription\":\"Tuesday 11 August 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#f5d8e9\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ades.png?type=image&id=7499&token=8e015c12&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ades.png?type=image&id=7499&token=8e015c12&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ades.png?type=image&id=7499&token=8e015c12&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ades.png?type=image&id=7499&token=8e015c12&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Gustavo Dudamel\",\"caption\":\"Gustavo Dudamel © Dustin Downing\"},\"Performances\":[{\"ID\":\"2098-101144\",\"PerformanceNumber\":101144,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-08-11T18:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-08-11T17:25:00+01:00\",\"MinimumPrice\":7.23,\"MaximumPrice\":68,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ades.png?type=image&id=7499&token=8e015c12\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>The&nbsp;<strong>Los Angeles Philharmonic&nbsp;</strong>returns to the Proms for the first time in over two decades, conducted by Music Director&nbsp;<strong>Gustavo Dudamel</strong>.</p>\\r\\n<p>Pastoral peace meets infernal horrors in two vividly descriptive orchestral classics. Cuckoos and nightingales call, a brook gently gurgles and tavern musicians strike up a dance in&nbsp;<strong>Beethoven</strong>&rsquo;s&nbsp;<em>&lsquo;Pastoral&rsquo; Symphony</em>.&nbsp;<strong>Thomas Ad&egrave;s</strong>&nbsp;paints a bleaker landscape in&nbsp;<em>Inferno</em>&nbsp;&ndash; the first panel of his Dante ballet (hear part two, Purgatorio, performed by the&nbsp;<em>National Youth Orchestra</em>&nbsp;on 8 August). &lsquo;Physical, vivid and grotesque&rsquo;, it&rsquo;s a score that finds strange beauty in horror.</p>\\r\\n<p><em>Broadcast on BBC TV and BBC iPlayer</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Beethoven&nbsp;</strong>Symphony in No. 6 in F major, &lsquo;Pastoral&rsquo;&nbsp;<em>39&rsquo;&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Thomas Ad&egrave;s</strong>&nbsp;Dante &ndash; Part 1: Inferno&nbsp;<em>45&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Los Angeles Philharmonic&nbsp;</strong><br /><strong>Gustavo Dudamel&nbsp;</strong><em>conductor&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2209,\"ProductionSeasonNumber\":99180,\"PerformanceNumber\":102591,\"WishlistNumber\":null,\"StartDate\":\"2027-06-03T19:30:00+01:00\",\"EndDate\":\"2027-06-03T19:30:00+01:00\",\"Prefix\":\"Royal Philharmonic Orchestra presents\",\"Title\":\"Game ON!\",\"Suffix\":\"A mesmerising celebration of symphonic game music\",\"ListingIndicator\":null,\"Summary\":\"Powered by the full force of the Royal Philharmonic Orchestra, music from the greatest blockbuster video games will fill the Royal Albert Hall in special new event.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/Game-ON-2820x1487.png?type=image&id=7707&token=15502488&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/Game-ON-2820x1487.png?type=image&id=7707&token=15502488&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/Game-ON-2820x1487.png?type=image&id=7707&token=15502488&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/Game-ON-2820x1487.png?type=image&id=7707&token=15502488&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/Game-ON-2820x1487.png?type=image&id=7707&token=15502488&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"A robot with a remote control standing on top of the Royal Albert Hall\",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/booking/production/102591\",\"Categories\":[\"Entertainment\",\"Contemporary Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2027/game-on\",\"DateDescription\":\"Thursday 3 June 2027\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[{\"Type\":\"Person\",\"Title\":\"Andy Brick\",\"Role\":\"conductor\",\"Website\":null},{\"Type\":\"Music Group\",\"Title\":\"Royal Philharmonic Orchestra\",\"Role\":null,\"Website\":null}],\"ThemeColor\":\"#d72020\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/Game-ON-2820x1487.png?type=image&id=7707&token=15502488&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/Game-ON-2820x1487.png?type=image&id=7707&token=15502488&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/Game-ON-2820x1487.png?type=image&id=7707&token=15502488&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/Game-ON-2820x1487.png?type=image&id=7707&token=15502488&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"A robot with a remote control standing on top of the Royal Albert Hall\",\"caption\":null},\"Performances\":[{\"ID\":\"2209-102591\",\"PerformanceNumber\":102591,\"ProductionSeasonNumber\":99180,\"Date\":\"2027-06-03T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-06-05T10:00:00+01:00\",\"OffSaleDate\":\"2027-06-03T18:55:00+01:00\",\"MinimumPrice\":7,\"MaximumPrice\":287.25,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p>Royal Philharmonic Orchestra presents:</p>\\r\\n<p><strong>Game ON! - A mesmerising celebration of symphonic game music </strong></p>\\r\\n<p>Powered by the full force of the <strong>Royal Philharmonic Orchestra</strong>, music from the greatest blockbuster video games will fill the Royal Albert Hall in this special new event. Witness the epic universes of <em>The Witcher 3, World of Warcraft, Undertale, The Elder Scrolls, Assassin&lsquo;s Creed, Ori and the Blind Forest</em>, and many others unfold before your eyes.</p>\\r\\n<p>Game ON! combines unrivalled symphonic arrangements with stunning HD game footage on screen &ndash; perfect for lovers of the video games both old and new.</p>\\r\\n<p><strong>Game ON! </strong>presents music from some of the world&rsquo;s best games in its purest form.</p>\\r\\n<p><strong>Performers </strong></p>\\r\\n<p>Andy Brick - conductor</p>\\r\\n<p>Royal Philharmonic Orchestra</p>\\r\\n<p>---------------------------------------------------------------------</p>\\r\\n<p><strong>DYNAMIC PRICING </strong></p>\\r\\n<p>In the normal way dynamic pricing is in place at the Hall for events promoted by the Royal Philharmonic Orchestra, Cirque du Soleil and the Royal Albert Hall.</p>\\r\\n<p>This means that promoter ticket prices might fluctuate for these events (both up and down) according to demand. Dynamic, or flexible pricing, has been commonly used in the airline and hotel industry for many years and is now becoming commonplace in entertainment as well. Any prices changes will apply to all tickets sold by the Hall's Box Office</p>\",\"Inactive\":false}]}]},{\"ID\":2101,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101145,\"WishlistNumber\":447,\"StartDate\":\"2026-08-12T19:00:00+01:00\",\"EndDate\":\"2026-08-12T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Dudamel and the LA Phil - Beethoven and Ortiz\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"In the second of their two Proms, the Los Angeles Philharmonic and its Music Director Gustavo Dudamel pair Beethoven’s dance-infused Symphony No. 7 with a contemporary ballet by Mexican composer Gabriela Ortiz.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ortiz.png?type=image&id=7498&token=6479aa8e&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ortiz.png?type=image&id=7498&token=6479aa8e&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ortiz.png?type=image&id=7498&token=6479aa8e&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ortiz.png?type=image&id=7498&token=6479aa8e&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ortiz.png?type=image&id=7498&token=6479aa8e&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"Gustavo Dudamel\",\"caption\":\"Gustavo Dudamel © Ryan Hunter\"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\",\"Contemporary Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/dudamel-and-the-la-phil-beethoven-and-ortiz\",\"DateDescription\":\"Wednesday 12 August 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#0093dd\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ortiz.png?type=image&id=7498&token=6479aa8e&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ortiz.png?type=image&id=7498&token=6479aa8e&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ortiz.png?type=image&id=7498&token=6479aa8e&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ortiz.png?type=image&id=7498&token=6479aa8e&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Gustavo Dudamel\",\"caption\":\"Gustavo Dudamel © Ryan Hunter\"},\"Performances\":[{\"ID\":\"2101-101145\",\"PerformanceNumber\":101145,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-08-12T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-08-12T18:25:00+01:00\",\"MinimumPrice\":7.23,\"MaximumPrice\":68,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Dudamel-and-the-LA-Phil-Beethoven-and-Ortiz.png?type=image&id=7498&token=6479aa8e\\r\\n\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>In the second of their two Proms, the&nbsp;<strong>Los Angeles Philharmonic</strong>&nbsp;and its Music Director&nbsp;<strong>Gustavo Dudamel</strong>&nbsp;again pair a&nbsp;<strong>Beethoven&nbsp;</strong>symphony with a contemporary ballet.</p>\\r\\n<p>The obsessive, often wild rhythms of Beethoven&rsquo;s&nbsp;<em>Symphony No. 7</em>&nbsp;&ndash; famously described by Wagner as &lsquo;the apotheosis of the dance&rsquo; &ndash; meet the politically charged pulse of&nbsp;<strong>Gabriela Ortiz</strong>&rsquo;s&nbsp;<em>Revoluci&oacute;n diamantina</em>: music &lsquo;full of visceral primeval rhythms and mysterious, soulful sound-worlds&rsquo;. Taking Mexico&rsquo;s 2019 Glitter Revolution as its starting point, this groove-driven, urgent score &ndash; &lsquo;a ritual in motion&rsquo; &ndash; roars against female oppression in music of fierce, hypnotic beauty.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Beethoven</strong>&nbsp;Symphony in No. 7 in A major&nbsp;<em>36&rsquo;&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Gabriela Ortiz</strong>&nbsp;Revoluci&oacute;n diamantina&nbsp;<em>42&rsquo;</em><br /><em>UK premiere</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Los Angeles Master Chorale (upper voices)</strong><br /><strong>Los Angeles Philharmonic</strong><br /><strong>Gustavo Dudamel</strong>&nbsp;<em>conductor&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2089,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101169,\"WishlistNumber\":447,\"StartDate\":\"2026-08-04T19:00:00+01:00\",\"EndDate\":\"2026-08-04T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Dvořák and Mendelssohn\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Elena Schwarz and the BBC National Orchestral of Wales perform Dvořák’s passionate Symphony No. 7 alongside Zimmermann’s 1950 Fairy-Tale Suite and Mendelssohn’s famous Violin Concerto, with Proms regular Alina Ibragimova as soloist.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-24-Dvoak-and-Mendelssohn-2820-x-1480-AUG-4.jpg?type=image&id=7177&token=07dddf0a&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-24-Dvoak-and-Mendelssohn-2820-x-1480-AUG-4.jpg?type=image&id=7177&token=07dddf0a&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-24-Dvoak-and-Mendelssohn-2820-x-1480-AUG-4.jpg?type=image&id=7177&token=07dddf0a&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-24-Dvoak-and-Mendelssohn-2820-x-1480-AUG-4.jpg?type=image&id=7177&token=07dddf0a&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-24-Dvoak-and-Mendelssohn-2820-x-1480-AUG-4.jpg?type=image&id=7177&token=07dddf0a&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Alina Ibragimova\",\"caption\":\"Alina Ibragimova © Eva Vermandel  \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/dvoak-and-mendelssohn\",\"DateDescription\":\"Tuesday 4 August 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#ef911f\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-24-Dvoak-and-Mendelssohn-2820-x-1480-AUG-4.jpg?type=image&id=7177&token=07dddf0a&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-24-Dvoak-and-Mendelssohn-2820-x-1480-AUG-4.jpg?type=image&id=7177&token=07dddf0a&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-24-Dvoak-and-Mendelssohn-2820-x-1480-AUG-4.jpg?type=image&id=7177&token=07dddf0a&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-24-Dvoak-and-Mendelssohn-2820-x-1480-AUG-4.jpg?type=image&id=7177&token=07dddf0a&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Alina Ibragimova\",\"caption\":\"Alina Ibragimova © Eva Vermandel  \"},\"Performances\":[{\"ID\":\"2089-101169\",\"PerformanceNumber\":101169,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-08-04T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-08-04T18:25:00+01:00\",\"MinimumPrice\":5.95,\"MaximumPrice\":56,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-24-Dvoak-and-Mendelssohn-2820-x-1480-AUG-4.jpg?type=image&id=7177&token=07dddf0a\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>&lsquo;Flawless&rsquo; violinist and Proms regular&nbsp;<strong>Alina Ibragimova</strong>&nbsp;is back with one of the great Romantic concertos.</p>\\r\\n<p>It may have been seven years in the making, but there&rsquo;s no sense of musical struggle in&nbsp;<strong>Mendelssohn</strong>&rsquo;s&nbsp;<em>Violin Concerto</em>&nbsp;&ndash; only sparkling, lyrical invention and a fleet-footed &lsquo;fairy music&rsquo; finale.</p>\\r\\n<p>Fairy tales are in the spotlight in&nbsp;<strong>Zimmermann</strong>&rsquo;s evocative 1950&nbsp;<em>Fairy-Tale Suite</em>, with its enchanted castle and propulsive forest ride. Bohemian folk dances and sunshine tug against a powerful undertow of melancholy in&nbsp;<strong>Dvor&aacute;k</strong>&rsquo;s passionate&nbsp;<em>Symphony No. 7</em>.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Zimmermann</strong>&nbsp;M&auml;rchen-Suite (Fairy-Tale Suite)&nbsp;<em>19&rsquo;&nbsp;</em><br /><strong>Mendelssohn&nbsp;</strong>Violin Concerto in E minor&nbsp;<em>26&rsquo;&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Dvor&aacute;k&nbsp;</strong>Symphony No. 7 in D minor&nbsp;<em>35&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Alina Ibragimova&nbsp;</strong><em>violin</em></p>\\r\\n<p><strong>BBC National Orchestra of Wales&nbsp;</strong><br /><strong>Elena Schwarz</strong>&nbsp;<em>conductor&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2138,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101154,\"WishlistNumber\":447,\"StartDate\":\"2026-09-06T19:30:00+01:00\",\"EndDate\":\"2026-09-06T19:30:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Dvořák’s ‘New World’ Symphony\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"The BBC Symphony Orchestra and Sakari Oramo perform Dvořák’s famous ‘New World’ Symphony alongside a new Triple Concerto by Gwilym Simcock featuring three former BBC Young Musician finalists: Jess Gillam, Ben Goldscheider and Sheku Kanneh-Mason.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-66-Dvoaks-New-World-Symphony-2820-x-1480-SEP-6.jpg?type=image&id=7219&token=45036764&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-66-Dvoaks-New-World-Symphony-2820-x-1480-SEP-6.jpg?type=image&id=7219&token=45036764&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-66-Dvoaks-New-World-Symphony-2820-x-1480-SEP-6.jpg?type=image&id=7219&token=45036764&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-66-Dvoaks-New-World-Symphony-2820-x-1480-SEP-6.jpg?type=image&id=7219&token=45036764&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-66-Dvoaks-New-World-Symphony-2820-x-1480-SEP-6.jpg?type=image&id=7219&token=45036764&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Sheku Kanneh-Mason\",\"caption\":\"Sheku Kanneh-Mason © Mahaneela \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\",\"Contemporary Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/dvoaks-new-world-symphony\",\"DateDescription\":\"Sunday 6 September 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#342a83\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-66-Dvoaks-New-World-Symphony-2820-x-1480-SEP-6.jpg?type=image&id=7219&token=45036764&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-66-Dvoaks-New-World-Symphony-2820-x-1480-SEP-6.jpg?type=image&id=7219&token=45036764&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-66-Dvoaks-New-World-Symphony-2820-x-1480-SEP-6.jpg?type=image&id=7219&token=45036764&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-66-Dvoaks-New-World-Symphony-2820-x-1480-SEP-6.jpg?type=image&id=7219&token=45036764&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Sheku Kanneh-Mason\",\"caption\":\"Sheku Kanneh-Mason © Mahaneela \"},\"Performances\":[{\"ID\":\"2138-101154\",\"PerformanceNumber\":101154,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-09-06T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":false,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-09-06T18:55:00+01:00\",\"MinimumPrice\":8.5,\"MaximumPrice\":68,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":50,\"ContentType\":\"Show Promo Code Box\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-66-Dvoaks-New-World-Symphony-2820-x-1480-SEP-6.jpg?type=image&id=7219&token=45036764\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>BBC Young Musician has launched many classical careers since it began in 1978. Three of its 2016 finalists &ndash;&nbsp;<strong>Jess Gillam</strong>,&nbsp;<strong>Ben Goldscheider</strong>&nbsp;and&nbsp;<strong>Sheku Kanneh-Mason</strong>&nbsp;&ndash; are reunited a decade on in a specially commissioned&nbsp;<em>Triple Concerto</em>&nbsp;by former BBC Radio 3 New Generation Artist&nbsp;<strong>Gwilym Simcock</strong>, full of rhythmic energy and joy.&nbsp;<strong>Britten</strong>&rsquo;s colourful&nbsp;<em>The Young Person&rsquo;s Guide to the Orchestra</em>&nbsp;and the folk-inspired warmth of&nbsp;<strong>Dvor&aacute;k</strong>&rsquo;s&nbsp;<em>&lsquo;New World&rsquo; Symphony</em>&nbsp;complete a vibrant programme.</p>\\r\\n<p><em>Broadcast on BBC TV and BBC iPlayer.</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Britten</strong>&nbsp;The Young Person&rsquo;s Guide to the Orchestra&nbsp;<em>18&rsquo;</em><br /><strong>Gwilym Simcock&nbsp;</strong>Triple Concerto for Soprano Saxophone, Horn and Cello&nbsp;<em>20&rsquo;</em><br /><em>BBC co-commission: world premiere</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Dvor&aacute;k&nbsp;</strong>Symphony No. 9 in E minor, &lsquo;From the New World&rsquo;<em>&nbsp;40&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Jess Gillam&nbsp;</strong><em>saxophone</em><br /><strong>Ben Goldscheider&nbsp;</strong><em>horn</em><br /><strong>Sheku Kanneh-Mason&nbsp;</strong><em>cello</em></p>\\r\\n<p><strong>BBC Symphony Orchestra</strong><br /><strong>Sakari Oramo</strong>&nbsp;<em>conductor</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false}]}]},{\"ID\":2092,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101141,\"WishlistNumber\":447,\"StartDate\":\"2026-08-06T19:00:00+01:00\",\"EndDate\":\"2026-08-06T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Elder Conducts Weber’s ‘Oberon’\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Sir Mark Elder conducts the Orchestre Révolutionnaire et Romantique, Monteverdi Choir and star soloists in Weber’s final opera, featuring a new narration that brings fresh life and wit to this chivalric fantasy of shipwrecks and magic horns.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-27-Elder-Conducts-Webers-Oberon-2820-x-1480-AUG-6.jpg?type=image&id=7180&token=dfeab991&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-27-Elder-Conducts-Webers-Oberon-2820-x-1480-AUG-6.jpg?type=image