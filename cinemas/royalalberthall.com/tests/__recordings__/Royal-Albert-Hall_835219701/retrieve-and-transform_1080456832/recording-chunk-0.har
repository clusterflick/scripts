lse},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":50,\"ContentType\":\"Show Promo Code Box\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-1-First-Night-of-the-Proms-2820-x-1480-JUL-17.jpg?type=image&id=7227&token=b4834a46\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Dalia Stasevska</strong>&nbsp;and massed BBC forces launch the 2026 season with an American accent. The widescreen vision of&nbsp;<strong>Copland</strong>&rsquo;s&nbsp;<em>Fanfare for the Common Man</em>&nbsp;zooms in to teeming city streets in&nbsp;<strong>Gershwin</strong>&rsquo;s&nbsp;<em>&lsquo;</em>rhapsodic ballet&rsquo;&nbsp;<em>An American in Paris</em>, before piano superstar&nbsp;<strong>Yunchan Lim</strong>&nbsp;performs&nbsp;<strong>Ravel</strong>&rsquo;s bluesy&nbsp;<em>Concerto in G major</em>, a musical postcard inspired by the composer&rsquo;s time in the States.</p>\\r\\n<p>The second half sees a world premiere from French-British composer&nbsp;<strong>Josephine Stephenson</strong>, before&nbsp;<strong>Finzi</strong>&rsquo;s ode to the patron saint of music, premiered in this same Hall nearly 80 years ago.</p>\\r\\n<p><em>Broadcast live on BBC Two and BBC iPlayer&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Copland</strong>&nbsp;Fanfare for the Common Man&nbsp;<em>3&rsquo;&nbsp;</em><br /><strong>Gershwin</strong>&nbsp;An American in Paris&nbsp;<em>16&rsquo;</em><br /><strong>Ravel</strong>&nbsp;Piano Concerto in G major&nbsp;<em>23&rsquo;&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Josephine Stephenson</strong>&nbsp;That the sunrise not leave us unmoved&nbsp;<em>c8&rsquo;&nbsp;</em><br /><em>BBC commission: world premiere&nbsp;</em><br /><strong>Finzi&nbsp;</strong>For St Cecilia&nbsp;<em>19&rsquo;</em>&nbsp;</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Yunchan Lim</strong>&nbsp;<em>piano&nbsp;</em><br /><strong>Thomas Atkins</strong>&nbsp;<em>tenor&nbsp;</em></p>\\r\\n<p><strong>BBC Singers</strong><br /><strong>BBC Symphony Chorus&nbsp;</strong><br /><strong>BBC Symphony Orchestra&nbsp;</strong><br /><strong>Dalia Stasevska</strong>&nbsp;<em>conductor&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2078,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101135,\"WishlistNumber\":447,\"StartDate\":\"2026-07-27T19:00:00+01:00\",\"EndDate\":\"2026-07-27T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: From the Alps to the Auvergne \",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Step into the great outdoors with Edward Gardner and the London Philharmonic Orchestra, as they perform nature-inspired works by Kristine Tjøgersen and Joseph Canteloube before Richard Strauss’s epic An Alpine Symphony\\r\\n\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-15-From-the-Alps-to-the-Auvergne-2820-x-1480-JUL-27.jpg?type=image&id=7169&token=8a2357bd&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-15-From-the-Alps-to-the-Auvergne-2820-x-1480-JUL-27.jpg?type=image&id=7169&token=8a2357bd&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-15-From-the-Alps-to-the-Auvergne-2820-x-1480-JUL-27.jpg?type=image&id=7169&token=8a2357bd&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-15-From-the-Alps-to-the-Auvergne-2820-x-1480-JUL-27.jpg?type=image&id=7169&token=8a2357bd&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-15-From-the-Alps-to-the-Auvergne-2820-x-1480-JUL-27.jpg?type=image&id=7169&token=8a2357bd&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Louise Alder\",\"caption\":\"Louise Alder © Will Alder \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\",\"Opera\",\"Contemporary Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/from-the-alps-to-the-auvergne\",\"DateDescription\":\"Monday 27 July 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#ef911f\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-15-From-the-Alps-to-the-Auvergne-2820-x-1480-JUL-27.jpg?type=image&id=7169&token=8a2357bd&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-15-From-the-Alps-to-the-Auvergne-2820-x-1480-JUL-27.jpg?type=image&id=7169&token=8a2357bd&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-15-From-the-Alps-to-the-Auvergne-2820-x-1480-JUL-27.jpg?type=image&id=7169&token=8a2357bd&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-15-From-the-Alps-to-the-Auvergne-2820-x-1480-JUL-27.jpg?type=image&id=7169&token=8a2357bd&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Louise Alder\",\"caption\":\"Louise Alder © Will Alder \"},\"Performances\":[{\"ID\":\"2078-101135\",\"PerformanceNumber\":101135,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-07-27T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-07-27T18:25:00+01:00\",\"MinimumPrice\":7.23,\"MaximumPrice\":68,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-15-From-the-Alps-to-the-Auvergne-2820-x-1480-JUL-27.jpg?type=image&id=7169&token=8a2357bd\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>Step into the great outdoors with&nbsp;<strong>Edward Gardner</strong>&nbsp;and the&nbsp;<strong>London Philharmonic Orchestra</strong>.&nbsp;<strong>Kristine Tj&oslash;gersen</strong>&rsquo;s&nbsp;<em>Between Trees</em>&nbsp;plunges listeners into the mossy shade of a Nordic forest. Childhood walks with his father through the mountains and villages of his native Auvergne inspired&nbsp;<strong>Joseph Canteloube</strong>&rsquo;s much- loved orchestral songs.</p>\\r\\n<p>&lsquo;Glorious&rsquo; soprano&nbsp;<strong>Louise Alder</strong>&nbsp;&ndash; soloist at last year&rsquo;s Last Night of the Proms &ndash; returns, performing these luscious miniatures, not heard at the Proms since 2010. These sonic strolls limber us up for&nbsp;<strong>Richard Strauss</strong>&rsquo;s epic journey up to a mountain summit. Listeners must traverse glaciers, thickets and pastures, survive storms and cross streams to gain the triumphant orchestral vistas that are the climax to the composer&rsquo;s mighty&nbsp;<em>An Alpine Symphony</em>.&nbsp;</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Kristine Tj&oslash;gersen</strong>&nbsp;Between Trees&nbsp;<em>15&rsquo;&nbsp;</em><br /><em>UK premiere</em><br /><strong>Canteloube</strong>&nbsp;Songs of the Auvergne &ndash; selection&nbsp;<em>15&rsquo;&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>R. Strauss&nbsp;</strong>An Alpine Symphony&nbsp;<em>47&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Louise Alder&nbsp;</strong><em>soprano</em></p>\\r\\n<p><strong>London Philharmonic Orchestra&nbsp;</strong><br /><strong>Edward Gardner</strong>&nbsp;<em>conductor&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2102,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101171,\"WishlistNumber\":447,\"StartDate\":\"2026-08-13T19:00:00+01:00\",\"EndDate\":\"2026-08-13T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Gershwin’s Piano Concerto\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"James Gaffigan and the BBC Symphony Orchestra mark the 250th anniversary of the Declaration of Independence with an all-American programme featuring works by George Gerswhin, Samuel Barber and Wynton Marsalis.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-36-Gershwins-Piano-Concerto-2820-x-1480-AUG-13.jpg?type=image&id=7189&token=86c1370d&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-36-Gershwins-Piano-Concerto-2820-x-1480-AUG-13.jpg?type=image&id=7189&token=86c1370d&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-36-Gershwins-Piano-Concerto-2820-x-1480-AUG-13.jpg?type=image&id=7189&token=86c1370d&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-36-Gershwins-Piano-Concerto-2820-x-1480-AUG-13.jpg?type=image&id=7189&token=86c1370d&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-36-Gershwins-Piano-Concerto-2820-x-1480-AUG-13.jpg?type=image&id=7189&token=86c1370d&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Yeol Eum Son\",\"caption\":\"Yeol Eum Son © Marco Borggreve \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\",\"Jazz\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/gershwins-piano-concerto\",\"DateDescription\":\"Thursday 13 August 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#0093dd\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-36-Gershwins-Piano-Concerto-2820-x-1480-AUG-13.jpg?type=image&id=7189&token=86c1370d&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-36-Gershwins-Piano-Concerto-2820-x-1480-AUG-13.jpg?type=image&id=7189&token=86c1370d&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-36-Gershwins-Piano-Concerto-2820-x-1480-AUG-13.jpg?type=image&id=7189&token=86c1370d&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-36-Gershwins-Piano-Concerto-2820-x-1480-AUG-13.jpg?type=image&id=7189&token=86c1370d&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Yeol Eum Son\",\"caption\":\"Yeol Eum Son © Marco Borggreve \"},\"Performances\":[{\"ID\":\"2102-101171\",\"PerformanceNumber\":101171,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-08-13T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-08-13T18:25:00+01:00\",\"MinimumPrice\":5.95,\"MaximumPrice\":56,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-36-Gershwins-Piano-Concerto-2820-x-1480-AUG-13.jpg?type=image&id=7189&token=86c1370d\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>James Gaffigan</strong>&nbsp;and the&nbsp;<strong>BBC Symphony Orchestra</strong>&nbsp;mark the 250th anniversary of the US Declaration of Independence with 100 years of American music. South Korean pianist&nbsp;<strong>Yeol Eum Son&nbsp;</strong>joins the orchestra for&nbsp;<strong>Gershwin</strong>&rsquo;s&nbsp;<em>Piano Concerto in F major</em>&nbsp;&ndash; its Charleston rhythms and songful slow-movement capturing the energy of 20th-century New York.</p>\\r\\n<p><strong>Samuel Barber</strong>&rsquo;s rarely heard&nbsp;<em>Symphony No. 1 in One Movement&nbsp;</em>marries the lyrical intensity of the composer&rsquo;s beloved Adagio with taut structural drama.</p>\\r\\n<p>The concert opens with the UK premiere of contemporary jazz great Wynton&nbsp;<strong>Marsalis</strong>&rsquo;s mercurial, kaleidoscopic&nbsp;<em>Concerto for Orchestra</em>.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Wynton Marsalis</strong>&nbsp;Concerto for Orchestra&nbsp;<em>36&rsquo;&nbsp;</em><br /><em>BBC co-commission: UK premiere</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Gershwin&nbsp;</strong>Piano Concerto in F major&nbsp;<em>31&rsquo;</em><br /><strong>Barber&nbsp;</strong>Symphony No. 1 in One Movement&nbsp;<em>21&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Yeol Eum Son&nbsp;</strong><em>piano</em></p>\\r\\n<p><strong>BBC Symphony Orchestra</strong><br /><strong>James Gaffigan</strong>&nbsp;<em>conductor&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2074,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101159,\"WishlistNumber\":447,\"StartDate\":\"2026-07-25T14:00:00+01:00\",\"EndDate\":\"2026-07-25T14:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Horrible Science - The Big Bang Proms Experiment\",\"Suffix\":\"Matinee performance\",\"ListingIndicator\":null,\"Summary\":\"Join Albert Einstein and Marie Curie as they present CBBC’s hit sketch show Horrible Science live at the Royal Albert Hall with some scientifically proven bangers from the classical canon, including Holst’s The Planets and John Williams’s Star Wars.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Horrible-Sciences-2820x1487-v3.png?type=image&id=7678&token=cb00ab16&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Horrible-Sciences-2820x1487-v3.png?type=image&id=7678&token=cb00ab16&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Horrible-Sciences-2820x1487-v3.png?type=image&id=7678&token=cb00ab16&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Horrible-Sciences-2820x1487-v3.png?type=image&id=7678&token=cb00ab16&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Horrible-Sciences-2820x1487-v3.png?type=image&id=7678&token=cb00ab16&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":null,\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/booking/production/101159\",\"Categories\":[\"Classical\",\"BBC Proms\",\"Children and family\",\"Comedy\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/horrible-science-the-big-bang-proms-experiment-matinee\",\"DateDescription\":\"Saturday 25 July 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#f5d8e9\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Horrible-Sciences-2820x1487-v3.png?type=image&id=7678&token=cb00ab16&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Horrible-Sciences-2820x1487-v3.png?type=image&id=7678&token=cb00ab16&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Horrible-Sciences-2820x1487-v3.png?type=image&id=7678&token=cb00ab16&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Horrible-Sciences-2820x1487-v3.png?type=image&id=7678&token=cb00ab16&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":null,\"caption\":null},\"Performances\":[{\"ID\":\"2074-101159\",\"PerformanceNumber\":101159,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-07-25T14:00:00+01:00\",\"TimeSlot\":\"Afternoon\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-15T09:00:00+01:00\",\"OffSaleDate\":\"2026-07-25T13:25:00+01:00\",\"MinimumPrice\":5.1,\"MaximumPrice\":46,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":50,\"ContentType\":\"Show Promo Code Box\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>Join Albert Einstein and Marie Curie as they share the DNA of CBBC&rsquo;s hit comedy sketch show&nbsp;<strong>Horrible Science</strong>&nbsp;live at the Royal Albert Hall with some scientifically proven bangers from the classical canon.</p>\\r\\n<p>They&rsquo;ll be joined by some of the great characters from science to introduce sensational sounds from&nbsp;<strong>Holst</strong>&rsquo;s&nbsp;<em>The Planets</em>&nbsp;to&nbsp;<strong>John Williams</strong>&rsquo;s&nbsp;<em>Star Wars</em>. But will the Prom survive Dr Big Brain&rsquo;s devilish desire to conquer the universe?&nbsp;</p>\\r\\n<p><em>Relaxed performance</em><br /><em>Broadcast on BBC TV and BBC iPlayer&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>Excerpts from:</div>\\r\\n<div>\\r\\n<p><strong>Borodin</strong>&nbsp;Prince Igor &ndash; Polovtsian Dances&nbsp;<br /><strong>G. Holst&nbsp;</strong>The Planets<br /><strong>John Williams</strong>&nbsp;Star Wars</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Richard David Caine</strong><br /><strong>James McNicholas</strong><br /><strong>Jessica Ransom</strong><br /><strong>Inel Tomlinson</strong></p>\\r\\n<p><strong>BBC National Orchestra of Wales&nbsp;</strong><br /><strong>Karen N&iacute; Bhroin</strong>&nbsp;<em>conductor&nbsp;</em></p>\\r\\n<p><em>There will be one interval.</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\\r\\n<section data-swiftype-index=\\\"false\\\">\\r\\n<div>\\r\\n\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2141,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101125,\"WishlistNumber\":447,\"StartDate\":\"2026-09-08T22:15:00+01:00\",\"EndDate\":\"2026-09-08T22:15:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Weyes Blood and the Jules Buckley Orchestra\",\"Suffix\":\"Late Night\",\"ListingIndi