er-Imagery/2026/7-July/BBC-Proms-2026/Prom-2-Prog-Rock-A-Fanfare-for-the-Common-Man-2820-x-1480-JUL-18.jpg?type=image&id=7157&token=ff493790&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Robert Ames\",\"caption\":\"Robert Ames © Ozge Cone \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"BBC Proms\",\"Rock and Pop\",\"Contemporary Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/prog-rock-a-fanfare-for-the-common-man\",\"DateDescription\":\"Saturday 18 July 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#342a83\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-2-Prog-Rock-A-Fanfare-for-the-Common-Man-2820-x-1480-JUL-18.jpg?type=image&id=7157&token=ff493790&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-2-Prog-Rock-A-Fanfare-for-the-Common-Man-2820-x-1480-JUL-18.jpg?type=image&id=7157&token=ff493790&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-2-Prog-Rock-A-Fanfare-for-the-Common-Man-2820-x-1480-JUL-18.jpg?type=image&id=7157&token=ff493790&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-2-Prog-Rock-A-Fanfare-for-the-Common-Man-2820-x-1480-JUL-18.jpg?type=image&id=7157&token=ff493790&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Robert Ames\",\"caption\":\"Robert Ames © Ozge Cone \"},\"Performances\":[{\"ID\":\"2065-101129\",\"PerformanceNumber\":101129,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-07-18T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":false,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-07-18T18:55:00+01:00\",\"MinimumPrice\":7.23,\"MaximumPrice\":68,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":50,\"ContentType\":\"Show Promo Code Box\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-2-Prog-Rock-A-Fanfare-for-the-Common-Man-2820-x-1480-JUL-18.jpg?type=image&id=7157&token=ff493790\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>Prog rock exploded the tight boundaries of pop music, amplifying it with new symphonic scope, ambition and influences, and creating spectacular visual and musical statements. The Proms celebrates this pioneering, British-driven movement in a concert celebrating classic tracks on an orchestral scale. Award-winning broadcaster and BBC Radio 6 Music host&nbsp;<strong>Stuart Maconie</strong>&nbsp;presents brand-new orchestral arrangements of music by&nbsp;<strong>ELP, Genesis, Jethro Tull, Mike Oldfield, Renaissance</strong>&nbsp;and others.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>BBC Concert Orchestra</strong><br /><strong>Robert Ames</strong>&nbsp;<em>conductor</em></p>\\r\\n<p><em>There will be one interval</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2140,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101181,\"WishlistNumber\":447,\"StartDate\":\"2026-09-08T18:30:00+01:00\",\"EndDate\":\"2026-09-08T18:30:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Rachmaninov, Bartók and Varèse\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"The BBC Scottish Symphony Orchestra and Ryan Wigglesworth celebrate the orchestra’s 90th anniversary with a snapshot of a golden year in musical history, performing works written in 1936 by Bartók, Rachmaninov and Varèse.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-68-Rachmaninov-Bartok-and-Varese-2820-x-1480-SEP-8.jpg?type=image&id=7221&token=1ed94253&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-68-Rachmaninov-Bartok-and-Varese-2820-x-1480-SEP-8.jpg?type=image&id=7221&token=1ed94253&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-68-Rachmaninov-Bartok-and-Varese-2820-x-1480-SEP-8.jpg?type=image&id=7221&token=1ed94253&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-68-Rachmaninov-Bartok-and-Varese-2820-x-1480-SEP-8.jpg?type=image&id=7221&token=1ed94253&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-68-Rachmaninov-Bartok-and-Varese-2820-x-1480-SEP-8.jpg?type=image&id=7221&token=1ed94253&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Ryan Wiggleworth\",\"caption\":\"Ryan Wiggleworth © Benjamin Ealovega \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/rachmaninov-bartok-and-varese\",\"DateDescription\":\"Tuesday 8 September 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#f5d8e9\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-68-Rachmaninov-Bartok-and-Varese-2820-x-1480-SEP-8.jpg?type=image&id=7221&token=1ed94253&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-68-Rachmaninov-Bartok-and-Varese-2820-x-1480-SEP-8.jpg?type=image&id=7221&token=1ed94253&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-68-Rachmaninov-Bartok-and-Varese-2820-x-1480-SEP-8.jpg?type=image&id=7221&token=1ed94253&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-68-Rachmaninov-Bartok-and-Varese-2820-x-1480-SEP-8.jpg?type=image&id=7221&token=1ed94253&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Ryan Wiggleworth\",\"caption\":\"Ryan Wiggleworth © Benjamin Ealovega \"},\"Performances\":[{\"ID\":\"2140-101181\",\"PerformanceNumber\":101181,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-09-08T18:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-09-08T17:55:00+01:00\",\"MinimumPrice\":7,\"MaximumPrice\":56,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-68-Rachmaninov-Bartok-and-Varese-2820-x-1480-SEP-8.jpg?type=image&id=7221&token=1ed94253\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>The&nbsp;<strong>BBC Scottish Symphony Orchestra</strong>&nbsp;and&nbsp;<strong>Ryan Wigglesworth</strong>&nbsp;celebrate the orchestra&rsquo;s 90th anniversary with a snapshot of a golden year in musical history: 1936 was a turning point, producing not only&nbsp;<strong>Rachmaninov</strong>&rsquo;s final symphony &ndash; the Romantic, death-haunted&nbsp;<em>No. 3&nbsp;</em>&ndash; but also&nbsp;<strong>Bart&oacute;k</strong>&rsquo;s electrifying fusion of folk and modernity, his&nbsp;<em>Music for Strings, Percussion and Celesta</em>, with its two duelling string orchestras and barrage of percussion forces.</p>\\r\\n<p><strong>Var&egrave;se</strong>&nbsp;tests the limits of sound and space in&nbsp;<em>Density 21.5</em>&nbsp;&ndash; named for the density of platinum &ndash; for solo flute, performed by the orchestra&rsquo;s Principal Flute&nbsp;<strong>Matthew Higham</strong>.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Var&egrave;se</strong>&nbsp;Density 21.5&nbsp;<em>3&rsquo;</em><br /><strong>Bart&oacute;k&nbsp;</strong>Music for Strings, Percussion and Celesta&nbsp;<em>28&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Rachmaninov</strong>&nbsp;Symphony No. 3 in A minor&nbsp;<em>39&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Matthew Higham&nbsp;</strong><em>flute</em></p>\\r\\n<p><strong>BBC Scottish Symphony Orchestra</strong><br /><strong>Ryan Wigglesworth</strong>&nbsp;<em>conductor</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false}]}]},{\"ID\":2090,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101140,\"WishlistNumber\":447,\"StartDate\":\"2026-08-05T18:00:00+01:00\",\"EndDate\":\"2026-08-05T18:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Rachmaninov’s Second\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Manchester’s Hallé orchestra and its Principal Conductor Kahchun Wong return to the Proms for Rachmaninov’s lush, expansive Symphony No. 2. We also hear French masterpieces by Nadia Boulanger and Ravel.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-25-Rachmaninovs-Second-2820-x-1480-AUG-5.jpg?type=image&id=7178&token=b907f444&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-25-Rachmaninovs-Second-2820-x-1480-AUG-5.jpg?type=image&id=7178&token=b907f444&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-25-Rachmaninovs-Second-2820-x-1480-AUG-5.jpg?type=image&id=7178&token=b907f444&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-25-Rachmaninovs-Second-2820-x-1480-AUG-5.jpg?type=image&id=7178&token=b907f444&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-25-Rachmaninovs-Second-2820-x-1480-AUG-5.jpg?type=image&id=7178&token=b907f444&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Kahchun Wong\",\"caption\":\"Kahchun Wong © Keith Hiro\"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/rachmaninovs-second\",\"DateDescription\":\"Wednesday 5 August 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#0093dd\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/