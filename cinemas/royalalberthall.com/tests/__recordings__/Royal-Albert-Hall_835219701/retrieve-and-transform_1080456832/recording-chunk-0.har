-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-3-Black-Dyke-Band-2820-x-1480-JUL-19.jpg?type=image&id=7158&token=26fd0d91&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-3-Black-Dyke-Band-2820-x-1480-JUL-19.jpg?type=image&id=7158&token=26fd0d91&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-3-Black-Dyke-Band-2820-x-1480-JUL-19.jpg?type=image&id=7158&token=26fd0d91&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"David Childs\",\"caption\":\"David Childs © Julian Fulton \"},\"Performances\":[{\"ID\":\"2066-101157\",\"PerformanceNumber\":101157,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-07-19T11:00:00+01:00\",\"TimeSlot\":\"Morning\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-07-19T10:25:00+01:00\",\"MinimumPrice\":5.1,\"MaximumPrice\":46,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-3-Black-Dyke-Band-2820-x-1480-JUL-19.jpg?type=image&id=7158&token=26fd0d91\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>Yorkshire&rsquo;s esteemed&nbsp;<strong>Black Dyke Band</strong>&nbsp;shows off its virtuosity and versatility in a programme of contemporary pieces, arrangements of popular classics and excerpts from soundtracks by&nbsp;<strong>John Williams</strong>&nbsp;and&nbsp;<strong>Hans Zimmer</strong>.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Judith Bingham</strong>&nbsp;Four Minute Mile&nbsp;<em>4&rsquo;&nbsp;</em><br /><strong>Berlioz, arr. Frank Wright&nbsp;</strong>Overture &lsquo;Le carnaval romain&rsquo;&nbsp;<em>16&rsquo;</em><br /><strong>G. Holst</strong>&nbsp;A Moorside Suite&nbsp;<em>15&rsquo;&nbsp;</em><br /><strong>Peter Graham</strong>&nbsp;Force of Nature&nbsp;<em>15&rsquo;&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Edward Gregson&nbsp;</strong>Symphony in two movements&nbsp;<em>18&rsquo;&nbsp;</em><br /><strong>John Williams, arr. Andrew Duncan</strong>&nbsp;Harry Potter and the Philosopher&rsquo;s Stone &ndash; Hedwig&rsquo;s Theme<em>&nbsp;3&rsquo;</em><br /><strong>Rodrigo, arr. Kevin Bolton</strong>&nbsp;Concierto de Aranjuez &ndash; Adagio&nbsp;<em>5&rsquo;</em><br /><strong>Hans Zimmer, arr. Stephen Roberts</strong>&nbsp;Pirates of the Caribbean: Dead Man&rsquo;s Chest &ndash; Wheel of Fortune&nbsp;<em>5&rsquo;</em><br /><strong>Philip Wilby&nbsp;</strong>Paganini Variations&nbsp;<em>15&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>David Childs&nbsp;</strong><em>euphonium</em></p>\\r\\n<p><strong>Black Dyke Band&nbsp;</strong><br /><strong>Nicholas Childs</strong>&nbsp;<em>conductor</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2067,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101165,\"WishlistNumber\":447,\"StartDate\":\"2026-07-19T19:00:00+01:00\",\"EndDate\":\"2026-07-19T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Boléro - Rhythms of Spain\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"The Spanish National Orchestra makes its Proms debut with a set of heat-soaked musical postcards that includes Ravel’s hypnotic Boléro and Rodrigo’s much-loved Concierto de Aranjuez with guitar phenomenon Rafael Aguirre as soloist.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-4-Bolero-Rhythms-of-Spain-2820-x-1480-JUL-19.jpg?type=image&id=7159&token=ae002966&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-4-Bolero-Rhythms-of-Spain-2820-x-1480-JUL-19.jpg?type=image&id=7159&token=ae002966&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-4-Bolero-Rhythms-of-Spain-2820-x-1480-JUL-19.jpg?type=image&id=7159&token=ae002966&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-4-Bolero-Rhythms-of-Spain-2820-x-1480-JUL-19.jpg?type=image&id=7159&token=ae002966&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-4-Bolero-Rhythms-of-Spain-2820-x-1480-JUL-19.jpg?type=image&id=7159&token=ae002966&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Rafael Aguirre\",\"caption\":\"Rafael Aguirre © Liz Isles\"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/bolero-rhythms-of-spain\",\"DateDescription\":\"Sunday 19 July 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#0093dd\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-4-Bolero-Rhythms-of-Spain-2820-x-1480-JUL-19.jpg?type=image&id=7159&token=ae002966&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-4-Bolero-Rhythms-of-Spain-2820-x-1480-JUL-19.jpg?type=image&id=7159&token=ae002966&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-4-Bolero-Rhythms-of-Spain-2820-x-1480-JUL-19.jpg?type=image&id=7159&token=ae002966&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-4-Bolero-Rhythms-of-Spain-2820-x-1480-JUL-19.jpg?type=image&id=7159&token=ae002966&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Rafael Aguirre\",\"caption\":\"Rafael Aguirre © Liz Isles\"},\"Performances\":[{\"ID\":\"2067-101165\",\"PerformanceNumber\":101165,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-07-19T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-07-19T18:25:00+01:00\",\"MinimumPrice\":5.95,\"MaximumPrice\":56,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":50,\"ContentType\":\"Show Promo Code Box\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-4-Bolero-Rhythms-of-Spain-2820-x-1480-JUL-19.jpg?type=image&id=7159&token=ae002966\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>The&nbsp;<strong>Spanish National Orchestra&nbsp;</strong>makes its Proms debut under Chief Conductor&nbsp;<strong>David Afkham</strong>, bringing with it a set of heat-soaked musical postcards.</p>\\r\\n<p>Spanish guitar phenomenon&nbsp;<strong>Rafael Aguirre</strong>&nbsp;joins the ensemble for&nbsp;<strong>Rodrigo</strong>&rsquo;s much-loved&nbsp;<em>Concierto de Aranjuez</em>&nbsp;&ndash; an elegant, idealised vision of Spain&rsquo;s past.&nbsp;The orchestra transforms itself into a giant guitar in two&nbsp;<strong>Ravel</strong>&nbsp;classics: the pulsing seguidilla serenade&nbsp;<em>Alborada del gracioso</em>&nbsp;and the hypnotic thrum of&nbsp;<em>Bol&eacute;ro</em>.&nbsp;The adventures of a miller, his beautiful young wife and an amorous magistrate become a vivid series of dances in music from&nbsp;<strong>Manuel de Falla</strong>&rsquo;s ballet&nbsp;<em>The Three-Cornered Hat.</em></p>\\r\\n<p><em>Broadcast live on BBC Two and BBC iPlayer&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Ravel</strong>&nbsp;Alborada del gracioso&nbsp;<em>8&rsquo;&nbsp;</em><br /><strong>Falla, arr. Francisco Coll</strong>&nbsp;Fantasia baetica&nbsp;<em>12&rsquo;</em><br /><strong>Rodrigo</strong>&nbsp;Concierto de Aranjuez&nbsp;<em>21&rsquo;</em>&nbsp;</p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Falla&nbsp;</strong>The Three-Cornered Hat &ndash; Suites Nos. 1 &amp; 2&nbsp;<em>24&rsquo;&nbsp;</em><br /><strong>Ravel</strong>&nbsp;Bol&eacute;ro&nbsp;<em>13&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Rafael Aguirre&nbsp;</strong><em>guitar</em></p>\\r\\n<p><strong>Spanish National Orchestra&nbsp;</strong><br /><strong>David Afkham</strong>&nbsp;<em>conductor&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\\r\\n<section data-swiftype-index=\\\"false\\\">\\r\\n<div>\\r\\n\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2162,\"ProductionSeasonNumber\":99180,\"PerformanceNumber\":101805,\"WishlistNumber\":null,\"StartDate\":\"2027-05-05T19:30:00+01:00\",\"EndDate\":\"2027-05-05T19:30:00+01:00\",\"Prefix\":\"Royal Philharmonic Orchestra presents\",\"Title\":\"Strauss Also sprach Zarathustra\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Vasily Petrenko conducts the RPO for Richard Strauss' Also sprach Zarathustra which sets out to tell the entire story of humanity in music\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Strauss-Also-Sprach-2820x1478.jpg?type=image&id=7351&token=8b1ee650&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Strauss-Also-Sprach-2820x1478.jpg?type=image&id=7351&token=8b1ee650&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Strauss-Also-Sprach-2820x1478.jpg?type=image&id=7351&token=8b1ee650&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Strauss-Also-Sprach-2820x1478.jpg?type=image&id=7351&token=8b1ee650&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Strauss-Also-Sprach-2820x1478.jpg?type=image&id=7351&token=8b1ee650&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"Mountains with a blue filter over it\",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/booking/production/101805\",\"Categories\":[\"Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2027/strauss-also-sprach-zarathustra\",\"DateDescription\":\"Wednesday 5 May 2027\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#0d2626\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Strauss-Also-Sprach-2820x1478.jpg?type=image&id=7351&token=8b1ee650&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Strauss-Also-Sprach-2820x1478.jpg?type=image&id=7351&token=8b1ee650&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Strauss-Also-Sprach-2820x1478.jpg?type=image&id=7351&token=8b1ee650&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Strauss-Also-Sprach-2820x1478.jpg?type=image&id=7351&token=8b1ee650&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Mountains with a blue filter over it\",\"caption\":null},\"Performances\":[{\"ID\":\"2162-101805\",\"PerformanceNumber\":101805,\"ProductionSeasonNumber\":99180,\"Date\":\"2027-05-05T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-04-28T10:00:00+01:00\",\"OffSaleDate\":\"2027-05-05T18:55:00+01:00\",\"MinimumPrice\":7,\"MaximumPrice\":287.25,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<h1>Royal Philharmonic Orchestra presents</h1>\\r\\n<h1>Strauss Also sprach Zarathustra</h1>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Vasily Petrenko</strong>&nbsp;raises his baton. The air shimmers, a trumpet pierces the darkness, and the whole universe explodes into glorious sound. When&nbsp;<strong>Richard Strauss</strong>&nbsp;composed&nbsp;<em>Also sprach Zarathustra</em>, he set out to tell the entire story of humanity in music, and from heaven-splitting opening to enigmatic close, it&rsquo;s an incredible ride &ndash; a fitting climax to a concert that bursts with emotions and ideas on a truly heroic scale.&nbsp;</p>\\r\\n<p><strong>Beethoven</strong>&rsquo;s&nbsp;<em>Fifth</em>&nbsp;and final piano concerto is so stirring and majestic that his contemporaries called it the &lsquo;Emperor&rsquo;, played tonight by&nbsp;<strong>Elisabeth Leonskaja</strong>, an artist who has dedicated her long and distinguished career to interpreting the works of Beethoven.&nbsp;</p>\\r\\n<p>The evening begins with the eternal battle between the human spirit and the pleasures of the senses:&nbsp;<strong>Wagner</strong>&rsquo;s barnstorming&nbsp;<em>Overture</em>&nbsp;to&nbsp;<em>Tannh&auml;user</em>. Music to make the pulse race, played with heart and soul.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Wagner&nbsp;</strong>Tannh&auml;user: Overture<br /><strong>Beethoven&nbsp;</strong>Piano Concerto No.5, &lsquo;Emperor&rsquo;<br /><strong>Strauss</strong>&nbsp;Also sprach Zarathustra</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Vasily Petrenko&nbsp;</strong><em>conductor</em><br /><strong>Elisabeth Leonskaja</strong>&nbsp;<em>piano</em><br /><strong>Royal Philharmonic Orchestra</strong></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\\r\\n<section></section>\\r\\n<div>\\r\\n<p><strong>DYNAMIC PRICING </strong></p>\\r\\n<p>In the normal way dynamic pricing is in place at the Hall for events promoted by the Royal Philharmonic Orchestra, Cirque du Soleil and the Royal Albert Hall.</p>\\r\\n<p>This means that promoter ticket prices might fluctuate for these events (both up and down) according to demand. Dynamic, or flexible pricing, has been commonly used in the airline and hotel industry for many years and is now becoming commonplace in entertainment as well. Any prices changes will apply to all tickets sold by the Hall's Box Office</p>\\r\\n</div>\",\"Inactive\":false}]}]},{\"ID\":2117,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101177,\"WishlistNumber\":447,\"StartDate\":\"2026-08-25T19:00:00+01:00\",\"EndDate\":\"2026-08-25T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Bond and Beyond\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Daniel Bartholomew-Poyser and the BBC Concert Orchestra train their sights on the greatest hits from Skyfall, The Spy Who Loved Me and others, promising to leave you stirred, not shaken.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-50-Bond-and-Beyond-2820-x-1480-AUG-25.jpg?type=image&id=7203&token=85fa9c92&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-50-Bond-and-Beyond-2820-x-1480-AUG-25.jpg?type=image&id=7203&token=85fa9c92&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-50-Bond-and-Beyond-2820-x-1480-AUG-25.jpg?type=image&id=7203&token=85fa9c92&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-50-Bond-and-Beyond-2820-x-1480-AUG-25.jpg?type=image&id=7203&token=85fa9c92&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-50-Bond-and-Beyond-2820-x-1480-AUG-25.jpg?type=image&id=7203&token=85fa9c92&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Daniel Bartholomew-Poyser\",\"caption\":\"Daniel Bartholomew-Poyser © Riley Smith \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\",\"Film\",\"Contemporary Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/bond-and-beyond\",\"DateDescription\":\"Tuesday 25 August 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#f5d8e9\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-50-Bond-and-Beyond-2820-x-1480-AUG-25.jpg?type=image&id=7203&token=85fa9c92&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-50-Bond-and-Beyond-2820-x-1480-AUG-25.jpg?type=image&id=7203&token=85fa9c92&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-50-Bond-and-Beyond-2820-x-1480-AUG-25.jpg?type=image&id=7203&token=85fa9c92&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-50-Bond-and-Beyond-2820-x-1480-AUG-25.jpg?type=image&id=7203&token=85fa9c92&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Daniel Bartholomew-Poyser\",\"caption\":\"Daniel Bartholomew-Poyser © Riley Smith \"},\"Performances\":[{\"ID\":\"2117-101177\",\"PerformanceNumber\":101177,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-08-25T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":false,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-08-25T18:25:00+01:00\",\"MinimumPrice\":5.95,\"MaximumPrice\":56,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-50-Bond-and-Beyond-2820-x-1480-AUG-25.jpg?type=image&id=7203&token=85fa9c92\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>No character in cinema history has a more instantly recognisable theme tune, or has inspired more classic pop songs, than James Bond.</p>\\r\\n<p><strong>Daniel Bartholomew-Poyser&nbsp;</strong>conducts the&nbsp;<strong>BBC Concert Orchestra</strong>&nbsp;in a musical homage to Ian Fleming&rsquo;s suave spy. Together with special guests they train their sights on the greatest hits from&nbsp;<em>Skyfall</em>,&nbsp;<em>The Spy Who Loved Me</em>&nbsp;and others, promising to leave you stirred, not shaken.</p>\\r\\n<p><em>Broadcast on BBC TV and BBC iPlayer.</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>BBC Concert Orchestra</strong><br /><strong>Daniel Bartholomew-Poyser</strong>&nbsp;<em>conductor</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2085,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101136,\"WishlistNumber\":447,\"StartDate\":\"2026-07-31T19:30:00+01:00\",\"EndDate\":\"2026-07-31T19:30:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Bruch’s Violin Concerto\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Omer Meir Wellber and the Deutsche Kammerphilharmonie Bremen perform symphonies by Haydn and Schumann. At the heart of the programme is Bruch’s lush, ever-popular Violin Concerto No. 1, featuring Swedish soloist Daniel Lozakovich.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-19-Bruchs-Violin-Concerto-2820-x-1480-JUL-31.jpg?type=image&id=7173&token=5ff90d8f&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-19-Bruchs-Violin-Concerto-2820-x-1480-JUL-31.jpg?type=image&id=7173&token=5ff90d8f&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-19-Bruchs-Violin-Concerto-2820-x-1480-JUL-31.jpg?type=image&id=7173&token=5ff90d8f&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-19-Bruchs-Violin-Concerto-2820-x-1480-JUL-31.jpg?type=image&id=7173&token=5ff90d8f&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-19-Bruchs-Violin-Concerto-2820-x-1480-JUL-31.jpg?type=image&id=7173&token=5ff90d8f&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Omer Meir Wellber\",\"caption\":\"Omer Meir Wellber © Grzesiek Mart \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/bruchs-violin-concerto\",\"DateDescription\":\"Friday 31 July 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#f5d8e9\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-19-Bruchs-Violin-Concerto-2820-x-1480-JUL-31.jpg?type=image&id=7173&token=5ff90d8f&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-19-Bruchs-Violin-Concerto-2820-x-1480-JUL-31.jpg?type=image&id=7173&token=5ff90d8f&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-19-Bruchs-Violin-Concerto-2820-x-1480-JUL-31.jpg?type=image&id=7173&token=5ff90d8f&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-19-Bruchs-Violin-Concerto-2820-x-1480-JUL-31.jpg?type=image&id=7173&token=5ff90d8f&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Omer Meir Wellber\",\"caption\":\"Omer Meir Wellber © Grzesiek Mart \"},\"Performances\":[{\"ID\":\"2085-101136\",\"PerformanceNumber\":101136,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-07-31T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-07-31T18:55:00+01:00\",\"MinimumPrice\":7.23,\"MaximumPrice\":68,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-19-Bruchs-Violin-Concerto-2820-x-1480-JUL-31.jpg?type=image&id=7173&token=5ff90d8f\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Haydn</strong>&rsquo;s&nbsp;<em>Symphony No. 44</em>, written at the height of his fame in Europe &ndash; embodies the bracing rhythms, lyrical melodies and dramatic silences typical of the &lsquo;Storm and Stress&rsquo; movement, its nickname &ndash; &lsquo;Trauer&rsquo; or &lsquo;Mourning&rsquo; &ndash; arising from the suggestion he requested its serene slow movement be played at his funeral.</p>\\r\\n<p><strong>Max Bruch</strong>&nbsp;evoked the heyday of Romanticism in his lush, ever-popular&nbsp;<em>First Violin Concerto</em>: young Swedish violinist&nbsp;<strong>Daniel Lozakovich</strong>&nbsp;returns following his acclaimed Proms debut in 2022.</p>\\r\\n<p>Sketched out in less than a week during a period of white-hot inspiration in 1841,&nbsp;<strong>Schumann</strong>&rsquo;s&nbsp;<em>Fourth Symphony</em>&nbsp;is the outgoing, extrovert complement to his calmer, recently completed &lsquo;Spring&rsquo; Symphony.</p>\\r\\n<p><strong>Omer Meir Wellber</strong>, a former Chief Conductor of the BBC Philharmonic, conducts one of Europe&rsquo;s leading orchestras.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Haydn</strong>&nbsp;Symphony No. 44 in E minor, &lsquo;Trauer&rsquo;&nbsp;<em>22&rsquo;&nbsp;</em><br /><strong>Bruch</strong>&nbsp;Violin Concerto No. 1 in G minor&nbsp;<em>24&rsquo;&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Schumann&nbsp;</strong>Symphony No. 4 in D minor (rev. version, 1851)&nbsp;<em>29&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Daniel Lozakovich&nbsp;</strong><em>violin</em></p>\\r\\n<p><strong>Deutsche Kammerphilharmonie Bremen&nbsp;</strong><br /><strong>Omer Meir Wellber</strong>&nbsp;<em>conductor&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2114,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101149,\"WishlistNumber\":447,\"StartDate\":\"2026-08-23T19:30:00+01:00\",\"EndDate\":\"2026-08-23T19:30:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Capuçon Plays Dvořák’s Cello Concerto\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"French cellist Gautier Capuçon is the soloist in Dvořák’s nostalgic homage to his Bohemian roots. He joins the BBC Symphony Orchestra and Alain Altinoglu for a programme that bridges Paris and New York.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-48-Capucon-plays-Dvoaks-Cello-Concerto-2820-x-1480-AUG-23.jpg?type=image&id=7201&token=335b97f9&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-48-Capucon-plays-Dvoaks-Cello-Concerto-2820-x-1480-AUG-23.jpg?type=image&id=7201&token=335b97f9&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-48-Capucon-plays-Dvoaks-Cello-Concerto-2820-x-1480-AUG-23.jpg?type=image&id=7201&token=335b97f9&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-48-Capucon-plays-Dvoaks-Cello-Concerto-2820-x-1480-AUG-23.jpg?type=image&id=7201&token=335b97f9&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-48-Capucon-plays-Dvoaks-Cello-Concerto-2820-x-1480-AUG-23.jpg?type=image&id=7201&token=335b97f9&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Alain Altinoglu\",\"caption\":\"Alain Altinoglu © Marco Borggreve  \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/bbc-proms-capucon-plays-dvoaks-cello-concerto\",\"DateDescription\":\"Sunday 23 August 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#f5d8e9\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-48-Capucon-plays-Dvoaks-Cello-Concerto-2820-x-1480-AUG-23.jpg?type=image&id=7201&token=335b97f9&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-48-Capucon-plays-Dvoaks-Cello-Concerto-2820-x-1480-AUG-23.jpg?type=image&id=7201&token=335b97f9&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-48-Capucon-plays-Dvoaks-Cello-Concerto-2820-x-1480-AUG-23.jpg?type=image&id=7201&token=335b97f9&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-48-Capucon-plays-Dvoaks-Cello-Concerto-2820-x-1480-AUG-23.jpg?type=image&id=7201&token=335b97f9&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Alain Altinoglu\",\"caption\":\"Alain Altinoglu © Marco Borggreve  \"},\"Performances\":[{\"ID\":\"2114-101149\",\"PerformanceNumber\":101149,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-08-23T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-08-23T18:55:00+01:00\",\"MinimumPrice\":7.23,\"MaximumPrice\":68,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":50,\"ContentType\":\"Show Promo Code Box\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-48-Capucon-plays-Dvoaks-Cello-Concerto-2820-x-1480-AUG-23.jpg?type=image&id=7201&token=335b97f9\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>One hundred years since wailing siren, whip and wind machine announced the arrival of&nbsp;<strong>Var&egrave;se</strong>&rsquo;s&nbsp;<em>Am&eacute;riques</em>&nbsp;in the concert hall, the Proms celebrates this exhilarating urban hymn to the composer&rsquo;s adopted home of New York City.</p>\\r\\n<p><strong>Alain Altinoglu</strong>&nbsp;traces the vibrant dialogue between Europe and America, pairing music from the Old World and the New.The languorous sensuality of&nbsp;<strong>Debussy</strong>&rsquo;s&nbsp;<em>Pr&eacute;lude &agrave; l&rsquo;apr&egrave;s-midi d&rsquo;un faune</em>&nbsp;contrasts with the clean architectural lines of&nbsp;<strong>Stravinsky</strong>&rsquo;s&nbsp;<em>Symphonies of Wind Instruments</em>&nbsp;&ndash; at once ancient and modern. Composed during his time in the USA,&nbsp;<strong>Dvor&aacute;k</strong>&rsquo;s&nbsp;<em>Cello Concerto</em>&nbsp;is a nostalgic homage to his Bohemian roots.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Stravinsky&nbsp;</strong>Symphonies of Wind Instruments (1947 version)&nbsp;<em>12&rsquo;&nbsp;</em><br /><strong>Dvor&aacute;k</strong>&nbsp;Cello Concerto in B minor&nbsp;<em>40&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Debussy</strong>&nbsp;Pr&eacute;lude &agrave; l&rsquo;apr&egrave;s-midi d&rsquo;un faune&nbsp;<em>10&rsquo;</em><br /><strong>Var&egrave;se</strong>&nbsp;Am&eacute;riques&nbsp;<em>26&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Gautier Capu&ccedil;on&nbsp;</strong><em>cello</em></p>\\r\\n<p><strong>BBC Symphony Orchestra</strong><br /><strong>Alain Altinoglu</strong>&nbsp;<em>conductor</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2184,\"ProductionSeasonNumber\":101983,\"PerformanceNumber\":101989,\"WishlistNumber\":null,\"StartDate\":\"2026-12-09T11:00:00Z\",\"EndDate\":\"2026-12-09T11:00:00Z\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"Baby Broadway Christmas\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"An interactive experience where the entire family can sing and dance along to classic Christmas tunes.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/Baby-Christmas.png?type=image&id=7475&token=b1d9bc18&mode=fill&top=6&left=0&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/Baby-Christmas.png?type=image&id=7475&token=b1d9bc18&mode=fill&top=7&left=0&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/Baby-Christmas.png?type=image&id=7475&token=b1d9bc18&mode=fill&top=11&left=0&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/Baby-Christmas.png?type=image&id=7475&token=b1d9bc18&mode=fill&top=12&left=0&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/Baby-Christmas.png?type=image&id=7475&token=b1d9bc18&mode=fill&top=15&left=0&width=820&height=456&format=webp\",\"alt\":\"Baby Christmas\",\"caption\":null},\"Venue\":\"Elgar Room\",\"VenueDetails\":{\"ID\":169,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\