102644\",\"Categories\":[\"Rock and Pop\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2027/goat\",\"DateDescription\":\"Wednesday 28 April 2027\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#fc9400\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/4-April/Goat-2820x1487.png?type=image&id=7690&token=ce10555f&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/4-April/Goat-2820x1487.png?type=image&id=7690&token=ce10555f&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/4-April/Goat-2820x1487.png?type=image&id=7690&token=ce10555f&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/4-April/Goat-2820x1487.png?type=image&id=7690&token=ce10555f&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Three members of the band Goat are sat in the back seat of a car\",\"caption\":null},\"Performances\":[{\"ID\":\"2210-102645\",\"PerformanceNumber\":102645,\"ProductionSeasonNumber\":102644,\"Date\":\"2027-04-28T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-06-05T10:00:00+01:00\",\"OffSaleDate\":\"2027-04-28T18:55:00+01:00\",\"MinimumPrice\":25,\"MaximumPrice\":70,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"6\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p>Crosstown Concerts presents: <strong>Goat </strong></p>\\r\\n<p>with special guests Pigs Pigs Pigs Pigs Pigs Pigs Pigs</p>\\r\\n<p>Swedish alternative and experimental fusion music group, <strong>Goat </strong>are making their Hall debut in spring 2027.</p>\\r\\n<p>Although Goat is only the latest incarnation of an ancient mystical tradition originating from the small village of Korpilombolo, they are the first to release their music on record.</p>\\r\\n<p>Their concerts remain unbeatable. Dressed in occult, pagan costumes and masks, the secretive collective leads a high-octane ritual tailored to expand the minds of the audience. A mission that never fails.</p>\",\"Inactive\":false}]}]},{\"ID\":1824,\"ProductionSeasonNumber\":97861,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2026-09-19T19:30:00+01:00\",\"EndDate\":\"2026-09-19T19:30:00+01:00\",\"Prefix\":\"Raymond Gubbay presents\",\"Title\":\"Beethoven's Ninth 2026\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Experience an evening of musical greatness at the Royal Albert Hall with an concert celebrating the genius of Beethoven.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2025/9-September/Beethovens-9th-2820x1487.png?type=image&id=2111&token=8b9ebef6&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2025/9-September/Beethovens-9th-2820x1487.png?type=image&id=2111&token=8b9ebef6&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2025/9-September/Beethovens-9th-2820x1487.png?type=image&id=2111&token=8b9ebef6&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2025/9-September/Beethovens-9th-2820x1487.png?type=image&id=2111&token=8b9ebef6&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2025/9-September/Beethovens-9th-2820x1487.png?type=image&id=2111&token=8b9ebef6&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":null,\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/production/97861\",\"Categories\":[\"Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2026/beethovens-ninth-2026\",\"DateDescription\":\"Saturday 19 September 2026\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[{\"Type\":\"Person\",\"Title\":\"Marta Fontanals-Simmons \",\"Role\":\"mezzo\",\"Website\":null},{\"Type\":\"Person\",\"Title\":\"Daniel Lebhardt\",\"Role\":\"pianist\",\"Website\":null},{\"Type\":\"Person\",\"Title\":\"Oliver Gooch\",\"Role\":\"conductor\",\"Website\":null},{\"Type\":\"Person\",\"Title\":\"Crouch End Festival Chorus\",\"Role\":null,\"Website\":null},{\"Type\":\"Music Group\",\"Title\":\"London Philharmonic Orchestra\",\"Role\":null,\"Website\":null}],\"ThemeColor\":\"#003dba\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2025/9-September/Beethovens-9th-2820x1487.png?type=image&id=2111&token=8b9ebef6&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2025/9-September/Beethovens-9th-2820x1487.png?type=image&id=2111&token=8b9ebef6&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2025/9-September/Beethovens-9th-2820x1487.png?type=image&id=2111&token=8b9ebef6&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2025/9-September/Beethovens-9th-2820x1487.png?type=image&id=2111&token=8b9ebef6&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":null,\"caption\":null},\"Performances\":[{\"ID\":\"1824-97931\",\"PerformanceNumber\":97931,\"ProductionSeasonNumber\":97861,\"Date\":\"2026-09-19T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2025-09-19T10:00:00+01:00\",\"OffSaleDate\":\"2026-09-19T18:55:00+01:00\",\"MinimumPrice\":19.55,\"MaximumPrice\":267.65,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":65,\"ContentType\":\"Members - Web Image URL\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2025/9-September/Beethovens-9th-2820x1487.png?type=image&id=2111&token=8b9ebef6\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p><span style=\\\"color: black;\\\">Raymond Gubbay presents:</span><strong style=\\\"color: black;\\\"> Beethoven's Ninth </strong></p><p><span style=\\\"color: black;\\\">One Concert. Two Masterpieces. Infinite Power. </span></p><p><span style=\\\"color: black;\\\">Experience an evening of musical greatness at the Royal Albert Hall with an concert celebrating the genius of </span><strong style=\\\"color: black;\\\">Beethoven</strong><span style=\\\"color: black;\\\">. The night begins with the commanding </span><em style=\\\"color: black;\\\">Piano Concerto No. 5, “Emperor”</em><span style=\\\"color: black;\\\">—a masterpiece of dazzling virtuosity and profound beauty. </span></p><p><span style=\\\"color: black;\\\">The journey reaches its summit with the monumental </span><em style=\\\"color: black;\\\">Symphony No. 9</em><span style=\\\"color: black;\\\">, performed by the </span><strong style=\\\"color: black;\\\">London Philharmonic Orchestra</strong><span style=\\\"color: black;\\\">, crowned by the soaring </span><em style=\\\"color: black;\\\">Ode to Joy—a hymn of hope</em><span style=\\\"color: black;\\\">, unity, and triumph that continues to inspire audiences worldwide. It is a celebration of humanity, spirit, and Beethoven’s timeless vision. </span></p><p><span style=\\\"color: black;\\\">Performers </span></p><p><strong style=\\\"color: black;\\\">London Philharmonic Orchestra</strong></p><p><strong style=\\\"color: black;\\\">Tom Poster</strong><span style=\\\"color: black;\\\"> - piano</span></p><p><strong style=\\\"color: black;\\\">Oliver Gooch</strong><span style=\\\"color: black;\\\"> - conductor</span></p>\",\"Inactive\":false},{\"ContentTypeId\":87,\"ContentType\":\"PT: Second Tier Box Experience\",\"Content\":\"<p><br></p><p>*Private hire of box for 4 people</p><p>*Box waiter&nbsp;</p><p>*Half bottle Champage, wine and mineral water per person&nbsp;</p><p>*Canapes and cold dish served pre show</p><p>*Hot dishes and desserts served in the interval&nbsp;</p>\",\"Inactive\":false},{\"ContentTypeId\":118,\"ContentType\":\"PT: Hospitality Dining\",\"Content\":\"<p>*Glass of Champagne on arrival&nbsp;</p><p>*Three course a la carte meal in Coda served pre show and in interval&nbsp;</p><p>*Half bottle wine per person&nbsp;</p><p>*Tea and Coffee&nbsp;</p><p>*Premium Stalls Seat&nbsp;</p>\",\"Inactive\":false}]}]},{\"ID\":2214,\"ProductionSeasonNumber\":102685,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2027-05-08T19:30:00+01:00\",\"EndDate\":\"2027-05-08T19:30:00+01:00\",\"Prefix\":\"Langham Arts present\",\"Title\":\"Prom Praise: Sing\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Prom Praise returns to the Hall in 2027 with Sing – a great festival of song celebrating the gift, joy and power of singing.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Proms-Praise-2820x1487.png?type=image&id=7708&token=c21e6a68&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Proms-Praise-2820x1487.png?type=image&id=7708&token=c21e6a68&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Proms-Praise-2820x1487.png?type=image&id=7708&token=c21e6a68&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Proms-Praise-2820x1487.png?type=image&id=7708&token=c21e6a68&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Proms-Praise-2820x1487.png?type=image&id=7708&token=c21e6a68&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"Collage of images of the Royal Albert Hall auditorium\",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/production/102685\",\"Categories\":[\"Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2027/prom-praise-sing\",\"DateDescription\":\"Saturday 8 May 2027\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#fc9400\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Proms-Praise-2820x1487.png?type=image&id=7708&token=c21e6a68&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Proms-Praise-2820x1487.png?type=image&id=7708&token=c21e6a68&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Proms-Praise-2820x1487.png?type=image&id=7708&token=c21e6a68&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/5-May/Proms-Praise-2820x1487.png?type=image&id=7708&token=c21e6a68&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Collage of images of the Royal Albert Hall auditorium\",\"caption\":null},\"Performances\":[{\"ID\":\"2214-102687\",\"PerformanceNumber\":102687,\"ProductionSeasonNumber\":102685,\"Date\":\"2027-05-08T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-06-11T10:00:00+01:00\",\"OffSaleDate\":\"2027-05-08T18:55:00+01:00\",\"MinimumPrice\":0,\"MaximumPrice\":70,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":50,\"ContentType\":\"Show Promo Code Box\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":61,\"ContentType\":\"Members - Donate to Charity\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p><strong>Prom Praise</strong>&nbsp;returns to the Hall in 2027 with Sing &ndash;&nbsp;<em>a great festival of song celebrating the gift, joy and power of singing.</em></p>\\r\\n<p>Across every culture and every generation, people sing. We sing in stadiums and schools, in homes and churches, in moments of celebration, comfort, courage and hope. Singing is deeply human &ndash; and, at Prom Praise 2027, we will explore the Christian belief that we sing because we are made in the image of a God who sings over His people.</p>\\r\\n<p>Join the&nbsp;<strong>All Souls Orchestra,</strong>&nbsp;the&nbsp;<strong>Prom Praise Gathered Choir</strong>&nbsp;and special guests for an unforgettable evening of music, worship and celebration beneath the dome of the Hall.</p>\\r\\n<p>With a thrilling mix of orchestra, choir, congregational song and inspiring guest performances, Prom Praise: Sing will invite thousands of voices to rise together in praise.</p>\\r\\n<p>Warm, joyful, moving and spectacular, this is an evening for all who love the power of music to lift the heart and stir the soul.</p>\\r\\n<p>___________________________________________________________</p>\\r\\n<p><strong>PLEASE READ - LETTER OF APPEAL&nbsp;</strong></p>\\r\\n<p>If you would like to donate your tickets to the them please select the &lsquo;Donate to Charity&rsquo; option in the Event management screen on the Members' Website. The letter of appeal was emailed to you on 8 June and a copy of this letter sits in the 'News' section of this website.</p>\\r\\n<p>There are many Members who generously support charities by way of either donating their tickets or attending the events. For this both the Hall and the organisers are so very grateful. To try and help those involved in the administration processes for the charity I am asking if any Members are planning to donate their tickets please could you do so at the earliest convenience; late donations are gratefully received by the charities but sometimes it can be very difficult for them to allocate the tickets when donated close to the date of the event. Your continued support is very much appreciated.&nbsp;</p>\",\"Inactive\":false},{\"ContentTypeId\":126,\"ContentType\":\"PT: BSL User\",\"Content\":\"<p>The BSL (British Sign Language) interpreter will be positioned to one side of the stage. Please select the assigned seats in the Stalls which are positioned for the best view.</p>\",\"Inactive\":false},{\"ContentTypeId\":258,\"ContentType\":\"TNC: BSL User\",\"Content\":\"This seat is for customers who require a view of the BSL (British Sign Language) interpreter\",\"Inactive\":false},{\"ContentTypeId\":265,\"ContentType\":\"PT: BSL - Companion \",\"Content\":\"This seat is for customers who are accompanying a BSL (British Sign Language) user\",\"Inactive\":false},{\"ContentTypeId\":396,\"ContentType\":\"TNC: BSL Companion \",\"Content\":\"This seat is for customers who are accompanying a BSL (British Sign Language) user\",\"Inactive\":false}]}]},{\"ID\":2215,\"ProductionSeasonNumber\":102657,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2027-03-24T19:30:00Z\",\"EndDate\":\"2027-03-24T19:30:00Z\",\"Prefix\":\"Phil McIntyre Live presents\",\"Title\":\"Elis and John: Pressure Is A Privilege\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"For one night only, the podcast heavyweights / stand-up comedy middleweights come to the Hall to bring you their hit show with all your favourite features.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/3-March/Elis-James_Pressure-Is-A-Privilege-2820x1487.jpg?type=image&id=7710&token=e24de26f&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/3-March/Elis-James_Pressure-Is-A-Privilege-2820x1487.jpg?type=image&id=7710&token=e24de26f&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/3-March/Elis-James_Pressure-Is-A-Privilege-2820x1487.jpg?type=image&id=7710&token=e24de26f&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/3-March/Elis-James_Pressure-Is-A-Privilege-2820x1487.jpg?type=image&id=7710&token=e24de26f&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/3-March/Elis-James_Pressure-Is-A-Privilege-2820x1487.jpg?type=image&id=7710&token=e24de26f&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"Elis James and John Robins\",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/production/102657\",\"Categories\":[\"Comedy\",\"Talk\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2027/elis-and-john-pressure-is-a-privilege\",\"DateDescription\":\"Wednesday 24 March 2027\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#fc9400\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/3-March/Elis-James_Pressure-Is-A-Privilege-2820x1487.jpg?type=image&id=7710&token=e24de26f&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/3-March/Elis-James_Pressure-Is-A-Privilege-2820x1487.jpg?type=image&id=7710&token=e24de26f&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/3-March/Elis-James_Pressure-Is-A-Privilege-2820x1487.jpg?type=image&id=7710&token=e24de26f&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/3-March/Elis-James_Pressure-Is-A-Privilege-2820x1487.jpg?type=image&id=7710&token=e24de26f&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Elis James and John Robins\",\"caption\":null},\"Performances\":[{\"ID\":\"2215-102689\",\"PerformanceNumber\":102689,\"ProductionSeasonNumber\":102657,\"Date\":\"2027-03-24T19:30:00+00:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":false,\"OnSaleDate\":\"2026-06-26T10:00:00+01:00\",\"OffSaleDate\":\"2027-03-24T18:55:00+00:00\",\"MinimumPrice\":20,\"MaximumPrice\":56,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"10\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p>Well well well well well, join <strong>Elis James and John Robin</strong>s for a very special night of comedy!</p>\\r\\n<p>For one night only, the podcast heavyweights / stand-up comedy middleweights come to the Hall to bring you their hit show with all your favourite features, and, of course, Producer Dave.</p>\\r\\n<p>But the fun doesn't end there&hellip; Have you heard that Elis James is back?! After making his return to English-language stand-up earlier this year in front of forty people in Kennington, he made the mistake of telling Josh Widdicombe that he should probably book the Royal Albert Hall. So, we did it for him (and without telling him to be fair). Expect nothing less than perfection as Elis closes out the second half with his unique brand of West-Walean anecdotalism.</p>\",\"Inactive\":false}]}]},{\"ID\":2216,\"ProductionSeasonNumber\":102755,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2027-06-04T18:00:00+01:00\",\"EndDate\":\"2027-06-05T21:45:00+01:00\",\"Prefix\":\"Raymond Gubbay presents\",\"Title\":\"Ministry of Sound Classical 2027\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Two of London’s great music institutions are back together again for one iconic show as Ministry of Sound Classical returns to the Hall.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/MoSC-2027-2820x1487.png?type=image&id=7711&token=9d343c83&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/MoSC-2027-2820x1487.png?type=image&id=7711&token=9d343c83&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/MoSC-2027-2820x1487.png?type=image&id=7711&token=9d343c83&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/MoSC-2027-2820x1487.png?type=image&id=7711&token=9d343c83&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/MoSC-2027-2820x1487.png?type=image&id=7711&token=9d343c83&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"Ministry of Classical Classical in the Royal Albert Hall auditorium\",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/production/102755\",\"Categories\":[\"Electronic\",\"Contemporary Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2027/ministry-of-sound-classical-2027\",\"DateDescription\":\"Friday 4 - Saturday 5 June 2027\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#8c52de\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/MoSC-2027-2820x1487.png?type=image&id=7711&token=9d343c83&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/MoSC-2027-2820x1487.png?type=image&id=7711&token=9d343c83&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/MoSC-2027-2820x1487.png?type=image&id=7711&token=9d343c83&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/6-June/MoSC-2027-2820x1487.png?type=image&id=7711&token=9d343c83&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Ministry of Classical Classical in the Royal Albert Hall auditorium\",\"caption\":null},\"Performances\":[{\"ID\":\"2216-102756\",\"PerformanceNumber\":102756,\"ProductionSeasonNumber\":102755,\"Date\":\"2027-06-04T18:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-06-12T10:00:00+01:00\",\"OffSaleDate\":\"2027-06-04T17:25:00+01:00\",\"MinimumPrice\":22.73,\"MaximumPrice\":297.06,\"WebContents\":[{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p>Seen by over 200,000 people and following four years of sold-out shows, two of London&rsquo;s great music institutions are back together again for one iconic show as <strong>Ministry of Sound Classical</strong> returns to the Hall.</p>\\r\\n<p>This spectacular live event brings the greatest dance tracks of all time to the stage - re-orchestrated, re-imagined, and re-lived with the power of the 50-piece<strong> London Concert Orchestra</strong> and sensational vocalists, all set to a stunning laser light production.</p>\\r\\n<p>Celebrating more than 30 years of iconic dance anthems, the 2026 edition marks the show&rsquo;s biggest run yet, with three incredible performances.</p>\\r\\n<p>Expect to hear era-defining hits from the 90s and beyond, including: <strong>The Chemical Brothers</strong> - <em>Hey Boy Hey Girl</em>, <strong>Robert Miles</strong> - <em>Children</em>, <strong>Faithless</strong> - <em>Insomnia</em>, <strong>Fatboy Slim</strong> - <em>Right Here, Right Now</em>, and many more.</p>\",\"Inactive\":false}]},{\"ID\":\"2216-102757\",\"PerformanceNumber\":102757,\"ProductionSeasonNumber\":102755,\"Date\":\"2027-06-05T18:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":false,\"OnSaleDate\":\"2026-06-12T10:00:00+01:00\",\"OffSaleDate\":\"2027-06-05T17:25:00+01:00\",\"MinimumPrice\":22.73,\"MaximumPrice\":306.86,\"WebContents\":[]},{\"ID\":\"2216-102758\",\"PerformanceNumber\":102758,\"ProductionSeasonNumber\":102755,\"Date\":\"2027-06-04T21:45:00+01:00\",\"TimeSlot\":\"Late Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-06-12T10:00:00+01:00\",\"OffSaleDate\":\"2027-06-04T21:10:00+01:00\",\"MinimumPrice\":22.73,\"MaximumPrice\":297.06,\"WebContents\":[{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p>Seen by over 200,000 people and following four years of sold-out shows, two of London&rsquo;s great music institutions are back together again for one iconic show as <strong>Ministry of Sound Classical</strong> returns to the Hall.</p>\\r\\n<p>This spectacular live event brings the greatest dance tracks of all time to the stage - re-orchestrated, re-imagined, and re-lived with the power of the 50-piece<strong> London Concert Orchestra</strong> and sensational vocalists, all set to a stunning laser light production.</p>\\r\\n<p>Celebrating more than 30 years of iconic dance anthems, the 2026 edition marks the show&rsquo;s biggest run yet, with three incredible performances.</p>\\r\\n<p>Expect to hear era-defining hits from the 90s and beyond, including: <strong>The Chemical Brothers</strong> - <em>Hey Boy Hey Girl</em>, <strong>Robert Miles</strong> - <em>Children</em>, <strong>Faithless</strong> - <em>Insomnia</em>, <strong>Fatboy Slim</strong> - <em>Right Here, Right Now</em>, and many more.</p>\",\"Inactive\":false}]},{\"ID\":\"2216-102759\",\"PerformanceNumber\":102759,\"ProductionSeasonNumber\":102755,\"Date\":\"2027-06-05T21:45:00+01:00\",\"TimeSlot\":\"Late Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-06-12T10:00:00+01:00\",\"OffSaleDate\":\"2027-06-05T21:10:00+01:00\",\"MinimumPrice\":22.73,\"MaximumPrice\":306.86,\"WebContents\":[]},{\"ID\":\"2216-102921\",\"PerformanceNumber\":102921,\"ProductionSeasonNumber\":102755,\"Date\":\"2027-06-05T14:00:00+01:00\",\"TimeSlot\":\"Afternoon\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-06-26T11:00:00+01:00\",\"OffSaleDate\":\"2027-06-05T13:25:00+01:00\",\"MinimumPrice\":22.73,\"MaximumPrice\":306.86,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false}]}]},{\"ID\":2248,\"ProductionSeasonNumber\":102804,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2027-07-10T17:00:00+01:00\",\"EndDate\":\"2027-07-10T17:00:00+01:00\",\"Prefix\":\"Giants Live presents\",\"Title\":\"The Strongman Classic 2027\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"The Strongman Classic returns to the Hall on Saturday 10 July for the most prestigious event in strength sports.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2027/7-July/Strongman-Classical-2027-2820x1487.jpg?type=image&id=7871&token=662