.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/BTMS/Tamar-Osborn.png?type=image&id=7887&token=9f972bc9&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/BTMS/Tamar-Osborn.png?type=image&id=7887&token=9f972bc9&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/BTMS/Tamar-Osborn.png?type=image&id=7887&token=9f972bc9&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/BTMS/Tamar-Osborn.png?type=image&id=7887&token=9f972bc9&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Tamar Osborn\",\"caption\":\"© Lou Jasmine\"},\"Performances\":[{\"ID\":\"2254-103004\",\"PerformanceNumber\":103004,\"ProductionSeasonNumber\":99299,\"Date\":\"2026-09-24T21:30:00+01:00\",\"TimeSlot\":\"Late Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-07-10T10:00:00+01:00\",\"OffSaleDate\":\"2026-09-24T20:55:00+01:00\",\"MinimumPrice\":13.64,\"MaximumPrice\":13.64,\"WebContents\":[{\"ContentTypeId\":43,\"ContentType\":\"Performance T&C's\",\"Content\":\"Unreserved seating and standing\",\"Inactive\":false},{\"ContentTypeId\":67,\"ContentType\":\"Venue Name\",\"Content\":\"Elgar Room \",\"Inactive\":false}]}]},{\"ID\":2255,\"ProductionSeasonNumber\":99299,\"PerformanceNumber\":103152,\"WishlistNumber\":null,\"StartDate\":\"2026-09-26T21:30:00+01:00\",\"EndDate\":\"2026-09-26T21:30:00+01:00\",\"Prefix\":\"Royal Albert Hall and Arts Canteen present\",\"Title\":\"Late Night Jazz: Amira Kheir\",\"Suffix\":\"Part of AWAN Festival\",\"ListingIndicator\":null,\"Summary\":\"Amira Kheir’s brings her signature sound to the Elgar Room: richly insightful, authentic, and inspired by traditions of her 