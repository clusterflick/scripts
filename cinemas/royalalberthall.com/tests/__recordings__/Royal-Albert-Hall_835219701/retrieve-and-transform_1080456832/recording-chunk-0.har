":null},\"Performances\":[{\"ID\":\"2018-100839\",\"PerformanceNumber\":100839,\"ProductionSeasonNumber\":100570,\"Date\":\"2026-10-13T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":false,\"OnSaleDate\":\"2026-03-11T10:00:00+00:00\",\"OffSaleDate\":\"2026-10-13T18:55:00+01:00\",\"MinimumPrice\":50,\"MaximumPrice\":125,\"WebContents\":[]},{\"ID\":\"2018-100845\",\"PerformanceNumber\":100845,\"ProductionSeasonNumber\":100570,\"Date\":\"2026-10-14T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":false,\"OnSaleDate\":\"2026-03-11T10:00:00+00:00\",\"OffSaleDate\":\"2026-10-14T18:55:00+01:00\",\"MinimumPrice\":50,\"MaximumPrice\":125,\"WebContents\":[]}]},{\"ID\":1914,\"ProductionSeasonNumber\":99467,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2026-12-15T19:30:00Z\",\"EndDate\":\"2026-12-15T19:30:00Z\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"John Wilson and Sinfonia of London: A Christmas Songbook\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"A dazzling night of sparkling music with John Wilson and his Sinfonia of London performing a feast of Christmas classics.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Sinfonia-of-London/RS6744_Prom-21_John-Wilson_Sinfonia-of-London-32.JPG?type=image&id=6338&token=a980002d&mode=fill&top=16&left=0&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Sinfonia-of-London/RS6744_Prom-21_John-Wilson_Sinfonia-of-London-32.JPG?type=image&id=6338&token=a980002d&mode=fill&top=22&left=0&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Sinfonia-of-London/RS6744_Prom-21_John-Wilson_Sinfonia-of-London-32.JPG?type=image&id=6338&token=a980002d&mode=fill&top=32&left=0&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Sinfonia-of-London/RS6744_Prom-21_John-Wilson_Sinfonia-of-London-32.JPG?type=image&id=6338&token=a980002d&mode=fill&top=36&left=0&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Sinfonia-of-London/RS6744_Prom-21_John-Wilson_Sinfonia-of-London-32.JPG?type=image&id=6338&token=a980002d&mode=fill&top=44&left=0&width=820&height=456&format=webp\",\"alt\":\"John Wilson conduction the Sinfonia of London at the Royal Albert Hall \",\"caption\":null},\"Venue\":null,\"VenueDetails\":null,\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/production/99467\",\"Categories\":[\"Classical\",\"Contemporary Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2026/john-wilson-and-sinfonia-of-london-a-christmas-songbook\",\"DateDescription\":\"Tuesday 15 December 2026\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#d72020\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Sinfonia-of-London/RS6744_Prom-21_John-Wilson_Sinfonia-of-London-32.JPG?type=image&id=6338&token=a980002d&mode=fill&top=22&left=0&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Sinfonia-of-London/RS6744_Prom-21_John-Wilson_Sinfonia-of-London-32.JPG?type=image&id=6338&token=a980002d&mode=fill&top=44&left=0&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Sinfonia-of-London/RS6744_Prom-21_John-Wilson_Sinfonia-of-London-32.JPG?type=image&id=6338&token=a980002d&mode=fill&top=99&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Sinfonia-of-London/RS6744_Prom-21_John-Wilson_Sinfonia-of-London-32.JPG?type=image&id=6338&token=a980002d&mode=fill&top=199&left=0&width=1200&height=400&format=webp\",\"alt\":\"John Wilson conduction the Sinfonia of London at the Royal Albert Hall \",\"caption\":null},\"Performances\":[{\"ID\":\"1914-99468\",\"PerformanceNumber\":99468,\"ProductionSeasonNumber\":99467,\"Date\":\"2026-12-15T19:30:00+00:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2025-12-12T10:00:00+00:00\",\"OffSaleDate\":\"2026-12-15T18:55:00+00:00\",\"MinimumPrice\":20.91,\"MaximumPrice\":385.29,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p>Royal Albert Hall presents: <strong>John Wilson and Sinfonia of London: A Christmas Songbook 2026</strong></p>\\r\\n<p>A dazzling night of sparkling music with <strong>John Wilson</strong> and his <strong>Sinfonia of London</strong> performing a feast of Christmas classics.</p>\\r\\n<p>They're joined by a legendary star of the West End, <strong>Louise Dearman</strong>, for this very special concert which includes music from Tchaikovsky&rsquo;s <em>The Nutcracker</em> and a suite from <em>Mary Poppins</em>. Plus, Christmas favourites including <em>Let it snow, Let it sno</em>w, Let it snow!, Have Yourself a Merry Little Christmas, White Christmas and many more. <br />_________________________________________________________</p>\\r\\n<p><strong>DYNAMIC PRICING</strong></p>\\r\\n<p>In the normal way dynamic pricing is in place at the Hall for events promoted by the Royal Philharmonic Orchestra, Cirque du Soleil and the Royal Albert Hall.</p>\\r\\n<p>This means that promoter ticket prices might fluctuate for these events (both up and down) according to demand. Dynamic, or flexible pricing, has been commonly used in the airline and hotel industry for many years and is now becoming commonplace in entertainment as well. Any prices changes will apply to all tickets sold by the Hall's Box Office <br />_________________________________________________________</p>\",\"Inactive\":false},{\"ContentTypeId\":87,\"ContentType\":\"PT: Second Tier Box Experience\",\"Content\":\"<p>*Private hire of a box for 4 guests<br />*Half bottle of Champagne, half bottle wine, mulled wine, <br />*A selection of mineral water and soft drinks <br />*Luxury canap&eacute;s and a cold bowl dish served pre show <br />*Hot bowl dishes and dessert canap&eacute;s served in the interval <br />*A dedicated service waiter per box <br />*A cracker and gift per person</p>\",\"Inactive\":false},{\"ContentTypeId\":89,\"ContentType\":\"PT: Loggia Box Experience\",\"Content\":\"<p>*Private hire of a box for 8 guests<br />*Half bottle of Champagne, half bottle wine, mulled wine, <br />*A selection of mineral water and soft drinks <br />*Luxury canap&eacute;s and a cold bowl dish served pre show <br />*Hot bowl dishes and dessert canap&eacute;s served in the interval <br />*A dedicated service waiter per box <br />*A cracker and gift per person</p>\",\"Inactive\":false},{\"ContentTypeId\":118,\"ContentType\":\"PT: Hospitality Dining\",\"Content\":\"<p>*Premium stalls seat <br />*Three course dinner in Coda by Chavot Restaurant<br />*Welcome glass of Champagne and half bottle of wine per person <br />*Still &amp; Sparkling mineral water, tea or coffee<br />*Christmas crackers<br />*Gift per person</p>\",\"Inactive\":false},{\"ContentTypeId\":293,\"ContentType\":\"PT: VIP Lounge\",\"Content\":\"<p>*Front Arena seat (within first 7 rows) <br />*Glass of Champagne on arrival, mulled wine, wine, beer and soft drinks<br />*A festive menu served pre show in the Christmas VIP Lounge</p>\",\"Inactive\":false},{\"ContentTypeId\":408,\"ContentType\":\"PT: VIP Lounge Stalls\",\"Content\":\"<p>*Premium stalls seat <br />*Access to 1871 VIP lounge <br />*Wine, beer and soft drinks<br />*A festive menu served pre show and in the interval</p>\",\"Inactive\":false}]}]},{\"ID\":1972,\"ProductionSeasonNumber\":100127,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2026-11-27T19:30:00Z\",\"EndDate\":\"2026-11-28T19:30:00Z\",\"Prefix\":\"One Fifteen and Harvey Goldsmith present\",\"Title\":\"Jools Holland and his Rhythm & Blues Orchestra\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Musical maestro Jools Holland and his world-renowned Rhythm & Blues Orchestra are delighted to return to the Hall this November.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Jools-Holland-2026-2820x1487.png?type=image&id=6655&token=23da8241&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Jools-Holland-2026-2820x1487.png?type=image&id=6655&token=23da8241&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Jools-Holland-2026-2820x1487.png?type=image&id=6655&token=23da8241&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Jools-Holland-2026-2820x1487.png?type=image&id=6655&token=23da8241&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Jools-Holland-2026-2820x1487.png?type=image&id=6655&token=23da8241&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"Jools Holland sat at the piano\",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/production/100127\",\"Categories\":[\"Rock and Pop\",\"Jazz\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2026/jools-holland-and-his-rhythm-and-blues-orchestra\",\"DateDescription\":\"Friday 27 - Saturday 28 November 2026\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#8c52de\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Jools-Holland-2026-2820x1487.png?type=image&id=6655&token=23da8241&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Jools-Holland-2026-2820x1487.png?type=image&id=6655&token=23da8241&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Jools-Holland-2026-2820x1487.png?type=image&id=6655&token=23da8241&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Jools-Holland-2026-2820x1487.png?type=image&id=6655&token=23da8241&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Jools Holland sat at the piano\",\"caption\":null},\"Performances\":[{\"ID\":\"1972-100133\",\"PerformanceNumber\":100133,\"ProductionSeasonNumber\":100127,\"Date\":\"2026-11-27T19:30:00+00:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-01-30T10:00:00+00:00\",\"OffSaleDate\":\"2026-11-27T18:55:00+00:00\",\"MinimumPrice\":33,\"MaximumPrice\":292.16,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p>One Fifteen and Harvey Goldsmith present:</p>\\r\\n<p><strong>Jools Holland and his Rhythm &amp; Blues Orchestra</strong></p>\\r\\n<p>Musical maestro <strong>Jools Holland</strong> and his world-renowned <strong>Rhythm &amp; Blues Orchestra</strong> are delighted to return to the Hall this November.</p>\\r\\n<p>Renowned for his exuberant live shows, Jools will once again be backed by the full power and finesse of his Rhythm &amp; Blues Orchestra, delivering an evening of blues music, swing music, boogie woogie and ska, packed with musical virtuosity and joyful spontaneity.</p>\\r\\n<p>Joining Jools and the Orchestra as special guest will be one of the UK&rsquo;s most celebrated soul voices, <strong>Roachford</strong>. Since his breakthrough hit \\\"Cuddly Toy\\\" topped the UK charts in 1988, Roachford has released 10 studio albums, been sought after as a songwriter by Michael Jackson, Joss Stone and Chaka Khan, and built a reputation as an outstanding live performer.</p>\\r\\n<p>Fans will be thrilled to hear that the shows will once again feature the incredible <strong>Ruby Turner</strong>, the Boogie Woogie Queen, as well as the outstanding vocals of <strong>Louise Marshall</strong>, and <strong>Sumudu Jayatilak</strong>a. Together with the skillful musicianship of the Rhythm &amp; Blues Orchestra, Jools Holland will be performing songs from throughout his career. With a catalogue of classics to choose from, the tour promises another unforgettable run of shows.</p>\",\"Inactive\":false}]},{\"ID\":\"1972-100144\",\"PerformanceNumber\":100144,\"ProductionSeasonNumber\":100127,\"Date\":\"2026-11-28T19:30:00+00:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-01-30T10:00:00+00:00\",\"OffSaleDate\":\"2026-11-28T18:55:00+00:00\",\"MinimumPrice\":33,\"MaximumPrice\":306.86,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false}]}]},{\"ID\":1894,\"ProductionSeasonNumber\":99152,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2026-12-31T13:00:00Z\",\"EndDate\":\"2026-12-31T17:30:00Z\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"La La Land in Concert (12A) \",\"Suffix\":\"with the Royal Philharmonic Concert Orchestra\",\"ListingIndicator\":null,\"Summary\":\"Revisit the 2016 Academy Award® winning Lionsgate film, La La Land, starring Ryan Gosling and Emma Stone, written and directed by Damien Chazelle, in a swoon-worthy live concert experience.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Website-size-LA-LA-LAND-v2.png?type=image&id=6290&token=3032e7ff&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Website-size-LA-LA-LAND-v2.png?type=image&id=6290&token=3032e7ff&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Website-size-LA-LA-LAND-v2.png?type=image&id=6290&token=3032e7ff&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Website-size-LA-LA-LAND-v2.png?type=image&id=6290&token=3032e7ff&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Website-size-LA-LA-LAND-v2.png?type=image&id=6290&token=3032e7ff&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"Two dancers in front of the LA skyline, one woman in a yellow dress and one man in a suit. \",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/production/99152\",\"Categories\":[\"Film\",\"Entertainment\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2026/la-la-land-in-concert\",\"DateDescription\":\"Thursday 31 December 2026\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#003dba\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Website-size-LA-LA-LAND-v2.png?type=image&id=6290&token=3032e7ff&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Website-size-LA-LA-LAND-v2.png?type=image&id=6290&token=3032e7ff&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Website-size-LA-LA-LAND-v2.png?type=image&id=6290&token=3032e7ff&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Website-size-LA-LA-LAND-v2.png?type=image&id=6290&token=3032e7ff&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Two dancers in front of the LA skyline, one woman in a yellow dress and one man in a suit. \",\"caption\":null},\"Performances\":[{\"ID\":\"1894-99171\",\"PerformanceNumber\":99171,\"ProductionSeasonNumber\":99152,\"Date\":\"2026-12-31T13:00:00+00:00\",\"TimeSlot\":\"Afternoon\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2025-12-05T10:00:00+00:00\",\"OffSaleDate\":\"2026-12-31T12:25:00+00:00\",\"MinimumPrice\":20.91,\"MaximumPrice\":287.25,\"WebContents\":[{\"ContentTypeId\":72,\"ContentType\":\"PT: Fine Dining \",\"Content\":\"<p>&bull;Premium Stalls seats<br />&bull;Two glasses of Champagne per person*<br />&bull;Three course brunch menu served in Coda by Eric Chavot Restaurant<br />&bull;Smoothie and filter coffee and tea</p>\\r\\n<p><br />*Alcohol can only be served after 11am</p>\",\"Inactive\":false}]},{\"ID\":\"1894-99189\",\"PerformanceNumber\":99189,\"ProductionSeasonNumber\":99152,\"Date\":\"2026-12-31T18:00:00+00:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2025-12-05T10:00:00+00:00\",\"OffSaleDate\":\"2026-12-31T17:25:00+00:00\",\"MinimumPrice\":20.91,\"MaximumPrice\":287.25,\"WebContents\":[{\"ContentTypeId\":72,\"ContentType\":\"PT: Fine Dining \",\"Content\":\"<p>*Premium stalls seat <br />*Three course dinner in Coda by Chavot Restaurant<br />*Welcome glass of Champagne and half bottle of wine per person <br />*Still &amp; Sparkling mineral water, tea or coffee</p>\",\"Inactive\":false}]}]},{\"ID\":2024,\"ProductionSeasonNumber\":100843,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2026-12-16T19:30:00Z\",\"EndDate\":\"2026-12-16T19:30:00Z\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"London Community Gospel Choir at Christmas\",\"Suffix\":\"with The Heritage Orchestra\",\"ListingIndicator\":null,\"Summary\":\"Celebrate the festive season with the London Community Gospel Choir. Expect Christmas tunes and gospel classics.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2025/Christmas/RS121094_009.jpg?type=image&id=7031&token=e12f7017&mode=fill&top=16&left=0&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2025/Christmas/RS121094_009.jpg?type=image&id=7031&token=e12f7017&mode=fill&top=22&left=0&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2025/Christmas/RS121094_009.jpg?type=image&id=7031&token=e12f7017&mode=fill&top=32&left=0&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2025/Christmas/RS121094_009.jpg?type=image&id=7031&token=e12f7017&mode=fill&top=36&left=0&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2025/Christmas/RS121094_009.jpg?type=image&id=7031&token=e12f7017&mode=fill&top=45&left=0&width=820&height=456&format=webp\",\"alt\":\"London Community Gospel Choir at Christmas singing on stage with blue lighting. \",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/production/100843\",\"Categories\":[\"Entertainment\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2026/london-community-gospel-choir-at-christmas\",\"DateDescription\":\"Wednesday 16 December 2026\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#0d2626\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2025/Christmas/RS121094_009.jpg?type=image&id=7031&token=e12f7017&mode=fill&top=22&left=0&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2025/Christmas/RS121094_009.jpg?type=image&id=7031&token=e12f7017&mode=fill&top=45&left=0&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2025/Christmas/RS121094_009.jpg?type=image&id=7031&token=e12f7017&mode=fill&top=99&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2025/Christmas/RS121094_009.jpg?type=image&id=7031&token=e12f7017&mode=fill&top=199&left=0&width=1200&height=400&format=webp\",\"alt\":\"London Community Gospel Choir at Christmas singing on stage with blue lighting. \",\"caption\":null},\"Performances\":[{\"ID\":\"2024-100903\",\"PerformanceNumber\":100903,\"ProductionSeasonNumber\":100843,\"Date\":\"2026-12-16T19:30:00+00:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-03-20T10:00:00+00:00\",\"OffSaleDate\":\"2026-12-16T18:55:00+00:00\",\"MinimumPrice\":0,\"MaximumPrice\":267.65,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":50,\"ContentType\":\"Show Promo Code Box\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p>Royal Albert Hall presents:&nbsp;<strong>London Community Gospel Choir at Christmas with The Heritage Orchestra</strong></p>\\r\\n<p>The&nbsp;<strong>London Community Gospel Choir</strong>&nbsp;is back with their annual festive party. Expect Christmas tunes and gospel classics, plus special guests.</p>\\r\\n<p>Featuring&nbsp;<strong>The</strong>&nbsp;<strong>Heritage Orchestra&nbsp;</strong>and the&nbsp;powerhouse&nbsp;<strong>London Community Gospel Choir Band</strong>&nbsp;conducted by&nbsp;<strong>Tom Richards</strong>. Don't miss out on this&nbsp;night of soulful harmonies and festive cheer.&nbsp;</p>\\r\\n<p>_____________________________________________________________________________________________</p>\\r\\n<p><strong>DYNAMIC PRICING</strong></p>\\r\\n<p>In the normal way dynamic pricing is in place at the Hall for events promoted by the Royal Philharmonic Orchestra, Cirque du Soleil and the Royal Albert Hall.</p>\\r\\n<p>This means that promoter ticket prices might fluctuate for these events (both up and down) according to demand. Dynamic, or flexible pricing, has been commonly used in the airline and hotel industry for many years and is now becoming commonplace in entertainment as well. Any prices changes will apply to all tickets sold by the Hall's Box Office&nbsp;</p>\\r\\n<p>&nbsp;</p>\",\"Inactive\":false},{\"ContentTypeId\":79,\"ContentType\":\"PT: Loggia Hospitality\",\"Content\":\"<p>*Private hire of a box for 8 guests&nbsp;<br />*Nachos, sliders and waffle fries, dessert canapes <br />*A selection of mineral water and soft drinks <br />*Luxury canap&eacute;s and a cold bowl dish served pre show <br />*Hot bowl dishes and dessert canap&eacute;s served in the interval <br />*A dedicated service waiter per box <br />*A cracker and gift per person &nbsp;</p>\",\"Inactive\":false},{\"ContentTypeId\":80,\"ContentType\":\"PT: Second Tier Hospitality\",\"Content\":\"<p>*Private hire of a box for 4 guests&nbsp;<br />*Nachos, sliders and waffle fries, dessert canapes <br />*A selection of mineral water and soft drinks <br />*Luxury canap&eacute;s and a cold bowl dish served pre show <br />*Hot bowl dishes and dessert canap&eacute;s served in the interval <br />*A dedicated service waiter per box <br />*A cracker and gift per person &nbsp;</p>\",\"Inactive\":false},{\"ContentTypeId\":126,\"ContentType\":\"PT: BSL User\",\"Content\":\"<p>  Please select the assigned seats in the Stalls which are positioned for the best view of the BSL (British Sign Language) interpreter .</p>\",\"Inactive\":false},{\"ContentTypeId\":127,\"ContentType\":\"PT: Companion - BSL\",\"Content\":\"<p>This seat is for customers who are accompanying a BSL (British Sign Language) user.</p>\",\"Inactive\":false},{\"ContentTypeId\":258,\"ContentType\":\"TNC: BSL User\",\"Content\":\"This seat is only for customers who require a view of the BSL (British Sign Language) interpreter. Please book alternative seats if you do not need this service.\",\"Inactive\":false},{\"ContentTypeId\":259,\"ContentType\":\"TNC: Companion - BSL\",\"Content\":\"This seat is only for customers who are accompanying a BSL (British Sign Language) user. Please book alternative seats if you are not accompanying a BSL user.\",\"Inactive\":false},{\"ContentTypeId\":293,\"ContentType\":\"PT: VIP Lounge\",\"Content\":\"<p>*Premium Front Arena seat (within first 7 rows) <br />*Glass of Champagne on arrival, wine, beer and soft cocktail<br />*A festive menu served pre show in the Christmas VIP Lounge</p>\",\"Inactive\":false}]}]},{\"ID\":2027,\"ProductionSeasonNumber\":100885,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2026-10-31T14:30:00Z\",\"EndDate\":\"2026-10-31T19:30:00Z\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"Maestro of the Movies: A Tribute to John Williams\",\"Suffix\":\"with the London Symphony Orchestra\",\"ListingIndicator\":null,\"Summary\":\"Experience scenes and clips from John Williams’ best-loved films, projected in HD, whilst the scores are played live-to-picture by the London Symphony Orchestra.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/JW-Star-Wars-session-photo-copy.jpg?type=image&id=7009&token=68be3a76&mode=fill&top=0&left=0&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/JW-Star-Wars-session-photo-copy.jpg?type=image&id=7009&token=68be3a76&mode=fill&top=0&left=0&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/JW-Star-Wars-session-photo-copy.jpg?type=image&id=7009&token=68be3a76&mode=fill&top=0&left=0&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/JW-Star-Wars-session-photo-copy.jpg?type=image&id=7009&token=68be3a76&mode=fill&top=0&left=0&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/JW-Star-Wars-session-photo-copy.jpg?type=image&id=7009&token=68be3a76&mode=fill&top=0&left=0&width=820&height=456&format=webp\",\"alt\":\"John WIlliams working on Star Wars\",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/production/100885\",\"Categories\":[\"Classical\",\"Film\",\"Entertainment\",\"Contemporary Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2026/maestro-of-the-movies-john-williams\",\"DateDescription\":\"Saturday 31 October 2026\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[{\"Type\":\"Person\",\"Title\":\"Edith Bowman\",\"Role\":null,\"Website\":null},{\"Type\":\"Person\",\"Title\":\"Anthony Gabriele\",\"Role\":null,\"Website\":null},{\"Type\":\"Dance Group\",\"Title\":\"London Symphony Orchestra\",\"Role\":null,\"Website\":null}],\"ThemeColor\":\"#0d2626\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/JW-Star-Wars-session-photo-copy.jpg?type=image&id=7009&token=68be3a76&mode=fill&top=0&left=0&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/JW-Star-Wars-session-photo-copy.jpg?type=image&id=7009&token=68be3a76&mode=fill&top=0&left=0&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/JW-Star-Wars-session-photo-copy.jpg?type=image&id=7009&token=68be3a76&mode=fill&top=66&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/JW-Star-Wars-session-photo-copy.jpg?type=image&id=7009&token=68be3a76&mode=fill&top=133&left=0&width=1200&height=400&format=webp\",\"alt\":\"John WIlliams working on Star Wars\",\"caption\":null},\"Performances\":[{\"ID\":\"2027-100887\",\"PerformanceNumber\":100887,\"ProductionSeasonNumber\":100885,\"Date\":\"2026-10-31T14:30:00+00:00\",\"TimeSlot\":\"Afternoon\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-03-13T10:00:00+00:00\",\"OffSaleDate\":\"2026-10-31T13:55:00+00:00\",\"MinimumPrice\":20.91,\"MaximumPrice\":272.55,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":87,\"ContentType\":\"PT: Second Tier Box Experience\",\"Content\":\"<p><br />*Private Hire of a 2nd Tier Box for 4 guests<br />*Traditional Afternoon Tea served in box <br />*Quarter bottle Champagne per person <br />*A dedicated service waiter per box</p>\",\"Inactive\":false},{\"ContentTypeId\":88,\"ContentType\":\"PT: Grand Tier Box Experience\",\"Content\":\"<p><br />*Private Hire of a Grand Tier Box for 12 guests<br />*Traditional Afternoon Tea served in box <br />*Quarter bottle Champagne per person <br />*A dedicated service waiter per box</p>\",\"Inactive\":false},{\"ContentTypeId\":89,\"ContentType\":\"PT: Loggia Box Experience\",\"Content\":\"<p><br />*Private Hire of a Loggia Box for 8 guests<br />*Traditional Afternoon Tea served in box <br />*Quarter bottle Champagne per person <br />*A dedicated service waiter per box</p>\",\"Inactive\":false}]},{\"ID\":\"2027-100888\",\"PerformanceNumber\":100888,\"ProductionSeasonNumber\":100885,\"Date\":\"2026-10-31T19:30:00+00:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-03-13T10:00:00+00:00\",\"OffSaleDate\":\"2026-10-31T18:55:00+00:00\",\"MinimumPrice\":20.91,\"MaximumPrice\":316.67,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p>Royal Albert Hall presents.</p>\\r\\n<p>Join us for the ultimate concert celebration of the man who truly has composed the soundtrack to our lives, John Williams. With selections from his most iconic scores, including&nbsp;<em>Star Wars, Indiana Jones, Harry Potter, Jaws, Close Encounters of the Third Kind, Jurassic Park, Schindler&rsquo;s List, Superman, Lincoln&nbsp;</em>and&nbsp;<em>E.T. the Extra-Terrestrial.</em></p>\\r\\n<p>Featuring more than fifty minutes of specially edited scenes and clips from John Williams&rsquo; best-loved films,&nbsp;you can now experience these scores performed live to picture by the&nbsp;<strong>London Symphony Orchestra</strong>&nbsp;conducted by&nbsp;<strong>Anthony Gabriele</strong>.&nbsp;The concert will also be presented by radio broadcaster&nbsp;<strong>Edith Bowman</strong>. This loving tribute to the greatest musical storyteller of our time is a feast for the eyes and the ears.</p><p><strong>DYNAMIC PRICING </strong></p>\\r\\n<p>In the normal way dynamic pricing is in place at the Hall for events promoted by the Royal Philharmonic Orchestra, Cirque du Soleil and the Royal Albert Hall.</p>\\r\\n<p>This means that promoter ticket prices might fluctuate for these events (both up and down) according to demand. Dynamic, or flexible pricing, has been commonly used in the airline and hotel industry for many years and is now becoming commonplace in entertainment as well. Any prices changes will apply to all tickets sold by the Hall's Box Office</p>\\r\\n<p>_______________________________________________________________________________</p>\",\"Inactive\":false},{\"ContentTypeId\":87,\"ContentType\":\"PT: Second Tier Box Experience\",\"Content\":\"<p>*Private Hire of a Second Tier box for 4 guests <br />*1/2 bottle Champagne per person <br />*1/2 bottle wine per person <br />*Canapes, bowl dishes, dessert canapes<br />*Private box waiter</p>\\r\\n\",\"Inactive\":false},{\"ContentTypeId\":89,\"ContentType\":\"PT: Loggia Box Experience\",\"Content\":\"<p>*Private Hire of a Loggia Box for 8 guests <br />*1/2 bottle Champagne per person <br />*1/2 bottle wine per person <br />*Canapes, bowl dishes, dessert canapes<br />*Private box waiter</p>\\r\\n\",\"Inactive\":false},{\"ContentTypeId\":293,\"ContentType\":\"PT: VIP Lounge\",\"Content\":\"<p><br />*Premium Arena Seating <br />*Pre and interval VIP Lounge<br />*Canapes, bowl dishes, desserts, wine, beer and soft drinks</p>\",\"Inactive\":false}]}]},{\"ID\":1942,\"ProductionSeasonNumber\":99724,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2026-09-20T19:00:00+01:00\",\"EndDate\":\"2026-09-20T19:00:00+01:00\",\"Prefix\":\"Magic Radio presents\",\"Title\":\"Magic at the Musicals\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Magic Radio returns with Magic at the Musicals, celebrating the show’s 10th anniversary in spectacular style.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/Magic_at_the_Musicals_2026_2820_1487.jpg?type=image&id=6536&token=275cfb23&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/Magic_at_the_Musicals_2026_2820_1487.jpg?type=image&id=6536&token=275cfb23&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/Magic_at_the_Musicals_2026_2820_1487.jpg?type=image&id=6536&token=275cfb23&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/Magic_at_the_Musicals_2026_2820_1487.jpg?type=image&id=6536&token=275cfb23&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/Magic_at_the_Musicals_2026_2820_1487.jpg?type=image&id=6536&token=275cfb23&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"Magic at the Musicals\",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/production/99724\",\"Categories\":[\"Musicals\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2026/magic-at-the-musicals\",\"DateDescription\":\"Sunday 20 September 2026\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#f2e861\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/Magic_at_the_Musicals_2026_2820_1487.jpg?type=image&id=6536&token=275cfb23&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/Magic_at_the_Musicals_2026_2820_1487.jpg?type=image&id=6536&token=275cfb23&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/Magic_at_the_Musicals_2026_2820_1487.jpg?type=image&id=6536&token=275cfb23&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/Magic_at_the_Musicals_2026_2820_1487.jpg?type=image&id=6536&token=275cfb23&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Magic at the Musicals\",\"caption\":null},\"Performances\":[{\"ID\":\"1942-99725\",\"PerformanceNumber\":99725,\"ProductionSeasonNumber\":99724,\"Date\":\"2026-09-20T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2025-12-19T09:00:00+00:00\",\"OffSaleDate\":\"2026-09-20T18:25:00+01:00\",\"MinimumPrice\":39.53,\"MaximumPrice\":336.27,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p>Magic Radio presents: <strong>Magic at the Musicals </strong></p>\\r\\n<p>Magic Radio returns to the Royal Albert Hall on Sunday 20 September 2026 with&nbsp;<strong>Magic at the Musicals</strong>, celebrating the show&rsquo;s 10th anniversary in spectacular style.</p>\\r\\n<p>A decade on from its debut, this much-loved concert event brings together stars from some of the biggest West End and touring productions, united on one of the world&rsquo;s most iconic stages for one unforgettable night of musical theatre.</p>\\r\\n<p>The evening will once again feature the award-winning&nbsp;<strong>London Musical Theatre Orchestra</strong>, accompanying leading performers from across the musical theatre world. Audiences can also expect some celebratory moments to mark ten years of Magic at the Musicals.</p>\\r\\n<p>The 2026 line-up will be announced soon. Previous years have featured performances from casts of<em>&nbsp;Les Mis&eacute;rables, The Phantom of the Opera, Oliver!, The Bodyguard, Cabaret, Wicked, Disney&rsquo;s The Lion King, Matilda The Musical, Starlight Express</em>&nbsp;and many more.</p>\\r\\n<p>A must-see event for musical theatre fans of all ages, Magic at the Musicals promises a great celebration of the shows you love, brought to life in one truly magical evening.</p>\\r\\n<div>\\r\\n<p><em>For more announcements on the show and to hear all the news first, listen to Magic Radio nationally on DAB digital radio, on the Rayo App, online, in London on 105.4FM, or ask your smart speaker to &lsquo;Play Magic Radio&rsquo;.</em></p>\\r\\n<p><em>If you are a musical fan you can listen to Magic Radio&rsquo;s digital radio station, Magic Musicals.</em></p>\\r\\n</div>\",\"Inactive\":false},{\"ContentTypeId\":87,\"ContentType\":\"PT: Second Tier Box Experience\",\"Content\":\"<p><strong>Includes:</strong></p>\\r\\n<p>Private hire of a Second Tier box for 4 people</p>\\r\\n<p>Half bottle of Champagne, half bottle wine, mineral water</p>\\r\\n<p>A selection of soft drinks</p>\\r\\n<p>Canapes and bowl dishes served pre show</p>\\r\\n<p>Desserts served in the interval</p>\\r\\n<p>Box Waiter</p>\",\"Inactive\":false},{\"ContentTypeId\":89,\"ContentType\":\"PT: Loggia Box Experience\",\"Content\":\"<p><strong>Includes:</strong></p>\\r\\n<p>Private hire of a Loggia box for 8 people</p>\\r\\n<p>Half bottle of Champagne, half bottle wine, mineral water</p>\\r\\n<p>A selection of soft drinks</p>\\r\\n<p>Canapes and bowl dishes served pre show</p>\\r\\n<p>Desserts served in the interval</p>\\r\\n<p>Box Waiter</p>\",\"Inactive\":false},{\"ContentTypeId\":118,\"ContentType\":\"PT: Hospitality Dining\",\"Content\":\"<p><strong>Includes: </strong></p>\\r\\n<p>Arena Seat</p>\\r\\n<p>Three course dinner in Coda by Chavot Restaurant</p>\\r\\n<p>Welcome glass of Champagne and half bottle of wine per person</p>\\r\\n<p>Programme per person</p>\",\"Inactive\":false},{\"ContentTypeId\":146,\"ContentType\":\"Pre-sale T&C Checkbox\",\"Content\":\"Tickets purchased through Priority Booking are strictly for your own personal use and may not be transferred or sold.\",\"Inactive\":false}]}]},{\"ID\":1828,\"ProductionSeasonNumber\":98155,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2026-10-30T18:30:00Z\",\"EndDate\":\"2026-10-30T18:30:00Z\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"Matilda in Concert (PG)\",\"Suffix\":\"Hosted and narrated live by Danny DeVito\",\"ListingIndicator\":null,\"Summary\":\"See the classic film like never before, hosted and narrated live by Matilda director, producer and star Danny DeVito.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Matilda-in-Concert/Matilda-2.jpg?type=image&id=5606&token=c069107d&mode=fill&top=1&left=0&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Matilda-in-Concert/Matilda-2.jpg?type=image&id=5606&token=c069107d&mode=fill&top=1&left=0&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Matilda-in-Concert/Matilda-2.jpg?type=image&id=5606&token=c069107d&mode=fill&top=1&left=0&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Matilda-in-Concert/Matilda-2.jpg?type=image&id=5606&token=c069107d&mode=fill&top=2&left=0&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Matilda-in-Concert/Matilda-2.jpg?type=image&id=5606&token=c069107d&mode=fill&top=2&left=0&width=820&height=456&format=webp\",\"alt\":null