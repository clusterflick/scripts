":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-60-Berlin-Philharmonic-Plays-Elgar-and-Tchaikovsky-2820-x-1480-SEP-2.jpg?type=image&id=7213&token=4f32da31\",\"Inactive\":false}]}]},{\"ID\":2195,\"ProductionSeasonNumber\":102885,\"PerformanceNumber\":102887,\"WishlistNumber\":null,\"StartDate\":\"2027-04-22T19:30:00+01:00\",\"EndDate\":\"2027-04-22T19:30:00+01:00\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"Jess Gillam\",\"Suffix\":\"with new music for Earth Day by Anoushka Shankar, Jamie Cullum and more\",\"ListingIndicator\":null,\"Summary\":\"Acclaimed Saxophonist and BBC Radio broadcaster Jess Gillam performs on Earth Day with the BBC Concert Orchestra, conducted by Tom Richards.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2026/Jess-Gillam/Jess-Gillam_2026_Andy-Paradise_2820x1880.jpg?type=image&id=7769&token=db3a79d6&mode=fill&top=17&left=0&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2026/Jess-Gillam/Jess-Gillam_2026_Andy-Paradise_2820x1880.jpg?type=image&id=7769&token=db3a79d6&mode=fill&top=22&left=0&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2026/Jess-Gillam/Jess-Gillam_2026_Andy-Paradise_2820x1880.jpg?type=image&id=7769&token=db3a79d6&mode=fill&top=33&left=0&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2026/Jess-Gillam/Jess-Gillam_2026_Andy-Paradise_2820x1880.jpg?type=image&id=7769&token=db3a79d6&mode=fill&top=36&left=0&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2026/Jess-Gillam/Jess-Gillam_2026_Andy-Paradise_2820x1880.jpg?type=image&id=7769&token=db3a79d6&mode=fill&top=45&left=0&width=820&height=456&format=webp\",\"alt\":\"Jess Gillam holding an alto saxophone surrounded by plants\",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/booking/production/102887\",\"Categories\":[\"Classical\",\"Talk\",\"Contemporary Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2027/jess-gillam\",\"DateDescription\":\"Thursday 22 April 2027\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#0d2626\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2026/Jess-Gillam/Jess-Gillam_2026_Andy-Paradise_2820x1880.jpg?type=image&id=7769&token=db3a79d6&mode=fill&top=22&left=0&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2026/Jess-Gillam/Jess-Gillam_2026_Andy-Paradise_2820x1880.jpg?type=image&id=7769&token=db3a79d6&mode=fill&top=45&left=0&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2026/Jess-Gillam/Jess-Gillam_2026_Andy-Paradise_2820x1880.jpg?type=image&id=7769&token=db3a79d6&mode=fill&top=100&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2026/Jess-Gillam/Jess-Gillam_2026_Andy-Paradise_2820x1880.jpg?type=image&id=7769&token=db3a79d6&mode=fill&top=200&left=0&width=1200&height=400&format=webp\",\"alt\":\"Jess Gillam holding an alto saxophone surrounded by plants\",\"caption\":null},\"Performances\":[{\"ID\":\"2195-102887\",\"PerformanceNumber\":102887,\"ProductionSeasonNumber\":102885,\"Date\":\"2027-04-22T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-07-03T10:00:00+01:00\",\"OffSaleDate\":\"2027-04-22T18:55:00+01:00\",\"MinimumPrice\":20.91,\"MaximumPrice\":238.24,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p>Acclaimed Saxophonist and BBC Radio broadcaster <strong>Jess Gillam</strong> celebrates <strong>Earth Day</strong> with the <strong>BBC Concert Orchestr</strong>a, conducted by <strong>Tom Richard</strong>s.&nbsp;</p>\\r\\n<p>From the chirruping and trilling of a skylark to the subsonic hum of dolphins, there is music everywhere on earth. This special evening will feature world premieres inspired by our natural planet, written by <strong>Jamie Cullum, Tan Dun, Rachel Portman, Anoushka Shankar </strong>and <strong>Eunike Tanzil</strong>.</p>\\r\\n<p>Showcasing Jess' incredible artistry as a saxophonist and presenter, the concert spans classical and contemporary music highlighting the beauty, power and fragility of our planet.</p>\\r\\n<p><strong>DYNAMIC PRICING&nbsp;</strong></p>\\r\\n<p>In the normal way dynamic pricing is in place at the Hall for events promoted by the <strong>Royal Philharmonic Orchestra, Cirque du Soleil</strong> and the <strong>Royal Albert Hall.&nbsp;</strong></p>\\r\\n<p>This means that promoter ticket prices might fluctuate for these events (both up and down) according to demand. Dynamic, or flexible pricing, has been commonly used in the airline and hotel industry for many years and is now becoming commonplace in entertainment as well. Any prices changes will apply to all tickets sold by the Hall's Box Office&nbsp;</p>\\r\\n<p>---------------------------------------------------------------------</p>\",\"Inactive\":false},{\"ContentTypeId\":72,\"ContentType\":\"PT: Fine Dining \",\"Content\":\"<p>To include:</p>\\r\\n<p>*Front Arena seat <br />*Glass of Champagne on arrival <br />*Three course meal in Coda</p>\",\"Inactive\":false},{\"ContentTypeId\":79,\"ContentType\":\"PT: Loggia Hospitality\",\"Content\":\"<p>To include:</p>\\r\\n<p>*Private Hire of a Loggia Box for 8 guests Box <br />*Cold bowl dish, Nachos and sliders, with wine and soft drinks<br />*Box Waiter</p>\",\"Inactive\":false},{\"ContentTypeId\":80,\"ContentType\":\"PT: Second Tier Hospitality\",\"Content\":\"<p>To include:</p>\\r\\n<p>*Private Hire of a Second Tier Box for r guests Box <br />*Cold bowl dish, Nachos and sliders, with wine and soft drinks<br />*Box Waiter</p>\",\"Inactive\":false}]}]},{\"ID\":2217,\"ProductionSeasonNumber\":102916,\"PerformanceNumber\":102919,\"WishlistNumber\":null,\"StartDate\":\"2026-12-08T19:30:00Z\",\"EndDate\":\"2026-12-08T19:30:00Z\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"Anna Lapwood's Christmas\",\"Suffix\":\"with the Royal Philharmonic Concert Orchestra\",\"ListingIndicator\":null,\"Summary\":\"Join Organist of the Royal Albert Hall Anna Lapwood this Christmas for a night of festivities. Featuring new arrangements of Christmas classics and music from some of the most beloved films of recent decades.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2025/Anna-Lapwood-Christmas/RS121549_010_wep.jpg?type=image&id=7775&token=edbde59f&mode=fill&top=16&left=0&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Events/Auditorium/2025/Anna-Lapwood-Christmas/RS121549_010_wep.jpg?type=image&id=7775&token=edbde59f&mode=fill&top=22&left=0&width=410&height=228&format=webp\",\"w600\":\"https: