:\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-34-Evelyn-Glennie-and-the-Fantasia-Orchestra-2820-x-1480-AUG-11.jpg?type=image&id=7187&token=34269e8f&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-34-Evelyn-Glennie-and-the-Fantasia-Orchestra-2820-x-1480-AUG-11.jpg?type=image&id=7187&token=34269e8f&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-34-Evelyn-Glennie-and-the-Fantasia-Orchestra-2820-x-1480-AUG-11.jpg?type=image&id=7187&token=34269e8f&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-34-Evelyn-Glennie-and-the-Fantasia-Orchestra-2820-x-1480-AUG-11.jpg?type=image&id=7187&token=34269e8f&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Evelyn Glennie\",\"caption\":\"Evelyn Glennie © Philipp Rathme and Brigitte\"},\"Performances\":[{\"ID\":\"2100-101123\",\"PerformanceNumber\":101123,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-08-11T22:15:00+01:00\",\"TimeSlot\":\"Late Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-08-11T21:40:00+01:00\",\"MinimumPrice\":5.1,\"MaximumPrice\":37,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-34-Evelyn-Glennie-and-the-Fantasia-Orchestra-2820-x-1480-AUG-11.jpg?type=image&id=7187&token=34269e8f\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>Grammy Award-winning percussionist&nbsp;<strong>Dame Evelyn Glennie</strong>&nbsp;joins the&nbsp;<strong>Fantasia Orchestra</strong>&nbsp;and&nbsp;<strong>BBC Singers</strong>&nbsp;for a genre-busting evening. The programme connecting&nbsp;<strong>Vaughan Williams</strong>&rsquo;s lyrical&nbsp;<em>Serenade for Music</em>&nbsp;&ndash; written for Proms founder-conductor&nbsp;<strong>Henry Wood</strong>&nbsp;&ndash; via&nbsp;<strong>Radiohead</strong>&nbsp;and the jazz of&nbsp;<strong>John Coltrane</strong>&nbsp;and&nbsp;<strong>Duke Ellington</strong>&nbsp;to the exhilarating invention of&nbsp;<strong>Caroline Shaw</strong>&rsquo;s Pulitzer Prize-winning&nbsp;<em>Partita</em>.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme to include:</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Caroline Shaw</strong>&nbsp;Partita &ndash; Sarabande&nbsp;<em>5&rsquo;</em>&nbsp;<br /><strong>H&eacute;lo&iuml;se Werner</strong>&nbsp;new work&nbsp;<em>c5&rsquo;</em><br /><em>BBC commission: world premiere</em><br /><strong>Vaughan Williams, arr. R. Douglas</strong>&nbsp;Serenade to Music&nbsp;<em>14&rsquo;</em><br /><strong>Radiohead, arr. Simon Hale</strong>&nbsp;Pyramid Song&nbsp;<em>5&rsquo;</em><br /><em>And works by John Coltrane, Duke Ellington, Vincent Ho and Philip Sheppard</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Evelyn Glennie&nbsp;</strong><em>percussion</em></p>\\r\\n<p><strong>BBC Singers</strong><br /><strong>Fantasia Orchestra</strong><br /><strong>Tom Fetherstonhaugh</strong>&nbsp;<em>conductor</em></p>\\r\\n<p><em>There will be no interval.</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2242,\"ProductionSeasonNumber\":102914,\"PerformanceNumber\":102915,\"WishlistNumber\":null,\"StartDate\":\"2026-10-15T19:30:00+01:00\",\"EndDate\":\"2026-10-15T19:30:00+01:00\",\"Prefix\":\"SJM Concerts presents\",\"Title\":\"Brandon Flowers\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Following the announcement of THRASHER, his highly anticipated third solo album and first in over a decade, The Killers’ Brandon Flowers is coming to the Hall in October.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brandon-Flowers-2820x1487.png?type=image&id=7774&token=3358ce7d&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brandon-Flowers-2820x1487.png?type=image&id=7774&token=3358ce7d&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brandon-Flowers-2820x1487.png?type=image&id=7774&token=3358ce7d&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brandon-Flowers-2820x1487.png?type=image&id=7774&token=3358ce7d&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brandon-Flowers-2820x1487.png?type=image&id=7774&token=3358ce7d&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"Brandon Flowers\",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/booking/production/102915\",\"Categories\":[\"Rock and Pop\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2026/brandon-flowers\",\"DateDescription\":\"Thursday 15 October 2026\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#8c52de\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brandon-Flowers-2820x1487.png?type=image&id=7774&token=3358ce7d&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brandon-Flowers-2820x1487.png?type=image&id=7774&token=3358ce7d&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brandon-Flowers-2820x1487.png?type=image&id=7774&token=3358ce7d&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brandon-Flowers-2820x1487.png?type=image&id=7774&token=3358ce7d&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Brandon Flowers\",\"caption\":null},\"Performances\":[{\"ID\":\"2242-102915\",\"PerformanceNumber\":102915,\"ProductionSeasonNumber\":102914,\"Date\":\"2026-10-15T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":false,\"OnSaleDate\":\"2026-07-03T10:00:00+01:00\",\"OffSaleDate\":\"2026-10-15T18:55:00+01:00\",\"MinimumPrice\":35,\"MaximumPrice\":85,\"WebContents\":[{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"4\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p>Brandon Flowers comes to the Hall in celebration of his new country &amp; western album, Thrasher, his first solo album in 11 years.&nbsp;</p>\\r\\n<p>Following the announcement of <em>THRASHER</em>, his highly anticipated third solo album and first in over a decade, The Killers&rsquo; <strong>Brandon Flowers</strong> is coming to the Hall in October.</p>\\r\\n<p>Fans can look forward to hearing songs from <em>THRASHER</em> played live for the first time alongside highlights from Flowers&rsquo; UK chart-topping solo albums, <em>Flamingo </em>(2010) and <em>The Desired Effec</em>t (2015), as well as beloved tracks from The Killers&rsquo; celebrated catalogue.&nbsp;</p>\\r\\n<p>The concert is set to be a particularly special occasion, marking Flowers&rsquo;s first full performance at the venue since The Killers&rsquo; legendary 2009 shows.&nbsp;</p>\",\"Inactive\":false}]}]},{\"ID\":1835,\"ProductionSeasonNumber\":98122,\"PerformanceNumber\":98123,\"WishlistNumber\":null,\"StartDate\":\"2026-10-02T19:00:00+01:00\",\"EndDate\":\"2026-10-02T19:00:00+01:00\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"Brassed Off Live (15)\",\"Suffix\":\"with the Grimethorpe Colliery Band\",\"ListingIndicator\":null,\"Summary\":\"The British classic returns to its spiritual home, for a special 30th anniversary screening with live brass band and orchestra.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brassed-Off/web-thumbnail.jpg?type=image&id=5886&token=a9ea4eff&mode=fill&top=0&left=0&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brassed-Off/web-thumbnail.jpg?type=image&id=5886&token=a9ea4eff&mode=fill&top=0&left=0&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brassed-Off/web-thumbnail.jpg?type=image&id=5886&token=a9ea4eff&mode=fill&top=0&left=0&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brassed-Off/web-thumbnail.jpg?type=image&id=5886&token=a9ea4eff&mode=fill&top=0&left=0&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brassed-Off/web-thumbnail.jpg?type=image&id=5886&token=a9ea4eff&mode=fill&top=0&left=0&width=820&height=456&format=webp\",\"alt\":null,\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/booking/production/98123\",\"Categories\":[\"Film\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2026/brassed-off-live\",\"DateDescription\":\"Friday 2 October 2026\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#d72020\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brassed-Off/web-thumbnail.jpg?type=image&id=5886&token=a9ea4eff&mode=fill&top=0&left=0&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brassed-Off/web-thumbnail.jpg?type=image&id=5886&token=a9ea4eff&mode=fill&top=0&left=0&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brassed-Off/web-thumbnail.jpg?type=image&id=5886&token=a9ea4eff&mode=fill&top=66&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brassed-Off/web-thumbnail.jpg?type=image&id=5886&token=a9ea4eff&mode=fill&top=133&left=0&width=1200&height=400&format=webp\",\"alt\":null,\"caption\":null},\"Performances\":[{\"ID\":\"1835-98123\",\"PerformanceNumber\":98123,\"ProductionSeasonNumber\":98122,\"Date\":\"2026-10-02T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":false,\"OnSaleDate\":\"2025-10-10T10:00:00+01:00\",\"OffSaleDate\":\"2026-10-02T18:25:00+01:00\",\"MinimumPrice\":20.91,\"MaximumPrice\":267.65,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":50,\"ContentType\":\"Show Promo Code Box\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":63,\"ContentType\":\"T&C Checkbox\",\"Content\":\"This film is rated 15\",\"Inactive\":false},{\"ContentTypeId\":65,\"ContentType\":\"Members - Web Image URL\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Brassed-Off/1797.jpg?type=image&id=5593&token=59937dc7\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p><span style=\\\"color: black;\\\">Royal Albert Hall presents: </span></p><p><strong style=\\\"color: black;\\\">Brassed Off Live (15)with the Grimethorpe Colliery Band </strong></p><p><span style=\\\"color: black;\\\">British classic </span><em style=\\\"color: black;\\\">Brassed Off </em><span style=\\\"color: black;\\\">returns to its spiritual home, the Royal Albert Hall, for a special 30th anniversary screening with live accompaniment from the brass band that inspired the story. The beloved Films in Concert version returns to where it all began, after selling out its world premiere here in 2017 and playing to packed houses on a national tour. </span></p><p><span style=\\\"color: black;\\\">Relive a piece of British cinema history as the </span><strong style=\\\"color: black;\\\">Grimethorpe Colliery Band</strong><span style=\\\"color: black;\\\"> and members of the </span><strong style=\\\"color: black;\\\">Academy of St Martin in the Fields </strong><span style=\\\"color: black;\\\">under the baton of </span><strong style=\\\"color: black;\\\">Ben Palmer</strong><span style=\\\"color: black;\\\"> perform the score live alongside the film on the big screen, in the iconic venue at the film’s heart. </span></p><p><span style=\\\"color: black;\\\">Plus, enjoy an exclusive Q&amp;A before the show with director </span><strong style=\\\"color: black;\\\">Mark Herman</strong><span style=\\\"color: black;\\\"> and producer </span><strong style=\\\"color: black;\\\">Steve Abbott. </strong></p><p><span style=\\\"color: black;\\\">This 1996 bittersweet comedy-drama, written and directed by Mark Herman, stars Pete Postlethwaite as Danny, the devoted leader of the Grimley Colliery Band, who is determined to show the Tories ‘we are not defeated’. Ewan McGregor, Stephen Tompkinson and Tara Fitzgerald are just some of the stand-outs in an impressive ensemble cast.&nbsp;</span></p><p><br></p><p><br></p><p><strong style=\\\"color: black;\\\">DYNAMIC PRICING </strong></p><p><span style=\\\"color: black;\\\">In the normal way dynamic pricing is in place at the Hall for events promoted by the Royal Philharmonic Orchestra, Cirque du Soleil and the Royal Albert Hall. </span></p><p><span style=\\\"color: black;\\\">This means that promoter ticket prices might fluctuate for these events (both up and down) according to demand. Dynamic, or flexible pricing, has been commonly used in the airline and hotel industry for many years and is now becoming commonplace in entertainment as well. Any prices changes will apply to all tickets sold by the Hall's Box Office </span></p><p><span style=\\\"color: black;\\\">____________________________________________________________________________________________&nbsp;</span></p>\",\"Inactive\":false},{\"ContentTypeId\":72,\"ContentType\":\"PT: Fine Dining \",\"Content\":\"<p>*Premium Stalls Seating&nbsp;</p><p>*Three course dinner in Coda by Chavot Restaurant</p><p>*Welcome glass of champagne and half bottle of wine per person&nbsp;</p><p>*Still &amp; Sparkling mineral water</p>\",\"Inactive\":false},{\"ContentTypeId\":79,\"ContentType\":\"PT: Loggia Hospitality\",\"Content\":\"<p>*Private Hire of a Loggia box for 8 guests </p><p>*Half bottle wine and mineral water per person</p><p>*Cold bowl dish, loaded nachos, sliders and fries and desserts&nbsp;</p><p>*Popcorn&nbsp;</p><p>*Box Waiter&nbsp;</p>\",\"Inactive\":false},{\"ContentTypeId\":80,\"ContentType\":\"PT: Second Tier Hospitality\",\"Content\":\"<p>*Private Hire of a Second Tier box for 4 guests </p><p>*Half bottle wine and mineral water per person</p><p>*Cold bowl dish, loaded nachos, sliders and fries and desserts&nbsp;</p><p>*Popcorn&nbsp;</p><p>*Box Waiter&nbsp;</p>\",\"Inactive\":false},{\"ContentTypeId\":366,\"ContentType\":\"STC: Standing Room\",\"Content\":\"You are buying a standing space in the Gallery. We expect standing to be popular for this event so there may be more than one row. Standing spaces are on a first come first served basis.\",\"Inactive\":false}]}]},{\"ID\":2064,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101104,\"WishlistNumber\":447,\"StartDate\":\"2026-07-17T19:00:00+01:00\",\"EndDate\":\"2026-07-17T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: First Night of the Proms 2026\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Piano superstar Yunchan Lim joins Dalia Stasevska and the BBC Symphony Orchestra for Ravel’s bluesy Concerto in G major. We also hear music by Copland, Gershwin and Finzi, alongside a world premiere from French-British composer Josephine Stephenson.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-1-First-Night-of-the-Proms-2820-x-1480-JUL-17.jpg?type=image&id=7227&token=b4834a46&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-1-First-Night-of-the-Proms-2820-x-1480-JUL-17.jpg?type=image&id=7227&token=b4834a46&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-1-First-Night-of-the-Proms-2820-x-1480-JUL-17.jpg?type=image&id=7227&token=b4834a46&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-1-First-Night-of-the-Proms-2820-x-1480-JUL-17.jpg?type=image&id=7227&token=b4834a46&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-1-First-Night-of-the-Proms-2820-x-1480-JUL-17.jpg?type=image&id=7227&token=b4834a46&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Dalia Stasevska\",\"caption\":\"Dalia Stasevska © Veikko Kähkönen \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"