[{\"ContentTypeId\":9,\"ContentType\":\"Web Max Quantity Production\",\"Content\":\"10000\",\"Inactive\":false},{\"ContentTypeId\":43,\"ContentType\":\"Performance T&C's\",\"Content\":\"Coffee & Pastries to be served before the concert. The Elgar Room is unreserved table seating assigned on the day. It is very likely you will be asked to share a table with other patrons. Programme is subject to change.  Not recommend for under 5s\",\"Inactive\":false},{\"ContentTypeId\":67,\"ContentType\":\"Venue Name\",\"Content\":\"Elgar Room\",\"Inactive\":false},{\"ContentTypeId\":151,\"ContentType\":\"AppleWallet_Venue\",\"Content\":\"Elgar Room\",\"Inactive\":false},{\"ContentTypeId\":153,\"ContentType\":\"AppleWallet_Terms\",\"Content\":\"Coffee & Pastries to be served before the concert. The Elgar Room is unreserved table seating assigned on the day. It is very likely you will be asked to share a table with other patrons. Programme is subject to change.  Not recommend for under 5s\",\"Inactive\":false},{\"ContentTypeId\":407,\"ContentType\":\"OLD BA\",\"Content\":\"yes\",\"Inactive\":false}]}]},{\"ID\":2131,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101153,\"WishlistNumber\":447,\"StartDate\":\"2026-09-01T19:30:00+01:00\",\"EndDate\":\"2026-09-01T19:30:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Rachmaninov’s Third Piano Concerto\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Jakub Hrůša and the BBC Symphony Orchestra join Czech pianist Lukáš Vondráček for this Everest of Romantic piano concertos. Bookending the concert are Kaprálová’s Suita rustica and Janáček’s best-loved orchestral work, the Sinfonietta.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-59-Rachmaninovs-Third-Piano-Concerto-2820-x-1480-SEP-1.jpg?type=image&id=7212&token=272b4580&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-59-Rachmaninovs-Third-Piano-Concerto-2820-x-1480-SEP-1.jpg?type=image&id=7212&token=272b4580&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-59-Rachmaninovs-Third-Piano-Concerto-2820-x-1480-SEP-1.jpg?type=image&id=7212&token=272b4580&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-59-Rachmaninovs-Third-Piano-Concerto-2820-x-1480-SEP-1.jpg?type=image&id=7212&token=272b4580&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-59-Rachmaninovs-Third-Piano-Concerto-2820-x-1480-SEP-1.jpg?type=image&id=7212&token=272b4580&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Lukás Vondráček\",\"caption\":\"Lukás Vondráček © Tat Keng Tey \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/rachmaninovs-third-piano-concerto\",\"DateDescription\":\"Tuesday 1 September 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#342a83\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-59-Rachmaninovs-Third-Piano-Concerto-2820-x-1480-SEP-1.jpg?type=image&id=7212&token=272b4580&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-59-Rachmaninovs-Third-Piano-Concerto-2820-x-1480-SEP-1.jpg?type=image&id=7212&token=272b4580&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-59-Rachmaninovs-Third-Piano-Concerto-2820-x-1480-SEP-1.jpg?type=image&id=7212&token=272b4580&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-59-Rachmaninovs-Third-Piano-Concerto-2820-x-1480-SEP-1.jpg?type=image&id=7212&token=272b4580&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Lukás Vondráček\",\"caption\":\"Lukás Vondráček © Tat Keng Tey \"},\"Performances\":[{\"ID\":\"2131-101153\",\"PerformanceNumber\":101153,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-09-01T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":false,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-09-01T18:55:00+01:00\",\"MinimumPrice\":7.23,\"MaximumPrice\":68,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-59-Rachmaninovs-Third-Piano-Concerto-2820-x-1480-SEP-1.jpg?type=image&id=7212&token=272b4580\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>An afternoon spent listening to a military band in a Bohemian park inspired the arresting fanfares and jagged folk-rhythms of&nbsp;<strong>Jan&aacute;cek</strong>&rsquo;s last and best-loved orchestral work, composed 100 years ago, the&nbsp;<em>Sinfonietta</em>: less a conventional symphony than a sequence of sonic frescoes.</p>\\r\\n<p><strong>Jakub Hru&scaron;a</strong>&nbsp;and the&nbsp;<strong>BBC Symphony Orchestra</strong>&nbsp;are joined by &lsquo;extraordinary&rsquo; Czech pianist&nbsp;<strong>Luk&aacute;&scaron; Vondr&aacute;cek</strong>&nbsp;for the Everest of Romantic piano concertos &ndash;&nbsp;<strong>Rachmaninov</strong>&rsquo;s&nbsp;<em>Third</em>, for many years performed only by the composer himself.</p>\\r\\n<p>The concert opens with the haunting folk melodies and dancing rhythms of&nbsp;<strong>Kapr&aacute;lov&aacute;</strong>&rsquo;s&nbsp;<em>Suita rustica</em>.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Kapr&aacute;lov&aacute;</strong>&nbsp;Suita rustica&nbsp;<em>16&rsquo;&nbsp;</em><br /><strong>Rachmaninov</strong>&nbsp;Piano Concerto No. 3 in D minor&nbsp;<em>40&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Jan&aacute;cek</strong>&nbsp;Sinfonietta&nbsp;<em>24&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Luk&aacute;s Vondr&aacute;cek&nbsp;</strong><em>piano</em></p>\\r\\n<p><strong>BBC Symphony Orchestra</strong><br /><strong>Jakub Hru&scaron;a</strong>&nbsp;<em>conductor</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2088,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101139,\"WishlistNumber\":447,\"StartDate\":\"2026-08-03T19:00:00+01:00\",\"EndDate\":\"2026-08-03T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Rachmaninov’s ‘Paganini’ Variations\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Kirill Gerstein is soloist in Rachmaninov’s glittering Rhapsody on a Theme of Paganini. He joins Thomas Søndergård and the Royal Scottish National Orchestra, who also perform Shostakovich’s Symphony No. 11 and Knussen’s Flourish with Fireworks.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-23-Rachmaninovs-Paganini-Variations-2820-x-1480-AUG-3.jpg?type=image&id=7176&token=33b856bc&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-23-Rachmaninovs-Paganini-Variations-2820-x-1480-AUG-3.jpg?type=image&id=7176&token=33b856bc&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-23-Rachmaninovs-Paganini-Variations-2820-x-1480-AUG-3.jpg?type=image&id=7176&token=33b856bc&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-23-Rachmaninovs-Paganini-Variations-2820-x-1480-AUG-3.jpg?type=image&id=7176&token=33b856bc&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-23-Rachmaninovs-Paganini-Variations-2820-x-1480-AUG-3.jpg?type=image&id=7176&token=33b856bc&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Thomas Søndergård\",\"caption\":\"Thomas Søndergård © Andy Buchanan  \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/rachmaninovs-paganini-variations\",\"DateDescription\":\"Monday 3 August 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#342a83\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-23-Rachmaninovs-Paganini-Variations-2820-x-1480-AUG-3.jpg?type=image&id=7176&token=33b856bc&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-23-Rachmaninovs-Paganini-Variations-2820-x-1480-AUG-3.jpg?type=image&id=7176&token=33b856bc&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-23-Rachmaninovs-Paganini-Variations-2820-x-1480-AUG-3.jpg?type=image&id=7176&token=33b856bc&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-23-Rachmaninovs-Paganini-Variations-2820-x-1480-AUG-3.jpg?type=image&id=7176&token=33b856bc&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Thomas Søndergård\",\"caption\":\"Thomas Søndergård © Andy Buchanan  \"},\"Performances\":[{\"ID\":\"2088-101139\",\"PerformanceNumber\":101139,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-08-03T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-08-03T18:25:00+01:00\",\"MinimumPrice\":7.23,\"MaximumPrice\":68,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12 \",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-23-Rachmaninovs-Paganini-Variations-2820-x-1480-AUG-3.jpg?type=image&id=7176&token=33b856bc\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>Once described as &lsquo;a film score without a film&rsquo;,&nbsp;<strong>Shostakovich</strong>&rsquo;s&nbsp;<em>Symphony No. 11&nbsp;</em>is subtitled &lsquo;The Year 1905&rsquo;. The work&rsquo;s four movements pay vivid homage to the First Russian Revolution, plunging listeners into the violence of its Bloody Sunday massacre and the grief and anger that followed.</p>\\r\\n<p><strong>Kirill Gerstein</strong>&nbsp;is the soloist in&nbsp;<strong>Rachmaninov</strong>&rsquo;s glittering&nbsp;<em>Rhapsody on a Theme of Paganini</em>&nbsp;&ndash; a set of virtuoso variations on a devilish theme, while&nbsp;<strong>Oliver Knussen</strong>&nbsp;pays tribute to Stravinsky in his gilded fanfare&nbsp;<em>Flourish with Fireworks</em>.&nbsp;</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Knussen</strong>&nbsp;Flourish with Fireworks&nbsp;<em>4&rsquo;&nbsp;</em><br /><strong>Rachmaninov</strong>&nbsp;Rhapsody on a Theme of Paganini<em>&nbsp;22&rsquo;&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Shostakovich&nbsp;</strong>Symphony No. 11 in G minor, &lsquo;The Year 1905&rsquo;&nbsp;<em>55&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Kirill Gerstein&nbsp;</strong><em>piano</em></p>\\r\\n<p><strong>Royal Scottish National Orchestra&nbsp;</strong><br /><strong>Thomas S&oslash;nderg&aring;rd</strong>&nbsp;<em>conductor&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2139,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101113,\"WishlistNumber\":447,\"StartDate\":\"2026-09-07T19:00:00+01:00\",\"EndDate\":\"2026-09-07T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Rattle Conducts Schumann\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Robert Schumann is in the spotlight for Sir Simon Rattle and the Freiburg Baroque Orchestra, who present the overture to Genoveva, his much-loved Second Symphony and – with soloist Isabelle Faust – his enigmatic Violin Concerto.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-67-Rattle-Conducts-Schumann-2820-x-1480-SEP-7.jpg?type=image&id=7220&token=ddb6062b&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-67-Rattle-Conducts-Schumann-2820-x-1480-SEP-7.jpg?type=image&id=7220&token=ddb6062b&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-67-Rattle-Conducts-Schumann-2820-x-1480-SEP-7.jpg?type=image&id=7220&token=ddb6062b&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-67-Rattle-Conducts-Schumann-2820-x-1480-SEP-7.jpg?type=image&id=7220&token=ddb6062b&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-67-Rattle-Conducts-Schumann-2820-x-1480-SEP-7.jpg?type=image&id=7220&token=ddb6062b&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Isabelle Faust\",\"caption\":\"Isabelle Faust © Marco Borggreve\"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/rattle-conducts-schumann\",\"DateDescription\":\"Monday 7 September 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#f5d8e9\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-67-Rattle-Conducts-Schumann-2820-x-1480-SEP-7.jpg?type=image&id=7220&token=ddb6062b&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-67-Rattle-Conducts-Schumann-2820-x-1480-SEP-7.jpg?type=image&id=7220&token=ddb6062b&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-67-Rattle-Conducts-Schumann-2820-x-1480-SEP-7.jpg?type=image&id=7220&token=ddb6062b&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-67-Rattle-Conducts-Schumann-2820-x-1480-SEP-7.jpg?type=image&id=7220&token=ddb6062b&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Isabelle Faust\",\"caption\":\"Isabelle Faust © Marco Borggreve\"},\"Performances\":[{\"ID\":\"2139-101113\",\"PerformanceNumber\":101113,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-09-07T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-09-07T18:25:00+01:00\",\"MinimumPrice\":13,\"MaximumPrice\":86,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-67-Rattle-Conducts-Schumann-2820-x-1480-SEP-7.jpg?type=image&id=7220&token=ddb6062b\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>The elusive, troubled visionary&nbsp;<strong>Robert Schumann</strong>&nbsp;is in the spotlight for&nbsp;<strong>Sir Simon Rattle</strong>&nbsp;and the&nbsp;<strong>Freiburg Baroque Orchestra&nbsp;</strong>&ndash; &lsquo;one of the most polished period-instrument ensembles in the world&rsquo; &ndash; which brings its distinctive tang and timbre to three of the composer&rsquo;s best-loved works.</p>\\r\\n<p>Joy and despair, sanity and madness are in constant conflict through Schumann&rsquo;s music, a battle that yields a glorious C major resolution in the overture from&nbsp;<em>Genoveva</em>&nbsp;and a profound, resilient optimism in the rich&nbsp;<em>Second Symphony</em>. But peace is harder to come by in the enigmatic&nbsp;<em>Violin Concerto</em>, composed on the brink of the composer&rsquo;s final mental collapse.</p>\\r\\n<p><strong>Isabelle Faust</strong>&nbsp;is the soloist.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Schumann</strong>&nbsp;Genoveva &ndash; overture&nbsp;<em>10&rsquo;</em><br /><strong>Schumann</strong>&nbsp;Violin Concerto in D minor&nbsp;<em>33&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Schumann&nbsp;</strong>Symphony No. 2 in C major&nbsp;<em>38&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Isabelle Faust&nbsp;</strong><em>violin</em></p>\\r\\n<p><strong>Freiburg Baroque Orchestra</strong><br /><strong>Sir Simon Rattle</strong>&nbsp;<em>conductor</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false}]}]},{\"ID\":2231,\"ProductionSeasonNumber\":99690,\"PerformanceNumber\":102892,\"WishlistNumber\":null,\"StartDate\":\"2026-09-20T12:00:00+01:00\",\"EndDate\":\"2026-09-20T12:00:00+01:00\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"Classical Coffee Mornings: Nadejda String Quartet\",\"Suffix\":\"Relaxed Performance\",\"ListingIndicator\":null,\"Summary\":\"Nadejda 