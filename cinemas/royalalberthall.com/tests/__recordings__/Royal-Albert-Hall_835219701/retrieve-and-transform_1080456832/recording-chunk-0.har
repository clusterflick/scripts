":101148,\"WishlistNumber\":447,\"StartDate\":\"2026-08-22T19:30:00+01:00\",\"EndDate\":\"2026-08-22T19:30:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Chineke! Orchestra with Angel Blue\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"The Chineke! Orchestra returns to the Proms under Jonathon Heyward, bringing with it Dvořák’s ecstatic hymn to nature, the Symphony No. 8, and Samuel Barber’s Knoxville: Summer of 1915 with star American soprano Angel Blue.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-46-Chineke-Orchestra-with-Angel-Blue-2820-x-1480-AUG-22.jpg?type=image&id=7199&token=86a15a5b&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-46-Chineke-Orchestra-with-Angel-Blue-2820-x-1480-AUG-22.jpg?type=image&id=7199&token=86a15a5b&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-46-Chineke-Orchestra-with-Angel-Blue-2820-x-1480-AUG-22.jpg?type=image&id=7199&token=86a15a5b&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-46-Chineke-Orchestra-with-Angel-Blue-2820-x-1480-AUG-22.jpg?type=image&id=7199&token=86a15a5b&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-46-Chineke-Orchestra-with-Angel-Blue-2820-x-1480-AUG-22.jpg?type=image&id=7199&token=86a15a5b&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Angel Blue\",\"caption\":\"Angel Blue © Dario Acosta \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\",\"Opera\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/chineke-orchestra-with-angel-blue\",\"DateDescription\":\"Saturday 22 August 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#342a83\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-46-Chineke-Orchestra-with-Angel-Blue-2820-x-1480-AUG-22.jpg?type=image&id=7199&token=86a15a5b&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-46-Chineke-Orchestra-with-Angel-Blue-2820-x-1480-AUG-22.jpg?type=image&id=7199&token=86a15a5b&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-46-Chineke-Orchestra-with-Angel-Blue-2820-x-1480-AUG-22.jpg?type=image&id=7199&token=86a15a5b&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-46-Chineke-Orchestra-with-Angel-Blue-2820-x-1480-AUG-22.jpg?type=image&id=7199&token=86a15a5b&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Angel Blue\",\"caption\":\"Angel Blue © Dario Acosta \"},\"Performances\":[{\"ID\":\"2112-101148\",\"PerformanceNumber\":101148,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-08-22T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-08-22T18:55:00+01:00\",\"MinimumPrice\":7.23,\"MaximumPrice\":68,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":50,\"ContentType\":\"Show Promo Code Box\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-46-Chineke-Orchestra-with-Angel-Blue-2820-x-1480-AUG-22.jpg?type=image&id=7199&token=86a15a5b\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>Europe&rsquo;s first majority-Black and ethnically diverse orchestra&nbsp;<strong>Chineke!</strong>&nbsp;is back. It opens with the premiere of a suite drawn from music for a ballet left incomplete by the South Carolina-born&nbsp;<strong>Edmund Thornton Jenkins</strong>, who died aged only 32.</p>\\r\\n<p>American soprano&nbsp;<strong>Angel Blue</strong>&nbsp;sings&nbsp;<strong>Samuel Barber</strong>&rsquo;s&nbsp;<em>Knoxville: Summer of 1915</em>&nbsp;&ndash; a child&rsquo;s all-encompassing vision of life in a teeming urban centre &ndash; as well as new arrangements of songs by some of 20th-century America&rsquo;s greatest tunesmiths.</p>\\r\\n<p>After the interval we swap cities for forests and fields in the ecstatic nature hymn that is&nbsp;<strong>Dvor&aacute;k</strong>&rsquo;s&nbsp;<em>Symphony No. 8</em>.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Edmund Thornton Jenkins reconstr. &amp; arr Tuffus Zimbabwe&nbsp;</strong>Dance Suite&nbsp;<em>c15&rsquo;&nbsp;</em><br /><em>world premiere</em><br /><strong>Barber</strong>&nbsp;Knoxville: Summer of 1915&nbsp;<em>15&rsquo;</em><br />New arrangements of songs by&nbsp;<strong>Harold Arlen</strong>,&nbsp;<strong>Irving Berlin</strong>,&nbsp;<strong>Margaret Bonds</strong>,&nbsp;<strong>George Gershwin</strong>&nbsp;and&nbsp;<strong>Richard Rodgers</strong>&nbsp;<em>18&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Dvor&aacute;k</strong>&nbsp;Symphony No. 8 in G major&nbsp;<em>34&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Angel Blue&nbsp;</strong><em>soprano</em></p>\\r\\n<p><strong>Chineke! Orchestra</strong><br /><strong>Jonathon Heyward</strong>&nbsp;<em>conductor</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2183,\"ProductionSeasonNumber\":101983,\"PerformanceNumber\":101988,\"WishlistNumber\":null,\"StartDate\":\"2026-12-08T11:00:00Z\",\"EndDate\":\"2026-12-08T11:00:00Z\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"Baby Gospel Christmas\",\"Suffix\":\"A Baby Broadway show\",\"ListingIndicator\":null,\"Summary\":\"An interactive experience where the entire family can sing and dance along to tunes from classic musicals and films.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/BG-Xmas.jpg?type=image&id=7486&token=2df8c6fc&mode=fill&top=17&left=0&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudf