kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-38-Pappano-Conducts-Berliozs-Requiem-2820-x-1480-AUG-15.jpg?type=image&id=7191&token=defb21fa&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-38-Pappano-Conducts-Berliozs-Requiem-2820-x-1480-AUG-15.jpg?type=image&id=7191&token=defb21fa&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-38-Pappano-Conducts-Berliozs-Requiem-2820-x-1480-AUG-15.jpg?type=image&id=7191&token=defb21fa&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-38-Pappano-Conducts-Berliozs-Requiem-2820-x-1480-AUG-15.jpg?type=image&id=7191&token=defb21fa&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Sir Antonio Pappano\",\"caption\":\"Sir Antonio Pappano © Frances Marshall \"},\"Performances\":[{\"ID\":\"2104-101108\",\"PerformanceNumber\":101108,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-08-15T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":false,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-08-15T18:55:00+01:00\",\"MinimumPrice\":11.05,\"MaximumPrice\":86,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-38-Pappano-Conducts-Berliozs-Requiem-2820-x-1480-AUG-15.jpg?type=image&id=7191&token=defb21fa\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Sir Antonio Pappano</strong>&nbsp;conducts the&nbsp;<strong>London Symphony Orchestra</strong>&nbsp;in one of the repertoire&rsquo;s most monumental musical statements.</p>\\r\\n<p>Premiered in 1837 with 450 performers,&nbsp;<strong>Berlioz</strong>&rsquo;s&nbsp;<em>Requiem</em>&nbsp;is a colossal, cinematic statement of faith, fear and hope &ndash; a sonic portrait of &lsquo;mankind gathered together on the last day&rsquo;. Demanding 10 timpanists and with four separate brass groups, it sends the shockwaves of the Day of Judgement right through listeners, insisting on the majesty, the fragility and the terrifying spectacle of death and resurrection.&nbsp;</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Berlioz</strong>&nbsp;Requiem (Grande messe des morts)&nbsp;<em>82&rsquo;&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><em>Tenor to be announced</em></p>\\r\\n<p><strong>BBC Symphony Chorus</strong><br /><strong>London Symphony Chorus</strong><br /><strong>London Symphony Orchestra</strong><br /><strong>Sir Antonio Pappano</strong>&nbsp;<em>conductor&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2077,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101134,\"WishlistNumber\":447,\"StartDate\":\"2026-07-26T19:00:00+01:00\",\"EndDate\":\"2026-07-26T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Poulenc and Adams\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Lucas and Arthur Jussen make their Proms debut in Poulenc’s Concerto for two pianos. They join the City of Birmingham Symphony Orchestra and Kazuki Yamada, who also perform two 20th-century classics: John Adams’s Harmonium and Poulenc’s Sinfonietta.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-14-Poulenc-and-Adams-2820-x-1480-JUL-26.jpg?type=image&id=7168&token=01c44e5c&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-14-Poulenc-and-Adams-2820-x-1480-JUL-26.jpg?type=image&id=7168&token=01c44e5c&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-14-Poulenc-and-Adams-2820-x-1480-JUL-26.jpg?type=image&id=7168&token=01c44e5c&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-14-Poulenc-and-Adams-2820-x-1480-JUL-26.jpg?type=image&id=7168&token=01c44e5c&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-14-Poulenc-and-Adams-2820-x-1480-JUL-26.jpg?type=image&id=7168&token=01c44e5c&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Kazuki Yamada\",\"caption\":\"Kazuki Yamada © Benjamin Ealovega \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/poulenc-and-adams\",\"DateDescription\":\"Sunday 26 July 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#342a83\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-14-Poulenc-and-Adams-2820-x-1480-JUL-26.jpg?type=image&id=7168&token=01c44e5c&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-14-Poulenc-and-Adams-2820-x-1480-JUL-26.jpg?type=image&id=7168&token=01c44e5c&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-14-Poulenc-and-Adams-2820-x-1480-JUL-26.jpg?type=image&id=7168&token=01c44e5c&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-14-Poulenc-and-Adams-2820-x-1480-JUL-26.jpg?type=image&id=7168&token=01c44e5c&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Kazuki Yamada\",\"caption\":\"Kazuki Yamada © Benjamin Ealovega \"},\"Performances\":[{\"ID\":\"2077-101134\",\"PerformanceNumber\":101134,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-07-26T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-07-26T18:25:00+01:00\",\"MinimumPrice\":7.23,\"MaximumPrice\":68,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-14-Poulenc-and-Adams-2820-x-1480-JUL-26.jpg?type=image&id=7168&token=01c44e5c\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>The human voice &lsquo;riding upon waves of rippling sound&rsquo; was the starting point for the glittering, pulsing soundscapes of&nbsp;<strong>John Adams</strong>&rsquo;s&nbsp;<em>Harmonium</em>&nbsp;&ndash; one of the American composer&rsquo;s defining works, harnessing the motoric energy of Minimalism to large-scale architectural form and textural richness.</p>\\r\\n<p>Commissioned by the BBC in 1947,&nbsp;<strong>Poulenc</strong>&rsquo;s&nbsp;<em>Sinfonietta</em>&nbsp;is a typically playful, nose thumbing riff on the traditional symphony, full of wit and brilliance &ndash; a mood it shares with the composer&rsquo;s joyful, Mozart- inspired Concerto for two pianos.</p>\\r\\n<p>&lsquo;Breathtaking&rsquo; Dutch siblings&nbsp;<strong>Lucas and Arthur Jussen</strong>&nbsp;make their Proms debut, joined by the&nbsp;<strong>City of Birmingham Symphony Orchestra</strong>&nbsp;and Music Director&nbsp;<strong>Kazuki Yamada</strong>.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Poulenc</strong>&nbsp;Sinfonietta&nbsp;<em>29&rsquo;&nbsp;</em><br /><strong>Poulenc</strong>&nbsp;Concerto in D minor for two pianos&nbsp;<em>20&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>John Adams</strong>&nbsp;Harmonium&nbsp;<em>33&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Lucas and Arthur Jussen&nbsp;</strong><em>pianos</em></p>\\r\\n<p><strong>CBSO Chorus</strong><br /><strong>Sydney Philharmonia Chorus</strong><br /><strong>City of Birmingham Symphony Orchestra&nbsp;</strong><br /><strong>Kazuki Yamada</strong>&nbsp;<em>conductor&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2230,\"ProductionSeasonNumber\":99690,\"PerformanceNumber\":102888,\"WishlistNumber\":null,\"StartDate\":\"2026-09-05T11:00:00+01:00\",\"EndDate\":\"2026-09-05T11:00:00+01:00\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"Classical Coffee Mornings: Julia Klampfer and Serenna MacLellan\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Julia Klampfer and Serenna MacLellan bring their Classical Coffee Morning to the Elgar Room, complete with a hot drink and a pastry.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/BTMS/Julia-Klampfer-and-Serenna-MacLellan.png?type=image&id=7754&token=099db1c8&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/BTMS/Julia-Klampfer-and-Serenna-MacLellan.png?type=image&id=7754&token=099db1c8&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/BTMS/Julia-Klampfer-and-Serenna-MacLellan.png?type=image&id=7754&token=099db1c8&mode=fill&top=0&left=16&