Inactive\":false},{\"ContentTypeId\":80,\"ContentType\":\"PT: Second Tier Hospitality\",\"Content\":\"<p><strong>*A festive Afternoon Tea served in box for 4 guests<br />*Quarter bottle Champagne per person <br />*Mineral water<br />*A dedicated service waiter per box <br />*A cracker and gift per person&nbsp;</strong></p>\",\"Inactive\":false}]},{\"ID\":\"2014-100062\",\"PerformanceNumber\":100062,\"ProductionSeasonNumber\":100052,\"Date\":\"2026-12-04T19:30:00+00:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-03-06T10:00:00+00:00\",\"OffSaleDate\":\"2026-12-04T18:55:00+00:00\",\"MinimumPrice\":7,\"MaximumPrice\":316.67,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":80,\"ContentType\":\"PT: Second Tier Hospitality\",\"Content\":\"<p>*Private hire of a Second Tier box for 4 guests&nbsp;</p>\\r\\n<p>*Half bottle of Champagne, half bottle wine, mulled wine,&nbsp;</p>\\r\\n<p>*A selection of mineral water and soft drinks&nbsp;</p>\\r\\n<p>*Luxury canap&eacute;s and a cold bowl dish served pre show&nbsp;</p>\\r\\n<p>*Hot bowl dishes and dessert canap&eacute;s served in the interval&nbsp;</p>\\r\\n<p>*A dedicated service waiter per box&nbsp;</p>\\r\\n<p>*A cracker and gift per person&nbsp;</p>\",\"Inactive\":false},{\"ContentTypeId\":126,\"ContentType\":\"PT: BSL User\",\"Content\":\"<p>  Please select the assigned seats in the Arena which are positioned for the best view of the BSL (British Sign Language) interpreter .</p>\",\"Inactive\":false},{\"ContentTypeId\":258,\"ContentType\":\"TNC: BSL User\",\"Content\":\"This seat is only for customers who require a view of the BSL (British Sign Language) interpreter. Please book alternative seats if you do not need this service.\",\"Inactive\":false},{\"ContentTypeId\":265,\"ContentType\":\"PT: BSL - Companion \",\"Content\":\"<p>This seat is for customers who are accompanying a BSL (British Sign Language) user.</p>\",\"Inactive\":false},{\"ContentTypeId\":469,\"ContentType\":\"TNC: BSL - Companion\",\"Content\":\"This seat is only for customers who are accompanying a BSL (British Sign Language) user. Please book alternative seats if you are not accompanying a BSL user.\",\"Inactive\":false}]}]},{\"ID\":2188,\"ProductionSeasonNumber\":102117,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2026-10-07T19:30:00+01:00\",\"EndDate\":\"2026-10-07T19:30:00+01:00\",\"Prefix\":\"Metropolis Music and Spacific presents\",\"Title\":\"SIX60\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Known for their electrifying live shows, the New Zealand pop rock band SIX60 is coming to the Hall this autumn.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Six60-2820x1487-Image.jpg?type=image&id=7504&token=0ea131f3&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Six60-2820x1487-Image.jpg?type=image&id=7504&token=0ea131f3&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Six60-2820x1487-Image.jpg?type=image&id=7504&token=0ea131f3&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Six60-2820x1487-Image.jpg?type=image&id=7504&token=0ea131f3&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Six60-2820x1487-Image.jpg?type=image&id=7504&token=0ea131f3&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"Members of the band Six60\",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/production/102117\",\"Categories\":[\"Rock and Pop\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2026/six60\",\"DateDescription\":\"Wednesday 7 October 2026\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#fc9400\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Six60-2820x1487-Image.jpg?type=image&id=7504&token=0ea131f3&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Six60-2820x1487-Image.jpg?type=image&id=7504&token=0ea131f3&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Six60-2820x1487-Image.jpg?type=image&id=7504&token=0ea131f3&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Six60-2820x1487-Image.jpg?type=image&id=7504&token=0ea131f3&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Members of the band Six60\",\"caption\":null},\"Performances\":[{\"ID\":\"2188-102205\",\"PerformanceNumber\":102205,\"ProductionSeasonNumber\":102117,\"Date\":\"2026-10-07T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-18T10:00:00+01:00\",\"OffSaleDate\":\"2026-10-07T18:55:00+01:00\",\"MinimumPrice\":40,\"MaximumPrice\":70,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"6\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p>Metropolis Music and Spacific presents</p>\\r\\n<p>Known for their electrifying live shows, the&nbsp;New Zealand pop rock band&nbsp;<strong>SIX60</strong>&nbsp;is coming to the Hall this autumn.</p>\\r\\n<p>From humble beginnings in a student flat in Dunedin to becoming the highest-selling live band in New Zealand history, the band&rsquo;s journey has been nothing short of extraordinary. In 2025, the Aotearoa Music Awards named SIX60 New Zealand&rsquo;s first-ever Chart Icon, recognising a record-breaking career that includes more than 1,200 weeks on the New Zealand music charts, four #1 albums, and 48 platinum-certified singles.</p>\\r\\n<p>With the recent completion of their fifth studio album, SIX60 continues to evolve while staying true to their roots &mdash; inspiring fans around the world and shaping the future sound of Aotearoa.</p>\",\"Inactive\":false}]}]},{\"ID\":1820,\"ProductionSeasonNumber\":97842,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2026-10-26T19:30:00Z\",\"EndDate\":\"2026-10-26T19:30:00Z\",\"Prefix\":\"Kilimanjaro presents\",\"Title\":\"Steve Hackett\",\"Suffix\":\"Best of Genesis & Solo Gems\",\"ListingIndicator\":null,\"Summary\":\"Steve Hackett is returning to the Hall in 2026 with his Best of Genesis & Solo Gems tour.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Steve-Hackett-2820x1487.jpg?type=image&id=5511&token=d6f064f4&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Steve-Hackett-2820x1487.jpg?type=image&id=5511&token=d6f064f4&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Steve-Hackett-2820x1487.jpg?type=image&id=5511&token=d6f064f4&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Steve-Hackett-2820x1487.jpg?type=image&id=5511&token=d6f064f4&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Steve-Hackett-2820x1487.jpg?type=image&id=5511&token=d6f064f4&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"Steve Hackett\",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/production/97842\",\"Categories\":[],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2026/steve-hackett\",\"DateDescription\":\"Monday 26 October 2026\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#0d2626\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Steve-Hackett-2820x1487.jpg?type=image&id=5511&token=d6f064f4&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Steve-Hackett-2820x1487.jpg?type=image&id=5511&token=d6f064f4&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Steve-Hackett-2820x1487.jpg?type=image&id=5511&token=d6f064f4&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Steve-Hackett-2820x1487.jpg?type=image&id=5511&token=d6f064f4&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Steve Hackett\",\"caption\":null},\"Performances\":[{\"ID\":\"1820-97844\",\"PerformanceNumber\":97844,\"ProductionSeasonNumber\":97842,\"Date\":\"2026-10-26T19:45:00+00:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":false,\"OnSaleDate\":\"2025-09-19T10:00:00+01:00\",\"OffSaleDate\":\"2026-10-26T19:10:00+00:00\",\"MinimumPrice\":55,\"MaximumPrice\":301.96,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"8\",\"Inactive\":false},{\"ContentTypeId\":65,\"ContentType\":\"Members - Web Image URL\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Steve-Hackett-2820x1487.jpg?type=image&id=5511&token=d6f064f4\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p><span style=\\\"color: black;\\\">Kilimanjaro presents: </span><strong style=\\\"color: black;\\\">Steve Hackett - Best of Genesis &amp; Solo Gems </strong></p><p><strong style=\\\"color: black;\\\">Steve Hackett </strong><span style=\\\"color: black;\\\">is returning to the Hall in 2026 with his </span><em style=\\\"color: black;\\\">Best of Genesis &amp; Solo Gems tour. </em></p><p><span style=\\\"color: black;\\\">It has been 12 years since Steve Hackett brought his classic </span><em style=\\\"color: black;\\\">Genesis Revisite</em><span style=\\\"color: black;\\\">d show to us. Back then, in 2013, his UK tour culminated in his acclaimed performance at the Hall and the following release of the live DVD of that performance. </span></p><p><span style=\\\"color: black;\\\">Since then, Steve’s timeless guitar work has been woven throughout the classic Genesis albums of the '70s. In recent years, he and his world class band have brought several of these albums back to concert halls to even greater acclaim, and the 2025 tour featured the classic album </span><em style=\\\"color: black;\\\">The Lamb Lies Dow</em><span style=\\\"color: black;\\\">n On Broadway. </span></p><p><span style=\\\"color: black;\\\">Now, for 2026 and going forward, Steve is bringing you the very best of the Genesis songs from throughout his career with this awe-inspiring band, along with a selection of classic material from his many solo albums. </span></p><p><span style=\\\"color: black;\\\">Accompanying Steve for these dates with be long-standing musicians, </span><strong style=\\\"color: black;\\\">Jonas Reingold</strong><span style=\\\"color: black;\\\"> (bass, guitar, backing vocals), </span><strong style=\\\"color: black;\\\">Rob Townsend</strong><span style=\\\"color: black;\\\"> (saxophone, flutes, additional keyboards, backing vocals), </span><strong style=\\\"color: black;\\\">Nad Sylvan</strong><span style=\\\"color: black;\\\"> (vocals), and more recently </span><strong style=\\\"color: black;\\\">Lalle Larsson</strong><span style=\\\"color: black;\\\"> (keyboards), and </span><strong style=\\\"color: black;\\\">Felix Lehrmann</strong><span style=\\\"color: black;\\\"> on drums.</span></p>\",\"Inactive\":false},{\"ContentTypeId\":72,\"ContentType\":\"PT: Fine Dining \",\"Content\":\"<p>*Premium Front Arena Seat&nbsp;</p><p>*Three course dinner in Coda by Chavot Restaurant</p><p>*Welcome glass Champagne and half bottle of wine per person&nbsp;</p>\",\"Inactive\":false},{\"ContentTypeId\":79,\"ContentType\":\"PT: Loggia Hospitality\",\"Content\":\"<p>*Private hire of a Loggia box for 8 guests&nbsp;</p><p>*Box waiter&nbsp;</p><p>*4 bottles wine per box, 8 beers, mineral water and selection of soft drinks&nbsp;</p><p>*Cold bowl dish, loaded nachos, mini sliders and waffle fries&nbsp;</p><p>*Dessert canapes&nbsp;</p>\",\"Inactive\":false},{\"ContentTypeId\":80,\"ContentType\":\"PT: Second Tier Hospitality\",\"Content\":\"<p>*Private hire of a 2nd Tier box for 4 guests&nbsp;</p><p>*Box waiter&nbsp;</p><p>*2 bottles wine per box, 4 beers, mineral water and selection of soft drinks&nbsp;</p><p>*Cold bowl dish, loaded nachos, mini sliders and waffle fries&nbsp;</p><p>*Dessert canapes&nbsp;</p>\",\"Inactive\":false},{\"ContentTypeId\":293,\"ContentType\":\"PT: VIP Lounge\",\"Content\":\"<p>*Premium Stalls seat&nbsp;</p><p>*Pre and interval VIP Lounge</p><p>*Canapes, bowl dishes, desserts, wine, beer and soft drinks</p>\",\"Inactive\":false}]}]},{\"ID\":1994,\"ProductionSeasonNumber\":100344,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2026-10-28T19:30:00Z\",\"EndDate\":\"2026-10-29T19:30:00Z\",\"Prefix\":\"SJM Concerts present\",\"Title\":\"Steven Wilson\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\" Steven Wilson will return to the Hall for the seventh time to play two shows with his band and an orchestra.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/steven-wilson-2820x1487.jpg?type=image&id=6864&token=a24e9261&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/steven-wilson-2820x1487.jpg?type=image&id=6864&token=a24e9261&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/steven-wilson-2820x1487.jpg?type=image&id=6864&token=a24e9261&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w6