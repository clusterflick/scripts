            "mimeType": "application/json",
            "text": "[{\"ID\":1862,\"ProductionSeasonNumber\":98474,\"PerformanceNumber\":98475,\"WishlistNumber\":null,\"StartDate\":\"2027-06-29T19:00:00+01:00\",\"EndDate\":\"2027-06-29T19:00:00+01:00\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"A Musical Rebellion\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"A multi-school performance, amplifying the voices of young people from across Hammersmith and Fulham, Kensington and Chelsea, and Westminster's state-school communities. This performance will centre on the power of protest songs in a magnificent showcase of the students' talents.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Engagement/2026/AMR-6.png?type=image&id=6843&token=9ad139f5&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Engagement/2026/AMR-6.png?type=image&id=6843&token=9ad139f5&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Engagement/2026/AMR-6.png?type=image&id=6843&token=9ad139f5&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Engagement/2026/AMR-6.png?type=image&id=6843&token=9ad139f5&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Engagement/2026/AMR-6.png?type=image&id=6843&token=9ad139f5&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"A Musical Rebellion\",\"caption\":null},\"Venue\":null,\"VenueDetails\":null,\"BookingStatus\":\"Not Yet On Sale\",\"BookingLabel\":\"Not Yet On Sale\",\"BookingURL\":null,\"Categories\":[\"Engagement\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2027/a-musical-rebellion\",\"DateDescription\":\"Tuesday 29 June 2027\",\"Type\":\"EventPage\",\"UsePromsPlanner\