udfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Pirates-of-the-Caribbean-in-Concert/DC_POC_16.jpg?type=image&id=6212&token=b9ee9a2d&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"Jack Sparrow and Will Turner\",\"caption\":\"© Disney\"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/production/99160\",\"Categories\":[\"Classical\",\"Film\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2026/pirates-of-the-caribbean-the-curse-of-the-black-pearl-in-concert\",\"DateDescription\":\"Tuesday 29 December 2026\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#fc9400\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Pirates-of-the-Caribbean-in-Concert/DC_POC_16.jpg?type=image&id=6212&token=b9ee9a2d&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Pirates-of-the-Caribbean-in-Concert/DC_POC_16.jpg?type=image&id=6212&token=b9ee9a2d&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Pirates-of-the-Caribbean-in-Concert/DC_POC_16.jpg?type=image&id=6212&token=b9ee9a2d&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/12-December/Pirates-of-the-Caribbean-in-Concert/DC_POC_16.jpg?type=image&id=6212&token=b9ee9a2d&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Jack Sparrow and Will Turner\",\"caption\":\"© Disney\"},\"Performances\":[{\"ID\":\"1897-99161\",\"PerformanceNumber\":99161,\"ProductionSeasonNumber\":99160,\"Date\":\"2026-12-29T13:00:00+00:00\",\"TimeSlot\":\"Afternoon\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2025-12-09T10:00:00+00:00\",\"OffSaleDate\":\"2026-12-29T12:25:00+00:00\",\"MinimumPrice\":20.91,\"MaximumPrice\":277.45,\"WebContents\":[{\"ContentTypeId\":72,\"ContentType\":\"PT: Fine Dining \",\"Content\":\"<p>&bull;Premium Stalls seats<br />&bull;Two glasses of Champagne per person*<br />&bull;Three course brunch menu served in Coda by Eric Chavot Restaurant<br />&bull;Smoothie and filter coffee and tea</p>\\r\\n<p><br />*Alcohol can only be served after 11am</p>\",\"Inactive\":false},{\"ContentTypeId\":295,\"ContentType\":\"Dynamic Decrease Limit\",\"Content\":\"10\",\"Inactive\":false},{\"ContentTypeId\":296,\"ContentType\":\"Dynamic Increase Limit\",\"Content\":\"10\",\"Inactive\":false}]},{\"ID\":\"1897-99162\",\"PerformanceNumber\":99162,\"ProductionSeasonNumber\":99160,\"Date\":\"2026-12-29T18:00:00+00:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2025-12-09T10:00:00+00:00\",\"OffSaleDate\":\"2026-12-29T17:25:00+00:00\",\"MinimumPrice\":20.91,\"MaximumPrice\":277.45,\"WebContents\":[{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p>Royal Albert Hall presents:</p>\\r\\n<p><strong>Pirates of the Caribbean: The Curse of the Black Pearl in Concert (12A) 2026</strong><br /><strong>with the Academy of St Martin in the Fields</strong></p>\\r\\n<p>Weigh the anchor and hoist the sails, as <em>Pirates of the Caribbean: The Curse of the Black Pearl</em> plots a course to London with an orchestra and choir in tow.</p>\\r\\n<p>Relive the adventure of the first film in the blockbuster franchise as Klaus Badelt's iconic soundtrack is performed by the <strong>Academy of St Martin in the Fields</strong> and the <strong>London Voices.</strong></p>\\r\\n<p>When wily Captain Barbossa steals Jack Sparrow's ship and kidnaps the governor's beautiful daughter, Elizabeth, her childhood friend Will Turner joins forces with Jack to save her and recapture Jack's ship, the Black Pearl. Starring Johnny Depp, Keira Knightley, Orlando Bloom and Geoffery Rush.</p>\\r\\n<p><br /><em>Presentation licensed by Disney Concerts &copy; All rights reserved</em></p>\\r\\n<p><strong>DYNAMIC PRICING</strong></p>\\r\\n<p>In the normal way dynamic pricing is in place at the Hall for events promoted by the Royal Philharmonic Orchestra, Cirque du Soleil and the Royal Albert Hall.</p>\\r\\n<p>This means that promoter ticket prices might fluctuate for these events (both up and down) according to demand. Dynamic, or flexible pricing, has been commonly used in the airline and hotel industry for many years and is now becoming commonplace in entertainment as well. Any prices changes will apply to all tickets sold by the Hall's Box Office<em><br />________________________________________________________<br /></em></p>\",\"Inactive\":false},{\"ContentTypeId\":72,\"ContentType\":\"PT: Fine Dining \",\"Content\":\"<p>*Premium stalls seat <br />*Three course dinner in Coda by Chavot Restaurant<br />*Welcome glass of Champagne and half bottle of wine per person <br />*Still &amp; Sparkling mineral water, tea or coffee</p>\",\"Inactive\":false},{\"ContentTypeId\":295,\"ContentType\":\"Dynamic Decrease Limit\",\"Content\":\"10\",\"Inactive\":false},{\"ContentTypeId\":296,\"ContentType\":\"Dynamic Increase Limit\",\"Content\":\"10\",\"Inactive\":false}]}]},{\"ID\":2238,\"ProductionSeasonNumber\":102854,\"PerformanceNumber\":null,\"WishlistNumber\":null,\"StartDate\":\"2026-10-10T18:30:00+01:00\",\"EndDate\":\"2026-10-10T18:30:00+01:00\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"Sholay in Concert (12A)\",\"Suffix\":\"with the Royal Philharmonic Concert Orchestra\",\"ListingIndicator\":null,\"Summary\":\"Experience Ramesh Sippy's classic 1975 'Curry Western' on the big screen, accompanied by the Royal Philharmonic Concert Orchestra, conducted by Melvin Tay,\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/2820x1487-Sholay-Key-Art.png?type=image&id=7770&token=efc49f10&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/2820x1487-Sholay-Key-Art.png?type=image&id=7770&token=efc49f10&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/2820x1487-Sholay-Key-Art.png?type=image&id=7770&token=efc49f10&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/2820x1487-Sholay-Key-Art.png?type=image&id=7770&token=efc49f10&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/2820x1487-Sholay-Key-Art.png?type=image&id=7770&token=efc49f10&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"A montage collage of all the key characters from Sholay, in a vintage Western style, with a red sun behind them all. The collage shows a shorse, a landscape and the characters holding guns and posing. \",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sal