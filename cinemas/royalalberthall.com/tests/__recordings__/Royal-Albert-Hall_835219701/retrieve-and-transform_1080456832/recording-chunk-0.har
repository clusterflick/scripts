ventURL\":\"/tickets/proms/bbc-proms-2026/weyes-blood-and-the-jules-buckley-orchestra\",\"DateDescription\":\"Tuesday 8 September 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#342a83\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Weyes-Blood-2820x1480.jpg?type=image&id=7379&token=298777df&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Weyes-Blood-2820x1480.jpg?type=image&id=7379&token=298777df&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Weyes-Blood-2820x1480.jpg?type=image&id=7379&token=298777df&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Weyes-Blood-2820x1480.jpg?type=image&id=7379&token=298777df&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Weyes Blood\",\"caption\":\"Weyes Blood © Ashley Osborn\"},\"Performances\":[{\"ID\":\"2141-101125\",\"PerformanceNumber\":101125,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-09-08T22:15:00+01:00\",\"TimeSlot\":\"Late Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-09-08T21:40:00+01:00\",\"MinimumPrice\":6,\"MaximumPrice\":37,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Weyes-Blood-2820x1480.jpg?type=image&id=7379&token=298777df\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>Following unique collaborations with the likes of Laura Mvula, Jacob Collier, Florence + The Machine and St. Vincent,&nbsp;<strong>Jules Buckley</strong>&nbsp;and his own hand-picked ensemble return to the Proms with&nbsp;<strong>Weyes Blood&nbsp;</strong>&ndash; aka&nbsp;<strong>Natalie Mering</strong>&nbsp;&ndash; for an orchestral exploration of the American singer-songwriter&rsquo;s wistful, transcendent folk-pop.</p>\\r\\n<p>Her expansive, other-worldly sound and rich, velvety voice offer the perfect platform for Buckley's signature symphonic treatment. A typically imaginative meeting of musical minds in an intimate late-night setting.&nbsp;</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Jules Buckley Orchestra</strong><br /><strong>Jules Buckley&nbsp;</strong><em>conductor</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><em>There will be no interval.</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false}]}]},{\"ID\":2087,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101168,\"WishlistNumber\":447,\"StartDate\":\"2026-08-02T19:30:00+01:00\",\"EndDate\":\"2026-08-02T19:30:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Kavakos Plays Tchaikovsky\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Greek violinist Leonidas Kavakos joins Paavo Järvi and the BBC Symphony Orchestra for Tchaikovsky’s Violin Concerto. Bookending the evening are Scriabin’s iconoclastic Symphony No. 2 and the world premiere of Dani Howard’s Concerto for Brass.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-22-Kavakos-plays-Tchaikovsky-2820-x-1480-AUG-2.jpg?type=image&id=7175&token=f07ed33a&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-22-Kavakos-plays-Tchaikovsky-2820-x-1480-AUG-2.jpg?type=image&id=7175&token=f07ed33a&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-22-Kavakos-plays-Tchaikovsky-2820-x-1480-AUG-2.jpg?type=image&id=7175&token=f07ed33a&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-22-Kavakos-plays-Tchaikovsky-2820-x-1480-AUG-2.jpg?type=image&id=7175&token=f07ed33a&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-22-Kavakos-plays-Tchaikovsky-2820-x-1480-AUG-2.jpg?type=image&id=7175&token=f07ed33a&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Paavo Järvi\",\"caption\":\"Paavo Järvi © Kaupo Kikkas \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\",\"Contemporary Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/kavakos-plays-tchaikovsky\",\"DateDescription\":\"Sunday 2 August 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#0093dd\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-22-Kavakos-plays-Tchaikovsky-2820-x-1480-AUG-2.jpg?type=image&id=7175&token=f07ed33a&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-22-Kavakos-plays-Tchaikovsky-2820-x-1480-AUG-2.jpg?type=image&id=7175&token=f07ed33a&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-22-Kavakos-plays-Tchaikovsky-2820-x-1480-AUG-2.jpg?type=image&id=7175&token=f07ed33a&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-22-Kavakos-plays-Tchaikovsky-2820-x-1480-AUG-2.jpg?type=image&id=7175&token=f07ed33a&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Paavo Järvi\",\"caption\":\"Paavo Järvi © Kaupo Kikkas \"},\"Performances\":[{\"ID\":\"2087-101168\",\"PerformanceNumber\":101168,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-08-02T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-08-02T18:55:00+01:00\",\"MinimumPrice\":5.95,\"MaximumPrice\":56,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-22-Kavakos-plays-Tchaikovsky-2820-x-1480-AUG-2.jpg?type=image&id=7175&token=f07ed33a\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>&lsquo;Impeccable&rsquo; Greek violinist&nbsp;<strong>Leonidas Kavakos&nbsp;</strong>joins&nbsp;<strong>Paavo J&auml;rvi&nbsp;</strong>and the&nbsp;<strong>BBC Symphony Orchestra</strong>&nbsp;for one of the great Romantic concertos.&nbsp;<strong>Tchaikovsky</strong>&rsquo;s&nbsp;<em>Violin Concerto</em>&nbsp;is a deeply personal work, laden with the emotions of a failed marriage. Tender and melancholic, with tempestuous outpourings, it&rsquo;s a piece that wears its heart on its sleeve.</p>\\r\\n<p>Bold colours frame this centrepiece: the world premiere of&nbsp;<strong>Dani Howard</strong>&rsquo;s<em>&nbsp;Concerto for Brass, &lsquo;SIGNAL&rsquo;</em>, showcasing the players of the BBC SO, and&nbsp;<strong>Scriabin</strong>&rsquo;s&nbsp;<em>Symphony No. 2</em>, with its iconoclastic brilliance and spiritual vision.&nbsp;</p>\\r\\n<p><em>Broadcast on BBC TV and BBC iPlayer</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Dani Howard&nbsp;</strong>Concerto for Brass, &lsquo;SIGNAL&rsquo;&nbsp;<em>c18&rsquo;&nbsp;</em><br /><em>BBC co-commission: world premiere</em></p>\\r\\n<p><strong>Tchaikovsky</strong>&nbsp;Violin Concerto in D major&nbsp;<em>33&rsquo;&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Scriabin&nbsp;</strong>Symphony No. 2 in C major&nbsp;<em>41&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Leonidas Kavakos&nbsp;</strong><em>violin</em></p>\\r\\n<p><strong>BBC Symphony Orchestra&nbsp;</strong><br /><strong>Paavo J&auml;rvi</strong><em>&nbsp;conductor&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2083,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101167,\"WishlistNumber\":447,\"StartDate\":\"2026-07-30T19:00:00+01:00\",\"EndDate\":\"2026-07-30T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Korngold’s Violin Concerto\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Alena Baeva joins Delyana Lazarova and the BBC Scottish Symphony Orchestra as the soloist in Korngold’s filmic Violin Concerto. Bookending the concert are Dobrinka Tabakova’s exhilarating fanfare Orpheus’ Comet and Prokofiev’s lyrical Symphony No. 5.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-18-Korngolds-Violin-Concerto-2820-x-1480-JUL-30.jpg?type=image&id=7172&token=fd3a5949&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-18-Korngolds-Violin-Concerto-2820-x-1480-JUL-30.jpg?type=image&id=7172&token=fd3a5949&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-18-Korngolds-Violin-Concerto-2820-x-1480-JUL-30.jpg?type=image&id=7172&token=fd3a5949&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-18-Korngolds-Violin-Concerto-2820-x-1480-JUL-30.jpg?type=image&id=7172&token=fd3a5949&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-18-Korngolds-Violin-Concerto-2820-x-1480-JUL-30.jpg?type=image&id=7172&token=fd3a5949&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Alena Baeva\",\"caption\":\"Alena Baeva © Marco Borggreve\"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/korngolds-violin-concerto\",\"DateDescription\":\"Thursday 30 July 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#0093dd\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-18-Korngolds-Violin-Concerto-2820-x-1480-JUL-30.jpg?type=image&id=7172&token=fd3a5949&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-18-Korngolds-Violin-Concerto-2820-x-1480-JUL-30.jpg?type=image&id=7172&token=fd3a5949&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-18-Korngolds-Violin-Concerto-2820-x-1480-JUL-30.jpg?type=image&id=7172&token=fd3a5949&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-18-Korngolds-Violin-Concerto-2820-x-1480-JUL-30.jpg?type=image&id=7172&token=fd3a5949&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Alena Baeva\",\"caption\":\"Alena Baeva © Marco Borggreve\"},\"Performances\":[{\"ID\":\"2083-101167\",\"PerformanceNumber\":101167,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-07-30T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-07-30T18:25:00+01:00\",\"MinimumPrice\":5.95,\"MaximumPrice\":56,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":50,\"ContentType\":\"Show Promo Code Box\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-18-Korngolds-Violin-Concerto-2820-x-1480-JUL-30.jpg?type=image&id=7172&token=fd3a5949\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>A symphony &lsquo;on the greatness of the human soul&rsquo; and a cinematic concerto collide in a concert of widescreen orchestral soundscapes. &lsquo;Utterly captivating&rsquo; violinist&nbsp;<strong>Alena Baeva&nbsp;</strong>is the soloist in&nbsp;<strong>Korngold</strong>&rsquo;s&nbsp;<em>Violin Concerto</em>&nbsp;&ndash; a work imbued with all the sweeping romance and passion of the composer&rsquo;s many film scores.</p>\\r\\n<p><strong>Delyana Lazarova</strong>&nbsp;conducts the&nbsp;<strong>BBC Scottish Symphony Orchestra</strong>&nbsp;in&nbsp;<strong>Prokofiev</strong>&rsquo;s&nbsp;<em>Symphony No. 5</em>, a musical homecoming featuring one of the composer&rsquo;s most darkly lyrical slow movements.</p>\\r\\n<p><strong>Dobrinka Tabakova</strong>&rsquo;s exhilarating fanfare&nbsp;<em>Orpheus&rsquo; Comet</em>&nbsp;launches the evening with a buzzing, fizzing homage to Monteverdi.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Dobrinka Tabakova&nbsp;</strong>Orpheus&rsquo; Comet&nbsp;<em>5&rsquo;</em><br /><strong>Korngold</strong>&nbsp;Violin Concerto in D major&nbsp;<em>24&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Prokofiev&nbsp;</strong>Symphony No. 5 in B flat major&nbsp;<em>46&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Alena Baeva&nbsp;</strong><em>violin</em><br /><strong>BBC Scottish Symphony Orchestra</strong><br /><strong>Delyana Lazarova&nbsp;</strong><em>conductor</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2173,\"ProductionSeasonNumber\":102011,\"PerformanceNumber\":102019,\"WishlistNumber\":null,\"StartDate\":\"2026-11-01T19:30:00Z\",\"EndDate\":\"2026-11-01T19:30:00Z\",\"Prefix\":\"Sanatan Events Ltd presents\",\"Title\":\"Celebrating Diwali\",\"Suffix\":\"A Charity Concert at the Royal Albert Hall\",\"ListingIndicator\":null,\"Summary\":\"Celebrating Diwali unites one of India's most beloved vocalists with the Royal Philharmonic Concert Orchestra in a collaboration conceived for this extraordinary evening.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Celebrating-Diwali-2026-RAH-event-cover-graphic.png?type=image&id=7451&token=b5dac8b1&mode=fill&top=0&left=8&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Celebrating-Diwali-2026-RAH-event-cover-graphic.png?type=image&id=7451&token=b5dac8b1&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Celebrating-Diwali-2026-RAH-event-cover-graphic.png?type=image&id=7451&token=b5dac8b1&mode=fill&top=0&left=16&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Celebrating-Diwali-2026-RAH-event-cover-graphic.png?type=image&id=7451&token=b5dac8b1&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Celebrating-Diwali-2026-RAH-event-cover-graphic.png?type=image&id=7451&token=b5dac8b1&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"Woman holding a candle with the Royal Albert Hall auditorium in the background\",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/booking/production/102019\",\"Categories\":[\"Entertainment\",\"Contemporary Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2026/celebrating-diwali\",\"DateDescription\":\"Sunday 1 November 2026\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#8c52de\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Celebrating-Diwali-2026-RAH-event-cover-graphic.png?type=image&id=7451&token=b5dac8b1&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Celebrating-Diwali-2026-RAH-event-cover-graphic.png?type=image&id=7451&token=b5dac8b1&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Celebrating-Diwali-2026-RAH-event-cover-graphic.png?type=image&id=7451&token=b5dac8b1&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/11-November/Celebrating-Diwali-2026-RAH-event-cover-graphic.png?type=image&id=7451&token=b5dac8b1&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Woman holding a candle with the Royal Albert Hall auditorium in the background\",\"caption\":null},\"Performances\":[{\"ID\":\"2173-102019\",\"PerformanceNumber\":102019,\"ProductionSeasonNumber\":102011,\"Date\":\"2026-11-01T19:30:00+00:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-15T11:00:00+01:00\",\"OffSaleDate\":\"2026-11-01T18:55:00+00:00\",\"MinimumPrice\":35,\"MaximumPrice\":287.25,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":61,\"ContentType\":\"Members - Donate to Charity\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p>An evening of&nbsp;devotional&nbsp;splendour with<strong>&nbsp;Kavita Krishnamurti</strong>&nbsp;accompanied by The&nbsp;<strong>Royal Philharmonic Concert Orchestra</strong>.</p>\\r\\n<p>This Diwali, Hall welcomes a&nbsp;devotional&nbsp;concert unlike anything this stage has seen before. Celebrating Diwali unites one of India's most beloved vocalists with the Royal Philharmonic Concert Orchestra, joined by an acclaimed team of musicians from India, in a collaboration conceived for this extraordinary evening.</p>\\r\\n<p>Across a career of rare devotion, Kavita Krishnamurti has carried within her voice the full weight of India's sacred musical heritage. On this night, that voice meets the orchestra in arrangements composed exclusively for this occasion by&nbsp;<strong>Rahul Ranade</strong>, a film music composer and event designer.</p>\\r\\n<p><em>'Celebrating Diwali' is presented by Sanatan Events CIC. All proceeds go directly towards the celebration and preservation of India's sacred cultural heritage for future generations.</em></p>\",\"Inactive\":false},{\"ContentTypeId\":79,\"ContentType\":\"PT: Loggia Hospitality\",\"Content\":\"<p>*Private Hire of a Loggia Box for 8 guests&nbsp;</p><p>*Bespoke South Asian Menu to Include</p><p>*Canapes, bowl dishes, dessert canapes&nbsp;</p><p>*1/4 bottle Wild Idol non alcoholic sparkling wine</p><p>*Lemon and Rose Sherbert Soft Cocktail&nbsp;</p><p>*Chamomile and Mint Herbal Tea&nbsp;</p><p>*Mineral water&nbsp;</p><p>*Box waiter&nbsp;</p>\",\"Inactive\":false},{\"ContentTypeId\":80,\"ContentType\":\"PT: Second Tier Hospitality\",\"Content\":\"<p>To include:</p><p><br></p><p>*Private Hire of&nbsp;a Second Tier Box for 4 guests</p><p>*Bespoke South Asian Menu to Include</p><p>*Canapes, bowl dishes, dessert canapes&nbsp;</p><p>*1/4 bottle Wild Idol non alcoholic sparkling wine</p><p>*Lemon and Rose Sherbert Soft Cocktail&nbsp;</p><p>*Chamomile and Mint Herbal Tea&nbsp;</p><p>*Mineral water&nbsp;</p><p>*Box waiter&nbsp;</p><p><br></p>\",\"Inactive\":false},{\"ContentTypeId\":293,\"ContentType\":\"PT: VIP Lounge\",\"Content\":\"<p>To include:</p><p><br></p><p>*Premium Side Stalls Seat&nbsp;</p><p>*Access to a VIP Lounge pre show and in the interval&nbsp;</p><p>*Bespoke South Asian Menu to Include</p><p>*Canapes, bowl dishes, dessert canapes&nbsp;</p><p>*A selection of soft cocktails, herbal teas, masala chai&nbsp;</p><p>*Mineral water&nbsp;</p><p><br></p>\",\"Inactive\":false}]}]},{\"ID\":2145,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101156,\"WishlistNumber\":447,\"StartDate\":\"2026-09-12T19:15:00+01:00\",\"EndDate\":\"2026-09-12T19:15:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Last Night of the Proms 2026\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Classical music’s greatest international party draws the 2026 Proms to a close. Superstar pianist Yuja Wang is joined by Scottish tenor Nicky Spence and massed BBC forces, all marshalled by Sakari Oramo.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-73-Last-Night-of-the-Proms-2026-2820-x-1480-SEP-12.jpg?type=image&id=7226&token=b2e8ccab&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-73-Last-Night-of-the-Proms-2026-2820-x-1480-SEP-12.jpg?type=image&id=7226&token=b2e8ccab&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-73-Last-Night-of-the-Proms-2026-2820-x-1480-SEP-12.jpg?type=image&id=7226&token=b2e8ccab&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-73-Last-Night-of-the-Proms-2026-2820-x-1480-SEP-12.jpg?type=image&id=7226&token=b2e8ccab&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-73-Last-Night-of-the-Proms-2026-2820-x-1480-SEP-12.jpg?type=image&id=7226&token=b2e8ccab&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Nicky Spence & Yuja Wang\",\"caption\":\"Nicky Spence © Ki Price | Yuja Wang © BBC Studios \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Custom\",\"BookingLabel\":\"More information\",\"BookingURL\":\"https://www.royalalberthall.com/tickets/proms/bbc-proms-2026/last-night-of-the-proms-2026\",\"Categories\":[\"Classical\",\"BBC Proms\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/last-night-of-the-proms-2026\",\"DateDescription\":\"Saturday 12 September 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#ef911f\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-73-Last-Night-of-the-Proms-2026-2820-x-1480-SEP-12.jpg?type=image&id=7226&token=b2e8ccab&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-73-Last-Night-of-the-Proms-2026-2820-x-1480-SEP-12.jpg?type=image&id=7226&token=b2e8ccab&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-73-Last-Night-of-the-Proms-2026-2820-x-1480-SEP-12.jpg?type=image&id=7226&token=b2e8ccab&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-73-Last-Night-of-the-Proms-2026-2820-x-1480-SEP-12.jpg?type=image&id=7226&token=b2e8ccab&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Nicky Spence & Yuja Wang\",\"caption\":\"Nicky Spence © Ki Price | Yuja Wang © BBC Studios \"},\"Performances\":[{\"ID\":\"2145-101156\",\"PerformanceNumber\":101156,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-09-12T19:15:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-07-17T09:00:00+01:00\",\"OffSaleDate\":\"2026-09-12T18:40:00+01:00\",\"MinimumPrice\":25,\"MaximumPrice\":180,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"2\",\"Inactive\":false},{\"ContentTypeId\":46,\"ContentType\":\"Delivery - Mail\",\"Content\":\"The BBC (the event promoter) has requested that tickets for the Last Night of the Proms will not be issued until one week before the date of the concert. By issuing the tickets at this later date we hope to reduce the opportunity for tickets to be sold above face value elsewhere.\",\"Inactive\":false},{\"ContentTypeId\":47,\"ContentType\":\"Delivery - Print at Home\",\"Content\":\"The BBC (the event promoter) has requested that tickets for the Last Night of the Proms will not be issued until one week before the date of the concert. By issuing the tickets at this later date we hope to reduce the opportunity for tickets to be sold above face value elsewhere.\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>The culmination of a summer of over 80 concerts &ndash; including at venues around the country &ndash; classical music&rsquo;s greatest international party draws the 2026 Proms to a close while echoing some of the themes of the season.</p>\\r\\n<p>Superstar pianist&nbsp;<strong>Yuja Wang</strong>&nbsp;returns following her last appearance here in 2023. Her talents are matched by the vocal and stage prowess of charismatic Scottish tenor&nbsp;<strong>Nicky Spence</strong>, whose repertoire ranges from operatic roles by<strong>&nbsp;Britten&nbsp;</strong>and&nbsp;<strong>Jan&aacute;cek</strong>&nbsp;to the witty, urbane numbers of&nbsp;<strong>No&euml;l Coward</strong>.</p>\\r\\n<p>As ever, BBC forces flood the stage of the Royal Albert, all marshalled by&nbsp;<strong>Sakari Oramo</strong>, returning for his fifth Prom this summer &ndash; including an appearance as violinist in Bristol &ndash; and his seventh Last Night.&nbsp;</p>\\r\\n<p><em>Broadcast live on BBC Two (first half), BBC One (second half) and BBC iPlayer.</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme to include:</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>arr. Wood</strong>&nbsp;Fantasia on British Sea Songs&nbsp;<em>13&rsquo;</em><br /><strong>Arne, arr. Sargent</strong>&nbsp;Rule, Britannia!<em>&nbsp;5&rsquo;</em><br /><strong>Elgar&nbsp;</strong>Pomp and Circumstance March No. 1 in D major (&lsquo;Land of Hope and Glory&rsquo;)&nbsp;<em>8&rsquo;</em><br /><strong>Parry, orch. Elgar</strong>&nbsp;Jerusalem<em>&nbsp;2&rsquo;</em><br /><strong>arr. Britten&nbsp;</strong>The National Anthem&nbsp;<em>2&rsquo;</em><br /><strong>Trad., arr. P. Campbell</strong>&nbsp;Auld lang syne&nbsp;<em>2&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Nicky Spence&nbsp;</strong><em>tenor</em><br /><strong>Yuja Wang</strong><em>&nbsp;piano</em></p>\\r\\n<p><strong>BBC Singers</strong><br /><strong>BBC Symphony Chorus</strong><br /><strong>BBC Symphony Orchestra</strong><br /><strong>Sakari Oramo</strong><em>&nbsp;conductor</em></p>\\r\\n<p><em>There will be one interval.</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":177,\"ContentType\":\"Delivery - Etickets\",\"Content\":\"The BBC (the event promoter) has requested that tickets for the Last Night of the Proms will not be issued until one week before the date of the concert. By issuing the tickets at this later date we hope to reduce the opportunity for tickets to be sold above face value elsewhere.\",\"Inactive\":false}]}]},{\"ID\":2070,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101119,\"WishlistNumber\":447,\"StartDate\":\"2026-07-21T22:15:00+01:00\",\"EndDate\":\"2026-07-21T22:15:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Late Night Baroque\",\"Suffix\":\"Late Night\",\"ListingIndicator\":null,\"Summary\":\"The Jupiter Ensemble makes its Proms debut with British tenor Laurence Kilsby in a programme celebrating two jewels of the English Renaissance and Baroque – John Dowland and Henry Purcell – as well as ‘honorary’ Englishman George Frideric Handel.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-7-Late-Night-Baroque-2820-x-1480-JUL-21.jpg?type=image&id=7162&token=2e44708a&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-7-Late-Night-Baroque-2820-x-1480-JUL-21.jpg?type=image&id=7162&token=2e44708a&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-7-Late-Night-Baroque-2820-x-1480-JUL-21.jpg?type=image&id=7162&token=2e44708a&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-7-Late-Night-Baroque-2820-x-1480-JUL-21.jpg?type=image&id=7162&token=2e44708a&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-7-Late-Night-Baroque-2820-x-1480-JUL-21.jpg?type=image&id=7162&token=2e44708a&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Laurence Kilsby\",\"caption\":\"Laurence Kilsby © Karoline Heller \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/late-night-baroque\",\"DateDescription\":\"Tuesday 21 July 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#f5d8e9\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-7-Late-Night-Baroque-2820-x-1480-JUL-21.jpg?type=image&id=7162&token=2e44708a&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-7-Late-Night-Baroque-2820-x-1480-JUL-21.jpg?type=image&id=7162&token=2e44708a&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-7-Late-Night-Baroque-2820-x-1480-JUL-21.jpg?type=image&id=7162&token=2e44708a&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-7-Late-Night-Baroque-2820-x-1480-JUL-21.jpg?type=image&id=7162&token=2e44708a&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Laurence Kilsby\",\"caption\":\"Laurence Kilsby © Karoline Heller \"},\"Performances\":[{\"ID\":\"2070-101119\",\"PerformanceNumber\":101119,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-07-21T22:15:00+01:00\",\"TimeSlot\":\"Late Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-07-21T21:40:00+01:00\",\"MinimumPrice\":4.25,\"MaximumPrice\":28,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-7-Late-Night-Baroque-2820-x-1480-JUL-21.jpg?type=image&id=7162&token=2e44708a\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>Formed in 2018 by lutenist&nbsp;<strong>Thomas Dunford</strong>, the&nbsp;<strong>Jupiter Ensemble</strong>&nbsp;has enthused audiences around the world. The period-instrument collective makes its Proms debut in a programme celebrating two jewels of the English Renaissance and Baroque &ndash;&nbsp;<strong>John Dowland</strong>&nbsp;(in the 400th anniversary of his death) and the &lsquo;British Orpheus&rsquo;&nbsp;<strong>Henry Purcell</strong>&nbsp;&ndash; as well as &lsquo;honorary&rsquo; Englishman&nbsp;<strong>George Frideric Handel</strong>, whose dramatic instinct saw his works dominate the London stage.</p>\\r\\n<p>Lending his voice to songs of love&rsquo;s pains and pleasures is British tenor in the ascendant,&nbsp;<strong>Laurence Kilsby</strong>.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme to include:</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Dowland&nbsp;</strong>Can she excuse my wrongs?&nbsp;<em>3&rsquo;&nbsp;</em><br />Now, O now, I needs must part&nbsp;<em>4&rsquo;</em><br /><strong>Purcell</strong>&nbsp;If love&rsquo;s a sweet passion&nbsp;<em>5&rsquo;</em>&nbsp;<br />Strike the viol&nbsp;<em>4&rsquo;</em><br />Evening Hymn&nbsp;<em>5'</em><br /><strong>Handel</strong>&nbsp;Theodora &ndash; &lsquo;From virtue springs&rsquo;&nbsp;<em>8&rsquo;&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Laurence Kilsby&nbsp;</strong><em>tenor</em></p>\\r\\n<p><strong>Jupiter Ensemble&nbsp;</strong><br /><strong>Thomas Dunford</strong>&nbsp;<em>director/lute&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\\r\\n</div>\\r\\n</div>\\r\\n</div>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2086,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101137,\"WishlistNumber\":447,\"StartDate\":\"2026-08-01T19:00:00+01:00\",\"EndDate\":\"2026-08-01T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Mahler’s First by Heart\",\"Suffix\":\"Evening performance\",\"ListingIndicator\":null,\"Summary\":\"Proms favourites Nicholas Collon and the Aurora Orchestra lift the bonnet on Mahler’s First Symphony. A dramatised first half featuring mezzo-soprano Natalie Lewis introduces the piece, before a complete performance after the interval\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/P