\",\"Website\":null}],\"ThemeColor\":\"#003dba\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/BTMS/Emme-Hensel.png?type=image&id=7765&token=0461fe71&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/BTMS/Emme-Hensel.png?type=image&id=7765&token=0461fe71&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/BTMS/Emme-Hensel.png?type=image&id=7765&token=0461fe71&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/9-September/BTMS/Emme-Hensel.png?type=image&id=7765&token=0461fe71&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Emme Hensel\",\"caption\":null},\"Performances\":[{\"ID\":\"2237-102899\",\"PerformanceNumber\":102899,\"ProductionSeasonNumber\":99690,\"Date\":\"2026-11-08T11:00:00+00:00\",\"TimeSlot\":\"Morning\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2025-06-26T10:00:00+01:00\",\"OffSaleDate\":\"2026-11-08T10:25:00+00:00\",\"MinimumPrice\":12.73,\"MaximumPrice\":12.73,\"WebContents\":[{\"ContentTypeId\":9,\"ContentType\":\"Web Max Quantity Production\",\"Content\":\"10000\",\"Inactive\":false},{\"ContentTypeId\":43,\"ContentType\":\"Performance T&C's\",\"Content\":\"Coffee & Pastries to be served before the concert. The Elgar Room is unreserved table seating assigned on the day. It is very likely you will be asked to share a table with other patrons. Programme is subject to change.  Not recommend for under 5s\",\"Inactive\":false},{\"ContentTypeId\":67,\"ContentType\":\"Venue Name\",\"Content\":\"Elgar Room\",\"Inactive\":false},{\"ContentTypeId\":151,\"ContentType\":\"AppleWallet_Venue\",\"Content\":\"Elgar Room\",\"Inactive\":false},{\"ContentTypeId\":153,\"ContentType\":\"AppleWallet_Terms\",\"Content\":\"Coffee & Pastries to be served before the concert. The Elgar Room is unreserved table seating assigned on the day. It is very likely you will be asked to share a table with other patrons. Programme is subject to change.  Not recommend for under 5s\",\"Inactive\":false},{\"ContentTypeId\":407,\"ContentType\":\"OLD BA\",\"Content\":\"yes\",\"Inactive\":false}]}]},{\"ID\":2110,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101147,\"WishlistNumber\":447,\"StartDate\":\"2026-08-20T19:00:00+01:00\",\"EndDate\":\"2026-08-20T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Miles Davis Centenary\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"The Proms marks Miles Davis’s centenary with a concert combining his influences – works by Rodrigo and Gershwin – with his own hits. Trumpeter Ambrose Akinmusire joins the BBC Concert Orchestra and Miho Hazama for a celebration of a jazz legend.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-44-Miles-Davis-Centenary-2820-x-1480-AUG-20.jpg?type=image&id=7197&token=b2523cd8&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-44-Miles-Davis-Centenary-2820-x-1480-AUG-20.jpg?type=image&id=7197&token=b2523cd8&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-44-Miles-Davis-Centenary-2820-x-1480-AUG-20.jpg?type=image&id=7197&token=b2523cd8&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-44-Miles-Davis-Centenary-2820-x-1480-AUG-20.jpg?type=image&id=7197&token=b2523cd8&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-44-Miles-Davis-Centenary-2820-x-1480-AUG-20.jpg?type=image&id=7197&token=b2523cd8&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Ambrose Akinmusire\",\"caption\":\"Ambrose Akinmusire © Michael Wilson \"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"BBC Proms\",\"Jazz\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/miles-davis-centenary\",\"DateDescription\":\"Thursday 20 August 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#342a83\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-44-Miles-Davis-Centenary-2820-x-1480-AUG-20.jpg?type=image&id=7197&token=b2523cd8&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-44-Miles-Davis-Centenary-2820-x-1480-AUG-20.jpg?type=image&id=7197&token=b2523cd8&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-44-Miles-Davis-Centenary-2820-x-1480-AUG-20.jpg?type=image&id=7197&token=b2523cd8&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-44-Miles-Davis-Centenary-2820-x-1480-AUG-20.jpg?type=image&id=7197&token=b2523cd8&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Ambrose Akinmusire\",\"caption\":\"Ambrose Akinmusire © Michael Wilson \"},\"Performances\":[{\"ID\":\"2110-101147\",\"PerformanceNumber\":101147,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-08-20T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":false,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-08-20T18:25:00+01:00\",\"MinimumPrice\":7.23,\"MaximumPrice\":68,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":50,\"ContentType\":\"Show Promo Code Box\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-44-Miles-Davis-Centenary-2820-x-1480-AUG-20.jpg?type=image&id=7197&token=b2523cd8\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>Trumpeter, bandleader and composer&nbsp;<strong>Miles Davis</strong>&nbsp;transformed modern jazz with music that embraced the world around him &ndash; a new and exhilarating collage of modal scales, electronic and classical influences, expansive new structures and, of course, technical virtuosity.</p>\\r\\n<p>The Proms marks Davis&rsquo;s centenary with a concert that combines the musician&rsquo;s influences &ndash; works by&nbsp;<strong>Rodrigo</strong>&nbsp;and&nbsp;<strong>Gershwin</strong>&nbsp;&ndash; with his own hits. &lsquo;Incandescent&rsquo; American jazz trumpeter&nbsp;<strong>Ambrose Akinmusire</strong>&nbsp;joins the&nbsp;<strong>BBC Concert Orchestra&nbsp;</strong>and&nbsp;<strong>Miho Hazama</strong>&nbsp;for a celebration of a jazz legend.</p>\\r\\n<p><em>Broadcast on BBC TV and BBC iPlayer.</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>Programme to include new arrangements of excerpts from &lsquo;Miles Ahead&rsquo;, &lsquo;Porgy and Bess&rsquo;, &lsquo;Sketches of Spain&rsquo; and &lsquo;Quiet Nights&rsquo;.&nbsp;</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Ambrose Akinmusire</strong><em>&nbsp;trumpet</em><br /><strong>Sam Harris&nbsp;</strong><em>piano</em><br /><strong>Harish Raghavan&nbsp;</strong><em>bass</em><br /><strong>Justin Brown&nbsp;</strong><em>drums</em></p>\\r\\n<p><strong>BBC Concert Orchestra</strong><br /><strong>Miho Hazama</strong>&nbsp;<em>conductor</em></p>\\r\\n<p><em>There will be one interval.</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2232,\"ProductionSeasonNumber\":99690,\"PerformanceNumber\":102896,\"WishlistNumber\":null,\"StartDate\":\"2026-10-18T11:00:00+01:00\",\"EndDate\":\"2026-10-18T11:00:00+01:00\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"Classical Coffee Mornings: Eva Schockmel\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Eva Schockmel performs her Classical Coffee Morning in the Elgar Room, complete with a hot drink and a pastry.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-I