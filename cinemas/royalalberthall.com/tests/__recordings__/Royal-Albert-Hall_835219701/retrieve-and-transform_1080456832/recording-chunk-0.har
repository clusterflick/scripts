e\":null},{\"Type\":\"Person\",\"Title\":\"Christopher Warren-Green\",\"Role\":\"conductor\",\"Website\":null},{\"Type\":\"Music Group\",\"Title\":\"Royal Philharmonic Concert Orchestra\",\"Role\":null,\"Website\":null},{\"Type\":\"Music Group\",\"Title\":\"Highgate Choral Society\",\"Role\":null,\"Website\":null},{\"Type\":\"Music Group\",\"Title\":\"Battersea Choral Society\",\"Role\":null,\"Website\":null},{\"Type\":\"Music Group\",\"Title\":\"Harrow Choral Society\",\"Role\":null,\"Website\":null},{\"Type\":\"Music Group\",\"Title\":\"Teddington Choral Society\",\"Role\":null,\"Website\":null},{\"Type\":\"Music Group\",\"Title\":\"The Southend Boys' Choir\",\"Role\":null,\"Website\":null}],\"ThemeColor\":\"#0d2626\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/New-Website-images/0057_carmina-burana.png?type=image&id=2165&token=cdaccea1&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/New-Website-images/0057_carmina-burana.png?type=image&id=2165&token=cdaccea1&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/New-Website-images/0057_carmina-burana.png?type=image&id=2165&token=cdaccea1&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/New-Website-images/0057_carmina-burana.png?type=image&id=2165&token=cdaccea1&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":null,\"caption\":null},\"Performances\":[{\"ID\":\"1884-99174\",\"PerformanceNumber\":99174,\"ProductionSeasonNumber\":99173,\"Date\":\"2026-11-22T14:30:00+00:00\",\"TimeSlot\":\"Afternoon\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2025-11-21T10:00:00+00:00\",\"OffSaleDate\":\"2026-11-22T13:55:00+00:00\",\"MinimumPrice\":20,\"MaximumPrice\":267.65,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":65,\"ContentType\":\"Members - Web Image URL\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/New-Website-images/0057_carmina-burana.png?type=image&id=2165&token=cdaccea1\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p><span style=\\\"color: black;\\\">Raymond Gubbay presents: </span><strong style=\\\"color: black;\\\">Carmina Burana 2026 </strong></p><p><br></p><p><span style=\\\"color: black;\\\">After selling out in 2025 and thrilling over 60,000 audience members, </span><strong style=\\\"color: black;\\\">Carmina Burana</strong><span style=\\\"color: black;\\\"> returns to the Hall for another unforgettable performance. </span></p><p><span style=\\\"color: black;\\\">Prepare to be moved — as 400 voices unite in breathtaking harmony, filling the Hall with the thunderous, heart-pounding energy of </span><strong style=\\\"color: black;\\\">Orff</strong><span style=\\\"color: black;\\\">’s masterpiece. Step into a world of sweeping melodies and heart-stirring drama with </span><strong style=\\\"color: black;\\\">Bruch</strong><span style=\\\"color: black;\\\">’s </span><em style=\\\"color: black;\\\">Violin Concerto</em><span style=\\\"color: black;\\\">, a masterpiece that blends fiery passion with lyrical beauty. </span></p><p><span style=\\\"color: black;\\\">From Finlandia to unforgettable Bruch’s </span><em style=\\\"color: black;\\\">Violin Concerto</em><span style=\\\"color: black;\\\">, the evening unfolds in a wave of passion, power, and pure musical joy.</span></p>\",\"Inactive\":false},{\"ContentTypeId\":72,\"ContentType\":\"PT: Fine Dining \",\"Content\":\"<p>To include:</p>\\r\\n<p>*Premium Stalls Seating&nbsp;</p>\\r\\n<p>*Three course dinner in Coda by Chavot Re