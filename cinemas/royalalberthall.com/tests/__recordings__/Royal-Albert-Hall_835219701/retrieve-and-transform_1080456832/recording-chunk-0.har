kets\",\"BookingURL\":\"https://tickets.royalalberthall.com/production/101847\",\"Categories\":[\"Rock and Pop\",\"Contemporary Classical\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2026/symphonic-soul\",\"DateDescription\":\"Sunday 4 October 2026\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[{\"Type\":\"Person\",\"Title\":\"Michael England\",\"Role\":\"Conductor\",\"Website\":null},{\"Type\":\"Person\",\"Title\":\"Gloria Onitiri\",\"Role\":\"Vocalist\",\"Website\":null},{\"Type\":\"Person\",\"Title\":\"Trevor Dion Nicholas\",\"Role\":\"Vocalist\",\"Website\":null},{\"Type\":\"Music Group\",\"Title\":\"Royal Philharmonic Orchestra\",\"Role\":null,\"Website\":null},{\"Type\":\"Person\",\"Title\":\"Angie Greaves\",\"Role\":\"Presenter\",\"Website\":null}],\"ThemeColor\":\"#fc9400\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/RP039-Symphonic-Soul-RAH-2820x1487px-ARTW.jpg?type=image&id=6117&token=2d513925&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/RP039-Symphonic-Soul-RAH-2820x1487px-ARTW.jpg?type=image&id=6117&token=2d513925&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/RP039-Symphonic-Soul-RAH-2820x1487px-ARTW.jpg?type=image&id=6117&token=2d513925&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/RP039-Symphonic-Soul-RAH-2820x1487px-ARTW.jpg?type=image&id=6117&token=2d513925&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"A man and woman singing in front of a record\",\"caption\":null},\"Performances\":[{\"ID\":\"1882-99181\",\"PerformanceNumber\":99181,\"ProductionSeasonNumber\":101847,\"Date\":\"2026-10-04T15:00:00+01:00\",\"TimeSlot\":\"Afternoon\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2025-11-21T10:00:00+00:00\",\"OffSaleDate\":\"2026-10-04T14:25:00+01:00\",\"MinimumPrice\":7,\"MaximumPrice\":267.65,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":65,\"ContentType\":\"Members - Web Image URL\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/RP039-Symphonic-Soul-RAH-2820x1487px-ARTW.jpg?type=image&id=6117&token=2d513925\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<p><span style=\\\"color: black;\\\">Royal Philharmonic Orchestra presents: </span><strong style=\\\"color: black;\\\">Symphonic Soul </strong></p><p><span style=\\\"color: black;\\\">Get ready for another unmissable celebration of soul music with the </span><strong style=\\\"color: black;\\\">Royal Philharmonic Orchestra</strong><span style=\\\"color: black;\\\"> as the Hall is filled with the seminal sounds of the iconic Motown label, as well as other sensational soul artists of the era. </span></p><p><span style=\\\"color: black;\\\">This get-up-and-dance concert features songs by the artists who brought gospel, blues and soul music to new heights such as: Stevie Wonder, Gladys Knight, Marvin Gaye, Smokey Robinson, Diana Ross, Jackson 5, Martha Reeves and, the Queen of Soul herself, Aretha Franklin. </span></p><p><span style=\\\"color: black;\\\">We are thrilled to, once again, be joined by star vocalists </span><strong style=\\\"color: black;\\\">Gloria Onitiri </strong><span style=\\\"color: black;\\\">and </span><strong style=\\\"color: black;\\\">Trevor Dion Nicholas</strong><span style=\\\"color: black;\\\"> for a host of classic Motown anthems, including: </span><em style=\\\"color: black;\\\">R.E.S.P.E.C.T., Ain’t No Mountain High Enough, I Heard It Through the Grapevine, Reach Out (I’ll Be There), Dancing in the Street, Midnight Train to Georgia, Stop! In the Name of Love, Don’t You Worry ‘Bout A Thing, My Guy, Proud Mary, What Becomes of the Broken Hearted, You Can’t Hurry Love</em><span style=\\\"color: black;\\\"> and </span><em style=\\\"color: black;\\\">My Girl. </em></p><p><span style=\\\"color: black;\\\">We are also thrilled to welcome back special guest presenter, </span><strong style=\\\"color: black;\\\">Angie Greaves</strong><span style=\\\"color: black;\\\"> (Smooth Radio). </span></p><p><strong style=\\\"color: black;\\\">Michael England </strong><span style=\\\"color: black;\\\">Conductor</span></p><p> <strong style=\\\"color: black;\\\">Gloria Onitiri</strong><span style=\\\"color: black;\\\"> Vocalist</span></p><p> <strong style=\\\"color: black;\\\">Trevor Dion Nicholas</strong><span style=\\\"color: black;\\\"> Vocalist</span></p><p> <strong style=\\\"color: black;\\\">Royal Philharmonic Orchestra</strong></p><p><strong style=\\\"color: black;\\\"> Angie Greaves</strong><span style=\\\"color: black;\\\"> Presenter</span></p><p><span style=\\\"color: black;\\\">____________________________________________________________________________________________ </span></p><p><strong style=\\\"color: black;\\\">DYNAMIC PRICING </strong></p><p><span style=\\\"color: black;\\\">In the normal way dynamic pricing is in place at the Hall for events promoted by the Royal Philharmonic Orchestra, Cirque du Soleil and the Royal Albert Hall. </span></p><p><span style=\\\"color: black;\\\">This means that promoter ticket prices might fluctuate for these events (both up and down) according to demand. Dynamic, or flexible pricing, has been commonly used in the airline and hotel industry for many years and is now becoming commonplace in entertainment as well. Any prices changes will apply to all tickets sold by the Hall's Box Office&nbsp;</span></p>\",\"Inactive\":false}]},{\"ID\