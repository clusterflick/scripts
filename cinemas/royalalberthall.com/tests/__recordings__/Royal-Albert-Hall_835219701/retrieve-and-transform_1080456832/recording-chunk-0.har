&id=7318&token=fd100d6b&mode=fill&top=0&left=17&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Freya-Ridings-2820x1487.png?type=image&id=7318&token=fd100d6b&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"alt\":\"Freya Ridings\",\"caption\":null},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"On Sale\",\"BookingLabel\":\"Find Tickets\",\"BookingURL\":\"https://tickets.royalalberthall.com/booking/production/101637\",\"Categories\":[\"Rock and Pop\"],\"Accessibility\":[],\"EventURL\":\"/tickets/events/2026/freya-ridings\",\"DateDescription\":\"Monday 5 October 2026\",\"Type\":\"EventPage\",\"UsePromsPlanner\":false,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#f2e861\",\"Theme\":\"light\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Freya-Ridings-2820x1487.png?type=image&id=7318&token=fd100d6b&mode=fill&top=0&left=11&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Freya-Ridings-2820x1487.png?type=image&id=7318&token=fd100d6b&mode=fill&top=0&left=22&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Freya-Ridings-2820x1487.png?type=image&id=7318&token=fd100d6b&mode=fill&top=58&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Freya-Ridings-2820x1487.png?type=image&id=7318&token=fd100d6b&mode=fill&top=116&left=0&width=1200&height=400&format=webp\",\"alt\":\"Freya Ridings\",\"caption\":null},\"Performances\":[{\"ID\":\"2149-101637\",\"PerformanceNumber\":101637,\"ProductionSeasonNumber\":101636,\"Date\":\"2026-10-05T19:30:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-04-17T10:00:00+01:00\",\"OffSaleDate\":\"2026-10-05T18:55:00+01:00\",\"MinimumPrice\":35,\"MaximumPrice\":243.14,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"8\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<p>Communion One presents:&nbsp;<strong>Freya Ridings</strong></p>\\r\\n<p>Following the announcement of her album&nbsp;<em>Mother Of Pearl</em>,&nbsp;<strong>Freya Ridings</strong>&nbsp;is coming to the Hall this autumn.</p>\\r\\n<p>Since breaking through with Top 10 single&nbsp;<em>Lost Without You</em>&nbsp;back in 2017, Ridings has cemented herself as one of the UK&rsquo;s most impressive vocal talents, with the ability to turn her hand to tender balladry and powerful air punch moments alike. That break out single has, to date, been streamed almost half a billion times on Spotify alone, while 2019&rsquo;s self-titled debut album and 2023 follow-up&nbsp;<em>Blood Orange</em>&nbsp;both landed in the Top 10 of the UK Album Charts.&nbsp;</p>\\r\\n</div>\",\"Inactive\":false},{\"ContentTypeId\":72,\"ContentType\":\"PT: Fine Dining \",\"Content\":\"<p>To include:</p>\\r\\n<p>*Front Arena Seat <br />*Three course dinner in Coda by Chavot Restaurant<br />*Welcome glass Champagne and half bottle of wine per person</p>\",\"Inactive\":false},{\"ContentTypeId\":79,\"ContentType\":\"PT: Loggia Hospitality\",\"Content\":\"<p>To include:</p>\\r\\n<p>*Private hire of box for 8 guests <br />*Box waiter <br />*4 bottles wine per box, 8 beers, mineral water and selection of soft drinks <br />*Cold bowl dish, loaded nachos, sliders and fries and dessert canapes</p>\",\"Inactive\":false},{\"ContentTypeId\":80,\"ContentType\":\"PT: Second Tier Hospitality\",\"Content\":\"<p>To include:</p>\\r\\n<p>*Private hire of box for 4 guests<br />*Box waiter <br />*2 bottles wine per box, 4 beers, mineral water and selection of soft drinks <br />*Cold bowl dish, loaded nachos, sliders and fries and dessert canapes</p>\",\"Inactive\":false},{\"ContentTypeId\":293,\"ContentType\":\"PT: VIP Lounge\",\"Content\":\"<p>To include:</p>\\r\\n<p>*Premium Stalls Seating <br />*Pre and interval VIP Lounge<br />*Canapes, bowl dishes, desserts, wine, beer and soft drinks</p>\",\"Inactive\":false}]}]},{\"ID\":2196,\"ProductionSeasonNumber\":102637,\"PerformanceNumber\":102638,\"WishlistNumber\":null,\"StartDate\":\"2026-10-30T14:00:00Z\",\"EndDate\":\"2026-10-30T14:00:00Z\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"Friendship Matinee: Matilda in Concert (PG)\",\"Suffix\":\"Relaxed Performance\",\"ListingIndicator\":null,\"Summary\":\"Friendship Matinee welcomes people of all ages who may engage with a charity or community group to Matilda!\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Matilda-in-Concert/Matilda-2.jpg?type=image&id=5606&token=c069107d&mode=fill&top=1&left=0&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Matilda-in-Concert/Matilda-2.jpg?type=image&id=5606&token=c069107d&mode=fill&top=1&left=0&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/10-October/Matilda-in-Concert/Matilda-2.jpg?type=image&id=5606&token=c069107d&mode=fill&top=1&left=0&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-I