meColor\":\"#0093dd\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-13-Olivier-Latry-Plays-Bach-2820-x-1480-JUL-26.jpg?type=image&id=7167&token=2c082a6a&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-13-Olivier-Latry-Plays-Bach-2820-x-1480-JUL-26.jpg?type=image&id=7167&token=2c082a6a&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-13-Olivier-Latry-Plays-Bach-2820-x-1480-JUL-26.jpg?type=image&id=7167&token=2c082a6a&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-13-Olivier-Latry-Plays-Bach-2820-x-1480-JUL-26.jpg?type=image&id=7167&token=2c082a6a&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Olivier Latry\",\"caption\":\"Olivier Latry © Deyan Parouchev \"},\"Performances\":[{\"ID\":\"2076-101161\",\"PerformanceNumber\":101161,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-07-26T11:00:00+01:00\",\"TimeSlot\":\"Morning\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-07-26T10:25:00+01:00\",\"MinimumPrice\":5.1,\"MaximumPrice\":46,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-13-Olivier-Latry-Plays-Bach-2820-x-1480-JUL-26.jpg?type=image&id=7167&token=2c082a6a\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>Titular Organist of the Grand Organ at Notre-Dame in Paris,&nbsp;<strong>Olivier Latry&nbsp;</strong>returns for an all-Bach programme with a twist. Hear the Royal Albert Hall&rsquo;s organ put through its paces in arrangements and improvisations on&nbsp;<strong>Bach</strong>&nbsp;by great organists&nbsp;<strong>Widor</strong>,&nbsp;<strong>Durufl&eacute;</strong>&nbsp;and&nbsp;<strong>Latry</strong>&nbsp;himself.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>J. S. Bach arr. Messerer&nbsp;</strong>PartitaNo. 2 in D minor, BWV 1004 &ndash; Chaconne&nbsp;<em>17&rsquo;&nbsp;</em><br /><strong>J. S. Bach transcr. Durufl&eacute;&nbsp;</strong>Cantata No. 147 &ndash; Chorale &lsquo;Jesus bleibet meine Freude&rsquo;&nbsp;<em>4&rsquo;</em>&nbsp;<br /><strong>J. S. Bach arr. Widor</strong>&nbsp;Bach&rsquo;s Memento &ndash; Mattheus-Final&nbsp;<em>6&rsquo;&nbsp;</em><br /><strong>J. S. Bach transcr. Gigout&nbsp;</strong>Cantata No. 68 &ndash; Aria &lsquo;Mein gl&auml;ubiges Herze&rsquo;&nbsp;<em>3&rsquo;</em>&nbsp;<br /><strong>J. S. Bach, after Vivaldi</strong>&nbsp;Concerto in A minor, BWV 593&nbsp;<em>12&rsquo;&nbsp;</em><br /><strong>J. S. Bach</strong>&nbsp;Prelude and Fugue in D minor, BWV 539&nbsp;<em>8&rsquo;&nbsp;</em><br /><strong>J. S. Bach</strong>&nbsp;Chorale &lsquo;Kommst du nun, Jesu, von Himmel herunter&rsquo;, BWV 650&nbsp;<em>4&rsquo;&nbsp;</em><br /><strong>J. S. Bach&nbsp;</strong>Toccata and Fugue in D minor, BWV 565&nbsp;<em>10&rsquo;</em>&nbsp;<br /><strong>Olivier Latry</strong>&nbsp;Improvisation on B-A-C-H&nbsp;<em>c10&rsquo;&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Olivier Latry&nbsp;</strong><em>organ</em></p>\\r\\n<p><em>There will be 