er\":102895,\"ProductionSeasonNumber\":99690,\"Date\":\"2026-10-11T11:00:00+01:00\",\"TimeSlot\":\"Morning\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2025-06-26T10:00:00+01:00\",\"OffSaleDate\":\"2026-10-11T10:25:00+01:00\",\"MinimumPrice\":12.73,\"MaximumPrice\":12.73,\"WebContents\":[{\"ContentTypeId\":9,\"ContentType\":\"Web Max Quantity Production\",\"Content\":\"10000\",\"Inactive\":false},{\"ContentTypeId\":43,\"ContentType\":\"Performance T&C's\",\"Content\":\"Coffee & Pastries to be served before the concert. The Elgar Room is unreserved table seating assigned on the day. It is very likely you will be asked to share a table with other patrons. Programme is subject to change.  Not recommend for under 5s\",\"Inactive\":false},{\"ContentTypeId\":67,\"ContentType\":\"Venue Name\",\"Content\":\"Elgar Room\",\"Inactive\":false},{\"ContentTypeId\":151,\"ContentType\":\"AppleWallet_Venue\",\"Content\":\"Elgar Room\",\"Inactive\":false},{\"ContentTypeId\":153,\"ContentType\":\"AppleWallet_Terms\",\"Content\":\"Coffee & Pastries to be served before the concert. The Elgar Room is unreserved table seating assigned on the day. It is very likely you will be asked to share a table with other patrons. Programme is subject to change.  Not recommend for under 5s\",\"Inactive\":false},{\"ContentTypeId\":407,\"ContentType\":\"OLD BA\",\"Content\":\"yes\",\"Inactive\":false}]}]},{\"ID\":2111,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101175,\"WishlistNumber\":447,\"StartDate\":\"2026-08-21T19:00:00+01:00\",\"EndDate\":\"2026-08-21T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Mahler’s ‘Song of the Earth’\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Star mezzo Jamie Barton joins Anja Bihlmaier and the BBC Philharmonic Orchestra for Mahler’s epic collision of symphony and song. The first half sees the witty musical parting of Haydn’s ‘Farewell’ Symphony and Bushra El-Turk’s meditative Mosaic.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Jamie-Barton-2820x1480.jpg?type=image&id=7390&token=0b966afe&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Jamie-Barton-2820x1480.jpg?type=image&id=7390&token=0b966afe&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Jamie-Barton-2820x1480.jpg?type=image&id=7390&token=0b966afe&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Jamie-Barton-2820x1480.jpg?type=image&id=7390&token=0b966afe&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Jamie-Barton-2820x1480.jpg?type=image&id=7390&token=0b966afe&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Jamie Barton\",\"caption\":\"Jamie Barton © Stacey Bode\"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\",\"Opera\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/mahlers-song-of-the-earth\",\"DateDescription\":\"Friday 21 August 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#342a83\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Jamie-Barton-2820x1480.jpg?type=image&id=7390&token=0b966afe&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Jamie-Barton-2820x1480.jpg?type=image&id=7390&token=0b966afe&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Jamie-Barton-2820x1480.jpg?type=image&id=7390&token=0b966afe&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Jamie-Barton-2820x1480.jpg?type=image&id=7390&token=0b966afe&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Jamie Barton\",\"caption\":\"Jamie Barton © Stacey Bode\"},\"Performances\":[{\"ID\":\"2111-101175\",\"PerformanceNumber\":101175,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-08-21T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-08-21T18:25:00+01:00\",\"MinimumPrice\":5.95,\"MaximumPrice\":56,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Jamie-Barton-2820x1480.jpg?type=image&id=7390&token=0b966afe\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>&lsquo;How should I describe such a colossal crisis?&rsquo;&nbsp;<strong>Mahler</strong>&nbsp;wrote in 1909. &lsquo;Yet I am thirstier than ever for life &hellip;&rsquo; Personal and professional loss had taken the composer to the brink, but even as he faced tragedy he experienced the pleasures of living with renewed intensity. It&rsquo;s this strange, urgent ecstasy that runs through&nbsp;<em>Das Lied von der Erde</em>&nbsp;(&lsquo;The Song of the Earth&rsquo;) &ndash; a collision of symphony and song, life and loss.</p>\\r\\n<p>This epic musical farewell meets the witty musical parting of&nbsp;<strong>Haydn</strong>&rsquo;s&nbsp;<em>&lsquo;Farewell&rsquo; Symphony</em>, with its famous final movement of ever-shrinking forces. Bushra El-Turk&rsquo;s Mosaic opens the concert with nods to Das Lied, in a meditation on identity, otherness and exoticism.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Bushra El-Turk</strong>&nbsp;Mosaic&nbsp;<em>8&rsquo;&nbsp;</em><br /><strong>Haydn</strong>&nbsp;Symphony No. 45 in F sharp minor, &lsquo;Farewell&rsquo;&nbsp;<em>28&rsquo;&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Mahler</strong>&nbsp;Das Lied von der Erde&nbsp;<em>68&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Jamie Barton&nbsp;</strong><em>mezzo-soprano</em><br /><strong>Clay Hilley&nbsp;</strong><em>tenor</em></p>\\r\\n<p><strong>BBC Philharmonic Orchestra</strong><br /><strong>Anja Bihlmaier</strong>&nbsp;<em>conductor</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2071,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101133,\"WishlistNumber\":447,\"StartDate\":\"2026-07-22T19:00:00+01:00\",\"EndDate\":\"2026-07-22T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Mahler’s ‘Tragic’ Sixth\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Sakari Oramo and the BBC Symphony Orchestra perform Mahler’s brooding Sixth Symphony, and celebrate the centenary of Hungary’s greatest living composer, György Kurtág, with a rare performance of his powerful orchestral elegy Stele.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-8-Mahlers-Tragic-Sixth-2820-x-1480-JUL-22.jpg?type=image&id=7163&token=e91731d7&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-8-Mahlers-Tragic-Sixth-2820-x-1480-JUL-22.jpg?type=image&id=7163&token=e91731d7&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-8-Mahlers-Tragic-Sixth-2820-x-1480-JUL-22.jpg?type=image&id=7163&token=e91731d7&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-8-Mahlers-Tragic-Sixth-2820-x-1480-JUL-22.jpg?type=image&id=7163&token=e91731d7&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-8-Mahlers-Tragic-Sixth-2820-x-1480-JUL-22.jpg?type=image&id=7163&token=e91731d7&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Sakari Oramo\",\"caption\":\"Sakari Oramo © Benjamin Ealovega\"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/mahlers-tragic-sixth\",\"DateDescription\":\"Wednesday 22 July 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#0093dd\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-8-Mahlers-Tragic-Sixth-2820-x-1480-JUL-22.jpg?type=image&id=7163&token=e91731d7&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-8-Mahlers-Tragic-Sixth-2820-x-1480-JUL-22.jpg?type=image&id=7163&token=e91731d7&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-8-Mahlers-Tragic-Sixth-2820-x-1480-JUL-22.jpg?type=image&id=7163&token=e91731d7&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-8-Mahlers-Tragic-Sixth-2820-x-1480-JUL-22.jpg?type=image&id=7163&token=e91731d7&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Sakari Oramo\",\"caption\":\"Sakari Oramo © Benjamin Ealovega\"},\"Performances\":[{\"ID\":\"2071-101133\",\"PerformanceNumber\":101133,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-07-22T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":true,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-07-22T18:25:00+01:00\",\"MinimumPrice\":7.23,\"MaximumPrice\":68,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-8-Mahlers-Tragic-Sixth-2820-x-1480-JUL-22.jpg?type=image&id=7163&token=e91731d7\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p>Heroes fall but fight on in a programme of monumental soundscapes, poised on the edge of life and death.</p>\\r\\n<p><strong>Sakari Oramo</strong>&nbsp;and the&nbsp;<strong>BBC Symphony Orchestra</strong>&nbsp;celebrate the centenary of Hungary&rsquo;s greatest living composer,&nbsp;<strong>Gy&ouml;rgy Kurt&aacute;g</strong>, with a rare performance of his powerful orchestral elegy&nbsp;<em>Stele</em>, whose kaleidoscopic textures capture the commotion of a battlefield as seen by a wounded man. In Kurt&aacute;g&rsquo;s own words: &lsquo;The fighting rages all around him, but he sees only a very clear, very blue sky.&rsquo;</p>\\r\\n<p>Written at one of the happiest times of the composer&rsquo;s life,&nbsp;<strong>Mahler</strong>&rsquo;s premonitory &lsquo;Tragic&rsquo;&nbsp;<em>Symphony No. 6</em>&nbsp;&ndash; haunted by children&rsquo;s voices, dances and marches, by losses and agonies yet to come &ndash; broods on human frailty and resilience in music that threatens to burst the banks of the classical symphony.</p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Gy&ouml;rgy Kurt&aacute;g</strong>&nbsp;Stele&nbsp;<em>13&rsquo;&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Mahler</strong>&nbsp;Symphony No. 6 in A minor&nbsp;<em>79&rsquo;&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>BBC Symphony Orchestra&nbsp;</strong><br /><strong>Sakari Oramo</strong>&nbsp;<em>conductor&nbsp;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false},{\"ContentTypeId\":228,\"ContentType\":\"PT: 18 & Under\",\"Content\":\"The government have introduced a temporary reduced rate of VAT for children's tickets of 5% between 25 June and 1 September, and the prices of BBC Proms 18-and-under tickets for this period have been reduced in order to pass this reduced rate onto customers.\",\"Inactive\":false}]}]},{\"ID\":2136,\"ProductionSeasonNumber\":99706,\"PerformanceNumber\":101112,\"WishlistNumber\":447,\"StartDate\":\"2026-09-05T19:00:00+01:00\",\"EndDate\":\"2026-09-05T19:00:00+01:00\",\"Prefix\":\"BBC Proms presents\",\"Title\":\"BBC Proms: Martha Argerich Plays Beethoven\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Legendary pianist Martha Argerich returns to the Proms, joining Lahav Shani and the Munich Philharmonic for Beethoven’s Second Piano Concerto. We also hear Louise Farrenc’s dramatic Overture No. 2 and the final symphony by Brahms.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-64-Martha-Argerich-plays-Beethoven-2820-x-1480-SEP-5.jpg?type=image&id=7217&token=b83e39a9&mode=fill&top=0&left=9&width=300&height=167&format=webp\",\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-64-Martha-Argerich-plays-Beethoven-2820-x-1480-SEP-5.jpg?type=image&id=7217&token=b83e39a9&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-64-Martha-Argerich-plays-Beethoven-2820-x-1480-SEP-5.jpg?type=image&id=7217&token=b83e39a9&mode=fill&top=0&left=18&width=600&height=334&format=webp\",\"w650\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-64-Martha-Argerich-plays-Beethoven-2820-x-1480-SEP-5.jpg?type=image&id=7217&token=b83e39a9&mode=fill&top=0&left=18&width=650&height=361&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-64-Martha-Argerich-plays-Beethoven-2820-x-1480-SEP-5.jpg?type=image&id=7217&token=b83e39a9&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"alt\":\"Martha Argerich\",\"caption\":\"Martha Argerich © Adriano Heitman\"},\"Venue\":\"Auditorium\",\"VenueDetails\":{\"ID\":4,\"StreetAddress\":\"Kensington Gore\",\"AddressLocality\":\"Kensington\",\"AddressRegion\":\"London\",\"PostalCode\":\"SW7 2AP\",\"AddressCountry\":\"GB\",\"MapURL\":\"https://www.royalalberthall.com/plan-your-visit-essential-safety-information/getting-here/\"},\"BookingStatus\":\"Proms Planner\",\"BookingLabel\":\"Proms Planner\",\"BookingURL\":null,\"Categories\":[\"Classical\",\"BBC Proms\"],\"Accessibility\":[],\"EventURL\":\"/tickets/proms/bbc-proms-2026/martha-argerich-plays-beethoven\",\"DateDescription\":\"Saturday 5 September 2026\",\"Type\":\"PromPage\",\"UsePromsPlanner\":true,\"Program\":[],\"Artists\":[],\"ThemeColor\":\"#0093dd\",\"Theme\":\"dark\",\"MembersImage\":{\"w410\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-64-Martha-Argerich-plays-Beethoven-2820-x-1480-SEP-5.jpg?type=image&id=7217&token=b83e39a9&mode=fill&top=0&left=12&width=410&height=228&format=webp\",\"w820\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-64-Martha-Argerich-plays-Beethoven-2820-x-1480-SEP-5.jpg?type=image&id=7217&token=b83e39a9&mode=fill&top=0&left=24&width=820&height=456&format=webp\",\"w600\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-64-Martha-Argerich-plays-Beethoven-2820-x-1480-SEP-5.jpg?type=image&id=7217&token=b83e39a9&mode=fill&top=57&left=0&width=600&height=200&format=webp\",\"w1200\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-64-Martha-Argerich-plays-Beethoven-2820-x-1480-SEP-5.jpg?type=image&id=7217&token=b83e39a9&mode=fill&top=114&left=0&width=1200&height=400&format=webp\",\"alt\":\"Martha Argerich\",\"caption\":\"Martha Argerich © Adriano Heitman\"},\"Performances\":[{\"ID\":\"2136-101112\",\"PerformanceNumber\":101112,\"ProductionSeasonNumber\":99706,\"Date\":\"2026-09-05T19:00:00+01:00\",\"TimeSlot\":\"Evening\",\"HasTicketsUnderX\":false,\"OnSaleDate\":\"2026-05-16T09:00:00+01:00\",\"OffSaleDate\":\"2026-09-05T18:25:00+01:00\",\"MinimumPrice\":13,\"MaximumPrice\":86,\"WebContents\":[{\"ContentTypeId\":1,\"ContentType\":\"Web SYOS\",\"Content\":\"yes\",\"Inactive\":false},{\"ContentTypeId\":10,\"ContentType\":\"Web Max Quantity Performance\",\"Content\":\"12\",\"Inactive\":false},{\"ContentTypeId\":54,\"ContentType\":\"Proms Thumbnail url\",\"Content\":\"https://d117kfg112vbe4.cloudfront.net/public/Royal-Albert-Hall-DAMS/Promoter-Imagery/2026/7-July/BBC-Proms-2026/Prom-64-Martha-Argerich-plays-Beethoven-2820-x-1480-SEP-5.jpg?type=image&id=7217&token=b83e39a9\",\"Inactive\":false},{\"ContentTypeId\":66,\"ContentType\":\"Members - Web Description\",\"Content\":\"<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Yuja Wang</strong>&nbsp;calls her the &lsquo;pure goddess&rsquo; of the piano, to others she&rsquo;s simply the world&rsquo;s greatest living pianist:&nbsp;<strong>Martha Argerich</strong>&nbsp;is back at the Proms, joining&nbsp;<strong>Lahav Shani</strong>&nbsp;and the&nbsp;<strong>Munich Philharmonic&nbsp;</strong>for the singing beauty and light-hearted delight of&nbsp;<strong>Beethoven</strong>&rsquo;s&nbsp;<em>Second Piano Concerto</em>.</p>\\r\\n<p><strong>Brahms</strong>&rsquo;s final symphony offers glimpses of warmth and joy, but always shrouded in melancholy. One critic compared the work to gazing into a deep well: &lsquo;The longer we look into it, the more brightly the stars shine back &hellip;&rsquo; The concert opens with&nbsp;<strong>Louise Farrenc</strong>&rsquo;s dramatic&nbsp;<em>Overture No. 2</em>.</p>\\r\\n<p><em>Broadcast on BBC TV and BBC iPlayer.</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<section>\\r\\n<div>\\r\\n<h2>Programme</h2>\\r\\n<div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Farrenc</strong>&nbsp;Overture No. 2&nbsp;<em>7&rsquo;</em><br /><strong>Beethoven</strong>&nbsp;Piano Concerto No. 2 in B flat major&nbsp;<em>28&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<div>Interval<hr /></div>\\r\\n</div>\\r\\n<div>\\r\\n<div>\\r\\n<p><strong>Brahms</strong>&nbsp;Symphony No. 4 in E minor&nbsp;<em>46&rsquo;</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</div>\\r\\n<div>\\r\\n<p><strong>Martha Argerich&nbsp;</strong><em>piano</em><br /><strong>Munich Philharmonic</strong><br /><strong>Lahav Shani</strong>&nbsp;<em>conductor</em></p>\\r\\n</div>\\r\\n</div>\\r\\n</section>\",\"Inactive\":false}]}]},{\"ID\":2237,\"ProductionSeasonNumber\":99690,\"PerformanceNumber\":102899,\"WishlistNumber\":null,\"StartDate\":\"2026-11-08T11:00:00Z\",\"EndDate\":\"2026-11-08T11:00:00Z\",\"Prefix\":\"Royal Albert Hall presents\",\"Title\":\"Classical Coffee Mornings: Emme Hensel\",\"Suffix\":null,\"ListingIndicator\":null,\"Summary\":\"Join Emme Hensel for a Classical Coffee Morning in the Elgar Room, complete with a hot drink and a pastry.\",\"Image\":{\"w300\":\"https://d117kfg112vbe4.clo