          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014884\",\"name\":\"I, Nobody (Malayalam)\",\"originalName\":\"I, Nobody (Malayalam)\",\"length\":166,\"posterLink\":\"https://regalcdn.azureedge.net/CW/INobodyMalayalam/HO00014884/TV_SmallPosterImage/20260707-122029607.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/INobodyMalayalam/HO00014884/TV_LargePosterImage/20260707-122029607.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/i-nobody-malayalam/ho00014884\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Prithviraj Sukumaran, Suraj Venjaramoodu, Vinay Forrt, Parvathy Thiruvothu\",\"directors\":\"Nissam Basheer\",\"synopsis\":\"The film follows Rajeevan (Prithviraj Sukumaran), an ordinary government employee, husband, and father of two. His seemingly quiet life spirals completely out of control when he inadvertently witnesses a major crime and is accused of executing a massive bank heist. Branded a troublemaker with a shady past, he is forced to go on the run, fighting to protect his family against forces far beyond his control.\",\"dateStarted\":\"2026-07-09T00:00:00\",\"eventCount\":148,\"categoriesAttributes\":[\"action\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"laser\",\"malayalam\",\"reserved-selected\",\"subbed\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/15.png\",\"ageRestrictionName\":\"15\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/INobodyMalayalam/HO00014884/TV_TopShelfPosterImage/20260707-122029607.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.