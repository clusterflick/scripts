            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014914\",\"name\":\"£2 Family Films : The Pirates! In An Adventure\",\"originalName\":\"£2 Family Films : The Pirates! In An Adventure\",\"length\":88,\"posterLink\":\"/xmedia/img/10108/film.placeholder.poster.jpg\",\"posterLinkLarge\":\"/xmedia/img/10108/film.placeholder.poster.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/2-family-films-the-pirates-in-an-adventure/ho00014914\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Martin Freeman, Brendan Gleeson, Hugh Grant, Salma Hayek, Lenny Henry, Ashley Jensen, Jeremy Piven, Imelda Staunton, David Tennant, Russell Tovey, Anton Yelchin, BRIAN BLESSED\",\"directors\":\"Peter Lord, Jeff Newitt\",\"synopsis\":\"A group of pirates journey to London and meet Charles Darwin, a talking chimp named Mister Bobo and an enemy looking to wipe them out. Based on \\\"The Pirates! (In an Adventure With Scientists),\\\" the best-selling books by Gideon Defoe. Aardman film in stop motion animation.\",\"dateStarted\":\"2026-08-14T00:00:00\",\"eventCount\":504,\"categoriesAttributes\":[\"action\",\"animation\",\"movies-for-juniors\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"audio-described\",\"classicfilm\",\"laser\",\"movies-for-juniors\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/U.png\",\"ageRestrictionName\":\"u\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[],\"specialMessage\":null,\"distributorName\":\"PARK CIRCUS FILMS\"}}}",
