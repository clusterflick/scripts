            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014892\",\"name\":\"Dastaar (Punjabi)\",\"originalName\":\"Dastaar (Punjabi)\",\"length\":150,\"posterLink\":\"/xmedia/img/10108/film.placeholder.poster.jpg\",\"posterLinkLarge\":\"/xmedia/img/10108/film.placeholder.poster.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/dastaar-punjabi/ho00014892\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Ashish Duggal, Tarsem Jassar, Yograj Singh, Geet Goraya, Neeta Mohindra\",\"directors\":\"Amar Hundal\",\"synopsis\":\"In 2000s Britain, a turbaned Sikh immigrant loses his close ones to a brutal attack but transforms his grief into courage, rising from a humble immigrant to a community leader, proving that one man’s turban can become the crown of a community.\",\"dateStarted\":\"2026-07-16T00:00:00\",\"eventCount\":23,\"categoriesAttributes\":[\"drama\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"laser\",\"punjabi\",\"reserved-selected\",\"subbed\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/15.png\",\"ageRestrictionName\":\"15\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[],\"specialMessage\":null,\"distributorName\":\"WHITE HILL STUDIOS\"}}}",
