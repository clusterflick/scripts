            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014897\",\"name\":\"£2 Family Films: Wallace & Gromit Grand Day/Wrong\",\"originalName\":\"£2 Family Films: Wallace & Gromit Grand Day/Wrong\",\"length\":56,\"posterLink\":\"https://regalcdn.azureedge.net/CW/WallaceGromitAGrandDayOutWrongTrousers/HO00014897/TV_SmallPosterImage/20260707-121445293.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/WallaceGromitAGrandDayOutWrongTrousers/HO00014897/TV_LargePosterImage/20260707-121445293.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/2-family-films-wallace-gromit-grand-daywrong/ho00014897\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Peter Sallis\",\"directors\":\"Nick Park\",\"synopsis\":\"To replenish their depleted supply of cheese, inventor Wallace and his dog Gromit travel to the moon in a homemade rocket-ship.\\n\\nGromit butts heads with a mysterious penguin lodger, who hatches a sinister scheme involving the ex-NASA Techno Trousers that have been modified by Wallace for walkies.\",\"dateStarted\":\"2026-07-10T00:00:00\",\"eventCount\":210,\"categoriesAttributes\":[\"action\",\"animation\",\"movies-for-juniors\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"audio-described\",\"laser\",\"movies-for-juniors\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/U.png\",\"ageRestrictionName\":\"u\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/WallaceGromitAGrandDayOutWrongTrousers/HO00014897/TV_TopShelfPosterImage/20260707-121445293.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\