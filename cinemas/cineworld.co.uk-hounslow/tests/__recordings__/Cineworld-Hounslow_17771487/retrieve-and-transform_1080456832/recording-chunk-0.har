          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014809\",\"name\":\"National Theatre Live: The Misanthrope\",\"originalName\":\"National Theatre Live: The Misanthrope\",\"length\":150,\"posterLink\":\"https://regalcdn.azureedge.net/CW/NationalTheatreLiveTheMisanthrope/HO00014809/TV_SmallPosterImage/20260609-045526965.jpg\",\"posterLinkLarge\":\"https://regalcdn.azureedge.net/CW/NationalTheatreLiveTheMisanthrope/HO00014809/TV_LargePosterImage/20260609-045500810.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/national-theatre-live-the-misanthrope/ho00014809\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Tom Mison, Sandra Oh, Paul Chahidi, Abigail Cruttenden\",\"directors\":\"\",\"synopsis\":\"Award-winner Sandra Oh (Killing Eve) plays the title role in this razor-sharp reimagining of Molière’s classic dark comedy. Telling the truth isn’t always that simple. Alice, a brilliant novelist, despises the carefully constructed lies of modern society. But the more she challenges those around her, the fiercer the backlash becomes. Soon, she must confront the price of speaking her truth in a world that would rather silence her. Filmed live on stage at the National Theatre, Indhu Rubasingham directs Martin Crimp’s (Cyrano de Bergerac) highly anticipated play.\",\"dateStarted\":\"2026-09-22T00:00:00\",\"eventCount\":237,\"categoriesAttributes\":[],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"alternative-content\",\"laser\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/15.png\",\"ageRestrictionName\":\"15\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[{\"type\":\"Image\",\"subType\":\"Mobile_MovieFeed\",\"url\":\"https://regalcdn.azureedge.net/CW/NationalTheatreLiveTheMisanthrope/HO00014809/Mobile_MovieFeed/20260609-045442039.jpg\",\"dimensionHeight\":\"400\",\"dimensionWidth\":\"640\"},{\"type\":\"Image\",\"subType\":\"TV_TopShelfPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/NationalTheatreLiveTheMisanthrope/HO00014809/TV_TopShelfPosterImage/20260609-045500810.jpg\",\"dimensionHeight\":\"608\",\"dimensionWidth\":\"404\"},{\"type\":\"Image\",\"subType\":\"TV_SmallPosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/NationalTheatreLiveTheMisanthrope/HO00014809/TV_SmallPosterImage/20260609-045526965.jpg\",\"dimensionHeight\":\"376\",\"dimensionWidth\":\"250\"},{\"type\":\"Image\",\"subType\":\"Mobile_MovieThumbnail\",\"url\":\"https://regalcdn.azureedge.net/CW/NationalTheatreLiveTheMisanthrope/HO00014809/Mobile_MovieThumbnail/20260609-045500810.jpg\",\"dimensionHeight\":\"232\",\"dimensionWidth\":\"156\"},{\"type\":\"Image\",\"subType\":\"TV_LargePosterImage\",\"url\":\"https://regalcdn.azureedge.net/CW/NationalTheatreLiveTheMisanthrope/HO00014809/TV_LargePosterImage/20260609-045500810.jpg\",\"dimensionHeight\":\"960\",\"dimensionWidth\":\"638\"}],\"specialMessage\":null,\"distributorName\":\"NATIONAL THEATRE\"}}}",
