          "content": {
            "mimeType": "application/json;charset=utf-8",
            "text": "{\"body\":{\"filmDetails\":{\"id\":\"ho00014917\",\"name\":\"£2 Family Films : Shaun The Sheep: Farmageddon\",\"originalName\":\"£2 Family Films : Shaun The Sheep: Farmageddon\",\"length\":87,\"posterLink\":\"/xmedia/img/10108/film.placeholder.poster.jpg\",\"posterLinkLarge\":\"/xmedia/img/10108/film.placeholder.poster.jpg\",\"videoLink\":null,\"link\":\"https://www.cineworld.co.uk/films/2-family-films-shaun-the-sheep-farmageddon/ho00014917\",\"weight\":0,\"releaseYear\":\"2026\",\"releaseCountry\":null,\"cast\":\"Justin Fletcher, Kate Harbour, John Sparkes\",\"directors\":\"Will Becher, Richard Phelan\",\"synopsis\":\"Strange lights over the quiet town of Mossingham herald the arrival of a mystery visitor from far across the galaxy… When the intergalactic visitor – an impish and adorable alien called LU-LA – crash-lands near Mossy Bottom Farm, Shaun soon sees an opportunity for alien-powered fun and adventure and sets off on a mission to shepherd LU-LA home. Her magical alien powers, irrepressible mischief and galactic sized burps soon have the flock enchanted. Shaun takes his new extra-terrestrial friend on the road to Mossingham Forest to find her lost spaceship, unaware that a sinister alien-hunting agency is on their trail. Can Shaun and the flock avert Farmageddon on Mossy Bottom Farm before it’s too late?\",\"dateStarted\":\"2026-09-04T00:00:00\",\"eventCount\":186,\"categoriesAttributes\":[\"animation\",\"movies-for-juniors\"],\"categoryIds\":null,\"screeningAttributes\":[\"2d\",\"audio-described\",\"classicfilm\",\"laser\",\"movies-for-juniors\",\"recliner\",\"reserved-selected\"],\"ageRestrictionId\":null,\"ageRestrictionLink\":\"https://www.cineworld.co.uk/xmedia/img/10108/rating/U.png\",\"ageRestrictionName\":\"u\",\"ageRestrictionDescription\":null,\"showingType\":\"SHOWING\",\"dubbedLanguage\":[],\"firstSubbedLanguage\":[],\"secondSubbedLanguage\":[],\"originalLanguage\":[],\"contentLabels\":[],\"mediaList\":[],\"specialMessage\":null,\"distributorName\":\"PARK CIRCUS FILMS\"}}}",
