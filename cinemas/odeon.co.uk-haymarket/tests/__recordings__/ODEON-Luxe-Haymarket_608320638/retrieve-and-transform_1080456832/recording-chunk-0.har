            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-03-02\",\"showtimes\":[{\"id\":\"158-27799\",\"schedule\":{\"businessDate\":\"2026-03-02\",\"startsAt\":\"2026-03-02T19:00:00+00:00\",\"endsAt\":\"2026-03-02T20:54:00+00:00\",\"filmStartsAt\":\"2026-03-02T19:25:00+00:00\",\"filmEndsAt\":\"2026-03-02T20:54:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"158-1-24\",\"filmId\":\"HO00008444\",\"siteId\":\"158\",\"screenId\":\"158-1\",\"areaCategories\":[{\"areaCategoryId\":\"158-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"158-0000000013\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000143\",\"0000000083\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"158\",\"name\":{\"text\":\"London Haymarket\",\"translations\":[]},\"location\":{\"latitude\":51.5095,\"longitude\":-0.1312},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"11/18 Panton Street\",\"line2\":\"\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008444\",\"title\":{\"text\":\"ODEON Pride Nights - Fine Young Men\",\"translations\":[]},\"synopsis\":{\"text\":\"Alf is a privileged teenager who returns to study at his Catholic school after being away for a year. He no longer identifies with his usual friends, the athletes and popular kids, but begins to feel attracted to Oliver, a new student who is completely different from the rest of the boys. When Alf tries to kiss Oliver and he rejects him, he feels uncomfortable and distances himself from his new friend. Alf will try to silence any rumors about his orientation by allying with his old friends. Together, in their excesses and arrogance, they will end up becoming criminals.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When Alf returns to school after a year away, he bonds with new student Oliver. Their relationship becomes deeply damaged as Alf becomes embroiled in a life of crime.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-03-02\",\"runtimeInMinutes\":89,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000017849\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017850\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017851\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017852\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017853\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017854\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017855\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017856\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017857\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017858\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017859\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000020\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"fd967b73-af62-48d7-9a41-217eb1bb0ed1\",\"corporateId\":null},\"hopk\":\"HO00008444\",\"hoCode\":\"A000009550\",\"eventId\":null,\"distributorName\":\"(New) Cinemien\"}],\"castAndCrew\":[{\"id\":\"0000017849\",\"name\":{\"givenName\":\"Andres\",\"familyName\":\"Revo\",\"middleName\":null}},{\"id\":\"0000017850\",\"name\":{\"givenName\":\"María\",\"familyName\":\"Aura\",\"middleName\":null}},{\"id\":\"0000017851\",\"name\":{\"givenName\":\"Tomás\",\"familyName\":\"Rojas\",\"middleName\":null}},{\"id\":\"0000017852\",\"name\":{\"givenName\":\"Emilio\",\"familyName\":\"Puente\",\"middleName\":null}},{\"id\":\"0000017853\",\"name\":{\"givenName\":\"Moisés\",\"familyName\":\"Arizmendi\",\"middleName\":null}},{\"id\":\"0000017854\",\"name\":{\"givenName\":\"Concepción\",\"familyName\":\"Márquez\",\"middleName\":null}},{\"id\":\"0000017855\",\"name\":{\"givenName\":\"Héctor\",\"family