            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-05-11\",\"showtimes\":[{\"id\":\"158-27800\",\"schedule\":{\"businessDate\":\"2026-05-11\",\"startsAt\":\"2026-05-11T19:00:00+01:00\",\"endsAt\":\"2026-05-11T21:06:00+01:00\",\"filmStartsAt\":\"2026-05-11T19:25:00+01:00\",\"filmEndsAt\":\"2026-05-11T21:06:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"158-1-24\",\"filmId\":\"HO00008442\",\"siteId\":\"158\",\"screenId\":\"158-1\",\"areaCategories\":[{\"areaCategoryId\":\"158-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"158-0000000013\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"158\",\"name\":{\"text\":\"London Haymarket\",\"translations\":[]},\"location\":{\"latitude\":51.5095,\"longitude\":-0.1312},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"11/18 Panton Street\",\"line2\":\"\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008442\",\"title\":{\"text\":\"ODEON Pride Nights - High Tide\",\"translations\":[]},\"synopsis\":{\"text\":\"Heartbroken and adrift, undocumented Brazilian immigrant Lourenço searches for purpose in the queer mecca of Provincetown. As the summer season comes to a fade, he sparks an intense and unexpected romance with Maurice. Together, the two reconcile the pasts they've left behind and their uncertain futures.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Heartbroken and adrift, undocumented Brazilian immigrant Lourenço searches for purpose in the queer mecca of Provincetown. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-05-11\",\"runtimeInMinutes\":101,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001578\",\"rol