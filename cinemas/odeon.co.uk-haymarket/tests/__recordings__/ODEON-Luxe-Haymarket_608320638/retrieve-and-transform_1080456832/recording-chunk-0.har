            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-07-11\",\"showtimes\":[{\"id\":\"158-30480\",\"schedule\":{\"businessDate\":\"2026-07-11\",\"startsAt\":\"2026-07-11T20:15:00+01:00\",\"endsAt\":\"2026-07-11T22:38:00+01:00\",\"filmStartsAt\":\"2026-07-11T20:40:00+01:00\",\"filmEndsAt\":\"2026-07-11T22:38:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"158-3-30\",\"filmId\":\"HO00009089\",\"siteId\":\"158\",\"screenId\":\"158-3\",\"areaCategories\":[{\"areaCategoryId\":\"158-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"158-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"158-0000000021\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000048\",\"0000000071\",\"0000000143\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"158-30477\",\"schedule\":{\"businessDate\":\"2026-07-11\",\"startsAt\":\"2026-07-11T20:30:00+01:00\",\"endsAt\":\"2026-07-11T22:41:00+01:00\",\"filmStartsAt\":\"2026-07-11T20:55:00+01:00\",\"filmEndsAt\":\"2026-07-11T22:41:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"158-1-28\",\"filmId\":\"HO00009072\",\"siteId\":\"158\",\"screenId\":\"158-1\",\"areaCategories\":[{\"areaCategoryId\":\"158-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"158-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"158-0000000021\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"158-30490\",\"schedule\":{\"businessDate\":\"2026-07-11\",\"startsAt\":\"2026-07-11T20:50:00+01:00\",\"endsAt\":\"2026-07-11T23:04:00+01:00\",\"filmStartsAt\":\"2026-07-11T21:15:00+01:00\",\"filmEndsAt\":\"2026-07-11T23:04:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"158-2-29\",\"filmId\":\"HO00008964\",\"siteId\":\"158\",\"screenId\":\"158-2\",\"areaCategories\":[{\"areaCategoryId\":\"158-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"158-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"158-0000000021\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000187\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"158-30489\",\"schedule\":{\"businessDate\":\"2026-07-11\",\"startsAt\":\"2026-07-11T21:00:00+01:00\",\"endsAt\":\"2026-07-11T23:14:00+01:00\",\"filmStartsAt\":\"2026-07-11T21:25:00+01:00\",\"filmEndsAt\":\"2026-07-11T23:14:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"158-4-31\",\"filmId\":\"HO00008744\",\"siteId\":\"158\",\"screenId\":\"158-4\",\"areaCategories\":[{\"areaCategoryId\":\"158-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"158-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"158-0000000021\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000143\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"158\",\"name\":{\"text\":\"London Haymarket\",\"translations\":[]},\"location\":{\"latitude\":51.5095,\"longitude\":-0.1312},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"11/18 Panton Street\",\"line2\":\"\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008744\",\"title\":{\"text\":\"Obsession\",\"translations\":[]},\"synopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for but soon discovers that some desires come at a dark, sinister price.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong violence, gore\",\"translations\":[]},\"releaseDate\":\"2026-05-15\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=fWLaCC8L6Jo\",\"displayPriority\":10,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002047\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006579\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018515\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018516\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018517\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018518\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018519\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018520\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000018521\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a6a25d26-497a-4daa-a5ff-b5fc9719faca\",\"corporateId\":null},\"hopk\":\"HO00008744\",\"hoCode\":\"A000009874\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008964\",\"title\":{\"text\":\"Evil Dead Burn\",\"translations\":[]},\"synopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. After the loss of her husband, a woman seeks solace with her in-laws in their secluded family home. As one by one they are transformed into Deadites—turning the gathering into a family reunion from hell—she comes to discover that the vows she took in life... live on even in death.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. \",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong bloody violence, gore\",\"translations\":[]},\"releaseDate\":\"2026-07-09\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=YYkUkyfjUKg\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000008177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009258\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019021\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019022\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019023\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019024\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000303\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"3c50ff95-67b2-4152-9965-ad2431794116\",\"corporateId\":null},\"hopk\":\"HO00008964\",\"hoCode\":\"A000010114\",\"eventId\":null,\"distributorName\":\"STUDIOCANAL\"},{\"id\":\"HO00009072\",\"title\":{\"text\":\"The Invite\",\"translations\":[]},\"synopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \\nHave they reignited the spark or lit the match that burns it all down?\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"very strong language, strong sex references, drug misuse\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":106,\"trailerUrl\":\"https://www.youtube.com/watch?v=7YIHRhRMn94\",\"displayPriority\":8,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000785\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004368\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019329\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019330\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000241\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001028\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001154\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"HO00002297\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a87bd21e-c69e-4d0b-b7d0-18dabf2eeb9f\",\"corporateId\":null},\"hopk\":\"HO00009072\",\"hoCode\":\"A000010230\",\"eventId\":null,\"distributorName\":\"Black Bear Pictures\"},{\"id\":\"HO00009089\",\"title\":{\"text\":\"Dear You (Teochew with CH/EN subtitles)\",\"translations\":[]},\"synopsis\":{\"text\":\"For years, Grandma Shurou from Chaoshan lived on the letters and remittances from her husband who left for Nanyang to survive the war and never returned. When her debt-ridden grandson Xiaowei secretly travels to Thailand to find his rumoured “millionaire” grandpa, he returns with shocking news: his grandpa is long gone, and the person Grandma had exchanged letters with for years was a stranger. As Xiaowei digs deeper, a long-buried misunderstanding spanning three generations begins to unravel, revealing a truth that binds two families across borders and time.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"For years, Grandma Shurou from Chaoshan lived on the letters and remittances from her husband who left for Nanyang to survive the war and never returned.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, violence\",\"translations\":[]},\"releaseDate\":\"2026-06-26\",\"runtimeInMinutes\":118,\"trailerUrl\":\"https://www.youtube.com/watch?v=qIjOCYltUqA\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000019352\",\"roles\":[\"Actor\"]},{\"castAndCrewMe