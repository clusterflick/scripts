:11:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"158-4-27\",\"filmId\":\"HO00008195\",\"siteId\":\"158\",\"screenId\":\"158-4\",\"areaCategories\":[{\"areaCategoryId\":\"158-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"158-0000000013\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000143\",\"0000000022\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"158-27864\",\"schedule\":{\"businessDate\":\"2026-02-02\",\"startsAt\":\"2026-02-02T21:00:00+00:00\",\"endsAt\":\"2026-02-02T23:14:00+00:00\",\"filmStartsAt\":\"2026-02-02T21:25:00+00:00\",\"filmEndsAt\":\"2026-02-02T23:14:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"158-3-30\",\"filmId\":\"HO00008189\",\"siteId\":\"158\",\"screenId\":\"158-3\",\"areaCategories\":[{\"areaCategoryId\":\"158-0000000001\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"158-0000000013\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"158-0000000021\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000143\",\"0000000022\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"158\",\"name\":{\"text\":\"London Haymarket\",\"translations\":[]},\"location\":{\"latitude\":51.5095,\"longitude\":-0.1312},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"11/18 Panton Street\",\"line2\":\"\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008012\",\"title\":{\"text\":\"The Housemaid\",\"translations\":[]},\"synopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous — a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, sex, sexual violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-12-22\",\"runtimeInMinutes\":131,\"trailerUrl\":\"https://www.youtube.com/watch?v=kdDdlY2VPxw\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000009161\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012707\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016976\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000016977\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000031\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000135\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000814\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001305\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dc7be94d-5ba5-4a79-accd-48ed4d19a3b6\",\"corporateId\":null},\"hopk\":\"HO00008012\",\"hoCode\":\"A000009092\",\"eventId\":null,\"distributorName\":\"LIONSGATE INTERNATIONAL\"},{\"id\":\"HO00008101\",\"title\":{\"text\":\"Marty Supreme\",\"translations\":[]},\"synopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Marty Mauser, a young man with a dream no one respects, goes to hell and back in pursuit of greatness.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, sex, nudity, injury detail, violence\",\"translations\":[]},\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":150,\"trailerUrl\":\"https://www.youtube.com/watch?v=s9gSuKaKcqM\",\"displayPriority\":7,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001370\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012950\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014188\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014753\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017170\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000017171\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"17172\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17173\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17174\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"2227\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000258\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"90e71dd1-a916-4807-8aff-0dd9f141e72d\",\"corporateId\":null},\"hopk\":\"HO00008101\",\"hoCode\":\"A000009187\",\"eventId\":null,\"distributorName\":\"ENTERTAINMENT FILM DISTRIBUTOR\"},{\"id\":\"HO00008189\",\"title\":{\"text\":\"28 Years Later: The Bone Temple\",\"translations\":[]},\"synopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later: The Bone Temple. In a continuation of the epic story, Dr. Kelson (Ralph Fiennes) finds himself in a shocking new relationship - with consequences that could change the world as they know it - and Spike's (Alfie Williams) encounter with Jimmy Crystal (Jack O'Connell) becomes a nightmare he can't escape. In the world of The Bone Temple, the infected are no longer the greatest threat to survival - the inhumanity of the survivors can be stranger and more terrifying.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Expanding upon the world created by Danny Boyle and Alex Garland in 28 Years Later - but turning that world on its head - Nia DaCosta directs 28 Years Later.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong gory violence, injury detail, very strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-14\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=wyYliP8dPWU\",\"displayPriority\":9,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000097\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000442\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002404\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002653\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005575\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014011\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014577\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017355\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017356\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000576\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"12790418-6492-492a-814c-53673bc1ab1a\",\"corporateId\":null},\"hopk\":\"HO00008189\",\"hoCode\":\"A000009281\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008195\",\"title\":{\"text\":\"Is This Thing On?\",\"translations\":[]},\"synopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family — forcing them to navigate co-parenting, identity, and whether love can take a new form.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":121,\"trailerUrl\":\"https://www.youtube.com/watch?v=ngmu5zGOa7s\",\"displayPriority\":11,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000027\",\"roles\":[\"Actor\",\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000883\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000002332\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004642\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017365\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017366\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017367\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"30\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000009\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c59e6ef3-faa4-469e-9fc7-2d8997cff25e\",\"corporateId\":null},\"hopk\":\"HO00008195\",\"hoCode\":\"A000009287\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008306\",\"title\":{\"text\":\"Back To The Past (Cantonese)\",\"translations\":[]},\"synopsis\":{\"text\":\"In the Qin Dynasty, time-traveller Hong Siu-lung (Louis Koo) has lived in seclusion with his family for twenty years. Yet every step he takes remains under the watchful eye of his former disciple, now the Qin Emperor (Raymond Lam). On the brink of ultimate power after conquering the six warring states, the emperor is suddenly ambushed by a mysterious team wielding advanced weapons clearly originating from Hong’s time. Drawn together by fate again, Hong and Qin Emperor are forced to confront the long-buried conflict between them, because the future now depends on how they settle their past.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In the Qin Dynasty, time-traveller Hong Siu-lung (Louis Koo) has lived in seclusion with his family for twenty years. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-31\",\"runtimeInMinutes\":107,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000009552\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000012294\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017570\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017571\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017572\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017573\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017574\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000001\",\"0000000006\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"3ac35814-325d-4762-a793-507b4ad988bd\",\"corporateId\":null},\"hopk\":\"HO00008306\",\"hoCode\":\"A000009402\",\"eventId\":null,\"distributorName\":\"Trinity Filmed Entertainment\"},{\"id\":\"HO00008327\",\"title\":{\"text\":\"No Other Choice\",\"translations\":[]},\"synopsis\":{\"text\":\"Man-su (Lee Byung Hun), a specialist in paper manufacturing with 25 years of experience, is so satisfied with life that he can truthfully tell himself, “I’ve got it all.” While happily passing his days with his wife Miri (Son Yejin), their two children and two dogs, Man-su is suddenly informed by his company that he has been fired.\\n“We’re sorry. We have no other choice.”\\nFeeling shocked as if his head had been cut off by an ax, Man-su vows to find himself a new job within the next three months for the sake of his family. Despite his firm resolve to turn his life around, Man-su spends over a year drifting from one job interview after another, and working at a retail store. He eventually finds himself in danger of losing the very house that he struggled so hard to buy.\\nDesperate, he visits Moon Paper out of the blue and tries to hand over his CV, but he just ends up getting humiliated by line manager Choi Sun-chul (Park Hee Soon). Man-su knows he is better qualified than anyone to work at Moon Paper, so he comes to a certain decision.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, violence, injury detail, sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":139,\"trailerUrl\":null,\"displayPriority\":13,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000010701\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016863\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017619\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017620\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017621\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017622\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000009\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e660de4a-88af-472a-a1e1-57ffb9dcbb49\",\"corporateId\":null},\"hopk\":\"HO00008327\",\"hoCode\":\"A000009425\",\"eventId\":null,\"distributorName\":\"MUBI UK Ltd\"},{\"id\":\"HO00008348\",\"title\":{\"text\":\"Another World (Cantonese)\",\"translations\":[]},\"synopsis\":{\"text\":\"After death and before reincarnation, the souls of the deceased pass through a fantastical realm known as, Another World. GUDO is a spirit tasked with guiding these transient souls to their next life. \\nWhile helping a young girl named YURI, he learns that humans have emotions that he does not understand, and his curiosity is stirred. He befriends Yuri and promises to always be with her through her difficult journey. \\nHowever, Yuri harbors a rare curse that could threaten humanity and upset the balance of the universe if she is fully consumed by anger. Through Gudo’s revelation, Yuri discovers a grave sin she committed in her past life. Unable to forgive herself, her growing anger risks unleashing the hidden curse. Charged by Goddess Mira to prevent this threat, Gudo embarks on a perilous thousand-year mission. \\nDespite constant conflicts with his guardian, Dark Sky, Gudo insists on giving Yuri a second chance at the risk of his life. He learns that forgiveness and inner peace is the only way to overcome the anger within and heal a broken world. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Tasked to help transient souls through Another World to their reincarnation, the spirit GUDO meets a young girl called YURI, and embarks on a dangerous journey.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, suicide\",\"translations\":[]},\"releaseDate\":\"2026-01-29\",\"runtimeInMinutes\":111,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007432\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010662\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011602\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017652\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017653\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017654\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017655\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"17714\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000011\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"3dceaa5a-a39d-4c4c-96fc-f1219e6c2820\",\"corporateId\":null},\"hopk\":\"HO00008348\",\"hoCode\":\"A000009446\",\"eventId\":null,\"distributorName\":\"Central City Media LTD\"},{\"id\":\"HO00008443\",\"title\":{\"text\":\"ODEON Pride Nights - What A Feeling\",\"translations\":[]},\"synopsis\":{\"text\":\"The successful doctor Marie Theres (Caroline Peters) had imagined her wedding anniversary rather differently. Admittedly, inviting friends to a candlelit dinner as a surprise may not have been her brightest idea. But did it really have to end in separation, as her husband Alexander (Heikko Deutschmann) announces that evening? Yes, it did. Because it is not only the night he wants to change, but his entire future: more happiness and freedom, and less Marie Theres.\\n\\nIn the wake of this thoroughly unpleasant turn of events, Marie Theres does what any sensible woman might do. She reaches for a drink. One last nightcap leads her into Bigi’s (Barbara Spitz) bar, a place frequented mainly by women who love women. And that is where she meets Fa (Proschat Madani).\\n\\nFa may not be a doctor like Marie Theres, but she does make house calls of her own, preferably to women hungry for love. She is exuberant, spontaneous and unattached, living her love life openly and without inhibition. Although the impeccably proper doctor is clearly not Fa’s usual type, she still takes Marie Theres home after the boozy night.\\n\\nUnfortunately, Marie Theres is far too drunk to remember what happened. Did we, or didn’t we? And are we even allowed to? In theory, yes. In practice, nothing is quite that simple. Because nothing about Marie Theres and Fa is straightforward.\\n\\nFor Marie Theres, it is complicated because she has no idea how her already strained relationship with her teenage daughter Anna (Allegra Tinnefeld) might cope with a new, and completely different, kind of partnership. And because she risks being ostracised by her comfortably bourgeois circle of friends.\\n\\nFor Fa, it is no easier. Her Persian background comes with a similarly conservative set of family values, not least a loving but strict mother. And, inconveniently, both women soon realise that what connects them is more than just a fleeting adventure between the sheets.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Love between cultures and conventions: nothing about Marie Theres and Fa is straight. A warm-hearted, witty romantic comedy about two women in midlife.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-02\",\"runtimeInMinutes\":110,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000012858\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017838\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017839\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017840\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017841\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017842\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017843\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017844\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017845\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017846\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017847\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017848\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"62019a75-af85-4510-bf0b-e100b2779a67\",\"corporateId\":null},\"hopk\":\"HO00008443\",\"hoCode\":\"A000009549\",\"eventId\":null,\"distributorName\":\"(New) Cinemien\"}],\"castAndCrew\":[{\"id\":\"0000009161\",\"name\":{\"givenName\":\"Sydney\",\"familyName\":\"Sweeney\",\"middleName\":null}},{\"id\":\"0000012707\",\"name\":{\"givenName\":\"Brandon\",\"familyName\":\"Sklenar\",\"middleName\":null}},{\"id\":\"0000016976\",\"name\":{\"givenName\":\"Laura\",\"familyName\":\"Fischer\",\"middleName\":null}},{\"id\":\"0000016977\",\"name\":{\"givenName\":\"Carly\",\"familyName\":\"Kleinbart\",\"middleName\":null}},{\"id\":\"HO00000031\",\"name\":{\"givenName\":\"Paul\",\"familyName\":\"Feig\",\"middleName\":null}},{\"id