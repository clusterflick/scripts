":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"858-40024\",\"schedule\":{\"businessDate\":\"2026-01-31\",\"startsAt\":\"2026-01-31T21:00:00+00:00\",\"endsAt\":\"2026-01-31T22:54:00+00:00\",\"filmStartsAt\":\"2026-01-31T21:25:00+00:00\",\"filmEndsAt\":\"2026-01-31T22:54:00+00:00\",\"inSeatItemDelivery\":{\"startsAt\":\"2026-01-31T21:00:00+00:00\",\"endsAt\":\"2026-01-31T21:30:00+00:00\"}},\"isSoldOut\":false,\"seatLayoutId\":\"858-2-43\",\"filmId\":\"HO00008273\",\"siteId\":\"858\",\"screenId\":\"858-2\",\"areaCategories\":[{\"areaCategoryId\":\"858-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"858\",\"name\":{\"text\":\"Islington\",\"translations\":[]},\"location\":{\"latitude\":51.5385,\"longitude\":-0.1026},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"13 Esther Anne Place\",\"line2\":\"Islington\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007533\",\"title\":{\"text\":\"Avatar: Fire and Ash\",\"translations\":[]},\"synopsis\":{\"text\":\"Jake and Neytiri's family grapples with grief after Neteyam's death, encountering a new, aggressive Na'vi tribe, the Ash People, who are led by the fiery Varang, as the conflict on Pandora escalates and a new moral focus emerges.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Jake and Neytiri's family grapples with grief after Neteyam's death, encountering a new, aggressive Na'vi tribe, the Ash People, who are led by the fiery Varang.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-19\",\"runtimeInMinutes\":197,\"trailerUrl\":null,\"displayPriority\":8,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000560\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002207\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002294\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005786\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005787\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007837\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17711\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17712\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"17713\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000042\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000349\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000696\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002427\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000010\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a4cb369f-77c4-4fe1-8f85-dd5e76b195dd\",\"corporateId\":null},\"hopk\":\"HO00007533\",\"hoCode\":\"A000008563\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008012\",\"title\":{\"text\":\"The Housemaid\",\"translations\":[]},\"synopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous — a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. \",\"translations\":[]},\"censorRatingId\