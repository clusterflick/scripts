            "text": "{\"businessDate\":\"2026-05-28\",\"showtimes\":[{\"id\":\"858-38962\",\"schedule\":{\"businessDate\":\"2026-05-28\",\"startsAt\":\"2026-05-28T19:00:00+01:00\",\"endsAt\":\"2026-05-28T21:55:00+01:00\",\"filmStartsAt\":\"2026-05-28T19:25:00+01:00\",\"filmEndsAt\":\"2026-05-28T21:55:00+01:00\",\"inSeatItemDelivery\":{\"startsAt\":\"2026-05-28T19:00:00+01:00\",\"endsAt\":\"2026-05-28T21:10:00+01:00\"}},\"isSoldOut\":false,\"seatLayoutId\":\"858-5-49\",\"filmId\":\"HO00008185\",\"siteId\":\"858\",\"screenId\":\"858-5\",\"areaCategories\":[{\"areaCategoryId\":\"858-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"858\",\"name\":{\"text\":\"Islington\",\"translations\":[]},\"location\":{\"latitude\":51.5385,\"longitude\":-0.1026},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"13 Esther Anne Place\",\"line2\":\"Islington\",\"city\":\"London\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008185\",\"title\":{\"text\":\"NT Live: The Playboy of the Western World\",\"translations\":[]},\"synopsis\":{\"text\":\"Nicola Coughlan (Bridgerton) joins Éanna Hardwicke (The Sixth Commandment) and Siobhán McSweeney (Derry Girls) in John Millington Synge’s riveting play of youth and self-discovery. Pegeen Flaherty’s life is turned upside down when a young man walks into her pub claiming that he’s killed his father. Instead of being shunned, the killer becomes a local hero and begins to win hearts, that is until a second man unexpectedly arrives on the scene… Filmed live on stage at the National Theatre, Caitríona McLaughlin directs this darkly funny tale full to the brim with secrets.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Nicola Coughlan joins Éanna Hardwicke and Siobhán McSweeney in