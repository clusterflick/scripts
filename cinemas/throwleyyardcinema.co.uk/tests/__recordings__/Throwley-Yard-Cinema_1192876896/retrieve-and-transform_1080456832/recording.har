\":\"407718\",\"dcmEdiMovieName\":\"Andre Rieu's Christmas Concert: Gold And Silver (Concert) (2D) [U]\",\"siteId\":\"124\",\"titleClassId\":\"75\",\"showings\":[{\"id\":\"275533\",\"time\":\"2025-03-05T11:00:00Z\",\"ticketsSold\":20,\"screenId\":\"236\",\"seatsRemaining\":49,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating accessible silver-screening sc1\\\"}\"}]},{\"id\":\"22196\",\"name\":\"LD Friendly Mufasa: The Lion King\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"ld-friendly-mufasa-the-lion-king\",\"posterImage\":\"0qr1g8bksvrmlqthiq6wm1gsljiq\",\"bannerImage\":\"qwsn4dq9xufmx9goz6te1v49crye\",\"synopsis\":\"“Mufasa: The Lion King” enlists Rafiki to relay the legend of Mufasa to young lion cub Kiara, daughter of Simba and Nala, with Timon and Pumbaa lending their signature schtick. Told in flashbacks, the story introduces Mufasa as an orphaned cub, lost and alone until he meets a sympathetic lion named Taka—the heir to a royal bloodline. The chance meeting sets in motion an expansive journey of an extraordinary group of misfits searching for their destiny—their bonds will be tested as they work together to evade a threatening and deadly foe.  \",\"starring\":\"Aaron Pierre, Kelvin Harrison, Jr., Tiffany Boone, John Kani, Mads Mikkelsen, Seth Rogen\",\"directedBy\":\"Barry Jenkins\",\"producedBy\":\"Adele Romanski, Mark Ceryak\",\"searchTerms\":\"\",\"duration\":118,\"genre\":\"Adventure\",\"allGenres\":\"Adventure, Animation, Family\",\"rating\":\"PG\",\"trailerYoutubeId\":\"do0c3iLWdE8\",\"trailerVideo\":null,\"releaseDate\":\"2024-12-20\",\"dateOfFirstShowing\":\"2025-03-05\",\"tmdbPopularityScore\":2049.75,\"tmdbId\":\"762509\",\"dcmEdiMovieId\":\"457959\",\"dcmEdiMovieName\":\"(G)I-Dle World Tour [Idol] In Cinemas (Concert) (2D) [12A]\",\"siteId\":\"124\",\"titleClassId\":\"75\",\"showings\":[{\"id\":\"275567\",\"time\":\"2025-03-05T11:30:00Z\",\"ticketsSold\":0,\"screenId\":\"238\",\"seatsRemaining\":46,\"displayMetaData\":\"{\\\"classes\\\":\\\"ld-friendly\\\"}\"}]},{\"id\":\"22195\",\"name\":\"Baby + 1 Mufasa: The Lion King\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"baby-1-mufasa-the-lion-king\",\"posterImage\":\"0qr1g8bksvrmlqthiq6wm1gsljiq\",\"bannerImage\":\"qwsn4dq9xufmx9goz6te1v49crye\",\"synopsis\":\"“Mufasa: The Lion King” enlists Rafiki to relay the legend of Mufasa to young lion cub Kiara, daughter of Simba and Nala, with Timon and Pumbaa lending their signature schtick. Told in flashbacks, the story introduces Mufasa as an orphaned cub, lost and alone until he meets a sympathetic lion named Taka—the heir to a royal bloodline. The chance meeting sets in motion an expansive journey of an extraordinary group of misfits searching for their destiny—their bonds will be tested as they work together to evade a threatening and deadly foe.  \",\"starring\":\"Aaron Pierre, Kelvin Harrison, Jr., Tiffany Boone, John Kani, Mads Mikkelsen, Seth Rogen\",\"directedBy\":\"Barry Jenkins\",\"producedBy\":\"Adele Romanski, Mark Ceryak\",\"searchTerms\":\"\",\"duration\":118,\"genre\":\"Adventure\",\"allGenres\":\"Adventure, Animation, Family\",\"rating\":\"PG\",\"trailerYoutubeId\":\"do0c3iLWdE8\",\"trailerVideo\":null,\"releaseDate\":\"2024-12-20\",\"dateOfFirstShowing\":\"2025-03-05\",\"tmdbPopularityScore\":2049.75,\"tmdbId\":\"762509\",\"dcmEdiMovieId\":\"43624\",\"dcmEdiMovieName\":\"Anchor Baby (2D) [12A]\",\"siteId\":\"124\",\"titleClassId\":\"75\",\"showings\":[{\"id\":\"275568\",\"time\":\"2025-03-05T12:00:00Z\",\"ticketsSold\":3,\"screenId\":\"237\",\"seatsRemaining\":53,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating accessible baby1 sc2\\\"}\"}]},{\"id\":\"22153\",\"name\":\"Mickey 17\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"mickey-17\",\"posterImage\":\"s3tdq8b608za8f252d8fik76db8r\",\"bannerImage\":\"1xtxgtipr795uz7wonbyjqoulfbz\",\"synopsis\":\"From the Academy Award-winning writer/director of “Parasite,” Bong Joon Ho, comes his next groundbreaking cinematic experience, “Mickey 17.” The unlikely hero, Mickey Barnes (Robert Pattinson) has found himself in the extraordinary circumstance of working for an employer who demands the ultimate commitment to the job… to die, for a living.\",\"starring\":\"Robert Pattinson, Mark Ruffalo, Naomi Ackie, Toni Collette, Steven Yeun, Anamaria Vartolomei, Holliday Grainger\",\"directedBy\":\"Bong Joon Ho\",\"producedBy\":\"Bong Joon Ho, Dooho Choi, Dede Gardner, Jeremy Kleiner\",\"searchTerms\":\"\",\"duration\":137,\"genre\":\"Science Fiction\",\"allGenres\":\"Science Fiction, Fantasy, Comedy\",\"rating\":\"15\",\"trailerYoutubeId\":\"6D3pcuJQkc4\",\"trailerVideo\":null,\"releaseDate\":\"2025-03-07\",\"dateOfFirstShowing\":\"2025-03-07\",\"tmdbPopularityScore\":158.794,\"tmdbId\":\"696506\",\"dcmEdiMovieId\":\"378560\",\"dcmEdiMovieName\":\"Mickey 17 (2D) [15]\",\"siteId\":\"124\",\"titleClassId\":\"75\",\"showings\":[{\"id\":\"274535\",\"time\":\"2025-03-07T14:00:00Z\",\"ticketsSold\":0,\"screenId\":\"236\",\"seatsRemaining\":69,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating accessible sc1\\\"}\"},{\"id\":\"274534\",\"time\":\"2025-03-07T17:00:00Z\",\"ticketsSold\":0,\"screenId\":\"236\",\"seatsRemaining\":69,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating accessible sc1\\\"}\"},{\"id\":\"274533\",\"time\":\"2025-03-07T20:00:00Z\",\"ticketsSold\":2,\"screenId\":\"236\",\"seatsRemaining\":67,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating accessible sc1\\\"}\"},{\"id\":\"275802\",\"time\":\"2025-03-08T11:00:00Z\",\"ticketsSold\":0,\"screenId\":\"236\",\"seatsRemaining\":69,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating accessible sc1\\\"}\"},{\"id\":\"275799\",\"time\":\"2025-03-08T14:00:00Z\",\"ticketsSold\":0,\"screenId\":\"236\",\"seatsRemaining\":69,\"displayMetaData\":\"{\\\"classes\\\":\\\"reserved-seating accessible sc1\\\"}\"},{\"id\":\"275800\",\"time\":\"2025-03-08T17:00:00Z\",\"ticketsSold\":0,\"screenId\":\"236\",\"seatsRemaining\":69,\"displ