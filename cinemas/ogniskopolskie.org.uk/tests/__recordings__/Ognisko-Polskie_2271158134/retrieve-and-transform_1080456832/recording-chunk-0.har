3\\/8\\/143854010\\/UTGTV2JNFUQ4GJ7B3SJCTM75.jpeg?width=1280\"},\"url\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UTGTV2JNFUQ4GJ7B3SJCTM75.jpeg\",\"urls\":{\"320\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UTGTV2JNFUQ4GJ7B3SJCTM75.jpeg?width=320\",\"640\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UTGTV2JNFUQ4GJ7B3SJCTM75.jpeg?width=640\",\"80\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UTGTV2JNFUQ4GJ7B3SJCTM75.jpeg?width=80\",\"2560\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UTGTV2JNFUQ4GJ7B3SJCTM75.jpeg?width=2560\",\"160\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UTGTV2JNFUQ4GJ7B3SJCTM75.jpeg?width=160\",\"1280\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UTGTV2JNFUQ4GJ7B3SJCTM75.jpeg?width=1280\"},\"site_product_image_id\":\"UTGTV2JNFUQ4GJ7B3SJCTM75\",\"updated_at\":\"2026-04-28T09:33:52.992Z\",\"site_id\":\"331421882896289726\",\"width\":2560,\"id\":\"UTGTV2JNFUQ4GJ7B3SJCTM75\",\"height\":2560}},\"placeholder_image\":{\"data\":{\"placeholder\":true,\"url\":\"\\/images\\/commerce\\/store-app\\/app\\/universal_product_placeholder.png\",\"absolute_url\":\"cdn3.editmysite.com\\/images\\/commerce\\/store-app\\/app\\/universal_product_placeholder.png\"}},\"categoryIds\":[\"VB5BTC3FXXCEZZPYS6AJIDKL\"]},{\"id\":\"HUYEKAL7QWPIJDMFY4MIWNB5\",\"owner_id\":\"143854010\",\"merchant_id\":\"MLKB93FPT91XW\",\"site_id\":\"331421882896289726\",\"channel_id\":\"CH_0abDwIQlE19tArq0hghQ3f4FDkJ7AiSj0MtfYRlQuYC\",\"site_product_id\":\"HUYEKAL7QWPIJDMFY4MIWNB5\",\"square_id\":\"HUYEKAL7QWPIJDMFY4MIWNB5\",\"visibility\":\"visible\",\"visibility_tl\":\"Visible\",\"name\":\"7 July | RAF Hendon Evening Highlighting 303 Ko\\u015bciuszko Squadron\",\"short_description\":\"<p>The legendary 303 Ko\\u015bciuszko Squadron has a very special place in the history of the Second World War, and in particular the Battle of Britain. This will be the subject of the first presentation of the evening, given by Professor David Rosen (a member of Ognisko Polskie), with a conclusion provided by Air Chief Marshal Sir Stephen Hillier. An aviation expert will then detail the role and workings of the Hawker Hurricane, followed by a talk on individual pilots and commanders of the 303 Squadron. Guests will also have an opportunity to share their family histories. Additionally, archivists will present rarely seen memorabilia relating to the 303 Squadron, making this a very special evening.<\\/p><p><br><\\/p><p>All attending children must remain under the supervision of a parent or designated guardian at all times. Parents or guardians are fully responsible for the welfare, safety, and conduct of any minors in their care throughout the event.<\\/p><p>As a condition of participation, parents or guardians will be asked to provide written confirmation that they consent to the minor being photographed and\\/or filmed during the event. Parents or guardians acknowledge that Ognisko Polskie has no control over, and accepts no responsibility for, the subsequent use, publication, sharing, or distribution of such images or recordings by third parties, event organisers, media representatives, or members of the public.<\\/p>\",\"popularity_score\":1.04,\"cross_sell_product_ids\":[],\"variation_type\":\"3\",\"product_type\":\"event\",\"product_type_details\":{\"end_date\":\"2026-07-07\",\"start_time\":\"6:00 PM\",\"location_name\":\"RAF Hendon - at Royal Air Force Museum London\",\"address\":{\"country_code\":\"GB\",\"country_code_full_name\":\"United Kingdom\",\"city\":\"LONDON\",\"street\":\"RAF Hendon - at Royal Air Force Museum London\",\"country_code_cca2\":\"GB\",\"street2\":\"Grahame Park Way,\",\"postal_code\":\"NW9 5LL\",\"region_code_full_name\":\"London\",\"region_code\":\"London\",\"regio