1\\/4\\/3\\/8\\/143854010\\/B3SPITNLF7HHYU4Q3T3RECI7.jpeg?width=160\",\"1280\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/B3SPITNLF7HHYU4Q3T3RECI7.jpeg?width=1280\"},\"url\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/B3SPITNLF7HHYU4Q3T3RECI7.jpeg\",\"urls\":{\"320\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/B3SPITNLF7HHYU4Q3T3RECI7.jpeg?width=320\",\"640\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/B3SPITNLF7HHYU4Q3T3RECI7.jpeg?width=640\",\"80\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/B3SPITNLF7HHYU4Q3T3RECI7.jpeg?width=80\",\"2560\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/B3SPITNLF7HHYU4Q3T3RECI7.jpeg?width=2560\",\"160\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/B3SPITNLF7HHYU4Q3T3RECI7.jpeg?width=160\",\"1280\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/B3SPITNLF7HHYU4Q3T3RECI7.jpeg?width=1280\"},\"site_product_image_id\":\"B3SPITNLF7HHYU4Q3T3RECI7\",\"updated_at\":\"2026-05-15T12:21:38.732Z\",\"site_id\":\"331421882896289726\",\"width\":2560,\"id\":\"B3SPITNLF7HHYU4Q3T3RECI7\",\"height\":2560}},\"placeholder_image\":{\"data\":{\"placeholder\":true,\"url\":\"\\/images\\/commerce\\/store-app\\/app\\/universal_product_placeholder.png\",\"absolute_url\":\"cdn3.editmysite.com\\/images\\/commerce\\/store-app\\/app\\/universal_product_placeholder.png\"}},\"categoryIds\":[\"VB5BTC3FXXCEZZPYS6AJIDKL\"]},{\"id\":\"KP2LZWWVMA2EM3YJOP3PQLGE\",\"owner_id\":\"143854010\",\"merchant_id\":\"MLKB93FPT91XW\",\"site_id\":\"331421882896289726\",\"channel_id\":\"CH_0abDwIQlE19tArq0hghQ3f4FDkJ7AiSj0MtfYRlQuYC\",\"site_product_id\":\"KP2LZWWVMA2EM3YJOP3PQLGE\",\"square_id\":\"KP2LZWWVMA2EM3YJOP3PQLGE\",\"visibility\":\"visible\",\"visibility_tl\":\"Visible\",\"name\":\"12 June | Anita \\u0141azi\\u0144ska Quartet\",\"short_description\":\"<p>Anita \\u0141azi\\u0144ska is a versatile musician - vocalist, pianist, composer, graduate of the Academy of Music in Bydgoszcz (Poland). Currently collaborates with London and Polish musicians and is the leader of Anita \\u0141azi\\u0144ska Quartet - a band in which she presents her ideas of compositions and arrangements.An active musician - she has been performing on London jazz stages for years (Jazz Cafe POSK, Union Chapel, Oliver&#39;s Jazz Bar), as an accompanist of the Brent Music Service choir she had the pleasure of performing at the Royal Albert Hall and Wembley Arena. Anita regularly has been a part of projects such as All Souls\\u2019 Day Jazz Festival, Voicingers on Tour in London or W\\u0105bJazzno Festival (Poland). She also had the pleasure of collaborating with great musicians like the Leszek Ku\\u0142akowski Trio, Piotr Damasiewicz, Igor Zakus and Usein Bekirov,\\u00a0 Maciej Sika\\u0142a.<\\/p><p>Anita will present several popular Polish jazz standards that shaped her musical sensibility and her own compositions, which were created over the course of over 20 years of musical activity in Poland and England. These works\\u00a0 are companions of her personal and musical growth.<\\/p><p>&#34;Anita&#39;s voice is peculiar, I can treat it like a musical instrument in jazz music - it has a large palette of colors, shades and dynamics, and what is important - it speaks the language of improvisation. Few singers can afford it.Anita is a real partner on stage.&#34; Igor Zakus<\\/p><p>Line up:<\\/p><p>Anita \\u0141azi\\u0144ska - piano, vocals<\\/p><p>Benjamin Gasiglia - guitar<\\/p><p>Jakub Cywi\\u0144ski - bass<\\/p><p>Eric Ford - drums<\\/p><p>repertoire:<\\/p><p>Dwa serduszka, cztery oczy - Tadeusz Sygiety\\u0144ski, Mira Zimi\\u0144ska - Sygiety\\u0144ska (adaptacja ludowego tekstu)<\\/p><p>Dwa serduszka, cztery oczy - Tadeusz Sygiety\\u0144ski, Mira Zimi\\u0144ska - Sygiety\\u0144ska (adaptacja ludowego tekstu)<\\/p><p>\\u017byj kolorowo - Jan Wr\\u00f3blewski, Wojciech M\\u0142ynarski<\\/p><p>Tolerancja - Stanis\\u0142aw Sojka<\\/p><p>Nieobecni - Janusz Strobel, Jonasz KoftaTrzeba marzy\\u0107 - Janusz Strobel, Jonasz Kofta<\\/p><p>Halo, Szpicbr\\u00f3dka - Seweryn Krajewski, Agnieszka Osiecka<\\/p><p>Latinoza - Anita \\u0141azi\\u0144ska<\\/p><p>Modlitwa o spok\\u00f3j ducha - Anita \\u0141azi\\u0144ska<\\/p><p>Wrzesie\\u0144 - Anita \\u0141azi\\u0144ska<\\/p><p>Ukojenie - Anita \\u0141azi\\u0144ska<\\/p><p>Co\\u015b nowego - Anita \\u0141azi\\u0144ska<\\/p><p>Szumi w gaju brzezina - Anita \\u0141azi\\u0144ska, Adam Asnyk<\\/p><p><br><\\/p>\",\"popularity_score\":1.45,\"cross_sell_product_ids\":[],\"variation_type\":\"3\",\"product_type\":\"event\",\"product_type_details\":{\"location_name\":\"\",\"location_types\":[\"IN_PERSON\"],\"address\":{\"city\":\"LONDON\",\"country_code\":\"GB\",\"postal_code\":\"SW7 2PN\",\"region_code\":\"ENG\",\"street\":\"Ognisko Polskie\",\"street2\":\"55 Princes Gate, Exhibition Road\",\"region_code_cca2\":\"ENG\",\"region_code_full_name\":\"England\",\"country_code_cca2\":\"GB\",\"country_code_full_name\":\"United Kingdom\"},\"geocode\":{\"lat\":null,\"long\":null},\"start_date\":\"2026-06-12\",\"end_date\":\"2026-06-12\",\"start_time\":\"7:00 PM\",\"end_time\":\"10:00 PM\",\"timezone\":\"Europe\\/London\",\"timezone_info\":{\"name\":\"Europe\\/London\",\"current_time_24_format\":\"11:48\",\"utc_offset_string\":\"+01:00\",\"utc_offset_minutes\":60},\"has_no_end_time\":\"0\",\"join_event_online_link\":\"\"},\"taxable\":null,\"required_feature_to_sell\":null,\"min_prep_time\":null,\"min_prep_time_duration_iso8601\":null,\"advanced_notice_duration\":null,\"measurement_unit_abbreviation\":null,\"measurement_unit_precision\":null,\"has_multiple_measurement_units\":false,\"is_alcoholic\":false,\"per_order_max\":0,\"allow_order_item_quantities\":false,\"badges\":{\"low_stock\":false,\"out_of_stock\