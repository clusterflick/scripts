.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/4FQBPXLHWIMVP25OH6C42T6W.png?width=640\",\"80\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/4FQBPXLHWIMVP25OH6C42T6W.png?width=80\",\"2560\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/4FQBPXLHWIMVP25OH6C42T6W.png?width=2560\",\"160\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/4FQBPXLHWIMVP25OH6C42T6W.png?width=160\",\"1280\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/4FQBPXLHWIMVP25OH6C42T6W.png?width=1280\"},\"url\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/4FQBPXLHWIMVP25OH6C42T6W.png\",\"urls\":{\"320\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/4FQBPXLHWIMVP25OH6C42T6W.png?width=320\",\"640\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/4FQBPXLHWIMVP25OH6C42T6W.png?width=640\",\"80\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/4FQBPXLHWIMVP25OH6C42T6W.png?width=80\",\"2560\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/4FQBPXLHWIMVP25OH6C42T6W.png?width=2560\",\"160\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/4FQBPXLHWIMVP25OH6C42T6W.png?width=160\",\"1280\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/4FQBPXLHWIMVP25OH6C42T6W.png?width=1280\"},\"site_product_image_id\":\"4FQBPXLHWIMVP25OH6C42T6W\",\"updated_at\":\"2026-04-27T13:31:12.215Z\",\"site_id\":\"331421882896289726\",\"width\":2560,\"id\":\"4FQBPXLHWIMVP25OH6C42T6W\",\"height\":2560}},\"placeholder_image\":{\"data\":{\"placeholder\":true,\"url\":\"\\/images\\/commerce\\/store-app\\/app\\/universal_product_placeholder.png\",\"absolute_url\":\"cdn3.editmysite.com\\/images\\/commerce\\/store-app\\/app\\/universal_product_placeholder.png\"}},\"categoryIds\":[\"Q6LUUGWLH23J3DY3ULFHBPOK\"]},{\"id\":\"PN2HYG63FGPH742MIPG5PB34\",\"owner_id\":\"143854010\",\"merchant_id\":\"MLKB93FPT91XW\",\"site_id\":\"331421882896289726\",\"channel_id\":\"CH_0abDwIQlE19tArq0hghQ3f4FDkJ7AiSj0MtfYRlQuYC\",\"site_product_id\":\"PN2HYG63FGPH742MIPG5PB34\",\"square_id\":\"PN2HYG63FGPH742MIPG5PB34\",\"visibility\":\"visible\",\"visibility_tl\":\"Visible\",\"name\":\"17 Sep |  Wis\\u0142awa Szymborska - Poetry and Life\",\"short_description\":\"<p>Event in Polish<\\/p><p><br><\\/p><p>Celebrating the 30th Anniversary of Wis\\u0142awa Szymborska\\u2019s Nobel Prize<\\/p><p><em>Wis\\u0142awa Szymborska - Poetry and Life<\\/em>, performed by Agata Pilitowska, is an intimate, moving and deeply authentic journey into the world of one of Poland\\u2019s most important poets.<\\/p><p>Pilitowska, an actress known for her sensitivity and careful attention to language, has created a one-woman performance that explores the essence of Szymborska\\u2019s extraordinary appeal. The intimate format allows her to build a close, almost personal connection with the audience, placing the spoken word at the heart of the performance. This approach perfectly complements the Nobel laureate\\u2019s restrained yet profoundly insightful writing.<\\/p><p>The performance invites audiences to reflect on the passage of time, love and the sense of \\u201cgreat wonder\\u201d at the world that was so characteristic of Szymborska.<\\/p><p>Interweaving poetry with biographical details, anecdotes and personal recollections, Pilitowska reveals not only Szymborska the great poet, but also Szymborska the person - with her distinctive sense of humour, detachment from the world and remarkable ability to discover significance in everyday life.<\\/p><p><br><\\/p><p>Kameralna, poruszaj\\u0105ca i niezwykle autentyczna podr\\u00f3\\u017c przez \\u015bwiat jednej z najwa\\u017cniejszych polskich poetek w 30 rocznic\\u0119 otrzymania Nagrody Nobla przez Wis\\u0142aw\\u0119 Szymborsk\\u0105. Spektakl przygotowany przez \\u201cSalon Poezji, Muzyki i Teatru\\u201d<\\/p><p><br><\\/p><p>Spektakl w jezyku polskim<\\/p><p><br><\\/p><p><br><\\/p>\",\"popularity_score\":0.58,\"cross_sell_product_ids\":[],\"variation_type\":\"3\",\"product_type\":\"event\",\"product_type_details\":{\"location_name\":\"\",\"location_types\":[\"IN_PERSON\"],\"address\":{\"city\":\"London\",\"country_code\":\"GB\",\"postal_code\":\"SW7 2PN\",\"region_code\":\"London\",\"street\":\"55 Exhibition Road\",\"street2\":null,\"region_code_cca2\":\"London\",\"region_code_full_name\":\"London\",\"country_code_cca2\":\"GB\",\"country_code_full_name\":\"United Kingdom\"},\"geocode\":{\"lat\":null,\"long\":null},\"start_date\":\"2026-09-17\",\"end_date\":\"2026-09-17\",\"start_time\":\"7:00 PM\",\"end_time\":\"11:00 PM\",\"timezone\":\"Europe\\/London\",\"timezone_info\":{\"name\":\"Europe\\/London\",\"current_time_24_format\":\"10:55\",\"utc_offset_string\":\"+01:00\",\"utc_offset_minutes\":60},\"has_no_end_time\":\"0\",\"join_event_online_link\":\"\"},\"taxable\":null,\"required_feature_to_sell\":null,\"min_prep_time\":null,\"min_prep_time_duration_iso8601\":null,\"advanced_notice_duration\":null,\"measurement_unit_abbreviation\":null,\"measurement_unit_precision\":null,\"has_multiple_measurement_units\":false,\"is_alcoholic\":false,\"per_order_max\":0,\"allow_order_item_quantities\":false,\"badges\":{\"low_stock\":false,\"out_of_stock\":false,\"on_sale\":false},\"only_subscribable\":false,\"fulfillable\":true,\"site_link\":\"product\\/17-sep-wis-awa-szymborska-poetry-and-life\\/PN2HYG63FGPH742MIPG5PB34\",\"absolute_site_link\":\"https:\\/\\/www.ogniskopolskie.org.uk\\/product\\/17-sep-wis-awa-szymborska-poetry-and-life\\/PN2HYG63FGPH742MIPG5PB34\",\"permalink\":null,\"seo_product_image_id\":\"UAYTT6JXFK2N6DL3XLG7ETBE\",\"seo_page_description\":null,\"seo_page_title\":null,\"og_title\":null,\"og_description\":null,\"avg_rating\":null,\"avg_rating_all\"