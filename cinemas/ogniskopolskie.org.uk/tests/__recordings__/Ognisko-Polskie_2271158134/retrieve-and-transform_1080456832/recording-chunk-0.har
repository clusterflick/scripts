,\"regular_low_formatted_with_subscriptions\":\"\\u00a30.00\"},\"on_sale\":false,\"combo_type_details\":{\"slots\":[]},\"updated_date\":\"2026-05-22T07:29:23+00:00\",\"created_date\":\"2026-03-09T11:40:20+00:00\",\"indexed_date\":\"2026-05-22T07:29:39+00:00\",\"preordering\":{\"pickup\":false,\"delivery\":false,\"shipping\":false,\"dine_in\":false,\"manual\":false,\"download\":false},\"fulfillment_availability\":{\"pickup\":[],\"delivery\":[],\"shipping\":[],\"dine_in\":[],\"manual\":[]},\"thumbnail\":{\"data\":{\"owner_id\":\"143854010\",\"format\":\"jpeg\",\"created_at\":\"2026-03-27T11:12:53.292Z\",\"absolute_url\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/V65R3PFFSZVIYWOQKHJVIX57.jpeg\",\"absolute_urls\":{\"320\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/V65R3PFFSZVIYWOQKHJVIX57.jpeg?width=320\",\"640\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/V65R3PFFSZVIYWOQKHJVIX57.jpeg?width=640\",\"80\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/V65R3PFFSZVIYWOQKHJVIX57.jpeg?width=80\",\"2560\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/V65R3PFFSZVIYWOQKHJVIX57.jpeg?width=2560\",\"160\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/V65R3PFFSZVIYWOQKHJVIX57.jpeg?width=160\",\"1280\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/V65R3PFFSZVIYWOQKHJVIX57.jpeg?width=1280\"},\"url\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/V65R3PFFSZVIYWOQKHJVIX57.jpeg\",\"urls\":{\"320\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/V65R3PFFSZVIYWOQKHJVIX57.jpeg?width=320\",\"640\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/V65R3PFFSZVIYWOQKHJVIX57.jpeg?width=640\",\"80\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/V65R3PFFSZVIYWOQKHJVIX57.jpeg?width=80\",\"2560\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/V65R3PFFSZVIYWOQKHJVIX57.jpeg?width=2560\",\"160\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/V65R3PFFSZVIYWOQKHJVIX57.jpeg?width=160\",\"1280\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/V65R3PFFSZVIYWOQKHJVIX57.jpeg?width=1280\"},\"site_product_image_id\":\"V65R3PFFSZVIYWOQKHJVIX57\",\"updated_at\":\"2026-03-27T11:12:53.232Z\",\"site_id\":\"331421882896289726\",\"width\":2560,\"id\":\"V65R3PFFSZVIYWOQKHJVIX57\",\"height\":2560}},\"placeholder_image\":{\"data\":{\"placeholder\":true,\"url\":\"\\/images\\/commerce\\/store-app\\/app\\/universal_product_placeholder.png\",\"absolute_url\":\"cdn3.editmysite.com\\/images\\/commerce\\/store-app\\/app\\/universal_product_placeholder.png\"}},\"categoryIds\":[\"VB5BTC3FXXCEZZPYS6AJIDKL\"]},{\"id\":\"ZL4BOMIHMQT62CL4MNTJQTQD\",\"owner_id\":\"143854010\",\"merchant_id\":\"MLKB93FPT91XW\",\"site_id\":\"331421882896289726\",\"channel_id\":\"CH_0abDwIQlE19tArq0hghQ3f4FDkJ7AiSj0MtfYRlQuYC\",\"site_product_id\":\"ZL4BOMIHMQT62CL4MNTJQTQD\",\"square_id\":\"ZL4BOMIHMQT62CL4MNTJQTQD\",\"visibility\":\"visible\",\"visibility_tl\":\"Visible\",\"name\":\"24 June | Jakub Gawrysiak\",\"short_description\":\"<p>Please note: this concert is in Polish.<\\/p><p><br><\\/p><p>Poland\\u2019s independence only lasted 20 years between the two world wars, but this era saw extraordinary achievements in Polish culture, particularly music. And promoting the music of inter-war Poland has become a mission of the accomplished musician Jakub Gawrysiak. As a one-man orchestra: multi-instrumentalist, vocalist and composer, he is eminently qualified to do this, and his \\u201cMaestrO!rkiestra\\u201d performs in Poland and various other countries.<\\/p><p><br><\\/p><p>This solo concert by Jakub Gawrysiak, with his charming voice and accompaniment, will feature hits from the interwar period to several decades after the end of the Second World War. Performances will include the title track: &#34;Sentymentalny Pan\\u201d, \\u201cW Ma\\u0142ym Kinie\\u201d, \\u201cUm\\u00f3wmy si\\u0119 na Dzi\\u015b\\u201d, \\u201cCa\\u0142uj\\u0119 Twoj\\u0105 D\\u0142o\\u0144, Madame\\u201d, \\u201cPierwszy Siwy W\\u0142os\\u201d, \\u201cTa Ostatnia Niedziela\\u201d<\\/p><p><br><\\/p><p><strong>Mieczys\\u0142aw Fogg<\\/strong><\\/p><p>Mieczys\\u0142aw Fogiel (later Fogg) was born in Warsaw on 30 May 1901. He was an exceptional Polish performer who was already well-known before the Second World War and had started embarking on an international career touring countries including Germany, Latvia, the Soviet Union, Finland, Norway, Sweden, Austria and Italy in the early 30s. He was one of the most popular singers in Poland also appearing in 11 films. Marian Hemar was among the authors of his songs.<\\/p><p>Fogg had a lyric baritone voice, exceptional charm and movie-star good looks.<\\/p><p>He\\u2019s probably most known as a singer, but his significance for Polish culture extends far beyond the world of music. He created hits, but he was also a patriot fighting for his country\\u2019s freedom alongside the soldiers from the Polish Underground movement (AK) in the Second World War.\\u00a0 He gave concerts in the few cafes available to Poles under German occupation, and during the Warsaw Uprising (PowstanieWarszawskie), he gave countless concerts on the barricades, in hospitals and in the bomb shelters beneath the city to raise morale of soldiers and civilians in those brutal times.<\\/p><p>After the War, he brought the charm of pre-war theatres and cabarets to the grey world of communist Poland, and his elegance evoked the class of a bygone lifestyle<\\/p><p>As well as a number of Polish awards, he also received the Polish Righteous among the Nations for concealing a Jewish family in his apartment throughout the occupation.<\\/p><p>After the War, in 1945, he opened up his own cafe in the ruins of Warsaw, which was then closed by the new communist authorities of Poland a year later. Fogg continued to give hundreds of concerts in all parts of Poland and also headed his private music record firm Fogg Records, which shared the same fate as his cafe in 1951.\\u00a0<\\/p><p>He continued to give concerts undeterred throughout his 60 year career.<\\/p>\",\"popularity_score\":0.79,\"cross_sell_product_ids\":[],\"variation_type\":\"3\",\"product_type\":\"event\",\"product_type_details\":{\"end_date\":\"2026-06-24\",\"start_time\":\"7:00 PM\",\"location_name\":\"\",\"address\":{\"country_code\":\"GB\",\"country_code_full_name\":\"United Kingdom\",\"city\":\"LONDON\",\"street\":\"Ognisko Polskie\",\"country_code_cca2\":\"GB\",\"street2\":\"55 Princes Gate, Exhibition Road\",\"postal_code\":\"SW7 2PN\",\"region_code_full_name\":\"London\",\"region_code\":\"London\",\"region_code_cca2\":\"London\"},\"timezone_info\":{\"utc_offset_string\":\"+01:00\",\"name\":\"Europe\\/London\",\"utc_offset_minutes\":60,\"current_time_24_format\":\"15:27\"},\"location_types\":[\"IN_PERSON\"],\"timezone\":\"Europe\\/London\",\"join_event_online_link\":\"\",\"geocode\":{\"lat\":null,\"long\":null},\"end_time\":\"10:00 PM\",\"has_no_end_time\":\"0\",\"start_date\":\"2026-06-24\"},\"taxable\":null,\"required_feature_to_sell\":null,\"min_prep_time\":null,\"min_prep_time_duration_iso8601\":null,\"advanced_notice_duration\":null,\"measurement_unit_abbreviation\":null,\"measurement_unit_precision\":null,\"has_multiple_measurement_units\":false,\"is_alcoholic\":false,\"per_order_max\":0,\"allow_order_item_quantities\":false,\"badges\":{\"out_of_stock\":false,\"low_stock\":false,\"on_sale\":false},\"only_subscribable\":false,\"fulfillable\":true,\"site_link\":\"product\\/24-june-jakub-gawrysiak\\/ZL4BOMIHMQT62CL4MNTJQTQD\",\"absolute_site_link\":\"https:\\/\\/www.ogniskop