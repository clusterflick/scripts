site.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/BCAZ6WABJK6IPCLR2UPH7HV7.jpeg?width=640\",\"80\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/BCAZ6WABJK6IPCLR2UPH7HV7.jpeg?width=80\",\"2560\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/BCAZ6WABJK6IPCLR2UPH7HV7.jpeg?width=2560\",\"160\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/BCAZ6WABJK6IPCLR2UPH7HV7.jpeg?width=160\",\"1280\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/BCAZ6WABJK6IPCLR2UPH7HV7.jpeg?width=1280\"},\"site_product_image_id\":\"BCAZ6WABJK6IPCLR2UPH7HV7\",\"updated_at\":\"2026-05-14T13:28:20.708Z\",\"site_id\":\"331421882896289726\",\"width\":2560,\"id\":\"BCAZ6WABJK6IPCLR2UPH7HV7\",\"height\":2560}},\"placeholder_image\":{\"data\":{\"placeholder\":true,\"url\":\"\\/images\\/commerce\\/store-app\\/app\\/universal_product_placeholder.png\",\"absolute_url\":\"cdn3.editmysite.com\\/images\\/commerce\\/store-app\\/app\\/universal_product_placeholder.png\"}},\"categoryIds\":[\"VB5BTC3FXXCEZZPYS6AJIDKL\"]},{\"id\":\"MRGEJQTTRND32CRQYE2QHTUC\",\"owner_id\":\"143854010\",\"merchant_id\":\"MLKB93FPT91XW\",\"site_id\":\"331421882896289726\",\"channel_id\":\"CH_0abDwIQlE19tArq0hghQ3f4FDkJ7AiSj0MtfYRlQuYC\",\"site_product_id\":\"MRGEJQTTRND32CRQYE2QHTUC\",\"square_id\":\"MRGEJQTTRND32CRQYE2QHTUC\",\"visibility\":\"visible\",\"visibility_tl\":\"Visible\",\"name\":\"26 Sep | Obozowe Tango 26\",\"short_description\":\"<p><strong>Obozowe Tango \\u2018Reunited\\u2019<\\/strong><\\/p><p><br><\\/p><p>This is a Wieczor Harcerski (Scouts Evening) but this also means you can dance the night away to music from our live band - The Fantasy Band, sustained by a buffet supper kindly donated by the Ognisko Restaurant.<\\/p><p>The evening will also provide another important benefit: funds for vital refurbishment work at the Stanica Harcerska (Polish Scout House) in St Briavels. Set within 16 acres of beautiful woodland in the Wye Valley in Gloucestershire, thousands of young people have enjoyed \\u2018obozy,\\u2019 \\u2018kolonie\\u2019 and \\u2018biwaki\\u2019 (camps and cub\\/brownie holidays) at St Briavels since it was purchased by ZHP WB (the Polish Scouts Organisation) in 1962. Please note the minimum age to attend this event is 18 years.<\\/p><p><br><\\/p><p>Dance to live music from the \\u201cFantasy Band\\u201d<\\/p><p>Wieczorek Harcerski led by \\u201cWatra\\u201d \\u2022 Price includes a buffet food from the Ognisko Restaurant<\\/p><p>All proceeds from this event will be donated to the Polish Scout house - St Briavels<\\/p><p>18+ only!<\\/p><p><br><\\/p><p>The current project is refurbishing the original building on the estate, Bia\\u0142y Dom (White House), which will accommodate 36 guests. Most of the external work is already completed, with \\u00a3350,000 still needed to provide essential internal facilities, and open the house to guests.<\\/p><p><br><\\/p><p>Recent projects include a new fully equipped building, Dom Le\\u015bny (Wood House) with 46 beds completed in 2019, while the caretakers cottage was refurbished in 2016.<\\/p><p><br><\\/p><p>If you would like to provide additional support please consider the following options.<\\/p><p><br><\\/p><p>Buy a cegie\\u0142ka (square) for \\u00a3500<\\/p><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https:\\/\\/www.stanicastbriavels.org.uk\\\">https:\\/\\/www.stanicastbriavels.org.uk<\\/a><\\/p><p>Or perhaps you would consider a monthly or one off donation<\\/p><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https:\\/\\/www.stanicastbriavels.uk\\/jak-zlozyc-dotacje-na-st-briavels-fund\\/\\\">https:\\/\\/www.stanicastbriavels.uk\\/jak-zlozyc-dotacje-na-st-briavels-fund\\/<\\/a><\\/p>\",\"popularity_score\":1.59,\"cross_sell_product_ids\":[],\"variation_type\":\"3\",\"product_type\":\"event\",\"product_type_details