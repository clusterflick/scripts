store-app\\/app\\/universal_product_placeholder.png\"}},\"categoryIds\":[\"VB5BTC3FXXCEZZPYS6AJIDKL\"]},{\"id\":\"DGEPFNNB5OYZ3TPWX4Y426Z7\",\"owner_id\":\"143854010\",\"merchant_id\":\"MLKB93FPT91XW\",\"site_id\":\"331421882896289726\",\"channel_id\":\"CH_0abDwIQlE19tArq0hghQ3f4FDkJ7AiSj0MtfYRlQuYC\",\"site_product_id\":\"DGEPFNNB5OYZ3TPWX4Y426Z7\",\"square_id\":\"DGEPFNNB5OYZ3TPWX4Y426Z7\",\"visibility\":\"visible\",\"visibility_tl\":\"Visible\",\"name\":\"29 June | Two Divas Meet: One Blends Whisky, One Sings Opera\",\"short_description\":\"<p><strong>Two Divas Meet: One Blends Whisky, One Sings Opera<\\/strong><\\/p><p><br><\\/p><p>6-7 pm pre-event drinks reception hosted by Faer Isles Distillery<\\/p><p>7pm for 7.30pm A Tasting of Compass Box whiskies and Operatic entertainment<\\/p><p>After-party hosted by Faer Isles Distillery<\\/p><p><br><\\/p><p>Ladies and Gentlemen, we present a deluxe evening ! Angela d\\u2019Orazio, creative director of whisky making for Compass Box Whisky, will discuss her route into whisky before a tutored tasting of three specially selected whiskies, each accompanied by a canape chosen to complement the flavour. Angela will also explain how she blends whiskies with different characteristics to create a particular flavour profile. A blend is often compared to an orchestra, with every component whisky resembling an individual instrument, which means the \\u2018notes\\u2019 of a whisky have a natural parallel with musical notes. This provides a perfect entree for our Opera Diva to sing the notes of a whisky, and then continue with an Opera repertoire.<\\/p><p><br><\\/p><p>Please note, this event is preceded by a drinks reception, and followed by an after party, both hosted by Faer Isles Distillery, which distills malt whisky, vodka, gin and akvavit on the Faroe Isles. This is the most remote distillery in the world, with the Faroe Isles located between Scotland and Iceland, but for one night only the spirit of Faer will be in the heart of Ognisko Polskie.<\\/p>\",\"popularity_score\":0.6,\"cross_sell_product_ids\":[],\"variation_type\":\"3\",\"product_type\":\"event\",\"product_type_details\":{\"end_date\":\"2026-06-29\",\"start_time\":\"6:00 PM\",\"location_name\":\"\",\"address\":{\"country_code\":\"GB\",\"country_code_full_name\":\"United Kingdom\",\"city\":\"London\",\"street\":\"Ognisko Polskie\",\"country_code_cca2\":\"GB\",\"street2\":\"55 Exhibition Road\",\"postal_code\":\"SW7 2PN\",\"region_code_full_name\":\"England\",\"region_code\":\"ENG\",\"region_code_cca2\":\"ENG\"},\"timezone_info\":{\"utc_offset_string\":\"+01:00\",\"name\":\"Europe\\/London\",\"utc_offset_minutes\":60,\"current_time_24_format\":\"11:29\"},\"location_types\":[\"IN_PERSON\"],\"timezone\":\"Europe\\/London\",\"join_event_online_link\":\"\",\"geocode\":{\"lat\":null,\"long\":null},\"end_time\":\"10:00 PM\",\"has_no_end_time\":\"0\",\"start_date\":\"2026-06-29\"},\"taxable\":null,\"required_feature_to_sell\":null,\"min_prep_time\":null,\"min_prep_time_duration_iso8601\":null,\"advanced_notice_duration\":null,\"measurement_unit_abbreviation\":null,\"measurement_unit_precision\":null,\"has_multiple_measurement_units\":false,\"is_alcoholic\":false,\"per_order_max\":0,\"allow_order_item_quantities\":false,\"badges\":{\"out_of_stock\":false,\"low_stock\":false,\"on_sale\":false},\"only_subscribable\":false,\"fulfillable\":true,\"site_link\":\"product\\/29-june-two-divas-meet-one-blends-whisky-one-sings-opera\\/DGEPFNNB5OYZ3TPWX4Y426Z7\",\"absolute_site_link\":\"https:\\/\\/www.ogniskopolskie.org.uk\\/product\\/29-june-two-divas-meet-one-blends-whisky-one-sings-opera\\/DGEPFNNB5OYZ3TPWX4Y426Z7\",\"permalink\":null,\"seo_product_image_id\":\"MLTZYJCWAAY75PM5SD4BBMLS\",\"seo_page_description\":null,\"seo_page_title\":null,\"og_title\":null,\"og_description\":null,\"avg_rating\":null,\"avg_rating_all\":null,\"inventory\":{\"total\":62,\"all_variations_sold_out\":false,\"marked_sold_out_at_all_existing_locations\":false,\"marke