,\"url\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/YDQYANUFSCFGU6WSWYNFYYIL.jpeg\",\"urls\":{\"320\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/YDQYANUFSCFGU6WSWYNFYYIL.jpeg?width=320\",\"640\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/YDQYANUFSCFGU6WSWYNFYYIL.jpeg?width=640\",\"80\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/YDQYANUFSCFGU6WSWYNFYYIL.jpeg?width=80\",\"2560\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/YDQYANUFSCFGU6WSWYNFYYIL.jpeg?width=2560\",\"160\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/YDQYANUFSCFGU6WSWYNFYYIL.jpeg?width=160\",\"1280\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/YDQYANUFSCFGU6WSWYNFYYIL.jpeg?width=1280\"},\"site_product_image_id\":\"YDQYANUFSCFGU6WSWYNFYYIL\",\"updated_at\":\"2026-04-14T14:39:16.003Z\",\"site_id\":\"331421882896289726\",\"width\":2560,\"id\":\"YDQYANUFSCFGU6WSWYNFYYIL\",\"height\":2560}},\"placeholder_image\":{\"data\":{\"placeholder\":true,\"url\":\"\\/images\\/commerce\\/store-app\\/app\\/universal_product_placeholder.png\",\"absolute_url\":\"cdn3.editmysite.com\\/images\\/commerce\\/store-app\\/app\\/universal_product_placeholder.png\"}},\"categoryIds\":[\"E7W3YHMEUHTYJSIMKNDXCKU6\",\"TOFLKA6UL3EFAB34XPNHARQJ\",\"2\"]},{\"id\":\"J7XTWM6RSS7NSH3LKWPBQJSY\",\"owner_id\":\"143854010\",\"merchant_id\":\"MLKB93FPT91XW\",\"site_id\":\"331421882896289726\",\"channel_id\":\"CH_0abDwIQlE19tArq0hghQ3f4FDkJ7AiSj0MtfYRlQuYC\",\"site_product_id\":\"J7XTWM6RSS7NSH3LKWPBQJSY\",\"square_id\":\"J7XTWM6RSS7NSH3LKWPBQJSY\",\"visibility\":\"visible\",\"visibility_tl\":\"Visible\",\"name\":\"1 June |  Musical Moments\",\"short_description\":\"<p>Musical Moments is hosted by Ognisko Polskie (Polish Hearth) together with Trinity Laban Conservatoire of Music &amp; Dance, and follows the same format each time. Welcome drinks are served in the Members\\u2019 Room from 7 pm, the concert begins at 7.30 pm, and is followed by a Buffet Supper prepared by Ognisko Restaurant.<\\/p><p>The Holt\\u00e1g Quartet is a newly formed string quartet comprising students from Trinity Laban Conservatoire. Since their debut, performing works by Haydn, Beethoven and Glass, they have gone on to explore repertoire by Vaughan Williams, Maconchy, and Bridge. The quartet were finalists in the 2025 Cavatina Intercollegiate Competition at Wigmore Hall and were awarded the Sir John Barbirolli Prize for String Quartets at Trinity Laban, and made their debut on BBC Radio 3 In Tune. The group are currently the piloting the Centre for Ensemble Excellence chamber music course at Trinity Laban.<\\/p><p>Holt\\u00e1g String Quartet<\\/p><p>Vir\\u00e1g Hevizi violin<\\/p><p>Paris Rizas Pintzopoulos violin<\\/p><p>Ivan Illingworth viola\\u00a0\\u00a0<\\/p><p>Morgan Key cello<\\/p><p><br><\\/p><p>\\u00a0Programme includes<\\/p><p>Kod\\u00e1ly String Quartet No. 2, Op. 10 \\u00a0 (18\\u2019)<\\/p><p>Ravel\\u00a0 String Quartet in F major, M.35 \\u00a0 (30\\u2019)\\u00a0<\\/p><p><br><\\/p>\",\"popularity_score\":0.69,\"cross_sell_product_ids\":[],\"variation_type\":\"3\",\"product_type\":\"event\",\"product_type_details\":{\"location_name\":\"\",\"location_types\":[\"IN_PERSON\"],\"address\":{\"city\":\"LONDON\",\"country_code\":\"GB\",\"postal_code\":\"SW7 2PN\",\"region_code\":\"ENG\",\"street\":\"Ognisko Polskie\",\"street2\":\"55 Princes Gate, Exhibition Road\",\"region_code_cca2\":\"ENG\",\"region_code_full_name\":\"England\",\"country_code_cca2\":\"GB\",\"country_code_full_name\":\"United Kingdom\"},\"geocode\":{\"lat\":null,\"long\":null},\"start_date\":\"2026-06-01\",\"end_date\":\"2026-06-01\",\"start_time\":\"7:00 PM\",\"end_time\":\"10:00 PM\",\"timezone\":\"Europe\\/London\",\"timezone_info\":{\"name\":\"Europe\\/London\",\"current_time_2