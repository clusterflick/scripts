alse},\"fulfillment_availability\":{\"pickup\":[],\"delivery\":[],\"shipping\":[],\"dine_in\":[],\"manual\":[]},\"thumbnail\":{\"data\":{\"owner_id\":\"143854010\",\"format\":\"jpeg\",\"created_at\":\"2026-07-24T12:34:46.288Z\",\"absolute_url\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UAYTT6JXFK2N6DL3XLG7ETBE.jpeg\",\"absolute_urls\":{\"320\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UAYTT6JXFK2N6DL3XLG7ETBE.jpeg?width=320\",\"640\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UAYTT6JXFK2N6DL3XLG7ETBE.jpeg?width=640\",\"80\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UAYTT6JXFK2N6DL3XLG7ETBE.jpeg?width=80\",\"2560\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UAYTT6JXFK2N6DL3XLG7ETBE.jpeg?width=2560\",\"160\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UAYTT6JXFK2N6DL3XLG7ETBE.jpeg?width=160\",\"1280\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UAYTT6JXFK2N6DL3XLG7ETBE.jpeg?width=1280\"},\"url\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UAYTT6JXFK2N6DL3XLG7ETBE.jpeg\",\"urls\":{\"320\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UAYTT6JXFK2N6DL3XLG7ETBE.jpeg?width=320\",\"640\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UAYTT6JXFK2N6DL3XLG7ETBE.jpeg?width=640\",\"80\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UAYTT6JXFK2N6DL3XLG7ETBE.jpeg?width=80\",\"2560\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UAYTT6JXFK2N6DL3XLG7ETBE.jpeg?width=2560\",\"160\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UAYTT6JXFK2N6DL3XLG7ETBE.jpeg?width=160\",\"1280\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/UAYTT6JXFK2N6DL3XLG7ETBE.jpeg?width=1280\"},\"site_product_image_id\":\"UAYTT6JXFK2N6DL3XLG7ETBE\",\"updated_at\":\"2026-07-24T12:34:46.235Z\",\"site_id\":\"331421882896289726\",\"width\":2560,\"id\":\"UAYTT6JXFK2N6DL3XLG7ETBE\",\"height\":2560}},\"placeholder_image\":{\"data\":{\"placeholder\":true,\"url\":\"\\/images\\/commerce\\/store-app\\/app\\/universal_product_placeholder.png\",\"absolute_url\":\"cdn3.editmysite.com\\/images\\/commerce\\/store-app\\/app\\/universal_product_placeholder.png\"}},\"categoryIds\":[\"E7W3YHMEUHTYJSIMKNDXCKU6\",\"TOFLKA6UL3EFAB34XPNHARQJ\",\"2\"]},{\"id\":\"TCQS233O6EYKSPM2UE3MPR6T\",\"owner_id\":\"143854010\",\"merchant_id\":\"MLKB93FPT91XW\",\"site_id\":\"331421882896289726\",\"channel_id\":\"CH_0abDwIQlE19tArq0hghQ3f4FDkJ7AiSj0MtfYRlQuYC\",\"site_product_id\":\"TCQS233O6EYKSPM2UE3MPR6T\",\"square_id\":\"TCQS233O6EYKSPM2UE3MPR6T\",\"visibility\":\"visible\",\"visibility_tl\":\"Visible\",\"name\":\"1 Jul | A talk by:  Lieutenant Commander (Reserve) Bartosz Rutkowski\",\"short_description\":\"<p>The Lady Ryder of Warsaw Memorial Trust\\u2019s Annual lecture will be on the subject of humanitarian work, presented by Lieutenant Commander (Reserve) Bartosz Rutkowski. Sue Ryder was a British volunteer with Special Operations Executive in the Second World War, and established numerous charitable organisations after the devastation of the Second World War.<\\/p><p><br><\\/p><p>Tickets: \\u00a35 (Ognisko Polskie Members &amp; guests of Lady Ryder of Warsaw Memorial Trust - free)<\\/p><p>Tickets must be registered to attend this event<\\/p><p>the talk will be followed by a glass of wine and cocktail snacks<\\/p><p><br><\\/p><p><strong><em>Lieutenant Commander (Reserve) Bartosz Rutkowski, founder of the Eaglewatch Foundation<\\/em><\\/strong><\\/p><p><em>Before founding the Eaglewatch Foundation, Bartosz Rutkowski served as the chief training officer at the Polish Armed Forces\\u2019 Military Diving Training Center in Gdynia.<\\/em><\\/p><p><br><\\/p><p><em>In October 2015, while still on active duty, he read an article about a 12-year-old boy who was tortured and crucified by ISIS. He thought about his own two sons, the older of whom was the same age as the murdered boy. At that very moment, he asked himself if he could do something to save at least one child from a similar fate. As he recalls: \\u201cI was fed up with hearing that nothing could be done.\\u201d After a moment of reflection, he made a decision that completely changed his life. He resigned from the army on an expedited basis, and in February 2016 he went to Iraq.<\\/em><\\/p><p><br><\\/p><p><em>While on the ground, he wanted to personally assess the needs of people affected by the attacks and determine the best ways to provide help. During his first visit to Iraq, he lived with refugees who told him about the horrors they had experienced. He spoke with women who had been held captive by the terrorists, and with families who had lost their relatives and had been forced to flee their homes. After everything he heard and saw, Bartosz decided to establish the Eaglewatch Foundation, with the aim of helping the victims of war and terrorism return to normal life.<\\/em><\\/p><p><br><\\/p><p><strong>Lady Sue Ryder<\\/strong>\\u00a0<\\/p><p>Margaret Susan Cheshire, Baroness Ryder of Warsaw, Baroness Cheshire, CMG, OBE (3 July 1924 - 2 November 2000), commonly known as Sue Ryder, was a British volunteer with Special Operations Executive in the Second World War, and a member of the First Aid Nursing Yeomanry, who afterwards established charitable organisations\\u00a0<\\/p><p>After the war, Ryder volunteered to do relief work in Europe, initially with the Amis Volontaires Fran\\u00e7ais, the Red Cross and the Guide International Service. Her association with SOE made initial service in Poland difficult but she persevered, much affected by her time spent with various Polish forces. Official relief organisations had withdrawn by 1952, and Ryder decided to stay on working alone, visiting prisons and hospitals.<\\/p><p>Sue Ryder became a household name in the UK in the 1950s thanks to the homes she founded and the help she gave to the survivors of the concentration camps, the disabled and anyone in need of long-term care who she brought to Britain. This work expanded to people living in Britain and was funded by various methods and in no small part by the well-known high street charity shops, which still operate today under her name.<\\/p><p>She was made a life peer on 31 January 1979, being created Baroness Ryder of Warsaw.<\\/p><p><br><\\/p><p><strong>Lady Ryder of Warsaw Memorial Trust<\\/strong><\\/p><p>The Lady Ryder of Warsaw Memorial Trust was set up by Baroness Ryder of Warsaw CMG OBE shortly before her death in 2000 so that her good works could continue.<\\/p><p>All of Sue Ryder\\u2019s work is a living memorial to all those millions who gave their lives during two World Wars in defence of human values, and to the countless others who are suffering and dying today as result of persecution.<\\/p><p>The Trust provides grants to organisations engaged in the relief of suffering, particularly including the support of charitable bodies established by Sue Ryder<\\/p><p>The Trust is also working with Bristol and Newcastle Universities to help train more doctors. Although medical students are eligible for grants and student loans whilst training, those who come from disadvantaged backgrounds often face financial difficulties and may even be put off starting such a course and career.<\\/p><p>The Lady Ryder of Warsaw Memorial Trust gave just over \\u00a350,000 to various charities to help with the Ukrainian refugee crisis.<\\/p>\",\"popularity_score\":0.73,\"cross_sell_product_ids\":[],\"variation_type\":\"3\",\"product_type\":\"event\",\"product_type_details\":{\"end_date\":\"2026-07-01\",\"start_time\":\"7:00 PM\",\"location_name\"