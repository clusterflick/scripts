\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/TS2YXN4GMYXBXRP7DFWJNIEN.jpeg?width=640\",\"80\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/TS2YXN4GMYXBXRP7DFWJNIEN.jpeg?width=80\",\"2560\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/TS2YXN4GMYXBXRP7DFWJNIEN.jpeg?width=2560\",\"160\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/TS2YXN4GMYXBXRP7DFWJNIEN.jpeg?width=160\",\"1280\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/TS2YXN4GMYXBXRP7DFWJNIEN.jpeg?width=1280\"},\"url\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/TS2YXN4GMYXBXRP7DFWJNIEN.jpeg\",\"urls\":{\"320\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/TS2YXN4GMYXBXRP7DFWJNIEN.jpeg?width=320\",\"640\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/TS2YXN4GMYXBXRP7DFWJNIEN.jpeg?width=640\",\"80\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/TS2YXN4GMYXBXRP7DFWJNIEN.jpeg?width=80\",\"2560\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/TS2YXN4GMYXBXRP7DFWJNIEN.jpeg?width=2560\",\"160\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/TS2YXN4GMYXBXRP7DFWJNIEN.jpeg?width=160\",\"1280\":\"https:\\/\\/143854010.cdn6.editmysite.com\\/uploads\\/1\\/4\\/3\\/8\\/143854010\\/TS2YXN4GMYXBXRP7DFWJNIEN.jpeg?width=1280\"},\"site_product_image_id\":\"TS2YXN4GMYXBXRP7DFWJNIEN\",\"updated_at\":\"2026-06-08T10:27:09.888Z\",\"site_id\":\"331421882896289726\",\"width\":2560,\"id\":\"TS2YXN4GMYXBXRP7DFWJNIEN\",\"height\":2560}},\"placeholder_image\":{\"data\":{\"placeholder\":true,\"url\":\"\\/images\\/commerce\\/store-app\\/app\\/universal_product_placeholder.png\",\"absolute_url\":\"cdn3.editmysite.com\\/images\\/commerce\\/store-app\\/app\\/universal_product_placeholder.png\"}},\"categoryIds\":[\"VB5BTC3FXXCEZZPYS6AJIDKL\"]},{\"id\":\"HCMWJIFAPXY335V2ZDTHHIZ2\",\"owner_id\":\"143854010\",\"merchant_id\":\"MLKB93FPT91XW\",\"site_id\":\"331421882896289726\",\"channel_id\":\"CH_0abDwIQlE19tArq0hghQ3f4FDkJ7AiSj0MtfYRlQuYC\",\"site_product_id\":\"HCMWJIFAPXY335V2ZDTHHIZ2\",\"square_id\":\"HCMWJIFAPXY335V2ZDTHHIZ2\",\"visibility\":\"visible\",\"visibility_tl\":\"Visible\",\"name\":\"29 May | An in-conversation event with Krzysztof Siwczyk\",\"short_description\":\"<p>An Evening with Krzysztof Siwczyk and Piotr Florczyk around the book \\u201cA Calligraphy of Days\\u201d<\\/p><p><br><\\/p><p>An evening with the author and the co-translator of \\u201cA Calligraphy of Days\\u201d, a poetry volume published by Seagull Books. Krzysztof and Piotr will discuss the book and their collaboration, they will also read extracts in Polish and in English.<\\/p><p><br><\\/p><p>Verses that oscillate between the turmoil of post-communist Eastern Europe to understated reflections on grief and mortality. The sixty-four poems in\\u00a0\\u201cA Calligraphy of Days\\u201d\\u00a0reflect Krzysztof Siwczyk\\u2019s wide-ranging and variegated style.<\\/p><p><br><\\/p><p>Born in 1977, Krzysztof Siwczyk has lived most of his life in the Silesian city of Gliwice. He is the author of 18 poetry collections as well as books of literaty criticism and essays. He is also an actor. In 1995, he became a wunderkind of the Polish poetry scene with his debut volume\\u00a0\\u201cWild Kids\\u201d, an edgy and unsentimental narrative of youthful tribulations and urban malaise during Poland\\u2019s transition from communism to capitalism. Siwczyk\\u2019s poems careen down the page at great speed, relying on clever turns of phrase or an idea that illuminates a larger meaning. As in calligraphy, a meandering subterranean process connects meaning and memory, thought and verse. Teased to the surface, words and images emerge in rapid, terse, and precise bursts.<\\/p><p>Throughout his career, Siwczyk has never ceased to challenge our sense of who we are\\u2014changing course multiple times in the process. Following several volumes full of expansive lines, his most recent works offer spare meditations on illness and grief. Clipped and understated, these post-Holocaust poems address our inability to speak of death and tragedy.<\\/p><p><br><\\/p><p>Piotr Florczyk is an award-winning poet, essayist, and translator. Among his two dozen publications are \\u201cDialogue and Influence: Essays on Polish and American Poets\\u201d and \\u201cSwimming Pool\\u201d (an Object Lessons title), which has recently been translated into Polish. This past April Seagull Books released his and Ilya Kaminsky\\u2019s essay collaboration, \\u201cWithin, Without: On Two Cities\\u201d. He teaches global literary studies at the University of Washington, Seattle, and lives with his family in Los Angeles.<\\/p><p>Please note this is a joint event with the Polish Cultural Institute. <\\/p>\",\"popularity_score\":0.73,\"cross_sell_product_ids\":[],\"variation_type\":\"3\",\"product_type\":\"event\",\"product_type_details\":{\"end_date\":\"2026-05-29\",\"start_time\":\"7:00 PM\",\"location_name\":\"\",\"address\":{\"country_code\":\"GB\",\"country_code_full_name\":\"United Kingdom\",\"city\":\"London\",\"street\":\"55 Exhibition Road\",\"country_code_cca2\":\"GB\",\"street2\":null,\"postal_code\":\"SW7 2PN\",\"region_code_full_name\":\"London\",\"region_code\":\"London\",\"region_code_cca2\":\"London\"},\"timezone_info\":{\"utc_offset_string\":\"+01:00\",\"name\":\"Europe\\/London\",\"utc_offset_minutes\":60,\"current_time_24_format\":\"13:55\"},\"location_types\":[\"IN_PERSON\"],\"timezone\":\"Europe\\/London\",\"join_event_online_link\":\"\",\"geocode\":{\"lat\":null,\"long\":null},\"end_time\":\"11:00 PM\",\"has_no_end_time\":\"0\",\"start_date\":\"2026-05-29\"},\"taxable\":null,\"required_feature_to_sell\":null,\"min_prep_time\