          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-12-05\",\"showtimes\":[{\"id\":\"VIC1-90323\",\"schedule\":{\"businessDate\":\"2026-12-05\",\"startsAt\":\"2026-12-05T17:00:00+00:00\",\"endsAt\":\"2026-12-05T20:54:00+00:00\",\"filmStartsAt\":\"2026-12-05T17:00:00+00:00\",\"filmEndsAt\":\"2026-12-05T20:54:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-5-11\",\"filmId\":\"HO00007137\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-5\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976005554199,\"longitude\":-0.13680000603199},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"VIC1@curzon.com\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":true,\"allowedItemDeliveryMethods\":[\"CounterPickup\",\"ElectronicDelivery\",\"PostalDelivery\"]}],\"films\":[{\"id\":\"HO00007137\",\"title\":{\"text\":\"Met Opera 2026-27: Samson et Dalila\",\"translations\":[]},\"synopsis\":{\"text\":\"Saint-Saëns’s spectacular take on the biblical hero of legendary strength and the seductive Philistine whose beauty overpowers him returns in the Met’s larger-than-life production. Featuring a massive orchestra and chorus and some of opera’s most spellbinding tunes, this masterpiece is a feast for the eyes and ears. Giacomo Sagripanti conducts an electrifying cast led by the formidable star pairing of mezzo-soprano Aigul Akhmetshina and tenor Clay Hilley, broadcast live to cinemas worldwide.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Saint-Saëns’s spectacular take on the biblical hero of legendary strength and the seductive Philistine whose beauty overpowers him returns in the Met’s larger-than-life\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-12-05\",\"runtimeInMinutes\":234,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000917\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000298\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000543\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000768\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000769\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000770\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000917\"},{\"castAndCrewMemberId\":\"0000001576\"},{\"castAndCrewMemberId\":\"HO00000298\"},{\"castAndCrewMemberId\":\"HO00000543\"},{\"castAndCrewMemberId\":\"HO00000768\"},{\"castAndCrewMemberId\":\"HO00000769\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000000920\"}],\"producers\":[{\"castAndCrewMemberId\":\"HO00000770\"}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"95312d93-a009-4b83-906c-7c9079bfc829\",\"corporateId\":null},\"hopk\":\"HO00007137\",\"hoCode\":\"A000008788\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000917\",\"name\":{\"givenName\":\"Alfred\",\"familyName\":\"Walker\",\"middleName\":null}},{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000001576\",\"name\":{\"givenName\":\"Quinn\",\"familyName\":\"Kelsey\",\"middleName\":null}},{\"id\":\"HO00000298\",\"name\":{\"givenName\":\"Aigul\",\"familyName\":\"Akhmetshina\",\"middleName\":null}},{\"id\":\"HO00000543\",\"name\":{\"givenName\":\"Morris\",\"familyName\":\"Robinson\",\"middleName\":null}},{\"id\":\"HO00000768\",\"name\":{\"givenName\":\"Giacomo\",\"familyName\":\"Sagripanti\",\"middleName\":null}},{\"id\":\"HO00000769\",\"name\":{\"givenName\":\"Clay\",\"familyName\":\"Hilley\",\"middleName\":null}},{\"id\":\"HO00000770\",\"name\":{\"givenName\":\"Darko\",\"familyName\":\"Tresnjak\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000010\",\"name\":{\"text\":\"Satellite Event\",\"translations\":[]},\"shortName\":{\"text\":\"Sat event\",\"translations\":[]},\"description\":{\"text\":\"Live Via Satellite\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"VIC1-5\",\"name\":{\"text\":\"Screen 5\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000043\",\"name\":{\"text\":\"THE MET: LIVE IN HD\",\"translations\":[]},\"shortName\":{\"text\":\"THE MET\",\"translations\":[]},\"description\":{\"text\":\"The Met Opera returns to Curzon featuring performances transmitted live from the New York stage to cinemas worldwide.\",\"translations\":[]},\"schedule\":{\"startDate\":\"2025-10-18\",\"endDate\":\"2027-12-31\"},\"siteIds\":[\"BLO1\",\"CAM1\",\"CAN2\",\"COL1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"VIC1\",\"WIM1\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"VIC1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
