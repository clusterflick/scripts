\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976005554199,\"longitude\":-0.13680000603199},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"VIC1@curzon.com\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":true,\"allowedItemDeliveryMethods\":[\"CounterPickup\",\"ElectronicDelivery\",\"PostalDelivery\"]}],\"films\":[{\"id\":\"HO00006909\",\"title\":{\"text\":\"The Devil Wears Prada 2\",\"translations\":[]},\"synopsis\":{\"text\":\"Twenty years after making their iconic turns as Miranda, Andy, Emily and Nigel—Meryl Streep, Anne Hathaway, Emily Blunt and Stanley Tucci return to the fashionable streets of New York City and the sleek offices of Runway Magazine in 20th Century Studios’ “The Devil Wears Prada 2,” the eagerly awaited sequel to the 2006 phenomenon that defined a generation. The film is directed by David Frankel, written by Aline Brosh McKenna, produced by Wendy Finerman, and executive produced by Michael Bederman, Karen Rosenfelt and Aline Brosh McKenna. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Twenty years after making their iconic turns as Miranda, Andy, Emily and Nigel—Meryl Streep, Anne Hathaway, Emily Blunt and Stanley Tucci return to the fashionable street\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-05-01\",\"runtimeInMinutes\":119,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/2f8e91fc-f1ef-42d9-b846-6f9157e62a6b/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=gFJIo2aoP24\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=gFJIo2aoP24\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000341\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000417\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004443\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009402\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013582\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000370\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000341\"},{\"castAndCrewMemberId\":\"0000000417\"},{\"castAndCrewMemberId\":\"0000004443\"},{\"castAndCrewMemberId\":\"HO00000370\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000013582\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000009402\"}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"2f8e91fc-f1ef-42d9-b846-6f9157e62a6b\",\"corporateId\":null},\"hopk\":\"HO00006909\",\"hoCode\":\"A000008520\",\"eventId\":null,\"distributorName\":\"Walt Disney Studios Motion Pictures - UK\"},{\"id\":\"HO00006931\",\"title\":{\"text\":\"Disclosure Day\",\"translations\":[]},\"synopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming close to … Disclosure Day.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-10\",\"runtimeInMinutes\":145,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/920be864-1bc7-4cfd-aa64-b828b3c90b38/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=pFz8czbdPdU\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=pFz8czbdPdU\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000341\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001072\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002138\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000002139\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008293\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013627\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000341\"},{\"castAndCrewMemberId\":\"0000000418\"},{\"castAndCrewMemberId\":\"0000001072\"},{\"castAndCrewMemberId\":\"0000008293\"},{\"castAndCrewMemberId\":\"0000013627\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000002138\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000002138\"},{\"castAndCrewMemberId\":\"0000002139\"}],\"genreIds\":[\"0000000035\"],\"externalIds\":{\"moviexchangeReleaseId\":\"920be864-1bc7-4cfd-aa64-b828b3c90b38\",\"corporateId\":null},\"hopk\":\"HO00006931\",\"hoCode\":\"A000008544\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00007012\",\"title\":{\"text\":\"Moana\",\"translations\":[]},\"synopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyages beyond the reef of her island of Motunui with the infamous demigod Maui (Dwayne Johnson) on an unforgettable journey to restore prosperity to her people. The film is directed by Emmy® and Tony Award® winner Thomas Kail (“Hamilton”); produced by Dwayne Johnson, Dany Garcia, Beau Flynn, Hiram Garcia and Lin-Manuel Miranda; and executive produced by Thomas Kail, Scott Sheldon, Charles Newirth and Auliʻi Cravalho, who voiced Moana in the animated features “Moana” and “Moana 2.”\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyage\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":120,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/a7437e11-b6d4-476f-89ac-5a3a2ee813c8/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=JnficPHHF2U\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=JnficPHHF2U\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000371\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001009\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001016\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001017\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001018\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000007576\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011016\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011017\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011018\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011019\",\"roles\":[\"Director\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001009\"},{\"castAndCrewMemberId\":\"0000007576\"},{\"castAndCrewMemberId\":\"0000011016\"},{\"castAndCrewMemberId\":\"0000011017\"},{\"castAndCrewMemberId\":\"0000011018\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000011019\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000000371\"},{\"castAndCrewMemberId\":\"0000001009\"},{\"castAndCrewMemberId\":\"0000001016\"},{\"castAndCrewMemberId\":\"0000001017\"},{\"castAndCrewMemberId\":\"0000001018\"}],\"genreIds\":[\"0000000003\",\"0000000007\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a7437e11-b6d4-476f-89ac-5a3a2ee813c8\",\"corporateId\":null},\"hopk\":\"HO00007012\",\"hoCode\":\"A000008640\",\"eventId\":null,\"distributorName\":\"Walt Disney Studios Motion Pictures - UK\"},{\"id\":\"HO00007147\",\"title\":{\"text\":\"The Invite\",\"translations\":[]},\"synopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \\nHave they reignited the spark or lit the match that burns it all down?\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"very strong language, strong sex references, drug misuse\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":106,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/ad147b9a-b731-410f-8bf9-c4f3f3df2095/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=jnLW-q2ftKA\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=jnLW-q2ftKA\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001093\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002460\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003915\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"0000004392\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004710\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007157\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000013073\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014130\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000002460\"},{\"castAndCrewMemberId\":\"0000003915\"},{\"castAndCrewMemberId\":\"0000004392\"},{\"castAndCrewMemberId\":\"0000004710\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000003915\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000001093\"},{\"castAndCrewMemberId\":\"0000007157\"},{\"castAndCrewMemberId\":\"0000013073\"},{\"castAndCrewMemberId\":\"0000014130\"}],\"genreIds\":[\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ad147b9a-b731-410f-8bf9-c4f3f3df2095\",\"corporateId\":null},\"hopk\":\"HO00007147\",\"hoCode\":\"A000008799\",\"eventId\":null,\"distributorName\":\"Black Bear\"},{\"id\":\"HO00007150\",\"title\":{\"text\":\"Evil Dead Burn\",\"translations\":[]},\"synopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. After the loss of her husband, a woman seeks solace with her in-laws in their secluded family home. As one by one they are transformed into Deadites—turning the gathering into a family reunion from hell—she comes to discover that the vows she took in life... live on even in death.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. \",\"translations\":[]},\"censorRatingId\":\"HO00000005\",\"censorRatingNote\":{\"text\":\"strong bloody violence, gore\",\"translations\":[]},\"releaseDate\":\"2026-07-09\",\"runtimeInMinutes\":109,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/c9c67d5b-8833-464f-9feb-ed29fa1c8db9/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=YYkUkyfjUKg\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=YYkUkyfjUKg\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003073\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005228\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008019\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014136\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014137\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014138\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014139\",\"roles\":[\"Producer\"]}],\"actors\