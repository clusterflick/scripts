            "text": "{\"businessDate\":\"2027-05-25\",\"showtimes\":[{\"id\":\"VIC1-90314\",\"schedule\":{\"businessDate\":\"2027-05-25\",\"startsAt\":\"2027-05-25T19:15:00+01:00\",\"endsAt\":\"2027-05-25T22:05:00+01:00\",\"filmStartsAt\":\"2027-05-25T19:15:00+01:00\",\"filmEndsAt\":\"2027-05-25T22:05:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-2-8\",\"filmId\":\"HO00007130\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-2\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976005554199,\"longitude\":-0.13680000603199},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"VIC1@curzon.com\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":true,\"allowedItemDeliveryMethods\":[\"CounterPickup\",\"ElectronicDelivery\",\"PostalDelivery\"]}],\"films\":[{\"id\":\"HO00007130\",\"title\":{\"text\":\"RBO Cinema Season 2026-27: Romeo and Juliet\",\"translations\":[]},\"synopsis\":{\"text\":\"The Capulets and Montagues are sworn enemies. Yet it is love at first sight for Romeo Montague and Juliet Capulet when they meet each other at the Capulet ball, into which Romeo has snuck. The two fall in love and they profess their devotion to each other at Juliet’s balcony. They secretly get married.   \\nThe stakes are raised for the young couple when Romeo avenges the death of his friend Mercutio who has been killed by Tybalt, Juliet’s cousin. For this, Romeo is exiled from Verona. Meanwhile, Juliet’s parents are forcing her to marry another suitor. In order to be together, Romeo and Juliet must risk it all. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The Capulets and Montagues are sworn enemies. Yet it is love at first sight for Romeo Montague and Juliet Capulet when they meet each other at the Capulet ball\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2027-05-25\",\"runtimeInMinutes\":170,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003512\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011529\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3641\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3645\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"9291\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000291\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000754\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000755\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000756\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000757\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000758\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000759\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000760\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000003512\"},{\"castAndCrewMemberId\":\"0000011529\"},{\"castAndCrewMemberId\":\"3641\"},{\"castAndCrewMemberId\":\"3645\"},{\"castAndCrewMemberId\":\"9291\"},{\"castAndCrewMemberId\":\"HO00000291\"},{\"castAndCrewMemberId\":\"HO00000754\"},{\"castAndCrewMemberId\":\"HO00000755\"},{\"castAndCrewMemberId\":\"HO00000756\"},{\"castAndCrewMemberId\":\"HO00000757\"},{\"castAndCrewMemberId\":\"HO00000758\"},{\"castAndCrewMemberId\":\"HO00000759\"},{\"castAndCrewMemberId\":\"HO00000760\"}],\"directors\":[],\"producers\":[],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"ec9f8503-b0f5-45d4-99b6-b785760f5313\",\"corporateId\":null},\"hopk\":\"HO00007130\",\"hoCode\":\"A000008781\",\"eventId\":null,\"distributorName\":\