          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-11-10\",\"showtimes\":[{\"id\":\"VIC1-90300\",\"schedule\":{\"businessDate\":\"2026-11-10\",\"startsAt\":\"2026-11-10T19:00:00+00:00\",\"endsAt\":\"2026-11-10T22:35:00+00:00\",\"filmStartsAt\":\"2026-11-10T19:00:00+00:00\",\"filmEndsAt\":\"2026-11-10T22:35:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-2-8\",\"filmId\":\"HO00007122\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-2\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976005554199,\"longitude\":-0.13680000603199},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"VIC1@curzon.com\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":true,\"allowedItemDeliveryMethods\":[\"CounterPickup\",\"ElectronicDelivery\",\"PostalDelivery\"]}],\"films\":[{\"id\":\"HO00007122\",\"title\":{\"text\":\"RBO Cinema Season 2026-27: Carmen\",\"translations\":[]},\"synopsis\":{\"text\":\"Under the oppressive heat of the Spanish sun, the fiercely independent Carmen attracts the attention of Don José. She warns him not to fall in love with her, but his obsession knows no bounds. Damiano Michieletto’s searing production returns, casting scorching light on the lust, violence and destructive desire of Bizet’s ever-popular opera. \\nAn all-star cast brings this white-hot drama to life, with Ginger Costa-Jackson in the fiery title role, alongside Russell Thomas as the jealous and despairing Don José. Following his 2023 Royal Opera debut, Sesto Quatrini returns to conduct Bizet’s electrifying and sensual score.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Under the oppressive heat of the Spanish sun, the fiercely independent Carmen attracts the attention of Don José. She warns him not to fall in love with her\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-11-10\",\"runtimeInMinutes\":215,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000922\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014096\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014097\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014098\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000379\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000601\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000922\"},{\"castAndCrewMemberId\":\"0000014096\"},{\"castAndCrewMemberId\":\"0000014097\"},{\"castAndCrewMemberId\":\"0000014098\"},{\"castAndCrewMemberId\":\"HO00000601\"}],\"directors\":[{\"castAndCrewMemberId\":\"HO00000379\"}],\"producers\":[],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"f7e080d9-f84e-45f2-898b-630570ea943a\",\"corporateId\":null},\"hopk\":\"HO00007122\",\"hoCode\":\"A000008773\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000922\",\"name\":{\"givenName\":\"Alexander \",\"familyName\":\"Vinogradov\",\"middleName\":null}},{\"id\":\"0000014096\",\"name\":{\"givenName\":\"Ginger\",\"familyName\":\"Costa-Jackson\",\"middleName\":null}},{\"id\":\"0000014097\",\"name\":{\"givenName\":\"Russell\",\"familyName\":\"Thomas\",\"middleName\":null}},{\"id\":\"0000014098\",\"name\":{\"givenName\":\"Adriana\",\"familyName\":\"González\",\"middleName\":null}},{\"id\":\"HO00000379\",\"name\":{\"givenName\":\"Damiano \",\"familyName\":\"Michieletto\",\"middleName\":null}},{\"id\":\"HO00000601\",\"name\":{\"givenName\":\"Barnaby\",\"familyName\":\"Rea\",\"middleName\":n