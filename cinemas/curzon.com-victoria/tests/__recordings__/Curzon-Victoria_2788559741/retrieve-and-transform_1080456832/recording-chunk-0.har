"translations\":[]},\"shortSynopsis\":{\"text\":\"At a cosy Christmas party, young Clara meets the mysterious magician Drosselmeyer, who gives her a nutcracker doll. \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-12-01\",\"runtimeInMinutes\":140,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011530\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3643\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3646\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000732\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000733\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000011530\"},{\"castAndCrewMemberId\":\"3643\"},{\"castAndCrewMemberId\":\"3646\"},{\"castAndCrewMemberId\":\"HO00000732\"},{\"castAndCrewMemberId\":\"HO00000733\"}],\"directors\":[],\"producers\":[],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"cf10965f-7f6b-4fc9-82bb-c7433bd1a7de\",\"corporateId\":null},\"hopk\":\"HO00007123\",\"hoCode\":\"A000008774\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000011530\",\"name\":{\"givenName\":\"James\",\"familyName\":\"Hay\",\"middleName\":null}},{\"id\":\"3643\",\"name\":{\"givenName\":\"Reece\",\"familyName\":\"Clarke\",\"middleName\":null}},{\"id\":\"3646\",\"name\":{\"givenName\":\"Mayara\",\"familyName\":\"Magri\",\"middleName\":null}},{\"id\":\"HO00000732\",\"name\":{\"givenName\":\"Marianna\",\"familyName\":\"Tsembenhoi\",\"middleName\":null}},{\"id\":\"HO00000733\",\"name\":{\"givenName\":\"Taisuke\",\"familyName\":\"Nakao\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescrip