          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2027-04-25\",\"showtimes\":[{\"id\":\"VIC1-90311\",\"schedule\":{\"businessDate\":\"2027-04-25\",\"startsAt\":\"2027-04-25T14:00:00+01:00\",\"endsAt\":\"2027-04-25T17:25:00+01:00\",\"filmStartsAt\":\"2027-04-25T14:00:00+01:00\",\"filmEndsAt\":\"2027-04-25T17:25:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-5-11\",\"filmId\":\"HO00007128\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-5\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976005554199,\"longitude\":-0.13680000603199},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"VIC1@curzon.com\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":true,\"allowedItemDeliveryMethods\":[\"CounterPickup\",\"ElectronicDelivery\",\"PostalDelivery\"]}],\"films\":[{\"id\":\"HO00007128\",\"title\":{\"text\":\"RBO Cinema Season 2026-27: Swan Lake\",\"translations\":[]},\"synopsis\":{\"text\":\"Princess Odette is bound by a curse, turned into a swan by the evil sorcerer Von Rothbart. The spell can only be broken by a pledge of eternal love. When she meets Prince Siegfried, he is immediately enamoured by her fragile beauty and pledges to free her. But freedom is not promised for Odette as Von Rothbart conspires to thwart the lovers’ plans.\\nLiam Scarlett’s production for The Royal Ballet brings together Tchaikovsky’s towering score and John Macfarlane’s picturesque designs to create an enduring ballet spectacle of love, treachery and forgiveness.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Princess Odette is bound by a curse, turned into a swan by the evil sorcerer Von Rothbart. The spell can only be broken by a pledge of eternal love.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2027-04-22\",\"runtimeInMinutes\":205,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001487\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"14203\",\"roles\":[\"Director\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001487\"}],\"directors\":[{\"castAndCrewMemberId\":\"14203\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000001487\"}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"16fcd6d8-a31d-4aca-91a9-448cbecba588\",\"corporateId\":null},\"hopk\":\"HO00007128\",\"hoCode\":\"A000008779\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000001487\",\"name\":{\"givenName\":\"The Royal \",\"familyName\":\"Ballet\",\"middleName\":null}},{\"id\":\"14203\",\"name\":{\"givenName\":\"Koen\",\"familyName\":\"Kessels\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000010\",\"name\":{\"text\":\"Satellite Event\",\"translations\":[]},\"shortName\":{\"text\":\"Sat event\",\"translations\":[]},\"description\":{\"text\":\"Live Via Satellite\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"VIC1-5\",\"name\":{\"text\":\"Screen 5\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"VIC1-0000000001\",\"name\":{\"text\":