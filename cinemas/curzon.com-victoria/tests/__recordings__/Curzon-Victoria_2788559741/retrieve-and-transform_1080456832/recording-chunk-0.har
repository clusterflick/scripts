          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-04-02\",\"showtimes\":[{\"id\":\"VIC1-87576\",\"schedule\":{\"businessDate\":\"2026-04-02\",\"startsAt\":\"2026-04-02T18:00:00+01:00\",\"endsAt\":\"2026-04-02T19:44:00+01:00\",\"filmStartsAt\":\"2026-04-02T18:25:00+01:00\",\"filmEndsAt\":\"2026-04-02T19:44:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-4-14\",\"filmId\":\"HO00006797\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-4\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976,\"longitude\":-0.1368},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006797\",\"title\":{\"text\":\"Film Club: Dreamers\",\"translations\":[]},\"synopsis\":{\"text\":\"After fleeing home, Nigerian migrant Isio (Ronk\u1eb9 Ad\u00e9k\u1ecdlu\u1eb9\u0301j\u1ecd\u0301) is sent to Hatchworth Removal Centre, where she hopes her asylum plea will receive a fair hearing. Isio believes the only way out is to play by the rules, convinced that presenting the truth about the homophobic persecution she experienced will secure her freedom. Her charismatic new roommate, Farah (Ann Akinjirin), warns her otherwise, having lost faith in a system she knows is stacked against them. \\n\\nDespite their differing outlooks, within the confines of detention Farah\u2019s friendship brings colour to Isio\u2019s world. As days turn into weeks, the two women form an unexpected bond that blossoms into romance, offering them reason to hope despite the waiting. But with Isio\u2019s case lingering in limbo and Farah\u2019s own appeals running out, the threat of separation grows ever closer. Isio must decide whether to continue trusting in a broken system that threatens to tear them apart or dare to follow Farah into a risky plan that could cost them everything.\\n\\nAcclaimed producer Joy Gharoro-Akpojotor\u2019s (Blue Story, Boxing Day) visually bold and deeply moving directorial debut is a tender story of defiance, which insists that love can endure even in the most hostile places.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In a UK immigration removal centre, Nigerian migrant Isio finds hope in an unexpected love that gives her the strength to fight a broken system.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong sex\",\"translations\":[]},\"releaseDate\":\"2026-03-04\",\"runtimeInMinutes\":79,\"trailerUrl\":\"https://www.youtube.com/watch?v=P68gG8qQCEw\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000425\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006002\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012631\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012632\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012633\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012634\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012635\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012636\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012637\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012638\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012639\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006797\",\"hoCode\":\"A000008386\",\"eventId\":null,\"distributorName\":\"We Are Parable\"}],\"castAndCrew\":[{\"id\":\"0000000425\",\"name\":{\"givenName\":\"Emily \",\"familyName\":\"Morgan\",\"middleName\":null}},{\"id\":\"0000006002\",\"name\":{\"givenName\":\"Ronk\u1eb9\",\"familyName\":\"Ad\u00e9kolu\u1eb9jo\",\"middleName\":null}},{\"id\":\"0000012631\",\"name\":{\"givenName\":\"Harriet\",\"familyName\":\"Webb\",\"middleName\":null}},{\"id\":\"0000012632\",\"name\":{\"givenName\":\"Ann\",\"familyName\":\"Akinjirin\",\"middleName\":null}},{\"id\":\"0000012633\",\"name\":{\"givenName\":\"Diana\",\"familyName\":\"Yekinni\",\"middleName\":null}},{\"id\":\"0000012634\",\"name\":{\"givenName\":\"Aiysha\",\"familyName\":\"Hart\",\"middleName\":null}},{\"id\":\"0000012635\",\"name\":{\"givenName\":\"Lucy\",\"familyName\":\"Ware\",\"middleName\":null}},{\"id\":\"0000012636\",\"name\":{\"givenName\":\"Marcy\",\"familyName\":\"Dolapo Oni\",\"middleName\":null}},{\"id\":\"0000012637\",\"name\":{\"givenName\":\"Kemi\",\"familyName\":\"Adekoya\",\"middleName\":null}},{\"id\":\"0000012638\",\"name\":{\"givenName\":\"Antonia\",\"familyName\":\"Layiwola\",\"middleName\":null}},{\"id\":\"0000012639\",\"name\":{\"givenName\":\"Joy\",\"familyName\":\"Gharoro-Akpojotor\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000002\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":{\"text\":\"Drama\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"HO00000006\",\"classification\":{\"text\":\"15\",\"translations\":[]},\"classificationDescription\":{\"text\":\"15\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000053\",\"name\":{\"text\":\"Film Club\",\"translations\":[]},\"shortName\":{\"text\":\"Film Club\",\"translations\":[]},\"description\":{\"text\":\"Film Club Screening. Browse more at curzon.com/film-club\",\"translations\":[]},\"importantMessage\":{\"text\":\"Film Club Screening\",\"translations\":[]},\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"VIC1-4\",\"name\":{\"text\":\"Screen 4\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"VIC1-00000000