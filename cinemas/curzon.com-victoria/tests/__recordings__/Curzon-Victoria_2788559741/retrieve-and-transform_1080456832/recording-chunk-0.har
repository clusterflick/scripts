          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-04-16\",\"showtimes\":[{\"id\":\"VIC1-87304\",\"schedule\":{\"businessDate\":\"2026-04-16\",\"startsAt\":\"2026-04-16T18:00:00+01:00\",\"endsAt\":\"2026-04-16T20:25:00+01:00\",\"filmStartsAt\":\"2026-04-16T18:10:00+01:00\",\"filmEndsAt\":\"2026-04-16T20:25:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-2-8\",\"filmId\":\"HO00006787\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-2\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000031\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976,\"longitude\":-0.1368},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006787\",\"title\":{\"text\":\"NT Live: All My Sons\",\"translations\":[]},\"synopsis\":{\"text\":\"\\r\\nBryan Cranston (Breaking Bad) and Marianne Jean-Baptiste (Hard Truths) feature in a five-star, triumphantly acclaimed new production of Arthur Miller\u2019s classic play, from visionary director Ivo Van Hove (A View from the Bridge). \u00a0  One family, the heart of the American dream. When wartime delivers profits for Joe, it comes at a price when his partner is charged with criminal manufacturing deals, and his eldest son goes missing in action. Will peacetime bring peace of mind, or will he be confronted by the consequence of his actions? \u00a0  Filmed live from the West End, Paapa Essiedu (I May Destroy You), Tom Glynn-Carney (House of the Dragon), and Hayley Squires (I, Daniel Blake) also feature in this disturbingly prescient play.\u00a0\\r\\n\\r\\nCUSTOMER NOTICE: Please note that All My Sons contains strobe lighting, which may impact customers with photosensitive epilepsy. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Bryan Cranston and Marianne Jean-Baptiste feature in a five-star, triumphantly acclaimed new production of Arthur Miller\u2019s classic play. \u00a0\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-04-16\",\"runtimeInMinutes\":135,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000381\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003205\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003832\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007817\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013206\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"d330f82a-7d24-47b1-8400-ba9f05d687fe\",\"corporateId\":null},\"hopk\":\"HO00006787\",\"hoCode\":\"A000008372\",\"eventId\":null,\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"0000000381\",\"name\":{\"givenName\":\"Hayley\",\"familyName\":\"Squires\",\"middleName\":null}},{\"id\":\"0000003205\",\"name\":{\"givenName\":\"Paapa\",\"familyName\":\"Essiedu\",\"middleName\":null}},{\"id\":\"0000003832\",\"name\":{\"givenName\":\"Ivo\",\"familyName\":\"van Hove\",\"middleName\":null}},{\"id\":\"0000005698\",\"name\":{\"givenName\":\"Bryan\",\"familyName\":\"Cranston\",\"middleName\":null}},{\"id\":\"0000007817\",\"name\":{\"givenName\":\"Marianne\",\"familyName\":\"Jean-Baptiste\",\"middleName\":null}},{\"id\":\"0000013206\",\"name\":{\"givenName\":\"Tom\",\"familyName\":\"Glynn-Carney\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[],\"screens\":[{\"id\":\"VIC1-2\",\"name\":{\"text\":\"Screen 2\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000031\",\"name\":{\"text\":\"NT Live\",\"translations\":[]},\"shortName\":{\"text\":\"NT Live\",\"translations\":[]},\"description\":{\"text\":\"National Theatre Live brings the best of British theatre to cinema screens across the UK and around the world. With state-of-the-art filming techniques, tailored to every play, we bring you each performance as it happens, in all its glory. From close-ups that capture every flicker of emotion, to sweeping wide shots of the stage. Whether you come along to the live broadcast, or catch one of many replays, you\u2019ll have the best seats in the house.\",\"translations\":[]},\"schedule\":{\"startDate\":\"2024-01-01\",\"endDate\":\"2099-12-31\"},\"siteIds\":[\"ALD1\",\"BLO1\",\"CAM1\",\"CAN01\",\"CAN2\",\"COL1\",\"HOX1\",\"KIN1\",\"KNU1\",\"MAY1\",\"OXF1\",\"RIC1\",\"SHE1\",\"SOH1\",\"VIC1\",\"WIM01\"]}],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"VIC1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}",
