            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-06-25\",\"showtimes\":[{\"id\":\"VIC1-86450\",\"schedule\":{\"businessDate\":\"2026-06-25\",\"startsAt\":\"2026-06-25T19:00:00+01:00\",\"endsAt\":\"2026-06-25T22:10:00+01:00\",\"filmStartsAt\":\"2026-06-25T19:10:00+01:00\",\"filmEndsAt\":\"2026-06-25T22:10:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-2-8\",\"filmId\":\"HO00006721\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-2\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000031\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976,\"longitude\":-0.1368},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006721\",\"title\":{\"text\":\"NT Live: Les Liaisons Dangereuses\",\"translations\":[]},\"synopsis\":{\"text\":\"BAFTA Award-winner Lesley Manville (Phantom Thread) joins Aidan Turner (Rivals) in a striking new staging of Christopher Hampton\u2019s celebrated adaptation of the classic novel, where among the glittering salons of the super-rich, one misstep can mean ruin. Marquise de Merteuil is a master in the art of survival. Alongside the magnetic Vicomte de Valmont, they turn seduction into strategy and weaponise desire. But when their alliance collapses into rivalry, the battle between them threatens to destroy everyone in their path. Filmed live on stage at the National Theatre, Marianne Elliott (Angels in America) directs this thrilling game of love, lies, and social warfare.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Lesley Manville joins Aidan Turner in a striking new staging of Christop