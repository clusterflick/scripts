-discovery.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-04\",\"runtimeInMinutes\":180,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000006980\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012989\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012990\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012991\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"fd971138-54b5-41e0-8bfe-d35c799db276\",\"corporateId\":null},\"hopk\":\"HO00006720\",\"hoCode\":\"A000008293\",\"eventId\":\"0000000031\",\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"0000006980\",\"name\":{\"givenName\":\"Nicola\",\"familyName\":\"Coughlan\",\"middleName\":null}},{\"id\":\"0000012989\",\"name\":{\"givenName\":\"\u00c9anna\",\"familyName\":\"Hardwicke\",\"middleName\":null}},{\"id\":\"0000012990\",\"name\":{\"givenName\":\"Siobh\u00e1n\",\"familyName\":\"McSweeney\",\"middleName\":null}},{\"id\":\"0000012991\",\"name\":{\"givenName\":\"Caitr\u00edona\",\"familyName\":\"McLaughlin\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[],\"screens\":[{\"id\":\"VIC1-2\",\"name\":{\"text\":\"Screen 2\",\"translations\":[]}}],\"events\":[{\"id\":\"0000000031\",\"name\":{\"text\":\"NT Live\",\"translations\":[]},\"shortName\":{\"text\":\"NT Live\",\"translations\":[]},\"description\":{\"text\":\"National Theatre Live brings the best of British theatre to cinema screens across the UK and around the world. With state-of-the-art filming te