          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-03-31\",\"showtimes\":[{\"id\":\"VIC1-86692\",\"schedule\":{\"businessDate\":\"2026-03-31\",\"startsAt\":\"2026-03-31T11:00:00+01:00\",\"endsAt\":\"2026-03-31T12:45:00+01:00\",\"filmStartsAt\":\"2026-03-31T11:25:00+01:00\",\"filmEndsAt\":\"2026-03-31T12:45:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-3-9\",\"filmId\":\"HO00006736\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-3\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000048\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null},{\"id\":\"VIC1-81815\",\"schedule\":{\"businessDate\":\"2026-03-31\",\"startsAt\":\"2026-03-31T17:15:00+01:00\",\"endsAt\":\"2026-03-31T22:45:00+01:00\",\"filmStartsAt\":\"2026-03-31T17:15:00+01:00\",\"filmEndsAt\":\"2026-03-31T22:45:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-2-8\",\"filmId\":\"HO00006232\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-2\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000042\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976,\"longitude\":-0.1368},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006736\",\"title\":{\"text\":\"Strongroom\",\"translations\":[]},\"synopsis\":{\"text\":\"Taut as a drum, Vernon Sewell\u2019s rediscovered and remastered suspense thriller is an outstanding example of the lean British \u2018B\u2019 film, and counts the likes of Quentin Tarantino, Martin Scorsese and Edgar Wright amongst its fans.\\r\\n\\r\\nA carefully planned heist on a suburban bank goes awry, and the bank manager and his secretary are locked in an airtight vault. With only 12 hours\u2019 worth of air in the vault, the clock is ticking.\\r\\n\\r\\nSilver Screen: These screenings provide an inclusive and enjoyable cinema experience for senior citizens, where we will be showing classic films as well as recent releases.\",\"translations\":[]},\"shortSynopsis\":null,\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"2026-03-30\",\"runtimeInMinutes\":80,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006736\",\"hoCode\":\"A000008313\",\"eventId\":null,\"distributorName\":\"BAFTA\"},{\"id\":\"HO00006232\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: Siegfried\",\"translations\":[]},\"synopsis\":{\"text\":\"Raised by a scheming dwarf and unaware of his true family origins, a young man embarks on an epic journey. Soon, destiny brings him face-to-face with a shattered sword, a fearsome dragon and the cursed ring it guards, and a Valkyrie forced into enchanted slumber... \\nMoments of transcendent beauty and heroic triumph sparkle in the third chapter of Wagner\u2019s Ring cycle, brought to life under Barrie Kosky\u2019s inspired eye following his spectacular Das Rheingold (2023) and Die Walk\u00fcre (2025). Andreas Schager, in his much-anticipated debut with The Royal Opera, stars as Siegfried\u2019s titular hero, alongside Christopher Maltman\u2019s towering Wanderer, Peter Hoare\u2019s treacherous Mime and Elisabet Strid\u2019s radiant Br\u00fcnnhilde. Antonio Pappano conducts, drawing out the unspoken tensions and ethereal mysticism of Wagner\u2019s dynamic score.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Raised by a scheming dwarf and unaware of his true family origins, a young man embarks on an epic journey. \",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-03-31\",\"runtimeInMinutes\":330,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003814\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006115\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006116\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000286\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000490\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000606\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000607\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000608\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000609\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"0000526f-f09f-444c-9d66-e6ec960d9d6d\",\"corporateId\":null},\"hopk\":\"HO00006232\",\"hoCode\":\"A000007689\",\"eventId\":\"0000000042\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000003814\",\"name\":{\"givenName\":\"Christopher \",\"familyName\":\"Maltman\",\"middleName\":null}},{\"id\":\"0000006115\",\"name\":{\"givenName\":\"Christopher\",\"familyName\":\"Purves\",\"middleName\":null}},{\"id\":\"0000006116\",\"name\":{\"givenName\":\"Barrie\",\"familyName\":\"Kosky\",\"middleName\":null}},{\"id\":\"HO00000286\",\"name\":{\"givenName\":\"Soloman\",\"familyName\":\"Howard\",\"middleName\":null}},{\"id\":\"HO00000490\",\"name\":{\"givenName\":\"Elisabet\",\"familyName\":\"Strid\",\"middleName\":null}},{\"id\":\"HO00000606\",\"name\":{\"givenName\":\"Andreas\",\"familyName\":\"Schager\",\"middleName\":null}},{\"id\":\"HO00000607\",\"name\":{\"givenName\":\"Peter\",\"familyName\":\"Hoare\",\"middleName\":null}},{\"id\":\"HO00000608\",\"name\":{\"givenName\":\"Wiebke\",\"familyName\":\"Lehmkuhl\",\"middleName\":null}},{\"id\":\"HO00000609\",\"name\"