            "text": "{\"businessDate\":\"2027-03-28\",\"showtimes\":[{\"id\":\"VIC1-90309\",\"schedule\":{\"businessDate\":\"2027-03-28\",\"startsAt\":\"2027-03-28T14:00:00+01:00\",\"endsAt\":\"2027-03-28T16:50:00+01:00\",\"filmStartsAt\":\"2027-03-28T14:00:00+01:00\",\"filmEndsAt\":\"2027-03-28T16:50:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-5-11\",\"filmId\":\"HO00007127\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-5\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976005554199,\"longitude\":-0.13680000603199},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"VIC1@curzon.com\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":true,\"allowedItemDeliveryMethods\":[\"CounterPickup\",\"ElectronicDelivery\",\"PostalDelivery\"]}],\"films\":[{\"id\":\"HO00007127\",\"title\":{\"text\":\"RBO 2026-27: Alice's Adventures in Wonderland\",\"translations\":[]},\"synopsis\":{\"text\":\"At a garden party on a sunny afternoon, Alice is surprised to see her parents’ friend Lewis Carroll transform into a white rabbit. When she follows him down a rabbit hole, events become curiouser and curiouser…As Alice journeys through Wonderland, she encounters countless strange creatures. She’s swept off her feet by the charming Knave of Hearts, who’s on the run for stealing the tarts. Confusion piles upon confusion. Then Alice wakes with a start. Was it all a daydream? \\nChristopher Wheeldon’s Alice’s Adventures in Wonderland burst onto the stage in 2011 in an explosion of colour, stage magic and inventive, sophisticated choreography. Joby Talbot’s score combines contemporary soundworlds with sweeping melodies that gesture to ballet scores of the 19th century. Bob Crowley’s wildly imaginative, eye-popping designs draw on everything from puppetry to projections to make Wonderland wonderfully real. The result shows The Royal Ballet at its best, bringing together world-class dance with enchanting family entertainment and ingenious music and design.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"At a garden party on a sunny afternoon, Alice is surprised to see her parents’ friend Lewis Carroll transform into a white rabbit.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2027-03-23\",\"runtimeInMinutes\":170,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001507\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011529\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011530\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3642\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000290\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000293\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000748\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000749\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001507\"},{\"castAndCrewMemberId\":\"0000011529\"},{\"castAndCrewMemberId\":\"0000011530\"},{\"castAndCrewMemberId\":\"3642\"},{\"castAndCrewMemberId\":\"HO00000290\"},{\"castAndCrewMemberId\":\"HO00000293\"},{\"castAndCrewMemberId\":\"HO00000748\"},{\"castAndCrewMemberId\":\"HO00000749\"}],\"directors\":[],\"producers\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b7823ec2-abd4-49b8-876f-6a43fd49ccb0\",\"corporateId\":null},\"hopk\":\"HO00007127\",\"hoCode\":\"A000008778\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000001507\",\"name\":{\"