          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-03-14\",\"showtimes\":[{\"id\":\"VIC1-87575\",\"schedule\":{\"businessDate\":\"2026-03-14\",\"startsAt\":\"2026-03-14T15:00:00+00:00\",\"endsAt\":\"2026-03-14T16:59:00+00:00\",\"filmStartsAt\":\"2026-03-14T15:25:00+00:00\",\"filmEndsAt\":\"2026-03-14T16:59:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-2-8\",\"filmId\":\"HO00006802\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-2\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976,\"longitude\":-0.1368},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006802\",\"title\":{\"text\":\"Film Club: Lady Bird\",\"translations\":[]},\"synopsis\":{\"text\":\"In LADY BIRD, Greta Gerwig reveals herself to be a bold new cinematic voice with her directorial debut, excavating both the humor and pathos in the turbulent bond between a mother and her teenage daughter.  Christine \u201cLady Bird\u201d McPherson (Saoirse Ronan) fights against but is exactly like her wildly loving, deeply opinionated and strong-willed mom (Laurie Metcalf), a nurse working tirelessly to keep her family afloat after Lady Bird's father (Tracy Letts) loses his job.  Set in Sacramento, California in 2002, amidst a rapidly shifting American economic landscape, Lady Bird is an affecting look at the relationships that shape us, the beliefs that define us, and the unmatched beauty of a place called home.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In 2002, an artistically inclined seventeen-year-old girl comes of age in Sacramento, California.\\n\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"Very strong language, strong nudity\",\"translations\":[]},\"releaseDate\":\"2026-03-14\",\"runtimeInMinutes\":94,\"trailerUrl\":\"https://www.youtube.com/watch?v=GwuVX8PNtsc\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000034\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001403\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002090\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004112\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000007166\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013239\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013241\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000013242\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000002\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006802\",\"hoCode\":\"A000008392\",\"eventId\":null,\"distributorName\":\"Park Circus\"}],\"castAndCrew\":[{\"id\":\"0000000034\",\"name\":{\"givenName\":\"Greta\",\"familyName\":\"Gerwig\",\"middleName\":null}},{\"id\":\"0000001403\",\"name\":{\"givenName\":\"Timoth\u00e9e \",\"familyName\":\"Chalamet\",\"middleName\":null}},{\"id\":\"0000002090\",\"name\":{\"givenName\":\"Eli\",\"familyName\":\"Bush\",\"middleName\":null}},{\"id\":\"0000004112\",\"name\":{\"givenName\":\"Scott\",\"familyName\":\"Rudin\",\"middleName\":null}},{\"id\":\"0000007166\",\"name\":{\"givenName\":\"Tracy\",\"familyName\":\"Letts\",\"middleName\":null}},{\"id\":\"0000013239\",\"name\":{\"givenName\":\"Odeya\",\"familyName\":\"Rush\",\"middleName\":null}},{\"id\":\"0000013240\",\"name\":{\"givenName\":\"Jake\",\"familyName\":\"McDorman\",\"middleName\":null}},{\"id\":\