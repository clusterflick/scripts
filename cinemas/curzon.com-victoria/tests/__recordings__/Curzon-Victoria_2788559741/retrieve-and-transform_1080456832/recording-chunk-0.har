            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2027-04-24\",\"showtimes\":[{\"id\":\"VIC1-90327\",\"schedule\":{\"businessDate\":\"2027-04-24\",\"startsAt\":\"2027-04-24T18:00:00+01:00\",\"endsAt\":\"2027-04-24T21:21:00+01:00\",\"filmStartsAt\":\"2027-04-24T18:00:00+01:00\",\"filmEndsAt\":\"2027-04-24T21:21:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-5-11\",\"filmId\":\"HO00007135\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-5\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976005554199,\"longitude\":-0.13680000603199},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"VIC1@curzon.com\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":true,\"allowedItemDeliveryMethods\":[\"CounterPickup\",\"ElectronicDelivery\",\"PostalDelivery\"]}],\"films\":[{\"id\":\"HO00007135\",\"title\":{\"text\":\"Met Opera 2026-27: Otello\",\"translations\":[]},\"synopsis\":{\"text\":\"One of today’s leading dramatic tenors, Brian Jagde, takes on the tour-de-force title role of what many consider the ultimate Italian opera, live to cinemas worldwide. Verdi’s monumental Shakespearean tragedy also features soprano Ailyn Pérez in her company role debut as the long-suffering Desdemona, alongside baritone Artur Ruciński as the sinister Iago. Michele Mariotti leads the full forces of the Met Orchestra and Chorus in the exhilarating score.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"One of today’s leading dramatic tenors, Brian Jagde, takes on the tour-de-force title role of what many consider the ultimate Italian opera, live to cinemas worldwide.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2027-04-24\",\"runtimeInMinutes\":201,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001577\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003515\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000556\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000632\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000765\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000766\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000767\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000003515\"},{\"castAndCrewMemberId\":\"HO00000556\"},{\"castAndCrewMemberId\":\"HO00000632\"},{\"castAndCrewMemberId\":\"HO00000765\"},{\"castAndCrewMemberId\":\"HO00000766\"},{\"castAndCrewMemberId\":\"HO00000767\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000000920\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000001577\"}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"412247e7-cd25-4af1-937c-558a6f8592ec\",\"corporateId\":null},\"hopk\":\"HO00007135\",\"hoCode\":\"A000008786\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000001577\",\"name\":{\"givenName\":\"Bartlett\",\"familyName\":\"Sher\",\"middleName\":null}},{\"id\":\"0000003515\",\"name\":{\"givenName\":\"Ailyn\",\"familyName\":\"Pérez\",\"middleName\":null}},{\"id\":\"HO00000556\",\"name\":{\"givenName\":\"Piotr\",\"familyName\":\"Buszewski\",\"middleName\":null}},{\"id\":\"HO00000632\",\"name\":{\"givenName\":\"Artur\",\"familyName\":\"Ruciński\",\"middleName\":null}},{\"id\":\"HO00000765\",\"name\":{\"givenName\":\"Mic