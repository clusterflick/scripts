"],\"filmAdvanceBookingRuleId\":\"VIC1-131-HO00007158\"}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976005554199,\"longitude\":-0.13680000603199},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"VIC1@curzon.com\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":true,\"allowedItemDeliveryMethods\":[\"CounterPickup\",\"ElectronicDelivery\",\"PostalDelivery\"]}],\"films\":[{\"id\":\"HO00007158\",\"title\":{\"text\":\"Spider-Man: Brand New Day\",\"translations\":[]},\"synopsis\":{\"text\":\"It's a BRAND NEW DAY for Peter Parker. Fighting crime full-time as Spider-Man in a world that doesn’t remember him -- and the pressure of seeing his old friends move on without him -- sparks a change in Peter he may not have the power to control. But that transformation might also be the only thing that can stop a shocking new threat to the city and those he loves - a powerful villain no one can even see.\\n\\nThe world may have forgotten Peter Parker, but he hasn’t forgotten them.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It's a BRAND NEW DAY for Peter Parker. Fighting crime full-time as Spider-Man in a world that doesn’t remember him sparks a change he may not have the power to control.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-29\",\"runtimeInMinutes\":144,\"trailers\":[{\"provider\":\"Moviexchange\",\"uri\":\"https://film-cdn.moviexchange.com/api/cdn/release/d1ef6990-72ef-4f8a-9caf-103f84b2f6f2/media/TrailerVideo\"},{\"provider\":\"External\",\"uri\":\"https://www.youtube.com/watch?v=Q27BvUipKn8\"}],\"trailerUrl\":\"https://www.youtube.com/watch?v=Q27BvUipKn8\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000126\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000319\",\"roles\":[