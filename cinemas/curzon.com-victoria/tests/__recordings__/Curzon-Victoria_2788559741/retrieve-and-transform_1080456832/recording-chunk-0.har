          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-09-19\",\"showtimes\":[{\"id\":\"VIC1-90320\",\"schedule\":{\"businessDate\":\"2026-09-19\",\"startsAt\":\"2026-09-19T18:00:00+01:00\",\"endsAt\":\"2026-09-19T21:00:00+01:00\",\"filmStartsAt\":\"2026-09-19T18:00:00+01:00\",\"filmEndsAt\":\"2026-09-19T21:00:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-5-11\",\"filmId\":\"HO00007139\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-5\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976005554199,\"longitude\":-0.13680000603199},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"VIC1@curzon.com\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":true,\"allowedItemDeliveryMethods\":[\"CounterPickup\",\"ElectronicDelivery\",\"PostalDelivery\"]}],\"films\":[{\"id\":\"HO00007139\",\"title\":{\"text\":\"Twenty Years of the Met in Cinemas\",\"translations\":[]},\"synopsis\":{\"text\":\"Twenty Years of the Met in Cinemas is a celebration of the Met’s two decades of onstage glory as experienced in movie theaters, featuring highlights from the company’s collection of more than 185 extraordinary onscreen performances. \\nHosted by star soprano Renée Fleming, this special presentation will showcase unforgettable moments from some of opera’s greatest stars, culled from the series’ vast archive of transmissions, featuring such remarkable artists as Lise Davidsen, Natalie Dessay, Joyce DiDonato, Juan Diego Flórez, Elīna Garanča, Dmitri Hvorostovsky,  Jonas Kaufmann, Peter Mattei, Matthew Polenzani, Sondra Radvanovsky, Nadine Sierra, and, of course, Fleming herself.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Twenty Years of the Met in Cinemas is a celebration of the Met’s two decades of onstage glory as experienced in movie theaters.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-09-19\",\"runtimeInMinutes\":180,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001580\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001582\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001583\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001591\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003514\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003795\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003801\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003802\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003825\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000377\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000776\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000777\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001580\"},{\"castAndCrewMemberId\":\"0000001582\"},{\"castAndCrewMemberId\":\"0000001583\"},{\"castAndCrewMemberId\":\"0000001591\"},{\"castAndCrewMemberId\":\"0000003514\"},{\"castAndCrewMemberId\":\"0000003795\"},{\"castAndCrewMemberId\":\"0000003801\"},{\"castAndCrewMemberId\":\"0000003802\"},{\"castAndCrewMemberId\":\"0000003825\"},{\"castAndCrewMemberId\":\"HO00000377\"},{\"castAndCrewMemberId\":\"HO00000776\"},{\"castAndCrewMemberId\":\"HO00000777\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000000920\"}],\"producers\":[],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"03f10e17-3825-4714-9482-f83b6bf7c0ed\",\"corporateId\":null},\"hopk\":\"HO000