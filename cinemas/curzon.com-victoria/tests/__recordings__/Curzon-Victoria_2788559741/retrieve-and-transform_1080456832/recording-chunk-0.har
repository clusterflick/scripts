          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2027-04-03\",\"showtimes\":[{\"id\":\"VIC1-90326\",\"schedule\":{\"businessDate\":\"2027-04-03\",\"startsAt\":\"2027-04-03T17:00:00+01:00\",\"endsAt\":\"2027-04-03T21:25:00+01:00\",\"filmStartsAt\":\"2027-04-03T17:00:00+01:00\",\"filmEndsAt\":\"2027-04-03T21:25:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-5-11\",\"filmId\":\"HO00007134\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-5\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000010\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976005554199,\"longitude\":-0.13680000603199},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"VIC1@curzon.com\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":true,\"allowedItemDeliveryMethods\":[\"CounterPickup\",\"ElectronicDelivery\",\"PostalDelivery\"]}],\"films\":[{\"id\":\"HO00007134\",\"title\":{\"text\":\"Met Opera 2026-27: Manon\",\"translations\":[]},\"synopsis\":{\"text\":\"Following her radiant performance in Gounod’s Roméo et Juliette—which garnered raves for “high notes that spun like liquid gold … Sierra touched the operatic firmament” (The New York Times)—superstar soprano Nadine Sierra takes on another alluring French heroine, the irresistible title character of Massenet’s passionate drama, live from the Met stage to cinemas worldwide. Leading tenor Matthew Polenzani is her idealistic lover, the Chevalier des Grieux, with rising-star baritone Andrzej Filończyk as her stalwart cousin, Lescaut, in a breathtaking staging by director Laurent Pelly.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Following her radiant performance in Gounod’s Roméo et Juliette—which garnered raves for “high notes that spun like liquid gold … Sierra touched the operatic firmament”\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2027-04-03\",\"runtimeInMinutes\":265,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001582\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001591\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001594\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003504\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000381\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000762\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000763\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000764\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001582\"},{\"castAndCrewMemberId\":\"0000001591\"},{\"castAndCrewMemberId\":\"0000001594\"},{\"castAndCrewMemberId\":\"0000003504\"},{\"castAndCrewMemberId\":\"HO00000762\"},{\"castAndCrewMemberId\":\"HO00000763\"},{\"castAndCrewMemberId\":\"HO00000764\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000000920\"}],\"producers\":[{\"castAndCrewMemberId\":\"HO00000381\"}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5181796c-61ee-453a-b5e1-0b73ea664913\",\"corporateId\":null},\"hopk\":\"HO00007134\",\"hoCode\":\"A000008785\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000001582\",\"name\":{\"givenName\":\"Matthew\",\"familyName\":\"Polenzani\",\"middleName\":null}},{\"id\":\"0000001591\",\"name\":{\"givenName\":\"Nadine \",\"familyName\":\"Sierra\",\"middleName\":null}},{\"id\":\"0000001594\",\