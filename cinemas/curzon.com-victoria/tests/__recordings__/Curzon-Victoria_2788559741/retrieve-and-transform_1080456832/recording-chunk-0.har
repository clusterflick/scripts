is\":{\"text\":\"In 1600, nobleman Orlando (Tilda Swinton) inherits his parents' house, thanks to Queen Elizabeth I (Quentin Crisp), who commands the young man to never change. After a disastrous affair with Russian princess Sasha (Charlotte Valandrey), Orlando looks for solace in the arts before being appointed ambassador to Constantinople in 1700, where war is raging. One morning, Orlando is shocked to wake up as a woman and returns home, struggling as a female to retain her property as the centuries roll by.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After Queen Elizabeth I commands him not to grow old, a young nobleman struggles with love and his place in the world.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":null,\"releaseDate\":\"1993-03-12\",\"runtimeInMinutes\":90,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000198\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011174\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011175\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011176\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011178\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011179\",\"roles\":[\"Producer\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000198\"},{\"castAndCrewMemberId\":\"0000011174\"},{\"castAndCrewMemberId\":\"0000011175\"},{\"castAndCrewMemberId\":\"0000011176\"},{\"castAndCrewMemberId\":\"0000011177\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000011178\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000011179\"}],\"genreIds\":[\"0000000002\",\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4821c3e3-21a2-48f0-9f4c-cc3f68486ea6\",\"corporateId\":null},\"hopk\":\"HO00002081\",\"hoCode\":\"A000002671\",\"eventId\":null,\"distributorName\":\"Curzon\"},{\"id\":\"HO00007104\",\"title\":{\"text\":\"Film Club: Marathon Man\",\"translations\":[]},\"synopsis\":{\"text\":\"To mark the centenary of Academy Award-winning director John Schlesinger's birth, we're inviting you to experience his greatest films on the big screen. Season curated by Claire Nicolas and Marc David Jacobs. \\n\\nMARATHON MAN\\nA graduate history student is unwittingly caught in the middle of an international conspiracy involving stolen diamonds, an exiled Nazi war criminal, and a rogue government agent.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A graduate history student is unwittingly caught in the middle of an international conspiracy involving stolen diamonds, an exiled Nazi war criminal, and a rogue agent.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-07-07\",\"runtimeInMinutes\":125,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001772\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007173\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008227\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011662\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000014077\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014078\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000014079\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"5923\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000001772\"},{\"castAndCrewMemberId\":\"0000007173\"},{\"castAndCrewMemberId\":\"0000008227\"},{\"castAndCrewMemberId\":\"0000014077\"},{\"castAndCrewMemberId\":\"5923\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000011662\"}],\"producers\":[{\"castAndCrewMemberId\":\"0000014078\"},{\"castAndCrewMemberId\":\"0000014079\"}],\"genreIds\":[\"0000000002\",\"0000000026\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00007104\",\"hoCode\":\"A000008751\",\"eventId\":null,\"distributorName\":\"Park Circus\"}],\"castAnd