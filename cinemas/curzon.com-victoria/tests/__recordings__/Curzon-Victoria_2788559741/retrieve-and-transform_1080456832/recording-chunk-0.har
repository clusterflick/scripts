          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-08-18\",\"showtimes\":[{\"id\":\"VIC1-91378\",\"schedule\":{\"businessDate\":\"2026-08-18\",\"startsAt\":\"2026-08-18T18:00:00+01:00\",\"endsAt\":\"2026-08-18T20:24:00+01:00\",\"filmStartsAt\":\"2026-08-18T18:25:00+01:00\",\"filmEndsAt\":\"2026-08-18T20:24:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-5-11\",\"filmId\":\"HO00007229\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-5\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000053\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000068\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976005554199,\"longitude\":-0.13680000603199},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"VIC1@curzon.com\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":true,\"allowedItemDeliveryMethods\":[\"CounterPickup\",\"ElectronicDelivery\",\"PostalDelivery\"]}],\"films\":[{\"id\":\"HO00007229\",\"title\":{\"text\":\"Curzon Film 50: Only You\",\"translations\":[]},\"synopsis\":{\"text\":\"Elena (Laia Costa), 35, and Jake (Josh O'Connor), 26, meet by chance on New Year's Eve, fighting for the same taxi. But, instead of going their separate ways after a shared ride, they start a passionate relationship. Within weeks they are living together, and not long after they talk about starting a family.\\n\\nBut, as the seasons' pass, reality catches up with them. Falling in love was the easy part, but can they remain in love when life doesn’t give them everything they hoped for?\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Elena and Jake meet by chance on New Years' Eve, arguing for the same taxi, and start a passionate rel