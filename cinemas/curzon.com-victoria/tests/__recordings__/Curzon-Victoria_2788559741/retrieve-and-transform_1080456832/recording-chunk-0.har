          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-11-19\",\"showtimes\":[{\"id\":\"VIC1-91385\",\"schedule\":{\"businessDate\":\"2026-11-19\",\"startsAt\":\"2026-11-19T18:00:00+00:00\",\"endsAt\":\"2026-11-19T20:41:00+00:00\",\"filmStartsAt\":\"2026-11-19T18:25:00+00:00\",\"filmEndsAt\":\"2026-11-19T20:41:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-2-8\",\"filmId\":\"HO00007248\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-2\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000017\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976005554199,\"longitude\":-0.13680000603199},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"VIC1@curzon.com\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\",\"hasSellableItems\":true,\"allowedItemDeliveryMethods\":[\"CounterPickup\",\"ElectronicDelivery\",\"PostalDelivery\"]}],\"films\":[{\"id\":\"HO00007248\",\"title\":{\"text\":\"GIANT – The Play\",\"translations\":[]},\"synopsis\":{\"text\":\"GIANT, the 5-star critically acclaimed play starring John Lithgow (Killers of the Flower Moon, The Crown) as Roald Dahl, comes to the big screen. Winner of 3 Olivier Awards® including Best Play and a Tony Award® for Best Actor in a Play (John Lithgow), the production was filmed live in London’s West End ahead of its sold-out Broadway run. The stellar cast includes Aya Cash (The Boys, The Franchise, You’re the Worst), Elliot Levey (Cold War, Patriots, Good) and Rachael Stirling (The Divine Mrs S).\\n\\nA world-famous children’s author under threat. A battle of wills in the wake of scandal. And one chance to make amends...It’s the summer of 1983, The Witches is about to hit the shelves and Roald Dahl is making last-minute edits.  But the outcry at his recent, explicitly antisemitic article won’t die down. Across a single afternoon at his family home, and rocked by an unexpectedly explosive confrontation, Dahl is forced to choose: make a public apology or risk his name and reputation. Inspired by real events, GIANT explores with dark humour the difference between considered opinion and dangerous rhetoric offering a complicated portrait of a fiendishly charismatic icon. \\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A world-famous children’s author under threat. A battle of wills in the wake of scandal. And one chance to make amends...\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-11-19\",\"runtimeInMinutes\":136,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002005\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000004572\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006719\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014339\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014340\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000004572\"},{\"castAndCrewMemberId\":\"0000006719\"},{\"castAndCrewMemberId\":\"0000014339\"},{\"castAndCrewMemberId\":\"0000014340\"}],\"directors\":[{\"castAndCrewMemberId\":\"0000002005\"}],\"producers\":[],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"973a9e31-7311-4dd9-aefe-d46b5e1b78a4\",\"corporateId\":null},\"hopk\":\"HO00007248\",\"hoCode\":\"A000008915\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000002005\",\"name\":{\"givenName\":\"Nicholas \",\"familyName\":\"Hytner\",\"middleName\":null}},{\"id\":\"0000004572\",\"name\":{\"givenName\":\"Elliot \",\"familyName\":\"Levey\",\"middleName\":null}},{\"id\":\"0000006719\",\"name\":{\