:[]},\"shortSynopsis\":{\"text\":\"Under the oppressive heat of the Spanish sun, the fiercely independent Carmen attracts the attention of Don José. She warns him not to fall in love with her\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-11-10\",\"runtimeInMinutes\":215,\"trailers\":[],\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000922\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014096\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014097\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014098\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000379\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000601\",\"roles\":[\"Actor\"]}],\"actors\":[{\"castAndCrewMemberId\":\"0000000922\"},{\"castAndCrewMemberId\":\"0000014096\"},{\"castAndCrewMemberId\":\"0000014097\"},{\"castAndCrewMemberId\":\"0000014098\"},{\"castAndCrewMemberId\":\"HO00000601\"}],\"directors\":[{\"castAndCrewMemberId\":\"HO00000379\"}],\"producers\":[],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"f7e080d9-f84e-45f2-898b-630570ea943a\",\"corporateId\":null},\"hopk\":\"HO00007122\",\"hoCode\":\"A000008773\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000922\",\"name\":{\"givenName\":\"Alexander \",\"familyName\":\"Vinogradov\",\"middleName\":null}},{\"id\":\"0000014096\",\"name\":{\"givenName\":\"Ginger\",\"familyName\":\"Costa-Jackson\",\"middleName\":null}},{\"id\":\"0000014097\",\"name\":{\"givenName\":\"Russell\",\"familyName\":\"Thomas\",\"middleName\":null}},{\"id\":\"0000014098\",\"name\":{\"givenName\":\"Adriana\",\"familyName\":\"González\",\"middleName\":null}},{\"id\":\"HO00000379\",\"name\":{\"givenName\":\"Damiano \",\"familyName\":\"Michieletto\",\"middleName\":null}},{\"id\":\"HO00000601\",\"name\":{\"givenName\":\"Barnaby\",\"familyName\":\"Rea\",\"middleName\":