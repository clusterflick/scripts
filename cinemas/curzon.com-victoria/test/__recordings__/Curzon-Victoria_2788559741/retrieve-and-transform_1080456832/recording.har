        "response": {
          "bodySize": 5116,
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 5116,
            "text": "{\"businessDate\":\"2026-01-10\",\"showtimes\":[{\"id\":\"VIC1-81832\",\"schedule\":{\"businessDate\":\"2026-01-10\",\"startsAt\":\"2026-01-10T18:00:00+00:00\",\"endsAt\":\"2026-01-10T22:20:00+00:00\",\"filmStartsAt\":\"2026-01-10T18:25:00+00:00\",\"filmEndsAt\":\"2026-01-10T22:20:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-2-8\",\"filmId\":\"HO00006240\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-2\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\",\"0000000017\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976,\"longitude\":-0.1368},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006240\",\"title\":{\"text\":\"Met Opera 2025-26: I Puritani\",\"translations\":[]},\"synopsis\":{\"text\":\"For gorgeous melody, spellbinding coloratura, and virtuoso vocal fireworks, I Puritani has few equals. On January 10, the first new Met production of Bellini’s final masterpiece in nearly 50 years—a striking staging by Charles Edwards, who makes his company directorial debut after many successes as a set designer—arrives in cinemas worldwide. The Met has assembled a world-beating quartet of stars, conducted by Marco Armiliato, for the demanding principal roles. Soprano Lisette Oropesa and tenor Lawrence Brownlee are Elvira and Arturo, brought together by love and torn apart by the political rifts of the English Civil War, with baritone Artur Ruciński as Riccardo, betrothed to Elvira against her will, and bass-baritone Christian Van Horn as Elvira’s sympathetic uncle, Giorgio.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"For gorgeous melody, spellbinding coloratura, and virtuoso vocal fireworks, I Puritani has few equals. \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-10\",\"runtimeInMinutes\":235,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001488\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003808\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000296\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000539\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000632\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000633\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"326f1551-03d5-4b22-ad3f-cda83d151748\",\"corporateId\":null},\"hopk\":\"HO00006240\",\"hoCode\":\"A000007698\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000001488\",\"name\":{\"givenName\":\"Lisette\",\"familyName\":\"Oropesa\",\"middleName\":null}},{\"id\":\"0000003808\",\"name\":{\"givenName\":\"Marco\",\"familyName\":\"Armiliato\",\"middleName\":null}},{\"id\":\"HO00000296\",\"name\":{\"givenName\":\"Lawrence\",\"familyName\":\"Brownlee\",\"middleName\":null}},{\"id\":\"HO00000539\",\"name\":{\"givenName\":\"Christian\",\"familyName\":\"Van Horn\",\"middleName\":null}},{\"id\":\"HO00000632\",\"name\":{\"givenName\":\"Artur\",\"familyName\":\"Ruciński\",\"middleName\":null}},{\"id\":\"HO00000633\",\"name\":{\"givenName\":\"Charles\",\"familyName\":\"Edwards\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\