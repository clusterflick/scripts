        "response": {
          "bodySize": 4871,
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 4871,
            "text": "{\"businessDate\":\"2025-12-13\",\"showtimes\":[{\"id\":\"VIC1-81829\",\"schedule\":{\"businessDate\":\"2025-12-13\",\"startsAt\":\"2025-12-13T18:00:00+00:00\",\"endsAt\":\"2025-12-13T22:05:00+00:00\",\"filmStartsAt\":\"2025-12-13T18:25:00+00:00\",\"filmEndsAt\":\"2025-12-13T22:05:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-2-8\",\"filmId\":\"HO00006238\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-2\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\",\"0000000017\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976,\"longitude\":-0.1368},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006238\",\"title\":{\"text\":\"Met Opera 2025-26: Andrea Chénier\",\"translations\":[]},\"synopsis\":{\"text\":\"Giordano’s passionate tragedy stars tenor Piotr Beczała as the virtuous poet who falls victim to the intrigue and violence of the French Revolution. Following their celebrated recent partnership in Giordano’s Fedora in the 2022–23 Live in HD season, Beczała reunites with soprano Sonya Yoncheva as Chénier’s aristocratic lover, Maddalena di Coigny, with baritone Igor Golovatenko as Carlo Gérard, the agent of the Reign of Terror who seals their fates. Met Principal Guest Conductor Daniele Rustioni takes the podium to lead Nicolas Joël’s gripping staging, which will be transmitted live from the Met stage to cinemas on December 13. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Giordano’s passionate tragedy stars tenor Piotr Beczała as the virtuous poet who falls victim to the intrigue and violence of the French Revolution. \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-12-13\",\"runtimeInMinutes\":220,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000003819\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000045\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000619\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000628\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000629\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"d9c248ac-50da-482d-81eb-eb56fdaa382b\",\"corporateId\":null},\"hopk\":\"HO00006238\",\"hoCode\":\"A000007696\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000003819\",\"name\":{\"givenName\":\"Daniele\",\"familyName\":\"Rustioni\",\"middleName\":null}},{\"id\":\"HO00000045\",\"name\":{\"givenName\":\"Sonya\",\"familyName\":\"Yoncheva\",\"middleName\":null}},{\"id\":\"HO00000619\",\"name\":{\"givenName\":\"Igor\",\"familyName\":\"Golovatenko\",\"middleName\":null}},{\"id\":\"HO00000628\",\"name\":{\"givenName\":\"Piotr\",\"familyName\":\"Beczała\",\"middleName\":null}},{\"id\":\"HO00000629\",\"name\":{\"givenName\":\"Nicolas\",\"familyName\":\"Joël\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000004\",\"name\":{\"text\":\"Live Opera, Music & Theatre\",\"translations\":[]},\"description\":{\"text\":\"Event\",\"translations\":[]}}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000003\",