            "mimeType": "application/json; charset=utf-8",
            "size": 4436,
            "text": "{\"businessDate\":\"2026-01-14\",\"showtimes\":[{\"id\":\"VIC1-81806\",\"schedule\":{\"businessDate\":\"2026-01-14\",\"startsAt\":\"2026-01-14T18:45:00+00:00\",\"endsAt\":\"2026-01-14T22:45:00+00:00\",\"filmStartsAt\":\"2026-01-14T18:45:00+00:00\",\"filmEndsAt\":\"2026-01-14T22:45:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-2-8\",\"filmId\":\"HO00006229\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-2\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976,\"longitude\":-0.1368},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006229\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: La Traviata\",\"translations\":[]},\"synopsis\":{\"text\":\"At one of her lavish parties, celebrated Parisan courtesan Violetta is introduced to Alfredo Germont. The two fall madly in love, and though hesitant to leave behind her life of luxury and freedom, Violetta follows her heart. But the young couple’s happiness is short-lived, as the harsh realities of life soon come knocking.\\nAs intimate as it is sumptuous, La traviata features some of opera’s most famous melodies, and is a star vehicle for its leading soprano role sung by Ermonela Jaho. In director Richard Eyre’s world of seductive grandeur, the tender and devastating beauty at the centre of Verdi’s opera shines bright.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"At one of her lavish parties, celebrated Parisan courtesan Violetta is introduced to Alfredo Germont. \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-14\",\"runtimeInMinutes\":240,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000011526\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000480\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000598\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000599\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000600\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000601\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000602\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000603\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000604\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"bc0c66c8-a0aa-4fcb-a5d5-1c94495a8815\",\"corporateId\":null},\"hopk\":\"HO00006229\",\"hoCode\":\"A000007686\",\"eventId\":null,\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000011526\",\"name\":{\"givenName\":\"Ossian\",\"familyName\":\"Huskinson\",\"middleName\":null}},{\"id\":\"HO00000480\",\"name\":{\"givenName\":\"Ermonela \",\"familyName\":\"Jaho\",\"middleName\":null}},{\"id\":\"HO00000598\",\"name\":{\"givenName\":\"Giovanni\",\"familyName\":\"Sala\",\"middleName\":null}},{\"id\":\"HO00000599\",\"name\":{\"givenName\":\"Aleksei\",\"familyName\":\"Isaev\",\"middleName\":null}},{\"id\":\"HO00000600\",\"name\":{\"givenName\":\"Veena\",\"familyName\":\"Akama-Makia\",\"middleName\":null}},{\"id\":\"HO00000601\",\"name\":{\"givenName\":\"Barnaby\",\"familyName\":\"Rea\",\"middleName\":null}},{\"id\":\"HO00000602\",\"name\":{\"givenName\":\"Ellen\",\"familyName\":\"Pearson\",\"middleName\":null}},{\"id\":\"HO00000603\",\"name\":{\"givenName\":\"Sam\",\"familyName\":\"Hird\",\"middleName\":null}},{\"id\":\"HO00000604\",\"name\":{\"givenName\":\"Giorgi\",\"familyName\":\"Guliashvili\",\"middleName\":null}}],\"genres\":[{\"i