00000007\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9246b245-546b-48f2-aa44-5143e8e5b45e\",\"corporateId\":null},\"hopk\":\"HO00006096\",\"hoCode\":\"A000007516\",\"eventId\":null,\"distributorName\":\"Paramount\"},{\"id\":\"HO00006097\",\"title\":{\"text\":\"The Phoenician Scheme\",\"translations\":[]},\"synopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe; Mia Threapleton as Liesl, his daughter/a nun; Michael Cera as Bjorn, their tutor. With: Riz Ahmed, Tom Hanks, Bryan Cranston, Mathieu Amalric, Richard Ayoade, Jeffrey Wright, Scarlett Johansson, Benedict Cumberbatch, Rupert Friend, Hope Davis.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong injury detail\",\"translations\":[]},\"releaseDate\":\"2025-05-23\",\"runtimeInMinutes\":101,\"trailerUrl\":\"https://www.youtube.com/watch?v=qRAnphZLAIg\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001084\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001275\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001395\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001400\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001409\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001410\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001411\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002527\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003325\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005645\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005699\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011116\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011117\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"eff6ffca-db00-4c6f-9e5e-1783c6ace2d7\",\"corporateId\":null},\"hopk\":\"HO00006097\",\"hoCode\":\"A000007517\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006204\",\"title\":{\"text\":\"28 Years Later\",\"translations\":[]},\"synopsis\":{\"text\":\"Academy Award®-winning director Danny Boyle and Academy Award®-nominated writer Alex Garland reunite for 28 Years Later, a terrifying new story set in the world created by 28 Days Later. It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine, some have found ways to exist amidst the infected. One such group of survivors lives on a small island connected to the mainland by a single, heavily-defended causeway. When one of the group leaves the island on a mission into the dark heart of the mainland, he discovers secrets, wonders, and horrors that have mutated not only the infected but other survivors as well.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine...\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-19\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=poEFz8Ivzug\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000313\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001100\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001270\",\"roles\":[\"Actor\"]},{\"castAnd