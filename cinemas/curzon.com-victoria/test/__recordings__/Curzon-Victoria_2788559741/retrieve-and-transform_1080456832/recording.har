          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 3217,
            "text": "{\"businessDate\":\"2025-11-09\",\"showtimes\":[{\"id\":\"VIC1-81799\",\"schedule\":{\"businessDate\":\"2025-11-09\",\"startsAt\":\"2025-11-09T14:00:00+00:00\",\"endsAt\":\"2025-11-09T17:30:00+00:00\",\"filmStartsAt\":\"2025-11-09T14:00:00+00:00\",\"filmEndsAt\":\"2025-11-09T17:30:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-1-18\",\"filmId\":\"HO00006226\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-1\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976,\"longitude\":-0.1368},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006226\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: La Fille Mal Gardee\",\"translations\":[]},\"synopsis\":{\"text\":\"Lise, the only daughter of Widow Simone, is in love with the young farmer Colas, but her mother has far more ambitious plans for her. Simone hopes to marry her off to Alain, the son of the wealthy proprietor Thomas. Desperate to marry Colas rather than Alain, Lise contrives to outwit her mother’s plans.  \\n65 years after its premiere, The Royal Ballet presents Frederick Ashton’s La Fille mal gardée. This affectionate portrayal of village life combines exuberant good humour and brilliantly inventive choreography in what is undoubtedly Ashton’s love letter to the English countryside. La Fille mal gardée whisks us away into pastoral bliss with Ferdinand Hérold’s cheerful score and Osbert Lancaster’s colourful designs.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Lise, the only daughter of Widow Simone, is in love with the young farmer Colas, but her mother has far more ambitious plans for her.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-11-05\",\"runtimeInMinutes\":210,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"431db788-8022-47d3-b718-45d5af01a49a\",\"corporateId\":null},\"hopk\":\"HO00006226\",\"hoCode\":\"A000007683\",\"eventId\":\"0000000042\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[],\"genres\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Documentary\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"VS00000007\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"TBC - Adults.\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000006\",\"name\":{\"text\":\"Encore\",\"translations\":[]},\"shortName\":{\"text\":\"Encore\",\"translations\":[]},\"description\":{\"text\":\"Encore\",\"translations\":[]},\"importantMessage\":null,\"displayPriority\":100,\"isPromoted\":false}],\"screens\":[{\"id\":\"VIC1-1\",\"name\":{\"text\":\"Screen 1\",\"translations\":[]}}],\"events\":[],\"filmAdvanceBookingRules\":[],\"areaCategories\":[{\"id\":\"VIC1-0000000001\",\"name\":{\"text\":\"Standard\",\"translations\":[]},\"hopk\":\"0000000000\",\"isAllocatedSeating\":true,\"isInSeatItemDeliveryAvailable\":false}]}}"
