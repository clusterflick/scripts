            "text": "{\"businessDate\":\"2026-03-31\",\"showtimes\":[{\"id\":\"VIC1-81815\",\"schedule\":{\"businessDate\":\"2026-03-31\",\"startsAt\":\"2026-03-31T17:15:00+01:00\",\"endsAt\":\"2026-03-31T22:45:00+01:00\",\"filmStartsAt\":\"2026-03-31T17:15:00+01:00\",\"filmEndsAt\":\"2026-03-31T22:45:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-2-8\",\"filmId\":\"HO00006232\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-2\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976,\"longitude\":-0.1368},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006232\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: Siegfried\",\"translations\":[]},\"synopsis\":{\"text\":\"Raised by a scheming dwarf and unaware of his true family origins, a young man embarks on an epic journey. Soon, destiny brings him face-to-face with a shattered sword, a fearsome dragon and the cursed ring it guards, and a Valkyrie forced into enchanted slumber... \\nMoments of transcendent beauty and heroic triumph sparkle in the third chapter of Wagner’s Ring cycle, brought to life under Barrie Kosky’s inspired eye following his spectacular Das Rheingold (2023) and Die Walküre (2025). Andreas Schager, in his much-anticipated debut with The Royal Opera, stars as Siegfried’s titular hero, alongside Christopher Maltman’s towering Wanderer, Peter Hoare’s treacherous Mime and Elisabet Strid’s radiant Brünnhilde. Antonio Pappano conducts, drawing out the unspoken tensions and ethereal mysticism of Wagner’s dynamic score.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Raised by a scheming dwarf and unaware of his true family origins, a young man embarks on an epic journey. \",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-03-31\",\"runtimeInMinutes\":330,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003814\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006115\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006116\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00000286\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000490\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000606\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000607\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000608\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000609\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"0000526f-f09f-444c-9d66-e6ec960d9d6d\",\"corporateId\":null},\"hopk\":\"HO00006232\",\"hoCode\":\"A000007689\",\"eventId\":\"0000000042\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000003814\",\"name\":{\"givenName\":\"Christopher \",\"familyName\":\"Maltman\",\"middleName\":null}},{\"id\":\"0000006115\",\"name\":{\"givenName\":\"Christopher\",\"familyName\":\"Purves\",\"middleName\":null}},{\"id\":\"0000006116\",\"name\":{\"givenName\":\"Barrie\",\"familyName\":\"Kosky\",\"middleName\":null}},{\"id\":\"HO00000286\",\"name\":{\"givenName\":\"Soloman\",\"familyName\":\"Howard\",\"middleName\":null}},{\"id\":\"HO00000490\",\"name\":{\"givenName\":\"Elisabet\",\"familyName\":\"Strid\",\"middleName\":null}},{\"id\":\"HO00000606\",\"name\":{\"givenName\":\"Andreas\",\"familyName\":\"Schager\",\"middleName\":null}},{\"id\":\"HO00000607\",\"name\":{\"givenName\":\"Peter\",\"familyName\":\"Hoare\",\"middleName\":null}},{\"id