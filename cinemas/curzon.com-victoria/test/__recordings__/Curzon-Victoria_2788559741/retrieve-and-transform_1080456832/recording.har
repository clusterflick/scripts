ng\":true}],\"attributeIds\":[\"0000000055\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976,\"longitude\":-0.1368},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006097\",\"title\":{\"text\":\"The Phoenician Scheme\",\"translations\":[]},\"synopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe; Mia Threapleton as Liesl, his daughter/a nun; Michael Cera as Bjorn, their tutor. With: Riz Ahmed, Tom Hanks, Bryan Cranston, Mathieu Amalric, Richard Ayoade, Jeffrey Wright, Scarlett Johansson, Benedict Cumberbatch, Rupert Friend, Hope Davis.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong injury detail\",\"translations\":[]},\"releaseDate\":\"2025-05-23\",\"runtimeInMinutes\":101,\"trailerUrl\":\"https://www.youtube.com/watch?v=qRAnphZLAIg\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001084\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001275\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001395\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001400\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001409\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001410\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001411\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002527\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003325\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005645\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005699\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011116\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011117\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"eff6ffca-db00-4c6f-9e5e-1783c6ace2d7\",\"corporateId\":null},\"hopk\":\"HO00006097\",\"hoCode\":\"A000007517\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006261\",\"title\":{\"text\":\"Jurassic World: Rebirth\",\"translations\":[]},\"synopsis\":{\"text\":\"A specialist team, led by Scarlett Johansson, treks through a secluded island to harvest life-saving genetic material from dinosaurs. The creatures have other plans for the intruding humans, prompting a life-and-death struggle between man and beast.  \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Five years after the events of Jurassic World Dominion, the planet’s ecology has proven largely inhospitable to dinosaurs. \",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"moderate threat, violence, language\",\"translations\":[]},\"releaseDate\":\"2025-07-02\",\"runtimeInMinutes\":134,\"trailerUrl\":\"https://www.youtube.com/watch?v=Jl0XxudAT60\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001395\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002138\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003152\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003153\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004757\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006680\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000007356\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008553\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008692\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011541\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011542\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011543\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011544\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011545\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011546\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000035\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"f4dcd756-1347-454a-af2f-07f8b2d18a80\",\"corporateId\":null},\"hopk\":\"HO00006261\",\"hoCode\":\"A000007725\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006204\",\"title\":{\"text\":\"28 Years Later\",\"translations\":[]},\"synopsis\":{\"text\":\"Academy Award®-winning director Danny Boyle and Academy Award®-nominated writer Alex Garland reunite for 28 Years Later, a terrifying new story set in the world created by 28 Days Later. It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine, some have found ways to exist amidst the infected. One such group of survivors lives on a small island connected to the mainland by a single, heavily-defended causeway. When one of the group leaves the island on a mission into the dark heart of the mainland, he discovers secrets, wonders, and horrors that have mutated not only the infected but other survivors as well.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine...\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-19\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=poEFz8Ivzug\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000313\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001100\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001270\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003206\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003678\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010558\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011257\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000011418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011419\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a7823fd3-66f7-47af-87ba-d36ef45b168c\",\"corporateId\":null},\"hopk\":\"HO00006204\",\"hoCode\":\"A000007660\",\"eventId\":null,\"distributorName\":\"Sony Pictures\"},{\"id\":\"HO00006206\",\"title\":{\"text\":\"How to Train Your Dragon\",\"translations\":[]},\"synopsis\":{\"text\":\"A live-action remake of the beloved animation that explores the bond between a Viking boy and his dragon, a friendship that flies in the face of centuries of tradition. Together, they confront an ancient threat that endangers both species. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"On the rugged isle of Berk, where Vikings and dragons have been bitter enemies for generations, Hiccup (Mason Thames; The Black Phone, For All Mankind) stands apart.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":{\"text\":\"mild threat, scary scenes, violence, language\",\"translations\":[]},\"releaseDate\":\"2025-06-13\",\"runtimeInMinutes\":126,\"trailerUrl\":\"https://www.youtube.com/watch?v=CS_TVzQpNlg\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000269\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003403\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006974\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006978\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007232\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008693\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011422\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011423\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011424\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011425\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011426\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000011427\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"4360\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000007\",\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5970f2a4-78f6-48eb-a600-f37fc295f441\",\"corporateId\":null},\"hopk\":\"HO00006206\",\"hoCode\":\"A000007662\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006207\",\"title\":{\"text\":\"Elio\",\"translations\":[]},\"synopsis\":{\"text\":\"Elio struggles to fit in until he is transported by aliens and becomes the chosen one to be Earth's galactic ambassador while his mother Olga works on the top-secret project to decode alien messages.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Elio struggles to fit in until he is transported by aliens and becomes the chosen one to be Earth's galactic ambassador.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":{\"text\":\"mild threat, scary scenes, violence\",\"translations\":[]},\"releaseDate\":\"2025-06-20\",\"runtimeInMinutes\":98,\"trailerUrl\":\"https://www.youtube.com/watch?v=OGAl3E9enJs\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001020\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003582\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007170\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007853\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011428\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011429\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011430\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011431\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011432\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011433\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000003\",\"0000000007\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b560745f-df8b-460e-805c-3806cfabc263\",\"corporateId\":null},\"hopk\":\"HO00006207\",\"hoCode\":\"A000007663\",\"eventId\":null,\"distributorName\":\"Walt Disney Studios Motion Pictures - UK\"},{\"id\":\"HO00006208\",\"title\":{\"text\":\"M3GAN 2.0\",\"translations\":[]},\"synopsis\":{\"text\":\"The murderous doll who captivated pop culture in 2023 is back. And this time she’s not alone.\\n\\nThe original creative team behind that phenomenon—led by horror titans James Wan for Atomic Monster, Jason Blum for Blumhouse and director Gerard Johnstone—reboot an all-new wild chapter in A.I. mayhem with M3GAN 2.0.\\n\\nTwo years after M3GAN, a marvel of artificial intelligence, went rogue and embarked on a murderous (and impeccably choreographed) rampage and was subsequently destroyed, M3GAN’s creator Gemma (Allison Williams) has become a high-profile author and advocate for government oversight of A.I. Meanwhile, Gemma’s niece Cady (Violet McGraw), now 14, has become a teenager, rebelling against Gemma’s overprotective rules.\\n\\nUnbeknownst to them, the underlying tech for M3GAN has been stolen and misused by a powerful defense contractor to create a military-grade weapon known as Amelia (Ivanna Sakhno; Ahsoka, Pacific Rim: Uprising), the ultimate killer infiltration spy. But as Amelia’s self-awareness increases, she becomes decidedly less interested in taking orders from humans. Or in keeping them around.\\n\\nWith the future of human existence on the line, Gemma realizes that the only option is to resurrect M3GAN (Amie Donald, voiced by Jenna Davis) and give her a few upgrades, making her faster, stronger, and more lethal. As their paths collide, the original A.I bitch is about to meet her match.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The murderous doll who captivated pop culture in 2023 is back. And this time she’s not alone.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail\",\"translations\":[]},\"releaseDate\":\"2025-06-27\",\"runtimeInMinutes\":120,\"trailerUrl\":\"https://www.youtube.com/watch?v=8mhQ6TRDnuE\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000413\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000578\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000705\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004784\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000004785\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004786\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004789\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000009464\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011434\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011435\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011436\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011437\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011438\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9e781b97-f78d-49f4-a57d-76a0726b15bd\",\"corporateId\":null},\"hopk\":\"HO00006208\",\"hoCode\":\"A000007664\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006110\",\"title\":{\"text\":\"F1® The Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career. Thirty years later, he’s a nomadic racer-for-hire when he’s approached by his former teammate Ruben Cervantes (Javier Bardem), owner of a struggling FORMULA 1 team that is on the verge of collapse. Ruben convinces Sonny to come back to FORMULA 1 for one last shot at saving the team and being the best in the world. He’ll drive alongside Joshua Pearce (Damson Idris), the team's hotshot rookie intent on setting his own pace. But as the engines roar, Sonny’s past catches up with him and he finds that in FORMULA 1, your teammate is your fiercest competition—and the road to redemption is not something you can travel alone.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate threat\",\"translations\":[]},\"releaseDate\":\"2025-06-25\",\"runtimeInMinutes\":156,\"trailerUrl\":\"https://www.youtube.com/watch?v=TZGY2CWPXeU\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000166\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000167\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001693\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002986\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003190\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003191\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008544\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"