            "text": "{\"businessDate\":\"2026-05-02\",\"showtimes\":[{\"id\":\"VIC1-81836\",\"schedule\":{\"businessDate\":\"2026-05-02\",\"startsAt\":\"2026-05-02T18:00:00+01:00\",\"endsAt\":\"2026-05-02T22:30:00+01:00\",\"filmStartsAt\":\"2026-05-02T18:25:00+01:00\",\"filmEndsAt\":\"2026-05-02T22:30:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-2-8\",\"filmId\":\"HO00006235\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-2\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\",\"0000000017\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976,\"longitude\":-0.1368},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006235\",\"title\":{\"text\":\"Met Opera 2025-26: Eugene Onegin\",\"translations\":[]},\"synopsis\":{\"text\":\"Following her acclaimed 2024 company debut in Puccini’s Madama Butterfly, soprano Asmik Grigorian returns to the Met as Tatiana, the lovestruck young heroine in this ardent operatic adaptation of Pushkin, which will be transmitted live from the Metropolitan Opera stage to cinemas worldwide on May 2. Baritone Igor Golovatenko reprises his portrayal of the urbane Onegin, who realizes his affection for her all too late. The Met’s evocative production, directed by Tony Award–winner Deborah Warner, “offers a beautifully detailed reading of … Tchaikovsky’s lyrical romance” (The Telegraph).\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Following her acclaimed 2024 company debut in Puccini’s Madama Butterfly, soprano Asmik Grigorian returns to the Met as Tatiana, the lovestruck young heroine.\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2026-05-02\",\"runtimeInMinutes\":245,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001571\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003826\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000387\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000488\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000617\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000618\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000619\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000620\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"26fed296-cfec-43f7-a592-8b660590e653\",\"corporateId\":null},\"hopk\":\"HO00006235\",\"hoCode\":\"A000007692\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000001571\",\"name\":{\"givenName\":\"Stephanie \",\"familyName\":\"Blythe\",\"middleName\":null}},{\"id\":\"0000003826\",\"name\":{\"givenName\":\"Alexander\",\"familyName\":\"Tsymbalyuk\",\"middleName\":null}},{\"id\":\"HO00000387\",\"name\":{\"givenName\":\"Asmik\",\"familyName\":\"Grigorian\",\"middleName\":null}},{\"id\":\"HO00000488\",\"name\":{\"givenName\":\"Stanislas\",\"familyName\":\"de Barbeyrac\",\"middleName\":null}},{\"id\":\"HO00000617\",\"name\":{\"givenName\":\"Timur\",\"familyName\":\"Zangiev\",\"middleName\":null}},{\"id\":\"HO00000618\",\"name\":{\"givenName\":\"Maria\",\"familyName\":\"Barakova\",\"middleName\":null}},{\"id\":\"HO00000619\",\"name\":{\"givenName\":\"Igor\",\"familyName\":\"Golovatenko\",\"middleName\":null}},{\"id\":\"HO00000620\",\"name\":{\"givenN