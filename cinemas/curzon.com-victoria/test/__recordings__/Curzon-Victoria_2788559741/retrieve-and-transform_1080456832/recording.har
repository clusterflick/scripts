sAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"VIC1-85-HO00006204\"},{\"id\":\"VIC1-82612\",\"schedule\":{\"businessDate\":\"2025-06-26\",\"startsAt\":\"2025-06-26T21:15:00+01:00\",\"endsAt\":\"2025-06-26T23:18:00+01:00\",\"filmStartsAt\":\"2025-06-26T21:40:00+01:00\",\"filmEndsAt\":\"2025-06-26T23:18:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-3-9\",\"filmId\":\"HO00006207\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-3\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[\"FilmAdvanceBookingRule\"],\"filmAdvanceBookingRuleId\":\"VIC1-88-HO00006207\"}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976,\"longitude\":-0.1368},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00005273\",\"title\":{\"text\":\"Film Club: Love Lies Bleeding\",\"translations\":[]},\"synopsis\":{\"text\":\"From Director Rose Glass comes an electric new love story; reclusive gym manager Lou falls hard for Jackie, an ambitious bodybuilder headed through town to Vegas in pursuit of her dream. But their love ignites violence, pulling them deep into the web of Lou’s criminal family.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Director Rose Glass comes an electric new love story; reclusive gym manager Lou falls hard for Jackie, an ambitious bodybuilder headed through town to Vegas.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"violence, gore, drug misuse, sex, domestic abuse, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-06-11\",\"runtimeInMinutes\":104,\"trailerUrl\":\"https://www.youtube.com/watch?v=OCYd8Th9ywI\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001078\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001810\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001866\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007400\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007941\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000008395\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008396\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008397\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008398\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008399\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008400\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008401\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008402\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008403\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008404\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008405\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008406\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008407\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008408\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008409\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000008410\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000033\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00005273\",\"hoCode\":\"A000006547\",\"eventId\":null,\"distributorName\":\"Lionsgate\"},{\"id\":\"HO00006095\",\"title\":{\"text\":\"Lilo & Stitch\",\"translations\":[]},\"synopsis\":{\"text\":\"A live-action reimagining of Disney’s 2002 animated classic, “Lilo & Stitch” is the wildly funny and touching story of a lonely Hawaiian girl and the fugitive alien who helps to mend her broken family. Directed by Dean Fleischer Camp, the Oscar®-nominated filmmaker behind the animated feature film “Marcel the Shell with Shoes On,” the film stars Sydney Elizebeth Agudong, Billy Magnussen, Tia Carrere, Hannah Waddingham, Chris Sanders, with Courtney B. Vance, and Zach Galifianakis, introducing Maia Kealoha. “Lilo & Stitch” is produced by Jonathan Eirich, p.g.a. and Dan Lin, with Louie Provost, Tom Peitzman and Ryan Halprin serving as executive producers.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"“Lilo & Stitch” is the wildly funny and touching story of a lonely Hawaiian girl and the fugitive alien who helps to mend her broken family.\",\"translations\":[]},\"censorRatingId\":\"HO00000001\",\"censorRatingNote\":null,\"releaseDate\":\"2025-05-23\",\"runtimeInMinutes\":108,\"trailerUrl\":\"https://www.youtube.com/watch?v=8SBLkgpQ99U\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001269\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001723\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004973\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000005592\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006407\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006408\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000010016\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011110\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011111\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011112\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011113\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000003\",\"0000000007\"],\"externalIds\":{\"moviexchangeReleaseId\":\"560b5a6d-5c9a-496d-a7c0-df3e44b57480\",\"corporateId\":null},\"hopk\":\"HO00006095\",\"hoCode\":\"A000007515\",\"eventId\":null,\"distributorName\":\"Walt Disney Studios Motion Pictures - UK\"},{\"id\":\"HO00006096\",\"title\":{\"text\":\"Mission: Impossible - The Final Reckoning\",\"translations\":[]},\"synopsis\":{\"text\":\"Light the fuse because Tom Cruise's world-saving super spy Ethan Hunt is back to complete a mission for the ages alongside Simon Pegg, Ving Rhames and Hayley Atwell. This propulsive action-adventure demands to be seen on the big screen.    \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Our lives are the sum of our choices. Tom Cruise is Ethan Hunt in Mission: Impossible – The Final Reckoning.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"moderate violence, injury detail, threat, language\",\"translations\":[]},\"releaseDate\":\"2025-05-21\",\"runtimeInMinutes\":170,\"trailerUrl\":\"https://www.youtube.com/watch?v=CUAQn2P13yY\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000029\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000030\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000000031\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000436\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000802\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003183\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003189\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003192\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003193\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003194\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004434\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005130\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005592\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005596\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005686\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005717\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005718\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005719\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005720\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005721\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005722\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006663\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011114\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011115\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000349\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000002\",\"0000000007\",\"0000000036\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9246b245-546b-48f2-aa44-5143e8e5b45e\",\"corporateId\":null},\"hopk\":\"HO00006096\",\"hoCode\":\"A000007516\",\"eventId\":null,\"distributorName\":\"Paramount\"},{\"id\":\"HO00006097\",\"title\":{\"text\":\"The Phoenician Scheme\",\"translations\":[]},\"synopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe; Mia Threapleton as Liesl, his daughter/a nun; Michael Cera as Bjorn, their tutor. With: Riz Ahmed, Tom Hanks, Bryan Cranston, Mathieu Amalric, Richard Ayoade, Jeffrey Wright, Scarlett Johansson, Benedict Cumberbatch, Rupert Friend, Hope Davis.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The story of a family and a family business. Starring: Benicio del Toro as Zsa-zsa Korda, one of the richest men in Europe.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong injury detail\",\"translations\":[]},\"releaseDate\":\"2025-05-23\",\"runtimeInMinutes\":101,\"trailerUrl\":\"https://www.youtube.com/watch?v=qRAnphZLAIg\",\"displayPriority\":5,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001084\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001275\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001395\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001400\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001409\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000001410\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001411\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002527\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003325\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005645\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005699\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011116\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011117\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"eff6ffca-db00-4c6f-9e5e-1783c6ace2d7\",\"corporateId\":null},\"hopk\":\"HO00006097\",\"hoCode\":\"A000007517\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006204\",\"title\":{\"text\":\"28 Years Later\",\"translations\":[]},\"synopsis\":{\"text\":\"Academy Award®-winning director Danny Boyle and Academy Award®-nominated writer Alex Garland reunite for 28 Years Later, a terrifying new story set in the world created by 28 Days Later. It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine, some have found ways to exist amidst the infected. One such group of survivors lives on a small island connected to the mainland by a single, heavily-defended causeway. When one of the group leaves the island on a mission into the dark heart of the mainland, he discovers secrets, wonders, and horrors that have mutated not only the infected but other survivors as well.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It’s been almost three decades since the rage virus escaped a biological weapons laboratory, and now, still in a ruthlessly enforced quarantine...\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2025-06-19\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=poEFz8Ivzug\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000313\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001100\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001270\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003206\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003678\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004531\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010558\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011257\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000011418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011419\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000030\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a7823fd3-66f7-47af-87ba-d36ef45b168c\",\"corporateId\":null},\"hopk\":\"HO00006204\",\"hoCode\":\"A000007660\",\"eventId\":null,\"distributorName\":\"Sony Pictures\"},{\"id\":\"HO00006206\",\"title\":{\"text\":\"How to Train Your Dragon\",\"translations\":[]},\"synopsis\":{\"text\":\"A live-action remake of the beloved animation that explores the bond between a Viking boy and his dragon, a friendship that flies in the face of centuries of tradition. Together, they confront an ancient threat that endangers both species. \",\"translations\":[]},\"shortSynopsis\":{\"text\":\"On the rugged isle of Berk, where Vikings and dragons have been bitter enemies for generations, Hiccup (Mason Thames; The Black Phone, For All Mankind) stands apart.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":{\"text\":\"mild threat, scary scenes, violence, language\",\"translations\":[]},\"releaseDate\":\"2025-06-13\",\"runtimeInMinutes\":126,\"trailerUrl\":\"https://www.youtube.com/watch?v=CS_TVzQpNlg\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000269\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003403\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004805\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006974\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006978\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007232\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008693\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011422\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011423\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011424\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011425\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011426\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000011427\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"4360\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000007\",\"0000000028\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5970f2a4-78f6-48eb-a600-f37fc295f441\",\"corporateId\":null},\"hopk\":\"HO00006206\",\"hoCode\":\"A000007662\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006207\",\"title\":{\"text\":\"Elio\",\"translations\":[]},\"synopsis\":{\"text\":\"Elio struggles to fit in until he is transported by aliens and becomes the chosen one to be Earth's galactic ambassador while his mother Olga works on the top-secret project to decode alien messages.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Elio struggles to fit in until he is transported by aliens and becomes the chosen one to be Earth's galactic ambassador.\",\"translations\":[]},\"censorRatingId\":\"HO00000002\",\"censorRatingNote\":{\"text\":\"mild threat, scary scenes, violence\",\"translations\":[]},\"releaseDate\":\"2025-06-20\",\"runtimeInMinutes\":98,\"trailerUrl\":\"https://www.youtube.com/watch?v=OGAl3E9enJs\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001020\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003582\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007170\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007853\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011428\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011429\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011430\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011431\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011432\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000011433\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000003\",\"0000000007\"],\"externalIds\":{\"moviexchangeReleaseId\":\"b560745f-df8b-460e-805c-3806cfabc263\",\"corporateId\":null},\"hopk\":\"HO00006207\",\"hoCode\":\"A000007663\",\"eventId\":null,\"distributorName\":\"Walt Disney Studios Motion Pictures - UK\"},{\"id\":\"HO00006110\",\"title\":{\"text\":\"F1® The Movie\",\"translations\":[]},\"synopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career. Thirty years later, he’s a nomadic racer-for-hire when he’s approached by his former teammate Ruben Cervantes (Javier Bardem), owner of a struggling FORMULA 1 team that is on the verge of collapse. Ruben convinces Sonny to come back to FORMULA 1 for one last shot at saving the team and being the best in the world. He’ll drive alongside Joshua Pearce (Damson Idris), the team's hotshot rookie intent on setting his own pace. But as the engines roar, Sonny’s past catches up with him and he finds that in FORMULA 1, your teammate is your fiercest competition—and the road to redemption is not something you can travel alone.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Dubbed “the greatest that never was,” Sonny Hayes (Brad Pitt) was FORMULA 1’s most promising phenom of the 1990s until an accident on the track nearly ended his career.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, moderate threat\",\"translations\":[]},\"releaseDate\":\"2025-06-25\",\"runtimeInMinutes\":156,\"trailerUrl\":\"https://www.youtube.com/watch?v=TZGY2CWPXeU\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000166\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000167\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001693\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002986\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003190\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003191\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004240\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008544\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008790\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000011186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011187\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011188\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"90334335-0de9-4985-8924-9942f4379b60\",\"corporateId\":null},\"hopk\":\"HO00006110\",\"hoCode\":\"A000007538\",\"eventId\":null,\"distributorName\":\"Warners\"}],\"castAndCrew\":[{\"id\":\"0000001078\",\"name\":{\"givenName\":\"Dave\",\"familyName\":\"Franco\",\"middleName\":null}},{\"id\":\"0000001810\",\"name\":{\"givenName\":\"Kristen\",\"familyName\":\"Stewart\",\"middleName\":null}},{\"id\":\"0000001866\",\"name\":{\"givenName\":\"Ed\",\"familyName\":\"Harris\",\"middleName\":null}},{\"id\":\"0000007400\",\"name\":{\"givenName\":\"Jena\",\"familyName\":\"Malone\",\"middleName\":null}},{\"id\":\"0000007941\",\"name\":{\"givenName\":\"Oliver\",\"familyName\":\"Kassman\",\"middleName\":null}},{\"id\":\"0000008395\",\"name\":{\"givenNa