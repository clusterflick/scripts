            "mimeType": "application/json; charset=utf-8",
            "size": 4535,
            "text": "{\"businessDate\":\"2025-10-01\",\"showtimes\":[{\"id\":\"VIC1-81792\",\"schedule\":{\"businessDate\":\"2025-10-01\",\"startsAt\":\"2025-10-01T18:45:00+01:00\",\"endsAt\":\"2025-10-01T22:15:00+01:00\",\"filmStartsAt\":\"2025-10-01T18:45:00+01:00\",\"filmEndsAt\":\"2025-10-01T22:15:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-2-8\",\"filmId\":\"HO00006225\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-2\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976,\"longitude\":-0.1368},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006225\",\"title\":{\"text\":\"RBO Cinema Season 2025-26: Tosca\",\"translations\":[]},\"synopsis\":{\"text\":\"In war-torn Rome, Floria Tosca and Mario Cavaradossi live for each other and for their art. But when Cavaradossi helps an escaped prisoner, the lovers make a deadly enemy in the form of Baron Scarpia, Chief of Police. At the mercy of Scarpia’s twisted desires, Tosca is forced to make a horrific bargain: sleeping with the man she hates in order to save the man she loves. Can she find a way out? \\nA star-studded cast includes soprano Anna Netrebko performing the role of Tosca, tenor Freddie De Tommaso as Cavaradossi, and bass-baritone Gerald Finley as Scarpia, with Music Director of The Royal Opera Jakub Hrůša conducting his first new production in the role. An alternative, modern-day Rome provides the backdrop for Oliver Mears’ unmissable, gripping new production of Puccini’s thriller.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In war-torn Rome, Floria Tosca and Mario Cavaradossi live for each other and for their art. But when Cavaradossi helps an escaped prisoner, the lovers make a deadly enemy\",\"translations\":[]},\"censorRatingId\":\"VS00000007\",\"censorRatingNote\":null,\"releaseDate\":\"2025-10-01\",\"runtimeInMinutes\":210,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001498\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000003504\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009287\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011525\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011526\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011527\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000011528\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000044\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":\"6dfd06cc-b3d8-4945-818f-03bba9fe67d1\",\"corporateId\":null},\"hopk\":\"HO00006225\",\"hoCode\":\"A000007682\",\"eventId\":\"0000000042\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000001498\",\"name\":{\"givenName\":\"Oliver\",\"familyName\":\"Mears\",\"middleName\":null}},{\"id\":\"0000003504\",\"name\":{\"givenName\":\"Carlo \",\"familyName\":\"Bosi\",\"middleName\":null}},{\"id\":\"0000009287\",\"name\":{\"givenName\":\"Freddie\",\"familyName\":\"De Tommaso\",\"middleName\":null}},{\"id\":\"0000011525\",\"name\":{\"givenName\":\"Gerald\",\"familyName\":\"Finley\",\"middleName\":null}},{\"id\":\"0000011526\",\"name\":{\"givenName\":\"Ossian\",\"familyName\":\"Huskinson\",\"middleName\":null}},{\"id\":\"0000011527\",\"name\":{\"givenName\":\"Alessandro\",\"familyName\":\"Corbelli\",\"middleName\":null}},{\"id\":\"0000011528\",\"name\":{\"givenName\":\"Siphe\",\"familyName\":\"Kwani\",\"middleName\":null}},{\"id\":\"HO00000044\",\"name\":{\"givenName\"