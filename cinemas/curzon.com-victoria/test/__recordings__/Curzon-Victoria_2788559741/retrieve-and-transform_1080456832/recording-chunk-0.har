            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-03-21\",\"showtimes\":[{\"id\":\"VIC1-81834\",\"schedule\":{\"businessDate\":\"2026-03-21\",\"startsAt\":\"2026-03-21T16:00:00+00:00\",\"endsAt\":\"2026-03-21T21:35:00+00:00\",\"filmStartsAt\":\"2026-03-21T16:25:00+00:00\",\"filmEndsAt\":\"2026-03-21T21:35:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"VIC1-2-8\",\"filmId\":\"HO00006239\",\"siteId\":\"VIC1\",\"screenId\":\"VIC1-2\",\"areaCategories\":[{\"areaCategoryId\":\"VIC1-0000000001\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000003\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000043\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"VIC1\",\"name\":{\"text\":\"Victoria\",\"translations\":[]},\"location\":{\"latitude\":51.4976,\"longitude\":-0.1368},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"58 Victoria Street,\",\"line2\":\"London,\",\"city\":\"SW1E 6QW \"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006239\",\"title\":{\"text\":\"Met Opera 2025-26: Tristan und Isolde\",\"translations\":[]},\"synopsis\":{\"text\":\"After years of anticipation, a truly unmissable event arrives in cinemas worldwide on March 21 as the electrifying Lise Davidsen tackles one of the ultimate roles for dramatic soprano: the Irish princess Isolde in Wagner’s transcendent meditation on love and death. Heroic tenor Michael Spyres stars opposite Davidsen as the love-drunk Tristan. The momentous occasion also marks the advent of a new, Met-debut staging by Yuval Sharon—hailed by The New York Times as “the most visionary opera director of his generation” and the first American to direct an opera at the famed Wagner festival in Bayreuth—as well as Music Director Yannick Nézet-Séguin’s first time leading Tristan und Isolde at the Met. Mezzo-soprano Ekaterina Gubanova reprises her portrayal of Brangäne, alongside bass-baritone Tomasz Konieczny, who sings Kurwenal after celebrated Met appearances in Wagner’s Der Fliegende Holländer and Ring cycle. Bass-baritone Ryan Speedo Green makes an important role debut as King Marke.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After years of anticipation, a truly unmissable event arrives in cinemas worldwide on March 21 as the electrifying Lise Davidsen tackles one of the ultimate roles.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":null,\"releaseDate\":\"2026-03-21\",\"runtimeInMinutes\":310,\"trailerUrl\":null,\"displayPriority\":66,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000907\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000920\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001562\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001580\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000003796\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000545\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000630\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000631\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000004\"],\"externalIds\":{\"moviexchangeReleaseId\":null,\"corporateId\":null},\"hopk\":\"HO00006239\",\"hoCode\":\"A000007697\",\"eventId\":\"0000000043\",\"distributorName\":\"Trafalgar Releasing\"}],\"castAndCrew\":[{\"id\":\"0000000907\",\"name\":{\"givenName\":\"Ryan Speedo\",\"familyName\":\"Green\",\"middleName\":null}},{\"id\":\"0000000920\",\"name\":{\"givenName\":\"The Metropolitan\",\"familyName\":\"Opera\",\"middleName\":null}},{\"id\":\"0000001562\",\"name\":{\"givenName\":\"Yannick\",\"familyName\":\"Nézet-Séguin\",\"middleName\":null}},{\"id\":\"0000001580\",\"name\":{\"givenName\":\"Lise\",\"familyName\":\"Davidsen\",\"middleName\":null}},{\"id\":\"0000003796\",\"name\":{\"givenName\":\"Ekaterina \",\"familyName\":\"Gubanova\",\"middleName\":null}},{\"id\":\"HO00000545\",\"name\":{\"givenName\":\"Tomasz\",\"familyNam