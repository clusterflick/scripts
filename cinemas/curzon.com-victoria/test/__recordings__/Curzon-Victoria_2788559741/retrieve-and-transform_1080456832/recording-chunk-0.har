naTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00006677\",\"title\":{\"text\":\"Hamnet\",\"translations\":[]},\"synopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"From Academy Award® winning writer/director Chloé Zhao, HAMNET tells the powerful love story that inspired the creation of Shakespeare’s timeless masterpiece, Hamlet.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"distressing scenes, brief moderate sex\",\"translations\":[]},\"releaseDate\":\"2026-01-09\",\"runtimeInMinutes\":126,\"trailerUrl\":\"https://www.youtube.com/watch?v=Y9Tv9wGPxIw\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000175\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000001040\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001087\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002138\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000002310\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004702\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000004703\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000005314\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007765\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012800\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"c566d7dc-50bb-4d55-984b-c4c65751933e\",\"corporateId\":null},\"hopk\":\"HO00006677\",\"hoCode\":\"A000008241\",\"eventId\":null,\"distributorName\":\"Universal Pictures\"},{\"id\":\"HO00006686\",\"title\":{\"text\":\"H is for Hawk\",\"translations\":[]},\"synopsis\":{\"text\":\"When Helen's beloved father passes away, she is knocked sideways by grief and loses herself in memories of their time birding and exploring the natural world together. She becomes obsessed with the idea of training her own goshawk, and so she brings the fearsome bird Mabel home to her life as a graduate fellow at Cambridge. Helen fills the freezer with hawk food and turns off her phone, ready to embark on the long, strange business of trying to train this wildest of animals. But as she labours to tame Mabel, a grieving Helen undergoes an untaming of her own. A record of a spiritual journey, H IS FOR HAWK is a story about memory and nature and how it might be possible to reconcile death with life and love.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When Helen's beloved father passes away, she is knocked sideways by grief and loses herself in memories of their time birding and exploring the natural world together.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language, drug misuse, injury detail, sex references\",\"translations\":[]},\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=RJ29BBXfN64\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000166\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000167\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000000254\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002250\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007943\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012811\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012812\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012813\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012814\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012815\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e652fb82-1635-4421-a615-6bd0166c8771\",\"corporateId\":null},\"hopk\":\"HO00006686\",\"hoCode\":\"A000008251\",\"eventId\":null,\"distributorName\":\"Lionsgate\"},{\"id\":\"HO00006689\",\"title\":{\"text\":\"No Other Choice\",\"translations\":[]},\"synopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After being unemployed for several years, a man devises a unique plan to secure a new job: eliminate his competition.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-23\",\"runtimeInMinutes\":139,\"trailerUrl\":null,\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000012169\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012827\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012828\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012829\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012830\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012831\",\"roles\":[\"Director\",\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000026\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9ecc0908-a983-42f7-9591-6f8d73d7488b\",\"corporateId\":null},\"hopk\":\"HO00006689\",\"hoCode\":\"A000008255\",\"eventId\":null,\"distributorName\":\"MUBI\"},{\"id\":\"HO00006691\",\"title\":{\"text\":\"Is This Thing On?\",\"translations\":[]},\"synopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family — forcing them to navigate co-parenting, identity, and whether love can take a new form.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"As their marriage quietly unravels, Alex seeks new purpose in the New York comedy scene while Tess confronts the sacrifices she made for their family.\",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":null,\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":121,\"trailerUrl\":\"https://www.youtube.com/watch?v=ngmu5zGOa7s\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002276\",\"roles\":[\"Actor\",\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003003\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000003138\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000006446\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007571\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000012836\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012837\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012838\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"4e47345d-b26d-4559-847e-3add7a11d75a\",\"corporateId\":null},\"hopk\":\"HO00006691\",\"hoCode\":\"A000008257\",\"eventId\":null,\"distributorName\":\"Walt Disney Studios Motion Pictures - UK\"},{\"id\":\"HO00006693\",\"title\":{\"text\":\"Nouvelle Vague\",\"translations\":[]},\"synopsis\":{\"text\":\"A playful, poignant love letter to cinema, Nouvelle Vague reimagines the making of Jean-Luc Godard’s Breathless in an exuberant exploration of the youthful rebellion and creative chaos that shaped the French New Wave.\\n\\nDirected by Richard Linklater, starring Zoey Deutch, Guillaume Marbeck, and Aubry Dullin.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"A playful, poignant love letter to cinema, Nouvelle Vague reimagines the making of Jean-Luc Godard’s Breathless in an exuberant exploration of the youthful rebellion.\",\"translations\":[]},\"censorRatingId\":\"HO00000004\",\"censorRatingNote\":{\"text\":\"infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-01-30\",\"runtimeInMinutes\":106,\"trailerUrl\":\"https://www.youtube.com/watch?v=sRqWbsdACzg\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002634\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008603\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000012851\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012852\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012853\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012854\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012855\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000012856\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000012857\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000002\",\"0000000003\"],\"externalIds\":{\"moviexchangeReleaseId\":\"8ddd1648-0036-4a88-99b9-4b2eb84d4838\",\"corporateId\":null},\"hopk\":\"HO00006693\",\"hoCode\":\"A000008259\",\"eventId\":null,\"distributorName\":\"Altitude Film Distribution\"},{\"id\":\"HO00006608\",\"title\":{\"text\":\"The Housemaid\",\"translations\":[]},\"synopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous — a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. \",\"translations\":[]},\"censorRatingId\":\"HO00000006\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, sex, sexual violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-12-26\",\"runtimeInMinutes\":131,\"trailerUrl\":\"https://www.youtube.com/watch?v=vjThWa5R8Zw\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000004322