            "text": "{\"name\":\"Victoria\",\"urlSegment\":\"victoria\",\"url\":\"/venues/victoria/\",\"nodeId\":1813,\"alias\":\"cinema\",\"createDate\":\"2024-08-13T14:58:46\\u002B01:00\",\"updateDate\":\"2026-01-28T09:54:17\\u002B00:00\",\"versions\":{\"\":\"https://www.curzon.com/venues/victoria/\"},\"robotsNoIndex\":false,\"robotsNoFollow\":false,\"masterCanonicalUrl\":null,\"excludeCanonicalUrl\":false,\"seoImage\":null,\"metaKeywords\":\"\",\"metaDescription\":\"Find out what\\u0027s on at Curzon Cinema in Victoria. Check out the latest blockbuster movies, new Indie film releases and the best of world cinema out now.\",\"seoPageTitle\":\"Curzon Victoria Cinema Showtimes \\u0026 Film Listings\",\"oGType\":\"\",\"twitterCard\":\"\",\"seoUrl\":\"\",\"oGLocale\":\"\",\"excludeFromXmlSitemap\":false,\"excludeFromSiteSearch\":false,\"pageTitle\":\"Curzon Victoria Cinema Showtimes \\u0026 Film Listings\",\"hideTitle\":false,\"grid\":[],\"redirectDetailsElement\":{\"redirect\":false,\"permanent\":false},\"heroCarouselDetailsElement\":[{\"image\":{\"mobile\":\"/media/v3bmqdhf/open.webp?width=393\\u0026height=169\\u0026v=1dc903b9a6542f0\",\"tablet\":\"/media/v3bmqdhf/open.webp?width=782\\u0026height=315\\u0026v=1dc903b9a6542f0\",\"desktop\":\"/media/v3bmqdhf/open.webp?width=1216\\u0026height=523\\u0026v=1dc903b9a6542f0\",\"alt\":\"\"},\"textHeading\":\"ON TUESDAY 3 FEBRUARY OUR VENUES WILL OPEN AT 12PM\"},{\"image\":{\"mobile\":\"/media/ss0pxhla/victoria4.jpg?width=393\\u0026height=169\\u0026v=1dbbaa784bfd1f0\",\"tablet\":\"/media/ss0pxhla/victoria4.jpg?width=782\\u0026height=315\\u0026v=1dbbaa784bfd1f0\",\"desktop\":\"/media/ss0pxhla/victoria4.jpg?width=1216\\u0026height=523\\u0026v=1dbbaa784bfd1f0\",\"alt\":\"\"},\"textHeading\":\"WELCOME TO CURZON VICTORIA\",\"actionLink\":{\"name\":\"take a tour\",\"target\":\"_blank\",\"url\":\"https://tours.360virtualtours.co.uk/curzon/victoria/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/px2iem4l/st-mungos-web.jpg?width=393\\u0026height=169\\u0026v=1dc44fc6573af80\",\"tablet\":\"/media/px2iem4l/st-mungos-web.jpg?width=782\\u0026height=315\\u0026v=1dc44fc6573af80\",\"desktop\":\"/media/px2iem4l/st-mungos-web.jpg?width=1216\\u0026height=523\\u0026v=1dc44fc6573af80\",\"alt\":\"\"},\"textHeading\":\"Support St Mungo\\u0027s on your Curzon cinema visit\",\"actionLink\":{\"name\":\"FIND OUT MORE\",\"url\":\"/charity/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/pjsj0oss/pepperoni.jpg?width=393\\u0026height=169\\u0026v=1daf1d80a3f4700\",\"tablet\":\"/media/pjsj0oss/pepperoni.jpg?width=782\\u0026height=315\\u0026v=1daf1d80a3f4700\",\"desktop\":\"/media/pjsj0oss/pepperoni.jpg?width=1216\\u0026height=523\\u0026v=1daf1d80a3f4700\",\"alt\":\"\"},\"textHeading\":\"Food and drink\",\"actionLink\":{\"name\":\"View Menu\",\"target\":\"_blank\",\"url\":\"/media/wjyl4svz/menu-3_oct2025_updated.pdf\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/fgup11jt/ph-victoria-1.jpg?width=393\\u0026height=169\\u0026v=1dbbaa79818d2b0\",\"tablet\":\"/media/fgup11jt/ph-victoria-1.jpg?width=782\\u0026height=315\\u0026v=1dbbaa79818d2b0\",\"desktop\":\"/media/fgup11jt/ph-victoria-1.jpg?width=1216\\u0026height=523\\u0026v=1dbbaa79818d2b0\",\"alt\":\"\"},\"textHeading\":\"HIRE THIS SPACE\",\"actionLink\":{\"name\":\"HIRE THIS SPACE\",\"url\":\"/private-hire/\"},\"actionLinkBackgroundColor\":{\"color\":\"f8a4d8\",\"label\":\"pink\"}},{\"image\":{\"mobile\":\"/media/5c4bhbxo/coffee-cake.jpg?width=393\\u0026height=169\\u0026v=1db9da6ab2ee1f0\",\"tablet\":\"/media/5c4bhbxo/coffee-cake.jpg?width=782\\u0026height=315\\u0026v=1db9da6ab2ee1f0\",\"desktop\":\"/media/5c4bhbxo/coffee-cake.jpg?width=1216\\u0026height=523\\u0026v=1db9da6ab2ee1f0\",\"alt\":\"\"},\"textHeading\":\"caf\\u00E9 and bar\"},{\"image\":{\"mobile\":\"/media/hivdncek/victoria56.jpg?width=393\\u0026height=169\\u0026v=1dbbaa7a3c40940\",\"tablet\":\"/media/hivdncek/victoria56.jpg?width=782\\u0026height=315\\u0026v=1dbbaa7a3c40940\",\"desktop\":\"/media/hivdncek/victoria56.jpg?width=1216\\u0026height=523\\u0026v=1dbbaa7a3c40940\",\"alt\":\"\"},\"textHeading\":\"GET DIRECTIONS\",\"actionLink\":{\"name\":\"VIEW ON MAP\",\"url\":\"https://www.google.com/maps?q=victoria\\u002Bcurzon\\u0026rlz=1C1GCEU_enGB875GB875\\u0026um=1\\u0026ie=UTF-8\\u0026sa=X\\u0026ved=2ahUKEwiCsLHwtqDvAhVCt3EKHU2kAjwQ_AUoAXoECBQQAw\"}}],\"cinemaLocationDetailsElement\":{\"venueCardImage\":{\"mobile\":\"/media/qexh0dqd/cinema-venues-_victoria.jpg?width=300\\u0026height=160\\u0026v=1db998a233d7b50\",\"alt\":\"\"},\"addressLine1\":\"58 Victoria St\",\"city\":\"London\",\"postcode\":\"SW1E 6QW\",\"nearestStationName\":\"St James\\u0027s Park\",\"nearestStationType\":\"underground\"},\"vistaCinema\":{\"key\":\"VIC1\",\"value\":\"Curzon Victoria\"},\"informationTabAccordions\":[{\"heading\":\"Opening times\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EMonday to Saturday:\\u003C/strong\\u003E The cinema opens 30 minutes before the first show\\u0027s programme begins and closes at midnight.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003ESunday:\\u003C/strong\\u003E Closes at 11.30pm.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cem\\u003EPlease be aware opening and closing times may be subject to change.\\u003C/em\\u003E\\u003C/p\\u003E\"},{\"heading\":\"Screen info\",\"body\":\"\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 1\\u003Cbr\\u003E\\u003C/strong\\u003E47 seats, 1 wheelchair space\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 2\\u003Cbr\\u003E\\u003C/strong\\u003E69 seats, 1 wheelchair space\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 3\\u003Cbr\\u003E\\u003C/strong\\u003E29 seats, 1 wheelchair space\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 4\\u003Cbr\\u003E\\u003C/strong\\u003E53 seats, 1 wheelchair space\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cstrong\\u003EScreen 5\\u003C/strong\\u003E\\u003Cstrong\\u003E\\u003Cbr\\u003E\\u003C/strong\\u003E40 seats, 1 wheelchair space\\u003C/p\\u003E\"},{\"heading\":\"Accessibility\",\"body\":\"\\u003Cp\\u003EAll screens are accessible by lift, each screen has one wheelchair space. The lift has a maximum weight limit of 500 kg. There is a wheelchair-accessible bathroom.\\u003C/p\\u003E\\n\\u003Cp\\u003EAudio Description and hearing-assist headsets are available on request.\\u003C/p\\u003E\"},{\"heading\":\"Food and Drink\",\"body\":\"\\u003Cp\\u003EFresh coffee, teas and pastries alongside an all day menu of pizza and bar food with vegan and vegetarian options available. The drinks menu includes a wide selection of cocktails, wine, craft beer and soft drinks.\\u003C/p\\u003E\\n\\u003Cp\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca rel=\\u0022noopener\\u0022 href=\\u0022/media/wjyl4svz/menu-3_oct2025_updated.pdf\\u0022 target=\\u0022_blank\\u0022 title=\\u0022Menu 3 Oct2025 Updated\\u0022\\u003ESee our full menu here.\\u003C/a\\u003E\\u003C/span\\u003E\\u003C/p\\u003E\"},{\"heading\":\"HAPPY HOUR INFORMATION\",\"body\":\"\\u003Cp\\u003EAt this venue Happy Hour is all day: 2 for \\u00A316 on all cocktails.\\u003C/p\\u003E\"},{\"heading\":\"Private Hires\",\"body\":\"\\u003Cp\\u003EOur screens are available to rent for your private functions, email \\u003Ca href=\\u0022mailto:privatehires@curzon.com\\u0022\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003Eprivatehires@curzon.com\\u003C/span\\u003E\\u003C/a\\u003E for more information.\\u003C/p\\u003E\\n\\u003Cp\\u003ETo find out more, visit our \\u003Ca href=\\u0022/private-hire/victoria/\\u0022 title=\\u0022Victoria Private Hire\\u0022\\u003E\\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003EPrivate Hires page\\u003C/span\\u003E.\\u003C/a\\u003E\\u003C/p\\u003E\"},{\"heading\":\"social media\",\"body\":\"\\u003Cp\\u003EInstagram: \\u003Cspan style=\\u0022text-decoration: underline;\\u0022\\u003E\\u003Ca href=\\u0022https://www.instagram.com/curzonvic?igsh=MWxxb2I2NDl3ZDB4NQ==\\u0022 data-anchor=\\u0022?igsh=MWxxb2I2NDl3ZDB4NQ==\\u0022\\u003Ecurzonvic\\u003C/a\\u003E\\u003C/span\\u003E\\u003Ca class=\\u0022gmail_plusreply\\u0022\\u003E\\u003C/a\\u003E\\u003C/p\\u003E\"}],\"informationTabDescription\":\"\\u003Cp\\u003ECurzon Victoria is home to five boutique screens with comfortable reclining seats and tables in screens 1, 3 \\u0026amp; 5. Guests are invited to relax in one of the venue\\u2019s two opulent lounge areas: on the ground floor, there\\u2019s the cafe lined with velvet sofas, and up on the mezzanine you\\u2019ll find a sophisticated bar.\\u003C/p\\u003E\",\"menuTabAccordions\":[{\"heading\":\"Pizza\",\"body\":\"\\u003Ctable border=\\u00221\\u0022 style=\\u0022border-collapse: collapse; width: 100%; height: 382px;\\u0022\\u003E\\n\\u003Ctbody\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EMargherita (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A311.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EPepperoni \\u0026amp; Honey\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003E\\u0027Nduja\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EGoat\\u0027s Cheese \\u0026amp; Caramelised Onion (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.80\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EMushroom \\u0026amp; Truffle Oil (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.80\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EVegan Margherita (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A311.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EVegan Mushroom \\u0026amp; Truffle Oil (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A312.80\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003ETomato \\u0026amp; Pesto Flatbread (Vg)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; text-align: right; height: 18.5px;\\u0022\\u003E\\u00A38.00\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003EGarlic Flatbread (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; height: 18.5px; text-align: right;\\u0022\\u003E\\u00A37.50\\u003C/td\\u003E\\n\\u003C/tr\\u003E\\n\\u003Ctr style=\\u0022height: 18.5px;\\u0022\\u003E\\n\\u003Ctd style=\\u0022width: 60.1346%; height: 18.5px;\\u0022\\u003ECheesy Garlic Flatbread (V)\\u003C/td\\u003E\\n\\u003Ctd style=\\u0022width: 39.8654%; height: 18.5px; text-align