t<div class=\"film-details\" data-align=\"full\"><div class=\"film-details__image__container\"><img decoding=\"async\" class=\"film-details__image\" src=\"https://www.chiswickcinema.co.uk/wp-content/uploads/film_images/58291.d.jpg?cb=1663154748\" alt=\"Image for Shrek Forever After\"><div class=\"film-details__image__overlay\"></div></div><div class=\"film-details__inner alignwide\"><div class=\"film-details__top\"><div class=\"film-details__top__left\"><h3>Browse</h3><a href=\"https://www.chiswickcinema.co.uk/films/ocean-with-david-attenborough/\" class=\"film-details__browse-previous\" title=\"Previous\"><i class=\"fal fa-chevron-left\"></i></a><a href=\"https://www.chiswickcinema.co.uk/films/french-impressions-oh-my-goodness-juste-ciel/\" class=\"film-details__browse-next\" title=\"Next\"><i class=\"fal fa-chevron-right\"></i></a></div><div class=\"film-details__top__content\"><h1 class=\"film-details__title\">Shrek Forever After<span class=\"film-details__rating\">U</span></h1><div class=\"film-details__buttons chiswick-buttons\"><a class=\"chiswick-button btn-primary\" href=\"#book\"><i class=\"fal fa-chevron-down\"></i><span>Book Tickets</span></a><a class=\"chiswick-button btn-secondary\" data-lity=\"1\" data-action=\"play-trailer\" href=\"https://www.youtube.com/watch?v=Ma9oseKpj9g\"><i class=\"fal fa-play\"></i><span>Play Trailer</span></a></div><div class=\"film-details__synopsis\">Rumpelstiltskin tricks a mid-life crisis burdened Shrek into allowing himself to be erased from existence and cast in a dark alternate timeline where Rumpelstiltskin rules supreme.</div><div class=\"film-details__cast\"><h3 class=\"film-details__cast__header\">Cast</h3><div class=\"film-details__cast__list\">Mike Myers • Cameron Diaz • Eddie Murphy</div></div><div class=\"film-details__director-runtime\"><div class=\"film-details__director\"><h3 class=\"film-details__director__header\">Director</h3><div class=\"film-details__director__list\">Mike Mitchell</div></div><div class=\"film-details__running-time\"><h3 class=\"film-details__running-time__header\">Running Time</h3><div class=\"film-details__running-time__content\">93 minutes\n                            </div></div></div><div class=\"film-details__rating-description\"><div class=\"film-details__rating-description__content\">Contains mild fight scenes.</div></div></div></div><div class=\"film-details__book-tickets\" id=\"book\"><h2 class=\"film-details__book-tickets__title\">Book Tickets</h2><div class=\"film-details__book-tickets__inner\"><div class=\"film-details__book-tickets__intro\"><div class=\"film-details__book-tickets__intro__content\">Platinum Members get priority booking &#8211; please <a href=\"https://www.chiswickcinema.co.uk/sign-in/\" data-type=\"page\" data-id=\"615\">sign in</a> to access. <br><br>Public booking opens every Tuesday for the subsequent Friday to Thursday.</div></div><div class=\"film-details__book-tickets__content\"><h3 class=\"film-details__book-tickets__content__title\">Shrek Forever After<span class=\"film-details__rating\">U</span></h3><div class=\"film-details__book-tickets__schedule\"><div class=\"film-details__book-tickets__schedule__day\"><div class=\"film-details__book-tickets__schedule__day__label\">Sat 10 May</div><div class=\"film-details__book-tickets__schedule__day__times\"><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"10:00\" data-id=\"437625\" href=\"/tickets/437625\"><span>10:00</span><span data-tag=\"Kids Club\">Kids Club</span></a></div></div></div><div class=\"film-details__book-tickets__schedule__day\"><div class=\"film-details__book-tickets__schedule__day__label\">Sun 11 May</div><div class=\"film-details__book-tickets__schedule__day__times\"><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"10:00\" data-id=\"437626\" href=\"/tickets/437626\"><span>10:00</span><span data-tag=\"Kids Club\">Kids Club</span></a></div></div></div></div></div><script>\n                                jQuery(function($) {\n\n                                    var items = [];\n                                    var idx = 1;\n                                    var title = document.getElementsByClassName('film-details__title')[0].textContent;\n                                    var days = document.getElementsByClassName('film-details__book-tickets__schedule__day');\n                                    for(var i=0;i<days.length;i++) {\n                                        var day = days[i];\n                                        var screenings = day.getElementsByClassName('book__link');\n                                        for(var screeningIdx=0;screeningIdx<screenings.length;screeningIdx++) {\n                                            var screening = screenings[screeningIdx];\n                                            var tags = screening.getElementsByTagName('span');\n                                            var ic = [];\n                                            for(var tagIndex=1;tagIndex<tags.length;tagIndex++) {\n                                                ic.push(tags[tagIndex].textContent);\n                                            }\n                                            items.push({\n                                                item_id:screening.getAttribute('data-id'),\n                                                item_name:title,\n                                                index:idx++,\n                                                item_category:screening.getAttribute('data-time'),\n                                                item_category2:ic.join('|'),\n                                                item_category4:screening.title?screening.title:undefined\n                                            });\n                                        }\n                                    }\n                                    window.dataLayer.push({\n                                        event:'view_item_list',\n   