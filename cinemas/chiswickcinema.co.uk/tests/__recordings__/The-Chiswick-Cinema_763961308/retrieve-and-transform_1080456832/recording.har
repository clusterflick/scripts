details__image__container\"><img decoding=\"async\" class=\"film-details__image\" src=\"https://www.chiswickcinema.co.uk/wp-content/uploads/film_images/436946.d.jpg?cb=1741608133\" alt=\"Image for Black Bag\"><div class=\"film-details__image__overlay\"></div></div><div class=\"film-details__inner alignwide\"><div class=\"film-details__top\"><div class=\"film-details__top__left\"><h3>Browse</h3><a href=\"https://www.chiswickcinema.co.uk/films/a-minecraft-movie/\" class=\"film-details__browse-previous\" title=\"Previous\"><i class=\"fal fa-chevron-left\"></i></a><a href=\"https://www.chiswickcinema.co.uk/films/parasite/\" class=\"film-details__browse-next\" title=\"Next\"><i class=\"fal fa-chevron-right\"></i></a></div><div class=\"film-details__top__content\"><h1 class=\"film-details__title\">Black Bag<span class=\"film-details__rating\">15</span></h1><div class=\"film-details__buttons chiswick-buttons\"><a class=\"chiswick-button btn-primary\" href=\"#book\"><i class=\"fal fa-chevron-down\"></i><span>Book Tickets</span></a><a class=\"chiswick-button btn-secondary\" data-lity=\"1\" data-action=\"play-trailer\" href=\"https://www.youtube.com/watch?v=n_56L6WzLT8\"><i class=\"fal fa-play\"></i><span>Play Trailer</span></a></div><div class=\"film-details__synopsis\">From Director Steven Soderbergh, BLACK BAG is a gripping spy drama about legendary intelligence agents George Woodhouse and his beloved wife Kathryn. When she is suspected of betraying the nation, George faces the ultimate test – loyalty to his marriage or his country.</div><div class=\"film-details__cast\"><h3 class=\"film-details__cast__header\">Cast</h3><div class=\"film-details__cast__list\">Naomie Harris • Cate Blanchett • Pierce Brosnan • Michael Fassbender • Marisa Abela • Tom Burke • Regé-Jean Page</div></div><div class=\"film-details__director-runtime\"><div class=\"film-details__director\"><h3 class=\"film-details__director__header\">Director</h3><div class=\"film-details__director__list\">Steven Soderbergh</div></div><div class=\"film-details__running-time\"><h3 class=\"film-details__running-time__header\">Running Time</h3><div class=\"film-details__running-time__content\">94 minutes\n                            </div></div></div><div class=\"film-details__rating-description\"><div class=\"film-details__rating-description__content\">strong language, sex references, brief violence</div></div></div></div><div class=\"film-details__book-tickets\" id=\"book\"><h2 class=\"film-details__book-tickets__title\">Book Tickets</h2><div class=\"film-details__book-tickets__inner\"><div class=\"film-details__book-tickets__intro\"><div class=\"film-details__book-tickets__intro__content\">Platinum Members get priority booking &#8211; please <a href=\"https://www.chiswickcinema.co.uk/sign-in/\" data-type=\"page\" data-id=\"615\">sign in</a> to access. <br><br>Public booking opens every Tuesday for the subsequent Friday to Thursday.</div></div><div class=\"film-details__book-tickets__content\"><h3 class=\"film-details__book-tickets__content__title\">Black Bag<span class=\"film-details__rating\">15</span></h3><div class=\"film-details__book-tickets__schedule\"><div class=\"film-details__book-tickets__schedule__day\"><div class=\"film-details__book-tickets__schedule__day__label\">Mon 07 Apr</div><div class=\"film-details__book-tickets__schedule__day__times\"><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"18:00\" data-id=\"437728\" href=\"/tickets/437728\"><span>18:00</span></a></div><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"20:50\" data-id=\"437731\" href=\"/tickets/437731\"><span>20:50</span></a></div></div></div><div class=\"film-details__book-tickets__schedule__day\"><div class=\"film-details__book-tickets__schedule__day__label\">Tue 08 Apr</div><div class=\"film-details__book-tickets__schedule__day__times\"><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"18:00\" data-id=\"437741\" href=\"/tickets/437741\"><span>18:00</span></a></div><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"20:40\" data-id=\"437743\" href=\"/tickets/437743\"><span>20:40</span></a></div></div></div><div class=\"film-details__book-tickets__schedule__day\"><div class=\"film-details__book-tickets__schedule__day__label\">Wed 09 Apr</div><div class=\"film-details__book-tickets__schedule__day__times\"><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"12:30\" data-id=\"437748\" href=\"/tickets/437748\"><span>12:30</span></a></div><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"17:40\" data-id=\"437755\" href=\"/tickets/437755\"><span>17:40</span></a></div><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"20:20\" data-id=\"437757\" href=\"/tickets/437757\"><span>20:20</span></a></div></div></div><div class=\"film-details__book-tickets__schedule__day\"><div class=\"film-details__book-tickets__schedule__day__label\">Thu 10 Apr</div><div class=\"film-details__book-tickets__schedule__day__times\"><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"17:35\" data-id=\"437771\" href=\"/tickets/437771\"><span>17:35</span></a></div><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"20:20\" data-id=\"437775\" href=\"/tickets/437775\"><span>20:20</span></a></div></div></div></div></div><script>\n                                jQuery(function($) {\n\n                                    var items = [];\n                                    var idx = 1;\n                                    var title = document.getElementsByClassName('film-details__title')[0].textContent;\n                                    var days = document.getElementsByClassName('film-details__book-tickets__schedule__day');\n                                    for(var i=0;i<days.length;i++) {\n                                        var day = days[i];\n                                        var screenings = day.getElementsByClassName('book__link');\n                                        for(var screeningIdx=0;screeningIdx<screenings.length;screeningIdx++) {\n                                            var screening = screenings[screeningIdx];\n                                            var tags = screening.getElementsByTagName('span');\n                                            var ic = [];\n                                            for(var tagIndex=1;tagIndex<tags.length;tagIndex++) {\n                                                ic.push(tags[tagIndex].textContent);\n                                            }\n                                            items.push({\n                                                item_id:screening.getAttribute('data-id'),\n                                                item_name:title,\n                                                index:idx++,\n                                                item_category:screening.getAttribute('data-time'),\n                                                item_category2:ic.join('|'),\n                                                item_category4:screening.title?screening.title:undefined\n                                            });\n                                        }\n                                    }\n                                    window.dataLayer.push({\n                                        event:'view_item_list',\n                                        ecommerce:{\n                                            items:items\n                                        }\n                                    });\n                                })\n                            </script></div></div></div></div> \n\n<section class=\"chiswick__newsletter\" style=\"background-image:url(https://www.chiswickcinema.co.uk/wp-content/uploads/2021/03/Newsletter-Desktop-BG2.jpg)\" data-align=\"full\"><div class=\"chiswick__newsletter__inner\"><h3>Subscribe to our newsletter</h3><div class=\"chiswick__newsletter_