                });\n                                })\n                            </script></div></div></div></div> \n\n<section class=\"chiswick__newsletter\" style=\"background-image:url(https://www.chiswickcinema.co.uk/wp-content/uploads/2021/03/Newsletter-Desktop-BG2.jpg)\" data-align=\"full\"><div class=\"chiswick__newsletter__inner\"><h3>Subscribe to our newsletter</h3><div class=\"chiswick__newsletter__layout\"><div class=\"chiswick__newsletter__layout__content\"><p>Stay up to date with all the latest cinema news, including updates, membership news and more.</p></div><div class=\"chiswick__newsletter__form__wrapper\"><a href=\"/newsletter-signup/\">Your email address...</a></div></div><div><div class=\"chiswick__newsletter__privacy__wrapper\"><a href=\"https://www.chiswickcinema.co.uk/privacy-policy/\" data-type=\"page\" data-id=\"1048\">Read privacy policy</a></div></div></div></section>\t\n\t\t\n\t</div>\n\n<footer class=\"footer\" role=\"contentinfo\" itemscope itemtype=\"http://schema.org/WPFooter\">\n  <div id=\"inner-footer\" class=\"wrap cf\">\n    <div id=\"media_image-4\" class=\"widget-odd widget-first widget-1 logo-footer widget widget_media_image\"><h4 class=\"widgettitle\">The Chiswick Cinema – a Trafalgar Entertainment Cinema</h4><a href=\"/\"><img width=\"300\" height=\"83\" src=\"https://www.chiswickcinema.co.uk/wp-content/uploads/2021/03/TCC_Logo_White-300x83.png\" class=\"image wp-image-1947  attachment-medium size-medium\" alt=\"\" style=\"max-width: 100%; height: auto;\" title=\"The Chiswick Cinema – a Trafalgar Entertainment Cinema\" decoding=\"async\" loading=\"lazy\" srcset=\"https://www.chiswickcinema.co.uk/wp-content/uploads/2021/03/TCC_Logo_White-300x83.png 300w, https://www.chiswickcinema.co.uk/wp-content/uploads/2021/03/TCC_Logo_White-1024x282.png 1024w, https://www.chiswickcinema.co.uk/wp-content/uploads/2021/03/TCC_Logo_White-768x212.png 768w, https://www.chiswickcinema.co.uk/wp-content/uploads/2021/03/TCC_Logo_White-1600x441.