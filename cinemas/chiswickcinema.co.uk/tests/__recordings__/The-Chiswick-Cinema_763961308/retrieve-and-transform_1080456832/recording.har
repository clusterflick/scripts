0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"362797\",\"time\":\"2025-11-27T11:20:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"362798\",\"time\":\"2025-11-27T14:30:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"362799\",\"time\":\"2025-11-27T17:40:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser subtitled\\\"}\"},{\"id\":\"362800\",\"time\":\"2025-11-27T20:40:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"}]},{\"id\":\"29166\",\"name\":\"The Metropolitan Opera: Arabella\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-metropolitan-opera-arabella\",\"posterImage\":\"ylut73wxth1h738ag96y9mzx5553\",\"bannerImage\":\"jtjq6x8r2lfsv75an5lishv8bebw\",\"synopsis\":\"Strauss’s elegant romance brings the glamour and enchantment of 19th-century Vienna to cinemas worldwide in a sumptuous production by legendary director Otto Schenk that “is as beautiful as one could hope” (The New York Times). Soprano Rachel Willis-Sørensen stars as the title heroine, a young noblewoman in search of love on her own terms. Radiant soprano Louise Alder is her sister, Zdenka, and bass-baritone Tomasz Konieczny is the dashing count who sweeps Arabella off her feet.\",\"starring\":\"\",\"directedBy\":\"Nicholas Carter\",\"producedBy\":\"\",\"searchTerms\":\"\",\"duration\":270,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"lU0w-kpa_Wo\",\"trailerVideo\":null,\"releaseDate\":\"2025-11-22\",\"dateOfFirstShowing\":\"2025-11-22\",\"tmdbPopularityScore\":0.0466,\"tmdbId\":\"1479646\",\"dcmEdiMovieId\":\"465751\",\"dcmEdiMovieName\":\"ARABELLAÂ - MET OPERA 2025 (OPERA) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"362939\",\"time\":\"2025-11-22T18:00:00Z\",\"ticketsSold\":32,\"screenId\":\"440\",\"seatsRemaining\":69,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"362940\",\"time\":\"2025-11-24T12:30:00Z\",\"ticketsSold\":8,\"screenId\":\"440\",\"seatsRemaining\":93,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"31102\",\"name\":\"The Nightmare Before Christmas\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-nightmare-before-christmas\",\"posterImage\":\"soh33oxgchrv82iu7azh08vu3yeu\",\"bannerImage\":\"cro7beqzwqbr97eykonrvfuy74yb\",\"synopsis\":\"Can Christmas be saved? Bored with the same old scare-and-scream routine, Jack Skellington, the Pumpkin King of Halloween Town, longs to spread the joy of Christmas. But his merry mission puts Santa in jeopardy and creates a nightmare for good little boys and girls everywhere!\",\"starring\":\"Danny Elfman, Chris Sarandon, Catherine O'Hara\",\"directedBy\":\"Henry Selick\",\"producedBy\":\"Tim Burton, Denise Di Novi, Don Hahn\",\"searchTerms\":\"\",\"duration\":76,\"genre\":\"Fantasy\",\"allGenres\":\"Fantasy, Animation, Family\",\"rating\":\"PG\",\"trailerYoutubeId\":\"wr6N_hZyBCk\",\"trailerVideo\":null,\"releaseDate\":\"1993-10-09\",\"dateOfFirstShowing\":\"2025-11-22\",\"tmdbPopularityScore\":32.894,\"tmdbId\":\"9479\",\"dcmEdiMovieId\":\"788053\",\"dcmEdiMovieName\":\"The Nightmare Before Christmas (2D) [PG]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"362876\",\"time\":\"2025-11-22T10:30:00Z\",\"ticketsSold\":13,\"screenId\":\"442\",\"seatsRemaining\":47,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser kids-club christmas\\\"}\"},{\"id\":\"362877\",\"time\":\"2025-11-23T11:00:00Z\",\"ticketsSold\":3,\"screenId\":\"442\",\"seatsRemaining\":57,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser kids-club christmas\\\"}\"}]},{\"id\":\"31216\",\"name\":\"Misery\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"misery\",\"posterImage\":\"3vv5a218au0fct7m603toxweymm7\",\"bannerImage\":\"q75pdi742hwhrymt3hbrqfla0xox\",\"synopsis\":\"After a famous author is rescued from a car crash by a fan of his novels, he comes to realize that the care he is receiving is only the beginning of a nightmare of captivity and abuse.\",\"starring\":\"James Caan, Kathy Bates\",\"directedBy\":\"Rob Reiner\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":107,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"18\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=XHQ9CPRfDsw\",\"trailerVideo\":null,\"releaseDate\":\"2025-11-25\",\"dateOfFirstShowing\":\"2025-11-25\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"931930\",\"dcmEdiMovieName\":\"Misery (2D) [15]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"362966\",\"time\":\"2025-11-25T19:45:00Z\",\"ticketsSold\":7,\"screenId\":\"440\",\"seatsRemaining\":94,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser ad-free andreas-film-club\\\"}\"}]},{\"id\":\"29169\",\"name\":\"The Royal Ballet: Cinderella\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-royal-ballet-cinderella\",\"posterImage\":\"nf11lqgwde1sutl4av6a1wahzpsy\",\"bannerImage\":\"5iptjnw7qtfgjod19jet8yq1y7j1\",\"synopsis\":\"Stuck at home and put to work by her spoiled Step-Sisters, Cinderella’s life is dreary and dull.\\nEverything changes when she helps a mysterious woman out...With a little bit of magic, she is transported into an ethereal new world – one where fairies bring the gifts of the seasons, where pumpkins turn into carriages, and where true love awaits.\\nThis enchanting ballet by The Royal Ballet’s Founding Choreographer Frederick Ashton is a theatrical experience for all the family and will transport you into an ethereal world where a sprinkling of fairy dust makes dreams come true.\\n\\nRuntime TBC\",\"starring\":\"Fumi Kaneko, William Bracewell, Bennet Gartside, James Hay, Thomas Whitehead, Mayara Magri, Isabella Gasparini, Mariko Sasaki, Meaghan Grace Hinkis, Claire Calvert, Daichi Ikarash\",\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":195,\"genre\":null,\"allGenres\":null,\"rating\":\"12A\",\"trailerYoutubeId\":\"9B8DfHdFhvM\",\"trailerVideo\":null,\"releaseDate\":\"2025-11-25\",\"dateOfFirstShowing\":\"2025-11-25\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"466184\",\"dcmEdiMovieName\":\"CINDERELLA 2024 - ROH, LONDON 2025 (BALLET) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"368145\",\"time\":\"2025-11-25T19:15:00Z\",\"ticketsSold\":20,\"screenId\":\"441\",\"seatsRemaining\":81,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"362945\",\"time\":\"2025-12-02T13:00:00Z\",\"ticketsSold\":6,\"screenId\":\"440\",\"seatsRemaining\":95,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"31227\",\"name\":\"The Postman Always Rings Twice\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-postman-always-rings-twice\",\"posterImage\":\"feriteizy111n7xcqdq83tbtde42\",\"bannerImage\":\"d3kekbj8h1cw8oxjtqye3mjxxx4f\",\"synopsis\":\"About the film:\\n“Like Double Indemnity and Mildred Pierce, The Postman Always Rings Twice is based on a book by pulp novelist James M. Cain. Directed by Tay Garnett, it stars Lana Turner as Cora Smith – another one of film noir’s all-time great femme fatales – who seduces hapless drifter Frank Chambers (John Garfield) into murdering her diner-owning husband (Cecil Kellaway). Turner’s wonderful entrance scene alone is worth the price of admission.”\\n\\nAbout Noirvember:\\nLocal film critic and podcaster Matthew Turner returns for a second mini season of film noir classics, which will run exclusively at Chiswick Cinema throughout November 2025.\\n\\nBroadly speaking, the term film noir (coined by French film critics) refers to Hollywood thrillers and dramas from the 1940s and ’50s that were perceived to have a degree of darkness and cynicism, reflecting post-WII attitudes at the time. Film noir stories frequently revolve around crime, corruption, greed, illicit sex and murder, exposing the dark heart beating beneath the American Dream.\\n\\nJoin us for five film noir classics, all of which showcase key elements of the genre, from hard-boiled dialogue (derived from the detective novels that were often adapted into thrillers), voiceover narration and shadowy lighting to femme fatales, murder plots and decidely unhappy endings.\\n\\nLike last year, each film will be introduced by Matthew Turner, a lifelong film noir enthusiast, who will also be around in the bar after each screening. In addition, audiences are invited to post about the films online, using the hashtag #Noirvember, a great source of other film noir recommendations.\",\"starring\":\"Lana Turner, John Garfield, Cecil Kellaway\",\"directedBy\":\"Tay Garnett\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":108,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"PG\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=n2R4I84QS5M\",\"trailerVideo\":null,\"releaseDate\":\"2025-11-26\",\"dateOfFirstShowing\":\"2025-11-26\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"341942\",\"dcmEdiMovieName\":\"(DNU) Cliff Richard - The Great 80 Tour (Concert) (ANALOG) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"363029\",\"time\":\"2025-11-26T19:45:00Z\",\"ticketsSold\":29,\"screenId\":\"440\",\"seatsRemaining\":72,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser intro\\\"}\"}]},{\"id\":\"31110\",\"name\":\"Wake Up Dead Man\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"wake-up-dead-man\",\"posterImage\":\"mjcylvu2g8z2yx7o2rlzl0zqk7f9\",\"bannerImage\":\"z3hqcw5vjxor6iy9fqknih3pom4t\",\"synopsis\":\"Benoit Blanc (Daniel Craig) returns for his most dangerous case yet in the third and darkest chapter of Rian Johnson’s murder mystery opus. Starring Daniel Craig, Josh O’Connor, Glenn Close, Josh Brolin, Mila Kunis, Jeremy Renner, Kerry Washington, Andrew Scott, Cailee Spaeny, Daryl McCormack, and Thomas Haden Church.\",\"starring\":\"Daniel Craig, Josh O'Connor, Glenn Close\",\"directedBy\":\"Rian Johnson\",\"producedBy\":\"Rian Johnson, Ram Bergman\",\"searchTerms\":\"\",\"duration\":140,\"genre\":\"Comedy\",\"allGenres\":\"Comedy, Drama, Mystery\",\"rating\":\"TBC\",\"trailerYoutubeId\":\"eHM1K1JByBI\",\"trailerVideo\":null,\"releaseDate\":\"2025-11-26\",\"dateOfFirstShowing\":\"2025-11-26\",\"tmdbPopularityScore\":7.3262,\"tmdbId\":\"812583\",\"dcmEdiMovieId\":\"481193\",\"dcmEdiMovieName\":\"Wake Up Dead Man: A Knives Out Mystery [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"410\",\"showings\":[{\"id\":\"362801\",\"time\":\"2025-11-26T20:30:00Z\",\"ticketsSold\":0,\"screenId\":\"441\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"362802\",\"time\":\"2025-11-27T20:30:00Z\",\"ticketsSold\":0,\"screenId\":\"441\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"362742\",\"time\":\"2025-11-28T11:25:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"362743\",\"time\":\"2025-11-28T14:30:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"362744\",\"time\":\"2025-11-28T17:35:00Z\",\"ticketsSold\":5,\"screenId\":\"439\",\"seatsRemaining\":120,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"362745\",\"time\":\"2025-11-28T20:40:00Z\",\"ticketsSold\":2,\"screenId\":\"439\",\"seatsRemaining\":123,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"362746\",\"time\":\"2025-11-29T11:30:00Z\",\"ticketsSold\":1,\"screenId\":\"439\",\"s