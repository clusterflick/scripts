garentertainment.com/\" target=\"_blank\" rel=\"noopener\">Trafalgar Entertainment Cinema</a>.</p>\n</div>\n\t\t</div><div id=\"custom_html-2\" class=\"widget_text widget-even widget-last widget-2 widget widget_custom_html\"><div class=\"textwidget custom-html-widget\"><style>  \r\n\t.header .header-top {\r\n\t\tpadding-top: 35px;\r\n\t\tpadding-bottom: 35px;\r\n\t}\r\n\t.gift-section {\r\n\t\tborder-color: #555;\r\n\t}\r\n\t\r\n\t.gift-section .react-button.btn-large {\r\n\t\tmin-width: auto;\r\n\t}\r\n\t\r\n\t.chiswick__membership-types__list {\r\n \t grid-gap: 30px;\r\n\t}\r\n\r\n\t@media only screen and (min-width: 0px) and (max-width: 767px) {\r\n          div.eedee-gutenslider-pagination.swiper-pagination-clickable.swiper-pagination-bullets {\r\n            bottom: -5px;\r\n            text-align: left;\r\n          }\r\n\t}\r\n\t\r\n\t.static-content-child__title {\r\n\t\tline-height:normal;\r\n\t}\t\r\n     .static-content-child__title a {\r\n      text-decoration: none !important;\r\n    }\r\n\t\r\n\t.whats-on .title-bar__title {\r\n    margin-top: 15px;\r\n\t}\r\n\t.filter-bar .chiswick-button.btn-filter {\r\n\t\tfont-weight: normal;\r\n    font-size: 90%;\r\n\t}\r\n\t\r\n\t\r\n\t\r\n.tickets__tickets-select__membership-prompt::after {\r\n  content: \"We are currently experiencing an issue with the air conditioning in Screen 1. Please bear with us while this is resolved.\";\r\n  background: #0BA7C2;\r\n  width: 100%;\r\n  display: block;\r\n  padding: 10px 0px;\r\n  margin-bottom: 20px;\r\n  text-align: center;\r\n  border-radius: 5px;\r\n  font-weight: 500;\r\n  font-size: 16px;\r\n  color: white;\r\n}\r\n .tickets__tickets-select__membership-prompt__inner {\r\n\t\tdisplay:none;\r\n\t}\r\n\r\n.film-details__book-tickets__schedule__day__label {\r\n    padding-top: 10px;\r\n}\r\n\t\r\n\t.film-details__book-tickets__content {\r\n\t\tmargin-bottom: 50px;\r\n\t}\r\n\t\r\n\t\r\n.film-details__rating {\r\n \r\n  color: #CCC;\r\n}\r\n\r\n.book__link {\r\n      pa