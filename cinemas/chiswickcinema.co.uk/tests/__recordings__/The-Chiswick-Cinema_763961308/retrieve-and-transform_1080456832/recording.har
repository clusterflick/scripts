page menu-item-2240\"><a href=\"https://www.chiswickcinema.co.uk/gift-shop/\">Gift shop</a></li>\n<li class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-has-children menu-item-2359\"><a href=\"#\">Membership</a>\n<ul class=\"sub-menu\">\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-212594\"><a href=\"https://www.chiswickcinema.co.uk/become-a-member/\">Become a Member</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2358\"><a href=\"https://www.chiswickcinema.co.uk/gift-membership/\">Gift membership</a></li>\n</ul>\n</li>\n<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2111\"><a href=\"https://www.chiswickcinema.co.uk/private-hire/\">Private hire</a></li>\n<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-412128\"><a href=\"https://www.chiswickcinema.co.uk/advertise-with-us/\">Advertise with us</a></li>\n<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2356\"><a href=\"https://www.chiswickcinema.co.uk/faq/\">FAQ</a></li>\n</ul></div></div><div id=\"nav_menu-6\" class=\"widget-even widget-last widget-2 widget widget_nav_menu\"><div class=\"menu-sub-header-right-container\"><ul id=\"menu-sub-header-right\" class=\"menu\"><li id=\"menu-item-3256\" class=\"header-search-button menu-item menu-item-type-custom menu-item-object-custom menu-item-3256\"><a href=\"#\"><i class=\"far fa-search\" aria-hidden=\"true\"></i><span>Search</span></a></li>\n<li id=\"menu-item-4432\" class=\"my-sign-in menu-item menu-item-type-post_type menu-item-object-page menu-item-4432\"><a href=\"https://www.chiswickcinema.co.uk/sign-in/\"><i class=\"far fa-user-circle\" aria-hidden=\"true\"></i><span>Sign in</span></a></li>\n</ul></div></div>    </div>\n  </section>\n\t\t\t\t\t\n<div class=\"content\">\n\t\n\t\t\t<div class=\"film-details\" data-align=\"full\"><div class=\"film-details__image__container\"><img decoding=\"async\" class=\"film-details__image\" src=\"https://www.chiswickcinema.co.uk/wp-content/uploads/film_images/58157.d.jpg?cb=1661879730\" alt=\"Image for Shrek\"><div class=\"film-details__image__overlay\"></div></div><div class=\"film-details__inner alignwide\"><div class=\"film-details__top\"><div class=\"film-details__top__left\"><h3>Browse</h3><a href=\"https://www.chiswickcinema.co.uk/films/warfare/\" class=\"film-details__browse-previous\" title=\"Previous\"><i class=\"fal fa-chevron-left\"></i></a><a href=\"https://www.chiswickcinema.co.uk/films/the-golden-bowl-intro/\" class=\"film-details__browse-next\" title=\"Next\"><i class=\"fal fa-chevron-right\"></i></a></div><div class=\"film-details__top__content\"><h1 class=\"film-details__title\">Shrek<span class=\"film-details__rating\">U</span></h1><div class=\"film-details__buttons chiswick-buttons\"><a class=\"chiswick-button btn-primary\" href=\"#book\"><i class=\"fal fa-chevron-down\"></i><span>Book Tickets</span></a><a class=\"chiswick-button btn-secondary\" data-lity=\"1\" data-action=\"play-trailer\" href=\"https://www.youtube.com/watch?v=CwXOrWvPBPk\"><i class=\"fal fa-play\"></i><span>Play Trailer</span></a></div><div class=\"film-details__synopsis\">After his swamp is filled with magical creatures, an ogre agrees to rescue a princess for a villainous lord in order to get his land back.</div><div class=\"film-details__cast\"><h3 class=\"film-details__cast__header\">Cast</h3><div class=\"film-details__cast__list\">Mike Myers • Cameron Diaz • Eddie Murphy</div></div><div class=\"film-details__director-runtime\"><div class=\"film-details__director\"><h3 class=\"film-details__director__header\">Director</h3><div class=\"film-details__director__list\">Vicky Jenson • Andrew Andamson</div></div><div class=\"film-details__running-time\"><h3 class=\"film-details__running-time__header\">Running Time</h3><div class=\"film-details__running-time__content\">90 minutes\n                            </div></div></div><div class=\"film-details__rating-description\"><div class=\"film-details__rating-description__content\">Contains very mild bad language and mild comic violence.</div></div></div></div><div class=\"film-details__book-tickets\" id=\"book\"><h2 class=\"film-details__book-tickets__title\">Book Tickets</h2><div class=\"film-details__book-tickets__inner\"><div class=\"film-details__book-tickets__intro\"><div class=\"film-details__book-tickets__intro__content\">Platinum Members get priority booking &#8211; please <a href=\"https://www.chiswickcinema.co.uk/sign-in/\" data-type=\"page\" data-id=\"615\">sign in</a> to access. <br><br>Public booking opens every Tuesday for the subsequent Friday to Thursday.</div></div><div class=\"film-details__book-tickets__content\"><h3 class=\"film-details__book-tickets__content__title\">Shrek<span class=\"film-details__rating\">U</span></h3><div class=\"film-details__book-tickets__schedule\"><div class=\"film-details__book-tickets__schedule__day\"><div class=\"film-details__book-tickets__schedule__day__label\">Sat 19 Apr</div><div class=\"film-details__book-tickets__schedule__day__times\"><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"10:30\" data-id=\"437619\" href=\"/tickets/437619\"><span>10:30</span><span data-tag=\"Kids Club\">Kids Club</span></a></div></div></div><div class=\"film-details__book-tickets__schedule__day\"><div class=\"film-details__book-tickets__schedule__day__label\">Sun 20 Apr</div><div class=\"film-details__book-tickets__schedule__day__times\"><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"10:00\" data-id=\"437620\" href=\"/tickets/437620\"><span>10:00</span><span data-tag=\"Kids Club\">Kids Club</span></a></div></div></div></div></div><script>\n                                jQuery(function($) {\n\n                                    var items = [];\n                                    var idx = 1;\n                                    var title = document.getElementsByClassName('film-details__title')[0].textContent;\n                                    var days = document.getElementsByClassName('film-details__book-tickets__schedule__day');\n                                    for(var i=0;i<days.length;i++) {\n                                        var day = days[i];\n                                        var screenings = day.getElementsByClassName('book__link');\n                                        for(var screeningIdx=0;screeningIdx<screenings.length;screeningIdx++) {\n                                            var screening = screenings[screeningIdx];\n                                            var tags = screening.getElementsByTagName('span');\n                                            var ic = [];\n                                            for(var tagIndex=1;tagIndex<tags.length;tagIndex++) {\n                                                ic.push(tags[tagIndex].textContent);\n                                            }\n                                            items.push({\n                                                item_id:screening.getAttribute('data-id'),\n                                                item_name:title,\n                                                index:idx++,\n                                                item_category:screening.getAttribute('data-time'),\n                                                item_category2:ic.join('|'),\n                                                item_category4:screening.title?screening.title:undefined\n                                            });\n                                        }\n                                    }\n                                    window.dataLayer.push({\n                                        event:'view_item_list',\n                                        ecommerce:{\n                                            items:items\n                                        }\n                                    });\n                                })\n                            </script></div></div></div></div> \n\n<section class=\"chiswick__newsletter\" style=\"background-image:url(https://www.chiswickcinema.co.uk/wp-content/uploads/2021/03/Newsletter-Desktop-BG2.jpg)\" data-align=\"full\"><div class=\"chiswick__newsletter__inner\"><h3>Subscribe to our newsletter</h3><div class=\"chiswick__newsletter__layout\"><div class=\"chiswick__newsletter__layout__content\"><p>Stay up to date with all the latest cinema news, including updates, membership news and more.</p></div><div class=\"chiswick__newsletter__form__wrapper\"><a href=\"/newsletter-signup/\">Your email address...</a></div></div><div><div class=\"chiswick__newsletter__privacy__wrapper\"><a href=\"https://www.chiswickcinema.co.uk/privacy-policy/\" data-type=\"page\" data-id=\"1048\">Read privacy policy</a></div></div></div></section>\t\n\t\t\n\t</div>\n\n<footer class=\"footer\" role=\"contentinfo\" itemscope itemtype=\"http://schema.org/WPFooter\">\n  <div id=\"inner-footer\" class=\"wrap cf\">\n    <div id=\"media_image-4\" class=\"widget-odd widget-first widget-1 logo-footer widget widget_media_image\"><h4 class=\"widgettitle\">The Chiswick Cinema – a Trafalgar Entertainment Cinema</h4><a href=\"/\"><img width=\"300\" height=\"83\" src=\"https://www.chiswickcinema.co.uk/wp-content/uploads/2021/03/TCC_Logo_White-300x83.png\" class=\"image wp-image-1947  attachment-medium size-medium\" alt=\"\" style=\"max-width: 100%; height: auto;\" title=\"The Chiswick Cinema – a Trafalgar Entertainment Cinema\" decoding=\"async\" loading=\"lazy\" srcset=\"https://www.chiswickcinema.co.uk/wp-content/uploads/2021/03/TCC_Logo_White-300x83.png 300w, https://www.chiswickcinema.co.uk/wp-content/uploads/2021/03/TCC_Logo_White-1024x282.png 1024w, https://www.chiswickcinema.co.uk/wp-content/uploads/2021/03/TCC_Logo_White-768x212.png 768w, https://www.chiswickcinema.co.uk/wp-content/uploads/2021/03/TCC_Logo_White-1600x441.png 1600w, 