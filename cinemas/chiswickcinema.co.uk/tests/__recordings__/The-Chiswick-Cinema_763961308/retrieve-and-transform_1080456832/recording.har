\"><div class=\"film-details__image__container\"><img decoding=\"async\" class=\"film-details__image\" src=\"https://www.chiswickcinema.co.uk/wp-content/uploads/film_images/437618.d.jpg?cb=1743418934\" alt=\"Image for Four Mothers\"><div class=\"film-details__image__overlay\"></div></div><div class=\"film-details__inner alignwide\"><div class=\"film-details__top\"><div class=\"film-details__top__left\"><h3>Browse</h3><a href=\"https://www.chiswickcinema.co.uk/films/disneys-snow-white/\" class=\"film-details__browse-previous\" title=\"Previous\"><i class=\"fal fa-chevron-left\"></i></a><a href=\"https://www.chiswickcinema.co.uk/films/bridget-jones-mad-about-the-boy/\" class=\"film-details__browse-next\" title=\"Next\"><i class=\"fal fa-chevron-right\"></i></a></div><div class=\"film-details__top__content\"><h1 class=\"film-details__title\">Four Mothers<span class=\"film-details__rating\">15</span></h1><div class=\"film-details__buttons chiswick-buttons\"><a class=\"chiswick-button btn-primary\" href=\"#book\"><i class=\"fal fa-chevron-down\"></i><span>Book Tickets</span></a></div><div class=\"film-details__synopsis\">A struggling novelist who is forced to take care of three eccentric older women &#8211; and his own mother &#8211; over the course of one chaotic weekend in Dublin.</div><div class=\"film-details__cast\"><h3 class=\"film-details__cast__header\">Cast</h3><div class=\"film-details__cast__list\">Niamh Cusack • Fionnula Flanagan • Rory O&#8217;Neil • James McArdle • Dearbhla Molloy • Paddy Glynn • Stella McCusker • Gaetan Garcia • Gearoid Farrelly</div></div><div class=\"film-details__director-runtime\"><div class=\"film-details__director\"><h3 class=\"film-details__director__header\">Director</h3><div class=\"film-details__director__list\">Darren Thornton</div></div><div class=\"film-details__running-time\"><h3 class=\"film-details__running-time__header\">Running Time</h3><div class=\"film-details__running-time__content\">89 minutes\n                            </div></div></div><div class=\"film-details__rating-description\"><div class=\"film-details__rating-description__content\">very strong language, brief strong sex references</div></div></div></div><div class=\"film-details__book-tickets\" id=\"book\"><h2 class=\"film-details__book-tickets__title\">Book Tickets</h2><div class=\"film-details__book-tickets__inner\"><div class=\"film-details__book-tickets__intro\"><div class=\"film-details__book-tickets__intro__content\">Platinum Members get priority booking &#8211; please <a href=\"https://www.chiswickcinema.co.uk/sign-in/\" data-type=\"page\" data-id=\"615\">sign in</a> to access. <br><br>Public booking opens every Tuesday for the subsequent Friday to Thursday.</div></div><div class=\"film-details__book-tickets__content\"><h3 class=\"film-details__book-tickets__content__title\">Four Mothers<span class=\"film-details__rating\">15</span></h3><div class=\"film-details__book-tickets__schedule\"><div class=\"film-details__book-tickets__schedule__day\"><div class=\"film-details__book-tickets__schedule__day__label\">Mon 07 Apr</div><div class=\"film-details__book-tickets__schedule__day__times\"><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"15:10\" data-id=\"437724\" href=\"/tickets/437724\"><span>15:10</span></a></div><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"20:30\" data-id=\"437730\" href=\"/tickets/437730\"><span>20:30</span></a></div></div></div><div class=\"film-details__book-tickets__schedule__day\"><div class=\"film-details__book-tickets__schedule__day__label\">Tue 08 Apr</div><div class=\"film-details__book-tickets__schedule__day__times\"><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"12:30\" data-id=\"437735\" href=\"/tickets/437735\"><span>12:30</span></a></div></div></div><div class=\"film-details__book-tickets__schedule__day\"><div class=\"film-details__book-tickets__schedule__day__label\">Wed 09 Apr</div><div class=\"film-details__book-tickets__schedule__day__times\"><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"15:10\" data-id=\"437751\" href=\"/tickets/437751\"><span>15:10</span></a></div><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"20:30\" data-id=\"437758\" href=\"/tickets/437758\"><span>20:30</span></a></div></div></div><div class=\"film-details__book-tickets__schedule__day\"><div class=\"film-details__book-tickets__schedule__day__label\">Thu 10 Apr</div><div class=\"film-details__book-tickets__schedule__day__times\"><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"15:00\" data-id=\"437767\" href=\"/tickets/437767\"><span>15:00</span></a></div><div class=\"book__link__wrap\"><a class=\"book__link\" data-time=\"20:20\" data-id=\"437774\" href=\"/tickets/437774\"><span>20:20</span></a></div></div></div></div></div><script>\n                                jQuery(function($) {\n\n                                    var items = [];\n                                    var idx = 1;\n                                    var title = document.getElementsByClassName('film-details__title')[0].textContent;\n                                    var days = document.getElementsByClassName('film-details__book-tickets__schedule__day');\n                                    for(var i=0;i<days.length;i++) {\n                                        var day = days[i];\n                                        var screenings = day.getElementsByClassName('book__link');\n                                        for(var screeningIdx=0;screeningIdx<screenings.length;screeningIdx++) {\n                                            var screening = screenings[screeningIdx];\n                                            var tags = screening.getElementsByTagName('span');\n                                            var ic = [];\n                                            for(var tagIndex=1;tagIndex<tags.length;tagIndex++) {\n                                                ic.push(tags[tagIndex].textContent);\n                                            }\n                                            items.push({\n                                                item_id:screening.getAttribute('data-id'),\n                                                item_name:title,\n                                                index:idx++,\n                                                item_category:screening.getAttribute('data-time'),\n                                                item_category2:ic.join('|'),\n                                                item_category4:screening.title?screening.title:undefined\n                                            });\n                                        }\n                                    }\n                                    window.dataLayer.push({\n                                        event:'view_item_list',\n                                        ecommerce:{\n                                            items:items\n                                        }\n                                    });\n                                })\n                            </script></div></div></div></div> \n\n<section class=\"chiswick__newsletter\" style=\"background-image:url(https://www.chiswickcinema.co.uk/wp-content/uploads/2021/03/Newsletter-Desktop-BG2.jpg)\" data-align=\"full\"><div class=\"chiswick__newsletter__inner\"><h3>Subscribe to our newsletter</h3><div class=\"chiswick__newsletter__layout\"><div class=\"chiswick__newsletter__layout__content\"><p>Stay up to date with all the latest cinema news, including updates, membership news and more.</p></div><div class=\"chiswick__newsletter__form__wrapper\"><a href=\"/newsletter-signup/\">Your email address...</a></div></div><div><div class=\"chiswick__newsletter__privacy__wrapper\"><a href=\"https://www.chiswickcinema.co.uk/privacy-policy/\" data-type=\"page\" data-id=\"1048\">Read privacy policy</a></div></div></div></section>\t\n\t\t\