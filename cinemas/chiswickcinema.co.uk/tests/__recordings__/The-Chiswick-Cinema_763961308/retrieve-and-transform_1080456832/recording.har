ags = screening.getElementsByTagName('span');\n                                            var ic = [];\n                                            for(var tagIndex=1;tagIndex<tags.length;tagIndex++) {\n                                                ic.push(tags[tagIndex].textContent);\n                                            }\n                                            items.push({\n                                                item_id:screening.getAttribute('data-id'),\n                                                item_name:title,\n                                                index:idx++,\n                                                item_category:screening.getAttribute('data-time'),\n                                                item_category2:ic.join('|'),\n                                                item_category4:screening.title?screening.title:undefined\n                                            });\n                                        }\n                                    }\n                                    window.dataLayer.push({\n                                        event:'view_item_list',\n                                        ecommerce:{\n                                            items:items\n                                        }\n                                    });\n                                })\n                            </script></div></div></div></div> \n\n<section class=\"chiswick__newsletter\" style=\"background-image:url(https://www.chiswickcinema.co.uk/wp-content/uploads/2021/03/Newsletter-Desktop-BG2.jpg)\" data-align=\"full\"><div class=\"chiswick__newsletter__inner\"><h3>Subscribe to our newsletter</h3><div class=\"chiswick__newsletter__layout\"><div class=\"chiswick__newsletter__layout__content\"><p>Stay up to date with all the latest cinema news, including updates, membership news and more.</p></div><div class=\"chiswick__newsletter__form__wrapper\"><a href=\"/newsletter-signup/\">Your