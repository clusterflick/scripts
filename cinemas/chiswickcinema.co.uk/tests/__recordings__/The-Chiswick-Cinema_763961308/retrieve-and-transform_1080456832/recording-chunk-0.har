laying\",\"urlSlug\":\"the-housemaid\",\"posterImage\":\"dokm3czc80467runyrlk64kdy7vt\",\"bannerImage\":\"y3eu1x5q93av1xoxk8cz6qviyz3n\",\"synopsis\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous — a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"starring\":\"Sydney Sweeney, Hadi Ali, Amanda Seyfried\",\"directedBy\":\"Paul Feig\",\"producedBy\":\"Paul Feig, Todd Lieberman, Laura Allen Fischer\",\"searchTerms\":\"\",\"duration\":131,\"genre\":\"Mystery\",\"allGenres\":\"Mystery, Thriller\",\"rating\":\"15\",\"trailerYoutubeId\":\"kdDdlY2VPxw\",\"trailerVideo\":null,\"releaseDate\":\"2025-12-26\",\"dateOfFirstShowing\":\"2025-12-22\",\"tmdbPopularityScore\":157.488,\"tmdbId\":\"1368166\",\"dcmEdiMovieId\":\"456720\",\"dcmEdiMovieName\":\"HOUSEMAID, THE [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"410\",\"showings\":[{\"id\":\"381613\",\"time\":\"2025-12-22T20:30:00Z\",\"ticketsSold\":20,\"screenId\":\"442\",\"seatsRemaining\":40,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"381762\",\"time\":\"2025-12-23T20:00:00Z\",\"ticketsSold\":13,\"screenId\":\"443\",\"seatsRemaining\":3,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"381727\",\"time\":\"2025-12-24T17:40:00Z\",\"ticketsSold\":16,\"screenId\":\"443\",\"seatsRemaining\":0,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"381801\",\"time\":\"2025-12-26T14:45:00Z\",\"ti