            "text": "{\"data\":{\"movies\":{\"data\":[{\"id\":\"37992\",\"name\":\"The Odyssey\",\"showingStatus\":\"Now Playing\",\"urlSlug\":\"the-odyssey\",\"posterImage\":\"h905ddoz5u4het8qovdl98wci2nj\",\"bannerImage\":\"4u7i64jcgnxby6inwml55s44s22o\",\"synopsis\":\"Christopher Nolan’s next film, The Odyssey, is a mythic action epic shot across the world using brand new IMAX® film technology. The film brings Homer’s foundational saga to IMAX® film screens for the first time and opens in cinemas everywhere on July 17, 2026.\",\"starring\":\"Matt Damon, Tom Holland, Anne Hathaway\",\"directedBy\":\"Christopher Nolan\",\"producedBy\":\"Christopher Nolan, Emma Thomas\",\"searchTerms\":\"\",\"duration\":173,\"genre\":\"Adventure\",\"allGenres\":\"Adventure, Drama, Fantasy\",\"rating\":\"15\",\"trailerYoutubeId\":\"Sk6LZrA2JSQ\",\"trailerVideo\":null,\"releaseDate\":\"2026-07-17\",\"dateOfFirstShowing\":\"2026-07-17\",\"tmdbPopularityScore\":801.957,\"tmdbId\":\"1368337\",\"dcmEdiMovieId\":\"412037\",\"dcmEdiMovieName\":\"ODYSSEY, THE [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"410\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99100599992,\\\"daysShown\\\":11,\\\"nowPlayingOrHasPlayed\\\":true,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Subtitled\\\",\\\"Baby Friendly\\\",\\\"Dog Friendly\\\",\\\"Silver Screen \\\"],\\\"everyShowingsBadges\\\":[],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-films some-showings-51 some-showings-4k some-showings-laser some-showings-subtitled some-showings-baby-friendly some-showings-dog-friendly some-showings-silver-screen- showing-status-now-playing showing-status-now-playing-or-has-played\\\"}\",\"showings\":[{\"id\":\"446163\",\"time\":\"2026-07-17T11:25:00Z\",\"ticketsSold\":37,\"screenId\":\"439\",\"seatsRemaining\":88,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"464462\",\"time\":\"2026-07-17T12:10:00Z