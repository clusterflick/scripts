,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"448644\",\"time\":\"2026-08-10T16:00:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"448643\",\"time\":\"2026-08-10T19:05:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"448646\",\"time\":\"2026-08-11T16:00:00Z\",\"ticketsSold\":2,\"screenId\":\"439\",\"seatsRemaining\":123,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"448645\",\"time\":\"2026-08-11T19:05:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"448649\",\"time\":\"2026-08-12T09:50:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"baby-friendly\\\"}\"},{\"id\":\"448650\",\"time\":\"2026-08-12T12:55:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"448648\",\"time\":\"2026-08-12T16:00:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"448647\",\"time\":\"2026-08-12T19:05:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"448652\",\"time\":\"2026-08-13T16:00:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"448651\",\"time\":\"2026-08-13T19:05:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"}]},{\"id\":\"38539\",\"name\":\"David Byrne's American Utopia\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"david-byrnes-american-utopia\",\"posterImage\":\"0xmg1x55a9nd3rtqcvtke2dxy7g1\",\"bannerImage\":\"r2oagf2ruhx1n2iieaq19mf9dmwp\",\"synopsis\":\"\\u003cspan style=\\\"font-size: 14px;\\\"\\u003e‘Do we get stupider as we grow up?’ In his wildly popular Broadway show American Utopia, David Byrne reflects on human connections, life and how on earth we work through it. He joins the dots with his music and it all starts making sense. Spike Lee here transforms the production into immersive, dynamic cinema that radiates with astounding performances, inventive contemporary dance and political urgency.\\u0026nbsp;\\u003c/span\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003e\\u003cbr\\u003e\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eAmerican Utopia flows like an iridescent dream vision. Work by James Baldwin, Janelle Monáe and Kurt Schwitters is highlighted among exhilarating renditions of Byrne’s solo work, as well as Talking Heads classics. According to the multi-hyphenate, we love looking at humans more than anything else. Anti-fascist and anti-racist, Byrne illuminates our responsibility to care for one another as he and his co-performers burn down the house.\\u0026nbsp;\\u003c/span\\u003e\\u003c/div\\u003e\",\"starring\":\"David Byrne, Jacqueline Acevedo, Gustavo Di Dalva, Daniel Freedman, Chris Giarmo\",\"directedBy\":\"Spike Lee\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":105,\"genre\":null,\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=lg4hcgtjDPc\",\"trailerVideo\":null,\"releaseDate\":\"2026-08-05\",\"dateOfFirstShowing\":\"2026-08-05\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"328759\",\"dcmEdiMovieName\":\"David Byrne's American Utopia [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99301499994,\\\"daysShown\\\":14,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Event Cinema\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Event Cinema\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-event-cinema some-showings-51 some-showings-4k some-showings-laser some-showings-event-cinema every-showings-51 every-showings-4k every-showings-laser every-showings-event-cinema showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"447216\",\"time\":\"2026-08-05T19:00:00Z\",\"ticketsSold\":16,\"screenId\":\"440\",\"seatsRemaining\":85,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"39564\",\"name\":\"Paw Patrol: The Dino Movie\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"paw-patrol-the-dino-movie\",\"posterImage\":\"xgczgmfvyt906mfx1mhkbmxe080e\",\"bannerImage\":\"yxm2akycuc61i62umsfr5shfh4n5\",\"synopsis\":\"After their ship gets caught in a mysterious storm, the PAW Patrol pups crash land on an uncharted tropical island filled with dinosaurs. They meet Rex, a pup who has been stranded on the island for years and has become an expert in all things dino-related. When the PAW Patrol's archrival, Mayor Humdinger, begins recklessly mining in hopes of exploiting the island for its natural resources, he inadvertently causes a huge, dormant volcano to erupt. The PAW Patrol pups are thrown into a series of high-stakes, dino-sized rescues bigger than anything they've done before, as they must stop Humdinger before everything on the island goes extinct.\",\"starring\":\"Carter Young, Hayden Chamberlen, Mckenna Grace\",\"directedBy\":\"Cal Brunker\",\"producedBy\":\"Toni Stevens, Laura Clunie, Jennifer Dodge\",\"searchTerms\":\"\",\"duration\":88,\"genre\":\"Animation\",\"allGenres\":\"Animation, Adventure, Family, Comedy\",\"rating\":\"PG\",\"trailerYoutubeId\":\"CS3_xLd2a2E\",\"trailerVideo\":null,\"releaseDate\":\"2026-08-07\",\"dateOfFirstShowing\":\"2026-08-07\",\"tmdbPopularityScore\":5.4779,\"tmdbId\":\"1185806\",\"dcmEdiMovieId\":\"412518\",\"dcmEdiMovieName\":\"Paw patrol: the dino movie (2D) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"410\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99301699993,\\\"daysShown\\\":18,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-films some-showings-51 some-showings-4k some-showings-laser every-showings-51 every-showings-4k every-showings-laser showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"464749\",\"time\":\"2026-08-07T12:00:00Z\",\"ticketsSold\":0,\"screenId\":\"442\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"464750\",\"time\":\"2026-08-07T14:10:00Z\",\"ticketsSold\":0,\"screenId\":\"442\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"464751\",\"time\":\"2026-08-08T10:35:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"464752\",\"time\":\"2026-08-08T12:50:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"464753\",\"time\":\"2026-08-09T10:00:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"464754\",\"time\":\"2026-08-09T12:20:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"}]},{\"id\":\"39562\",\"name\":\"Nimrods: A Green Day Comedy\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"nimrods-a-green-day-comedy\",\"posterImage\":\"ofts4gwxs69or0x2dz3j4qk231h4\",\"bannerImage\":\"omkqg1s9n9rna1gnwerw9kerii9t\",\"synopsis\":\"\\u003cdiv\\u003eWhen Tommy receives a phone call inviting his band to open for Green Day on New Years Eve, he doesn’t realise it’s an elaborate prank by his older brother, Wayne. Desperate to believe his life is about to change, Tommy steals Wayne's car and begins driving his band from Kansas City to Los Angeles, hell Bent on getting there in three days. What follows is a rowdy and uproarious road trip across America, inspired by Green Day’s early days of touring in a van, years before the release of their breakout record Dookie.\\u003c/div\\u003e\",\"starring\":\"Mason Thames, Mckenna Grace, Ryan Foust\",\"directedBy\":\"Lee Kirk\",\"producedBy\":\"Billie Joe Armstrong, Mike Dirnt, Tré Cool, Tim Perell, Stella Bulochnikov\",\"searchTerms\":\"\",\"duration\":116,\"genre\":\"Comedy\",\"allGenres\":\"Comedy, Music\",\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-08-11\",\"dateOfFirstShowing\":\"2026-08-11\",\"tmdbPopularityScore\":2.755,\"tmdbId\":\"1432474\",\"dcmEdiMovieId\":null,\"dcmEdiMovieName\":\"No Match Found\",\"siteId\":\"170\",\"titleClassId\":\"410\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99302099994,\\\"daysShown\\\":23,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-films some-showings-51 some-showings-4k some-showings-laser every-showings-51 every-showings-4k every-showings-laser showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"464746\",\"time\":\"2026-08-11T19:15:00Z\",\"ticketsSold\":2,\"screenId\":\"442\",\"seatsRemaining\":58,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"464747\",\"time\":\"2026-08-14T17:00:00Z\",\"ticketsSold\":1,\"screenId\":\"442\",\"seatsRemaining\":59,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"}]},{\"id\":\"34872\",\"name\":\"International Dog Day: Isle Of Dogs\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"international-dog-day-isle-of-dogs\",\"posterImage\":\"ejp3sy6wgxwc29pz9oqie4b5azoz\",\"bannerImage\":\"jml99x6hymynipqphkxm94fz2ksy\",\"synopsis\":\"In the future, an outbreak of canine flu leads the mayor of a Japanese city to banish all dogs to an island that's a garbage dump. The outcasts must soon embark on an epic journey when a 12-year-old boy arrives on the island to find his beloved pet.\",\"starring\":\"Bryan Cranston, Koyu Rankin, Bob Balaban\",\"directedBy\":\"Wes Anderson\",\"producedBy\":\"Wes Anderson, Jeremy Dawson, Scott Rudin, Steven M. Rales\",\"searchTerms\":\"\",\"duration\":101,\"genre\":\"Adventure\",\"allGenres\":\"Adventure, Comedy, Animation\",\"rating\":\"PG\",\"trailerYoutubeId\":\"dt__kig8PVU\",\"trailerVideo\":null,\"releaseDate\":\"2018-03-23\",\"dateOfFirstShowing\":\"2026-08-25\",\"tmdbPopularityScore\":4.1097,\"tmdbId\":\"399174\",\"dcmEdiMovieId\":\"12290\",\"dcmEdiMovieName\":\"International Khiladi (2D) [15]\",\"siteId\":\"170\",\"titleClassId\":\"410\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99303499993,\\\"daysShown\\\":34,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Dog Friendly\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Dog Friendly\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-films some-showings-51 some-showings-4k some-showings-laser some-showings-dog-friendly every-showings-51 every-showings-4k every-showings-laser every-showings-dog-friendly showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"399600\",\"time\":\"2026-08-25T13:00:00Z\",\"ticketsSold\":18,\"screenId\":\"439\",\"seatsRemaining\":107,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser dog-friendly\\\"}\"}]},{\"id\":\"34891\",\"name\":\"The Talented Mr Ripley\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-talented-mr-ripley\",\"posterImage\":\"r6do756hu5gl18ltfvx5h0ckek2s\",\"bannerImage\":\"z20bs1guvnp3682ns77jl6m5tbg2\",\"synopsis\":null,\"starring\":\"Matt Damon, Gwyneth Paltrow, Jude Law, Cate Blanchett, Philip Seymour Hoffman, Jack Davenport, James Rebhorn, Sergio Rubini, Philip Baker Hall, Celia Weston, Rosario Fiorello, Stefania Rocca, Ivano Marescotti, Anna Longhi, Alessandro Fabrizi, Lisa Eichhorn, Caterina Deregibus\",\"directedBy\":\"Anthony Minghella\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":143,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=h4e-Si4oGEw\",\"trailerVideo\":null,\"releaseDate\":\"2026-08-27\",\"dateOfFirstShowing\":\"2026-08-27\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"484879\",\"dcmEdiMovieName\":\"#Runseokjin_Ep.Tour The Movie (Concert) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99303699994,\\\"daysShown\\\":36,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Ad Free\\\",\\\"Books On Film\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Ad Free\\\",\\\"Books On Film\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-51 some-showings-4k some-showings-laser some-showings-ad-free some-showings-books-on-film every-showings-51 every-showings-4k every-showings-laser every-showings-ad-free every-showings-books-on-film showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"399682\",\"time\":\"2026-08-27T18:45:00Z\",\"ticketsSold\":7,\"screenId\":\"440\",\"seatsRemaining\":94,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser ad-free books-on-film\\\"}\"}]},{\"id\":\"39058\",\"name\":\"Coriolanus\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"coriolanus\",\"posterImage\":\"0g2h3y36l1jmoge70zkud8kvvgym\",\"bannerImage\":\"sflf2erq0e4wyux703hfm07jiwik\",\"synopsis\":\"\\u003cp class=\\\"p1\\\" style=\\\"margin: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal;\\\"\\u003e\\u003cfont face=\\\"Helvetica Neue\\\"\\u003e\\u003cspan style=\\\"font-size: 13px;\\\"\\u003eDirected by and starring Ralph Fiennes with Brian Cox and Vanessa Redgrave. Set against the brutal background of a modern Balkan war, this is a brilliantly visceral study of a complex military hero who has to choose between loyalty to his class and his country.\\u003c/span\\u003e\\u003c/font\\u003e\\u003c/p\\u003e\\u003cp class=\\\"p1\\\" style=\\\"margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 13px; line-height: normal; font-family: \\u0026quot;Helvetica Neue\\u0026quot;;\\\"\\u003e\\u003cbr\\u003e\\u003c/p\\u003e\\u003cp class=\\\"p1\\\" style=\\\"margin: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal;\\\"\\u003e\\u003cfont face=\\\"Helvetica Neue\\\"\\u003e\\u003cspan style=\\\"font-size: 13px;\\\"\\u003eAbout the season:\\u0026nbsp;\\u003c/span\\u003e\\u003c/font\\u003e\\u003c/p\\u003e\\u003cp class=\\\"p1\\\" style=\\\"margin: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal;\\\"\\u003e\\u003cfont face=\\\"Helvetica Neue\\\"\\u003e\\u003cspan style=\\\"font-size: 13px;\\\"\\u003ePeople often say that if Shakespeare were alive today he would be writing for the movies. What is startling is how often, since the beginnings of cinema, his plays have been adapted for the screen.\\u0026nbsp;\\u003c/span\\u003e\\u003c/font\\u003e\\u003c/p\\u003e\\u003cp class=\\\"p1\\\" style=\\\"margin: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal;\\\"\\u003e\\u003cfont face=\\\"Helvetica Neue\\\"\\u003e\\u003cspan style=\\\"font-size: 13px;\\\"\\u003e\\u003cbr\\u003e\\u003c/span\\u003e\\u003c/font\\u003e\\u003c/p\\u003e\\u003cp class=\\\"p1\\\" style=\\\"margin: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal;\\\"\\u003e\\u003cfont face=\\\"Helvetica Neue\\\"\\u003e\\u003cspan style=\\\"font-size: 13px;\\\"\\u003eFollowing a highly successful season devoted to the work of Harold Pinter, Chiswick Cinema now focuses on the infinite variety of filmed Shakespeare and will accompany four major screenings with talks, supplementary showings and celebrity interviews.\\u003c/span\\u003e\\u003c/font\\u003e\\u003c/p\\u003e\",\"starring\":\"Ralph Fiennes, Gerald Butler, Vanessa Redgrave, Jessica Chastain, Paul Jesson, Brian Cox,James Nesbitt\",\"directedBy\":\"Ralph Fiennes\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":123,\"genre\":null,\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"bsYrGIQnmxo\",\"trailerVideo\":null,\"releaseDate\":\"2026-08-30\",\"dateOfFirstShowing\":\"2026-08-30\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"41435\",\"dcmEdiMovieName\":\"Coriolanus (2D) [15]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99303999994,\\\"daysShown\\\":39,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"Q\\\\u0026A\\\",\\\"Intro\\\",\\\"Shakespeare on Screen\\\"],\\\"everyShowingsBadges\\\":[\\\"Q\\\\u0026A\\\",\\\"Intro\\\",\\\"Shakespeare on Screen\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-qa some-showings-intro some-showings-shakespeare-on-screen every-showings-qa every-showings-intro every-showings-shakespeare-on-screen showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"465457\",\"time\":\"2026-08-30T18:30:00Z\",\"ticketsSold\":1,\"screenId\":\"440\",\"seatsRemaining\":100,\"displayMetaData\":\"{\\\"classes\\\":\\\"qa intro shakespeare-on-screen\\\"}\"}]},{\"id\":\"34345\",\"name\":\"Who's Afraid of Virginia Woolf?\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"whos-afraid-of-virginia-woolf\",\"posterImage\":\"8qhf7mcmk018d2xzi6rr2ra16tdm\",\"bannerImage\":\"2brtktiigykn39rbetk7ei26nbub\",\"synopsis\":\"Dive into film history and technique with handpicked classics. A friendly introduction and a post-film sociable discussion with film-maker Andrea Carnevali.\\n\\nAcademy Award Wins Best Actress, Best Supporting Actress, Best Cinematography, Best Art Direction, Best Costume Design \\nAcademy Award Nominations Best Picture, Best Actor, Best Supporting Actor, Best Director, Best Adapted Screenplay, Best Sound, Best Film Editing, Best Music \\n\\nEdward Albee's astounding journey into the hell of a stormy marriage blazes with powerhouse performances by Oscar winners Elizabeth Taylor and Sandy Dennis, and Oscar nominees Richard Burton and George Segal.\\n\\nThis taut and explosive drama is filled with suspense and a searing tension that is as compelling and riveting as any film ever to hit the cinema.\",\"starring\":\"Elizabeth Taylor, Richard Burton, George Segal, Sandy Dennis\",\"directedBy\":\"Mike Nichols\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":131,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=4vIUGN8CGjE\",\"trailerVideo\":null,\"releaseDate\":\"2026-09-03\",\"dateOfFirstShowing\":\"2026-09-03\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"8890083\",\"dcmEdiMovieName\":\"Who's Afraid Of Virginia Woolf? (2D) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99304399994,\\\"daysShown\\\":43,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Intro\\\",\\\"Ad Free\\\",\\\"Andrea's Film Club\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Intro\\\",\\\"Ad Free\\\",\\\"Andrea's Film Club\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-51 some-showings-4k some-showings-laser some-showings-intro some-showings-ad-free some-showings-andreas-film-club every-showings-51 every-showings-4k every-showings-laser every-showings-intro every-showings-ad-free every-showings-andreas-film-club showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"394979\",\"time\":\"2026-09-03T18:45:00Z\",\"ticketsSold\":16,\"screenId\":\"440\",\"seatsRemaining\":85,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser intro ad-free andreas-film-club\\\"}\"}]},{\"id\":\"39815\",\"name\":\"Love Me Tender\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"love-me-tender\",\"posterImage\":\"z0uij5iv9kp7xdlpmngld0a7ub2u\",\"bannerImage\":\"7lzoze63aocp18y7o5cccrdwjvu9\",\"synopsis\":\"At the end of summer, Clémence tells her ex-husband that she’s had relationships with women. Her life is turned upside down when he files to strip her of their son’s custody. Then begins a struggle of several years for Clémence to defend her right to be a mother and a woman – free to make her own choices. Based on novel by Constance Debre\",\"starring\":\"Vicky Krieps, Antoine Reinartz, Monia Chokri, Viggo Ferreira-Redier, Féodor Atkine\",\"directedBy\":\"Anna Cazenave Cambet\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":134,\"genre\":\"Drama\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"vjXkDg2KJT4\",\"trailerVideo\":null,\"releaseDate\":\"2026-09-12\",\"dateOfFirstShowing\":\"2026-09-12\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"8889360\",\"dcmEdiMovieName\":\"COMIZI D’AMORE (LOVE MEETINGS) (2D) [15]\",\"siteId\":\"170\",\"titleClassId\":\"410\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99305299994,\\\"daysShown\\\":52,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"Intro\\\",\\\"Ad Free\\\",\\\"French Impressions\\\"],\\\"everyShowingsBadges\\\":[\\\"Intro\\\",\\\"Ad Free\\\",\\\"French Impressions\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-films some-showings-intro some-showings-ad-free some-showings-french-impressions every-showings-intro every-showings-ad-free every-showings-french-impressions showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"466695\",\"time\":\"2026-09-12T10:00:00Z\",\"ticketsSold\":3,\"screenId\":\"440\",\"seatsRemaining\":98,\"displayMetaData\":\"{\\\"classes\\\":\\\"intro ad-free french-impressions\\\"}\"}]},{\"id\":\"35365\",\"name\":\"Quartermaine's Terms\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"quartermaines-terms\",\"posterImage\":\"rk7l9rq5fjovoqtqejdbc38e2l8t\",\"bannerImage\":\"e6l8zqmamst900c6069qepuir4nt\",\"synopsis\":\"Through staffroom conversations and passing years, the lonely, quietly devoted St John Quartermaine watches colleagues marry, separate, and pursue ambitions, while his own life stands poignantly still. Wry, humane, and deeply moving, it is a subtle study of time, disappointment, and endurance.\\n\\nGRAY MATTERS: The Films of Simon Gray\\n\\\"It is a curious thing, being alive... It's like living in a room with a clock that ticks the wrong time, but there's no one around to tell you.\\n\\nThe Chiswick Cinema are delighted to host this exclusive season celebrating the career of Simon Gray.\\n\\nAbout SIMON GRAY:\\nSimon Gray (1936 - 2008) was a British playwright, screenwriter, and novelist, best known for his deep and witty explorations of the human condition. His darkly comedic work often featured academic, middle-class characters caught in emotional or intellectual crisis, told with razor sharp dialogue. His ability to balance humour with existential despair has earned him a lasting place in theatre. His contemporary Harold Pinter, directed several of his plays.\\n\\nGray wrote novels, screenplays and candid memoirs that reflected on his work, health, smoking and depression. His style has a dryly intelligent rigor, with brilliant wit, self-deprecation and philosophic honesty often going hand in hand. Disillusionment, achievement, and the despair in everyday entrapments are a throughline to the psychologically complex texts.\",\"starring\":\"John Gielgud, Edward Fox, Eleanor Bron, Peter Jeffrey, Paul Jesson, Clibe Francis, Tessa Peake-Jones, Eiji Kusuhara\",\"directedBy\":\"Bill Hays\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":120,\"genre\":\"Drama\",\"allGenres\":null,\"rating\":\"18\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-09-13\",\"dateOfFirstShowing\":\"2026-09-13\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":null,\"dcmEdiMovieName\":\"No Match Found\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99305399994,\\\"daysShown\\\":53,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Simon Gray\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Simon Gray\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-51 some-showings-4k some-showings-laser some-showings-simon-gray every-showings-51 every-showings-4k every-showings-laser every-showings-simon-gray showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"405093\",\"time\":\"2026-09-13T15:30:00Z\",\"ticketsSold\":15,\"screenId\":\"440\",\"seatsRemaining\":86,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser simon-gray\\\"}\"}]},{\"id\":\"38119\",\"name\":\"Exhibition on Screen: James McNeill Whistler\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"exhibition-on-screen-james-mcneill-whistler\",\"posterImage\":\"eeqv53zq5alppv8e9e7anupjht7s\",\"bannerImage\":\"x2lwerbvz47h4qm7juhoor2zb4cc\",\"synopsis\":\"\\u003cdiv\\u003e\\u003cdiv\\u003e“An artist is not paid for his labour but for his vision.”\\u003c/div\\u003e\\u003cdiv\\u003e-- James McNeil Whistler\\u003c/div\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003eIn an era of great change and great beauty emerged the character of James McNeill Whistler. Considered by some to be one of the great innovators of 19th century art, he was a contemporary of the Impressionists, much admired by Van Gogh and Manet. Boldly experimental and famously witty, Whistler disrupted the strict conventions of Victorian society in pursuit of a new cult of beauty, creating “art for art’s sake” and earning himself a place in the history of great art. He found a parallel between painting and music, and entitled many of his paintings “arrangements”, “harmonies” and “nocturnes”, emphasizing the importance of tonal harmony in his work.\\u0026nbsp;\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003eHis most famous painting, Arrangement in Grey and Black No. 1 (1871), commonly known as Whistler’s Mother, is a revered and often parodied portrait of motherhood. It is arguably one of the most famous paintings in history and this film will unveil the artist behind the art. Tate Britain is now holding the first major retrospective of Whistler in three decades. This blockbuster exhibition promises to reawaken the world to just how important Whistler is to art history, uniting world-famous masterpieces with rarely seen works.\\u0026nbsp;\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003eExhibition on Screen will bring these stunning works and the incredible story behind them to cinemas around the world while the exhibition is still running, bringing this truly global artist to a global audience. This will be an unmissable chance to get to know this visually spectacular artist and the influence he has had on those who followed.\\u0026nbsp;\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003eMade in close collaboration with Tate Britain.\\u003c/div\\u003e\",\"starring\":null,\"directedBy\":\"David Bickerstaff\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":90,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-09-15\",\"dateOfFirstShowing\":\"2026-09-15\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"511703\",\"dcmEdiMovieName\":\"Exhibition On Screen: James Mcneill Whistler 2026 (Exhibition) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99305599994,\\\"daysShown\\\":60,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Event Cinema\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Event Cinema\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-event-cinema some-showings-51 some-showings-4k some-showings-laser some-showings-event-cinema every-showings-51 every-showings-4k every-showings-laser every-showings-event-cinema showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"454540\",\"time\":\"2026-09-15T17:00:00Z\",\"ticketsSold\":3,\"screenId\":\"440\",\"seatsRemaining\":98,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"454542\",\"time\":\"2026-09-20T16:15:00Z\",\"ticketsSold\":2,\"screenId\":\"442\",\"seatsRemaining\":58,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"39371\",\"name\":\"Little Miss Sunshine\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"little-miss-sunshine\",\"posterImage\":\"zi3alqaqw3hrv651ez8qcp6lq5og\",\"bannerImage\":\"is6t8c3tzsyi4uqkom1zs3h2l5xm\",\"synopsis\":\"\\u003cdiv\\u003eFather Richard (Greg Kinnear) is desperately trying to sell his motivational success program... with no success. Meanwhile, \\\"pro-honesty\\\" mom Sheryl (Toni Collette) lends support to her eccentric family, including her depressed brother (Steve Carell), fresh out of the hospital after being jilted by his lover. Then there are the younger Hoovers - the seven-year-old, would-be beauty queen Olive (Abigail Breslin) and Dwayne (Paul Dano), a Nietzsche-reading teen who has taken a vow of silence. Topping off the family is the foul-mouthed grandfather (Alan Arkin), whose outrageous behavior recently got him evicted from his retirement home. When Olive is invited to compete in the \\\"Little Miss Sunshine\\\" pageant in far-off California, the family piles into their rusted-out VW bus to rally behind her - with riotously funny results.\\u003c/div\\u003e\",\"starring\":\"Abigail Breslin, Greg Kinnear, Paul Dano\",\"directedBy\":\"Jonathan Dayton, Valerie Faris\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":99,\"genre\":\"Drama\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"wvwVkllXT80\",\"trailerVideo\":null,\"releaseDate\":\"2026-09-16\",\"dateOfFirstShowing\":\"2026-09-16\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"25442\",\"dcmEdiMovieName\":\"Little miss sunshine (2D) [15]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99305699994,\\\"daysShown\\\":56,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Knitflicks\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Knitflicks\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-51 some-showings-4k some-showings-laser some-showings-knitflicks every-showings-51 every-showings-4k every-showings-laser every-showings-knitflicks showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"463112\",\"time\":\"2026-09-16T19:00:00Z\",\"ticketsSold\":3,\"screenId\":\"442\",\"seatsRemaining\":57,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser knitflicks\\\"}\"}]},{\"id\":\"34892\",\"name\":\"Nickel Boys\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"nickel-boys\",\"posterImage\":\"ato94ssc9sjvqj65yqekg0bgboy0\",\"bannerImage\":\"sqdly13oofydcrcnvhosb0bt7wlh\",\"synopsis\":\"Chronicles the powerful friendship between two young Black teenagers navigating the harrowing trials of reform school together in Florida.\",\"starring\":\"Ethan Herisse, Brandon Wilson, Aunjanue Ellis-Taylor\",\"directedBy\":\"RaMell Ross\",\"producedBy\":\"Dede Gardner, Jeremy Kleiner, Joslyn Barnes, David Levine\",\"searchTerms\":\"\",\"duration\":140,\"genre\":\"Drama\",\"allGenres\":\"Drama\",\"rating\":\"12A\",\"trailerYoutubeId\":\"2jeti8dl1WI\",\"trailerVideo\":null,\"releaseDate\":\"2025-01-03\",\"dateOfFirstShowing\":\"2026-09-17\",\"tmdbPopularityScore\":3.9785,\"tmdbId\":\"1028196\",\"dcmEdiMovieId\":\"418151\",\"dcmEdiMovieName\":\"Nickel Boys (2D) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99305799993,\\\"daysShown\\\":57,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Ad Free\\\",\\\"Books On Film\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Ad Free\\\",\\\"Books On Film\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-51 some-showings-4k some-showings-laser some-showings-ad-free some-showings-books-on-film every-showings-51 every-showings-4k every-showings-laser every-showings-ad-free every-showings-books-on-film showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"399683\",\"time\":\"2026-09-17T18:45:00Z\",\"ticketsSold\":4,\"screenId\":\"440\",\"seatsRemaining\":97,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser ad-free books-on-film\\\"}\"}]},{\"id\":\"38111\",\"name\":\"Twenty Years of the Met in Cinemas: An Anniversary Celebration\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"twenty-years-of-the-met-in-cinemas-an-anniversary-celebratio\",\"posterImage\":\"zgpvn38jrg4ssl6c5qlsghdwpbpu\",\"bannerImage\":\"k2lu47w8t91zoarzdezoexjnkj01\",\"synopsis\":\"\\u003cp class=\\\"MsoNormal\\\" style=\\\"margin: 0cm 0cm 8pt; line-height: 18.4px; font-size: 12pt; font-family: Aptos, sans-serif;\\\"\\u003e\\u003cspan style=\\\"font-family: Calibri, sans-serif;\\\"\\u003e\\u003ci\\u003eTwenty Years of the Met in Cinemas\\u003c/i\\u003e is a celebration of the Met’s two decades of onstage glory as experienced in cinemas, featuring highlights from the company’s collection of more than 185 extraordinary onscreen performances. Hosted by star soprano Renée Fleming, this special presentation will showcase unforgettable moments from some of opera’s greatest stars, selected from the series’ vast archive of broadcasts featuring such remarkable artists as Lise Davidsen, Natalie Dessay, Joyce DiDonato, Juan Diego Flórez, Elīna Garanča, Dmitri Hvorostovsky, Jonas Kaufmann, Peter Mattei, Matthew Polenzani, Sondra Radvanovsky, Nadine Sierra, and, of course, Fleming herself.\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/span\\u003e\\u003c/p\\u003e\",\"starring\":\"Renée Fleming, Lise Davidsen, Natalie Dessay, Joyce DiDonato, Juan Diego Flórez, Elīna Garanča, Dmitri Hvorostovsky, Jonas Kaufmann, Peter Mattei, Matthew Polenzani, Sondra Radvanovsky, Nadine Sierra\",\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":180,\"genre\":null,\"allGenres\":null,\"rating\":null,\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-09-19\",\"dateOfFirstShowing\":\"2026-09-19\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"513744\",\"dcmEdiMovieName\":\"Llv Twenty Years Of The Met In Cinemas: An Anniversary Celebration - Met Opera 2026 (Opera) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99305999994,\\\"daysShown\\\":63,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Event Cinema\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Event Cinema\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-event-cinema some-showings-51 some-showings-4k some-showings-laser some-showings-event-cinema every-showings-51 every-showings-4k every-showings-laser every-showings-event-cinema showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"441987\",\"time\":\"2026-09-19T17:00:00Z\",\"ticketsSold\":6,\"screenId\":\"440\",\"seatsRemaining\":95,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"441988\",\"time\":\"2026-09-23T12:00:00Z\",\"ticketsSold\":2,\"screenId\":\"442\",\"seatsRemaining\":58,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"39059\",\"name\":\"Much Ado About Nothing\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"much-ado-about-nothing\",\"posterImage\":\"9flodydbwj17ub7ycfqamsfvd6zt\",\"bannerImage\":\"7mrq1ja899yaxt65gyfbv3cs86v7\",\"synopsis\":\"\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eDirected by and starring Kenneth Branagh with\\u0026nbsp;\\u003c/span\\u003eEmma Thompson and Denzel Washington. Filmed in Tuscany, this is a pictorially ravishing and emotionally stirring account of the way the wittily warring Beatrice and Benedick are tricked into confronting their love for each other.\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003e\\u003cbr\\u003e\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eAbout the season:\\u0026nbsp;\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003ePeople often say that if Shakespeare were alive today he would be writing for the movies. What is startling is how often, since the beginnings of cinema, his plays have been adapted for the screen.\\u0026nbsp;\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003e\\u003cbr\\u003e\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eFollowing a highly successful season devoted to the work of Harold Pinter, Chiswick Cinema now focuses on the infinite variety of filmed Shakespeare and will accompany four major screenings with talks, supplementary showings and celebrity interviews.\\u003c/span\\u003e\\u003c/div\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\",\"starring\":\"Kenneth Branagh, Emma Thompson, Denzel Washington, Keanu Reeves, Robert Sean Leonard, Richard Briers\",\"directedBy\":\"Kenneth Branagh\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":106,\"genre\":null,\"allGenres\":null,\"rating\":\"PG\",\"trailerYoutubeId\":\"rbSN4Lv_N4g\",\"trailerVideo\":null,\"releaseDate\":\"2026-09-20\",\"dateOfFirstShowing\":\"2026-09-20\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"123068\",\"dcmEdiMovieName\":\"Globe On Screen: Much Ado About Nothing - Shakespeare's Globe 2011 (Theatre) (2D) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99306099994,\\\"daysShown\\\":60,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"Q\\\\u0026A\\\",\\\"Intro\\\",\\\"Shakespeare on Screen\\\"],\\\"everyShowingsBadges\\\":[\\\"Q\\\\u0026A\\\",\\\"Intro\\\",\\\"Shakespeare on Screen\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-qa some-showings-intro some-showings-shakespeare-on-screen every-showings-qa every-showings-intro every-showings-shakespeare-on-screen showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"465458\",\"time\":\"2026-09-20T18:30:00Z\",\"ticketsSold\":3,\"screenId\":\"440\",\"seatsRemaining\":98,\"displayMetaData\":\"{\\\"classes\\\":\\\"qa intro shakespeare-on-screen\\\"}\"}]},{\"id\":\"38520\",\"name\":\"National Theatre Live: The Misanthrope\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"national-theatre-live-the-misanthrope\",\"posterImage\":\"093pcoatty9sslsiwap6oedrn8zs\",\"bannerImage\":\"dh9ui7oxw4p3hph6mettkk8qni7j\",\"synopsis\":\"\\u003cdiv\\u003eTelling the truth isn’t always that simple. Alice, a brilliant novelist, despises the carefully constructed lies of modern society.\\u003c/div\\u003e\\u003cdiv\\u003eBut the more she challenges those around her, the fiercer the backlash becomes. Soon, she must confront the price of speaking her truth in a world that would rather silence her.\\u003c/div\\u003e\\u003cdiv\\u003eFilmed live on stage at the National Theatre, Indhu Rubasingham directs Martin Crimp’s (Cyrano de Bergerac) highly\\u003c/div\\u003e\\u003cdiv\\u003eanticipated play.\\u003c/div\\u003e\",\"starring\":\"Sandra Oh, Paul Chahidi, Abigail Cruttenden\",\"directedBy\":\"Indhu Rubasingham, Christine Lalla\",\"producedBy\":\"\",\"searchTerms\":\"\",\"duration\":151,\"genre\":\"Drama\",\"allGenres\":\"Drama, Comedy\",\"rating\":\"TBC\",\"trailerYoutubeId\":\"M3HRY1tYTfg\",\"trailerVideo\":null,\"releaseDate\":\"2026-09-22\",\"dateOfFirstShowing\":\"2026-09-22\",\"tmdbPopularityScore\":1.4576,\"tmdbId\":\"1693710\",\"dcmEdiMovieId\":\"513373\",\"dcmEdiMovieName\":\"Untitled NT Live Event (22Nd Sep 2026) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99306299994,\\\"daysShown\\\":96,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Subtitled\\\",\\\"Event Cinema\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Event Cinema\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-event-cinema some-showings-51 some-showings-4k some-showings-laser some-showings-subtitled some-showings-event-cinema every-showings-51 every-showings-4k every-showings-laser every-showings-event-cinema showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"446755\",\"time\":\"2026-09-22T18:00:00Z\",\"ticketsSold\":19,\"screenId\":\"440\",\"seatsRemaining\":82,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"446756\",\"time\":\"2026-09-30T18:00:00Z\",\"ticketsSold\":8,\"screenId\":\"440\",\"seatsRemaining\":93,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"446757\",\"time\":\"2026-10-04T15:00:00Z\",\"ticketsSold\":5,\"screenId\":\"440\",\"seatsRemaining\":96,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"446758\",\"time\":\"2026-10-26T19:30:00Z\",\"ticketsSold\":4,\"screenId\":\"442\",\"seatsRemaining\":56,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser subtitled event-cinema\\\"}\"}]},{\"id\":\"34353\",\"name\":\"Fargo\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"fargo\",\"posterImage\":\"bqqcrbsbkw3m07h9cslorbkj81lq\",\"bannerImage\":\"fjqbdiye72v8b9hzbdzr8liuy8vn\",\"synopsis\":\"Dive into film history and technique with handpicked classics. A friendly introduction and a post-film sociable discussion with film-maker Andrea Carnevali.\\n\\nAcademy Award Wins Best Actress, Best Screenplay\\nAcademy Award Nominations Best Picture, Best Supporting Actor, Best Director, Best Cinematography, Best Editing\\n\\nThings go terribly awry when small-time Minnesota car salesman, Jerry Lundegaard, hires two thugs to kidnap his wife. Once people start dying, the very chipper and very pregnant Police Chief Marge Gunderson takes the case. Is she up to the challenge? You betcha.\",\"starring\":\"Frances McDormand, William H. Macy, Steve Buscemi, Peter Stormare, Harve Presnell\",\"directedBy\":\"Joel Coen, Ethan Coen\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":100,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=ju75Sd4yAZw\",\"trailerVideo\":null,\"releaseDate\":\"2026-09-23\",\"dateOfFirstShowing\":\"2026-09-23\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"329432\",\"dcmEdiMovieName\":\"Fargo (25Th Anniversary) (2D) [18]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99306399994,\\\"daysShown\\\":63,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Intro\\\",\\\"Ad Free\\\",\\\"Andrea's Film Club\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Intro\\\",\\\"Ad Free\\\",\\\"Andrea's Film Club\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-51 some-showings-4k some-showings-laser some-showings-intro some-showings-ad-free some-showings-andreas-film-club every-showings-51 every-showings-4k every-showings-laser every-showings-intro every-showings-ad-free every-showings-andreas-film-club showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"394980\",\"time\":\"2026-09-23T18:45:00Z\",\"ticketsSold\":6,\"screenId\":\"440\",\"seatsRemaining\":95,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser intro ad-free andreas-film-club\\\"}\"}]},{\"id\":\"38685\",\"name\":\"Butley\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"butley\",\"posterImage\":\"jutcukpgirk72pc69ehguf7v85t7\",\"bannerImage\":\"o3bgao5oy99f15dz3cptd2sd1pc9\",\"synopsis\":\"About the film:\\u003cdiv\\u003eA university lecturer, Ben Butley, shares his office and his flat with a former star pupil, Joey, now also a lecturer. Butley faces both the ultimate breakdown of his marriage and of his intense friendship with Joey. Butley’s painful discoveries are made against a background of petty university politics and unease about student dissent. He greets them with a blistering torrent of repartee and rhetoric.\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eGRAY MATTERS: The Films of Simon Gray\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003e\\\"It is a curious thing, being alive... It's like living in a room with a clock that ticks the wrong time, but there's no one around to tell you.\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003e\\u003cbr\\u003e\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eThe Chiswick Cinema are delighted to host this exclusive season celebrating the career of Simon Gray.\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003e\\u003cbr\\u003e\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eAbout SIMON GRAY:\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eSimon Gray (1936 - 2008) was a British playwright, screenwriter, and novelist, best known for his deep and witty explorations of the human condition. His darkly comedic work often featured academic, middle-class characters caught in emotional or intellectual crisis, told with razor sharp dialogue. His ability to balance humour with existential despair has earned him a lasting place in theatre. His contemporary Harold Pinter, directed several of his plays.\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003e\\u003cbr\\u003e\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eGray wrote novels, screenplays and candid memoirs that reflected on his work, health, smoking and depression. His style has a dryly intelligent rigor, with brilliant wit, self-deprecation and philosophic honesty often going hand in hand. Disillusionment, achievement, and the despair in everyday entrapments are a throughline to the psychologically complex texts.\\u003c/span\\u003e\\u003c/div\\u003e\\u003c/div\\u003e\",\"starring\":\"Alan Bates, Richard O’Callaghan, Michael Byrne, Jessica Tandy, Susan Engel, Georgina Hale, Simon Rouse, John Savident\",\"directedBy\":\"Harold Pinter\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":125,\"genre\":\"Drama\",\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"pXpcAILCXWw\",\"trailerVideo\":null,\"releaseDate\":\"2026-09-25\",\"dateOfFirstShowing\":\"2026-09-25\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":null,\"dcmEdiMovieName\":\"No Match Found\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99306599994,\\\"daysShown\\\":65,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Simon Gray\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Simon Gray\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-51 some-showings-4k some-showings-laser some-showings-simon-gray every-showings-51 every-showings-4k every-showings-laser every-showings-simon-gray showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"448704\",\"time\":\"2026-09-25T18:45:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser simon-gray\\\"}\"}]},{\"id\":\"38104\",\"name\":\"The Metropolitan Opera: Così fan tutte\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-metropolitan-opera-cos-fan-tutte\",\"posterImage\":\"dikg1pqxikdzciqtjs8tko4w1qui\",\"bannerImage\":\"0255efwbn47fu129d1q17wjvmrp5\",\"synopsis\":\"\\u003cdiv\\u003eThe Met: Live in HD season continues with Mozart’s satirical comedy of fickle young love. Phelim McDermott’s “colorful, inventive” (The New York Times) staging, inspired by Coney Island in the 1950s, sets the uproarious story at a boardwalk amusement park, where the two pairs of lovers at the heart of the tale find themselves on one emotional—and literal— thrill ride after another. Soprano Federica Lombardi and mezzo-soprano Samantha Hankey sing Fiordiligi and Dorabella, opposite tenor Duke Kim and baritone Andrey Zhilikhovsky as Ferrando and Guglielmo. Bass-baritone Gerald Finley reprises his portrayal of the cynical Don Alfonso, with soprano Ana María Martínez as the witty maid Despina.\\u003c/div\\u003e\",\"starring\":\"Federica Lombardi, Samantha Hankey\",\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":237,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-10-03\",\"dateOfFirstShowing\":\"2026-10-03\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"484879\",\"dcmEdiMovieName\":\"#Runseokjin_Ep.Tour The Movie (Concert) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99307399994,\\\"daysShown\\\":77,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Event Cinema\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Event Cinema\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-event-cinema some-showings-51 some-showings-4k some-showings-laser some-showings-event-cinema every-showings-51 every-showings-4k every-showings-laser every-showings-event-cinema showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"441989\",\"time\":\"2026-10-03T17:00:00Z\",\"ticketsSold\":7,\"screenId\":\"440\",\"seatsRemaining\":94,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"441990\",\"time\":\"2026-10-07T10:30:00Z\",\"ticketsSold\":6,\"screenId\":\"440\",\"seatsRemaining\":95,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"35314\",\"name\":\"Rear Window\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"rear-window\",\"posterImage\":\"xfe346efw87zmux8f4fvqg607yew\",\"bannerImage\":\"02kgv6qsucrhqpng33fkgvp6kmy1\",\"synopsis\":\"A wheelchair-bound photographer spies on his neighbors from his apartment window and becomes convinced one of them has committed murder.\",\"starring\":\"James Stewart, Grace Kelly, Wendell Corey\",\"directedBy\":\"Alfred Hitchcock\",\"producedBy\":\"\",\"searchTerms\":\"\",\"duration\":112,\"genre\":\"Thriller\",\"allGenres\":\"Thriller, Mystery\",\"rating\":\"PG\",\"trailerYoutubeId\":\"m01YktiEZCw\",\"trailerVideo\":null,\"releaseDate\":\"1954-08-01\",\"dateOfFirstShowing\":\"2026-10-06\",\"tmdbPopularityScore\":8.1495,\"tmdbId\":\"567\",\"dcmEdiMovieId\":\"13085\",\"dcmEdiMovieName\":\"Rear Window (Re: 2000) (2D) [U]\",\"siteId\":\"170\",\"titleClassId\":\"410\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99307699994,\\\"daysShown\\\":76,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Hitchock for Halloween\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Hitchock for Halloween\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-films some-showings-51 some-showings-4k some-showings-laser some-showings-hitchock-for-halloween every-showings-51 every-showings-4k every-showings-laser every-showings-hitchock-for-halloween showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"404455\",\"time\":\"2026-10-06T18:45:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser hitchock-for-halloween\\\"}\"}]},{\"id\":\"35315\",\"name\":\"The Lodger + Live Score by Hugo Max\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-lodger-live-score-by-hugo-max\",\"posterImage\":\"sz3izpy5kcs0zsnshyna4zwwiwmi\",\"bannerImage\":\"sv1vi1rxgv3p4wlf3o1ospphe58n\",\"synopsis\":\"One of Hitchcock’s first ever films is based on the story of Jack The Ripper. As the suspicion that a neighbour may not be all he seems, the cat- and-mouse tension reaches almost unbearable proportion.\\n\\nAbout Hugo Max:\\nViola player and filmmaker Hugo Max presents a UK tour accompanying Alfred Hitchcock’s 1927 silent masterwork The Lodger with live score.\\n\\nPacked with the stylistic flourishes and experimental trick shots that would become defining trademarks of Hitchcock’s film language, the third feature by the Master of Suspense is a gripping murder mystery propelled by Ivor Novello’s iconic central performance.\\n\\nHugo Max performs live improvised scores to silent films on solo viola, regularly soundtracking screenings at London’s Prince Charles Cinema and Picturehouse Cinemas. He has presented nationwide tours focussing on silent horror, expressionism and the films of F. W. Murnau.\\n\\nWebsite: https://hugomax.co.uk/scoring-silent-cinema\",\"starring\":\"Ivor Novello, June, Michael Keen, Marie Ault\",\"directedBy\":\"Alfred Hitchock\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":91,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"PG\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=dfyhFWoNARk\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-11\",\"dateOfFirstShowing\":\"2026-10-11\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"484879\",\"dcmEdiMovieName\":\"#Runseokjin_Ep.Tour The Movie (Concert) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99308199994,\\\"daysShown\\\":81,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Hitchock for Halloween\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Hitchock for Halloween\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-51 some-showings-4k some-showings-laser some-showings-hitchock-for-halloween every-showings-51 every-showings-4k every-showings-laser every-showings-hitchock-for-halloween showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"404456\",\"time\":\"2026-10-11T16:00:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser hitchock-for-halloween\\\"}\"}]},{\"id\":\"39372\",\"name\":\"Kinky Boots\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"kinky-boots\",\"posterImage\":\"0kuqt1nazfy6m3pdf8kk2z04rnzx\",\"bannerImage\":\"1oxlzfmc92aohkv59jtu46hx5iuv\",\"synopsis\":\"\\u003cdiv\\u003eCharles Price may have grown up with his father in the family shoe business in Northampton, central England, but he never thought that he would take his father's place. Charles has a chance encounter with the flamboyant drag queen cabaret singer Lola and everything changes.\\u003c/div\\u003e\",\"starring\":\"Nick Frost, Chiwetel Ejiofor, Linda Bassett, Joel Edgerton\",\"directedBy\":\"Julian Jarrold\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":102,\"genre\":\"Comedy\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"Ek7VcOkzzkM\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-14\",\"dateOfFirstShowing\":\"2026-10-14\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"22644\",\"dcmEdiMovieName\":\"Kinky boots (2D) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99308499994,\\\"daysShown\\\":84,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Knitflicks\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Knitflicks\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-51 some-showings-4k some-showings-laser some-showings-knitflicks every-showings-51 every-showings-4k every-showings-laser every-showings-knitflicks showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"463113\",\"time\":\"2026-10-14T19:00:00Z\",\"ticketsSold\":2,\"screenId\":\"442\",\"seatsRemaining\":58,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser knitflicks\\\"}\"}]},{\"id\":\"34906\",\"name\":\"Under the Skin\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"under-the-skin\",\"posterImage\":\"9ukkp9vrmul2gc2btrne9t52efr9\",\"bannerImage\":\"h0q38p72r54pf524fqis1wnt5sl3\",\"synopsis\":\"An alien entity inhabits the earthly form of a seductive young woman who combs the Scottish highways in search of the human prey it is here to plunder. It lures its isolated and forsaken male victims into an otherworldly dimension where they are stripped and consumed. But life in all its complexity starts to change the alien. It begins to see itself as 'she', as human, with tragic and terrifying consequences.\",\"starring\":\"Scarlett Johansson, Jeremy McWilliams, Lynsey Taylor MacKay\",\"directedBy\":\"Jonathan Glazer\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":108,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=J7bAZCOk0Sc\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-15\",\"dateOfFirstShowing\":\"2026-10-15\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"10702\",\"dcmEdiMovieName\":\"Under The Skin (1997) (2D) [18]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99308599994,\\\"daysShown\\\":85,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Ad Free\\\",\\\"Books On Film\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Ad Free\\\",\\\"Books On Film\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-51 some-showings-4k some-showings-laser some-showings-ad-free some-showings-books-on-film every-showings-51 every-showings-4k every-showings-laser every-showings-ad-free every-showings-books-on-film showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"399684\",\"time\":\"2026-10-15T18:45:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser ad-free books-on-film\\\"}\"}]},{\"id\":\"37994\",\"name\":\"The Metropolitan Opera: Macbeth\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-metropolitan-opera-macbeth\",\"posterImage\":\"uwuyzwtq6vcknlizboij4l1tjaay\",\"bannerImage\":\"9fqu8zrr23btflp7bmclypou5ex1\",\"synopsis\":\"Two of opera’s most extraordinary artists return to The Met: Live in HD for Verdi’s thrilling take on the immortal Shakespearean tale of the scheming couple determined to seize power at any cost. Following past triumphs in many of Verdi’s signature baritone roles, Quinn Kelsey is the Scottish king haunted by the ghosts of his murderous ascent to the throne, opposite Lise Davidsen—the world’s reigning dramatic soprano—as the power-mad Lady Macbeth, whose ruinous ambition damns them both. Met Music Director Yannick Nézet-Séguin takes the podium for a penetrating production by Louisa Proske, a brilliant young director making waves around the world. Rounding out the all-star cast are tenor Freddie De Tommaso as the heroic Macduff and bass-baritone Ryan Speedo Green as Macbeth’s friend-turned-victim Banquo. This production is part of the Met’s award-winning Live in HD series, bringing opera to cinemas across the globe.\",\"starring\":\"Quinn Kelsey, Lise Davidsen, Freddie De Tommaso, Ryan Speedo Green\",\"directedBy\":\"Louisa Proske\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":210,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"SdOflhu5-1E\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-20\",\"dateOfFirstShowing\":\"2026-10-17\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"511887\",\"dcmEdiMovieName\":\"Macbeth - Met Opera 2026 (Opera) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99308799994,\\\"daysShown\\\":91,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Event Cinema\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Event Cinema\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-event-cinema some-showings-51 some-showings-4k some-showings-laser some-showings-event-cinema every-showings-51 every-showings-4k every-showings-laser every-showings-event-cinema showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"441991\",\"time\":\"2026-10-17T17:00:00Z\",\"ticketsSold\":9,\"screenId\":\"440\",\"seatsRemaining\":92,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"441992\",\"time\":\"2026-10-21T11:30:00Z\",\"ticketsSold\":5,\"screenId\":\"441\",\"seatsRemaining\":96,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"35316\",\"name\":\"Sabotage\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"sabotage\",\"posterImage\":\"5xcw7mfmbveskem7n51pgxb3tlju\",\"bannerImage\":\"fbtlfp9j8ouhf7px20euhhx2zrbv\",\"synopsis\":\"Verloc, the manager of a London West End Cinema, is also the secret chief of a terrorist organisation planning to destroy the London Underground Network. For his next task, he must leave a highly explosive bomb at Piccadilly Circus Station.\",\"starring\":\"Sylvia Sidney, Oscar Homolka, John Loder, Desmond Tester, Joyce Barbour, Matthew Boulton\",\"directedBy\":\"Alfred Hitchcock\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":76,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"PG\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=e4Q2GvpiGVs\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-20\",\"dateOfFirstShowing\":\"2026-10-20\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"8890305\",\"dcmEdiMovieName\":\"Sabotage (1936) [PG]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99309099994,\\\"daysShown\\\":90,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Hitchock for Halloween\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Hitchock for Halloween\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-51 some-showings-4k some-showings-laser some-showings-hitchock-for-halloween every-showings-51 every-showings-4k every-showings-laser every-showings-hitchock-for-halloween showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"404457\",\"time\":\"2026-10-20T18:45:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser hitchock-for-halloween\\\"}\"}]},{\"id\":\"34354\",\"name\":\"The Omen\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-omen\",\"posterImage\":\"s1xldiwcublv5yroot1qubwftydh\",\"bannerImage\":\"o95nov4zesjvd481pfodnkuz64kt\",\"synopsis\":\"Dive into film history and technique with handpicked classics. A friendly introduction and a post-film sociable discussion with film-maker Andrea Carnevali.\\n\\nAcademy Award Wins Best Score\\nAcademy Award Nominations Best Song \\n\\nRobert Thorn, an American diplomat living in Rome, learns that his infant son died moments after birth. Rather than tell his wife Katherine the truth, which he fears would shatter her emotionally, Robert secretly arranges the adoption of another baby through the Catholic church. Years pass and the Thorn's child, Damien, has a happy, normal childhood. Robert is named Ambassador to the Court of Saint James, and the family relocates to a lavish estate in the English countryside. But their seemingly idyllic life begins to change when, during Damien's fifth birthday, the boy's nanny suddenly commits suicide.\\n\\nShortly thereafter, Robert is approached by Father Brennan, who claims he was present at the hospital when Damien's adoption took place. He is convinced that the boy is the son of the Devil, and that only a man named Bugenhagen, who lives in Israel, has the power to kill him. Robert initially believes the priest to be mad, but his faith begins to waiver as everyone around Damien is subjected to a series of freak, horrific incidents.\",\"starring\":\"Gregory Peck, Lee Remick, Harvey Spencer Stephens\",\"directedBy\":\"Richard Donner\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":111,\"genre\":\"Horror\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=sS-sXcx30O4\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-21\",\"dateOfFirstShowing\":\"2026-10-21\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"61260\",\"dcmEdiMovieName\":\"At The Very Last Moment – La Nuit De La Glisse (2D) [U]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99309199994,\\\"daysShown\\\":91,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Intro\\\",\\\"Ad Free\\\",\\\"Andrea's Film Club\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Intro\\\",\\\"Ad Free\\\",\\\"Andrea's Film Club\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-51 some-showings-4k some-showings-laser some-showings-intro some-showings-ad-free some-showings-andreas-film-club every-showings-51 every-showings-4k every-showings-laser every-showings-intro every-showings-ad-free every-showings-andreas-film-club showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"394981\",\"time\":\"2026-10-21T18:45:00Z\",\"ticketsSold\":7,\"screenId\":\"440\",\"seatsRemaining\":94,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser intro ad-free andreas-film-club\\\"}\"}]},{\"id\":\"39062\",\"name\":\"The Tragedy of Macbeth\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-tragedy-of-macbeth\",\"posterImage\":\"pa2adfms1v3ydy6tqcus5ah8odlf\",\"bannerImage\":\"59pwcbnrx6itf8nrmzqk6o21wrll\",\"synopsis\":\"Directed by Roman Polanski and starring Jon Finch and Francesca Annis. Polanski, who worked on the adaptation with Kenneth Tynan, treats the Macbeths as a young, sexy, power-hungry couple and creates up to the very final shot a chilling sense of foreboding.\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eAbout the season:\\u0026nbsp;\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003ePeople often say that if Shakespeare were alive today he would be writing for the movies. What is startling is how often, since the beginnings of cinema, his plays have been adapted for the screen.\\u0026nbsp;\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003e\\u003cbr\\u003e\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eFollowing a highly successful season devoted to the work of Harold Pinter, Chiswick Cinema now focuses on the infinite variety of filmed Shakespeare and will accompany four major screenings with talks, supplementary showings and celebrity interviews.\\u003c/span\\u003e\\u003c/div\\u003e\\u003c/div\\u003e\",\"starring\":\"Jon Finch, Francesca Annis, Martin Shaw, Terence Bayler, John Stride, Nicholas Selby, Stephen Chase, Paul Shelley, Maisie Macfarquhar, Elsie Taylor, Noelle Rimmington, Noel Davis, Sydney Bromley, Richard Pearson, Keith Chegwin\",\"directedBy\":\"Roman Polanski\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":134,\"genre\":null,\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"ox54sz3RSNo\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-25\",\"dateOfFirstShowing\":\"2026-10-25\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"484879\",\"dcmEdiMovieName\":\"#runseokjin_ep.tour the movie (concert) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99309599994,\\\"daysShown\\\":95,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"Q\\\\u0026A\\\",\\\"Intro\\\",\\\"Shakespeare on Screen\\\"],\\\"everyShowingsBadges\\\":[\\\"Q\\\\u0026A\\\",\\\"Intro\\\",\\\"Shakespeare on Screen\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-qa some-showings-intro some-showings-shakespeare-on-screen every-showings-qa every-showings-intro every-showings-shakespeare-on-screen showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"465459\",\"time\":\"2026-10-25T19:30:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"qa intro shakespeare-on-screen\\\"}\"}]},{\"id\":\"37995\",\"name\":\"The Royal Ballet: Manon\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-royal-ballet-manon\",\"posterImage\":\"j4tfwy2cf60ua7kpxif8wgz18g7s\",\"bannerImage\":\"6rjal9da0hxhg6q9eqavxyx5usje\",\"synopsis\":\"\\u003cdiv\\u003eIn the seedy underbelly of 18th-century Paris, money is king. Nothing is sacred – even love itself can be bought for the right price. A native of this hedonistic underworld, Manon is caught between twin desires when she falls in love with the student Des Grieux. Steadfast and devoted, he offers the possibility of an honourable life. Yet, the riches promised by the world of Parisian society remain tempting...\\u003c/div\\u003e\\u003cdiv\\u003eManon’s inner turmoil and struggle for survival lie at the devastating heart of Kenneth MacMillan’s 1974 adaptation of Abbé Prévost’s novel. In this signature work of The Royal Ballet, MacMillan’s nuanced understanding of human psychology makes for an unflinching look into the moral degradation of Manon’s Paris, while all its decadence and decay are brought to life through Jules Massenet’s score and Nicholas Georgiadis’s designs.\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\",\"starring\":null,\"directedBy\":\"Kenneth MacMillan\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":190,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"eRR1FiG__FU\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-27\",\"dateOfFirstShowing\":\"2026-10-27\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"500512\",\"dcmEdiMovieName\":\"Manon - Rbo, London 2026 (Ballet) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99309799994,\\\"daysShown\\\":103,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Event Cinema\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Event Cinema\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-event-cinema some-showings-51 some-showings-4k some-showings-laser some-showings-event-cinema every-showings-51 every-showings-4k every-showings-laser every-showings-event-cinema showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"442009\",\"time\":\"2026-10-27T19:15:00Z\",\"ticketsSold\":11,\"screenId\":\"441\",\"seatsRemaining\":90,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"442010\",\"time\":\"2026-11-02T13:30:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"35317\",\"name\":\"Marnie\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"marnie\",\"posterImage\":\"7bfglhk6h8gvwn9keuxosfyfu5et\",\"bannerImage\":\"e0gptjvt5y9pv055nj4pnfhdxv50\",\"synopsis\":\"Kleptomaniac Marnie Edgar, who moves from job to job and has a pathological fear of the colour red, is caught stealing by her latest employer Mark Rutland. Instead of turning her over to the police, Mark forces Marnie to marry him, convinced that he can get to the bottom of her psychosis...\",\"starring\":\"Tippi Hedren, Sean Connery, Martin Gabel\",\"directedBy\":\"Alfred Hitchcock\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":130,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=QV_2-v_dsAU\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-27\",\"dateOfFirstShowing\":\"2026-10-27\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"8890190\",\"dcmEdiMovieName\":\"Marnie (2D) [15]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99309799994,\\\"daysShown\\\":97,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Hitchock for Halloween\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Hitchock for Halloween\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-51 some-showings-4k some-showings-laser some-showings-hitchock-for-halloween every-showings-51 every-showings-4k every-showings-laser every-showings-hitchock-for-halloween showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"404466\",\"time\":\"2026-10-27T19:45:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser hitchock-for-halloween\\\"}\"}]},{\"id\":\"35318\",\"name\":\"The Birds\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-birds\",\"posterImage\":\"hu6sqo2oj0hl31s5efjvyl5nvqpt\",\"bannerImage\":\"92orcp4ie3t1lfgy2ti1xx4jdy2v\",\"synopsis\":\"Wealthy reformed party girl Melanie Daniels enjoys a brief flirtation with lawyer Mitch Brenner in a San Francisco pet shop and decides to follow him to his Bodega Bay home. Bearing a gift of two lovebirds, Melanie quickly strikes up a romance with Mitch while contending with his possessive mother and boarding at his ex-girlfriend's house. One day, during a birthday party for Mitch's younger sister, a flock of birds attacks the children in what seems to be a random incident. In fact, it signals the beginning of a massive and organised avian assault on the residents of the town - a mysterious spate of violence that no one can explain... and from which no one might come out alive\",\"starring\":\"Tippi Hedren, Rod Taylor, Suzanne Pleshette\",\"directedBy\":\"Alfred Hitchcock\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":119,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=0fJh2gIBOto\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-31\",\"dateOfFirstShowing\":\"2026-10-31\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"361559\",\"dcmEdiMovieName\":\"Hunger Games: The Ballad Of Songbirds And Snakes, The (2D) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99310199994,\\\"daysShown\\\":101,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Hitchock for Halloween\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Hitchock for Halloween\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-51 some-showings-4k some-showings-laser some-showings-hitchock-for-halloween every-showings-51 every-showings-4k every-showings-laser every-showings-hitchock-for-halloween showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"404467\",\"time\":\"2026-10-31T20:00:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser hitchock-for-halloween\\\"}\"}]},{\"id\":\"35433\",\"name\":\"In a Lonely Place\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"in-a-lonely-place\",\"posterImage\":\"9y2rqrvf0gbgtrdzvn0eurl85x0l\",\"bannerImage\":\"9t1y7hwtn0s32g3f7fb6jmhq9o55\",\"synopsis\":\"Local film critic and podcaster Matthew Turner returns for a third mini season of film noir classics, which will run exclusively at Chiswick Cinema throughout November 2026.\\n\\n\\\"Nicholas Ray's noir classic stars Humphrey Bogart in one of his greatest roles as Dix Steele, a troubled, violence-prone screenwriter who's accused of the murder of a young woman. Gloria Grahame (The Big Heat) plays Dix's kind-hearted neighbour, who initially clears his name and then begins to have doubts.\\\"\\n\\nSynopsis:\\nScreenwriter Dixon Steele, faced with the odious task of scripting a trashy bestseller, has hat-check girl Mildred Atkinson tell him the story in her own words. Later that night, Mildred is murdered and Steele is a prime suspect; his record of belligerence when angry and his macabre sense of humor tell against him. Fortunately, lovely neighbor Laurel Gray gives him an alibi. Laurel proves to be just what Steele needed, and their friendship ripens into love. Will suspicion, doubt, and Steele's inner demons come between them?nyop\",\"starring\":\"Humphrey Bogart, Gloria Grahame, Frank Lovejoy, Carl Benton Reid, Jeff Donnell\",\"directedBy\":\"Nicholas Ray\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":93,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"PG\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=68C2IFX60CU\",\"trailerVideo\":null,\"releaseDate\":\"2026-11-01\",\"dateOfFirstShowing\":\"2026-11-01\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"39877\",\"dcmEdiMovieName\":\"In A Lonely Place (Re: 2017) (2D) [PG]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99310299994,\\\"daysShown\\\":102,\\\"nowPlayingOrHasPlayed\\\":false,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Intro\\\",\\\"Ad Free\\\",\\\"Noirvember\\\"],\\\"everyShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Intro\\\",\\\"Ad Free\\\",\\\"Noirvember\\\"],\\\"leavesSoon\\\":false,\\\"lastDayTomorrow\\\":false,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-classics some-showings-51 some-showings-4k some-showings-laser some-showings-intro some-showings-ad-free some-showings-noirvember every-showings-51 every-showings-4k every-showings-laser every-showings-intro every-showings-ad-free every-showings-noirvember showing-status-on-sale\\\"}\",\"showings\":[{\"id\":\"406243\",\"time\":\"2026-11-01T19:45:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser intro ad-free noirvember\\\"}\"}]},{\"id\":\"35434\",\"name\":\"Farewell, My Lovely [a.k.a Murder, My Sweet]\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"farewell-my-lovely-aka-murder-my-sweet\",\"posterImage\":\"yao7uyjnd0xm9jzxh2czt02y5suy\",\"bannerImage\":\"ejgtaz8gnfxcy6pdjxjlf2d4627v\",\"synopsis\":\"Local film critic and podcaster Matthew Turner returns for a third mini season of film noir classics, which will run exclusively at Chiswick Cinema throughout November 2026.\\n\\n\\\"Former crooner Dick Powell stars as hard-boiled private eye Philip Marlowe, who's drawn into a web of crime and corruption when he's hired to locate Velma (Claire Trevor), the former girlfriend of hulking ex-con Moose Malloy (Mike Mazurki). Adapted from the classic detective novel by Raymond Chandler and released the same year as Double Indemnity, this is considered one of the pinnacles of film noir and a key influence on the genre.\\\"\\n\\nSynopsis:\\nAfter being hired to find an ex-con's former girlfriend, Philip Marlowe is drawn into a deeply complex web of mystery and deceit.\",\"starring\":\"Dick Powell, Claire Trevor, Anne Shirley\",\"directedBy\":\"Edward Dmytryk\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":95,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"PG\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=PHRDGxSL2o4\",\"trailerVideo\":null,\"releaseDate\":\"2026-11-04\",\"dateOfFirstShowing\":\"2026-11-04\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"927219\",\"dcmEdiMovieName\":\"Farewell, My Lovely (2D) [PG]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"displayMetaData\":\"{\\\"