,\"ticketsSold\":0,\"screenId\":\"441\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"466312\",\"time\":\"2026-07-27T14:10:00Z\",\"ticketsSold\":0,\"screenId\":\"442\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"466327\",\"time\":\"2026-07-28T11:55:00Z\",\"ticketsSold\":0,\"screenId\":\"442\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"466324\",\"time\":\"2026-07-28T14:20:00Z\",\"ticketsSold\":0,\"screenId\":\"442\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"466333\",\"time\":\"2026-07-29T12:20:00Z\",\"ticketsSold\":0,\"screenId\":\"443\",\"seatsRemaining\":16,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"466352\",\"time\":\"2026-07-30T11:50:00Z\",\"ticketsSold\":1,\"screenId\":\"440\",\"seatsRemaining\":100,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"}]},{\"id\":\"37447\",\"name\":\"Tuner\",\"showingStatus\":\"Now Playing\",\"urlSlug\":\"tuner\",\"posterImage\":\"r4h1eya0m08y4w5eqp4fbklej5yp\",\"bannerImage\":\"63gnmao6ur2ph7ueemeag035h6ag\",\"synopsis\":\"In Tuner, Academy Award-winning director Daniel Roher’s first narrative feature, Leo Woodall stars as a gifted young piano tuner whose heightened sense of hearing draws the attention of criminals, who see his talents as useful for opening safes as well as for tuning Steinways. With his once-promising musical career over, he works across New York with his mentor Harry Horowitz (Academy Award-winner Dustin Hoffman), encountering a range of characters, including composition student Ruthie (Havana Rose Liu), with whom he forges an unexpected connection. Niki’s safecracking work threatens his budding romance with Ruthie and pulls him into increasingly dangerous territory. Blending romance, drama, and the taut suspense of a heist thriller, Tuner also features performances from Tony Award-winner Tovah Feldshuh, Lior Raz, and Jean Reno.\",\"starring\":\"Leo Woodall, Havana Rose Liu, Dustin Hoffman\",\"directedBy\":\"Daniel Roher\",\"producedBy\":\"Teddy Schwarzman, Michael Heimler, Lila Yacoub, JoAnne Sellar\",\"searchTerms\":\"\",\"duration\":107,\"genre\":\"Crime\",\"allGenres\":\"Crime, Thriller, Comedy\",\"rating\":\"15\",\"trailerYoutubeId\":\"AfcmVGybiNQ\",\"trailerVideo\":null,\"releaseDate\":\"2026-05-25\",\"dateOfFirstShowing\":\"2026-05-25\",\"tmdbPopularityScore\":19.5519,\"tmdbId\":\"1340206\",\"dcmEdiMovieId\":\"495132\",\"dcmEdiMovieName\":\"Tuner [15]\",\"siteId\":\"170\",\"titleClassId\":\"410\",\"displayMetaData\":\"{\\\"magicSortValue\\\":99105899994,\\\"daysShown\\\":1,\\\"nowPlayingOrHasPlayed\\\":true,\\\"someShowingsBadges\\\":[\\\"5.1\\\",\\\"4K\\\",\\\"Laser\\\",\\\"Silver Screen \\\"],\\\"everyShowingsBadges\\\":[],\\\"leavesSoon\\\":true,\\\"lastDayTomorrow\\\":true,\\\"lastDayToday\\\":false,\\\"classes\\\":\\\"title-class-films some-showings-51 some-showings-4k some-showings-laser some-showings-silver-screen- showing-status-now-playing showing-status-now-playing-or-has-played leaves-soon last-day-tomorrow\\\"}\",\"showings\":[{\"id\":\"432937\",\"time\":\"2026-05-25T19:30:00Z\",\"ticketsSold\":16,\"screenId\":\"440\",\"seatsRemaining\":85,\"displayMetaData\":\"{\\\"classes\\\":\\\"members-preview\\\"}\"},{\"id\":\"441918\",\"time\":\"2026-05-29T13:45:00Z\",\"ticketsSold\":7,\"screenId\":\"439\",\"seatsRemaining\":118,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"432938\",\"time\":\"2026-05-29T16:50:00Z\",\"ticketsSold\":28,\"screenId\":\"442\",\"seatsRemaining\":32,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"441919\",\"time\":\"2026-05-29T19:35:00Z\",\"ticketsSold\":14,\"screenId\":\"443\",\"seatsRemaining\":2,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"441924\",\"time\":\"2026-05-30T10:50:00Z\",\"ticketsSold\":0,\"screenId\":\