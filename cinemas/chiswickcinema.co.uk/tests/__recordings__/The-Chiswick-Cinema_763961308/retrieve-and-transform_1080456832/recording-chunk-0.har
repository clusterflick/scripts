2T16:45:00Z\",\"ticketsSold\":0,\"screenId\":\"443\",\"seatsRemaining\":16,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"462550\",\"time\":\"2026-07-13T19:10:00Z\",\"ticketsSold\":2,\"screenId\":\"442\",\"seatsRemaining\":58,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"462030\",\"time\":\"2026-07-15T16:45:00Z\",\"ticketsSold\":0,\"screenId\":\"443\",\"seatsRemaining\":16,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"462040\",\"time\":\"2026-07-16T17:05:00Z\",\"ticketsSold\":0,\"screenId\":\"443\",\"seatsRemaining\":16,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"}]},{\"id\":\"38972\",\"name\":\"Exhibition On Screen: David Hockney at the Royal Academy of Arts\",\"showingStatus\":\"Has Played\",\"urlSlug\":\"david-hockney-at-the-royal-academy-of-arts\",\"posterImage\":\"3nijg7cpqdlli6ngvgn5ut5axtox\",\"bannerImage\":\"fnslgbtm59r10t573b0sjkxuq47q\",\"synopsis\":\"\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003e\\\"Privileged access to Hockney’s creativity”\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eGQ Magazine\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cdiv style=\\\"\\\"\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eWidely considered Britain’s most popular artist, David Hockney is a global sensation with exhibitions in London, New York, Paris and beyond, attracting millions of visitors worldwide. Now entering his 9th decade, Hockney shows absolutely no evidence of slowing down or losing his trademark boldness. Featuring intimate and in-depth interviews with Hockney, this revealing film focuses on two blockbuster exhibitions held in 2012 and 2016 at the Royal Academy of Art in London. Director Phil Grabsky secured privileged access to craft this cinematic celebration of a 21st century master of creativity.\\u003c/span\\u003e\\u003c/div\\u003e\\u003c/div\\u003e\",\"starring\":\"David Hockney\",\"directedBy\":\"Phil Grabsky\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":80,\"genre\":\"Documentary\",\"allGenres\":null,\"rating\":\"U\",\"trailerYoutubeId\":\"WGRjOzQ-S40\",\"trailerVideo\":null,\"releaseDate\":\"2026-07-09\",\"dateOfFirstShowing\":\"2026-07-09\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"226441\",\"dcmEdiMovieName\":\"Exhibition On Screen: Canaletto 2017 (Exhibition) (2D) [U]\",\"siteId\":\"170\",\"titleClassId\":\"420\",\"showings\":[{\"id\":\"454496\",\"time\":\"2026-07-09T17:00:00Z\",\"ticketsSold\":15,\"screenId\":\"442\",\"seatsRemaining\":45,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"462033\",\"time\":\"2026-07-15T14:30:00Z\",\"ticketsSold\":0,\"screenId\":\"441\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"silver-screen-\\\"}\"}]},{\"id\":\"32517\",\"name\":\"National Theatre Live: Les Liaisons Dangereuses\",\"showingStatus\":\"Has Played\",\"urlSlug\":\"national-theatre-live-les-liaisons-dangereuses\",\"posterImage\":\"6gwgu57hre8xtfidvef16xxffb69\",\"bannerImage\":\"ooynhfmstfiefzi2ykoful9jspb9\",\"synopsis\":\"BAFTA Award-winner Lesley Manville (Phantom Thread) joins Aidan Turner (Rivals) in a striking new staging of Christopher Hampton’s celebrated adaptation of the classic novel, where among the glittering salons of the super-rich, one misstep can mean ruin.\\nMarquise de Merteuil is a master in the art of survival. Alongside the magnetic Vicomte de Valmont, they turn seduction into strategy and weaponise desire. But when their alliance collapses into rivalry, the battle between them threatens to destroy everyone in their path.\\n\\nFilmed live on stage at the National Theatre, Marianne Elliott (Angels in America) directs this thrilling game of love, lies, and social warfare.\",\"starring\":\"Lesley Manville, Aidan Turner\",\"directedBy\":\"Marianne Elliott\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":180,\"genre\":null,\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"wq5l5VV51sU\",\"trailerVideo\":null,\"releaseDate\":\"2026-06-25\",\"dateOfFirstShowing\":\"2026-06-25\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"477673\",\"dcmEdiMovieName\":\"Untitled NT Live Event (25Th June 2026) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"375803\",\"time\":\"2026-06-25T18:00:00Z\",\"ticketsSold\":95,\"screenId\":\"440\",\"seatsRemaining\":6,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"453455\",\"time\":\"2026-07-03T12:20:00Z\",\"ticketsSold\":20,\"screenId\":\"440\",\"seatsRemaining\":81,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"453460\",\"time\":\"2026-07-16T18:15:00Z\",\"ticketsSold\":8,\"screenId\":\"441\",\"seatsRemaining\":93,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"453458\",\"time\":\"2026-07-22T12:10:00Z\",\"ticketsSold\":8,\"screenId\":\"441\",\"seatsRemaining\":93,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"450334\",\"time\":\"2026-07-29T12:50:00Z\",\"ticketsSold\":8,\"screenId\":\"441\",\"seatsRemaining\":93,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"453457\",\"time\":\"2026-08-10T18:30:00Z\",\"ticketsSold\":13,\"screenId\":\"440\",\"seatsRemaining\":88,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"453459\",\"time\":\"2026-08-19T18:30:00Z\",\"ticketsSold\":8,\"screenId\":\"440\",\"seatsRemaining\":93,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"453456\",\"time\":\"2026-09-04T12:00:00Z\",\"ticketsSold\":4,\"screenId\":\"442\",\"seatsRemaining\":56,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"32518\",\"name\":\"National Theatre Live: The Playboy Of The Western World\",\"showingStatus\":\"Has Played\",\"urlSlug\":\"national-theatre-live-the-playboy-of-the-western-world\",\"posterImage\":\"wcmywqmqlx0qjimte9he47g0ulnf\",\"bannerImage\":\"wa7v2x4ripi7xsfvvjcnmk3vyt7h\",\"synopsis\":\"Nicola Coughlan (Bridgerton) joins Éanna Hardwicke (The Sixth Commandment) and Siobhán McSweeney (Derry Girls) in John Millington Synge’s riveting play of youth and self-discovery.\\nPegeen Flaherty’s life is turned upside down when a young man walks into her pub claiming that he’s killed his father.\\nInstead of being shunned, the killer becomes a local hero and begins to win hearts, that is until a second man unexpectedly arrives on the scene…\\n\\nFilmed live on stage at the National Theatre, Caitríona McLaughlin directs this darkly funny tale full to\\nthe brim with secrets.\",\"starring\":\"Nicola Coughlan, Éanna Hardwicke, Siobhán McSweeney.\",\"directedBy\":\"Caitríona McLaughlin\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":157,\"genre\":null,\"allGenres\":null,\"rating\":\"12A\",\"trailerYoutubeId\":\"PBBNdzzlhbw\",\"trailerVideo\":null,\"releaseDate\":\"2026-05-28\",\"dateOfFirstShowing\":\"2026-05-28\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"477672\",\"dcmEdiMovieName\":\"Untitled NT Live Event (28Th May 2026) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"375802\",\"time\":\"2026-05-28T18:00:00Z\",\"ticketsSold\":62,\"screenId\":\"440\",\"seatsRemaining\":39,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"447191\",\"time\":\"2026-06-18T13:00:00Z\",\"ticketsSold\":5,\"screenId\":\"442\",\"seatsRemaining\":55,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"444774\",\"time\":\"2026-07-06T11:10:00Z\",\"ticketsSold\":11,\"screenId\":\"439\",\"seatsRemaining\":114,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"444775\",\"time\":\"2026-07-15T18:45:00Z\",\"ticketsSold\":9,\"screenId\":\"442\",\"seatsRemaining\":51,\"displayMetaData\":\"{\\\"classes\\\":\\\"subtitled\\\"}\"}]},{\"id\":\"29361\",\"name\":\"TCC Film Quiz\",\"showingStatus\":\"Has Played\",\"urlSlug\":\"tcc-film-quiz\",\"posterImage\":\"83jeout6dz2v4sg3otjt2nxwwed6\",\"bannerImage\":\"ngkjkp8tqmu9s9kucckoqqygpjq0\",\"synopsis\":\"Hosted by Ashley Fisher, our popular Film Quiz night is open to everyone and sees teams of up to six people compete based on their cinema knowledge. Spanning all genres and eras, and accessible to beginners, this fun night offers a selection of themed prizes. \\n\\nThe bar is open throughout. \\n\\nA fee of £3 per person is payable to the quiz host on the evening.\\n\\nAdvanced booking is strongly recommended.\",\"starring\":null,\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":210,\"genre\":null,\"allGenres\":null,\"rating\":null,\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2025-10-26\",\"dateOfFirstShowing\":\"2026-05-12\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":null,\"dcmEdiMovieName\":\"No Match Found\",\"siteId\":\"170\",\"titleClassId\":\"416\",\"showings\":[{\"id\":\"364653\",\"time\":\"2025-11-06T19:30:00Z\",\"ticketsSold\":0,\"screenId\":\"447\",\"seatsRemaining\":56,\"displayMetaData\":\"{\\\"classes\\\":\\\"lounge--terrace\\\"}\"},{\"id\":\"386589\",\"time\":\"2026-01-13T19:00:00Z\",\"ticketsSold\":0,\"screenId\":\"447\",\"seatsRemaining\":56,\"displayMetaData\":\"{\\\"classes\\\":\\\"lounge--terrace\\\"}\"},{\"id\":\"396105\",\"time\":\"2026-02-10T19:30:00Z\",\"ticketsSold\":0,\"screenId\":\"447\",\"seatsRemaining\":56,\"displayMetaData\":\"{\\\"classes\\\":\\\"lounge--terrace\\\"}\"},{\"id\":\"406971\",\"time\":\"2026-03-10T19:00:00Z\",\"ticketsSold\":0,\"screenId\":\"447\",\"seatsRemaining\":56,\"displayMetaData\":\"{\\\"classes\\\":\\\"lounge--terrace\\\"}\"},{\"id\":\"414948\",\"time\":\"2026-05-12T18:00:00Z\"