39\",\"seatsRemaining\":123,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"393985\",\"time\":\"2026-02-03T14:00:00Z\",\"ticketsSold\":2,\"screenId\":\"441\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"393984\",\"time\":\"2026-02-03T20:00:00Z\",\"ticketsSold\":0,\"screenId\":\"441\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"394002\",\"time\":\"2026-02-04T14:20:00Z\",\"ticketsSold\":0,\"screenId\":\"441\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"silver-screen-\\\"}\"},{\"id\":\"394001\",\"time\":\"2026-02-04T17:25:00Z\",\"ticketsSold\":4,\"screenId\":\"441\",\"seatsRemaining\":97,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"394028\",\"time\":\"2026-02-05T14:40:00Z\",\"ticketsSold\":0,\"screenId\":\"441\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"394027\",\"time\":\"2026-02-05T20:25:00Z\",\"ticketsSold\":0,\"screenId\":\"441\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"}]},{\"id\":\"33577\",\"name\":\"H Is For Hawk\",\"showingStatus\":\"Now Playing\",\"urlSlug\":\"h-is-for-hawk\",\"posterImage\":\"a0bttvc6e1x8pv1ig39vbquc3w9c\",\"bannerImage\":\"47ron809gksf574wdo34br981sb5\",\"synopsis\":\"When Helen's beloved father passes away, she is knocked sideways by grief and loses herself in memories of their time birding and exploring the natural world together. She becomes obsessed with the idea of training her own goshawk, and so she brings the fearsome bird Mabel home to her life as a graduate fellow at Cambridge. \\n\\nHelen fills the freezer with hawk food and turns off her phone, ready to embark on the long, strange business of trying to train this wildest of animals. But as she labours to tame Mabel, a grieving Helen undergoes an untaming of her own. \\n\\nA record of a spiritual journey, H IS FOR HAWK is a story about memory and nature and how it might be possible to reconcile death with life and love.\",\"starring\":\"Claire Foy, Brendan Gleeson, Angus Cooper\",\"directedBy\":\"Philippa Lowthorpe\",\"producedBy\":\"Lena Headey, Dede Gardner, Jeremy Kleiner\",\"searchTerms\":\"\",\"duration\":128,\"genre\":\"Drama\",\"allGenres\":\"Drama\",\"rating\":\"12A\",\"trailerYoutubeId\":\"RJ29BBXfN64\",\"trailerVideo\":null,\"releaseDate\":\"2026-01-23\",\"dateOfFirstShowing\":\"2026-01-23\",\"tmdbPopularityScore\":3.8577,\"tmdbId\":\"1243006\",\"dcmEdiMovieId\":\"477805\",\"dcmEdiMovieName\":\"H Is For Hawk [12A]\",\"siteId\":\"170\",\"titleClassId\":\"410\",\"showings\":[{\"id\":\"389824\",\"time\":\"2026-01-23T14:30:00Z\",\"ticketsSold\":8,\"screenId\":\"440\",\"seatsRemaining\":93,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"389823\",\"time\":\"2026-01-23T17:20:00Z\",\"ticketsSold\":11,\"screenId\":\"440\",\"seatsRemaining\":90,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"389822\",\"time\":\"2026-01-23T20:10:00Z\",\"ticketsSold\":8,\"screenId\":\"440\",\"seatsRemaining\":93,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"389825\",\"time\":\"2026-01-24T14:20:00Z\",\"ticketsSold\":13,\"screenId\":\"440\",\"seatsRemaining\":88,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"389826\",\"time\":\"2026-01-24T17:15:00Z\",\"ticketsSold\":28,\"screenId\":\"440\",\"seatsRemaining\":73,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"389827\",\"time\":\"2026-01-24T20:10:00Z\",\"ticketsSold\":7,\"screenId\":\"440\",\"seatsRemaining\":94,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"389828\",\"time\":\"2026-01-25T13:40:00Z\",\"ticketsSold\":7,\"screenId\":\"440\",\"seatsRemaining\":94,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"389829\",\"time\":\"2026-01-25T16:35:00Z\",\"ticketsSold\":28,\