439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"448645\",\"time\":\"2026-08-11T19:05:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"448649\",\"time\":\"2026-08-12T09:50:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"baby-friendly\\\"}\"},{\"id\":\"448650\",\"time\":\"2026-08-12T12:55:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"448648\",\"time\":\"2026-08-12T16:00:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"448647\",\"time\":\"2026-08-12T19:05:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"448652\",\"time\":\"2026-08-13T16:00:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"},{\"id\":\"448651\",\"time\":\"2026-08-13T19:05:00Z\",\"ticketsSold\":0,\"screenId\":\"439\",\"seatsRemaining\":125,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser\\\"}\"}]},{\"id\":\"38539\",\"name\":\"David Byrne's American Utopia\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"david-byrnes-american-utopia\",\"posterImage\":\"0xmg1x55a9nd3rtqcvtke2dxy7g1\",\"bannerImage\":\"r2oagf2ruhx1n2iieaq19mf9dmwp\",\"synopsis\":\"\\u003cspan style=\\\"font-size: 14px;\\\"\\u003e‘Do we get stupider as we grow up?’ In his wildly popular Broadway show American Utopia, David Byrne reflects on human connections, life and how on earth we work through it. He joins the dots with his music and it all starts making sense. Spike Lee here transforms the production into immersive, dynamic cinema that radiates with astounding performances, inventive contemporary dance and political urgency.\\u0026nbsp;\\u003c/span\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003e\\u003cbr\\u003e\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eAmerican Utopia flows like an iridescent dream vision. Work by James Baldwin, Janelle Monáe and Kurt Schwitters is highlighted among exhilarating renditions of Byrne’s solo work, as well as Talking Heads classics. According to the multi-hyphenate, we love looking at humans more than anything else. Anti-fascist and anti-racist, Byrne illuminates our responsibility to care for one another as he and his co-performers burn down the house.\\u0026nbsp;\\u003c/span\\u003e\\u003c/div\\u003e\",\"starring\":\"David Byrne, Jacqueline Acevedo, Gustavo Di Dalva, Daniel Freedman, Chris Giarmo\",\"directedBy\":\"Spike Lee\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":105,\"genre\":null,\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=lg4hcgtjDPc\",\"trailerVideo\":null,\"releaseDate\":\"2026-08-05\",\"dateOfFirstShowing\":\"2026-08-05\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"328759\",\"dcmEdiMovieName\":\"David Byrne's American Utopia [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"447216\",\"time\":\"2026-08-05T19:00:00Z\",\"ticketsSold\":8,\"screenId\":\"440\",\"seatsRemaining\":93,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"34872\",\"name\":\"International Dog Day: Isle Of Dogs\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"international-dog-day-isle-of-dogs\",\"posterImage\":\"ejp3sy6wgxwc29pz9oqie4b5azoz\",\"bannerImage\":\"jml99x6hymynipqphkxm94fz2ksy\",\"synopsis\":\"In the future, an outbreak of canine flu leads the mayor of a Japanese city to banish all dogs to an island that's a garbage dump. The outcasts must soon embark on an epic journey when a 12-year-old boy arrives on the island to find his beloved pet.\",\"starring\":\"Bryan Cranston, Koyu Rankin, Bob Balaban\",\"directedBy\":\"Wes Anderson\",\"producedBy\":\"Wes Anderson, Scott Rudin, Jeremy Dawson, Steven M. Rales\",\"searchTerms\":\"\",\"duration\":101,\"genre\":\"Adventure\",\"allGenres\":\"Adventure, Comedy, Animation\",\"rating\":\"PG\",\"trailerYoutubeId\":\"dt__kig8PVU\",\"trailerVideo\":null,\"releaseDate\":\"2018-03-23\",\"dateOfFirstShowing\":\"2026-08-25\",\"tmdbPopularityScore\":4.8571,\"tmdbId\":\"399174\",\"dcmEdiMovieId\":\"12290\",\"dcmEdiMovieName\":\"International Khiladi (2D) [15]\",\"siteId\":\"170\",\"titleClassId\":\"410\",\"showings\":[{\"id\":\"399600\",\"time\":\"2026-08-25T13:00:00Z\",\"ticketsSold\":18,\"screenId\":\"439\",\"seatsRemaining\":107,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser dog-friendly\\\"}\"}]},{\"id\":\"34891\",\"name\":\"The Talented Mr Ripley\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-talented-mr-ripley\",\"posterImage\":\"r6do756hu5gl18ltfvx5h0ckek2s\",\"bannerImage\":\"z20bs1guvnp3682ns77jl6m5tbg2\",\"synopsis\":null,\"starring\":\"Matt Damon, Gwyneth Paltrow, Jude Law, Cate Blanchett, Philip Seymour Hoffman, Jack Davenport, James Rebhorn, Sergio Rubini, Philip Baker Hall, Celia Weston, Rosario Fiorello, Stefania Rocca, Ivano Marescotti, Anna Longhi, Alessandro Fabrizi, Lisa Eichhorn, Caterina Deregibus\",\"directedBy\":\"Anthony Minghella\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":143,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=h4e-Si4oGEw\",\"trailerVideo\":null,\"releaseDate\":\"2026-08-27\",\"dateOfFirstShowing\":\"2026-08-27\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"484879\",\"dcmEdiMovieName\":\"#Runseokjin_Ep.Tour The Movie (Concert) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"399682\",\"time\":\"2026-08-27T18:45:00Z\",\"ticketsSold\":5,\"screenId\":\"440\",\"seatsRemaining\":96,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser ad-free books-on-film\\\"}\"}]},{\"id\":\"34345\",\"name\":\"Who's Afraid of Virginia Woolf?\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"whos-afraid-of-virginia-woolf\",\"posterImage\":\"8qhf7mcmk018d2xzi6rr2ra16tdm\",\"bannerImage\":\"2brtktiigykn39rbetk7ei26nbub\",\"synopsis\":\"Dive into film history and technique with handpicked classics. A friendly introduction and a post-film sociable discussion with film-maker Andrea Carnevali.\\n\\nAcademy Award Wins Best Actress, Best Supporting Actress, Best Cinematography, Best Art Direction, Best Costume Design \\nAcademy Award Nominations Best Picture, Best Actor, Best Supporting Actor, Best Director, Best Adapted Screenplay, Best Sound, Best Film Editing, Best Music \\n\\nEdward Albee's astounding journey into the hell of a stormy marriage blazes with powerhouse performances by Oscar winners Elizabeth Taylor and Sandy Dennis, and Oscar nominees Richard Burton and George Segal.\\n\\nThis taut and explosive drama is filled with suspense and a searing tension that is as compelling and riveting as any film ever to hit the cinema.\",\"starring\":\"Elizabeth Taylor, Richard Burton, George Segal, Sandy Dennis\",\"directedBy\":\"Mike Nichols\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":131,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=4vIUGN8CGjE\",\"trailerVideo\":null,\"releaseDate\":\"2026-09-03\",\"dateOfFirstShowing\":\"2026-09-03\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"8890083\",\"dcmEdiMovieName\":\"Who's Afraid Of Virginia Woolf? (2D) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"394979\",\"time\":\"2026-09-03T18:45:00Z\",\"ticketsSold\":15,\"screenId\":\"440\",\"seatsRemaining\":86,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser intro ad-free andreas-film-club\\\"}\"}]},{\"id\":\"35365\",\"name\":\"Quartermaine's Terms\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"quartermaines-terms\",\"posterImage\":\"rk7l9rq5fjovoqtqejdbc38e2l8t\",\"bannerImage\":\"e6l8zqmamst900c6069qepuir4nt\",\"synopsis\":\"Through staffroom conversations and passing years, the lonely, quietly devoted St John Quartermaine watches colleagues marry, separate, and pursue ambitions, while his own life stands poignantly still. Wry, humane, and deeply moving, it is a subtle study of time, disappointment, and endurance.\\n\\nGRAY MATTERS: The Films of Simon Gray\\n\\\"It is a curious thing, being alive... It's like living in a room with a clock that ticks the wrong time, but there's no one around to tell you.\\n\\nThe Chiswick Cinema are delighted to host this exclusive season celebrating the career of Simon Gray.\\n\\nAbout SIMON GRAY:\\nSimon Gray (1936 - 2008) was a British playwright, screenwriter, and novelist, best known for his deep and witty explorations of the human condition. His darkly comedic work often featured academic, middle-class characters caught in emotional or intellectual crisis, told with razor sharp dialogue. His ability to balance humour with existential despair has earned him a lasting place in theatre. His contemporary Harold Pinter, directed several of his plays.\\n\\nGray wrote novels, screenplays and candid memoirs that reflected on his work, health, smoking and depression. His style has a dryly intelligent rigor, with brilliant wit, self-deprecation and philosophic honesty often going hand in hand. Disillusionment, achievement, and the despair in everyday entrapments are a throughline to the psychologically complex texts.\",\"starring\":\"John Gielgud, Edward Fox, Eleanor Bron, Peter Jeffrey, Paul Jesson, Clibe Francis, Tessa Peake-Jones, Eiji Kusuhara\",\"directedBy\":\"Bill Hays\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":120,\"genre\":\"Drama\",\"allGenres\":null,\"rating\":\"18\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-09-13\",\"dateOfFirstShowing\":\"2026-09-13\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":null,\"dcmEdiMovieName\":\"No Match Found\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"405093\",\"time\":\"2026-09-13T15:30:00Z\",\"ticketsSold\":11,\"screenId\":\"440\",\"seatsRemaining\":90,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser simon-gray\\\"}\"}]},{\"id\":\"38119\",\"name\":\"Exhibition on Screen: James McNeill Whistler\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"exhibition-on-screen-james-mcneill-whistler\",\"posterImage\":\"eeqv53zq5alppv8e9e7anupjht7s\",\"bannerImage\":\"x2lwerbvz47h4qm7juhoor2zb4cc\",\"synopsis\":\"\\u003cdiv\\u003e\\u003cdiv\\u003e“An artist is not paid for his labour but for his vision.”\\u003c/div\\u003e\\u003cdiv\\u003e-- James McNeil Whistler\\u003c/div\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003eIn an era of great change and great beauty emerged the character of James McNeill Whistler. Considered by some to be one of the great innovators of 19th century art, he was a contemporary of the Impressionists, much admired by Van Gogh and Manet. Boldly experimental and famously witty, Whistler disrupted the strict conventions of Victorian society in pursuit of a new cult of beauty, creating “art for art’s sake” and earning himself a place in the history of great art. He found a parallel between painting and music, and entitled many of his paintings “arrangements”, “harmonies” and “nocturnes”, emphasizing the importance of tonal harmony in his work.\\u0026nbsp;\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003eHis most famous painting, Arrangement in Grey and Black No. 1 (1871), commonly known as Whistler’s Mother, is a revered and often parodied portrait of motherhood. It is arguably one of the most famous paintings in history and this film will unveil the artist behind the art. Tate Britain is now holding the first major retrospective of Whistler in three decades. This blockbuster exhibition promises to reawaken the world to just how important Whistler is to art history, uniting world-famous masterpieces with rarely seen works.\\u0026nbsp;\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003eExhibition on Screen will bring these stunning works and the incredible story behind them to cinemas around the world while the exhibition is still running, bringing this truly global artist to a global audience. This will be an unmissable chance to get to know this visually spectacular artist and the influence he has had on those who followed.\\u0026nbsp;\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003eMade in close collaboration with Tate Britain.\\u003c/div\\u003e\",\"starring\":null,\"directedBy\":\"David Bickerstaff\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":90,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-09-15\",\"dateOfFirstShowing\":\"2026-09-15\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"511703\",\"dcmEdiMovieName\":\"Exhibition On Screen: James Mcneill Whistler 2026 (Exhibition) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"454540\",\"time\":\"2026-09-15T17:00:00Z\",\"ticketsSold\":3,\"screenId\":\"440\",\"seatsRemaining\":98,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"454542\",\"time\":\"2026-09-20T16:15:00Z\",\"ticketsSold\":2,\"screenId\":\"442\",\"seatsRemaining\":58,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"39371\",\"name\":\"Little Miss Sunshine\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"little-miss-sunshine\",\"posterImage\":\"zi3alqaqw3hrv651ez8qcp6lq5og\",\"bannerImage\":\"is6t8c3tzsyi4uqkom1zs3h2l5xm\",\"synopsis\":\"\\u003cdiv\\u003eFather Richard (Greg Kinnear) is desperately trying to sell his motivational success program... with no success. Meanwhile, \\\"pro-honesty\\\" mom Sheryl (Toni Collette) lends support to her eccentric family, including her depressed brother (Steve Carell), fresh out of the hospital after being jilted by his lover. Then there are the younger Hoovers - the seven-year-old, would-be beauty queen Olive (Abigail Breslin) and Dwayne (Paul Dano), a Nietzsche-reading teen who has taken a vow of silence. Topping off the family is the foul-mouthed grandfather (Alan Arkin), whose outrageous behavior recently got him evicted from his retirement home. When Olive is invited to compete in the \\\"Little Miss Sunshine\\\" pageant in far-off California, the family piles into their rusted-out VW bus to rally behind her - with riotously funny results.\\u003c/div\\u003e\",\"starring\":\"Abigail Breslin, Greg Kinnear, Paul Dano\",\"directedBy\":\"Jonathan Dayton, Valerie Faris\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":99,\"genre\":\"Drama\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"wvwVkllXT80\",\"trailerVideo\":null,\"releaseDate\":\"2026-09-16\",\"dateOfFirstShowing\":\"2026-09-16\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"25442\",\"dcmEdiMovieName\":\"Little miss sunshine (2D) [15]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"463112\",\"time\":\"2026-09-16T19:00:00Z\",\"ticketsSold\":0,\"screenId\":\"442\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser knitflicks\\\"}\"}]},{\"id\":\"34892\",\"name\":\"Nickel Boys\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"nickel-boys\",\"posterImage\":\"ato94ssc9sjvqj65yqekg0bgboy0\",\"bannerImage\":\"sqdly13oofydcrcnvhosb0bt7wlh\",\"synopsis\":\"Chronicles the powerful friendship between two young Black teenagers navigating the harrowing trials of reform school together in Florida.\",\"starring\":\"Ethan Herisse, Brandon Wilson, Aunjanue Ellis-Taylor\",\"directedBy\":\"RaMell Ross\",\"producedBy\":\"Jeremy Kleiner, Dede Gardner, David Levine, Joslyn Barnes\",\"searchTerms\":\"\",\"duration\":140,\"genre\":\"Drama\",\"allGenres\":\"Drama\",\"rating\":\"12A\",\"trailerYoutubeId\":\"2jeti8dl1WI\",\"trailerVideo\":null,\"releaseDate\":\"2025-01-03\",\"dateOfFirstShowing\":\"2026-09-17\",\"tmdbPopularityScore\":3.4577,\"tmdbId\":\"1028196\",\"dcmEdiMovieId\":\"418151\",\"dcmEdiMovieName\":\"Nickel Boys (2D) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"399683\",\"time\":\"2026-09-17T18:45:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser ad-free books-on-film\\\"}\"}]},{\"id\":\"38111\",\"name\":\"Twenty Years of the Met in Cinemas: An Anniversary Celebration\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"twenty-years-of-the-met-in-cinemas-an-anniversary-celebratio\",\"posterImage\":\"zgpvn38jrg4ssl6c5qlsghdwpbpu\",\"bannerImage\":\"k2lu47w8t91zoarzdezoexjnkj01\",\"synopsis\":\"\\u003cp class=\\\"MsoNormal\\\" style=\\\"margin: 0cm 0cm 8pt; line-height: 18.4px; font-size: 12pt; font-family: Aptos, sans-serif;\\\"\\u003e\\u003cspan style=\\\"font-family: Calibri, sans-serif;\\\"\\u003e\\u003ci\\u003eTwenty Years of the Met in Cinemas\\u003c/i\\u003e is a celebration of the Met’s two decades of onstage glory as experienced in cinemas, featuring highlights from the company’s collection of more than 185 extraordinary onscreen performances. Hosted by star soprano Renée Fleming, this special presentation will showcase unforgettable moments from some of opera’s greatest stars, selected from the series’ vast archive of broadcasts featuring such remarkable artists as Lise Davidsen, Natalie Dessay, Joyce DiDonato, Juan Diego Flórez, Elīna Garanča, Dmitri Hvorostovsky, Jonas Kaufmann, Peter Mattei, Matthew Polenzani, Sondra Radvanovsky, Nadine Sierra, and, of course, Fleming herself.\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/span\\u003e\\u003c/p\\u003e\",\"starring\":\"Renée Fleming, Lise Davidsen, Natalie Dessay, Joyce DiDonato, Juan Diego Flórez, Elīna Garanča, Dmitri Hvorostovsky, Jonas Kaufmann, Peter Mattei, Matthew Polenzani, Sondra Radvanovsky, Nadine Sierra\",\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":180,\"genre\":null,\"allGenres\":null,\"rating\":null,\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-09-19\",\"dateOfFirstShowing\":\"2026-09-19\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"513744\",\"dcmEdiMovieName\":\"Llv Twenty Years Of The Met In Cinemas: An Anniversary Celebration - Met Opera 2026 (Opera) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"441987\",\"time\":\"2026-09-19T17:00:00Z\",\"ticketsSold\":6,\"screenId\":\"440\",\"seatsRemaining\":95,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"441988\",\"time\":\"2026-09-23T12:00:00Z\",\"ticketsSold\":2,\"screenId\":\"442\",\"seatsRemaining\":58,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"38520\",\"name\":\"National Theatre Live: The Misanthrope\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"national-theatre-live-the-misanthrope\",\"posterImage\":\"093pcoatty9sslsiwap6oedrn8zs\",\"bannerImage\":\"dh9ui7oxw4p3hph6mettkk8qni7j\",\"synopsis\":\"\\u003cdiv\\u003eTelling the truth isn’t always that simple. Alice, a brilliant novelist, despises the carefully constructed lies of modern society.\\u003c/div\\u003e\\u003cdiv\\u003eBut the more she challenges those around her, the fiercer the backlash becomes. Soon, she must confront the price of speaking her truth in a world that would rather silence her.\\u003c/div\\u003e\\u003cdiv\\u003eFilmed live on stage at the National Theatre, Indhu Rubasingham directs Martin Crimp’s (Cyrano de Bergerac) highly\\u003c/div\\u003e\\u003cdiv\\u003eanticipated play.\\u003c/div\\u003e\",\"starring\":\"Sandra Oh, Paul Chahidi, Abigail Cruttenden\",\"directedBy\":\"Indhu Rubasingham\",\"producedBy\":\"\",\"searchTerms\":\"\",\"duration\":151,\"genre\":\"Drama\",\"allGenres\":\"Drama, Comedy\",\"rating\":\"TBC\",\"trailerYoutubeId\":\"M3HRY1tYTfg\",\"trailerVideo\":null,\"releaseDate\":\"2026-09-22\",\"dateOfFirstShowing\":\"2026-09-22\",\"tmdbPopularityScore\":1.037,\"tmdbId\":\"1693710\",\"dcmEdiMovieId\":\"513373\",\"dcmEdiMovieName\":\"Untitled NT Live Event (22Nd Sep 2026) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"446755\",\"time\":\"2026-09-22T18:00:00Z\",\"ticketsSold\":15,\"screenId\":\"440\",\"seatsRemaining\":86,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"446756\",\"time\":\"2026-09-30T18:00:00Z\",\"ticketsSold\":8,\"screenId\":\"440\",\"seatsRemaining\":93,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"446757\",\"time\":\"2026-10-04T15:00:00Z\",\"ticketsSold\":5,\"screenId\":\"440\",\"seatsRemaining\":96,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"446758\",\"time\":\"2026-10-26T19:30:00Z\",\"ticketsSold\":4,\"screenId\":\"442\",\"seatsRemaining\":56,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser subtitled event-cinema\\\"}\"}]},{\"id\":\"34353\",\"name\":\"Fargo\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"fargo\",\"posterImage\":\"bqqcrbsbkw3m07h9cslorbkj81lq\",\"bannerImage\":\"fjqbdiye72v8b9hzbdzr8liuy8vn\",\"synopsis\":\"Dive into film history and technique with handpicked classics. A friendly introduction and a post-film sociable discussion with film-maker Andrea Carnevali.\\n\\nAcademy Award Wins Best Actress, Best Screenplay\\nAcademy Award Nominations Best Picture, Best Supporting Actor, Best Director, Best Cinematography, Best Editing\\n\\nThings go terribly awry when small-time Minnesota car salesman, Jerry Lundegaard, hires two thugs to kidnap his wife. Once people start dying, the very chipper and very pregnant Police Chief Marge Gunderson takes the case. Is she up to the challenge? You betcha.\",\"starring\":\"Frances McDormand, William H. Macy, Steve Buscemi, Peter Stormare, Harve Presnell\",\"directedBy\":\"Joel Coen, Ethan Coen\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":100,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=ju75Sd4yAZw\",\"trailerVideo\":null,\"releaseDate\":\"2026-09-23\",\"dateOfFirstShowing\":\"2026-09-23\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"329432\",\"dcmEdiMovieName\":\"Fargo (25Th Anniversary) (2D) [18]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"394980\",\"time\":\"2026-09-23T18:45:00Z\",\"ticketsSold\":4,\"screenId\":\"440\",\"seatsRemaining\":97,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser intro ad-free andreas-film-club\\\"}\"}]},{\"id\":\"38685\",\"name\":\"Butley\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"butley\",\"posterImage\":\"jutcukpgirk72pc69ehguf7v85t7\",\"bannerImage\":\"o3bgao5oy99f15dz3cptd2sd1pc9\",\"synopsis\":\"About the film:\\u003cdiv\\u003eA university lecturer, Ben Butley, shares his office and his flat with a former star pupil, Joey, now also a lecturer. Butley faces both the ultimate breakdown of his marriage and of his intense friendship with Joey. Butley’s painful discoveries are made against a background of petty university politics and unease about student dissent. He greets them with a blistering torrent of repartee and rhetoric.\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eGRAY MATTERS: The Films of Simon Gray\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003e\\\"It is a curious thing, being alive... It's like living in a room with a clock that ticks the wrong time, but there's no one around to tell you.\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003e\\u003cbr\\u003e\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eThe Chiswick Cinema are delighted to host this exclusive season celebrating the career of Simon Gray.\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003e\\u003cbr\\u003e\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eAbout SIMON GRAY:\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eSimon Gray (1936 - 2008) was a British playwright, screenwriter, and novelist, best known for his deep and witty explorations of the human condition. His darkly comedic work often featured academic, middle-class characters caught in emotional or intellectual crisis, told with razor sharp dialogue. His ability to balance humour with existential despair has earned him a lasting place in theatre. His contemporary Harold Pinter, directed several of his plays.\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003e\\u003cbr\\u003e\\u003c/span\\u003e\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cspan style=\\\"font-size: 14px;\\\"\\u003eGray wrote novels, screenplays and candid memoirs that reflected on his work, health, smoking and depression. His style has a dryly intelligent rigor, with brilliant wit, self-deprecation and philosophic honesty often going hand in hand. Disillusionment, achievement, and the despair in everyday entrapments are a throughline to the psychologically complex texts.\\u003c/span\\u003e\\u003c/div\\u003e\\u003c/div\\u003e\",\"starring\":\"Alan Bates, Richard O’Callaghan, Michael Byrne, Jessica Tandy, Susan Engel, Georgina Hale, Simon Rouse, John Savident\",\"directedBy\":\"Harold Pinter\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":125,\"genre\":\"Drama\",\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"pXpcAILCXWw\",\"trailerVideo\":null,\"releaseDate\":\"2026-09-25\",\"dateOfFirstShowing\":\"2026-09-25\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":null,\"dcmEdiMovieName\":\"No Match Found\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"448704\",\"time\":\"2026-09-25T18:45:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser simon-gray\\\"}\"}]},{\"id\":\"38104\",\"name\":\"The Metropolitan Opera: Così fan tutte\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-metropolitan-opera-cos-fan-tutte\",\"posterImage\":\"dikg1pqxikdzciqtjs8tko4w1qui\",\"bannerImage\":\"0255efwbn47fu129d1q17wjvmrp5\",\"synopsis\":\"\\u003cdiv\\u003eThe Met: Live in HD season continues with Mozart’s satirical comedy of fickle young love. Phelim McDermott’s “colorful, inventive” (The New York Times) staging, inspired by Coney Island in the 1950s, sets the uproarious story at a boardwalk amusement park, where the two pairs of lovers at the heart of the tale find themselves on one emotional—and literal— thrill ride after another. Soprano Federica Lombardi and mezzo-soprano Samantha Hankey sing Fiordiligi and Dorabella, opposite tenor Duke Kim and baritone Andrey Zhilikhovsky as Ferrando and Guglielmo. Bass-baritone Gerald Finley reprises his portrayal of the cynical Don Alfonso, with soprano Ana María Martínez as the witty maid Despina.\\u003c/div\\u003e\",\"starring\":\"Federica Lombardi, Samantha Hankey\",\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":237,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-10-03\",\"dateOfFirstShowing\":\"2026-10-03\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"484879\",\"dcmEdiMovieName\":\"#Runseokjin_Ep.Tour The Movie (Concert) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"441989\",\"time\":\"2026-10-03T17:00:00Z\",\"ticketsSold\":7,\"screenId\":\"440\",\"seatsRemaining\":94,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"441990\",\"time\":\"2026-10-07T10:30:00Z\",\"ticketsSold\":6,\"screenId\":\"440\",\"seatsRemaining\":95,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"35314\",\"name\":\"Rear Window\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"rear-window\",\"posterImage\":\"xfe346efw87zmux8f4fvqg607yew\",\"bannerImage\":\"02kgv6qsucrhqpng33fkgvp6kmy1\",\"synopsis\":\"A wheelchair-bound photographer spies on his neighbors from his apartment window and becomes convinced one of them has committed murder.\",\"starring\":\"James Stewart, Grace Kelly, Wendell Corey\",\"directedBy\":\"Alfred Hitchcock\",\"producedBy\":\"\",\"searchTerms\":\"\",\"duration\":112,\"genre\":\"Thriller\",\"allGenres\":\"Thriller, Mystery\",\"rating\":\"PG\",\"trailerYoutubeId\":\"m01YktiEZCw\",\"trailerVideo\":null,\"releaseDate\":\"1954-08-01\",\"dateOfFirstShowing\":\"2026-10-06\",\"tmdbPopularityScore\":9.6215,\"tmdbId\":\"567\",\"dcmEdiMovieId\":\"13085\",\"dcmEdiMovieName\":\"Rear Window (Re: 2000) (2D) [U]\",\"siteId\":\"170\",\"titleClassId\":\"410\",\"showings\":[{\"id\":\"404455\",\"time\":\"2026-10-06T18:45:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser hitchock-for-halloween\\\"}\"}]},{\"id\":\"35315\",\"name\":\"The Lodger + Live Score by Hugo Max\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-lodger-live-score-by-hugo-max\",\"posterImage\":\"sz3izpy5kcs0zsnshyna4zwwiwmi\",\"bannerImage\":\"sv1vi1rxgv3p4wlf3o1ospphe58n\",\"synopsis\":\"One of Hitchcock’s first ever films is based on the story of Jack The Ripper. As the suspicion that a neighbour may not be all he seems, the cat- and-mouse tension reaches almost unbearable proportion.\\n\\nAbout Hugo Max:\\nViola player and filmmaker Hugo Max presents a UK tour accompanying Alfred Hitchcock’s 1927 silent masterwork The Lodger with live score.\\n\\nPacked with the stylistic flourishes and experimental trick shots that would become defining trademarks of Hitchcock’s film language, the third feature by the Master of Suspense is a gripping murder mystery propelled by Ivor Novello’s iconic central performance.\\n\\nHugo Max performs live improvised scores to silent films on solo viola, regularly soundtracking screenings at London’s Prince Charles Cinema and Picturehouse Cinemas. He has presented nationwide tours focussing on silent horror, expressionism and the films of F. W. Murnau.\\n\\nWebsite: https://hugomax.co.uk/scoring-silent-cinema\",\"starring\":\"Ivor Novello, June, Michael Keen, Marie Ault\",\"directedBy\":\"Alfred Hitchock\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":91,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"PG\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=dfyhFWoNARk\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-11\",\"dateOfFirstShowing\":\"2026-10-11\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"484879\",\"dcmEdiMovieName\":\"#Runseokjin_Ep.Tour The Movie (Concert) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"404456\",\"time\":\"2026-10-11T16:00:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser hitchock-for-halloween\\\"}\"}]},{\"id\":\"39372\",\"name\":\"Kinky Boots\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"kinky-boots\",\"posterImage\":\"0kuqt1nazfy6m3pdf8kk2z04rnzx\",\"bannerImage\":\"1oxlzfmc92aohkv59jtu46hx5iuv\",\"synopsis\":\"\\u003cdiv\\u003eCharles Price may have grown up with his father in the family shoe business in Northampton, central England, but he never thought that he would take his father's place. Charles has a chance encounter with the flamboyant drag queen cabaret singer Lola and everything changes.\\u003c/div\\u003e\",\"starring\":\"Nick Frost, Chiwetel Ejiofor, Linda Bassett, Joel Edgerton\",\"directedBy\":\"Julian Jarrold\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":102,\"genre\":\"Comedy\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"Ek7VcOkzzkM\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-14\",\"dateOfFirstShowing\":\"2026-10-14\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"22644\",\"dcmEdiMovieName\":\"Kinky boots (2D) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"463113\",\"time\":\"2026-10-14T19:00:00Z\",\"ticketsSold\":0,\"screenId\":\"442\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser knitflicks\\\"}\"}]},{\"id\":\"34906\",\"name\":\"Under the Skin\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"under-the-skin\",\"posterImage\":\"9ukkp9vrmul2gc2btrne9t52efr9\",\"bannerImage\":\"h0q38p72r54pf524fqis1wnt5sl3\",\"synopsis\":\"An alien entity inhabits the earthly form of a seductive young woman who combs the Scottish highways in search of the human prey it is here to plunder. It lures its isolated and forsaken male victims into an otherworldly dimension where they are stripped and consumed. But life in all its complexity starts to change the alien. It begins to see itself as 'she', as human, with tragic and terrifying consequences.\",\"starring\":\"Scarlett Johansson, Jeremy McWilliams, Lynsey Taylor MacKay\",\"directedBy\":\"Jonathan Glazer\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":108,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=J7bAZCOk0Sc\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-15\",\"dateOfFirstShowing\":\"2026-10-15\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"10702\",\"dcmEdiMovieName\":\"Under The Skin (1997) (2D) [18]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"399684\",\"time\":\"2026-10-15T18:45:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser ad-free books-on-film\\\"}\"}]},{\"id\":\"37994\",\"name\":\"The Metropolitan Opera: Macbeth\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-metropolitan-opera-macbeth\",\"posterImage\":\"uwuyzwtq6vcknlizboij4l1tjaay\",\"bannerImage\":\"9fqu8zrr23btflp7bmclypou5ex1\",\"synopsis\":\"Two of opera’s most extraordinary artists return to The Met: Live in HD for Verdi’s thrilling take on the immortal Shakespearean tale of the scheming couple determined to seize power at any cost. Following past triumphs in many of Verdi’s signature baritone roles, Quinn Kelsey is the Scottish king haunted by the ghosts of his murderous ascent to the throne, opposite Lise Davidsen—the world’s reigning dramatic soprano—as the power-mad Lady Macbeth, whose ruinous ambition damns them both. Met Music Director Yannick Nézet-Séguin takes the podium for a penetrating production by Louisa Proske, a brilliant young director making waves around the world. Rounding out the all-star cast are tenor Freddie De Tommaso as the heroic Macduff and bass-baritone Ryan Speedo Green as Macbeth’s friend-turned-victim Banquo. This production is part of the Met’s award-winning Live in HD series, bringing opera to cinemas across the globe.\",\"starring\":\"Quinn Kelsey, Lise Davidsen, Freddie De Tommaso, Ryan Speedo Green\",\"directedBy\":\"Louisa Proske\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":210,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"SdOflhu5-1E\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-20\",\"dateOfFirstShowing\":\"2026-10-17\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"511887\",\"dcmEdiMovieName\":\"Macbeth - Met Opera 2026 (Opera) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"441991\",\"time\":\"2026-10-17T17:00:00Z\",\"ticketsSold\":9,\"screenId\":\"440\",\"seatsRemaining\":92,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"441992\",\"time\":\"2026-10-21T11:30:00Z\",\"ticketsSold\":5,\"screenId\":\"441\",\"seatsRemaining\":96,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"35316\",\"name\":\"Sabotage\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"sabotage\",\"posterImage\":\"5xcw7mfmbveskem7n51pgxb3tlju\",\"bannerImage\":\"fbtlfp9j8ouhf7px20euhhx2zrbv\",\"synopsis\":\"Verloc, the manager of a London West End Cinema, is also the secret chief of a terrorist organisation planning to destroy the London Underground Network. For his next task, he must leave a highly explosive bomb at Piccadilly Circus Station.\",\"starring\":\"Sylvia Sidney, Oscar Homolka, John Loder, Desmond Tester, Joyce Barbour, Matthew Boulton\",\"directedBy\":\"Alfred Hitchcock\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":76,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"PG\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=e4Q2GvpiGVs\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-20\",\"dateOfFirstShowing\":\"2026-10-20\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"8890305\",\"dcmEdiMovieName\":\"Sabotage (1936) [PG]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"404457\",\"time\":\"2026-10-20T18:45:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser hitchock-for-halloween\\\"}\"}]},{\"id\":\"34354\",\"name\":\"The Omen\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-omen\",\"posterImage\":\"s1xldiwcublv5yroot1qubwftydh\",\"bannerImage\":\"o95nov4zesjvd481pfodnkuz64kt\",\"synopsis\":\"Dive into film history and technique with handpicked classics. A friendly introduction and a post-film sociable discussion with film-maker Andrea Carnevali.\\n\\nAcademy Award Wins Best Score\\nAcademy Award Nominations Best Song \\n\\nRobert Thorn, an American diplomat living in Rome, learns that his infant son died moments after birth. Rather than tell his wife Katherine the truth, which he fears would shatter her emotionally, Robert secretly arranges the adoption of another baby through the Catholic church. Years pass and the Thorn's child, Damien, has a happy, normal childhood. Robert is named Ambassador to the Court of Saint James, and the family relocates to a lavish estate in the English countryside. But their seemingly idyllic life begins to change when, during Damien's fifth birthday, the boy's nanny suddenly commits suicide.\\n\\nShortly thereafter, Robert is approached by Father Brennan, who claims he was present at the hospital when Damien's adoption took place. He is convinced that the boy is the son of the Devil, and that only a man named Bugenhagen, who lives in Israel, has the power to kill him. Robert initially believes the priest to be mad, but his faith begins to waiver as everyone around Damien is subjected to a series of freak, horrific incidents.\",\"starring\":\"Gregory Peck, Lee Remick, Harvey Spencer Stephens\",\"directedBy\":\"Richard Donner\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":111,\"genre\":\"Horror\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=sS-sXcx30O4\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-21\",\"dateOfFirstShowing\":\"2026-10-21\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"61260\",\"dcmEdiMovieName\":\"At The Very Last Moment – La Nuit De La Glisse (2D) [U]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"394981\",\"time\":\"2026-10-21T18:45:00Z\",\"ticketsSold\":7,\"screenId\":\"440\",\"seatsRemaining\":94,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser intro ad-free andreas-film-club\\\"}\"}]},{\"id\":\"37995\",\"name\":\"The Royal Ballet: Manon\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-royal-ballet-manon\",\"posterImage\":\"j4tfwy2cf60ua7kpxif8wgz18g7s\",\"bannerImage\":\"6rjal9da0hxhg6q9eqavxyx5usje\",\"synopsis\":\"\\u003cdiv\\u003eIn the seedy underbelly of 18th-century Paris, money is king. Nothing is sacred – even love itself can be bought for the right price. A native of this hedonistic underworld, Manon is caught between twin desires when she falls in love with the student Des Grieux. Steadfast and devoted, he offers the possibility of an honourable life. Yet, the riches promised by the world of Parisian society remain tempting...\\u003c/div\\u003e\\u003cdiv\\u003eManon’s inner turmoil and struggle for survival lie at the devastating heart of Kenneth MacMillan’s 1974 adaptation of Abbé Prévost’s novel. In this signature work of The Royal Ballet, MacMillan’s nuanced understanding of human psychology makes for an unflinching look into the moral degradation of Manon’s Paris, while all its decadence and decay are brought to life through Jules Massenet’s score and Nicholas Georgiadis’s designs.\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\",\"starring\":null,\"directedBy\":\"Kenneth MacMillan\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":190,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"eRR1FiG__FU\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-27\",\"dateOfFirstShowing\":\"2026-10-27\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"500512\",\"dcmEdiMovieName\":\"Manon - Rbo, London 2026 (Ballet) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"442009\",\"time\":\"2026-10-27T19:15:00Z\",\"ticketsSold\":11,\"screenId\":\"441\",\"seatsRemaining\":90,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"442010\",\"time\":\"2026-11-02T13:30:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"35317\",\"name\":\"Marnie\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"marnie\",\"posterImage\":\"7bfglhk6h8gvwn9keuxosfyfu5et\",\"bannerImage\":\"e0gptjvt5y9pv055nj4pnfhdxv50\",\"synopsis\":\"Kleptomaniac Marnie Edgar, who moves from job to job and has a pathological fear of the colour red, is caught stealing by her latest employer Mark Rutland. Instead of turning her over to the police, Mark forces Marnie to marry him, convinced that he can get to the bottom of her psychosis...\",\"starring\":\"Tippi Hedren, Sean Connery, Martin Gabel\",\"directedBy\":\"Alfred Hitchcock\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":130,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=QV_2-v_dsAU\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-27\",\"dateOfFirstShowing\":\"2026-10-27\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"8890190\",\"dcmEdiMovieName\":\"Marnie (2D) [15]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"404466\",\"time\":\"2026-10-27T19:45:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser hitchock-for-halloween\\\"}\"}]},{\"id\":\"35318\",\"name\":\"The Birds\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-birds\",\"posterImage\":\"hu6sqo2oj0hl31s5efjvyl5nvqpt\",\"bannerImage\":\"92orcp4ie3t1lfgy2ti1xx4jdy2v\",\"synopsis\":\"Wealthy reformed party girl Melanie Daniels enjoys a brief flirtation with lawyer Mitch Brenner in a San Francisco pet shop and decides to follow him to his Bodega Bay home. Bearing a gift of two lovebirds, Melanie quickly strikes up a romance with Mitch while contending with his possessive mother and boarding at his ex-girlfriend's house. One day, during a birthday party for Mitch's younger sister, a flock of birds attacks the children in what seems to be a random incident. In fact, it signals the beginning of a massive and organised avian assault on the residents of the town - a mysterious spate of violence that no one can explain... and from which no one might come out alive\",\"starring\":\"Tippi Hedren, Rod Taylor, Suzanne Pleshette\",\"directedBy\":\"Alfred Hitchcock\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":119,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=0fJh2gIBOto\",\"trailerVideo\":null,\"releaseDate\":\"2026-10-31\",\"dateOfFirstShowing\":\"2026-10-31\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"361559\",\"dcmEdiMovieName\":\"Hunger Games: The Ballad Of Songbirds And Snakes, The (2D) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"404467\",\"time\":\"2026-10-31T20:00:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser hitchock-for-halloween\\\"}\"}]},{\"id\":\"35433\",\"name\":\"In a Lonely Place\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"in-a-lonely-place\",\"posterImage\":\"9y2rqrvf0gbgtrdzvn0eurl85x0l\",\"bannerImage\":\"9t1y7hwtn0s32g3f7fb6jmhq9o55\",\"synopsis\":\"Local film critic and podcaster Matthew Turner returns for a third mini season of film noir classics, which will run exclusively at Chiswick Cinema throughout November 2026.\\n\\n\\\"Nicholas Ray's noir classic stars Humphrey Bogart in one of his greatest roles as Dix Steele, a troubled, violence-prone screenwriter who's accused of the murder of a young woman. Gloria Grahame (The Big Heat) plays Dix's kind-hearted neighbour, who initially clears his name and then begins to have doubts.\\\"\\n\\nSynopsis:\\nScreenwriter Dixon Steele, faced with the odious task of scripting a trashy bestseller, has hat-check girl Mildred Atkinson tell him the story in her own words. Later that night, Mildred is murdered and Steele is a prime suspect; his record of belligerence when angry and his macabre sense of humor tell against him. Fortunately, lovely neighbor Laurel Gray gives him an alibi. Laurel proves to be just what Steele needed, and their friendship ripens into love. Will suspicion, doubt, and Steele's inner demons come between them?nyop\",\"starring\":\"Humphrey Bogart, Gloria Grahame, Frank Lovejoy, Carl Benton Reid, Jeff Donnell\",\"directedBy\":\"Nicholas Ray\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":93,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"PG\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=68C2IFX60CU\",\"trailerVideo\":null,\"releaseDate\":\"2026-11-01\",\"dateOfFirstShowing\":\"2026-11-01\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"39877\",\"dcmEdiMovieName\":\"In A Lonely Place (Re: 2017) (2D) [PG]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"406243\",\"time\":\"2026-11-01T19:45:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser intro ad-free noirvember\\\"}\"}]},{\"id\":\"35434\",\"name\":\"Farewell, My Lovely [a.k.a Murder, My Sweet]\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"farewell-my-lovely-aka-murder-my-sweet\",\"posterImage\":\"yao7uyjnd0xm9jzxh2czt02y5suy\",\"bannerImage\":\"ejgtaz8gnfxcy6pdjxjlf2d4627v\",\"synopsis\":\"Local film critic and podcaster Matthew Turner returns for a third mini season of film noir classics, which will run exclusively at Chiswick Cinema throughout November 2026.\\n\\n\\\"Former crooner Dick Powell stars as hard-boiled private eye Philip Marlowe, who's drawn into a web of crime and corruption when he's hired to locate Velma (Claire Trevor), the former girlfriend of hulking ex-con Moose Malloy (Mike Mazurki). Adapted from the classic detective novel by Raymond Chandler and released the same year as Double Indemnity, this is considered one of the pinnacles of film noir and a key influence on the genre.\\\"\\n\\nSynopsis:\\nAfter being hired to find an ex-con's former girlfriend, Philip Marlowe is drawn into a deeply complex web of mystery and deceit.\",\"starring\":\"Dick Powell, Claire Trevor, Anne Shirley\",\"directedBy\":\"Edward Dmytryk\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":95,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"PG\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=PHRDGxSL2o4\",\"trailerVideo\":null,\"releaseDate\":\"2026-11-04\",\"dateOfFirstShowing\":\"2026-11-04\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"927219\",\"dcmEdiMovieName\":\"Farewell, My Lovely (2D) [PG]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"406244\",\"time\":\"2026-11-04T19:45:00Z\",\"ticketsSold\":1,\"screenId\":\"440\",\"seatsRemaining\":100,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser intro ad-free noirvember\\\"}\"}]},{\"id\":\"37996\",\"name\":\"The Royal Opera: Carmen\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-royal-opera-carmen\",\"posterImage\":\"8vub98ztzfia469zw0cjxlfmoix4\",\"bannerImage\":\"kpiyss8ekl8xb4kz5q8kyvhquks1\",\"synopsis\":\"\\u003cdiv\\u003eUnder the oppressive heat of the Spanish sun, the fiercely independent Carmen attracts the attention of Don José. She warns him not to fall in love with her, but his obsession knows no bounds. Damiano Michieletto’s searing production returns, casting scorching light on the lust, violence and destructive desire of Bizet’s ever-popular opera.\\u0026nbsp;\\u003c/div\\u003e\\u003cdiv\\u003eAn all-star cast brings this white-hot drama to life, with Ginger Costa-Jackson in the fiery title role, alongside Russell Thomas as the jealous and despairing Don José. Following his 2023 Royal Opera debut, Sesto Quatrini returns to conduct Bizet’s electrifying and sensual score.\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\",\"starring\":\"Ginger Costa-Jackson, Russell Thomas, Adriana González, Alexander Vinogradov, Barnaby Rea\",\"directedBy\":\"Damiano Michieletto\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":215,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"eRR1FiG__FU\",\"trailerVideo\":null,\"releaseDate\":\"2026-11-10\",\"dateOfFirstShowing\":\"2026-11-10\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"500515\",\"dcmEdiMovieName\":\"Carmen - Rbo, London 2026 (Opera) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"442011\",\"time\":\"2026-11-10T19:00:00Z\",\"ticketsSold\":7,\"screenId\":\"440\",\"seatsRemaining\":94,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"442092\",\"time\":\"2026-11-18T11:45:00Z\",\"ticketsSold\":2,\"screenId\":\"441\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"35435\",\"name\":\"Narrow Margin\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"narrow-margin\",\"posterImage\":\"9gxqj7y1sg7b5vfe4a9qtu9q7r0m\",\"bannerImage\":\"c22mikwz7e71gfppx9pjw7dmuxam\",\"synopsis\":\"Local film critic and podcaster Matthew Turner returns for a third mini season of film noir classics, which will run exclusively at Chiswick Cinema throughout November 2026.\\n\\n\\\"Directed by Richard Fleischer, this terrific noir thriller is a model of economy, taking place almost entirely aboard a train. Charles McGraw stars as a police detective who's assigned to protect an important witness (Marie Windsor) as she rides a train from Chicago to Los Angeles, before she testifies against the mob.\\\"\\n\\nSynopsis:\\nPack your bags for one of movie history's greatest trips, a nifty film noir thriller that Time deemed \\\"worthy of being bracketed in the select group of train thrillers headed by Alfred Hitchcock's The Lady Vanishes.\\\" These train tracks run direct from Chicago to L.A. in this Oscar-nominated story, directed by Richard Fleischer (The Boston Strangler) and scripted by his frequent collaborator Earl Felton, The Narrow Margin zigzags with surprise turns. Film noir favorite Charles McGraw plays a cop guarding a gangster's moll (fellow genre icon Marie Windsor) as she travels west to testify before a grand jury. Also riding the Pullmans: determined hitmen who know the moll is on the train, but don't know what she looks like. All aboard!\",\"starring\":\"Charlie MacGraw, Marie Windsor, Jacqueline White, Queenie Leonard, Gordon Gebert, David Clarke\",\"directedBy\":\"Richard Fleischer\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":72,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"PG\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=OZtFTnm8GnY\",\"trailerVideo\":null,\"releaseDate\":\"2026-11-11\",\"dateOfFirstShowing\":\"2026-11-11\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"932008\",\"dcmEdiMovieName\":\"Narrow Margin (2D) [15]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"406245\",\"time\":\"2026-11-11T19:45:00Z\",\"ticketsSold\":1,\"screenId\":\"440\",\"seatsRemaining\":100,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser intro ad-free noirvember\\\"}\"}]},{\"id\":\"39373\",\"name\":\"Funny Face\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"funny-face\",\"posterImage\":\"j6cnhjmj30xx9i5e3enxmxk3forq\",\"bannerImage\":\"ls9mwtlfn55hn5839ozjhm50ylgf\",\"synopsis\":\"A shy Greenwich Village book clerk is discovered by a fashion photographer and whisked off to Paris where she becomes a reluctant model.\",\"starring\":\"Audrey Hepburn, Fred Astaire, Kay Thompson\",\"directedBy\":\"Stanley Donen\",\"producedBy\":\"Roger Edens\",\"searchTerms\":\"\",\"duration\":103,\"genre\":\"Music\",\"allGenres\":\"Music, Comedy, Romance\",\"rating\":\"U\",\"trailerYoutubeId\":\"Hs6ASCq9YtY\",\"trailerVideo\":null,\"releaseDate\":\"1957-02-13\",\"dateOfFirstShowing\":\"2026-11-11\",\"tmdbPopularityScore\":2.8575,\"tmdbId\":\"13320\",\"dcmEdiMovieId\":\"127092\",\"dcmEdiMovieName\":\"Funny Face (Re: 2014) (2D) [U]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"463114\",\"time\":\"2026-11-11T20:00:00Z\",\"ticketsSold\":0,\"screenId\":\"442\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser knitflicks\\\"}\"}]},{\"id\":\"35439\",\"name\":\"Laura\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"laura\",\"posterImage\":\"nhbq1ntqaobk1q07r2w5q3negzun\",\"bannerImage\":\"vvzzhfwvixa3gdrqtmr24py98d0f\",\"synopsis\":\"Local film critic and podcaster Matthew Turner returns for a third mini season of film noir classics, which will run exclusively at Chiswick Cinema throughout November 2026.\\n\\n\\\"Otto Preminger's twisted noir classic stars Dana Andrews as a cop who falls in love with Laura (Gene Tierney), the beautiful woman whose murder he's investigating. Slippery suspects include Cliften Webb as imperious columnist Waldo Lydecker and a pre-horror Vincent Price as Laura's parasitic playboy fiance, Shelby Carpenter.\\\"\\n\\nSynopsis:\\nA police detective falls in love with the woman whose murder he is investigating.\",\"starring\":\"Gene Tierney, Dana Andrews, Clifton Webb\",\"directedBy\":\"Otto Preminger\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":88,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"U\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=KgGtRJY516E\",\"trailerVideo\":null,\"releaseDate\":\"2026-11-18\",\"dateOfFirstShowing\":\"2026-11-18\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"23077\",\"dcmEdiMovieName\":\"Laura (Re: 2012) (2D) [U]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"406308\",\"time\":\"2026-11-18T19:45:00Z\",\"ticketsSold\":1,\"screenId\":\"440\",\"seatsRemaining\":100,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser intro ad-free noirvember\\\"}\"}]},{\"id\":\"39243\",\"name\":\"GIANT - The Play\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"giant---the-play\",\"posterImage\":\"7ogw155b615n9fsgkymx9oqc11hw\",\"bannerImage\":\"kxglnu5t5y1j72btf35s2bi3y6mt\",\"synopsis\":\"\\u003cp class=\\\"MsoNormal\\\" style=\\\"margin: 0cm; line-height: 16.8667px; font-size: 11pt; font-family: Arial, sans-serif; text-align: justify;\\\"\\u003e\\u003cspan style=\\\"font-family: Calibri, sans-serif; font-size: 11pt;\\\"\\u003eGIANT, the 5-star critically acclaimed play starring John Lithgow (\\u003c/span\\u003e\\u003ci style=\\\"font-family: Calibri, sans-serif; font-size: 11pt;\\\"\\u003eKillers of the Flower Moon\\u003c/i\\u003e\\u003cspan style=\\\"font-family: Calibri, sans-serif; font-size: 11pt;\\\"\\u003e, \\u003c/span\\u003e\\u003ci style=\\\"font-family: Calibri, sans-serif; font-size: 11pt;\\\"\\u003eThe Crown\\u003c/i\\u003e\\u003cspan style=\\\"font-family: Calibri, sans-serif; font-size: 11pt;\\\"\\u003e) as Roald Dahl, comes to the big screen. Winner of 3 Olivier Awards® including Best Play and a Tony Award® for Best Actor in a Play (John Lithgow), the production was filmed live in London’s West End ahead of its sold-out Broadway run. The stellar cast includes Aya Cash (\\u003c/span\\u003e\\u003ci style=\\\"font-family: Calibri, sans-serif; font-size: 11pt;\\\"\\u003eThe Boys, The Franchise, \\u003cspan style=\\\"color: rgb(49, 49, 49);\\\"\\u003eYou’re the Worst\\u003c/span\\u003e\\u003c/i\\u003e\\u003cspan style=\\\"font-family: Calibri, sans-serif; font-size: 11pt; color: rgb(49, 49, 49);\\\"\\u003e)\\u003c/span\\u003e\\u003cspan style=\\\"font-family: Calibri, sans-serif; font-size: 11pt;\\\"\\u003e, Elliot Levey (\\u003c/span\\u003e\\u003ci style=\\\"font-family: Calibri, sans-serif; font-size: 11pt;\\\"\\u003eCold War, Patriots, Good\\u003c/i\\u003e\\u003cspan style=\\\"font-family: Calibri, sans-serif; font-size: 11pt;\\\"\\u003e) and Rachael Stirling (\\u003c/span\\u003e\\u003ci style=\\\"font-family: Calibri, sans-serif; font-size: 11pt;\\\"\\u003eThe Divine Mrs S\\u003c/i\\u003e\\u003cspan style=\\\"font-family: Calibri, sans-serif; font-size: 11pt;\\\"\\u003e).\\u003c/span\\u003e\\u003c/p\\u003e\\u003cp class=\\\"MsoNormal\\\" style=\\\"margin: 0cm; line-height: 16.8667px; font-size: 11pt; font-family: Arial, sans-serif;\\\"\\u003e\\u003cspan style=\\\"font-family: Calibri, sans-serif;\\\"\\u003e\\u0026nbsp;\\u003c/span\\u003e\\u003c/p\\u003e\\u003cp class=\\\"MsoNormal\\\" style=\\\"margin: 0cm; line-height: 16.8667px; font-size: 11pt; font-family: Arial, sans-serif;\\\"\\u003e\\u003cspan style=\\\"font-family: Calibri, sans-serif;\\\"\\u003eA world-famous children’s author under threat. A battle of wills in the wake of scandal. And one chance to make amends...It’s the summer of 1983, \\u003ci\\u003eThe Witches\\u003c/i\\u003e is about to hit the shelves and Roald Dahl is making last-minute edits.\\u0026nbsp; But the outcry at his recent, explicitly antisemitic article won’t die down. Across a single afternoon at his family home, and rocked by an unexpectedly explosive confrontation, Dahl is forced to choose: make a public apology or risk his name and reputation. Inspired by real events,\\u003cb\\u003e \\u003c/b\\u003eGIANT\\u003ci\\u003e \\u003c/i\\u003eexplores with dark humour the difference between considered opinion and dangerous rhetoric offering a complicated portrait of a fiendishly charismatic icon.\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/span\\u003e\\u003c/p\\u003e\",\"starring\":\"John Lithgow, Aya Cash, Elliot Levey, Rachael Stirling\",\"directedBy\":\"Nicholas Hytner\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":136,\"genre\":\"\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-11-19\",\"dateOfFirstShowing\":\"2026-11-19\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"515213\",\"dcmEdiMovieName\":\"Giant - the play (theatre) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"460371\",\"time\":\"2026-11-19T19:30:00Z\",\"ticketsSold\":4,\"screenId\":\"439\",\"seatsRemaining\":121,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"460372\",\"time\":\"2026-11-22T16:30:00Z\",\"ticketsSold\":1,\"screenId\":\"440\",\"seatsRemaining\":100,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"460373\",\"time\":\"2026-11-30T19:30:00Z\",\"ticketsSold\":2,\"screenId\":\"439\",\"seatsRemaining\":123,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"460374\",\"time\":\"2026-12-02T13:00:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"34907\",\"name\":\"Silence\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"silence\",\"posterImage\":\"976g4g7x6srizkc4srcyha69nq2t\",\"bannerImage\":\"2or01qzazx5yaber6ogvpvyfxsab\",\"synopsis\":\"In the 17th century, two Portuguese Jesuit priests travel to Japan in an attempt to locate their mentor, who is rumored to have committed apostasy, and to propagate Catholicism.\",\"starring\":\"Andrew Garfield, Adam Driver, Liam Neeson\",\"directedBy\":\"Martin Scorsese\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":161,\"genre\":\"Drama\",\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=IqrgxZLd_gE\",\"trailerVideo\":null,\"releaseDate\":\"2026-11-19\",\"dateOfFirstShowing\":\"2026-11-19\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"168513\",\"dcmEdiMovieName\":\"Silence (2D) [15]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"399685\",\"time\":\"2026-11-19T19:45:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser ad-free books-on-film\\\"}\"}]},{\"id\":\"35440\",\"name\":\"The Killers\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-killers\",\"posterImage\":\"719nlc7jes4f37yrgdrkboxzbk53\",\"bannerImage\":\"zmfonzp60mj3kuu51rvaczfevx74\",\"synopsis\":\"Local film critic and podcaster Matthew Turner returns for a third mini season of film noir classics, which will run exclusively at Chiswick Cinema throughout November 2026.\\n\\n\\\"Along with Double Indemnity and Sunset Boulevard, Robert Siodmak's crime thriller has one of the all-time great noir opening scenes, as a pair of gun-toting killers arrive in a small town and execute The Swede (Burt Lancaster), who makes no effort to resist his own death. Flashbacks then reveal what lead him to this state, including a doomed dalliance with femme fatale Kitty Collins (Ava Gardner, at her sultriest).\\\"\\n\\nSynopsis:\\nTwo hit men walk into a diner asking for a man called \\\"the Swede\\\" (Burt Lancaster). When the killers find the Swede, he's expecting them and doesn't put up a fight. Since the Swede had a life insurance policy, an investigator (Edmond O'Brien), on a hunch, decides to look into the murder. As the Swede's past is laid bare, it comes to light that he was in love with a beautiful woman (Ava Gardner) who may have lured him into pulling off a bank robbery overseen by another man (Albert Dekker).\",\"starring\":\"Ava Gardner, Burt Lancaster, Edmond O'Brien, Sam Leverne\",\"directedBy\":\"Robert Siodmak\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":105,\"genre\":\"Thriller\",\"allGenres\":null,\"rating\":\"PG\",\"trailerYoutubeId\":\"https://www.youtube.com/watch?v=Cq_gxqCaFms\",\"trailerVideo\":null,\"releaseDate\":\"2026-11-25\",\"dateOfFirstShowing\":\"2026-11-25\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"484879\",\"dcmEdiMovieName\":\"#Runseokjin_Ep.Tour The Movie (Concert) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"406311\",\"time\":\"2026-11-25T19:45:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser intro ad-free noirvember\\\"}\"}]},{\"id\":\"34355\",\"name\":\"Back To The Future\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"back-to-the-future-40th-anniversary\",\"posterImage\":\"r704nxzmjirzi1vzrksx66m6wso5\",\"bannerImage\":\"sydxwbbnpp7wpr46z739qbazj5m5\",\"synopsis\":\"Dive into film history and technique with handpicked classics. A friendly introduction and a post-film sociable discussion with film-maker Andrea Carnevali.\\n\\nAcademy Award Wins Best Effects\\nAcademy Award Nominations Best Song, Best Sound, Best Screenplay\\n\\nEighties teenager Marty McFly is accidentally sent back in time to 1955, inadvertently disrupting his parents' first meeting and attracting his mother's romantic interest. Marty must repair the damage to history by rekindling his parents' romance and - with the help of his eccentric inventor friend Doc Brown - return to 1985.\",\"starring\":\"Michael J. Fox, Christopher Lloyd, Crispin Glover\",\"directedBy\":\"Robert Zemeckis\",\"producedBy\":\"Bob Gale, Neil Canton\",\"searchTerms\":\"\",\"duration\":116,\"genre\":\"Adventure\",\"allGenres\":\"Adventure, Comedy, Science Fiction\",\"rating\":\"PG\",\"trailerYoutubeId\":\"ez6WQ7IX72U\",\"trailerVideo\":null,\"releaseDate\":\"2025-10-31\",\"dateOfFirstShowing\":\"2026-11-26\",\"tmdbPopularityScore\":21.9321,\"tmdbId\":\"105\",\"dcmEdiMovieId\":\"2196538\",\"dcmEdiMovieName\":\"Back To The Future (40Th Anniversary) [PG]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"394982\",\"time\":\"2026-11-26T19:45:00Z\",\"ticketsSold\":9,\"screenId\":\"440\",\"seatsRemaining\":92,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser intro ad-free andreas-film-club\\\"}\"}]},{\"id\":\"37997\",\"name\":\"The Royal Ballet: The Nutcracker\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-royal-ballet-the-nutcracker-2\",\"posterImage\":\"u8sjafpos71qx2gfk9nwefvfbzzf\",\"bannerImage\":\"7towl7taq2x98ul0bi4ua23zb2jp\",\"synopsis\":\"\\u003cdiv\\u003eAt a cosy Christmas party, young Clara meets the mysterious magician Drosselmeyer, who gives her a nutcracker doll. When the guests have departed and the house is asleep, Clara sneaks downstairs in search of the doll. Instead, she finds Drosselmeyer, who whisks her away on a journey into a whole world of enchantment: fantastical landscapes of flurried snow and glittering confection where toys come alive and the magic never stops.\\u0026nbsp;\\u003c/div\\u003e\\u003cdiv\\u003ePeter Wright’s production of this festive family favourite sparkles to the wondrous swell of Tchaikovsky’s orchestral score, alongside the glow and grandeur of Julia Trevelyan Oman’s period designs.\\u003c/div\\u003e\",\"starring\":\"Mayara Magri, Reece Clarke, James Hay, Marianna Tsembenhoi, Taisuke Nakao\",\"directedBy\":\"Peter Wright\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":140,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"eRR1FiG__FU\",\"trailerVideo\":null,\"releaseDate\":\"2026-12-01\",\"dateOfFirstShowing\":\"2026-12-01\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"500517\",\"dcmEdiMovieName\":\"Nutcracker 2025 - Rbo, London 2026 (Ballet), The [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"442093\",\"time\":\"2026-12-01T19:15:00Z\",\"ticketsSold\":6,\"screenId\":\"440\",\"seatsRemaining\":95,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"442094\",\"time\":\"2026-12-16T16:35:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"38105\",\"name\":\"The Metropolitan Opera: Samson et Dalila\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-metropolitan-opera-samson-et-dalila\",\"posterImage\":\"ihk556kut228f15iu3tpoltay9x7\",\"bannerImage\":\"c8wvbok7yhr77syk4va78y6886kz\",\"synopsis\":\"\\u003cdiv\\u003eSaint-Saëns’s spectacular take on the biblical hero of legendary strength and the seductive Philistine whose beauty overpowers him returns in the Met’s larger-than-life production. Featuring a massive orchestra and chorus and some of opera’s most spellbinding tunes, this masterpiece is a feast for the eyes and ears. Giacomo Sagripanti conducts an electrifying cast led by the formidable star pairing of mezzo-soprano Aigul Akhmetshina and tenor Clay Hilley, broadcast live to cinemas worldwide.\\u003c/div\\u003e\",\"starring\":\"Aigul Akhmetshina, Clay Hilley\",\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":234,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2026-12-05\",\"dateOfFirstShowing\":\"2026-12-05\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"484879\",\"dcmEdiMovieName\":\"#Runseokjin_Ep.Tour The Movie (Concert) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"441993\",\"time\":\"2026-12-05T17:00:00Z\",\"ticketsSold\":10,\"screenId\":\"440\",\"seatsRemaining\":91,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"441994\",\"time\":\"2026-12-09T11:30:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"39374\",\"name\":\"Phantom Thread\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"phantom-thread\",\"posterImage\":\"ngqls631d2pa6uen1g626q56ddt8\",\"bannerImage\":\"vrbqmu7naznndyx8410j8yyp1b7d\",\"synopsis\":\"Set in the glamour of 1950’s post-war London, renowned dressmaker Reynolds Woodcock [Daniel Day-Lewis] and his sister Cyril [Lesley Manville] are at the center of British fashion, dressing royalty, movie stars, heiresses, socialites, debutants and dames with the distinct style of The House of Woodcock. Women come and go through Woodcock’s life, providing the confirmed bachelor with inspiration and companionship, until he comes across a young, strong-willed woman, Alma [Vicky Krieps], who soon becomes a fixture in his life as his muse and lover. Once controlled and planned, he finds his carefully tailored life disrupted by love. With his latest film, Paul Thomas Anderson paints an illuminating portrait both of an artist on a creative journey, and the women who keep his world running. Phantom Thread is Paul Thomas Anderson’s eighth movie, and his second collaboration with Daniel Day-Lewis.\",\"starring\":\"Daniel Day-Lewis, Vicky Krieps, Lesley Manville, Camilla Rutherford, Jane Perry, Ingrid Sophie Schram\",\"directedBy\":\"Paul Thomas Anderson\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":125,\"genre\":null,\"allGenres\":null,\"rating\":\"15\",\"trailerYoutubeId\":\"xNsiQMeSvMk\",\"trailerVideo\":null,\"releaseDate\":\"2026-12-09\",\"dateOfFirstShowing\":\"2026-12-09\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"230175\",\"dcmEdiMovieName\":\"Phantom Thread (2D) [15]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"463115\",\"time\":\"2026-12-09T20:00:00Z\",\"ticketsSold\":0,\"screenId\":\"442\",\"seatsRemaining\":60,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser knitflicks\\\"}\"}]},{\"id\":\"34696\",\"name\":\"Small Things Like These\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"small-things-like-these\",\"posterImage\":\"u2wucbmuvplc5ddvlg6hkeacs80a\",\"bannerImage\":\"neyly3z6anqz3mbk9yr342820p0e\",\"synopsis\":\"Oscar® winner Cillian Murphy delivers a stunning performance as devoted father Bill Furlong in this film based on the best-selling novel of the same name by Claire Keegan. While working as a coal merchant to support his family, he discovers disturbing secrets kept by the local convent — and uncovers truths of his own — forcing him to confront his past and the complicit silence of a small Irish town controlled by the Catholic Church.\",\"starring\":\"Cillian Murphy, Emily Watson, Michelle Fairley\",\"directedBy\":\"Tim Mielants\",\"producedBy\":\"Matt Damon, Cillian Murphy, Alan Moloney, Catherine Magee, Jeff Robinov, Drew Vinton\",\"searchTerms\":\"\",\"duration\":98,\"genre\":\"Drama\",\"allGenres\":\"Drama\",\"rating\":\"12A\",\"trailerYoutubeId\":\"PBJ3zgH4pGM\",\"trailerVideo\":null,\"releaseDate\":\"2024-11-01\",\"dateOfFirstShowing\":\"2026-12-10\",\"tmdbPopularityScore\":3.2128,\"tmdbId\":\"1102493\",\"dcmEdiMovieId\":\"421702\",\"dcmEdiMovieName\":\"Small Things Like These (2D) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"397546\",\"time\":\"2026-12-10T19:45:00Z\",\"ticketsSold\":3,\"screenId\":\"440\",\"seatsRemaining\":98,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser ad-free books-on-film\\\"}\"}]},{\"id\":\"34356\",\"name\":\"When Harry Met Sally\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"when-harry-met-sally\",\"posterImage\":\"9xdpi14kx2x06fw12kskuxzx4yr8\",\"bannerImage\":\"u4jj1pilxttdcaxtdqwhljoj052a\",\"synopsis\":\"Dive into film history and technique with handpicked classics. A friendly introduction and a post-film sociable discussion with film-maker Andrea Carnevali.\\n\\nAcademy Award Nominations Best Screenplay\\n\\nDuring their travel from Chicago to New York, Harry and Sally debate whether or not sex ruins a friendship between a man and a woman. Eleven years later, and they're still no closer to finding the answer.\",\"starring\":\"Billy Crystal, Meg Ryan, Carrie Fisher\",\"directedBy\":\"Rob Reiner\",\"producedBy\":\"Rob Reiner, Andrew Scheinman\",\"searchTerms\":\"\",\"duration\":96,\"genre\":\"Comedy\",\"allGenres\":\"Comedy, Romance, Drama\",\"rating\":\"15\",\"trailerYoutubeId\":\"k7utaa1Ify4\",\"trailerVideo\":null,\"releaseDate\":\"1989-07-21\",\"dateOfFirstShowing\":\"2026-12-16\",\"tmdbPopularityScore\":5.9869,\"tmdbId\":\"639\",\"dcmEdiMovieId\":\"1284\",\"dcmEdiMovieName\":null,\"siteId\":\"170\",\"titleClassId\":\"419\",\"showings\":[{\"id\":\"394983\",\"time\":\"2026-12-16T19:45:00Z\",\"ticketsSold\":2,\"screenId\":\"440\",\"seatsRemaining\":99,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser intro ad-free andreas-film-club christmas\\\"}\"}]},{\"id\":\"38120\",\"name\":\"Exhibition on Screen: Renoir \\u0026 Love\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"exhibition-on-screen-renoir-love\",\"posterImage\":\"k8r7o7yc8906pn6747gy0mvzpfak\",\"bannerImage\":\"36w0ktpl4qsmyu44jny8vcynvo6h\",\"synopsis\":\"\\u003cdiv\\u003ePierre-Auguste Renoir is one of the world’s favourite artists; a founding member of the Impressionist movement and a constantly evolving artist, he is unmatched at depicting human connection. The National Gallery’s blockbuster exhibition brings together vibrant masterpieces which explore love in all its forms, bringing colour and warmth into the cold winter months.\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003eWith exclusive access to this exciting new show, Exhibition on Screen will bring these world class works to cinema audiences, with close examination of the art and leading experts exploring the immense skill and influence of this master of colour and connection. Be transported back to a Parisian summer of love through the eyes of a true visionary.\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003eAn unmissable opportunity to fall in love with Renoir this winter.\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003eMade in close collaboration with The National Gallery, London and Musee d’Orsay, Paris.\\u003c/div\\u003e\",\"starring\":null,\"directedBy\":\"Ali Ray\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":90,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2027-01-14\",\"dateOfFirstShowing\":\"2027-01-19\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"511702\",\"dcmEdiMovieName\":\"Exhibition on screen: renoir \\u0026amp; love 2027 (exhibition) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"454561\",\"time\":\"2027-01-19T17:50:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"454567\",\"time\":\"2027-01-24T17:15:00Z\",\"ticketsSold\":2,\"screenId\":\"442\",\"seatsRemaining\":58,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"38004\",\"name\":\"The Metropolitan Opera: La Fanciulla Del West\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-metropolitan-opera-la-fanciulla-del-west\",\"posterImage\":\"ntx16d4a5ibkwhtbwrhoejw078ib\",\"bannerImage\":\"udiy6uwp8jode889amm2tt6ubtk9\",\"synopsis\":\"\\u003cp class=\\\"MsoNormal\\\" style=\\\"margin: 0cm 0cm 8pt; line-height: 15.6933px;\\\"\\u003e\\u003cfont face=\\\"Calibri, sans-serif\\\"\\u003e\\u003cspan style=\\\"font-size: 14.6667px;\\\"\\u003ePuccini’s exhilarating drama of the Wild West returns in a new staging by Richard Jones, marking the\\u0026nbsp;\\u003c/span\\u003e\\u003c/font\\u003e\\u003cspan style=\\\"font-size: 14.6667px; font-family: Calibri, sans-serif;\\\"\\u003ecompany’s first new production of La Fanciulla del West in more than 30 years.\\u003c/span\\u003e\\u003c/p\\u003e\\u003cp class=\\\"MsoNormal\\\" style=\\\"margin: 0cm 0cm 8pt; line-height: 15.6933px;\\\"\\u003e\\u003cspan style=\\\"font-size: 14.6667px; font-family: Calibri, sans-serif;\\\"\\u003eSoprano Vida\\u0026nbsp;\\u003c/span\\u003e\\u003cspan style=\\\"font-size: 14.6667px; font-family: Calibri, sans-serif;\\\"\\u003eMiknevičiūtė makes her Met company debut singing the role of Minnie, the tough tavern owner with\\u0026nbsp;\\u003c/span\\u003e\\u003cspan style=\\\"font-size: 14.6667px; font-family: Calibri, sans-serif;\\\"\\u003ea heart of gold who finds love when she least expects it. Tenor SeokJong Baek is the dashing bandit\\u0026nbsp;\\u003c/span\\u003e\\u003cspan style=\\\"font-size: 14.6667px; font-family: Calibri, sans-serif;\\\"\\u003ewho rambles into the remote California mining town to steal her heart, opposite baritone\\u0026nbsp;\\u003c/span\\u003e\\u003cspan style=\\\"font-size: 14.6667px; font-family: Calibri, sans-serif;\\\"\\u003eChristopher Maltman as the lawman determined to deliver justice—and win Minnie for himself.\\u003c/span\\u003e\\u003c/p\\u003e\\u003cp class=\\\"MsoNormal\\\" style=\\\"margin: 0cm 0cm 8pt; line-height: 15.6933px;\\\"\\u003e\\u003cspan style=\\\"font-size: 14.6667px; font-family: Calibri, sans-serif;\\\"\\u003eMaestro Keri-Lynn Wilson takes the podium to conduct one of opera’s most action-packed\\u0026nbsp;\\u003c/span\\u003e\\u003cspan style=\\\"font-size: 14.6667px; font-family: Calibri, sans-serif;\\\"\\u003eadventures, live from the Met stage to cinemas worldwide.\\u003c/span\\u003e\\u003c/p\\u003e\",\"starring\":\"Vida Miknevičiūtė , SeokJong Baek, Christopher Maltman\",\"directedBy\":\"Richard Jones\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":195,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"eRR1FiG__FU\",\"trailerVideo\":null,\"releaseDate\":\"2027-01-26\",\"dateOfFirstShowing\":\"2027-01-23\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"512068\",\"dcmEdiMovieName\":\"La Fanciulla Del West - Met Opera 2027 (Opera) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"441996\",\"time\":\"2027-01-23T18:00:00Z\",\"ticketsSold\":6,\"screenId\":\"440\",\"seatsRemaining\":95,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"441997\",\"time\":\"2027-01-27T12:30:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"37998\",\"name\":\"The Royal Opera: Götterdämmerung\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-royal-opera-gtterdmmerung\",\"posterImage\":\"aqg7ps2fk0qi27u5wiklxzhmv2hu\",\"bannerImage\":\"xvcx77jxwnk1jdxizxwczee745ef\",\"synopsis\":\"\\u003cspan style=\\\"font-family: Calibri, sans-serif; font-size: 11pt;\\\"\\u003eAn earth in ruin. The twilight of the Gods.\\u003c/span\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\\u003cdiv\\u003eDeception leads to treachery, then devastation, when Siegfried is tricked into betraying Brünnhilde. Learning the truth of her beloved’s innocence, Brünnhilde at last returns the ring to the Rhinemaidens, before ordering that Valhalla be swallowed in flames. For the long-awaited finale of Wagner’s epic saga, director Barrie Kosky situates the rich apocalyptic drama in a contemporary world of dream-like turmoil. Antonio Pappano, Conductor Laureate of The Royal Opera, returns to take on the impassioned, otherworldly music – including Siegfried’s transporting Funeral March and Brünnhilde’s electrifying Immolation Scene. The brilliant cast is led by Elisabet Strid, Andreas Schager and Mika Kares, who together with the full forces of the Orchestra of the Royal Opera House and the Royal Opera Chorus bring opera’s greatest journey to its shattering end.\\u003c/div\\u003e\",\"starring\":\"Andreas Schager, Thomas Lehman, Mika Kares, Christopher Purves, Elisabet Strid, Amanda Majeski, Annika Schlicht, Noa Beinart, Claire Barnett-Jones, Catharine Woodward, Sarah Brady, Niamh O’sullivan, Sian Griffiths\",\"directedBy\":\"Barrie Kosky\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":350,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"eRR1FiG__FU\",\"trailerVideo\":null,\"releaseDate\":\"2027-02-03\",\"dateOfFirstShowing\":\"2027-02-03\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"500518\",\"dcmEdiMovieName\":\"Gotterdammerung - Rbo, London 2027 (Opera) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"442095\",\"time\":\"2027-02-03T16:45:00Z\",\"ticketsSold\":7,\"screenId\":\"440\",\"seatsRemaining\":94,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"442096\",\"time\":\"2027-02-10T10:30:00Z\",\"ticketsSold\":4,\"screenId\":\"440\",\"seatsRemaining\":97,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"37999\",\"name\":\"The Royal Opera: Così Fan Tutte\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-royal-opera-cos-fan-tutte\",\"posterImage\":\"ynn56efhz4dkf9p1989wz8rse77j\",\"bannerImage\":\"sj4x89263zd9qxgoet4q2jefth84\",\"synopsis\":\"\\u003cdiv\\u003eSpurred on by a bet, two young men hatch a plan to test the fidelity of their girlfriends. What follows is a slippery game of seduction and power, the four lovers plunging into a dizzying world of shifting reality, where truth becomes increasingly unstable.\\u0026nbsp;\\u003c/div\\u003e\\u003cdiv\\u003eCosì fan tutte has lost none of its sting since it first scandalised audiences in 1790. In her Main Stage debut, Netia Jones, Associate Director of The Royal Opera, reimagines Mozart’s comedy of manners through a sharp contemporary lens, where 18th-century romantic trickery meets deeply satirical high-tech deceit. Taking on the roles of the lovers is an exciting young cast led by Louise Alder, Simone McIntosh, Mingjie Lei and Huw Montague Rendall, with Gerald Finley as their manipulative game-master Don Alfonso and Emily Pogorelc as Despina. Thomas Hengelbrock conducts, bringing out the exquisite melodies that underpin the provocative, and resolutely modern, themes at the heart of the opera.\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\",\"starring\":\"Louise Alder, Simone Mcintosh, Mingjie Lei, Huw Montague Rendall, Gerald Finley, Emily Pogorelc\",\"directedBy\":\"Netia Jones\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":210,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"eRR1FiG__FU\",\"trailerVideo\":null,\"releaseDate\":\"2027-02-23\",\"dateOfFirstShowing\":\"2027-02-23\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"500519\",\"dcmEdiMovieName\":\"Cosi Fan Tutte - Rbo, London 2027 (Opera) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"442098\",\"time\":\"2027-02-23T18:45:00Z\",\"ticketsSold\":6,\"screenId\":\"440\",\"seatsRemaining\":95,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"442950\",\"time\":\"2027-03-02T13:00:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"38106\",\"name\":\"The Metropolitan Opera: Silent Night\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-metropolitan-opera-silent-night\",\"posterImage\":\"i0p0cv42vutejkb58d8tk0lhl0bd\",\"bannerImage\":\"rsn4h14vscgn5r8il7nqn5yc8g38\",\"synopsis\":\"Following his smash-hit company debut with The Hours, composer Kevin Puts returns to the Met with his Pulitzer Prize–winning opera, inspired by the true events of the 1914 Christmas truce. A poignant depiction of shared humanity in the most inhumane circumstances, Puts’s grand, cinematic opera—with a libretto in English, French, and German by Mark Campbell—has been widely acclaimed since its 2011 premiere, hailed as “an overwhelming emotive experience” by The Guardian. The evocative staging by James Robinson takes the audience directly to the battlefields of the Western Front with a star-studded cast, featuring soprano Elza van den Heever and tenors Ben Bliss and Rolando Villazón, conducted by Maestro Dalia Stasevska live from the Met to cinemas worldwide.\",\"starring\":\"Elza van den Heever, Ben Bliss, Rolando Villazón\",\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":180,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2027-03-20\",\"dateOfFirstShowing\":\"2027-03-20\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"484879\",\"dcmEdiMovieName\":\"#Runseokjin_Ep.Tour The Movie (Concert) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"441998\",\"time\":\"2027-03-20T17:00:00Z\",\"ticketsSold\":4,\"screenId\":\"440\",\"seatsRemaining\":97,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"441999\",\"time\":\"2027-03-24T13:00:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"38000\",\"name\":\"The Royal Ballet: Alice's Adventures In Wonderland\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-royal-ballet-alices-adventures-in-wonderland\",\"posterImage\":\"ef6ybz7ofums9misff7grtb7h8pp\",\"bannerImage\":\"d2resuaa6v7an92w176bppas3ftw\",\"synopsis\":\"\\u003cdiv\\u003eAt a garden party on a sunny afternoon, Alice is surprised to see her parents’ friend Lewis Carroll transform into a white rabbit. When she follows him down a rabbit hole, events become curiouser and curiouser…As Alice journeys through Wonderland, she encounters countless strange creatures. She’s swept off her feet by the charming Knave of Hearts, who’s on the run for stealing the tarts. Confusion piles upon confusion. Then Alice wakes with a start. Was it all a daydream?\\u0026nbsp;\\u003c/div\\u003e\\u003cdiv\\u003eChristopher Wheeldon’s Alice’s Adventures in Wonderland burst onto the stage in 2011 in an explosion of colour, stage magic and inventive, sophisticated choreography. Joby Talbot’s score combines contemporary soundworlds with sweeping melodies that gesture to ballet scores of the 19th century. Bob Crowley’s wildly imaginative, eye-popping designs draw on everything from puppetry to projections to make Wonderland wonderfully real. The result shows The Royal Ballet at its best, bringing together world-class dance with enchanting family entertainment and ingenious music and design.\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\",\"starring\":\"Francesca Hayward, William Bracewell, James Hay, Lauren Cuthbertson, Bennet Gartside, Steven Mcrae, Nicol Edmonds, Gary Avis\",\"directedBy\":\"Christopher Wheeldon\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":170,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"eRR1FiG__FU\",\"trailerVideo\":null,\"releaseDate\":\"2027-03-23\",\"dateOfFirstShowing\":\"2027-03-23\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"500547\",\"dcmEdiMovieName\":\"Alice's Adventures In Wonderland 2024 - Rbo, London 2027 (Ballet) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"442100\",\"time\":\"2027-03-23T19:15:00Z\",\"ticketsSold\":8,\"screenId\":\"440\",\"seatsRemaining\":93,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"442111\",\"time\":\"2027-03-31T12:15:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"38107\",\"name\":\"The Metropolitan Opera: Manon\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-metropolitan-opera-manon\",\"posterImage\":\"e73gro22csad94u8vc4i5jggp0n3\",\"bannerImage\":\"hz3rr1lbfk31f0lxs7t6vy7e72x1\",\"synopsis\":\"Following her radiant performance in Gounod’s Roméo et Juliette—which garnered raves for “high notes that spun like liquid gold … Sierra touched the operatic firmament” (The New York Times)—superstar soprano Nadine Sierra takes on another alluring French heroine, the irresistible title character of Massenet’s passionate drama, live from the Met stage to cinemas worldwide. Leading tenor Matthew Polenzani is her idealistic lover, the Chevalier des Grieux, with rising-star baritone Andrzej Filończyk as her stalwart cousin, Lescaut, in a breathtaking staging by director Laurent Pelly.\",\"starring\":\"Matthew Polenzani, Andrzej Filończyk\",\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":264,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2027-04-03\",\"dateOfFirstShowing\":\"2027-04-03\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"484879\",\"dcmEdiMovieName\":\"#Runseokjin_Ep.Tour The Movie (Concert) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"442000\",\"time\":\"2027-04-03T16:00:00Z\",\"ticketsSold\":6,\"screenId\":\"440\",\"seatsRemaining\":95,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"442001\",\"time\":\"2027-04-07T10:30:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"38001\",\"name\":\"The Royal Ballet: Swan Lake\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-royal-ballet-swan-lake\",\"posterImage\":\"lhoy0ggho9tzhoosp16gmmfv35bg\",\"bannerImage\":\"ognmuilo7j67s3c5ryhxsqrcurub\",\"synopsis\":\"\\u003cdiv\\u003ePrincess Odette is bound by a curse, turned into a swan by the evil sorcerer Von Rothbart. The spell can only be broken by a pledge of eternal love. When she meets Prince Siegfried, he is immediately enamoured by her fragile beauty and pledges to free her. But freedom is not promised for Odette as Von Rothbart conspires to thwart the lovers’ plans.\\u003c/div\\u003e\\u003cdiv\\u003eLiam Scarlett’s production for The Royal Ballet brings together Tchaikovsky’s towering score and John Macfarlane’s picturesque designs to create an enduring ballet spectacle of love, treachery and forgiveness.\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\",\"starring\":null,\"directedBy\":\"Christopher Wheeldon\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":205,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"eRR1FiG__FU\",\"trailerVideo\":null,\"releaseDate\":\"2027-04-22\",\"dateOfFirstShowing\":\"2027-04-22\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"500520\",\"dcmEdiMovieName\":\"Swan Lake - Rbo, London 2027 (Ballet) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"442112\",\"time\":\"2027-04-22T18:15:00Z\",\"ticketsSold\":9,\"screenId\":\"440\",\"seatsRemaining\":92,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"442113\",\"time\":\"2027-04-27T12:00:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"38109\",\"name\":\"The Metropolitan Opera: Otello\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-metropolitan-opera-otello\",\"posterImage\":\"xqnuubzmbdz8r86a67yzjgr6d7j7\",\"bannerImage\":\"undn34g4f9sxxl1qb0z5icbfxght\",\"synopsis\":\"\\u003cp class=\\\"MsoNormal\\\" style=\\\"margin: 0cm; line-height: normal; font-size: 12pt; font-family: Aptos, sans-serif;\\\"\\u003e\\u003cspan style=\\\"font-family: Calibri, sans-serif;\\\"\\u003eOne of today’s leading dramatic tenors, Brian Jagde, takes on the tour-de-force title role of what many consider the ultimate Italian opera, live to cinemas worldwide. Verdi’s monumental Shakespearean tragedy also features soprano Ailyn Pérez in her company role debut as the long-suffering Desdemona, alongside baritone Artur Ruciński as the sinister Iago. Michele Mariotti leads the full forces of the Met Orchestra and Chorus in the exhilarating score.\\u003co:p\\u003e\\u003c/o:p\\u003e\\u003c/span\\u003e\\u003c/p\\u003e\",\"starring\":\"Brian Jagde, Ailyn Pérez, Artur Ruciński\",\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":201,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2027-04-24\",\"dateOfFirstShowing\":\"2027-04-24\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"484879\",\"dcmEdiMovieName\":\"#Runseokjin_Ep.Tour The Movie (Concert) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"442002\",\"time\":\"2027-04-24T17:00:00Z\",\"ticketsSold\":6,\"screenId\":\"440\",\"seatsRemaining\":95,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"442003\",\"time\":\"2027-04-28T11:30:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"38002\",\"name\":\"The Royal Opera: Tosca\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-royal-opera-tosca\",\"posterImage\":\"m5li1ev8jodmylht9v6naobuqkqo\",\"bannerImage\":\"cpqoymtozc8mrah8z423rx1l3epb\",\"synopsis\":\"\\u003cdiv\\u003eFloria Tosca and Mario Cavaradossi live for each other and for their art. But when Cavaradossi helps an escaped prisoner, the lovers make a deadly enemy in the form of Baron Scarpia, Chief of Police. At the mercy of Scarpia’s twisted desires, Tosca is forced to make a horrific bargain: sleeping with the man she hates, in order to save the man she loves. Can she find a way out?\\u003c/div\\u003e\\u003cdiv\\u003eOliver Mears’s acclaimed production returns, setting Puccini’s operatic thriller in a contemporary, war-torn Rome. Daniel Oren conducts Aleksandra Kurzak, who returns to the title role, joined by Saimir Pirgu as Cavaradossi and Christopher Maltman as Baron Scarpia.\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\",\"starring\":\"Aleksandra Kurzak, Saimir Pirgu, Christopher Maltman, Aled Hall, Jonathan Lemalu, Paweł Horodyski, Sam Hird\",\"directedBy\":\"Aleksandra Kurzak, Saimir Pirgu, Christopher Maltman, Aled Hall, Jonathan Lemalu, Paweł Horodyski\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":195,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"eRR1FiG__FU\",\"trailerVideo\":null,\"releaseDate\":\"2027-05-05\",\"dateOfFirstShowing\":\"2027-05-05\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"500521\",\"dcmEdiMovieName\":\"Tosca - Rbo, London 2027 (Opera) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"442115\",\"time\":\"2027-05-05T18:00:00Z\",\"ticketsSold\":5,\"screenId\":\"440\",\"seatsRemaining\":96,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"442116\",\"time\":\"2027-05-12T12:00:00Z\",\"ticketsSold\":4,\"screenId\":\"440\",\"seatsRemaining\":97,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"38121\",\"name\":\"Exhibition on Screen: Monet\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"exhibition-on-screen-monet\",\"posterImage\":\"go5hp9iu0oodks0m0oxhcbjaef9d\",\"bannerImage\":\"wuhuypz7f8lhud4nj2jjc9harwo9\",\"synopsis\":\"\\u003cdiv\\u003eTo celebrate Tate Britain’s blockbuster Monet and Time exhibition, Exhibition on Screen is delighted to bring the iconic story of Claude Monet to cinema\\u003c/div\\u003e\\u003cdiv\\u003escreens in May 2027. Undeniably one of the world’s favourite artists and the figurehead of the Impressionist movement prepare to be dazzled by his spectacular and revolutionary use of light and colour and step into one the most famous gardens in art history. Immerse yourself in iconic masterpieces and discover the incredible story of passion and rebellion in this exciting documentary on the man who named the world’s favourite art movement.\\u003c/div\\u003e\",\"starring\":null,\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":90,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2027-05-11\",\"dateOfFirstShowing\":\"2027-05-11\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"210930\",\"dcmEdiMovieName\":\"Exhibition On Screen: I, Claude Monet (Exhibition) (2D) [U]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"454589\",\"time\":\"2027-05-11T16:50:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"454590\",\"time\":\"2027-05-16T16:30:00Z\",\"ticketsSold\":2,\"screenId\":\"442\",\"seatsRemaining\":58,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"38003\",\"name\":\"The Royal Ballet: Romeo \\u0026 Juliet\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-royal-ballet-romeo-juliet\",\"posterImage\":\"mfkj3pbr4oxaxgxuwzxvjw9o5n8p\",\"bannerImage\":\"1721lq7tcdqoktds3sh39x26riw9\",\"synopsis\":\"\\u003cdiv\\u003eThe Capulets and Montagues are sworn enemies. Yet it is love at first sight for Romeo Montague and Juliet Capulet when they meet each other at the Capulet ball, into which Romeo has snuck. The two fall in love and they profess their devotion to each other at Juliet’s balcony. They secretly get married.\\u0026nbsp; \\u0026nbsp;\\u003c/div\\u003e\\u003cdiv\\u003eThe stakes are raised for the young couple when Romeo avenges the death of his friend Mercutio who has been killed by Tybalt, Juliet’s cousin. For this, Romeo is exiled from Verona. Meanwhile, Juliet’s parents are forcing her to marry another suitor. In order to be together, Romeo and Juliet must risk it all.\\u0026nbsp;\\u0026nbsp;\\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\",\"starring\":\"Fumi Kaneko, Vadim Muntagirov, Francisco Serrano, Ryoichi Hirano, Giacomo Rovero, Lukas B. Brændsrød, Bennet Gartside, Christina Arestis, Harris Bell, Annette Buvoli, Olivia Cowley, Thomas Whitehead, Thomas Whitehead, Lara Turk\",\"directedBy\":\"Kenneth MacMillan\",\"producedBy\":null,\"searchTerms\":\"\",\"duration\":170,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":\"eRR1FiG__FU\",\"trailerVideo\":null,\"releaseDate\":\"2027-05-25\",\"dateOfFirstShowing\":\"2027-05-25\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"500522\",\"dcmEdiMovieName\":\"Romeo \\u0026amp; Juliet 2025 - Rbo, London 2027 (Ballet) [Unknown]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"442117\",\"time\":\"2027-05-25T18:15:00Z\",\"ticketsSold\":8,\"screenId\":\"440\",\"seatsRemaining\":93,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"442118\",\"time\":\"2027-06-01T12:30:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]},{\"id\":\"38110\",\"name\":\"The Metropolitan Opera: Parsifal\",\"showingStatus\":\"On Sale\",\"urlSlug\":\"the-metropolitan-opera-parsifal\",\"posterImage\":\"b8yuygwzoyxzrdedaqq6int7oh9o\",\"bannerImage\":\"n3rv1rlktlcyqwso6tgi99i8uykz\",\"synopsis\":\"\\u003cp class=\\\"MsoNormal\\\" style=\\\"margin: 0cm; line-height: normal; font-size: 12pt; font-family: Aptos, sans-serif;\\\"\\u003e\\u003cspan style=\\\"font-family: Calibri, sans-serif; font-size: 12pt;\\\"\\u003eA profound philosophical meditation on compassion and reconciliation, this transcendent rendering of a medieval knight’s heroic quest for the Holy Grail returns to the big screen in François Girard’s celebrated production, a “thoughtful and intrepid staging, full of striking imagery” (\\u003c/span\\u003e\\u003ci style=\\\"font-family: Calibri, sans-serif; font-size: 12pt;\\\"\\u003eThe New York Times\\u003c/i\\u003e\\u003cspan style=\\\"font-family: Calibri, sans-serif; font-size: 12pt;\\\"\\u003e). Yannick Nézet-Séguin conducts a cast of Wagnerian superstars, including tenor Piotr Beczała in the title role, mezzo-soprano Elīna Garanča as the enigmatic Kundry, baritone Peter Mattei as the ailing Amfortas, bass-baritone Ryan Speedo Green as the sorcerer Klingsor, and bass Jongmin Park as the wise Gurnemanz.\\u003c/span\\u003e\\u003c/p\\u003e\",\"starring\":\"Piotr Beczała, Elīna Garanča, Peter Mattei, Ryan Speedo Green, Jongmin Park\",\"directedBy\":null,\"producedBy\":null,\"searchTerms\":\"\",\"duration\":365,\"genre\":null,\"allGenres\":null,\"rating\":\"TBC\",\"trailerYoutubeId\":null,\"trailerVideo\":null,\"releaseDate\":\"2027-06-05\",\"dateOfFirstShowing\":\"2027-06-05\",\"tmdbPopularityScore\":null,\"tmdbId\":null,\"dcmEdiMovieId\":\"484879\",\"dcmEdiMovieName\":\"#Runseokjin_Ep.Tour The Movie (Concert) [12A]\",\"siteId\":\"170\",\"titleClassId\":\"411\",\"showings\":[{\"id\":\"442007\",\"time\":\"2027-06-05T16:00:00Z\",\"ticketsSold\":6,\"screenId\":\"440\",\"seatsRemaining\":95,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"},{\"id\":\"442008\",\"time\":\"2027-06-09T09:30:00Z\",\"ticketsSold\":0,\"screenId\":\"440\",\"seatsRemaining\":101,\"displayMetaData\":\"{\\\"classes\\\":\\\"51 4k laser event-cinema\\\"}\"}]}]}}}",
