            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-06-25\",\"showtimes\":[{\"id\":\"125-53114\",\"schedule\":{\"businessDate\":\"2026-06-25\",\"startsAt\":\"2026-06-25T19:00:00+01:00\",\"endsAt\":\"2026-06-25T22:25:00+01:00\",\"filmStartsAt\":\"2026-06-25T19:25:00+01:00\",\"filmEndsAt\":\"2026-06-25T22:25:00+01:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"125-5-43\",\"filmId\":\"HO00008186\",\"siteId\":\"125\",\"screenId\":\"125-5\",\"areaCategories\":[{\"areaCategoryId\":\"125-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"125-0000000013\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"125\",\"name\":{\"text\":\"Holloway\",\"translations\":[]},\"location\":{\"latitude\":51.5586,\"longitude\":-0.1214},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"419-427 Holloway Road\",\"line2\":\"Holloway\",\"city\":\"N7 6LJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008186\",\"title\":{\"text\":\"National Theatre Live: Les Liaisons Dangereuses\",\"translations\":[]},\"synopsis\":{\"text\":\"BAFTA Award-winner Lesley Manville (Phantom Thread) joins Aidan Turner (Rivals) in a striking new staging of Christopher Hampton’s celebrated adaptation of the classic novel, where among the glittering salons of the super-rich, one misstep can mean ruin. Marquise de Merteuil is a master in the art of survival. Alongside the magnetic Vicomte de Valmont, they turn seduction into strategy and weaponise desire. But when their alliance collapses into rivalry, the battle between them threatens to destroy everyone in their path. Filmed live on stage at the National Theatre, Marianne Elliott (Angels in America) directs this thrilling game of love, lies, and social warfare.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Lesley Manville joins Aidan Turner in a striking new staging of Christopher Hampton’s celebrated adaptation of the classic novel.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-25\",\"runtimeInMinutes\":180,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000001390\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017351\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000008\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001059\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000039\"],\"externalIds\":{\"moviexchangeReleaseId\":\"aa97deea-6338-4e8d-af81-15581ad7da6b\",\"corporateId\":null},\"hopk\":\"HO00008186\",\"hoCode\":\"A000009278\",\"eventId\":\"0000000001\",\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"0000001390\",\"name\":{\"givenName\":\"Marianne\",\"familyName\":\"Elliott\",\"middleName\":null}},{\"id\":\"0000017351\",\"name\":{\"givenName\":\"Aidan\",\"familyName\":\"Turner\",\"middleName\":null}},{\"id\":\"HO00000008\",\"name\":{\"givenName\":\"Lesley\",\"familyName\":\"Manville\",\"middleName\":null}},{\"id\":\"HO00001059\",\"name\":{\"givenName\":\"Monica\",\"familyName\":\"Barbaro\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000039\",\"name\":{\"text\":\"Live Theatre\",\"translations\":[]},\"description\":null}],\"censorRatings\":[{\"id\":\"0000000010\",\"classification\":{\"text\":\"TBC\",\"translations\":[]},\"classificationDescription\":{\"text\":\"To be confirmed\",\"translations\":[]},\"ageRestriction\":{\"minimumAge\":0}}],\"attributes\":[{\"id\":\"0000000178\",\"name\":{\"text\":\"Event Cinema\",\"translations\":[]},\"shortName\":{\"text\":\"EventCinem\",\"translations\":[]},\"description\":null,\"importantMessage\":null,\"displayPriority\":8,\"isPromoted\":true},{\"id\":\"0000000143\",\"name\":{\"text\":\"ODEON Luxe\",\"translations\":[]},\"shortN