00187\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"125\",\"name\":{\"text\":\"Holloway\",\"translations\":[]},\"location\":{\"latitude\":51.5586,\"longitude\":-0.1214},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"419-427 Holloway Road\",\"line2\":\"Holloway\",\"city\":\"N7 6LJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008218\",\"title\":{\"text\":\"Toy Story 5\",\"translations\":[]},\"synopsis\":{\"text\":\"The toys are back in Disney and Pixar’s “Toy Story 5,” and this time around it’s Toy meets Tech. Buzz, Woody, Jessie and the rest of the gang’s jobs get exponentially harder when they go head to head with this all-new threat to playtime.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"The toys are back in Disney and Pixar’s “Toy Story 5,” and this time around it’s Toy meets Tech. \",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-19\",\"runtimeInMinutes\":102,\"trailerUrl\":\"https://www.youtube.com/watch?v=RFm6wN7IhtY\",\"displayPriority\":3,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002721\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000002933\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004242\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009613\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010641\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017418\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017419\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"7850\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000222\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002742\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"e4e53d03-846a-4c4b-a95f-af4af0f815b4\",\"corporateId\":null},\"hopk\":\"HO00008218\",\"hoCode\":\"A000009312\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008413\",\"title\":{\"text\":\"Supergirl\",\"translations\":[]},\"synopsis\":{\"text\":\"When an unexpected and ruthless adversary strikes too close to home, Kara Zor-El, aka Supergirl, reluctantly joins forces with an unlikely companion on an epic, interstellar journey of vengeance and justice.\\n\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"It follows Kara Zor-El's story and her darker origin before she finally made her way to Earth.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-25\",\"runtimeInMinutes\":108,\"trailerUrl\":\"https://www.youtube.com/watch?v=wxTiyxH9eZw\",\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000007748\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000014392\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017778\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001063\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001118\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001286\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001846\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002429\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002629\",\"roles\":[\"Director\"]}],\"genreIds\":[\"0000000001\",\"0000000003\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"dbd619f1-56eb-431b-8c89-2eb427edd34f\",\"corporateId\":null},\"hopk\":\"HO00008413\",\"hoCode\":\"A000009517\",\"eventId\":null,\"distributorName\":\"WARNER BROS DISTRIBUTORS LTD\"},{\"id\":\"HO00008415\",\"title\":{\"text\":\"Moana\",\"translations\":[]},\"synopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyages beyond the reef of her island of Motunui with the infamous demigod Maui (Dwayne Johnson) on an unforgettable journey to restore prosperity to her people. The film is directed by Emmy® and Tony Award® winner Thomas Kail (“Hamilton”); produced by Dwayne Johnson, Dany Garcia, Beau Flynn, Hiram Garcia and Lin-Manuel Miranda; and executive produced by Thomas Kail, Scott Sheldon, Charles Newirth and Auliʻi Cravalho, who voiced Moana in the animated features “Moana” and “Moana 2.”\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In Disney’s live-action adaptation of the beloved Oscar®-nominated animated adventure, Moana (Catherine Lagaʻaia) answers the Ocean’s call and, for the first time, voyage\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":115,\"trailerUrl\":\"https://www.youtube.com/watch?v=zQjHSoVCQLs\",\"displayPriority\":1,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000117\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000001075\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009582\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000016273\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000017779\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017780\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000102\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000113\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000114\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001036\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"6d579a6e-0609-4ead-992c-190cf5e0fd6f\",\"corporateId\":null},\"hopk\":\"HO00008415\",\"hoCode\":\"A000009519\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008466\",\"title\":{\"text\":\"Masters of the Universe\",\"translations\":[]},\"synopsis\":{\"text\":\"In MASTERS OF THE UNIVERSE, Director Travis Knight brings the legendary franchise back to the big screen in this epic live-action adventure. After being separated for 15 years, the Sword of Power leads Prince Adam (Nicholas Galitzine) back to Eternia where he discovers his home shattered under the fiendish rule of Skeletor (Jared Leto). To save his family and his world, Adam must join forces with his closest allies, Teela (Camila Mendes) and Duncan/Man-At-Arms (Idris Elba), and embrace his true destiny as He-Man — the most powerful man in the universe.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"In MASTERS OF THE UNIVERSE, Director Travis Knight brings the legendary franchise back to the big screen in this epic live-action adventure. \",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate fantasy violence, innuendo, language\",\"translations\":[]},\"releaseDate\":\"2026-06-03\",\"runtimeInMinutes\":141,\"trailerUrl\":\"https://www.youtube.com/watch?v=8R-N0NDdvww\",\"displayPriority\":11,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000207\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000007179\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000009132\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000017897\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017898\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000141\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000186\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001004\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001016\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001690\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001820\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001821\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001822\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002423\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"HO00002675\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002722\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000001\",\"0000000009\",\"0000000011\"],\"externalIds\":{\"moviexchangeReleaseId\":\"5b57ae1f-ac97-4f6c-8af7-1c0fb9741a29\",\"corporateId\":null},\"hopk\":\"HO00008466\",\"hoCode\":\"A000009574\",\"eventId\":null,\"distributorName\":\"SONY PICTURES\"},{\"id\":\"HO00008468\",\"title\":{\"text\":\"Disclosure Day\",\"translations\":[]},\"synopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming close to … Disclosure Day.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This June, the truth belongs to seven billion people.\\n\\nWe are coming.\",\"translations\":[]},\"censorRatingId\":\"0000000001\",\"censorRatingNote\":{\"text\":\"moderate threat, violence, injury detail, infrequent strong language\",\"translations\":[]},\"releaseDate\":\"2026-06-10\",\"runtimeInMinutes\":145,\"trailerUrl\":\"https://www.youtube.com/watch?v=WnW25gFk2Mk\",\"displayPriority\":9,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000219\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000000635\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000010990\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000216\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000318\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001974\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"HO00002474\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000020\"],\"externalIds\":{\"moviexchangeReleaseId\":\"1f2756b4-b117-4f07-b240-55d7611c2d78\",\"corporateId\":null},\"hopk\":\"HO00008468\",\"hoCode\":\"A000009576\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008565\",\"title\":{\"text\":\"Minions & Monsters\",\"translations\":[]},\"synopsis\":{\"text\":\"Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe with a riotous new chapter, featuring all-new characters, in the biggest global animated franchise in history: Minions & Monsters.\\n\\nThis is the rambunctious, ridiculous and totally true story of how the Minions conquered Hollywood, became movie stars, lost everything, unleashed monsters onto the world and then banded together to try and save the planet from the mayhem they had just created.\\n\\nMinions & Monsters is directed by Academy Award® nominee Pierre Coffin, a director of the first three Despicable Me films and the first Minions film. Coffin has also provided the voice for the Minions since their film debut in 2010. The film is written by Brian Lynch (Minions, The Secret Life of Pets films) and Pierre Coffin and is produced by Illumination’s Academy Award® nominated founder and CEO Chris Meledandri and by Bill Ryan (executive producer, The Super Mario Bros. Movie). The executive producer is Brian Lynch.\\n\\nMore than ten years after their creation, the Minions have become the most iconic animated characters of their generation. Globally recognised and beloved by fans of all ages, they have propelled Illumination’s Despicable Me and Minions to a global box office of more than $5.6 billion.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe \",\"translations\":[]},\"censorRatingId\":\"0000000011\",\"censorRatingNote\":{\"text\":\"very mild comic violence, threat, rude humour\",\"translations\":[]},\"releaseDate\":\"2026-07-01\",\"runtimeInMinutes\":90,\"trailerUrl\":\"https://www.youtube.com/watch?v=drr0on3W0K8\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002698\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002922\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005418\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017409\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018101\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"18969\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000015\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000542\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001046\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"HO00001049\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001410\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"1051448b-9ebc-4ce8-b9e7-c007182dbdca\",\"corporateId\":null},\"hopk\":\"HO00008565\",\"hoCode\":\"A000009677\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008744\",\"title\":{\"text\":\"Obsession\",\"translations\":[]},\"synopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for but soon discovers that some desires come at a dark, sinister price.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"After breaking the mysterious “One Wish Willow” to win his crush’s heart, a hopeless romantic finds himself getting exactly what he asked for.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong violence, gore\",\"translations\":[]},\"releaseDate\":\"2026-05-15\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=fWLaCC8L6Jo\",\"displayPriority\":10,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002047\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006579\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000018515\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018516\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018517\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018518\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018519\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018520\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000018521\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a6a25d26-497a-4daa-a5ff-b5fc9719faca\",\"corporateId\":null},\"hopk\":\"HO00008744\",\"hoCode\":\"A000009874\",\"eventId\":null,\"distributorName\":\"UNIVERSAL PICTURES\"},{\"id\":\"HO00008914\",\"title\":{\"text\":\"jackass: best and last\",\"translations\":[]},\"synopsis\":{\"text\":\"Johnny Knoxville and the gang return for one final fling at the big screen. Featuring all-new stunts and stupidity along with the greatest hits and biggest laughs from the past, jackass: best and last is a joyously raucous celebration of all the mischievous camaraderie that you’ve come to love and expect from these idiots over the past 25 years. So, grab your dumb little buddies, raise your glasses, and come experience the cinematic event that promises to be the last time you’ll ever laugh this hard in a theatre.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Johnny Knoxville and the gang return for one final fling at the big screen. Featuring all-new stunts and stupidity along with the greatest hits and biggest laughs.\",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":null,\"releaseDate\":\"2026-06-26\",\"runtimeInMinutes\":92,\"trailerUrl\":\"https://www.youtube.com/watch?v=erztPGWNkY4\",\"displayPriority\":7,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000002327\",\"roles\":[\"Actor\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000002329\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000002330\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000018944\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018945\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018946\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000018947\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"3163\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3164\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3165\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3167\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"3178\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"3195\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"434e102b-e02e-431e-aff7-3ea7cd362f6b\",\"corporateId\":null},\"hopk\":\"HO00008914\",\"hoCode\":\"A000010056\",\"eventId\":null,\"distributorName\":\"Paramount Pictures\"},{\"id\":\"HO00008964\",\"title\":{\"text\":\"Evil Dead Burn\",\"translations\":[]},\"synopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. After the loss of her husband, a woman seeks solace with her in-laws in their secluded family home. As one by one they are transformed into Deadites—turning the gathering into a family reunion from hell—she comes to discover that the vows she took in life... live on even in death.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Evil Dead Burn unleashes the franchise’s most savage and terrifying ride to date, blazing onto big screens with an all-new chapter of carnage and demonic mayhem. \",\"translations\":[]},\"censorRatingId\":\"0000000005\",\"censorRatingNote\":{\"text\":\"strong bloody violence, gore\",\"translations\":[]},\"releaseDate\":\"2026-07-09\",\"runtimeInMinutes\":109,\"trailerUrl\":\"https://www.youtube.com/watch?v=YYkUkyfjUKg\",\"displayPriority\":4,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000008177\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000009258\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019021\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019022\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019023\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019024\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000303\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000014\"],\"externalIds\":{\"moviexchangeReleaseId\":\"3c50ff95-67b2-4152-9965-ad2431794116\",\"corporateId\":null},\"hopk\":\"HO00008964\",\"hoCode\":\"A000010114\",\"eventId\":null,\"distributorName\":\"STUDIOCANAL\"},{\"id\":\"HO00009072\",\"title\":{\"text\":\"The Invite\",\"translations\":[]},\"synopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \\nHave they reignited the spark or lit the match that burns it all down?\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Joe and Angela’s marriage is on thin ice. When they invite their enigmatic \\nupstairs neighbors for a dinner party, the night spirals into unexpected places. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"very strong language, strong sex references, drug misuse\",\"translations\":[]},\"releaseDate\":\"2026-07-03\",\"runtimeInMinutes\":106,\"trailerUrl\":\"https://www.youtube.com/watch?v=7YIHRhRMn94\",\"displayPriority\":8,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000785\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000004368\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019329\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000019330\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000241\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00001028\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00001154\",\"roles\":[\"Actor\",\"Director\"]},{\"castAndCrewMemberId\":\"HO00002297\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000006\"],\"externalIds\":{\"moviexchangeReleaseId\":\"a87bd21e-c69e-4d0b-b7d0-18dabf2eeb9f\",\"corporateId\":null},\"hopk\":\"HO00009072\",\"hoCode\":\"A000010230\",\"eventId\":null,\"distributorName\":\"Black Bear Pictures\"},{\"id\":\"HO00009121\",\"title\":{\"text\":\"A Private Life\",\"translations\":[]},\"synopsis\":{\"text\":\"When renowned psychiatrist Lilian Steiner learns of the death of one of her patients, she is convinced it was murder and takes it upon herself to investigate…\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"When renowned psychiatrist Lilian Steiner learns of the death of one of her patients, she is convinced it was murder and takes it upon herself to investigate…\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong language, sex, nudity, violence\",\"translations\":[]},\"releaseDate\":\"2026-06-26\",\"runtimeInMinutes\":103,\"trailerUrl\":\"https://www.youtube.com/watch?v=2JabG5C6IU8\",\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000563\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000001378\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005522\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000005592\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019421\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019422\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000019423\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000019424\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000841\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000006\",\"0000000009\",\"0000000053\"],\"externalIds\":{\"moviexchangeReleaseId\":\"d27e2ad4-d991-4209-80b3-c7938d3ec49a\",\"corporateId\":null},\"hopk\":\"HO00009121\",\"hoCode\":\"A000010285\",\"eventId\":null,\"distributorName\":\"ALTITUDE\"},{\"id\":\"HO00009124\",\"title\":{\"text\":\"Life Support\",\"translations\":[]},\"synopsis\":{\"text\":\"Since October 2023, Gaza has been sealed from the world-except for one group. While journalists are barred and governments look away, international doctors breach the blockade, walking into a nightmare of Israel's making. What they find is not just a humanitarian crisis, but a calculated dismantling of life itself. Intercutting between interviews, doctors' video diaries from Gaza and original material shot by Palestinian journalists in Gaza, the film delves into the daily struggles of these medical professionals as they navigate bombed-out hospitals, dwindling supplies, and the overwhelming influx of casualties- predominantly women and children. Their firsthand accounts provide a rare and vital perspective on the human cost of the conflict, offering a counter-narrative to the official stories propagated by state actors and their media outlets. The film explores the doctors' motivations for going to Gaza, their moral dilemmas in the face of unimaginable suffering. The chronicles they offer highlight the broader implications of their work as they become de facto journalists and human rights advocates, documenting the deliberate destruction of the health-care system and Israel's attempt to erase Gaza's present and make its future impossible. The doctors' testimonies also highlight the extraordinary resolve of a people determined to uphold their rights and dignity in the face of almost complete silence from the international community.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Since October 2023, Gaza has been sealed from the world-except for one group. International doctors breach the blockade, what they find is not just a humanitarian crisis.\",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong injury detail, images of real dead bodies, distressing scenes\",\"translations\":[]},\"releaseDate\":\"2026-07-10\",\"runtimeInMinutes\":93,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000019425\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"000