          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"businessDate\":\"2026-02-26\",\"showtimes\":[{\"id\":\"125-53112\",\"schedule\":{\"businessDate\":\"2026-02-26\",\"startsAt\":\"2026-02-26T19:00:00+00:00\",\"endsAt\":\"2026-02-26T22:25:00+00:00\",\"filmStartsAt\":\"2026-02-26T19:25:00+00:00\",\"filmEndsAt\":\"2026-02-26T22:25:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"125-5-43\",\"filmId\":\"HO00008184\",\"siteId\":\"125\",\"screenId\":\"125-5\",\"areaCategories\":[{\"areaCategoryId\":\"125-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"125-0000000013\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000178\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":\"0000000001\",\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"125\",\"name\":{\"text\":\"Holloway\",\"translations\":[]},\"location\":{\"latitude\":51.5586,\"longitude\":-0.1214},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"419-427 Holloway Road\",\"line2\":\"Holloway\",\"city\":\"N7 6LJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00008184\",\"title\":{\"text\":\"National Theatre Live: The Audience (Rerelease)\",\"translations\":[]},\"synopsis\":{\"text\":\"Returning to cinemas for the first time in over a decade, Helen Mirren plays Queen Elizabeth II in the Olivier and Tony Award® -winning hit production, directed by Stephen Daldry. For 60 years, Queen Elizabeth II met with each of her 12 prime ministers in a private weekly meeting. This meeting is known as The Audience. From Winston Churchill to Margaret Thatcher and David Cameron, the Queen advised her prime ministers on matters both public and personal. Through these private audiences, we see glimpses of the woman behind the crown and witness the moments that shaped a monarch. Peter Morgan’s Netflix phenomenon The Crown was based on this hit play that was captured live from London’s West End in 2013 and went on to become one of the most-watched NT Live productions.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Academy Award-winner Helen Mirren plays Queen Elizabeth II in the much-anticipated return of the Olivier Award–winning hit production, that inspired Netflix’s The Crown.\",\"translations\":[]},\"censorRatingId\":\"0000000010\",\"censorRatingNote\":null,\"releaseDate\":\"2026-02-26\",\"runtimeInMinutes\":180,\"trailerUrl\":null,\"displayPriority\":50,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000000328\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000004641\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017347\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000017348\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000137\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000447\",\"roles\":[\"Producer\"]}],\"genreIds\":[\"0000000009\",\"0000000039\"],\"externalIds\":{\"moviexchangeReleaseId\":\"9131253f-ec7c-4f61-b9e3-bbea8ddf1cd3\",\"corporateId\":null},\"hopk\":\"HO00008184\",\"hoCode\":\"A000009276\",\"eventId\":\"0000000001\",\"distributorName\":\"National Theatre\"}],\"castAndCrew\":[{\"id\":\"0000000328\",\"name\":{\"givenName\":\"Stephen\",\"familyName\":\"Daldry\",\"middleName\":null}},{\"id\":\"0000004641\",\"name\":{\"givenName\":\"Paul\",\"familyName\":\"Ritter\",\"middleName\":null}},{\"id\":\"0000017347\",\"name\":{\"givenName\":\"Edward\",\"familyName\":\"Fox\",\"middleName\":null}},{\"id\":\"0000017348\",\"name\":{\"givenName\":\"Daniel\",\"familyName\":\"McCabe\",\"middleName\":null}},{\"id\":\"HO00000137\",\"name\":{\"givenName\":\"Helen\",\"familyName\":\"Mirren\",\"middleName\":null}},{\"id\":\"HO00000447\",\"name\":{\"givenName\":\"National Theatre\",\"familyName\":\"Live\",\"middleName\":null}}],\"genres\":[{\"id\":\"0000000009\",\"name\":{\"text\":\"Drama\",\"translations\":[]},\"description\":null},{\"id\":\"0000000039\",\"name\":{\"text\":\"Live Theatre\",\"tra