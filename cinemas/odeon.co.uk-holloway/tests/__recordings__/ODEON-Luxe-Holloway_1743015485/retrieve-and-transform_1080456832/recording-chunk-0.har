24:00+00:00\",\"filmStartsAt\":\"2026-01-30T21:55:00+00:00\",\"filmEndsAt\":\"2026-01-30T23:24:00+00:00\",\"inSeatItemDelivery\":null},\"isSoldOut\":false,\"seatLayoutId\":\"125-6-53\",\"filmId\":\"HO00008273\",\"siteId\":\"125\",\"screenId\":\"125-6\",\"areaCategories\":[{\"areaCategoryId\":\"125-0000000003\",\"isAllocatedSeating\":true},{\"areaCategoryId\":\"125-0000000013\",\"isAllocatedSeating\":true}],\"attributeIds\":[\"0000000006\",\"0000000143\",\"0000000030\"],\"isAllocatedSeating\":true,\"requires3dGlasses\":false,\"eventId\":null,\"restrictions\":[],\"filmAdvanceBookingRuleId\":null}],\"relatedData\":{\"sites\":[{\"id\":\"125\",\"name\":{\"text\":\"Holloway\",\"translations\":[]},\"location\":{\"latitude\":51.5586,\"longitude\":-0.1214},\"contactDetails\":{\"phoneNumbers\":[],\"email\":\"\",\"address\":{\"line1\":\"419-427 Holloway Road\",\"line2\":\"Holloway\",\"city\":\"N7 6LJ\"}},\"ianaTimeZoneName\":\"Europe/London\"}],\"films\":[{\"id\":\"HO00007316\",\"title\":{\"text\":\"Zootropolis 2\",\"translations\":[]},\"synopsis\":{\"text\":\"Brave rabbit cop Judy Hopps and her friend, the fox Nick Wilde, team up again to crack a new case, the most perilous and intricate of their careers.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"Brave rabbit cop Judy Hopps and her friend, the fox Nick Wilde, team up again to crack a new case, the most perilous and intricate of their careers.\",\"translations\":[]},\"censorRatingId\":\"0000000009\",\"censorRatingNote\":{\"text\":\"mild threat, violence\",\"translations\":[]},\"releaseDate\":\"2025-11-28\",\"runtimeInMinutes\":108,\"trailerUrl\":null,\"displayPriority\":6,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000003440\",\"roles\":[\"Director\"]},{\"castAndCrewMemberId\":\"0000003441\",\"roles\":[\"Director\",\"Producer\"]},{\"castAndCrewMemberId\":\"0000003443\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"0000006395\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000008394\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015583\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"0000015584\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00000082\",\"roles\":[\"Producer\"]},{\"castAndCrewMemberId\":\"HO00000488\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":\"HO00002397\",\"roles\":[\"Actor\"]}],\"genreIds\":[\"0000000004\",\"0000000006\",\"0000000010\"],\"externalIds\":{\"moviexchangeReleaseId\":\"87004e42-c4bd-4468-8b83-00f122c59dd9\",\"corporateId\":null},\"hopk\":\"HO00007316\",\"hoCode\":\"A000008328\",\"eventId\":null,\"distributorName\":\"WALT DISNEY STUDIOS INTERNTL\"},{\"id\":\"HO00008012\",\"title\":{\"text\":\"The Housemaid\",\"translations\":[]},\"synopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. From director Paul Feig, the film plunges audiences into a twisted world where perfection is an illusion, and nothing is as it seems. Trying to escape her past, Millie (Sweeney) accepts a job as a live-in housemaid for the wealthy Nina (Seyfried) and Andrew Winchester (Brandon Sklenar). But what begins as a dream job quickly unravels into something far more dangerous — a sexy, seductive game of secrets, scandal, and power. Behind the Winchesters’ closed doors lies a world of shocking twists that will leave you guessing until the very end.\",\"translations\":[]},\"shortSynopsis\":{\"text\":\"THE HOUSEMAID is a wildly entertaining thriller starring Sydney Sweeney and Amanda Seyfried, based on the best-selling book. \",\"translations\":[]},\"censorRatingId\":\"0000000002\",\"censorRatingNote\":{\"text\":\"strong violence, injury detail, sex, sexual violence, very strong language\",\"translations\":[]},\"releaseDate\":\"2025-12-22\",\"runtimeInMinutes\":131,\"trailerUrl\":\"https://www.youtube.com/watch?v=kdDdlY2VPxw\",\"displayPriority\":2,\"castAndCrew\":[{\"castAndCrewMemberId\":\"0000009161\",\"roles\":[\"Actor\"]},{\"castAndCrewMemberId\":