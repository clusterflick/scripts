MOVIEDB_API_KEY="moviedb-api-key-here"
GEMINI_API_KEY="gemini-api-key-here"
OPENAI_API_KEY="openai-api-key-here"
TYPESAFE_API_KEY="typesafe-api-key-here"
CINEBUR_EMAIL="cinebur-account-email-here"
CINEBUR_PASSWORD="cinebur-account-password-here"

# LLM provider toggle: "gemini" (default) or "openai"
LLM_PROVIDER="gemini"

# Provider for calls asking for the capable model: "openai" (default) or "gemini"
CAPABLE_LLM_PROVIDER="openai"

# Categoriser toggle: "llm" (default) or "jev"
CATEGORISER="llm"

# TheMovieDB match reviewer toggle: "llm" (default) or "jev"
MATCHER="llm"
