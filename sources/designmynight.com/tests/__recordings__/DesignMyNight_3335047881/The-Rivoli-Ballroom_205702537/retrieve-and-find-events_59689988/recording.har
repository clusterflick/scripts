:-0.036113800000066476}},\"imported_at\":\"2021-09-17 13:32:26\",\"is_selected\":false,\"is_top_level\":false,\"id\":\"59ef8744e445800e4a5c2aa6\"},{\"type\":\"area\",\"slug\":\"clapham\",\"designmynight_id\":\"512b201ad5d190d2978c9fc0\",\"updated_at\":\"2025-08-05 08:58:51\",\"created_at\":\"2012-10-17 10:43:16\",\"parent\":{\"type\":\"area\",\"slug\":\"south-london\",\"designmynight_id\":\"512b2019d5d190d2978c9f3e\",\"updated_at\":\"2023-04-17 14:28:31\",\"created_at\":\"2012-10-17 10:43:16\",\"parent\":\"512b1ebad5d190d2978c277e\",\"status\":\"public\",\"title\":\"South London\",\"region_id\":\"59ef1720e445807f4c267a14\",\"location_bounds\":{\"top_right\":{\"lat\":51.48280030000019,\"lon\":-0.017640700000010723},\"bottom_left\":{\"lat\":51.36207870000048,\"lon\":-0.22535970000005734}},\"imported_at\":\"2023-04-17 14:28:31\",\"venue_finding\":true,\"is_top_level\":true,\"id\":\"59ef874ce445800e4a5c2b8d\"},\"status\":\"public\",\"title\":\"Clapham\",\"region_id\":\"59ef1720e445807f4c267a14\",\"location_bounds\":{\"top_right\":{\"lat\":51.4692612,\"lon\":-0.12256260000003749},\"bottom_left\":{\"lat\":51.45135770000001,\"lon\":-0.18457739999999379}},\"imported_at\":\"2025-08-05 08:58:52\",\"content\":\"<p>Clapham is one of London's most well-known areas, and between\\nthe 89 hectares of green space on Clapham Common, the quaint food\\nstalls on Venn Street Market come the weekend and its thriving pub\\nscene, it maintains to be somewhere that the young and fun of\\nLondon like to head. Thanks to its train network, and being a 5\\nminute walk to Brixton, Clapham's remains firm in its\\nappeal.&nbsp;<\\/p>\\n\",\"venue_finding\":false,\"is_selected\":false,\"is_top_level\":false,\"id\":\"59ef874be445800e4a5c2b81\"},{\"type\":\"area\",\"designmynight_id\":\"5a699e512ffad233213ae690\",\"imported_at\":\"2025-10-13 16:29:02\",\"created_at\":\"2018-01-25 09:07:29\",\"updated_at\":\"2025-10-13 16:29:00\",\"title\":\"Croydon\",\"parent\":{\"type\":\"area\",\"slug\":\"south-lon