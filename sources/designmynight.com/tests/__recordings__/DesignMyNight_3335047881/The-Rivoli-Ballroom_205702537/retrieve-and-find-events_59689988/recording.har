.com\\/uploads\\/2025\\/10\\/IMG_82231-620x346-optimised.jpeg\",\"width\":620,\"height\":346},\"width_414\":{\"path\":\"\\/\\/static.designmynight.com\\/uploads\\/2025\\/10\\/IMG_82231-414x231-optimised.jpeg\",\"width\":414,\"height\":231},\"small\":{\"path\":\"\\/\\/static.designmynight.com\\/uploads\\/2025\\/10\\/IMG_82231-300x167-optimised.jpeg\",\"width\":300,\"height\":167},\"width_192\":{\"path\":\"\\/\\/static.designmynight.com\\/uploads\\/2025\\/10\\/IMG_82231-192x107-optimised.jpeg\",\"width\":192,\"height\":107},\"thumbnail\":{\"path\":\"\\/\\/static.designmynight.com\\/uploads\\/2025\\/10\\/IMG_82231-140x78-optimised.jpeg\",\"width\":140,\"height\":78}},\"id\":{\"$oid\":\"69016441767ae0bf265b557e\"}}],\"location\":{\"lat\":51.4804121,\"lon\":-0.1450292},\"rating\":0,\"total_ratings\":0,\"date_string\":\"Thursday 30th October 2025 and 2 other dates\",\"occurrence\":{\"date\":\"30 October 2025\",\"is_cancelled\":false,\"iso_date\":\"2025-10-30T00:00:00+00:00\",\"on_sale\":true},\"ticket_price_range\":\"Tickets from \\u00a384.80 - \\u00a3190.80\",\"venue\":{\"title\":\"Joia\"}},{\"id\":\"68c7c26f7c6356793f0a68f0\",\"object_id\":\"68c7c26f7c6356793f0a68ef\",\"designmynight_id\":\"68c7c26f8716e97b2b7d8032\",\"path\":\"https:\\/\\/www.designmynight.com\\/london\\/pubs\\/leyton\\/william-the-fourth-london\\/cine-17-presents-lost-boys\",\"title\":\"Cine-17 presents Lost Boys\",\"type\":\"event\",\"status\":\"public\",\"score\":0,\"excerpt\":\"\\nCINE-17 Presents: The Lost Boys \\n\\ud83d\\udcfd\\ufe0f Thursday, October 30th\\nJoin us for&hellip;\",\"covid_safe_count\":0,\"review_count\":0,\"search_boost\":null,\"recommended\":false,\"features\":{\"type_of_event\":{\"type\":\"type_of_event\",\"icon\":\"fa-ticket\",\"title\":\"Type of event\",\"label\":\"Film Screenings\",\"id\":\"59ef1737e445807f4c268548\",\"labels_string\":\"Type of event: Film Screenings\"},\"area\":{\"type\":\"area\",\"icon\":\"fa-globe\",\"title\":\"Area\",\"label\":\"Leyton\",\"id\":\"59ef8746e445800e4a5c2aca\",\"labels_string\":\"Area: Leyton, Walthamstow\"}},\"food_and_drink\":{\"drink\":{\"drinks\":[]},\"food\":{\"enabled\":false,\"cuisine\":[{\"label\":\"Pizza\",\"designmynight_id\":\"62e7a20142edd351e11a0bf3\",\"_id\":\"62e7a2019dab24285c1024d3\"},{\"label\":\"Italian\",\"designmynight_id\":\"56d45420abf80cae963c024b\",\"_id\":\"59ef1940e44580014c212a51\"}],\"word_from_chef\":\"Born in Leytonstone, Short Road Pizza returns to its roots. Led by second-generation Italian chef Ugo, the kitchen serves crispy, bold pizzas blending Romana thin crust technique with American soul \\u2014 plus a whole host of Italian small plates, all perfectly in tune with the stellar drinks list and high-energy atmosphere.\"},\"menus\":[{\"_id\":\"68c2795c04673268a750a786\",\"filename\":\"\\/uploads\\/2025\\/09\\/SRP-menu-LOW-2.pdf\",\"mime_type\":\"application\\/pdf\",\"url\":\"\\/\\/static.designmynight.com\\/uploads\\/2025\\/09\\/SRP-menu-LOW-2.pdf\",\"title\":\"Main Menu\",\"uploaded_at\":{\"$date\":{\"$numberLong\":\"1757575516000\"}}}]},\"photos\":[{\"caption\":\"\",\"sizes\":{\"original\":{\"path\":\"\\/\\/static.designmynight.com\\/uploads\\/2025\\/09\\/cover-optimised.png\",\"width\":250,\"height\":200},\"medium\":{\"path\":\"\\/\\/static.designmynight.com\\/uploads\\/2025\\/09\\/cover-620x319-optimised.png\",\"width\":620,\"height\":319},\"width_414\":{\"path\":\"\\/\\/static.designmynight.com\\/uploads\\/2025\\/09\\/cover-414x213-optimised.png\",\"width\":414,\"height\":213},\"small\":{\"path\":\"\\/\\/static.designmynight.com\\/uploads\\/2025\\/09\\/cover-300x154-optimised.png\",\"width\":300,\"height\":154},\"width_192\":{\"path\":\"\\/\\/static.designmynight.com\\/uploads\\/2025\\/09\\/cover-192x98-optimised.png\",\"width\":192,\"height\":98},\"thumbnail\":{\"path\":\"\\/\\/static.designmynight.com\\/uploads\\/2025\\/09\\/cover-140x72-optimised.png\",\"width\":140,\"height\":72}},\"id\":{\"$oid\":\"69026131767ae07750476905\"}},{\"caption\":\"\",\"sizes\":{\"