ard-location\\\",\\\"children\\\":[[\\\"$\\\",\\\"img\\\",null,{\\\"src\\\":\\\"/images/location_icon.png\\\",\\\"alt\\\":\\\"\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"London\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"club-tile-description\\\",\\\"children\\\":\\\"The first rule of Film Club: You talk about Film Club.\\\\u000b\\\\n\\\\nThe second rule of Film Club: You must talk about Film Club.\\\\u000b\\\\n\\\\nBecause honestly, who can resist making friends while chatting about great films?\\\\n\\\\nWhat we’re about:\\\\u000b\\\\n\\\\n📎 A third space for the women+ cinephile community\\\\n💫 Monthly gatherings every second Saturday to discuss our Pick of the Month, chosen by members (book-club style)\\\\n🎥 Cinema Clubs with private screenings and post-film socials\\\\n🍿 Casual, member-led hangouts to catch the latest releases together\\\\n☕ A warm, welcoming space where every conversation feels like catching up with friends over coffee\\\\n\\\\nWhether you’re a lifelong film lover or just starting your cinematic journey, you’ve just found your place ♡⸜(˶˃ ᵕ ˂˶)⸝♡\\\\n\\\\nFind out more and join us on Instagram ⤷ @thefilmclubldn\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"className\\\":\\\"event-card-link\\\",\\\"href\\\":\\\"/club/the-film-club\\\",\\\"children\\\":\\\"Learn More\\\"}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"19:[\\\"$\\\",\\\"article\\\",\\\"the-siren-circle\\\",{\\\"className\\\":\\\"club-tile-card club-tile-card-similar\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"club-tile-media-wrap\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L15\\\",null,{\\\"className\\\":\\\"club-tile-media\\\",\\\"src\\\":\\\"https://res.cloudinary.com/dienahliq/image/upload/dpr_auto,c_scale,w_auto/production/pfwh1tt4irx7whmfanye.jpg\\\",\\\"wordmarkSrc\\\":\\\"/images/brand/logo.svg\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"children\\\":\\\"The Siren Circle\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"club-tile-copy\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"club-tile-tag-pills\\\",\\\"aria-label\\\":\\\"The Siren Circle interests\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",\\\"Business\\\",{\\\"href\\\":\\\"/discover/interest/business/1\\\",\\\"children\\\":\\\"Business\\\"}],[\\\"$\\\",\\\"a\\\",\\\"Entertainment\\\",{\\\"href\\\":\\\"/discover/interest/entertainment/1\\\",\\\"children\\\":\\\"Entertainment\\\"}],[\\\"$\\\",\\\"a\\\",\\\"Gender Specific\\\",{\\\"href\\\":\\\"/discover/interest/gender%20specific/1\\\",\\\"children\\\":\\\"Gender Specific\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"card-location\\\",\\\"children\\\":[[\\\"$\\\",\\\"img\\\",null,{\\\"src\\\":\\\"/images/location_icon.png\\\",\\\"alt\\\":\\\"\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"London\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"club-tile-description\\\",\\\"children\\\":\\\"The Siren Circle is a community for women seeking deeper connection, reflection and growth.  \\\\n\\\\nWe host a curated programme of events including sharing circles, supper clubs, co-working sessions and socials - all designed to create space for real conversation.\\\\n\\\\nInspired by the ancient myth of sirens, our mission is to support women to break away from outdated narratives of who they are and should be, and live in ways that feel more true to them.\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"className\\\":\\\"event-card-link\\\",\\\"href\\\":\\\"/club/the-siren-circle\\\",\\\"children\\\":\\\"Learn More\\\"}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1b:T79b,\"])</script><script>self.__next_f.push([1,\"\\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 35 35\\\" shape-rendering=\\\"crispEdges\\\"\\u003e\\u003cpath fill=\\\"#ffffff\\\" d=\\\"M0 0h35v35H0z\\\"/\\u003e\\u003cpath stroke=\\\"#000000\\\" d=\\\"M1 1.5h7m2 0h1m6 0h4m3 0h1m2 0h7M1