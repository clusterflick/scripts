sync=\"\"></script><script src=\"/_next/static/chunks/0d3tkj33oycf2.js?dpl=dpl_97KEFrZ4bAa7t8mYvsRNTCDib4Tj\" async=\"\"></script><script src=\"/_next/static/chunks/11ps-s5v6as0s.js?dpl=dpl_97KEFrZ4bAa7t8mYvsRNTCDib4Tj\" async=\"\"></script><link rel=\"preload\" href=\"/images/brand/footer-mark.svg\" as=\"image\"/><link rel=\"preload\" as=\"image\" href=\"https://res.cloudinary.com/dienahliq/image/upload/dpr_auto,c_scale,w_auto/production/iw6fj2qtctgl5soqsuvt.jpg\"/><link rel=\"preload\" as=\"image\" href=\"https://res.cloudinary.com/dienahliq/image/upload/dpr_auto,c_scale,w_auto/production/pfwh1tt4irx7whmfanye.jpg\"/><title>FRAME BY FRAME Club | CLIQ</title><meta name=\"description\" content=\"The social cinema club. We host independent film screenings, industry Q&amp;As, shorts - all with DJs and drinks to follow. And guess what? It’s only £5…\"/><meta name=\"keywords\" content=\"FRAME BY FRAME,CLIQ,CLIQ club,community club,Community,Entertainment,Female,Films,Social\"/><link rel=\"canonical\" href=\"https://thecliq.app/club/frame-by-frame\"/><meta property=\"og:title\" content=\"FRAME BY FRAME Club | CLIQ\"/><meta property=\"og:description\" content=\"The social cinema club. We host independent film screenings, industry Q&amp;As, shorts - all with DJs and drinks to follow. And guess what? It’s only £5…\"/><meta property=\"og:url\" content=\"https://thecliq.app/club/frame-by-frame\"/><meta property=\"og:site_name\" content=\"Cliq\"/><meta property=\"og:image\" content=\"https://res.cloudinary.com/dienahliq/image/upload/dpr_auto,c_scale,w_auto/production/acwe5s0luikmuf7auw37.jpg\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"FRAME BY FRAME\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"FRAME BY FRAME Club | CLIQ\"/><meta name=\"twitter:description\" content=\"The social cinema club. We host independent film screenings, industry Q&amp;As, shorts - all with DJs and drinks to follow. And guess what? It’s only £5…\"/><meta name=\"twitter:image\" content=\"https://res.cloudinary.com/dienahliq/image/upload/dpr_auto,c_scale,w_auto/production/acwe5s0luikmuf7auw37.jpg\"/><link rel=\"icon\" href=\"https://cdn.prod.website-files.com/660f9fdac217f20cb081a218/6989994874d427fd46be2402_Cliq-logo%20(1)%20(1).jpg\"/><link rel=\"apple-touch-icon\" href=\"https://cdn.prod.website-files.com/660f9fdac217f20cb081a218/6989994b969c509c69a66eff_Cliq-logo%20(1).jpg\"/><script src=\"/_next/static/chunks/03~yq9q893hmn.js?dpl=dpl_97KEFrZ4bAa7t8mYvsRNTCDib4Tj\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><main class=\"club-page\"><section class=\"announcement-bar\"><p><a href=\"/#download\">download the app</a><span> | </span><a href=\"/community#join\">start your community</a></p></section><header class=\"menu-bar\"><a href=\"/\" aria-label=\"Go to CLIQ home\"><img class=\"brand-logo\" src=\"/images/brand/logo.svg\" alt=\"CLIQ\"/></a><nav class=\"menu-links\" aria-label=\"Primary\"><a class=\"figma-btn figma-btn-text\" href=\"/about\"><span>ABOUT CLIQ</span></a><a class=\"figma-btn figma-btn-text\" href=\"/discover\"><span>Discover</span></a><a class=\"figma-btn figma-btn-text\" href=\"/community\"><span>Community</span></a><a class=\"figma-btn figma-btn-text\" href=\"/brands\"><span>Brands</span></a><a class=\"figma-btn figma-btn-text\" href=\"/contact\"><span>Contact</span></a><a class=\"figma-btn figma-btn-purple\" href=\"https://events.thecliq.app/\"><span>Club Login</span></a></nav><details class=\"mobile-menu\"><summary aria-label=\"Open navigation menu\"><span class=\"mobile-menu-label\">MENU</span><span class=\"mobile-menu-close\" aria-hidden=\"true\"><span></span></span></summary><nav class=\"mobile-menu-panel\" aria-label=\"Mobile primary\"><a href=\"/about\">ABOUT CLIQ</a><a href=\"/discover\">Discover</a><a href=\"/community\">Community</a><a href=\"/brands\">Brands</a><a href=\"/contact\">Contact</a><a href=\"https://events.thecliq.app/\">Club Login</a></nav></details></header><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"FRAME BY FRAME\",\"description\":\"The social cinema club. We host independent film screenings, industry Q&As, shorts - all with DJs and drinks to follow. And guess what? It’s only £5…\",\"url\":\"https://thecliq.app/club/frame-by-frame\",\"image\":\"https://res.cloudinary.com/dienahliq/image/upload/dpr_auto,c_scale,w_auto/production/acwe5s0luikmuf7auw37.jpg\",\"keywords\":\"Community, Entertainment, Female, Films, Social\",\"event\":[]}</script><section class=\"club-hero\"><div class=\"club-logo-panel\"><img class=\"club-logo-image\" src=\"https://res.cloudinary.com/dienahliq/image/upload/dpr_auto,c_scale,w_auto/production/acwe5s0luikmuf7auw37.jpg\" alt=\"FRAME BY FRAME club image\"/></div><div class=\"club-details-panel\"><div class=\"club-details-top\"><div class=\"club-details-brand\"><img class=\"club-details-logo\" src=\"/images/brand/logo.svg\" alt=\"CLIQ\"/><div class=\"detail-tag-pills\" aria-label=\"Tags\"><a href=\"/discover/interest/entertainment/1\">Entertainment</a><a href=\"/discover/interest/gender%20specific/1\">Gender Specific</a><a href=\"/discover/interest/social/1\">Social</a></div></div><a class=\"figma-btn figma-btn-purple\" href=\"cliq://clubs/frame-by-frame?entry_point=www&amp;source=cliq_website\"><span>OPEN IN APP</span></a></div><div class=\"club-details-copy\"><h1>FRAME BY FRAME</h1><p>The social cinema club. \n\nWe host independent film screenings, industry Q&amp;As,\nshorts - all with DJs and drinks to follow. And guess what? It’s only £5…</p></div><div class=\"club-qr-row detail-qr-box\"><span class=\"detail-qr-heading\">SCAN TO JOIN</span><div class=\"club-qr-code\" role=\"img\" aria-label=\"Scan to join FRAME BY FRAME on CLIQ\"><svg xmlns=\"http://www.w