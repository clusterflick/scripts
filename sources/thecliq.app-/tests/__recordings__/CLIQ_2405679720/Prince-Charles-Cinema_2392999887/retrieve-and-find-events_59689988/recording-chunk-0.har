ipt type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Film Night\",\"description\":\"Network with creatives and make friends watching and discussing films, new and old! 🎬🎞️🍿\",\"url\":\"https://thecliq.app/club/film-night\",\"image\":\"https://res.cloudinary.com/dienahliq/image/upload/dpr_auto,c_scale,w_auto/production/rjj3yimetc6emnkglshi.png\",\"keywords\":\"Arts, Digital Arts, Entertainment, Films, Meet ups, Networking, Pubs, Social, Socials, Visual Arts\",\"event\":[]}</script><section class=\"club-hero\"><div class=\"club-logo-panel\"><img class=\"club-logo-image\" src=\"https://res.cloudinary.com/dienahliq/image/upload/dpr_auto,c_scale,w_auto/production/rjj3yimetc6emnkglshi.png\" alt=\"Film Night club image\"/></div><div class=\"club-details-panel\"><div class=\"club-details-top\"><div class=\"club-details-brand\"><img class=\"club-details-logo\" src=\"/images/brand/logo.svg\" alt=\"CLIQ\"/><div class=\"detail-tag-pills\" aria-label=\"Tags\"><a href=\"/discover/interest/arts/1\">Arts</a><a href=\"/discover/interest/entertainment/1\">Entertainment</a><a href=\"/discover/interest/social/1\">Social</a></div></div><a class=\"figma-btn figma-btn-purple\" href=\"cliq://clubs/film-night?entry_point=www&amp;source=cliq_website\"><span>OPEN IN APP</span></a></div><div class=\"club-details-copy\"><h1>Film Night</h1><p>Network with creatives and make friends watching and discussing films, new and old! 🎬🎞️🍿</p></div><div class=\"club-qr-row detail-qr-box\"><span class=\"detail-qr-heading\">SCAN TO JOIN</span><div class=\"club-qr-code\" role=\"img\" aria-label=\"Scan to join Film Night on CLIQ\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 35 35\" shape-rendering=\"crispEdges\"><path fill=\"#ffffff\" d=\"M0 0h35v35H0z\"/><path stroke=\"#000000\" d=\"M1 1.5h7m3 0h1m2 0h4m1 0h4m1 0h1m2 0h7M1 2.5h1m5 0h1m6 0h4m3 0h3m3 0h1m5 0h1M1 3.5h1m1 0h3m1 0h1m1 0h1m1 0h2m1 0h1m1 0h1m3 0h5m2 0h1m1 0h3m1 0h1M1 4.5h1m1 0h3m1 0