 \\\"08828a21-39ac-41d2-ba4a-8547a6e4d1c6\\\") { event_id description } event20: eventDetail(event_id: \\\"3e333271-06bb-4ef4-9434-d8b8ad36ec54\\\") { event_id description } event21: eventDetail(event_id: \\\"4ab07b96-d857-40d5-9819-b04b698b895e\\\") { event_id description } event22: eventDetail(event_id: \\\"800224a9-d6a2-4606-9e2d-534f0d8f1347\\\") { event_id description } event23: eventDetail(event_id: \\\"7aebba94-d13f-4d47-9838-b6ab8b21403c\\\") { event_id description } event24: eventDetail(event_id: \\\"de725d91-40d3-406b-b15c-18583a24533f\\\") { event_id description } event25: eventDetail(event_id: \\\"8efb507c-6538-47ca-826f-65654006b5ab\\\") { event_id description } event26: eventDetail(event_id: \\\"2d211228-3ed3-4f65-ab5b-445e84de8ba7\\\") { event_id description } event27: eventDetail(event_id: \\\"96b7fa7b-15a9-41e3-89a7-79561feae60a\\\") { event_id description } event28: eventDetail(event_id: \\\"e7de41a0-0fb6-46fe-a231-72d76fb8d8c7\\\") { event_id description } event29: eventDetail(event_id: \\\"a256f67f-e726-41b7-b5c3-9a9dee546802\\\") { event_id description } event30: eventDetail(event_id: \\\"347d55ec-05ff-4d92-95b5-089628da5a6a\\\") { event_id description } }\"}"
