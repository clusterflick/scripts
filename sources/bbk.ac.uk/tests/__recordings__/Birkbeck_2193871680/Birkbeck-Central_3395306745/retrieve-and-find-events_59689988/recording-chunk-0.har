k.ac.uk/assets/img/disability-confident-employer.1ceb3f98c0.png\"\n                            class=\"lazyload\" />\n                    </li>\n                    <li class=\"menu-text\">\n                        <img alt=\"Stonewall Diversity Champion\" src=\"data:image/gif;base64,iVBORw0KGgoAAAANSUhEUgAAADoAAAATCAQAAABrEdZdAAAAIUlEQVR42mNkGADAOGrpqKWjlo5aOmrpqKWjlo5aSjQAAF+FABTBWoreAAAAAElFTkSuQmCC\"\n                            width=\"174\" height=\"141\" data-src=\"https://dist.bbk.ac.uk/assets/img/stonewall-diversity-champion.c1a7025b5c.png\"\n                            class=\"lazyload\" />\n                    </li>\n                    <li class=\"menu-text\">\n                        <img alt=\"HE Excellence in Research\" src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAEQAAAAuCAQAAAA7dXcFAAAAM0lEQVR42u3OAQ0AAAwCoNu/9Gu4CQnIlYiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIyEbkAVs9AC8ITfk4AAAAAElFTkSuQmCC\"\n                            width=\"342\" height=\"232\" data-src=\"https://dist.bbk.ac.uk/assets/img/hr-logo.8713975bb5.svg\" class=\"lazyload\" />\n                    </li>\n                    <li class=\"menu-text\">\n                        <img alt=\"Fundraising Regulator registered\"\n                            src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAALQAAAA6CAQAAACzfrsRAAAAYUlEQVR42u3QAQkAAAwDoK9/6bcYDDSCOSqiQLRoRIsWjWjRiBYtGtGiES1aNKJFI1q0aESLRrRo0YgWjWjRohEtGtGiRSNaNKJFi0a0aESLFo1o0YgWLRrRohEtWjSi9z2/GAA71lshpgAAAABJRU5ErkJggg==\"\n                            width=\"360\" height=\"116\"\n                            data-src=\"https://dist.bbk.ac.uk/assets/img/fr-registered-badge.b921a4b6f9.svg\"\n                            class=\"lazyload\" />\n                      </li>\n                </ul>\n            </div>\n        </div>\n    </section>\n\n\n    <section class=\"site-footer__info\">\n        <h2 class=\"show-for-sr\">Additional information</h2>\n        <div class=\"row\">\n            <div class=\"column\">\n                <u