eload\" as=\"font\" href=\"https://dist.bbk.ac.uk/assets/font/FoundersGroteskCondensedWeb-Bold.551e54cb97.woff2\" crossorigin>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/lazysizes/3.0.0/lazysizes.min.js\" async></script>\n\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/lazysizes/3.0.0/plugins/parent-fit/ls.parent-fit.min.js\" async></script>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/lazysizes/3.0.0/plugins/object-fit/ls.object-fit.min.js\" async></script>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/picturefill/3.0.3/picturefill.min.js\" async integrity=\"sha256-iT+n/otuaeKCgxnASny7bxKeqCDbaV1M7VdX1ZRQtqg=\" crossorigin=\"anonymous\"></script>\n</head>\n\n\t<body class=\"no-js \">\n\t\t<!-- noindex -->\n\t\t\n<a href=\"#main-content\" class=\"show-on-focus button button--white\">Skip to main content</a>\n\t\t<header class=\"site-header\" data-sticky-container>\n    <div class=\"sticky\" data-sticky data-options=\"marginTop: 0; stickyOn: small;\" style=\"width:100%\"\n        data-top-anchor=\"1\">\n        <div class=\"title-bar\">\n            <div class=\"row\">\n\n                <div class=\"title-bar-left site-header__logo\">\n                    <a class=\"site-header__logo-link\" href=\"https://www.bbk.ac.uk/\" title=\"Birkbeck Homepage\">\n                        <svg class=\"birkbeck-logo site-header__logo-image\">\n                            <use xlink:href=\"#birkbeck-logo\" />\n                        </svg>\n                        <span class=\"show-for-sr\">\n                            Birkbeck Home\n                        </span>\n                    </a>\n                </div>\n\n                <div class=\"title-bar-right site-header__links\">\n                    <ul class=\"menu js-addReciteMe\">\n\n                        <li><a href=\"https://www.bbk.ac.uk/mbphome\">Students</a></li>\n                        <li><a href=\"https://www.bbk.ac.uk/research\">Research</a></li>\n                        <li><a href=\"https://www.bbk.ac.uk/businesses\">Businesses</a></li>\n                        <li><a href=\"https://www.bbk.ac.uk/alumni\">Alumni</a></li>\n\n                    </ul>\n                </div>\n\n            </div>\n        </div>\n\n        <div class=\"site-controls\">\n            <div class=\"top-bar\">\n\n                <a class=\"logo--owl\" href=\"https://www.bbk.ac.uk/\" aria-hidden=\"true\" tabindex=\"-1\">\n                    <svg class=\"icon icon--owl\">\n                        <use xlink:href=\"#birkbeck-owl\" />\n                    </svg>\n                    <span class=\"show-for-sr\">\n                        Birkbeck Home\n                    </span>\n                </a>\n\n\n                <button id=\"site-search-toggle\" class=\"button button--search button--ghost\" data-toggler=\"is-active\"\n                    data-toggle=\"site-search site-search-toggle\">\n                    <svg class=\"icon icon--search\">\n                        <use xlink:href=\"#search\" />\n                    </svg>\n                    <span class=\"button__text\">Search</span>\n                </button>\n\n\n                <button class=\"button button--menu button--ghost icon--animated__wrapper\" data-toggle=\"off-canvas-nav\">\n                    <span class=\"icon icon--menu\"></span>\n                    <span class=\"button__text\">Menu</span>\n                </button>\n\n            </div>\n        </div>\n\n        <div id=\"site-search\" class=\"site-search\" data-toggler=\"show\">\n            <form action=\"//search.bbk.ac.uk/search/\">\n                <label for=\"site-q\" class=\"show-for-sr\">Search keywords</label>\n                <input type=\"text\"\n                    class=\"input--site-search js-autocomplete\"\n                    placeholder=\"Search\"\n                    data-listbox-label=\"Keyword suggestions\"\n                    id=\"site-q\"\n                    name=\"q\"\n                    autocomplete=\"off\"\n                    >\n                <button class=\"button\" title=\"search\">\n                    <span class=\"show-for-sr\">Search</span>\n                </button>\n            </form>\n        </div>\n\n    </div>\n</header>\n\t\t<!-- endnoindex -->\n\n\t\t<div class=\"off-canvas-wrapper\">\n\n\t\t\t<!-- noindex -->\n\t\t\t<div class=\"off-canvas-absolute position-right\" id=\"off-canvas-nav\" data-off-canvas data-options=\"transition: overlap;\">\n\n    <ul class=\"vertical menu menu--site-nav js-addReciteMe\" data-responsive-menu=\"drilldown medium-dropdown\">\n        <li class=\"is-active\">\n            <a href=\"https://www.bbk.ac.uk/\">Home</a>\n        </li>\n        <li>\n            <a href=\"https://www.bbk.ac.uk/courses\">Find a course</a>\n        </li>\n        <li class=\"opens-left\">\n            <a href=\"https://www.bbk.ac.uk/prospective\">\n                <svg class=\"icon icon--angle-right\">\n                    <use xlink:href=\"#angle-right\"></use>\n                </svg>\n                Study\n            </a>\n\n            <ul class=\"nested vertical menu menu--main-nav__nested\">\n                <li>\n                    <a href=\"https://www.bbk.ac.uk/prospective\">Study here</a>\n                </li>\n                <li>\n                    <a href=\"https://www.bbk.ac.uk/prospective/undergraduate\">Undergraduate study</a>\n                </li>\n                <li>\n                    <a href=\"https://www.bbk.ac.uk/prospective/postgraduate\">Postgraduate study</a>\n                </li>\n                <li>\n                    <a href=\"https://www.bbk.ac.uk/prospective/research\">MPhil/PhD research</a>\n                </li>\n                <li>\n                    <a href=\"https://www.bbk.ac.uk/prospective/short-courses\">Short courses</a>\n                </li>\n                <li>\n                    <a href=\"https://www.bbk.ac.uk/student-services/admissions/entry-requirements\">Entry requirements</a>\n                </li>\n                <li>\n                    <a href=\"https://www.bbk.ac.uk/student-services/financial-support\">Financial support</a>\n                </li>\n                <li>\n                    <a href=\"https://www.bbk.ac.uk/student-services/admissions\">How to apply</a>\n                </li>\n                <li>\n                    <a href=\"https://www.bbk.ac.uk/prospective/open-days\">Come and meet us</a>\n                </li>\n                <li>\n                    <a href=\"https://www.bbk.ac.uk/prospective/evening-study\">Evening study explained</a>\n                </li>\n            </ul>\n        </li>\n        <li>\n            <a href=\"https://www.bbk.ac.uk/international\">International Students</a>\n        </li>\n        <li>\n            <a href=\"https://www.bbk.ac.uk/student-services\">Student Services</a>\n        </li>\n        <li>\n            <a href=\"https://www.bbk.ac.uk/library\">Library</a>\n        </li>\n        <li class=\"opens-left\">\n            <a href=\"https://www.bbk.ac.uk/student-life\">\n                <svg class=\"icon icon--angle-right\">\n                    <use xlink:href=\"#angle-right\"></use>\n                </svg>\n                Life at Birkbeck\n            </a>\n\n            <ul class=\"nested vertical menu menu--main-nav__nested\">\n                <li>\n                    <a href=\"https://www.bbk.ac.uk/student-life\">Student life at Birkbeck</a>\n                </li>\n                <li>\n                    <a href=\"https://www.bbk.ac.uk/prospective/birkbeck-experience\">The Birkbeck Experience</a>\n                </li>\n                <li>\n                    <a href=\"https://www.bbk.ac.uk/prospective/career-support\">Boost your career</a>\n                </li>\n            </ul>\n        </li>\n        <li class=\"opens-left\">\n            <a href=\"https://www.bbk.ac.uk/about-us\">\n                <svg class=\"icon icon--angle-right\">\n                    <use xlink:href=\"#angle-right\"></use>\n                </svg>\n                About Birkbeck\n            </a>\n\n            <ul class=\"nested vertical menu menu--main-nav__nested\">\n                <li>\n                    <a href=\"https://www.bbk.ac.uk/about-us\">About us</a>\n                </li>\n                <li>\n                    <a href=\"https://www.bbk.ac.uk/maps\">Find us</a>\n                </li>\n                <li>\n                    <a href=\"https://www.bbk.ac.uk/contact-us\">Contact us</a>\n                </li>\n            </ul>\n        </li>\n        <li>\n            <a href=\"https://www.bbk.ac.uk/research\">Research</a>\n        </li>\n        <li>\n            <a href=\"https://www.bbk.ac.uk/faculties-and-schools\">Faculties and Schools</a>\n        </li>\n        <li>\n            <a href=\"https://www.bbk.ac.uk/events\">Events</a>\n        </li>\n        <li>\n            <a href=\"https://www.bbk.ac.uk/news\">News</a>\n        </li>\n    </ul>\n\n</div> <!-- close .off-canvas -->\n\t\t\t<!-- endnoindex -->\n\n\t\t\t<div class=\"off-canvas-content\" data-off-canvas-content>\n\n\t\t\t\t<main id=\"main-content\" class=\"page-main\">\n\t\t\t\t\t\n    \n<nav class=\"breadcrumbs\">\n  <p id=\"breadcrumb-label\" class=\"show-for-sr\">You are here:</p>\n  <ol class=\"menu menu--breadcrumbs row\" aria-labelledby=\"breadcrumb-label\">\n    \n      \n    \n      \n        <li>\n          <a href=\"/\">Birkbeck, University of London</a>\n        </li>\n      \n    \n      \n        <li>\n          <a href=\"/events\">Events</a>\n        </li>\n      \n    \n    <li class=\"menu-text\">Connect & Co-create: Learn from Birkbeck Research Centres</li>\n  </ol>\n</nav>\n\n\n    <div class=\"page-topper\"></div>\n\n    <h1 class=\"page-title\">Connect & Co-create: Learn from Birkbeck Research Centres</h1>\n\n    <div class=\"row column max-medium\">\n      <p>\n        \n          \n            <strong>Starts:</strong>\n            <time datetime=\"2025-11-28T12:00:00.000Z\">\n              28 November 2025, 12:00\n            </time>\n            <br/>\n            <strong>Finishes:</strong>\n            <time datetime=\"2026-04-24T13:00:00.000Z\">\n              24 April 2026, 13:00\n            </time>\n          \n          <br />\n        \n        \n          <strong>Venue:</strong>\n          Online\n          <br />\n        \n      </p>\n\n\n      \n        <p>\n          <a href='http://www.bbk.ac.uk/booking/event/48112'>Book your place</a>\n        </p>\n      \n\n\n      <p>Birkbeck Research centres, in collaboration with Prof <a href=\"https://www.bbk.ac.uk/our-staff/profile/8488377/muthu-de-silva\">Muthu De Silva</a>, cordially invite you to this online seminar series.&nbsp;</p>\r\n<p>&nbsp;</p>\r\n<p>1. <strong>Podcasting for Engagement: Best Practices and Tools</strong> [<strong>28th February</strong> 2025 12:00- 13:00]<br />Presenter: Prof Kasia Tomasiewicz, Centre for Museum Cultures with the Recording-Suite</p>\r\n<p><br />2. <strong>Incorporating Lived Experience in Research: A Collaborative Approach Between Academics and Practitioners</strong> [<strong>28th March</strong> 2025 12:00- 13:00]<br />Presenters: Prof Almuth McDowall and Nancy Doyle, Centre for Neurodiversity Research at Work (C4NRAW)</p>\r\n<p><br />3. <strong>Promoting Interdisciplinary Research that Intersects Technology, Data, and AI</strong> [<strong>2nd May</strong> 2025 12:00- 13:00]<br />Presenters:<br />&bull; Prof Felix Reidl, Birkbeck Institute for Data Science (BIDA)<br />&bull; Prof Rebekah Cupitt, Birkbeck Centre for Interdisciplinary Research in Media and Culture</p>\r\n<p><br />4. <strong>Creating Value through Active Engagement with Alumni and Students</strong> [<strong>30th May</strong> 202512:00- 13:00]<br />Presenter: Prof Helen Lawton Smith, Centre for Innovation Management Research</p>\r\n<p><br />5. <strong>Supporting PhD-led Networks and Collaborative Initiatives</strong> [<strong>27th June</strong> 2025 12:00- 13:00]</p>\r\n<p>Presenters: Prof Suzannah Biernoff and Prof Grace Halden, Centre for Medical and Health Humanities</p>\r\n<p><br />6. <strong>Strategies for External Funding and Summer Schools</strong> [<strong>31st October</strong> 2025 12:00- 13:00]<br />Presenters:<br />&bull; Prof Esther Leslie and Prof Jacqueline Rose, Birkbeck Institute for the Humanities<br />&bull; Prof Patrizia Di Bello, Murray Centre for the History of Art</p>\r\n<p><br />7. <strong>Collaborative Grant Applications: Best Practices</strong> [<strong>28th November</strong> 2025 12:00- 13:00]<br />Presenter: Prof Jessica Reinisch, Centre for the Study of Internationalism</p>\r\n<p><br />8. <strong>Amplifying Research through Collaborative Approaches</strong> [<strong>23rd January</strong> 2026 12:00- 13:00]<br />Presenters:<br />&bull; prof Becky Briant and Pam Yeow, Birkbeck Research Centre for Environment and Sustainability<br />&bull; Prof Luca Andriani, Centre for Political Economy and Institutional Studies (CPEIS)</p>\r\n<p><br />9. <strong>Maximizing Research Impact through External Partnerships</strong> [<strong>27th February</strong> 2026 12:00- 13:00]<br />Presenters: Prof Sean Hamil, Giam Rossi, Prof Richard Tacon, Birkbeck Sport Business Centre</p>\r\n<p><br />10. <strong>Strategies for Maximizing Value from Conferences and Workshops</strong> [<strong>27th March</strong>2026 12:00- 13:00]<br />Presenters:<br />&bull; Prof Yunus Aksoy, Birkbeck Centre for Applied Macroeconomics<br />&bull; Prof Emmanuel Mamatzakis, Accounting and Finance Research Centre</p>\r\n<p><br />11. <strong>Interdisciplinary Collaboration with the Ecosystem</strong> [<strong>24th April</strong> 2026 12:00- 13:00]<br />Presenters: Prof Stewart Motha and Prof Elena Loizidou, Centre for Law and the Humanities<br /><br /></p>\r\n<p>We look forward to your participation in these enriching sessions!</p>\r\n<p>If you have any questions or need further information, please feel free to reach out to&nbsp;Muthu &ndash; m.desilva@bbk.ac.uk</p>\n\n      \n        <p>\n          <strong>Contact name:</strong>\n          \n            <a href=\"mailto:m.desilva@bbk.ac.uk\">\n          \n          \n            Muthu De Silva\n          \n          \n            </a>\n          \n        </p>\n      \n\n\n      \n\n      \n\n      \n\n\n      \n        <p>\n          <strong>Tags:</strong>\n          <ul>\n          \n            <li>\n              <a href=\"/events/?tag=1080\">\n                Accounting and Finance Research Centre\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=767\">\n                Birkbeck Business School\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=600\">\n                Birkbeck Business School: Centre for Professional Development\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=97\">\n                Birkbeck Centre for Applied Macroeconomics\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=43\">\n                Birkbeck Centre for Innovation Management Research\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=45\">\n                Birkbeck Institute for Data Analytics (BIDA)\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=36\">\n                Birkbeck Institute for the Humanities\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=766\">\n                Birkbeck Law School\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=941\">\n                Birkbeck Research Centre for Environment and Sustainability\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=95\">\n                Birkbeck Sport Business Centre\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=64\">\n                Centre for Medical and Health Humanities\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=460\">\n                Centre for Museum Cultures\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=620\">\n                Centre for Neurodiversity at Work\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=68\">\n                Centre for Political Economy and Institutional Studies\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=1020\">\n                Centre for the Study of Internationalism\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=25\">\n                Conferences/workshops\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=26\">\n                Current students\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=440\">\n                Enterprise and entrepreneurship\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=920\">\n                Environment and sustainability\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=762\">\n                Faculty of Business and Law\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/events/?tag=761\">\n                Faculty of Humanities and Social Sciences\n              </a>\n            </li>\n          \n            <li>\n              <a href=\"/e