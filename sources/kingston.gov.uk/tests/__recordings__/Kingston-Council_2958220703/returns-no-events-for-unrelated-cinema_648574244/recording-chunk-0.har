          <div class=\"newsletter-content\">\n            <h2 id=\"dialog-label\" class=\"name-field-newsletter-title\">Your Kingston newsletter</h2>\n            <h2 class=\"success-response\">Thank you for signing up!</h2>\n            \n            <div class=\"field field--name-field-newsletter-body field--type-string-long field--label-hidden field__item\">Get the latest borough news and events by email.</div>\n      \n            <p class=\"success-response\">Look out for news and updates.</p>\n            <div id=\"mce-responses\" class=\"clear\" aria-live=\"polite\">\n              <div class=\"response\" id=\"mce-error-response\" style=\"display: none;\"></div>\n              <div class=\"response\" id=\"mce-success-response\" style=\"display: none;\"></div>\n            </div>\n            <div class=\"mc-field-group\">\n              <label for=\"mce-EMAIL\" class=\"visually-hidden\">Email Address<span class=\"asterisk\">*</span></label>\n              <input type=\"email\" name=\"EMAIL\" class=\"required email\" id=\"mce-EMAIL\" required=\"\" value=\"\" placeholder=\"Email address\">\n            </div>\n            <div aria-hidden=\"true\" style=\"position: absolute; left: -5000px;\">\n              <input type=\"text\" name=\"b_4f9693900f570d3a4ca3b6e39_d51fd21b38\" tabindex=\"-1\" value=\"\">\n            </div>\n            <div class=\"clear\">\n              <input type=\"submit\" name=\"subscribe\" id=\"mc-embedded-subscribe\" class=\"button\" value=\"Sign up\" aria-label=\"Sign up for newsletter\">\n            </div>\n          </div>\n        </div>\n      </form>\n    </div>\n  </div>\n</div>\n\n        \n    <div role=\"navigation\" aria-labelledby=\"skip-to-main\">\n      <a id=\"skip-to-main\" href=\"#main-content\" class=\"visually-hidden focusable skip-link\">\n        Skip to main content\n      </a>\n    </div>\n\n    <noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-WMQS349X\"\n                  height=\"0\" width