">\n  \n    \n      \n  \n\n\n  <div class=\"lgd-page-title-block\">\n          <h1 class=\"lgd-page-title-block__title \">\n        Movie Magic: A Momentum Christmas Special\n              </h1>\n    \n                  <p></p>\n\n          \n  </div>\n\n  </div>\n\n    </div>\n\n          </div>\n    \n  </div>\n\n    \n    \n                                <div class=\"lgd-main-content\">\n        \n  \n  \n  \n\n  <div class=\"lgd-region lgd-region--content region region-content\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--content\">\n      <div id=\"block-bbd-localgov-localgov-mainpagecontent-scarfolk--2\" class=\"block block-system block-system-main-block\">\n  \n    \n      \n\n  \n\n\n\n\n<article class=\"localgov-event node node--type-localgov-event node--with-restricted-width node--promoted node--view-mode-full\">\n  \n  \n\n  <div class=\"lgd-container padding-horizontal\">\n              \n    <div class=\"node__restricted-width-section\">\n      \n                          \n      <div class=\"localgov-event__content node__content\">\n        \n            <div class=\"field field--name-localgov-event-image field--type-entity-reference field--label-hidden field__item\"><div>\n  <div class=\"media-holder\">\n    \n    \n            <div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/2025-11/Film%20Poster%20Nov%202025%20%281%29.png\" width=\"2646\" height=\"842\" alt=\"Movie Magic\" />\n\n</div>\n      \n  </div>\n</div>\n</div>\n      \n        \n        \n            <div class=\"field field--name-localgov-event-date field--type-date-recur field--label-hidden field__item\">  <div class=\"date-recur-date\"><time datetime=\"2025-12-20T14:00:00Z\">Saturday 20 December 2025, 2.00pm</time>\nto <time datetime=\"2025-12-20T17:30:00Z\">5.30pm</time>\n</div>\n\n\n</div>\n      \n\n                  <div class=\"event-address\">\n            \n          </div>\n        \n        <div class=\"event-price\">\n          \n            <div class=\"field field--name-localgov-event-price field--type-entity-reference field--label-hidden field__item\">Paid</div>\n      \n        </div>\n\n        \n            <div class=\"field field--name-localgov-event-call-to-action field--type-link field--label-hidden field__item\"><a href=\"https://www.tickettailor.com/events/momentumchildrenscharity/1921641\">Book here</a></div>\n      \n        \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><p>Bring the whole family along for a fun and festive screening of a much-loved Christmas classic at Christ Church, Surbiton Hill, in support of Momentum Children's Charity. Treats, snacks and drinks available to buy and your chance to win fantastic seasonal raffle prizes.</p></div>\n      \n        \n\n\n\n<div class=\"localgov-add-to-calendar\">\n\n<button class=\"localgov-add-to-calendar__trigger\" type=\"button\" name=\"addToCalendarTrigger\">\n  \n\n\n<span aria-hidden=\"true\" class=\"lgd-icon localgov-add-to-calendar__trigger-icon\">\n  <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"><!--! Font Awesome Free 6.1.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2022 Fonticons, Inc. --><path d=\"M152 64H296V24C296 10.75 306.7 0 320 0C333.3 0 344 10.75 344 24V64H384C419.3 64 448 92.65 448 128V448C448 483.3 419.3 512 384 512H64C28.65 512 0 483.3 0 448V128C0 92.65 28.65 64 64 64H104V24C104 10.75 114.7 0 128 0C141.3 0 152 10.75 152 24V64zM48 448C48 456.8 55.16 464 64 464H384C392.8 464 400 456.8 400 448V192H48V448z\"/></svg></span>  <span class=\"localgov-add-to-calendar__trigger-text\">\n    Add to Calendar\n  </span>\n</button>\n\n  <dialog class=\"localgov-add-to-calendar__dialog\">\n    <div class=\"localgov-add-to-calendar__dialog-close\">\n      <button class=\"localgov-add-to-calendar__dialog-close-button\" type=\"button\" name=\"closeAddToCalendarDialog\">\n        Close\n      </button>\n    </div>\n    <div class=\"localgov-add-to-calendar__items\">\n\n      <div class=\"localgov-add-to-calendar__item\">\n        <a href=\"    https://www.google.com/calendar/r/eventedit?text=Movie Magic: A Momentum Christmas Special\n                          &location=Christ Church , Surbiton Hill , KT5 8JJ\n        \" target=\"_blank\" rel=\"nofollow\">Add to Google Calendar</a>\n      </div>\n\n      <div class=\"localgov-add-to-calendar__item\">\n        <a href=\"data:text/calendar;charset=utf8,BEGIN:VCALENDAR%0AVERSION:2.0%0ABEGIN:VEVENT%0ASUMMARY:Movie Magic: A Momentum Christmas Special%0ALOCATION: Christ Church , Surbiton Hill , KT5 8JJ%0AEND:VEVENT%0AEND:VCALENDAR\">Add to iCal</a>\n      </div>\n\n      <div class=\"localgov-add-to-calendar__item\">\n        <a href=\"data:text/calendar;charset=utf8,BEGIN:VCALENDAR%0AVERSION:2.0%0ABEGIN:VEVENT%0ASUMMARY:Movie Magic: A Momentum Christmas Special%0ALOCATION: Christ Church , Surbiton Hill , KT5 8JJ%0AEND:VEVENT%0AEND:VCALENDAR\">Add to Outlook</a>\n      </div>\n\n    </div>\n  </dialog>\n\n</div>\n\n        \n      <div class=\"field field--name-localgov-event-location field--type-entity-reference field--label-hidden field__items\">\n              <div class=\"field__item\">\n<article>\n      \n  <div class=\"field field--name-location field--type-geofield field--label-visually_hidden\">\n    <div class=\"field__label visually-hidden\">Location</div>\n              <div class=\"field__item\">\n  \n  <div id=\"leaflet-map-geo-entity-address-55-location\" style=\"min-width: 150px; height: 400px\"></div>\n</div>\n          </div>\n\n  <div class=\"field field--name-postal-address field--type-address field--label-above\">\n    <div class=\"field__label\">Address</div>\n              <div class=\"field__item\"><p class=\"address\" translate=\"no\"><span class