el\":\"(link sends email)\",\"extUseFontAwesome\":true,\"extIconPlacement\":\"append\",\"extFaLinkClasses\":\"fa fa-external-link\",\"extFaMailtoClasses\":\"fa fa-envelope\",\"whitelistedDomains\":[\"kingston-self.achieveservice.com\"]}},\"localgov_base\":{\"mobileBreakpointJS\":\"768\"},\"user\":{\"uid\":0,\"permissionsHash\":\"1479f099409c27945425f3871c02f6831f150f2672ecfeae77d533fd7bb53770\"}}</script>\n<script src=\"/sites/default/files/js/js_PQiIenfKmFfbjlH_6y58v1YGHswAyujPCY6_k1MaOs8.js?scope=header&amp;delta=0&amp;language=en-gb&amp;theme=bbd_localgov&amp;include=eJxdjkEOwyAMBD9Ew5OQHTaE4uII3Cj5fanUHpLLamcuu8wxsOhcPP9b2CghLEBkmov7emtUu5Blrf7GjmGGFnBs2hHDkmVg9wkVjcRFMhI60TxjpT1r6w6HSa7Fx_beSKYfuqSaBMEo-TTizhM96bjKlxuHSZLuganDJ1Eem1fZLc_lfKygiPYBRCldnA\"></script>\n<script src=\"/modules/contrib/google_tag/js/gtag.js?tlx91z\"></script>\n<script src=\"/modules/contrib/google_tag/js/gtm.js?tlx91z\"></script>\n\n        \n                  <link rel=\"icon\" type=\"image/png\" href=\"/themes/custom/bbd_localgov/images/icons/favicon-96x96.png\" sizes=\"96x96\" />\n          <link rel=\"icon\" type=\"image/svg+xml\" href=\"/themes/custom/bbd_localgov/images/icons/favicon.svg\" />\n          <link rel=\"shortcut icon\" href=\"/themes/custom/bbd_localgov/images/icons/favicon.ico\" />\n          <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/themes/custom/bbd_localgov/images/icons/apple-touch-icon.png\" />\n          <link rel=\"manifest\" href=\"/themes/custom/bbd_localgov/images/icons/site.webmanifest\" />\n        </head>\n  <body class=\"sticky-header no-js path-events\">\n        <script>\n      document.querySelector('body').classList.remove('no-js');\n    </script>\n              <div id=\"newsletter-popup\" class=\"newsletter-popup\">\n  <div class=\"newsletter-overlay\"></div>\n  <div id=\"mc_embed_shell\" class=\"newsletter-block\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"dialog-label\" data-newsletter-popup-dialog>\n    <div id=\"mc_embed_signup\">\n      <form action=\"https://kingston.us2.list-manage.com/subscribe/post?u=4f9693900f570d3a4ca3b6e39&id=d51fd21b38&f_id=009dc0e1f0\" method=\"post\" id=\"mc-embedded-subscribe-form\" name=\"mc-embedded-subscribe-form\" class=\"validate\" target=\"_blank\">\n        <div id=\"mc_embed_signup_scroll\">\n          <button class=\"js-newsletter-close-button newsletter-close-button\" data-newsletter-popup-close aria-label=\"Close newsletter signup\">\n            Close\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n              <path d=\"M1.6 16L0 14.4L6.4 8L0 1.6L1.6 0L8 6.4L14.4 0L16 1.6L9.6 8L16 14.4L14.4 16L8 9.6L1.6 16Z\" fill=\"#0B0C0C\"/>\n            </svg>\n          </button>\n          <div class=\"newsletter-image\">\n            \n            <div class=\"field field--name-field-newsletter-image field--type-entity-reference field--label-hidden field__item\"><div>\n  <div class=\"media-holder\">\n    \n    \n            <div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/2025-08/Your_Kingston-Masthead-RGB-300ppi.jpg\" width=\"1920\" height=\"1080\" alt=\"Your Kingston header\" />\n\n</div>\n      \n  </div>\n</div>\n</div>\n      \n          </div>\n          <div class=\"newsletter-content\">\n            <h2 id=\"dialog-label\" class=\"name-field-newsletter-title\">Your Kingston newsletter</h2>\n            <h2 class=\"success-response\">Thank you for signing up!</h2>\n            \n            <div class=\"field field--name-field-newsletter-body field--type-string-long field--label-hidden field__item\">Get the latest borough news and events by email.</div>\n      \n            <p class=\"success-response\">Look out for news and updates.</p>\n            <div id=\"mce-responses\" class=\"clear\" aria-live=\"polite\">\n              <div class=\"response\" id=\"mce-error-response\" style=\"display: none;\"></div>\n              <div class=\"response\" id=\"mce-success-response\" style=\"display: none;\"></div>\n            </div>\n            <div class=\"mc-field-group\">\n              <label for=\"mce-EMAIL\" class=\"visually-hidden\">Email Address<span class=\"asterisk\">*</span></label>\n              <input type=\"email\" name=\"EMAIL\" class=\"required email\" id=\"mce-EMAIL\" required=\"\" value=\"\" placeholder=\"Email address\">\n            </div>\n            <div aria-hidden=\"true\" style=\"position: absolute; left: -5000px;\">\n              <input type=\"text\" name=\"b_4f9693900f570d3a4ca3b6e39_d51fd21b38\" tabindex=\"-1\" value=\"\">\n            </div>\n            <div class=\"clear\">\n              <input type=\"submit\" name=\"subscribe\" id=\"mc-embedded-subscribe\" class=\"button\" value=\"Sign up\" aria-label=\"Sign up for newsletter\">\n            </div>\n          </div>\n        </div>\n      </form>\n    </div>\n  </div>\n</div>\n\n        \n    <div role=\"navigation\" aria-labelledby=\"skip-to-main\">\n      <a id=\"skip-to-main\" href=\"#main-content\" class=\"visually-hidden focusable skip-link\">\n        Skip to main content\n      </a>\n    </div>\n\n    <noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-WMQS349X\"\n                  height=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n\n      <div class=\"dialog-off-canvas-main-canvas\" data-off-canvas-main-canvas>\n    \n\n\n<div class=\"content-wrapper\">\n\n      \n<header class=\"lgd-header\">\n  <div class=\"lgd-container\">\n    <div class=\"lgd-row\">\n      <div class=\"lgd-row__full\">\n        <div class=\"lgd-header__inner\">\n\n          <div id=\"block-bbd-localgov-localgov-sitebranding-scarfolk\" class=\"block block-system block-system-branding-block\">\n  \n    \n        <div class=\"branding\">\n      <div class=\"branding__item branding__item--logo\">\n        <a href=\"/\" rel=\"home\" class=\"branding__logo\">\n          <div class=\"over-logo\"></div>\n          Home\n        </a>\n      </div>\n    </div>\n  </div>\n\n          \n                      <div id=\"lgd-header__nav--primary\" class=\"lgd-header__nav lgd-header__nav--primary\">\n              \n  \n  \n  \n\n  <div class=\"lgd-region lgd-region--primary-menu region region-primary-menu\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--primary-menu\">\n      \n      \n  \n\n<nav aria-labelledby=\"block-bbd-localgov-localgov-mainnavigation-scarfolk-menu\" id=\"block-bbd-localgov-localgov-mainnavigation-scarfolk\" class=\"block block-menu navigation navigation--main\">\n            \n  <h2 class=\"visually-hidden\" id=\"block-bbd-localgov-localgov-mainnavigation-scarfolk-menu\">Main navigation</h2>\n  \n\n        \n      \n        \n    \n            <ul class=\"menu menu--main\">\n                    <li class=\"menu-item\">\n        <a href=\"/your-council\" target=\"_self\" data-drupal-link-system-path=\"node/2707\">Your council</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"/your-council/your-kingston-newsroom\" data-drupal-link-system-path=\"node/88109\">News</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"/my-area\" data-drupal-link-system-path=\"node/928\">In my area</a>\n              </li>\n        </ul>\n  \n\n\n  </nav>\n\n    </div>\n\n    \n  </div>\n\n            </div>\n          \n          <div class=\"button-block block block-bbd-custom block-bbd-custom-button-block\" id=\"block-bbd-localgov-buttonblock\">\n  \n    \n      <div><a href=\"#bbd-translation-form\" class=\"button-link\">Translate</a></div>\n\n  </div>\n\n          \n          <div class=\"views-exposed-form bef-exposed-form block block-views block-views-exposed-filter-blocksearch-block-2\" data-drupal-selector=\"views-exposed-form-search-block-2\" id=\"block-bbd-localgov-exposedformsearchblock-2\">\n  \n      <h2>Search Results</h2>\n    \n      <form action=\"/search\" method=\"get\" id=\"views-exposed-form-search-block-2\" accept-charset=\"UTF-8\">\n  \n\n<div class=\"js-form-item form-item js-form-type-textfield form-item-search-api-fulltext js-form-item-search-api-fulltext\">\n      <label for=\"edit-search-api-fulltext\">Search</label>\n          <input placeholder=\"Search for services or support\" data-drupal-selector=\"edit-search-api-fulltext\" type=\"text\" id=\"edit-search-api-fulltext\" name=\"search_api_fulltext\" value=\"\" size=\"30\" maxlength=\"128\" class=\"form-text\" />\n\n      </div>\n<div data-drupal-selector=\"edit-actions--2\" class=\"form-actions js-form-wrapper form-wrapper\" id=\"edit-actions--2--PJe9dizIvbE\"><input data-drupal-selector=\"edit-submit-search\" type=\"submit\" id=\"edit-submit-search\" value=\"Search\" class=\"button js-form-submit form-submit\" />\n</div>\n\n\n</form>\n\n  </div>\n\n\n          <div class=\"lgd-header__toggles\">\n                            <button\n                  class=\"lgd-header__toggle lgd-header__toggle--secondary\"\n                  data-target=\"lgd-header__nav--secondary\"\n                  aria-controls=\"lgd-header__nav--secondary\"\n                  aria-expanded=\"false\"\n                  aria-label=\"Services: jump to services\"\n                >\n                  <span class=\"lgd-header__toggle-text lgd-header__toggle-text--secondary lgd-header__toggle-text--services\">Services</span>\n                  <span class=\"lgd-header__toggle-text lgd-header__toggle-text--secondary lgd-header__toggle-text--menu\">Menu</span>\n                  <span class=\"lgd-header__toggle-text lgd-header__toggle-text--secondary lgd-header__toggle-text--close\">Close</span>\n    \n                </button>\n              \n                          <button\n                class=\"lgd-header__toggle lgd-header__toggle--primary\"\n                data-target=\"lgd-header__nav-