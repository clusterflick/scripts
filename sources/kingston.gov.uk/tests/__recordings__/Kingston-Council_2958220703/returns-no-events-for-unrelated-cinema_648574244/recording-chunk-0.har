mes/custom/bbd_localgov/images/icons/site.webmanifest\" />\n        </head>\n  <body class=\"sticky-header no-js path-node page-node-type-localgov-event\">\n        <script>\n      document.querySelector('body').classList.remove('no-js');\n    </script>\n              <div id=\"newsletter-popup\" class=\"newsletter-popup\">\n  <div class=\"newsletter-overlay\"></div>\n  <div id=\"mc_embed_shell\" class=\"newsletter-block\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"dialog-label\" data-newsletter-popup-dialog>\n    <div id=\"mc_embed_signup\">\n      <form action=\"https://kingston.us2.list-manage.com/subscribe/post?u=4f9693900f570d3a4ca3b6e39&id=d51fd21b38&f_id=009dc0e1f0\" method=\"post\" id=\"mc-embedded-subscribe-form\" name=\"mc-embedded-subscribe-form\" class=\"validate\" target=\"_blank\">\n        <div id=\"mc_embed_signup_scroll\">\n          <button class=\"js-newsletter-close-button newsletter-close-button\" data-newsletter-popup-close aria-label=\"Close newsletter signup\">\n            Close\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n              <path d=\"M1.6 16L0 14.4L6.4 8L0 1.6L1.6 0L8 6.4L14.4 0L16 1.6L9.6 8L16 14.4L14.4 16L8 9.6L1.6 16Z\" fill=\"#0B0C0C\"/>\n            </svg>\n          </button>\n          <div class=\"newsletter-image\">\n            \n            <div class=\"field field--name-field-newsletter-image field--type-entity-reference field--label-hidden field__item\"><div>\n  <div class=\"media-holder\">\n    \n    \n            <div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/2025-08/Your_Kingston-Masthead-RGB-300ppi.jpg\" width=\"1920\" height=\"1080\" alt=\"Your Kingston header\" />\n\n</div>\n      \n  </div>\n</div>\n</div>\n      \n          </div>\n          <div class=\"newsletter-content\">\n            <h2 id=\"dialog-label\" class=\"name-field-newsletter-title\">Your Kingston newsletter</h2>\n            <h2 class=\"success-response\">Thank you for signing up!</h2>\n            \n            <div class=\"field field--name-field-newsletter-body field--type-string-long field--label-hidden field__item\">Get the latest borough news and events by email.</div>\n      \n            <p class=\"success-response\">Look out for news and updates.</p>\n            <div id=\"mce-responses\" class=\"clear\" aria-live=\"polite\">\n              <div class=\"response\" id=\"mce-error-response\" style=\"display: none;\"></div>\n              <div class=\"response\" id=\"mce-success-response\" style=\"display: none;\"></div>\n            </div>\n            <div class=\"mc-field-group\">\n              <label for=\"mce-EMAIL\" class=\"visually-hidden\">Email Address<span class=\"asterisk\">*</span></label>\n              <input type=\"email\" name=\"EMAIL\" class=\"required email\" id=\"mce-EMAIL\" required=\"\" value=\"\" placeholder=\"Email address\">\n            </div>\n            <div aria-hidden=\"true\" style=\"position: absolute; left: -5000px;\">\n              <input type=\"text\" name=\"b_4f9693900f570d3a4ca3b6e39_d51fd21b38\" tabindex=\"-1\" value=\"\">\n            </div>\n            <div class=\"clear\">\n              <input type=\"submit\" name=\"subscribe\" id=\"mc-embedded-subscribe\" class=\"button\" value=\"Sign up\" aria-label=\"Sign up for newsletter\">\n            </div>\n          </div>\n        </div>\n      </form>\n    </div>\n  </div>\n</div>\n\n        \n    <div role=\"navigation\" aria-labelledby=\"skip-to-main\">\n      <a id=\"skip-to-main\" href=\"#main-content\" class=\"visually-hidden focusable skip-link\">\n        Skip to main content\n      </a>\n    </div>\n\n    <noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-WMQS349X\"\n                  height=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\