\\t\\n\\t\\t\\t[data-surface*=\\\"sunken\\\"]{\\n\\t\\t\\t\\t--colorv3-current-base:var(--colorv3-sunken-base);\\n\\t\\t\\t\\t--colorv3-current-hover:var(--colorv3-sunken-hover);\\n\\t\\t\\t\\t--colorv3-current-active:var(--colorv3-sunken-active);\\n\\t\\t\\t\\t--colorv3-current-text-high:var(--colorv3-sunken-text-high);\\n\\t\\t\\t\\t--colorv3-current-text-medium:var(--colorv3-sunken-text-medium);\\n\\t\\t\\t\\t--colorv3-current-text-low:var(--colorv3-sunken-text-low);\\n\\t\\t\\t\\t--colorv3-current-text-disabled:var(--colorv3-sunken-text-disabled);\\n\\t\\t\\t\\t--colorv3-current-text-primary:var(--colorv3-sunken-text-primary);\\n\\t\\t\\t\\t--colorv3-current-text-success:var(--colorv3-sunken-text-success);\\n\\t\\t\\t\\t--colorv3-current-text-error:var(--colorv3-sunken-text-error);\\n\\t\\t\\t\\t--colorv3-current-text-warning:var(--colorv3-sunken-text-warning);\\n\\t\\t\\t\\t--colorv3-current-text-info:var(--colorv3-sunken-text-info);\\n\\t\\t\\t\\t--colorv3-current-border:var(--colorv3-sunken-border);\\n\\t\\t\\t\\tbackground:var(--colorv3-sunken-base);color:var(--colorv3-current-text-high);\\n\\t\\t\\t}\\n\\t\\t\\t[data-surface*=\\\"sunken\\\"][data-surface*=\\\"interactive\\\"]:hover{background:var(--colorv3-sunken-hover)}\\n\\t\\t\\t[data-surface*=\\\"sunken\\\"][data-surface*=\\\"interactive\\\"]:active{background:var(--colorv3-sunken-active)}\\n\\t\\n\\n\\t[data-text=\\\"high\\\"]{color:var(--colorv3-current-text-high)}\\n\\t[data-text=\\\"medium\\\"]{color:var(--colorv3-current-text-medium)}\\n\\t[data-text=\\\"low\\\"]{color:var(--colorv3-current-text-low)}\\n\\t[data-text=\\\"disabled\\\"]{color:var(--colorv3-current-text-disabled)}\\n\\t[data-text=\\\"primary\\\"]{color:var(--colorv3-current-text-primary)}\\n\\t[data-text=\\\"success\\\"]{color:var(--colorv3-current-text-success)}\\n\\t[data-text=\\\"error\\\"]{color:var(--colorv3-current-text-error)}\\n\\t[data-text=\\\"warning\\\"]{color:var(--colorv3-current-text-warning)}\\n\\t[data-text=\\\"info\\\"]{color:var(--colorv3-current-text-info)}\\n        }\\n    \",ticketButtonText:\"Get tickets\"},settings:{afterCheckoutRedirect:void 0,allowTicketAndMerchSwaps:false,allowUserEdit:true,codesViaLinkOnly:false,disableHumanitixGTM:false,hideAddToCalendar:false,hideArtistPreviews:false,removeImpactCommunication:false,requireEmailConfirmation:false,sendTickets:true,noTicketsMessagingOption:\"none\",showTicketsLeft:false,minimumTicketsPerOrder:void 0,maximumTicketsPerOrder:void 0,seatingMapEditable:false,enableV3SeatMaps:false,waitlistEnabled:false,salesStopped:false,hideConfetti:false,mobileRequired:true},eventModules:[{component:\"richtext\",props:{title:\"Description\",content:\"\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">BRONSON is a powerful one-man theatrical exploration inspired by the extraordinary public persona and life surrounding one of Britain’s most notorious prisoners.\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">Performed by Francis Saunders and directed by Sean Broughton, the production takes the audience inside a world of confinement, violence, humour, identity and survival.\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">Moving between characters and states of mind, the performance explores the man behind the mythology and asks a much bigger question: when someone spends decades inside an institution, where does the individual end and the character created by that institution begin?\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">Raw, physical and at times darkly funny, BRONSON is not presented as a factual biography. It is a piece of theatre inspired by themes of imprisonment, isolation, masculinity, institutionalisation and the human need to be seen.\\u003C/span>\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">CREATIVE TEAM\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">Performed by Francis Saunders\\u003Cbr />Directed by Sean Broughton\\u003Cbr />Assistant Director Dean Stalham\\u003Cbr />Producer Jo Morgan\\u003Cbr />Music De Crâne\\u003Cbr />Sound Jules Deering\\u003C/span>\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">AGE RESTRICTION\\u003Cbr />16+\\u003C/span>\\u003C/p>\"}}],artists:[],seo:{jsonSchema:{\"@context\":\"https://schema.org\",\"@type\":\"Event\",name:\"BRONSON\",url:\"https://events.humanitix.com/bronson\",startDate:\"2026-10-20T19:00:00+0100\",endDate:\"2026-10-20T20:00:00+0100\",location:{\"@type\":\"Place\",name:\"Etcetera Theatre\",address:{\"@type\":\"PostalAddress\",streetAddress:\"265 Camden High St, London NW1 8QR, UK\",postalCode:\"NW1 8QR\",addressRegion:\"England\",addressCountry:\"GB\"}},eventStatus:\"https://schema.org/EventScheduled\",eventAttendanceMode:\"https://schema.org/OfflineEventAttendanceMode\",description:\"BRONSON is a powerful one-man theatrical exploration inspired by the extraordinary public persona and life surrounding one of Britain’s most notorious prisoners\",image:\"https://images.humanitix.com/i/5f19352b-dbf5-4d00-89bd-1e459b16cdab.png@seo-500.jpg\",offers:[{\"@type\":\"AggregateOffer\",offerCount:1,priceCurrency:\"GBP\",availabilityStarts:c,availability:\"InStock\",availabilityEnds:b},{\"@type\":\"Offer\",url:\"https://events.humanitix.com/bronson/tickets\",name:\"General Admission\",price:12.5,availability:\"InStock\",availabilityStarts:void 0,availabilityEnds:void 0,priceCurrency:\"GBP\",validFrom:void 0}]},title:\"BRONSON\",descriptions:{default:\"Get tickets on Humanitix - BRONSON hosted by Etcetera Theatre Camden. Etcetera Theatre, 265 Camden High St, London NW1 8QR, UK. Tuesday 20th October 2026. Fi