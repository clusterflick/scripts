(--colorv3-sunken-text-primary);\\n\\t\\t\\t\\t--colorv3-current-text-success:var(--colorv3-sunken-text-success);\\n\\t\\t\\t\\t--colorv3-current-text-error:var(--colorv3-sunken-text-error);\\n\\t\\t\\t\\t--colorv3-current-text-warning:var(--colorv3-sunken-text-warning);\\n\\t\\t\\t\\t--colorv3-current-text-info:var(--colorv3-sunken-text-info);\\n\\t\\t\\t\\t--colorv3-current-border:var(--colorv3-sunken-border);\\n\\t\\t\\t\\tbackground:var(--colorv3-sunken-base);color:var(--colorv3-current-text-high);\\n\\t\\t\\t}\\n\\t\\t\\t[data-surface*=\\\"sunken\\\"][data-surface*=\\\"interactive\\\"]:hover{background:var(--colorv3-sunken-hover)}\\n\\t\\t\\t[data-surface*=\\\"sunken\\\"][data-surface*=\\\"interactive\\\"]:active{background:var(--colorv3-sunken-active)}\\n\\t\\n\\n\\t[data-text=\\\"high\\\"]{color:var(--colorv3-current-text-high)}\\n\\t[data-text=\\\"medium\\\"]{color:var(--colorv3-current-text-medium)}\\n\\t[data-text=\\\"low\\\"]{color:var(--colorv3-current-text-low)}\\n\\t[data-text=\\\"disabled\\\"]{color:var(--colorv3-current-text-disabled)}\\n\\t[data-text=\\\"primary\\\"]{color:var(--colorv3-current-text-primary)}\\n\\t[data-text=\\\"success\\\"]{color:var(--colorv3-current-text-success)}\\n\\t[data-text=\\\"error\\\"]{color:var(--colorv3-current-text-error)}\\n\\t[data-text=\\\"warning\\\"]{color:var(--colorv3-current-text-warning)}\\n\\t[data-text=\\\"info\\\"]{color:var(--colorv3-current-text-info)}\\n        }\\n    \",ticketButtonText:\"Get tickets\"},settings:{afterCheckoutRedirect:void 0,allowTicketAndMerchSwaps:false,allowUserEdit:true,codesViaLinkOnly:false,disableHumanitixGTM:false,hideAddToCalendar:false,hideArtistPreviews:false,removeImpactCommunication:false,requireEmailConfirmation:false,sendTickets:true,noTicketsMessagingOption:\"none\",showTicketsLeft:false,minimumTicketsPerOrder:void 0,maximumTicketsPerOrder:void 0,seatingMapEditable:false,enableV3SeatMaps:false,waitlistEnabled:false,salesStopped:false,hideConfetti:false,mobileRequired:true},eventModules:[{component:\"richtext\",props:{title:\"Description\",content:\"\\u003Ch4>London Creative Singing presents Diva Singing Course Showcase\\u003C/h4>\\u003Cp>\\u003C/p>\\u003Cp>Join us for a special \\u003Cstrong>one-off performance celebrating passion, creativity and the joy of singing!\\u003C/strong>\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>London Creative Singing founder, singer/songwriter, musician and vocal coach \\u003Cstrong>Geeta Pearson (Belle Scar)\\u003C/strong> brings together the students completing the \\u003Cstrong>Diva Singing Course\\u003C/strong> for an exciting live showcase. Each performer will take to the stage with their \\u003Cstrong>own unique interpretation of iconic diva songs\\u003C/strong>, maybe also some originals, putting everything they’ve explored throughout the course into performance.\\u003C/p>\\u003Cp>Come and support these amazing people as they step into the spotlight, express themselves and share their passion with a live audience.\\u003C/p>\\u003Cp>\\u003Cstrong>11 December · 18:30\\u003C/strong>\\u003Cbr />\\u003Cstrong>Etcetera Theatre\\u003C/strong>\\u003C/p>\\u003Cp>One night. Unique voices. Lots of beautiful singing. \\u003Cstrong>Come and celebrate them!\\u003C/strong>\\u003C/p>\\u003Cp>\\u003Cstrong>Amy, Caroline, Jake, Annabelle, Katie, Maria, Charlotte, Leila, Faith, Jobin, Akua and Amit.\\u003C/strong>\\u003C/p>\\u003Cp>\\u003Cbr />\\u003Cbr />\\u003Ca rel=\\\"nofollow\\\" rel=\\\"nofollow\\\" target=\\\"_blank\\\" href=\\\"https://www.instagram.com/london_creative_singing)-\\\">https://www.instagram.com/london_creative_singing\\u003C/a>\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>No age restrictions\\u003C/p>\"}}],artists:[],seo:{jsonSchema:{\"@context\":\"https://schema.org\",\"@type\":\"Event\",name:\"Loncon Creative Singing Diva singing course showcase\",url:\"https://events.humanitix.com/loncon-creative-singing-diva-singing-course-showcase\",startDate:\"2026-12-11T18:30:00+0000\",endDate:\"2026-12-11T20:00:0