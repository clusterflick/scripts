-46b6-aa25-89d0b3c3dddb.jpg@responsive-250.avif 200w, https://images.humanitix.com/i/3cff8e99-ac8a-46b6-aa25-89d0b3c3dddb.jpg@responsive-500.avif 400w, https://images.humanitix.com/i/3cff8e99-ac8a-46b6-aa25-89d0b3c3dddb.jpg@responsive-500.avif 600w, https://images.humanitix.com/i/3cff8e99-ac8a-46b6-aa25-89d0b3c3dddb.jpg@responsive-750.avif 800w\" sizes=\"auto\"/><!--]--> <source type=\"image/webp\" srcset=\"https://images.humanitix.com/i/3cff8e99-ac8a-46b6-aa25-89d0b3c3dddb.jpg@responsive-250.webp 200w, https://images.humanitix.com/i/3cff8e99-ac8a-46b6-aa25-89d0b3c3dddb.jpg@responsive-500.webp 400w, https://images.humanitix.com/i/3cff8e99-ac8a-46b6-aa25-89d0b3c3dddb.jpg@responsive-500.webp 600w, https://images.humanitix.com/i/3cff8e99-ac8a-46b6-aa25-89d0b3c3dddb.jpg@responsive-750.webp 800w\" sizes=\"auto\"/> <img src=\"https://images.humanitix.com/i/3cff8e99-ac8a-46b6-aa25-89d0b3c3dddb.jpg@responsive-500.webp\" alt=\"\" width=\"600\" height=\"600\" loading=\"lazy\" sizes=\"auto\" fetchpriority=\"auto\" class=\"svelte-uzlrqx\"/></picture><!----></div></button><!--]--></div> <!--[0--><!----><button data-variant=\"secondary\" data-size=\"m\" class=\"Btn  svelte-17nnmqu f-label-3\" type=\"button\" aria-disabled=\"false\" data-loading=\"false\"><!--[-1--><!--]--> <div class=\"content-container svelte-17nnmqu\"><!--[-1--><!---->Show more<!----><!--]--></div> <!--[-1--><!--]--><!----></button><!----><!--]--></div><!--]--><!--]--><!--[0--><!--[1--><dialog class=\"ModalShell svelte-14yzxqa\" data-transition-intent=\"none\"><div class=\"CarouselModal svelte-1subrpe\" data-surface=\"background\" data-desktop-height=\"min-content\"><button class=\"ModalCloseButton svelte-t3wwh4\" type=\"button\" aria-label=\"Close dialog\" data-trap-boundary=\"first\" data-button-style=\"round\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 15 15\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" class=\"CrossIcon\" aria-label=\"Cross icon\" aria-hidden=\"true\"><title>Close icon</title><path d=\"M11.782 4.032a.575.575 0 1 0-.813-.814L7.5 6.687 4.032 3.218a.575.575 0 0 0-.814.814L6.687 7.5l-3.469 3.468a.575.575 0 0 0 .814.814L7.5 8.313l3.469 3.469a.575.575 0 0 0 .813-.814L8.313 7.5l3.469-3.468Z\" fill=\"currentColor\" fill-rule=\"evenodd\" clip-rule=\"evenodd\"></path></svg><!----><span class=\"u-visually-hidden\">Close</span></button><!----> <div class=\"content svelte-1subrpe\"><!----><!--[-1--><!--]--><!----><!----></div> <!--[-1--><!--]--> <button class=\"ModalCloseButton svelte-t3wwh4\" type=\"button\" aria-label=\"Close dialog\" data-trap-boundary=\"last\" data-button-style=\"round\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 15 15\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" class=\"CrossIcon\" aria-label=\"Cross icon\" aria-hidden=\"true\"><title>Close icon</title><path d=\"M11.782 4.032a.575.575 0 1 0-.813-.814L7.5 6.687 4.032 3.218a.575.575 0 0 0-.814.814L6.687 7.5l-3.469 3.468a.575.575 0 0 0 .814.814L7.5 8.313l3.469 3.469a.575.575 0 0 0 .813-.814L8.313 7.5l3.469-3.468Z\" fill=\"currentColor\" fill-rule=\"evenodd\" clip-rule=\"evenodd\"></path></svg><!----><span class=\"u-visually-hidden\">Close</span></button><!----></div><!----></dialog><!----> <div class=\"EventModuleGrid svelte-tge1a4\"><!--[0--><h2 class=\"f-heading-4 svelte-tge1a4\">Lineup</h2><!--]--> <ul class=\"svelte-tge1a4\"><!--[--><li data-hidden=\"false\" style=\"transition-delay: 0s\" class=\"svelte-tge1a4\"><!--[0--><!--[7--><!--[-1--><div class=\"EventModuleLineup svelte-1q2qfnz\" data-layout=\"page\" data-has-image=\"true\" data-surface=\"background interactive\"><button class=\"button svelte-1q2qfnz\"><span class=\"u-visually-hidden\">More details about Liz Aggiss</span></button> <!--[0--><picture class=\"Image photo svelte-uzlrqx\"><!--[0--><source type=\"image/avif\" srcset=\"https://images.humanitix.com/i/a0052ab0-7a96-4e53-aaf9-ca435a778bb5.png@responsive-100.avif 100w, https://images.humanitix.com/i/a0052ab0-7a96-4e53-aaf9-ca435a778bb5.png@responsive-250.avif 200w\" sizes=\"100px\"/><!--]--> <source type=\"image/webp\" srcset=\"https://images.humanitix.com/i/a0052ab0-7a96-4e53-aaf9-ca435a778bb5.png@responsive-100.webp 100w, https://images.humanitix.com/i/a0052ab0-7a96-4e53-aaf9-ca435a778bb5.png@responsive-250.webp 200w\" sizes=\"100px\"/> <img src=\"https://images.humanitix.com/i/a0052ab0-7a96-4e53-aaf9-ca435a778bb5.png@responsive-500.webp\" alt=\"Liz Aggiss\" width=\"500\" height=\"500\" loading=\"lazy\" style=\"aspect-ratio: 500/500\" sizes=\"100px\" fetchpriority=\"auto\" class=\"svelte-uzlrqx\"/></picture><!--]--> <div class=\"details svelte-1q2qfnz\"><h3 class=\"f-heading-1 heading svelte-1q2qfnz\">Liz Aggiss</h3> <!--[0--><p class=\"f-body-3 description svelte-1q2qfnz\" data-text=\"medium\">Liz Aggiss is an un-disciplined artist with an un-disciplined body of work. This does not mean she is undisciplined. Au contraire. She is exceptionally disciplined. Dodging categorisation and being classified as unclassifiable, has been a full time job. She has been described as: maverick, challenging, anarchic, indomitable, dangerous, uncompromising, subversive, fearless, funny, powerfully disturbing yet vulnerable.</p><!--]--><!----> <!--[0--><ul class=\"socials svelte-1q2qfnz\" aria-label=\"Liz Aggiss's social links\"><!--[--><li><a href=\"https://www.lizaggiss.com/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"svelte-1q2qfnz\"><span class=\"u-visually-hidden\">Liz Aggiss's website</span> <!--[--><svg aria-hidden=\"true\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" width=\"24\" height=\"24\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M16 32a16 16 0 1 0 0-32 16 16 0 0 0 0 32Zm-1.4-13.2c.4-.4.4-1 0-1.4a3 3 0 0 1 0-4.2L18 9.6a3 3 0 0 1 5 1 3 3 0 0 1-.7 3.3l-.5.5c.3.7.4 1.6.4 2.4l1.5-1.5a5 5 0 0 0-7-7l-3.6 3.5a5 5 0 0 0 0 7c.4.4 1 .4 1.4 0Zm4.2-5.6a1 1 0 0 0-1.4 0 1 1 0 0 0 0 1.4 3 3 0 0 1 0 4.2L14 22.4a3 3 0 0 1-5-1 3 3 0 0 1 .7-3.3l.5-.5a7 7 0 0 1-.4-2.4l-1.5 1.5a5 5 0 0 0 7 7l3.6-3.5a5 5 0 0 0 0-7Z\" fill=\"currentColor\"></path></svg><!--]--></a></li><!--]--></ul><!--]--><!----></div></div><!--]--><!--]--><!--]--><!----></li><li data-hidden=\"false\" style=\"transition-delay: 0s\" class=\"svelte-tge1a4\"><!--[0--><!--[7--><!--[-1--><div class=\"EventModuleLineup svelte-1q2qfnz\" data-layout=\"page\" data-has-image=\"true\" data-surface=\"background interactive\"><button class=\"button svelte-1q2qfnz\"><span class=\"u-visually-hidden\">More details about Steve Beresford</span></button> <!--[0--><picture class=\"Image photo svelte-uzlrqx\"><!--[0--><source type=\"image/avif\" srcset=\"https://images.humanitix.com/i/3a77adf1-b982-4c64-94e2-104f7ab4eaab.jpg@responsive-100.avif 100w, https://images.humanitix.com/i/3a77adf1-b982-4c64-94e2-104f7ab4eaab.jpg@responsive-250.avif 200w\" sizes=\"100px\"/><!--]--> <source type=\"image/webp\" srcset=\"https://images.humanitix.com/i/3a77adf1-b982-4c64-94e2-104f7ab4eaab.jpg@responsive-100.webp 100w, https://images.humanitix.com/i/3a77adf1-b982-4c64-94e2-104f7ab4eaab.jpg@responsive-250.webp 200w\" sizes=\"100px\"/> <img src=\"https://images.humanitix.com/i/3a77adf1-b982-4c64-94e2-104f7ab4eaab.jpg@responsive-500.webp\" alt=\"Steve Beresford\" width=\"500\" height=\"500\" loading=\"lazy\" style=\"aspect-ratio: 500/500\" sizes=\"100px\" fetchpriority=\"auto\" class=\"svelte-uzlrqx\"/></picture><!--]--> <div class=\"details svelte-1q2qfnz\"><h3 class=\"f-heading-1 heading svelte-1q2qfnz\">Steve Beresford</h3> <!--[0--><p class=\"f-body-3 description svelte-1q2qfnz\" data-text=\"medium\">Steve Beresford has played piano with improvisers like Derek Bailey and also trumpet with the notorious Portsmouth Sinfonia. He has worked with the Slits, Han Bennink, Christine Tobin, Ivor Cutler, Prince Far-I, Vic Reeves, Alan Hacker, Ray Davies, Ilan Volkov, Najma Akhtar, Evan Parker, Adrian Sherwood, The Flying Lizards, Stewart Lee, Otomo Yoshihide and John Zorn. Free improvisation is central, generally involving piano and/or electronics. He also writes songs, TV and film music, directs ensembles and has been known to sing and write.\n</p><!--]--><!----> <!--[0--><ul class=\"socials svelte-1q2qfnz\" aria-label=\"Steve Beresford's social links\"><!--[--><li><a href=\"https://www.cafeoto.co.uk/artists/steve-beresford/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"svelte-1q2qfnz\"><span class=\"u-visually-hidden\">Steve Beresford's website</span> <!--[--><svg aria-hidden=\"true\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" width=\"24\" height=\"24\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M16 32a16 16 0 1 0 0-32 16 16 0 0 0 0 32Zm-1.4-13.2c.4-.4.4-1 0-1.4a3 3 0 0 1 0-4.2L18 9.6a3 3 0 0 1 5 1 3 3 0 0 1-.7 3.3l-.5.5c.3.7.4 1.6.4 2.4l1.5-1.5a5 5 0 0 0-7-7l-3.6 3.5a5 5 0 0 0 0 7c.4.4 1 .4 1.4 0Zm4.2-5.6a1 1 0 0 0-1.4 0 1 1 0 0 0 0 1.4 3 3 0 0 1 0 4.2L14 22.4a3 3 0 0 1-5-1 3 3 0 0 1 .7-3.3l.5-.5a7 7 0 0 1-.4-2.4l-1.5 1.5a5 5 0 0 0 7 7l3.6-3.5a5 5 0 0 0 0-7Z\" fill=\"currentColor\"></path></svg><!--]--></a></li><!--]--></ul><!--]--><!----></div></div><!--]--><!--]--><!--]--><!----></li><li data-hidden=\"false\" style=\"transition-delay: 0s\" class=\"svelte-tge1a4\"><!--[0--><!--[7--><!--[-1--><div class=\"EventModuleLineup svelte-1q2qfnz\" data-layout=\"page\" data-has-image=\"true\" data-surface=\"background interactive\"><button class=\"button svelte-1q2qfnz\"><span class=\"u-visually-hidden\">More details about Neil Butler</span></button> <!--[0--><picture class=\"Image photo svelte-uzlrqx\"><!--[0--><source type=\"image/avif\" srcset=\"https://images.humanitix.com/i/930ba0ad-89d0-42a8-8efc-f873e4706599.jpg@responsive-100.avif 100w, https://images.humanitix.com/i/930ba0ad-89d0-42a8-8efc-f873e4706599.jpg@responsive-250.avif 200w\" sizes=\"100px\"/><!--]--> <source type=\"image/webp\" srcset=\"https://images.humanitix.com/i/930ba0ad-89d0-42a8-8efc-f873e4706599.jpg@responsive-100.webp 100w, https://images.humanitix.com/i/930ba0ad-89d0-42a8-8efc-f873e4706599.jpg@responsive-250.webp 200w\" sizes=\"100px\"/> <img src=\"https://images.humanitix.com/i/930ba0ad-89d0-42a8-8efc-f873e4706599.jpg@responsive-500.webp\" alt=\"Neil Butler\" width=\"500\" height=\"500\" loading=\"lazy\" style=\"aspect-ratio: 500/500\" sizes=\"100px\" fetchpriority=\"auto\" class=\"svelte-uzlrqx\"/></picture><!--]--> <div class=\"details svelte-1q2qfnz\"><h3 class=\"f-heading-1 heading svelte-1q2qfnz\">Neil Butler</h3> <!--[0--><p class=\"f-body-3 description svelte-1q2qfnz\" data-text=\"medium\">Neil Butler first performed in public aged seventeen and since then worked as an artist, creative producer and cultural strategist. Co-founder with Roger of Brighton’s Contemporary Arts Festival, he launched the Zap Club and large-scale multi-art form productions in London, Streetbiz and UZ Arts in Glasgow and Sura Medura in Sri Lanka. Along the way there’s been festivals across Scotland and the UK and projects that have spanned Europe and the World.</p><!--]--><!----> <!--[0--><ul class=\"socials svelte-1q2qfnz\" aria-label=\"Neil Butler's social links\"><!--[--><li><a href=\"http://www.neilbutler.org/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"svelte-1q2qfnz\"><span class=\"u-visually-hidden\">Neil Butler's website</span> <!--[--><svg aria-hidden=\"true\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" width=\"24\" height=\"24\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M16 32a16 16 0 1 0 0-32 16 16 0 0 0 0 32Zm-1.4-13.2c.4-.4.4-1 0-1.4a3 3 0 0 1 0-4.2L18 9.6a3 3 0 0 1 5 1 3 3 0 0 1-.7 3.3l-.5.5c.3.7.4 1.6.4 2.4l1.5-1.5a5 5 0 0 0-7-7l-3.6 3.5a5 5 0 0 0 0 7c.4.4 1 .4 1.4 0Zm4.2-5.6a1 1 0 0 0-1.4 0 1 1 0 0 0 0 1.4 3 3 0 0 1 0 4.2L14 22.4a3 3 0 0 1-5-1 3 3 0 0 1 .7-3.3l.5-.5a7 7 0 0 1-.4-2.4l-1.5 1.5a5 5 0 0 0 7 7l3.6-3.5a5 5 0 0 0 0-7Z\" fill=\"currentColor\"></path></svg><!--]--></a></li><!--]--></ul><!--]--><!----></div></div><!--]--><!--]--><!--]--><!----></li><li data-hidden=\"false\" style=\"transition-delay: 0s\" class=\"svelte-tge1a4\"><!--[0--><!--[7--><!--[-1--><div class=\"EventModuleLineup svelte-1q2qfnz\" data-layout=\"page\" data-has-image=\"true\" data-surface=\"background interactive\"><button class=\"button svelte-1q2qfnz\"><span class=\"u-visually-hidden\">More details about Phil Minton</span></button> <!--[0--><picture class=\"Image photo svelte-uzlrqx\"><!--[0--><source type=\"image/avif\" srcset=\"https://images.humanitix.com/i/5a3f4684-ce12-486e-a927-201a05d64828.jpg@responsive-100.avif 100w, https://images.humanitix.com/i/5a3f4684-ce12-486e-a927-201a05d64828.jpg@responsive-250.avif 200w\" sizes=\"100px\"/><!--]--> <source type=\"image/webp\" srcset=\"https://images.humanitix.com/i/5a3f4684-ce12-486e-a927-201a05d64828.jpg@responsive-100.webp 100w, https://images.humanitix.com/i/5a3f4684-ce12-486e-a927-201a05d64828.jpg@responsive-250.webp 200w\" sizes=\"100px\"/> <img src=\"https://images.humanitix.com/i/5a3f4684-ce12-486e-a927-201a05d64828.jpg@responsive-500.webp\" alt=\"Phil Minton\" width=\"500\" height=\"500\" loading=\"lazy\" style=\"aspect-ratio: 500/500\" sizes=\"100px\" fetchpriority=\"auto\" class=\"svelte-uzlrqx\"/></picture><!--]--> <div class=\"details svelte-1q2qfnz\"><h3 class=\"f-heading-1 heading svelte-1q2qfnz\">Phil Minton</h3> <!--[0--><p class=\"f-body-3 description svelte-1q2qfnz\" data-text=\"medium\">Phil Minton played trumpet and sang with the Mike Westbrook Band in the early 1960s and then in bands across Europe before rejoining Westbrook until the mid 1980s. He has been an improvising singer in groups and orchestras and composers have written pieces that especially employ his extended vocal techniques and improvisations. He has a quartet with Veryan Weston, Roger Turner and John Butcher and ongoing duos with all the above. He also sings with Audrey Chen, Carl Ludwig Hübsch, Guylaine Cosseron, Hugh Medcalfe and Szilard Mezei.</p><!--]--><!----> <!--[-1--><!--]--><!----></div></div><!--]--><!--]--><!--]--><!----></li><li data-hidden=\"true\" style=\"transition-delay: 0s\" class=\"svelte-tge1a4\"><!--[0--><!--[7--><!--[-1--><div class=\"EventModuleLineup svelte-1q2qfnz\" data-layout=\"page\" data-has-image=\"true\" data-surface=\"background interactive\"><button class=\"button svelte-1q2qfnz\"><span class=\"u-visually-hidden\">More details about The Neo Naturists </span></button> <!--[0--><picture class=\"Image photo svelte-uzlrqx\"><!--[0--><source type=\"image/avif\" srcset=\"https://images.humanitix.com/i/795c9ebd-2b34-4c9a-b471-1a272191e3e0.png@responsive-100.avif 100w, https://images.humanitix.com/i/795c9ebd-2b34-4c9a-b471-1a272191e3e0.png@responsive-250.avif 200w\" sizes=\"100px\"/><!--]--> <source type=\"image/webp\" srcset=\"https://images.humanitix.com/i/795c9ebd-2b34-4c9a-b471-1a272191e3e0.png@responsive-100.webp 100w, https://images.humanitix.com/i/795c9ebd-2b34-4c9a-b471-1a272191e3e0.png@responsive-250.webp 200w\" sizes=\"100px\"/> <img src=\"https://images.humanitix.com/i/795c9ebd-2b34-4c9a-b471-1a272191e3e0.png@responsive-500.webp\" alt=\"The Neo Naturists \" width=\"500\" height=\"500\" loading=\"lazy\" style=\"aspect-ratio: 500/500\" sizes=\"100px\" fetchpriority=\"auto\" class=\"svelte-uzlrqx\"/></picture><!--]--> <div class=\"details svelte-1q2qfnz\"><h3 class=\"f-heading-1 heading svelte-1q2qfnz\">The Neo Naturists </h3> <!--[0--><p class=\"f-body-3 description svelte-1q2qfnz\" data-text=\"medium\">The Neo Naturists are a performance art group founded by Christine Binnie, Jennifer Binnie and Wilma Johnson. The group emerged from a subculture – connected with but not limited to the New Romantic club scene. The most intense period of activity was during the early to mid 1980s with regular performances in nightclubs and galleries. In 2016 they had a ‘Live’ retrospective at Studio Voltaire with an evening of live art at the ICA.</p><!--]--><!----> <!--[0--><ul class=\"socials svelte-1q2qfnz\" aria-label=\"The Neo Naturists 's social links\"><!--[--><li><a href=\"https://www.jenniferbinnie.co.uk/other-work/neo-naturists/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"svelte-1q2qfnz\"><span class=\"u-visually-hidden\">The Neo Naturists 's website</span> <!--[--><svg aria-hidden=\"true\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" width=\"24\" height=\"24\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M16 32a16 16 0 1 0 0-32 16 16 0 0 0 0 32Zm-1.4-13.2c.4-.4.4-1 0-1.4a3 3 0 0 1 0-4.2L18 9.6a3 3 0 0 1 5 1 3 3 0 0 1-.7 3.3l-.5.5c.3.7.4 1.6.4 2.4l1.5-1.5a5 5 0 0 0-7-7l-3.6 3.5a5 5 0 0 0 0 7c.4.4 1 .4 1.4 0Zm4.2-5.6a1 1 0 0 0-1.4 0 1 1 0 0 0 0 1.4 3 3 0 0 1 0 4.2L14 22.4a3 3 0 0 1-5-1 3 3 0 0 1 .7-3.3l.5-.5a7 7 0 0 1-.4-2.4l-1.5 1.5a5 5 0 0 0 7 7l3.6-3.5a5 5 0 0 0 0-7Z\" fill=\"currentColor\"></path></svg><!--]--></a></li><!--]--></ul><!--]--><!----></div></div><!--]--><!--]--><!--]--><!----></li><li data-hidden=\"true\" style=\"transition-delay: 0.2s\" class=\"svelte-tge1a4\"><!--[0--><!--[7--><!--[-1--><div class=\"EventModuleLineup svelte-1q2qfnz\" data-layout=\"page\" data-has-image=\"true\" data-surface=\"background interactive\"><button class=\"button svelte-1q2qfnz\"><span class=\"u-visually-hidden\">More details about Dorothy Max Prior</span></button> <!--[0--><picture class=\"Image photo svelte-uzlrqx\"><!--[0--><source type=\"image/avif\" srcset=\"https://images.humanitix.com/i/cff5d178-2162-4006-b983-f53418be5272.png@responsive-100.avif 100w, https://images.humanitix.com/i/cff5d178-2162-4006-b983-f53418be5272.png@responsive-250.avif 200w\" sizes=\"100px\"/><!--]--> <source type=\"image/webp\" srcset=\"https://images.humanitix.com/i/cff5d178-2162-4006-b983-f53418be5272.png@responsive-100.webp 100w, https://images.humanitix.com/i/cff5d178-2162-4006-b983-f53418be5272.png@responsive-250.webp 200w\" sizes=\"100px\"/> <img src=\"https://images.humanitix.com/i/cff5d178-2162-4006-b983-f53418be5272.png@responsive-500.webp\" alt=\"Dorothy Max Prior\" width=\"500\" height=\"500\" loading=\"lazy\" style=\"aspect-ratio: 500/500\" sizes=\"100px\" fetchpriority=\"auto\" class=\"svelte-uzlrqx\"/></picture><!--]--> <div class=\"details svelte-1q2qfnz\"><h3 class=\"f-heading-1 heading svelte-1q2qfnz\">Dorothy Max Prior</h3> <!--[0--><p class=\"f-body-3 description svelte-1q2qfnz\" data-text=\"medium\">Dorothy Max Prior has worked in performance, spoken word and sound installation. She has published two bestselling volumes of her life and times:  69 Exhibition Road and Sex is No Emergency. She is editor of Total Theatre Magazine and writes for and edits other arts publications. She has a fortnightly show on Slack City Radio: Granny (Max) Takes a Trip. In other lives, Max was a punk muse, post-punk drummer (with Rema Rema and Psychic TV, amongst others) and exotic dancer. Somewhere along the way, she has taught ballroom dancing and toured the world as a cabaret artist, street theatre performer, choreographer, and director.</p><!--]--><!----> <!--[0--><ul class=\"socials svelte-1q2qfnz\" aria-label=\"Dorothy Max Prior's social links\"><!--[--><li><a href=\"https://www.instagram.com/dorothymax/?hl=en\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"svelte-1q2qfnz\"><span class=\"u-visually-hidden\">Dorothy Max Prior's instagram</span> <!--[--><svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" aria-hidden=\"true\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\"><!----><path fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24M9.36 5.64c.68-.03.9-.04 2.64-.04s1.95 0 2.64.04c.68.03 1.14.14 1.55.3a3.14 3.14 0 0 1 1.87 1.87c.16.4.27.87.3 1.55s.04.9.04 2.64 0 1.96-.04 2.64a4.7 4.7 0 0 1-.3 1.55c-.16.42-.38.78-.73 1.14-.36.35-.72.57-1.14.73-.4.16-.87.27-1.55.3s-.9.04-2.64.04-1.96 0-2.64-.04a4.7 4.7 0 0 1-1.55-.3 3.1 3.1 0 0 1-1.14-.73 3.1 3.1 0 0 1-.73-1.14 4.7 4.7 0 0 1-.3-1.55c-.03-.68-.04-.9-.04-2.64s0-1.96.04-2.64c.03-.68.14-1.15.3-1.55A3.13 3.13 0 0 1 7.8 5.94c.4-.16.87-.27 1.55-.3Zm2.43 1.11h-.36c-1.2 0-1.43.01-2.02.04-.62.03-.96.13-1.18.22-.3.11-.52.25-.74.48-.22.22-.36.43-.48.73-.09.23-.2.57-.22 1.2-.03.67-.04.87-.04 2.58 0 1.7.01 1.9.04 2.58.03.63.13.97.22 1.2.12.29.26.5.48.73.22.22.44.36.74.48.22.08.56.19 1.18.22.68.03.88.03 2.6.03 1.7 0 1.9 0 2.58-.03.62-.03.96-.14 1.19-.22a2.149 2.149 0 0 0 1.21-1.22c.09-.22.2-.56.22-1.19.03-.67.04-.87.04-2.58 0-1.7 0-1.91-.04-2.59a3.5 3.5 0 0 0-.22-1.18c-.12-.3-.26-.52-.48-.74a2 2 0 0 0-.74-.48c-.22-.09-.56-.2-1.18-.22-.68-.03-.88-.04-2.59-.04zm2.86 1.83c0-.42.34-.76.77-.76a.77.77 0 1 1-.77.76M8.7 12a3.29 3.29 0 1 1 6.58 0 3.29 3.29 0 0 1-6.58 0m5.42 0a2.13 2.13 0 1 0-4.26 0 2.13 2.13 0 0 0 4.26 0\" clip-rule=\"evenodd\"/><!----></svg><!--]--></a></li><!--]--></ul><!--]--><!----></div></div><!--]--><!--]--><!--]--><!----></li><li data-hidden=\"true\" style=\"transition-delay: 0.4s\" class=\"svelte-tge1a4\"><!--[0--><!--[7--><!--[-1--><div class=\"EventModuleLineup svelte-1q2qfnz\" data-layout=\"page\" data-has-image=\"true\" data-surface=\"background interactive\"><button class=\"button svelte-1q2qfnz\"><span class=\"u-visually-hidden\">More details about Dave Stephens</span></button> <!--[0--><picture class=\"Image photo svelte-uzlrqx\"><!--[0--><source type=\"image/avif\" srcset=\"https://images.humanitix.com/i/75ca2a3e-aed3-4d7b-8c51-9b035258de0d.png@responsive-100.avif 100w, https://images.humanitix.com/i/75ca2a3e-aed3-4d7b-8c51-9b035258de0d.png@responsive-250.avif 200w\" sizes=\"100px\"/><!--]--> <source type=\"image/webp\" srcset=\"https://images.humanitix.com/i/75ca2a3e-aed3-4d7b-8c51-9b035258de0d.png@responsive-100.webp 100w, https://images.humanitix.com/i/75ca2a3e-aed3-4d7b-8c51-9b035258de0d.png@responsive-250.webp 200w\" sizes=\"100px\"/> <img src=\"https://images.humanitix.com/i/75ca2a3e-aed3-4d7b-8c51-9b035258de0d.png@responsive-500.webp\" alt=\"Dave Stephens\" width=\"500\" height=\"500\" loading=\"lazy\" style=\"aspect-ratio: 500/500\" sizes=\"100px\" fetchpriority=\"auto\" class=\"svelte-uzlrqx\"/></picture><!--]--> <div class=\"details svelte-1q2qfnz\"><h3 class=\"f-heading-1 heading svelte-1q2qfnz\">Dave Stephens</h3> <!--[0--><p class=\"f-body-3 description svelte-1q2qfnz\" data-text=\"medium\">Dave Stephens first came to public attention as a performance artist. After leaving Leeds Polytechnic where he studied alongside Roger in the Fine Art department under Jeff Nuttal, Roland Miller and John Darling he joined John Bull Puncture Repair Kit and toured Britain and Europe. He teamed up with Ian Hinchliffe, Roger and others in the Matchbox Purveyors for visual and verbal tours through the absurdist imagination. Nowadays, his practise often moves between disciplines and some of his recent work combines elements of all of them. \n</p><!--]--><!----> <!--[0--><ul class=\"socials svelte-1q2qfnz\" aria-label=\"Dave Stephens's social links\"><!--[--><li><a href=\"https://www.instagram.com/davestephensart/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"svelte-1q2qfnz\"><span class=\"u-visually-hidden\">Dave Stephens's instagram</span> <!--[--><svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" aria-hidden=\"true\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\"><!----><path fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24M9.36 5.64c.68-.03.9-.04 2.64-.04s1.95 0 2.64.04c.68.03 1.14.14 1.55.3a3.14 3.14 0 0 1 1.87 1.87c.16.4.27.87.3 1.55s.04.9.04 2.64 0 1.96-.04 2.64a4.7 4.7 0 0 1-.3 1.55c-.16.42-.38.78-.73 1.14-.36.35-.72.57-1.14.73-.4.16-.87.27-1.55.3s-.9.04-2.64.04-1.96 0-2.64-.04a4.7 4.7 0 0 1-1.55-.3 3.1 3.1 0 0 1-1.14-.73 3.1 3.1 0 0 1-.73-1.14 4.7 4.7 0 0 1-.3-1.55c-.03-.68-.04-.9-.04-2.64s0-1.96.04-2.64c.03-.68.14-1.15.3-1.55A3.13 3.13 0 0 1 7.8 5.94c.4-.16.87-.27 1.55-.3Zm2.43 1.11h-.36c-1.2 0-1.43.01-2.02.04-.62.03-.96.13-1.18.22-.3.11-.52.25-.74.48-.22.22-.36.43-.48.73-.09.23-.2.57-.22 1.2-.03.67-.04.87-.04 2.58 0 1.7.01 1.9.04 2.58.03.63.13.97.22 1.2.12.29.26.5.48.73.22.22.44.36.74.48.22.08.56.19 1.18.22.68.03.88.03 2.6.03 1.7 0 1.9 0 2.58-.03.62-.03.96-.14 1.19-.22a2.149 2.149 0 0 0 1.21-1.22c.09-.22.2-.56.22-1.19.03-.67.04-.87.04-2.58 0-1.7 0-1.91-.04-2.59a3.5 3.5 0 0 0-.22-1.18c-.12-.3-.26-.52-.48-.74a2 2 0 0 0-.74-.48c-.22-.09-.56-.2-1.18-.22-.68-.03-.88-.04-2.59-.04zm2.86 1.83c0-.42.34-.76.77-.76a.77.77 0 1 1-.77.76M8.7 12a3.29 3.29 0 1 1 6.58 0 3.29 3.29 0 0 1-6.58 0m5.42 0a2.13 2.13 0 1 0-4.26 0 2.13 2.13 0 0 0 4.26 0\" clip-rule=\"evenodd\"/><!----></svg><!--]--></a></li><!--]--></ul><!--]--><!----></div></div><!--]--><!--]--><!--]--><!----></li><li data-hidden=\"true\" style=\"transition-delay: 0.6000000000000001s\" class=\"svelte-tge1a4\"><!--[0--><!--[7--><!--[-1--><div class=\"EventModuleLineup svelte-1q2qfnz\" data-layout=\"page\" data-has-image=\"true\" data-surface=\"background interactive\"><button class=\"button svelte-1q2qfnz\"><span class=\"u-visually-hidden\">More details about Richard Strange</span></button> <!--[0--><picture class=\"Image photo svelte-uzlrqx\"><!--[0--><source type=\"image/avif\" srcset=\"https://images.humanitix.com/i/b3d171b8-502b-4a38-8025-8cd90398f19e.jpg@responsive-100.avif 100w, https://images.humanitix.com/i/b3d171b8-502b-4a38-8025-8cd90398f19e.jpg@responsive-250.avif 200w\" sizes=\"100px\"/><!--]--> <source type=\"image/webp\" srcset=\"https://images.humanitix.com/i/b3d171b8-502b-4a38-8025-8cd90398f19e.jpg@responsive-100.webp 100w, https://images.humanitix.com/i/b3d171b8-502b-4a38-8025-8cd90398f19e.jpg@responsive-250.webp 200w\" sizes=\"100px\"/> <img src=\"https://images.humanitix.com/i/b3d171b8-502b-4a38-8025-8cd90398f19e.jpg@responsive-500.webp\" alt=\"Richard Strange\" width=\"500\" height=\"500\" loading=\"lazy\" style=\"aspect-ratio: 500/500\" sizes=\"100px\" fetchpriority=\"auto\" class=\"svelte-uzlrqx\"/></picture><!--]--> <div class=\"details svelte-1q2qfnz\"><h3 class=\"f-heading-1 heading svelte-1q2qfnz\">Richard Strange</h3> <!--[0--><p class=\"f-body-3 description svelte-1q2qfnz\" data-text=\"medium\">Since the Doctors of Madness was first unleashed on an uncomprehending public in 1975, Strange has been a Zelig-like figure whose presence has been felt in every corner of London’s cultural life. He founded the hugely influential mixed-media Cabaret Futura in 1980, and has subsequently worked as a musician, writer and actor on stage and screen. He’s worked with Marianne Faithfull, Gavin Bryars, Jarvis Cocker, Hal Wilner and numerous other luminaries. Movie appearances include Batman, Mona Lisa, and Gangs of New York and he recently filmed the last episode of Harry Potter.</p><!--]--><!----> <!--[0--><ul class=\"socials svelte-1q2qfnz\" aria-label=\"Richard Strange's social links\"><!--[--><li><a href=\"https://www.richardstrange.com/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"svelte-1q2qfnz\"><span class=\"u-visually-hidden\">Richard Strange's website</span> <!--[--><svg aria-hidden=\"true\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" width=\"24\" height=\"24\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M16 32a16 16 0 1 0 0-32 16 16 0 0 0 0 32Zm-1.4-13.2c.4-.4.4-1 0-1.4a3 3 0 0 1 0-4.2L18 9.6a3 3 0 0 1 5 1 3 3 0 0 1-.7 3.3l-.5.5c.3.7.4 1.6.4 2.4l1.5-1.5a5 5 0 0 0-7-7l-3.6 3.5a5 5 0 0 0 0 7c.4.4 1 .4 1.4 0Zm4.2-5.6a1 1 0 0 0-1.4 0 1 1 0 0 0 0 1.4 3 3 0 0 1 0 4.2L14 22.4a3 3 0 0 1-5-1 3 3 0 0 1 .7-3.3l.5-.5a7 7 0 0 1-.4-2.4l-1.5 1.5a5 5 0 0 0 7 7l3.6-3.5a5 5 0 0 0 0-7Z\" fill=\"currentColor\"></path></svg><!--]--></a></li><!--]--></ul><!--]--><!----></div></div><!--]--><!--]--><!--]--><!----></li><!--]--></ul> <!--[0--><!----><button data-variant=\"secondary\" data-size=\"m\" class=\"Btn  svelte-17nnmqu f-label-3\" type=\"button\" aria-disabled=\"false\" data-loading=\"false\"><!--[-1--><!--]--> <div class=\"content-container svelte-17nnmqu\"><!--[-1--><!---->Show more<!----><!--]--></div> <!--[-1--><!--]--><!----></button><!----><!--]--></div><!--]--><!--]--><!--]--></div><!--]--> <div class=\"Humanit