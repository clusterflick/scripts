,breadcrumbs:[{label:\"United Kingdom\",link:\"united-kingdom\"},{label:\"England\",link:\"gb--england\"},{label:\"London\",link:\"gb--england--london\"}]},locationCode:\"GB\",currency:\"GBP\",settings:{ticketPriceRangeDisplay:true}}],allEventsLoaded:false},host:{name:\"Etcetera Theatre Camden\",id:\"6a1d628cb2093356e4fb13ed\",userId:\"5fTM5EeINmYTQIdMw0e5re2pDGy2\",slug:\"etcetera-theatre-camden\",urls:{url:\"https://events.humanitix.com/host/etcetera-theatre-camden\",shareUrl:\"https://events.humanitix.com/host/etcetera-theatre-camden\"},logo:{imageId:\"e127d412-9b79-4ca9-983a-41d01584b9f7.png\",src:\"https://images.humanitix.com/i/e127d412-9b79-4ca9-983a-41d01584b9f7.png@original\",alt:\"Etcetera Theatre Camden's logo\",width:250,height:250},website:\"https://etceteratheatrecamden.com/\",socials:[{href:\"https://etceteratheatrecamden.com/\",network:\"Website\",name:void 0},{href:\"https://www.instagram.com/etcetera_theatre_camden/\",network:\"Instagram\",name:void 0}],followers:44,banner:{imageId:\"e215646f-ab23-4a51-a638-3a75c0807279.png\",src:\"https://images.humanitix.com/i/e215646f-ab23-4a51-a638-3a75c0807279.png@original\",alt:\"Etcetera Theatre Camden's banner\",width:1600,height:800},description:\"\\u003Cp>\\u003Cstrong>Etcetera Theatre\\u003C/strong> is an award-winning 42-seat black box theatre in the heart of Camden Town, London.\\u003C/p>\\u003Cp>Since 1986, we have supported emerging and established artists across theatre, comedy, new writing, festivals, workshops and experimental performance.\\u003C/p>\\u003Cp>We programme year-round, including Camden Fringe, VOILÀ! Theatre Festival, Women Writers Festival, Camden Horror Fest, Edinburgh Fringe previews, artist development slots and independent productions.\\u003C/p>\\u003Cp>Our venue offers:\\u003C/p>\\u003Cul>\\u003Cli>\\u003Cp>42-seat intimate theatre space\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>central Camden location\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>box office operation\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>front-of-house support\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>marketing support\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>livestreaming and hybrid event capability\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>rehearsal, workshop and performance hire\\u003C/p>\\u003C/li>\\u003C/ul>\\u003Cp>We are committed to supporting bold, independent performance and helping artists reach audiences both in the room and beyond it.\\u003C/p>\\u003Cp>\\u003Cstrong>42 seats. Unlimited reach.\\u003C/strong>\\u003C/p>\",theme:{primaryColor:\"#ffb18f\",baseColor:\"#353337\",colorScheme:\"auto\",v3ColorsCssVariables:\"\\n        @layer colours{\\n            \\n:root{\\n\\t--colorv3-LIGHT-background-base: #ffffff;--colorv3-LIGHT-background-hover: #f2f2f2;--colorv3-LIGHT-background-active: #ebebeb;--colorv3-LIGHT-background-border: #e5e5e5;--colorv3-LIGHT-background-text-high: #0d0d0d;--colorv3-LIGHT-background-text-medium: #4c4c4c;--colorv3-LIGHT-background-text-low: #707070;--colorv3-LIGHT-background-text-disabled: #999999;--colorv3-LIGHT-background-text-primary: #a55735;--colorv3-LIGHT-background-text-success: #005B35;--colorv3-LIGHT-background-text-error: #8D0013;--colorv3-LIGHT-background-text-warning: #886800;--colorv3-LIGHT-background-text-info: #243F93;--colorv3-LIGHT-raised-base: #f9f9f9;--colorv3-LIGHT-raised-hover: #ececec;--colorv3-LIGHT-raised-active: #e5e5e5;--colorv3-LIGHT-raised-border: #d6d6d6;--colorv3-LIGHT-raised-text-high: #0d0d0d;--colorv3-LIGHT-raised-text-medium: #4a4a4a;--colorv3-LIGHT-raised-text-low: #6d6d6d;--colorv3-LIGHT-raised-text-disabled: #959595;--colorv3-LIGHT-raised-text-primary: #9c4e2c;--colorv3-LIGHT-raised-text-success: #005B35;--colorv3-LIGHT-raised-text-error: #8D0013;--colorv3-LIGHT-raised-text-warning: #886800;--colorv3-LIGHT-raised-text-info: #243F93;--colorv3-LIGHT-sunken-base: #F5F4F4;--colorv3-LIGHT-sunken-hover: #e8e7e7;--colorv3-LIGHT-sunken-active: #e1e0e0;--colorv3-LIGHT-sunken-border: #c4c3c3;--colorv3-LIGHT-sunken-text-high: 