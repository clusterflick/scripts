en-hover)}\\n\\t\\t\\t[data-surface*=\\\"sunken\\\"][data-surface*=\\\"interactive\\\"]:active{background:var(--colorv3-sunken-active)}\\n\\t\\n\\n\\t[data-text=\\\"high\\\"]{color:var(--colorv3-current-text-high)}\\n\\t[data-text=\\\"medium\\\"]{color:var(--colorv3-current-text-medium)}\\n\\t[data-text=\\\"low\\\"]{color:var(--colorv3-current-text-low)}\\n\\t[data-text=\\\"disabled\\\"]{color:var(--colorv3-current-text-disabled)}\\n\\t[data-text=\\\"primary\\\"]{color:var(--colorv3-current-text-primary)}\\n\\t[data-text=\\\"success\\\"]{color:var(--colorv3-current-text-success)}\\n\\t[data-text=\\\"error\\\"]{color:var(--colorv3-current-text-error)}\\n\\t[data-text=\\\"warning\\\"]{color:var(--colorv3-current-text-warning)}\\n\\t[data-text=\\\"info\\\"]{color:var(--colorv3-current-text-info)}\\n        }\\n    \",ticketButtonText:\"Get tickets\"},settings:{afterCheckoutRedirect:void 0,allowTicketAndMerchSwaps:false,allowUserEdit:true,codesViaLinkOnly:false,disableHumanitixGTM:false,hideAddToCalendar:false,hideArtistPreviews:false,removeImpactCommunication:false,requireEmailConfirmation:false,sendTickets:true,noTicketsMessagingOption:\"none\",showTicketsLeft:false,minimumTicketsPerOrder:void 0,maximumTicketsPerOrder:void 0,seatingMapEditable:false,enableV3SeatMaps:false,waitlistEnabled:false,salesStopped:false,hideConfetti:false,mobileRequired:true},eventModules:[{component:\"richtext\",props:{title:\"Description\",content:\"\\u003Cp>A\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\"> new work of comedic historical fiction. The American Revolutionary war has been waging for several years with no end in sight. \\u003Cem>Sweet Victory, \\u003C/em>follows an American and British soldier as they spend the last days of the American Revolutionary War in the forests of New York...tolerating each other. Although they share the same name, John Smith and John Thomas couldn't be more different, but right now they only have each other. \\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">\\u003Cbr />Good People Good Theatre Co. presents the brand comedy, \\u003Cem>Sweet Victory, \\u003C/em>written and directed by Elise Marra. The play stars Emma Wilkinson Wright (\\u003Cem>The Last Days of Liz Truss\\u003C/em>) and Mikkie-dené Le Roux (\\u003Cem>Black Mirror\\u003C/em>). Art Design by Lily Rose Marra, Stage Manager Jessie Diepeveen\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">\\u003Cbr />SOCIALS : @goodpeople.goodtheatre \\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">AGE RESTRICTIONS : Advised for 12 and above (no trigger or content warnings)\\u003C/span>\\u003C/p>\"}}],artists:[],seo:{jsonSchema:[{\"@context\":\"https://schema.org\",\"@type\":\"Event\",name:\"Sweet Victory\",url:\"https://events.humanitix.com/sweet-victory\",startDate:\"2026-09-27T19:00:00+0100\",endDate:\"2026-09-27T20:00:00+0100\",location:c,eventStatus:\"https://schema.org/EventScheduled\",eventAttendanceMode:\"https://schema.org/OfflineEventAttendanceMode\",description:\"A new work of comedic historical fiction. The American Revolutionary war has been waging for several years with no end in sight. \\n\",image:\"https://images.humanitix.com/i/f44d72b1-7133-4a5e-8f0b-099f52acb8e5.png@seo-500.jpg\",offers:d},{\"@context\":\"https://schema.org\",\"@type\":\"Event\",name:\"Sweet Victory\",url:\"https://events.humanitix.com/sweet-victory\",startDate:\"2026-09-28T19:00:00+0100\",endDate:\"2026-09-28T20:00:00+0100\",location:c,eventStatus:\"https://schema.org/EventScheduled\",eventAttendanceMode:\"https://schema.org/OfflineEventAttendanceMode\",description:\"A new work of comedic historical fiction. The American Revolutionary war has been waging for several years with no end in sight. \\n\",image:\"https://images.humanitix.com/i/f44d72b1-7133-4a5e