owTicketsLeft:false,minimumTicketsPerOrder:void 0,maximumTicketsPerOrder:void 0,seatingMapEditable:false,enableV3SeatMaps:false,waitlistEnabled:false,salesStopped:false,hideConfetti:false,mobileRequired:true},eventModules:[{component:\"richtext\",props:{title:\"Description\",content:\"\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">\\u003Cstrong>The Roger Ely Experience - A Cabaret\\u003C/strong>\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">\\u003Cstrong>Thursday 12 November 2026\\u003C/strong>\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">\\u003Cstrong>20.00 \\u003C/strong>\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">\\u003Cstrong>Tickets £12.50/£10 concessions \\u003C/strong>\\u003C/span>\\u003Cspan style=\\\"--custom-color-light:#3c2e4e;--custom-color-dark:#d8caea\\\">\\u003Cstrong>*see note\\u003C/strong>\\u003C/span>\\u003Cstrong>\\u003Cbr />\\u003C/strong>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">\\u003Cstrong>An evening celebrating the life and legacy of Roger Ely \\u003C/strong>featuring short turns and films by a wide range of artists, musicians and film makers connected to Roger.  Performers include \\u003Cstrong>Liz Aggiss, Richard Strange, Phil Minton, Dave Stephens, Steve Beresford and Neil Butler \\u003C/strong>with more artists to be announced shortly.\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">Roger Ely (1952-2015) was an extraordinary and influential artist, publisher, archivist, curator, and collector. This event marks the British Library’s acquisition of Roger’s extensive and unique archive, enabling generations to come to discover a significant, rare and unrivalled history of the alternative and counterculture of the late twentieth century.  \\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">From Leeds Arts School in the 1960s, to the Brighton Contemporary Festival of Arts in the 1970s, to the Final Academy in the 1980s, to the Zap Club in the 1990s, Roger Ely was at the centre of the underground scene that influenced the art, music, film, literature, cabaret and performance that went on to change the world.  \\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">His collaborators, connections and collections are breathtaking - William Burroughs, Brion Gysin, Ian Hinchliffe, Genesis P-Orridge, John Giorno, Kathy Acker, John Maybury, Cosey Fanni Tutti, Lydia Lunch, Marc Almond, Kenneth Williams, Anne Bean. Paul Burwell, Derek Jarman and countless other luminaries and characters all feature in some way in his life and in his archive.\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">\\u003Cstrong>The Water Rats \\u003C/strong>cabaret follows a discussion at the nearby \\u003Cstrong>British Library\\u003C/strong> from 6pm to 7.30, looking at Roger’s archive and the cultural landscapes it shines a light on with \\u003Cstrong>Steve Cleary, Dave Stephens, Neil Butler, Lois Keidan, Anne Bean, Barry Miles \\u003C/strong>and\\u003Cstrong> Rob La Frenais\\u003C/strong>.  \\u003C/span>\\u003Cspan style=\\\"--custom-color-light:#1d768c;--custom-color-dark:#86d9ef\\\">GET YOUR British Library \\u003C/span>\\u003Ca rel=\\\"nofollow\\\" rel=\\\"nofollow\\\" target=\\\"_blank\\\" href=\\\"https://events.bl.uk/events/the-roger-ely-experience\\\">\\u003Cspan style=\\\"--custom-color-light:#1d768c;--custom-color-dark:#86d9ef\\\">\\u003Cstrong>TICKETS HERE\\u003C/strong>\\u003C/span>\\u003C/a>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#5c4677;--custom-color-dark:#ddc7f8\\\">\\u003Cstrong>*And NOTE:\\u003C/strong>\\u003C/span>\\u003Cspan style=\\\"--custom-color-light:#1d768c;--custom-color-dark:#86d9ef\\\">\\u003Cstrong> \\u003C/strong>\\u003C/span>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">Tickets to \\u003Cstrong>British Library\\u003C/strong> w\\u003C/span>ill \\u003Cstrong>also enable entry\\u003C/strong> to the Cabaret at the \\u003Cstrong>Water Rats,\\u003C/strong> later the same evening so \\u003Cspan style=\\\"--custom-color-light:#5c4677;--custom-color-dark:#ddc7f8\\\">\\u003Cstrong>if you're booking a British Library Ticket there is no need to book a separate Water Rats Ticket on this site.\\u003C/strong>\\u003C/span>\\u003C/p>\"}},{component:\"gallery\",props:{title:\"Gallery\",images:[{imageId:\"f09ba44d-e775-45a1-8ee1-cf7b7387691a.png\",imageType:\"webp\",width:1179,height:1069,alt:\"\"},{imageId:\"973dd59d-4c6a-486e-8f08-0d48bb63de74.png\",imageType:\"webp\",width:1068,height:815,alt:\"\"},{imageId:\"a88500e9-b13f-4515-80d4-95a310a7762d.jpg\",imageType:\"webp\",width:1768,height:1082,alt:\"\"},{imageId:\"42db12b3-cad3-4d4b-8da8-392a2827a385.jpg\",imageType:\"webp\",width:2956,height:1932,alt:\"\"},{imageId:\"9e61d9f9-9ac1-4cff-b533-8f088e8c795d.png\",imageType:\"webp\",width:1058,height:931,alt:\"\"},{imageId:\"ada84f86-f8a7-4616-8ac7-d8e324a76869.jpg\",imageType:\"webp\",width:1920,height:1380,alt:\"\"},{imageId:\"3cff8e99-ac8a-46b6-aa25-89d0b3c3dddb.jpg\",imageType:\"webp\",width:600,height:600,alt:\"\"},{imageId:\"3fae333d-b41e-486b-bcac-e5049edb422b.jpg\",imageType:\"webp\",width:2268,height:3300,alt:\"\"},{imageId:\"709fefe9-055f-4cc1-a6fd-3f28591e74da.jpg\",imageType:\"webp\",width:2535,height:4103,alt:\"\"},{imageId:\"7e46f585-3c02-406b-8b1a-833192e3261a.png\",imageType:\"webp\",width:955,height:723,alt:\"\"},{imageId:\"24d2c66c-d687-465f-ae6c-7fd34be06f5f.jpg\",imageType:\"webp\",width:1181,height:1480,alt:\"\"},{imageId:\"f32dec59-4f88-4fd8-a701-41