-nd5zk7\"><!--[0--><!----><a data-variant=\"secondary\" data-size=\"m\" class=\"Btn  svelte-17nnmqu f-label-3\" href=\"the-people-s-emergency-briefing-lm9za649/contact\" aria-disabled=\"false\" data-loading=\"false\" data-sveltekit-reload=\"true\"><!--[-1--><!--]--> <div class=\"content-container svelte-17nnmqu\"><!--[-1--><!---->Contact host<!----><!--]--></div> <!--[-1--><!--]--><!----></a><!----><!--]--> <!----><button data-variant=\"tertiary\" data-size=\"m\" class=\"Btn  svelte-17nnmqu f-label-3\" type=\"button\" aria-disabled=\"false\" data-loading=\"false\"><!--[-1--><!--]--> <div class=\"content-container svelte-17nnmqu\"><!--[-1--><!---->Follow<!----><!--]--></div> <!--[-1--><!--]--><!----></button><!----><!----> <!--[0--><!----><a data-variant=\"tertiary\" data-size=\"m\" class=\"Btn  svelte-17nnmqu f-label-3\" href=\"/host/regenerative-design-2026\" aria-disabled=\"false\" data-loading=\"false\" data-sveltekit-reload=\"true\"><!--[-1--><!--]--> <div class=\"content-container svelte-17nnmqu\"><!--[-1--><!---->View profile<!----><!--]--></div> <!--[-1--><!--]--><!----></a><!----><!--]--><!----></div><!----></div></div></header> <!--[0--><div class=\"socials svelte-1lc91aa\"><!--[0--><div class=\"SocialLinks svelte-1s84wya\"><ul class=\"svelte-1s84wya\"><!--[--><!--]--></ul></div><!--]--><!----></div><!--]--> <!--[0--><div class=\"desc svelte-1lc91aa\"><div class=\"HorizontalSplit\"><hr class=\"svelte-1tvqa1i\"/></div><!----> <div class=\"Collapsible svelte-ytl67q\" data-expanded=\"false\" style=\"--collapsed-height: 240px\" data-collapse-necessary=\"false\"><div class=\"inner\"><div class=\"text f-label-3\"><div class=\"RichContent f-body-3 svelte-jgfn07\"><!--[0--><!----><p>Regenerative Design 2026 brings the built environment together to turn ambition into action at The Building Centre in London from 1–30 October.</p><p>Opening on 1st October 2026 and running throughout October, the programme brings together leading voices to explore the ideas, innovations and challenges shaping regenerative design.</p><p>Through workshops, roundtables, case studies and panel discussions, delegates will gain practical insights into systems thinking, circularity, adaptive reuse, biodiversity, social value and participatory design.</p><!----><!--]--></div><!----></div><!----></div></div> <!--[-1--><!--]--><!----></div><!--]--></div><!--]--></aside><!----> <!--[0--><aside class=\"EventKeywords svelte-12d6v78\" aria-labelledby=\"EventKeywords-title\"><h2 class=\"f-heading-3 svelte-12d6v78\" id=\"EventKeywords-title\">Keywords</h2> <ul class=\"keywords svelte-12d6v78\"><!--[--><!--[0--><!----><li class=\"Badge f-label-2 svelte-3om6mv\" data-surface=\"sunken\" data-text=\"medium\">regenerative<!----></li><!----><!--]--><!--[0--><!----><li class=\"Badge f-label-2 svelte-3om6mv\" data-surface=\"sunken\" data-text=\"medium\">regenerativedesign<!----></li><!----><!--]--><!--[0--><!----><li class=\"Badge f-label-2 svelte-3om6mv\" data-surface=\"sunken\" data-text=\"medium\">climateemergency<!----></li><!----><!--]--><!--[0--><!----><li class=\"Badge f-label-2 svelte-3om6mv\" data-surface=\"sunken\" data-text=\"medium\">netzero<!----></li><!----><!--]--><!--[0--><!----><li class=\"Badge f-label-2 svelte-3om6mv\" data-surface=\"sunken\" data-text=\"medium\">climatechange<!----></li><!----><!--]--><!--[0--><!----><li class=\"Badge f-label-2 svelte-3om6mv\" data-surface=\"sunken\" data-text=\"medium\">climatedisaster<!----></li><!----><!--]--><!--[0--><!----><li class=\"Badge f-label-2 svelte-3om6mv\" data-surface=\"sunken\" data-text=\"medium\">builtenvironment<!----></li><!----><!--]--><!--]--></ul></aside><!--]--></div> <div class=\"fixedwrapper svelte-9qsyhv\" data-sticky-bottom-in-iframe=\"\"><div data-sticky-bottom-in-iframe-target=\"\"><section class=\"EventGetTickets svelte-1kcegs9\" data-surface=\"background\" data-skip-target=\"tickets\" tabindex=\"-1\" aria-labelledby=\"get-tickets-label\"><h2 id=\"get-tickets-label\" class=\"u-visually