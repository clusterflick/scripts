ce*=\\\"interactive\\\"]:hover{background:var(--colorv3-sunken-hover)}\\n\\t\\t\\t[data-surface*=\\\"sunken\\\"][data-surface*=\\\"interactive\\\"]:active{background:var(--colorv3-sunken-active)}\\n\\t\\n\\n\\t[data-text=\\\"high\\\"]{color:var(--colorv3-current-text-high)}\\n\\t[data-text=\\\"medium\\\"]{color:var(--colorv3-current-text-medium)}\\n\\t[data-text=\\\"low\\\"]{color:var(--colorv3-current-text-low)}\\n\\t[data-text=\\\"disabled\\\"]{color:var(--colorv3-current-text-disabled)}\\n\\t[data-text=\\\"primary\\\"]{color:var(--colorv3-current-text-primary)}\\n\\t[data-text=\\\"success\\\"]{color:var(--colorv3-current-text-success)}\\n\\t[data-text=\\\"error\\\"]{color:var(--colorv3-current-text-error)}\\n\\t[data-text=\\\"warning\\\"]{color:var(--colorv3-current-text-warning)}\\n\\t[data-text=\\\"info\\\"]{color:var(--colorv3-current-text-info)}\\n        }\\n    \",ticketButtonText:\"Get tickets\"},settings:{afterCheckoutRedirect:void 0,allowTicketAndMerchSwaps:false,allowUserEdit:true,codesViaLinkOnly:false,disableHumanitixGTM:false,hideAddToCalendar:false,hideArtistPreviews:false,removeImpactCommunication:false,requireEmailConfirmation:false,sendTickets:true,noTicketsMessagingOption:\"none\",showTicketsLeft:false,minimumTicketsPerOrder:void 0,maximumTicketsPerOrder:void 0,seatingMapEditable:false,enableV3SeatMaps:false,waitlistEnabled:false,salesStopped:false,hideConfetti:false,mobileRequired:true},eventModules:[{component:\"richtext\",props:{title:\"BABY YOU'LL LIVE FOREVER\",content:\"\\u003Cp>Join us for the debut performance of BABY YOU’LL LIVE FOREVER, a one-woman show written and performed by Amelia ‘Mils’ Ryan.\\u003C/p>\\u003Cp>Blending storytelling, poetry, and stand-up, this special evening invites you into a heartfelt and deeply personal performance.\\u003C/p>\\u003Cp>Doors open at 6pm for pre-show drinks, the show begins at 7pm, followed by post-show drinks, conversation, and books available until close.\\u003C/p>\\u003Cp>You can also pre-order your exclusive Baby Bundle to collect on the night. Each bundle includes a copy of the BABY YOU’LL LIVE FOREVER poetry collection, The Story of Seb + Amelia zine, and an A4 poetry print.\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>\\u003Cstrong>BABY YOU’LL LIVE FOREVER \\u003C/strong>is an unflinching one-woman show that weaves poetry, storytelling, and stand-up into a raw act of confession.\\u003C/p>\\u003Cp>At its heart is the obsessive, almost two-decade-long entanglement of Seb &amp; Amelia - equal parts intoxicating and destructive.\\u003C/p>\\u003Cp>Amelia revisits the moments that broke her, the patterns that kept her stuck, and the truth she could no longer outrun.\\u003C/p>\\u003Cp>What unfolds is a charged, intimate experience where grief collides with laughter, and vulnerability becomes power.\\u003C/p>\\u003Cp>This isn’t just another story about heartbreak—it’s about breaking the cycle and rewriting the ending.\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#202020;--custom-color-dark:#d0d0d0\\\">\\u003Cstrong>Exclusive Collector’s Baby Bundle\\u003C/strong>\\u003C/span>\\u003Cbr />\\u003Cbr />\\u003Cspan style=\\\"--custom-color-light:#202020;--custom-color-dark:#d0d0d0\\\">Take home a piece of BABY YOU’LL LIVE FOREVER with this exclusive collector’s ‘Baby Bundle’, featuring:\\u003C/span>\\u003Cbr />\\u003Cbr />\\u003Cspan style=\\\"--custom-color-light:#202020;--custom-color-dark:#d0d0d0\\\">• A first edition copy of BABY YOU’LL LIVE FOREVER\\u003C/span>\\u003Cbr />\\u003Cspan style=\\\"--custom-color-light:#202020;--custom-color-dark:#d0d0d0\\\">• The Story of Seb &amp; Amelia companion zine\\u003C/span>\\u003Cbr />\\u003Cspan style=\\\"--custom-color-light:#202020;--custom-color-dark:#d0d0d0\\\">• An exclusive signed A4 poetry print\\u003C/span>\\u003Cbr />\\u003Cbr />\\u003Cspan style=\\\"--custom-color-light:#202020;--custom-color-dark:#d0d0d0\\\">Available to pre-order for collection on the night of the debut performance.\\u003C/span>\\u003C/p>\"}}],artists:[],seo:{jsonSchema:{\"@context\":\"https://schema.org\",\"@type\":\"Event\",name:\"Fish Island Books Presents “BABY YOU’LL LIVE FOREVER\",url:\"https://events.humanitix.com/fish-island-books-presents-baby-you-ll-live-forever\",startDate:\"2026-09-29T18:00:00+0100\",endDate:\"2026-09-29T22:00:00+0100\",location:{\"@type\":\"Place\",name:\"UNLOCK\",address:{\"@type\":\"PostalAddress\",streetAddress:\"1 Monkwood Way, Fish Island, London E3 2EG, UK\",postalCode:\"E3 2EG\",addressRegion:\"England\",addressCountry:\"GB\"}},eventStatus:\"https://schema.org/EventScheduled\",eventAttendanceMode:\"https://schema.org/OfflineEventAttendanceMode\",description:\"Join us for the debut performance of BABY YOU’LL LIVE FOREVER, a one-woman show written and performed by Amelia ‘Mils’ Ryan.\",image:\"https://images.humanitix.com/i/60c84bbc-1dfa-4eae-9605-31df36f781b6@seo-500.jpg\",offers:[{\"@type\":\"AggregateOffer\",offerCount:2,priceCurrency:\"GBP\",availabilityStarts:c,availability:\"InStock\",availabilityEnds:b},{\"@type\":\"Offer\",url:\"https://events.humanitix.com/fish-island-books-presents-baby-you-ll-live-forever/tickets\",name:\"General Admission\",price:15,availability:\"InStock\",availabilityStarts:null,availabilityEnds:null,priceCurrency:\"GBP\",validFrom:null},{\"@type\":\"Offer\",url:\"https://events.humanitix.com/fish-island-books-presents-baby-you-ll-live-forever/tickets\",name:\"General Admission + Exclusive Collector’s Baby Bundle\",price:40,availability:\"InStock\",availabilityStarts:null,availabilityEnds:null,priceCurrency:\"GBP\",validFrom:null}]},title:\"Fish Island Books Presents “BABY YOU’LL LIVE FOREVER\\\"\",descriptions:{default:\"Get tickets on Humanitix - Fish Island Books Presents “BABY YOU’LL LIVE FOREVER\\\" hosted by Fish Island Books. UNLOCK, 1 Monkwood Way, Fish Island, London E3 2EG, UK. Tuesday 29th September 2026. Find event information.\",openGraph:\"Join us for the debut performance of BABY YOU’LL LIVE FORE