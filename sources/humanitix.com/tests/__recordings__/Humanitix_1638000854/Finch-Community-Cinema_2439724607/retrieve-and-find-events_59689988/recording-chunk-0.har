n\\t\\t\\t\\t--colorv3-current-text-success:var(--colorv3-raised-text-success);\\n\\t\\t\\t\\t--colorv3-current-text-error:var(--colorv3-raised-text-error);\\n\\t\\t\\t\\t--colorv3-current-text-warning:var(--colorv3-raised-text-warning);\\n\\t\\t\\t\\t--colorv3-current-text-info:var(--colorv3-raised-text-info);\\n\\t\\t\\t\\t--colorv3-current-border:var(--colorv3-raised-border);\\n\\t\\t\\t\\tbackground:var(--colorv3-raised-base);color:var(--colorv3-current-text-high);\\n\\t\\t\\t}\\n\\t\\t\\t[data-surface*=\\\"raised\\\"][data-surface*=\\\"interactive\\\"]:hover{background:var(--colorv3-raised-hover)}\\n\\t\\t\\t[data-surface*=\\\"raised\\\"][data-surface*=\\\"interactive\\\"]:active{background:var(--colorv3-raised-active)}\\n\\t\\n\\t\\n\\t\\t\\t[data-surface*=\\\"sunken\\\"]{\\n\\t\\t\\t\\t--colorv3-current-base:var(--colorv3-sunken-base);\\n\\t\\t\\t\\t--colorv3-current-hover:var(--colorv3-sunken-hover);\\n\\t\\t\\t\\t--colorv3-current-active:var(--colorv3-sunken-active);\\n\\t\\t\\t\\t--colorv3-current-text-high:var(--colorv3-sunken-text-high);\\n\\t\\t\\t\\t--colorv3-current-text-medium:var(--colorv3-sunken-text-medium);\\n\\t\\t\\t\\t--colorv3-current-text-low:var(--colorv3-sunken-text-low);\\n\\t\\t\\t\\t--colorv3-current-text-disabled:var(--colorv3-sunken-text-disabled);\\n\\t\\t\\t\\t--colorv3-current-text-primary:var(--colorv3-sunken-text-primary);\\n\\t\\t\\t\\t--colorv3-current-text-success:var(--colorv3-sunken-text-success);\\n\\t\\t\\t\\t--colorv3-current-text-error:var(--colorv3-sunken-text-error);\\n\\t\\t\\t\\t--colorv3-current-text-warning:var(--colorv3-sunken-text-warning);\\n\\t\\t\\t\\t--colorv3-current-text-info:var(--colorv3-sunken-text-info);\\n\\t\\t\\t\\t--colorv3-current-border:var(--colorv3-sunken-border);\\n\\t\\t\\t\\tbackground:var(--colorv3-sunken-base);color:var(--colorv3-current-text-high);\\n\\t\\t\\t}\\n\\t\\t\\t[data-surface*=\\\"sunken\\\"][data-surface*=\\\"interactive\\\"]:hover{background:var(--colorv3-sunken-hover)}\\n\\t\\t\\t[data-surface*=\\\"sunken\\\"][data-surface*=\\\"interactive\\\"]:active{background:var(--colorv3-sunken-active)}\\n\\t\\n\\n\\t[data-text=\\\"high\\\"]{color:var(--colorv3-current-text-high)}\\n\\t[data-text=\\\"medium\\\"]{color:var(--colorv3-current-text-medium)}\\n\\t[data-text=\\\"low\\\"]{color:var(--colorv3-current-text-low)}\\n\\t[data-text=\\\"disabled\\\"]{color:var(--colorv3-current-text-disabled)}\\n\\t[data-text=\\\"primary\\\"]{color:var(--colorv3-current-text-primary)}\\n\\t[data-text=\\\"success\\\"]{color:var(--colorv3-current-text-success)}\\n\\t[data-text=\\\"error\\\"]{color:var(--colorv3-current-text-error)}\\n\\t[data-text=\\\"warning\\\"]{color:var(--colorv3-current-text-warning)}\\n\\t[data-text=\\\"info\\\"]{color:var(--colorv3-current-text-info)}\\n        }\\n    \",ticketButtonText:\"Get tickets\"},settings:{afterCheckoutRedirect:void 0,allowTicketAndMerchSwaps:false,allowUserEdit:true,codesViaLinkOnly:false,disableHumanitixGTM:false,hideAddToCalendar:false,hideArtistPreviews:false,removeImpactCommunication:false,requireEmailConfirmation:false,sendTickets:true,noTicketsMessagingOption:\"none\",showTicketsLeft:false,minimumTicketsPerOrder:void 0,maximumTicketsPerOrder:void 0,seatingMapEditable:false,enableV3SeatMaps:false,waitlistEnabled:false,salesStopped:false,hideConfetti:false,mobileRequired:true},eventModules:[{component:\"richtext\",props:{title:\"Description\",content:\"\\u003Cp>\\u003Cem>A man who speaks in verse is either trying to sell you something or hide a body.\\u003C/em>\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>It’s 7pm and rehearsal is finished for the day. A janitor alone on stage finds himself possessed by minor Shakespearean characters unhappy with their lot in the original plays. No longer waiting in the wings, they begin to ask the question: can you achieve true agency when your life has been written already?\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>\\u003Cem>And so I thought my thought was free,\\u003C/em>\\u003C/p>\\u003Cp>\\u003Cem>But shackled so, how can it be?\\u003C/em>\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>Understudy No. 5 is a monologue cycle of possession and inversion - the perfect show for clowns, philosophers, and Shakespeare nerds alike. Across one hour, Fifth Folio Theatre’s debut production uncovers the stories taking place behind the scenes of the plays we know all too well.\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>\\u003Cem>If a jest be infinite, it hath no end. If it hath no end, there is no time for the laughter to begin. Argal, an infinite jest is entirely unfunny.\\u003C/em>\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>Written and performed by Hadrian Conyngham\\u003C/p>\\u003Cp>Directed by Warren Rusher\\u003C/p>\\u003Cp>Movement Coordination by Dan Hardwell\\u003C/p>\\u003Cp>Presented by Fifth Folio Theatre\\u003C/p>\\u003Cp>Photos by Harry Chapman\\u003C/p>\\u003Cp>Poster Design by Jonty Davies-Conyngham\\u003C/p>\\u003Cp>-----\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>\\u003Cstrong>Reviews for Understudy No. 5\\u003C/strong>\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>\\\"Shakespeare must hand his crown to Conyngham.\\\" - The Reviews Hub ⭐\\u003Cspan style=\\\"--custom-color-light:#FACADE;--custom-color-dark:#FACADE\\\">⭐⭐⭐\\u003C/span>\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>\\\"It’s a rare and joyous thing to see a creative riff on Shakespeare’s plays that is not only deeply invested in their stories but shows just as much appreciation for the language in which they are told.\\\" - Arts Review Hub ⭐\\u003Cspan style=\\\"--custom-color-light:#FACADE;--custom-color-dark:#FACADE\\\">⭐⭐⭐\\u003C/span>\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>\\\"Understudy No. 5 is an intelligent, playful and unusually thoughtful encounter with Shakespeare, strengthened by a committed solo performance from Conyngham.\\\" - Theatre Life ⭐\\u003Cspan style=\\\"--custom-color-light:#FACADE;--custom-color-dark:#FACADE\\\">⭐⭐⭐\\u003C/span>\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>“Laughter erupts from a glance alone…Physicality textures every moment; with Dan Hardwell as Movement Coordinator, the production blurs the line between mind and body in Hadrian’s psychophysical performance.” - Elementary WhatsOn\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>\\u003Ca rel=\\\"nofollow\\\" rel=\\\"nofollow\\\" target=\\\"_blank\\\" href=\\\"http://instagram.com/fifthfolio\\\">\\u003Cspan style=\\\"--custom-color-light:#FACADE;--custom-color-dark:#FACADE\\\">\\u003Cstrong>instagram.com/fifthfolio\\u003C/strong>\\u003C/span>\\u003C/a>\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>\\u003Cstrong>Recommended 14+ at audience's discretion. Content warnings: dementia, panic attacks, death.\\u003C/strong>\\u003C/p>\"}},{component:\"video\",props:{title:\"Video\",embedUrl:\"https://www.youtube.com/embed/mKBpcFDo0EA\",url:\"https://youtu.be/mKBpcFDo0EA\"}}],artists:[],seo:{jsonSchema:[{\"@context\":\"https://schema.org\",\"@type\":\"Event\",name:\"Understudy No. 5\",url:\"https://events.humanitix.com/understudy-no-5\",startDate:\"2026-10-14T19:00:00+0100\",endDate:\"2026-10-14T20:00:00+0100\",location:c,eventStatus:\"https://schema.org/EventScheduled\",eventAttendanceMode:\"https://schema.org/OfflineEventAttendanceMode\",description:\"A man who speaks in verse is either trying to sell you something or hide a body.\",image:\"https://images.humanitix.com/i/65b36a90-18b5-43ec-afcd-d36e8d582aef.png@seo-500.jpg\",offers:d},{\"@context\":\"https://schema.org\",\"@type\":\"Event\",name:\"Understudy No. 5\",url:\"https://events.humanitix.com/understudy-no-5\",startDate:\"2026-10-15T19:00:00+0100\",endDate:\"2026-10-15T20:00:00+0100\",location:c,eventStatus:\"https://schema.org/EventScheduled\",eventAttendanceMode:\"https://schema.org/OfflineEventAttendanceMode\",description:\"A man who speaks in verse is either trying to sell you something or hide a body.\",image:\"https://images.humanitix.com/i/65b36a90-18b5-43ec-afcd-d36e8d582aef.png@seo-500.jpg\",offers:d}],title:\"Understudy No. 5\",descriptions:{default:\"Get tickets o