ate</div><div aria-selected=\"false\" id=\"Input.Select.s1Thu, 15 Oct, 9pm - 10pm BST\" data-selected=\"false\" data-hovered=\"false\" data-testid=\"dropdown-option\" class=\"option svelte-152zt42\" role=\"option\" tabindex=\"0\" data-surface=\"sunken interactive\">Thu, 15 Oct, 9pm - 10pm BST</div><div aria-selected=\"false\" id=\"Input.Select.s1Fri, 16 Oct, 9pm - 10pm BST\" data-selected=\"false\" data-hovered=\"false\" data-testid=\"dropdown-option\" class=\"option svelte-152zt42\" role=\"option\" tabindex=\"0\" data-surface=\"sunken interactive\">Fri, 16 Oct, 9pm - 10pm BST</div><div aria-selected=\"false\" id=\"Input.Select.s1Sat, 17 Oct, 9pm - 10pm BST\" data-selected=\"false\" data-hovered=\"false\" data-testid=\"dropdown-option\" class=\"option svelte-152zt42\" role=\"option\" tabindex=\"0\" data-surface=\"sunken interactive\">Sat, 17 Oct, 9pm - 10pm BST</div><!--]--></div></div> <div class=\"InputError f-label-2-thin svelte-1kqu8lk\" data-text=\"error\" id=\"Input.Select.s1-error\"><!--[-1--><!---->&nbsp;<!----><!--]--></div><!----></div><!----></div><!--]--> <div class=\"link-container svelte-19p3cen\"><ul class=\"CalendarAddButtons svelte-5h8gi0\"><li class=\"svelte-5h8gi0\"><!----><button data-variant=\"secondary\" data-size=\"m\" class=\"Btn  svelte-17nnmqu f-label-3\" type=\"button\" aria-disabled=\"true\" data-loading=\"false\"><!--[0--><div class=\"right-container svelte-17nnmqu\"><!--[1--><!--[--><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 81 95\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M67.6084 91.1448C62.4393 96.1556 56.7955 95.3644 51.3627 92.9909C45.6134 90.5646 40.3388 90.4591 34.2731 92.9909C26.6777 96.2611 22.669 95.3117 18.1329 91.1448C-7.60711 64.6136 -3.80941 24.2103 25.4118 22.7335C32.5325 23.1027 37.4906 26.6366 41.6575 26.9531C47.8815 25.6872 53.8418 22.0478 60.4877 22.5225C68.4524 23.1554 74.4654 26.3202 78.4213 32.0167C61.9646 41.8802 65.8678 63.5587 80.9531 69.6245C77.9466 77.5364 74.0434 85