ts\"},settings:{afterCheckoutRedirect:void 0,allowTicketAndMerchSwaps:false,allowUserEdit:true,codesViaLinkOnly:false,disableHumanitixGTM:false,hideAddToCalendar:false,hideArtistPreviews:false,removeImpactCommunication:false,requireEmailConfirmation:false,sendTickets:true,noTicketsMessagingOption:\"none\",showTicketsLeft:false,minimumTicketsPerOrder:void 0,maximumTicketsPerOrder:void 0,seatingMapEditable:false,enableV3SeatMaps:false,waitlistEnabled:false,salesStopped:false,hideConfetti:false,mobileRequired:true},eventModules:[{component:\"richtext\",props:{title:\"Description\",content:\"\\u003Ch4>London Creative Singing presents Diva Singing Course Showcase\\u003C/h4>\\u003Cp>\\u003C/p>\\u003Cp>Join us for a special \\u003Cstrong>one-off performance celebrating passion, creativity and the joy of singing!\\u003C/strong>\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>London Creative Singing founder, singer/songwriter, musician and vocal coach \\u003Cstrong>Geeta Pearson (Belle Scar)\\u003C/strong> brings together the students completing the \\u003Cstrong>Diva Singing Course\\u003C/strong> for an exciting live showcase. Each performer will take to the stage with their \\u003Cstrong>own unique interpretation of iconic diva songs\\u003C/strong>, maybe also some originals, putting everything they’ve explored throughout the course into performance.\\u003C/p>\\u003Cp>Come and support these amazing people as they step into the spotlight, express themselves and share their passion with a live audience.\\u003C/p>\\u003Cp>\\u003Cstrong>11 December · 18:30\\u003C/strong>\\u003Cbr />\\u003Cstrong>Etcetera Theatre\\u003C/strong>\\u003C/p>\\u003Cp>One night. Unique voices. Lots of beautiful singing. \\u003Cstrong>Come and celebrate them!\\u003C/strong>\\u003C/p>\\u003Cp>\\u003Cstrong>Amy, Caroline, Jake, Annabelle, Katie, Maria, Charlotte, Leila, Faith, Jobin, Akua and Amit.\\u003C/strong>\\u003C/p>\\u003Cp>\\u003Cbr />\\u003Cbr />\\u003Ca rel=\\\"nofollow\\\" rel=\\\"nofollow\\\" target=\\\"_blank\\\" href=\\\"https://www.instagram.com/london_creative_singing)-\\\">https://www.instagram.com/london_creative_singing\\u003C/a>\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>No age restrictions\\u003C/p>\"}}],artists:[],seo:{jsonSchema:{\"@context\":\"https://schema.org\",\"@type\":\"Event\",name:\"Loncon Creative Singing Diva singing course showcase\",url:\"https://events.humanitix.com/loncon-creative-singing-diva-singing-course-showcase\",startDate:\"2026-12-11T18:30:00+0000\",endDate:\"2026-12-11T20:00:00+0000\",location:{\"@type\":\"Place\",name:\"Etcetera Theatre\",address:{\"@type\":\"PostalAddress\",streetAddress:\"265 Camden High St, London NW1 8QR, UK\",postalCode:\"NW1 8QR\",addressRegion:\"England\",addressCountry:\"GB\"}},eventStatus:\"https://schema.org/EventScheduled\",eventAttendanceMode:\"https://schema.org/OfflineEventAttendanceMode\",description:\"London Creative Singing presents Diva Singing Course Showcase\\nJoin us for a special one-off performance celebrating passion, creativity and the joy of singing!\\n\",image:\"https://images.humanitix.com/i/e8e6988f-632f-4897-bf0c-e795c79f00b0.jpg@seo-500.jpg\",offers:[{\"@type\":\"AggregateOffer\",offerCount:1,priceCurrency:\"GBP\",availabilityStarts:c,availability:\"InStock\",availabilityEnds:b},{\"@type\":\"Offer\",url:\"https://events.humanitix.com/loncon-creative-singing-diva-singing-course-showcase/tickets\",name:\"General Admission\",price:12.5,availability:\"InStock\",availabilityStarts:void 0,availabilityEnds:void 0,priceCurrency:\"GBP\",validFrom:void 0}]},title:\"Loncon Creative Singing Diva singing course showcase\",descriptions:{default:\"Get tickets on Humanitix - Loncon Creative Singing Diva singing course showcase hosted by Etcetera Theatre Camden. Etcetera Theatre, 265 Camden High St, London NW1 8QR, UK. Friday 11th December 2026. Find event information.\",openGraph:\"London Creative Singing presents Diva Singing Course Showcase\\nJoin us for a special one-off performance celebrating pass