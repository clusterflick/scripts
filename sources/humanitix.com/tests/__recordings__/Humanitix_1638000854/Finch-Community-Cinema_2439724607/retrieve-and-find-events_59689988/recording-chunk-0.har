/i/49acb934-a53a-4bf2-9d81-8f0e41d5f7e2.png@responsive-50.webp 64w, https://images.humanitix.com/i/49acb934-a53a-4bf2-9d81-8f0e41d5f7e2.png@responsive-100.webp 128w\" sizes=\"64px\"/> <img src=\"https://images.humanitix.com/i/49acb934-a53a-4bf2-9d81-8f0e41d5f7e2.png@responsive-50.webp\" alt=\"Regenerative Design 2026's logo\" width=\"64\" height=\"64\" loading=\"lazy\" style=\"aspect-ratio: 64/64\" sizes=\"64px\" fetchpriority=\"auto\" class=\"svelte-uzlrqx\"/></picture><!--]--></div> <!--[-1--><div class=\"text f-label-3 svelte-10psjnb\">Add your details to follow Regenerative Design 2026 and get alerts for new events.</div><!--]--></div> <!--[0--><div class=\"fields svelte-10psjnb\"><div class=\"firstname svelte-10psjnb\"><!--$s1--><div class=\"InputText  svelte-edfnjv\" data-testid=\"First name\"><!----><label class=\"InputLabel f-label-2 svelte-1rtr0xs\" for=\"Input.Text.s1\"><!--[-1--><span>First name</span><!--]--> <!--[0--><!--[0--><span aria-hidden=\"true\" data-text=\"low\">(required)</span><!--]--><!--]--> <!--[-1--><!--]--><!----></label><!----><!----> <!--[-1--><!--]--> <div class=\"field svelte-edfnjv\"><div class=\"border-container svelte-edfnjv\" data-surface=\"background\"><!--[-1--><!--]--> <!--[-1--><input class=\"f-body-3 svelte-edfnjv\" data-testid=\"First name-input\" id=\"Input.Text.s1\" name=\"firstname\" placeholder=\"\" aria-required=\"true\"/><!--]--> <!--[-1--><!--]--></div> <!----></div> <!--[-1--><!--]--> <div class=\"InputError f-label-2-thin svelte-1kqu8lk\" data-text=\"error\" id=\"Input.Text.s1-error\"><!--[-1--><!---->&nbsp;<!----><!--]--></div><!----></div><!----></div> <div class=\"lastname svelte-10psjnb\"><!--$s2--><div class=\"InputText  svelte-edfnjv\" data-testid=\"Last name\"><!----><label class=\"InputLabel f-label-2 svelte-1rtr0xs\" for=\"Input.Text.s2\"><!--[-1--><span>Last name</span><!--]--> <!--[0--><!--[0--><span aria-hidden=\"true\" data-text=\"low\">(required)</span><!--]--><!--]--> <!--[-1--><!--]--><!----></label>