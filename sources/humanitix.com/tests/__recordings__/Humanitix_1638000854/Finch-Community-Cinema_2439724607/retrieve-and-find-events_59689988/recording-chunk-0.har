g);\\n\\t\\t\\t\\t--colorv3-current-text-info:var(--colorv3-sunken-text-info);\\n\\t\\t\\t\\t--colorv3-current-border:var(--colorv3-sunken-border);\\n\\t\\t\\t\\tbackground:var(--colorv3-sunken-base);color:var(--colorv3-current-text-high);\\n\\t\\t\\t}\\n\\t\\t\\t[data-surface*=\\\"sunken\\\"][data-surface*=\\\"interactive\\\"]:hover{background:var(--colorv3-sunken-hover)}\\n\\t\\t\\t[data-surface*=\\\"sunken\\\"][data-surface*=\\\"interactive\\\"]:active{background:var(--colorv3-sunken-active)}\\n\\t\\n\\n\\t[data-text=\\\"high\\\"]{color:var(--colorv3-current-text-high)}\\n\\t[data-text=\\\"medium\\\"]{color:var(--colorv3-current-text-medium)}\\n\\t[data-text=\\\"low\\\"]{color:var(--colorv3-current-text-low)}\\n\\t[data-text=\\\"disabled\\\"]{color:var(--colorv3-current-text-disabled)}\\n\\t[data-text=\\\"primary\\\"]{color:var(--colorv3-current-text-primary)}\\n\\t[data-text=\\\"success\\\"]{color:var(--colorv3-current-text-success)}\\n\\t[data-text=\\\"error\\\"]{color:var(--colorv3-current-text-error)}\\n\\t[data-text=\\\"warning\\\"]{color:var(--colorv3-current-text-warning)}\\n\\t[data-text=\\\"info\\\"]{color:var(--colorv3-current-text-info)}\\n        }\\n    \",ticketButtonText:\"Get tickets\"},settings:{afterCheckoutRedirect:void 0,allowTicketAndMerchSwaps:false,allowUserEdit:true,codesViaLinkOnly:false,disableHumanitixGTM:false,hideAddToCalendar:false,hideArtistPreviews:false,removeImpactCommunication:false,requireEmailConfirmation:false,sendTickets:true,noTicketsMessagingOption:\"none\",showTicketsLeft:false,minimumTicketsPerOrder:void 0,maximumTicketsPerOrder:100,seatingMapEditable:false,enableV3SeatMaps:false,waitlistEnabled:false,salesStopped:false,hideConfetti:false,mobileRequired:true},eventModules:[{component:\"richtext\",props:{title:\"Description\",content:\"\\u003Ch4>🌟 The National Social Media Awards (NSMA 2026)\\u003C/h4>\\u003Cp>The \\u003Ca rel=\\\"nofollow\\\" rel=\\\"nofollow\\\" target=\\\"_blank\\\" href=\\\"https://nationalsocialmediaawards.co.uk/\\\">\\u003Cstrong>National Social Media Awards\\u003C/strong>\\u003C/a> is the UK’s 1st and most premier celebration of \\u003Cstrong>influencer excellence, online creativity, and digital culture\\u003C/strong>. From viral trailblazers to brand-building legends, the National Social Media Awards honour the influencers and brands shaping the future of online media.\\u003C/p>\\u003Cp>This isn’t just an awards night — it’s a full-scale \\u003Cstrong>red carpet experience\\u003C/strong>, bringing together influencers, celebrities, content creators, brands, and fans for an unforgettable evening of recognition, entertainment, and connection.\\u003C/p>\\u003Cp>🎤 \\u003Cstrong>Live performances.\\u003C/strong>\\u003Cbr />\\u003Cstrong>🏆 Unmissable moments.\\u003C/strong>\\u003Cbr />\\u003Cstrong>💫 Real-time networking with digital icons.\\u003C/strong>\\u003C/p>\\u003Cp>Whether you're a rising creator, a devoted fan, a brand wanting to stay plugged into culture, or someone who just loves the power of digital media — \\u003Cstrong>this is the event to be seen at\\u003C/strong>.\\u003C/p>\\u003Cp>🎟️ \\u003Cstrong>Buy your ticket now and be part of the UK’s most influential night in social media.\\u003C/strong>\\u003Cbr />Because if you’re part of the culture — you should be part of the celebration.\\u003C/p>\"}}],artists:[],seo:{jsonSchema:{\"@context\":\"https://schema.org\",\"@type\":\"Event\",name:\"National Social Media Awards London\",url:\"https://events.humanitix.com/nsmauk\",startDate:\"2026-10-28T18:00:00+0000\",endDate:\"2026-10-29T02:00:00+0000\",location:{\"@type\":\"Place\",name:\"The Clapham Grand\",address:{\"@type\":\"PostalAddress\",streetAddress:\"The Clapham Grand, 21-25 St John's Hl, London SW11 1TT, UK\",postalCode:\"SW11 1TT\",addressRegion:\"England\",addressCountry:\"GB\"}},eventStatus:\"https://schema.org/EventScheduled\",eventAttendanceMode:\"https://schema.org/OfflineEventAttendanceMode\",description:\"Be apart of the UK's first and big