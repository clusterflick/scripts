e:var(--colorv3-sunken-base);\\n\\t\\t\\t\\t--colorv3-current-hover:var(--colorv3-sunken-hover);\\n\\t\\t\\t\\t--colorv3-current-active:var(--colorv3-sunken-active);\\n\\t\\t\\t\\t--colorv3-current-text-high:var(--colorv3-sunken-text-high);\\n\\t\\t\\t\\t--colorv3-current-text-medium:var(--colorv3-sunken-text-medium);\\n\\t\\t\\t\\t--colorv3-current-text-low:var(--colorv3-sunken-text-low);\\n\\t\\t\\t\\t--colorv3-current-text-disabled:var(--colorv3-sunken-text-disabled);\\n\\t\\t\\t\\t--colorv3-current-text-primary:var(--colorv3-sunken-text-primary);\\n\\t\\t\\t\\t--colorv3-current-text-success:var(--colorv3-sunken-text-success);\\n\\t\\t\\t\\t--colorv3-current-text-error:var(--colorv3-sunken-text-error);\\n\\t\\t\\t\\t--colorv3-current-text-warning:var(--colorv3-sunken-text-warning);\\n\\t\\t\\t\\t--colorv3-current-text-info:var(--colorv3-sunken-text-info);\\n\\t\\t\\t\\t--colorv3-current-border:var(--colorv3-sunken-border);\\n\\t\\t\\t\\tbackground:var(--colorv3-sunken-base);color:var(--colorv3-current-text-high);\\n\\t\\t\\t}\\n\\t\\t\\t[data-surface*=\\\"sunken\\\"][data-surface*=\\\"interactive\\\"]:hover{background:var(--colorv3-sunken-hover)}\\n\\t\\t\\t[data-surface*=\\\"sunken\\\"][data-surface*=\\\"interactive\\\"]:active{background:var(--colorv3-sunken-active)}\\n\\t\\n\\n\\t[data-text=\\\"high\\\"]{color:var(--colorv3-current-text-high)}\\n\\t[data-text=\\\"medium\\\"]{color:var(--colorv3-current-text-medium)}\\n\\t[data-text=\\\"low\\\"]{color:var(--colorv3-current-text-low)}\\n\\t[data-text=\\\"disabled\\\"]{color:var(--colorv3-current-text-disabled)}\\n\\t[data-text=\\\"primary\\\"]{color:var(--colorv3-current-text-primary)}\\n\\t[data-text=\\\"success\\\"]{color:var(--colorv3-current-text-success)}\\n\\t[data-text=\\\"error\\\"]{color:var(--colorv3-current-text-error)}\\n\\t[data-text=\\\"warning\\\"]{color:var(--colorv3-current-text-warning)}\\n\\t[data-text=\\\"info\\\"]{color:var(--colorv3-current-text-info)}\\n        }\\n    \",ticketButtonText:\"Get tickets\"},settings:{afterCheckoutRedirect:void 0,allowTicketAndMerchSwaps:false,allowUserEdit:true,codesViaLinkOnly:false,disableHumanitixGTM:false,hideAddToCalendar:false,hideArtistPreviews:false,removeImpactCommunication:false,requireEmailConfirmation:false,sendTickets:true,noTicketsMessagingOption:\"none\",showTicketsLeft:false,minimumTicketsPerOrder:void 0,maximumTicketsPerOrder:void 0,seatingMapEditable:false,enableV3SeatMaps:false,waitlistEnabled:false,salesStopped:false,hideConfetti:false,mobileRequired:true},eventModules:[{component:\"richtext\",props:{title:\"Description\",content:\"\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#000000;--custom-color-dark:#d0d0d0\\\">\\u003Cem>“One of the least-known masterpieces of the screen” \\u003C/em>\\u003C/span>\\u003Cspan style=\\\"--custom-color-light:#0b0b0b;--custom-color-dark:#cecece\\\">- Pauline Kael on \\u003Cem>Ménilmontant\\u003C/em>\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#0b0b0b;--custom-color-dark:#cecece\\\">Silent Picture Show x Finch Community Cinema present: Dimitri Kirsanoff’s \\u003Cem>Ménilmontant\\u003C/em> (1926), a visually exquisite tour de force of the Parisian avant-garde.\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#0b0b0b;--custom-color-dark:#cecece\\\">Shot on the streets of the titular working-class neighbourhood for next to nothing, the film follows the fates of two orphaned sisters who, living in the wake of violent tragedy, are plagued by poverty and subject to male manipulation. Kirsanoff innovatively shuns the use of intertitles - experimenting towards a poetic, purely visual cinematic language - while lead actress Nadia Sibirskaïa (Kirsanoff’s wife and creative collaborator) is spellbinding in her naturalism.\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#0b0b0b;--custom-color-dark:#cecece\\\">The mid-length feature will be complemented by Kirsanoff’s stunning lesser-known short \\u003Cem>Brumes d'automne\\u003C/em> (1928).\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#0b0b0b;--custom-color-dark:#cecece\\\">Accompanied by live original music from acclaimed silent film pianist John Sweeney. With an introduction by event curator Ellen Cleary.\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#0b0b0b;--custom-color-dark:#cecece\\\">Tickets are £7, with 15% of all sales donated to MAP (Medical Aid for Palestinians).\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#0b0b0b;--custom-color-dark:#cecece\\\">Doors 6:30pm, Film starts 7pm.\\u003C/span>\\u003C/p>\\u003Cp>\\u003Cspan style=\\\"--custom-color-light:#0b0b0b;--custom-color-dark:#cecece\\\">Recent digital restorations courtesy FPA Classics/Lobster Films.\\u003C/span>\\u003C/p>\"}}],artists:[],seo:{jsonSchema:{\"@context\":\"https://schema.org\",\"@type\":\"Event\",name:\"Silent Picture Show presents: Ménilmontant (1926) with live score\",url:\"https://events.humanitix.com/silent-picture-show-presents-menilmontant-1926-with-live-score\",startDate:\"2026-09-26T18:30:00+0100\",endDate:\"2026-09-26T20:30:00+0100\",location:{\"@type\":\"Place\",name:\"Finch Cafe/Restaurant\",address:{\"@type\":\"PostalAddress\",streetAddress:\"12 Sidworth St, London E8 3SD, UK\",postalCode:\"E8 3SD\",addressRegion:\"England\",addressCountry:\"GB\"}},eventStatus:\"https://schema.org/EventScheduled\",eventAttendanceMode:\"https://schema.org/OfflineEventAttendanceMode\",description:\"Get tickets on Humanitix - Silent Picture Show presents: Ménilmontant (1926) with live score hosted by Finch Community Cinema . Finch Cafe/Restaurant, 12 Sidworth St, London E8 3SD, UK. Saturday 26th September 2026. Find event information.\",image:\"https://images.humanitix.com/i/17ecb029-ec95-4c8f-b865-c7859958ba98.jpeg@seo-500.jpg\",offers:[{\"@type\":\"AggregateOffer\",offerCount:2,priceCurrency:\"GBP\",availabilityStarts:c,availability:\"InStock\",avail