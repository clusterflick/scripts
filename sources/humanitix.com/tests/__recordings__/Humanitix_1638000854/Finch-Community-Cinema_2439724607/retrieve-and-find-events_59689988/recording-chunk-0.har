idth:800,height:400}},urls:{url:\"https://events.humanitix.com/kayfabe?hxchl=hex-pfl\",shareUrl:\"https://events.humanitix.com/kayfabe?hxchl=hex-pfl\",ticketsUrl:\"https://events.humanitix.com/kayfabe/tickets?hxchl=hex-pfl\",accessibilityUrl:\"https://events.humanitix.com/kayfabe/accessibility?hxchl=hex-pfl\",contactUrl:\"https://events.humanitix.com/kayfabe/contact?hxchl=hex-pfl\",appleWalletForTicketUrl:\"https://wallet.humanitix.com/get-apple-wallet-pass-for-ticket\"},dates:{displayDate:\"Thu, 8 Oct, 7pm - 8pm BST\",titleDate:\"8th October\",timeTagDate:\"2026-10-08T19:00:00+0100\"},moreDatesCount:0,location:{displayLocation:\"Etcetera Theatre 265 Camden High St, London NW1 8QR, UK\",directionsLink:\"https://www.google.com/maps/search/?api=1&query=51.5406127,-0.1443946&query_place_id=EiYyNjUgQ2FtZGVuIEhpZ2ggU3QsIExvbmRvbiBOVzEgOFFSLCBVSyIxEi8KFAoSCU8ZE53hGnZIEa4hb84xHXvJEIkCKhQKEglZ6JI24Bp2SBGRZZYs6GRimA\",address:\"265 Camden High St, London NW1 8QR, UK\",venueName:\"Etcetera Theatre\",type:\"address\",onlineInstructions:\"This event is online. The host will update the event with a meeting link, as well as instructions to attend the event.\",onlineUrl:void 0,country:\"united kingdom\",locality:\"greater london\",locale:\"265 camden high st, london nw1 8qr, uk\",latLng:\"51.5406127, -0.1443946\",displayLocationPrimary:\"Etcetera Theatre\",displayLocationSecondary:\"London, United Kingdom\",displayLocationLongForm:\"265 Camden High St, London NW1 8QR, UK\",breadcrumbs:[{label:\"United Kingdom\",link:\"united-kingdom\"},{label:\"England\",link:\"gb--england\"},{label:\"London\",link:\"gb--england--london\"}]},locationCode:\"GB\",currency:\"GBP\",settings:{ticketPriceRangeDisplay:true}}],allEventsLoaded:false},host:{name:\"Etcetera Theatre Camden\",id:\"6a1d628cb2093356e4fb13ed\",userId:\"5fTM5EeINmYTQIdMw0e5re2pDGy2\",slug:\"etcetera-theatre-camden\",urls:{url:\"https://events.humanitix.com/host/etcetera-theatre-camden\",shareUrl:\"https://events.humanitix.com/host/etcetera-theatre-camden\"},logo:{imageId:\"e127d412-9b79-4ca9-983a-41d01584b9f7.png\",src:\"https://images.humanitix.com/i/e127d412-9b79-4ca9-983a-41d01584b9f7.png@original\",alt:\"Etcetera Theatre Camden's logo\",width:250,height:250},website:\"https://etceteratheatrecamden.com/\",socials:[{href:\"https://etceteratheatrecamden.com/\",network:\"Website\",name:void 0},{href:\"https://www.instagram.com/etcetera_theatre_camden/\",network:\"Instagram\",name:void 0}],followers:44,banner:{imageId:\"e215646f-ab23-4a51-a638-3a75c0807279.png\",src:\"https://images.humanitix.com/i/e215646f-ab23-4a51-a638-3a75c0807279.png@original\",alt:\"Etcetera Theatre Camden's banner\",width:1600,height:800},description:\"\\u003Cp>\\u003Cstrong>Etcetera Theatre\\u003C/strong> is an award-winning 42-seat black box theatre in the heart of Camden Town, London.\\u003C/p>\\u003Cp>Since 1986, we have supported emerging and established artists across theatre, comedy, new writing, festivals, workshops and experimental performance.\\u003C/p>\\u003Cp>We programme year-round, including Camden Fringe, VOILÀ! Theatre Festival, Women Writers Festival, Camden Horror Fest, Edinburgh Fringe previews, artist development slots and independent productions.\\u003C/p>\\u003Cp>Our venue offers:\\u003C/p>\\u003Cul>\\u003Cli>\\u003Cp>42-seat intimate theatre space\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>central Camden location\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>box office operation\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>front-of-house support\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>marketing support\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>livestreaming and hybrid event capability\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>rehearsal, workshop and performance hire\\u003C/p>\\u003C/li>\\u003C/ul>\\u003Cp>We are committed to supporting bold, independent performance and helping artists reach audiences both in the room and beyond it.\\u003C/p>\\u003Cp>\\u003Cstrong>42 seats. Unlimited reach.\\u003C/strong>\\u003C/p>\",the