-.27 1.55-.3Zm2.43 1.11h-.36c-1.2 0-1.43.01-2.02.04-.62.03-.96.13-1.18.22-.3.11-.52.25-.74.48-.22.22-.36.43-.48.73-.09.23-.2.57-.22 1.2-.03.67-.04.87-.04 2.58 0 1.7.01 1.9.04 2.58.03.63.13.97.22 1.2.12.29.26.5.48.73.22.22.44.36.74.48.22.08.56.19 1.18.22.68.03.88.03 2.6.03 1.7 0 1.9 0 2.58-.03.62-.03.96-.14 1.19-.22a2.149 2.149 0 0 0 1.21-1.22c.09-.22.2-.56.22-1.19.03-.67.04-.87.04-2.58 0-1.7 0-1.91-.04-2.59a3.5 3.5 0 0 0-.22-1.18c-.12-.3-.26-.52-.48-.74a2 2 0 0 0-.74-.48c-.22-.09-.56-.2-1.18-.22-.68-.03-.88-.04-2.59-.04zm2.86 1.83c0-.42.34-.76.77-.76a.77.77 0 1 1-.77.76M8.7 12a3.29 3.29 0 1 1 6.58 0 3.29 3.29 0 0 1-6.58 0m5.42 0a2.13 2.13 0 1 0-4.26 0 2.13 2.13 0 0 0 4.26 0\" clip-rule=\"evenodd\"/><!----></svg><!--]--> <span class=\"label f-label-2\" data-text=\"medium\">Instagram</span></a></li><!--]--></ul></div><!--]--><!----></div><!--]--> <!--[0--><div class=\"desc svelte-1lc91aa\"><div class=\"HorizontalSplit\"><hr class=\"svelte-1tvqa1i\"/></div><!----> <div class=\"Collapsible svelte-ytl67q\" data-expanded=\"false\" style=\"--collapsed-height: 240px\" data-collapse-necessary=\"false\"><div class=\"inner\"><div class=\"text f-label-3\"><div class=\"RichContent f-body-3 svelte-jgfn07\"><!--[0--><!----><p><strong>Etcetera Theatre</strong> is an award-winning 42-seat black box theatre in the heart of Camden Town, London.</p><p>Since 1986, we have supported emerging and established artists across theatre, comedy, new writing, festivals, workshops and experimental performance.</p><p>We programme year-round, including Camden Fringe, VOILÀ! Theatre Festival, Women Writers Festival, Camden Horror Fest, Edinburgh Fringe previews, artist development slots and independent productions.</p><p>Our venue offers:</p><ul><li><p>42-seat intimate theatre space</p></li><li><p>central Camden location</p></li><li><p>box office operation</p></li><li><p>front-of-house support</p></li><li><p>marketing support</p></li><li><p>livestreaming and hybrid event capability</p></li><li><p>rehearsal, workshop and performance hire</p></li></ul><p>We are committed to supporting bold, independent performance and helping artists reach audiences both in the room and beyond it.</p><p><strong>42 seats. Unlimited reach.</strong></p><!----><!--]--></div><!----></div><!----></div></div> <!--[-1--><!--]--><!----></div><!--]--></div><!--]--></aside><!----> <!--[0--><aside class=\"EventKeywords svelte-12d6v78\" aria-labelledby=\"EventKeywords-title\"><h2 class=\"f-heading-3 svelte-12d6v78\" id=\"EventKeywords-title\">Keywords</h2> <ul class=\"keywords svelte-12d6v78\"><!--[--><!--[0--><!----><li class=\"Badge f-label-2 svelte-3om6mv\" data-surface=\"sunken\" data-text=\"medium\">theatre <!----><!----></li><!----><!--]--><!--[0--><!----><li class=\"Badge f-label-2 svelte-3om6mv\" data-surface=\"sunken\" data-text=\"medium\">camden <!----><!----></li><!----><!--]--><!--[0--><!----><li class=\"Badge f-label-2 svelte-3om6mv\" data-surface=\"sunken\" data-text=\"medium\">london <!----><!----></li><!----><!--]--><!--[0--><!----><li class=\"Badge f-label-2 svelte-3om6mv\" data-surface=\"sunken\" data-text=\"medium\">show <!----><!----></li><!----><!--]--><!--[0--><!----><li class=\"Badge f-label-2 svelte-3om6mv\" data-surface=\"sunken\" data-text=\"medium\">drama <!----><!----></li><!----><!--]--><!--]--></ul></aside><!--]--></div> <div class=\"fixedwrapper svelte-9qsyhv\" data-sticky-bottom-in-iframe=\"\"><div data-sticky-bottom-in-iframe-target=\"\"><section class=\"EventGetTickets svelte-1kcegs9\" data-surface=\"background\" data-skip-target=\"tickets\" tabindex=\"-1\" aria-labelledby=\"get-tickets-label\"><h2 id=\"get-tickets-label\" class=\"u-visually-hidden\">Get tickets</h2> <!--[-1--><!--]--> <!----><a data-variant=\"primary\" data-size=\"l\" class=\"Btn  svelte-17nnmqu f-label-3\" href=\"https://events.humanitix.com/understudy-no-5/tickets\" aria-disabled=\"false\" data-testid=\"get-tickets-btn\" data-loading=\"false\" data-sveltekit-reload=\"true\"><!--[-1--><!--