\\n\\t\\t\\t\\t--colorv3-current-border:var(--colorv3-sunken-border);\\n\\t\\t\\t\\tbackground:var(--colorv3-sunken-base);color:var(--colorv3-current-text-high);\\n\\t\\t\\t}\\n\\t\\t\\t[data-surface*=\\\"sunken\\\"][data-surface*=\\\"interactive\\\"]:hover{background:var(--colorv3-sunken-hover)}\\n\\t\\t\\t[data-surface*=\\\"sunken\\\"][data-surface*=\\\"interactive\\\"]:active{background:var(--colorv3-sunken-active)}\\n\\t\\n\\n\\t[data-text=\\\"high\\\"]{color:var(--colorv3-current-text-high)}\\n\\t[data-text=\\\"medium\\\"]{color:var(--colorv3-current-text-medium)}\\n\\t[data-text=\\\"low\\\"]{color:var(--colorv3-current-text-low)}\\n\\t[data-text=\\\"disabled\\\"]{color:var(--colorv3-current-text-disabled)}\\n\\t[data-text=\\\"primary\\\"]{color:var(--colorv3-current-text-primary)}\\n\\t[data-text=\\\"success\\\"]{color:var(--colorv3-current-text-success)}\\n\\t[data-text=\\\"error\\\"]{color:var(--colorv3-current-text-error)}\\n\\t[data-text=\\\"warning\\\"]{color:var(--colorv3-current-text-warning)}\\n\\t[data-text=\\\"info\\\"]{color:var(--colorv3-current-text-info)}\\n        }\\n    \",ticketButtonText:\"Get tickets\"},settings:{afterCheckoutRedirect:void 0,allowTicketAndMerchSwaps:false,allowUserEdit:true,codesViaLinkOnly:false,disableHumanitixGTM:false,hideAddToCalendar:false,hideArtistPreviews:false,removeImpactCommunication:false,requireEmailConfirmation:false,sendTickets:true,noTicketsMessagingOption:\"none\",showTicketsLeft:false,minimumTicketsPerOrder:void 0,maximumTicketsPerOrder:void 0,seatingMapEditable:false,enableV3SeatMaps:false,waitlistEnabled:false,salesStopped:false,hideConfetti:false,mobileRequired:true},eventModules:[{component:\"richtext\",props:{title:\"Description\",content:\"\\u003Cp>\\u003Cstrong>FRUIT SALAD\\u003C/strong>\\u003C/p>\\u003Cp>\\u003Cbr />What happens when you try to measure a life that refuses to fit the numbers? \\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>\\u003Cem>Fruit Salad\\u003C/em> is a darkly comic psychological horror solo performance following a young woman whose childhood obsession with food, numbers and rules slowly becomes something far more sinister. \\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>From fruit and calorie counts to beauty, punishment and the impossible mathematics of being “good enough”, she has learned that everything can be measured, and that every number has a consequence. \\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>As childhood memories bleed into the present, her carefully constructed logic begins to unravel, revealing the disturbing cost of trying to calculate your own worth.\\u003C/p>\\u003Cp>\\u003C/p>\\u003Cp>\\u003Cstrong>A dark, intimate and unsettling exploration of food, femininity, control and the things we learn to believe about our bodies.\\u003C/strong>\\u003C/p>\"}}],artists:[],seo:{jsonSchema:[{\"@context\":\"https://schema.org\",\"@type\":\"Event\",name:\"Fruit Salad\",url:\"https://events.humanitix.com/fruit-salad-zfrmmvwl\",startDate:\"2026-10-30T15:00:00+0000\",endDate:\"2026-10-30T16:00:00+0000\",location:c,eventStatus:\"https://schema.org/EventScheduled\",eventAttendanceMode:\"https://schema.org/OfflineEventAttendanceMode\",description:\"What happens when you try to measure a life that refuses to fit the numbers? Fruit Salad is a darkly comic psychological horror solo performance.\\n\",image:\"https://images.humanitix.com/i/c3143e25-1a9e-41c6-b720-8a0101780cb4.jpeg@seo-500.jpg\",offers:d},{\"@context\":\"https://schema.org\",\"@type\":\"Event\",name:\"Fruit Salad\",url:\"https://events.humanitix.com/fruit-salad-zfrmmvwl\",startDate:\"2026-10-31T17:00:00+0000\",endDate:\"2026-10-31T18:00:00+0000\",location:c,eventStatus:\"https://schema.org/EventScheduled\",eventAttendanceMode:\"https://schema.org/OfflineEventAttendanceMode\",description:\"What happens when you try to measure a life that refuses to fit the numbers? Fruit Salad is a darkly comic psychological horror solo performance.\\n\",image:\"https://images.humanitix.com/i/c3143e25-1a9e-41c6-b720