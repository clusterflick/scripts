id 0},{href:\"https://www.instagram.com/etcetera_theatre_camden/\",network:\"Instagram\",name:void 0}],followers:52,banner:{imageId:\"e215646f-ab23-4a51-a638-3a75c0807279.png\",src:\"https://images.humanitix.com/i/e215646f-ab23-4a51-a638-3a75c0807279.png@original\",alt:\"Etcetera Theatre Camden's banner\",width:1600,height:800},description:\"\\u003Cp>\\u003Cstrong>Etcetera Theatre\\u003C/strong> is an award-winning 42-seat black box theatre in the heart of Camden Town, London.\\u003C/p>\\u003Cp>Since 1986, we have supported emerging and established artists across theatre, comedy, new writing, festivals, workshops and experimental performance.\\u003C/p>\\u003Cp>We programme year-round, including Camden Fringe, VOILÀ! Theatre Festival, Women Writers Festival, Camden Horror Fest, Edinburgh Fringe previews, artist development slots and independent productions.\\u003C/p>\\u003Cp>Our venue offers:\\u003C/p>\\u003Cul>\\u003Cli>\\u003Cp>42-seat intimate theatre space\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>central Camden location\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>box office operation\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>front-of-house support\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>marketing support\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>livestreaming and hybrid event capability\\u003C/p>\\u003C/li>\\u003Cli>\\u003Cp>rehearsal, workshop and performance hire\\u003C/p>\\u003C/li>\\u003C/ul>\\u003Cp>We are committed to supporting bold, independent performance and helping artists reach audiences both in the room and beyond it.\\u003C/p>\\u003Cp>\\u003Cstrong>42 seats. Unlimited reach.\\u003C/strong>\\u003C/p>\",theme:{primaryColor:\"#ffb18f\",baseColor:\"#353337\",colorScheme:\"auto\",v3ColorsCssVariables:\"\\n        @layer colours{\\n            \\n:root{\\n\\t--colorv3-LIGHT-background-base: #ffffff;--colorv3-LIGHT-background-hover: #f2f2f2;--colorv3-LIGHT-background-active: #ebebeb;--colorv3-LIGHT-background-border: #e5e5e5;--colorv3-LIGHT-background-text-high: #0d0d0d