\n                  <source srcset=\"/sites/default/files/styles/freestyle_xl/public/2026-10/kingrichard.jpg?h=3fdee236&amp;itok=0NfxZ-4o 1x\" media=\"screen and (min-width: 1200px)\" type=\"image/jpeg\" width=\"599\" height=\"396\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_lg/public/2026-10/kingrichard.jpg.webp?itok=_vifJysh 1x\" media=\"(min-width: 992px)\" type=\"image/webp\" width=\"599\" height=\"396\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_md/public/2026-10/kingrichard.jpg.webp?itok=ATReHsLP 1x\" media=\"(min-width: 768px)\" type=\"image/webp\" width=\"599\" height=\"396\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_sm/public/2026-10/kingrichard.jpg.webp?itok=GEChAlc_ 1x\" media=\"(min-width: 576px)\" type=\"image/webp\" width=\"599\" height=\"396\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_xs/public/2026-10/kingrichard.jpg.webp?itok=tccX2BQZ 1x\" media=\"(min-width: 0)\" type=\"image/webp\" width=\"576\" height=\"381\"/>\n                  <img loading=\"eager\" width=\"576\" height=\"381\" src=\"/sites/default/files/styles/freestyle_xs/public/2026-10/kingrichard.jpg.webp?itok=tccX2BQZ\" alt=\"\" />\n\n  </picture>\n\n</div>\n      \n</div>\n</div>\n      \n    \n    \n    <section class=\"event_date-accordion\">\n      <div class=\"event_date-accordion__item-wrapper\">\n        <h2 id=\"event-dates-title\">\n          <noscript>Event dates</noscript>\n          <button\n            aria-controls=\"event-date-contents\"\n            aria-expanded=\"true\"\n            class=\"event_date-accordion__button\"\n            hidden\n            role=\"button\"\n          >\n            Event dates\n            <span aria-hidden=\"true\" class=\"expand\">&#x3e;</span>\n            <span aria-hidden=\"true\" class=\"collapse\">&#x3c;</span>\n          </button>\n        </h2>\n        <div class=\"event_date-accordion__contents\" id=\"event-date-contents\">\n          \n            <div class=\"field field--name-localgov-event-date field--type-date-recur field--label-hidden field__item\">  <div class=\"date-recur-date\"><time datetime=\"2026-10-29T15:30:00Z\">29 October 2026, 3.30pm</time>\nto <time datetime=\"2026-10-29T17:30:00Z\">5.30pm</time>\n</div>\n\n\n</div>\n      \n        </div>\n      </div>\n    </section>\n\n    \n    \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><p>A look at how tennis superstars Venus and Serena Williams became who they are after the coaching from their father Richard.</p>\n<p>Cert 12A</p>\n<h2 id=\"price--2\">Price</h2>\n<p>Free Event</p>\n<h2 id=\"contact--2\">Contact</h2>\n<p><a href=\"mailto:libraries@haringey.gov.uk\">libraries@haringey.gov.uk</a></p>\n<h2 id=\"date--2\">Date</h2>\n<p>29 October 2026</p>\n<h3 id=\"additional-date-and-time-information--2\">Additional date and time information</h3>\n<p>3.30pm (144min)</p></div>\n      \n  <div class=\"field field--name-localgov-event-venue field--type-entity-reference field--label-inline clearfix\">\n    <div class=\"field__label\">Venue</div>\n              <div class=\"field__item\"><a href=\"/libraries/libraries-haringey/wood-green-library\" hreflang=\"en\">Wood Green Library</a></div>\n          </div>\n\n            <div class=\"field field--name-localgov-event-location field--type-entity-reference field--label-hidden field__item\">\n<article>\n      \n  <div class=\"field field--name-location field--type-geofield field--label-visually_hidden\">\n    <div class=\"field__label visually-hidden\">location</div>\n              <div class=\"field__item\">\n  \n  <div id=\"leaflet-map-geo-entity-address-86-location\" style=\"min-width: 150px; height: 400px\"></div>\n</div>\n          </div>\n\n  <div class=\"field field--name-postal-address field--type-address field--label-above\">\n    <div class=\"field__label\">Address</div>\n              <div class=\"fi