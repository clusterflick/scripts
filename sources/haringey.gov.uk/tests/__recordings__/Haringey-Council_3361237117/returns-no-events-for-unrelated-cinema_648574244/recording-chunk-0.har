d\"}},\"user\":{\"uid\":0,\"permissionsHash\":\"0afbc10fba01175829b1681127176ccfb9e5af8183fd9e771e0c87b63df8c92e\"}}</script>\n<script src=\"/core/misc/drupalSettingsLoader.js?v=10.6.17\" data-cookieconsent=\"ignore\"></script>\n<script src=\"/modules/contrib/google_tag/js/gtag.js?tlxd5a\"></script>\n<script src=\"/modules/contrib/google_tag/js/gtm.js?tlxd5a\"></script>\n\n\n                            <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/themes/custom/lgd/assets/images/favicons/apple-touch-icon.png\">\n          <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/themes/custom/lgd/assets/images/favicons/favicon-32x32.png\">\n          <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/themes/custom/lgd/assets/images/favicons/favicon-16x16.png\">\n          <link rel=\"shortcut icon\" href=\"/themes/custom/lgd/assets/images/favicons/favicon.ico\">\n          <meta name=\"msapplication-config\" content=\"favicons/browserconfig.xml\">\n        \n                            <link rel=\"mask-icon\" href=\"/themes/custom/lgd/assets/images/favicons/safari-pinned-tab.svg\" color=\"#ffffff\">\n          <meta name=\"msapplication-TileColor\" content=\"#ffffff\">\n          <meta name=\"theme-color\" content=\"#ffffff\">\n          <link rel=\"mask-icon\" href=\"/themes/custom/lgd/assets/images/favicons/safari-pinned-tab.svg\" color=\"#ffffff\">\n          <meta name=\"msapplication-TileColor\" content=\"#ffffff\">\n          <meta name=\"theme-color\" content=\"#ffffff\">\n        </head>\n<body class=\"sticky-header no-js path-node page-node-type-localgov-event\">\n<script>\n  document.querySelector('body').classList.remove('no-js');\n</script>\n<a href=\"#main-content\" class=\"visually-hidden focusable skip-link\">\n  Skip to main content\n</a>\n<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-TR2GH5\"\n                  height=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n\n  <div class=\"dialog-off-canvas-main-canvas\" data-off-canvas-main-canvas>\n    \n\n\n\n\n\n    \n\n<header class=\"lgd-header\">\n  <div class=\"lgd-container\">\n    <div class=\"lgd-row\">\n      <div class=\"lgd-row__full\">\n        <div class=\"lgd-header__inner\">\n\n          \n  \n  \n\n  <div class=\"lgd-region lgd-region--header region region-header\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--header\">\n      \n\n<div id=\"block-lgd-localgov-sitebranding-scarfolk\" class=\"block block-system block-system-branding-block\">\n  \n    \n        <div class=\"branding\">\n      <div class=\"branding__item branding__item--logo\">\n        <a href=\"/\" rel=\"home\" class=\"branding__logo\">\n          <img src=\"/sites/default/files/haringey-logo-bhm-207x81px.png\" alt=\"Haringey council logo: home\" />\n        </a>\n      </div>\n    </div>\n    </div>\n\n    </div>\n\n    \n  </div>\n\n\n                                  <div class=\"lgd-header__toggles\">\n                              <button\n                  class=\"lgd-header__toggle lgd-header__toggle--secondary\"\n                  data-target=\"lgd-header__nav--secondary\"\n                  aria-controls=\"lgd-header__nav--secondary\"\n                  aria-expanded=\"false\"\n                  aria-label=\"Toggle services menu\"\n                >\n                  <span class=\"lgd-header__toggle-text lgd-header__toggle-text--secondary\">Services</span>\n                  <span class=\"lgd-header__toggle-icon lgd-header__toggle-icon--secondary\"></span>\n                </button>\n              \n                              <button\n                  class=\"lgd-header__toggle lgd-header__toggle--primary\"\n                  data-target=\"lgd-header__nav--primary\"\n                  aria-controls=\"lgd-header__nav--primary\"\n                  aria-expanded=\"false\"\n                  aria-label=\"Toggle Primary Navigation\"\n                >\n                  <span class=\"lgd-header__toggle-text lgd-header__toggle-text--primary\">Menu</span>\n                  <span class=\"lgd-header__toggle-icon lgd-header__toggle-icon--primary\"></span>\n                </button>\n                          </div>\n\n                          <div id=\"lgd-header__nav--primary\" class=\"lgd-header__nav lgd-header__nav--primary\">\n                                  \n  \n  \n\n  <div class=\"lgd-region lgd-region--primary-menu region region-primary-menu\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--primary-menu\">\n      \n      \n  \n\n<nav aria-labelledby=\"block-mainnavigation-menu\" id=\"block-mainnavigation\" class=\"block block-menu navigation navigation--main\">\n            \n  <h2 class=\"visually-hidden\" id=\"block-mainnavigation-menu\">Main navigation</h2>\n  \n\n        \n      \n        \n    \n            <ul class=\"menu menu--main\">\n                    <li class=\"menu-item\">\n        <button aria-controls=\"lgd-header__nav--secondary\" aria-label=\"Toggle Services menu\" class=\"lgd-header__toggle lgd-header__toggle--secondary\" data-target=\"lgd-header__nav--secondary\" type=\"button\">Services</button>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"/news\" data-drupal-link-system-path=\"node/9\">News</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"/whats-on\" data-drupal-link-system-path=\"node/2178\">What&#039;s on</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"https://my.haringey.gov.uk/\">Find my nearest</a>\n              </li>\n        </ul>\n  \n\n\n  </nav>\n\n    </div>\n\n    \n  </div>\n\n                \n                                  \n  \n  \n\n  <div class=\"lgd-region lgd-region--search region region-search\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--search\">\n      \n\n\n\n<div class=\"search-block-form block block-search block-search-form-block