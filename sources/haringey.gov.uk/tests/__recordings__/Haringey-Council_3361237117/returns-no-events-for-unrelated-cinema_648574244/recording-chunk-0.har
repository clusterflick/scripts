f7cb666&amp;itok=GSbB1VF6 1x\" media=\"screen and (min-width: 1200px)\" type=\"image/jpeg\" width=\"599\" height=\"394\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_lg/public/2026-10/ganja-and-hess.jpg.webp?itok=cSrsXCEc 1x\" media=\"(min-width: 992px)\" type=\"image/webp\" width=\"599\" height=\"394\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_md/public/2026-10/ganja-and-hess.jpg.webp?itok=PSA2nqqz 1x\" media=\"(min-width: 768px)\" type=\"image/webp\" width=\"599\" height=\"394\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_sm/public/2026-10/ganja-and-hess.jpg.webp?itok=89_50mD0 1x\" media=\"(min-width: 576px)\" type=\"image/webp\" width=\"599\" height=\"394\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_xs/public/2026-10/ganja-and-hess.jpg.webp?itok=0yG6TvPA 1x\" media=\"(min-width: 0)\" type=\"image/webp\" width=\"576\" height=\"379\"/>\n                  <img loading=\"eager\" width=\"576\" height=\"379\" src=\"/sites/default/files/styles/freestyle_xs/public/2026-10/ganja-and-hess.jpg.webp?itok=0yG6TvPA\" alt=\"\" />\n\n  </picture>\n\n</div>\n      \n</div>\n</div>\n      \n    \n    \n    <section class=\"event_date-accordion\">\n      <div class=\"event_date-accordion__item-wrapper\">\n        <h2 id=\"event-dates-title\">\n          <noscript>Event dates</noscript>\n          <button\n            aria-controls=\"event-date-contents\"\n            aria-expanded=\"true\"\n            class=\"event_date-accordion__button\"\n            hidden\n            role=\"button\"\n          >\n            Event dates\n            <span aria-hidden=\"true\" class=\"expand\">&#x3e;</span>\n            <span aria-hidden=\"true\" class=\"collapse\">&#x3c;</span>\n          </button>\n        </h2>\n        <div class=\"event_date-accordion__contents\" id=\"event-date-contents\">\n          \n            <div class=\"field field--name-localgov-event-date field--type-date-recur field--label-hidden field__item\">  <div class=\"date-recur-date\"><time datetime=\"2026-10-27T16:30:00Z\">27 October 2026, 4.30pm</time>\nto <time datetime=\"2026-10-27T18:30:00Z\">6.30pm</time>\n</div>\n\n\n</div>\n      \n        </div>\n      </div>\n    </section>\n\n    \n    \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><p>After being stabbed with an ancient, germ-infested knife, a doctor's assistant finds himself with an insatiable desire for blood.</p>\n<p>Cert. 18</p>\n<h2 id=\"price--2\">Price</h2>\n<p>Free Event</p>\n<h2 id=\"contact--2\">Contact</h2>\n<p><a href=\"mailto:libraries@haringey.gov.uk\">libraries@haringey.gov.uk</a></p>\n<h2 id=\"date--2\">Date</h2>\n<p>27 October 2026</p>\n<h3 id=\"additional-date-and-time-information--2\">Additional date and time information</h3>\n<p>4.30pm (112min)</p></div>\n      \n  <div class=\"field field--name-localgov-event-venue field--type-entity-reference field--label-inline clearfix\">\n    <div class=\"field__label\">Venue</div>\n              <div class=\"field__item\"><a href=\"/libraries/libraries-haringey/hornsey-library\" hreflang=\"en\">Hornsey Library</a></div>\n          </div>\n\n            <div class=\"field field--name-localgov-event-location field--type-entity-reference field--label-hidden field__item\">\n<article>\n      \n  <div class=\"field field--name-location field--type-geofield field--label-visually_hidden\">\n    <div class=\"field__label visually-hidden\">location</div>\n              <div class=\"field__item\">\n  \n  <div id=\"leaflet-map-geo-entity-address-90-location\" style=\"min-width: 150px; height: 400px\"></div>\n</div>\n          </div>\n\n  <div class=\"field field--name-postal-address field--type-address field--label-above\">\n    <div class=\"field__label\">Address</div>\n              <div class=\"field__item\"><p class=\"address\" translate=\"no\"><span class=\"address-line1\">Haringey Park</span><br>\n<span class=\"locality\">Hornsey</span><br>\n<span class=\"postal-code\">N8 9JA</span><br>\n<span class=\"country\">United Kingdom</span></p></div>\n          </div>\n  </article>\n</div>\n      \n      <div class=\"field field--name-field-localgov-event-audience field--type-entity-reference field--label-hidden field__items\">\n              <div class=\"field__item\"><a href=\"/taxonomy/term/678\" hreflang=\"en\">BHH 365+</a></div>\n              <div class=\"field__item\"><a href=\"/taxonomy/term/2625\" hreflang=\"en\">BHH 365+ Film screenings</a></div>\n          </div>\n  \n\n  </div>\n\n</article>\n\n</div>\n\n  </div>\n\n    </div>\n\n    \n  </div>\n\n                </div>\n\n  \n      \n  \n  \n\n  <div class=\"lgd-region lgd-region--content-last region region-content-last\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--content-last\">\n      \n\n<div onsubmit=\"return false\" class=\"hlbc-feedback-form block block-hlbc-feedback block-feedback-block\" data-drupal-selector=\"hlbc-feedback-form\" id=\"block-lgd-feedbackblock\">\n  \n    \n      <form data-action=\"/events/film-screening-ganja-hess-1973\" class=\"antibot\" action=\"/antibot\" method=\"post\" id=\"hlbc-feedback-form\" accept-charset=\"UTF-8\">\n  <noscript>\n  <div class=\"antibot-no-js antibot-message antibot-message-warning\">You must have JavaScript enabled to use this form.</div>\n</noscript>\n<div class=\"hlbc-feedback-wrapper\"><div style=\"display:block;\" data-drupal-selector=\"edit-hlbc-feedback\" id=\"edit-hlbc-feedback\" class=\"js-form-wrapper form-wrapper\"><span class=\"hlbc-feedback-fbq\">Was this page useful?</span><input data-drupal-selector=\"edit-butyes\" data-disable-refocus=\"true\" type=\"submit\" id=\"edit-butyes\" name=\"op\" value=\"Yes\" class=\"button js-form-submit form-submit\" />\n<input data-drupal-selector=\"edit-butno\" data-disable-refocus=\"true\" type=\"submit\" id=\"edit-butno\" name=\"op\" value=\"No\" class=\"button js-form-submi