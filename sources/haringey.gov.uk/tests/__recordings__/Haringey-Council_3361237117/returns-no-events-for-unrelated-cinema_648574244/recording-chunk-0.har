  <li class=\"menu-item\">\n        <a href=\"/children-young-people-families\" data-drupal-link-system-path=\"node/4080\">Children, young people and families</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"/streets-roads-travel\" data-drupal-link-system-path=\"node/639\">Streets, roads and travel</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"/health-wellbeing\" data-drupal-link-system-path=\"node/2652\">Health and wellbeing</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"/environment\" data-drupal-link-system-path=\"node/456\">Environment</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"/community-support-safety\" data-drupal-link-system-path=\"node/988\">Community support and safety</a>\n              </li>\n                <li class=\"menu-item\">\n        <a href=\"/placemaking-community-development\" data-drupal-link-system-path=\"node/4930\">Regeneration and placemaking</a>\n              </li>\n        </ul>\n  \n\n\n  </nav>\n\n    </div>\n\n    \n  </div>\n\n    </div>\n  </header>\n\n\n  \n  \n  \n\n  <div class=\"lgd-region lgd-region--breadcrumb region region-breadcrumb\">\n\n          <div class=\"lgd-container padding-horizontal\">\n    \n    <div class=\"lgd-region__inner lgd-region__inner--breadcrumb\">\n      \n\n<div id=\"block-lgd-localgov-breadcrumbs-scarfolk\" class=\"block block-system block-system-breadcrumb-block\">\n  \n    \n      \n  \n\n  <nav class=\"breadcrumbs\" aria-labelledby=\"system-breadcrumbs\">\n    <h2 id=\"system-breadcrumbs\" class=\"visually-hidden\">Breadcrumbs</h2>\n    <ol class=\"breadcrumbs__list\">\n                        <li class=\"breadcrumbs__item\">\n                        <a class=\"breadcrumbs__link\" href=\"/\">Home</a>\n          </li>\n                \n                        <li class=\"breadcrumbs__item\">\n                          \n\n\n<span aria-hidden=\"true\" class=\"lgd-icon lgd-icon lgd-icon--breadcrumb\">\n  <?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"no\"?>\n<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"20\" viewBox=\"0 0 10 20\" version=\"1.1\">\n  <path d=\"m 1.2792969,1.2792969 -1.27734377,1.2792969 7.43749997,7.4375 h 2.5566407 z m 0,17.4414061 -1.27734377,-1.279297 7.43749997,-7.4375 h 2.5566407 z\"/>\n</svg>\n</span>                        <a class=\"breadcrumbs__link\" href=\"/events\">Events</a>\n          </li>\n                \n          </ol>\n  </nav>\n\n  </div>\n\n    </div>\n\n          </div>\n    \n  </div>\n\n\n  \n  \n  \n\n  <div class=\"lgd-region lgd-region--messages region region-messages\">\n\n          <div class=\"lgd-container padding-horizontal\">\n    \n    <div class=\"lgd-region__inner lgd-region__inner--messages\">\n      <div data-drupal-messages-fallback class=\"hidden\"></div>\n\n    </div>\n\n          </div>\n    \n  </div>\n\n\n\n<main class=\"main\" id=\"main-content\"> \n      \n  \n  \n\n  <div class=\"lgd-region lgd-region--content-top region region-content-top\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--content-top\">\n      \n\n<div id=\"block-lgd-localgov-page-header-block-scarfolk\" class=\"block block-localgov-core block-localgov-page-header-block\">\n  \n    \n      \n  \n\n\n  <div class=\"lgd-page-title-block\">\n\n          <h1 class=\"lgd-page-title-block__title\">Free film screening in Harringay – People&#039;s Emergency Briefing</h1>\n    \n                  <p></p>\n\n          \n  </div>\n\n  </div>\n\n    </div>\n\n    \n  </div>\n\n  \n  <div class=\"lgd-content-section\">\n                                    \n          \n  \n  \n\n  <div class=\"lgd-region lgd-region--content region region-content\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--content\">\n      \n\n<div id=\"block-lgd-localgov-mainpagecontent-scarfolk--2\" class=\"block block-system block-system-main-block\">\n  \n    \n        \n\n<article class=\"node node--type-localgov-event node--promoted node--view-mode-full\">\n\n  \n    \n\n  \n  <div class=\"node__content\">\n        \n          \n            <div class=\"field field--name-localgov-event-image field--type-entity-reference field--label-hidden field__item\"><div>\n  \n  \n            <div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\">    <picture>\n                  <source srcset=\"/sites/default/files/styles/freestyle_xl/public/2026-09/whatsapp-image-2026-09-28-at-18.12.43.jpg?itok=A0zjnuMf 1x\" media=\"screen and (min-width: 1200px)\" type=\"image/jpeg\" width=\"400\" height=\"500\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_lg/public/2026-09/whatsapp-image-2026-09-28-at-18.12.43.jpg.webp?itok=Lbr4yZ24 1x\" media=\"(min-width: 992px)\" type=\"image/webp\" width=\"400\" height=\"500\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_md/public/2026-09/whatsapp-image-2026-09-28-at-18.12.43.jpg.webp?itok=4u05HjY_ 1x\" media=\"(min-width: 768px)\" type=\"image/webp\" width=\"400\" height=\"500\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_sm/public/2026-09/whatsapp-image-2026-09-28-at-18.12.43.jpg.webp?itok=g_569MT4 1x\" media=\"(min-width: 576px)\" type=\"image/webp\" width=\"400\" height=\"500\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_xs/public/2026-09/whatsapp-image-2026-09-28-at-18.12.43.jpg.webp?itok=IQ-H7Js0 1x\" media=\"(min-width: 0)\" type=\"image/webp\" width=\"400\" height=\"500\"/>\n                  <img loading=\"eager\" width=\"400\" height=\"500\" src=\"/sites/default/files/styles/freestyle_xs/public/2026-09/whatsapp-image-2026-09-28-at-18.12.43.jpg.webp?itok=IQ-H7Js0\" alt=\"\" />\n\n  </picture>\n\n</div>\n      \n</div>\n</div>\n      \n    \n    \n    <section class=\"event_date-accordion\">\n      <div class=\"event_date-accordion__item-wrapper\">\n        <h2 id=\"event-dates-title\">\n          <noscript>Event dates</noscript>\n          <button\n            aria-controls=\"event-date-contents\"\n            aria-expanded=\"true\"\n            class=\"event_date-accordion__button\"\n            hidden\n            role=\"button\"\n          >\n            Event dates\n            <span aria-hidden=\"true\" class=\"expand\">&#x3e;</span>\n            <span aria-hidden=\"true\" class=\"collapse\">&#x3c;</span>\n          </button>\n        </h2>\n        <div class=\"event_date-accordion__contents\" id=\"event-date-contents\">\n          \n            <div class=\"field field--name-localgov-event-date field--type-date-recur field--label-hidden field__item\">  <div class=\"date-recur-date\"><time datetime=\"2026-10-07T18:30:00Z\">7 October 2026, 6.30pm</time>\nto <time datetime=\"2026-10-07T21:00:00Z\">9.00pm</time>\n</div>\n\n\n</div>\n      \n        </div>\n      </div>\n    </section>\n\n    \n    \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><p>🚩 PEOPLE'S EMERGENCY BRIEFING 🚩</p>\n<p>What do the changing climate and decline in nature really mean for everyday life in the UK?</p>\n<p>This FREE community film screening of the People’s Emergency Briefing includes experts explaining the impact on:</p>\n<ul>\n<li>Extreme weather</li>\n<li>Food security</li>\n<li>Health</li>\n<li>Cost of living</li>\n</ul>\n<p>This event is open to everyone, and the film will be followed by a facilitated group discussion, including how to be part of the solutions, collectively and individually.</p>\n<p><a class=\"external-link\" href=\"https://www.tickettailor.com/events/haringeypeb/2428999\">Book your place at Ticket Tailor</a>&nbsp;</p>\n<p>Come away feeling informed and empowered to join with others in taking action.</p>\n<h2 id=\"price--2\">Price</h2>\n<p>Free</p>\n<h2 id=\"contact--2\">Contact</h2>\n<p>Email <a href=\"mailto:xrharingey@protonmail.com\">xrharingey@protonmail.com</a></p>\n<h2 id=\"date-and-time--2\">Date and time</h2>\n<p>Wednesday 7 October 2026, 6.30pm to 9pm</p>\n<h2 id=\"location--2\">Location</h2></div>\n      \n  <div class=\"field field--name-localgov-event-venue field--type-entity-reference field--label-inline clearfix\">\n    <div class=\"field__label\">Venue</div>\n              <div class=\"field__item\"><a href=\"/adult-social-care/adult-social-care-directory/kurdish-community-centre\" hreflang=\"en\">Kurdish Community Centre</a></div>\n          </div>\n\n            <div class=\"field field--name-localgov-event-location field--type-entity-reference field--label-hidden field__item\">\n<article>\n      \n  <div class=\"field field--name-location field--type-geofield field--label-visually_hidden\">\n    <div class=\"field__label visually-hidden\">location</div>\n              <div class=\"field__item\">\n  \n  <div id=\"leaflet-map-geo-entity-address-128-location\" style=\"min-width: 150px; height: 400px\"></div>\n</div>\n          </div>\n\n  <div class=\"field field--name-postal-address field--type-address field--label-above\">\n    <div class=\"field__label\">Address</div>\n              <div class=\"field__item\"><p class=\"address\" translate=\"no\"><span class=\"organization\">Kurdish Community Centre</span><br>\n<span class=\"address-line1\">11 Portland Gardens</span><br>\n<span class=\"locality\">London</span><br>\n<span class=\"postal-code\">N4 1HU</span><br>\n<span class=\"country\">United Kingdom</span></p></div>\n          </div>\n  </article>\n</div>\n      \n\n  </div>\n\n</article>\n\n<div class=\"event__related lgd-container\">\n  <h2>Related events</h2>\n  <div class=\"views-element-container\"><div class=\"view view-localgov-events-listing view-id-localgov_events_listing view-display-id-related js-view-dom-id-bbbad813565e7a1bd64608530194d1ae2695d6bb0c9a61f0d27dfd8a1af9d427\">\n  \n    \n      \n      <div class=\"view-content\">\n          <div class=\"views-row\"><div class=\"views-field views-field-nothing-1\"><span class=\"field-content\"><article role=\"article\" class=\"contextual-region node node--type-localgov-event node--view-mode-teaser event-teaser\" data-clickable>\n  <div class=\"event-teaser__image\">\n  <div>\n  \n      \n                  \n                  <img loading=\"eager\" width=\"600\" height=\"600\" src=\"/sites/default/files/styles/square_medium/public/2026-10/stuart-hall.jpg.webp?itok=Xj8fW414\" alt=\"\" />\n\n  \n\n\n</div>\n\n</div>\n  <div class=\"event-teaser__content\">\n    <div class=\"event-teaser__metadata\">\n  6 October 2026, 5.00pm to 7.00pm</div> \n    <h2 class=\"event-teaser__title\">\n  <a href=\"/events/film-screening-stuart-hall-project-2013\" hreflang=\"en\">Film Screening: The Stuart Hall Project (2013)</a> \n </h2>\n    <div class=\"event-teaser__body\">\n  <p>Stuart Hall is one of the most influential and esteemed cultural theorists of a generation.</p>\n</div> \n  </div>\n</article></span></div></div>\n    <div class=\"views-row\"><div class=\"views-field views-field-nothing-1\"><span class=\"field-content\"><article role=\"article\" class=\"contextual-region node node--type-localgov-event node--view-mode-teaser event-teaser\" data-clickable>\n  <div class=\"event-teaser__image\">\n  <div>\n  \n      \n                  \n                  <img loading=\"eager\" width=\"600\" height=\"600\" src=\"/sites/default/files/styles/square_medium/public/2026-10/mandela.jpg.webp?itok=kFqus17j\" alt=\"\" />\n\n  \n\n\n</div>\n\n</div>\n  <div class=\"event-teaser__content\">\n    <div class=\"event-teaser__metadata\">\n  7 October 2026, 2.00pm to 4.00pm</div> \n    <h2 class=\"event-teaser__title\">\n  <a href=\"/events/film-screening-mandela-long-walk-to-freedom-2013\" hreflang=\"en\">Film Screening: Mandela: Long Walk to Freedom (2013)</a> \n </h2>\n    <div class=\"event-teaser__body\">\n  <p>A chronicle of Nelson Mandela's life journey from his childhood in a rural village through to his inauguration as the first democratically elected </p>\n</div> \n  </div>\n</article></span></div></div>\n    <div class=\"views-row\"><div class=\"views-field views-field-nothing-1\"><span class=\"field-content\"><article role=\"article\" class=\"contextual-region node node--type-localgov-event node--view-mode-teaser event-teaser\" data-clickable>\n  <div class=\"event-teaser__image\">\n  <div>\n  \n      \n                  \n                  <img loading=\"eager\" width=\"600\" height=\"600\" src=\"/sites/default/files/styles/square_medium/public/2026-10/to-sir.jpg.webp?itok=3ehXztg6\" alt=\"\" />\n\n  \n\n\n</div>\n\n</div>\n  <div class=\"event-teaser__content\">\n    <div class=\"event-teaser__metadata\">\n  8 October 2026, 3.30pm to 5.30pm</div> \n    <h2 class=\"event-teaser__title\">\n  <a href=\"/events/film-screening-to-sir-with-love-1967\" hreflang=\"en\">Film Screening: To Sir, with Love (1967)</a> \n </h2>\n    <div class=\"event-teaser__body\">\n  <p>An idealistic black teacher takes on a temporary position teaching a group of rambunctious white high school students.</p>\n<p>Cert PG</p>\n</div> \n  </div>\n</article></span></div></div>\n    <div class=\"views-row\"><div class=\"views-field views-field-nothing-1\"><span class=\"field-content\"><article role=\"article\" class=\"contextual-region node node--type-localgov-event node--view-mode-teaser event-teaser\" data-clickable>\n  <div class=\"event-teaser__image\">\n  <div>\n  \n      \n                  \n                  <img loading=\"eager\" width=\"600\" height=\"600\" src=\"/sites/default/files/styles/square_medium/public/2026-09/screenshot-2026-09-30-092201.png.webp?itok=FNgVC4Mg\" alt=\"\" />\n\n  \n\n\n</div>\n\n</div>\n  <div class=\"event-teaser__content\">\n    <div class=\"event-teaser__metadata\">\n  9 October 2026, 12.00pm to 4.00pm</div> \n    <h2 class=\"event-teaser__title\">\n  <a href=\"/events/creative-arts-space\" hreflang=\"en\">Creative Arts Space </a> \n </h2>\n    <div class=\"event-teaser__body\">\n  <p>The Creative Art Space is a welcoming, recovery-focused community space bringing people together through creativity, connection and shared ideas.</p>\n</div> \n  </div>\n</article></span></div></div>\n\n    </div>\n  \n          </div>\n</div>\n\n</div>\n\n  </div>\n\n    </div>\n\n    \n  </div>\n\n                </div>\n\n  \n      \n  \n  \n\n  <div class=\"lgd-region lgd-region--content-last region region-content-last\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--content-last\">\n      \n\n<div onsubmit=\"return false\" class=\"hlbc-feedback-form block block-hlbc-feedback block-feedback-block\" data-drupal-selector=\"hlbc-feedback-form\" id=\"block-lgd-feedbackblock\">\n  \n    \n      <form data-action=\"/events/free-film-screening-harringay-peoples-emergency-briefing\" class=\"antibot\" action=\"/antibot\" method=\"post\" id=\"hlbc-feedback-form\" accept-charset=\"UTF-8\">\n  <noscript>\n  <div class=\"antibot-no-js antibot-message antibot-message-warning\">You must have JavaScript enabled to use this form.</div>\n</noscript>\n<div class=\"hlbc-feedback-wrapper\"><div style=\"display:block;\" data-drupal-selector=\"edit-hlbc-feedback\" id=\"edit-hlbc-feedback\" class=\"js-form-wrapper form-wrapper\"><span class=\"hlbc-feedback-fbq\">Was this page useful?</span><input data-drupal-selector=\"edit-butyes\" data-disable-refocus=\"true\" type=\"submit\" id=\"edit-butyes\" name=\"op\" value=\"Yes\" class=\"button js-form-submit form-submit\" />\n<input data-drupal-selector=\"edit-butno\" data-disable-refocus=\"true\" type=\"submit\" id=\"edit-butno\" name=\"op\" value=\"No\" class=\"button js-form-submit form-submit\" />\n</div>\n</div>\n\n<div class=\"js-form-item form-item js-form-type-textfield form-item-hlbc-feedback-email js-form-item-hlbc-feedback-email\">\n      <label for=\"edit-hlbc-feedback-email\">Leave this field empty</label>\n          <input data-drupal-selector=\"edit-hlbc-feedback-email\" typ