ww.w3.org/2000/svg\" width=\"10\" height=\"20\" viewBox=\"0 0 10 20\" version=\"1.1\">\n  <path d=\"m 1.2792969,1.2792969 -1.27734377,1.2792969 7.43749997,7.4375 h 2.5566407 z m 0,17.4414061 -1.27734377,-1.279297 7.43749997,-7.4375 h 2.5566407 z\"/>\n</svg>\n</span>                        <a class=\"breadcrumbs__link\" href=\"/events\">Events</a>\n          </li>\n                \n          </ol>\n  </nav>\n\n  </div>\n\n    </div>\n\n          </div>\n    \n  </div>\n\n\n  \n  \n  \n\n  <div class=\"lgd-region lgd-region--messages region region-messages\">\n\n          <div class=\"lgd-container padding-horizontal\">\n    \n    <div class=\"lgd-region__inner lgd-region__inner--messages\">\n      <div data-drupal-messages-fallback class=\"hidden\"></div>\n\n    </div>\n\n          </div>\n    \n  </div>\n\n\n\n<main class=\"main\" id=\"main-content\"> \n      \n  \n  \n\n  <div class=\"lgd-region lgd-region--content-top region region-content-top\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--content-top\">\n      \n\n<div id=\"block-lgd-localgov-page-header-block-scarfolk\" class=\"block block-localgov-core block-localgov-page-header-block\">\n  \n    \n      \n  \n\n\n  <div class=\"lgd-page-title-block\">\n\n          <h1 class=\"lgd-page-title-block__title\">Creative Arts Space </h1>\n    \n                  <p></p>\n\n          \n  </div>\n\n  </div>\n\n    </div>\n\n    \n  </div>\n\n  \n  <div class=\"lgd-content-section\">\n                                    \n          \n  \n  \n\n  <div class=\"lgd-region lgd-region--content region region-content\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--content\">\n      \n\n<div id=\"block-lgd-localgov-mainpagecontent-scarfolk--2\" class=\"block block-system block-system-main-block\">\n  \n    \n        \n\n<article class=\"node node--type-localgov-event node--promoted node--view-mode-full\">\n\n  \n    \n\n  \n  <div class=\"node__content\">\n        \n          \n            <div class=\"field field--name-localgov-event-image field--type-entity-reference field--label-hidden field__item\"><div>\n  \n  \n            <div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\">    <picture>\n                  <source srcset=\"/sites/default/files/styles/freestyle_xl/public/2026-09/screenshot-2026-09-30-092201.png?itok=c9CvZbSy 1x\" media=\"screen and (min-width: 1200px)\" type=\"image/png\" width=\"567\" height=\"400\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_lg/public/2026-09/screenshot-2026-09-30-092201.png.webp?itok=0UtlDCpf 1x\" media=\"(min-width: 992px)\" type=\"image/webp\" width=\"567\" height=\"400\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_md/public/2026-09/screenshot-2026-09-30-092201.png.webp?itok=WOMJedfb 1x\" media=\"(min-width: 768px)\" type=\"image/webp\" width=\"567\" height=\"400\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_sm/public/2026-09/screenshot-2026-09-30-092201.png.webp?itok=vpaDpn4B 1x\" media=\"(min-width: 576px)\" type=\"image/webp\" width=\"567\" height=\"400\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_xs/public/2026-09/screenshot-2026-09-30-092201.png.webp?itok=-r6XGNCa 1x\" media=\"(min-width: 0)\" type=\"image/webp\" width=\"567\" height=\"400\"/>\n                  <img loading=\"eager\" width=\"567\" height=\"400\" src=\"/sites/default/files/styles/freestyle_xs/public/2026-09/screenshot-2026-09-30-092201.png.webp?itok=-r6XGNCa\" alt=\"\" />\n\n  </picture>\n\n</div>\n      \n</div>\n</div>\n      \n    \n    \n    <section class=\"event_date-accordion\">\n      <div class=\"event_date-accordion__item-wrapper\">\n        <h2 id=\"event-dates-title\">\n          <noscript>Event dates</noscript>\n          <button\n            aria-controls=\"event-date-contents\"\n            aria-expanded=\"true\"\n            class=\"event_date-accordion__button\"\n            hidden\n            role=\"button\"\n          >\n            Event dates\n            <span aria-hidden=\"true\" class=\"expand\">&#x3e;</span>\n            <span aria-hidden=\"true\" class=\"collapse\">&#x3c;</span>\n          </button>\n        </h2>\n        <div class=\"event_date-accordion__contents\" id=\"event-date-contents\">\n          \n            <div class=\"field field--name-localgov-event-date field--type-date-recur field--label-hidden field__item\">\n\n  <ul class=\"date-recur-occurrences\">\n          <li><time datetime=\"2026-10-09T12:00:00Z\">9 October 2026, 12.00pm</time>\nto <time datetime=\"2026-10-09T16:00:00Z\">4.00pm</time>\n</li>\n          <li><time datetime=\"2026-10-16T12:00:00Z\">16 October 2026, 12.00pm</time>\nto <time datetime=\"2026-10-16T16:00:00Z\">4.00pm</time>\n</li>\n          <li><time datetime=\"2026-10-23T12:00:00Z\">23 October 2026, 12.00pm</time>\nto <time datetime=\"2026-10-23T16:00:00Z\">4.00pm</time>\n</li>\n          <li><time datetime=\"2026-10-30T12:00:00Z\">30 October 2026, 12.00pm</time>\nto <time datetime=\"2026-10-30T16:00:00Z\">4.00pm</time>\n</li>\n          <li><time datetime=\"2026-11-06T12:00:00Z\">6 November 2026, 12.00pm</time>\nto <time datetime=\"2026-11-06T16:00:00Z\">4.00pm</time>\n</li>\n          <li><time datetime=\"2026-11-13T12:00:00Z\">13 November 2026, 12.00pm</time>\nto <time datetime=\"2026-11-13T16:00:00Z\">4.00pm</time>\n</li>\n          <li><time datetime=\"2026-11-20T12:00:00Z\">20 November 2026, 12.00pm</time>\nto <time datetime=\"2026-11-20T16:00:00Z\">4.00pm</time>\n</li>\n          <li><time datetime=\"2026-11-27T12:00:00Z\">27 November 2026, 12.00pm</time>\nto <time datetime=\"2026-11-27T16:00:00Z\">4.00pm</time>\n</li>\n          <li><time datetime=\"2026-12-04T12:00:00Z\">4 December 2026, 12.00pm</time>\nto <time datetime=\"2026-12-04T16:00:00Z\">4.00pm</time>\n</li>\n          <li><time datetime=\"2026-12-11T12:00:00Z\">11 December 2026, 12.00pm</time>\nto <time datetime=\"2026-12-11T16:00:00Z\">4.00pm</time>\n</li>\n      </ul>\n</div>\n      \n        </div>\n      </div>\n    </section>\n\n    \n    \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><p>The Creative Art Space is a welcoming, recovery-focused community space bringing people together through creativity, connection and shared ideas. It provides an opportunity for people to explore their talents, try new things, share skills and develop creative ideas in a supportive and inclusive environment.</p>\n<p>The space aims to bring people and ideas together across Haringey, creating opportunities for people with lived experience, local residents and the wider recovery community to connect, collaborate and celebrate creativity.</p>\n<p>Over 18's only.</p>\n<h2 id=\"price--2\">Price</h2>\n<p>Free</p>\n<h2 id=\"contact--2\">Contact</h2>\n<p>Email <a href=\"mailto:ellie.froud1@nhs.net\">ellie.froud1@nhs.net</a> or phone 07587 636 079</p>\n<h2 id=\"date--2\">Date</h2>\n<p>Every Friday from 2 October to 18 December 2026, 12 noon to 4pm</p>\n<h2 id=\"location--2\">Location</h2></div>\n      \n            <div class=\"field field--name-localgov-event-location field--type-entity-reference field--label-hidden field__item\">\n<article>\n      \n  <div class=\"field field--name-location field--type-geofield field--label-visually_hidden\">\n    <div class=\"field__label visually-hidden\">location</div>\n              <div class=\"field__item\">\n  \n  <div id=\"leaflet-map-geo-entity-address-813-location\" style=\"min-width: 150px; height: 400px\"></div>\n</div>\n          </div>\n\n  <div class=\"field field--name-postal-address field--type-address field--label-above\">\n    <div class=\"field__label\">Address</div>\n              <div class=\"field__item\"><p class=\"address\" translate=\"no\"><span class=\"address-line1\">The Pavilion</span><br>\n<span class=\"address-line2\">Perth Road</span><br>\n<span class=\"locality\">London</span><br>\n<span class=\"postal-code\">N22 5RB</span><br>\n<span class=\"country\">United Kingdom</span></p></div>\n          </div>\n  </article>\n</div>\n      \n\n  </div>\n\n</article>\n\n<div class=\"event__related lgd-container\">\n  <h2>Related events</h2>\n  <div class=\"views-element-container\"><div class=\"view view-localgov-events-listing view-id-localgov_events_listing view-display-id-related js-view-dom-id-1c28bbd06c723c8542bdf1206a79e9dcb130f87a08af99cbc66b71e4d81daa01\">\n  \n    \n      \n      <div class=\"view-content\">\n          <div class=\"views-row\"><div class=\"views-field views-field-nothing-1\"><span class=\"field-content\"><article role=\"article\" class=\"contextual-region node node--type-localgov-event node--view-mode-teaser event-teaser\" data-clickable>\n  <div class=\"event-teaser__image\">\n  <div>\n  \n      \n                  \n                  <img loading=\"eager\" width=\"600\" height=\"600\" src=\"/sites/default/files/styles/square_medium/public/2024-12/job-interview_500x333px.jpg.webp?itok=AcmgoWNw\" alt=\"\" />\n\n  \n\n\n</div>\n\n</div>\n  <div class=\"event-teaser__content\">\n    <div class=\"event-teaser__metadata\">\n  5 October 2026, 10.00am to 4.00pm</div> \n    <h2 class=\"event-teaser__title\">\n  <a href=\"/events/carers-advice-information-drop-run-by-independence-early-intervention-team\" hreflang=\"en\">Carers Advice and Information Drop In - run by Independence and Early Intervention Team</a> \n </h2>\n    <div class=\"event-teaser__body\">\n  <p>The Independence and Early Intervention (IEI) Team are here to support unpaid/family carers.</p>\n</div> \n  </div>\n</article></span></div></div>\n    <div class=\"views-row\"><div class=\"views-field views-field-nothing-1\"><span class=\"field-content\"><article role=\"article\" class=\"contextual-region node node--type-localgov-event node--view-mode-teaser event-teaser\" data-clickable>\n  <div class=\"event-teaser__image\">\n  <div>\n  \n      \n                  \n                  <img loading=\"eager\" width=\"600\" height=\"600\" src=\"/sites/default/files/styles/square_medium/public/2024-09/digital_help_600.jpg.webp?itok=zZWr0tqI\" alt=\"\" />\n\n  \n\n\n</div>\n\n</div>\n  <div class=\"event-teaser__content\">\n    <div class=\"event-teaser__metadata\">\n  6 October 2026, 10.00am to 4.00pm</div> \n    <h2 class=\"event-teaser__title\">\n  <a href=\"/events/carers-advice-information-drop-run-by-independence-early-intervention-team-0\" hreflang=\"en\">Carers Advice and Information Drop In - run by Independence and Early Intervention Team</a> \n </h2>\n    <div class=\"event-teaser__body\">\n  <p>The Independence and Early Intervention (IEI) Team are here to support unpaid/family carers.</p>\n</div> \n  </div>\n</article></span></div></div>\n    <div class=\"views-row\"><div class=\"views-field views-field-nothing-1\"><span class=\"field-content\"><article role=\"article\" class=\"contextual-region node node--type-localgov-event node--view-mode-teaser event-teaser\" data-clickable>\n  <div class=\"event-teaser__image\">\n  <div>\n  \n      \n                  \n                  <img loading=\"eager\" width=\"600\" height=\"600\" src=\"/sites/default/files/styles/square_medium/public/2026-09/wise-thoughts-drop-in-640px.gif.webp?itok=K85vIL5F\" alt=\"Wise Thoughts LGBTQ+ #meetup\" />\n\n  \n\n\n</div>\n\n</div>\n  <div class=\"event-teaser__content\">\n    <div class=\"event-teaser__metadata\">\n  9 October 2026, 5.00pm to 6.00pm</div> \n    <h2 class=\"event-teaser__title\">\n  <a href=\"/events/wise-thoughts-lgbtqi-drop-0\" hreflang=\"en\">Wise Thoughts&#039; LGBTQI+ drop-in</a> \n </h2>\n    <div class=\"event-teaser__body\">\n  <p>A safe welcoming space for LGBTQI+ people to meet and socialise. Our free drop-in is open to all LGBTQI+ people aged 16+.</p>\n</div> \n  </div>\n</article></span></div></div>\n    <div class=\"views-row\"><div class=\"views-field views-field-nothing-1\"><span class=\"field-