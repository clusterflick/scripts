 -1.27734377,-1.279297 7.43749997,-7.4375 h 2.5566407 z\"/>\n</svg>\n</span>                        <a class=\"breadcrumbs__link\" href=\"/events\">Events</a>\n          </li>\n                \n          </ol>\n  </nav>\n\n  </div>\n\n    </div>\n\n          </div>\n    \n  </div>\n\n\n  \n  \n  \n\n  <div class=\"lgd-region lgd-region--messages region region-messages\">\n\n          <div class=\"lgd-container padding-horizontal\">\n    \n    <div class=\"lgd-region__inner lgd-region__inner--messages\">\n      <div data-drupal-messages-fallback class=\"hidden\"></div>\n\n    </div>\n\n          </div>\n    \n  </div>\n\n\n\n<main class=\"main\" id=\"main-content\"> \n      \n  \n  \n\n  <div class=\"lgd-region lgd-region--content-top region region-content-top\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--content-top\">\n      \n\n<div id=\"block-lgd-localgov-page-header-block-scarfolk\" class=\"block block-localgov-core block-localgov-page-header-block\">\n  \n    \n      \n  \n\n\n  <div class=\"lgd-page-title-block\">\n\n          <h1 class=\"lgd-page-title-block__title\">Film Screening: Harriet (2019)</h1>\n    \n                  <p></p>\n\n          \n  </div>\n\n  </div>\n\n    </div>\n\n    \n  </div>\n\n  \n  <div class=\"lgd-content-section\">\n                                    \n          \n  \n  \n\n  <div class=\"lgd-region lgd-region--content region region-content\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--content\">\n      \n\n<div id=\"block-lgd-localgov-mainpagecontent-scarfolk--2\" class=\"block block-system block-system-main-block\">\n  \n    \n        \n\n<article class=\"node node--type-localgov-event node--promoted node--view-mode-full\">\n\n  \n    \n\n  \n  <div class=\"node__content\">\n        \n          \n            <div class=\"field field--name-localgov-event-image field--type-entity-reference field--label-hidden field__item\"><div>\n  \n  \n            <div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\">    <picture>\n                  <source srcset=\"/sites/default/files/styles/freestyle_xl/public/2026-10/harriet.jpg?h=09c4979e&amp;itok=wGi15LLZ 1x\" media=\"screen and (min-width: 1200px)\" type=\"image/jpeg\" width=\"600\" height=\"398\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_lg/public/2026-10/harriet.jpg.webp?itok=ILFozw_w 1x\" media=\"(min-width: 992px)\" type=\"image/webp\" width=\"600\" height=\"398\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_md/public/2026-10/harriet.jpg.webp?itok=wQhH8zTb 1x\" media=\"(min-width: 768px)\" type=\"image/webp\" width=\"600\" height=\"398\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_sm/public/2026-10/harriet.jpg.webp?itok=K12-wMow 1x\" media=\"(min-width: 576px)\" type=\"image/webp\" width=\"600\" height=\"398\"/>\n              <source srcset=\"/sites/default/files/styles/freestyle_xs/public/2026-10/harriet.jpg.webp?itok=XjW5Gk6B 1x\" media=\"(min-width: 0)\" type=\"image/webp\" width=\"576\" height=\"382\"/>\n                  <img loading=\"eager\" width=\"576\" height=\"382\" src=\"/sites/default/files/styles/freestyle_xs/public/2026-10/harriet.jpg.webp?itok=XjW5Gk6B\" alt=\"\" />\n\n  </picture>\n\n</div>\n      \n</div>\n</div>\n      \n    \n    \n    <section class=\"event_date-accordion\">\n      <div class=\"event_date-accordion__item-wrapper\">\n        <h2 id=\"event-dates-title\">\n          <noscript>Event dates</noscript>\n          <button\n            aria-controls=\"event-date-contents\"\n            aria-expanded=\"true\"\n            class=\"event_date-accordion__button\"\n            hidden\n            role=\"button\"\n          >\n            Event dates\n            <span aria-hidden=\"true\" class=\"expand\">&#x3e;</span>\n            <span aria-hidden=\"true\" class=\"collapse\">&#x3c;</span>\n          </button>\n        </h2>\n        <div class=\"event_date-accordion__contents\" id=\"event-date-contents\">\n          \n            <div class=\"field field--name-localgov-event-date field--type-date-recur field--label-hidden field__item\">  <div class=\"date-recur-date\"><time datetime=\"2026-10-15T15:30:00Z\">15 October 2026, 3.30pm</time>\nto <time datetime=\"2026-10-15T17:30:00Z\">5.30pm</time>\n</div>\n\n\n</div>\n      \n        </div>\n      </div>\n    </section>\n\n    \n    \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><p>The extraordinary tale of Harriet Tubman's escape from slavery and transformation into one of America's greatest heroines, whose courage, ingenuity and tenacity freed hundreds of slaves and changed the course of history.</p>\n<p>Cert 12</p>\n<h2 id=\"price--2\">Price</h2>\n<p>Free Event</p>\n<h2 id=\"contact--2\">Contact</h2>\n<p><a href=\"mailto:libraries@haringey.gov.uk\">libraries@haringey.gov.uk</a></p>\n<h2 id=\"date--2\">Date</h2>\n<p>15 October 2026</p>\n<h3 id=\"additional-date-and-time-information--2\">Additional date and time information</h3>\n<p>3.30pm (125min)</p></div>\n      \n  <div class=\"field field--name-localgov-event-venue field--type-entity-reference field--label-inline clearfix\">\n    <div class=\"field__label\">Venue</div>\n              <div class=\"field__item\"><a href=\"/libraries/libraries-haringey/wood-green-library\" hreflang=\"en\">Wood Green Library</a></div>\n          </div>\n\n            <div class=\"field field--name-localgov-event-location field--type-entity-reference field--label-hidden field__item\">\n<article>\n      \n  <div class=\"field field--name-location field--type-geofield field--label-visually_hidden\">\n    <div class=\"field__label visually-hidden\">location</div>\n              <div class=\"field__item\">\n  \n  <div id=\"leaflet-map-geo-entity-address-86-location\" style=\"min-width: 150px; height: 400px\"></div>\n</div>\n          </div>\n\n  <div class=\"field field--name-postal-address field--type-address field--label-above\">\n    <div class=\"field__label\">Address</div>\n              <div class=\"field__item\"><p class=\"address\" translate=\"no\"><span class=\"address-line1\">Wood Green Customer Service Centre</span><br>\n<span class=\"address-line2\">187-197A High Road</span><br>\n<span class=\"locality\">Wood Green</span><br>\n<span class=\"postal-code\">N22 6XD</span><br>\n<span class=\"country\">United Kingdom</span></p></div>\n          </div>\n  </article>\n</div>\n      \n      <div class=\"field field--name-field-localgov-event-audience field--type-entity-reference field--label-hidden field__items\">\n              <div class=\"field__item\"><a href=\"/taxonomy/term/678\" hreflang=\"en\">BHH 365+</a></div>\n              <div class=\"field__item\"><a href=\"/taxonomy/term/2625\" hreflang=\"en\">BHH 365+ Film screenings</a></div>\n          </div>\n  \n\n  </div>\n\n</article>\n\n</div>\n\n  </div>\n\n    </div>\n\n    \n  </div>\n\n                </div>\n\n  \n      \n  \n  \n\n  <div class=\"lgd-region lgd-region--content-last region region-content-last\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--content-last\">\n      \n\n<div onsubmit=\"return false\" class=\"hlbc-feedback-form block block-hlbc-feedback block-feedback-block\" data-drupal-selector=\"hlbc-feedback-form\" id=\"block-lgd-feedbackblock\">\n  \n    \n      <form data-action=\"/events/film-screening-harriet-2019\" class=\"antibot\" action=\"/antibot\" method=\"post\" id=\"hlbc-feedback-form\" accept-charset=\"UTF-8\">\n  <noscript>\n  <div class=\"antibot-no-js antibot-message antibot-message-warning\">You must have JavaScript enabled to use this form.</div>\n</noscript>\n<div class=\"hlbc-feedback-wrapper\"><div style=\"display:block;\" data-drupal-selector=\"edit-hlbc-feedback\" id=\"edit-hlbc-feedback\" class=\"js-form-wrapper form-wrapper\"><span class=\"hlbc-feedback-fbq\">Was this page useful?</span><input data-dru