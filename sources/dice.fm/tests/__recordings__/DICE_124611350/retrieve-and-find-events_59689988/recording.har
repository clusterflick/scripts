\":\"Theatre\",\"culture_wellbeing\":\"Wellbeing\",\"culture_workshop\":\"Workshop\",\"music_artistsigning\":\"Artist signing\",\"music_dj\":\"DJ\",\"music_gig\":\"Gigs\",\"music_party\":\"Party\",\"music_playback\":\"Playback\"}}}},\"initialLanguage\":\"en\",\"i18nServerInstance\":null,\"pageProps\":{\"headerProps\":{\"theme\":\"dark\",\"disableAutoHide\":true},\"loaded\":true,\"statusCode\":200,\"initialState\":\"{\\\"auth\\\":{\\\"isValidating\\\":true,\\\"isRestored\\\":false,\\\"isNewUser\\\":false},\\\"experiments\\\":{},\\\"flow\\\":{\\\"loading\\\":false,\\\"channel\\\":\\\"email\\\",\\\"availableChannels\\\":[]},\\\"artists\\\":{},\\\"promoters\\\":{},\\\"tickets\\\":{\\\"isLoading\\\":false},\\\"event\\\":{\\\"event\\\":{\\\"seating\\\":null,\\\"attendance_type\\\":\\\"live_only\\\",\\\"summary_lineup\\\":{\\\"top_artists\\\":[{\\\"name\\\":\\\"The Romance of Baba Loco \\\",\\\"image\\\":null,\\\"artist_id\\\":\\\"37549\\\",\\\"about\\\":null,\\\"is_headliner\\\":false}],\\\"total_artists\\\":1,\\\"total_free_texts\\\":1},\\\"marketeers\\\":[],\\\"has_multiple_ticket_types\\\":true,\\\"seats_io_event_id\\\":null,\\\"date_unix\\\":1762455600,\\\"properties\\\":[],\\\"shopping_cart_enabled\\\":false,\\\"announcement_date_unix\\\":1758668400,\\\"unicorn\\\":false,\\\"social_links\\\":{\\\"event_share\\\":\\\"https://link.dice.fm/t20fb5d911c7?dice_id=t20fb5d911c7\\\",\\\"post_competition_referral\\\":\\\"https://link.dice.fm/a5a63ad0572b?dice_id=a5a63ad0572b\\\",\\\"post_purchase_extras_available_referral\\\":\\\"https://link.dice.fm/u0dfff343893?dice_id=u0dfff343893\\\",\\\"post_purchase_referral\\\":\\\"https://link.dice.fm/pa0a560da47d?dice_id=pa0a560da47d\\\",\\\"post_reminder_referral\\\":\\\"https://link.dice.fm/ybe80aafd436?dice_id=ybe80aafd436\\\",\\\"post_waitinglist_referral\\\":\\\"https://link.dice.fm/z42d64be7eff?dice_id=z42d64be7eff\\\"},\\\"about\\\":{\\\"description\\\":\\\"‘We began in a fairytale and we came to life, but is this life reality?’\\\\n\\\\n@dashthehengestore x SECRET CEREMONY by @lost.art.media return to church for a psychedelic quest for enlightenment. On NOVEMBER 6th we’ll be screening Alejandro Jodorowsky’s cult classic THE HOLY MOUNTAIN 🗻👁️🍄\\\\n\\\\nA surreal extravaganza featuring a cast that received intensive spiritual training and took psilocybin mushrooms, THE HOLY MOUNTAIN tracks the misadventures of a group of travellers as they ascend the Holy Mountain to dethrone the immortal gods ruling it.\\\\n\\\\nComplementing this visually spectacular story will be a performance by @theromanceofbabaloco\\\\n\\\\nOur last event was a sell-out, so grab your tickets while you can, and join us at St. Giles’ to climb the Holy Mountain this November.\\\\n\\\\n£15 early bird tickets available NOW via Dice or Ticket Tailor. Link in bio\\\\n\\\\nArt by @kieranrid\\\\n\\\\nSound as always by @evareadypa and @liveatstgiles\\\\n\\\\n\\\\\\\\--\\\\n\\\\nA percentage of every ticket sold will be contributed to The Friends of St Giles’\\\\n\\\\nThe Friends of St Giles’ was founded in the 1980’s to help raise funds for the repair and maintenance of St Giles.\\\\n\\\\nIt recognises that St Giles’ plays a significant role in the secular life of SE5, in particular through the development of community involvement in music and the arts.\\\",\\\"highlights\\\":[{\\\"type\\\":\\\"age_restriction\\\",\\\"title\\\":\\\"This is an 18+ event\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null},{\\\"type\\\":\\\"promoter\\\",\\\"title\\\":\\\"Presented by Dash The Henge Store x Secret Ceremony by LOST ART\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null}]},\\\"is_hidden_event\\\":false,\\\"streaming_options\\\":null,\\\"seats_io_public_key\\\":null,\\\"is_fully_locked\\\":false,\\\"status\\\":\\\"on-sale\\\",\\\"images\\\":{\\\"square\\\":\\\"https://dice-media.imgix.net/attachments/2025-09-24/c6395822-472d-46c8-baea-aa62a4bd061f.jpg?rect=0%2C0%2C1350%2C1350\\\",\\\"landscape\\\":\\\"https://dice-media.imgix.ne