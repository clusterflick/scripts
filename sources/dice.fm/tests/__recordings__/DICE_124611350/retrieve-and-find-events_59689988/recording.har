space_name\":null,\"doors_open_date\":\"2025-11-06T18:00:00+00:00\",\"doors_close_date\":null}],\"is_hidden_event\":false,\"seats_io_event_id\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"max_tickets\":4,\"attendance_type\":\"live_only\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-16/521e2a24-c52a-44dc-aa7b-4f19f96bfe26.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-16/521e2a24-c52a-44dc-aa7b-4f19f96bfe26.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-16/521e2a24-c52a-44dc-aa7b-4f19f96bfe26.jpg?rect=173%2C0%2C422%2C768\"},\"is_fully_locked\":false,\"properties\":[],\"seating\":null,\"perm_name\":\"q28e8o-my-eyes-my-eyes-presents-ebony-ivory-2025-6th-nov-multi-story-london-tickets\",\"secondary_status\":null,\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"seats_io_public_key\":null,\"status\":\"on-sale\",\"marketeers\":[],\"donation\":null,\"tty_to_extras\":[],\"previews\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1100,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"date_unix\":1762455600,\"about\":{\"description\":\"My Eyes! My Eyes! brings their signature strangeness to MULTI STORY with Ebony \\u0026 Ivory – a new surreal and hilarious comedy from Jim Hosking, director of The Greasy Strangler and An Evening with Beverly Luff Linn.\\n\\nTwo musical legends gather at a Scottish cottage on the Mull of Kintyre for a tense summit to discuss a potential collaboration that will ultimately result in a global Number One smash hit single.\\n\\nJoin us for the screening, followed by a live Q\\u0026A with Jim Hosking and ‘Oinker’ Texas Joe, plus a DJ set from Texas Radio and the Big Beat.\\n\\nTicket price includes a raffle ticket.\\n\\nWritten and Directed by: Jim Hosking\\n\\nProduced by: Denzil Monk, Ant Timpson, Jim Hosking, Thelonious Brooks\\n\\nStarring: Sky Elobar and Gil Gex\\n\\nDirector of Photography: Marten Tedin\\n\\nComposer: Andrew Hung\\n\\nProduction Design: Felicity Hickson\\n\\nPresented in collaboration with My Eyes! My Eyes! – keeping Southwark weird through regular screenings of the wild, weird and wonderful.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"shopping_cart_enabled\":false,\"impression_id\":\"69e80567daaaa992:7\",\"offers_extras\":false,\"acquisition_type\":\"purchase\",\"has_multiple_ticket_types\":false,\"presented_by\":\"Presented by MULTI STORY.\",\"announcement_date_unix\":1760716800,\"streaming_options\":null,\"id\":\"68f265028aafe3000113e058\",\"billing_promoter\":{\"id\":\"139034\",\"name\":\"MULTI STORY\",\"image\":{\"url\":null},\"perm_name\":\"multi-story-82ebv\",\"profile_active\":false},\"name\":\"MY EYES! MY EYES! Presents 'Ebony \\u0026 Ivory' (2025)\",\"new\":false,\"faqs\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/X44e29afb112?dice_id=X44e29afb112\",\"post_competition_referral\":\"https://link.dice.fm/Lf933c64fdde?dice_id=Lf933c64fdde\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/sb5a2f01c205?dice_id=sb5a2f01c205\",\"post_purchase_referral\":\"https://link.dice.fm/c7376c6a5bd0?dice_id=c7376c6a5bd0\",\"post_reminder_referral\":\"https://link.dice.fm/qd0d98636ad3?dice_id=qd0d98636ad3\",\"post_waitinglist_referral\":\"https://link.dice.fm/We8ad67f7ed1?dice_id=We8ad67f7ed1\"},\"score\":0,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-17T17:00:00+01:00\",\"sale_end_date\":\"2025-11-06T17:00:00+00:00\",\"sale_start_date\":\"2025-10-17T17:00:00+01:00\",\"event_start_date\":\"2025-11-06T19:00:00+00:00\",\"event_end_date\":\"2025-11-06T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"event_ta