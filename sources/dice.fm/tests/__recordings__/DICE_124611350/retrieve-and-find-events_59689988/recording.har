e\":\"live-at-st-giles-nnk3\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2025-11-06T19:00:00+00:00\",\"doors_close_date\":null}],\"is_hidden_event\":false,\"seats_io_event_id\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"max_tickets\":6,\"attendance_type\":\"live_only\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-24/c6395822-472d-46c8-baea-aa62a4bd061f.jpg?rect=0%2C0%2C1350%2C1350\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-24/c6395822-472d-46c8-baea-aa62a4bd061f.jpg?rect=0%2C270%2C1350%2C810\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-24/c6395822-472d-46c8-baea-aa62a4bd061f.jpg?rect=304%2C0%2C743%2C1350\"},\"is_fully_locked\":false,\"properties\":[],\"seating\":null,\"perm_name\":\"v3o9lg-the-holy-mountain-film-screening-the-romance-of-baba-loco-live-6th-nov-live-at-st-giles-london-tickets\",\"secondary_status\":null,\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"seats_io_public_key\":null,\"status\":\"on-sale\",\"marketeers\":[],\"donation\":null,\"tty_to_extras\":[],\"previews\":[{\"type\":\"apple_music\",\"title\":\"The Romance of Baba Loco - The Abyss Is a Feather Bed\",\"redirect_url\":\"https://music.apple.com/us/album/the-abyss-is-a-feather-bed/1533799518?i=1533799521\\u0026uo=4\\u0026at=1001ld8Z\\u0026ct=app_event\",\"artist\":\"The Romance of Baba Loco\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview114/v4/27/f5/80/27f58021-034b-17c8-3c8d-5d95a8fc47d1/mzaf_13339851248548086337.plus.aac.p.m4a\",\"track_name\":\"The Abyss Is a Feather Bed\"},{\"type\":\"spotify\",\"title\":\"The Romance of Baba Loco - The Abyss Is a Feather Bed\",\"redirect_url\":\"https://open.spotify.com/track/03gJMiVnqFRIzqygDaNRNs\",\"artist\":\"The Romance of Baba Loco\",\"preview_url\":\"https://p.scdn.co/mp3-preview/d7956cc7f23d5d14d0c01624b39bf48b50572d76?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Abyss Is a Feather Bed\"}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1695},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Romance of Baba Loco \",\"image\":null,\"artist_id\":\"37549\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"date_unix\":1762455600,\"about\":{\"description\":\"‘We began in a fairytale and we came to life, but is this life reality?’\\n\\n@dashthehengestore x SECRET CEREMONY by @lost.art.media return to church for a psychedelic quest for enlightenment. On NOVEMBER 6th we’ll be screening Alejandro Jodorowsky’s cult classic THE HOLY MOUNTAIN 🗻👁️🍄\\n\\nA surreal extravaganza featuring a cast that received intensive spiritual training and took psilocybin mushrooms, THE HOLY MOUNTAIN tracks the misadventures of a group of travellers as they ascend the Holy Mountain to dethrone the immortal gods ruling it.\\n\\nComplementing this visually spectacular story will be a performance by @theromanceofbabaloco\\n\\nOur last event was a sell-out, so grab your tickets while you can, and join us at St. Giles’ to climb the Holy Mountain this November.\\n\\n£15 early bird tickets available NOW via Dice or Ticket Tailor. Link in bio\\n\\nArt by @kieranrid\\n\\nSound as always by @evareadypa and @liveatstgiles\\n\\n\\\\--\\n\\nA percentage of every ticket sold will be contributed to The Friends of St Giles’\\n\\nThe Friends of St Giles’ was founded in the 1980’s to help raise funds for the repair and maintenance of St Giles.\\n\\nIt recognises that St Giles’ plays a significant role in the secular life of SE5, in particular through the development of community involvement in music and the arts.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"shopping_cart_enabled\":false,\"impression_id\":\"69e80567daaaa992:10\",\"offers_extras\":false,\"acquisition_type\":\"purchase\",\"has_multiple_ticket_types\":true,\"presented_by\":\"Presented by Dash The Henge Store x Secret Ceremony by LOST ART\",\"announcement_date_unix\":1758668400,\"streaming_options\":null,\"id\":\"68d3c9a20870970001d8d371\",\"billing_promoter\":{\"id\":\"7354\",\"name\":\"FreakFreak\",\"image\":{\"url\":null},\"perm_name\":\"freakfreak-5aly\",\"profile_active\":false},\"name\":\"The Holy Mountain: Film Screening \\u0026 The Romance of Baba Loco Live\",\"new\":false,\"faqs\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/t20fb5d911c7?dice_id=t20fb5d911c7\",\"post_competition_referral\":\"https://link.dice.fm/a5a63ad0572b?dice_id=a5a63ad0572b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/u0dfff343893?dice_id=u0dfff343893\",\"post_purchase_referral\":\"https://link.dice.fm/pa0a560da47d?dice_id=pa0a560da47d\",\"post_reminder_referral\":\"https://link.dice.fm/ybe80aafd436?dice_id=ybe80aafd436\",\"post_waitinglist_referral\":\"https://link.dice.fm/z42d64be7eff?dice_id=z42d64be7eff\"},\"score\":0,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-24T00:00:00+01:00\",\"sale_end_date\":\"2025-11-06T18:00:00+00:00\",\"sale_start_date\":\"2025-09-24T00:00:00+01:00\",\"event_start_date\":\"2025-11-06T19:00:00+00:00\",\"event_end_date\":\"2025-11-06T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"event_tag\":null},{\"venues\":[{\"id\":\"298\",\"name\":\"Strongroom Bar\",\"address\":\"120-124 Curtain Rd, Shoreditch, London EC2A 3SQ, UK\",\"location\":{\"lat\":51.5259644,\"lng\":-0.0801498},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-11-09/01c2cab5-15ea-48e0-a0b4-d9ed0465d9db.jpg?rect=0%2C0%2C850%2C850\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"strongroom-bar-4bym\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2025-11-09T18:00:00+00:00\",\"doors_close_date\":null}],\"is_hidden_event\":false,\"seats_io_event_id\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"max_tickets\":20,\"attendance_type\":\"live_only\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2024-02-26/18e542a0-49ce-40f2-a905-3a307c2ce467.jpg?rect=923%2C0%2C2374%2C2374\",\"landscape\":\"https://dice-media.imgix.net/attachments/2024-02-26/18e542a0-49ce-40f2-a905-3a307c2ce467.jpg?rect=132%2C0%2C3957%2C2374\",\"portrait\":\"https://dice-media.imgix.net/attachments/2024-02-26/18e542a0-49ce-40f2-a905-3a307c2ce467.jpg?rect=1457%2C0%2C1306%2C2374\"},\"is_fully_locked\":false,\"properties\":[],\"seating\":null,\"perm_name\":\"dk86eg-short-film-open-mic-9th-nov-strongroom-bar-london-tickets\",\"secondary_status\":null,\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"seats_io_public_key\":null,\"status\":\"on-sale\",\"marketeers\":[],\"donation\":null,\"tty_to_extras\":[],\"previews\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"date_unix\":1762711200,\"about\":{\"description\":\"Whether you’re looking for a chance to screen your short film in front of a live audience for free OR you’re looking to watch something wild, wacky, and creative outside of the mainstream, our open mic is refreshingly non-competitive in an all-too-oftentimes intimidating industry.\\n\\nBoth industry professionals and first-timers bring their shorts to Kino making the quality of cinema screened at each event both diverse and entertaining. And with such a broad spectrum of new work being screened, our Open Mic is a genuine reflection of the current output of London based filmmakers.\\n\\nREGISTER TO SCREEN YOUR SHORT FILM HERE: www.kinoshortfilm.com/short-film-openmic\\n\\n- One film per filmmaker\\n- Register in advance\\n- Filmmakers must be present to introduce film\\n- Films are accepted on a first-come, first-screened basis\\n- Film running time should be under 10 mins\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"highlights\":[]},\"shopping_cart_enabled\":false,\"impression_id\":\"69e80567daaaa992:11\",\"offers_extras\":false,\"acquisition_type\":\"purchase\",\"has_multiple_ticket_types\":false,\"presented_by\":\"Presented by Kino Short Film.\",\"announcement_date_unix\":1761300000,\"streaming_options\":null,\"id\":\"68fb50fc0baaf80001b55615\",\"billing_promoter\":{\"id\":\"11708\",\"name\":\"Kino Short Film\",\"image\":{\"url\":null},\"perm_name\":\"kino-short-film-n5g5\",\"profile_active\":false},\"name\":\"Short Film Open Mic\",\"new\":false,\"faqs\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/Sd718875f1fa?dice_id=Sd718875f1fa\",\"post_competition_referral\":\"https://link.dice.fm/D594e65090a0?dice_id=D594e65090a0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/l4840fa03a9a?dice_id=l4840fa03a9a\",\"post_purchase_referral\":\"https://link.dice.fm/G002d8c5a2f2?dice_id=G002d8c5a2f2\",\"post_reminder_referral\":\"https://link.dice.fm/kf4f96b7443a?dice_id=kf4f96b7443a\",\"post_waitinglist_referral\":\"https://link.dice.fm/F8ad02939f2a?dice_id=F8ad02939f2a\"},\"score\":0,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-24T11:00:00+01:00\",\"sale_end_date\":\"2025-11-09T20:00:00+00:00\",\"sale_start_date\":\"2025-10-24T11:00:00+01:00\",\"event_start_date\":\"2025-11-09T18:00:00+00:00\",\"event_end_date\":\"2025-11-09T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"event_tag\":null},{\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/faq-type/access-questions/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2025-11-15T12:00:00+00:00\",\"doors_close_date\":null}],\"is_hidden_event\":false,\"seats_io_event_id\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"max_tickets\":12,\"attendance_type\":\"live_only\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-24/ad707bb9-c1e2-46cd-a4c9-09b80f8f14c1.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-24/ad707bb9-c1e2-46cd-a4c9-09b80f8f14c1.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-24/ad707bb9-c1e2-46cd-a4c9-09b80f8f14c1.jpg?rect=243%2C0%2C594%2C1080\"},\"is_fully_locked\":false,\"properties\":[],\"seating\":null,\"perm_name\":\"wwgrag-high-school-musical-movie-2-bottomless-brunch-party-15th-nov-the-clapham-grand-london-tickets\",\"secondary_status\":null,\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"seats_io_public_key\":null,\"status\":\"on-sale\",\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"donation\":null,\"tty_to_extras\":[],\"previews\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1900},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"date_unix\":1763208000,\"about\":{\"description\":\"**Enjoy High School Musical 2 as we bring this cult classic back for one day only, on Sat 15th November 2025 🌟 Celebrate the 18th anniversary of this iconic film this year with us with a group offer of 4-for-3 tickets on tables!**\\n\\nThey went viral on TikTok last year and over 4,500 Disney Channel lovers have already come to party with us before… So, gather your fellow Wild Cats for:\\n\\nAn hour of bottomless booze 🍾\\n\\nThe whole movie on our big-ass screen! 📽️\\n\\nWe’re All In This Together mass sing-a-longs🎙️\\n\\nDisney Channel Mini Disco 🕺\\n\\nShow stopping performances from our Wild Cat Dreamteam 🤩\\n\\nPrizes for the Best Costumes 👗\\n\\nGet’cha Head in the Game Competition 🏆\\n\\nHotdogs \\u0026 Nachos courtesy of Hot Beige, even vegan goodness too! 🌭\\n\\nPopcorn for £3 🍿\\n\\n**IMPORTANT INFO:**\\n\\nPlease note: this event is 18+\\n\\nDoors: 12PM  \\nBottomless hour: 12:30-1:30PM  \\nMovie, Show, Games: 1-3:30PM  \\nMini Disney Disco: until close at 4:15PM  \\nLast Entry 1pm\\n\\nFor any ticketing or accessibility assistance, please email info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help!\\n\\nFor any accessibility requests, please contact access@claphamgrand.com or call us on 020 7223 6523 to discuss how we can best support you.\\n\\nFor any other questions, please contact us on info@claphamgrand.com or visit our FAQ page.\\n\\nAge restrictions for shows with us vary on an event by event basis. Please check the event description and if in doubt email us on info@claphamgrand.com.\\n\\nPlease note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"shopping_cart_enabled\":false,\"impression_id\":\"69e80567daaaa992:12\",\"offers_extras\":false,\"acquisition_type\":\"purchase\",\"has_multiple_ticket_types\":true,\"presented_by\":\"Presented by The Clapham Grand.\",\"announcement_date_unix\":1755100800,\"streaming_options\":null,\"id\":\"689c9c08090fc400015892a8\",\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"name\":\"High School Musical Movie 2 Bottomless Brunch Party!\",\"new\":false,\"faqs\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/fc701d4cf56f?dice_id=fc701d4cf56f\",\"post_competition_referral\":\"https://link.dice.fm/O31e70d37e23?dice_id=O31e70d37e23\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ic2a5593077c?dice_id=Ic2a5593077c\",\"post_purchase_referral\":\"https://link.dice.fm/v09453c9aa64?dice_id=v09453c9aa64\",\"post_reminder_referral\":\"https://link.dice.fm/x7a81934564d?dice_id=x7a81934564d\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ped7cfb7adbc?dice_id=Ped7cfb7adbc\"},\"score\":0,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-13T17:00:00+01:00\",\"sa