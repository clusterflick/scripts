sts\":[{\"name\":\"Film Screening\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2020-09-15/0b8ef9ab-63ad-41fd-bec4-98e25f9bca16.jpg?rect=67%2C0%2C798%2C798\"},\"artist_id\":\"11393\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"date_unix\":1764531000,\"about\":{\"description\":\"Christiane F., Kai Hermann’s biography of a teen junkie and sex worker, caused a scandal on publication. As a recovering cocaine addict and father Bowie was shocked at witnessing teenagers getting their smack money from pick-ups at Berlin Zoo and so became interested in this film adaptation. Within the film, Bowie’s live show, tonally perfect Station to Station-era soundtrack and omnipresent image – on streets, subways and on vinyl albums passed from hand to hand – positioned him as a brooding god for the alienated youth of 70s West Berlin.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event (Photo ID Required).\",\"subtitle\":null,\"external_link\":null}]},\"shopping_cart_enabled\":false,\"impression_id\":\"69e80567daaaa992:16\",\"offers_extras\":false,\"acquisition_type\":\"purchase\",\"has_multiple_ticket_types\":true,\"presented_by\":\"Presented by Deeper Into Movies.\",\"announcement_date_unix\":1757977200,\"streaming_options\":null,\"id\":\"68ca6edfce6a8b00016b2e22\",\"billing_promoter\":{\"id\":\"1357\",\"name\":\"Deeper Into Movies\",\"image\":{\"url\":null},\"perm_name\":\"deeper-into-movies-pgep\",\"profile_active\":true},\"name\":\"Christiane F\",\"new\":false,\"faqs\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/Da928c0e910d?dice_id=Da928c0e910d\",\"post_competition_referral\":\"https://link.dice.fm/t0abc29f4c18?dice_id=t0abc29f4c18\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/e72d46e5f419?dice_id=e72d46e5f419\",\"post_purchase_referral\":\"https://link.dice.fm/d226bdabbb5d?dice_id=d226bdabbb5d\",\"post_reminder_referral\":\"https://link.dice.fm/j51ee7120