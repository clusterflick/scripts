ace\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"artotel-london-hoxton-lper\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2025-10-31T17:00:00+00:00\",\"doors_close_date\":null}],\"is_hidden_event\":false,\"seats_io_event_id\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"max_tickets\":4,\"attendance_type\":\"live_only\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-06/5679cf79-a2e7-4d5e-b435-c26389140c1d.jpg?rect=944%2C0%2C5652%2C5652\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-06/5679cf79-a2e7-4d5e-b435-c26389140c1d.jpg?rect=0%2C565%2C7539%2C4523\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-06/5679cf79-a2e7-4d5e-b435-c26389140c1d.jpg?rect=2215%2C0%2C3109%2C5652\"},\"is_fully_locked\":false,\"properties\":[],\"seating\":null,\"perm_name\":\"mxp7bk-dusk-til-dawn-all-night-vampire-takeover-31st-oct-artotel-london-hoxton-london-tickets\",\"secondary_status\":\"waiting-list\",\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"seats_io_public_key\":null,\"status\":\"sold-out\",\"marketeers\":[],\"donation\":null,\"tty_to_extras\":[],\"previews\":[{\"type\":\"spotify\",\"title\":\"The Blasters - Dark Night\",\"redirect_url\":\"https://open.spotify.com/track/3dKGK0ALdWHldGJEXpwt3K\",\"artist\":\"The Blasters\",\"preview_url\":\"https://p.scdn.co/mp3-preview/747a303059a776a2c3823ab16303d2251e3a97a7?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Dark Night\"},{\"type\":\"apple_music\",\"title\":\"The Blasters - Dark Night\",\"redirect_url\":\"https://music.apple.com/us/album/dark-night/274782938?i=274783078\\u0026uo=4\\u0026at=1001ld8Z\\u0026ct=app_event\",\"artist\":\"The Blasters\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/Music/da/5f/44/mzm.dbewcedy.aac.p.m4a\",\"track_name\":\"Dark Night\"}],\"price\":{\"currency\":\"GBP\",\"amount\":2700,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"date_unix\":1761930000,\"about\":{\"description\":\"This Halloween, art’otel London Hoxton is set to host its first-ever all-night cinematic experience…\\n\\nFrom sundown on Halloween until sunrise on All Saints’ Day, the design-led hotel will transform its in-house cinema into a gothic hideaway for a 14-hour marathon of cult and classic vampire films — culminating, fittingly, with From Dusk Till Dawn as daylight breaks.\\n\\nThe curated line-up features Interview with the Vampire, The Lost Boys and From Dusk Till Dawn, with more titles to be revealed.\\n\\nFuel your night with a gloriously gory Kraken Rum “blood bag” cocktail, followed by a garlic-inspired feast fit for creatures of the night — with a selection of Brush Burger sliders, hearty Butternut Squash Curry boxes, and All-Garlic Flat Breads to help ward off evil spirits. A midnight feast of popcorn chicken with garlic dip and Korean glazed cauliflower will follow, with unlimited popcorn and pick’n’mix available throughout the night. Dawn survivors can enjoy breakfast and a bloody mary – a fitting reward for making it to sunrise.\\n\\nTickets are priced at £25 (with discounted options for hotel guests) and include 5 films, dinner, snacks and a welcome drink.\\n\\nTerms and conditions apply. 18+, UK only. The art’otel Dusk ‘til Dawn Vampire Movie Screening will be open for one night only from 5pm on 31st October to 6.30am on 1st November. Tickets are limited. Ticket price includes one welcome drink, an array of snacks, and 5 films. Customers will be responsible for their own travel.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"shopping_cart_ena