se %s.\",\"ticket_selection_total\":\"Total – %s\",\"ticket_single_extra_included_title\":\"Includes %d × %s\",\"ticket_transfer_acknowledgement_checkbox_title\":\"I understand\",\"ticket_transfer_not_on_dice_title\":\"Contacts not on DICE\",\"ticket_transfer_on_dice_title\":\"Contacts on DICE\",\"ticket_transfer_pending_waiting_list\":\"On the wait list\",\"ticket_transfer_select_tickets_subtitle\":\"Which tickets do you want to send to %@?\",\"ticket_type_undetermined_price\":\"Stay tuned for price\",\"today\":\"Today\",\"tomorrow\":\"Tomorrow\",\"unlock_confirmation_discount_title\":\"Enjoy your\\\\n discount\",\"unlock_confirmation_ticket_title\":\"Ticket\\\\nunlocked\",\"user_past_events\":\"Your past events\",\"user_registration_updates_subtitle\":\"We’ll tell you about shows that are right up your street\",\"user_registration_updates_subtitle_germany\":\"You will receive regular marketing e-mails from DICE about our goods and services (e.g. exclusive offers for events). You can object to this use of your e-mail address at any time without incurring additional costs via the unsubscribe link in any of our marketing emails.\",\"user_upcoming_events\":\"Your upcoming events\",\"venues_hub_page_description\":\"Follow your favourites and be the first to know about new shows.\",\"venue_follower\":\"%s followers\",\"venue_profile_follow_tooltip_title\":\"Find out what’s next at this space\",\"view_tickets_button\":\"View ticket\",\"view_tickets_button_plural\":\"View tickets\",\"waiting_for_tickets\":\"You're currently waiting for %d ticket\",\"waiting_for_tickets_plural\":\"You're currently waiting for %d tickets\",\"waiting_for_tickets_web\":\"You're currently waiting for %s ticket. If you're offered tickets, you'll need the DICE app to buy them.\",\"waiting_for_tickets_web_plural\":\"You're currently waiting for %s tickets. If you're offered tickets, you'll need the DICE app to buy them.\",\"waiting_list\":\"Wait list\",\"waiting_list_badge_remaining\":\"%s left\",\"waiting_list_confirmation_screen_feature_1\":\"We’ll let you know if tickets become available\",\"waiting_list_confirmation_screen_feature_2\":\"You’ll have a brief window to buy them\",\"waiting_list_confirmation_screen_feature_3\":\"If you miss your chance, rejoin at the top\",\"waiting_list_confirmation_screen_feature_3_v2\":\"Turn on your notifications to make sure you hear\\u2028about available tickets in time\",\"waiting_list_confirmation_screen_feature_4\":\"You can change the number of tickets you want\",\"waiting_list_confirmation_screen_title\":\"You’re on the wait list,\\nnow you need the app\",\"waiting_list_confirmation_screen_title_v2\":\"You’re on the wait list, \\nnow get the app\"},\"tags\":{\"tags_hierarchy\":{\"culture_art\":\"Art\",\"culture_comedy\":\"Comedy\",\"culture_film\":\"Film\",\"culture_podcast\":\"Podcast\",\"culture_social\":\"Social\",\"culture_sport\":\"Sport\",\"culture_talks\":\"Talk\",\"culture_theatre\":\"Theatre\",\"culture_wellbeing\":\"Wellbeing\",\"culture_workshop\":\"Workshop\",\"music_artistsigning\":\"Artist signing\",\"music_dj\":\"DJ\",\"music_gig\":\"Gigs\",\"music_party\":\"Party\",\"music_playback\":\"Playback\"}}}},\"initialLanguage\":\"en\",\"i18nServerInstance\":null,\"pageProps\":{\"headerProps\":{\"theme\":\"dark\",\"disableAutoHide\":true},\"loaded\":true,\"statusCode\":200,\"initialState\":\"{\\\"auth\\\":{\\\"isValidating\\\":true,\\\"isRestored\\\":false,\\\"isNewUser\\\":false},\\\"experiments\\\":{},\\\"flow\\\":{\\\"loading\\\":false,\\\"channel\\\":\\\"email\\\",\\\"availableChannels\\\":[]},\\\"artists\\\":{},\\\"promoters\\\":{},\\\"tickets\\\":{\\\"isLoading\\\":false},\\\"event\\\":{\\\"event\\\":{\\\"is_ticket_available_at_door\\\":false,\\\"tty_to_extras\\\":[],\\\"faqs\\\":[],\\\"shopping_cart_enabled\\\":false,\\\"summary_lineup\\\":{\\\"top_artists\\\":[],\\\"total_artists\\\":0,\\\"total_free_texts\\\":1},\\\"unicorn\\\":true,\\\"date_unix\\\":1762711200,\\\"perm_name\\\":\\\"dk86eg-short-film-open-mic-9th-nov-strongroom-bar-london-tickets\\\",\\\"properties\\\":[],\\\"seating\\\":null,\\\"public_refund_policy\\\":{\\\"type\\\":\\\"cooling_off_enabled\\\",\\\"hours\\\":24},\\\"has_multiple_ticket_types\\\":false,\\\"venues\\\":[{\\\"id\\\":\\\"298\\\",\\\"name\\\":\\\"Strongroom Bar\\\",\\\"address\\\":\\\"120-124 Curtain Rd, Shoreditch, London EC2A 3SQ, UK\\\",\\\"location\\\":{\\\"lat\\\":51.5259644,\\\"lng\\\":-0.0801498},\\\"image\\\":{\\\"url\\\":\\\"https://dice-media.imgix.net/attachments/2021-11-09/01c2cab5-15ea-48e0-a0b4-d9ed0465d9db.jpg?rect=0%2C0%2C850%2C850\\\"},\\\"city\\\":{\\\"id\\\":\\\"54d8a23438fe5d27d500001c\\\",\\\"name\\\":\\\"London\\\",\\\"location\\\":{\\\"lat\\\":51.507653,\\\"lng\\\":-0.107722,\\\"accuracy\\\":12,\\\"place\\\":\\\"Europe/London\\\"},\\\"country_code\\\":\\\"GB\\\",\\\"country_id\\\":\\\"54d8a87238fe5d27d500988a\\\",\\\"country_name\\\":\\\"United Kingdom\\\"},\\\"perm_name\\\":\\\"strongroom-bar-4bym\\\",\\\"accessibility\\\":{\\\"url\\\":null},\\\"profile_active\\\":true,\\\"highlights\\\":[{\\\"type\\\":\\\"capacity\\\",\\\"title\\\":\\\"300 capacity\\\"}],\\\"space_name\\\":null,\\\"doors_open_date\\\":\\\"2025-11-09T18:00:00+00:00\\\",\\\"doors_close_date\\\":null}],\\\"secondary_status\\\":null,\\\"attendance_type\\\":\\\"live_only\\\",\\\"status\\\":\\\"on-sale\\\",\\\"previews\\\":[],\\\"tags_types\\\":[{\\\"name\\\":\\\"film\\\",\\\"value\\\":\\\"culture:film\\\",\\\"title\\\":\\\"Film\\\"}],\\\"acquisition_type\\\":\\\"purchase\\\",\\\"about\\\":{\\\"description\\\":\\\"Whether you’re looking for a chance to screen your short film in front of a live audience for free OR you’re looking to watch something wild, wacky, and creative outside of the mainstream, our open mic is refreshingly non-competitive in an all-too-oftentimes intimidating industry.\\\\n\\\\nBoth industry professionals and first-timers bring their shorts to Kino making the quality of cinema screened at each event both diverse and entertaining. And with such a broad spectrum of new work being screened, our Open Mic is a genuine reflection of the current output of London based filmmakers.\\\\n\\\\nREGISTER TO SCREEN YOUR SHORT FILM HERE: www.kinoshortfilm.com/short-film-openmic\\\\n\\\\n- One film per filmmaker\\\\n- Register in advance\\\\n- Filmmakers must be present to introduce film\\\\n- Films are accepted on a first-come, first-screened basis\\\\n- Film running time should be under 10 mins\\\\n\\\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\\\",\\\"highlights\\\":[{\\\"type\\\":\\\"promoter\\\",\\\"title\\\":\\\"Presented by Kino Short Film.\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null}]},\\\"dates\\\":{\\\"timezone\\\":\\\"Europe/London\\\",\\\"announcement_date\\\":\\\"2025-10-24T11:00:00+01:00\\\",\\\"sale_end_date\\\":\\\"2025-11-09T20:00:00+00:00\\\",\\\"sale_start_date\\\":\\\"2025-10-24T11:00:00+01:00\\\",\\\"event_start_date\\\":\\\"2025-11-09T18:00:00+00:00\\\",\\\"event_end_date\\\":\\\"2025-11-09T22:30:00+00:00\\\",\\\"is_multi_days_event\\\":false,\\\"pre_sale_start_date\\\":null},\\\"announcement_date_unix\\\":1761300000,\\\"seats_io_public_key\\\":null,\\\"streaming_options\\\":null,\\\"seats_io_event_id\\\":null,\\\"donation\\\":null,\\\"billing_promoter\\\":{\\\"id\\\":\\\"11708\\\",\\\"name\\\":\\\"Kino Short Film\\\",\\\"image\\\":{\\\"url\\\":null},\\\"perm_name\\\":\\\"kino-short-film-n5g5\\\",\\\"profile_active\\\":false},\\\"id\\\":\\\"68fb50fc0baaf80001b55615\\\",\\\"name\\\":\\\"Short Film Open Mic\\\",\\\"presented_by\\\":\\\"Presented by Kino Short Film.\\\",\\\"offers_extras\\\":false,\\\"is_hidden_event\\\":false,\\\"price\\\":{\\\"currency\\\":\\\"GBP\\\",\\\"amount\\\":1000,\\\"sales_tax\\\":0,\\\"amount_from\\\":null},\\\"social_links\\\":{\\\"event_share\\\":\\\"https://link.dice.fm/Sd718875f1fa?dice_id=Sd718875f1fa\\\",\\\"post_competition_referr