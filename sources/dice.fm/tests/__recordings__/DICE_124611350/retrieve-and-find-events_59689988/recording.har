sic\\\",\\\"title\\\":\\\"The Blasters - Dark Night\\\",\\\"redirect_url\\\":\\\"https://music.apple.com/us/album/dark-night/274782938?i=274783078\\u0026uo=4\\u0026at=1001ld8Z\\u0026ct=app_event\\\",\\\"artist\\\":\\\"The Blasters\\\",\\\"preview_url\\\":\\\"https://audio-ssl.itunes.apple.com/itunes-assets/Music/da/5f/44/mzm.dbewcedy.aac.p.m4a\\\",\\\"track_name\\\":\\\"Dark Night\\\"}],\\\"unicorn\\\":false,\\\"max_tickets\\\":4,\\\"is_fully_locked\\\":false,\\\"acquisition_type\\\":\\\"purchase\\\",\\\"date_unix\\\":1761930000,\\\"is_hidden_event\\\":false,\\\"announcement_date_unix\\\":1759819500,\\\"seats_io_public_key\\\":null,\\\"venues\\\":[{\\\"id\\\":\\\"13499\\\",\\\"name\\\":\\\"art'otel London Hoxton\\\",\\\"address\\\":\\\"1-3 Rivington Street, Hackney, London, EC2A 3DT, United Kingdom\\\",\\\"location\\\":{\\\"lat\\\":51.52617,\\\"lng\\\":-0.08326},\\\"image\\\":null,\\\"city\\\":{\\\"id\\\":\\\"54d8a23438fe5d27d500001c\\\",\\\"name\\\":\\\"London\\\",\\\"location\\\":{\\\"lat\\\":51.507653,\\\"lng\\\":-0.107722,\\\"accuracy\\\":12,\\\"place\\\":\\\"Europe/London\\\"},\\\"country_code\\\":\\\"GB\\\",\\\"country_id\\\":\\\"54d8a87238fe5d27d500988a\\\",\\\"country_name\\\":\\\"United Kingdom\\\"},\\\"perm_name\\\":\\\"artotel-london-hoxton-lper\\\",\\\"accessibility\\\":{\\\"url\\\":null},\\\"profile_active\\\":false,\\\"highlights\\\":[],\\\"space_name\\\":null,\\\"doors_open_date\\\":\\\"2025-10-31T17:00:00+00:00\\\",\\\"doors_close_date\\\":null}],\\\"streaming_options\\\":null,\\\"public_refund_policy\\\":{\\\"type\\\":\\\"cooling_off_enabled\\\",\\\"hours\\\":24},\\\"status\\\":\\\"sold-out\\\",\\\"marketeers\\\":[],\\\"donation\\\":null,\\\"price\\\":{\\\"currency\\\":\\\"GBP\\\",\\\"amount\\\":2700,\\\"sales_tax\\\":0,\\\"amount_from\\\":null},\\\"attendance_type\\\":\\\"live_only\\\",\\\"presented_by\\\":\\\"Presented by art’otel\\\",\\\"secondary_status\\\":\\\"waiting-list\\\",\\\"images\\\":{\\\"square\\\":\\\"https://dice-media.imgix.net/attachments/2025-10-06/5679cf79-a2e7-4d5e-b435-c26389140c1d.jpg?rect=944%2C0%2C5652%2C5652\\\",\\\"landscape\\\":\\\"https://dice-media.imgix.net/attachments/2025-10-06/5679cf79-a2e7-4d5e-b435-c26389140c1d.jpg?rect=0%2C565%2C7539%2C4523\\\",\\\"portrait\\\":\\\"https://dice-media.imgix.net/attachments/2025-10-06/5679cf79-a2e7-4d5e-b435-c26389140c1d.jpg?rect=2215%2C0%2C3109%2C5652\\\"},\\\"dates\\\":{\\\"timezone\\\":\\\"Europe/London\\\",\\\"announcement_date\\\":\\\"2025-10-07T07:45:00+01:00\\\",\\\"sale_end_date\\\":\\\"2025-10-31T15:00:00+00:00\\\",\\\"sale_start_date\\\":\\\"2025-10-07T07:45:00+01:00\\\",\\\"event_start_date\\\":\\\"2025-10-31T17:00:00+00:00\\\",\\\"event_end_date\\\":\\\"2025-11-01T06:00:00+00:00\\\",\\\"is_multi_days_event\\\":false,\\\"pre_sale_start_date\\\":null},\\\"billing_promoter\\\":{\\\"id\\\":\\\"1486\\\",\\\"name\\\":\\\"Alcopop! Records\\\",\\\"image\\\":{\\\"url\\\":null},\\\"perm_name\\\":\\\"alcopop-records-2oea\\\",\\\"profile_active\\\":false},\\\"tags_types\\\":[{\\\"name\\\":\\\"film\\\",\\\"value\\\":\\\"culture:film\\\",\\\"title\\\":\\\"Film\\\"}],\\\"seating\\\":null,\\\"properties\\\":[],\\\"faqs\\\":[],\\\"shopping_cart_enabled\\\":false,\\\"id\\\":\\\"68d406e1767f9e0001da43ec\\\",\\\"name\\\":\\\"Dusk 'til Dawn All Night Vampire Takeover\\\",\\\"offers_extras\\\":false,\\\"summary_lineup\\\":{\\\"top_artists\\\":[],\\\"total_artists\\\":0,\\\"total_free_texts\\\":0},\\\"about\\\":{\\\"description\\\":\\\"This Halloween, art’otel London Hoxton is set to host its first-ever all-night cinematic experience…\\\\n\\\\nFrom sundown on Halloween until sunrise on All Saints’ Day, the design-led hotel will transform its in-house cinema into a gothic hideaway for a 14-hour marathon of cult and classic vampire films — culminating, fittingly, with From Dusk Till Dawn as daylight breaks.\\\\n\\\\nThe curated line-up features Interview with the Vampire, The Lost Boys and From Dusk Till Dawn, with more titles to be revealed.\\\\n\\\\nFuel your night with a gloriously gory Kraken Rum “blood bag” cocktail, followed by a garlic-inspired feast fit for creatures of the night — with a selection of Brush Burger sliders, hearty Butternut Squash Curry boxes, and All-Garlic Flat Breads to help ward off evil spirits. A midnight feast of popcorn chicken with garlic dip and Korean glazed cauliflower will follow, with unlimited popcorn and pick’n’mix available throughout the night. Dawn survivors can enjoy breakfast and a bloody mary – a fitting reward for making it to sunrise.\\\\n\\\\nTickets are priced at £25 (with discounted options for hotel guests) and include 5 films, dinner, snacks and a welcome drink.\\\\n\\\\nTerms and conditions apply. 18+, UK only. The art’otel Dusk ‘til Dawn Vampire Movie Screening will be open for one night only from 5pm on 31st October to 6.30am on 1st November. Tickets are limited. Ticket price includes one welcome drink, an array of snacks, and 5 films. Customers will be responsible for their own travel.\\\",\\\"highlights\\\":[{\\\"type\\\":\\\"age_restriction\\\",\\\"title\\\":\\\"This is an 18+ event\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null},{\\\"type\\\":\\\"promoter\\\",\\\"title\\\":\\\"Presented by art’otel\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null}]},\\\"social_links\\\":{\\\"event_share\\\":\\\"https://link.dice.fm/wad3a16f472a?dice_id=wad3a16f472a\\\",\\\"post_competition_referral\\\":\\\"https://link.dice.fm/e7a89df4a3df?dice_id=e7a89df4a3df\\\",\\\"post_purchase_extras_available_referral\\\":\\\"https://link.dice.fm/S3c224e17145?dice_id=S3c224e17145\\\",\\\"post_purchase_referral\\\":\\\"https://link.dice.fm/m2e7891cea31?dice_id=m2e7891cea31\\\",\\\"post_reminder_referral\\\":\\\"https://link.dice.fm/T0249add02b7?dice_id=T0249add02b7\\\",\\\"post_waitinglist_referral\\\":\\\"https://link.dice.fm/ld16d1fe26ae?dice_id=ld16d1fe26ae\\\"},\\\"perm_name\\\":\\\"mxp7bk-dusk-til-dawn-all-night-vampire-takeover-31st-oct-artotel-london-hoxton-london-tickets\\\"},\\\"queryParams\\\":{},\\\"eventLoading\\\":false,\\\"ticketTypesLoading\\\":false},\\\"events\\\":{\\\"homeCityTopEventsLoading\\\":false},\\\"purchase\\\":{\\\"productType\\\":\\\"ticket\\\",\\\"cart\\\":{\\\"items\\\":[]},\\\"ticketsIncrements\\\":1,\\\"reservationTickets\\\":[],\\\"extraQty\\\":1,\\\"purchaseConfirmed\\\":{}},\\\"refund\\\":{\\\"loading\\\":false,\\\"step\\\":\\\"events\\\",\\\"ticketIds\\\":[],\\\"ticketExtrasIds\\\":[]},\\\"venues\\\":{},\\\"search\\\":{\\\"open\\\":false,\\\"value\\\":\\\"\\\"},\\\"waitingLists\\\":{\\\"ids\\\":[],\\\"entities\\\":{}},\\\"unlock\\\":{\\\"loading\\\":false,\\\"appliedCodes\\\":{}},\\\"musicLibrary\\\":{\\\"appleMusicConnecting\\\":false,\\\"spotifyConnecting\\\":false,\\\"justScanned\\\":false},\\\"browse\\\":{\\\"cities\\\":[{\\\"code\\\":\\\"saint_paul\\\",\\\"id\\\":\\\"689e4465a1805897071e2714\\\",\\\"name\\\":\\\"Saint Paul\\\",\\\"location\\\":{\\\"lat\\\":44.939589,\\\"lng\\\":-93.270863,\\\"accuracy\\\":12,\\\"place\\\":\\\"America/Chicago\\\"},\\\"perm_name\\\":\\\"saint_paul\\\",\\\"country_name\\\":\\\"United States of America\\\",\\\"country_id\\\":\\\"5982dffafa1614a04fe33793\\\",\\\"country_perm_name\\\":\\\"united-states-of-america\\\"},{\\\"code\\\":\\\"st_louis\\\",\\\"id\\\":\\\"67940e2c16ef2ae54597d632\\\",\\\"name\\\":\\\"St. Louis\\\",\\\"location\\\":{\\\"lat\\\":38.65315,\\\"lng\\\":-90.243616,\\\"accuracy\\\":12,\\\"place\\\":\\\"America/Chicago\\\"},\\\"perm_name\\\":\\\"st_louis\\\",\\\"country_name\\\":\\\"United States of America\\\",\\\"country_id\\\":\\\"5982dffafa1614a04fe33793\\\",\\\"country_perm_name\\\":\\\"united-states-of-america\\\"},{\\\"code\\\":\\\"MAR\\\",\\\"id\\\":\\\"5e4519cb663fe600219ccee2\\\",\\\"name\\\":\\\"Marseille\\\",\\\"location\\\":{\\\"lat\\\":43.2961743,\\\"lng\\\":5.3699525,\\\"accuracy\\\":12,\\\"place\\\":\\\"Europe/Paris\\\"},\\\"perm_name\\\":\\\"marseille\\\",\\\"country_name\\\":\\\"France\\\",\\\"country_id\\\":\\\"5b23e4b1f3c6455a19343