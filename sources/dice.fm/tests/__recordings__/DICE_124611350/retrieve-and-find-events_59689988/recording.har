.444-.445.718-.891.922-1.417.198-.509.333-1.09.372-1.941.039-.853.048-1.126.048-3.297 0-2.173-.01-2.445-.048-3.298-.039-.851-.174-1.432-.372-1.941a3.92 3.92 0 0 0-.922-1.417 3.92 3.92 0 0 0-1.417-.922c-.509-.198-1.09-.333-1.941-.372C14.442 4.01 14.169 4 11.998 4Zm0 1.441c2.135 0 2.388.008 3.231.047.78.035 1.203.165 1.485.275.373.145.64.318.92.598.28.28.453.546.598.92.11.282.24.705.275 1.485.039.843.047 1.096.047 3.232 0 2.135-.008 2.388-.047 3.231-.035.78-.166 1.203-.275 1.485-.145.373-.318.64-.598.92-.28.28-.547.453-.92.598-.282.11-.705.24-1.485.275-.843.039-1.096.047-3.231.047-2.136 0-2.389-.008-3.232-.047-.78-.035-1.203-.166-1.485-.275a2.478 2.478 0 0 1-.92-.598 2.477 2.477 0 0 1-.598-.92c-.11-.282-.24-.705-.275-1.485-.039-.843-.047-1.096-.047-3.231 0-2.136.008-2.389.047-3.232.035-.78.166-1.203.275-1.485.145-.374.318-.64.598-.92.28-.28.547-.453.92-.598.282-.11.705-.24 1.485-.275.843-.039 1.096-.047 3.232-.047Z\" clip-rule=\"evenodd\"></path><path fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M11.998 14.663a2.666 2.666 0 1 1 0-5.331 2.666 2.666 0 0 1 0 5.331Zm0-6.772a4.107 4.107 0 1 0 0 8.213 4.107 4.107 0 0 0 0-8.213ZM17.226 7.728a.96.96 0 1 1-1.92 0 .96.96 0 0 1 1.92 0Z\" clip-rule=\"evenodd\"></path></svg></a><a rel=\"noopener\" target=\"_blank\" title=\"Follow us on TikTok\" class=\"Footer__SocialLink-sc-b4b03d95-12 drMkyU\" href=\"https://www.tiktok.com/@dice.fm\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M15.293 4h-2.762v10.899a2.377 2.377 0 0 1-2.384 2.365 2.377 2.377 0 0 1-2.385-2.365c0-1.276 1.039-2.32 2.314-2.366V9.797C7.266 9.843 5 12.093 5 14.898 5 17.729 7.314 20 10.17 20c2.857 0 5.17-2.296 5.17-5.101V9.31A6.499 6.499 0 0 0 19 10.516V7.78c-2.078-.07-3.707-1.74-3.707-3.78Z\"></path></svg></a><a rel=\"noopener\" target=\"_blank\" title=\"Follow us on LinkedIn\" class=\"Footer__SocialLink-sc-b4b03d95-12 drMkyU\" href=\"https://www.linkedin.com/company/dice-fm