browse/london-54d8a23438fe5d27d500001c/culture/talks\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c\",\"active\":false},{\"id\":\"culture:film\",\"name\":\"Film\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c\",\"active\":true},{\"id\":\"culture:sport\",\"name\":\"Sport\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/sport\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c\",\"active\":false},{\"id\":\"culture:foodanddrink\",\"name\":\"Food \\u0026 drink\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/foodanddrink\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c\",\"active\":false},{\"id\":\"culture:podcast\",\"name\":\"Podcast\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/podcast\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c\",\"active\":false},{\"id\":\"music:artistsigning\",\"name\":\"Artist signing\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/music/artistsigning\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c\",\"active\":false},{\"id\":\"culture:wellbeing\",\"name\":\"Wellbeing\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/wellbeing\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c\",\"active\":false},{\"id\":\"music:playback\",\"name\":\"Playback\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/music/playback\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c\",\"active\":false}],\"secondaryFilters\":[{\"id\":\"film:classic\",\"name\":\"Classic\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film/classic\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film\",\"active\":false},{\"id\":\"film:comedy\",\"name\":\"Comedy\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film/comedy\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film\",\"active\":false},{\"id\":\"film:cult\",\"name\":\"Cult\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film/cult\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film\",\"active\":false},{\"id\":\"film:drama\",\"name\":\"Drama\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film/drama\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film\",\"active\":false},{\"id\":\"film:experimental\",\"name\":\"Experimental\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film/experimental\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film\",\"active\":false},{\"id\":\"film:fantasy\",\"name\":\"Fantasy\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film/fantasy\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film\",\"active\":false},{\"id\":\"film:filmnoir\",\"name\":\"Film noir\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film/filmnoir\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film\",\"active\":false},{\"id\":\"film:horror\",\"name\":\"Horror\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film/horror\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film\",\"active\":false},{\"id\":\"film:independent\",\"name\":\"Independent\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film/independent\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film\",\"active\":false},{\"id\":\"film:musical\",\"name\":\"Musical\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film/musical\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film\",\"active\":false},{\"id\":\"film:repertory\",\"name\":\"Repertory\",\"activateLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film/repertory\",\"clearLink\":\"/browse/london-54d8a23438fe5d27d500001c/culture/film\",\"active\":false},{\"i