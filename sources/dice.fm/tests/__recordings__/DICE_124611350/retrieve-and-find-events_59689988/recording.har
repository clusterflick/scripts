lState\":\"{\\\"auth\\\":{\\\"isValidating\\\":true,\\\"isRestored\\\":false,\\\"isNewUser\\\":false},\\\"experiments\\\":{},\\\"flow\\\":{\\\"loading\\\":false,\\\"channel\\\":\\\"email\\\",\\\"availableChannels\\\":[]},\\\"artists\\\":{},\\\"promoters\\\":{},\\\"tickets\\\":{\\\"isLoading\\\":false},\\\"event\\\":{\\\"event\\\":{\\\"seating\\\":null,\\\"attendance_type\\\":\\\"live_only\\\",\\\"summary_lineup\\\":{\\\"top_artists\\\":[],\\\"total_artists\\\":0,\\\"total_free_texts\\\":0},\\\"marketeers\\\":[{\\\"id\\\":12,\\\"name\\\":\\\"The Clapham Grand\\\",\\\"privacy_policy_link\\\":\\\"https://claphamgrand.com/privacy-policy/\\\",\\\"fb_pixel_id\\\":\\\"1705644923004016\\\",\\\"ga_tracking_id\\\":\\\"UA-5134978-1\\\",\\\"tiktok_pixel_id\\\":null,\\\"twitter_pixel_id\\\":null,\\\"twitter_checkout_initiated_pixel_id\\\":null,\\\"twitter_purchase_pixel_id\\\":null,\\\"google_ads_conversion_id\\\":null,\\\"google_ads_purchase_conversion_label\\\":null,\\\"show_web_opt_in_form\\\":true,\\\"show_opt_in_form\\\":true,\\\"opt_out_as_default\\\":false}],\\\"has_multiple_ticket_types\\\":true,\\\"seats_io_event_id\\\":null,\\\"date_unix\\\":1761933600,\\\"properties\\\":[],\\\"shopping_cart_enabled\\\":false,\\\"announcement_date_unix\\\":1755680400,\\\"unicorn\\\":false,\\\"social_links\\\":{\\\"event_share\\\":\\\"https://link.dice.fm/G8754682d7be?dice_id=G8754682d7be\\\",\\\"post_competition_referral\\\":\\\"https://link.dice.fm/e203e261f69e?dice_id=e203e261f69e\\\",\\\"post_purchase_extras_available_referral\\\":\\\"https://link.dice.fm/u3370e1c821c?dice_id=u3370e1c821c\\\",\\\"post_purchase_referral\\\":\\\"https://link.dice.fm/ie4eeec3543e?dice_id=ie4eeec3543e\\\",\\\"post_reminder_referral\\\":\\\"https://link.dice.fm/Vd1c0774f57e?dice_id=Vd1c0774f57e\\\",\\\"post_waitinglist_referral\\\":\\\"https://link.dice.fm/l86f26af622e?dice_id=l86f26af622e\\\"},\\\"about\\\":{\\\"description\\\":\\\"**It’s nearly time to do The Time Warp… again! Our Rocky Horror Movie Night is back and on actual Halloween too 🎃 Celebrate 50 years of this iconic film with us this October!**\\\\n\\\\n**DOORS: 6PM / LIVE SHOW \\u0026 MOVIE FROM 7PM / LAST ENTRY 8PM**\\\\n\\\\n**Over 70% sold out! Grab final release tickets for £25 now.**\\\\n\\\\nCome give yourself over to maximum pleasure… 🫦\\\\n\\\\nDust off those corsets and pink rubber gloves. Grab your emergency supply of Newspapers, loo roll, confetti, water pistols and toast and get your sweet transvestite arses down to the biggest \\u0026 best Rocky Horror Picture Show screening in London, UK, hell THE WORLD 🌏\\\\n\\\\nSing-A-Long to the movie on a massive 25ft screen 📺  \\\\nYour Frank-N-Furter host - Drag Star Miss Leigh Ding! 👠  \\\\nOur Dreamteam showteam 🕺  \\\\nThe Sweetest Transvestite costume comp \\u0026 Damn It Janet dance-offs ☠️  \\\\nCamp cocktails 🍹  \\\\nFrank N Furter hotdogs \\u0026 nachos (Vegan goodness too!) 🌭  \\\\nOooky-spooky decor 🏚️  \\\\nPopcorn ONLY £3 🍿  \\\\n\\u0026 The Time Warp. Again \\u0026 Again \\u0026 Again! 🕺💃\\\\n\\\\nFeel free to sing-along, heckle the bad guys and cheer for your heroes, a costume is never un-appreciated (in fact we often give out prizes for the best or worst), the bar \\u0026 food stalls stay open during the movie.\\\\n\\\\nYour ticket includes entry to The Grand’s Halloween Party, too! Please note that last entry is 8pm and there is no re-entry between events.\\\\n\\\\nFor any ticketing enquiries, please contact DICE’s Help Centre. Please note, all our Movie Nights are 18+.\\\\n\\\\nFor any show / venue info, please contact info@claphamgrand.com\\\\n\\\\nFor any accessibility requirements / tickets, please contact access@claphamgrand.com\\\",\\\"highlights\\\":[{\\\"type\\\":\\\"age_restriction\\\",\\\"title\\\":\\\"This is an 18+ event\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null},{\\\"type\\\":\\\"promoter\\\",\\\"title\\\":\\\"Presented by The Clapham Grand.\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null}]},\\\"is_hidde