"properties\":[],\"seating\":null,\"perm_name\":\"rybnxw-the-holiday-drink-along-movie-night-11th-dec-the-clapham-grand-london-tickets\",\"secondary_status\":null,\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"seats_io_public_key\":null,\"status\":\"on-sale\",\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"donation\":null,\"tty_to_extras\":[],\"previews\":[{\"type\":\"apple_music\",\"title\":\"The Killers - Mr. Brightside\",\"redirect_url\":\"https://music.apple.com/us/album/mr-brightside/1526194184?i=1526194192\\u0026uo=4\\u0026at=1001ld8Z\\u0026ct=app_event\",\"artist\":\"The Killers\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/5c/95/cf/5c95cf3a-bef3-97e7-b6aa-3adde55deb30/mzaf_15328769143459778457.plus.aac.p.m4a\",\"track_name\":\"Mr. Brightside\"}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1000},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Killers\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2020-05-13/b6fbf9f5-6439-4fe3-9161-712498b3376b.jpg?rect=276%2C0%2C832%2C832\"},\"artist_id\":\"20466\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"date_unix\":1765477800,\"about\":{\"description\":\"**DOORS: 6.30PM / PRE-SHOW \\u0026 GAMES: 7.15PM / MOVIE 7.30PM**\\n\\nWhat better way to kick start the holiday season than The Holiday Drink-A-Long Movie Night (\\u0026 seeing Cameron Diaz run towards the sexy, glasses wearing DILF, Jude Law, through the snow in her heels!)\\n\\nWe will have Pigs in blankets, mulled wine, mince pies and of course blankets for the cold and old for that christmassy cosy feeling! Even Kate Winslet will be there! Okay maybe not there physically but, in spirit and cardboard form for sure! It's a night of love, Christmas cheer and drinking until we all dance like we're in a remote cottage screaming the words to Mr Brightside!\\n\\nExpect:\\n\\n- The movie on our massive screen 📺\\n- Snow machines, confetti \\u0026 balloon drops ❄️\\n- Live host \\u0026 show team 🕺\\n- Singalong carols, games \\u0026 dance-offs 🎄\\n- Prizes for best costumes 🏆\\n- The Grand’s cocktails \\u0026 mulled wine 🍷\\n- Pigs in blankets, hotdogs \\u0026 nachos, courtesy of Hot Beige (yes, veganny goodness too!) 🐷\\n- Popcorn for £3 🍿\\n\\nOur Christmas Movie Nights are like no other, alongside watching the movie uninterrupted on our massive (25 ft!) HD Screen, we have a whole lot more in store for you before \\u0026 after the film, including The Grand's live hosts \\u0026 show team, mulled wine, mince pies, confetti, snow machines, the occasional balloon drop 🎈\\n\\nFeel free to sing-along, heckle the bad guys and cheer for your heroes, a costume is never un-appreciated (in fact we often give out prizes for the best or worst), the bar \\u0026 food stalls stay open during the movie and sometimes afterwards there’s a club night to top things off! Super Important Movie Night Deets:\\n\\n**TICKETS** 🎟 For any ticketing queries please visit the DICE Help Centre\\n\\n**AGE RESTRICTIONS** 😉 We are afraid our Movie Nights are for over 18s, the films might be suitable for kids, but our show teams humour might not be!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"shopping_cart_enabled\":false,\"impression_id\":\"69e80567daaaa992:17\",\"offers_extras\":false,\"acquisition_type\":\"purchase\",\"has_multiple_ticket_types\":true,\"presented_by\":\"Presented by The Clapham Grand.\",\"announcement_date_unix\":1758542400,\"streaming_options\":null,\"id\":\"68d16c1a5f66760001b279b0\",\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"name\":\"The Holiday Drink-Along Movie Night \",\"new\":false,\"faqs\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/F36af960de3f?dice_id=F36af960de3f\",\"post_competition_referral\":\"https://link.dice.fm/B9f751e18dae?dice_id=B9f751e18dae\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/aa761943c224?dice_id=aa761943c224\",\"post_purchase_referral\":\"https://link.dice.fm/Y12a240add67?dice_id=Y12a240add67\",\"post_reminder_referral\":\"https://link.dice.fm/j273e9b97015?dice_id=j273e9b97015\",\"post_waitinglist_referral\":\"https://link.dice.fm/a4cf650c5de7?dice_id=a4cf650c5de7\"},\"score\":0,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-22T13:00:00+01:00\",\"sale_end_date\":\"2025-12-11T19:00:00+00:00\",\"sale_start_date\":\"2025-09-23T17:00:00+01:00\",\"event_start_date\":\"2025-12-11T18:30:00+00:00\",\"event_end_date\":\"2025-12-11T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"event_tag\":null},{\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/faq-type/access-questions/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2025-12-13T18:00:00+00:00\",\"doors_close_date\":null}],\"is_hidden_event\":false,\"seats_io_event_id\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"max_tickets\":12,\"attendance_type\":\"live_only\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-23/aeab81da-a9b9-4a3f-a787-548b9ad0941d.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-23/aeab81da-a9b9-4a3f-a787-548b9ad0941d.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-23/aeab81da-a9b9-4a3f-a787-548b9ad0941d.jpg?rect=270%2C0%2C660%2C1200\"},\"is_fully_locked\":false,\"properties\":[],\"seating\":null,\"perm_name\":\"bby3wk-love-actually-drink-along-movie-night-xmas-disco-13th-dec-the-clapham-grand-london-tickets\",\"secondary_status\":null,\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"seats_io_public_key\":null,\"status\":\"on-sale\",\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"donation\":null,\"tty_to_extras\":[],\"previews\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1500},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"date_unix\":1765648800,\"about\":{\"description\":\"**DOORS: 6PM / LIVE SHOW \\u0026 GAMES: 7PM / MOVIE 7.15PM / XMAS DISCO AFTER PARTY 9:15PM**\\n\\n“If you look for it, we’ve got a sneaky feeling you’ll find that Love, Christmas and Drinking are all around us…” Even if you do have to try and squeeze an extra syllables to make it work 😂\\n\\nOur Love Actually Movie Nights are legendary! We’ll be bringing back our world famous ‘Ant or Dec’ competition, the prosecco-tastic drink-along, prizes for best fancy dress, all the Lobster Octopus outfits, countless crowdsurfing Hugh Grant cardboard cut outs, a cheeky mini xmas disco \\u0026 the movie on our ENORMOUS screen! 🎬\\n\\nExpect:\\n\\nThe movie on our massive screen 📺\\n\\nSnow machines, confetti \\u0026 balloon drops ❄️\\n\\nLive host \\u0026 show team 🕺\\n\\nSingalong carols, games \\u0026 dance-offs 🎄\\n\\nPrizes for best costumes 🏆\\n\\nThe Grand’s cocktails \\u0026 mulled wine 🍷\\n\\nPigs in blankets, hotdogs \\u0026 nachos, courtesy of Hot Beige (yes, veganny goodness too!) 🐷\\n\\nPopcorn for £3 🍿\\n\\nOur Christmas Movie Nights are like no other, alongside watching the movie uninterrupted on our massive (25 ft!) HD Screen, we have a whole lot more in store for you before \\u0026 after the film, including The Grand's live hosts \\u0026 show team, mulled wine, mince pies, confetti, snow machines, the occasional balloon drop 🎈\\n\\nFeel free to sing-along, heckle the bad guys and cheer for your heroes, a costume is never un-appreciated (in fact we often give out prizes for the best or worst), the bar \\u0026 food stalls stay open during the movie and sometimes afterwards there’s a club night to top things off! Super Important Movie Night Deets:\\n\\n**TICKETS** 🎟 For any ticketing queries please visit the DICE Help Centre\\n\\n**AGE RESTRICTIONS** 😉 We are afraid our Movie Nights are for over 18s, the films might be suitable for kids, but our show teams humour might not be!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"shopping_cart_enabled\":false,\"impression_id\":\"69e80567daaaa992:18\",\"offers_extras\":false,\"acquisition_type\":\"purchase\",\"has_multiple_ticket_types\":true,\"presented_by\":\"Presented by The Clapham Grand.\",\"announcement_date_unix\":1758542400,\"streaming_options\":null,\"id\":\"68d16d3d6ae6f700014b75b3\",\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"name\":\"Love Actually Drink-Along Movie Night \\u0026 Xmas Disco\",\"new\":false,\"faqs\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/O7bec1963ed8?dice_id=O7bec1963ed8\",\"post_competition_referral\":\"https://link.dice.fm/F640b8777b7c?dice_id=F640b8777b7c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Oc7da4508adc?dice_id=Oc7da4508adc\",\"post_purchase_referral\":\"https://link.dice.fm/J46070505913?dice_id=J46070505913\",\"post_reminder_referral\":\"https://link.dice.fm/Rd8b491f6017?dice_id=Rd8b491f6017\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ra0fd7ace850?dice_id=Ra0fd7ace850\"},\"score\":0,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-22T13:00:00+01:00\",\"sale_end_date\":\"2025-12-13T19:00:00+00:00\",\"sale_start_date\":\"2025-09-23T17:00:00+01:00\",\"event_start_date\":\"2025-12-13T18:00:00+00:00\",\"event_end_date\":\"2025-12-13T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"event_tag\":null},{\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/faq-type/access-questions/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-01-09T18:00:00+00:00\",\"doors_close_date\":null}],\"is_hidden_event\":false,\"seats_io_event_id\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"max_tickets\":12,\"attendance_type\":\"live_only\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-27/3a8ce5b5-f975-48a1-8da7-24b4cb021bb2.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-27/3a8ce5b5-f975-48a1-8da7-24b4cb021bb2.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-27/3a8ce5b5-f975-48a1-8da7-24b4cb021bb2.jpg?rect=243%2C0%2C594%2C1080\"},\"is_fully_locked\":false,\"properties\":[],\"seating\":null,\"perm_name\":\"eodx2w-labyrinth-movie-night-and-a-bowie-disco-9th-jan-the-clapham-grand-london-tickets\",\"secondary_status\":\"rescheduled\",\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"seats_io_public_key\":null,\"status\":\"on-sale\",\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"donation\":null,\"tty_to_extras\":[],\"previews\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1500},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"date_unix\":1767981600,\"about\":{\"description\":\"**Join our fabulous, annual, Labyrinth Movie Night on Fri 9th January 2026!**\\n\\n**DOORS: 6PM**  \\n**SHOW: 7PM**  \\n**MOVIE: 7:30PM**  \\n**CURFEW: 10:30PM**\\n\\nCome join us, Jareth, Hoggle, Ludo, Sarah \\u0026 the gang deep inside Jim Henson cult classic Labyrinth on our MASSIVE SCREEN alongside all our Movie Night magic 🎬 ...\\\"You remind me of the babe……” 🔮\\n\\nWe’ll be bringing back our world famous Dance Magic Dance-Off, there’s prizes for the best fancy dress in the Goblin King Costume Parade, free Star Man make up Make Overs, Themed Cocktails (bog of eternal stench fish bowl anyone...) and we will finish the evening with a Mini Bowie Disco of your fave Bowie classics other 70s \\u0026 80s bangers! What better way to celebrate what would be the great man’s Birthday Weekend! 🎂\\n\\nExpect:\\n\\n- Movie on our massive 25ft screen 📺\\n- Our Dreamteam show hosts and dancers ⚡️\\n- Dance magic dance-offs 💃\\n- Goblin King costume comp 🥇\\n- The Grand’s themed cocktails 🍹\\n- Hotdogs \\u0026 nachos courtesy of Hot Beige (Vegan goodness, too) 🌭\\n- Popcorn for £3 🍿\\n\\nOur Movie Nights are like no other, alongside watching Labyrinth uninterrupted on our massive (25 ft!) HD Screen, we have a whole lot more in store for you before \\u0026 after the film, including The Grand’s Dreamteam hosts \\u0026 show team, all the confetti, games and even the occasional balloon drop. 🎈\\n\\nFeel free to sing-along, heckle the bad guys and cheer for your heroes, a costume is never un-appreciated (in fact we often give out prizes for the best or worst), the bar \\u0026 food stalls stay open during the movie and sometimes afterwards there’s a club night to top things off!\\n\\n**Super Important Movie Night Deets:**\\n\\n**TICKETS 🎟**\\n\\nFor any ticketing queries please contact http://dice.fm/contact\\n\\n**AGE RESTRICTIONS 😉**\\n\\nWe are afraid our Movie Nights are for over 18’s, the films might be suitable for kids, but our show teams humour might not be!\\n\\n**TIMES ⏰**\\n\\nDoors at 6:30pm and the fun starts about 7.30pm, we advise arrival before 7pm so give you time to be seated by our ushers and grab food and drink from the bars. The movie will start around 8pm, and there is a cheeky Bowie disco until about 12am.\\n\\n**SEATING 🪑**\\n\\nStalls \\u0026 Circle seating is unreserved and allocated on a first come first served basis across these areas. Upper Circle seating is allocated first come first served basis across this area. There are as many seats as there are tickets sold so please don’t panic about getting one\\n\\n**ROYAL BOXES \\u0026 TABLES 👑**\\n\\nRoyal Boxes \\u0026 Tables will be reserved for you, and we hold them all until an hour after doors open. Please notify us in advance if you’re running late as we will offer to other customers once the movie starts.\\n\\n**SUBTITLES 👀**\\n\\nWe aim to make our Movie Nights an enjoyable experience for everyone, and will show our Movie’s with subtitles on if requested by any hard of hearing customers, please email us if this is required info@claphamgrand.com\\n\\n**ACCESSIBILITY TICKETS 📧**\\n\\nFor any accessibility requirements or tickets, please contact info@claphamgrand.com, where you shall receive a code to access and pay for your tickets. (availability depending)\\n\\n**VENUE ACCESSIBILITY ♿️**\\n\\nFor any accessibility assistance coming to our venue, please don’t hesitate to contact us in advance so we can make sure we can facilitate this: info@claphamgrand.com. We have a fully wheelchair accessible toilet, located in our gender neutral bathroom in the stalls, and we have step free access into the stalls.\\n\\n**CLOAKROOM 🧥**\\n\\nWe have a cloakroom here, which was voted in the top 5 cloakrooms in the UK for the last 10 years, and it’s £2.50 an item.\\n\\n**PARKING / GETTING HERE 🚂 🚗 🚌**\\n\\nWe don’t have any parking at venue (these Victorians only had horses and carts), but we are directly opposite Clapham Junction, (Europes busiest train station!) and there are parking spaces available there from www.justpark.com and we are on so many bus routes!\\n\\n**FAQ'S ❓**\\n\\nFor any other questions, please refer to FAQ page – https://claphamgrand.com/faqs\\n\\n**SPECIAL EFFECTS WARNING 🎉 🎈🚥 ⚠️**\\n\\nPlease note there will be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us via info@claphamgrand.com – we want to make sure you have a safe experience with us!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"shopping_cart_enabled\":false,\"impression_id\":\"69e80567daaaa992:19\",\"offers_extras\":false,\"acquisition_type\":\"purchase\",\"has_multiple_ticket_types\":true,\"presented_by\":\"Presented by The Clapham Grand.\",\"announcement_date_unix\":1736791200,\"streaming_options\":null,\"id\":\"678512f91583a20001ccc867\",\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"name\":\"Labyrinth Movie Night and A Bowie Disco!\",\"new\":false,\"faqs\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/If5f561a2b64?dice_id=If5f561a2b64\",\"post_competition_referral\":\"https://link.dice.fm/Ta2cb9da3d39?dice_id=Ta2cb9da3d39\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/bd180f2ecff3?dice_id=bd180f2ecff3\",\"post_purchase_referral\":\"https://link.dice.fm/K362fa5e3825?dice_id=K362fa5e3825\",\"post_reminder_referral\":\"https://link.dice.fm/ce20343b63ff?dice_id=ce20343b63ff\",\"post_waitinglist_referral\":\"https://link.dice.fm/f0dcef8fa310?dice_id=f0dcef8fa310\"},\"score\":0,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-01-13T18:00:00+00:00\",\"sale_end_date\":\"2026-01-09T18:00:00+00:00\",\"sale_start_date\":\"2025-01-13T18:00:00+00:00\",\"event_start_date\":\"2026-01-09T18:00:00+00:00\",\"event_end_date\":\"2026-01-09T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"event_tag\":null},{\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/faq-type/access-questions/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-01-17T11:30:00+00:00\",\"doors_close_date\":null}],\"is_hidden_event\":false,\"seats_io_event_id\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"max_tickets\":12,\"attendance_type\":\"live_only\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-24/7702253d-02bf-44de-b647-771c1f5c273a.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-24/7702253d-02bf-44de-b647-771c1f5c273a.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-24/7702253d-02bf-44de-b647-771c1f5c273a.jpg?rect=243%2C0%2C594%2C1080\"},\"is_fully_locked\":false,\"properties\":[],\"seating\":null,\"perm_name\":\"k6orqo-high-school-musical-movie-3-bottomless-brunch-party-17th-jan-the-clapham-grand-london-tickets\",\"secondary_status\":null,\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"seats_io_public_key\":null,\"status\":\"on-sale\",\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"donation\":null,\"tty_to_extras\":[],\"previews\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1900},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"date_unix\":1768649400,\"about\":{\"description\":\"**Enjoy High School Musical 3 as we bring this cult classic back for one day only, on Sat 17th January 2026 🌟**\\n\\nThey went viral on TikTok last year and over 4,500 Disney Channel lovers have already come to party with us before… So, gather your fellow Wild Cats for:\\n\\nAn hour of bottomless booze 🍾  \\nThe whole movie on our big-ass screen! 📽️  \\nWe’re All In This Together mass sing-a-longs🎙️  \\nDisney Channel Mini Disco 🕺  \\nShow stopping performances from our Wild Cat Dreamteam 🤩  \\nPrizes for the Best Costumes 👗  \\nGet’cha Head in the Game Competition 🏆  \\nHotdogs \\u0026 Nachos courtesy of Hot Beige, even vegan goodness too! 🌭  \\nPopcorn for £3 🍿\\n\\n**IMPORTANT INFO:**\\n\\nDoors: 12PM  \\nBottomless hour: 12:30-1:30PM  \\nMovie, Show, Games: 1-3:30PM  \\nMini Disney Disco: until close at 4:15PM  \\nLast Entry 1pm\\n\\nFor any ticketing or accessibility assistance, please email info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help!\\n\\nFor any accessibility requests, please contact access@claphamgrand.com or call us on 020 7223 6523 to discuss how we can best support you.\\n\\nFor any other questions, please contact us on info@claphamgrand.com or visit our FAQ page.\\n\\nAge restrictions for shows with us vary on an event by event basis. Please check the event description and if in doubt email us on info@claphamgrand.com.\\n\\nPlease note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"shopping_cart_enabled\":false,\"impression_id\":\"69e80567daaaa992:20\",\"offers_extras\":false,\"acquisition_type\":\"purchase\",\"has_multiple_ticket_types\":true,\"presented_by\":\"Presented by The Clapham Grand.\",\"announcement_date_unix\":1755100800,\"streaming_options\":null,\"id\":\"68c9359bce06170001f66fa7\",\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"name\":\"High School Musical Movie 3 Bottomless Brunch Party!\",\"new\":false,\"faqs\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/x4cb32773b62?dice_id=x4cb32773b62\",\"post_competition_referral\":\"https://link.dice.fm/Ca4d825f536b?dice_id=Ca4d825f536b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/La6050fde709?dice_id=La6050fde709\",\"post_purchase_referral\":\"https://link.dice.fm/J6a6e95c86b6?dice_id=J6a6e95c86b6\",\"post_reminder_referral\":\"https://link.dice.fm/Cdb92bb74f8c?dice_id=Cdb92bb74f8c\",\"post_waitinglist_referral\":\"https://link.dice.fm/z2bf28897657?dice_id=z2bf28897657\"},\"score\":0,\"dates\":{\"t