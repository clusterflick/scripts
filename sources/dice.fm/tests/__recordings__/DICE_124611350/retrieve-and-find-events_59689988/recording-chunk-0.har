=1 1x,https://dice-media.imgix.net/attachments/2025-12-01/f5aac8b6-8756-4983-b532-b0a7ae1e1421.jpg?rect=0%2C0%2C1080%2C1080&amp;auto=format%2Ccompress&amp;q=40&amp;w=328&amp;h=328&amp;fit=crop&amp;crop=faces%2Ccenter&amp;dpr=2 2x\" src=\"https://dice-media.imgix.net/attachments/2025-12-01/f5aac8b6-8756-4983-b532-b0a7ae1e1421.jpg?rect=0%2C0%2C1080%2C1080&amp;auto=format%2Ccompress&amp;q=80&amp;w=328&amp;h=328&amp;fit=crop&amp;crop=faces%2Ccenter\" alt=\"\" width=\"100\" height=\"100\" class=\"EventDetailsImage__Image-sc-869461fe-1 dASjvH\"/><div class=\"EventDetailsImage__Actions-sc-869461fe-2 eTOTSO\"><button disabled=\"\" class=\"ButtonBase-sc-85d4fc6-0 Button-sc-2202b5a-0 EventAddToInterests__Container-sc-eaf23920-0 kmEjJP ccUWLm gBqHEB\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" viewBox=\"0 0 24 24\"><path stroke=\"currentColor\" d=\"M9.045 6.5C7.087 6.5 5.5 8.112 5.5 10.1c0 3 2.955 5.4 6.5 8.4 3.546-3 6.5-5.4 6.5-8.4 0-1.988-1.587-3.6-3.546-3.6-1.233 0-2.319.64-2.954 1.61A3.529 3.529 0 0 0 9.045 6.5Z\"></path></svg></button><div class=\"EventDetailsShare__Wrapper-sc-82d3796d-0 gktXVN\"><button class=\"ButtonBase-sc-85d4fc6-0 Button-sc-2202b5a-0 EventDetailsShare__Container-sc-82d3796d-1 kmEjJP ccUWLm dcfTQd\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" viewBox=\"0 0 24 24\"><path stroke=\"currentColor\" stroke-linecap=\"square\" d=\"M18.5 13.5v5h-13v-5m6.5 1V5m0 0L8.5 8.5M12 5l3.5 3.5\"></path></svg></button></div></div></div><div class=\"EventDetailsLayout__TabletContent-sc-2554ecc8-4 KUQsK\"><div class=\"EventDetailsFAQ__Container-sc-7130cefd-1 kjqLCB\"><p>DICE protects fans and artists from touts. Tickets will be securely stored in the app.</p><p class=\"EventDetailsFAQ__NoSmartphone-sc-7130cefd-0 dbVqMc\">No smartphone? No worries, check our <a target=\"_blank\" rel=\"noreferrer\" href=\"https://dicefm.zendesk.com/hc/articles/19414143889169-How-to-access-your-tickets-if-you-can-t-get-on-the-app\">FAQs</a></p></div><div class=\"EventDetailsGotCode__Container-sc-2d693cc1-0 ebDKho\"><a>Got a code?</a></div></div></div><div class=\"EventDetailsLayout__Content-sc-2554ecc8-3 fdCOWm\"><div class=\"EventDetailsTitle__Container-sc-cac69206-5 jisTAL\"><h1 class=\"EventDetailsTitle__Title-sc-cac69206-0 duXLSp\">The Mummy Movie Night</h1><div class=\"EventDetailsTitle__Venues-sc-cac69206-1 iqTKlf\"><a href=\"/venue/the-clapham-grand-ry8v\">The Clapham Grand</a></div><div class=\"EventDetailsTitle__Date-sc-cac69206-2 kDgXil\">Fri, 30 Jan, 6:30 pm</div><div class=\"EventDetailsTitle__Tags-sc-cac69206-4 cfoWLz\"><span class=\"EventDetailsTitle__Tag-sc-cac69206-3 hFGqZr\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" viewBox=\"0 0 24 24\"><path stroke=\"currentColor\" stroke-linecap=\"square\" d=\"m13.5 19.5-8-8v-6h6l8 8-6 6Z\"></path><path stroke=\"currentColor\" stroke-linecap=\"square\" d=\"M9 7.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Z\"></path></svg><span>Theatre</span></span><span class=\"EventDetailsTitle__Tag-sc-cac69206-3 hFGqZr\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" viewBox=\"0 0 24 24\"><path stroke=\"currentColor\" stroke-linecap=\"square\" d=\"M10.774 18.763c.262.283.48.509.634.664.194.196.393.385.592.576.199-.19.398-.38.592-.576a30.327 30.327 0 0 0 2.557-2.957c.7-.927 1.407-1.993 1.941-3.094.532-1.095.91-2.26.91-3.376a6 6 0 0 0-12 0c0 1.116.378 2.28.91 3.376.534 1.101 1.242 2.167 1.94 3.094.701.928 1.4 1.727 1.924 2.293ZM12 8a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z\" clip-rule=\"evenodd\"></path></svg><span>London</span></span></div></div><div class=\"EventDetailsLayout__MobileContent-sc-2554ecc8-5 fAoBgn\"></div><div class=\"EventDetailsCallToAction__Container-sc-fe1abec0-0 hOlIln\"><div class=\"EventDetailsCallToAction__PriceRow-sc-fe1abec0-1 bxORyQ\"><div class=\"EventDetailsCallToAction__Price-sc-fe1abec0-6 eQzmFy\"><span>From £10</span><small>The price you&#x27;ll pay. No surprises later.</small></div><button disabled=\"\" loading=\"1\" class=\"ButtonBase-sc-85d4fc6-0 Button-sc-2202b5a-0 EventDetailsCallToAction__ActionButton-sc-fe1abec0-5 kmEjJP chuNsq cOKqDM\"><div class=\"Loader-sc-e02fc997-0 cGAjfq\"></div></button></div></div><div class=\"EventDetailsLayout__MobileContent-sc-2554ecc8-5 fAoBgn\"><div class=\"EventDetailsBase__HR-sc-d40475af-3 eSgOkc\"></div><div class=\"EventDetailsGotCode__Container-sc-2d693cc1-0 ebDKho\"><a>Got a code?</a></div></div><div class=\"EventDetailsAbout__Container-sc-30f2e22-2 eooFSq\"><h2>About</h2><div class=\"EventDetailsAbout__Text-sc-30f2e22-1 dSUZCJ\"><div class=\"TruncatedMarkdown__Wrapper-sc-30f4de94-0 cEPNdr\"><div class=\"TruncatedMarkdown__Truncated-sc-30f4de94-2 iyvFjU\"><p><strong>FRIDAY 30 JANUARY / DOORS 6.30PM / MOVIE FROM 7.30PM</strong></p>\n<p><strong>Oh, we&#x27;ve dreamt about this since we were little!</strong></p>\n<p>Join us for the cult classic 🤩</p>\n<p>Look, we... We may not be explorers or adventurers, or treasure-seekers or gunfighters, but we&#x27;re proud of what we are...</p><button type=\"button\" class=\"TruncatedMarkdown__MoreButton-sc-30f4de94-1 lbefHP\">Read more</button></div></div></div><div class=\"EventDetailsBase__Highlights-sc-d40475af-2 dXmIOz\"><div class=\"EventDetailsBase__Highlight-sc-d40475af-0 dVKeAb\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" viewBox=\"0 0 24 24\"><path stroke=\"currentColor\" stroke-linecap=\"square\" d=\"M10.5 10.5H12v5m-1.5 0H12m0 0h1.5m-1.5-7V8m7.5 4a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z\"></path></svg><div><span>This is an 18+ event</span><small></small></div></div><div class=\"EventDetailsBase__Highlight-sc-d40475af-0 dVKeAb\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" viewBox=\"0 0 24 24\"><path stroke=\"currentColor\" stroke-linecap=\"square\" d=\"M8.5 14.5h-3v-5h5m-2 5v4m0-4h2m0 0 7 4v-13l-7 4m0 5v-5m9 1v3\"></path></svg><div><span>Presented by The Clapham Grand.</span><small></small></div></div><div class=\"EventDetailsBase__Highlight-sc-d40475af-0 EventDetailsBase__RefundPolicyHighlight-sc-d40475af-1 dVKeAb hDpyKl\"><div class=\"EventDetailsAbout__CurrencyIconWrapper-sc-30f2e22-0 kzRnMR\"><div class=\"CurrencyIcon__Currency-sc-8c04e303-0 jMba-DY\">£</div></div><div data-nosnippet=\"true\"><span>You can <a href=\"https://dice.fm/help/article?id=4409603669777\" target=\"_blank\">get a refund</a> if:</span><ul><li>It’s within 24 hours of buying tickets</li><li>This event is rescheduled or cancelled</li></ul></div></div><div class=\"EventDetailsBase__Highlight-sc-d40475af-0 dVKeAb\">You can&#x27;t get a refund within 24 hours of the event start time.</div></div></div><div class=\"EventDetailsBase__HR-sc-d40475af-3 eSgOkc\"></div><div class=\"EventDetailsVenue__Container-sc-42637e02-3 eaTxFY\"><div class=\"EventDetailsVenue__Wrapper-sc-42637e02-4 ejLGHr\"><div class=\"EventDetailsVenue__Info-sc-42637e02-7 gvBOAI\"><h3>Venue</h3><h2><a href=\"/venue/the-clapham-grand-ry8v\">The Clapham Grand</a></h2><div class=\"EventDetailsVenue__Address-sc-42637e02-5 cxsjwk\"><span>The Clapham Grand, 21-25 St John&#x27;s Hill, London SW11 1TT, UK</span><a title=\"Copy to clipboard\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" viewBox=\"0 0 24 24\"><path stroke=\"currentColor\" stroke-linecap=\"square\" d=\"M7.5 9.5h-2v9h9v-2m-5-11h9v9h-9v-9Z\"></path></svg></a></div><div class=\"EventDetailsVenue__VenueButtons-sc-42637e02-6 iigsgH\"><a href=\"https://maps.google.com/?q=The%20Clapham%20Grand%2C%20The%20Clapham%20Grand%2C%2021-25%20St%20John&#x27;s%20Hill%2C%20London%20SW11%201TT%2C%20UK&amp;ll=51.4629923,-0.169368800000029\" target=\"_blank\" rel=\"noreferrer\" class=\"ButtonBase-sc-85d4fc6-0 Button-sc-2202b5a-0 EventDetailsVenue__OpenInMaps-sc-42637e02-1 kmEjJP bVFZDM hwYvxh\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" viewBox=\"0 0 24 24\"><p