\":\"QT\",\"address\":\"66 Great Queen Street, Camden, London, WC2B 5BX, United Kingdom\",\"location\":{\"lat\":51.51584,\"lng\":-0.12026},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"qt-8ea25\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-01-31T18:00:00+00:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"previews\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/R936d048591c?dice_id=R936d048591c\",\"post_competition_referral\":\"https://link.dice.fm/l7f0613fefa9?dice_id=l7f0613fefa9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Af1883e4ed8a?dice_id=Af1883e4ed8a\",\"post_purchase_referral\":\"https://link.dice.fm/p3e7200cecec?dice_id=p3e7200cecec\",\"post_reminder_referral\":\"https://link.dice.fm/h5b8ebb07f02?dice_id=h5b8ebb07f02\",\"post_waitinglist_referral\":\"https://link.dice.fm/m4f0f87ce6bb?dice_id=m4f0f87ce6bb\"},\"max_tickets\":100,\"seats_io_public_key\":null,\"id\":\"693173601d1b47000192875e\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"House of Burlesque Speakeasy \",\"about\":{\"description\":\"Under the streets of the world famous London's West End lurks a world of stockings, feathers and fabulousness. The UK's TOP Burlesque production house's weekly Saturday night residency, started at the legendary Madame Jojo's, is here and is the perfect start to the party! Venture under the streets of London to spend some time with 'Burlesque Queen' (What's on Stage) Miss Tempest Rose and the stars of The House of Burlesque…\\n\\nSee Burlesque dancing divas, tantalising tassel-twirlers, and cabaret glitterati with everything in between in an uplifting fabulous live show performed in the round. This special early show is the perfect prelude to dinner and a night on the town if you are heading out after, or all guests are welcome to stay on after the show to dance the night away at the venue. Arrive early doors to enjoy special Happy Hour, DJ afterparty till late.\\n\\n\\\\*Please note all tickets are non-refundable\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"tty_to_extras\":[],\"new\":false,\"donation\":null,\"perm_name\":\"ryawyw-house-of-burlesque-speakeasy-31st-jan-qt-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"score\":0,\"event_tag\":null,\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}]},{\"presented_by\":\"Presented by The Clapham Grand.\",\"properties\":[],\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2400},\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-08/f4d01a7f-2a20-44c8-b400-772c4bcdabb2.jpg?rect=0%2C461%2C7016%2C7016\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-08/f4d01a7f-2a20-44c8-b400-772c4bcdabb2.jpg?rect=0%2C1864%2C7016%2C4210\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-08/f4d01a7f-2a20-44c8-b400-772c4bcdabb2.jpg?rect=1326%2C0%2C4365%2C7937\"},\"announcement_date_unix\":1765792800,\"has_multiple_ticket_types\":true,\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the show or venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us prior to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com \\u0026 including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48282,\"title\":\"I have already purchased my tickets \\u0026 have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries, please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":2},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":3},{\"id\":48283,\"title\":\"Can I come back in if I leave the venue during a show or event?\",\"body\":\"Unless otherwise stated all our events have a no re-admission policy.\",\"order\":4},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":5}],\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-15T10:00:00+00:00\",\"sale_end_date\":\"2026-02-01T18:30:00+00:00\",\"sale_start_date\":\"2025-12-15T10:00:00+00:00\",\"event_start_date\":\"2026-02-01T18:30:00+00:00\",\"event_end_date\":\"2026-02-01T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"acquisition_type\":\"purchase\",\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"unicorn\":true,\"date_unix\":1769970600,\"is_hidden_event\":false,\"status\":\"on-sale\",\"is_ticket_available_at_door\":false,\"unicorn_extras\":true,\"offers_extras\":false,\"impression_id\":\"36a2bd84eebc2f97:17\",\"attendance_type\":\"live_only\",\"secondary_status\":null,\"streaming_options\":null,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-01T18:30:00+00:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"previews\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/S060dff24d09?dice_id=S060dff24d09\",\"post_competition_referral\":\"https://link.dice.fm/n86685a17681?dice_id=n86685a17681\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/B5353079525e?dice_id=B5353079525e\",\"post_purchase_referral\":\"https://link.dice.fm/l8ec83888079?dice_id=l8ec83888079\",\"post_reminder_referral\":\"https://link.dice.fm/Mfc933f93341?dice_id=Mfc933f93341\",\"post_waitinglist_referral\":\"https://link.dice.fm/j06f1de34f88?dice_id=j06f1de34f88\"},\"max_tickets\":8,\"seats_io_public_key\":null,\"id\":\"693ff2ba644c110001dab2a7\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"Myra DuBois: Live at The Clapham Grand!\",\"about\":{\"description\":\"**DOORS 6.30PM / SHOW STARTS APPROX ONE HOUR AFTER / 18+**\\n\\nMYRA DUBOIS; the acid-tongued comedic force of nature returns to THE CLAPHAM GRAND this February!\\n\\nJoin the self-styled 'Siren of South Yorkshire' for her signature quick-wit and un-rivalled crowd work. With 'support' from 'comedian' Frank Lavender \\u0026 more special guests TBA.\\n\\n**If you have any questions please scroll down to the FAQ section below.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"tty_to_extras\":[],\"new\":false,\"donation\":null,\"perm_name\":\"l8oxrl-myra-dubois-live-at-the-clapham-grand-1st-feb-the-clapham-grand-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"score\":0,\"event_tag\":null,\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}]},{\"presented_by\":\"Presented by The BRIT School Limited.\",\"properties\":[],\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":824},\"marketeers\":[],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-18/7bf8f466-bb70-490a-a206-8bd66435a8a4.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-18/7bf8f466-bb70-490a-a206-8bd66435a8a4.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-18/7bf8f466-bb70-490a-a206-8bd66435a8a4.jpg?rect=270%2C0%2C660%2C1200\"},\"announcement_date_unix\":1765973700,\"has_multiple_ticket_types\":true,\"faqs\":[{\"id\":65363,\"title\":\"How to get here?\",\"body\":\"If travelling by car, please use SE25 5PL for Sat Nav, as our shared car parking entrance is in Dagnall Park. You will need to enter your registration plate at Reception to avoid a parking charge.\\n\\nThe Crescent is part of Croydon's Healthy Schools Scheme. This means that you can no longer drive a vehicle into The Crescent from 08.00am – 9.30am and 2.00pm – 4.00pm.\",\"order\":0},{\"id\":65364,\"title\":\"What is a Concession\",\"body\":\"What is a concession\\n\\nA concession price is available for a child, student at any school, college or university or an OAP.\",\"order\":1},{\"id\":65365,\"title\":\"How do I book an access ticket?\",\"body\":\"Please contact tickets@brit.school before making your booking\",\"order\":2}],\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-17T12:15:00+00:00\",\"sale_end_date\":\"2026-02-03T17:30:00+00:00\",\"sale_start_date\":\"2025-12-19T12:00:00+00:00\",\"event_start_date\":\"2026-02-03T16:30:00+00:00\",\"event_end_date\":\"2026-02-03T19:05:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"acquisition_type\":\"purchase\",\"billing_promoter\":{\"id\":\"5585\",\"name\":\"The BRIT School Limited\",\"image\":{\"url\":null},\"perm_name\":\"the-brit-school-limited-r59q\",\"profile_active\":true},\"unicorn\":t