+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"tty_to_extras\":[],\"new\":false,\"donation\":null,\"perm_name\":\"l8b8ep-twin-cheeks-7th-feb-the-haggerston-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"score\":0,\"event_tag\":null,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}]},{\"presented_by\":\"Presented by Deeper Into Movies.\",\"properties\":[],\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"marketeers\":[],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-29/3125b141-2f7e-4935-becf-a88c0dfb5f7f.jpg?rect=0%2C0%2C4500%2C4500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-29/3125b141-2f7e-4935-becf-a88c0dfb5f7f.jpg?rect=0%2C900%2C4500%2C2700\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-29/3125b141-2f7e-4935-becf-a88c0dfb5f7f.jpg?rect=1013%2C0%2C2475%2C4500\"},\"announcement_date_unix\":1766988000,\"has_multiple_ticket_types\":false,\"faqs\":[],\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-29T06:00:00+00:00\",\"sale_end_date\":\"2026-02-09T19:15:00+00:00\",\"sale_start_date\":\"2025-12-29T06:00:00+00:00\",\"event_start_date\":\"2026-02-09T19:30:00+00:00\",\"event_end_date\":\"2026-02-09T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"acquisition_type\":\"purchase\",\"billing_promoter\":{\"id\":\"1357\",\"name\":\"Deeper Into Movies\",\"image\":{\"url\":null},\"perm_name\":\"deeper-into-movies-pgep\",\"profile_active\":true},\"unicorn\":true,\"date_unix\":1770665400,\"is_hidden_event\":false,\"status\":\"on-sale\",\"is_ticket_available_at_door\":false,\"unicorn_extras\":true,\"offers_extras\":false,\"impression_id\":\"f6ea7974d6589a14:18\",\"attendance_type\":\"live_only\",\"secondary_status\":null,\"streaming_options\":null,\"shopping_cart_enabled\":false,\"ve