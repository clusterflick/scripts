rtists through Instagram (@markfisherfilm), the film embodies Fisher’s call for collective imagination beyond capitalist realism.\\\",\\\"highlights\\\":[{\\\"type\\\":\\\"age_restriction\\\",\\\"title\\\":\\\"This is an 18+ event.\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null},{\\\"type\\\":\\\"promoter\\\",\\\"title\\\":\\\"Presented by Deeper Into Movies.\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null}]},\\\"attendance_type\\\":\\\"live_only\\\",\\\"is_hidden_event\\\":false},\\\"queryParams\\\":{},\\\"eventLoading\\\":false,\\\"ticketTypesLoading\\\":false},\\\"events\\\":{\\\"homeCityTopEventsLoading\\\":false},\\\"purchase\\\":{\\\"productType\\\":\\\"ticket\\\",\\\"cart\\\":{\\\"items\\\":[]},\\\"ticketTypeId\\\":1145302,\\\"ticketsIncrements\\\":1,\\\"reservationTickets\\\":[],\\\"extraQty\\\":1,\\\"purchaseConfirmed\\\":{}},\\\"refund\\\":{\\\"loading\\\":false,\\\"step\\\":\\\"events\\\",\\\"ticketIds\\\":[],\\\"ticketExtrasIds\\\":[]},\\\"venues\\\":{},\\\"search\\\":{\\\"open\\\":false,\\\"value\\\":\\\"\\\"},\\\"waitingLists\\\":{\\\"ids\\\":[],\\\"entities\\\":{}},\\\"unlock\\\":{\\\"loading\\\":false,\\\"appliedCodes\\\":{}},\\\"musicLibrary\\\":{\\\"appleMusicConnecting\\\":false,\\\"spotifyConnecting\\\":false,\\\"justScanned\\\":false},\\\"browse\\\":{\\\"cities\\\":[{\\\"code\\\":\\\"saint_paul\\\",\\\"id\\\":\\\"689e4465a1805897071e2714\\\",\\\"name\\\":\\\"Saint Paul\\\",\\\"location\\\":{\\\"lat\\\":44.939589,\\\"lng\\\":-93.270863,\\\"place\\\":\\\"America/Chicago\\\",\\\"accuracy\\\":12},\\\"country_code\\\":\\\"US\\\",\\\"perm_name\\\":\\\"saint_paul\\\",\\\"country_id\\\":\\\"5982dffafa1614a04fe33793\\\",\\\"country_name\\\":\\\"United States of America\\\",\\\"state_code\\\":\\\"MN\\\",\\\"country_perm_name\\\":\\\"united-states-of-america\\\"},{\\\"code\\\":\\\"st_louis\\\",\\\"id\\\":\\\"67940e2c16ef2ae54597d632\\\",\\\"name\\\":\\\"St. Louis\\\",\\\"location\\\":{\\\"lat\\\":38.65315,\\\"lng\\\":-90.243616,\\\"place\\\":\\\