nister, uncanny imagery that could have emerged only from an artist so deeply in tune with his subconscious...including David interogating a talking monkey.\\\\n\\\\nTICKET SALES GO TO THE DAVID LYNCH FOUNDATION\\\",\\\"highlights\\\":[{\\\"type\\\":\\\"age_restriction\\\",\\\"title\\\":\\\"This is an 18+ event.\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null},{\\\"type\\\":\\\"promoter\\\",\\\"title\\\":\\\"Presented by Deeper Into Movies.\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null}]},\\\"images\\\":{\\\"square\\\":\\\"https://dice-media.imgix.net/attachments/2025-01-20/f27397e5-991c-4370-a676-3f0cccd27355.jpg?rect=150%2C0%2C900%2C900\\\",\\\"landscape\\\":\\\"https://dice-media.imgix.net/attachments/2025-01-20/f27397e5-991c-4370-a676-3f0cccd27355.jpg?rect=0%2C90%2C1200%2C720\\\",\\\"portrait\\\":\\\"https://dice-media.imgix.net/attachments/2025-01-20/f27397e5-991c-4370-a676-3f0cccd27355.jpg?rect=353%2C0%2C495%2C900\\\"},\\\"seats_io_public_key\\\":null},\\\"queryParams\\\":{},\\\"eventLoading\\\":false,\\\"ticketTypesLoading\\\":false},\\\"events\\\":{\\\"homeCityTopEventsLoading\\\":false},\\\"purchase\\\":{\\\"productType\\\":\\\"ticket\\\",\\\"cart\\\":{\\\"items\\\":[]},\\\"ticketTypeId\\\":1145302,\\\"ticketsIncrements\\\":1,\\\"reservationTickets\\\":[],\\\"extraQty\\\":1,\\\"purchaseConfirmed\\\":{}},\\\"refund\\\":{\\\"loading\\\":false,\\\"step\\\":\\\"events\\\",\\\"ticketIds\\\":[],\\\"ticketExtrasIds\\\":[]},\\\"venues\\\":{},\\\"search\\\":{\\\"open\\\":false,\\\"value\\\":\\\"\\\"},\\\"waitingLists\\\":{\\\"ids\\\":[],\\\"entities\\\":{}},\\\"unlock\\\":{\\\"loading\\\":false,\\\"appliedCodes\\\":{}},\\\"musicLibrary\\\":{\\\"appleMusicConnecting\\\":false,\\\"spotifyConnecting\\\":false,\\\"justScanned\\\":false},\\\"browse\\\":{\\\"cities\\\":[{\\\"code\\\":\\\"saint_paul\\\",\\\"id\\\":\\\"689e4465a1805897071e2714\\\",\\\"name\\\":\\\"Saint Paul\\\",\\\"location\\\":{\\\"lat\\\":44.939589,\\\"lng\\\":-93.270863,\\\"place\\\":\\\"Ame