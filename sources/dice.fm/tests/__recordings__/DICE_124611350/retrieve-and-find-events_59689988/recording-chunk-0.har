te\":\"2026-01-11T19:30:00+00:00\",\"event_end_date\":\"2026-01-11T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"acquisition_type\":\"purchase\",\"billing_promoter\":{\"id\":\"245\",\"name\":\"LNZRT\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-12/1814e171-32d9-4237-848d-85f91f0af396.jpg\"},\"perm_name\":\"lnzrt-jeed\",\"profile_active\":true},\"unicorn\":true,\"date_unix\":1768159800,\"is_hidden_event\":false,\"status\":\"on-sale\",\"is_ticket_available_at_door\":false,\"unicorn_extras\":false,\"offers_extras\":false,\"impression_id\":\"f6ea7974d6589a14:3\",\"attendance_type\":\"live_only\",\"secondary_status\":null,\"streaming_options\":null,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"43\",\"name\":\"MOTH Club\",\"address\":\"Old Trades Hall, Valette Street, London E9 6NU\",\"location\":{\"lat\":51.5450825,\"lng\":-0.0546326999999565},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-14/0164c968-c9f6-4e55-8329-e0a12ce43b69.jpg?rect=341%2C0%2C1367%2C1367\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"moth-club-43ox\",\"accessibility\":{\"url\":\"https://mothclub.co.uk/Access\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-01-11T19:30:00+00:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Talking Heads - Girlfriend Is Better\",\"redirect_url\":\"https://open.spotify.com/track/37kkHqpkzTEGOJYHRb6JZG\",\"artist\":\"Talking Heads\",\"preview_url\":\"https://p.scdn.co/mp3-preview/d6988795c4c56e985c276c43fd5fc957d09e5975?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Girlfriend Is Better\"},{\"type\":\"apple_music\",\"title\":\"Talking Heads - Girlfriend Is Better\",\"redirect_url\":\"https://music.apple.com/us/album/girlfriend-is-better/300202199?i=300202260\\u0026uo=4\\u0026at=1001ld8Z\\u0026ct=app_event\",\"artist\":\"Talking Heads\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/ee/1b/6e/ee1b6e7a-a20b-f7c9-0ddf-514ef023b032/mzaf_12623518603774424922.plus.aac.p.m4a\",\"track_name\":\"Girlfriend Is Better\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/D540e193e335?dice_id=D540e193e335\",\"post_competition_referral\":\"https://link.dice.fm/Uc069da44bca?dice_id=Uc069da44bca\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Fed088776c19?dice_id=Fed088776c19\",\"post_purchase_referral\":\"https://link.dice.fm/Bd586ce29251?dice_id=Bd586ce29251\",\"post_reminder_referral\":\"https://link.dice.fm/be045f04af5d?dice_id=be045f04af5d\",\"post_waitinglist_referral\":\"https://link.dice.fm/bf50744ee711?dice_id=bf50744ee711\"},\"max_tickets\":6,\"seats_io_public_key\":null,\"id\":\"6912251ef7ec27000104583d\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"Byrne's Night: Stop Making Sense Screening+Karaoke\",\"about\":{\"description\":\"***Dancing Barefoot presents: Stop Making Sense (1984)***\\n\\nAhead of their first ever Byrne’s Night tour (and biggest show yet at KOKO), the crew behind London’s cult celebration of David Byrne and Robert Burns return to their original home at MOTH Club for a Sunday night screening of the Talking Heads classic Stop Making Sense. Followed by some Talking Heads and adjacent themed karaoke, it's the perfect warm-up before the chaos.\\n\\nJonathan Demme’s Stop Making Sense (1984) captures Talking Heads at their creative peak. A kinetic, transcendent live film that redefined what a concert movie could be. Hailed by critics as one of the greatest concert films of all time, it features core members David Byrne, Tina Weymouth, Chris Frantz, and Jerry Harrison, joined by Bernie Worrell, Alex Weir, Steve Scales, Lynn Mabry, and Edna Holt. Filmed over three nights at Hollywood’s Pantages Theater in December 1983, it’s an electrifying performance of the band’s most unforgettable songs.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"tty_to_extras\":[],\"new\":false,\"donation\":null,\"perm_name\":\"q28q79-byrnes-night-stop-making-sense-screeningkaraoke-11th-jan-moth-club-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"score\":0,\"event_tag\":null,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}]},{\"presented_by\":\"Presented by Kino Short Film.\",\"properties\":[],\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"marketeers\":[],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2024-02-26/18e542a0-49ce-40f2-a905-3a307c2ce467.jpg?rect=923%2C0%2C2374%2C2374\",\"landscape\":\"https://dice-media.imgix.net/attachments/2024-02-26/18e542a0-49ce-40f2-a905-3a307c2ce467.jpg?rect=132%2C0%2C3957%2C2374\",\"portrait\":\"https://dice-media.imgix.net/attachments/2024-02-26/18e542a0-49ce-40f2-a905-3a307c2ce467.jpg?rect=1457%2C0%2C1306%2C2374\"},\"announcement_date_unix\":1765195200,\"has_multiple_ticket_types\":false,\"faqs\":[],\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-08T12:00:00+00:00\",\"sale_end_date\":\"2026-01-12T20:00:00+00:00\",\"sale_start_date\":\"2025-12-08T12:00:00+00:00\",\"event_start_date\":\"2026-01-12T19:00:00+00:00\",\"event_end_date\":\"2026-01-12T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"acquisition_type\":\"purchase\",\"billing_promoter\":{\"id\":\"11708\",\"name\":\"Kino Short Film\",\"image\":{\"url\":null},\"perm_name\":\"kino-short-film-n5g5\",\"profile_active\":false},\"unicorn\":true,\"date_unix\":1768244400,\"is_hidden_event\":false,\"status\":\"on-sale\",\"is_ticket_available_at_door\":false,\"unicorn_extras\":true,\"offers_extras\":false,\"impression_id\":\"f6ea7974d6589a14:4\",\"attendance_type\":\"live_only\",\"secondary_status\":null,\"streaming_options\":null,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"298\",\"name\":\"Strongroom Bar\",\"address\":\"120-124 Curtain Rd, Shoreditch, London EC2A 3SQ, UK\",\"location\":{\"lat\":51.5259644,\"lng\":-0.0801498},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-11-09/01c2cab5-15ea-48e0-a0b4-d9ed0465d9db.jpg?rect=0%2C0%2C850%2C850\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"strongroom-bar-4bym\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-01-12T19:00:00+00:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"previews\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/w3065dfe1eab?dice_id=w3065dfe1eab\",\"post_competition_referral\":\"https://link.dice.fm/v8c11da1099c?dice_id=v8c11da1099c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Geb658d70a1c?dice_id=Geb658d70a1c\",\"post_purchase_referral\":\"https://link.dice.fm/y93d88022143?dice_id=y93d88022143\",\"post_reminder_referral\":\"https://link.dice.fm/Q05219dc00be?dice_id=Q05219dc00be\",\"post_waitinglist_referral\":\"https://link.dice.fm/L1ac421cb47b?dice_id=L1ac421cb47b\"},\"max_tickets\":20,\"seats_io_public_key\":null,\"id\":\"6936c0aa71afd0000144b369\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"Short Film Open Mic\",\"about\":{\"description\":\"Whether you’re looking for a chance to screen your short film in front of a live audience for free OR you’re looking to watch something wild, wacky, and creative outside of the mainstream, our open mic is refreshingly non-competitive in an all-too-oftentimes intimidating industry.\\n\\nBoth industry professionals and first-timers bring their shorts to Kino making the quality of cinema screened at each event both diverse and entertaining. And with such a broad spectrum of new work being screened, our Open Mic is a genuine reflection of the current output of London based filmmakers.\\n\\nREGISTER TO SCREEN YOUR SHORT FILM HERE: www.kinoshortfilm.com/short-film-openmic\\n\\n- One film per filmmaker\\n- Register in advance\\n- Filmmakers must be present to introduce film\\n- Films are accepted on a first-come, first-screened basis\\n- Film running time should be under 10 mins\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"highlights\":[]},\"seating\":null,\"tty_to_extras\":[],\"new\":false,\"donation\":null,\"perm_name\":\"mx88yr-short-film-open-mic-12th-jan-strongroom-bar-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"score\":0,\"event_tag\":null,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}]},{\"presented_by\":\"Presented by Deeper Into Movies.\",\"properties\":[],\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1200,\"sales_tax\":0,\"amount_from\":null},\"marketeers\":[],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-28/af1181bc-bb8c-4783-aab2-8fc09be0c1b8.jpg?rect=412%2C0%2C1065%2C1065\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-28/af1181bc-bb8c-4783-aab2-8fc09be0c1b8.jpg?rect=57%2C0%2C1775%2C1065\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-28/af1181bc-bb8c-4783-aab2-8fc09be0c1b8.jpg?rect=651%2C0%2C586%2C1065\"},\"announcement_date_unix\":1766846700,\"has_multiple_ticke