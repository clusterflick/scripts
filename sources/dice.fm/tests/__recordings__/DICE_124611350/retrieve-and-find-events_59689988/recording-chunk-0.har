0 0 1 1.778.325l.775-1.549a.5.5 0 1 1 .894.448l-.775 1.55A4.996 4.996 0 0 1 17 9H7c0-1.779.929-3.34 2.328-4.227l-.775-1.55a.5.5 0 0 1 .223-.67ZM10 6.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0Zm4.5.5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1Z\" clip-rule=\"evenodd\"></path></svg><span>Android</span></a></div></div><div class=\"EventDetailsLayout__MobileContent-sc-2554ecc8-5 fAoBgn\"><div class=\"EventDetailsBase__HR-sc-d40475af-3 eSgOkc\"></div><div class=\"EventDetailsFAQ__Container-sc-7130cefd-1 kjqLCB\"><p>DICE protects fans and artists from touts. Tickets will be securely stored in the app.</p></div><div class=\"EventDetailsBase__HR-sc-d40475af-3 eSgOkc\"></div></div></div></div></div><script type=\"application/ld+json\">{\"@context\":\"https:\\u002F\\u002Fschema.org\",\"@type\":\"ScreeningEvent\",\"url\":\"https:\\u002F\\u002Fdice.fm\\u002Fevent\\u002Fav3vxd-jeff-buckley-its-never-over-9th-feb-the-ivy-house-london-tickets\",\"name\":\"JEFF BUCKLEY - IT'S NEVER OVER \",\"startDate\":\"2026-02-09T19:30:00+00:00\",\"endDate\":\"2026-02-09T22:30:00+00:00\",\"eventAttendanceMode\":\"https:\\u002F\\u002Fschema.org\\u002FOfflineEventAttendanceMode\",\"eventStatus\":\"https:\\u002F\\u002Fschema.org\\u002FEventScheduled\",\"location\":{\"@type\":\"Place\",\"name\":\"The Ivy House\",\"address\":\"40 Stuart Road, london SE15 3BE\",\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":51.4582576,\"longitude\":-0.0521545000000287}},\"image\":[\"https:\\u002F\\u002Fdice-media.imgix.net\\u002Fattachments\\u002F2025-12-29\\u002F3125b141-2f7e-4935-becf-a88c0dfb5f7f.jpg?rect=0%2C0%2C4500%2C4500\"],\"description\":\"Jeff Buckley, a rising star with an otherworldly voice, left the 90s music world reeling when he died suddenly after the release of his debut album. Told through never-before-seen footage and intimate accounts from the three women who knew him best, the film illuminates one of modern music’s most influential and enigmatic figures.\",\"offers\":[],\"organizer\":{\"@type\":\"Organization\",\"name\":\"Deeper Into Movies\"}}</script></div><footer class=\"Footer__Wrapper-sc-b4b03d95-1 bXotkg default-footer-background hide-in-purchase-flow\"><div class=\"Footer__MaxWidthWrapper-sc-b4b03d95-2 Footer__PrimaryFooter-sc-b4b03d95-3 ZGZWE btQVbq\"><div class=\"Footer__LogoCol-sc-b4b03d95-6 fGSCng\"><a aria-label=\"DICE\" href=\"/\" class=\"Footer__Logo-sc-b4b03d95-7 ebGIam\"><img width=\"200\" height=\"244\" alt=\"DICE\" src=\"/static/images/dice-fan.gif\" loading=\"lazy\"/></a></div><div class=\"Footer__Nav-sc-b4b03d95-8 kTXnAq\"><details open=\"\" class=\"FooterNavCol-sc-e5ef781b-0 jLkSXP\"><summary class=\"Description-sc-f5e05090-0 FooterNavCol__NavTitle-sc-e5ef781b-2 irmwOP dsHsU\">Our company<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" viewBox=\"0 0 24 24\" class=\"FooterNavCol__NavIcon-sc-e5ef781b-1 iFhQbp\"><path stroke=\"currentColor\" stroke-linecap=\"square\" d=\"M17.5 9.5 12 15 6.5 9.5\"></path></svg></summary><nav class=\"FooterNavCol__NavList-sc-e5ef781b-3 cFQaLH\"><div class=\"FooterNavCol__NavItem-sc-e5ef781b-4 jZpIza\"><a href=\"/about\" class=\"Description-sc-f5e05090-0 FooterNavCol__FooterLink-sc-e5ef781b-5 irmwOP hHfdJX\">About DICE</a></div><div class=\"FooterNavCol__NavItem-sc-e5ef781b-4 jZpIza\"><a href=\"/jobs\" class=\"Description-sc-f5e05090-0 FooterNavCol__FooterLink-sc-e5ef781b-5 irmwOP hHfdJX\">Careers</a></div><div class=\"FooterNavCol__NavItem-sc-e5ef781b-4 jZpIza\"><a href=\"/diversity-equity-inclusion\" class=\"Description-sc-f5e05090-0 FooterNavCol__FooterLink-sc-e5ef781b-5 irmwOP hHfdJX\">Diversity, equity \n&amp; inclusion</a></div></nav></details><details open=\"\" class=\"FooterNavCol-sc-e5ef781b-0 jLkSXP\"><summary class=\"Description-sc-f5e05090-0 FooterNavCol__NavTitle-sc-e5ef781b-2 irmwOP dsHsU\">Fan Support<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" viewBox=\"0 0 24 24\" class=\"FooterNavCol__NavIcon-sc-e5ef781b-1 iFhQbp\"><path stroke=\"currentColor