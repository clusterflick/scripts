ice_id=a206994d3611\",\"post_reminder_referral\":\"https://link.dice.fm/V2bbf99114a5?dice_id=V2bbf99114a5\",\"post_waitinglist_referral\":\"https://link.dice.fm/J82ddedd3fbc?dice_id=J82ddedd3fbc\"},\"max_tickets\":100,\"seats_io_public_key\":null,\"id\":\"693173601d1b47000192875d\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"House of Burlesque Speakeasy \",\"about\":{\"description\":\"Under the streets of the world famous London's West End lurks a world of stockings, feathers and fabulousness. The UK's TOP Burlesque production house's weekly Saturday night residency, started at the legendary Madame Jojo's, is here and is the perfect start to the party! Venture under the streets of London to spend some time with 'Burlesque Queen' (What's on Stage) Miss Tempest Rose and the stars of The House of Burlesque…\\n\\nSee Burlesque dancing divas, tantalising tassel-twirlers, and cabaret glitterati with everything in between in an uplifting fabulous live show performed in the round. This special early show is the perfect prelude to dinner and a night on the town if you are heading out after, or all guests are welcome to stay on after the show to dance the night away at the venue. Arrive early doors to enjoy special Happy Hour, DJ afterparty till late.\\n\\n\\\\*Please note all tickets are non-refundable\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"tty_to_extras\":[],\"new\":false,\"donation\":null,\"perm_name\":\"ww5lwg-house-of-burlesque-speakeasy-17th-jan-qt-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"score\":0,\"event_tag\":null,\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}]},{\"presented_by\":\"Presented by Folklore Hoxton.\",\"properties\":[],\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1350,\"sales_tax\":0,\"amount_from\":null},\"marketeers\":[],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-05/7871a396-e837-4081-80b0-66297e9e2909.jpg?rect=209%2C0%2C836%2C836\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-05/7871a396-e837-4081-80b0-66297e9e2909.jpg?rect=0%2C42%2C1254%2C752\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-05/7871a396-e837-4081-80b0-66297e9e2909.jpg?rect=397%2C0%2C460%2C836\"},\"announcement_date_unix\":1764892800,\"has_multiple_ticket_types\":false,\"faqs\":[],\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-05T00:00:00+00:00\",\"sale_end_date\":\"2026-01-21T22:00:00+00:00\",\"sale_start_date\":\"2025-12-05T00:00:00+00:00\",\"event_start_date\":\"2026-01-21T19:00:00+00:00\",\"event_end_date\":\"2026-01-21T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"acquisition_type\":\"purchase\",\"billing_promoter\":{\"id\":\"2755\",\"name\":\"Folklore Hoxton\",\"image\":{\"url\":null},\"perm_name\":\"folklore-hoxton-7ogb\",\"profile_active\":false},\"unicorn\":true,\"date_unix\":1769022000,\"is_hidden_event\":false,\"status\":\"on-sale\",\"is_ticket_available_at_door\":false,\"unicorn_extras\":true,\"offers_extras\":false,\"impression_id\":\"36a2bd84eebc2f97:5\",\"attendance_type\":\"live_only\",\"secondary_status\":null,\"streaming_options\":null,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"1238\",\"name\":\"Folklore Hoxton\",\"address\":\"186 Hackney Rd, London E2 7QL, UK\",\"location\":{\"lat\":51.5306515,\"lng\":-0.07228429999997843},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"folklore-hoxton-2or7\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-01-21T19:00:00+00:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"previews\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/Jfce07f3aa69?dice_id=Jfce07f3aa69\",\"post_competition_referral\":\"https://link.dice.fm/i20e1a633f8a?dice_id=i20e1a633f8a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/qd42bb2251b4?dice_id=qd42bb2251b4\",\"post_purchase_referral\":\"https://link.dice.fm/w05693f09e79?dice_id=w05693f09e79\",\"post_reminder_referral\":\"https://link.dice.fm/Ac35838e9bb9?dice_id=Ac35838e9bb9\",\"post_waitinglist_referral\":\"https://link.dice.fm/d295534ca6b1?dice_id=d295534ca6b1\"},\"max_tickets\":6,\"seats_io_public_key\":null,\"id\":\"69331d696123c80001e4ea34\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"A DANCE WITH THE MINOTAUR’S SISTER\",\"about\":{\"description\":\"**The Crick Crack Club presents**\\n\\n**Fairytales for Grown-ups - A DANCE WITH THE MINOTAUR’S SISTER**\\n\\n**Performance storytelling by Steph Brittain**\\n\\nA King breaks a promise.\\n\\nA Queen takes passion in hand.\\n\\nA Prince becomes a feared prisoner.\\n\\nAnd Ariadne dances.\\n\\nStoryteller Steph Brittain unravels a web of love, loss, betrayal, and bees - tracing the footsteps of Ariadne to a place before the maze and before the thread.\\n\\nFrom a forest dance floor to the labyrinth’s dark passages, and beneath the starry skies of Naxos, A Dance with the Minotaur’s Sister weaves an intricate tapestry of strength, courage, and desire - a story as old as myth, told with the living pulse of now.\\n\\nTipping ancient Greek mythology into a new perspective, this is a story of a bull, a boy, his sister, a labyrinth and what happens when the hero leaves.\\n\\nAriadne is waiting - pulsing with joy and fire. Come and join the dance…\\n\\n***Running time: Approx 70 minutes, no interval***\\n\\n***Contains references to sex, threat and violence, contextualised within a paradigm of mythic narrative, archetype and metaphor***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"tty_to_extras\":[],\"new\":false,\"donation\":null,\"perm_name\":\"yonn9x-a-dance-with-the-minotaurs-sister-21st-jan-folklore-hoxton-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":3},\"score\":0,\"event_tag\":null,\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}]},{\"presented_by\":\"Presented by Party with Ginger.\",\"properties\":[],\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":824},\"marketeers\":[],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=1313%2C0%2C3375%2C3375\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=188%2C0%2C5625%2C3375\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=2072%2C0%2C1856%2C3375\"},\"announcement_date_unix\":1733436900,\"has_multiple_ticket_types\":true,\"faqs\":[],\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-12-05T22:15:00+00:00\",\"sale_end_date\":\"2026-01-24T13:00:00+00:00\",\"sale_start_date\":\"2024-12-05T22:15:00+00:00\",\"event_start_date\":\"2026-01-24T13:00:00+00:00\",\"event_end_date\":\"2026-01-24T16:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"acquisition_type\":\"purchase\",\"billing_promoter\":{\"id\":\"14767\",\"name\":\"Party with Ginger\",\"image\":{\"url\":null},\"perm_name\":\"party-with-ginger-3oogv\",\"profile_active\":false},\"unicorn\":true,\"date_unix\":1769259600,\"is_hidden_event\":false,\"status\":\"on-sale\",\"is_ticket_available_at_door\":false,\"unicorn_extras\":true,\"offers_extras\":false,\"impression_id\":\"36a2bd84eebc2f97:6\",\"attendance_type\":\"live_only\",\"secondary_status\":null,\"streaming_options\":null,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"14139\",\"name\":\"Balls Brothers Austin Friars\",\"address\":\"10-11 Austin Friars, City of London, London, EC2N 2HG, United Kingdom\",\"location\":{\"lat\":51.51571,\"lng\":-0.08527},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"balls-brothers-austin-friars-mxb5v\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-01-24T13:00:00+00:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"previews\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/Q2cc55eeff85?dice_id=Q2cc55eeff85\",\"post_competition_referral\":\"https://link.dice.fm/va66aa7d382a?dice_id=va66aa7d382a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/fbe7d7958664?dice_id=fbe7d7958664\",\"post_purchase_referral\":\"https://link.dice.fm/X5a8c7a0a033?dice_id=X5a8c7a0a033\",\"post_reminder_referral\":\"https://link.dice.fm/e08654be3c46?dice_id=e08654be3c46\",\"post_waitinglist_referral\":\"https://link.dice.fm/h19aabba9037?dice_id=h19aabba9037\"},\"max_tickets\":104,\"seats_io_public_key\":null,\"id\":\"69566809eef80f0001313b22\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"Ginger's Big Drag Bottomless Brunch \",\"about\":{\"description\":\"Darling, are you searching for a drag brunch like no other? Are you craving an afternoon of glittering, prosecco-fuelled, unadulterated drag fabulousness? Well, look no further than Ginger’s Big Drag Brunch– the most camp and outrageous event to grace London’s bottomless brunch scene.\\n\\nHosted by Ms Ginger Phlappage, and her squad of sassy, hilarious brunch queens \\u0026 kings, Ginger’s Big Drag Brunch brings you a boozy afternoon of drag performances, games, challenges, quizzes and plenty of audience participation, honey!\\n\\nCome prepared for free-flowing Prosecco and a scrummy two course brunch menu, with live DJs playing your favourite dance classics.\\n\\nWith a whole host of fabulous drag queens from across London and beyond performing their most gag-worthy lip-sync numbers, dance extravaganzas and side-splitting comedy skits, guests at Ginger’s Big Drag Brunch will be in for quite the show!\\n\\nVenue: Balls Brothers, Austin Friars– 5 minute walk from Liverpool Street Station.\\n\\n2 course meal and Bottomless Prosecco for 1.5 hrs\\n\\n1-4pm- doors open at 1pm, Prosecco 2pm- 4pm\\n\\nBRUNCH MAINS\\n\\nCheeseburger on a toasted bun w/ French fries Burger garnish\\n\\nAvocado on toast with poached eggs V\\n\\nFalafel \\u0026 spinach burger with vegan lime yoghurt on a toasted bun with French fries Burger garnish- V VG GF option available on request\\n\\nBRUNCH DESSERT\\n\\nVanilla Cheesecake with raspberry coulis V\\n\\nChocolate Pot with raspberry coulis VG GF DF\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"tty_to_extras\":[],\"new\":false,\"donation\":null,\"perm_name\":\"v3q36g-gingers-big-drag-bottomless-brunch-24th-jan-balls-brothers-austin-friars-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":3},\"score\":0,\"event_tag\":null,\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}]},{\"presented_by\":\"Presented by Party with Ginger.\",\"properties\":[],\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2003},\"marketeers\":[],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=1313%2C0%2C3375%2C3375\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=188%2C0%2C5625%2C3375\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=2072%2C0%2C1856%2C3375\"},\"announcement_date_unix\":1744050600,\"has_multiple_ticket_types\":true,\"faqs\":[],\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-04-07T19:30:00+01:00\",\"sale_end_date\":\"2026-01-24T13:30:00+00:00\",\"sale_start_date\":\"2025-04-07T19:30:00+01:00\",\"event_start_date\":\"2026-01-24T13:00:00+00:00\",\"event_end_date\":\"2026-01-24T15:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"acquisition_type\":\"purchase\",\"billing_promoter\":{\"id\":\"14767\",\"name\":\"Party with Ginger\",\"image\":{\"url\":null},\"perm_name\":\"party-with-ginger-3oogv\",\"profile_active\":false},\"unicorn\":true,\"date_unix\":1769259600,\"is_hidden_event\":false,\"status\":\"on-sale\",\"is_ticket_available_at_door\":false,\"unicorn_extras\":true,\"offers_extras\":false,\"impression_id\":\"36a2bd84eebc2f97:7\",\"attendance_type\":\"live_only\",\"secondary_status\":null,\"streaming_options\":null,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"2590\",\"name\":\"Phoenix Arts Club\",\"address\":\"Phoenix St, London WC2H 8BU, UK\",\"location\":{\"lat\":51.5144031,\"lng\":-0.12897139999995488},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"phoenix-arts-club-98pn\",\"accessibility\":{\"url\":\"https://phoenixartsclub.com/about-us/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-01-24T13:00:00+00:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"previews\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/b7b582140ba2?dice_id=b7b582140ba2\",\"post_competition_referral\":\"https://link.dice.fm/Acbc40515f6b?dice_id=Acbc40515f6b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/xdffd4f564ec?dice_id=xdffd4f564ec\",\"post_purchase_referral\":\"https://link.dice.fm/D9542df6d1e9?dice_id=D9542df6d1e9\",\"post_reminder_referral\":\"https://link.dice.fm/H4706317ab1d?dice_id=H4706317ab1d\",\"post_waitinglist_referral\":\"https://link.dice.fm/kf9ef93ee387?dice_id=kf9ef93ee387\"},\"max_tickets\":99,\"seats_io_public_key\":null,\"id\":\"694e4dd98ef9560001ddb87b\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"The Big Drag Bingo Brunch \",\"about\":{\"description\":\"From the creators of Ginger’s Big Drag Brunch get ready to grab life by the balls with The Big Drag Bingo Brunch—your favorite drag bingo experience with a fabulous bottomless brunch twist, darling!\\n\\nJoin us for a glittering bottomless drag extravaganza, where we’ll play the campiest, most outrageous game of bingo you’ve ever experienced—think your Nanna’s dabber, but with a fabulous twist! Our stunning drag superstars will have you on your feet, dancing, and cheering faster than you can say \\\"HOUSE!\\\"\\n\\nExpect bonkers fun as we serve up hilarious bingo rounds, ridiculous games and lip sync battles, jaw-dropping drag performances, and a vibrant atmosphere filled with live DJs spinning the hottest party anthems. With bottomless Prosecco flowing and BIG prizes to be won, this event has something for everyone to enjoy!\\n\\nVenue- Phoenix Arts Club - nearest stations Tottenham Court Rd,\\n\\n(Doors 1pm) Show 1.30-3.30pm. Prosecco 1.30pm - 3.30pm. Bar and kitchen will remain open to purchase additional drinks throughout.\\n\\n\\\\* if you order food on the day, the options will be Pizza only.\\n\\nMAINS\\n\\n\\\\-Cheeseburger on a brioche bun, baby gem, beef tomato burger sauce GF on request\\n\\n\\\\-Buttermilk Chicken burger with cheese on a brioche bun, baby gem, beef tomato burger sauce GF on request\\n\\n\\\\-Vegan burger on a brioche bun, baby gem, beef tomato burger sauce V VG GF on request\\n\\nDESSERT\\n\\n\\\\-Chocolate and orange torte with vanilla ice cream VG V GF\\n\\n\\\\-Vanilla cheesecake with strawberry sauce V\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"tty_to_extras\":[],\"new\":false,\"donation\":null,\"perm_name\":\"q272nx-the-big-drag-bingo-brunch-24th-jan-phoenix-arts-club-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"score\":0,\"event_tag\":null,\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}]},{\"presented_by\":\"Presented by House of Burlesque.\",\"properties\":[],\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2035},\"marketeers\":[],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=0%2C250%2C1001%2C1001\",\"landscape\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=0%2C450%2C1001%2C601\",\"portrait\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=88%2C0%2C825%2C1500\"},\"announcement_date_unix\":1764349200,\"has_multiple_ticket_types\":true,\"faqs\":[],\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-28T17:00:00+00:00\",\"sale_end_date\":\"2026-01-24T15:00:00+00:00\",\"sale_start_date\":\"2025-11-29T11:00:00+00:00\",\"event_start_date\":\"2026-01-24T18:00:00+00:00\",\"event_end_date\":\"2026-01-24T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"acquisition_type\":\"purchase\",\"billing_promoter\":{\"id\":\"2924\",\"name\":\"House of Burlesque\",\"image\":{\"url\":null},\"perm_name\":\"house-of-burlesque-6pd8\",\"profile_active\":false},\"unicorn\":true,\"date_unix\":1769277600,\"is_hidden_event\":false,\"status\":\"on-sale\",\"is_ticket_available_at_door\":false,\"unicorn_extras\":true,\"offers_extras\":false,\"impression_id\":\"36a2bd84eebc2f97:8\",\"attendance_type\":\"live_only\",\"secondary_status\":null,\"streaming_options\":null,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"15810\",\"name\":\"QT\",\"address\":\"66 Great Queen Street, Camden, London, WC2B 5BX, United Kingdom\",\"location\":{\"lat\":51.51584,\"lng\":-0.12026},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"qt-8ea25\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-01-24T18:00:00+00:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"previews\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/f631f7b89fe6?dice_id=f631f7b89fe6\",\"post_competition_referral\":\"https://link.dice.fm/ae3e26fe6444?dice_id=ae3e26fe6444\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/S8eccc90b530?dice_id=S8eccc90b530\",\"post_purchase_referral\":\"https://link.dice.fm/aaa8ee4be093?dice_id=aaa8ee4be093\",\"post_reminder_referral\":\"https://link.dice.fm/q7fc269f14c6?dice_id=q7fc269f14c6\",\"post_waitinglist_referral\":\"https://link.dice.fm/Aad4430597de?dice_id=Aad4430597de\"},\"max_tickets\":100,\"seats_io_public_key\":null,\"id\":\"6931736022994f0001c89b34\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"House of Burlesque Speakeasy \",\"about\":{\"description\":\"Under the streets of the world famous London's West End lurks a world of stockings, feathers and fabulousness. The UK's TOP Burlesque production house's weekly Saturday night residency, started at the legendary Madame Jojo's, is here and is the perfect start to the party! Venture under the streets of London to spend some time with 'Burlesque Queen' (What's on Stage) Miss Tempest Rose and the stars of The House of Burlesque…\\n\\nSee Burlesque dancing divas, tantalising tassel-twirlers, and cabaret glitterati with everything in between in an uplifting fabulous live show performed in the round. This special early show is the perfect prelude to dinner and a night on the town if you are heading out after, or all guests are welcome to stay on after the show to dance the night away at the venue. Arrive early doors to enjoy special Happy Hour, DJ afterparty till late.\\n\\n\\\\*Please note all tickets are non-refundable\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"tty_to_extras\":[],\"new\":false,\"donation\":null,\"perm_name\":\"q2682a-house-of-burlesque-speakeasy-24th-jan-qt-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"score\":0,\"event_tag\":null,\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}]},{\"presented_by\":\"Presented by The BRIT School Limited.\",\"properties\":[],\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":824},\"marketeers\":[],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-18/7bf8f466-bb70-490a-a206-8bd66435a8a4.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-18/7bf8f466-bb70-490a-a206-8bd66435a8a4.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-18/7bf8f466-bb70-490a-a206-8bd66435a8a4.jpg?rect=270%2C0%2C660%2C1200\"},\"announcement_date_unix\":1765973700,\"has_multiple_ticket_types\":true,\"faqs\":[{\"id\":65360,\"title\":\"How to get here?\",\"body\":\"If travelling by car, please use SE25 5PL for Sat Nav, as our shared car parking entrance is in Dagnall Park. You will need to enter your registration plate at Reception to avoid a parking charge.\\n\\nThe Crescent is part of Croydon's Healthy Schools Scheme. This means that you can no longer drive a vehicle into The Crescent from 08.00am – 9.30am and 2.00pm – 4.00pm.\",\"order\":0},{\"id\":65361,\"title\":\"What is a Concession\",\"body\":\"What is a concession\\n\\nA concession price is available for a child, student at any school, college or university or an OAP.\",\"order\":1},{\"id\":65362,\"title\":\"How do I book an access ticket?\",\"body\":\"Please contact tickets@brit.school before making your booking\",\"order\":2}],\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-17T12:15:00+00:00\",\"sale_end_date\":\"2026-01-26T19:00:00+00:00\",\"sale_start_date\":\"2025-12-19T12:00:00+00:00\",\"event_start_date\":\"2026-01-26T18:30:00+00:00\",\"event_end_date\":\"2026-01-26T21:05:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"acquisition_type\":\"purchase\",\"billing_promoter\":{\"id\":\"5585\",\"name\":\"The BRIT School Limited\",\"image\":{\"url\":null},\"perm_name\":\"the-brit-school-limited-r59q\",\"profile_active\":true},\"unicorn\":true,\"date_unix\":1769452200,\"is_hidden_event\":false,\"status\":\"on-sale\",\"is_ticket_available_at_door\":false,\"unicorn_extras\":true,\"offers_extras\":false,\"impression_id\":\"36a2bd84eebc2f97:9\",\"attendance_type\":\"live_only\",\"secondary_status\":null,\"streaming_options\":null,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"5662\",\"name\":\"The BRIT Theatre -  The BRIT School\",\"address\":\"60 The Crescent, Croydon CR0 2HN, UK\",\"location\":{\"lat\":51.3900037,\"lng\":-0.0914101},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-brit-theatre----the-brit-school-2gya\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-01-26T18:15:00+00:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"previews\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/g421b469ff06?dice_id=g421b469ff06\",\"post_competition_referral\":\"https://link.dice.fm/b2645995793a?dice_id=b2645995793a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/n208daed57cb?dice_id=n208daed57cb\",\"post_purchase_referral\":\"https://link.dice.fm/S17b4d39bdae?dice_id=S17b4d39bdae\",\"post_reminder_referral\":\"https://link.dice.fm/nacacd2424d8?dice_id=nacacd2424d8\",\"post_waitinglist_referral\":\"https://link.dice.fm/c8e0c1bf4484?dice_id=c8e0c1bf4484\"},\"max_tickets\":8,\"seats_io_public_key\":null,\"id\":\"6943c0c72a4fb60001d73fb9\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"[BLANK] by Alice Birch \",\"about\":{\"description\":\"She can't stay awake.\\n\\nShe sold drugs.\\n\\nShe's good at interrogations.\\n\\nShe drinks in the mornings.\\n\\nShe ate a rabbit.\\n\\nShe smashed up a shop.\\n\\nShe stabbed a man.\\n\\nShe used a hammer.\\n\\nShe had a baby.\\n\\nShe can't find her mother.\\n\\nShe's covered in blood and doesn't know why.\\n\\nAlice Birch’s heartbreaking play reaches across society to explore the impact of the criminal justice system on women and their families.\\n\\nAge guidance 15+\\n\\nContent warning:\\n\\nContains flashing lights, haze, blood, strong language, sexual content, drug use, theatrical weapons, and themes of violence, abuse, self-harm, suicide, and death (including of children).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 15+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"tty_to_extras\":[],\"new\":false,\"donation\":null,\"perm_name\":\"xe7gel-blank-by-alice-birch-26th-jan-the-brit-theatre-the-brit-school-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"score\":0,\"event_tag\":null,\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}]},{\"presented_by\":\"Presented by The BRIT School Limited.\",\"properties\":[],\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":824},\"marketeers\":[],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-17/1fbb298b-82c5-4f1f-bb91-539cb149e7e0.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-17/1fbb298b-82c5-4f1f-bb91-539cb149e7e0.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-17/1fbb298b-82c5-4f1f-bb91-539cb149e7e0.jpg?rect=270%2C0%2C660%2C1200\"},\"announcement_date_unix\":1765973700,\"has_multiple_ticket_types\":true,\"faqs\":[{\"id\":65006,\"title\":\"How to get here?\",\"body\":\"If travelling by car, please use SE25 5PL for Sat Nav, as our shared car parking entrance is in Dagnall Park. You will need to enter your registration plate at Reception to avoid a parking charge.\\n\\nThe Crescent is part of Croydon's Healthy Schools Scheme. This means that you can no longer drive a vehicle into The Crescent from 08.00am – 9.30am and 2.00pm – 4.00pm.\",\"order\":0},{\"id\":65007,\"title\":\"What is a Concession\",\"body\":\"A concession price is available for a child, student at any school, college or university or an OAP.\",\"order\":1},{\"id\":65008,\"title\":\"How do I book an access ticket?\",\"body\":\"Please contact tickets@brit.school before making your booking\",\"order\":2}],\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-17T12:15:00+00:00\",\"sale_end_date\":\"2026-01-28T19:00:00+00:00\",\"sale_start_date\":\"2025-12-19T12:00:00+00:00\",\"event_start_date\":\"2026-01-28T18:30:00+00:00\",\"event_end_date\":\"2026-01-28T20:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"acquisition_type\":\"purchase\",\"billing_promoter\":{\"id\":\"5585\",\"name\":\"The BRIT School Limited\",\"image\":{\"url\":null},\"perm_name\":\"the-brit-school-limited-r59q\",\"profile_active\":true},\"unicorn\":true,\"date_unix\":1769625000,\"is_hidden_event\":false,\"status\":\"on-sale\",\"is_ticket_available_at_door\":false,\"unicorn_extras\":true,\"offers_extras\":false,\"impression_id\":\"36a2bd84eebc2f97:10\",\"attendance_type\":\"live_only\",\"secondary_status\":null,\"streaming_options\":null,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"5662\",\"name\":\"The BRIT Theatre -  The BRIT School\",\"address\":\"60 The Crescent, Croydon CR0 2HN, UK\",\"location\":{\"lat\":51.3900037,\"lng\":-0.0914101},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-brit-theatre----the-brit-school-2gya\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-01-28T18:15:00+00:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"previews\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/q94f2f127687?dice_id=q94f2f127687\",\"post_competition_referral\":\"https://link.dice.fm/S4583115ccd8?dice_id=S4583115ccd8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Fba5b8132623?dice_id=Fba5b8132623\",\"post_purchase_referral\":\"https://link.dice.fm/g6d6fa1d46dc?dice_id=g6d6fa1d46dc\",\"post_reminder_referral\":\"https://link.dice.fm/v858e3e2781f?dice_id=v858e3e2781f\",\"post_waitinglist_referral\":\"https://link.dice.fm/x4a1909d0a6e?dice_id=x4a1909d0a6e\"},\"max_tickets\":8,\"seats_io_public_key\":null,\"id\":\"6942ba0fb88ce8000131638b\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"Teh Internet Is Serious Business\",\"about\":{\"description\":\"WE ARE ANONYMOUS.\\n\\nWE ARE LEGION.\\n\\nWE DO NOT FORGIVE.\\n\\nWE DO NOT FORGET.\\n\\nEXPECT US.\\n\\nA 16-year-old London schoolboy and an 18-year-old recluse in Shetland meet online, pick a fight with the FBI and change the world forever.\\n\\nTim Price gets behind the code with the original Anonymous members and creates an anarchic retelling of the birth of hacktivism. A fictional account of the true story of Anonymous and LulzSec, the collective swarm who took on the most powerful capitalist forces from their bedrooms.\\n\\nAge guidance 15+\\n\\nContent warning: This play is reflecting the language and ideologies used on the internet. It includes offensive language (including sexist, racist, homophobic) and imagery throughout. This play explores themes of the dark web, extremism, censorship, trolling and misogyny.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 15+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"tty_to_extras\":[],\"new\":false,\"donation\":null,\"perm_name\":\"ww59gg-teh-internet-is-serious-business-28th-jan-the-brit-theatre-the-brit-school-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"score\":0,\"event_tag\":null,\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}]},{\"presented_by\":\"Presented by The Clapham Grand.\",\"properties\":[],\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1000},\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-02/a986a9a1-f4cc-4908-9996-00ed9077b35f.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-02/a986a9a1-f4cc-4908-9996-00ed9077b35f.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-02/a986a9a1-f4cc-4908-9996-00ed9077b35f.jpg?rect=243%2C0%2C594%2C1080\"},\"announcement_date_unix\":1764139500,\"has_multiple_ticket_types\":true,\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the show or venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us prior to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com \\u0026 including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48282,\"title\":\"I have already purchased my tickets \\u0026 have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries, please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":2},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":3},{\"id\":48283,\"title\":\"Can I come back in if I leave the venue during a show or event?\",\"body\":\"Unless otherwise stated all our events have a no re-admission policy.\",\"order\":4},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":5}],\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-26T06:45:00+00:00\",\"sale_end_date\":\"2026-01-29T18:00:00+00:00\",\"sale_start_date\":\"2025-11-26T06:45:00+00:00\",\"event_start_date\":\"2026-01-29T18:00:00+00:00\",\"event_end_date\":\"2026-01-29T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"acquisition_type\":\"purchase\",\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"unicorn\":true,\"date_unix\":1769709600,\"is_hidden_event\":false,\"status\":\"on-sale\",\"is_ticket_available_at_door\":false,\"unicorn_extras\":true,\"offers_extras\":false,\"impression_id\":\"36a2bd84eebc2f97:11\",\"attendance_type\":\"live_only\",\"secondary_status\":null,\"streaming_options\":null,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-01-29T18:00:00+00:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"previews\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/n075e81ad892?dice_id=n075e81ad892\",\"post_competition_referral\":\"https://link.dice.fm/u3003ca0de3f?dice_id=u3003ca0de3f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/V77507a2f462?dice_id=V77507a2f462\",\"post_purchase_referral\":\"https://link.dice.fm/L13f92695a9e?dice_id=L13f92695a9e\",\"post_reminder_referral\":\"https://link.dice.fm/Mb9c1ea802ce?dice_id=Mb9c1ea802ce\",\"post_waitinglist_referral\":\"https://link.dice.fm/T2cb5c61fb17?dice_id=T2cb5c61fb17\"},\"max_tickets\":8,\"seats_io_public_key\":null,\"id\":\"6925a317b1af0600018ebb8b\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"A Palace Of Varieties - The Grand's 125th Birthday Show \",\"about\":{\"description\":\"**A PALACE OF VARIETIES - THE GRAND’S 125TH BIRTHDAY SHOW**\\n\\n**Thursday 29th January / Doors open 6pm / Show approx 7.30pm / Show end approx 10.30pm / Disco 'til late! 🪩**\\n\\n125 years of mischief, music, magic and mayhem… and we’re only just getting started!\\n\\nThis January, we’re throwing our doors open for a night that celebrates The Clapham Grand in all its 125 years of glory - and we’d love you to join us 🎉\\n\\nOur Birthday Show is a huge variety night celebrating The Grand's past, present \\u0026 future.\\n\\nOur extra special host with the most, Jayde Adams, will take us through an evening of comedy, drag, live music \\u0026 cabaret telling the story of our rich and varied history. Afterwards the show turns into a party as DJs from our fave club nights past and present bring you an old school disco ‘til late 🪩\\n\\n**The line up so far** includes **Jayde Adams, Tayce, Josh Berry, Lisa Maffia, Beaons on Toast, Sink The Pink, Dr Glitz \\u0026 The Fabulous Flirtations, Hugo Jennings, Bailey J Mills, London School of Samba, The Groove Chorus, Gallifrey Cabaret, Herr \\u0026 Me Ham It Up \\u0026 The Grand's Dreamteam** with more TBA!\\n\\nSupported by **Wandsworth Council** and the **Mayor of London**, this special event forms part of **Wandsworth’s London Borough of Culture 2025** celebrations.\\n\\nExpect a riot of comedy, cabaret, music, drag, archive moments and surprise guests as we relive 125 years of joy, resilience and reinvention.\\n\\nTickets start at just a tenner, but feel free to donate more 😘\\n\\nContributions from the birthday bash will go towards vital restoration and refurbishment work in our Grade II listed building.\\n\\nYour support will help keep this historic landmark venue standing for the next 125 years, so future generations can dance, laugh and fall in love right where you did.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"tty_to_extras\":[],\"new\":false,\"donation\":null,\"perm_name\":\"aveob2-a-palace-of-varieties-the-grands-125th-birthday-show-29th-jan-the-clapham-grand-london-tickets\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Jayde Adams\",\"image\":null,\"artist_id\":\"17607\",\"about\":null,\"is_headliner\":false},{\"name\":\"Beans On Toast\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-09-01/d29abec8-217a-4fbe-bae6-3bc2ed705002.jpg?rect=0%2C154%2C768%2C768\"},\"artist_id\":\"9113\",\"about\":null,\"is_headliner\":false},{\"name\":\"Tayce\",\"image\":null,\"artist_id\":\"29804\",\"about\":null,\"is_headliner\":false},{\"name\":\"Lisa Maffia\",\"image\":null,\"artist_id\":\"10331\",\"about\":null,\"is_headliner\":false},{\"name\":\"Josh Berry\",\"image\":null,\"artist_id\":\"39122\",\"about\":null,\"is_headliner\":false}],\"total_artists\":7,\"total_free_texts\":0},\"score\":0,\"event_tag\":null,\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}]},{\"presented_by\":\"Presented by The BRIT School Limited.\",\"properties\":[],\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":824},\"marketeers\":[],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-17/674f5724-0d3e-44c9-b37f-a36dd5a7081b.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-17/674f5724-0d3e-44c9-b37f-a36dd5a7081b.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-17/674f5724-0d3e-44c9-b37f-a36dd5a7081b.jpg?rect=270%2C0%2C660%2C1200\"},\"announcement_date_unix\":1765929600,\"has_multiple_ticket_types\":true,\"faqs\":[{\"id\":64992,\"title\":\"How to get here?\",\"body\":\"If travelling by car, please use SE25 5PL for Sat Nav, as our shared car parking entrance is in Dagnall Park. You will need to enter your registration plate at Reception to avoid a parking charge.\\n\\nThe Crescent is part of Croydon's Healthy Schools Scheme. This means that you can no longer drive a vehicle into The Crescent from 08.00am – 9.30am and 2.00pm – 4.00pm.\",\"order\":0},{\"id\":64993,\"title\":\"What is a Concession\",\"body\":\"A concession price is available for a child, student at any school, college or university or an OAP.\",\"order\":1},{\"id\":64994,\"title\":\"How do I book an access ticket?\",\"body\":\"Please contact tickets@brit.school before making your booking\",\"order\":2}],\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-17T00:00:00+00:00\",\"sale_end_date\":\"2026-01-30T19:00:00+00:00\",\"sale_start_date\":\"2025-12-19T12:00:00+00:00\",\"event_start_date\":\"2026-01-30T18:30:00+00:00\",\"event_end_date\":\"2026-01-30T20:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"acquisition_type\":\"purchase\",\"billing_promoter\":{\"id\":\"5585\",\"name\":\"The BRIT School Limited\",\"image\":{\"url\":null},\"perm_name\":\"the-brit-school-limited-r59q\",\"profile_active\":true},\"unicorn\":true,\"date_unix\":1769797800,\"is_hidden_event\":false,\"status\":\"on-sale\",\"is_ticket_available_at_door\":false,\"unicorn_extras\":true,\"offers_extras\":false,\"impression_id\":\"36a2bd84eebc2f97:12\",\"attendance_type\":\"live_only\",\"secondary_status\":null,\"streaming_options\":null,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"5662\",\"name\":\"The BRIT Theatre -  The BRIT School\",\"address\":\"60 The Crescent, Croydon CR0 2HN, UK\",\"location\":{\"lat\":51.3900037,\"lng\":-0.0914101},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-brit-theatre----the-brit-school-2gya\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-01-30T18:15:00+00:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"previews\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/baccb68900aa?dice_id=baccb68900aa\",\"post_competition_referral\":\"https://link.dice.fm/J35b637bdac4?dice_id=J35b637bdac4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/c78f60a95251?dice_id=c78f60a95251\",\"post_purchase_referral\":\"https://link.dice.fm/i926b8c93e12?dice_id=i926b8c93e12\",\"post_reminder_referral\":\"https://link.dice.fm/o00b85c215d1?dice_id=o00b85c215d1\",\"post_waitinglist_referral\":\"https://link.dice.fm/ud456b0945f9?dice_id=ud456b0945f9\"},\"max_tickets\":8,\"seats_io_public_key\":null,\"id\":\"6942b3fe2a4fb600017fdb2c\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"Citysong by Carys D. Coburn\",\"about\":{\"description\":\"In one night, three generations unfold into a portrait of the Dublin cityscape.\\n\\nThe City, though it sleeps, is alive with the clamour of voices.\\n\\nThey tell a story of cycles, parallels, and change.\\n\\nFrom nightclubs to hospitals, beaches to babies, births to deaths, beginnings to endings, Citysong celebrates life and its beauty in the face of its imperfections.\\n\\nTime ticks onward, Not Cruelly, But Unstoppably.\\n\\nSo, let us continue.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"tty_to_extras\":[],\"new\":false,\"donation\":null,\"perm_name\":\"9263d7-citysong-by-carys-d-coburn-30th-jan-the-brit-theatre-the-brit-school-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"score\":0,\"event_tag\":null,\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}]},{\"presented_by\":\"Presented by The Clapham Grand.\",\"properties\":[],\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1000},\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-01/f5aac8b6-8756-4983-b532-b0a7ae1e1421.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-01/f5aac8b6-8756-4983-b532-b0a7ae1e1421.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-01/f5aac8b6-8756-4983-b532-b0a7ae1e1421.jpg?rect=243%2C0%2C594%2C1080\"},\"announcement_date_unix\":1764583200,\"has_multiple_ticket_types\":true,\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the show or venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us prior to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com \\u0026 including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48282,\"title\":\"I have already purchased my tickets \\u0026 have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries, please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":2},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":3},{\"id\":48283,\"title\":\"Can I come back in if I leave the venue during a show or event?\",\"body\":\"Unless otherwise stated all our events have a no re-admission policy.\",\"order\":4},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":5}],\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-01T10:00:00+00:00\",\"sale_end_date\":\"2026-01-30T18:30:00+00:00\",\"sale_start_date\":\"2025-12-01T10:00:00+00:00\",\"event_start_date\":\"2026-01-30T18:30:00+00:00\",\"event_end_date\":\"2026-01-30T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"acquisition_type\":\"purchase\",\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"unicorn\":true,\"date_unix\":1769797800,\"is_hidden_event\":false,\"status\":\"on-sale\",\"is_ticket_available_at_door\":false,\"unicorn_extras\":true,\"offers_extras\":false,\"impression_id\":\"36a2bd84eebc2f97:13\",\"attendance_type\":\"live_only\",\"secondary_status\":null,\"streaming_options\":null,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-01-30T18:30:00+00:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"previews\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/t507c5f3d46f?dice_id=t507c5f3d46f\",\"post_competition_referral\":\"https://link.dice.fm/xa6369ec17f0?dice_id=xa6369ec17f0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/e93fc7c464d3?dice_id=e93fc7c464d3\",\"post_purchase_referral\":\"https://link.dice.fm/Zafdd4ca94d0?dice_id=Zafdd4ca94d0\",\"post_reminder_referral\":\"https://link.dice.fm/nda96309b124?dice_id=nda96309b124\",\"post_waitinglist_referral\":\"https://link.dice.fm/t891f746e3b8?dice_id=t891f746e3b8\"},\"max_tickets\":8,\"seats_io_public_key\":null,\"id\":\"692d87d53f4fd200018c1907\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"The Mummy Movie Night\",\"about\":{\"description\":\"**FRIDAY 30 JANUARY / DOORS 6.30PM / MOVIE FROM 7.30PM**\\n\\n**Oh, we've dreamt about this since we were little!**\\n\\nJoin us for the cult classic 🤩\\n\\nLook, we... We may not be explorers or adventurers, or treasure-seekers or gunfighters, but we're proud of what we are. A huge theatre with a massive screen! Featuring Evelyn \\u0026 Rick costume competition, toilet paper mummifying, Blood \\u0026 Sand cocktails \\u0026 the movie played in full 🔥\\n\\nCome for Brendan Fraser, stay for Rachel Weisz...\\n\\nPopcorn, hot dogs \\u0026 nachos served throughout 🍿\\n\\n**If you have any questions please scroll down to the FAQ section below.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"tty_to_extras\":[],\"new\":false,\"donation\":null,\"perm_name\":\"6dwr77-the-mummy-movie-night-30th-jan-the-clapham-grand-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"score\":0,\"event_tag\":null,\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}]},{\"presented_by\":\"Presented by Party with Ginger.\",\"properties\":[],\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2003},\"marketeers\":[],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=1313%2C0%2C3375%2C3375\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=188%2C0%2C5625%2C3375\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=2072%2C0%2C1856%2C3375\"},\"announcement_date_unix\":1744050600,\"has_multiple_ticket_types\":true,\"faqs\":[],\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-04-07T19:30:00+01:00\",\"sale_end_date\":\"2026-01-31T13:30:00+00:00\",\"sale_start_date\":\"2025-04-07T19:30:00+01:00\",\"event_start_date\":\"2026-01-31T13:00:00+00:00\",\"event_end_date\":\"2026-01-31T15:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"acquisition_type\":\"purchase\",\"billing_promoter\":{\"id\":\"14767\",\"name\":\"Party with Ginger\",\"image\":{\"url\":null},\"perm_name\":\"party-with-ginger-3oogv\",\"profile_active\":false},\"unicorn\":true,\"date_unix\":1769864400,\"is_hidden_event\":false,\"status\":\"on-sale\",\"is_ticket_available_at_door\":false,\"unicorn_extras\":true,\"offers_extras\":false,\"impression_id\":\"36a2bd84eebc2f97:14\",\"attendance_type\":\"live_only\",\"secondary_status\":null,\"streaming_options\":null,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"2590\",\"name\":\"Phoenix Arts Club\",\"address\":\"Phoenix St, London WC2H 8BU, UK\",\"location\":{\"lat\":51.5144031,\"lng\":-0.12897139999995488},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"phoenix-arts-club-98pn\",\"accessibility\":{\"url\":\"https://phoenixartsclub.com/about-us/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-01-31T13:00:00+00:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"previews\":[],\"social_links\":{\"event_share\":\"https://link.dice.fm/L09b2cd269f8?dice_id=L09b2cd269f8\",\"post_competition_referral\":\"https://link.dice.fm/xf56c8817972?dice_id=xf56c8817972\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Df7934b220b3?dice_id=Df7934b220b3\",\"post_purchase_referral\":\"https://link.dice.fm/gcbd8357df22?dice_id=gcbd8357df22\",\"post_reminder_referral\":\"https://link.dice.fm/w5b808215339?dice_id=w5b808215339\",\"post_waitinglist_referral\":\"https://link.dice.fm/Q93f8df62700?dice_id=Q93f8df62700\"},\"max_tickets\":99,\"seats_io_public_key\":null,\"id\":\"694e4de16b21f60001e23efa\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"The Big Drag Bingo Brunch \",\"about\":{\"description\":\"From the creators of Ginger’s Big Drag Brunch get ready to grab life by the balls with The Big Drag Bingo Brunch—your favorite drag bingo experience with a fabulous bottomless brunch twist, darling!\\n\\nJoin us for a glittering bottomless drag extravaganza, where we’ll play the campiest, most outrageous game of bingo you’ve ever experienced—think your Nanna’s dabber, but with a fabulous twist! Our stunning drag superstars will have you on your feet, dancing, and cheering faster than you can say \\\"HOUSE!\\\"\\n\\nExpect bonkers fun as we serve up hilarious bingo rounds, ridiculous games and lip sync battles, jaw-dropping drag performances, and a vibrant atmosphere filled with live DJs spinning the hottest party anthems. With bottomless Prosecco flowing and BIG prizes to be won, this event has something for everyone to enjoy!\\n\\nVenue- Phoenix Arts Club - nearest stations Tottenham Court Rd,\\n\\n(Doors 1pm) Show 1.30-3.30pm. Prosecco 1.30pm - 3.30pm. Bar and kitchen will remain open to purchase additional drinks throughout.\\n\\n\\\\* if you order food on the day, the options will be Pizza only.\\n\\nMAINS\\n\\n\\\\-Cheeseburger on a brioche bun, baby gem, beef tomato burger sauce GF on request\\n\\n\\\\-Buttermilk Chicken burger with cheese on a brioche bun, baby gem, beef tomato burger sauce GF on request\\n\\n\\\\-Vegan burger on a brioche bun, baby gem, beef tomato burger sauce V VG GF on request\\n\\nDESSERT\\n\\n\\\\-Chocolate and orange torte with vanilla ice cream VG V GF\\n\\n\\\\-Vanilla cheesecake with strawberry sauce V\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"tty_to_extras\":[],\"new\":false,\"donation\":null,\"perm_name\":\"ryny3y-the-big-drag-bingo-brunch-31st-jan-phoenix-arts-club-london-tickets\",\"summary_lineup\":{\"