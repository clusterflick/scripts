\\\":false},\\\"experiments\\\":{},\\\"flow\\\":{\\\"loading\\\":false,\\\"channel\\\":\\\"email\\\",\\\"availableChannels\\\":[]},\\\"artists\\\":{},\\\"promoters\\\":{},\\\"tickets\\\":{\\\"isLoading\\\":false},\\\"event\\\":{\\\"event\\\":{\\\"is_ticket_available_at_door\\\":false,\\\"properties\\\":[\\\"selling_fast\\\"],\\\"perm_name\\\":\\\"eo3oa6-salo-120-days-of-sodom-14th-feb-the-haggerston-london-tickets\\\",\\\"tags_types\\\":[{\\\"name\\\":\\\"film\\\",\\\"value\\\":\\\"culture:film\\\",\\\"title\\\":\\\"Film\\\"}],\\\"unicorn\\\":true,\\\"max_tickets\\\":6,\\\"public_refund_policy\\\":{\\\"type\\\":\\\"cooling_off_enabled\\\",\\\"hours\\\":24},\\\"shopping_cart_enabled\\\":false,\\\"summary_lineup\\\":{\\\"top_artists\\\":[],\\\"total_artists\\\":0,\\\"total_free_texts\\\":0},\\\"about\\\":{\\\"description\\\":\\\"Valentines Day is upon us again. \\\\nCome see the romantic Comedy Salò\\\\nUpon its release in 1975, Pier Paolo Pasolini's film Salò was met with outrage and controversy, banned in many countries around the world. Pasolini had been the subject of scandal throughout his career as an author, poet, playwright, journalist, actor and filmmaker, often confronting societal and sexual taboos head-on in his work, and openly criticizing Christianity and capitalism. The hysteria around Salò's release was heightened further by Pasolini's untimely, violent death, which occurred just three weeks before the film's premiere in Paris.\\\",\\\"highlights\\\":[{\\\"type\\\":\\\"age_restriction\\\",\\\"title\\\":\\\"This is an 18+ event.\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null},{\\\"type\\\":\\\"promoter\\\",\\\"title\\\":\\\"Presented by Deeper Into Movies.\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null},{\\\"type\\\":\\\"mask_required\\\",\\\"title\\\":\\\"Mask required\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null}]},\\\"seating\\\":null,\\\"seats_io_event_id\\\":null,\\\"price\\\":{\\\"currency\\\":\\\"GBP\\\",\\\"amount\\\":1000,\\