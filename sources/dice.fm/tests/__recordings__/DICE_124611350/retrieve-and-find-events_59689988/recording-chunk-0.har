\":{\\\"loading\\\":false,\\\"channel\\\":\\\"email\\\",\\\"availableChannels\\\":[]},\\\"artists\\\":{},\\\"promoters\\\":{},\\\"tickets\\\":{\\\"isLoading\\\":false},\\\"event\\\":{\\\"event\\\":{\\\"unicorn\\\":true,\\\"is_ticket_available_at_door\\\":false,\\\"price\\\":{\\\"currency\\\":\\\"GBP\\\",\\\"amount\\\":1000,\\\"sales_tax\\\":0,\\\"amount_from\\\":null},\\\"is_fully_locked\\\":false,\\\"seats_io_public_key\\\":null,\\\"venues\\\":[{\\\"id\\\":\\\"298\\\",\\\"name\\\":\\\"Strongroom Bar\\\",\\\"address\\\":\\\"120-124 Curtain Rd, Shoreditch, London EC2A 3SQ, UK\\\",\\\"location\\\":{\\\"lat\\\":51.5259644,\\\"lng\\\":-0.0801498},\\\"image\\\":{\\\"url\\\":\\\"https://dice-media.imgix.net/attachments/2021-11-09/01c2cab5-15ea-48e0-a0b4-d9ed0465d9db.jpg?rect=0%2C0%2C850%2C850\\\"},\\\"city\\\":{\\\"id\\\":\\\"54d8a23438fe5d27d500001c\\\",\\\"name\\\":\\\"London\\\",\\\"location\\\":{\\\"lat\\\":51.507653,\\\"lng\\\":-0.107722,\\\"accuracy\\\":12,\\\"place\\\":\\\"Europe/London\\\"},\\\"country_code\\\":\\\"GB\\\",\\\"country_id\\\":\\\"54d8a87238fe5d27d500988a\\\",\\\"country_name\\\":\\\"United Kingdom\\\"},\\\"perm_name\\\":\\\"strongroom-bar-4bym\\\",\\\"accessibility\\\":{\\\"url\\\":null},\\\"profile_active\\\":true,\\\"highlights\\\":[{\\\"type\\\":\\\"capacity\\\",\\\"title\\\":\\\"300 capacity\\\"}],\\\"space_name\\\":null,\\\"doors_open_date\\\":\\\"2026-01-12T19:00:00+00:00\\\",\\\"doors_close_date\\\":null}],\\\"tags_types\\\":[{\\\"name\\\":\\\"film\\\",\\\"value\\\":\\\"culture:film\\\",\\\"title\\\":\\\"Film\\\"}],\\\"max_tickets\\\":20,\\\"seating\\\":null,\\\"date_unix\\\":1768244400,\\\"billing_promoter\\\":{\\\"id\\\":\\\"11708\\\",\\\"name\\\":\\\"Kino Short Film\\\",\\\"image\\\":{\\\"url\\\":null},\\\"perm_name\\\":\\\"kino-short-film-n5g5\\\",\\\"profile_active\\\":false},\\\"is_hidden_event\\\":false,\\\"acquisition_type\\\":\\\"purchase\\\",\\\"seats_io_event_id\\\":null,\\\"perm_name\\\":\\\"mx88yr-short-film-open-mic-12th-jan-strongroom-bar-london-tickets\\\",\\\"secondary_status\\\":null,\\\"status\\\":\\\"on-sale\\\",\\\"summary_lineup\\\":{\\\"top_artists\\\":[],\\\"total_artists\\\":0,\\\"total_free_texts\\\":1},\\\"about\\\":{\\\"description\\\":\\\"Whether you’re looking for a chance to screen your short film in front of a live audience for free OR you’re looking to watch something wild, wacky, and creative outside of the mainstream, our open mic is refreshingly non-competitive in an all-too-oftentimes intimidating industry.\\\\n\\\\nBoth industry professionals and first-timers bring their shorts to Kino making the quality of cinema screened at each event both diverse and entertaining. And with such a broad spectrum of new work being screened, our Open Mic is a genuine reflection of the current output of London based filmmakers.\\\\n\\\\nREGISTER TO SCREEN YOUR SHORT FILM HERE: www.kinoshortfilm.com/short-film-openmic\\\\n\\\\n- One film per filmmaker\\\\n- Register in advance\\\\n- Filmmakers must be present to introduce film\\\\n- Films are accepted on a first-come, first-screened basis\\\\n- Film running time should be under 10 mins\\\\n\\\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\\\",\\\"highlights\\\":[{\\\"type\\\":\\\"promoter\\\",\\\"title\\\":\\\"Presented by Kino Short Film.\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null}]},\\\"unicorn_extras\\\":true,\\\"donation\\\":null,\\\"faqs\\\":[],\\\"social_links\\\":{\\\"event_share\\\":\\\"https://link.dice.fm/w3065dfe1eab?dice_id=w3065dfe1eab\\\",\\\"post_competition_referral\\\":\\\"https://link.dice.fm/v8c11da1099c?dice_id=v8c11da1099c\\\",\\\"post_purchase_extras_available_referral\\\":\\\"https://link.dice.fm/Geb658d70a1c?dice_id=Geb658d70a1c\\\",\\\"post_purchase_referral\\\":\\\"https://link.dice.fm/y93d88022143?dice_id=y93d88022143\\\",\\\"post_reminder_referral\\\":\\\"https://link.dice.fm/Q05219dc00be?dic