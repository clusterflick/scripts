urchase_extras_available_referral\\\":\\\"https://link.dice.fm/Fed088776c19?dice_id=Fed088776c19\\\",\\\"post_purchase_referral\\\":\\\"https://link.dice.fm/Bd586ce29251?dice_id=Bd586ce29251\\\",\\\"post_reminder_referral\\\":\\\"https://link.dice.fm/be045f04af5d?dice_id=be045f04af5d\\\",\\\"post_waitinglist_referral\\\":\\\"https://link.dice.fm/bf50744ee711?dice_id=bf50744ee711\\\"},\\\"unicorn\\\":true,\\\"announcement_date_unix\\\":1762732800,\\\"unicorn_extras\\\":false,\\\"venues\\\":[{\\\"id\\\":\\\"43\\\",\\\"name\\\":\\\"MOTH Club\\\",\\\"address\\\":\\\"Old Trades Hall, Valette Street, London E9 6NU\\\",\\\"location\\\":{\\\"lat\\\":51.5450825,\\\"lng\\\":-0.0546326999999565},\\\"image\\\":{\\\"url\\\":\\\"https://dice-media.imgix.net/attachments/2021-04-14/0164c968-c9f6-4e55-8329-e0a12ce43b69.jpg?rect=341%2C0%2C1367%2C1367\\\"},\\\"city\\\":{\\\"id\\\":\\\"54d8a23438fe5d27d500001c\\\",\\\"name\\\":\\\"London\\\",\\\"location\\\":{\\\"lat\\\":51.507653,\\\"lng\\\":-0.107722,\\\"accuracy\\\":12,\\\"place\\\":\\\"Europe/London\\\"},\\\"country_code\\\":\\\"GB\\\",\\\"country_id\\\":\\\"54d8a87238fe5d27d500988a\\\",\\\"country_name\\\":\\\"United Kingdom\\\"},\\\"perm_name\\\":\\\"moth-club-43ox\\\",\\\"accessibility\\\":{\\\"url\\\":\\\"https://mothclub.co.uk/Access\\\"},\\\"profile_active\\\":true,\\\"highlights\\\":[{\\\"type\\\":\\\"accessibility\\\",\\\"title\\\":\\\"Accessibility information\\\",\\\"external_link\\\":\\\"https://mothclub.co.uk/Access\\\"}],\\\"space_name\\\":null,\\\"doors_open_date\\\":\\\"2026-01-11T19:30:00+00:00\\\",\\\"doors_close_date\\\":null}],\\\"images\\\":{\\\"square\\\":\\\"https://dice-media.imgix.net/attachments/2025-11-10/c9064801-def4-4a4c-8162-143dca6cf352.jpg?rect=495%2C0%2C1080%2C1080\\\",\\\"landscape\\\":\\\"https://dice-media.imgix.net/attachments/2025-11-10/c9064801-def4-4a4c-8162-143dca6cf352.jpg?rect=60%2C0%2C1800%2C1080\\\",\\\"portrait\\\":\\\"https://dice-media.imgix.net/attachments/2025-11-10/c9064801-def4-4a4c-8162-143dca6cf352.jpg?rect=663%2C0%2C594%2C1080\\\"},\\\"is_fully_locked\\\":false,\\\"has_multiple_ticket_types\\\":false,\\\"attendance_type\\\":\\\"live_only\\\",\\\"price\\\":{\\\"currency\\\":\\\"GBP\\\",\\\"amount\\\":650,\\\"sales_tax\\\":0,\\\"amount_from\\\":null},\\\"about\\\":{\\\"description\\\":\\\"***Dancing Barefoot presents: Stop Making Sense (1984)***\\\\n\\\\nAhead of their first ever Byrne’s Night tour (and biggest show yet at KOKO), the crew behind London’s cult celebration of David Byrne and Robert Burns return to their original home at MOTH Club for a Sunday night screening of the Talking Heads classic Stop Making Sense. Followed by some Talking Heads and adjacent themed karaoke, it's the perfect warm-up before the chaos.\\\\n\\\\nJonathan Demme’s Stop Making Sense (1984) captures Talking Heads at their creative peak. A kinetic, transcendent live film that redefined what a concert movie could be. Hailed by critics as one of the greatest concert films of all time, it features core members David Byrne, Tina Weymouth, Chris Frantz, and Jerry Harrison, joined by Bernie Worrell, Alex Weir, Steve Scales, Lynn Mabry, and Edna Holt. Filmed over three nights at Hollywood’s Pantages Theater in December 1983, it’s an electrifying performance of the band’s most unforgettable songs.\\\",\\\"highlights\\\":[{\\\"type\\\":\\\"age_restriction\\\",\\\"title\\\":\\\"This is an 18+ event.\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null},{\\\"type\\\":\\\"promoter\\\",\\\"title\\\":\\\"Presented by Dancing Barefoot\\\",\\\"subtitle\\\":null,\\\"external_link\\\":null}]},\\\"id\\\":\\\"6912251ef7ec27000104583d\\\",\\\"name\\\":\\\"Byrne's Night: Stop Making Sense Screening+Karaoke\\\",\\\"seating\\\":null,\\\"tags_types\\\":[{\\\"name\\\":\\\"film\\\",\\\"value\\\":\\\"culture:film\\\",\\\"title\\\":\\\"Film\\\"}],\\\"tty_to_extras\\\":[],\\\"properties\\\":[],\\\"public_refund_policy\\\":{\\\"type\\\":\\\"cooling_off_enabled\\\",\\\"hours\\\":24},\\\"max_t