\\u2028about available tickets in time\",\"waiting_list_confirmation_screen_feature_4\":\"You can change the number of tickets you want\",\"waiting_list_confirmation_screen_title\":\"You’re on the wait list,\\nnow you need the app\",\"waiting_list_confirmation_screen_title_v2\":\"You’re on the wait list, \\nnow get the app\"},\"tags\":{\"tags_hierarchy\":{\"culture_art\":\"Art\",\"culture_comedy\":\"Comedy\",\"culture_film\":\"Film\",\"culture_podcast\":\"Podcast\",\"culture_social\":\"Social\",\"culture_sport\":\"Sport\",\"culture_talks\":\"Talk\",\"culture_theatre\":\"Theatre\",\"culture_wellbeing\":\"Wellbeing\",\"culture_workshop\":\"Workshop\",\"music_artistsigning\":\"Artist signing\",\"music_dj\":\"DJ\",\"music_gig\":\"Gigs\",\"music_party\":\"Party\",\"music_playback\":\"Playback\"}}}},\"initialLanguage\":\"en\",\"i18nServerInstance\":null,\"pageProps\":{\"currency\":\"GBP\",\"city\":{\"code\":\"london\",\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\",\"accuracy\":12},\"country_code\":\"GB\",\"perm_name\":\"london\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\",\"state_code\":\"ENG\",\"country_perm_name\":\"united-kingdom\"},\"events\":[{\"presented_by\":\"Presented by EVE: Riot Grrrls of Wrestling.\",\"properties\":[],\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2500},\"marketeers\":[{\"id\":1146,\"name\":\"EVE: Riot Grrrls of Wrestling\",\"privacy_policy_link\":null,\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-03/94f3b970-ffe5-453b-9af3-a5992409b24a.jpg?rect=863%2C0%2C3467%2C3467\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-03/94f3b970-ffe5-453b-9af3-a5992409b24a.jpg?rect=0%2C176%2C5193%2C3116\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-03/94f3b970-ffe5-453b-9af3-a5992409b24a.jpg?rect=1643%2C0%2C1907%2C3467\"},\"announcement_date_unix\":1759502700,\"has_multiple_ticket_types\":true,\"faqs\":[{\"id\":48773,\"title\":\"I have a group booking of seated tickets, is there a way we can sit together?\",\"body\":\"Although our seating is unassigned if you have a group booking of THREE or more we'll automatically reserve your seats together for you!\\n\\nIf your group purchased tickets separately, just email us at: contact@evewrestling.com letting us know the names and number of people in your group and we'll get it sorted.\",\"order\":0},{\"id\":48774,\"title\":\"I'm entitled to a Complimentary Carers ticket, how do I go about getting this?\",\"body\":\"Please email us at: contact@evewrestling.com and we'll sort that for you.\",\"order\":1},{\"id\":48775,\"title\":\"What is the age policy?\",\"body\":\"This event is strictly 18+\",\"order\":2},{\"id\":48776,\"title\":\"Is there parking onsite?\",\"body\":\"Unfortunately there is no onsite parking.\",\"order\":3},{\"id\":48777,\"title\":\"Is there a content warning for this show?\",\"body\":\"EVE events contain strong language, loud noises and simulated fight scenes throughout which can at times spill into the audience. EVE events include cabaret acts which may be provocative in nature. Flashing lights are used at our events. As such, EVE events may not be suitable for everyone.\",\"order\":4}],\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-03T15:45:00+01:00\",\"sale_end_date\":\"2026-01-09T21:00:00+00:00\",\"sale_start_date\":\"2025-10-03T15:45:00+01:00\",\"event_start_date\":\"2026-01-09T20:00:00+00:00\",\"event_end_date\":\"2026-01-09T23:00:00+00:00\",\"i