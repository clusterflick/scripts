43a55a1c864.jpg?rect=0%2C468%2C1440%2C864\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-19/fc9ef3d8-c23c-4977-8b0c-a43a55a1c864.jpg?rect=225%2C0%2C990%2C1800\"},\"properties\":[],\"about\":{\"description\":\"***Jam Baxter*** - An outlier in the landscape of UK rap, Jam Baxter is the scene’s premiere surrealist. Beginning his career as part of foundational hip hop collective Contact Play, the emcee experimented with boom bap, narrating the mucky stories of a misspent adolescence.\\n\\n***Artists:*** We are always interested in hearing from talented artists. If you’d like to play at our future events, please get in touch at info@realsounds.uk.\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"highlights\":[]},\"id\":\"6980d0364fb5550001b60de3\",\"name\":\"Jam Baxter\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Brains\",\"redirect_url\":\"https://open.spotify.com/track/3dqDRmye4pQMEHBFvJxhsA\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/0f0f0007af1e9e33f19d73b4401942e170173b2b?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Brains\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Jam Baxter\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eba2e3191047d5e715c2c3b14c\"},\"artist_id\":\"9322\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-04T11:00:00+00:00\",\"sale_end_date\":\"2026-05-07T23:00:00+01:00\",\"sale_start_date\":\"2026-02-09T11:00:00+00:00\",\"event_start_date\":\"2026-05-07T19:00:00+01:00\",\"event_end_date\":\"2026-05-07T23:00:00+01:00\",\"is_multi_days_event\":false,\