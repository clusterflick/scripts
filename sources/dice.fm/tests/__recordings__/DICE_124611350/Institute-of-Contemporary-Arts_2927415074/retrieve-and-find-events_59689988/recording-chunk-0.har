out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1775579400,\"has_multiple_ticket_types\":false,\"impression_id\":\"7a59805d984377b8:89\",\"price\":{\"currency\":\"GBP\",\"amount\":3175,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-19/fd389ce0-a9bf-44ef-90e1-50caaa010095.jpg?rect=0%2C0%2C3000%2C3000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-19/fd389ce0-a9bf-44ef-90e1-50caaa010095.jpg?rect=0%2C600%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-19/fd389ce0-a9bf-44ef-90e1-50caaa010095.jpg?rect=675%2C0%2C1650%2C3000\"},\"id\":\"696e0d5fdb18ad0001fcbc53\",\"name\":\"Luciano (Matinee Show)\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"**The definitive voice of conscious roots reggae.**\\n\\nEmerging from Jamaica to redefine the spiritual landscape of reggae, **Luciano** bridges the gap between the \\\"One Love\\\" legacy of **Bob Marley** and the versatility of modern soul and blues.\\n\\nWith a voice often compared to **Pavarotti** for its impeccable range and pitch, he moves effortlessly between **heavy roots rhythms** and **melodic elegance**. An iconic, Grammy-nominated figure and one of **Rolling Stone’s \\\"Greatest Singers of All Time,\\\"** Luciano delivers a live performance that is as visceral as it is illuminating.\\n\\n**A masterclass in positive vibration and vocal mastery, this is a rare opportunity to see \\\"The Messenjah\\\" live in the heart of London.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-19T14:00:00+00:00\",\"sale_end_date\":\"2026-04-07T17:30:00+01:00\",\"sale_start_date\":\"2026-01-19T14:00:00+00:00\",\"event_start_date\":\"2