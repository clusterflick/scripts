0ab-a84f-cbf0bc4dccdc.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-30/c142db6c-d52b-40ab-a84f-cbf0bc4dccdc.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"sold-out\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/h3b3a22cc03f?dice_id=h3b3a22cc03f\",\"post_competition_referral\":\"https://link.dice.fm/Qd86146b47dd?dice_id=Qd86146b47dd\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/t88c407a579d?dice_id=t88c407a579d\",\"post_purchase_referral\":\"https://link.dice.fm/U771fa16bdad?dice_id=U771fa16bdad\",\"post_reminder_referral\":\"https://link.dice.fm/la5abb1e0654?dice_id=la5abb1e0654\",\"post_waitinglist_referral\":\"https://link.dice.fm/a3080fcc0e51?dice_id=a3080fcc0e51\"},\"is_hidden_event\":false,\"secondary_status\":\"waiting-list\",\"marketeers\":[{\"id\":1031,\"name\":\"Communion ONE\",\"privacy_policy_link\":\"https://www.communionmusic.co.uk/terms/communion-one-privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"db136d3610fd9326:5\",\"properties\":[],\"presented_by\":\"Presented by Communion ONE.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1759309200,\"id\":\"68dbcdeaedabee0001a16e47\",\"name\":\"Amber Run\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**Communion ONE presents**\\n\\n**Amber Run (Acoustic Tour)**\\n\\n**\\\\+ Pippa Crossland**\\n\\nComprised of frontman Joe Keogh, bassist Tomas Sperring, and keyboardist Henry Wyeth, Amber Run have managed not just to continue but to thrive on their own terms through making music together.\\n\\nThe trio first captivated audiences in 2014 with the release of ‘5AM’, where they built lasting relationships with a fanbase who found relatability in their deeply moving songwriting. Through their subsequent albums, ‘For A Moment, I Was Lost’ and ‘Philophobia’ and 'How To Be Human', the band have continued to provide the soundtrack to the lives of people all over the world with songs that often cut to the quick of life’s more difficult moments.\\n\\nThrough the years, their early 2014 single \\\"I Found\\\", has taken on a life of its own; currently sitting at over half a billion streams having found viral success connecting with a new generation of fans on TikTok, where millions of people have created videos inspired by the track.\\n\\n2025 has seen Amber Run release brand new versions of “I Found” and “5am” alongside feature versions with the UK’s Freya Ridings and Canada’s Billianne respectively – a celebration of what their music has meant to millions all over the world. In 2026, Amber Run will return, stripping back their songs to their vulnerable core for an acoustic show in some of the UK’s most beautiful venues.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Under 16s must be accompanied by an adult.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"14302\",\"name\":\"Communion ONE\",\"image\":{\"url\":null},\"perm_name\":\"communion-one-bbl7g\",\"profile_active\":true},\"date_unix\":1771700400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":0},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-07-09T10:00:00+01:00\",\"sale_end_date\":\"2026-02-21T21:00:00+00:00\",\"sale_start_date\":\"2025-07-11T10:00:00+01:00\",\"event_start_date\":\"2026-02-21T19:00:00+00:00\",\"event_end_date\":\"2026-02-21T22:00:00+00:00\",\"is_multi_days_event\":false,