derworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-04T18:00:00+01:00\",\"doors_close_date\":\"2026-04-04T23:00:00+01:00\"}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"announcement_date_unix\":1744016400,\"social_links\":{\"event_share\":\"https://link.dice.fm/Rcae2140bc04?dice_id=Rcae2140bc04\",\"post_competition_referral\":\"https://link.dice.fm/l0902be8a149?dice_id=l0902be8a149\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/v0ac2675003f?dice_id=v0ac2675003f\",\"post_purchase_referral\":\"https://link.dice.fm/I85b08ce8546?dice_id=I85b08ce8546\",\"post_reminder_referral\":\"https://link.dice.fm/Eb0ab22406c5?dice_id=Eb0ab22406c5\",\"post_waitinglist_referral\":\"https://link.dice.fm/l5a6e42df4d2?dice_id=l5a6e42df4d2\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"k6qxol-the-year-grunge-broke-4th-apr-the-underworld-london-tickets\",\"unicorn\":false,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1775322000,\"has_multiple_ticket_types\":false,\"impression_id\":\"7a59805d984377b8:50\",\"price\":{\"currency\":\"GBP\",\"amount\":2107,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-04-01/14bba481-a7ac-479b-91d4-2212b4b949f6.jpg?rect=98%2C4%2C876%2C876\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-04-01/14bba481-a7ac-479b-91d4-2212b4b949f6.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-04-01/14bba481-a7ac-479b-91d4-2212b4b949f6.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"67ebf892ecb7030001500ff0\",\"name\":\"The Year Grunge Broke\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"𝗧𝗛𝗘 𝗬𝗘𝗔𝗥 𝗚𝗥𝗨𝗡𝗚𝗘 𝗕𝗥𝗢𝗞𝗘 UK tour. After explosive sell out shows in February 2025, The YEAR Grunge BROKE returns to the UK for what promises to be an unforgettable celebration of Grunge and '90s Alternative Rock. With well over half a million Facebook followers and spectacular live performances, this is a show you don't want to miss..! 𝗘𝗔𝗥𝗟𝗬 𝗕𝗢𝗢𝗞𝗜𝗡𝗚 𝗔𝗗𝗩𝗜𝗦𝗘𝗗!\\n\\nFans of Nirvana, Pearl Jam, Soundgarden, Alice In Chains, The Smashing Pumpkins, Stone Temple Pilots, Tool, Rage Against The Machine, and more, 𝗟𝗜𝗦𝗧𝗘𝗡 𝗨𝗣! Immerse yourself in the raw energy and defiant spirit of Grunge and '90s Alternative Rock with 𝗧𝗛𝗘 𝗬𝗘𝗔𝗥 𝗚𝗥𝗨𝗡𝗚𝗘 𝗕𝗥𝗢𝗞𝗘, a true homage to the last great era of rock.\\n\\n𝗧𝗛𝗘 𝗬𝗘𝗔𝗥 𝗚𝗥𝗨𝗡𝗚𝗘 𝗕𝗥𝗢𝗞𝗘 captures the unbridled energy of these legendary '90s bands in stunning detail, night after night. BOOK NOW..!!\\n\\nJoin us for the after party from 11pm to 3am at The Underworld's Camden Rocks Club, get your tickets!\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-04-07T10:00:00+01:00\",\"sale_end_date\":\"2026-04-04T18:00:00+01:00\",\"sale_start_date\":\"2025-04-07T10:00:00+01:00\",\"event_start_date\":\"2026-04-04T18:00:00+01:00\",\"event_end_date\":\"2026-04-04T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Nirvana - Come As You Are\",\"redirect_url\":\"https://music.apple.com/us/album/come-as-you-are/1440783617?i=1440783636&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Nirvana\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/f4/3e/86/f43e8664-bdd9-bc56-8d2b-76064c865920/mzaf_15456055651529260945.plus.aac.p.m4a\",\"track_name\":\"Come As You Are\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"zeyne\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-05-26/cc63d010-294d-4ab2-a4dd-54bcbd6e3625.jpg?rect=0%2C51%2C538%2C538\"},\"artist_id\":\"121735\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Live Nation.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":39398,\"title\":\"What are the age restrictions?\",\"body\":\"This is a 16+ event. Each under 18 must be accompanied by a responsible adult (1:1 ratio). Customers may be requested to provide valid physical photo ID upon entry, this is to ensure customer safety and ensure our legal age requirements are met. For this reason, we request that all customers bring valid ID. Digital or photocopied ID will not be accepted. For further information see Age and ID in FAQ’s. Right of admission reserved.\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"835\",\"name\":\"Village Underground\",\"address\":\"54 Holywell Lane, London EC2A 3PQ, UK\",\"location\":{\"lat\":51.5234726,\"lng\":-0.07799529999999777},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/5b7b8372-c6a3-4dfa-ad59-4bfaabe94ddc.jpg?rect=317%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"village-underground-wwop\",\"accessibility\":{\"url\":\"https://bit.ly/3EhSLgF\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-04T19:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"11556\",\"name\":\"Village Underground\",\"image\":{\"url\":null},\"perm_name\":\"village-underground-n5v8\",\"profile_active\":false},\"announcement_date_unix\":1767970800,\"social_links\":{\"event_share\":\"https://link.dice.fm/B3aaac4820a2?dice_id=B3aaac4820a2\",\"post_competition_referral\":\"https://link.dice.fm/X960ac65a12c?dice_id=X960ac65a12c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/i491b3d2fbb2?dice_id=i491b3d2fbb2\",\"post_purchase_referral\":\"https://link.dice.fm/P09490b344ba?dice_id=P09490b344ba\",\"post_reminder_referral\":\"https://link.dice.fm/N62d3c87416e?dice_id=N62d3c87416e\",\"post_waitinglist_referral\":\"https://link.dice.fm/Qb1ccbb4e923?dice_id=Qb1ccbb4e923\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"xe5d3m--zeyne-4th-apr-village-underground-london-tickets\",\"unicorn\":true,\"status\":\"sold-out\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":854,\"name\":\"Village Underground\",\"privacy_policy_link\":\"https://villageunderground.co.uk/privacy-policy/\",\"fb_pixel_id\":\"574810874256593\",\"ga_tracking_id\":\"G-TTMX0FS0EH\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"SOfECKivg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":true,\"date_unix\":1775325600,\"has_multiple_ticket_types\":true,\"impression_id\":\"7a59805d984377b8:51\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3065},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-08/de6b108c-f9cf-46b3-b442-d804b934e811.jpg?rect=0%2C509%2C7698%2C7698\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-08/de6b108c-f9cf-46b3-b442-d804b934e811.jpg?rect=0%2C2048%2C7698%2C4619\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-08/de6b108c-f9cf-46b3-b442-d804b934e811.jpg?rect=1453%2C0%2C4793%2C8715\"},\"id\":\"695e2c7c64bab000018d98c0\",\"name\":\" zeyne \",\"seating\":null,\"secondary_status\":\"waiting-list\",\"new\":false,\"about\":{\"description\":\"Zeyne is one of the most compelling voices redefining contemporary Arab pop. Emerging in 2021 with her debut single Minni Ana, the Jordanian artist has carved out a singular sound -fusing soul, R&B, experimental pop, and Arab musical heritage with emotional precision and fearless intent.\\n\\nHer debut album AWDA is a defining statement of return and self-authorship. Anchored by the viral cultural touchstone Asli Ana and focus track Kollo Lena, the project moves fluidly between vulnerability and defiance, resonating across the region and diaspora. AWDA has amassed over 67.5 million streams, was named among NPR’s Ann Powers’ Top 10 Albums of 2025, and selected as YUNG Magazine’s Album of the Year, positioning Zeyne as one of the most exciting artists to emerge from the MENA region.\\n\\nBeyond music, Zeyne’s influence is deeply cultural. Selected for YouTube’s Global Artist Development Program, she appeared on billboards in Times Square and Leicester Square, collaborated with Bottega Veneta, and made history as the first Levantine woman on COLORS.\\n\\nFeatured in DAZED’s Global 100, Rolling Stone MENA, and named an Apple Music Up Next artist, she supported Ed Sheeran at Off Limits Festival Abu Dhabi in 2025. As AWDA continues to evolve live into 2026, Zeyne is expanding the global imagination of Arab pop.\\n\\nIf you have any queries or would like more information about access at Village Underground, please see our FAQs here: https://bit.ly/3EhSLgF, or contact access@villageunderground.co.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-09T15:00:00+00:00\",\"sale_end_date\":\"2026-04-04T21:00:00+01:00\",\"sale_start_date\":\"2026-01-16T10:00:00+00:00\",\"event_start_date\":\"2026-04-04T19:00:00+01:00\",\"event_end_date\":\"2026-04-04T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Proper.\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebd0fb2d57cfcaf5d77038bf46\"},\"artist_id\":\"18934\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Beth Shalom\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"1252\",\"name\":\"The George Tavern\",\"address\":\"373 Commercial Rd, London E1 0LA, UK\",\"location\":{\"lat\":51.51433609999999,\"lng\":-0.05291299999998955},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\