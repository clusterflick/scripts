ble_at_door\":false,\"about\":{\"description\":\"Communion ONE presents\\n\\nMadison Cunningham\\n\\n\\\\+ Martin Luke Brown\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"No under 8s, under 14s need to be in the balcony with an adult\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"14302\",\"name\":\"Communion ONE\",\"image\":{\"url\":null},\"perm_name\":\"communion-one-bbl7g\",\"profile_active\":true},\"date_unix\":1772650800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3090},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-17T10:00:00+01:00\",\"sale_end_date\":\"2026-03-04T17:00:00+00:00\",\"sale_start_date\":\"2025-09-19T10:00:00+01:00\",\"event_start_date\":\"2026-03-04T19:00:00+00:00\",\"event_end_date\":\"2026-03-04T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"k6oe8q-psychedelic-porn-crumpets-4th-mar-o2-forum-kentish-town-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Psychedelic Porn Crumpets - Cornflake\",\"redirect_url\":\"https://open.spotify.com/track/2SPI1dXVaZvR4qlwbzxdcC\",\"artist\":\"Psychedelic Porn Crumpets\",\"preview_url\":\"https://p.scdn.co/mp3-preview/36c73b021e03ffbbdfd4109add2688b58e422181?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Cornflake\"},{\"type\":\"apple_music\",\"title\":\"Psychedelic Porn Crumpets - Cornflake\",\"redirect_url\":\"https://music.apple.com/us/album/cornflake/1087644953?i=1087645680&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Psychedelic Porn Crumpets\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/af/20/9b/af209bb7-2f0b-5ee2-e425-bd15846b9746/mzaf_17727285613784599786.plus.aac.p.m4a\",\"track_name\":\"Cornflake\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[{\"id\":44694,\"title\":\"What's the bag policy?\",\"body\":\"**Security – Bag Policy**\\n\\nLarge bags including rucksacks are not allowed. There are no facilities to leave large bags or luggage. If you really have to bring a bag – and it’s preferable you don’t – please make sure it’s small. Only one small bag per person is permitted and it must not be bigger than A4 size.\\n\\nHeight: 28.7cm / Width: 21cm / Depth 15cm\",\"order\":0}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Psychedelic Porn Crumpets\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-06/5e54b512-927c-4aeb-b9b2-f2a206b7ae58.jpg?rect=16%2C0%2C609%2C609\"},\"artist_id\":\"8002\",\"about\":{\"description\":\"The Crumpets are back out on the road in support of their DOUBLE album releases in 2025. After ‘Carpe Diem, Moonman’ dropped in May to wide critical acclaim, PPC announced the surprise release of ‘Pogo Rodeo’ in October, swiftly following up with another collection of rock & roll, lyrical madness & that perfect blend of energy-inducing & chilled intricacies that make them one of the most interesting acts operating.\\n\\nThis tour sees Crumpets tackle their largest size shows ever in UK/EU - notably the Albert Hall, Manchester & the iconic O2 Forum Kentish Town in London. 2 special underplay shows at the Melkweg in Amsterdam before heading into Germany, Switzerland, Spain & rounding it off at the Bataclan in Paris.\",\"highlights\":[]},\"is_headliner\":true},{\"name\":\"Waldo's Gift\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-25/2e9225e8-ee60-4f98-b3de-72e989cb77c1.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"13485\",\"about\":null,\"is_headliner\":false},{\"name\":\"Floral Image\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb1b49f3b1b327c0e5a2ff758c\"},\"artist_id\":\"78299\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"934\",\"name\":\"O2 Forum Kentish Town\",\"address\":\"9-17 Highgate Rd, London NW5 1JY\",\"location\":{\"lat\":51.5521427,\"lng\":-0.142224499999998},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"o2-forum-kentish-town-8er7\",\"accessibility\":{\"url\":\"https://academymusicgroup.com/o2forumkentishtown/access\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-04T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-18/183986fb-5a76-4893-b5d5-cded9ed8f4b8.jpg?rect=500%2C0%2C2000%2C2000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-18/183986fb-5a76-4893-b5d5-cded9ed8f4b8.jpg?rect=0%2C100%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-18/183986fb-5a76-4893-b5d5-cded9ed8f4b8.jpg?rect=950%2C0%2C1100%2C2000\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ie804ac3c80c?dice_id=Ie804ac3c80c\",\"post_competition_referral\":\"https://link.dice.fm/x9d885c924a1?dice_id=x9d885c924a1\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/i4e00dee8094?dice_id=i4e00dee8094\",\"post_purchase_referral\":\"https://link.dice.fm/Z77213c1ac3f?dice_id=Z77213c1ac3f\",\"post_reminder_referral\":\"https://link.dice.fm/F15ab18c61b5?dice_id=F15ab18c61b5\",\"post_waitinglist_referral\":\"https://link.dice.fm/nbc49347ad05?dice_id=nbc49347ad05\"},\"is_h