id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780174800,\"has_multiple_ticket_types\":true,\"impression_id\":\"55e67ca3ba9827ff:50\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1100},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-04/553f7cfb-0675-43b6-845a-20b7cc93df10.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-04/553f7cfb-0675-43b6-845a-20b7cc93df10.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-04/553f7cfb-0675-43b6-845a-20b7cc93df10.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"6983336860e62f0001ad37e5\",\"name\":\"Recondite (live)\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"On 30 May, we welcome Recondite for a live set at Onyx, joined by Lehar and Cenkk.\\n\\nFor over a decade, Recondite has quietly shaped a sound that feels deeply personal, an unpolished, emotional, and instinctive expression of himself. His music undulates with acid lines bending gently, melodies breathing and soothing atmosphere doing the heavy lifting.\\n\\nHis live sets are never mapped out. They evolve in the moment, guided by feeling rather than structure, and have left rooms around the world suspended somewhere between introspection and release.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-04T00:00:00+00:00\",\"sale_end_date\":\"2026-05-31T03:00: