_status\":null,\"date_unix\":1781892000,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:61\",\"venues\":[{\"id\":\"17239\",\"name\":\"Corn Exchange Hertford\",\"address\":\"39 Fore Street, Hertford, SG14 1AL, United Kingdom\",\"location\":{\"lat\":51.79646,\"lng\":-0.07627},\"image\":null,\"city\":{\"id\":\"68d7be55410e6754e8c8ae2c\",\"name\":\"Knebworth\",\"location\":{\"lat\":51.866566,\"lng\":-0.184568,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"corn-exchange-hertford-mx6yk\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-19T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Omar\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-02-14/b2114648-e76e-4aeb-9f71-859a9dd51e78.jpg?rect=0%2C27%2C876%2C876\"},\"artist_id\":\"65944\",\"about\":{\"description\":\"Broadly known as an R&B singer, Omar covers hip-hop, soul, jazz, funk, ragga and both Latin and Caribbean dance music. Truthfully, he makes Omar music; far more than the sum of its myriad parts. His refusal to rest or compromise his many artistic directions is key to his credibility, with artists including India.Arie, Erykah Badu, Angie Stone and Stevie Wonder all fans of his music, with Wonder even writing a song for the two of them to duet.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"AGMP Concerts and Music Venue Trust Liveline Presents:\\n\\nOMAR - 'BRIGHTER THE DAYS' UK TOUR\\n\\nCelebrating 40 years in music, Omar Lyefook MBE-one of the UK's most celebrated soul artists-returns with his new album Brighter The Days. Since his timeless breakthrough hit There's Nothing Like This, Omar has defined British soul, blending jazz, funk, R&B, and Caribbean influences into a sound entirely his own.\\n\\nWith collaborations spanning Stevie Wonder, Erykah Badu, Angie Stone, Leon Ware, Robert Glasper, Paul Weller, and India Arie, Omar's legacy as a true innovator is unmatched. Brighter The Days showcases his trademark vocals, lush string arrangements, and collaborations with Giggs, Raheem DeVaughn, Eric Roberson, Ledisi, and more - an album he describes as his \\\"magnum opus.\\\"\\n\\nA performer of effortless class and deep musicality, Omar's live shows are a masterclass in groove, soul, and sincerity. Don't miss this rare opportunity to experience a genuine British icon performing new material and timeless classics live.\\n\\n\\\"I am healed all over when he sings\\\" Erykah Badu\\n\\n\\\"When I grow up I wanna be like Omar\\\" Stevie Wonder\\n\\nhttps://omarmusic.co.uk\\n\\nhttps://www.instagram.com/omar_lyefook\\n\\nhttps://www.facebook.com/omarofficialuk\\n\\nhttps://twitter.com/omarlyefookMBE\\n\\n16+ only. 16s to 17s must be accompanied by an adult. No refunds will be given for incorrectly booked tickets.\",\"highlights\":[]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-26T00:00:00+00:00\",\"sale_end_date\":\"2026-06-19T00:00:00+01:00\",\"sale_start_date\":\"2025-11-27T00:00:00+00:00\",\"event_start_date\":\"2026-06-19T19:00:00+01:00\",\"event_end_date\":\"2026-06-19T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6929675784d3e30001d95521\",\"name\":\"Omar 'Brighter The Days'\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-27/706595b1-5d9a-4278-87d2-208aa56bda32.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-27/706595b1-5d9a-4278-87d2-208aa56bda32.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-27/706595b1-5d9a-4278-87d2-208aa56bda32.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1764115200,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/f7d053fc1d65?dice_id=f7d053fc1d65\",\"post_competition_referral\":\"https://link.dice.fm/mdcd4adab578?dice_id=mdcd4adab578\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/z0cc3fb667df?dice_id=z0cc3fb667df\",\"post_purchase_referral\":\"https://link.dice.fm/t22583ead02b?dice_id=t22583ead02b\",\"post_reminder_referral\":\"https://link.dice.fm/g781e2ab1044?dice_id=g781e2ab1044\",\"post_waitinglist_referral\":\"https://link.dice.fm/gab23b468ac5?dice_id=gab23b468ac5\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"There's Nothing Like This\",\"redirect_url\":\"https://open.spotify.com/track/4LHL2Xvq0NhGqUY2JfvCI2\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f9eb5b918eca114db0c9cbeeafc2ba8df45acd16?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"There's Nothing Like This\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":2251,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Institute of Contemporary Arts.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"3153\",\"name\":\"Institute of Contemporary Arts\",\"image\":{\"url\":null},\"perm_name\":\"institute-of-contemporary-arts-gpr2\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"bb8k2k-in-the-round-the-orielles-19th-jun-ica-institute-of-contemporary-arts-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781893800,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:62\",\"venues\":[{\"id\":\"194\",\"name\":\"ICA (Institute of Contemporary Arts)\",\"address\":\"The Mall, London SW1Y 5AH\",\"location\":{\"lat\":51.5062896,\"lng\":-0.129788700000063},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-10-03/7e6891a2-2daa-457c-8dc9-d3acb58f537b.jpg?rect=832%2C0%2C1643%2C1643\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"ica-institute-of-contemporary-arts-jvrv\",\"accessibility\":{\"url\":\"https://www.ica.art/visit/access\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-19T19:30:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Orielles\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-10-17/d885a48c-c49a-4f94-8a37-211fe2f48e18.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"2118\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"FORM presents The Orielles peforming in the round at ICA.\\n\\n“You’ve got to die and be reborn between albums,” begins Henry Wade, guitarist for The Orielles, describing the foundations of the band’s fourth studio album, Only You Left. “It comes naturally,” adds singer and bassist Esmé Hand-Halford, “it’s not something we consciously do.”\\n\\nThrough this process of creative renewal, the Manchester-based trio – completed by drummer Sidonie Hand-Halford – have managed to weather a pandemic, defy the fickleness of a trend-led music industry, and emerge, phoenix-like, with something familiarly Orielles, yet altogether different.\\n\\nRecorded in two locations – Hydra and Hamburg – over the summer of 2024, the 11 tracks of Only You Left sees the band consolidate the bold experimentation of their previous LP, Tableau (2022), with a return to the more stripped-back, song-led approach of their early origins.\\n\\nPresented by FORM.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-11T10:00:00+00:00\",\"sale_end_date\":\"2026-06-19T19:30:00+01:00\",\"sale_start_date\":\"2026-02-13T10:00:00+00:00\",\"event_start_date\":\"2026-06-19T19:30:00+01:00\",\"event_end_date\":\"2026-06-19T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"698b6d589aa68000019290ee\",\"name\":\"In the Round: The Orielles\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-10/d8e1ba85-1651-4f94-ab1f-c641c5ba0d75.jpg?rect=0%2C417%2C1280%2C1280\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-10/d8e1ba85-1651-4f94-ab1f-c641c5ba0d75.jpg?rect=0%2C576%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-10/d8e1ba85-1651-4f94-ab1f-c641c5ba0d75.jpg?rect=112%2C0%2C1056%2C1920\"},\"marketeers\":[{\"id\":861,\"name\":\"Institute of Contemporary Arts\",\"privacy_policy_link\":\"https://ica.art/privacy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1770804000,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/I51d442e355f?dice_id=I51d442e355f\",\"post_competition_referral\":\"https://link.dice.fm/N588aedf2757?dice_id=N588aedf2757\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/S21adc30bd36?dice_id=S21adc30bd36\",\"post_purchase_referral\":\"https://link.dice.fm/O72985fa093a?dice_id=O72985fa093a\",\"post_reminder_referral\":\"https://link.dice.fm/od24576bd4c2?dice_id=od24576bd4c2\",\"post_waitinglist_referral\":\"https://link.dice.fm/t8115fff7550?dice_id=t8115fff7550\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"The Room\",\"redirect_url\":\"https://open.spotify.com/track/0hjxNA3jvNYJmGf2CffNbA\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a3c3df555728a0eb6a60900f01d331b8010ebd02?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Room\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Fri 19 Jun\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":2627,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by The Underworld & Roy Dirt Promotions\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":57493,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":57494,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":57495,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"q26xeo-knuckledust-sold-out-20th-jun-the-underworld-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":\"waiting-list\",\"date_unix\":1781960400,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"sold-out\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:63\",\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-20T14:00:00+01:00\",\"doors_close_date\":\"2026-06-20T23:00:00+01:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Tempers Fray\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b27366b95ccdf28ea725a9fe58db\"},\"artist_id\":\"52706\",\"about\":null,\"is_headliner\":false},{\"name\":\"Born From Pain\",\"image\":null,\"artist_id\":\"104928\",\"about\":null,\"is_headliner\":false},{\"name\":\"50 Caliber\",\"image\":null,\"artist_id\":\"74348\",\"about\":null,\"is_headliner\":false},{\"name\":\"Grove Street\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb7bbd41c4e8d165e977c83afd\"},\"artist_id\":\"47405\",\"about\":null,\"is_headliner\":false},{\"name\":\"Stampin’ Ground\",\"image\":null,\"artist_id\":\"118155\",\"about\":null,\"is_headliner\":false}],\"total_artists\":6,\"total_free_texts\":3},\"about\":{\"description\":\"Knuckledust Celebrate 30 Years In The Game!\\n\\nUK Hardcore stalwarts, Knuckledust have announced a 30th anniversary festival at The Underworld in London’s music mecca, Camden.\\n\\nThe show will take place on Saturday June 20th as an all day festival where they will be joined by their long-time friends in Stampin’ Ground, something both bands were determined to happen, the ever energetic and fresh, Grove Street, Born From Pain coming all the way from Heerlen in The Netherlands, 50 Caliber who were there with Knuckledust at the beginning, Tempers Fray with new material recently recorded with new vocalist Cons, new band Agency that are simply going to be huge and old friends with a new hard hitting band, Mugged Off.\\n\\nThis is Knuckledust’s 30th year as the same lineup of Pierre, Ray, Nicky and Wema. Be sure to bring your dancing shoes as all the classics will be coming out on this very special day. The show has a 2pm door entry and 10pm finish so be sure to get there early to witness this very special event! Who knows? There may be some special guests popping up throughout the day……\\n\\n\\\\-\\n\\nJoin us for the after party from 11pm to 3am at The Underworld's Camden Rocks Club, get your tickets!\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-13T17:45:00+00:00\",\"sale_end_date\":\"2026-06-20T13:00:00+01:00\",\"sale_start_date\":\"2025-11-13T17:45:00+00:00\",\"event_start_date\":\"2026-06-20T14:00:00+01:00\",\"event_end_date\":\"2026-06-20T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"69160feaef017f00014d7ff9\",\"name\":\"KNUCKLEDUST | SOLD OUT\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-