\":\"GBP\",\"amount\":1964,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/o217bd6cfd5f?dice_id=o217bd6cfd5f\",\"post_competition_referral\":\"https://link.dice.fm/z213caa1542c?dice_id=z213caa1542c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/f802f127eee7?dice_id=f802f127eee7\",\"post_purchase_referral\":\"https://link.dice.fm/Ec1f53bf879d?dice_id=Ec1f53bf879d\",\"post_reminder_referral\":\"https://link.dice.fm/Bf58b7616979?dice_id=Bf58b7616979\",\"post_waitinglist_referral\":\"https://link.dice.fm/L19566404023?dice_id=L19566404023\"},\"perm_name\":\"ww7d9n-tommy-w-5th-may-the-lower-third-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-09/35137ca8-53fa-4683-968a-656138bc5e72.jpg?rect=0%2C1993%2C4160%2C4160\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-09/35137ca8-53fa-4683-968a-656138bc5e72.jpg?rect=0%2C1872%2C4160%2C2496\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-09/35137ca8-53fa-4683-968a-656138bc5e72.jpg?rect=364%2C0%2C3432%2C6240\"},\"properties\":[],\"about\":{\"description\":\"A whole multitude of worlds exist within the music of Tommy WÁ, one of the most special new voices to have emerged in recent years. Drenched in beauty and meaning, the music of the Nigerian-born, Ghana-based artist recalls the glistening atmospheres of Bon Iver and Michael Kiwanuka but has its roots in the African folk music of the mid-20th century. Presented through pristine hooks and vivid storytelling, it’s music that straddles eras, styles and continents, but has universality at its core.\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"68d6a60e84a7b600011949ac\",\"name\":\"Tommy WÁ\",\"shopping_cart_enabled\":false,\"new\