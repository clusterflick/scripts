mgix.net/attachments/2026-02-03/0e627d5e-f07a-49bc-b113-5880ab504a8a.jpg?rect=0%2C1%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/0e627d5e-f07a-49bc-b113-5880ab504a8a.jpg?rect=0%2C161%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/0e627d5e-f07a-49bc-b113-5880ab504a8a.jpg?rect=180%2C0%2C441%2C802\"},\"properties\":[],\"about\":{\"description\":\"China Drum - 30 Years of Goosefair | Signature Brew Haggerston\\n\\nSignature Brew presents..\\n\\nChina Drum - https://www.facebook.com/chinadrumofficial\\n\\nThirty years since Goosefair first landed, China Drum are marking the anniversary with a very special run of shows celebrating the album that helped define UK punk in the ’90s and beyond.\\n\\nThe full band will perform Goosefair in full, followed by a selection of fan favourites and deep cuts. Featuring the original three members, joined by Jan on drums - who played live with the band from the second album era.\\n\\nFriday 17th July 2026 / Doors 6pm\\n\\nSignature Brew Haggerston\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6981cd3879917b0001cb9dbe\",\"name\":\"China Drum - 30 Years of Goosefair | London\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"China Drum - Cloud 9\",\"redirect_url\":\"https://music.apple.com/us/album/cloud-9/314597977?i=314598097&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"China Drum\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/60/d1/b9/60d1b93f-39b9-13d6-2f93-ca4d9839da31/mzaf_12128556990731786104.plus.aac.p.m4a\",\"track_name\":\"Cloud 9\"},{\"type\":\"spotify\",\"title\":\"China Drum - Cloud 9\",\"redirect_url\":\"https://open.spotify.com/track/2IMOpOM7kzp5sN10T2BDfR\",\"artist\":\"China Drum\",\"preview_url\":\"https://p.scdn.co/mp3-preview/758ba8d1515ab581743232e5cde92134bebbc287?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Cloud 9\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"China Drum\",\"image\":null,\"artist_id\":\"80629\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-13T00:00:00+00:00\",\"sale_end_date\":\"2026-07-17T22:00:00+01:00\",\"sale_start_date\":\"2026-01-13T00:00:00+00:00\",\"event_start_date\":\"2026-07-17T18:00:00+01:00\",\"event_end_date\":\"2026-07-17T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Safe As Milk Promotions and New Cross Live present\",\"seating\":null,\"announcement_date_unix\":1768262400,\"venues\":[{\"id\":\"1641\",\"name\":\"New Cross Inn\",\"address\":\"New Cross Inn, 323 New Cross Rd, London SE14 6AS, UK\",\"location\":{\"lat\":51.4757899,\"lng\":-0.037162699999953475},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/ba29f2fe-617e-4542-80b7-6e2529031d70.jpg?rect=0%2C0%2C225%2C225\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-cross-inn-x9yl\",\"accessibility\":{\"url\":\"https://www.newcrossinn.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-17T18:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"1888\",\"name\":\"New Cross Live\",\"image\":{\"url\":null},\"perm_name\":\"new-cross-live-y8la\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:46\",\"date_unix\":1784307600,\"price\":{\"currency\":\"GBP\",\"amount\":1430,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/v5cb444ff797?dice_id=v5cb444ff797\",\"post_competition_referral\":\"https://link.dice.fm/o1957b1bdec3?dice_id=o1957b1bdec3\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/v1edc572d64a?dice_id=v1edc572d64a\",\"post_purchase_referral\":\"https://link.dice.fm/H79bc62e5162?dice_id=H79bc62e5162\",\"post_reminder_referral\":\"https://link.dice.fm/t77d4bbbdb67?dice_id=t77d4bbbdb67\",\"post_waitinglist_referral\":\"https://link.dice.fm/ic1f8d875e51?dice_id=ic1f8d875e51\"},\"perm_name\":\"py5e8l-14-iced-bears-17th-jul-new-cross-inn-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-09/de793861-3a02-44c4-b151-2bc3c00afdcb.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-09/de793861-3a02-44c4-b151-2bc3c00afdcb.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-09/de793861-3a02-44c4-b151-2bc3c00afdcb.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"14 Iced Bears\\n\\nThe 14 Iced Bears were formed in 1985 in Brighton, UK. Their first single Inside/Blue Suit/Cut attracted the attention of legendary Radio 1 DJ John Peel – two Peel Sessions\\n\\nfollowed in 1986 and 1987. The band were part of the C86 wave - a movement often credited with the birth of Indiepop and the launch of a whole genre of music - that would go on to inspire many future bands.\\n\\nThe Bears rapidly became a fanzine favourite. In 1988 their EP ‘Come Get Me’ was released on the legendary Sarah Records label. Also in 1988 after a number of other well-received singles, came their eponymous first LP, which took a more psychedelic turn.\\n\\nIn 1992 the 14 Iced bears decided to go their separate ways. In 2010, due to renewed interest in the genre, the Bears reformed to tour the east and west coasts of the USA. Cherry Red Records then released a compilation album of all the band’s material entitled ‘Hold on Inside’. This was also brought out on two vinyl gatefold LPs by Optic Nerve.\\n\\nAfter another hiatus and following a six-page feature on the band in Shindig! magazine in Jan 2024, an honour only usually bestowed to psyche legends such as Arthur Lee and the\\n\\nWest Coast Pop Art Experimental Band, the band reformed once again. Enthusiastically received shows followed in Sheffield, Paris, London, Glasgow and Leeds, mainly headlining, some supporting, playing with The Vaselines, Heavenly and Miki Berenyi (ex Lush).\\n\\nhttps://14icedbears.bandcamp.com/\\n\\n\\\\+ supports\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69611aaab44540000141ec72\",\"name\":\"14 Iced Bears\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"14 Iced Bears - Balloon Song\",\"redirect_url\":\"https://music.apple.com/us/album/balloon-song/912884796?i=912887285&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"14 Iced Bears\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/fb/bb/95/fbbb9539-193b-d412-993a-83734ba70220/mzaf_11803908064778011682.plus.aac.p.m4a\",\"track_name\":\"Balloon Song\"},{\"type\":\"spotify\",\"title\":\"14 Iced Bears - Balloon Song\",\"redirect_url\":\"https://open.spotify.com/track/2eKqhGzVGNTHJthwcJrVJy\",\"artis