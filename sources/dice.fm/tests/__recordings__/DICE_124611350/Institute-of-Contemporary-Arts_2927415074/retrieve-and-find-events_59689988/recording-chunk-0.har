illuminating.\\n\\n**A masterclass in positive vibration and vocal mastery, this is a rare opportunity to see \\\"The Messenjah\\\" live in the heart of London.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-19T14:00:00+00:00\",\"sale_end_date\":\"2026-04-07T19:00:00+01:00\",\"sale_start_date\":\"2026-01-19T14:00:00+00:00\",\"event_start_date\":\"2026-04-07T20:30:00+01:00\",\"event_end_date\":\"2026-04-08T23:00:00+01:00\",\"is_multi_days_event\":true,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Luciano - Sweep Over My Soul\",\"redirect_url\":\"https://open.spotify.com/track/4LhJsnXHQz3BmeUeNtBaga\",\"artist\":\"Luciano\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a5ddb30d76c41f191eb1d303a6868a05e543d223?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Sweep Over My Soul\"},{\"type\":\"apple_music\",\"title\":\"Luciano - Sweep Over My Soul\",\"redirect_url\":\"https://music.apple.com/us/album/sweep-over-my-soul/309097411?i=309097423&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Luciano\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/53/21/b2/5321b277-f757-2c19-7399-2ab2a2cb12af/mzaf_302891961623583800.plus.aac.p.m4a\",\"track_name\":\"Sweep Over My Soul\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Tue 07 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null}],\"next_page_cursor\":\"\"}",
